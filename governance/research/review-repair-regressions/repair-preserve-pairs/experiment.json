{
  "scope": "manual controlled experiment; no automatic selector or new CLI gate",
  "fixture_contract": "cap returns an integer clamped to 0..8; caller preserves cap; invalid string raises TypeError",
  "sources": {
    "before": "def cap(value):\n    return min(8,value)\n\ndef caller(value):\n    return cap(value)\n",
    "safe_repair": "def cap(value):\n    return min(8,max(0,value))\n\ndef caller(value):\n    return cap(value)\n",
    "regressed_repair": "def cap(value):\n    return min(5,max(0,value))\n\ndef caller(value):\n    return cap(value)\n"
  },
  "probe_source": "import runpy,sys,json\nfrom pathlib import Path\np=Path(sys.argv[1]).resolve()\nm=runpy.run_path(str(p))\nc=json.loads(sys.argv[2])\ntry:\n value=m[c[\"entry\"]](c[\"input\"])\n observed={\"result\":value}\nexcept TypeError:\n observed={\"error\":\"TypeError\"}\nprint(json.dumps({\"loaded\":str(p),\"observed\":observed,\"expected\":c[\"expected\"]}))\nraise SystemExit(0 if observed==c[\"expected\"] else 1)\n",
  "cases": [
    {
      "id": "negative",
      "group": "G1",
      "role": "repair",
      "entry": "cap",
      "input": -1,
      "expected": {
        "result": 0
      }
    },
    {
      "id": "zero",
      "group": "G1",
      "role": "preserve",
      "entry": "cap",
      "input": 0,
      "expected": {
        "result": 0
      }
    },
    {
      "id": "normal",
      "group": "G1",
      "role": "preserve",
      "entry": "cap",
      "input": 1,
      "expected": {
        "result": 1
      }
    },
    {
      "id": "upper",
      "group": "G1",
      "role": "preserve",
      "entry": "cap",
      "input": 8,
      "expected": {
        "result": 8
      }
    },
    {
