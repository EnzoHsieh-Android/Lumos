 22856	def _merge_new_lines(merged, olds):
 22857	    """合併結果裡「每一個上一版都找不到」的那些行(去頭尾空白後的位元組集合);判不了回 None。
 22858	    從 _nodehome_merge_wrote_new_lines 拆出來(筆記形狀擋 [S5] 要的是哪幾行,不是有沒有);天花板見那支的說明。"""
 22859	    if merged is None or b"\0" in merged:
 22860	        return None
 22861	    seen = set()
 22862	    for blob in olds:
 22863	        if blob is not None:
 22864	            seen.update(ln.strip() for ln in blob.split(b"\n"))
 22865	    return {ln.strip() for ln in merged.split(b"\n") if ln.strip() and ln.strip() not in seen}
