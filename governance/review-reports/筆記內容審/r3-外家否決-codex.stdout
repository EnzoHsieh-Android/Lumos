 19775	def cmd_anchor_approve(repo=None, note=None, vault=None):
 19776	    """重算全部錨點 sha256 寫回 baseline + governance-log 留痕(anchor-approve 事件)。
 19777	    改錨點檔的唯一合法路徑;--note 必填(空理由=無資訊留痕)。"""
 19778	    import json
 19779	    import hashlib
 19780	    import datetime
 19781	    if not note or not note.strip():
 19782	        print("擋下:核可一定要帶 --note 寫理由,不然以後沒人知道為什麼改", file=sys.stderr)
 19783	        return 2
 19784	    repo_root = _anchor_repo_root(repo)
 19785	    if repo_root is None:
 19786	        return 2
 19787	    anchors, absent = {}, []
 19788	    for rel in ANCHOR_FILES:
 19789	        f = repo_root / rel
 19790	        if f.is_file():
 19791	            anchors[rel] = hashlib.sha256(f.read_bytes()).hexdigest()
 19792	        else:
 19793	            absent.append(rel)
 19794	    if absent:
 19795	        print(f"提醒:這些驗證器檔案不存在,沒列進基準線: {', '.join(absent)}")
 19796	    bp = repo_root / _ANCHOR_BASELINE_REL
 19797	    prev = {}
 19798	    if bp.exists():
 19799	        try:
 19800	            prev = json.loads(bp.read_text(encoding="utf-8")).get("anchors", {})
 19801	        except (OSError, ValueError):
 19802	            prev = {}
 19803	    changed = sorted({k for k in anchors if anchors[k] != prev.get(k)} | (set(prev) - set(anchors)))
 19804	    bp.parent.mkdir(parents=True, exist_ok=True)
 19805	    payload = {"version": 1, "anchors": anchors,
 19806	               "approved_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
 19807	               "note": note}
 19808	    bp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
 19809	    v = vault or find_vault(Path.cwd())
 19810	    if v is None:
 19811	        print("⚠ 無 vault:baseline 已寫,governance-log 留痕跳過")
 19812	    else:
 19813	        _append_governance_log(v, [{"gate": "anchor-approve", "kind": "approved",
 19814	                                    "hard": False, "nodes": changed, "note": note}])
 19815	    print(f"✓ anchor approve — {len(anchors)} 個錨點寫入 baseline({len(changed)} 個變更)")
 19816	    return 0
