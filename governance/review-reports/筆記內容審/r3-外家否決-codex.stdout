 23432	            files.add(it[0])
 23433	        elif kind in ("foreign", "foreign-awakened"):
 23434	            files.add(it[1]); notes_.add(it[0])
 23435	        elif kind == "route":
 23436	            files.update(it[1]); notes_.add(it[0])
 23437	        else:
 23438	            notes_.add(it[0])
 23439	    kind = "blocked" if blocked and cfg["mode"] == "on" else ("warned" if blocked else "passed")
 23440	    extra = {}
 23441	    if res["pairs"]:
 23442	        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
 23443	    if notes_:
 23444	        extra["notes"] = sorted(notes_)[:50]
 23445	    _gate_event_or_warn(root, "nodehome-check", kind,
 23446	                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
 23447	                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
 23448	    return 1 if kind == "blocked" else 0
