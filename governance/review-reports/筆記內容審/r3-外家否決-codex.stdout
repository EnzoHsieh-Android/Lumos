  2968	def rule_lifecycle_warnings(rest, today=None):
  2969	    """一條 RULE: 行的生命週期檢查,回傳警告清單(不擋)。"""
  2970	    f = parse_rule_fields(rest)
  2971	    out = []
  2972	    # 同一行塞兩條 RULE:,後面那條沒填欄位也會借用前面的(2026-09-21 通才席 F4)
  2973	    if rest.count("RULE:") >= 1:
  2974	        out.append("一行只放一條 RULE:——同一行寫兩條時欄位會混在一起算,"
  2975	                   f"沒填欄位的那條會借用旁邊的而被判過關:{rest.strip()[:40]}")
  2976	    trunc = rule_field_truncated(rest)
  2977	    if trunc:
  2978	        out.append("這幾個欄位的值裡有右中括號,會被截斷(常見於退場條件引用 [[節點]]):"
  2979	                   + "、".join(f"[{k}:…]" for k in trunc)
  2980	                   + "——改寫成不帶中括號的一句話,或把節點名寫在欄位外面"
  2981	                   + f":{rest.strip()[:40]}")
  2982	    missing = [k for k in ("since", "retire") if not f.get(k)]
  2983	    if missing:
  2984	        out.append("脈絡標記『RULE:』缺 " + "、".join(f"[{k}:…]" for k in missing)
  2985	                   + "——規則要機械讀得到「什麼時候立的」和「看到什麼就該撤掉」,"
  2986	                     "散文寫的有效期沒人判得出來;寫不出退場條件,就是還沒想清楚這條該不該立"
  2987	                   + f":{rest.strip()[:40]}")
  2988	    st = (f.get("status") or "active").lower()
  2989	    if st == "superseded":
  2990	        out.append("這條 RULE 標了 [status:superseded],已經沒有挑戰程式碼的效力,"
  2991	                   "只能當歷史線索;確定撤掉就把整行刪掉,別留著讓人誤讀"
  2992	                   f":{rest.strip()[:40]}")
  2993	    elif st != "active":
  2994	        out.append(f"[status:{st}] 不是認得的值(只收 active / superseded):{rest.strip()[:40]}")
  2995	    import datetime as _dt
  2996	    today = today or _dt.date.today()
  2997	    for key, label in (("since", "立的日期"), ("until", "到期日"), ("confirmed", "最後確認")):
  2998	        v = f.get(key)
  2999	        if v and _rule_date(v) is None:
  3000	            out.append(f"[{key}:{v}] 不是合法日期({label}要寫成 YYYY-MM-DD):{rest.strip()[:40]}")
  3001	    until = _rule_date(f.get("until") or "")
  3002	    if until and until < today and st == "active":
  3003	        out.append(f"這條 RULE 的 [until:{f['until']}] 已經過期({today} 了)還標著 active——"
  3004	                   "確認還要不要留:要留就往後延並補 [confirmed:],不留就刪掉或標 superseded"
  3005	                   f":{rest.strip()[:40]}")
  3006	    conf = _rule_date(f.get("confirmed") or "")
  3007	    if conf and (today - conf).days > _RULE_CONFIRM_STALE_DAYS and st == "active":
  3008	        out.append(f"這條 RULE 超過 {_RULE_CONFIRM_STALE_DAYS} 天沒人確認過"
  3009	                   f"(最後一次是 {f['confirmed']})——還成立就更新 [confirmed:],不成立就撤掉"
  3010	                   f":{rest.strip()[:40]}")
  3011	    return out
  3012	
