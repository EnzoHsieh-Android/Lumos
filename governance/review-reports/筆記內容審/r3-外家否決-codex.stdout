 14914	def cmd_decision_add(env, rel, content, decided, context=None, why=None):
 14915	    """T3 巢狀手術:append 一條新 ADR 決策到 decisions[](無則建)。surgical line-based。
 14916	    [M1/P2]:指派穩定 id d<max+1> 並回傳 (rc, 全域決策id <rel>#d<N>);dispatcher 解包後
 14917	    CLI 對外仍只回整數 rc。"""
 14918	    if not DATE_RE.match(decided):
 14919	        raise ValueError(f"擋下:--decided 要寫成 年-月-日(例如 2026-08-22),你給的是 {decided}")
 14920	    path = env.vault / rel
 14921	    lines, s_fm, e_fm = load_raw_for_edit(path)
 14922	    fm = lines[1:e_fm]
 14923	    loc = decisions_items(fm)
 14924	    new_id = f"d{_max_decision_id(fm) + 1}"
 14925	    if loc is None:
 14926	        # 無 decisions key → 在 fm 末尾建
 14927	        item_indent, sub = 2, 4
 14928	        block = [f'{" "*item_indent}- content: {_fmt_decision_value(content)}',
 14929	                 f"{' '*sub}id: {new_id}"]
 14930	        if context:
 14931	            block.append(f'{" "*sub}context: {_fmt_decision_value(context)}')
 14932	        if why:
 14933	            block.append(f'{" "*sub}why_chosen: {_fmt_decision_value(why)}')
 14934	        block += [f"{' '*sub}decided: {decided}", f"{' '*sub}valid: true"]
 14935	        fm = fm + ["decisions:"] + block
 14936	    else:
 14937	        _, e_block, items, item_indent, sub = loc
 14938	        ip, sp = " " * item_indent, " " * sub
 14939	        block = [f"{ip}- content: {_fmt_decision_value(content)}", f"{sp}id: {new_id}"]
 14940	        if context:
 14941	            block.append(f"{sp}context: {_fmt_decision_value(context)}")
 14942	        if why:
 14943	            block.append(f"{sp}why_chosen: {_fmt_decision_value(why)}")
 14944	        block += [f"{sp}decided: {decided}", f"{sp}valid: true"]
 14945	        last = items[-1][1] if items else e_block
 14946	        fm[last + 1:last + 1] = block
 14947	    new_lines = lines[:1] + fm + lines[e_fm:]
 14948	    needle = nfc(content)
 14949	
 14950	    def _check(_fields):
 14951	        # [M1] ID 精確驗證:新 id 那條存在且 content 相符(取代純 content 子字串——重疊時驗錯項)
 14952	        return any(str(d.get("id", "")).strip() == new_id
 14953	                   and needle in nfc(str(d.get("content", "")))
 14954	                   for d in parse_decisions(_fm_of(new_lines)))
 14955	    atomic_write_verify(path, new_lines, "decisions", _check)
 14956	    print(f"✓ decision-add {rel}: 記下一條決策「{content[:30]}」(編號 {new_id},目前有效)")
 14957	    return 0, f"{rel}#{new_id}"
