 16727	    for t in ("CLAUDE.md", "AGENTS.md", "AGENTS.override.md"):
 16728	        cm = root / t
 16729	        if not cm.exists():
 16730	            continue
 16731	        text = cm.read_text(encoding="utf-8")
 16732	        start_marker = "<!-- LUMOS:GRAPH-DISCIPLINE:START"
 16733	        end_marker = "LUMOS:GRAPH-DISCIPLINE:END -->"
 16734	        si = text.find(start_marker)
 16735	        ei = text.find(end_marker)

