 14807	def _fmt_decision_value(v):
 14808	    """decision 子欄位值格式化:跟 fmt_scalar 共用同一套白名單與加引號規則(2026-09-26 代碼審 r2 架構席:
 14809	    原本是第三套手刻判準,結尾裸冒號讓標準 YAML 報錯、含「: 」又有雙引號的寫不進去)。"""
 14810	    v = v.strip()
 14811	    return v if _yaml_plain_ok(v) else _yaml_quote(v, "決策內容")
