  3014	def context_marker_warnings(summary_text, rules=None):
  3015	    """檢查摘要裡四個脈絡前綴的形狀,回傳警告字串清單(不產生 error)。
  3016	    rules=別的規則表(筆記形狀擋傳 _NOTE_SHAPE_PREFIX_RULES,只看 FACT/FLOW/DEP;RULE 行的生命週期檢查只在預設時跑)。"""
  3017	    out = []
  3018	    for raw in (summary_text or "").split("\n"):
  3019	        line = raw.strip()
  3020	        if not line:
  3021	            continue
  3022	        m = SYMBOL_RE.match(line)
  3023	        if not m:
  3024	            continue
  3025	        if m.group(1) == "RULE" and rules is None:
  3026	            out.extend(rule_lifecycle_warnings(line[len("RULE:"):]))
  3027	            continue
  3028	        rule = (rules if rules is not None else _CONTEXT_MARKER_RULES).get(m.group(1))
  3029	        if not rule:
  3030	            continue
  3031	        ok, missing, how = rule
  3032	        rest = line[len(m.group(1)) + 1:]
  3033	        if not ok(rest):
  3034	            out.append(f"脈絡標記『{m.group(1)}:』缺{missing}——{how}:{rest.strip()[:40]}")
  3035	    return out
  3036	
  3037	FM_KEY_RE = re.compile(r"^\s*([A-Za-z_][\w-]*):")
  3038	
