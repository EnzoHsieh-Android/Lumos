 14814	def cmd_decision_supersede(env, rel, match, by, ended=None):
 14815	    """T3 巢狀手術:把 decisions[] 中 content 含 match 的決策標 valid:false + 補
 14816	    superseded_by/ended。surgical line-based(不重序列化,最小 diff;優於 ruamel reflow)。
 14817	    [P1]:ended 缺則自動補今日 + 同步 bump 頂層 updated(單次 atomic,供 E2 時序法)。"""
 14818	    import datetime
 14819	    if ended and not DATE_RE.match(ended):
 14820	        raise ValueError(f"--ended 要寫成 年-月-日(例如 2026-08-22),你給的是 {ended}")
 14821	    path = env.vault / rel
 14822	    lines, s_fm, e_fm = load_raw_for_edit(path)
 14823	    fm = lines[1:e_fm]
 14824	    loc = decisions_items(fm)
 14825	    if loc is None:
 14826	        raise ValueError("這篇筆記還沒有任何決策紀錄(decisions)")
 14827	    if not loc[2]:  # block 存在但解析不到項目(Bug2:0-indent / 非標準縮排)
 14828	        raise ValueError("決策區塊(decisions)讀不出任何一條,通常是縮排不對:工具只認兩個空白的縮排,不認 tab 或不縮排")
 14829	    _, _, items, _, sub = loc
 14830	    pad = " " * sub
 14831	    needle = nfc(match)
 14832	    id_mode = re.fullmatch(r"#d\d+", match.strip())
 14833	    if id_mode:
 14834	        # [M1/R12] #dN 精確定址:比對項內 id 行
 14835	        want = match.strip()[1:]
 14836	        hits = [(st, en) for (st, en) in items
 14837	                if any(re.match(rf"^{pad}id:\s*{re.escape(want)}\s*$", fm[i])
 14838	                       for i in range(st, en + 1))]
 14839	        if not hits:
 14840	            raise ValueError(f"找不到編號 {match} 的決策,可能這篇的決策還沒編號;先跑:\n    lumos decision-reindex {rel}")
 14841	    else:
 14842	        hits = [(st, en) for (st, en) in items
 14843	                if needle in nfc("\n".join(fm[st:en + 1]))]
 14844	        if not hits:
 14845	            raise ValueError(f"找不到內容含「{match}」的決策")
 14846	        if len(hits) > 1:
 14847	            # [M1/R12] 選擇端唯一命中:first-match 會「先改錯項、再用錯項 id 精確驗證它改成功」
 14848	            cands = "; ".join(first_line(fm[st].split("content:", 1)[-1].strip(), 40)
 14849	                              for (st, _) in hits[:5])
 14850	            raise ValueError(f"「{match}」命中 {len(hits)} 條決策,分不清要改哪條,不敢亂猜。"
 14851	                             f"候選: {cands} …改用更長的片段,或用 --match \"#dN\" 指定編號")
 14852	    st, en = hits[0]
 14853	    valid_line = None
 14854	    for i in range(st, en + 1):
 14855	        if re.match(rf"^{pad}valid:\s", fm[i]):   # 只認精確 sub_indent(Bug5:移除過寬 fallback,免誤命中子清單)
 14856	            valid_line = i
 14857	            break
 14858	    if valid_line is None:
 14859	        raise ValueError("這條決策沒有 valid 欄位(或縮排不是兩個空白),工具不敢自動翻案,請手動處理或先修結構")
 14860	    # Bug3: 已 superseded 不重插(免重複鍵)。同 sub_indent 已有 superseded_by → 拒
 14861	    for i in range(st, en + 1):
 14862	        if re.match(rf"^{pad}superseded_by:\s", fm[i]):
 14863	            raise ValueError("這條決策已經被翻案過了(有 superseded_by),不重複翻;要改成被誰取代請手動編輯")
 14864	    fm[valid_line] = f"{pad}valid: false"
 14865	    # [P1] ended 選填 → 缺則自動補今日(E2 時序法要 ended 才判得了「鄰居晚於翻案沒?」)
 14866	    if not ended:
 14867	        ended = datetime.date.today().isoformat()
 14868	    ins = [f"{pad}superseded_by: {_fmt_decision_value(by)}", f"{pad}ended: {ended}"]
 14869	    fm[valid_line + 1:valid_line + 1] = ins
 14870	    # [P1] supersede = 對本節點的實質編輯 → 同步 bump 頂層 updated(單次 atomic,同一份 fm;
 14871	    #   不串第二個寫命令避免半完成)。有則就地換、無則插在 decisions: 前(不動決策區索引)。
 14872	    today = datetime.date.today().isoformat()
 14873	    upd_i = next((k for k, ln in enumerate(fm) if re.match(r"^updated:\s", ln)), None)
 14874	    if upd_i is not None:
 14875	        fm[upd_i] = f"updated: {today}"
 14876	    else:
 14877	        dec_i = next((k for k, ln in enumerate(fm) if re.match(r"^decisions:\s*$", ln)), len(fm))
 14878	        fm[dec_i:dec_i] = [f"updated: {today}"]
 14879	    new_lines = lines[:1] + fm + lines[e_fm:]
 14880	    # [M1/P2] 讀 target 的 id → 組全域格式 <rel>#d<N> 回傳(下游 header/CASCADE/--from 同格式,無裸碼流出)
 14881	    did = None
 14882	    for i in range(st, en + 1):
 14883	        m = re.match(rf"^{pad}id:\s*(d\d+)\s*$", fm[i])
 14884	        if m:
 14885	            did = m.group(1)
 14886	            break
 14887	    gid = f"{rel}#{did}" if did else None
 14888	
 14889	    def _check(_fields):
 14890	        for d in parse_decisions(_fm_of(new_lines)):
 14891	            # [M1] 有 id → ID 精確驗證(content 子字串重疊會驗錯項);無 id(未 reindex 舊節點)→ 退回 content 驗證
 14892	            hit = (str(d.get("id", "")).strip() == did) if did \
 14893	                else (needle in nfc(str(d.get("content", ""))))
 14894	            if hit:
 14895	                return str(d.get("valid", "")).lower() == "false" and "superseded_by" in d
 14896	        return False
 14897	    atomic_write_verify(path, new_lines, "decisions", _check)
 14898	    _tag = f" [{gid}]" if gid else ""
 14899	    print(f"✓ supersede {rel}: 決策「{match[:30]}」→ valid:false + superseded_by + ended={ended} (updated bump {today}){_tag}")
 14900	    return 0, gid
