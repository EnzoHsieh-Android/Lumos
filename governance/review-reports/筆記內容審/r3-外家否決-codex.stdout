 14903	def _max_decision_id(fm_lines):
 14904	    """[M1/P2] 掃 decisions[] 既有 id: d<N>,回最大 N(無則 0)。新號=max+1(不重排既有、
 14905	    不回收缺號——ID 穩定性合約:翻案後永不重用)。"""
 14906	    mx = 0
 14907	    for d in parse_decisions(fm_lines):
 14908	        m = re.fullmatch(r"d(\d+)", str(d.get("id", "")).strip())
 14909	        if m:
 14910	            mx = max(mx, int(m.group(1)))
 14911	    return mx
