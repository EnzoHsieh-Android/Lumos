 13012	def _graph_pagerank(env, personalization=None, damping=0.85, tol=1e-6, max_iter=50):
 13013	    """[S1] 中心性/PPR helper(中心性重驗排程_計劃+檢索PPR邊權_計劃,2026-07-28):
 13014	    節點集=vault 全節點排 type=moc;邊=env.edges(ghost 建邊已丟);L1 收斂 1e-6/50 迭代。
 13015	    personalization=None(③ 語意):有向、均勻 teleport、dangling 均攤——行為恆定不變。
 13016	    personalization={rel:w}(② 語意):傳播圖**對稱化**(vault 連結大宗=新筆記→舊節點,有向會漏
 13017	    in-link-only 真相關)、teleport 與 dangling 質量皆回種子向量;域外種子(moc/不存在)由本
 13018	    helper 濾除後重歸一(合約 owner=helper),全濾/空集=回空 dict(呼叫端視為 P 缺席)。
 13019	    誠實:本圖幾百節點下近似平滑 in-degree(A3 消融紀錄在案;PPR 檢索分量 2026-07-28
 13020	    edit 卷消融同敗——personalization 保留為 ③ 之參數位與通用原語,檢索用途勿復活)。"""
 14780	                if cmd_remove(env, rel, "about_code", v) != 0:
 14781	                    bad = v
 14782	                    break
