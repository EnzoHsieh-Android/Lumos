 14799	def _fm_of(all_lines):
 14800	    """從完整檔行抽 frontmatter 行(供 decision 自驗用 parse_decisions 重解)。"""
 14801	    for i in range(1, len(all_lines)):
 14802	        if all_lines[i].strip() == "---":
 14803	            return all_lines[1:i]
 14804	    return all_lines[1:]
