 12984	def cmd_decisions(env, rel=None, superseded=False):
 12985	    if superseded:
 12986	        found = []
 12987	        for r, n in sorted(env.notes.items()):
 12988	            for d in parse_decisions(n.fm_lines):
 12989	                if str(d.get("valid", "true")).lower() == "false":
 12990	                    found.append(f"{n.stem}: {first_line(d.get('content', ''), 80)}"
 12991	                                 f" → {d.get('superseded_by', '?')}")
 12992	        print("\n".join(found) if found else "無被推翻的決策")
 12993	        return 0
 12994	    ds = parse_decisions(env.notes[rel].fm_lines)
 12995	    if not ds:
 12996	        print(f"{rel}: 無 decisions")
 12997	        return 0
 12998	    for d in ds:
 12999	        print(fmt_decision(d))
 13000	    return 0
