 18006	def _confirm_tty(prompt):
 18007	    """三階互動確認(curl|bash 安全;設計:Projects/bootstrap一鍵對稱_計劃 std F1/F2/F3):
 18008	    回 True(答 y/yes)/False(其他答案=拒絕)/None(非互動或無人回答→呼叫端跳過)。
 18009	    ①stdin.isatty→input();EOFError 落入②非當 False(isatty 撒謊時別誤判拒絕)
 18010	    ②os.open(tty,O_RDWR) 低階 fd(★r+ 開法對 tty 會炸 not seekable★)+os.write prompt
 18011	      +select timeout(有控制終端≠有人回答,防 readline 永久掛)+os.read
 18012	    ③皆不可→None。嚴禁在非 isatty 時讀 sys.stdin(curl|bash 下那是腳本殘文管線)。
 18013	    測試接縫:LUMOS_TTY(預設 /dev/tty;單元測指 pty slave)/LUMOS_TTY_TIMEOUT(預設 30s)。"""
 18014	    import os, select
 18015	    def _norm(ans):
 18016	        return ans.strip().lower() in ("y", "yes")   # 嚴格答案+預設 N(F2-B 殘文緩解)
 18017	    if sys.stdin.isatty():
 18018	        try:
 18019	            return _norm(input(prompt))
 18020	        except EOFError:
 18021	            pass                                     # isatty 撒謊 → 試 ②(F2-A)
 18022	    tty_path = os.environ.get("LUMOS_TTY", "/dev/tty")
 18023	    try:
 18024	        timeout = float(os.environ.get("LUMOS_TTY_TIMEOUT", "30"))
 18025	    except ValueError:
 18026	        timeout = 30.0
 18027	    try:
 18028	        fd = os.open(tty_path, os.O_RDWR)
 18029	    except OSError:
 18030	        return None
 18031	    try:
 18032	        os.write(fd, prompt.encode("utf-8"))
 18033	        readable, _, _ = select.select([fd], [], [], timeout)
 18034	        if not readable:
 18035	            os.write(fd, "\n(無回應,視為略過)\n".encode("utf-8"))

