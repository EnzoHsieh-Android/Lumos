 12942	            key, val = m_item.group(2), m_item.group(3).strip()
 12943	            base = indent(line)
 12944	            key_col = base + 2          # dash line: key 在「- 」之後,有效欄位 = base+2
 12945	        elif m_kv and cur is not None:
 12946	            key, val = m_kv.group(2), m_kv.group(3).strip()
 12947	            base = indent(line)
 12948	            key_col = base              # 子欄位: key 欄位 = base
 12949	        else:
 12950	            i += 1
 12951	            continue
 12952	        if val in ("|", "|-", ">", ">-"):
 12953	            # block scalar 終止 = 首個縮排 <= key_col 的非空行(否則會把兄弟欄位吸進 content,Bug1)
 12954	            block = []
 12955	            i += 1
 12956	            while i < n and (not fm_lines[i].strip() or indent(fm_lines[i]) > key_col):
 12957	                if fm_lines[i].strip():
 12958	                    block.append(fm_lines[i].strip())
 12959	                i += 1
 12960	            cur[key] = "\n".join(block)
 12961	            continue
 12962	        if val == "":
 12963	            lst = []
 12964	            i += 1
 12965	            while i < n and fm_lines[i].strip() and indent(fm_lines[i]) > base \
 12966	                    and re.match(r"^\s+-\s+", fm_lines[i]):
 12967	                lst.append(strip_quotes(re.match(r"^\s+-\s+(.*)$", fm_lines[i]).group(1).strip()))
 12968	                i += 1
 12969	            cur[key] = lst
 12970	            continue
 12971	        cur[key] = strip_quotes(val)
 12972	        i += 1
 12973	    return items
 12974	
