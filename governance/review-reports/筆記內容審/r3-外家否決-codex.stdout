 13003	def _conds(val):
 13004	    """frontmatter list / 字串 / block scalar → 逐條件展開(去空行)。
 13005	    block scalar 存成含 \\n 的單一字串,split 開以免後續行被 first_line 截掉。"""
 13006	    out = []
 13007	    for c in as_list(val):
 13008	        out += [ln.strip() for ln in str(c).split("\n") if ln.strip()]
 13009	    return out
