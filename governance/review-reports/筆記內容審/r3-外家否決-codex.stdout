 12976	def fmt_decision(d):
 12977	    mark = "✅" if str(d.get("valid", "true")).lower() != "false" else "❌"
 12978	    line = f"{mark} [{d.get('decided', '?')}] {first_line(d.get('content', ''), 100)}"
 12979	    if d.get("superseded_by"):
 12980	        line += f" → {d['superseded_by']}"
 12981	    return line
