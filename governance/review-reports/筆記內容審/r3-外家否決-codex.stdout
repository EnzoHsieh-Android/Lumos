 20621	def _rules_load(repo_root):
 20622	    """讀自寫規則的索引。回 (dict, 錯誤訊息 or None);沒有索引回 ({}, None)。
 20623	    形狀:{"cmd": "<含兩個佔位的命令>", "rules": {"<規則id>": "<樣本檔相對路徑>"}}。"""
 20624	    import json
 20625	    p = _rules_index_path(repo_root)
 20626	    if not p.is_file():
 20627	        return ({}, None)
 20628	    try:
 20629	        data = json.loads(p.read_text(encoding="utf-8"))
 20630	    except Exception as e:
 21400	    head_text = {f: (_lint_new_read_lines(p) or []) for f, p in head_files.items()}
 21401	    base_count = Counter()
 21402	    for c in base_claims:
 21403	        k, _weak = _lint_new_key(c, base_text)
 21404	        base_count[k] += 1
 21405	    new, weak = [], 0
 21406	    seen = Counter()
 21407	    for c in head_claims:
 21408	        k, is_weak = _lint_new_key(c, head_text)
 21409	        seen[k] += 1
 21410	        if seen[k] > base_count.get(k, 0):
 21411	            c = dict(c)
 21412	            c["key"] = _hl.sha256(k.encode("utf-8")).hexdigest()[:16]
 21413	            c["weak"] = is_weak
 21414	            new.append(c)
 21415	            if is_weak:
 21416	                weak += 1
 21417	    return (new, weak)
 21418	
