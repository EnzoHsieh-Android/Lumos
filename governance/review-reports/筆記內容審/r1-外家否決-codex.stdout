 28075	def _lens_range_ok(diff_range):
 28076	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 28077	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 28078	        return None
 28079	    parts = diff_range.split("..")
 28080	    if len(parts) != 2 or not parts[0] or not parts[1]:
 28081	        return None
 28082	    if any(ch.isspace() for ch in diff_range):
 28083	        return None
 28084	    return parts[0], parts[1]
 28085	
 28086	
 28087	def _lens_git(repo_root, *args, quote=False, binary=False):
 28088	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 28089	    import subprocess as _sp
 28090	    cmd = ["git", "-C", str(repo_root)]
 28091	    if quote:
 28092	        cmd += ["-c", "core.quotePath=false"]
 28093	    try:
 28094	        if binary:
 28095	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 28096	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 28097	    except (OSError, _sp.TimeoutExpired):
 28098	        return None
 28099	
