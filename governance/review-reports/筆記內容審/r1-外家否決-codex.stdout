 24027	# ── cochange:co-change 漏改守衛(vault-free;borrow-design ROSE error-prevention) ──
 24028	# 規則:conf(A⇒B)=shared/freq(A)(非對稱條件機率,ROSE TSE 2005 §5);support=絕對共改次數。
 24029	# 設計 spec:docs/lumos-toolchain-knowledge/Projects/cochange守衛_計劃.md
 24030	
 24031	_COCHANGE_DEFAULTS = {"min_support": 3, "min_confidence": 0.8, "max_changeset": 20}
 24032	_COCHANGE_DEFAULT_EXCLUDE = [
 24033	    "docs/.governance-log.jsonl", "docs/.bypass-log.jsonl", "docs/.ci-log.jsonl",
 24034	    "docs/.canary-log.jsonl", "docs/.rot-queue.jsonl", "docs/.kill-log.jsonl",
 24035	    "docs/.signoff-log.jsonl", "docs/.usage-log.jsonl",
 24036	    "**/*-lock.json", "**/*.lock", "**/node_modules/**", "**/dist/**",
 24037	    "**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs",
 24038	]
