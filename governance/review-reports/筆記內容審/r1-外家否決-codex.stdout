 20501	def _lintcheck_smoke_cmd(cmd, stack, repo_root, sample=3):
 20502	    """冒煙時把 {LINT_FILES} 換成專案裡真的有的那個棧的檔(取前幾支)。
 20503	    ★原本字面原樣送出★(2026-09-14 代碼審 r1 整合席實測):工具把 `{LINT_FILES}` 當成不存在的路徑,
 20504	    有的工具照樣吐得出結果(看起來通過)、有的印用法說明——dart-sarif 讀不懂就失敗,於是照文件接好的
 20505	    Dart 宣告在冒煙時被判「跑不動」。新增告警閘真跑時一定會換成檔案清單,冒煙要跟它一樣。
 20506	    ★還沒 git add 的檔也算★(r2 修正差異席):剛裝好宣告、寫了第一支檔就先冒煙,正是最常見的驗收時序。
 20507	    ★這個棧一支檔都沒有時回 None★(2026-09-16 代碼審 r1 單reviewer 席):原本是原樣送出去,
 20508	    而同一天在執行入口加了「佔位符沒換掉就不跑」之後,原樣送出去等於保證失敗——冒煙會回
 20509	    「命令跑不出可解析 SARIF(task 不存在/工具沒裝?)」,★而那句診斷是假的★,工具好好的,
 20510	    只是還沒有那個副檔名的檔。呼叫端收到 None 就照實說「這個棧還沒有檔可驗」。"""
 20511	    import subprocess
 20512	    if _LINT_NEW_FILES_TOKEN not in cmd:
 20513	        return cmd
 20514	    r = subprocess.run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", "*." + str(stack)],
 20515	                       capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 20516	    files = [f for f in (r.stdout.split("\0") if r.returncode == 0 else []) if f][:sample]
 20517	    if not files:
 20518	        return None
 20519	    return _lint_cmd_with_files(cmd, files)
