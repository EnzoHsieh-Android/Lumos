 28120	def _lens_dispositions_lines(lines, rec):
 28121	    """派工鏡頭附表態記錄(表態閘 S8):只列人答的題(未觸發自動 na 只給個數);工具驗過錨點存在、沒驗答案對不對——審查席反駁的就是這些答案。回人答題數。"""
 28122	    disp = rec.get("dispositions") or {}
 28123	    human = [(q, e) for q, e in disp.items() if isinstance(e, dict) and not e.get("auto")]
 28124	    n_auto = sum(1 for e in disp.values() if isinstance(e, dict) and e.get("auto"))
 28125	    lines.append(f"[表態記錄(棧別效能檢核;分支 {rec.get('branch')},版本 {str(rec.get('head_sha') or '')[:8]})——寫入時工具只驗了形狀,證據存不存在要到推送前 code-loop check 才驗,答案對不對沒人驗]")
 28126	    for q, e in human:
 28127	        st = e.get("status")
 28128	        tail = (str(e.get("evidence") or "") if st == "satisfied"
 28129	                else (str(e.get("issue") or "") + " " + str(e.get("reason") or "")) if st == "todo"
 28130	                # tension 四欄都給審查席看——反駁的就是這四欄(2026-09-09 兩席相反時端出張力;「｜」分隔是編排者裁的,四欄需要分隔)
 28131	                else (f"選 {e.get('chosen') or ''}｜既有 {', '.join(str(x) for x in (e.get('existing') or []))}｜隱患 {e.get('hazard') or ''}｜建議 {e.get('suggestion') or ''}") if st == "tension"
 28132	                else str(e.get("reason") or ""))   # 全部 str(… or ""):治理帳重建來的紀錄不重驗形狀,缺欄不能炸(r1 正確性席 f3)
 28133	        lines.append(f"  {q} {st} — {str(tail)[:200]}")
 28134	    if n_auto:
 28135	        lines.append(f"  (另有 {n_auto} 題未觸發、工具自動記不適用)")
 28136	    return len(human)
 28137	
 28138	
 28139	def _lens_cache_path(repo_root, base_sha, head_sha, extra=""):
 28140	    import hashlib
 28141	    # repo 部分用 realpath(跟 armed 檔的 _lens_repo_key 同一種算法;code-codex-s1 r1 架構席:兩套 key 並存)
 28142	    # extra=表態記錄的 sha256(表態閘 S8):重表態之後舊快取自然 miss
 28143	    key = hashlib.sha256(f"{os.path.realpath(str(repo_root))}|{base_sha}|{head_sha}|schema{_LENS_SCHEMA}|{extra}".encode("utf-8")).hexdigest()   # 帶 schema 版本:v1.1 舊快取自然 miss(v1.2 r2 外家)
 28144	    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / f"{key}.json"
 28145	
 28146	
 28147	def _lens_cache_read(path, ttl_sec=1200):
 28148	    """只信自己 uid 擁有、group/other 不可寫、TTL 內的檔(r3 載荷席:$TMPDIR 路徑可預測可偽造)。"""
 28149	    import json as _json, stat as _stat, time as _time
 28150	    try:
 28151	        st = path.stat()
 28152	        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):
 28153	            return None
 28154	        if _time.time() - st.st_mtime > ttl_sec:
 28155	            return None
