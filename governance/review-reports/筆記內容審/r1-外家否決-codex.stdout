 28101	def _lens_full_sha(repo_root, rev):
 28102	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 28103	    if r is None or r.returncode != 0:
 28104	        return None
 28105	    sha = r.stdout.strip()
 28106	    return sha if _LENS_SHA_RE.match(sha) else None
 28107	
 28108	
 28109	def _mainline_ref(repo_root, remote_only=False):
 28110	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 28111	    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
 28112	    拿它當「已在主線上」會把整批都排除掉)。"""
 28113	    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
 28114	        sha = _lens_full_sha(repo_root, cand)
 28115	        if sha:
 28116	            return cand, sha
 28117	    return None
 28118	
