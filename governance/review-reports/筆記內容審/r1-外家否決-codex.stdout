 15023	def _rel_cascade_dir(env):
 15024	    """帳本目錄=<repo root>/governance/rel-cascade(可追蹤逐 cascade 檔,非 vault-parent 隱藏帳慣例——
 15025	    刻意設計)。repo root:docs/<slug>-knowledge 型= docs 的上層;standalone vault=vault 自身
 15026	    (絕不往系統 temp 等共用父層爬;.jsonl 非 .md,load_vault 不掃、無污染)。"""
 15027	    root = env.vault.parent.parent if env.vault.parent.name == "docs" else env.vault
 15028	    return root / "governance" / "rel-cascade"
