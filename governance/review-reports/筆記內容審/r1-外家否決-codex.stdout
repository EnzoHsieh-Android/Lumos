 23479	def _note_shape_config(text):
 23480	    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
 23481	    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
 23482	    if text is None:
 23483	        return "block", []
 23484	    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 23485	    try:
 23486	        data = json.loads(raw)
 23487	    except Exception as e:
 23488	        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
 23489	    ns = data.get("note_shape") if isinstance(data, dict) else None
 23490	    if ns is None:
 23491	        return "block", []
 23492	    if not isinstance(ns, dict):
 23493	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23494	    g = ns.get("gate", "block")
 23495	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23496	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23497	    return g, []
 23498	
 23499	
 23500	def _ns_regions(text):
 23501	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23502	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23503	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23504	    lines = text.split("\n")
 23505	    fm, _body = split_frontmatter(text)
 23506	    if fm is None:
 23507	        if text.startswith("---"):
 23508	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23509	        return ["body"] * len(lines)
 23510	    out = ["body"] * len(lines)
 23511	    end = len(fm) + 1                            # 收尾 --- 那一行
 23512	    out[0] = out[end] = "other"
 23513	    cur = "other"
 23514	    for i in range(1, end):
 23515	        ln = lines[i]
 23516	        m = TOP_KEY_RE.match(ln)
 23517	        if m:
 23518	            k = m.group(1)
 23519	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23520	            out[i] = "other"
 23521	            continue
 23522	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23523	    return out
 23524	
 23525	
 23526	def _ns_parse_added(raw):
 23527	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23528	    out, path, n = {}, None, 0
 23529	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23530	        if ln.startswith("+++ "):
 23531	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23532	            path = nfc(p[2:]) if p.startswith("b/") else None
 23533	            continue
 23534	        if ln.startswith("@@"):
 23535	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23536	            n = int(m.group(1)) if m else 0
 23537	            continue
 23538	        if path is None or ln.startswith("---"):
 23539	            continue
 23540	        if ln.startswith("+"):
 23541	            out.setdefault(path, []).append((n, ln[1:]))
 23542	            n += 1
 23543	    return out
 23544	
 23545	
 23546	def _ns_git(repo_root, *args):
 23547	    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
 23548	    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
 23549	    r = _lens_git(repo_root, *args, quote=True, binary=True)
 23550	    if r is None or r.returncode != 0:
 23551	        return None
 23552	    return r.stdout
 23553	
 23554	
 23555	def _ns_diff(repo_root, *args):
 23556	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23557	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
 23558	
 23559	
 23560	def _ns_mainline_refs(repo_root):
 23561	    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
 23562	    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
 23563	    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
 23564	    ml = _mainline_ref(repo_root, remote_only=True)
 23565	    return [ml[1]] if ml else []
 23566	
 23567	
 23568	def _ns_exclusions(repo_root, tip):
 23569	    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
 23570	    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
 23571	    out = []
 23572	    for ref in _ns_mainline_refs(repo_root):
 23573	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
 23574	        if r is not None and r.returncode == 1:
 23575	            out.append(ref)
 23576	    return out
 23577	
