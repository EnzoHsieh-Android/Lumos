     6	# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
     7	#
     8	# 為什麼需要:
     9	#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
    10	#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
    11	#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
    12	#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
    13	#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
    14	#
    15	# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
    16	#
    17	# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效
    18	
    19	set -u
    20	
    21	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    22	cd "$REPO_ROOT" || exit 0
    23	
    24	# ── stdin 必須最先讀(prepush範圍修法 #1)──
    25	# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
    26	# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
    27	# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
    28	_PP_LINES=()
    29	while IFS= read -r _line; do
    30	  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
    31	done
    32	
    33	_ZERO="0000000000000000000000000000000000000000"
    34	_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"
    35	
    36	# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
    37	# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
    38	# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
    39	pp_range_for() {
    40	  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    41	    printf '%s..%s' "$_EMPTY_TREE" "$2"
    42	  else
    43	    printf '%s..%s' "$1" "$2"
    44	  fi
    45	}
    46	
    47	# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
    48	# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
    49	# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
    50	pp_touched_file() {
    51	  local _f _r
    52	  [[ -n "$_EMPTY_TREE" ]] || return 0
    53	  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
    54	  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
    55	  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
    56	  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
    57	  _f="$_PP_TMP/touched.txt"
    58	  : > "$_f" 2>/dev/null || return 0
    59	  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    60	    read -r _ _lsha _ _rsha <<< "$_ppl"
    61	    [[ "$_lsha" == "$_ZERO" ]] && continue
    62	    _r="$(pp_range_for "$_rsha" "$_lsha")"
    63	    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
    64	  done
    65	  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
    66	}
    67	
    68	# 無 lumos / python3 → 降級放行(不為缺環境 brick push,CI 兜底)
    69	GRAPHCTL="$REPO_ROOT/scripts/lumos"
    70	PY="$(command -v python3 || command -v python || true)"
    71	
    72	# ── 波及計算(給合約測試閘用):這裡只呼叫、不碰內容。
    73	# ★一次推送只算一次波及★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):以前同步點名與合約測試閘各自呼叫,
    74	# 等於一次推送算兩次——這不是便宜的計算。算一次寫進暫存檔給消費者讀。
    75	# (2026-09-11 起同步點名改由每支檔有家照家算,不再讀這一份;見下面 sync_nudge 原位置的說明。)
    76	# ★失敗隔離★:算不出來 → 暫存檔不存在或是空的 → 合約測試閘記一筆帳放行,不拖垮別的檢查。
    77	_IMPACT_JSON=""
    78	impact_once() {   # $1=diff range;算一次,結果放進 $_IMPACT_JSON
    79	  _IMPACT_JSON=""
    80	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
    81	  # ★用同檔既有的樣板寫法與命名家族★(代碼審 r1 架構對齊席):
    82	  # 同一支腳本下面幾行就有 lumos-prepush-autoloop-XXXXXX / lumos-prepush-tests-XXXXXX,
    83	  # 而且旁邊的註解特別說明過「★XXXXXX 必須在結尾★」是踩過才定下來的。
    84	  local _f; _f="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-impact-XXXXXX" 2>/dev/null || true)"
    85	  [ -n "$_f" ] || return 0
    86	  if "$PY" "$GRAPHCTL" impact --diff "$1" --sync-check --json --repo "$REPO_ROOT" > "$_f" 2>/dev/null \
    87	     && [ -s "$_f" ]; then
    88	    _IMPACT_JSON="$_f"
    89	  else
    90	    rm -f "$_f"
    91	  fi
    92	}
    93	impact_done() { [ -n "$_IMPACT_JSON" ] && rm -f "$_IMPACT_JSON"; _IMPACT_JSON=""; }
    94	# ★硬擋或收到訊號時也要清★(代碼審 r1 外家否決席判 minor,屬實):
    95	# 上面那支只在 ref 迴圈正常跑到尾端時執行。高風險那條路 rc1 會直接 exit 1,
    96	# 收到訊號也一樣——每被硬擋一次就留一個暫存檔在 $TMPDIR 裡慢慢累積。
    97	# 本次推送所有暫存檔的家,離開時整個清(r1 併發席:逐檔 rm 在 exit 1 / Ctrl-C 那條路會漏)。
    98	# 建不出來就擋(r2 邊界席):空字串會讓後面每個 "$_PP_TMP/…" 變成根目錄路徑,測試 log 全寫不出來、擋下訊息一片空白。
    99	_PP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/lumos-prepush-XXXXXX" 2>/dev/null || true)"
   100	if [[ -z "$_PP_TMP" || ! -d "$_PP_TMP" ]]; then
   101	  echo "擋下:推送前檢查需要一個暫存目錄,但 ${TMPDIR:-/tmp} 建不出來(不存在或不可寫);修好 TMPDIR 再推。" >&2
   102	  exit 1
   103	fi
   104	trap 'impact_done; rm -rf "$_PP_TMP"' EXIT INT TERM
   105	# (2026-09-11 起「該動哪篇」的點名改由每支檔有家照家算——下面 home check --diff 會印;原本這裡以反引號為種子的
   106	#  impact --sync-only 會把人推回寫了一堆別人檔名的大雜燴節點,拿掉。Projects/每支檔有家_計劃 [S15]。impact_once 留給合約測試閘用。)
   107	# ★合約測試閘:低風險也跑,紅了印出來記帳但不擋;高風險照舊擋★(人裁 2026-09-07)
   108	# 不選「低風險也擋」的理由:擋下去最可能的結果不是人去修測試,是人改走 --no-verify
   109	# ——而這支腳本自己在別的地方就把那條當第三選項在教,那條零留痕。
   110	bound_tests_advisory() {   # $1=diff range(暫存檔沒算出來時退回自己算)
   111	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
   112	  if [ -n "$_IMPACT_JSON" ]; then
   113	    "$PY" "$GRAPHCTL" bound-tests --from-json "$_IMPACT_JSON" --advisory --repo "$REPO_ROOT" || true
   114	  else
   115	    "$PY" "$GRAPHCTL" bound-tests --diff "$1" --advisory --repo "$REPO_ROOT" || true
   116	  fi
   117	}
   118	if [[ -z "$PY" || ! -f "$GRAPHCTL" ]]; then
   119	  echo "提醒:這台機器找不到 python3 或 lumos,推送前的知識庫檢查這次沒跑;推上去之後 CI 會再跑一遍兜底。" >&2
   120	  exit 0
   121	fi
   122	
   123	# ★同一次推送的事件要串得起來★(#19 S6):這支是逐 ref 迴圈,而錨點與健檢跑在迴圈外面
   124	# ——「當下的 commit」對整支層級的閘沒有唯一答案(同次推多個 ref、推的不是目前 checkout 的 ref、
   125	# detached HEAD 或推 tag,盲取 HEAD 都會歸錯)。所以整支層級的事件改用這個一次性識別碼,
   126	# 逐 ref 的事件另外帶那一行真正的 sha。lumos 端讀這個環境變數,hook 只負責產生它。
   127	export LUMOS_PUSH_ATTEMPT="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
   128	
   129	# 錨點完整性:驗證器(runner/hooks)沒被動過,後面的「doctor 過/測試綠」才可信(repo 層,vault 無關)
   130	if ! "$PY" "$GRAPHCTL" anchor verify; then
   131	  {
   132	    echo ""
   133	    echo "擋下:負責把關的檔案(測試程式、hook 腳本)跟登記過的版本不一樣。"
   134	    echo "這些檔案是裁判,裁判被改過而沒人簽名,後面所有「測試綠、檢查過」都不可信,所以先擋。"
   135	    echo ""
   136	    echo "三條路選一條:"
   137	    echo "  1. 不是故意改的 → 把那個檔還原再推:"
   138	    echo "       git checkout -- <檔案>"
   139	    echo "  2. 是故意改的 → 簽名登記新版本再推:"
   140	    echo "       lumos anchor approve --note \"為什麼改\""
   141	    echo "  3. 真的要先推 → git push --no-verify(CI 之後會發現少了簽名紀錄)"
   142	    echo ""
   143	  } >&2
   144	  exit 1
   145	fi
   146	
   147	# ★簽名檔要跟著推★(2026-09-06 實際被 CI 咬到):上面那道拿的是「工作目錄現在的樣子」,
   148	# 所以你剛簽完名它就是綠的;但 CI 拿的是「已經推上去的內容」。簽名檔沒 commit 就推,
   149	# 這邊全綠、CI 必紅——而且錯誤訊息會叫你再簽一次名,再簽也沒用,因為問題是沒提交。
   150	_BASELINE="governance/anchor-baseline.json"
   151	if [[ -f "$REPO_ROOT/$_BASELINE" ]] && ! git -C "$REPO_ROOT" diff --quiet -- "$_BASELINE" 2>/dev/null; then
   152	  {
   153	    echo ""
   154	    echo "擋下:簽名檔改過了但沒提交,這樣推上去 CI 一定紅。"
   155	    echo "你剛才簽了名(或它被更新過),但那個改動還留在工作目錄裡沒進版控;"
   156	    echo "推送前的檢查看的是工作目錄所以是綠的,CI 看的是推上去的內容,對不起來。"
   157	    echo ""
   158	    echo "把它一起提交再推:"
   159	    echo "       git add $_BASELINE && git commit -m \"gov: 錨點簽名\""
   160	    echo ""
   161	  } >&2
   162	  exit 1
   163	fi
   164	
   165	# ══ 閘的順序(2026-09-06 全 repo 審視 #12 重排)══
   166	# 便宜的先跑、貴的最後。實測:除了全套測試以外,所有閘加起來約 13 秒
   167	# (anchor 0.22s / 簽名檔 0.04s / doctor 1.1s / pitfalls 0.23s / code-loop 0.61s
   168	#  / test-layers 0.21s / 自主迴圈那支 10.3s),而全套是 8 分鐘。
   169	# ★原本全套排在第四位★,所以被那 13 秒裡任何一道擋下時,8 分鐘已經白燒完了。
   170	
   171	# 圖譜健康(只在 vault 存在時跑)
   172	# ★2026-09-06 重排:原本這段在最後面,而且「沒有 vault 就 exit 0」會直接結束整支 hook。
   173	#   現在它排在全套測試之前,那個 exit 0 會把後面的測試閘一起跳掉——所以改成只跳過這一段。
   174	have_vault=0
   175	for d in docs/*-knowledge docs/knowledge; do
   176	  [[ -d "$d" ]] && have_vault=1 && break
   177	done
   178	_TOUCHED_F="$(pp_touched_file)"
   179	_DOCTOR_ARGS=(doctor --ci)
   180	[[ -n "$_TOUCHED_F" ]] && _DOCTOR_ARGS+=(--touched-from "$_TOUCHED_F")
   181	if [[ $have_vault -eq 1 ]] && ! "$PY" "$GRAPHCTL" "${_DOCTOR_ARGS[@]}"; then
   182	  {
   183	    echo ""
   184	    echo "擋下:知識庫健康檢查發現問題(細節在上面)。"
   185	    echo "有問題的筆記推上去,下一個讀它的人會拿到錯的合約或斷掉的連結。"
   186	    echo ""
   187	    echo "三條路選一條:"
   188	    echo "  1. 照上面的提示把筆記修好再推。"
   189	    echo "  2. 覺得是檢查工具本身判錯 → 本機重跑一次確認,真的是工具錯就開一張 Issue 記下來。"
   190	    echo "  3. 真的要先推 → git push --no-verify(CI 還是會跑全套,紅了會看到)"
   191	    echo ""
   192	  } >&2
   193	  exit 1
   194	fi
   195	
   196	
   197	# 代碼偏科 + code-loop 必用守衛(tier=high):push 前把 diff 的代碼形態風險攤在眼前。
   198	# prepush範圍修法(2026-07-21):改讀 stdin 推送範圍逐 ref 判,取代 merge-base——分支與
   199	# main-direct 同軌;無基準(新 ref/缺物件)倒向保守掃 empty-tree..local_sha(非 fail-open,
   200	# 否則守衛升格成穩定繞法);留痕綁 remote_ref 目的地(非 checkout);逐 ref 獨立判,某 ref
   201	# high 未過即擋。fail-open 僅剩:pitfalls 本身出錯 / empty-tree 都跑不動。
   202	# 推送前要跑哪個測試範圍(2026-09-18 Enzo 裁:純文件改動、或判成 light 的小改動,不用等全套):
   203	# 每個 ref 各判一次,任何一個 ref 要全套就全套。docs=只改到 README/docs/assets 這類文件(pitfalls --json 的 suite);
   204	# light=改到程式檔但 spec-gate --push-check 判成 light(風險低計劃、全靠人驗、小改動閘過)。
   205	_SUITE_SEEN=0; _SUITE_FULL=0; _SUITE_LIGHT=0; _SUITE_KEYS=""; _SUITE_GRAPH=0; _AUTOLOOP_FULL=0
   206	for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
   207	  read -r _lref _lsha _rref _rsha <<< "$_ppl"
   208	  # 刪除遠端 ref(local_sha 全零)→ 無代碼推送,跳過
   209	  [[ "$_lsha" == "$_ZERO" ]] && continue
   210	  # 推導檢查範圍(同一套推導另一個使用者是上面的圖譜健康那一段,所以抽成函式——
   211	  # 兩處各寫一份的話,哪天保守兜底改了只改一邊,擋的範圍就會兩邊不一致)
   212	  _range="$(pp_range_for "$_rsha" "$_lsha")"
   213	  [[ -z "$_EMPTY_TREE" ]] && continue   # 連空樹都算不出=git 環境壞,advisory 放行
   214	
   215	  # 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S26]):把這次要推的範圍整段查一次,接住跳過提交前檢查的。
   216	  # ★新分支不沿用上面的空樹兜底★(那會把整段歷史當新改動,本工具鏈有 1900 多個提交):起點改用
   217	  # 「不在任何遠端分支上的提交」裡最早那一個的上一個提交;全部已在遠端就不查;最早那個沒有上一個提交(真的全新)才從空樹比。
   218	  # 起點早於這道檢查上線的那個提交時,lumos 會自己改從上線點算(上線前進來的是舊帳)。rc1=擋;其他非零=放行。
   219	  # ★跟上面 _range 是刻意不同的兩套★(代碼審 r1 架構席問過):_range 給波及計算與風險掃描用,只提醒、寧可掃多;
   220	  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
   220	  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
   221	  _hrange=""
   222	  if [[ "$_rsha" != "$_ZERO" ]] && git cat-file -e "$_rsha" 2>/dev/null; then
   223	    _hrange="$_rsha..$_lsha"
   224	  else
   225	    _hold="$(git rev-list --topo-order --reverse "$_lsha" --not --remotes 2>/dev/null | head -1)"
   226	    if [[ -n "$_hold" ]]; then
   227	      if git rev-parse -q --verify "$_hold^" >/dev/null 2>&1; then
   228	        _hrange="$(git rev-parse "$_hold^")..$_lsha"
   229	      else
   230	        _hrange="$_EMPTY_TREE..$_lsha"
   231	      fi
   232	    fi
   233	  fi
   234	  if [[ -n "$_hrange" ]]; then
   235	    nh_rc=0
   236	    "$PY" "$GRAPHCTL" home check --diff "$_hrange" --repo "$REPO_ROOT" || nh_rc=$?
   237	    if [[ "$nh_rc" -eq 1 ]]; then
   238	      {
   239	        echo ""
   240	        echo "逃生:照上面的指令替檔安家、或把說明改寫進對的那篇,再推;整個專案先改成只提醒 → .lumos/config.json 的 node_home.gate 設成 warn;緊急硬推 git push --no-verify(本機不留痕)。"
   241	        echo ""
   242	      } >&2
   243	      exit 1
   244	    fi
   245	    # 筆記形狀擋(Projects/筆記形狀擋_計劃):同一段範圍再查一次,接住 --no-verify 跳過提交前那道的;範圍算法同上(不用空樹兜底)
   246	    ns_rc=0
   247	    "$PY" "$GRAPHCTL" note-shape --diff "$_hrange" --repo "$REPO_ROOT" || ns_rc=$?
   248	    if [[ "$ns_rc" -eq 1 ]]; then
   249	      {
   250	        echo ""
   251	        echo "逃生:照上面改寫(行號改成函式名或測試名、或釘版本 路徑@<提交編號>:行號;現況描述刪掉或帶 [來源:…]);誤擋就 LUMOS_SKIP_NOTE_SHAPE=1 單次跳過(會留帳);整個專案先只提醒 → .lumos/config.json 的 note_shape.gate 設成 warn。"
   252	        echo ""
   253	      } >&2
   254	      exit 1
   255	    fi
   256	  fi
   257	
   258	  impact_once "$_range"
   259	  pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
   260	  _tier_high=0
   261	  printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
