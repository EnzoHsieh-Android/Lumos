 24041	def _cochange_repo_root(repo):
 24042	    """repo root:--repo 指定則驗證之,否則 cwd 逐層向上找 .git。找不到回 None。"""
 24043	    if repo:
 24044	        p = Path(repo).resolve()
 24045	        return p if (p / ".git").exists() else None
 24046	    p = Path.cwd()
 24047	    for cand in (p, *p.parents):
 24048	        if (cand / ".git").exists():
 24049	            return cand
 24050	    return None
 24051	
