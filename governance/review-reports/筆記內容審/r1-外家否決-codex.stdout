 21483	def _lint_new_oversize(head_files, base_files, cfg):
 21484	    """挑出「太大所以不掃」的檔,並從兩邊的清單裡拿掉。回 [{file,lines,bytes,key,over}…]。
 21485	    ★大檔也要有指紋才放行得掉★:綁路徑不綁內容——那支檔會一直很大,綁內容的話每改一次就要重新登記。
 21486	    ★只看行數會被「整支檔只有一行」的壓縮檔騙過去★,所以兩個門檻都看。"""
 21487	    import hashlib as _hl
 21488	    out = []
 21489	    for f, path in list(head_files.items()):
 21490	        try:
 21491	            raw = Path(path).read_bytes()
 21492	        except OSError:
 21493	            continue
 21494	        n_bytes, n_lines = len(raw), raw.count(b"\n") + 1
 21495	        if n_lines <= cfg["max_file_lines"] and n_bytes <= cfg["max_file_bytes"]:
 21496	            continue
 21497	        key = _hl.sha256(("oversize" + _LINT_NEW_SEP + f).encode("utf-8")).hexdigest()[:16]
 21498	        out.append({"file": f, "lines": n_lines, "bytes": n_bytes, "key": key,
 21499	                    "over": "行數" if n_lines > cfg["max_file_lines"] else "位元組數"})
 21500	        head_files.pop(f, None)
 21501	        base_files.pop(f, None)
 21502	    return out
