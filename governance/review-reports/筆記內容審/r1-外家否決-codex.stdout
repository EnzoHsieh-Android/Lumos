 31696	def _fill_help_when(parser, parent=""):
 31697	    """遞迴把 HELP_WHEN 灌進每個沒有 description 的子指令,讓 `lumos X --help` 第一行講人話。
 31698	    同名二層子指令(cochange check / code-loop check)先查「父 子」鍵再退回單名。"""
 31699	    for act in parser._actions:
 31700	        if isinstance(act, argparse._SubParsersAction):
 31701	            for name, sp in act.choices.items():
 31702	                if not sp.description:
 31703	                    when = HELP_WHEN.get(f"{parent} {name}".strip()) or HELP_WHEN.get(name)
 31704	                    if when:
 31705	                        sp.description = "什麼時候用:" + when
 31706	                _fill_help_when(sp, name)
 31707	
 31708	def main():
 31709	    class _LumosParser(argparse.ArgumentParser):
 31710	        """打錯指令時給人話 + 近名候選,不要吐一長串英文。
 31711	
 31712	        出身(2026-09-07 全 repo 審視 #9):打錯一個字母(例如 doctorr),argparse 預設會印
 31713	        usage 那行(把 66 個指令名擠成一串)再加一句英文 invalid choice,後面又把 66 個名字
 31714	        用引號逐個列一遍——**畫面上出現三次同一份清單,而使用者要的只是「你是不是想打 doctor」**。
 31715	
 31716	        放在 main() 裡面(全檔唯一一個巢狀 class,2026-09-07 代碼審 r1 架構席問過):
 31717	        它只有 main() 建 parser 時用得到,而且訊息內容綁著 main() 底下那份三步入口的措辭;
 31718	        提到模組層會讓人以為別處也該拿它當一般工具用,反而要多寫一段「只給 main 用」的說明。
 31719	        """
 31720	
