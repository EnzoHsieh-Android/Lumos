 15031	def _utc_ts():
 15032	    import datetime
 15033	    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
 15034	
 15035	
 15036	def _ledger_append(path, obj):
 15037	    """[M3 並行合約] O_APPEND fd + 單次 os.write() 整行 bytes(≤4KB 寫前拒,不截斷)。
 15038	    POSIX regular file 實務原子;Windows/跨平台 best-effort、預期單寫者(誠實降級,r1 D10)。
 15039	    無 O_CREAT——confirm/prune 永不建檔(建檔只屬觸發端 rel_cascade_create,r2 R4)。
 15040	    [code-loop r1] O_NOFOLLOW 拒 symlink 終點(字元白名單擋不住,CX1);os.write 回傳驗滿寫
 15041	    (ENOSPC 短寫會留中段殘行且 rc=0 假成功,B1)——短寫即 RuntimeError,呼叫端 rc=2。"""
 15042	    import json
 15043	    data = (json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8")
 15044	    if len(data) > 4096:
 15045	        raise ValueError(f"這筆事件有 {len(data)} 位元組,超過 4KB 上限,不寫(不截斷,免得寫一半)")
 15046	    fd = os.open(str(path), os.O_WRONLY | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0))
 15047	    try:
 15048	        written = os.write(fd, data)
 15049	        if written != len(data):
 15050	            raise RuntimeError(f"帳本短寫:只寫進 {written}/{len(data)} 位元組,可能磁碟滿了——這筆沒完整寫入,重試前先查空間")
 15051	    finally:
 15052	        os.close(fd)
 15053	
 15054	
 15055	def rel_cascade_create(env, root_gid, node_rel):
 15056	    """[M3 定址合約] 觸發端唯一鑄造者:mint cascade-id=c-<UTC秒ts>-<sha1(root全域id)[:8]>(-<n>)?
 15057	    + O_CREAT|O_EXCL 建檔寫 header。同秒撞名遞增序號(不等下秒;上限 99 防異常迴圈)。
 15058	    純生成、不含節點名——中文 rel 無淨化問題(r1 D5 消解)。回 cascade_id。"""
 15059	    import datetime, hashlib, json
 15060	    d = _rel_cascade_dir(env)
 15061	    d.mkdir(parents=True, exist_ok=True)
 15062	    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d%H%M%S")
 15063	    base = f"c-{ts}-{hashlib.sha1(root_gid.encode('utf-8')).hexdigest()[:8]}"
 15064	    for suffix in [""] + [f"-{i}" for i in range(1, 100)]:
 15065	        cid = base + suffix
 15066	        p = d / (cid + ".jsonl")
 15067	        try:
 15068	            fd = os.open(str(p), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
 15069	        except FileExistsError:
 15070	            continue
 15071	        try:
 15072	            hdr = json.dumps({"event": "header", "ts": _utc_ts(),
 15073	                              "root_decision_id": root_gid, "node": node_rel},
 15074	                             ensure_ascii=False) + "\n"
 15075	            os.write(fd, hdr.encode("utf-8"))
 15076	        finally:
 15077	            os.close(fd)
 15078	        return cid
 15079	    raise RuntimeError("連續 99 次都撞到同名的 cascade 編號,目錄可能有問題")
 15080	
