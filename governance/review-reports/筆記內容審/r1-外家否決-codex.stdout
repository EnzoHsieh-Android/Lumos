 23526	def _ns_parse_added(raw):
 23527	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23528	    out, path, n = {}, None, 0
 23529	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23530	        if ln.startswith("+++ "):
 23531	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23532	            path = nfc(p[2:]) if p.startswith("b/") else None
 23533	            continue
 23534	        if ln.startswith("@@"):
 23535	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23536	            n = int(m.group(1)) if m else 0
 23537	            continue
 23538	        if path is None or ln.startswith("---"):
 23539	            continue
 23540	        if ln.startswith("+"):
 23541	            out.setdefault(path, []).append((n, ln[1:]))
 23542	            n += 1
 23543	    return out
 23544	
 23545	
 23546	def _ns_git(repo_root, *args):
 23547	    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
 23548	    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
 23549	    r = _lens_git(repo_root, *args, quote=True, binary=True)
 23550	    if r is None or r.returncode != 0:
 23551	        return None
 23552	    return r.stdout
 23553	
 23554	
 23555	def _ns_diff(repo_root, *args):
 23556	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23557	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
 23558	
 23559	
 23560	def _ns_mainline_refs(repo_root):
 23561	    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
 23562	    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
 23563	    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
 23564	    ml = _mainline_ref(repo_root, remote_only=True)
 23565	    return [ml[1]] if ml else []
 23566	
 23567	
 23568	def _ns_exclusions(repo_root, tip):
 23569	    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
 23570	    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
 23571	    out = []
 23572	    for ref in _ns_mainline_refs(repo_root):
 23573	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
 23574	        if r is not None and r.returncode == 1:
 23575	            out.append(ref)
 23576	    return out
 23577	
 23578	
 23579	def _ns_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, mark=None, max_count=None):
 23580	    """推送前:範圍裡每個提交各自新增的筆記行 → ({NFC 路徑: 行文字集合}, [範圍淨改動的筆記路徑(git 原樣)],
 23581	    {NFC 路徑: 這道檢查還沒上線的提交寫的行})。git 失敗回 None。
 23582	    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
 23583	    改名照每個提交(合併提交是每個上一版)的改名偵測往後帶到終點路徑(r3 外家席)。
 23584	    ★鍵用 NFC、拿去 git 查的一律用原樣路徑★(驗收輪通才席:NFC 過的路徑對存 NFD 的樹 cat-file、路徑篩選都查不到)。
 23585	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
 23586	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
 23587	    ★寫的時候這道檢查還沒上線的提交不查★(mark):看那個提交自己的提交前掛鉤有沒有上線標記——上線前開的分支上線後
 23588	    才合進來,那些行是舊帳(r3 通才席);原本用「是不是上線點的後代」代替,兩條分支各自裝過時另一條整批漏查(驗收輪通才席)。
 23589	    那些行另外收進第三個回傳值,喚醒那條路也跳過(驗收輪外家席)。max_count:只看最新那幾個提交(doctor 的上限)。"""
 23590	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23591	    if exclude_remote:
 23592	        ml = _ns_exclusions(repo_root, tip)
 23593	        if ml:
 23594	            rl += ["--not", *ml]
 23595	    if max_count:
 23596	        rl.append(f"--max-count={int(max_count)}")
 23597	    raw = _nodehome_git(repo_root, *rl)
 23598	    if raw is None:
 23599	        return None
 23600	    commits = [ln.split() for ln in raw.decode("ascii", errors="replace").splitlines() if ln.split()]
 23601	    live = None
 23602	    if mark and commits:
 23603	        hb = _nodehome_cat_blobs(repo_root, [f"{c[0]}:scripts/hooks/pre-commit" for c in commits])
 23604	        if hb is None:
 23605	            return None
 23606	        live = {c[0] for c, b in zip(commits, hb, strict=False) if b is not None and mark.encode() in b}
 23607	    by_path, old_by = {}, {}
 23608	
 23609	    def _renames(a, b):
 23610	        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
 23611	        return None if r is None else _nodehome_name_status(r, norm=False)[1]     # 原樣 新路徑 → 舊路徑
 23612	
 23613	    def _carry(ren):
 23614	        for new_, old_ in (ren or {}).items():
 23615	            ko, kn = nfc(old_), nfc(new_)
 23616	            for d_ in (by_path, old_by):
 23617	                if ko in d_ and ko != kn:
 23618	                    d_.setdefault(kn, set()).update(d_.pop(ko))
 23619	
 23620	    for shas in commits:
 23621	        sha, parents = shas[0], shas[1:]
 23622	        first = parents[0] if parents else _EMPTY_TREE_SHA
 23623	        ren = _renames(first, sha)
 23624	        if ren is None:
 23625	            return None
 23626	        _carry(ren)
 23627	        dest = by_path if (live is None or sha in live) else old_by
 23628	        if len(parents) <= 1:
 23629	            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
 23630	            if d is None:
 23631	                return None
 23632	            for p, rows in _ns_parse_added(d).items():
 23633	                dest.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23634	            continue
 23635	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 23636	        if names is None:
 23637	            return None
 23638	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23639	        pren = [_renames(pp, sha) or {} for pp in parents]
 23640	        for pr in pren[1:]:
 23641	            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
 23642	            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
 23643	            _carry(pr)
 23644	        specs = []
 23645	        for p in paths:
 23646	            specs.append(f"{sha}:{p}")
 23647	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren, strict=False)]
 23648	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23649	        k = 1 + len(parents)
 23650	        for i, p in enumerate(paths):
 23651	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23652	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23653	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23654	                d = _ns_diff(repo_root, first, sha, "--", p)
 23655	                if d is None:
 23656	                    return None
 23657	                for _p, rows in _ns_parse_added(d).items():
 23658	                    dest.setdefault(nfc(p), set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23659	            else:
 23660	                dest.setdefault(nfc(p), set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
 23661	    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 23662	    if net is None:
 23663	        return None
 23664	    return by_path, [p for p in _nodehome_split_z(net) if p.endswith(".md")], old_by
 23665	
 23666	
 23667	def _ns_is_code(path, reader, files):
 23668	    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
 23669	    if path not in files:
 23670	        return False
 23671	    kind = _nodehome_code_kind(path)
 23672	    if kind == "ext":
 23673	        return True
 23674	    if kind != "shebang?":
 23675	        return False
 23676	    b = reader(path)
 23677	    return b is not None and _head_is_shebang(b[:200])
 23678	
 23679	
 23680	# 只放連結的指路行:連結裡不准有別名或段落(`[[目標|別名]]`、`[[目標#段落]]` 都能夾帶現況,代碼審 r2、r3 通才席);
 23681	# 分隔認中文常用的標點與連接詞(r3 外家席:原本把全形逗號打成半形,測試也用半形,假綠)
 23682	_NS_POINTER_ONLY_RE = re.compile(r"^(?:\s*(?:\[\[[^\]|#]+\]\]|見|→|,|\uff0c|、|\u3002|;|\uff1b|與|和|及|\||｜)\s*)*$")
 23683	
 23684	
 23685	def _ns_pin_ok(repo_root, p, lno, s):
 23686	    sha = _pin_commit(repo_root, s)
 23687	    return sha is not None and _validate_repo_ref(repo_root, p, lno, at_sha=sha)[0] == "ok"
 23688	
 23689	
 23690	def _ns_is_regen(text):
 23691	    """帶 regen 的重建筆記:照 Check J 看解析後的值(空字串不算;代碼審 r3 外家席:原本看原始文字,`regen: ""` 也算)。"""
 23692	    fm, _b = split_frontmatter(text)
 23693	    if not fm:
 23694	        return False
 23695	    v = parse_frontmatter(fm)[0].get("regen")
 23696	    return isinstance(v, str) and bool(v.strip())
 23697	
 23698	
 23699	def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name, regen=False):
 23700	    """一行新增內容 → [(規則, 片段, 改法)]。by_name(檔名)→ 同名的程式檔清單。"""
 23701	    out = []
 23702	    # [src:路徑:行號] 是從程式碼重建的筆記的出處標記,★只在帶 regen 的筆記的 summary 裡★歸重建守衛(Check J)驗;
 23703	    # 別的地方照一般行號引用判(代碼審 r2 通才席:原本對所有筆記豁免,一般筆記寫 [src:…] 就能夾帶行號)
 23704	    scan = SRC_REF_RE.sub(" ", text) if (regen and region == "summary") else text
 23705	    pins, singles = [], []
 23706	    full, _bare = _node_code_ref_tokens(scan, top_dirs, bare_text=True, anchors=True, keep_fences=True,
 23707	                                        pins=pins, singles=singles,
 23708	                                        exists=lambda x, _s=None: x in files or ("/" not in x and bool(by_name(x))))
 23709	    fix_pin = ("`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
 23710	               "HEAD、分支名、標籤會移動,不算釘住")
 23711	
 23712	    for p, lno, s in pins:
 23713	        # 只管程式檔與測試檔——跟沒釘版本時一致(.md、不存在的路徑都不管;代碼審 r1 測試席、r2 外家席)
 23714	        if lno and _ns_is_code(p, reader, files) and not _ns_pin_ok(repo_root, p, lno, s):
 23715	            out.append(("釘版本不合法", f"`{p}@{s}:{lno}`", fix_pin))
 23716	    for p, lno in full:
 23717	        if lno and _ns_is_code(p, reader, files):
 23718	            out.append(("程式行號引用", f"`{p}:{lno}`",
 23719	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{lno}`"))
 23720	    for name, lno, s in singles:
 23721	        cands = by_name(name)
 23722	        if len(cands) != 1:
 23723	            continue
 23724	        if s is None:
 23725	            out.append(("程式行號引用", f"`{name}:{lno}`(= {cands[0]})",
 23726	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{lno}`"))
 23727	        elif not _ns_pin_ok(repo_root, cands[0], lno, s):
 23728	            out.append(("釘版本不合法", f"`{name}@{s}:{lno}`(= {cands[0]})", fix_pin))
 23729	    if region == "summary":
 23730	        m = SYMBOL_RE.match(text.strip())
 23731	        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
 23732	        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
 23733	        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
 23734	        if m and not skip:
 23735	            for _w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
 23736	                out.append(("現況描述沒寫來源", text.strip()[:60],
 23737	                            "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
 23738	    return out
 23739	
 23740	
 23741	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 23742	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 23743	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 23744	    if ch is None:
 23745	        return []
 23746	    lst_t = _nodehome_list(repo_root, tip_where)
 23747	    lst_b = _nodehome_list(repo_root, base_where)
 23748	    if lst_t is None or lst_b is None:
 23749	        return []
 23750	    reader_b = _nodehome_reader(repo_root, base_where)
 23751	    out = []
 23752	    for code, _old, new in ch:
 23753	        if not new or code == "D":
 23754	            continue
 23755	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 23756	            continue
 23757	        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
 23758	        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
 23759	            out.append(new)
 23760	    return out
 23761	
 23762	
 23763	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
 23764	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 23765	    reader = _nodehome_reader(repo_root, tip_where)
 23766	    lst = _nodehome_list(repo_root, tip_where)
 23767	    if lst is None:
 23768	        return None
 23769	    files = lst[0]
 23770	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 23771	    _names, _name_cache = {}, {}
 23772	    for p in files:
 23773	        if _nodehome_code_kind(p) is not None:
 23774	            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23775	
 23776	    def by_name(name):
 23777	        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
 23778	        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
 23779	        if name not in _name_cache:
 23780	            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
 23781	        return _name_cache[name]
 23782	    viol, errs = [], []
 23783	    # 1) 這次新增的行
 23784	    if staged:
 23785	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23786	        if d is None:
 23787	            return None
 23788	        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
 23789	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23790	        texts_by, old_by = None, {}
 23791	    else:
 23792	        mk = mark or _NOTE_SHAPE_GOLIVE_MARK
 23793	        ra = _ns_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
 23794	                             mark=mk if _nodehome_golive(repo_root, tip_where, mk) else None, max_count=max_count)
 23795	        if ra is None:
 23796	            return None
 23797	        texts_by, paths, old_by = ra
 23798	        cand = {p: None for p in paths}
 23799	    for p, linenos in sorted(cand.items()):
 23800	        b = reader(p)
 23801	        if b is None:
 23802	            continue
 23803	        try:
 23804	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 23805	        except UnicodeDecodeError:
 23806	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 23807	            continue
 23808	        lines = text.split("\n")
 23809	        regs = _ns_regions(text)
 23810	        regen = _ns_is_regen(text)
 23811	        for i, ln in enumerate(lines, 1):
 23812	            if linenos is not None and i not in linenos:
 23813	                continue
 23814	            if texts_by is not None and ln.strip() not in texts_by.get(nfc(p), ()):
 23815	                continue
 23816	            if not ln.strip() or regs[i - 1] == "other":
 23817	                continue
 23818	            for rule, frag, fix in _ns_check_line(repo_root, ln, regs[i - 1], files, reader, top_dirs, by_name, regen):
 23819	                viol.append((p, i, rule, frag, fix))
 23820	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 23821	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 23822	                             tip_where, reader)
 23823	    if became:
 23824	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 23825	        if gl is not None:
 23826	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 23827	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 23828	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 23829	            spec = "" if tip_where == "index" else tip_where
 23830	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 23831	            gl_reader = _nodehome_reader(repo_root, gl)
 23832	            seen = {(v[0], v[1]) for v in viol}
 23833	            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
 23834	            for p, blob in zip(notes_, blobs, strict=False):
 23835	                if blob is None:
 23836	                    continue
 23837	                text = blob.decode("utf-8-sig", errors="replace")
 23838	                if not any(x in text for x in keys):
 23839	                    continue
 23840	                old, regs_, regen_ = None, _ns_regions(text), _ns_is_regen(text)
 23841	                for n, ln in enumerate(text.split("\n"), 1):
 23842	                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
 23843	                        continue
 23844	                    if old is None:
 23845	                        ob = gl_reader(p)
 23846	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 23847	                    if ln.strip() in old or ln.strip() in old_by.get(nfc(p), ()):
 23848	                        continue
 23849	                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
 23850	                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
 23851	                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
 23852	                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
 23853	                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
 23854	                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
 23855	                                                             for x in became):
 23856	                            continue
 23857	                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
 23858	                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
 23859	    return viol, errs
