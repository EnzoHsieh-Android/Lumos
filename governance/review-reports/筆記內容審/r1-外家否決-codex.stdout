   856	def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
   857	                ref=None, nodes=None, extra=None):
   858	    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。
   859	
   860	    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
   861	    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
   862	    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
   863	    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
   864	    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。
   865	
   866	    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
   867	    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
   868	    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
   869	    逐 ref 的事件另外帶那一行真正的 sha。
   870	
   871	    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
   872	    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
   873	    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
   874	    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
   875	    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
   876	    """
   877	    import json as _json
   878	    import datetime as _dt
   879	    root = Path(repo_root)
   880	    docs = root / "docs"
   881	    if not docs.is_dir():
   882	        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
   883	        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
   884	        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
   885	        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
   886	        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
   887	        return None
   888	    if not head_sha:
   889	        try:
   890	            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
   891	        except Exception:
   892	            head_sha = ""
   893	    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
   894	    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
   895	    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
   896	    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
   897	    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
   898	    if gate not in _KNOWN_GATES:
   899	        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
   900	              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
   901	              file=sys.stderr)
   902	        return False
   903	    ev = {
   904	        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
   905	        "commit": (head_sha or "")[:7],
   906	        "gate": gate, "kind": kind, "hard": bool(hard),
   907	        "nodes": list(nodes or []), "note": note,
   908	        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
   909	        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
   910	        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
   911	        "detail": note,
   912	    }
   913	    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
   914	    if att:
   915	        ev["attempt_id"] = att[:64]
   916	    if ref:
   917	        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
   918	        # 「目前不算功能性錯誤——新事件本來就不該被當成 marker」。
   919	        # ★那句話講的是一個保護,不是一個不一致★——我第一次折的時候把它當成欄名不一致、
   920	        # 順手加了 branch 別名,結果 blocked 事件當場被 _codeloop_read_from_ledger
   921	        # 當成留痕讀走,既有測試翻紅。欄名對齊只做 note/detail 那一半,分支識別不對齊。
   922	        ev["ref"] = ref
   923	    if head_sha:
   924	        ev["head_sha"] = head_sha
   925	    if extra:
   926	        ev.update(extra)
   927	    try:
   928	        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
   929	            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
   930	        return True
   931	    except OSError:
   932	        return False
   933	
   934	
   935	def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
   936	    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
   937	    ok = _gate_event(repo_root, gate, kind, note, **kw)
   938	    if ok is None:
   939	        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
   940	    if not ok:
   941	        print(f"  ⚠ telemetry-write-failed:{gate} 這一筆帳寫不進去(判定不受影響,照原樣執行)",
   942	              file=sys.stderr)
   943	    return ok
   944	
   945	
   946	def _sp_run_text(cmd):
   947	    import subprocess as _sp
   948	    return _sp.run(cmd, capture_output=True, text=True, errors="replace").stdout.strip()
