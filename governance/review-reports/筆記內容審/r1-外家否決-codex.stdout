   444	  if [[ "$_SUITE_SEEN" -eq 1 && "$_SUITE_FULL" -eq 0 ]] && grep -q -- '"--suite"' "$REPO_ROOT/scripts/test_lumos.py" 2>/dev/null; then
   445	    _suite_mode="docs"; [[ "$_SUITE_LIGHT" -eq 1 ]] && _suite_mode="light"
   446	  fi
   447	  _suite_args=(); _suite_word="全部測試"
   448	  if [[ "$_suite_mode" != "full" ]]; then
