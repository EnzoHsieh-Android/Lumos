 22969	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 22970	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 22971	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 22972	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 22973	    None=整批當成一個提交(提交前)。"""
 22974	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 22975	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 22976	    homesN, ownN = _nodehome_homes(repo_root, N)
 22977	    homesB, ownB = _nodehome_homes(repo_root, B)
 22978	    blocks, reminders, pairs = [], [], []
 22979	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 22980	    for code, old, new in changes:
 22981	        if old is not None and (new is None or code == "R"):
 22982	            deleted.add(old)
 22983	        if new is None:
 22984	            continue
 22985	        changed_new.add(new)
 22986	        if code in ("A", "R", "C"):
 22987	            added.add(new)
 22988	        if code == "R" and old:
 22989	            renamed_from[new] = old
 22990	    code_changed = {p for p in changed_new if p in reqN}
 22991	    code_added = {p for p in added if p in reqN}
 22992	    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
 22993	    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
 22994	    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
 22995	    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
 22996	    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
 22997	    code_touched = code_changed | code_deleted
 22998	    vpre = vault_rel + "/"
 22999	    refs_cache = {}
 23000	
 23001	    def refs_now(rel):
 23002	        if rel not in refs_cache:
 23003	            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
 23004	        return refs_cache[rel]
 23005	
 23440	    extra = {}
 23441	    if res["pairs"]:
 23442	        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
 23443	    if notes_:
 23444	        extra["notes"] = sorted(notes_)[:50]
 23445	    _gate_event_or_warn(root, "nodehome-check", kind,
 23446	                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
 23447	                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
 23448	    return 1 if kind == "blocked" else 0
