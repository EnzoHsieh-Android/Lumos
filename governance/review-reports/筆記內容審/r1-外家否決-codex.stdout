 22255	# ↑ 跟提交前掛鉤 should_exclude 的目錄排除同一份(t_nodehome_required_files_definition 逐字比對)
 22256	_NODEHOME_HOME_STATUSES = ("doing", "done", "stale")   # [S2] planned/deferred 還不是現況、rejected/superseded 已不是
 22257	_NODEHOME_GATE_VALUES = ("on", "warn", "off")          # [S37]
