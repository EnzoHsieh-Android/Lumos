 15531	def cmd_rel_cascade_write(env, verb, neighbor, cascade_id, from_id, edge, by):
 15532	    """[M3] confirm|prune:append 一筆 transition。寫前驗證(R4):檔存在(不存在→拒,建檔只屬觸發端)、
 15533	    header 合法(torn→拒,與 resume rc=1 救援語意按指令類別分流)、--from==header root(全鏈同源)。"""
 15534	    _validate_cascade_id(cascade_id)
 15535	    _validate_from_gid(from_id)
 15536	    nrel = env.find(neighbor)
 15537	    if nrel is None:
 15538	        raise ValueError(f"找不到相鄰的那篇筆記: {neighbor}")
 15539	    p = _rel_cascade_dir(env) / (cascade_id + ".jsonl")
 15540	    if not p.exists():
 15541	        raise ValueError(f"找不到 cascade 帳本 {cascade_id}——帳本只會在 decision-supersede 翻案時建立,confirm/prune 不會自己建")
 15542	    header, _ = _ledger_read(p)
 15543	    if header is None:
 15544	        raise ValueError("cascade 帳本的開頭壞了,不寫;用 resume 會把它標成不可恢復,後續靠健檢的 E2 補抓")
 15545	    if header.get("root_decision_id") != from_id.strip():
 15546	        raise ValueError(f"--from 指的決策不屬本 cascade(這本帳的起點是 {header.get('root_decision_id')}),一本帳只追同一條翻案鏈")
 15547	    state = "confirmed" if verb == "confirm" else "pruned"
 15548	    _ledger_append(p, {"event": "transition", "ts": _utc_ts(), "neighbor": nrel,
 15549	                       "edge_type": edge, "from_decision_id": from_id.strip(),
 15550	                       "state": state, "by": by})
 15551	    print(f"✓ rel-cascade {verb} {nrel} --edge {edge} ({cascade_id}, by={by})")
 15552	    # [decision_refs 自動養成 T1] confirm = 地面真相「鄰居依賴這條決策」→ 回寫 decision_ref。
 15553	    #   provenance 雙欄不對稱信任:by ai → decision_refs_ai(E3 firing 生效、E2 抑制碰不到);
 15554	    #   by human → decision_refs(可抑制 E2)。prune 不回寫(判無關=不記依賴)。
 15555	    #   回寫失敗=軟警告不回滾(帳本才是地面真相,decision_refs 是衍生、可從帳本重建)。
 15556	    if verb == "confirm":
 15557	        # [code-loop r1 C-medium] fail-**safe**:只有明確 by==human 才落可信正欄;非 ai/human
 15558	        #   (None/打錯/未來新值)一律落不可信 ai 欄——安全守門不靠上游 argparse 撐(誤落正欄=可抑制 E2)
 15559	        field = "decision_refs" if by == "human" else "decision_refs_ai"
 15560	        try:
