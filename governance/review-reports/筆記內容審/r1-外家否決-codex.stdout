 17224	def _skills_list():
 17225	    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
 17226	    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
 17227	    repo = Path(__file__).resolve().parent.parent
 17228	    d = repo / "skills"
 17229	    if not d.is_dir():
 17230	        return ()
 17231	    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))
