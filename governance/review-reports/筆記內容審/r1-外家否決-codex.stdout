 21509	    env_undone = [u for u in out["undone"] if u["kind"] == "env"]
 21510	    hard_undone = [u for u in out["undone"] if u["kind"] != "env"]
 22240	        for c in candidates:
 22241	            print(f"{c['name']} {c['current']} → {c['latest']}")
 22242	    return 0
