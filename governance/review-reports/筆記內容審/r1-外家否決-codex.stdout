 22329	# 斜線也算檔名字元:不然正文寫 lib/src/pay.py 會被判成「有提到 src/pay.py」(代碼審 r2 合約席)
 22330	_HOME_MENTION_BOUNDARY = re.compile(r"[A-Za-z0-9_.@+/\-]")
 22331	
 22332	
 22333	def _home_mentions(scan_text, rel_path):
 22334	    """這段文字有沒有提到這支檔(完整路徑或裸檔名,整詞比對)。
 22335	
 22336	    ★不要用 `base in scan` 這種子字串比對★:新掛 `a.py`、正文只寫了 `xa.py`,子字串會判成「有提到」,
 22337	    提醒就被吃掉——代碼審 r1 邊界席實測。所以命中位置的前後要是非檔名字元(或字串邊界)才算。
 22338	    """
 22339	    base = rel_path.rsplit("/", 1)[-1]
 22340	    for token in (rel_path, base):
 22341	        if not token:
 22342	            continue
 22343	        start = 0
 22344	        while True:
 22345	            i = scan_text.find(token, start)
 22346	            if i < 0:
 22347	                break
 22348	            before = scan_text[i - 1] if i > 0 else ""
 22349	            after = scan_text[i + len(token)] if i + len(token) < len(scan_text) else ""
 22350	            if not _HOME_MENTION_BOUNDARY.match(before or " ") and not _HOME_MENTION_BOUNDARY.match(after or " "):
 22780	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 22781	    for p in parents:
 22782	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22783	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22784	    order = sorted(paths)
 22785	    specs = []
 22786	    for x in order:
 22787	        specs.append(f"{sha}:{x}")
 22788	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 22789	    blobs = _nodehome_cat_blobs(repo_root, specs)
 22790	    if blobs is None or any(ren is None for _, ren in pairs):
 22791	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 22792	        return paths, src, gone
 22793	    kept = set()
 22794	    for n, x in enumerate(order):
 22795	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 22796	        if _nodehome_merge_wrote_new_lines(merged, olds):
 22797	            kept.add(x)
 22798	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 22799	
 22800	
 22801	def _nodehome_cat_blobs(repo_root, specs):
 22802	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22803	
 22804	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22805	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22806	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 22807	    import subprocess as _sp
 22808	    if not specs:
 22809	        return []
 22810	    if any("\n" in s_ for s_ in specs):
 22811	        return None
 22812	    try:
 22813	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22814	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22815	                    capture_output=True, timeout=60)
 22816	    except (OSError, _sp.TimeoutExpired):
 22817	        return None
 22818	    if r.returncode != 0:
 22819	        return None
 22820	    out, pos, res = r.stdout, 0, []
 22821	    for _ in specs:
 22822	        nl = out.find(b"\n", pos)
 22823	        if nl < 0:
 22824	            return None
 22825	        head = out[pos:nl].split(b" ")
 22826	        pos = nl + 1
 22827	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22828	            size = int(head[2])
 22829	            res.append(out[pos:pos + size])
 22830	            pos += size + 1
 22831	        elif len(head) == 3 and head[2].isdigit():
 22832	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22833	            res.append(None)
 22834	        else:
 22835	            res.append(None)            # missing / ambiguous
 22836	    return res
 22837	
 22838	
 22839	def _nodehome_merge_wrote_new_lines(merged, olds):
 22840	    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。
 22841	
 22842	    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
 22843	    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
 22844	    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
 22845	    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
 22846	    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
 22847	    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
 22848	    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
 22849	    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
 22850	    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
 22851	    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
 22852	    new = _merge_new_lines(merged, olds)
 22853	    return True if new is None else bool(new)
