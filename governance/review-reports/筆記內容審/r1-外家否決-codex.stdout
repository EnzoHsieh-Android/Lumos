 21393	def _lint_new_diff_claims(base_claims, head_claims, base_files, head_files):
 21394	    """比差集:同一個指紋出現幾次。★算次數不算有無★——基準版一次、現在版三次就是新增兩條;
 21395	    用「有沒有出現過」會讓複製貼上多出來的問題被吃掉。
 21396	    回 (新增的告警清單, 有幾條是弱比對)。"""
 21397	    from collections import Counter
 21398	    import hashlib as _hl
 21399	    base_text = {f: (_lint_new_read_lines(p) or []) for f, p in base_files.items()}
 21400	    head_text = {f: (_lint_new_read_lines(p) or []) for f, p in head_files.items()}
 21401	    base_count = Counter()
 21402	    for c in base_claims:
 21403	        k, _weak = _lint_new_key(c, base_text)
 21404	        base_count[k] += 1
 21405	    new, weak = [], 0
 21406	    seen = Counter()
 21407	    for c in head_claims:
 21408	        k, is_weak = _lint_new_key(c, head_text)
 21409	        seen[k] += 1
 21410	        if seen[k] > base_count.get(k, 0):
 21411	            c = dict(c)
 21412	            c["key"] = _hl.sha256(k.encode("utf-8")).hexdigest()[:16]
 21413	            c["weak"] = is_weak
 21414	            new.append(c)
 21415	            if is_weak:
 21416	                weak += 1
 21417	    return (new, weak)
