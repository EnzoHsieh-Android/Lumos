 24053	def _cochange_load_config(repo_root, cfg=None):
 24054	    """讀 .lumos/cochange.json。fail-open(借 impact.json 的 rc 語意+額外一行提示):
 24055	    缺檔/壞 JSON → 預設值 + note;min_support 硬底線 2(設 1 視為 2 + note)。
 28070	    if not v.get("home"):
 28071	        return base
 28072	    return f"{base}·{_LENS_KIND['home']}" if base and v.get("kind") == "incident" else _LENS_KIND["home"]
 28073	
