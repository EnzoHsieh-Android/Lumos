 17237	def _link_or_copy(src: Path, dst: Path):
 17238	    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
 17239	    import os, shutil, subprocess
 17240	    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
 17241	    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
 17242	    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
 17243	    if dst.is_symlink():
 17244	        dst.unlink()                                  # Unix symlink
 17245	    elif dst.is_dir():
 17246	        try:
 17247	            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
 17248	        except OSError:
 17249	            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
 17250	    elif dst.exists():
 17251	        dst.unlink()
 17252	    dst.parent.mkdir(parents=True, exist_ok=True)
 17253	    try:
 17254	        if _IS_WIN:
 17255	            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
 17256	            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
 17257	            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
 17258	                               capture_output=True, text=True, encoding="utf-8", errors="replace")
 17259	            if r.returncode != 0:
 17260	                raise OSError(r.stderr)
 17261	        else:
 17262	            dst.symlink_to(src)
 17263	    except OSError:
 17264	        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8(專案宣告 ≥3.9)
 17265	        try:
 17266	            (dst / _SKILL_MARKER).write_text("lumos fallback copy;安裝器可整夾重建\n", encoding="utf-8")
 17267	        except OSError:
 17268	            pass
 17269	        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")
 17270	
