 20522	def cmd_lint_check(repo=None, smoke=False, as_json=False):
 20523	    """檢查 .lumos/lint.json 宣告健康度(收「宣告了跑不動的東西」破口)。
 20524	    靜態層(恆跑):格式校驗(見 _lintcheck_validate)。--smoke:真跑每條命令、驗有無產出可解析
 20525	    SARIF——抓「格式對但 task 不存在/plugin 沒裝」的空殼(如 KDS detektMain)。
 20526	    rc:0=健康(含無宣告)/1=有問題/2=lint.json 非 JSON。設計 [[Systems/lint-declaration-health]]。"""
 20527	    import json
 20528	    repo_root = _anchor_repo_root(repo)
 20529	    if repo_root is None:
 20530	        # rc2 響亮(r2 d-f2:原 rc0=「有真問題偽裝乾淨」——CI 腳本吃 exit code 會放行)
 20531	        print("✗ lint-check: 從目前目錄往上找不到 git repo——帶 --repo <根> 指定,或到 repo 內執行", file=sys.stderr)
 20532	        return 2
 20533	    lf = _lint_load_and_validate(repo_root)
 20534	    if not lf["declared"]:
 20535	        if as_json:
 20536	            print(json.dumps({"problems": [], "declared": False}, ensure_ascii=False))
 20537	        return 0
 20538	    if lf["parse_error"]:
 20539	        print(f"✗ lint-check: .lumos/lint.json 不是合法 JSON: {lf['parse_error']}", file=sys.stderr)
 20540	        return 2
 20541	    config = lf.get("config")
 20542	    problems = lf["problems"]
 20543	    # --smoke:靜態層無格式問題才冒煙(格式壞的命令沒必要跑)
 20544	    skipped_stacks = []            # 這個棧還沒有檔,冒煙驗不到——不是問題,但要講出來
 20545	    if smoke and not problems and isinstance(config, dict):
 20546	        for stack, cmds in config.items():
 20547	            for cmd in (cmds if isinstance(cmds, list) else []):
 20548	                ready = _lintcheck_smoke_cmd(cmd, stack, repo_root)
 20549	                if ready is None:
 20550	                    # ★沒檔可驗,不是命令壞了★:講實話,不要假警報也不要假裝驗過
 20551	                    skipped_stacks.append(stack)
 20552	                    continue
 20553	                _claims, ok = _lint_run_and_parse(ready, repo_root)
 20554	                if not ok:
 20555	                    problems.append({"stack": stack, "issue": f"冒煙失敗:命令跑不出可解析 SARIF(task 不存在/工具沒裝?)｜{ready[:60]}"})
 20556	    if as_json:
 20557	        print(json.dumps({"problems": problems, "declared": True}, ensure_ascii=False))
 20558	        return 1 if problems else 0
 20559	    if not problems:
 20560	        print(f"✓ lint-check: .lumos/lint.json 宣告健康({'冒煙通過' if smoke else '格式通過,--smoke 可再驗命令'})")
 20561	        if skipped_stacks:
 20562	            print(f"  提醒:這幾個棧的命令沒有真的跑過,因為專案裡還沒有它們的檔:{', '.join(sorted(set(skipped_stacks)))}")
 20563	            print("  為什麼在意:宣告寫對了不等於命令跑得動,寫了第一支檔之後再驗一次才算數:")
 20564	            print("    lumos lint-check --smoke")
 20565	        return 0
 20566	    print(f"✗ lint-check: .lumos/lint.json 有 {len(problems)} 個問題:")
 20567	    for pr in problems:
 20568	        print(f"  [{pr['stack']}] {pr['issue']}")
 20569	    return 1
