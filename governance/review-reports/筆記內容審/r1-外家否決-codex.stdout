 22943	def _nodehome_golive(repo_root, tip, mark=None):
 22944	    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。
 22945	    mark=要找的標記字串,預設是每支檔有家自己的;筆記形狀擋傳它自己的(Projects/筆記形狀擋_計劃 [S4])。"""
 22946	    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{mark or _NODEHOME_GOLIVE_MARK}",
 22947	                        tip or "HEAD", "--", "scripts/hooks/pre-commit")
 22948	    if not raw:
 22949	        return None
 22950	    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
 22951	    return first if _LENS_SHA_RE.match(first) else None
