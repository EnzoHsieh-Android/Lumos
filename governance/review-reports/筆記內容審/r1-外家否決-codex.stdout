 22264	def _nodehome_config(repo_root, text=None, from_snapshot=False):
 22265	    """讀 node_home 設定。回 {mode: on|warn|off, max_files: int, ignore: [str], warnings: [str]};壞值一律退回預設並留一句。
 22266	    from_snapshot=True:text 是被檢查那個版本裡 .lumos/config.json 的內容(None=那個版本沒有這支檔)——
 22267	    ★提交前讀提交索引、推送前讀終點那個提交★,不讀工作目錄(工作目錄裡沒暫存的「關掉」不得關掉提交索引的檢查)。
 22268	    from_snapshot=False:直讀工作目錄(健檢開頭那一行用;同 _stack_questions_config 慣例)。
 22269	    ★鍵叫 mode 不叫 gate★:治理閘名的漂移掃描會把 gate 鍵的字面值當閘名(同 _stack_questions_config)。"""
 22270	    cfg = {"mode": "on", "max_files": _NODEHOME_MAX_FILES_DEFAULT, "ignore": [], "warnings": []}
 22271	    if from_snapshot:
 22272	        if text is None:
 22273	            return cfg
 22274	        raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 22275	    else:
 22276	        p = Path(repo_root) / ".lumos" / "config.json"
 22277	        # 捷徑檔不跟過去讀:跟讀快照那條路一樣(git 裡的捷徑檔讀出來是目標路徑字串,解析失敗退預設)——
 22278	        # 不然設定檔被做成指到本機任意檔的捷徑,健檢每次都會去讀那支檔(代碼審 r1 資安席)。
 22279	        # ★整條路徑都要看★:只看 config.json 本身,.lumos 資料夾是捷徑時照樣讀到外面(代碼審 r2 資安席、邊界席)
 22280	        try:
 22281	            _via_link = p.is_symlink() or (p.exists() and p.resolve() != Path(repo_root).resolve() / ".lumos" / "config.json")
 22282	        except OSError:
 22283	            _via_link = True
 22284	        if _via_link:
 22285	            cfg["warnings"].append(".lumos/config.json(或 .lumos 資料夾)是捷徑檔,不跟過去讀,每支檔有家用預設(會擋、上限 "
 22286	                                   f"{_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)——要設定就放一支一般檔")
 22287	            return cfg
 22288	        if not p.is_file():
 22289	            return cfg
 22290	        try:
 22291	            raw = p.read_text(encoding="utf-8")
 22292	        except Exception as e:
 22293	            cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
 22294	            return cfg
 22295	    try:
 22296	        data = json.loads(raw)
 22297	    except Exception as e:
 22298	        cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
 22299	        return cfg
 22300	    nh = data.get("node_home") if isinstance(data, dict) else None
 22301	    if nh is None:
 22302	        return cfg
 22303	    if not isinstance(nh, dict):
 22304	        cfg["warnings"].append("設定檔的 node_home 不是物件,整段用預設")
 22305	        return cfg
 22306	    g = nh.get("gate", "on")
 22307	    if g not in _NODEHOME_GATE_VALUES:
 22308	        cfg["warnings"].append(f"設定檔的 node_home.gate={g!r} 看不懂(只認 {'/'.join(_NODEHOME_GATE_VALUES)}),已用 on")
 22309	    else:
 22310	        cfg["mode"] = g
 22311	    mf = nh.get("max_files", _NODEHOME_MAX_FILES_DEFAULT)
 22312	    # ★bool 要單獨擋★:Python 的 True 是 int 的子類,不擋的話上限悄悄變成 1(同合約條數門檻那支)
 22313	    if isinstance(mf, bool) or not isinstance(mf, int) or mf < 1:
 22314	        cfg["warnings"].append(f"設定檔的 node_home.max_files={mf!r} 不合法(要 1 以上的整數),已用 {_NODEHOME_MAX_FILES_DEFAULT}")
 22315	    else:
 22316	        cfg["max_files"] = mf
 22317	    ig = nh.get("ignore", [])
 22318	    if not isinstance(ig, list):
 22319	        cfg["warnings"].append("設定檔的 node_home.ignore 要是字串清單,整段略過")
 22320	    else:
 22321	        for i, item in enumerate(ig):
 22322	            if isinstance(item, str) and item.strip():
 22323	                cfg["ignore"].append(item.strip())
 22324	            else:
 22325	                cfg["warnings"].append(f"設定檔的 node_home.ignore 第 {i + 1} 項不是字串({item!r}),略過這一項")
 22326	    return cfg
