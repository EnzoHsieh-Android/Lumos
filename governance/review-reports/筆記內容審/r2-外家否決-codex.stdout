 30359	def _codeloop_record_valid(repo_root, rec_sha, marker_sha):
 30360	    """留痕座標有效性(pass/skip 與表態共用同一套):同 sha;或 rec_sha 是 marker_sha 的祖先且中間只動簿記檔
 30361	    ([[Issues/code-loop-pass自失效追尾]] 的豁免)。回 (ok, 一句為什麼)。"""
 30362	    import subprocess as _sp
 30363	    if not rec_sha:
 30364	        return False, "記錄沒有 sha"
 30365	    if rec_sha == marker_sha:
 30366	        return True, f"同版本 {marker_sha[:8]}"
 30367	    try:
 30368	        anc = _sp.run(["git", "merge-base", "--is-ancestor", rec_sha, marker_sha],
 30369	                      capture_output=True, text=True, errors="replace", cwd=str(repo_root), timeout=_disp_git_timeout())
 30370	        if anc.returncode not in (0, 1):
 30371	            # ★git 回 1 才是「不是祖先」;其他非零是那個提交在這份 repo 裡根本找不到★(代碼審 r1 通才席):
 30372	            # 寫錯的 sha、淺 clone、或物件被清掉。第一版把這種也講成「多半是壓過提交」,給了文不對題的重來指令。
 30373	            return False, (f"記錄 sha {rec_sha[:8]} 在這份 repo 裡找不到(寫錯、淺 clone、或已被清掉),"
 30374	                           "判不了是不是祖先——先確認那個提交還在,不在就照重來的步驟重記")
 30375	        if anc.returncode != 0:
 30376	            # ★講出最常見的原因與怎麼重來★(2026-09-22 rtb-production-agent-demo 回報):
 30377	            # 把本機提交壓成一個、或 rebase 之後,內容可以一模一樣,原本記的那個提交卻不再是祖先。
 30378	            # 只丟兩個 sha 的話,人看不出是自己剛做的壓提交造成的,也不知道要重跑哪兩個指令。
 30379	            return False, (f"記錄 sha {rec_sha[:8]} 不是目標 {marker_sha[:8]} 的祖先——多半是壓過提交或 rebase 改寫過歷史"
 30380	                           "(內容沒變也一樣失效)。重來:表態 `lumos pitfalls --diff <範圍> --dispositions-template --carry`"
 30381	                           " 再 `lumos code-loop dispositions <檔>`;審查留痕重跑 `lumos code-loop pass --note \"…\"`")
 30382	        df = _sp.run(["git", "diff", "--name-only", rec_sha, marker_sha],
 30383	                     capture_output=True, text=True, errors="replace", cwd=str(repo_root), timeout=_disp_git_timeout())
 30384	    except _sp.TimeoutExpired:
 30385	        return False, f"git 超過 {_disp_git_timeout():.0f} 秒沒回(merge-base/diff),判不了有效性"
 30386	    files = [f.strip() for f in df.stdout.splitlines() if f.strip()]
 30387	    if df.returncode == 0 and all(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):
 30388	        return True, f"祖先 {rec_sha[:8]}+簿記豁免(其後 {len(files)} 檔皆簿記)"
 30389	    return False, f"記錄 sha {rec_sha[:8]} 之後動了代碼(非純簿記增量)"
