 13967	def _list_scalar_value(fm, key, line_idx):
 13968	    """清單欄位的單一值寫法(`key: 值`)讀出那一個值(去引號,空的回 "")。
 13969	
 13970	    ★看起來是同一行清單就丟 ValueError★:工具不解析同一行裡的逗號(fm_structure 與
 13971	    parse_frontmatter 都把它當成一個值),照單一值轉會把整串 "[a, b]" 寫成一項。
 13972	    判準看「去引號後的值本身」,不列舉寫法(2026-09-10 代碼審 r2:只比對原始字串時,
 13973	    整串加引號、逗號前後多打空白都繞得過):以 [ 或 { 開頭(單一連結 [[X]] 除外),
 13974	    或一個值裡有兩個以上連結開頭。加了引號的空清單 "[]" 跟讀的一側一樣當成空的。"""
 13975	    m = TOP_KEY_RE.match(fm[line_idx])
 13976	    val = m.group(2).strip() if m else ""
 13977	    sval = strip_quotes(val)
 13978	    t = sval.strip()   # 引號裡面前面多一個空白也要認得(第三輪外家否決席:" [a, b]" 繞過)
 13979	    if t == "[]":
 13980	        return ""
 13981	    # 單一連結要「整個值恰好是一個連結」才豁免(第三輪外家找洞席:[[Systems/A], Systems/B] 開頭像連結就被放行)
 13982	    if (t.startswith(("[", "{")) and not _SINGLE_WIKILINK_RE.fullmatch(t)) or _multi_link_value(t):
 13983	        raise ValueError(f"{key} 寫成同一行的清單({val}),工具不解析這種寫法,"
 13984	                         f"硬加會把整串當成一項寫壞,檔案沒動。這種寫法目前只能手動改成一行一項"
 13985	                         f"({key}: 換行後每項一行「  - 值」),改完再重跑")
 13986	    return t   # 去掉前後空白:引號裡只有空白就是空的(第四輪正確性席:原本會留下一筆空白垃圾項)
