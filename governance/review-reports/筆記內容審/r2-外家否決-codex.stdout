 13989	def _list_key_scalar_to_list(fm, key, line_idx):
 13990	    """清單欄位被寫成單一值(`about_code: src/x.py`)時,改寫成一項的清單再給 append/remove 用。
 13991	
 13992	    ★讀的一側本來就把單一值當成一項的清單★(as_list),只有寫的一側不認得——
 13993	    於是一篇筆記一旦是單一值寫法,append 說它不是清單、set 又不收清單欄位,
 13994	    沒有任何指令改得動(2026-09-10 代碼審 r1)。空值(`key:`)當成空清單;
 13995	    同一行的清單寫法擋下不轉(見 _list_scalar_value)。"""
 13996	    sval = _list_scalar_value(fm, key, line_idx)
 13997	    m = TOP_KEY_RE.match(fm[line_idx])
 13998	    raw = m.group(2).strip() if m else ""
 13999	    fm = list(fm)
 14000	    fm[line_idx] = f"{key}:"
 14001	    if sval:
 14002	        # ★原本那一項原封不動★:有引號就照原樣搬,不去掉再重新加(第三輪外家找洞席:'[[Systems/API "v2"]]'
 14003	        # 被重新加成帶反斜線的雙引號,讀的一側不解反斜線,讀回來就不是原本那篇了)
 14004	        quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
 14005	        fm.insert(line_idx + 1, f"  - {raw if quoted else fmt_list_item(sval)}")
 14006	    return fm
