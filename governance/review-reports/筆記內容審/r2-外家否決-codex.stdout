 30302	def _codeloop_write_dispositions(repo_root, branch, head_sha, ts, dispositions):
 30303	    """再原子寫 marker governance/code-loop/<branch>.dispositions.json(暫存+os.replace,同 _write_lf 慣例;r1 外家 F6)。"""
 30304	    import json
 30305	    d = Path(repo_root) / "governance" / "code-loop"
 30306	    d.mkdir(parents=True, exist_ok=True)
 30307	    p = d / f"{_codeloop_branch_filename(branch)}.dispositions.json"
 30308	    # 暫存名帶 pid+隨機(r1 併發席 f1):_write_lf 的固定 .tmp-wlf 名兩個行程同時寫會互搶,一方 os.replace 找不到檔
 30309	    import tempfile as _tf
 30310	    fd, tmp = _tf.mkstemp(prefix=p.name + ".", suffix=".tmp", dir=str(d))
 30311	    try:
 30312	        with os.fdopen(fd, "wb") as f:
 30313	            f.write((json.dumps({"head_sha": head_sha, "branch": branch, "ts": ts, "dispositions": dispositions},
 30314	                                ensure_ascii=False, indent=2) + "\n").encode("utf-8"))
 30315	        os.replace(tmp, p)
 30316	    finally:
 30317	        try:
 30318	            os.unlink(tmp)
 30319	        except OSError:
 30320	            pass
 30321	    return p
