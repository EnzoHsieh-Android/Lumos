 30196	def _dispositions_validate(d, platforms=None, default_platform=None):
 30197	    """驗表態 JSON 形狀(S4)。回 [錯誤句…],空=合法。"""
 30198	    errs = []
 30199	    if not isinstance(d, dict):
 30200	        return ["表態檔最外層要是物件 {題目id: {...}}"]
 30201	    for qid, ent in d.items():
 30202	        _stk, spec = _stack_spec_by_id(qid)
 30203	        if spec is None:
 30204	            errs.append(f"{qid}:不是題目表裡的 id"); continue
 30205	        if not isinstance(ent, dict):
 30206	            errs.append(f"{qid}:值要是物件"); continue
 30207	        st = ent.get("status")
 30208	        if st not in _DISP_STATUSES:
 30209	            errs.append(f"{qid}:status={st!r} 不合法(只認小寫 satisfied/na/todo/tension)"); continue
 30210	        if not str(ent.get("question") or "").strip():
 30211	            errs.append(f"{qid}:question 空(樣板會帶原文,別刪)")
 30212	        if st == "satisfied":
 30213	            ev = str(ent.get("evidence") or "")
 30214	            if not ev:
 30215	                errs.append(f"{qid}:satisfied 要附 evidence(path:line 或 test:<名>)")
 30216	            elif ev.startswith("test:"):
 30217	                ok, why = _dispositions_split_test(ev, platforms or {}, default_platform)
 30218	                if ok is None:
 30219	                    errs.append(f"{qid}:{why}")
 30220	            else:
 30221	                p, why = _dispositions_split_path_line(ev)
 30222	                if p is None:
 30223	                    errs.append(f"{qid}:evidence {ev!r} 切不開——{why}")
 30224	        if st == "na" and not ent.get("auto") and not _dispositions_reason_ok(ent.get("reason")):
 30225	            errs.append(f"{qid}:na 的 reason 太短(去空白標點後 CJK ≥10 字或總長 ≥25 字)")
 30226	        if st == "todo":
 30227	            if not str(ent.get("issue") or "").startswith("Issues/"):
 30228	                errs.append(f"{qid}:todo 要附 issue(Issues/<名>)")
 30229	            if not _dispositions_reason_ok(ent.get("reason")):
 30230	                errs.append(f"{qid}:todo 的 reason 太短(同 na 門檻)")
 30231	        if st == "tension":
 30232	            errs.extend(f"{qid}:{e}" for e in _dispositions_tension_shape(ent, platforms, default_platform))
 30233	    return errs
 30234	
 30235	
 30236	def _dispositions_tension_shape(ent, platforms=None, default_platform=None, check_evidence=True):
 30237	    """tension 表態的形狀(寫側與讀側共用同一份規則;讀側對治理帳重建來的紀錄不信形狀,所以再驗一次):
 30238	    chosen 小寫二值;existing 1–20 項 path:line、每項 ≤300 字;hazard/suggestion 過 na 門檻且 ≤2000 字;
 30239	    chosen=suggested 要附 evidence(規則同 satisfied:path:line 或 test:)。回 [錯誤句…],空=合法;只驗形狀,存在性由讀側對 git 樹驗。"""
 30240	    errs = []
 30241	    ch = ent.get("chosen")
 30242	    if ch not in _DISP_CHOSEN:
 30243	        errs.append(f"tension 的 chosen={ch!r} 不合法(只認小寫 existing/suggested:這次改動沿用既有寫法還是改用建議)")
 30244	    ex = ent.get("existing")
 30245	    if not isinstance(ex, list) or not ex:
 30246	        errs.append(f"tension 要附 existing(既有寫法的 path:line 清單,1–{_DISP_EXISTING_MAX} 項;空的等於沒指出既有寫法在哪)")
 30247	    else:
 30248	        if len(ex) > _DISP_EXISTING_MAX:
 30249	            errs.append(f"existing 有 {len(ex)} 項,上限 {_DISP_EXISTING_MAX}(推送前每項都要開 git 樹驗)")
 30250	        for i, item in enumerate(ex[:_DISP_EXISTING_MAX], 1):
 30251	            s = str(item)
 30252	            if len(s) > _DISP_ITEM_MAX:
 30253	                errs.append(f"existing 第 {i} 項超過 {_DISP_ITEM_MAX} 字")
 30254	                continue
 30255	            p, why = _dispositions_split_path_line(s)
 30256	            if p is None:
 30257	                errs.append(f"existing 第 {i} 項 {s!r} 切不開——{why}")
 30258	    for fld in ("hazard", "suggestion"):
 30259	        txt = ent.get(fld)
 30260	        if not _dispositions_reason_ok(txt):
 30261	            errs.append(f"tension 的 {fld} 缺或太短(去空白標點後 CJK ≥10 字或總長 ≥25 字)")
 30262	        elif len(str(txt)) > _DISP_TEXT_MAX:
 30263	            errs.append(f"tension 的 {fld} 超過 {_DISP_TEXT_MAX} 字")
 30264	    if ch == "suggested":
 30265	        ev = str(ent.get("evidence") or "")
 30266	        if not ev:
 30267	            errs.append("chosen=suggested 要附 evidence(這次改動裡採新做法的那一行 path:line,或 test:<名>)")
 30268	        elif not check_evidence:
 30269	            pass   # 讀側:evidence 的切分與存在性交給跟 satisfied 同一條 _ev(有平台索引),這裡只驗有沒有附
 30270	        elif ev.startswith("test:"):
 30271	            ok, why = _dispositions_split_test(ev, platforms or {}, default_platform)
 30272	            if ok is None:
 30273	                errs.append(why)
 30274	        else:
 30275	            p, why = _dispositions_split_path_line(ev)
 30276	            if p is None:
 30277	                errs.append(f"evidence {ev!r} 切不開——{why}")
 30278	    return errs
