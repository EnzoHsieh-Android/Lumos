 30125	def _gate_failopen(repo_root, gate, why):
 30126	    """fail-open 放行了——把「放行的事實與原因」落一筆帳(#19 S2)。
 30127	
 30128	    ★世界解就是這樣要求的★:K8s 的准入檢查允許「檢查掛掉就放行」,
 30129	    但那個放行一定會進稽核日誌;OPA 的 decision logs 也是「判斷本身就是要被記錄的事件」。
 30130	    這個 repo 的 fail-open 是刻意設計(不為缺環境 brick 掉推送),
 30131	    ★但代價正是「看不出哪一層沒生效」★——那正是這一批要修的病。
 30132	
 30133	    hard=False:這是放行不是硬擋,但它必須看得見。
 30134	    """
 30135	    _gate_event_or_warn(repo_root, gate, "fail-open", why, hard=False)
