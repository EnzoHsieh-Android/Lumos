 30392	def _disp_git_timeout():
 30393	    """單次 git 子程序上限(秒;r1 併發席 f2:20 秒預算只在每題迴圈頂端查,單次 git 卡住預算攔不住)。
 30394	    超時往上拋 subprocess.TimeoutExpired,由每題的例外接手判「無法驗證」(擋,不放行)。"""
 30395	    try:
 30396	        return max(0.1, float(os.environ.get("LUMOS_DISP_GIT_TIMEOUT", "8")))
 30397	    except ValueError:
 30398	        return 8.0
