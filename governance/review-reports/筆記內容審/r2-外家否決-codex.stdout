 24723	def _stack_changed_ok(cur_file, skip=frozenset()):
 24724	    """這支檔的改動行要不要掃(claims 的代碼形態 regex 與棧別觸發共用,r1 架構對齊席 f2):
 24725	    非代碼副檔名不看;審計證物 governance/review-reports/ 不看(2026-08-05:歸檔的席報告/canary 快照 .patch 裡★故意★埋著
 24726	    資源/併發 bug,當成代碼掃會讓 push 被自己的留痕擋下);簿記檔/簿記目錄不看(2026-08-11:治理帳記的 skip 理由在描述
 24727	    「命中 open(...)」,掃自己的紀錄→再命中→再 skip→再寫一行,自我餵食實測誤觸發 9 次);測試檔不看。
 24728	
 24729	    ★skip★(2026-09-10):在消費專案裡,工具鏈自己安裝進去、而且內容沒被改過的檔不看——
 24730	    init 會把 CLI 與五支 hook 複製進 scripts/,消費專案第一次提交自然把它們一起帶進去,
 24731	    於是整份風險報告裡★沒有一條在專案自己的程式碼裡★,分級卻被撐成 high、推送被擋,
 24732	    要求對一份不是自己寫的程式做代碼審。呼叫端給「要跳過的路徑」集合:只含內容跟安裝時指紋對得上的
 24733	    工具檔(見 _vendored_state);工具鏈本體給空集合(那裡 scripts/lumos 就是產品,跳過等於把閘整個關掉)。"""
 24734	    ext = Path(cur_file).suffix
 24735	    return (ext not in _PITFALL_DIFF_SKIP_EXT
 24736	            and not cur_file.startswith("governance/review-reports/")
 24737	            and cur_file not in _BOOKKEEPING_FILES
 24738	            and not cur_file.startswith(_BOOKKEEPING_DIRS)
 24739	            and not _PITFALL_DIFF_TEST_PAT.search(cur_file)
 24740	            and not (skip and _posix_norm(cur_file) in skip))
