 13788	def _fetch_text(url, cache):
 13789	    """下載文字資源並快取(scripts/vendor/)。離線重複 export 不再抓。
 13790	    用 curl(走系統憑證;macOS python urllib 常無 cert store 致 SSL verify 失敗)。"""
 13791	    import subprocess
 13792	    if cache.exists():
 13793	        return cache.read_text(encoding="utf-8")
 13794	    cache.parent.mkdir(parents=True, exist_ok=True)
 13795	    txt = subprocess.run(["curl", "-fsSL", url], capture_output=True, text=True,
 13796	                         timeout=60, check=True).stdout
 13797	    if not txt:
 13798	        raise RuntimeError("空回應")
 13799	    cache.write_text(txt, encoding="utf-8")
 13800	    return txt
