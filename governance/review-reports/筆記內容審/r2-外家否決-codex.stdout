 21466	def _lint_new_clean_stale(repo_root):
 21467	    """開跑前清掉同前綴、超過一天的殘骸。★強殺(機器休眠判死)時收尾不會執行★,
 21468	    殘骸會留在專案底下那個被忽略的目錄裡;每次名字不同所以不會污染下一次比對,但要有人掃。"""
 21469	    import shutil
 21470	    import time as _time
 21471	    base = Path(repo_root) / ".lumos"
 21472	    if not base.is_dir():
 21473	        return
 21474	    now = _time.time()
 21475	    for d in base.glob("lintbase-*"):
 21476	        try:
 21477	            if d.is_dir() and now - d.stat().st_mtime > _LINT_NEW_STALE_SEC:
 21478	                shutil.rmtree(d, ignore_errors=True)
 21479	        except OSError:
 21480	            continue
 21481	
 21482	
 21483	def _lint_new_oversize(head_files, base_files, cfg):
 21484	    """挑出「太大所以不掃」的檔,並從兩邊的清單裡拿掉。回 [{file,lines,bytes,key,over}…]。
 21485	    ★大檔也要有指紋才放行得掉★:綁路徑不綁內容——那支檔會一直很大,綁內容的話每改一次就要重新登記。
 21486	    ★只看行數會被「整支檔只有一行」的壓縮檔騙過去★,所以兩個門檻都看。"""
 21487	    import hashlib as _hl
 21488	    out = []
 21489	    for f, path in list(head_files.items()):
 21490	        try:
 21491	            raw = Path(path).read_bytes()
 21492	        except OSError:
 21493	            continue
 21494	        n_bytes, n_lines = len(raw), raw.count(b"\n") + 1
 21495	        if n_lines <= cfg["max_file_lines"] and n_bytes <= cfg["max_file_bytes"]:
 21496	            continue
 21497	        key = _hl.sha256(("oversize" + _LINT_NEW_SEP + f).encode("utf-8")).hexdigest()[:16]
 21498	        out.append({"file": f, "lines": n_lines, "bytes": n_bytes, "key": key,
 21499	                    "over": "行數" if n_lines > cfg["max_file_lines"] else "位元組數"})
 21500	        head_files.pop(f, None)
 21501	        base_files.pop(f, None)
 21502	    return out
 21503	
 21504	
 21505	def _lint_new_classify(out, cfg):
 21506	    """把跑完的結果判成擋或不擋(就地改 out)。★兩類失敗分開★:
 21507	    環境不可用(工具沒裝/逾時/拉不到規則/放行檔讀不了)→自動放行並記帳;
 21508	    真的有未放行的新增告警、檔太大沒被檢查、預算不足沒跑到的命令→擋,逃生門是人手動放行寫理由。"""
 21509	    env_undone = [u for u in out["undone"] if u["kind"] == "env"]
 21510	    hard_undone = [u for u in out["undone"] if u["kind"] != "env"]

