 30138	# ── 棧別提問表態閘:表態記錄的寫/讀/驗(Projects/棧別提問表態閘_計劃,2026-09-09)──────────────
 30139	# 白話:diff 命中某棧的「適用題」,推送前每一題要有機器讀得懂的交代——satisfied(附證據)/na(理由)/todo(連 Issue+理由)。
 30140	# 表態是獨立原語(派審查員之前就寫),跟 pass/skip 分開;check 用同一套留痕座標規則解析,錨點一律對被推送 commit 的 git 樹驗。
 30141	_DISP_STATUSES = ("satisfied", "na", "todo", "tension")
 30142	# 第四種表態 tension(張力,2026-09-09 Projects/兩席相反時端出張力_計劃):架構對齊席與棧別檢核題立場相反時,
 30143	# 不挑邊、把兩邊都端上來——既有寫法在哪(existing)、隱患(hazard)、建議(suggestion)、這次選了哪邊(chosen)。
 30144	# 上限是 r1 三席一致抓到的:單題核對沒有中途檢查點,無上限的清單會拖垮推送前 20 秒預算。
 30145	_DISP_CHOSEN = ("existing", "suggested")
 30146	_DISP_EXISTING_MAX = 20     # existing 最多幾項(每項推送前要開 git 樹驗一次)
 30147	_DISP_ITEM_MAX = 300        # existing 單項字數上限
 30148	_DISP_TEXT_MAX = 2000       # hazard / suggestion 字數上限
 30149	_DISP_STRIP_RE = re.compile(r"[\s\W_]")   # 空白+標點(Unicode \w 含 CJK 字,所以 CJK 會留下)
 30150	# CJK 判定沿用檢索那套 _RANK_CJK_RE(單一真相;r3 架構對齊席 A4:檔案裡各寫各的 CJK range 是被抓過的錯)——
 30151	# 只含漢字,假名/諺文走「總長 ≥25」那條。
 30152	_DISP_BUDGET = 20.0   # 秒:表態核對的時間預算(同派工鏡頭 _LENS_SPEC_BUDGET 慣例),超過走 fail-open 進治理帳
