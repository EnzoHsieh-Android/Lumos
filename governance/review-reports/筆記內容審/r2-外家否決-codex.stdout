 14123	def load_raw_for_edit(path: Path):
 14124	    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
 14125	    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
 14126	    raw = path.read_bytes()
 14127	    if raw.startswith(b"\xef\xbb\xbf"):
 14128	        raise ValueError("這個檔開頭帶 BOM 標記,工具不寫這種檔;先把檔案存成不帶 BOM 的 UTF-8")
 14129	    if b"\r\n" in raw:
 14130	        raise ValueError("這個檔的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)。Windows 上常是 git autocrlf 造成的;"
 14131	                         "修法:確認 .gitattributes 有套用(圖譜目錄標 eol=lf)再跑 git add --renormalize .,"
 14132	                         "或單檔跑 dos2unix。工具不會偷偷幫你改行尾。")
 14133	    lines = raw.decode("utf-8").split("\n")
 14134	    if not lines or lines[0].strip() != "---":
 14135	        raise ValueError("這篇筆記開頭沒有欄位區塊(---),沒辦法改欄位")
 14136	    fm_end = None
 14137	    for i in range(1, len(lines)):
 14138	        if lines[i].strip() == "---":
 14139	            fm_end = i
 14140	            break
 14141	    if fm_end is None:
 14142	        raise ValueError("開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),先補上")
 14143	    return lines, 1, fm_end
