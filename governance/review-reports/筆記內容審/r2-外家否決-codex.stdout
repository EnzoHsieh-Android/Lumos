 13841	def fm_structure(fm_lines):
 13842	    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
 13843	    end = 該 key 區塊最後一行的 index(含)。"""
 13844	    out = []
 13845	    i, n = 0, len(fm_lines)
 13846	    while i < n:
 13847	        m = TOP_KEY_RE.match(fm_lines[i])
 13848	        if not m:
 13849	            i += 1
 13850	            continue
 13851	        key, val = m.group(1), m.group(2).strip()
 13852	        start = i
 13853	        if val in ("|", "|-", ">", ">-"):
 13854	            i += 1
 13855	            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
 13856	                i += 1
 13857	            out.append((key, start, i - 1, "block"))
 13858	        elif val == "":
 13859	            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
 13860	            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
 13861	            i += 1
 13862	            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
 13863	                i += 1
 13864	            out.append((key, start, i - 1, "list"))
 13865	        elif val == "[]":
 13866	            # YAML 合法空清單(範本 `aliases: []` 就是這樣寫)。2026-08-23 前被判成 scalar →
 13867	            # 從範本建的節點第一次 append 必敗,全庫 15 篇在此狀態。★只認空的 `[]`★,
 13868	            # 非空 inline list(`[a, b]`)仍當 scalar——那要真的解析逗號與引號,不在本次,
 13869	            # 且 append 遇到它會被擋(不會壞),可接受。
 13870	            out.append((key, start, start, "list"))
 13871	            i += 1
 13872	        else:
 13873	            out.append((key, start, start, "scalar"))
 13874	            i += 1
 13875	    return out
