 30138	# ── 棧別提問表態閘:表態記錄的寫/讀/驗(Projects/棧別提問表態閘_計劃,2026-09-09)──────────────
 30139	# 白話:diff 命中某棧的「適用題」,推送前每一題要有機器讀得懂的交代——satisfied(附證據)/na(理由)/todo(連 Issue+理由)。
 30140	# 表態是獨立原語(派審查員之前就寫),跟 pass/skip 分開;check 用同一套留痕座標規則解析,錨點一律對被推送 commit 的 git 樹驗。
 30141	_DISP_STATUSES = ("satisfied", "na", "todo", "tension")
 30142	# 第四種表態 tension(張力,2026-09-09 Projects/兩席相反時端出張力_計劃):架構對齊席與棧別檢核題立場相反時,
 30143	# 不挑邊、把兩邊都端上來——既有寫法在哪(existing)、隱患(hazard)、建議(suggestion)、這次選了哪邊(chosen)。
 30144	# 上限是 r1 三席一致抓到的:單題核對沒有中途檢查點,無上限的清單會拖垮推送前 20 秒預算。
 30145	_DISP_CHOSEN = ("existing", "suggested")
 30146	_DISP_EXISTING_MAX = 20     # existing 最多幾項(每項推送前要開 git 樹驗一次)
 30147	_DISP_ITEM_MAX = 300        # existing 單項字數上限
 30148	_DISP_TEXT_MAX = 2000       # hazard / suggestion 字數上限
 30149	_DISP_STRIP_RE = re.compile(r"[\s\W_]")   # 空白+標點(Unicode \w 含 CJK 字,所以 CJK 會留下)
 30150	# CJK 判定沿用檢索那套 _RANK_CJK_RE(單一真相;r3 架構對齊席 A4:檔案裡各寫各的 CJK range 是被抓過的錯)——
 30151	# 只含漢字,假名/諺文走「總長 ≥25」那條。
 30152	_DISP_BUDGET = 20.0   # 秒:表態核對的時間預算(同派工鏡頭 _LENS_SPEC_BUDGET 慣例),超過走 fail-open 進治理帳
 30153	
 30154	
 30155	def _dispositions_reason_ok(text):
 30156	    """理由門檻(r2 邊界席 B10):去掉空白與標點後,CJK 字元 ≥10 個,或總字元 ≥25 個;標點不算 CJK,加句號繞不過。"""
 30157	    if not isinstance(text, str):
 30158	        return False
 30159	    core = _DISP_STRIP_RE.sub("", text)
 30160	    return len("".join(_RANK_CJK_RE.findall(core))) >= 10 or len(core) >= 25
 30161	
 30162	
 30163	def _dispositions_split_path_line(ev):
 30164	    """'path:line' → (path, line) 或 (None, 原因)。最後一個冒號之後是行號(純數字或 a-b);反斜線先正規化;絕對路徑與 .. 拒收。"""
 30165	    from pathlib import PurePosixPath
 30166	    s = str(ev).strip().replace("\\", "/")
 30167	    if ":" not in s:
 30168	        return None, "缺行號(格式 path:line)"
 30169	    path, line = s.rsplit(":", 1)
 30170	    if not re.fullmatch(r"\d+(-\d+)?", line):
 30171	        return None, f"行號 {line!r} 不是數字或 a-b"
 30172	    _lo, _hi = (int(x) for x in line.split("-", 1)) if "-" in line else (int(line), int(line))
 30173	    if _lo < 1 or _hi < _lo:
 30174	        return None, f"行號 {line!r} 不合法(要 ≥1,a-b 的 a 不能大於 b)"   # r1 邊界席 f1:10-5 曾讓 IndexError 被吞成 fail-open
 30175	    if not path or path.startswith("/") or PurePosixPath(path).is_absolute() or ".." in PurePosixPath(path).parts:
 30176	        return None, "路徑要是 repo 相對路徑(不收絕對路徑與 ..)"
 30177	    return path, line
 30178	
 30179	
 30180	def _dispositions_split_test(ev, platforms, default_platform):
 30181	    """'test:<名>' / 'test:<平台>:<名>' → (平台, 名) 或 (None, 原因)。規則同 resolve_test_refs(含冒號=平台前綴、裸名歸 default);
 30182	    legacy 單平台卻帶前綴 → 明講「沒開多平台」而不是「找不到」(r2 邊界席 B11)。"""
 30183	    body = str(ev)[len("test:"):]
 30184	    if ":" in body:
 30185	        plat, name = body.split(":", 1)
 30186	        if not platforms:
 30187	            return None, f"這個專案沒開多平台(.lumos/config.json 沒有 platforms),不支援平台前綴 {plat!r}"
 30188	        if plat not in platforms:
 30189	            return None, f"平台 {plat!r} 不在 platforms 裡({', '.join(sorted(platforms))})"
 30190	        return plat, name
 30191	    if not body:
 30192	        return None, "test: 後面要有測試名"
 30193	    return default_platform, body
 30194	
