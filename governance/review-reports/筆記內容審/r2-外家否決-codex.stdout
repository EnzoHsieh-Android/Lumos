 23717	        if lno and _ns_is_code(p, reader, files):
 23718	            out.append(("程式行號引用", f"`{p}:{lno}`",
 23719	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{lno}`"))
 23720	    for name, lno, s in singles:
 23721	        cands = by_name(name)
 23722	        if len(cands) != 1:
 23723	            continue
 23724	        if s is None:
 23725	            out.append(("程式行號引用", f"`{name}:{lno}`(= {cands[0]})",
 23726	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{lno}`"))
 23727	        elif not _ns_pin_ok(repo_root, cands[0], lno, s):
 23728	            out.append(("釘版本不合法", f"`{name}@{s}:{lno}`(= {cands[0]})", fix_pin))
 23729	    if region == "summary":
 23730	        m = SYMBOL_RE.match(text.strip())
 23731	        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
 23732	        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
 23733	        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
 23734	        if m and not skip:
 23735	            for _w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
 23736	                out.append(("現況描述沒寫來源", text.strip()[:60],
 23737	                            "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
 23738	    return out
 23739	
 23740	
 23741	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 23742	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 23743	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 23744	    if ch is None:
 23745	        return []
 23746	    lst_t = _nodehome_list(repo_root, tip_where)
 23747	    lst_b = _nodehome_list(repo_root, base_where)
 23748	    if lst_t is None or lst_b is None:
 23749	        return []
 23750	    reader_b = _nodehome_reader(repo_root, base_where)
 23751	    out = []
 23752	    for code, _old, new in ch:
 23753	        if not new or code == "D":
 23754	            continue
 23755	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 23756	            continue
 23757	        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
 23758	        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
 23759	            out.append(new)
 23760	    return out
 23761	
 23762	
 23763	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
 23764	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 23765	    reader = _nodehome_reader(repo_root, tip_where)
 23766	    lst = _nodehome_list(repo_root, tip_where)
 23767	    if lst is None:
 23768	        return None
 23769	    files = lst[0]
 23770	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 23771	    _names, _name_cache = {}, {}
 23772	    for p in files:
 23773	        if _nodehome_code_kind(p) is not None:
 23774	            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23775	
 23776	    def by_name(name):
 23777	        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
 23778	        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
 23779	        if name not in _name_cache:
 23780	            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
 23781	        return _name_cache[name]
 23782	    viol, errs = [], []
 23783	    # 1) 這次新增的行
 23784	    if staged:
 23785	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23786	        if d is None:
 23787	            return None
 23788	        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
 23789	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23790	        texts_by, old_by = None, {}
 23791	    else:
 23792	        mk = mark or _NOTE_SHAPE_GOLIVE_MARK
 23793	        ra = _ns_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
 23794	                             mark=mk if _nodehome_golive(repo_root, tip_where, mk) else None, max_count=max_count)
 23795	        if ra is None:
 23796	            return None
 23797	        texts_by, paths, old_by = ra
 23798	        cand = {p: None for p in paths}
 23799	    for p, linenos in sorted(cand.items()):
 23800	        b = reader(p)
 23801	        if b is None:
 23802	            continue
 23803	        try:
 23804	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 23805	        except UnicodeDecodeError:
 23806	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 23807	            continue
 23808	        lines = text.split("\n")
 23809	        regs = _ns_regions(text)
 23810	        regen = _ns_is_regen(text)
 23811	        for i, ln in enumerate(lines, 1):
 23812	            if linenos is not None and i not in linenos:
 23813	                continue
 23814	            if texts_by is not None and ln.strip() not in texts_by.get(nfc(p), ()):
 23815	                continue
 23816	            if not ln.strip() or regs[i - 1] == "other":
 23817	                continue
 23818	            for rule, frag, fix in _ns_check_line(repo_root, ln, regs[i - 1], files, reader, top_dirs, by_name, regen):
 23819	                viol.append((p, i, rule, frag, fix))
 23820	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 23821	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 23822	                             tip_where, reader)
 23823	    if became:
 23824	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 23825	        if gl is not None:
 23826	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 23827	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 23828	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 23829	            spec = "" if tip_where == "index" else tip_where
 23830	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 23831	            gl_reader = _nodehome_reader(repo_root, gl)
 23832	            seen = {(v[0], v[1]) for v in viol}
 23833	            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
 23834	            for p, blob in zip(notes_, blobs, strict=False):
 23835	                if blob is None:
 23836	                    continue
 23837	                text = blob.decode("utf-8-sig", errors="replace")
 23838	                if not any(x in text for x in keys):
 23839	                    continue
 23840	                old, regs_, regen_ = None, _ns_regions(text), _ns_is_regen(text)
 23841	                for n, ln in enumerate(text.split("\n"), 1):
 23842	                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
 23843	                        continue
 23844	                    if old is None:
 23845	                        ob = gl_reader(p)
 23846	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 23847	                    if ln.strip() in old or ln.strip() in old_by.get(nfc(p), ()):
 23848	                        continue
 23849	                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
 23850	                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
 23851	                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
 23852	                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
 23853	                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
 23854	                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
 23855	                                                             for x in became):
 23856	                            continue
 23857	                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
 23858	                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
 23859	    return viol, errs
 23860	
 23861	
 23862	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 23863	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 23864	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 23865	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 23866	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 23867	    out = []
 23868	    root = Path(repo_root)
 23869	    cp = root / ".lumos" / "config.json"
 23870	    txt = None
 23871	    try:
 23872	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 23873	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 23874	            txt = cp.read_bytes()
 23875	    except OSError:
 23876	        txt = None
 23877	    mode, _w = _note_shape_config(txt)
 23878	    if mode != "block":
 23879	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 23880	                   "沒寫來源的現況描述不會被擋")
 23881	    wf = root / ".github" / "workflows"
 23882	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 23883	    if ymls:
 23884	        body = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in ymls)
 23885	        step = ("- run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 23886	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
 23887	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before }}..${{ github.sha }}\" "
 23888	                "(checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了讓已在主線上的提交不重查;"
 23889	                "新分支首推前一版全零時改從空樹給,lumos 會自己截到上線點)")
 23890	        if "note-shape --diff" not in body:
 23891	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 23892	        elif "fetch-depth: 0" not in body:
 23893	            out.append("專案 CI 呼叫了 note-shape,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
 23894	    if ci:
 23895	        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
 23896	        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
 23897	        return out
 23898	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 23899	    if gl is None:
 23900	        return out
 23901	    ref = None
 23902	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 23903	    if up is not None and up.returncode == 0 and up.stdout.strip():
 23904	        ref = up.stdout.strip()
 23905	    else:
 23906	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 23907	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 23908	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 23909	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 23910	        ref = cands[0] if cands else None
 23911	    tip = _lens_full_sha(root, ref) if ref else None
 23912	    if tip is None:
 23913	        return out
 23914	    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
 23915	    if a is None or a.returncode != 0:
 23916	        return out
 23917	    try:
 23918	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 23919	    except ValueError:
 23920	        return out
 23921	    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
 23922	    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
 23923	    # 上限用「最新 N 個提交」算,不用 tip~N:沿第一個上一版數的邊界在合併式歷史裡會退到上線點之前、或根本數不到 N 步
 23924	    # 而整個取消(代碼審 r2、r3 通才席);起點固定在上線點
 23925	    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False,
 23926	                           max_count=_NS_DOCTOR_SCAN_CAP if capped else None)
 23927	    if capped:
 23928	        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
 23929	    if res:
 23930	        viol, _errs = res
 23931	        if viol:
 23932	            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
 23933	            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
 23934	            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
 23935	    return out
 23936	
 23937	
 23938	def cmd_note_shape(repo=None, staged=False, diff_range=None):
 23939	    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
 23940	    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
 23941	    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
 23942	    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
 23943	    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
 23944	    root = Path(repo).resolve() if repo else None
 23945	    if root is None:
 23946	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 23947	        if r is None or r.returncode != 0:
 23948	            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23949	            return 0
 23950	        root = Path(r.stdout.strip())
 23951	    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
 23952	    if r is None or r.returncode != 0:
 23953	        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23954	        return 0
 23955	    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE"):
 23956	        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
 23957	        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
 23958	        return 0
 23959	    if staged:
 23960	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 23961	        if mh is not None and mh.returncode == 0:
 23962	            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
 23963	            return 0
 23964	        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
 23965	    else:
 23966	        rg = _lens_range_ok(diff_range)
 23967	        if rg is None:
 23968	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 23969	            return 2
 23970	        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 23971	        if sh is not None and sh.stdout.strip() == "true":
 23972	            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
 23973	                  file=sys.stderr)
 23974	            _gate_event_or_warn(root, "note-shape", "skipped-env", "shallow clone")
 23975	            return 0
 23976	        a, b = rg
 23977	        tip = _lens_full_sha(root, b)
 23978	        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
 23979	        if tip is None or base is None:
 23980	            print(f"筆記形狀擋:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
 23981	            return 0
 23982	        base = _nodehome_clamp_base(root, base, tip, _NOTE_SHAPE_GOLIVE_MARK)
 23983	        base_where = None if base == _EMPTY_TREE_SHA else base
 23984	        tip_where, mode_word = tip, "這次推送"
 23985	    lst = _nodehome_list(root, tip_where)
 23986	    if lst is None:
 23987	        print("筆記形狀擋:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23988	        return 0
 23989	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 23990	    if not vaults:
 23991	        print("筆記形狀擋:這個專案沒有圖譜,跳過")
 23992	        return 0
 23993	    wv = _vault_in(root)
 23994	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23995	    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 23996	    mode, warns = _note_shape_config(_nodehome_reader(root, tip_where)(".lumos/config.json"))
 23997	    for w in warns:
 23998	        print(f"提醒:{w}", file=sys.stderr)
 23999	    if mode == "off":
 24000	        print("筆記形狀擋:這個專案把這道檢查關掉了(note_shape.gate=off),跳過", file=sys.stderr)
 24001	        return 0
 24002	    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel)
 24003	    if res is None:
 24004	        print("筆記形狀擋:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
 24005	        return 0
 24006	    viol, errs = res
 24007	    if not viol and not errs:
 24008	        return 0
 24009	    head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
 24010	    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
 24011	    for e in errs:
 24012	        print(f"  {e}", file=sys.stderr)
 24013	    for p, n, rule, frag, fix in viol:
 24014	        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
 24015	    if mode == "block":
