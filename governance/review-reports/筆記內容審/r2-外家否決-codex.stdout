 29868	def _bound_tests_check(repo_root, diff_range, skip=False, skip_note="", payload=None, advisory=False):
 29869	    """回 dict{status, ran, red:[…], secs, calc_secs, reason, advisory}。
 29870	
 29871	    status ∈ green / red / unfilterable / skipped / no-config / no-vault / no-pins /
 29872	             no-bound / diff-unavailable / range-unavailable / whole-suite-deferred。
 29873	    unfilterable=「指令回成功,但證不出真的跑過測試」(消費專案接入靜默失效 [F]/[S7]);
 29874	    不擋的路徑上它只印訊息,擋的路徑上它跟紅一樣擋。
 29875	
 29876	    advisory=True(低風險推送):紅了照樣印、照樣記帳,但呼叫端不擋(人裁 2026-09-07)。
 29877	      不選「低風險也擋」的理由:擋下去最可能的結果不是人去修測試,是人改走 --no-verify
 29878	      ——而推送關卡自己在別的地方就把那條當第三選項在教,那條零留痕。
 29879	    payload:已經算好的波及結果(推送關卡一次推送只算一次)。
 29880	    """
 29881	    import os as _os, time as _time
 29882	    if skip or _os.environ.get("LUMOS_SKIP_BOUND_TESTS") == "1":
 29883	        note = skip_note or ("env LUMOS_SKIP_BOUND_TESTS=1" if not skip else "")
 29884	        # ★旗標跳過與環境變數跳過要分開記★(設計 [S6]):前者是人當下決定並留了理由,
 29885	        # 後者多半是 CI 常態設定——混在同一個類別裡,回頭條件分不出哪一種在發生。
 29886	        kind = "skipped-env" if (not skip and _os.environ.get("LUMOS_SKIP_BOUND_TESTS") == "1") else "skipped-flag"
 29887	        _bound_tests_log(repo_root, kind, [], note)
 29888	        return {"status": "skipped", "ran": 0, "red": [], "secs": 0.0, "calc_secs": 0.0,
 29889	                "reason": note, "advisory": advisory}
 29890	    _t0 = _time.time()
 29891	    _rng, _rng_note = _bound_tests_range(repo_root, diff_range)
 29892	    if _rng is None:
 29893	        _bound_tests_log(repo_root, "range-unavailable", [], _rng_note)
 29894	        return {"status": "range-unavailable", "ran": 0, "red": [], "secs": 0.0,
 29895	                "calc_secs": round(_time.time() - _t0, 2), "reason": _rng_note, "advisory": advisory}
 29896	    # ★範圍換過了,那份算好的結果就不能用★(代碼審 r1 外家否決席判 major,查證屬實):
 29897	    # pre-push 給的 payload 是拿「空樹..HEAD」算的(整個 repo 都是 diff),
 29898	    # 而上面剛把範圍換成「跟主線的共同祖先..HEAD」。這時候若照樣吃那份 payload,
 29899	    # 固定席會是全庫合約——★正是設計明令要避免的「首推跑滿全部」那條稅★,
 29900	    # 而且範圍字串跟實際用的資料對不上,帳上會說謊。
 29901	    if payload is not None and _rng != str(diff_range or ""):
 29902	        payload = None
 29903	    items, why = _bound_tests_for_diff(repo_root, _rng, payload=payload)
 29904	    _calc = round(_time.time() - _t0, 2)
 29905	    if why:
 29906	        kind = why.split(":", 1)[0]
 29907	        # ★diff-unavailable 這個類別已經沒有來源了★:唯一會走到它的是空樹起點,
 29908	        # 而那條現在改成先換主線 tip、換不到才記 range-unavailable(設計 [S3])。
 29909	        # 留著對照組不動,免得舊帳的類別名突然消失。
 29910	        _bound_tests_log(repo_root, kind, [], why if ":" in why else _rng)
 29911	        return {"status": kind, "ran": 0, "red": [], "secs": 0.0, "calc_secs": _calc,
 29912	                "reason": why, "advisory": advisory}
 29913	    # ★不可過濾的測試指令 + 低風險 → 不跑,誠實記★(設計 [S4])。
 29914	    # 沒有 {method} 佔位符就只能整套跑,逾時上限 600 秒。低風險推送不值得付這個。
 29915	    # ★不要假裝這種情況也守住了★——所以記一個自己的類別,不混進 green。
 29916	    # ★逐平台判,不是整批判★(代碼審 r1 外家否決席判 major,查證屬實):
 29917	    # 舊寫法是「只要有一個平台可以過濾,就整批照跑」——結果那些★不可過濾★的平台
 29918	    # 照樣被 _run_bound_tests 跑整套(單套逾時 600 秒),低風險推送當場卡住。
 29919	    # 正確的隔離是:可過濾的照跑,不可過濾的那幾支個別 deferred。
 29920	    if advisory:
 29921	        _keep, _defer = _bound_tests_split_by_filterable(repo_root, items)
 29922	        if _defer:
 29923	            _bound_tests_log(repo_root, "whole-suite-deferred", sorted({i[0] for i in _defer}),
 29924	                             "測試指令不可過濾(沒有 {method}),低風險這次不跑這幾支")
 29925	        if not _keep:
 29926	            return {"status": "whole-suite-deferred", "ran": 0, "red": [], "secs": 0.0,
 29927	                    "calc_secs": _calc, "advisory": advisory,
 29928	                    "reason": "你的測試指令不能只跑一支,所以這次跳過;把指令改成可過濾的(帶 {method}),這道閘才會每次推送都保護你"}
 29929	        items = _keep
 29930	    results, err = _run_bound_tests(repo_root, items)
 29931	    if results is None:
 29932	        _bound_tests_log(repo_root, "no-config", sorted({i[0] for i in items}), err)
 29933	        return {"status": "no-config", "ran": 0, "red": [], "secs": 0.0, "calc_secs": _calc,
 29934	                "reason": err, "advisory": advisory}
 29935	    red = [(n, p, m, d) for n, p, m, v, d, _ in results if v == "red"]
 29936	    unproven = [(n, p, m, d) for n, p, m, v, d, _ in results if v == "unproven"]
 29937	    _nocmd = [(n, p, m) for n, p, m, v, d, _ in results if v == "no-cmd"]
 29938	    _not_run = [f"{n} [{p}:{m}]" for n, p, m in _nocmd]
 29939	    _nc_note = _nr_reason = ""
 29940	    if _nocmd:
 29941	        try:
 29942	            _mp = load_platforms(repo_root).get("multiplatform")
 29943	        except Exception:
 29944	            _mp = True
 29945	        # ★原因另存一欄★(代碼審 r3 通才 F1):人讀輸出原本從 reason 用「——」切出這段,
 29946	        # 但紅燈時 reason 前段是失敗測試輸出的尾巴,那裡也可能有「——」,就切錯段
 29947	        _nr_reason = _no_run_cmd_reason(repo_root, _mp, {p for _n, p, _m in _nocmd})
 29948	        _nc_note = f";另有 {len(_nocmd)} 支沒跑——" + _nr_reason
 29949	    secs = round(sum(r[5] for r in results), 1)
 29950	    ran = sum(1 for r in results if r[3] == "green")
 29951	    if red:
 29952	        # ★advisory 與擋要分帳★(設計 [S6]):兩者的後果完全不同,混成一個 kind
 29953	        # 就回答不了「只提醒到底夠不夠」——而那正是人裁時掛的回頭條件要問的事。
 29954	        kind = "red-advisory" if advisory else "red-blocked"
 29955	        _bound_tests_log(repo_root, kind, sorted({r[0] for r in red}),
 29956	                         f"{len(red)} 紅/{len(results)}", secs=secs, calc_secs=_calc)
 29957	        return {"status": "red", "ran": ran, "red": red, "secs": secs, "calc_secs": _calc,
 29958	                "advisory": advisory, "not_run": _not_run, "not_run_reason": _nr_reason,
 29959	                "reason": "受波及合約的測試沒過:" + ";".join(f"{n} [{m}] {d}" for n, p, m, d in red[:6]) + _nc_note}
 29960	    # ★報綠之前先確認那個綠是真的★(消費專案接入靜默失效 [F]/[S7])。
 29961	    # 兩層證據,先強後弱:
 29962	    #   ① 逐支看「跑過的證據」——_run_bound_tests 已經對有實測輸出樣式的 profile 驗過,
 29963	    #      驗不過的那幾支在上面被標成 unproven。這一層抓得到「合約 [test:] 名字打錯一個字」。
 29964	    #   ② 沒有輸出樣式可比對的 profile,退回過濾能力冒煙測試(拿不存在的測試名跑一次)。
 29965	    #      這層只答得出「這個指令認不認得出完全不存在的名字」,精準度證不了。
 29966	    _bad = ["這一支跑完回成功,但它自己的輸出裡看不到有跑過任何測試(%s [%s])。%s"
 29967	            % (n, m, d or "") for n, p, m, d in unproven[:3]]
 29968	    try:
 29969	        _pd = load_platforms(repo_root)
 29970	        _pairs = set()
 29971	        for _n, _plat, _m, _v, _d, _sc in results:
 29972	            if _v != "green":
 29973	                continue
 29974	            _pe = (_pd["platforms"].get(_plat) or {})
 29975	            if _RAN_EVIDENCE.get(_pe.get("profile_name") or ""):
 29976	                continue   # 這個 profile 走上面那層,不必再付一次冒煙測試的時間
 29977	            _rc_cmd = _pe.get("run_cmd")
 29978	            if _rc_cmd:
 29979	                _pairs.add((str(_pe.get("root") or repo_root), _rc_cmd))
 29980	        for _root, _cmd in sorted(_pairs):
 29981	            _ok, _why = _bound_tests_filter_probe(_root, _cmd)
 29982	            if not _ok:
 29983	                _bad.append(_why)
 29984	    except Exception as _e:   # 冒煙測試自己壞掉不能反過來擋人:記帳、照原判定走
 29985	        _gate_failopen(repo_root, "bound-tests", f"過濾能力冒煙測試例外:{str(_e)[:100]}")
 29986	    if _bad:
 29987	        _bound_tests_log(repo_root, "unfilterable", sorted({r[0] for r in results}),
 29988	                         "證不出測試真的跑過,綠不可信", secs=secs, calc_secs=_calc)
 29989	        return {"status": "unfilterable", "ran": 0, "red": [], "secs": secs, "calc_secs": _calc,
 29990	                "advisory": advisory, "not_run": _not_run, "not_run_reason": _nr_reason,
 29991	                "reason": "無法確認測試真的跑過:" + _bad[0] + _nc_note}
 29992	    # ★耗時存成獨立欄位★(設計 [S6]):以前塞在自由文字的備註裡(「46 綠 41.8s」),
 29993	    # 回頭條件量不到;而且那個秒數只算跑測試那段,不含前面算波及的時間。分開存。
 29994	    _bound_tests_log(repo_root, "green", sorted({r[0] for r in results}),
 29995	                     f"{ran} 綠", secs=secs, calc_secs=_calc)
 29996	    return {"status": "green", "ran": ran, "red": [], "secs": secs, "calc_secs": _calc,
 29997	            "advisory": advisory, "not_run": _not_run, "not_run_reason": _nr_reason,
 29998	            "reason": f"受波及合約測試 {ran} 支全綠(跑 {secs}s、算 {_calc}s)" + _nc_note}
