 13782	}
 13783	_FONT_LINKS = ('<link rel="preconnect" href="https://fonts.googleapis.com">\n'
 13784	               '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n'
 13785	               '<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">')
