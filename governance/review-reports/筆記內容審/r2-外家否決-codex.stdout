 30001	def _bound_tests_split_by_filterable(repo_root, items):
 30002	    """把這批要跑的測試按「那個平台的指令能不能只跑一支」拆成兩堆:(照跑的, 這次不跑的)。
 30003	
 30004	    ★逐平台判★(2026-09-07 代碼審 r1 外家否決席):第一版是整批判——只要有一個平台
 30005	    可以過濾就整批照跑,於是不可過濾的那幾個平台照樣被跑整套(單套逾時 600 秒)。
 30006	    低風險推送不值得付那個,但也不該因為某個平台不可過濾就把可以跑的那幾支一起放掉。
 30007	
 30008	    ★回不出設定就當「可過濾」★(保守:寧可跑,不要假裝守住了)——
 30009	    真的跑不動時 _run_bound_tests 自己會記 no-config。
 30010	    非 real 的項目(懸空 / 偽證據 / 名字不合法)一律留著:它們不用真跑就能判紅,
 30011	    而那正是這道閘最該講出來的東西。
 30012	    """
 30013	    try:
 30014	        plats = load_platforms(repo_root)["platforms"]
 30015	    except Exception:
 30016	        return list(items), []
 30017	    keep, defer = [], []
 30018	    for it in items:
 30019	        _n, plat, _m, st = it
 30020	        if st != "real":
 30021	            keep.append(it)
 30022	            continue
 30023	        cmd = (plats.get(plat) or {}).get("run_cmd") or ""
 30024	        (keep if ("{method}" in cmd or not cmd) else defer).append(it)
 30025	    return keep, defer
 30026	
 30027	_BOUND_ZERO_REASONS = {
 30028	    # ★三種零覆蓋分開講★(消費專案接入靜默失效 r1 接手席 f4:原本 vault 找不到也回 no-pins,
 30029	    # 跑錯目錄的人會以為圖譜正常只是沒覆蓋到)。值是給人看的一句話,不是代號。
 30030	    "no-vault": "這個目錄裡找不到知識庫(是不是跑錯資料夾,或這個專案還沒 lumos init?)",
 30031	    "no-pins": "這次改到的檔沒有任何節點引用(圖譜對這批改動沒有覆蓋;波及計算認的是筆記正文裡用反引號寫的路徑)",
 30032	    "no-bound": "有節點引用這些檔,但那些節點的合約沒有綁測試(綁法看 lumos guard scaffold)",
 30033	    "diff-unavailable": "算不出這個範圍改了哪些檔(範圍寫錯,還是這個 repo 沒有那些 commit?)",
 30034	}
