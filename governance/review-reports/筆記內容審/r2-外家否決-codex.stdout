 24766	def _vault_slug_of(path):
 24767	    """git 路徑字串(不是檔案系統路徑)落在 docs/<名>-knowledge/ 底下就回 <名>-knowledge,否則 None。
 24768	    三個讀者共用(推送前家的檢查、刪除守衛、推送測試範圍);2026-09-18 代碼審 code-文件子集收緊 r2 架構席:原本兩處各寫一次、第三處又換正則。"""
 24769	    if path.startswith("docs/") and path.count("/") >= 2:
 24770	        slug = path.split("/", 2)[1]
 24771	        if slug.endswith("-knowledge"):
 24772	            return slug
 24773	    return None
 24774	
