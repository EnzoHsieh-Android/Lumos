 30324	def _codeloop_read_dispositions(repo_root, branch, marker_only=False):
 30325	    """本機 marker 優先;沒有(或壞掉,r1 併發席 f4)就退治理帳「該分支最後一筆 kind=dispositions」(檔案行序的最後一筆,不是 ts;r2 外家 F8)。
 30326	    ★跟 pass/skip 分開重建★(r2 外家 F1/邊界席 B9):兩種 kind 互不擠掉。
 30327	    marker_only:只讀本機 marker 不掃治理帳——派工鏡頭用(r1 併發席 f6:每次派工掃 4.6 MB 帳只為算快取 key,不值)。"""
 30328	    import json
 30329	    p = Path(repo_root) / "governance" / "code-loop" / f"{_codeloop_branch_filename(branch)}.dispositions.json"
 30330	    if p.exists():
 30331	        try:
 30332	            return json.loads(p.read_text(encoding="utf-8"))
 30333	        except Exception:
 30334	            pass   # 壞掉的 marker 跟「從沒表態」不同:退治理帳找
 30335	    if marker_only:
 30336	        return None
 30337	    path = Path(repo_root) / "docs" / ".governance-log.jsonl"
 30338	    if not path.exists():
 30339	        return None
 30340	    last = None
 30341	    try:
 30342	        for line in path.read_text(encoding="utf-8").splitlines():
 30343	            if '"dispositions"' not in line:
 30344	                continue
 30345	            try:
 30346	                ev = json.loads(line)
 30347	            except Exception:
 30348	                continue
 30349	            if ev.get("gate") == "code-loop" and ev.get("kind") == "dispositions" and ev.get("branch") == branch and ev.get("head_sha"):
 30350	                last = ev
 30351	    except OSError:
 30352	        return None
 30353	    if last is None:
 30354	        return None
 30355	    return {"head_sha": last["head_sha"], "branch": branch, "ts": last.get("ts"),
 30356	            "dispositions": last.get("dispositions") or {}, "_source": "ledger"}
