 29358	def _codeloop_read_from_ledger(repo_root, branch):
 29359	    """marker 檔不在時(governance/code-loop/ 被 gitignore,CI 的乾淨 checkout 一定沒有)
 29360	    退而讀 tracked 的 docs/.governance-log.jsonl:取該分支最後一筆 gate=code-loop 事件,
 29361	    還原成 marker 同形 dict(status/head_sha/note)。沒有就回 None。
 29362	    2026-08-22 實紅:CI 後盾 #5 上線後第一筆 tier=high 推送因 marker 不在 checkout 而假紅。"""
 29363	    import json
 29364	    path = Path(repo_root) / "docs" / ".governance-log.jsonl"
 29365	    if not path.exists():
 29366	        return None
 29367	    last = None
 29368	    try:
 29369	        for line in path.read_text(encoding="utf-8").splitlines():
 29370	            line = line.strip()
 29371	            if not line or '"code-loop"' not in line:
 29372	                continue
 29373	            # ★只有 pass/skip 才是留痕★(2026-09-08 #19 代碼審 r1 之後補的防禦):
 29374	            # 同一個 gate 底下現在還有 blocked / skipped-env / fail-open 這些事件,
 29375	            # 它們絕不能被當成「審過了」的憑證。上面撤掉 branch 別名已經擋住一次,
 29376	            # 這裡是第二道——★別讓「哪些 kind 算留痕」這件事只靠欄位有沒有寫★。
 29377	            if ('"passed"' not in line) and ('"skipped"' not in line):
 29378	                continue
 29379	            try:
 29380	                ev = json.loads(line)
 29381	            except Exception:
 29382	                continue
 29383	            # ★kind 也要對★(表態閘 2026-09-09):dispositions 事件的內容可能含 "passed" 字樣,子字串預篩擋不住;
 29384	            # 兩種 kind 各自重建(_codeloop_read_dispositions 讀另一種),互不擠掉。
 29385	            if ev.get("kind") not in ("passed", "skipped"):
 29386	                continue
 29387	            if ev.get("gate") == "code-loop" and ev.get("branch") == branch and ev.get("head_sha"):
 29388	                last = ev
 29389	    except OSError:
 29390	        return None
 29391	    if last is None:
 29392	        return None
 29393	    return {"status": last.get("kind"), "head_sha": last.get("head_sha"),
 29394	            "note": last.get("detail"), "ts": last.get("ts"), "_source": "ledger"}
