 30407	def _git_tree_text(repo_root, at_sha, path):
 30408	    import subprocess as _sp
 30409	    r = _sp.run(["git", "show", f"{at_sha}:{path}"], capture_output=True, text=True, cwd=str(repo_root), errors="ignore", timeout=_disp_git_timeout())
 30410	    return r.stdout if r.returncode == 0 else None

