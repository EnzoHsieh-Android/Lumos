 13878	# 標準 YAML(1.1/1.2,Obsidian 用的 js-yaml)不加引號會讀成數字、日期、無限大的寫法——這些要加引號才是字串
 13879	# (2026-09-26 代碼審 r2 通才席:原本只認十進位整數與小數)。日期欄位(DATE_KEYS)刻意不加引號,走另一條路,不經這裡。
 13880	_YAML_TYPED_RE = re.compile(
 13881	    r"[-+]?(\d[\d_]*(\.[\d_]*)?|\.\d[\d_]*)([eE][-+]?\d+)?"       # 十進位、小數、科學記號
 13882	    r"|[-+]?0[xX][0-9a-fA-F_]+|[-+]?0[oO]?[0-7_]+|[-+]?0[bB][01_]+"  # 十六、八、二進位
 13883	    r"|[-+]?\d[\d_]*(:[0-5]?\d)+(\.[\d_]*)?"                        # 六十進位(1:20:30)
 13884	    r"|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN)"                          # 無限大、非數
 13885	    r"|\d{4}-\d\d?-\d\d?([Tt ].*)?")                                  # 日期、日期時間
 13886	_YAML_PLAIN_BAD_START = set("-?:,[]{}#&*!|>'\"%@`")
 13887	
 13888	
 13889	def _yaml_plain_ok(v):
 13890	    """★白名單★:這個值不加引號時,本工具的簡易讀法與標準 YAML(Obsidian 等)讀出來一模一樣嗎。
 13891	    只放行確定沒事的;拿不準的一律加引號(2026-09-26 代碼審 r1:原本只列「要加引號的」,
 13892	    漏了「空白 + #」被標準 YAML 當註解切掉、「- 」開頭被當清單)。"""
 13893	    return (v != "" and v == v.strip() and "\n" not in v and "\t" not in v
 13894	            and v[0] not in _YAML_PLAIN_BAD_START and ": " not in v and " #" not in v and not v.endswith(":")
 13895	            and v.lower() not in ("true", "false", "null", "yes", "no", "on", "off", "~")
 13896	            and not _YAML_TYPED_RE.fullmatch(v))
 13897	
 13898	
 13899	def _yaml_quote(v, what):
 13900	    """加引號,只用兩邊讀法一致的寫法:本工具讀的一側只剝掉頭尾一層引號、不解任何跳脫。
 13901	    雙引號在標準 YAML 裡會解反斜線跳脫 → 只在沒有反斜線、沒有雙引號時用;
 13902	    否則單引號(標準 YAML 裡除了 '' 以外一律照字面)→ 只在沒有單引號時用;兩種都不行就擋。"""
 13903	    if '"' not in v and "\\" not in v:
 13904	        return '"' + v + '"'
 13905	    if "'" not in v:
 13906	        return "'" + v + "'"
 13907	    raise ValueError(f"{what}「{v}」同時有單引號、又有雙引號或反斜線,工具寫不出本工具和 Obsidian 都讀得一樣的寫法,"
 13908	                     "檔案沒動;把其中一種引號換掉再寫")
 13909	
 13910	
 13911	def fmt_scalar(key, value):
 13912	    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
 13913	    v = value.strip()
 13914	    if key in DATE_KEYS:
 13915	        if not DATE_RE.match(v):
 13916	            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
 13917	        return v  # bare,絕不加引號
 13918	    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
 13919	    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
 13920	    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)
 13921	
 13922	
 13923	def fmt_list_item(value):
 13924	    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
 13925	    v = value.strip()
 13926	    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")
