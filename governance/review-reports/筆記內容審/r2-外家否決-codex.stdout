 23862	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 23863	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 23864	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 23865	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 23866	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 23867	    out = []
 23868	    root = Path(repo_root)
 23869	    cp = root / ".lumos" / "config.json"
 23870	    txt = None
 23871	    try:
 23872	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 23873	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 23874	            txt = cp.read_bytes()
 23875	    except OSError:
 23876	        txt = None
 23877	    mode, _w = _note_shape_config(txt)
 23878	    if mode != "block":
 23879	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 23880	                   "沒寫來源的現況描述不會被擋")
 23881	    wf = root / ".github" / "workflows"
 23882	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 23883	    if ymls:
 23884	        body = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in ymls)
 23885	        step = ("- run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 23886	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
 23887	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before }}..${{ github.sha }}\" "
 23888	                "(checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了讓已在主線上的提交不重查;"
 23889	                "新分支首推前一版全零時改從空樹給,lumos 會自己截到上線點)")
 23890	        if "note-shape --diff" not in body:
 23891	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 23892	        elif "fetch-depth: 0" not in body:
 23893	            out.append("專案 CI 呼叫了 note-shape,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
 23894	    if ci:
 23895	        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
 23896	        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
 23897	        return out
 23898	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 23899	    if gl is None:
 23900	        return out
 23901	    ref = None
 23902	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 23903	    if up is not None and up.returncode == 0 and up.stdout.strip():
 23904	        ref = up.stdout.strip()
 23905	    else:
 23906	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 23907	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 23908	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 23909	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 23910	        ref = cands[0] if cands else None
 23911	    tip = _lens_full_sha(root, ref) if ref else None
 23912	    if tip is None:
 23913	        return out
 23914	    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
 23915	    if a is None or a.returncode != 0:
 23916	        return out
 23917	    try:
 23918	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 23919	    except ValueError:
 23920	        return out
 23921	    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
 23922	    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
 23923	    # 上限用「最新 N 個提交」算,不用 tip~N:沿第一個上一版數的邊界在合併式歷史裡會退到上線點之前、或根本數不到 N 步
 23924	    # 而整個取消(代碼審 r2、r3 通才席);起點固定在上線點
 23925	    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False,
 23926	                           max_count=_NS_DOCTOR_SCAN_CAP if capped else None)
 23927	    if capped:
 23928	        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
 23929	    if res:
 23930	        viol, _errs = res
 23931	        if viol:
 23932	            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
 23933	            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
 23934	            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
 23935	    return out
