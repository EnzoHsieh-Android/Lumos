 13949	def edit_fm_sync_status_tag(fm_lines, status):
 13950	    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
 13951	    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
 13952	    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
 13953	    fm = list(fm_lines)
 13954	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 13955	    if "tags" not in struct or struct["tags"][2] != "list":
 13956	        return fm, False
 13957	    s, e, _kind = struct["tags"]
 13958	    found = False
 13959	    for i in range(s + 1, e + 1):
 13960	        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
 13961	        if m:
 13962	            fm[i] = f"{m.group(1)}status/{status}"
 13963	            found = True
 13964	    return fm, found
