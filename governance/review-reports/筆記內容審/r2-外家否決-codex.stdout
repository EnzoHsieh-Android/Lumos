 20358	def _diff_added_lines(diff_text):
 20359	    """從 git diff -U3 輸出建 {file: set(new_line_numbers)} 對應所有新增行(+ 開頭)。
 20360	    使用與 _pitfall_diff_mode 相同的 @@ 標頭推導邏輯。"""
 20361	    added = {}
 20362	    cur_file, new_ln = "", 0
 20363	    for line in diff_text.splitlines():
 20364	        if line.startswith("+++ b/"):
 20365	            cur_file = line[6:]
 20366	            continue
 20367	        m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
 20368	        if m:
 20369	            new_ln = int(m.group(1))
 20370	            continue
 20371	        if line.startswith("+++") or line.startswith("---"):
 20372	            continue
 20373	        if line.startswith("-"):
 20374	            continue                          # 刪除行不推進新檔行號
 20375	        if not line.startswith("+"):
 20376	            new_ln += 1                       # context 行推進
 20377	            continue
 20378	        # 這是新增行(+ 開頭)
 20379	        if cur_file:
 20380	            added.setdefault(cur_file, set()).add(new_ln)
 20381	        new_ln += 1                           # 新增行推進新檔行號
 20382	    return added
 20383	
