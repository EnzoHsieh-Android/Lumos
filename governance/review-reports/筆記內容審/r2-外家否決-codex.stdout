 30942	def cmd_code_loop(subcmd, note=None, repo=None, as_json=False, diff_range=None, at_sha=None, marker_branch=None, skip_bound=False, from_json=None, disp_file=None, qid=None, bound_advisory=False):
 30943	    """code-loop 留痕讀寫。
 30944	    pass  → status=passed(綁 HEAD sha);
 30945	    skip  → status=skipped(綁 HEAD sha,留逃生痕);
