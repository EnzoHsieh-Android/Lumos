 24821	    會從它眼皮下溜過,所以 light 不准帶著這種檔一起少跑全套;代碼審 r1 資安席)。
 24822	    自己用 git 算檔清單(不用 pitfalls 的 files:那份已經把 .json/.jsonl 按副檔名擋掉);--no-renames:從 scripts/ 搬進 docs/ 的檔會拆成
 24823	    「刪程式檔+加文件」,刪的那支讓它跑全套。簿記帳與卷證不算;算不出範圍 → full(fail-safe 是多跑,不是少跑)。"""
 24824	    base = _range_base(repo_root, diff_range)
 24825	    full = {"suite": "full", "code": [], "light_ok": False, "graph": False}
 24826	    try:
 24827	        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", "-z",
 24828	                            "--no-renames", diff_range, "--"], capture_output=True, text=True, errors="replace")
 24829	    except OSError:
 24830	        return dict(full, reason="算不出改動清單")
 24831	    if r.returncode != 0:
 24832	        return dict(full, reason=f"範圍 {diff_range} 算不出來")
 24833	    raw = [f for f in r.stdout.split("\0") if f.strip()]
 24834	    guard = [f for f in raw if f in _DOCS_ONLY_NEVER or f.startswith(tuple(w for w in _DOCS_ONLY_NEVER if w.endswith("/")))]
 24835	    if guard:
 24836	        return dict(full, reason="改到 " + "、".join(guard[:3]) + " 這種守衛本身的檔(基準線/留痕),要全套")
 24837	    files = [f for f in raw if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS))]
 24838	    non_docs = [f for f in files if not _docs_only_file(f)]
 24839	    if not non_docs:
