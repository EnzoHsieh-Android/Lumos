 30401	def _git_tree_has(repo_root, at_sha, path):
 30402	    import subprocess as _sp
 30403	    r = _sp.run(["git", "cat-file", "-e", f"{at_sha}:{path}"], capture_output=True, text=True, errors="replace", cwd=str(repo_root), timeout=_disp_git_timeout())
 30404	    return r.returncode == 0
