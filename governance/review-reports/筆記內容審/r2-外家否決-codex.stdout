 24850	def _keys_mentioned(text, keys):
 24851	    """回 text 裡★整字★出現過的 keys(前後都不是英數字底線;key 照字面比,句點不當萬用字元)。
 24852	    整字比對的唯一定義:測試執行器的 --suite keys 與推送前「自主迴圈要不要整支跑」都用它
 24853	    (2026-09-18 代碼審 code-light自主迴圈 r1 架構席:掛鉤原本自己用 grep -w,句點被當萬用字元,跟執行器判得不一樣)。"""
 24854	    return [k for k in keys if k and re.search(r"(?<![A-Za-z0-9_])" + re.escape(k) + r"(?![A-Za-z0-9_])", text)]
 24855	
 24856	
 24857	def _autoloop_full_for(repo_root, keys):
 24858	    """light 推送時,自主迴圈測試要不要整支跑:抽不出關鍵字就整支跑(不知道改了什麼,不能賭——r1 通才席);
 24859	    有關鍵字就看它們有沒有整字出現在那支測試的原始碼裡。讀不到那支檔(消費專案沒有)回 False。"""
 24860	    f = Path(repo_root) / "scripts" / "test_autonomous_loop.py"
 24861	    try:
 24862	        text = f.read_text(encoding="utf-8", errors="replace")
 24863	    except OSError:
 24864	        return False
 24865	    return (not keys) or bool(_keys_mentioned(text, keys))
