 20617	def _rules_index_path(repo_root):
 20618	    return Path(repo_root) / ".lumos" / "rules" / "index.json"
 20619	
 20620	
 20621	def _rules_load(repo_root):
 20622	    """讀自寫規則的索引。回 (dict, 錯誤訊息 or None);沒有索引回 ({}, None)。
 20623	    形狀:{"cmd": "<含兩個佔位的命令>", "rules": {"<規則id>": "<樣本檔相對路徑>"}}。"""
 20624	    import json
 20625	    p = _rules_index_path(repo_root)
 20626	    if not p.is_file():
 20627	        return ({}, None)
 20628	    try:
 20629	        data = json.loads(p.read_text(encoding="utf-8"))
 20630	    except Exception as e:
 21435	        return ({}, "放行檔讀不了(" + e.__class__.__name__ + "):" + _LINT_NEW_WAIVERS_REL)
 21436	    items = data.get("waivers") if isinstance(data, dict) else None
 21437	    if not isinstance(items, list):
 21438	        return ({}, "放行檔格式不對(要有 waivers 清單):" + _LINT_NEW_WAIVERS_REL)
 21439	    out = {}
 21440	    for it in items:
 21441	        if isinstance(it, dict) and isinstance(it.get("key"), str):
 21442	            out[it["key"]] = it
 21443	    return (out, None)
 21444	
 21445	
 21446	def _lint_waivers_add(repo_root, key, rule, file_rel, reason, who):
 21447	    """加一筆放行。★讀-改-寫要上鎖★:只做原子換名不夠——兩個工作階段同時放行不同指紋,
 21448	    後寫的會整份蓋掉先寫的,一條放行就這樣靜默消失(既有 _write_lf 的說明也講了讀改寫要呼叫端上鎖)。"""
 21449	    import json
 21450	    import time as _time
 21451	    p = _lint_waivers_path(repo_root)
 21452	    with _vault_write_lock(p):
 21453	        cur, err = _lint_waivers_load(repo_root)
 21454	        if err:
 21455	            return (False, err)
 21456	        if key in cur:
 21457	            return (False, "這個指紋已經放行過了(" + key + ")")
 21458	        items = list(cur.values())
 21459	        items.append({"key": key, "rule": rule, "file": file_rel, "reason": reason,
 21460	                      "by": who, "ts": _time.strftime("%Y-%m-%dT%H:%M:%S")})
 21461	        p.parent.mkdir(parents=True, exist_ok=True)
 21462	        _write_lf(p, json.dumps({"waivers": items}, ensure_ascii=False, indent=2) + "\n")
 21463	    return (True, None)
 21464	
