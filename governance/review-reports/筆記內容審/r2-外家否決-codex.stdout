 24791	def _docs_only_file(path):
 24792	    """這支檔算不算「純文件」:路徑在白名單(根目錄那幾個檔要全名相等;目錄要前綴相等)且副檔名在文件清單(不分大小寫)。
 24793	    只看路徑與副檔名、不讀內容:讀內容的那條路(首行 #!)第一版有,但它只認「已知的程式」,不認得的照放——反過來列文件才安全。"""
 24794	    if not any(path == w or (w.endswith("/") and path.startswith(w)) for w in _DOCS_ONLY_PATHS):
 24795	        return False
 24796	    if path in _DOCS_ONLY_PATHS:          # 根目錄的全名白名單(LICENSE 沒副檔名)
 24797	        return True
 24798	    base = path.rsplit("/", 1)[-1]
 24799	    return "." in base.lstrip(".") and ("." + base.rsplit(".", 1)[1].lower()) in _DOCS_ONLY_EXTS
 24800	
 24801	
 24802	def _range_base(rr, diff_range):
 24803	    """範圍起點:a..b 是 a;a...b 是 merge-base(a,b)(代碼審 r1 正確性席:三點範圍拿左端點當起點,刪掉的檔會從錯的版本讀);其他回 None。"""
 24804	    if not diff_range:
 24805	        return None
 24806	    if "..." in diff_range:
 24807	        a, b = diff_range.split("...", 1)
 24808	        try:
 24809	            r = subprocess.run(["git", "-C", str(rr), "merge-base", a or "HEAD", b or "HEAD"], capture_output=True, text=True, errors="replace")
 24810	            return r.stdout.strip() or None if r.returncode == 0 else None
 24811	        except OSError:
 24812	            return None
 24813	    if ".." in diff_range:
 24814	        return diff_range.split("..", 1)[0] or None
 24815	    return None
 24816	
 24817	
 24818	def _test_suite_for_range(repo_root, diff_range):
 24819	    """這段範圍推送前/CI 該跑哪個測試範圍。回 dict:suite(docs|full)、reason、code(非文件且是程式檔的清單)、
 24820	    light_ok(非文件檔★全部★是「需要有家的程式檔」——小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
 24821	    會從它眼皮下溜過,所以 light 不准帶著這種檔一起少跑全套;代碼審 r1 資安席)。
 24822	    自己用 git 算檔清單(不用 pitfalls 的 files:那份已經把 .json/.jsonl 按副檔名擋掉);--no-renames:從 scripts/ 搬進 docs/ 的檔會拆成
 24823	    「刪程式檔+加文件」,刪的那支讓它跑全套。簿記帳與卷證不算;算不出範圍 → full(fail-safe 是多跑,不是少跑)。"""
 24824	    base = _range_base(repo_root, diff_range)
 24825	    full = {"suite": "full", "code": [], "light_ok": False, "graph": False}
 24826	    try:
 24827	        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", "-z",
 24828	                            "--no-renames", diff_range, "--"], capture_output=True, text=True, errors="replace")
 24829	    except OSError:
 24830	        return dict(full, reason="算不出改動清單")
 24831	    if r.returncode != 0:
 24832	        return dict(full, reason=f"範圍 {diff_range} 算不出來")
 24833	    raw = [f for f in r.stdout.split("\0") if f.strip()]
 24834	    guard = [f for f in raw if f in _DOCS_ONLY_NEVER or f.startswith(tuple(w for w in _DOCS_ONLY_NEVER if w.endswith("/")))]
 24835	    if guard:
 24836	        return dict(full, reason="改到 " + "、".join(guard[:3]) + " 這種守衛本身的檔(基準線/留痕),要全套")
 24837	    files = [f for f in raw if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS))]
 24838	    non_docs = [f for f in files if not _docs_only_file(f)]
 24839	    if not non_docs:
 24840	        # 碰到圖譜筆記(docs/<名>-knowledge/)要多跑「讀真圖譜」的測試(檢索品質、評測、goldset):圖譜健檢只驗結構,
 24841	        # 驗不到「搜尋還找不找得到」(2026-09-18 代碼審 code-文件子集收緊 r1 通才席)
 24842	        graph = any(_vault_slug_of(f) for f in files)
 24843	        return {"suite": "docs", "reason": "改到的只有 README、docs、assets 這類文件(沒碰程式與 skills)" + (";含圖譜筆記,加跑讀真圖譜的測試" if graph else ""),
 24844	                "code": [], "light_ok": False, "graph": graph}
 24845	    code = [f for f in non_docs if _is_code_file(repo_root, f, base)]
 24846	    return {"suite": "full", "reason": "改到 " + "、".join(non_docs[:3]) + ("…" if len(non_docs) > 3 else "") + " 這種不是純文件的檔",
 24847	            "code": code, "light_ok": len(code) == len(non_docs), "graph": False}
 24848	
