 24743	def _pitfall_tier(claims, files, repo_root, diff_range):
 24744	    """改動風險分級(單一算法;★vault-free★,pitfalls 在 pre-push 熱路徑上不載圖譜——代碼審 r1 架構席):
 24745	    命中風險型樣或新告警 → high;改動裡沒有任何「需要有家的程式檔」(_is_code_file,每支檔有家同一套定義)→ light;其餘 standard。
 24746	    「計劃風險低且小改動閘過 → light」那一層要讀圖譜,由 spec-gate --push-check(本來就有圖譜、本來就在 pre-push 跑)印;這裡只用審查帳字串便宜提示一句。回 (tier, 一句為什麼)。"""
 24747	    if claims:
 24748	        return "high", "命中風險型樣或新告警"
 24749	    base = _range_base(repo_root, diff_range)
 24750	    code = [f for f in files if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS)) and _is_code_file(repo_root, f, base)]
 24751	    if not code:
 24752	        return "light", "改動裡沒有程式檔(只有文件/資料/圖譜)"
 24753	    return "standard", "有程式檔改動、沒命中風險型樣" + (";審查帳有全靠人驗的風險低留痕,跑 lumos spec-gate --push-check <範圍> 看是不是 light" if _ledger_has_manual_only(repo_root) else "")
 24754	
 24755	
 24756	def _ledger_has_manual_only(repo_root):
 24757	    """便宜前置(不載圖譜):審查帳裡有沒有全靠人驗的風險低留痕。找不到 vault 或讀不動=沒有。"""
 24758	    try:
 24759	        vault = find_vault(Path(repo_root))
 24760	        ledger = vault.parent / ".canary-log.jsonl" if vault else None
 24761	        return bool(ledger and ledger.exists() and '"manual_only": true' in ledger.read_text(encoding="utf-8", errors="replace"))
 24762	    except OSError:
 24763	        return False
 24764	
