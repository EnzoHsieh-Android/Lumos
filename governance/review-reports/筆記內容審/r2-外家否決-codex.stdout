 30163	def _dispositions_split_path_line(ev):
 30164	    """'path:line' → (path, line) 或 (None, 原因)。最後一個冒號之後是行號(純數字或 a-b);反斜線先正規化;絕對路徑與 .. 拒收。"""
 30165	    from pathlib import PurePosixPath
 30166	    s = str(ev).strip().replace("\\", "/")
 30167	    if ":" not in s:
 30168	        return None, "缺行號(格式 path:line)"
 30169	    path, line = s.rsplit(":", 1)
 30170	    if not re.fullmatch(r"\d+(-\d+)?", line):
 30171	        return None, f"行號 {line!r} 不是數字或 a-b"
 30172	    _lo, _hi = (int(x) for x in line.split("-", 1)) if "-" in line else (int(line), int(line))
 30173	    if _lo < 1 or _hi < _lo:
 30174	        return None, f"行號 {line!r} 不合法(要 ≥1,a-b 的 a 不能大於 b)"   # r1 邊界席 f1:10-5 曾讓 IndexError 被吞成 fail-open
 30175	    if not path or path.startswith("/") or PurePosixPath(path).is_absolute() or ".." in PurePosixPath(path).parts:
 30176	        return None, "路徑要是 repo 相對路徑(不收絕對路徑與 ..)"
 30177	    return path, line
