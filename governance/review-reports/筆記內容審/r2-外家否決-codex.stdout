 30037	def cmd_bound_tests(diff_range, repo=None, as_json=False, advisory=False, from_json=None,
 30038	                    skip=False, skip_note=""):
 30039	    """跑「這次改動波及到的硬合約」綁的那些測試。
 30040	
 30041	    ★為什麼要獨立一支指令★(2026-09-07 全 repo 審視 #17,設計 [S2],r1 外家席判 blocking):
 30042	    這件事本來藏在 code-loop check 裡,而合約測試紅了會讓那支回 rc1;推送關卡把所有 rc1
 30043	    一律解讀成「高風險改動還沒審查」,叫人去跑 code-loop pass。
 30044	    ★留下審查紀錄修不好一支紅掉的測試,下次照樣被擋。★ 訊息與處置必須分流。
 30045	
 30046	    ★扁平頂層指令,不包子動詞★:這個 repo 對單一動詞的工具一律扁平,
 30047	    群組式(loop / canary / guard 那種)是留給天生有兩個以上動詞的。
 30048	
 30049	    rc:0=green 或沒東西可跑 / 1=red 或 unfilterable(且不是 advisory) / 2=參數或環境問題。
 30050	    --advisory:紅了照樣印、照樣記帳,但回 0(低風險推送用;人裁 2026-09-07)。
 30051	    unfilterable(指令回成功但證不出跑過)比照紅辦理——假綠的殺傷力跟紅一樣。
 30052	    """
 30053	    import json as _json
 30054	    root = Path(repo or ".").resolve()
 30055	    payload = _impact_payload_read(from_json) if from_json else None
 30056	    if from_json and payload is None:
 30057	        # ★失敗隔離★:讀不到那份算好的結果,不是「沒事」也不是「炸掉」——記帳放行,
 30058	        # 並且讓人看得出是這一步壞了,不要跟「真的沒東西可跑」混在一起。
 30059	        _bound_tests_log(root, "range-unavailable", [], f"讀不到已算好的波及結果:{from_json}")
 30060	        if as_json:
 30061	            print(_json.dumps({"status": "range-unavailable", "advisory": advisory,
 30062	                               "reason": f"讀不到已算好的波及結果({from_json})"}, ensure_ascii=False))
 30063	        else:
 30064	            print(f"提醒:讀不到已經算好的波及結果({from_json}),這次沒跑合約測試。", file=sys.stderr)
 30065	        return 0
 30066	    v = _bound_tests_check(root, diff_range, skip=skip, skip_note=skip_note,
 30067	                           payload=payload, advisory=advisory)
 30068	    if as_json:
 30069	        print(_json.dumps(v, ensure_ascii=False))
 30070	        return 0 if (v["status"] not in ("red", "unfilterable") or advisory) else 1
 30071	    st = v["status"]
 30072	    if st == "red":
 30073	        # ★訊息要講「這要修測試,不是補審查留痕」★(設計 [S2] 的整個理由)
 30074	        print("", file=sys.stderr)
 30075	        head = "提醒(不擋)" if advisory else "擋下"
 30076	        print(f"{head}:這次改動碰到的硬合約,它們綁的測試沒過。", file=sys.stderr)
 30077	        for n, plat, m, d in v["red"][:6]:
 30078	            print(f"    {n}  [{m}]  {d}", file=sys.stderr)
 30079	        print("", file=sys.stderr)
 30080	        if v.get("not_run"):
 30081	            # 代碼審 r2 通才 F2:紅燈時也要講另一個平台沒跑(原本只有 JSON 帶 not_run,人讀輸出漏講)
 30082	            print(f"  另外 {len(v['not_run'])} 支沒跑——{v.get('not_run_reason', '')}", file=sys.stderr)
 30083	        print("  ★這是測試紅了,不是「還沒審查」★——補一筆代碼審留痕修不好它。", file=sys.stderr)
 30084	        print("  要嘛把測試修綠,要嘛那條合約已經不成立了、去改合約:", file=sys.stderr)
 30085	        print(f"      lumos contracts <節點>", file=sys.stderr)
 30086	        if advisory:
 30087	            print("  這次是低風險推送,只提醒不擋——但帳上記著,而且高風險推送會擋。", file=sys.stderr)
 30088	        print("", file=sys.stderr)
 30089	        return 0 if advisory else 1
 30090	    # ★綠走 stdout、紅走 stderr,比照兄弟函式★(代碼審 r1 架構對齊席):
 30091	    # code-loop check 對同一份 bound-tests 狀態的分法就是
 30092	    # `file=sys.stderr if _st == "red" else sys.stdout`。第一版全部塞 stderr,
 30093	    # 在終端機上看起來一樣,但那是一條說不出理由的偏離。
 30094	    if st in ("green",):
 30095	        print(f"合約測試 {v['ran']} 支全綠(跑 {v['secs']}s、算 {v.get('calc_secs', 0)}s)")
 30096	        if v.get("not_run"):
 30097	            print(f"提醒:受波及合約測試另有 {len(v['not_run'])} 支沒跑——{v.get('not_run_reason', '')}")
 30098	    elif st == "no-config":
 30099	        # 原本這個狀態一個字都不印(只有 code-loop check 那條路印一句寫死的話,多平台時還講錯)
 30100	        print(f"提醒:{v['reason']}")   # 原因字串本身就講了「沒有跑」,前面再加一次就講兩遍(代碼審 r3 編排者自找)
 30101	    elif st == "whole-suite-deferred":
 30102	        print(f"提醒:{v['reason']}")
 30103	    elif st in _BOUND_ZERO_REASONS:
 30104	        # ★零覆蓋不再靜默★(消費專案接入靜默失效 [E]/[S4]):原本這三種狀態直接 return 0 不印一行,
 30105	        # 使用者分不出「閘跑過而且沒東西要跑」跟「閘根本沒作用」。訊息刻意帶「受波及合約測試」
 30106	        # 這個既有關鍵字——pre-push 對 code-loop check 的非阻擋輸出會先 grep 過濾一次(r1 邊界席 f2)。
 30107	        print(f"提醒:受波及合約測試這次沒有可跑的——{_BOUND_ZERO_REASONS[st]}")
 30108	    elif st == "unfilterable":
 30109	        print("", file=sys.stderr)
 30110	        head = "提醒(不擋)" if advisory else "擋下"
 30111	        print(f"{head}:受波及合約的測試指令跑完回成功,但★證不出它真的跑過任何一支測試★。", file=sys.stderr)
 30112	        print(f"    {v['reason']}", file=sys.stderr)
 30113	        print("", file=sys.stderr)
 30114	        print("  為什麼要擋:這種情況下閘會報「全綠」,而實際上一支都沒跑——", file=sys.stderr)
 30115	        print("  你會以為合約被測試守著,其實沒有。那比測試紅掉更危險,因為它不出聲。", file=sys.stderr)
 30116	        print("  設定檔在 .lumos/config.json 的 test.run_cmd(多平台在 platforms.<平台>.run_cmd)。", file=sys.stderr)
 30117	        if not advisory:
 30118	            print("  真的修不動、這次要先過:", file=sys.stderr)
 30119	            print("      lumos bound-tests --diff <範圍> --skip --note \"<為什麼跳過>\"", file=sys.stderr)
 30120	            print("      (推送關卡那條路用 lumos code-loop check --skip-bound-tests --note \"…\";兩條都會留痕)", file=sys.stderr)
 30121	        return 0 if advisory else 1
 30122	    return 0
