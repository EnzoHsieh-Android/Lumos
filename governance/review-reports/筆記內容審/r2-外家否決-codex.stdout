 24802	def _range_base(rr, diff_range):
 24803	    """範圍起點:a..b 是 a;a...b 是 merge-base(a,b)(代碼審 r1 正確性席:三點範圍拿左端點當起點,刪掉的檔會從錯的版本讀);其他回 None。"""
 24804	    if not diff_range:
 24805	        return None
 24806	    if "..." in diff_range:
 24807	        a, b = diff_range.split("...", 1)
 24808	        try:
 24809	            r = subprocess.run(["git", "-C", str(rr), "merge-base", a or "HEAD", b or "HEAD"], capture_output=True, text=True, errors="replace")
 24810	            return r.stdout.strip() or None if r.returncode == 0 else None
 24811	        except OSError:
 24812	            return None
 24813	    if ".." in diff_range:
 24814	        return diff_range.split("..", 1)[0] or None
 24815	    return None
