 22958	    if gl is None:
 22959	        return base
 22960	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
 22961	    if r is None or r.returncode != 0:
 22962	        return base                                    # 上線點不在這條歷史上
 22963	    if base in (None, _EMPTY_TREE_SHA):
 22964	        return gl
 22965	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
 22966	    return gl if (r is not None and r.returncode == 0 and base != gl) else base
