 13739	def _html_model(env):
 13740	    """蒐集語意模型給 HTML 視圖:nodes(含 type/status/合約/stale/raw)+ typed edges。"""
 13741	    out_e, in_e = env.edges
 13742	    nodes, edges, seen = [], [], set()
 13743	    for rel, n in env.notes.items():
 13744	        inv, debt = extract_contracts(n)
 13745	        summ = n.fields.get("summary")
 13746	        summ = summ if isinstance(summ, str) else ""
 13747	        status = status_of(env, rel)
 13748	        ntype = n.fields.get("type")
 13749	        ntype = ntype if isinstance(ntype, str) and ntype else rel.split("/")[0].lower()
 13750	        try:
 13751	            raw = (env.vault / rel).read_text(encoding="utf-8-sig")
 13752	        except Exception:
 13753	            raw = ""
 13754	        _dt = n.fields.get("date") or n.fields.get("created")
 13755	        nodes.append({
 13756	            "id": rel, "label": n.stem, "rel": rel, "type": ntype, "status": status,
 13757	            "folder": rel.split("/")[0], "inv": inv, "debt": debt,
 13758	            "date": str(_dt) if _dt else "",
 13759	            "indeg": len(set(in_e.get(rel, []))),
 13760	            "summary": [l.strip() for l in summ.split("\n") if l.strip()][:6],
 13761	            "raw": raw,
 13762	        })
 13763	    # typed edges: plan_refs / verified_by / link
 13764	    for rel, n in env.notes.items():
 13765	        plan = {env.resolve(link_target(x)) for x in as_list(n.fields.get("plan_refs"))}
 13766	        verify = {env.resolve(link_target(x)) for x in as_list(n.fields.get("verified_by"))}
 13767	        plan.discard(None); verify.discard(None)
 13768	        for d in set(out_e.get(rel, [])):
 13769	            kind = "plan" if d in plan else "verify" if d in verify else "link"
 13770	            key = (rel, d, kind)
 13771	            if key not in seen:
 13772	                seen.add(key)
 13773	                edges.append({"source": rel, "target": d, "kind": kind})
 13774	    return {"nodes": nodes, "edges": edges}
