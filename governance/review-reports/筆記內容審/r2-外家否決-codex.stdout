 30155	def _dispositions_reason_ok(text):
 30156	    """理由門檻(r2 邊界席 B10):去掉空白與標點後,CJK 字元 ≥10 個,或總字元 ≥25 個;標點不算 CJK,加句號繞不過。"""
 30157	    if not isinstance(text, str):
 30158	        return False
 30159	    core = _DISP_STRIP_RE.sub("", text)
 30160	    return len("".join(_RANK_CJK_RE.findall(core))) >= 10 or len(core) >= 25
