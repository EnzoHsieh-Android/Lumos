 13929	def edit_fm_scalar(fm_lines, key, value):
 13930	    fm = list(fm_lines)
 13931	    formatted = fmt_scalar(key, value)
 13932	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 13933	    if key in struct:
 13934	        s, e, kind = struct[key]
 13935	        if kind != "scalar":
 13936	            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
 13937	        fm[s] = f"{key}: {formatted}"
 13938	    else:
 13939	        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
 13940	        ins = len(fm)
 13941	        for k, s, e, kind in fm_structure(fm):
 13942	            if kind in ("list", "block"):
 13943	                ins = s
 13944	                break
 13945	        fm.insert(ins, f"{key}: {formatted}")
 13946	    return fm
