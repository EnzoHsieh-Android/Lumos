 30295	        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
 30296	            f.write(json.dumps(ev, ensure_ascii=False) + "\n")
 30297	    except OSError as e:
 30298	        return False, f"治理帳寫不進去({e})"
