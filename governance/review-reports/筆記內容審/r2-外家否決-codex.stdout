 29397	def _porcelain_z_paths(out):
 29398	    """把 `git status --porcelain -z` 的輸出切成路徑清單。
 29399	
 29400	    ★改名/複製會吐兩個片段★(2026-09-21 審查席):第一個是「兩碼狀態+空白+新路徑」,
 29401	    第二個是**裸的舊路徑,沒有前綴**。一律切 [3:] 會把舊路徑砍掉三個字元變成垃圾字串。
 29402	    目前帳本白名單全是固定字面路徑所以打不到,但前提本身是錯的,白名單一擴充就會漏列。
 29403	    """
 29404	    parts = [x for x in out.split("\0") if x]
 29405	    paths, i = [], 0
 29406	    while i < len(parts):
 29407	        ent = parts[i]
 29408	        if len(ent) < 4:
 29409	            i += 1
 29410	            continue
 29411	        paths.append(ent[3:])
 29412	        i += 2 if (ent[0] in ("R", "C") or ent[1] in ("R", "C")) else 1
 29413	    return paths
 29414	
