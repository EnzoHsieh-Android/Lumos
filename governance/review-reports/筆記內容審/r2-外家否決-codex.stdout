 13803	def cmd_export_html(env, out_path, standalone=False):
 13804	    import json
 13805	    import datetime
 13806	    model = _html_model(env)
 13807	    # </script> 在嵌入 JSON 裡會提早關閉 <script> 標籤破壞整頁 → 轉義 </(標準作法)
 13808	    data = json.dumps(model, ensure_ascii=False).replace("</", "<\\/")
 13809	    stamp = datetime.date.today().isoformat()
 13810	    html = _HTML_TEMPLATE.replace("__DATA__", data).replace("__STAMP__", stamp) \
 13811	                         .replace("__VAULT__", env.vault.name) \
 13812	                         .replace("__NC__", str(len(model["nodes"]))) \
 13813	                         .replace("__EC__", str(len(model["edges"])))
 13814	    if standalone:
 13815	        # inline cytoscape/marked(去 CDN,防火牆/離線可開);字體退化系統字(移除 google link)
 13816	        vendor = Path(__file__).resolve().parent / "vendor"
 13817	        for name, (url, tag) in _VIZ_LIBS.items():
 13818	            try:
 13819	                src = _fetch_text(url, vendor / f"{name}.min.js").replace("</script", "<\\/script")
 13820	            except Exception as e:
 13821	                print(f"擋下:--standalone 模式要先下載 {name},這台機器至少要連一次網,現在抓不到: {e}", file=sys.stderr)
 13822	                return 2
 13823	            html = html.replace(tag, f"<script>{src}</script>")
 13824	        html = html.replace(_FONT_LINKS, "<!-- standalone: 字體退化系統字(無外部 CDN) -->")
 13825	    Path(out_path).write_text(html, encoding="utf-8")
 13826	    mode = "standalone(自包含/離線可開)" if standalone else "CDN"
 13827	    print(f"✓ export html [{mode}]: {out_path}  ({len(model['nodes'])} 節點 / {len(model['edges'])} 邊)")
 13828	    return 0
