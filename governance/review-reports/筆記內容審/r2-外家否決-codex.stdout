 20385	def _lint_aligned(diff_range, repo_root):
 20386	    """判斷 diff_range 右端 ref 是否與工作區 HEAD 對齊(座標系一致)。
 20387	    右端:先 rsplit('...', 1) 再 rsplit('..', 1);空→HEAD;無 .. → 工作區比較恆 True。
 20388	    對齊 = git rev-parse <right> == git rev-parse HEAD 且 git status --porcelain 空。
 20389	    任何子程序失敗 → False。"""
 20390	    import subprocess
 20391	    # 提取右端 ref
 20392	    if "..." in diff_range:
 20393	        right = diff_range.rsplit("...", 1)[1]
 20394	    elif ".." in diff_range:
 20395	        right = diff_range.rsplit("..", 1)[1]
 20396	    else:
 20397	        # 無 .. → 工作區比較,恆對齊
 20398	        return True
 20399	    if not right:
 20400	        right = "HEAD"
 20401	    try:
 20402	        r_right = subprocess.run(
 20403	            ["git", "rev-parse", right],
 20404	            capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 20405	        r_head = subprocess.run(
 20406	            ["git", "rev-parse", "HEAD"],
 20407	            capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 20408	        r_status = subprocess.run(
 20409	            ["git", "status", "--porcelain"],
 20410	            capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 20411	    except FileNotFoundError:
 20412	        return False
 20413	    if r_right.returncode != 0 or r_head.returncode != 0 or r_status.returncode != 0:
 20414	        return False
 20415	    return (r_right.stdout.strip() == r_head.stdout.strip()
 20416	            and r_status.stdout.strip() == "")
 20417	
