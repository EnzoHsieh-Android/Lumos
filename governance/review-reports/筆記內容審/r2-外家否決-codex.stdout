 20419	def _lint_load_config(repo_root):
 20420	    """讀取 repo_root/.lumos/lint.json → dict;不存在或解析失敗 → None。"""
 24680	    """把候選寫進 arch:arch["tension_candidates"]=[{file, question, patterns, siblings, unreadable}];超過檔數上限加 arch["candidates_truncated"]=True。
 24681	    只看 when(不看 when_raw:鄰居的字串字面比對沒意義);正規化同 _stack_norm_line——區塊註解內不以 * 開頭的裸行會被當程式碼,
 24682	    這是既有適用性判定同一條天花板,兩邊對稱、偏差方向是少一個候選(r1 外家 F1/通才 G4,承認不修)。
 24683	    候選的題必在 stack_questions_applicable:added_lines 跟 changed_lines 過同一道 _stack_changed_ok,增行 ⊂ 增刪行。"""
 24684	    out = []
 24685	    n_files = 0
 24686	    truncated = False
 24687	    for f, sibs in (arch.get("files") or {}).items():
 24688	        lines = added_lines.get(f)
 24689	        if not lines:
 24690	            continue
 24691	        sk = _stack_key_for_file(f, repo_root)
 24692	        if not sk or sk not in _STACK_TRIGGERS:
 24693	            continue
 24694	        norm = [n for n in (_stack_norm_line(l) for l in lines) if n is not None]
 24695	        if not norm:
 24696	            continue
 24697	        if n_files >= _TENSION_MAX_FILES:
 24698	            truncated = True
 24699	            break
 24700	        n_files += 1
 24701	        sib_norm = {s: _tension_read_norm(Path(repo_root) / s) for s in sibs}
 24702	        readable = [s for s in sibs if sib_norm[s] is not None]
 24703	        unreadable = [s for s in sibs if sib_norm[s] is None]
 24704	        if not readable:
 24705	            continue   # 只剩不可讀的對照檔:沒有東西可比,不出候選
 24706	        for qid, pats, _raw in _STACK_TRIGGERS[sk]:
 24707	            novel = []
 24708	            for pat in pats:
 24709	                if not any(pat.search(n) for n in norm):
 24710	                    continue
 24711	                if any(pat.search(n) for s in readable for n in sib_norm[s]):
 24712	                    continue
 24713	                if pat.pattern not in novel:
 24714	                    novel.append(pat.pattern)
 24715	            if novel:
 24716	                out.append({"file": f, "question": qid, "patterns": novel, "siblings": readable, "unreadable": unreadable})
 24717	    if out:
 24718	        arch["tension_candidates"] = out
 24719	    if truncated:
 24720	        arch["candidates_truncated"] = True
 24721	
