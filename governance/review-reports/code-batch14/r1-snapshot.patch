 cp "$SRC" "$DEST"
 launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true    # 先卸再裝,才吃得到改過的內容
 launchctl bootstrap "$DOMAIN" "$DEST" || { echo "launchctl bootstrap 失敗" >&2; exit 1; }
+
+# 通知 app 一併建起來,並且★當場發一則★——不是為了好看,是為了讓 macOS 現在就問你
+# 「要不要允許這個 app 發通知」。不在安裝時問,第一次真的出事那天通知會被靜默丟掉,
+# 而那正是這支看門狗存在的理由。
+if build_notifier; then
+  open -a "$NOTIFIER" --args "看門狗裝好了。之後它有話要說,就會長這樣。" 2>/dev/null || true
+  echo ""
+  echo "★請確認兩件事★"
+  echo "  1. 剛才右上角有沒有跳出一則通知?沒有的話到「系統設定 → 通知」把"
+  echo "     「Lumos 治理看門狗」打開——沒開的話它以後喊了你也看不到。"
+  echo "  2. 那則通知左邊的圖示是不是 Lumos 的四角星?"
+  echo "  圖示沒換到 → 重建一次:bash governance/install-watchdog.sh --rebuild-notifier"
+fi
+
+echo ""
 echo "裝好了。"
 status
