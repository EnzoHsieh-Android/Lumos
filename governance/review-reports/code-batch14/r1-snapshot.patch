+# ★桌面通知的圖示要換成 Lumos 的四角星,得包一個 app★
+# 事實先講清楚:`osascript ... display notification` 顯示的是**呼叫它那支程式**的圖示
+# (從 launchd 跑就是 Script Editor 那個),沒有辦法在指令裡指定圖片。要自訂圖示只有兩條路:
+#   ①裝 terminal-notifier —— 新增一個外部依賴,這個 repo 的家規是零依賴,不走。
+#   ②自己包一個最小的 .app —— 只用 macOS 內建的 osacompile / sips / iconutil / plutil,不加依賴。
+# 走②。app 是「建出來的東西」不是原始碼,所以不進版控,裝的時候現建。
+NOTIFIER_DIR="$HOME/Library/Application Support/Lumos"
+NOTIFIER="$NOTIFIER_DIR/LumosWatchdog.app"
+ICON_SRC="$(cd "$DIR/.." && pwd)/assets/lumos-icon.png"
+
+build_notifier() {
+  for c in osacompile sips iconutil plutil; do
+    command -v "$c" >/dev/null 2>&1 || { echo "缺 $c,跳過通知圖示這一步(通知照發,只是用系統預設圖示)"; return 1; }
+  done
+  [ -f "$ICON_SRC" ] || { echo "找不到圖檔 $ICON_SRC,跳過通知圖示這一步"; return 1; }
+  local tmp; tmp="$(mktemp -d)" || return 1
+  local iset="$tmp/lumos.iconset"; mkdir -p "$iset"
+  local s
+  for s in 16 32 128 256 512; do
+    sips -z "$s" "$s" "$ICON_SRC" --out "$iset/icon_${s}x${s}.png" >/dev/null 2>&1
+    sips -z $((s*2)) $((s*2)) "$ICON_SRC" --out "$iset/icon_${s}x${s}@2x.png" >/dev/null 2>&1
+  done
+  iconutil -c icns "$iset" -o "$tmp/lumos.icns" >/dev/null 2>&1 || { rm -rf "$tmp"; return 1; }
+  # ★applet 一定要 quit★:不加的話它會留在事件迴圈裡不結束,每小時一則就是每小時一個殭屍行程。
+  cat > "$tmp/notify.applescript" <<'APPLESCRIPT'
+on run argv
+	set theMsg to "(沒有內容)"
+	if (count of argv) > 0 then set theMsg to item 1 of argv
+	set theTitle to "Lumos 治理看門狗"
+	if (count of argv) > 1 then set theTitle to item 2 of argv
+	display notification theMsg with title theTitle
+	quit
+end run
+on quit
+	continue quit
+end quit
+APPLESCRIPT
+  rm -rf "$NOTIFIER"
+  mkdir -p "$NOTIFIER_DIR"
+  osacompile -o "$NOTIFIER" "$tmp/notify.applescript" >/dev/null 2>&1 || { rm -rf "$tmp"; return 1; }
+  cp "$tmp/lumos.icns" "$NOTIFIER/Contents/Resources/applet.icns"
+  plutil -replace CFBundleIdentifier -string "com.enzo.lumos.watchdog-notifier" "$NOTIFIER/Contents/Info.plist" >/dev/null
+  plutil -replace CFBundleName -string "Lumos 治理看門狗" "$NOTIFIER/Contents/Info.plist" >/dev/null
+  touch "$NOTIFIER"           # 逼 LaunchServices 重讀圖示
+  rm -rf "$tmp"
+  return 0
+}
+
 case "${1:-install}" in
   --status|status) status; exit 0 ;;
+  --rebuild-notifier)
+    build_notifier && echo "通知 app 重建好了:$NOTIFIER"
+    open -a "$NOTIFIER" --args "重建完成——這則通知左邊應該是 Lumos 的四角星。" 2>/dev/null || true
+    exit 0 ;;
   --uninstall)
     launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
     rm -f "$DEST"
     echo "已移除。"; status; exit 0 ;;
 esac
 
 [ -f "$SRC" ] || { echo "找不到 plist:$SRC" >&2; exit 1; }
 # plist 裡寫死了腳本的絕對路徑,先確認那個路徑跟這份 repo 對得上,不然裝了也是跑空氣。
 want="$DIR/wrapper-watchdog.sh"
 grep -q -- "$want" "$SRC" || {
@@ -50,12 +102,27 @@ grep -q -- "$want" "$SRC" || {
   echo "  這份 repo 的腳本在:$want" >&2
   echo "  plist 裡寫的是    :$(grep -A1 'ProgramArguments' -A3 "$SRC" | grep string | tail -1)" >&2
   exit 1
 }
 plutil -lint "$SRC" >/dev/null || { echo "plist 格式不合法:$SRC" >&2; exit 1; }
 
