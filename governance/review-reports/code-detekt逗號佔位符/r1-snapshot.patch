+def _lng_fake_detekt_calls(log):
+    """假 detekt 的呼叫紀錄 → [{argv, cwd}…];沒跑過回空清單。"""
+    import json as _j
+    if not Path(log).is_file():
+        return []
+    return [_j.loads(ln) for ln in Path(log).read_text(encoding="utf-8").splitlines() if ln.strip()]
