+def _slot_check_shape(p):
+    """欄位寫壞、重複鍵、缺核心一句 → (問題, {鍵: 最後一個值})。"""
+    out, seen = [], {}
+    for k, v, err in p["fields"]:
+        if err:
+            out.append(f"[{k}:…] {err}")
