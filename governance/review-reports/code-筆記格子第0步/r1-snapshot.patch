+            return ["SEE 只放 [[連結]](連結之間可用 、 , ; ｜ 與 和 及 見 → 分隔),要寫句子就換別的前綴"]
+        return []
+    out, val = _slot_check_shape(slot_parse(rest))
+    out += _slot_check_required(prefix, val)
