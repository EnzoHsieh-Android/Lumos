+_SLOT_REQUIRED = {"WHY": ("出處", "因"), "RULE": ("依據", "since", "retire"), "PITFALL": ("出處", "根因"),
+                  "FACT": ("來源", "confirmed"), "FLOW": ("來源", "confirmed"), "DEP": ("來源", "confirmed")}
+_SLOT_ONE_OF = {"PITFALL": ("test", "repro", "防回歸")}
+_SLOT_ENUM = {"依據": ("人", "外部", "審計", "法規", "相容"), "來源": ("部署", "資料庫", "生產", "外部", "人工")}
