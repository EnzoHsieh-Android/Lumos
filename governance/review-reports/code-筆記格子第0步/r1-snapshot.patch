+def slot_parse(rest):
+    """前綴冒號後面的字 → {"fields": [(鍵, 值, 錯誤或 None)], "core": 核心一句}。
+    只有白名單鍵才算欄位(鍵名英文不分大小寫、冒號收全形、冒號後空白不算);值數方括號層數,成對的照收;
+    值裡的反引號段照字面不數括號;成對反引號(行內程式碼)裡的方括號不算欄位,不成對的反引號到行尾都當正文。
+    核心一句=去掉所有欄位後剩下的字(空白壓成一格)。"""
+    fields, core, i, n = [], [], 0, len(rest)
+    while i < n:
+        c = rest[i]
+        if c == "`":
+            j = rest.find("`", i + 1)
+            if j == -1:
+                core.append(rest[i:])
+                break
+            core.append(rest[i:j + 1])
+            i = j + 1
+            continue
+        m = _SLOT_KEY_RE.match(rest, i) if c == "[" else None
+        if m and m.group(1).lower() in _SLOT_CANON:
+            key, j = _SLOT_CANON[m.group(1).lower()], _slot_value_end(rest, m.end())
+            if j >= n:
+                fields.append((key, rest[m.end():].strip(), "值裡的方括號要成對,或把值用反引號包起來"))
+                break
+            fields.append((key, rest[m.end():j].strip(), None))
+            i = j + 1
+            continue
+        core.append(c)
+        i += 1
+    return {"fields": fields, "core": " ".join("".join(core).split())}
+
+
+def _slot_value_end(rest, j):
+    """從值的開頭往後數方括號層數,回收尾那個 ] 的位置;沒收尾回 len(rest)。值裡的反引號段照字面跳過。"""
+    n, depth = len(rest), 1
+    while j < n:
+        ch = rest[j]
+        if ch == "`":
+            k2 = rest.find("`", j + 1)
+            j = n if k2 == -1 else k2 + 1
+            continue
+        if ch == "[":
+            depth += 1
+        elif ch == "]":
+            depth -= 1
+            if depth == 0:
+                return j
+        j += 1
+    return n
+
+
+def slot_is_new(rest):
+    """這行是不是新文法(有任一個新文法才有的鍵)。"""
