 def chain(qid, seen=()):
     """requires 遞移展開,前置語句在前;前置只能是 INCLUDE / CREATE 這類不回傳列的語句"""
     req = qs[qid][0].get('requires', '-')
     out = []
     for r in ([] if req == '-' else req.split(',')):
         if r not in seen:
             out += [x for x in chain(r, seen + (qid,)) if x not in out]
     return out + [qid]
