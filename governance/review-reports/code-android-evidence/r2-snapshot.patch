+def _mb_scroll(cls, p90, p50=-3.0):
+    return {"name": "scrollList", "params": {}, "className": cls, "metrics": {},
+            "sampledMetrics": {"frameOverrunMs": {"P50": p50, "P90": p90, "P95": p90, "P99": p90, "runs": [[p90]]}}}
+
