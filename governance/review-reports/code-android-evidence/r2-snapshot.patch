+def _mb_thr(**over):
+    t = {"scenario": "pkg.Flow#scrollList", "metric": "frameOverrunMs", "stat": "P90", "max": 0,
+         "contract": "Systems/結帳 ★INVARIANT★ 從主頁進結帳", "decided_by": "Enzo", "decided_at": "2026-10-23"}
+    t.update(over)
+    return {k: v for k, v in t.items() if v is not None}
+
