+def _kill_wait_new_second(state):
+    """guard kill 寫檔(套壞法、還原)之前:等到現在跟同一組上一次寫檔、上一次跑測試結束都不同秒,最多等 3 秒
+    (時鐘往回撥時不空轉)。測試工具靠「修改時間到秒 + 大小」判斷要不要重編(Python 編譯快取、macOS 內建 make),
+    同一秒寫出同大小的檔會沿用上一次的編譯結果(Projects/殺傷力驗證編譯快取誤判_計劃)。"""
+    deadline = time.time() + 3.0
+    while int(time.time()) <= max(state["w"], state["r"]) and time.time() < deadline:
+        time.sleep(0.05)
+
+
+def _kill_after_write(path, state):
+    """寫檔之後讀回修改時間:晚於上一次寫檔與上一次測試結束(取大者)就記進 state["w"]、回 True;
+    否則等 1 秒、把修改時間碰成現在(不設未來時間)再讀回,最多 3 次(只到 2 秒的檔案系統,例:FAT);都不行回 False。"""
+    floor = max(state["w"], state["r"])
+    for i in range(4):
+        try:
+            mt = int(os.stat(path).st_mtime)
+        except OSError:
+            return False
+        if mt > floor:
+            state["w"] = mt
+            return True
+        if i == 3:
+            return False
+        time.sleep(1.0)
+        try:
+            os.utime(path)
+        except OSError:
+            return False
+    return False
+
