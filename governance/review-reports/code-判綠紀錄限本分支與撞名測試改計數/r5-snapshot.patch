+_GIT_PARTIAL_KEYS = r"^(extensions\.partialclone|remote\..*\.promisor|remote\..*\.partialclonefilter)$"
+
+
+_GIT_INT_RE = re.compile(r"([+-]?)(0[xX][0-9a-fA-F]+|0[0-7]*|[1-9][0-9]*)[kKmMgG]?")
+
+
+def _git_bool(val):
+    """git 設定值照 git 自己的布林規則判(git config 文件):沒有等號的裸鍵(val=None)是真;false/no/off 與等號後的空字串是假;
+    true/yes/on 是真;整數照 C 的寫法(0x 十六進位、0 開頭八進位、十進位,可帶 k/m/g 單位字尾)非 0 是真。
+    git 自己會拒絕的寫法(例如 0b0、0_0)算真——呼叫端拿它判「要不要小心」,寧可多小心(代碼審 r4 邊界席逐值對照 git --type=bool)。
+    不改叫 git config --type=bool:一次 --get-regexp 同時讀三個設定,其中 partialCloneFilter 不是布林,套不上 --type=bool。"""
+    if val is None:
+        return True
+    v = val.strip().lower()
+    if v in ("false", "no", "off", ""):
+        return False
+    if v in ("true", "yes", "on"):
+        return True
+    m = _GIT_INT_RE.fullmatch(v)
+    if not m:
+        return True
+    num = m.group(2)
+    base = 16 if num.startswith("0x") else (8 if num.startswith("0") and len(num) > 1 else 10)
+    return int(num[2:] if base == 16 else num, base) != 0
+
+
+def _git_partial_clone(repo_root, deadline=None):
+    """部分複製(partial clone)嗎 → True / False / None(git 叫不起來或逾時)。git 的設計文件寫明承諾遠端由三個設定各自認定:
+    extensions.partialClone、remote.<名>.promisor、remote.<名>.partialCloneFilter;只看第一個會漏掉只寫後兩個的複製
+    (代碼審 code-判綠紀錄限本分支與撞名測試改計數 r2 邊界席實測 git 2.39 的 clone --filter 就是這樣)。
+    讀法:git config -z 每筆以 NUL 結尾、鍵與值以換行分隔、裸鍵沒有換行(遠端名含空白也切得對);promisor 的值照 _git_bool,
+    另兩個設定有值就算(r3 三席抓到自己猜值的寫法會漏裸鍵、promisor = 2、切錯含空白的遠端名)。
+    部分複製裡查本機沒有的物件,git 會自動連遠端抓;回頭條件與規格閘紅燈版兩處讀舊版本前都先問這一支。"""
+    r = _lens_git_dl(repo_root, "config", "-z", "--get-regexp", _GIT_PARTIAL_KEYS, deadline=deadline)
+    if r is None or r.returncode not in (0, 1):
+        return None
+    for ent in r.stdout.split("\0"):
+        if not ent:
+            continue
+        key, nl, val = ent.partition("\n")
+        if key.endswith(".promisor"):
+            if _git_bool(val if nl else None):
+                return True
+        elif val.strip():
+            return True
+    return False
+
