    89	def runs_in_window(out_dir, hours=5.0, now=None):
    90	    """最近 hours 小時內落地的探針場次(含撞上限的):算帳號窗口用掉多少。以檔案 mtime 為時間,沿用結果檔沒有時間戳的現況。"""
    91	    now = time.time() if now is None else now
    92	    n = 0
    93	    for p in Path(out_dir).glob("*.json"):
    94	        if p.name in ("summary.json", "meta.json"):
    95	            continue
    96	        try:
    97	            if now - p.stat().st_mtime > hours * 3600:
    98	                continue
    99	            n += len(json.loads(p.read_text(encoding="utf-8")).get("results", []))
   100	        except Exception:
   101	            continue
   102	    return n
