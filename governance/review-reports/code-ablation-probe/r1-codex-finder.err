   126	def global_skills_health():
   127	    """回「壞掉的」全域 skill symlink 清單 [(名字, 指向)](空=健康)。
   128	    壞掉=懸空(目標不存在)或指進臨時沙盒(路徑含 lumos-probe-)。偵測探針把 ~/.claude/skills 重連到沙盒的事故;
   129	    LUMOS_PROBE 擋不到的未知路徑靠這道事後抓。"""
   130	    skills = Path.home() / ".claude" / "skills"
   131	    bad = []
   132	    if not skills.exists():
   133	        return bad
   134	    for d in sorted(skills.iterdir()):
   135	        if not d.is_symlink():
   136	            continue
   137	        tgt = os.readlink(str(d))
   138	        if not d.exists() or "lumos-probe-" in tgt:   # d.exists() 對 symlink 是「跟隨後存不存在」
   139	            bad.append((d.name, tgt))
   140	    return bad
