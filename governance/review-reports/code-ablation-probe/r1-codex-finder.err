    83	def needed(by_arm, arm, qid, runs):
    84	    """這題這組還缺幾場有效結果。"""
    85	    have = sum(1 for r in by_arm.get(arm, []) if r.get("id") == qid and is_valid(r))
    86	    return max(0, runs - have)
