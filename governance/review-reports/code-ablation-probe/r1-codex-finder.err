   118	def lumos_stats(calls):
   119	    """回 (整場有沒有敲過 lumos 子指令, 第一次敲的是第幾個工具呼叫)。只認 Bash 指令字串;Skill 調用不算;路徑裡的 lumos 不算。"""
   120	    for i, (name, summ) in enumerate(calls):
   121	        if name == "Bash" and LUMOS_CALL_RE.search(summ):
   122	            return True, i
   123	    return False, None
