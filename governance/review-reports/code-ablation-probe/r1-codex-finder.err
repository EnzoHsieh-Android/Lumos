   132	def _arm_stats(results, expected_ids, runs):
   133	    valid = [r for r in results if is_valid(r)]
   134	    n = len(valid)
   135	    m1 = sum(1 for r in valid if r.get("passed"))
   136	    m2 = sum(1 for r in valid if r.get("ever_lumos"))
   137	    idxs = [r["first_lumos_idx"] for r in valid if r.get("first_lumos_idx") is not None]
   138	    m3 = statistics.median(idxs) if idxs else None
   139	    ans = [r for r in valid if str(r.get("id", "")).startswith("a")]
   140	    per = {}
   141	    for r in valid:
   142	        per.setdefault(r["id"], [0, 0])
   143	        per[r["id"]][1] += 1
   144	        per[r["id"]][0] += 1 if r.get("passed") else 0
   145	    inconsistent = sorted(i for i, (c, t) in per.items() if 0 < c < t)
   146	    return {"n": n, "m1_passed": m1, "m1_rate": round(m1 / n, 4) if n else None,
   147	            "m2_ever": m2, "m2_rate": round(m2 / n, 4) if n else None,
   148	            "m3_first_idx_median": m3, "m3_n": len(idxs),
   149	            "m4_answers_passed": sum(1 for r in ans if r.get("passed")), "m4_answers_n": len(ans),
   150	            "inconsistent_questions": inconsistent,
   151	            "missing": max(0, len(expected_ids) * runs - n),
   152	            "instrument_errors": len(results) - n,
   153	            "limit_hits": sum(1 for r in results if r.get("limit_hit")),
   154	            "per_question": per}
