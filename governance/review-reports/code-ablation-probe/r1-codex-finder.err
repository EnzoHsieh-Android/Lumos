   104	
   105	def run_job(arm, qid, n, files, timeout, max_turns, out_dir, wait_on_limit, model="", max_per_window=0):
   106	    if max_per_window and runs_in_window(out_dir) >= max_per_window:
   107	        # 事前上限(SWE-agent per-instance / bmad per-story 的窗口版):這個五小時窗口已經跑滿,不再開新工作;
   108	        # 之後重跑 runner 會逐題補缺。比「撞到再等」省一次撞牆,也不會把 Enzo 的互動配額吃光。
   109	        return (arm, qid, f"skip 窗口已達 {max_per_window} 場上限,之後再補")
   110	    stamp = time.strftime("%H%M%S")
   111	    out = Path(out_dir) / f"{arm}-q-{qid}-{stamp}.json"
   112	    log = Path(out_dir) / f"{arm}-q-{qid}-{stamp}.log"
   113	    cmd = [sys.executable, str(PROBE), "--scenarios", ",".join(str(ROOT / f) for f in files),
   114	           "--only", qid, "--runs", str(n), "--arm", arm, "--out", str(out),
   115	           "--timeout", str(timeout), "--max-turns", str(max_turns), "--wait-on-limit", str(wait_on_limit)]
   116	    if model:
   117	        cmd += ["--model", model]
   118	    t0 = time.time()
   119	    with open(log, "w", encoding="utf-8") as lf:
   120	        lf.write("$ " + " ".join(cmd) + "\n")
   121	        lf.flush()
   122	        r = subprocess.run(cmd, cwd=str(ROOT), stdout=lf, stderr=subprocess.STDOUT, text=True)
   123	    try:
   124	        d = json.loads(out.read_text(encoding="utf-8"))
   125	        got = sum(1 for x in d.get("results", []) if is_valid(x))
   126	        lim = sum(1 for x in d.get("results", []) if x.get("limit_hit"))
   127	    except Exception:
   128	        got, lim = 0, 0
   129	    return (arm, qid, f"rc={r.returncode} 有效 {got}/{n} 撞上限 {lim} {round(time.time() - t0)}s")
