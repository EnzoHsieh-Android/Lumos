   132	def _arm_stats(results, expected_ids, runs):
   133	    valid = [r for r in results if is_valid(r)]
   134	    n = len(valid)
   135	    m1 = sum(1 for r in valid if r.get("passed"))
   136	    m2 = sum(1 for r in valid if r.get("ever_lumos"))
   137	    idxs = [r["first_lumos_idx"] for r in valid if r.get("first_lumos_idx") is not None]
   138	    m3 = statistics.median(idxs) if idxs else None
   139	    ans = [r for r in valid if str(r.get("id", "")).startswith("a")]
   140	    per = {}
   141	    for r in valid:
   142	        per.setdefault(r["id"], [0, 0])
   143	        per[r["id"]][1] += 1
   144	        per[r["id"]][0] += 1 if r.get("passed") else 0
   145	    inconsistent = sorted(i for i, (c, t) in per.items() if 0 < c < t)
   146	    return {"n": n, "m1_passed": m1, "m1_rate": round(m1 / n, 4) if n else None,
   147	            "m2_ever": m2, "m2_rate": round(m2 / n, 4) if n else None,
   148	            "m3_first_idx_median": m3, "m3_n": len(idxs),
   149	            "m4_answers_passed": sum(1 for r in ans if r.get("passed")), "m4_answers_n": len(ans),
   150	            "inconsistent_questions": inconsistent,
   151	            "missing": max(0, len(expected_ids) * runs - n),
   152	            "instrument_errors": len(results) - n,
   153	            "limit_hits": sum(1 for r in results if r.get("limit_hit")),
   154	            "per_question": per}
   155	
   156	
   157	def classify_question(w, wo):
   158	    """一題對「這條規矩」有沒有鑑別力。w/wo = [過幾次, 跑幾次]。
   159	    區分=帶著比拔掉多過至少三分之二;反向=拔掉反而多過;都過/都不過=這題測不到這條規矩;其餘=弱/不穩。
   160	    (借 skill-creator 的 analyzer:抓「不管有沒有裝都過」的斷言——那種題留在題庫裡只是在花配額。)"""
   161	    if not w[1] or not wo[1]:
   162	        return "缺資料"
   163	    rw, rwo = w[0] / w[1], wo[0] / wo[1]
   164	    if rw == 1 and rwo == 1:
   165	        return "不區分(都過)"
   166	    if rw == 0 and rwo == 0:
   167	        return "不區分(都不過)"
   168	    if rw - rwo >= 2 / 3:
   169	        return "區分"
   170	    if rwo > rw:
   171	        return "反向"
   172	    return "弱/不穩"
   173	
   174	
   175	def merge(out_dir, expected_ids, runs):
   176	    by_arm = load_results(out_dir)
   177	    arms = {a: _arm_stats(by_arm[a], expected_ids, runs) for a in ARMS}
   178	    per_q = {q: {a: arms[a]["per_question"].get(q, [0, 0]) for a in ARMS} for q in expected_ids}
   179	    for a in ARMS:
   180	        arms[a].pop("per_question", None)
   181	    w, wo = arms["with"]["m1_rate"], arms["without"]["m1_rate"]
   182	    delta = round((w - wo) * 100, 2) if (w is not None and wo is not None) else None
   183	    classes = {q: classify_question(v["with"], v["without"]) for q, v in per_q.items()}
   184	    class_counts = {}
   185	    for c in classes.values():
   186	        class_counts[c] = class_counts.get(c, 0) + 1
   187	    return {"runs": runs, "expected_ids": expected_ids, "arms": arms, "m1_delta_pp": delta, "per_question": per_q,
   188	            "question_class": classes, "class_counts": class_counts}
   189	
   190	
   191	def render_md(s, meta):
   192	    a, b = s["arms"]["with"], s["arms"]["without"]
   193	    def pct(x): return "—" if x is None else f"{x * 100:.1f}%"
