   268	if __name__ == "__main__":
   269	    sys.exit(main())
     1	#!/usr/bin/env python3
     2	"""情境探針:模擬場景,看 Claude 會不會自己敲對的 lumos 指令(Projects/指令索引與情境測試_計劃)。
     3	
     4	不是直接呼叫指令——那沒意義。做法:
     5	  1. git clone --local 本 repo 到臨時目錄(Bash 可以放心開,動到的只是副本)
     6	  2. 對每個情境跑 headless `claude -p <情境> --output-format stream-json`
     7	  3. 從事件流抓工具呼叫順序;判準 = 期望的 `lumos <指令>` 出現在任何「禁止先做」的工具/指令之前
     8	  4. 報告每個情境:過/不過、第一個工具呼叫是什麼、全部工具序列
     9	
    10	判準的三個刻意設計(外審 2026-08-22 提過,裁定不改):
    11	  - Skill 調用不算「敲到指令」——要測的就是「調了 skill 之後有沒有真的敲 lumos」。
    12	  - forbid_before 對非 Bash 工具只比對工具名(Grep/Read/Edit…),不看內容;要禁的是「那一類動作」。
    13	  - 副本裡 Claude 自己的 hooks(impact 注入等)照常觸發——探針量的是 Claude 在真實環境(規則+hook)下的行為;
    14	    hook 注入不是工具呼叫,不會被算成它自己敲的指令。
    15	  - 不開放 Agent 工具:子代理內部的動作對事件流是隱形的,會造成假通過/假失敗。
    16	
    17	用法:
    18	  scripts/scenario_probe.py [--scenarios governance/scenarios/commands.jsonl] [--only s01,s02]
    19	                            [--max-turns 6] [--timeout 240] [--model ...] [--out 報告.json]
    20	"""
    21	import argparse, json, os, re, shutil, subprocess, sys, tempfile, time
    22	from pathlib import Path
    23	
    24	ROOT = Path(__file__).resolve().parent.parent
    25	
    26	
    27	def tool_calls_from_stream(lines):
    28	    """stream-json → [(tool_name, 摘要字串)] 依時間序。"""
    29	    calls = []
    30	    for ln in lines:
    31	        ln = ln.strip()
    32	        if not ln.startswith("{"):
    33	            continue
    34	        try:
    35	            ev = json.loads(ln)
    36	        except Exception:
    37	            continue
    38	        msg = ev.get("message") if isinstance(ev, dict) else None
    39	        content = (msg or {}).get("content") if isinstance(msg, dict) else None
    40	        if ev.get("type") == "assistant" and isinstance(content, list):
    41	            for blk in content:
    42	                if isinstance(blk, dict) and blk.get("type") == "tool_use":
    43	                    name = blk.get("name", "?")
    44	                    inp = blk.get("input") or {}
    45	                    if name == "Bash":
    46	                        summ = str(inp.get("command", ""))[:200]
    47	                    elif name in ("Read", "Edit", "Write", "Glob", "Grep"):
    48	                        summ = " ".join(str(inp.get(k, "")) for k in ("file_path", "pattern", "path") if inp.get(k))[:200]
    49	                    elif name == "Skill":
    50	                        summ = str(inp.get("skill", ""))
    51	                    else:
    52	                        summ = json.dumps(inp, ensure_ascii=False)[:200]
    53	                    calls.append((name, summ))
    54	    return calls
    55	
    56	
    57	def judge(calls, expect, forbid_before):
    58	    """回 (passed, reason, first_hit_index)。
    59	    expect:每條 regex 必須各自命中至少一次(對 Bash 指令字串比對)。
    60	    forbid_before:任何一條命中(工具名或 Bash 指令字串)若發生在「第一條 expect 命中」之前 → 不過。"""
    61	    exp_idx = {}
    62	    for i, (name, summ) in enumerate(calls):
    63	        hay = summ if name == "Bash" else f"{name}:{summ}"   # 非 Bash 工具用「工具名:參數」比,紀律題可寫 Edit:docs/…
    64	        for e in expect:
    65	            if e not in exp_idx and re.search(e, hay):
    66	                exp_idx[e] = i
    67	    missing = [e for e in expect if e not in exp_idx]
    68	    if missing:
    69	        return False, f"沒敲到期望指令: {missing}", None
    70	    first = min(exp_idx.values())
    71	    for i, (name, summ) in enumerate(calls[:first]):
    72	        if name in ("Read", "Grep", "Glob") and "/.claude/skills/" in summ:
    73	            continue   # 讀索引/skill 手冊是期望行為,不算「先做了別的」
    74	        for f in forbid_before:
    75	            if re.search(f, name) or (name == "Bash" and re.search(f, summ)):
    76	                return False, f"在敲 lumos 之前先做了 {name}: {summ[:80]!r}", first
    77	    return True, "ok", first
    78	
    79	
    80	# ── 修法 A ablation(Projects/修法A_lumos先行ablation_計劃)──────────────────────────
    81	# 「不帶」組要拔的是 CLAUDE.md 裡「第一個工具呼叫是 lumos」那一小節(到「三條鐵則」之前),
    82	# 其餘(## 標題、兩行前提、三條鐵則、白話、skill 表)原樣。邊界字串跟 scripts/templates/graph-discipline.md 同源;
    83	# 範本改標題這裡會找不到 → make_sandbox 直接炸,寧可實驗跑不起來,不要靜默跑一個沒拔乾淨的「不帶」組。
    84	RULE_HEAD = "### 第一個工具呼叫是 `lumos`"
    85	RULE_END = "### 三條鐵則"
    86	
    87	
    88	def strip_lumos_first_rule(text):
    89	    """回 (新文字, 有沒有砍到)。找不到兩個邊界或順序反了 → 原文、False。"""
    90	    s = text.find(RULE_HEAD)
    91	    e = text.find(RULE_END)
    92	    if s < 0 or e < 0 or e <= s:
    93	        return text, False
    94	    return text[:s] + text[e:], True
    95	
    96	
    97	# 2026-09-02 實跑教訓:帳號用量上限(「You've hit your session limit · resets 12:10pm」)一到,claude -p 4 秒就回、
    98	# 零工具呼叫,探針把它記成「沒敲到期望指令」——168 場裡 115 場是這種假失敗。這類場次要標出來、不算分。
    99	LIMIT_RE = re.compile(r"hit your (session|usage) limit|usage limit|rate limit|too many requests|overloaded", re.I)
   100	
   101	
   102	def is_limit_hit(calls, final_text, result_event):
   103	    """零工具呼叫 + 回覆/結果事件寫著用量或速率上限 → 這場是儀器被擋,不是被測 AI 的行為。"""
   104	    if calls:
   105	        return False
   106	    if LIMIT_RE.search(final_text or ""):
   107	        return True
   108	    ev = result_event or {}
   109	    return bool(ev.get("is_error")) and bool(LIMIT_RE.search(json.dumps(ev, ensure_ascii=False)))
   110	
   111	
   112	# 「敲 lumos」=Bash 裡跑了 lumos 的某個子指令:`scripts/lumos search`、`python3 scripts/lumos show`、`lumos doctor`。
   113	# ★2026-09-02 第一版用 \blumos\b 字界比對,把 `grep … docs/lumos-toolchain-knowledge/` 這種路徑也算成敲了 lumos,
   114	# 拔散文那組的「敲過率」被灌到 98.8%——路徑裡的 lumos 後面接的是 -,子指令後面接的是空白+字母。★
   115	LUMOS_CALL_RE = re.compile(r"(?:^|[\s;&|(`'\"/])lumos\s+[a-z]")
   116	
   117	
   118	def lumos_stats(calls):
   119	    """回 (整場有沒有敲過 lumos 子指令, 第一次敲的是第幾個工具呼叫)。只認 Bash 指令字串;Skill 調用不算;路徑裡的 lumos 不算。"""
   120	    for i, (name, summ) in enumerate(calls):
   121	        if name == "Bash" and LUMOS_CALL_RE.search(summ):
   122	            return True, i
   123	    return False, None
   124	
   125	
   126	def global_skills_health():
   127	    """回「壞掉的」全域 skill symlink 清單 [(名字, 指向)](空=健康)。
   128	    壞掉=懸空(目標不存在)或指進臨時沙盒(路徑含 lumos-probe-)。偵測探針把 ~/.claude/skills 重連到沙盒的事故;
   129	    LUMOS_PROBE 擋不到的未知路徑靠這道事後抓。"""
   130	    skills = Path.home() / ".claude" / "skills"
   131	    bad = []
   132	    if not skills.exists():
   133	        return bad
   134	    for d in sorted(skills.iterdir()):
   135	        if not d.is_symlink():
   136	            continue
   137	        tgt = os.readlink(str(d))
   138	        if not d.exists() or "lumos-probe-" in tgt:   # d.exists() 對 symlink 是「跟隨後存不存在」
   139	            bad.append((d.name, tgt))
   140	    return bad
   141	
   142	
   143	def make_sandbox(src, arm="with"):
   144	    """複製工作樹到臨時目錄,並★切斷所有能把東西推出去的路★。回副本路徑。
   145	    arm="without":commit 前先砍 CLAUDE.md 的「第一個工具呼叫」小節(見 strip_lumos_first_rule),
   146	    這樣情境之間的 git checkout -- . 不會把它復原。
   147	
   148	    2026-08-23 事故:守衛題 a05 的情境是「沒有我就開工做」,被測 AI 真的改了計劃檔並 push——
   149	    臨時副本是 rsync 來的,.git/config 裡的 remote 跟著複製,push 就直接推到真遠端,
   150	    主幹多了一筆 author=probe@local 的「probe snapshot」(已覆蓋)。
   151	    隔離不只是「動到的只是副本」,還要「副本推不出去」。三道:
   152	      ① 拔掉所有 remote(沒有目標就沒得推)
   153	      ② pre-push hook 寫死 exit 1(就算被測 AI 自己加回 remote 也擋;hooksPath 指向副本內的專用目錄)
   154	      ③ 假身分 probe@local 維持——即使前兩道都失效,GitHub 上也認得出這不是人
   155	    """
   156	    tmp = Path(tempfile.mkdtemp(prefix="lumos-probe-"))
   157	    work = tmp / "repo"
   158	    work.mkdir(parents=True)
   159	    subprocess.run(["rsync", "-a", "--exclude", "node_modules", "--exclude", ".venv",
   160	                    f"{src}/", f"{work}/"], check=True)
   161	    # ① 拔 remote
   162	    r = subprocess.run(["git", "remote"], cwd=str(work), capture_output=True, text=True)
   163	    for name in r.stdout.split():
   164	        subprocess.run(["git", "remote", "remove", name], cwd=str(work))
   165	    # ② 副本專用 hooks 目錄:pre-push 硬擋;其餘 hook 不存在=不跑(取代原本指向 /dev/null 的做法)
   166	    hooks = tmp / "hooks"
   167	    hooks.mkdir()
   168	    (hooks / "pre-push").write_text("#!/bin/sh\necho '探針沙盒:禁止 push' >&2\nexit 1\n", encoding="utf-8")
   169	    (hooks / "pre-push").chmod(0o755)
   170	    subprocess.run(["git", "config", "core.hooksPath", str(hooks)], cwd=str(work))
   171	    if arm == "without":
   172	        cm = work / "CLAUDE.md"
   173	        new, ok = strip_lumos_first_rule(cm.read_text(encoding="utf-8"))
   174	        if not ok:
   175	            raise RuntimeError("without 組:CLAUDE.md 找不到「第一個工具呼叫」小節的邊界,拔不乾淨,實驗無效,停手")
   176	        cm.write_text(new, encoding="utf-8")
   177	    # commit 成乾淨狀態(含未 commit 的改動——索引/筆記常是剛寫還沒 commit)
   178	    subprocess.run(["git", "add", "-A"], cwd=str(work))
   179	    subprocess.run(["git", "-c", "user.name=probe", "-c", "user.email=probe@local",
   180	                    "commit", "-qm", "probe snapshot", "--no-verify"], cwd=str(work))
   181	    return work
   182	
   183	
   184	def run_one(sc, workdir, max_turns, timeout, model, arm="with"):
   185	    # ★逐題開放 Agent(2026-08-22)★:預設禁,因為多數題目不需要、開了只是燒錢又慢。
   186	    # 但「要說沒有之前先派乾淨 agent 對一次」這條紀律,★不派 agent 就測不出來★——
   187	    # 題目標 allow_agent:true 才放行,其餘照舊禁。
   188	    allow_agent = bool(sc.get("allow_agent"))
   189	    tools = ["Bash", "Read", "Grep", "Glob", "Edit", "Write", "Skill"]
   190	    if allow_agent:
   191	        tools.append("Agent")
   192	    cmd = ["claude", "-p", sc["prompt"], "--output-format", "stream-json", "--verbose",
   193	           "--max-turns", str(max_turns), "--no-session-persistence",
   194	           "--permission-mode", "acceptEdits",
   195	           "--allowedTools", *tools]
   196	    if not allow_agent:
   197	        cmd += ["--disallowedTools", "Agent"]
   198	    if model:
   199	        cmd += ["--model", model]
   200	    env = dict(os.environ)
   201	    env.pop("CLAUDECODE", None); env.pop("CLAUDE_CODE_ENTRYPOINT", None)
   202	    # ★探針沙盒事故防線(2026-09-02,見 make_sandbox 註)★:被測 session 的 HOME 是真的 ~/,
   203	    # 一旦它跑 lumos install/update/bootstrap 就會把真的 ~/.claude/skills 重連到沙盒、沙盒清掉後全斷。
   204	    # LUMOS_PROBE=1 讓那幾個指令在探針下直接拒絕(scripts/lumos:_refuse_if_probe)。
   205	    env["LUMOS_PROBE"] = "1"
   206	    if arm == "without":
   207	        env["LUMOS_ENTRY_HOOK_OFF"] = "1"   # SessionStart 入口 hook 看到就靜默,同一句提醒不能從第二個口進來
   208	    t0 = time.time()
   209	    try:
   210	        r = subprocess.run(cmd, cwd=str(workdir), capture_output=True, text=True, timeout=timeout, env=env)
   211	        out = r.stdout
   212	        err = r.stderr[-400:]
   213	    except subprocess.TimeoutExpired as e:
   214	        out = (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
   215	        err = "timeout"
   216	    calls = tool_calls_from_stream(out.splitlines())
   217	    ok, why, first = judge(calls, sc["expect"], sc.get("forbid_before", []))
   218	    # ⑩ 答案對不對(工具鏈補強十件):情境可帶 answer_expect=[regex…],最後回覆文字要全部命中
   219	    final = ""
   220	    result_ev = {}
   221	    for ln in out.splitlines():
   222	        ln = ln.strip()
   223	        if not ln.startswith("{"):
   224	            continue
   225	        try:
   226	            ev = json.loads(ln)
   227	        except Exception:
   228	            continue
   229	        if isinstance(ev, dict) and ev.get("type") == "result":
   230	            final = ev.get("result") or ""
   231	            result_ev = ev
   232	    if ok and sc.get("answer_expect"):
   233	        miss_a = [e for e in sc["answer_expect"] if not re.search(e, final or "", re.I)]
   234	        if miss_a:
   235	            ok, why = False, f"敲對了指令,但答案缺關鍵事實: {miss_a}"
   236	    limit_hit = is_limit_hit(calls, final, result_ev)
   237	    if limit_hit:
   238	        ok, why = False, "儀器例外: 帳號用量/速率上限,claude -p 沒真的跑,這場不算分"
   239	    ever, first_idx = lumos_stats(calls)
   240	    return {"id": sc["id"], "cat": sc.get("cat"), "passed": ok, "reason": why,
   241	            "first_tool": calls[0] if calls else None, "n_calls": len(calls),
   242	            "calls": calls, "secs": round(time.time() - t0, 1), "stderr": err if not ok else "",
   243	            "answer": (final or "")[:1500],
   244	            "arm": arm, "ever_lumos": ever, "first_lumos_idx": first_idx,
   245	            "limit_hit": limit_hit, "result_subtype": result_ev.get("subtype")}
