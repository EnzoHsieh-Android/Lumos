   194	    lines = [f"# 修法 A ablation 對照({meta.get('date')};模型 {meta.get('claude_version', '?')})", "",
   195	             f"題 {len(s['expected_ids'])} × 每組 {s['runs']} 次;讀法見 Projects/修法A_lumos先行ablation_計劃(預註冊,這裡只列數字)。"
   196	             f"只算有效場(撞用量上限/儀器例外不算)。", "",
   197	             "| 尺 | with(現況) | without(拔散文) |", "|---|---|---|",
   198	             f"| M1 通過率 | {a['m1_passed']}/{a['n']} = {pct(a['m1_rate'])} | {b['m1_passed']}/{b['n']} = {pct(b['m1_rate'])} |",
   199	             f"| M2 敲過 lumos | {a['m2_ever']}/{a['n']} = {pct(a['m2_rate'])} | {b['m2_ever']}/{b['n']} = {pct(b['m2_rate'])} |",
   200	             f"| M3 首次步數中位(有敲的場數) | {a['m3_first_idx_median']} ({a['m3_n']}) | {b['m3_first_idx_median']} ({b['m3_n']}) |",
   201	             f"| M4 答案題正確 | {a['m4_answers_passed']}/{a['m4_answers_n']} | {b['m4_answers_passed']}/{b['m4_answers_n']} |",
   202	             f"| 同題多次不一致的題數 | {len(a['inconsistent_questions'])} | {len(b['inconsistent_questions'])} |",
   203	             f"| 缺場 / 撞上限 / 其他儀器例外 | {a['missing']} / {a['limit_hits']} / {a['instrument_errors'] - a['limit_hits']} | {b['missing']} / {b['limit_hits']} / {b['instrument_errors'] - b['limit_hits']} |",
   204	             "", f"**M1 差(with − without)= {s['m1_delta_pp']} pp**", "",
   205	             "題目鑑別力(這題對「這條規矩」測不測得到):" + "、".join(f"{k} {v} 題" for k, v in sorted(s.get("class_counts", {}).items())), "",
   206	             "| 題 | with | without | 鑑別力 |", "|---|---|---|---|"]
   207	    for q, v in s["per_question"].items():
   208	        lines.append(f"| {q} | {v['with'][0]}/{v['with'][1]} | {v['without'][0]}/{v['without'][1]} | {s.get('question_class', {}).get(q, '')} |")
   209	    if a["inconsistent_questions"] or b["inconsistent_questions"]:
   210	        lines += ["", f"不一致題 with: {', '.join(a['inconsistent_questions']) or '—'};without: {', '.join(b['inconsistent_questions']) or '—'}"]
   211	    return "\n".join(lines) + "\n"
   212	
   213	
   214	def main():
   215	    ap = argparse.ArgumentParser()
   216	    ap.add_argument("--questions", default=",".join(DEFAULT_Q))
   217	    ap.add_argument("--runs", type=int, default=3)
   218	    ap.add_argument("--workers", type=int, default=2, help="平行路數;瓶頸是帳號用量上限不是機器,多開沒用")
   219	    ap.add_argument("--wait-on-limit", type=int, default=7200, help="探針撞上限時最多等幾秒(每 300 秒重試)")
   220	    ap.add_argument("--max-per-window", type=int, default=50,
   221	                    help="五小時內最多開幾場(含撞上限的);0=不設。2026-09-02 實測每窗口約 55 場才撞牆,預設留餘裕給人用")
   222	    ap.add_argument("--timeout", type=int, default=600)
   223	    ap.add_argument("--max-turns", type=int, default=18)
   224	    ap.add_argument("--model", default="")
   225	    ap.add_argument("--out-dir", default="")
   226	    ap.add_argument("--arms", default=",".join(ARMS))
   227	    ap.add_argument("--merge-only", action="store_true", help="不跑,只合併既有輸出")
   228	    a = ap.parse_args()
   229	    files = a.questions.split(",")
   230	    ids = load_ids(files)
   231	    date = datetime.date.today().isoformat()
   232	    out_dir = Path(a.out_dir) if a.out_dir else ROOT / "governance" / "eval" / "ablation-lumos-first" / date
   233	    out_dir.mkdir(parents=True, exist_ok=True)
   234	    try:
   235	        ver = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=20).stdout.strip()
   236	    except Exception:
   237	        ver = "?"
   238	    meta = {"date": date, "claude_version": ver, "runs": a.runs, "workers": a.workers,
   239	            "timeout": a.timeout, "max_turns": a.max_turns, "questions": files, "n_questions": len(ids),
   240	            "started": datetime.datetime.now().isoformat(timespec="seconds")}
   241	    (out_dir / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=1), encoding="utf-8")
   242	    if not a.merge_only:
   243	        by_arm = load_results(out_dir)
   244	        jobs = []
   245	        for qid in ids:                       # 逐題、兩組交錯:中途被殺兩組進度也對稱
   246	            for arm in a.arms.split(","):
   247	                n = needed(by_arm, arm, qid, a.runs)
   248	                if n:
   249	                    jobs.append((arm, qid, n))
   250	        total = sum(n for _, _, n in jobs)
   251	        print(f"{len(ids)} 題 × {a.runs} 次 × {len(a.arms.split(','))} 組;還缺 {total} 場有效結果,"
   252	              f"{len(jobs)} 個工作,{a.workers} 路平行,撞上限最多等 {a.wait_on_limit}s → {out_dir}", flush=True)
   253	        with ThreadPoolExecutor(max_workers=a.workers) as ex:
   254	            futs = [ex.submit(run_job, arm, qid, n, files, a.timeout, a.max_turns, out_dir, a.wait_on_limit, a.model,
   255	                              a.max_per_window)
   256	                    for arm, qid, n in jobs]
   257	            for f in futs:
   258	                arm, qid, st = f.result()
   259	                print(f"  {arm} {qid}: {st}", flush=True)
   260	    s = merge(out_dir, ids, a.runs)
   261	    (out_dir / "summary.json").write_text(json.dumps(s, ensure_ascii=False, indent=1), encoding="utf-8")
   262	    md = render_md(s, meta)
   263	    (out_dir / "summary.md").write_text(md, encoding="utf-8")
   264	    print("\n" + md)
   265	    return 0
