    67	def load_results(out_dir):
    68	    """讀目錄裡所有探針輸出(第一版 shard 檔與第二版逐題檔都吃),回 {arm: [result…]}。"""
    69	    by_arm = {a: [] for a in ARMS}
    70	    for p in sorted(Path(out_dir).glob("*.json")):
    71	        if p.name in ("summary.json", "meta.json"):
    72	            continue
    73	        try:
    74	            d = json.loads(p.read_text(encoding="utf-8"))
    75	        except Exception:
    76	            continue
    77	        arm = d.get("arm") or p.name.split("-")[0]
    78	        if arm in by_arm and isinstance(d.get("results"), list):
    79	            by_arm[arm].extend(backfill_limit(r) for r in d["results"])
    80	    return by_arm
