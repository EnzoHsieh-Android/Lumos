    43	
    44	def backfill_limit(r):
    45	    """舊結果檔沒有 limit_hit 欄:零工具呼叫 + 回覆是上限訊息 → 補標 True。有欄的原樣。
    46	    順手用修正後的規則從 calls 重算 ever_lumos / first_lumos_idx(第一版把路徑裡的 lumos 也算進去,灌水)。
    47	    ★第一版只存前 12 個呼叫,超過的場次重算可能漏後段的 lumos 呼叫(偏低)★——n_calls > len(calls) 時記 calls_truncated。"""
    48	    import re
    49	    if "limit_hit" not in r:
    50	        r["limit_hit"] = (r.get("n_calls", 0) == 0) and bool(re.search(_LIMIT_TEXT, r.get("answer") or "", re.I))
    51	    calls = r.get("calls") or []
    52	    ever, idx = False, None
    53	    for i, c in enumerate(calls):
    54	        if isinstance(c, (list, tuple)) and len(c) == 2 and c[0] == "Bash" and re.search(_LUMOS_CALL, str(c[1])):
    55	            ever, idx = True, i
    56	            break
    57	    r["ever_lumos"], r["first_lumos_idx"] = ever, idx
    58	    r["calls_truncated"] = r.get("n_calls", 0) > len(calls)
    59	    return r
