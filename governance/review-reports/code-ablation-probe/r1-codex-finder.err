    57	def judge(calls, expect, forbid_before):
    58	    """回 (passed, reason, first_hit_index)。
    59	    expect:每條 regex 必須各自命中至少一次(對 Bash 指令字串比對)。
    60	    forbid_before:任何一條命中(工具名或 Bash 指令字串)若發生在「第一條 expect 命中」之前 → 不過。"""
    61	    exp_idx = {}
    62	    for i, (name, summ) in enumerate(calls):
    63	        hay = summ if name == "Bash" else f"{name}:{summ}"   # 非 Bash 工具用「工具名:參數」比,紀律題可寫 Edit:docs/…
    64	        for e in expect:
    65	            if e not in exp_idx and re.search(e, hay):
    66	                exp_idx[e] = i
    67	    missing = [e for e in expect if e not in exp_idx]
    68	    if missing:
    69	        return False, f"沒敲到期望指令: {missing}", None
    70	    first = min(exp_idx.values())
    71	    for i, (name, summ) in enumerate(calls[:first]):
    72	        if name in ("Read", "Grep", "Glob") and "/.claude/skills/" in summ:
    73	            continue   # 讀索引/skill 手冊是期望行為,不算「先做了別的」
    74	        for f in forbid_before:
    75	            if re.search(f, name) or (name == "Bash" and re.search(f, summ)):
    76	                return False, f"在敲 lumos 之前先做了 {name}: {summ[:80]!r}", first
    77	    return True, "ok", first
