   248	def main():
   249	    ap = argparse.ArgumentParser()
   250	    ap.add_argument("--repo", default=str(ROOT),
   251	                    help="要被探的專案根目錄(預設=本 repo)。★探別的專案必須給★——"
   252	                         "沒給的話不論在哪個目錄執行,複製的都是 lumos-toolchain 自己,"
   253	                         "題目再怎麼寫都是在探錯的 repo(2026-08-22 實際踩過)")
   254	    ap.add_argument("--scenarios", default=str(ROOT / "governance" / "scenarios" / "commands.jsonl"))
   255	    ap.add_argument("--only", default="")
   256	    # ★預設 8 → 18(2026-08-22)★:實測既有題庫最慢 6 步(s02/s11),8 只留 2 步餘裕;
   257	    # absence 題組天生要「查不到→換方法再查」,最慢 12 步——吃預設會在它開口之前截斷,
   258	    # 三題全假紅。假紅的下一步永遠是有人把閘關掉,所以預設本身要夠。
   259	    # ★為什麼不設更大★:步數上限不是「越寬越安全」。給太多步,那些其實在瞎繞的題也可能
   260	    # 繞到答對,反而把問題蓋掉。18 = 最慢那題(12 步)加一半餘裕,不是拍腦袋。
   261	    ap.add_argument("--max-turns", type=int, default=18)
   262	    ap.add_argument("--timeout", type=int, default=240)
   263	    ap.add_argument("--model", default="")
   264	    ap.add_argument("--out", default="")
   265	    ap.add_argument("--keep", action="store_true", help="保留臨時副本")
   266	    ap.add_argument("--sample", type=int, default=0, help="只抽 N 題(決定性:依 --seed 輪轉,給自主迴圈每週抽查用)")
   267	    ap.add_argument("--seed", default="", help="抽樣種子(例:週數);同種子同題")
   268	    ap.add_argument("--history", default="", help="把本次摘要 append 到這個 jsonl(ts/passed/total/failed)")
   269	    ap.add_argument("--ts", default="", help="寫進 history 的時間戳(排程端給)")
   270	    ap.add_argument("--dry-list", action="store_true", help="只印抽到的題目 id,不跑(測抽樣用)")
   271	    # ── 修法 A ablation 兩個旗標(預設值=改前行為)──
   272	    ap.add_argument("--runs", type=int, default=1,
   273	                    help="每題重跑幾次(預設 1)。同一題這次過下次不過是常態,不重跑就分不出規矩效果與運氣")
   274	    ap.add_argument("--arm", choices=["with", "without"], default="with",
   275	                    help="with=現況;without=沙盒 CLAUDE.md 砍「第一個工具呼叫」小節+入口 hook 靜默(見 Projects/修法A_lumos先行ablation_計劃)")
   276	    ap.add_argument("--wait-on-limit", type=int, default=0,
   277	                    help="撞到帳號用量上限時最多等幾秒(每 300 秒重試同一場;預設 0=不等,照記成儀器例外)。"
   278	                         "2026-09-02 實跑:4 路平行約 35 分鐘就撞上限,之後 115 場全是 4 秒假失敗")
   279	    a = ap.parse_args()
   280	    if a.runs < 1:
   281	        print("✗ --runs 至少 1", file=sys.stderr); return 2
   282	    scs = []
   283	    for f in a.scenarios.split(","):
   284	        scs += [json.loads(l) for l in Path(f).read_text(encoding="utf-8").splitlines() if l.strip()]
   285	    if a.only:
   286	        keep = set(a.only.split(","))
   287	        scs = [s for s in scs if s["id"] in keep or s["id"].split("-")[0] in keep]
   288	    if a.sample and a.sample < len(scs):
   289	        # 決定性輪轉:同一種子永遠抽同一組;種子換(每週)就換一組,幾週下來全部輪過
   290	        import hashlib
   291	        h = int(hashlib.sha256(a.seed.encode("utf-8")).hexdigest(), 16)
   292	        start = h % len(scs)
   293	        scs = [scs[(start + i * 3) % len(scs)] for i in range(a.sample)]
   294	        seen, uniq = set(), []
   295	        for s_ in scs:
   296	            if s_["id"] not in seen:
   297	                seen.add(s_["id"]); uniq.append(s_)
   298	        scs = uniq
   299	    if a.dry_list:
   300	        print(",".join(s_["id"] for s_ in scs)); return 0
   301	    src = Path(a.repo).resolve()
   302	    if not (src / ".git").exists():
   303	        print(f"✗ --repo {src} 不是 git repo(找不到 .git),停手", file=sys.stderr)
   304	        return 2
   305	    work = make_sandbox(src, a.arm)
   306	    # skills 走 ~/.claude(symlink 回本 repo),不用複製
   307	    print(f"探的是: {src}\n臨時副本: {work}" + (f"\n組別: {a.arm}  每題 {a.runs} 次" if (a.arm != "with" or a.runs > 1) else ""),
   308	          file=sys.stderr)
   309	    results = []
   310	    waited = 0
   311	    try:
   312	        for sc in scs:
   313	            for k in range(1, a.runs + 1):
   314	                while True:
   315	                    try:
   316	                        res = run_one(sc, work, a.max_turns, a.timeout, a.model, a.arm)
   317	                    except Exception as e:   # 一題炸掉不拖累整批:記成失敗,繼續
   318	                        res = {"id": sc.get("id", "?"), "cat": sc.get("cat"), "passed": False,
   319	                               "reason": f"儀器例外: {type(e).__name__}: {e}", "first_tool": None,
   320	                               "n_calls": 0, "calls": [], "secs": 0, "stderr": "",
   321	                               "arm": a.arm, "ever_lumos": False, "first_lumos_idx": None,
   322	                               "limit_hit": False, "result_subtype": None}
   323	                    if res.get("limit_hit") and waited < a.wait_on_limit:
   324	                        print(f"  ⏸ {sc['id']} 撞到帳號用量上限,等 300 秒再試同一場(已等 {waited}s / 上限 {a.wait_on_limit}s)", flush=True)
   325	                        time.sleep(300); waited += 300
   326	                        continue
   327	                    break
   328	                res["run"] = k
   329	                results.append(res)
   330	                mark = "✓" if res["passed"] else "✗"
   331	                ft = f"{res['first_tool'][0]}: {res['first_tool'][1][:70]}" if res["first_tool"] else "(沒有任何工具呼叫)"
   332	                tag = f" #{k}" if a.runs > 1 else ""
   333	                print(f"  {mark} {res['id']:22s}{tag} {res['secs']:6.1f}s  第一動作→ {ft}", flush=True)
   334	                if not res["passed"]:
   335	                    print(f"      {res['reason']}", flush=True)
   336	                subprocess.run(["git", "checkout", "-q", "--", "."], cwd=str(work))
   337	                subprocess.run(["git", "clean", "-qfdx"], cwd=str(work))   # -x:連 gitignore 的產出也清,情境之間不互染
   338	    finally:
   339	        bad = global_skills_health()
   340	        if bad:
   341	            print("\n" + "!" * 60, file=sys.stderr)
   342	            print(f"✗ 事故:全域 ~/.claude/skills 有 {len(bad)} 個連結被動到(懸空或指進沙盒):", file=sys.stderr)
   343	            for name, tgt in bad:
   344	                print(f"    {name} → {tgt}", file=sys.stderr)
   345	            print("  修:在真 repo 跑一次\n    python3 scripts/lumos install --force\n"
   346	                  "  這代表某條路徑繞過了 LUMOS_PROBE 防線,見 Issues/探針沙盒改動真全域機器狀態", file=sys.stderr)
   347	            print("!" * 60, file=sys.stderr)
   348	        n = len(results); p = sum(1 for r in results if r["passed"])
   349	        lim = sum(1 for r in results if r.get("limit_hit"))
   350	        print(f"\n{p}/{n} 個情境 Claude 自己敲對了 lumos 指令" + (f"(組別 {a.arm})" if a.arm != "with" else "")
   351	              + (f";其中 {lim} 場撞帳號用量上限沒真的跑,不算分" if lim else ""))
   352	        if a.runs > 1:
   353	            per = {}
   354	            for r in results:
   355	                per.setdefault(r["id"], [0, 0]); per[r["id"]][1] += 1; per[r["id"]][0] += 1 if r["passed"] else 0
   356	            print("每題通過次數: " + "  ".join(f"{i} {c}/{t}" for i, (c, t) in per.items()))
   357	        if a.out:
   358	            Path(a.out).write_text(json.dumps({"results": results, "passed": p, "total": n,
   359	                                               "arm": a.arm, "runs": a.runs}, ensure_ascii=False, indent=1), encoding="utf-8")
   360	        if a.history:
   361	            with open(a.history, "a", encoding="utf-8") as hf:
   362	                hf.write(json.dumps({"ts": a.ts, "seed": a.seed, "passed": p, "total": n,
   363	                                     "failed": [r["id"] for r in results if not r["passed"]],
   364	                                     **({"arm": a.arm, "runs": a.runs} if (a.arm != "with" or a.runs > 1) else {})},
