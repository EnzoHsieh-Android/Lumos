+def cmd_handoff(env, node, as_json=False, transcript=None, turns=1):
+    """`lumos handoff <計劃節點>`:唯讀接手視圖。用法錯誤(節點不存在、不在 git 裡)才 rc2,其餘恆 rc0。"""
+    import json as _json
+    rel = env.find(node)
+    if not rel:
+        print(f"擋下:找不到節點「{node}」", file=sys.stderr)
+        print("  為什麼在意:接手視圖是照計劃筆記點名的檔去問 git,沒有計劃就沒有清單。", file=sys.stderr)
+        print("  先找節點:", file=sys.stderr)
+        print(f"      lumos search {node}", file=sys.stderr)
+        return 2
+    root = _repo_root_from_env(env)
+    r = _lens_git(root, "rev-parse", "--show-toplevel")
+    if r is None or r.returncode != 0 or not r.stdout.strip():
+        print(f"擋下:{root} 不在 git 專案裡,接手視圖的檔案狀態全靠 git", file=sys.stderr)
+        return 2
+    toplevel = Path(r.stdout.strip())
+    if turns != 1:
+        print("提醒:--turns 目前只讀最後一輪(v1 範圍刀),給了別的值也照最後一輪算。", file=sys.stderr)
+    try:
+        text = (env.vault / rel).read_text(encoding="utf-8", errors="replace")
+    except OSError as e:
+        print(f"擋下:計劃筆記讀不到({e.__class__.__name__}:{rel})", file=sys.stderr)
+        return 2
+    files = _handoff_files(text, root, toplevel)
+    if transcript:
+        intent, why = _handoff_intent(transcript, root)
+    else:
+        tp, why = _handoff_find_transcript(root)
+        intent, why = _handoff_intent(tp, root) if tp else (None, why)
+    plan_name = rel[:-3] if rel.endswith(".md") else rel
+    if as_json:
+        print(_json.dumps({"plan": plan_name, "repo": str(root), "files": files,
+                           "intent": intent, "intent_unavailable_reason": why}, ensure_ascii=False, indent=2))
+        return 0
+
+    # 人讀三段式:發生什麼 → 為何在意 → 下一步指令獨立一行
+    print(f"接手視圖:{plan_name}(從 git 工作樹與逐字稿讀出來的,不是任何一本帳;只列狀態,不判做到哪)")
+    order = {"已改": 0, "已刪": 1, "未追蹤": 2, "乾淨": 3}
+    if not files:
+        print("計劃沒點名找得到的程式檔(scripts/ governance/ src/ … 這幾種路徑一個都沒有,或點名的都不存在)。")
+    else:
+        cnt = {}
+        for f in files:
+            cnt[f["state"]] = cnt.get(f["state"], 0) + 1
+        print(f"計劃點名的程式檔 {len(files)} 個:" + "、".join(f"{k} {cnt[k]}" for k in order if k in cnt))
+        for f in sorted(files, key=lambda x: (order.get(x["state"], 9), x["path"])):
+            tail = f"最後提交 {f['last_commit']}" if f["last_commit"] else "(沒進過 git)"
+            print(f"  {f['state']:<4} {f['path']:<44} {tail}")
+    if intent is None:
+        print(f"意圖不可得({why}):只剩 git 那半——上一輪在動什麼、使用者最後說了什麼,這裡看不到。")
+    else:
+        src = f"逐字稿「{intent['title']}」" if intent.get("title") else "逐字稿"
+        print(f"最後一輪在動什麼({src},{intent['transcript']}):")
+        if intent["turn_files"]:
+            print("  改過的檔:" + "、".join(intent["turn_files"]))
+        elif intent["turn_bash"]:
+            print("  改過的檔:(最後一輪沒有 Edit/Write 類呼叫;★純 Bash 改檔這裡看不到★,同 Issues/收工閘漏掉純Bash改碼 的盲點)")
+        else:
+            print("  改過的檔:(最後一輪沒有工具呼叫)")
+        cmds = intent["turn_bash"]
+        shown = "  |  ".join(_handoff_cmd_brief(c) for c in cmds[:8]) + (f"(…共 {len(cmds)} 條)" if len(cmds) > 8 else "")
+        print("  跑過的指令:" + (shown if cmds else "(沒有)"))
+        if intent["last_user"]:
+            when = f"({intent['last_user_ts'][:16].replace('T', ' ')})" if intent.get("last_user_ts") else ""
+            print(f"  使用者最後說{when}:「{intent['last_user']}」")
+        elif intent["kind"] == "codex":
+            print("  使用者最後說:(Codex 逐字稿 v1 不抽人話,只抽動作)")
+        else:
+            print("  使用者最後說:(逐字稿裡沒有人打的字——只有系統通知/提醒/壓縮摘要)")
+        if intent.get("bad_lines"):
+            print(f"  提醒:逐字稿有 {intent['bad_lines']} 行讀不動,已跳過(官方明說格式不穩)。")
+    print("為什麼在意:已改/已刪/未追蹤是上一個 session 做到一半留下的;這裡只列狀態,不猜做到第幾步、不判做到底了沒——線索不是狀態。")
+    print("下一步:")
+    changed = [f["path"] for f in files if f["state"] in ("已改", "已刪")]
+    fresh = [f["path"] for f in files if f["state"] == "未追蹤"]
+    if changed:
+        print("      git diff HEAD -- " + " ".join(changed))
+    if fresh:
+        print("      git status --short -- " + " ".join(fresh))
+    print(f"      lumos context {plan_name.split('/')[-1]} --brief")
+    return 0
