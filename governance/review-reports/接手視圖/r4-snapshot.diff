+def _handoff_files(text, root, toplevel):
+    """計劃點名的程式檔:重用派工鏡頭的路徑正則與過濾(去重、.md 不算、穿越不收),★不抄它的 5 檔上限★
+    (那是派工預算,不是接手的預算——第 6 個檔以後也是計劃的一部分)。
+    留的條件:repo 內存在、或 git 認得(已刪的檔樹上沒了但 status 會報 D)。
+    ★用 git status --porcelain 不用 diff HEAD★:後者看不到 untracked(進度從提交推導 v4 的死因之一)。"""
+    cands, seen = [], set()
+    raw = [m.rstrip(".,;:)」』】、") for m in _LENS_SPEC_CODE_RE.findall(text)]
+    raw += [m.strip() for m in _HANDOFF_TICK_RE.findall(text)]   # 反引號內的路徑:空白、非 ASCII 都收(r1 外家 #4)
+    for cand in raw:
+        if not cand or cand in seen or cand.endswith(".md"):
+            continue
+        seen.add(cand)
+        try:   # scripts/../../x 這種穿越不收(派工鏡頭外家 r1 M3 同款)
+            (root / cand).resolve().relative_to(root.resolve())
+        except (ValueError, OSError):
+            continue
+        cands.append(cand)
+    if not cands:
+        return []
+
+    def _git_key(cand):   # porcelain 的路徑永遠相對 repo 根;root 若是子目錄要對齊
+        try:
+            return str((root / cand).resolve().relative_to(toplevel.resolve()))
+        except (ValueError, OSError):
+            return cand
+
+    st, renamed = {}, {}
+    # 整個 repo 問一次、不帶 pathspec:rename 的舊路徑才會跟新路徑一起出現(r1 外家順帶抓到沒測 rename);
+    # -z 路徑不轉義;★-uall 這回是必要的★:不帶 pathspec 時未追蹤目錄會折成一條 `?? dir/`,裡面的檔就對不上
+    r = _lens_git(root, "status", "--porcelain", "-z", "-uall")
+    if r is not None and r.returncode == 0:
+        toks = r.stdout.split("\0")
+        i = 0
+        while i < len(toks):
+            t = toks[i]
+            if len(t) >= 4:
+                xy, new = t[:2], t[3:]
+                st[new] = xy
+                if xy[0] in "RC" and i + 1 < len(toks):   # rename/copy:下一個 token 是舊路徑
+                    old = toks[i + 1]
+                    st[old] = "R>"
+                    renamed[old] = new
+                    i += 1
+            i += 1
+    out = []
+    for cand in cands:
+        key = _git_key(cand)
+        xy = st.get(key)
+        exists = (root / cand).is_file()
+        if xy is None and not exists:
+            continue   # 不存在也不被 git 認得=計劃寫錯或早就沒了,不列
+        renamed_to = None
+        if xy is None:
+            state = "乾淨"
+        elif xy == "??":
+            state = "未追蹤"
+        elif xy == "R>":
+            state = "已改名"
+            renamed_to = renamed.get(key)
+        elif "D" in xy:
+            state = "已刪"
+        else:
+            state = "已改"
+        last = None
+        if state != "未追蹤":
+            lr = _lens_git(root, "log", "-1", "--date=short", "--format=%ad %s", "--", cand)
+            if lr is not None and lr.returncode == 0 and lr.stdout.strip():
+                last = lr.stdout.strip()
+        out.append({"path": cand, "state": state, "last_commit": last, "renamed_to": renamed_to})
+    return out
+
