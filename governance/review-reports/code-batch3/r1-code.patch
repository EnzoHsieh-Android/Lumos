+def t_severity_check_cmd():
+    """[嚴重度綁定機械掃 S2] severity-check CLI:座標介面/低報紅字(歷史 vs 新帳標籤)/
+    sha 不符 rc2 指路 quote-check/找不到帳列 rc2/advisory 恆 rc0。"""
+    import json as _j
+    import hashlib as _h
