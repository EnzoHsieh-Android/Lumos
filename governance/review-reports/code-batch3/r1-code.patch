+def _replay_git_blob(root, relpath):
+    """--freeze 前置:檔案已 commit 且與 HEAD 一致才記 blob id(r3 delta d-f2:hash-object 不落
+    物件、-w 落懸空 blob 兩週可被 GC——取 HEAD 的 blob 保證被 tree 引用)。回 (blob_id, err)。"""
+    import subprocess as _sp
+    head = _sp.run(["git", "-C", str(root), "rev-parse", f"HEAD:{relpath}"],
+                   capture_output=True, text=True)
+    if head.returncode != 0:
+        return None, f"{relpath} 還沒 commit 進版控"
+    work = _sp.run(["git", "-C", str(root), "hash-object", str(Path(root) / relpath)],
+                   capture_output=True, text=True)
+    if work.returncode != 0:
+        return None, f"{relpath} 讀不到({work.stderr.strip()[:80]})"
+    if head.stdout.strip() != work.stdout.strip():
+        return None, f"{relpath} 工作樹內容與 HEAD 不一致(先 commit 卷證再凍)"
+    return head.stdout.strip(), None
+
+
+def cmd_loop_replay(env, loop_id, golden=None, freeze=False, spec=None, note=None, repo=None):
+    """改制回測 [S1/S2](2026-08-26):gate 判定回放。
+    凍結模式(--freeze --spec):對 loop 現帳跑唯讀判定,產 governance/replay/<id>/verdict.json
+    =完整輸入閉包(全列原文+逐行 sha 集+spec sha+檔案 sha/blob+engine_rev)。
+    回放模式(--golden):對閉包重算,差異四分類——邏輯漂移/帳被動=紅 rc1;
+    帳本長大/golden 過期=列出不紅。唯讀:治理帳零寫入、不跑觀測尾巴。
+    範圍=d5 處置帳形狀;panel 舊制 rc2 指路 loop status --gate --panel(語意重算既有,不入 golden)。
+    rc:0=無異狀 / 1=紅(漂移或資料完整性) / 2=用法或帳形狀錯。"""
+    import json
+    import hashlib
+    import datetime
+    if freeze == bool(golden):
+        print("擋下:--freeze(凍結)和 --golden(回放)要挑一個模式", file=sys.stderr)
+        return 2
+    root = Path(repo).resolve() if repo else _vault_repo_root(env)
+    ledger = env.vault.parent / ".canary-log.jsonl"
+
+    def _load_rows():
+        raw, parsed = [], []
+        try:
+            for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
+                if not line.strip():
+                    continue
+                try:
+                    d = json.loads(line)
+                except ValueError:
+                    continue
+                if d.get("loop") == loop_id:
+                    raw.append(line)
+                    parsed.append(d)
+        except OSError as e:
+            print(f"擋下:帳本讀不到({e}): {ledger}", file=sys.stderr)
+            return None, None
+        return raw, parsed
+
+    def _sha(s):
+        return hashlib.sha256(s.encode("utf-8")).hexdigest()
+
+    if freeze:
+        if not spec:
+            print("擋下:凍結模式要帶 --spec(帳裡沒有 spec 路徑欄,凍結當下由操作者給)", file=sys.stderr)
+            return 2
+        raw, parsed = _load_rows()
+        if raw is None:
+            return 2
+        if not raw:
+            print(f"擋下:帳本裡沒有 loop={loop_id} 的任何記錄,沒東西可凍", file=sys.stderr)
+            return 2
+        # 兩趟同一份實作:第一趟取判定輪 rid(G3 對活檔可能已 FAIL,不影響分組);
+        # 第二趟用窗末 sha 重算=凍結的 verdict——spec 檔收斂後常繼續被編輯(常態),
+        # 凍結若對活檔算 G3,回放(對凍結 sha 算)就恆報假邏輯漂移(凍結/回放兩側輸入必須同構)。
+        out = {}
+        rc = _loop_status_disposal(parsed, loop_id, spec, 0, root, env=env, repo=repo,
+                                   readonly=True, result_out=out)
+        if rc == 2:
+            print("擋下:這個 loop 的帳形狀進不了 d5 處置判定(多半是 panel 舊制多席各自帳)——"
+                  "舊制語意重算用 lumos loop status <id> --gate --panel;golden 回放只涵蓋 d5", file=sys.stderr)
+            return 2
+        rid = out.get("rid")
+        spec_sha_frozen = next((r.get("result_sha256") for r in parsed
+                                if r.get("round") == rid and r.get("result_sha256")), None)
+        out = {}
+        rc = _loop_status_disposal(parsed, loop_id, None, 0, root, env=env, repo=repo,
+                                   readonly=True, spec_sha_override=spec_sha_frozen, result_out=out)
+        try:
+            if spec_sha_frozen and _sha256_file(spec) != spec_sha_frozen:
+                print("  (提示:spec 檔已在收斂後被編輯——常態;閉包凍的是窗末指紋,回放不受影響)")
+        except OSError:
+            pass
+        files = {}
+        for r in parsed:
+            if r.get("round") != rid:
+                continue
+            for k in ("report", "snapshot"):
+                rp = r.get(k + "_path")
+                if not rp or rp in files:
+                    continue
+                blob, err = _replay_git_blob(root, rp)
+                if err:
+                    print(f"擋下:凍結前置檢查沒過——{err};先把卷證 commit 進版控再凍", file=sys.stderr)
+                    return 2
+                files[rp] = {"sha256": r.get(k + "_sha256"), "git_blob": blob}
+        spec_sha = spec_sha_frozen
+        _spr = Path(spec).resolve()
+        try:
+            spec_rel = str(_spr.relative_to(root))
+        except ValueError:
+            spec_rel = str(_spr)
+        verdict = {
+            "loop": loop_id, "round": rid, "engine_rev": _REPLAY_ENGINE_REV,
+            "frozen_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
+            "spec_path": spec_rel, "spec_sha": spec_sha,
+            "rows": raw,
+            "all_row_shas": sorted(_sha(l) for l in raw),
+            "files": files,
+            "verdict": {"rc": rc, "fails": out.get("fails", [])},
+        }
+        vdir = root / "governance" / "replay" / loop_id
+        vdir.mkdir(parents=True, exist_ok=True)
+        target = vdir / "verdict.json"
+        if target.exists():
+            # 重凍=制度演進後的合法基準更新,比照 anchor approve:理由必填+留痕+歸檔不覆寫
+            if not note or not note.strip():
+                print("擋下:這個 loop 已有 golden 判定檔——重凍要帶 --note 說為什麼(比照 anchor approve,寫治理帳留痕)", file=sys.stderr)
+                return 2
+            stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M%S")
+            arch = vdir / f"verdict-{stamp}.json"
+            if arch.exists():
+                print(f"擋下:歸檔目的檔已存在({arch.name}),不覆寫歷史——等一秒再重凍", file=sys.stderr)
+                return 2
+            target.rename(arch)
+            _loop_gov_mark(env, loop_id, "replay-refreeze", note.strip())
+            print(f"  舊 golden 已歸檔 {arch.name};重凍理由已寫治理帳")
+        try:
+            target.write_text(json.dumps(verdict, ensure_ascii=False, indent=1), encoding="utf-8")
+        except OSError as e:
+            print(f"擋下:verdict 寫不進去({e}): {target}", file=sys.stderr)
+            return 2
+        print(f"✓ 已凍結 {loop_id} 的判定閉包(輪 {rid},{len(raw)} 列帳,{len(files)} 份卷證檔)"
+              f"\n    {target}")
+        return 0
+
+    # ── 回放模式 ──
+    try:
+        g = json.loads(Path(golden).read_text(encoding="utf-8"))
+    except (OSError, ValueError) as e:
+        print(f"擋下:golden 檔讀不了({e}): {golden}", file=sys.stderr)
+        return 2
+    if g.get("engine_rev") != _REPLAY_ENGINE_REV:
+        print(f"golden 過期(制度已演進:{g.get('engine_rev')} → {_REPLAY_ENGINE_REV})——"
+              f"這不是漂移;確認新制對這個 loop 的判定合理後重凍:"
+              f"lumos loop replay {loop_id} --freeze --spec {g.get('spec_path','<計劃>')} --note <理由>")
+        return 0
+    red = []
+    # ① live 帳集合分類(基準=凍結當下全列 sha 集;只凍判定輪會讓多輪 loop 恆報長大,r2 delta d-f2)
+    raw, _parsed_live = _load_rows()
+    if raw is None:
+        return 2
+    live = {_sha(l) for l in raw}
+    frozen = set(g.get("all_row_shas", []))
+    missing = frozen - live
