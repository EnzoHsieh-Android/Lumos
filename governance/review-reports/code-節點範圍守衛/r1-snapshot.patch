+    write(v4, "Systems/孤兒.md", "type: system\nstatus: done", body="# 孤兒\n")
+    _s6d = _section_of(run(v4, "doctor").stdout, "S6")
+    check("S6 沒索引時出聲", "沒有總索引" in _s6d, _s6d)
+
