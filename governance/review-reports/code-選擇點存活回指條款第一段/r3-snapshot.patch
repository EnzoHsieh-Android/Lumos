+
+def _jx_write(path, sid, classes):
+    """JaCoCo ExecutionDataWriter 的格式:header 0x01 + magic 0xC0C0 + 版本 0x1007;session 0x10;每個有探針為真的類別一個 0x11 區塊。"""
