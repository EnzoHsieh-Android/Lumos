+    讀端照樣看位元組判。類別名照 Java 的 modified UTF-8 讀(一般類別名是 ASCII,其餘照 UTF-8 加 replace)。逐區塊交 _jacoco_block。"""
+    import struct
+    b, i, out = bytes(data or b""), 0, []
+    if not b or b[0] != 0x01:
+        return None
+    try:
+        while i < len(b):
+            i = _jacoco_block(b, i + 1, b[i], out)
+            if i is None or i > len(b):
+                return None
+    except (struct.error, IndexError):
