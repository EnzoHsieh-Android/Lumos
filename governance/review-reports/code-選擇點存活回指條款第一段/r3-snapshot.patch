+
+def _jacoco_block(b, i, t, out):
+    """exec 的一個區塊(型別 t,內容從 i 起)→ 下一個區塊的位置,或 None(magic 或版本不對、不認得的區塊、探針陣列被截斷);執行資料區塊把 (類別名, 有沒有探針為真) 接進 out。"""
+    import struct
+    if t == 0x01:
+        magic, ver = struct.unpack(">HH", b[i:i + 4])
+        return i + 4 if magic == _JACOCO_MAGIC and ver == _JACOCO_VERSION else None
+    if t == 0x10:
+        return i + 2 + struct.unpack(">H", b[i:i + 2])[0] + 16
+    if t != 0x11:
+        return None
+    i += 8
+    n = struct.unpack(">H", b[i:i + 2])[0]
+    name = b[i + 2:i + 2 + n].decode("utf-8", errors="replace")
+    cnt, i = _jacoco_varint(b, i + 2 + n)
+    if cnt is None or i + (cnt + 7) // 8 > len(b):
+        return None
+    nb = (cnt + 7) // 8
+    out.append((name, any(b[i:i + nb])))
+    return i + nb
