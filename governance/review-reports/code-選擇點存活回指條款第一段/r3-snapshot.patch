+import struct as _jx_struct
+
+
+def _jx_utf(s):
+    e = s.encode("utf-8")
+    return _jx_struct.pack(">H", len(e)) + e
+
+
+def _jx_vint(v):
+    out = b""
+    while v & ~0x7F:
+        out += bytes([0x80 | (v & 0x7F)])
+        v >>= 7
+    return out + bytes([v])
+
+
+def _jx_bools(a):
+    out, buf, n = _jx_vint(len(a)), 0, 0
+    for x in a:
+        if x:
+            buf |= 1 << n
+        n += 1
+        if n == 8:
+            out += bytes([buf])
+            buf, n = 0, 0
+    return out + (bytes([buf]) if n else b"")
