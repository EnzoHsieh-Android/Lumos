+def _choice_cov_exec_classes(data):
+    """JaCoCo 覆蓋資料檔(exec 二進位格式,org.jacoco.core.data.ExecutionDataWriter / ExecutionDataReader:區塊 0x01 header = magic 0xC0C0 + 版本 0x1007、
+    0x10 session = UTF 編號 + 兩個 long、0x11 執行資料 = long 類別編號 + UTF 類別名 + 探針陣列(varint 長度 + 每 8 個探針一個位元組,低位元先))
