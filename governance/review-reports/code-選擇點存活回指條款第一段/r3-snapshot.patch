+    import types
+    cb = object.__new__(m._KillCovBase)
+    prep = types.SimpleNamespace(remaining=lambda: remaining, interrupted=False, state={}, _cache_path=lambda plat, n: None)
+    c = types.SimpleNamespace(pentry={"profile": {"name_filter": "ident"}, "root": tempfile.gettempdir()}, coll_cache={}, plat="kotlin-junit",
+                              run_dir=tempfile.gettempdir(), mstate={}, scratch=tempfile.gettempdir())
+    cb.prep, cb.c, cb.names, cb.meth, cb.pkgs = prep, c, list(names), dict(meth), [""]
+    cb.why, cb.got, cb.seen, cb.wrapped = {n: "" for n in names}, {}, [], {}
+    cb.tripped, cb.trip_why, cb.red_streak, cb.full = False, "", 0, 600.0
+    cb._cmd = {n: "true" for n in names}
+    return cb
