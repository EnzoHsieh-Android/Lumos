+    """平台原始碼的套件資料夾(斜線分隔,例 lab/splitbook):工作樹裡 src/<集合>/(java|kotlin)/ 底下的 .kt/.java 所在資料夾,集合名以 test、androidTest 開頭的不算。"""
+    try:
+        r = subprocess.run(["git", "-C", str(wt), "ls-files", "-z"], capture_output=True, timeout=_KILL_GIT_TIMEOUT * 3)
+    except (OSError, subprocess.TimeoutExpired):
+        return set()
+    out = set()
+    for f in r.stdout.decode("utf-8", errors="replace").split("\0"):
+        m = re.search(r"(?:^|/)src/([^/]+)/(?:java|kotlin)/(.+)/[^/]+\.(?:kt|java)$", f)
+        if m and not m.group(1).startswith(("test", "androidTest")):
+            out.add(m.group(2))
+    return out
+
+
+def _choice_cov_exec_path(c, shape):
+    """AGP 固定位置的覆蓋資料檔 → (真實路徑, 變體名小寫開頭) 或 None:合併形狀的單元測試任務要是 test<變體>UnitTest(只有它會產 exec),
+    位置 <-p 的值>/<模組>/build/outputs/unit_test_code_coverage/<變體>UnitTest/test<變體>UnitTest.exec;不在工作樹裡(圍欄同 _choice_merge_results_dir)→ None。"""
+    if shape is None:
+        return None
+    m = re.fullmatch(r"test([A-Z][A-Za-z0-9]*)UnitTest", shape["task"])
+    if not m:
+        return None
+    v = m.group(1)
+    var = v[0].lower() + v[1:]
+    base = _under_root(c.run_dir, shape["pdir"]) if shape["pdir"] else Path(c.run_dir)
+    real = os.path.realpath(str(Path(base, *shape["parts"], "build", "outputs", "unit_test_code_coverage", f"{var}UnitTest", f"test{v}UnitTest.exec")))
+    return (real, var) if real.startswith(os.path.realpath(str(c.wt)) + os.sep) else None
+
+
+def _choice_cov_analyze_cmd(run_cmd, shape, init, manifest):
+    """分析那次 Gradle 呼叫的指令:run_cmd 拿掉 --tests 那一段、單元測試任務換成同模組的 lumosCovAnalyze,接上分析初始化腳本與清單路徑;
+    任務字樣在 --tests 之前找不到 → None(不做,全部算分析失敗)。"""
+    cmd = str(run_cmd)
+    head, tail = cmd[:shape["s"]], cmd[shape["e"]:]
+    if not shape["eq"]:
+        head = re.sub(r"--tests\s+$", "", head)
+    mod = ":".join(shape["parts"])
+    pat = re.compile(r"(?<!\S):?" + re.escape(mod) + ":" + re.escape(shape["task"]) + r"(?!\S)")
+    if not pat.search(head):
+        return None
+    head = pat.sub(lambda _m: f":{mod}:lumosCovAnalyze", head, count=1)
+    return (_run_cmd_expand(head).rstrip() + " --init-script " + _cmd_arg_quote(str(init)) + " "
+            + _cmd_arg_quote("-PlumosCovManifest=" + str(manifest)) + _run_cmd_expand(tail))
+
+
+def _choice_cov_dir(rr, at_sha):
+    """續跑快取資料夾 <工作目錄>/choice-cov/<at_sha>/(〈範圍〉2 續跑快取、工作目錄):擴充 _note_audit_work_dir 那套(符號連結拒用、自帶 .gitignore)到子資料夾;
+    建好後清檔:choice-cov/ 底下只留最近 _CHOICE_COV_KEEP 個 at_sha(依修改時間,這次的先碰一下排最新;符號連結本身不跟、不刪)。拿不到 → None(這次不續跑)。"""
+    import shutil
+    wd, _why = _note_audit_work_dir(rr)
+    if wd is None or not re.fullmatch(r"[0-9a-fA-F]{7,64}", str(at_sha)):
+        return None
+    top, _why = _note_audit_safe_dir(rr, f"{_NOTE_AUDIT_WORK_DIR}/choice-cov")
+    d, _why = _note_audit_safe_dir(rr, f"{_NOTE_AUDIT_WORK_DIR}/choice-cov/{at_sha}") if top is not None else (None, "")
+    if d is None:
+        return None
+    try:
+        os.utime(d)
+        subs = sorted((x for x in top.iterdir() if x.is_dir() and not x.is_symlink()), key=lambda x: x.stat().st_mtime, reverse=True)
+    except OSError:
+        return d
+    for x in subs[_CHOICE_COV_KEEP:]:
+        if x != d:
+            shutil.rmtree(x, ignore_errors=True)
+    return d
+
+
+def _choice_cov_req(rr, x, i):
+    """一個壞法行交給分析的那一筆 → {"i", "file", "pkg", "src", "first", "last", "exc"}:壞法改的行範圍(old 在檔裡的位置起、old 與 new 逐行比不同的那幾行)、
+    package 宣告(斜線分隔)、原始檔名、覆蓋例外(_choice_cov_exception)。檔讀不到或 old 對不到時範圍就是那一行。"""
+    ident = x["mutant"]["identity"]
+    try:
+        text = (Path(rr) / x["file"]).read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError):
+        text = ""
+    first = last = int(x["line"])
+    at = text.find(ident["old"]) if text else -1
+    ol, nl = ident["old"].split("\n"), ident["new"].split("\n")
+    if at >= 0 and len(ol) == len(nl):
+        diff = [k for k, (a, b) in enumerate(zip(ol, nl)) if a != b]
+        if diff:
+            start = text.count("\n", 0, at) + 1
+            first, last = start + diff[0], start + diff[-1]
+    m = re.search(r"(?m)^\s*package\s+([\w.]+)", text)
+    lines = text.split("\n")
+    line = lines[x["line"] - 1] if 0 < x["line"] <= len(lines) else ""
+    return {"i": i, "file": x["file"], "pkg": m.group(1).replace(".", "/") if m else "", "src": x["file"].rsplit("/", 1)[-1],
+            "first": first, "last": last, "exc": _choice_cov_exception(x.get("decl"), line)}
+
+
+class _KillPrep:
+    """cmd_guard_kill 的選用參數 prep(Projects/選擇點存活回指條款_計劃〈用詞〉準備物件;形狀同 _KillMerge):choice-kill 建它、傳進去,guard-kill 在每個平台組
+    建好隔離工作樹、跑任何配方之前呼叫 run(現場) 一次(跟合併快篩開不開無關)。這一段做 ② 覆蓋基準(_kill_measure_singles 加覆蓋初始化腳本,結果進
+    guard-kill 的基準快取)、③ 斷路器、④ 一次 Gradle 呼叫的分析、⑥ 回傳依覆蓋選過的配方並呼叫 on_done(平台, {group: 那一行在這個平台組的分類});
+    ① 合批編譯檢查與 ⑤ 抽查是第二段的事,這裡沒有(_lines 之前與之後是它們的位置)。
+    帶進去:deadline(總時限的期限,monotonic)、cov(開了覆蓋的平台集合)、req({group: _choice_cov_req 那一筆})、on_done、cache(續跑快取資料夾或 None)、
+    blob_of({(平台, 測試名): 測試所在檔物件編號},續跑快取的鍵)。帶出來:state({平台: on|tripped|off})、secs(花的秒數)、interrupted(第一個訊號來過)。"""
+
+    def __init__(self, deadline, cov, req, on_done, cache=None, blob_of=None):
+        self.deadline, self.cov, self.req, self.on_done = deadline, set(cov), dict(req), on_done
+        self.cache, self.blob_of = cache, dict(blob_of or {})
+        self.state, self.secs, self.interrupted = {}, 0.0, False
+
+    def remaining(self):
+        return self.deadline - time.monotonic()
+
+    def on_signal(self):
+        """第一個終止訊號:當場收掉帶「合併」標記的程序群組(覆蓋基準、分析這兩種呼叫帶這個標記;收的方式同 _KillMerge.on_signal)。"""
+        self.interrupted = True
+        for proc in list(_KILL_RUN_LIVE.values()):
+            if getattr(proc, "_lumos_merge", False):
+                _kill_proc_group(proc)
+
+    def run(self, c):
+        """一個平台組 → 這組要跑的配方(依覆蓋選過);途中收到訊號丟 _KillHalt(guard-kill 照現在停,不寫 reach)。"""
+        t0 = time.monotonic()
+        try:
+            lines = self._lines(c)
+        finally:
+            self.secs += time.monotonic() - t0
+        self.on_done(c.plat, lines)
+        return [r for r in c.plist if r.get("group") not in lines or r.get("test") in lines[r["group"]]["keep"]]
+
+    def _lines(self, c):
+        """{group: {"cls": clause|none|unknown, "why", "keep": 要跑的測試名集合, "pass": 經過的測試名集合}}(〈用詞〉覆蓋分類、依覆蓋選測試;平台組這一層)。"""
+        by = {}
+        for r in c.plist:
+            by.setdefault(r.get("group"), [])
+            if r.get("test") not in by[r.get("group")]:
+                by[r.get("group")].append(r.get("test"))
+        names = list(dict.fromkeys(n for ns in by.values() for n in ns))
+        why, hits, nolines = self._measure(c, names, [g for g in by if g in self.req])
+        out = {}
+        for g, ns in by.items():
+            if g not in self.req:
+                continue
+            w = self.req[g]["exc"] or next((why[n] for n in ns if why.get(n)), "") or ("這一行沒有指令紀錄" if g in nolines else "")
+            if w:
+                out[g] = {"cls": "unknown", "why": w, "keep": set(ns), "pass": set()}
+                continue
+            ps = {n for n in ns if g in hits.get(n, ())}
+            out[g] = {"cls": "clause" if ps else "none", "why": "", "keep": ps, "pass": ps}
+        return out
+
+    def _cache_path(self, plat, name):
+        sig = self.blob_of.get((plat, name))
+        if self.cache is None or not sig or _CHOICE_TESTS_UNKNOWN in str(sig):
+            return None
+        return os.path.join(str(self.cache), _choice_sha(f"{plat}\n{name}\n{sig}\n{_CHOICE_COV_INIT_VER}", 24) + ".exec")
+
+    def _measure(self, c, names, groups):
+        """覆蓋基準與分析 → (每支測試不明的原因 {名: 原因或空字串}, {名: 經過的 group 集合}, 沒有指令紀錄的 group 集合)。
+        步驟:接得起來嗎(_CovBase.start)→ 續跑快取(cached)→ 量覆蓋基準(_kill_measure_singles 帶 wrap、after)→ 收尾補原因(settle)→ 分析(_analyze)。"""
+        if c.plat not in self.cov:
+            self.state.setdefault(c.plat, "off")
+            return {n: "沒開覆蓋" for n in names}, {}, set()
+        self.state[c.plat] = "on"
+        cb = _CovBase.start(self, c, names)
+        if cb is None:
+            print(f"⚠ {_kill_esc(c.plat)}:這次接不起逐測試覆蓋(run_cmd 要是帶模組的 test<變體>UnitTest 任務),壞法跑全部守的測試", file=sys.stderr)
+            return {n: "覆蓋接不起來" for n in names}, {}, set()
+        todo = cb.cached()
+        _kill_measure_singles(c, todo, cb.cmd_of(todo), self.remaining, wrap=cb.wrap, after=cb.after)
+        cand = cb.settle()
+        if not cand:
+            return cb.why, {}, set()
+        hits, nolines, bad = self._analyze(c, cb.shape, cb.variant, cand, cb.got, groups)
+        for n in cand if bad else ():
+            cb.why[n] = bad
+        return cb.why, hits, nolines
+
+    def _analyze(self, c, shape, variant, cand, got, groups):
+        """④ 一次 Gradle 呼叫在 Gradle 程序裡用 JaCoCo 分析 API 讀 cand 的覆蓋資料檔 → ({名: 經過的 group 集合}, 沒有指令紀錄的 group 集合, 失敗原因或空字串)。
+        逾時 max(60, 支數 × 0.5) 秒,剩下的時間不夠就不做(時間不夠);帶當場收的標記。"""
+        import json
+        cap = max(60.0, len(cand) * 0.5)
+        if self.remaining() < cap:
+            return {}, set(), "時間不夠"
+        idx = {g: k for k, g in enumerate(groups)}
+        out = os.path.join(c.scratch, "lumos-cov-out.json")
+        man = os.path.join(c.scratch, "lumos-cov-manifest.json")
+        ainit = os.path.join(c.scratch, _CHOICE_COV_ANALYZE_NAME)
+        try:
+            with open(ainit, "w", encoding="utf-8") as fh:
+                fh.write(_CHOICE_COV_ANALYZE)
+            with open(man, "w", encoding="utf-8") as fh:
+                json.dump({"variant": variant, "out": out, "execs": [[k, got[n]] for k, n in enumerate(cand)],
+                           "mutants": [{k2: v for k2, v in dict(self.req[g], i=idx[g]).items() if k2 != "exc"} for g in groups]}, fh)
+            if os.path.exists(out):
+                os.unlink(out)
+        except OSError:
+            return {}, set(), "分析失敗"
+        acmd = _choice_cov_analyze_cmd(c.run_cmd, shape, ainit, man)
+        if acmd is None:
+            return {}, set(), "分析失敗"
+        rc, _tail, _el, to = _kill_run(acmd, c.run_dir, cap, merge=self)
+        c.mstate["r"] = int(time.time())
+        if self.interrupted:
+            raise _KillHalt()
+        raw = _choice_cov_read(out)
+        try:
+            doc = json.loads(raw) if raw is not None and rc == 0 and not to else None
+        except ValueError:
+            doc = None
+        if not isinstance(doc, dict) or not isinstance(doc.get("hits"), dict):
+            return {}, set(), "分析失敗"
+        back = {k: g for g, k in idx.items()}
+        hits = {}
+        for k, n in enumerate(cand):
+            v = doc["hits"].get(str(k))
+            hits[n] = {back[i] for i in v if type(i) is int and i in back} if isinstance(v, list) else set()
+        nol = doc.get("nolines") if isinstance(doc.get("nolines"), list) else []
+        return hits, {back[i] for i in nol if type(i) is int and i in back}, ""
+
+
+class _CovBase:
+    """_KillPrep 一個平台組的覆蓋基準現場(〈範圍〉2 ② ③;從 _KillPrep._measure 依步驟拆出):why {名: 不明原因}、got {名: 覆蓋資料檔}、
+    seen(算進斷路器的專案類別有紀錄數)、wrapped {名: 這次有沒有掛覆蓋}、tripped(斷路了)、red(掛覆蓋紅的 Robolectric 支數,不算進斷路器)。"""
+
+    def __init__(self, prep, c, names, shape, ep, variant, init):
+        self.prep, self.c, self.names, self.shape, self.ep, self.variant, self.init = prep, c, names, shape, ep, variant, init
+        self.nf = c.pentry["profile"].get("name_filter", "ident")
+        self.meth = {n: _kill_method_name(n, c.pdata) for n in names}
+        self.robo, self.pkgs = _choice_cov_robo(c.wt, list(self.meth.values())), _choice_cov_pkg_dirs(c.wt)
+        self.why, self.got, self.seen, self.wrapped = {n: "" for n in names}, {}, [], {}
+        self.tripped, self.red, self.full = False, 0, max(600.0, c.floor)
+        self.n_robo = sum(1 for n in names if self.robo[self.meth[n]])
+        self._cmd = {}
+
+    @classmethod
+    def start(cls, prep, c, names):
+        """接得起覆蓋嗎:單元測試任務是 test<變體>UnitTest、AGP 覆蓋資料檔在工作樹裡、初始化腳本寫得進 scratch → 現場,否則 None。"""
+        shape = _choice_merge_shape(c.run_cmd)
+        ep = _choice_cov_exec_path(c, shape)
+        init = os.path.join(c.scratch, _CHOICE_COV_INIT_NAME) if c.scratch else None
+        if ep is None or init is None:
+            return None
+        try:
+            with open(init, "w", encoding="utf-8") as fh:
+                fh.write(_CHOICE_COV_INIT)
+        except OSError:
+            return None
+        return cls(prep, c, names, shape, ep[0], ep[1], init)
+
+    def cmd_of(self, todo):
+        """不加覆蓋的單支指令(guard-kill 基準快取的鍵)。"""
+        self._cmd = {n: _run_cmd_expand(self.c.run_cmd, self.meth[n], name_filter=self.nf) for n in todo}
+        return self._cmd
+
+    def breaker(self, n, cnt):
+        """③ 斷路器:前 _CHOICE_COV_BREAKER 支 Robolectric 測試(不足就是全部;掛覆蓋紅的不算)的專案類別有紀錄數都是 0 → 當場停止掛覆蓋。"""
+        if cnt is not None and self.robo[self.meth[n]] and not self.tripped:
+            self.seen.append(cnt)
+        need = min(_CHOICE_COV_BREAKER, self.n_robo - self.red)
+        if self.tripped or need <= 0 or len(self.seen) < need or any(self.seen[:need]):
+            return
+        self.tripped = True
+        self.prep.state[self.c.plat] = "tripped"
+        print(f"⚠ {_kill_esc(self.c.plat)}:覆蓋斷路——前 {need} 支 Robolectric 測試的覆蓋資料裡專案類別有紀錄數都是 0(覆蓋設定沒生效),"
+              "其餘測試不再掛覆蓋,這次壞法都跑全部守的測試", file=sys.stderr)
+
+    def take(self, n, data, dst):
+        """一份覆蓋資料檔已經在 dst(或 dst 是 None:存不下來):記 got、數專案類別;Robolectric 的 0 是設定沒生效,不是沒碰專案類別(非 Robolectric 的 0 是真的)。
+        → 專案類別有紀錄數或 None(交斷路器)。"""
+        cnt = _choice_cov_proj_hits(data, self.pkgs) if data is not None else None
+        if dst is None or cnt is None:
+            self.why[n] = "覆蓋資料沒產出"
+            return None
+        self.got[n] = dst
+        if cnt == 0 and self.robo[self.meth[n]]:
+            self.why[n] = "覆蓋接不起來"
+        return cnt
+
+    def cached(self):
+        """續跑快取:同一個 at_sha、同一支測試與所在檔、同一版初始化腳本的覆蓋資料檔直接取用(分析每次重做)→ 還要量的測試名清單。"""
+        todo = []
+        for n in self.names:
+            cp = self.prep._cache_path(self.c.plat, n)
+            if cp and os.path.isfile(cp):
+                self.breaker(n, self.take(n, _choice_cov_read(cp), cp))
+            else:
+                todo.append(n)
+        return todo
+
+    def wrap(self, n, cmd):
+        """量一支之前:斷路了就不掛;否則刪掉 AGP 固定位置的覆蓋資料檔(跑完沒有新檔就是這支沒產出,不會讀到上一支的)、掛覆蓋初始化腳本、帶當場收的標記。"""
+        if self.tripped:
+            self.wrapped[n] = False
+            return cmd, None
+        try:
+            os.unlink(self.ep)
+        except FileNotFoundError:
+            pass
+        except OSError:
+            self.wrapped[n] = False
+            self.why[n] = "覆蓋資料沒產出"
+            return cmd, None
+        self.wrapped[n] = True
+        return _choice_merge_cmd(self.c.run_cmd, self.shape, [self.meth[n]], self.nf, init=self.init), self.prep
+
+    def after(self, n, res, cap):
+        """量完一支:收到訊號就停;掛了覆蓋而紅 → red_rerun;綠 → 複製覆蓋資料檔、數專案類別、交斷路器。回傳寫進基準快取的那一份。"""
+        if self.prep.interrupted:   # 第一個訊號當場收掉了這次呼叫(S7):不記基準、停
+            raise _KillHalt()
+        if not self.wrapped.get(n):
+            return res
+        if res[3] or res[0] != 0:
+            return self.red_rerun(n, res, cap)
+        data = _choice_cov_read(self.ep)
+        if data is None:
+            self.why[n] = "覆蓋資料沒產出"
+            return res
+        self.breaker(n, self.take(n, data, self.store(n, data)))
+        return res
+
+    def store(self, n, data):
+        """覆蓋資料檔存進續跑快取(沒有快取就放 scratch;暫存再原子換名)→ 路徑或 None。"""
+        dst = self.prep._cache_path(self.c.plat, n) or os.path.join(self.c.scratch, f"lumos-cov-{len(self.got)}.exec")
+        try:
+            with open(dst + ".tmp", "wb") as fh:
+                fh.write(data)
+            os.replace(dst + ".tmp", dst)
+        except OSError:
+            return None
+        return dst
+
+    def red_rerun(self, n, res, cap):
+        """掛覆蓋紅:被剩下時限截斷就記時間不夠、照回;否則不掛再跑一次,綠就用這次當基準、覆蓋算不明(掛覆蓋才紅),紅記基準不綠;紅的不算進斷路器。"""
+        if res[3] and cap < self.full:
+            self.why[n] = "時間不夠"
