 def _codeloop_pass_choice(repo_root, head_sha, branch):
     """code-loop pass 記通過之前的選擇點預判(Projects/代碼審通過前自動跑選擇點_計劃)→ 放不放行。不跑測試:照推送前掛鉤會給的輸入
     (遠端舊值=本機追蹤的遠端分支,沒有就當新分支首推)模擬一次推送,交給推送前那一圈同一支判定(site="pass":帳讀工作目錄、事件帶 site)。
     訊息照推送前原樣(同 _codeloop_pass_mech),最後補 pass 自己的出口。不是 Kotlin 專案直接放行不印字;
-    detached HEAD、沒有遠端 → 印一行、留給推送前判。擋下:記 code-loop-pass 擋下(blocks 帶 choice)。"""
+    detached HEAD、沒有遠端、多個遠端判不出哪個 → 印一行、留給推送前判。擋下:記 code-loop-pass 擋下(blocks 帶 choice)。"""
     rr = Path(repo_root)
     if not _choice_push_has_kotlin(rr):
         return True
     P = "[code-loop pass 選擇點]"
     name, tip = _redbase_branch_name(rr), _lens_full_sha(rr, "HEAD")
     if not name or not tip:
         print(f"{P} 沒有分支(detached HEAD),選擇點留給推送前判")
         return True
     remote = _lens_default_remote(rr, None, None)
-    if not remote:
-        print(f"{P} 沒有遠端,選擇點留給推送前判")
+    if not remote:   # 共用取法只認分支上游、origin、或唯一一個遠端;多個遠端又都不是時要講清楚(代碼審 code-pass選擇點預判 r2 c2)
+        r = _lens_git(rr, "remote")
+        n = len(r.stdout.split()) if r is not None and r.returncode == 0 else 0
+        if not n:
+            print(f"{P} 沒有遠端,選擇點留給推送前判")
+        else:
+            print(f"{P} 有 {n} 個遠端、沒有 origin、分支也沒設上游,判不出要比對哪個遠端,選擇點留給推送前判"
+                  f"(要在 pass 就預判:git config branch.{name}.remote <遠端名>)")
         return True
     old = _lens_full_sha(rr, f"refs/remotes/{remote}/{name}") or "0" * len(tip)
     bad = _choice_push_round(None, rr, f"{old}..{tip}", (remote, f"refs/heads/{name}"), site="pass")
     if not bad:
         return True
     for x in bad:
         print(f"    • {x}")
     print(f"{P} {_CHOICE_PASS_TAIL}")
     print("代碼審還不能記通過:選擇點有行沒有有效處置(跟推送前同一份判定;不跑測試)。照上面處置後重跑:", file=sys.stderr)
     print('    lumos code-loop pass --loop <編號> --note "<審了什麼>"', file=sys.stderr)
