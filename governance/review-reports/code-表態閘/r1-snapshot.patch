+    回 (text, truncated)。"""
+    ti = payload.get("tool_input") or {}
+    tool = payload.get("tool_name", "")
+    parts: list[str] = []
+    if tool == "Edit":
+        parts = [str(ti.get("old_string") or ""), str(ti.get("new_string") or "")]
+    elif tool == "MultiEdit":
