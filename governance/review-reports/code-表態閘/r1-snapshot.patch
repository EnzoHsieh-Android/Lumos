+def extract_delta_text(payload: dict, cap_bytes: int = DELTA_TEXT_CAP):
+    """表態閘 S3(r3 外家 F10/正確性席 C2/接手席 H5):把「這次編輯的原始內容」保留換行送給 lumos 逐行比對 when。
