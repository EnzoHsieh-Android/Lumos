+def _dgv_run(root):
+    """跑一次 delguard --staged --json → (命中的名稱, delguard 治理事件, staged diff, 原始輸出)。"""
+    import subprocess as _sp, json as _j
+    r = _sp.run([sys.executable, GRAPHCTL, "delguard", "--staged", "--json"], cwd=str(root), capture_output=True, text=True,
+                timeout=120)
+    log = root / "docs" / ".governance-log.jsonl"
+    rows = [_j.loads(x) for x in log.read_text(encoding="utf-8").splitlines() if x.strip()] if log.exists() else []
+    try:
+        out = _j.loads(r.stdout.strip().splitlines()[-1])
+    except Exception:
+        out = {}
+    toks = {t for h in out.get("hits", []) for t in h["tokens"]}
+    diff = _nh_git(root, "diff", "--cached", "-M").stdout
+    return toks, [x for x in rows if x.get("gate") == "delguard"], diff, r.stdout + r.stderr
+
+
+def _dgv_repo(toolchain=False, manifest=True, names=("zzVendoredOnlyFn", "zzProjectFn", "zzOwnHookFn", "zzUserGuardFn")):
+    """刪除守衛跳過工具自裝檔的測試專案:scripts/lumos(工具檔,安裝時原樣)、scripts/hooks/pre-push(工具檔,專案自己改過:
+    多了 zzUserGuardFn)、src/m.py 與 scripts/hooks/own_hook.py(專案自己的檔);圖譜提到這幾個名稱。
+    manifest=True 時 .lumos/vendored.json 記的是安裝時的指紋(pre-push 記的是改之前那份)。"""
+    import tempfile as _tf, json as _j
+    m = _load_lumos_inproc()
+    root = Path(_tf.mkdtemp(prefix="gctl-dgvend-"))
+    vault = root / "docs" / "x-knowledge"
+    (vault / "Systems").mkdir(parents=True)
+    (vault / "Systems" / "a.md").write_text("---\nname: a\n---\n# a\n呼叫 " + " 與 ".join(names) + "。\n", encoding="utf-8")
+    hook0 = "#!/bin/sh\necho installed hook\n"
+    _nh_file(root, "scripts/lumos", "def zzVendoredOnlyFn():\n    return 1\n")
+    _nh_file(root, "scripts/hooks/pre-push", hook0 + "zzUserGuardFn() { :; }\nzzUserOther=1\n")
+    _nh_file(root, "src/m.py", "def zzProjectFn():\n    return 1\n")
+    _nh_file(root, "scripts/hooks/own_hook.py", "def zzOwnHookFn():\n    return 1\n")
+    if toolchain:
+        _nh_file(root, "skills/lumos-project-notes/SKILL.md", "# skill\n")
+    if manifest:
+        _nh_file(root, ".lumos/vendored.json", _j.dumps({"version": 1, "files": {
+            "scripts/lumos": m._vendored_digest("def zzVendoredOnlyFn():\n    return 1\n".encode()),
+            "scripts/hooks/pre-push": m._vendored_digest(hook0.encode())}}) + "\n")
+    _nh_git(root, "init", "-q")
+    _nh_git(root, "add", "-A")
+    _nh_git(root, "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "i")
+    return root, hook0
+
+
+def _dgv_update_lumos(root):
+    """模擬 lumos update:工具檔換成新版,安裝清單的指紋跟著換(內容跟清單一致=原封不動)。"""
+    import json as _j
+    m = _load_lumos_inproc()
+    _nh_file(root, "scripts/lumos", "x = 1\n")
+    mp = root / ".lumos" / "vendored.json"
+    if mp.exists():
+        man = _j.loads(mp.read_text(encoding="utf-8"))
+        man["files"]["scripts/lumos"] = m._vendored_digest(b"x = 1\n")
+        mp.write_text(_j.dumps(man) + "\n", encoding="utf-8")
+
+
