 29373	def _delguard_parse_diff(diff_text, graph_root, vendored_skip=frozenset()):
 29374	    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
 29375	    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
 29376	    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
 29377	    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
 29378	    2026-08-11 code-loop r1 C);stopword 表剔除;
 29379	    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
 29380	    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
 29381	    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
 29382	    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
 29383	    vendored_skip:這幾支(精確路徑)不看——消費專案裡原封不動的工具自裝檔(漂移修法補強 第 5 節,呼叫端決定給不給);
 29384	    跟 _DELGUARD_* 排除清單分開(那份有 t_precommit_whitelist_drift_guard 釘著)。
 29385	    ★改名時兩側分開判斷★(代碼審 r1 外家 finder 席、資安席):`-` 行照 a/ 來源路徑(`rename from`),`+` 行照 b/ 目的路徑——
 29386	    只看 b/ 的話,專案自己的 src/app.py 改名成 scripts/lumos 就能讓刪掉的名稱整支被跳過。
 29387	    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
 29388	        ,"vault_diffs": {path: [line...]}
 29389	        ,"vendored_skipped": [path...]}  # 真的有 `-` 行因此被跳過的工具檔(來源路徑;只碰到、只有新增的不算)"""
 29390	    lines = diff_text.splitlines()
 29391	    added = _delguard_added_tokens(lines, graph_root, vendored_skip)
 29392	    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
 29393	    tokens, seen, skipped = [], set(), []
 29394	    vault_diffs, cur, src, is_vault, is_excl, in_binary, in_head = {}, None, None, False, False, False, False
 29395	    for ln in lines:
 29396	        if ln.startswith("diff --git"):
 29397	            cur, is_vault, is_excl = _delguard_path_flags(ln, graph_root)
 29398	            src, in_binary, in_head = cur, False, True
 29399	        elif in_head and ln.startswith("rename from "):
 29400	            src = ln[len("rename from "):]
 29401	        elif ln.startswith("@@"):
 29402	            in_head = False
 29403	        elif ln.startswith("Binary files"):
 29404	            in_binary = True
 29405	        elif in_binary or cur is None or _delguard_is_diff_header(ln) or not ln.startswith(("+", "-")):
 29406	            continue
 29407	        elif is_vault:
 29408	            vault_diffs.setdefault(cur, []).append(ln)
 29409	        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
 29410	        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
 29411	        # (r2 code-loop 折入:N5)
 29412	        elif not (is_excl or cur.endswith(".md")) and ln.startswith("-"):
 29413	            if src in vendored_skip:
 29414	                skipped += [] if src in skipped else [src]
 29415	            else:
 29416	                _delguard_take_removed(ln, added.get(cur) or frozenset(), seen, tokens)
 29417	    return {"tokens": tokens, "vault_diffs": vault_diffs, "vendored_skipped": skipped}
