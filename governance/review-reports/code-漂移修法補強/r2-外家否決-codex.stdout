+def t_delguard_vendored_rename_and_count():
+    """[S5] 代碼審 r1 折入:改名時 `-` 行照來源路徑(a/)判斷要不要跳、`+` 行照目的路徑(b/);vendored-skip 只算真的有
+    `-` 行被跳過的檔。
+    - 工具檔改名離開(scripts/lumos → src/old-lumos):來源已不在工作目錄 → 不算原封不動 → 照抽(寧可多掃,刻意的)。
+    - 專案自己的檔改名成工具檔名(src/app.py → scripts/lumos):`-` 行來源是 src/app.py → 照抽(外家 finder、資安席)。
+    - 第一遍(收 `+` 行回收表)照目的路徑跳:改名進工具檔名時,`+` 行不回收 `-` 行的名稱。
+    翻紅釘:`-` 行改回照目的路徑判斷 → ③紅;第一遍不跳 → ④紅;只要碰到就記(不管有沒有 `-` 行)→ ⑤紅;
+    解析不認 rename from → ②紅。
+    """
+    print("t_delguard_vendored_rename_and_count")
+    m = _load_lumos_inproc()
+    gr = "docs/x-knowledge"
+    skip = frozenset({"scripts/lumos"})
+    # ①②端到端:工具檔(安裝時原樣)改名離開、同時刪掉一個函式
+    root, _hook0 = _dgv_repo(names=("zzVendoredGone",))
+    _nh_file(root, "scripts/lumos", "def zzVendoredGone():\n    return 1\n\n" + "".join(f"k{i} = {i}\n" for i in range(30)))
+    man = root / ".lumos" / "vendored.json"
+    import json as _j
+    mj = _j.loads(man.read_text(encoding="utf-8"))
+    mj["files"]["scripts/lumos"] = m._vendored_digest((root / "scripts" / "lumos").read_bytes())
+    man.write_text(_j.dumps(mj) + "\n", encoding="utf-8")
+    _nh_git(root, "add", "-A")
+    _nh_git(root, "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "installed")
+    check("①前置:改名前 scripts/lumos 是原封不動的工具檔", "scripts/lumos" in m._vendored_state(str(root))[0], "")
+    (root / "src").mkdir(exist_ok=True)
+    _nh_git(root, "mv", "scripts/lumos", "src/old-lumos")
+    _nh_file(root, "src/old-lumos", "".join(f"k{i} = {i}\n" for i in range(30)))
+    _nh_git(root, "add", "-A")
+    toks, rows, diff, raw = _dgv_run(root)
+    check("①前置:diff 是改名(rename from scripts/lumos)而且刪了 zzVendoredGone", "rename from scripts/lumos" in diff
+          and "rename to src/old-lumos" in diff and "-def zzVendoredGone" in diff, diff[:400])
+    check("②工具檔改名離開:來源不在工作目錄、不算原封不動 → 照抽、note 不帶跳過", "zzVendoredGone" in toks and rows
+          and "vendored-skip" not in rows[-1].get("note", ""), raw + str(rows))
+    ren_in = ("diff --git a/src/app.py b/scripts/lumos\nsimilarity index 80%\nrename from src/app.py\nrename to scripts/lumos\n"
+              "--- a/src/app.py\n+++ b/scripts/lumos\n@@ -1,3 +1,2 @@\n-def zzSecretThing():\n-def keepMe(a):\n+def keepMe(a, b):\n"
+              " x = 1\n")
+    p = m._delguard_parse_diff(ren_in, gr, skip)
+    check("③專案自己的檔改名成工具檔名:`-` 行照來源路徑 src/app.py 判斷 → 照抽、不記跳過",
+          "zzSecretThing" in p["tokens"] and p["vendored_skipped"] == [], str(p))
+    check("④第一遍照目的路徑跳:工具檔名那側的 `+` 行不回收 `-` 行的名稱(keepMe 照抽)", "keepMe" in p["tokens"], str(p))
+    ren_out = ("diff --git a/scripts/lumos b/src/old-lumos\nsimilarity index 90%\nrename from scripts/lumos\n"
+               "rename to src/old-lumos\n--- a/scripts/lumos\n+++ b/src/old-lumos\n@@ -1,2 +1 @@\n-def zzVendoredGone():\n x = 1\n")
+    q = m._delguard_parse_diff(ren_out, gr, skip)
+    check("②解析:來源路徑在跳過清單上時照來源跳、記來源路徑(端到端不跳是因為來源已不在、不算原封不動)",
+          q["tokens"] == [] and q["vendored_skipped"] == ["scripts/lumos"], str(q))
+    only_add = ("diff --git a/scripts/lumos b/scripts/lumos\n--- a/scripts/lumos\n+++ b/scripts/lumos\n@@ -1 +1,2 @@\n x = 1\n"
+                "+def zzNew():\n")
+    r = m._delguard_parse_diff(only_add, gr, skip)
+    check("⑤工具檔只有新增、沒有 `-` 行:不算跳過(vendored-skip 只數真的跳過刪除行的檔)", r["vendored_skipped"] == [], str(r))
+
+
