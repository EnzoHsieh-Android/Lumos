 29420	def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
 29421	    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
 29422	    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
 29423	    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
 29424	    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
 29425	    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
 29426	    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
 29427	    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
 29428	    import re, subprocess
 29429	    if not tokens:
 29430	        return {}
 29575	        # standalone vault repo(整個 repo 就是 vault,graph_root=".")→ 沒有 code 側可守,
 29576	        # 且 "." 前綴會讓每個檔都判成 vault、路徑相對計算全歪 → 靜默 rc0(2026-08-11 code-loop r1 E)
 29577	        if gr_rel == ".":
 29578	            return 0
 29579	        # diff 前綴固定:使用者 ~/.gitconfig 若設 diff.noprefix / diff.mnemonicPrefix,
 29580	        # 檔頭會變成 `--- app/x` 或 `--- i/app/x`,` b/` 抽檔名整條失效 → token 全漏(r1 D)
 29581	        r = subprocess.run(["git", "-c", "core.quotePath=off",
 29582	                            "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
 29583	                            "diff", "--no-ext-diff", "--no-textconv", "--cached", "-M", "--no-color"],
 29584	                           capture_output=True, text=True, errors="replace", cwd=root,
 29585	                           timeout=max(0.1, deadline - (time.monotonic() - t0)))
 29586	        if r.returncode != 0:
 29587	            # ★不得靜默吞★:git diff 失敗時 r.stdout 恆空,若不擋下去會被
 29588	            # _delguard_parse_diff 解析成「tokens=0」——長得像掃描乾淨的成功結果,
 29589	            # 實際是沒掃到東西的失敗(r2 code-loop 折入:N3①)。丟進既有 except
 29590	            # 才能落成 degraded=true/內部錯誤,而不是假成功。
 29591	            raise RuntimeError(f"git diff rc={r.returncode}: {r.stderr[:200]}")
 29592	        # 消費專案裡「原封不動的工具檔」不抽名稱(漂移修法補強 第 5 節;代碼審 r1 外家否決席、資安席推翻了只比檔名):
 29593	        # 跟推送前分級等處同一支 _vendored_state——檔名在清單上、內容指紋跟 .lumos/vendored.json 一致才跳;
 29594	        # 清單不在或讀不懂=一支都不跳。這裡看的是暫存區,用 ref=None 讀工作目錄的檔(純讀本機檔、不跑 git,沒有時間上限的問題);
 29595	        # 暫存區跟工作目錄不一樣時只會在「暫存的改過、工作目錄的剛好跟清單一致」這種少見情形少掃。
 29596	        # 工具檔改名離開或整支刪掉時,來源已不在工作目錄 → 不算原封不動 → 照抽:寧可多掃,刻意的。
 29597	        # 工具鏈本身那些檔是它自己的程式,照抽
 29598	        parsed = _delguard_parse_diff(r.stdout, gr_rel, frozenset() if _is_toolchain_repo(root) else _vendored_state(root)[0])
