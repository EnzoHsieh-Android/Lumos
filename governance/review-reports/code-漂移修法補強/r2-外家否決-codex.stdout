 14653	def fm_structure(fm_lines):
 14654	    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
 14655	    end = 該 key 區塊最後一行的 index(含)。"""
 14656	    out = []
 14657	    i, n = 0, len(fm_lines)
 14658	    while i < n:
 14659	        m = TOP_KEY_RE.match(fm_lines[i])
 14660	        if not m:
 14661	            i += 1
 14662	            continue
 14663	        key, val = m.group(1), m.group(2).strip()
 14664	        start = i
 14665	        if val in ("|", "|-", ">", ">-"):
 14666	            i += 1
 14667	            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
 14668	                i += 1
 14669	            out.append((key, start, i - 1, "block"))
 14670	        elif val == "":
