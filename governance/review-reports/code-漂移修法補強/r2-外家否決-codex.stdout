 29348	def _delguard_added_tokens(lines, graph_root, vendored_skip):
 29349	    """第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔/工具自裝檔不收(文件提及不算「還活著」)。
 29350	    工具自裝檔照 b/ 目的路徑判斷(`+` 行屬於改完之後那支檔;改名時 `-` 行的判斷見 _delguard_parse_diff)。"""
 29351	    added, cur, skip, in_binary = {}, None, True, False
 29352	    for ln in lines:
 29353	        if ln.startswith("diff --git"):
 29354	            cur, is_v, is_e = _delguard_path_flags(ln, graph_root)
 29355	            skip = (cur is None) or is_v or is_e or cur.endswith(".md") or cur in vendored_skip
 29356	            in_binary = False
 29357	        elif ln.startswith("Binary files"):
 29358	            in_binary = True
 29359	        elif not (skip or in_binary) and ln.startswith("+") and not _delguard_is_diff_header(ln):
 29360	            added.setdefault(cur, set()).update(_DELGUARD_TOK_RE.findall(ln))
 29361	    return added
