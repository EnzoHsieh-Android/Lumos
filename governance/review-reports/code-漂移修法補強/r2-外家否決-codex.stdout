 27965	def _drift_c4_key(s):
 27966	    """卷證目錄比對用的名字:去 _計劃、NFC、不分大小寫、. 與空白轉連字號。"""
 27967	    s = nfc(str(s))
 27968	    s = s[:-3] if s.endswith("_計劃") else s
 27969	    return re.sub(r"[.\s]+", "-", s).lower()
 27970	
 27971	
 27972	def _drift_c4_existing(rr):
 27973	    """governance/review-reports/ 底下現在有的目錄 → 原名集合;讀不了回空。"""
 27974	    try:
 27975	        return {d.name for d in rr.iterdir() if d.is_dir()}
 27976	    except OSError:
 27977	        return set()
 27978	
 27979	
 27980	def _drift_c4_same_commit(root, sha, existing):
 27981	    """那個提交加進來或改名進來的卷證目錄(照原名去重、只留現在還在的)→ 清單;git 失敗、逾時或沒有提交回 None。
 27982	    借專案規矩「程式、圖譜筆記、審查卷證放同一個提交」(漂移修法補強 第 1 節);列檔照每支檔有家那段的寫法。
 27983	    ★NFC 只當比對鍵(還在不在),印的是 git 裡的原名★(代碼審 r1 外家否決、正確性、邊界席):換成 NFC 印出來,在分正規化的
 27984	    檔案系統上是一條不存在的路徑;兩個 NFC 等價但原名不同的目錄也不合併,兩個都列。"""
 27985	    raw = _nodehome_git(root, "show", "-z", "--name-only", "--diff-filter=AR", "--format=", sha) if sha else None
 27986	    if raw is None:
 27987	        return None
 27988	    keys = {nfc(x) for x in existing}
 27989	    out = []
 27990	    for p in _nodehome_split_z(raw):
 27991	        parts = p.split("/")
 27992	        d = parts[2] if len(parts) >= 4 and parts[:2] == ["governance", "review-reports"] else ""
 27993	        if d and d not in out and nfc(d) in keys:
 27994	            out.append(d)
 27995	    return out
 27996	
 27997	
 27998	def _drift_c4_dirs(cx, sha):
 27999	    """卷證目錄兩種來源都列 → ([(目錄原名, 來源)] 排好序, 同提交清單或 None)。
 28000	    排序:兩者 → code- 開頭(不分來源)→ 其他,同級照字母。兩種來源照原名對(原名不同就各列一行,見 _drift_c4_same_commit)。"""
 28001	    rr = Path(cx["root"]) / "governance" / "review-reports"
 28002	    existing = _drift_c4_existing(rr)
 28003	    same = _drift_c4_same_commit(cx["root"], sha, existing)
 28004	    n = cx["env2"].notes.get(cx["rel"])
 28005	    keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
 28006	            if link_target(x)}
 28007	    by_name = {d for d in existing if any(k and k in _drift_c4_key(d) for k in keys)}
