 14632	_SET_COND_SLOTS = ("<整項新內容>", "<卷證>", "<sha>")
 14633	_SET_COND_SLOT = _SET_COND_SLOTS[0]
 14634	# 佔位字的打錯變體(代碼審 r1 邊界席):少一邊角括號、全形角括號、括號內多空白、sha 大小寫。★只認緊貼佔位字本身的形狀★:
 14635	# 開括號那側後面不能再接字(<sha256>、<卷證目錄>、<SHA-1> 照收);只剩閉括號那側,sha 前面不能接英數(git-sha> 之類不算)。
 14636	def _set_cond_slot_variant_re(slot):
 14637	    w = slot[1:-1]
 14638	    word = f"(?i:{w})" if w.isascii() else w                       # sha 不分大小寫;中文字面照原樣
 14639	    before = r"(?<![A-Za-z0-9_])" if w.isascii() else ""           # 只剩閉括號時,英文字面前面不能接英數
 14640	    # 全形角括號寫成 \uff1c/\uff1e(ruff RUF001:字面的全形字元跟半形長得一樣,讀的人分不出)
 14641	    return re.compile("[<\uff1c]" + r"\s*" + word + r"\s*(?![\w-])|" + before + word + "[>\uff1e]")
 14642	
