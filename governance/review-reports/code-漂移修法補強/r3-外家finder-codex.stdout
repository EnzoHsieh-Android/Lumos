 53962	def t_delguard_skips_vendored_toolkit():
 53963	    """[S5] 消費專案提交時,只有「原封不動的工具檔」(檔名在 _VENDORED_ALL 上、內容指紋跟 .lumos/vendored.json 一致,
 53964	    跟推送前分級等處同一支 _vendored_state;改前改後兩態怎麼判見 t_delguard_vendored_two_states)不抽被刪名稱,治理事件 note 記 vendored-skip=<支數> files=<檔>;
 53965	    專案自己改過的工具檔、安裝清單不在時的工具檔、同目錄底下專案自己的檔都照抽;工具鏈來源 repo 照舊抽、note 不帶跳過。
 53966	
 53967	    代碼審 r1(2026-09-30)推翻「只比檔名」:外家否決席重現專案自己改過的 scripts/hooks/pre-push 刪掉名稱會被漏看(⑥)。
 53968	    翻紅釘:cmd_delguard_check 一律傳空集合 → ②紅;不看 _is_toolchain_repo 一律跳 → ④紅;note 不記 → ③紅;
 53969	    _delguard_parse_diff 的第二遍不跳 → ⑤紅;跳過集合改回整份 _VENDORED_ALL(只比檔名)→ ⑥⑦紅。
 53970	    """
 53971	    print("t_delguard_skips_vendored_toolkit")
 53972	    root, hook0 = _dgv_repo()
 53973	    _dgv_update_lumos(root)
 53974	    for rel in ("src/m.py", "scripts/hooks/own_hook.py"):
 53975	        _nh_file(root, rel, "x = 1\n")
 53976	    _nh_file(root, "scripts/hooks/pre-push", hook0 + "zzUserOther=1\n")
 53977	    _nh_git(root, "add", "-A")
 53978	    toks, rows, diff, raw = _dgv_run(root)
 53979	    m = _load_lumos_inproc()
 53980	    intact = m._delguard_vendored_skips(str(root))[0]
 53981	    check("①前置:這次提交真的從 scripts/lumos 刪掉 zzVendoredOnlyFn、從 pre-push 刪掉 zzUserGuardFn;兩支都在清單上,"
 53982	          "scripts/lumos 改前改後都跟安裝清單一致、pre-push 改之前就不一致(專案自己改過)",
 53983	          "-def zzVendoredOnlyFn" in diff and "-zzUserGuardFn" in diff
 53984	          and {"scripts/lumos", "scripts/hooks/pre-push"} <= m._VENDORED_ALL and intact == {"scripts/lumos"}, diff[:400] + str(intact))
 53985	    check("②消費專案:原封不動的工具檔刪掉的名稱不抽;專案自己的檔(含 scripts/hooks 底下不在清單上的)照抽",
 53986	          "zzVendoredOnlyFn" not in toks and {"zzProjectFn", "zzOwnHookFn"} <= toks, raw)
 53987	    note = rows[-1].get("note", "") if rows else ""
 53988	    check("③治理事件 note 記 vendored-skip=1 files=scripts/lumos(改過的 pre-push 不算)", len(rows) == 1 and rows[0]["kind"] == "ok"
 53989	          and note.endswith(" vendored-skip=1 files=scripts/lumos"), str(rows))
 53990	    check("⑥專案自己改過的工具檔(內容跟安裝清單不一致):刪掉的名稱照抽", "zzUserGuardFn" in toks, raw)
 53991	    # ⑦安裝清單不在(或讀不懂)→ 一支都不跳
 53992	    root, hook0 = _dgv_repo(manifest=False)
 53993	    _dgv_update_lumos(root)
 53994	    _nh_git(root, "add", "-A")
 53995	    toks, rows, diff, raw = _dgv_run(root)
 53996	    check("⑦前置:沒有安裝清單、scripts/lumos 真的刪了名稱", not (root / ".lumos" / "vendored.json").exists()
 53997	          and "-def zzVendoredOnlyFn" in diff, diff[:300])
 53998	    check("⑦沒有安裝清單:工具檔也照抽、note 不帶跳過", "zzVendoredOnlyFn" in toks and rows
 53999	          and "vendored-skip" not in rows[-1].get("note", ""), raw + str(rows))
 54000	    root, hook0 = _dgv_repo(toolchain=True)
 54001	    _dgv_update_lumos(root)
 54002	    _nh_git(root, "add", "-A")
 54003	    toks, rows, _diff, raw = _dgv_run(root)
 54004	    check("④工具鏈來源 repo:照抽、note 不帶跳過", "zzVendoredOnlyFn" in toks
 54005	          and rows and "vendored-skip" not in rows[-1].get("note", ""), raw + str(rows))
 54006	    d = ("diff --git a/scripts/lumos b/scripts/lumos\n--- a/scripts/lumos\n+++ b/scripts/lumos\n@@ -1 +1 @@\n"
 54007	         "-def zzGone():\n+def zzKept():\n"
 54008	         "diff --git a/src/m.py b/src/m.py\n--- a/src/m.py\n+++ b/src/m.py\n@@ -1 +1 @@\n-def zzKept():\n")
 54009	    a = m._delguard_parse_diff(d, "docs/x-knowledge", frozenset({"scripts/lumos"}))
 54010	    b = m._delguard_parse_diff(d, "docs/x-knowledge")
 54011	    check("⑤解析:給了跳過清單就不從那支檔抽名稱、回報跳過了哪幾支;預設不跳(別支檔照抽)",
 54012	          a["tokens"] == ["zzKept"] and a["vendored_skipped"] == ["scripts/lumos"]
 54013	          and b["tokens"] == ["zzGone", "zzKept"] and b["vendored_skipped"] == [], f"{a} {b}")
