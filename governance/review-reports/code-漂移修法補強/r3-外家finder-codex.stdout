 33392	def _lens_py_defs(text):
 33393	    """base 版 python 原文→頂層 def/class 的 [(name, start, end)](含裝飾器行);parse 失敗回 None。標準庫 ast,沿 slim-gen/slim-scan 先例。"""
 33394	    import ast as _ast
 33395	    try:
 33396	        tree = _ast.parse(text)
 33397	    except (SyntaxError, ValueError):
 33398	        return None
 33399	    out = []
 33400	    for node in tree.body:
 33401	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef, _ast.ClassDef)):
 33402	            start = min([node.lineno] + [d.lineno for d in getattr(node, "decorator_list", [])])
 33403	            end = getattr(node, "end_lineno", node.lineno) or node.lineno
 33404	            if _LENS_IDENT_RE.match(node.name):
 33405	                out.append((node.name, start, end))
 33406	    return out
 33407	
