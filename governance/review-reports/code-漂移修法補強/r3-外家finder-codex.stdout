+    check("①lumos update 蓋回專案改過的工具檔:改之前不是原封不動 → 刪掉的名稱照抽", "zzUserGuardFn" in toks
+          and "scripts/hooks/pre-push" not in rm_skip and "scripts/hooks/pre-push" in add_skip, raw + str(rm_skip))
+    # ②
+    root, hook0 = _dgv_repo(names=("zzVendoredOnlyFn",))
+    orig = (root / "scripts" / "lumos").read_bytes()
+    _nh_file(root, "scripts/lumos", "x = 1\n")                   # 專案自己刪掉 zzVendoredOnlyFn、暫存
+    _nh_git(root, "add", "-A")
+    (root / "scripts" / "lumos").write_bytes(orig)               # 工作目錄還原成安裝版(沒暫存)
+    toks, rows, diff, raw = _dgv_run(root)
+    check("②前置:暫存區刪了 zzVendoredOnlyFn、工作目錄跟安裝清單一致", "-def zzVendoredOnlyFn" in diff
+          and "scripts/lumos" in m._vendored_state(str(root))[0] and "scripts/lumos" not in m._vendored_state(str(root), "")[0], diff[:300])
+    check("②照暫存區判:暫存的不是原封不動 → 照抽", "zzVendoredOnlyFn" in toks and rows
+          and "vendored-skip" not in rows[-1].get("note", ""), raw + str(rows))
+    # ③
+    root, hook0 = _dgv_repo(names=("zzVendoredOnlyFn",))
+    _dgv_update_lumos(root)
+    _nh_git(root, "add", "-A")
+    _nh_file(root, "scripts/lumos", "x = 1\nzzLocal = 2\n")      # 沒暫存的本機改動
