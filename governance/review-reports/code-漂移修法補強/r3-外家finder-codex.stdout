 18151	def _install_skills():
 18152	    # ★r1 正確性席:防線下移到真正動全域機器狀態的地方★——原本只擋四個指令入口,
 18153	    # 但 cmd_init → _vendor_toolchain → _install_hooks_py 這條路也會重連 ~/.claude/skills、繞過入口守衛。
 18154	    # 擋在這個變動原語,不論從哪個指令進來都擋得住。
 18155	    if _refuse_if_probe("install-skills"):
 18156	        return
 18157	    repo = Path(__file__).resolve().parent.parent
 18158	    dest = Path.home() / ".claude" / "skills"
 18159	    for s in _SKILLS:
 18160	        src = repo / "skills" / s
 18161	        if src.is_dir():
 18162	            _link_or_copy(src, dest / s)
 18163	            print(f"  ✓ skill {s}")
 18164	    # Codex 也讀同一個開放標準(agentskills.io):使用者層 ~/.agents/skills/(2026-09-04 隔離 HOME 實測會載入)。
 18165	    # ★開放共用目錄★:既有真目錄只有帶我方標記檔才重建,否則跳過+warn(別人的 skill 不能刪)。
 18166	    shared = Path.home() / ".agents" / "skills"
 18167	    for s in _SKILLS:
 18168	        src = repo / "skills" / s
 18169	        if src.is_dir():
 18170	            if _link_or_copy_shared(src, shared / s):
 18171	                print(f"  ✓ skill(codex) {s}")
