+    rs, ad = m._delguard_vendored_skips(str(fresh))
+    check("⑤沒有 HEAD:改之前當空集合(刪除行一支都不跳),新增行照暫存區判", rs == frozenset() and ad == {"scripts/lumos"},
+          f"{rs} {ad}")
+    _nh_git(fresh, "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "i")
+    full = m._delguard_vendored_skips(str(fresh), "diff --git a/scripts/lumos b/scripts/lumos\n")
+    none = m._delguard_vendored_skips(str(fresh), "diff --git a/src/m.py b/src/m.py\n")
+    check("⑥diff 裡沒出現任何工具檔路徑就不算(不跑 git);出現了照算", full == ({"scripts/lumos"}, {"scripts/lumos"})
+          and none == (frozenset(), frozenset()), f"{full} {none}")
