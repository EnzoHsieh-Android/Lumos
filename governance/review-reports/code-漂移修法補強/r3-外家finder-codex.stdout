 17837	def _diff_range_ends(root, diff_range):
 17838	    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
 17839	    import subprocess
 17840	    r = str(diff_range).strip()
 17841	    if "..." in r:
 17842	        a, b = r.split("...", 1)
 17843	        a, b = a or "HEAD", b or "HEAD"
 17844	        try:
 17845	            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
 17846	                                cwd=str(root), timeout=_disp_git_timeout())
 17847	            return (mb.stdout.strip() or a), b
 17848	        except (OSError, subprocess.TimeoutExpired):
 17849	            return a, b
 17850	    if ".." in r:
 17851	        a, b = r.split("..", 1)
 17852	        return (a or "HEAD"), (b or "HEAD")
 17853	    return r, None
