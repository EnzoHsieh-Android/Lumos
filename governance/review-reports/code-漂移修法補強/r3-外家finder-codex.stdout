 33362	def _lens_contract_rows(text):
 33363	    """base 版節點全文裡的合約行→[(kind, 完整行)];只認 KEY: 行(三個既有正規式),★不截斷★——分類要用原文,截斷只在顯示。"""
 33364	    return [(kind, s) for s, _m, kind in _contract_key_matches(text, with_kind=True)]
