-          and "vendored-skip" not in rows[-1].get("note", ""), raw + str(rows))
+    check("②工具檔改名離開:改之前原封不動、改之後不在暫存區 → 算拆除、跳過,記來源路徑", "zzVendoredGone" not in toks and rows
+          and rows[-1].get("note", "").endswith(" vendored-skip=1 files=scripts/lumos"), raw + str(rows))
