 33241	def _lens_git(repo_root, *args, quote=False, binary=False):
 33242	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 33243	    import subprocess as _sp
 33244	    cmd = ["git", "-C", str(repo_root)]
 33245	    if quote:
 33246	        cmd += ["-c", "core.quotePath=false"]
 33247	    try:
 33248	        if binary:
 33249	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 33250	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 33251	    except (OSError, _sp.TimeoutExpired):
 33252	        return None
