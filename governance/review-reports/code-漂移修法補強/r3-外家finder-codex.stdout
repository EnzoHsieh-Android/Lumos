 29558	def _delguard_log_degraded(gr, reason, n_tokens, vendored=None):
 29559	    """★體檢 #9(2026-08-21)★:delguard 降級(超時/內部錯誤)一律寫治理帳 gate=delguard kind=degraded。
 29560	    之前只印一行「放行」——一天印 5 次、無處可數;現在 gov --stats 看得到降級率。best-effort 靜默。
 29561	    commit 欄=當下 HEAD(pre-commit 時=上一個 commit),note 標 reason。"""
 29562	    try:
 29563	        if gr:
 29564	            _append_governance_log(Path(gr), [{"gate": "delguard", "kind": "degraded", "hard": False,
 29565	                                               "nodes": [], "note": f"reason={reason} tokens={n_tokens}" + _delguard_vendored_note(vendored)}])
 29566	    except Exception:
