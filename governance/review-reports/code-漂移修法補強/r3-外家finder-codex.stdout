 29315	_DELGUARD_STOP = frozenset("if else for while return import class def val var fun void public private static final new this true false null let const function".split())
 29316	# ①建置產物:這份★必須與 pre-commit 的 should_exclude 逐項對齊★(既有漂移守衛在比),
 29317	# 因為兩邊講的是同一件事——那些目錄裡沒有人寫的原始碼。
 29318	_DELGUARD_EXCLUDE_DIRS = ("node_modules/", "bin/", "obj/", "dist/", "build/", "__pycache__/", ".git/")
 29319	# ②散文與帳本:★只有 delguard 排,絕對不要複製到 pre-commit 的 should_exclude★
 29320	# (2026-09-06 代碼審 r1 通才席判 blocker、實測重現:我為了滿足漂移守衛就把 governance/ 一起
 29321	#  抄進 pre-commit,結果 governance/ 底下 28 支真程式全部從「改 code 沒動圖譜就擋」的硬閘裡
 29322	#  掉出去——兩份清單語意根本不同:delguard 那份是「哪裡不算活著的程式」,pre-commit 那份是
 29323	#  「哪些檔改了不必配圖譜」。)
 29324	# 為什麼 delguard 要排:符號被審查卷證或治理帳提到,不代表它還活著,掃它們既不準也很貴。
 29325	# 實測四個常用詞(doctor/lumos/check/node)全 repo 命中 75587 行、7.17 秒,排除後 7336 行、
 29326	# 0.47 秒(15 倍);逾時降級的成本是跟命中行數成正比,不是 token 數。
 29327	# ★docs/ 底下的圖譜本體另有 :(exclude){graph_root} 專門排,這裡多排的是帳本與散文。★
 29328	_DELGUARD_PROSE_DIRS = ("governance/", "docs/")
 29329	_DELGUARD_ALL_EXCLUDE_DIRS = _DELGUARD_EXCLUDE_DIRS + _DELGUARD_PROSE_DIRS
 29330	# 與 pre-commit should_exclude 的 lock 排除規則對齊(`*package-lock.json|*yarn.lock|*pnpm-lock.yaml`)
 29331	_DELGUARD_EXCLUDE_LOCKFILES = ("package-lock.json", "yarn.lock", "pnpm-lock.yaml")
 29332	DELGUARD_TOKEN_CAP = 40  # staged diff 抽出 token 數上限,超額截斷(dropped 計入輸出提示)
 29333	DELGUARD_TOP_N = 10  # CLI 文字輸出逐條列出上限,其餘併入「另有 K 處命中」統計行
 29334	
