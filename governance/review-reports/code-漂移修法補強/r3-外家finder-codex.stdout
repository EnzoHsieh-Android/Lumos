 53661	    check("②一個現存目錄一行:NFD 目錄兩種來源都有 → 一行「兩者」,印磁碟上的名字;每一條印出的路徑都精確存在(格式字元那條除外)",
 53662	          rc == 0 and rows.count(f"{RR}/{nfd}(兩者)") == 1 and len(rows) == 3
 53663	          and all(n in _os.listdir(root / RR) for n in names if n != shown_cf), "\n".join(map(ascii, rows)))
 53664	    check("③目錄名裡的方向控制、零寬字元換成看得見的 \\uXXXX,原字元不進終端", f"{RR}/{shown_cf}(兩者)" in rows
 53665	          and "‮" not in out and "​" not in out, "\n".join(map(ascii, rows)))
 53666	    m = _load_lumos_inproc()
 53667	    a, b = "code-Café", "code-Café"
 53668	    orig = m._nodehome_git
 53669	    try:
 53670	        m._nodehome_git = lambda _root, *_a: "".join(f"{RR}/{x}/{f}\0" for x, f in
 53671	                                                     ((a, "r1.md"), (b, "r1.md"), (b, "r2.md"), ("gone", "r1.md"))).encode()
 53672	        got = m._drift_c4_same_commit(str(root), "abc123", {b})
 53673	        m._nodehome_git = lambda _root, *_a: f"{RR}/{a}/r1.md\0".encode()
 53674	        got2 = m._drift_c4_same_commit(str(root), "abc123", {a, b, "other"})
 53675	    finally:
 53676	        m._nodehome_git = orig
 53677	    check("⑤git 裡是 NFC、磁碟上只有 NFD:列的是磁碟上那一個、只列一次;不在的不列", got == [b], ascii(got))
 53678	    check("⑥NFC 鍵對到兩個現存目錄(分正規化的檔案系統):兩個都列", sorted(got2) == sorted([a, b]), ascii(got2))
