 29547	def _delguard_log_result(gr, kind, n_tokens, hits, secs, reason=None, vendored=None):
 29548	    """delguard 跑完(ok / 部分結果 degraded)記帳——2026-09-05 第二輪審視 d3:之前只記超時,治理帳看不出比例(架構 r1 E:與 _delguard_log_degraded 對稱的具名 helper)。"""
 29549	    try:
 29550	        _append_governance_log(Path(gr), [{"gate": "delguard", "kind": kind, "hard": False,
 29551	                                           "nodes": sorted({h["node"] for h in hits})[:10],
