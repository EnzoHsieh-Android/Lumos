 53907	def _dgv_run(root):
 53908	    """跑一次 delguard --staged --json → (命中的名稱, delguard 治理事件, staged diff, 原始輸出)。"""
 53909	    import subprocess as _sp, json as _j
 53910	    r = _sp.run([sys.executable, GRAPHCTL, "delguard", "--staged", "--json"], cwd=str(root), capture_output=True, text=True,
 53911	                timeout=120)
 53912	    log = root / "docs" / ".governance-log.jsonl"
 53913	    rows = [_j.loads(x) for x in log.read_text(encoding="utf-8").splitlines() if x.strip()] if log.exists() else []
 53914	    try:
 53915	        out = _j.loads(r.stdout.strip().splitlines()[-1])
 53916	    except Exception:
 53917	        out = {}
 53918	    toks = {t for h in out.get("hits", []) for t in h["tokens"]}
 53919	    diff = _nh_git(root, "diff", "--cached", "-M").stdout
 53920	    return toks, [x for x in rows if x.get("gate") == "delguard"], diff, r.stdout + r.stderr
 53921	
