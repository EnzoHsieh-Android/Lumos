 18174	def _link_or_copy_shared(src: Path, dst: Path) -> bool:
 18175	    """開放共用目錄版 _link_or_copy:dst 是「非我方」真目錄(不是 symlink/junction、沒有標記檔)→
 18176	    跳過+印一行,回 False;其餘交給 _link_or_copy(它會把 symlink/空夾/帶標記的複製物重建)。"""
 18177	    import os
 18178	    try:   # 我方裝的(symlink 或 Windows junction,realpath 都會解到 repo 的 skills/<名>)→ 直接重建,別當外方(r1 單reviewer F5)
 18179	        if dst.exists() and Path(os.path.realpath(dst)) == src.resolve():
 18180	            _link_or_copy(src, dst)

