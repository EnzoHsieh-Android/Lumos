 53867	def t_drift_fix_c3_reason():
 53868	    """[S4] drift fix --kind c3 帶 --reason:補的那一行最後接「;理由:<去頭尾空白的理由>」,三種寫法(pass+--by、其他+--by、
 53869	    沒 --by)都一樣;沒給照舊。理由的長度、單行、佔位字規則跟 c2 相同;改法提示帶 [--reason "…"]。
 53870	
 53871	    翻紅釘:_DRIFT_FIX_ALLOWED["c3"] 拿掉 reason → ②紅(不收 --reason);_drift_fix_c3_args 拿掉佔位字檢查 → ③佔位字紅;
 53872	    理由不去空白 → ②紅;只在其中一種寫法接 → ②另兩種紅。
 53873	    """
 53874	    print("t_drift_fix_c3_reason")
 53875	    import datetime
 53876	    today = datetime.date.today().isoformat()
 53877	    root = _df_repo()
 53878	    v = root / _DR_VAULT
 53879	    V = v / "Verification"
 53880	    ref = 'plan_refs:\n  - "[[Projects/Done_計劃]]"\ntags:\n  - type/verification\n  - status/pending'
 53881	    for n in ("A", "B", "C", "D"):
 53882	        write(v, f"Verification/{n}.md", "type: verification\nstatus: pending\n" + ref, body=f"# {n}\n內容\n")
 53883	    _df_commit(root, "c3 reason cases")
 53884	    check("①前置:四篇第 3 行都是 c3", all([f["line"] for f in _df_find(v, "c3", f"Verification/{n}.md")] == [3]
 53885	                                       for n in "ABCD"), "")
 53886	    raw = (V / "A.md").read_bytes()
 53887	    for bad, why in (("abc", "4 到 200"), ("第一行\n第二行", "4 到 200"), ("<為什麼算解決,附提交或測試>", "佔位字"),
 53888	                     ("見 <卷證> 那份", "佔位字")):
 53889	        rc, out = _df_fix(v, "Verification/A", "3", "--kind", "c3", "--status", "pass", "--reason", bad)
 53890	        check(f"③理由 {bad!r} 不合規:回 2({why})、不寫", rc == 2 and why in out and (V / "A.md").read_bytes() == raw, out)
 53891	    cases = (("A", ["--status", "pass", "--by", "Done_計劃"], "pass", ",由 [[Projects/Done_計劃]] 解決"),
 53892	             ("B", ["--status", "stale", "--by", "Systems/Pay"], "stale", ",參考 [[Systems/Pay]]"),
 53893	             ("C", ["--status", "abandoned"], "abandoned", ""))
 53894	    for n, args, st, mid in cases:
 53895	        rc, out = _df_fix(v, f"Verification/{n}", "3", "--kind", "c3", *args, "--reason", "  主線上已驗過,見 [[不存在的筆記]]  ")
 53896	        t = (V / f"{n}.md").read_text(encoding="utf-8")
 53897	        check(f"②{n}({st}):行尾接「;理由:<去空白的理由>」、理由裡的連結不驗", rc == 0
 53898	              and t.endswith(f"{today} 狀態改為 {st}(存量漂移 c3){mid};理由:主線上已驗過,見 [[不存在的筆記]]\n"), out + repr(t[-160:]))
