 53835	def t_drift_fix_c1_missing_message():
 53836	    """[S3] c1 與 guard settle 找不到某種預告句時,訊息講明「可能已經是轉正後的說法(不用改),或被手改過」;
 53837	    兩處走同一支 _guard_settle_missing_say、字樣相同、名稱不疊字。
 53838	
 53839	    翻紅釘:c1 改回自己的「找不到…,沒改」→ ③紅;settle 改回舊提醒 → ②紅;字樣裡再疊一次「預告句」→ ①紅。
 53840	    """
 53841	    print("t_drift_fix_c1_missing_message")
 53842	    m = _load_lumos_inproc()
 53843	    tail = "——可能已經是轉正後的說法(不用改),或被手改過(看一下)"
 53844	    say = m._guard_settle_missing_say("X.md", list(m._GUARD_PROSE_NAMES), say=False)
 53845	    check("①每一種名稱:找不到<名稱>+同一句說明,名稱照 _GUARD_PROSE_NAMES、不疊字",
 53846	          say == [f"找不到{n}{tail}" for n in m._GUARD_PROSE_NAMES.values()]
 53847	          and not any("預告句預告句" in x or "預告句」預告句" in x for x in say), str(say))
 53848	    want = f"找不到摘要的 TEST 預告句{tail}"
 53849	    # ② settle:pending 轉正時 TEST 句被改過
 53850	    root = _df_repo()
