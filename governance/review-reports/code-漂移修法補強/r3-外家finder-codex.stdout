  1267	def _read_touched_list(path):
  1268	    """讀「這次推送改到哪些檔」的清單(一行一個)。沒給=None(代表不收窄、照舊全擋)。
  1269	
  1270	    ★讀不到也回 None,不是回空集合★:空集合的意思是「這次什麼都沒碰到」,會讓整段靜音;
  1271	    檔案打不開是我們自己的問題,不該因此少擋一條(必要合約清單_計劃〈擋的範圍〉)。
  1272	    """
  1273	    if not path:
  1274	        return None
  1275	    try:
  1276	        lines = Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
  1277	    except OSError:
  1278	        return None
  1279	    return {ln.strip() for ln in lines if ln.strip()}
