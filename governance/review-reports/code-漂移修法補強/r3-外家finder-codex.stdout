 29393	def _delguard_parse_diff(diff_text, graph_root, vendored_skip=frozenset(), added_skip=None):
 29394	    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
 29395	    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
 29396	    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
 29397	    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
 29398	    2026-08-11 code-loop r1 C);stopword 表剔除;
 29399	    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
 29400	    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
 29401	    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
 29402	    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
 29403	    vendored_skip:`-` 行照來源路徑、這幾支(精確路徑)不看;added_skip:`+` 行(回收表)照目的路徑、這幾支不收,
 29404	    沒給就跟 vendored_skip 同一份——消費專案裡原封不動的工具自裝檔(漂移修法補強 第 5 節,兩份怎麼算見 _delguard_vendored_skips);
 29405	    跟 _DELGUARD_* 排除清單分開(那份有 t_precommit_whitelist_drift_guard 釘著)。
 29406	    ★改名時兩側分開判斷★(代碼審 r1 外家 finder 席、資安席):`-` 行照 a/ 來源路徑(`rename from`),`+` 行照 b/ 目的路徑——
 29407	    只看 b/ 的話,專案自己的 src/app.py 改名成 scripts/lumos 就能讓刪掉的名稱整支被跳過。
 29408	    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
 29409	        ,"vault_diffs": {path: [line...]}
 29410	        ,"vendored_skipped": [path...]}  # 真的有 `-` 行因此被跳過的工具檔(來源路徑;只碰到、只有新增的不算)"""
 29411	    lines = diff_text.splitlines()
 29412	    added = _delguard_added_tokens(lines, graph_root, vendored_skip if added_skip is None else added_skip)
 29413	    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
 29414	    tokens, seen, skipped = [], set(), []
 29415	    vault_diffs, cur, src, is_vault, is_excl, in_binary, in_head = {}, None, None, False, False, False, False
 29416	    for ln in lines:
 29417	        if ln.startswith("diff --git"):
 29418	            cur, is_vault, is_excl = _delguard_path_flags(ln, graph_root)
 29419	            src, in_binary, in_head = cur, False, True
 29420	        elif in_head and ln.startswith("rename from "):
 29421	            src = ln[len("rename from "):]
 29422	        elif ln.startswith("@@"):
 29423	            in_head = False
 29424	        elif ln.startswith("Binary files"):
 29425	            in_binary = True
 29426	        elif in_binary or cur is None or _delguard_is_diff_header(ln) or not ln.startswith(("+", "-")):
 29427	            continue
 29428	        elif is_vault:
 29429	            vault_diffs.setdefault(cur, []).append(ln)
 29430	        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
 29431	        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
 29432	        # (r2 code-loop 折入:N5)
 29433	        elif not (is_excl or cur.endswith(".md")) and ln.startswith("-"):
 29434	            if src in vendored_skip:
 29435	                skipped += [] if src in skipped else [src]
 29436	            else:
 29437	                _delguard_take_removed(ln, added.get(cur) or frozenset(), seen, tokens)
 29438	    return {"tokens": tokens, "vault_diffs": vault_diffs, "vendored_skipped": skipped}
 29439	
