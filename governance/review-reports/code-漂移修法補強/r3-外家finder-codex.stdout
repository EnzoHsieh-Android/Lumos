+    check("③前置:暫存的是純工具更新(跟暫存區的安裝清單一致)、工作目錄對不上", "-def zzVendoredOnlyFn" in diff
+          and "scripts/lumos" in m._vendored_state(str(root), "")[0] and "scripts/lumos" not in m._vendored_state(str(root))[0],
+          diff[:300])
+    check("③照暫存區判:純工具更新跳過、不誤報", "zzVendoredOnlyFn" not in toks and rows
+          and rows[-1].get("note", "").endswith(" vendored-skip=1 files=scripts/lumos"), raw + str(rows))
+    # ④
+    root, hook0 = _dgv_repo(names=("zzVendoredOnlyFn",))
