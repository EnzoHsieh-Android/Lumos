 17799	def _vendored_state(root, ref=None):
 17800	    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。
 17801	
 17802	    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
 17803	    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
 17804	    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
 17805	    present, data = set(), {}
 17806	    if ref is None:
 17807	        for p in sorted(_VENDORED_ALL):
 17808	            fp = Path(root) / p
 17809	            if fp.is_file():
 17810	                present.add(p)
 17811	                try:
 17812	                    data[p] = fp.read_bytes()
 17813	                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
 17814	                    data[p] = None
 17815	        try:
 17816	            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
 17817	        except (OSError, ValueError):
 17818	            man = None
 17819	    else:
 17820	        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
 17821	        for p in sorted(_VENDORED_ALL):
 17822	            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
 17823	            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
 17824	                present.add(p)
 17825	                data[p] = None
 17826	            elif r.returncode == 0:
 17827	                present.add(p)
 17828	                data[p] = r.stdout
 17829	        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
 17830	    files = man.get("files") if isinstance(man, dict) else None
 17831	    if not isinstance(files, dict):
 17832	        return frozenset(), frozenset(present)
 17833	    return (frozenset(p for p in present if data.get(p) is not None and files.get(p) == _vendored_digest(data[p])),
 17834	            frozenset(present))
