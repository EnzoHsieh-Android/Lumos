 33255	def _lens_full_sha(repo_root, rev):
 33256	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 33257	    if r is None or r.returncode != 0:
 33258	        return None
 33259	    sha = r.stdout.strip()
 33260	    return sha if _LENS_SHA_RE.match(sha) else None
