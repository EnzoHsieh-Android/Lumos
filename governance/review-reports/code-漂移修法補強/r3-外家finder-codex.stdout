 28115	def _drift_fix_c5(cx):
 28116	    """c5:轉正做了一半——只改守衛紀錄(status 改 pass、同步標籤、四種預告句改寫;跟 settle 第二步同一支算內容)。"""
 28117	    import datetime
 28118	    lines, fe = cx["lines"], cx["fe"]
 28119	    m = re.search(r"^預告的合約:(.+)$", "\n".join(lines), re.M)
 28120	    home_rel = (cx["f"].get("related") or [None])[0]
 28121	    htext = env_text(cx["env2"], home_rel) if home_rel and m else None
 28122	    if htext is None:
 28123	        return None, "讀不出預告的合約或家節點"
 28124	    claim, hl = m.group(1).strip(), htext.split("\n")
 28125	    he = _drift_fm_end(hl)
 28126	    if _guard_planned_idx(hl, he, claim):
 28127	        return None, f"家節點 {home_rel[:-3]} 同時有預告行與正式行,先手動刪掉預告行再跑"
 28128	    fi = _guard_formal_line(hl, he, claim, None)
 28129	    names, err = _drift_c5_test(cx["root"], hl[fi]) if fi is not None else (None, "家節點找不到綁了測試的正式行")
 28130	    if err:
 28131	        return None, err
 28132	    new, _missing, synced = _guard_settle_record_lines(lines, fe, home_rel, datetime.date.today().isoformat())
 28133	
 28134	    def _handled(fs, txt):
 28135	        fm, _b = split_frontmatter(txt)
 28136	        st = str(parse_frontmatter(fm)[0].get("status", "")) if fm is not None else ""
 28137	        return st == "pass" and not any(x["kind"] in ("c5", "c1") for x in fs)
 28138	    more = f"(正式行綁了 {len(names)} 支,取第一支)" if len(names) > 1 else ""
 28139	    return {"new": new, "key": "status", "check": _guard_record_ok(synced), "handled": _handled,
 28140	            "extra": {"test": names[0]}, "texts": [], "deps": _drift_deps(cx, [home_rel]),
 29290	    changed = {ln.strip() for ln in d.stdout.splitlines() if ln.strip()}
 29291	    changed = {f for f in changed if not _cochange_excluded(f, cfg["exclude"])}
 29292	    by_lhs = {}
 29293	    for (a, b), v in rules.items():
 29294	        by_lhs.setdefault(a, []).append((b, v))
 29295	    warnings = []
 29296	    for a in sorted(changed):
 29297	        for b, (conf, sup) in by_lhs.get(a, ()):
 29298	            if b in changed or conf < cfg["min_confidence"] or sup < cfg["min_support"]:
 29299	                continue
 29300	            if not (root / b).exists():  # 殭屍規則:右側已刪/改名 → 不告警
 29301	                continue
 29302	            warnings.append({"changed": a, "missing": b,
 29303	                             "confidence": conf, "support": sup})
 29304	    warnings.sort(key=lambda w: (-w["confidence"], -w["support"], w["changed"]))
 29305	    if as_json:
 29306	        print(json.dumps({"warnings": warnings, "checked": len(changed)},
 29307	                         ensure_ascii=False))
 29308	    else:
 29309	        for w in warnings:
 29310	            print(f"提醒:改了 {w['changed']} 但沒動 {w['missing']}——這兩個檔過去 {w['confidence']:.0%} 的時候是一起改的"
 29311	                  f"(共 {w['support']} 次)。確認一下是不是漏改了。")
 29312	    return 0
