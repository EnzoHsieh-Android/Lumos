 53681	def t_drift_fix_c1_missing_tail_once():
 53682	    """[S3] 代碼審 r1(spec 對照 F2)折入:c1 一次找不到好幾種預告句時,名稱用「、」接,說明尾巴只印一次;
 53683	    settle 照舊逐句提醒(兩處仍走同一支 _guard_settle_missing_say)。
 53684	
 53685	    翻紅釘:c1 改回每個名稱各接一整句 → ②紅;合併句的字樣跟單句不同 → ①紅。
 53686	    """
 53687	    print("t_drift_fix_c1_missing_tail_once")
 53688	    m = _load_lumos_inproc()
 53689	    tail = "——可能已經是轉正後的說法(不用改),或被手改過(看一下)"
 53690	    one = m._guard_settle_missing_say("X.md", ["test", "why"], say=False, one=True)
 53691	    check("①合併成一句:名稱照 _GUARD_PROSE_NAMES 用「、」接、尾巴一次;只缺一種時跟 settle 那句一字不差",
 53692	          one == [f"找不到摘要的 TEST 預告句、摘要的 WHY 預告句{tail}"]
 53693	          and m._guard_settle_missing_say("X.md", ["test"], say=False, one=True)
 53694	          == m._guard_settle_missing_say("X.md", ["test"], say=False)
 53695	          and m._guard_settle_missing_say("X.md", [], say=False, one=True) == [], str(one))
 53696	    root = _df_repo()
 53697	    v = root / _DR_VAULT
 53698	    V = v / "Verification"
 53699	    (V / "C.md").write_text(_dr_guard_text("pass", claim="大額退費要人工核可")
 53700	                            .replace("TEST:還沒有測試在守這條", "TEST:[2026-09-15] 預告已轉正,自己先改好的")
 53701	                            .replace("WHY:[2026-09-01]預告這條合約但還沒做:", "WHY:[2026-09-15]已轉正,原因是:"), encoding="utf-8")
 53702	    _df_commit(root, "cases", "2026-09-20")
 53703	    c1 = _df_find(v, "c1", "Verification/C.md")
 53704	    t = (V / "C.md").read_text(encoding="utf-8")
 53705	    check("②前置:C 是 c1、TEST 與 WHY 預告句都已經不在", c1 and "TEST:還沒有測試" not in t and "預告這條合約但還沒做" not in t, str(c1))
 53706	    rc, out = _df_fix(v, "Verification/C", str(min(f["line"] for f in c1)), "--kind", "c1", "--date", "2026-09-15")
 53707	    check("②c1:兩種都找不到時,結果訊息只接一次說明尾巴、兩個名稱都點到", rc == 0 and out.count(tail) == 1
 53708	          and "摘要的 TEST 預告句" in out and "摘要的 WHY 預告句" in out, out)
