 33378	def _json_at_ref(repo_root, ref, rel_path, timeout=10):
 33379	    """從 git ref 讀 JSON(`git show <ref>:<path>`);沒有/壞→None。只信 base 的設定要靠它,不讀工作樹。
 33380	    容許開頭的 BOM(Windows 編輯器常見);超深巢狀丟的 RecursionError 也當壞(2026-09-29 角色鏡頭代碼審 r2 正確性席)。"""
 33381	    import json as _json
 33382	    r = _lens_git(repo_root, "show", f"{ref}:{rel_path}")
 33383	    if r is None or r.returncode != 0:
 33384	        return None
 33385	    try:
 33386	        d = _json.loads(r.stdout.lstrip("\ufeff"))
 33387	        return d if isinstance(d, dict) else None
 33388	    except (ValueError, RecursionError):
 33389	        return None
