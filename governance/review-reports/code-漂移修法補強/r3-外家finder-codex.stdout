 53806	    翻紅釘:_SET_COND_SLOTS 改回只有 <整項新內容> → ②<卷證>、<sha> 紅;訊息不點名 → ②紅;<整項新內容> 的訊息改了 → ③紅。
 53807	    """
 53808	    print("t_set_conditions_blocks_drift_placeholders")
 53809	    v = mkvault()
 53810	    write(v, "Verification/V.md", "type: verification\nstatus: pass\nvalid_under: 原本的前提\nrevalidate_when: 原本的回頭條件")
 53811	    p = v / "Verification" / "V.md"
 53812	    raw = p.read_bytes()
 53813	    m = _load_lumos_inproc()
 53814	    check("①前置:三個佔位字都在同一份常數、預填指令用的是第一個", tuple(m._SET_COND_SLOTS) == ("<整項新內容>", "<卷證>", "<sha>")
 53815	          and m._SET_COND_SLOT == "<整項新內容>", str(getattr(m, "_SET_COND_SLOTS", None)))
 53816	    for key in ("valid_under", "revalidate_when"):
 53817	        for slot in ("<整項新內容>", "<卷證>", "<sha>"):
 53818	            r = run(v, "set", "Verification/V", key, "好的一條", f"提交 abc;代碼審見 {slot}")
 53819	            check(f"②{key} 值裡留著 {slot}:回 2、點名、檔案不動", r.returncode == 2 and f"還留著 {slot}(" in r.stderr
 53820	                  and p.read_bytes() == raw, r.stdout + r.stderr)
 53821	    r = run(v, "set", "Verification/V", "valid_under", "<整項新內容>")
 53822	    check("③<整項新內容> 的訊息跟改前一字不差", r.returncode == 2 and r.stderr.strip()
 53823	          == "擋下:值裡還留著 <整項新內容>(drift fix 證據頁的佔位字)——換成那一項改寫後的整句,檔案沒動", r.stderr)
 53824	    r = run(v, "set", "Verification/V", "valid_under", "提交 <sha>;代碼審見 <卷證>")
 53825	    check("③兩個一起留著:兩個都點名", r.returncode == 2 and "還留著 <卷證>、<sha>(" in r.stderr and p.read_bytes() == raw, r.stderr)
 53826	    r = run(v, "set", "Verification/V", "valid_under", "")
 53827	    check("④空值:照舊擋、訊息不變", r.returncode == 2 and "的每一條都不能是空的" in r.stderr and p.read_bytes() == raw, r.stderr)
 53828	    r = run(v, "set", "Verification/V", "valid_under", "第一行\n第二行")
 53829	    check("④多行:照舊擋、訊息不變", r.returncode == 2 and "一條條件只能一行" in r.stderr and p.read_bytes() == raw, r.stderr)
 53830	    r = run(v, "set", "Verification/V", "valid_under", "Map<K,V> 與 <src/lib> 照收;提交 <SHA-1> 大寫不是佔位字")
 53831	    check("⑤合法的角括號字樣照收", r.returncode == 0 and "Map<K,V> 與 <src/lib>" in p.read_text(encoding="utf-8"),
 53832	          r.stdout + r.stderr)
