  5883	        g = subprocess.run(["git", "-C", str(rr), "grep", "-q", "-w", "-e", name, r.stdout.strip(), "--"], capture_output=True, text=True, errors="replace")
  5884	        return g.returncode == 0
  5885	    except OSError:
  5886	        return False
