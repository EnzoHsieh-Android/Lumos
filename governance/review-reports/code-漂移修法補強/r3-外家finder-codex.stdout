 33337	def _contract_key_matches(text, with_kind=False):
 33338	    """★全檔唯一的「合約行」掃描★:逐行只認 KEY: 行(INVARIANT_RE/CHECKPOINT_RE/IRREVERSIBLE_RE),回 [(整行, match)];不掃正文。
 33339	    派工鏡頭(_lens_contract_lines/_lens_contract_rows)與規格閘的相依回歸(_contract_texts)都走這裡(代碼審 r1/r2 架構席:別再各寫一份);with_kind=True 多回哪一種合約。"""
 33340	    out = []
 33341	    for line in text.split("\n"):
 33342	        s = line.strip()
 33343	        for kind, rx in (("INVARIANT", INVARIANT_RE), ("CHECKPOINT", CHECKPOINT_RE), ("IRREVERSIBLE", IRREVERSIBLE_RE)):
 33344	            m = rx.match(s)
 33345	            if m:
 33346	                out.append((s, m, kind) if with_kind else (s, m))
 33347	                break
 33348	    return out
 33349	
