 17590	def _deinit_remove_vendored(root: Path, src=None) -> list:
 17591	    """白名單移除 vendored 工具組:① _VENDORED_TOOLKIT 固定 5 檔;
 17592	    ② scripts/hooks/、scripts/templates/ ★依 src 列舉逐檔刪★(對稱 _vendor_toolchain 的 rglob 安裝)。
 17593	    F9 修(2026-07-24,Issues/deinit整夾刪使用者檔):不再整夾 rmtree——只刪 src 有的 lumos 檔、
 17594	    保留使用者放這兩夾的自有檔,夾空了才移。fallback(a):src 缺(None 或來源夾不存在)→ 保守留夾
 17595	    +warn、不刪(never delete unknown)。scripts/ 底下使用者自有檔不碰;scripts/ 空了才 rmdir。
 17596	    回傳已移除相對路徑列表。"""
 17597	    removed = []
 17598	    for rel in _VENDORED_TOOLKIT:
 17599	        p = root / rel
 17600	        if p.exists():
 17601	            # ★刪不掉不該炸穿整個流程★(2026-08-01):這裡以前是裸 unlink()。
 17602	            # 走 teardown 時,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,
 17603	            # 若在這裡拋 PermissionError(Windows 刪執行中的檔、防毒鎖檔),
 17604	            # ③uninstall 根本沒機會跑 → 使用者拿到拆一半又只看到 traceback 的
 17605	            # 狀態。改成印清楚哪一個檔沒刪掉、繼續往下走完;★不靜默★——沒刪掉
 17606	            # 的檔不會被記進 removed,呼叫端印出來的清單仍然誠實。
 17607	            # (Windows 自刪這條主要路徑另有 _selfdelete_risk 在 mutation 前擋。)
 17608	            try:
 17609	                p.unlink(); removed.append(rel)
 17610	            except OSError as e:
 17611	                print(f"  ⚠ 移除 {p} 失敗,跳過(其餘步驟照跑): {e}", file=sys.stderr)
 17612	    mp = root / _VENDORED_MANIFEST   # 工具檔的內容指紋清單是工具自己的東西,跟著拆
 17613	    if mp.is_file():
 17614	        try:
 17615	            mp.unlink(); removed.append(_VENDORED_MANIFEST)
 17616	        except OSError as e:
 17617	            print(f"  ⚠ 移除 {mp} 失敗,跳過(其餘步驟照跑): {e}", file=sys.stderr)
 17618	    for d in _VENDORED_TREE_DIRS:
 17619	        tgt = root / d
 17620	        if not tgt.is_dir():
 17621	            continue
 17622	        src_d = (src / d) if src is not None else None
 17623	        if src_d is None or not src_d.is_dir():   # fallback(a):列舉不出 → 保守留夾
 17624	            print(f"  ⚠ 無法從來源列舉 {d} 的 lumos 檔清單,保留整夾避免誤刪你的檔"
 17625	                  "(手動清理,或 deinit/teardown 加 --source 指向 Lumos 來源)", file=sys.stderr)
 17626	            continue
 17627	        for f in src_d.rglob("*"):                # 對稱安裝:src_d 下的檔即 lumos-owned,逐檔刪
 17628	            if f.is_file():
 17629	                rel_f = f.relative_to(src_d)
 17630	                t = tgt / rel_f
 17631	                if t.exists():
 17632	                    t.unlink(); removed.append(f"{d}/{rel_f}")
 17633	        for sub in sorted((p for p in tgt.rglob("*") if p.is_dir()),   # 由深到淺移空子目錄
 17634	                          key=lambda x: len(x.parts), reverse=True):
 17635	            if not any(sub.iterdir()):
 17636	                sub.rmdir()
 17637	        if any(tgt.iterdir()):                    # 夾內尚有使用者檔 → 留+warn
 17638	            leftover = sorted(p.name for p in tgt.iterdir())
 17639	            print(f"  ⚠ {d} 保留(內有非 lumos 檔:{', '.join(leftover[:5])})", file=sys.stderr)
 17640	        else:
 17641	            tgt.rmdir(); removed.append(d + "/")
 17642	    sc = root / "scripts"
 17643	    if sc.is_dir() and not any(sc.iterdir()):
 17644	        sc.rmdir(); removed.append("scripts/")
 17645	    return removed
