 33301	def _lens_cache_read(path, ttl_sec=1200):
 33302	    """只信自己 uid 擁有、group/other 不可寫、TTL 內的檔(r3 載荷席:$TMPDIR 路徑可預測可偽造)。"""
 33303	    import json as _json, stat as _stat, time as _time
 33304	    try:
 33305	        st = path.stat()
 33306	        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):
 33307	            return None
 33308	        if _time.time() - st.st_mtime > ttl_sec:
 33309	            return None
 33310	        return _json.loads(path.read_text(encoding="utf-8"))
 33311	    except (OSError, ValueError):
 33312	        return None
