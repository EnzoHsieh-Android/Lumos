 29367	def _delguard_added_tokens(lines, graph_root, vendored_skip):
 29368	    """第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔/工具自裝檔不收(文件提及不算「還活著」)。
 29369	    工具自裝檔照 b/ 目的路徑判斷(`+` 行屬於改完之後那支檔,vendored_skip 由呼叫端給「改之後原封不動」的那一份;
 29370	    改名時 `-` 行的判斷見 _delguard_parse_diff)。"""
 29371	    added, cur, skip, in_binary = {}, None, True, False
 29372	    for ln in lines:
 29373	        if ln.startswith("diff --git"):
 29374	            cur, is_v, is_e = _delguard_path_flags(ln, graph_root)
 29375	            skip = (cur is None) or is_v or is_e or cur.endswith(".md") or cur in vendored_skip
 29376	            in_binary = False
 29377	        elif ln.startswith("Binary files"):
 29378	            in_binary = True
 29379	        elif not (skip or in_binary) and ln.startswith("+") and not _delguard_is_diff_header(ln):
 29380	            added.setdefault(cur, set()).update(_DELGUARD_TOK_RE.findall(ln))
 29381	    return added
 29382	
 29383	
 29384	def _delguard_take_removed(ln, fadd, seen, tokens):
 29385	    """一條 `-` 行的 token 收進 tokens(依出現序去重;同檔 `+` 行出現過的、stopword 剔除)。"""
 29386	    for t in _DELGUARD_TOK_RE.findall(ln):
 29387	        if t in _DELGUARD_STOP or t in fadd or t in seen:
 29388	            continue
 29389	        seen.add(t)
 29390	        tokens.append(t)
 29391	
