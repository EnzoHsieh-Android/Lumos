 33315	def _lens_cache_write(path, data):
 33316	    """★寫入端也要驗目錄★(2026-09-06 全 repo 審視 #6):原本直接 mkdir + chmod(0700),
 33317	    目錄若被換成指向別處的 symlink,就會把**別人的目錄**權限改掉。讀取端一直都有檢查,
 33318	    寫入端沒有——現在兩邊都走同一支 _trusted_private_dir。不過關就靜默不寫(fail-open)。"""
 33319	    import json as _json, tempfile as _tf
 33320	    try:
 33321	        # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
 33322	        # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
 33323	        if not _mkdir_trusted_under_home(".cache", "lumos", "dispatch-lens"):
 33324	            return
 33325	        if not _trusted_private_dir(path.parent, ".cache", "lumos", "dispatch-lens"):
 33326	            return
 33327	        os.chmod(path.parent, 0o700)
 33328	        fd, tmp = _tf.mkstemp(dir=str(path.parent), suffix=".tmp")
 33329	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
 33330	            fh.write(_json.dumps(data, ensure_ascii=False))
 33331	        os.chmod(tmp, 0o600)
 33332	        os.replace(tmp, path)
 33333	    except OSError:
 33334	        pass
