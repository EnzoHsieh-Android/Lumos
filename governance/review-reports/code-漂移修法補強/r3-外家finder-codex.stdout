 18116	def _link_or_copy(src: Path, dst: Path):
 18117	    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
 18118	    import os, shutil, subprocess
 18119	    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
 18120	    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
 18121	    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
 18122	    if dst.is_symlink():
 18123	        dst.unlink()                                  # Unix symlink
 18124	    elif dst.is_dir():
 18125	        try:
 18126	            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
 18127	        except OSError:
 18128	            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
 18129	    elif dst.exists():
 18130	        dst.unlink()
 18131	    dst.parent.mkdir(parents=True, exist_ok=True)
 18132	    try:
 18133	        if _IS_WIN:
 18134	            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
 18135	            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
 18136	            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
 18137	                               capture_output=True, text=True, encoding="utf-8", errors="replace")
 18138	            if r.returncode != 0:
 18139	                raise OSError(r.stderr)
 18140	        else:
 18141	            dst.symlink_to(src)
 18142	    except OSError:
 18143	        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8(專案宣告 ≥3.9)
 18144	        try:
 18145	            (dst / _SKILL_MARKER).write_text("lumos fallback copy;安裝器可整夾重建\n", encoding="utf-8")
 18146	        except OSError:
 18147	            pass
 18148	        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")
 18149	
