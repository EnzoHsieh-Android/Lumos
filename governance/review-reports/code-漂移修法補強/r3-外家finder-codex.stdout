 33351	def _lens_contract_lines(text, cap=40):
 33352	    """base 版節點全文裡的合約行(截到 200 字、最多 cap 條,給派工鏡頭印)。"""
 33353	    return [s[:200] for s, _m in _contract_key_matches(text)][:cap]
