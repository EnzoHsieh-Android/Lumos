  5837	    if hang:
  5838	        return [f"{P} ✗ — 風險低的測試要真的存在:" + "、".join(f"{b['id']} {'/'.join(map(str, b['refs']))}({_CLAUSE_STATE_ZH.get(b['state'], b['state'])})" for b in hang),
  5839	                "    先把測試寫出來(現在紅沒關係),或把門升成單向"]
  5840	    seen, dup = {}, []
  5841	    for b in clauses:
  5842	        for nm in b["refs"]:
  5843	            if nm in seen and seen[nm] != b["id"]:
  5844	                dup.append(f"{nm}({seen[nm]} 與 {b['id']})")
  5845	            seen.setdefault(nm, b["id"])
  5846	    if dup:
  5847	        return [f"{P} ✗ — 風險低每條條款的測試名要互不相同(重複:" + "、".join(dup) + ")",
  5848	                "    一支測試證一條條款;十條全綁同一支也能「全部存在」,所以擋"]
  5849	    return []
