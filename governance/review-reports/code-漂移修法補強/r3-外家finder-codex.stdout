 28044	def _drift_c4_show_name(d):
 28045	    """卷證目錄名拿來印:非 UTF-8 位元組換替代字元(_nodehome_show),Unicode 格式字元(類別 Cf:方向控制、零寬)換成看得見的
 28046	    \\uXXXX——整批匯入的目錄名帶 RLO 會讓終端上看到的順序跟實際字串不同(代碼審第二輪資安席)。只在這一處,不改共用的 _esc_clean。"""
 28047	    import unicodedata
 28048	    return "".join((f"\\u{ord(c):04x}" if ord(c) <= 0xFFFF else f"\\U{ord(c):08x}") if unicodedata.category(c) == "Cf" else c
 28049	                   for c in _nodehome_show(d))
