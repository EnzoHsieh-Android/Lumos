 27980	def _drift_c4_same_commit(root, sha, existing):
 27981	    """那個提交加進來或改名進來的卷證目錄 → 對應到的現存目錄名(磁碟上的實際名字,去重)清單;git 失敗、逾時或沒有提交回 None。
 27982	    借專案規矩「程式、圖譜筆記、審查卷證放同一個提交」(漂移修法補強 第 1 節);列檔照每支檔有家那段的寫法。
 27983	    ★印的一律是現在真的存在的那個目錄名,git 裡的名字只拿 NFC 鍵去對現存目錄★(代碼審第二輪正確性、外家否決、邊界席):
 27984	    macOS 上 git 存 NFC、磁碟上可能是 NFD,印 git 的名字在分正規化的檔案系統上是不存在的路徑,而且跟計劃名那份對不起來、
 27985	    同一個目錄列兩行;NFC 鍵對到好幾個現存目錄(分正規化的檔案系統才會有)才每個都列。"""
 27986	    raw = _nodehome_git(root, "show", "-z", "--name-only", "--diff-filter=AR", "--format=", sha) if sha else None
 27987	    if raw is None:
 27988	        return None
 27989	    by_key = {}
 27990	    for x in sorted(existing):
 27991	        by_key.setdefault(nfc(x), []).append(x)
 27992	    out = []
 27993	    for p in _nodehome_split_z(raw):
 27994	        parts = p.split("/")
 27995	        d = parts[2] if len(parts) >= 4 and parts[:2] == ["governance", "review-reports"] else ""
 27996	        out += [x for x in (by_key.get(nfc(d), []) if d else []) if x not in out]
 27997	    return out
