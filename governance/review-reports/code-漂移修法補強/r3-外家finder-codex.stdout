 53923	def _dgv_repo(toolchain=False, manifest=True, names=("zzVendoredOnlyFn", "zzProjectFn", "zzOwnHookFn", "zzUserGuardFn")):
 53924	    """刪除守衛跳過工具自裝檔的測試專案:scripts/lumos(工具檔,安裝時原樣)、scripts/hooks/pre-push(工具檔,專案自己改過:
 53925	    多了 zzUserGuardFn)、src/m.py 與 scripts/hooks/own_hook.py(專案自己的檔);圖譜提到這幾個名稱。
 53926	    manifest=True 時 .lumos/vendored.json 記的是安裝時的指紋(pre-push 記的是改之前那份)。"""
 53927	    import tempfile as _tf, json as _j
 53928	    m = _load_lumos_inproc()
 53929	    root = Path(_tf.mkdtemp(prefix="gctl-dgvend-"))
 53930	    vault = root / "docs" / "x-knowledge"
 53931	    (vault / "Systems").mkdir(parents=True)
 53932	    (vault / "Systems" / "a.md").write_text("---\nname: a\n---\n# a\n呼叫 " + " 與 ".join(names) + "。\n", encoding="utf-8")
 53933	    hook0 = "#!/bin/sh\necho installed hook\n"
 53934	    _nh_file(root, "scripts/lumos", "def zzVendoredOnlyFn():\n    return 1\n")
 53935	    _nh_file(root, "scripts/hooks/pre-push", hook0 + "zzUserGuardFn() { :; }\nzzUserOther=1\n")
 53936	    _nh_file(root, "src/m.py", "def zzProjectFn():\n    return 1\n")
 53937	    _nh_file(root, "scripts/hooks/own_hook.py", "def zzOwnHookFn():\n    return 1\n")
 53938	    if toolchain:
 53939	        _nh_file(root, "skills/lumos-project-notes/SKILL.md", "# skill\n")
 53940	    if manifest:
 53941	        _nh_file(root, ".lumos/vendored.json", _j.dumps({"version": 1, "files": {
 53942	            "scripts/lumos": m._vendored_digest("def zzVendoredOnlyFn():\n    return 1\n".encode()),
 53943	            "scripts/hooks/pre-push": m._vendored_digest(hook0.encode())}}) + "\n")
 53944	    _nh_git(root, "init", "-q")
 53945	    _nh_git(root, "add", "-A")
 53946	    _nh_git(root, "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "i")
 53947	    return root, hook0
