  9765	def _esc_clean(v, limit=200):
  9766	    """逃逸帳顯示消毒(code-escape r1 B-1/B-2):控制字元(含換行/ESC)換空格——
  9767	    --list 的「一行一筆」是攔截/逃逸週報 grep 的載重合約,使用者可控的 desc 不得打穿;
  9768	    ANSI 逃逸碼進終端=帳本可信度風險。截斷防超長刷版。"""
  9769	    out = "".join(ch if ch >= " " and not ("\x7f" <= ch <= "\x9f") else " " for ch in str(v))   # 含 8 位元 C1 控制碼(r2 資安席)
  9770	    return out if len(out) <= limit else out[:limit] + "…"
