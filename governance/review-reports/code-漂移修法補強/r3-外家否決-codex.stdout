 21530	def _diff_added_lines(diff_text):
 21531	    """從 git diff -U3 輸出建 {file: set(new_line_numbers)} 對應所有新增行(+ 開頭)。
 21532	    使用與 _pitfall_diff_mode 相同的 @@ 標頭推導邏輯。"""
 21533	    added = {}
 21534	    cur_file, new_ln = "", 0
 21535	    for line in diff_text.splitlines():
 21536	        if line.startswith("+++ b/"):
 21537	            cur_file = line[6:]
 21538	            continue
 21539	        m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
 21540	        if m:
 21541	            new_ln = int(m.group(1))
 21542	            continue
 21543	        if line.startswith("+++") or line.startswith("---"):
 21544	            continue
 21545	        if line.startswith("-"):
 21546	            continue                          # 刪除行不推進新檔行號
 21547	        if not line.startswith("+"):
 21548	            new_ln += 1                       # context 行推進
 21549	            continue
 21550	        # 這是新增行(+ 開頭)
 21551	        if cur_file:
 21552	            added.setdefault(cur_file, set()).add(new_ln)
 21553	        new_ln += 1                           # 新增行推進新檔行號
 21554	    return added
 21555	
