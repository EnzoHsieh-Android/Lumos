 27803	    if len(ps) > 1:
 27804	        return f"{repo_rel} 這個名字在 git 裡有 {len(ps)} 種 Unicode 拼法的檔並存,工具分不出要改哪一篇;先手動整理成一篇"
 27805	    gp = ps[0]
 27806	    r = _lens_git(root, "--literal-pathspecs", "diff", "--no-ext-diff", "--no-textconv", "--quiet", "HEAD", "--", gp)   # 檔名裡的 * 不當萬用字元(r4 邊界、外家)
 27807	    if r is None or r.returncode not in (0, 1):
 27808	        return "git 查詢失敗或逾時(git diff HEAD),查不出這一篇乾不乾淨"
 27809	    if r.returncode == 0 or _drift_fix_last_sha(root, repo_rel) == hashlib.sha256(raw).hexdigest():
 27810	        return None
 27811	    return f"{repo_rel} 有未提交的改動(不是 drift fix 自己留下的)——先提交或還原再修"
