 18372	# vault 用「目錄名結尾 -knowledge」認,不整個 docs/ 略過(專案可能在 docs/ 放範例程式)。
 18373	_STACK_SCAN_SKIP = {"node_modules", ".git", "build", "DerivedData", "dist", "vendor",
 18374	                    "Pods", ".venv", "venv", ".gradle", ".build", "target",
 18375	                    "governance", ".lumos"}
