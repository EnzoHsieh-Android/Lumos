 53744	def t_drift_c4_dirs_capped_at_20():
 53745	    """[S1] 代碼審 r1(邊界 F3)折入:c4 證據頁的卷證目錄超過 20 個時只列前 20 個(照原本的排序),最後一行印「另有 N 個沒列出」
 53746	    加一條能列完整清單的 git 指令(--literal-pathspecs,照 _drift_git_cmd 的寫法);剛好 20 個全列、不印那一行。
 53747	    代碼審第二輪(邊界 F2、正確性 F5):指令列的跟證據頁同一套定義——只列目錄(根目錄的散檔不算)、只列現在還在的;
 53748	    「另有 N 個」加上已列的 20 個剛好等於指令列出的數量。查不到提交時不給指令。
 53749	
 53750	    翻紅釘:拿掉上限 → ②紅;上限差一(19 或 21)→ ②④紅;不印指令、指令把散檔或已刪的目錄也列進來 → ③紅;
 53751	    查不到提交還給指令 → ⑤紅。
 53752	    """
 53753	    print("t_drift_c4_dirs_capped_at_20")
 53754	    import subprocess as _sp, io, contextlib
 53755	    root = _df_repo()
 53756	    v = root / _DR_VAULT
 53757	    RR = "governance/review-reports"
 53758	    E = v / "Verification" / "E.md"
 53759	    E.write_text("---\ntype: verification\nstatus: pass\nvalid_under:\n  - 本工作樹(未提交);全套測試\nplan_refs:\n"
 53760	                 "  - \"[[Projects/Done_計劃]]\"\n---\n# E\n", encoding="utf-8")
 53761	    names = [f"bulk-{i:02d}" for i in range(23)]
 53762	    for d in names:
 53763	        _nh_file(root, f"{RR}/{d}/r1.md", f"{d}\n")
 53764	    _nh_file(root, f"{RR}/README.md", "根目錄的散檔\n")
 53765	    _nh_file(root, f"{RR}/gone-x/r1.md", "後來刪掉\n")
 53766	    _df_commit(root, "bulk import")
 53767	    import shutil as _sh
 53768	    _sh.rmtree(root / RR / "gone-x")
 53769	    first = _nh_git(root, "log", "--diff-filter=A", "--format=%H", "--", f"{_DR_VAULT}/Verification/E.md").stdout.split()[-1]
 53770	    shown = _nh_git(root, "show", "--name-only", "--format=", first).stdout
 53771	    check("①前置:E 第一次提交一起加了 23 個卷證目錄,外加根目錄散檔與後來刪掉的 gone-x",
 53772	          len([d for d in (root / RR).iterdir() if d.is_dir()]) == 23 and f"{RR}/README.md" in shown
 53773	          and f"{RR}/gone-x/r1.md" in shown and [f["line"] for f in _df_find(v, "c4", "Verification/E.md")] == [5], shown[-300:])
 53774	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4")
 53775	    rows = [ln.strip() for ln in out.splitlines() if ln.strip().startswith(f"{RR}/")]
 53776	    check("②只列前 20 個(照原本的排序)、印「另有 3 個沒列出」", rc == 0
 53777	          and rows == [f"{RR}/{d}(同提交)" for d in names[:20]] and "另有 3 個沒列出" in out, out)
 53778	    cmd = [ln.strip() for ln in out.splitlines() if ln.strip().startswith("git --literal-pathspecs")]
 53779	    got = _sp.run(cmd[0], shell=True, cwd=str(root), capture_output=True, text=True).stdout.split() if cmd else []
 53780	    import re as _re
 53781	    mm = _re.search(r"另有 (\d+) 個沒列出", out)
 53782	    check("③印的指令照貼就列出完整的 23 個(散檔、已刪的目錄不列),數量 = 已列 20 + 另有 N", got == names
 53783	          and mm and len(got) == len(rows) + int(mm.group(1)) and "共 23 個" in out, "\n".join(cmd) + "\n" + str(got))
 53784	    m = _load_lumos_inproc()
 53785	    for n, more in ((20, False), (21, True)):
 53786	        ev = {"reports": [(f"d{i:02d}", "同提交") for i in range(n)], "same": [f"d{i:02d}" for i in range(n)], "sha": "abc123"}
 53787	        buf = io.StringIO()
 53788	        with contextlib.redirect_stdout(buf):
 53789	            m._drift_c4_print_dirs(ev)
 53790	        o = buf.getvalue()
 53791	        check(f"④{n} 個:{'超過才' if more else '剛好 20 個全列、不'}印「另有」", ("另有" in o) == more
 53792	              and o.count(f"{RR}/d") == min(n, 20), o)
 53793	    ev = {"reports": [(f"d{i:02d}", "計劃名") for i in range(22)], "same": None, "sha": None}
 53794	    buf = io.StringIO()
 53795	    with contextlib.redirect_stdout(buf):
 53796	        m._drift_c4_print_dirs(ev)
 53797	    o = buf.getvalue()
 53798	    check("⑤查不到提交(只有計劃名比對的):不給指令,講明在哪裡找", m._drift_c4_more_cmd(None) is None
 53799	          and "另有 2 個沒列出(其中 2 個只有計劃名對得上" in o and "git --literal-pathspecs" not in o, o)
 53800	
