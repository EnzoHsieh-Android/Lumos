 29549	def cmd_delguard_check(repo=None, as_json=False):
 29550	    """code 側刪除傳播守衛(advisory):staged diff 抽被刪 token → 兩檔信心 → grep vault 指名過期原句。
 29551	    恆 rc0(內部錯誤/超時皆 fail-open 放行;唯一輸出差異是訊息)。
 29552	    vault-free repo(找不到 graph root)→ 靜默 rc0,不掃。
 29553	    --json 降級契約(超時/內部錯誤皆同款):單行合法 JSON
 29554	    {"tokens": int, "hits": [], "fake_sync": [], "degraded": true, "reason": "timeout"|"error"},rc0。"""
 29555	    import json, os, subprocess, time
 29556	    t0 = time.monotonic()
 29557	    try:  # 亂設的 env 不該讓 pre-commit 印 traceback(fail-open 契約覆蓋設定錯誤)
 29558	        deadline = float(os.environ.get("LUMOS_DELGUARD_DEADLINE", "15.0"))  # 5.0 在本 repo(377 篇+大 diff)仍常超,2026-08-27 一 session 降級多次→15;advisory fail-open,pre-commit 多等幾秒換掃完整
 29559	    except (ValueError, TypeError):
