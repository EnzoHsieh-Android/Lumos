 27972	def _drift_c4_existing(rr):
 27973	    """governance/review-reports/ 底下現在有的目錄 → 原名集合;讀不了回空。"""
 27974	    try:
 27975	        return {d.name for d in rr.iterdir() if d.is_dir()}
 27976	    except OSError:
 27977	        return set()
