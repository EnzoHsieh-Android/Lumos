 23505	def _home_mentions(scan_text, rel_path):
 23506	    """這段文字有沒有提到這支檔(完整路徑或裸檔名,整詞比對)。
 23507	
 23508	    ★不要用 `base in scan` 這種子字串比對★:新掛 `a.py`、正文只寫了 `xa.py`,子字串會判成「有提到」,
 23509	    提醒就被吃掉——代碼審 r1 邊界席實測。所以命中位置的前後要是非檔名字元(或字串邊界)才算。
 23510	    """
 23511	    base = rel_path.rsplit("/", 1)[-1]
 23512	    for token in (rel_path, base):
 23513	        if not token:
 23514	            continue
 23515	        start = 0
 23516	        while True:
 23517	            i = scan_text.find(token, start)
 23518	            if i < 0:
 23519	                break
 23520	            before = scan_text[i - 1] if i > 0 else ""
 23521	            after = scan_text[i + len(token)] if i + len(token) < len(scan_text) else ""
 23522	            if not _HOME_MENTION_BOUNDARY.match(before or " ") and not _HOME_MENTION_BOUNDARY.match(after or " "):
 23523	                return True
 23524	            start = i + 1
 23525	    return False
