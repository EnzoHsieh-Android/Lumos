 54141	def t_doctor_revisit_marks_closed_issues():
 54142	    """[S6] doctor E5 列出到期回頭條件時,來源是狀態為 Issue 結案值的 Issue,那一行標「這篇 Issue 已結案」,照樣列、照樣計數;
 54143	    其他類型、Issue 用了非結案值時不標;E5 與結案列出用同一支判定(_revisit_lines)。
 54144	
 54145	    翻紅釘:拿掉 E5 的 _closed5 → ①紅;_closed5 不看類型 → ②計劃那行紅;改成看 QUERY_CLOSED_STATUSES 以外的字 → ②紅;
 54146	    E5 改回自己的逐行迴圈、不走 _revisit_lines → ③紅。
 54147	    """
 54148	    print("t_doctor_revisit_marks_closed_issues")
 54149	    import contextlib, io
 54150	    v = mkvault()
 54151	    (v / "Issues").mkdir()
 54152	    write(v, "Issues/已結案甲.md", "type: issue\nstatus: done", body="# 甲\nREVISIT:2020-01-01 最老的一條\n")
 54153	    write(v, "Issues/還開著乙.md", "type: issue\nstatus: open", body="# 乙\nREVISIT:2020-01-02 開著的\n")
 54154	    write(v, "Projects/收尾丙_計劃.md", "type: project\nstatus: done", body="# 丙\nREVISIT:2020-01-03 計劃留的撤除條件\n")
 54155	    write(v, "Issues/怪值丁.md", "type: issue\nstatus: fixed", body="# 丁\nREVISIT:2020-01-04 非結案值\n")
 54156	    r = run(v, "doctor", "--verbose")
 54157	    e5 = r.stdout.split("[E5]")[1].split("\n[")[0] if "[E5]" in r.stdout else ""
 54158	    row = lambda s: next((x for x in e5.split("\n") if s in x), "")
 54159	    check("①已結案的 Issue:那一行標「這篇 Issue 已結案」,照樣列", "(這篇 Issue 已結案)" in row("最老的一條"), e5)
 54160	    check("②開著的 Issue、已收尾的計劃、非結案值的 Issue 不標", row("開著的") and "已結案" not in row("開著的")
 54161	          and row("計劃留的撤除條件") and "已結案" not in row("計劃留的撤除條件")
 54162	          and row("非結案值") and "已結案" not in row("非結案值"), e5)
 54163	    check("②照樣計數(四件都算)", "4 件回訪到期" in r.stdout, e5)
 54164	    m = _load_lumos_inproc()
 54165	    seen = []
 54166	    orig = m._revisit_lines
 54167	
 54168	    def spy(text):
 54169	        seen.append(text)
 54170	        return orig(text)
 54171	    m._revisit_lines = spy
 54172	    try:
 54173	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
 54174	            m.run_doctor(m.Env(v), False, False)
 54175	        n_doc = len(seen)
