 23565	def _nodehome_layout(all_paths):
 23566	    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
 23567	    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
 23568	    tops = _nodehome_top_dirs(all_paths)
 23569	    top_exts, main_exts = {}, {}
 23570	    for p in all_paths:
 23571	        e = _testmap_ext(p)
 23572	        if not e:
 23573	            continue
 23574	        parts = p.split("/")
 23575	        if len(parts) > 1 and parts[0] in tops:
 23576	            top_exts.setdefault(parts[0], set()).add("." + e)
 23577	        for k in range(len(parts) - 2):
 23578	            if parts[k] == "src" and parts[k + 1] == "main":
 23579	                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
 23580	                break
 23581	    return top_exts, main_exts
