 28000	def _drift_c4_dirs(cx, sha):
 28001	    """卷證目錄兩種來源都列 → ([(目錄原名, 來源)] 排好序, 同提交清單或 None)。
 28002	    排序:兩者 → code- 開頭(不分來源)→ 其他,同級照字母。兩種來源都是現存目錄名,一個目錄一行(見 _drift_c4_same_commit)。"""
 28003	    rr = Path(cx["root"]) / "governance" / "review-reports"
 28004	    existing = _drift_c4_existing(rr)
 28005	    same = _drift_c4_same_commit(cx["root"], sha, existing)
 28006	    n = cx["env2"].notes.get(cx["rel"])
 28007	    keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
 28008	            if link_target(x)}
 28009	    by_name = {d for d in existing if any(k and k in _drift_c4_key(d) for k in keys)}
 28010	    src = {d: "兩者" if d in by_name else "同提交" for d in same or ()}
 28011	    src.update({d: "計劃名" for d in by_name - set(src)})
 28012	    rows = sorted(src.items(), key=lambda kv: (0 if kv[1] == "兩者" else 1 if kv[0].startswith("code-") else 2, kv[0]))
 28013	    return rows, same
