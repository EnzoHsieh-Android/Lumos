 21427	def _stack_norm_line(code, keep_strings=False):
 21428	    """觸發比對前的正規化(同 _PITFALL_DIFF_PATTERNS 那套,r2 架構對齊席 A5/邊界席 B15):
 21429	    註解開頭的行整行不算(回 None);其餘剝掉字串字面再回(keep_strings=True 給要看字串內容的題,只剝註解)。"""
 21430	    s = code.strip()
 21431	    if not s or s.startswith(("#", "//", "--", "/*", "*")):
 21432	        return None
 21433	    out = code if keep_strings else _strip_string_literals(code)
 21434	    # 行尾註解也剝(r1 外家備援席 f2):`x = 1 // GlobalScope 之後拿掉` 不該觸發;字串已先剝掉,這裡的 // # -- 不會是 URL 或字面
 21435	    out = re.sub(r"/\*.*?\*/", " ", out)
 21436	    out = re.split(r"(?:^|\s)(?://|#|--)(?:\s|$)", out, maxsplit=1)[0]
 21437	    return out
