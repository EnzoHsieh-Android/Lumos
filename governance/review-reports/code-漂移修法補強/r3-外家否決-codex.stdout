 18425	    test_msgs, sym_msgs = [], []
 18426	    try:
 18427	        pdata = load_platforms(root)
 18428	    except Exception:
 18429	        pdata = {"multiplatform": False, "platforms": {}}
 18430	    if pdata.get("multiplatform"):
 18431	        covered = set()
 18432	        for pe in pdata["platforms"].values():
 18433	            # ★"profile" 存的是攤開後的 profile 物件,不是名字★(2026-09-10 修):
 18434	            # 拿它去 TEST_PROFILES 查表 = 用 dict 當 key,直接丟 TypeError 把整支 doctor
 18435	            # 中斷在這一段。名字要用的話在隔壁的 "profile_name"。
