 53609	          and sum(1 for r in rows if r.endswith("(同提交)")) == 3, out)
 53610	    want = [f"{RR}/code-old-done(計劃名)", f"{RR}/aaa(同提交)", f"{RR}/bbb(同提交)", f"{RR}/ccc(同提交)", f"{RR}/{nfd}(計劃名)"]
