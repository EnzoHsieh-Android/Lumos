 53593	    _df_commit(root, "earlier")
 53594	    E = v / "Verification" / "E.md"
 53595	    E.write_text("---\ntype: verification\nstatus: pass\nvalid_under:\n  - 本工作樹(未提交);全套測試\nplan_refs:\n"
 53596	                 "  - \"[[Projects/Done_計劃]]\"\n---\n# E\n", encoding="utf-8")
 53597	    for d in ("aaa", "bbb", "ccc"):
 53598	        for f in ("r1.md", "r2.md", "snapshot.patch"):
 53599	            _nh_file(root, f"{RR}/{d}/{f}", f"{d} {f}\n")
 53600	    _df_commit(root, "feature with reports")
 53601	    first = _nh_git(root, "log", "--diff-filter=A", "--format=%H", "--", f"{_DR_VAULT}/Verification/E.md").stdout.split()[-1]
 53602	    shown = _nh_git(root, "show", "--name-only", "--format=", first).stdout
 53603	    check("①前置:E 第一次提交加了 3 個卷證目錄、每個 3 支檔(9 支);NFD 目錄在磁碟上照 NFD 存著",
 53604	          sum(1 for ln in shown.splitlines() if ln.startswith(f"{RR}/")) == 9
 53605	          and nfd in _os.listdir(root / RR) and not _ud.is_normalized("NFC", nfd), shown)
