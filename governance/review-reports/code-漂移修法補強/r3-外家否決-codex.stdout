 29364	def _delguard_take_removed(ln, fadd, seen, tokens):
 29365	    """一條 `-` 行的 token 收進 tokens(依出現序去重;同檔 `+` 行出現過的、stopword 剔除)。"""
 29366	    for t in _DELGUARD_TOK_RE.findall(ln):
 29367	        if t in _DELGUARD_STOP or t in fadd or t in seen:
 29368	            continue
 29369	        seen.add(t)
 29370	        tokens.append(t)
 29371	
