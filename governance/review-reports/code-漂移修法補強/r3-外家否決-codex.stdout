 29420	def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
 29421	    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
 29422	    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
 29423	    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
 29424	    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
 29425	    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
 29426	    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
 29427	    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
 29428	    import re, subprocess
 29429	    if not tokens:
 29430	        return {}
 29431	    cmd = ["git", "-c", "core.quotePath=off", "grep", "--cached", "-n", "-I", "-w", "-F"]
 29432	    for t in tokens:
 29433	        cmd += ["-e", t]
 29434	    cmd += ["--", ".", f":(exclude){graph_root}"]
 29435	    for d in _DELGUARD_ALL_EXCLUDE_DIRS:
 29436	        cmd += [f":(exclude){d.rstrip('/')}"]
 29437	    r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", cwd=repo_root, timeout=timeout)
 29438	    if r.returncode > 1:
 29439	        raise RuntimeError(f"git grep rc={r.returncode}: {r.stderr.strip()[:200]}")
 29440	    alive = set()
 29530	                                           "nodes": sorted({h["node"] for h in hits})[:10],
 29531	                                           "note": f"tokens={n_tokens} hits={len(hits)} secs={secs:.1f}" + (f" reason={reason}" if reason else "")
 29532	                                                   + _delguard_vendored_note(vendored)}])
 29533	    except Exception:
 29534	        pass
