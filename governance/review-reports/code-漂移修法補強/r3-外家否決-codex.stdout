 54016	def t_delguard_vendored_two_states():
 54017	    """[S5] 代碼審第二輪折入:刪除守衛照「改之前」(HEAD)與「改之後」(暫存區)兩態判工具檔,兩態都讀 git 版本、不讀工作目錄。
 54018	    刪除行照來源路徑:改之前原封不動、而且改之後也原封不動或已不在暫存區(拆除工具鏈)才跳;新增行照目的路徑:改之後原封不動才跳。
 54019	    - ①專案改過的工具檔被 lumos update 蓋回安裝版:改之前不是原封不動 → 專案自己寫的名稱照抽(正確性 F1)。
 54020	    - ②暫存的是專案改過的版本、工作目錄又還原成安裝版:照暫存區判 → 照抽(外家否決 F1、邊界 F3、資安 F1)。
 54021	    - ③反過來:暫存的是純工具更新、工作目錄另有沒暫存的改動 → 照暫存區判 → 跳過、不誤報(外家否決 F1)。
 54022	    - ④git rm --cached 把工具檔移出版控 → 算拆除、跳過(正確性 F3)。
 54023	    - ⑤沒有 HEAD(第一個提交)時改之前當空集合。
 54024	    翻紅釘:刪除行只看改之後 → ①紅;改之後讀工作目錄 → ②③紅;拿掉「已不在暫存區也跳」→ ④紅;改之前讀工作目錄 → ①紅;
 54025	    拿掉「diff 沒碰工具檔就不算」→ ⑥紅。
 54026	    """
 54027	    print("t_delguard_vendored_two_states")
 54028	    m = _load_lumos_inproc()
 54029	    # ①
 54030	    root, hook0 = _dgv_repo()
 54031	    _nh_file(root, "scripts/hooks/pre-push", hook0)            # lumos update 把專案改過的 pre-push 蓋回安裝版
 54032	    _nh_git(root, "add", "-A")
 54033	    rm_skip, add_skip = m._delguard_vendored_skips(str(root))
 54034	    toks, rows, diff, raw = _dgv_run(root)
 54035	    check("①前置:HEAD 的 pre-push 是專案改過的(跟安裝清單不一致)、暫存區的跟安裝清單一致;這次刪掉 zzUserGuardFn",
 54036	          "-zzUserGuardFn" in diff and "scripts/hooks/pre-push" not in m._vendored_state(str(root), "HEAD")[0]
 54037	          and "scripts/hooks/pre-push" in m._vendored_state(str(root), "")[0], diff[:300])
 54038	    check("①lumos update 蓋回專案改過的工具檔:改之前不是原封不動 → 刪掉的名稱照抽", "zzUserGuardFn" in toks
 54039	          and "scripts/hooks/pre-push" not in rm_skip and "scripts/hooks/pre-push" in add_skip, raw + str(rm_skip))
 54040	    # ②
 54041	    root, hook0 = _dgv_repo(names=("zzVendoredOnlyFn",))
 54042	    orig = (root / "scripts" / "lumos").read_bytes()
 54043	    _nh_file(root, "scripts/lumos", "x = 1\n")                   # 專案自己刪掉 zzVendoredOnlyFn、暫存
 54044	    _nh_git(root, "add", "-A")
 54045	    (root / "scripts" / "lumos").write_bytes(orig)               # 工作目錄還原成安裝版(沒暫存)
 54046	    toks, rows, diff, raw = _dgv_run(root)
 54047	    check("②前置:暫存區刪了 zzVendoredOnlyFn、工作目錄跟安裝清單一致", "-def zzVendoredOnlyFn" in diff
 54048	          and "scripts/lumos" in m._vendored_state(str(root))[0] and "scripts/lumos" not in m._vendored_state(str(root), "")[0], diff[:300])
 54049	    check("②照暫存區判:暫存的不是原封不動 → 照抽", "zzVendoredOnlyFn" in toks and rows
 54050	          and "vendored-skip" not in rows[-1].get("note", ""), raw + str(rows))
 54051	    # ③
 54052	    root, hook0 = _dgv_repo(names=("zzVendoredOnlyFn",))
 54053	    _dgv_update_lumos(root)
 54054	    _nh_git(root, "add", "-A")
 54055	    _nh_file(root, "scripts/lumos", "x = 1\nzzLocal = 2\n")      # 沒暫存的本機改動
 54056	    toks, rows, diff, raw = _dgv_run(root)
 54057	    check("③前置:暫存的是純工具更新(跟暫存區的安裝清單一致)、工作目錄對不上", "-def zzVendoredOnlyFn" in diff
 54058	          and "scripts/lumos" in m._vendored_state(str(root), "")[0] and "scripts/lumos" not in m._vendored_state(str(root))[0],
 54059	          diff[:300])
 54060	    check("③照暫存區判:純工具更新跳過、不誤報", "zzVendoredOnlyFn" not in toks and rows
 54061	          and rows[-1].get("note", "").endswith(" vendored-skip=1 files=scripts/lumos"), raw + str(rows))
 54062	    # ④
 54063	    root, hook0 = _dgv_repo(names=("zzVendoredOnlyFn",))
 54064	    _nh_git(root, "rm", "-q", "--cached", "scripts/lumos")
 54065	    toks, rows, diff, raw = _dgv_run(root)
 54066	    check("④前置:暫存區整支刪掉 scripts/lumos、工作目錄還留著", "-def zzVendoredOnlyFn" in diff
 54067	          and (root / "scripts" / "lumos").is_file(), diff[:300])
 54068	    check("④git rm --cached 移出版控:算拆除工具鏈 → 跳過、記一支", "zzVendoredOnlyFn" not in toks and rows
 54069	          and rows[-1].get("note", "").endswith(" vendored-skip=1 files=scripts/lumos"), raw + str(rows))
 54070	    # ⑤
 54071	    import tempfile as _tf, json as _j
 54072	    fresh = Path(_tf.mkdtemp(prefix="gctl-dgvend-fresh-"))
 54073	    body = "def zzA():\n    return 1\n"
 54074	    _nh_file(fresh, "scripts/lumos", body)
 54075	    _nh_file(fresh, ".lumos/vendored.json", _j.dumps({"version": 1, "files": {"scripts/lumos": m._vendored_digest(body.encode())}}))
 54076	    _nh_git(fresh, "init", "-q")
 54077	    _nh_git(fresh, "add", "-A")
 54078	    check("⑤前置:還沒有任何提交", _nh_git(fresh, "rev-parse", "--verify", "HEAD").returncode != 0, "")
 54079	    rs, ad = m._delguard_vendored_skips(str(fresh))
 54080	    check("⑤沒有 HEAD:改之前當空集合(刪除行一支都不跳),新增行照暫存區判", rs == frozenset() and ad == {"scripts/lumos"},
 54081	          f"{rs} {ad}")
 54082	    _nh_git(fresh, "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "i")
 54083	    full = m._delguard_vendored_skips(str(fresh), "diff --git a/scripts/lumos b/scripts/lumos\n")
 54084	    none = m._delguard_vendored_skips(str(fresh), "diff --git a/src/m.py b/src/m.py\n")
 54085	    check("⑥diff 裡沒出現任何工具檔路徑就不算(不跑 git);出現了照算", full == ({"scripts/lumos"}, {"scripts/lumos"})
 54086	          and none == (frozenset(), frozenset()), f"{full} {none}")
 54087	
