 29541	def _delguard_vendored_note(vendored):
 29542	    """治理事件 note 的尾巴:這次跳過的工具自裝檔(漂移修法補強 第 5 節;RETIRE-IF ② 在消費專案數 vendored-skip=)。
 29543	    沒碰到回空字串。檔名最多列 20 支(事件本身已帶提交編號,要看刪了什麼用 git show <提交> -- <檔>)。"""
 29544	    return f" vendored-skip={len(vendored)} files={','.join(vendored[:20])}" if vendored else ""
