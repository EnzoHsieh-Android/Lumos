 18083	        return 2
 18084	    src = _lumos_src(source)
 18085	    vault = find_vault(Path.cwd())
 18086	    if vault is None:
 18087	        # ★三條路同一套說法、同一個退出碼★(2026-09-07 全 repo 審視 #9)
 18088	        return _no_vault_msg()
 18089	    root = vault.parent.parent  # docs/<slug>-knowledge → docs → 專案 root
 18090	    slug = vault.name[:-len("-knowledge")] if vault.name.endswith("-knowledge") else vault.name
 18091	    if root.resolve() == src.resolve():
 18092	        # 來源 repo 自身:範本本地即最新,無 pull/vendor 之需——reinject-only
 18093	        # (2026-08-05 實戰缺口修:改完範本後來源 repo 自己的 CLAUDE.md 原本無路可刷)
 18094	        res = _reinject_all(root, slug, quiet=True)
 18095	        ri = res["CLAUDE.md"]
 18096	        print(f"lumos update — 來源 repo 自身:只刷新紀律區塊({', '.join(f'{k}:{v.status}' for k, v in res.items())})")
 18097	        return 0 if all(v.status in ("updated", "unchanged", "created", "appended") for v in res.values()) else 2
 18098	    print(f"lumos update — 來源 {src} → 本專案 {root}（slug={slug}）")
 18099	    rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
 18100	    return 2 if rc is None else rc
