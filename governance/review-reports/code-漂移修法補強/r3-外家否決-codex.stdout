 27796	def _drift_fix_clean_err(root, repo_rel, raw):
 27797	    """乾淨檢查 → 錯誤或 None:那一篇要在 git 裡有追蹤,而且跟 HEAD 沒差,或現在的指紋等於修復帳裡這一篇最後一筆的
 27798	    after_sha256(改動全是工具自己留下的,同一篇可以一項一項修、修完一起提交)。"""
 27799	    import hashlib
 27800	    ps = _git_paths_nfc(root, repo_rel)
 27801	    if not ps:
