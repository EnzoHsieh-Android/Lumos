 28082	def _drift_c5_test(root, hline):
 28083	    """家節點那條正式行綁的測試 → (測試名清單, 錯誤)。多平台專案帶平台前綴時取識別字(resolve_test_refs)。"""
 28084	    m = INVARIANT_RE.match(hline.strip())
 28085	    if not m:
 28086	        return None, "讀不出家節點的正式合約行"
 28087	    try:
 28088	        pd = load_platforms(root)
 28089	        names = [mm for _pl, mm in resolve_test_refs(m.group(1), pd["platforms"] if pd["multiplatform"] else {},
 28090	                                                      pd["default_platform"])]
 29330	    m = re.search(r" b/(.+)$", ln)
 29331	    c = m.group(1) if m else None
 29332	    # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
 29333	    # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
 29334	    # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
 29335	    vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
 29336	    # 建置產物:任何深度都排(src/robin/ 不撞 bin/ 靠前面那個 "/" )
 29337	    # ★散文與帳本:只認 repo 根★(2026-09-06 代碼審 r1 外家席)——消費專案的
 29338	    # src/docs/parser.py、packages/governance/rules.py 很可能是真程式,不是散文;
 29339	    # 而且 git grep 那側的 :(exclude)docs 本來就只排根目錄、pre-commit 寫的也是
 29340	    # docs/*,三處要同一個語意才不會各自漂。
 29341	    excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
 29342	                            for seg in _DELGUARD_EXCLUDE_DIRS)
 29343	                        or any(c.startswith(seg) for seg in _DELGUARD_PROSE_DIRS)
 29344	                        or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
 29345	    return c, vault, excl
