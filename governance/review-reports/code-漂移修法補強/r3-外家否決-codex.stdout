 53950	def _dgv_update_lumos(root):
 53951	    """模擬 lumos update:工具檔換成新版,安裝清單的指紋跟著換(內容跟清單一致=原封不動)。"""
 53952	    import json as _j
 53953	    m = _load_lumos_inproc()
 53954	    _nh_file(root, "scripts/lumos", "x = 1\n")
 53955	    mp = root / ".lumos" / "vendored.json"
 53956	    if mp.exists():
 53957	        man = _j.loads(mp.read_text(encoding="utf-8"))
 53958	        man["files"]["scripts/lumos"] = m._vendored_digest(b"x = 1\n")
 53959	        mp.write_text(_j.dumps(man) + "\n", encoding="utf-8")
