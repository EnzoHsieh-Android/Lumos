 18078	def cmd_update(source=None, no_pull=False, allow_stale=False):
 18079	    """從 Lumos 唯一源 repo 更新「本專案」vendored 的工具組。
 18080	    = (git pull Lumos) + install-graph-toolchain --target <本專案> --slug <自動偵測>。
 18081	    圖譜資料受 install-graph-toolchain 的 scaffold-skip 保護,不會被動。"""
