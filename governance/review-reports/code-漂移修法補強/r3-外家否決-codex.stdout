 28030	def _drift_c4_more_cmd(sha):
 28031	    """清單列不完時給人貼的 git 指令:列出完整的卷證目錄(照 _drift_git_cmd 的寫法:--literal-pathspecs、路徑不當萬用字元)。
 28032	    查得到提交時列「那個提交加進來或改名進來的」;查不到時列版控裡所有卷證目錄。sha 只會是十六進位,路徑是固定字面。"""
 28033	    rr = "governance/review-reports/"
 28034	    src = (f"show --name-only --diff-filter=AR --format= {sha} -- {rr}" if sha else f"ls-files -- {rr}")
 28035	    return f"git --literal-pathspecs -c core.quotePath=off {src} | cut -d/ -f3 | sort -u"
