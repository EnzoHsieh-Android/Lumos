 54089	def t_delguard_vendored_rename_and_count():
 54090	    """[S5] 代碼審 r1 折入:改名時 `-` 行照來源路徑(a/)判斷要不要跳、`+` 行照目的路徑(b/);vendored-skip 只算真的有
 54091	    `-` 行被跳過的檔。
 54092	    - 工具檔改名離開(scripts/lumos → src/old-lumos):改之前原封不動、改之後已不在暫存區 → 算拆除、跳過(代碼審第二輪改裁;
 54093	      第一輪是「來源不在工作目錄 → 照抽」)。
 54094	    - 專案自己的檔改名成工具檔名(src/app.py → scripts/lumos):`-` 行來源是 src/app.py → 照抽(外家 finder、資安席)。
 54095	    - 第一遍(收 `+` 行回收表)照目的路徑跳:改名進工具檔名時,`+` 行不回收 `-` 行的名稱。
 54096	    翻紅釘:`-` 行改回照目的路徑判斷 → ③紅;第一遍不跳 → ④紅;只要碰到就記(不管有沒有 `-` 行)→ ⑤紅;
 54097	    解析不認 rename from → ②紅。
 54098	    """
 54099	    print("t_delguard_vendored_rename_and_count")
 54100	    m = _load_lumos_inproc()
 54101	    gr = "docs/x-knowledge"
 54102	    skip = frozenset({"scripts/lumos"})
 54103	    # ①②端到端:工具檔(安裝時原樣)改名離開、同時刪掉一個函式
 54104	    root, _hook0 = _dgv_repo(names=("zzVendoredGone",))
 54105	    _nh_file(root, "scripts/lumos", "def zzVendoredGone():\n    return 1\n\n" + "".join(f"k{i} = {i}\n" for i in range(30)))
 54106	    man = root / ".lumos" / "vendored.json"
 54107	    import json as _j
