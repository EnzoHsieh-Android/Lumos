 21440	def _stack_applicability(lines_by_stack, threshold):
 21441	    """lines_by_stack: {棧: [改動內容的行…]}(增行與刪行都算;呼叫端已排除測試檔與非代碼檔)。
 21442	    回 (applicable, meta):applicable={棧: [題目原文…]}(只列適用);meta={棧: [{id, question, applicable, triggered_by}]}(全表)。
 21443	    某棧行數 > threshold → 該棧全表適用(改得多=觸發漏得多,寧多問;triggered_by=["行數>門檻"])。"""
 21444	    applicable, meta = {}, {}
 21445	    for stk, raw_lines in lines_by_stack.items():
 21446	        specs = _STACK_QUESTION_SPECS.get(stk)
 21447	        if not specs:
 21448	            continue
 21449	        norm = [n for n in (_stack_norm_line(l) for l in raw_lines) if n is not None]
 21450	        norm_raw = [n for n in (_stack_norm_line(l, keep_strings=True) for l in raw_lines) if n is not None]
 21451	        over = len(raw_lines) > threshold
 21452	        rows, app = [], []
 21453	        for spec, (qid, pats, pats_raw) in zip(specs, _STACK_TRIGGERS[stk]):
 21454	            hits = []
 21455	            if over:
 21456	                hits = [f"行數>{threshold}"]
 21457	            else:
 21458	                for pat in pats:
 21459	                    if any(pat.search(n) for n in norm):
 21460	                        hits.append(pat.pattern)
 21461	                for pat in pats_raw:   # 看字串的那幾條:對只剝註解的行比
 21462	                    if any(pat.search(n) for n in norm_raw):
 21463	                        hits.append(pat.pattern)
 21464	            rows.append({"id": qid, "question": spec["q"], "applicable": bool(hits), "triggered_by": hits})
 21465	            if hits:
 21466	                app.append(spec["q"])
 21467	        meta[stk] = rows
 21468	        if app:
 21469	            applicable[stk] = app
 21470	    return applicable, meta
