 29570	def _delguard_vendored_skips(root, diff_text=None):
 29571	    """刪除守衛在消費專案要跳過的工具檔 → (刪除行照來源路徑跳的, 新增行照目的路徑跳的);工具鏈本身兩份都是空的。
 29572	
 29573	    ★兩態都讀 git 版本、不讀工作目錄★(代碼審第二輪正確性、外家否決、資安、邊界、架構對齊席):守衛看的是暫存區,
 29574	    改之前=HEAD、改之後=暫存區(`_vendored_state(root, "HEAD")`、`_vendored_state(root, "")`,跟每支檔有家暫存模式同口徑);
 29575	    讀工作目錄的話,暫存的跟工作目錄不一樣時兩個方向都會錯(漏掃專案改過的、誤報純工具更新)。沒有 HEAD(第一個提交)時
 29576	    git show 讀不到 → 改之前是空集合。
 29577	    ★刪除行比推送前分級的 _vendored_skip 多要求「改之前原封不動」★:那支只問改完之後的檔是不是工具原樣(判斷要不要掃它的內容),
 29578	    這裡抽的是被刪掉的行,被刪的行屬於改之前那份——專案改過的工具檔被 lumos update 蓋回安裝版時,改之後原封不動,
 29579	    但刪掉的是專案自己寫的名稱,要照抽。所以:刪除行=改之前原封不動,而且改之後也原封不動或已不在暫存區
 29580	    (拆除工具鏈、改名搬走、git rm --cached 移出版控,刪掉的都是工具自己的行,跳);新增行=改之後原封不動。
 29581	    diff_text:給了而且裡面連一支工具檔的路徑都沒出現 → 不用算(兩態要每支工具檔各跑一次 git show,約 0.6 秒,
 29582	    大多數提交根本沒碰工具檔;字串比對只會多算、不會少算)。"""
 29583	    if _is_toolchain_repo(root) or (diff_text is not None and not any(p in diff_text for p in _VENDORED_ALL)):
 29584	        return frozenset(), frozenset()
 29585	    before = _vendored_state(root, "HEAD")[0]
 29586	    after, after_present = _vendored_state(root, "")
 29587	    return frozenset(p for p in before if p in after or p not in after_present), after
