 53632	def t_drift_c4_code_review_r2():
 53633	    """[S1] 代碼審第二輪折入:c4 證據頁印的一律是現在真的存在的那個目錄名(磁碟上的實際名字);git 裡的名字只拿 NFC 鍵
 53634	    去對應現存目錄。一個現存目錄一行,兩種來源都有就標「兩者」;NFC 鍵對到多個現存目錄才每個都列(正確性 F2、外家否決 F3、
 53635	    邊界 F1)。目錄名裡的 Unicode 格式字元(方向控制、零寬)換成看得見的 \\uXXXX(資安 F3,只在這一處)。
 53636	
 53637	    翻紅釘:同提交印 git 裡的名字 → ②⑤紅;兩種來源照原名對、不照現存目錄合併 → ②紅(macOS)、⑤紅;
 53638	    格式字元不換 → ③紅;NFC 鍵只取一個現存目錄 → ⑥紅。
 53639	    """
 53640	    print("t_drift_c4_code_review_r2")
 53641	    import os as _os, unicodedata as _ud
 53642	    root = _df_repo()
 53643	    v = root / _DR_VAULT
 53644	    RR = "governance/review-reports"
 53645	    nfd = "done-Café"
 53646	    cf = "done-‮gnp​x"
 53647	    E = v / "Verification" / "E.md"
 53648	    E.write_text("---\ntype: verification\nstatus: pass\nvalid_under:\n  - 本工作樹(未提交);全套測試\nplan_refs:\n"
 53649	                 "  - \"[[Projects/Done_計劃]]\"\n---\n# E\n", encoding="utf-8")
 53650	    for d in (nfd, cf, "zzz"):
 53651	        _nh_file(root, f"{RR}/{d}/r1.md", "報告\n")
 53652	    _df_commit(root, "feature with reports")
 53653	    first = _nh_git(root, "log", "--diff-filter=A", "--format=%H", "--", f"{_DR_VAULT}/Verification/E.md").stdout.split()[-1]
 53654	    check("①前置:NFD 目錄與含格式字元的目錄在磁碟上照原樣存著、跟 E 同一個提交加進來", nfd in _os.listdir(root / RR)
 53655	          and cf in _os.listdir(root / RR) and not _ud.is_normalized("NFC", nfd)
 53656	          and _nh_git(root, "show", "--name-only", "--format=", first).stdout.count(f"{RR}/") >= 3, "")
 53657	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4")
 53658	    rows = [ln.strip() for ln in out.splitlines() if ln.strip().startswith(f"{RR}/")]
 53659	    names = [r[len(RR) + 1:r.rindex("(")] for r in rows]
 53660	    shown_cf = "done-\\u202egnp\\u200bx"
 53661	    check("②一個現存目錄一行:NFD 目錄兩種來源都有 → 一行「兩者」,印磁碟上的名字;每一條印出的路徑都精確存在(格式字元那條除外)",
 53662	          rc == 0 and rows.count(f"{RR}/{nfd}(兩者)") == 1 and len(rows) == 3
 53663	          and all(n in _os.listdir(root / RR) for n in names if n != shown_cf), "\n".join(map(ascii, rows)))
 53664	    check("③目錄名裡的方向控制、零寬字元換成看得見的 \\uXXXX,原字元不進終端", f"{RR}/{shown_cf}(兩者)" in rows
 53665	          and "‮" not in out and "​" not in out, "\n".join(map(ascii, rows)))
 53666	    m = _load_lumos_inproc()
 53667	    a, b = "code-Café", "code-Café"
 53668	    orig = m._nodehome_git
 53669	    try:
 53670	        m._nodehome_git = lambda _root, *_a: "".join(f"{RR}/{x}/{f}\0" for x, f in
 53671	                                                     ((a, "r1.md"), (b, "r1.md"), (b, "r2.md"), ("gone", "r1.md"))).encode()
 53672	        got = m._drift_c4_same_commit(str(root), "abc123", {b})
 53673	        m._nodehome_git = lambda _root, *_a: f"{RR}/{a}/r1.md\0".encode()
 53674	        got2 = m._drift_c4_same_commit(str(root), "abc123", {a, b, "other"})
 53675	    finally:
 53676	        m._nodehome_git = orig
 53677	    check("⑤git 裡是 NFC、磁碟上只有 NFD:列的是磁碟上那一個、只列一次;不在的不列", got == [b], ascii(got))
 53678	    check("⑥NFC 鍵對到兩個現存目錄(分正規化的檔案系統):兩個都列", sorted(got2) == sorted([a, b]), ascii(got2))
 53679	
