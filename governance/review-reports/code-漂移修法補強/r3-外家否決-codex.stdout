 28032	def _drift_c4_more_cmd(sha):
 28033	    """同提交清單列不完時給人貼的指令 → 字串,查不到提交回 None。照 _drift_git_cmd 的寫法(--literal-pathspecs、路徑不當萬用字元)。
 28034	    ★列的東西跟證據頁同一套定義★(代碼審第二輪邊界、正確性席):那個提交加進來或改名進來的、路徑至少四段(卷證目錄底下的檔,
 28035	    review-reports 根目錄的散檔不算)、只留現在還在的目錄,去重。sha 只會是十六進位,其他都是固定字面,沒有外來字串。"""
 28036	    if not sha:
 28037	        return None
 28038	    rr = "governance/review-reports"
 28039	    return (f"git --literal-pathspecs -c core.quotePath=off show --name-only --diff-filter=AR --format= {sha} -- {rr}/"
 28040	            f" | awk -F/ 'NF>=4{{print $3}}' | sort -u"
 28041	            f" | while IFS= read -r d; do [ -d \"{rr}/$d\" ] && printf '%s\\n' \"$d\"; done")
 28042	
