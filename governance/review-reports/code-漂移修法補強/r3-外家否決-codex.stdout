 29384	def _delguard_take_removed(ln, fadd, seen, tokens):
 29385	    """一條 `-` 行的 token 收進 tokens(依出現序去重;同檔 `+` 行出現過的、stopword 剔除)。"""
 29386	    for t in _DELGUARD_TOK_RE.findall(ln):
 29387	        if t in _DELGUARD_STOP or t in fadd or t in seen:
 29388	            continue
 29389	        seen.add(t)
 29390	        tokens.append(t)
