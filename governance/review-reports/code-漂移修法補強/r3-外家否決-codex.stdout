 23584	def _nodehome_in_stack_test_dir(path, layout):
 23585	    """在各棧的測試資料夾裡——兩種都要「旁邊的程式目標有同一種檔」,只看資料夾名會把業務資料夾放掉
 23586	    (2026-09-12 代碼審兩輪各席造出的反例:A/B 測試功能模組 ABTests/、Python 專案的 LoadTests/、
 23587	    scriptsTests/ 裡的 .cs、src/androidTest 裡的 .py):
 23588	    ① 頂層資料夾 = <X> 加對照表的結尾樣式(PosTerminalTests/、PosTerminalUITests/、Foo.IntegrationTests/),
 23589	       副檔名屬於貢獻那個結尾的棧,而且頂層的 <X> 資料夾裡有同一種副檔名的檔(Xcode 的 App 配 AppTests、
 23590	       .NET 的 Foo 配 Foo.Tests);資料夾就叫結尾樣式本身(UITests/、IntegrationTests/)的直接認;
 23591	    ② 緊接在 src 下一層的對照表測試資料夾名(app/src/androidTest/…),副檔名屬於貢獻那個名字的棧(Kotlin),
 23592	       而且同一個模組的 src/main 有同一種副檔名的檔——只看 src/main 有沒有同副檔名的檔,混在 src/main 的建置腳本
 23593	       (.py、.sh)就能讓 androidTest 裡同副檔名的檔免家(代碼審第三輪四席各自造出反例)。
 23594	    別種語言的測試輔助檔(Xcode 測試資料夾裡的橋接標頭 .h、Java 寫的 androidTest 輔助檔——對照表沒有 Java 棧)照舊要家:
 23595	    寧可過嚴,逃生口是 node_home.ignore;要認就把那一棧補進測試棧對照表,這裡自動跟著認。
 23596	    layout=_nodehome_layout 的結果。對不上的照舊要家(過嚴、不漏)。"""
 23597	    sufs, under_src = _nodehome_stack_test_dirs()
 23598	    top_exts, main_exts = layout
 23599	    parts = path.split("/")
 23600	    e = _testmap_ext(path)
 23601	    if len(parts) < 2 or not e:
 23602	        return False
 23603	    ext, top = "." + e, parts[0]
