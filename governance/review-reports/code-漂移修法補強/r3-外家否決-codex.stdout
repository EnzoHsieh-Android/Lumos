 18286	def _stack_guess():
 18287	    """副檔名 → {test, symbol, human, symbol_weak}。反查自兩張正典表,結果 cache。
 18288	
 18289	    ★對不到就留空字串,不硬湊★:例如 `.dart` 沒有任何 symbol profile 認領、`.vue` 沒有任何
 18290	    test profile 認領。留空的後果是 init 產出的骨架該欄是空的,而健檢 S3 會唸「你的程式碼是
 18291	    這種副檔名、但設定認的是別的」——比硬填一個不存在的值好,因為那個值只會換來每次讀設定
 18292	    都印一行警告、而且永遠沒人知道為什麼。"""
 18293	    global _STACK_GUESS_CACHE
 18294	    if _STACK_GUESS_CACHE is not None:
 18295	        return _STACK_GUESS_CACHE
 18296	    tp_by_ext, sp_by_ext = {}, {}
 18297	    for name, prof in TEST_PROFILES.items():
 18298	        for ext in (prof.get("exts") or ()):
 18299	            if ext in _STACK_GUESS_SKIP_EXTS:
 18300	                continue
 18301	            cur = tp_by_ext.get(ext)
 18302	            if cur is None or _STACK_PREFER_TEST.get(name, 0) > _STACK_PREFER_TEST.get(cur, 0):
 18303	                tp_by_ext[ext] = name
 18304	    for name, prof in SYMBOL_PROFILES.items():
 18305	        for ext in (prof.get("code_exts") or ()):
 18306	            sp_by_ext.setdefault(ext, [])
 18307	            sp_by_ext[ext].append(name)
 18308	    # 一個副檔名被多個 symbol profile 認領時,★挑跟測試 profile 同一種語言的那個★——
 18309	    # 判準也是反查出來的,不再多開一張表:哪個 symbol profile 的副檔名跟這支測試 profile
 18310	    # 重疊最多,就當它們是同一種語言。實例:`.js` 同時被 csharp(它的清單裡混了 .vue/.js/.sql)
 18311	    # 與 typescript 認領,而 .js 的測試 profile 是 node-jest,跟 typescript 重疊 6 個、
 18312	    # 跟 csharp 只重疊 1 個 → 挑 typescript。沒挑到就退回「有認領的隨便一個」。
 18313	    partner = {}
 18314	    for tname, tprof in TEST_PROFILES.items():
 18315	        texts = set(tprof.get("exts") or ())
 18316	        best, best_n = "", 0
 18317	        for sname, sprof in SYMBOL_PROFILES.items():
 18318	            n = len(texts & set(sprof.get("code_exts") or ()))
 18319	            if n > best_n:
 18320	                best, best_n = sname, n
 18321	        partner[tname] = best
 18322	    out = {}
 18323	    for ext in set(tp_by_ext) | set(sp_by_ext):
 18324	        if ext in _STACK_GUESS_SKIP_EXTS:
 18325	            continue
 18326	        owners = sp_by_ext.get(ext) or []
 18327	        pick = partner.get(tp_by_ext.get(ext, ""), "")
 18328	        sp = pick if pick in owners else (owners[0] if owners else "")
 18329	        # ★猜得弱要講出來★(2026-09-09 代碼審 r2 f4):`.vue`/`.sql`/`.ps1` 只有 csharp 那份
 18330	        # 副檔名清單收了它們(那是「C# 店裡也會有的檔」的意思,不是「這是 C# 專案」)。
 18331	        # 反查因此會把一個以 Vue/SQL/PowerShell 為主的專案猜成 symbol_profile csharp——
 18332	        # 值合法、所有檢查都不唸,等於把 r1 修掉的「猜錯沒人知道」換成更隱蔽的版本。
 18333	        # weak=True 表示「這個 profile 不是為這個副檔名而生的,只是碰巧收了它」。
 18334	        weak = bool(sp) and sp != pick
 18335	        out[ext] = {"test": tp_by_ext.get(ext, ""), "symbol": sp,
 18336	                    "human": _STACK_HUMAN.get(ext, ext), "symbol_weak": weak}
 18337	    _STACK_GUESS_CACHE = out
 18338	    return out
