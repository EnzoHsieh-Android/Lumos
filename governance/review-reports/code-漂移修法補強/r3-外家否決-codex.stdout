 53711	def t_set_conditions_blocks_placeholder_variants():
 53712	    """[S2] 代碼審 r1(邊界 F1)折入、第二輪改裁:lumos set 整欄改 valid_under/revalidate_when 時,佔位字的打錯變體也擋——
 53713	    只擋兩邊都有角括號的:全形角括號(＜卷證＞)、括號內多空白(< 卷證 >)、sha 大小寫(<SHA>)。少一邊角括號的
 53714	    (<卷證、卷證>20個、git-sha>)第二輪起不擋(外家否決 F2、正確性 F4、邊界 F4、資安 F2:正常內容被誤擋);
 53715	    佔位字後面還接別的字的(<卷證 目錄>、<sha 1>、<git-sha>)、一般角括號文字(Map<K,V>、<SHA-1>、List<sha256>)照收。
 53716	
 53717	    翻紅釘:拿掉變體檢查 → ②紅;變體不要求閉括號 → ③紅;sha 不分大小寫拿掉 → ②<SHA> 紅;加回只剩閉括號那一支 → ③紅。
 53718	    """
 53719	    print("t_set_conditions_blocks_placeholder_variants")
 53720	    v = mkvault()
 53721	    write(v, "Verification/V.md", "type: verification\nstatus: pass\nvalid_under: 原本的前提\nrevalidate_when: 原本的回頭條件")
 53722	    p = v / "Verification" / "V.md"
 53723	    raw = p.read_bytes()
 53724	    bad = (("代碼審見 ＜卷證＞", "<卷證>"), ("代碼審見 < 卷證 >", "<卷證>"), ("代碼審見 <卷證＞", "<卷證>"),
 53725	           ("代碼審見 <\u3000卷證\u3000>", "<卷證>"), ("提交 <SHA>;代碼審見 x", "<sha>"), ("提交 <Sha >;x", "<sha>"),
 53726	           ("提交 ＜sha＞", "<sha>"), ("改成 ＜整項新內容>", "<整項新內容>"), ("改成 < 整項新內容 >", "<整項新內容>"))
 53727	    r0 = run(v, "set", "Verification/V", "valid_under", "好的一條")
 53728	    check("①前置:同一篇正常的值寫得進去(擋下不是因為別的原因)", r0.returncode == 0, r0.stdout + r0.stderr)
 53729	    write(v, "Verification/V.md", "type: verification\nstatus: pass\nvalid_under: 原本的前提\nrevalidate_when: 原本的回頭條件")
 53730	    raw = p.read_bytes()
 53731	    for key in ("valid_under", "revalidate_when"):
 53732	        for val, slot in bad:
 53733	            r = run(v, "set", "Verification/V", key, "好的一條", val)
 53734	            check(f"②{key} 值 {val!r}:佔位字的變體 → 回 2、點名是哪個佔位字、檔案不動", r.returncode == 2
 53735	                  and slot in r.stderr and "佔位字" in r.stderr and p.read_bytes() == raw, r.stdout + r.stderr)
 53736	            p.write_bytes(raw)   # 沒擋住時還原,免得一條紅牽連後面每一條
 53737	    ok = ("Map<K,V> 與 <src/lib> 照收;提交 <SHA-1> 與 List<sha256>、<shape>、<卷證目錄> 都不是佔位字;a < b 且 c > d;"
 53738	          "代碼審見 governance/review-reports/code-x 的卷證;sha 值 > 3;commitsha> 這種黏在英文字後面的;"
 53739	          "若卷證>20個就重驗;輸出 git-sha> 時重驗;提交 <git-sha> 之後;<卷證 目錄> 與 <sha 1>;a < sha;見 <卷證 那一段;<整項新內容")
 53740	    r = run(v, "set", "Verification/V", "valid_under", ok)
 53741	    check("③正文裡合法的角括號字樣照樣寫得進去", r.returncode == 0 and ok in p.read_text(encoding="utf-8"), r.stdout + r.stderr)
 53742	
