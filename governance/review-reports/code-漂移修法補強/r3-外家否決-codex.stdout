 29590	def cmd_delguard_check(repo=None, as_json=False):
 29591	    """code 側刪除傳播守衛(advisory):staged diff 抽被刪 token → 兩檔信心 → grep vault 指名過期原句。
 29592	    恆 rc0(內部錯誤/超時皆 fail-open 放行;唯一輸出差異是訊息)。
 29593	    vault-free repo(找不到 graph root)→ 靜默 rc0,不掃。
 29594	    --json 降級契約(超時/內部錯誤皆同款):單行合法 JSON
 29595	    {"tokens": int, "hits": [], "fake_sync": [], "degraded": true, "reason": "timeout"|"error"},rc0。"""
 29596	    import json, os, subprocess, time
 29597	    t0 = time.monotonic()
 29598	    try:  # 亂設的 env 不該讓 pre-commit 印 traceback(fail-open 契約覆蓋設定錯誤)
 29599	        deadline = float(os.environ.get("LUMOS_DELGUARD_DEADLINE", "15.0"))  # 5.0 在本 repo(377 篇+大 diff)仍常超,2026-08-27 一 session 降級多次→15;advisory fail-open,pre-commit 多等幾秒換掃完整
 29600	    except (ValueError, TypeError):
 29601	        deadline = 15.0   # s1-f2:兜底跟預設一致(原 2.0,主值調 15 後落差 7.5 倍→非數值 env 悄悄退化只給 2 秒)
 29602	    def _over():
 29603	        return time.monotonic() - t0 > deadline
 29604	    def _degraded_json(reason, n_tokens):
 29605	        print(json.dumps({"tokens": n_tokens, "hits": [], "fake_sync": [],
 29606	                          "degraded": True, "reason": reason}, ensure_ascii=False))
 29607	    tokens = []
 29608	    try:
 29609	        if os.environ.get("LUMOS_DELGUARD_RAISE"):
 29610	            raise RuntimeError("test hook")
 29611	        root = str(_cochange_repo_root(repo) or os.getcwd())
 29612	        gr = find_vault(Path(root))  # 既有 vault 偵測 helper;找不到→靜默 rc0(vault-free repo 不掃)
 29613	        if not gr:
 29614	            return 0
 29615	        gr_rel = os.path.relpath(gr, root).replace(os.sep, "/")
 29616	        # standalone vault repo(整個 repo 就是 vault,graph_root=".")→ 沒有 code 側可守,
 29617	        # 且 "." 前綴會讓每個檔都判成 vault、路徑相對計算全歪 → 靜默 rc0(2026-08-11 code-loop r1 E)
 29618	        if gr_rel == ".":
 29619	            return 0
 29620	        # diff 前綴固定:使用者 ~/.gitconfig 若設 diff.noprefix / diff.mnemonicPrefix,
 29621	        # 檔頭會變成 `--- app/x` 或 `--- i/app/x`,` b/` 抽檔名整條失效 → token 全漏(r1 D)
 29622	        r = subprocess.run(["git", "-c", "core.quotePath=off",
 29623	                            "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
 29624	                            "diff", "--no-ext-diff", "--no-textconv", "--cached", "-M", "--no-color"],
 29625	                           capture_output=True, text=True, errors="replace", cwd=root,
 29626	                           timeout=max(0.1, deadline - (time.monotonic() - t0)))
 29627	        if r.returncode != 0:
 29628	            # ★不得靜默吞★:git diff 失敗時 r.stdout 恆空,若不擋下去會被
 29629	            # _delguard_parse_diff 解析成「tokens=0」——長得像掃描乾淨的成功結果,
 29630	            # 實際是沒掃到東西的失敗(r2 code-loop 折入:N3①)。丟進既有 except
 29631	            # 才能落成 degraded=true/內部錯誤,而不是假成功。
 29632	            raise RuntimeError(f"git diff rc={r.returncode}: {r.stderr[:200]}")
 29633	        # 消費專案裡「原封不動的工具檔」不抽名稱(漂移修法補強 第 5 節;代碼審 r1 推翻只比檔名、第二輪改成改前改後兩態都讀 git):
 29634	        # 檔名在清單上、內容指紋跟那一版的 .lumos/vendored.json 一致才算;清單不在或讀不懂=一支都不跳。怎麼算見
 29635	        # _delguard_vendored_skips。讀 git 版本每支工具檔一次 git show(有逾時),時間算在這道守衛的 deadline 裡(下面 _over())。
 29636	        # 工具鏈本身那些檔是它自己的程式,照抽
 29637	        rm_skip, add_skip = _delguard_vendored_skips(root, r.stdout)
 29638	        parsed = _delguard_parse_diff(r.stdout, gr_rel, rm_skip, add_skip)
 29639	        tokens = parsed["tokens"][:DELGUARD_TOKEN_CAP]
 29640	        vend = parsed["vendored_skipped"]
 29641	        dropped = len(parsed["tokens"]) - len(tokens)
 29642	        if _over():
 29643	            _delguard_log_degraded(gr, "timeout", len(tokens), vend)
 29644	            if as_json:
 29645	                _degraded_json("timeout", len(tokens))
 29646	            else:
 29647	                print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查超時降級({deadline}s 內沒掃完),先放行;這次結果不完整,已記一筆在治理帳。")
 29648	            return 0
 29649	        rem = max(0.1, deadline - (time.monotonic() - t0))
 29650	        conf = _delguard_confidence(tokens, root, gr_rel, timeout=rem)
 29651	        if _over():
 29652	            _delguard_log_degraded(gr, "timeout", len(tokens), vend)
 29653	            if as_json:
 29654	                _degraded_json("timeout", len(tokens))
 29655	            else:
 29656	                print(f"delguard: 超時降級({deadline}s),放行;本輪掃描不完整(已記治理帳 delguard/degraded)")
 29657	            return 0
 29658	        _trunc = {"hit": False}
 29659	        def _deadline_check():
 29660	            if time.monotonic() - t0 > deadline:
 53540	    _df_commit(root, "feature with reports")
