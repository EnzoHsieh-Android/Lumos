 28101	def _drift_c5_test(root, hline):
 28102	    """家節點那條正式行綁的測試 → (測試名清單, 錯誤)。多平台專案帶平台前綴時取識別字(resolve_test_refs)。"""
 28103	    m = INVARIANT_RE.match(hline.strip())
 28104	    if not m:
 28105	        return None, "讀不出家節點的正式合約行"
 28106	    try:
 28107	        pd = load_platforms(root)
 28108	        names = [mm for _pl, mm in resolve_test_refs(m.group(1), pd["platforms"] if pd["multiplatform"] else {},
 28109	                                                      pd["default_platform"])]
 28110	    except (ValueError, OSError) as ex:
 28111	        return None, f"解不出正式行綁的測試:{ex}"
 28112	    return (names, None) if names else (None, "家節點的正式行沒有綁測試")
