 18103	def _skills_list():
 18104	    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
 18105	    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
 18106	    repo = Path(__file__).resolve().parent.parent
 18107	    d = repo / "skills"
 18108	    if not d.is_dir():
 18109	        return ()
 18110	    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))
