 29336	def _delguard_is_diff_header(ln):
 29337	    """True=這行是 unified diff 的檔頭行(--- a/… / +++ b/… / …/dev/null),不是內容行。
 29338	    ★不可寫成 startswith(("---","+++"))★——被刪的 SQL/Lua 註解行 `-- x` 在 diff 裡長成
 29339	    `--- x`,那樣會被當檔頭吃掉、整行 token 靜默漏抽(2026-08-11 code-loop r1 s5 F6)。"""
 29340	    return (ln.startswith("--- a/") or ln.startswith("+++ b/")
 29341	            or ln.startswith("--- /dev/null") or ln.startswith("+++ /dev/null"))
 29342	
 29343	
 29344	_DELGUARD_TOK_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
 29345	
 29346	
 29347	def _delguard_path_flags(ln, graph_root):
 29348	    """`diff --git` 行 → (b/ 那側路徑, 是不是 vault 的 .md, 是不是排除路徑)。"""
 29349	    m = re.search(r" b/(.+)$", ln)
 29350	    c = m.group(1) if m else None
 29351	    # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
 29352	    # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
 29353	    # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
 29354	    vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
 29355	    # 建置產物:任何深度都排(src/robin/ 不撞 bin/ 靠前面那個 "/" )
 29356	    # ★散文與帳本:只認 repo 根★(2026-09-06 代碼審 r1 外家席)——消費專案的
 29357	    # src/docs/parser.py、packages/governance/rules.py 很可能是真程式,不是散文;
 29358	    # 而且 git grep 那側的 :(exclude)docs 本來就只排根目錄、pre-commit 寫的也是
 29359	    # docs/*,三處要同一個語意才不會各自漂。
 29360	    excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
 29361	                            for seg in _DELGUARD_EXCLUDE_DIRS)
 29362	                        or any(c.startswith(seg) for seg in _DELGUARD_PROSE_DIRS)
 29363	                        or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
 29364	    return c, vault, excl
 29365	
 29366	
 29367	def _delguard_added_tokens(lines, graph_root, vendored_skip):
 29368	    """第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔/工具自裝檔不收(文件提及不算「還活著」)。
 29369	    工具自裝檔照 b/ 目的路徑判斷(`+` 行屬於改完之後那支檔,vendored_skip 由呼叫端給「改之後原封不動」的那一份;
 29370	    改名時 `-` 行的判斷見 _delguard_parse_diff)。"""
 29371	    added, cur, skip, in_binary = {}, None, True, False
 29372	    for ln in lines:
 29373	        if ln.startswith("diff --git"):
 29374	            cur, is_v, is_e = _delguard_path_flags(ln, graph_root)
 29375	            skip = (cur is None) or is_v or is_e or cur.endswith(".md") or cur in vendored_skip
 29376	            in_binary = False
 29377	        elif ln.startswith("Binary files"):
 29378	            in_binary = True
 29379	        elif not (skip or in_binary) and ln.startswith("+") and not _delguard_is_diff_header(ln):
 29380	            added.setdefault(cur, set()).update(_DELGUARD_TOK_RE.findall(ln))
 29381	    return added
 29382	
 29383	
 29384	def _delguard_take_removed(ln, fadd, seen, tokens):
 29385	    """一條 `-` 行的 token 收進 tokens(依出現序去重;同檔 `+` 行出現過的、stopword 剔除)。"""
 29386	    for t in _DELGUARD_TOK_RE.findall(ln):
 29387	        if t in _DELGUARD_STOP or t in fadd or t in seen:
 29388	            continue
 29389	        seen.add(t)
 29390	        tokens.append(t)
 29391	
 29392	
 29393	def _delguard_parse_diff(diff_text, graph_root, vendored_skip=frozenset(), added_skip=None):
 29394	    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
 29395	    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
 29396	    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
 29397	    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
 29398	    2026-08-11 code-loop r1 C);stopword 表剔除;
 29399	    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
 29400	    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
 29401	    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
 29402	    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
 29403	    vendored_skip:`-` 行照來源路徑、這幾支(精確路徑)不看;added_skip:`+` 行(回收表)照目的路徑、這幾支不收,
 29404	    沒給就跟 vendored_skip 同一份——消費專案裡原封不動的工具自裝檔(漂移修法補強 第 5 節,兩份怎麼算見 _delguard_vendored_skips);
 29405	    跟 _DELGUARD_* 排除清單分開(那份有 t_precommit_whitelist_drift_guard 釘著)。
 29406	    ★改名時兩側分開判斷★(代碼審 r1 外家 finder 席、資安席):`-` 行照 a/ 來源路徑(`rename from`),`+` 行照 b/ 目的路徑——
 29407	    只看 b/ 的話,專案自己的 src/app.py 改名成 scripts/lumos 就能讓刪掉的名稱整支被跳過。
 29408	    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
 29409	        ,"vault_diffs": {path: [line...]}
 29410	        ,"vendored_skipped": [path...]}  # 真的有 `-` 行因此被跳過的工具檔(來源路徑;只碰到、只有新增的不算)"""
 29411	    lines = diff_text.splitlines()
 29412	    added = _delguard_added_tokens(lines, graph_root, vendored_skip if added_skip is None else added_skip)
 29413	    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
 29414	    tokens, seen, skipped = [], set(), []
 29415	    vault_diffs, cur, src, is_vault, is_excl, in_binary, in_head = {}, None, None, False, False, False, False
 29416	    for ln in lines:
 29417	        if ln.startswith("diff --git"):
 29418	            cur, is_vault, is_excl = _delguard_path_flags(ln, graph_root)
 29419	            src, in_binary, in_head = cur, False, True
 29420	        elif in_head and ln.startswith("rename from "):
 29421	            src = ln[len("rename from "):]
 29422	        elif ln.startswith("@@"):
 29423	            in_head = False
 29424	        elif ln.startswith("Binary files"):
 29425	            in_binary = True
 29426	        elif in_binary or cur is None or _delguard_is_diff_header(ln) or not ln.startswith(("+", "-")):
 29427	            continue
 29428	        elif is_vault:
 29429	            vault_diffs.setdefault(cur, []).append(ln)
 29430	        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
 29431	        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
 29432	        # (r2 code-loop 折入:N5)
 29433	        elif not (is_excl or cur.endswith(".md")) and ln.startswith("-"):
 29434	            if src in vendored_skip:
 29435	                skipped += [] if src in skipped else [src]
 29436	            else:
 29437	                _delguard_take_removed(ln, added.get(cur) or frozenset(), seen, tokens)
 29438	    return {"tokens": tokens, "vault_diffs": vault_diffs, "vendored_skipped": skipped}
 29439	
 29440	
 29520	    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
 29521	       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
 29522	       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
 29523	       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
 29524	       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
 29525	    import re
 29526	    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
 29527	    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
 29528	    plus = [ln[1:] for ln in diff_lines
 29529	            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
 29530	    minus = [ln[1:] for ln in diff_lines
 29531	             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
 29532	    changed = plus + minus
 29533	    if not changed:
 29534	        return False
 29535	    ms = {c.strip() for c in minus}
 29536	    if any(p.strip() in ms for p in plus):
 29537	        return False
 29538	    return all(item_re.match(c) or key_re.match(c) for c in changed)
