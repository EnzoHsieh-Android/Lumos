 def _drift_c4_dirs(cx, sha):
     """卷證目錄兩種來源都列 → ([(目錄原名, 來源)] 排好序, 同提交清單或 None)。
-    排序:兩者 → code- 開頭(不分來源)→ 其他,同級照字母。兩種來源照原名對(原名不同就各列一行,見 _drift_c4_same_commit)。"""
+    排序:兩者 → code- 開頭(不分來源)→ 其他,同級照字母。兩種來源都是現存目錄名,一個目錄一行(見 _drift_c4_same_commit)。"""
     rr = Path(cx["root"]) / "governance" / "review-reports"
     existing = _drift_c4_existing(rr)
     same = _drift_c4_same_commit(cx["root"], sha, existing)
     n = cx["env2"].notes.get(cx["rel"])
     keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
             if link_target(x)}
     by_name = {d for d in existing if any(k and k in _drift_c4_key(d) for k in keys)}
     src = {d: "兩者" if d in by_name else "同提交" for d in same or ()}
     src.update({d: "計劃名" for d in by_name - set(src)})
     rows = sorted(src.items(), key=lambda kv: (0 if kv[1] == "兩者" else 1 if kv[0].startswith("code-") else 2, kv[0]))
@@ -28021,42 +28023,59 @@ def _drift_c4_evidence(cx):
