 53499	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4", "--old", "未提交", "--new", "x")
 53500	    check("②不收 --old/--new", rc == 2 and E.read_bytes() == raw, out)
 53501	    E.write_text(E.read_text(encoding="utf-8") + "未提交的一行\n", encoding="utf-8")
 53502	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4")
 53503	    check("③筆記有未提交改動也照列(只看不寫,不做乾淨檢查)", rc == 0 and "只列出、不寫檔" in out, out)
 53504	    E.write_bytes(raw)
 53505	    a = _shlex.split(cmd[0])
