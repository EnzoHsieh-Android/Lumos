 18083	def _skills_list():
 18084	    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
 18085	    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
 18086	    repo = Path(__file__).resolve().parent.parent
 18087	    d = repo / "skills"
 18088	    if not d.is_dir():
 18089	        return ()
 18090	    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))
 18091	
