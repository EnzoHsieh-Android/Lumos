 29504	def cmd_delguard_check(repo=None, as_json=False):
 29505	    """code 側刪除傳播守衛(advisory):staged diff 抽被刪 token → 兩檔信心 → grep vault 指名過期原句。
 29506	    恆 rc0(內部錯誤/超時皆 fail-open 放行;唯一輸出差異是訊息)。
 29507	    vault-free repo(找不到 graph root)→ 靜默 rc0,不掃。
 29508	    --json 降級契約(超時/內部錯誤皆同款):單行合法 JSON
 29509	    {"tokens": int, "hits": [], "fake_sync": [], "degraded": true, "reason": "timeout"|"error"},rc0。"""
 29510	    import json, os, subprocess, time
 29511	    t0 = time.monotonic()
 29512	    try:  # 亂設的 env 不該讓 pre-commit 印 traceback(fail-open 契約覆蓋設定錯誤)
 29513	        deadline = float(os.environ.get("LUMOS_DELGUARD_DEADLINE", "15.0"))  # 5.0 在本 repo(377 篇+大 diff)仍常超,2026-08-27 一 session 降級多次→15;advisory fail-open,pre-commit 多等幾秒換掃完整
 29514	    except (ValueError, TypeError):
 29515	        deadline = 15.0   # s1-f2:兜底跟預設一致(原 2.0,主值調 15 後落差 7.5 倍→非數值 env 悄悄退化只給 2 秒)
 29516	    def _over():
 29517	        return time.monotonic() - t0 > deadline
 29518	    def _degraded_json(reason, n_tokens):
 29519	        print(json.dumps({"tokens": n_tokens, "hits": [], "fake_sync": [],
 29520	                          "degraded": True, "reason": reason}, ensure_ascii=False))
 29521	    tokens = []
 29522	    try:
 29523	        if os.environ.get("LUMOS_DELGUARD_RAISE"):
 29524	            raise RuntimeError("test hook")
 29525	        root = str(_cochange_repo_root(repo) or os.getcwd())
 29526	        gr = find_vault(Path(root))  # 既有 vault 偵測 helper;找不到→靜默 rc0(vault-free repo 不掃)
 29527	        if not gr:
 29528	            return 0
 29529	        gr_rel = os.path.relpath(gr, root).replace(os.sep, "/")
 29530	        # standalone vault repo(整個 repo 就是 vault,graph_root=".")→ 沒有 code 側可守,
 29531	        # 且 "." 前綴會讓每個檔都判成 vault、路徑相對計算全歪 → 靜默 rc0(2026-08-11 code-loop r1 E)
 29532	        if gr_rel == ".":
 29533	            return 0
 29534	        # diff 前綴固定:使用者 ~/.gitconfig 若設 diff.noprefix / diff.mnemonicPrefix,
 29535	        # 檔頭會變成 `--- app/x` 或 `--- i/app/x`,` b/` 抽檔名整條失效 → token 全漏(r1 D)
 29536	        r = subprocess.run(["git", "-c", "core.quotePath=off",
 29537	                            "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
 29538	                            "diff", "--no-ext-diff", "--no-textconv", "--cached", "-M", "--no-color"],
 29539	                           capture_output=True, text=True, errors="replace", cwd=root,
 29540	                           timeout=max(0.1, deadline - (time.monotonic() - t0)))
 29541	        if r.returncode != 0:
 29542	            # ★不得靜默吞★:git diff 失敗時 r.stdout 恆空,若不擋下去會被
 29543	            # _delguard_parse_diff 解析成「tokens=0」——長得像掃描乾淨的成功結果,
 29544	            # 實際是沒掃到東西的失敗(r2 code-loop 折入:N3①)。丟進既有 except
 29545	            # 才能落成 degraded=true/內部錯誤,而不是假成功。
 29546	            raise RuntimeError(f"git diff rc={r.returncode}: {r.stderr[:200]}")
 29547	        # 消費專案裡工具自裝的檔不抽名稱(漂移修法補強 第 5 節):純路徑判斷,不讀安裝清單、不跑 git;
 29548	        # 工具鏈本身那些檔是它自己的程式,照抽
 29549	        parsed = _delguard_parse_diff(r.stdout, gr_rel, frozenset() if _is_toolchain_repo(root) else _VENDORED_ALL)
 29550	        tokens = parsed["tokens"][:DELGUARD_TOKEN_CAP]
 29551	        vend = parsed["vendored_skipped"]
 29552	        dropped = len(parsed["tokens"]) - len(tokens)
 29553	        if _over():
 29554	            _delguard_log_degraded(gr, "timeout", len(tokens), vend)
 29555	            if as_json:
 29556	                _degraded_json("timeout", len(tokens))
 29557	            else:
 29558	                print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查超時降級({deadline}s 內沒掃完),先放行;這次結果不完整,已記一筆在治理帳。")
 29559	            return 0
 29560	        rem = max(0.1, deadline - (time.monotonic() - t0))
 29561	        conf = _delguard_confidence(tokens, root, gr_rel, timeout=rem)
 29562	        if _over():
 29563	            _delguard_log_degraded(gr, "timeout", len(tokens), vend)
 29564	            if as_json:
 29565	                _degraded_json("timeout", len(tokens))
 29566	            else:
 29567	                print(f"delguard: 超時降級({deadline}s),放行;本輪掃描不完整(已記治理帳 delguard/degraded)")
 29568	            return 0
 29569	        _trunc = {"hit": False}
 29570	        def _deadline_check():
 29571	            if time.monotonic() - t0 > deadline:
 29572	                _trunc["hit"] = True   # 掃描真的被截斷才算部分結果(delta r2:剛好慢了但掃完不算)
 29573	                return True
 29574	            return False
 29575	        hits = _delguard_vault_scan(tokens, conf, gr, deadline_check=_deadline_check)
 29576	        _partial = _trunc["hit"]   # 外家 r1 M2:掃描被 deadline 截斷回部分結果,不能算 ok
 29577	        _slow = (not _partial) and (time.monotonic() - t0 > deadline)   # delta r3:單一大檔掃完才發現超時=結果完整但慢,記 ok 帶 reason=slow 讓帳看得到
 29578	        _delguard_log_result(gr, "degraded" if _partial else "ok", len(tokens), hits, time.monotonic() - t0, reason=("timeout-partial" if _partial else ("slow" if _slow else None)), vendored=vend)
 29579	        fake = []
 29580	        for path, dl in parsed["vault_diffs"].items():
 29581	            rel = os.path.relpath(os.path.join(root, path), gr).replace(os.sep, "/")
 29582	            if _delguard_purelink(dl) and any(h["node"] == rel for h in hits):
 29583	                fake.append(rel)
 29584	        if as_json:
 29585	            print(json.dumps({"tokens": len(tokens), "dropped": dropped, "hits": hits,
 29586	                              "fake_sync": fake, "degraded": _partial, **({"reason": "timeout-partial"} if _partial else {})}, ensure_ascii=False))   # 外家 r2:部分結果不能宣稱完整
 29587	            return 0
 29588	        if not hits:
 29589	            if dropped:
 29590	                print(f"delguard: 無命中;{dropped} 個符號超 cap 未掃(--json 看已掃全量)")
 29591	            return 0
 29592	        hi = sum(1 for h in hits if h["conf"] == "high")
 29593	        n_hit_tokens = len({t for h in hits for t in h["tokens"]})
 29594	        print(f"提醒:這次刪掉的東西,有 {n_hit_tokens} 個被刪符號還在筆記裡被提到(確定沒別處在用的 {hi} 個/不確定的 {len(hits)-hi} 個)。筆記講的東西已經不在了,讀的人會被誤導。")
 29595	        for h in hits[:DELGUARD_TOP_N]:
 29596	            print(f"  [{h['conf']}] {h['node']}:{h['line_no']} 「{h['line']}」 ← {','.join(h['tokens'])}")
 29597	        rest = len(hits) - min(len(hits), DELGUARD_TOP_N)
 29598	        if rest or dropped:
 29599	            print(f"  …另有 {rest} 處命中/{dropped} 個符號超 cap 未展開(--json 看已掃全量)")
 29600	        for n in fake:
 29601	            print(f"  提醒:{n} 這次只加了連結、正文沒改,但正文還在講已經被刪掉的東西。")
 29602	        print("  退場前自問:這次到底拿掉或改變了什麼?上面每一句,改完之後還是對的嗎?")
 29603	        print("  還對的寫一句為什麼;不對的現在就改掉或標過期。光是幫筆記加連結,不算更新內容。")
 29604	        return 0
 29605	    except subprocess.TimeoutExpired:
 29606	        # git diff/grep 子程序逾時漏出來——那是「超時」不是「內部錯誤」(2026-08-21 體檢 #9:
 29607	        # 當天印的「內部錯誤(TimeoutExpired)」全屬此類,誤導讀者以為壞了)
 29608	        _delguard_log_degraded(locals().get("gr"), "timeout", len(locals().get("tokens", [])), locals().get("vend"))
 29609	        if as_json:
 29610	            _degraded_json("timeout", len(locals().get("tokens", [])))
 29611	        else:
 29612	            print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查超時降級(git 子程序逾時),先放行;這次結果不完整,已記一筆在治理帳。")
 29613	        return 0
 29614	    except Exception as e:
 29615	        _gr = locals().get("gr")
 29616	        if not _gr:   # 例外可能發生在 gr 算出來之前(測試鉤子/早期 git 失敗)→ 自己找 vault 再落帳
 29617	            try:
 29618	                _root = str(_cochange_repo_root(repo) or os.getcwd())
 29619	                _gr = find_vault(Path(_root))
 29620	                # standalone vault(vault 即 repo 根)→ 帳會寫到 repo 外(vault.parent),與主路徑
 29621	                # gr_rel=="." 早退同語意:不落帳(code-loop r1 s2)
 29622	                if _gr and os.path.relpath(_gr, _root).replace(os.sep, "/") == ".":
 29623	                    _gr = None
 29624	            except Exception:
 29625	                _gr = None
 29626	        _delguard_log_degraded(_gr, f"error:{e.__class__.__name__}", len(locals().get("tokens", [])), locals().get("vend"))
 29627	        if as_json:
