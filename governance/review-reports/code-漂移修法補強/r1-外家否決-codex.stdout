 53565	    rows = [ln.strip() for ln in out.splitlines() if ln.strip().startswith(f"{RR}/")]
 53566	    check("⑤git 查不到:寫明「同提交:查不到」,計劃名的照列,範本是 <sha> 與 <卷證>", rc == 0
