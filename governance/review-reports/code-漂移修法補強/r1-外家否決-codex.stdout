 18154	def _link_or_copy_shared(src: Path, dst: Path) -> bool:
 18155	    """開放共用目錄版 _link_or_copy:dst 是「非我方」真目錄(不是 symlink/junction、沒有標記檔)→
 18156	    跳過+印一行,回 False;其餘交給 _link_or_copy(它會把 symlink/空夾/帶標記的複製物重建)。"""
 18157	    import os
 18158	    try:   # 我方裝的(symlink 或 Windows junction,realpath 都會解到 repo 的 skills/<名>)→ 直接重建,別當外方(r1 單reviewer F5)
 18159	        if dst.exists() and Path(os.path.realpath(dst)) == src.resolve():
 18160	            _link_or_copy(src, dst)
 18161	            return True
 18162	    except OSError:
 18163	        pass
 18164	    if dst.is_symlink():
 18165	        # 使用者自己的同名 symlink(指到 lumos skills/ 以外)也不能換掉(r1 外家 #2);指到我方或懸空的才重建
 18166	        try:
 18167	            tgt = dst.resolve(strict=True)
 18168	        except (OSError, RuntimeError):
 18169	            tgt = None
 18170	        mine = src.resolve().parent
 18171	        if tgt is not None and tgt != src.resolve() and mine not in tgt.parents and tgt != mine:
 18172	            print(f"  ⚠ 跳過 {dst}:已有不是 lumos 裝的同名連結(→ {tgt}),不覆蓋(要換成 lumos 版請先自己移走它)", file=sys.stderr)
 18173	            return False
 18174	    elif dst.is_dir():
 18175	        try:
 18176	            empty = not any(os.scandir(dst))
 18177	        except OSError:
 18178	            empty = False
 18179	        if not empty and not (dst / _SKILL_MARKER).exists():
 18180	            print(f"  ⚠ 跳過 {dst}:已有不是 lumos 裝的同名目錄,不覆蓋(要換成 lumos 版請先自己搬走它)", file=sys.stderr)

