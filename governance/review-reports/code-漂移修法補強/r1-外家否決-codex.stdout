 29258	_DELGUARD_STOP = frozenset("if else for while return import class def val var fun void public private static final new this true false null let const function".split())
 29259	# ①建置產物:這份★必須與 pre-commit 的 should_exclude 逐項對齊★(既有漂移守衛在比),
 29260	# 因為兩邊講的是同一件事——那些目錄裡沒有人寫的原始碼。
 29261	_DELGUARD_EXCLUDE_DIRS = ("node_modules/", "bin/", "obj/", "dist/", "build/", "__pycache__/", ".git/")
 29262	# ②散文與帳本:★只有 delguard 排,絕對不要複製到 pre-commit 的 should_exclude★
 29263	# (2026-09-06 代碼審 r1 通才席判 blocker、實測重現:我為了滿足漂移守衛就把 governance/ 一起
 29264	#  抄進 pre-commit,結果 governance/ 底下 28 支真程式全部從「改 code 沒動圖譜就擋」的硬閘裡
 29265	#  掉出去——兩份清單語意根本不同:delguard 那份是「哪裡不算活著的程式」,pre-commit 那份是
 29266	#  「哪些檔改了不必配圖譜」。)
 29267	# 為什麼 delguard 要排:符號被審查卷證或治理帳提到,不代表它還活著,掃它們既不準也很貴。
 29268	# 實測四個常用詞(doctor/lumos/check/node)全 repo 命中 75587 行、7.17 秒,排除後 7336 行、
 29269	# 0.47 秒(15 倍);逾時降級的成本是跟命中行數成正比,不是 token 數。
 29270	# ★docs/ 底下的圖譜本體另有 :(exclude){graph_root} 專門排,這裡多排的是帳本與散文。★
 29271	_DELGUARD_PROSE_DIRS = ("governance/", "docs/")
 29272	_DELGUARD_ALL_EXCLUDE_DIRS = _DELGUARD_EXCLUDE_DIRS + _DELGUARD_PROSE_DIRS
 29273	# 與 pre-commit should_exclude 的 lock 排除規則對齊(`*package-lock.json|*yarn.lock|*pnpm-lock.yaml`)
 29274	_DELGUARD_EXCLUDE_LOCKFILES = ("package-lock.json", "yarn.lock", "pnpm-lock.yaml")
 29275	DELGUARD_TOKEN_CAP = 40  # staged diff 抽出 token 數上限,超額截斷(dropped 計入輸出提示)
 29276	DELGUARD_TOP_N = 10  # CLI 文字輸出逐條列出上限,其餘併入「另有 K 處命中」統計行
 29277	
 29278	
 29279	def _delguard_is_diff_header(ln):
 29280	    """True=這行是 unified diff 的檔頭行(--- a/… / +++ b/… / …/dev/null),不是內容行。
 29281	    ★不可寫成 startswith(("---","+++"))★——被刪的 SQL/Lua 註解行 `-- x` 在 diff 裡長成
 29282	    `--- x`,那樣會被當檔頭吃掉、整行 token 靜默漏抽(2026-08-11 code-loop r1 s5 F6)。"""
 29283	    return (ln.startswith("--- a/") or ln.startswith("+++ b/")
 29284	            or ln.startswith("--- /dev/null") or ln.startswith("+++ /dev/null"))
 29285	
 29286	
 29287	_DELGUARD_TOK_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
 29288	
 29289	
 29290	def _delguard_path_flags(ln, graph_root):
 29291	    """`diff --git` 行 → (b/ 那側路徑, 是不是 vault 的 .md, 是不是排除路徑)。"""
 29292	    m = re.search(r" b/(.+)$", ln)
 29293	    c = m.group(1) if m else None
 29294	    # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
 29295	    # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
 29296	    # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
 29297	    vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
 29298	    # 建置產物:任何深度都排(src/robin/ 不撞 bin/ 靠前面那個 "/" )
 29299	    # ★散文與帳本:只認 repo 根★(2026-09-06 代碼審 r1 外家席)——消費專案的
 29300	    # src/docs/parser.py、packages/governance/rules.py 很可能是真程式,不是散文;
 29301	    # 而且 git grep 那側的 :(exclude)docs 本來就只排根目錄、pre-commit 寫的也是
 29302	    # docs/*,三處要同一個語意才不會各自漂。
 29303	    excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
 29304	                            for seg in _DELGUARD_EXCLUDE_DIRS)
 29305	                        or any(c.startswith(seg) for seg in _DELGUARD_PROSE_DIRS)
 29306	                        or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
 29307	    return c, vault, excl
 29308	
 29309	
 29310	def _delguard_added_tokens(lines, graph_root, vendored_skip):
 29311	    """第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔/工具自裝檔不收(文件提及不算「還活著」)。"""
 29312	    added, cur, skip, in_binary = {}, None, True, False
 29313	    for ln in lines:
 29314	        if ln.startswith("diff --git"):
 29315	            cur, is_v, is_e = _delguard_path_flags(ln, graph_root)
 29316	            skip = (cur is None) or is_v or is_e or cur.endswith(".md") or cur in vendored_skip
 29317	            in_binary = False
 29318	        elif ln.startswith("Binary files"):
 29319	            in_binary = True
 29320	        elif not (skip or in_binary) and ln.startswith("+") and not _delguard_is_diff_header(ln):
 29321	            added.setdefault(cur, set()).update(_DELGUARD_TOK_RE.findall(ln))
 29322	    return added
 29323	
 29324	
 29325	def _delguard_take_removed(ln, fadd, seen, tokens):
 29326	    """一條 `-` 行的 token 收進 tokens(依出現序去重;同檔 `+` 行出現過的、stopword 剔除)。"""
 29327	    for t in _DELGUARD_TOK_RE.findall(ln):
 29328	        if t in _DELGUARD_STOP or t in fadd or t in seen:
 29329	            continue
 29330	        seen.add(t)
 29331	        tokens.append(t)
 29332	
 29333	
 29334	def _delguard_parse_diff(diff_text, graph_root, vendored_skip=frozenset()):
 29335	    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
 29336	    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
 29337	    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
 29338	    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
 29339	    2026-08-11 code-loop r1 C);stopword 表剔除;
 29340	    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
 29341	    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
 29342	    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
 29343	    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
 29344	    vendored_skip:這幾支(精確路徑)兩遍都不看——消費專案裡工具自裝的檔(漂移修法補強 第 5 節,呼叫端決定給不給);
 29345	    跟 _DELGUARD_* 排除清單分開(那份有 t_precommit_whitelist_drift_guard 釘著)。
 29346	    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
 29347	        ,"vault_diffs": {path: [line...]}
 29348	        ,"vendored_skipped": [path...]}  # 這次 diff 碰到並跳過的工具檔"""
 29349	    lines = diff_text.splitlines()
 29350	    added = _delguard_added_tokens(lines, graph_root, vendored_skip)
 29351	    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
 29352	    tokens, seen, skipped = [], set(), []
 29353	    vault_diffs, cur, is_vault, is_excl, in_binary = {}, None, False, False, False
 29354	    for ln in lines:
 29355	        if ln.startswith("diff --git"):
 29356	            cur, is_vault, is_excl = _delguard_path_flags(ln, graph_root)
 29357	            if cur is not None and cur in vendored_skip:
 29358	                is_excl = True
 29359	                skipped += [] if cur in skipped else [cur]
 29360	            in_binary = False
 29361	        elif ln.startswith("Binary files"):
 29362	            in_binary = True
 29363	        elif in_binary or cur is None or _delguard_is_diff_header(ln) or not ln.startswith(("+", "-")):
 29364	            continue
 29365	        elif is_vault:
 29366	            vault_diffs.setdefault(cur, []).append(ln)
 29367	        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
 29368	        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
 29369	        # (r2 code-loop 折入:N5)
 29370	        elif not (is_excl or cur.endswith(".md")) and ln.startswith("-"):
 29371	            _delguard_take_removed(ln, added.get(cur) or frozenset(), seen, tokens)
 29372	    return {"tokens": tokens, "vault_diffs": vault_diffs, "vendored_skipped": skipped}
 29373	
 29374	
 29375	def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
 29376	    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
 29377	    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
 29378	    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
 29379	    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
 29380	    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
 29381	    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
 29382	    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
 29383	    import re, subprocess
 29384	    if not tokens:
 29385	        return {}
 29386	    cmd = ["git", "-c", "core.quotePath=off", "grep", "--cached", "-n", "-I", "-w", "-F"]
 29387	    for t in tokens:
 29388	        cmd += ["-e", t]
 29389	    cmd += ["--", ".", f":(exclude){graph_root}"]
 29390	    for d in _DELGUARD_ALL_EXCLUDE_DIRS:
 29391	        cmd += [f":(exclude){d.rstrip('/')}"]
 29392	    r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", cwd=repo_root, timeout=timeout)
 29393	    if r.returncode > 1:
 29394	        raise RuntimeError(f"git grep rc={r.returncode}: {r.stderr.strip()[:200]}")
 29395	    alive = set()
 29396	    pats = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 29397	    for line in r.stdout.splitlines():
 29398	        # ★只對內容域配 token★:git grep 輸出是 `path:lineno:content`,連路徑一起配
 29399	        # 會被檔名撞名誤降級(刪掉 Login() → app/Login.kt 這個路徑本身讓 Login 判 low,
 29400	        # 2026-08-11 code-loop r1 B)。len<3 的行(如 `Binary file … matches`)直接丟。
 29401	        parts = line.split(":", 2)
 29402	        if len(parts) < 3:
 29403	            continue
 29404	        content = parts[2]
 29405	        for t, p in pats.items():
 29406	            if t not in alive and p.search(content):
 29407	                alive.add(t)
 29408	    return {t: ("low" if t in alive else "high") for t in tokens}
 29409	
 29410	
 29411	def _delguard_vault_scan(tokens, conf, graph_root_abs, deadline_check=None):
 29412	    """回 [{"node": "Systems/憑證.md", "folder": "Systems", "line_no": int,
 29413	            "line": str(strip,截 160 字), "tokens": [..], "conf": "high"|"low"}...]
 29414	       排序: (conf!=high, folder!="Systems", node, line_no)——高信心先、Systems 先。
 29415	       deadline_check: 選用 callable(),os.walk 外層迴圈每檔呼叫一次;回 True 立即
 29416	       return 目前累積 hits(部分結果,呼叫端已知逾時語意)。"""
 29417	    import re, os
 29418	    if not tokens:
 29419	        return []
 29420	    rx = re.compile(r"\b(?:" + "|".join(map(re.escape, tokens)) + r")\b", re.ASCII)
 29421	    per = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 29422	    hits = []
 29423	    for dirpath, _dirs, files in os.walk(graph_root_abs):
 29424	        for fn in files:
 29425	            if deadline_check is not None and deadline_check():
 29426	                hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29427	                return hits
 29428	            if not fn.endswith(".md"):
 29429	                continue
 29430	            fp = os.path.join(dirpath, fn)
 29431	            rel = os.path.relpath(fp, graph_root_abs)
 29432	            folder = rel.split(os.sep, 1)[0]
 29433	            try:
 29434	                text = open(fp, encoding="utf-8", errors="replace").read()
 29435	            except OSError:
 29436	                continue
 29437	            for i, line in enumerate(text.splitlines(), 1):
 29438	                # 單巨檔也要能中止:只在 os.walk 外層檢查的話,一份幾十萬行的節點會整份掃完
 29439	                # 才輪到下一次檢查,deadline 直接超支(2026-08-11 code-loop r1 H)
 29440	                if deadline_check is not None and i % 2000 == 0 and deadline_check():
 29441	                    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29442	                    return hits
 29443	                if not rx.search(line):
 29444	                    continue
 29445	                ts = [t for t, p in per.items() if p.search(line)]
 29446	                hits.append({"node": rel.replace(os.sep, "/"), "folder": folder, "line_no": i,
 29447	                             "line": line.strip()[:160], "tokens": ts,
 29448	                             "conf": "high" if any(conf.get(t) == "high" for t in ts) else "low"})
 29449	    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29450	    return hits
 29451	
 29452	
 29453	def _delguard_purelink(diff_lines):
 29454	    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
 29455	       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
 29456	       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
 29457	       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
 29458	       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
 29459	    import re
 29460	    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
 29461	    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
 29462	    plus = [ln[1:] for ln in diff_lines
 29463	            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
 29464	    minus = [ln[1:] for ln in diff_lines
 29465	             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
 29466	    changed = plus + minus
 29467	    if not changed:
 29468	        return False
 29469	    ms = {c.strip() for c in minus}
 29470	    if any(p.strip() in ms for p in plus):
 29471	        return False
 29472	    return all(item_re.match(c) or key_re.match(c) for c in changed)
 29473	
 29474	
 29475	def _delguard_vendored_note(vendored):
 29476	    """治理事件 note 的尾巴:這次跳過的工具自裝檔(漂移修法補強 第 5 節;RETIRE-IF ② 在消費專案數 vendored-skip=)。
 29477	    沒碰到回空字串。檔名最多列 20 支(事件本身已帶提交編號,要看刪了什麼用 git show <提交> -- <檔>)。"""
 29478	    return f" vendored-skip={len(vendored)} files={','.join(vendored[:20])}" if vendored else ""
 29479	
