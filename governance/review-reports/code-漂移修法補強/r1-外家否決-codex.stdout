 27883	def _drift_fix_c2(cx):
 27884	    """c2 --close:status 改成 Issue 的結案值、正文標題之後加結案橫幅(專案的 Issue 寫法:第一段就寫已結案)。"""
 27885	    import datetime
 27886	    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
 27887	    fm, ok = _drift_fm_status(lines, fe, o["status"])
 27888	    banner = (f"> 已結案({datetime.date.today().isoformat()},{o['status']}):{o['reason'].strip().rstrip('。')}。"
 27889	              "以下是當時的排查紀錄,不是現況。")
 27890	    body, had = _drift_close_banner(lines[fe + 1:], banner)
 27891	    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c2"),
 27892	            "extra": {}, "texts": [] if had else [(banner, "body")],
 27893	            "msg": f"status 改成 {o['status']}" + (";第一段已經是已結案橫幅,沒再加" if had else ",正文加了結案橫幅")}, None
