         txt += f",由 [[{link}]] 解決" if st == "pass" else f",參考 [[{link}]]"
+    if o.get("reason") is not None:     # 三種寫法都一樣接在最後;理由裡的 [[連結]] 不驗存在(同 c2;漂移修法補強 第 4 節)
