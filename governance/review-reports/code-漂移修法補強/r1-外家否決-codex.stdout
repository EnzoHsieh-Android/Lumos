 18005	def _vendor_toolchain(src, root, slug, no_pull=False, allow_stale=False):
 18006	    """從 Lumos 來源 src vendor 工具組到專案 root(python 單一源 scaffold + hooks + 結尾自癒)。
 18007	    回傳 0;來源無效回傳 None。圖譜資料受 _scaffold_project 的 skip 保護不被動。
 18008	    cmd_update / cmd_init(--with-hooks) 共用。"""
 18009	    import subprocess, shutil, filecmp
 18010	    installer = src / "scripts" / "install-graph-toolchain.sh"  # 仍作來源有效性探針(薄殼亦在)
 18011	    if not installer.exists():
 18012	        print(f"擋下:找不到 Lumos 工具鏈的來源({src} 底下沒有安裝腳本)。\n"
 18013	              f"  三種解法擇一:--source <路徑> 指定、設環境變數 $LUMOS_HOME、或 clone 到 ~/harness/lumos-toolchain",
 18014	              file=sys.stderr)
 18015	        return None
 18016	    if not no_pull:
 18017	        rc_p = _pull_source_or_abort(src, allow_stale)
 18018	        if rc_p is None:
 18019	            return None                      # fail-closed:一個檔都還沒動就退場
 18020	    # 安裝邏輯收進 python 單一源(scaffold + hooks);bash 安裝器僅留薄殼。
 18021	    _scaffold_project(root, slug)
 18022	    _init_additive_setup(root)     # 只加不覆寫;掛在這裡讓 `lumos update` 也能把設定骨架補給既有專案
 18023	    _set_hooks_path(root)          # 全域同步★不在這裡★——要等下面的 copy2 自癒把 vendored 檔換新
 18024	    rc = 0
 18025	    _py314_upgrade = _py314_upgrade_pending(root)
 18026	    # 結尾 diff 自癒:python 端逐檔比對 src↔target,差異即補(可安全覆寫)。
 18027	    # ★只複製精確清單上的檔★(第三輪外家否決席:原本整個目錄照來源 rglob,來源裡沒進版控的檔也被裝進去,
 18028	    # 可是跳過清單只列受版控的檔——裝進去的檔不在清單上,消費專案又把它當成自己的程式掃)。清單跟來源受版控的檔
 18029	    # 是否一致,由 t_vendored_file_list_matches_what_install_ships 守
 18030	    toolkit = list(_VENDORED_TOOLKIT) + list(_VENDORED_TREE_FILES)
 18031	    healed = []
 18032	    for rel in toolkit:
 18033	        s, t = src / rel, root / rel
 18034	        if not s.exists():
 18035	            continue
 18036	        if (not t.exists()) or not filecmp.cmp(s, t, shallow=False):
 18037	            t.parent.mkdir(parents=True, exist_ok=True)
 18038	            shutil.copy2(s, t)
 18039	            if s.stat().st_mode & 0o111:
 18040	                t.chmod(t.stat().st_mode | 0o111)
 18041	            healed.append(rel)
 18042	    if healed:
 18043	        print(f"  結尾自癒:補齊 installer 漏的 {len(healed)} 檔 → {', '.join(healed)}")
 18044	    else:
 18045	        print("  ✓ 結尾自癒檢查:工具組完全對齊(無漏)")
 18046	    if _py314_upgrade and "scripts/hooks/pre-commit" in healed:
 18047	        print(_PY314_UPGRADE_NOTICE)
 18048	    # 記下工具檔的內容指紋:風險掃描與健檢只跳過「內容跟這裡一模一樣」的工具檔(r3 併發資源席)
 18049	    _vendored_manifest_write(root)
 18050	    # 範本已是最新(copy2 迴圈完成) → reinject 紀律區塊(CLAUDE.md + Codex 指示檔,d1)
 18051	    _reinject_all(root, slug)
 18052	    # ★全域同步放在這裡★(2026-09-06 全 repo 審視 #5):要等上面的 copy2 自癒把 vendored hook
 18053	    # 換成來源的新版之後才同步出去,否則 `lumos update` 會拿更新前的舊副本覆蓋全域 hooks。
 18054	    _sync_global_from_project(root)
 18055	    return rc
