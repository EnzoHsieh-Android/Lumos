 27633	_DRIFT_PLACEHOLDER_RE = re.compile(r"<(?:為什麼[^<>\n]{0,30}|sha|卷證)>")
 27634	
 27635	
 27636	def _drift_placeholder_err(text, what):
 27637	    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
 27638	    Issue 標成結案、理由是佔位字)。只認 _drift_fix_hint 與 c4 證據頁真的印過、而且會被貼進 --reason/--new 的那幾種
 27639	    (為什麼…、sha、卷證);`Map<K,V>`、`<src/lib>` 這種真理由照收(代碼審 r2 正確性席、r3 邊界席)。"""
 27640	    m = _DRIFT_PLACEHOLDER_RE.search(text or "")
 27641	    return f"{what} 裡還留著提示的佔位字「{m.group(0)}」——換成真的內容再跑" if m else None
 27642	
 27643	
 27644	def _drift_sh(v, node=False):
 27645	    """印給人照貼的指令裡的一個參數:只由文字、數字(含中日韓文字)、底線與 ./@%+=:,- 組成就原樣,其他一律 shlex.quote
 27646	    (代碼審 r1 資安席:檔名帶 $(…)、; 或反引號的筆記,照貼提示就會執行攻擊者的指令;正確性席:帶空白會被切成兩個參數)。
 27647	    不直接全部 _sh_quote:它把中文也當危險字元,圖譜裡幾乎每條提示都會被包上引號;其他字元一律交給 _sh_quote。
 27648	    node=True(drift fix 的節點參數):以 - 開頭會被當成選項,加引號也沒用(shell 會拿掉引號),補成 ./ 開頭——
 27649	    _drift_fix_target 認得這個寫法(代碼審 r2 資安席)。"""
 27650	    v = str(v)
 27651	    if node and v.startswith("-"):
 27652	        v = "./" + v
 27653	    return v if v and re.fullmatch(r"[\w./@%+=:,-]+", v) else _sh_quote(v)
 27654	
