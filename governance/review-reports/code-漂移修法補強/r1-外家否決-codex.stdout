 27620	                if tail != b"\n":
 27621	                    with open(fp, "a", encoding="utf-8") as fh:
 27622	                        fh.write("\n")
 27623	        except OSError as ex:
 27624	            err = f"補不了檔尾換行:{ex}"
 27625	    if err:
 27626	        print(f"擋下:{err}", file=sys.stderr)
 27627	        return 2
 27628	    return _jsonl_append_verified(fp, rec, "id", rec["id"])
