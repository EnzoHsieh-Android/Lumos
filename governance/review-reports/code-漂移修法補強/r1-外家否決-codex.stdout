 53572	def t_set_conditions_blocks_drift_placeholders():
 53573	    """[S2] lumos set 整欄改 valid_under/revalidate_when,值裡有 <整項新內容>、<卷證> 或 <sha> 任一個 → 擋下、點名是哪一個、
 53574	    檔案不動;其他輸入(空值、多行、合法的角括號字樣)的行為與訊息跟改前一樣。
 53575	
 53576	    翻紅釘:_SET_COND_SLOTS 改回只有 <整項新內容> → ②<卷證>、<sha> 紅;訊息不點名 → ②紅;<整項新內容> 的訊息改了 → ③紅。
 53577	    """
 53578	    print("t_set_conditions_blocks_drift_placeholders")
 53579	    v = mkvault()
 53580	    write(v, "Verification/V.md", "type: verification\nstatus: pass\nvalid_under: 原本的前提\nrevalidate_when: 原本的回頭條件")
 53581	    p = v / "Verification" / "V.md"
 53582	    raw = p.read_bytes()
 53583	    m = _load_lumos_inproc()
 53584	    check("①前置:三個佔位字都在同一份常數、預填指令用的是第一個", tuple(m._SET_COND_SLOTS) == ("<整項新內容>", "<卷證>", "<sha>")
 53585	          and m._SET_COND_SLOT == "<整項新內容>", str(getattr(m, "_SET_COND_SLOTS", None)))
 53586	    for key in ("valid_under", "revalidate_when"):
 53587	        for slot in ("<整項新內容>", "<卷證>", "<sha>"):
 53588	            r = run(v, "set", "Verification/V", key, "好的一條", f"提交 abc;代碼審見 {slot}")
 53589	            check(f"②{key} 值裡留著 {slot}:回 2、點名、檔案不動", r.returncode == 2 and f"還留著 {slot}(" in r.stderr
 53590	                  and p.read_bytes() == raw, r.stdout + r.stderr)
 53591	    r = run(v, "set", "Verification/V", "valid_under", "<整項新內容>")
 53592	    check("③<整項新內容> 的訊息跟改前一字不差", r.returncode == 2 and r.stderr.strip()
 53593	          == "擋下:值裡還留著 <整項新內容>(drift fix 證據頁的佔位字)——換成那一項改寫後的整句,檔案沒動", r.stderr)
 53594	    r = run(v, "set", "Verification/V", "valid_under", "提交 <sha>;代碼審見 <卷證>")
 53595	    check("③兩個一起留著:兩個都點名", r.returncode == 2 and "還留著 <卷證>、<sha>(" in r.stderr and p.read_bytes() == raw, r.stderr)
 53596	    r = run(v, "set", "Verification/V", "valid_under", "")
 53597	    check("④空值:照舊擋、訊息不變", r.returncode == 2 and "的每一條都不能是空的" in r.stderr and p.read_bytes() == raw, r.stderr)
 53598	    r = run(v, "set", "Verification/V", "valid_under", "第一行\n第二行")
 53599	    check("④多行:照舊擋、訊息不變", r.returncode == 2 and "一條條件只能一行" in r.stderr and p.read_bytes() == raw, r.stderr)
 53600	    r = run(v, "set", "Verification/V", "valid_under", "Map<K,V> 與 <src/lib> 照收;提交 <SHA-1> 大寫不是佔位字")
 53601	    check("⑤合法的角括號字樣照收", r.returncode == 0 and "Map<K,V> 與 <src/lib>" in p.read_text(encoding="utf-8"),
 53602	          r.stdout + r.stderr)
