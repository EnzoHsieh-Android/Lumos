 17995	def _py314_upgrade_pending(root):
 17996	    """消費專案還沒升級到最低 Python 3.14 的版本(舊的 pre-commit 還沒用 python-path)→ True;複製完要印一次升級注意
 17997	    (Projects/最低Python版本改3.14_計劃 做法第 8 點;判斷不必另存狀態)。只有新版程式執行 update 時走得到這裡。"""
 17998	    old_pc = Path(root) / "scripts" / "hooks" / "pre-commit"
 17999	    try:
 18000	        return old_pc.is_file() and "python-path" not in old_pc.read_text(encoding="utf-8", errors="replace")
 18001	    except OSError:
 18002	        return False
