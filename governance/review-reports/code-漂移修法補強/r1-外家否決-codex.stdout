 18134	    # 擋在這個變動原語,不論從哪個指令進來都擋得住。
 18135	    if _refuse_if_probe("install-skills"):
 18136	        return
 18137	    repo = Path(__file__).resolve().parent.parent
 18138	    dest = Path.home() / ".claude" / "skills"
 18139	    for s in _SKILLS:
 18140	        src = repo / "skills" / s
 18141	        if src.is_dir():
 18142	            _link_or_copy(src, dest / s)
 18143	            print(f"  ✓ skill {s}")
 18144	    # Codex 也讀同一個開放標準(agentskills.io):使用者層 ~/.agents/skills/(2026-09-04 隔離 HOME 實測會載入)。
 18145	    # ★開放共用目錄★:既有真目錄只有帶我方標記檔才重建,否則跳過+warn(別人的 skill 不能刪)。
