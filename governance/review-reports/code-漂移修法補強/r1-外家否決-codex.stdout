 29635	_ARCH_IDIOM_SKILL = {"kt": "kotlin-idioms", "kts": "kotlin-idioms", "cs": "csharp-idioms", "vue": "vue-idioms",
 29636	                     "ts": "vue-idioms", "js": "vue-idioms", "swift": "swift-idioms", "py": "python-idioms",
