 18362	def _stack_ext_counts(root):
 18363	    """數 repo 裡各種程式碼副檔名各有幾個檔。回 {ext: n}。
 18364	
 18365	    ★用 os.walk 就地剪枝,不是 rglob 之後再過濾★(r1 單reviewer f5,實測):
 18366	    rglob 會先把 node_modules 底下 2000 個檔全部走過一遍才被丟掉——略過名單對它想排除的
 18367	    正是最大的那幾個目錄完全沒省到。健檢每次都跑這段,大型專案會隨依賴目錄大小線性變慢。"""
 18368	    import os as _os
 18369	    counts = {}
 18370	    known = _stack_guess()
 18371	    # ★lumos 自己安裝進來的檔不算這個專案的技術棧★(2026-09-10,一個小 Vue 專案上實撞):
 18372	    # init 會把 CLI、自己的測試檔和五支 hook 複製到消費專案的 scripts/ 底下,那是八個 .py。
 18373	    # 那個專案自己只有六個 .js,於是健檢反過來唸「你有 8 個 .py,測試設定卻只認 .js」——
 18374	    # 舉的證據全是 lumos 自己的檔,而且專案愈小愈容易被唸,正好唸在剛接入的人臉上。
 18375	    # ★只跳過工具確實安裝的那幾支檔(精確檔名,見 _VENDORED_ALL)★,同目錄底下專案自己的檔照樣算
 18376	    # ——第一版照目錄前綴跳過,代碼審 r1 抓到專案自己的 hook 程式也被一起跳過。
 18377	    _base = _os.path.abspath(str(root))
 18378	    # 工具鏈本體那裡 scripts/lumos 就是產品,一支都不跳;消費專案只跳「內容跟安裝時一模一樣」的工具檔
 18379	    _skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root)[0]
 18380	    for dirpath, dirnames, filenames in _os.walk(_base):
 18381	        dirnames[:] = [d for d in dirnames if not _stack_scan_skip(d)]
 18382	        rd = _os.path.relpath(dirpath, _base)
 18383	        for fn in filenames:
 18384	            ext = _os.path.splitext(fn)[1].lower()
 18385	            if ext not in known:
 18386	                continue
 18387	            if _skip and _posix_norm(fn if rd == "." else _os.path.join(rd, fn)) in _skip:
 18388	                continue
 18389	            counts[ext] = counts.get(ext, 0) + 1
 18390	    return counts
