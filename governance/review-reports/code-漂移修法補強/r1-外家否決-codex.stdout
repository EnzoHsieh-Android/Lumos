 53637	def t_drift_fix_c3_reason():
 53638	    """[S4] drift fix --kind c3 帶 --reason:補的那一行最後接「;理由:<去頭尾空白的理由>」,三種寫法(pass+--by、其他+--by、
 53639	    沒 --by)都一樣;沒給照舊。理由的長度、單行、佔位字規則跟 c2 相同;改法提示帶 [--reason "…"]。
 53640	
 53641	    翻紅釘:_DRIFT_FIX_ALLOWED["c3"] 拿掉 reason → ②紅(不收 --reason);_drift_fix_c3_args 拿掉佔位字檢查 → ③佔位字紅;
 53642	    理由不去空白 → ②紅;只在其中一種寫法接 → ②另兩種紅。
 53643	    """
 53644	    print("t_drift_fix_c3_reason")
 53645	    import datetime
 53646	    today = datetime.date.today().isoformat()
 53647	    root = _df_repo()
 53648	    v = root / _DR_VAULT
 53649	    V = v / "Verification"
 53650	    ref = 'plan_refs:\n  - "[[Projects/Done_計劃]]"\ntags:\n  - type/verification\n  - status/pending'
 53651	    for n in ("A", "B", "C", "D"):
 53652	        write(v, f"Verification/{n}.md", "type: verification\nstatus: pending\n" + ref, body=f"# {n}\n內容\n")
 53653	    _df_commit(root, "c3 reason cases")
 53654	    check("①前置:四篇第 3 行都是 c3", all([f["line"] for f in _df_find(v, "c3", f"Verification/{n}.md")] == [3]
 53655	                                       for n in "ABCD"), "")
 53656	    raw = (V / "A.md").read_bytes()
 53657	    for bad, why in (("abc", "4 到 200"), ("第一行\n第二行", "4 到 200"), ("<為什麼算解決,附提交或測試>", "佔位字"),
 53658	                     ("見 <卷證> 那份", "佔位字")):
 53659	        rc, out = _df_fix(v, "Verification/A", "3", "--kind", "c3", "--status", "pass", "--reason", bad)
 53660	        check(f"③理由 {bad!r} 不合規:回 2({why})、不寫", rc == 2 and why in out and (V / "A.md").read_bytes() == raw, out)
 53661	    cases = (("A", ["--status", "pass", "--by", "Done_計劃"], "pass", ",由 [[Projects/Done_計劃]] 解決"),
 53662	             ("B", ["--status", "stale", "--by", "Systems/Pay"], "stale", ",參考 [[Systems/Pay]]"),
 53663	             ("C", ["--status", "abandoned"], "abandoned", ""))
 53664	    for n, args, st, mid in cases:
 53665	        rc, out = _df_fix(v, f"Verification/{n}", "3", "--kind", "c3", *args, "--reason", "  主線上已驗過,見 [[不存在的筆記]]  ")
 53666	        t = (V / f"{n}.md").read_text(encoding="utf-8")
 53667	        check(f"②{n}({st}):行尾接「;理由:<去空白的理由>」、理由裡的連結不驗", rc == 0
 53668	              and t.endswith(f"{today} 狀態改為 {st}(存量漂移 c3){mid};理由:主線上已驗過,見 [[不存在的筆記]]\n"), out + repr(t[-160:]))
 53669	    rc, out = _df_fix(v, "Verification/D", "3", "--kind", "c3", "--status", "superseded")
 53670	    check("④沒給理由照舊", rc == 0 and (V / "D.md").read_text(encoding="utf-8").endswith(
 53671	        f"{today} 狀態改為 superseded(存量漂移 c3)\n"), out)
 53672	    m = _load_lumos_inproc()
 53673	    check("⑤改法提示帶 [--reason \"…\"]", m._drift_fix_hint("c3", "Verification/V.md", 3)[0].endswith('[--reason "…"]'),
 53674	          m._drift_fix_hint("c3", "Verification/V.md", 3)[0])
 53675	
