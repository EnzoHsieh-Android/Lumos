 17803	def _diff_range_ends(root, diff_range):
 17804	    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
 17805	    import subprocess
 17806	    r = str(diff_range).strip()
 17807	    if "..." in r:
 17808	        a, b = r.split("...", 1)
 17809	        a, b = a or "HEAD", b or "HEAD"
 17810	        try:
 17811	            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
 17812	                                cwd=str(root), timeout=_disp_git_timeout())
 17813	            return (mb.stdout.strip() or a), b
 17814	        except (OSError, subprocess.TimeoutExpired):
 17815	            return a, b
 17816	    if ".." in r:
 17817	        a, b = r.split("..", 1)
 17818	        return (a or "HEAD"), (b or "HEAD")
 17819	    return r, None
