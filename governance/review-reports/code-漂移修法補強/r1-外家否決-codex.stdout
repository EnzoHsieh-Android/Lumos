 18096	def _link_or_copy(src: Path, dst: Path):
 18097	    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
 18098	    import os, shutil, subprocess
 18099	    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
 18100	    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
 18101	    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
 18102	    if dst.is_symlink():
 18103	        dst.unlink()                                  # Unix symlink
 18104	    elif dst.is_dir():
 18105	        try:
 18106	            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
 18107	        except OSError:
 18108	            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
 18109	    elif dst.exists():
 18110	        dst.unlink()
