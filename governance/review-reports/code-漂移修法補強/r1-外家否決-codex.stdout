 53508	          r.stdout + r.stderr)
 53509	    filled = tpl.replace("<卷證>", "governance/review-reports/code-done") + ";全套測試"
 53510	    r = run(v, "set", "Verification/E", "valid_under", filled, "已在 main 的前提", "釘在提交 abc 的乾淨工作樹")
 53511	    check("⑤填好整句照貼:改好、c4 消失", r.returncode == 0 and not _df_find(v, "c4", "Verification/E.md")
 53512	          and filled in E.read_text(encoding="utf-8"), r.stdout + r.stderr)
