 27960	def _drift_c4_same_commit(root, sha, existing):
 27961	    """那個提交加進來或改名進來的卷證目錄(NFC、去重、只留現在還在的)→ 清單;git 失敗、逾時或沒有提交回 None。
 27962	    借專案規矩「程式、圖譜筆記、審查卷證放同一個提交」(漂移修法補強 第 1 節);列檔照每支檔有家那段的寫法。"""
 27963	    raw = _nodehome_git(root, "show", "-z", "--name-only", "--diff-filter=AR", "--format=", sha) if sha else None
 27964	    if raw is None:
 27965	        return None
 27966	    out = []
 27967	    for p in _nodehome_split_z(raw):
 27968	        parts = p.split("/")
 27969	        d = nfc(parts[2]) if len(parts) >= 4 and parts[:2] == ["governance", "review-reports"] else ""
 27970	        if d and d in existing and d not in out:
 27971	            out.append(d)
 27972	    return out
