 27861	_DRIFT_BANNER_RE = re.compile(r"^[>\s#*✅★]*已結案[*★\s]*[(（:：]")
 27862	
 27863	
 27864	def _drift_close_banner(body, banner):
 27865	    """正文第一個 `# ` 標題之後、第一段之前加結案橫幅 → (新的正文行, 原本就有橫幅)。
 27866	    標題只在圍欄外找(圍欄裡的 `# comment` 不算,代碼審 r1 邊界席);已有橫幅只認「已結案」後面接括號或冒號的形狀,
 27867	    「已結案通知功能仍會重複寄信」這種正文不算(外家席);前面可以有 >、#、**、✅、★(本專案 Issue 的真實寫法,代碼審 r2 正確性席)。"""
 27868	    vis = {n - 1 for n, _ln in _visible_lines(body)}
 27869	    h = next((i for i, ln in enumerate(body) if i in vis and ln.startswith("# ")), None)
 27870	    start = 0 if h is None else h + 1
 27871	    j = start
 27872	    while j < len(body) and not body[j].strip():
 27873	        j += 1
 27874	    if j < len(body) and _DRIFT_BANNER_RE.match(body[j]):
 27875	        return body, True
 27876	    if h is None:
 27877	        return [banner, "", *body], False
 27878	    if j > start:
 27879	        return [*body[:j], banner, "", *body[j:]], False
 27880	    return [*body[:start], "", banner, "", *body[start:]], False
 27881	
