 53466	def t_drift_fix_c4_evidence_then_replace():
 53467	    """[S5] c4 只列證據、範本與一條預填好的 lumos set 整欄指令,不寫檔、不做乾淨檢查、不寫修復帳;不收 --old/--new。
 53468	    ★c4 不自己寫開頭欄位★(Enzo 2026-09-30 裁,代碼審四輪:自己寫原始文字每輪都漏一種 YAML 形狀):改用既有的 lumos set 整欄重寫;
 53469	    指令裡要改的那項放佔位字,原封不動照貼會被 set 擋下;填好整句照貼就改好、c4 消失。
 53470	    漂移修法補強(2026-09-30)後:範本句的卷證一律是 <卷證>(不自動填),卷證目錄列在清單裡、標來源(細節見
 53471	    t_drift_c4_reports_from_first_commit)。
 53472	
 53473	    翻紅釘:證據頁不標要改的那項或指令各項跟讀到的不一致 → ②紅;c4 也做乾淨檢查 → ③紅;set 拿掉佔位字檢查 → ④紅;
 53474	    範本改回自動填卷證目錄 → ②範本紅。
 53475	    """
 53476	    print("t_drift_fix_c4_evidence_then_replace")
 53477	    import shlex as _shlex
 53478	    root = _df_repo()
 53479	    v = root / _DR_VAULT
 53480	    E = v / "Verification" / "E.md"
 53481	    (root / "governance" / "review-reports" / "code-done").mkdir(parents=True)
 53482	    (root / "governance" / "review-reports" / "code-done" / "r1.md").write_text("x\n", encoding="utf-8")
 53483	    E.write_text("---\ntype: verification\nstatus: pass\nvalid_under:\n  - 本工作樹(未提交、未過代碼審);全套測試\n"
 53484	                 "  - 另一項 還沒提交 的前提\n  - 釘在提交 abc 的乾淨工作樹\nplan_refs:\n  - \"[[Projects/Done_計劃]]\"\n---\n# E\n",
 53485	                 encoding="utf-8")
 53486	    _df_commit(root, "c4 cases")
 53487	    first = _nh_git(root, "log", "--diff-filter=A", "--format=%H", "--", f"{_DR_VAULT}/Verification/E.md").stdout.split()[-1]
 53488	    fs = _df_find(v, "c4", "Verification/E.md")
 53489	    check("①前置:E 的 c4 指到第 5 行", [f["line"] for f in fs] == [5], str(fs))
 53490	    raw = E.read_bytes()
 53491	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4")
 53492	    tpl = f"提交 {first[:12]};代碼審見 <卷證>"
 53493	    cmd = [ln.strip() for ln in out.splitlines() if ln.strip().startswith("lumos set ")]
 53494	    check("②列第一次提交、卷證目錄(標來源)、範本(卷證放佔位字),回 0、不寫檔不寫帳", rc == 0 and first[:12] in out
 53495	          and "governance/review-reports/code-done(兩者)" in out and tpl in out and E.read_bytes() == raw and not _df_rows(root), out)
 53496	    check("②列出各項、標出要改的兩項", out.count("← 要改的這項") == 2 and "釘在提交 abc 的乾淨工作樹" in out, out)
 53497	    check("②預填的 lumos set 指令:要改的兩項放佔位字、其他照抄", cmd and _shlex.split(cmd[0]) == [
 53498	        "lumos", "set", "Verification/E", "valid_under", "<整項新內容>", "<整項新內容>", "釘在提交 abc 的乾淨工作樹"], str(cmd))
 53499	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4", "--old", "未提交", "--new", "x")
 53500	    check("②不收 --old/--new", rc == 2 and E.read_bytes() == raw, out)
 53501	    E.write_text(E.read_text(encoding="utf-8") + "未提交的一行\n", encoding="utf-8")
 53502	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4")
 53503	    check("③筆記有未提交改動也照列(只看不寫,不做乾淨檢查)", rc == 0 and "只列出、不寫檔" in out, out)
 53504	    E.write_bytes(raw)
 53505	    a = _shlex.split(cmd[0])
 53506	    r = run(v, *a[1:])
