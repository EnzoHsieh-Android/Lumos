 53605	def t_drift_fix_c1_missing_message():
 53606	    """[S3] c1 與 guard settle 找不到某種預告句時,訊息講明「可能已經是轉正後的說法(不用改),或被手改過」;
 53607	    兩處走同一支 _guard_settle_missing_say、字樣相同、名稱不疊字。
 53608	
 53609	    翻紅釘:c1 改回自己的「找不到…,沒改」→ ③紅;settle 改回舊提醒 → ②紅;字樣裡再疊一次「預告句」→ ①紅。
 53610	    """
 53611	    print("t_drift_fix_c1_missing_message")
 53612	    m = _load_lumos_inproc()
 53613	    tail = "——可能已經是轉正後的說法(不用改),或被手改過(看一下)"
 53614	    say = m._guard_settle_missing_say("X.md", list(m._GUARD_PROSE_NAMES), say=False)
 53615	    check("①每一種名稱:找不到<名稱>+同一句說明,名稱照 _GUARD_PROSE_NAMES、不疊字",
 53616	          say == [f"找不到{n}{tail}" for n in m._GUARD_PROSE_NAMES.values()]
 53617	          and not any("預告句預告句" in x or "預告句」預告句" in x for x in say), str(say))
 53618	    want = f"找不到摘要的 TEST 預告句{tail}"
 53619	    # ② settle:pending 轉正時 TEST 句被改過
 53620	    root = _df_repo()
 53621	    v = root / _DR_VAULT
 53622	    V = v / "Verification"
 53623	    (V / "S.md").write_text(_dr_guard_text("pending", claim="合約乙").replace(
 53624	        "TEST:還沒有測試在守這條", "TEST:[2026-09-15] 預告已轉正,自己先改好的"), encoding="utf-8")
 53625	    # ③ c1:已 pass、TEST 句早就是轉正後的說法,其他三句還在
 53626	    (V / "C.md").write_text(_dr_guard_text("pass", claim="大額退費要人工核可").replace(
 53627	        "TEST:還沒有測試在守這條", "TEST:[2026-09-15] 預告已轉正,自己先改好的"), encoding="utf-8")
 53628	    _df_commit(root, "cases", "2026-09-20")
 53629	    c1 = _df_find(v, "c1", "Verification/C.md")
 53630	    check("②③前置:S 沒有 TEST 預告句、C 是 c1", "TEST:還沒有測試" not in (V / "S.md").read_text(encoding="utf-8") and c1, str(c1))
 53631	    r = run(v, "guard", "settle", "Verification/S", "--test", "t_b")
 53632	    check("②settle:提醒用同一句", r.returncode == 0 and f"提醒:Verification/S.md 裡{want}" in r.stdout, r.stdout + r.stderr)
 53633	    rc, out = _df_fix(v, "Verification/C", str(min(f["line"] for f in c1)), "--kind", "c1", "--date", "2026-09-15")
 53634	    check("③c1:結果訊息接同一句(不再是「找不到…,沒改」)", rc == 0 and f";{want}" in out and "沒改" not in out, out)
 53635	
