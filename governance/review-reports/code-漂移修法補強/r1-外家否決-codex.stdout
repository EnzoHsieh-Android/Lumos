 29481	def _delguard_log_result(gr, kind, n_tokens, hits, secs, reason=None, vendored=None):
 29482	    """delguard 跑完(ok / 部分結果 degraded)記帳——2026-09-05 第二輪審視 d3:之前只記超時,治理帳看不出比例(架構 r1 E:與 _delguard_log_degraded 對稱的具名 helper)。"""
 29483	    try:
 29484	        _append_governance_log(Path(gr), [{"gate": "delguard", "kind": kind, "hard": False,
 29485	                                           "nodes": sorted({h["node"] for h in hits})[:10],
 29486	                                           "note": f"tokens={n_tokens} hits={len(hits)} secs={secs:.1f}" + (f" reason={reason}" if reason else "")
 29487	                                                   + _delguard_vendored_note(vendored)}])
 29488	    except Exception:
 29489	        pass
 29490	
 29491	
 29492	def _delguard_log_degraded(gr, reason, n_tokens, vendored=None):
 29493	    """★體檢 #9(2026-08-21)★:delguard 降級(超時/內部錯誤)一律寫治理帳 gate=delguard kind=degraded。
 29494	    之前只印一行「放行」——一天印 5 次、無處可數;現在 gov --stats 看得到降級率。best-effort 靜默。
 29495	    commit 欄=當下 HEAD(pre-commit 時=上一個 commit),note 標 reason。"""
 29496	    try:
 29497	        if gr:
 29498	            _append_governance_log(Path(gr), [{"gate": "delguard", "kind": "degraded", "hard": False,
 29499	                                               "nodes": [], "note": f"reason={reason} tokens={n_tokens}" + _delguard_vendored_note(vendored)}])
 29500	    except Exception:
 29501	        pass
