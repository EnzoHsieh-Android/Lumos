 53738	def t_doctor_revisit_marks_closed_issues():
 53739	    """[S6] doctor E5 列出到期回頭條件時,來源是狀態為 Issue 結案值的 Issue,那一行標「這篇 Issue 已結案」,照樣列、照樣計數;
 53740	    其他類型、Issue 用了非結案值時不標;E5 與結案列出用同一支判定(_revisit_lines)。
 53741	
 53742	    翻紅釘:拿掉 E5 的 _closed5 → ①紅;_closed5 不看類型 → ②計劃那行紅;改成看 QUERY_CLOSED_STATUSES 以外的字 → ②紅;
 53743	    E5 改回自己的逐行迴圈、不走 _revisit_lines → ③紅。
 53744	    """
 53745	    print("t_doctor_revisit_marks_closed_issues")
 53746	    import contextlib, io
 53747	    v = mkvault()
 53748	    (v / "Issues").mkdir()
 53749	    write(v, "Issues/已結案甲.md", "type: issue\nstatus: done", body="# 甲\nREVISIT:2020-01-01 最老的一條\n")
 53750	    write(v, "Issues/還開著乙.md", "type: issue\nstatus: open", body="# 乙\nREVISIT:2020-01-02 開著的\n")
 53751	    write(v, "Projects/收尾丙_計劃.md", "type: project\nstatus: done", body="# 丙\nREVISIT:2020-01-03 計劃留的撤除條件\n")
 53752	    write(v, "Issues/怪值丁.md", "type: issue\nstatus: fixed", body="# 丁\nREVISIT:2020-01-04 非結案值\n")
 53753	    r = run(v, "doctor", "--verbose")
 53754	    e5 = r.stdout.split("[E5]")[1].split("\n[")[0] if "[E5]" in r.stdout else ""
 53755	    row = lambda s: next((x for x in e5.split("\n") if s in x), "")
 53756	    check("①已結案的 Issue:那一行標「這篇 Issue 已結案」,照樣列", "(這篇 Issue 已結案)" in row("最老的一條"), e5)
 53757	    check("②開著的 Issue、已收尾的計劃、非結案值的 Issue 不標", row("開著的") and "已結案" not in row("開著的")
 53758	          and row("計劃留的撤除條件") and "已結案" not in row("計劃留的撤除條件")
 53759	          and row("非結案值") and "已結案" not in row("非結案值"), e5)
 53760	    check("②照樣計數(四件都算)", "4 件回訪到期" in r.stdout, e5)
 53761	    m = _load_lumos_inproc()
 53762	    seen = []
 53763	    orig = m._revisit_lines
 53764	
 53765	    def spy(text):
 53766	        seen.append(text)
 53767	        return orig(text)
 53768	    m._revisit_lines = spy
 53769	    try:
 53770	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
 53771	            m.run_doctor(m.Env(v), False, False)
 53772	        n_doc = len(seen)
 53773	        buf = io.StringIO()
 53774	        with contextlib.redirect_stdout(buf):
 53775	            m._issue_close_revisits(m.Env(v), "Issues/已結案甲.md", "done")
 53776	    finally:
 53777	        m._revisit_lines = orig
 53778	    check("③E5 與結案列出用同一支判定(_revisit_lines)", n_doc >= 4 and len(seen) == n_doc + 1 and "最老的一條" in buf.getvalue(),
 53779	          f"{n_doc} {len(seen)} {buf.getvalue()}")
