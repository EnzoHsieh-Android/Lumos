 29640	def _idiom_skill_for(ext, file_rel, repo_root):
 37620	    hm = sub.add_parser("home", help="每支檔有家:程式檔歸屬與寫回落點的檢查(提交前/推送前擋新違規);spec=Projects/每支檔有家_計劃")
 37621	    hmsub = hm.add_subparsers(dest="hmcmd", required=True)
 37622	    hmc = hmsub.add_parser("check", help="這次提交或這段推送有沒有新違規(有 rc1、沒有 rc0;沒圖譜/合併中/開關 off 跳過 rc0)")
 37623	    hmc.add_argument("--staged", action="store_true", dest="hm_staged", help="看這次要提交的內容(提交索引);不能跟 --diff 一起用")
 37624	    hmc.add_argument("--diff", dest="hm_diff", default=None, metavar="A..B", help="把範圍兩端當成一次改動比(推送前用);不能跟 --staged 一起用")
 37625	    hmc.add_argument("--repo", dest="hm_repo", default=None, help="repo root(預設 cwd 所在的 git 專案)")
 37626	
 37627	    ns_p = sub.add_parser("note-shape", help="筆記形狀擋:新寫的程式行號引用、沒寫來源的 FACT/FLOW/DEP 擋下(有 rc1、沒有 rc0;跳過 rc0);spec=Projects/筆記形狀擋_計劃")
 37628	    ns_p.add_argument("--staged", action="store_true", dest="ns_staged", help="看這次要提交的內容(提交索引);不能跟 --diff 一起用")
 37629	    ns_p.add_argument("--diff", dest="ns_diff", default=None, metavar="A..B", help="推送範圍(推送前與 CI 用);不能跟 --staged 一起用")
 37630	    ns_p.add_argument("--repo", dest="ns_repo", default=None, help="repo root(預設 cwd 所在的 git 專案)")
 37631	
 37632	    na_p = sub.add_parser("note-audit", help="筆記內容審:推送前派判定者逐行判新寫的筆記是不是程式碼推得出來;spec=Projects/筆記內容審_計劃")
 37633	    nasub = na_p.add_subparsers(dest="nacmd", required=True)
