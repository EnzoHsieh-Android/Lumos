 14639	def fm_structure(fm_lines):
 14640	    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
 14641	    end = 該 key 區塊最後一行的 index(含)。"""
 14642	    out = []
 14643	    i, n = 0, len(fm_lines)
 14644	    while i < n:
 14645	        m = TOP_KEY_RE.match(fm_lines[i])
 14646	        if not m:
 14647	            i += 1
 14648	            continue
 14649	        key, val = m.group(1), m.group(2).strip()
 14650	        start = i
 14651	        if val in ("|", "|-", ">", ">-"):
 14652	            i += 1
 14653	            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
 14654	                i += 1
 14655	            out.append((key, start, i - 1, "block"))
 14656	        elif val == "":
 14657	            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
 14658	            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
 14659	            i += 1
 14660	            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
 14661	                i += 1
 14662	            out.append((key, start, i - 1, "list"))
 14663	        elif val == "[]":
 14664	            # YAML 合法空清單(範本 `aliases: []` 就是這樣寫)。2026-08-23 前被判成 scalar →
 14665	            # 從範本建的節點第一次 append 必敗,全庫 15 篇在此狀態。★只認空的 `[]`★,
 14666	            # 非空 inline list(`[a, b]`)仍當 scalar——那要真的解析逗號與引號,不在本次,
 14667	            # 且 append 遇到它會被擋(不會壞),可接受。
 14668	            out.append((key, start, start, "list"))
 14669	            i += 1
 14670	        else:
 14671	            out.append((key, start, start, "scalar"))
 14672	            i += 1
 14673	    return out
 14674	
