 27896	def _drift_fix_by(env, by):
 27897	    """--by → (完整相對路徑去 .md, 錯誤)。完整路徑直接查那一篇;短名看 by_stem,找不到或同名好幾篇擋。"""
 27898	    a = nfc(str(by).strip())
 27899	    a = a[:-3] if a.lower().endswith(".md") else a
 27900	    if "/" in a:
 27901	        return (a, None) if (a + ".md") in env.notes else (None, f"--by 找不到 {by}")
 27902	    hits = env.by_stem.get(a.lower(), [])
 27903	    if len(hits) == 1:
 27904	        return hits[0][:-3], None
 27905	    if not hits:
 27906	        return None, f"--by 找不到 {by}"
 27907	    return None, f"--by {by} 同名好幾篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"
