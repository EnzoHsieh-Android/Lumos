 17817	def _diff_range_ends(root, diff_range):
 17818	    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
 17819	    import subprocess
 17820	    r = str(diff_range).strip()
 17821	    if "..." in r:
 17822	        a, b = r.split("...", 1)
 17823	        a, b = a or "HEAD", b or "HEAD"
 17824	        try:
 17825	            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
 17826	                                cwd=str(root), timeout=_disp_git_timeout())
 17827	            return (mb.stdout.strip() or a), b
 17828	        except (OSError, subprocess.TimeoutExpired):
 17829	            return a, b
 17830	    if ".." in r:
 17831	        a, b = r.split("..", 1)
 17832	        return (a or "HEAD"), (b or "HEAD")
 17833	    return r, None
