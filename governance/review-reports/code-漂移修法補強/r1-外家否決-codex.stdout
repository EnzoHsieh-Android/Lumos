 27975	def _drift_c4_dirs(cx, sha):
 27976	    """卷證目錄兩種來源都列 → ([(目錄名, 來源)] 排好序, 同提交清單或 None)。
 27977	    排序:兩者 → code- 開頭 → 其他,同級照字母。"""
 27978	    rr = Path(cx["root"]) / "governance" / "review-reports"
 27979	    existing = _drift_c4_existing(rr)
 27980	    same = _drift_c4_same_commit(cx["root"], sha, existing)
 27981	    n = cx["env2"].notes.get(cx["rel"])
 27982	    keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
 27983	            if link_target(x)}
 27984	    by_name = {d for d in existing if any(k and k in _drift_c4_key(d) for k in keys)}
 27985	    src = {d: "兩者" if d in by_name else "同提交" for d in same or ()}
 27986	    src.update({d: "計劃名" for d in by_name - set(src)})
 27987	    rows = sorted(src.items(), key=lambda kv: (0 if kv[1] == "兩者" else 1 if kv[0].startswith("code-") else 2, kv[0]))
 27988	    return rows, same
