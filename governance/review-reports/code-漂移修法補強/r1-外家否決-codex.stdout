 17765	def _vendored_state(root, ref=None):
 17766	    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。
 17767	
 17768	    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
 17769	    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
 17770	    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
 17771	    present, data = set(), {}
 17772	    if ref is None:
 17773	        for p in sorted(_VENDORED_ALL):
 17774	            fp = Path(root) / p
 17775	            if fp.is_file():
 17776	                present.add(p)
 17777	                try:
 17778	                    data[p] = fp.read_bytes()
 17779	                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
 17780	                    data[p] = None
 17781	        try:
 17782	            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
 17783	        except (OSError, ValueError):
 17784	            man = None
 17785	    else:
 17786	        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
 17787	        for p in sorted(_VENDORED_ALL):
 17788	            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
 17789	            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
 17790	                present.add(p)
