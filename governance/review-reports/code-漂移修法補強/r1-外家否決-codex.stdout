 29411	def _delguard_vault_scan(tokens, conf, graph_root_abs, deadline_check=None):
 29412	    """回 [{"node": "Systems/憑證.md", "folder": "Systems", "line_no": int,
 29413	            "line": str(strip,截 160 字), "tokens": [..], "conf": "high"|"low"}...]
 29414	       排序: (conf!=high, folder!="Systems", node, line_no)——高信心先、Systems 先。
 29415	       deadline_check: 選用 callable(),os.walk 外層迴圈每檔呼叫一次;回 True 立即
 29416	       return 目前累積 hits(部分結果,呼叫端已知逾時語意)。"""
 29417	    import re, os
 29418	    if not tokens:
 29419	        return []
 29420	    rx = re.compile(r"\b(?:" + "|".join(map(re.escape, tokens)) + r")\b", re.ASCII)
 29421	    per = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 29422	    hits = []
 29423	    for dirpath, _dirs, files in os.walk(graph_root_abs):
 29424	        for fn in files:
 29425	            if deadline_check is not None and deadline_check():
 29426	                hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29427	                return hits
 29428	            if not fn.endswith(".md"):
 29429	                continue
 29430	            fp = os.path.join(dirpath, fn)
 29431	            rel = os.path.relpath(fp, graph_root_abs)
 29432	            folder = rel.split(os.sep, 1)[0]
 29433	            try:
 29434	                text = open(fp, encoding="utf-8", errors="replace").read()
 29435	            except OSError:
 29436	                continue
 29437	            for i, line in enumerate(text.splitlines(), 1):
 29438	                # 單巨檔也要能中止:只在 os.walk 外層檢查的話,一份幾十萬行的節點會整份掃完
 29439	                # 才輪到下一次檢查,deadline 直接超支(2026-08-11 code-loop r1 H)
 29440	                if deadline_check is not None and i % 2000 == 0 and deadline_check():
 29441	                    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29442	                    return hits
 29443	                if not rx.search(line):
 29444	                    continue
 29445	                ts = [t for t, p in per.items() if p.search(line)]
 29446	                hits.append({"node": rel.replace(os.sep, "/"), "folder": folder, "line_no": i,
 29447	                             "line": line.strip()[:160], "tokens": ts,
 29448	                             "conf": "high" if any(conf.get(t) == "high" for t in ts) else "low"})
 29449	    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29450	    return hits
 29451	
 29452	
 29453	def _delguard_purelink(diff_lines):
 29454	    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
 29455	       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
 29456	       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
 29457	       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
 29458	       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
 29459	    import re
 29460	    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
 29461	    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
 29462	    plus = [ln[1:] for ln in diff_lines
 29463	            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
 29464	    minus = [ln[1:] for ln in diff_lines
 29465	             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
 29466	    changed = plus + minus
 29467	    if not changed:
 29468	        return False
 29469	    ms = {c.strip() for c in minus}
 29470	    if any(p.strip() in ms for p in plus):
 29471	        return False
 29472	    return all(item_re.match(c) or key_re.match(c) for c in changed)
 29473	
 29474	
 29475	def _delguard_vendored_note(vendored):
 29476	    """治理事件 note 的尾巴:這次跳過的工具自裝檔(漂移修法補強 第 5 節;RETIRE-IF ② 在消費專案數 vendored-skip=)。
 29477	    沒碰到回空字串。檔名最多列 20 支(事件本身已帶提交編號,要看刪了什麼用 git show <提交> -- <檔>)。"""
 29478	    return f" vendored-skip={len(vendored)} files={','.join(vendored[:20])}" if vendored else ""
 29479	
