 17793	                present.add(p)
 17794	                data[p] = r.stdout
 17795	        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
 17796	    files = man.get("files") if isinstance(man, dict) else None
 17797	    if not isinstance(files, dict):
