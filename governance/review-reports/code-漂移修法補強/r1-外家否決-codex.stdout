 53677	def t_delguard_skips_vendored_toolkit():
 53678	    """[S5] 消費專案提交時刪掉工具自裝檔(_VENDORED_ALL 的精確檔名)裡的名稱:刪除守衛不從那些檔抽名稱,治理事件 note 記
 53679	    vendored-skip=<支數> files=<檔>;同目錄底下專案自己的檔照抽;工具鏈來源 repo 照舊抽、note 不帶跳過。
 53680	
 53681	    翻紅釘:cmd_delguard_check 一律傳空集合 → ②紅;不看 _is_toolchain_repo 一律跳 → ④紅;note 不記 → ③紅;
 53682	    _delguard_parse_diff 的第二遍不跳 → ⑤紅。
 53683	    """
 53684	    print("t_delguard_skips_vendored_toolkit")
 53685	    import subprocess as _sp, tempfile as _tf, json as _j
 53686	
 53687	    def mk(toolchain):
 53688	        root = Path(_tf.mkdtemp(prefix="gctl-dgvend-"))
 53689	        vault = root / "docs" / "x-knowledge"
 53690	        (vault / "Systems").mkdir(parents=True)
 53691	        (vault / "Systems" / "a.md").write_text("---\nname: a\n---\n# a\n呼叫 zzVendoredOnlyFn 與 zzProjectFn 與 zzOwnHookFn。\n",
 53692	                                                encoding="utf-8")
 53693	        _nh_file(root, "scripts/lumos", "def zzVendoredOnlyFn():\n    return 1\n")
 53694	        _nh_file(root, "src/m.py", "def zzProjectFn():\n    return 1\n")
 53695	        _nh_file(root, "scripts/hooks/own_hook.py", "def zzOwnHookFn():\n    return 1\n")
 53696	        if toolchain:
 53697	            _nh_file(root, "skills/lumos-project-notes/SKILL.md", "# skill\n")
 53698	        _nh_git(root, "init", "-q")
 53699	        _nh_git(root, "add", "-A")
 53700	        _nh_git(root, "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "i")
 53701	        for rel in ("scripts/lumos", "src/m.py", "scripts/hooks/own_hook.py"):
 53702	            _nh_file(root, rel, "x = 1\n")
 53703	        _nh_git(root, "add", "-A")
 53704	        r = _sp.run([sys.executable, GRAPHCTL, "delguard", "--staged", "--json"], cwd=str(root), capture_output=True, text=True,
 53705	                    timeout=120)
 53706	        log = root / "docs" / ".governance-log.jsonl"
 53707	        rows = [_j.loads(x) for x in log.read_text(encoding="utf-8").splitlines() if x.strip()] if log.exists() else []
 53708	        try:
 53709	            out = _j.loads(r.stdout.strip().splitlines()[-1])
 53710	        except Exception:
 53711	            out = {}
 53712	        toks = {t for h in out.get("hits", []) for t in h["tokens"]}
 53713	        diff = _nh_git(root, "diff", "--cached").stdout
 53714	        return toks, [x for x in rows if x.get("gate") == "delguard"], diff, r.stdout + r.stderr
 53715	
 53716	    toks, rows, diff, raw = mk(False)
 53717	    check("①前置:這次提交真的從 scripts/lumos 刪掉了 zzVendoredOnlyFn、scripts/lumos 在工具自裝清單上",
