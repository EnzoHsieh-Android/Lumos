 53518	def t_drift_c4_reports_from_first_commit():
 53519	    """[S1] c4 證據頁列卷證目錄:這篇第一次被提交的那個提交加進來(含改名進來)的 governance/review-reports/<目錄>,
 53520	    跟計劃名比對到的都列出、標來源(兩者/同提交/計劃名),排序兩者 → code- 開頭 → 其他、同級照字母;只列現在還在的目錄;
 53521	    同提交超過 3 個時先印「可能含別的計劃的卷證」;中文目錄名照原樣;範本句的卷證一律是 <卷證>;git 查不到時寫明。
 53522	
 53523	    翻紅釘:--diff-filter=AR 改成 A → ②moved-in 紅;拿掉「只留還存在的」→ ③gone 紅;範本改回自動填目錄 → ④紅;
 53524	    排序改成只照字母 → ②順序紅;查不到時不寫明 → ⑤紅。
 53525	    """
 53526	    print("t_drift_c4_reports_from_first_commit")
 53527	    root = _df_repo()
 53528	    v = root / _DR_VAULT
 53529	    RR = "governance/review-reports"
 53530	    _nh_file(root, f"{RR}/done-old-plan/r1.md", "舊的\n")                  # 早一個提交就在:只有計劃名對得上
 53531	    _nh_file(root, "tmp/moved.md", "要改名進卷證目錄的內容\n")
 53532	    _df_commit(root, "earlier")
 53533	    E = v / "Verification" / "E.md"
 53534	    E.write_text("---\ntype: verification\nstatus: pass\nvalid_under:\n  - 本工作樹(未提交);全套測試\nplan_refs:\n"
 53535	                 "  - \"[[Projects/Done_計劃]]\"\n---\n# E\n", encoding="utf-8")
 53536	    for d in ("code-done", "code-xyz", "zeta", "審查卷證甲", "gone", "aaa", "zz-done"):
 53537	        _nh_file(root, f"{RR}/{d}/r1.md", f"{d} 的報告\n")
 53538	    (root / RR / "moved-in").mkdir(parents=True)
 53539	    _nh_git(root, "mv", "tmp/moved.md", f"{RR}/moved-in/r1.md")
 53540	    _df_commit(root, "feature with reports")
 53541	    first = _nh_git(root, "log", "--diff-filter=A", "--format=%H", "--", f"{_DR_VAULT}/Verification/E.md").stdout.split()[-1]
 53542	    shown = _nh_git(root, "-c", "core.quotePath=false", "show", "--name-status", "--format=", first).stdout
 53543	    check("①前置:E 第一次提交就是加卷證那一個;moved-in 是改名進來(R)、中文目錄同提交加進來",
 53544	          f"{RR}/審查卷證甲/r1.md" in shown and any(ln.startswith("R") and f"{RR}/moved-in/r1.md" in ln for ln in shown.splitlines())
 53545	          and [f["line"] for f in _df_find(v, "c4", "Verification/E.md")] == [5], shown)
 53546	    import shutil as _sh
 53547	    _sh.rmtree(root / RR / "gone")          # 同一個提交加進來、後來刪掉的目錄不列
 53548	    rc, out = _df_fix(v, "Verification/E", "5", "--kind", "c4")
 53549	    rows = [ln.strip() for ln in out.splitlines() if ln.strip().startswith(f"{RR}/")]
 53550	    want = [f"{RR}/code-done(兩者)", f"{RR}/zz-done(兩者)", f"{RR}/code-xyz(同提交)", f"{RR}/aaa(同提交)",
 53551	            f"{RR}/done-old-plan(計劃名)", f"{RR}/moved-in(同提交)", f"{RR}/zeta(同提交)", f"{RR}/審查卷證甲(同提交)"]
 53552	    check("②兩種來源都列、標來源、排序兩者 → code- → 其他(同級照字母),改名進來的也算,中文目錄照原樣", rc == 0 and rows == want,
 53553	          out)
 53554	    check("③已經刪掉的目錄不列", "gone" not in out, out)
 53555	    check("④範本句的卷證一律是 <卷證>(不自動填),提交照填", f"③範本句:提交 {first[:12]};代碼審見 <卷證>" in out, out)
 53556	    check("④同提交超過 3 個:先印可能含別的計劃的卷證", "可能含別的計劃的卷證(整批匯入或壓成一個的提交)" in out
 53557	          and out.index("可能含別的計劃的卷證") < out.index(want[0]), out)
 53558	    check("④最後提醒先提交再跑別的 drift fix", "用 lumos set 改完先提交" in out.splitlines()[-1], out)
 53559	    # ⑤git 查不到(這篇還沒提交):寫明查不到,計劃名那一份照列,範本的提交也放佔位字
