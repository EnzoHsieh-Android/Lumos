 18058	def cmd_update(source=None, no_pull=False, allow_stale=False):
 18059	    """從 Lumos 唯一源 repo 更新「本專案」vendored 的工具組。
 18060	    = (git pull Lumos) + install-graph-toolchain --target <本專案> --slug <自動偵測>。
 18061	    圖譜資料受 install-graph-toolchain 的 scaffold-skip 保護,不會被動。"""
 18062	    if _refuse_if_probe("update"):
 18063	        return 2
 18064	    src = _lumos_src(source)
 18065	    vault = find_vault(Path.cwd())
 18066	    if vault is None:
 18067	        # ★三條路同一套說法、同一個退出碼★(2026-09-07 全 repo 審視 #9)
 18068	        return _no_vault_msg()
 18069	    root = vault.parent.parent  # docs/<slug>-knowledge → docs → 專案 root
 18070	    slug = vault.name[:-len("-knowledge")] if vault.name.endswith("-knowledge") else vault.name
 18071	    if root.resolve() == src.resolve():
 18072	        # 來源 repo 自身:範本本地即最新,無 pull/vendor 之需——reinject-only
 18073	        # (2026-08-05 實戰缺口修:改完範本後來源 repo 自己的 CLAUDE.md 原本無路可刷)
 18074	        res = _reinject_all(root, slug, quiet=True)
 18075	        ri = res["CLAUDE.md"]
 18076	        print(f"lumos update — 來源 repo 自身:只刷新紀律區塊({', '.join(f'{k}:{v.status}' for k, v in res.items())})")
 18077	        return 0 if all(v.status in ("updated", "unchanged", "created", "appended") for v in res.values()) else 2
 18078	    print(f"lumos update — 來源 {src} → 本專案 {root}（slug={slug}）")
 18079	    rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
 18080	    return 2 if rc is None else rc
