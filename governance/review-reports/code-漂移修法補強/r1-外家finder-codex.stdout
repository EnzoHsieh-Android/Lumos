+        txt += f";理由:{o['reason'].strip()}"
@@ -27932,28 +27949,75 @@ def _drift_c4_key(s):
+def _drift_c4_existing(rr):
+    """governance/review-reports/ 底下現在有的目錄 → {NFC 名: 原名};讀不了回空。"""
+    try:
+        return {nfc(d.name): d.name for d in rr.iterdir() if d.is_dir()}
+    except OSError:
+        return {}
+def _drift_c4_same_commit(root, sha, existing):
+    """那個提交加進來或改名進來的卷證目錄(NFC、去重、只留現在還在的)→ 清單;git 失敗、逾時或沒有提交回 None。
+    借專案規矩「程式、圖譜筆記、審查卷證放同一個提交」(漂移修法補強 第 1 節);列檔照每支檔有家那段的寫法。"""
+    raw = _nodehome_git(root, "show", "-z", "--name-only", "--diff-filter=AR", "--format=", sha) if sha else None
+    if raw is None:
+        return None
+    out = []
+    for p in _nodehome_split_z(raw):
+        parts = p.split("/")
+        d = nfc(parts[2]) if len(parts) >= 4 and parts[:2] == ["governance", "review-reports"] else ""
+        if d and d in existing and d not in out:
+            out.append(d)
+    return out
+def _drift_c4_dirs(cx, sha):
+    """卷證目錄兩種來源都列 → ([(目錄名, 來源)] 排好序, 同提交清單或 None)。
+    排序:兩者 → code- 開頭 → 其他,同級照字母。"""
+    rr = Path(cx["root"]) / "governance" / "review-reports"
+    existing = _drift_c4_existing(rr)
+    same = _drift_c4_same_commit(cx["root"], sha, existing)
+    by_name = {d for d in existing if any(k and k in _drift_c4_key(d) for k in keys)}
+    src = {d: "兩者" if d in by_name else "同提交" for d in same or ()}
+    src.update({d: "計劃名" for d in by_name - set(src)})
+    rows = sorted(src.items(), key=lambda kv: (0 if kv[1] == "兩者" else 1 if kv[0].startswith("code-") else 2, kv[0]))
+    return rows, same
