def _clause_check_twoway(P, clauses):
    """風險低加嚴(不派審):測試不存在/懸空擋、兩條綁同一支擋;[manual:] 收(推送時全靠人的計劃走小改動閘)。回要印的行;沒事回 []。"""
    # [manual:] 收(Enzo 2026-09-17 裁「小改動不至於要綁測試」):全靠人的計劃推送時走小改動閘(_small_change_check)
    hang = [b for b in clauses if b["state"] in _CLAUSE_HANG_STATES or b["state"] == "bad-name"]
    if hang:
        return [f"{P} ✗ — 風險低的測試要真的存在:" + "、".join(f"{b['id']} {'/'.join(map(str, b['refs']))}({_CLAUSE_STATE_ZH.get(b['state'], b['state'])})" for b in hang),
                "    先把測試寫出來(現在紅沒關係),或把門升成單向"]
    seen, dup = {}, []
    for b in clauses:
        for nm in b["refs"]:
            if nm in seen and seen[nm] != b["id"]:
                dup.append(f"{nm}({seen[nm]} 與 {b['id']})")
            seen.setdefault(nm, b["id"])
    if dup:
        return [f"{P} ✗ — 風險低每條條款的測試名要互不相同(重複:" + "、".join(dup) + ")",
                "    一支測試證一條條款;十條全綁同一支也能「全部存在」,所以擋"]
    return []


def _spec_gate_keeps_rows(text, clauses):
    """回 (標了 [keeps] 的條款 id 集合, 疑似變體([Keeps]/全形括號)的條款 id 清單)——變體一律當沒標。"""
    lines_all = text.splitlines()
    keeps, variant = set(), []
    for b in clauses:
        seg = lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else ""
        if _KEEPS_RE.search(seg):
            keeps.add(b["id"])
        elif _KEEPS_VARIANT_RE.search(seg):
            variant.append(b["id"])
    return keeps, variant


def _plan_first_commit(rr, plan_repo_rel, timeout=None):
    """計劃檔第一次進 git 歷史的提交(r4:frontmatter 的 created 用 lumos set 就能改,不可信);沒進歷史回 None。
    timeout 給了就是秒數,逾時當查不到(drift fix --kind c4 列證據用;存量漂移改法 第 5 節)。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "log", "--diff-filter=A", "--format=%H", "--", plan_repo_rel],
                           capture_output=True, text=True, errors="replace", timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    shas = r.stdout.split() if r.returncode == 0 else []
    return shas[-1] if shas else None


def _test_exists_before(rr, commit, name):
    """計劃建立前的樹(那個提交的上一個)裡整字找得到這個測試名;沒有上一個提交=樹是空的=不存在。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "rev-parse", "-q", "--verify", commit + "^"], capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            return False
        g = subprocess.run(["git", "-C", str(rr), "grep", "-q", "-w", "-e", name, r.stdout.strip(), "--"], capture_output=True, text=True, errors="replace")
        return g.returncode == 0
    except OSError:
        return False


def _spec_gate_twoway_static(text, clauses, names, rr, plan_repo_rel):
    """風險低的靜態條件(跑測試之前):至少一條沒標 keeps;標 keeps 的測試在計劃建立前就存在(計劃沒進歷史=驗不了,擋)。回 (要印的行, 擋不擋)。"""
    P = "[spec-gate] 風險低:"
    keeps, variant = _spec_gate_keeps_rows(text, clauses)
    out = []
    if variant:
        out.append(f"{P} 看到疑似 keeps 變體({'、'.join(variant)}):只認半形小寫 [keeps],這幾條當新行為(測試要紅)")
    if not [b for b in clauses if b["id"] not in keeps]:
        out.append(f"{P} ✗ — 全部條款都標 [keeps],至少一條要是新行為(沒標 keeps 的測試現在是紅的、或靠人驗的 [manual:]);全標 keeps 等於什麼都沒驗")
        return out, True
    if not names or all(not names.get(b["id"]) for b in clauses):
        out.append(f"{P} 全部條款都靠人驗(一支測試都沒有):放行後推送時走小改動閘——碰 ≤{_SMALL_CHANGE['max_files']} 檔/≤{_SMALL_CHANGE['max_dirs']} 目錄且都在計劃落點內、每檔改動 ≤{int(_SMALL_CHANGE['max_rel_churn'] * 100)}% 或 ≤{_SMALL_CHANGE['max_abs_lines']} 行、落點沒風險標籤也不是裁判檔、近 {_SMALL_CHANGE['escape_days']} 天沒逃逸、不是修 bug")
    if keeps:
        first = _plan_first_commit(rr, plan_repo_rel)
        if first is None:
            out.append(f"{P} ✗ — 標了 [keeps] 的條款要驗「測試在計劃建立前就存在」,但這份計劃還沒進 git 歷史,驗不了;先提交計劃再跑")
            return out, True
        claude_text = cm.read_bytes()
        if claude_text.startswith(b"\xef\xbb\xbf"):
            claude_text = claude_text[3:]
        claude_text = claude_text.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    except OSError:
        return None
    claude_ver = _parse_sentinel_version(claude_text)
    if claude_ver is None:
        return None

    # 2. 讀來源 clone 的 LUMOS_VERSION(文字 grep,不 import 避免副作用)
    src = _lumos_src()
    src_lumos = src / "scripts" / "lumos"
    if not src_lumos.exists():
        return None  # 來源不可達 → 靜默 skip
    try:
        _ver_pat = re.compile(r'^LUMOS_VERSION\s*=\s*"(v\d+\.\d+)"', re.MULTILINE)
        src_text = src_lumos.read_text(encoding="utf-8", errors="replace")
        m = _ver_pat.search(src_text)
        if not m:
            return None
        src_ver = m.group(1)
    except OSError:
        return None

    # 3. 比對:CLAUDE 版本 < 來源版本 → nudge(簡單字串不等判準;版本是 advisory)
    if claude_ver == src_ver:
        return None
    # 嘗試 tuple 比對(vMAJOR.MINOR → (MAJOR, MINOR));取不到就用字串不等
    def _ver_tuple(s):
        try:
            parts = s.lstrip("v").split(".")
            return tuple(int(x) for x in parts)
        except (ValueError, AttributeError):
            return None
    ct = _ver_tuple(claude_ver)
    st = _ver_tuple(src_ver)
    if ct is not None and st is not None and ct >= st:
        return None  # CLAUDE 版本 ≥ 來源,不 nudge
    # CLAUDE 落後(或無法比較)→ 提示
    return (
        f"本專案紀律區塊版本 {claude_ver} 落後來源 {src_ver},"
        f" 可跑 lumos update 刷新"
    )


# vendored 工具組白名單(固定 5 檔,scripts/ 前綴;hooks/templates 兩夾另走整夾刪)。
# _vendor_toolchain 安裝端與 cmd_deinit 移除端共用,避免漂移。
_VENDORED_TOOLKIT = ("scripts/lumos", "scripts/test_lumos.py",
                     "scripts/merge-claude-settings.py", "scripts/graph-rename.sh",
                     "scripts/fetch-notesmd.sh")
_VENDORED_TREE_DIRS = ("scripts/hooks", "scripts/templates")   # 安裝時整個目錄照來源複製過去的那兩個
# ★工具確實會安裝進消費專案的每一支檔(精確檔名)★——跳過判斷只認這張表,不認目錄前綴。
# 2026-09-10 代碼審 r1 四席獨立抓到:原本照目錄前綴跳過,消費專案自己放在 scripts/hooks、
# scripts/templates 的程式會被當成工具的檔,推送閘的風險分級被降、逃過代碼審。
# 表要跟工具鏈 repo 裡那兩個目錄底下受版控的檔一模一樣:有一支測試逐檔比對,少登記或多登記都會翻紅。
_VENDORED_TREE_FILES = (
    "scripts/hooks/claude/_hookevent.py",
    "scripts/hooks/claude/check-graph-sync.py",
    "scripts/hooks/claude/ci-status-hook.py",
    "scripts/hooks/claude/memory-sweep.py",
    "scripts/hooks/claude/dispatch-lens-hook.py",
    "scripts/hooks/claude/impact-hook.py",
    "scripts/hooks/claude/lumos-entry-hook.py",
    "scripts/hooks/post-commit",
    "scripts/hooks/pre-commit",
    "scripts/hooks/pre-push",
    "scripts/templates/graph-discipline.md",
    "scripts/templates/note-audit-judge.md",
)
_VENDORED_ALL = frozenset(_VENDORED_TOOLKIT + _VENDORED_TREE_FILES)


_VENDORED_MANIFEST = ".lumos/vendored.json"   # 安裝/更新時記下每支工具檔的內容指紋


def _vendored_digest(data):
    """工具檔的內容指紋:換行統一成 LF 再算 sha256(Windows 的換行轉換不該讓指紋對不上)。"""
    import hashlib
    return hashlib.sha256(bytes(data).replace(b"\r\n", b"\n")).hexdigest()


def _vendored_manifest_write(root):
    """把工作目錄裡「工具自裝檔」的內容指紋寫進 .lumos/vendored.json(安裝與更新時呼叫;回寫進去的 {路徑: 指紋})。"""
    files = {}
    for rel in sorted(_VENDORED_ALL):
        p = Path(root) / rel
        if p.is_file():
            files[rel] = _vendored_digest(p.read_bytes())
    mp = Path(root) / _VENDORED_MANIFEST
    mp.parent.mkdir(parents=True, exist_ok=True)
    # 格式跟錨點基準線同一種({"version": 1, <路徑: sha256>…};第四輪架構席)。不走錨點那種「人核可才改」的流程:
    # 這份是安裝時的事實紀錄,錯了的方向是「多掃」不是「少擋」。ensure_ascii:從某版本讀回來走的是文字模式的 git show
    _write_lf(mp, json.dumps({"version": 1,
                              "note": "lumos 安裝時記下的工具檔內容指紋;內容對得上的才不算專案自己的程式",
                              "files": files}, ensure_ascii=True, indent=1) + "\n")
    return files


def _vendored_state(root, ref=None):
    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。

    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
    present, data = set(), {}
    if ref is None:
        for p in sorted(_VENDORED_ALL):
            fp = Path(root) / p
            if fp.is_file():
                present.add(p)
                try:
                    data[p] = fp.read_bytes()
                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
                    data[p] = None
        try:
            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            man = None
    else:
        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
        for p in sorted(_VENDORED_ALL):
            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
                present.add(p)
                data[p] = None
            elif r.returncode == 0:
                present.add(p)
                data[p] = r.stdout
        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
    files = man.get("files") if isinstance(man, dict) else None
    if not isinstance(files, dict):
        return frozenset(), frozenset(present)
    return (frozenset(p for p in present if data.get(p) is not None and files.get(p) == _vendored_digest(data[p])),
            frozenset(present))


def _diff_range_ends(root, diff_range):
    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
    import subprocess
    r = str(diff_range).strip()
    if "..." in r:
        a, b = r.split("...", 1)
        a, b = a or "HEAD", b or "HEAD"
        try:
            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
                                cwd=str(root), timeout=_disp_git_timeout())
            return (mb.stdout.strip() or a), b
        except (OSError, subprocess.TimeoutExpired):
            return a, b
    if ".." in r:
        a, b = r.split("..", 1)
        return (a or "HEAD"), (b or "HEAD")
    return r, None


def _is_toolchain_repo(root):
    """這個 repo 是不是工具鏈本體(那裡 scripts/lumos 就是產品,不能當成外來的跳過)。

    ★判別鍵沿用既有慣例★(見 `_self_repo_origin`):skills/lumos-project-notes/SKILL.md
    是 user-scope skill 的唯一源,永遠不會被複製進消費專案。"""
    try:
        return (Path(root) / "skills" / "lumos-project-notes" / "SKILL.md").is_file()
    except Exception:
        return False


def _vendored_skip(root, diff_range):
    """消費專案裡這段範圍要跳過的工具檔(工具鏈本體回空集合)。推送前分級與代碼審角色鏡頭共用這一支,見 _vendored_state:
    終點上原封不動的工具檔;終點上已經刪掉、但起點時原封不動的(拆除工具鏈)也跳。"""
    if _is_toolchain_repo(root):
        return frozenset()
    _start, _end = _diff_range_ends(root, diff_range)
    _intact_end, _present_end = _vendored_state(root, _end)
    _intact_start = _vendored_state(root, _start)[0] if _start else frozenset()
    return _intact_end | (_intact_start - _present_end)


def _pull_source_or_abort(src, allow_stale=False):
    """更新來源 clone;拉不到就中止。回傳 0=可繼續、None=中止(呼叫端不得再寫任何檔)。

    ★為什麼 fail-closed★:原本 pull 失敗只印一行警告就繼續 vendor,來源落後或有本機
    分歧時會靜默拿舊版蓋掉專案裡較新的檔——消費端實戰咬過兩次,那行警告混在一堆輸出裡
    根本看不到。「拿不到最新」與「確定這是最新」是兩種狀態,不該用同一條路走完。

    ★但無 remote 不算失敗★:手動複製 / slim 安裝出來的來源本就沒有 remote,那是合法的
    for i in range(1, len(parts) - 1):
        if parts[i - 1] == "src" and ext in under_src.get(parts[i], ()) and ext in main_exts.get("/".join(parts[:i]), ()):
            return True
    return False


def _nodehome_is_test(path, layout=({}, {})):
    """測試檔判定:先問測試地圖那一支;再認各棧的測試資料夾(2026-09-12:平板 POS 測試資料夾裡的輔助檔、
    Android 儀器測試的 Kotlin 檔都被要求有家——測試地圖的規格刻意只認 test/tests 資料夾與檔名,不動它);
    副檔名不在測試地圖清單裡的(shell、Go、Rust、C…),套它同一組目錄與檔名規則。layout 見 _nodehome_in_stack_test_dir。"""
    global _TESTMAP_DIR_RE
    if _testmap_is_test(path):
        return True
    if _nodehome_in_stack_test_dir(path, layout):
        return True
    if _testmap_ext(path) in _TESTMAP_EXTS:
        return False                      # 測試地圖認得這種副檔名,它說不是就不是
    if _TESTMAP_DIR_RE is None:
        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
    if _TESTMAP_DIR_RE.search(path):
        return True
    name = path.rsplit("/", 1)[-1]
    stem = _testmap_stem(path)
    return (".spec." in name or ".test." in name or stem.startswith("test_")
            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)


def _nodehome_code_kind(path):
    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
    base = path.rsplit("/", 1)[-1]
    stripped = base.lstrip(".")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where, oids=None):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。
    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    for ent in raw.split(b"\0"):
        if not ent or b"\t" not in ent:
            continue
        meta, p = ent.split(b"\t", 1)
        parts = meta.split()
        if where == "index":
            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
                continue
            mode = parts[0]
        else:
            if len(parts) != 3:
                continue
            mode = parts[0]
                if tail != b"\n":
                    with open(fp, "a", encoding="utf-8") as fh:
                        fh.write("\n")
        except OSError as ex:
            err = f"補不了檔尾換行:{ex}"
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    return _jsonl_append_verified(fp, rec, "id", rec["id"])


# ── 改法:drift fix(Projects/存量漂移改法_計劃)──────────────────────────────────────

_DRIFT_PLACEHOLDER_RE = re.compile(r"<(?:為什麼[^<>\n]{0,30}|sha|卷證)>")


def _drift_placeholder_err(text, what):
    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
    Issue 標成結案、理由是佔位字)。只認 _drift_fix_hint 與 c4 證據頁真的印過、而且會被貼進 --reason/--new 的那幾種
    (為什麼…、sha、卷證);`Map<K,V>`、`<src/lib>` 這種真理由照收(代碼審 r2 正確性席、r3 邊界席)。"""
    m = _DRIFT_PLACEHOLDER_RE.search(text or "")
    return f"{what} 裡還留著提示的佔位字「{m.group(0)}」——換成真的內容再跑" if m else None


def _drift_sh(v, node=False):
    """印給人照貼的指令裡的一個參數:只由文字、數字(含中日韓文字)、底線與 ./@%+=:,- 組成就原樣,其他一律 shlex.quote
    (代碼審 r1 資安席:檔名帶 $(…)、; 或反引號的筆記,照貼提示就會執行攻擊者的指令;正確性席:帶空白會被切成兩個參數)。
    不直接全部 _sh_quote:它把中文也當危險字元,圖譜裡幾乎每條提示都會被包上引號;其他字元一律交給 _sh_quote。
    node=True(drift fix 的節點參數):以 - 開頭會被當成選項,加引號也沒用(shell 會拿掉引號),補成 ./ 開頭——
    _drift_fix_target 認得這個寫法(代碼審 r2 資安席)。"""
    v = str(v)
    if node and v.startswith("-"):
        v = "./" + v
    return v if v and re.fullmatch(r"[\w./@%+=:,-]+", v) else _sh_quote(v)


def _drift_fix_hint(kind, path, line):
    """一筆發現該印的改法指令 → [指令]。★提示的單一產生處★(存量漂移改法 [S10]):drift check 擋下與只列出、drift scan、
    doctor Z 段、計劃收尾的連帶待辦都從這裡拿,不再各自教人手改。"""
    node = _drift_sh(path[:-3] if path.endswith(".md") else path, node=True)
    base = f"lumos drift fix {node} {line} --kind {kind}"
    if kind == "c2":
        return [base + ' --close --status done --reason "<為什麼算解決,附提交或測試>"',
                base + ' --keep --reason "<為什麼還沒解決>"']
    if kind == "c3":
        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + '> [--reason "…"]']
    if kind == "c4":
        return [base + "   # 列證據、範本與預填好的 lumos set 整欄指令(c4 不自己寫檔)"]
    if kind == "probe":
        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
    return [base]


def _drift_print_hints(rows, stream, head="改法:"):
    """一批發現的改法指令;c1 一篇一條(改一次整篇的預告句都改掉)。"""
    seen, out = set(), []
    for f in rows:
        k = (f["kind"], f["path"]) if f["kind"] == "c1" else (f["kind"], f["path"], f["line"])
        if k in seen:
            continue
        seen.add(k)
        out += _drift_fix_hint(f["kind"], f["path"], f["line"])
    if out:
        print(head, file=stream)
        for x in out[:20]:
            print(f"    {_esc_clean(x, 300)}", file=stream)
        if len(out) > 20:
            print(f"    …還有 {len(out) - 20} 條(lumos drift scan 看全部)", file=stream)


_DRIFT_C3_STATUSES = frozenset(_STATUS_ENUM["verification"] - {"pending"})
_DRIFT_FIX_OPTS = ("date", "close", "keep", "status", "reason", "by")
_DRIFT_FIX_ALLOWED = {"c1": {"date"}, "c2": {"close", "keep", "status", "reason"}, "c3": {"status", "by", "reason"},
                      "c4": set(), "c5": set()}


def _drift_one_line(t):
    """沒有任何分行字元:不只 \\n \\r,還有 str.splitlines() 會切開的 U+2028、U+0085、換頁字元——寫進筆記或帳檔後,
    用 splitlines 讀的人會看成兩行(代碼審 r1 邊界、資安席)。"""
    return len(("x" + t + "x").splitlines()) == 1


def _drift_fix_reason_ok(r):
    return isinstance(r, str) and _drift_one_line(r) and 4 <= len(r.strip()) <= 200


def _drift_fix_c2_args(o):
    if bool(o.get("close")) == bool(o.get("keep")):
        return ('--kind c2 要二擇一:--close --status <結案值> --reason "…"(Issue 解決了)'
                '或 --keep --reason "…"(還沒解決,照留)')
    if o.get("reason") is None:
        return "--kind c2 要帶 --reason(一行、4 到 200 字)"
    if _drift_placeholder_err(o["reason"], "--reason"):
        return _drift_placeholder_err(o["reason"], "--reason")
    if o.get("keep"):
        return "--keep 不收 --status" if o.get("status") is not None else None
    if o.get("status") not in _ISSUE_CLOSED_STATUSES:
        return f"--close 的 --status 只能是 Issue 的結案值:{'/'.join(sorted(_ISSUE_CLOSED_STATUSES))}"
    return None


def _drift_fix_c3_args(o):
    if o.get("status") not in _DRIFT_C3_STATUSES:
        return f"--kind c3 要帶 --status,值只能是 {'/'.join(sorted(_DRIFT_C3_STATUSES))}(驗證紀錄的合法狀態扣掉 pending)"
    # --reason 選填;長度與單行由 _drift_fix_args_err 的 _drift_fix_reason_ok 管,這裡只擋照抄提示的佔位字(同 c2)
    return _drift_placeholder_err(o["reason"], "--reason") if o.get("reason") is not None else None


_DRIFT_FIX_KIND_ARGS = {"c1": lambda o: None, "c2": _drift_fix_c2_args, "c3": _drift_fix_c3_args,
                        "c4": lambda o: None, "c5": lambda o: None}


def _drift_fix_args_err(kind, o):
    """--kind 與參數的組合合不合 → 錯誤或 None(存量漂移改法 第 1 節的組合表)。"""
    if kind == "probe":
        return ("--kind probe 沒有工具改法:條件成立了就把待辦做掉,再刪掉那一行或改寫成歷史說法;"
                "照留就 lumos drift ack <節點> <行號> --kind probe --reason \"<為什麼照留>\"")
    if kind not in _DRIFT_FIX_KINDS:
        return f"--kind 只能是 {'/'.join(_DRIFT_FIX_KINDS)}"
    extra = {k for k in _DRIFT_FIX_OPTS if o.get(k) not in (None, False)} - _DRIFT_FIX_ALLOWED[kind]
    if extra:
        return f"--kind {kind} 不收 " + "、".join("--" + x for x in sorted(extra))
    if o.get("date") is not None:
        _d, err = _guard_date_arg(o["date"])
        if err:
            return err
    if o.get("reason") is not None and not _drift_fix_reason_ok(o["reason"]):
        return "--reason 要一行、4 到 200 字"
    return _DRIFT_FIX_KIND_ARGS[kind](o)


def _drift_fix_target(env, node):
    """節點 → (筆記路徑, 錯誤)。同名好幾篇不猜(fix 會改檔,不能靠 env.find 取第一篇)。"""
    a = nfc(str(node).strip())
    explicit = a.startswith("./")                      # 提示對 - 開頭的節點印成 ./-x(_drift_sh);./ 開頭就是明確路徑
    a = a[2:] if explicit else a
    a = a[:-3] if a.lower().endswith(".md") else a
    if explicit or "/" in a:        # 給了路徑就只認那一篇,不退回用檔名猜(代碼審 r3 正確性席:./-x 原本被剝掉後改用檔名猜)
        return (a + ".md", None) if (a + ".md") in env.notes else (None, f"找不到筆記 {node}")
    hits = env.by_stem.get(a.lower(), [])
    if len(hits) > 1:
        return None, f"同名筆記有 {len(hits)} 篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"
    if not hits:
        return None, f"找不到筆記 {node}"
    return hits[0], None


def _drift_fix_last_sha(root, repo_rel):
    """修復帳裡這一篇最後一筆(seq 最大)的 after_sha256;沒有回 None。"""
    rows = [d for d in _drift_jsonl_rows(Path(root) / _DRIFT_FIXES) if nfc(str(d.get("path", ""))) == nfc(repo_rel)]
    if not rows:
        return None
    return _drift_bound_latest(rows)[-1].get("after_sha256")


def _drift_fix_verify(env, cx, res):
    """第 6 步(鎖外):磁碟內容等於算出的改後內容,而且重建圖譜物件後這一筆已處理。★不自動還原★。"""
    want = "\n".join(res["new"]).encode("utf-8")
    try:
        got = cx["path"].read_bytes()
    except OSError:
        got = None
    ok = got == want and res["handled"](_drift_state_findings(Env(env.vault), only={cx["rel"]}), got.decode("utf-8"))
    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "verify":      # 故障注入接縫(測試用),只認 verify|ledger|moved
        ok = False
    if ok:
        return None
    return (f"寫入後內容跟預期不同(或這一筆還沒處理掉)——工具不自動還原。在 repo 根目錄跑 "
            f"{_drift_git_hint(cx, 'checkout --')} 退回上次提交的版本(★這一篇之前用 drift fix 改過、還沒提交的也會一起退掉★,"
            "修復帳裡那幾筆就只剩稽核紀錄;代碼審 r1 正確性、併發席);退完重跑 lumos drift scan,照新清單再修")


def _drift_fix_record(env, cx, res):
    """第 7 步:寫修復帳(稽核紀錄)、記治理事件。帳寫不進去回 2,不動筆記。"""
    import datetime, hashlib, secrets
    rec = {"id": "DFIX-" + secrets.token_hex(4), "date": datetime.date.today().isoformat(), "path": cx["repo_rel"],
           "line": cx["line"], "kind": cx["kind"], "changed": _drift_fix_changes(cx["lines"], res["new"]),
           "after_sha256": hashlib.sha256("\n".join(res["new"]).encode("utf-8")).hexdigest(), **res["extra"]}
    want = "\n".join(res["new"]).encode("utf-8")
    moved = False
    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "ledger":
        rc = 2
    else:
        with _vault_write_lock(env.vault):
            # 驗證在鎖外,記帳前在鎖內再比一次:帳上的指紋要是記帳那一刻磁碟上的內容(代碼審 r1 外家席)
            try:
                if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "moved":   # 故障注入:模擬別人在驗證與記帳之間改了這一篇
                    cx["path"].write_bytes(want + b"\n")
                moved = cx["path"].read_bytes() != want
            except OSError:
                moved = True
            if moved:
                rc = 2
            else:
                rec["seq"] = _drift_next_seq(cx["root"], _DRIFT_FIXES)
                rc = _drift_ledger_append(cx["root"], _DRIFT_FIXES, rec)
    if rc != 0:
        why = ("寫好、驗過之後這一篇又被別人改了,修復帳沒記(帳上的指紋要是記帳那一刻的內容)" if moved
               else "筆記已改好,但修復帳沒記到")
        print(f"擋下:{why};{_esc_clean(cx['repo_rel'], 200)} 的改動用 git diff 看得到——確認沒問題就直接提交"
              "(修復帳只是稽核紀錄,少這一筆不影響之後的修;沒提交之前,同一篇的下一項 drift fix 會因為指紋對不上帳而擋下);"
              f"要退就 {_drift_git_hint(cx, 'checkout --')}", file=sys.stderr)
        return 2
    _gate_event_or_warn(cx["root"], "drift-check", "fix", f"{cx['rel']}:{cx['line']} {cx['kind']}({rec['id']})")
    return 0


def cmd_drift_fix(env, node, line, kind, o):
    """lumos drift fix <節點> <行號> --kind c1..c5 [--dry-run] [種類專屬參數](Projects/存量漂移改法_計劃 第 1 節)。
    順序:乾淨檢查 → 鎖外讀與判定、前提、git 查詢 → 算改後內容、自由文字先過形狀擋 → (--dry-run 到此)→
    鎖內比指紋寫入 → 鎖外驗證磁碟內容與「已處理」→ 寫修復帳。不自動還原:改之前保證了 git 退得回來。"""
    err = _drift_fix_args_err(kind, o)
    rel = None
    if err is None:
        rel, err = _drift_fix_target(env, node)
    if err is None and kind == "c2" and o.get("keep"):
        return cmd_drift_ack(env, rel, line, "c2", o["reason"], dry_run=bool(o.get("dry_run")))   # 照留:等同帶清單的 c2 表態
    cx = None
    if err is None:
        cx, err = _drift_fix_load(env, rel, line, kind, o)
    res = None
    if err is None:
        res, err = _DRIFT_FIX_COMPUTE[kind](cx)
        if err is None and res is None:
            return 0                                                 # c4 只列證據與範本
    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
    if err is None and o.get("dry_run"):
        _drift_fix_preview(cx, res)
        return 0
    # 帳檔路徑在寫筆記之前先查(代碼審 r1 邊界席:原本寫完筆記才發現帳寫不進去,留下改了筆記、沒帳、又不讓重跑的狀態)
    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    if _drift_fix_record(env, cx, res) != 0:
        return 2
    print(f"✓ drift fix {kind}:{_esc_clean(rel, 200)} 第 {line} 行——{res['msg']}")
    if kind == "c2":
        _issue_close_revisits(env, rel, o["status"])
    print(f"修復帳要跟筆記一起提交:\n    {_drift_git_hint(cx, 'add ' + _DRIFT_FIXES)} && git commit")
    return 0


# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
    import json as _j
    if text is None:
        return _DRIFT_DEFAULT_GATE, [], False
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


