32039:    # 1. core_refs 跨 repo 葉(r7-F2):不 BFS 進、不查 env.notes[dest]
    只擋目前目錄本身、不擋整棵子樹:目前目錄是家目錄或磁碟根時,正常裝在底下的直譯器不能因此消失。
    位置看檔案本身放在哪個目錄,不看它若是符號連結會指到哪:repo 根的連結指進子目錄,整條解析後就逃過比對(代碼審 r3 外家席)。
    所以只解析「所在目錄」那一層(同一個目錄可能有兩種寫法,例如 macOS 的 /var 與 /private/var),檔案本身不解析。"""
    import shutil
    found = shutil.which(name)
    if found is None or not os.path.isabs(found):
        return None
    if os.name == "nt":
        cwd = os.getcwd()
        heres = {os.path.normcase(os.path.abspath(cwd)), os.path.normcase(os.path.realpath(cwd))}
        where = os.path.dirname(os.path.abspath(found))
        if {os.path.normcase(where), os.path.normcase(os.path.realpath(where))} & heres:
            return None
    return os.path.abspath(found)


def _py_probe(argv, deadline):
    """用這個候選跑一次版本檢查 → (≥3.14 的絕對路徑或 None, 結果說明)。標準輸入接空、有逾時。"""
    import subprocess
    exe = argv[0]
    if os.path.dirname(exe):
        if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
            return None, "不存在"
    else:
        full = _py_which(exe)
        if full is None:
            return None, "沒有這個指令"
        argv = [full, *argv[1:]]
    left = deadline - time.monotonic()
    if left <= 0:
        return None, "整份清單超過 %d 秒,沒試" % _PY_TOTAL_TIMEOUT
    try:
        r = subprocess.run([*argv, "-c", _PY_PROBE], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, errors="replace", timeout=min(_PY_PROBE_TIMEOUT, left))
    except subprocess.TimeoutExpired:
        return None, "逾時(%s 秒沒回)" % _PY_PROBE_TIMEOUT
    except OSError as e:
        return None, "執行失敗(%s)" % e
    out = (r.stdout or "").strip().splitlines()
    last = out[-1] if out else ""
    if r.returncode == 0 and last.startswith("OK ") and os.path.isabs(last[3:].strip()):
        return last[3:].strip(), "合格"
    if last.startswith("OLD "):
        return None, "版本 %s,低於 3.14" % last[4:].strip()
    return None, "執行失敗(回傳碼 %s,可能是 Windows 商店替身)" % r.returncode


def _py_uv_find(deadline):
    """問 uv 要一支 ≥3.14(不找虛擬環境、不准觸發下載)→ (它印的路徑或 None, 結果說明)。
    執行失敗、逾時跟「uv 正常回答但沒有 3.14」分開講(代碼審 r2 外家席)。"""
    import subprocess
    uv = _py_which("uv")
    if uv is None:
        return None, "沒有這個指令"
    left = deadline - time.monotonic()
    if left <= 0:
        return None, "整份清單超過 %d 秒,沒試" % _PY_TOTAL_TIMEOUT
    try:
        r = subprocess.run([uv, "python", "find", "--system", "--no-python-downloads", ">=3.14"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                           timeout=min(_PY_PROBE_TIMEOUT, left))
    except subprocess.TimeoutExpired:
        return None, "逾時(%s 秒沒回)" % _PY_PROBE_TIMEOUT
    except OSError as e:
        return None, "執行失敗(%s)" % e
    path = (r.stdout or "").strip().splitlines()[-1:] if r.returncode == 0 else []
    if path and os.path.isabs(path[0]):
        return path[0], "合格"
    err = (r.stderr or "").strip().splitlines()
    if r.returncode == 0 or (err and "No interpreter found" in err[-1]):
        return None, "uv 找不到 3.14"
    # uv 沒找到跟 uv 自己出錯回傳碼一樣(都是 2),只能看它說了什麼(代碼審 r3:repo 根的 uv.toml 壞掉也走到這裡)。
    # 帶第一行 error: 與最後一行:真的 uv 把壞掉的檔名印在第一行、原因印在最後一行(代碼審 r4)
    head = next((x.strip() for x in err if x.strip().startswith("error:")), err[0].strip() if err else "")
    tail = err[-1].strip() if err else ""
    said = head if not tail or tail == head else head + " / " + tail
    return None, "執行失敗(回傳碼 %s%s)" % (r.returncode, ":" + said[:200] if said else "")


def _py_resolve():
    """找一支 ≥3.14 的直譯器 → (絕對路徑或 None, [(候選, 結果)])。LUMOS_PYTHON 有設就只認它:
    必須是絕對路徑、而且合格,否則停下,不往下找(明寫了要用哪一支的人,不該被默默換成別支)。找到一個就停。"""
    deadline = time.monotonic() + _PY_TOTAL_TIMEOUT
    pinned = os.environ.get("LUMOS_PYTHON", "")
    if pinned:
        if not os.path.isabs(pinned):
            return None, [("LUMOS_PYTHON=" + pinned, "不是絕對路徑(掛鉤與手打時會解析到不同的檔,不收)")]
        path, why = _py_probe([pinned], deadline)
        return path, [("LUMOS_PYTHON=" + pinned, why)]
    tried = []
    for desc, argv in _py_candidates():
        if argv is None:
            found, why = _py_uv_find(deadline)
            if found is None:
                tried.append((desc, why))
                continue
            desc, argv = desc + " → " + found, [found]
        path, why = _py_probe(argv, deadline)
        tried.append((desc, why))
        if path:
            return path, tried
    return None, tried


def _py_floor_message(tried, head="需要 Python 3.14 以上"):
    lines = ["擋下:%s,現在是 %d.%d.%d(%s)。" % (head, *sys.version_info[:3], sys.executable)]
    # 每個候選都列結果(條款 [S2]);不存在的很多,併成一行,免得真正的線索被淹掉(代碼審 r1)
    missing = [d for d, w in tried if w in ("不存在", "沒有這個指令")]
    lines.append("找過的候選:")
    lines += ["  %s:%s" % (d, w) for d, w in tried if w not in ("不存在", "沒有這個指令")]
    if missing:
        lines.append("  不存在或沒有這個指令:" + "、".join(missing))
    if os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"):
        # CI 回 2 就在這裡講清楚怎麼修:舊版 lumos update 在拉新之前就載進記憶體,印不出新版的升級注意(代碼審 r1)
        lines.append("在 CI 裡:actions/setup-python 的 python-version 設 \"3.14\"(或其他方式裝 3.14 並放進 PATH)。")
    return "\n".join(lines) + "\n" + _PY_INSTALL_HINT


def _py_floor_gate():
    """lumos 以主程式身分被 3.14 以前的 Python 啟動 → 找 3.14 用它重跑同一組參數;找不到印說明回 2(做法第 2 點)。
    版本夠就只清掉防重跑變數;LUMOS_PYTHON 不會讓一支已經是 3.14 的 lumos 重跑(指到包裝腳本時會無限重跑)。"""
    if sys.version_info >= _PY_FLOOR:
        os.environ.pop("LUMOS_REEXEC_PYTHON", None)   # 子孫行程不繼承
        return
    prev = os.environ.get("LUMOS_REEXEC_PYTHON")
    if prev and os.path.realpath(prev) == os.path.realpath(sys.executable):
        sys.stderr.write("擋下:已經用 %s 重跑過,它回報的版本仍是 %d.%d——那支不是真的 3.14(包裝腳本?)。\n"
                         % (prev, *sys.version_info[:2]) + _PY_INSTALL_HINT)
        sys.exit(2)
    path, tried = _py_resolve()
    if not path:
        sys.stderr.write(_py_floor_message(tried))
        sys.exit(2)
    os.environ["LUMOS_REEXEC_PYTHON"] = path
    argv = [path, os.path.abspath(__file__), *sys.argv[1:]]
    sys.stdout.flush()
    sys.stderr.flush()
    if os.name == "nt":
        import subprocess
        sys.exit(subprocess.call(argv))           # Windows 的 execv 不真的取代行程,呼叫端拿不到回傳碼
    os.execv(path, argv)

