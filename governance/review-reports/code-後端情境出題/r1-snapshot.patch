= lines.groupBy { it.productId }\n            .mapValues { (_, same) -> same.sumOf { it.quantity } }\n            .toSortedMap()\n\n        val prices = repo.findPrices(merged.keys)\n        val missing = merged.keys - prices.keys\n        if (missing.isNotEmpty()) throw ProductNotFoundException(missing)\n\n        val items = merged.map { (productId, quantity) -> OrderItem(productId, quantity, prices.getValue(productId)) }\n        val total = items.sumOf { it.unitPriceCents * it.quantity }\n        val orderId = UUID.randomUUID()\n        val now = Instant.now()\n\n        if (!repo.insertOrderIfAbsent(orderId, userId, idempotencyKey, total, now)) {\n            return PlacedOrder(checkNotNull(repo.findOrderByKey(userId, idempotencyKey)), created = false)\n        }\n        repo.insertItems(orderId, items)\n        repo.insertOutbox(orderId)\n        items.forEach { if (!repo.deductStock(it.productId, it.quantity)) throw InsufficientStockException(it.productId) }\n\n        return PlacedOrder(Order(orderId, userId, \"PENDING\", total, now, items), created = true)\n    }\n\n    @Transactional(readOnly = true)\n    fun getOrder(id: UUID): Order? = repo.findOrder(id)\n}\nEOF\ncat > $B/OrderController.kt <<'EOF'\npackage com.example.order\n\nimport jakarta.validation.Valid\nimport jakarta.validation.constraints.Max\nimport jakarta.validation.constraints.Min\nimport jakarta.validation.constraints.NotBlank\nimport jakarta.validation.constraints.Size\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ProblemDetail\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.ExceptionHandler\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestHeader\nimport org.springframework.web.bind.annotation.RestController\nimport org.springframework.web.bind.annotation.RestControllerAdvice\nimport java.net.URI\nimport java.time.Instant\nimport java.util.UUID\n\ndata class OrderLineRequest(\n    val productId: Long,\n    @field:Min(1) @field:Max(1000) val quantity: Int,\n)\n\ndata class CreateOrderRequest(\n    @field:NotBlank @field:Size(max = 100) val userId: String,\n    @field:Size(min = 1, max = 50) val items: List<@Valid OrderLineRequest>,\n)\n\ndata class OrderResponse(\n    val id: UUID,\n    val userId: String,\n    val status: String,\n    val totalCents: Long,\n    val createdAt: Instant,\n    val items: List<OrderItem>,\n)\n\nprivate fun Order.toResponse() = OrderResponse(id, userId, status, totalCents, createdAt, items)\n\ndata class CreateProductRequest(\n    @field:NotBlank val name: String,\n    @field:Min(0) val priceCents: Long,\n    @field:Min(0) val stock: Int,\n)\n\n@RestController\nclass OrderController(private val service: OrderService, private val repo: OrderRepository) {\n\n    /** 首次建立回 201;同一個 Idempotency-Key 重送回 200 與原訂單。 */\n    @PostMapping(\"/orders\")\n    fun create(\n        @RequestHeader(\"Idempotency-Key\") @Size(min = 1, max = 100) idempotencyKey: String,\n        @Valid @RequestBody req: CreateOrderRequest,\n    ): ResponseEntity<OrderResponse> {\n        val placed = service.placeOrder(req.userId, idempotencyKey, req.items.map { OrderLine(it.productId, it.quantity) })\n        val body = placed.order.toResponse()\n        return if (placed.created) {\n            ResponseEntity.created(URI.create(\"/orders/${body.id}\")).body(body)\n        } else {\n            ResponseEntity.ok(body)\n        }\n    }\n\n    @GetMapping(\"/orders/{id}\")\n    fun get(@PathVariable id: UUID): ResponseEntity<OrderResponse> =\n        service.getOrder(id)?.let { ResponseEntity.ok(it.toResponse()) } ?: ResponseEntity.notFound().build()\n\n    // 商品端點只為了能建立、查看商品與庫存;本期沒有認證,正式環境要擋在管理介面後面\n    @PostMapping(\"/products\")\n    fun createProduct(@Valid @RequestBody req: CreateProductRequest): ResponseEntity<Product> {\n        val id = repo.insertProduct(req.name, req.priceCents, req.stock)\n        return ResponseEntity.created(URI.create(\"/products/$id\")).body(repo.findProduct(id))\n    }\n\n    @GetMapping(\"/products/{id}\")\n    fun getProduct(@PathVariable id: Long): ResponseEntity<Product> =\n        repo.findProduct(id)?.let { ResponseEntity.ok(it) } ?: ResponseEntity.notFound().build()\n}\n\n@RestControllerAdvice\nclass ApiExceptionHandler {\n\n    @ExceptionHandler(InsufficientStockException::class)\n    fun insufficientStock(e: InsufficientStockException): ProblemDetail =\n        ProblemDetail.forStatusAndDetail(HttpStatus.CONFLICT, e.message ?: \"庫存不足\")\n\n    @ExceptionHandler(ProductNotFoundException::class)\n    fun productNotFound(e: ProductNotFoundException): ProblemDetail =\n        ProblemDetail.forStatusAndDetail(HttpStatus.UNPROCESSABLE_ENTITY, e.message ?: \"商品不存在\")\n}\nEOF\ncat > $B/OrderProcessor.kt <<'EOF'\npackage com.example.order\n\nimport org.slf4j.LoggerFactory\nimport org.springframework.stereotype.Component\nimport java.util.UUID\n\n/**\n * 訂單建立後的非同步處理(通知、出貨單、對外系統同步等)放在這裡。\n *\n * 約定:\n * - 至少處理一次。工作者在處理完、提交前當機,同一筆會被再處理一次,所以實作必須能重複執行。\n * - 要快。處理期間這筆工作的資料庫鎖是持有的,不要在這裡做會卡很久的呼叫。\n * - 丟例外代表失敗,會依退避時間重試,超過上限標記為 FAILED。\n */\nfun interface OrderProcessor {\n    fun process(orderId: UUID)\n}\n\n/** 預設實作只記一行 log;接上真正的後續流程時換掉它。 */\n@Component\nclass LoggingOrderProcessor : OrderProcessor {\n    private val log = LoggerFactory.getLogger(javaClass)\n\n    override fun process(orderId: UUID) {\n        log.info(\"處理訂單 {}\", orderId)\n    }\n}\nEOF\ncat > $B/OutboxWorker.kt <<'EOF'\npackage com.example.order\n\nimport org.slf4j.LoggerFactory\nimport org.springframework.boot.context.properties.ConfigurationProperties\nimport org.springframework.jdbc.core.simple.JdbcClient\nimport org.springframework.scheduling.annotation.Scheduled\nimport org.springframework.stereotype.Component\nimport org.springframework.transaction.support.TransactionTemplate\nimport java.util.UUID\n\n@ConfigurationProperties(\"order.worker\")\ndata class WorkerProperties(\n    val enabled: Boolean = true,\n    val pollDelayMs: Long = 200,\n    val batchSize: Int = 100,\n    val maxAttempts: Int = 5,\n    val backoffBaseSeconds: Long = 2,\n)\n\n/**\n * 從 outbox 表領待處理的訂單、交給 [OrderProcessor]。\n *\n * 領取用 `FOR UPDATE SKIP LOCKED`:多個工作者(含多台機器)同時跑時,各自領到不同的列,\n * 被別人鎖著的直接跳過,不會等也不會重複處理。鎖持有到這一批提交為止。\n */\n@Component\nclass OutboxWorker(\n    private val jdbc: JdbcClient,\n    private val tx: TransactionTemplate,\n    private val processor: OrderProcessor,\n    private val props: WorkerProperties,\n) {\n    private val log = LoggerFactory.getLogger(javaClass)\n\n    @Scheduled(fixedDelayString = \"\\${order.worker.poll-delay-ms:200}\")\n    fun poll() {\n        if (!props.enabled) return\n        // 領滿一批代表可能還有積壓,接著再領,領不滿才回去睡\n        while (runOnce() >= props.batchSize) Unit\n    }\n\n    /** 領一批並處理,回傳領到幾筆。測試直接呼叫這個,不靠排程。 */\n    fun runOnce(): Int = tx.execute {\n        val claimed = jdbc.sql(\n            \"\"\"\n            SELECT id, order_id, attempts FROM outbox\n            WHERE status = 'PENDING' AND next_attempt_at <= now()\n            ORDER BY next_attempt_at\n            LIMIT :n\n            FOR UPDATE SKIP LOCKED\n            \"\"\",\n        ).param(\"n\", props.batchSize)\n            .query { rs, _ -> Triple(rs.getLong(\"id\"), rs.getObject(\"order_id\", UUID::class.java), rs.getInt(\"attempts\")) }\n            .list()\n\n        claimed.forEach { (id, orderId, attempts) ->\n            try {\n                processor.process(orderId)\n                markDone(id, orderId)\n            } catch (e: Exception) {\n                markAttemptFailed(id, orderId, attempts + 1, e)\n            }\n        }\n        claimed.size\n    } ?: 0\n\n    private fun markDone(id: Long, orderId: UUID) {\n        jdbc.sql(\"UPDATE outbox SET status = 'DONE', attempts = attempts + 1, last_error = NULL WHERE id = :id\")\n            .param(\"id\", id).update()\n        setOrderStatus(orderId, \"PROCESSED\")\n    }\n\n    private fun markAttemptFailed(id: Long, orderId: UUID, attempts: Int, e: Exception) {\n        val error = (e.message ?: e.javaClass.name).take(500)\n        if (attempts >= props.maxAttempts) {\n            log.error(\"訂單 {} 處理失敗 {} 次,放棄\", orderId, attempts, e)\n            jdbc.sql(\"UPDATE outbox SET status = 'FAILED', attempts = :a, last_error = :e WHERE id = :id\")\n                .param(\"a\", attempts).param(\"e\", error).param(\"id\", id).update()\n            setOrderStatus(orderId, \"FAILED\")\n        } else {\n            // 退避:第 1 次失敗等 base 秒,之後每次加倍\n            val delaySeconds = props.backoffBaseSeconds shl (attempts - 1)\n            log.warn(\"訂單 {} 第 {} 次處理失敗,{} 秒後重試\", orderId, attempts, delaySeconds, e)\n            jdbc.sql(\n                \"\"\"\n                UPDATE outbox SET attempts = :a, last_error = :e,\n                       next_attempt_at = now() + make_interval(secs => :d)\n                WHERE id = :id\n                \"\"\",\n            ).param(\"a\", attempts).param(\"e\", error).param(\"d\", delaySeconds.toDouble()).param(\"id\", id).update()\n        }\n    }\n\n    private fun setOrderStatus(orderId: UUID, status: String) {\n        jdbc.sql(\"UPDATE orders SET status = :s, updated_at = now() WHERE id = :id\")\n            .param(\"s\", status).param(\"id\", orderId).update()\n    }\n}\nEOF\n"
