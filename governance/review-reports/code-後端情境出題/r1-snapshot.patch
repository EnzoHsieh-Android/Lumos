d: ${DB_PASSWORD:orders}\n    hikari:\n      maximum-pool-size: ${DB_POOL_SIZE:20}\n      connection-timeout: 3000\n\norder:\n  worker:\n    enabled: true\n    poll-delay-ms: 200\n    batch-size: 100\n    max-attempts: 5\n    backoff-base-seconds: 2\nEOF\ncat > $B/OrderApplication.kt <<'EOF'\npackage com.example.order\n\nimport org.springframework.boot.autoconfigure.SpringBootApplication\nimport org.springframework.boot.context.properties.ConfigurationPropertiesScan\nimport org.springframework.boot.runApplication\nimport org.springframework.scheduling.annotation.EnableScheduling\n\n@SpringBootApplication\n@EnableScheduling\n@ConfigurationPropertiesScan\nclass OrderApplication\n\nfun main(args: Array<String>) {\n    runApplication<OrderApplication>(*args)\n}\nEOF\ncat > $B/OrderRepository.kt <<'EOF'\npackage com.example.order\n\nimport org.springframework.jdbc.core.simple.JdbcClient\nimport org.springframework.stereotype.Repository\nimport java.time.Instant\nimport java.util.UUID\n\ndata class Product(val id: Long, val name: String, val priceCents: Long, val stock: Int)\n\ndata class OrderItem(val productId: Long, val quantity: Int, val unitPriceCents: Long)\n\ndata class Order(\n    val id: UUID,\n    val userId: String,\n    val status: String,\n    val totalCents: Long,\n    val createdAt: Instant,\n    val items: List<OrderItem>,\n)\n\n@Repository\nclass OrderRepository(private val jdbc: JdbcClient) {\n\n    fun insertProduct(name: String, priceCents: Long, stock: Int): Long =\n        jdbc.sql(\"INSERT INTO products (name, price_cents, stock) VALUES (:n, :p, :s) RETURNING id\")\n            .param(\"n\", name).param(\"p\", priceCents).param(\"s\", stock)\n            .query(Long::class.java).single()\n\n    fun findProduct(id: Long): Product? =\n        jdbc.sql(\"SELECT id, name, price_cents, stock FROM products WHERE id = :id\")\n            .param(\"id\", id)\n            .query { rs, _ -> Product(rs.getLong(\"id\"), rs.getString(\"name\"), rs.getLong(\"price_cents\"), rs.getInt(\"stock\")) }\n            .optional().orElse(null)\n\n    /** 不上鎖的讀取,只拿價格;庫存的判斷留給 [deductStock]。 */\n    fun findPrices(productIds: Collection<Long>): Map<Long, Long> =\n        jdbc.sql(\"SELECT id, price_cents FROM products WHERE id = ANY(:ids)\")\n            .param(\"ids\", productIds.toTypedArray())\n            .query { rs, _ -> rs.getLong(\"id\") to rs.getLong(\"price_cents\") }\n            .list().toMap()\n\n    /**\n     * 新建訂單;同一個 (user, key) 已存在時什麼都不寫、回傳 false。\n     * 另一個交易正在寫同一個 key 時,這句會等它結束,所以重複請求會在這裡排隊,碰不到庫存。\n     */\n    fun insertOrderIfAbsent(id: UUID, userId: String, key: String, totalCents: Long): Boolean =\n        jdbc.sql(\n            \"\"\"\n            INSERT INTO orders (id, user_id, idempotency_key, status, total_cents)\n            VALUES (:id, :u, :k, 'PENDING', :t)\n            ON CONFLICT (user_id, idempotency_key) DO NOTHING\n            \"\"\",\n        ).param(\"id\", id).param(\"u\", userId).param(\"k\", key).param(\"t\", totalCents)\n            .update() == 1\n\n    fun insertItems(orderId: UUID, items: List<OrderItem>) {\n        // 一次一筆的批次寫入量很小(單筆訂單品項上限 50),逐筆即可,避免多一層批次 API\n        items.forEach {\n            jdbc.sql(\"INSERT INTO order_items (order_id, product_id, quantity, unit_price_cents) VALUES (:o, :p, :q, :u)\")\n                .param(\"o\", orderId).param(\"p\", it.productId).param(\"q\", it.quantity).param(\"u\", it.unitPriceCents)\n                .update()\n        }\n    }\n\n    fun insertOutbox(orderId: UUID) {\n        jdbc.sql(\"INSERT INTO outbox (order_id, status) VALUES (:o, 'PENDING')\").param(\"o\", orderId).update()\n    }\n\n    /**\n     * 防超賣的核心:判斷與扣減在同一句 SQL 裡由資料庫原子完成。\n     * 回傳 false 代表庫存不足(這句沒改任何列)。\n     */\n    fun deductStock(productId: Long, quantity: Int): Boolean =\n        jdbc.sql(\"UPDATE products SET stock = stock - :q WHERE id = :id AND stock >= :q\")\n            .param(\"q\", quantity).param(\"id\", productId)\n            .update() == 1\n\n    fun findOrderByKey(userId: String, key: String): Order? =\n        jdbc.sql(\"SELECT id FROM orders WHERE user_id = :u AND idempotency_key = :k\")\n            .param(\"u\", userId).param(\"k\", key)\n            .query(UUID::class.java).optional().orElse(null)\n            ?.let { findOrder(it) }\n\n    fun findOrder(id: UUID): Order? {\n        val head = jdbc.sql(\"SELECT id, user_id, status, total_cents, created_at FROM orders WHERE id = :id\")\n            .param(\"id\", id)\n            .query { rs, _ ->\n                Order(\n                    rs.getObject(\"id\", UUID::class.java), rs.getString(\"user_id\"), rs.getString(\"status\"),\n                    rs.getLong(\"total_cents\"), rs.getTimestamp(\"created_at\").toInstant(), emptyList(),\n                )\n            }\n            .optional().orElse(null) ?: return null\n        val items = jdbc.sql(\"SELECT product_id, quantity, unit_price_cents FROM order_items WHERE order_id = :id ORDER BY product_id\")\n            .param(\"id\", id)\n            .query { rs, _ -> OrderItem(rs.getLong(\"product_id\"), rs.getInt(\"quantity\"), rs.getLong(\"unit_price_cents\")) }\n            .list()\n        return head.copy(items = items)\n    }\n}\nEOF\n"
