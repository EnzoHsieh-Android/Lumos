+def pending_questions_blocking_gate(qs):
+    """規格閘要擋的題:標阻塞、階段是需求或架構、狀態是待查或待人。"""
+    return [q for q in (qs or []) if q["blocking"] and q["stage"] in ("需求", "架構") and q["status"] in PQ_OPEN]
+
+
+def pending_questions_for_stage(qs, stage):
+    """pitfalls --stage:那一階段還沒結的題,依阻塞、不可逆、其餘排序,同級照編號;不設題數上限(計劃決策 d8)。"""
+    rows = [q for q in (qs or []) if q["stage"] == stage and q["status"] in PQ_OPEN]
+    return sorted(rows, key=lambda q: (0 if q["blocking"] else 1 if q["irreversible"] else 2, q["num"]))
