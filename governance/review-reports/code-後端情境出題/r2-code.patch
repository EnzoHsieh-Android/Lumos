+# ── 待決問題(情境出題,[[Projects/後端工程提問與證據擴充_計劃]] A 塊)────────────────────────────
+# 計劃筆記一節「## 待決問題」,一題一行:- [Q<n>] <問題> [類:..][階段:..][狀態:..] 可接 [阻塞] [不可逆]、→ 連結、出處:、理由:、測試:
+# 規格閘、lint、pitfalls --stage 三處共用 parse_pending_questions(只吃文字、不讀圖譜);要查決策或測試名的檢查只放 lint,
+# 規格閘只看狀態:標阻塞的需求/架構題沒結、標阻塞卻寫錯狀態或階段、看不懂的題目行,一律擋(寧可擋;代碼審 r1 邊界席、合約圖譜席)。
+PQ_STATUSES = ("待查", "自答", "待人", "延後", "已決", "已驗")
+PQ_STAGES = ("需求", "架構", "實作", "驗證", "效能", "交付")
+PQ_OPEN = ("待查", "待人")
+_PQ_HEAD_RE = re.compile(r"^(#{1,6})\s+(?:[\d.、]+\s*)?待決問題(?!\w)")   # 層級不限、前面可有編號、後面可接括號或冒號;「待決問題清單」不算
+_PQ_ANY_HEAD_RE = re.compile(r"^(#{1,6})\s")
+_PQ_LINE_RE = re.compile(r"^\s*[-*]\s+\[Q(\d+)\]\s*(.*)$")
+_PQ_LOOKS_RE = re.compile(r"^[\s>*+\-\d.、)）|\[\]xX]*\s*[QＱ]\s*\d|\[(?:阻塞|不可逆)\]|\[(?:類|階段|狀態)\s*[:：]")   # 像題目:去掉清單/引用/勾選/粗體符號後是 Q<n>,或帶題目的標記
+_PQ_TAG_RE = re.compile(r"\[(類|階段|狀態)\s*[:：]([^\[\]\n]*)\]|\[(阻塞|不可逆)\]")   # 值裡不收方括號:沒闔上的標記到下一個 [ 就停(長行不回溯)
+_PQ_FIELD_KEY_RE = re.compile(r"(出處|理由|測試)\s*[:：]")
+_PQ_LINK_RE = re.compile(r"→\s*(\[\[[^\[\]\n]+\]\]#d\d+|#d\d+)")
+_PQ_SHAPE = "要寫成「- [Q<n>] <問題> [類:…][階段:…][狀態:…]」"
+
+
+def _pq_sections(lines):
+    """〈待決問題〉各節內(圍欄外)的 (行號從1起, 原始行);一份裡有幾節都收。沒有這一節回 None。
+    哪些行看得見走 _visible_lines(全檔唯一的圍欄判定);節結束=同級或更淺的下一個標題。"""
+    out, level = None, None
+    for no, ln in _visible_lines(lines):
+        hm = _PQ_HEAD_RE.match(ln)
+        if hm:
+            level, out = len(hm.group(1)), (out or [])
+            continue
+        am = _PQ_ANY_HEAD_RE.match(ln)
+        if am and level is not None and len(am.group(1)) <= level:
+            level = None
+            continue
+        if level is not None:
+            out.append((no, ln))
+    return out
+
+
+def _pq_tests(v):
+    """「測試:」的值 → 測試名清單;正規化跟條款那邊同一套(slot_parse + _test_names_of:全半形逗號、平台前綴、反引號)。"""
+    names, _ = _test_names_of(slot_parse("[test:" + v.replace("[", " ").replace("]", " ") + "]"))
+    return [x for x in (n.split()[0].rstrip("。,，、;；.") for n in names if n.strip()) if x]   # 句尾標點不算名字(代碼審 r1 正確性席)
+
+
+def _pq_parse_line(no, rest, num):
+    tags, dups, flags = {}, [], set()
+    first = _PQ_TAG_RE.search(rest)
+    text, after = (rest[:first.start()], rest[first.start():]) if first else (rest, "")
+    for t in _PQ_TAG_RE.finditer(after):
+        if t.group(1):
+            if t.group(1) in tags:
+                dups.append(t.group(1))
+            tags[t.group(1)] = t.group(2).strip()
+        else:
+            flags.add(t.group(3))
+    tail = _PQ_TAG_RE.sub(" ", after)
+    link = _PQ_LINK_RE.search(tail)
+    if link:
+        tail = tail[:link.start()] + " " + tail[link.end():]
+    keys = list(_PQ_FIELD_KEY_RE.finditer(tail))
+    fields = {}
+    for i, k in enumerate(keys):
+        fields[k.group(1)] = tail[k.end():keys[i + 1].start() if i + 1 < len(keys) else len(tail)].strip()
+    return {"id": f"Q{num}", "num": num, "line": no, "bad": None,
+            "cls": tags.get("類"), "stage": tags.get("階段"), "status": tags.get("狀態"), "dup_tags": dups,
+            "blocking": "阻塞" in flags, "irreversible": "不可逆" in flags,
+            "link": link.group(1) if link else None,
+            "source": fields.get("出處", ""), "reason": fields.get("理由", ""),
+            "tests": _pq_tests(fields["測試"]) if "測試" in fields else [],
+            "text": text.strip()}
+
+
+def parse_pending_questions(text):
+    """回〈待決問題〉各節的題目清單;計劃沒有這一節回 None。每題:id、行號、類、階段、狀態、阻塞、不可逆、連結、出處、理由、測試清單、題目文字。
+    題目文字只取第一個方括號標記之前;連結與欄位只在標記之後找(題目內文的「測試:」「→」不當欄位)。
+    節內像題目卻不合文法的行也收進來,帶 bad(原因),不靜默丟——lint 報它、規格閘擋它。"""
+    sec = _pq_sections((text or "").splitlines())
+    if sec is None:
+        return None
+    out = []
+    for no, ln in sec:
+        m = _PQ_LINE_RE.match(ln)
+        if m:
+            out.append(_pq_parse_line(no, m.group(2), int(m.group(1))))
+        elif _PQ_LOOKS_RE.search(ln):
+            out.append({"id": None, "line": no, "bad": f"第 {no} 行看不懂:{first_line(ln.strip(), 40)}——{_PQ_SHAPE}",
+                        "blocking": False, "irreversible": False, "status": None, "stage": None})
+    return out
+
+
+def pending_question_problems(qs, decision_state, clause_tests):
+    """形狀與必附的問題清單(每條以題號或行號開頭)。decision_state(link) → "ok"/"missing"/"superseded";clause_tests=本篇條款綁的測試名。"""
+    errs, seen = [], {}
+    for q in qs:
+        if q["bad"]:
+            errs.append(q["bad"])
+            continue
+        qid, st = q["id"], q["status"]
+        if qid in seen:
+            errs.append(f"{qid} 編號重複(第 {seen[qid]} 行與第 {q['line']} 行)")
+        else:
+            seen[qid] = q["line"]
+        for k in q["dup_tags"]:
+            errs.append(f"{qid} 的 [{k}:…] 重複寫了兩次,只留一個")
+        if st not in PQ_STATUSES:
+            errs.append(f"{qid} 的狀態要是 {'/'.join(PQ_STATUSES)} 之一,寫的是 {st!r}")
+            continue
+        if q["stage"] not in PQ_STAGES:
+            errs.append(f"{qid} 的階段要是 {'/'.join(PQ_STAGES)} 之一,寫的是 {q['stage']!r}")
+        if not q["cls"]:
+            errs.append(f"{qid} 沒寫 [類:…]")
+        if st in ("已決", "已驗"):
+            if not q["link"]:
+                errs.append(f"{qid} 是{st}卻沒有「→ #dN」指到決策")
+            else:
+                ds = decision_state(q["link"])
+                if ds == "missing":
+                    errs.append(f"{qid} 指到的決策 {q['link']} 不存在")
+                elif ds == "superseded":
+                    errs.append(f"{qid} 指到的決策 {q['link']} 已作廢,改指到取代它的那條")
+        if st == "已驗":
+            if not q["tests"]:
+                errs.append(f"{qid} 是已驗卻沒寫「測試:<測試名>」")
+            for t in q["tests"]:
+                if t not in clause_tests:
+                    errs.append(f"{qid} 的測試 {t} 不在本篇任何一條驗收條款的 [test:] 裡")
+        if st == "自答" and len(q["source"]) < 4:
+            errs.append(f"{qid} 是自答卻沒附出處(出處: 至少 4 字)")
+        if st == "延後" and len(q["reason"]) < 4:
+            errs.append(f"{qid} 是延後卻沒附理由(理由: 至少 4 字)")
+        if q["irreversible"] and st == "自答":
+            errs.append(f"{qid} 標了不可逆,不得自答——做了回不去的決定要人裁")
+        if q["blocking"] and st == "延後":
+            errs.append(f"{qid} 標了阻塞卻是延後——延後代表它不阻塞,兩者矛盾")
+    return errs
+
+
+def pending_questions_blocking_gate(qs):
+    """規格閘要擋的題:看不懂的題目行;標阻塞卻寫錯狀態或階段(認不得就當沒結);標阻塞、需求或架構階段、待查或待人。"""
+    def held(q):
+        if q["bad"]:
+            return True
+        if not q["blocking"]:
+            return False
+        if q["status"] not in PQ_STATUSES or q["stage"] not in PQ_STAGES:
+            return True
+        return q["stage"] in ("需求", "架構") and q["status"] in PQ_OPEN
+    return [q for q in (qs or []) if held(q)]
+
+
+def pending_questions_for_stage(qs, stage):
+    """pitfalls --stage:那一階段還沒結的題,依阻塞、不可逆、其餘排序,同級照編號;不設題數上限(計劃決策 d8)。看不懂的行不列(lint 報)。"""
+    rows = [q for q in (qs or []) if not q["bad"] and q["stage"] == stage and q["status"] in PQ_OPEN]
+    return sorted(rows, key=lambda q: (0 if q["blocking"] else 1 if q["irreversible"] else 2, q["num"]))
+
+
+def _pq_decision_state(env, rel):
+    def state(link):
+        m = re.match(r"(?:\[\[([^\]|#]+)(?:\|[^\]]*)?\]\])?#d(\d+)$", link)
