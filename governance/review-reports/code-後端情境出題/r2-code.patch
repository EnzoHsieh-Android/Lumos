+            return "missing"
+        target = env.resolve(m.group(1)) if m.group(1) else rel
+        n = env.notes.get(target) if target else None
+        if n is None:
+            return "missing"
+        for d in parse_decisions(n.fm_lines or []):
+            if str(d.get("id")) == f"d{m.group(2)}":
+                return "superseded" if str(d.get("valid", "true")).strip().lower() == "false" else "ok"
+        return "missing"
+    return state
+
+
+def _pq_clause_tests(text):
+    """本篇驗收條款定義行綁的測試名。哪些字看得見、哪行算定義,照條款綁定(clause_bindings)用的同一組:
+    _visible_lines、_strip_inline_markup、_CLAUSE_LEAD_RE;測試名正規化同題目側(_pq_tests)。"""
+    names = set()
+    for _no, raw in _visible_lines((text or "").split("\n")):
+        line, _cut = _strip_inline_markup(raw)
+        lead = _CLAUSE_LEAD_RE.match(line)
+        if lead:
+            for m in TEST_REF_RE.finditer(line[lead.end():]):
+                names.update(_pq_tests(m.group(1)))
+    return names
+
