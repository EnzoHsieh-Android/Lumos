+def pending_questions_blocking_gate(qs):
+    """規格閘要擋的題:看不懂的題目行;標阻塞卻寫錯狀態或階段(認不得就當沒結);標阻塞、需求或架構階段、待查或待人。"""
+    def held(q):
+        if q["bad"]:
+            return True
+        if not q["blocking"]:
+            return False
+        if q["status"] not in PQ_STATUSES or q["stage"] not in PQ_STAGES:
+            return True
+        return q["stage"] in ("需求", "架構") and q["status"] in PQ_OPEN
+    return [q for q in (qs or []) if held(q)]
+
+
+def pending_questions_for_stage(qs, stage):
+    """pitfalls --stage:那一階段還沒結的題,依阻塞、不可逆、其餘排序,同級照編號;不設題數上限(計劃決策 d8)。看不懂的行不列(lint 報)。"""
+    rows = [q for q in (qs or []) if not q["bad"] and q["stage"] == stage and q["status"] in PQ_OPEN]
+    return sorted(rows, key=lambda q: (0 if q["blocking"] else 1 if q["irreversible"] else 2, q["num"]))
+
+
+def _pq_decision_state(env, rel):
+    def state(link):
+        m = re.match(r"(?:\[\[([^\]|#]+)(?:\|[^\]]*)?\]\])?#d(\d+)$", link)
+        if not m:
+            return "missing"
+        target = env.resolve(m.group(1)) if m.group(1) else rel
+        n = env.notes.get(target) if target else None
+        if n is None:
+            return "missing"
+        for d in parse_decisions(n.fm_lines or []):
+            if str(d.get("id")) == f"d{m.group(2)}":
+                return "superseded" if str(d.get("valid", "true")).strip().lower() == "false" else "ok"
+        return "missing"
+    return state
+
+
+def _pq_clause_tests(text):
+    """本篇驗收條款定義行綁的測試名。哪些字看得見、哪行算定義,照條款綁定(clause_bindings)用的同一組:
+    _visible_lines、_strip_inline_markup、_CLAUSE_LEAD_RE;測試名正規化同題目側(_pq_tests)。"""
+    names = set()
+    for _no, raw in _visible_lines((text or "").split("\n")):
+        line, _cut = _strip_inline_markup(raw)
+        lead = _CLAUSE_LEAD_RE.match(line)
+        if lead:
+            for m in TEST_REF_RE.finditer(line[lead.end():]):
+                names.update(_pq_tests(m.group(1)))
+    return names
