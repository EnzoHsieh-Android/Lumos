+# ── 待決問題(情境出題,[[Projects/後端工程提問與證據擴充_計劃]] A 塊)────────────────────────────
+# 計劃筆記一節「## 待決問題」,一題一行:- [Q<n>] <問題> [類:..][階段:..][狀態:..] 可接 [阻塞] [不可逆]、→ 連結、出處:、理由:、測試:
+# 規格閘、lint、pitfalls --stage 三處共用 parse_pending_questions(只吃文字、不讀圖譜);要查決策或測試的檢查只放規格閘與 lint。
+PQ_STATUSES = ("待查", "自答", "待人", "延後", "已決", "已驗")
+PQ_STAGES = ("需求", "架構", "實作", "驗證", "效能", "交付")
+PQ_OPEN = ("待查", "待人")
+_PQ_HEAD_RE = re.compile(r"^##\s+待決問題\s*$")
+_PQ_LINE_RE = re.compile(r"^\s*[-*]\s+\[Q(\d+)\]\s*(.*)$")
+_PQ_TAG_RE = re.compile(r"\[(類|階段|狀態):([^\]\n]*)\]|\[(阻塞|不可逆)\]")
+_PQ_FIELD_RE = re.compile(r"(出處|理由|測試):\s*(.*?)(?=\s+(?:出處|理由|測試):|$)")
+_PQ_LINK_RE = re.compile(r"→\s*(\[\[[^\]]+\]\]#d\d+|#d\d+)")
+
+
+def parse_pending_questions(text):
+    """回〈待決問題〉一節的題目清單;計劃沒有這一節回 None。每題:id、行號、類、階段、狀態、阻塞、不可逆、連結、出處、理由、測試。"""
+    lines = (text or "").splitlines()
+    start = next((i for i, ln in enumerate(lines) if _PQ_HEAD_RE.match(ln)), None)
+    if start is None:
+        return None
+    out = []
+    for k in range(start + 1, len(lines)):
+        ln = lines[k]
+        if re.match(r"^#{1,2}\s", ln):
+            break
+        m = _PQ_LINE_RE.match(ln)
+        if not m:
+            continue
+        rest, tags, flags = m.group(2), {}, set()
+        for t in _PQ_TAG_RE.finditer(rest):
+            if t.group(1):
+                tags[t.group(1)] = t.group(2).strip()
+            else:
+                flags.add(t.group(3))
+        tail = _PQ_TAG_RE.sub(" ", rest)
+        fields = {f.group(1): f.group(2).strip() for f in _PQ_FIELD_RE.finditer(tail)}
+        link = _PQ_LINK_RE.search(tail)
+        out.append({"id": f"Q{m.group(1)}", "num": int(m.group(1)), "line": k + 1,
+                    "cls": tags.get("類"), "stage": tags.get("階段"), "status": tags.get("狀態"),
+                    "blocking": "阻塞" in flags, "irreversible": "不可逆" in flags,
+                    "link": link.group(1) if link else None,
+                    "source": fields.get("出處", ""), "reason": fields.get("理由", ""),
+                    "test": (fields.get("測試") or "").split()[0] if fields.get("測試") else None,
+                    "text": re.split(r"\s*(?:→|出處:|理由:|測試:)", tail)[0].strip()})
+    return out
+
+
+def pending_question_problems(qs, decision_state, clause_tests):
+    """形狀與必附的問題清單(每條以題號開頭)。decision_state(link) → "ok"/"missing"/"superseded";clause_tests=本篇條款綁的測試名。"""
+    errs, seen = [], {}
+    for q in qs:
+        qid, st = q["id"], q["status"]
+        if qid in seen:
+            errs.append(f"{qid} 編號重複(第 {seen[qid]} 行與第 {q['line']} 行)")
+        else:
+            seen[qid] = q["line"]
+        if st not in PQ_STATUSES:
+            errs.append(f"{qid} 的狀態要是 {'/'.join(PQ_STATUSES)} 之一,寫的是 {st!r}")
+            continue
+        if q["stage"] not in PQ_STAGES:
+            errs.append(f"{qid} 的階段要是 {'/'.join(PQ_STAGES)} 之一,寫的是 {q['stage']!r}")
+        if not q["cls"]:
+            errs.append(f"{qid} 沒寫 [類:…]")
+        if st in ("已決", "已驗"):
+            if not q["link"]:
