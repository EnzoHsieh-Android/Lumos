++def sign_flip_p(diffs):
++    """單側精確符號翻轉檢定:所有正負號組合中,總和 ≥ 觀察總和的比例。"""
++    obs = sum(diffs)
++    combos = list(itertools.product((1, -1), repeat=len(diffs)))
++    hits = sum(1 for c in combos if sum(s * d for s, d in zip(c, diffs)) >= obs - 1e-12)
++    return hits / len(combos)
