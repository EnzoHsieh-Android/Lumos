++def final_gate(main, sensitivity):
++    """主判定與兩個單一評分員判定不一致 → 攤給人裁(預先登記〈評分〉自我偏好)。"""
++    return main if all(v == main for v in sensitivity) else "NEEDS_HUMAN"
