+++# ── 評分員標註 ────────────────────────────────────────────────────────────────
+++def _read_labels(path):
+++    out = {}
+++    for f in sorted(Path(path).glob("*.json")):
+++        for row in json.loads(f.read_text(encoding="utf-8")):
+++            if row["blind_id"] in out:
+++                raise ValueError(f"{row['blind_id']} 重複標註")
