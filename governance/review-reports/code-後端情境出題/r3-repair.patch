++HERE = Path(__file__).resolve().parent
++REPO = HERE.parent.parent.parent
++LABELS = ("handed", "assumed_confirm", "absent")   # 交給人決定 / 自己假設但請人確認 / 沒提或自己定了
++N_GOLD = 6
