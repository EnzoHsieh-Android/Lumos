   813	def cmd_loop_rewrite(env, loop_id, successor, note):
   814	    """人裁「整份重寫」的收尾記帳(設計審收斂重定義 d3 帳面件的寫入端;2026-08-25 第一次真實
   815	    rewrite 事件時補建)。寫 gate=design-loop kind=rewrite 事件到治理帳,note 機械帶血緣
   816	    (prev=舊編號;successor=新編號)——「連續兩次判重寫→強制攤人,不得三開」靠沿 note 鏈查,
   817	    本指令寫入前自動查一跳:若本編號自己就是某次 rewrite 的 successor,印強制攤人警告(advisory)。"""
   818	    if not successor or successor.strip() == loop_id.strip():
   819	        print("擋下:--successor 要給新開的迴圈編號,而且不能跟舊編號一樣——重寫=換新編號載新版,同號沒有「重寫」可言", file=sys.stderr)
   820	        return 2
   821	    # 血緣一跳查詢:這個編號是不是已經是上一次重寫的產物?
   822	    chain_prev = None
   823	    try:
   824	        import json as _j
   825	        import re as _re
   826	        gl = env.vault.parent / ".governance-log.jsonl"
   827	        # 邊界比對:successor=<id> 後面必須是分號或字串結尾——裸子字串會讓前綴編號互撞
   828	        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
   829	        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
   830	        if gl.exists():
   831	            for line in gl.read_text(encoding="utf-8").splitlines():
   832	                try:
   833	                    o = _j.loads(line)
   834	                except ValueError:
   835	                    continue
   836	                if not isinstance(o, dict):
   837	                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
   838	                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
   839	                        and _pat.search(str(o.get("note", ""))):
   840	                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
   841	    except OSError:
   842	        pass
   843	    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
   844	    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
   845	    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
   846	    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
   847	    if chain_prev:
   848	        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
   849	    print("  之後查血緣:")
   850	    print("    lumos gov --stats")
