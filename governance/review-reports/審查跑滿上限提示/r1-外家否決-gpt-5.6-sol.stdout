def _roster_kind(loop_id):
    """loop id 前綴三值判:code-(含連字號)=code;code 開頭無連字號=None(indeterminate,
    歷史帳實有 code側刪除傳播守衛/codestage);其餘=design。"""
    if loop_id.startswith("code-"):
        return "code"
    if loop_id.startswith("code"):
        return None
    return "design"


LOOP_ORCHESTRATORS = ("claude", "codex")
_ROSTER_CODEX_KEYS = ("codex", "gpt")     # 編排者是 Codex 時,這幾個字眼=同門




def _roster_kind(loop_id):
    """loop id 前綴三值判:code-(含連字號)=code;code 開頭無連字號=None(indeterminate,
    歷史帳實有 code側刪除傳播守衛/codestage);其餘=design。"""
    if loop_id.startswith("code-"):
        return "code"
    if loop_id.startswith("code"):
        return None
    return "design"


LOOP_ORCHESTRATORS = ("claude", "codex")
_ROSTER_CODEX_KEYS = ("codex", "gpt")     # 編排者是 Codex 時,這幾個字眼=同門


def _loop_records(env, loop_id, strict=False):
    """canary-log 裡某編號的全部記錄(唯讀;壞行跳過)。單一讀法——cmd_loop_next 與 record 定錨檢查共用
    (code-codex-s2 r1 架構席:兩份逐行相同的讀帳迴圈會各自漂)。strict=True 時檔讀不到就丟 OSError 給呼叫端印。"""
    import json as _json
    path = env.vault.parent / ".canary-log.jsonl"
    out = []
    try:
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    d = _json.loads(line)
                except ValueError:
                    continue
                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16)
                    out.append(d)
    except OSError:
        if strict:
            raise
        return out
    return out


def _loop_orchestrators(rounds):
    """帳面出現過的編排者值集合(矛盾偵測用)。"""
    return {r.get("orchestrator") for r in rounds if r.get("orchestrator") in LOOP_ORCHESTRATORS}


def _loop_orchestrator(rounds):
    """帳面編排者定錨:首個帶 orchestrator 的記錄;舊帳沒有 → None(讀側視為 claude 並印一句,不給新呼叫預設——
    Projects/Codex完全支援_計劃 d4:預設 claude 會讓 Codex 編排漏旗標時靜默套錯家族)。"""
    return next((r.get("orchestrator") for r in rounds if r.get("orchestrator") in LOOP_ORCHESTRATORS), None)


def _roster_family(auditor, orchestrator="claude"):
    """auditor 字串→(family, dual_hit)。family 是★相對編排者★的:"claude"=同門(編排者那一家)、"external"=外家
    (保留舊字串,_TIER_ROSTER 的 family 欄同義:claude 席=同門席、external 席=外家席;d4 相對化 2026-09-04)。
    lower() 子串比對;判序寫死外家先比、先命中先贏。orchestrator=codex 時 codex/gpt 是同門、sonnet/opus/claude 是外家。"""
    s = (auditor or "").lower()
    if orchestrator == "codex":
        own = any(k in s for k in _ROSTER_CODEX_KEYS)
        other = any(k in s for k in _ROSTER_CLAUDE_KEYS) or any(k in s for k in _ROSTER_EXTERNAL_KEYS if k not in _ROSTER_CODEX_KEYS)
    else:
        own = any(k in s for k in _ROSTER_CLAUDE_KEYS)
        other = any(k in s for k in _ROSTER_EXTERNAL_KEYS)
    if other:
        return ("external", own)
    if own:
        return ("claude", False)
    return ("unknown", False)


def _roster_dispatch_entries(loop_dir, rid):
    """解析一輪的 rN-dispatch*.json → (auditor 串列, 跳過檔數)。三種真實形狀:
    ①dict 頂層 auditor ②dict 帶 seats 陣列 ③頂層 list;壞損 JSON 與不符形狀同一處置=跳過不計。"""
    import json as _json
    auditors, skipped = [], 0
    for f in sorted(loop_dir.glob(f"{rid}-dispatch*.json")):
        try:
            obj = _json.loads(f.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, ValueError):
            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
            skipped += 1
            continue
        if isinstance(obj, dict) and "auditor" in obj:
            elems = [obj]
        elif isinstance(obj, dict) and isinstance(obj.get("seats"), list):
            elems = obj["seats"]
        elif isinstance(obj, list):
            elems = obj
        else:
            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
            skipped += 1
            continue
        for e in elems:
            a = e.get("auditor") if isinstance(e, dict) else None
            auditors.append(a if isinstance(a, str) else None)   # 非字串(數字/巢狀物)=無名席→unknown 桶,不炸整段觀測
    return auditors, skipped


def _roster_observe(env, loop_id, rounds, repo, only_rid=None, anomalies_only=False):
    """loop status --roster 觀測段(advisory 恆不影響 rc):應派(_TIER_ROSTER)vs 實派(dispatch 快照)
    逐輪分桶對帳。落點=cmd_loop_status 入口、各模式分支 early-return 之前(四模式皆吃得到)。
    roster對帳併入問閘 [S1]:only_rid=只對這一輪(同時抑制內部 dispatch glob 補漏——問閘尾端用);
    anomalies_only=只印異常六種(external_missing/單家族/真兼任/命名歧義/unknown 降級/shortfall),
    抑制摘要與診斷四種;回傳本次印出的異常種類清單(留痕用)。同一實作服務兩種呼叫,禁抄改。"""
    anomalies = []
    def _quiet(msg):
        if not anomalies_only:
            print(msg)
    kind = _roster_kind(loop_id)
    if kind is None:
        _quiet(f"[roster] {loop_id}:看不出是設計審還是代碼審(名稱 code 開頭但不是 code- 格式),跳過派工對帳")
        return anomalies
    # only_rid(問閘單輪)時 tier 取「該輪自己」的紀錄——跨輪 tier 不同時拿第一筆會查錯編制表,
    # high 輪的 fail-closed 警訊被降級成 standard 的軟提醒(code-batch2 s1-f1,席位純 CLI 重現)
    # only_rid(問閘單輪):tier 只認判定輪自己的紀錄,★不 fallback 借別輪的★——
    # 借用=同型病換觸發條件(r2 d-f1);判定輪沒記 tier → 走「沒有編制表可以對」照實講。
    # 副作用即縱深:__seqN 合成鍵永遠對不到 round 欄 → tier=None → 天然安靜,
    # 下方 startswith("__") guard 成為第二道防禦(單釘無法只殺 guard,兩道要一起拔才會響)。
    if only_rid:
        tier = next((r.get("tier") for r in rounds
                     if r.get("round") == only_rid and r.get("tier")), None)
    else:
        tier = next((r.get("tier") for r in rounds if r.get("tier")), None)
    orch = _loop_orchestrator(rounds)
    _quiet(f"[roster] {loop_id}:類型 {kind}(從名稱前綴推的),分級 {tier or '沒指定'},編排者 {orch or '帳面沒記,視為 claude'}"
           + ("" if orch else "(舊帳相容;新迴圈 loop next 首輪要帶 --orchestrator)"))
    _orchs = _loop_orchestrators(rounds)
    if len(_orchs) > 1:
        print(f"[roster] {loop_id}:帳面編排者不一致({'/'.join(sorted(_orchs))})——以下家族對帳照第一筆算,但這本帳本身矛盾,先修帳再信對帳結果")
        anomalies.append("編排者不一致")
    orch = orch or "claude"
    if tier is None:
        _quiet("[roster] 這個編號沒指定過分級(舊格式或還沒記錄),沒有編制表可以對")
        return anomalies
    entry = _TIER_ROSTER.get((kind, tier))
    if entry is None:
        _quiet(f"[roster] 無編制宣告:{kind}/{tier} 這個組合沒定義該派誰,跳過對帳")
        return anomalies
    root = Path(repo).resolve() if repo else _vault_repo_root(env)
    loop_dir = root / "governance" / "review-reports" / loop_id
    if only_rid is not None:
        rids = [only_rid]   # 問閘當輪:不掃 log、不 glob 補漏(std-r1 s1-f1)
    else:
        rids = []
        for r in rounds:
            rid = r.get("round")
            if rid and rid not in rids:
                rids.append(rid)
        if loop_dir.is_dir():
            import re as _re
            for f in sorted(loop_dir.glob("*-dispatch*.json")):
                m = _re.match(r"^(r\d+)-dispatch", f.name)
                if m and m.group(1) not in rids:
                    rids.append(m.group(1))
    if not rids:
        _quiet("[roster] 沒有輪次記錄也沒有派工快照,沒東西可對")
        return anomalies
    seats = entry["seats"]
    req_c = [s for s in seats if s["requirement"] in ("required", "required-fail-closed") and s["family"] == "claude"]
    req_e = [s for s in seats if s["requirement"] in ("required", "required-fail-closed") and s["family"] == "external"]
    nia = [s for s in seats if s["requirement"] == "note-if-absent"]
    _hinted = set()   # 席名提示每個名字只印一次(多輪帳面別洗版;code-codex-s2 r1 單reviewer F6)
    for rid in rids:
        auditors, _skipped = _roster_dispatch_entries(loop_dir, rid) if loop_dir.is_dir() else ([], 0)
        if not auditors:
            _quiet(f"[roster] {rid}:沒有派工快照可對(舊記錄或還沒寫入)")
            continue
        fams = [(a, *_roster_family(a, orch)) for a in auditors]
        for a in auditors:   # 席名慣例 <鏡頭>-<模型>(收斂閘殘餘估計降級_計劃):沒帶模型尾碼的外家席只提示不改帳(調研候選 ⑥)
            if _roster_family(a, orch)[0] == "external" and "-" not in a and a not in _hinted:
                _hinted.add(a)
                _quiet(f"[roster] {rid}:席名 {a} 沒帶模型尾碼,建議照慣例寫成 <鏡頭>-<模型>(如 外家否決-codex),家族辨識才穩")
        n_c = sum(1 for _, f, _d in fams if f == "claude")
        exts = [a for a, f, _d in fams if f == "external"]
        unks = [a for a, f, _d in fams if f == "unknown"]
        duals = [a for a, _f, d in fams if d]
        hedge = f"可能缺(另有 {len(unks)} 席家族無法辨識)" if unks else "缺"
        _quiet(f"[roster] {rid}: 實派 {len(auditors)} 席(同門[{orch}] {n_c}/外家 {len(exts)}/unknown {len(unks)})"
               f";應派 required 同門 {len(req_c)}+外家 {len(req_e)}")
        if len(exts) < len(req_e):
            fc = any(s["requirement"] == "required-fail-closed" for s in req_e)
            msg = f"[roster] {rid}:external_missing——外部審查員{hedge}不夠(實際 {len(exts)} 席,應有 {len(req_e)} 席)"
            if fc:
                msg += ";此席編制為 fail-closed(本行僅轉述編制對照,不裁決;處置見 code-loop skill)"
            print(msg); anomalies.append("external_missing")
        if n_c < len(req_c):
            print(f"[roster] {rid}:seat_shortfall——同門({orch})審查員{hedge}不夠(實際 {n_c} 席,應有 {len(req_c)} 席)")
            anomalies.append("seat_shortfall")
        if len(req_e) >= 2:
            from collections import Counter as _Counter
            for name, cnt in _Counter(exts).items():
                if cnt >= 2:
                    print(f"[roster] {rid}:真兼任——外部審查員疑似一人兼任多席({cnt} 席都叫 {name})")
                    anomalies.append("真兼任")
        if nia and not exts:
            print(f"[roster] {rid}:單家族(只有同一家模型在審)——外家席本輪未派(編制={nia[0]['requirement']};"
                  f"辯方是否該派屬編排當場判斷,本行僅轉述編制對照,不裁決),收斂結論要講保守一點")
            anomalies.append("單家族")
        for s in seats:
            if s["requirement"] == "conditional":
                _quiet(f"[roster] {rid}:{s['slot']} 是條件席(條件:{s.get('note', '?')}),該不該派由編排者自己對")
        for a in unks:
            print(f"[roster] {rid}:看不出 {a} 是哪一家的審查員,列出但不判定")
            anomalies.append("unknown")
        for a in duals:
            print(f"[roster] {rid}:命名歧義——{a} 的名字同時像兩家,先當成外部審查員算")
            anomalies.append("命名歧義")
    return anomalies


def _roster_next_payload(loop_id, eff_tier):
    """loop next 的應派 roster:(dict|None, note|None)。legacy=單席通才慣例;
    indeterminate 與查表 miss=None+對應 note(per-command 訊息:next 無對帳可跳,不印「跳過對帳」)。"""
    kind = _roster_kind(loop_id)
    if kind is None:
        return None, "kind 無法判定(code 開頭但非 code- 慣例)"
    if eff_tier == "legacy":
        return {"mode": "single", "seats": [_rseat("通才", "claude", True, "required")]}, None
    entry = _TIER_ROSTER.get((kind, eff_tier))
    if entry is None:
        return None, f"無編制宣告(組合 {kind}/{eff_tier} 未定義)"
    return entry, None



# ═══ 圖譜進迴圈入口栓(Projects/圖譜進迴圈入口栓_計劃 2026-08-30,兩輪五席審後落地) ═══
# 日期前綴剝除復用既有 _NODE_DATEPFX_RE(scripts/lumos cmd_impact D2 近名判定同源;r1 架構席 A-1:禁第 N 份同型正則)
_EL_NEAR_THRESHOLD = 0.6      # B 的檔名 difflib 單判準;A 的 ★近名 沿用(spec EL-16)


def _el_is_cjk(ch):
    """與 _rank_tokenize 的 _RANK_CJK_RE 同源(單一真相;r1 三席同抓:原自寫範圍漏擴充A、多認切詞器
    根本不產出的假名/諺文=死碼)。"""
    return bool(_RANK_CJK_RE.match(ch))


def _el_query_tokens(source):
    """A 的切詞清洗(spec v3 三步):重用 _rank_tokenize(禁第二份切詞實作)後——
    ①丟可拆分母 token(含 -/_ 的複合 token;不丟則 auto-2026-08-23 整顆存活、誠實分支永不觸發,r2 D-5 實測)
    ②濾純數字(「2026」命中 381/385=全庫召回)與長度 1 的 ASCII token ③去重保序。回 (tokens, has_cjk)。"""
    out, seen, has_cjk = [], set(), False
    for t in _rank_tokenize(nfc(str(source)).lower()):
        if "-" in t or "_" in t:
            continue
        if t.isdigit():
            continue
        if len(t) <= 2 and t.isascii():
            continue          # r1 邊界席 B-1:2 字母尾碼(auto-…-ab)漏網率 14%、間歇打紅;真實編號詞皆 ≥4
        if len(t) == 1:
            continue          # r1 邊界席 B-2:單一常見漢字(「的」)=2026 型全庫召回,同病同濾
        if any(_el_is_cjk(ch) for ch in t):
            has_cjk = True
        if t not in seen:
            seen.add(t)
            out.append(t)
    return out, has_cjk


def _el_near_norm(s):
    s = _NODE_DATEPFX_RE.sub("", nfc(s).lower())
    for suf in ("_實作計畫", "_計劃"):   # r1 外家 F2:無關短名靠共同後綴恰達 0.6;剝後無關對歸 0、真近名對 0.917
        if s.endswith(suf):
            return s[: -len(suf)]
    return s


def _el_near_ratio(a, b):
    import difflib
    return difflib.SequenceMatcher(None, _el_near_norm(a), _el_near_norm(b)).ratio()


def _el_near_name(a, b):
    """近名判準(spec EL-8/EL-16/EL-17):剝 YYYY-MM-DD_ 前綴後 difflib ≥0.6 單判準(repo 無 stemmer,「詞幹」已裁刪)。"""
    return _el_near_ratio(a, b) >= _EL_NEAR_THRESHOLD




def _no_vault_msg():
    """印「這個專案沒有圖譜」並回 rc3。★四處共用,不要各自複製一份★。

    出身(2026-09-07 全 repo 審視 #9 / 代碼審 r1 架構席):同一件事原本三種問法給三種答案,
    其中一種還回成功印「0 篇」看起來像查過了。第一版統一時我把同一段六行訊息**複製貼上四份**
    ——而旁邊那支 _node_not_found 的說明自己就寫著「複製貼上時漏改」正是它要修的舊 bug 根因。
    這段連參數都不用傳,比那支更該抽。
    """
    print("擋下:這個專案底下找不到知識圖譜(docs/*-knowledge),所以沒有東西可以查。",
          file=sys.stderr)
    print("  為什麼在意:這跟「查過了、沒有相關筆記」是兩件事——"
          "前者是還沒建圖譜,後者才是真的沒關聯。", file=sys.stderr)
    print("  這個專案要用圖譜的話:", file=sys.stderr)
    print("      lumos init", file=sys.stderr)
    print("  只是想指到別的地方的圖譜:加 --repo <含圖譜的目錄>", file=sys.stderr)
    return 3


def _node_not_found(env, name, *, write_side=False):
    """印「找不到這篇筆記」並給近名候選。★讀取指令與寫入指令用不同的後半句★。

    出身(2026-09-07 全 repo 審視 #9):四支**讀取**指令(健康巡檢、看合約、看漂移史、
    決策重編)打錯節點名時,印的都是「決策沒地方掛」——那是**寫入側專用**的話,
    白話化那批複製貼上時漏改。讀的人拿到一句對不上自己在做什麼的訊息,而且不給近名候選,
    只能自己回去猜名字。

    近名用既有的 _el_near_name(剝日期前綴後比相似度)。
    ★成本★:每次要走訪全圖譜比一次。本 repo 428 篇實測約 13 毫秒(含 CLI 啟動),無感;
    線性成長,一萬篇約 160 毫秒、五萬篇約 800 毫秒。
    REVISIT:2026-12-07 若有消費端圖譜超過一萬篇,這裡要改成先用便宜的前綴/長度篩再比
    ★這裡原本寫「repo 沒有第二種近名判準」——那是錯的事實(2026-09-07 代碼審 r1 架構席抓到)★:
    這個 repo 有兩支同型工具,_levenshtein_le1(只判差一個字,給開頭欄位鍵用,前一天才加的)
    與這支。兩支各有理由所以並存;要記住的是**不要再開第三支**——
    打錯指令那條第一版就又開了一支,已收斂回這支。
    """
    print(f"擋下:圖譜裡找不到叫「{name}」的筆記。", file=sys.stderr)
    try:
        cands = [rel for rel in env.notes if _el_near_name(name, Path(rel).stem)][:5]
    except Exception:                      # 找不到就找不到,不能因為找近名而炸
        cands = []
    if cands:
        print("  是不是想找這幾篇之一:", file=sys.stderr)
        for c in cands:
            print(f"      {c}", file=sys.stderr)
    else:
        print("  沒有名字接近的。用關鍵字找找看(中文查詢:概念之間加空白):", file=sys.stderr)
        print(f"      lumos search {name}", file=sys.stderr)
    if write_side:
        print("  確定要新建的話:", file=sys.stderr)
        print("      lumos new <類型> <名稱>", file=sys.stderr)
    return 2


def _el_node_meta(env, rel):
    """(status, 決策數)——status 取 frontmatter 欄位;決策數 len(parse_decisions)(機械數)。"""
    n = env.notes.get(rel)
    if n is None or not isinstance(n.fields, dict):
        return None, 0
    st = str(n.fields.get("status") or "").strip() or None
    try:
        dec = len(parse_decisions(n.fm_lines))
    except Exception:
        dec = 0
    return st, dec


_GIST_BAI_RE = re.compile(r"^>\s*白話[:\uff1a]\s*(.*)$")   # code-r1 B-1:全形冒號 2 篇實存
_GIST_LABEL_RE = re.compile(r"^(FLOW|KEY|FLAG|DEP|TEST|DECISION):\s*")
_GIST_BARE_RE = re.compile(r"^(FLOW|KEY|FLAG|DEP|TEST|DECISION):\s*[A-Z/\u2027\u3001 ,]*$")
_GIST_SENT_RE = re.compile(r"^.{0,79}?[\u3002!?;\uff1b\uff01\uff1f]")


def _gist_cut(s):
    """L0 截斷(Projects/一句話層供糧_計劃 T1,r1 M-5/E-2 折入):≤80 直取;
    >80 先取首句(句末符 。!?;;為界,首句 ≤80 才用);仍超 → 硬截 80+…。
    先 _esc_clean 消毒(控制碼換空格,同逃逸帳載重合約),大 limit=只消毒不在這層截。"""
    s = _esc_clean(nfc(str(s)).strip(), 100000)
    if len(s) <= 80:
        return s
    m = _GIST_SENT_RE.match(s)
    if m:
        return m.group(0)
    return s[:80] + "…"


def _gist(env, rel):
    """一句話層 L0(Projects/一句話層供糧_計劃 T1,2026-09-01,設計審 一句話層供糧-v2 r1):
    ①正文(=split_frontmatter 之後,r1 M-2 行為級定義:兩獨立席讀成「檔案前20行」
      會讓命中 84/390→43、Systems 歸零,故起算點寫死)前 20 行首個「> 白話:」行;
    ②無 → summary 第一個內容行——跳過裸分類標籤行(FLAG:DECISION 這型,全庫 40% 的
      summary 首行,r1 C-1)、剝 FLOW:/KEY: 等標籤前綴;
    ③都無 → 空字串(誠實缺席,絕不造假摘要——合約候選)。恆回 str;任何例外回空(fail-open)。"""
    try:
        n = env.notes.get(rel)
        if n is None:
            return ""
        try:
            text = (env.vault / rel).read_text(encoding="utf-8-sig")
        except Exception:
            text = ""
        if text:
            _fm, body = split_frontmatter(text)
            in_fence = False
            for raw in body.split("\n")[:20]:
                s = raw.strip()
                if s.startswith("```"):
                    in_fence = not in_fence   # code-r1 B-3:圍欄內字面示例不是真標記
                    continue
                if in_fence:
                    continue
                mbai = _GIST_BAI_RE.match(s)
                if mbai:
                    got = mbai.group(1).strip()
                    if got:
                        return _gist_cut(got)
                    break
        summ = n.fields.get("summary") if isinstance(n.fields, dict) else None
        if isinstance(summ, str):
            for raw in summ.split("\n"):
                s = raw.strip()
                if s[:1] in ("-", "*") and s[1:2] in (" ", "\t"):   # code-r1 B-5:tab 項目符號也剝
                    s = s[2:].strip()
                if not s or _GIST_BARE_RE.match(s):
                    continue
                s = _GIST_LABEL_RE.sub("", s, count=1).strip()
                if s:
                    return _gist_cut(s)
        return ""
    except Exception:
        return ""


def _el_related_nodes(env, source, top=5):
    """入口栓 A 的召回+排序(spec v3):OR 候選+_rank_score_candidates,★不走 cmd_search 頂層★
    (片語階段單命中即 break 會把 0.90 近名整篇藏掉——r1 邊界席拿事故本尊實測,EL-4/EL-11)。
    候選收集與 cmd_search 主迴圈同用 _search_visible_lines/nfc 原語,不另寫剝碼/切詞第二份。
    ★superseded 必納入★:「已裁不做」正是最值錢的命中(EL-10),輸出標 status 由讀者自判。
    回輸出合約 dict(EL-16):{"query","queried","nodes":[{"name","status","decisions","near_name","gist"}]};
    分支①未查:queried=false ②查了零候選:nodes=[](誠實零行只掛零候選這個機械事件,分數門檻已裁刪 EL-14)。
    任何內部例外由呼叫端 fail-open(EL-5)。"""
    tokens, has_cjk = _el_query_tokens(source)
    if len(tokens) <= 1 and not has_cjk:
        return {"query": str(source), "queried": False, "nodes": []}
    query = " ".join(tokens)
    cands = []
    for rel in sorted(env.notes):
        try:
            text = (env.vault / rel).read_text(encoding="utf-8-sig")
        except Exception:
            continue
        low = nfc("\n".join(pr for _no, _raw, pr
                             in _search_visible_lines(text.split("\n"), False))).lower()
        # 資格判定在收集端(code-r2 D2-1):ASCII token 要求詞邊界(「flow」不再吃「workflow」=r1 外家 F1 的假陽性),
        # CJK 照子字串。可見行含 frontmatter/decisions——「已裁不做」常只寫在 decisions 內容,
        # 而記分欄位不含 decisions;若用「分數>0」當資格會把這種真陽性整篇殺掉(EL-10 迴歸實錘)。
        # 分數(_rank_score_candidates)只管排序,不管資格;0 分=排最後,不=不相關。
        for t in tokens:
            if t.isascii():
                if re.search(r"(?<![a-z0-9])" + re.escape(t) + r"(?![a-z0-9])", low):
                    cands.append(rel)
                    break
            elif t in low:
                cands.append(rel)
                break
    if not cands:
        return {"query": query, "queried": True, "nodes": []}
    src_norm = str(source)   # 呼叫端已是 stem;再 .stem 會把 v1.1轉正 截成 v1(r1 正確性席 C-2)
    scored = _rank_score_candidates(env, query, cands)[:top]
    nodes = []
    for rel, _score, _hits in scored:
        st, dec = _el_node_meta(env, rel)
        stem = Path(rel).stem
        nodes.append({"name": stem, "status": st, "decisions": dec,
                      "near_name": _el_near_name(stem, src_norm),
                      "gist": _gist(env, rel)})
    return {"query": query, "queried": True, "nodes": nodes}


def cmd_loop_next(env, loop_id, tier=None, as_json=False, need=2, spec=None, repo=None, orchestrator=None):
    """M1包 #1(loop機械脊椎M1包_計劃):帳本吐唯一下一動作。唯讀指針——lumos 不 spawn agent,
    編排仍是 Claude(Systems/design-loop 分工)。phase 五值:escalate/gate-pending/converged/
    cap-reached/plant-canary;判定優先序=escalate→gate-pending(資訊不足,先於 cap)→converged
    (僅 full-basis)→cap-reached→plant-canary。converged=rc0/其餘 phase=rc1/錯誤=rc2。
    tier 定錨優先:帳面首個帶 tier 記錄定錨;僅無定錨舊帳按格式推導;零記錄 rc2 要 --tier。"""
    import json as _json
    import io
    import contextlib
    path = env.vault.parent / ".canary-log.jsonl"
    try:
        rounds = _loop_records(env, loop_id, strict=True)   # 單一讀法(架構席 s2 r1 major:曾與 helper 逐行重複)
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
        return 2
    n_round = sum(1 for r in rounds if "round" in r)
    if rounds and n_round not in (0, len(rounds)):
        print("擋下:這個審查編號的記錄有的帶輪次、有的不帶,格式前後不一致,沒辦法判斷收斂。打開審查記錄檔 .canary-log.jsonl,把這個編號的每一筆格式改一致", file=sys.stderr)
        return 2
    panel_fmt = n_round > 0
    if panel_fmt:   # 讀側損壞守衛不得因缺 --spec 提前 return 而繞過(code-loop r2 折入)
        seen, cur_rid = set(), None
        for r in rounds:
            rid = r["round"]
            if rid != cur_rid:
                if rid in seen:
                    print(f"擋下:第 {rid!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),這本帳只能照時間往後加,順序亂了就沒辦法判斷收斂。檢查 .canary-log.jsonl 裡這個編號的寫入順序",
                          file=sys.stderr)
                    return 2
                seen.add(rid)
                cur_rid = rid
    # ── tier 解析:定錨優先(v8);僅無定錨舊帳按格式推導;零記錄 rc2 ──
    anchor = _loop_anchor_tier(rounds)
    if tier and anchor and tier != anchor:
        print(f"擋下:你這次指定的分級是 {tier},但這個審查編號第一筆記錄就定成 {anchor} 了。分級第一筆定下就不能中途換——要換請開新的審查編號", file=sys.stderr)
        return 2
    eff_tier = anchor or tier
    # ── d4 編排者:首輪必帶(比照 --tier),不給預設;帳面定錨後要一致 ──
    orch_anchor = _loop_orchestrator(rounds)
    if orchestrator is not None and orchestrator not in LOOP_ORCHESTRATORS:
        print(f"擋下:--orchestrator 只能是 {'/'.join(LOOP_ORCHESTRATORS)} 之一,你給的是 {orchestrator!r}", file=sys.stderr)
        return 2
    if orchestrator and orch_anchor and orchestrator != orch_anchor:
        print(f"擋下:這個審查編號帳面定的編排者是 {orch_anchor},你這次說 {orchestrator}——中途換家帳就對不上,要換請開新編號", file=sys.stderr)
        return 2
    _orchs = _loop_orchestrators(rounds)
    if len(_orchs) > 1:
        print(f"擋下:這個審查編號帳面記的編排者不一致({'/'.join(sorted(_orchs))}),帳本矛盾、沒辦法判外家是誰——打開 .canary-log.jsonl 把該編號的 orchestrator 欄改一致(帳不可撤,或換新編號重記)", file=sys.stderr)
        return 2
    if rounds and orch_anchor is None and orchestrator and orchestrator != "claude":
        print(f"擋下:這個審查編號是沒記編排者的舊帳,讀側一律視為 claude 編排;要用 {orchestrator} 編排請開新編號(舊帳中途改分家會讓前幾輪的外家判定全變)", file=sys.stderr)
        return 2
    if not rounds and orchestrator is None:
        print("擋下:這是全新的審查編號,第一次呼叫要帶 --orchestrator claude|codex 說清楚是誰在編排(外家席=不是編排者那一家;"
              "工具不預設 claude——Codex 編排時漏了會靜默套錯家族)。之後記帳 `canary record … --orchestrator <同值>` 定錨", file=sys.stderr)
        return 2
    eff_orch = orch_anchor or orchestrator or "claude"
    if eff_tier is None:
        if not rounds:
            print("擋下:這是全新的審查編號,還沒有任何記錄,工具不會幫你猜分級(猜錯之後格式兜不起來反而卡住)。第一次呼叫請加 --tier 指定分級", file=sys.stderr)
            return 2
        eff_tier = "standard" if panel_fmt else "legacy"   # 無定錨舊帳 fallback
    width, cap = _TIER_PARAMS[eff_tier]
    light = eff_tier == "light"
    # seq=循序 code loop(skill 設計行為:code 的 standard 走單 reviewer 循序;
    # 2026-08-18 循序codeloop-tier錨定案——not panel_fmt 是硬規格,code+standard 的 panel 帳照 panel 樣式走)
    seq = (eff_tier == "standard" and _roster_kind(loop_id) == "code" and not panel_fmt)
    if seq:
        width = 1   # 單 reviewer;cap 沿 _TIER_PARAMS["standard"][1]=3(分量本就正確,不另覆寫)
    # ── tier↔格式一致性(code-loop r1 折入:格式推導可被繞——high 漏帶 --round 會走鬆的 legacy 閘;
    #    2026-08-18 放寬單一象限:code∧standard∧無round=循序設計行為,不再誤擋——歷史三個循序 loop
    #    因此被迫落 legacy cap6,見 Issues/loop-next吐不可宣告的tier) ──
    if rounds:
        if eff_tier in ("standard", "high") and not panel_fmt and not seq:
            print(f"擋下:{eff_tier} 這個分級規定每筆記錄都要帶輪次(--round),但這個編號目前的記錄全都沒帶,兩邊對不上。"
                  "之後記錄請帶 --round;如果一開始分級就選錯,請開新的審查編號", file=sys.stderr)
            return 2
        if light and panel_fmt:
            print("擋下:light 分級只能用單人、不分輪次的記錄,但這個編號的記錄帶了輪次(--round),兩邊對不上。確認分級選對了沒;選錯請開新的審查編號", file=sys.stderr)
            return 2
    rounds_count = len({r["round"] for r in rounds}) if panel_fmt else len(rounds)
    n_next = rounds_count + 1

    def emit(phase, extra=None):
        out = {"phase": phase, "tier": eff_tier, "orchestrator": eff_orch, "round": n_next, "width": width,
               "min_seats": width, "cap": cap, "advisory": "分級由編排者第一筆記錄時宣告、之後定死;工具只照分級查表,不自己判斷"}
        _roster, _rnote = _roster_next_payload(loop_id, eff_tier)
        # JSON 消費者也要拿到相對家族(code-codex-s2 r1 單reviewer F2):不改 family 欄(_TIER_ROSTER 契約),加 relative_family 與 orchestrator;複製一份別動共用表
        if _roster is None:
            out["roster"] = None
        else:
            out["roster"] = {k: v for k, v in _roster.items() if k != "seats"}
            out["roster"]["orchestrator"] = eff_orch
            out["roster"]["seats"] = [dict(s, relative_family=("同門" if s.get("family") == "claude" else "外家" if s.get("family") == "external" else s.get("family"))) for s in _roster.get("seats", [])]
        if _rnote:
            out["roster_note"] = _rnote
        if phase == "plant-canary":
            # 型別派工當下隨機抽(2026-08-06 S2 同場補,plan:驗證層自證三件):固定輪替
            # =可猜=答案印在考卷背面(該 plan r1 審計語);同輪 slot 間仍不重複(width≤4 時
            # 全 distinct;width>4 以重洗批次延續,重複最少化)——冗餘 canary 不算獨立注意力票。
            import random
            if light or eff_tier == "legacy" or seq:
                out["canary_type"] = random.choice(_CANARY_TYPES)
            else:
                pool = []
                while len(pool) < width:
                    pool.extend(random.sample(_CANARY_TYPES, len(_CANARY_TYPES)))
                out["canary_type"] = {f"slot{i}": pool[i - 1] for i in range(1, width + 1)}
            rmode = "" if (light or eff_tier == "legacy" or seq) else f" --round r{n_next}"
            # ★`legacy` 不是可宣告值,不得吐進 record_cmd★(2026-08-04):`--tier` 的 choices
            # 只有 light/standard/high(LOOP_TIERS),legacy 純粹是「無定錨舊帳 + legacy 格式」
            # 的推導結果。原本這裡無條件吐 `--tier {eff_tier}`,legacy 下等於★發一條 argparse
            # 當場擋掉的指令★;而使用者最自然的修復是「把 --tier 拿掉再跑一次」——拿掉就記不上
            # 定錨,下一輪 next 又推成 legacy、又吐一條跑不動的指令。
            # ★這個 bug 自己維持自己★:2026-08 三個走循序的 loop(code-slim-python /
            # code-teardown-windows / code-slim-handoff)全數 tier=None,即此循環的產物;
            # 其中 code-slim-python 吃到 legacy 的 cap 6(standard 是 3)才被逼停。
            # ★編號加 shell 引號★(代碼審 r3 資安 G1):loop_id 是自由字串,`code-x; touch … #` 原樣塞進
            # 這幾條每輪都印、照慣例原樣照抄的指令,`;` 之後就被當成指令跑;一般編號 shlex.quote 不加引號
            import shlex as _shlex
            _qid = _shlex.quote(loop_id)
            _tier_flag = f" --tier {eff_tier}" if eff_tier in LOOP_TIERS else ""
            _orch_flag = f" --orchestrator {eff_orch}"
            # ★用現行類別 none★:caught|missed 是 canary 植入協議的類別,2026-08-14 已停用(Systems/canary-audit d5),
            # 照抄舊模板等於教人記一筆已停用的帳;--snapshot:代碼審記帳從第一筆就要附審材,沒帶會被擋
            out["record_cmd"] = (f"lumos canary record none --loop {_qid}{rmode}"
                                 f" --auditor <席> --severity <s> --findings <M>"
                                 f" --report <席報告.md> --snapshot <凍結快照.md>"
                                 f" --spec <計劃節點.md> --reviewed <sha256>{_tier_flag}{_orch_flag}"
                                 f" --scope-lines <這輪審了幾行>")   # cb3 s3-f1:寫側 2026-08-26 起審查席必附報告,模板同步
            # [T5 design-loop重設計] 處置閘模板(選用;record_cmd 原樣保留給 code-loop/舊流程)
            if not light and eff_tier != "legacy":
                out["disposal_cmd"] = (
                    f"lumos canary record none --loop {_qid}{rmode}"
                    f" --auditor <席> --severity <s>"
                    f" --findings-set <id串> --folded-set <id串> --accepted-set <id串>"
                    f" --accept-reason <id=理由> --refuted-set none"
                    f" --report <席報告.md> --snapshot <凍結快照.md>"
                    f" --spec <計劃節點.md> --reviewed <sha256>{_tier_flag}{_orch_flag}")
                out["disposal_gate"] = f"lumos loop status {_qid} --disposal --spec <計劃節點.md> --repo <root>"
            if eff_tier == "legacy":
                if _roster_kind(loop_id) == "code":
                    # 循序codeloop-tier錨定案:standard 對 code 循序已格式相容,但補標=cap 陷阱——警告式,不邀請
                    out["tier_hint"] = (
                        "提醒:這個審查編號從沒指定過分級,現在用最寬鬆的舊規則在跑(單人審、最多 6 輪;正式的 standard 只給 3 輪)。"
                        "想中途改嚴:補 --tier high 會因格式不合直接被擋;補 --tier standard 格式相容,"
                        "但已經跑過的輪數會整批算進 3 輪上限,跑過 3 輪以上的一補標下一步就到頂。"
                        "要走嚴格規則,請開新的審查編號,並在第一筆記錄就帶 --tier。")
                else:
                    out["tier_hint"] = (
                        "提醒:這個審查編號從沒指定過分級,現在用最寬鬆的舊規則在跑(單人審、最多 6 輪),而且沒辦法事後補分級——"
                        "記錄格式已經定型(不帶輪次),補 --tier standard 或 high 會直接被擋;"
                        "--tier light 格式相容但只給 2 輪,跑過幾輪的通常一補就到頂。"
                        "要走嚴格規則,請開新的審查編號,並在第一筆記錄就帶 --tier。")
            # ★預防端:警告必須在派工「之前」★——記帳時才喊已經來不及(輪跑完了)。
            # loop next 是每輪第一步,所以量尺放這裡。
            out["scope_cap"] = (
                f"派工前先量這輪要審的東西有多少行(wc -l <工作副本或 patch>):超過 {_CANARY_SCOPE_SOFT_CAP_LINES} 行"
                "就拆開審——切成多輪,或分給多人各審一段。"
                "材料太長審查員會看不完、漏東西,這是外部研究的結論;"
                "本專案自己跑過三次對照實驗都量不到這個效應,所以別拿自家資料當佐證。"
                "超標不擋,但帳上會標成範圍過大、那輪抓到的結果算弱證據。")
        # ★cluster 帳的選擇只有第一輪能做★(2026-08-02):模式由「第一個有效輪」定錨,之後
        # 要換只能開新 loop id。而 M2 落地至今 316 筆 canary 記錄裡★只有 1 筆帶 clusters★,
        # 且那一筆是開發它的 code-m2cluster 自己——34 個 panel loop 中有 33 個靜默落回
        # 無-cluster 舊帳。根因不是機制不好,是★沒有任何地方在該選的時候提起它★。
        # 只在 N=1 提(那是選擇真正還開著的唯一時刻),避免對已定錨的 loop 噴無效噪音。
        if phase == "plant-canary" and not light and eff_tier != "legacy" and not seq and n_next == 1:
            out["cluster_hint"] = (
                "這是第一輪,要不要把發現分組追蹤只有現在能決定(第一個有效輪定下模式,之後要換只能開新編號):"
                "如果預期發現會散成性質不同的幾群(例如「規格縮水」和「邊界 bug」),"
                "記錄時加 --clusters '群名=resolved|accepted-minor:理由|disputed-major' 逐群追蹤,"
                "收斂改看「沒有爭議且嚴重的群」——不然不同性質的問題被壓成一個最高等級,一邊會蓋掉另一邊。"
                "單一主題、發現性質相同的用預設(不分組)就好。")
        # 圖譜入口栓 A(spec v3 EL-1):只在首輪+plant-canary、只掛正常 emit 出口;
        # --spec 有給→計劃檔名優先當查詢源,否則退編號(EL-3);fail-open:例外不得改 rc/既有輸出(EL-5)
        if phase == "plant-canary" and n_next == 1:
            try:
                # ★fail-open 鐵則:本 try 內禁止 sys.exit/SystemExit(except Exception 攔不到)★
                _rn0 = _el_related_nodes(env, Path(spec).stem) if spec else None
                if _rn0 is None or not _rn0["queried"]:
                    # r1 合約席 G-1+r2 delta D2-2:code loop 的 --spec 慣用值=凍結 patch(stem 如
                    # r1-snapshot→無訊號);spec 版查無訊號就一律改用編號版——spec 檔名是工具慣例名
                    # 非主題,其殘渣(snapshot)不得流進「要查自己跑」建議行
                    _rn0 = _el_related_nodes(env, loop_id)
                out["related_nodes"] = _rn0
            except Exception:
                pass
        # ★把「這個迴圈在審哪份東西」印出來★(2026-09-07,另一個 session 提的缺口:
        # 一個只拿到編號的新 session,loop next 給的東西已經夠它直接派工——現在狀態、
        # 分級、第幾輪、幾個人、五個席位各自的家族,全都有。★唯一斷掉的一步是「在審什麼」★,
        # 而那個資訊其實就在帳上,只是沒印出來,接手的人得自己去 tail 帳本。)
        #
        # ★取「最後一筆有值的」,不是「最後一筆」★:spec_path 是選配欄位,如果 r1 有記、
        # r2 沒記,取最後一筆會印「沒記」——而接手的人會誤解成「這個迴圈從來沒記過在審什麼」。
        # 兩種語意不能共用同一句話。(實測本庫 209 個迴圈:0 個落在這個差異上,
        # 兩種取法今天結果完全一致——但欄位是選配的,一致是現況不是保證,所以照安全的取。)
        #
        # ★措辭要帶輪次★:這裡說「接下來第 N 輪」,而帳上最後那筆是第 N-1 輪的材料。
        # 講成「這個迴圈在審 X」會讓人以為那就是下一輪要審的東西,而下一輪要自己凍一份新的。
        _sp_degraded = None
        try:
            _sp_rec = next((r for r in reversed(rounds)
                            if isinstance(r.get("spec_path"), str) and r["spec_path"].strip()), None)
            if _sp_rec:
                _sp = _sp_rec["spec_path"]
                # ★路徑要以「vault 所屬的 repo 根」為錨,不是 cwd★
                # (2026-09-07 代碼審 r1 外家否決席判 major,實測屬實:從 governance/ 底下
                #  不帶 --repo 呼叫,會對一個★確實存在★的檔案印「這個檔案現在不在了」
                #  ——正好是我想避免的「遞一條死路給人」的反面)。
                # _vault_repo_root 是這個 repo 既有的那支(從 vault 往上找 .git),
                # 判定閘的卷證解析用的也是它,不另寫一份。
                # ★連 .resolve() 都要跟既有那支一致★(代碼審 r1 架構對齊席:
                # 判定閘的解析根寫的是 `Path(repo).resolve() if repo else _vault_repo_root(env)`,
                # 而 _vault_repo_root 自己也是回 resolve 過的。少一個 resolve 就是第二套規則。)
                _root = Path(repo).resolve() if repo else _vault_repo_root(env)
                _sp_abs = Path(_sp) if Path(_sp).is_absolute() else (_root / _sp)
                out["reviewed_spec"] = {"path": _sp, "round": _sp_rec.get("round"),
                                        "exists": _sp_abs.exists(),
                                        "is_latest_round": _sp_rec is rounds[-1]}
        except Exception as _e:
            # ★不要謊稱「沒記」★(代碼審 r1 外家否決席 minor):壞掉的帳(spec_path 是 list/dict)
            # 會走到這裡,而文字模式接著會印「帳上沒記這個迴圈在審什麼」——那是假話,
            # 使用者分不出「真的沒記」和「記了但工具讀不動」。rc 不變,但要出聲。
            _sp_degraded = str(_e)
        if extra:
            out.update(extra)
        if as_json:
            print(_json.dumps(out, ensure_ascii=False))
        else:
            print(f"[next] {loop_id}:現在狀態 {phase},分級 {eff_tier},接下來第 {n_next} 輪,"
                  f"這輪要 {width} 人審,最多跑 {cap} 輪")
            if out.get("roster"):
                for s in out["roster"]["seats"]:
                    _fam = ("同門[" + out.get("orchestrator", "claude") + "]") if s['family'] == "claude" else ("外家(不是 " + out.get("orchestrator", "claude") + " 那一家)" if s['family'] == "external" else s['family'])
                    print(f"  應派: {s['slot']}(家族 {_fam},"
                          f"{'算' if s['occupies_w'] else '不算'}進人數,派工要求:{_REQUIREMENT_LABEL.get(s['requirement'], s['requirement'])})"
                          + (f" 備註:{s['note']}" if s.get("note") else ""))
            elif out.get("roster_note"):
                print(f"  應派: 目前算不出該派誰——{out['roster_note']}")
            # ★在審什麼★:排在席位之後、其他雜項之前——接手的人下一步就是去讀那份材料。
            if "reviewed_spec" in out:
                _rs = out["reviewed_spec"]
                _rd = f"第 {_rs['round']} 輪" if _rs.get("round") else "上一次"
                print(f"  帳上最後記到的審查材料({_rd}):{_rs['path']}"
                      + ("" if _rs["exists"] else "  ★這個檔案現在不在了★"))
                if not _rs.get("is_latest_round", True):
                    # ★不能說「用它判上一輪」★(代碼審 r1 外家否決席判 major):
                    # 最後一輪自己沒記材料時,這一筆是更早的輪次,拿它去判最後一輪是錯的輸入。
                    print(f"      ★但最後一輪自己沒記材料★——這一份是{_rd}的,不是最後一輪審的東西,"
                          "別拿它去判最後一輪")
                elif phase in ("plant-canary", "gate-pending"):
                    # ★只有「還會有下一輪」的狀態才講這句★(同席 major,實測:escalate 狀態下
                    # 會同時印「停掉這個編號」和「下一輪要自己凍一份新的」,兩句直接打架)。
                    print("      要判上一輪過不過關就用它;★下一輪要自己凍一份新的★,不是沿用這一份")
                else:
                    print("      這個編號沒有下一輪了(看下面的狀態說明),這一份留著當卷證")
            elif _sp_degraded:
                print(f"  帳上記了審查材料但讀不動({_sp_degraded})——不是「沒記」,是這本帳的那個欄位壞了")
            elif rounds:
                # ★沒有就明講,不要靜默省略★:省略的話接手的人分不出是「帳上沒記」
                # 還是「工具沒印」。spec_path 是後來才加的欄位,舊帳本來就沒有。
                print("  帳上沒記這個迴圈在審什麼(spec_path 是後來才加的欄位,舊帳沒有)")
            for k in ("canary_type", "record_cmd", "scope_cap", "cluster_hint", "note"):
                if k in out:
                    print(f"  {k}: {out[k]}")
            # 圖譜入口栓 A 文字段(spec EL-1/EL-16:專屬多行段,不塞五鍵白名單;三分支唯一化)
            try:
                if "related_nodes" in out:
                    _rn = out["related_nodes"]
                    if not _rn["queried"]:
                        _lt, _ = _el_query_tokens(_rn["query"])
                        if _lt:   # r1 正確性席 C-1:dref-v4 型「單字+版號」可查卻被閘掉——給出手動查詢的一行,不靜默丟失
                            print(f"  圖譜:編號主題訊號不足(清洗後只剩 {' '.join(_lt)}),沒自動查;要查自己跑:")
                            print(f"      lumos search \"{' '.join(_lt)}\"")
                        else:
                            print("  圖譜:編號無主題訊號,未查圖譜(帶 --spec <計劃筆記> 可用計劃檔名查)")
                    elif not _rn["nodes"]:
                        print(f"  圖譜:查過「{_rn['query']}」,圖譜這主題無既有節點")
                    else:
                        print(f"  圖譜既有節點(查:{_rn['query']}):")
                        for _nd in _rn["nodes"]:
                            print(f"    - {_nd['name']} [{_nd['status'] or '?'}] 決策 {_nd['decisions']} 條"
                                  + (" ★近名" if _nd["near_name"] else "")
                                  + (f" — {_nd['gist']}" if _nd.get("gist") else ""))
                        print("    先讀再開;近名者尤其要讀它的 decisions")
            except Exception:
                pass
        return 0 if phase == "converged" else 1

    # ⓪ escalate:light ratchet 永久態最先短路
    if light and any(r.get("kind") in ("caught", "none") and r.get("severity") in ("major", "blocker")
                     for r in rounds):
        return emit("escalate", {"note": "這個編號曾抓到 major 以上的問題,light 最寬鬆的規則從此失效——停掉這個編號,開新的(原編號加 -std)換嚴格規則接著審"})
    if not rounds:
        return emit("plant-canary")
    # ① gate-pending:判 converged 需 gate 結果,資訊不足絕不背書(先於 cap)
    if spec is None:
        # ★帳上有路徑就把指令補完★:接手的人最常卡在這一步——它說「少了 --spec」,
        # 但沒告訴你 spec 在哪。那個資訊就在帳上。
        # ★只有「最後一輪自己記了材料」才敢把指令補完★(代碼審 r1 外家否決席判 major):
        # 拿更早輪次的材料去判最後一輪是明確錯誤的輸入,不是保守退化。
        # ★型別要驗★(代碼審 r1 通才席附註:畸形帳(spec_path 是 list)會被直接塞進 f-string,
        # 印出 `--spec [1, 2, 3]` 這種不能執行的指令——不會炸,但「幫你補完指令」的承諾是空話)。
        _hint = rounds[-1].get("spec_path") if rounds else None
        if not isinstance(_hint, str) or not _hint.strip():
            _hint = None
        if _hint:
            # ★閘的模式與 repo 根都不准猜死★(同席 major):light 帳要 --light,
            # repo 根用 vault 往上找 .git 那支既有的,不是寫死 `.`(從子目錄呼叫就錯)。
            _mode = "--light" if light else "--disposal"
            try:
                _rr = str(Path(repo).resolve() if repo else _vault_repo_root(env))
            except Exception:
                _rr = "."
            import shlex as _shlex   # 代碼審 r3 資安 G1:補完的指令要能照抄,編號與路徑都加引號
            return emit("gate-pending", {"note": f"少了 --spec,沒辦法判斷過不過關。帳上記的材料是 {_hint},"
                                                 f"直接用:lumos loop status {_shlex.quote(loop_id)} {_mode} --spec {_shlex.quote(_hint)} --repo {_shlex.quote(_rr)}"
                                                 f"(2026-08-25 以前定錨的舊 panel 帳要改用 --gate --panel)"})
        _older = next((r["spec_path"] for r in reversed(rounds)
                       if isinstance(r.get("spec_path"), str) and r["spec_path"].strip()), None)
        if _older:
            return emit("gate-pending", {"note": "少了 --spec,沒辦法判斷過不過關。"
                                                 f"★最後一輪沒記材料★(更早的輪次記過 {_older},但那不是這一輪審的東西),"
                                                 "所以指令補不完——要自己找出這一輪的材料再帶 --spec"})
        return emit("gate-pending", {"note": "少了 --spec,沒辦法判斷過不過關——用 lumos loop status <編號> --gate 帶完整參數自己判"
                                             "(帳上也沒記這個迴圈在審什麼,要自己找)"})
    # ② full-basis gate 委派(靜默跑既有謂詞,零新判定邏輯)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
        rc = cmd_loop_status(env, loop_id, need=(1 if light else need), gate=True,
                             spec=spec, repo=repo, panel=(panel_fmt and not light),
                             light=light, min_seats=width)   # 恆傳(light/legacy=1;code-loop r1 折入)
    if rc == 2:
        sys.stderr.write(buf.getvalue())
        return 2
    if rc == 0:
        _loop_gov_mark(env, loop_id, "converged", "loop next 判四關全過")
        return emit("converged", {"gate_basis": "四關全過(連續乾淨輪數、引用對得上、問題數遞減、文件沒被改過)"})
    # ③ cap(資訊充分且未 PASS)
    if rounds_count >= cap:
        _loop_gov_mark(env, loop_id, "cap-reached", f"cap={cap} tier={eff_tier}")
        return emit("cap-reached", {"note": f"跑滿 {cap} 輪還沒收斂——停下來,剩下的交給人裁決,別無限燒下去"})
    # ④ plant-canary
    return emit("plant-canary")


# ───────────── guard: 合約守衛 scaffold(對談驅動)─────────────
# lumos 只做機械活:① 列出 ★INVARIANT★ 綁定狀態 ② 套範本產 stub(預設紅燈) ③ 把 [test:] 綁回 KEY 行(自驗)。
# 「斷言本體」由 Claude 經對談向人確認意圖後填 — claim 的真來自人確認,不來自 code 反推
# (反推=套套邏輯=Check T 在打的偽證據)。範本是技術棧專屬、放專案 .lumos/guard-templates/<type>.tmpl,
# lumos 本體維持語言無關。
GUARD_TYPES = ("pure", "behavioral", "state")
GUARD_ICON = {"real": "✅ 已綁真方法", "dangling": "❌ 懸空(找不到方法)",
              "fake": "⚠ 偽證據(非測試方法)", "naked": "❌ 裸合約(未綁)"}


def _repo_root_from_env(env):
    for p in env.vault.parents:
        if p.name == "docs":
            return p.parent
    return env.vault.parent  # standalone vault root


def _platform_test_index(repo_root):
    """依 .lumos/config 建「平台 → (method set, code haystack)」的惰性索引 + 解析參數。
    多平台 discover 呼叫點(Check T / classify_invariants / cmd_archive)共用,避免各自重寫平台迴圈。
    回 (pdata, split, default, methods_for, hay_for, loose_for)——★六個值★
    (2026-09-22 代碼審 r2 架構席:說明本來就跟實際回傳值對不上,這次一併訂正):
    - split = multiplatform 時的 platforms dict、legacy 時 {}(→ resolve_test_refs 不切分);
    - default = default_platform;
    - methods_for(plat)/hay_for(plat) = 惰性(一次 CLI 內快取)取該平台 root+profile 的測試方法集/haystack
      (haystack 也跨 repo,修 r4:fake vs dangling 訊息品質)。"""
    pdata = load_platforms(repo_root)
    split = pdata["platforms"] if pdata["multiplatform"] else {}

