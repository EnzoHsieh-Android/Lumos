  9978	def _roster_observe(env, loop_id, rounds, repo, only_rid=None, anomalies_only=False):
  9979	    """loop status --roster 觀測段(advisory 恆不影響 rc):應派(_TIER_ROSTER)vs 實派(dispatch 快照)
  9980	    逐輪分桶對帳。落點=cmd_loop_status 入口、各模式分支 early-return 之前(四模式皆吃得到)。
  9981	    roster對帳併入問閘 [S1]:only_rid=只對這一輪(同時抑制內部 dispatch glob 補漏——問閘尾端用);
  9982	    anomalies_only=只印異常六種(external_missing/單家族/真兼任/命名歧義/unknown 降級/shortfall),
  9983	    抑制摘要與診斷四種;回傳本次印出的異常種類清單(留痕用)。同一實作服務兩種呼叫,禁抄改。"""
  9984	    anomalies = []
  9985	    def _quiet(msg):
  9986	        if not anomalies_only:
  9987	            print(msg)
  9988	    kind = _roster_kind(loop_id)
  9989	    if kind is None:
  9990	        _quiet(f"[roster] {loop_id}:看不出是設計審還是代碼審(名稱 code 開頭但不是 code- 格式),跳過派工對帳")
  9991	        return anomalies
  9992	    # only_rid(問閘單輪)時 tier 取「該輪自己」的紀錄——跨輪 tier 不同時拿第一筆會查錯編制表,
  9993	    # high 輪的 fail-closed 警訊被降級成 standard 的軟提醒(code-batch2 s1-f1,席位純 CLI 重現)
  9994	    # only_rid(問閘單輪):tier 只認判定輪自己的紀錄,★不 fallback 借別輪的★——
  9995	    # 借用=同型病換觸發條件(r2 d-f1);判定輪沒記 tier → 走「沒有編制表可以對」照實講。
  9996	    # 副作用即縱深:__seqN 合成鍵永遠對不到 round 欄 → tier=None → 天然安靜,
  9997	    # 下方 startswith("__") guard 成為第二道防禦(單釘無法只殺 guard,兩道要一起拔才會響)。
  9998	    if only_rid:
  9999	        tier = next((r.get("tier") for r in rounds
 10000	                     if r.get("round") == only_rid and r.get("tier")), None)
 10001	    else:
 10002	        tier = next((r.get("tier") for r in rounds if r.get("tier")), None)
 10003	    orch = _loop_orchestrator(rounds)
 10004	    _quiet(f"[roster] {loop_id}:類型 {kind}(從名稱前綴推的),分級 {tier or '沒指定'},編排者 {orch or '帳面沒記,視為 claude'}"
 10005	           + ("" if orch else "(舊帳相容;新迴圈 loop next 首輪要帶 --orchestrator)"))
 10006	    _orchs = _loop_orchestrators(rounds)
 10007	    if len(_orchs) > 1:
 10008	        print(f"[roster] {loop_id}:帳面編排者不一致({'/'.join(sorted(_orchs))})——以下家族對帳照第一筆算,但這本帳本身矛盾,先修帳再信對帳結果")
 10009	        anomalies.append("編排者不一致")
 10010	    orch = orch or "claude"
 10011	    if tier is None:
 10012	        _quiet("[roster] 這個編號沒指定過分級(舊格式或還沒記錄),沒有編制表可以對")
 10013	        return anomalies
 10014	    entry = _TIER_ROSTER.get((kind, tier))
 10015	    if entry is None:
 10016	        _quiet(f"[roster] 無編制宣告:{kind}/{tier} 這個組合沒定義該派誰,跳過對帳")
 10017	        return anomalies
 10018	    root = Path(repo).resolve() if repo else _vault_repo_root(env)
 10019	    loop_dir = root / "governance" / "review-reports" / loop_id
 10020	    if only_rid is not None:
 10021	        rids = [only_rid]   # 問閘當輪:不掃 log、不 glob 補漏(std-r1 s1-f1)
 10022	    else:
 10023	        rids = []
 10024	        for r in rounds:
 10025	            rid = r.get("round")
 10026	            if rid and rid not in rids:
 10027	                rids.append(rid)
 10028	        if loop_dir.is_dir():
 10029	            import re as _re
 10030	            for f in sorted(loop_dir.glob("*-dispatch*.json")):
 10031	                m = _re.match(r"^(r\d+)-dispatch", f.name)
 10032	                if m and m.group(1) not in rids:
 10033	                    rids.append(m.group(1))
 10034	    if not rids:
 10035	        _quiet("[roster] 沒有輪次記錄也沒有派工快照,沒東西可對")
 10036	        return anomalies
 10037	    seats = entry["seats"]
 10038	    req_c = [s for s in seats if s["requirement"] in ("required", "required-fail-closed") and s["family"] == "claude"]
 10039	    req_e = [s for s in seats if s["requirement"] in ("required", "required-fail-closed") and s["family"] == "external"]
 10040	    nia = [s for s in seats if s["requirement"] == "note-if-absent"]
 10041	    _hinted = set()   # 席名提示每個名字只印一次(多輪帳面別洗版;code-codex-s2 r1 單reviewer F6)
 10042	    for rid in rids:
 10043	        auditors, _skipped = _roster_dispatch_entries(loop_dir, rid) if loop_dir.is_dir() else ([], 0)
 10044	        if not auditors:
 10045	            _quiet(f"[roster] {rid}:沒有派工快照可對(舊記錄或還沒寫入)")
 10046	            continue
 10047	        fams = [(a, *_roster_family(a, orch)) for a in auditors]
