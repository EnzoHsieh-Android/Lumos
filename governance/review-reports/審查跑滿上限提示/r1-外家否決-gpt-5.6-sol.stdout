  9896	def _loop_records(env, loop_id, strict=False):
  9897	    """canary-log 裡某編號的全部記錄(唯讀;壞行跳過)。單一讀法——cmd_loop_next 與 record 定錨檢查共用
  9898	    (code-codex-s2 r1 架構席:兩份逐行相同的讀帳迴圈會各自漂)。strict=True 時檔讀不到就丟 OSError 給呼叫端印。"""
  9899	    import json as _json
  9900	    path = env.vault.parent / ".canary-log.jsonl"
  9901	    out = []
  9902	    try:
  9903	        if path.exists():
  9904	            for line in path.read_text(encoding="utf-8").splitlines():
  9905	                line = line.strip()
  9906	                if not line:
  9907	                    continue
  9908	                try:
  9909	                    d = _json.loads(line)
  9910	                except ValueError:
  9911	                    continue
  9912	                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16)
  9913	                    out.append(d)
  9914	    except OSError:
  9915	        if strict:
  9916	            raise
  9917	        return out
  9918	    return out
