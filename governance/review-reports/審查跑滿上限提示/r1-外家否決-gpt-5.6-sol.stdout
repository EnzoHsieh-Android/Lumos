  9932	def _roster_family(auditor, orchestrator="claude"):
  9933	    """auditor 字串→(family, dual_hit)。family 是★相對編排者★的:"claude"=同門(編排者那一家)、"external"=外家
  9934	    (保留舊字串,_TIER_ROSTER 的 family 欄同義:claude 席=同門席、external 席=外家席;d4 相對化 2026-09-04)。
  9935	    lower() 子串比對;判序寫死外家先比、先命中先贏。orchestrator=codex 時 codex/gpt 是同門、sonnet/opus/claude 是外家。"""
  9936	    s = (auditor or "").lower()
  9937	    if orchestrator == "codex":
  9938	        own = any(k in s for k in _ROSTER_CODEX_KEYS)
  9939	        other = any(k in s for k in _ROSTER_CLAUDE_KEYS) or any(k in s for k in _ROSTER_EXTERNAL_KEYS if k not in _ROSTER_CODEX_KEYS)
  9940	    else:
  9941	        own = any(k in s for k in _ROSTER_CLAUDE_KEYS)
  9942	        other = any(k in s for k in _ROSTER_EXTERNAL_KEYS)
  9943	    if other:
  9944	        return ("external", own)
  9945	    if own:
  9946	        return ("claude", False)
  9947	    return ("unknown", False)
