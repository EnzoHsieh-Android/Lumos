  9921	def _loop_orchestrators(rounds):
  9922	    """帳面出現過的編排者值集合(矛盾偵測用)。"""
  9923	    return {r.get("orchestrator") for r in rounds if r.get("orchestrator") in LOOP_ORCHESTRATORS}
