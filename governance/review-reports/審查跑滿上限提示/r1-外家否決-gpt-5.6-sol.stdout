   562	def _replay_git_blob(root, relpath):
   563	    """--freeze 前置:檔案已 commit 且與 HEAD 一致才記 blob id(r3 delta d-f2:hash-object 不落
   564	    物件、-w 落懸空 blob 兩週可被 GC——取 HEAD 的 blob 保證被 tree 引用)。回 (blob_id, err)。"""
   565	    import subprocess as _sp
   566	    head = _sp.run(["git", "-C", str(root), "rev-parse", f"HEAD:{relpath}"],
   567	                   capture_output=True, text=True, errors="replace")
   568	    if head.returncode != 0:
   569	        return None, f"{relpath} 還沒 commit 進版控"
   570	    work = _sp.run(["git", "-C", str(root), "hash-object", str(Path(root) / relpath)],
   571	                   capture_output=True, text=True, errors="replace")
   572	    if work.returncode != 0:
   573	        return None, f"{relpath} 讀不到({work.stderr.strip()[:80]})"
   574	    if head.stdout.strip() != work.stdout.strip():
   575	        return None, f"{relpath} 工作樹內容與 HEAD 不一致(先 commit 卷證再凍)"
