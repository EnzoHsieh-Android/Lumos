  7364	def _review_yield_round(rows):
  7365	    """[審查有沒有用記帳 S3] 一輪帳列 → 漏斗數字 dict(N 報/M 存活/R 重現不到/F 折/A 放行/S 存活多於席位報)。
  7366	    N=席位列 reported 加總,★同席同報告只算一次★(同一席會先留痕一筆、再當載體一筆;以 (auditor, report_sha256) 去重);
  7367	    任一欄缺(2026-09-09 前的帳沒這些鍵)→ 該格 None(印 ?),N/M/R 任一 None 就不算 S。純函式,disposal 尾與 gov --stats 共用。"""
  7368	    seen, N, n_missing = set(), 0, False
  7369	    for r in rows:
  7370	        key = (r.get("auditor"), r.get("report_sha256"))
  7371	        if key in seen:
  7372	            continue
  7373	        seen.add(key)
  7374	        if r.get("reported") is None:
  7375	            n_missing = True
  7376	        else:
  7377	            N += int(r["reported"])
  7378	    carrier = next((r for r in rows if r.get("findings_set")), None)
  7379	    M = len(carrier["findings_set"]) if carrier else None
  7380	    R = len(carrier["refuted_set"]) if carrier and carrier.get("refuted_set") is not None else None
  7381	    F = len(carrier.get("folded_set") or []) if carrier else None
  7382	    A = len(carrier.get("accepted_set") or []) if carrier else None
  7383	    N = None if n_missing or not seen else N
  7384	    S = None if (N is None or M is None or R is None) else max(0, M + R - N)
  7385	    return {"N": N, "M": M, "R": R, "F": F, "A": A, "S": S, "has_carrier": carrier is not None}
