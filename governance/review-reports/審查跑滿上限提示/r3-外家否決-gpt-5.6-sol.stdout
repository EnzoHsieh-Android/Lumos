/bin/zsh -lc "sed -n '24920,25045p' scripts/test_lumos.py | nl -ba -v24920; sed -n '46340,46410p' scripts/test_lumos.py | nl -ba -v46340" in /Users/enzo/harness/lumos-toolchain
 succeeded in 0ms:
