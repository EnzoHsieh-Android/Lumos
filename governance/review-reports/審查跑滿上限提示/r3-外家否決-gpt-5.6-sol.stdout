 40136	def t_disposal_security_seat_names_and_patch_parse():
 40137	    """[代碼審資安席 S2]席名任一段完全等於 資安/security 才算;凍結 patch 檔名解析處理 git 對中文檔名的引號跳脫。"""
 40138	    m = _load_lumos_inproc()
 40139	    for name, want in [("資安", True), ("資安-sonnet", True), ("資安-gpt-5.6-terra", True),
 40140	                       ("s4-資安-sonnet", True), ("Security-codex", True), ("SECURITY", True),
 40141	                       ("資安審-sonnet", False), ("非資安-sonnet", False), ("sonnet", False), ("", False)]:
 40142	        check(f"席名判法:{name!r} → {'算' if want else '不算'}", m._auditor_matches_slot(name, "資安") is want, name)
 40143	    quoted = ('diff --git "a/docs/\\344\\270\\255.md" "b/docs/\\344\\270\\255.md"\n'
 40144	              '--- "a/docs/\\344\\270\\255.md"\n+++ "b/docs/\\344\\270\\255.md"\n@@ -1 +1 @@\n-甲\n+乙\n')
 40145	    plain = 'diff --git a/docs/中.md b/docs/中.md\n--- a/docs/中.md\n+++ b/docs/中.md\n@@ -1 +1 @@\n-甲\n+乙\n'
 40146	    check("patch 解析:git 預設(加引號八進位跳脫)與不跳脫的同一支中文檔 → 同一個檔名",
 40147	          m._patch_files_from_text(quoted) == m._patch_files_from_text(plain) == {"docs/中.md"},
 40148	          f"{m._patch_files_from_text(quoted)} vs {m._patch_files_from_text(plain)}")
 40149	    renamed = "diff --git a/old.py b/new.py\nsimilarity index 100%\nrename from old.py\nrename to new.py\n"
 40150	    check("patch 解析:純改名取新名", m._patch_files_from_text(renamed) == {"new.py"}, str(m._patch_files_from_text(renamed)))
 40151	    deleted = "diff --git a/gone.py b/gone.py\ndeleted file mode 100644\n--- a/gone.py\n+++ /dev/null\n@@ -1 +0,0 @@\n-x\n"
 40152	    check("patch 解析:刪檔取原名", m._patch_files_from_text(deleted) == {"gone.py"}, str(m._patch_files_from_text(deleted)))
 40153	
