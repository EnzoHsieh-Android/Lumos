 24935	    nx = run(v, "loop", "next", f"sc3-{_M1U}", "--tier", "standard", "--orchestrator", "claude")
 24936	    check("★loop next 的記帳模板必須帶上它(不然沒人會用)★",
 24937	          "--scope-lines" in nx.stdout, nx.stdout[-300:])
