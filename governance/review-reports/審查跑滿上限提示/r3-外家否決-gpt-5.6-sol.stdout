 33308	def t_dref_promote_empty_key_cleanup():
 33309	    """[arch-f5] promote 掉節點唯一一條 _ai 不留裸 decision_refs_ai: 鍵(YAML null 比沒鍵更糟)。
 33310	    翻紅釘:拔 promote _ai 清空鍵邏輯 這條紅。"""
 33311	    v, tgt, src = _mk_dref_vault()
 33312	    run(v, "decision-refs", "add-ai", "Verification/V", "Systems/Target.md#d1", expect_rc=0)
