 30600	                _msg = message or ""
 30601	                _req = re.search(r"the following arguments are required: (.+)", _msg)
 30602	                _int = re.search(r"argument ([^:]+): invalid int value: '([^']*)'", _msg)
 30603	                _unk = re.search(r"unrecognized arguments: (.+)", _msg)
 30604	                if _req:
 30605	                    print(f"擋下:少了必須要給的 {_req.group(1)}。", file=sys.stderr)
 30606	                elif _int:
 30607	                    print(f"擋下:{_int.group(1)} 要給整數,收到的是「{_int.group(2)}」。",
 30608	                          file=sys.stderr)
 30609	                elif _unk:
 30610	                    print(f"擋下:不認得這幾個參數:{_unk.group(1)}。", file=sys.stderr)
