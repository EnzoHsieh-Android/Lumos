  8017	def _jsonl_append_verified(path, rec, key_field, key_value):
  8018	    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
  8019	    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
  8020	    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
  8021	    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
  8022	    import json
  8023	    try:
  8024	        with open(path, "a", encoding="utf-8") as f:
  8025	            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
  8026	    except OSError as e:
  8027	        print(f"擋下:寫不進記錄檔({e}):\n    {path}", file=sys.stderr)
  8028	        return 2
  8029	    try:
  8030	        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
  8031	            for line in f:
  8032	                if not line.strip():
  8033	                    continue
  8034	                try:
  8035	                    d = json.loads(line)
  8036	                except ValueError:
  8037	                    continue
  8038	                if isinstance(d, dict) and d.get(key_field) == key_value:
  8039	                    return 0
  8040	    except (OSError, ValueError) as e:
  8041	        print(f"canary record: 落盤自驗失敗——寫完讀回來檢查時讀不到({e}),這筆不算記成功:\n    {path.resolve()}", file=sys.stderr)
  8042	        return 2
  8043	    print(f"canary record: 落盤自驗失敗——系統說寫成功了,但讀回來找不到這一筆,這筆不算記成功:\n    {path.resolve()}",
  8044	          file=sys.stderr)
  8045	    return 2

