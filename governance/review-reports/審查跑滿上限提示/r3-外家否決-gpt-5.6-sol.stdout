 33297	def t_dref_crlf_and_error_protocol():
 33298	    """code-dref s1-f1 迴歸:CRLF 目標節點候選不消失(讀記憶體 fm_lines,不用嚴格 edit-path 讀檔)。"""
 33299	    v, tgt, src = _mk_dref_vault()
 33300	    txt = read(tgt)
 33301	    tgt.write_bytes(txt.replace("\n", "\r\n").encode("utf-8"))
 33302	    r = run(v, "decision-refs", "candidates", "Verification/V")
 33303	    check("s1-f1:CRLF 目標節點候選不靜默消失", "#d1" in r.stdout, r.stdout[:300])
 33304	    r = run(v, "decision-refs", "add-ai", "Verification/V", "Systems/Target.md#d1")
 33305	    check("s1-f1:CRLF 節點合法決策不被誤判 dangling", r.returncode == 0, r.stderr[:200])
