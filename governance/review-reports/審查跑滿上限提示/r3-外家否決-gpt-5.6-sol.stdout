 40118	          r.returncode == 1 and _sec_after(r.stdout).startswith(": ✗") and "留痕: ✓" in r.stdout, r.stdout[-700:])
 40119	    # ⑥ 定錨分級 standard(後面有一筆記成 high)→ 不要求
 40120	    lid = f"code-sec-e-{_M1U}"
 40121	    sp = _sec_loop(v, lid, [("r1", ["app/login.py"], ["單reviewer-sonnet"], "單reviewer-sonnet"),
 40122	                            ("r2", ["app/login.py"], ["單reviewer-sonnet"], "單reviewer-sonnet")],
