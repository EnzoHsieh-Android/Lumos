 24822	def t_need_src_guards_cannot_silently_disable_coverage():
 24823	    """★守衛的失敗模式是「放行」,所以它自己壞掉時必須大聲★(2026-08-02)
 24824	
 24825	    `_need_src(...)` 讓「來源 repo 專用」的測試在消費端專案乾淨 skip 而非假紅
 24826	    （實測 Landmark:vendored 套件更新後 91 紅,全是來源專用產物缺席；本機制後
 24827	    降為 0 紅 / 61 skip）。但它有一個致命的失敗模式：★如果來源 repo 自己少了
 24828	    某個產物，這些測試會在來源端也靜默 skip，覆蓋率無聲蒸發★——而 skip 不會
 24829	    讓任何閘翻紅。
 24830	
 24831	    這正是昨天那條教訓的同型：**失敗模式是放行的守衛，壞掉時不會有人知道**。
 24832	
 24833	    ★驗行為★：直接掃本檔案裡所有 `_need_src("...")` 的實際呼叫參數，逐一斷言
 24834	    那個路徑在來源 repo 真的存在。★自我維護★——之後任何人新增一處 `_need_src`，
 24835	    這條測試自動涵蓋它，不需要維護第二份清單。
 24836	
 24837	    ★此測試自己也必須在來源 repo 跑得到★（不加 `_need_src` 守門，否則它會在
 24838	    消費端 skip 掉，而那正是它該沉默的地方——消費端本來就缺那些產物）。"""
 24839	    import re as _re9
 24840	    repo = Path(GRAPHCTL).resolve().parent.parent
 24841	    src = Path(__file__).resolve().read_text(encoding="utf-8")
 24842	    # ★只認「獨立成行的呼叫」★——不然 docstring 裡提到的 `_need_src(...)` 也會被掃進來
 24843	    # (第一版就踩到,掃出一個叫 '...' 的假路徑)。
 24844	    rels = sorted(set(_re9.findall(r'^\s*_need_src\(\s*"([^"]+)"', src, _re9.M)))
 24845	    check("★前置★ 掃得到 _need_src 的呼叫參數(掃不到=這條測試自己失效了)",
 24846	          len(rels) >= 5, f"只掃到 {rels}")
 24847	    if not (repo / "skills" / "lumos-project-notes").is_dir():
 24848	        # 消費端:那些產物本來就沒有,此測試無意義(且下面的斷言必假)
 24849	        raise _SrcOnly("需要來源 repo(本測試只在來源端有意義)")
 24850	    missing = [r for r in rels if not (repo / r).exists()]
 24851	    check("★來源 repo 必須擁有每一個被守門的產物★"
 24852	          "(缺了 → 對應測試會在來源端也靜默 skip、覆蓋無聲蒸發)",
 24853	          not missing, f"缺: {missing}")
 24854	
 24855	
 24856	def t_canary_scope_lines_records_review_size():
 24857	    """★把缺的變數記下來★(2026-08-02):canary 抓到只證審查員醒著,但外部實測指出
 24858	    ★東西越多越抓不到★是最主導的因素(arXiv 2606.15689:抓得到合成缺陷不可靠地
 24859	    預測抓得到真實缺陷,且 diff 大小是主導混淆變數)。本專案十輪 code-loop 的 diff
 24860	    從 332 到 2770 行——★在帳上長得一模一樣★,等於無法回答「小 diff 上的 caught
 24861	    是不是灌水」。
 24862	
 24863	    這一欄★不進任何 gate、不改任何判定★,純 telemetry;目的只有一個:讓
 24864	    「caught 率 vs 被審規模」這個問題日後答得出來。
 24865	
 24866	    ★驗行為★:①給了就要真的寫進帳本(不是只收下不存)②不給時★整個鍵不存在★
 24867	    (同 --findings 慣例,不寫 null 汙染舊帳)③負數擋下 rc2 ④★不影響 gate★——
 24868	    帶不帶這欄,loop status 的判定必須完全一樣。"""
 24869	    import json as _j
 24870	    v = mkvault()
 24871	    spec = v / "Projects" / "scopespec.md"
 24872	    spec.write_text("scope spec\n", encoding="utf-8")
 24873	    h = _sha256_of(spec)
 24874	    log = v.parent / ".canary-log.jsonl"
 24875	    lid = f"sc-{_M1U}"
 24876	
 24877	    run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid, "--severity", "clean", "--findings", "0",
 24878	        "--auditor", "s1", "--reviewed", h, "--spec", str(spec), "--scope-lines", "2770", expect_rc=0)
 24879	    rows = [_j.loads(l) for l in log.read_text(encoding="utf-8").splitlines() if l.strip()]
 24880	    mine = [r for r in rows if r.get("loop") == lid]
 24881	    check("★給了就要真的寫進帳本★", mine and mine[-1].get("scope_lines") == 2770,
 24882	          str(mine[-1] if mine else None)[:200])
 24883	
 24884	    run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid, "--severity", "clean", "--findings", "0",
 24885	        "--auditor", "s2", "--reviewed", h, "--spec", str(spec), expect_rc=0)
 24886	    rows = [_j.loads(l) for l in log.read_text(encoding="utf-8").splitlines() if l.strip()]
 24887	    mine = [r for r in rows if r.get("loop") == lid]
 24888	    check("★不給時整個鍵不存在(不寫 null 汙染舊帳)★", "scope_lines" not in mine[-1],
 24889	          str(mine[-1])[:200])
 24890	
 24891	    r = run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid, "--severity", "clean", "--findings", "0",
 24892	            "--auditor", "s3", "--reviewed", h, "--spec", str(spec), "--scope-lines", "-1")
 24893	    check("★負數擋下 rc2★", r.returncode == 2, r.stderr[-150:])
 24894	
 24895	    # ★不影響 gate★:帶與不帶這欄,收斂判定必須一樣
 24896	    g = run(v, "loop", "status", lid, "--need", "2", "--gate", "--spec", str(spec),
 24897	            "--repo", str(v.parent))
 24898	    lid2 = f"sc2-{_M1U}"
 24899	    for a in ("t1", "t2"):
 24900	        run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid2, "--severity", "clean", "--findings", "0",
 24901	            "--auditor", a, "--reviewed", h, "--spec", str(spec), expect_rc=0)
 24902	    g2 = run(v, "loop", "status", lid2, "--need", "2", "--gate", "--spec", str(spec),
 24903	             "--repo", str(v.parent))
 24904	    check("★純 telemetry:帶了 scope-lines 的 loop 與沒帶的,gate 判定一致★",
 24905	          g.returncode == g2.returncode, f"帶={g.returncode} 沒帶={g2.returncode}")
 24906	
 24907	    # ── 軟上限:超標要在帳上留記號並喊出來 ──
 24908	    lid3 = f"sc4-{_M1U}"
 24909	    ro = run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid3, "--severity", "clean", "--findings", "0",
 24910	             "--auditor", "big", "--reviewed", h, "--spec", str(spec), "--scope-lines", "2778", expect_rc=0)
 24911	    rows = [_j.loads(l) for l in log.read_text(encoding="utf-8").splitlines() if l.strip()]
 24912	    big = [r for r in rows if r.get("loop") == lid3][-1]
 24913	    check("★超過軟上限要在帳上標 scope_oversize★(caught 是弱證據,事後查得到)",
 24914	          big.get("scope_oversize") is True, str(big)[:200])
 24915	    check("★而且要當場喊出來★(只記不喊等於沒人知道)",
 24916	          "scope_oversize" in ro.stderr or "軟上限" in ro.stderr, ro.stderr[-200:])
 24917	    check("★仍然照常留痕 rc0★(軟上限不擋——輪已經跑完,擋也來不及)",
 24918	          ro.returncode == 0, ro.stderr[-150:])
 24919	
 24920	    # ★反誤傷★:沒超標不得標記、不得喊
 24921	    lid4 = f"sc5-{_M1U}"
 24922	    rs = run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid4, "--severity", "clean", "--findings", "0",
 24923	             "--auditor", "small", "--reviewed", h, "--spec", str(spec), "--scope-lines", "415", expect_rc=0)
 24924	    rows = [_j.loads(l) for l in log.read_text(encoding="utf-8").splitlines() if l.strip()]
 24925	    small = [r for r in rows if r.get("loop") == lid4][-1]
 24926	    check("★沒超標不得標記(反誤傷)★", "scope_oversize" not in small, str(small)[:200])
 24927	    check("★沒超標不得喊(反噪音)★", "軟上限" not in rs.stderr, rs.stderr[-150:])
 24928	
 24929	    # ★預防端★:警告要在派工之前出現,不是記帳之後才喊
 24930	    nx0 = run(v, "loop", "next", f"sc6-{_M1U}", "--tier", "standard", "--orchestrator", "claude")
 24931	    check("★loop next 必須在派工前就給量尺★(記帳時才喊已經來不及,輪跑完了)",
 24932	          "scope_cap" in nx0.stdout and "wc -l" in nx0.stdout, nx0.stdout[-300:])
 24933	
 24934	    # loop next 的模板要提到它(否則沒人知道有這欄——cluster 帳 316:1 的教訓)
 24935	    nx = run(v, "loop", "next", f"sc3-{_M1U}", "--tier", "standard", "--orchestrator", "claude")
 24936	    check("★loop next 的記帳模板必須帶上它(不然沒人會用)★",
 24937	          "--scope-lines" in nx.stdout, nx.stdout[-300:])
 24938	
