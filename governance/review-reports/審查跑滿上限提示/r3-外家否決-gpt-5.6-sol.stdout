 23899	def t_quote_check_normalization_and_verdict():
 23900	    """[T2 錨定檢查](spec:Projects/design-loop重設計 三;plan:同名_實作計畫 T2)
 23901	
 23902	    `lumos quote-check <報告> --spec <凍結快照>`:報告內每條「引句：「…」」
 23903	    norm 後必須是快照 norm 後的子字串。rc0=全 ok、rc1=有 miss、rc2=IO/零引句。
 23904	
 23905	    ★正規化是本命令的全部價值★:r1 實戰就有一條真引句因原文帶粗體記號被誤判
 23906	    錨不到(審 design-loop重設計 時 s3 引「正確性歸下游」,原文是「**正確性歸下游**」)。
 23907	    _quote_norm=NFC→剝 */`→空白(含全形)摺疊單空格。
 23908	
 23909	    ★單一實作鐵則★:抽取與比對共用一份 _quote_norm(2026-08-02 教訓:預檢與主迴圈
 23910	    兩份實作當場漂移)——機械代理=全檔 `def _quote_norm` 恰一處。
 23911	    翻紅釘:把剝記號步驟還原掉 → 粗體案例翻紅。"""
 23912	    import json as _j
 23913	    v = mkvault()
 23914	    snap = v / "Projects" / "qsnap.md"
 23915	    snap.write_text(
 23916	        "# spec\n**正確性歸下游**：TDD 落地（測試是真 oracle）\n"
 23917	        "閘只留可重算的；其餘降級成 `強制留痕` 的觀測，\n分兩行寫的一句話。\n",
 23918	        encoding="utf-8")
 23919	    rpt = v / "Projects" / "qrpt.md"
 23920	    rpt.write_text(
 23921	        "[major] 甲\n引句：「正確性歸下游：TDD 落地（測試是真 oracle）」\n"      # 粗體剝除後可對上
 23922	        "[minor] 乙\n引句：「閘只留可重算的；其餘降級成 強制留痕 的觀測， 分兩行寫的一句話。」\n",  # 反引號+跨行
 23923	        encoding="utf-8")
 23924	    r = run(v, "quote-check", str(rpt), "--spec", str(snap))
 23925	    check("★粗體/反引號/跨行三種正規化後全 ok(rc0)★", r.returncode == 0,
 24720	    check("★前置★ 現場成立:六欄全落帳", last.get("findings_set") == ["a", "b", "c"]
 24721	          and last.get("folded_set") == ["a", "b"] and last.get("accepted_set") == ["c"]
 24722	          and last.get("accept_reasons", {}).get("c") and last.get("report_sha256")
 24723	          and last.get("snapshot_sha256"), str(last)[:300])
 24724	    check("sha256 可重算(留痕的最低資格)", last["report_sha256"] == _sha256_of(rpt), "")
 24725	
 24726	    # 機械核對逐條 rc2
 24727	    bad = [
 24728	        # ★b 的理由給齊,讓「缺 b 未處置」成為唯一能 rc2 的路——否則聯集檢查被拔掉時
 24729	        # 理由檢查會代打,翻紅釘假紅(2026-08-04 第一版就中了這型:斷言測的不是它宣稱的那條)
 24730	        (["--findings-set", "a,b,c", "--refuted-set", "none", "--folded-set", "a", "--accepted-set", "c",
 24731	          "--accept-reason", "c=有理由"],
 24732	         "★缺 b 未處置(聯集≠全集)必 rc2★"),
 24733	        (["--findings-set", "a,b", "--refuted-set", "none", "--folded-set", "a,b", "--accepted-set", "b"],
 24734	         "folded∩accepted 非空必 rc2"),
 24735	        (["--findings-set", "a", "--refuted-set", "none", "--folded-set", "a", "--accepted-set", "",
 24736	          "--accept-reason", "x=y"], "理由鍵集合≠accepted_set 必 rc2"),
 24737	        (["--findings-set", "a,a", "--refuted-set", "none", "--folded-set", "a,a"], "findings_set 重複 id 必 rc2"),
 24738	    ]
 24739	    for extra, name in bad:
 24740	        rr = run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid, "--round", "r1", "--severity", "minor",
 24741	                 "--auditor", "s1", *extra)
 24742	        check(name, rr.returncode == 2, f"rc={rr.returncode} {rr.stderr[:120]}")
 24743	    # accepted 有 id 但沒給理由
 24744	    rr = run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid, "--round", "r1", "--severity", "minor",
 24745	             "--auditor", "s1", "--findings-set", "a,b", "--refuted-set", "none", "--folded-set", "a", "--accepted-set", "b")
 24746	    check("accepted 無理由必 rc2(空殼放行擋在寫側)", rr.returncode == 2, rr.stderr[:120])
 24747	    # d1:blocker 不得 accepted
 24748	    rr = run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", lid, "--round", "r1", "--severity", "blocker",
 24749	             "--auditor", "s1", "--findings-set", "a", "--refuted-set", "none", "--folded-set", "", "--accepted-set", "a",
 24750	             "--accept-reason", "a=想放行")
 24751	    check("★d1:blocker 輪 accepted 非空必 rc2★", rr.returncode == 2, rr.stderr[:120])
 24752	    # 留痕檔不存在
 24753	    rr = run(v, "canary", "record", "caught", "--loop", lid, "--severity", "minor",
 24754	             "--auditor", "s1", "--report", str(v / "nope.md"))
 24755	    check("--report 指向不存在檔必 rc2", rr.returncode == 2, rr.stderr[:120])
 24756	    # blocker+全折(accepted 空)合法——d1 只擋 accepted,不擋折
 24757	    # (T6 生效後:本 loop 已定錨,須帶留痕——正確行為,非誤傷)
 24758	    run(v, "canary", "record", "caught", "--loop", lid, "--round", "r1", "--severity", "blocker",
 24759	        "--auditor", "s1", "--findings-set", "a", "--refuted-set", "none", "--folded-set", "a",
 24760	        "--report", str(rpt), "--snapshot", str(snap), expect_rc=0)
 24761	
