  8197	def _panel_retired_for(rounds):
  8198	    """[probe輪退場 d1/甲裁 2026-08-25] panel 閘退役判定:loop 首筆 ts 日期 ≥ cutoff(預設
  8199	    2026-08-26)=新迴圈,panel 閘拒判並指路處置閘;舊迴圈(cutoff 前定錨)照常回放。
  8200	    env LUMOS_PANEL_RETIRE_CUTOFF 供測試/緊急覆寫。"""
  8201	    import os
  8202	    import re as _re
  8203	    cutoff = os.environ.get("LUMOS_PANEL_RETIRE_CUTOFF", "2026-08-26")
  8204	    ts = str((rounds[0] if rounds else {}).get("ts") or "")
  8205	    # ts 必須長得像日期才參與比較——非日期字串(測試假值/損壞帳)字典序會壓過日期字串,
  8206	    # 裸比較會把垃圾 ts 誤判成「未來新迴圈」而拒判(pre-push 全套實抓:fixture ts="t");
  8207	    # 非日期=舊帳語意,照舊放行(回放方向 fail-open)。
  8208	    return bool(_re.match(r"\d{4}-\d{2}-\d{2}", ts)) and ts[:10] >= cutoff
