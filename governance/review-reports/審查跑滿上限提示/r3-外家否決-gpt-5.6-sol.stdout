  8657	# 不是迴圈編號,兩套識別體系從來沒建過對應關係。
  8658	# 第一版把兩組混在同一個集合裡用 nodes 比對,結果 code-loop 那半是死碼,
  8659	# 而且**實測有 23 個早就過閘的 code 迴圈被報成「空轉候選」**(code-234 / code-kill / code-cochange …)。
  8660	LOOP_CLOSE_EVENTS = {("design-loop", "converged"), ("design-loop", "cap-reached"),
  8661	                     ("design-loop", "rewrite")}
  8662	# code-loop 這組只能從自由文字的 detail 認編號(慣例上 detail 開頭就是編號)。
  8663	# ★這是啟發式,不是保證★:detail 是人寫的欄位,沒有任何機制強制它以編號開頭。
  8664	# 失效方式=編號沒寫在 detail 裡 → 那個迴圈會被報成沒關門(偏保守,不會反過來誤報成關了)。
  8665	# REVISIT:2026-11-07 正解是讓 code-loop pass/skip 收一個 --loop 參數、把編號寫進 nodes,
  8666	#   跟設計審那組同形;那要動到推送閘會呼叫的路徑,本批不做。
  8667	LOOP_CLOSE_EVENTS_BY_DETAIL = {("code-loop", "passed"), ("code-loop", "skipped")}
  8668	# ★這兩組以外的 (gate, kind) 都要在下面這張表裡分類過★——新增一種收工事件卻忘了歸類,
  8669	# 守衛會翻紅(t_loop_close_kinds_classified)。沒有這道,新的 kind 只會被靜默當成「沒關門」。
  8670	LOOP_NOT_CLOSE_EVENTS = {
