 40155	def t_disposal_security_seat_content_and_id():
 40156	    """[代碼審資安席 S2,代碼審 r1 折入]①資安席看過的檔,之後內容又改了 → 不算涵蓋(A1/C1:原本只比檔名,
 40157	    同一支檔換成含後門的內容照樣 PASS);只是上下文或行號變了、增刪的行一樣 → 仍算涵蓋(rebase 不誤擋)
 40158	    ②編號 code 開頭卻不是 code- → 看不出種類,照最嚴的當代碼審(A2:原本整步跳過,換個名字就繞過)。
 40159	    翻紅釘:涵蓋比對改回只比檔名 → ①翻紅;_gated_seats_for 對 None 種類改回 skip → ②翻紅。"""
 40160	    v = mkvault()
 40161	    lid = f"code-sec-cc-{_M1U}"
 40162	    sp = _sec_loop(v, lid, [("r1", ["app/login.py"], ["資安-sonnet", "正確性-sonnet"], "正確性-sonnet", ""),
 40163	                            ("r2", ["app/login.py"], ["邊界-sonnet"], "邊界-sonnet", " 後門")])
 40164	    r = _sec_gate(v, lid, sp)
 40165	    tail = _sec_after(r.stdout)
 40166	    check("資安席內容①:資安席看過的檔之後內容又改了 → 未過", r.returncode == 1 and tail.startswith(": ✗"), r.stdout[-700:])
 40167	    check("資安席內容①:訊息點名那支檔、講明是內容跟資安席看的不一樣", "app/login.py" in tail and "內容" in tail.split("\n")[0],
 40168	          tail[:400])
 40169	    lid = f"code-sec-cx-{_M1U}"
 40170	    sp = _sec_loop(v, lid, [("r1", ["app/login.py"], ["資安-sonnet", "正確性-sonnet"], "正確性-sonnet", ""),
 40171	                            ("r2", ["app/login.py"], ["邊界-sonnet"], "邊界-sonnet", "", "  # 上下文變了")])
 40172	    r = _sec_gate(v, lid, sp)
 40173	    # r3 外家否決改:上下文也算指紋(只算增刪行時,同一段改動搬到別的函式指紋不變)——上下文變了要重看
 40174	    check("資安席內容①:增刪的行一樣、但上下文變了 → 不算涵蓋(r3 外家否決改)",
 40175	          r.returncode == 1 and _sec_after(r.stdout).startswith(": ✗"), r.stdout[-700:])
 40176	    lid = f"code-sec-cy-{_M1U}"
 40177	    sp = _sec_loop(v, lid, [("r1", ["app/login.py"], ["資安-sonnet", "正確性-sonnet"], "正確性-sonnet", ""),
 40178	                            ("r2", ["app/login.py"], ["邊界-sonnet"], "邊界-sonnet", "", "", 40)])
 40179	    r = _sec_gate(v, lid, sp)
 40180	    check("資安席內容①:只挪了行號、內容完全一樣 → 仍算涵蓋(PASS,rebase 容忍)",
 40181	          r.returncode == 0 and _sec_after(r.stdout).startswith(": ✓"), r.stdout[-700:])
 40182	    lid = f"codesec{_M1U}"
 40183	    sp = _sec_loop(v, lid, [("r1", ["app/login.py"], ["正確性-sonnet"], "正確性-sonnet")])
 40184	    r = _sec_gate(v, lid, sp)
 40185	    tail = _sec_after(r.stdout)
 40186	    check("資安席編號②:code 開頭卻不是 code- 的高風險迴圈沒派資安席 → 資安席這一步不過(不跳過)",
 40187	          tail.startswith(": ✗"), r.stdout[-700:])
 40188	    check("資安席編號②:訊息講明看不出種類、照最嚴的判", "code-" in tail, tail[:400])
