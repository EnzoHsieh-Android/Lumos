 25002	def t_m1_codeloop_r1_fixes():
 25003	    """code-loop 補審 r1 折入(loop機械脊椎M1包):cluster 路徑轉發/tier-格式衝突 rc2/
 25004	    light 空 auditor 不計席/light 席數委派/panel+light 成本區。"""
 25005	    print("t_m1_codeloop_r1_fixes")
 25006	    v = mkvault()
 25007	    spec = v / "Projects" / "cspec.md"
 25008	    spec.write_text("c spec\n", encoding="utf-8")
 25009	    h = _sha256_of(spec)
 25010	    # 1. cluster 模式不得繞過 min-seats/G3:同席 2 筆 caught+clusters 無 disputed,無 hash
 25011	    for i in range(2):
 25012	        run(v, "canary", "record", "caught", "--loop", f"cl-{_M1U}", "--round", "r1", "--auditor", "same",
 25013	            "--severity", "clean", "--findings", "0", "--report", _sevrep(v.parent),
 25014	            *(["--clusters", "x=resolved"] if i == 0 else []), expect_rc=0)
 25015	    r = run(v, "loop", "status", f"cl-{_M1U}", "--panel", "--min-seats", "5", "--spec", str(spec), "--repo", str(v.parent))
 25016	    check("cluster 模式 min-seats/G3 不被繞過", r.returncode == 1 and ("席" in r.stdout or "hash" in r.stdout or "綁" in r.stdout), r.stdout[-200:])
 25017	    # 2. tier=high 定錨但記錄為 legacy 格式(漏 --round) → next rc2 格式衝突,不得走鬆閘
 25018	    run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", f"tf-{_M1U}", "--severity", "clean", "--findings", "0",
 25019	        "--reviewed", h, "--spec", str(spec), "--tier", "high", expect_rc=0)
 25020	    r = run(v, "loop", "next", f"tf-{_M1U}", "--spec", str(spec), "--repo", str(v.parent))
 25021	    check("high 定錨+legacy 格式 → rc2", r.returncode == 2, f"rc={r.returncode}")
 25022	    # 3. light 空 auditor 不計席:無 --auditor 的 caught 乾淨輪,min-seats=1 應 FAIL
 25023	    run(v, "canary", "record", "caught", "--loop", f"la-{_M1U}", "--severity", "clean", "--findings", "0",
 25024	        "--reviewed", h, "--spec", str(spec), expect_rc=0)
 25025	    r = run(v, "loop", "status", f"la-{_M1U}", "--light", "--gate", "--min-seats", "1", "--spec", str(spec), "--repo", str(v.parent))
 25026	    check("light 空 auditor 不計席 FAIL", r.returncode == 1 and "席" in r.stdout, r.stdout[-150:])
 25027	    # 4. next 對 light 委派 min_seats=1:同上帳但經 next(缺 auditor 不得 converged)
 25028	    run(v, "canary", "record", "caught", "--loop", f"ln-{_M1U}", "--severity", "clean", "--findings", "0",
 25029	        "--reviewed", h, "--spec", str(spec), "--tier", "light", expect_rc=0)
 25030	    r = run(v, "loop", "next", f"ln-{_M1U}", "--json", "--spec", str(spec), "--repo", str(v.parent))
 25031	    import json as _j
 25032	    d = _j.loads(r.stdout)
 25033	    check("next light 委派席數(缺 auditor 不 converged)", d["phase"] != "converged", r.stdout[:150])
 25034	    # 5. panel 與 light 路徑也印成本區
 25035	    for a in ("p1", "p2"):
 25036	        run(v, "canary", "record", "caught", "--loop", f"cp-{_M1U}", "--round", "r1", "--auditor", a,
 25037	            "--severity", "clean", "--findings", "0", "--tokens", "100", "--report", _sevrep(v.parent),
 25038	            *(["--capture-counts", "1"] if a == "p1" else []), expect_rc=0)
 25039	    r = run(v, "loop", "status", f"cp-{_M1U}", "--panel")
 25040	    check("panel 路徑印成本區", "成本" in r.stdout, r.stdout[-150:])
 25041	    run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", f"cli-{_M1U}", "--severity", "clean", "--findings", "0",
 25042	        "--reviewed", h, "--spec", str(spec), "--auditor", "solo", "--tokens", "50", expect_rc=0)
 25043	    r = run(v, "loop", "status", f"cli-{_M1U}", "--light", "--gate", "--spec", str(spec), "--repo", str(v.parent))
 25044	    check("light 路徑印成本區", "成本" in r.stdout, r.stdout[-150:])
