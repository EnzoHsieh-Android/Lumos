 32862	def t_gov_stats_review_yield():
 32863	    """[審查有沒有用記帳 S3] 讀側:問閘尾一行漏斗(舊帳缺 reported → 印 ?、S 算不了;新帳同席兩筆同報告只算一次、
 32864	    S=max(0,M+R−N)、逃逸帳計數);gov --stats 新段(只算有 reported 的輪、Σ 五數、兩個回頭條件數、K<5 樣本太少、
 32865	    寫側擋下次數分兩類、逃逸帳);沒 reported 也沒逃逸 → 段落不印。"""
 32866	    import json as _j, hashlib as _h, shutil
 32867	    gov = ['{"ts":"2026-09-09T09:00:00+08:00","commit":"","gate":"canary","kind":"blocked","hard":true,"nodes":[],"note":"report-not-normalized:2 loop=x auditor=y"}\n',
 32868	           '{"ts":"2026-09-09T09:01:00+08:00","commit":"","gate":"canary","kind":"blocked","hard":true,"nodes":[],"note":"refuted-set-missing loop=x auditor=y"}\n']
 32869	    root, v = _stats_fixture("gctl-ryld-", gov)
 32870	    try:
 32871	        d = root / "docs"
 32872	        spec = root / "spec.md"; spec.write_text("規則甲:嚴重度要忠實轉錄,十個字以上。\n", encoding="utf-8")
 32873	        hsp = _h.sha256(spec.read_bytes()).hexdigest()
 32874	        def _seat(loop, name, body):
 32875	            p = root / "governance" / "review-reports" / loop / name
 32876	            p.parent.mkdir(parents=True, exist_ok=True)
