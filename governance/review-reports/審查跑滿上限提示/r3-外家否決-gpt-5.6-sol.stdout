 40191	def t_loop_printed_cmds_quote_loop_id():
 40192	    """代碼審 r3 資安 G1:印給人照抄的建議指令,迴圈編號與帳上記的材料路徑要加 shell 引號。
 40193	    loop_id 是自由字串(沒有字元白名單),`code-x; touch … #` 原樣塞進 record_cmd,照抄執行 `;` 之後就被當指令跑;
 40194	    上一輪只修了處置閘那一條,loop next 每輪都印的三條與「少了 --spec」那句沒修。
 40195	    ①loop next 的 record_cmd / disposal_cmd / disposal_gate 用 shlex 切開後,編號是完整一段
 40196	    ②「少了 --spec」那句補完的判閘指令,編號與帶空白的材料路徑都是完整一段
 40197	    ③一般編號(code-foo)印出來跟以前一樣,不多引號 ④源碼不再有 f 字串把 {loop_id} 直接接在 lumos 指令裡。
 40198	    翻紅釘:把 cmd_loop_next 裡的 _shlex.quote(loop_id) 改回 {loop_id} → ①④翻紅。"""
 40199	    import json as _j, subprocess as _sp, shlex as _sh, re as _re
 40200	    v = mkvault()
 40201	    _sp.run(["git", "init", "-q", str(v.parent)]); _sp.run(["git", "-C", str(v.parent), "add", "-A"])
 40202	    _sp.run(["git", "-C", str(v.parent), "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "init"])
 40203	    bad = "code-x; touch /tmp/lumos-g1-marker #"
 40204	
 40205	    def after(cmd, flag):
 40206	        toks = _sh.split(cmd)
 40207	        return toks[toks.index(flag) + 1] if flag in toks else None
 40208	
 40209	    r = run(v, "loop", "next", bad, "--tier", "standard", "--orchestrator", "claude", "--json")
 40210	    d = _j.loads(r.stdout)
 40211	    check("編號加引號①:record_cmd 切開後 --loop 後面是完整編號", after(d.get("record_cmd", ""), "--loop") == bad, d.get("record_cmd"))
 40212	    check("編號加引號①:disposal_cmd 同上", after(d.get("disposal_cmd", ""), "--loop") == bad, d.get("disposal_cmd"))
 40213	    check("編號加引號①:disposal_gate 切開後 status 後面是完整編號", after(d.get("disposal_gate", ""), "status") == bad, d.get("disposal_gate"))
 40214	    # ② 帳上有材料、問閘沒帶 --spec → 補完的指令
 40215	    spec = v / "Projects" / "有 空白.md"
 40216	    spec.write_text("spec\n", encoding="utf-8")
 40217	    # ★代碼審每一筆都帶 --snapshot★(2026-09-22 起寫側當場擋):這支測的是印出來的指令有沒有加引號,
 40218	    # 原本沒帶快照是靠那個漏洞才過的——照真實用法補上,不是為了遷就測試去放寬規則。
 40219	    run(v, "canary", "record", "none", "--loop", bad, "--round", "r1", "--auditor", "單reviewer-sonnet", "--severity", "clean",
 40220	        "--findings", "0", "--report", _sevrep(v.parent), "--snapshot", str(spec), "--spec", str(spec), "--reviewed", _sha256_of(spec),
 40221	        "--tier", "standard", "--orchestrator", "claude", expect_rc=0)
 40222	    r = run(v, "loop", "next", bad, "--json")
 40223	    note = (_j.loads(r.stdout).get("note") or "")
 40224	    m = _re.search(r"直接用:(lumos loop status .*?)\(2026", note)
 40225	    cmd = m.group(1) if m else ""
 40226	    check("編號加引號②:「少了 --spec」補完的指令,編號是完整一段", bool(cmd) and after(cmd, "status") == bad, note)
 40227	    check("編號加引號②:帶空白的材料路徑也是完整一段", bool(cmd) and (after(cmd, "--spec") or "").endswith("Projects/有 空白.md"), note)
 40228	    # ③ 一般編號不多引號
 40229	    r = run(v, "loop", "next", "code-foo", "--tier", "standard", "--orchestrator", "claude", "--json")
 40230	    d = _j.loads(r.stdout)
 40231	    check("編號加引號③:一般編號印出來跟以前一樣(--loop code-foo,不多引號)", "--loop code-foo " in d.get("record_cmd", ""), d.get("record_cmd"))
 40232	    # ④ 源碼守衛:印給人的 lumos 指令裡,{loop_id} 不得直接內插
 40233	    src = Path(GRAPHCTL).read_text(encoding="utf-8")
 40234	    raw = [ln.strip()[:120] for ln in src.splitlines() if _re.search(r'f".*lumos [a-z][^"]*\{loop_id\}', ln)]
 40235	    check("編號加引號④:源碼沒有 f 字串把 {loop_id} 直接接在 lumos 指令裡", not raw, "\n".join(raw))
 40236	
