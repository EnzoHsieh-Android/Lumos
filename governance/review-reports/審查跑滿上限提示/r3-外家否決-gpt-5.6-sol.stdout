 30589	                print(f"擋下:沒有「{bad}」這個指令。", file=sys.stderr)
 30590	            elif "required: cmd" in (message or ""):
 30591	                # ★裸打是最常見的第一次接觸★:不要丟一句英文的「缺少必填參數」給人。
 30592	                print("擋下:要給一個指令才知道你想做什麼。", file=sys.stderr)
