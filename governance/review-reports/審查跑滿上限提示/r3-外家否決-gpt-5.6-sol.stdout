 18588	def cmd_quote_check(report, spec, as_json=False):
 18589	    """錨定檢查(T2,vault-free):報告內每條「引句：「…」」norm 後須為凍結快照 norm 後的
 18590	    子字串。rc0=全 ok、rc1=有 miss、rc2=IO/零引句(★驗不了≠通過,fail loud★)。
 18591	    ★比對對象必須是派工當下的凍結快照,不是現檔★——對現檔跑,finding 折入後引句會
 18592	    「自我成真」(重設計 r1 Codex 折入:循環自證)。"""
 18593	    import json
 18594	    import re
 18595	    try:
 18596	        rtext = Path(report).read_text(encoding="utf-8")
 18597	        stext = Path(spec).read_text(encoding="utf-8")
 18598	    except (OSError, UnicodeDecodeError) as e:
 18599	        # UnicodeDecodeError 非 OSError——非 UTF-8 檔原本直接 traceback(r1 s4 席)
 18600	        print(f"擋下:檔案讀不到: {e}", file=sys.stderr)
 18601	        return 2
 18602	    rows = _quote_rows(rtext, stext)
 18603	    if rows is None:
 18604	        print("擋下:這份審查報告裡一句「引句：「…」」都抽不到;驗不了不等於通過——"
 18605	              "審查員沒照派工格式寫的話,先補引句再記帳。\n"

