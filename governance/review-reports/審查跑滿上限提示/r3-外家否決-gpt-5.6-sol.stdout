 24940	def t_m1_loop_next():
 24941	    """M1包 #1 loop next:零記錄 rc2/plant-canary/tier 定錨+衝突 rc2/escalate/gate-pending/converged/cap/min-seats/json。"""
 24942	    print("t_m1_loop_next")
 24943	    import json as _j, subprocess as _sp
 24944	    v = mkvault()
 24945	    # 治理帳要 git HEAD 才寫(#6 的結案帳用):給 vault 上層一個 commit
 24946	    _sp.run(["git", "init", "-q", str(v.parent)]); _sp.run(["git", "-C", str(v.parent), "add", "-A"])
 24947	    _sp.run(["git", "-C", str(v.parent), "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "init"])
 24948	    spec = v / "Projects" / "nspec.md"
 24949	    spec.write_text("next spec\n", encoding="utf-8")
 24950	    h = _sha256_of(spec)
 24951	    # 零記錄無 --tier rc2
 24952	    r = run(v, "loop", "next", f"nx-{_M1U}", "--orchestrator", "claude")   # S2:orchestrator 守衛先擋,補旗標才測得到 tier 守衛(code-codex-s2 r1 外家 #5)
 24953	    check("零記錄無 tier rc2", r.returncode == 2)
 24954	    # 零記錄+tier light → plant-canary N=1
 24955	    r = run(v, "loop", "next", f"nx-{_M1U}", "--tier", "light", "--orchestrator", "claude", "--json")
 24956	    d = _j.loads(r.stdout)
 24957	    check("零記錄 plant-canary N=1", d["phase"] == "plant-canary" and d["round"] == 1 and r.returncode == 1)
 24958	    check("light width/cap 映射", d["width"] == 1 and d["cap"] == 2)
 24959	    # tier 定錨:record 帶 --tier light → next 無 --tier 讀定錨(帶 auditor:空席不計已生效)
 24960	    run(v, "canary", "record", "caught", "--report", _sevrep(v.parent), "--loop", f"nx-{_M1U}", "--severity", "clean", "--findings", "0",
 24961	        "--auditor", "solo", "--reviewed", h, "--spec", str(spec), "--tier", "light", expect_rc=0)
 24962	    r = run(v, "loop", "next", f"nx-{_M1U}", "--json", "--spec", str(spec), "--repo", str(v.parent))
 24963	    d = _j.loads(r.stdout)
 24964	    check("tier 定錨讀取", d["tier"] == "light")
 24965	    check("light 收斂 → converged rc0", d["phase"] == "converged" and r.returncode == 0)
 24966	    # 定錨衝突 rc2
 24967	    r = run(v, "loop", "next", f"nx-{_M1U}", "--tier", "standard", "--orchestrator", "claude")
 24968	    check("tier 衝突 rc2", r.returncode == 2)
 24969	    # 資訊不足 → gate-pending(先於 cap)
 24970	    r = run(v, "loop", "next", f"nx-{_M1U}", "--json")
 24971	    d = _j.loads(r.stdout)
 24972	    check("缺 --spec → gate-pending rc1", d["phase"] == "gate-pending" and r.returncode == 1)
 24973	    # escalate:light ratchet 最先短路
 24974	    run(v, "canary", "record", "caught", "--loop", f"nx2-{_M1U}", "--severity", "major", "--findings", "2",
 24975	        "--reviewed", h, "--spec", str(spec), "--tier", "light", expect_rc=0)
 24976	    r = run(v, "loop", "next", f"nx2-{_M1U}", "--json", "--spec", str(spec), "--repo", str(v.parent))
 24977	    d = _j.loads(r.stdout)
 24978	    check("light ratchet → escalate", d["phase"] == "escalate" and r.returncode == 1)
 24979	    # cap-reached:light cap=2 兩輪未收斂(資訊充分)
 24980	    run(v, "canary", "record", "missed", "--loop", f"nx3-{_M1U}", "--tier", "light", expect_rc=0)
 24981	    run(v, "canary", "record", "missed", "--loop", f"nx3-{_M1U}", expect_rc=0)
 24982	    r = run(v, "loop", "next", f"nx3-{_M1U}", "--json", "--spec", str(spec), "--repo", str(v.parent))
 24983	    d = _j.loads(r.stdout)
 24984	    check("cap-reached", d["phase"] == "cap-reached" and r.returncode == 1)
 24985	    # ── 工具鏈補強十件 #6:結案方式進治理帳,gov --stats 算人裁放行率 ──
 24986	    glog = v.parent / ".governance-log.jsonl"
 24987	    gtxt = glog.read_text(encoding="utf-8") if glog.exists() else ""
 24988	    check("★converged 進治理帳(gate=design-loop)★", '"gate": "design-loop"' in gtxt and '"converged"' in gtxt and f"nx-{_M1U}" in gtxt, gtxt[-400:])
 24989	    check("★cap-reached 進治理帳★", '"cap-reached"' in gtxt and f"nx3-{_M1U}" in gtxt, gtxt[-400:])
 24990	    rg = run(v, "gov", "--stats", "--since", "9999")
 24991	    check("★gov --stats 印人裁放行:1 個過關、1 個達上限★", "閘過了 1 個" in rg.stdout and "人裁放行) 1 個" in rg.stdout, rg.stdout)
 24992	    # min-seats:panel 同席灌筆不計——high 定錨,同一 auditor 5 筆
