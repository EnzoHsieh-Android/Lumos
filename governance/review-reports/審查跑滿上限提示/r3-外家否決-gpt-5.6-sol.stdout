  7992	          + f"\n    寫入 {path.resolve()}")
  7993	    # 逃逸自動記(規格落成可驗收條件_計劃 第五節):代碼審(code-<主題>)記到 major 以上,
  7994	    # 對回 <主題> 那條設計迴圈/計劃就記一筆。永遠不影響審查帳本身(任何失敗只印一行)。
  7995	    _kinds = rec.get("finding_kinds") if isinstance(rec.get("finding_kinds"), dict) else None
  7996	    _sevs = rec.get("finding_severities") if isinstance(rec.get("finding_severities"), dict) else None
  7997	    if _sevs is not None:
  7998	        # 逐條判(r2 回滾席):code 型那條自己要是 major 以上;沒標型別的那條當分不出、保守算
  7999	        _hit = any(v in ("major", "blocker") and (_kinds is None or _kinds.get(k) == "code") for k, v in _sevs.items())
  8000	        _precision = "finding" if _kinds is not None else "round"   # 沒標型別=分不出是不是 code 型,不能謊報成逐條精度(r3 邊界席)
  8001	    else:
  8002	        _has_code = (_kinds is None) or any(str(v) == "code" for v in _kinds.values())   # 沒標型別=分不出,保守記;標了就只收 code 型
  8003	        _hit = severity in ("major", "blocker") and _has_code
  8004	        _precision = "round"   # 輪級判準:這輪最高 major 且任一條是 code 型——粗,帳上標出來讓讀側分得出
  8005	    if loop and str(loop).startswith("code-") and _hit:
  8006	        try:
  8007	            derived = str(loop)[len("code-"):]
  8008	            _auto_escape(env, "code-loop", severity,
  8009	                         f"代碼審記到 {severity}({auditor or '?'}{' ' + str(round_id) if round_id else ''})",
  8010	                         [(derived, _plan_for_loop(env, derived))],
  8011	                         _git_head(env.vault.parent.parent), source="code-loop", extra={"precision": _precision})
  8012	        except Exception as _ex:   # 掛勾不准弄壞記帳
  8013	            _escape_auto_failed(env, str(loop), "code-loop", str(_ex))
  8014	    return 0
