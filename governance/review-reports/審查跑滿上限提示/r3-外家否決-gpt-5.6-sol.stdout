 24931	    check("★loop next 必須在派工前就給量尺★(記帳時才喊已經來不及,輪跑完了)",
 24932	          "scope_cap" in nx0.stdout and "wc -l" in nx0.stdout, nx0.stdout[-300:])
 24933	
