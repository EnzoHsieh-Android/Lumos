 24124	def t_loop_status_disposal_gate():
 24125	    """[T4 處置閘](spec:Projects/design-loop重設計 三;plan:同名_實作計畫 T4)
 24126	
 24127	    `loop status <id> --disposal --spec <真檔> --repo <root>`:新閘走★獨立路徑★,
 24128	    四條合取全部讀側可重算:①G3 hash 鏈 ②處置集合(重算,不信寫側)③留痕讀側重驗
 24129	    (report/snapshot 存在且 sha256 與帳面一致——record 完刪檔照樣擋)④quote-check
 24130	    對帳面 snapshot 重跑全 ok。
 24131	
 24132	    ★d4 合約★:canary kind=missed ★不進合取★——missed 席在場照樣可收斂(觀測非閘)。
 24133	    ★相容合約★:同一帳不帶 --disposal 走舊路徑,行為與改動前一致(舊閘一行不動)。
 24134	    取捨(plan〈實務隱患〉預告):舊路徑迴歸斷言採「rc+判定行子字串」而非逐字節相同——
 24135	    逐字節對提示文字換行過脆;rc+『輪有效』子串足以釘住「走的是舊 panel 判定」。
 24136	    翻紅釘:刪掉報告檔 → 條③翻紅(現場成立前置:record 當下檔案在)。"""
 24137	    import json as _j
 24138	    v = mkvault()
 24139	    d = v / "Projects"
 24140	    spec = d / "t4spec.md"
 24141	    spec.write_text("# spec\n規則甲：只在 0 命中時回退。\n", encoding="utf-8")
 24142	    h = _sha256_of(spec)
 24143	    snap = d / "t4snap.md"
 24144	    snap.write_text(spec.read_text(encoding="utf-8"), encoding="utf-8")
 24145	    rpt = d / "t4rpt.md"
 24146	    rpt.write_text("severity: clean\n甲\n引句：「規則甲：只在 0 命中時回退。」\n", encoding="utf-8")
 24147	    lid = f"t4-{_M1U}"
 24148	
 24149	    # 判定輪 r1 兩席:席1 帶處置帳+留痕+雙 hash;席2=★missed★(d4:不得影響閘)
 24150	    run(v, "canary", "record", "caught", "--loop", lid, "--round", "r1", "--auditor", "s1",
 24151	        "--severity", "minor", "--findings-set", "F1,F2", "--refuted-set", "none", "--folded-set", "F1",
 24152	        "--accepted-set", "F2", "--accept-reason", "F2=精度級",
 24153	        "--report", str(rpt), "--snapshot", str(snap),
 24154	        "--spec", str(spec), "--reviewed", h, expect_rc=0)
 24155	    run(v, "canary", "record", "missed", "--loop", lid, "--round", "r1", "--auditor", "s2",
 24156	        "--severity", "major", "--report", str(rpt), "--snapshot", str(snap),
 24157	        "--spec", str(spec), "--reviewed", h, expect_rc=0)   # T6:定錨後每席都要留痕(d4 判定留痕)
 24158	
 24159	    # 互斥
 24160	    for extra in (["--panel"], ["--light"], ["--need", "3"]):
 24161	        rr = run(v, "loop", "status", lid, "--disposal", "--spec", str(spec), "--repo", str(v.parent), *extra)
 24162	        check(f"--disposal 與 {extra[0]} 互斥 rc2", rr.returncode == 2, f"rc={rr.returncode} {rr.stderr[:100]}")
 24163	    check("--disposal 缺 --spec rc2(fail-closed,同 light 慣例)",
 24164	          run(v, "loop", "status", lid, "--disposal", "--repo", str(v.parent)).returncode == 2, "")
 24165	
 24166	    r = run(v, "loop", "status", lid, "--disposal", "--spec", str(spec), "--repo", str(v.parent))
 24167	    check("★四條合取全過→rc0;missed 席在場照樣收斂(d4:canary=觀測非閘)★",
 24168	          r.returncode == 0, f"rc={r.returncode}\n{r.stdout[:400]}{r.stderr[:200]}")
 24169	
 24170	    # 舊路徑迴歸:同一帳不帶 --disposal 走舊 panel 閘(格式帶 round→須 --panel),行為不變
 24171	    r_old = run(v, "loop", "status", lid, "--gate", "--panel", "--spec", str(spec), "--repo", str(v.parent))
 24172	    check("★相容:同一帳走舊 panel 閘照舊 FAIL(1 caught+1 missed=輪無效)——舊閘一行不動★",
 24173	          r_old.returncode == 1 and "輪有效" in r_old.stdout, f"rc={r_old.returncode}\n{r_old.stdout[:200]}")
 24174	
 24175	    # ③留痕讀側:record 完把報告檔改掉 → sha 不符 → FAIL
 24176	    check("★前置★ 現場成立:record 當下報告檔在且剛才 rc0", rpt.exists(), "")
 24177	    orig = rpt.read_text(encoding="utf-8")
 24178	    rpt.write_text(orig + "事後竄改\n", encoding="utf-8")
 24179	    r2 = run(v, "loop", "status", lid, "--disposal", "--spec", str(spec), "--repo", str(v.parent))
 24180	    check("★留痕讀側重驗:報告被改(sha 不符)必 FAIL rc1★", r2.returncode == 1, f"rc={r2.returncode}\n{r2.stdout[:300]}")
 24181	    rpt.write_text(orig, encoding="utf-8")
 24182	
 24183	    # ④quote-check 讀側:快照偷換成沒有該句的版本 → miss → FAIL
 24184	    snap2 = d / "t4snap2.md"
 24185	    snap2.write_text("# 別的內容\n", encoding="utf-8")
 24186	    lid2 = f"t4b-{_M1U}"
 24187	    run(v, "canary", "record", "caught", "--loop", lid2, "--round", "r1", "--auditor", "s1",
 24188	        "--severity", "minor", "--findings-set", "F1", "--refuted-set", "none", "--folded-set", "F1",
 24189	        "--report", str(rpt), "--snapshot", str(snap),
 24190	        "--spec", str(spec), "--reviewed", h, expect_rc=0)
 24191	    # 記完再把帳裡的快照換成沒有該句的版本(寫側 2026-09-06 起會擋這種載體,見 _ledger_patch_last)
 24192	    _ledger_patch_last(v.parent / ".canary-log.jsonl", lid2, snapshot_path=snap2)
 24193	    r3 = run(v, "loop", "status", lid2, "--disposal", "--spec", str(spec), "--repo", str(v.parent))
 24194	    check("★quote-check 讀側:引句錨不到快照必 FAIL rc1★", r3.returncode == 1, f"rc={r3.returncode}\n{r3.stdout[:300]}")
 24195	
 24196	    # ②處置集合讀側+blocker 線:blocker 席在場且有 accepted → FAIL(即使寫側當時個別合法)
 24197	    lid3 = f"t4c-{_M1U}"
 24198	    run(v, "canary", "record", "caught", "--loop", lid3, "--round", "r1", "--auditor", "s1",
 24199	        "--severity", "minor", "--findings-set", "F1", "--refuted-set", "none", "--folded-set", "",
 24200	        "--accepted-set", "F1", "--accept-reason", "F1=可放",
 24201	        "--report", str(rpt), "--snapshot", str(snap),
 24202	        "--spec", str(spec), "--reviewed", h, expect_rc=0)
 24203	    run(v, "canary", "record", "caught", "--loop", lid3, "--round", "r1", "--auditor", "s2",
 24204	        "--severity", "blocker", "--report", str(rpt), "--snapshot", str(snap),
 24205	        "--spec", str(spec), "--reviewed", h, expect_rc=0)   # T6 同上
 24206	    r4 = run(v, "loop", "status", lid3, "--disposal", "--spec", str(spec), "--repo", str(v.parent))
 24207	    check("★blocker 在別席+本席 accepted:輪級重算必 FAIL(堵 Codex 的寫側盲區)★",
 24208	          r4.returncode == 1, f"rc={r4.returncode}\n{r4.stdout[:300]}")
