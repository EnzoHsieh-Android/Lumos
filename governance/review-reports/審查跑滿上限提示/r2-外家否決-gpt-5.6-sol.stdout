        log = env.vault.parent / ".escape-log.jsonl"
        if not log.exists():
            return out
        for ln in log.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
        elif info == "unbound":
            print("[panel] G3 文件有沒有被事後改過: ✗ — 判定輪的記錄沒帶文件指紋,沒辦法驗")
            fails.append("G3")
        else:
            print(f"[panel] G3 文件有沒有被事後改過: ✓ — {info}(同輪每筆指紋一致、最後一筆等於現在的檔)")
    return fails


def _panel_k2_active(rounds):
    """[A案 2026-08-05] K=2 適用判定:loop 首筆 ts 日期 ≥ cutoff(預設 2026-08-06)→新制。
    舊帳不回溯(spec 落地面5,借 T6 定錨慣例);env LUMOS_PANEL_K2_CUTOFF 供測試/緊急覆寫。"""
    import os
    cutoff = os.environ.get("LUMOS_PANEL_K2_CUTOFF", "2026-08-06")
    ts = str((rounds[0] if rounds else {}).get("ts") or "")
    return ts[:10] >= cutoff


def _panel_retired_for(rounds):
    """[probe輪退場 d1/甲裁 2026-08-25] panel 閘退役判定:loop 首筆 ts 日期 ≥ cutoff(預設
    2026-08-26)=新迴圈,panel 閘拒判並指路處置閘;舊迴圈(cutoff 前定錨)照常回放。
    env LUMOS_PANEL_RETIRE_CUTOFF 供測試/緊急覆寫。"""
    import os
    import re as _re
    cutoff = os.environ.get("LUMOS_PANEL_RETIRE_CUTOFF", "2026-08-26")
    ts = str((rounds[0] if rounds else {}).get("ts") or "")
    # ts 必須長得像日期才參與比較——非日期字串(測試假值/損壞帳)字典序會壓過日期字串,
    # 裸比較會把垃圾 ts 誤判成「未來新迴圈」而拒判(pre-push 全套實抓:fixture ts="t");
    # 非日期=舊帳語意,照舊放行(回放方向 fail-open)。
    return bool(_re.match(r"\d{4}-\d{2}-\d{2}", ts)) and ts[:10] >= cutoff


def _panel_round_conjuncts(recs, quiet=False):
    """單輪兩條合取(輪有效∧存活≤minor;capture-recapture 殘餘=advisory 觀測,2026-08-14 降級)——A案 K=2 抽出共用,
    ★單一實作★:判定輪(quiet=False,輸出逐字同改動前)與 K=2 前一輪(quiet=True)同函式。
    回 fails list。"""
    order = _SEV_ORDER   # 值序單一常數(嚴重度綁定機械掃 arch-f2 回填)
    fails = []
    caught_recs = [r for r in recs if r.get("kind") == "caught"]
    # 2026-08-14 canary 協議停用(Systems/canary-audit d5):kind=none=無植入輪的純處置帳載體。
    # none 制輪有效=記帳席數≥2 且零 missed(醒著證明改由 skill 層 quote-check 引句錨定機械把關);
    # 舊 caught 分支原樣保留(歷史帳/混用輪回放不變)。
    none_recs = [r for r in recs if r.get("kind") == "none"]
    caught = len(caught_recs)
    missed = sum(1 for r in recs if r.get("kind") == "missed")
    if none_recs and missed == 0 and (caught + len(none_recs)) >= 2:
        if not quiet:
            print(f"[panel] 輪有效: ✓ — {caught + len(none_recs)} 個人都記了帳")
    elif caught >= 2 and missed == 0:
        if not quiet:
            print(f"[panel] 輪有效: ✓ — {caught} 個人全部抓到植入的錯(near-perfect)")
    elif missed > 0:
        if not quiet:
            print(f"[panel] 輪有效: ✗ — 有 {missed} 人漏掉植入的錯(near-perfect 規則要求全員抓到;有人漏審的輪不能拿來當收斂證據)")
        fails.append("輪無效")
    else:
        if not quiet:
            print(f"[panel] 輪有效: ✗ — 記帳的人不夠(抓到 {caught} 人+無植入 {len(none_recs)} 人,少於 2 人,這輪無效)")
        fails.append("輪無效")
    # 嚴重度合取讀 caught+none(none 輪不讀會盲掉存活 findings——停用制下全輪都是 none)
    maxsev = max((order.get(r.get("severity", "clean"), 1) for r in caught_recs + none_recs), default=0)
    if maxsev >= 2:
        if not quiet:
            print(f"[panel] 留下的問題嚴不嚴重(最高只能到 minor): ✗ — 這輪還留著 {'blocker' if maxsev==3 else 'major'} 等級的問題沒解決,太嚴重不能過")
        fails.append("存活≥major")
    else:
        if not quiet:
            print("[panel] 留下的問題嚴不嚴重(最高只能到 minor): ✓ — 留下的問題都在可接受等級")
    # capture-recapture 殘餘:★2026-08-14 降 advisory,不進合取★(Projects/收斂閘殘餘估計降級_計劃 S1/S2)
    # 理由=鑑別力≈0(殘餘<1 組下輪 major+ 67% vs ≥1 對照組 79%,p≈0.25)+f1≤1 公式退化+席獨立前提被自家
    # 重疊分布(64-71% 單席獨佔)否定;舊「殘餘超門檻」「無capture_counts」兩條 fails 撤除。
    cc = next((r["capture_counts"] for r in recs if r.get("capture_counts")), None)
    if cc is None:
        if not quiet:
            print("[panel] 估計還有多少沒被抓到(看幾個人重複抓到同一條來推;只供參考,不影響過不過): 沒有重疊數據,算不出來")
    else:
        ccl = _cc_ints(cc)   # r1 s2:三個讀側呼叫點統一過型別守衛,壞型不得靜默算假 0.0
        if ccl is None:
            if not quiet:
                print("[panel] 估計還有多少沒被抓到(看幾個人重複抓到同一條來推;只供參考,不影響過不過): 數據格式不對,不算")
        else:
            remaining = _estimate_remaining_defects(ccl)
            if not quiet:
                note = "⚠ 低殘餘讀數無鑑別力(自帳對照 67% vs 79%,2026-08-14)" if remaining < 1.0 else ""
                print(f"[panel] 估計還有多少沒被抓到(看幾個人重複抓到同一條來推;只供參考,不影響過不過): 估計還有 {remaining:.2f} 個沒被抓到 {note}".rstrip())
    return fails


def _panel_probe_verdict(loop_id, rid, recs):
    """[A案 e'] 決定性抽查判定:sha256(loop_id+判定輪 rid+該輪 token 排序串)%2==0 → 應抽。
    輸入全部來自 append-only 帳(token=record 時 secrets 自動鑄造)——任何人可事後重算
    「該不該抽」,不依賴編排者誠實(r1 折入:原「編排者擲 p」嚇阻不成立)。"""
    import hashlib
    toks = ",".join(sorted(str(r.get("token") or "") for r in recs))
    h = int(hashlib.sha256(f"{loop_id}:{rid}:{toks}".encode("utf-8")).hexdigest(), 16)
    return h % 2 == 0


def _loop_status_panel(rounds, loop_id, min_seats=None, spec=None, env=None):
    """平行 panel 收斂謂詞(loop 三輪壓縮)。無-cluster 帳:兩條合取(輪有效∧存活max≤minor;殘餘=advisory
    ∧capture-recapture 殘餘,fail-closed)。cluster 帳(M2,設計 Projects/design-loop提效_計劃;
    golden: governance/golden/dloop-m2-cluster):首個有效輪帶 clusters 定錨 → 兩條合取
    (輪有效∧fold 後無 disputed-major),新生 cluster/capture-recapture 降 advisory,
    無效輪 clusters 忽略+警告區列帳(不蒸發)。讀側 rc2 類:round-id 非連續/型別損壞/
    有效輪 W 歸屬衝突/有效輪級混用。"""
    if _panel_retired_for(rounds):
        print("擋下:panel 閘自 2026-08-25 甲裁後僅供舊迴圈回放,這個編號是之後才開的新迴圈——", file=sys.stderr)
        print("  多席審查改用彙總記帳(處置清單只掛一席,其餘席只留痕),然後問處置閘:", file=sys.stderr)
        print("    lumos loop status <編號> --disposal --spec … --repo …", file=sys.stderr)
        print("  (詳 Projects/probe輪退場_計劃;帳不可撤,已誤記多筆處置清單就換編號重記)", file=sys.stderr)
        return 2
    from collections import OrderedDict
    groups = OrderedDict()
    for r in rounds:
        rid_ = r.get("round")
        if rid_ in groups and next(reversed(groups)) != rid_:
            # M2:round-id 被其他 round 隔開後重現=帳本次序損壞(append-only 不容跳寫)
            print(f"擋下:第 {rid_!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),帳的順序亂了,沒辦法判斷",
                  file=sys.stderr)
            return 2
        groups.setdefault(rid_, []).append(r)
    if not groups:
        print(f"⏳ {loop_id} 還沒有任何一輪的多人審查記錄")
        return 1
    # ── M2 讀側型別防禦:clusters 欄必須是 dict[str,str](寫側轉型慣例;手改/損壞 → rc2 非 traceback)
    for r in rounds:
        if "clusters" in r:
            c = r["clusters"]
            if (not isinstance(c, dict)
                    or any(not isinstance(k, str) or not isinstance(v, str) for k, v in c.items())):
                print(f"擋下:有筆記錄的分組欄不是「群名:狀態」的形式(檔案壞了或被手改過?): {c!r}",
                      file=sys.stderr)
                return 2
    valid_of = {rid_: _round_valid_m2(recs) for rid_, recs in groups.items()}
    # ── M2 W 歸屬:有效輪同輪 >1 筆帶 clusters → rc2(無效輪多筆帶=豁免,列警告區)
    for rid_, recs in groups.items():
        if valid_of[rid_] and sum(1 for r in recs if "clusters" in r) > 1:
            print(f"擋下:第 {rid_} 輪有 {sum(1 for r in recs if 'clusters' in r)} 筆記錄都帶了分組,一輪只能有一筆"
                  f"(工具不會默默挑第一筆,請自己決定留哪筆)", file=sys.stderr)
            return 2
    # ── M2 定錨:第一個有效輪定模式(無效輪不定錨——首輪全 missed 的新 loop 不得鎖死)
    anchor_rid, anchor_cluster = None, False
    for rid_, recs in groups.items():
        if valid_of[rid_]:
            anchor_rid = rid_
            anchor_cluster = any("clusters" in r for r in recs)
            break
    if anchor_rid is not None:
        # 有效輪級混用守衛(無效輪豁免:帶或不帶皆不觸發)
        for rid_, recs in groups.items():
            if not valid_of[rid_]:
                continue
            has_c = any("clusters" in r for r in recs)
            if anchor_cluster and not has_c:
                print(f"擋下:這個審查編號從第 {anchor_rid} 輪起就是分組追蹤模式,但第 {rid_} 輪沒帶分組"
                      f";補那一輪的分組記錄,或開新的審查編號", file=sys.stderr)
                return 2
            if not anchor_cluster and has_c:
                print(f"擋下:這個審查編號從第 {anchor_rid} 輪起就定成不分組,但第 {rid_} 輪帶了分組"
                      f";想用分組追蹤請開新的審查編號,既有的不能中途改", file=sys.stderr)
                return 2
    if anchor_rid is not None and anchor_cluster:
        return _loop_status_panel_clusters(groups, valid_of, loop_id,
                                           min_seats=min_seats, spec=spec, all_rounds=rounds, env=env)
    # ── 無-cluster 舊帳(或零有效輪=未定錨):既有三條合取,fail-closed 不變 ──
    # cluster-intent 但未定錨(零有效輪):條 1 改用 M2 嚴格謂詞(unknown-kind 盲區補;
    # 純無-cluster loop 不受影響——舊行為迴歸保證只對真 legacy 帳)
    _cluster_intent = any("clusters" in r for r in rounds)
    rid, latest = next(reversed(groups.items()))
    if _cluster_intent and not valid_of[rid]:
        print(f"[panel] 輪有效: ✗ — 分組追蹤模式下第 {rid} 輪無效(要至少 2 人抓到、0 人漏掉)")
        for i, r in enumerate(latest, 1):
            print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")
        print(f"⛔ PANEL GATE FAIL({loop_id} 第 {rid} 輪沒通過:這輪無效,分組模式也還沒定下來)")
        return 1
    fails = _panel_round_conjuncts(latest)   # A案:三條合取抽出共用(輸出逐字同改動前)
    # [A案 2026-08-05] K=2:cutoff 起的新 loop,收斂需最後★兩★輪各自過三條合取
    # (AEGIS 非單調序列+relmainnet 既遂實例;design-loop r1+r2 收斂裁定)。舊帳不回溯。
    k2 = _panel_k2_active(rounds)
    if k2 and not fails:
        rids = list(groups)
        if len(rids) < 2:
            print("[panel] K=2 連續兩輪乾淨: ✗ — 目前只有一輪(規則要連續兩輪都合格;第二輪要審全量材料)")
            fails.append("K=2需第二輪")
        else:
            prev_rid = rids[-2]
            prev_fails = _panel_round_conjuncts(groups[prev_rid], quiet=True)
            if prev_fails:
                print(f"[panel] K=2 連續兩輪乾淨: ✗ — 前一輪 {prev_rid} 沒過({'/'.join(prev_fails)})")
                fails.append("K=2前一輪未乾淨")
            else:
                # 前一輪殘餘觀測行內附值(S2:quiet 路徑不重印整段,但 K=2 為新 loop 預設,
                # 不附值則前一輪殘餘觀測在常態下整段消音——r1 邊界席 P8)
                pcc = next((r["capture_counts"] for r in groups[prev_rid] if r.get("capture_counts")), None)
                pccl = _cc_ints(pcc) if pcc is not None else None
                if pcc is None:
                    obs = "殘餘 obs 缺席"
                elif pccl is None:
                    obs = "殘餘 obs 壞型(counts 非 int list)"   # r1 s2:同守衛,壞型不印假值
                else:
                    obs = f"殘餘 obs {_estimate_remaining_defects(pccl):.2f}"
                print(f"[panel] K=2 連續兩輪乾淨: ✓ — 前一輪 {prev_rid} 也合格({obs})")
    fails += _panel_extra_checks(latest, min_seats, spec)
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('capture_counts','-')}\t{r.get('auditor','')}")
    for line in _cost_summary(rounds):
        print(line)
    if fails:
        print(f"⛔ PANEL GATE FAIL({loop_id} 第 {rid} 輪沒通過,卡在:{'/'.join(fails)})")
        return 1
    if k2:
        probe = _panel_probe_verdict(loop_id, rid, latest)
        print(f"✅ PANEL GATE PASS({loop_id} 第 {rid} 輪通過:連續兩輪乾淨、這輪有效、留下的問題都在可接受等級)")
        _loop_gov_mark(env, loop_id, "converged", "gate PASS")
        print(f"[panel] 抽查判定(觀測,任何人都能重算出同樣結果): {'本輪落在應抽樣——2026-08-25 起 panel 僅回放、不再加開 probe 輪(詳 Issues/probe輪三參數只在散文)' if probe else '免抽'}")
    else:
        print(f"✅ PANEL GATE PASS({loop_id} 第 {rid} 輪通過:這輪有效、留下的問題都在可接受等級)")
        _loop_gov_mark(env, loop_id, "converged", "gate PASS")
    return 0


def _loop_status_panel_clusters(groups, valid_of, loop_id, min_seats=None, spec=None, all_rounds=None, env=None):
    """M2 cluster 帳 gate:兩條合取(判定輪有效 ∧ fold 後無 disputed-major)。
    fold 只採有效輪(last-wins,同名跨輪最後狀態勝);無效輪 clusters 警告區列帳不蒸發;
    新生 cluster 與 capture-recapture 皆 advisory 不進合取。"""
    order = _SEV_ORDER   # 值序單一常數(嚴重度綁定機械掃 arch-f2 回填)
    rid, latest = next(reversed(groups.items()))
    fails = []
    # 條 1:判定輪(latest)有效——同一謂詞
    caught_recs = [r for r in latest if r.get("kind") == "caught"]
    n_caught, n_missed = len(caught_recs), sum(1 for r in latest if r.get("kind") == "missed")
    n_none = sum(1 for r in latest if r.get("kind") == "none")   # 停用制輪(d5)
    if not log.exists():
        try:
            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
        except FileExistsError:
            pass
        except OSError as e:
            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
            return 2
    rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])   # 共用硬化原語(OSError 擋下+讀回自驗);已知天花板=撞鍵時讀回比對可能對到舊筆(canary 全家族同款,hex4 空間機率極低)
    if rc_w:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。
    讀 .canary-log.jsonl 的 **append 序**(不 ts-sort:ts 只到秒、同秒會並列),篩 loop==id。
    tail-K 滑動窗:前面髒輪不影響、只看最後 K 筆;missed/缺 severity 視同未收斂。
    exit 0=CONVERGED / 1=未收斂(含無記錄=還沒開始)/ 2=真錯誤。
    天花板:收斂=連 K 輪醒著的審計員沒找到 blocker/major,非完整正確;severity 自報(見設計 doc)。"""
    import json
    if light and panel:
        print("擋下:--light 和 --panel 不能一起用(light 是單人審、panel 是多人審,兩條不同的路),擇一", file=sys.stderr)
        return 2
    explicit_need = need is not None
    if need is None:
        need = 2
    if disposal:
        # [T4 處置閘] 獨立路徑(design-loop重設計 d2/B5):與所有既有模式互斥,舊閘一行不動
        if panel or light or settle is not None or explicit_need or min_seats is not None:
            print("擋下:--disposal 是獨立的一套閘,不能跟 --panel/--light/--settle/--need/--min-seats 一起用",
                  file=sys.stderr)
            return 2
        if spec is None:
            print("擋下:--disposal 一定要帶 --spec 指定被審的文件,不然沒辦法比對文件有沒有被改、留痕對不對(寧可擋也不猜)", file=sys.stderr)
            return 2
    if settle is not None:
        # [S1] rc2 互斥/前置群(fail-closed;結清式收斂_計劃 2026-07-28)
        if panel or light:
            print("擋下:--settle 不能跟 --panel 或 --light 一起用(目前只接單人審的記錄格式)", file=sys.stderr)
            return 2
        if explicit_need:
            print("擋下:--settle 模式不數輪數,--need 在這裡沒意義;與其默默忽略誤導你,不如請你拿掉 --need", file=sys.stderr)
            return 2
        if min_seats is not None:
            print("擋下:--settle 不能跟 --min-seats 一起用(人數檢查是算在最近幾輪上的,settle 模式沒有「最近幾輪」這個概念;"
                  "auditor 非空職能由 caught 定義收緊承接)", file=sys.stderr)
            return 2
        if not gate:
            print("擋下:--settle 要搭 --gate 一起用,不然沒有東西可判", file=sys.stderr)
            return 2
        if spec is None:
            print("擋下:--settle 一定要帶 --spec 指定被審的文件,每條收尾記錄和文件指紋都要跟現在的檔比對", file=sys.stderr)
            return 2
    if min_seats is not None and min_seats < 1:
        print(f"擋下:--min-seats 要填正整數(至少幾個人審),你給的是 {min_seats}", file=sys.stderr)
        return 2
    need = max(1, need)
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    n_badlines = 0
    bad_linenos = []   # disposal rc2 訊息用:壞行可一分鐘定位修復(r2 三席異議的降噪配套)
    try:
        if path.exists():
            for _ln, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    n_badlines += 1   # settle fail-closed 用;legacy/panel 維持容忍(行為不變)
                    bad_linenos.append(_ln)
                    continue
                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16):不計席、不判無效
                    rounds.append(d)
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
        return 2

    if roster:
        # [派工編制資料化] advisory 觀測——恆在各模式分支 early-return 之前印,rc 完全不動
        try:
            _roster_observe(env, loop_id, rounds, repo)
        except Exception as e:   # 觀測絕不擋閘:任何意外只降級為警告
            print(f"[roster] 提醒:派工名單對帳失敗,不影響過不過關: {e}")

    # 混用守衛(R2-F1 footgun):panel 記錄(有 round 欄)與 legacy 模式不可混用。
    # 用 all/any 而非單向 any:partial-mix(部分有 round、部分沒)也擋——否則 round-less
    # 記錄在 panel 模式會形成 None phantom 組、可能成「最新輪」偽過(review I1)。
    n_round = sum(1 for r in rounds if "round" in r)
    if panel and rounds and n_round != len(rounds):
        print("擋下:--panel 模式要求這個編號的每筆記錄都帶輪次,現在有記錄沒帶(混用或舊格式),不讀——不然會多算出一個不存在的 phantom 輪",
              file=sys.stderr)
        return 2
    if disposal:
        # 留痕解析根:預設=寫側同源的 _vault_repo_root(對稱);顯式 --repo 覆蓋
        # (r3 s2 席:git-less 部署副本裡 .git 不在,向上找會落錯根——給使用者一條明路)
        _dsp_root = Path(repo).resolve() if repo else _vault_repo_root(env)
        return _loop_status_disposal(rounds, loop_id, spec, n_badlines, _dsp_root,
                                     bad_linenos=bad_linenos, env=env, roster=roster, repo=repo)
    if not panel and n_round > 0:
        print("擋下:這個編號的記錄帶了輪次(多人審格式),但你沒加 --panel;不加的話一輪裡 W 個人的記錄會被當成 W 輪,所以不算",
              file=sys.stderr)
        return 2
    if settle is not None:
        return _loop_status_settle(rounds, n_badlines, loop_id, settle, spec, repo, env=env)
    if panel:
        try:
            return _loop_status_panel(rounds, loop_id, min_seats=min_seats, spec=spec, env=env)
        except OSError as e:   # G3 --spec 不可讀:與 legacy G1 對稱 rc2(code-loop r2 折入)
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2

    # ── M1包 #2:light K=1 謂詞(loop機械脊椎M1包_計劃;hash 強制 fail-closed) ──
    if light:
        if spec is None:
            print("擋下:--light 一定要帶 --spec 指定被審的文件,沒有對象就沒辦法驗文件有沒有被改", file=sys.stderr)
            return 2
        # ratchet 最先:任一 caught/none 筆 severity≥major → 永久 FAIL(missed 筆不觸發;
        # none=協議停用制的無植入輪——不納會使停用後 major 輪失去永久升級,閘變寬鬆)
        if any(r.get("kind") in ("caught", "none") and r.get("severity") in ("major", "blocker") for r in rounds):
            print(f"⛔ LIGHT GATE FAIL({loop_id}):曾經有一輪抓到 major 以上的問題,light 這個最寬鬆的規則從此永久失效(ratchet),"
                  "之後再乾淨的輪也洗不回來。開新的審查編號(原編號加 -std)換嚴格規則接著審")
            return 1
        if not rounds:
            print(f"⏳ 無記錄({loop_id} 目前一筆記錄都還沒有)")
            return 1
        last = rounds[-1]
        fails = []
        if last.get("kind") not in ("caught", "none"):
            fails.append("retryable——末輪 missed(判決不採信;light cap=2 內可重試)")
        if last.get("severity") not in ("clean", "minor"):
            fails.append(f"severity={last.get('severity')} 不在 {{clean,minor}}")
        sev, f = last.get("severity"), last.get("findings")
        if f is None or (sev == "clean" and f != 0) or (sev == "minor" and f < 1):
            fails.append(f"欄位互證矛盾:severity={sev} 與 findings={f} 不相容")
        try:
            err, info = _hash_chain_check([[last]], spec)
        except OSError as e:   # 與 legacy G1 對稱 rc2(code-loop r2 折入)
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2
        if err:
            fails.append(err)
        elif info == "unbound":
            fails.append("hash 未綁(light 強制 fail-closed:record 須帶 --spec/--reviewed)")
        if min_seats and len({a for r in [last] if (a := r.get("auditor"))}) < min_seats:
            fails.append(f"席數不足(min-seats={min_seats};空 auditor 不計席——code-loop r1 折入)")
        for line in _cost_summary(rounds):
            print(line)
        if fails:
            print(f"⛔ LIGHT GATE FAIL({loop_id} 沒通過,卡在):" + "；".join(fails))
            return 1
        print(f"✅ LIGHT GATE PASS({loop_id} 通過:單人審完、沒有中等以上問題、記錄互相對得上、文件沒被事後改過)")
        _loop_gov_mark(env, loop_id, "converged", "gate PASS")
        return 0

    def good(r):
        return r.get("kind") in ("caught", "none") and r.get("severity") in ("clean", "minor")

    converged = len(rounds) >= need and all(good(r) for r in rounds[-need:])
    streak = 0                                  # 從尾往回的連續合格數(算「還需 N」)
    for r in reversed(rounds):
        if good(r):
            streak += 1
        else:
            break
    if not gate:
        if converged:
            print(f"✅ CONVERGED({loop_id} 連續 {need} 輪審完且乾淨,判定收斂;總共跑了 {len(rounds)} 輪)")
            rc = 0
        else:
            print(f"⏳ 還需連續 {need - streak} 輪乾淨才算收斂({loop_id} 目前跑了 {len(rounds)} 輪)")
            rc = 1
        for i, r in enumerate(rounds, 1):       # 留痕:每輪一行 tab 分隔
            print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
        for line in _cost_summary(rounds):
            print(line)
        return rc

    # ── 證據閘(--gate):K-streak(必要)∧ G1 refcheck(--spec 可選)∧ G2 發現枯竭 ──
                cands.append(rel)
                break
    if not cands:
        return {"query": query, "queried": True, "nodes": []}
    src_norm = str(source)   # 呼叫端已是 stem;再 .stem 會把 v1.1轉正 截成 v1(r1 正確性席 C-2)
    scored = _rank_score_candidates(env, query, cands)[:top]
    nodes = []
    for rel, _score, _hits in scored:
        st, dec = _el_node_meta(env, rel)
        stem = Path(rel).stem
        nodes.append({"name": stem, "status": st, "decisions": dec,
                      "near_name": _el_near_name(stem, src_norm),
                      "gist": _gist(env, rel)})
    return {"query": query, "queried": True, "nodes": nodes}


def cmd_loop_next(env, loop_id, tier=None, as_json=False, need=2, spec=None, repo=None, orchestrator=None):
    """M1包 #1(loop機械脊椎M1包_計劃):帳本吐唯一下一動作。唯讀指針——lumos 不 spawn agent,
    編排仍是 Claude(Systems/design-loop 分工)。phase 五值:escalate/gate-pending/converged/
    cap-reached/plant-canary;判定優先序=escalate→gate-pending(資訊不足,先於 cap)→converged
    (僅 full-basis)→cap-reached→plant-canary。converged=rc0/其餘 phase=rc1/錯誤=rc2。
    tier 定錨優先:帳面首個帶 tier 記錄定錨;僅無定錨舊帳按格式推導;零記錄 rc2 要 --tier。"""
    import json as _json
    import io
    import contextlib
    path = env.vault.parent / ".canary-log.jsonl"
    try:
        rounds = _loop_records(env, loop_id, strict=True)   # 單一讀法(架構席 s2 r1 major:曾與 helper 逐行重複)
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
        return 2
    n_round = sum(1 for r in rounds if "round" in r)
    if rounds and n_round not in (0, len(rounds)):
        print("擋下:這個審查編號的記錄有的帶輪次、有的不帶,格式前後不一致,沒辦法判斷收斂。打開審查記錄檔 .canary-log.jsonl,把這個編號的每一筆格式改一致", file=sys.stderr)
        return 2
    panel_fmt = n_round > 0
    if panel_fmt:   # 讀側損壞守衛不得因缺 --spec 提前 return 而繞過(code-loop r2 折入)
        seen, cur_rid = set(), None
        for r in rounds:
            rid = r["round"]
            if rid != cur_rid:
                if rid in seen:
                    print(f"擋下:第 {rid!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),這本帳只能照時間往後加,順序亂了就沒辦法判斷收斂。檢查 .canary-log.jsonl 裡這個編號的寫入順序",
                          file=sys.stderr)
                    return 2
                seen.add(rid)
                cur_rid = rid
    # ── tier 解析:定錨優先(v8);僅無定錨舊帳按格式推導;零記錄 rc2 ──
    anchor = _loop_anchor_tier(rounds)
    if tier and anchor and tier != anchor:
        print(f"擋下:你這次指定的分級是 {tier},但這個審查編號第一筆記錄就定成 {anchor} 了。分級第一筆定下就不能中途換——要換請開新的審查編號", file=sys.stderr)
        return 2
    eff_tier = anchor or tier
    # ── d4 編排者:首輪必帶(比照 --tier),不給預設;帳面定錨後要一致 ──
    orch_anchor = _loop_orchestrator(rounds)
    if orchestrator is not None and orchestrator not in LOOP_ORCHESTRATORS:
        print(f"擋下:--orchestrator 只能是 {'/'.join(LOOP_ORCHESTRATORS)} 之一,你給的是 {orchestrator!r}", file=sys.stderr)
        return 2
    if orchestrator and orch_anchor and orchestrator != orch_anchor:
        print(f"擋下:這個審查編號帳面定的編排者是 {orch_anchor},你這次說 {orchestrator}——中途換家帳就對不上,要換請開新編號", file=sys.stderr)
        return 2
    _orchs = _loop_orchestrators(rounds)
    if len(_orchs) > 1:
        print(f"擋下:這個審查編號帳面記的編排者不一致({'/'.join(sorted(_orchs))}),帳本矛盾、沒辦法判外家是誰——打開 .canary-log.jsonl 把該編號的 orchestrator 欄改一致(帳不可撤,或換新編號重記)", file=sys.stderr)
        return 2
    if rounds and orch_anchor is None and orchestrator and orchestrator != "claude":
        print(f"擋下:這個審查編號是沒記編排者的舊帳,讀側一律視為 claude 編排;要用 {orchestrator} 編排請開新編號(舊帳中途改分家會讓前幾輪的外家判定全變)", file=sys.stderr)
        return 2
    if not rounds and orchestrator is None:
        print("擋下:這是全新的審查編號,第一次呼叫要帶 --orchestrator claude|codex 說清楚是誰在編排(外家席=不是編排者那一家;"
              "工具不預設 claude——Codex 編排時漏了會靜默套錯家族)。之後記帳 `canary record … --orchestrator <同值>` 定錨", file=sys.stderr)
        return 2
    eff_orch = orch_anchor or orchestrator or "claude"
    if eff_tier is None:
        if not rounds:
            print("擋下:這是全新的審查編號,還沒有任何記錄,工具不會幫你猜分級(猜錯之後格式兜不起來反而卡住)。第一次呼叫請加 --tier 指定分級", file=sys.stderr)
            return 2
        eff_tier = "standard" if panel_fmt else "legacy"   # 無定錨舊帳 fallback
    width, cap = _TIER_PARAMS[eff_tier]
    light = eff_tier == "light"
    # seq=循序 code loop(skill 設計行為:code 的 standard 走單 reviewer 循序;
    # 2026-08-18 循序codeloop-tier錨定案——not panel_fmt 是硬規格,code+standard 的 panel 帳照 panel 樣式走)
    seq = (eff_tier == "standard" and _roster_kind(loop_id) == "code" and not panel_fmt)
    if seq:
        width = 1   # 單 reviewer;cap 沿 _TIER_PARAMS["standard"][1]=3(分量本就正確,不另覆寫)
    # ── tier↔格式一致性(code-loop r1 折入:格式推導可被繞——high 漏帶 --round 會走鬆的 legacy 閘;
    #    2026-08-18 放寬單一象限:code∧standard∧無round=循序設計行為,不再誤擋——歷史三個循序 loop
    #    因此被迫落 legacy cap6,見 Issues/loop-next吐不可宣告的tier) ──
    if rounds:
        if eff_tier in ("standard", "high") and not panel_fmt and not seq:
            print(f"擋下:{eff_tier} 這個分級規定每筆記錄都要帶輪次(--round),但這個編號目前的記錄全都沒帶,兩邊對不上。"
                  "之後記錄請帶 --round;如果一開始分級就選錯,請開新的審查編號", file=sys.stderr)
            return 2
        if light and panel_fmt:
            print("擋下:light 分級只能用單人、不分輪次的記錄,但這個編號的記錄帶了輪次(--round),兩邊對不上。確認分級選對了沒;選錯請開新的審查編號", file=sys.stderr)
            return 2
    rounds_count = len({r["round"] for r in rounds}) if panel_fmt else len(rounds)
    n_next = rounds_count + 1

    def emit(phase, extra=None):
        out = {"phase": phase, "tier": eff_tier, "orchestrator": eff_orch, "round": n_next, "width": width,
               "min_seats": width, "cap": cap, "advisory": "分級由編排者第一筆記錄時宣告、之後定死;工具只照分級查表,不自己判斷"}
        _roster, _rnote = _roster_next_payload(loop_id, eff_tier)
        # JSON 消費者也要拿到相對家族(code-codex-s2 r1 單reviewer F2):不改 family 欄(_TIER_ROSTER 契約),加 relative_family 與 orchestrator;複製一份別動共用表
        if _roster is None:
            out["roster"] = None
        else:
            out["roster"] = {k: v for k, v in _roster.items() if k != "seats"}
            out["roster"]["orchestrator"] = eff_orch
            out["roster"]["seats"] = [dict(s, relative_family=("同門" if s.get("family") == "claude" else "外家" if s.get("family") == "external" else s.get("family"))) for s in _roster.get("seats", [])]
        if _rnote:
            out["roster_note"] = _rnote
        if phase == "plant-canary":
            # 型別派工當下隨機抽(2026-08-06 S2 同場補,plan:驗證層自證三件):固定輪替
            # =可猜=答案印在考卷背面(該 plan r1 審計語);同輪 slot 間仍不重複(width≤4 時
            # 全 distinct;width>4 以重洗批次延續,重複最少化)——冗餘 canary 不算獨立注意力票。
            import random
            if light or eff_tier == "legacy" or seq:
                out["canary_type"] = random.choice(_CANARY_TYPES)
            else:
                pool = []
                while len(pool) < width:
                    pool.extend(random.sample(_CANARY_TYPES, len(_CANARY_TYPES)))
                out["canary_type"] = {f"slot{i}": pool[i - 1] for i in range(1, width + 1)}
            rmode = "" if (light or eff_tier == "legacy" or seq) else f" --round r{n_next}"
            # ★`legacy` 不是可宣告值,不得吐進 record_cmd★(2026-08-04):`--tier` 的 choices
            # 只有 light/standard/high(LOOP_TIERS),legacy 純粹是「無定錨舊帳 + legacy 格式」
            # 的推導結果。原本這裡無條件吐 `--tier {eff_tier}`,legacy 下等於★發一條 argparse
            # 當場擋掉的指令★;而使用者最自然的修復是「把 --tier 拿掉再跑一次」——拿掉就記不上
            # 定錨,下一輪 next 又推成 legacy、又吐一條跑不動的指令。
            # ★這個 bug 自己維持自己★:2026-08 三個走循序的 loop(code-slim-python /
            # code-teardown-windows / code-slim-handoff)全數 tier=None,即此循環的產物;
            # 其中 code-slim-python 吃到 legacy 的 cap 6(standard 是 3)才被逼停。
            # ★編號加 shell 引號★(代碼審 r3 資安 G1):loop_id 是自由字串,`code-x; touch … #` 原樣塞進
            # 這幾條每輪都印、照慣例原樣照抄的指令,`;` 之後就被當成指令跑;一般編號 shlex.quote 不加引號
            import shlex as _shlex
            _qid = _shlex.quote(loop_id)
            _tier_flag = f" --tier {eff_tier}" if eff_tier in LOOP_TIERS else ""
            _orch_flag = f" --orchestrator {eff_orch}"
            # ★用現行類別 none★:caught|missed 是 canary 植入協議的類別,2026-08-14 已停用(Systems/canary-audit d5),
            # 照抄舊模板等於教人記一筆已停用的帳;--snapshot:代碼審記帳從第一筆就要附審材,沒帶會被擋
            out["record_cmd"] = (f"lumos canary record none --loop {_qid}{rmode}"
                                 f" --auditor <席> --severity <s> --findings <M>"
                                 f" --report <席報告.md> --snapshot <凍結快照.md>"
                                 f" --spec <計劃節點.md> --reviewed <sha256>{_tier_flag}{_orch_flag}"
                                 f" --scope-lines <這輪審了幾行>")   # cb3 s3-f1:寫側 2026-08-26 起審查席必附報告,模板同步
            # [T5 design-loop重設計] 處置閘模板(選用;record_cmd 原樣保留給 code-loop/舊流程)
            if not light and eff_tier != "legacy":
                out["disposal_cmd"] = (
                    f"lumos canary record none --loop {_qid}{rmode}"
                    f" --auditor <席> --severity <s>"
                    f" --findings-set <id串> --folded-set <id串> --accepted-set <id串>"
                    f" --accept-reason <id=理由> --refuted-set none"
                    f" --report <席報告.md> --snapshot <凍結快照.md>"
                    f" --spec <計劃節點.md> --reviewed <sha256>{_tier_flag}{_orch_flag}")
                out["disposal_gate"] = f"lumos loop status {_qid} --disposal --spec <計劃節點.md> --repo <root>"
            if eff_tier == "legacy":
                if _roster_kind(loop_id) == "code":
                    # 循序codeloop-tier錨定案:standard 對 code 循序已格式相容,但補標=cap 陷阱——警告式,不邀請
                    out["tier_hint"] = (
                        "提醒:這個審查編號從沒指定過分級,現在用最寬鬆的舊規則在跑(單人審、最多 6 輪;正式的 standard 只給 3 輪)。"
                        "想中途改嚴:補 --tier high 會因格式不合直接被擋;補 --tier standard 格式相容,"
                        "但已經跑過的輪數會整批算進 3 輪上限,跑過 3 輪以上的一補標下一步就到頂。"
                        "要走嚴格規則,請開新的審查編號,並在第一筆記錄就帶 --tier。")
                else:
                    out["tier_hint"] = (
                        "提醒:這個審查編號從沒指定過分級,現在用最寬鬆的舊規則在跑(單人審、最多 6 輪),而且沒辦法事後補分級——"
                        "記錄格式已經定型(不帶輪次),補 --tier standard 或 high 會直接被擋;"
                        "--tier light 格式相容但只給 2 輪,跑過幾輪的通常一補就到頂。"
                        "要走嚴格規則,請開新的審查編號,並在第一筆記錄就帶 --tier。")
            # ★預防端:警告必須在派工「之前」★——記帳時才喊已經來不及(輪跑完了)。
            # loop next 是每輪第一步,所以量尺放這裡。
            out["scope_cap"] = (
                f"派工前先量這輪要審的東西有多少行(wc -l <工作副本或 patch>):超過 {_CANARY_SCOPE_SOFT_CAP_LINES} 行"
                "就拆開審——切成多輪,或分給多人各審一段。"
                "材料太長審查員會看不完、漏東西,這是外部研究的結論;"
                "本專案自己跑過三次對照實驗都量不到這個效應,所以別拿自家資料當佐證。"
                "超標不擋,但帳上會標成範圍過大、那輪抓到的結果算弱證據。")
        # ★cluster 帳的選擇只有第一輪能做★(2026-08-02):模式由「第一個有效輪」定錨,之後
        # 要換只能開新 loop id。而 M2 落地至今 316 筆 canary 記錄裡★只有 1 筆帶 clusters★,
        # 且那一筆是開發它的 code-m2cluster 自己——34 個 panel loop 中有 33 個靜默落回
        # 無-cluster 舊帳。根因不是機制不好,是★沒有任何地方在該選的時候提起它★。
        # 只在 N=1 提(那是選擇真正還開著的唯一時刻),避免對已定錨的 loop 噴無效噪音。
        if phase == "plant-canary" and not light and eff_tier != "legacy" and not seq and n_next == 1:
            out["cluster_hint"] = (
                "這是第一輪,要不要把發現分組追蹤只有現在能決定(第一個有效輪定下模式,之後要換只能開新編號):"
                "如果預期發現會散成性質不同的幾群(例如「規格縮水」和「邊界 bug」),"
                "記錄時加 --clusters '群名=resolved|accepted-minor:理由|disputed-major' 逐群追蹤,"
                "收斂改看「沒有爭議且嚴重的群」——不然不同性質的問題被壓成一個最高等級,一邊會蓋掉另一邊。"
                "單一主題、發現性質相同的用預設(不分組)就好。")
        # 圖譜入口栓 A(spec v3 EL-1):只在首輪+plant-canary、只掛正常 emit 出口;
        # --spec 有給→計劃檔名優先當查詢源,否則退編號(EL-3);fail-open:例外不得改 rc/既有輸出(EL-5)
        if phase == "plant-canary" and n_next == 1:
            try:
                # ★fail-open 鐵則:本 try 內禁止 sys.exit/SystemExit(except Exception 攔不到)★
                _rn0 = _el_related_nodes(env, Path(spec).stem) if spec else None
                if _rn0 is None or not _rn0["queried"]:
                    # r1 合約席 G-1+r2 delta D2-2:code loop 的 --spec 慣用值=凍結 patch(stem 如
                    # r1-snapshot→無訊號);spec 版查無訊號就一律改用編號版——spec 檔名是工具慣例名
                    # 非主題,其殘渣(snapshot)不得流進「要查自己跑」建議行
                    _rn0 = _el_related_nodes(env, loop_id)
                out["related_nodes"] = _rn0
            except Exception:
                pass
        # ★把「這個迴圈在審哪份東西」印出來★(2026-09-07,另一個 session 提的缺口:
        # 一個只拿到編號的新 session,loop next 給的東西已經夠它直接派工——現在狀態、
        # 分級、第幾輪、幾個人、五個席位各自的家族,全都有。★唯一斷掉的一步是「在審什麼」★,
        # 而那個資訊其實就在帳上,只是沒印出來,接手的人得自己去 tail 帳本。)
        #
        # ★取「最後一筆有值的」,不是「最後一筆」★:spec_path 是選配欄位,如果 r1 有記、
        # r2 沒記,取最後一筆會印「沒記」——而接手的人會誤解成「這個迴圈從來沒記過在審什麼」。
        # 兩種語意不能共用同一句話。(實測本庫 209 個迴圈:0 個落在這個差異上,
        # 兩種取法今天結果完全一致——但欄位是選配的,一致是現況不是保證,所以照安全的取。)
        #
        # ★措辭要帶輪次★:這裡說「接下來第 N 輪」,而帳上最後那筆是第 N-1 輪的材料。
        # 講成「這個迴圈在審 X」會讓人以為那就是下一輪要審的東西,而下一輪要自己凍一份新的。
        _sp_degraded = None
        try:
            _sp_rec = next((r for r in reversed(rounds)
                            if isinstance(r.get("spec_path"), str) and r["spec_path"].strip()), None)
            if _sp_rec:
                _sp = _sp_rec["spec_path"]
                # ★路徑要以「vault 所屬的 repo 根」為錨,不是 cwd★
                # (2026-09-07 代碼審 r1 外家否決席判 major,實測屬實:從 governance/ 底下
                #  不帶 --repo 呼叫,會對一個★確實存在★的檔案印「這個檔案現在不在了」
                #  ——正好是我想避免的「遞一條死路給人」的反面)。
                # _vault_repo_root 是這個 repo 既有的那支(從 vault 往上找 .git),
                # 判定閘的卷證解析用的也是它,不另寫一份。
                # ★連 .resolve() 都要跟既有那支一致★(代碼審 r1 架構對齊席:
                # 判定閘的解析根寫的是 `Path(repo).resolve() if repo else _vault_repo_root(env)`,
                # 而 _vault_repo_root 自己也是回 resolve 過的。少一個 resolve 就是第二套規則。)
                _root = Path(repo).resolve() if repo else _vault_repo_root(env)
                _sp_abs = Path(_sp) if Path(_sp).is_absolute() else (_root / _sp)
                out["reviewed_spec"] = {"path": _sp, "round": _sp_rec.get("round"),
                                        "exists": _sp_abs.exists(),
                                        "is_latest_round": _sp_rec is rounds[-1]}
        except Exception as _e:
            # ★不要謊稱「沒記」★(代碼審 r1 外家否決席 minor):壞掉的帳(spec_path 是 list/dict)
            # 會走到這裡,而文字模式接著會印「帳上沒記這個迴圈在審什麼」——那是假話,
            # 使用者分不出「真的沒記」和「記了但工具讀不動」。rc 不變,但要出聲。
            _sp_degraded = str(_e)
        if extra:
            out.update(extra)
        if as_json:
            print(_json.dumps(out, ensure_ascii=False))
        else:
            print(f"[next] {loop_id}:現在狀態 {phase},分級 {eff_tier},接下來第 {n_next} 輪,"
                  f"這輪要 {width} 人審,最多跑 {cap} 輪")
            if out.get("roster"):
                for s in out["roster"]["seats"]:
                    _fam = ("同門[" + out.get("orchestrator", "claude") + "]") if s['family'] == "claude" else ("外家(不是 " + out.get("orchestrator", "claude") + " 那一家)" if s['family'] == "external" else s['family'])
                    print(f"  應派: {s['slot']}(家族 {_fam},"
                          f"{'算' if s['occupies_w'] else '不算'}進人數,派工要求:{_REQUIREMENT_LABEL.get(s['requirement'], s['requirement'])})"
                          + (f" 備註:{s['note']}" if s.get("note") else ""))
            elif out.get("roster_note"):
                print(f"  應派: 目前算不出該派誰——{out['roster_note']}")
            # ★在審什麼★:排在席位之後、其他雜項之前——接手的人下一步就是去讀那份材料。
            if "reviewed_spec" in out:
                _rs = out["reviewed_spec"]
                _rd = f"第 {_rs['round']} 輪" if _rs.get("round") else "上一次"
                print(f"  帳上最後記到的審查材料({_rd}):{_rs['path']}"
                      + ("" if _rs["exists"] else "  ★這個檔案現在不在了★"))
                if not _rs.get("is_latest_round", True):
                    # ★不能說「用它判上一輪」★(代碼審 r1 外家否決席判 major):
                    # 最後一輪自己沒記材料時,這一筆是更早的輪次,拿它去判最後一輪是錯的輸入。
                    print(f"      ★但最後一輪自己沒記材料★——這一份是{_rd}的,不是最後一輪審的東西,"
                          "別拿它去判最後一輪")
                elif phase in ("plant-canary", "gate-pending"):
                    # ★只有「還會有下一輪」的狀態才講這句★(同席 major,實測:escalate 狀態下
                    # 會同時印「停掉這個編號」和「下一輪要自己凍一份新的」,兩句直接打架)。
                    print("      要判上一輪過不過關就用它;★下一輪要自己凍一份新的★,不是沿用這一份")
                else:
                    print("      這個編號沒有下一輪了(看下面的狀態說明),這一份留著當卷證")
            elif _sp_degraded:
                print(f"  帳上記了審查材料但讀不動({_sp_degraded})——不是「沒記」,是這本帳的那個欄位壞了")
            elif rounds:
                # ★沒有就明講,不要靜默省略★:省略的話接手的人分不出是「帳上沒記」
                # 還是「工具沒印」。spec_path 是後來才加的欄位,舊帳本來就沒有。
                print("  帳上沒記這個迴圈在審什麼(spec_path 是後來才加的欄位,舊帳沒有)")
            for k in ("canary_type", "record_cmd", "scope_cap", "cluster_hint", "note"):
                if k in out:
                    print(f"  {k}: {out[k]}")
            # 圖譜入口栓 A 文字段(spec EL-1/EL-16:專屬多行段,不塞五鍵白名單;三分支唯一化)
            try:
                if "related_nodes" in out:
                    _rn = out["related_nodes"]
                    if not _rn["queried"]:
                        _lt, _ = _el_query_tokens(_rn["query"])
                        if _lt:   # r1 正確性席 C-1:dref-v4 型「單字+版號」可查卻被閘掉——給出手動查詢的一行,不靜默丟失
                            print(f"  圖譜:編號主題訊號不足(清洗後只剩 {' '.join(_lt)}),沒自動查;要查自己跑:")
                            print(f"      lumos search \"{' '.join(_lt)}\"")
                        else:
                            print("  圖譜:編號無主題訊號,未查圖譜(帶 --spec <計劃筆記> 可用計劃檔名查)")
                    elif not _rn["nodes"]:
                        print(f"  圖譜:查過「{_rn['query']}」,圖譜這主題無既有節點")
                    else:
                        print(f"  圖譜既有節點(查:{_rn['query']}):")
                        for _nd in _rn["nodes"]:
                            print(f"    - {_nd['name']} [{_nd['status'] or '?'}] 決策 {_nd['decisions']} 條"
                                  + (" ★近名" if _nd["near_name"] else "")
                                  + (f" — {_nd['gist']}" if _nd.get("gist") else ""))
                        print("    先讀再開;近名者尤其要讀它的 decisions")
            except Exception:
                pass
        return 0 if phase == "converged" else 1

    # ⓪ escalate:light ratchet 永久態最先短路
    if light and any(r.get("kind") in ("caught", "none") and r.get("severity") in ("major", "blocker")
                     for r in rounds):
        return emit("escalate", {"note": "這個編號曾抓到 major 以上的問題,light 最寬鬆的規則從此失效——停掉這個編號,開新的(原編號加 -std)換嚴格規則接著審"})
    if not rounds:
        return emit("plant-canary")
    # ① gate-pending:判 converged 需 gate 結果,資訊不足絕不背書(先於 cap)
    if spec is None:
        # ★帳上有路徑就把指令補完★:接手的人最常卡在這一步——它說「少了 --spec」,
        # 但沒告訴你 spec 在哪。那個資訊就在帳上。
        # ★只有「最後一輪自己記了材料」才敢把指令補完★(代碼審 r1 外家否決席判 major):
        # 拿更早輪次的材料去判最後一輪是明確錯誤的輸入,不是保守退化。
        # ★型別要驗★(代碼審 r1 通才席附註:畸形帳(spec_path 是 list)會被直接塞進 f-string,
        # 印出 `--spec [1, 2, 3]` 這種不能執行的指令——不會炸,但「幫你補完指令」的承諾是空話)。
        _hint = rounds[-1].get("spec_path") if rounds else None
        if not isinstance(_hint, str) or not _hint.strip():
            _hint = None
        if _hint:
            # ★閘的模式與 repo 根都不准猜死★(同席 major):light 帳要 --light,
            # repo 根用 vault 往上找 .git 那支既有的,不是寫死 `.`(從子目錄呼叫就錯)。
            _mode = "--light" if light else "--disposal"
            try:
                _rr = str(Path(repo).resolve() if repo else _vault_repo_root(env))
            except Exception:
                _rr = "."
            import shlex as _shlex   # 代碼審 r3 資安 G1:補完的指令要能照抄,編號與路徑都加引號
            return emit("gate-pending", {"note": f"少了 --spec,沒辦法判斷過不過關。帳上記的材料是 {_hint},"
                                                 f"直接用:lumos loop status {_shlex.quote(loop_id)} {_mode} --spec {_shlex.quote(_hint)} --repo {_shlex.quote(_rr)}"
                                                 f"(2026-08-25 以前定錨的舊 panel 帳要改用 --gate --panel)"})
        _older = next((r["spec_path"] for r in reversed(rounds)
                       if isinstance(r.get("spec_path"), str) and r["spec_path"].strip()), None)
        if _older:
            return emit("gate-pending", {"note": "少了 --spec,沒辦法判斷過不過關。"
                                                 f"★最後一輪沒記材料★(更早的輪次記過 {_older},但那不是這一輪審的東西),"
                                                 "所以指令補不完——要自己找出這一輪的材料再帶 --spec"})
        return emit("gate-pending", {"note": "少了 --spec,沒辦法判斷過不過關——用 lumos loop status <編號> --gate 帶完整參數自己判"
                                             "(帳上也沒記這個迴圈在審什麼,要自己找)"})
    # ② full-basis gate 委派(靜默跑既有謂詞,零新判定邏輯)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
        rc = cmd_loop_status(env, loop_id, need=(1 if light else need), gate=True,
                             spec=spec, repo=repo, panel=(panel_fmt and not light),
                             light=light, min_seats=width)   # 恆傳(light/legacy=1;code-loop r1 折入)
    if rc == 2:
        sys.stderr.write(buf.getvalue())
        return 2
    if rc == 0:
        _loop_gov_mark(env, loop_id, "converged", "loop next 判四關全過")
        return emit("converged", {"gate_basis": "四關全過(連續乾淨輪數、引用對得上、問題數遞減、文件沒被改過)"})
    # ③ cap(資訊充分且未 PASS)
    if rounds_count >= cap:
        _loop_gov_mark(env, loop_id, "cap-reached", f"cap={cap} tier={eff_tier}")
        return emit("cap-reached", {"note": f"跑滿 {cap} 輪還沒收斂——停下來,剩下的交給人裁決,別無限燒下去"})
    # ④ plant-canary
    return emit("plant-canary")


# ───────────── guard: 合約守衛 scaffold(對談驅動)─────────────
# lumos 只做機械活:① 列出 ★INVARIANT★ 綁定狀態 ② 套範本產 stub(預設紅燈) ③ 把 [test:] 綁回 KEY 行(自驗)。
# 「斷言本體」由 Claude 經對談向人確認意圖後填 — claim 的真來自人確認,不來自 code 反推
# (反推=套套邏輯=Check T 在打的偽證據)。範本是技術棧專屬、放專案 .lumos/guard-templates/<type>.tmpl,
# lumos 本體維持語言無關。
GUARD_TYPES = ("pure", "behavioral", "state")
GUARD_ICON = {"real": "✅ 已綁真方法", "dangling": "❌ 懸空(找不到方法)",
              "fake": "⚠ 偽證據(非測試方法)", "naked": "❌ 裸合約(未綁)"}


def _repo_root_from_env(env):
    for p in env.vault.parents:
        if p.name == "docs":
            return p.parent
    return env.vault.parent  # standalone vault root


def _platform_test_index(repo_root):
        return None
    hay = _quote_norm(stext)
    hay_ns = hay.replace(" ", "")
    rows = []
    for q in quotes:
        nq = _quote_norm(q)
        too_short = len(nq) < _QUOTE_MIN_NORM_LEN
        # CJK 折行 fallback(Landmark 真場實測):快照句中折行使 norm 後多一個空格,
        # 連續引句子字串必 miss——空白全剝再比一次(存在性檢查,黏合誤中風險可忽略:
        # 引句有 10 字下限,跨句黏合要恰好湊出同字序)
        anchored = nq in hay or nq.replace(" ", "") in hay_ns
        rows.append({"quote": q, "ok": (not too_short) and anchored,
                     **({"too_short": True} if too_short else {})})
    for _ in range(n_markers - len(quotes)):
        rows.append({"quote": "(引號未閉合/開閉型態不符,無法抽取)", "ok": False, "malformed": True})
    return rows


# ═══ 處置閘「資安席」一步(Projects/代碼審資安席_計劃,2026-09-11 Enzo 裁 d6)═══
# 高風險代碼審一律必派一席資安;編制表上 requirement=required-gated 的席,出席與否由這一步硬擋。
_REQUIREMENT_LABEL = {"required-gated": "必派(問閘會擋)"}   # loop next 人讀輸出用;--json 仍給原值
# 席名怎麼認:用連字號切段,任一段完全等於席位名或別名即算(英文不分大小寫)。只有人裁能加一個 required-gated 席。
_GATED_SEAT_ALIASES = {"資安": ("資安", "security")}


def _loop_anchor_tier(rounds):
    """迴圈的定錨分級:帳上第一筆帶 tier 的值。loop next 與處置閘資安席一步呼叫同一支——
    寫帳那側不擋中途改 tier,改用「任一筆 high」會對一個從沒被派過 high 編制的迴圈要求資安席(r1 邊界 B3)。"""
    return next((r["tier"] for r in rounds if r.get("tier")), None)


def _auditor_matches_slot(auditor, slot):
    """這個席名坐的是不是這個席位:連字號切段,任一段(去頭尾空白)完全等於席位名或別名即算,英文不分大小寫。
    ★整段相等,不是子字串★:「資安審-sonnet」「非資安-sonnet」不算;模型名自己帶連字號(資安-gpt-5.6-terra)、
    前面帶席號(s4-資安-sonnet)都算。原本「取最後一個連字號前那段」會把多連字號的真實命名判錯
    (帳上 308 個席名有 109 個帶兩個以上連字號;r1 邊界 B1、整合 C1)。"""
    if not isinstance(auditor, str) or not auditor.strip():
        return False
    names = {a.casefold() for a in _GATED_SEAT_ALIASES.get(slot, (slot,))}
    return any(seg.strip().casefold() in names for seg in auditor.split("-"))


def _git_unquote_path(s):
    """還原 git 在 diff 檔頭替路徑加的 C 式引號。core.quotePath 預設開:中文等非 ASCII 會寫成
    `"a/docs/\\344\\270\\255.md"` 這種八進位跳脫。沒加引號的原樣回。
    ★為什麼 lumos 自己呼叫 git 時用 -c core.quotePath=false、這裡卻要還原★(代碼審 r1 架構對齊 B1):
    專案慣例是從源頭關掉跳脫(本檔各處 git 呼叫都這樣做,代碼審 SKILL 的凍結指令也已補上同一個旗標);
    但凍結 patch 是編排者自己下指令產的輸入檔,舊迴圈、別家編排者、忘了帶旗標的都會帶引號——
    判不準就會把同一支檔當兩支、或把兩支當同一支,所以讀這種輸入時要容錯,不是另一套產生方式。
    ★只去掉行尾換行,不削空白★(r1 外家否決 E1):檔名尾端的空白是檔名的一部分,
    削掉會把「app/login.py」與「app/login.py 」併成一支,資安席只看過前者也能讓後者過關。"""
    s = s.rstrip("\r\n")
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        import codecs
        try:
            return codecs.escape_decode(s[1:-1].encode("latin-1", "backslashreplace"))[0].decode("utf-8", "surrogateescape")
        except Exception:
            return s[1:-1]
    return s


def _patch_files_from_text(text):
    """凍結 patch 改到哪些檔(集合)。檔名判法見 _patch_file_changes。"""
    return set(_patch_file_changes(text))


def _patch_file_changes(text):
    """凍結 patch 裡每支檔的「改動指紋」:{檔名: sha256}。
    檔名:每段 `diff --git` 在第一個 `@@` 之前依序取 `+++ b/…`(不是 /dev/null)→ `rename to …` → `--- a/…`(刪檔)
    → `diff --git` 行本身 b/ 那側;hunk 內容裡剛好長得像檔頭的行不算。既有的 _delguard_parse_diff 只用
    「 b/(.+)$」抓、不處理引號,所以不能直接拿來用。
    ★指紋算 hunk 的內容,不算位置★(代碼審 r1 通才 A1/資安 C1;r3 外家否決改):hunk 裡的增刪行與上下文行、
    `@@` 後面的段落標頭(函式名),加上 mode/新增刪除/改名/二進位這幾種檔頭;不算 `@@` 的行號與 `index` 那行——
    只差行號(rebase 常見)還算同一版。原本只比檔名,同一支檔換成含後門的內容照樣算「資安席看過」;
    r1 改成只算增刪行之後,同一段 `-check(user)/+allow(user)` 從公開端點搬到管理員端點指紋完全相同(r3 外家 Codex 實測),
    所以上下文與段落標頭也要算。代價:rebase 之後這段附近的程式也變了,資安席要對最新版再看一次(誤擋方向)。
    ★二進位檔例外★(代碼審 r2 通才 F1):二進位檔沒有增刪行,內容變化只在 `index 舊..新` 的「新」那一半
    (改動後的版本雜湊)與 `GIT binary patch` 資料行——這兩樣要算進去,否則換掉整個二進位檔指紋也不變。
    文字檔不算 index,因為 rebase 會讓它變、改動本身卻沒變。"""
    import hashlib
    files, cur, in_hunk = {}, None, False
    _HDR_KEEP = ("old mode ", "new mode ", "new file mode ", "deleted file mode ", "rename from ", "rename to ",
                 "Binary files ", "copy from ", "copy to ")

    def _strip(p, pre):
        p = _git_unquote_path(p.split("\t", 1)[0])
        return p[len(pre):] if p.startswith(pre) else p

    def _flush():
        if cur:
            name = cur.get("plus") or cur.get("rename") or cur.get("minus") or cur.get("hdr")
            if name:
                chg = cur["chg"] + ([f"post-blob {cur['post']}"] if cur.get("bin") and cur.get("post") else [])
                h = hashlib.sha256("\n".join(chg).encode("utf-8", "surrogateescape")).hexdigest()
                files[name] = h

    for ln in text.splitlines():
        if ln.startswith("diff --git "):
            _flush()
            rest, hdr = ln[len("diff --git "):], None
            if rest.endswith('"'):
                k = rest.rfind(' "b/')
                if k >= 0:
                    hdr = _strip(rest[k + 1:], "b/")
            else:
                k = rest.rfind(" b/")
                if k >= 0:
                    hdr = rest[k + 3:]
            cur, in_hunk = {"hdr": hdr, "chg": [], "bin": False, "post": None, "binpatch": False}, False
            continue
        if cur is None:
            continue
        if cur["binpatch"]:
            cur["chg"].append(ln)   # GIT binary patch 的資料行就是內容
            continue
        if in_hunk:
            if ln[:1] in ("+", "-", " ", "\\"):
                cur["chg"].append(ln)   # 增刪行、上下文行、「\ No newline」都是內容
            elif ln.startswith("@@"):
                cur["chg"].append("@@" + ln.split("@@", 2)[-1])   # 行號不算、段落標頭(函式名)算
            continue
        if ln.startswith("@@"):
            in_hunk = True
            cur["chg"].append("@@" + ln.split("@@", 2)[-1])   # 第一段的段落標頭也算
        elif ln.startswith("index ") and ".." in ln:
            cur["post"] = ln[len("index "):].split("..", 1)[1].split(" ", 1)[0]
        elif ln == "GIT binary patch":
            cur["bin"] = cur["binpatch"] = True
        elif ln.startswith(_HDR_KEEP):
            if ln.startswith("Binary files "):
                cur["bin"] = True
            cur["chg"].append(ln)
            if ln.startswith("rename to "):
                cur["rename"] = _git_unquote_path(ln[len("rename to "):])
        elif ln.startswith("+++ ") and ln[4:].strip() != "/dev/null":
            cur["plus"] = _strip(ln[4:], "b/")
        elif ln.startswith("--- ") and ln[4:].strip() != "/dev/null":
            cur["minus"] = _strip(ln[4:], "a/")
    _flush()
    return files


def _prov_check(r, key, prov_path):
    """單一帳列的一份留痕(key=report_path/snapshot_path/intake_path)還對不對得上。
    回 (狀態, 路徑):ok / missing(帳上沒帶)/ unreadable(讀不到)/ mismatch(sha 與帳面不符=事後被改)。
    處置閘的留痕重驗與資安席一步共用這一支,不各抄一份(r1 前掃 ④b)。"""
    pth = r.get(key)
    if not pth:
        return "missing", None
    try:
        got = _sha256_file(prov_path(pth))
    except OSError:
        return "unreadable", pth
    return ("ok" if got == r.get(key.replace("_path", "_sha256")) else "mismatch"), pth


def _gated_seats_for(rounds, loop_id):
    """資安席這一步對這個迴圈適不適用。回 (狀態, 說明, 席位清單):
    skip(不是代碼審 / 定錨分級的編制表沒有 required-gated 席 / 首筆帳早於生效日)、
    fail(帳上 ts 讀不動——判不了新舊迴圈,壞資料不放行,同 _disposal_clause_step)、apply(要檢查)。"""
    kind = _roster_kind(loop_id or "")
    if kind == "design":
        return "skip", "設計審不要求資安席——設計審編制不加", []
    # kind is None:編號 code 開頭卻不是 code-,看不出種類 → 照最嚴的當代碼審(代碼審 r1 通才 A2:
    # 原本整步跳過,換個名字就繞過;條款綁定那一步對同一種編號也是照它自己最嚴的方向判)
    tier = _loop_anchor_tier(rounds)
    entry = _TIER_ROSTER.get(("code", tier))
    slots = [s["slot"] for s in (entry or {}).get("seats", []) if s.get("requirement") == "required-gated"]
    if not slots:
        return "skip", f"定錨分級 {tier or '沒指定'},編制表沒有必派而且會擋的席", []
    keys = [(_loop_ts_key(str(r.get("ts", ""))), str(r.get("ts", ""))) for r in rounds if r.get("ts")]
    if any(k is None for k, _ in keys):
        bad = next(x for k, x in keys if k is None)
        return "fail", f"帳上有一筆 ts 讀不動或沒帶時區({bad!r}),判不了是不是生效日後開的迴圈;壞資料不放行", []
    if keys and min(k for k, _ in keys) < _loop_ts_key(_SECURITY_SEAT_SINCE):
        return "skip", f"迴圈首筆帳 {min(keys)[1][:19]} 早於生效日 {_SECURITY_SEAT_SINCE[:10]},不回溯", []
    return "apply", "", slots


def _gated_seat_rows(rounds, loop_id):
    """適用時,帳上坐 required-gated 席的那些帳列(凍結閉包要把它們的報告與凍結 patch 一起收)。"""
    st, _why, slots = _gated_seats_for(rounds, loop_id)
    if st != "apply":
        return []
    return [r for r in rounds if any(_auditor_matches_slot(r.get("auditor"), s) for s in slots)]


def _disposal_security_step(rounds, rid, loop_id, prov_path):
    """處置閘第六步「資安席」(第五步是條款綁定):回 "fail" / "ok" / "skip",自己印 [disposal] 資安席 那幾行。
    定錨 high、生效日後的代碼審,編制表上每個 required-gated 席:①整個迴圈有它的帳(席名判法見 _auditor_matches_slot)
    ②那筆的報告與凍結 patch 還在、sha 對 ③它看過的檔(凍結 patch 檔案清單聯集)涵蓋判定輪全部檔。
    看整個迴圈不是每一輪(判定輪常是只派一席的 delta 輪)。凍結/回放模式照樣重讀檔——凍結閉包也收了這些檔,
    所以即時判不過的,凍結重算也判不過(r1 外家否決 E2)。"""
    st, why, slots = _gated_seats_for(rounds, loop_id)
    if st == "skip":
        print(f"[disposal] 資安席: —({why})")
        return "skip"
    if st == "fail":
        print(f"[disposal] 資安席: ✗ — {why}")
        return "fail"
    judge = [r for r in rounds if r.get("round") == rid]
    if not judge and isinstance(rid, str) and rid.startswith("__seq"):
        # 不帶 --round 的迴圈:判定輪是讀側合成的 __seqN(逐筆自成一輪),帳上 round 欄是 None,拿 rid 比永遠比不中
        # → 原本判定輪抓不到檔名、恆判不過、訊息還講成材料放錯(代碼審 r3 編排者自找)。混帶/不帶輪次在上游就擋,這裡全是不帶的
        judge = [r for r in rounds if r.get("round") is None][-1:]
    jchg, junread = {}, []
    for sp in sorted({r.get("snapshot_path") for r in judge if r.get("snapshot_path")}):
        try:
            jchg.update(_patch_file_changes(prov_path(sp).read_text(encoding="utf-8", errors="replace")))
        except OSError:
            junread.append(sp)
    jfiles = set(jchg)
    _odd_id = _roster_kind(loop_id or "") is None
    verdict = "ok"
    for slot in slots:
        rows = [r for r in rounds if _auditor_matches_slot(r.get("auditor"), slot)]
        if not rows:
            seen = sorted({r.get("auditor") for r in rounds if r.get("auditor")})
            print(f"[disposal] 資安席: ✗ — 這個迴圈沒有「{slot}」席的帳(高風險代碼審必派,而且問閘會擋)"
                  + ("——編號 code 開頭卻不是 code-,看不出是哪一種審查,照最嚴的當代碼審" if _odd_id else ""))
            print(f"  帳上出現過的席名:{'、'.join(seen) if seen else '(無)'}——席名要有一段是「{slot}」,例如 {slot}-sonnet")
            print("  在意的原因:高風險代碼審一律要有一席站在攻擊者那邊看過這份改動(2026-09-11 人裁);沒有它,能被利用的洞沒人負責找。")
            print("  接下來:派一席資安(派工用 lumos-design-loop templates.md §7.8);已經審過、只是席名寫錯的,用正確席名把同一份報告補記一筆:")
            import shlex as _shlex   # 代碼審 r2 資安 G3:編號原樣塞進建議指令,照抄執行會被當成 shell 語法
            print(f"    lumos canary record none --loop {_shlex.quote(loop_id)} --round <那一輪> --auditor {slot}-<模型> --severity <最高> "
                  "--findings <條數> --report <報告> --snapshot <那一輪凍結 patch> --spec <那一輪凍結 patch> --reviewed <sha256>")
            verdict = "fail"
            continue
        good, bad = [], []
        for r in rows:
            probs = []
            for label, key in (("報告", "report_path"), ("凍結 patch", "snapshot_path")):
                pst, pth = _prov_check(r, key, prov_path)
                if pst != "ok":
                    probs.append({"missing": f"{label}沒記", "unreadable": f"{label}讀不到({pth})",
                                  "mismatch": f"{label} sha256 與帳面不符(事後被改)"}[pst])
            (bad if probs else good).append((r, probs))
        if not good:
            print(f"[disposal] 資安席: ✗ — 「{slot}」席的帳在,但留痕對不上:"
                  + ";".join(f"{r.get('round')} {r.get('auditor')} {'、'.join(p)}" for r, p in bad))
            print("  在意的原因:報告不在或事後被改,就證明不了那一席真的看過、看的是哪一版。")
            print("  接下來:找回原檔;找不回就重派一席資安再記帳。")
            verdict = "fail"
            continue
        if junread or not jfiles:
            print("[disposal] 資安席: ✗ — 判定輪的凍結 patch 讀不到或抓不到任何檔名"
                  + (f"({'、'.join(junread)})" if junread else "") + ",沒辦法確認資安席看過的檔有沒有涵蓋最後一版;看不懂就不放行")
            print("  在意的原因:代碼審的凍結材料應該是整條分支的 diff(git diff <merge-base>..HEAD);抓不到檔名多半是材料放錯了。")
            verdict = "fail"
            continue
        seen = {}
        for r, _p in good:
            for f, h in _patch_file_changes(prov_path(r["snapshot_path"]).read_text(encoding="utf-8", errors="replace")).items():
                seen.setdefault(f, set()).add(h)
        unseen = sorted(f for f in jfiles if f not in seen)
        changed = sorted(f for f in jfiles if f in seen and jchg[f] not in seen[f])
        if unseen or changed:
            parts = []
            if changed:
                parts.append(f"{len(changed)} 支的內容跟資安席看的不一樣(之後又改過):" + "、".join(changed[:10])
                             + ("…" if len(changed) > 10 else ""))
            if unseen:
                parts.append(f"{len(unseen)} 支資安席沒看過:" + "、".join(unseen[:10]) + ("…" if len(unseen) > 10 else ""))
            print("[disposal] 資安席: ✗ — 最後一版改到的檔," + ";".join(parts))
            print("  在意的原因:資安席看的是早一輪的材料;之後新碰到或又改過的檔,沒有人從攻擊者角度看過最後的樣子。")
            print(f"  接下來:對最新的凍結 patch 再派一席資安,記帳席名用 {slot}-<模型>。")
            verdict = "fail"
            continue
        r0 = good[0][0]
        print(f"[disposal] 資安席: ✓ — {r0.get('round')} {r0.get('auditor')}(看過的檔涵蓋最後一版 {len(jfiles)} 個)")
    return verdict


def _disposal_clause_step(rows, spec, root, env, loop_id="", spec_sha_override=None):
    """處置閘第五步(條款綁測試算進度 [S3]):回 "fail" / "ok" / "skip",自己印一行 [disposal] 條款綁定。
    skip 四種:①凍結/回放模式(spec_sha_override 有值,對凍結 sha 判、不重讀活檔)②迴圈類型是 code(loop id 前綴 code-,同 _roster_kind;
    code 開頭但不是 code- 的一律當設計審,fail-closed;不看副檔名——外家席:.patch 跳過只看尾碼會被設計審拿 patch 當審材繞過)
    ③迴圈首筆帳早於 _CLAUSE_GATE_SINCE(不回溯)④計劃無 [SN](opt-in 未啟用)。
    fail 六種:設計審審材不是 .md / 首筆帳 ts 讀不動 / 測試索引建不起來 / [SN] 像清單項卻是不認得的寫法(零條定義)/ 條款編號重複定義 / 任一條款未標;
    計劃讀不成文字 → "abort"(呼叫端同 G3 擋下 rc2,兩步同一種處置)。只在散文/標題提到 [SN]、沒有定義行 → skip(視同 opt-in 未啟用)。
    這是「設計審出口真的有東西逼」的那一半——沒有它,綁測試名跟 spec-trace 一樣沒人做(33 篇 15 篇零認領)。"""
    if spec_sha_override is not None:
        print("[disposal] 條款綁定: —(凍結/回放模式:不重讀活檔,以問閘當下的判定為準)")
        return "skip"
    if _roster_kind(loop_id or "") == "code":
        print("[disposal] 條款綁定: —(code 迴圈,審材是 diff 不是計劃,不看條款)")
        return "skip"
    # _roster_kind 回 None(code 開頭但不是 code-)一律當設計審:fail-closed,免得取個 codeX 的編號就繞過(r2 外家席實跑抓到)
    tss = [str(r.get("ts", "")) for r in rows if r.get("ts")]
    keys = [(_loop_ts_key(x), x) for x in tss]
    if any(k is None for k, _ in keys):
        bad = next(x for k, x in keys if k is None)
        print(f"[disposal] 條款綁定: ✗ — 帳上有一筆 ts 讀不動或沒帶時區({bad!r}),判不了新舊迴圈;壞資料不放行(同 findings 壞值的 fail-closed)")
        return "fail"
    if keys and min(k for k, _ in keys) < _loop_ts_key(_CLAUSE_GATE_SINCE):
        print(f"[disposal] 條款綁定: —(迴圈首筆帳 {min(keys)[1][:19]} 早於 {_CLAUSE_GATE_SINCE[:10]},不回溯)")
        return "skip"
    if not str(spec).endswith(".md"):
        print(f"[disposal] 條款綁定: ✗ — 設計審的審材必須是計劃筆記(.md),不是 {Path(str(spec)).name}(拿 patch 當審材繞不過這一步)")
        return "fail"
    try:
        text = Path(spec).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        print(f"擋下:--spec 指的文件讀不成文字({e.__class__.__name__}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return "abort"
    if not SPEC_CLAUSE_RE.search(text):
        print("[disposal] 條款綁定: —(計劃無 [SN] 條款,opt-in 未啟用)")
        return "skip"
    rows_b, err = _clause_bindings_for(env, text, root=root)
    if err:
        print(f"[disposal] 條款綁定: ✗ — 測試索引建不起來({err}),驗不了≠通過")
        return "fail"
    # 規格落成可驗收條件_計劃(半套)S9/S14:判定走跟 lumos spec-gate 同一支 _clause_check;句式與回退節只對首筆帳晚於 _SPEC_GATE_SINCE 的迴圈驗(綁定照驗)
    grammar = not keys or min(k for k, _ in keys) >= _loop_ts_key(_SPEC_GATE_SINCE)
    status, lines = _clause_check(text, rows_b, grammar=grammar, tag="disposal")
    for ln in lines:
        print(ln)
    return status


_LANDING_GATE_SINCE = "2026-09-12T00:00:00+08:00"   # 處置閘的落點那一步只看首筆帳在這之後的迴圈——不回溯(同 _CLAUSE_GATE_SINCE)
_LANDS_IN_ITEM_RE = re.compile(r"^Systems/[^/\[\]|#]+$")


def _lands_in_bad(values):
    """[S20] lands_in 每項要寫 Systems/<名>(純字串,不是 [[連結]]、不帶 .md、只收圖譜節點)。回寫錯的那幾項。"""
    bad = []
    for v in values:
        x = str(v).strip()
        if not x or not _LANDS_IN_ITEM_RE.match(x) or x.endswith(".md"):
            bad.append(x)
    return bad


def _disposal_landing_step(rows, spec, root, env, loop_id="", spec_sha_override=None):
    """處置閘第六步(每支檔有家 [S21]):計劃要寫明落點(lands_in)。形狀照條款綁定那一步:回 "fail"/"ok"/"skip"/"abort"。
    skip:凍結/回放模式、code 迴圈、首筆帳早於 _LANDING_GATE_SINCE(不回溯)、審材不是圖譜 Projects 底下 type 為 project 的 .md。
    fail:lands_in 空的,或有一項不是 Systems/<名> 的樣子。"""
    if spec_sha_override is not None:
        print("[disposal] 落點: —(凍結/回放模式:以問閘當下的判定為準)")
        return "skip"
    if _roster_kind(loop_id or "") == "code":
        print("[disposal] 落點: —(code 迴圈,不看計劃落點)")
        return "skip"
    tss = [str(r.get("ts", "")) for r in rows if r.get("ts")]
    keys = [k for k in (_loop_ts_key(x) for x in tss) if k is not None]
    if keys and min(keys) < _loop_ts_key(_LANDING_GATE_SINCE):
        print(f"[disposal] 落點: —(迴圈首筆帳早於 {_LANDING_GATE_SINCE[:10]},不回溯)")
        return "skip"
    sp = Path(str(spec))
    vault = Path(env.vault) if env is not None else None
    inside = False
    if vault is not None and str(spec).endswith(".md"):
        try:
            inside = sp.resolve().relative_to((vault / "Projects").resolve()) is not None
        except (ValueError, OSError):
            inside = False
    if not inside:
        # ★要真的在這個圖譜的 Projects 底下★:只看上一層資料夾叫不叫 Projects,/tmp/Projects/假.md 也會被當成計劃(第二輪外家席)
        print("[disposal] 落點: —(審材不是這個圖譜 Projects 底下的計劃,不看落點)")
        return "skip"
    try:
        text = sp.read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        print(f"擋下:--spec 指的文件讀不成文字({e.__class__.__name__}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return "abort"
    fm_lines, _body = split_frontmatter(text)
    fields = parse_frontmatter(fm_lines)[0] if fm_lines is not None else {}
    if str(fields.get("type", "")).strip() != "project":
        print("[disposal] 落點: —(審材的 type 不是 project,不看落點)")
        return "skip"
    items = [str(x).strip() for x in as_list(fields.get("lands_in")) if str(x).strip()]
    if not items:
        print("[disposal] 落點: ✗ — 計劃沒寫 lands_in(現況會寫進哪幾篇、或新開哪一篇);節點長成一篇包全部,就是因為落點從來沒被審過")
        print("    lumos append <計劃> lands_in Systems/<名>")
        return "fail"
    bad = _lands_in_bad(items)
    if bad:
        print("[disposal] 落點: ✗ — lands_in 這幾項不是 Systems/<名> 的樣子:" + "、".join(bad) + "(純字串、不帶 .md、不寫 [[連結]];落到 skill 或範本的寫在計劃正文)")
        return "fail"
    news = [x for x in items if not (vault / f"{x}.md").is_file()]
    print(f"[disposal] 落點: ✓ — {len(items)} 篇(" + "、".join(x + ("(新開)" if x in news else "") for x in items) + ")")
    return "ok"


def _loop_status_disposal(rounds, loop_id, spec, n_badlines=0, root=None, bad_linenos=None, env=None, roster=False, repo=None, readonly=False, spec_sha_override=None, result_out=None):
    """[T4] 處置閘(design-loop重設計 三):七步合取,全部讀側可重算(原本寫「四條合取」,2026-09-08 加⑤、2026-09-11 加⑥⑦後過期)——
    ①G3 hash 鏈 ②處置集合重算(不信寫側) ③留痕重驗(判定輪★全部★帶留痕欄的席,
    report/snapshot 存在且 sha 一致——r1 否決席:原只驗 carrier,竄改 missed 席報告照樣 PASS)
    ④quote-check 對 carrier 的帳面 snapshot 全 ok
    ⑤條款綁定(設計審計劃每條 [SN] 要標 [test:]/[manual:];代碼審 skip,見 _disposal_clause_step)
    ⑥資安席(定錨 high 的代碼審,required-gated 席出席+留痕+涵蓋最後一版;見 _disposal_security_step)
    ⑦落點(設計審計劃要寫明 lands_in;代碼審 skip,見 _disposal_landing_step)。
    ★canary caught/missed 不進合取(d4:觀測非閘;missed 不作廢 findings)★。
    壞行 fail-closed(r1 四席重疊:原壞行靜默跳過→latest 判錯輪可偽 PASS);
    round-id 非連續重現 rc2(reuse panel 守衛;原 OrderedDict 首現序拿錯輪)。
    留痕路徑:非絕對路徑以 repo root(root)解析(與寫側落帳慣例對稱)。
    exit 0=收斂 / 1=未過 / 2=帳面損壞或參數錯。"""
    from collections import OrderedDict
    if n_badlines:
        print(f"擋下:審查記錄檔有 {n_badlines} 行讀不懂,沒辦法確定「最後一輪」是哪輪,先不判"
              "(修好或搬走壞行再問)"
              + (f"——壞行行號: {bad_linenos}" if bad_linenos else "")
              + "(檔案有 git 版控,對照上一版找出壞行一分鐘就能修)",
              file=sys.stderr)
        return 2
    # r3 修:round 與 round-less 混用=rc2(同 panel 混用守衛精神;原樣混排會落進
    # 「非連續重現」的誤導訊息,或與內部 __seq 鍵互動出偽輪)
    n_round_ = sum(1 for r in rounds if "round" in r)
    if rounds and 0 < n_round_ < len(rounds):
        print("擋下:這個審查編號的記錄有的帶輪次、有的不帶,分不出哪輪是判定輪;"
              "統一補 --round,或全部不帶", file=sys.stderr)
        return 2
    groups = OrderedDict()
    for r in rounds:
        rid_ = r.get("round")
        if rid_ is None:
            # round-less 逐筆自成一輪(r2 回歸修:併成單一 __legacy 組會讓較早 carrier
            # 冒充最新判定/合法 legacy 第二筆假 rc2;守衛只管顯式 round-id)
            groups[f"__seq{len(groups)}"] = [r]
            continue
        if rid_.startswith("__"):
            # r3 修(3 席重疊):防舊帳/手改帳撞內部鍵(寫側已擋新寫入,讀側防守舊資料)
            print(f"擋下:記錄裡有輪次編號 {rid_!r} 用了工具保留的 __ 字首(手改過或舊版寫的),先改掉", file=sys.stderr)
            return 2
        if rid_ in groups and next(reversed(groups)) != rid_:
            # 同 panel 守衛:round-id 被其他輪隔開後重現=append-only 帳次序損壞
            print(f"擋下:第 {rid_!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),帳的順序亂了,沒辦法判斷",
                  file=sys.stderr)
            return 2
        groups.setdefault(rid_, []).append(r)
    if not groups:
        print(f"⏳ 無記錄({loop_id} 目前一筆記錄都還沒有)")
        return 1
    rid, latest = next(reversed(groups.items()))

    def _prov_path(p):
        pp = Path(p)
        return pp if pp.is_absolute() or root is None else Path(root) / pp
    fails = []
    # ── ① G3 hash 鏈(fail-closed:unbound 也擋——disposal 是新閘,無舊帳包袱) ──
    if str(rid).startswith("__") and any("findings_set" in r for r in latest):
        print("擋下:這一輪是無輪次(round-less)帳列卻帶了處置結果——處置帳必須綁輪次"
              "(2026-08-26 關繞道:無輪次處置帳可讓低報逃過寫側守衛;真帳歷史零筆此形狀,fail-closed 不誤傷)",
              file=sys.stderr)
        return 2
    try:
        err, info = _hash_chain_check([latest], spec, cur_sha_override=spec_sha_override)
    except OSError as e:
        print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return 2
    if err:
        print(f"[disposal] G3 hash: ✗ — {err}")
        fails.append("G3")
    elif info == "unbound":
        print("[disposal] G3 hash: ✗ — 判定輪未綁 hash(disposal 閘 fail-closed,record 帶 --spec/--reviewed)")
        fails.append("G3")
    else:
        print(f"[disposal] G3 hash: ✓ — {info}")
    # ── ② 處置集合(輪級重算,不信寫側) ──
    carriers = [r for r in latest if "findings_set" in r]
    if len(carriers) > 1:
        print(f"擋下:第 {rid} 輪有 {len(carriers)} 筆記錄都帶了處置結果,一輪只能有一筆", file=sys.stderr)
        if _panel_retired_for(rounds):
            print("  多席審查(2026-08-25 甲裁後)一律彙總記帳:處置清單只掛一席,其餘席只留痕(severity/report)。", file=sys.stderr)
            print("  帳不可撤——換一個新編號照上式重記,再問 --disposal。(詳 Projects/probe輪退場_計劃)", file=sys.stderr)
        else:
            print("  這種「多席各自記帳」是 panel 型,不歸 --disposal 管(它只收一輪一筆處置帳的循序記帳)。改問:", file=sys.stderr)
            print("    lumos loop status <編號> --gate --panel --min-seats 3 --spec … --repo …", file=sys.stderr)
            print("  (2026-08-06 後的迴圈要連續兩輪乾淨才過;此路僅供 2026-08-25 前定錨的舊迴圈)", file=sys.stderr)
        return 2
    carrier = carriers[0] if carriers else None
    # findings 欄壞值(手改帳/舊寫入殘留)→ fail-closed rc2,同 clusters 型別防禦慣例(不 traceback)
    def _findings_zero(r):
        v = r.get("findings")
        if v is None:
            return False       # 沒填 ≠ 明說 0(legacy 帳缺欄不放行,逐筆成輪加固測試釘的)
        try:
            return int(v) == 0
        except (TypeError, ValueError):
            return None        # 壞值
    _fz = [_findings_zero(r) for r in latest]
    if any(x is None for x in _fz):
        print("擋下:有筆記錄的 findings 欄不是整數(檔案壞了或被手改過?)——fail-closed。"
              "對照 git 上一版找出壞行改回整數:\n    git diff HEAD -- docs/.canary-log.jsonl", file=sys.stderr)
        return 2
    vacuous = False
    if carrier is None:
        # 零發現的乾淨輪:record 端明文「沒發現別帶處置選項」,這裡再要求處置帳=兩邊打架、乾淨輪永遠過不了
        # (2026-08-24 code-out-top3 實踩)。手冊語意=「每個發現都有去向即過」→ 0 條發現視同全處置(vacuous)。
        # ★vacuous 只免「處置集合」這一項★——留痕重驗照跑(r1 blocker:免驗通行證);引句無可驗,橫幅不宣稱。
        if latest and all(_fz):
            vacuous = True
            print("[disposal] 處置集合: ✓ — 這輪 0 條發現,沒有東西要處置(空輪;留痕仍要重驗)")
        else:
            print("[disposal] 處置集合: ✗ — 判定輪有發現但無處置帳(record 帶 --findings-set/--folded-set/--accepted-set)")
            fails.append("無處置帳")
    else:
        F = set(carrier.get("findings_set") or [])
        FO = set(carrier.get("folded_set") or [])
        AC = set(carrier.get("accepted_set") or [])
        reasons = carrier.get("accept_reasons") or {}
        bad = None
        if FO & AC:
            bad = f"folded∩accepted 非空: {sorted(FO & AC)}"
        elif FO | AC != F:
            bad = f"未處置: {sorted(F - FO - AC)}"
        elif set(reasons) != AC or any(not str(v).strip() for v in reasons.values()):
            bad = "accepted 理由缺席或空"
        elif AC and any(r.get("severity") == "blocker" for r in latest):
            bad = "★輪內有 blocker 席,accepted 必須為空(d1;輪級重算,不信寫側單席視角)★"
        elif AC and str(loop_id).startswith("code-") and any(r.get("severity") in ("major", "blocker") for r in latest):
            bad = "★code 迴圈輪內有 major 以上的席,accepted 必須為空——major 一律折,不得附理由放行(probe輪退場 d2,Enzo 2026-08-25 裁:與 panel 時代 max≤minor 同嚴度;散文設計審不受此限)★"
        if bad:
            print(f"[disposal] 處置集合: ✗ — {bad}")
            fails.append("處置集合")
        else:
            print(f"[disposal] 處置集合: ✓ — {len(F)} 條全處置(折 {len(FO)}/放行 {len(AC)},理由齊)")
    # ── ③ 留痕重驗(判定輪全席) + ④ quote-check(carrier;vacuous 輪無引句可驗,只跑 ③) ──
    if carrier is not None or vacuous:
        _qsrc = carrier if carrier is not None else latest[-1]
        rp, sp = _qsrc.get("report_path"), _qsrc.get("snapshot_path")
        if not rp or not sp:
            print("[disposal] 留痕: ✗ — 判定輪未帶 report/snapshot(留痕缺席)")
            fails.append("留痕缺席")
        else:
            ok = True
            n_files = 0
            # 全席重驗:T6 定錨後每席都被迫留痕,讀側就得每席都重驗——
            # 只驗 carrier 等於把 missed 席留痕降回「寫側形式要求」(r1 否決席 finding)。
            for i, r in enumerate(latest, 1):
                for label, key in (("report", "report_path"), ("snapshot", "snapshot_path")):
                    pst, pth = _prov_check(r, key, _prov_path)   # 與資安席一步共用(代碼審資安席 [S2])
                    if pst == "missing":
                        # r2 回歸修(否決席):缺欄席不得靜默跳過——「全席重驗」對缺欄席
                        # 也要成立,否則定錨前搶跑的席=讀側盲區
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} 未帶 {label}(disposal 判定輪全席都要留痕)")
                        fails.append("留痕")
                        ok = False
                        continue
                    n_files += 1
                    if pst == "unreadable":
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} 讀不到({pth})——record 完刪檔照樣擋")
                        fails.append("留痕")
                        ok = False
                    elif pst == "mismatch":
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} sha256 與帳面不符(事後被改)")
                        fails.append("留痕")
                        ok = False
            # intake守衛 T3 讀側(2026-08-30 d1):★全輪掃★——intake_path 掛 r1 帳列而判定輪
            # 多為 r2+,照 report/snapshot 只掃判定輪=常態空轉(r3-F3);任一輪帳列有 intake_path
            # 就重驗,沒有就跳過(選配欄,不強制)。竄改 intake 與竄改 report 同罪(sha 不符=FAIL)。
            _ik_n = 0
            for _rid_g, _rows_g in groups.items():
                for _r_g in _rows_g:
                    _pst, _ip = _prov_check(_r_g, "intake_path", _prov_path)
                    if _pst == "missing":
                        continue
                    _ik_n += 1
                    if _pst == "unreadable":
                        print(f"[disposal] 留痕: ✗ — {_rid_g} intake 讀不到({_ip})——record 完刪檔照樣擋")
                        fails.append("留痕")
                        ok = False
                    elif _pst == "mismatch":
                        print(f"[disposal] 留痕: ✗ — {_rid_g} intake sha256 與帳面不符(事後被改)")
                        fails.append("留痕")
                        ok = False
            if ok:
                _ik_note = f"(含全輪 intake {_ik_n} 份)" if _ik_n else ""
                print(f"[disposal] 留痕: ✓ — 判定輪全席 {n_files} 份留痕存在且 sha256 與帳面一致{_ik_note}")
            if ok and vacuous and carrier is None:
                print("[disposal] quote-check: —(零發現報告無引句可驗,略過;橫幅不宣稱錨定)")
            elif ok:
                try:
                    rows = _quote_rows(_prov_path(rp).read_text(encoding="utf-8"),
                                       _prov_path(sp).read_text(encoding="utf-8"))
                except (OSError, UnicodeDecodeError) as e:
                    # sha 讀二進位過了,text 讀可炸(非 UTF-8)——FAIL 不 traceback(r1 s4 席)
                    print(f"[disposal] quote-check: ✗ — 報告/快照讀不成文字({e.__class__.__name__})")
                    fails.append("quote")
                    rows = None
                else:
                    if rows is None:
                        print("[disposal] quote-check: ✗ — 報告零引句(驗不了≠通過)")
                        fails.append("quote")
                    else:
                        miss = [q for q in rows if not q["ok"]]
                        n_short = sum(1 for q in rows if q.get("too_short"))
                        if miss:
                            print(f"[disposal] quote-check: ✗ — {len(miss)}/{len(rows)} 條錨不到快照"
                                  + (f"(其中 {n_short} 條低於 {_QUOTE_MIN_NORM_LEN} 字下限)" if n_short else ""))
                            fails.append("quote")
                        else:
                            print(f"[disposal] quote-check: ✓ — {len(rows)} 條引句全數錨定")
    # ── canary 觀測(不進合取——d4;none=停用制無植入輪——d5) ──
    ca = sum(1 for r in latest if r.get("kind") == "caught")
    mi = sum(1 for r in latest if r.get("kind") == "missed")
    nn = sum(1 for r in latest if r.get("kind") == "none")
    print(f"[disposal] canary(觀測,不進合取): caught {ca} / missed {mi}"
          + (f" / none {nn}(協議停用,d5)" if nn else "")
          + ("——missed 席 findings ★不作廢★(d4),供跨輪累積帳" if mi else ""))
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")

    def _roster_tail():
        # roster對帳併入問閘 [S1]:問閘當輪異常轉述(異常才發聲;advisory 恆不動 rc)。
        # 三個提前 return 2 路(G3 spec 讀不到/一輪多處置帳/findings 壞值)刻意不掛——
        # 帳面異常優先於席位對帳(r3 e-f2)。roster 同帶=全史已印,尾端跳過(r2 d-f1)。
        if roster or str(rid).startswith("__"):
            return   # __seqN 合成鍵:round-less 無派工快照可對,沉默勝過錯誤示警(std-r1 s1-f2)
        try:
            kinds = _roster_observe(env, loop_id, rounds, repo, only_rid=rid, anomalies_only=True)
            if kinds:
                print("[roster] ↑ 席位對帳為觀測,不進合取")   # 免責字樣(severity-scan r1 s3-f4 順手補)
                # 留痕([S1c]):收集完、印完才一次性寫;寫入自身再包一層,失敗只損留痕不吞輸出(r3 e-f3)
                try:
                    _ldir = (Path(repo).resolve() if repo else _vault_repo_root(env)) / "governance" / "review-reports" / loop_id
                    _ldir.mkdir(parents=True, exist_ok=True)
                    import datetime as _dt
                    with open(_ldir / "roster-alerts.log", "a", encoding="utf-8") as _f:
                        _f.write(f"{_dt.date.today().isoformat()} {rid} {','.join(kinds)}\n")
                except OSError as _e:
                    print(f"[roster] 異常留痕寫入失敗({_e})——轉述已印,只是兩季覆核帳少這筆")
        except Exception as _e:
            print(f"[roster] 席位對帳失敗(降級不擋):{_e}")

    def _severity_tail():
        # 嚴重度綁定機械掃 [S3](2026-08-26):問閘收尾對判定輪逐席跑第二層 severity 對帳。
        # 異常才發聲;advisory 恆不動 rc;③已對判定輪全席報告逐檔重算過 sha→trust_sha 不重算
        # (r1 arch-f4);__seqN 合成鍵跳過(無派工上下文);例外降級不擋(比照 roster 尾端)。
        # 生效日後的帳列抓到低報=寫側 [S1] 有 bug(本應拒帳)——轉述+指路開 Issue,converged 不自動撤。
        if str(rid).startswith("__"):
            return
        try:
            _root = Path(repo).resolve() if repo else _vault_repo_root(env)
            _hits = []
            for _r in latest:
                _st, _msg = _severity_check_row(_r, _root, trust_sha=True)
                _new_era = str(_r.get("ts", "")) >= _SEV_WRITESIDE_CUTOFF
                if _st == "under" or (_st == "noparse" and _new_era):
                    _tag = "寫側有 bug,開 Issue 攤人;" if _new_era else "歷史帳,"
                    print(f"[severity] {_r.get('auditor','?')}: {_msg}({_tag}觀測,不進合取)")
                    _hits.append(f"severity_underreport:{_r.get('auditor','?')}")
            if _hits:
                try:
                    _ldir = (Path(repo).resolve() if repo else _vault_repo_root(env)) / "governance" / "review-reports" / loop_id
                    _ldir.mkdir(parents=True, exist_ok=True)
                    import datetime as _dt2
                    with open(_ldir / "roster-alerts.log", "a", encoding="utf-8") as _f2:
                        _f2.write(f"{_dt2.date.today().isoformat()} {rid} {','.join(_hits)}\n")
                except OSError as _e2:
                    print(f"[severity] 異常留痕寫入失敗({_e2})——轉述已印,只是覆核帳少這筆")
        except Exception as _e2:
            print(f"[severity] 嚴重度對帳失敗(降級不擋):{_e2}")
    if not readonly:
        # replay 唯讀:觀測尾巴不跑——roster 尾端會寫 roster-alerts.log(r2 delta d-f3 抓的第三個寫入點),
        # severity 尾端同理;純判定核心=四合取本體。
        _roster_tail()
        _severity_tail()
    # intake守衛 T2(2026-08-30 d1;advisory 不進合取不改 rc):非 code 迴圈才看
    # (r3-F2:code-loop 零前掃步驟,code 的 intake 是撈回紀錄非前掃紀錄——計數它=逼偽宣告)。
    if not readonly and not str(loop_id).startswith("code"):
        _ik_st = _intake_dir_status(root if root is not None else Path.cwd(), loop_id)
        if _ik_st == "ok":
            print("[disposal] intake(觀測,不進合取): ✓ — 迴圈目錄有帶 preflight-4 宣告行的前掃留痕")
        elif _ik_st == "missing":
            print("[disposal] intake(觀測,不進合取): ⚠ 迴圈目錄無帶 preflight-4 宣告行的 intake——"
                  "首輪前掃第四類可能沒跑(慣例=skills/lumos-design-loop/SKILL.md 步驟 2;不擋,記著補)")
        # no-dir(scratch 迴圈,如自主迴圈 /tmp 工作區)= 跳過不印
        # ── 審查有沒有用記帳 S3(2026-09-08):問閘這一輪的漏斗,觀測不進合取 ──
        _y = _review_yield_round(latest)
        _esc = len(_escape_rows_for(env, loop_id)) if env is not None else None
        print("[disposal] 審查有沒有用(觀測,不進合取;N 機器數、R 人填,別算比率): " + _review_yield_line(_y, _esc))
    # ── ⑤ 條款綁定(條款綁測試算進度 [S3],2026-09-08):計劃有 [SN] 的,每條要嘛 [test:] 要嘛 [manual:],否則不得 PASS。
    #    只看 .md 計劃、首筆帳在 _CLAUSE_GATE_SINCE 之後的迴圈(不回溯);懸空只印不擋(存在性歸 doctor/spec-trace 唸)。
    _cl = _disposal_clause_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _cl == "abort":
        return 2          # 同 G3:審材讀不到是用法錯誤,整支停,不是「這一項沒過」(r1/r2 架構席)
    if _cl == "fail":
        fails.append("條款綁定")
    # ── ⑥ 資安席(代碼審資安席 [S2],2026-09-11 d6):定錨 high 的代碼審,編制表上 required-gated 席要出席、留痕對、
    #    看過的檔涵蓋判定輪。只看生效日後開的迴圈(不回溯)。凍結/回放照樣重讀檔(凍結閉包也收了這些檔)。
    _sec = _disposal_security_step(rounds, rid, loop_id, _prov_path)
    if _sec == "fail":
        fails.append("資安席")
    # ── ⑦ 落點(每支檔有家 [S21],2026-09-11):計劃要寫明現況落在哪幾篇;首筆帳在 _LANDING_GATE_SINCE 之後的迴圈才看。
    _ld = _disposal_landing_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _ld == "abort":
        return 2
    if _ld == "fail":
        fails.append("落點")
    if result_out is not None:
        result_out["rid"] = rid
        result_out["fails"] = list(fails)
    if fails:
        print(f"⛔ DISPOSAL GATE FAIL ({loop_id} 輪 {rid}: {'/'.join(fails)})")
        return 1
    # 橫幅只列這次真的跑過而且過了的步驟(代碼審 r3 編排者自找:加了⑤⑥之後橫幅還寫死四項);skip 的不列、不宣稱
    _extra = "".join(f" ∧ {n}" for n, st in (("條款綁定", _cl), ("資安席", _sec), ("落點", _ld)) if st == "ok")
    if vacuous and carrier is None:
        print(f"✅ DISPOSAL GATE PASS ({loop_id} 輪 {rid}: G3 ∧ 0 發現空輪 ∧ 留痕可重算{_extra};引句無可驗不宣稱)")
    else:
        print(f"✅ DISPOSAL GATE PASS ({loop_id} 輪 {rid}: G3 ∧ 處置全清 ∧ 留痕可重算 ∧ 引句全錨定{_extra})")
    if not readonly:
        _loop_gov_mark(env, loop_id, "converged", "disposal gate PASS")
    return 0


def cmd_quote_check(report, spec, as_json=False):
    """錨定檢查(T2,vault-free):報告內每條「引句：「…」」norm 後須為凍結快照 norm 後的
    子字串。rc0=全 ok、rc1=有 miss、rc2=IO/零引句(★驗不了≠通過,fail loud★)。
    ★比對對象必須是派工當下的凍結快照,不是現檔★——對現檔跑,finding 折入後引句會
    「自我成真」(重設計 r1 Codex 折入:循環自證)。"""
    import json
    import re
    try:
        rtext = Path(report).read_text(encoding="utf-8")
        stext = Path(spec).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as e:
        # UnicodeDecodeError 非 OSError——非 UTF-8 檔原本直接 traceback(r1 s4 席)
        print(f"擋下:檔案讀不到: {e}", file=sys.stderr)
        return 2
    rows = _quote_rows(rtext, stext)
    if rows is None:
        print("擋下:這份審查報告裡一句「引句：「…」」都抽不到;驗不了不等於通過——"
              "審查員沒照派工格式寫的話,先補引句再記帳。\n"
              "  常見原因:①標籤寫成『引文:』『Quote:』等別名(只認「引句」;粗體或加註記的變體可以)"
              " ②引號用半形 \"…\" 或【…】(只認「」『』) "
              "③引句跟標籤不在同一行 ④開閉引號不成對(這種會列成錨不到,不是零條)", file=sys.stderr)
        return 2
    miss = [r for r in rows if not r["ok"]]

exec
/bin/zsh -lc "sed -n '9535,9605p' scripts/lumos; rg -n '"'^def _loop_status_disposal'"' scripts/lumos; sed -n '10330,10690p' scripts/lumos" in /Users/enzo/harness/lumos-toolchain
 succeeded in 0ms:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。
    讀 .canary-log.jsonl 的 **append 序**(不 ts-sort:ts 只到秒、同秒會並列),篩 loop==id。
    tail-K 滑動窗:前面髒輪不影響、只看最後 K 筆;missed/缺 severity 視同未收斂。
    exit 0=CONVERGED / 1=未收斂(含無記錄=還沒開始)/ 2=真錯誤。
    天花板:收斂=連 K 輪醒著的審計員沒找到 blocker/major,非完整正確;severity 自報(見設計 doc)。"""
    import json
    if light and panel:
        print("擋下:--light 和 --panel 不能一起用(light 是單人審、panel 是多人審,兩條不同的路),擇一", file=sys.stderr)
        return 2
    explicit_need = need is not None
    if need is None:
        need = 2
    if disposal:
        # [T4 處置閘] 獨立路徑(design-loop重設計 d2/B5):與所有既有模式互斥,舊閘一行不動
        if panel or light or settle is not None or explicit_need or min_seats is not None:
            print("擋下:--disposal 是獨立的一套閘,不能跟 --panel/--light/--settle/--need/--min-seats 一起用",
                  file=sys.stderr)
            return 2
        if spec is None:
            print("擋下:--disposal 一定要帶 --spec 指定被審的文件,不然沒辦法比對文件有沒有被改、留痕對不對(寧可擋也不猜)", file=sys.stderr)
            return 2
    if settle is not None:
        # [S1] rc2 互斥/前置群(fail-closed;結清式收斂_計劃 2026-07-28)
        if panel or light:
            print("擋下:--settle 不能跟 --panel 或 --light 一起用(目前只接單人審的記錄格式)", file=sys.stderr)
            return 2
        if explicit_need:
            print("擋下:--settle 模式不數輪數,--need 在這裡沒意義;與其默默忽略誤導你,不如請你拿掉 --need", file=sys.stderr)
            return 2
        if min_seats is not None:
            print("擋下:--settle 不能跟 --min-seats 一起用(人數檢查是算在最近幾輪上的,settle 模式沒有「最近幾輪」這個概念;"
                  "auditor 非空職能由 caught 定義收緊承接)", file=sys.stderr)
