            # ★`legacy` 不是可宣告值,不得吐進 record_cmd★(2026-08-04):`--tier` 的 choices
            # 只有 light/standard/high(LOOP_TIERS),legacy 純粹是「無定錨舊帳 + legacy 格式」
            # 的推導結果。原本這裡無條件吐 `--tier {eff_tier}`,legacy 下等於★發一條 argparse
            # 當場擋掉的指令★;而使用者最自然的修復是「把 --tier 拿掉再跑一次」——拿掉就記不上
            # 定錨,下一輪 next 又推成 legacy、又吐一條跑不動的指令。
            # ★這個 bug 自己維持自己★:2026-08 三個走循序的 loop(code-slim-python /
            # code-teardown-windows / code-slim-handoff)全數 tier=None,即此循環的產物;
            # 其中 code-slim-python 吃到 legacy 的 cap 6(standard 是 3)才被逼停。
            # ★編號加 shell 引號★(代碼審 r3 資安 G1):loop_id 是自由字串,`code-x; touch … #` 原樣塞進
            # 這幾條每輪都印、照慣例原樣照抄的指令,`;` 之後就被當成指令跑;一般編號 shlex.quote 不加引號
            import shlex as _shlex
            _qid = _shlex.quote(loop_id)
            _tier_flag = f" --tier {eff_tier}" if eff_tier in LOOP_TIERS else ""
            _orch_flag = f" --orchestrator {eff_orch}"
            # ★用現行類別 none★:caught|missed 是 canary 植入協議的類別,2026-08-14 已停用(Systems/canary-audit d5),
            # 照抄舊模板等於教人記一筆已停用的帳;--snapshot:代碼審記帳從第一筆就要附審材,沒帶會被擋
            out["record_cmd"] = (f"lumos canary record none --loop {_qid}{rmode}"
                                 f" --auditor <席> --severity <s> --findings <M>"
                                 f" --report <席報告.md> --snapshot <凍結快照.md>"
                                 f" --spec <計劃節點.md> --reviewed <sha256>{_tier_flag}{_orch_flag}"
                                 f" --scope-lines <這輪審了幾行>")   # cb3 s3-f1:寫側 2026-08-26 起審查席必附報告,模板同步
            # [T5 design-loop重設計] 處置閘模板(選用;record_cmd 原樣保留給 code-loop/舊流程)
            if not light and eff_tier != "legacy":
