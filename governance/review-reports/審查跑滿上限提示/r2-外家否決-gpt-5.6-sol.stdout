def _loop_gov_mark(env, loop_id, kind, note=""):
    """設計/代碼審查迴圈的結案方式進治理帳(工具鏈補強十件 #6):gate=design-loop,
    kind=converged(閘過了)| cap-reached(跑滿上限沒過)| rewrite(人裁判整份重寫、開新編號收尾;設計審收斂重定義 d3,2026-08-25;note 必寫前編號)。gov --stats 三種分開計數。
    fail-open:寫不進去不影響判定輸出。"""
    if env is None:
        return
    try:
        _append_governance_log(env.vault, [{"gate": "design-loop", "kind": kind, "hard": False,
                                            "nodes": [loop_id], "note": note}])
    except Exception:
        pass


def _replay_git_blob(root, relpath):
    """--freeze 前置:檔案已 commit 且與 HEAD 一致才記 blob id(r3 delta d-f2:hash-object 不落
    物件、-w 落懸空 blob 兩週可被 GC——取 HEAD 的 blob 保證被 tree 引用)。回 (blob_id, err)。"""
    import subprocess as _sp
    head = _sp.run(["git", "-C", str(root), "rev-parse", f"HEAD:{relpath}"],
                   capture_output=True, text=True, errors="replace")
    if head.returncode != 0:
        return None, f"{relpath} 還沒 commit 進版控"
    work = _sp.run(["git", "-C", str(root), "hash-object", str(Path(root) / relpath)],
                   capture_output=True, text=True, errors="replace")
    if work.returncode != 0:
        return None, f"{relpath} 讀不到({work.stderr.strip()[:80]})"
    if head.stdout.strip() != work.stdout.strip():
        return None, f"{relpath} 工作樹內容與 HEAD 不一致(先 commit 卷證再凍)"
    return head.stdout.strip(), None


def cmd_loop_replay(env, loop_id, golden=None, freeze=False, spec=None, note=None, repo=None):
    """改制回測 [S1/S2](2026-08-26):gate 判定回放。
    凍結模式(--freeze --spec):對 loop 現帳跑唯讀判定,產 governance/replay/<id>/verdict.json
    =完整輸入閉包(全列原文+逐行 sha 集+spec sha+檔案 sha/blob+engine_rev)。
    回放模式(--golden):對閉包重算,差異四分類——邏輯漂移/帳被動=紅 rc1;
    帳本長大/golden 過期=列出不紅。唯讀:治理帳零寫入、不跑觀測尾巴。
    範圍=d5 處置帳形狀;panel 舊制 rc2 指路 loop status --gate --panel(語意重算既有,不入 golden)。
    rc:0=無異狀 / 1=紅(漂移或資料完整性) / 2=用法或帳形狀錯。"""
    import json
    import hashlib
    import datetime
    if freeze == bool(golden):
        print("擋下:--freeze(凍結)和 --golden(回放)要挑一個模式", file=sys.stderr)
        return 2
    root = Path(repo).resolve() if repo else _vault_repo_root(env)
    ledger = env.vault.parent / ".canary-log.jsonl"

    def _load_rows():
        raw, parsed = [], []
        try:
            for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("loop") == loop_id:
                    raw.append(line)
                    parsed.append(d)
        except OSError as e:
            print(f"擋下:帳本讀不到({e}): {ledger}", file=sys.stderr)
    if issues:
        print(f"⚠ 還有 {len(issues)} 處機器轉不了,要人改(不然 canary record 會擋):")
        for no, why, ln in issues[:10]:
            print(f"    第 {no} 行:{why}\n      {ln[:100]}")
        return 1
    return 0


def _report_reported_count(text):
    """[審查有沒有用記帳 S1] 報了幾條=檔級之後的獨立宣告行數(排除 clean)。前提是報告已通過 _report_normalize_issues。"""
    decl = _report_severities(text)
    return sum(1 for v in decl[1:] if v != "clean")


def _review_yield_round(rows):
    """[審查有沒有用記帳 S3] 一輪帳列 → 漏斗數字 dict(N 報/M 存活/R 重現不到/F 折/A 放行/S 存活多於席位報)。
    N=席位列 reported 加總,★同席同報告只算一次★(同一席會先留痕一筆、再當載體一筆;以 (auditor, report_sha256) 去重);
    任一欄缺(2026-09-09 前的帳沒這些鍵)→ 該格 None(印 ?),N/M/R 任一 None 就不算 S。純函式,disposal 尾與 gov --stats 共用。"""
    seen, N, n_missing = set(), 0, False
    for r in rows:
        key = (r.get("auditor"), r.get("report_sha256"))
        if key in seen:
            continue
        seen.add(key)
        if r.get("reported") is None:
            n_missing = True
        else:
            N += int(r["reported"])
    carrier = next((r for r in rows if r.get("findings_set")), None)
    M = len(carrier["findings_set"]) if carrier else None
    R = len(carrier["refuted_set"]) if carrier and carrier.get("refuted_set") is not None else None
    F = len(carrier.get("folded_set") or []) if carrier else None
    A = len(carrier.get("accepted_set") or []) if carrier else None
    N = None if n_missing or not seen else N
    S = None if (N is None or M is None or R is None) else max(0, M + R - N)
    return {"N": N, "M": M, "R": R, "F": F, "A": A, "S": S, "has_carrier": carrier is not None}


def _review_yield_line(y, escapes=None):
    """把 _review_yield_round 的 dict 印成一行(問閘尾與 gov --stats 同一種措辭)。"""
    q = lambda v: "?" if v is None else str(v)
    s_part = "算不了(缺欄位)" if y["S"] is None else f"存活多於席位報的 {y['S']} 條(編排者自找或漏併)"
    tail = f";這條迴圈累計逃逸 {escapes}" if escapes is not None else ""
    return (f"席位報 {q(y['N'])}(機器數)→ 存活 {q(y['M'])} / 編排者重現不到 {q(y['R'])}(人填,已對 intake)"
            f"→ 折 {q(y['F'])} / 放行 {q(y['A'])};{s_part}{tail}")


