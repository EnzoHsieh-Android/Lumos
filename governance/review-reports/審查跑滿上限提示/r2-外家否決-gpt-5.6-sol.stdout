  8153	def _round_valid_m2(recs):
  8154	    """M2 統一單位謂詞(有效輪):(caught+none)≥2 ∧ missed=0 ∧ 全部 kind ∈ 白名單。
  8155	    gate/fold/定錨/ledger/W 歸屬五處共用——嚴禁記錄級判定(2caught+1missed 輪的
  8156	    clusters 掛 caught 記錄上也不得採納);未知 kind 使輪無效(既有 2303 謂詞對此是盲的)。
  8157	    kind=none(2026-08-14 協議停用,Systems/canary-audit d5)=無植入輪,計入席數。"""
  8158	    kinds = [r.get("kind") for r in recs]
  8159	    if any(k not in ("caught", "missed", "none") for k in kinds):
  8160	        return False
  8161	    return (kinds.count("caught") + kinds.count("none")) >= 2 and kinds.count("missed") == 0
