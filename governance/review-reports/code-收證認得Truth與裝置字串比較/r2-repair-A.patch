-        if re.fullmatch(r'(?:java\.lang\.AssertionError|org\.junit\.ComparisonFailure)(?::.*)?', first) and re.search(r'\bat org\.junit\.Assert\.(?:fail|assert)\w*\(', own):
+        frame = re.search(r'\n[ \t]*at [\w$.]+\(', text)
