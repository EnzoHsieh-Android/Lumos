+def _dart_sarif_results(data):
+    """dart analyze --format=json 的內容 → SARIF results。★形狀有任何一處不對就丟 ValueError★,
+    由呼叫端當成讀不懂——略過看不懂的項目等於把讀不懂的輸入報成乾淨(r1 正確性席與外家席同時抓到)。
+    路徑原樣放,轉相對交給適配器的共用正規化(r1 架構對齊席:橋接層不自己算路徑)。"""
+    if not isinstance(data, dict) or not isinstance(data.get("diagnostics"), list):
+        raise ValueError("不是 dart analyze --format=json 的輸出(沒有 diagnostics 清單)")
+    results = []
+    for g in data["diagnostics"]:
+        loc = g.get("location") if isinstance(g, dict) else None
+        rng = loc.get("range") if isinstance(loc, dict) else None
+        start = rng.get("start") if isinstance(rng, dict) else None
+        end = rng.get("end") if isinstance(rng, dict) else None
+        line = start.get("line") if isinstance(start, dict) else None
+        path = loc.get("file") if isinstance(loc, dict) else None
+        if not (isinstance(line, int) and line >= 1 and isinstance(path, str) and path):
+            raise ValueError("診斷清單裡有看不懂的項目:%r" % (str(g)[:80],))
+        if str(g.get("type", "")).upper() in _DART_SKIP_TYPES:
+            continue
+        end_line = end.get("line") if isinstance(end, dict) and isinstance(end.get("line"), int) else line
+        item = {
+            "ruleId": str(g.get("code", "")),
+            "message": {"text": str(g.get("problemMessage", ""))},
+            "locations": [{"physicalLocation": {
+                "artifactLocation": {"uri": path},
+                "region": {"startLine": line, "endLine": max(end_line, line)},
+            }}],
+        }
+        level = _DART_LEVEL.get(str(g.get("severity", "")).upper())
+        if level:
+            item["level"] = level
+        results.append(item)
+    return results
