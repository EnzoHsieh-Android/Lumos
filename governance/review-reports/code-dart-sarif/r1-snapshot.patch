+def _dart_rel(path):
+    """dart 回報的是絕對路徑;轉成相對於執行目錄,新增告警閘才剝得掉快照那層前綴。
+    ★兩邊都要比真實路徑★:macOS 的暫存目錄是符號連結(/var → /private/var),
+    執行目錄拿到的是真實路徑、dart 回報的可能不是,只比字面會算出一串 ../。
+    轉不成專案內的相對路徑就原樣留著(適配器還會再對專案根算一次)。"""
+    if not path or not os.path.isabs(path):
+        return path
+    cwd = os.path.realpath(os.getcwd())
+    for cand in (path, os.path.realpath(path)):
+        try:
+            rel = os.path.relpath(cand, cwd)
+        except ValueError:                      # Windows 跨磁碟機
+            continue
+        if not rel.startswith(".."):
+            return rel.replace("\\", "/")
+    return path
