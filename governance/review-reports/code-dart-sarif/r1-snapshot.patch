+def cmd_dart_sarif(out=None):
+    """dart analyze --format=json(stdin)→ SARIF v2.1(--out 或 stdout)。
+    橋接:Dart/Flutter 的分析器沒有原生 SARIF → 轉成 lint-adapter 吃的 SARIF。
+    用法(專案 .lumos/lint.json 的 dart 棧):
+      dart analyze --format=json {LINT_FILES} 2>/dev/null | python3 scripts/lumos dart-sarif --out {LINT_SARIF_OUT}
+
+    ★跟 sqlfluff-sarif / stylelint-sarif 不一樣:讀不懂就失敗(rc2、不寫結果檔),不吐空結果★。
+    實跑量過:dart 沒裝時標準輸出是空的;給了不存在的檔,印的是用法說明、不是 JSON。
+    這兩種情況吐一份「零條告警」的 SARIF,等於替一條根本沒跑的檢查報平安——
+    新增告警閘 2026-09-13 修掉的就是這種假綠。不寫檔,閘讀到空檔會判「跑不動」。"""
+    import json
+    raw = sys.stdin.read()
+    data = None
+    for text in (raw, raw[raw.find("{"):] if "{" in raw else ""):
+        try:
+            data = json.loads(text)
+            break
+        except (json.JSONDecodeError, ValueError):
+            continue
+    if not isinstance(data, dict) or not isinstance(data.get("diagnostics"), list):
+        why = "標準輸出是空的(dart 沒裝或沒跑起來?)" if not raw.strip() else "讀到的不是 dart analyze --format=json 的輸出"
+        print(f"擋下:{why}——不產出結果檔,免得一條沒跑的檢查被當成乾淨。", file=sys.stderr)
+        print(f"    開頭是:{raw.strip()[:80]!r}", file=sys.stderr)
+        return 2
+    results = []
+    for g in data["diagnostics"]:
+        if not isinstance(g, dict):
+            continue
+        loc = g.get("location") or {}
+        rng = (loc.get("range") or {})
+        start, end = rng.get("start") or {}, rng.get("end") or {}
+        item = {
+            "ruleId": g.get("code", ""),
+            "message": {"text": g.get("problemMessage", "")},
+            "locations": [{"physicalLocation": {
+                "artifactLocation": {"uri": _dart_rel(loc.get("file", ""))},
+                "region": {"startLine": start.get("line", 0), "endLine": end.get("line", start.get("line", 0))},
+            }}],
+        }
+        level = _DART_LEVEL.get(str(g.get("severity", "")).upper())
+        if level:
+            item["level"] = level
+        results.append(item)
+    sarif = {"version": "2.1.0",
+             "runs": [{"tool": {"driver": {"name": "dart"}}, "results": results}]}
+    text = json.dumps(sarif, ensure_ascii=False)
+    if out:
+        with open(out, "w", encoding="utf-8") as fh:
+            fh.write(text)
+    else:
+        print(text)
+    return 0
