+def _node_index(vault: Path) -> dict:
+    paths = {str(p.relative_to(vault)) for p in vault.rglob("*.md")}
+    stems = {}
+    for n in paths:
+        stems.setdefault(n.rsplit("/", 1)[-1][:-3], []).append(n)
+    return {"paths": paths, "stems": stems}
