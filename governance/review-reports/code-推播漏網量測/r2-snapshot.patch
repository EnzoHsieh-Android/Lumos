+def _effective_ts(objs) -> list:
+    """每一行的時間:缺時間的行沿用同一份逐字稿前一行的時間(計劃 S4;代碼審 r1 外家 C7);前面都沒有 → None(不收、計數)。"""
+    out, last = [], None
+    for o in objs:
+        t = o.get("timestamp") if isinstance(o, dict) else None
+        if t:
+            last = t
+        out.append(last)
+    return out
