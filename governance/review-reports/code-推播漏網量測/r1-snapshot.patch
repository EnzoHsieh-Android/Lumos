+class Relater:
+    """relate(node, F) 的實作:每支 F 跑一次 `lumos impact --file F --json`(同一次執行內快取);每個子行程逾時 60 秒,
+    整次執行總預算(預設 300 秒,同 replay_weekly 的 BUDGET_SECONDS)用完就不再叫——那些 F 記判不出並計數。"""
+    def __init__(self, repo: Path, vault: Path, budget: float = 300.0, timeout: float = 60.0):
+        self.repo, self.vault, self.budget, self.timeout = repo, vault, float(budget), float(timeout)
+        self.t0, self.cache, self.budget_hit, self.timeouts = _time.monotonic(), {}, False, 0
+        self.about = _about_map(vault)
+        self.lumos = Path(__file__).resolve().parents[3] / "scripts" / "lumos"
+
+    def impact(self, f):
+        if f in self.cache:
+            return self.cache[f]
+        left = self.budget - (_time.monotonic() - self.t0)
+        if left <= 0:
+            self.budget_hit = True; self.cache[f] = None; return None
+        data = None
+        try:
+            r = subprocess.run([sys.executable, str(self.lumos), "--vault", str(self.vault), "impact", "--file", f, "--json"],
+                               cwd=str(self.repo), capture_output=True, text=True, timeout=min(self.timeout, max(1.0, left)))
+            if r.returncode == 0:
+                data = json.loads(r.stdout)
+        except subprocess.TimeoutExpired:
+            self.timeouts += 1
+        except Exception:
+            data = None
+        self.cache[f] = data
+        return data
+
+    def __call__(self, node, f):
+        return relate_from(self.impact(f), self.about, node, f)
+
+
+class Existence:
+    """那篇筆記在編輯當下存不存在:git 最早加入時間(--follow,改名不洗掉)或檔案系統建立時間,任一早於編輯就算存在。
+    只看 git 會錯排「早就寫好、還沒提交」的;只看建立時間會被重新 clone 洗成新的。兩個都查不到(檔已刪)當作存在。"""
+    def __init__(self, repo: Path, vault: Path):
+        self.repo, self.vault, self.cache = repo, vault, {}
+
+    def __call__(self, node, ts):
+        t = _ts_epoch(ts)
+        if t is None:
+            return True
+        if node not in self.cache:
+            git_t = birth = None
+            try:
+                rel = str((self.vault / node).relative_to(self.repo))
+                out = subprocess.run(["git", "-C", str(self.repo), "log", "--follow", "--diff-filter=A", "--format=%ct", "--", rel],
+                                     capture_output=True, text=True, timeout=20).stdout.split()
+                git_t = min(int(x) for x in out) if out else None
+            except Exception:
+                pass
+            try:
+                birth = getattr(os.stat(self.vault / node), "st_birthtime", None)
+            except OSError:
+                pass
+            self.cache[node] = (git_t, birth)
+        git_t, birth = self.cache[node]
+        if git_t is None and birth is None:
+            return True
+        return (git_t is not None and git_t <= t) or (birth is not None and birth <= t)
+
+
+SEARCH_RANKED = re.compile(r"(?m)^\((?:共 (\d+) 篇候選|候選 (\d+);)")        # 現行「(共 N 篇候選」與舊版「(候選 N;」
+SEARCH_RESULT_LINE = re.compile(r"(?m)^\s+\d+(?:\.\d+)?\s+(?:[^\s/]+/)+\S*?\.md\b")    # 排名結果行「  11.902  Projects/x.md」
+SEARCH_LEGACY = re.compile(r"(?m)^(\d+) 處 / (\d+) 篇")
+_CHAIN_RE = re.compile(r";|&&|\|\|")
+
+
+def _search_segments(cmd: str) -> list[list[str]]:
+    """一次呼叫用 ; && || 切段(管線 | 不切,那是同一段的過濾);回每段裡 lumos search 的查詢詞。"""
+    import shlex
+    out = []
+    for seg in _CHAIN_RE.split(_strip_quoted_keep(cmd)):
+        seg_raw = seg
+        try:
+            toks = shlex.split(seg_raw)
+        except ValueError:
+            toks = seg_raw.split()
+        for i, tk in enumerate(toks):
+            if os.path.basename(tk).endswith("lumos") and i + 1 < len(toks) and toks[i + 1] == "search":
+                terms = []
+                for w in toks[i + 2:]:
+                    if w == "|" or w.startswith(("2>", ">", "|")):
+                        break
+                    if not w.startswith("-"):
+                        terms.append(w)
+                out.append(terms)
+                break
+    return out
+
+
+def _strip_quoted_keep(cmd: str) -> str:
+    """只為切段:把引號內的 ; && || 換成佔位字元(不動引號本身),切完 shlex 再照原樣解析。"""
+    def repl(m):
+        return m.group(0).replace(";", "\x00").replace("&&", "\x01\x01").replace("||", "\x02\x02")
+    s = QUOTED_RE.sub(repl, cmd)
+    return s
+
+
+def _search_verdict(text: str) -> str:
+    t = str(text or "")
+    for ln in t.splitlines():
+        ln = ln.strip()
+        if ln.startswith("{") and '"candidates"' in ln:
+            try:
+                d = json.loads(ln)
+                return "zero" if int(d.get("candidates", -1)) == 0 else "hit"
+            except Exception:
+                pass
+    try:
+        d = json.loads(t)
+        if isinstance(d, dict) and "candidates" in d:
+            return "zero" if int(d["candidates"]) == 0 else "hit"
+    except Exception:
+        pass
+    m = SEARCH_RANKED.search(t)
+    if m:
+        return "zero" if int(m.group(1) or m.group(2)) == 0 else "hit"
+    m = SEARCH_LEGACY.search(t)
+    if m:
+        return "zero" if int(m.group(2)) == 0 else "hit"
+    # 計數行常被 `| head -N` 切掉(它在最後一行);看得到排名結果行就是有命中。零命中只認明寫 0 的那一行,絕不從「沒有計數行」推論
+    if SEARCH_RESULT_LINE.search(t):
+        return "hit"
+    return "undetermined"
+
+
+def _search_event(cmd: str, output, bg: bool, ts) -> dict | None:
+    segs = _search_segments(cmd)
+    if not segs:
+        return None
+    q = " ".join(segs[0]).replace("\x00", ";").replace("\x01", "&").replace("\x02", "|")
+    if bg or len(segs) != 1 or output is None:
+        return {"ts": ts, "query": q, "verdict": "undetermined"}
+    return {"ts": ts, "query": q, "verdict": _search_verdict(output)}
+
+
+def search_events_claude(objs) -> list[dict]:
+    """Bash 呼叫裡的 lumos search 配它的輸出(tool_use id → tool_result);恰好一段含 search 才判,背景執行判不出。"""
+    results = _tool_results(objs)
+    out = []
+    for o in objs:
+        if o.get("type") != "assistant":
+            continue
+        for it in ((o.get("message") or {}).get("content") or []):
+            if isinstance(it, dict) and it.get("type") == "tool_use" and it.get("name") == "Bash":
+                inp = it.get("input") or {}
+                res = results.get(it.get("id"))
+                ev = _search_event(str(inp.get("command", "")), res[1] if res else None, bool(inp.get("run_in_background")), o.get("timestamp"))
+                if ev:
