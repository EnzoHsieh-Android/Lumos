   245	def _codex_hook_trace(thread_id):
   246	    """從 Codex 逐字稿數「lumos 的 hook 有沒有真的注入」與「收工擋停有沒有發生」。
   247	    逐行當 JSON 讀(架構 #4:不拿子字串當結構),只認 lumos 自家 hook 的首行標頭:developer 訊息以 _LUMOS_HOOK_HEADS 之一開頭=注入一次;
   248	    user 訊息帶 <hook_prompt hook_run_id=…>=Stop 續做提示一次(外家 #3:Codex 自己的 skills 清單也含 "lumos",字串出現不算)。
   249	    hook 要不要 fire 取決於這台機器審過信任沒(Projects/Codex完全支援_計劃 誠實界線)——沒 fire 的場要看得出來,不能默默算「Codex 沒理 lumos」。"""
   250	    if not thread_id:
   251	        return None
   252	    hits = sorted(_codex_home_dir().glob(f"sessions/*/*/*/rollout-*-{thread_id}.jsonl"), key=lambda q: q.stat().st_mtime)
   253	    if not hits:
   254	        return None
   255	    hits = hits[-1:]   # 同 thread 多份 rollout 取最新(邊界 F3:glob 無序)
   256	    fired = stop_seen = 0
   257	    for line in hits[0].read_text(encoding="utf-8", errors="replace").splitlines():
   258	        try:
   259	            ev = json.loads(line)
   260	        except ValueError:
   261	            continue   # 半行(Codex 還在寫)略過
   262	        pl = ev.get("payload") if isinstance(ev, dict) else None
   263	        if not isinstance(pl, dict) or pl.get("type") != "message":
   264	            continue
   265	        texts = [c.get("text", "") for c in (pl.get("content") or []) if isinstance(c, dict)]
   266	        text = "\n".join(t for t in texts if isinstance(t, str))
   267	        if pl.get("role") == "developer" and text.lstrip().startswith(_LUMOS_HOOK_HEADS):
   268	            fired += 1
   269	        if pl.get("role") == "user" and "hook_run_id=" in text and "LUMOS-STOP" in text:
   270	            stop_seen += 1
   271	    return {"hooks_fired": fired, "stop_block_seen": stop_seen}
