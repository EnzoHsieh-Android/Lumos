   542	def _stop_mark_write(session_id: str) -> bool:
   543	    """O_EXCL 原子建檔佔名額(兩個 hook 同時來只有一個成功);任何 OSError 都回 False=不擋(寧可漏)。"""
   544	    mp = _stop_mark_path(session_id)
   545	    if mp is None or not _stop_dir_ok(mp.parent):
   546	        return False
   547	    try:
   548	        fd = os.open(str(mp), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
   549	    except OSError:
   550	        return False
   551	    try:
   552	        os.write(fd, str(time.time()).encode("utf-8"))
   553	    except OSError:
   554	        pass          # 名額已佔(檔已建成),寫內容失敗不影響
   555	    finally:
   556	        os.close(fd)  # 正確性席 F2:fd 不漏
   557	    return True
