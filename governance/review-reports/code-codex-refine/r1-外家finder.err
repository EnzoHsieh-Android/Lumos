   512	def _stop_mark_path(session_id: str) -> Path:
   513	    return _stop_block_dir() / re.sub(r"[^A-Za-z0-9_.-]", "_", session_id)[:120]
   514	
   515	
   516	def _stop_mark_write(session_id: str) -> bool:
   517	    """印完 block 才記名額:O_EXCL 原子建檔(兩個 hook 同時來只有一個成功);失敗不影響已印的 block。"""
   518	    try:
   519	        fd = os.open(str(_stop_mark_path(session_id)), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
   520	        os.write(fd, str(time.time()).encode("utf-8")); os.close(fd)
   521	        return True
   522	    except OSError:
   523	        return False
