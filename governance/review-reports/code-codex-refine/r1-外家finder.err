   500	def codex_stop_decision(payload: dict, harness: str, session_id: str) -> bool:
   501	    """要不要對這次 Stop 回 block:harness=codex、沒設 LUMOS_STOP_BLOCK_OFF、這輪還沒被續做過、本 session 還沒擋過。
   502	    回 True 時已寫下 session 標記(呼叫端隨即輸出 block)。"""
   503	    if harness != "codex" or os.environ.get("LUMOS_STOP_BLOCK_OFF") == "1":
   504	        return False
   505	    if payload.get("stop_hook_active"):
   506	        return False
   507	    if not session_id:
   508	        return False
   509	    return not _stop_mark_path(session_id).exists()
   510	
