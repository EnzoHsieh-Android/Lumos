   532	def stop_block_reason(rel: list, graph_rel, mentions: dict) -> str:
   533	    """reason 版面(r1 外家 #8):首行固定標頭、第二行就是指令、再列檔名(最多 10)、整段 ≤1500 字——續做提示約 2500 tokens 後會被截成頭尾預覽。"""
