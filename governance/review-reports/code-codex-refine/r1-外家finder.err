   249	def run_one_codex(sc, workdir, timeout, model, arm="with", stop_block="on", bypass_trust=False):
   250	    """Codex 版 runner:`codex exec --json -C <沙盒> --sandbox workspace-write <prompt>`。
   251	    預設不帶 --dangerously-bypass-hook-trust(本機審過信任 hook 就會跑;沒審過 hook 不 fire、結果 hooks_fired=0 看得出);
   252	    --codex-bypass-hook-trust 只給隔離環境。stop_block=off 設 LUMOS_STOP_BLOCK_OFF=1 關掉 Codex 收工擋停(對照組)。
   253	    模型由 codex 設定決定(-m 可覆寫);用量上限偵測 Codex 側沒對應訊號,limit_hit 恆 False 並在 result_subtype 標 codex。"""
   254	    bad = _validate_scenario(sc)
   255	    if bad:
   256	        return {"id": sc.get("id", "?"), "cat": sc.get("cat"), "passed": False, "reason": f"儀器例外: {bad}", "first_tool": None,
   257	                "n_calls": 0, "calls": [], "secs": 0, "stderr": "", "arm": arm, "ever_lumos": False, "first_lumos_idx": None,
   258	                "limit_hit": False, "result_subtype": "codex", "harness": "codex"}
   259	    # stdin 必重導向 DEVNULL:codex exec 沒有 tty 時會等 stdin(2026-08-23 外家席實測「stdin 要重導否則掛住」)
   260	    cmd = ["codex", "exec", "--json", "--sandbox", "workspace-write", "-C", str(workdir)]
   261	    if bypass_trust:
   262	        cmd.append("--dangerously-bypass-hook-trust")
   263	    if model:
   264	        cmd += ["-m", model]
   265	    cmd.append(sc["prompt"])
   266	    env = dict(os.environ); env["LUMOS_PROBE"] = "1"
   267	    if arm == "without":
   268	        env["LUMOS_ENTRY_HOOK_OFF"] = "1"
   269	    if stop_block == "off":
   270	        env["LUMOS_STOP_BLOCK_OFF"] = "1"
   271	    t0 = time.time()
   272	    instrument_fail = None   # 超時 / 非零退出 = 儀器例外,這場不算分(code-codex-s3 r1 外家 #3:半途已印期望指令也不能判過)
   273	    try:
   274	        r = subprocess.run(cmd, cwd=str(workdir), capture_output=True, text=True, timeout=timeout, env=env, stdin=subprocess.DEVNULL)
   275	        out, err = r.stdout, r.stderr[-400:]
   276	        if r.returncode != 0:
   277	            instrument_fail = f"codex exec 退出碼 {r.returncode}"
   278	    except subprocess.TimeoutExpired as e:
   279	        out = (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
   280	        err = "timeout"; instrument_fail = f"codex exec 超時 {timeout}s"
   281	    calls, final = tool_calls_from_codex_json(out.splitlines())
   282	    thread_id = None
   283	    for ln in out.splitlines():
   284	        try:
   285	            ev = json.loads(ln)
   286	        except ValueError:
   287	            continue
   288	        if isinstance(ev, dict) and ev.get("type") == "thread.started":
   289	            thread_id = ev.get("thread_id"); break
   290	    trace = _codex_hook_trace(thread_id)
   291	    ok, why, first = judge(calls, sc["expect"], sc.get("forbid_before", []))
   292	    if instrument_fail:
   293	        ok, why = False, f"儀器例外: {instrument_fail}(這場不算分)"
   294	    answer_content_ok = None
   295	    if sc.get("answer_expect"):
   296	        miss_a = [e for e in sc["answer_expect"] if not re.search(e, final or "", re.I)]
   297	        answer_content_ok = not miss_a
   298	        if ok and not answer_content_ok:
   299	            ok, why = False, f"敲對了指令,但答案缺關鍵事實: {miss_a}"
   300	    ever, first_idx = lumos_stats(calls)
   301	    return {"id": sc["id"], "cat": sc.get("cat"), "passed": ok, "reason": why, "first_tool": calls[0] if calls else None,
   302	            "n_calls": len(calls), "calls": calls, "secs": round(time.time() - t0, 1), "stderr": err if not ok else "",
   303	            "answer": (final or "")[:1500], "arm": arm, "ever_lumos": ever, "first_lumos_idx": first_idx,
   304	            "answer_content_ok": answer_content_ok, "limit_hit": False, "result_subtype": "codex", "harness": "codex",
   305	            "stop_block": stop_block, "thread_id": thread_id, "hook_trace": trace}
