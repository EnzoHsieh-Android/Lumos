   231	def _codex_hook_trace(thread_id):
   232	    """從 Codex 逐字稿數 hook 注入(developer 訊息含 lumos 標頭)與擋停續做(LUMOS-STOP 標頭)。
   233	    hook 要不要 fire 取決於這台機器審過信任沒(Projects/Codex完全支援_計劃 誠實界線)——沒 fire 的場要看得出來,不能默默算「Codex 沒理 lumos」。"""
   234	    if not thread_id:
   235	        return None
   236	    home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
   237	    hits = list(home.glob(f"sessions/*/*/*/rollout-*-{thread_id}.jsonl"))
   238	    if not hits:
   239	        return None
   240	    fired = stop_seen = 0
   241	    for line in hits[0].read_text(encoding="utf-8", errors="replace").splitlines():
   242	        if "LUMOS-STOP" in line:
   243	            stop_seen += 1
   244	        if '"role":"developer"' in line and "lumos" in line.lower():
   245	            fired += 1
   246	    return {"hooks_fired": fired, "stop_block_seen": stop_seen}
