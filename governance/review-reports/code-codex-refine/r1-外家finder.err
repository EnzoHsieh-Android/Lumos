   484	def _stop_block_dir() -> Path:
   485	    d = Path.home() / ".cache" / "lumos" / "stop-block"
   486	    try:
   487	        d.mkdir(parents=True, exist_ok=True); os.chmod(d, 0o700)
   488	        now = time.time()   # lazy 清超過一天的標記
   489	        for f in d.iterdir():
   490	            try:
   491	                if now - f.stat().st_mtime > 7 * 86400:   # 保留 7 天=「同 session 七天內只擋一次」的承諾
   492	                    f.unlink()
   493	            except OSError:
   494	                pass
   495	    except OSError:
   496	        pass
   497	    return d
