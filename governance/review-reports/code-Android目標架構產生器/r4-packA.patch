+        "ROOT": root_pkg,
+        # JSON 字串大致就是 Kotlin 字串字面值,只差 $ 會被當樣板(代碼審 r1 正確性席 F2)
+        "SCOPE_LIST": ", ".join(_j.dumps(s, ensure_ascii=False).replace("$", "\\$") for s in norm),
+        "SCOPE_TEXT": "、".join(f"`{s}`" for s in norm),
+        "NODE_TITLE": node.split("/")[-1],
+        "SWITCHES": sw_text,
+    }
+    return _arch_tpl_compose(blocks, switches, slots)
+
+
+def cmd_arch_template(stack, root_pkg, scopes, switches, node="Systems/Android目標架構", section=None):
+    """lumos arch-template android:照六個開關組出目標架構節點、arch_targets、舊檔清單(new-only)、Konsist 架構測試。
