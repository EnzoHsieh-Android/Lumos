+    under = {s: [f for f in tracked if f.startswith(s + "/")] for s in norm}
+    empty = [s for s in norm if not under[s]]
+    if empty:
+        return None, "這些 --scope 底下沒有任何 git 已追蹤的檔(打錯字,或模組還沒建檔):" + "、".join(empty)
+    return under, None
+
+
+def _arch_tpl_konsist_test(f):
+    """Konsist 0.17.3 會不會把這支檔當測試原始碼集(scopeFromProduction 不掃)。照它的算法(反組譯 KoScopeCreatorCore 查證):
+    原始碼集名稱=路徑第一個 /src/ 之後到下一個 / 的那段(沒有 /src/ 就是第一段),取冒號之後、轉小寫(Locale.ROOT),含 test 就是測試。
+    代碼審 r3 F23:原本用「路徑任一處 src/<含 test>/」的正規式,跟第一個 /src/ 的取法在多個 src/ 段時不同。"""
+    p = "/" + f
+    name = p.split("/src/", 1)[1] if "/src/" in p else f
+    return "test" in name.split("/", 1)[0].split(":")[-1].lower()
+
+
+def _arch_tpl_legacy_file(f):
+    """這支範圍內的檔要不要進舊檔清單:架構對齊會拿來審(跟分目標節點同一支判定 _arch_code_file),或架構測試會掃
+    (不在 Konsist 認的測試原始碼集裡的 .kt),兩邊有一邊會看就收。代碼審 r1 F4:原本自訂排除三種測試目錄,androidTest、
+    testFixtures 的舊檔沒進清單;r2 F1、F13:只照 _arch_code_file 又漏了 src/main 底下路徑有 test/ 段的正式程式,Konsist 照掃。"""
+    return _arch_code_file(f) or (f.endswith(".kt") and not _arch_tpl_konsist_test(f))
+
+
+def _arch_tpl_legacy(under):
+    """舊檔清單原文 → (JSON 文字, None) 或 (None, 原因)。收哪些檔見 _arch_tpl_legacy_file。"""
+    import json as _j
+    files = sorted({f for fs in under.values() for f in fs if _arch_tpl_legacy_file(f)})
+    bad = [f for f in files if '"' in f or "\\" in f or _path_special_chars(f)]
+    if bad:
+        return None, "這些檔名有雙引號、反斜線或控制字元,舊檔清單不收(先改名再跑):\n  " + "\n  ".join(repr(f) for f in bad)
+    return _j.dumps({"files": files}, ensure_ascii=False, indent=2) + "\n", None
+
+
+def _arch_tpl_print_preview(root, parts, node, scope0, root_pkg, sw_text):
+    """不帶 --print:四段預覽,每段前面一行標存放位置。"""
+    vrel = _arch_target_vault_rel(root, "HEAD") or "docs/<名>-knowledge/"
+    where = {
+        "node": f"存成 {vrel}{node}.md(存完跑 lumos lint {node})",
+        "targets": "把 arch_targets 併進 .lumos/config.json(已經有 arch_targets 就合併成一份,第一條命中算數)",
+        "legacy": f"存成 {_ARCH_LEGACY_REL}(採用之後不要重產)",
+        "test": f"存成 {_arch_tpl_test_path(scope0, root_pkg)}(位置照專案的單元測試目錄改;依賴 com.lemonappdev:konsist)",
+    }
+    print(f"預覽(開關:{sw_text});lumos 不寫任何檔,單段原文用 --print <段名> 取")
+    for k in _ARCH_TPL_PRINTS:
+        if parts[k] is None:
+            print(f"\n── {k}:--legacy all 不產舊檔清單 ──")
+            continue
+        print(f"\n── {k}:{where[k]} ──")
+        sys.stdout.write(parts[k])
+
+
+def _arch_tpl_targets(norm, node):
+    """每個範圍一條 <範圍>/** 的宣告,交給讀宣告的同一支函式讀一次;讀出的條數不同就拒絕 → (宣告 dict, None) 或 (None, 原因)。"""
+    targets = {"arch_targets": [{"path": f"{s}/**", "node": node} for s in norm]}
+    rules, warns = _arch_targets_config(targets)
+    if warns or len(rules) != len(norm):
+        return None, "產出的宣告讀宣告的函式讀不進去:" + ";".join(warns or [f"讀出 {len(rules)} 條,--scope 有 {len(norm)} 個"])
+    return targets, None
+
+
+def _arch_tpl_render(root, switches, root_pkg, norm, node, sw_text):
+    """讀開關資料檔、填佔位字、照開關組出 → ((節點, 測試檔), None) 或 (None, 原因)。"""
