+    got, why = _arch_tpl_render(root, switches, root_pkg, norm, node, sw_text)
+    if got is None:
+        return fail(f"開關資料檔 {_ARCH_TPL_ANDROID}:{why}")
+    parts = {"node": got[0], "targets": _j.dumps(targets, ensure_ascii=False, indent=2) + "\n", "legacy": legacy, "test": got[1]}
+    if section is not None:
