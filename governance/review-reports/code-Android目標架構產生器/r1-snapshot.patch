+
+
+def cmd_arch_template(stack, root_pkg, scopes, switches, node="Systems/Android目標架構", section=None):
+    """lumos arch-template android:照六個開關組出目標架構節點、arch_targets、舊檔清單(new-only)、Konsist 架構測試。
