+}
+_ARCH_TPL_PRINTS = ("node", "targets", "legacy", "test")
+_ARCH_TPL_BLOCK_RE = re.compile(r"^=== (node|rule|code|test) (\S+)( convention)?$")
+_ARCH_TPL_TEST_FUN_RE = re.compile(r"@Test\s+fun (\w+)\(\)")
+_ARCH_TPL_TEST_TAG_RE = re.compile(r"\[test:([A-Za-z_][A-Za-z0-9_]*)\]")
+_ARCH_TPL_ROOT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*")
+_ARCH_TPL_LEGACY_SKIP = ("src/test/", "src/androidTest/", "src/testFixtures/")   # 測試目錄不進舊檔清單(以斜線為界)
