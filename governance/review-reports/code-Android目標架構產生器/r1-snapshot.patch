+def _arch_tpl_blocks(text):
+    """開關資料檔 → [(種類, 條件 dict 或 None(一律), 是否命名慣例, 內文)];格式錯回 (None, 原因)。
+    條件裡的開關與選項要在 _ARCH_TPL_SWITCHES 裡(資料檔寫錯字不能靜默變成永遠不收)。"""
+    blocks, cur = [], None
+    for ln in text.split("\n"):
+        if ln.startswith("==="):
+            m = _ARCH_TPL_BLOCK_RE.match(ln)
+            if not m:
+                return None, f"看不懂的塊頭:{ln}"
+            cond = None
+            if m.group(2) != "*":
+                cond = {}
+                for part in m.group(2).split(","):
+                    k, eq, v = part.partition("=")
+                    if not eq or v not in _ARCH_TPL_SWITCHES.get(k, ()) or k in cond:
+                        return None, f"塊頭的條件寫錯:{ln}"
+                    cond[k] = v
+            cur = [m.group(1), cond, bool(m.group(3)), []]
+            blocks.append(cur)
+        elif cur is not None:
+            cur[3].append(ln)
+    if not blocks:
+        return None, "沒有任何塊"
+    return [(k, c, conv, "\n".join(body).strip("\n")) for k, c, conv, body in blocks], None
+
+
+def _arch_tpl_fill(text, slots):
+    """佔位字一次掃描替換;表外的佔位字回 (None, 名字)——資料檔多了產生器不認得的佔位字不能原樣漏進產出。"""
+    missing = sorted({m.group(1) for m in _NOTE_TEMPLATE_SLOT_RE.finditer(text) if m.group(1) not in slots})
+    if missing:
+        return None, "、".join(missing)
+    return _NOTE_TEMPLATE_SLOT_RE.sub(lambda m: slots[m.group(1)], text), None
+
+
+def _arch_tpl_compose(blocks, sw, slots):
+    """照開關組出 (節點, 測試檔);資料檔的問題(一塊不是剛好一支測試、兩支同名、表外佔位字)回 (None, 原因)。"""
+    node, test, funs = [], [], []
+    for kind, cond, _conv, body in blocks:
+        if cond and any(sw[k] != v for k, v in cond.items()):
+            continue
+        if kind in ("rule", "node"):
+            node.append("  " + body.strip() if kind == "rule" else body)
+            continue
+        test.append(body)
+        got = _ARCH_TPL_TEST_FUN_RE.findall(body) if kind == "test" else [None]
+        if len(got) != 1:
+            return None, f"一個 test 塊要剛好一支 @Test 函式,這塊有 {len(got)} 支"
+        funs += [f for f in got if f]
+    if len(set(funs)) != len(funs):
+        return None, "同一組開關收進了兩支同名的測試(資料檔的條件沒互斥)"
+    out = []
+    for part in ("\n".join(node) + "\n", "\n".join(test) + "\n"):
+        filled, bad = _arch_tpl_fill(part, slots)
+        if filled is None:
+            return None, f"資料檔有產生器不認得的佔位字:{bad}"
+        out.append(filled)
+    return tuple(out), None
+
