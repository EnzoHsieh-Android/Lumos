+    if r is None or r.returncode != 0:
+        return None, "git ls-files 跑不起來,算不出範圍底下有哪些檔"
+    tracked = sorted({nfc(x) for x in r.stdout.split("\0") if x})
+    under = {s: [f for f in tracked if f.startswith(s + "/")] for s in norm}
+    empty = [s for s in norm if not under[s]]
