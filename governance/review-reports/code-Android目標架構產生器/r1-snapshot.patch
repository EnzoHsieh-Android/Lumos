+    private fun inScope(path: String): Boolean {
+        val rel = relPath(path)
+        return scopeDirs.any { rel == it || rel.startsWith("$it/") } && rel !in legacyFiles
+    }
+
+    // 只取 {"files": [...]} 裡的字串;不為一個清單加 JSON 函式庫
+    private fun readLegacyFiles(f: File): Set<String> {
+        check(f.isFile) { "找不到舊檔清單 ${f.path}:這支測試照 new-only 產出,要靠它跳過舊檔(要全部照目標審,用 --legacy all 重產這支測試)" }
+        val text = f.readText(Charsets.UTF_8).removePrefix("﻿")
+        val key = Regex("\"files\"\\s*:\\s*\\[").find(text) ?: error("舊檔清單 ${f.path} 讀不出 files 陣列")
+        val out = mutableSetOf<String>()
+        var i = key.range.last + 1
+        while (true) {
+            while (i < text.length && (text[i].isWhitespace() || text[i] == ',')) i++
+            check(i < text.length) { "舊檔清單 ${f.path} 的 files 陣列沒有收尾" }
+            if (text[i] == ']') return out
+            check(text[i] == '"') { "舊檔清單 ${f.path} 的 files 陣列只能放字串" }
+            i++
+            val sb = StringBuilder()
+            while (true) {
+                check(i < text.length) { "舊檔清單 ${f.path} 有沒收尾的字串" }
+                val c = text[i++]
+                if (c == '"') break
+                if (c != '\\') {
+                    sb.append(c)
+                    continue
+                }
+                check(i < text.length) { "舊檔清單 ${f.path} 有沒收尾的跳脫字元" }
+                when (val e = text[i++]) {
+                    'u' -> {
+                        check(i + 4 <= text.length) { "舊檔清單 ${f.path} 的 \\u 跳脫不完整" }
+                        sb.append(text.substring(i, i + 4).toInt(16).toChar())
+                        i += 4
+                    }
+                    'n' -> sb.append('\n')
+                    't' -> sb.append('\t')
+                    'r' -> sb.append('\r')
+                    'b' -> sb.append('\b')
+                    'f' -> sb.append('\u000C')
+                    else -> sb.append(e)
+                }
+            }
+            out.add(nfc(sb.toString()))
+        }
+    }
