++def _cb3_mut(points, ln):
++    """那一行挑到的壞法 dict(沒有回 {})。"""
++    x = next((p for p in points or [] if p["line"] == ln), None)
++    return (x or {}).get("mutant") or {}
++
++
++def _cb3_ln(src, text):
++    """src 裡第一個內容等於 text 的行號(1 起)。"""
++    return src.split("\n").index(text) + 1
