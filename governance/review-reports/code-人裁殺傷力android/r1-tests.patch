+def _sra_repo(kt, path="app/Screen.kt", runner=_SRA_RUNNER, config=None, extra=None, exe=()):
+    """_srl_repo 的變形:被改檔的路徑與內容、假平台、設定、額外的 base 檔都可換;exe 裡的檔在 HEAD 提交帶執行權限
