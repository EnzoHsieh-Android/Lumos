+def _kill_fail_excerpt(out, wt, home=None):
+    """一次執行的輸出(_kill_run 回的全文)→ 失敗摘錄:先遮路徑(_kill_mask_paths)再挑錯誤行——以 _KILL_EXCERPT_HEADS 開頭、以 ` FAILED` 結尾,
+    或 `* What went wrong:` 那一行到下一個空行之前;每行截 _KILL_EXCERPT_LINE 字、依原順序接起來取前 _KILL_EXCERPT_MAX 字;
+    一行都挑不到才退回結尾 _KILL_EXCERPT_MAX 字。只用 \\n 切行(行尾的 \\r 去掉)。"""
+    text = _kill_mask_paths(out or "", wt, home)
+    picked, in_wrong = [], False
+    for ln in text.split("\n"):
+        ln = ln.rstrip("\r")
+        if in_wrong and not ln.strip():
