+        if ln.startswith("* What went wrong:"):
+            in_wrong = True
+        if in_wrong or ln.startswith(_KILL_EXCERPT_HEADS) or ln.endswith(" FAILED"):
+            picked.append(ln[:_KILL_EXCERPT_LINE])
+    if not picked:
