+# 殺傷力帳本的失敗摘錄(範圍 6):弱證據判定時挑出錯誤行,讓人看得懂為什麼紅(Gradle 的結尾是固定的 Try 提示,錯誤行在前面)
+_KILL_EXCERPT_LINE = 200
+_KILL_EXCERPT_MAX = 800
+_KILL_EXCERPT_HEADS = ("e: ", "error:", "E  ", "FAILED ")
+_KILL_EXCERPT_SHOW = 12
+_KILL_EXCERPT_VERDICTS = ("killed_unattributed", "timed_out_weak", "abort")
+
+
+def _kill_mask_paths(text, wt, home=None):
+    """輸出裡的隔離工作樹路徑(字面與 realpath;macOS 的 /var 與 /private/var)換成 <worktree>、使用者家目錄(字面與 realpath)換成 ~。
+    長的先換(字面是 realpath 的後綴時先換短的會留下 /private 前綴);工作樹先於家目錄。家目錄是空的或 / 不換。"""
+    home = os.path.expanduser("~") if home is None else home
+    for p, tag in ((wt, "<worktree>"), (home, "~")):
+        if not p or p == os.sep:
+            continue
+        for q in sorted({p, os.path.realpath(p)}, key=len, reverse=True):
+            text = text.replace(q, tag)
+    return text
+
+
+def _kill_fail_excerpt(out, wt, home=None):
+    """一次執行的輸出(_kill_run 回的全文)→ 失敗摘錄:先遮路徑(_kill_mask_paths)再挑錯誤行——以 _KILL_EXCERPT_HEADS 開頭、以 ` FAILED` 結尾,
+    或 `* What went wrong:` 那一行到下一個空行之前;每行截 _KILL_EXCERPT_LINE 字、依原順序接起來取前 _KILL_EXCERPT_MAX 字;
+    一行都挑不到才退回結尾 _KILL_EXCERPT_MAX 字。只用 \\n 切行(行尾的 \\r 去掉)。"""
+    text = _kill_mask_paths(out or "", wt, home)
+    picked, in_wrong = [], False
+    for ln in text.split("\n"):
+        ln = ln.rstrip("\r")
+        if in_wrong and not ln.strip():
+            in_wrong = False
+        if ln.startswith("* What went wrong:"):
+            in_wrong = True
+        if in_wrong or ln.startswith(_KILL_EXCERPT_HEADS) or ln.endswith(" FAILED"):
+            picked.append(ln[:_KILL_EXCERPT_LINE])
+    if not picked:
+        return text[-_KILL_EXCERPT_MAX:]
+    return "\n".join(picked)[:_KILL_EXCERPT_MAX]
+
+
+def _kill_res_excerpts(res, attr_excerpt, out, wt):
