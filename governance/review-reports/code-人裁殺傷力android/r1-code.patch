+# 人裁補的 import 一行的形狀(Projects/人裁殺傷力在真實Android專案跑得起來_計劃〈用詞〉補 import):ASCII 識別字、至少兩段,
+# 不收 *、as、反引號、尾隨空白;一律 fullmatch。最後一段是名稱。
+_KILL_IMPORT_RE = re.compile(r"import [A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+")
+_KILL_ALSO_MAX = 1   # 連帶替換這一版最多一筆(只由人裁的 --import 產生)
+
+
+def _kill_also_issue(r):
+    """臨時配方的連帶替換(also)格式 → 說明或空字串(沒有 also 鍵回空字串)。人裁(跑殺傷力前先驗一次)與 guard kill(套壞法前)共用這一支,
+    照 _kill_old_issue/_kill_new_issue 的先例(Projects/人裁殺傷力在真實Android專案跑得起來_計劃 範圍 2):also 是清單、最多 _KILL_ALSO_MAX 筆;
+    每筆的 old 是一整行(以換行結尾、只有一行)、new 以 old 開頭,多出來的那段以換行結尾、至少一行、每一行都是補 import 的形狀(_KILL_IMPORT_RE)。
+    行一律只用 \\n 切。"""
+    if "also" not in r:
+        return ""
+    also = r.get("also")
+    if not isinstance(also, list) or len(also) > _KILL_ALSO_MAX:
+        return f"連帶替換(also)格式不對:要是清單、最多 {_KILL_ALSO_MAX} 筆"
+    for a in also:
+        old, new = (a.get("old"), a.get("new")) if isinstance(a, dict) else (None, None)
+        if not isinstance(old, str) or not isinstance(new, str) or not old.endswith("\n") or old.count("\n") != 1:
+            return "連帶替換(also)格式不對:每筆的 old 要是一整行(以換行結尾、只有一行)、new 要是字串"
+        extra = new[len(old):] if new.startswith(old) else None
+        if not extra or not extra.endswith("\n") or not all(_KILL_IMPORT_RE.fullmatch(x) for x in extra[:-1].split("\n")):
+            return "連帶替換(also)只准在 old 那一行之後多加 import 行(多出來的每一行都要是 `import 套件.名稱`,以換行結尾)"
+    return ""
+
+
+def _kill_also_apply(text, also):
+    """主替換套好的全文再套連帶替換 → (新全文, None) 或 (None, 原因)。逐行(只用 \\n 切)找跟 old 那一行整行相等、而且後面還有換行的行,
+    恰好一行才換;0 行或多行回原因(guard kill 判 error,不是 drifted:also 每次由這次的 HEAD 現算,對不上就是錯)。"""
+    lines = text.split("\n")
+    for a in also:
+        want = a["old"][:-1]
+        hits = [i for i, ln in enumerate(lines[:-1]) if ln == want]
+        if len(hits) != 1:
+            return None, f"連帶替換的那一行在套完主替換的檔裡出現 {len(hits)} 次(要恰好一行整行相等)"
+        lines[hits[0]] = a["new"][:-1]
+    return "\n".join(lines), None
+
+
+def _kill_mutated(src, r, override):
+    """套壞法要寫回的全文 → (全文, None) 或 (None, 原因)。主替換照舊(第一處 old 換成 new);override(臨時配方)才認 also,
+    筆記宣告的配方帶了也不理(範圍 2)。"""
+    out = src.replace(r["old"], r["new"], 1)
+    if not override or "also" not in r:
+        return out, None
+    why = _kill_also_issue(r)
+    if why:
+        return None, why
+    return _kill_also_apply(out, r["also"])
+
