+def _codeloop_default_base(repo_root):
+    """手動 code-loop check 不帶範圍時的起點 → sha 或 None。候選:main/master 的 upstream、每個遠端追蹤的 main/master(列 refs/remotes,不靠 git remote 登記的名字)、本機 main/master,
+    找得到的全部交給 `git merge-base --all HEAD <候選…>` 一次算最近的共同祖先,多個時照 _push_pick_base 取歷史最長的。
+    ★不照固定順序取第一個★:原本先試本機 main,本機 main 落後遠端時會把別人已合併的改動算進範圍、印錯分級(2026-10-13 落後
+    52 個提交、誤判 tier=high);推送閘的起點早就因同一個理由改成全部候選一起算(_push_range_start 的說明)。"""
+    cands = ["main@{upstream}", "master@{upstream}"]
+    rr = _lens_git(repo_root, "for-each-ref", "--format=%(refname)", "refs/remotes")
+    cands += [ref for ref in (rr.stdout.split() if rr is not None and rr.returncode == 0 else [])
+              if ref.count("/") == 3 and ref.rsplit("/", 1)[1] in ("main", "master")]
+    cands += ["refs/heads/main", "refs/heads/master"]
+    shas = []
+    for c in cands:
+        sha = _lens_full_sha(repo_root, c)
+        if sha and sha not in shas:
+            shas.append(sha)
+    if not shas:
+        return None
+    r = _lens_git(repo_root, "merge-base", "--all", "HEAD", *shas)
+    bases = [b for b in (r.stdout.split() if r is not None and r.returncode == 0 else []) if _LENS_SHA_RE.match(b)]
+    if not bases:
+        return None
+    return _push_pick_base(repo_root, bases, None, "主線", "")[0]
