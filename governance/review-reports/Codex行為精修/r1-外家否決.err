   459	        return 0  # 寧可漏報
   460	
   461	    project_root_str = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd")
   462	    if not project_root_str:
   463	        return 0
   464	    project_root = Path(project_root_str)
   465	
   466	    # 閘門 0
   467	    graph_root = find_graph_root(project_root)
   468	    if graph_root is None:
