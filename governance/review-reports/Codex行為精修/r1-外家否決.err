   435	def _impact_missing(src_files, all_paths, project_root, graph_root, cap=8):
   436	    """跟 pre-commit/pre-push 同一條路:lumos impact --diff HEAD --sync-check --json(工作樹 vs HEAD),
   437	    取「固定席未動」的前 cap 篇。lumos 尋路同 impact-hook._find_lumos_script 的順序(PATH 先、repo 後);
   438	    rc 協定同它:rc≠0 視為沒資料,fail-open 回 []。"""
   439	    import json as _json, shutil as _shutil
   440	    lumos = _shutil.which("lumos") or (str(project_root / "scripts" / "lumos") if (project_root / "scripts" / "lumos").exists() else None)
   441	    if lumos is None:
   442	        return []
   443	    try:
   444	        r = subprocess.run([sys.executable, lumos, "impact", "--diff", "HEAD", "--sync-check", "--json", "--repo", str(project_root)],
   445	                           capture_output=True, text=True, timeout=25)
   446	        if r.returncode != 0 or not r.stdout.strip():
   447	            return []
   448	        d = _json.loads(r.stdout.strip().splitlines()[-1])
   449	    except Exception:
   450	        return []
   451	    miss = [m for m in (d.get("sync") or {}).get("missing", []) if m.get("pinned")]
   452	    miss.sort(key=lambda m: -m.get("score", 0))
   453	    return [m["node"] for m in miss[:cap]]
   454	
