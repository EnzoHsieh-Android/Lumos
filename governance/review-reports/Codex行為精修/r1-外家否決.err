   470	
   471	    # B 巡邏: queue 堆積就提醒 (在主邏輯前跑,獨立於 code-sync warning)
   472	    emit_queue_patrol(project_root)
   473	
   474	    # 閘門 1
   475	    transcript_path_str = payload.get("transcript_path", "")
   476	    if not transcript_path_str:
   477	        return 0
   478	    file_paths, bash_commands = collect_turn_actions(Path(transcript_path_str))
   479	    # #6: 補上 Bash rm/mv/cp/git mv/git rm 影響的檔案
   480	    file_paths = file_paths + extract_bash_file_paths(bash_commands, project_root)
   481	    if not file_paths and not bash_commands:
   482	        return 0
   483	
   484	    # 閘門 2
   485	    src_files = [f for f in file_paths if is_code_file(f, project_root)]
   486	    if not src_files:
