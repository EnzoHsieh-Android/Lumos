   488	
   489	    # 閘門 3
   490	    graph_touched_via_edit = any(is_graph_file(f, graph_root) for f in file_paths)
   491	    if graph_touched_via_edit or touched_graph_via_cli(bash_commands):
   492	        # 2026-08-22(圖譜同步覆蓋):動過圖譜不等於動對篇——拿 impact 算「跟你改的碼直接相關、
   493	        # 帶合約或出過事故、這輪卻沒動」的筆記點名。只提醒,不擋。
   494	        missing = _impact_missing(src_files, file_paths, project_root, graph_root)
   495	        if missing:
   496	            print("\n".join([
   497	                f"提醒:這一輪動了筆記,但 impact 說下面這些筆記跟你改的程式碼直接相關(合約 / 事故 / 直接相依),還沒動:",
   498	                *[f"   • {m}" for m in missing],
   499	                "確定不受影響就略過;受影響的現在補,別等到 pre-push。"]), file=sys.stderr)
   500	        return 0
   501	
   502	    # ── 印提醒 ──
   503	    project_root_resolved = project_root.resolve()
   504	    rel: list[str] = []
   505	    seen: set[str] = set()
   506	    for f in src_files:
   507	        try:
   508	            r = str(Path(f).resolve().relative_to(project_root_resolved))
   509	        except (ValueError, OSError):
   510	            r = f
   511	        if r not in seen:
   512	            seen.add(r)
   513	            rel.append(r)
   514	
   515	    try:
   516	        graph_rel = graph_root.resolve().relative_to(project_root_resolved)
   517	    except (ValueError, OSError):
   518	        graph_rel = graph_root
   519	
   520	    msg = [
   521	        f"提醒:這一輪改了 {len(rel)} 個程式碼檔,但知識筆記沒有跟著動:",
   522	        *[f"   • {r}" for r in rel],
   523	        "",
   524	        "程式碼只記「現在長怎樣」;為什麼這樣改、改動牽連到哪裡,要寫進筆記,下一個 session 才接得上。",
   525	        "筆記放在這裡:",
   526	        f"   {graph_rel}/",
   527	    ]
   528	
   529	    # #5: 反查改的檔案出現在哪幾篇筆記
   530	    mentions = find_notes_mentioning(rel, graph_root)
   531	    if mentions:
   532	        msg += ["", "這幾篇筆記有提到你改的檔案或名稱,最可能需要更新:"]
   533	        for stem, notes in mentions.items():
   534	            msg.append(f"   • {stem} → {', '.join(notes)}")
   535	
   536	    msg += [
   537	        "",
   538	        "通常要跟著改的是:受影響功能的說明(Systems)、這次驗證了什麼(Verification)、有做設計選擇的話寫進 decisions。",
   539	        "",
   540	        "如果這次只是改錯字、整理排版、重構但行為沒變,這條提醒可以略過。",
   541	    ]
   542	    print("\n".join(msg), file=sys.stderr)
   543	    return 0
