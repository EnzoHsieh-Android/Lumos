 26353	def _drift_state_findings(env, only=None):
 26354	    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
 26355	    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
 26356	    only=要算的路徑集合(None=全部)。"""
 26357	    out = []
 26358	    ti = build_typed_index(env)
 26359	    for rel, n in sorted(env.notes.items()):
 26360	        if only is not None and rel not in only:
 26361	            continue
 26362	        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
 26363	        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
 26364	            out += _drift_guard_findings(env, rel, n, st)
 26365	        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
 26366	            out += _drift_c2(env, rel)
 26367	        if ty == "verification":
 26368	            plans = _drift_c3_hit(env, rel, ti=ti)
 26369	            if plans:
 26370	                text = env_text(env, rel) or ""
 26371	                ln = _drift_field_line(text, "status")
 26372	                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
 26373	                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
 26374	        vu = n.fields.get("valid_under")
 26375	        vtxt = " ".join(as_list(vu)) if vu else ""
 26376	        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
 26377	            text = env_text(env, rel) or ""
 26378	            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
 26379	            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
 26380	                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
 26381	    return out
