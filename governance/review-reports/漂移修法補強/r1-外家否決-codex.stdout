 26384	def _drift_c2(env, rel):
 26385	    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
 26386	             if _drift_str(env.notes.get(p), "type") == "project"
 26387	             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
 26388	    if not plans:
 26389	        return []
 26390	    text = env_text(env, rel) or ""
 26391	    ln = _drift_field_line(text, "status")
 26392	    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
 26393	    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
 26394	             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]
 26395	
