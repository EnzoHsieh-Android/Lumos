 23638	def _nodehome_list(repo_root, where, oids=None):
 23639	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 23640	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。
 23641	    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。"""
 23642	    if where is None:
 23643	        return {}, []
 23644	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 23645	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 23646	    if raw is None:
 23647	        return None
 23648	    files, allp = {}, []
 23649	    for ent in raw.split(b"\0"):
 23650	        if not ent or b"\t" not in ent:
 23651	            continue
 23652	        meta, p = ent.split(b"\t", 1)
 23653	        parts = meta.split()
 23654	        if where == "index":
 23655	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 27650	    if kind == "c3":
 27651	        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + ">"]
 27652	    if kind == "c4":
 27653	        return [base + "   # 列證據、範本與預填好的 lumos set 整欄指令(c4 不自己寫檔)"]
 27654	    if kind == "probe":
 27655	        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
 27656	                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
 27657	    return [base]
