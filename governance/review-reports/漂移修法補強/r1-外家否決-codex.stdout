 28086	def _drift_fix_write(env, cx, res):
 28087	    """第 5 步(鎖內):從磁碟重讀,指紋要等於判定時的才寫(atomic_write_verify);寫入例外一律轉成錯誤。"""
 28088	    try:
 28089	        with _vault_write_lock(env.vault):
 28090	            if cx["path"].read_bytes() != cx["raw"]:
 28091	                return "判定之後這一篇被改過,沒寫;重跑一次"
 28092	            for dp, db in res.get("deps", []):
 28093	                try:
 28094	                    now = dp.read_bytes()
 28095	                except OSError:
 28096	                    now = None
 28097	                if now != db:
 28098	                    return f"判定之後它依賴的 {_esc_clean(str(dp.name), 120)} 被改過,沒寫;重跑一次"
 28099	            atomic_write_verify(cx["path"], res["new"], res["key"], res["check"])
 28100	    except (ValueError, RuntimeError, OSError) as ex:
 28101	        return f"寫不進去,筆記沒動:{ex}"
 28102	    return None
