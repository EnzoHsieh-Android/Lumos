 29222	def _delguard_parse_diff(diff_text, graph_root):
 29223	    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
 29224	    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
 29225	    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
 29226	    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
 29227	    2026-08-11 code-loop r1 C);stopword 表剔除;
 29228	    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
 29229	    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
 29230	    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
 29231	    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
 29232	    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
 29233	        ,"vault_diffs": {path: [line...]}}"""
 29234	    import re
 29235	    tok_re = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
 29236	
 29237	    def _flags(ln):
 29238	        m = re.search(r" b/(.+)$", ln)
 29239	        c = m.group(1) if m else None
 29240	        # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
 29241	        # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
 29242	        # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
 29243	        vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
 29244	        # 建置產物:任何深度都排(src/robin/ 不撞 bin/ 靠前面那個 "/" )
 29245	        # ★散文與帳本:只認 repo 根★(2026-09-06 代碼審 r1 外家席)——消費專案的
 29246	        # src/docs/parser.py、packages/governance/rules.py 很可能是真程式,不是散文;
 29247	        # 而且 git grep 那側的 :(exclude)docs 本來就只排根目錄、pre-commit 寫的也是
 29248	        # docs/*,三處要同一個語意才不會各自漂。
 29249	        excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
 29250	                                for seg in _DELGUARD_EXCLUDE_DIRS)
 29251	                            or any(c.startswith(seg) for seg in _DELGUARD_PROSE_DIRS)
 29252	                            or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
 29253	        return c, vault, excl
 29254	
 29255	    lines = diff_text.splitlines()
 29256	    # 第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔不收(文件提及不算「還活著」)
 29257	    added, cur, skip, in_binary = {}, None, True, False
 29258	    for ln in lines:
 29259	        if ln.startswith("diff --git"):
 29260	            cur, is_v, is_e = _flags(ln)
 29261	            skip = (cur is None) or is_v or is_e or cur.endswith(".md")
 29262	            in_binary = False
 29263	            continue
 29264	        if ln.startswith("Binary files"):
 29265	            in_binary = True
 29266	            continue
 29267	        if skip or in_binary:
 29268	            continue
 29269	        if ln.startswith("+") and not _delguard_is_diff_header(ln):
 29270	            added.setdefault(cur, set()).update(tok_re.findall(ln))
 29271	    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
 29272	    tokens, seen = [], set()
 29273	    vault_diffs, cur, is_vault, is_excl, in_binary = {}, None, False, False, False
 29274	    for ln in lines:
 29275	        if ln.startswith("diff --git"):
 29276	            cur, is_vault, is_excl = _flags(ln)
 29277	            in_binary = False
 29278	            continue
 29279	        if ln.startswith("Binary files"):
 29280	            in_binary = True
 29281	            continue
 29282	        if in_binary or cur is None:
 29283	            continue
 29284	        if is_vault and (ln.startswith("+") or ln.startswith("-")) and not _delguard_is_diff_header(ln):
 29285	            vault_diffs.setdefault(cur, []).append(ln)
 29286	            continue
 29287	        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
 29288	        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
 29289	        # (r2 code-loop 折入:N5)
 29290	        if is_vault or is_excl or cur.endswith(".md"):
 29291	            continue
 29292	        if ln.startswith("-") and not _delguard_is_diff_header(ln):
 29293	            fadd = added.get(cur) or frozenset()
 29294	            for t in tok_re.findall(ln):
 29295	                if t in _DELGUARD_STOP or t in fadd or t in seen:
 29296	                    continue
 29297	                seen.add(t); tokens.append(t)
 29298	    return {"tokens": tokens, "vault_diffs": vault_diffs}
 29299	
