 28015	        return st == "pass" and not any(x["kind"] in ("c5", "c1") for x in fs)
 28016	    more = f"(正式行綁了 {len(names)} 支,取第一支)" if len(names) > 1 else ""
 28017	    return {"new": new, "key": "status", "check": _guard_record_ok(synced), "handled": _handled,
 28018	            "extra": {"test": names[0]}, "texts": [], "deps": _drift_deps(cx, [home_rel]),
