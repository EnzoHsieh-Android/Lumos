 29337	def _delguard_vault_scan(tokens, conf, graph_root_abs, deadline_check=None):
 29338	    """回 [{"node": "Systems/憑證.md", "folder": "Systems", "line_no": int,
 29339	            "line": str(strip,截 160 字), "tokens": [..], "conf": "high"|"low"}...]
 29340	       排序: (conf!=high, folder!="Systems", node, line_no)——高信心先、Systems 先。
 29341	       deadline_check: 選用 callable(),os.walk 外層迴圈每檔呼叫一次;回 True 立即
 29342	       return 目前累積 hits(部分結果,呼叫端已知逾時語意)。"""
 29343	    import re, os
 29344	    if not tokens:
 29345	        return []
 29346	    rx = re.compile(r"\b(?:" + "|".join(map(re.escape, tokens)) + r")\b", re.ASCII)
 29347	    per = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 29348	    hits = []
 29349	    for dirpath, _dirs, files in os.walk(graph_root_abs):
 29350	        for fn in files:
 29351	            if deadline_check is not None and deadline_check():
 29352	                hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29353	                return hits
 29354	            if not fn.endswith(".md"):
 29355	                continue
 29356	            fp = os.path.join(dirpath, fn)
 29357	            rel = os.path.relpath(fp, graph_root_abs)
 29358	            folder = rel.split(os.sep, 1)[0]
 29359	            try:
 29360	                text = open(fp, encoding="utf-8", errors="replace").read()
 29361	            except OSError:
 29362	                continue
 29363	            for i, line in enumerate(text.splitlines(), 1):
 29364	                # 單巨檔也要能中止:只在 os.walk 外層檢查的話,一份幾十萬行的節點會整份掃完
 29365	                # 才輪到下一次檢查,deadline 直接超支(2026-08-11 code-loop r1 H)
 29366	                if deadline_check is not None and i % 2000 == 0 and deadline_check():
 29367	                    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29368	                    return hits
 29369	                if not rx.search(line):
 29370	                    continue
 29371	                ts = [t for t, p in per.items() if p.search(line)]
 29372	                hits.append({"node": rel.replace(os.sep, "/"), "folder": folder, "line_no": i,
 29373	                             "line": line.strip()[:160], "tokens": ts,
 29374	                             "conf": "high" if any(conf.get(t) == "high" for t in ts) else "low"})
 29375	    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 29376	    return hits
 29377	
