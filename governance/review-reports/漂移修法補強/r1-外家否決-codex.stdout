 28026	def _drift_fix_shape_err(root, texts):
 28027	    """工具要寫的自由文字先跑筆記形狀擋的同一支判定(_ns_check_line、_ns_revisit_violations)→ 錯誤或 None;
 28028	    不寫出一份提交前一定被擋的筆記。"""
 28029	    if not texts:
 28030	        return None
 28031	    lst = _nodehome_list(root, "index")
 28032	    if lst is None:
 28033	        return "git 列不出檔案清單,沒辦法先跑筆記形狀擋"
 28034	    files, reader = lst[0], _nodehome_reader(root, "index")
 28035	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 28036	
 28037	    def by_name(name):
 28038	        return [p for p in files if p.rsplit("/", 1)[-1] == name and _ns_is_code(p, reader, files)]
 28039	    for t, reg in texts:
 28040	        v = _ns_check_line(root, t, reg, files, reader, top_dirs, by_name) + _ns_revisit_violations(t, reg, True)
 28041	        if v:
 28042	            return f"要寫進去的文字過不了筆記形狀擋({v[0][0]}:{v[0][1]})——{v[0][2]}"
 28043	    return None
