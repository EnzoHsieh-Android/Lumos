 27779	def _drift_fix_load(env, rel, line, kind, o):
 27780	    """第 1、2 步:乾淨檢查(--dry-run 不做)、讀那一篇(BOM、CRLF 拒絕)、鎖外新建圖譜物件確認那一行現在是這一種發現。"""
 27781	    root, vault_rel = _drift_vault_of(env)
 27782	    path = _phys_path(env.vault, rel)
 27783	    try:
 27784	        if path.is_symlink() or path.stat().st_nlink != 1:
 27785	            return None, (f"{rel} 是符號連結或還有別的硬連結——工具用換檔的方式寫入,會把連結換成一般檔、或讓兩邊內容分岔"
 27786	                          "(代碼審 r1 邊界席);手動改")
 27787	        lines, _s, fe = load_raw_for_edit(path)
 27788	    except (ValueError, OSError, UnicodeDecodeError) as ex:
 27789	        return None, f"{rel} 打不開:{ex}"
 27790	    cx = {"root": root, "rel": rel, "repo_rel": f"{vault_rel}/{rel}", "path": path, "lines": lines, "fe": fe,
 27791	          "raw": "\n".join(lines).encode("utf-8"), "kind": kind, "line": line, "o": o}
 27792	    if not o.get("dry_run") and kind != "c4":    # 只看、不寫的兩條路不做乾淨檢查(c4 只列證據)
 27793	        err = _drift_fix_clean_err(root, cx["repo_rel"], cx["raw"])
 27794	        if err:
 27795	            return None, err
 27796	    cx["env2"] = Env(env.vault)
 27797	    cx["f"], err = _drift_current_finding(cx["env2"], rel, line, kind)
 27798	    return (None, err) if err else (cx, None)
