 17822	def _is_toolchain_repo(root):
 17823	    """這個 repo 是不是工具鏈本體(那裡 scripts/lumos 就是產品,不能當成外來的跳過)。
 17824	
 17825	    ★判別鍵沿用既有慣例★(見 `_self_repo_origin`):skills/lumos-project-notes/SKILL.md
 17826	    是 user-scope skill 的唯一源,永遠不會被複製進消費專案。"""
 17827	    try:
 17828	        return (Path(root) / "skills" / "lumos-project-notes" / "SKILL.md").is_file()
 17829	    except Exception:
 17830	        return False
