 27791	          "raw": "\n".join(lines).encode("utf-8"), "kind": kind, "line": line, "o": o}
 27792	    if not o.get("dry_run") and kind != "c4":    # 只看、不寫的兩條路不做乾淨檢查(c4 只列證據)
 27793	        err = _drift_fix_clean_err(root, cx["repo_rel"], cx["raw"])
 27794	        if err:
 27795	            return None, err
 27796	    cx["env2"] = Env(env.vault)
 27797	    cx["f"], err = _drift_current_finding(cx["env2"], rel, line, kind)
 27798	    return (None, err) if err else (cx, None)
