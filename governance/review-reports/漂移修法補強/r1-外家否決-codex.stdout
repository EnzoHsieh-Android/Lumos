 27895	def _drift_append_note(body, txt):
 27896	    """正文最後一個非空行之後、隔一個空行加一行,檔尾一個換行;正文為空就放在開頭欄位結束那行之後。
 27897	    正文最後落在沒閉合的程式碼圍欄裡擋下(用 _visible_lines 判:加一行試探,看得見才算在圍欄外)。"""
 27898	    probe = [*body, "lumos-drift-probe"]
 27899	    if len(probe) not in {no for no, _ln in _visible_lines(probe)}:
 27900	        return None, "正文最後停在沒閉合的程式碼圍欄裡,不知道要加在哪——先把圍欄關好"
 27901	    last = max((i for i, ln in enumerate(body) if ln.strip()), default=None)
 27902	    if last is None:
 27903	        return [txt, ""], None
 27904	    return [*body[:last + 1], "", txt, ""], None
