 27753	def _drift_fix_last_sha(root, repo_rel):
 27754	    """修復帳裡這一篇最後一筆(seq 最大)的 after_sha256;沒有回 None。"""
 27755	    rows = [d for d in _drift_jsonl_rows(Path(root) / _DRIFT_FIXES) if nfc(str(d.get("path", ""))) == nfc(repo_rel)]
 27756	    if not rows:
 27757	        return None
 27758	    return _drift_bound_latest(rows)[-1].get("after_sha256")
