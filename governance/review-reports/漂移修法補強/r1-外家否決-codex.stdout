 26342	def _drift_linked(env, rel):
 26343	    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
 26344	    out_e, in_e = env.edges
 26345	    got = {}
 26346	    for d in out_e.get(rel, []):
 26347	        got[d] = "out"
 26348	    for s in in_e.get(rel, []):
 26349	        got[s] = "both" if s in got else "in"
 26350	    return got
 26351	
