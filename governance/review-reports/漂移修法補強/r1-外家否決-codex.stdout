 12294	def _guard_touched_hits(files, touched):
 12295	    """家節點管的那些檔,跟這次改到的檔對得上哪幾個。回 (對上的清單, 是不是只在忽略大小寫時才對上)。
 12296	
 12297	    ★比對鍵走既有那支★(代碼審 r2 架構席 blocker):about_code 的比對鍵全 repo 只有一個算法
 12298	    `_nodehome_key`(路徑正規化 + NFC),2026-09-10 那輪代碼審就是為了收斂「三處各寫一份、
 12299	    各版解得不一樣」才立的。第一版自己刻了一份,解不了 `a/../b`——而那正是這個 repo
 12300	    自己認證過、也修過一次的人手寫法,漏掉的話該擋的推送會安靜放行。
 12301	
 12302	    在那之上多兩條**只會多擋、不會少擋**的保險:家節點寫的是資料夾(看底下的檔)、只有忽略大小寫
 12303	    才對得上。寫入端(`_about_code_path`)確實已經擋掉這兩種寫法(要求是檔案、大小寫要跟磁碟一致),
 12304	    所以走指令寫進去的不會踩到;留著是因為★寫入端的保證不等於讀取端的保證★——開頭欄位可以被手改,
 12305	    而這一層漏掉是沒人會發現的(多擋一次訊息會講清楚為什麼)。
 12306	    """
 12307	    tset = {_nodehome_key(x) for x in touched}
 12308	    tset.discard("")
 12309	    hits, only_case = [], []
 12310	    for raw in files:
 12311	        f = _nodehome_key(raw)
 12312	        if not f:
 12313	            continue
 12314	        if f in tset:
 12315	            hits.append(raw)
 12316	            continue
 12317	        under = sorted(x for x in tset if x.startswith(f + "/"))
 12318	        if under:
 12319	            hits.append(f"{raw}(底下的 {under[0]})")
 12320	            continue
 12321	        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上
 12322	        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。
 12323	        same = sorted(x for x in tset if x.lower() == f.lower())
 12324	        if same:
 12325	            hits.append(f"{raw}(大小寫不同:{same[0]})")
 12326	            only_case.append(raw)
 12327	    return hits, only_case
