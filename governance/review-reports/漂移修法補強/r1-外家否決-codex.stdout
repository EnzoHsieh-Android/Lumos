 29423	def cmd_delguard_check(repo=None, as_json=False):
 29424	    """code 側刪除傳播守衛(advisory):staged diff 抽被刪 token → 兩檔信心 → grep vault 指名過期原句。
 29425	    恆 rc0(內部錯誤/超時皆 fail-open 放行;唯一輸出差異是訊息)。
 29426	    vault-free repo(找不到 graph root)→ 靜默 rc0,不掃。
 29427	    --json 降級契約(超時/內部錯誤皆同款):單行合法 JSON
 29428	    {"tokens": int, "hits": [], "fake_sync": [], "degraded": true, "reason": "timeout"|"error"},rc0。"""
 29429	    import json, os, subprocess, time
 29430	    t0 = time.monotonic()
 29431	    try:  # 亂設的 env 不該讓 pre-commit 印 traceback(fail-open 契約覆蓋設定錯誤)
 29432	        deadline = float(os.environ.get("LUMOS_DELGUARD_DEADLINE", "15.0"))  # 5.0 在本 repo(377 篇+大 diff)仍常超,2026-08-27 一 session 降級多次→15;advisory fail-open,pre-commit 多等幾秒換掃完整
 29433	    except (ValueError, TypeError):
 29434	        deadline = 15.0   # s1-f2:兜底跟預設一致(原 2.0,主值調 15 後落差 7.5 倍→非數值 env 悄悄退化只給 2 秒)
 29435	    def _over():
 29436	        return time.monotonic() - t0 > deadline
 29437	    def _degraded_json(reason, n_tokens):
 29438	        print(json.dumps({"tokens": n_tokens, "hits": [], "fake_sync": [],
 29439	                          "degraded": True, "reason": reason}, ensure_ascii=False))
 29440	    tokens = []
 29441	    try:
 29442	        if os.environ.get("LUMOS_DELGUARD_RAISE"):
 29443	            raise RuntimeError("test hook")
 29444	        root = str(_cochange_repo_root(repo) or os.getcwd())
 29445	        gr = find_vault(Path(root))  # 既有 vault 偵測 helper;找不到→靜默 rc0(vault-free repo 不掃)
 29446	        if not gr:
 29447	            return 0
 29448	        gr_rel = os.path.relpath(gr, root).replace(os.sep, "/")
 29449	        # standalone vault repo(整個 repo 就是 vault,graph_root=".")→ 沒有 code 側可守,
 29450	        # 且 "." 前綴會讓每個檔都判成 vault、路徑相對計算全歪 → 靜默 rc0(2026-08-11 code-loop r1 E)
 29451	        if gr_rel == ".":
 29452	            return 0
 29453	        # diff 前綴固定:使用者 ~/.gitconfig 若設 diff.noprefix / diff.mnemonicPrefix,
 29454	        # 檔頭會變成 `--- app/x` 或 `--- i/app/x`,` b/` 抽檔名整條失效 → token 全漏(r1 D)
 29455	        r = subprocess.run(["git", "-c", "core.quotePath=off",
 29456	                            "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
 29457	                            "diff", "--no-ext-diff", "--no-textconv", "--cached", "-M", "--no-color"],
 29458	                           capture_output=True, text=True, errors="replace", cwd=root,
 29459	                           timeout=max(0.1, deadline - (time.monotonic() - t0)))
 29460	        if r.returncode != 0:
 29461	            # ★不得靜默吞★:git diff 失敗時 r.stdout 恆空,若不擋下去會被
 29462	            # _delguard_parse_diff 解析成「tokens=0」——長得像掃描乾淨的成功結果,
 29463	            # 實際是沒掃到東西的失敗(r2 code-loop 折入:N3①)。丟進既有 except
