 28157	def cmd_drift_fix(env, node, line, kind, o):
 28158	    """lumos drift fix <節點> <行號> --kind c1..c5 [--dry-run] [種類專屬參數](Projects/存量漂移改法_計劃 第 1 節)。
 28159	    順序:乾淨檢查 → 鎖外讀與判定、前提、git 查詢 → 算改後內容、自由文字先過形狀擋 → (--dry-run 到此)→
 28160	    鎖內比指紋寫入 → 鎖外驗證磁碟內容與「已處理」→ 寫修復帳。不自動還原:改之前保證了 git 退得回來。"""
 28161	    err = _drift_fix_args_err(kind, o)
 28162	    rel = None
 28163	    if err is None:
 28164	        rel, err = _drift_fix_target(env, node)
 28165	    if err is None and kind == "c2" and o.get("keep"):
 28166	        return cmd_drift_ack(env, rel, line, "c2", o["reason"], dry_run=bool(o.get("dry_run")))   # 照留:等同帶清單的 c2 表態
 28167	    cx = None
 28168	    if err is None:
 28169	        cx, err = _drift_fix_load(env, rel, line, kind, o)
 28170	    res = None
 28171	    if err is None:
 28172	        res, err = _DRIFT_FIX_COMPUTE[kind](cx)
 28173	        if err is None and res is None:
 28174	            return 0                                                 # c4 只列證據與範本
 28175	    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
 28176	    if err is None and o.get("dry_run"):
 28177	        _drift_fix_preview(cx, res)
 28178	        return 0
 28179	    # 帳檔路徑在寫筆記之前先查(代碼審 r1 邊界席:原本寫完筆記才發現帳寫不進去,留下改了筆記、沒帳、又不讓重跑的狀態)
 28180	    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
 28181	    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
 28182	    if err:
 28183	        print(f"擋下:{err}", file=sys.stderr)
 28184	        return 2
 28185	    if _drift_fix_record(env, cx, res) != 0:
 28186	        return 2
 28187	    print(f"✓ drift fix {kind}:{_esc_clean(rel, 200)} 第 {line} 行——{res['msg']}")
 28188	    if kind == "c2":
 28189	        _issue_close_revisits(env, rel, o["status"])
 28190	    print(f"修復帳要跟筆記一起提交:\n    {_drift_git_hint(cx, 'add ' + _DRIFT_FIXES)} && git commit")
 28191	    return 0
