 27993	def _drift_fix_c5(cx):
 27994	    """c5:轉正做了一半——只改守衛紀錄(status 改 pass、同步標籤、四種預告句改寫;跟 settle 第二步同一支算內容)。"""
 27995	    import datetime
 27996	    lines, fe = cx["lines"], cx["fe"]
 27997	    m = re.search(r"^預告的合約:(.+)$", "\n".join(lines), re.M)
 27998	    home_rel = (cx["f"].get("related") or [None])[0]
 27999	    htext = env_text(cx["env2"], home_rel) if home_rel and m else None
 28000	    if htext is None:
 28001	        return None, "讀不出預告的合約或家節點"
 28002	    claim, hl = m.group(1).strip(), htext.split("\n")
 28003	    he = _drift_fm_end(hl)
 28004	    if _guard_planned_idx(hl, he, claim):
 28005	        return None, f"家節點 {home_rel[:-3]} 同時有預告行與正式行,先手動刪掉預告行再跑"
 28006	    fi = _guard_formal_line(hl, he, claim, None)
 28007	    names, err = _drift_c5_test(cx["root"], hl[fi]) if fi is not None else (None, "家節點找不到綁了測試的正式行")
 28008	    if err:
 28009	        return None, err
 28010	    new, _missing, synced = _guard_settle_record_lines(lines, fe, home_rel, datetime.date.today().isoformat())
 28011	
 28012	    def _handled(fs, txt):
 28013	        fm, _b = split_frontmatter(txt)
 28014	        st = str(parse_frontmatter(fm)[0].get("status", "")) if fm is not None else ""
 28015	        return st == "pass" and not any(x["kind"] in ("c5", "c1") for x in fs)
 28016	    more = f"(正式行綁了 {len(names)} 支,取第一支)" if len(names) > 1 else ""
