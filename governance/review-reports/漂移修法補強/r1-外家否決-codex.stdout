 28046	def _drift_fix_changes(old, new):
 28047	    """改前改後 → [{line, before, after}]:line 是改前的行號;新插入的行 line、before 記 null;刪掉的行 after 記 null。"""
 28048	    import difflib
 28049	    out = []
 28050	    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
 28051	        if tag == "equal":
 28052	            continue
 28053	        for k in range(max(i2 - i1, j2 - j1)):
 28054	            b = old[i1 + k] if i1 + k < i2 else None
 28055	            out.append({"line": i1 + k + 1 if b is not None else None, "before": b,
 28056	                        "after": new[j1 + k] if j1 + k < j2 else None})
 28057	    return out
 28058	
