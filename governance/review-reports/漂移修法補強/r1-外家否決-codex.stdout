 29301	def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
 29302	    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
 29303	    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
 29304	    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
 29305	    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
 29306	    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
 29307	    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
 29308	    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
 29309	    import re, subprocess
 29310	    if not tokens:
 29311	        return {}
 29312	    cmd = ["git", "-c", "core.quotePath=off", "grep", "--cached", "-n", "-I", "-w", "-F"]
 29313	    for t in tokens:
 29314	        cmd += ["-e", t]
 29315	    cmd += ["--", ".", f":(exclude){graph_root}"]
 29316	    for d in _DELGUARD_ALL_EXCLUDE_DIRS:
 29317	        cmd += [f":(exclude){d.rstrip('/')}"]
 29318	    r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", cwd=repo_root, timeout=timeout)
 29319	    if r.returncode > 1:
 29320	        raise RuntimeError(f"git grep rc={r.returncode}: {r.stderr.strip()[:200]}")
 29321	    alive = set()
 29322	    pats = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 29323	    for line in r.stdout.splitlines():
 29324	        # ★只對內容域配 token★:git grep 輸出是 `path:lineno:content`,連路徑一起配
 29325	        # 會被檔名撞名誤降級(刪掉 Login() → app/Login.kt 這個路徑本身讓 Login 判 low,
 29326	        # 2026-08-11 code-loop r1 B)。len<3 的行(如 `Binary file … matches`)直接丟。
 29327	        parts = line.split(":", 2)
 29328	        if len(parts) < 3:
 29329	            continue
 29330	        content = parts[2]
 29331	        for t, p in pats.items():
 29332	            if t not in alive and p.search(content):
 29333	                alive.add(t)
 29334	    return {t: ("low" if t in alive else "high") for t in tokens}
 29335	
