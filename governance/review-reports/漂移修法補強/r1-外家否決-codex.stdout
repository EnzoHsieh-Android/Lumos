 27815	def _drift_deps(cx, rels):
 27816	    """判定依賴的其他筆記(c1、c5 的家節點)此刻的位元組 → [(路徑, 位元組)];寫入時在鎖內再比一次,判定之後被改過就不寫
 27817	    (代碼審 r1 併發席:鎖內原本只比守衛紀錄那一篇)。建圖譜物件到這裡的時間差不處理(〈誠實界線〉)。"""
 27818	    out = []
 27819	    for r in rels:
 27820	        if not r:
 27821	            continue
 27822	        p = _phys_path(cx["env2"].vault, r)
 27823	        try:
 27824	            out.append((p, p.read_bytes()))
 27825	        except OSError:
 27826	            out.append((p, None))
 27827	    return out
