 26309	def _drift_c3_hit(env, vrel, override=None, ti=None):
 26310	    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
 26311	    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
 26312	    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
 26313	    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
 26314	    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
 26315	    n = env.notes.get(vrel)
 26316	    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
 26317	        return None
 26318	    if GUARD_MARK_FIELD in n.fields:
 26319	        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
 26320	    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
 26321	    if not refs:
 26322	        return None
 26323	    ti = ti if ti is not None else build_typed_index(env)
 26324	    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
 26325	    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
 26326	    if any(not link_target(x) for x in refs) \
 26327	            or any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
 26328	            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
 26329	        return None
 26330	    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
 26331	    if not plans:
 26332	        return None
 26333	    for prel in plans:
 26334	        pn = env.notes.get(prel)
 26335	        if pn is None or _drift_str(pn, "type") != "project":
 26336	            return None
 26337	        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
 26338	            return None
 26339	    return plans
