 29379	def _delguard_purelink(diff_lines):
 29380	    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
 29381	       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
 29382	       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
 29383	       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
 29384	       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
 29385	    import re
 29386	    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
 29387	    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
 29388	    plus = [ln[1:] for ln in diff_lines
 29389	            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
 29390	    minus = [ln[1:] for ln in diff_lines
 29391	             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
 29392	    changed = plus + minus
 29393	    if not changed:
 29394	        return False
 29395	    ms = {c.strip() for c in minus}
 29396	    if any(p.strip() in ms for p in plus):
 29397	        return False
 29398	    return all(item_re.match(c) or key_re.match(c) for c in changed)
 29399	
