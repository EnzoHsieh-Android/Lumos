 27928	def _drift_c4_key(s):
 27929	    """卷證目錄比對用的名字:去 _計劃、NFC、不分大小寫、. 與空白轉連字號。"""
 27930	    s = nfc(str(s))
 27931	    s = s[:-3] if s.endswith("_計劃") else s
 27932	    return re.sub(r"[.\s]+", "-", s).lower()
