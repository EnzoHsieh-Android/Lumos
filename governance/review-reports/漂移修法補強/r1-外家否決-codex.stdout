 27923	    fm, ok = _drift_fm_status(lines, fe, st)
 27924	    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c3"),
 27925	            "extra": {}, "texts": [(txt, "body")], "msg": f"status 改成 {st},正文最後加了一行說明"}, None
