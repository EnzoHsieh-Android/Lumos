 26272	def _drift_fm_end(lines):
 26273	    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
 26274	    if not lines or lines[0].strip() != "---":
 26275	        return 0
 26276	    for i in range(1, len(lines)):
 26277	        if lines[i].strip() == "---":
 26278	            return i
 26279	    return 0
