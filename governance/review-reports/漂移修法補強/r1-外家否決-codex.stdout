 17748	def _vendored_manifest_write(root):
 17749	    """把工作目錄裡「工具自裝檔」的內容指紋寫進 .lumos/vendored.json(安裝與更新時呼叫;回寫進去的 {路徑: 指紋})。"""
 17750	    files = {}
 17751	    for rel in sorted(_VENDORED_ALL):
 17752	        p = Path(root) / rel
 17753	        if p.is_file():
 17754	            files[rel] = _vendored_digest(p.read_bytes())
 17755	    mp = Path(root) / _VENDORED_MANIFEST
 17756	    mp.parent.mkdir(parents=True, exist_ok=True)
 17757	    # 格式跟錨點基準線同一種({"version": 1, <路徑: sha256>…};第四輪架構席)。不走錨點那種「人核可才改」的流程:
 17758	    # 這份是安裝時的事實紀錄,錯了的方向是「多掃」不是「少擋」。ensure_ascii:從某版本讀回來走的是文字模式的 git show
