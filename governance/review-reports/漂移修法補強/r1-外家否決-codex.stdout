 27987	                                                      pd["default_platform"])]
 27988	    except (ValueError, OSError) as ex:
 27989	        return None, f"解不出正式行綁的測試:{ex}"
 27990	    return (names, None) if names else (None, "家節點的正式行沒有綁測試")
