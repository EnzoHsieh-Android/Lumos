 27761	def _drift_fix_clean_err(root, repo_rel, raw):
 27762	    """乾淨檢查 → 錯誤或 None:那一篇要在 git 裡有追蹤,而且跟 HEAD 沒差,或現在的指紋等於修復帳裡這一篇最後一筆的
 27763	    after_sha256(改動全是工具自己留下的,同一篇可以一項一項修、修完一起提交)。"""
 27764	    import hashlib
 27765	    ps = _git_paths_nfc(root, repo_rel)
 27766	    if not ps:
 27767	        return f"{repo_rel} 沒被 git 追蹤(或 git 查不到)——不在版控裡,改壞了退不回來;先提交"
 27768	    if len(ps) > 1:
 27769	        return f"{repo_rel} 這個名字在 git 裡有 {len(ps)} 種 Unicode 拼法的檔並存,工具分不出要改哪一篇;先手動整理成一篇"
 27770	    gp = ps[0]
 27771	    r = _lens_git(root, "--literal-pathspecs", "diff", "--no-ext-diff", "--no-textconv", "--quiet", "HEAD", "--", gp)   # 檔名裡的 * 不當萬用字元(r4 邊界、外家)
 27772	    if r is None or r.returncode not in (0, 1):
 27773	        return "git 查詢失敗或逾時(git diff HEAD),查不出這一篇乾不乾淨"
 27774	    if r.returncode == 0 or _drift_fix_last_sha(root, repo_rel) == hashlib.sha256(raw).hexdigest():
 27775	        return None
 27776	    return f"{repo_rel} 有未提交的改動(不是 drift fix 自己留下的)——先提交或還原再修"
