 15128	def _set_conditions_locked(env, rel, key, values):
 15129	    """驗收紀錄的前提/回頭條件整欄換掉(Projects/驗收前提欄位可改_計劃)。
 15130	
 15131	    ★為什麼整欄換、不走 append/remove★:這兩欄是散文、常提到連結;append/remove 判斷「同一項」看連結目標,
 15132	    兩條提到同一篇的不同條件會被當成重複。原本四種寫法(單行、清單、空的、多行區塊)並存,一律整段拿掉重寫。"""
 15133	    vals = [str(v).strip() for v in values]
 15134	    if any(_SET_COND_SLOT in v for v in vals):
 15135	        print(f"擋下:值裡還留著 {_SET_COND_SLOT}(drift fix 證據頁的佔位字)——換成那一項改寫後的整句,檔案沒動", file=sys.stderr)
 15136	        return 2
 15137	    if not vals or any(not v for v in vals):
 15138	        print(f"擋下:{key} 的每一條都不能是空的,檔案沒動(前提寫這個結論在什麼情況下才算數,回頭條件寫改到什麼該重驗)",
 15139	              file=sys.stderr)
 15140	        return 2
 15141	    if any("\n" in v or "\r" in v for v in vals):
 15142	        print(f"擋下:{key} 一條條件只能一行,檔案沒動(要寫多條就給多個值:lumos set <筆記> {key} \"條件一\" \"條件二\")",
 15143	              file=sys.stderr)
 15144	        return 2
 15145	    path = env.vault / rel
 15146	    lines, _s, e = load_raw_for_edit(path)
 15147	    fm = list(lines[1:e])
 15148	    new = ([f"{key}: {fmt_scalar(key, vals[0])}"] if len(vals) == 1
 15149	           else [f"{key}:"] + [f"  - {fmt_scalar(key, v)}" for v in vals])
 15150	    struct = {k: (a, b) for k, a, b, _kind in fm_structure(fm)}
 15151	    if key in struct:
 15152	        a, b = struct[key]
 15153	        fm[a:b + 1] = new
 15154	    else:   # 插的位置照 edit_fm_scalar:第一個清單或多行區塊欄位之前,都沒有就放最後
 15155	        at = next((a for _k, a, _b, kind in fm_structure(fm) if kind in ("list", "block")), len(fm))
 15156	        fm[at:at] = new
 15157	    atomic_write_verify(path, lines[:1] + fm + lines[e:], key, lambda f: _conds(f.get(key)) == vals)
 15158	    print(f"✓ set {rel}: {key} 整欄換成 {len(vals)} 條" + ("" if len(vals) == 1 else "(一行一項的清單)"))
 15159	    return 0
