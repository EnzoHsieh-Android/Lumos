 17833	def _vendored_skip(root, diff_range):
 17834	    """消費專案裡這段範圍要跳過的工具檔(工具鏈本體回空集合)。推送前分級與代碼審角色鏡頭共用這一支,見 _vendored_state:
 17835	    終點上原封不動的工具檔;終點上已經刪掉、但起點時原封不動的(拆除工具鏈)也跳。"""
 17836	    if _is_toolchain_repo(root):
 17837	        return frozenset()
 17838	    _start, _end = _diff_range_ends(root, diff_range)
 17839	    _intact_end, _present_end = _vendored_state(root, _end)
 17840	    _intact_start = _vendored_state(root, _start)[0] if _start else frozenset()
 17841	    return _intact_end | (_intact_start - _present_end)
