 12274	def _guard_pass_rewrite(env, root, repo_rel, glines, date_arg):
 12275	    """已 pass 但還留著預告句的守衛紀錄 → (改寫後的行, 找不到的句型, 用的日期, 錯誤)。前提、日期、不疊都在這裡;
 12276	    guard settle 與 drift fix --kind c1 共用(drift 往下呼叫 guard,guard 不呼叫 drift)。"""
 12277	    home_rel, err = _guard_pass_home(env, glines)
 12278	    if err:
 12279	        return None, None, None, err
 12280	    ops = _guard_prose_ops(glines)
 12281	    day = None
 12282	    if _guard_prose_needs_date(ops):
 12283	        day, err = _guard_settled_date(root, repo_rel, glines, date_arg)
 12284	        if err:
 12285	            return None, None, None, err
 12286	    elif date_arg is not None:
 12287	        day, err = _guard_date_arg(date_arg)
 12288	        if err:
 12289	            return None, None, None, err
 12290	    new, missing = _guard_settle_rewrite(glines, day, home_rel[:-3])
 12291	    return new, missing, day, None
