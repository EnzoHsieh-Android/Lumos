 27722	                "照留就 lumos drift ack <節點> <行號> --kind probe --reason \"<為什麼照留>\"")
 27723	    if kind not in _DRIFT_FIX_KINDS:
 27724	        return f"--kind 只能是 {'/'.join(_DRIFT_FIX_KINDS)}"
 27725	    extra = {k for k in _DRIFT_FIX_OPTS if o.get(k) not in (None, False)} - _DRIFT_FIX_ALLOWED[kind]
 27726	    if extra:
 27727	        return f"--kind {kind} 不收 " + "、".join("--" + x for x in sorted(extra))
 27728	    if o.get("date") is not None:
 27729	        _d, err = _guard_date_arg(o["date"])
