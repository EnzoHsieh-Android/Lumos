 28062	    for ch in _drift_fix_changes(cx["lines"], res["new"]):
 28063	        if ch["before"] is not None:
 28064	            print(f"  - 第 {ch['line']} 行:{_esc_clean(ch['before'], 200)}")
 28065	        if ch["after"] is not None:
 28066	            print(f"  + {_esc_clean(ch['after'], 200)}")
