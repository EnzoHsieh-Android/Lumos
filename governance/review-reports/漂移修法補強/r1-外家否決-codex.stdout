 27881	def _drift_fix_by(env, by):
 27882	    """--by → (完整相對路徑去 .md, 錯誤)。完整路徑直接查那一篇;短名看 by_stem,找不到或同名好幾篇擋。"""
 27883	    a = nfc(str(by).strip())
 27884	    a = a[:-3] if a.lower().endswith(".md") else a
 27885	    if "/" in a:
 27886	        return (a, None) if (a + ".md") in env.notes else (None, f"--by 找不到 {by}")
 27887	    hits = env.by_stem.get(a.lower(), [])
