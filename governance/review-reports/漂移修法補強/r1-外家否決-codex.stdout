 28069	def _drift_git_cmd(cx, head):
 28070	    """印給人貼的 git 指令(head 例:「checkout --」、「add governance/drift-fixes.jsonl」)→ 指令或 None。
 28071	    路徑用 git 裡的原樣拼法(Linux 上 NFD 檔名拿 NFC 路徑當 pathspec 會對不到,代碼審 r2 正確性席);★不截斷★(截斷會
 28072	    變成另一條路徑、或剪掉收尾引號,代碼審 r3 外家否決席);加 --literal-pathspecs,檔名裡的 * ? [ 不被 git 當萬用字元展開、
 28073	    多加到別篇(r3 資安席);路徑含控制字元就不印可照貼的指令(消毒會改掉路徑本身),回 None 由呼叫端改講怎麼找。"""
 28074	    import unicodedata
 28075	    ps = _git_paths_nfc(cx["root"], cx["repo_rel"])
 28076	    p = ps[0] if ps else cx["repo_rel"]
 28077	    if any(unicodedata.category(c)[0] == "C" for c in p):
 28078	        return None
 28079	    return f"git --literal-pathspecs {head} {_drift_sh(p)}"
 28080	
