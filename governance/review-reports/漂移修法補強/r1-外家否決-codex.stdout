 28122	def _drift_fix_record(env, cx, res):
 28123	    """第 7 步:寫修復帳(稽核紀錄)、記治理事件。帳寫不進去回 2,不動筆記。"""
 28124	    import datetime, hashlib, secrets
 28125	    rec = {"id": "DFIX-" + secrets.token_hex(4), "date": datetime.date.today().isoformat(), "path": cx["repo_rel"],
 28126	           "line": cx["line"], "kind": cx["kind"], "changed": _drift_fix_changes(cx["lines"], res["new"]),
 28127	           "after_sha256": hashlib.sha256("\n".join(res["new"]).encode("utf-8")).hexdigest(), **res["extra"]}
 28128	    want = "\n".join(res["new"]).encode("utf-8")
 28129	    moved = False
 28130	    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "ledger":
 28131	        rc = 2
 28132	    else:
 28133	        with _vault_write_lock(env.vault):
 28134	            # 驗證在鎖外,記帳前在鎖內再比一次:帳上的指紋要是記帳那一刻磁碟上的內容(代碼審 r1 外家席)
 28135	            try:
 28136	                if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "moved":   # 故障注入:模擬別人在驗證與記帳之間改了這一篇
 28137	                    cx["path"].write_bytes(want + b"\n")
 28138	                moved = cx["path"].read_bytes() != want
 28139	            except OSError:
 28140	                moved = True
 28141	            if moved:
 28142	                rc = 2
 28143	            else:
 28144	                rec["seq"] = _drift_next_seq(cx["root"], _DRIFT_FIXES)
 28145	                rc = _drift_ledger_append(cx["root"], _DRIFT_FIXES, rec)
 28146	    if rc != 0:
 28147	        why = ("寫好、驗過之後這一篇又被別人改了,修復帳沒記(帳上的指紋要是記帳那一刻的內容)" if moved
 28148	               else "筆記已改好,但修復帳沒記到")
 28149	        print(f"擋下:{why};{_esc_clean(cx['repo_rel'], 200)} 的改動用 git diff 看得到——確認沒問題就直接提交"
 28150	              "(修復帳只是稽核紀錄,少這一筆不影響之後的修;沒提交之前,同一篇的下一項 drift fix 會因為指紋對不上帳而擋下);"
 28151	              f"要退就 {_drift_git_hint(cx, 'checkout --')}", file=sys.stderr)
 28152	        return 2
 28153	    _gate_event_or_warn(cx["root"], "drift-check", "fix", f"{cx['rel']}:{cx['line']} {cx['kind']}({rec['id']})")
 28154	    return 0
