                  f"(共 {w['support']} 次)。確認一下是不是漏改了。")
    return 0


_DELGUARD_STOP = frozenset("if else for while return import class def val var fun void public private static final new this true false null let const function".split())
# ①建置產物:這份★必須與 pre-commit 的 should_exclude 逐項對齊★(既有漂移守衛在比),
# 因為兩邊講的是同一件事——那些目錄裡沒有人寫的原始碼。
_DELGUARD_EXCLUDE_DIRS = ("node_modules/", "bin/", "obj/", "dist/", "build/", "__pycache__/", ".git/")
# ②散文與帳本:★只有 delguard 排,絕對不要複製到 pre-commit 的 should_exclude★
# (2026-09-06 代碼審 r1 通才席判 blocker、實測重現:我為了滿足漂移守衛就把 governance/ 一起
#  抄進 pre-commit,結果 governance/ 底下 28 支真程式全部從「改 code 沒動圖譜就擋」的硬閘裡
#  掉出去——兩份清單語意根本不同:delguard 那份是「哪裡不算活著的程式」,pre-commit 那份是
#  「哪些檔改了不必配圖譜」。)
# 為什麼 delguard 要排:符號被審查卷證或治理帳提到,不代表它還活著,掃它們既不準也很貴。
# 實測四個常用詞(doctor/lumos/check/node)全 repo 命中 75587 行、7.17 秒,排除後 7336 行、
# 0.47 秒(15 倍);逾時降級的成本是跟命中行數成正比,不是 token 數。
# ★docs/ 底下的圖譜本體另有 :(exclude){graph_root} 專門排,這裡多排的是帳本與散文。★
_DELGUARD_PROSE_DIRS = ("governance/", "docs/")
_DELGUARD_ALL_EXCLUDE_DIRS = _DELGUARD_EXCLUDE_DIRS + _DELGUARD_PROSE_DIRS
# 與 pre-commit should_exclude 的 lock 排除規則對齊(`*package-lock.json|*yarn.lock|*pnpm-lock.yaml`)
_DELGUARD_EXCLUDE_LOCKFILES = ("package-lock.json", "yarn.lock", "pnpm-lock.yaml")
DELGUARD_TOKEN_CAP = 40  # staged diff 抽出 token 數上限,超額截斷(dropped 計入輸出提示)
DELGUARD_TOP_N = 10  # CLI 文字輸出逐條列出上限,其餘併入「另有 K 處命中」統計行


def _delguard_is_diff_header(ln):
    """True=這行是 unified diff 的檔頭行(--- a/… / +++ b/… / …/dev/null),不是內容行。
    ★不可寫成 startswith(("---","+++"))★——被刪的 SQL/Lua 註解行 `-- x` 在 diff 裡長成
    `--- x`,那樣會被當檔頭吃掉、整行 token 靜默漏抽(2026-08-11 code-loop r1 s5 F6)。"""
    return (ln.startswith("--- a/") or ln.startswith("+++ b/")
            or ln.startswith("--- /dev/null") or ln.startswith("+++ /dev/null"))

    34	
    35	## 做法
    36	
    37	### 1. c4 卷證目錄
    38	
    39	- 取驗證紀錄第一次被提交的提交(`_plan_first_commit`;shallow 由既有 `_git_is_shallow` 先擋)。列那個提交加進來或改名進來的檔:`_nodehome_git(root, "show", "-z", "--name-only", "--diff-filter=AR", "--format=", <提交>)`,`_nodehome_split_z` 拆;只收路徑至少四段、形如 `governance/review-reports/<目錄>/<檔>` 的第三段目錄名,去重。這是「同提交」清單;git 失敗或逾時當空,證據頁寫「同提交:查不到(git 失敗或沒有)」。
    40	- 「計劃名」清單照舊用 `_drift_c4_key` 比對。
    41	- 證據頁全部列出、每個標來源(兩者、同提交、計劃名),排序:兩者 → `code-` 開頭 → 其他,同級照字母;同提交清單超過 3 個時另標「可能含別的計劃的卷證(整批匯入或壓成一個的提交)」。目錄名印到終端前過 `_esc_clean`。
    42	- 範本句改成「提交 <已知就填 sha>;代碼審見 <卷證>」——卷證一律放佔位字,由人從清單挑(整句貼進 `lumos set` 會被第 2 節擋下,逼人換成真的目錄)。
    43	- 預填的 `lumos set` 指令照舊(要改的那項放 `<整項新內容>`),這次不改它的展開與長度處理。
    44	
    45	### 2. `lumos set` 多擋兩個佔位字
    46	
    47	- `_set_conditions_locked` 的第一道檢查從「值裡有 `_SET_COND_SLOT`」改成「值裡有 `<整項新內容>`、`<卷證>`、`<sha>` 任一個」(三個字串放一個模組常數,跟證據頁印的同一份);訊息點名是哪一個。其他檢查與順序不動。
    48	
    49	### 3. c1 與 settle 的訊息
    50	
    51	- 兩處印「找不到〈那一種〉」的地方(`_drift_fix_c1` 組的 msg 與 guard settle 的提醒)改用同一支組字函式,字樣改成「找不到〈那一種〉的預告句——可能已經是轉正後的說法(不用改),或被手改過(看一下)」。不改判定、不改回傳值,只改字。
    52	
    53	### 4. c3 的理由
    54	
    55	- 接線:`_DRIFT_FIX_ALLOWED["c3"]` 加 `"reason"`;argparse `--reason` 的說明改成「c2、c3」;`_drift_fix_c3_args` 裡呼叫既有 `_drift_placeholder_err`(長度與單行由 `_drift_fix_args_err` 既有的 `_drift_fix_reason_ok` 管)。理由先去頭尾空白。
    56	- 補的那一行三種寫法(有 `--by` 且是 pass:「由 [[X]] 解決」;有 `--by` 其他狀態:「參考 [[X]]」;沒 `--by`)都一樣:有給理由就在最後接「;理由:<理由>」,沒給照舊。理由裡的 [[連結]] 不驗存在(同 c2)。
    57	
    58	### 5. 刪除守衛跳過工具自裝檔
    59	
    60	- `_delguard_parse_diff` 加 `skip` 參數(預設空集合),抽 `-` 行名稱與收 `+` 行回收表兩遍都跳過 `skip` 裡的路徑;跟既有 `_DELGUARD_*` 排除清單分開,不併進去(那份有 `t_precommit_whitelist_drift_guard` 釘著)。
    61	- `cmd_delguard_check`:不是工具鏈本身(`_is_toolchain_repo` 為假)時,`skip = _VENDORED_ALL`;是工具鏈本身時 `skip` 為空(那些檔是它自己的程式)。純路徑判斷,不讀安裝清單、不跑 git,沒有額外時間。
    62	- 跳過時在既有 delguard 治理事件的 `note` 裡加 `vendored-skip=<這次 diff 碰到並跳過的工具檔支數>`(沒碰到就不加)。
    63	
    64	## 條款
    65	
    66	- [S1] 當 c4 證據要列卷證目錄,工具應把同提交(含改名進來的)與計劃名比對到的目錄都列出並標來源、照兩者 → code- 開頭 → 其他排序,範本句的卷證一律是 `<卷證>`;中文目錄名照原樣;git 查不到時寫明 [test:t_drift_c4_reports_from_first_commit]
    67	- [S2] 當 `lumos set` 整欄改 valid_under/revalidate_when 而值裡有 `<整項新內容>`、`<卷證>` 或 `<sha>`,工具應擋下、點名是哪一個、檔案不動;其他輸入的行為與訊息應與改前相同 [test:t_set_conditions_blocks_drift_placeholders]
    68	- [S3] 當 c1 或 guard settle 找不到某種預告句,訊息應講明「可能已經是轉正後的說法(不用改),或被手改過」,兩處字樣相同 [test:t_drift_fix_c1_missing_message]
    69	- [S4] 當 `drift fix --kind c3` 帶 `--reason`,補的那一行應以「;理由:<去頭尾空白的理由>」收尾(三種寫法都一樣);理由的長度、單行、佔位字規則與 c2 相同 [test:t_drift_fix_c3_reason]
    70	- [S5] 當消費專案提交時刪掉工具自裝檔裡的名稱,刪除守衛不應從那些檔抽名稱,並在治理事件的 note 記 `vendored-skip=<支數>`;工具鏈來源 repo 照舊抽 [test:t_delguard_skips_vendored_toolkit]
    71	
    72	## 回退
    73	
    74	- 卷證目錄:`_drift_c4_evidence` 與 `_drift_c4_print` 改回只用計劃名比對、範本自動填目錄。
    75	- set 擋佔位字:常數改回只有 `<整項新內容>`。
    76	- c1 與 settle 訊息:組字函式拿掉,兩處改回原字串(c1 的「找不到…,沒改」與 settle 的原提醒)。
    77	- c3:`_DRIFT_FIX_ALLOWED["c3"]` 拿掉 `reason`、argparse 說明改回、`_drift_fix_c3` 的接法與佔位字呼叫拿掉。
    78	- 刪除守衛:呼叫端不傳 `skip`(預設空集合)即回到原行為;note 裡的 `vendored-skip=` 拿掉。
    79	- 測試與文件:新測試拿掉;[[Systems/存量漂移守衛]]、[[Systems/lumos-cli-write]]、[[Systems/guard-kill]]、[[Systems/delguard]] 的新句子與 lumos-project-notes 的 commands/04、commands/08 對應處一起改回。主要路徑是 `git revert` 那個功能提交(程式、筆記、測試同一個提交);`scripts/test_lumos.py` 是錨點檔,revert 後要重跑 `lumos anchor approve`。
    80	
    81	## 實務隱患
    82	
    83	- 已排除:不可逆:只改本機的工具輸出與檢查,不改筆記內容的寫法;還原提交後外面不用收拾
    84	- 已排除:金流:這是本機命令列工具,不碰任何付款或帳務
    85	- 已排除:對外送出:不寄信、不打外部服務
    86	- 守衛面(碰到):刪除守衛(只提醒不擋)在消費專案少抽工具自裝檔,跳過數記進治理事件;c1 與 settle 只改訊息字樣,不改判定。消費專案自己改工具檔又刪了名稱的情形會被放過,寫進誠實界線
    87	- 資安(碰到):卷證目錄名印到終端前過 `_esc_clean`;範本句不再自動帶目錄名,少一條把外來字串帶進照貼內容的路
    88	- 效能(碰到):卷證目錄多兩次有逾時的 git 查詢(找第一次提交、列那個提交的檔),只在 c4 證據頁跑;刪除守衛的跳過是純路徑比對,沒有額外成本
    89	- 併發(不碰):不新增寫入路徑;set 的寫入與鎖照舊
    90	
    91	## 誠實界線
    92	
    93	- c4 修正走 `lumos set`,不進漂移修復帳;稽核靠 git 歷史(set 的修改在提交裡看得到)。rtb 回報的第二條(帳上少 c4)因此只以「改成靠 git 稽核」處理,不補帳。
    94	- 卷證目錄的同提交找法,前提是「程式、筆記、卷證放同一個提交」;驗證紀錄另外提交時同提交清單是空的,只剩計劃名比對。範本不自動填,所以找錯不會直接被照貼寫進筆記,但人仍可能從清單挑錯。
    95	- c1 與 settle 的訊息不再區分「已轉正」與「被手改」,由人自己看;rtb 回報的第三條以「措辭不再像出錯」處理。
    96	- 刪除守衛在消費專案一律不看工具自裝檔:消費專案自己改工具檔、刪掉名稱、而圖譜提到那些名稱時,不會提醒。工具檔本來就不該在消費專案被改(更新靠 `lumos update`)。
    97	REVISIT:2026-11-30 看有沒有消費專案自己改工具檔的回報(或 `lumos update` 的指紋檢查抓到被改過的工具檔);有就改成只跳過跟安裝清單一致的
    98	- `lumos set` 多擋 `<卷證>`、`<sha>`:這兩個字串若是某篇驗證紀錄前提裡本來就合法要寫的字,會被擋;機率極低,訊息會說明是佔位字檢查。
