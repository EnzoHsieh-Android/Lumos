34856:    msg = (f"平台 {'、'.join(sorted(plats_missing))} 沒設測試指令(多平台要寫在 platforms.<平台>.run_cmd),"
35446:    三態 missing/line_out_of_range/ok 同義;r3 架構對齊席 A3)。只驗存在不驗內容。"""
    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。
    """
    if touched is None:
        return True, ""            # 沒給清單=CI 那一層,照舊全擋
    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點
    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。
    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]
    if not homes:
        return False, ";這篇沒寫它守的是哪篇功能節點,算不出有沒有碰到"
    files, found, missing, nocode = [], [], [], []
    for home in homes:
        hrel = env.find(home)
        hn = env.notes.get(hrel) if hrel else None
        if hn is None:
            missing.append(home)
            continue
        found.append(hrel)
        got = [str(x).strip() for x in as_list(hn.fields.get("about_code")) if str(x).strip()]
        if got:
            files += got
        else:
            nocode.append(hrel)
    # ★連結斷掉的那幾篇,不管這次擋不擋都要講★(代碼審 r2 通才席):
    # 半條算得出來、半條算不出來時,算不出來的那半原本會無聲消失,那條合約就一直帶著沒人發現的壞連結。
    broken = f"(另外 {'、'.join(missing)} 這幾篇找不到,連結可能斷了)" if missing else ""
    if not files:
        if missing and not found:
            return False, f";找不到它守的功能節點 {'、'.join(missing)},算不出有沒有碰到"
        return False, f";{'、'.join(nocode)} 沒寫它管哪幾支檔(about_code),算不出有沒有碰到{broken}"
    hits, only_case = _guard_touched_hits(files, touched)
    if hits:
        # ★只列解析得到的那幾篇★(代碼審 r2 通才席):這句話存在的目的是讓被擋的人知道去哪篇查,
        # 把找不到的節點也列進來,照著查的人會撲空。
        # ★收窄的粒度是「整篇家節點」不是「每條合約」★(代碼審 r1):同一篇掛兩條逾期合約時兩條都會擋。
        # 做得更細要讓每條合約自己記檔案清單(另一套資料);現在的代價是偶爾多擋一條,方向安全,
        # 但要讓人看得出來為什麼,不要變成無法解釋的誤擋。
        why = f";你這次改到 {'、'.join(hits[:3])}(它掛在 {'、'.join(found[:2])} 底下){broken}"
        if only_case and len(only_case) == len(hits):
            why += "——只有忽略大小寫才對得上,寧可多擋一次也不漏"
        return True, why
    return False, ("" if not broken else f";這次沒碰到它管的檔{broken}")


def cmd_guard_settle(env, ref, method=None, date=None):
    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過,四種預告句改成歷史說法。

    ★整段拿寫入鎖、守衛紀錄一次寫入、做到一半可以補完★(存量漂移防線_計劃 [S4][S5][S19]):
    原本第一步在鎖外、第二步才經 cmd_set 拿鎖,中間斷掉會留下「家筆記是正式行、守衛紀錄還是 pending」,
    舊版再跑 settle 找不到預告行就擋,guard-kill 記過這種卡死。

    ★已經 pass 但還留著預告句★(存量漂移改法 第 3 節):補改句(前提、日期、不疊跟 drift fix --kind c1 同一支);
    前提不符回 2(以前一律回 0)。--test 只有 pending 要;--date 只給 pass 補改句用。"""
    rel, _n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    try:
        glines, _s, ge = load_raw_for_edit(env.vault / rel)
    except (ValueError, RuntimeError, OSError) as ex:
        print(f"擋下:{rel} 打不開:{ex}", file=sys.stderr)
        return 2
    if str(parse_frontmatter(glines[1:ge])[0].get("status")) == "pass":
        return _guard_settle_pass(env, rel, glines, date)
    if date is not None:
        print("擋下:--date 只給已轉正(pass)的守衛紀錄補改預告句用;待完成的轉正日期就是今天", file=sys.stderr)
        return 2
    if method is None:
        print("擋下:待完成的守衛紀錄轉正要給 --test <測試方法名>(守這條合約的那支測試)", file=sys.stderr)
        return 2
    if not IDENT_RE.match(method or ""):
        print(f"擋下:測試方法名『{method}』不合法(只能字母/數字/底線,不能數字開頭)", file=sys.stderr)
        return 2
    with _vault_write_lock(env.vault):
        return _guard_settle_locked(env, ref, method)


def _guard_settle_pass(env, rel, glines, date):
    """已 pass 的守衛紀錄:還有預告句就補改(鎖外讀狀態、推日期、查前提;拿鎖後比對那一篇沒變才寫),沒有就照舊回 0。"""
    ops = [k for _i, k in _guard_prose_ops(glines) if k != "why-done"]
    if not ops:
        print(f"已轉正,不用再做:{rel} 已經是 pass")
        return 0
    root = _vault_repo_root(env)
    gpath = env.vault / rel
    before = "\n".join(glines).encode("utf-8")      # load_raw_for_edit 讀到的原樣內容(已拒 BOM、CRLF)
    try:
        repo_rel = gpath.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        repo_rel = rel
    new, missing, day, err = _guard_pass_rewrite(env, root, repo_rel, glines, date)
    if err:
        print(f"擋下:{rel} 已是 pass、還留著預告句,但補改不了:{err}", file=sys.stderr)
        return 2
    with _vault_write_lock(env.vault):
        try:
            if gpath.read_bytes() != before:
                print(f"擋下:讀完之後 {rel} 被改過,重跑一次", file=sys.stderr)
                return 2
            atomic_write_verify(gpath, new, "status", lambda f: str(f.get("status", "")) == "pass")
        except (ValueError, RuntimeError, OSError) as ex:
            print(f"擋下:{rel} 寫不進去:{ex}", file=sys.stderr)
            return 2
    _guard_settle_missing_say(rel, missing)
    print(f"✓ 補改:{rel} 已是 pass,預告句改成歷史說法" + (f"(轉正日期 {day})" if day else ""))
    return 0


def _guard_settle_locked(env, ref, method):
    rel, _n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    gpath = env.vault / rel
    # ★狀態從磁碟重讀★:env 是指令開頭載入的,拿到鎖之前可能已經被另一個程序轉正了
    try:
        glines, _s, ge = load_raw_for_edit(gpath)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{rel} 打不開:{ex}", file=sys.stderr)
        return 2
    gfields = parse_frontmatter(glines[1:ge])[0]
    st = str(gfields.get("status"))
    if st == "pass":
        # 另一個程序剛做完、或重跑:結果已經是要的樣子,當成功(設計審 r3 併發席)
        print(f"已轉正,不用再做:{rel} 已經是 pass")
        return 0
    if st != "pending":
        print(f"擋下:{rel} 現在是 {st},只有待完成的才能轉正", file=sys.stderr)
        return 2
    home = _guard_home_of_fields(gfields)
    home_rel = env.find(home)
    if home_rel is None:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到", file=sys.stderr)
        return 2
    m = re.search(r"^預告的合約:(.+)$", "\n".join(glines), re.M)
    claim = m.group(1).strip() if m else ""
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條", file=sys.stderr)
        return 2
    if not _guard_settle_home(env, home_rel, claim, method):
        return 2
    return _guard_settle_record(gpath, glines, ge, rel, home_rel, method)


def _guard_settle_home(env, home_rel, claim, method):
    """轉正第一步:家筆記的預告行換成正式合約行;已經是正式行(上次做到一半)就不動。成功回 True(失敗已印原因)。"""
    hpath = env.vault / home_rel
    try:
        hlines, _hs, he = load_raw_for_edit(hpath)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{home_rel} 打不開:{ex}", file=sys.stderr)
        return False
    try:
        _pd = load_platforms(_vault_repo_root(env))
        plat = (_pd["platforms"] if _pd["multiplatform"] else {}, _pd["default_platform"])
    except (ValueError, OSError):
        plat = None
    has_mine = _guard_formal_line(hlines, he, claim, method, plat) is not None
    if not has_mine and _guard_formal_line(hlines, he, claim, None) is not None:
        # 同一句已經有正式行、綁的測試裡沒有這支(代碼審 r2 外家席):照舊走會寫出第二條同文字的正式行
        print(f"擋下:{home_rel} 已經有同一句的正式合約行、綁的測試裡沒有 {method};要加這支用 lumos guard bind,"
              "這條預告不重複轉正(要不做了走 lumos guard abandon)", file=sys.stderr)
        return False
    if has_mine:
        idxs = _guard_planned_idx(hlines, he, claim)
        if not idxs:
            print(f"{home_rel} 已經是正式合約行(上次轉正做到一半),這次只補守衛紀錄")
            return True
        if len(idxs) > 1:
            # 預告行重複好幾條:不當成做到一半(代碼審 r2 正確性席;r3 架構對齊席:用索引清單分,不比錯誤訊息文字)
            print(f"擋下:{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條——先手動把重複的那行處理掉",
                  file=sys.stderr)
            return False
        # ★正式行已在、預告行也還在★(代碼審 r1 正確性席):只拿掉預告行,不再換成第二條一樣的正式行
        try:
            atomic_write_verify(hpath, hlines[:idxs[0]] + hlines[idxs[0] + 1:], PLANNED_MARK,
                                lambda f: f"{PLANNED_MARK} {claim}" not in str(f.get("summary") or ""))
        except (ValueError, RuntimeError) as ex:
            print(f"擋下:{home_rel} 已有正式合約行,但重複的預告行拿不掉: {ex}", file=sys.stderr)
            return False
        print(f"{home_rel} 已經有同一句的正式合約行,只把重複的預告行拿掉")
        return True
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        print(f"擋下:{_err}", file=sys.stderr)
        return False
    newline = f"  KEY:★INVARIANT★ {claim} [test:{method}]"
    try:
        atomic_write_verify(hpath, [*lines[:idx], newline, *lines[idx + 1:]],
                            f"[test:{method}]",
                            lambda f: f"[test:{method}]" in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:合約行換不過去,什麼都沒動: {ex}", file=sys.stderr)
        return False
    return True


def _guard_settle_record_lines(glines, ge, home_rel, today):
    """轉正第二步算內容(不寫檔):守衛紀錄的 status 改 pass、同步標籤、四種預告句改寫 → (新的行, 找不到的句型, 標籤有沒有同步)。
    settle 與 drift fix --kind c5 共用(存量漂移改法 第 4 節)。"""
    fm = edit_fm_scalar(glines[1:ge], "status", "pass")
    fm, synced = edit_fm_sync_status_tag(fm, "pass")
    new, missing = _guard_settle_rewrite(glines[:1] + fm + glines[ge:], today,
                                         home_rel[:-3] if home_rel.endswith(".md") else home_rel)
    return new, missing, synced


def _guard_record_ok(synced):
    """寫後自驗:status 是 pass;標籤有同步時 status/* 只剩 status/pass。"""
    def _ok(f):
        if str(f.get("status", "")) != "pass":
            return False
        tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
        return (not synced) or ("status/pass" in tags and all(t == "status/pass" for t in tags if t.startswith("status/")))
    return _ok


_GUARD_PROSE_NAMES = {"test": "摘要的 TEST 預告句", "why": "摘要的 WHY 預告句", "whynot": "正文「為什麼還不做:」",
                      "settle": "正文「做完之後跑 lumos guard settle 轉正」"}


def _guard_settle_missing_say(rel, missing):
    for k in missing or ():
        print(f"提醒:{rel} 裡找不到{_GUARD_PROSE_NAMES[k]}(被手改過?),那一句沒改寫,要的話自己改成歷史說法")


def _guard_settle_record(gpath, glines, ge, rel, home_rel, method):
    """轉正第二步:守衛紀錄的 status、標籤、四種預告句同一次寫入。"""
    import datetime
    today = datetime.date.today().isoformat()
    new, missing, synced = _guard_settle_record_lines(glines, ge, home_rel, today)
    try:
        atomic_write_verify(gpath, new, "status", _guard_record_ok(synced))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{home_rel} 已換成正式合約行,但 {rel} 寫不進去:{ex}", file=sys.stderr)
        print(f"  修好原因後重跑同一個指令會只補這一步:lumos guard settle {rel[:-3]} --test {method}", file=sys.stderr)
        return 2
    _guard_settle_missing_say(rel, missing)
    print(f"✓ 轉正:{home_rel} 的預告行已換成正式合約並綁上 [test:{method}];{rel} 轉為已通過,預告句改成歷史說法")
    print("  下一步:lumos guard audit 補獨立審計,推送前的閘會查")
    return 0


def _guard_signoff_refs(env):
    """簽核帳裡帶 --ref 的那些參照。"""
    import json as _j
    log = env.vault.parent / ".signoff-log.jsonl"
    refs = set()
    try:
        for ln in log.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                d = _j.loads(ln)
            except ValueError:
                continue
            r = str(d.get("ref") or "").strip()
            if r:
                refs.add(r)
                refs.add(r[:-3] if r.endswith(".md") else r)
    except OSError:
        pass
    return refs


def cmd_guard_abandon(env, ref, why):
    """棄置:留墓碑而不是刪掉。要有對得上的簽核紀錄——作用是留痕不是防偽造。
    整段拿寫入鎖(存量漂移防線 [S19]:原本改家筆記在鎖外,跟同時跑的 plan/settle 互相蓋掉)。"""
    with _vault_write_lock(env.vault):
        return _guard_abandon_locked(env, ref, why)


def _guard_abandon_locked(env, ref, why):
    if not (why or "").strip():
        print("擋下:棄置要寫 --why 說明為什麼決定不做了", file=sys.stderr)
        return 2
    rel, n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    refs = _guard_signoff_refs(env)
    stem = rel[:-3] if rel.endswith(".md") else rel
    if rel not in refs and stem not in refs:
        print(f"擋下:棄置一條預告的合約要有人簽核,帳上找不到對得上 {stem} 的紀錄", file=sys.stderr)
        print(f"  先簽核再來:lumos signoff {stem} --ref {stem} --note \"<為什麼決定不做>\"", file=sys.stderr)
        return 2
    home = _guard_home_of(n)
    home_rel = env.find(home)
    body = (env.vault / rel).read_text(encoding="utf-8")
    m = re.search(r"^預告的合約:(.+)$", body, re.M)
    claim = m.group(1).strip() if m else ""
    if not home_rel:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到——棄置前先把 guards 欄位指對,"
              "不然那篇的預告行會永遠留著,跟墓碑互相矛盾", file=sys.stderr)
        return 2
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條(被手改過?)", file=sys.stderr)
        return 2
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        # ★找不到就擋,不靜默略過★(代碼審 r1 blocker):guards 被改指到別篇時,
        # 原本會靜默成功,真正的家節點永久留著一條沒人管的預告行。
        print(f"擋下:{_err}", file=sys.stderr)
        print("  棄置會把功能節點那行預告拿掉;對不到那一行就不知道該拿掉哪一條,不能硬做", file=sys.stderr)
        return 2
    try:
        atomic_write_verify(env.vault / home_rel, lines[:idx] + lines[idx + 1:],
                            "", lambda f: claim not in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:功能節點的預告行拿不掉,墓碑也不立(不留半套): {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "status", "abandoned")
    print(f"✓ 已棄置:{rel} 立成墓碑(不是刪掉,下一個人看得到曾經打算做什麼、為什麼不做了)")
    return rc


def cmd_guard_required(env, as_json=False):
    """列必要集合現況:待完成幾條、逾期幾條、快到期幾條。"""
    import datetime
    today = datetime.date.today()
    rows, overdue, soon = [], [], []
    for rel, n in _guard_nodes(env):
        st = str(n.fields.get("status") or "")
        due = str(n.fields.get("due") or "").strip()
        home = _guard_home_of(n)
        owner = str(n.fields.get("owner") or "").strip()
        body = (env.vault / rel).read_text(encoding="utf-8")
        m = re.search(r"^預告的合約:(.+)$", body, re.M)
        claim = (m.group(1).strip() if m else rel)
        rows.append((rel, st, due, home, owner, claim))
        if st != "pending":
            continue
        try:
            d = datetime.date.fromisoformat(due)
        except ValueError:
            continue
        # ★到期當天不算過期,隔天才算★:最遲日期是人手寫的本地日期;
        # 誤擋一次的代價比漏擋一天高(設計審 r1)
        if d < today:
            overdue.append((rel, due, owner, claim))
        elif (d - today).days <= 7:
            soon.append((rel, due, owner, claim))
    pend = [r for r in rows if r[1] == "pending"]
    print(f"必要合約:待完成 {len(pend)}、逾期 {len(overdue)}、快到期(七天內) {len(soon)}、"
          f"已通過 {len([r for r in rows if r[1] == 'pass'])}、"
          f"已棄置 {len([r for r in rows if r[1] == 'abandoned'])}")
    for rel, due, owner, claim in overdue:
        print(f"  ✗ 逾期 {due}(負責人 {owner}):{claim}")
        print(f"      {rel} — 做完跑 lumos guard settle,不做了跑 lumos guard abandon(要先簽核)")
    for rel, due, owner, claim in soon:
        print(f"  ⚠ 快到期 {due}(負責人 {owner}):{claim}")
        print(f"      {rel}")
    if not overdue and not soon and pend:
        for _rel, _st, due, _home, owner, claim in pend:
            print(f"  · 待完成 {due}(負責人 {owner}):{claim}")
    return 1 if overdue else 0


def cmd_guard_bind(env, node, invariant_substr, method, platform=None):
    if not IDENT_RE.match(method):
        print(f"擋下:method『{method}』不是合法的方法名(只能用字母/數字/底線,不能數字開頭)", file=sys.stderr)
        return 2
    # 多平台:平台另帶(method 維持識別字、不含冒號),寫成 [test:平台:方法]。IDENT_RE 不放寬。
    ref = f"{platform}:{method}" if platform else method
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{ex}", file=sys.stderr)
        return 2
    target_idx = None
    for i in range(1, e):
        # 比對去掉 [test:..] 後的行(子字串不誤命中既有測試名)
        if INVARIANT_RE.match(lines[i].strip()) and invariant_substr in TEST_REF_RE.sub("", lines[i]):
            if target_idx is not None:
                print(f"擋下:『{invariant_substr}』同時對到好幾條 KEY 行,分不清是哪條,請給更長、更精確的片段", file=sys.stderr)
                return 2
            target_idx = i
    if target_idx is None:
        print(f"擋下:{rel} 裡找不到內容含『{invariant_substr}』的合約 KEY 行", file=sys.stderr)
        return 2
    line = lines[target_idx]
    m = TEST_REF_RE.search(line)
    if m:
        refs = [t.strip() for t in m.group(1).split(",") if t.strip()]
        if ref in refs:   # 去重比完整 ref(platform:method),否則多平台漏判(審計 r3)
            print(f"已綁 [test:{ref}],無需重綁")
            return 0
        refs.append(ref)
        newline = line[:m.start()] + f"[test:{','.join(refs)}]" + line[m.end():]
    else:
        newline = line.rstrip() + f" [test:{ref}]"
    new_lines = lines[:target_idx] + [newline] + lines[target_idx + 1:]

    def check(fields):
        summ = fields.get("summary")
        if not isinstance(summ, str):
            return False
        for l in summ.split("\n"):
            mi = INVARIANT_RE.match(l.strip())
            if mi and invariant_substr in l:
                return ref in invariant_test_refs(mi.group(1))   # verify closure 也比完整 ref

