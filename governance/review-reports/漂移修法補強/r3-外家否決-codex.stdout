    import datetime
    model = _html_model(env)
    # </script> 在嵌入 JSON 裡會提早關閉 <script> 標籤破壞整頁 → 轉義 </(標準作法)
    data = json.dumps(model, ensure_ascii=False).replace("</", "<\\/")
    stamp = datetime.date.today().isoformat()
    html = _HTML_TEMPLATE.replace("__DATA__", data).replace("__STAMP__", stamp) \
                         .replace("__VAULT__", env.vault.name) \
                         .replace("__NC__", str(len(model["nodes"]))) \
                         .replace("__EC__", str(len(model["edges"])))
    if standalone:
        # inline cytoscape/marked(去 CDN,防火牆/離線可開);字體退化系統字(移除 google link)
        vendor = Path(__file__).resolve().parent / "vendor"
        for name, (url, tag) in _VIZ_LIBS.items():
            try:
                src = _fetch_text(url, vendor / f"{name}.min.js").replace("</script", "<\\/script")
            except Exception as e:
                print(f"擋下:--standalone 模式要先下載 {name},這台機器至少要連一次網,現在抓不到: {e}", file=sys.stderr)
                return 2
            html = html.replace(tag, f"<script>{src}</script>")
        html = html.replace(_FONT_LINKS, "<!-- standalone: 字體退化系統字(無外部 CDN) -->")
    Path(out_path).write_text(html, encoding="utf-8")
    mode = "standalone(自包含/離線可開)" if standalone else "CDN"
    print(f"✓ export html [{mode}]: {out_path}  ({len(model['nodes'])} 節點 / {len(model['edges'])} 邊)")
    return 0


# ═══════════════════════ 階段三: 寫側 T1(行級手術) ═══════════════════════

SCALAR_KEYS = {"status", "updated", "created", "type", "self_audit", "signed_off", "regen", "pitfall_ask", "pitfall_source", "about_code_stamp", "responsibility"}  # pitfall_* 2026-08-09 已知坑策展庫;about_code_stamp 2026-08-23(語意欄位基礎,計劃:固定席扇出降權)
LIST_KEYS = {"verified_by", "plan_refs", "related", "tags", "aliases", "pitfall_when", "core_refs", "about_code", "lands_in"}   # aliases 2026-08-05;pitfall_when 2026-08-09(已知坑策展庫,content-trigger);core_refs 2026-08-11(升格加指針/降格拆指針,兩向都要 T1;值是純路徑非 wikilink——lumos-core-knowledge skill 明令禁跨 vault wikilink)
_SET_COND_SLOT = "<整項新內容>"   # drift fix --kind c4 印的 lumos set 指令裡,要人填的那一項
COND_KEYS = ("valid_under", "revalidate_when")   # 驗收前提/回頭條件:set 整欄換掉(一個值=單行、多個=清單);spec=Projects/驗收前提欄位可改_計劃
LINK_KEYS = ("verified_by", "plan_refs", "related", "core_refs")  # S2「純連結欄位」子集(≠LIST_KEYS:那是 append 白名單,pitfall_when=content-trigger 不算連結);spec=Projects/code側刪除傳播守衛_計劃
DATE_KEYS = {"updated", "created", "date", "decided", "ended"}
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def fm_structure(fm_lines):
    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
    end = 該 key 區塊最後一行的 index(含)。"""
    out = []
    i, n = 0, len(fm_lines)
    while i < n:
        m = TOP_KEY_RE.match(fm_lines[i])
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        start = i
        if val in ("|", "|-", ">", ">-"):
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "block"))
        elif val == "":
            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
            i += 1
            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "list"))
        elif val == "[]":
            # YAML 合法空清單(範本 `aliases: []` 就是這樣寫)。2026-08-23 前被判成 scalar →
            # 從範本建的節點第一次 append 必敗,全庫 15 篇在此狀態。★只認空的 `[]`★,
            # 非空 inline list(`[a, b]`)仍當 scalar——那要真的解析逗號與引號,不在本次,
            # 且 append 遇到它會被擋(不會壞),可接受。
            out.append((key, start, start, "list"))
            i += 1
        else:
            out.append((key, start, start, "scalar"))
            i += 1
    return out


# 標準 YAML(1.1/1.2,Obsidian 用的 js-yaml)不加引號會讀成數字、日期、無限大的寫法——這些要加引號才是字串
# (2026-09-26 代碼審 r2 通才席:原本只認十進位整數與小數)。日期欄位(DATE_KEYS)刻意不加引號,走另一條路,不經這裡。
_YAML_TYPED_RE = re.compile(
    r"[-+]?(\d[\d_]*(\.[\d_]*)?|\.\d[\d_]*)([eE][-+]?\d+)?"       # 十進位、小數、科學記號
    r"|[-+]?0[xX][0-9a-fA-F_]+|[-+]?0[oO]?[0-7_]+|[-+]?0[bB][01_]+"  # 十六、八、二進位
    r"|[-+]?\d[\d_]*(:[0-5]?\d)+(\.[\d_]*)?"                        # 六十進位(1:20:30)
    r"|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN)"                          # 無限大、非數
    r"|\d{4}-\d\d?-\d\d?([Tt ].*)?")                                  # 日期、日期時間
_YAML_PLAIN_BAD_START = set("-?:,[]{}#&*!|>'\"%@`")


def _yaml_plain_ok(v):
    """★白名單★:這個值不加引號時,本工具的簡易讀法與標準 YAML(Obsidian 等)讀出來一模一樣嗎。
    只放行確定沒事的;拿不準的一律加引號(2026-09-26 代碼審 r1:原本只列「要加引號的」,
    漏了「空白 + #」被標準 YAML 當註解切掉、「- 」開頭被當清單)。"""
    return (v != "" and v == v.strip() and "\n" not in v and "\t" not in v
            and v[0] not in _YAML_PLAIN_BAD_START and ": " not in v and " #" not in v and not v.endswith(":")
            and v.lower() not in ("true", "false", "null", "yes", "no", "on", "off", "~")
            and not _YAML_TYPED_RE.fullmatch(v))


def _yaml_quote(v, what):
    """加引號,只用兩邊讀法一致的寫法:本工具讀的一側只剝掉頭尾一層引號、不解任何跳脫。
    雙引號在標準 YAML 裡會解反斜線跳脫 → 只在沒有反斜線、沒有雙引號時用;
    否則單引號(標準 YAML 裡除了 '' 以外一律照字面)→ 只在沒有單引號時用;兩種都不行就擋。"""
    if '"' not in v and "\\" not in v:
        return '"' + v + '"'
    if "'" not in v:
        return "'" + v + "'"
    raise ValueError(f"{what}「{v}」同時有單引號、又有雙引號或反斜線,工具寫不出本工具和 Obsidian 都讀得一樣的寫法,"
                     "檔案沒動;把其中一種引號換掉再寫")


def fmt_scalar(key, value):
    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
        return v  # bare,絕不加引號
    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)


def fmt_list_item(value):
    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
    v = value.strip()
    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")


def edit_fm_scalar(fm_lines, key, value):
    fm = list(fm_lines)
    formatted = fmt_scalar(key, value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "scalar":
            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
        fm[s] = f"{key}: {formatted}"
    else:
        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
        ins = len(fm)
        for k, s, e, kind in fm_structure(fm):
            if kind in ("list", "block"):
                ins = s
                break
        fm.insert(ins, f"{key}: {formatted}")
    return fm


def edit_fm_sync_status_tag(fm_lines, status):
    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
    fm = list(fm_lines)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if "tags" not in struct or struct["tags"][2] != "list":
        return fm, False
    s, e, _kind = struct["tags"]
    found = False
    for i in range(s + 1, e + 1):
        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
        if m:
            fm[i] = f"{m.group(1)}status/{status}"
            found = True
    return fm, found


def _list_scalar_value(fm, key, line_idx):
    """清單欄位的單一值寫法(`key: 值`)讀出那一個值(去引號,空的回 "")。

    ★看起來是同一行清單就丟 ValueError★:工具不解析同一行裡的逗號(fm_structure 與
    parse_frontmatter 都把它當成一個值),照單一值轉會把整串 "[a, b]" 寫成一項。
    判準看「去引號後的值本身」,不列舉寫法(2026-09-10 代碼審 r2:只比對原始字串時,
    整串加引號、逗號前後多打空白都繞得過):以 [ 或 { 開頭(單一連結 [[X]] 除外),
    或一個值裡有兩個以上連結開頭。加了引號的空清單 "[]" 跟讀的一側一樣當成空的。"""
    m = TOP_KEY_RE.match(fm[line_idx])
    val = m.group(2).strip() if m else ""
    sval = strip_quotes(val)
    t = sval.strip()   # 引號裡面前面多一個空白也要認得(第三輪外家否決席:" [a, b]" 繞過)
    if t == "[]":
        return ""
    # 單一連結要「整個值恰好是一個連結」才豁免(第三輪外家找洞席:[[Systems/A], Systems/B] 開頭像連結就被放行)
    if (t.startswith(("[", "{")) and not _SINGLE_WIKILINK_RE.fullmatch(t)) or _multi_link_value(t):
        raise ValueError(f"{key} 寫成同一行的清單({val}),工具不解析這種寫法,"
                         f"硬加會把整串當成一項寫壞,檔案沒動。這種寫法目前只能手動改成一行一項"
                         f"({key}: 換行後每項一行「  - 值」),改完再重跑")
    return t   # 去掉前後空白:引號裡只有空白就是空的(第四輪正確性席:原本會留下一筆空白垃圾項)


def _list_key_scalar_to_list(fm, key, line_idx):
    """清單欄位被寫成單一值(`about_code: src/x.py`)時,改寫成一項的清單再給 append/remove 用。

    ★讀的一側本來就把單一值當成一項的清單★(as_list),只有寫的一側不認得——
    於是一篇筆記一旦是單一值寫法,append 說它不是清單、set 又不收清單欄位,
    沒有任何指令改得動(2026-09-10 代碼審 r1)。空值(`key:`)當成空清單;
    同一行的清單寫法擋下不轉(見 _list_scalar_value)。"""
    sval = _list_scalar_value(fm, key, line_idx)
    m = TOP_KEY_RE.match(fm[line_idx])
    raw = m.group(2).strip() if m else ""
    fm = list(fm)
    fm[line_idx] = f"{key}:"
    if sval:
        # ★原本那一項原封不動★:有引號就照原樣搬,不去掉再重新加(第三輪外家找洞席:'[[Systems/API "v2"]]'
        # 被重新加成帶反斜線的雙引號,讀的一側不解反斜線,讀回來就不是原本那篇了)
        quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
        fm.insert(line_idx + 1, f"  - {raw if quoted else fmt_list_item(sval)}")
    return fm


def edit_fm_append(fm_lines, key, value):
    fm = list(fm_lines)
    item = fmt_list_item(value)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
        cur = _list_scalar_value(fm, key, struct[key][0])
        if cur and link_target(cur) == tgt:
            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "list":
            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
            fm[s] = f"{key}:"
        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
        for j in range(s + 1, e + 1):
            existing = fm[j].strip()
            if existing.startswith("-") and link_target(existing[1:]) == tgt:
                return fm  # 已存在,no-op
        # 偵測現有項縮排,否則預設 2 空格
        indent = "  "
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-"):
                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
                break
        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
        last = e
        while last > s and not fm[last].strip():
            last -= 1
        fm.insert(last + 1, f"{indent}- {item}")
    else:
        ins = len(fm)
        fm.insert(ins, key + ":")
        fm.insert(ins + 1, f"  - {item}")
    return fm


def edit_fm_remove(fm_lines, key, value):
    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。

    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
    fm = list(fm_lines)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key not in struct:
        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
    if struct[key][2] == "scalar" and key in LIST_KEYS:
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    s, e, kind = struct[key]
    if kind != "list":
        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
    hits = []
    for j in range(s + 1, e + 1):
        existing = fm[j].strip()
        if existing.startswith("-") and link_target(existing[1:]) == tgt:
            hits.append(j)
    if not hits:
        return fm, 0
    for j in reversed(hits):
        del fm[j]
    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    if key in struct2:
        s2, e2, _ = struct2[key]
        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
            del fm[s2:e2 + 1]
    return fm, len(hits)


def decisions_items(fm_lines):
    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
    block = None
    for k, s, e, kind in fm_structure(fm_lines):
        if k == "decisions" and kind == "list":
            block = (s, e)
            break
    if block is None:
        return None
    s, e = block
    item_indent = None
    starts = []
    for i in range(s + 1, e + 1):
        ln = fm_lines[i]
        if not ln.strip():
            continue
        m = re.match(r"^(\s*)-\s", ln)
        if m:
            ind = len(m.group(1))
            if item_indent is None:
                item_indent = ind
            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
                starts.append(i)
    items = []
    for idx, st in enumerate(starts):
        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
        while en > st and not fm_lines[en].strip():
            en -= 1
        items.append((st, en))
    sub_indent = (item_indent + 2) if item_indent is not None else 4
    return s, e, items, (item_indent or 2), sub_indent


def load_raw_for_edit(path: Path):
    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
    raw = path.read_bytes()
    if raw.startswith(b"\xef\xbb\xbf"):
        raise ValueError("這個檔開頭帶 BOM 標記,工具不寫這種檔;先把檔案存成不帶 BOM 的 UTF-8")
    if b"\r\n" in raw:
        raise ValueError("這個檔的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)。Windows 上常是 git autocrlf 造成的;"
                         "修法:確認 .gitattributes 有套用(圖譜目錄標 eol=lf)再跑 git add --renormalize .,"
                         "或單檔跑 dos2unix。工具不會偷偷幫你改行尾。")
    lines = raw.decode("utf-8").split("\n")
    if not lines or lines[0].strip() != "---":
        raise ValueError("這篇筆記開頭沒有欄位區塊(---),沒辦法改欄位")
    fm_end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            fm_end = i
            break
    if fm_end is None:
        raise ValueError("開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),先補上")
    return lines, 1, fm_end


def _write_lf(path: Path, text: str):
    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.9。
    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
    整檔覆寫消費者)。read-modify-write 的併發:set/append/remove 由呼叫端上鎖(_vault_write_lock),
    其他寫入指令仍是 last-write-wins(單機 CLI,accepted)。
    ★暫存檔名每次都不一樣★(2026-09-10 代碼審 r3 併發資源席:原本同一篇筆記大家用同一個固定暫存檔名,
    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
    import os as _os, shutil as _sh, uuid as _uuid
    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
    try:
        with _os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
        if path.exists():
            _sh.copymode(path, tmp)
        _os.replace(tmp, path)
    except BaseException:
        try:
            _os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_write_verify(path: Path, new_lines, key, expected_check):
    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
    orig_fm = load_raw_for_edit(path)
    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
    text = "\n".join(new_lines)
    new_fm_lines = new_lines[1:]
    for i in range(1, len(new_lines)):
        if new_lines[i].strip() == "---":
            new_fm_lines = new_lines[1:i]
            break
    fields, _, new_lint = parse_frontmatter(new_fm_lines)
    if not expected_check(fields):
        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
    introduced = set(new_lint) - orig_lint
    if introduced:
        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)


_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己


_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)


def _vault_lock_where(vault):
    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。

    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。

    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
    互斥照樣成立。

    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
    """
    import hashlib
    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    return primary, None


def _vault_lock_say(lock, why):
    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
          file=sys.stderr)
    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)


def _vault_write_lock(vault):
    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。

    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
    import contextlib, time as _t

    @contextlib.contextmanager
    def _cm():
        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
        lock, why = _vault_lock_where(vault)
        k = str(lock)

        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
            _VAULT_LOCK_HELD[k] += 1
            try:
                yield
            finally:
                _VAULT_LOCK_HELD[k] -= 1
            return

        if why and not _VAULT_LOCK_WARNED.get(k):
            _VAULT_LOCK_WARNED[k] = True
            _vault_lock_say(lock, why)
        deadline = _t.monotonic() + 60
        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
            if _t.monotonic() > deadline:
                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
            _t.sleep(0.05)
        _VAULT_LOCK_HELD[k] = 1
        try:
            yield
        finally:
            _VAULT_LOCK_HELD.pop(k, None)
            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
                    lock.unlink()
            except OSError:
                pass
    return _cm()


def cmd_set(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_set_locked(env, rel, key, value)


def _cmd_set_locked(env, rel, key, value):
    if key in COND_KEYS:
        return _set_conditions_locked(env, rel, key, value if isinstance(value, list) else [value])
    if isinstance(value, list):
        if len(value) != 1:
            print(f"擋下:{key} 只收一個值,你給了 {len(value)} 個,檔案沒動(給多個值只有 {'、'.join(COND_KEYS)} 收)",
                  file=sys.stderr)
            return 2
        value = value[0]
    if key not in SCALAR_KEYS:
        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)},"
              f"以及整欄換掉的 {'、'.join(COND_KEYS)}"
              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
        return 2
    # ★負責範圍跟新開節點用同一支判斷、同樣擋★(筆記欄位關卡補齊_計劃 S11;不看開關——r3 架構席:
    # 同一個欄位的兩個寫入口擋法要一樣;原本只有 new 擋,set 可以寫進一個字)
    if key == "responsibility" and not _nodehome_resp_ok(value):
        print(f"擋下:負責範圍至少 {_NODEHOME_RESP_MIN_CHARS} 個字、要有實字(一句話講這篇負責什麼、不負責什麼),檔案沒動",
              file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    new_fm = edit_fm_scalar(lines[1:e], key, value)
    exp = fmt_scalar(key, value)
    exp_val = strip_quotes(exp)
    tag_synced = False
    if key == "status":
        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
    new_lines = lines[:1] + new_fm + lines[e:]

    def _check(f):
        if str(f.get(key, "")) != exp_val:
            return False
        if tag_synced:
            want = f"status/{exp_val}"
            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
            return want in tags and all(t == want for t in tags if t.startswith("status/"))
        return True

    atomic_write_verify(path, new_lines, key, _check)
    print(f"✓ set {rel}: {key} 已改成 {exp}" + ("(狀態標籤 status/* 也同步改了)" if tag_synced else ""))
    return 0


def _set_conditions_locked(env, rel, key, values):
    """驗收紀錄的前提/回頭條件整欄換掉(Projects/驗收前提欄位可改_計劃)。

    ★為什麼整欄換、不走 append/remove★:這兩欄是散文、常提到連結;append/remove 判斷「同一項」看連結目標,
    兩條提到同一篇的不同條件會被當成重複。原本四種寫法(單行、清單、空的、多行區塊)並存,一律整段拿掉重寫。"""
    vals = [str(v).strip() for v in values]
    if any(_SET_COND_SLOT in v for v in vals):
        print(f"擋下:值裡還留著 {_SET_COND_SLOT}(drift fix 證據頁的佔位字)——換成那一項改寫後的整句,檔案沒動", file=sys.stderr)
        return 2
    if not vals or any(not v for v in vals):
        print(f"擋下:{key} 的每一條都不能是空的,檔案沒動(前提寫這個結論在什麼情況下才算數,回頭條件寫改到什麼該重驗)",
              file=sys.stderr)
        return 2
    if any("\n" in v or "\r" in v for v in vals):
        print(f"擋下:{key} 一條條件只能一行,檔案沒動(要寫多條就給多個值:lumos set <筆記> {key} \"條件一\" \"條件二\")",
              file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, _s, e = load_raw_for_edit(path)
    fm = list(lines[1:e])
    new = ([f"{key}: {fmt_scalar(key, vals[0])}"] if len(vals) == 1
           else [f"{key}:"] + [f"  - {fmt_scalar(key, v)}" for v in vals])
    struct = {k: (a, b) for k, a, b, _kind in fm_structure(fm)}
    if key in struct:
        a, b = struct[key]
        fm[a:b + 1] = new
    else:   # 插的位置照 edit_fm_scalar:第一個清單或多行區塊欄位之前,都沒有就放最後
        at = next((a for _k, a, _b, kind in fm_structure(fm) if kind in ("list", "block")), len(fm))
        fm[at:at] = new
    atomic_write_verify(path, lines[:1] + fm + lines[e:], key, lambda f: _conds(f.get(key)) == vals)
    print(f"✓ set {rel}: {key} 整欄換成 {len(vals)} 條" + ("" if len(vals) == 1 else "(一行一項的清單)"))
    return 0


def cmd_self_audit(env, rel, model="sonnet", date=None):
    """L4 自足性審計留痕:寫 self_audit: <model>/<date> 到節點 frontmatter。
    語意:這整篇節點的「自足性」(無主對話脈絡的乾淨 agent 只讀圖譜能不能還原
    專案現況)已由一個獨立 agent 審過並通過。對應 guard audit 的角色(乾淨 agent
            return None
    ct = _ver_tuple(claude_ver)
    st = _ver_tuple(src_ver)
    if ct is not None and st is not None and ct >= st:
        return None  # CLAUDE 版本 ≥ 來源,不 nudge
    # CLAUDE 落後(或無法比較)→ 提示
    return (
        f"本專案紀律區塊版本 {claude_ver} 落後來源 {src_ver},"
        f" 可跑 lumos update 刷新"
    )


# vendored 工具組白名單(固定 5 檔,scripts/ 前綴;hooks/templates 兩夾另走整夾刪)。
# _vendor_toolchain 安裝端與 cmd_deinit 移除端共用,避免漂移。
_VENDORED_TOOLKIT = ("scripts/lumos", "scripts/test_lumos.py",
                     "scripts/merge-claude-settings.py", "scripts/graph-rename.sh",
                     "scripts/fetch-notesmd.sh")
_VENDORED_TREE_DIRS = ("scripts/hooks", "scripts/templates")   # 安裝時整個目錄照來源複製過去的那兩個
# ★工具確實會安裝進消費專案的每一支檔(精確檔名)★——跳過判斷只認這張表,不認目錄前綴。
# 2026-09-10 代碼審 r1 四席獨立抓到:原本照目錄前綴跳過,消費專案自己放在 scripts/hooks、
# scripts/templates 的程式會被當成工具的檔,推送閘的風險分級被降、逃過代碼審。
# 表要跟工具鏈 repo 裡那兩個目錄底下受版控的檔一模一樣:有一支測試逐檔比對,少登記或多登記都會翻紅。
_VENDORED_TREE_FILES = (
    "scripts/hooks/claude/_hookevent.py",
    "scripts/hooks/claude/check-graph-sync.py",
    "scripts/hooks/claude/ci-status-hook.py",
    "scripts/hooks/claude/memory-sweep.py",
    "scripts/hooks/claude/dispatch-lens-hook.py",
    "scripts/hooks/claude/impact-hook.py",
    "scripts/hooks/claude/lumos-entry-hook.py",
    "scripts/hooks/post-commit",
    "scripts/hooks/pre-commit",
    "scripts/hooks/pre-push",
    "scripts/templates/graph-discipline.md",
    "scripts/templates/note-audit-judge.md",
)
_VENDORED_ALL = frozenset(_VENDORED_TOOLKIT + _VENDORED_TREE_FILES)


_VENDORED_MANIFEST = ".lumos/vendored.json"   # 安裝/更新時記下每支工具檔的內容指紋


def _vendored_digest(data):
    """工具檔的內容指紋:換行統一成 LF 再算 sha256(Windows 的換行轉換不該讓指紋對不上)。"""
    import hashlib
    return hashlib.sha256(bytes(data).replace(b"\r\n", b"\n")).hexdigest()


def _vendored_manifest_write(root):
    """把工作目錄裡「工具自裝檔」的內容指紋寫進 .lumos/vendored.json(安裝與更新時呼叫;回寫進去的 {路徑: 指紋})。"""
    files = {}
    for rel in sorted(_VENDORED_ALL):
        p = Path(root) / rel
        if p.is_file():
            files[rel] = _vendored_digest(p.read_bytes())
    mp = Path(root) / _VENDORED_MANIFEST
    mp.parent.mkdir(parents=True, exist_ok=True)
    # 格式跟錨點基準線同一種({"version": 1, <路徑: sha256>…};第四輪架構席)。不走錨點那種「人核可才改」的流程:
    # 這份是安裝時的事實紀錄,錯了的方向是「多掃」不是「少擋」。ensure_ascii:從某版本讀回來走的是文字模式的 git show
    _write_lf(mp, json.dumps({"version": 1,
                              "note": "lumos 安裝時記下的工具檔內容指紋;內容對得上的才不算專案自己的程式",
                              "files": files}, ensure_ascii=True, indent=1) + "\n")
    return files


def _vendored_state(root, ref=None):
    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。

    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
    present, data = set(), {}
    if ref is None:
        for p in sorted(_VENDORED_ALL):
            fp = Path(root) / p
            if fp.is_file():
                present.add(p)
                try:
                    data[p] = fp.read_bytes()
                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
                    data[p] = None
        try:
            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            man = None
    else:
        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
        for p in sorted(_VENDORED_ALL):
            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
                present.add(p)
                data[p] = None
            elif r.returncode == 0:
                present.add(p)
                data[p] = r.stdout
        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
    files = man.get("files") if isinstance(man, dict) else None
    if not isinstance(files, dict):
        return frozenset(), frozenset(present)
    return (frozenset(p for p in present if data.get(p) is not None and files.get(p) == _vendored_digest(data[p])),
            frozenset(present))


def _diff_range_ends(root, diff_range):
    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
    import subprocess
    r = str(diff_range).strip()
    if "..." in r:
        a, b = r.split("...", 1)
        a, b = a or "HEAD", b or "HEAD"
        try:
            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
                                cwd=str(root), timeout=_disp_git_timeout())
            return (mb.stdout.strip() or a), b
        except (OSError, subprocess.TimeoutExpired):
            return a, b
    if ".." in r:
        a, b = r.split("..", 1)
        return (a or "HEAD"), (b or "HEAD")
    return r, None


def _is_toolchain_repo(root):
    """這個 repo 是不是工具鏈本體(那裡 scripts/lumos 就是產品,不能當成外來的跳過)。

    ★判別鍵沿用既有慣例★(見 `_self_repo_origin`):skills/lumos-project-notes/SKILL.md
    是 user-scope skill 的唯一源,永遠不會被複製進消費專案。"""
    try:
        return (Path(root) / "skills" / "lumos-project-notes" / "SKILL.md").is_file()
    except Exception:
        return False


def _vendored_skip(root, diff_range):
    """消費專案裡這段範圍要跳過的工具檔(工具鏈本體回空集合)。推送前分級與代碼審角色鏡頭共用這一支,見 _vendored_state:
    終點上原封不動的工具檔;終點上已經刪掉、但起點時原封不動的(拆除工具鏈)也跳。"""
    if _is_toolchain_repo(root):
        return frozenset()
    _start, _end = _diff_range_ends(root, diff_range)
    _intact_end, _present_end = _vendored_state(root, _end)
    _intact_start = _vendored_state(root, _start)[0] if _start else frozenset()
    return _intact_end | (_intact_start - _present_end)


def _pull_source_or_abort(src, allow_stale=False):
    """更新來源 clone;拉不到就中止。回傳 0=可繼續、None=中止(呼叫端不得再寫任何檔)。
    """表態檔與修復帳共用的追加(存量漂移改法 第 7 節):①路徑檢查 ②檔尾不是換行先補一個 ③交給 _jsonl_append_verified
    追加並讀回自驗。不改其他帳共用的 _jsonl_append_verified。回 rc。"""
    fp = Path(root) / rel
    err = _drift_ledger_path_err(root, rel)
    if err is None:
        try:
            fp.parent.mkdir(parents=True, exist_ok=True)
        except OSError as ex:
            err = f"建不了 {fp.parent}:{ex}"
    err = err or _drift_ledger_path_err(root, rel)
    if err is None:
        try:
            if fp.is_file() and fp.stat().st_size > 0:
                with open(fp, "rb") as fh:
                    fh.seek(-1, 2)
                    tail = fh.read(1)
                if tail != b"\n":
                    with open(fp, "a", encoding="utf-8") as fh:
                        fh.write("\n")
        except OSError as ex:
            err = f"補不了檔尾換行:{ex}"
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    return _jsonl_append_verified(fp, rec, "id", rec["id"])


# ── 改法:drift fix(Projects/存量漂移改法_計劃)──────────────────────────────────────

_DRIFT_PLACEHOLDER_RE = re.compile(r"<(?:為什麼[^<>\n]{0,30}|sha|卷證)>")


def _drift_placeholder_err(text, what):
    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
    Issue 標成結案、理由是佔位字)。只認 _drift_fix_hint 與 c4 證據頁真的印過、而且會被貼進 --reason/--new 的那幾種
    (為什麼…、sha、卷證);`Map<K,V>`、`<src/lib>` 這種真理由照收(代碼審 r2 正確性席、r3 邊界席)。"""
    m = _DRIFT_PLACEHOLDER_RE.search(text or "")
    return f"{what} 裡還留著提示的佔位字「{m.group(0)}」——換成真的內容再跑" if m else None


def _drift_sh(v, node=False):
    """印給人照貼的指令裡的一個參數:只由文字、數字(含中日韓文字)、底線與 ./@%+=:,- 組成就原樣,其他一律 shlex.quote
    (代碼審 r1 資安席:檔名帶 $(…)、; 或反引號的筆記,照貼提示就會執行攻擊者的指令;正確性席:帶空白會被切成兩個參數)。
    不直接全部 _sh_quote:它把中文也當危險字元,圖譜裡幾乎每條提示都會被包上引號;其他字元一律交給 _sh_quote。
    node=True(drift fix 的節點參數):以 - 開頭會被當成選項,加引號也沒用(shell 會拿掉引號),補成 ./ 開頭——
    _drift_fix_target 認得這個寫法(代碼審 r2 資安席)。"""
    v = str(v)
    if node and v.startswith("-"):
        v = "./" + v
    return v if v and re.fullmatch(r"[\w./@%+=:,-]+", v) else _sh_quote(v)


def _drift_fix_hint(kind, path, line):
    """一筆發現該印的改法指令 → [指令]。★提示的單一產生處★(存量漂移改法 [S10]):drift check 擋下與只列出、drift scan、
    doctor Z 段、計劃收尾的連帶待辦都從這裡拿,不再各自教人手改。"""
    node = _drift_sh(path[:-3] if path.endswith(".md") else path, node=True)
    base = f"lumos drift fix {node} {line} --kind {kind}"
    if kind == "c2":
        return [base + ' --close --status done --reason "<為什麼算解決,附提交或測試>"',
                base + ' --keep --reason "<為什麼還沒解決>"']
    if kind == "c3":
        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + ">"]
    if kind == "c4":
        return [base + "   # 列證據、範本與預填好的 lumos set 整欄指令(c4 不自己寫檔)"]
    if kind == "probe":
        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
    return [base]


def _drift_print_hints(rows, stream, head="改法:"):
    """一批發現的改法指令;c1 一篇一條(改一次整篇的預告句都改掉)。"""
    seen, out = set(), []
    for f in rows:
        k = (f["kind"], f["path"]) if f["kind"] == "c1" else (f["kind"], f["path"], f["line"])
        if k in seen:
            continue
        seen.add(k)
        out += _drift_fix_hint(f["kind"], f["path"], f["line"])
    if out:
        print(head, file=stream)
        for x in out[:20]:
            print(f"    {_esc_clean(x, 300)}", file=stream)
        if len(out) > 20:
            print(f"    …還有 {len(out) - 20} 條(lumos drift scan 看全部)", file=stream)


_DRIFT_C3_STATUSES = frozenset(_STATUS_ENUM["verification"] - {"pending"})
_DRIFT_FIX_OPTS = ("date", "close", "keep", "status", "reason", "by")
_DRIFT_FIX_ALLOWED = {"c1": {"date"}, "c2": {"close", "keep", "status", "reason"}, "c3": {"status", "by"},
                      "c4": set(), "c5": set()}


def _drift_one_line(t):
    """沒有任何分行字元:不只 \\n \\r,還有 str.splitlines() 會切開的 U+2028、U+0085、換頁字元——寫進筆記或帳檔後,
    用 splitlines 讀的人會看成兩行(代碼審 r1 邊界、資安席)。"""
    return len(("x" + t + "x").splitlines()) == 1


def _drift_fix_reason_ok(r):
    return isinstance(r, str) and _drift_one_line(r) and 4 <= len(r.strip()) <= 200


def _drift_fix_c2_args(o):
    if bool(o.get("close")) == bool(o.get("keep")):
        return ('--kind c2 要二擇一:--close --status <結案值> --reason "…"(Issue 解決了)'
                '或 --keep --reason "…"(還沒解決,照留)')
    if o.get("reason") is None:
        return "--kind c2 要帶 --reason(一行、4 到 200 字)"
    if _drift_placeholder_err(o["reason"], "--reason"):
        return _drift_placeholder_err(o["reason"], "--reason")
    if o.get("keep"):
        return "--keep 不收 --status" if o.get("status") is not None else None
    if o.get("status") not in _ISSUE_CLOSED_STATUSES:
        return f"--close 的 --status 只能是 Issue 的結案值:{'/'.join(sorted(_ISSUE_CLOSED_STATUSES))}"
    return None


def _drift_fix_c3_args(o):
    if o.get("status") not in _DRIFT_C3_STATUSES:
        return f"--kind c3 要帶 --status,值只能是 {'/'.join(sorted(_DRIFT_C3_STATUSES))}(驗證紀錄的合法狀態扣掉 pending)"
    return None


_DRIFT_FIX_KIND_ARGS = {"c1": lambda o: None, "c2": _drift_fix_c2_args, "c3": _drift_fix_c3_args,
                        "c4": lambda o: None, "c5": lambda o: None}


def _drift_fix_args_err(kind, o):
    """--kind 與參數的組合合不合 → 錯誤或 None(存量漂移改法 第 1 節的組合表)。"""
    if kind == "probe":
        return ("--kind probe 沒有工具改法:條件成立了就把待辦做掉,再刪掉那一行或改寫成歷史說法;"
                "照留就 lumos drift ack <節點> <行號> --kind probe --reason \"<為什麼照留>\"")
    if kind not in _DRIFT_FIX_KINDS:
        return f"--kind 只能是 {'/'.join(_DRIFT_FIX_KINDS)}"
    extra = {k for k in _DRIFT_FIX_OPTS if o.get(k) not in (None, False)} - _DRIFT_FIX_ALLOWED[kind]
    if extra:
        return f"--kind {kind} 不收 " + "、".join("--" + x for x in sorted(extra))
    if o.get("date") is not None:
        _d, err = _guard_date_arg(o["date"])
        if err:
            return err
    if o.get("reason") is not None and not _drift_fix_reason_ok(o["reason"]):
        return "--reason 要一行、4 到 200 字"
    return _DRIFT_FIX_KIND_ARGS[kind](o)


def _drift_fix_target(env, node):
    """節點 → (筆記路徑, 錯誤)。同名好幾篇不猜(fix 會改檔,不能靠 env.find 取第一篇)。"""
    a = nfc(str(node).strip())
    explicit = a.startswith("./")                      # 提示對 - 開頭的節點印成 ./-x(_drift_sh);./ 開頭就是明確路徑
    a = a[2:] if explicit else a
    a = a[:-3] if a.lower().endswith(".md") else a
    if explicit or "/" in a:        # 給了路徑就只認那一篇,不退回用檔名猜(代碼審 r3 正確性席:./-x 原本被剝掉後改用檔名猜)
        return (a + ".md", None) if (a + ".md") in env.notes else (None, f"找不到筆記 {node}")
    hits = env.by_stem.get(a.lower(), [])
    if len(hits) > 1:
        return None, f"同名筆記有 {len(hits)} 篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"
    if not hits:
        return None, f"找不到筆記 {node}"
    return hits[0], None


def _drift_fix_last_sha(root, repo_rel):
    """修復帳裡這一篇最後一筆(seq 最大)的 after_sha256;沒有回 None。"""
    rows = [d for d in _drift_jsonl_rows(Path(root) / _DRIFT_FIXES) if nfc(str(d.get("path", ""))) == nfc(repo_rel)]
    if not rows:
        return None
    return _drift_bound_latest(rows)[-1].get("after_sha256")


def _drift_fix_clean_err(root, repo_rel, raw):
    """乾淨檢查 → 錯誤或 None:那一篇要在 git 裡有追蹤,而且跟 HEAD 沒差,或現在的指紋等於修復帳裡這一篇最後一筆的
    after_sha256(改動全是工具自己留下的,同一篇可以一項一項修、修完一起提交)。"""
    import hashlib
    ps = _git_paths_nfc(root, repo_rel)
    if not ps:
        return f"{repo_rel} 沒被 git 追蹤(或 git 查不到)——不在版控裡,改壞了退不回來;先提交"
    if len(ps) > 1:
        return f"{repo_rel} 這個名字在 git 裡有 {len(ps)} 種 Unicode 拼法的檔並存,工具分不出要改哪一篇;先手動整理成一篇"
    gp = ps[0]
    r = _lens_git(root, "--literal-pathspecs", "diff", "--no-ext-diff", "--no-textconv", "--quiet", "HEAD", "--", gp)   # 檔名裡的 * 不當萬用字元(r4 邊界、外家)
    if r is None or r.returncode not in (0, 1):
        return "git 查詢失敗或逾時(git diff HEAD),查不出這一篇乾不乾淨"
    if r.returncode == 0 or _drift_fix_last_sha(root, repo_rel) == hashlib.sha256(raw).hexdigest():
        return None
    return f"{repo_rel} 有未提交的改動(不是 drift fix 自己留下的)——先提交或還原再修"


def _drift_fix_load(env, rel, line, kind, o):
    """第 1、2 步:乾淨檢查(--dry-run 不做)、讀那一篇(BOM、CRLF 拒絕)、鎖外新建圖譜物件確認那一行現在是這一種發現。"""
    root, vault_rel = _drift_vault_of(env)
    path = _phys_path(env.vault, rel)
    try:
        if path.is_symlink() or path.stat().st_nlink != 1:
            return None, (f"{rel} 是符號連結或還有別的硬連結——工具用換檔的方式寫入,會把連結換成一般檔、或讓兩邊內容分岔"
                          "(代碼審 r1 邊界席);手動改")
        lines, _s, fe = load_raw_for_edit(path)
    except (ValueError, OSError, UnicodeDecodeError) as ex:
        return None, f"{rel} 打不開:{ex}"
    cx = {"root": root, "rel": rel, "repo_rel": f"{vault_rel}/{rel}", "path": path, "lines": lines, "fe": fe,
          "raw": "\n".join(lines).encode("utf-8"), "kind": kind, "line": line, "o": o}
    if not o.get("dry_run") and kind != "c4":    # 只看、不寫的兩條路不做乾淨檢查(c4 只列證據)
        err = _drift_fix_clean_err(root, cx["repo_rel"], cx["raw"])
        if err:
            return None, err
    cx["env2"] = Env(env.vault)
    cx["f"], err = _drift_current_finding(cx["env2"], rel, line, kind)
    return (None, err) if err else (cx, None)


def _drift_fm_status(lines, fe, status):
    """開頭欄位的 status 改掉、同步 status/* 標籤(同 cmd_set)→ (新的開頭欄位行, 寫後自驗)。"""
    fm = edit_fm_scalar(lines[1:fe], "status", status)
    fm, synced = edit_fm_sync_status_tag(fm, status)
    want = strip_quotes(fmt_scalar("status", status))

    def _ok(f):
        if str(f.get("status", "")) != want:
            return False
        tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
        return (not synced) or (f"status/{want}" in tags and all(t == f"status/{want}" for t in tags if t.startswith("status/")))
    return fm, _ok


def _drift_deps(cx, rels):
    """判定依賴的其他筆記(c1、c5 的家節點)此刻的位元組 → [(路徑, 位元組)];寫入時在鎖內再比一次,判定之後被改過就不寫
    (代碼審 r1 併發席:鎖內原本只比守衛紀錄那一篇)。建圖譜物件到這裡的時間差不處理(〈誠實界線〉)。"""
    out = []
    for r in rels:
        if not r:
            continue
        p = _phys_path(cx["env2"].vault, r)
        try:
            out.append((p, p.read_bytes()))
        except OSError:
            out.append((p, None))
    return out


def _drift_no_kind(*kinds):
    return lambda fs, _txt: not any(x["kind"] in kinds for x in fs)


def _drift_fix_c1(cx):
    """c1:已 pass 的守衛紀錄補改預告句(改句、前提、日期都在 guard 區段,這裡往下呼叫)。"""
    new, missing, day, err = _guard_pass_rewrite(cx["env2"], cx["root"], cx["repo_rel"], cx["lines"], cx["o"].get("date"))
    if err:
        return None, err
    names = "、".join(_GUARD_PROSE_NAMES[k] for k in missing)
    return {"new": new, "key": "status", "check": lambda f: str(f.get("status", "")) == "pass",
            "handled": _drift_no_kind("c1"), "extra": {}, "texts": [],
            "deps": _drift_deps(cx, [_guard_pass_home(cx["env2"], cx["lines"])[0]]),
            "msg": "預告句改成歷史說法" + (f"(轉正日期 {day})" if day else "") + (f";找不到{names},沒改" if names else "")}, None


_DRIFT_BANNER_RE = re.compile(r"^[>\s#*✅★]*已結案[*★\s]*[(（:：]")


def _drift_close_banner(body, banner):
    """正文第一個 `# ` 標題之後、第一段之前加結案橫幅 → (新的正文行, 原本就有橫幅)。
    標題只在圍欄外找(圍欄裡的 `# comment` 不算,代碼審 r1 邊界席);已有橫幅只認「已結案」後面接括號或冒號的形狀,
    「已結案通知功能仍會重複寄信」這種正文不算(外家席);前面可以有 >、#、**、✅、★(本專案 Issue 的真實寫法,代碼審 r2 正確性席)。"""
    vis = {n - 1 for n, _ln in _visible_lines(body)}
    h = next((i for i, ln in enumerate(body) if i in vis and ln.startswith("# ")), None)
    start = 0 if h is None else h + 1
    j = start
    while j < len(body) and not body[j].strip():
        j += 1
    if j < len(body) and _DRIFT_BANNER_RE.match(body[j]):
        return body, True
    if h is None:
        return [banner, "", *body], False
    if j > start:
        return [*body[:j], banner, "", *body[j:]], False
    return [*body[:start], "", banner, "", *body[start:]], False


def _drift_fix_c2(cx):
    """c2 --close:status 改成 Issue 的結案值、正文標題之後加結案橫幅(專案的 Issue 寫法:第一段就寫已結案)。"""
    import datetime
    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
    fm, ok = _drift_fm_status(lines, fe, o["status"])
    banner = (f"> 已結案({datetime.date.today().isoformat()},{o['status']}):{o['reason'].strip().rstrip('。')}。"
              "以下是當時的排查紀錄,不是現況。")
    body, had = _drift_close_banner(lines[fe + 1:], banner)
    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c2"),
            "extra": {}, "texts": [] if had else [(banner, "body")],
            "msg": f"status 改成 {o['status']}" + (";第一段已經是已結案橫幅,沒再加" if had else ",正文加了結案橫幅")}, None


def _drift_fix_by(env, by):
    """--by → (完整相對路徑去 .md, 錯誤)。完整路徑直接查那一篇;短名看 by_stem,找不到或同名好幾篇擋。"""
    a = nfc(str(by).strip())
    a = a[:-3] if a.lower().endswith(".md") else a
    if "/" in a:
        return (a, None) if (a + ".md") in env.notes else (None, f"--by 找不到 {by}")
    hits = env.by_stem.get(a.lower(), [])
    if len(hits) == 1:
        return hits[0][:-3], None
    if not hits:
        return None, f"--by 找不到 {by}"
    return None, f"--by {by} 同名好幾篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"


def _drift_append_note(body, txt):
    """正文最後一個非空行之後、隔一個空行加一行,檔尾一個換行;正文為空就放在開頭欄位結束那行之後。
    正文最後落在沒閉合的程式碼圍欄裡擋下(用 _visible_lines 判:加一行試探,看得見才算在圍欄外)。"""
    probe = [*body, "lumos-drift-probe"]
    if len(probe) not in {no for no, _ln in _visible_lines(probe)}:
        return None, "正文最後停在沒閉合的程式碼圍欄裡,不知道要加在哪——先把圍欄關好"
    last = max((i for i, ln in enumerate(body) if ln.strip()), default=None)
    if last is None:
        return [txt, ""], None
    return [*body[:last + 1], "", txt, ""], None


def _drift_fix_c3(cx):
    """c3:驗證紀錄的 status 改掉、正文最後加一行依狀態措辭的說明;原本的正文不改。"""
    import datetime
    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
    link = None
    if o.get("by"):
        link, err = _drift_fix_by(cx["env2"], o["by"])
        if err:
            return None, err
    st = o["status"]
    txt = f"{datetime.date.today().isoformat()} 狀態改為 {st}(存量漂移 c3)"
    if link:
        txt += f",由 [[{link}]] 解決" if st == "pass" else f",參考 [[{link}]]"
    body, err = _drift_append_note(lines[fe + 1:], txt)
    if err:
        return None, err
    fm, ok = _drift_fm_status(lines, fe, st)
    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c3"),
            "extra": {}, "texts": [(txt, "body")], "msg": f"status 改成 {st},正文最後加了一行說明"}, None


def _drift_c4_key(s):
    """卷證目錄比對用的名字:去 _計劃、NFC、不分大小寫、. 與空白轉連字號。"""
    s = nfc(str(s))
    s = s[:-3] if s.endswith("_計劃") else s
    return re.sub(r"[.\s]+", "-", s).lower()


def _drift_c4_evidence(cx):
    """c4 的證據與範本:那篇第一次被提交的提交、卷證目錄(名字比對猜的)、範本句。"""
    root = cx["root"]
    sha = None if _git_is_shallow(root) else _plan_first_commit(root, cx["repo_rel"], timeout=20)
    first = "shallow,查不到最早提交" if _git_is_shallow(root) else (sha or "查不到")
    n = cx["env2"].notes.get(cx["rel"])
    keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
            if link_target(x)}
    rr = Path(root) / "governance" / "review-reports"
    try:
        dirs = sorted(d.name for d in rr.iterdir() if d.is_dir() and any(k and k in _drift_c4_key(d.name) for k in keys))
    except OSError:
        dirs = []
    reports = [f"governance/review-reports/{d}" for d in dirs]
    tpl = f"提交 {sha[:12] if sha else '<sha>'};代碼審見 {'、'.join(reports) or '<卷證>'}"
    return {"first": first, "reports": reports, "template": tpl}


def _drift_c4_print(cx, ev):
    print(f"{_esc_clean(cx['rel'], 200)} 第 {cx['line']} 行(c4 前提寫「還沒提交」)的證據——只列出、不寫檔:")
    print(f"  ①這篇第一次被提交:{ev['first']}")
    print(f"  ②卷證目錄(用計劃名比對猜的,可能漏或多):{_esc_clean('、'.join(ev['reports']), 300) or '查不到'}")
    print(f"  ③範本句:{_esc_clean(ev['template'], 300)}")
    items = [str(x) for x in as_list(parse_frontmatter(cx["lines"][1:cx["fe"]])[0].get("valid_under"))]
    hit = [k for k, x in enumerate(items) if any(w in x for w in _DRIFT_UNCOMMITTED_WORDS)]
    print("  ④目前 valid_under 各項(本工具讀到的;跟原檔對照一下):")
    for k, x in enumerate(items):
        print(f"    {k + 1}. {_esc_clean(x, 300)}" + ("  ← 要改的這項" if k in hit else ""))
    args = " ".join(_drift_sh(_SET_COND_SLOT if k in hit else x) for k, x in enumerate(items))
    print(f"用 lumos set 整欄重寫:把 {_SET_COND_SLOT} 換成那一項改寫後的整句(原本其他內容要自己留著,範本句只是參考),"
          "其他各項照抄:")
    print(_esc_clean(f"    lumos set {_drift_sh(cx['rel'][:-3], node=True)} valid_under {args}", 2000))


def _drift_fix_c4(cx):
    """c4:只列證據、範本與一條預填好的 lumos set 整欄指令,不寫檔(回 None, None)。
    ★c4 不自己寫開頭欄位的原始文字★:代碼審四輪裡,先是「人給片段、工具換原始文字」,再換成「工具寫整項」,都要自己判斷
    原文是什麼 YAML 形狀(引號、全形空白、冒號後空白、控制字元、巢狀、註解、跨行…),零依賴下沒有標準 YAML 讀法可驗,
    每輪都漏一種(r1 到 r4 邊界、外家、正確性席)。Enzo 2026-09-30 裁改走既有的 lumos set 整欄重寫:它不讀原文形狀、
    從人給的各項整欄重寫,已過代碼審。指令裡是本工具讀到的各項,要改的那項放佔位字,人填整句後照貼。"""
    _drift_c4_print(cx, _drift_c4_evidence(cx))
    return None, None


def _drift_c5_test(root, hline):
    """家節點那條正式行綁的測試 → (測試名清單, 錯誤)。多平台專案帶平台前綴時取識別字(resolve_test_refs)。"""
    m = INVARIANT_RE.match(hline.strip())
    if not m:
        return None, "讀不出家節點的正式合約行"
    try:
        pd = load_platforms(root)
        names = [mm for _pl, mm in resolve_test_refs(m.group(1), pd["platforms"] if pd["multiplatform"] else {},
                                                      pd["default_platform"])]
    except (ValueError, OSError) as ex:
        return None, f"解不出正式行綁的測試:{ex}"
    return (names, None) if names else (None, "家節點的正式行沒有綁測試")


def _drift_fix_c5(cx):
    """c5:轉正做了一半——只改守衛紀錄(status 改 pass、同步標籤、四種預告句改寫;跟 settle 第二步同一支算內容)。"""
    import datetime
    lines, fe = cx["lines"], cx["fe"]
    m = re.search(r"^預告的合約:(.+)$", "\n".join(lines), re.M)
    home_rel = (cx["f"].get("related") or [None])[0]
    htext = env_text(cx["env2"], home_rel) if home_rel and m else None
    if htext is None:
        return None, "讀不出預告的合約或家節點"
    claim, hl = m.group(1).strip(), htext.split("\n")
    he = _drift_fm_end(hl)
    if _guard_planned_idx(hl, he, claim):
        return None, f"家節點 {home_rel[:-3]} 同時有預告行與正式行,先手動刪掉預告行再跑"
            warnings.append({"changed": a, "missing": b,
                             "confidence": conf, "support": sup})
    warnings.sort(key=lambda w: (-w["confidence"], -w["support"], w["changed"]))
    if as_json:
        print(json.dumps({"warnings": warnings, "checked": len(changed)},
                         ensure_ascii=False))
    else:
        for w in warnings:
            print(f"提醒:改了 {w['changed']} 但沒動 {w['missing']}——這兩個檔過去 {w['confidence']:.0%} 的時候是一起改的"
                  f"(共 {w['support']} 次)。確認一下是不是漏改了。")
    return 0


_DELGUARD_STOP = frozenset("if else for while return import class def val var fun void public private static final new this true false null let const function".split())
# ①建置產物:這份★必須與 pre-commit 的 should_exclude 逐項對齊★(既有漂移守衛在比),
# 因為兩邊講的是同一件事——那些目錄裡沒有人寫的原始碼。
_DELGUARD_EXCLUDE_DIRS = ("node_modules/", "bin/", "obj/", "dist/", "build/", "__pycache__/", ".git/")
# ②散文與帳本:★只有 delguard 排,絕對不要複製到 pre-commit 的 should_exclude★
# (2026-09-06 代碼審 r1 通才席判 blocker、實測重現:我為了滿足漂移守衛就把 governance/ 一起
#  抄進 pre-commit,結果 governance/ 底下 28 支真程式全部從「改 code 沒動圖譜就擋」的硬閘裡
#  掉出去——兩份清單語意根本不同:delguard 那份是「哪裡不算活著的程式」,pre-commit 那份是
#  「哪些檔改了不必配圖譜」。)
# 為什麼 delguard 要排:符號被審查卷證或治理帳提到,不代表它還活著,掃它們既不準也很貴。
# 實測四個常用詞(doctor/lumos/check/node)全 repo 命中 75587 行、7.17 秒,排除後 7336 行、
# 0.47 秒(15 倍);逾時降級的成本是跟命中行數成正比,不是 token 數。
# ★docs/ 底下的圖譜本體另有 :(exclude){graph_root} 專門排,這裡多排的是帳本與散文。★
_DELGUARD_PROSE_DIRS = ("governance/", "docs/")
_DELGUARD_ALL_EXCLUDE_DIRS = _DELGUARD_EXCLUDE_DIRS + _DELGUARD_PROSE_DIRS
# 與 pre-commit should_exclude 的 lock 排除規則對齊(`*package-lock.json|*yarn.lock|*pnpm-lock.yaml`)
_DELGUARD_EXCLUDE_LOCKFILES = ("package-lock.json", "yarn.lock", "pnpm-lock.yaml")
DELGUARD_TOKEN_CAP = 40  # staged diff 抽出 token 數上限,超額截斷(dropped 計入輸出提示)
DELGUARD_TOP_N = 10  # CLI 文字輸出逐條列出上限,其餘併入「另有 K 處命中」統計行


def _delguard_is_diff_header(ln):
    """True=這行是 unified diff 的檔頭行(--- a/… / +++ b/… / …/dev/null),不是內容行。
    ★不可寫成 startswith(("---","+++"))★——被刪的 SQL/Lua 註解行 `-- x` 在 diff 裡長成
    `--- x`,那樣會被當檔頭吃掉、整行 token 靜默漏抽(2026-08-11 code-loop r1 s5 F6)。"""
    return (ln.startswith("--- a/") or ln.startswith("+++ b/")
            or ln.startswith("--- /dev/null") or ln.startswith("+++ /dev/null"))


def _delguard_parse_diff(diff_text, graph_root):
    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
    2026-08-11 code-loop r1 C);stopword 表剔除;
    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
        ,"vault_diffs": {path: [line...]}}"""
    import re
    tok_re = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")

    def _flags(ln):
        m = re.search(r" b/(.+)$", ln)
        c = m.group(1) if m else None
        # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
        # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
        # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
        vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
        # 建置產物:任何深度都排(src/robin/ 不撞 bin/ 靠前面那個 "/" )
        # ★散文與帳本:只認 repo 根★(2026-09-06 代碼審 r1 外家席)——消費專案的
        # src/docs/parser.py、packages/governance/rules.py 很可能是真程式,不是散文;
        # 而且 git grep 那側的 :(exclude)docs 本來就只排根目錄、pre-commit 寫的也是
        # docs/*,三處要同一個語意才不會各自漂。
        excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
                                for seg in _DELGUARD_EXCLUDE_DIRS)
                            or any(c.startswith(seg) for seg in _DELGUARD_PROSE_DIRS)
                            or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
        return c, vault, excl

    lines = diff_text.splitlines()
    # 第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔不收(文件提及不算「還活著」)
    added, cur, skip, in_binary = {}, None, True, False
    for ln in lines:
        if ln.startswith("diff --git"):
            cur, is_v, is_e = _flags(ln)
            skip = (cur is None) or is_v or is_e or cur.endswith(".md")
            in_binary = False
            continue
        if ln.startswith("Binary files"):
            in_binary = True
            continue
        if skip or in_binary:
            continue
        if ln.startswith("+") and not _delguard_is_diff_header(ln):
            added.setdefault(cur, set()).update(tok_re.findall(ln))
    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
    tokens, seen = [], set()
    vault_diffs, cur, is_vault, is_excl, in_binary = {}, None, False, False, False
    for ln in lines:
        if ln.startswith("diff --git"):
            cur, is_vault, is_excl = _flags(ln)
            in_binary = False
            continue
        if ln.startswith("Binary files"):
            in_binary = True
            continue
        if in_binary or cur is None:
            continue
        if is_vault and (ln.startswith("+") or ln.startswith("-")) and not _delguard_is_diff_header(ln):
            vault_diffs.setdefault(cur, []).append(ln)
            continue
        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
        # (r2 code-loop 折入:N5)
        if is_vault or is_excl or cur.endswith(".md"):
            continue
        if ln.startswith("-") and not _delguard_is_diff_header(ln):
            fadd = added.get(cur) or frozenset()
            for t in tok_re.findall(ln):
                if t in _DELGUARD_STOP or t in fadd or t in seen:
                    continue
                seen.add(t); tokens.append(t)
    return {"tokens": tokens, "vault_diffs": vault_diffs}


def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
    import re, subprocess
    if not tokens:
        return {}
    cmd = ["git", "-c", "core.quotePath=off", "grep", "--cached", "-n", "-I", "-w", "-F"]
    for t in tokens:
        cmd += ["-e", t]
    cmd += ["--", ".", f":(exclude){graph_root}"]
    for d in _DELGUARD_ALL_EXCLUDE_DIRS:
        cmd += [f":(exclude){d.rstrip('/')}"]
    r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", cwd=repo_root, timeout=timeout)
    if r.returncode > 1:
        raise RuntimeError(f"git grep rc={r.returncode}: {r.stderr.strip()[:200]}")
    alive = set()
    pats = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
    for line in r.stdout.splitlines():
        # ★只對內容域配 token★:git grep 輸出是 `path:lineno:content`,連路徑一起配
        # 會被檔名撞名誤降級(刪掉 Login() → app/Login.kt 這個路徑本身讓 Login 判 low,
        # 2026-08-11 code-loop r1 B)。len<3 的行(如 `Binary file … matches`)直接丟。
        parts = line.split(":", 2)
        if len(parts) < 3:
            continue
        content = parts[2]
        for t, p in pats.items():
            if t not in alive and p.search(content):
                alive.add(t)
    return {t: ("low" if t in alive else "high") for t in tokens}


def _delguard_vault_scan(tokens, conf, graph_root_abs, deadline_check=None):
    """回 [{"node": "Systems/憑證.md", "folder": "Systems", "line_no": int,
            "line": str(strip,截 160 字), "tokens": [..], "conf": "high"|"low"}...]
       排序: (conf!=high, folder!="Systems", node, line_no)——高信心先、Systems 先。
       deadline_check: 選用 callable(),os.walk 外層迴圈每檔呼叫一次;回 True 立即
       return 目前累積 hits(部分結果,呼叫端已知逾時語意)。"""
    import re, os
    if not tokens:
        return []
    rx = re.compile(r"\b(?:" + "|".join(map(re.escape, tokens)) + r")\b", re.ASCII)
    per = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
    hits = []
    for dirpath, _dirs, files in os.walk(graph_root_abs):
        for fn in files:
            if deadline_check is not None and deadline_check():
                hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
                return hits
            if not fn.endswith(".md"):
                continue
            fp = os.path.join(dirpath, fn)
            rel = os.path.relpath(fp, graph_root_abs)
            folder = rel.split(os.sep, 1)[0]
            try:
                text = open(fp, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            for i, line in enumerate(text.splitlines(), 1):
                # 單巨檔也要能中止:只在 os.walk 外層檢查的話,一份幾十萬行的節點會整份掃完
                # 才輪到下一次檢查,deadline 直接超支(2026-08-11 code-loop r1 H)
                if deadline_check is not None and i % 2000 == 0 and deadline_check():
                    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
                    return hits
                if not rx.search(line):
                    continue
                ts = [t for t, p in per.items() if p.search(line)]
                hits.append({"node": rel.replace(os.sep, "/"), "folder": folder, "line_no": i,
                             "line": line.strip()[:160], "tokens": ts,
                             "conf": "high" if any(conf.get(t) == "high" for t in ts) else "low"})
    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
    return hits


def _delguard_purelink(diff_lines):
    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
    import re
    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
    plus = [ln[1:] for ln in diff_lines
            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
    minus = [ln[1:] for ln in diff_lines
             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
    changed = plus + minus
    if not changed:
        return False
    ms = {c.strip() for c in minus}
    if any(p.strip() in ms for p in plus):
        return False
    return all(item_re.match(c) or key_re.match(c) for c in changed)


def _delguard_log_result(gr, kind, n_tokens, hits, secs, reason=None):
    """delguard 跑完(ok / 部分結果 degraded)記帳——2026-09-05 第二輪審視 d3:之前只記超時,治理帳看不出比例(架構 r1 E:與 _delguard_log_degraded 對稱的具名 helper)。"""
    try:
        _append_governance_log(Path(gr), [{"gate": "delguard", "kind": kind, "hard": False,
                                           "nodes": sorted({h["node"] for h in hits})[:10],
                                           "note": f"tokens={n_tokens} hits={len(hits)} secs={secs:.1f}" + (f" reason={reason}" if reason else "")}])
    except Exception:
        pass


def _delguard_log_degraded(gr, reason, n_tokens):
    """★體檢 #9(2026-08-21)★:delguard 降級(超時/內部錯誤)一律寫治理帳 gate=delguard kind=degraded。
    之前只印一行「放行」——一天印 5 次、無處可數;現在 gov --stats 看得到降級率。best-effort 靜默。
    commit 欄=當下 HEAD(pre-commit 時=上一個 commit),note 標 reason。"""
    try:
        if gr:
            _append_governance_log(Path(gr), [{"gate": "delguard", "kind": "degraded", "hard": False,
                                               "nodes": [], "note": f"reason={reason} tokens={n_tokens}"}])
    except Exception:
        pass


def cmd_delguard_check(repo=None, as_json=False):
    """code 側刪除傳播守衛(advisory):staged diff 抽被刪 token → 兩檔信心 → grep vault 指名過期原句。
    恆 rc0(內部錯誤/超時皆 fail-open 放行;唯一輸出差異是訊息)。
    vault-free repo(找不到 graph root)→ 靜默 rc0,不掃。
    --json 降級契約(超時/內部錯誤皆同款):單行合法 JSON
    {"tokens": int, "hits": [], "fake_sync": [], "degraded": true, "reason": "timeout"|"error"},rc0。"""
    import json, os, subprocess, time
    t0 = time.monotonic()
    try:  # 亂設的 env 不該讓 pre-commit 印 traceback(fail-open 契約覆蓋設定錯誤)
        deadline = float(os.environ.get("LUMOS_DELGUARD_DEADLINE", "15.0"))  # 5.0 在本 repo(377 篇+大 diff)仍常超,2026-08-27 一 session 降級多次→15;advisory fail-open,pre-commit 多等幾秒換掃完整
    except (ValueError, TypeError):
        deadline = 15.0   # s1-f2:兜底跟預設一致(原 2.0,主值調 15 後落差 7.5 倍→非數值 env 悄悄退化只給 2 秒)
    def _over():
        return time.monotonic() - t0 > deadline
    def _degraded_json(reason, n_tokens):
        print(json.dumps({"tokens": n_tokens, "hits": [], "fake_sync": [],
                          "degraded": True, "reason": reason}, ensure_ascii=False))
    tokens = []
    try:
        if os.environ.get("LUMOS_DELGUARD_RAISE"):
            raise RuntimeError("test hook")
        root = str(_cochange_repo_root(repo) or os.getcwd())
        gr = find_vault(Path(root))  # 既有 vault 偵測 helper;找不到→靜默 rc0(vault-free repo 不掃)
        if not gr:
            return 0
        gr_rel = os.path.relpath(gr, root).replace(os.sep, "/")
        # standalone vault repo(整個 repo 就是 vault,graph_root=".")→ 沒有 code 側可守,
        # 且 "." 前綴會讓每個檔都判成 vault、路徑相對計算全歪 → 靜默 rc0(2026-08-11 code-loop r1 E)
        if gr_rel == ".":
            return 0
        # diff 前綴固定:使用者 ~/.gitconfig 若設 diff.noprefix / diff.mnemonicPrefix,
        # 檔頭會變成 `--- app/x` 或 `--- i/app/x`,` b/` 抽檔名整條失效 → token 全漏(r1 D)
        r = subprocess.run(["git", "-c", "core.quotePath=off",
                            "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
                            "diff", "--no-ext-diff", "--no-textconv", "--cached", "-M", "--no-color"],
                           capture_output=True, text=True, errors="replace", cwd=root,
                           timeout=max(0.1, deadline - (time.monotonic() - t0)))
        if r.returncode != 0:
            # ★不得靜默吞★:git diff 失敗時 r.stdout 恆空,若不擋下去會被
            # _delguard_parse_diff 解析成「tokens=0」——長得像掃描乾淨的成功結果,
            # 實際是沒掃到東西的失敗(r2 code-loop 折入:N3①)。丟進既有 except
            # 才能落成 degraded=true/內部錯誤,而不是假成功。
            raise RuntimeError(f"git diff rc={r.returncode}: {r.stderr[:200]}")
        parsed = _delguard_parse_diff(r.stdout, gr_rel)
        tokens = parsed["tokens"][:DELGUARD_TOKEN_CAP]
        dropped = len(parsed["tokens"]) - len(tokens)
        if _over():
            _delguard_log_degraded(gr, "timeout", len(tokens))
            if as_json:
                _degraded_json("timeout", len(tokens))
            else:
                print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查超時降級({deadline}s 內沒掃完),先放行;這次結果不完整,已記一筆在治理帳。")
            return 0
        rem = max(0.1, deadline - (time.monotonic() - t0))
        conf = _delguard_confidence(tokens, root, gr_rel, timeout=rem)
        if _over():
            _delguard_log_degraded(gr, "timeout", len(tokens))
            if as_json:
                _degraded_json("timeout", len(tokens))
            else:
                print(f"delguard: 超時降級({deadline}s),放行;本輪掃描不完整(已記治理帳 delguard/degraded)")
            return 0
        _trunc = {"hit": False}
        def _deadline_check():
            if time.monotonic() - t0 > deadline:
                _trunc["hit"] = True   # 掃描真的被截斷才算部分結果(delta r2:剛好慢了但掃完不算)
                return True
            return False
        hits = _delguard_vault_scan(tokens, conf, gr, deadline_check=_deadline_check)
        _partial = _trunc["hit"]   # 外家 r1 M2:掃描被 deadline 截斷回部分結果,不能算 ok
        _slow = (not _partial) and (time.monotonic() - t0 > deadline)   # delta r3:單一大檔掃完才發現超時=結果完整但慢,記 ok 帶 reason=slow 讓帳看得到
        _delguard_log_result(gr, "degraded" if _partial else "ok", len(tokens), hits, time.monotonic() - t0, reason=("timeout-partial" if _partial else ("slow" if _slow else None)))
        fake = []
        for path, dl in parsed["vault_diffs"].items():
            rel = os.path.relpath(os.path.join(root, path), gr).replace(os.sep, "/")
            if _delguard_purelink(dl) and any(h["node"] == rel for h in hits):
                fake.append(rel)
        if as_json:
            print(json.dumps({"tokens": len(tokens), "dropped": dropped, "hits": hits,
                              "fake_sync": fake, "degraded": _partial, **({"reason": "timeout-partial"} if _partial else {})}, ensure_ascii=False))   # 外家 r2:部分結果不能宣稱完整
            return 0
        if not hits:
            if dropped:
                print(f"delguard: 無命中;{dropped} 個符號超 cap 未掃(--json 看已掃全量)")
            return 0
        hi = sum(1 for h in hits if h["conf"] == "high")
        n_hit_tokens = len({t for h in hits for t in h["tokens"]})
        print(f"提醒:這次刪掉的東西,有 {n_hit_tokens} 個被刪符號還在筆記裡被提到(確定沒別處在用的 {hi} 個/不確定的 {len(hits)-hi} 個)。筆記講的東西已經不在了,讀的人會被誤導。")
        for h in hits[:DELGUARD_TOP_N]:
            print(f"  [{h['conf']}] {h['node']}:{h['line_no']} 「{h['line']}」 ← {','.join(h['tokens'])}")
        rest = len(hits) - min(len(hits), DELGUARD_TOP_N)
        if rest or dropped:
            print(f"  …另有 {rest} 處命中/{dropped} 個符號超 cap 未展開(--json 看已掃全量)")
        for n in fake:
            print(f"  提醒:{n} 這次只加了連結、正文沒改,但正文還在講已經被刪掉的東西。")
        print("  退場前自問:這次到底拿掉或改變了什麼?上面每一句,改完之後還是對的嗎?")
        print("  還對的寫一句為什麼;不對的現在就改掉或標過期。光是幫筆記加連結,不算更新內容。")
        return 0
    except subprocess.TimeoutExpired:
        # git diff/grep 子程序逾時漏出來——那是「超時」不是「內部錯誤」(2026-08-21 體檢 #9:
        # 當天印的「內部錯誤(TimeoutExpired)」全屬此類,誤導讀者以為壞了)
        _delguard_log_degraded(locals().get("gr"), "timeout", len(locals().get("tokens", [])))
        if as_json:
            _degraded_json("timeout", len(locals().get("tokens", [])))
        else:
            print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查超時降級(git 子程序逾時),先放行;這次結果不完整,已記一筆在治理帳。")
        return 0
    except Exception as e:
        _gr = locals().get("gr")
        if not _gr:   # 例外可能發生在 gr 算出來之前(測試鉤子/早期 git 失敗)→ 自己找 vault 再落帳
            try:
                _root = str(_cochange_repo_root(repo) or os.getcwd())
                _gr = find_vault(Path(_root))
                # standalone vault(vault 即 repo 根)→ 帳會寫到 repo 外(vault.parent),與主路徑
                # gr_rel=="." 早退同語意:不落帳(code-loop r1 s2)
                if _gr and os.path.relpath(_gr, _root).replace(os.sep, "/") == ".":
                    _gr = None
            except Exception:
                _gr = None
        _delguard_log_degraded(_gr, f"error:{e.__class__.__name__}", len(locals().get("tokens", [])))
        if as_json:
            _degraded_json("error", len(locals().get("tokens", [])))
        else:
            print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查自己出了內部錯誤({e.__class__.__name__}),先放行;已記一筆在治理帳。")
        return 0



_ARCH_IDIOM_SKILL = {"kt": "kotlin-idioms", "kts": "kotlin-idioms", "cs": "csharp-idioms", "vue": "vue-idioms",
                     "ts": "vue-idioms", "js": "vue-idioms", "swift": "swift-idioms", "py": "python-idioms",
                     "java": "java-idioms", "dart": "dart-idioms"}


        names = set(refs)
        if plat is not None:
            try:
                names = {mm for _pl, mm in resolve_test_refs(m.group(1), plat[0], plat[1])}
            except ValueError:
                names = set()
        if method in names:
            return i
    return None


def _guard_planned_idx(lines, e, claim):
    """家筆記裡「剝掉 [watch:]/[due:] 之後完整文字等於這句合約」的預告行索引清單(0 條、1 條、好幾條由呼叫端判)。"""
    want = (claim or "").strip()
    out = []
    for i in range(1, e):
        m = PLANNED_RE.match(lines[i].strip())
        if m and _PLANNED_TAIL_RE.sub("", m.group(1)).strip() == want:
            out.append(i)
    return out


# 人手補的「已轉正」段(正文):settle 句下一個非空行長這樣,改句時刪掉 settle 句本身、不再疊一行(存量漂移改法 第 2 節)
_GUARD_MANUAL_SETTLED_RE = re.compile(r"^\(?(\d{4}-\d{2}-\d{2})\)? ?已轉正")
_GUARD_WHY_SETTLED_DATE_RE = re.compile(r"\((\d{4}-\d{2}-\d{2}) 已轉正\)\s*$")


def _guard_manual_settled_after(lines, i):
    """第 i 行之後(跳過空行)的下一個非空行是不是人手補的「已轉正」段。"""
    for ln in lines[i + 1:]:
        if ln.strip():
            return bool(_GUARD_MANUAL_SETTLED_RE.match(ln.strip()))
    return False


def _guard_prose_ops(lines):
    """守衛紀錄裡的預告句 → [(行索引, 種類)]。種類:test/why/why-done/whynot/settle,
    settle 句下一個非空行已是手補的「已轉正」段時記 settle-del(刪掉 settle 句那一行)。"""
    regs = _notelines_regions("\n".join(lines))
    ops = []
    for i, ln in enumerate(lines):
        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
        if k == "settle" and _guard_manual_settled_after(lines, i):
            k = "settle-del"
        if k is not None:
            ops.append((i, k))
    return ops


def _guard_prose_needs_date(ops):
    """改句要不要寫日期:TEST、WHY 兩句與換成「(日期 已轉正)」的 settle 句要;只改「為什麼還不做:」或刪 settle 句不要。"""
    return any(k in ("test", "why", "settle") for _i, k in ops)


def _guard_settle_rewrite(lines, today, home_link):
    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。
    settle 句下一個非空行已是手補的「已轉正」段:刪掉 settle 句那一行(連同緊接的一個空行),算處理過、不進 missing
    ——pending 轉正與 pass 補改走同一支,同一種句子不因入口不同而結果不同(存量漂移改法 第 2 節)。
    today 只在要寫日期時用得到(見 _guard_prose_needs_date)。"""
    ops = dict(_guard_prose_ops(lines))
    out, seen, skip = [], set(), set()
    for i, ln in enumerate(lines):
        if i in skip:
            continue
        k = ops.get(i)
        if k is None:
            out.append(ln)
            continue
        seen.add({"why-done": "why", "settle-del": "settle"}.get(k, k))
        ind = ln[:len(ln) - len(ln.lstrip())]
        if k == "test":
            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
        elif k == "why":
            out.append(f"{ln.rstrip()}({today} 已轉正)")
        elif k == "whynot":
            out.append(f"{ind}預告當時{ln.lstrip()}")
        elif k == "settle":
            out.append(f"{ind}({today} 已轉正)")
        elif k == "settle-del":
            if i + 1 < len(lines) and not lines[i + 1].strip():
                skip.add(i + 1)
        else:
            out.append(ln)
    return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]


def _guard_date_arg(s):
    """--date 的值 → (日期字串, 錯誤)。格式要 YYYY-MM-DD、不晚於今天。"""
    import datetime
    try:
        d = datetime.date.fromisoformat(str(s).strip())
    except ValueError:
        return None, f"--date 要寫成 YYYY-MM-DD,你給的是 {s!r}"
    if d > datetime.date.today():
        return None, f"--date {d.isoformat()} 晚於今天,轉正日期不能是未來"
    return d.isoformat(), None


def _guard_written_settled_dates(lines):
    """那篇守衛紀錄裡已經寫過的轉正日期:正文手補的「<日期> 已轉正」段、摘要 WHY 行尾的「(<日期> 已轉正)」。"""
    regs = _notelines_regions("\n".join(lines))
    got = set()
    for i, ln in enumerate(lines):
        r = regs[i] if i < len(regs) else "body"
        if r == "body":
            m = _GUARD_MANUAL_SETTLED_RE.match(ln.strip())
        elif r == "summary" and _guard_planned_prose(ln, r, settled_ok=True) == "why-done":
            m = _GUARD_WHY_SETTLED_DATE_RE.search(ln)
        else:
            m = None
        if m:
            got.add(m.group(1))
    return got


def _git_paths_nfc(root, repo_rel):
    """repo 相對路徑(NFC)→ git ls-files 裡 NFC 後相同的原樣路徑(無損解碼、去重、照 git 的順序);git 失敗回 None。
    同一個名字有兩種 Unicode 拼法的檔並存時會有兩筆;合併衝突中同一條路徑列三次,去重後算一筆(代碼審 r4 正確性席)。"""
    raw = _nodehome_git(root, "ls-files", "-z")
    if raw is None:
        return None
    want = nfc(repo_rel)
    return list(dict.fromkeys(x for x in _nodehome_split_z(raw) if nfc(x) == want))


def _guard_raw_git_path(root, repo_rel):
    """repo 相對路徑(NFC)→ git ls-files 列出的原樣路徑(傳回給 git 用);找不到或 git 失敗回 None。"""
    ps = _git_paths_nfc(root, repo_rel)
    return ps[0] if ps else None


def _guard_pass_commit_date(root, repo_rel):
    """守衛紀錄第一次變成 status: pass 的提交日期 → (日期, 錯誤)。那一筆若也是這個檔第一次出現的提交(匯入、搬目錄、
    改名後重新加入)就不算。不用 git log -S <合約文字>:settle 是原地換行,出現次數不變,找不到轉正那次(設計審 r1)。"""
    if _git_is_shallow(root):
        return None, "這個 repo 是 shallow clone,查不到完整歷史"
    raw = _guard_raw_git_path(root, repo_rel)
    if raw is None:
        return None, f"git 裡找不到 {repo_rel}(沒被追蹤,或 git 查詢失敗/逾時)"
    log = _nodehome_git(root, "log", "--reverse", "--format=%H%x09%as", "-G", "^status: pass", "--", raw)
    added = _nodehome_git(root, "log", "--diff-filter=A", "--format=%H", "--", raw)
    if log is None or added is None:
        return None, "git 查詢失敗或逾時"
    adds = set(added.decode("utf-8", "replace").split())
    for row in log.decode("utf-8", "replace").splitlines():
        sha, _t, day = row.partition("\t")
        blob = _nodehome_git(root, "show", f"{sha}:{raw}")
        if blob is None:
            continue
        fm, _b = split_frontmatter(blob.decode("utf-8", "replace"))
        if not fm or str(parse_frontmatter(fm)[0].get("status", "")).strip() != "pass":
            continue
        if sha in adds:
            return None, f"第一次是 pass 的提交 {sha[:12]} 也是這個檔第一次出現的提交(整批匯入或搬過目錄),那天不是轉正日"
        return day.strip(), None
    return None, "歷史裡找不到它變成 pass 的提交"


def _guard_settled_date(root, repo_rel, lines, date_arg):
    """補改句要寫的轉正日期 → (日期, 錯誤)。依序:--date、那篇已寫的轉正日期、守衛紀錄第一次變成 pass 的提交日期;
    推不出來回錯誤,★不拿今天充數★(存量漂移改法 第 2 節)。"""
    if date_arg is not None:
        return _guard_date_arg(date_arg)
    got = _guard_written_settled_dates(lines)
    if len(got) > 1:
        return None, f"這篇已寫的轉正日期不一致({'、'.join(sorted(got))}),用 --date 指定"
    if got:
        return next(iter(got)), None
    d, why = _guard_pass_commit_date(root, repo_rel)
    if d is None:
        return None, f"推不出轉正日期({why}),用 --date YYYY-MM-DD 指定"
    return d, None


def _guard_pass_home(env, glines):
    """已 pass 的守衛紀錄補改句的前提:讀得出預告的合約、家節點摘要裡有這條合約綁了測試的正式行。
    → (家節點路徑, 錯誤)。"""
    gfm, _gb = split_frontmatter("\n".join(glines))
    gfields = parse_frontmatter(gfm)[0] if gfm is not None else {}
    m = re.search(r"^預告的合約:(.+)$", "\n".join(glines), re.M)
    claim = m.group(1).strip() if m else ""
    home = _guard_home_of_fields(gfields)
    home_rel = env.find(home) if home else None
    htext = env_text(env, home_rel) if home_rel else None
    if claim and htext is not None:
        hfm, _hb = split_frontmatter(htext)
        if hfm is not None and _guard_formal_line(htext.split("\n"), len(hfm) + 1, claim, None) is not None:
            return home_rel, None
    what = ("讀不出預告的合約" if not claim else f"找不到家節點 {home or '(沒寫)'}" if htext is None
            else f"家節點 {home_rel[:-3]} 的摘要裡沒有這條合約綁了測試的正式行")
    return None, (f"{what}。兩條出路:這條合約其實還沒轉正——把 status 改回 pending 後走 lumos guard settle;"
                  "或正式行寫在別處——手動改句後,對剩下的 c1 用 lumos drift ack")


def _guard_pass_rewrite(env, root, repo_rel, glines, date_arg):
    """已 pass 但還留著預告句的守衛紀錄 → (改寫後的行, 找不到的句型, 用的日期, 錯誤)。前提、日期、不疊都在這裡;
    guard settle 與 drift fix --kind c1 共用(drift 往下呼叫 guard,guard 不呼叫 drift)。"""
    home_rel, err = _guard_pass_home(env, glines)
    if err:
        return None, None, None, err
    ops = _guard_prose_ops(glines)
    day = None
    if _guard_prose_needs_date(ops):
        day, err = _guard_settled_date(root, repo_rel, glines, date_arg)
        if err:
            return None, None, None, err
    elif date_arg is not None:
        day, err = _guard_date_arg(date_arg)
        if err:
            return None, None, None, err
    new, missing = _guard_settle_rewrite(glines, day, home_rel[:-3])
    return new, missing, day, None


def _guard_touched_hits(files, touched):
    """家節點管的那些檔,跟這次改到的檔對得上哪幾個。回 (對上的清單, 是不是只在忽略大小寫時才對上)。

    ★比對鍵走既有那支★(代碼審 r2 架構席 blocker):about_code 的比對鍵全 repo 只有一個算法
    `_nodehome_key`(路徑正規化 + NFC),2026-09-10 那輪代碼審就是為了收斂「三處各寫一份、
    各版解得不一樣」才立的。第一版自己刻了一份,解不了 `a/../b`——而那正是這個 repo
    自己認證過、也修過一次的人手寫法,漏掉的話該擋的推送會安靜放行。

    在那之上多兩條**只會多擋、不會少擋**的保險:家節點寫的是資料夾(看底下的檔)、只有忽略大小寫
    才對得上。寫入端(`_about_code_path`)確實已經擋掉這兩種寫法(要求是檔案、大小寫要跟磁碟一致),
    所以走指令寫進去的不會踩到;留著是因為★寫入端的保證不等於讀取端的保證★——開頭欄位可以被手改,
    而這一層漏掉是沒人會發現的(多擋一次訊息會講清楚為什麼)。
    """
    tset = {_nodehome_key(x) for x in touched}
    tset.discard("")
    hits, only_case = [], []
    for raw in files:
        f = _nodehome_key(raw)
        if not f:
            continue
        if f in tset:
            hits.append(raw)
            continue
        under = sorted(x for x in tset if x.startswith(f + "/"))
        if under:
            hits.append(f"{raw}(底下的 {under[0]})")
            continue
        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上
        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。
        same = sorted(x for x in tset if x.lower() == f.lower())
        if same:
            hits.append(f"{raw}(大小寫不同:{same[0]})")
            only_case.append(raw)
    return hits, only_case


def _guard_touches(gn, env, touched):
    """這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。

    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):
    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。
    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
    seen, dup = {}, []
    for b in clauses:
        for nm in b["refs"]:
            if nm in seen and seen[nm] != b["id"]:
                dup.append(f"{nm}({seen[nm]} 與 {b['id']})")
            seen.setdefault(nm, b["id"])
    if dup:
        return [f"{P} ✗ — 風險低每條條款的測試名要互不相同(重複:" + "、".join(dup) + ")",
                "    一支測試證一條條款;十條全綁同一支也能「全部存在」,所以擋"]
    return []


def _spec_gate_keeps_rows(text, clauses):
    """回 (標了 [keeps] 的條款 id 集合, 疑似變體([Keeps]/全形括號)的條款 id 清單)——變體一律當沒標。"""
    lines_all = text.splitlines()
    keeps, variant = set(), []
    for b in clauses:
        seg = lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else ""
        if _KEEPS_RE.search(seg):
            keeps.add(b["id"])
        elif _KEEPS_VARIANT_RE.search(seg):
            variant.append(b["id"])
    return keeps, variant


def _plan_first_commit(rr, plan_repo_rel, timeout=None):
    """計劃檔第一次進 git 歷史的提交(r4:frontmatter 的 created 用 lumos set 就能改,不可信);沒進歷史回 None。
    timeout 給了就是秒數,逾時當查不到(drift fix --kind c4 列證據用;存量漂移改法 第 5 節)。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "log", "--diff-filter=A", "--format=%H", "--", plan_repo_rel],
                           capture_output=True, text=True, errors="replace", timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    shas = r.stdout.split() if r.returncode == 0 else []
    return shas[-1] if shas else None


def _test_exists_before(rr, commit, name):
    """計劃建立前的樹(那個提交的上一個)裡整字找得到這個測試名;沒有上一個提交=樹是空的=不存在。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "rev-parse", "-q", "--verify", commit + "^"], capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            return False
        g = subprocess.run(["git", "-C", str(rr), "grep", "-q", "-w", "-e", name, r.stdout.strip(), "--"], capture_output=True, text=True, errors="replace")
        return g.returncode == 0
    except OSError:
        return False


def _spec_gate_twoway_static(text, clauses, names, rr, plan_repo_rel):
    """風險低的靜態條件(跑測試之前):至少一條沒標 keeps;標 keeps 的測試在計劃建立前就存在(計劃沒進歷史=驗不了,擋)。回 (要印的行, 擋不擋)。"""
    P = "[spec-gate] 風險低:"
    keeps, variant = _spec_gate_keeps_rows(text, clauses)
    out = []
    if variant:
        out.append(f"{P} 看到疑似 keeps 變體({'、'.join(variant)}):只認半形小寫 [keeps],這幾條當新行為(測試要紅)")

