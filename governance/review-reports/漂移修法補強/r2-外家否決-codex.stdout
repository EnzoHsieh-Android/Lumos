# vendored 工具組白名單(固定 5 檔,scripts/ 前綴;hooks/templates 兩夾另走整夾刪)。
# _vendor_toolchain 安裝端與 cmd_deinit 移除端共用,避免漂移。
_VENDORED_TOOLKIT = ("scripts/lumos", "scripts/test_lumos.py",
                     "scripts/merge-claude-settings.py", "scripts/graph-rename.sh",
                     "scripts/fetch-notesmd.sh")
_VENDORED_TREE_DIRS = ("scripts/hooks", "scripts/templates")   # 安裝時整個目錄照來源複製過去的那兩個
# ★工具確實會安裝進消費專案的每一支檔(精確檔名)★——跳過判斷只認這張表,不認目錄前綴。
# 2026-09-10 代碼審 r1 四席獨立抓到:原本照目錄前綴跳過,消費專案自己放在 scripts/hooks、
# scripts/templates 的程式會被當成工具的檔,推送閘的風險分級被降、逃過代碼審。
# 表要跟工具鏈 repo 裡那兩個目錄底下受版控的檔一模一樣:有一支測試逐檔比對,少登記或多登記都會翻紅。
_VENDORED_TREE_FILES = (
    "scripts/hooks/claude/_hookevent.py",
    "scripts/hooks/claude/check-graph-sync.py",
    "scripts/hooks/claude/ci-status-hook.py",
    "scripts/hooks/claude/memory-sweep.py",
    "scripts/hooks/claude/dispatch-lens-hook.py",
    "scripts/hooks/claude/impact-hook.py",
    "scripts/hooks/claude/lumos-entry-hook.py",
    "scripts/hooks/post-commit",
    "scripts/hooks/pre-commit",
    "scripts/hooks/pre-push",
    "scripts/templates/graph-discipline.md",
    "scripts/templates/note-audit-judge.md",
)
_VENDORED_ALL = frozenset(_VENDORED_TOOLKIT + _VENDORED_TREE_FILES)


_VENDORED_MANIFEST = ".lumos/vendored.json"   # 安裝/更新時記下每支工具檔的內容指紋


def _vendored_digest(data):
    """工具檔的內容指紋:換行統一成 LF 再算 sha256(Windows 的換行轉換不該讓指紋對不上)。"""
    import hashlib
    return hashlib.sha256(bytes(data).replace(b"\r\n", b"\n")).hexdigest()


def _vendored_manifest_write(root):
    """把工作目錄裡「工具自裝檔」的內容指紋寫進 .lumos/vendored.json(安裝與更新時呼叫;回寫進去的 {路徑: 指紋})。"""
    files = {}
    for rel in sorted(_VENDORED_ALL):
        p = Path(root) / rel
        if p.is_file():
            files[rel] = _vendored_digest(p.read_bytes())
    mp = Path(root) / _VENDORED_MANIFEST
    mp.parent.mkdir(parents=True, exist_ok=True)
    # 格式跟錨點基準線同一種({"version": 1, <路徑: sha256>…};第四輪架構席)。不走錨點那種「人核可才改」的流程:
    # 這份是安裝時的事實紀錄,錯了的方向是「多掃」不是「少擋」。ensure_ascii:從某版本讀回來走的是文字模式的 git show
    _write_lf(mp, json.dumps({"version": 1,
                              "note": "lumos 安裝時記下的工具檔內容指紋;內容對得上的才不算專案自己的程式",
                              "files": files}, ensure_ascii=True, indent=1) + "\n")
    return files


def _vendored_state(root, ref=None):
    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。

    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
    present, data = set(), {}
    if ref is None:
        for p in sorted(_VENDORED_ALL):
            fp = Path(root) / p
            if fp.is_file():
                present.add(p)
                try:
                    data[p] = fp.read_bytes()
                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
                    data[p] = None
        try:
            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            man = None
    else:
        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
        for p in sorted(_VENDORED_ALL):
            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
                present.add(p)
                data[p] = None
            elif r.returncode == 0:
                present.add(p)
                data[p] = r.stdout
        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
    files = man.get("files") if isinstance(man, dict) else None
    if not isinstance(files, dict):
        return frozenset(), frozenset(present)
    return (frozenset(p for p in present if data.get(p) is not None and files.get(p) == _vendored_digest(data[p])),
            frozenset(present))


def _diff_range_ends(root, diff_range):
    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
    import subprocess
    r = str(diff_range).strip()
    if "..." in r:
        a, b = r.split("...", 1)
        a, b = a or "HEAD", b or "HEAD"
        try:
            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
                                cwd=str(root), timeout=_disp_git_timeout())
            return (mb.stdout.strip() or a), b
        except (OSError, subprocess.TimeoutExpired):
            return a, b
    if ".." in r:
        a, b = r.split("..", 1)
        return (a or "HEAD"), (b or "HEAD")
    return r, None


def _is_toolchain_repo(root):
    """這個 repo 是不是工具鏈本體(那裡 scripts/lumos 就是產品,不能當成外來的跳過)。

    ★判別鍵沿用既有慣例★(見 `_self_repo_origin`):skills/lumos-project-notes/SKILL.md
    是 user-scope skill 的唯一源,永遠不會被複製進消費專案。"""
    try:
        return (Path(root) / "skills" / "lumos-project-notes" / "SKILL.md").is_file()
    except Exception:
        return False


def _vendored_skip(root, diff_range):
    """消費專案裡這段範圍要跳過的工具檔(工具鏈本體回空集合)。推送前分級與代碼審角色鏡頭共用這一支,見 _vendored_state:
    終點上原封不動的工具檔;終點上已經刪掉、但起點時原封不動的(拆除工具鏈)也跳。"""
    if _is_toolchain_repo(root):
        return frozenset()
    _start, _end = _diff_range_ends(root, diff_range)
    _intact_end, _present_end = _vendored_state(root, _end)
    _intact_start = _vendored_state(root, _start)[0] if _start else frozenset()
    return _intact_end | (_intact_start - _present_end)


def _pull_source_or_abort(src, allow_stale=False):
    """更新來源 clone;拉不到就中止。回傳 0=可繼續、None=中止(呼叫端不得再寫任何檔)。

    ★為什麼 fail-closed★:原本 pull 失敗只印一行警告就繼續 vendor,來源落後或有本機
    分歧時會靜默拿舊版蓋掉專案裡較新的檔——消費端實戰咬過兩次,那行警告混在一堆輸出裡
    根本看不到。「拿不到最新」與「確定這是最新」是兩種狀態,不該用同一條路走完。

    ★但無 remote 不算失敗★:手動複製 / slim 安裝出來的來源本就沒有 remote,那是合法的
    離線情境,擋它等於把離線使用者鎖在門外。只有「有 remote 卻拉不到」才中止。
    _vendor_toolchain(專案層) 與 cmd_bootstrap(機器層) 共用本函式,避免兩處政策漂移。
    """
    import subprocess
    if not (src / ".git").is_dir():
        print("  (來源非 git repo,跳過 pull)")
        return 0
    has_remote = subprocess.run(["git", "-C", str(src), "remote"],
                                capture_output=True, text=True, errors="replace").stdout.strip()
    if not has_remote:
        print("  (來源無 remote:離線 clone,跳過 pull)")
        return 0
    print("  git pull 來源(取最新工具組)…")
    if subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode == 0:
        return 0
    # ★來源「只髒了工具自己寫的帳」不該擋人★(2026-09-06 全 repo 審視 #5)
    # 症狀:唯讀的 `lumos show`/`context` 就會 append docs/.usage-log.jsonl,而那本帳是版控的。
    # 只要有人在來源 clone 裡查過一次圖譜,之後這台機器所有專案的 update / bootstrap --pull
    # 全部被 fail-closed 擋住;逃生門寫在錯誤訊息最後一行,沒人會讀到那裡。
        if ext in _STACK_GUESS_SKIP_EXTS:
            continue
        owners = sp_by_ext.get(ext) or []
        pick = partner.get(tp_by_ext.get(ext, ""), "")
        sp = pick if pick in owners else (owners[0] if owners else "")
        # ★猜得弱要講出來★(2026-09-09 代碼審 r2 f4):`.vue`/`.sql`/`.ps1` 只有 csharp 那份
        # 副檔名清單收了它們(那是「C# 店裡也會有的檔」的意思,不是「這是 C# 專案」)。
        # 反查因此會把一個以 Vue/SQL/PowerShell 為主的專案猜成 symbol_profile csharp——
        # 值合法、所有檢查都不唸,等於把 r1 修掉的「猜錯沒人知道」換成更隱蔽的版本。
        # weak=True 表示「這個 profile 不是為這個副檔名而生的,只是碰巧收了它」。
        weak = bool(sp) and sp != pick
        out[ext] = {"test": tp_by_ext.get(ext, ""), "symbol": sp,
                    "human": _STACK_HUMAN.get(ext, ext), "symbol_weak": weak}
    _STACK_GUESS_CACHE = out
    return out


_SKELETON_RUN_CMD = {
    # 骨架裡先給一個「形狀對」的指令當起點——★重點是形狀,不是它在你機器上跑得動★。
    # xcodebuild 那條刻意寫滿三段(target/類別/方法):少寫一段會讓過濾條件對不到任何測試,
    # 而那正是 2026-09-09 在第一個 iOS 專案上抓到的假綠來源。
    # ★也刻意不帶 -quiet★(2026-09-09 r1 折入,實測):-quiet 會把「Executed N tests」那行藏起來,
    # 而那行是這道閘唯一能證明「真的跑了東西」的證據——帶了 -quiet,跑 1 支跟跑 0 支的輸出一模一樣。
    "swift-xctest": "xcodebuild test -scheme <你的 scheme> -destination 'platform=iOS Simulator,name=<模擬器名>' -only-testing:<測試 target>/<測試類別>/{method}",
    "kotlin-junit": "./gradlew test --tests '*{method}'",
    # Java 專案分 Gradle 與 Maven 兩種建置,骨架先給 Gradle 形(跟 kotlin-junit 同一條,
    # 混編專案直接沿用);Maven 專案自己換成 `mvn -Dtest='<測試類別>#{method}' test`。
    # ★本機沒裝 gradle/mvn,這兩條指令沒有實跑核對過★,只保證形狀對(要能只跑一支測試)。
    "java-junit": "./gradlew test --tests '*{method}'",
    # ★尾巴那段 runsettings 不能省★(2026-09-09 r1 折入,dotnet 9.0.117 實測):
    # 沒有它,`dotnet test --filter` 對一個根本不存在的測試名照樣印「No test matches」然後回 0,
    # 閘拿退出碼當「測試跑過」就是假綠;加上去之後同一條指令回 1,對到真測試時仍回 0。
    "csharp-xunit": "dotnet test --filter FullyQualifiedName~{method} -- RunConfiguration.TreatNoTestsAsError=true",
    "python": "python3 -m pytest -k {method}",
    # jest 沒有對應的旗標(29.x 實測:-t 對不到任何測試仍回 0,--passWithNoTests=false 也一樣)——
    # 這條靠下面的「跑過的證據」比對摘要行,不靠退出碼。
    "node-jest": "npx jest -t {method}",
    "dart": "flutter test --plain-name {method}",
    "playwright": "npx playwright test -g {method}",
}

# 掃 repo 猜技術棧時一律略過的目錄(★兩支掃描共用同一份★——r1 單reviewer f4:
# 兩邊各有一份且內容不同時,init 猜出來的骨架跟健檢驗的東西會對不上,
# 「猜錯沒人知道」正好在自己身上重演一次)。
# ★只放「不是人寫的原始碼」的目錄★:相依套件、建置產物、工具自己的目錄。
# 合併時特意★把 scripts 從名單裡拿掉★:它原本只在健檢那份裡,而那是普通的原始碼目錄
# ——照舊略過的話,本 repo 自己的 Python 全在 scripts/ 底下,健檢就再也抓不到
# 「這個 repo 從沒設 symbol_profile、一直吃 C# 預設」那一條真的問題(實測會從 1 條變 0 條)。
# vault 用「目錄名結尾 -knowledge」認,不整個 docs/ 略過(專案可能在 docs/ 放範例程式)。
_STACK_SCAN_SKIP = {"node_modules", ".git", "build", "DerivedData", "dist", "vendor",
                    "Pods", ".venv", "venv", ".gradle", ".build", "target",
                    "governance", ".lumos"}


def _stack_scan_skip(name):
    return name in _STACK_SCAN_SKIP or name.endswith("-knowledge")


def _stack_ext_counts(root):
    """數 repo 裡各種程式碼副檔名各有幾個檔。回 {ext: n}。

    ★用 os.walk 就地剪枝,不是 rglob 之後再過濾★(r1 單reviewer f5,實測):
    rglob 會先把 node_modules 底下 2000 個檔全部走過一遍才被丟掉——略過名單對它想排除的
    正是最大的那幾個目錄完全沒省到。健檢每次都跑這段,大型專案會隨依賴目錄大小線性變慢。"""
    import os as _os
    counts = {}
    known = _stack_guess()
    # ★lumos 自己安裝進來的檔不算這個專案的技術棧★(2026-09-10,一個小 Vue 專案上實撞):
    # init 會把 CLI、自己的測試檔和五支 hook 複製到消費專案的 scripts/ 底下,那是八個 .py。
    # 那個專案自己只有六個 .js,於是健檢反過來唸「你有 8 個 .py,測試設定卻只認 .js」——
    # 舉的證據全是 lumos 自己的檔,而且專案愈小愈容易被唸,正好唸在剛接入的人臉上。
    # ★只跳過工具確實安裝的那幾支檔(精確檔名,見 _VENDORED_ALL)★,同目錄底下專案自己的檔照樣算
    # ——第一版照目錄前綴跳過,代碼審 r1 抓到專案自己的 hook 程式也被一起跳過。
    _base = _os.path.abspath(str(root))
    # 工具鏈本體那裡 scripts/lumos 就是產品,一支都不跳;消費專案只跳「內容跟安裝時一模一樣」的工具檔
    _skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root)[0]
    for dirpath, dirnames, filenames in _os.walk(_base):
        dirnames[:] = [d for d in dirnames if not _stack_scan_skip(d)]
        rd = _os.path.relpath(dirpath, _base)
        for fn in filenames:
            ext = _os.path.splitext(fn)[1].lower()
            if ext not in known:
                continue
            if _skip and _posix_norm(fn if rd == "." else _os.path.join(rd, fn)) in _skip:
                continue
            counts[ext] = counts.get(ext, 0) + 1
    return counts


def _profile_stack_mismatch(root):
    """設定的技術棧跟 repo 裡實際的程式碼對不對得上(消費專案接入靜默失效 [B]/S2)。

    ★只看實際副檔名,不看值是預設還是設定檔寫的★——寫成「跟預設不符」的話,
    init 產出的骨架一寫進去值就不是預設了,猜錯也永遠不會出聲(r1 外家備援席 f2)。
    回一串人話;對得上回空 list。"""
    if not root:
        return []   # vault 不在 git repo 底下(測試 fixture、--vault 指到別處):沒有 repo 可比,靜默跳過
    root = Path(root)
    counts = _stack_ext_counts(root)
    if not counts:
        return []
    test_msgs, sym_msgs = [], []
    try:
        pdata = load_platforms(root)
    except Exception:
        pdata = {"multiplatform": False, "platforms": {}}
    if pdata.get("multiplatform"):
        covered = set()
        for pe in pdata["platforms"].values():
            # ★"profile" 存的是攤開後的 profile 物件,不是名字★(2026-09-10 修):
            # 拿它去 TEST_PROFILES 查表 = 用 dict 當 key,直接丟 TypeError 把整支 doctor
            # 中斷在這一段。名字要用的話在隔壁的 "profile_name"。
            _pe_prof = pe.get("profile")
            if not isinstance(_pe_prof, dict):
                _pe_prof = TEST_PROFILES.get(_pe_prof) or {}
            covered |= set(_pe_prof.get("exts") or [])
    else:
        covered = set(load_test_profile(root).get("exts") or [])
    # 只唸「數量夠多、卻沒有任何平台的測試 profile 認得」的副檔名(散落幾個檔不算)。
    # ★門檻不只看絕對數量,也看它佔不佔份量★:本 repo 實測——它是 Python 專案,
    # 但安裝腳本有 4 個 .ps1,只用「≥3 個」的話會唸一句「你的測試設定掃不到這些 .ps1」,
        return True
    if _testmap_ext(path) in _TESTMAP_EXTS:
        return False                      # 測試地圖認得這種副檔名,它說不是就不是
    if _TESTMAP_DIR_RE is None:
        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
    if _TESTMAP_DIR_RE.search(path):
        return True
    name = path.rsplit("/", 1)[-1]
    stem = _testmap_stem(path)
    return (".spec." in name or ".test." in name or stem.startswith("test_")
            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)


def _nodehome_code_kind(path):
    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
    base = path.rsplit("/", 1)[-1]
    stripped = base.lstrip(".")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where, oids=None):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。
    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    for ent in raw.split(b"\0"):
        if not ent or b"\t" not in ent:
            continue
        meta, p = ent.split(b"\t", 1)
        parts = meta.split()
        if where == "index":
            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
                continue
            mode = parts[0]
        else:
            if len(parts) != 3:
                continue
            mode = parts[0]
        path = nfc(os.fsdecode(p))
        allp.append(path)
        if mode in (b"100644", b"100755"):
            files[path] = mode.decode()
            if oids is not None:
                oids[path] = (parts[1] if where == "index" else parts[2]).decode()
    return files, allp


        print(f"  {e}", file=sys.stderr)
    for it in left[:20]:
        print(f"  {it['path']}:{it['line']}  [{fold.get(it['id'], '沒判過')}]  {it['text'].strip()[:60]}", file=sys.stderr)
    if len(left) > 20:
        print(f"  …還有 {len(left) - 20} 行", file=sys.stderr)
    print(f"派判定者審:\n    lumos note-audit prepare --diff {diff_range} --orchestrator <claude|codex>", file=sys.stderr)
    if uncommitted:
        print(f"其中 {len(uncommitted)} 行在工作目錄的判定檔裡已經涵蓋、但還沒提交:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit",
              file=sys.stderr)
    if mode == "block":
        _gate_event_or_warn(root, "note-audit", "blocked", f"沒涵蓋 {len(left)} 行", hard=True,
                            nodes=sorted({it["path"] for it in left})[:50])
        return 1
    _gate_event_or_warn(root, "note-audit", "warned", f"沒涵蓋 {len(left)} 行(warn 模式不擋)")
    return 0


def cmd_note_audit_skip(repo=None, diff_range=None, note=None):
    """lumos note-audit skip --diff A..B --note "理由"(計劃〈做法〉第 3 節第 7 點):只略過從來沒被判過的行。"""
    root = _note_audit_root(repo)
    if root is None:
        return 2
    if not note or len(note.strip()) < 4:
        print("擋下:--note 要寫理由,至少 4 個字", file=sys.stderr)
        return 2
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    got = _note_audit_items(root, base, tip, vault_rel)
    if got is None:
        return 2
    items, _errs = got
    docs, _bad = _note_audit_load_verdicts(root, None)
    fold = _note_audit_fold(docs)
    judged = set(fold)
    todo = sorted({it["id"] for it in items if it["id"] not in judged})
    heavy = sorted({it["id"] for it in items if fold.get(it["id"]) in ("CODE", "MIXED")})
    if heavy:
        print(f"注意:{len(heavy)} 行已經判了推得出或一半一半,不能略過——要刪、改,或申訴", file=sys.stderr)
    if not todo:
        print("沒有可以略過的行")
        return 0
    name = _note_audit_write_verdict(root, {"version": 1, "kind": "略過", "note": note.strip(),
                                            "rows": [{"id": i, "class": "SKIP"} for i in todo]})
    _gate_event_or_warn(root, "note-audit", "skipped", f"{name}:略過 {len(todo)} 行:{note.strip()[:80]}")
    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
    return 0


