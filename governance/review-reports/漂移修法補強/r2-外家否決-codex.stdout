def _nfc_child(parent, name):
    """parent 目錄底下,名字 NFC 後等於 nfc(name) 的那一個實際項目 → Path 或 None。git 回的路徑、索引鍵都是 NFC,
    磁碟上可能是 NFD(Linux 不幫忙正規化);OSError 當成沒有。"""
    want = nfc(name)
    try:
        return next((q for q in Path(parent).iterdir() if nfc(q.name) == want), None)
    except OSError:
        return None


def _sh_quote(s):
    """印給人照貼的指令裡的一個參數加 shell 引號:路徑含空白或中文時照樣貼得上去。"""
    import shlex
    return shlex.quote(s)


def _phys_path(root, rel):
    """root 底下的相對路徑(NFC)→ 磁碟上的實際路徑:直接存在就用它,不然逐層找 NFC 相同的名字;
    找不到就回原路徑,讓呼叫端照常報「打不開」。"""
    p = Path(root) / rel
    if p.exists():
        return p
    cur = Path(root)
    for seg in Path(rel).parts:
        nxt = cur / seg
        if not nxt.exists():
            nxt = _nfc_child(cur, seg) or nxt
        cur = nxt
    return cur


def strip_quotes(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    return s


def _posix_norm(s):
    """路徑比對鍵的共用正規化:反斜線轉斜線、去 ./ 與 a/../b(純字面,不查檔案);空的回空字串。
    工具自裝檔判別、about_code 的比對、排序加分讀 about_code 共用這一個(2026-09-10 代碼審 r3 架構席/整合席:
    原本三處各寫一份,排序那側只剝開頭的 ./,不解 ..)。"""
    import posixpath
    v = str(s).strip().replace("\\", "/")
    return posixpath.normpath(v) if v else ""


# doctor 印給消費專案的三處 CI 步驟提示共用這一句(Projects/最低Python版本改3.14_計劃 做法第 7 點):
# GitHub 的 ubuntu 預設 python3 是 3.12,不裝 3.14 的話更新後 lumos 在 CI 回 2
_CI_PY314_NOTE = ("\n  (這一步要在 Python 3.14 上跑:actions/setup-python 的 python-version 設 \"3.14\";"
                  "lumos 的最低版本是 3.14,舊版會回 2 並說明)")
            and v[0] not in _YAML_PLAIN_BAD_START and ": " not in v and " #" not in v and not v.endswith(":")
            and v.lower() not in ("true", "false", "null", "yes", "no", "on", "off", "~")
            and not _YAML_TYPED_RE.fullmatch(v))


def _yaml_quote(v, what):
    """加引號,只用兩邊讀法一致的寫法:本工具讀的一側只剝掉頭尾一層引號、不解任何跳脫。
    雙引號在標準 YAML 裡會解反斜線跳脫 → 只在沒有反斜線、沒有雙引號時用;
    否則單引號(標準 YAML 裡除了 '' 以外一律照字面)→ 只在沒有單引號時用;兩種都不行就擋。"""
    if '"' not in v and "\\" not in v:
        return '"' + v + '"'
    if "'" not in v:
        return "'" + v + "'"
    raise ValueError(f"{what}「{v}」同時有單引號、又有雙引號或反斜線,工具寫不出本工具和 Obsidian 都讀得一樣的寫法,"
                     "檔案沒動;把其中一種引號換掉再寫")


def fmt_scalar(key, value):
    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
        return v  # bare,絕不加引號
    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)


def fmt_list_item(value):
    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
    v = value.strip()
    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")


def edit_fm_scalar(fm_lines, key, value):
    fm = list(fm_lines)
    formatted = fmt_scalar(key, value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "scalar":
            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
        fm[s] = f"{key}: {formatted}"
    else:
        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
        ins = len(fm)
        for k, s, e, kind in fm_structure(fm):
            if kind in ("list", "block"):
                ins = s
                break

