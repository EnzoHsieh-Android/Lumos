# ═══════════ decision_refs 自動養成 T3(dref-v4;六原語,乾淨雙欄)═══════════
# 設計:Projects/decision_refs自動養成_實作計畫.md ★v4 現行 spec★(dref-v4 三輪收斂)。
# 不對稱信任(T1 已建):E2 抑制只讀 decision_refs 正欄、E3 firing 讀聯集;此六原語不動 E2/E3 讀側。

_DREF_E2_FIELDS = ("verified_by", "plan_refs")   # E2 typed_in 實際抑制範圍(排 related,對齊 scripts:1236)


def _dref_parse(ref):
    """ref '<節點>#dN' → (節點字面, did) 或 None(格式不合)。"""
    m = re.fullmatch(r"(.+?)#(d\d+)", str(ref).strip())
    return (m.group(1), m.group(2)) if m else None


def _dref_norm(env, ref):
    """正規化 tuple (resolve(節點), did);節點解不到或格式不合→None。"""
    pr = _dref_parse(ref)
    if not pr:
        return None
    node = env.resolve(pr[0])
    return (node, pr[1]) if node else None


def _dref_same(env, a, b):
    """兩 ref 是否同一決策:正規化 tuple 相等。只吃「ref」(a/b 皆 <節點>#dN),故 did 恆有值
    ——無 id 決策不會變成 ref、由 _dref_coverage_scan 的 no_id_dead 分支另處理(不經此函式,
    s1-f3:此處 na[1]/nb[1] 恆真、是防禦性冗餘非活守衛)。"""
    na, nb = _dref_norm(env, a), _dref_norm(env, b)
    if not na or not nb:
        return False
    return na == nb


def _node_decisions(env, rel):
    """回某節點的 decisions list(parse_decisions on 記憶體 fm_lines,照 E2 慣例 scripts:1256;
    arch-f1:不用 load_raw_for_edit 重讀檔——那是寫入前置原語、拒 BOM/CRLF,會把 load_vault
    讀得動但格式稍偏的節點候選悄悄吞成空)。"""
    n = env.notes.get(rel)
    return parse_decisions(n.fm_lines) if n else []


def _dref_filled(env, rel):
    """已填集合=decision_refs ∪ decision_refs_ai 的正規化 tuple(略去解不到的)。"""
    n = env.notes.get(rel)
    if not n:
        return set()
    out = set()
    for fld in ("decision_refs", "decision_refs_ai"):
        for r in as_list(n.fields.get(fld)):
            nn = _dref_norm(env, r)
            if nn and nn[1]:
                out.add(nn)
    return out


def _dref_candidates(env, rel, tidx):
    """★共用候選產生函式★(backlog/candidates 同口徑,r1 ext-f2)。
    回 (cands, skipped_no_id):cands=[(target_rel, did, content, valid)],三具名邊 fwd 解到的
    節點的所有決策(含已翻案=E3 要抓),只列有 id;無 id 計數。正規化元素=(target_rel, did)。"""
    cands, skipped = [], 0
    fwd = tidx["fwd"].get(rel, {})
    seen = set()
    for etype in TYPED_EDGE_FIELDS:
        for trel in fwd.get(etype, []):
            for d in _node_decisions(env, trel):
                did = str(d.get("id", "")).strip()
                if not did:
                    skipped += 1
                    continue

    # 3. 組 block(START 行帶當前版本戳,機械插值——版本在 body 外,不影響 Check D 比對)
    start_line = _START_TEMPLATE.format(version=LUMOS_VERSION)
    block = start_line + "\n" + body + "\n" + _CLAUDE_END

    # 4. 讀目標檔(去 BOM + CRLF 正規化;★整檔都會被正規化,不只區塊★)
    cm = root / target
    if cm.exists():
        raw = cm.read_bytes()
        # 去 UTF-8 BOM
        if raw.startswith(b"\xef\xbb\xbf"):
            raw = raw[3:]
        claude_text = raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    else:
        claude_text = None

    # 5. 三態分派
    if claude_text is None:
        # 目標不存在 → created(檔頭依目標名;r2 整合 F11:曾寫死 "# CLAUDE.md")
        _write_lf(cm, f"# {target}\n\n" + block + "\n")
        return ReInjectResult("created", None)

    state, span = _extract_claude_block_span(claude_text)

    if state == "broken":
        return ReInjectResult("sentinel_broken", None)

    if state == "absent":
        # 有檔但無 sentinel → appended。CLAUDE.md 沿舊行為接檔尾;
        # AGENTS 檔插檔首(第一個 # 標題行之後;沒有標題行→檔案最前)——Codex 把整鏈 AGENTS 檔串起來
        # 只吃 32 KiB、超過靜默截斷,靠前一點少被砍(d1;r2 邊界 N5 定 fallback)。
        if target == "CLAUDE.md":
            new_text = claude_text.rstrip() + "\n\n" + block + "\n"
        else:
            lines = claude_text.split("\n")
            idx = next((i for i, l in enumerate(lines) if l.startswith("#")), None)
            if idx is None:
                new_text = block + "\n\n" + claude_text.lstrip("\n")
            else:
                new_text = "\n".join(lines[:idx + 1]) + "\n\n" + block + "\n\n" + "\n".join(lines[idx + 1:]).lstrip("\n")
            new_text = new_text.rstrip() + "\n"
        _write_lf(cm, new_text)
        return ReInjectResult("appended", None)

    # state == "found": splice body + 同步刷新 START 行(版本戳落在存量戶的唯一路徑——
    # 只換 body 會讓 updated 路徑永遠拿不到版本戳,標籤機制對存量安裝戶形同虛設。
    # START 行在管理區塊「內」,★INVARIANT★ 只保護 sentinel 之外,刷新它不違約)。
    old_body = span.body
    new_body = body
    si = claude_text.find(_CLAUDE_START_PREFIX)
    sl_begin = claude_text.rfind("\n", 0, si) + 1
    sl_end = claude_text.find("\n", si)
    old_start_line = claude_text[sl_begin:sl_end] if sl_end != -1 else claude_text[sl_begin:]

    if old_body == new_body and old_start_line == start_line:
        return ReInjectResult("unchanged", None)

    # 有差 → 先換 body(高位移),再換 START 行(低位移,原始位移仍有效);兩 splice 之間
    # 的原始空白行區逐字保留。
    new_text = claude_text[:span.body_start] + new_body + claude_text[span.body_end:]
    if sl_end != -1 and old_start_line != start_line:
        new_text = new_text[:sl_begin] + start_line + new_text[sl_end:]
    _write_lf(cm, new_text)

    diff = "".join(difflib.unified_diff(
        (old_start_line + "\n" + old_body).splitlines(keepends=True),
            L.append(f"  還有 {len(hr) - cap} 支沒列")
        L.append("  搬家要在同一個提交裡把它加進新家:")
        L.append("    lumos append <新家> about_code <檔>")
    routes = by.get("route", [])
    if routes:
        L.append("")
        L.append(f"■ 這次寫了說明的節點,不是任何一支改動檔的家({len(routes)} 篇):")
        for rel, files in routes[:cap]:
