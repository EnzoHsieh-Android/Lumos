def _idiom_skill_for(ext, file_rel, repo_root):
    """副檔名 → 慣例 skill 名(沒有就 None)。.ts/.js 家族要看 package.json:後端 → node-idioms、
    前端或找不到 package.json → 沿用 vue-idioms(2026-09-08 前的行為)。"""
    if ext in _NODE_EXTS:
        return "node-idioms" if _node_flavor(file_rel, repo_root) == "node" else _ARCH_IDIOM_SKILL.get(ext, "vue-idioms")
    return _ARCH_IDIOM_SKILL.get(ext)
