def _guard_find(env, ref):
    rel = env.find(ref)
    if rel is None:
        return None, None
    n = env.notes.get(rel)
    if n is None or not n.fields.get(GUARD_MARK_FIELD):
        return None, None
    return rel, n


def _guard_planned_line(env, home_rel, claim):
    """在功能節點裡找那一行預告標記,回 (lines, idx, e, err)。

    ★比照既有引擎的兩道防呆★(代碼審 r1 blocker):`cmd_guard_bind`/`cmd_guard_audit` 對
    「在功能節點裡找某條 KEY 行」都會 ①命中多條就擋,不猜是哪一條 ②找不到就擋。
    第一版用「合約前 12 字」當子字串比對,同一篇預告兩條而前 12 字相同時會改到別條、互相覆蓋。
    這裡改成比對「剝掉 [watch:]/[due:] 之後的完整文字」,並保留多條就擋。"""
    path = env.vault / home_rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        return None, None, None, f"{home_rel} 打不開:{ex}"
    want = (claim or "").strip()
    idxs = _guard_planned_idx(lines, e, claim)
    if len(idxs) > 1:
        return None, None, None, (f"{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條"
                                  "——先手動把重複的那行處理掉")
    if not idxs:
        return None, None, None, f"{home_rel} 裡找不到預告行『{want[:30]}』(被手改過或已經轉正?)"
    return lines, idxs[0], e, None


def _guard_home_of(n):
    return _guard_home_of_fields(n.fields)


def _guard_home_of_fields(fields):
    g = fields.get(GUARD_MARK_FIELD)
    if isinstance(g, list) and g:
        return str(g[0]).strip()
    return str(g or "").strip()


# ★預告句型只有這一份★(存量漂移防線_計劃〈做法〉第 1 節):guard plan 樣板(_guard_plan_write_node)寫出的
# 四種預告句,settle 轉正時改寫、狀態一致檢查 c1 找殘留,兩邊用同一支比對——各寫一份的話,settle 改完的
# 句子可能又被 c1 認成預告,轉正後的推送被自己擋(設計審 r3 正確性席)。從行首比對(去掉摘要縮排);
# 第四句照樣板的實際字元,含反引號(r3 邊界席:照設計稿漏掉反引號會永遠對不上)。
_GUARD_WHY_MID = "]預告這條合約但還沒做:"
_GUARD_SETTLED_TAIL_RE = re.compile(r"已轉正\)\s*$")
_GUARD_PROSE_KINDS = ("test", "why", "whynot", "settle")


def _guard_planned_prose(line, region, settled_ok=False):
    """這一行是不是 guard plan 寫的預告句 → 'test'|'why'|'whynot'|'settle' 或 None。
    region 是 _notelines_regions 給的那一行所在區。WHY 行尾已經有「已轉正」不算預告
    (settled_ok=True 時回 'why-done',給 settle 分辨「已經改過」與「找不到」)。"""
    s = line.strip()
    if region == "summary":
        if s.startswith("TEST:還沒有測試在守這條"):
            return "test"
        if s.startswith("WHY:[") and _GUARD_WHY_MID in s:
            if _GUARD_SETTLED_TAIL_RE.search(s):
                return "why-done" if settled_ok else None
            return "why"
    elif region == "body":
        if s.startswith("為什麼還不做:"):
            return "whynot"
        if s.startswith("做完之後跑 `lumos guard settle` 轉正"):
            return "settle"
    return None


def _guard_formal_line(lines, e, claim, method=None, plat=None):
    """家筆記的摘要裡有沒有這條合約的正式行 → 行索引或 None:剝掉合約標記家族(INV_TAG_RE:test/audit/kill/src/git/manual/keeps)
    之後文字相同,而且綁的測試(invariant_test_refs,逗號清單拆開比完整名)含這支方法(method=None 時有綁任一支就算)。
    ★比對全用 guard 家族既有那兩支★(代碼審 r3 架構對齊席、正確性席:前兩輪自己寫行尾正規式,連續兩輪被抓到——
    剝全部 [鍵:值] 會把原文自帶的標籤剝掉、只認 test/audit/kill 又漏了 src/git,[test:a,b] 用子字串比也對不上);
    只看摘要(代碼審 r1 外家席:其他開頭欄位裡的同一句會被誤認成正式行)。"""
    want = INV_TAG_RE.sub("", claim).strip()
    regs = _notelines_regions("\n".join(lines))
    for i in range(1, e):
        if i < len(regs) and regs[i] != "summary":
            continue
        m = INVARIANT_RE.match(lines[i].strip())
        if not m or INV_TAG_RE.sub("", m.group(1)).strip() != want:
            continue
        refs = invariant_test_refs(m.group(1))
        if method is None:
            if refs:
                return i
            continue
        # 帶平台前綴的綁定照 resolve_test_refs 解(plat=(split, default),load_platforms 那一套):前綴是專案定義過的平台
        # 才拆,沒定義就不猜(代碼審 r4 架構對齊席);沒給 plat 時只認完全相同的名字(代碼審 r5 正確性席:多平台專案
        # 綁成 [test:ios:t_x] 時,只比完全相同會擋下又指到一條走不出去的路)
        names = set(refs)
        if plat is not None:
            try:
                names = {mm for _pl, mm in resolve_test_refs(m.group(1), plat[0], plat[1])}
            except ValueError:
                names = set()
        if method in names:
            return i
    return None


def _guard_planned_idx(lines, e, claim):
    """家筆記裡「剝掉 [watch:]/[due:] 之後完整文字等於這句合約」的預告行索引清單(0 條、1 條、好幾條由呼叫端判)。"""
    want = (claim or "").strip()
    out = []
    for i in range(1, e):
        m = PLANNED_RE.match(lines[i].strip())
        if m and _PLANNED_TAIL_RE.sub("", m.group(1)).strip() == want:
            out.append(i)
    return out


# 人手補的「已轉正」段(正文):settle 句下一個非空行長這樣,改句時刪掉 settle 句本身、不再疊一行(存量漂移改法 第 2 節)
_GUARD_MANUAL_SETTLED_RE = re.compile(r"^\(?(\d{4}-\d{2}-\d{2})\)? ?已轉正")
_GUARD_WHY_SETTLED_DATE_RE = re.compile(r"\((\d{4}-\d{2}-\d{2}) 已轉正\)\s*$")


def _guard_manual_settled_after(lines, i):
    """第 i 行之後(跳過空行)的下一個非空行是不是人手補的「已轉正」段。"""
    for ln in lines[i + 1:]:
        if ln.strip():
            return bool(_GUARD_MANUAL_SETTLED_RE.match(ln.strip()))
    return False


def _guard_prose_ops(lines):
    """守衛紀錄裡的預告句 → [(行索引, 種類)]。種類:test/why/why-done/whynot/settle,
    settle 句下一個非空行已是手補的「已轉正」段時記 settle-del(刪掉 settle 句那一行)。"""
    regs = _notelines_regions("\n".join(lines))
    ops = []
    for i, ln in enumerate(lines):
        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
        if k == "settle" and _guard_manual_settled_after(lines, i):
            k = "settle-del"
        if k is not None:
            ops.append((i, k))
    return ops


def _guard_prose_needs_date(ops):
    """改句要不要寫日期:TEST、WHY 兩句與換成「(日期 已轉正)」的 settle 句要;只改「為什麼還不做:」或刪 settle 句不要。"""
            continue
        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上
        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。
        same = sorted(x for x in tset if x.lower() == f.lower())
        if same:
            hits.append(f"{raw}(大小寫不同:{same[0]})")
            only_case.append(raw)
    return hits, only_case


def _guard_touches(gn, env, touched):
    """這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。

    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):
    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。
    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。
    """
    if touched is None:
        return True, ""            # 沒給清單=CI 那一層,照舊全擋
    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點
    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。
    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]
    if not homes:
        return False, ";這篇沒寫它守的是哪篇功能節點,算不出有沒有碰到"
    files, found, missing, nocode = [], [], [], []
    for home in homes:
        hrel = env.find(home)
        hn = env.notes.get(hrel) if hrel else None
        if hn is None:
            missing.append(home)
            continue
        found.append(hrel)
        got = [str(x).strip() for x in as_list(hn.fields.get("about_code")) if str(x).strip()]
        if got:
            files += got
        else:
            nocode.append(hrel)
    # ★連結斷掉的那幾篇,不管這次擋不擋都要講★(代碼審 r2 通才席):
    # 半條算得出來、半條算不出來時,算不出來的那半原本會無聲消失,那條合約就一直帶著沒人發現的壞連結。
    broken = f"(另外 {'、'.join(missing)} 這幾篇找不到,連結可能斷了)" if missing else ""
    if not files:
        if missing and not found:
            return False, f";找不到它守的功能節點 {'、'.join(missing)},算不出有沒有碰到"
        return False, f";{'、'.join(nocode)} 沒寫它管哪幾支檔(about_code),算不出有沒有碰到{broken}"
    hits, only_case = _guard_touched_hits(files, touched)
    if hits:
        # ★只列解析得到的那幾篇★(代碼審 r2 通才席):這句話存在的目的是讓被擋的人知道去哪篇查,
        # 把找不到的節點也列進來,照著查的人會撲空。
        # ★收窄的粒度是「整篇家節點」不是「每條合約」★(代碼審 r1):同一篇掛兩條逾期合約時兩條都會擋。
        # 做得更細要讓每條合約自己記檔案清單(另一套資料);現在的代價是偶爾多擋一條,方向安全,
        # 但要讓人看得出來為什麼,不要變成無法解釋的誤擋。
        why = f";你這次改到 {'、'.join(hits[:3])}(它掛在 {'、'.join(found[:2])} 底下){broken}"
        if only_case and len(only_case) == len(hits):
            why += "——只有忽略大小寫才對得上,寧可多擋一次也不漏"
        return True, why
    return False, ("" if not broken else f";這次沒碰到它管的檔{broken}")


def cmd_guard_settle(env, ref, method=None, date=None):
    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過,四種預告句改成歷史說法。

    ★整段拿寫入鎖、守衛紀錄一次寫入、做到一半可以補完★(存量漂移防線_計劃 [S4][S5][S19]):
    原本第一步在鎖外、第二步才經 cmd_set 拿鎖,中間斷掉會留下「家筆記是正式行、守衛紀錄還是 pending」,
    舊版再跑 settle 找不到預告行就擋,guard-kill 記過這種卡死。

    ★已經 pass 但還留著預告句★(存量漂移改法 第 3 節):補改句(前提、日期、不疊跟 drift fix --kind c1 同一支);
    前提不符回 2(以前一律回 0)。--test 只有 pending 要;--date 只給 pass 補改句用。"""
    rel, _n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    try:
        glines, _s, ge = load_raw_for_edit(env.vault / rel)
    except (ValueError, RuntimeError, OSError) as ex:
        print(f"擋下:{rel} 打不開:{ex}", file=sys.stderr)
        return 2
    if str(parse_frontmatter(glines[1:ge])[0].get("status")) == "pass":
        return _guard_settle_pass(env, rel, glines, date)
    if date is not None:
        print("擋下:--date 只給已轉正(pass)的守衛紀錄補改預告句用;待完成的轉正日期就是今天", file=sys.stderr)
        return 2
    if method is None:
        print("擋下:待完成的守衛紀錄轉正要給 --test <測試方法名>(守這條合約的那支測試)", file=sys.stderr)
        return 2
    if not IDENT_RE.match(method or ""):
        print(f"擋下:測試方法名『{method}』不合法(只能字母/數字/底線,不能數字開頭)", file=sys.stderr)
        return 2
    with _vault_write_lock(env.vault):
        return _guard_settle_locked(env, ref, method)


def _guard_settle_pass(env, rel, glines, date):
    """已 pass 的守衛紀錄:還有預告句就補改(鎖外讀狀態、推日期、查前提;拿鎖後比對那一篇沒變才寫),沒有就照舊回 0。"""
    ops = [k for _i, k in _guard_prose_ops(glines) if k != "why-done"]
    if not ops:
        print(f"已轉正,不用再做:{rel} 已經是 pass")
        return 0
    root = _vault_repo_root(env)
    gpath = env.vault / rel
    before = "\n".join(glines).encode("utf-8")      # load_raw_for_edit 讀到的原樣內容(已拒 BOM、CRLF)
    try:
        repo_rel = gpath.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        repo_rel = rel
    new, missing, day, err = _guard_pass_rewrite(env, root, repo_rel, glines, date)
    if err:
        print(f"擋下:{rel} 已是 pass、還留著預告句,但補改不了:{err}", file=sys.stderr)
        return 2
    with _vault_write_lock(env.vault):
        try:
