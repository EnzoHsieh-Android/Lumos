def _drift_ledger_append(root, rel, rec):
    """表態檔與修復帳共用的追加(存量漂移改法 第 7 節):①路徑檢查 ②檔尾不是換行先補一個 ③交給 _jsonl_append_verified
    追加並讀回自驗。不改其他帳共用的 _jsonl_append_verified。回 rc。"""
    fp = Path(root) / rel
    err = _drift_ledger_path_err(root, rel)
    if err is None:
        try:
            fp.parent.mkdir(parents=True, exist_ok=True)
        except OSError as ex:
            err = f"建不了 {fp.parent}:{ex}"
    err = err or _drift_ledger_path_err(root, rel)
    if err is None:
        try:
            if fp.is_file() and fp.stat().st_size > 0:
                with open(fp, "rb") as fh:
                    fh.seek(-1, 2)
                    tail = fh.read(1)
                if tail != b"\n":
                    with open(fp, "a", encoding="utf-8") as fh:
                        fh.write("\n")
        except OSError as ex:
            err = f"補不了檔尾換行:{ex}"
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    return _jsonl_append_verified(fp, rec, "id", rec["id"])


# ── 改法:drift fix(Projects/存量漂移改法_計劃)──────────────────────────────────────

_DRIFT_PLACEHOLDER_RE = re.compile(r"<(?:為什麼[^<>\n]{0,30}|sha|卷證)>")


def _drift_placeholder_err(text, what):
    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
    Issue 標成結案、理由是佔位字)。只認 _drift_fix_hint 與 c4 證據頁真的印過、而且會被貼進 --reason/--new 的那幾種
    (為什麼…、sha、卷證);`Map<K,V>`、`<src/lib>` 這種真理由照收(代碼審 r2 正確性席、r3 邊界席)。"""
    m = _DRIFT_PLACEHOLDER_RE.search(text or "")
    return f"{what} 裡還留著提示的佔位字「{m.group(0)}」——換成真的內容再跑" if m else None


def _drift_sh(v, node=False):
    """印給人照貼的指令裡的一個參數:只由文字、數字(含中日韓文字)、底線與 ./@%+=:,- 組成就原樣,其他一律 shlex.quote
    (代碼審 r1 資安席:檔名帶 $(…)、; 或反引號的筆記,照貼提示就會執行攻擊者的指令;正確性席:帶空白會被切成兩個參數)。
    不直接全部 _sh_quote:它把中文也當危險字元,圖譜裡幾乎每條提示都會被包上引號;其他字元一律交給 _sh_quote。
    node=True(drift fix 的節點參數):以 - 開頭會被當成選項,加引號也沒用(shell 會拿掉引號),補成 ./ 開頭——
    _drift_fix_target 認得這個寫法(代碼審 r2 資安席)。"""
    v = str(v)
    if node and v.startswith("-"):
        v = "./" + v
    return v if v and re.fullmatch(r"[\w./@%+=:,-]+", v) else _sh_quote(v)


def _drift_fix_hint(kind, path, line):
    """一筆發現該印的改法指令 → [指令]。★提示的單一產生處★(存量漂移改法 [S10]):drift check 擋下與只列出、drift scan、
    doctor Z 段、計劃收尾的連帶待辦都從這裡拿,不再各自教人手改。"""
    node = _drift_sh(path[:-3] if path.endswith(".md") else path, node=True)
    base = f"lumos drift fix {node} {line} --kind {kind}"
    if kind == "c2":
        return [base + ' --close --status done --reason "<為什麼算解決,附提交或測試>"',
                base + ' --keep --reason "<為什麼還沒解決>"']
    if kind == "c3":
        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + ">"]
    if kind == "c4":
        return [base + "   # 列證據、範本與預填好的 lumos set 整欄指令(c4 不自己寫檔)"]
    if kind == "probe":
        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
    return [base]


def _drift_print_hints(rows, stream, head="改法:"):
    """一批發現的改法指令;c1 一篇一條(改一次整篇的預告句都改掉)。"""
    seen, out = set(), []
    for f in rows:
        k = (f["kind"], f["path"]) if f["kind"] == "c1" else (f["kind"], f["path"], f["line"])
        if k in seen:
            continue
        seen.add(k)
        out += _drift_fix_hint(f["kind"], f["path"], f["line"])
    if out:
        print(head, file=stream)
        for x in out[:20]:
            print(f"    {_esc_clean(x, 300)}", file=stream)
        if len(out) > 20:
            print(f"    …還有 {len(out) - 20} 條(lumos drift scan 看全部)", file=stream)


_DRIFT_C3_STATUSES = frozenset(_STATUS_ENUM["verification"] - {"pending"})
_DRIFT_FIX_OPTS = ("date", "close", "keep", "status", "reason", "by")
_DRIFT_FIX_ALLOWED = {"c1": {"date"}, "c2": {"close", "keep", "status", "reason"}, "c3": {"status", "by"},
                      "c4": set(), "c5": set()}


def _drift_one_line(t):
    """沒有任何分行字元:不只 \\n \\r,還有 str.splitlines() 會切開的 U+2028、U+0085、換頁字元——寫進筆記或帳檔後,
    用 splitlines 讀的人會看成兩行(代碼審 r1 邊界、資安席)。"""
    return len(("x" + t + "x").splitlines()) == 1


def _drift_fix_reason_ok(r):
    return isinstance(r, str) and _drift_one_line(r) and 4 <= len(r.strip()) <= 200


def _drift_fix_c2_args(o):
    if bool(o.get("close")) == bool(o.get("keep")):
        return ('--kind c2 要二擇一:--close --status <結案值> --reason "…"(Issue 解決了)'
                '或 --keep --reason "…"(還沒解決,照留)')
    if o.get("reason") is None:
        return "--kind c2 要帶 --reason(一行、4 到 200 字)"
    if _drift_placeholder_err(o["reason"], "--reason"):
        return _drift_placeholder_err(o["reason"], "--reason")
    if o.get("keep"):
        return "--keep 不收 --status" if o.get("status") is not None else None
    if o.get("status") not in _ISSUE_CLOSED_STATUSES:
        return f"--close 的 --status 只能是 Issue 的結案值:{'/'.join(sorted(_ISSUE_CLOSED_STATUSES))}"
    return None


def _drift_fix_c3_args(o):
    if o.get("status") not in _DRIFT_C3_STATUSES:
        return f"--kind c3 要帶 --status,值只能是 {'/'.join(sorted(_DRIFT_C3_STATUSES))}(驗證紀錄的合法狀態扣掉 pending)"
    return None


_DRIFT_FIX_KIND_ARGS = {"c1": lambda o: None, "c2": _drift_fix_c2_args, "c3": _drift_fix_c3_args,
                        "c4": lambda o: None, "c5": lambda o: None}


def _drift_fix_args_err(kind, o):
    """--kind 與參數的組合合不合 → 錯誤或 None(存量漂移改法 第 1 節的組合表)。"""
    if kind == "probe":
        return ("--kind probe 沒有工具改法:條件成立了就把待辦做掉,再刪掉那一行或改寫成歷史說法;"
                "照留就 lumos drift ack <節點> <行號> --kind probe --reason \"<為什麼照留>\"")
    if kind not in _DRIFT_FIX_KINDS:
        return f"--kind 只能是 {'/'.join(_DRIFT_FIX_KINDS)}"
    extra = {k for k in _DRIFT_FIX_OPTS if o.get(k) not in (None, False)} - _DRIFT_FIX_ALLOWED[kind]
    if extra:
        return f"--kind {kind} 不收 " + "、".join("--" + x for x in sorted(extra))
    if o.get("date") is not None:
        _d, err = _guard_date_arg(o["date"])
        if err:
            return err
    if o.get("reason") is not None and not _drift_fix_reason_ok(o["reason"]):
        return "--reason 要一行、4 到 200 字"
    return _DRIFT_FIX_KIND_ARGS[kind](o)


def _drift_fix_target(env, node):
    """節點 → (筆記路徑, 錯誤)。同名好幾篇不猜(fix 會改檔,不能靠 env.find 取第一篇)。"""
    a = nfc(str(node).strip())
    explicit = a.startswith("./")                      # 提示對 - 開頭的節點印成 ./-x(_drift_sh);./ 開頭就是明確路徑
    a = a[2:] if explicit else a
    a = a[:-3] if a.lower().endswith(".md") else a
    if explicit or "/" in a:        # 給了路徑就只認那一篇,不退回用檔名猜(代碼審 r3 正確性席:./-x 原本被剝掉後改用檔名猜)
        return (a + ".md", None) if (a + ".md") in env.notes else (None, f"找不到筆記 {node}")
    hits = env.by_stem.get(a.lower(), [])
    if len(hits) > 1:
        return None, f"同名筆記有 {len(hits)} 篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"
    if not hits:
        return None, f"找不到筆記 {node}"
    return hits[0], None


def _drift_fix_last_sha(root, repo_rel):
    """修復帳裡這一篇最後一筆(seq 最大)的 after_sha256;沒有回 None。"""
    rows = [d for d in _drift_jsonl_rows(Path(root) / _DRIFT_FIXES) if nfc(str(d.get("path", ""))) == nfc(repo_rel)]
    if not rows:
        return None
    return _drift_bound_latest(rows)[-1].get("after_sha256")


def _drift_fix_clean_err(root, repo_rel, raw):
    """乾淨檢查 → 錯誤或 None:那一篇要在 git 裡有追蹤,而且跟 HEAD 沒差,或現在的指紋等於修復帳裡這一篇最後一筆的
    after_sha256(改動全是工具自己留下的,同一篇可以一項一項修、修完一起提交)。"""
    import hashlib
    ps = _git_paths_nfc(root, repo_rel)
    if not ps:
        return f"{repo_rel} 沒被 git 追蹤(或 git 查不到)——不在版控裡,改壞了退不回來;先提交"
    if len(ps) > 1:
        return f"{repo_rel} 這個名字在 git 裡有 {len(ps)} 種 Unicode 拼法的檔並存,工具分不出要改哪一篇;先手動整理成一篇"
    gp = ps[0]
    r = _lens_git(root, "--literal-pathspecs", "diff", "--no-ext-diff", "--no-textconv", "--quiet", "HEAD", "--", gp)   # 檔名裡的 * 不當萬用字元(r4 邊界、外家)
    if r is None or r.returncode not in (0, 1):
        return "git 查詢失敗或逾時(git diff HEAD),查不出這一篇乾不乾淨"
    if r.returncode == 0 or _drift_fix_last_sha(root, repo_rel) == hashlib.sha256(raw).hexdigest():
        return None
    return f"{repo_rel} 有未提交的改動(不是 drift fix 自己留下的)——先提交或還原再修"


def _drift_fix_load(env, rel, line, kind, o):
    """第 1、2 步:乾淨檢查(--dry-run 不做)、讀那一篇(BOM、CRLF 拒絕)、鎖外新建圖譜物件確認那一行現在是這一種發現。"""
    root, vault_rel = _drift_vault_of(env)
    path = _phys_path(env.vault, rel)
    try:
        if path.is_symlink() or path.stat().st_nlink != 1:
            return None, (f"{rel} 是符號連結或還有別的硬連結——工具用換檔的方式寫入,會把連結換成一般檔、或讓兩邊內容分岔"
                          "(代碼審 r1 邊界席);手動改")
        lines, _s, fe = load_raw_for_edit(path)
    except (ValueError, OSError, UnicodeDecodeError) as ex:
        return None, f"{rel} 打不開:{ex}"
    cx = {"root": root, "rel": rel, "repo_rel": f"{vault_rel}/{rel}", "path": path, "lines": lines, "fe": fe,
          "raw": "\n".join(lines).encode("utf-8"), "kind": kind, "line": line, "o": o}
    if not o.get("dry_run") and kind != "c4":    # 只看、不寫的兩條路不做乾淨檢查(c4 只列證據)
        err = _drift_fix_clean_err(root, cx["repo_rel"], cx["raw"])
        if err:
            return None, err
    cx["env2"] = Env(env.vault)
    cx["f"], err = _drift_current_finding(cx["env2"], rel, line, kind)
    return (None, err) if err else (cx, None)


def _drift_fm_status(lines, fe, status):
    """開頭欄位的 status 改掉、同步 status/* 標籤(同 cmd_set)→ (新的開頭欄位行, 寫後自驗)。"""
    fm = edit_fm_scalar(lines[1:fe], "status", status)
    fm, synced = edit_fm_sync_status_tag(fm, status)
    want = strip_quotes(fmt_scalar("status", status))

    def _ok(f):
        if str(f.get("status", "")) != want:
            return False
        tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
        return (not synced) or (f"status/{want}" in tags and all(t == f"status/{want}" for t in tags if t.startswith("status/")))
    return fm, _ok


def _drift_deps(cx, rels):
    """判定依賴的其他筆記(c1、c5 的家節點)此刻的位元組 → [(路徑, 位元組)];寫入時在鎖內再比一次,判定之後被改過就不寫
    (代碼審 r1 併發席:鎖內原本只比守衛紀錄那一篇)。建圖譜物件到這裡的時間差不處理(〈誠實界線〉)。"""
    out = []
    for r in rels:
        if not r:
            continue
        p = _phys_path(cx["env2"].vault, r)
        try:
            out.append((p, p.read_bytes()))
        except OSError:
            out.append((p, None))
    return out


def _drift_no_kind(*kinds):
    return lambda fs, _txt: not any(x["kind"] in kinds for x in fs)


def _drift_fix_c1(cx):
    """c1:已 pass 的守衛紀錄補改預告句(改句、前提、日期都在 guard 區段,這裡往下呼叫)。"""
    new, missing, day, err = _guard_pass_rewrite(cx["env2"], cx["root"], cx["repo_rel"], cx["lines"], cx["o"].get("date"))
    if err:
        return None, err
    names = "、".join(_GUARD_PROSE_NAMES[k] for k in missing)
    return {"new": new, "key": "status", "check": lambda f: str(f.get("status", "")) == "pass",
            "handled": _drift_no_kind("c1"), "extra": {}, "texts": [],
            "deps": _drift_deps(cx, [_guard_pass_home(cx["env2"], cx["lines"])[0]]),
            "msg": "預告句改成歷史說法" + (f"(轉正日期 {day})" if day else "") + (f";找不到{names},沒改" if names else "")}, None


_DRIFT_BANNER_RE = re.compile(r"^[>\s#*✅★]*已結案[*★\s]*[(（:：]")


def _drift_close_banner(body, banner):
    """正文第一個 `# ` 標題之後、第一段之前加結案橫幅 → (新的正文行, 原本就有橫幅)。
    標題只在圍欄外找(圍欄裡的 `# comment` 不算,代碼審 r1 邊界席);已有橫幅只認「已結案」後面接括號或冒號的形狀,
    「已結案通知功能仍會重複寄信」這種正文不算(外家席);前面可以有 >、#、**、✅、★(本專案 Issue 的真實寫法,代碼審 r2 正確性席)。"""
    vis = {n - 1 for n, _ln in _visible_lines(body)}
    h = next((i for i, ln in enumerate(body) if i in vis and ln.startswith("# ")), None)
    start = 0 if h is None else h + 1
    j = start
    while j < len(body) and not body[j].strip():
        j += 1
    if j < len(body) and _DRIFT_BANNER_RE.match(body[j]):
        return body, True
    if h is None:
        return [banner, "", *body], False
    if j > start:
        return [*body[:j], banner, "", *body[j:]], False
    return [*body[:start], "", banner, "", *body[start:]], False


def _drift_fix_c2(cx):
    """c2 --close:status 改成 Issue 的結案值、正文標題之後加結案橫幅(專案的 Issue 寫法:第一段就寫已結案)。"""
    import datetime
    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
    fm, ok = _drift_fm_status(lines, fe, o["status"])
    banner = (f"> 已結案({datetime.date.today().isoformat()},{o['status']}):{o['reason'].strip().rstrip('。')}。"
              "以下是當時的排查紀錄,不是現況。")
    body, had = _drift_close_banner(lines[fe + 1:], banner)
    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c2"),
            "extra": {}, "texts": [] if had else [(banner, "body")],
            "msg": f"status 改成 {o['status']}" + (";第一段已經是已結案橫幅,沒再加" if had else ",正文加了結案橫幅")}, None


def _drift_fix_by(env, by):
    """--by → (完整相對路徑去 .md, 錯誤)。完整路徑直接查那一篇;短名看 by_stem,找不到或同名好幾篇擋。"""
    a = nfc(str(by).strip())
    a = a[:-3] if a.lower().endswith(".md") else a
    if "/" in a:
        return (a, None) if (a + ".md") in env.notes else (None, f"--by 找不到 {by}")
    hits = env.by_stem.get(a.lower(), [])
    if len(hits) == 1:
        return hits[0][:-3], None
    if not hits:
        return None, f"--by 找不到 {by}"
    return None, f"--by {by} 同名好幾篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"


def _drift_append_note(body, txt):
    """正文最後一個非空行之後、隔一個空行加一行,檔尾一個換行;正文為空就放在開頭欄位結束那行之後。
    正文最後落在沒閉合的程式碼圍欄裡擋下(用 _visible_lines 判:加一行試探,看得見才算在圍欄外)。"""
    probe = [*body, "lumos-drift-probe"]
    if len(probe) not in {no for no, _ln in _visible_lines(probe)}:
        return None, "正文最後停在沒閉合的程式碼圍欄裡,不知道要加在哪——先把圍欄關好"
    last = max((i for i, ln in enumerate(body) if ln.strip()), default=None)
    if last is None:
        return [txt, ""], None
    return [*body[:last + 1], "", txt, ""], None


def _drift_fix_c3(cx):
    """c3:驗證紀錄的 status 改掉、正文最後加一行依狀態措辭的說明;原本的正文不改。"""
    import datetime
    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
    link = None
    if o.get("by"):
        link, err = _drift_fix_by(cx["env2"], o["by"])
        if err:
            return None, err
    st = o["status"]
    txt = f"{datetime.date.today().isoformat()} 狀態改為 {st}(存量漂移 c3)"
    if link:
        txt += f",由 [[{link}]] 解決" if st == "pass" else f",參考 [[{link}]]"
    body, err = _drift_append_note(lines[fe + 1:], txt)
    if err:
        return None, err
    fm, ok = _drift_fm_status(lines, fe, st)
    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c3"),
            "extra": {}, "texts": [(txt, "body")], "msg": f"status 改成 {st},正文最後加了一行說明"}, None


def _drift_c4_key(s):
    """卷證目錄比對用的名字:去 _計劃、NFC、不分大小寫、. 與空白轉連字號。"""
    s = nfc(str(s))
    s = s[:-3] if s.endswith("_計劃") else s
    return re.sub(r"[.\s]+", "-", s).lower()


def _drift_c4_evidence(cx):
    """c4 的證據與範本:那篇第一次被提交的提交、卷證目錄(名字比對猜的)、範本句。"""
    root = cx["root"]
    sha = None if _git_is_shallow(root) else _plan_first_commit(root, cx["repo_rel"], timeout=20)
    first = "shallow,查不到最早提交" if _git_is_shallow(root) else (sha or "查不到")
    n = cx["env2"].notes.get(cx["rel"])
    keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
            if link_target(x)}
    rr = Path(root) / "governance" / "review-reports"
    try:
        dirs = sorted(d.name for d in rr.iterdir() if d.is_dir() and any(k and k in _drift_c4_key(d.name) for k in keys))
    except OSError:
        dirs = []
    reports = [f"governance/review-reports/{d}" for d in dirs]
    tpl = f"提交 {sha[:12] if sha else '<sha>'};代碼審見 {'、'.join(reports) or '<卷證>'}"
    return {"first": first, "reports": reports, "template": tpl}


def _drift_c4_print(cx, ev):
    print(f"{_esc_clean(cx['rel'], 200)} 第 {cx['line']} 行(c4 前提寫「還沒提交」)的證據——只列出、不寫檔:")
    print(f"  ①這篇第一次被提交:{ev['first']}")
    print(f"  ②卷證目錄(用計劃名比對猜的,可能漏或多):{_esc_clean('、'.join(ev['reports']), 300) or '查不到'}")
    print(f"  ③範本句:{_esc_clean(ev['template'], 300)}")
    items = [str(x) for x in as_list(parse_frontmatter(cx["lines"][1:cx["fe"]])[0].get("valid_under"))]
    hit = [k for k, x in enumerate(items) if any(w in x for w in _DRIFT_UNCOMMITTED_WORDS)]
    print("  ④目前 valid_under 各項(本工具讀到的;跟原檔對照一下):")
    for k, x in enumerate(items):
        print(f"    {k + 1}. {_esc_clean(x, 300)}" + ("  ← 要改的這項" if k in hit else ""))
    args = " ".join(_drift_sh(_SET_COND_SLOT if k in hit else x) for k, x in enumerate(items))
    print(f"用 lumos set 整欄重寫:把 {_SET_COND_SLOT} 換成那一項改寫後的整句(原本其他內容要自己留著,範本句只是參考),"
          "其他各項照抄:")
    print(_esc_clean(f"    lumos set {_drift_sh(cx['rel'][:-3], node=True)} valid_under {args}", 2000))


def _drift_fix_c4(cx):
    """c4:只列證據、範本與一條預填好的 lumos set 整欄指令,不寫檔(回 None, None)。
    ★c4 不自己寫開頭欄位的原始文字★:代碼審四輪裡,先是「人給片段、工具換原始文字」,再換成「工具寫整項」,都要自己判斷
    原文是什麼 YAML 形狀(引號、全形空白、冒號後空白、控制字元、巢狀、註解、跨行…),零依賴下沒有標準 YAML 讀法可驗,
    每輪都漏一種(r1 到 r4 邊界、外家、正確性席)。Enzo 2026-09-30 裁改走既有的 lumos set 整欄重寫:它不讀原文形狀、
    從人給的各項整欄重寫,已過代碼審。指令裡是本工具讀到的各項,要改的那項放佔位字,人填整句後照貼。"""
    _drift_c4_print(cx, _drift_c4_evidence(cx))
    return None, None


def _drift_c5_test(root, hline):
    """家節點那條正式行綁的測試 → (測試名清單, 錯誤)。多平台專案帶平台前綴時取識別字(resolve_test_refs)。"""
    m = INVARIANT_RE.match(hline.strip())
    if not m:
        return None, "讀不出家節點的正式合約行"
    try:
        pd = load_platforms(root)
        names = [mm for _pl, mm in resolve_test_refs(m.group(1), pd["platforms"] if pd["multiplatform"] else {},
                                                      pd["default_platform"])]
    except (ValueError, OSError) as ex:
        return None, f"解不出正式行綁的測試:{ex}"
    return (names, None) if names else (None, "家節點的正式行沒有綁測試")


def _drift_fix_c5(cx):
    """c5:轉正做了一半——只改守衛紀錄(status 改 pass、同步標籤、四種預告句改寫;跟 settle 第二步同一支算內容)。"""
    import datetime
    lines, fe = cx["lines"], cx["fe"]
    m = re.search(r"^預告的合約:(.+)$", "\n".join(lines), re.M)
    home_rel = (cx["f"].get("related") or [None])[0]
    htext = env_text(cx["env2"], home_rel) if home_rel and m else None
    if htext is None:
        return None, "讀不出預告的合約或家節點"
    claim, hl = m.group(1).strip(), htext.split("\n")
    he = _drift_fm_end(hl)
    if _guard_planned_idx(hl, he, claim):
        return None, f"家節點 {home_rel[:-3]} 同時有預告行與正式行,先手動刪掉預告行再跑"
    fi = _guard_formal_line(hl, he, claim, None)
    names, err = _drift_c5_test(cx["root"], hl[fi]) if fi is not None else (None, "家節點找不到綁了測試的正式行")
    if err:
        return None, err
    new, _missing, synced = _guard_settle_record_lines(lines, fe, home_rel, datetime.date.today().isoformat())

    def _handled(fs, txt):
        fm, _b = split_frontmatter(txt)
        st = str(parse_frontmatter(fm)[0].get("status", "")) if fm is not None else ""
        return st == "pass" and not any(x["kind"] in ("c5", "c1") for x in fs)
    more = f"(正式行綁了 {len(names)} 支,取第一支)" if len(names) > 1 else ""
    return {"new": new, "key": "status", "check": _guard_record_ok(synced), "handled": _handled,
            "extra": {"test": names[0]}, "texts": [], "deps": _drift_deps(cx, [home_rel]),
            "msg": f"守衛紀錄轉為 pass、預告句改成歷史說法;用家節點正式行綁的測試 {names[0]}{more}"}, None


_DRIFT_FIX_COMPUTE = {"c1": _drift_fix_c1, "c2": _drift_fix_c2, "c3": _drift_fix_c3, "c4": _drift_fix_c4,
                      "c5": _drift_fix_c5}


def _drift_fix_shape_err(root, texts):
    """工具要寫的自由文字先跑筆記形狀擋的同一支判定(_ns_check_line、_ns_revisit_violations)→ 錯誤或 None;
    不寫出一份提交前一定被擋的筆記。"""
    if not texts:
        return None
    lst = _nodehome_list(root, "index")
    if lst is None:
        return "git 列不出檔案清單,沒辦法先跑筆記形狀擋"
    files, reader = lst[0], _nodehome_reader(root, "index")
    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}

    def by_name(name):
        return [p for p in files if p.rsplit("/", 1)[-1] == name and _ns_is_code(p, reader, files)]
    for t, reg in texts:
        v = _ns_check_line(root, t, reg, files, reader, top_dirs, by_name) + _ns_revisit_violations(t, reg, True)
        if v:
            return f"要寫進去的文字過不了筆記形狀擋({v[0][0]}:{v[0][1]})——{v[0][2]}"
    return None


def _drift_fix_changes(old, new):
    """改前改後 → [{line, before, after}]:line 是改前的行號;新插入的行 line、before 記 null;刪掉的行 after 記 null。"""
    import difflib
    out = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
        if tag == "equal":
            continue
        for k in range(max(i2 - i1, j2 - j1)):
            b = old[i1 + k] if i1 + k < i2 else None
            out.append({"line": i1 + k + 1 if b is not None else None, "before": b,
                        "after": new[j1 + k] if j1 + k < j2 else None})
    return out


def _drift_fix_preview(cx, res):
    print(f"預覽(--dry-run;沒寫筆記、沒寫修復帳):{cx['rel']}——{res['msg']}")
    for ch in _drift_fix_changes(cx["lines"], res["new"]):
        if ch["before"] is not None:
            print(f"  - 第 {ch['line']} 行:{_esc_clean(ch['before'], 200)}")
        if ch["after"] is not None:
            print(f"  + {_esc_clean(ch['after'], 200)}")


def _drift_git_cmd(cx, head):
    """印給人貼的 git 指令(head 例:「checkout --」、「add governance/drift-fixes.jsonl」)→ 指令或 None。
    路徑用 git 裡的原樣拼法(Linux 上 NFD 檔名拿 NFC 路徑當 pathspec 會對不到,代碼審 r2 正確性席);★不截斷★(截斷會
    變成另一條路徑、或剪掉收尾引號,代碼審 r3 外家否決席);加 --literal-pathspecs,檔名裡的 * ? [ 不被 git 當萬用字元展開、
    多加到別篇(r3 資安席);路徑含控制字元就不印可照貼的指令(消毒會改掉路徑本身),回 None 由呼叫端改講怎麼找。"""
    import unicodedata
    ps = _git_paths_nfc(cx["root"], cx["repo_rel"])
    p = ps[0] if ps else cx["repo_rel"]
    if any(unicodedata.category(c)[0] == "C" for c in p):
        return None
    return f"git --literal-pathspecs {head} {_drift_sh(p)}"


def _drift_git_hint(cx, head):
    return _drift_git_cmd(cx, head) or f"git {head.split()[0]}(路徑含控制字元,不印可照貼的指令;用 git status 找到那一篇)"


def _drift_fix_write(env, cx, res):
    """第 5 步(鎖內):從磁碟重讀,指紋要等於判定時的才寫(atomic_write_verify);寫入例外一律轉成錯誤。"""
    try:
        with _vault_write_lock(env.vault):
            if cx["path"].read_bytes() != cx["raw"]:
                return "判定之後這一篇被改過,沒寫;重跑一次"
            for dp, db in res.get("deps", []):
                try:
                    now = dp.read_bytes()
                except OSError:
                    now = None
                if now != db:
                    return f"判定之後它依賴的 {_esc_clean(str(dp.name), 120)} 被改過,沒寫;重跑一次"
            atomic_write_verify(cx["path"], res["new"], res["key"], res["check"])
    except (ValueError, RuntimeError, OSError) as ex:
        return f"寫不進去,筆記沒動:{ex}"
    return None


def _drift_fix_verify(env, cx, res):
    """第 6 步(鎖外):磁碟內容等於算出的改後內容,而且重建圖譜物件後這一筆已處理。★不自動還原★。"""
    want = "\n".join(res["new"]).encode("utf-8")
    try:
        got = cx["path"].read_bytes()
    except OSError:
        got = None
    ok = got == want and res["handled"](_drift_state_findings(Env(env.vault), only={cx["rel"]}), got.decode("utf-8"))
    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "verify":      # 故障注入接縫(測試用),只認 verify|ledger|moved
        ok = False
    if ok:
        return None
    return (f"寫入後內容跟預期不同(或這一筆還沒處理掉)——工具不自動還原。在 repo 根目錄跑 "
            f"{_drift_git_hint(cx, 'checkout --')} 退回上次提交的版本(★這一篇之前用 drift fix 改過、還沒提交的也會一起退掉★,"
            "修復帳裡那幾筆就只剩稽核紀錄;代碼審 r1 正確性、併發席);退完重跑 lumos drift scan,照新清單再修")


def _drift_fix_record(env, cx, res):
    """第 7 步:寫修復帳(稽核紀錄)、記治理事件。帳寫不進去回 2,不動筆記。"""
    import datetime, hashlib, secrets
    rec = {"id": "DFIX-" + secrets.token_hex(4), "date": datetime.date.today().isoformat(), "path": cx["repo_rel"],
           "line": cx["line"], "kind": cx["kind"], "changed": _drift_fix_changes(cx["lines"], res["new"]),
           "after_sha256": hashlib.sha256("\n".join(res["new"]).encode("utf-8")).hexdigest(), **res["extra"]}
    want = "\n".join(res["new"]).encode("utf-8")
    moved = False
    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "ledger":
        rc = 2
    else:
        with _vault_write_lock(env.vault):
            # 驗證在鎖外,記帳前在鎖內再比一次:帳上的指紋要是記帳那一刻磁碟上的內容(代碼審 r1 外家席)
            try:
                if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "moved":   # 故障注入:模擬別人在驗證與記帳之間改了這一篇
                    cx["path"].write_bytes(want + b"\n")
                moved = cx["path"].read_bytes() != want
            except OSError:
                moved = True
            if moved:
                rc = 2
            else:
                rec["seq"] = _drift_next_seq(cx["root"], _DRIFT_FIXES)
                rc = _drift_ledger_append(cx["root"], _DRIFT_FIXES, rec)
    if rc != 0:
        why = ("寫好、驗過之後這一篇又被別人改了,修復帳沒記(帳上的指紋要是記帳那一刻的內容)" if moved
               else "筆記已改好,但修復帳沒記到")
        print(f"擋下:{why};{_esc_clean(cx['repo_rel'], 200)} 的改動用 git diff 看得到——確認沒問題就直接提交"
              "(修復帳只是稽核紀錄,少這一筆不影響之後的修;沒提交之前,同一篇的下一項 drift fix 會因為指紋對不上帳而擋下);"
              f"要退就 {_drift_git_hint(cx, 'checkout --')}", file=sys.stderr)
        return 2
    _gate_event_or_warn(cx["root"], "drift-check", "fix", f"{cx['rel']}:{cx['line']} {cx['kind']}({rec['id']})")
    return 0


def cmd_drift_fix(env, node, line, kind, o):
    """lumos drift fix <節點> <行號> --kind c1..c5 [--dry-run] [種類專屬參數](Projects/存量漂移改法_計劃 第 1 節)。
    順序:乾淨檢查 → 鎖外讀與判定、前提、git 查詢 → 算改後內容、自由文字先過形狀擋 → (--dry-run 到此)→
    鎖內比指紋寫入 → 鎖外驗證磁碟內容與「已處理」→ 寫修復帳。不自動還原:改之前保證了 git 退得回來。"""
    err = _drift_fix_args_err(kind, o)
    rel = None
    if err is None:
        rel, err = _drift_fix_target(env, node)
    if err is None and kind == "c2" and o.get("keep"):
        return cmd_drift_ack(env, rel, line, "c2", o["reason"], dry_run=bool(o.get("dry_run")))   # 照留:等同帶清單的 c2 表態
    cx = None
    if err is None:
        cx, err = _drift_fix_load(env, rel, line, kind, o)
    res = None
    if err is None:
        res, err = _DRIFT_FIX_COMPUTE[kind](cx)
        if err is None and res is None:
            return 0                                                 # c4 只列證據與範本
    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
    if err is None and o.get("dry_run"):
        _drift_fix_preview(cx, res)
        return 0
    # 帳檔路徑在寫筆記之前先查(代碼審 r1 邊界席:原本寫完筆記才發現帳寫不進去,留下改了筆記、沒帳、又不讓重跑的狀態)
    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    if _drift_fix_record(env, cx, res) != 0:
        return 2
    print(f"✓ drift fix {kind}:{_esc_clean(rel, 200)} 第 {line} 行——{res['msg']}")
    if kind == "c2":
        _issue_close_revisits(env, rel, o["status"])
    print(f"修復帳要跟筆記一起提交:\n    {_drift_git_hint(cx, 'add ' + _DRIFT_FIXES)} && git commit")
    return 0


# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
    import json as _j
    if text is None:
        return _DRIFT_DEFAULT_GATE, [], False
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


def _drift_print_findings(rows, stream, acks=None, alive=None):
    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
              file=stream)
        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
        prev = _drift_prev_ack_line(f)
        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
        if prev:
            print(f"      ({_esc_clean(prev, 400)})", file=stream)
        elif old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  …還有 {len(rows) - 20} 筆", file=stream)


def cmd_drift_check(repo=None, diff_range=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
    import time as _t
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
        return 0
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
    by_lhs = {}
    for (a, b), v in rules.items():
        by_lhs.setdefault(a, []).append((b, v))
    warnings = []
    for a in sorted(changed):
        for b, (conf, sup) in by_lhs.get(a, ()):
            if b in changed or conf < cfg["min_confidence"] or sup < cfg["min_support"]:
                continue
            if not (root / b).exists():  # 殭屍規則:右側已刪/改名 → 不告警
                continue
            warnings.append({"changed": a, "missing": b,
                             "confidence": conf, "support": sup})
    warnings.sort(key=lambda w: (-w["confidence"], -w["support"], w["changed"]))
    if as_json:
        print(json.dumps({"warnings": warnings, "checked": len(changed)},
                         ensure_ascii=False))
    else:
        for w in warnings:
            print(f"提醒:改了 {w['changed']} 但沒動 {w['missing']}——這兩個檔過去 {w['confidence']:.0%} 的時候是一起改的"
                  f"(共 {w['support']} 次)。確認一下是不是漏改了。")
    return 0


_DELGUARD_STOP = frozenset("if else for while return import class def val var fun void public private static final new this true false null let const function".split())
# ①建置產物:這份★必須與 pre-commit 的 should_exclude 逐項對齊★(既有漂移守衛在比),
# 因為兩邊講的是同一件事——那些目錄裡沒有人寫的原始碼。
_DELGUARD_EXCLUDE_DIRS = ("node_modules/", "bin/", "obj/", "dist/", "build/", "__pycache__/", ".git/")
# ②散文與帳本:★只有 delguard 排,絕對不要複製到 pre-commit 的 should_exclude★
# (2026-09-06 代碼審 r1 通才席判 blocker、實測重現:我為了滿足漂移守衛就把 governance/ 一起
#  抄進 pre-commit,結果 governance/ 底下 28 支真程式全部從「改 code 沒動圖譜就擋」的硬閘裡
#  掉出去——兩份清單語意根本不同:delguard 那份是「哪裡不算活著的程式」,pre-commit 那份是
#  「哪些檔改了不必配圖譜」。)
# 為什麼 delguard 要排:符號被審查卷證或治理帳提到,不代表它還活著,掃它們既不準也很貴。
# 實測四個常用詞(doctor/lumos/check/node)全 repo 命中 75587 行、7.17 秒,排除後 7336 行、
# 0.47 秒(15 倍);逾時降級的成本是跟命中行數成正比,不是 token 數。
# ★docs/ 底下的圖譜本體另有 :(exclude){graph_root} 專門排,這裡多排的是帳本與散文。★
_DELGUARD_PROSE_DIRS = ("governance/", "docs/")
_DELGUARD_ALL_EXCLUDE_DIRS = _DELGUARD_EXCLUDE_DIRS + _DELGUARD_PROSE_DIRS
# 與 pre-commit should_exclude 的 lock 排除規則對齊(`*package-lock.json|*yarn.lock|*pnpm-lock.yaml`)
_DELGUARD_EXCLUDE_LOCKFILES = ("package-lock.json", "yarn.lock", "pnpm-lock.yaml")
DELGUARD_TOKEN_CAP = 40  # staged diff 抽出 token 數上限,超額截斷(dropped 計入輸出提示)
DELGUARD_TOP_N = 10  # CLI 文字輸出逐條列出上限,其餘併入「另有 K 處命中」統計行


def _delguard_is_diff_header(ln):
    """True=這行是 unified diff 的檔頭行(--- a/… / +++ b/… / …/dev/null),不是內容行。
    ★不可寫成 startswith(("---","+++"))★——被刪的 SQL/Lua 註解行 `-- x` 在 diff 裡長成
    `--- x`,那樣會被當檔頭吃掉、整行 token 靜默漏抽(2026-08-11 code-loop r1 s5 F6)。"""
    return (ln.startswith("--- a/") or ln.startswith("+++ b/")
            or ln.startswith("--- /dev/null") or ln.startswith("+++ /dev/null"))


def _delguard_parse_diff(diff_text, graph_root):
    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
    2026-08-11 code-loop r1 C);stopword 表剔除;
    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
        ,"vault_diffs": {path: [line...]}}"""
    import re
    tok_re = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")

    def _flags(ln):
        m = re.search(r" b/(.+)$", ln)
        c = m.group(1) if m else None
        # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
        # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
        # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
        vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
        # 建置產物:任何深度都排(src/robin/ 不撞 bin/ 靠前面那個 "/" )
        # ★散文與帳本:只認 repo 根★(2026-09-06 代碼審 r1 外家席)——消費專案的
        # src/docs/parser.py、packages/governance/rules.py 很可能是真程式,不是散文;
        # 而且 git grep 那側的 :(exclude)docs 本來就只排根目錄、pre-commit 寫的也是
        # docs/*,三處要同一個語意才不會各自漂。
        excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
                                for seg in _DELGUARD_EXCLUDE_DIRS)
                            or any(c.startswith(seg) for seg in _DELGUARD_PROSE_DIRS)
                            or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
        return c, vault, excl

    lines = diff_text.splitlines()
    # 第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔不收(文件提及不算「還活著」)
    added, cur, skip, in_binary = {}, None, True, False
    for ln in lines:
        if ln.startswith("diff --git"):
            cur, is_v, is_e = _flags(ln)
            skip = (cur is None) or is_v or is_e or cur.endswith(".md")
            in_binary = False
            continue
        if ln.startswith("Binary files"):
            in_binary = True
            continue
        if skip or in_binary:
            continue
        if ln.startswith("+") and not _delguard_is_diff_header(ln):
            added.setdefault(cur, set()).update(tok_re.findall(ln))
    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
    tokens, seen = [], set()
    vault_diffs, cur, is_vault, is_excl, in_binary = {}, None, False, False, False
    for ln in lines:
        if ln.startswith("diff --git"):
            cur, is_vault, is_excl = _flags(ln)
            in_binary = False
            continue
        if ln.startswith("Binary files"):
            in_binary = True
            continue
        if in_binary or cur is None:
            continue
        if is_vault and (ln.startswith("+") or ln.startswith("-")) and not _delguard_is_diff_header(ln):
            vault_diffs.setdefault(cur, []).append(ln)
            continue
        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
        # (r2 code-loop 折入:N5)
        if is_vault or is_excl or cur.endswith(".md"):
            continue
        if ln.startswith("-") and not _delguard_is_diff_header(ln):
            fadd = added.get(cur) or frozenset()
            for t in tok_re.findall(ln):
                if t in _DELGUARD_STOP or t in fadd or t in seen:
                    continue
                seen.add(t); tokens.append(t)
    return {"tokens": tokens, "vault_diffs": vault_diffs}


def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
    import re, subprocess
    if not tokens:
        return {}
    cmd = ["git", "-c", "core.quotePath=off", "grep", "--cached", "-n", "-I", "-w", "-F"]
    for t in tokens:
        cmd += ["-e", t]
    cmd += ["--", ".", f":(exclude){graph_root}"]
    for d in _DELGUARD_ALL_EXCLUDE_DIRS:
        cmd += [f":(exclude){d.rstrip('/')}"]
    r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", cwd=repo_root, timeout=timeout)
    if r.returncode > 1:
        raise RuntimeError(f"git grep rc={r.returncode}: {r.stderr.strip()[:200]}")
    alive = set()
    pats = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
    for line in r.stdout.splitlines():
        # ★只對內容域配 token★:git grep 輸出是 `path:lineno:content`,連路徑一起配
        # 會被檔名撞名誤降級(刪掉 Login() → app/Login.kt 這個路徑本身讓 Login 判 low,
        # 2026-08-11 code-loop r1 B)。len<3 的行(如 `Binary file … matches`)直接丟。
        parts = line.split(":", 2)
        if len(parts) < 3:
            continue
        content = parts[2]
        for t, p in pats.items():
            if t not in alive and p.search(content):
                alive.add(t)
    return {t: ("low" if t in alive else "high") for t in tokens}


def _delguard_vault_scan(tokens, conf, graph_root_abs, deadline_check=None):
    """回 [{"node": "Systems/憑證.md", "folder": "Systems", "line_no": int,
            "line": str(strip,截 160 字), "tokens": [..], "conf": "high"|"low"}...]
       排序: (conf!=high, folder!="Systems", node, line_no)——高信心先、Systems 先。
       deadline_check: 選用 callable(),os.walk 外層迴圈每檔呼叫一次;回 True 立即
       return 目前累積 hits(部分結果,呼叫端已知逾時語意)。"""
    import re, os
    if not tokens:
        return []
    rx = re.compile(r"\b(?:" + "|".join(map(re.escape, tokens)) + r")\b", re.ASCII)
    per = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
    hits = []
    for dirpath, _dirs, files in os.walk(graph_root_abs):
        for fn in files:
            if deadline_check is not None and deadline_check():
                hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
                return hits
            if not fn.endswith(".md"):
                continue
            fp = os.path.join(dirpath, fn)
            rel = os.path.relpath(fp, graph_root_abs)
            folder = rel.split(os.sep, 1)[0]
            try:
                text = open(fp, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            for i, line in enumerate(text.splitlines(), 1):
                # 單巨檔也要能中止:只在 os.walk 外層檢查的話,一份幾十萬行的節點會整份掃完
                # 才輪到下一次檢查,deadline 直接超支(2026-08-11 code-loop r1 H)
                if deadline_check is not None and i % 2000 == 0 and deadline_check():
                    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
                    return hits
                if not rx.search(line):
                    continue
                ts = [t for t, p in per.items() if p.search(line)]
                hits.append({"node": rel.replace(os.sep, "/"), "folder": folder, "line_no": i,
                             "line": line.strip()[:160], "tokens": ts,
                             "conf": "high" if any(conf.get(t) == "high" for t in ts) else "low"})
    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
    return hits


def _delguard_purelink(diff_lines):
    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
    import re
    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
    plus = [ln[1:] for ln in diff_lines
            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
    minus = [ln[1:] for ln in diff_lines
             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
    changed = plus + minus
    if not changed:
        return False
    ms = {c.strip() for c in minus}
    if any(p.strip() in ms for p in plus):
        return False
    return all(item_re.match(c) or key_re.match(c) for c in changed)


def _delguard_log_result(gr, kind, n_tokens, hits, secs, reason=None):
    """delguard 跑完(ok / 部分結果 degraded)記帳——2026-09-05 第二輪審視 d3:之前只記超時,治理帳看不出比例(架構 r1 E:與 _delguard_log_degraded 對稱的具名 helper)。"""
    try:
        _append_governance_log(Path(gr), [{"gate": "delguard", "kind": kind, "hard": False,
                                           "nodes": sorted({h["node"] for h in hits})[:10],
                                           "note": f"tokens={n_tokens} hits={len(hits)} secs={secs:.1f}" + (f" reason={reason}" if reason else "")}])
    except Exception:
        pass


def _delguard_log_degraded(gr, reason, n_tokens):
    """★體檢 #9(2026-08-21)★:delguard 降級(超時/內部錯誤)一律寫治理帳 gate=delguard kind=degraded。
    之前只印一行「放行」——一天印 5 次、無處可數;現在 gov --stats 看得到降級率。best-effort 靜默。
    commit 欄=當下 HEAD(pre-commit 時=上一個 commit),note 標 reason。"""
    try:
        if gr:
            _append_governance_log(Path(gr), [{"gate": "delguard", "kind": "degraded", "hard": False,
                                               "nodes": [], "note": f"reason={reason} tokens={n_tokens}"}])
    except Exception:
        pass


def cmd_delguard_check(repo=None, as_json=False):
    """code 側刪除傳播守衛(advisory):staged diff 抽被刪 token → 兩檔信心 → grep vault 指名過期原句。
    恆 rc0(內部錯誤/超時皆 fail-open 放行;唯一輸出差異是訊息)。
    vault-free repo(找不到 graph root)→ 靜默 rc0,不掃。
    --json 降級契約(超時/內部錯誤皆同款):單行合法 JSON
    {"tokens": int, "hits": [], "fake_sync": [], "degraded": true, "reason": "timeout"|"error"},rc0。"""
    import json, os, subprocess, time
    t0 = time.monotonic()
    try:  # 亂設的 env 不該讓 pre-commit 印 traceback(fail-open 契約覆蓋設定錯誤)
        deadline = float(os.environ.get("LUMOS_DELGUARD_DEADLINE", "15.0"))  # 5.0 在本 repo(377 篇+大 diff)仍常超,2026-08-27 一 session 降級多次→15;advisory fail-open,pre-commit 多等幾秒換掃完整
    except (ValueError, TypeError):
        deadline = 15.0   # s1-f2:兜底跟預設一致(原 2.0,主值調 15 後落差 7.5 倍→非數值 env 悄悄退化只給 2 秒)
    def _over():
        return time.monotonic() - t0 > deadline
    def _degraded_json(reason, n_tokens):
        print(json.dumps({"tokens": n_tokens, "hits": [], "fake_sync": [],
                          "degraded": True, "reason": reason}, ensure_ascii=False))
    tokens = []
    try:
        if os.environ.get("LUMOS_DELGUARD_RAISE"):
            raise RuntimeError("test hook")
        root = str(_cochange_repo_root(repo) or os.getcwd())
        gr = find_vault(Path(root))  # 既有 vault 偵測 helper;找不到→靜默 rc0(vault-free repo 不掃)
        if not gr:
            return 0
        gr_rel = os.path.relpath(gr, root).replace(os.sep, "/")
        # standalone vault repo(整個 repo 就是 vault,graph_root=".")→ 沒有 code 側可守,
        # 且 "." 前綴會讓每個檔都判成 vault、路徑相對計算全歪 → 靜默 rc0(2026-08-11 code-loop r1 E)
        if gr_rel == ".":
            return 0
        # diff 前綴固定:使用者 ~/.gitconfig 若設 diff.noprefix / diff.mnemonicPrefix,
        # 檔頭會變成 `--- app/x` 或 `--- i/app/x`,` b/` 抽檔名整條失效 → token 全漏(r1 D)
        r = subprocess.run(["git", "-c", "core.quotePath=off",
                            "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
                            "diff", "--no-ext-diff", "--no-textconv", "--cached", "-M", "--no-color"],
                           capture_output=True, text=True, errors="replace", cwd=root,
                           timeout=max(0.1, deadline - (time.monotonic() - t0)))
        if r.returncode != 0:
            # ★不得靜默吞★:git diff 失敗時 r.stdout 恆空,若不擋下去會被
            # _delguard_parse_diff 解析成「tokens=0」——長得像掃描乾淨的成功結果,
            # 實際是沒掃到東西的失敗(r2 code-loop 折入:N3①)。丟進既有 except
            # 才能落成 degraded=true/內部錯誤,而不是假成功。
            raise RuntimeError(f"git diff rc={r.returncode}: {r.stderr[:200]}")
        parsed = _delguard_parse_diff(r.stdout, gr_rel)
        tokens = parsed["tokens"][:DELGUARD_TOKEN_CAP]
        dropped = len(parsed["tokens"]) - len(tokens)
        if _over():
            _delguard_log_degraded(gr, "timeout", len(tokens))
            if as_json:
                _degraded_json("timeout", len(tokens))
            else:
                print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查超時降級({deadline}s 內沒掃完),先放行;這次結果不完整,已記一筆在治理帳。")
            return 0
        rem = max(0.1, deadline - (time.monotonic() - t0))
        conf = _delguard_confidence(tokens, root, gr_rel, timeout=rem)
        if _over():
            _delguard_log_degraded(gr, "timeout", len(tokens))
            if as_json:
                _degraded_json("timeout", len(tokens))
            else:
                print(f"delguard: 超時降級({deadline}s),放行;本輪掃描不完整(已記治理帳 delguard/degraded)")
            return 0
        _trunc = {"hit": False}
        def _deadline_check():
            if time.monotonic() - t0 > deadline:
                _trunc["hit"] = True   # 掃描真的被截斷才算部分結果(delta r2:剛好慢了但掃完不算)
                return True
            return False
        hits = _delguard_vault_scan(tokens, conf, gr, deadline_check=_deadline_check)
        _partial = _trunc["hit"]   # 外家 r1 M2:掃描被 deadline 截斷回部分結果,不能算 ok
        _slow = (not _partial) and (time.monotonic() - t0 > deadline)   # delta r3:單一大檔掃完才發現超時=結果完整但慢,記 ok 帶 reason=slow 讓帳看得到
        _delguard_log_result(gr, "degraded" if _partial else "ok", len(tokens), hits, time.monotonic() - t0, reason=("timeout-partial" if _partial else ("slow" if _slow else None)))
        fake = []
        for path, dl in parsed["vault_diffs"].items():
            rel = os.path.relpath(os.path.join(root, path), gr).replace(os.sep, "/")
            if _delguard_purelink(dl) and any(h["node"] == rel for h in hits):
                fake.append(rel)
        if as_json:
            print(json.dumps({"tokens": len(tokens), "dropped": dropped, "hits": hits,
                              "fake_sync": fake, "degraded": _partial, **({"reason": "timeout-partial"} if _partial else {})}, ensure_ascii=False))   # 外家 r2:部分結果不能宣稱完整
            return 0
        if not hits:
            if dropped:
                print(f"delguard: 無命中;{dropped} 個符號超 cap 未掃(--json 看已掃全量)")
            return 0
        hi = sum(1 for h in hits if h["conf"] == "high")
        n_hit_tokens = len({t for h in hits for t in h["tokens"]})
        print(f"提醒:這次刪掉的東西,有 {n_hit_tokens} 個被刪符號還在筆記裡被提到(確定沒別處在用的 {hi} 個/不確定的 {len(hits)-hi} 個)。筆記講的東西已經不在了,讀的人會被誤導。")
        for h in hits[:DELGUARD_TOP_N]:
            print(f"  [{h['conf']}] {h['node']}:{h['line_no']} 「{h['line']}」 ← {','.join(h['tokens'])}")
        rest = len(hits) - min(len(hits), DELGUARD_TOP_N)
        if rest or dropped:
            print(f"  …另有 {rest} 處命中/{dropped} 個符號超 cap 未展開(--json 看已掃全量)")
        for n in fake:
            print(f"  提醒:{n} 這次只加了連結、正文沒改,但正文還在講已經被刪掉的東西。")
        print("  退場前自問:這次到底拿掉或改變了什麼?上面每一句,改完之後還是對的嗎?")
        print("  還對的寫一句為什麼;不對的現在就改掉或標過期。光是幫筆記加連結,不算更新內容。")
        return 0
    except subprocess.TimeoutExpired:
        # git diff/grep 子程序逾時漏出來——那是「超時」不是「內部錯誤」(2026-08-21 體檢 #9:
        # 當天印的「內部錯誤(TimeoutExpired)」全屬此類,誤導讀者以為壞了)
        _delguard_log_degraded(locals().get("gr"), "timeout", len(locals().get("tokens", [])))
        if as_json:
            _degraded_json("timeout", len(locals().get("tokens", [])))
        else:
            print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查超時降級(git 子程序逾時),先放行;這次結果不完整,已記一筆在治理帳。")
        return 0
    except Exception as e:
        _gr = locals().get("gr")
        if not _gr:   # 例外可能發生在 gr 算出來之前(測試鉤子/早期 git 失敗)→ 自己找 vault 再落帳
            try:
                _root = str(_cochange_repo_root(repo) or os.getcwd())
                _gr = find_vault(Path(_root))
                # standalone vault(vault 即 repo 根)→ 帳會寫到 repo 外(vault.parent),與主路徑
                # gr_rel=="." 早退同語意:不落帳(code-loop r1 s2)
                if _gr and os.path.relpath(_gr, _root).replace(os.sep, "/") == ".":
                    _gr = None
            except Exception:
                _gr = None
        _delguard_log_degraded(_gr, f"error:{e.__class__.__name__}", len(locals().get("tokens", [])))
        if as_json:
            _degraded_json("error", len(locals().get("tokens", [])))
        else:
            print(f"提醒:「刪掉的東西筆記還在不在講」這項檢查自己出了內部錯誤({e.__class__.__name__}),先放行;已記一筆在治理帳。")
        return 0



