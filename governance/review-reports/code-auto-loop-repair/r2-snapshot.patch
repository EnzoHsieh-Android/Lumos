+    def test_consecutive_fail_days_alert_fires(self):
+        # conf-f6:預埋兩個失敗有跑日→收尾判 CONSEC_FAIL→喊人線路走到
+        import datetime
+        d1 = (datetime.date.today() - datetime.timedelta(days=2)).isoformat()
