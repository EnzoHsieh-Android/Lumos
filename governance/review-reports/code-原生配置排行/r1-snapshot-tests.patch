+def t_android_native_phase_exception():
+    """S8、S28 的函式那一半:第二段丟出意外例外 → 先收掉第二段的錄製(abort_record 拿到它、state 裡的錄製槽清掉)再寫 failed 附例外類型;
+    丟 Terminated 照樣往上丟、錄製照樣收;收不掉時記下來,中斷收尾時照實說裝置上可能還留著。"""
+    import tempfile
+    with tempfile.TemporaryDirectory(prefix="gctl-ms-") as td:
+        ns = _ms_collector_ns(td)
+        calls = []
+        ns["abort_record"] = lambda rec: calls.append(rec) or True
+        rec = ("4321", "/data/misc/perfetto-configs/lumos-native-run1.pbtxt", "/data/misc/perfetto-traces/lumos-native-run1.pftrace")
+        def boom(exc):
+            def f(st, run_dir, state):
+                state["rec"] = rec
+                raise exc
+            return f
+        st = {"native_retained": ["@default"], "test_data": {"value": True}}
+        res = {"android_sdk": 36, "driver": {"status": "ok"}, "pids": {"status": "ok"}}
+        ns["native_run"] = boom(RuntimeError("x"))
+        state = {}
+        out = ns["native_phase"](st, None, res, td, state, 1.0)
+        check("意外例外 → failed、enabled true、原因帶例外類型", out == {"enabled": True, "status": "failed", "reason": "第二段出了意外(RuntimeError)"}, str(out))
+        check("寫 failed 之前收掉了第二段的錄製", calls == [rec] and "rec" not in state, str((calls, state)))
+        calls.clear()
+        ns["native_run"] = boom(ns["Terminated"]())
+        state, raised = {}, False
+        try:
+            ns["native_phase"](st, None, res, td, state, 1.0)
+        except ns["Terminated"]:
+            raised = True
+        check("Terminated 不被吞掉、照樣往上丟", raised)
+        check("往上丟之前也收掉錄製", calls == [rec] and "rec" not in state, str((calls, state)))
+        ns["abort_record"] = lambda rec: False
+        ns["native_run"] = boom(RuntimeError("x"))
+        state = {}
+        ns["native_phase"](st, None, res, td, state, 1.0)
+        check("收不掉 → 記下裝置上可能還留著", state.get("device_dirty") is True, str(state))
+        ns["stop_listening"] = lambda: None
+        check("中斷收尾時照實回報裝置沒收乾淨", ns["cleanup"](state) is False)
+
