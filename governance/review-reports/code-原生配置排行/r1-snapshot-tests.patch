+def _ms_collector_ns(td):
+    """把收集腳本裡的 Python 段(heredoc 裡、去掉最後的 main())載進一個命名空間,拿來單獨呼叫裡面的函式。"""
+    script = (Path(GRAPHCTL).resolve().parent / "templates" / "android-stability-collect.sh").read_text(encoding="utf-8")
+    body = script.split("<<'PY'\n", 1)[1].rsplit("\nPY\n", 1)[0]
+    body = body.rstrip()
+    check("前置:Python 段最後一行是 main()", body.endswith("\nmain()"), body[-40:])
+    ns = {"__name__": "collector"}
+    old = sys.argv
+    sys.argv = ["-", str(Path(GRAPHCTL).resolve().parent / "templates"), str(td), "run1"]
+    try:
+        exec(compile(body.removesuffix("main()"), "android-stability-collect", "exec"), ns)
+    finally:
+        sys.argv = old
+    return ns
