+def _ms_native_out(fake, sites=(("Java_nativeCreate", "libfakesdk.so", "com.lab.PlayerActivity.onCreate", 1, 0, 16 * _MS_MIB),), rows=40, stats=()):
+    """假 trace_processor 回的原生配置排行輸出(照查詢的七欄、文字欄 hex)。"""
+    def hx(t):
+        return t.encode("utf-8").hex().upper()
+    lines = [f'"site","{hx(f)}","{hx(so)}","{hx(c)}",{sym},{sys_},{r}' for f, so, c, sym, sys_, r in sites]
+    lines.append(f'"rows","","","",0,0,{rows}')
+    lines += [f'"stat","{hx(n)}","","",0,0,{v}' for n, v in stats]
+    (fake / "native.out").write_text("\n".join(lines) + "\n", encoding="utf-8")
+
