+def _ms_native(chains, stats=()):
+    """照 Perfetto 的表(heap_profile_allocation、stack_profile_callsite / frame / mapping、stats)建假資料,跑原生配置排行的查詢。
+    chains:[(size 或 size 清單, [(函式名, mapping 完整路徑, rel_pc), …從根到 malloc])];stats:[(名字, 等級, 值)]。
+    回 {"sites": [(func, so, caller, symbol, system, retained)…], "rows": 列數, "stats": [名字…]};範本不在回 None。"""
+    def lit(v):
+        return "NULL" if v is None else str(v) if isinstance(v, int) else "'" + v.replace("'", "''") + "'"
+    maps, frames, cs, allocs = {}, [], [], []
+    for size, chain in chains:
+        parent = None
+        for name, path, pc in chain:
+            if path is not None and path not in maps:
+                maps[path] = len(maps) + 1
+            frames.append(f"({len(frames) + 1}, {lit(name)}, {lit(maps.get(path))}, {lit(pc)})")
+            cs.append(f"({len(cs) + 1}, {lit(parent)}, {len(frames)})")
+            parent = len(cs)
+        for x in (size if isinstance(size, list) else [size]):
+            allocs.append(f"({len(allocs)}, 'libc.malloc', {parent}, {x})")
+    setup = "".join([
+        "insert into stack_profile_mapping values " + ", ".join(f"({i}, {lit(p)})" for p, i in maps.items()) + ";" if maps else "",
+        "insert into stack_profile_frame values " + ", ".join(frames) + ";" if frames else "",
+        "insert into stack_profile_callsite(id, parent_id, frame_id) values " + ", ".join(cs) + ";" if cs else "",
+        "insert into heap_profile_allocation(ts, heap_name, callsite_id, size) values " + ", ".join(allocs) + ";" if allocs else "",
+        "insert into stats(name, severity, value) values " + ", ".join(f"({lit(n)}, {lit(sv)}, {v})" for n, sv, v in stats) + ";" if stats else ""])
+    rows = _ms_sql("android-stability-native.sql", setup)
+    if rows is None:
+        return None
+    def txt(h):
+        return bytes.fromhex(h).decode("utf-8")
+    return {"sites": [(txt(r[1]), txt(r[2]), txt(r[3]), r[4], r[5], r[6]) for r in rows if r[0] == "site"],
+            "rows": next((r[6] for r in rows if r[0] == "rows"), None),
+            "stats": sorted(txt(r[1]) for r in rows if r[0] == "stat")}
+
+
+def _ms_jni(name, caller="com.lab.PlayerActivity.onCreate"):
+    """App 的函式 → JNI 跳板 → SDK 的 JNI 函式(到這裡,後面接配置器那幾層)。"""
+    return [(caller, _MS_APP, 64), _MS_TRAMP, (name, _MS_SDK, 128)]
