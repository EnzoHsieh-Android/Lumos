+    import json, subprocess as sp
+    st = {"native_retained": ["@default"], "test_data": _MS_TEST_DATA}
+    st.update(stability or {})
+    st = {k: v for k, v in st.items() if v is not None}
+    kw.setdefault("exit_before", _MS_EXIT_HEAD)
+    kw.setdefault("exit_after", _MS_EXIT_HEAD)
+    root, fake, script = _ms_prepare(td, stability=st, **kw)
+    if scenarios:
+        cfgp = root / ".lumos" / "macrobench.json"
+        cfgp.write_text(json.dumps(dict(json.loads(cfgp.read_text()), stability_scenarios=scenarios)), encoding="utf-8")
+    _ms_native_out(fake)
+    if setup:
+        setup(fake)
+    r = sp.run(["sh", str(script), "run1"], cwd=root, capture_output=True, text=True, env=dict(_ms_collect_env(fake), **(env or {})), timeout=180)
+    out = root / ".lumos" / "artifacts" / "android" / "run1" / "stability.json"
+    return r, (json.loads(out.read_text(encoding="utf-8")) if out.is_file() else {}), fake, root
