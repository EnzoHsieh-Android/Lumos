+def t_android_native_budget_rule():
+    """S23 的函式那一半:預估 = 第一段秒數的兩倍加 NATIVE_TAIL(120 秒),剩下的秒數「不到」預估才不跑(剛好等於照跑);沒設上限不限制;
+    跑的話每次驅動的上限不超過「上限時刻扣 NATIVE_TAIL」、查詢不超過「扣 NATIVE_FINISH」剩下的時間、也不超過 T_LONG;
+    預估放行時驅動至少還有第一段兩倍的秒數(預估與截止用同一個保留量,不會放行一段注定被砍的第二段)。"""
+    import tempfile, time
+    with tempfile.TemporaryDirectory(prefix="gctl-ms-") as td:
+        ns = _ms_collector_ns(td)
+        st = {"native_retained": ["@default"]}
+        res = {"android_sdk": 36, "driver": {"status": "ok"}, "pids": {"status": "ok"}}
+        check("第一段 100 秒、剩 320 秒(2×100 + 120 = 320)→ 照跑", ns["native_skip"](st, None, True, res, 100.0, 320.0) is None)
+        got = ns["native_skip"](st, None, True, res, 100.0, 319.0)
+        check("剩 319 秒 → failed 時間不夠", got and got[1] == "failed" and "時間不夠" in got[2], str(got))
+        check("沒設上限 → 不限制", ns["native_skip"](st, None, True, res, 10 ** 6, None) is None)
+        seen = []
+        ns["shell"] = lambda cmd, timeout=None: (0, "", "")
+        ns["read_exits"] = lambda pkg: ("ok", [])
+        ns["pidof"] = lambda pkg: 100
+        ns["SETTLE"] = 0
+        ns["driver"] = lambda cmd, n, serial, timeout=None: seen.append(("driver", timeout)) or {"rc": 0, "ok": True}
+        ns["start_record"] = lambda *a: ("4321", "c", "t")
+        ns["stop_record"] = lambda rec, run_dir, local: ("/x/heap-native.pftrace", None)
+        ns["native_query"] = lambda trace, pkg, timeout=None: seen.append(("query", timeout)) or ([], None)
+        stc = {"package": "com.lab", "cycles": 5, "warmup": 2, "driver": "d {{CYCLES}}"}
+        out = ns["native_run"](stc, td, {}, time.time() + 200)
+        check("前置:第二段走完、ok", out.get("status") == "ok", str(out))
+        drv = [t for k, t in seen if k == "driver"]
+        qry = [t for k, t in seen if k == "query"]
+        check("剩 200 秒:兩次驅動的上限在 80 秒以內(扣 120)、查詢在 185 秒以內(扣 15)", len(drv) == 2 and all(70 < t <= 80 for t in drv)
+              and len(qry) == 1 and 175 < qry[0] <= 185, str(seen))
+        seen.clear()
+        e = 10.0
+        remaining = 2 * e + ns["NATIVE_TAIL"]
+        check("前置:剩下的秒數剛好過預估", ns["native_skip"](st, None, True, res, e, remaining) is None)
+        ns["native_run"](stc, td, {}, time.time() + remaining)
+        check("預估放行時驅動至少還有第一段兩倍的秒數(不會只拿到 1 秒)", all(t >= 2 * e - 1 for k, t in seen if k == "driver"), str(seen))
+        seen.clear()
+        ns["native_run"](stc, td, {}, time.time() + 10 ** 7)
+        check("上限很遠:驅動與查詢都不超過 T_LONG", len(seen) == 3 and all(t == ns["T_LONG"] for _, t in seen), str(seen))
+        seen.clear()
+        ns["native_run"](stc, td, {}, None)
+        check("沒有上限:驅動與查詢都是 T_LONG", len(seen) == 3 and all(t == ns["T_LONG"] for _, t in seen), str(seen))
+
