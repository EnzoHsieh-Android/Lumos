+_MS_ART = "/apex/com.android.art/lib64/libart.so"
+_MS_APP = "/data/app/~~x/com.lab-1/oat/arm64/base.odex"
+_MS_MALLOC = ("malloc", _MS_LIBC, 16)
+_MS_TRAMP = ("art_quick_generic_jni_trampoline", _MS_ART, 32)
+_MS_MIB = 1048576
