+# ── 原生配置排行(Projects/原生記憶體增長提示_計劃;家 Systems/android-stability-collector、Systems/macrobenchmark-adapter)──
+_MS_LIBC = "/apex/com.android.runtime/lib64/bionic/libc.so"
