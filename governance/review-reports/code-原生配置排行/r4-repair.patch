++def native_phase(st, scen, test_data, res, run_dir, state, elapsed, end=None):
++    """原生配置排行那段的外殼:判要不要跑、跑的時候出意外先收掉這一段的錄製再寫成 failed(收不掉就在原因裡照實寫);
