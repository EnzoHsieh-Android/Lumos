+def t_android_native_phase_exception():
+    """S8、S28 的函式那一半:第二段丟出意外例外 → 先收掉第二段的錄製(abort_record 拿到它、state 裡的錄製槽清掉)再寫 failed 附例外類型與訊息;
+    收不掉就在原因裡照實寫裝置上可能還留著;丟 Terminated 照樣往上丟,錄製留在 state 給 main 的 cleanup 收(跟中斷在第一段時同一條路)。"""
+    import tempfile
+    with tempfile.TemporaryDirectory(prefix="gctl-ms-") as td:
+        ns = _ms_collector_ns(td)
+        calls = []
+        ns["abort_record"] = lambda rec: calls.append(rec) or True
+        rec = ("4321", "/data/misc/perfetto-configs/lumos-native-run1.pbtxt", "/data/misc/perfetto-traces/lumos-native-run1.pftrace")
+        def boom(exc):
+            def f(st, run_dir, state, end=None):
+                state["rec"] = rec
+                raise exc
+            return f
+        st = {"native_retained": ["@default"]}
+        res = {"android_sdk": 36, "driver": {"status": "ok"}, "pids": {"status": "ok"}}
+        ns["native_run"] = boom(RuntimeError("x"))
+        state = {}
+        out = ns["native_phase"](st, None, True, res, td, state, 1.0)
+        check("意外例外 → failed、enabled true、原因帶例外類型與訊息", out == {"enabled": True, "status": "failed", "reason": "第二段出了意外(RuntimeError:x)"}, str(out))
+        check("寫 failed 之前收掉了第二段的錄製", calls == [rec] and "rec" not in state, str((calls, state)))
+        ns["abort_record"] = lambda rec: False
+        state = {}
+        out = ns["native_phase"](st, None, True, res, td, state, 1.0)
+        check("收不掉 → 原因照實寫裝置上可能還留著", "可能還留著" in out.get("reason", "") and out.get("status") == "failed", str(out))
+        calls.clear()
+        ns["abort_record"] = lambda rec: calls.append(rec) or True
+        ns["native_run"] = boom(ns["Terminated"]())
+        state, raised = {}, False
+        try:
+            ns["native_phase"](st, None, True, res, td, state, 1.0)
+        except ns["Terminated"]:
+            raised = True
+        check("Terminated 不被吞掉、照樣往上丟", raised)
+        check("往上丟時錄製還在 state,交給 main 的 cleanup 收(這裡不先收)", state.get("rec") == rec and calls == [], str((calls, state)))
+        ns["stop_listening"] = lambda: None
+        check("cleanup 收得到那份錄製", ns["cleanup"](state) is True and calls == [rec], str(calls))
+        def abort_interrupted(r):
+            raise ns["Terminated"]()
+        ns["abort_record"] = abort_interrupted
+        ns["native_run"] = boom(RuntimeError("x"))
+        state, raised = {}, False
+        try:
+            ns["native_phase"](st, None, True, res, td, state, 1.0)
+        except ns["Terminated"]:
+            raised = True
+        check("意外例外後收錄製的那幾秒被中斷:錄製還在 state,cleanup 還收得到、不會誤報已收乾淨", raised and state.get("rec") == rec, str(state))
+
