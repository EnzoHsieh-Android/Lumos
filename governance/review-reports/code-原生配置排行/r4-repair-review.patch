     return {"enabled": sec["enabled"], "status": sec["status"], "reason": _events_clean(reason, 500) or None, "sites": sites}
 
 
 def _macrobench_native_print(nr):
     """原生配置排行的文字輸出(獨立於門檻輸出,只提醒):沒打開不印;打開了沒跑成或形狀不對印一行;ok 印前 MACROBENCH_NATIVE_SHOW 個。"""
     if not nr["enabled"]:
         return
     if nr["status"] != "ok":
         print(f"原生配置排行沒跑成:{_events_clean(nr['reason'] or '沒寫原因', 500)}(只提醒,不擋推送)")
         return
