# merge commit 不適用 bypass 概念 (內容來自既有 commit) → 跳過
if [[ "$(git rev-list --parents -n 1 HEAD | wc -w)" -gt 2 ]]; then
  exit 0
fi

# 本次 commit 的檔案清單 (quotePath=off 對齊 pre-commit 的中文路徑處理)
CHANGED="$(git -c core.quotePath=off diff-tree --no-commit-id --name-only -r HEAD)"
[[ -z "$CHANGED" ]] && exit 0

# code 副檔名與排除規則 (對齊 pre-commit / check-graph-sync.py CODE_EXTS)
CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp|sh|ps1)$'  # sh/ps1 2026-08-21 補(體檢 #7);四份清單由 t_code_exts_four_lists_agree 釘

is_shebang_code() {   # 沒副檔名的檔:看 剛 commit 的 內容首行是不是 #!(2026-09-05 README 審視 d1:scripts/lumos 這種主程式五月起 26 次漏過)
  local path="$1" base
  # git 對含 " \ 或控制字元的檔名會印成 C 式引號("a\"b");拿去 git show 會找不到 → 先解引號(r2 delta major)
  if [[ "$path" == \"*\" ]]; then
    path="${path:1:${#path}-2}"; path="${path//\\\"/\"}"; path="${path//\\\\/\\}"; path="${path//\\t/$'\t'}"
  fi
  base="${path##*/}"; base="${base#"${base%%[!.]*}"}"; [[ "$base" == *.* ]] && return 1   # 去掉所有開頭的點再看有沒有副檔名(.pythonrc、..foo 也要看 shebang)
  local first; first="$(git show "HEAD:$path" 2>/dev/null | head -c 200 | head -n 1)" || return 1
  [[ "$first" == "#!"* ]]   # 任何 shebang 都算(不列直譯器清單:r1 外家 #!/bin/dash 漏判;四處同一條規則,由 t_code_exts_four_lists_agree 釘)
}
should_exclude() {
  local path="$1"
  case "$path" in
    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
    # vendored 工具白名單+源 repo 守門(與 pre-commit 完全對齊,2026-07-25):例行 lumos update
    # 的 vendored .py 不該進 bypass 帳(pre-commit 已放行,這裡再記=假 bypass 灌水稀釋真訊號)。
    scripts/lumos|scripts/test_lumos.py|scripts/merge-claude-settings.py|scripts/graph-rename.sh|scripts/fetch-notesmd.sh|scripts/hooks/*|scripts/templates/*)
      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
      return 0;;
  esac
  return 1
}

src_files=()
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if ! [[ "$f" =~ $CODE_EXTS_RE ]] && ! is_shebang_code "$f"; then continue; fi
  if should_exclude "$f"; then continue; fi
  src_files+=("$f")
done <<< "$CHANGED"

# 沒 code → 本來就會被 pre-commit 放行,不是 bypass
[[ ${#src_files[@]} -eq 0 ]] && exit 0

# 有圖譜 .md 一起 commit → 正常通過 L2,不是 bypass
if echo "$CHANGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
  exit 0
fi

# ── 走到這裡 = 這筆 commit 繞過了 L2 → 留痕 ──
BYPASS_LOG="$REPO_ROOT/docs/.bypass-log.jsonl"

PY="$(command -v python3 || command -v python)"
COMMIT_HASH="$(git rev-parse --short HEAD)" \
BRANCH="$(git branch --show-current)" \
SUBJECT="$(git log -1 --format=%s)" \
SRC_COUNT="${#src_files[@]}" \
SRC_SAMPLE="$(printf '%s\n' "${src_files[@]:0:10}")" \
"$PY" - "$BYPASS_LOG" <<'PYEOF'
import json, os, sys
from datetime import datetime, timezone

entry = {
    "ts": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
    "commit": os.environ["COMMIT_HASH"],
    "branch": os.environ["BRANCH"],
    "subject": os.environ["SUBJECT"],
    "code_file_count": int(os.environ["SRC_COUNT"]),
    "code_files": os.environ["SRC_SAMPLE"].splitlines(),
}
with open(sys.argv[1], "a", encoding="utf-8") as f:
    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
PYEOF

{
  echo ""
  echo "記下了:這次 commit 有 ${#src_files[@]} 個程式碼檔沒帶筆記改動,已寫進跳過紀錄(不擋,只留痕)。"
# 為什麼:lint 自 2026-06 起沒有任何 hook/CI 呼叫,它的每條鐵則(YAML list/白名單/枚舉/frontmatter
# 閉合)全靠人記得跑——「有機制,沒接線」。硬擋:lint rc≠0 即擋,訊息原樣轉出。
# 只跑 staged 的圖譜檔(每檔 <1s),不跑全 vault。找不到 python/lumos → 跳過(與 Gate CC 同語意)。
if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
  lint_fail=0
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    [[ -f "$f" ]] || continue          # 刪除的檔不 lint
    # ★傳 vault 相對路徑、去 .md★——lumos lint 的精確比對鍵是 vault 相對的「Systems/foo」;
    # 丟 repo 相對路徑會落到 stem 查找,同檔名不同資料夾時 lint 到別的節點、壞的放行(code-loop r1 s1)。
    rel="${f#$GRAPH_ROOT/}"; rel="${rel%.md}"
    if ! out="$("$CC_PY" "$REPO_ROOT/scripts/lumos" lint "$rel" 2>&1)"; then
      lint_fail=1
      { echo ""; echo "擋下:這篇筆記的格式檢查沒過——$f"; echo "$out" | sed 's/^/   /'; } >&2
    fi
  done < <(echo "$STAGED" | grep -E "^${GRAPH_ROOT}/.*\.md$" || true)
  if [[ "$lint_fail" == 1 ]]; then
    { echo ""; echo "格式錯的筆記進了版控,之後的工具會讀錯(合約標記消失、連結變鬼節點)。照上面的提示修好再 commit。"; echo "真的要先進去 → git commit --no-verify,並在訊息裡留一句為什麼。"; echo ""; } >&2
    exit 1
  fi
fi


# ── 圖譜同步覆蓋點名(2026-08-22,提醒不擋):動過圖譜不等於動對篇。呈現在 lumos 內(impact --sync-only),
# 這裡跟 cochange / delguard 一樣只呼叫、不碰內容。
sync_nudge() {   # $1=diff range(或 staged)
  local _py; _py="$(command -v python3 || command -v python || true)"
  [ -n "$_py" ] && [ -f "$REPO_ROOT/scripts/lumos" ] || return 0
  "$_py" "$REPO_ROOT/scripts/lumos" impact --diff "$1" --sync-only --repo "$REPO_ROOT" 1>&2 2>/dev/null || true
}

# Gate 2: code 副檔名 (對齊 check-graph-sync.py CODE_EXTS)
CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp|sh|ps1)$'  # sh/ps1 2026-08-21 補(體檢 #7);四份清單由 t_code_exts_four_lists_agree 釘

# 排除路徑
is_shebang_code() {   # 沒副檔名的檔:看 staged 內容首行是不是 #!(2026-09-05 README 審視 d1:scripts/lumos 這種主程式五月起 26 次漏過)
  local path="$1" base
  # git 對含 " \ 或控制字元的檔名會印成 C 式引號("a\"b");拿去 git show 會找不到 → 先解引號(r2 delta major)
  if [[ "$path" == \"*\" ]]; then
    path="${path:1:${#path}-2}"; path="${path//\\\"/\"}"; path="${path//\\\\/\\}"; path="${path//\\t/$'\t'}"
  fi
  base="${path##*/}"; base="${base#"${base%%[!.]*}"}"; [[ "$base" == *.* ]] && return 1   # 去掉所有開頭的點再看有沒有副檔名(.pythonrc、..foo 也要看 shebang)
  local first; first="$(git show ":$path" 2>/dev/null | head -c 200 | head -n 1)" || return 1
  [[ "$first" == "#!"* ]]   # 任何 shebang 都算(不列直譯器清單:r1 外家 #!/bin/dash 漏判;四處同一條規則,由 t_code_exts_four_lists_agree 釘)
}
should_exclude() {
  local path="$1"
  case "$path" in
    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
    # vendored 工具白名單(lumos 自有物,例行 lumos update 不該撞圖譜閘;2026-07-25)。
    # ★精確白名單,非 scripts/* 整夾★——專案自有 scripts/foo.py 仍照擋。
    # ★源 repo 守門★:在 Lumos 來源 repo 本身(有 skills/lumos-project-notes),這些檔=產品碼,
    # 豁免不適用(否則源 repo 自家改 scripts/lumos 不帶圖譜會靜默放行=弄弱自家閘)。
    # 與 scripts/lumos 的 _VENDORED_TOOLKIT 常數同源;漂移守衛 t_precommit_whitelist_drift_guard。
    scripts/lumos|scripts/test_lumos.py|scripts/merge-claude-settings.py|scripts/graph-rename.sh|scripts/fetch-notesmd.sh|scripts/hooks/*|scripts/templates/*)
      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
      return 0;;
  esac
  return 1
}

src_files=()
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if ! [[ "$f" =~ $CODE_EXTS_RE ]] && ! is_shebang_code "$f"; then continue; fi
  if should_exclude "$f"; then continue; fi
  src_files+=("$f")
done <<< "$STAGED"

# Gate 2: 沒 code → 放行
[[ ${#src_files[@]} -eq 0 ]] && exit 0

# Gate 3: 有圖譜 .md staged → 放行(但先點名「該動卻沒動」的篇,2026-08-22)
if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
  sync_nudge staged
  exit 0
fi

# ── 印警告並擋 ──
{
  echo ""
  echo "擋下:這次 commit 改了程式碼,但知識筆記一個字都沒動。"
  echo "程式碼記的是「現在長怎樣」,筆記記的是「為什麼這樣做」——只改其中一邊,下一個人(或下一個 session 的 Claude)就會拿舊的理由去理解新的程式碼。"
  echo ""
  echo "這次改到的程式碼(${#src_files[@]} 個):"
  for f in "${src_files[@]:0:10}"; do echo "   • $f"; done
  if [[ ${#src_files[@]} -gt 10 ]]; then
    for k in ("claude/check-graph-sync.py", "claude/impact-hook.py"):
        src = (root / "hooks" / k).read_text(encoding="utf-8")
        check(f"code-exts: {k} 沒有殘留直譜器清單常數", "_SHEBANG_INTERPS" not in src and "_SHEBANG_HINTS" not in src, "")


def t_precommit_shebang_script_counts_as_code():
    """README 審視 d1(2026-09-05):只改沒副檔名的主程式(如 scripts/lumos,首行 #!/usr/bin/env python3)、不帶節點 → 源 repo 內 pre-commit 要擋;
    沒副檔名的純文字檔(NOTES)不算程式碼 → 放行。實證前:五月起 26 個只改 scripts/lumos 的 commit 全部放行。"""
    import subprocess, os, tempfile as _tf
    if not hasattr(os, "setsid"):
        print("  - skip(非 POSIX)"); return
    hook = Path(GRAPHCTL).resolve().parent / "hooks" / "pre-commit"
    def run(files):
        root = Path(_tf.mkdtemp(prefix="gctl-pcsb-"))
        subprocess.run(["git", "-C", str(root), "init", "-q"], capture_output=True)
        (root / "docs" / "x-knowledge").mkdir(parents=True); (root / "docs" / "x-knowledge" / ".keep").write_text("", encoding="utf-8")
        (root / "skills" / "lumos-project-notes").mkdir(parents=True)   # 源 repo 模式:vendored 白名單不豁免
        for rel, content in files.items():
            p = root / rel; p.parent.mkdir(parents=True, exist_ok=True); p.write_text(content, encoding="utf-8")
        subprocess.run(["git", "-C", str(root), "add", "-A"], capture_output=True)
        return subprocess.run(["bash", str(hook)], cwd=str(root), capture_output=True, text=True, env=dict(os.environ, GIT_DIR=str(root / ".git")))
    r1 = run({"scripts/lumos": "#!/usr/bin/env python3\nprint(1)\n"})
    check("precommit shebang: 只改無副檔名的 python 主程式、不帶節點 → 擋", r1.returncode != 0 and "擋下" in r1.stderr + r1.stdout, f"rc={r1.returncode} {(r1.stderr+r1.stdout)[-160:]}")
    r2 = run({"NOTES": "just prose\n", "bin/tool": "#!/bin/dash\necho hi\n"})
    check("precommit shebang: #!/bin/dash 也算程式碼 → 擋(r1 外家:直譯器清單漏 dash)", r2.returncode != 0, f"rc={r2.returncode}")
    r2b = run({"bin/tool2": "#!/usr/bin/env -S python3 -u\nprint(1)\n"})
    check("precommit shebang: env -S 形式也算 → 擋", r2b.returncode != 0, f"rc={r2b.returncode}")
    r2c = run({".pythonrc": "#!/usr/bin/env python3\nx=1\n"})
    check("precommit shebang: 只有開頭一個點的 dotfile 也看 shebang → 擋(通才 minor)", r2c.returncode != 0, f"rc={r2c.returncode}")
    r2d = run({'bin/weird"tool': "#!/bin/dash\necho\n"})
    check("precommit shebang: 檔名含雙引號(git 印成 C 式引號)也讀得到 → 擋(r2 delta major)", r2d.returncode != 0, f"rc={r2d.returncode} {(r2d.stderr+r2d.stdout)[-120:]}")
    r2e = run({"..foo": "#!/bin/sh\necho\n"})
    check("precommit shebang: 開頭兩個點的檔名也看 shebang → 擋", r2e.returncode != 0, f"rc={r2e.returncode}")
    r3 = run({"NOTES": "just prose\n", "Makefile": "all:\n\ttrue\n"})
    check("precommit shebang: 無副檔名純文字/Makefile 不算程式碼 → 放行", r3.returncode == 0, f"rc={r3.returncode} {(r3.stderr+r3.stdout)[-160:]}")


def t_merge_dedupes_preexisting_duplicates():
    """體檢 #1(2026-08-21):舊版安裝器留下同一 hook 兩份註冊(真機 settings.json 實證:
    verification-rot-check/check-graph-sync 各兩份,每次事件跑兩遍)。merger 每次執行都要自癒去重。"""
    import json, os, subprocess, sys
    fake_home = Path(tempfile.mkdtemp(prefix="gctl-dedupe-"))
    (fake_home / ".claude" / "hooks").mkdir(parents=True)
    (fake_home / ".claude" / "hooks" / "check-graph-sync.py").write_text("#!/usr/bin/env python3\n", encoding="utf-8")
    (fake_home / ".claude" / "hooks" / "verification-rot-check.py").write_text("#!/usr/bin/env python3\n", encoding="utf-8")
    settings = fake_home / ".claude" / "settings.json"

