     1	#!/bin/bash
     2	# 每日治理 wrapper:一個喚醒窗內「連續」跑 治理日報 → 自主迭代 loop → lint-watch 版本掃描。
     3	#
     4	# 為什麼合併:閉蓋(clamshell)的 Mac 幾乎一直在睡,launchd StartCalendarInterval
     5	# 不會把機器叫醒、且只在 FullWake 補跑 GUI agent。解法是用 pmset 每天叫醒「一次」:
     6	#   sudo pmset repeat wakeorpoweron MTWRFSU 09:28:00
     7	# 那一次喚醒只夠跑「一段連續工作」——分成 09:30 / 10:10 兩支,機器會在中間又睡著、
     8	# 第二支照樣漏。故把兩件事串成這一支,趁機器醒著一口氣跑完(腳本執行中系統不會 idle-sleep)。
     9	#
    10	# 由 launchd com.enzo.lumos.daily-governance(09:30)觸發。各子腳本仍各自寫自己的 log。
    11	# 第 3 步 lint-watch-check:每日查 linter 新版 → 候選暫存 governance/lint-upgrades/ + LINE 通知。
    12	set -uo pipefail   # 不用 -e:前一支失敗不擋後一支
    13	
    14	DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    15	ts() { date '+%Y-%m-%d %H:%M:%S'; }
    16	
    17	mkdir -p "$DIR/logs"
    18	
    19	echo "[$(ts)] daily-governance wrapper 開始"
    20	
    21	# 1) 治理日報(自設 PATH/token;log → governance.log)
    22	"$DIR/ai-governance-research.sh" >> "$DIR/logs/governance.log" 2>&1
    23	echo "[$(ts)] 治理日報 段結束 rc=$?"
    24	
    25	# 2) 自主迭代 loop(dry-run;log → autonomous.log)
    26	#    2026-09-05 暫停派工(README 審視 d3,見圖譜 Projects/README審視五修_計劃):七週週報收斂 0、待放行 0、每週 210–330 美元;
    27	#    dry-run 永遠走不到開 PR。開關沿用 repo 的 *_OFF 慣例,但預設 1(=暫停);要臨時開回:LUMOS_AUTOLOOP_OFF=0。REVISIT 2026-10-05 決定給它真產出路徑或正式退場。
    28	if [ "${LUMOS_AUTOLOOP_OFF:-1}" != "1" ]; then
    29	  "$DIR/autonomous-loop.sh" --dry-run 6 >> "$DIR/logs/autonomous.log" 2>&1
    30	  echo "[$(ts)] 自主 loop 段結束 rc=$?"
    31	else
    32	  echo "[$(ts)] 自主 loop 段暫停中(2026-09-05 d3;LUMOS_AUTOLOOP_OFF=0 可開回)" >> "$DIR/logs/autonomous.log" 2>&1
    33	  echo "[$(ts)] 自主 loop 段暫停中(2026-09-05 d3)"
    34	fi
    35	
    36	# 3) lint-watch 版本掃描(fail-open;log → lint-watch.log)
    37	"$DIR/lint-watch-check.sh" >> "$DIR/logs/lint-watch.log" 2>&1; rc=$?
    38	echo "[$(ts)] lint-watch 段結束 rc=$rc"
    39	
    40	# 4) doctor 每日跑(fail-open;log → doctor-daily.log)
    41	# intake守衛 T4 排程線(2026-08-30 d1,外家 r3 唯一補件):T4 的滾動窗計數器住在 doctor 的
    42	# [I] 段;此前 doctor 只在 push/CI 跑——「doctor 每天跑」曾是未查證的假宣稱,這行讓它成真。
