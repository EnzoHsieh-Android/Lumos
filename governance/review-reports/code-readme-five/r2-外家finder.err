 25164	def _load_hook_mod(name, fname):
 25165	    import importlib.util
 25166	    from importlib.machinery import SourceFileLoader
 25167	    hook_path = str(Path(__file__).resolve().parent / "hooks" / "claude" / fname)
 25168	    loader = SourceFileLoader(name, hook_path)
 25169	    spec = importlib.util.spec_from_loader(name, loader)
 25170	    m = importlib.util.module_from_spec(spec); loader.exec_module(m)
 25171	    return m
