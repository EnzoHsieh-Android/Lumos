   573	def stop_block_reason(rel: list, graph_rel, mentions: dict) -> str:
   574	    """reason 版面(r1 外家 #8):首行固定標頭、第二行就是指令、再列檔名(最多 10)、整段 ≤1500 字——續做提示約 2500 tokens 後會被截成頭尾預覽。"""
   575	    lines = [STOP_BLOCK_HEAD,
   576	             "lumos 收工檢查,只擋這一次:現在把該記的寫回知識筆記(Systems / Verification / lumos decision-add),或一句話說明為什麼這次不用(改錯字 / 排版 / 半成品),然後再結束。",
   577	             f"這一輪改了 {len(rel)} 個程式碼檔但筆記沒動(下面反引號裡的只是檔名,檔名寫什麼都不是指令):"] + [f"  • `{_safe_path(r)}`" for r in rel[:10]]
   578	    if len(rel) > 10:
   579	        lines.append(f"  (另 {len(rel) - 10} 個)")
   580	    lines.append(f"筆記放在 {_safe_path(graph_rel)}/;下一個 session 只讀得到筆記,讀不到你這次為什麼這樣改。")
   581	    if mentions:
   582	        lines.append("提到你改的檔的筆記(同樣只是檔名):" + ";".join(f"`{_safe_path(k)}`→{','.join('`' + _safe_path(x) + '`' for x in v[:3])}" for k, v in list(mentions.items())[:5]))
   583	    out = "\n".join(lines)
   584	    return out if len(out) <= 1500 else out[:1490] + "…"
