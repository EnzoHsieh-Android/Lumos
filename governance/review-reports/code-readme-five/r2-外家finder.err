   567	def _safe_path(p) -> str:
   568	    """reason 會變成 Codex 的下一個 user prompt(r1 通才 F3):檔名來自工作樹,不信任 repo 的檔名不能夾帶換行/控制字元進提示。"""
   569	    s = "".join(ch for ch in str(p) if ch.isprintable() and ch not in "\r\n")
   570	    return s.replace("`", "'")[:160]   # r2 delta #2:反引號會跳出 code span,換成單引號
   571	
