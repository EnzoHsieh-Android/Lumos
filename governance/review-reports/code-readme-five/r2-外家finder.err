   528	def stop_block_decision(payload: dict, session_id: str) -> bool:
   529	    """要不要對這次 Stop 回 block(兩家同一份邏輯):沒設 LUMOS_STOP_BLOCK_OFF、這輪還沒被續做過、本 session 還沒擋過。
   530	    ★名額先佔再擋(code-codex-refine r1 外家 #1/#4):回 True 表示標記檔已用 O_EXCL 建成——建不成(已存在 / 目錄寫不進 / 唯讀檔案系統)
   531	    一律 False,所以「同 session 兩個 Stop 同時來」只有一個擋、「cache 寫不進」永遠不擋,不會每輪都擋。"""
   532	    if os.environ.get("LUMOS_STOP_BLOCK_OFF") == "1":
   533	        return False
   534	    if payload.get("stop_hook_active"):
   535	        return False
   536	    if not session_id:
   537	        return False
   538	    return _stop_mark_write(session_id)
   539	
   540	
   541	def _stop_mark_path(session_id: str):
   542	    """標記檔路徑;消毒後是空字串、"." 或 ".." 回 None(正確性席 F3:Path 語意會讓 "." 永遠「存在」而悄悄關掉擋停)。"""
   543	    name = re.sub(r"[^A-Za-z0-9_.-]", "_", session_id)[:120]
   544	    if name in ("", ".", ".."):
   545	        return None
   546	    return _stop_block_dir() / name
   547	
   548	
   549	def _stop_mark_write(session_id: str) -> bool:
   550	    """O_EXCL 原子建檔佔名額(兩個 hook 同時來只有一個成功);任何 OSError 都回 False=不擋(寧可漏)。"""
   551	    mp = _stop_mark_path(session_id)
   552	    if mp is None or not _stop_dir_ok(mp.parent):
   553	        return False
   554	    try:
   555	        fd = os.open(str(mp), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
   556	    except OSError:
   557	        return False
   558	    try:
   559	        os.write(fd, str(time.time()).encode("utf-8"))
   560	    except OSError:
   561	        pass          # 名額已佔(檔已建成),寫內容失敗不影響
   562	    finally:
   563	        os.close(fd)  # 正確性席 F2:fd 不漏
   564	    return True
   565	
