   534	def stop_block_decision(payload: dict, session_id: str) -> bool:
   535	    """要不要對這次 Stop 回 block(兩家同一份邏輯):沒設 LUMOS_STOP_BLOCK_OFF、這輪還沒被續做過、本 session 還沒擋過。
   536	    ★名額先佔再擋(code-codex-refine r1 外家 #1/#4):回 True 表示標記檔已用 O_EXCL 建成——建不成(已存在 / 目錄寫不進 / 唯讀檔案系統)
   537	    一律 False,所以「同 session 兩個 Stop 同時來」只有一個擋、「cache 寫不進」永遠不擋,不會每輪都擋。"""
   538	    if os.environ.get("LUMOS_STOP_BLOCK_OFF") == "1":
   539	        return False
   540	    if payload.get("stop_hook_active"):
   541	        return False
   542	    if not session_id:
   543	        return False
   544	    return _stop_mark_write(session_id)
