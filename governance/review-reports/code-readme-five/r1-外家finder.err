  5531	def t_precommit_shebang_script_counts_as_code():
  5532	    """README 審視 d1(2026-09-05):只改沒副檔名的主程式(如 scripts/lumos,首行 #!/usr/bin/env python3)、不帶節點 → 源 repo 內 pre-commit 要擋;
  5533	    沒副檔名的純文字檔(NOTES)不算程式碼 → 放行。實證前:五月起 26 個只改 scripts/lumos 的 commit 全部放行。"""
  5534	    import subprocess, os, tempfile as _tf
  5535	    if not hasattr(os, "setsid"):
  5536	        print("  - skip(非 POSIX)"); return
  5537	    hook = Path(GRAPHCTL).resolve().parent / "hooks" / "pre-commit"
  5538	    def run(files):
  5539	        root = Path(_tf.mkdtemp(prefix="gctl-pcsb-"))
  5540	        subprocess.run(["git", "-C", str(root), "init", "-q"], capture_output=True)
  5541	        (root / "docs" / "x-knowledge").mkdir(parents=True); (root / "docs" / "x-knowledge" / ".keep").write_text("", encoding="utf-8")
  5542	        (root / "skills" / "lumos-project-notes").mkdir(parents=True)   # 源 repo 模式:vendored 白名單不豁免
  5543	        for rel, content in files.items():
  5544	            p = root / rel; p.parent.mkdir(parents=True, exist_ok=True); p.write_text(content, encoding="utf-8")
  5545	        subprocess.run(["git", "-C", str(root), "add", "-A"], capture_output=True)
  5546	        return subprocess.run(["bash", str(hook)], cwd=str(root), capture_output=True, text=True, env=dict(os.environ, GIT_DIR=str(root / ".git")))
  5547	    r1 = run({"scripts/lumos": "#!/usr/bin/env python3\nprint(1)\n"})
  5548	    check("precommit shebang: 只改無副檔名的 python 主程式、不帶節點 → 擋", r1.returncode != 0 and "擋下" in r1.stderr + r1.stdout, f"rc={r1.returncode} {(r1.stderr+r1.stdout)[-160:]}")
  5549	    r2 = run({"NOTES": "just prose\n", "bin/tool": "#!/bin/sh\necho hi\n"})
  5550	    check("precommit shebang: /bin/sh 腳本也算程式碼 → 擋", r2.returncode != 0, f"rc={r2.returncode}")
  5551	    r3 = run({"NOTES": "just prose\n", "Makefile": "all:\n\ttrue\n"})
  5552	    check("precommit shebang: 無副檔名純文字/Makefile 不算程式碼 → 放行", r3.returncode == 0, f"rc={r3.returncode} {(r3.stderr+r3.stdout)[-160:]}")
