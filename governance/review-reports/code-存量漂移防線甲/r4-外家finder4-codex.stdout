 def _git_log_sha_paths(raw):
     """git log -z --format=%H --name-only 的輸出 →[(sha, 那時的路徑)]。
-    格式是「sha\0\n路徑\0」一筆接一筆(實測;換行黏在路徑前面)。"""
+    格式是「sha\\0\\n路徑\\0」一筆接一筆(實測;換行黏在路徑前面)。"""
     pairs, cur = [], None
     for tok in raw.decode("utf-8", errors="surrogateescape").split("\0"):
         tok = tok.strip("\n")
         if not tok:
             continue
         if cur is None and _LENS_SHA_RE.fullmatch(tok):
             cur = tok
         elif cur is not None:
             pairs.append((cur, tok))
             cur = None
     return pairs
 
 
