 25303	def _drift_linked(env, rel):
 25304	    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
 25305	    out_e, in_e = env.edges
 25455	    wv = _vault_in(Path(root))
 25456	    try:
 25457	        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
 25458	    except ValueError:
 25459	        wv_rel = None
 25460	    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 25461	
