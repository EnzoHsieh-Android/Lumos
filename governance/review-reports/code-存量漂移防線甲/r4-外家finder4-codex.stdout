 25531	def _drift_load_acks(root, where=None):
 25532	    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
 25533	    import json as _j
 25534	    raw = None
 25535	    if where is None:
 25536	        fp = Path(root) / _DRIFT_ACKS
 25537	        try:
 25538	            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
 25539	        except OSError:
 25540	            raw = None
 25635	    try:
 25636	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 25637	    except (ValueError, UnicodeDecodeError):
 25638	        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"]
 25639	    dc = cfg.get("drift_check") if isinstance(cfg, dict) else None
 25640	    if dc is not None and not isinstance(dc, dict):
 25641	        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
 25642	                                     f"照預設 {_DRIFT_DEFAULT_GATE}"]
 25643	    g = dc.get("gate") if isinstance(dc, dict) else None
 25644	    if g is None:
 25645	        return _DRIFT_DEFAULT_GATE, []
 25646	    if g not in _DRIFT_GATE_VALUES:
 25647	        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"]
 25648	    return g, []
 25649	
