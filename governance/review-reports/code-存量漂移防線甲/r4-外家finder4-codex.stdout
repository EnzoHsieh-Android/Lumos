# ── 考試 ─────────────────────────────────────────────────────────────────────────────

def _drift_set_status_text(text, status):
    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    if not e:
        return text
    fm = edit_fm_scalar(lines[1:e], "status", status)
    fm, _s = edit_fm_sync_status_tag(fm, status)
    return "\n".join(lines[:1] + fm + lines[e:])


def _drift_exam_one(root, vault_rel, q, at_sha):
    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
    ev = q.get("exam_event")
    note = q.get("note_at_event") or q.get("note")
    line = q.get("line")
    if not q.get("note") or not isinstance(line, int):
        return "略過:題目缺 note 或 line", 0, 0, 0
    if ev == "current_state":
        tenv = _drift_tree_env(root, at_sha, vault_rel)
        if tenv is None:
            return "略過:git 讀不出樹", 0, 0, 0
        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
        return ("誤列" if hit else "沒誤列"), 0, 0, 0
    commits = q.get("invalidating_commits") or []
    if ev not in ("commit", "status_replay") or not commits:
        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
    c = _lens_full_sha(root, commits[0])
    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
    if c is None or par is None:
        return "略過:找不到失效提交或它的上一版", 0, 0, 0
    vault_rel = _drift_vault_rel(root, c) or vault_rel      # 那個提交自己的圖譜位置(代碼審 r1 外家席)
    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
    hit_kind = next((f["kind"] for f in must + listed
                     if f["path"] == note and (f["line"] == line or ev == "status_replay")), None)
    others_m = _drift_exam_others(must, note, line, hit_kind)
    others_l = _drift_exam_others(listed, note, line, hit_kind)
    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
    in_must = any(f["path"] == note and f["line"] == line for f in must)
    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
    if ev == "status_replay":
        fu = _drift_exam_replay(root, par, _drift_vault_rel(root, par) or vault_rel, q.get("status_targets") or [])
        if fu is None:
            return "略過:git 讀不出上一版", 0, 0, 0
        in_list = in_list or note in fu
    res = "擋到" if in_must else ("點到" if in_list else "漏")
    return res, len(others_m), len(others_l), noise


def _drift_exam_replay(root, par, vault_rel, targets):
    """status_replay:取上一版的樹,在記憶體裡把 targets 每一份計劃改成 done,回 lumos set 會列的連帶待辦路徑集合。"""
    tenv0 = _drift_tree_env(root, par, vault_rel)
    if tenv0 is None:
        return None
    texts = {}
    for t in targets:
        prel = tenv0.resolve(link_target(t))
        if prel:
            texts[prel] = _drift_set_status_text(env_text(tenv0, prel), "done")
    tenv = _drift_tree_env(root, par, vault_rel, override=texts)
    fu = set()
    for prel in texts:
        fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
    return fu


def _drift_exam_others(findings, note, line, kind):
    """考題那一行以外、算誤報的發現:排除題目那一行,以及同一篇同一種的兄弟句(c1 一句一筆,同一個轉正事件的
    另外幾句預告句是真發現,不是亂抓);同一篇別種的、別篇的都算(代碼審 r1 外家席:原本同一篇全部排除,誤報被低估)。"""
    return [f for f in findings if not (f["path"] == note and (f["line"] == line or (kind and f["kind"] == kind)))]


def cmd_drift_exam(exam, repo, at=None, history=None, as_json=False):
    """lumos drift exam <考卷.json> --repo <被考的 repo>:在被考 repo 的歷史上重放(計劃〈做法〉第 3 節)。
    不寫治理帳、不寫任何檔。--history N:改成對被考 repo 最近 N 個主線提交各跑一次 check,列出每筆要處理(門檻②)。"""
    import json as _j
    root = Path(repo).resolve()
    at_sha = _lens_full_sha(root, at or "HEAD")
    if at_sha is None:
        print(f"擋下:{repo} 找不到 {at or 'HEAD'}", file=sys.stderr)
        return 2
    vault_rel = _drift_vault_rel(root, at_sha)
    if vault_rel is None:
        print(f"擋下:{repo} 沒有圖譜", file=sys.stderr)
        return 2
    if history:
        return _drift_exam_history(root, vault_rel, at_sha, history, as_json)
    qs = _drift_exam_load(exam)
    if qs is None:
        return 2
    rows, skipped = [], 0
    for q in qs:
        if q.get("exam_event") == "mechanism1_experiment":
            skipped += 1
            continue
        res, om, ol, noise = _drift_exam_one(root, vault_rel, q, at_sha)
        rows.append({"id": q.get("id"), "event": q.get("exam_event"), "result": res,
                     "other_must": om, "other_listed": ol, "noise": noise})
    summ = {"擋到": 0, "點到": 0, "漏": 0, "誤列": 0, "沒誤列": 0, "略過": 0}
    for r in rows:
        summ["略過" if r["result"].startswith("略過") else r["result"]] += 1
    tot = {"skipped_mechanism1": skipped, "summary": summ,
           "誤報_要處理": sum(r["other_must"] for r in rows), "誤報_只列出": sum(r["other_listed"] for r in rows),
           "噪音最大": max([r["noise"] for r in rows] or [0]), "rows": rows}
    if as_json:
        print(_j.dumps(tot, ensure_ascii=False, indent=1))
        return 0
    print(f"略過 {skipped} 題(機制①,給實驗計劃)")
    print("題號  考法            結果        誤報(要處理/只列出)  噪音")
    for r in rows:
        print(f"{r['id']:<5} {r['event']:<15} {r['result']:<10}  {r['other_must']}/{r['other_listed']}"
              f"{'':<16}{r['noise']}")
    print("合計:" + "、".join(f"{k} {v}" for k, v in summ.items())
          + f";誤報 要處理 {tot['誤報_要處理']}、只列出 {tot['誤報_只列出']};單一提交噪音最大 {tot['噪音最大']}")
    return 0


def _drift_exam_load(exam):
    """考卷 → 題目清單;讀不了或有不認得的考法回 None(已印原因)。"""
    import json as _j
    try:
        qs = _j.loads(Path(exam).read_text(encoding="utf-8"))
    except (OSError, ValueError) as ex:
        print(f"擋下:考卷讀不了:{ex}", file=sys.stderr)
        return None
    if isinstance(qs, dict):
        qs = qs.get("items") or []
    # ★形狀先驗★(代碼審 r1 邊界席:純量或字串清單原本直接丟 Python 例外)
    if not isinstance(qs, list) or not all(isinstance(q, dict) for q in qs):
        print("擋下:考卷要是一個題目清單(每題一個物件),或 {\"items\": [...]}", file=sys.stderr)
        return None
    known = ("commit", "status_replay", "probe", "current_state", "mechanism1_experiment")
    bad = sorted({str(q.get("exam_event")) for q in qs if q.get("exam_event") not in known})
    if bad:
        print(f"擋下:考卷裡有不認得的考法 {bad}", file=sys.stderr)
        return None
    return qs


def _drift_exam_history(root, vault_rel, at_sha, n, as_json):
    """門檻②:被考 repo 最近 n 個主線提交各跑一次 check(父..提交),每筆要處理列出來給人逐筆判真假。"""
    import json as _j
    rl = _lens_git(root, "rev-list", "--first-parent", f"--max-count={int(n)}", at_sha)
    if rl is None or rl.returncode != 0:
        print("擋下:git 列不出提交", file=sys.stderr)
        return 2
    out = []
    for c in rl.stdout.split():
        par = _lens_full_sha(root, f"{c}^")
        if par is None:
            continue
        must, listed, unknown = _drift_check_core(root, par, c, _drift_vault_rel(root, c) or vault_rel)
        if must or unknown:
            out.append({"commit": c[:10], "must": [f"{f['kind']} {f['path']}:{f['line']} {f['text'][:50]}" for f in must],
                        "unknown": unknown, "listed": len(listed),
                        "noise": len({f['path'] for f in must if f['kind'] == 'c1'}) + sum(1 for f in must if f['kind'] != 'c1')})
    if as_json:
        print(_j.dumps({"commits": int(n), "with_must": out}, ensure_ascii=False, indent=1))
        return 0
    print(f"最近 {n} 個主線提交裡,有要處理的 {len(out)} 個(每筆要人判真假):")
    for r in out:
        print(f"  {r['commit']}  噪音 {r['noise']}" + (f"  判不了:{';'.join(r['unknown'])}" if r["unknown"] else ""))
        for m in r["must"]:
            print(f"      {m}")
    return 0


def cmd_decision_amend(env, rel, did, field, text):
    """lumos decision-amend <節點> <決策編號> --field <欄名> --text "<新文字>"(計劃〈做法〉第 3 節第 4 點):
    只改還沒推上去的決策的一個文字子欄。先 fetch 所有遠端,再對每個遠端追蹤參照用改名偵測找這篇的舊路徑:
    那個版本裡有這個決策編號就拒絕(已推或撞號,兩種都講)。"""
    if field in ("id", "decided", "valid", "superseded_by", "ended", "decided_by", "replaces"):
        raise ValueError(f"「{field}」是結構欄,不能用 decision-amend 改;要翻案用 decision-supersede")
    if not re.fullmatch(r"d\d+", did or ""):
        raise ValueError("決策編號要寫成 d1、d2 這種形狀")
    path = env.vault / rel
    top = _lens_git(env.vault, "rev-parse", "--show-toplevel")
    if top is None or top.returncode != 0 or not top.stdout.strip():
        raise ValueError("這篇筆記不在 git 專案裡")
    root = Path(top.stdout.strip())
    rels = path.resolve().relative_to(root.resolve()).as_posix()
    # 改名偵測的路徑篩選給整個圖譜夾:只給新路徑的話舊路徑不在篩選裡,git 認不出改名
    vrel = env.vault.resolve().relative_to(root.resolve()).as_posix()
    rm = _lens_git(root, "remote")
14531:        deadline = _t.monotonic() + 60
25695:                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
26740:        deadline = float(os.environ.get("LUMOS_DELGUARD_DEADLINE", "15.0"))  # 5.0 在本 repo(377 篇+大 diff)仍常超,2026-08-27 一 session 降級多次→15;advisory fail-open,pre-commit 多等幾秒換掃完整
26742:        deadline = 15.0   # s1-f2:兜底跟預設一致(原 2.0,主值調 15 後落差 7.5 倍→非數值 env 悄悄退化只給 2 秒)
28346:    deadline = time.time() + float(timeout)
31374:        deadline = _t0 + _LENS_INNER_BUDGET - _LENS_FALLBACK_RESERVE
    rm = _lens_git(root, "remote")
    remotes = [x for x in (rm.stdout.split() if rm is not None and rm.returncode == 0 else []) if x]
    if remotes:
        f = _lens_git(root, "fetch", "--all", "--quiet")
        if f is None or f.returncode != 0:
            raise ValueError("git fetch --all 失敗(沒網路或遠端要驗證),確認不了這條決策有沒有推上去,不改。"
                             + ((" " + f.stderr.strip()[:200]) if f is not None else ""))

        def _dec_item(text_):
            fm_, _b = split_frontmatter(text_)
            for d_ in (parse_decisions(fm_) if fm_ else []):
                if str(d_.get("id", "")).strip() == did:
                    return d_
            return None
        try:
            local_item = _dec_item(path.read_text(encoding="utf-8-sig"))
        except (OSError, UnicodeDecodeError):
            local_item = None

        def _same_decision(d_):
            # 決策編號每篇都從 d1 起,只比編號會把別篇的 d1 當成這條;要「除了要改的那欄,其他欄都一樣」才算同一條
            if d_ is None or local_item is None:
                return False
            keys = (set(d_) | set(local_item)) - {field}
            return all(str(d_.get(k, "")).strip() == str(local_item.get(k, "")).strip() for k in keys)
        refs = _lens_git(root, "for-each-ref", "--format=%(refname)", "refs/remotes")
        for ref in (refs.stdout.split() if refs is not None and refs.returncode == 0 else []):
            if ref.endswith("/HEAD"):
                continue
            # 跟工作目錄比(不是 HEAD、也不只暫存區):還沒提交的 git mv、只暫存新檔的搬檔都認得出改名(代碼審 r1、r2)
            ns = _ns_git(root, "diff", "--name-status", "-z", "-M", ref, "--", vrel)
            if ns is None:
                raise ValueError(f"git 比不出 {ref} 跟工作目錄的差異,確認不了這條決策有沒有推上去,不改")
            toks, renames, pure_del, k = _nodehome_split_z(ns), {}, [], 0
            while k < len(toks):
                st = toks[k]
                if st[:1] in ("R", "C") and k + 2 < len(toks):
                    renames[toks[k + 2]] = toks[k + 1]
                    k += 3
                    continue
                if st == "D" and k + 1 < len(toks):
                    pure_del.append(toks[k + 1])
                k += 2
            old = renames.get(rels, rels)
            blobs = _nodehome_cat_blobs(root, [f"{ref}:{old}"] + [f"{ref}:{q}" for q in pure_del]) or []
            if blobs and blobs[0] is not None:
                if re.search(rf"^\s*(?:-\s+)?id:\s*{re.escape(did)}\s*$", blobs[0].decode("utf-8", errors="replace"), re.M):
                    raise ValueError(f"遠端 {ref} 上的這篇已經有決策 {did}:可能①已經推上去了——請用 "
                                     f"lumos decision-supersede 翻案;或②兩條分支撞號——請先把你的決策改號")
            # git 配不成改名的搬檔(新檔沒進 git、或改寫太多相似度不夠):遠端上在工作目錄不見的筆記裡,
            # 有一條跟這條一模一樣的決策,就當它是這篇改名前的樣子(代碼審 r3 兩席、驗收輪兩席)
            for q, bq in zip(pure_del, blobs[1:]):
                if bq is not None and _same_decision(_dec_item(bq.decode("utf-8", errors="replace"))):
                    raise ValueError(f"遠端 {ref} 上的 {q} 在工作目錄不見了,而它有一條跟這條一模一樣的決策 {did}:多半是這篇"
                                     "改名前的樣子、已經推上去了——請用 lumos decision-supersede 翻案;如果不是,先 git add "
                                     "新舊兩邊(或用 git mv)讓 git 認出改名")
    lines, _s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    if loc is None or not loc[2]:
        raise ValueError("這篇筆記沒有讀得出的決策紀錄(decisions)")
    _s, _e, items, _ii, sub = loc
    pad = " " * sub
    hit = [(st, en) for st, en in items
           if any(re.match(rf"^\s*(?:-\s+)?id:\s*{re.escape(did)}\s*$", fm[i]) for i in range(st, en + 1))]
    if not hit:
        raise ValueError(f"找不到決策 {did}")
    st, en = hit[0]
    k0 = next((i for i in range(st, en + 1) if re.match(rf"^(?:{pad}|\s*-\s+){re.escape(field)}:", fm[i])), None)
    if k0 is None:
        raise ValueError(f"決策 {did} 沒有欄位 {field}")
    def _ind(s):
        return len(s) - len(s.lstrip(" "))
    k1 = k0
    j = k0 + 1
    while j <= en:
        if not fm[j].strip():
            # 空行:後面還有比欄位深的行就算同一欄(多行值中間的空段落;代碼審 r1 正確性席:原本停在空行,後半段留在檔裡)
            nxt = next((q for q in range(j + 1, en + 1) if fm[q].strip()), None)
            if nxt is None or _ind(fm[nxt]) <= sub:
                break
            j += 1
            continue
        if _ind(fm[j]) <= sub:
            break
        k1 = j
        j += 1
    head_val = fm[k0].split(":", 1)[1].strip()
    # 冒號後是空的=清單(或巢狀、空值;parse_decisions 也讀成清單),[ { 開頭=一行式清單或對照表(YAML 讀成清單或對照表);
    # 只有一般文字與 | > 多行文字能改(代碼審 r1、r2 外家席:原本會靜默把清單壓成一句)
    if not head_val or head_val.startswith(("[", "{")):
        raise ValueError(f"決策 {did} 的「{field}」是清單、巢狀或空的欄位,decision-amend 只改一段文字的欄位")
    lead = fm[k0][:fm[k0].index(field)]
    newtxt = text.replace("\n", " ").strip()
    new_fm = [*fm[:k0], f"{lead}{field}: {_fmt_decision_value(newtxt)}", *fm[k1 + 1:]]
    new_lines = lines[:1] + new_fm + lines[e_fm:]

    def _check(_fields):
        for d in parse_decisions(_fm_of(new_lines)):
            if str(d.get("id", "")).strip() == did:
                return nfc(str(d.get(field, ""))).strip() == nfc(newtxt)
        return False
    atomic_write_verify(path, new_lines, "decisions", _check)
    print(f"✓ decision-amend {rel} {did}.{field} 改好了(這條決策還沒推上去)")
    return 0


def _ci_strip_comment(line):
    """切掉不在引號裡的行尾註解(` #…`);引號裡的 # 保留(驗收輪通才席:註解裡有撇號時原本整段保留)。"""
    q = None
    for i, ch in enumerate(line):
        if q:
            if ch == q:
                q = None
        elif ch in ("'", '"'):
            q = ch
        elif ch == "#" and i > 0 and line[i - 1] in " \t":
            return line[:i].rstrip()
    return line


def _ci_workflow_texts(ymls):
    """CI 設定檔 → [(路徑, 去掉註解後的行)]:整行註解拿掉、行尾註解(後面沒有引號的 ` #…`)切掉;讀不了的檔跳過。
    兩層 doctor 都經這裡讀,容錯跟「哪些算註解」只有一份(筆記內容審代碼審 r3 架構對齊席、通才席)。"""
    out = []
    for p in ymls:
        try:
            raw = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        out.append((p, [_ci_strip_comment(ln) for ln in raw.split("\n") if not ln.lstrip().startswith("#")]))
    return out


def _ci_jobs_calling_without_full_history(ymls, needle):
    """GitHub Actions 設定裡,呼叫 needle 的工作項目中,沒設 fetch-depth: 0 的那些 → [(檔名, 工作項目名)]。
    照工作項目切,不看整份:別的工作項目設了完整歷史,不代表呼叫這道檢查的那個有(筆記內容審代碼審 r2 外家席)。
    工作項目=jobs: 底下第一層縮排的每一個鍵(名字可加引號、行尾可帶註解;代碼審 r3 兩席:原本只認不帶引號、
    冒號後什麼都沒有的鍵,合法寫法就會漏)。"""
    out = []
    for p, lines in _ci_workflow_texts(ymls):
        jobs, cur, jind, in_jobs = {}, None, None, False
        for ln in lines:
            if not ln.strip():
                continue
            ind = len(ln) - len(ln.lstrip(" "))
            if ind == 0:
                in_jobs = bool(re.match(r"^jobs\s*:\s*$", ln))
                jind, cur = None, None
                continue
            if not in_jobs:
                continue
            if jind is None:
                jind = ind
            if ind == jind:
                m = re.match(r"^\s+([\"']?)(.+?)\1\s*:", ln)
                cur = m.group(2) if m else ln.strip()
                jobs.setdefault(cur, [])
                continue
            if cur is not None:
                jobs[cur].append(ln)
        for name, body in jobs.items():
            if needle in "\n".join(body) and not _ci_has_full_history(body):
                out.append((p.name, name))
    return out


def _ci_has_full_history(body):
    """工作項目裡有沒有 `fetch-depth: 0` 這個設定——只認設定行本身,多行腳本(`run: |`)裡剛好出現的字樣不算
    (驗收輪外家席:腳本裡 echo 那串字就被當成抓了完整歷史)。"""
    blk = None
    for ln in body:
        ind = len(ln) - len(ln.lstrip(" "))
        if blk is not None:
            if ind > blk:
                continue
            blk = None
        if re.search(r":\s*[|>][-+0-9]*\s*$", ln):
            blk = ind
            continue
        if re.match(r"^\s*(?:-\s+)?fetch-depth\s*:\s*[\"']?0[\"']?\s*$", ln):
            return True
    return False


def _ci_jobs_list(pairs, limit=5):
    return "、".join(f"{f} 的 {j}" for f, j in pairs[:limit]) + (f" 等 {len(pairs)} 個" if len(pairs) > limit else "")


def _note_audit_doctor_lines(repo_root, vault, ci=False):
    """doctor 的筆記內容審提醒(計劃 S16):開關不是 block、專案 CI 沒呼叫 note-audit check(跳過註解行)、
    事後掃描遠端頂端沒被涵蓋的新增筆記行、主線歷史裡判定檔被刪過幾次。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, _w = _note_audit_config(txt)
    if mode != "block":
        out.append(f"這個專案把「筆記內容審」設成 {mode}(.lumos/config.json 的 note_audit.gate)——新寫的筆記不會被判定者審")
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
    wired = hk is not None and hk.returncode == 0 and _NOTE_AUDIT_GOLIVE_MARK in hk.stdout
    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
    shallow = _ci_jobs_calling_without_full_history(ymls, "note-audit check")
    if shallow:
        out.append("專案 CI 呼叫了 note-audit check,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
                   + _ci_jobs_list(shallow))
    if ymls and wired:          # 還沒接線(推送前掛鉤裡沒有這道)就不唸 CI 沒呼叫——接線前這道本來就不擋
        if "note-audit check" not in body:
            out.append("專案 CI 沒呼叫 `lumos note-audit check`,`--no-verify` 推上去的筆記沒人審——CI 在 note-shape 那步後面加:"
                       "\n    - run: python3 scripts/lumos note-audit check --diff \"${{ github.event.before || "
                       "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"")
    if ci:
        return out
    ml = _mainline_ref(root, remote_only=True)
    # 刪除次數從遠端頂端讀(計劃〈做法〉第 3 節第 9 點;代碼審 r1 正確性席:讀本機 HEAD 會把還沒推的實驗算進去)
    dl = _lens_git(root, "log", "--diff-filter=D", "--format=%H", "--name-only", ml[1], "--", _NOTE_AUDIT_VERDICT_DIR) if ml else None
    if dl is not None and dl.returncode == 0:
        n = sum(1 for x in dl.stdout.splitlines() if x.startswith(_NOTE_AUDIT_VERDICT_DIR + "/"))
        if n:
            out.append(f"主線歷史裡判定檔被刪過 {n} 次(筆記內容審只防疏忽,刪判定檔屬存心繞過;這個數給 RETIRE-IF 看)")
    gl = _nodehome_golive(root, ml[1], _NOTE_AUDIT_GOLIVE_MARK, _NOTELINES_PREPUSH) if ml else None
    if not ml or gl is None:
        return out
    try:
        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return out
    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{ml[1]}")
    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
    base = gl
    if capped:
        rl = _lens_git(root, "rev-list", f"--max-count={_NS_DOCTOR_SCAN_CAP}", f"{gl}..{ml[1]}")
        tail = rl.stdout.split()[-1] if rl is not None and rl.returncode == 0 and rl.stdout.split() else None
        if tail:
            b2 = _lens_full_sha(root, f"{tail}~1")
            base = b2 or gl
        out.append(f"(筆記內容審的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交)")
    got = _note_audit_items(root, base, ml[1], vault_rel)
    if got is None:
        return out
    items, _e = got
    docs, _b = _note_audit_load_verdicts(root, ml[1])
    fold = _note_audit_fold(docs)
    left = [it for it in items if not _note_audit_covered(fold.get(it["id"]))]
    if left:
        shown = "; ".join(f"{it['path']}:{it['line']}" for it in left[:10])
        out.append(f"已推上遠端({ml[0]})卻沒被筆記內容審涵蓋的新增筆記行 {len(left)} 行(多半是 --no-verify 或 warn 期間):{shown}")
    return out


# ── cochange:co-change 漏改守衛(vault-free;borrow-design ROSE error-prevention) ──
# 規則:conf(A⇒B)=shared/freq(A)(非對稱條件機率,ROSE TSE 2005 §5);support=絕對共改次數。
# 設計 spec:docs/lumos-toolchain-knowledge/Projects/cochange守衛_計劃.md

_COCHANGE_DEFAULTS = {"min_support": 3, "min_confidence": 0.8, "max_changeset": 20}
_COCHANGE_DEFAULT_EXCLUDE = [
    "docs/.governance-log.jsonl", "docs/.bypass-log.jsonl", "docs/.ci-log.jsonl",
    "docs/.canary-log.jsonl", "docs/.rot-queue.jsonl", "docs/.kill-log.jsonl",
    "docs/.signoff-log.jsonl", "docs/.usage-log.jsonl",
    "**/*-lock.json", "**/*.lock", "**/node_modules/**", "**/dist/**",
    "**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs",
]


def _cochange_repo_root(repo):
    """repo root:--repo 指定則驗證之,否則 cwd 逐層向上找 .git。找不到回 None。"""
    if repo:
        p = Path(repo).resolve()
        return p if (p / ".git").exists() else None
    p = Path.cwd()
    for cand in (p, *p.parents):
        if (cand / ".git").exists():
            return cand
    return None


def _cochange_load_config(repo_root, cfg=None):
    """讀 .lumos/cochange.json。fail-open(借 impact.json 的 rc 語意+額外一行提示):
    缺檔/壞 JSON → 預設值 + note;min_support 硬底線 2(設 1 視為 2 + note)。
    notes 由呼叫端印到 stdout(走 stderr 會被 pre-commit hook 的 2>/dev/null 吞掉)。"""
    import json
    _given = cfg
    cfg = dict(_COCHANGE_DEFAULTS)
    exclude = list(_COCHANGE_DEFAULT_EXCLUDE)
    notes = []
    p = Path(repo_root) / ".lumos" / "cochange.json"
    if _given is not None or p.exists():   # cfg 給了(dict)就不讀磁碟(dispatch-lens v1.2 base 版設定);型別守衛與 min_support 底線照走
        try:
            data = _given if _given is not None else json.loads(p.read_text(encoding="utf-8"))
            if not isinstance(data, dict):
                raise ValueError("內容要是一個 JSON 物件")
            for k in ("min_support", "min_confidence", "max_changeset"):
                if k in data:
                    cfg[k] = data[k]

