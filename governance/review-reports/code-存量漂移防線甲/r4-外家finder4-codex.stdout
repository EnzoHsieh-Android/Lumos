 25672	def cmd_drift_check(repo=None, diff_range=None):
 25673	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 25674	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
 25675	    import time as _t
 25676	    root = _note_audit_root(repo)
 25677	    if root is None:
