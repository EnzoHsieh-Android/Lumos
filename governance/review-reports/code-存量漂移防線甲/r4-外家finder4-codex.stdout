 25788	def _drift_doctor_lines(env):
 25789	    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
 25790	    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
 25791	    root, vault_rel = _drift_vault_of(env)
 25792	    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
 25793	    out = []
 25794	    for k in ("c1", "c2", "c3", "c4", "c5"):
 25795	        rows = [f for f in left if f["kind"] == k]
 25796	        nd = sum(1 for f in done if f["kind"] == k)
 25797	        if rows:     # 只剩已表態的不開段(全靜默;代碼審 r2 正確性席:表態完那一段永遠不會安靜);全部清單看 drift scan
 25798	            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
 25799	            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else ""))
 25800	    return out
 25801	
