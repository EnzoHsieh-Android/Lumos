 25651	def _drift_gate_explicit(text):
 25652	    """設定檔有沒有自己寫 drift_check.gate(不管寫什麼值)。"""
 25653	    import json as _j
 25654	    try:
 25655	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else (text or ""))
 25656	    except (ValueError, UnicodeDecodeError):
 25657	        return False
 25658	    return isinstance(cfg, dict) and isinstance(cfg.get("drift_check"), dict) and "gate" in cfg["drift_check"]
