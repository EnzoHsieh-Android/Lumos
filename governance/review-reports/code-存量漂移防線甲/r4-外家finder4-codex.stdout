 24506	    rng0 = f"{base_where}..{tip_where}" if base_where else tip_where
 24507	    if late():
 24508	        return None
 24509	    touched = _ns_git(repo_root, "log", "--format=", "--name-only", "-z", "-M", rng0, "--", vault_rel)
 24510	    if touched is None:
 24511	        return None
 24512	    out = []
 24513	    for p in sorted({x.strip("\n") for x in touched.decode("utf-8", errors="surrogateescape").split("\0")
 24514	                     if x.strip("\n").endswith(".md")}):
 24515	        if only is not None and nfc(p) not in only:
 24516	            continue
 24517	        if late():
 24518	            return None
 24519	        ty, st = _note_audit_status_of(reader(p))
 24520	        if not tip_ok(ty, st):
 24521	            continue
 24522	        seq = _note_status_seq(repo_root, base_where, tip_where, vault_rel, p, deadline=deadline, strict=strict)
 24523	        if seq is None:
 24524	            return None
 24525	        if any(flip(a, b) for a, b in zip(seq, seq[1:])):
 24526	            out.append(p)
 24527	    return out
 24528	
 24529	
 24530	def _note_status_seq(repo_root, base_where, tip_where, vault_rel, p, deadline=None, strict=False):
 24531	    """一篇筆記在範圍裡由舊到新的 status 序列(起點那一版開頭;改名跟著走)。git log 失敗回 None;
 24532	    strict 時批次讀失敗、改名對照失敗也回 None(不能當成沒有狀態翻轉,代碼審 r2、r3 外家席),不嚴格時照舊當成讀不到。
 24533	    deadline:每一次 git 呼叫前看一次,過了回 None;批次讀的逾時用剩下的時間。"""
 24534	    import time as _t
 24535	
 24536	    def late():
 24537	        return deadline is not None and _t.monotonic() > deadline
 24538	
 24539	    def _to():
 24540	        return 60 if deadline is None else max(1, deadline - _t.monotonic())
 24541	    rng = f"{base_where}..{tip_where}" if base_where else tip_where
 24542	    if late():
 24543	        return None
 24544	    lg = _ns_git(repo_root, "log", "--follow", "--format=%H", "--name-only", "-z", rng, "--", p)
 24545	    if lg is None:
 24546	        return None
 24547	    pairs = _git_log_sha_paths(lg)
 24548	    specs = [f"{s}:{q}" for s, q in pairs]
 24549	    if specs and late():
 24550	        return None
 24551	    blobs = _nodehome_cat_blobs(repo_root, specs, timeout=_to()) if specs else []
 24552	    if blobs is None:
 24553	        if strict:
 24554	            return None
 24555	        blobs = []
 24556	    states = [_note_audit_status_of(b)[1] for b in blobs]
 24557	    base_state = None
 24558	    if base_where:
 24559	        got = _note_base_status(repo_root, base_where, vault_rel, pairs, p, late, _to, strict)
 24560	        if got is None:
 24561	            return None
 24562	        base_state = got[0]
 24563	    return [base_state, *states[::-1]]          # 由舊到新
 24564	
 24565	
 24566	def _git_log_sha_paths(raw):
 24567	    """git log -z --format=%H --name-only 的輸出 →[(sha, 那時的路徑)]。
 24568	    格式是「sha\\0\\n路徑\\0」一筆接一筆(實測;換行黏在路徑前面)。"""
 24569	    pairs, cur = [], None
 24570	    for tok in raw.decode("utf-8", errors="surrogateescape").split("\0"):
 24571	        tok = tok.strip("\n")
 24572	        if not tok:
 24573	            continue
 24574	        if cur is None and _LENS_SHA_RE.fullmatch(tok):
 24575	            cur = tok
 25265	    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
 25266	    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
 25267	    lines = text.split("\n")
 25268	    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""
 25269	
 25270	
 25271	def _drift_c3_hit(env, vrel, override=None, ti=None):
 25272	    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
 25273	    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
 25274	    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
 25275	    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
 25276	    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
 25277	    n = env.notes.get(vrel)
 25278	    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
 25279	        return None
 25280	    if GUARD_MARK_FIELD in n.fields:
 25281	        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
 25282	    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
 25283	    if not refs:
 25284	        return None
 25285	    ti = ti if ti is not None else build_typed_index(env)
 25286	    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
 25287	    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
 25288	    if any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
 25289	            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
 25290	        return None
 25291	    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
 25292	    if not plans:
 25293	        return None
 25294	    for prel in plans:
 25295	        pn = env.notes.get(prel)
 25296	        if pn is None or _drift_str(pn, "type") != "project":
 25297	            return None
 25298	        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
 25299	            return None
 25300	    return plans
 25301	
