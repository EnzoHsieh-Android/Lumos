 25494	def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None):
 25495	    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
 25496	    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
 25497	    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
 25498	    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
 25499	    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
 25500	    import time as _t
 25501	
 25502	    def _left():
 25503	        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
 25504	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
 25505	    tenv = _drift_tree_env(root, tip, vault_rel, override, timeout=_left())
 25506	    if tenv is None:
 25507	        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
 25508	    if _left() <= 0:
 25509	        return [], [], [over]
 25510	    reader = _nodehome_reader(root, tip)
 25511	    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
 25512	    if ev is None:
 25513	        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
 25514	    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
 25515	               if _note_unreadable(n) and p in ev["touched"]]
 25516	    must, listed = [], []
 25517	    for f in _drift_state_findings(tenv):
 25518	        p, k = f["path"], f["kind"]
 25519	        if k == "c1":
 25520	            if p in ev["passed"]:
 25521	                must.append(f)
 25522	            continue
 25523	        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
 25524	        if hit:
 25525	            listed.append(f)
 25526	    return must, listed, unknown
