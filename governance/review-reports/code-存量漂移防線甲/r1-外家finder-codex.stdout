 24423	def _note_audit_status_of(blob):
 24424	    """筆記內容(bytes)→ (type, status)。讀不到回 (None, None)。"""
 24425	    if blob is None:
 24426	        return None, None
 24427	    try:
 24428	        fm, _b = split_frontmatter(blob.decode("utf-8-sig"))
 24429	    except UnicodeDecodeError:
 24430	        return None, None
 24431	    if not fm:
 24432	        return None, None
 24433	    fields = parse_frontmatter(fm)[0]
 24434	    return str(fields.get("type", "")).strip() or None, str(fields.get("status", "")).strip() or None
