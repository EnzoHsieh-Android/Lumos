 14551	def _set_conditions_locked(env, rel, key, values):
 14552	    """驗收紀錄的前提/回頭條件整欄換掉(Projects/驗收前提欄位可改_計劃)。
 14553	
 14554	    ★為什麼整欄換、不走 append/remove★:這兩欄是散文、常提到連結;append/remove 判斷「同一項」看連結目標,
 14555	    兩條提到同一篇的不同條件會被當成重複。原本四種寫法(單行、清單、空的、多行區塊)並存,一律整段拿掉重寫。"""
 14556	    vals = [str(v).strip() for v in values]
 14557	    if not vals or any(not v for v in vals):
 14558	        print(f"擋下:{key} 的每一條都不能是空的,檔案沒動(前提寫這個結論在什麼情況下才算數,回頭條件寫改到什麼該重驗)",
 14559	              file=sys.stderr)
 14560	        return 2
 14561	    if any("\n" in v or "\r" in v for v in vals):
 14562	        print(f"擋下:{key} 一條條件只能一行,檔案沒動(要寫多條就給多個值:lumos set <筆記> {key} \"條件一\" \"條件二\")",
 14563	              file=sys.stderr)
 14564	        return 2
 14565	    path = env.vault / rel
 14566	    lines, _s, e = load_raw_for_edit(path)
 14567	    fm = list(lines[1:e])
 14568	    new = ([f"{key}: {fmt_scalar(key, vals[0])}"] if len(vals) == 1
 14569	           else [f"{key}:"] + [f"  - {fmt_scalar(key, v)}" for v in vals])
 14570	    struct = {k: (a, b) for k, a, b, _kind in fm_structure(fm)}
 14571	    if key in struct:
 14572	        a, b = struct[key]
 14573	        fm[a:b + 1] = new
 14574	    else:   # 插的位置照 edit_fm_scalar:第一個清單或多行區塊欄位之前,都沒有就放最後
 14575	        at = next((a for _k, a, _b, kind in fm_structure(fm) if kind in ("list", "block")), len(fm))
 14576	        fm[at:at] = new
 14577	    atomic_write_verify(path, lines[:1] + fm + lines[e:], key, lambda f: _conds(f.get(key)) == vals)
 14578	    print(f"✓ set {rel}: {key} 整欄換成 {len(vals)} 條" + ("" if len(vals) == 1 else "(一行一項的清單)"))
 14579	    return 0
