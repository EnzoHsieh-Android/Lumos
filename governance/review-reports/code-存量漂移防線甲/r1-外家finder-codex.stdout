 22786	def _nodehome_parse_note(raw):
 22787	    """節點原文 → {type, status, about[], resp, sig, text}。sig=(摘要, 解析後的決策, 正文)——[S12] 內容有變
 22788	    逐欄比對用;★不沿用只算正文的那支雜湊★:摘要與決策都在開頭欄位裡,節點長大主要就長在摘要。"""
 22789	    text = raw.decode("utf-8-sig", errors="replace") if isinstance(raw, (bytes, bytearray)) else str(raw)
 22790	    fm_lines, body = split_frontmatter(text)
 22791	    fields = {}
 22792	    dec = ""
 22793	    if fm_lines is not None:
 22794	        fields, _bk, _lint = parse_frontmatter(fm_lines)
 22795	        # 決策比「解析後的值」:只把 content: a 改成 content: "a" 這種等價寫法不算內容有變(第二輪外家席)
 22796	        try:
 22797	            dec = json.dumps(parse_decisions(fm_lines), ensure_ascii=False, sort_keys=True)
 22798	        except Exception:
 22799	            dec = "\n".join(l.rstrip() for l in fm_lines if l.startswith(("decisions:", "  ")))
 22800	    summ = fields.get("summary")
 22801	    summ = summ if isinstance(summ, str) else ""
 22802	    return {"type": str(fields.get("type", "")).strip(),
 22803	            "status": str(fields.get("status", "")).strip(),
 22804	            "about": [str(x) for x in as_list(fields.get("about_code")) if str(x).strip()],
 22805	            "resp": fields.get("responsibility") if isinstance(fields.get("responsibility"), str) else None,
 23000	        specs.append(f"{sha}:{x}")
 23001	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 23002	    blobs = _nodehome_cat_blobs(repo_root, specs)
 23003	    if blobs is None or any(ren is None for _, ren in pairs):
 23004	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 23005	        return paths, src, gone
 23006	    kept = set()
 23007	    for n, x in enumerate(order):
 23008	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 23009	        if _nodehome_merge_wrote_new_lines(merged, olds):
 23010	            kept.add(x)
 23011	    return kept, {k: v for k, v in src.items() if k in kept}, gone
