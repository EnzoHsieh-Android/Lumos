  1339	+            continue
  1340	+        must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
  1341	+        if must or unknown:
  1342	+            out.append({"commit": c[:10], "must": [f"{f['kind']} {f['path']}:{f['line']} {f['text'][:50]}" for f in must],
  1343	+                        "unknown": unknown, "listed": len(listed),
  1344	+                        "noise": len({f['path'] for f in must if f['kind'] == 'c1'}) + sum(1 for f in must if f['kind'] != 'c1')})
  1345	+    if as_json:
  1346	+        print(_j.dumps({"commits": int(n), "with_must": out}, ensure_ascii=False, indent=1))
  1347	+        return 0
  1348	+    print(f"最近 {n} 個主線提交裡,有要處理的 {len(out)} 個(每筆要人判真假):")
  1349	+    for r in out:
