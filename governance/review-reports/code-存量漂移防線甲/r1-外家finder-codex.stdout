 14439	def _vault_lock_say(lock, why):
 14440	    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
 14441	    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
 14442	    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
 14443	    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
 14444	    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
 14445	          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
 14446	    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
 14447	          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
 14448	          file=sys.stderr)
 14449	    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
 14450	    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)
 14451	
