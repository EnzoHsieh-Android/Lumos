 14507	def _cmd_set_locked(env, rel, key, value):
 14508	    if key in COND_KEYS:
 14509	        return _set_conditions_locked(env, rel, key, value if isinstance(value, list) else [value])
 14510	    if isinstance(value, list):
 14511	        if len(value) != 1:
 14512	            print(f"擋下:{key} 只收一個值,你給了 {len(value)} 個,檔案沒動(給多個值只有 {'、'.join(COND_KEYS)} 收)",
 14513	                  file=sys.stderr)
 14514	            return 2
 14515	        value = value[0]
 14516	    if key not in SCALAR_KEYS:
 14517	        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)},"
 14518	              f"以及整欄換掉的 {'、'.join(COND_KEYS)}"
 14519	              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
 14520	        return 2
 14521	    # ★負責範圍跟新開節點用同一支判斷、同樣擋★(筆記欄位關卡補齊_計劃 S11;不看開關——r3 架構席:
 14522	    # 同一個欄位的兩個寫入口擋法要一樣;原本只有 new 擋,set 可以寫進一個字)
 14523	    if key == "responsibility" and not _nodehome_resp_ok(value):
 14524	        print(f"擋下:負責範圍至少 {_NODEHOME_RESP_MIN_CHARS} 個字、要有實字(一句話講這篇負責什麼、不負責什麼),檔案沒動",
 14525	              file=sys.stderr)
 14526	        return 2
 14527	    path = env.vault / rel
 14528	    lines, s, e = load_raw_for_edit(path)
 14529	    new_fm = edit_fm_scalar(lines[1:e], key, value)
 14530	    exp = fmt_scalar(key, value)
 14531	    exp_val = strip_quotes(exp)
 14532	    tag_synced = False
 14533	    if key == "status":
 14534	        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
 14535	    new_lines = lines[:1] + new_fm + lines[e:]
 14536	
 14537	    def _check(f):
 14538	        if str(f.get(key, "")) != exp_val:
 14539	            return False
 14540	        if tag_synced:
 14541	            want = f"status/{exp_val}"
 14542	            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
 14543	            return want in tags and all(t == want for t in tags if t.startswith("status/"))
 14544	        return True
 14545	
 14546	    atomic_write_verify(path, new_lines, key, _check)
 14547	    print(f"✓ set {rel}: {key} 已改成 {exp}" + ("(狀態標籤 status/* 也同步改了)" if tag_synced else ""))
 14548	    return 0
