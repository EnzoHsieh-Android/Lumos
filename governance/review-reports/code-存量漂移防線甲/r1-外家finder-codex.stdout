 11702	def _guard_nodes(env):
 11703	    """帶本機制標記的守衛節點。★判準放節點身上,不看 status 字面值、不查外部帳★
 11704	    (設計審:手寫 pending 的人不該被拖進整套規則;判準跟著節點走,改名搬家都對得上)。"""
 11705	    out = []
 11706	    for rel, n in sorted(env.notes.items()):
 11707	        if n.fields.get("type") != "verification":
 11708	            continue
 11709	        g = n.fields.get(GUARD_MARK_FIELD)
 11710	        if not g:
 11711	            continue
 11712	        out.append((rel, n))
 11713	    return out
