   794	+                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
   795	+        vu = n.fields.get("valid_under")
   796	+        vtxt = " ".join(as_list(vu)) if vu else ""
   797	+        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
   798	+            text = env_text(env, rel) or ""
   799	+            ln = _drift_field_line(text, "valid_under")
   800	+            lines = text.split("\n")
   801	+            out.append({"kind": "c4", "path": rel, "line": ln, "related": [],
   802	+                        "text": lines[ln - 1].strip() if 0 < ln <= len(lines) else "valid_under",
   803	+                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
