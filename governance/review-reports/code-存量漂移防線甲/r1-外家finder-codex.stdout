 12070	        print(f"  先簽核再來:lumos signoff {stem} --ref {stem} --note \"<為什麼決定不做>\"", file=sys.stderr)
 12071	        return 2
 12072	    home = _guard_home_of(n)
 12073	    home_rel = env.find(home)
