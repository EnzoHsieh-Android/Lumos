 11726	def _guard_planned_line(env, home_rel, claim):
 11727	    """在功能節點裡找那一行預告標記,回 (lines, idx, e, err)。
 11728	
 11729	    ★比照既有引擎的兩道防呆★(代碼審 r1 blocker):`cmd_guard_bind`/`cmd_guard_audit` 對
 11730	    「在功能節點裡找某條 KEY 行」都會 ①命中多條就擋,不猜是哪一條 ②找不到就擋。
 11731	    第一版用「合約前 12 字」當子字串比對,同一篇預告兩條而前 12 字相同時會改到別條、互相覆蓋。
 11732	    這裡改成比對「剝掉 [watch:]/[due:] 之後的完整文字」,並保留多條就擋。"""
 11733	    path = env.vault / home_rel
 11734	    try:
 11735	        lines, _, e = load_raw_for_edit(path)
 11736	    except (ValueError, RuntimeError) as ex:
 11737	        return None, None, None, f"{home_rel} 打不開:{ex}"
 11738	    want = (claim or "").strip()
 11739	    idx = None
 11740	    for i in range(1, e):
 11741	        m = PLANNED_RE.match(lines[i].strip())
 11742	        if not m:
 11743	            continue
 11744	        body = _PLANNED_TAIL_RE.sub("", m.group(1)).strip()
 11745	        if body != want:
 11746	            continue
 11747	        if idx is not None:
 11748	            return None, None, None, (f"{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條"
 11749	                                      "——先手動把重複的那行處理掉")
 11750	        idx = i
 11751	    if idx is None:
 11752	        return None, None, None, f"{home_rel} 裡找不到預告行『{want[:30]}』(被手改過或已經轉正?)"
 11753	    return lines, idx, e, None
