 22755	def _nodehome_reader(repo_root, where):
 22756	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 22757	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 22758	    if where is None:
 22759	        return lambda p: None
 22760	    disk_ok_all = False
 22761	    differ = None
 22762	    if where == "index":
 22763	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 22764	    else:
 22765	        head = _lens_full_sha(repo_root, "HEAD")
 22766	        if head and head == where:
 22767	            differ = _nodehome_changed_vs_disk(repo_root, where)
 22768	    root = Path(repo_root)
 22769	    spec = "" if where == "index" else where
 22770	
 22771	    def read(p):
 22772	        if differ is not None and p not in differ:
 22773	            fp = root / p
 22774	            try:
 22775	                if fp.is_file() and not fp.is_symlink():
 22776	                    return fp.read_bytes()
 22777	            except OSError:
 22778	                pass
 22779	        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
 22780	        if r is None or r.returncode != 0:
 22781	            return None
 22782	        return r.stdout
 22783	    return read
 22784	
 22785	
 22995	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22996	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22997	    order = sorted(paths)
 22998	    specs = []
 22999	    for x in order:
 23000	        specs.append(f"{sha}:{x}")
 23001	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 23002	    blobs = _nodehome_cat_blobs(repo_root, specs)
 23003	    if blobs is None or any(ren is None for _, ren in pairs):
 23004	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 23005	        return paths, src, gone
 23006	    kept = set()
 23007	    for n, x in enumerate(order):
 23008	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 23009	        if _nodehome_merge_wrote_new_lines(merged, olds):
 23010	            kept.add(x)
 23011	    return kept, {k: v for k, v in src.items() if k in kept}, gone
