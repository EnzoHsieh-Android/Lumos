 23805	def _notelines_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, mark=None, max_count=None,
 23806	                           hook=_NOTELINES_PRECOMMIT):
 23807	    """推送前:範圍裡每個提交各自新增的筆記行 → ({NFC 路徑: 行文字集合}, [範圍淨改動的筆記路徑(git 原樣)],
 23808	    {NFC 路徑: 這道檢查還沒上線的提交寫的行})。git 失敗回 None。
 23809	    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
 23810	    改名照每個提交(合併提交是每個上一版)的改名偵測往後帶到終點路徑(r3 外家席)。
 23811	    ★鍵用 NFC、拿去 git 查的一律用原樣路徑★(驗收輪通才席:NFC 過的路徑對存 NFD 的樹 cat-file、路徑篩選都查不到)。
 23812	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
 23813	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
 23814	    ★寫的時候這道檢查還沒上線的提交不查★(mark):看那個提交自己的提交前掛鉤有沒有上線標記——上線前開的分支上線後
 23815	    才合進來,那些行是舊帳(r3 通才席);原本用「是不是上線點的後代」代替,兩條分支各自裝過時另一條整批漏查(驗收輪通才席)。
 23816	    那些行另外收進第三個回傳值,喚醒那條路也跳過(驗收輪外家席)。max_count:只看最新那幾個提交(doctor 的上限)。"""
 23817	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23818	    if exclude_remote:
 23819	        ml = _ns_exclusions(repo_root, tip)
 23820	        if ml:
 23821	            rl += ["--not", *ml]
 23822	    if max_count:
 23823	        rl.append(f"--max-count={int(max_count)}")
 23824	    raw = _nodehome_git(repo_root, *rl)
 23825	    if raw is None:
 23826	        return None
 23827	    commits = [ln.split() for ln in raw.decode("ascii", errors="replace").splitlines() if ln.split()]
 23828	    live = None
 23829	    if mark and commits:
 23830	        hb = _nodehome_cat_blobs(repo_root, [f"{c[0]}:{hook}" for c in commits])
 23831	        if hb is None:
 23832	            return None
 23833	        live = {c[0] for c, b in zip(commits, hb) if b is not None and mark.encode() in b}
 23834	    by_path, old_by = {}, {}
 23835	
 24580	    return docs, bad
