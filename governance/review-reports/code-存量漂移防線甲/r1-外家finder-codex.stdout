 14513	                  file=sys.stderr)
 14514	            return 2
 14515	        value = value[0]
 14516	    if key not in SCALAR_KEYS:
 14517	        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)},"
 14518	              f"以及整欄換掉的 {'、'.join(COND_KEYS)}"
 14519	              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
 14520	        return 2
 14521	    # ★負責範圍跟新開節點用同一支判斷、同樣擋★(筆記欄位關卡補齊_計劃 S11;不看開關——r3 架構席:
 14522	    # 同一個欄位的兩個寫入口擋法要一樣;原本只有 new 擋,set 可以寫進一個字)
 14523	    if key == "responsibility" and not _nodehome_resp_ok(value):
