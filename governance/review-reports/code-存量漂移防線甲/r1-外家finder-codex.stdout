 23772	def _ns_git(repo_root, *args):
 23773	    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
 23774	    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
 23775	    r = _lens_git(repo_root, *args, quote=True, binary=True)
 23776	    if r is None or r.returncode != 0:
 23777	        return None
 23778	    return r.stdout
