 23013	
 23014	def _nodehome_cat_blobs(repo_root, specs):
 23015	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 23016	
 23017	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 23018	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 23019	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 23020	    import subprocess as _sp
 23021	    if not specs:
 23022	        return []
 23023	    if any("\n" in s_ for s_ in specs):
 23024	        return None
 23025	    try:
 23026	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 23027	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 23028	                    capture_output=True, timeout=60)
 23029	    except (OSError, _sp.TimeoutExpired):
 23030	        return None
 23031	    if r.returncode != 0:
 23032	        return None
 23033	    out, pos, res = r.stdout, 0, []
 23034	    for _ in specs:
 23035	        nl = out.find(b"\n", pos)
 23036	        if nl < 0:
 23037	            return None
 23038	        head = out[pos:nl].split(b" ")
 23039	        pos = nl + 1
 23040	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 23041	            size = int(head[2])
 23042	            res.append(out[pos:pos + size])
 23043	            pos += size + 1
 23044	        elif len(head) == 3 and head[2].isdigit():
 23045	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 23046	            res.append(None)
 23047	        else:
 23048	            res.append(None)            # missing / ambiguous
 23049	    return res
 23050	
