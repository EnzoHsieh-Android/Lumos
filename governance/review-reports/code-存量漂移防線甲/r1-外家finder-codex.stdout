 30135	def _lens_git(repo_root, *args, quote=False, binary=False):
 30136	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 30137	    import subprocess as _sp
 30138	    cmd = ["git", "-C", str(repo_root)]
 30139	    if quote:
 30140	        cmd += ["-c", "core.quotePath=false"]
 30141	    try:
 30142	        if binary:
 30143	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 30144	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 30145	    except (OSError, _sp.TimeoutExpired):
 30146	        return None
