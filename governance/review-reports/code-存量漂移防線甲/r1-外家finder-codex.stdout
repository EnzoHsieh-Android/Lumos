 12089	        print("  棄置會把功能節點那行預告拿掉;對不到那一行就不知道該拿掉哪一條,不能硬做", file=sys.stderr)
 12090	        return 2
 12091	    try:
 12092	        atomic_write_verify(env.vault / home_rel, lines[:idx] + lines[idx + 1:],
 12093	                            "", lambda f: claim not in str(f.get("summary") or ""))
