 30077	def _lens_kind_of(v):
 30078	    """派工鏡頭那一行要標什麼種類(推筆記認家 [S6][S8])。
 30079	
 30080	    「家」是標記不是種類:一篇本來就因為直接相依進來、又剛好是這支檔的家,它的 kind 還是 direct。
 30081	    對讀派工單的人來說「這篇管這支檔」比「這篇有提到這支檔」重要,所以家優先顯示。
 30082	    """
 30083	    # ★事故不能被蓋掉★:一篇既是家、又出過事故,讀派工單的人最需要知道的是「這裡出過事」
 30084	    # ——所以兩個都印(代碼審 r1 正確性席)。
 30085	    base = _LENS_KIND.get(v.get("kind"), None)
 30086	    if not v.get("home"):
 30087	        return base
 30088	    return f"{base}·{_LENS_KIND['home']}" if base and v.get("kind") == "incident" else _LENS_KIND["home"]
