   329	+def _guard_settle_rewrite(lines, today, home_link):
   330	+    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。"""
   331	+    regs = _notelines_regions("\n".join(lines))
   332	+    out, seen = [], set()
   333	+    for i, ln in enumerate(lines):
   334	+        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
   335	+        if k is None:
   336	+            out.append(ln)
   337	+            continue
   338	+        seen.add("why" if k == "why-done" else k)
   339	+        ind = ln[:len(ln) - len(ln.lstrip())]
   340	+        if k == "test":
   341	+            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
   342	+        elif k == "why":
   343	+            out.append(f"{ln.rstrip()}({today} 已轉正)")
   344	+        elif k == "whynot":
   345	+            out.append(f"{ind}預告當時{ln.lstrip()}")
   346	+        elif k == "settle":
   347	+            out.append(f"{ind}({today} 已轉正)")
   348	+        else:
   349	+            out.append(ln)
   350	+    return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]
