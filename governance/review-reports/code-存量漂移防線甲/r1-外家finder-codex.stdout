  1175	+def _drift_doctor_lines(env):
  1176	+    """doctor Z 段(計劃 [S14]):不評估條件,只讀筆記;全部是 0 回 []。唯一的 git 呼叫是判斷有沒有接線時讀一次推送前掛鉤。"""
  1177	+    root = _vault_repo_root(env)
