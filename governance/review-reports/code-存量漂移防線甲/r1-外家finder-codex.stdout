 22713	def _nodehome_list(repo_root, where):
 22714	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 22715	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
 22716	    if where is None:
 22717	        return {}, []
 22718	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 22719	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 22720	    if raw is None:
 22721	        return None
 22722	    files, allp = {}, []
 22723	    for ent in raw.split(b"\0"):
 22724	        if not ent or b"\t" not in ent:
 22725	            continue
 22726	        meta, p = ent.split(b"\t", 1)
 22727	        parts = meta.split()
 22728	        if where == "index":
 22729	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 22730	                continue
 22731	            mode = parts[0]
 22732	        else:
 22733	            if len(parts) != 3:
 22734	                continue
 22735	            mode = parts[0]
 22736	        path = nfc(os.fsdecode(p))
 22737	        allp.append(path)
 22738	        if mode in (b"100644", b"100755"):
 22739	            files[path] = mode.decode()
 22740	    return files, allp
