 12079	              "不然那篇的預告行會永遠留著,跟墓碑互相矛盾", file=sys.stderr)
 12080	        return 2
 12081	    if not claim:
 12082	        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條(被手改過?)", file=sys.stderr)
 12083	        return 2
 12084	    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
 12085	    if lines is None:
 12086	        # ★找不到就擋,不靜默略過★(代碼審 r1 blocker):guards 被改指到別篇時,
