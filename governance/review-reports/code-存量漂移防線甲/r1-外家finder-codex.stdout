 23171	def _nodehome_clamp_base(repo_root, base, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
 23172	    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
 23173	    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。mark 見 _nodehome_golive。"""
 23174	    gl = _nodehome_golive(repo_root, tip, mark, hook)
 23175	    if gl is None:
 23176	        return base
 23177	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
 23178	    if r is None or r.returncode != 0:
 23179	        return base                                    # 上線點不在這條歷史上
 23180	    if base in (None, _EMPTY_TREE_SHA):
 23181	        return gl
 23182	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
 23183	    return gl if (r is not None and r.returncode == 0 and base != gl) else base
