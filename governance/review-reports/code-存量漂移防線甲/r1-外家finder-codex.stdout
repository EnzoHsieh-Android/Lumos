 24619	def _note_audit_resolve(root, diff_range, gate_word, gate="note-audit", mark=None):
 24620	    """--diff 範圍 → (base_where, tip, vault_rel) 或 (None, rc, None)。起點照三道檢查共用的 _lens_push_base,
 24621	    再截到上線點(推送前掛鉤的標記;預設是第二層的,存量漂移檢查傳自己的)。"""
 24622	    rg = _lens_range_ok(diff_range)
 24623	    if rg is None:
 24624	        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 24625	        return None, 2, None
 24626	    sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 24627	    if sh is not None and sh.stdout.strip() == "true":
 24628	        print(f"{gate_word}:淺層 clone 算不出範圍,這次不查——CI 請設 fetch-depth: 0", file=sys.stderr)
 24629	        _gate_event_or_warn(root, gate, "skipped-env", "shallow clone")
 24630	        return None, 0, None
 24631	    a, b = rg
 24632	    if _ZERO_SHA_RE.fullmatch(b):
 24633	        print(f"{gate_word}:範圍終點是全 0(刪除分支),沒有要審的東西", file=sys.stderr)
 24634	        return None, 0, None
 24635	    tip = _lens_full_sha(root, b)
 24636	    if tip is None:
 24637	        # 推送前的終點是本機要推的提交、CI 的是剛 checkout 的那個,都一定找得到;找不到就是範圍寫錯,
 24638	        # 放行等於整道檢查沒跑(代碼審 r1 外家席),所以當參數錯
 24639	        print(f"擋下:範圍 {diff_range} 的終點在本機找不到——範圍寫錯了?", file=sys.stderr)
 24640	        return None, 2, None
 24641	    base, why = _lens_push_base(root, a, tip)
 24642	    if why:
 24643	        print(f"{gate_word}:{why}", file=sys.stderr)
 24644	    if base is None:
 24645	        _gate_event_or_warn(root, gate, "skipped", why)
 24646	        return None, 0, None
 24647	    base = _nodehome_clamp_base(root, base, tip, mark or _NOTE_AUDIT_GOLIVE_MARK, _NOTELINES_PREPUSH)
 24648	    lst = _nodehome_list(root, tip)
 24649	    if lst is None:
 24650	        return None, 0, None
 24651	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 24652	    if not vaults:
 24653	        print(f"{gate_word}:這個專案沒有圖譜,跳過")
 24654	        return None, 0, None
 24655	    wv = _vault_in(root)
 24656	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 24657	    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 24658	    return (None if base == _EMPTY_TREE_SHA else base), tip, vault_rel
