 11552	        return None
 11553	    if "\n" in _c or "\r" in _c:
 11554	        print("擋下:合約那句話不能換行(摘要是一行一條,換行會把整個摘要區塊打斷,"
 11555	              "連同這篇既有的合約一起從圖譜消失)", file=sys.stderr)
