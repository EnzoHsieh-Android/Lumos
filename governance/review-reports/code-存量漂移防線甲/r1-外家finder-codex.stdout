 30157	def _mainline_ref(repo_root, remote_only=False):
 30158	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 30159	    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
 30160	    拿它當「已在主線上」會把整批都排除掉)。"""
 30161	    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
 30162	        sha = _lens_full_sha(repo_root, cand)
 30163	        if sha:
 30164	            return cand, sha
 30165	    return None
