 30091	def _lens_range_ok(diff_range):
 30092	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 30093	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 30094	        return None
 30095	    parts = diff_range.split("..")
 30096	    if len(parts) != 2 or not parts[0] or not parts[1]:
 30097	        return None
 30098	    if any(ch.isspace() for ch in diff_range):
 30099	        return None
 30100	    return parts[0], parts[1]
