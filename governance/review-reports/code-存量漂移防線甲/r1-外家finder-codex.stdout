 23186	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 23187	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 23188	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 23189	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 23190	    None=整批當成一個提交(提交前)。"""
 23191	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 23192	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 23193	    homesN, ownN = _nodehome_homes(repo_root, N)
 23194	    homesB, ownB = _nodehome_homes(repo_root, B)
 23195	    blocks, reminders, pairs = [], [], []
 23196	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 23197	    for code, old, new in changes:
 23198	        if old is not None and (new is None or code == "R"):
 23199	            deleted.add(old)
 23200	        if new is None:
 23201	            continue
 23202	        changed_new.add(new)
 23203	        if code in ("A", "R", "C"):
 23204	            added.add(new)
 23205	        if code == "R" and old:
 23206	            renamed_from[new] = old
 23207	    code_changed = {p for p in changed_new if p in reqN}
 23208	    code_added = {p for p in added if p in reqN}
 23209	    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
 23210	    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
 23211	    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
 23212	    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
 23213	    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
 23214	    code_touched = code_changed | code_deleted
 23215	    vpre = vault_rel + "/"
 23216	    refs_cache = {}
 23217	
 23218	    def refs_now(rel):
 23219	        if rel not in refs_cache:
 23220	            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
 23710	    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 23711	    try:
 23712	        data = json.loads(raw)
 23713	    except Exception as e:
 23714	        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
 23715	    ns = data.get("note_shape") if isinstance(data, dict) else None
 23716	    if ns is None:
 23717	        return "block", []
 23718	    if not isinstance(ns, dict):
 23719	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23720	    g = ns.get("gate", "block")
 23721	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23722	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23723	    return g, []
