   312	+
   313	+def _guard_formal_line(lines, e, claim, method=None):
   314	+    """家筆記的摘要裡有沒有這條合約的正式行:合約文字相同、行內有 [test:<方法>](method=None 時任一方法);
   315	+    後來 guard audit 加的 [audit:…] 等標記不影響比對(存量漂移防線 [S5])。"""
   316	+    for i in range(1, e):
   317	+        m = INVARIANT_RE.match(lines[i].strip())
   318	+        if not m:
   319	+            continue
   320	+        if method is not None and f"[test:{method}]" not in lines[i]:
   321	+            continue
   322	+        if method is None and not TEST_REF_RE.search(lines[i]):
   323	+            continue
   324	+        if _GUARD_MARKS_RE.sub("", m.group(1)).strip() == claim:
   325	+            return True
   326	+    return False
