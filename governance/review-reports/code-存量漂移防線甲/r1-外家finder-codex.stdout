 30149	def _lens_full_sha(repo_root, rev):
 30150	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 30151	    if r is None or r.returncode != 0:
 30152	        return None
 30153	    sha = r.stdout.strip()
 30154	    return sha if _LENS_SHA_RE.match(sha) else None
