   217	+def t_guard_settle_rewrites_planned_prose():
   218	+    """[S4] settle 轉正把 guard plan 寫的四種預告句改成歷史說法、其他行不動、status 同一次寫入;
   219	+    新版轉正後的推送不被自己的 c1 擋;找不到句型時提醒但照樣成功。
   220	+
   221	+    翻紅釘:拿掉 _guard_settle_rewrite 的呼叫 → ②③紅;第四句前綴拿掉反引號 → ② 第四句紅;
   222	+    c1 改成子字串比對(不從行首)→ ⑤ 被「預告當時為什麼還不做」擋紅。
   223	+    """
   224	+    print("t_guard_settle_rewrites_planned_prose")
   225	+    import datetime
   226	+    today = datetime.date.today().isoformat()
   227	+    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
   228	+    vault = root / _DR_VAULT
   229	+    base = _na_head(root)
   230	+    _gp(vault, "guard", "plan", "Systems/Pay", "大額退費要人工核可", "--plan", "Projects/退款_計劃",
   231	+        "--phase", "P1", "--due", "2099-12-31", "--why", "下游介面還沒定案", "--owner", "enzo", "--name", "大額退費")
   232	+    g = [x for x in (vault / "Verification").glob("*.md")][0]
   233	+    before = g.read_text(encoding="utf-8")
   234	+    check("①前置:樣板真的寫了四種預告句", all(x in before for x in (
   235	+        "TEST:還沒有測試在守這條", "]預告這條合約但還沒做:", "\n為什麼還不做:", "做完之後跑 `lumos guard settle` 轉正")), before)
   236	+    _nh_commit(root, "plan")
   237	+    r = run(vault, "guard", "settle", "Verification/" + g.stem, "--test", "t_refund_manual")
   238	+    after = g.read_text(encoding="utf-8")
   239	+    check("①settle 成功", r.returncode == 0, r.stdout + r.stderr)
   240	+    check("②TEST 句改成哪天轉正、由家筆記的正式行守,不寫測試名",
   241	+          f"TEST:[{today}] 預告已轉正,合約改由 [[Systems/Pay]] 的正式合約行守" in after and "t_refund_manual" not in after, after)
   242	+    check("②WHY 句行尾加已轉正", f"預告這條合約但還沒做:下游介面還沒定案({today} 已轉正)" in after, after)
   243	+    check("②正文「為什麼還不做」改成預告當時", "\n預告當時為什麼還不做:下游介面還沒定案" in after and "\n為什麼還不做:" not in after, after)
   244	+    check("②第四句整行換成已轉正", f"\n({today} 已轉正)\n" in after and "做完之後跑" not in after, after)
   245	+    check("③status 與標籤同一次改成 pass", "status: pass" in after and "status/pass" in after and "status/pending" not in after, after)
   246	+    check("③其他行一字不動", "預告的合約:大額退費要人工核可" in after and "due: 2099-12-31" in after, after)
   247	+    fs = _dr_scan(vault)
   248	+    check("④新版轉正後 scan 沒有 c1", isinstance(fs, list) and not [f for f in fs if f["kind"] == "c1"], str(fs))
   249	+    _nh_commit(root, "settle")
   250	+    rc, out = _dr(root, "check", "--diff", f"{base}..HEAD")
   251	+    check("⑤轉正後緊接的推送不被自己的 c1 擋", rc == 0 and "c1" not in out, out)
   252	+    # 找不到句型:手改掉 TEST 句 → 提醒、照樣成功
   253	+    _gp(vault, "guard", "plan", "Systems/Pay", "另一條合約", "--plan", "Projects/退款_計劃",
   254	+        "--phase", "P1", "--due", "2099-12-31", "--why", "還沒定", "--owner", "enzo", "--name", "另一條")
   255	+    g2 = [x for x in (vault / "Verification").glob("*.md") if "另一條" in x.stem][0]
   256	+    g2.write_text(g2.read_text(encoding="utf-8").replace("TEST:還沒有測試在守這條", "TEST:作者自己改寫過"), encoding="utf-8")
   257	+    r2 = run(vault, "guard", "settle", "Verification/" + g2.stem, "--test", "t_other")
   258	+    check("⑥找不到句型:照樣成功並提醒那一句", r2.returncode == 0 and "找不到摘要的 TEST 預告句" in r2.stdout,
   259	+          r2.stdout + r2.stderr)
   260	+    check("⑥手改過的那句不動", "TEST:作者自己改寫過" in g2.read_text(encoding="utf-8"), g2.read_text(encoding="utf-8"))

