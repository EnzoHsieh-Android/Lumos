 11716	def _guard_find(env, ref):
 11717	    rel = env.find(ref)
 11718	    if rel is None:
 11719	        return None, None
 11720	    n = env.notes.get(rel)
 11721	    if n is None or not n.fields.get(GUARD_MARK_FIELD):
 11722	        return None, None
 11723	    return rel, n
