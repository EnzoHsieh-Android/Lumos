  1290	+                     "other_must": om, "other_listed": ol, "noise": noise})
  1291	+    summ = {"擋到": 0, "點到": 0, "漏": 0, "誤列": 0, "沒誤列": 0, "略過": 0}
  1292	+    for r in rows:
  1293	+        summ["略過" if r["result"].startswith("略過") else r["result"]] += 1
