 24437	def _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader):
 24438	    """範圍裡被收尾的計劃(計劃〈做法〉第 1 節):`type: project`、終點 status 是 done/superseded,而且範圍裡有某個提交
 24439	    把它從非收尾改成收尾——逐提交讀那篇的 status(改名跟著走;起點沒有這篇時第一個提交就算)。回 [路徑]。"""
 24440	    return _notes_status_flipped(repo_root, base_where, tip_where, vault_rel, reader,
 24441	                                 lambda ty, st: ty == "project" and st in _NOTE_AUDIT_CLOSED,
 24442	                                 lambda a, b: (a not in _NOTE_AUDIT_CLOSED) and (b in _NOTE_AUDIT_CLOSED))
 24443	
