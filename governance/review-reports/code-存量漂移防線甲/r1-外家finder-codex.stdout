 23726	def _notelines_regions(text):
 23727	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23728	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23729	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23730	    lines = text.split("\n")
 23731	    fm, _body = split_frontmatter(text)
 23732	    if fm is None:
 23733	        if text.startswith("---"):
 23734	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23735	        return ["body"] * len(lines)
 23736	    out = ["body"] * len(lines)
 23737	    end = len(fm) + 1                            # 收尾 --- 那一行
 23738	    out[0] = out[end] = "other"
 23739	    cur = "other"
 23740	    for i in range(1, end):
 23741	        ln = lines[i]
 23742	        m = TOP_KEY_RE.match(ln)
 23743	        if m:
 23744	            k = m.group(1)
 23745	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23746	            out[i] = "other"
 23747	            continue
 23748	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23749	    return out
 23750	
