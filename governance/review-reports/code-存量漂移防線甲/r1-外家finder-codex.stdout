 11645	def _guard_plan_locked(env, node, claim, plan, phase, due, why, owner, name=None):
 11646	    import datetime
 11647	    checked = _guard_plan_check(env, node, claim, plan, phase, due, why, owner, name)
 11648	    if checked is None:
 11649	        return 2
 11650	    rel, prel, phases, gname, gpath = checked
 11651	    today = datetime.date.today().isoformat()
 11652	
 11653	    if not _guard_plan_write_node(gpath, gname, rel, prel, phases, today, claim, due, why, owner):
 11654	        return 2
 11655	    # ── 再寫功能節點的預告標記
 11656	    gref = f"Verification/{gname}"
 11657	    path = env.vault / rel
 11658	    try:
 11659	        lines, _, e = load_raw_for_edit(path)
 11660	    except (ValueError, RuntimeError) as ex:
 11661	        print(f"⚠ 守衛節點已建好({gref}),但功能節點打不開,標記沒寫進去: {ex}", file=sys.stderr)
 11662	        print("  不回滾(本 repo 的寫入原語沒有刪除這一步);手動補標記或把守衛節點刪掉重來", file=sys.stderr)
 11663	        return 2
 11664	    # ★行尾不帶換行★:load_raw_for_edit 回來的每一行都已經去掉換行,自己再加一個會多出空行
 11665	    marker = f"  KEY:{PLANNED_MARK} {claim.strip()} [watch:{gref}] [due:{due.strip()}]"
 11666	    # 插在摘要區塊第一行之前。★要跳過 summary: 那一行本身之後可能已有的空白行★,
 11667	    # 不然會在標記後面留一個空行,讀起來像摘要斷成兩段。
 11668	    ins = None
 11669	    for i in range(1, e):
 11670	        if lines[i].startswith("summary:"):
 11671	            ins = i + 1
 11672	            while ins < e and not lines[ins].strip():
 11673	                ins += 1
 11674	            break
 11675	    if ins is None:
 11676	        print(f"⚠ 守衛節點已建好({gref}),但功能節點沒有摘要區塊,標記沒寫進去", file=sys.stderr)
 11677	        print("  不回滾;先給那篇補 summary 再手動加這一行:", file=sys.stderr)
 11678	        print("    " + marker.strip(), file=sys.stderr)
 11679	        return 2
 11680	    new_lines = [*lines[:ins], marker, *lines[ins:]]
 11681	    try:
 11682	        atomic_write_verify(path, new_lines, PLANNED_MARK,
 11683	                            lambda f: PLANNED_MARK in str(f.get("summary") or ""))
 11684	    except (ValueError, RuntimeError) as ex:
 11685	        print(f"⚠ 守衛節點已建好({gref}),但標記寫不進功能節點: {ex}", file=sys.stderr)
 11686	        print("  不回滾;手動補上這一行:", file=sys.stderr)
 11687	        print("    " + marker.strip(), file=sys.stderr)
 11688	        return 2
 11689	    # ★還要掛 verified_by★:不掛的話守衛節點在自檢裡是「沒人引用的孤兒驗證紀錄」,
 11690	    # 等於預告一條合約就多一個 issue——防忘記的機制自己製造雜訊,人會學會忽略它。
 11691	    # 掛了也順便讓「查那篇功能節點就看得到它」成立(設計審重點)。
 11692	    _rc_v = cmd_append(env, rel, "verified_by", f"[[{gref}]]")
 11693	    if _rc_v != 0:
 11694	        print("⚠ 標記與守衛節點都寫好了,但 verified_by 沒掛上——它會被當成孤兒驗證紀錄", file=sys.stderr)
 11695	        print(f"  手動補:lumos append {rel[:-3] if rel.endswith('.md') else rel} verified_by \"[[{gref}]]\"", file=sys.stderr)
 11696	    print(f"✓ 預告合約已登記:{rel} 多了一行預告標記,{gref} 在守它")
 11697	    print(f"  最遲 {due.strip()} 要做完(負責人 {owner.strip()});逾期會擋推送,而且不准延期")
 11698	    print(f"  做完之後:lumos guard settle {gref} --test <測試方法名>")
 11699	    return 0
