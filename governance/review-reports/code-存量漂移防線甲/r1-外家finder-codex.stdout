  1296	+           "噪音最大": max([r["noise"] for r in rows] or [0]), "rows": rows}
  1297	+    if as_json:
  1298	+        print(_j.dumps(tot, ensure_ascii=False, indent=1))
  1299	+        return 0
  1300	+    print(f"略過 {skipped} 題(機制①,給實驗計劃)")
  1301	+    print("題號  考法            結果        誤報(要處理/只列出)  噪音")
  1302	+    for r in rows:
  1303	+        print(f"{r['id']:<5} {r['event']:<15} {r['result']:<10}  {r['other_must']}/{r['other_listed']}"
  1304	+              f"{'':<16}{r['noise']}")
  1305	+    print("合計:" + "、".join(f"{k} {v}" for k, v in summ.items())
  1306	+          + f";誤報 要處理 {tot['誤報_要處理']}、只列出 {tot['誤報_只列出']};單一提交噪音最大 {tot['噪音最大']}")
  1307	+    return 0
