  8257	def _jsonl_append_verified(path, rec, key_field, key_value):
  8258	    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
  8259	    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
  8260	    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
  8261	    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
  8262	    import json
  8263	    try:
  8264	        with open(path, "a", encoding="utf-8") as f:
  8265	            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
  8266	    except OSError as e:
  8267	        print(f"擋下:寫不進記錄檔({e}):\n    {path}", file=sys.stderr)
  8268	        return 2
  8269	    try:
  8270	        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
  8271	            for line in f:
  8272	                if not line.strip():
  8273	                    continue
  8274	                try:
  8275	                    d = json.loads(line)
  8276	                except (ValueError, RecursionError):   # 別筆是超深巢狀行也只跳過;否則已寫進去卻報沒記成功(code-逃逸帳 r3 邊界席)
  8277	                    continue
  8278	                if isinstance(d, dict) and d.get(key_field) == key_value:
  8279	                    return 0
  8280	    except (OSError, ValueError) as e:
  8281	        print(f"canary record: 落盤自驗失敗——寫完讀回來檢查時讀不到({e}),這筆不算記成功:\n    {path.resolve()}", file=sys.stderr)
  8282	        return 2
  8283	    print(f"canary record: 落盤自驗失敗——系統說寫成功了,但讀回來找不到這一筆,這筆不算記成功:\n    {path.resolve()}",
  8284	          file=sys.stderr)
  8285	    return 2
