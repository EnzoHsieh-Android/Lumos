   754	+
   755	+def _drift_linked(env, rel):
   756	+    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
   757	+    out_e, in_e = env.edges
   758	+    got = {}
   759	+    for d in out_e.get(rel, []):
   760	+        got[d] = "out"
   761	+    for s in in_e.get(rel, []):
   762	+        got[s] = "both" if s in got else "in"
   763	+    return got
