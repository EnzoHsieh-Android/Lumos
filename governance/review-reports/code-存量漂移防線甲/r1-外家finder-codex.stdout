 14525	              file=sys.stderr)
 14526	        return 2
 14527	    path = env.vault / rel
 14528	    lines, s, e = load_raw_for_edit(path)
 14529	    new_fm = edit_fm_scalar(lines[1:e], key, value)
 14530	    exp = fmt_scalar(key, value)
 14531	    exp_val = strip_quotes(exp)
 14532	    tag_synced = False
 14533	    if key == "status":
