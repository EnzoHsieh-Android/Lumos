  1310	+def _drift_exam_load(exam):
  1311	+    """考卷 → 題目清單;讀不了或有不認得的考法回 None(已印原因)。"""
  1312	+    import json as _j
  1313	+    try:
  1314	+        qs = _j.loads(Path(exam).read_text(encoding="utf-8"))
  1315	+    except (OSError, ValueError) as ex:
  1316	+        print(f"擋下:考卷讀不了:{ex}", file=sys.stderr)
  1317	+        return None
  1318	+    if isinstance(qs, dict):
  1319	+        qs = qs.get("items") or []
  1320	+    known = ("commit", "status_replay", "probe", "current_state", "mechanism1_experiment")
  1321	+    bad = sorted({str(q.get("exam_event")) for q in qs if q.get("exam_event") not in known})
  1322	+    if bad:
  1323	+        print(f"擋下:考卷裡有不認得的考法 {bad}", file=sys.stderr)
  1324	+        return None
  1325	+    return qs
