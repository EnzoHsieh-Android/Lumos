  8292	    import json
  8293	    import datetime
  8294	    import secrets
  8295	    if not ref_id or not verdict:
 11520	# \w 在 Python 預設收所有語言的字母與數字(韓文、全形也算),不是只有中英數字——說明要照實講(代碼審 r1 通才席)。
