  1188	+            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})")
  1189	+    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
  1190	+    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
  1191	+    if wired:
  1192	+        cp = Path(root) / ".lumos" / "config.json"
  1193	+        try:
  1194	+            txt = cp.read_bytes() if cp.is_file() and not cp.is_symlink() else None
  1195	+        except OSError:
  1196	+            txt = None
  1197	+        mode, _w = _drift_config(txt)
  1198	+        if mode != "block":
  1199	+            out.append(f"這個專案的存量漂移檢查是 {mode}(.lumos/config.json 的 drift_check.gate)——轉正後留著預告句的推送不會被擋")
  1200	+        wf = Path(root) / ".github" / "workflows"
  1201	+        ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
