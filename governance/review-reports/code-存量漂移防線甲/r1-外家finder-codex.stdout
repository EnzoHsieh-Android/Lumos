 12096	        return 2
 12097	    rc = cmd_set(env, rel, "status", "abandoned")
 12098	    print(f"✓ 已棄置:{rel} 立成墓碑(不是刪掉,下一個人看得到曾經打算做什麼、為什麼不做了)")
