 24583	def _note_audit_fold(docs):
 24584	    """判定怎麼算(計劃〈做法〉第 2 節):對每個內容編號——①一般判定逐筆,被申訴過就換成所有指名它的申訴裡最重的結果;
 24585	    ②取最重(CODE > MIXED > CONTEXT);③沒有任何判定時,有略過就算略過。→ {id: 'CODE'|'MIXED'|'CONTEXT'|'SKIP'}。
 24586	    跟讀檔順序無關。"""
 24587	    disputes = {}
 24588	    for _name, d in docs.items():
 24589	        if d["kind"] == "申訴" and d.get("disputes"):
 24590	            for r in d["rows"]:
 24591	                if r["class"] in _NOTE_AUDIT_WEIGHT:
 24592	                    k = (d["disputes"], r["id"])
 24593	                    if k not in disputes or _NOTE_AUDIT_WEIGHT[r["class"]] > _NOTE_AUDIT_WEIGHT[disputes[k]]:
 24594	                        disputes[k] = r["class"]
 24595	    best, skipped = {}, set()
 24596	    for name, d in docs.items():
 24597	        if d["kind"] == "略過":
 24598	            skipped.update(r["id"] for r in d["rows"])
 24599	            continue
 24600	        if d["kind"] != "判定":
 24601	            continue
 24602	        for r in d["rows"]:
 24603	            c = r["class"]
 24604	            if c not in _NOTE_AUDIT_WEIGHT:
 24605	                continue
 24606	            c = disputes.get((name, r["id"]), c)
 24607	            if r["id"] not in best or _NOTE_AUDIT_WEIGHT[c] > _NOTE_AUDIT_WEIGHT[best[r["id"]]]:
 24608	                best[r["id"]] = c
 24609	    out = dict(best)
 24610	    for i in skipped:
 24611	        out.setdefault(i, "SKIP")
 24612	    return out
