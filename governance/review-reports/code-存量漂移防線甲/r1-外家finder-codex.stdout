 11525	def _guard_name_problem(name):
 11526	    """守衛節點短名哪裡不合格;合格回 None。"""
 11527	    n = nfc((name or "").strip())
 11528	    if not n:
 11529	        return "預告合約要給一個短名(--name)——不給的話,檔名只能拿合約原文截斷,會斷在句子中間"
 11530	    if len(n) > _GUARD_NAME_MAX:
 11531	        return f"短名太長({len(n)} 字,上限 {_GUARD_NAME_MAX} 字)"
 11532	    bad = sorted({c for c in n if not _GUARD_NAME_OK_RE.match(c)})
 11533	    if bad:
 11534	        return f"短名裡有檔名不能用的字:{' '.join(repr(c) for c in bad)}(只收字母、數字、中文、底線、連字號;不收空白與標點)"
 11535	    return None
