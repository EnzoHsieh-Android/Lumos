 11557	    # ★短名也進這張清單★(代碼審 r1 架構席):分開檢查的話,同時漏 --plan 跟 --name 要補兩次才看得到兩個問題
 11558	    missing = [(v, lbl) for v, lbl in ((plan, "計劃參照"), (phase, "階段"), (due, "最遲日期"),
 11559	                                       (why, "理由"), (owner, "負責人"), (name, "短名")) if not (v or "").strip()]
