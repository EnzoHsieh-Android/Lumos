   730	+def _drift_c3_hit(env, vrel, override=None):
   731	+    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
   732	+    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
   733	+    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。"""
   734	+    n = env.notes.get(vrel)
   735	+    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
   736	+        return None
   737	+    if n.fields.get(GUARD_MARK_FIELD):
   738	+        return None                               # 守衛紀錄到期前本來就是 pending
   739	+    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
   740	+    if not refs:
   741	+        return None
   742	+    plans = []
   743	+    for r in refs:
   744	+        prel = env.resolve(link_target(r))
   745	+        pn = env.notes.get(prel) if prel else None
   746	+        if pn is None or _drift_str(pn, "type") != "project":
   747	+            return None
   748	+        st = (override or {}).get(prel, _drift_str(pn, "status"))
   749	+        if st not in _DRIFT_CLOSED:
   750	+            return None
   751	+        plans.append(prel)
   752	+    return plans
