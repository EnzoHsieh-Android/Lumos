 30071	# ---------------------------------------------------------------------------
 30072	_LENS_HEADER = "lumos 自動附加:本次改動的固定席節點(來源 impact --diff,只供參考)"
 30073	_LENS_SHA_RE = re.compile(r"^[0-9a-f]{40}$|^[0-9a-f]{64}$")
 30074	_LENS_KIND = {"direct": "直接相依", "indirect": "間接相依", "incident": "事故", "home": "家"}
