 11600	def _guard_plan_write_node(gpath, gname, rel, prel, phases, today, claim, due, why, owner):
 11601	    """把守衛節點的內容組出來落盤,成功回 True(失敗已經印過為什麼)。
 11602	
 11603	    ★先建守衛節點(可重建的那一邊),再寫功能節點的標記(權威那一邊)★(設計審 r1 blocker):
 11604	    本 repo 的寫入原語沒有刪除這一步,真回滾搭不起來;既有兩處同類問題都是
 11605	    「先寫衍生、後寫權威,後者失敗印警告不回滾」。
 11606	    """
 11607	    guard_lines = [
 11608	        "---\n", "type: verification\n", "status: pending\n",
 11609	        f"created: {today}\n", f"updated: {today}\n", f"due: {due.strip()}\n",
 11610	        f"owner: {owner.strip()}\n",
 11611	        f"{GUARD_MARK_FIELD}:\n", f"  - {rel[:-3] if rel.endswith('.md') else rel}\n",
 11612	        "phases:\n"] + [f"  - {x}\n" for x in phases] + [
 11613	        "plan_refs:\n", f"  - \"[[{prel[:-3] if prel.endswith('.md') else prel}]]\"\n",
 11614	        "tags:\n", "  - type/verification\n", "  - status/pending\n",
 11615	        "summary: |-\n",
 11616	        f"  WHY:[{today}]預告這條合約但還沒做:{why.strip()}\n",
 11617	        f"  TEST:還沒有測試在守這條;最遲 {due.strip()} 要做完,負責人 {owner.strip()}\n",
 11618	        "---\n", f"# {gname}\n", "\n",
 11619	        f"預告的合約:{claim.strip()}\n", "\n",
 11620	        f"為什麼還不做:{why.strip()}\n", "\n",
 11621	        "做完之後跑 `lumos guard settle` 轉正,不要手改狀態。\n",
 11622	    ]
 11623	    # 新建檔走 vault 唯一寫入原語(tmp→os.replace);atomic_write_verify 是給「改既有檔」用的,
 11624	    # 它會先讀原檔,對新檔會 FileNotFoundError。寫完自己讀回驗一次(★回報成功未落盤★的老教訓)。
 11625	    try:
 11626	        _write_lf(gpath, "".join(guard_lines))
 11627	        _back = gpath.read_text(encoding="utf-8")
 11628	        if "status: pending" not in _back or claim.strip() not in _back:
 11629	            raise RuntimeError("寫完讀回來對不上")
 11630	    except (OSError, RuntimeError) as ex:
 11631	        print(f"擋下:守衛節點寫不進去,什麼都沒動: {ex}", file=sys.stderr)
 11632	        return False
 11633	    return True
