  1212	+def _drift_set_status_text(text, status):
  1213	+    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
  1214	+    lines = text.split("\n")
  1215	+    e = _drift_fm_end(lines)
  1216	+    if not e:
  1217	+        return text
  1218	+    fm = edit_fm_scalar(lines[1:e], "status", status)
  1219	+    fm, _s = edit_fm_sync_status_tag(fm, status)
  1220	+    return "\n".join(lines[:1] + fm + lines[e:])
  1221	+
  1222	+
  1223	+def _drift_exam_one(root, vault_rel, q, at_sha):
  1224	+    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
  1225	+    ev = q.get("exam_event")
  1226	+    note = q.get("note_at_event") or q.get("note")
  1227	+    line = q.get("line")
  1228	+    if ev == "current_state":
  1229	+        tenv = _drift_tree_env(root, at_sha, vault_rel)
  1230	+        if tenv is None:
  1231	+            return "略過:git 讀不出樹", 0, 0, 0
  1232	+        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
  1233	+        return ("誤列" if hit else "沒誤列"), 0, 0, 0
  1234	+    commits = q.get("invalidating_commits") or []
  1235	+    if ev not in ("commit", "status_replay") or not commits:
  1236	+        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
  1237	+    c = _lens_full_sha(root, commits[0])
  1238	+    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
  1239	+    if c is None or par is None:
  1240	+        return "略過:找不到失效提交或它的上一版", 0, 0, 0
  1241	+    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
  1242	+    others_m = [f for f in must if f["path"] != note]
  1243	+    others_l = [f for f in listed if f["path"] != note]
  1244	+    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
  1245	+    in_must = any(f["path"] == note and f["line"] == line for f in must)
  1246	+    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
  1247	+    if ev == "status_replay":
  1248	+        texts = {}
  1249	+        tenv0 = _drift_tree_env(root, par, vault_rel)
  1250	+        if tenv0 is None:
  1251	+            return "略過:git 讀不出上一版", 0, 0, 0
  1252	+        for t in q.get("status_targets") or []:
  1253	+            prel = tenv0.resolve(link_target(t))
  1254	+            if prel:
  1255	+                texts[prel] = _drift_set_status_text(env_text(tenv0, prel), "done")
  1256	+        tenv = _drift_tree_env(root, par, vault_rel, override=texts)
  1257	+        fu = set()
  1258	+        for prel in texts:
  1259	+            fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
  1260	+        in_list = in_list or note in fu
  1261	+    res = "擋到" if in_must else ("點到" if in_list else "漏")
  1262	+    return res, len(others_m), len(others_l), noise
