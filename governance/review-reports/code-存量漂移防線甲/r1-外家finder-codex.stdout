 11776	def _guard_planned_prose(line, region, settled_ok=False):
 11777	    """這一行是不是 guard plan 寫的預告句 → 'test'|'why'|'whynot'|'settle' 或 None。
 11778	    region 是 _notelines_regions 給的那一行所在區。WHY 行尾已經有「已轉正」不算預告
 11779	    (settled_ok=True 時回 'why-done',給 settle 分辨「已經改過」與「找不到」)。"""
 11780	    s = line.strip()
 11781	    if region == "summary":
 11782	        if s.startswith("TEST:還沒有測試在守這條"):
 11783	            return "test"
 11784	        if s.startswith("WHY:[") and _GUARD_WHY_MID in s:
 11785	            if _GUARD_SETTLED_TAIL_RE.search(s):
 11786	                return "why-done" if settled_ok else None
 11787	            return "why"
 11788	    elif region == "body":
 11789	        if s.startswith("為什麼還不做:"):
 11790	            return "whynot"
 11791	        if s.startswith("做完之後跑 `lumos guard settle` 轉正"):
 11792	            return "settle"
 11793	    return None
