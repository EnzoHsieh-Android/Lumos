   705	+def _drift_str(n, key):
   706	+    v = n.fields.get(key, "") if n is not None else ""
   707	+    return v.strip() if isinstance(v, str) else ""
   708	+
   709	+
   710	+def _drift_fm_end(lines):
   711	+    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
   712	+    if not lines or lines[0].strip() != "---":
   713	+        return 0
   714	+    for i in range(1, len(lines)):
   715	+        if lines[i].strip() == "---":
   716	+            return i
   717	+    return 0
   718	+
   719	+
   720	+def _drift_field_line(text, key):
   721	+    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。"""
   722	+    lines = text.split("\n")
   723	+    for i in range(1, _drift_fm_end(lines)):
   724	+        m = TOP_KEY_RE.match(lines[i])
   725	+        if m and m.group(1) == key:
   726	+            return i + 1
   727	+    return 1
