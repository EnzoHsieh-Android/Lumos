   176	+def _dr_guard_text(status="pending", home="Systems/Pay", claim="大額退費要人工核可", why="下游介面還沒定案",
   177	+                   plan="Projects/退款_計劃", prose=True, settled_why=False):
   178	+    """一篇 guard plan 樣板長相的守衛紀錄(直接寫檔,不經指令——用來造「舊版 settle 轉正後留著預告句」的現場)。"""
   179	+    wline = f"  WHY:[2026-09-01]預告這條合約但還沒做:{why}" + ("(2026-09-20 已轉正)" if settled_why else "")
   180	+    summ = [wline, "  TEST:還沒有測試在守這條;最遲 2099-12-31 要做完,負責人 enzo"] if prose else ["  KEY:x"]
   181	+    body = [f"預告的合約:{claim}", ""]
   182	+    if prose:
   183	+        body += [f"為什麼還不做:{why}", "", "做完之後跑 `lumos guard settle` 轉正,不要手改狀態。"]
   184	+    return ("---\ntype: verification\nstatus: " + status + "\ncreated: 2026-09-01\nupdated: 2026-09-01\n"
   185	+            "due: 2099-12-31\nowner: enzo\nguards:\n  - " + home + "\nphases:\n  - P1\nplan_refs:\n"
   186	+            f"  - \"[[{plan}]]\"\ntags:\n  - type/verification\n  - status/{status}\nsummary: |-\n"
   187	+            + "\n".join(summ) + "\n---\n# G\n\n" + "\n".join(body) + "\n")
   188	+
   189	+
   190	+def _dr_repo(cfg=None, golive=True):
   191	+    """存量漂移的測試專案:每支檔有家那個骨架 + 含 drift check 上線標記的推送前掛鉤 + 家筆記 Pay 與計劃。"""
   192	+    root = _nh_repo(cfg)
   193	+    if golive:
   194	+        _nh_file(root, "scripts/hooks/pre-push", "#!/bin/bash\n# lumos drift check\n")
   195	+    _nh_node(root, "Pay", summary="FLOW:a")
   196	+    _nh_node(root, "退款_計劃", typ="project", folder="Projects", resp=None, summary="KEY:p")
   197	+    _nh_commit(root, "init")
   198	+    return root
   199	+
   200	+
   201	+def _dr(root, *args, env=None):
   202	+    import subprocess as sp, os as _os
   203	+    e = dict(_os.environ)
   204	+    e.pop("LUMOS_SKIP_DRIFT_CHECK", None)
   205	+    if env:
   206	+        e.update(env)
   207	+    r = sp.run([sys.executable, GRAPHCTL, "drift", *args, "--repo", str(root)], capture_output=True, text=True, env=e)
   208	+    return r.returncode, r.stdout + r.stderr
   209	+
   210	+
   211	+def _dr_scan(vault, *extra):
   212	+    import json as _j
   213	+    r = run(vault, "drift", "scan", "--json", *extra)
   214	+    return _j.loads(r.stdout)["findings"] if r.returncode == 0 else r.stdout + r.stderr
