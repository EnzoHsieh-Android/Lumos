 24445	def _notes_status_flipped(repo_root, base_where, tip_where, vault_rel, reader, tip_ok, flip):
 24446	    """範圍裡有某個提交讓 status 發生 flip(前一版狀態, 後一版狀態) 的筆記 → [路徑];tip_ok(type, 終點 status) 先篩。
 24447	    筆記內容審(計劃收尾)與存量漂移守衛(守衛紀錄 pending→pass)共用(存量漂移防線_計劃:不另寫一套逐提交讀狀態)。"""
 24448	    # 候選=範圍裡任一個提交碰過的筆記,不是頭尾淨差異:收尾→改回→再收尾時頭尾一模一樣,淨差異看不到(S3)
 24449	    rng0 = f"{base_where}..{tip_where}" if base_where else tip_where
 24450	    touched = _ns_git(repo_root, "log", "--format=", "--name-only", "-z", "-M", rng0, "--", vault_rel)
 24451	    if touched is None:
 24452	        return None
 24453	    out = []
 24454	    for p in sorted({x.strip("\n") for x in touched.decode("utf-8", errors="surrogateescape").split("\0")
 24455	                     if x.strip("\n").endswith(".md")}):
 24456	        ty, st = _note_audit_status_of(reader(p))
 24457	        if not tip_ok(ty, st):
 24458	            continue
 24459	        rng = f"{base_where}..{tip_where}" if base_where else tip_where
 24460	        lg = _ns_git(repo_root, "log", "--follow", "--format=%H", "--name-only", "-z", rng, "--", p)
