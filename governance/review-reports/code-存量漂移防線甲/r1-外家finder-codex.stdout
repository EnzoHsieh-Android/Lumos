  1271	+    if at_sha is None:
  1272	+        print(f"擋下:{repo} 找不到 {at or 'HEAD'}", file=sys.stderr)
  1273	+        return 2
  1274	+    vault_rel = _drift_vault_rel(root, at_sha)
  1275	+    if vault_rel is None:
  1276	+        print(f"擋下:{repo} 沒有圖譜", file=sys.stderr)
