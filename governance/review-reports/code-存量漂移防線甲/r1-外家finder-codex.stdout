  1265	+def cmd_drift_exam(exam, repo, probes=None, at=None, history=None, as_json=False):
  1266	+    """lumos drift exam <考卷.json> --repo <被考的 repo>:在被考 repo 的歷史上重放(計劃〈做法〉第 3 節)。
  1267	+    不寫治理帳、不寫任何檔。--history N:改成對被考 repo 最近 N 個主線提交各跑一次 check,列出每筆要處理(門檻②)。"""
  1268	+    import json as _j
