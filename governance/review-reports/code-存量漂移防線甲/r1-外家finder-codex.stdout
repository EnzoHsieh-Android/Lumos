 12102	def cmd_guard_required(env, as_json=False):
 12103	    """列必要集合現況:待完成幾條、逾期幾條、快到期幾條。"""
 12104	    import datetime
 12105	    today = datetime.date.today()
 12106	    rows, overdue, soon = [], [], []
 12107	    for rel, n in _guard_nodes(env):
 12108	        st = str(n.fields.get("status") or "")
 12109	        due = str(n.fields.get("due") or "").strip()
 12110	        home = _guard_home_of(n)
 12111	        owner = str(n.fields.get("owner") or "").strip()
 12112	        body = (env.vault / rel).read_text(encoding="utf-8")
 12113	        m = re.search(r"^預告的合約:(.+)$", body, re.M)
 12114	        claim = (m.group(1).strip() if m else rel)
 12115	        rows.append((rel, st, due, home, owner, claim))
 12116	        if st != "pending":
 12117	            continue
 12118	        try:
 12119	            d = datetime.date.fromisoformat(due)
 12120	        except ValueError:
 12121	            continue
 12122	        # ★到期當天不算過期,隔天才算★:最遲日期是人手寫的本地日期;
 12123	        # 誤擋一次的代價比漏擋一天高(設計審 r1)
 12124	        if d < today:
 12125	            overdue.append((rel, due, owner, claim))
 12126	        elif (d - today).days <= 7:
 12127	            soon.append((rel, due, owner, claim))
 12128	    pend = [r for r in rows if r[1] == "pending"]
 12129	    print(f"必要合約:待完成 {len(pend)}、逾期 {len(overdue)}、快到期(七天內) {len(soon)}、"
 12130	          f"已通過 {len([r for r in rows if r[1] == 'pass'])}、"
 14435	        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
 14436	    return primary, None
