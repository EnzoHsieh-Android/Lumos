 23752	def _notelines_parse_added(raw):
 23753	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23754	    out, path, n = {}, None, 0
 23755	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23756	        if ln.startswith("+++ "):
 23757	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23758	            path = nfc(p[2:]) if p.startswith("b/") else None
 23759	            continue
 23760	        if ln.startswith("@@"):
 23761	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23762	            n = int(m.group(1)) if m else 0
 23763	            continue
 23764	        if path is None or ln.startswith("---"):
 23765	            continue
 23766	        if ln.startswith("+"):
 23767	            out.setdefault(path, []).append((n, ln[1:]))
 23768	            n += 1
 23769	    return out
 23770	
