 11799	def _guard_formal_line(lines, e, claim, method=None):
 11800	    """家筆記的摘要裡有沒有這條合約的正式行:合約文字相同、行內有 [test:<方法>](method=None 時任一方法);
 11801	    後來 guard audit 加的 [audit:…] 等標記不影響比對(存量漂移防線 [S5])。"""
 11802	    for i in range(1, e):
 11803	        m = INVARIANT_RE.match(lines[i].strip())
 11804	        if not m:
 11805	            continue
 11806	        if method is not None and f"[test:{method}]" not in lines[i]:
 11807	            continue
 11808	        if method is None and not TEST_REF_RE.search(lines[i]):
 11809	            continue
 11810	        if _GUARD_MARKS_RE.sub("", m.group(1)).strip() == claim:
 12035	        for ln in log.read_text(encoding="utf-8").splitlines():
 12036	            if not ln.strip():
 12037	                continue
 12038	            try:
 12039	                d = _j.loads(ln)
 12040	            except ValueError:
 12041	                continue
 12042	            r = str(d.get("ref") or "").strip()
 12043	            if r:
 12044	                refs.add(r)
 12045	                refs.add(r[:-3] if r.endswith(".md") else r)
 12046	    except OSError:
 12047	        pass
 12048	    return refs
