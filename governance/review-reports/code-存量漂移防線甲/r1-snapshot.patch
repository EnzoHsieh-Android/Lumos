+def _drift_old_reason(f, acks):
+    """表態失效時(改了那一行或筆記改名),用「原文與種類相同」找舊理由供照抄。"""
+    for a in reversed(acks):
+        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
+            return a.get("reason")
+    return None
