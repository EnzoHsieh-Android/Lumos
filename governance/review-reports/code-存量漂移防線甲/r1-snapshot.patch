+    _nh_file(root2, "scripts/hooks/pre-push", "#!/bin/bash\n# lumos drift check\n")
+    _nh_commit(root2, "上線")
+    rc, out = _dr(root2, "check", "--diff", f"{b2}..HEAD")
+    check("⑩上線點之前的轉正不查(起點截到推送前掛鉤出現標記的提交)", rc == 0, out)
