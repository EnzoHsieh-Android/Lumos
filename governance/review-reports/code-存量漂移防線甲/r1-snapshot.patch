+def _drift_report_must(root, mode, must, unknown, acks):
+    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
+    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
+    print(f"{head}:這次推送有 {len(must)} 處要處理(存量漂移檢查)——", file=sys.stderr)
