 25756	    commits = q.get("invalidating_commits") or []
 25757	    if ev not in ("commit", "status_replay") or not commits:
 25758	        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
 25759	    c = _lens_full_sha(root, commits[0])
 25760	    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
 25761	    if c is None or par is None:
 25762	        return "略過:找不到失效提交或它的上一版", 0, 0, 0
 25763	    vault_rel = _drift_vault_rel(root, c) or vault_rel      # 那個提交自己的圖譜位置(代碼審 r1 外家席)
 25764	    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
 25765	    hit_kind = next((f["kind"] for f in must + listed if f["path"] == note and f["line"] == line), None)
 25766	    others_m = _drift_exam_others(must, note, line, hit_kind)
 25767	    others_l = _drift_exam_others(listed, note, line, hit_kind)
 25768	    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
 25769	    in_must = any(f["path"] == note and f["line"] == line for f in must)
 25770	    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
 25771	    if ev == "status_replay":
