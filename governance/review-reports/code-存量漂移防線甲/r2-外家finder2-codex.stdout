 25775	        in_list = in_list or note in fu
 25776	    res = "擋到" if in_must else ("點到" if in_list else "漏")
 25777	    return res, len(others_m), len(others_l), noise
 25778	
 25779	
 25780	def _drift_exam_replay(root, par, vault_rel, targets):
 25781	    """status_replay:取上一版的樹,在記憶體裡把 targets 每一份計劃改成 done,回 lumos set 會列的連帶待辦路徑集合。"""
 25782	    tenv0 = _drift_tree_env(root, par, vault_rel)
 25783	    if tenv0 is None:
 25784	        return None
 25785	    texts = {}
 25786	    for t in targets:
 25787	        prel = tenv0.resolve(link_target(t))
 25788	        if prel:
 25789	            texts[prel] = _drift_set_status_text(env_text(tenv0, prel), "done")
 25790	    tenv = _drift_tree_env(root, par, vault_rel, override=texts)
 25791	    fu = set()
 25792	    for prel in texts:
 25793	        fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
 25794	    return fu
 25795	
 25796	
 25797	def _drift_exam_others(findings, note, line, kind):
 25798	    """考題那一行以外、算誤報的發現:排除題目那一行,以及同一篇同一種的兄弟句(c1 一句一筆,同一個轉正事件的
 25799	    另外幾句預告句是真發現,不是亂抓);同一篇別種的、別篇的都算(代碼審 r1 外家席:原本同一篇全部排除,誤報被低估)。"""
 25800	    return [f for f in findings if not (f["path"] == note and (f["line"] == line or (kind and f["kind"] == kind)))]

