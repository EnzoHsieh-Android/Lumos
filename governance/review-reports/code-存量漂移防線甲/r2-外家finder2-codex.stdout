  7352	def normalize_report_text(text):
  7353	    """[審查有沒有用記帳 S1/S4] 把席報告常見的嚴重度寫法機械轉成 SOP 格式(獨立一行 severity: <值>),回 (新文字, 改了幾處, 還剩的殘留清單)。
  7354	    做的事只有三種、都是純格式:①行內/列表/粗體的 `severity: X ...` → 一行 `severity: X` + 其餘文字另起一行;
  7355	    ②標題裡嵌等級(`### F1 —— severity: blocker,blocking: 是` / `## F1 — BLOCKER`)→ 標題保留、下一行插 `severity: x`;
  7356	    ③第一個宣告不在檔首 → 檔首插一行檔級宣告(值=所有宣告裡最高的;原本就有檔級行則不動)。
  7357	    ★不碰內容、不改 severity 值、不動引句/圍欄★;轉不了的原樣留下,由 _report_normalize_issues 印給人改。"""
  7358	    if text.startswith("\ufeff"):
  7359	        text = text[1:]; changed_bom = 1   # codex r1 f4:BOM 剝掉算一處修改
  7360	    else:
  7361	        changed_bom = 0
  7362	    lines = text.splitlines()
  7363	    out, changed = [], changed_bom
  7364	    fence = None
  7365	    for ln in lines:
  7366	        s = ln.lstrip(" ")
  7367	        if s.startswith(("```", "~~~")) and len(ln) - len(s) <= 3:
  7368	            ch = s[0]; run = len(s) - len(s.lstrip(ch))
  7369	            if fence is None: fence = (ch, run)
  7370	            elif ch == fence[0] and run >= fence[1]: fence = None
  7371	            out.append(ln); continue
  7372	        if fence is not None or s.startswith(("引句:", "引句：", ">")) or _SEV_DECL_LINE_RE.fullmatch(ln):
  7373	            out.append(ln); continue
  7374	        if _SEV_SUMMARY_LINE_RE.search(ln):
  7375	            out.append(ln); continue
  7376	        m = _SEV_INLINE_DECL_RE.match(ln)
  7377	        if m and "`" in ln[:m.start(2)]:
  7378	            m = None   # 反引號裡的是在講格式,不轉
  7379	        if m:
  7380	            out.append(f"severity: {m.group(2).lower()}")
  7381	            rest = m.group(3).strip().lstrip("/／|,，;；").strip()
  7382	            if rest:
  7383	                out.append(rest)
  7384	            changed += 1
  7385	            continue
  7386	        m = _SEV_HEADING_DECL_RE.match(ln)
  7387	        if m:
  7388	            out.append(m.group(1).rstrip())
  7389	            out.append(f"severity: {m.group(2).lower()}")
  7390	            rest = m.group(3).strip()
  7391	            if rest:
  7392	                out.append(rest)
  7393	            changed += 1
  7394	            continue
  7395	        out.append(ln)
  7396	    decl = _report_severities("\n".join(out))
  7397	    i = 0
  7398	    while i < len(out) and not out[i].strip():
  7399	        i += 1
  7400	    if decl and not (i < len(out) and _SEV_DECL_LINE_RE.fullmatch(out[i])):
  7401	        top = max(decl, key=lambda v: _SEV_ORDER[v])
  7402	        out.insert(i, f"severity: {top}")
  7403	        changed += 1
  7404	    new = "\n".join(out) + ("\n" if text.endswith("\n") else "")
  7405	    return new, changed, _report_normalize_issues(new)
