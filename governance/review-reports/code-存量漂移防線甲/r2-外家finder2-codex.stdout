        print(f"擋下:守衛節點寫不進去,什麼都沒動: {ex}", file=sys.stderr)
        return False
    return True


def cmd_guard_plan(env, node, claim, plan, phase, due, why, owner, name=None):
    """預告一條之後要有的合約:寫標記 + 建待完成守衛節點,雙向連好。

    ★從檢查到寫完整段拿寫入鎖★(存量漂移防線_計劃 [S19],設計審 r3 外家席):原本改家筆記在鎖外,
    同時跑的 settle 會用舊內容蓋掉這裡剛寫的預告行,留下一篇 pending 守衛紀錄卻沒有預告行。"""
    with _vault_write_lock(env.vault):
        return _guard_plan_locked(env, node, claim, plan, phase, due, why, owner, name)


def _guard_plan_locked(env, node, claim, plan, phase, due, why, owner, name=None):
    import datetime
    checked = _guard_plan_check(env, node, claim, plan, phase, due, why, owner, name)
    if checked is None:
        return 2
    rel, prel, phases, gname, gpath = checked
    today = datetime.date.today().isoformat()

    if not _guard_plan_write_node(gpath, gname, rel, prel, phases, today, claim, due, why, owner):
        return 2
    # ── 再寫功能節點的預告標記
    gref = f"Verification/{gname}"
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"⚠ 守衛節點已建好({gref}),但功能節點打不開,標記沒寫進去: {ex}", file=sys.stderr)
        print("  不回滾(本 repo 的寫入原語沒有刪除這一步);手動補標記或把守衛節點刪掉重來", file=sys.stderr)
        return 2
    # ★行尾不帶換行★:load_raw_for_edit 回來的每一行都已經去掉換行,自己再加一個會多出空行
    marker = f"  KEY:{PLANNED_MARK} {claim.strip()} [watch:{gref}] [due:{due.strip()}]"
    # 插在摘要區塊第一行之前。★要跳過 summary: 那一行本身之後可能已有的空白行★,
    # 不然會在標記後面留一個空行,讀起來像摘要斷成兩段。
    ins = None
    for i in range(1, e):
        if lines[i].startswith("summary:"):
            ins = i + 1
            while ins < e and not lines[ins].strip():
                ins += 1
            break
    if ins is None:
        print(f"⚠ 守衛節點已建好({gref}),但功能節點沒有摘要區塊,標記沒寫進去", file=sys.stderr)
        print("  不回滾;先給那篇補 summary 再手動加這一行:", file=sys.stderr)
        print("    " + marker.strip(), file=sys.stderr)
        return 2
    new_lines = [*lines[:ins], marker, *lines[ins:]]
    try:
        atomic_write_verify(path, new_lines, PLANNED_MARK,
                            lambda f: PLANNED_MARK in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"⚠ 守衛節點已建好({gref}),但標記寫不進功能節點: {ex}", file=sys.stderr)
        print("  不回滾;手動補上這一行:", file=sys.stderr)
        print("    " + marker.strip(), file=sys.stderr)
        return 2
    # ★還要掛 verified_by★:不掛的話守衛節點在自檢裡是「沒人引用的孤兒驗證紀錄」,
    # 等於預告一條合約就多一個 issue——防忘記的機制自己製造雜訊,人會學會忽略它。
    # 掛了也順便讓「查那篇功能節點就看得到它」成立(設計審重點)。
    _rc_v = cmd_append(env, rel, "verified_by", f"[[{gref}]]")
    if _rc_v != 0:
        print("⚠ 標記與守衛節點都寫好了,但 verified_by 沒掛上——它會被當成孤兒驗證紀錄", file=sys.stderr)
        print(f"  手動補:lumos append {rel[:-3] if rel.endswith('.md') else rel} verified_by \"[[{gref}]]\"", file=sys.stderr)
    print(f"✓ 預告合約已登記:{rel} 多了一行預告標記,{gref} 在守它")
    print(f"  最遲 {due.strip()} 要做完(負責人 {owner.strip()});逾期會擋推送,而且不准延期")
    print(f"  做完之後:lumos guard settle {gref} --test <測試方法名>")
    return 0


def _guard_nodes(env):
    """帶本機制標記的守衛節點。★判準放節點身上,不看 status 字面值、不查外部帳★
    (設計審:手寫 pending 的人不該被拖進整套規則;判準跟著節點走,改名搬家都對得上)。"""
    out = []
    for rel, n in sorted(env.notes.items()):
        if n.fields.get("type") != "verification":
            continue
        g = n.fields.get(GUARD_MARK_FIELD)
        if not g:
            continue
        out.append((rel, n))
    return out


def _guard_find(env, ref):
    rel = env.find(ref)
    if rel is None:
        return None, None
    n = env.notes.get(rel)
    if n is None or not n.fields.get(GUARD_MARK_FIELD):
        return None, None
    return rel, n


def _guard_planned_line(env, home_rel, claim):
    """在功能節點裡找那一行預告標記,回 (lines, idx, e, err)。

    ★比照既有引擎的兩道防呆★(代碼審 r1 blocker):`cmd_guard_bind`/`cmd_guard_audit` 對
    「在功能節點裡找某條 KEY 行」都會 ①命中多條就擋,不猜是哪一條 ②找不到就擋。
    第一版用「合約前 12 字」當子字串比對,同一篇預告兩條而前 12 字相同時會改到別條、互相覆蓋。
    這裡改成比對「剝掉 [watch:]/[due:] 之後的完整文字」,並保留多條就擋。"""
    path = env.vault / home_rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        return None, None, None, f"{home_rel} 打不開:{ex}"
    want = (claim or "").strip()
    idx = None
    for i in range(1, e):
        m = PLANNED_RE.match(lines[i].strip())
        if not m:
            continue
        body = _PLANNED_TAIL_RE.sub("", m.group(1)).strip()
        if body != want:
            continue
        if idx is not None:
            return None, None, None, (f"{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條"
                                      "——先手動把重複的那行處理掉")
        idx = i
    if idx is None:
        return None, None, None, f"{home_rel} 裡找不到預告行『{want[:30]}』(被手改過或已經轉正?)"
    return lines, idx, e, None


def _guard_home_of(n):
    return _guard_home_of_fields(n.fields)


def _guard_home_of_fields(fields):
    g = fields.get(GUARD_MARK_FIELD)
    if isinstance(g, list) and g:
        return str(g[0]).strip()
    return str(g or "").strip()


# ★預告句型只有這一份★(存量漂移防線_計劃〈做法〉第 1 節):guard plan 樣板(_guard_plan_write_node)寫出的
# 四種預告句,settle 轉正時改寫、狀態一致檢查 c1 找殘留,兩邊用同一支比對——各寫一份的話,settle 改完的
# 句子可能又被 c1 認成預告,轉正後的推送被自己擋(設計審 r3 正確性席)。從行首比對(去掉摘要縮排);
# 第四句照樣板的實際字元,含反引號(r3 邊界席:照設計稿漏掉反引號會永遠對不上)。
_GUARD_WHY_MID = "]預告這條合約但還沒做:"
_GUARD_SETTLED_TAIL_RE = re.compile(r"已轉正\)\s*$")
_GUARD_PROSE_KINDS = ("test", "why", "whynot", "settle")


def _guard_planned_prose(line, region, settled_ok=False):
    """這一行是不是 guard plan 寫的預告句 → 'test'|'why'|'whynot'|'settle' 或 None。
    region 是 _notelines_regions 給的那一行所在區。WHY 行尾已經有「已轉正」不算預告
    (settled_ok=True 時回 'why-done',給 settle 分辨「已經改過」與「找不到」)。"""
    s = line.strip()
    if region == "summary":
        if s.startswith("TEST:還沒有測試在守這條"):
            return "test"
        if s.startswith("WHY:[") and _GUARD_WHY_MID in s:
            if _GUARD_SETTLED_TAIL_RE.search(s):
                return "why-done" if settled_ok else None
            return "why"
    elif region == "body":
        if s.startswith("為什麼還不做:"):
            return "whynot"
        if s.startswith("做完之後跑 `lumos guard settle` 轉正"):
            return "settle"
    return None


_GUARD_TAIL_MARKS_RE = re.compile(r"(?:\s*\[[A-Za-z_-]+:[^\]]*\])*\s*")


def _guard_formal_line(lines, e, claim, method=None):
    """家筆記的摘要裡有沒有這條合約的正式行 → 行索引或 None:合約原文開頭、後面只剩標記(工具接在行尾的
    [test:…] 與後來 guard audit 加的 [audit:…]),而且標記裡有 [test:<方法>](method=None 時任一方法)(存量漂移防線 [S5])。
    ★只剝行尾那串標記★(代碼審 r1 正確性席、外家席:合約原文自己帶 [鍵:值] 時,剝掉全部標記就永遠對不上原文——
    guard-kill 記過的同一型坑);★只看摘要★(外家席:其他開頭欄位裡的同一句會被誤認成正式行,假綠)。"""
    regs = _notelines_regions("\n".join(lines))
    for i in range(1, e):
        if i < len(regs) and regs[i] != "summary":
            continue
        m = INVARIANT_RE.match(lines[i].strip())
        if not m:
            continue
        body = m.group(1).strip()
        if not body.startswith(claim):
            continue
        tail = body[len(claim):]
        if not _GUARD_TAIL_MARKS_RE.fullmatch(tail):
            continue
        if (f"[test:{method}]" in tail) if method is not None else bool(TEST_REF_RE.search(tail)):
            return i
    return None


def _guard_settle_rewrite(lines, today, home_link):
    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。"""
    regs = _notelines_regions("\n".join(lines))
    out, seen = [], set()
    for i, ln in enumerate(lines):
        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
        if k is None:
            out.append(ln)
            continue
        seen.add("why" if k == "why-done" else k)
        ind = ln[:len(ln) - len(ln.lstrip())]
        if k == "test":
            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
        elif k == "why":
            out.append(f"{ln.rstrip()}({today} 已轉正)")
        elif k == "whynot":
            out.append(f"{ind}預告當時{ln.lstrip()}")
        elif k == "settle":
            out.append(f"{ind}({today} 已轉正)")
        else:
            out.append(ln)
    return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]


def _guard_touched_hits(files, touched):
    """家節點管的那些檔,跟這次改到的檔對得上哪幾個。回 (對上的清單, 是不是只在忽略大小寫時才對上)。

    ★比對鍵走既有那支★(代碼審 r2 架構席 blocker):about_code 的比對鍵全 repo 只有一個算法
    `_nodehome_key`(路徑正規化 + NFC),2026-09-10 那輪代碼審就是為了收斂「三處各寫一份、
    各版解得不一樣」才立的。第一版自己刻了一份,解不了 `a/../b`——而那正是這個 repo
    自己認證過、也修過一次的人手寫法,漏掉的話該擋的推送會安靜放行。

    在那之上多兩條**只會多擋、不會少擋**的保險:家節點寫的是資料夾(看底下的檔)、只有忽略大小寫
    才對得上。寫入端(`_about_code_path`)確實已經擋掉這兩種寫法(要求是檔案、大小寫要跟磁碟一致),
    所以走指令寫進去的不會踩到;留著是因為★寫入端的保證不等於讀取端的保證★——開頭欄位可以被手改,
    而這一層漏掉是沒人會發現的(多擋一次訊息會講清楚為什麼)。
    """
    tset = {_nodehome_key(x) for x in touched}
    tset.discard("")
    hits, only_case = [], []
    for raw in files:
        f = _nodehome_key(raw)
        if not f:
            continue
        if f in tset:
            hits.append(raw)
            continue
        under = sorted(x for x in tset if x.startswith(f + "/"))
        if under:
            hits.append(f"{raw}(底下的 {under[0]})")
            continue
        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上
        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。
        same = sorted(x for x in tset if x.lower() == f.lower())
        if same:
            hits.append(f"{raw}(大小寫不同:{same[0]})")
            only_case.append(raw)
    return hits, only_case


def _guard_touches(gn, env, touched):
    """這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。

    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):
    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。
    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。
    """
    if touched is None:
        return True, ""            # 沒給清單=CI 那一層,照舊全擋
    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點
    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。
    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]
    if not homes:
        return False, ";這篇沒寫它守的是哪篇功能節點,算不出有沒有碰到"
    files, found, missing, nocode = [], [], [], []
    for home in homes:
        hrel = env.find(home)
        hn = env.notes.get(hrel) if hrel else None
        if hn is None:
            missing.append(home)
            continue
        found.append(hrel)
        got = [str(x).strip() for x in as_list(hn.fields.get("about_code")) if str(x).strip()]
        if got:
            files += got
        else:
            nocode.append(hrel)
    # ★連結斷掉的那幾篇,不管這次擋不擋都要講★(代碼審 r2 通才席):
    # 半條算得出來、半條算不出來時,算不出來的那半原本會無聲消失,那條合約就一直帶著沒人發現的壞連結。
    broken = f"(另外 {'、'.join(missing)} 這幾篇找不到,連結可能斷了)" if missing else ""
    if not files:
        if missing and not found:
            return False, f";找不到它守的功能節點 {'、'.join(missing)},算不出有沒有碰到"
        return False, f";{'、'.join(nocode)} 沒寫它管哪幾支檔(about_code),算不出有沒有碰到{broken}"
    hits, only_case = _guard_touched_hits(files, touched)
    if hits:
        # ★只列解析得到的那幾篇★(代碼審 r2 通才席):這句話存在的目的是讓被擋的人知道去哪篇查,
        # 把找不到的節點也列進來,照著查的人會撲空。
        # ★收窄的粒度是「整篇家節點」不是「每條合約」★(代碼審 r1):同一篇掛兩條逾期合約時兩條都會擋。
        # 做得更細要讓每條合約自己記檔案清單(另一套資料);現在的代價是偶爾多擋一條,方向安全,
        # 但要讓人看得出來為什麼,不要變成無法解釋的誤擋。
        why = f";你這次改到 {'、'.join(hits[:3])}(它掛在 {'、'.join(found[:2])} 底下){broken}"
        if only_case and len(only_case) == len(hits):
            why += "——只有忽略大小寫才對得上,寧可多擋一次也不漏"
        return True, why
    return False, ("" if not broken else f";這次沒碰到它管的檔{broken}")


def cmd_guard_settle(env, ref, method):
    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過,四種預告句改成歷史說法。

    ★整段拿寫入鎖、守衛紀錄一次寫入、做到一半可以補完★(存量漂移防線_計劃 [S4][S5][S19]):
    原本第一步在鎖外、第二步才經 cmd_set 拿鎖,中間斷掉會留下「家筆記是正式行、守衛紀錄還是 pending」,
    舊版再跑 settle 找不到預告行就擋,guard-kill 記過這種卡死。"""
    if not IDENT_RE.match(method or ""):
        print(f"擋下:測試方法名『{method}』不合法(只能字母/數字/底線,不能數字開頭)", file=sys.stderr)
        return 2
    with _vault_write_lock(env.vault):
        return _guard_settle_locked(env, ref, method)


def _guard_settle_locked(env, ref, method):
    rel, _n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    gpath = env.vault / rel
    # ★狀態從磁碟重讀★:env 是指令開頭載入的,拿到鎖之前可能已經被另一個程序轉正了
    try:
        glines, _s, ge = load_raw_for_edit(gpath)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{rel} 打不開:{ex}", file=sys.stderr)
        return 2
    gfields = parse_frontmatter(glines[1:ge])[0]
    st = str(gfields.get("status"))
    if st == "pass":
        # 另一個程序剛做完、或重跑:結果已經是要的樣子,當成功(設計審 r3 併發席)
        print(f"已轉正,不用再做:{rel} 已經是 pass")
        return 0
    if st != "pending":
        print(f"擋下:{rel} 現在是 {st},只有待完成的才能轉正", file=sys.stderr)
        return 2
    home = _guard_home_of_fields(gfields)
    home_rel = env.find(home)
    if home_rel is None:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到", file=sys.stderr)
        return 2
    m = re.search(r"^預告的合約:(.+)$", "\n".join(glines), re.M)
    claim = m.group(1).strip() if m else ""
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條", file=sys.stderr)
        return 2
    if not _guard_settle_home(env, home_rel, claim, method):
        return 2
    return _guard_settle_record(gpath, glines, ge, rel, home_rel, method)


def _guard_settle_home(env, home_rel, claim, method):
    """轉正第一步:家筆記的預告行換成正式合約行;已經是正式行(上次做到一半)就不動。成功回 True(失敗已印原因)。"""
    hpath = env.vault / home_rel
    try:
        hlines, _hs, he = load_raw_for_edit(hpath)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{home_rel} 打不開:{ex}", file=sys.stderr)
        return False
    if _guard_formal_line(hlines, he, claim, method) is not None:
        lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
        if lines is None:
            print(f"{home_rel} 已經是正式合約行(上次轉正做到一半),這次只補守衛紀錄")
            return True
        # ★正式行已在、預告行也還在★(代碼審 r1 正確性席):同一句先有正式行又被預告一次;只拿掉預告行,
        # 不再換成第二條一樣的正式行——原本會印「已換成正式合約」卻把預告行留著,到期被當逾期
        try:
            atomic_write_verify(hpath, lines[:idx] + lines[idx + 1:], PLANNED_MARK,
                                lambda f: f"{PLANNED_MARK} {claim}" not in str(f.get("summary") or ""))
        except (ValueError, RuntimeError) as ex:
            print(f"擋下:{home_rel} 已有正式合約行,但重複的預告行拿不掉: {ex}", file=sys.stderr)
            return False
        print(f"{home_rel} 已經有同一句的正式合約行,只把重複的預告行拿掉")
        return True
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        print(f"擋下:{_err}", file=sys.stderr)
        return False
    newline = f"  KEY:★INVARIANT★ {claim} [test:{method}]"
    try:
        atomic_write_verify(hpath, [*lines[:idx], newline, *lines[idx + 1:]],
                            f"[test:{method}]",
                            lambda f: f"[test:{method}]" in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:合約行換不過去,什麼都沒動: {ex}", file=sys.stderr)
        return False
    return True


def _guard_settle_record(gpath, glines, ge, rel, home_rel, method):
    """轉正第二步:守衛紀錄的 status、標籤、四種預告句同一次寫入。"""
    import datetime
    today = datetime.date.today().isoformat()
    fm = edit_fm_scalar(glines[1:ge], "status", "pass")
    fm, synced = edit_fm_sync_status_tag(fm, "pass")
    new, missing = _guard_settle_rewrite(glines[:1] + fm + glines[ge:], today,
                                         home_rel[:-3] if home_rel.endswith(".md") else home_rel)

    def _ok(f):
        if str(f.get("status", "")) != "pass":
            return False
        tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
        return (not synced) or ("status/pass" in tags and all(t == "status/pass" for t in tags if t.startswith("status/")))

    try:
        atomic_write_verify(gpath, new, "status", _ok)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{home_rel} 已換成正式合約行,但 {rel} 寫不進去:{ex}", file=sys.stderr)
        print(f"  修好原因後重跑同一個指令會只補這一步:lumos guard settle {rel[:-3]} --test {method}", file=sys.stderr)
        return 2
    _names = {"test": "摘要的 TEST 預告句", "why": "摘要的 WHY 預告句", "whynot": "正文「為什麼還不做:」",
              "settle": "正文「做完之後跑 lumos guard settle 轉正」"}
    for k in missing:
        print(f"提醒:{rel} 裡找不到{_names[k]}(被手改過?),那一句沒改寫,要的話自己改成歷史說法")
    print(f"✓ 轉正:{home_rel} 的預告行已換成正式合約並綁上 [test:{method}];{rel} 轉為已通過,預告句改成歷史說法")
    print("  下一步:lumos guard audit 補獨立審計,推送前的閘會查")
    return 0


def _guard_signoff_refs(env):
    """簽核帳裡帶 --ref 的那些參照。"""
    import json as _j
    log = env.vault.parent / ".signoff-log.jsonl"
    refs = set()
    try:
        for ln in log.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                d = _j.loads(ln)
            except ValueError:
                continue
            r = str(d.get("ref") or "").strip()
            if r:
                refs.add(r)
                refs.add(r[:-3] if r.endswith(".md") else r)
    except OSError:
        pass
    return refs


def cmd_guard_abandon(env, ref, why):
    """棄置:留墓碑而不是刪掉。要有對得上的簽核紀錄——作用是留痕不是防偽造。
    整段拿寫入鎖(存量漂移防線 [S19]:原本改家筆記在鎖外,跟同時跑的 plan/settle 互相蓋掉)。"""
    with _vault_write_lock(env.vault):
        return _guard_abandon_locked(env, ref, why)


def _guard_abandon_locked(env, ref, why):
    if not (why or "").strip():
        print("擋下:棄置要寫 --why 說明為什麼決定不做了", file=sys.stderr)
        return 2
    rel, n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    refs = _guard_signoff_refs(env)
    stem = rel[:-3] if rel.endswith(".md") else rel
    if rel not in refs and stem not in refs:
        print(f"擋下:棄置一條預告的合約要有人簽核,帳上找不到對得上 {stem} 的紀錄", file=sys.stderr)
        print(f"  先簽核再來:lumos signoff {stem} --ref {stem} --note \"<為什麼決定不做>\"", file=sys.stderr)
        return 2
    home = _guard_home_of(n)
    home_rel = env.find(home)
    body = (env.vault / rel).read_text(encoding="utf-8")
    m = re.search(r"^預告的合約:(.+)$", body, re.M)
    claim = m.group(1).strip() if m else ""
    if not home_rel:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到——棄置前先把 guards 欄位指對,"
              "不然那篇的預告行會永遠留著,跟墓碑互相矛盾", file=sys.stderr)
        return 2
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條(被手改過?)", file=sys.stderr)
        return 2
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        # ★找不到就擋,不靜默略過★(代碼審 r1 blocker):guards 被改指到別篇時,
        # 原本會靜默成功,真正的家節點永久留著一條沒人管的預告行。
        print(f"擋下:{_err}", file=sys.stderr)
        print("  棄置會把功能節點那行預告拿掉;對不到那一行就不知道該拿掉哪一條,不能硬做", file=sys.stderr)
        return 2
    try:
        atomic_write_verify(env.vault / home_rel, lines[:idx] + lines[idx + 1:],
                            "", lambda f: claim not in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:功能節點的預告行拿不掉,墓碑也不立(不留半套): {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "status", "abandoned")
    print(f"✓ 已棄置:{rel} 立成墓碑(不是刪掉,下一個人看得到曾經打算做什麼、為什麼不做了)")
    return rc


def cmd_guard_required(env, as_json=False):
    """列必要集合現況:待完成幾條、逾期幾條、快到期幾條。"""
    import datetime
    today = datetime.date.today()
    rows, overdue, soon = [], [], []
    for rel, n in _guard_nodes(env):
        st = str(n.fields.get("status") or "")
        due = str(n.fields.get("due") or "").strip()
        home = _guard_home_of(n)
        owner = str(n.fields.get("owner") or "").strip()
        body = (env.vault / rel).read_text(encoding="utf-8")
        m = re.search(r"^預告的合約:(.+)$", body, re.M)
        claim = (m.group(1).strip() if m else rel)
    if _nodehome_in_stack_test_dir(path, layout):
        return True
    if _testmap_ext(path) in _TESTMAP_EXTS:
        return False                      # 測試地圖認得這種副檔名,它說不是就不是
    if _TESTMAP_DIR_RE is None:
        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
    if _TESTMAP_DIR_RE.search(path):
        return True
    name = path.rsplit("/", 1)[-1]
    stem = _testmap_stem(path)
    return (".spec." in name or ".test." in name or stem.startswith("test_")
            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)


def _nodehome_code_kind(path):
    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
    base = path.rsplit("/", 1)[-1]
    stripped = base.lstrip(".")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    for ent in raw.split(b"\0"):
        if not ent or b"\t" not in ent:
            continue
        meta, p = ent.split(b"\t", 1)
        parts = meta.split()
        if where == "index":
            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
                continue
            mode = parts[0]
        else:
            if len(parts) != 3:
                continue
            mode = parts[0]
        path = nfc(os.fsdecode(p))
        allp.append(path)
        if mode in (b"100644", b"100755"):
            files[path] = mode.decode()
    return files, allp


def _nodehome_changed_vs_disk(repo_root, where):
    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
    if where == "index":
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
    else:
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
    if raw is None:
        return None
    return {nfc(x) for x in _nodehome_split_z(raw)}


def _nodehome_reader(repo_root, where):
    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
    if where is None:
        return lambda p: None
    disk_ok_all = False
    differ = None
    if where == "index":
        differ = _nodehome_changed_vs_disk(repo_root, "index")
    else:
        head = _lens_full_sha(repo_root, "HEAD")
        if head and head == where:
            differ = _nodehome_changed_vs_disk(repo_root, where)
    root = Path(repo_root)
    spec = "" if where == "index" else where

    def read(p):
        if differ is not None and p not in differ:
            fp = root / p
            try:
                if fp.is_file() and not fp.is_symlink():
                    return fp.read_bytes()
            except OSError:
                pass
        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
        if r is None or r.returncode != 0:
            return None
        return r.stdout
    return read

    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
    for e in errs:
        print(f"  {e}", file=sys.stderr)
    for p, n, rule, frag, fix in viol:
        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
    if mode == "block":
        print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
              "推得出來的一寫進去就會過期——見 Projects/筆記形狀擋_計劃。", file=sys.stderr)
        _gate_event_or_warn(root, "note-shape", "blocked", f"{mode_word}:新違規 {len(viol) + len(errs)} 條",
                            hard=True, nodes=sorted({v[0] for v in viol} | {e.split(':', 1)[0] for e in errs})[:50])
        return 1
    # warn 模式有違規也記一筆(照鄰居的 warned;沒違規的放行才不寫——代碼審 r1 架構對齊席)
    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
                        nodes=sorted({v[0] for v in viol})[:50])
    return 0


# ── 筆記內容審(第二層,Projects/筆記內容審_計劃):推送前派判定者逐行判新寫的筆記是不是程式碼推得出來 ──
# 家:Systems/筆記內容審。只防疏忽、不防存心繞過(計劃〈做法〉第 0 節)。
_NOTE_AUDIT_GOLIVE_MARK = "note-audit check"          # 推送前掛鉤裡有這串=第二層上線了(範圍截斷用)
_NOTE_AUDIT_GATE_VALUES = ("block", "warn", "off")
_NOTE_AUDIT_VERDICT_DIR = "governance/note-verdicts"
_NOTE_AUDIT_WORK_DIR = ".lumos/note-audit"
_NOTE_AUDIT_TEMPLATE = "scripts/templates/note-audit-judge.md"
_NOTE_AUDIT_PROMPT_VERSION = 1                          # 範本檔改一個字就升版,並重跑 68 句小實驗(計劃 S14)
_NOTE_AUDIT_BATCH = 150
_NOTE_AUDIT_SEARCH_CAP = 20000
_NOTE_AUDIT_VERDICT_NAME_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{32}\.json$")
_NOTE_AUDIT_WEIGHT = {"CONTEXT": 0, "MIXED": 1, "CODE": 2}
_NOTE_AUDIT_CLASS_ALIASES = {"CODE": "CODE", "推得出": "CODE", "MIXED": "MIXED", "一半一半": "MIXED",
                             "CONTEXT": "CONTEXT", "脈絡": "CONTEXT"}
_NOTE_AUDIT_CLOSED = ("done", "superseded")


def _note_audit_judge_model(orchestrator):
    """判定者跟編排者同一家,模型寫死(計劃〈做法〉第 3 節第 2 點):claude → opus;codex → 既有 Codex 審查席常數。"""
    return {"claude": "opus", "codex": _CODEX_SEAT_MODEL}.get(orchestrator)


def _note_audit_config(text):
    """被檢查版本的 .lumos/config.json 內容(bytes 或 None)→ (gate, warnings)。照 _note_shape_config 的讀法。"""
    import json as _j
    if text is None:
        return "block", []
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        return "block", [".lumos/config.json 讀不成 JSON,筆記內容審照預設 block"]
    na = cfg.get("note_audit") if isinstance(cfg, dict) else None
    if na is not None and not isinstance(na, dict):
        return "block", ["設定檔的 note_audit 不是物件(要寫成 {\"note_audit\": {\"gate\": \"warn\"}}),筆記內容審照預設 block"]
    g = na.get("gate") if isinstance(na, dict) else None
    if g is None:
        return "block", []
    if g not in _NOTE_AUDIT_GATE_VALUES:
        return "block", [f"note_audit.gate 只能是 block/warn/off,你寫的是 {g!r},照 block"]
    return g, []


def _note_audit_status_of(blob):
    """筆記內容(bytes)→ (type, status)。讀不到回 (None, None)。"""
    if blob is None:
        return None, None
    try:
        fm, _b = split_frontmatter(blob.decode("utf-8-sig"))
    except UnicodeDecodeError:
        return None, None
    if not fm:
        return None, None
    fields = parse_frontmatter(fm)[0]
    return str(fields.get("type", "")).strip() or None, str(fields.get("status", "")).strip() or None


def _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader):
    """範圍裡被收尾的計劃(計劃〈做法〉第 1 節):`type: project`、終點 status 是 done/superseded,而且範圍裡有某個提交
    把它從非收尾改成收尾——逐提交讀那篇的 status(改名跟著走;起點沒有這篇時第一個提交就算)。回 [路徑]。"""
    return _notes_status_flipped(repo_root, base_where, tip_where, vault_rel, reader,
                                 lambda ty, st: ty == "project" and st in _NOTE_AUDIT_CLOSED,
                                 lambda a, b: (a not in _NOTE_AUDIT_CLOSED) and (b in _NOTE_AUDIT_CLOSED))


def _notes_status_flipped(repo_root, base_where, tip_where, vault_rel, reader, tip_ok, flip, only=None, deadline=None):
    """範圍裡有某個提交讓 status 發生 flip(前一版狀態, 後一版狀態) 的筆記 → [路徑];tip_ok(type, 終點 status) 先篩。
    筆記內容審(計劃收尾)與存量漂移守衛(守衛紀錄 pending→pass)共用(存量漂移防線_計劃:不另寫一套逐提交讀狀態)。
    only=只看這些路徑(呼叫端已經從頂端的樹篩好候選,省掉逐篇 git show);deadline=超過就回 None(判不了)。
    ★兩個參數是存量漂移守衛加的★(代碼審 r1 併發席:新分支首推從空樹算時,逐篇讀狀態實測 67 秒才判超過 60 秒預算)。"""
    import time as _t
    # 候選=範圍裡任一個提交碰過的筆記,不是頭尾淨差異:收尾→改回→再收尾時頭尾一模一樣,淨差異看不到(S3)
    rng0 = f"{base_where}..{tip_where}" if base_where else tip_where
    touched = _ns_git(repo_root, "log", "--format=", "--name-only", "-z", "-M", rng0, "--", vault_rel)
    if touched is None:
        return None
    out = []
    for p in sorted({x.strip("\n") for x in touched.decode("utf-8", errors="surrogateescape").split("\0")
                     if x.strip("\n").endswith(".md")}):
        if only is not None and nfc(p) not in only:
            continue
        if deadline is not None and _t.monotonic() > deadline:
            return None
        ty, st = _note_audit_status_of(reader(p))
        if not tip_ok(ty, st):
            continue
        seq = _note_status_seq(repo_root, base_where, tip_where, vault_rel, p)
        if seq is None:
            return None
        if any(flip(a, b) for a, b in zip(seq, seq[1:])):
            out.append(p)
    return out


def _note_status_seq(repo_root, base_where, tip_where, vault_rel, p):
    """一篇筆記在範圍裡由舊到新的 status 序列(起點那一版開頭;改名跟著走)。git 失敗回 None。"""
    rng = f"{base_where}..{tip_where}" if base_where else tip_where
    lg = _ns_git(repo_root, "log", "--follow", "--format=%H", "--name-only", "-z", rng, "--", p)
    if lg is None:
        return None
    # git log -z --format=%H --name-only:「sha\0\n路徑\0」一筆接一筆(實測;換行黏在路徑前面);逐筆取 (sha, 那時的路徑)
    pairs, cur = [], None
    for tok in lg.decode("utf-8", errors="surrogateescape").split("\0"):
        tok = tok.strip("\n")
        if not tok:
            continue
        if cur is None and _LENS_SHA_RE.fullmatch(tok):
            cur = tok
        elif cur is not None:
            pairs.append((cur, tok))
            cur = None
    specs = [f"{s}:{q}" for s, q in pairs]
    blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
    states = [_note_audit_status_of(b)[1] for b in (blobs or [])]
    old = pairs[-1][1] if pairs else p
    base_state = None
    if base_where:
        if pairs:
            # 最舊那個碰到它的提交若是改名,git log 給的是新路徑;起點那時的路徑要對起點做改名偵測(代碼審 r1 正確性席:
            # 已收尾的計劃只改名,原本讀不到起點狀態、被當成這次收尾)
            rn = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", base_where, pairs[-1][0], "--", vault_rel)
            if rn is not None:
                old = _nodehome_name_status(rn, norm=False)[1].get(old, old)
        bb = _nodehome_cat_blobs(repo_root, [f"{base_where}:{old}"])
        base_state = _note_audit_status_of(bb[0] if bb else None)[1]
    return [base_state, *states[::-1]]          # 由舊到新


def _note_audit_items(repo_root, base_where, tip_where, vault_rel):
    """這次要審的每一行 → (items, errs) 或 None。item={id, path, line, text, region, heading, done, context, ctx_fp}。
    一般新寫的行借第一層的共用函式(推送前掛鉤的標記、不逐提交判);被收尾的計劃整篇進完成審(已翻案的決策不進)。"""
    import hashlib
    reader = _nodehome_reader(repo_root, tip_where)
    res = _notelines_new(repo_root, False, base_where, tip_where, vault_rel, reader=reader,
                         mark=_NOTE_AUDIT_GOLIVE_MARK, hook=_NOTELINES_PREPUSH, per_commit=False)
    if res is None:
        return None
    notes, errs, _old = res
    closed = _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader)
    if closed is None:
        return None
    rows_by = {p: (text, {i for i, _l, _r in rows}) for p, text, rows in notes}
    for p in closed:
        if p in rows_by:
            continue
        b = reader(p)
        try:
            rows_by[p] = (b.decode("utf-8-sig"), set())
        except (UnicodeDecodeError, AttributeError):
            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
    fold = _note_audit_fold(docs)
    judged = set(fold)
    todo = sorted({it["id"] for it in items if it["id"] not in judged})
    heavy = sorted({it["id"] for it in items if fold.get(it["id"]) in ("CODE", "MIXED")})
    if heavy:
        print(f"注意:{len(heavy)} 行已經判了推得出或一半一半,不能略過——要刪、改,或申訴", file=sys.stderr)
    if not todo:
        print("沒有可以略過的行")
        return 0
    name = _note_audit_write_verdict(root, {"version": 1, "kind": "略過", "note": note.strip(),
                                            "rows": [{"id": i, "class": "SKIP"} for i in todo]})
    _gate_event_or_warn(root, "note-audit", "skipped", f"{name}:略過 {len(todo)} 行:{note.strip()[:80]}")
    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
    return 0


# ═══════════════════════════════════════════════════════════════════════════════════
# 存量漂移守衛(Projects/存量漂移防線_計劃;家 [[Systems/存量漂移守衛]])
# 已經寫進圖譜的句子,因為別處的狀態變了而過期——這裡是「甲」:狀態指令連帶處理(五種狀態一致檢查、
# 計劃收尾時列連帶待辦、推送時只擋「這次轉正、預告句還留著」)。「乙」(回頭條件改成機器能判的條件)接在後面。
# ═══════════════════════════════════════════════════════════════════════════════════
_DRIFT_CLOSED = ("done", "superseded")
_DRIFT_OPEN_ISSUE = ("open", "doing")
# c4 的關鍵詞。★清單裡刻意不放「工作樹」★:「釘在某提交的乾淨工作樹」是合法的可重現寫法,本來就不含這三個詞;
# 同一句裡同時有「未提交」與「工作樹」照樣成立(考卷 E3 就是這樣寫,設計審 r3 接手席)
_DRIFT_UNCOMMITTED_WORDS = ("未提交", "還沒提交", "uncommitted")
_DRIFT_KINDS = ("probe", "c1", "c2", "c3", "c4", "c5")
_DRIFT_KIND_NAMES = {"c1": "轉正了還寫預告", "c2": "計劃收尾了、連著的 Issue 還開著",
                     "c3": "計劃收尾了、驗證紀錄還待定", "c4": "前提寫「還沒提交」",
                     "c5": "轉正做了一半", "probe": "回頭條件成立了"}
_DRIFT_ACKS = "governance/drift-acks.jsonl"
_DRIFT_GOLIVE_MARK = "drift check"
_DRIFT_GATE_VALUES = ("block", "warn", "off")
# ★沒寫設定時的預設★(計劃〈做法〉第 4 節第 4 點):三條門檻(考卷正例全對、工具鏈歷史重放不亂擋、噪音 ≤5)
# 都過才改成 block;還沒考就是 warn。
_DRIFT_DEFAULT_GATE = "warn"
_DRIFT_BUDGET_SEC = 60


def _drift_str(n, key):
    v = n.fields.get(key, "") if n is not None else ""
    return v.strip() if isinstance(v, str) else ""


def _drift_fm_end(lines):
    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
    if not lines or lines[0].strip() != "---":
        return 0
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return i
    return 0


def _drift_field_line(text, key, pred=None):
    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    for i in range(1, e):
        m = TOP_KEY_RE.match(lines[i])
        if not (m and m.group(1) == key):
            continue
        if pred is None:
            return i + 1
        for j in range(i, e):
            if j > i and TOP_KEY_RE.match(lines[j]):
                break
            if pred(lines[j]):
                return j + 1
        return i + 1
    return 1


def _drift_line_text(text, ln):
    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
    lines = text.split("\n")
    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""


def _drift_c3_hit(env, vrel, override=None, ti=None):
    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
    n = env.notes.get(vrel)
    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
        return None
    if GUARD_MARK_FIELD in n.fields:
        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
    if not refs:
        return None
    ti = ti if ti is not None else build_typed_index(env)
    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
    if len(plans) != len({link_target(x) for x in refs}):
        return None
    for prel in plans:
        pn = env.notes.get(prel)
        if pn is None or _drift_str(pn, "type") != "project":
            return None
        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
            return None
    return plans


def _drift_linked(env, rel):
    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
    out_e, in_e = env.edges
    got = {}
    for d in out_e.get(rel, []):
        got[d] = "out"
    for s in in_e.get(rel, []):
        got[s] = "both" if s in got else "in"
    return got


def _drift_state_findings(env, only=None):
    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
    only=要算的路徑集合(None=全部)。"""
    out = []
    ti = build_typed_index(env)
    for rel, n in sorted(env.notes.items()):
        if only is not None and rel not in only:
            continue
        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
            out += _drift_guard_findings(env, rel, n, st)
        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
            out += _drift_c2(env, rel)
        if ty == "verification":
            plans = _drift_c3_hit(env, rel, ti=ti)
            if plans:
                text = env_text(env, rel) or ""
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
        vu = n.fields.get("valid_under")
        vtxt = " ".join(as_list(vu)) if vu else ""
        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
            text = env_text(env, rel) or ""
            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
    return out


def _drift_c2(env, rel):
    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
             if _drift_str(env.notes.get(p), "type") == "project"
             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
    if not plans:
        return []
    text = env_text(env, rel) or ""
    ln = _drift_field_line(text, "status")
    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]


def _drift_guard_findings(env, rel, n, st):
    """守衛紀錄的 c1(轉正了還寫預告,一句一筆)與 c5(轉正做了一半)。"""
    text = env_text(env, rel)
    if text is None:
        return []
    out = []
    lines = text.split("\n")
    if st == "pass":
        regs = _notelines_regions(text)
        for i, ln in enumerate(lines):
            k = _guard_planned_prose(ln, regs[i])
            if k:
                out.append({"kind": "c1", "path": rel, "line": i + 1, "text": ln.strip(), "related": [],
                            "why": "已轉正(status: pass)但還留著預告句"})
    elif st == "pending":
        m = re.search(r"^預告的合約:(.+)$", text, re.M)
        home = env.resolve(link_target(_guard_home_of_fields(n.fields))) if _guard_home_of_fields(n.fields) else None
        htext = env_text(env, home) if home else None
        if m and htext is not None:
            hl = htext.split("\n")
            if _guard_formal_line(hl, _drift_fm_end(hl), m.group(1).strip(), None) is not None:
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c5", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [home],
                            "why": f"家筆記 {home[:-3]} 已經是正式合約行——重跑 lumos guard settle 補完"})
    return out


def _drift_plan_followups(env, rel, new_status):
    """lumos set <計劃> status done|superseded 要列的連帶待辦(計劃〈做法〉第 1 節第 3 點)→ [(種類, 路徑, 說明)]。
    只讀筆記、不跑 git、不寫;不是計劃或不是收尾狀態回 []。
    驗證紀錄走 build_typed_index 的反向索引(代碼審 r1 架構對齊席:不自己拿 env.resolve 猜同名第一篇);
    只寫檔名、同名猜不準的另列一項「猜不準」,讓人自己看。"""
    n = env.notes.get(rel)
    if n is None or _drift_str(n, "type") != "project" or new_status not in _DRIFT_CLOSED:
        return []
    out = []
    names = {"out": "計劃連到它", "in": "它連到計劃", "both": "互相連"}
    for p, d in sorted(_drift_linked(env, rel).items()):
        pn = env.notes.get(p)
        if _drift_str(pn, "type") == "issue" and _drift_str(pn, "status") in _DRIFT_OPEN_ISSUE:
            out.append(("Issue", p, f"{_drift_str(pn, 'status')},{names[d]}"))
    ti = build_typed_index(env)
    for p in sorted({s for s, et in ti["rev"].get(rel, []) if et == "plan_refs"}):
        if _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            out.append(("驗證紀錄", p, "pending,plan_refs 指的計劃都已收尾"))
    for src, lit, et, cands in ti["ambiguous"]:
        if et == "plan_refs" and rel in cands and _drift_str(env.notes.get(src), "type") == "verification" \
                and _drift_str(env.notes.get(src), "status") == "pending":
            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
    return out


def _drift_print_followups(env, rel, new_status):
    items = _drift_plan_followups(env, rel, new_status)
    if not items:
        return
    print(f"連帶待辦(這份計劃收尾了,下面 {len(items)} 篇連著它;只列出、不擋——連結有時只是參考,是不是該結案要人看):")
    for kind, p, why in items:
        print(f"  · {kind} {p[:-3]}({why})")
        print(f"      看:lumos context {p[:-3]}")


# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────

def _drift_tree_env(root, where, vault_rel, override=None, timeout=60):
    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
    解不開的筆記(不是 UTF-8)記在 env.undecodable(圖譜內路徑)——check 碰到它們要算判不了,不能當不存在
    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
    lst = _nodehome_list(root, where)
    if lst is None:
        return None
    pre = vault_rel.rstrip("/") + "/"
    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
    blobs = _nodehome_cat_blobs(root, [f"{where}:{p}" for p in paths], timeout=max(1, timeout)) if paths else []
    if blobs is None:
        return None
    texts, bad = {}, []
    for p, b in zip(paths, blobs):
        if b is None:
            continue
        try:
            texts[p[len(pre):]] = b.decode("utf-8-sig")
        except UnicodeDecodeError:
            bad.append(p[len(pre):])
    texts.update(override or {})
    env = Env.from_texts(Path(root) / vault_rel, texts)
    env.undecodable = bad
    return env


def _drift_vault_rel(root, where):
    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
    lst = _nodehome_list(root, where)
    if lst is None:
        return None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        return None
    wv = _vault_in(Path(root))
    try:
        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
    except ValueError:
        wv_rel = None
    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]


def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
    pre = vault_rel.rstrip("/") + "/"
    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
    if raw is None:
        return None
    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
               if x.strip("\n").startswith(pre)}
    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
              and _drift_str(n, "status") in _DRIFT_CLOSED}
    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "verification" and st == "pass",
                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline)
    if passed is None:
        return None
    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline)
    if closed is None:
        return None
    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}


def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None):
    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
    預算:先建頂端的樹(一次批次讀,逾時用剩下的預算)、再只對候選逐提交讀狀態,每篇之前看一次預算;
    超過就算判不了。單次 git 呼叫本身最多 20 秒,所以最壞會比預算多出一次呼叫的時間。"""
    import time as _t

    def _left():
        return 60 if deadline is None else deadline - _t.monotonic()
    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
    tenv = _drift_tree_env(root, tip, vault_rel, override, timeout=_left())
    if tenv is None:
        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
    reader = _nodehome_reader(root, tip)
    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
    if ev is None:
        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
    unknown = [f"{p} 不是 UTF-8,讀不出狀態" for p in sorted(getattr(tenv, "undecodable", [])) if p in ev["touched"]]
    must, listed = [], []
    for f in _drift_state_findings(tenv):
        p, k = f["path"], f["kind"]
        if k == "c1":
            if p in ev["passed"]:
                must.append(f)
            continue
        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
        if hit:
            listed.append(f)
    return must, listed, unknown


# ── 表態 ─────────────────────────────────────────────────────────────────────────────

def _drift_load_acks(root, where=None):
    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
    import json as _j
    raw = None
    if where is None:
        fp = Path(root) / _DRIFT_ACKS
        try:
            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
        except OSError:
            raw = None
    else:
        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
        raw = bl[0] if bl else None
    out = []
    for ln in (raw or b"").decode("utf-8", errors="replace").splitlines():
        try:
            d = _j.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("path") and d.get("kind") in _DRIFT_KINDS:
            out.append(d)
    return out


def _drift_ack_key(path, text, kind):
    return (nfc(str(path)), str(text).strip(), kind)


def _drift_split_acked(findings, acks, vault_rel):
    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。"""
    keys = {_drift_ack_key(a["path"], a.get("text", ""), a["kind"]) for a in acks}
    pre = vault_rel.rstrip("/") + "/"
    left, done = [], []
    for f in findings:
        (done if _drift_ack_key(pre + f["path"], f["text"], f["kind"]) in keys else left).append(f)
    return left, done


def _drift_old_reason(f, acks, alive=None):
    """表態失效時(筆記改名),用「原文與種類相同」找舊理由供照抄。alive=現在還在的筆記路徑(repo 相對):
    表態原本那篇還在,就不是改名、是另一篇剛好一樣的樣板句——不借它的理由(代碼審 r1 正確性席:
    守衛紀錄的預告句是樣板,兩篇會一字不差,原本會把 A 的理由印給從沒表態過的 B)。"""
    for a in reversed(acks):
        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
            if alive is not None and nfc(str(a.get("path"))) in alive:
                continue
            return a.get("reason")
    return None


def cmd_drift_ack(env, node, line, kind, reason):
    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。"""
    import datetime, secrets
    if kind not in _DRIFT_KINDS:
        print(f"擋下:--kind 只能是 {'/'.join(_DRIFT_KINDS)}", file=sys.stderr)
        return 2
    if len((reason or "").strip()) < 4:
        print("擋下:--reason 要寫為什麼照留,至少 4 個字", file=sys.stderr)
        return 2
    rel = env.find(node)
    if rel is None:
        return _node_not_found(env, node, write_side=True)
    text = env_text(env, rel)
    lines = (text or "").split("\n")
    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
        return 2
    root = _vault_repo_root(env)
    try:
        vault_rel = env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        vault_rel = env.vault.name
    head = ""
    for ln in reversed(lines[:line]):
        if ln.startswith("#"):
            head = ln.lstrip("#").strip()
            break
    token = "DACK-" + secrets.token_hex(4)
    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
    fp = Path(root) / _DRIFT_ACKS
    try:
        fp.parent.mkdir(parents=True, exist_ok=True)
    except OSError as ex:
        print(f"擋下:建不了 {fp.parent}:{ex}", file=sys.stderr)
        return 2
    # 表態檔跟筆記庫其他寫入者排同一把鎖(代碼審 r1 併發席;跟治理帳其他寫入者沒共用鎖的整體問題在 Issue 那篇)
    with _vault_write_lock(env.vault):
        rc = _jsonl_append_verified(fp, rec, "id", token)
    if rc != 0:
        return rc
    _gate_event_or_warn(root, "drift-check", "acked", f"{rel}:{line} {kind}:{reason.strip()[:80]}")
    print(f"✓ 表態記下了({token}):{rel} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]})")
    print(f"推送前的檢查只認提交進去的表態檔:\n    git add {_DRIFT_ACKS} && git commit")
    return 0


# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings)。照 _note_audit_config 的讀法(每道閘各自一支,既有慣例)。"""
    import json as _j
    if text is None:
        return _DRIFT_DEFAULT_GATE, []
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"]
    dc = cfg.get("drift_check") if isinstance(cfg, dict) else None
    if dc is not None and not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"]
    g = dc.get("gate") if isinstance(dc, dict) else None
    if g is None:
        return _DRIFT_DEFAULT_GATE, []
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"]
    return g, []


def _drift_print_findings(rows, stream, acks=None, alive=None):
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {f['path']}:{f['line']}  {f['text'][:60]}", file=stream)
        print(f"      {f['why']}", file=stream)
        old = _drift_old_reason(f, acks, alive) if acks else None
        if old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  …還有 {len(rows) - 20} 筆", file=stream)


def cmd_drift_check(repo=None, diff_range=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
    import time as _t
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
        return 0
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
                                               mark=_DRIFT_GOLIVE_MARK)
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    mode, warns = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
    for w in warns:
        print(f"提醒:{w}", file=sys.stderr)
    if mode == "off":
        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
        return 0
    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
    acks = _drift_load_acks(root, tip)
    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
    lst = _nodehome_list(root, tip)
    alive = set(lst[1]) if lst else None
    if listed:
        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
        _drift_print_findings(listed, sys.stderr, acks, alive)
    if not must and not unknown:
        return 0
    return _drift_report_must(root, mode, must, unknown, acks, alive)


def _drift_report_must(root, mode, must, unknown, acks, alive=None):
    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
    for u in unknown:
        print(f"  判不了:{u}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
    _drift_print_findings(must, sys.stderr, acks, alive)
    if must:
        # ★不叫人重跑 guard settle★(代碼審 r1 正確性席):已經 pass 的紀錄 settle 直接回「已轉正」,不會改寫
        print("每一筆:把預告句手改成歷史說法(例:「為什麼還不做:」改成「預告當時為什麼還不做:」),"
              "或留著並表態:\n    lumos drift ack <節點> <行號> --kind <種類> --reason \"<為什麼照留>\"", file=sys.stderr)
    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
    if mode == "block":
        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
                            nodes=sorted({f["path"][:-3] for f in must})[:50])
        return 1
    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
    return 0


# ── 健檢與 doctor ────────────────────────────────────────────────────────────────────

def _drift_vault_of(env):
    root = _vault_repo_root(env)
    try:
        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        return root, env.vault.name


def cmd_drift_scan(env, at=None, as_json=False):
    """lumos drift scan [--at 提交] [--json]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查,列出全部發現,
    已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。"""
    import json as _j
    root, vault_rel = _drift_vault_of(env)
    tenv, sha = env, None
    if at:
        sha = _lens_full_sha(root, at)
        if sha is None:
            print(f"擋下:找不到提交 {at}", file=sys.stderr)
            return 2
        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
        vault_rel = _drift_vault_rel(root, sha) or vault_rel
        tenv = _drift_tree_env(root, sha, vault_rel)
        if tenv is None:
            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
            return 2
    left, done = _drift_split_acked(_drift_state_findings(tenv), _drift_load_acks(root, sha), vault_rel)
    if as_json:
        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel,
                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
                       ensure_ascii=False, indent=1))
        return 0
    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
          + (f";已表態 {len(done)}" if done else ""))
    for k in _DRIFT_KINDS:
        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
        if rows:
            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
            for f, acked in rows:
                print(f"  {f['path']}:{f['line']}  {f['text'][:70]}" + ("  (已表態)" if acked else ""))
                if not acked:
                    print(f"      {f['why']}")
    return 0


def _drift_doctor_lines(env):
    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
    root, vault_rel = _drift_vault_of(env)
    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
    out = []
    for k in ("c1", "c2", "c3", "c4", "c5"):
        rows = [f for f in left if f["kind"] == k]
        nd = sum(1 for f in done if f["kind"] == k)
        if rows:
            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else ""))
        elif nd:
            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{nd} 筆都已表態")
    return out


def _drift_gate_doctor_lines(repo_root):
    """doctor 開頭的閘提醒(照筆記形狀擋與筆記內容審那兩支的位置與呈現):開關不是 block 就講(不管接線沒,設計 [S14]);
    接線後(推送前掛鉤出現標記)專案 CI 沒呼叫 drift check 就給要貼的步驟。唯一的 git 呼叫是讀一次推送前掛鉤。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    try:
        txt = cp.read_bytes() if cp.is_file() and not cp.is_symlink() else None
    except OSError:
        txt = None
    mode, _w = _drift_config(txt)
    if mode != "block":
        out.append(f"這個專案的存量漂移檢查是 {mode}(.lumos/config.json 的 drift_check.gate;沒寫就是預設)——"
                   "轉正後留著預告句的推送不會被擋")
    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
    if wired and ymls and "drift check" not in body:
        out.append("專案 CI 沒呼叫 `lumos drift check`,`--no-verify` 推上去的沒人查——CI 在 note-audit 那步後面加:"
                   "\n    - run: python3 scripts/lumos drift check --diff \"${{ github.event.before || "
                   "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"")
    return out


# ── 考試 ─────────────────────────────────────────────────────────────────────────────

def _drift_set_status_text(text, status):
    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    if not e:
        return text
    fm = edit_fm_scalar(lines[1:e], "status", status)
    fm, _s = edit_fm_sync_status_tag(fm, status)
    return "\n".join(lines[:1] + fm + lines[e:])


def _drift_exam_one(root, vault_rel, q, at_sha):
    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
    ev = q.get("exam_event")
    note = q.get("note_at_event") or q.get("note")
    line = q.get("line")
    if not q.get("note") or not isinstance(line, int):
        return "略過:題目缺 note 或 line", 0, 0, 0
    if ev == "current_state":
        tenv = _drift_tree_env(root, at_sha, vault_rel)
        if tenv is None:
            return "略過:git 讀不出樹", 0, 0, 0
        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
        return ("誤列" if hit else "沒誤列"), 0, 0, 0
    commits = q.get("invalidating_commits") or []
    if ev not in ("commit", "status_replay") or not commits:
        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
    c = _lens_full_sha(root, commits[0])
    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
    if c is None or par is None:
        return "略過:找不到失效提交或它的上一版", 0, 0, 0
    vault_rel = _drift_vault_rel(root, c) or vault_rel      # 那個提交自己的圖譜位置(代碼審 r1 外家席)
    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
    hit_kind = next((f["kind"] for f in must + listed if f["path"] == note and f["line"] == line), None)
    others_m = _drift_exam_others(must, note, line, hit_kind)
    others_l = _drift_exam_others(listed, note, line, hit_kind)
    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
    in_must = any(f["path"] == note and f["line"] == line for f in must)
    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
    if ev == "status_replay":
        fu = _drift_exam_replay(root, par, vault_rel, q.get("status_targets") or [])
        if fu is None:
            return "略過:git 讀不出上一版", 0, 0, 0
        in_list = in_list or note in fu
    res = "擋到" if in_must else ("點到" if in_list else "漏")
    return res, len(others_m), len(others_l), noise


def _drift_exam_replay(root, par, vault_rel, targets):
    """status_replay:取上一版的樹,在記憶體裡把 targets 每一份計劃改成 done,回 lumos set 會列的連帶待辦路徑集合。"""
    tenv0 = _drift_tree_env(root, par, vault_rel)
    if tenv0 is None:
        return None
    texts = {}
    for t in targets:
        prel = tenv0.resolve(link_target(t))
        if prel:
            texts[prel] = _drift_set_status_text(env_text(tenv0, prel), "done")
    tenv = _drift_tree_env(root, par, vault_rel, override=texts)
    fu = set()
    for prel in texts:
        fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
    return fu


def _drift_exam_others(findings, note, line, kind):
    """考題那一行以外、算誤報的發現:排除題目那一行,以及同一篇同一種的兄弟句(c1 一句一筆,同一個轉正事件的
    另外幾句預告句是真發現,不是亂抓);同一篇別種的、別篇的都算(代碼審 r1 外家席:原本同一篇全部排除,誤報被低估)。"""
    return [f for f in findings if not (f["path"] == note and (f["line"] == line or (kind and f["kind"] == kind)))]


def cmd_drift_exam(exam, repo, at=None, history=None, as_json=False):
    """lumos drift exam <考卷.json> --repo <被考的 repo>:在被考 repo 的歷史上重放(計劃〈做法〉第 3 節)。
    不寫治理帳、不寫任何檔。--history N:改成對被考 repo 最近 N 個主線提交各跑一次 check,列出每筆要處理(門檻②)。"""
    import json as _j
    root = Path(repo).resolve()
    at_sha = _lens_full_sha(root, at or "HEAD")
    if at_sha is None:
        print(f"擋下:{repo} 找不到 {at or 'HEAD'}", file=sys.stderr)
        return 2
    vault_rel = _drift_vault_rel(root, at_sha)
    if vault_rel is None:
        print(f"擋下:{repo} 沒有圖譜", file=sys.stderr)
        return 2
    if history:
        return _drift_exam_history(root, vault_rel, at_sha, history, as_json)
    qs = _drift_exam_load(exam)
    if qs is None:
        return 2
    rows, skipped = [], 0
    for q in qs:
        if q.get("exam_event") == "mechanism1_experiment":
            skipped += 1
            continue
        res, om, ol, noise = _drift_exam_one(root, vault_rel, q, at_sha)
        rows.append({"id": q.get("id"), "event": q.get("exam_event"), "result": res,
                     "other_must": om, "other_listed": ol, "noise": noise})
    summ = {"擋到": 0, "點到": 0, "漏": 0, "誤列": 0, "沒誤列": 0, "略過": 0}
    for r in rows:
        summ["略過" if r["result"].startswith("略過") else r["result"]] += 1
    tot = {"skipped_mechanism1": skipped, "summary": summ,
           "誤報_要處理": sum(r["other_must"] for r in rows), "誤報_只列出": sum(r["other_listed"] for r in rows),
           "噪音最大": max([r["noise"] for r in rows] or [0]), "rows": rows}
    if as_json:
        print(_j.dumps(tot, ensure_ascii=False, indent=1))
        return 0
    print(f"略過 {skipped} 題(機制①,給實驗計劃)")
    print("題號  考法            結果        誤報(要處理/只列出)  噪音")
    for r in rows:
        print(f"{r['id']:<5} {r['event']:<15} {r['result']:<10}  {r['other_must']}/{r['other_listed']}"
              f"{'':<16}{r['noise']}")
    print("合計:" + "、".join(f"{k} {v}" for k, v in summ.items())
          + f";誤報 要處理 {tot['誤報_要處理']}、只列出 {tot['誤報_只列出']};單一提交噪音最大 {tot['噪音最大']}")
    return 0


def _drift_exam_load(exam):
    """考卷 → 題目清單;讀不了或有不認得的考法回 None(已印原因)。"""
    import json as _j
    try:
        qs = _j.loads(Path(exam).read_text(encoding="utf-8"))
    except (OSError, ValueError) as ex:
        print(f"擋下:考卷讀不了:{ex}", file=sys.stderr)
        return None
    if isinstance(qs, dict):
        qs = qs.get("items") or []
    # ★形狀先驗★(代碼審 r1 邊界席:純量或字串清單原本直接丟 Python 例外)
    if not isinstance(qs, list) or not all(isinstance(q, dict) for q in qs):
        print("擋下:考卷要是一個題目清單(每題一個物件),或 {\"items\": [...]}", file=sys.stderr)
        return None
    known = ("commit", "status_replay", "probe", "current_state", "mechanism1_experiment")
    bad = sorted({str(q.get("exam_event")) for q in qs if q.get("exam_event") not in known})
    if bad:
        print(f"擋下:考卷裡有不認得的考法 {bad}", file=sys.stderr)
        return None
    return qs


def _drift_exam_history(root, vault_rel, at_sha, n, as_json):
    """門檻②:被考 repo 最近 n 個主線提交各跑一次 check(父..提交),每筆要處理列出來給人逐筆判真假。"""
    import json as _j
    rl = _lens_git(root, "rev-list", "--first-parent", f"--max-count={int(n)}", at_sha)
    if rl is None or rl.returncode != 0:
        print("擋下:git 列不出提交", file=sys.stderr)
        return 2
    out = []
    for c in rl.stdout.split():
        par = _lens_full_sha(root, f"{c}^")
        if par is None:
            continue
        must, listed, unknown = _drift_check_core(root, par, c, _drift_vault_rel(root, c) or vault_rel)
        if must or unknown:
            out.append({"commit": c[:10], "must": [f"{f['kind']} {f['path']}:{f['line']} {f['text'][:50]}" for f in must],
                        "unknown": unknown, "listed": len(listed),
                        "noise": len({f['path'] for f in must if f['kind'] == 'c1'}) + sum(1 for f in must if f['kind'] != 'c1')})
    if as_json:
        print(_j.dumps({"commits": int(n), "with_must": out}, ensure_ascii=False, indent=1))
        return 0
    print(f"最近 {n} 個主線提交裡,有要處理的 {len(out)} 個(每筆要人判真假):")
            and not cur_file.startswith("governance/review-reports/")
            and cur_file not in _BOOKKEEPING_FILES
            and not cur_file.startswith(_BOOKKEEPING_DIRS)
            and not _PITFALL_DIFF_TEST_PAT.search(cur_file)
            and not (skip and _posix_norm(cur_file) in skip))


def _pitfall_tier(claims, files, repo_root, diff_range):
    """改動風險分級(單一算法;★vault-free★,pitfalls 在 pre-push 熱路徑上不載圖譜——代碼審 r1 架構席):
    命中風險型樣或新告警 → high;改動裡沒有任何「需要有家的程式檔」(_is_code_file,每支檔有家同一套定義)→ light;其餘 standard。
    「計劃風險低且小改動閘過 → light」那一層要讀圖譜,由 spec-gate --push-check(本來就有圖譜、本來就在 pre-push 跑)印;這裡只用審查帳字串便宜提示一句。回 (tier, 一句為什麼)。"""
    if claims:
        return "high", "命中風險型樣或新告警"
    base = _range_base(repo_root, diff_range)
    code = [f for f in files if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS)) and _is_code_file(repo_root, f, base)]
    if not code:
        return "light", "改動裡沒有程式檔(只有文件/資料/圖譜)"
    return "standard", "有程式檔改動、沒命中風險型樣" + (";審查帳有全靠人驗的風險低留痕,跑 lumos spec-gate --push-check <範圍> 看是不是 light" if _ledger_has_manual_only(repo_root) else "")


def _ledger_has_manual_only(repo_root):
    """便宜前置(不載圖譜):審查帳裡有沒有全靠人驗的風險低留痕。找不到 vault 或讀不動=沒有。"""
    try:
        vault = find_vault(Path(repo_root))
        ledger = vault.parent / ".canary-log.jsonl" if vault else None
        return bool(ledger and ledger.exists() and '"manual_only": true' in ledger.read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return False


def _vault_slug_of(path):
    """git 路徑字串(不是檔案系統路徑)落在 docs/<名>-knowledge/ 底下就回 <名>-knowledge,否則 None。
    三個讀者共用(推送前家的檢查、刪除守衛、推送測試範圍);2026-09-18 代碼審 code-文件子集收緊 r2 架構席:原本兩處各寫一次、第三處又換正則。"""
    if path.startswith("docs/") and path.count("/") >= 2:
        slug = path.split("/", 2)[1]
        if slug.endswith("-knowledge"):
            return slug
    return None


