  7408	def cmd_report_normalize(path, write=False):
  7409	    """`lumos report-normalize <席報告.md> [--write]`:收貨正規化的機械那一半。不帶 --write 只印會改什麼與還剩什麼;帶了才原子覆寫。
  7410	    vault-free(跟 fold-check/prose-lint/quote-check 同層:只吃一個 markdown 路徑,不碰圖譜;r1 架構席 a1——原本接在 canary 那組後面,沒圖譜的 repo 跑不了)。
  7411	    rc:0=已正規化或改完沒殘留;1=改完仍有殘留(印行號,要人改);2=檔讀不到。"""
  7412	    try:
  7413	        text = Path(path).read_text(encoding="utf-8", errors="replace")
  7414	    except OSError as e:
  7415	        print(f"擋下:讀不到 {path}({e})", file=sys.stderr)
  7416	        return 2
  7417	    new, changed, issues = normalize_report_text(text)
  7418	    if changed == 0 and not issues:
  7419	        print(f"✓ {path} 已是正規化格式(檔級行在檔首、每條 finding 一行 severity),不用改")
  7420	        return 0
  7421	    if write and new != text:
  7422	        _write_lf(Path(path), new)
  7423	        print(f"✓ 改了 {changed} 處並寫回 {path}")
  7424	    else:
  7425	        print(f"會改 {changed} 處(加 --write 才寫回):")

