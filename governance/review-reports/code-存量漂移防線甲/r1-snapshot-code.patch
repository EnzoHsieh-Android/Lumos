+def cmd_drift_check(repo=None, diff_range=None):
+    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
+    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
+    import time as _t
+    root = _note_audit_root(repo)
+    if root is None:
+        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
+        return 0
+    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
+        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
+        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
+        return 0
+    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
+                                               mark=_DRIFT_GOLIVE_MARK)
+    if tip is None or isinstance(tip, int):
+        return tip if isinstance(tip, int) else 0
+    mode, warns = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
+    for w in warns:
+        print(f"提醒:{w}", file=sys.stderr)
+    if mode == "off":
+        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
+        return 0
+    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
+                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
+    acks = _drift_load_acks(root, tip)
+    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
+    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
+    if listed:
+        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
+        _drift_print_findings(listed, sys.stderr, acks)
+    if not must and not unknown:
+        return 0
+    return _drift_report_must(root, mode, must, unknown, acks)
+
+
+def _drift_report_must(root, mode, must, unknown, acks):
+    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
