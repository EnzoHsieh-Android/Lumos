 25936	def _drift_exam_others(findings, note, line, kind):
 25937	    """考題那一行以外、算誤報的發現:排除題目那一行,以及同一篇同一種的兄弟句(c1 一句一筆,同一個轉正事件的
 25938	    另外幾句預告句是真發現,不是亂抓);同一篇別種的、別篇的都算(代碼審 r1 外家席:原本同一篇全部排除,誤報被低估)。"""
 25939	    return [f for f in findings if not (f["path"] == note and (f["line"] == line or (kind and f["kind"] == kind)))]
