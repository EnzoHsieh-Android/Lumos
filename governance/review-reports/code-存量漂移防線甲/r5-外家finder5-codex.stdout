 25740	def _drift_report_must(root, mode, must, unknown, acks, alive=None):
 25741	    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
 25742	    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
 25743	    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
 25744	    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
 25745	    for u in unknown:
 25746	        print(f"  判不了:{u}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
 25747	              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
 25748	    _drift_print_findings(must, sys.stderr, acks, alive)
 25749	    if must:
 25750	        # ★不叫人重跑 guard settle★(代碼審 r1 正確性席):已經 pass 的紀錄 settle 直接回「已轉正」,不會改寫
 25751	        print("每一筆:把預告句手改成歷史說法(例:「為什麼還不做:」改成「預告當時為什麼還不做:」),"
 25752	              "或留著並表態:\n    lumos drift ack <節點> <行號> --kind <種類> --reason \"<為什麼照留>\"", file=sys.stderr)
 25753	    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
 25754	    if mode == "block":
 25755	        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
 25756	                            nodes=sorted({f["path"][:-3] for f in must})[:50])
 25757	        return 1
 25758	    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
 25759	    return 0
 25760	
