 25918	def _drift_exam_replay(root, par, vault_rel, targets):
 25919	    """status_replay:取上一版的樹,在記憶體裡把 targets 每一份計劃改成 done,回 lumos set 會列的連帶待辦路徑集合。"""
 25920	    tenv0 = _drift_tree_env(root, par, vault_rel)
 25921	    if tenv0 is None:
 25922	        return None
 25923	    texts = {}
 25924	    for t in targets:
 25925	        prel = tenv0.resolve(link_target(t))
 25926	        txt = env_text(tenv0, prel) if prel else None
 25927	        if txt is not None:          # 讀不出來的計劃(不是 UTF-8)沒辦法在記憶體裡改狀態,跳過(代碼審 r4 正確性席)
 25928	            texts[prel] = _drift_set_status_text(txt, "done")
 25929	    tenv = _drift_tree_env(root, par, vault_rel, override=texts)
 25930	    fu = set()
 25931	    for prel in texts:
 25932	        fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
 25933	    return fu
