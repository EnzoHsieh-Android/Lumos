 25703	def cmd_drift_check(repo=None, diff_range=None):
 25704	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 25705	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
 25706	    import time as _t
 25707	    root = _note_audit_root(repo)
 25708	    if root is None:
 25709	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 25710	        return 0
 25711	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 25712	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 25713	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 25714	        return 0
 25715	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 25716	                                               mark=_DRIFT_GOLIVE_MARK)
 25717	    if tip is None or isinstance(tip, int):
 25718	        return tip if isinstance(tip, int) else 0
 25719	    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 25720	    for w in warns:
 25721	        print(f"提醒:{w}", file=sys.stderr)
 25722	    if mode == "off":
 25723	        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 25724	        return 0
 25725	    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 25726	                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 25727	    acks = _drift_load_acks(root, tip)
 25728	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 25729	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 25730	    lst = _nodehome_list(root, tip)
 25731	    alive = set(lst[1]) if lst else None
 25732	    if listed:
 25733	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 25734	        _drift_print_findings(listed, sys.stderr, acks, alive)
 25735	    if not must and not unknown:
 25736	        return 0
 25737	    return _drift_report_must(root, mode, must, unknown, acks, alive)
 25738	
