 25802	def _drift_scan_print(at, left, done, bad):
 25803	    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)。"""
 25804	    if bad:
 25805	        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(bad[:10]))
 25806	    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
 25807	    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
 25808	          + (f";已表態 {len(done)}" if done else ""))
 25809	    for k in _DRIFT_KINDS:
 25810	        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
 25811	        if rows:
 25812	            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
 25813	            for f, acked in rows:
 25814	                print(f"  {f['path']}:{f['line']}  {f['text'][:70]}" + ("  (已表態)" if acked else ""))
 25815	                if not acked:
 25816	                    print(f"      {f['why']}")
