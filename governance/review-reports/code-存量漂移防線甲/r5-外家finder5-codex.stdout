 22706	def _nodehome_is_test(path, layout=({}, {})):
 22707	    """測試檔判定:先問測試地圖那一支;再認各棧的測試資料夾(2026-09-12:平板 POS 測試資料夾裡的輔助檔、
 22708	    Android 儀器測試的 Kotlin 檔都被要求有家——測試地圖的規格刻意只認 test/tests 資料夾與檔名,不動它);
 22709	    副檔名不在測試地圖清單裡的(shell、Go、Rust、C…),套它同一組目錄與檔名規則。layout 見 _nodehome_in_stack_test_dir。"""
 22710	    global _TESTMAP_DIR_RE
 22711	    if _testmap_is_test(path):
 22712	        return True
 22713	    if _nodehome_in_stack_test_dir(path, layout):
 22714	        return True
 22715	    if _testmap_ext(path) in _TESTMAP_EXTS:
 22716	        return False                      # 測試地圖認得這種副檔名,它說不是就不是
 22717	    if _TESTMAP_DIR_RE is None:
 22718	        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
 22719	    if _TESTMAP_DIR_RE.search(path):
 22720	        return True
 22721	    name = path.rsplit("/", 1)[-1]
 22722	    stem = _testmap_stem(path)
 22723	    return (".spec." in name or ".test." in name or stem.startswith("test_")
 22724	            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)
 22725	
 22726	
 22727	def _nodehome_code_kind(path):
 22728	    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
 22729	    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
 22730	    base = path.rsplit("/", 1)[-1]
 22731	    stripped = base.lstrip(".")
 22732	    if "." in stripped:
 22733	        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
 22734	    return "shebang?"
