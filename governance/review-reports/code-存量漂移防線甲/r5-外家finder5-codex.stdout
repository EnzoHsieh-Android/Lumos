 31341	    回傳這一輪的根目錄(收尾要用)。
 31342	    """
 31343	    import os, tempfile, shutil, time
 31344	    real_tmp = tempfile.gettempdir()
 31345	    root = Path(tempfile.mkdtemp(prefix="gctl-run-", dir=real_tmp))
 31346	
