  4315	def resolve_test_refs(inv_text, platforms, default_platform):
  4316	    """把 [test:...] 解析為 [(platform, method_name)]。沿用 invariant_test_refs 的逗號切分。
  4317	    - platforms 非空(多平台):每段含 ':' → 前綴須為已定義 platform 鍵(C#/Kotlin 名不含冒號,
  4318	      故含冒號即視為 平台:名;前綴未定義 → raise ValueError,不誤當方法名);無 ':' → 歸 default_platform。
  4319	    - platforms 空(legacy,由呼叫端在 multiplatform=False 時傳 {}):**不切分**,整串(含任何冒號)
  4320	      配 default_platform → 後續走單一 method set 比對(含冒號的假想 ref 走 dangling 而非報錯)。"""
  4321	    out = []
  4322	    for seg in invariant_test_refs(inv_text):
  4323	        if platforms and ":" in seg:
  4324	            plat, name = seg.split(":", 1)
  4325	            plat, name = plat.strip(), name.strip()
  4326	            if plat not in platforms:
  4327	                raise ValueError(
  4328	                    f"[test:{seg}] 的平台前綴 '{plat}' 未定義於 platforms"
  4329	                    f"({', '.join(platforms)});不猜,免得綁錯平台")
  4330	            out.append((plat, name))
  4331	        else:
  4332	            out.append((default_platform, seg))
  4333	    return out
  4334	
