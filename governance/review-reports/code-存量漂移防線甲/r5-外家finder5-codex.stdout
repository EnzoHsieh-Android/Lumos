 25772	def cmd_drift_scan(env, at=None, as_json=False):
 25773	    """lumos drift scan [--at 提交] [--json]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查,列出全部發現,
 25774	    已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。"""
 25775	    import json as _j
 25776	    root, vault_rel = _drift_vault_of(env)
 25777	    tenv, sha = env, None
 25778	    if at:
 25779	        sha = _lens_full_sha(root, at)
 25780	        if sha is None:
 25781	            print(f"擋下:找不到提交 {at}", file=sys.stderr)
 25782	            return 2
 25783	        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
 25784	        vault_rel = _drift_vault_rel(root, sha) or vault_rel
 25785	        tenv = _drift_tree_env(root, sha, vault_rel)
 25786	        if tenv is None:
 25787	            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
 25788	            return 2
 25789	    left, done = _drift_split_acked(_drift_state_findings(tenv), _drift_load_acks(root, sha), vault_rel)
 25790	    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
 25791	    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
 25792	    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
 25793	    if as_json:
 25794	        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
 25795	                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
 25796	                       ensure_ascii=False, indent=1))
 25797	        return 0
 25798	    _drift_scan_print(at, left, done, bad)
 25799	    return 0
 25800	
