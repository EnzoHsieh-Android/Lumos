 31370	    repo_root = Path(GRAPHCTL).resolve().parent.parent
 31371	    if (repo_root / "skills" / "lumos-project-notes").is_dir():
 31372	        os.environ["LUMOS_HOME"] = str(repo_root)
 31373	    else:
 31374	        os.environ.pop("LUMOS_HOME", None)
 31375	
 31376	    # ③ 修剪舊殘骸:只碰「已標記結束」或「超過一天沒動」的本輪型根目錄。
 31377	    #    ★不按數量硬刪★——hook 會平行起 runner,刪掉別人正在用的根就是製造假紅。
 31378	    try:
 31379	        cutoff = time.time() - 86400
 31380	        pruned = 0
 31381	        with os.scandir(real_tmp) as it:
 31382	            for e in it:
 31383	                if not e.name.startswith("gctl-run-") or not e.is_dir(follow_symlinks=False):
 31384	                    continue
 31385	                p = Path(e.path)
 31386	                done = (p / ".finished").exists()
 31387	                try:
 31388	                    old = e.stat(follow_symlinks=False).st_mtime < cutoff
 31389	                except OSError:
 31390	                    continue
 31391	                if done or old:
 31392	                    shutil.rmtree(p, ignore_errors=True)
 31393	                    pruned += 1
 31394	                    if pruned >= 200:      # 一輪最多清這麼多,不要讓收尾變成掃地大會
 31395	                        break
 31396	    except OSError:
 31397	        pass
 31398	    return root
