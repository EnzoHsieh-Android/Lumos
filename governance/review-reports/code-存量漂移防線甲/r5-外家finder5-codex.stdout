 25667	def _drift_config(text):
 25668	    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
 25669	    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
 25670	    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
 25671	    import json as _j
 25672	    if text is None:
 25673	        return _DRIFT_DEFAULT_GATE, [], False
 25674	    try:
 25675	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 25676	    except (ValueError, UnicodeDecodeError):
 25677	        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], False
 25678	    dc = cfg.get("drift_check") if isinstance(cfg, dict) else None
 25679	    if dc is None:
 25680	        return _DRIFT_DEFAULT_GATE, [], False
 25681	    if not isinstance(dc, dict):
 25682	        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
 25683	                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
 25684	    g = dc.get("gate")
 25685	    if g is None:
 25686	        return _DRIFT_DEFAULT_GATE, [], False
 25687	    if g not in _DRIFT_GATE_VALUES:
 25688	        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
 25689	    return g, [], True
 25690	
