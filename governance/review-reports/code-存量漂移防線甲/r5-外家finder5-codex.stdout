 25880	def _drift_exam_one(root, vault_rel, q, at_sha):
 25881	    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
 25882	    ev = q.get("exam_event")
 25883	    note = q.get("note_at_event") or q.get("note")
 25884	    line = q.get("line")
 25885	    if not q.get("note") or not isinstance(line, int):
 25886	        return "略過:題目缺 note 或 line", 0, 0, 0
 25887	    if ev == "current_state":
 25888	        tenv = _drift_tree_env(root, at_sha, vault_rel)
 25889	        if tenv is None:
 25890	            return "略過:git 讀不出樹", 0, 0, 0
 25891	        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
 25892	        return ("誤列" if hit else "沒誤列"), 0, 0, 0
 25893	    commits = q.get("invalidating_commits") or []
 25894	    if ev not in ("commit", "status_replay") or not commits:
 25895	        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
 25896	    c = _lens_full_sha(root, commits[0])
 25897	    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
 25898	    if c is None or par is None:
 25899	        return "略過:找不到失效提交或它的上一版", 0, 0, 0
 25900	    vault_rel = _drift_vault_rel(root, c) or vault_rel      # 那個提交自己的圖譜位置(代碼審 r1 外家席)
 25901	    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
 25902	    hit_kind = next((f["kind"] for f in must + listed
 25903	                     if f["path"] == note and (f["line"] == line or ev == "status_replay")), None)
 25904	    others_m = _drift_exam_others(must, note, line, hit_kind)
 25905	    others_l = _drift_exam_others(listed, note, line, hit_kind)
 25906	    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
 25907	    in_must = any(f["path"] == note and f["line"] == line for f in must)
 25908	    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
 25909	    if ev == "status_replay":
 25910	        fu = _drift_exam_replay(root, par, _drift_vault_rel(root, par) or vault_rel, q.get("status_targets") or [])
 25911	        if fu is None:
 25912	            return "略過:git 讀不出上一版", 0, 0, 0
 25913	        in_list = in_list or note in fu
 25914	    res = "擋到" if in_must else ("點到" if in_list else "漏")
 25915	    return res, len(others_m), len(others_l), noise
