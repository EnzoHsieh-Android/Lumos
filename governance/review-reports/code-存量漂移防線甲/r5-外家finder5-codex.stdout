 25692	def _drift_print_findings(rows, stream, acks=None, alive=None):
 25693	    for f in rows[:20]:
 25694	        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {f['path']}:{f['line']}  {f['text'][:60]}", file=stream)
 25695	        print(f"      {f['why']}", file=stream)
 25696	        old = _drift_old_reason(f, acks, alive) if acks else None
 25697	        if old:
 25698	            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
 25699	    if len(rows) > 20:
 25700	        print(f"  …還有 {len(rows) - 20} 筆", file=stream)
