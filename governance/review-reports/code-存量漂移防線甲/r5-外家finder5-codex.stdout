 49582	    _nh_commit(root, "d1")
 49583	    _nh_git(root, "remote", "add", "origin", str(bare))
 49584	    _nh_git(root, "push", "-q", "origin", "HEAD:refs/heads/main")
 49585	    d2 = d1 + "\n  - id: d2\n    decided: 2026-09-02\n    context: 背景二\n      續行\n    why_chosen: 因為二"
 49586	    p = _nh_node(root, "D", extra=d2, body="x")
 49587	    _nh_commit(root, "d2 local")
 49588	    vault = root / _NA_VAULT
 49589	    before = p.read_text(encoding="utf-8").split("\n")
 49590	    r = run(vault, "decision-amend", "Systems/D", "d2", "--field", "context", "--text", "背景二改")
 49591	    after = p.read_text(encoding="utf-8").split("\n")
 49592	    check("①沒推上去的決策:只改指定欄(含續行)", r.returncode == 0
 49593	          and [l for l in before if l not in after] == ["    context: 背景二", "      續行"]
 49594	          and [l for l in after if l not in before] == ["    context: 背景二改"], r.stdout + r.stderr)
 49595	    r = run(vault, "decision-amend", "Systems/D", "d1", "--field", "context", "--text", "改掉")
 49596	    check("②遠端已有這個編號 → 拒絕,講已推與撞號兩種可能", r.returncode != 0 and "推上去" in r.stderr and "撞號" in r.stderr
 49597	          and "背景一" in p.read_text(encoding="utf-8"), r.stderr[-300:])
 49598	    for f in ("id", "decided", "valid", "ended"):
 49599	        r = run(vault, "decision-amend", "Systems/D", "d2", "--field", f, "--text", "x")
 49600	        check(f"③結構欄 {f} 不准改", r.returncode != 0 and "結構欄" in r.stderr, r.stderr[-200:])
 49601	    _nh_git(root, "mv", f"{_NA_VAULT}/Systems/D.md", f"{_NA_VAULT}/Systems/E.md")
 49602	    _nh_commit(root, "rename")
 49603	    r = run(vault, "decision-amend", "Systems/E", "d1", "--field", "context", "--text", "改掉")
 49604	    check("④改名後:跟著改名找到遠端舊路徑,d1 照拒", r.returncode != 0 and "撞號" in r.stderr, r.stdout + r.stderr[-300:])
 49605	    r = run(vault, "decision-amend", "Systems/E", "d2", "--field", "why_chosen", "--text", "因為二改")
 49606	    check("⑤改名後:遠端沒有 d2 → 准改", r.returncode == 0 and "因為二改" in (vault / "Systems" / "E.md").read_text(encoding="utf-8"),
 49607	          r.stdout + r.stderr[-300:])
 49608	    _nh_git(root, "remote", "set-url", "origin", str(bare.parent / "no-such.git"))
 49609	    r = run(vault, "decision-amend", "Systems/E", "d2", "--field", "context", "--text", "再改")
 49610	    check("⑥fetch 失敗 → 拒絕", r.returncode != 0 and "fetch" in r.stderr, r.stderr[-300:])
 49611	    _nh_git(root, "remote", "remove", "origin")
 49612	    r = run(vault, "decision-amend", "Systems/E", "d1", "--field", "context", "--text", "沒有遠端就能改")
 49613	    check("⑦沒有任何遠端 → 准改", r.returncode == 0 and "沒有遠端就能改" in (vault / "Systems" / "E.md").read_text(encoding="utf-8"),
 49614	          r.stdout + r.stderr[-300:])
