 24599	def _git_log_sha_paths(raw):
 24600	    """git log -z --format=%H --name-only 的輸出 →[(sha, 那時的路徑)]。
 24601	    格式是「sha\\0\\n路徑\\0」一筆接一筆(實測;換行黏在路徑前面)。"""
 24602	    pairs, cur = [], None
 24603	    for tok in raw.decode("utf-8", errors="surrogateescape").split("\0"):
 24604	        tok = tok.strip("\n")
 24605	        if not tok:
 24606	            continue
 24607	        if cur is None and _LENS_SHA_RE.fullmatch(tok):
 24608	            cur = tok
 24609	        elif cur is not None:
 24610	            pairs.append((cur, tok))
 24611	            cur = None
 24612	    return pairs
