 25457	def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
 25458	    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
 25459	    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
 25460	    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
 25461	    lst = _nodehome_list(root, where)
 25462	    if lst is None:
 25463	        return None
 25464	    pre = vault_rel.rstrip("/") + "/"
 25465	    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
 25466	    import time as _t
 25467	    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
 25468	    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
 25469	    blobs = _nodehome_cat_blobs(root, [f"{where}:{p}" for p in paths], timeout=left) if paths else []
 25470	    if blobs is None:
 25471	        return None
 25472	    texts, bad = {}, []
 25473	    for p, b in zip(paths, blobs):
 25474	        if b is None:
 25475	            continue
 25476	        try:
 25477	            texts[p[len(pre):]] = b.decode("utf-8-sig")
 25478	        except UnicodeDecodeError:
 25479	            bad.append(p[len(pre):])
 25480	    texts.update(override or {})
 25481	    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])
 25482	
 25483	
 25484	def _drift_vault_rel(root, where):
 25485	    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
 25486	    lst = _nodehome_list(root, where)
 25487	    if lst is None:
 25488	        return None
 25489	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 25490	    if not vaults:
 25491	        return None
 25492	    wv = _vault_in(Path(root))
 25493	    try:
 25494	        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
 25495	    except ValueError:
 25496	        wv_rel = None
 25497	    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 25498	
 25499	
 25500	def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
 25501	    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
 25502	    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
 25503	    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
 25504	    import time as _t
 25505	    pre = vault_rel.rstrip("/") + "/"
 25506	    if deadline is not None and _t.monotonic() > deadline:
 25507	        return None
 25508	    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 25509	    if raw is None:
 25510	        return None
 25511	    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
 25512	               if x.strip("\n").startswith(pre)}
 25513	    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
 25514	              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
 25515	    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
 25516	              and _drift_str(n, "status") in _DRIFT_CLOSED}
 25517	    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25518	                                   lambda ty, st: ty == "verification" and st == "pass",
 25519	                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
 25520	    if passed is None:
 25521	        return None
 25522	    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25523	                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
 25524	                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
 25525	    if closed is None:
 25526	        return None
 25527	    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
 25528	            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}
 25529	
 25530	
 25531	def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None):
 25532	    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
 25533	    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
 25534	    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
 25535	    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
 25536	    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
 25537	    import time as _t
 25538	
 25539	    def _left():
 25540	        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
 25541	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
 25542	    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
 25543	    if tenv is None:
 25544	        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
 25545	    if _left() <= 0:
 25546	        return [], [], [over]
 25547	    reader = _nodehome_reader(root, tip)
 25548	    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
 25549	    if ev is None:
 25550	        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
 25551	    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
 25552	               if _note_unreadable(n) and p in ev["touched"]]
 25553	    must, listed = [], []
 25554	    for f in _drift_state_findings(tenv):
 25555	        p, k = f["path"], f["kind"]
 25556	        if k == "c1":
 25557	            if p in ev["passed"]:
 25558	                must.append(f)
 25559	            continue
 25560	        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
 25561	        if hit:
 25562	            listed.append(f)
 25563	    return must, listed, unknown
 25564	
