 25869	def _drift_set_status_text(text, status):
 25870	    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
 25871	    lines = text.split("\n")
 25872	    e = _drift_fm_end(lines)
 25873	    if not e:
 25874	        return text
 25875	    fm = edit_fm_scalar(lines[1:e], "status", status)
 25876	    fm, _s = edit_fm_sync_status_tag(fm, status)
 25877	    return "\n".join(lines[:1] + fm + lines[e:])
