   556	def _stem_hit(stem, text):
   557	    """stem 是否在 text 中作為「整詞」出現。ASCII stem 用詞界(re.ASCII,避 api 命中 pos_api_auth);
   558	    CJK 無詞界 → 子字串比對,靠呼叫端的前綴抑制處理重疊(點數 vs 點數商城)。"""
   559	    if stem.isascii():
   560	        return re.search(r"\b" + re.escape(stem) + r"\b", text, re.ASCII) is not None
   561	    return stem in text
