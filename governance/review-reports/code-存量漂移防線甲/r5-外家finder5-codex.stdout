 22618	def _nodehome_resp_ok(value):
 22619	    """[S16] 負責範圍:至少 10 個字、要有實字(全標點、空白視同沒寫)。實字判準同 [manual:] 那條。"""
 22620	    if not isinstance(value, str):
 22621	        return False
 22622	    v = value.strip()
 22623	    return len(v) >= _NODEHOME_RESP_MIN_CHARS and bool(re.search(r"[^\W_]", v))
