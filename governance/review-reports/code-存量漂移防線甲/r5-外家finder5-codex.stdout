  4030	def load_symbol_profile(repo_root):
  4031	    """讀 <repo>/.lumos/config.json 的 symbol_profile / neg_lexicon(預設 csharp + zh)。
  4032	    沿用 load_test_profile 的形狀:未知名稱→警告並回預設,壞 JSON→不 crash。"""
  4033	    import json
  4034	    prof = dict(SYMBOL_PROFILES["csharp"])
  4035	    neg = NEG_LEXICONS["zh"]
  4036	    cfg_path = repo_root / ".lumos" / "config.json"
  4037	    if not cfg_path.exists():
  4038	        return prof, neg
  4039	    try:
  4040	        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
  4041	    except Exception as e:
  4042	        print(f"⚠ .lumos/config.json 解析失敗,Check Y 用 csharp+zh 預設: {e}", file=sys.stderr)
  4043	        return prof, neg
  4044	    name = cfg.get("symbol_profile") or "csharp"
  4045	    if name in SYMBOL_PROFILES:
  4046	        prof = dict(SYMBOL_PROFILES[name])
  4047	    elif name != "csharp":
  4048	        print(f"⚠ 未知 symbol_profile '{name}'(有: {', '.join(SYMBOL_PROFILES)}),用 csharp",
  4049	              file=sys.stderr)
  4050	    lang = cfg.get("neg_lexicon") or "zh"
  4051	    if lang in NEG_LEXICONS:
  4052	        neg = NEG_LEXICONS[lang]
  4053	    elif lang != "zh":
  4054	        print(f"⚠ 未知 neg_lexicon '{lang}'(有: {', '.join(NEG_LEXICONS)}),用 zh", file=sys.stderr)
  4055	    ov = cfg.get("symbol")           # 欄位級逃生口(同 test 的 inline override)
  4056	    if isinstance(ov, dict):
  4057	        for k in ("shape_re", "suffixes", "dotted_ok", "code_exts"):
  4058	            if k in ov:
  4059	                prof[k] = tuple(ov[k]) if isinstance(ov[k], list) else ov[k]
  4060	    extra = cfg.get("neg_extra")     # 專案自有說法(例:「已封存」「凍結」)
  4061	    if isinstance(extra, list):
  4062	        neg = tuple(neg) + tuple(str(x) for x in extra)
  4063	    return prof, neg
