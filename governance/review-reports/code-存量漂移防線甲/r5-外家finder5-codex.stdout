 25568	def _drift_load_acks(root, where=None):
 25569	    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
 25570	    import json as _j
 25571	    raw = None
 25572	    if where is None:
 25573	        fp = Path(root) / _DRIFT_ACKS
 25574	        try:
 25575	            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
 25576	        except OSError:
 25577	            raw = None
 25578	    else:
 25579	        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
 25580	        raw = bl[0] if bl else None
 25640	    head = ""
 25641	    for ln in reversed(lines[:line]):
 25642	        if ln.startswith("#"):
 25643	            head = ln.lstrip("#").strip()
 25644	            break
 25645	    token = "DACK-" + secrets.token_hex(4)
 25646	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 25647	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
 25648	    fp = Path(root) / _DRIFT_ACKS
 25649	    try:
 25650	        fp.parent.mkdir(parents=True, exist_ok=True)
 25651	    except OSError as ex:
 25652	        print(f"擋下:建不了 {fp.parent}:{ex}", file=sys.stderr)
 25653	        return 2
 25654	    # 表態檔跟筆記庫其他寫入者排同一把鎖(代碼審 r1 併發席;跟治理帳其他寫入者沒共用鎖的整體問題在 Issue 那篇)
 25655	    with _vault_write_lock(env.vault):
 25656	        rc = _jsonl_append_verified(fp, rec, "id", token)
 25657	    if rc != 0:
 25658	        return rc
 25659	    _gate_event_or_warn(root, "drift-check", "acked", f"{rel}:{line} {kind}:{reason.strip()[:80]}")
 25660	    print(f"✓ 表態記下了({token}):{rel} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]})")
 25661	    print(f"推送前的檢查只認提交進去的表態檔:\n    git add {_DRIFT_ACKS} && git commit")
 25662	    return 0
 25663	
