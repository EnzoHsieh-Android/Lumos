def _guard_nodes(env):
    """帶本機制標記的守衛節點。★判準放節點身上,不看 status 字面值、不查外部帳★
    (設計審:手寫 pending 的人不該被拖進整套規則;判準跟著節點走,改名搬家都對得上)。"""
    out = []
    for rel, n in sorted(env.notes.items()):
        if n.fields.get("type") != "verification":
            continue
        g = n.fields.get(GUARD_MARK_FIELD)
        if not g:
            continue
        out.append((rel, n))
    return out


def _guard_find(env, ref):
    rel = env.find(ref)
    if rel is None:
        return None, None
    n = env.notes.get(rel)
    if n is None or not n.fields.get(GUARD_MARK_FIELD):
        return None, None
    return rel, n


def _guard_planned_line(env, home_rel, claim):
    """在功能節點裡找那一行預告標記,回 (lines, idx, e, err)。

    ★比照既有引擎的兩道防呆★(代碼審 r1 blocker):`cmd_guard_bind`/`cmd_guard_audit` 對
    「在功能節點裡找某條 KEY 行」都會 ①命中多條就擋,不猜是哪一條 ②找不到就擋。
    第一版用「合約前 12 字」當子字串比對,同一篇預告兩條而前 12 字相同時會改到別條、互相覆蓋。
    這裡改成比對「剝掉 [watch:]/[due:] 之後的完整文字」,並保留多條就擋。"""
    path = env.vault / home_rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        return None, None, None, f"{home_rel} 打不開:{ex}"
    want = (claim or "").strip()
    idx = None
    for i in range(1, e):
        m = PLANNED_RE.match(lines[i].strip())
        if not m:
            continue
        body = _PLANNED_TAIL_RE.sub("", m.group(1)).strip()
        if body != want:
            continue
        if idx is not None:
            return None, None, None, (f"{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條"
                                      "——先手動把重複的那行處理掉")
        idx = i
    if idx is None:
        return None, None, None, f"{home_rel} 裡找不到預告行『{want[:30]}』(被手改過或已經轉正?)"
    return lines, idx, e, None


def _guard_home_of(n):
    return _guard_home_of_fields(n.fields)


def _guard_home_of_fields(fields):
    g = fields.get(GUARD_MARK_FIELD)
        if s.startswith("做完之後跑 `lumos guard settle` 轉正"):
            return "settle"
    return None


# 行尾只認工具會接上去的標記:settle/bind 的 [test:]、guard audit 的 [audit:]、kill-add 的 [kill:];其他 [鍵:值] 一律算原文
# (代碼審 r2 正確性席:認成任何 [鍵:值] 時,原文結尾帶 [scope:企業戶] 的另一條合約會被當成這句的正式行,settle 把預告行刪掉還回報成功)
_GUARD_TAIL_MARKS_RE = re.compile(r"(?:\s*\[(?:test|audit|kill):[^\]]*\])*\s*")


def _guard_formal_line(lines, e, claim, method=None):
    """家筆記的摘要裡有沒有這條合約的正式行 → 行索引或 None:合約原文開頭、後面只剩標記(工具接在行尾的
    [test:…] 與後來 guard audit 加的 [audit:…]),而且標記裡有 [test:<方法>](method=None 時任一方法)(存量漂移防線 [S5])。
    ★只剝行尾那串標記★(代碼審 r1 正確性席、外家席:合約原文自己帶 [鍵:值] 時,剝掉全部標記就永遠對不上原文——
    guard-kill 記過的同一型坑);★只看摘要★(外家席:其他開頭欄位裡的同一句會被誤認成正式行,假綠)。"""
    regs = _notelines_regions("\n".join(lines))
    for i in range(1, e):
        if i < len(regs) and regs[i] != "summary":
            continue
        m = INVARIANT_RE.match(lines[i].strip())
        if not m:
            continue
        body = m.group(1).strip()
        if not body.startswith(claim):
            continue
        tail = body[len(claim):]
        if not _GUARD_TAIL_MARKS_RE.fullmatch(tail):
            continue
        if (f"[test:{method}]" in tail) if method is not None else bool(TEST_REF_RE.search(tail)):
            return i
    return None


def _guard_settle_rewrite(lines, today, home_link):
    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。"""
    regs = _notelines_regions("\n".join(lines))
    out, seen = [], set()
    for i, ln in enumerate(lines):
        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
        if k is None:
            out.append(ln)
            continue
        seen.add("why" if k == "why-done" else k)
        ind = ln[:len(ln) - len(ln.lstrip())]
        if k == "test":
            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
        return 2
    with _vault_write_lock(env.vault):
        return _guard_settle_locked(env, ref, method)


def _guard_settle_locked(env, ref, method):
    rel, _n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    gpath = env.vault / rel
    # ★狀態從磁碟重讀★:env 是指令開頭載入的,拿到鎖之前可能已經被另一個程序轉正了
    try:
        glines, _s, ge = load_raw_for_edit(gpath)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{rel} 打不開:{ex}", file=sys.stderr)
        return 2
    gfields = parse_frontmatter(glines[1:ge])[0]
    st = str(gfields.get("status"))
    if st == "pass":
        # 另一個程序剛做完、或重跑:結果已經是要的樣子,當成功(設計審 r3 併發席)
        print(f"已轉正,不用再做:{rel} 已經是 pass")
        return 0
    if st != "pending":
        print(f"擋下:{rel} 現在是 {st},只有待完成的才能轉正", file=sys.stderr)
        return 2
    home = _guard_home_of_fields(gfields)
    home_rel = env.find(home)
    if home_rel is None:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到", file=sys.stderr)
        return 2
    m = re.search(r"^預告的合約:(.+)$", "\n".join(glines), re.M)
    claim = m.group(1).strip() if m else ""
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條", file=sys.stderr)
        return 2
    if not _guard_settle_home(env, home_rel, claim, method):
        return 2
    return _guard_settle_record(gpath, glines, ge, rel, home_rel, method)


def _guard_settle_home(env, home_rel, claim, method):
    """轉正第一步:家筆記的預告行換成正式合約行;已經是正式行(上次做到一半)就不動。成功回 True(失敗已印原因)。"""
    hpath = env.vault / home_rel
    try:
        hlines, _hs, he = load_raw_for_edit(hpath)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{home_rel} 打不開:{ex}", file=sys.stderr)
        return False
    if _guard_formal_line(hlines, he, claim, method) is None and _guard_formal_line(hlines, he, claim, None) is not None:
        # 同一句已經有正式行、綁的是別的測試(代碼審 r2 外家席):照舊走會寫出第二條同文字的正式行
        print(f"擋下:{home_rel} 已經有同一句的正式合約行、綁的是別的測試;要換測試用 lumos guard bind,"
              "這條預告不重複轉正(要不做了走 lumos guard abandon)", file=sys.stderr)
        return False
    if _guard_formal_line(hlines, he, claim, method) is not None:
        lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
        if lines is None and "找不到預告行" not in (_err or ""):
            # 預告行有好幾條一樣的、或檔打不開:不當成「做到一半」(代碼審 r2 正確性席)
            print(f"擋下:{_err}", file=sys.stderr)
            return False
        if lines is None:
            print(f"{home_rel} 已經是正式合約行(上次轉正做到一半),這次只補守衛紀錄")
            return True
        # ★正式行已在、預告行也還在★(代碼審 r1 正確性席):同一句先有正式行又被預告一次;只拿掉預告行,
        # 不再換成第二條一樣的正式行——原本會印「已換成正式合約」卻把預告行留著,到期被當逾期
        try:
            atomic_write_verify(hpath, lines[:idx] + lines[idx + 1:], PLANNED_MARK,
                                lambda f: f"{PLANNED_MARK} {claim}" not in str(f.get("summary") or ""))
        except (ValueError, RuntimeError) as ex:
            print(f"擋下:{home_rel} 已有正式合約行,但重複的預告行拿不掉: {ex}", file=sys.stderr)
            return False
        print(f"{home_rel} 已經有同一句的正式合約行,只把重複的預告行拿掉")
        return True
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        print(f"擋下:{_err}", file=sys.stderr)
        return False
    newline = f"  KEY:★INVARIANT★ {claim} [test:{method}]"
    try:
        atomic_write_verify(hpath, [*lines[:idx], newline, *lines[idx + 1:]],
                            f"[test:{method}]",
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
            n = int(m.group(1)) if m else 0
            continue
        if path is None or ln.startswith("---"):
            continue
        if ln.startswith("+"):
            out.setdefault(path, []).append((n, ln[1:]))
            n += 1
    return out


def _ns_git(repo_root, *args):
    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
    r = _lens_git(repo_root, *args, quote=True, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _ns_diff(repo_root, *args):
    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
                   "--src-prefix=a/", "--dst-prefix=b/", *args)


def _ns_mainline_refs(repo_root):
    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
    ml = _mainline_ref(repo_root, remote_only=True)
    return [ml[1]] if ml else []


def _ns_exclusions(repo_root, tip):
    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
    out = []
    for ref in _ns_mainline_refs(repo_root):
        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
        if r is not None and r.returncode == 1:
            out.append(ref)
    return out


def _notelines_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, mark=None, max_count=None,
                           hook=_NOTELINES_PRECOMMIT):
    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
    out = []
    for k in ("c1", "c2", "c3", "c4", "c5"):
        rows = [f for f in left if f["kind"] == k]
        nd = sum(1 for f in done if f["kind"] == k)
        if rows:     # 只剩已表態的不開段(全靜默;代碼審 r2 正確性席:表態完那一段永遠不會安靜);全部清單看 drift scan
            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else ""))
    return out


def _drift_gate_doctor_lines(repo_root, vault=None, ci=False):
    """doctor 開頭的閘提醒(照筆記形狀擋與筆記內容審那兩支的位置與呈現):開關不是 block 就講(不管接線沒,設計 [S14]);
    接線後(推送前掛鉤出現標記)專案 CI 沒呼叫 drift check 就給要貼的步驟。唯一的 git 呼叫是讀一次推送前掛鉤。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:        # .lumos 資料夾本身是捷徑也不跟(照 _note_audit_doctor_lines;代碼審 r2 架構對齊席)
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, _w = _drift_config(txt)
    if mode != "block":
        out.append(f"這個專案的存量漂移檢查是 {mode}(.lumos/config.json 的 drift_check.gate;沒寫就是預設)——"
                   "轉正後留著預告句的推送不會被擋")
    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
    if wired and ymls and "drift check" not in body:
        out.append("專案 CI 沒呼叫 `lumos drift check`,`--no-verify` 推上去的沒人查——CI 在 note-audit 那步後面加:"
                   "\n    - run: python3 scripts/lumos drift check --diff \"${{ github.event.before || "
                   "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"")
    return out


