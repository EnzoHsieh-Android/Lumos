def _nodehome_name_status(raw, norm=True):
    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。
    norm=False 保留 git 原樣路徑(要拿去 git 查的呼叫端用;筆記形狀擋驗收輪:NFC 過的路徑對 NFD 樹查不到)。"""
    nfc = globals()["nfc"] if norm else (lambda x: x)
    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
    while i < len(toks):
        code = toks[i][:1]
        if code in ("R", "C") and i + 2 < len(toks):
            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
            if code == "R":
                gone.add(nfc(toks[i + 1]))
            i += 3
        elif i + 1 < len(toks):
            paths.add(nfc(toks[i + 1]))
            if code == "D":
                gone.add(nfc(toks[i + 1]))
            i += 2
        else:
            break
    return paths, src, gone - set(src)


