def _notelines_headings(text, regs):
    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
    lines = text.split("\n")
    vis = {i for i, _l in _visible_lines(lines)}
    dfields = _notelines_decision_fields(text)
    out, cur = [], ""
    for i, ln in enumerate(lines, 1):
        reg = regs[i - 1]
        if reg == "body" and i in vis:
            m = _NOTELINES_HEADING_RE.match(ln)
            if m:
                cur = m.group(1).strip()
        if reg == "summary":
            out.append("summary")
        elif reg == "decisions":
            did, f, _v = dfields.get(i, ("", "", True))
            out.append(f"decisions/{did}/{f}")
        elif reg == "body":
            out.append(cur)
        else:
            out.append("")
    return out


_NOTELINES_TABLE_SEP_RE = re.compile(r"^\s*[|:\-\s]*-[|:\-\s]*$")
_NOTELINES_RULE_RE = re.compile(r"^\s{0,3}(?:(?:-\s*){3,}|(?:\*\s*){3,}|(?:_\s*){3,})$")
_NOTELINES_BARE_LIST_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])(?:\s+\[[ xX]\])?\s*$")


def _notelines_structural_lines(text):
    """沒有主張、不審的行號集合(Projects/筆記內容審_計劃 [S4]):圍欄記號行(照 _visible_lines 認的)、表格分隔行、
    分隔線、只有清單記號的行。空白行本來就不收,不在這裡。"""
    lines = text.split("\n")
    kept = {i for i, _l in _visible_lines(lines, keep_fenced=True)}
    out = set()
    for i, ln in enumerate(lines, 1):
        if not ln.strip():
            continue
        if i not in kept or (_NOTELINES_TABLE_SEP_RE.match(ln) and "|" in ln) or _NOTELINES_RULE_RE.match(ln) \
                or _NOTELINES_BARE_LIST_RE.match(ln):
            out.add(i)
    return out


def _notelines_content_id(path, region, heading, line, done=False):
    """內容編號=(NFC 路徑、區塊、所屬小標題、去頭尾空白的行文字)的短雜湊;完成審多一個標記,不綁任何提交
    (Projects/筆記內容審_計劃 〈做法〉第 2 節)。"""
    import hashlib
    raw = "\0".join([nfc(path), region, heading, line.strip()] + (["完成審"] if done else []))
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]


def _ns_is_code(path, reader, files):
    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
    if path not in files:
        return False
    kind = _nodehome_code_kind(path)
    if kind == "ext":
        return True
    if kind != "shebang?":
        return False
    b = reader(path)
    return b is not None and _head_is_shebang(b[:200])


# 只放連結的指路行:連結裡不准有別名或段落(`[[目標|別名]]`、`[[目標#段落]]` 都能夾帶現況,代碼審 r2、r3 通才席);
# 分隔認中文常用的標點與連接詞(r3 外家席:原本把全形逗號打成半形,測試也用半形,假綠)
_NS_POINTER_ONLY_RE = re.compile(r"^(?:\s*(?:\[\[[^\]|#]+\]\]|見|→|,|\uff0c|、|\u3002|;|\uff1b|與|和|及|\||｜)\s*)*$")


def _ns_pin_ok(repo_root, p, lno, s):
    sha = _pin_commit(repo_root, s)
    return sha is not None and _validate_repo_ref(repo_root, p, lno, at_sha=sha)[0] == "ok"


def _ns_is_regen(text):
    """帶 regen 的重建筆記:照 Check J 看解析後的值(空字串不算;代碼審 r3 外家席:原本看原始文字,`regen: ""` 也算)。"""
    fm, _b = split_frontmatter(text)
    if not fm:
        return False
    v = parse_frontmatter(fm)[0].get("regen")
    return isinstance(v, str) and bool(v.strip())


def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name, regen=False):
    """一行新增內容 → [(規則, 片段, 改法)]。by_name(檔名)→ 同名的程式檔清單。"""
    out = []
    # [src:路徑:行號] 是從程式碼重建的筆記的出處標記,★只在帶 regen 的筆記的 summary 裡★歸重建守衛(Check J)驗;
    # 別的地方照一般行號引用判(代碼審 r2 通才席:原本對所有筆記豁免,一般筆記寫 [src:…] 就能夾帶行號)
    scan = SRC_REF_RE.sub(" ", text) if (regen and region == "summary") else text
    pins, singles = [], []
    full, _bare = _node_code_ref_tokens(scan, top_dirs, bare_text=True, anchors=True, keep_fences=True,
                                        pins=pins, singles=singles,
                                        exists=lambda x, _s=None: x in files or ("/" not in x and bool(by_name(x))))
    fix_pin = ("`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
               "HEAD、分支名、標籤會移動,不算釘住")

    for p, lno, s in pins:
        # 只管程式檔與測試檔——跟沒釘版本時一致(.md、不存在的路徑都不管;代碼審 r1 測試席、r2 外家席)
        if lno and _ns_is_code(p, reader, files) and not _ns_pin_ok(repo_root, p, lno, s):
            out.append(("釘版本不合法", f"`{p}@{s}:{lno}`", fix_pin))
    for p, lno in full:
        if lno and _ns_is_code(p, reader, files):
            out.append(("程式行號引用", f"`{p}:{lno}`",
                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{lno}`"))
    for name, lno, s in singles:
        cands = by_name(name)
        if len(cands) != 1:
            continue
        if s is None:
            out.append(("程式行號引用", f"`{name}:{lno}`(= {cands[0]})",
                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{lno}`"))
        elif not _ns_pin_ok(repo_root, cands[0], lno, s):
            out.append(("釘版本不合法", f"`{name}@{s}:{lno}`(= {cands[0]})", fix_pin))
    if region == "summary":
        m = SYMBOL_RE.match(text.strip())
        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
        if m and not skip:
            return False
        ok_any = True
    ms = re.search(r"search:\s*(.+?)\s+in\s+(\S+)\s*=>\s*(\d+)", evidence or "")
    if ms:
        s, path, n = ms.group(1).strip().strip("`\"'"), ms.group(2).strip("`"), int(ms.group(3))
        if len(s) < 4 or path.startswith("/") or ".." in Path(path).parts:
            return False
        ls = _lens_git(root, "ls-tree", "-r", "--name-only", tip, "--", path)
        # 路徑在那個提交裡不存在時 ls-tree 也回 0、輸出空——不能當成「搜過、零命中」(代碼審 r1 兩席)
        if ls is None or ls.returncode != 0 or not ls.stdout.strip() or len(ls.stdout.splitlines()) > _NOTE_AUDIT_SEARCH_CAP:
            return False
        g = _lens_git(root, "grep", "-c", "-F", "-e", s, tip, "--", path)
        if g is None or g.returncode not in (0, 1):       # 1=沒命中;其他是出錯,不算零命中
            return False
        cnt = 0
        if g.returncode == 0:
            cnt = sum(int(x.rsplit(":", 1)[1]) for x in g.stdout.splitlines() if x.rsplit(":", 1)[-1].isdigit())
        return cnt == n
    return ok_any


def _note_audit_write_verdict(root, doc):
    """一份報告寫一個判定檔(暫存再原子換名;32 位亂數檔名)。回檔名。"""
    import json as _j, uuid as _uuid, datetime as _dt
    d = Path(root) / _NOTE_AUDIT_VERDICT_DIR
    d.mkdir(parents=True, exist_ok=True)
    name = _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + _uuid.uuid4().hex + ".json"
    _write_lf(d / name, _j.dumps(doc, ensure_ascii=False, indent=1) + "\n")
    return name


def _note_audit_work_dir(root):
    d = Path(root) / _NOTE_AUDIT_WORK_DIR
    first = not d.exists()
    d.mkdir(parents=True, exist_ok=True)
    if first or not (d / ".gitignore").exists():
        _write_lf(d / ".gitignore", "*\n")
    import time as _t
    for f in d.glob("*.md"):
        try:
            if _t.time() - f.stat().st_mtime > 14 * 86400:
                f.unlink()
        except OSError:
            pass
    return d


def cmd_note_audit_prepare(repo=None, diff_range=None, orchestrator=None, only=None):
    """lumos note-audit prepare --diff A..B --orchestrator claude|codex [--only 編號…](計劃〈做法〉第 3 節第 1 點)。"""
    root = _note_audit_root(repo)
    if root is None:
        print("筆記內容審:這裡不是 git 專案", file=sys.stderr)
        return 2
    if orchestrator not in ("claude", "codex"):
        print("擋下:--orchestrator 要給 claude 或 codex(編排這次的那一家;判定者跟它同一家)", file=sys.stderr)
        return 2
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    got = _note_audit_items(root, base, tip, vault_rel)
    if got is None:
        print("筆記內容審:git 算不出這次的筆記行", file=sys.stderr)
        return 2
    items, errs = got
    for e in errs:
        print(f"  {e}", file=sys.stderr)
    docs, bad = _note_audit_load_verdicts(root, None)
    for n in bad:
        print(f"提醒:判定檔 {n} 壞掉了(讀不成 JSON 或缺欄位),當作不存在", file=sys.stderr)
    fold = _note_audit_fold(docs)
    # 同一個內容編號的每一處都列(同一小標題下一字不差的兩行,上下文可能一處是脈絡、一處是現況;代碼審 r1 兩席)
    want = set(only) if only else None
    pending = [it for it in items if (it["id"] in want if want is not None else not _note_audit_covered(fold.get(it["id"])))]
    if not pending:
        print("沒有待審的筆記行")
        return 0
    prompt = _note_audit_prompt(root)
    if prompt is None:
        print(f"擋下:找不到派工詞範本 {_NOTE_AUDIT_TEMPLATE}(跑一次 lumos update)", file=sys.stderr)
        return 2
    big = {}
    for it in pending:
        big[it["id"]] = big.get(it["id"], 0) + 1
    for rid, n in big.items():
        if n > _NOTE_AUDIT_BATCH:
            print(f"提醒:內容編號 {rid} 同一小標題下有 {n} 處一字不差的行,清單只列前 {_NOTE_AUDIT_BATCH} 處——"
                  "判成脈絡也收不下,請改寫那些重複行", file=sys.stderr)
    wd = _note_audit_work_dir(root)
    outs = []
    for batch in _note_audit_batches(pending):
        content, fp = _note_audit_render_list(orchestrator, tip, batch, prompt)
        f = wd / f"{fp}-{orchestrator}.md"
        _write_lf(f, content)
        outs.append((f, fp, len(batch)))
        _gate_event_or_warn(root, "note-audit", "prepare", f"清單 {fp}:{len(batch)} 行")
    print(f"待審 {len({it['id'] for it in pending})} 個編號({len(pending)} 處),切成 {len(outs)} 份清單;每份派一席 {_note_audit_judge_model(orchestrator)}"
          f"(跟編排者同一家),報告照清單開頭的格式寫:")
    for f, fp, n in outs:
        print(f"  {f}  ({n} 行,清單指紋 {fp})")
    print("判定者交回報告後:\n    lumos note-audit record --diff <同一個範圍> --prepared <清單檔> --report <報告>")
    return 0


def cmd_note_audit_record(repo=None, diff_range=None, prepared=None, reports=None, dispute=False, disputes=None):
    """lumos note-audit record --diff A..B --prepared <清單> --report <報告>…[--dispute --disputes <判定檔>]
    (計劃〈做法〉第 3 節第 5 點)。照信任方向逐行收:重的(CODE/MIXED)照收,輕的(CONTEXT)要來源對、上下文沒變才收。"""

def _drift_doctor_lines(env):
    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
    root, vault_rel = _drift_vault_of(env)
    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
    out = []
    for k in ("c1", "c2", "c3", "c4", "c5"):
        rows = [f for f in left if f["kind"] == k]
        nd = sum(1 for f in done if f["kind"] == k)
        if rows:     # 只剩已表態的不開段(全靜默;代碼審 r2 正確性席:表態完那一段永遠不會安靜);全部清單看 drift scan
            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else ""))
    return out


def _drift_gate_doctor_lines(repo_root, vault=None, ci=False):
    """doctor 開頭的閘提醒(照筆記形狀擋與筆記內容審那兩支的位置與呈現):開關不是 block 就講(不管接線沒,設計 [S14]);
    接線後(推送前掛鉤出現標記)專案 CI 沒呼叫 drift check 就給要貼的步驟。唯一的 git 呼叫是讀一次推送前掛鉤。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:        # .lumos 資料夾本身是捷徑也不跟(照 _note_audit_doctor_lines;代碼審 r2 架構對齊席)
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, _w = _drift_config(txt)
    if mode != "block":
        out.append(f"這個專案的存量漂移檢查是 {mode}(.lumos/config.json 的 drift_check.gate;沒寫就是預設)——"
                   "轉正後留著預告句的推送不會被擋")
    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
    if wired and ymls and "drift check" not in body:
        out.append("專案 CI 沒呼叫 `lumos drift check`,`--no-verify` 推上去的沒人查——CI 在 note-audit 那步後面加:"
                   "\n    - run: python3 scripts/lumos drift check --diff \"${{ github.event.before || "
                   "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"")
    return out


