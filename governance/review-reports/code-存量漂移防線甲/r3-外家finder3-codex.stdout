 24542	def _git_log_sha_paths(raw):
 24543	    """git log -z --format=%H --name-only 的輸出 →[(sha, 那時的路徑)]。
 24544	    格式是「sha\0\n路徑\0」一筆接一筆(實測;換行黏在路徑前面)。"""
 24545	    pairs, cur = [], None
 24546	    for tok in raw.decode("utf-8", errors="surrogateescape").split("\0"):
 24547	        tok = tok.strip("\n")
 24548	        if not tok:
 24549	            continue
 24550	        if cur is None and _LENS_SHA_RE.fullmatch(tok):
 24551	            cur = tok
 24552	        elif cur is not None:
 24553	            pairs.append((cur, tok))
 24554	            cur = None
 24555	    return pairs
