     if state == "absent":
         return "  (本機沒有 Codex 家目錄(~/.codex 或 $CODEX_HOME)=還沒用過 codex:略過 Codex hooks;用過之後再跑一次 lumos install --force)"
     if state == "home-not-dir":
         return f"  ⚠ Codex 家目錄 {_codex_home()} 不是目錄(是個檔案):略過 Codex hooks——搬走那個檔再跑 lumos install --force"
     return f"  ? 全域 {name} hooks 同步狀態 {state}"
