+def _cb2_util_block(text, rid, name):
+    """規則檔裡 id 是 rid 那一份文件的 utils 底下 name 那一段(到下一個同層鍵為止)的原文;找不到回 None。"""
+    import re as _re
+    for doc in _re.split(r"^---\s*$", text, flags=_re.M):
