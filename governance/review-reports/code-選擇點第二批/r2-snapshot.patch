+                         "token": _os_mod.urandom(8).hex(), "file": _CHOICE_MAIN, "row": row, "attempt": 1, "via": "run", **kw},
+                        ensure_ascii=False) + "\n"
+
+    def wv(commit, ts, fp, label, **kw):
