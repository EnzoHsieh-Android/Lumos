++++++def _cb2_new(points, ln):
++++++    """那一行挑到的壞法的 new(去頭尾空白);沒有回 None。"""
++++++    x = next((p for p in points or [] if p["line"] == ln), None)
++++++    ident = ((x or {}).get("mutant") or {}).get("identity") or {}
++++++    return ident["new"].strip() if "new" in ident else None
