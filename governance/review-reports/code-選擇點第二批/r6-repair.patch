+++    i = text.find(f"\n## {CHOICE_TITLE}")
+++    if i < 0:
+++        return set(), None
+++    j = text.find("\n## ", i + 1)
+++    lines = [ln for ln in text[i:j if j >= 0 else len(text)].split("\n") if "已撤列號" in ln]
