+++++    edits = m._choice_edits(bb, h, row, op, "$A!!")
+++++    check("S1 `$A` 是 a + b → 換成 (a + b)!!(假命中)", edits == [(h["s"], h["e"], b"(a + b)!!")], str(edits))
