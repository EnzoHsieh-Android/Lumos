++    for doc in _re.split(r"^---\s*$", text, flags=_re.M):
++        if _re.search(rf"^id:\s*{_re.escape(rid)}\s*$", doc, _re.M):
++            m = _re.search(rf"^  {_re.escape(name)}:\n(?:(?:    .*|)\n)*", doc, _re.M)
++            return m.group(0).rstrip() if m else None
++    return None
