-                - inside: {kind: try_expression, matches: value-pos}
-                - inside: {kind: catch_block, inside: {kind: try_expression, matches: value-pos}}
+                - inside: {kind: control_structure_body, inside: {kind: if_expression, matches: value-direct}}
+                - inside: {kind: control_structure_body, inside: {kind: when_entry, inside: {kind: when_expression, matches: value-direct}}}
+                - inside: {kind: try_expression, matches: value-direct}
+                - inside: {kind: catch_block, inside: {kind: try_expression, matches: value-direct}}
 rule:
   kind: navigation_suffix
   regex: '^(\?\.|\.)\s*let$'
   # 父節點是 navigation_expression、它的父節點是值被用到的呼叫;寫成雙重否定(同 C-18,避免外層整段被塞進每個命中)
