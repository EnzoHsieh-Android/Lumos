  5838	def _roster_dispatch_entries(loop_dir, rid):
  5839	    """解析一輪的 rN-dispatch*.json → (auditor 串列, 跳過檔數)。三種真實形狀:
  5840	    ①dict 頂層 auditor ②dict 帶 seats 陣列 ③頂層 list;壞損 JSON 與不符形狀同一處置=跳過不計。"""
  5841	    import json as _json
  5842	    auditors, skipped = [], 0
  5843	    for f in sorted(loop_dir.glob(f"{rid}-dispatch*.json")):
  5844	        try:
  5845	            obj = _json.loads(f.read_text(encoding="utf-8"))
  5846	        except (OSError, UnicodeDecodeError, ValueError):
  5847	            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
  5848	            skipped += 1
  5849	            continue
  5850	        if isinstance(obj, dict) and "auditor" in obj:
  5851	            elems = [obj]
  5852	        elif isinstance(obj, dict) and isinstance(obj.get("seats"), list):
  5853	            elems = obj["seats"]
  5854	        elif isinstance(obj, list):
  5855	            elems = obj
  5856	        else:
  5857	            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
  5858	            skipped += 1
  5859	            continue
  5860	        for e in elems:
  5861	            a = e.get("auditor") if isinstance(e, dict) else None
  5862	            auditors.append(a if isinstance(a, str) else None)   # 非字串(數字/巢狀物)=無名席→unknown 桶,不炸整段觀測
  5863	    return auditors, skipped
