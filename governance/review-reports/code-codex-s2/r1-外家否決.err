  5820	def _roster_family(auditor, orchestrator="claude"):
  5821	    """auditor 字串→(family, dual_hit)。family 是★相對編排者★的:"claude"=同門(編排者那一家)、"external"=外家
  5822	    (保留舊字串,_TIER_ROSTER 的 family 欄同義:claude 席=同門席、external 席=外家席;d4 相對化 2026-09-04)。
  5823	    lower() 子串比對;判序寫死外家先比、先命中先贏。orchestrator=codex 時 codex/gpt 是同門、sonnet/opus/claude 是外家。"""
  5824	    s = (auditor or "").lower()
  5825	    if orchestrator == "codex":
  5826	        own = any(k in s for k in _ROSTER_CODEX_KEYS)
  5827	        other = any(k in s for k in _ROSTER_CLAUDE_KEYS) or any(k in s for k in _ROSTER_EXTERNAL_KEYS if k not in _ROSTER_CODEX_KEYS)
  5828	    else:
  5829	        own = any(k in s for k in _ROSTER_CLAUDE_KEYS)
  5830	        other = any(k in s for k in _ROSTER_EXTERNAL_KEYS)
  5831	    if other:
  5832	        return ("external", own)
  5833	    if own:
  5834	        return ("claude", False)
  5835	    return ("unknown", False)
