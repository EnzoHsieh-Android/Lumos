  5792	def _loop_records(env, loop_id):
  5793	    """canary-log 裡某編號的全部記錄(唯讀;壞行跳過)。"""
  5794	    import json as _json
  5795	    path = env.vault.parent / ".canary-log.jsonl"
  5796	    out = []
  5797	    try:
  5798	        if path.exists():
  5799	            for line in path.read_text(encoding="utf-8").splitlines():
  5800	                line = line.strip()
  5801	                if not line:
  5802	                    continue
  5803	                try:
  5804	                    d = _json.loads(line)
  5805	                except ValueError:
  5806	                    continue
  5807	                if d.get("loop") == loop_id:
  5808	                    out.append(d)
  5809	    except OSError:
  5810	        return out
  5811	    return out
