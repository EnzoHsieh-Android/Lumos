+def _mr_rep(items, top=None):
+    """已正規化的席報告:檔級行(預設=各條最高)+ 每條一段 ## Fn、一行 severity、一句錨得到快照的引句。"""
+    top = top or max(items, key=_MR_ORDER.get)
+    return f"severity: {top}\n" + "".join(f"## F{i}\nseverity: {s}\n{_MR_Q}" for i, s in enumerate(items, 1))
