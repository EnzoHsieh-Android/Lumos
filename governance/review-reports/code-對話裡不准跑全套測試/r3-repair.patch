+def _home_cache_append_line(segments, filename, line):
+    """往 ~/<segments...>/<filename> 安全地追加一行(單一來源;治理帳寫不進去的留痕、測試執行器對話裡擋全套的計數都走這支)。
+    逐層建目錄並檢查可信(_mkdir_trusted_under_home、_trusted_private_dir);開檔走 _regular_own_fd(擋捷徑、管線、別人的檔,
+    0600),單次寫入並核對長度,短寫不算寫成。任何一步不過回 False,不丟例外。"""
+    if not _mkdir_trusted_under_home(*segments):
+        return False
+    d = Path.home().joinpath(*segments)
+    if not _trusted_private_dir(d, *segments):
+        return False
+    fd = _regular_own_fd(d / filename, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+    if fd is None:
+        return False
+    try:
+        data = line.encode("utf-8")
+        return os.write(fd, data) == len(data)   # 比照 _ledger_append:短寫(磁碟滿)不算寫成
+    except OSError:
+        return False
+    finally:
+        os.close(fd)
