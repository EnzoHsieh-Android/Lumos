 def _home_cache_evict(d, ttl_sec, max_files=None):
     """~/.cache/lumos/<子目錄>/ 刪掉 mtime 超過 ttl_sec 的一般檔(捷徑不碰);max_files 給了就只留最新的那麼多份。
     ★先過 _trusted_private_dir★(寫入端唯一的目錄可信判定,2026-09-06 全 repo 審視 #6):目錄被換成指向別處的捷徑、
     不是自己的、別人可寫,一支都不刪(代碼審 r3 正確性 F1:原本清理端沒驗,捷徑會刪到快取以外的檔)。d 是 None 或讀不了也不做。"""
     if d is None or not _trusted_private_dir(Path(d), ".cache", "lumos", Path(d).name):
         return
     try:
         ents = [f for f in Path(d).iterdir() if f.is_file() and not f.is_symlink()]
     except OSError:
         return
