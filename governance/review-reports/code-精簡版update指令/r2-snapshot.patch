+#!/usr/bin/env bash
+# Git post-commit hook — bypass 留痕 (L2 的觀測面)
+#
+# ★精簡版★:自完整版 scripts/hooks/post-commit 移植,三處改動——
+#   ① should_exclude 做與 pre-commit 完全相同的瘦身(只留 scripts/hooks/*)。
+#      ★兩邊必須逐字一致★:判定不一致會產生幽靈 bypass 或漏記。
+#   ② 結尾訊息改為直接說明如何檢視 log。
+#   ③ diff-tree 加 --root:沒有這個旗標,repo 的第一筆 commit(zero-parent)
+#      diff-tree 不會印出任何檔案,導致該筆 commit 永遠無法被判定為 bypass。
+#      對有 parent 的一般 commit 是 no-op,不影響既有判定。
+#
+# 設計理由:
+#   L2 pre-commit 硬擋有合法後門 `--no-verify`,但走後門零痕跡——bypass 率
+#   是「不更新圖譜比更新圖譜更難」這個核心宣稱唯一沒被量測的數字。
+#   關鍵事實:--no-verify 只跳過 pre-commit / commit-msg,post-commit 永遠會跑,
+#   所以本 hook 是天然的偵測點:凡「有 code 異動但無圖譜 .md」的 commit 能落地,
+#   必然繞過了 L2 → append 結構化事件到 docs/.bypass-log.jsonl。
+#
+#   只記錄、不阻擋、不問理由——bypass 本來就是被認可的逃生口,這裡要的是
+#   「率」不是「罪」。
+#
+# 判定邏輯與 scripts/hooks/pre-commit 完全對齊 (CODE_EXTS_RE / 排除規則 /
+# GRAPH_ROOT 偵測),兩邊認定不一致會產生幽靈 bypass 或漏記。
+
+set -u
+
+# post-commit 絕不能影響 commit 結果:任何錯誤都靜默結束
+trap 'exit 0' ERR
+
+REPO_ROOT="$(git rev-parse --show-toplevel)"
+cd "$REPO_ROOT" || exit 0
+
+# 找圖譜目錄 (對齊 pre-commit)
+GRAPH_ROOT=""
+if [[ -d docs ]]; then
+  for d in docs/*-knowledge; do
+    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
+  done
+  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
+fi
+[[ -z "$GRAPH_ROOT" ]] && exit 0
+
+# 判斷「這份檔案清單裡有沒有圖譜目錄底下的 .md」
+# ★不要用 grep -qE "^${GRAPH_ROOT}/.*\.md$" 做這件事★(2026-08-11 終審複審):
+# GRAPH_ROOT 是從檔案系統掃出來的目錄名,可能含 ERE 元字元——`docs/c++-knowledge`
+# 對一個 C++ 專案完全正常。內插進 ERE 後 grep 以 rc=2(語法錯誤)收場,而 `if`
+# 只看「非 0」→ 一律讀成「沒有圖譜 .md」。後果:pre-commit 的 Gate 3 永遠擋、
+# post-commit 把每一筆 commit 都記成 bypass,而且兩者都沒有任何錯誤訊息。
+# 改用 bash 樣式比對:左邊是資料,右邊只有 `/*.md` 是樣式,`"$GRAPH_ROOT"` 加了
+# 引號就是字面比對——不需要跳脫,也不必外掛 sed(hook 執行時的 PATH 可能很小)。
+# 語意與原 ERE 相同(`*` 在 [[ ]] 樣式裡一樣跨 `/`,含子目錄)。
+# ★本函式在 pre-commit / post-commit 兩支必須逐字一致★(與 should_exclude 同款
+# 約束):兩邊判定不一致會產生幽靈 bypass 或漏記。
+has_graph_md() {
+  local _line
+  while IFS= read -r _line; do
+    [[ "$_line" == "$GRAPH_ROOT"/*.md ]] && return 0
+  done <<< "$1"
+  return 1
+}
+
+# merge commit 不適用 bypass 概念 (內容來自既有 commit) → 跳過
+if [[ "$(git rev-list --parents -n 1 HEAD | wc -w)" -gt 2 ]]; then
+  exit 0
+fi
+
+# 本次 commit 的檔案清單 (quotePath=off 對齊 pre-commit 的中文路徑處理; --root 支援初始 commit)
+CHANGED="$(git -c core.quotePath=off diff-tree --no-commit-id --name-only -r --root HEAD)"
+[[ -z "$CHANGED" ]] && exit 0
+
+# code 副檔名與排除規則 (對齊 pre-commit)
+CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp)$'
+
+should_exclude() {
+  local path="$1"
+  case "$path" in
+    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
+    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
+    # 本 hook 自己所在的目錄:精簡版唯一會被安裝器放進專案的東西。
+    # ★精確白名單,非 scripts/* 整夾★——專案自有 scripts/foo.py 仍照擋。
+    # ★源 repo 守門★:在 lumos 來源 repo 本身(有 skills/lumos-project-notes),
+    # 這些檔=產品碼,豁免不適用(否則源 repo 自家改 hook 不帶圖譜會靜默放行)。
+    scripts/hooks/*)
+      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
+      return 0;;
+  esac
+  return 1
+}
+
+src_files=()
+while IFS= read -r f; do
+  [[ -z "$f" ]] && continue
+  if ! [[ "$f" =~ $CODE_EXTS_RE ]]; then continue; fi
+  if should_exclude "$f"; then continue; fi
+  src_files+=("$f")
+done <<< "$CHANGED"
+
+# 沒 code → 本來就會被 pre-commit 放行,不是 bypass
+[[ ${#src_files[@]} -eq 0 ]] && exit 0
+
+# 有圖譜 .md 一起 commit → 正常通過 L2,不是 bypass
+if has_graph_md "$CHANGED"; then
+  exit 0
+fi
+
+# ── 走到這裡 = 這筆 commit 繞過了 L2 → 留痕 ──
+BYPASS_LOG="$REPO_ROOT/docs/.bypass-log.jsonl"
+
+PY="$(command -v python3 || command -v python)"
+COMMIT_HASH="$(git rev-parse --short HEAD)" \
+BRANCH="$(git branch --show-current)" \
+SUBJECT="$(git log -1 --format=%s)" \
+SRC_COUNT="${#src_files[@]}" \
+SRC_SAMPLE="$(printf '%s\n' "${src_files[@]:0:10}")" \
+"$PY" - "$BYPASS_LOG" <<'PYEOF'
+import json, os, sys
+from datetime import datetime, timezone
+
+entry = {
+    "ts": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
+    "commit": os.environ["COMMIT_HASH"],
+    "branch": os.environ["BRANCH"],
+    "subject": os.environ["SUBJECT"],
+    "code_file_count": int(os.environ["SRC_COUNT"]),
+    "code_files": os.environ["SRC_SAMPLE"].splitlines(),
+}
+with open(sys.argv[1], "a", encoding="utf-8") as f:
+    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
+PYEOF
+
+{
+  echo ""
+  echo "📋 L2 bypass 已留痕 (docs/.bypass-log.jsonl): ${#src_files[@]} 個 code 檔未帶圖譜異動"
+  echo "   檢視 bypass 率: wc -l docs/.bypass-log.jsonl"
+  echo "   若此 commit 其實該補圖譜,趁記憶新鮮補上"
+  echo ""
+} >&2
+
+exit 0
