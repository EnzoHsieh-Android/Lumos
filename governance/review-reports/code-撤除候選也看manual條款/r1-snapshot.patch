 def _sr_vault():
     """兩篇功能 A、B,一篇計劃 P;回 vault。"""
     v = mkvault()
     write(v, "Systems/A.md", "type: system\nstatus: done", body="# A\n")
     write(v, "Systems/B.md", "type: system\nstatus: done", body="# B\n")
     write(v, "Projects/P.md", "type: project\nstatus: doing", body="# P\n")
     return v
 
