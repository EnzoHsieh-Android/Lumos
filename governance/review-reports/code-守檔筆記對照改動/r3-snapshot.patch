+    硬連結數)與訊息——原本兩份各寫一套,一邊補洞(例如 Windows junction)另一邊不會跟。"""
+    rootp = Path(root)
+    cur = rootp
+    for seg in Path(rel).parts:
+        cur = cur / seg
+        if cur.is_symlink():
+            return "symlink", cur
+        if dirs and cur.exists() and not cur.is_dir():
+            return "notdir", cur
+    fp = rootp / rel
+    if not fp.resolve().is_relative_to(rootp.resolve()):
+        return "outside", fp
+    return None
