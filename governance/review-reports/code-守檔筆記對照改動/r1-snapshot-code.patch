+def _note_reread_config(text):
+    """被推頂端提交的 .lumos/config.json 內容(bytes 或 None)→ (gate, warnings)。鍵名與值域同 note_audit.gate、drift_check.gate、
+    note_shape.gate(block/warn/off);沒寫照 warn;壞設定四種(讀不成 JSON、note_reread 不是物件、值不合法、null)各給一句、照 warn。
+    這一版寫 block 也照 warn,另給一句「轉擋還沒做」(計劃〈做法〉4)。"""
+    import json as _j
+    if text is None:
+        return "warn", []
+    try:
+        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
+    except (ValueError, UnicodeDecodeError):
+        return "warn", [".lumos/config.json 讀不成 JSON,回頭重讀提醒照預設 warn"]
+    nr = cfg.get("note_reread") if isinstance(cfg, dict) else None
+    if nr is not None and not isinstance(nr, dict):
+        return "warn", ["設定檔的 note_reread 不是物件(要寫成 {\"note_reread\": {\"gate\": \"off\"}}),回頭重讀提醒照預設 warn"]
+    if not isinstance(nr, dict) or "gate" not in nr:
+        return "warn", []
+    g = nr.get("gate")
+    if g is None:
+        return "warn", ["note_reread.gate 寫成 null,照預設 warn"]
+    if g not in _NOTE_REREAD_GATE_VALUES:
+        return "warn", [f"note_reread.gate 只能是 block/warn/off,你寫的是 {g!r},照 warn"]
+    if g == "block":
+        return "warn", ["note_reread.gate 寫了 block:轉擋還沒做,照提醒"]
+    return g, []
+
