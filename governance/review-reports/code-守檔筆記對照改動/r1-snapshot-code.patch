+def _note_reread_json_block(text):
+    """報告裡的 json 區塊(計劃〈做法〉3)→ 字串或 None。每行先去掉尾端的 \\r 與空白;取最後一段「整行等於 ```json
+    (json 不分大小寫)」到下一個「整行等於 ```」之間;最後一段沒收尾(輸出被截斷)就退回前一段完整的。"""
+    blocks, cur = [], None
+    for ln in text.split("\n"):
+        s = ln.rstrip()
+        if cur is None:
+            if s.lower() == "```json":
+                cur = []
+        elif s == "```":
+            blocks.append("\n".join(cur))
+            cur = None
+        else:
+            cur.append(s)
+    return blocks[-1] if blocks else None
+
