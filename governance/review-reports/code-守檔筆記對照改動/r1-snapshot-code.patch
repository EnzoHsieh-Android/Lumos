+def _note_reread_contrast_fp(note_full, about, tip_oids):
+    """對照指紋(計劃〈做法〉2;prepare 與 check 都呼叫這一支,輸入口徑寫死在這裡):16 個十六進位字 =
+    雜湊(筆記路徑〔NFC、含圖譜前綴〕、那篇頂端 about_code 每一項〔_nodehome_key 正規化〕配上它在頂端的 blob 編號
+    〔不是一般檔或不在頂端記成「無」〕排序後串起來、範本版本)。
+    ★不含筆記自己的 blob★:作者照判定改了筆記,同一次推送裡再跑 check 仍認得「這篇對照過這一版程式」(設計審 r2 正確性席);
+    ★不含範圍與 diff★:手動 prepare 與推送前 check 的起點算法可能不同,含 diff 的指紋對不上、提醒永遠消不掉(設計審 r1 四席)。
+    只要 ls-tree 就能算,作者本機的 diff 設定也不影響它。"""
+    import hashlib
+    keys = sorted({k for k in (_nodehome_key(v) for v in about) if k})
+    parts = [nfc(note_full)] + [f"{k}\t{tip_oids.get(k) or '無'}" for k in keys] + [f"範本版本 {_NOTE_REREAD_PROMPT_VERSION}"]
