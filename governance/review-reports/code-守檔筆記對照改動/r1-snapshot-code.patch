+def _note_reread_item(root, scan, rel, orchestrator, base, tip, codeish):
+    """一篇的項目檔 → ((內容, 材料指紋, 對照指紋, 派工詞字數), None) 或 (None, 原因)。
+    檔頭與本文用清單檔的「\\n---本文---\\n」切開,record 只讀檔頭;本文就是派工詞(範本照佔位字表填好)。"""
+    pre = scan["vault_rel"] + "/"
+    note_full = pre + rel
