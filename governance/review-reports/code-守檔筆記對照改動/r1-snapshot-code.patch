+def _note_reread_material_fp(contrast_fp, note_blob, diff):
+    """材料指紋(計劃〈做法〉2;項目檔名、報告的 prepared:、record 驗來源用它):雜湊(對照指紋、筆記頂端 blob、給判定者的 diff 全文)。
+    筆記改了再 prepare 得到新的材料指紋、新的項目檔,不會蓋掉判定者還在讀的那一份(設計審 r3 兩席)。"""
+    import hashlib
+    return hashlib.sha256("\n".join((contrast_fp, note_blob, diff)).encode("utf-8", "surrogateescape")).hexdigest()[:16]
