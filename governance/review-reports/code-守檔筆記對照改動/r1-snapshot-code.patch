+def _note_reread_diff(root, base, tip, raws, cap=None):
+    """給判定者的程式 diff(算法照實驗 governance/eval/home-check/validate/scripts/vcommon.py 的 truncated_diff)
+    → (diff, 截斷了沒, 原始字元數, 上下文行數) 或 None(git 失敗或逾時)。
+    上下文照 3、1、0 行依序試,哪一種不超過上限就用哪一種;0 行仍超過,把各檔 diff 由小到大分配剩下的字數,
+    超過分到的在行界截掉並接一行「[截斷:本檔 diff 另有 N 行未列出]」。
+    組法固定參數:作者本機的 diff 設定(外部 diff、轉文字、顏色、前綴)不影響材料;pathspec 是 git 原樣路徑、帶 --literal-pathspecs
+    (檔名含 [id]、* 這類字元時不當萬用字元,不會把別支檔的改動混進來;設計審 r2 邊界席實測)。"""
+    cap = _NOTE_REREAD_DIFF_CAP if cap is None else cap
+    if not raws:
+        return "(無)", False, 0, 3
+    total, d = None, ""
+    for u in (3, 1, 0):
+        out = _ns_git(root, "--literal-pathspecs", "diff", *_NOTE_REREAD_DIFF_ARGS, f"-U{u}", "-M",
+                      base or _drift_empty_tree(root), tip, "--", *raws)
+        if out is None:
+            return None
+        d = out.decode("utf-8", errors="replace")
+        if total is None:
+            total = len(d)
+        if len(d) <= cap:
+            return d, u != 3, total, u
+    parts = [p for p in re.split(r"(?m)^(?=diff --git )", d) if p.strip()]
+    order = sorted(range(len(parts)), key=lambda i: len(parts[i]))
+    got, remaining, left = [None] * len(parts), cap, len(parts)
+    for i in order:
+        share = remaining // left
+        p = parts[i]
+        if len(p) <= share:
+            got[i] = p
+        else:
+            cut = p[:share]
+            cut = cut[:cut.rfind("\n") + 1]
+            got[i] = cut + f"[截斷:本檔 diff 另有 {p[len(cut):].count(chr(10))} 行未列出]\n"
+        remaining -= len(got[i])
+        left -= 1
+    return "".join(got), True, total, 0
+
