+def _note_reread_rows(items, nlines):
+    """json 清單逐項收(計劃〈做法〉3)→ (收下的 [{line, quote, why}], 丟掉的原因 [str])。
+    每項要是物件、line 是整數(布林不算、字串不算)、介於 1 到筆記行數;quote、why 缺了當空字串、不是字串就轉成字串、各截到 500 字;
+    同一個行號出現多次只留第一次。"""
+    keep, dropped, seen = [], [], set()
+
+    def _s(v):
+        return (v if isinstance(v, str) else str(v))[:_NOTE_REREAD_TEXT_MAX]
+    for k, it in enumerate(items, 1):
+        if not isinstance(it, dict):
+            dropped.append(f"第 {k} 項不是物件")
+            continue
+        ln = it.get("line")
+        if isinstance(ln, bool) or not isinstance(ln, int):
+            dropped.append(f"第 {k} 項的 line 不是整數({_esc_clean(repr(ln), 40)})")
+            continue
+        if not 1 <= ln <= nlines:
+            dropped.append(f"第 {k} 項的行號 {ln} 不在 1 到 {nlines} 之間")
+            continue
+        if ln in seen:
+            dropped.append(f"第 {k} 項的行號 {ln} 重複,只留第一次")
+            continue
+        seen.add(ln)
+        keep.append({"line": ln, "quote": _s(it.get("quote", "")), "why": _s(it.get("why", ""))})
+    return keep, dropped
+
