+    trunc_s = ""
+    if orphans:
+        trunc_s += ",另加同套件目錄裡沒有家的測試檔(" + "、".join(show(f) for f in orphans) + ")"
+    if trunc:
+        trunc_s += (f"(原始 diff {total} 字元,超過 {_NOTE_REREAD_DIFF_CAP} 上限:上下文縮成 {ctx} 行"
+                    + (",仍超過的再各檔平均截斷,截掉處有註明" if "[截斷:" in diff else "") + ")")
+    others_s = "無" if not others else ("、".join(show(f) for f in others[:_NOTE_REREAD_OTHERS_MAX])
+                                        + (f" …等共 {len(others)} 支" if len(others) > _NOTE_REREAD_OTHERS_MAX else ""))
+    cfp = _note_reread_contrast_fp(note_full, _note_reread_about(scan, rel), scan["oids"])
+    mfp = _note_reread_material_fp(cfp, oid, diff)
+    prompt = _note_template_fill(root, _NOTE_REREAD_TEMPLATE, {
+        "TRUNC": trunc_s, "OTHERS": others_s, "DIFF": diff, "NOTE": show(rel), "TIP": tip,
+        "NOTETEXT": _note_reread_numbered(text)})
+    if prompt is None:
+        return None, f"找不到派工詞範本 {_NOTE_REREAD_TEMPLATE}(跑一次 lumos update)"
+    head = ["# 回頭重讀項目檔", "",
+            f"編排者: {orchestrator}", f"判定者模型: {_note_audit_judge_model(orchestrator, 'reread')}",
+            f"範本版本: {_NOTE_REREAD_PROMPT_VERSION}", f"材料指紋: {mfp}", f"對照指紋: {cfp}",
+            f"筆記路徑: {show(note_full)}", f"筆記 blob: {oid}", f"筆記行數: {len(text.split(chr(10)))}", f"範圍終點: {tip}", "",
+            "派工詞是「---本文---」那一行之後的全部;報告開頭四行照派工詞說的,抄這裡的編排者、判定者模型、材料指紋。"]
+    return ("\n".join(head) + "\n---本文---\n" + prompt, mfp, cfp, len(prompt)), None
+
