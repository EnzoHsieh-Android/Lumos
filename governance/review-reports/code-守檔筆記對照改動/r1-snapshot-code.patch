+    import shlex
+    parts = ["lumos", "note-audit", "reread-prepare", "--diff", shlex.quote(diff_range)]
+    if push is not None:
+        parts += ["--push-remote", shlex.quote(push[0]), "--pushed-ref", shlex.quote(push[1])]
