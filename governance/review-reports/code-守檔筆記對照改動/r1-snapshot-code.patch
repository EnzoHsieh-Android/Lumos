+    text = blobs[0].decode("utf-8", errors="replace")
+    mine, orphans, others = _note_reread_given(scan, rel, codeish)
+    got = _note_reread_diff(root, base, tip, [scan["changed"][f] for f in mine + orphans])
+    if got is None:
+        return None, "組 diff 的 git 失敗或逾時,這篇不產項目檔"
+    diff, trunc, total, ctx = got
