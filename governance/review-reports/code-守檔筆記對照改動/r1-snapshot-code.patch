+def _note_reread_numbered(text):
+    """筆記全文加行號(照實驗):照 text.split("\\n") 切,檔尾換行造成的最後一個空字串也算一行;行號從 1 起、含開頭欄位,
+    靠右補滿 4 格、接「| 」、再接內容。"""
+    return "\n".join(f"{i:4d}| {ln}" for i, ln in enumerate(text.split("\n"), 1))
+
