+def _note_reread_codeish(root, scan):
+    """「另外改到的程式檔」的母體:這次改到、在起點或頂端要有家(_nodehome_required),或 _nodehome_is_test 判是測試的程式檔;
+    筆記與帳本不列(跟實驗只列程式檔一致)。只有 prepare 用(check 不組 diff,不付這個成本)。"""
