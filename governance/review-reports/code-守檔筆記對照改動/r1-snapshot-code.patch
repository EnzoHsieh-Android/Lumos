+    tside = _nodehome_side(root, tip, vault_rel)
+    if tside is None:
+        raise _NoteRereadStop(_note_reread_fail(deadline, "讀不到頂端的圖譜"))
+    _tick()
+    bside = _nodehome_side(root, base, vault_rel, share=tside, changed=set(changed))
