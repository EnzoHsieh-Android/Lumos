+def cmd_note_audit_reread_prepare(repo=None, diff_range=None, orchestrator=None, push_remote=None, pushed_ref=None):
+    """lumos note-audit reread-prepare --diff A..B --orchestrator claude|codex [--push-remote R --pushed-ref REF]
+    (Projects/守檔筆記對照改動_計劃〈做法〉1、2):每篇候選一份項目檔,印派工指令;沒有候選不產生檔、rc0;不記治理帳(帳只由 check 記)。"""
+    root = _note_audit_root(repo)
+    if root is None:
+        print("回頭重讀:這裡不是 git 專案", file=sys.stderr)
+        return 2
+    if orchestrator not in ("claude", "codex"):
+        print("擋下:--orchestrator 要給 claude 或 codex(編排這次的那一家;判定者跟它同一家)", file=sys.stderr)
