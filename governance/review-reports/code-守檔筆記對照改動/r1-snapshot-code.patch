+def _note_reread_parse_item(text):
+    """項目檔 → 檔頭 dict 或 None(不是回頭重讀的項目檔、或檔頭缺欄位)。只讀「---本文---」之前那段。"""
+    if "\n---本文---\n" not in text:
+        return None
+    head = text.split("\n---本文---\n", 1)[0]
+    meta = dict(re.findall(r"^(" + "|".join(map(re.escape, _NOTE_REREAD_HEAD)) + r"): (.+)$", head, re.M))
+    if any(k not in meta for k in _NOTE_REREAD_HEAD):
+        return None
+    if not (re.fullmatch(r"[0-9a-f]{16}", meta["材料指紋"]) and re.fullmatch(r"[0-9a-f]{16}", meta["對照指紋"])
+            and _LENS_SHA_RE.fullmatch(meta["筆記 blob"]) and _LENS_SHA_RE.fullmatch(meta["範圍終點"])
+            and meta["筆記行數"].isdigit()):
+        return None
+    return meta
