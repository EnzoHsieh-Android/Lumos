+def _note_reread_uncommitted(root):
+    """工作目錄裡的紀錄 → {對照指紋}(只拿來提醒「還沒提交」;check 只認已提交的)。"""
+    d = Path(root) / _NOTE_REREAD_VERDICT_DIR
+    out = set()
+    try:
+        for f in d.iterdir() if d.is_dir() else ():
+            m = _NOTE_REREAD_VERDICT_NAME_RE.match(f.name)
+            if m and f.is_file():
