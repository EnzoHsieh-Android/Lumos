+def _note_reread_committed(root, tip):
+    """被推頂端提交的樹裡已提交的紀錄 → {對照指紋};只列目錄、比檔名,不讀內容(檔數長大也便宜)。
+    ★頂端沒有這個資料夾 = 還沒有任何紀錄★(空集合、不是 git 失敗;設計審 r2 兩席:原稿當 git 失敗,新專案永遠 skipped 自我鎖死)——
+    ls-tree 對不存在的路徑回 0、輸出空,所以回非 0 只會是真的 git 失敗(回 None)。檔名要合正規式,.tmp-wlf 殘檔不算。"""
+    raw = _ns_git(root, "--literal-pathspecs", "ls-tree", "-z", "--name-only", tip, "--", _NOTE_REREAD_VERDICT_DIR + "/")
+    if raw is None:
+        return None
+    out = set()
+    for p in _nodehome_split_z(raw):
+        m = _NOTE_REREAD_VERDICT_NAME_RE.match(p.rsplit("/", 1)[-1])
+        if m:
+            out.add(m.group(1))
+    return out
