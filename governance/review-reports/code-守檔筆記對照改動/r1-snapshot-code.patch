+def _note_reread_given(scan, rel, codeish):
+    """一篇要放進 diff 的檔(計劃〈做法〉2)→ (那篇 about_code 列了而且這次改到的, 補進來的測試檔, 其他改到的程式檔),都是 NFC、排序過。
+    ① 頂端或起點那邊 about_code 列了、而且這次改到的(含測試檔、刪檔);改名的新舊路徑都放。
+    ② 補測試檔:這次改到、判是測試、兩邊都沒被任何家的 about_code 列到,而且跟①某支同一層目錄,或它在 repo 根的 tests/<X>/…
+       而①那支在 repo 根的 src/<專案>/<X>/…(實驗在 rtb 用的就是這條);其他佈局補不到(計劃〈誠實界線〉)。"""
+    ch, ren = scan["changed"], scan["renamed"]
+    mine = {f for f in _note_reread_about(scan, rel, ("tside", "bside")) if f in ch}
+    back = {}
+    for n, o in ren.items():
+        back.setdefault(o, set()).add(n)
+    for f in list(mine):
+        if f in ren:
+            mine.add(ren[f])
+        mine |= back.get(f, set())
+    listed = set(scan["homes_t"]) | set(scan["homes_b"])
+    dirs = {f.rsplit("/", 1)[0] if "/" in f else "" for f in mine}
+    pkgs = {f.split("/")[2] for f in mine if f.startswith("src/") and f.count("/") >= 3}
+    orphans = []
+    for f in sorted(ch):
+        if f in mine or f in listed or _nodehome_code_kind(f) is None or not _nodehome_is_test(f, scan["layout"]):
+            continue
+        d = f.rsplit("/", 1)[0] if "/" in f else ""
+        if d in dirs or (f.startswith("tests/") and f.count("/") >= 2 and f.split("/")[1] in pkgs):
+            orphans.append(f)
+    given = mine | set(orphans)
+    return sorted(mine), orphans, [f for f in sorted(ch) if f not in given and f in codeish]
