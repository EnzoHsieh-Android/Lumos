 # 「[[X]] … revalidate_when」同一句 24 字內;連結認法同 S21(行內程式碼裡的不算、不跨句尾、先過 link_target)
 _RVB_RE = re.compile(_RREF_LINK + _RREF_NOT_END + r"{0,24}?revalidate_when")
 
 
 def _revalidate_backref_lines(env, rel):
     """全庫連到 rel、同一句講到 revalidate_when 的句子 → [(來源篇, 行號, 那一句)];rel 自己那篇不算。只讀不寫。
-    回的是連結所在的那一句(前後切到句尾 _SENT_END_RE),不是整行:長行裡相關的那句常在行尾,印整行會被截掉。"""
+    回的是連結所在的那一句(前後切到句尾 _SENT_END_RE),不是整行:長行裡相關的那句常在行尾,印整行會被截掉。
+    同一行有好幾句都指向 rel 就每句各一筆(代碼審 r1 正確性席:原本每行取到一句就停)。"""
     out = []
     for src in sorted(env.notes):
         text = env_text(env, src)
         if src == rel or not text or "revalidate_when" not in text:
             continue
         for no, raw, _pr in _search_visible_lines(text.split("\n"), False):
             hidden = _inline_hidden(raw)[0]
             starts = [a for a, _b in hidden]
             for m in _RVB_RE.finditer(raw):
                 if not _in_spans(hidden, starts, m.start(1)) and env.resolve(link_target(m.group(1))) == rel:
                     head = max((e.end() for e in _SENT_END_RE.finditer(raw, 0, m.start())), default=0)
                     tail = _SENT_END_RE.search(raw, m.end())
                     out.append((src, no, raw[head:tail.end() if tail else len(raw)].strip()))
-                    break
     return out
 
 
