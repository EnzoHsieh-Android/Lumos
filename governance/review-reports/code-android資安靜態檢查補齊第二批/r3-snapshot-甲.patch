+                kind: source_file
+                has:
+                  stopBy: end
+                  kind: property_declaration
+                  all:
+                    - has: {kind: variable_declaration, has: {kind: simple_identifier, pattern: $C}}
+                    - has: {kind: string_literal, regex: '^"(?i:RSA(/[^/"]*/NoPadding)?)"$'}
+            - has:
+                kind: call_suffix
+                has:
+                  kind: value_arguments
+                  has:
+                    kind: value_argument
+                    nthChild: 1
+                    has: {kind: simple_identifier, pattern: $C}
+  not:
+    matches: in-debug-only-branch
