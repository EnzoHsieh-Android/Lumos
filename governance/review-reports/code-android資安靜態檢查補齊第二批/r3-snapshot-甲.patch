+              has:
+                kind: value_argument
+                nthChild: 1
+                has: {kind: string_literal, regex: '^"(?i:RSA(/[^/"]*/NoPadding)?)"$'}
+        # 同檔常數:const val ALGO = "MD5",再 getInstance(ALGO)
+        - all:
+            - inside:
