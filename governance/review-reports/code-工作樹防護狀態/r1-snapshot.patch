+def _hooks_path_sibling_worktree(root, val):
+    """core.hooksPath 指的是同一個 repo 另一個工作目錄的 scripts/hooks → 那個資料夾;不是 → None。
+    core.hooksPath 存在所有工作樹共用的 .git/config,附加工作樹裡它指的是主工作目錄那份。
+    「同一個 repo」用兩邊 git --git-common-dir 解出的絕對路徑相等判;只給 enforcement 用,
+    _hooks_path_is_ours 維持只認自己(拆除時不准動別的工作目錄的設定)。"""
+    vp = _hooks_path_dir(root, val)
+    if vp is None or vp.name != "hooks" or vp.parent.name != "scripts" or not vp.is_dir():
+        return None
+
+    def _common(p):
+        try:
+            r = subprocess.run(["git", "-C", str(p), "rev-parse", "--path-format=absolute", "--git-common-dir"],
+                               capture_output=True, text=True, errors="replace", timeout=10)
+        except Exception:
+            return None
+        return Path(r.stdout.strip()).resolve() if r.returncode == 0 and r.stdout.strip() else None
+
+    other = vp.parent.parent
+    mine, theirs = _common(root), _common(other)
+    if mine is None or theirs is None or mine != theirs:
+        return None
+    return vp
+
+
+def _same_bytes(a, b):
+    try:
+        return Path(a).read_bytes() == Path(b).read_bytes()
+    except OSError:
+        return False
