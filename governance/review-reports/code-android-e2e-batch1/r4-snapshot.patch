+def _e2e_record_err(rec, fp):
+    """紀錄讀不讀得懂(判定與寫入共用一套):回錯誤訊息或 None。只有放行的紀錄 runs 是 null。"""
+    if not isinstance(rec, dict):
+        return "最外層不是物件"
+    if not _secev_int(rec.get("schema")) or rec["schema"] > E2E_SCHEMA or rec["schema"] < 1:
+        return f"schema 是 {rec.get('schema')!r},這版 lumos 只認 1 到 {E2E_SCHEMA}(比較新就更新 lumos)"
+    if rec.get("fingerprint") != fp:
+        return "紀錄裡的指紋跟檔名對不上"
+    runs = rec.get("runs")
+    if runs is not None and (not isinstance(runs, dict) or runs.get("result") not in E2E_RESULTS):
+        return "runs.result 不是 pass、fail、unjudged 之一"
+    if not isinstance(rec.get("waivers", []), list) or not isinstance(rec.get("history", []), list):
+        return "waivers 或 history 不是清單"
+    return None
