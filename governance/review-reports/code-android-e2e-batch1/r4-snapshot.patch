+def _e2e_default_excluded(p):
+    """預設排除:每個模組的 src/test/ 與 src/androidTest/(只改單元測試不用重跑實機)。"""
+    parts = p.split("/")
+    return any(parts[i] == "src" and parts[i + 1] in ("test", "androidTest") for i in range(len(parts) - 2))
+
+
+def _e2e_fingerprint(root, rev, e2e):
+    """對提交 rev 的檔案樹與那份 e2e 段算指紋(單源計劃〈查證紀錄〉)→ (指紋, None) / (None, 錯誤訊息)。
+    只用 git ls-tree 的 mode、物件編號與路徑(不讀檔案內容),依路徑位元組排序、NUL 分隔,最後接 e2e 段的正規化雜湊。"""
+    import hashlib, json
+    raw = _nodehome_git(root, "ls-tree", "-r", "-z", "--full-tree", rev, timeout=120)
+    if raw is None:
+        return None, f"列不出 {rev[:8]} 的檔案樹"
+    apps = [_e2e_norm(d) for d in e2e["app_dirs"]]
+    excl = [_e2e_norm(d) for d in e2e.get("exclude") or []]
+    mats = list(E2E_MATERIAL_DIRS) + [E2E_THRESHOLDS] + [_e2e_norm(f) for f in e2e["flows"]]
+    seen_app = set()
+    items = {}
+    for ent in raw.split(b"\0"):
+        if not ent:
+            continue
+        meta, _, pb = ent.partition(b"\t")
+        mode, _typ, oid = meta.decode().split()
+        p = os.fsdecode(pb)
+        hit_app = next((d for d in apps if _e2e_under(p, d)), None)
+        if hit_app is not None:
+            seen_app.add(hit_app)
+            if any(_e2e_under(p, x) for x in excl) or ("exclude" not in e2e and _e2e_default_excluded(p)):
+                hit_app = None
+        if hit_app is not None or any(_e2e_under(p, m) for m in mats):
+            items[pb] = (mode, oid)
+    gone = [d for d in apps if d not in seen_app]
+    if gone:
+        return None, f"app_dirs 的 {'、'.join(gone)} 在 {rev[:8]} 的檔案樹裡不存在"
+    h = hashlib.sha256()
+    for pb in sorted(items):
+        mode, oid = items[pb]
+        h.update(mode.encode() + b"\0" + oid.encode() + b"\0" + pb + b"\n")
+    canon = json.dumps(e2e, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    h.update(b"e2e-config\0" + hashlib.sha256(canon.encode("utf-8")).hexdigest().encode() + b"\n")
+    return h.hexdigest(), None
+
