+def _e2e_config_at(root, rev):
+    """那個提交樹裡的 .lumos/macrobench.json → (整份 dict 或 None, 錯誤訊息或 None);檔不在回 (None, None)。
+    讀法走既有的 _lumos_config_at_ref(嚴格 UTF-8;先讀、讀不到再分辨「檔不在」與「檔在但讀不懂」)。
+    它容許開頭的 BOM,_macrobench_config 讀工作目錄那份不容許:帶 BOM 的設定在 macrobench --check-config 就擋下,
+    範本腳本開跑前一定先過那一道,所以走不到這裡;推送檢查那一道(下一批)要自己再擋一次。"""
+    d, st = _lumos_config_at_ref(root, rev, strict=True, rel=".lumos/macrobench.json")
+    if st == "ok":
+        return d, None
+    if st == "missing":
+        return None, None
+    return None, f"{rev[:8]} 的 macrobench.json " + ("讀不懂(不是合格的 UTF-8 JSON 物件)" if st == "unreadable" else "讀不出來(git 失敗或逾時)")
