+def _e2e_judge_ui(e2e, steps):
+    """每支 flow:第一次過→過;第一次沒過、第二次過→過且標不穩定;兩次都沒過→沒過;沒跑到→沒判到。"""
+    out = []
+    for f in e2e["flows"]:
+        name = _e2e_flow_name(f)
+        tries = sorted(_e2e_steps(steps, "ui", name), key=lambda s: s.get("attempt", 0))
+        if not tries:
+            out.append({"flow": f, "result": "unjudged", "reason": "這支 flow 沒跑到"})
+            continue
+        why = []
+        for i, s in enumerate(tries[:2]):
+            ok, w = (s.get("rc") == 0, f"回傳碼 {s.get('rc')}")
+            if ok:
+                ok, w = _e2e_junit_ok(s.get("report") or "")
+            if ok:
+                out.append({"flow": f, "result": "pass", "flaky": i > 0, "reports": [t.get("report") for t in tries[:i + 1]]})
+                break
+            why.append(f"第 {i + 1} 次:{w}")
+        else:
+            out.append({"flow": f, "result": "fail", "reason": ";".join(why), "reports": [t.get("report") for t in tries[:2]]})
+    return out
+
+
+def _e2e_judge_visual(e2e, steps, run_dir):
+    if not e2e.get("visual"):
+        return "未設定"
+    out = []
+    for v in e2e["visual"]:
+        st = _e2e_steps(steps, "visual", v)
+        if not st:
+            out.append({"screen": v, "result": "fail", "reason": "沒有比對結果(這個畫面沒跑到)"})
+            continue
+        s = st[-1]
+        if s.get("rc") == 0:
+            out.append({"screen": v, "result": "pass"})
+            continue
+        text = _e2e_tail(s.get("stdout"), 2000) + "\n" + _e2e_tail(s.get("stderr"), 2000)
+        m = re.search(r"相符率 ([0-9.]+)%", text)
+        rec = {"screen": v, "result": "fail", "reason": (text.strip().splitlines() or [f"回傳碼 {s.get('rc')}"])[-1][-300:]}
+        if m:
+            rec["match_pct"] = float(m.group(1))
+            diff = Path(run_dir) / "visual" / v / f"{v}_diff.png"
+            if diff.exists():
+                rec["diff"] = str(diff)
+        out.append(rec)
+    return out
+
