+def _e2e_junit_ok(path):
+    """Maestro 的 JUnit 報告 → (過不過, 原因)。讀法走 _secev_junit_facts(安全證據閘同一支:test_quality.junit()、
+    拒收 DTD、宣告的案例數要對得上、零案例與 suite 層錯誤都不算過、案例數有上限);每個案例都 passed 才算這一次過。"""
+    tq = _secev_tq()
+    if tq is None:
+        return False, "測試品質模組(scripts/test_quality.py)讀不到,判不了 JUnit 報告"
+    try:
+        raw = Path(path).read_bytes()
+    except OSError as e:
+        return False, f"報告讀不了:{e}"
+    facts, why = _secev_junit_facts(raw, tq)
+    if facts is None:
+        return False, {"zero_cases": "報告裡沒有任何測試案例"}.get(why, f"報告不合格({why})")
+    bad = [k for k, (status, _a) in facts.items() if status != "passed"]
+    if bad:
+        return False, f"{len(bad)} 個測試案例沒過"
+    return True, None
