+def _e2e_thresholds_err(cfg, thresholds):
+    """要了記憶體塊時,每個要求的 check 在門檻檔裡都要有情境相符的條目(情境不符那塊會永遠沒判到)。"""
+    e2e = (cfg or {}).get("e2e")
+    if not e2e or not e2e.get("stability"):
+        return None
+    scen = cfg["stability"]["scenario"]
+    have = {t["check"] for t in thresholds or [] if "check" in t and t.get("scenario") == scen}
+    miss = [c for c in e2e.get("stability_checks", E2E_STAB_CHECKS) if c not in have]
+    if miss:
+        return (f"e2e 段要求的記憶體 check 在 {E2E_THRESHOLDS} 裡沒有情境 {scen} 的條目:{'、'.join(miss)}"
