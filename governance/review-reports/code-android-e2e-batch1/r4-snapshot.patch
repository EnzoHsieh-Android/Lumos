+def _e2e_judge_cmd(root, run_dir, precheck_only=False):
+    """lumos android-e2e judge:讀 steps.json 與四塊輸出、判、寫 .lumos/e2e-records/<指紋>.json。
+    rc 0=寫了紀錄且 pass;1=寫了紀錄但不是 pass;2=沒寫(steps.json 不認得、換了版本、工作目錄有改動、設定不合格)。"""
+    import shlex
+    root = Path(root).resolve()
+    err = _e2e_precheck(root)
+    if precheck_only:
+        print(f"擋下:{err}" if err else "工作目錄乾淨,可以開跑。", file=sys.stderr if err else sys.stdout)
+        return 2 if err else 0
+    if not run_dir:
+        print("擋下:要給 run 目錄(範本腳本印的那個 .lumos/artifacts/android/<run-id>),或用 --precheck 只看能不能開跑", file=sys.stderr)
+        return 2
+    run_dir = Path(run_dir).resolve()
+    steps, serr = _e2e_load_json(run_dir / "steps.json")
+    if serr is None and (not isinstance(steps, dict) or steps.get("schema") != E2E_SCHEMA):
+        serr = f"steps.json 的 schema 是 {(steps or {}).get('schema') if isinstance(steps, dict) else None!r},這版 lumos 只認 {E2E_SCHEMA}"
+    head = (_nodehome_git(root, "rev-parse", "HEAD") or b"").decode("utf-8", "replace").strip()
+    if serr is None and steps.get("start_head") != head:
+        serr = f"開跑時是 {str(steps.get('start_head'))[:8]},現在 HEAD 是 {head[:8]}:驗的不是這一版,重跑驗收"
+    full, cerr = _e2e_config_at(root, head) if head else (None, "讀不到 HEAD")
+    e2e = (full or {}).get("e2e")
+    if cerr is None and not e2e:
+        cerr = "HEAD 的 macrobench.json 沒有 e2e 段"
+    if cerr is None:
+        cerr = _e2e_cfg_err(e2e, full.get("stability"), bool(full.get("results_dirs")))
+    fp, ferr = _e2e_fingerprint(root, head, e2e) if cerr is None else (None, None)
+    why = err or serr or cerr or ferr
+    if why:
