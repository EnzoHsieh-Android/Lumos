+def t_android_e2e_judge_dirty_tree():
+    """S7:HEAD 跟開跑時不同、工作目錄有簿記檔以外的改動或沒追蹤的新檔、steps.json 的 schema 不認得 → 回 2、不寫紀錄。"""
