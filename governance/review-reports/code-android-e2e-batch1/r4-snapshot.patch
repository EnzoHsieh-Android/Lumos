+def _e2e_load_json(path, scrub=True):
+    """讀範本腳本與 lumos 寫的 JSON:限深與清孤立代理字元照 _macrobench_stab_load(否則印出或寫回紀錄時整支崩)。
+    scrub=False 給要整份寫回的查證紀錄用:只限深、只把孤立代理字元換成替代字元(不然寫回時編碼失敗、整支崩),
+    其他照原樣——人寫的放行理由裡的換行與 tab 要保留。"""
+    import json
+    try:
+        raw = json.loads(Path(path).read_text(encoding="utf-8"))
+    except (OSError, TypeError, ValueError) as e:
+        return None, f"讀不了 {path}:{e}"
+    if not _events_depth_ok(raw, 20):
+        return None, f"{path} 巢狀太深"
+    return (_macrobench_stab_scrub(raw) if scrub else _e2e_fix_surrogates(raw)), None
+
+
+def _e2e_fix_surrogates(v):
+    """遞迴把字串裡的孤立代理字元換成 U+FFFD,其他字元不動(呼叫前已限深)。"""
+    if isinstance(v, str):
+        return re.sub("[\ud800-\udfff]", "\ufffd", v)
+    if isinstance(v, list):
+        return [_e2e_fix_surrogates(x) for x in v]
+    if isinstance(v, dict):
+        return {_e2e_fix_surrogates(k): _e2e_fix_surrogates(x) for k, x in v.items()}
+    return v
+
+
+def _e2e_judge_stability(e2e, steps, notices):
+    """記憶體與穩定性:只看帶 check、而且在 stability_checks 裡的條目;frozen 與沒列的只寫 notices。"""
+    if not e2e.get("stability"):
+        return "未設定"
+    want = list(e2e.get("stability_checks", E2E_STAB_CHECKS))
+    col, jud = _e2e_steps(steps, "stability"), _e2e_steps(steps, "stability_judge")
+    bad = next((s for s in col + jud if s.get("rc") != 0), None)
+    if not col or not jud or bad is not None:
+        why = "沒跑到" if not col or not jud else f"{bad['block']} 回 {bad.get('rc')}:{_e2e_tail(bad.get('stderr'), 200)}"
+        return [{"check": c, "result": "unjudged", "reason": f"記憶體與穩定性這塊沒跑成({why})"} for c in want]
+    res, err = _e2e_load_json(jud[-1].get("stdout"))
+    if err or not isinstance(res, dict):
+        return [{"check": c, "result": "unjudged", "reason": err or "判定輸出不是物件"} for c in want]
+    out = []
+    for c in want:
+        fails = [r for r in res.get("threshold_failures", []) if r.get("check") == c]
+        passed = [r for r in res.get("threshold_passed", []) if r.get("check") == c]
+        skipped = [r for r in res.get("threshold_skipped", []) if r.get("check") == c and r.get("applies") is not False]
+        if fails:
+            out.append({"check": c, "result": "fail", "detail": fails})
+        elif skipped or not passed:
+            why = (skipped[0].get("reason") if skipped else None) or res.get("stability_unjudged") or "這個 check 沒有出現在判定結果裡"
+            out.append({"check": c, "result": "unjudged", "reason": why})
+        else:
+            out.append({"check": c, "result": "pass"})
+    for k in ("threshold_failures", "threshold_skipped"):
+        for r in res.get(k, []):
+            if r.get("check") and r["check"] not in want and r.get("applies") is not False:
+                notices.append(f"記憶體 {r['check']}({'沒過' if k == 'threshold_failures' else '沒判到'}):只提醒")
+    return out
+
+
+def _e2e_judge_macrobench(e2e, steps, notices):
+    """毫秒類效能:第一版只提醒,任何結果都只寫 notices。"""
+    if not e2e.get("macrobench"):
+        return "未設定"
+    st = _e2e_steps(steps, "macrobench_judge") or _e2e_steps(steps, "macrobench")
+    bad = next((s for s in _e2e_steps(steps, "macrobench") + _e2e_steps(steps, "macrobench_judge") if s.get("rc") != 0), None)
+    if not st or bad is not None:
+        notices.append("效能這塊沒跑成" + (f"({bad['block']} 回 {bad.get('rc')})" if bad else "(沒跑到)"))
+        return "沒跑成"
+    res, err = _e2e_load_json(st[-1].get("stdout"))
+    if err or not isinstance(res, dict):
+        notices.append(f"效能判定的輸出讀不了:{err or '不是物件'}")
+        return "沒跑成"
+    for r in res.get("regressions", []):
+        notices.append(f"效能退步:{r.get('scenario') or r.get('key') or r}")
+    for r in res.get("threshold_failures", []):
+        if not r.get("check"):
+            notices.append(f"效能門檻沒達:{r.get('scenario')} {r.get('metric', '')}".strip())
+    if res.get("baseline_missing"):
+        notices.append("效能還沒有基準")
+    if res.get("low_iterations"):
+        notices.append(f"效能有 {len(res['low_iterations'])} 個情境輪數不足 {MACROBENCH_MAG_ONLY_ITERS}")
+    return "只提醒"
+
+
+def _e2e_tool_problems(steps):
+    """會擋的那幾塊共用的前提:建置、安裝、APK 沒被換掉、沒被中斷 → 問題清單(空=沒問題)。"""
+    probs = []
+    for blk in ("build", "install"):
+        st = _e2e_steps(steps, blk)
+        if not st:
+            probs.append(f"{blk} 沒跑到")
+        elif st[-1].get("rc") != 0:
+            probs.append(f"{blk} 回 {st[-1].get('rc')}:{_e2e_tail(st[-1].get('stderr'), 200)}")
+    apk = steps.get("apk") or {}
+    b, i1, i2 = apk.get("built_sha256"), apk.get("installed_sha256_before"), apk.get("installed_sha256_after")
+    if not (b and i1 and i2):
+        probs.append("APK 的 sha256 沒記全(建出的、裝上去的、記憶體塊後再讀的)")
+    elif not b == i1 == i2:
+        probs.append("裝置上的 APK 跟建出來的不同,或在驗收中途被換掉")
+    if steps.get("interrupted"):
+        probs.append("這次驗收被中斷")
+    return probs
+
+
+def _e2e_evaluate(e2e, steps, run_dir):
+    """照計劃〈一次驗收跑什麼〉判四塊 → runs 明細(result 是 pass、fail、unjudged)。"""
+    notices = []
+    blocks = {"ui": _e2e_judge_ui(e2e, steps), "visual": _e2e_judge_visual(e2e, steps, run_dir),
+              "stability": _e2e_judge_stability(e2e, steps, notices), "macrobench": _e2e_judge_macrobench(e2e, steps, notices)}
+    probs = _e2e_tool_problems(steps)
+    rs = [x["result"] for k in ("ui", "visual", "stability") if isinstance(blocks[k], list) for x in blocks[k]]
+    result = "fail" if "fail" in rs else ("unjudged" if probs or "unjudged" in rs else "pass")
+    flaky = [x["flow"] for x in blocks["ui"] if x.get("flaky")]
+    if flaky:
+        notices.append(f"不穩定的 flow(第二次才過):{'、'.join(flaky)}")
+    return {"result": result, "problems": probs, "blocks": blocks, "notices": notices,
+            "ran": {"flows": [x["flow"] for x in blocks["ui"] if x["result"] != "unjudged"],
+                    "visual": [x["screen"] for x in blocks["visual"]] if isinstance(blocks["visual"], list) else [],
+                    "stability_checks": [x["check"] for x in blocks["stability"] if x["result"] != "unjudged"]
+                    if isinstance(blocks["stability"], list) else []}}
+
