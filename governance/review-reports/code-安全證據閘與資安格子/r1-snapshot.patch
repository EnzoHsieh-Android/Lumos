+def t_secev_s38_security_backing_command():
+    """S38:code-loop security-backing 對同一護欄、種類與 head_sha 跑兩次 → 背書檔只多一筆;--supersede → 多一筆帶 supersedes 的更正,
+    閘門跳過被更正那筆;閘門讀到多筆時取 head_sha 相符、沒被更正的最新一筆。"""
