+def _sg_canon(o):
+    """規範化 JSON(計劃〈核可鏈〉:鍵排序、無空白、UTF-8),測試自己寫一份,不呼叫被測函式。"""
+    import json as _j
+    return _j.dumps(o, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+
