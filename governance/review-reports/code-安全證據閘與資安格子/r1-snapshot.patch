+          str(_sg_codes(rep, "fault_sensitivity")))
+    lines = bf.read_text().splitlines()
+    newer = _j.loads(lines[1])
+    newer_bad = dict(newer, groups=[dict(newer["groups"][0], verdicts=[{"verdict": "survived", "weak": False}])])
