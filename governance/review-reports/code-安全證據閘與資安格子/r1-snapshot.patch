+    # ---- 核可鏈
+    def sign(self, body, key):
+        import tempfile
+        d = Path(tempfile.mkdtemp(prefix="gctl-sgsig-"))
+        f = d / "payload"
+        f.write_bytes(_sg_canon(body))
+        subprocess.run(["ssh-keygen", "-Y", "sign", "-n", "lumos-security", "-f", str(key["priv"]), str(f)], check=True,
