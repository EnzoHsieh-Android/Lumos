+def _secev_freeze_kept(run, ctx, cid, pr, olds_in):
+    """推送版還是 active 資安的護欄:跟另外兩版比變弱而沒有 revision 核可 → 照嚴的那版(集合取聯集、表版號取最低種類多的)。"""
+    freeze = run.rep["freeze"]
+    olds = []
+    for name, o in olds_in:
+        w = _secev_weaker(pr, o, ctx.tools) if _secev_active_sec(o) else []
+        if not w:
+            continue
+        seq = _secev_revision_ok(ctx, cid, _secev_state(o), _secev_state(pr))
+        if seq:
+            freeze["approved_revisions"].append({"id": cid, "against": name, "fields": w, "approval_seq": seq})
+            continue
+        freeze["weakened"].append({"id": cid, "against": name, "fields": w})
+        olds.append(o)
+    if not olds:
+        return pr, {}
+    rec, missing = _secev_strict_merge(pr, olds)
+    rec["threat_table_version"] = max([pr, *olds], key=lambda x: len(_secev_min_kinds(x, ctx.tools)[0] or ())).get("threat_table_version")
+    return rec, missing
+
+
+def _secev_freeze_removed(run, ctx, cid, pr, br, mr):
+    """推送版沒有、降級或拿掉 security 的護欄:有 revision 核可(after=removed 或推送版的樣子)→ 不當必驗;否則照較新那版當必驗。"""
+    newer = mr if _secev_active_sec(mr) else br
+    after = {"removed": True} if pr is None else _secev_state(pr)
+    seq = _secev_revision_ok(ctx, cid, _secev_state(newer), after)
+    if seq:
+        run.rep["freeze"]["approved_revisions"].append({"id": cid, "against": "removed", "approval_seq": seq})
+        return None
+    why = ("主線新增了這條,先接上主線" if not _secev_active_sec(br) and _secev_active_sec(mr)
+           else "推送版刪掉、降成 candidate/retired 或拿掉 security 關注面,核可鏈上沒有有效的 revision 核可")
+    run.rep["freeze"]["removed"].append({"id": cid, "why": why})
+    return (newer, cid, why, {})
+
+
+def _secev_stage_freeze(run, ctx, idx):
+    """必驗集合=三版 active 資安條目的聯集;逐條決定照哪一版判 → [(記錄, id, 被刪的說明或 None, 少掉的列)]。"""
+    run.tick("凍結比對")
+    ids = sorted({i for n in ("push", "base", "main") for i, r in idx[n].items() if _secev_active_sec(r)})
+    work = []
+    for cid in ids:
+        pr, br, mr = idx["push"].get(cid), idx["base"].get(cid), idx["main"].get(cid)
+        if _secev_active_sec(pr):
+            rec, missing = _secev_freeze_kept(run, ctx, cid, pr, (("merge-base", br), ("主線 tip", mr)))
+            work.append((rec, cid, None, missing))
+            continue
+        w = _secev_freeze_removed(run, ctx, cid, pr, br, mr)
+        if w:
+            work.append(w)
+    return work
+
+
+def _secev_stage_judge(run, ctx, idx, work):
+    """凍結的證據項、額度預先算、逐條判必驗集合與候選、格子(驗過核可鏈)。"""
+    rep, penv, poversize = run.rep, run.reps["push"][1], run.reps["push"][2]
+    menv = run.reps["main"][1]
+    frozen, all_items = {}, []
+    for rec, cid, removed, _m in work:
+        pitems = _secev_items_for(penv, idx["push"].get(cid) if not removed else None, ctx._facts)
+        frozen[cid] = _secev_frozen(_secev_items_for(menv, idx["main"].get(cid), ctx._facts) if menv else [], pitems)
+        all_items.append((rec, pitems + frozen[cid]))
+    ctx.over_items = _secev_budget_prepass(ctx, all_items)
+    run.tick("逐條判定")
+    for rec, cid, removed, missing in work:
+        run.tick(f"判護欄 {cid}")
+        env_for = penv if not removed else (menv if _secev_active_sec(idx["main"].get(cid)) else run.reps["base"][1])
+        j = _secev_judge_control(rec, ctx, env_for, frozen[cid], removed=removed, missing_rows=missing, oversize=poversize)
+        j["mandatory"] = True
+        rep["controls"].append(j)
+    for _cid, r in sorted(idx["push"].items()):
+        if r.get("lifecycle") == "candidate" and "security" in (r.get("concerns") or []):
+            rep["candidates"].append(_secev_candidate(run, ctx, r))
+    run.tick("算格子")
+    rep["cells"], rep["cell_errors"], _pend = _seccell_compute(run.reps["push"][3], idx["push"].values(),
+                                                              run.reps["push"][0].get("considerations") or [],
+                                                              counted=lambda cid, row: _secev_consideration_counted(ctx, penv, cid, row))
+    rep["reminders"] += ctx.reminders
+    rep["parse_count"] = ctx.parse_count
+
+
+def _secev_candidate(run, ctx, r):
+    """candidate 照樣判給人看(不進必驗集合、不擋);放超過 30 天標出(d12)。"""
+    j = _secev_judge_control(r, ctx, run.reps["push"][1], [], oversize=run.reps["push"][2])
+    j["mandatory"] = False
+    age = _secev_candidate_age(run.repo_root, run.sha, r, run.reps["push"][0], run.today)
+    if age is not None and age > _SECEV_CANDIDATE_DAYS:
+        j["notes"].append(f"candidate 已放 {age} 天(超過 {_SECEV_CANDIDATE_DAYS} 天),該轉 active 或撤掉")
+        j["candidate_overdue"] = True
+    return j
+
+
+def _secev_evaluate_body(repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline):
+    """整道判定的階段:開頭(設定、主線、預檢、核可鏈)→ 三版盤點 → 上下文(配套、工具清單)→ 凍結比對 → 逐條判定。"""
+    run = _SecevRun(repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline)
+    done = _secev_stage_head(run)
+    if done is None:
+        done = _secev_stage_reports(run)
+    if done is not None:
+        return done
+    ctx = _secev_stage_ctx(run)
+    if ctx is None:
+        return _secev_finish(_secev_gate(rep, "toolchain_incomplete"))
+    idx = {n: (_secev_index(v[0]) if v[0] else {}) for n, v in run.reps.items()}
+    work = _secev_stage_freeze(run, ctx, idx)
+    _secev_stage_judge(run, ctx, idx, work)
+    return _secev_finish(rep)
+
+
+def _secev_consideration_counted(ctx, env, cid, row):
+    """一列 considerations 算不算數(驗核可鏈):鏈上 type=consideration、target=格子 id 有有效的一筆、內容雜湊蓋住整列;
+    核可決策有效;risk_accepted 最長 30 天(31 天起無效)、到期日要等於鏈上那一筆;not_applicable 最長 180 天;到期日當天有效、隔天回到 open。"""
+    st, e = _secapr_lookup(ctx.chain, "consideration", cid, _secev_sha(_secev_canon(row)))
+    if st != "ok" or _secinv_decision_problem(env, row.get("decision_ref"), ctx._facts):
+        return False
+    ap, ex = _secinv_date(e["approved_on"]), _secinv_date(e["expires_on"])
+    if row["outcome"] == "risk_accepted":
+        if row.get("expires_on") != e["expires_on"] or (ex - ap).days > 30:
+            return False
+    elif (ex - ap).days > 180:
+        return False
+    if ex < ctx.today:
+        return False
+    if (ex - ctx.today).days <= _SECEV_REMIND_DAYS:
+        ctx.remind(f"格子 {cid} 的 {row['outcome']} {ex.isoformat()} 到期")
+    return True
+
+
+def _seccell_consideration_content(prep, target):
+    """security approvals payload consideration <格子 id>:那一列 considerations 的全部鍵(閘門比對時算同一份雜湊)。"""
+    for cr in prep.get("considerations") or []:
+        c = cr.get("raw")
+        if not isinstance(c, dict) or _seccell_cons_problem(c):
+            continue
+        tbl = _sectt_table(_sectt_current()) or {}
+        act = c.get("actor") if (tbl.get(c["category"]) or {}).get("has_actor") else None
+        if _seccell_id(c["surface"], c["asset"], c["category"], act) == target:
+            return c
+    raise ValueError(f"找不到格子 {target} 的 considerations 列")
+
+
+def _secev_candidate_age(repo_root, sha, r, prep, today):
+    """candidate 放了幾天:revision 是 YYYY-MM-DD 就用它,否則用家節點在這個提交上最後一次改動的提交日期。"""
+    import datetime as _dt
+    d = _secinv_date(str(r.get("revision") or ""))
+    if d is None:
+        rr = _secev_git(repo_root, "log", "-1", "--format=%cI", sha, "--", "*" + str(r.get("node") or ""))
+        dt = _secev_iso(rr.stdout.strip()) if rr is not None and rr.returncode == 0 and rr.stdout.strip() else None
+        d = dt.astimezone(_dt.timezone.utc).date() if dt else None
+    return (today - d).days if d else None
+
+
+def _secev_chain_view(chain):
+    return {"entries": [{"seq": e["seq"], "type": e["type"], "target": e["target"],
+                         "status": "ok" if e["status"] == "ok" else f"approval:{e['status']}"} for e in chain["entries"]],
+            "keys": [{"principal": p, "fingerprint": _secapr_fingerprint(t, k), "expires_on": x.isoformat()}
+                     for p, (t, k, x) in sorted(chain["keys"].items())],
+            "warnings": list(chain["warnings"])}
+
+
+def _secev_finish(rep):
+    """擋不擋:整道代碼或必驗集合裡有 unsound;gate_setting=warn 有效而且這個整道代碼可以降級時照算照印、不擋。"""
+    blocking = []
+    for j in rep["controls"]:
+        if j.get("mandatory") and j.get("verdict") == "unsound":
+            for c in j["control_codes"]:
+                blocking.append({"id": j["id"], "kind": "護欄", "code": c})
+            for k in j["kinds"]:
+                if k["verdict"] != "qualified" and not k.get("excepted"):
+                    first = next((it for it in k["items"] if it.get("verdict") != "qualified"), {})
+                    blocking.append({"id": j["id"], "kind": k["kind"], "code": (k["codes"] or [k["verdict"]])[0],
+                                     "path": first.get("path")})
+    rep["blocking"] = blocking
+    hard = bool(rep["gate_code"]) or bool(blocking)
+    gs = rep["gate_setting"]
+    warn_ok = gs["effective"] == "warn" and (not rep["gate_code"] or _SECEV_WARN_OK.get(rep["gate_code"], False))
+    if gs["effective"] == "warn" and rep["gate_code"] and not _SECEV_WARN_OK.get(rep["gate_code"], False):
+        gs["reason"] = f"整道代碼 {rep['gate_code']} 不能降級,warn 這次無效"
+    rep["blocked"] = hard and not warn_ok
+    rep["warned_only"] = hard and warn_ok
+    return rep
+
+
+def _secev_grep_trace(repo_root, sha):
+    """廉價預檢:先一次 git grep 找提到 lumos-security-v1 的 .md;命中的那幾篇再照盤點的嚴格讀法(_secinv_blocks)看
+    有沒有真的圍欄或變體(散文裡提到這個字樣不算痕跡)。回 True/False/None(git 失敗,當成可能有)。"""
+    r = _secev_git(repo_root, "grep", "-l", "-z", "-F", "--no-color", _SECINV_MARK, sha, "--", "*.md")
+    if r is None:
+        return None
+    if r.returncode == 1:
+        return False
+    if r.returncode != 0:
+        return None
+    pre = sha + ":"
+    paths = [p.removeprefix(pre) for p in r.stdout.split("\0") if p]
+    if not paths:
+        return False
+    got = _nodehome_cat_blobs_capped(repo_root, [f"{sha}:{p}" for p in paths], _VAULT_SAFE_FILE_MAX)
+    if got is None:
+        return None
+    for p, b in zip(paths, got):
+        if b is None:
+            return True             # 讀不到(太大、特殊檔):交給完整快照判
+        try:
+            text = b.decode("utf-8")
+        except UnicodeDecodeError:
+            return True
+        blocks, errs = _secinv_blocks(p, text)
+        if blocks or errs:
+            return True
+    return False
+
+
+def _secev_show_code(c):
+    return _secinv_show(c, 200)
+
+
+def _secev_render_head(rep, L):
+    """主線、gate、盤點、整道判不清、核可鏈的那幾行。"""
+    ml = rep.get("mainline") or {}
+    L.append(f"主線: {ml.get('sha') or '(無)'}({_secinv_show(ml.get('how') or '')})  merge-base: {rep.get('merge_base') or '(無)'}")
+    gs = rep["gate_setting"]
+    L.append(f"gate: 設定 {gs['configured']}、實際 {gs['effective']}" + (f"——{_secinv_show(gs['reason'])}" if gs.get("reason") else ""))
+    if rep.get("inventory"):
+        inv = rep["inventory"]
+        L.append(f"盤點: read_complete={str(inv['read_complete']).lower()} registration_complete={str(inv['registration_complete']).lower()} "
+                 f"errors={inv['errors']}(security_verdict 照舊 not_assessed)")
+    if rep["gate_code"]:
+        L.append(f"整道判不清: {rep['gate_code']}——{_secinv_show(rep['gate_detail'] or '')}")
+    keys = rep["approvals"]["keys"]
+    if keys:
+        L.append("現在有效的核可金鑰: " + "、".join(f"{_secinv_show(k['principal'])} {k['fingerprint']}(到 {k['expires_on']})" for k in keys))
+    L += [f"  核可鏈第 {e['seq']} 筆不算數:{e['status']}({_secinv_show(str(e['type']))} {_secinv_show(str(e['target']))})"
+          for e in [e for e in rep["approvals"]["entries"] if e["status"] != "ok"][:20]]
+
+
+def _secev_render_freeze(fz, L):
+    """凍結比對的那幾行:變弱、必驗集合縮小、有核可的修訂、工具清單變弱。"""
+    L += [f"變弱(沒有核可,照嚴的判):{_secinv_show(w['id'])} 對 {w['against']}:" + "、".join(w["fields"]) for w in fz["weakened"]]
+    L += [f"必驗集合縮小(沒有核可,照舊當必驗):{_secinv_show(w['id'])}——{w['why']}" for w in fz["removed"]]
+    L += [f"有核可的修訂:{_secinv_show(w['id'])}(核可鏈第 {w['approval_seq']} 筆)" for w in fz["approved_revisions"]]
+    L += [f"工具清單變弱:{_secinv_show(w['tool'])}:" + "、".join(w["weakened"]) + ("(有核可)" if w["approved"] else "(沒有核可,照主線那一列判)")
+          for w in fz["tool_list"]]
+
+
+def _secev_render_item(it, L):
+    L.append(f"        · {it.get('verdict')} {','.join(it.get('codes') or [])} 證據 {_secinv_show(str(it.get('path')))} "
+             f"工具 {_secinv_show(str(it.get('tool')))} {_secinv_show(str(it.get('tool_version')))} "
+             f"觀察 {it.get('observed_at')}" + (" (主線版被刪的項,照算)" if it.get("frozen_from_mainline") else ""))
+    L += [f"          限制: {lim}" for lim in it.get("limitations") or []]
+
+
+def _secev_render_control(j, L):
+    """一條護欄的判定:整體、來源與威脅類別、例外、註、各種證據與各項。"""
+    L.append(f"- [{_secinv_show(j['id'])}] revision={_secinv_show(str(j['revision']))} lifecycle={j['lifecycle']} "
+             f"整體={j['verdict']}" + (f" 護欄層={','.join(j['control_codes'])}" if j["control_codes"] else "")
+             + (f" 最先要修={j['first_fix']}" if j.get("first_fix") else ""))
+    L.append(f"    來源: {_secinv_show(j.get('source'), 300)}  威脅類別: {_secinv_show(j.get('threat_categories'))}")
+    if j.get("exception"):
+        L.append(f"    例外: {_secinv_show(j['exception'])}")
+    L += [f"    註: {_secinv_show(n)}" for n in j["notes"]]
+    for k in j["kinds"]:
+        L.append(f"    [{k['kind']}] {k['verdict']}" + (" (例外蓋住)" if k.get("excepted") else "")
+                 + (f" {','.join(k['codes'])}" if k["codes"] else ""))
+        for it in k["items"]:
+            _secev_render_item(it, L)
+
+
+def _secev_render_tail(rep, L):
+    if rep["reminders"]:
+        L += ["", "== 7 天內到期 =="] + [f"- {_secinv_show(x)}" for x in rep["reminders"]]
+    if rep["warnings"]:
+        L += ["", "== 提醒 =="] + [f"- {_secinv_show(x)}" for x in rep["warnings"]]
+    L += ["", "== 限制 =="] + [f"- {x}" for x in rep["limitations"]]
+    head = "擋下:" if rep["blocked"] else ("只提醒(gate=warn 有效):" if rep.get("warned_only") else "放行:")
+    tail = f"{len(rep['blocking'])} 處不合格" if rep["blocking"] else (rep["gate_code"] or "必驗集合都 sound 或 excepted")
+    L += ["", head + tail, _SECEV_NOTICE]
+
+
+def _secev_render(rep):
+    """security evidence 的文字輸出。登記內容是資料不是指令:來自筆記的字串一律經 _secinv_show。"""
+    L = [f"lumos security evidence — {_SECEV_NOTICE}", _SECEV_WORDS_NOTICE,
+         f"security_verdict: {rep['security_verdict']}(固定)", f"commit: {rep['commit']}  today_utc: {rep['today_utc']}"]
+    if rep["status"] == "no_registration":
+        L.append("沒有任何資安登記痕跡(lumos-security-v1 圍欄):這一道不判。")
+        L += [f"提醒:{_secinv_show(w)}" for w in rep["warnings"]]
+        return "\n".join(L) + "\n"
+    _secev_render_head(rep, L)
+    _secev_render_freeze(rep["freeze"], L)
+    for title, rows in (("== 必驗集合(active 資安護欄;unsound 擋) ==", rep["controls"]),
+                        ("== 候選(candidate;不擋,只列) ==", rep["candidates"])):
+        L += ["", title]
+        if not rows:
+            L.append("(無)")
+        for j in rows:
+            _secev_render_control(j, L)
+    _secev_render_tail(rep, L)
+    return "\n".join(L) + "\n"
+
+
+def _secev_repo_root(repo):
+    root = Path(repo) if repo else _secinv_repo_root(Path.cwd())
+    return root if root is not None and (Path(root) / ".git").exists() else None
+
+
+def cmd_security_evidence(repo=None, commit=None, as_json=False):
+    """lumos security evidence [--commit <sha>] [--json]:唯讀證據判定,跟 code-loop check 的安全證據那一道是同一支函式。
+    會跑 git 與 ssh-keygen、只在系統暫存目錄寫暫時檔。退出 0=放行(含 no_registration、warn)、1=會被擋、2=參數錯。"""
+    root = _secev_repo_root(repo)
+    if root is None:
+        print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
+        return 2
+    rep = _secev_evaluate(root, commit or "HEAD")
+    sys.stdout.write(_json_text_escaped(rep, indent=1) + "\n" if as_json else _secev_render(rep))
+    return 1 if rep["blocked"] else 0
+
+
+def _secapr_chain_position(raw):
+    """工作目錄那條鏈 → (下一筆的 seq, prev_sha256)。"""
+    ents = _secapr_parse(raw)
+    if not ents:
+        return 1, ""
+    last = ents[-1][1]
+    if last is None:
+        raise ValueError("工作目錄的核可鏈最後一行讀不出來,先修好再加")
+    return len(ents) + 1, _secev_sha(_secev_canon(last))
+
+
+def _secapr_c_keys(root, typ, target, opts):
+    keys = []
+    for spec in opts.get("keys") or []:
+        if "=" not in spec:
+            raise ValueError("--key 要寫成 <principal>=<公鑰檔>")
+        princ, path = spec.split("=", 1)
+        parts = Path(path).read_text(encoding="utf-8").strip().split()
+        if len(parts) < 2:
+            raise ValueError(f"{path} 不像 ssh 公鑰")
+        keys.append(f"{princ} {parts[0]} {parts[1]}")
+    if _secapr_parse_keys(keys) is None:
+        raise ValueError("金鑰格式不對、貼成私鑰或類型不收(收 ssh-ed25519、sk-ssh-ed25519@openssh.com、ecdsa、ssh-rsa)")
+    return keys, keys
+
+
+def _secapr_c_gate(root, typ, target, opts):
+    if target != "security_evidence.gate":
+        raise ValueError("gate_setting 的 target 只收 security_evidence.gate")
+    return {"value": "warn"}, None
+
+
+def _secapr_c_suppression(root, typ, target, opts):
+    if "#" not in target or not opts.get("reason"):
+        raise ValueError("suppression 的 target 寫 <規則 id>#<位置雜湊>,另帶 --reason")
+    rule, loc = target.split("#", 1)
+    return {"rule": rule, "location_sha256": loc, "reason": opts["reason"]}, None
+
+
+class _SecaprAt:
+    """要從某個提交的盤點算內容的那幾種 type 共用:那個提交的樹、盤點、索引。"""
+
+    def __init__(self, root, commit):
+        self.root, self.commit = root, commit
+        self.sha = _lens_full_sha(root, commit)
+        if self.sha is None:
+            raise ValueError(f"取不到提交 {commit}")
+        self.tree = _SecevTree(root, self.sha)
+        self.prep, self.penv, _v, _o = _secev_vault_report(root, self.tree, _secinv_today(), None)
+        if self.prep is None:
+            raise ValueError("讀不出那個提交的盤點")
+        self.idx = _secev_index(self.prep)
+
+
+def _secapr_c_exception(at, target):
+    cid = target.split("#", 1)[0]
+    r = at.idx.get(cid)
+    if r is None or not r.get("exception"):
+        raise ValueError(f"{at.commit} 裡找不到 {cid} 或它沒有 exception")
+    want = f"{cid}#{','.join(sorted(r['exception'].get('covers_kinds') or []))}"
+    if target != want:
+        raise ValueError(f"target 要寫成 {want}(護欄 id 加排序後的 covers_kinds)")
+    return {"control_id": cid, "control_revision": r.get("revision"), "inputs_sha256": _secev_inputs_sha(r),
+            "exception": r["exception"]}
+
+
+def _secapr_c_human(at, target):
+    cid, kind = ([*target.split("#", 1), ""])[:2]
+    its = [it for it in _secev_items_for(at.penv, at.idx.get(cid), {}) if it["kind"] == kind and it.get("reviewer_kind") == "human"]
+    if len(its) != 1:
+        raise ValueError(f"{cid} 的 {kind} 要恰好一項 reviewer_kind=human 的審查紀錄(找到 {len(its)} 項)")
+    return {k: its[0].get(k) for k in _SECEV_ITEM_KEYS if k in its[0]}
+
+
+def _secapr_c_tools(at, target):
+    t = _secev_tools_load(at.tree.read(_SECEV_TOOLS_REL), None, {})[0].get(target)
+    return {k: v for k, v in t.items() if not k.startswith("_")} if t else {}
+
+
+def _secapr_c_revision(at, target):
+    cid, dref = ([*target.split("|", 1), ""])[:2]
