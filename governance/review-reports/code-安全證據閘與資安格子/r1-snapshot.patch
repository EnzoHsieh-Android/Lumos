+          and "missing:evidence_ref_removed" in _sg_kind(rep, "behavior").get("codes", []), str(rep["freeze"]) + str(_sg_kind(rep, "behavior")))
+    # 同一種類換指另一篇:不算變弱,例外與人審核可不作廢
+    r = _sg_exc_repo(exp="2026-10-30", approved="2026-10-15")
+    r.commit()
+    _sg_branch(r)
