+    """S1:沒有 lumos-security-v1 圍欄 → 安全證據那一道不擋、文字輸出與退出碼跟改動前的工具逐字相同、不寫治理帳;
+    --json 只多一個 security_evidence: no_registration。只有 flag/security-relevant 標籤、零條目的專案同樣不擋。"""
+    import json as _j
+    _need_src("scripts/lumos")
+    old = _sg_old_lumos()
+    for label, extra in (("無登記", ""), ("只有標籤", "tags:\n  - flag/security-relevant\n")):
+        r = _SgRepo(keys=0)
+        r.files = {"src/app.py": b"x = 1\n"}
+        r.commit = None
+        root = r.root
+        (root / "docs/sg-knowledge/Systems").mkdir(parents=True)
+        (root / "docs/sg-knowledge/MOC").mkdir(parents=True)
+        (root / "docs/sg-knowledge/MOC/idx.md").write_text("---\ntype: moc\n---\n# i\n")
+        (root / "docs/sg-knowledge/Systems/A.md").write_text("---\ntype: system\nstatus: doing\n" + extra
+                                                             + "---\n# A\n散文提到 lumos-security-v1 字樣不算登記。\n")
+        (root / "src").mkdir()
+        (root / "src/app.py").write_text("x = 1\n")
+        (root / "docs/.governance-log.jsonl").write_text("")
+        _sg_git(root, "add", "-A")
+        _sg_git(root, "commit", "-q", "-m", "c")
+        gl = root / "docs/.governance-log.jsonl"
+        n0 = len(gl.read_text().splitlines())
+        new_t = _sg_cl(GRAPHCTL, root)
+        n1 = len(gl.read_text().splitlines())
+        old_t = _sg_cl(old, root)
+        n2 = len(gl.read_text().splitlines())
+        check(f"S1 {label}:文字輸出逐字相同", new_t.stdout == old_t.stdout and new_t.stderr == old_t.stderr,
+              f"new={new_t.stdout[-300:]}{new_t.stderr[-300:]}\nold={old_t.stdout[-300:]}{old_t.stderr[-300:]}")
+        check(f"S1 {label}:退出碼相同", new_t.returncode == old_t.returncode, f"{new_t.returncode} vs {old_t.returncode}")
+        check(f"S1 {label}:安全證據那一道不寫治理帳(新版多寫的筆數等於舊版)", n1 - n0 == n2 - n1, f"n0={n0} n1={n1} n2={n2}")
+        nj, oj = _sg_cl(GRAPHCTL, root, "--json"), _sg_cl(old, root, "--json")
+        try:
+            nd, od = _j.loads(nj.stdout.strip().splitlines()[-1]), _j.loads(oj.stdout.strip().splitlines()[-1])
+        except (ValueError, IndexError):
+            nd, od = {}, {"x": 1}
+        se = nd.pop("security_evidence", None)
+        if extra:
+            check("S1 只有標籤:--json 多一行提醒、仍是 no_registration", se and se.get("status") == "no_registration"
+                  and any("Systems/A.md" in w for w in se.get("warnings") or []) and nd == od, f"{se}\n{nd}\n{od}")
+        else:
+            check("S1 無登記:--json 只多 security_evidence=no_registration", se == {"status": "no_registration"} and nd == od,
+                  f"{se}\n{nd}\n{od}")
+        rep = _sg_eval(root)
+        check(f"S1 {label}:判定是 no_registration", rep["status"] == "no_registration" and not rep["blocked"], str(rep["status"]))
