+def _secapr_content(root, typ, target, opts):
+    """要簽的內容(閘門比對時用同一套算法)→ (content 物件, keys 或 None)。依 type 分派:
+    不看提交的(金鑰、撤銷、gate、壓制)、帶 --content-file 的、要從提交盤點算的。"""
+    if typ in _SECAPR_PLAIN:
+        return _SECAPR_PLAIN[typ](root, typ, target, opts)
+    if opts.get("content_file"):
+        return _secev_loads(Path(opts["content_file"]).read_text(encoding="utf-8")), None
+    if typ not in _SECAPR_AT:
+        raise ValueError(f"{typ} 要帶 --content-file")
+    return _SECAPR_AT[typ](_SecaprAt(root, opts.get("commit") or "HEAD"), target), None
+
+
+def _secapr_cmd_verify(root, commit, as_json, today):
+    """security approvals verify:從頭驗整條鏈(對主線 tip 驗前綴)。退出 0=全數有效、1=有不算數或分岔、2=取不到提交。"""
+    sha = _lens_full_sha(root, commit or "HEAD")
+    if sha is None:
+        print(f"擋下:取不到提交 {commit or 'HEAD'}", file=sys.stderr)
+        return 2
+    tree = _SecevTree(root, sha)
+    ml, how, _code = _secev_mainline(root, sha)
+    main_raw = _SecevTree(root, ml).read(_SECEV_APPROVALS_REL) if ml else None
+    try:
+        chain = _secapr_verify(tree.read(_SECEV_APPROVALS_REL), main_raw, _secev_project_id(root, ml or sha), today)
+    except _SecaprTooLong as e:
+        print(f"擋下:{e},驗不了(拆不了,只能請使用者裁)", file=sys.stderr)
+        return 1
+    view = dict(_secev_chain_view(chain), diverged=chain["diverged"], mainline=ml, mainline_how=how)
+    if as_json:
+        print(_json_text_escaped(view, indent=1))
+    else:
+        print(f"核可鏈 {_SECEV_APPROVALS_REL}(提交 {sha[:12]};主線 {ml[:12] if ml else '無'}):{len(view['entries'])} 筆")
+        if chain["diverged"]:
+            print("  ✗ 跟主線分岔:主線 tip 的鏈不是這一版的開頭一段;先把分支接上主線")
+        for e in view["entries"]:
+            print(f"  {e['seq']:>4} {e['status']:<32} {_secinv_show(str(e['type']))} {_secinv_show(str(e['target']), 120)}")
+        for k in view["keys"]:
+            print(f"  有效金鑰:{_secinv_show(k['principal'])} {k['fingerprint']}(到 {k['expires_on']})")
+        for w in view["warnings"]:
+            print(f"  提醒:{w}")
+    return 1 if chain["diverged"] or any(e["status"] != "ok" for e in view["entries"]) else 0
+
+
+def _secapr_payload_body(root, typ, target, signer, expires_on, opts, outcome, today):
