+def cmd_security_evidence(repo=None, commit=None, as_json=False):
+    """lumos security evidence [--commit <sha>] [--json]:唯讀證據判定,跟 code-loop check 的安全證據那一道是同一支函式。
+    會跑 git 與 ssh-keygen、只在系統暫存目錄寫暫時檔。退出 0=放行(含 no_registration、warn)、1=會被擋、2=參數錯。"""
+    root = _secinv_repo_root(Path(repo) if repo else Path.cwd())
+    if root is None:
+        print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
+        return 2
+    rep = _secev_evaluate(root, commit or "HEAD")
+    sys.stdout.write(_json_text_escaped(rep, indent=1) + "\n" if as_json else _secev_render(rep))
+    return 1 if rep["blocked"] else 0
