+def _secev_config(raw, for_mainline=False):
+    """.lumos/config.json 的 security_evidence 區塊 → {"mode": block|warn, "mainline": ref 或 None, "warnings": [...]}。
+    看不懂的值、型別錯、off 一律當 block 並講一句(同族慣例)。讀法照 _lint_new_config(from_snapshot=True):只吃位元組。
+    ★mainline 只從主線 tip 版的設定讀(for_mainline=True)★:被推的提交自己指定「拿誰比」等於被審的一方決定基準
+    (代碼審資安席:改一個檔就讓凍結比對與核可鏈前綴都變成自己對自己);只收 refs/remotes/ 開頭的遠端追蹤 ref。
+    推送版的設定寫了 mainline 只講一句不採用。"""
+    cfg = {"mode": "block", "mainline": None, "warnings": []}
+    if raw is None:
+        return cfg
+    try:
+        data = json.loads(raw.decode("utf-8-sig"))
+    except (UnicodeDecodeError, ValueError, RecursionError):
+        cfg["warnings"].append(".lumos/config.json 讀不了,security_evidence 照預設(block)判")
+        return cfg
+    sec = data.get("security_evidence") if isinstance(data, dict) else None
+    if sec is None:
+        return cfg
+    if not isinstance(sec, dict):
+        cfg["warnings"].append("security_evidence 的值看不懂,照 block 判")
+        return cfg
+    g = sec.get("gate", "block")
+    if g in ("block", "warn"):
+        cfg["mode"] = g
+    else:
+        cfg["warnings"].append(f"security_evidence.gate 的值看不懂({str(g)[:20]!r}),照 block 判")
+    ml = sec.get("mainline")
+    if ml is not None and not for_mainline:
+        cfg["warnings"].append("要推的提交設了 security_evidence.mainline:不採用(主線只讀主線 tip 版的 .lumos/config.json,"
+                               "不讓被審的一方決定拿誰比)")
+    elif ml is not None:
+        if _secinv_is_text(ml) and ml.startswith("refs/remotes/") and "\n" not in ml:
+            cfg["mainline"] = ml
+        else:
+            cfg["warnings"].append("security_evidence.mainline 要是 refs/remotes/ 開頭的遠端追蹤 ref,這次不用")
+            cfg["mainline_bad"] = True
+    return cfg
+
