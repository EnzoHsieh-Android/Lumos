+def _secev_render_head(rep, L):
+    """主線、gate、盤點、整道判不清、核可鏈的那幾行。"""
+    ml = rep.get("mainline") or {}
+    L.append(f"主線: {ml.get('sha') or '(無)'}({_secinv_show(ml.get('how') or '')})  merge-base: {rep.get('merge_base') or '(無)'}")
+    gs = rep["gate_setting"]
+    L.append(f"gate: 設定 {gs['configured']}、實際 {gs['effective']}" + (f"——{_secinv_show(gs['reason'])}" if gs.get("reason") else ""))
+    if rep.get("inventory"):
+        inv = rep["inventory"]
+        L.append(f"盤點: read_complete={str(inv['read_complete']).lower()} registration_complete={str(inv['registration_complete']).lower()} "
+                 f"errors={inv['errors']}(security_verdict 照舊 not_assessed)")
+    if rep["gate_code"]:
+        L.append(f"整道判不清: {rep['gate_code']}——{_secinv_show(rep['gate_detail'] or '')}")
+    keys = rep["approvals"]["keys"]
+    if keys:
+        L.append("現在有效的核可金鑰: " + "、".join(f"{_secinv_show(k['principal'])} {k['fingerprint']}(到 {k['expires_on']})" for k in keys))
+    L += [f"  核可鏈第 {e['seq']} 筆不算數:{e['status']}({_secinv_show(str(e['type']))} {_secinv_show(str(e['target']))})"
+          for e in [e for e in rep["approvals"]["entries"] if e["status"] != "ok"][:20]]
+
+
+def _secev_render_freeze(fz, L):
+    """凍結比對的那幾行:變弱、必驗集合縮小、有核可的修訂、工具清單變弱。"""
+    L += [f"變弱(沒有核可,照嚴的判):{_secinv_show(w['id'])} 對 {w['against']}:" + "、".join(w["fields"]) for w in fz["weakened"]]
+    L += [f"必驗集合縮小(沒有核可,照舊當必驗):{_secinv_show(w['id'])}——{w['why']}" for w in fz["removed"]]
+    L += [f"有核可的修訂:{_secinv_show(w['id'])}(核可鏈第 {w['approval_seq']} 筆)" for w in fz["approved_revisions"]]
+    L += [f"工具清單變弱:{_secinv_show(w['tool'])}:" + "、".join(w["weakened"]) + ("(有核可)" if w["approved"] else "(沒有核可,照主線那一列判)")
+          for w in fz["tool_list"]]
+
+
+def _secev_render_item(it, L):
+    L.append(f"        · {it.get('verdict')} {','.join(it.get('codes') or [])} 證據 {_secinv_show(str(it.get('path')))} "
+             f"工具 {_secinv_show(str(it.get('tool')))} {_secinv_show(str(it.get('tool_version')))} "
+             f"觀察 {it.get('observed_at')}" + (" (主線版被刪的項,照算)" if it.get("frozen_from_mainline") else ""))
+    if it.get("binding_versions"):
+        L.append("          綁定版本: " + "、".join(_secinv_show(b, 80) for b in it["binding_versions"][:10])
+                 + (f" 等 {it['bindings']} 支" if it.get("bindings", 0) > 10 else ""))
+    if it.get("detail"):
+        L.append(f"          細節: {_secinv_show(it['detail'], 200)}")
+    L += [f"          限制: {lim}" for lim in it.get("limitations") or []]
