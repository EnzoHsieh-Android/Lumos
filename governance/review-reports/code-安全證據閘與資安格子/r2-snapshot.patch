+def _secev_iso(s):
+    """ISO 8601 含時區 → aware datetime 或 None。"""
+    import datetime as _dt
+    if not isinstance(s, str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}T[0-9:.]+(?:Z|[+-]\d{2}:\d{2})", s):
+        return None
+    try:
+        d = _dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    return d if d.tzinfo is not None else None
+
