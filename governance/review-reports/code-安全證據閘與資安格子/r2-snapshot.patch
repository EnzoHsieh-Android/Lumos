+def _secev_junit_declared(facts, tests, legit, pre):
+    """宣告的每一支(非法案例、合法對照、前置斷言)在報告裡的狀態 → 問題代碼。"""
+    probs = []
+    for tid in dict.fromkeys(tests + legit + pre):
+        st = facts.get(tid)
+        if st is None:
+            probs.append("missing_legit_control" if tid in legit else "missing_precondition" if tid in pre else "target_missing")
+        elif st[0] == "skipped":
+            probs.append("target_skipped")
+        elif st[0] == "failure" and st[1]:
+            probs.append("assertion_failed")
+        elif st[0] != "passed":
+            probs.append("nonassertion_failure")
+    return probs
+
