+# 整道代碼 → gate_setting(warn)有沒有效(計劃〈哪些整道擋下可以降級〉)
+_SECEV_WARN_OK = {"read_incomplete": True, "registration_error": True, "toolchain_incomplete": True,
+                  "freeze_base_unavailable": True, "shallow_clone": True, "evaluation_error": True, "evaluation_timeout": True,
+                  "mainline_unknown": False, "approvals_diverged": False, "commit_unavailable": False}
+_SECEV_GATE_WHY = {
