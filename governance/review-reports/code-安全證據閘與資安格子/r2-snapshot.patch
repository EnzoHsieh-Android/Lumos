+def _sg_fence_raw(r, text):
+    """直接把 Verification 的證據圍欄換成一段原文(壞圍欄樣本用)。"""
+    full = r.commit
+    def commit(msg="c"):
+        sha = full(msg)
+        p = r.root / r.vault / "Verification/SgEv.md"
+        t = p.read_text()
+        a = t.index("```lumos-evidence-v1")
+        p.write_text(t[:a] + text)
+        _sg_git(r.root, "commit", "-qam", "壞圍欄")
+        return sha
+    r.commit = commit
+
