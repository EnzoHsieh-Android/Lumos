+def _secev_chain_view(chain):
+    return {"entries": [{"seq": e["seq"], "type": e["type"], "target": e["target"],
+                         "status": "ok" if e["status"] == "ok" else f"approval:{e['status']}"} for e in chain["entries"]],
+            "keys": [{"principal": p, "fingerprint": _secapr_fingerprint(t, k), "expires_on": x.isoformat()}
+                     for p, (t, k, x) in sorted(chain["keys"].items())],
+            "warnings": list(chain["warnings"])}
+
+
+def _secev_finish(rep):
+    """擋不擋:整道代碼或必驗集合裡有 unsound;gate_setting=warn 有效而且這個整道代碼可以降級時照算照印、不擋。"""
+    blocking = []
+    for j in rep["controls"]:
+        if j.get("mandatory") and j.get("verdict") == "unsound":
+            for c in j["control_codes"]:
+                blocking.append({"id": j["id"], "kind": "護欄", "code": c})
+            for k in j["kinds"]:
+                if k["verdict"] != "qualified" and not k.get("excepted"):
+                    first = next((it for it in k["items"] if it.get("verdict") != "qualified"), {})
+                    blocking.append({"id": j["id"], "kind": k["kind"], "code": (k["codes"] or [k["verdict"]])[0],
+                                     "path": first.get("path")})
+    rep["blocking"] = blocking
+    hard = bool(rep["gate_code"]) or bool(blocking)
+    gs = rep["gate_setting"]
+    warn_ok = gs["effective"] == "warn" and (not rep["gate_code"] or _SECEV_WARN_OK.get(rep["gate_code"], False))
+    if gs["effective"] == "warn" and rep["gate_code"] and not _SECEV_WARN_OK.get(rep["gate_code"], False):
+        gs["reason"] = f"整道代碼 {rep['gate_code']} 不能降級,warn 這次無效"
+    rep["blocked"] = hard and not warn_ok
+    rep["warned_only"] = hard and warn_ok
+    return rep
+
+
+def _secev_grep_trace(repo_root, sha, deadline=None):
+    """廉價預檢:先一次 git grep 找提到 lumos-security-v1 的 .md;命中的那幾篇再照盤點的嚴格讀法(_secinv_blocks)看
+    有沒有真的圍欄或變體(散文裡提到這個字樣不算痕跡)。回 True/False/None(git 失敗,當成可能有)。"""
+    r = _secev_git(repo_root, "grep", "-l", "-z", "-F", "--no-color", _SECINV_MARK, sha, "--", "*.md", deadline=deadline)
+    if r is None:
+        return None
+    if r.returncode == 1:
+        return False
+    if r.returncode != 0:
+        return None
+    pre = sha + ":"
+    paths = [p.removeprefix(pre) for p in r.stdout.split("\0") if p]
+    if not paths:
+        return False
+    got = _nodehome_cat_blobs_capped(repo_root, [f"{sha}:{p}" for p in paths], _VAULT_SAFE_FILE_MAX, deadline=deadline)
+    if got is None:
+        return None
+    for p, b in zip(paths, got):
+        if b is None:
+            return True             # 讀不到(太大、特殊檔):交給完整快照判
+        try:
+            text = b.decode("utf-8")
+        except UnicodeDecodeError:
+            return True
+        blocks, errs = _secinv_blocks(p, text)
+        if blocks or errs:
+            return True
+    return False
+
