+def _sg_hit(rule, uri="src/app.py", line=1, **kw):
+    r = {"ruleId": rule, "level": "error", "locations": [{"physicalLocation": {"artifactLocation": {"uri": uri}, "region": {"startLine": line}}}]}
+    r.update(kw)
+    return r
