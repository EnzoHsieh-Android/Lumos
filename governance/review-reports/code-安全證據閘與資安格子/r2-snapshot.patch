+def _secev_vault_report(repo_root, tree, today, deadline):
+    """一版提交樹 → (盤點報告, env, 圖譜相對路徑, 超過單檔上限的 Verification 篇章) 或 (None, None, None, 錯誤說明)。"""
+    vs = tree.find_vaults()
+    if not vs:
+        return {"records": [], "retired": [], "excluded_business": [], "errors": [], "read_complete": True}, None, None, set()
+    if len(vs) > 1:
+        return None, None, None, "提交樹裡找到不只一個知識圖譜(" + "、".join(vs) + "),不猜"
+    snap = _secinv_snapshot_tree(repo_root, tree.sha, vs[0], tree=tree, deadline=deadline)
+    oversize = {e["node"] for e in snap["errors"] if e["kind"] == "file_too_large" and str(e["node"]).startswith("Verification/")}
+    keep = [e for e in snap["errors"] if not (e["kind"] == "file_too_large" and e["node"] in oversize)]
+    snap = dict(snap, errors=keep)
+    vault_path = Path(repo_root) / vs[0] if vs[0] else Path(repo_root)
+    rep, env = _secinv_build(vault_path, snap, today, want_env=True)
+    rep["_inv_holder"] = {"inv": rep.pop("_inventory", None)}     # 盤點區塊照 security list --json 的形狀輸出,inventory 另外拿
+    return rep, env, vs[0], oversize
+
