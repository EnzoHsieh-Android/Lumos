+def _secev_num(v):
+    """外來 JSON 的數值:int 或 float,bool 不算(JSON 的 true 在 Python 是 int 的子類)。"""
+    return isinstance(v, (int, float)) and not isinstance(v, bool)
+
+
+def _secev_int(v):
+    """外來 JSON 的整數:int,bool 不算。"""
+    return type(v) is int
