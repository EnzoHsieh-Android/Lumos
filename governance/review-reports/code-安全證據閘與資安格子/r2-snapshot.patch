+    def mk(groups=None, write=True, files_over=None, mutate_after=False, raw_line=None):
+        r = _SgRepo()
+        r.items[1] = _sg_gk_item(r)
+        r.commit()
+        head = _sg_git(r.root, "rev-parse", "HEAD")
