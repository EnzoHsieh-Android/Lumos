+        rep = _sg_eval(r, today=today)
+        j = _sg_ctl(rep)
+        check(f"S23 {label} → {want}、照擋", (j.get("exception") or {}).get("status") == want and rep["blocked"],
+              str(j.get("exception")) + str(rep["blocking"]))
+    r = _sg_exc_repo(exp="2026-11-10", approved="2026-10-21")
+    r.commit()
+    rep = _sg_eval(r, today=today)
