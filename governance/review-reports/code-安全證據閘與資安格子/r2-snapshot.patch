+
+def _secev_item_problem(it):
+    """一項證據的形狀 → 問題字串或 None(圍欄層級:任何一項不合格,整塊圍欄判讀不出來)。"""
+    if not isinstance(it, dict):
+        return "項目不是物件"
+    extra = sorted(set(it) - set(_SECEV_ITEM_KEYS))
+    if extra:
+        return "有未列出的鍵 " + _secinv_names(extra)
+    return next((p for p in (fn(it) for fn in _SECEV_ITEM_CHECKS) if p), None)
