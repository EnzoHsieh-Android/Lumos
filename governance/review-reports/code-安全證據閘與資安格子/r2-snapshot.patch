+def _secev_skeleton(sha, today):
+    return {"schema_version": 1, "purpose": "evidence", "security_verdict": "not_assessed", "notice": _SECEV_NOTICE,
+            "words_notice": _SECEV_WORDS_NOTICE, "commit": sha, "today_utc": today.isoformat(), "status": "evaluated",
+            "gate_code": None, "gate_detail": None, "gate_setting": {"configured": "block", "effective": "block", "reason": None},
+            "mainline": None, "merge_base": None, "inventory": None, "inventory_report": None, "controls": [], "candidates": [],
+            "freeze": {"weakened": [], "removed": [], "approved_revisions": [], "tool_list": []},
+            "approvals": {"entries": [], "keys": [], "warnings": []}, "reminders": [], "warnings": [], "blocking": [],
+            "blocked": False, "limitations": [
+                "主線 tip 從本機 ref 讀:改得動本機 ref 就造得出假主線;CI 用從遠端抓的 ref,是最後的核對(事後)",
+                "git push --no-verify 跳過本機閘、CI 在主線更新之後才跑,擋不住已進主線的提交(工具天花板)",
+                "核可只證明持有登記金鑰的人簽過;簽的時候有沒有觸碰或輸入密碼,工具驗不到",
+                "核可寫入要互動終端加手打確認碼;刻意用 script 之類工具偽造終端、自動照抄確認碼,工具分不出來",
+                "專案識別取根提交:fork 或從範本複製出的專案共用根提交,彼此的核可鏈筆在識別上分不開"
+                "(要被收還得護欄 id、revision、輸入雜湊與日期全部吻合)",
+                _SECEV_LIMIT_FORGED]}
