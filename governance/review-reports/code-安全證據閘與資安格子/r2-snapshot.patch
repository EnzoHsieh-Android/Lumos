+def _secev_loads(text):
+    """證據類 JSON 的嚴格讀法:_secinv_json_loads(拒重複鍵、NaN)加深度上限。Python 3.14 的 json 對十萬層巢狀不丟
+    RecursionError、直接解完(2026-10-20 實測),所以解完再用迭代量一次深度,超過丟 RecursionError,呼叫端照「巢狀過深」處理。"""
+    obj = _secinv_json_loads(text)
+    stack = [(obj, 1)]
+    while stack:
+        o, d = stack.pop()
+        if d > _SECEV_JSON_DEPTH:
+            raise RecursionError("JSON nesting too deep")
+        if isinstance(o, dict):
+            stack.extend((v, d + 1) for v in o.values() if isinstance(v, (dict, list)))
+        elif isinstance(o, list):
+            stack.extend((v, d + 1) for v in o if isinstance(v, (dict, list)))
+    return obj
+
