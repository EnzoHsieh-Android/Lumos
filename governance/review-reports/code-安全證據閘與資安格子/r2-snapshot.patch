+def _secev_frozen(main_items, push_items):
+    """主線 tip 版有、推送版刪掉的項照樣算數,除非推送版有同 control、同 kind、同 targets 且 observed_at 更新的項取代它。"""
+    pc = {_secev_canon(it) for it in push_items}
+    out = []
+    for it in main_items:
+        if _secev_canon(it) in pc:
+            continue
+        tk = _secev_canon(it.get("targets"))
+        o = _secev_iso(it.get("observed_at"))
+        if any(p["kind"] == it["kind"] and _secev_canon(p.get("targets")) == tk and o is not None
+               and _secev_iso(p.get("observed_at")) is not None and _secev_iso(p["observed_at"]) > o for p in push_items):
+            continue
+        out.append(it)
+    return out
+
