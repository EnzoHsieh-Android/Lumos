+        if not _secinv_is_text(it.get(k)):
+            return f"{k} 必填、要是非空字串"
+    fmt = it["format"]
+    if fmt != "guard_kill" and not _secinv_is_text(it.get("path")):
+        return "path 必填(guard_kill 除外)"
+    if fmt in ("junit", "sarif", "k6_summary") and not (isinstance(it.get("report_sha256"), str)
+                                                         and re.fullmatch(r"[0-9a-f]{64}", it["report_sha256"])):
+        return "report_sha256 必填、要是 64 位小寫十六進位"
+    if fmt == "sarif" and not _secinv_is_text(it.get("coverage_path")):
+        return "coverage_path 是 sarif 必填"
+    missing = next((k for k in ("tool", "tool_version", "environment_ref") if fmt != "review_record" and not _secinv_is_text(it.get(k))), None)
+    return f"{missing} 必填(review_record 除外)" if missing else None
