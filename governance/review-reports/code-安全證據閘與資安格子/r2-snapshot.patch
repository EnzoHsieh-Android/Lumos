+def _secev_budget_paths(ctx, work, over_items):
+    """要讀的證據檔 → 照(路徑、blob)排序的清單(同一份檔被多條護欄引用只列一次)。"""
+    paths = set()
+    for _rec, its in work:
+        for it in (x for x in its if id(x) not in over_items):
+            paths |= {(p, ctx.tree.oids[p]) for p in (it.get(k) for k in ("path", "coverage_path", "calibration_path"))
+                      if isinstance(p, str) and p in ctx.tree.files}
+    return sorted(paths)
+
+
+def _secev_budget_prepass(ctx, work):
+    """證據項總數上限與讀取總量上限(按不同 blob 算一次,固定照(路徑、blob)排序累加)。超過的項或檔判 evidence_too_large。"""
+    items = sorted(((rec["id"], it["kind"], str(it.get("path") or ""), id(it)) for rec, its in work for it in its))
+    over_items = {x[3] for x in items[_SECEV_ITEMS_MAX:]}
+    ordered = _secev_budget_paths(ctx, work, over_items)
+    sizes = _nodehome_cat_sizes(ctx.repo_root, [o for _p, o in ordered], _git_timeout(ctx.deadline, cap=60)) if ordered else []
+    if sizes is None:
+        raise RuntimeError("問證據檔大小時 git 失敗或逾時")
+    used, seen = 0, set()
+    for (p, o), n in zip(ordered, sizes):
+        if o in seen or n is None or n > _SECEV_FILE_MAX:
+            seen.add(o)
+            continue
+        seen.add(o)
+        if used + n > _SECEV_TOTAL_MAX:
+            ctx.over.add(p)
+        else:
+            used += n
+    return over_items
+
