+    rep = _sg_eval(r, today=_dt.datetime(2026, 10, 30, 23, 0, tzinfo=_dt.timezone.utc).date())
+    check("S25 台灣清晨(UTC 前一天)照 UTC 判 → 放行", not rep["blocked"])
