+def t_secev_s09_bindings():
+    """S9:綁定的任一檔 blob、護欄 revision 或工具版本跟要推的提交不同 → stale 或 tool_version_mismatch;綁定少了家 about_code、
+    test_sources、fixture_globs 展開的檔、environment_ref 或 glob 展開為空 → invalid:binding_incomplete。"""
