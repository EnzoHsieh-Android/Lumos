+        (root / "docs/sg-knowledge/Systems/A.md").write_text("---\ntype: system\nstatus: doing\n" + extra
+                                                             + "---\n# A\n散文提到 lumos-security-v1 字樣不算登記。\n")
+        (root / "src").mkdir()
+        (root / "src/app.py").write_text("x = 1\n")
+        (root / "docs/.governance-log.jsonl").write_text("")
+        _sg_git(root, "add", "-A")
