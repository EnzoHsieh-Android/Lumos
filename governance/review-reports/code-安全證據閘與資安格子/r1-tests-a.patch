+def _sg_old_lumos():
+    """主線版 scripts/lumos 與它的 test-quality 配套抄到暫存目錄(S1 比「跟既有判定逐字相同」用)。"""
+    import tempfile
+    d = Path(tempfile.mkdtemp(prefix="gctl-sgold-"))
+    repo = Path(GRAPHCTL).resolve().parent.parent
+    base = _sg_git(repo, "merge-base", "HEAD", "Lumos/main", check=False) or "HEAD~1"
+    for f in ("lumos", "test_quality.py", "test_quality_scan.py", "test_quality_semgrep.py"):
+        b = subprocess.run(["git", "-C", str(repo), "show", f"{base}:scripts/{f}"], capture_output=True).stdout
+        (d / f).write_bytes(b)
+    return d / "lumos"
