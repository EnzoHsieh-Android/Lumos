+    # 沒有 remote、沒有 main/master:分支叫 trunk 的新 repo
+    nr = _SgRepo()
+    _sg_git(nr.root, "branch", "-m", "main", "trunk")
+    nr.commit()
+    rep = _sg_eval(nr, pushed_branch="trunk")
+    check("S30 沒有 remote 也沒有 main/master → 空樹起點照判(不是 mainline_unknown)",
