+def t_secev_s25_exception_dates():
+    """S25:今天(UTC)是例外到期日當天 → 放行並印 7 天內到期的提醒;隔天不需改檔就自動恢復擋;到期前八天不提醒、前一天提醒;
+    台灣時間清晨對應的 UTC 前一天照 UTC 判。"""
+    import datetime as _dt
+    r = _sg_exc_repo(exp="2026-10-30", approved="2026-10-15")
