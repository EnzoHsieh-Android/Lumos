+            self.keys.append({"principal": f"user{i}@example.test", "priv": kp, "type": pub[0], "pub": pub[1]})
+        self.chain_lines = []
+        self.vault = "docs/sg-knowledge"
+        self.files = {"src/app.py": b"def pay(order, user):\n    return order.owner == user\n",
