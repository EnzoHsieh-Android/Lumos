+        if (v is not None or need) and not (isinstance(v, list) and all(_secinv_is_text(x) for x in v)):
+            return f"{k} 要是字串陣列" + ("(這個 format 必填)" if need else "")
+    t = it.get("targets")
+    if not isinstance(t, dict) or set(t) - set(_SECEV_TARGET_KEYS) or not all(
+            isinstance(v, list) and all(_secinv_is_text(x) for x in v) for v in t.values()):
+        return "targets 必填、要是物件,值是字串陣列,鍵只收 " + "、".join(_SECEV_TARGET_KEYS)
+    if it.get("calibration_path") is not None and not _secinv_is_text(it["calibration_path"]):
+        return "calibration_path 要是非空字串"
+    return None
+
+
+def _secev_ip_times(it):
+    if _secev_iso(it["observed_at"]) is None:
+        return "observed_at 要是含時區的 ISO 8601 時間"
+    if it["kind"] == "dependency_scan" and _secev_iso(it.get("vulndb_fetched_at")) is None:
+        return "vulndb_fetched_at 是 dependency_scan 必填、要是含時區的 ISO 8601 時間(不收版本號)"
+    if it.get("vulndb_fetched_at") is not None and _secev_iso(it.get("vulndb_fetched_at")) is None:
+        return "vulndb_fetched_at 要是含時區的 ISO 8601 時間"
+    return None
+
+
+def _secev_ip_review(it):
+    if it["format"] != "review_record":
+        extra = next((k for k in ("reviewer", "author", "reviewer_kind", "judgments", "expires_on") if k in it), None)
+        return f"{extra} 只有 review_record 能寫" if extra else None
+    if not _secinv_is_text(it.get("reviewer")):
+        return "reviewer 是 review_record 必填"
+    a = it.get("author")
+    if not (_secinv_is_text(a) or (isinstance(a, list) and a and all(_secinv_is_text(x) for x in a))):
+        return "author 是 review_record 必填(字串或字串陣列)"
+    if it.get("reviewer_kind") not in ("ai", "human"):
+        return "reviewer_kind 只收 ai 或 human"
+    j = it.get("judgments")
+    if not (isinstance(j, list) and j and all(x in _SECEV_JUDGMENTS for x in j) and len(set(j)) == len(j)):
+        return "judgments 要是非空、不重複、只含已知判斷 id 的陣列"
+    if _secinv_date(it.get("expires_on")) is None:
+        return "expires_on 是 review_record 必填、要是 YYYY-MM-DD"
+    return None
+
+
+_SECEV_ITEM_CHECKS = (_secev_ip_required, _secev_ip_lists, _secev_ip_times, _secev_ip_review)
+
+
+def _secev_item_problem(it):
+    """一項證據的形狀 → 問題字串或 None(圍欄層級:任何一項不合格,整塊圍欄判讀不出來)。"""
+    if not isinstance(it, dict):
+        return "項目不是物件"
+    extra = sorted(set(it) - set(_SECEV_ITEM_KEYS))
+    if extra:
+        return "有未列出的鍵 " + _secinv_names(extra)
+    return next((p for p in (fn(it) for fn in _SECEV_ITEM_CHECKS) if p), None)
+
+
+def _secev_iso(s):
+    """ISO 8601 含時區 → aware datetime 或 None。"""
+    import datetime as _dt
+    if not isinstance(s, str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}T[0-9:.]+(?:Z|[+-]\d{2}:\d{2})", s):
+        return None
+    try:
+        d = _dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    return d if d.tzinfo is not None else None
+
+
+def _secev_fence(rel, text):
+    """一篇 Verification 的證據圍欄 → (items 或 None, 問題或 None)。沒有圍欄 → ([], None);
+    圍欄未閉合、一篇多塊、壞 JSON、形狀不合 → (None, 問題)(引用它的證據判 invalid:evidence_fence_invalid)。
+    圍欄判定跟盤點共用 _secinv_blocks(只換標記與准放的資料夾)。"""
+    blocks, errs = _secinv_blocks(rel, text, mark=_SECEV_MARK)
+    if errs:
+        return None, errs[0].get("detail") or errs[0]["kind"]
+    if not blocks:
+        return [], None
+    if len(blocks) > 1:
+        return None, "一篇最多一塊證據圍欄"
+    try:
+        obj = _secev_loads(blocks[0][1])
+    except RecursionError:
+        return None, "巢狀太深"
+    except ValueError as e:
+        return None, f"JSON 讀不出來:{str(e)[:120]}"
+    if not isinstance(obj, dict) or set(obj) != {"schema_version", "items"} or type(obj["schema_version"]) is not int \
+            or obj["schema_version"] != 1 or not isinstance(obj["items"], list):
+        return None, "頂層要是 {\"schema_version\": 1, \"items\": [...]},兩個鍵都必填、不准有未列的鍵"
+    for i, it in enumerate(obj["items"]):
+        p = _secev_item_problem(it)
+        if p:
+            return None, f"items[{i}] {p}"
+    return obj["items"], None
+
+
+_SECEV_TOOL_KEYS = {"name", "category", "version", "install_source", "verify", "decision_ref", "budget", "allowed_targets",
+                    "coverage_proof", "min_requests"}
+_SECEV_TOOL_NEED = {"name", "category", "version", "install_source", "verify", "decision_ref", "budget", "allowed_targets"}
+
+
+def _secev_tool_row(i, t, env, cache):
+    """工具清單一列 → (整理過的列, None) 或 (None, 問題)。掃描類缺覆蓋證明、壓測類缺 min_requests、核可決策失效都標在列上。"""
+    if not isinstance(t, dict) or not _SECEV_TOOL_NEED <= set(t) or set(t) - _SECEV_TOOL_KEYS:
+        return None, f"{_SECEV_TOOLS_REL} tools[{i}] 鍵不對(必填 " + "、".join(sorted(_SECEV_TOOL_NEED)) + ")"
+    if not all(_secinv_is_text(t[k]) for k in ("name", "category", "version", "install_source", "verify", "decision_ref")) \
+            or t["category"] not in _SECEV_TOOL_CATS or not isinstance(t["budget"], dict) \
+            or not (isinstance(t["allowed_targets"], list) and all(_secinv_is_text(x) for x in t["allowed_targets"])):
+        return None, f"{_SECEV_TOOLS_REL} tools[{i}] 型別不對或工具類別不認得"
+    t = dict(t)
+    if t["category"] in _SECEV_SCAN_CATS and t.get("coverage_proof") not in _SECEV_COVERAGE_PROOFS:
+        t["_coverage_unproven"] = True
+    mr = t.get("min_requests")
+    if t["category"] == "load_test" and not (isinstance(mr, dict) and mr and all(
+            _secinv_is_text(k) and type(v) is int and v > 0 for k, v in mr.items())):
+        t["_min_requests_missing"] = True
+    dp = _secinv_decision_problem(env, t["decision_ref"], cache) if env is not None else None
+    if dp:
+        t["_unapproved"] = dp
+    return t, None
+
+
+def _secev_tools_load(raw, env, cache):
+    """工具清單位元組 → (工具清單 {名稱: 列}, 問題或 None)。讀不出來(壞 JSON、未列鍵、型別錯)→ ({}, 問題):
+    裡面每個工具都算沒登記,不像 _lint_load_config 那樣靜默回空。核可決策作廢或找不到的那一列也不算登記。"""
+    if raw is None:
+        return {}, None
+    try:
+        obj = _secev_loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError, RecursionError) as e:
+        return {}, f"{_SECEV_TOOLS_REL} 讀不出來:{str(e)[:120]}"
+    if not isinstance(obj, dict) or set(obj) != {"schema_version", "tools"} or obj.get("schema_version") != 1 \
+            or not isinstance(obj["tools"], list):
+        return {}, f"{_SECEV_TOOLS_REL} 頂層要是 {{\"schema_version\": 1, \"tools\": [...]}}"
+    out = {}
+    for i, t in enumerate(obj["tools"]):
+        row, prob = _secev_tool_row(i, t, env, cache)
+        if prob:
+            return {}, prob
+        if row["name"] in out:
+            return {}, f"{_SECEV_TOOLS_REL} 工具名 {row['name'][:40]} 重複"
+        out[row["name"]] = row
+    return out, None
+
+
+def _secev_config(raw):
+    """推送版 .lumos/config.json 的 security_evidence 區塊 → {"mode": block|warn, "mainline": ref 或 None, "warnings": [...]}。
+    看不懂的值、型別錯、off 一律當 block 並講一句(同族慣例)。讀法照 _lint_new_config(from_snapshot=True):只吃位元組。"""
+    cfg = {"mode": "block", "mainline": None, "warnings": []}
+    if raw is None:
+        return cfg
+    try:
+        data = json.loads(raw.decode("utf-8-sig"))
+    except (UnicodeDecodeError, ValueError, RecursionError):
+        cfg["warnings"].append(".lumos/config.json 讀不了,security_evidence 照預設(block)判")
+        return cfg
+    sec = data.get("security_evidence") if isinstance(data, dict) else None
+    if sec is None:
+        return cfg
+    if not isinstance(sec, dict):
+        cfg["warnings"].append("security_evidence 的值看不懂,照 block 判")
+        return cfg
+    g = sec.get("gate", "block")
+    if g in ("block", "warn"):
+        cfg["mode"] = g
+    else:
+        cfg["warnings"].append(f"security_evidence.gate 的值看不懂({str(g)[:20]!r}),照 block 判")
+    ml = sec.get("mainline")
+    if ml is not None:
+        if _secinv_is_text(ml) and ml.startswith("refs/") and "\n" not in ml:
+            cfg["mainline"] = ml
+        else:
+            cfg["warnings"].append("security_evidence.mainline 要是 refs/ 開頭的 ref 名,這次不用")
+            cfg["mainline_bad"] = True
+    return cfg
+
