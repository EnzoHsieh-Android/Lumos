+          and rep["blocked"] == (rep["gate_code"] == "approvals_diverged"), str(rep["gate_code"]) + str(rep["gate_setting"]))
+    r = warned(_SgRepo())
+    r.commit()
+    _sg_git(r.root, "remote", "add", "origin", "file:///nonexistent")
