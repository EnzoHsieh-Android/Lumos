+def t_secev_s32_ci_tag_job():
+    """S32 的 CI 那半:工具鏈 CI 的 push 觸發含 tags、有一個只在 tag 推送跑的工作呼叫 code-loop check --security-only --at-sha,
+    其他工作(prep 起頭的那一串)只在分支或 PR 跑。"""
+    _need_src(".github/workflows/ci.yml")
