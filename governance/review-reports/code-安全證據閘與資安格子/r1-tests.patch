+           "surfaces": [dict({"id": s[0], "asset_ids": list(s[2]), "description": f"{s[0]} 入口"},
+                             **({"kind": s[1]} if s[1] else {}), **({"actor_ids": list(s[3])} if s[3] is not None else {}))
