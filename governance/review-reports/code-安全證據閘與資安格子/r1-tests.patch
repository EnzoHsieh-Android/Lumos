+def t_secev_s11_scan_calibration():
+    """S11:掃描類只有零發現的正式報告、沒有同工具同版本對已知陽性樣本命中的校準檔、或校準沒命中某條宣告規則 → uncalibrated 並擋。"""
+    r, rep = _sg_with_kind("static_analysis", _sg_sarif_item(), tools=[_SG_SEMGREP], files=_sg_sarif_files())
