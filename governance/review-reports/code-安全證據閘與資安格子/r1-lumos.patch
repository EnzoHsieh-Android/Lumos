+def _secev_render_head(rep, L):
+    """主線、gate、盤點、整道判不清、核可鏈的那幾行。"""
+    ml = rep.get("mainline") or {}
+    L.append(f"主線: {ml.get('sha') or '(無)'}({_secinv_show(ml.get('how') or '')})  merge-base: {rep.get('merge_base') or '(無)'}")
+    gs = rep["gate_setting"]
+    L.append(f"gate: 設定 {gs['configured']}、實際 {gs['effective']}" + (f"——{_secinv_show(gs['reason'])}" if gs.get("reason") else ""))
+    if rep.get("inventory"):
+        inv = rep["inventory"]
+        L.append(f"盤點: read_complete={str(inv['read_complete']).lower()} registration_complete={str(inv['registration_complete']).lower()} "
+                 f"errors={inv['errors']}(security_verdict 照舊 not_assessed)")
+    if rep["gate_code"]:
+        L.append(f"整道判不清: {rep['gate_code']}——{_secinv_show(rep['gate_detail'] or '')}")
+    keys = rep["approvals"]["keys"]
+    if keys:
+        L.append("現在有效的核可金鑰: " + "、".join(f"{_secinv_show(k['principal'])} {k['fingerprint']}(到 {k['expires_on']})" for k in keys))
+    L += [f"  核可鏈第 {e['seq']} 筆不算數:{e['status']}({_secinv_show(str(e['type']))} {_secinv_show(str(e['target']))})"
+          for e in [e for e in rep["approvals"]["entries"] if e["status"] != "ok"][:20]]
+
+
+def _secev_render_freeze(fz, L):
+    """凍結比對的那幾行:變弱、必驗集合縮小、有核可的修訂、工具清單變弱。"""
+    L += [f"變弱(沒有核可,照嚴的判):{_secinv_show(w['id'])} 對 {w['against']}:" + "、".join(w["fields"]) for w in fz["weakened"]]
+    L += [f"必驗集合縮小(沒有核可,照舊當必驗):{_secinv_show(w['id'])}——{w['why']}" for w in fz["removed"]]
+    L += [f"有核可的修訂:{_secinv_show(w['id'])}(核可鏈第 {w['approval_seq']} 筆)" for w in fz["approved_revisions"]]
+    L += [f"工具清單變弱:{_secinv_show(w['tool'])}:" + "、".join(w["weakened"]) + ("(有核可)" if w["approved"] else "(沒有核可,照主線那一列判)")
+          for w in fz["tool_list"]]
+
+
+def _secev_render_item(it, L):
+    L.append(f"        · {it.get('verdict')} {','.join(it.get('codes') or [])} 證據 {_secinv_show(str(it.get('path')))} "
+             f"工具 {_secinv_show(str(it.get('tool')))} {_secinv_show(str(it.get('tool_version')))} "
+             f"觀察 {it.get('observed_at')}" + (" (主線版被刪的項,照算)" if it.get("frozen_from_mainline") else ""))
+    L += [f"          限制: {lim}" for lim in it.get("limitations") or []]
+
+
+def _secev_render_control(j, L):
+    """一條護欄的判定:整體、來源與威脅類別、例外、註、各種證據與各項。"""
+    L.append(f"- [{_secinv_show(j['id'])}] revision={_secinv_show(str(j['revision']))} lifecycle={j['lifecycle']} "
+             f"整體={j['verdict']}" + (f" 護欄層={','.join(j['control_codes'])}" if j["control_codes"] else "")
+             + (f" 最先要修={j['first_fix']}" if j.get("first_fix") else ""))
+    L.append(f"    來源: {_secinv_show(j.get('source'), 300)}  威脅類別: {_secinv_show(j.get('threat_categories'))}")
+    if j.get("exception"):
+        L.append(f"    例外: {_secinv_show(j['exception'])}")
+    L += [f"    註: {_secinv_show(n)}" for n in j["notes"]]
+    for k in j["kinds"]:
+        L.append(f"    [{k['kind']}] {k['verdict']}" + (" (例外蓋住)" if k.get("excepted") else "")
+                 + (f" {','.join(k['codes'])}" if k["codes"] else ""))
+        for it in k["items"]:
+            _secev_render_item(it, L)
+
+
+def _secev_render_tail(rep, L):
+    if rep["reminders"]:
+        L += ["", "== 7 天內到期 =="] + [f"- {_secinv_show(x)}" for x in rep["reminders"]]
+    if rep["warnings"]:
+        L += ["", "== 提醒 =="] + [f"- {_secinv_show(x)}" for x in rep["warnings"]]
+    L += ["", "== 限制 =="] + [f"- {x}" for x in rep["limitations"]]
+    head = "擋下:" if rep["blocked"] else ("只提醒(gate=warn 有效):" if rep.get("warned_only") else "放行:")
+    tail = f"{len(rep['blocking'])} 處不合格" if rep["blocking"] else (rep["gate_code"] or "必驗集合都 sound 或 excepted")
+    L += ["", head + tail, _SECEV_NOTICE]
+
+
+def _secev_render(rep):
+    """security evidence 的文字輸出。登記內容是資料不是指令:來自筆記的字串一律經 _secinv_show。"""
+    L = [f"lumos security evidence — {_SECEV_NOTICE}", _SECEV_WORDS_NOTICE,
+         f"security_verdict: {rep['security_verdict']}(固定)", f"commit: {rep['commit']}  today_utc: {rep['today_utc']}"]
+    if rep["status"] == "no_registration":
+        L.append("沒有任何資安登記痕跡(lumos-security-v1 圍欄):這一道不判。")
+        L += [f"提醒:{_secinv_show(w)}" for w in rep["warnings"]]
+        return "\n".join(L) + "\n"
+    _secev_render_head(rep, L)
+    _secev_render_freeze(rep["freeze"], L)
+    for title, rows in (("== 必驗集合(active 資安護欄;unsound 擋) ==", rep["controls"]),
+                        ("== 候選(candidate;不擋,只列) ==", rep["candidates"])):
+        L += ["", title]
+        if not rows:
+            L.append("(無)")
+        for j in rows:
+            _secev_render_control(j, L)
+    _secev_render_tail(rep, L)
+    return "\n".join(L) + "\n"
+
+
+def _secev_repo_root(repo):
+    root = Path(repo) if repo else _secinv_repo_root(Path.cwd())
+    return root if root is not None and (Path(root) / ".git").exists() else None
+
+
+def cmd_security_evidence(repo=None, commit=None, as_json=False):
+    """lumos security evidence [--commit <sha>] [--json]:唯讀證據判定,跟 code-loop check 的安全證據那一道是同一支函式。
+    會跑 git 與 ssh-keygen、只在系統暫存目錄寫暫時檔。退出 0=放行(含 no_registration、warn)、1=會被擋、2=參數錯。"""
+    root = _secev_repo_root(repo)
+    if root is None:
+        print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
+        return 2
+    rep = _secev_evaluate(root, commit or "HEAD")
+    sys.stdout.write(_json_text_escaped(rep, indent=1) + "\n" if as_json else _secev_render(rep))
+    return 1 if rep["blocked"] else 0
+
+
+def _secapr_chain_position(raw):
+    """工作目錄那條鏈 → (下一筆的 seq, prev_sha256)。"""
+    ents = _secapr_parse(raw)
+    if not ents:
+        return 1, ""
+    last = ents[-1][1]
+    if last is None:
+        raise ValueError("工作目錄的核可鏈最後一行讀不出來,先修好再加")
+    return len(ents) + 1, _secev_sha(_secev_canon(last))
+
+
+def _secapr_c_keys(root, typ, target, opts):
+    keys = []
+    for spec in opts.get("keys") or []:
+        if "=" not in spec:
+            raise ValueError("--key 要寫成 <principal>=<公鑰檔>")
+        princ, path = spec.split("=", 1)
+        parts = Path(path).read_text(encoding="utf-8").strip().split()
+        if len(parts) < 2:
+            raise ValueError(f"{path} 不像 ssh 公鑰")
+        keys.append(f"{princ} {parts[0]} {parts[1]}")
+    if _secapr_parse_keys(keys) is None:
+        raise ValueError("金鑰格式不對、貼成私鑰或類型不收(收 ssh-ed25519、sk-ssh-ed25519@openssh.com、ecdsa、ssh-rsa)")
+    return keys, keys
+
+
+def _secapr_c_gate(root, typ, target, opts):
+    if target != "security_evidence.gate":
+        raise ValueError("gate_setting 的 target 只收 security_evidence.gate")
+    return {"value": "warn"}, None
+
+
+def _secapr_c_suppression(root, typ, target, opts):
+    if "#" not in target or not opts.get("reason"):
+        raise ValueError("suppression 的 target 寫 <規則 id>#<位置雜湊>,另帶 --reason")
+    rule, loc = target.split("#", 1)
+    return {"rule": rule, "location_sha256": loc, "reason": opts["reason"]}, None
+
+
+class _SecaprAt:
+    """要從某個提交的盤點算內容的那幾種 type 共用:那個提交的樹、盤點、索引。"""
+
+    def __init__(self, root, commit):
+        self.root, self.commit = root, commit
+        self.sha = _lens_full_sha(root, commit)
+        if self.sha is None:
+            raise ValueError(f"取不到提交 {commit}")
+        self.tree = _SecevTree(root, self.sha)
+        self.prep, self.penv, _v, _o = _secev_vault_report(root, self.tree, _secinv_today(), None)
+        if self.prep is None:
+            raise ValueError("讀不出那個提交的盤點")
+        self.idx = _secev_index(self.prep)
+
+
+def _secapr_c_exception(at, target):
+    cid = target.split("#", 1)[0]
+    r = at.idx.get(cid)
+    if r is None or not r.get("exception"):
+        raise ValueError(f"{at.commit} 裡找不到 {cid} 或它沒有 exception")
+    want = f"{cid}#{','.join(sorted(r['exception'].get('covers_kinds') or []))}"
+    if target != want:
+        raise ValueError(f"target 要寫成 {want}(護欄 id 加排序後的 covers_kinds)")
+    return {"control_id": cid, "control_revision": r.get("revision"), "inputs_sha256": _secev_inputs_sha(r),
+            "exception": r["exception"]}
+
+
+def _secapr_c_human(at, target):
+    cid, kind = ([*target.split("#", 1), ""])[:2]
+    its = [it for it in _secev_items_for(at.penv, at.idx.get(cid), {}) if it["kind"] == kind and it.get("reviewer_kind") == "human"]
+    if len(its) != 1:
+        raise ValueError(f"{cid} 的 {kind} 要恰好一項 reviewer_kind=human 的審查紀錄(找到 {len(its)} 項)")
+    return {k: its[0].get(k) for k in _SECEV_ITEM_KEYS if k in its[0]}
+
+
+def _secapr_c_tools(at, target):
+    t = _secev_tools_load(at.tree.read(_SECEV_TOOLS_REL), None, {})[0].get(target)
+    return {k: v for k, v in t.items() if not k.startswith("_")} if t else {}
+
+
+def _secapr_c_revision(at, target):
+    cid, dref = ([*target.split("|", 1), ""])[:2]
+    if not dref:
+        raise ValueError("revision 的 target 寫 <護欄 id>|<decision_ref>")
+    ml, _how, code = _secev_mainline(at.root, at.sha, _secev_config(at.tree.read(_SECEV_CONFIG_REL)))
+    if code or ml is None:
+        raise ValueError("認不出主線,算不出修訂之前的版本")
+    mrep = _secev_vault_report(at.root, _SecevTree(at.root, ml), _secinv_today(), None)[0]
+    old = _secev_index(mrep or {}).get(cid)
+    if old is None:
+        raise ValueError(f"主線版沒有 {cid}")
+    new = at.idx.get(cid)
+    content = {"control_id": cid, "before": _secev_state(old), "decision_ref": dref}
+    content.update({"removed": True} if new is None else {"after": _secev_state(new)})
+    return content
+
+
+_SECAPR_PLAIN = {"approvers_init": _secapr_c_keys, "approvers_add": _secapr_c_keys,
+                 "approvers_revoke": lambda root, typ, target, opts: ({"principal": target}, None),
+                 "gate_setting": _secapr_c_gate, "suppression": _secapr_c_suppression}
+_SECAPR_AT = {"exception": _secapr_c_exception, "human_review": _secapr_c_human, "tool_list_change": _secapr_c_tools,
+              "revision": _secapr_c_revision,
+              "consideration": lambda at, target: _seccell_consideration_content(at.prep, target)}
+
+
+def _secapr_content(root, typ, target, opts):
+    """要簽的內容(閘門比對時用同一套算法)→ (content 物件, keys 或 None)。依 type 分派:
+    不看提交的(金鑰、撤銷、gate、壓制)、帶 --content-file 的、要從提交盤點算的。"""
+    if typ in _SECAPR_PLAIN:
+        return _SECAPR_PLAIN[typ](root, typ, target, opts)
+    if opts.get("content_file"):
+        return _secev_loads(Path(opts["content_file"]).read_text(encoding="utf-8")), None
+    if typ not in _SECAPR_AT:
+        raise ValueError(f"{typ} 要帶 --content-file")
+    return _SECAPR_AT[typ](_SecaprAt(root, opts.get("commit") or "HEAD"), target), None
+
+
+def _secapr_cmd_verify(root, commit, as_json, today):
+    """security approvals verify:從頭驗整條鏈(對主線 tip 驗前綴)。退出 0=全數有效、1=有不算數或分岔、2=取不到提交。"""
+    sha = _lens_full_sha(root, commit or "HEAD")
+    if sha is None:
+        print(f"擋下:取不到提交 {commit or 'HEAD'}", file=sys.stderr)
+        return 2
+    tree = _SecevTree(root, sha)
+    ml, how, _code = _secev_mainline(root, sha, _secev_config(tree.read(_SECEV_CONFIG_REL)))
+    main_raw = _SecevTree(root, ml).read(_SECEV_APPROVALS_REL) if ml else None
+    chain = _secapr_verify(tree.read(_SECEV_APPROVALS_REL), main_raw, _secev_project_id(root, ml or sha), today)
+    view = dict(_secev_chain_view(chain), diverged=chain["diverged"], mainline=ml, mainline_how=how)
+    if as_json:
+        print(_json_text_escaped(view, indent=1))
+    else:
+        print(f"核可鏈 {_SECEV_APPROVALS_REL}(提交 {sha[:12]};主線 {ml[:12] if ml else '無'}):{len(view['entries'])} 筆")
+        if chain["diverged"]:
+            print("  ✗ 跟主線分岔:主線 tip 的鏈不是這一版的開頭一段;先把分支接上主線")
+        for e in view["entries"]:
+            print(f"  {e['seq']:>4} {e['status']:<32} {_secinv_show(str(e['type']))} {_secinv_show(str(e['target']), 120)}")
+        for k in view["keys"]:
+            print(f"  有效金鑰:{_secinv_show(k['principal'])} {k['fingerprint']}(到 {k['expires_on']})")
+        for w in view["warnings"]:
+            print(f"  提醒:{w}")
+    return 1 if chain["diverged"] or any(e["status"] != "ok" for e in view["entries"]) else 0
+
+
+def _secapr_payload_body(root, typ, target, signer, expires_on, opts, outcome, today):
+    """算好要簽的那一筆(seq、prev、project_id、content_sha256、approved_on);參數或內容不對丟 ValueError/OSError。"""
+    content, k = _secapr_content(root, typ, target, opts)
+    wt = Path(root) / _SECEV_APPROVALS_REL
+    seq, prev = _secapr_chain_position(wt.read_bytes() if wt.is_file() else None)
+    ml, _h, _c = _secev_mainline(root, "HEAD", _secev_config(None))
+    head = _lens_full_sha(root, "HEAD")
+    body = {"seq": seq, "prev_sha256": prev, "project_id": _secev_project_id(root, ml or head), "type": typ,
+            "target": target, "content_sha256": _secev_sha(_secev_canon(content)), "approved_on": today.isoformat(),
+            "expires_on": expires_on, "signer": signer}
+    if k is not None:
+        body["keys"] = k
+    if typ == "consideration" and outcome:
+        body["outcome"] = outcome
+    return body
+
+
+def cmd_security_approvals(sub_, repo=None, typ=None, target=None, signer=None, expires_on=None, keys=None,
+                           content_file=None, reason=None, out=None, commit=None, as_json=False, outcome=None):
+    """security approvals payload|verify(唯讀)。payload 印出要簽的那一筆(seq、prev_sha256、project_id、content_sha256、
+    approved_on 都由工具算好;approved_on 是當天 UTC 日期),verify 從頭驗整條鏈。"""
+    root = _secev_repo_root(repo)
+    if root is None:
+        print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
+        return 2
+    today = _secinv_today()
+    if sub_ == "verify":
+        return _secapr_cmd_verify(root, commit, as_json, today)
+    if typ not in _SECAPR_TYPES:
+        print(f"擋下:type 只收 {'、'.join(_SECAPR_TYPES)}", file=sys.stderr)
+        return 2
+    if not (signer and _secinv_is_text(target) and _secinv_date(expires_on)):
+        print("擋下:要帶 <type> <target> --signer <principal> --expires-on YYYY-MM-DD", file=sys.stderr)
+        return 2
+    opts = {"keys": keys, "content_file": content_file, "reason": reason, "commit": commit}
+    try:
+        raw = _secev_canon(_secapr_payload_body(root, typ, target, signer, expires_on, opts, outcome, today))
+        if out:
+            Path(out).write_bytes(raw)
+    except (OSError, ValueError) as e:
+        print(f"擋下:{_secinv_show(str(e))}", file=sys.stderr)
+        return 2
+    sys.stdout.write(raw.decode("utf-8") + "\n")
+    print(f"接下來:用你自己的金鑰簽這一份(工具拿不到私鑰):\n    ssh-keygen -Y sign -n {_SECAPR_NS} -f <私鑰> {out or '<上面那份存成的檔>'}\n"
+          f"簽好之後追加進核可鏈:\n    lumos code-loop security-approval-add {out or '<那份檔>'}", file=sys.stderr)
+    return 0
+
+
+def cmd_codeloop_security_approval_add(repo, payload_path, sig_path=None):
+    """code-loop security-approval-add <簽好的檔>:把那一筆接在工作目錄的核可鏈後面;用同一支驗證函式驗過「整條鏈加這一筆」
+    這一筆有效才寫入,驗不過不寫並說原因。第一筆 approvers_init 寫入前當場驗格式、金鑰類型與自簽。"""
+    root = _secev_repo_root(repo)
+    if root is None:
+        print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
+        return 2
+    try:
+        raw = Path(payload_path).read_bytes()
+        body = _secev_loads(raw.decode("utf-8"))
+        sig = Path(sig_path or (str(payload_path) + ".sig")).read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError, ValueError, RecursionError) as e:
+        print(f"擋下:讀不出那一筆或它的簽章:{_secinv_show(str(e))}", file=sys.stderr)
+        return 2
+    if not isinstance(body, dict) or raw.rstrip(b"\n") != _secev_canon(body):
+        print("擋下:簽的檔要是 security approvals payload 印出的規範化 JSON 原樣(不能改排版、加欄位)", file=sys.stderr)
+        return 2
+    wt = Path(root) / _SECEV_APPROVALS_REL
+    cur = wt.read_bytes() if wt.is_file() else b""
+    if cur and not cur.endswith(b"\n"):
+        cur += b"\n"
+    entry = dict(body, signature=sig.strip())
+    new = cur + json.dumps(entry, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
+    pid = body.get("project_id")
+    chain = _secapr_verify(new, None, pid, _secinv_today())
+    last = chain["entries"][-1] if chain["entries"] else None
+    if last is None or last["status"] != "ok":
+        print(f"擋下:這一筆接上之後驗不過({last['status'] if last else '空鏈'}),不寫入。"
+              "常見原因:金鑰打錯一個字、貼成私鑰、類型不收、簽的不是 payload 原檔、seq 或前一筆雜湊對不上(先重新跑 payload)。",
+              file=sys.stderr)
+        return 1
+    real_pid = _secev_project_id(root, _secev_mainline(root, "HEAD", _secev_config(None))[0] or _lens_full_sha(root, "HEAD"))
+    if pid != real_pid:
+        print("擋下:這一筆的 project_id 不是這個 repo 的根提交(從別的專案貼來?),不寫入", file=sys.stderr)
+        return 1
+    wt.parent.mkdir(parents=True, exist_ok=True)
+    with open(wt, "ab") as fh:
+        fh.write(new[len(cur):] if cur else new)
+    print(f"✓ 核可鏈第 {body['seq']} 筆已追加({_secinv_show(str(body['type']))} {_secinv_show(str(body['target']))});"
+          f"提交 {_SECEV_APPROVALS_REL} 之後閘門才讀得到")
+    for p, (t, k, x) in sorted(chain["keys"].items()):
+        print(f"  有效金鑰:{_secinv_show(p)} {_secapr_fingerprint(t, k)}(到 {x.isoformat()})")
+    return 0
+
+
+def cmd_codeloop_security_backing(repo, control_id, supersede=False):
+    """code-loop security-backing <護欄 id> [--supersede]:在本機讀 .kill-log.jsonl,把這條護欄的 guard kill 結果(配方組、
+    配方改到的檔、每次的 verdict)連同 head_sha 寫進受版控的 docs/.security-backing.jsonl。冪等鍵(護欄、種類、head_sha);
+    --supersede 寫一筆更正(帶 supersedes=被更正那一行的 sha256)。單行上限 4096 位元組,裝不下拒寫、不截斷。"""
+    import time as _t
+    root = _secev_repo_root(repo)
+    if root is None:
+        print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
+        return 2
+    head = _lens_full_sha(root, "HEAD")
+    tree = _SecevTree(root, head)
+    prep, penv, _v, _o = _secev_vault_report(root, tree, _secinv_today(), None)
+    rec = _secev_index(prep or {}).get(control_id)
+    if rec is None:
+        print(f"擋下:HEAD 裡找不到護欄 {_secinv_show(control_id)}", file=sys.stderr)
+        return 2
+    items = [it for it in _secev_items_for(penv, rec, {}) if it["format"] == "guard_kill"]
+    rids = sorted({r for it in items for r in it["targets"].get("recipe_ids") or []})
+    if not rids:
+        print(f"擋下:{_secinv_show(control_id)} 的證據圍欄沒有 format=guard_kill 的項或沒列 recipe_ids(要先在 Verification 寫好)",
+              file=sys.stderr)
+        return 2
+    rows = [r for r in _backing_kill_rows(root) if r["recipe_id"] in rids]
+    valid, why = _backing_valid_rows(root, head, rows, {}, _t.monotonic() + _BACKING_BUDGET) if rows else (None, "本機沒有對得上的 kill 紀錄")
+    groups = []
+    for rid in rids:
+        g = [r for r in (valid or []) if r["recipe_id"] == rid]
+        rec_file = (g[-1].get("_recipe") or {}).get("file") if g else None
+        groups.append({"recipe_id": rid, "files": [rec_file] if rec_file else [],
+                       "verdicts": [{"verdict": r["verdict"], "weak": r["weak"], "head_sha": r["head_sha"], "ts": r.get("ts", "")}
+                                    for r in g[-20:]]})
+    line = {"control_id": control_id, "control_revision": rec.get("revision"), "kind": "fault_sensitivity", "head_sha": head,
+            "groups": groups, "ts": _dt_now_iso()}
+    path = Path(root) / _SECEV_BACKING_REL
