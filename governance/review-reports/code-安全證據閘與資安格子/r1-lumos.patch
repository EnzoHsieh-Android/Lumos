+def _secev_vault_report(repo_root, tree, today, deadline):
+    """一版提交樹 → (盤點報告, env, 圖譜相對路徑, 超過單檔上限的 Verification 篇章) 或 (None, None, None, 錯誤說明)。"""
+    vs = tree.find_vaults()
+    if not vs:
+        return {"records": [], "retired": [], "excluded_business": [], "errors": [], "read_complete": True}, None, None, set()
+    if len(vs) > 1:
+        return None, None, None, "提交樹裡找到不只一個知識圖譜(" + "、".join(vs) + "),不猜"
+    snap = _secinv_snapshot_tree(repo_root, tree.sha, vs[0], tree=tree, deadline=deadline)
+    oversize = {e["node"] for e in snap["errors"] if e["kind"] == "file_too_large" and str(e["node"]).startswith("Verification/")}
+    keep = [e for e in snap["errors"] if not (e["kind"] == "file_too_large" and e["node"] in oversize)]
+    snap = dict(snap, errors=keep)
+    vault_path = Path(repo_root) / vs[0] if vs[0] else Path(repo_root)
+    rep, env = _secinv_build(vault_path, snap, today, want_env=True)
+    rep["_inv_holder"] = {"inv": rep.pop("_inventory", None)}     # 盤點區塊照 security list --json 的形狀輸出,inventory 另外拿
+    return rep, env, vs[0], oversize
+
+
+def _secev_index(rep):
+    """盤點報告 → {id: 記錄}(主清單、撤除、純業務都收;重複 ID 已是 registration_error)。"""
+    out = {}
+    for sec in ("records", "retired", "excluded_business"):
+        for r in rep.get(sec) or []:
+            out.setdefault(r["id"], r)
+    return out
+
+
+def _secev_active_sec(r):
+    return r is not None and r.get("lifecycle") == "active" and "security" in (r.get("concerns") or [])
+
+
+def _secev_revision_ok(ctx, cid, before, after_state):
+    """核可鏈上有沒有一筆有效的 revision 核可:target 是「護欄 id|decision_ref」,內容蓋住 before、after(或 removed)與 decision_ref;
+    decision_ref 要指到有效決策。before/after 是 {revision, inputs_sha256} 或 {"removed": True}。"""
+    for ent in ctx.chain.get("entries", []):
+        e = ent.get("entry") or {}
+        if ent["status"] != "ok" or e.get("type") != "revision" or not str(e.get("target", "")).startswith(cid + "|"):
+            continue
+        dref = e["target"][len(cid) + 1:]
+        content = {"control_id": cid, "before": before, "decision_ref": dref}
+        content.update({"removed": True} if after_state == {"removed": True} else {"after": after_state})
+        if e.get("content_sha256") == _secev_sha(_secev_canon(content)) and ctx.env is not None \
+                and _pq_decision_state(ctx.env, "", dref) == "ok":
+            return ent["seq"]
+    return None
+
+
+def _secev_state(r):
+    return {"revision": r.get("revision"), "inputs_sha256": _secev_inputs_sha(r)}
+
+
+def _secev_items_for(env, rec, cache):
+    """這條護欄在某一版的全部證據項(evidence_refs 指到的 Verification 篇章、control_id 相符)。"""
+    out = []
+    if env is None or rec is None:
+        return out
+    seen = set()
+    for ref in rec.get("evidence_refs") or []:
+        rel, _w = _secinv_node_rel(env, ref["node"])
+        if rel is None or rel in seen:
+            continue
+        seen.add(rel)
+        items, _p = _secev_fence_items(env, rel, cache)
+        out += [it for it in (items or []) if it.get("control_id") == rec["id"]]
+    return out
+
+
+def _secev_frozen(main_items, push_items):
+    """主線 tip 版有、推送版刪掉的項照樣算數,除非推送版有同 control、同 kind、同 targets 且 observed_at 更新的項取代它。"""
+    pc = {_secev_canon(it) for it in push_items}
+    out = []
+    for it in main_items:
+        if _secev_canon(it) in pc:
+            continue
+        tk = _secev_canon(it.get("targets"))
+        o = _secev_iso(it.get("observed_at"))
+        if any(p["kind"] == it["kind"] and _secev_canon(p.get("targets")) == tk and o is not None
+               and _secev_iso(p.get("observed_at")) is not None and _secev_iso(p["observed_at"]) > o for p in push_items):
+            continue
+        out.append(it)
+    return out
+
+
+def _secev_tool_weak(pt, mt, cats_push):
+    """同一個工具跟主線 tip 版比,哪裡變弱 → 說明清單(只新增工具、調高下限、收窄目標不算)。"""
+    if pt is None:
+        return [] if mt["category"] in cats_push else ["刪掉某工具類別的最後一個工具"]
+    weak = []
+    mr_m, mr_p = mt.get("min_requests") or {}, pt.get("min_requests") or {}
+    if isinstance(mr_m, dict) and any(not isinstance(mr_p, dict) or mr_p.get(k, 0) < v for k, v in mr_m.items()):
+        weak.append("min_requests 調低")
+    if mt.get("coverage_proof") != pt.get("coverage_proof"):
+        weak.append("覆蓋證明換了")
+    if set(pt.get("allowed_targets") or []) - set(mt.get("allowed_targets") or []):
+        weak.append("允許目標放寬")
+    return weak
+
+
+def _secev_tool_strict(pt, mt):
+    """沒核可的變弱:兩版取嚴(下限取大、覆蓋證明用主線版、目標取交集;刪掉的照主線那一列)。"""
+    if pt is None:
+        return mt
+    merged = dict(pt)
+    mr = dict(pt.get("min_requests") or {}) if isinstance(pt.get("min_requests"), dict) else {}
+    for k, v in (mt.get("min_requests") or {}).items():
+        mr[k] = max(mr.get(k, 0), v)
+    merged["min_requests"] = mr
+    merged["coverage_proof"] = mt.get("coverage_proof")
+    merged["allowed_targets"] = sorted(set(pt.get("allowed_targets") or []) & set(mt.get("allowed_targets") or []))
+    return merged
+
+
+def _secev_tool_freeze(push_tools, main_tools, ctx):
+    """工具清單跟主線 tip 版比變弱而沒有 tool_list_change 核可 → 照主線那一列判(兩版取嚴)。回 (合併後的清單, 變弱說明)。"""
+    out, notes = dict(push_tools), []
+    cats_push = {t["category"] for t in push_tools.values()}
+    for name, mt in main_tools.items():
+        pt = push_tools.get(name)
+        weak = _secev_tool_weak(pt, mt, cats_push)
+        if not weak:
+            continue
+        content = _secev_sha(_secev_canon({k: v for k, v in pt.items() if not k.startswith("_")} if pt else {}))
+        ok = ctx.approved("tool_list_change", name, content)
+        notes.append({"tool": name, "weakened": weak, "approved": ok})
+        if not ok:
+            out[name] = _secev_tool_strict(pt, mt)
+    return out, notes
+
+
+def _secev_budget_paths(ctx, work, over_items):
+    """要讀的證據檔 → 照(路徑、blob)排序的清單(同一份檔被多條護欄引用只列一次)。"""
+    paths = set()
+    for _rec, its in work:
+        for it in (x for x in its if id(x) not in over_items):
+            paths |= {(p, ctx.tree.oids[p]) for p in (it.get(k) for k in ("path", "coverage_path", "calibration_path"))
+                      if isinstance(p, str) and p in ctx.tree.files}
+    return sorted(paths)
+
+
+def _secev_budget_prepass(ctx, work):
+    """證據項總數上限與讀取總量上限(按不同 blob 算一次,固定照(路徑、blob)排序累加)。超過的項或檔判 evidence_too_large。"""
+    items = sorted(((rec["id"], it["kind"], str(it.get("path") or ""), id(it)) for rec, its in work for it in its))
+    over_items = {x[3] for x in items[_SECEV_ITEMS_MAX:]}
+    ordered = _secev_budget_paths(ctx, work, over_items)
+    sizes = _nodehome_cat_sizes(ctx.repo_root, [o for _p, o in ordered], _git_timeout(ctx.deadline, cap=60)) if ordered else []
+    if sizes is None:
+        raise RuntimeError("問證據檔大小時 git 失敗或逾時")
+    used, seen = 0, set()
+    for (p, o), n in zip(ordered, sizes):
+        if o in seen or n is None or n > _SECEV_FILE_MAX:
+            seen.add(o)
+            continue
+        seen.add(o)
+        if used + n > _SECEV_TOTAL_MAX:
+            ctx.over.add(p)
+        else:
+            used += n
+    return over_items
+
+
+def _secev_evaluate(repo_root, sha, *, pushed_branch=None, range_start=None, today=None, budget=None):
+    """安全證據判定(security evidence 與 code-loop check 共用這一支)→ 報告 dict。只讀提交樹,不讀工作目錄。
+    同一個提交、同一個主線 tip、同一個 UTC 日期 → 同一個答案(本機與 CI 也是)。"""
+    import time as _t
+    today = today or _secinv_today()
+    budget = _SECEV_BUDGET_SEC if budget is None else budget
+    deadline = _t.monotonic() + budget
+    full = _lens_full_sha(repo_root, sha) if sha else None
+    rep = _secev_skeleton(full or sha, today)
+    if full is None:
+        if _secev_worktree_trace(repo_root):
+            return _secev_finish(_secev_gate(rep, "commit_unavailable"))
+        rep["status"] = "no_registration"
+        return rep
+    stage = {"name": "讀要推的提交", "config_done": False}
+    try:
+        return _secev_evaluate_body(repo_root, full, rep, stage, pushed_branch, range_start, today, deadline)
+    except _SecevTimeout:
+        _secev_gate(rep, "evaluation_timeout", f"判到「{stage['name']}」時超過 {budget:g} 秒預算")
+    except Exception as e:      # 判不清就擋(計劃〈讀不可信資料〉:任何沒預期到的例外一律轉成擋下),不放行、不印 traceback
+        _secev_gate(rep, "evaluation_error", f"判到「{stage['name']}」時出錯:{e.__class__.__name__}: {str(e)[:160]}")
+    if not stage["config_done"]:
+        rep["gate_setting"]["effective"] = "block"
+        if rep["gate_setting"]["configured"] == "warn":
+            rep["gate_setting"]["reason"] = "錯誤發生在讀設定或驗核可鏈那一步,warn 這次無效"
+    _secev_finish(rep)
+    return rep
+
+
+class _SecevRun:
+    """一次整道判定的狀態(各階段函式共用)。tick 換階段名並查時間預算。"""
+
+    def __init__(self, repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline):
+        self.repo_root, self.sha, self.rep, self.stage = repo_root, sha, rep, stage
+        self.pushed_branch, self.range_start, self.today, self.deadline = pushed_branch, range_start, today, deadline
+        self.tree = self.mtree = self.chain = self.ml = self.mb = None
+        self.reps = {}
+
+    def tick(self, name):
+        import time as _t
+        self.stage["name"] = name
+        if _t.monotonic() > self.deadline:
+            raise _SecevTimeout()
+
+
+def _secev_no_registration(run):
+    """兩邊預檢都沒有登記痕跡:不判、不寫帳;只帶標籤的篇章另列一行提醒。"""
+    rep = run.rep
+    rep["status"] = "no_registration"
+    fl = _secev_git(run.repo_root, "grep", "-l", "-F", "--no-color", _SECINV_FLAG_TAG, run.sha, "--", "*.md")
+    tagged = [p.split(":", 1)[-1] for p in (fl.stdout.splitlines() if fl is not None and fl.returncode == 0 else [])]
+    if tagged:
+        rep["warnings"].append("有 flag/security-relevant 標籤但零條目的篇章(不算登記痕跡、不擋):" + "、".join(tagged[:10]))
+    return rep
+
+
+def _secev_stage_head(run):
+    """設定、主線、預檢、merge-base、核可鏈與 gate 設定、淺層 clone → 整道結束就回報告,否則 None。"""
+    rep = run.rep
+    run.tree = _SecevTree(run.repo_root, run.sha)
+    cfg = _secev_config(run.tree.read(_SECEV_CONFIG_REL, deadline=run.deadline))
+    rep["warnings"] += cfg["warnings"]
+    run.tick("認主線")
+    run.ml, how, mlcode = _secev_mainline(run.repo_root, run.sha, cfg, run.pushed_branch, run.range_start, run.deadline)
+    rep["mainline"] = {"sha": run.ml, "how": how}
+    run.tick("預檢登記痕跡")
+    if _secev_grep_trace(run.repo_root, run.sha) is False and (not run.ml or _secev_grep_trace(run.repo_root, run.ml) is False):
+        return _secev_no_registration(run)
+    if mlcode:
+        return _secev_finish(_secev_gate(rep, mlcode, how))
+    run.tick("檢查淺層 clone")
+    shallow = _git_is_shallow(run.repo_root, timeout=20)
+    if run.ml:
+        r = _secev_git(run.repo_root, "merge-base", run.sha, run.ml)
+        if r is None:
+            raise RuntimeError("算 merge-base 時 git 失敗或逾時")
+        run.mb = r.stdout.strip() if r.returncode == 0 and _LENS_SHA_RE.match(r.stdout.strip()) else None
+    rep["merge_base"] = run.mb
+    done = _secev_stage_chain(run, cfg)
+    if done is not None:
+        return done
+    if shallow:
+        _secev_gate(rep, "shallow_clone")
+        if run.mtree is None or not run.mtree.files:
+            rep["gate_setting"]["effective"] = "block"
+        return _secev_finish(rep)
+    if run.ml and run.mb is None:
+        return _secev_finish(_secev_gate(rep, "freeze_base_unavailable"))
+    return None
+
+
+def _secev_stage_chain(run, cfg):
+    """核可鏈(推送版對主線 tip 版驗前綴、從頭重算)與 gate 設定(warn 要有效的 gate_setting 核可)。鏈分岔 → 整道結束。"""
+    rep = run.rep
+    run.tick("驗核可鏈")
+    run.mtree = _SecevTree(run.repo_root, run.ml) if run.ml else None
+    pid = _secev_project_id(run.repo_root, run.ml or run.sha)
+    main_chain = run.mtree.read(_SECEV_APPROVALS_REL, deadline=run.deadline) if run.mtree else None
+    run.chain = _secapr_verify(run.tree.read(_SECEV_APPROVALS_REL, deadline=run.deadline), main_chain, pid, run.today)
+    rep["approvals"] = _secev_chain_view(run.chain)
+    if run.chain["diverged"]:
+        return _secev_finish(_secev_gate(rep, "approvals_diverged"))
+    gs = rep["gate_setting"]
+    gs["configured"] = cfg["mode"]
+    if cfg["mode"] == "warn":
+        if _secapr_lookup(run.chain, "gate_setting", "security_evidence.gate", _secev_sha(_secev_canon({"value": "warn"})))[0] == "ok":
+            gs["effective"] = "warn"
+        else:
+            gs["reason"] = "security_evidence.gate 設成 warn,但核可鏈上沒有有效的 gate_setting 核可(沒有、過期或驗不過),照 block 判"
+    run.stage["config_done"] = True
+    return None
+
+
+def _secev_reg_errors(prep, poversize):
+    """整道 registration_error 要算的登記錯誤:來源決策失效歸得到單一護欄(落到護欄層 source_decision_invalid)、
+    Verification 太大(引用它的證據判 evidence_node_too_large)這兩種不算。"""
+    return [e for e in prep["errors"] if not (e.get("kind") == "reference_error" and e.get("field") == "source"
+                                              and str(e.get("detail", "")).startswith("decision_ref:"))
+            and not (poversize and e.get("kind") == "reference_error" and e.get("field") == "evidence_refs"
+                     and e.get("detail") == "這篇讀不到")]
+
+
+def _secev_stage_reports(run):
+    """三版盤點(推送版、merge-base 版、主線 tip 版)→ 整道結束就回報告,否則 None。"""
+    rep = run.rep
+    run.tick("讀三版盤點")
+    btree = _SecevTree(run.repo_root, run.mb) if run.mb else None
+    for name, tr in (("push", run.tree), ("base", btree), ("main", run.mtree)):
+        if tr is None:
+            run.reps[name] = (None, None, set(), None)
+            continue
+        r, env, _vrel, extra = _secev_vault_report(run.repo_root, tr, run.today, run.deadline)
+        if r is None:
+            return _secev_finish(_secev_gate(rep, "read_incomplete", f"{name} 版:{extra}"))
+        run.reps[name] = (r, env, extra, (r.pop("_inv_holder", None) or {}).get("inv"))
+    prep = run.reps["push"][0]
+    rep["inventory_report"] = prep
+    rep["inventory"] = {"read_complete": prep["read_complete"], "registration_complete": prep.get("registration_complete"),
+                        "errors": len(prep["errors"]), "security_verdict": "not_assessed"}
+    if not any(v[0] is not None and _secev_trace_in(v[0]) for v in run.reps.values()):
+        rep["status"] = "no_registration"
+        if prep.get("unregistered_nodes"):
+            rep["warnings"].append("有 flag/security-relevant 標籤但零條目的節點:" + "、".join(prep["unregistered_nodes"][:10]))
+        return rep
+    bad = next((n for n in ("push", "base", "main") if run.reps[n][0] is not None and not run.reps[n][0]["read_complete"]), None)
+    if bad:
+        return _secev_finish(_secev_gate(rep, "read_incomplete", f"{bad} 版的盤點讀取不完整"))
+    reg_errs = _secev_reg_errors(prep, run.reps["push"][2])
+    if reg_errs:
+        return _secev_finish(_secev_gate(rep, "registration_error", "盤點 errors 有 " + str(len(reg_errs)) + " 筆(security list 看細節)"))
+    return None
+
+
+def _secev_stage_ctx(run):
+    """配套、工具清單(跟主線比變弱)、提交時間 → 判定上下文;配套缺檔 → None(整道 toolchain_incomplete)。"""
+    tq = _secev_tq()
+    if tq is None:
+        return None
+    run.tick("讀工具清單")
+    penv = run.reps["push"][1]
+    cache = {}
+    ptools, perr = _secev_tools_load(run.tree.read(_SECEV_TOOLS_REL, deadline=run.deadline), penv, cache)
+    if perr:
+        run.rep["warnings"].append(perr)
+    mtools = _secev_tools_load(run.mtree.read(_SECEV_TOOLS_REL, deadline=run.deadline), run.reps["main"][1], {})[0] if run.mtree else {}
+    cdate = _secev_git(run.repo_root, "log", "-1", "--format=%cI", run.sha)
+    committer = _secev_iso((cdate.stdout.strip() if cdate is not None and cdate.returncode == 0 else "").replace("Z", "+00:00"))
+    ctx = _SecevCtx(run.repo_root, run.tree, run.today, run.deadline, tq, ptools, run.chain, committer, penv)
+    ctx._facts = cache
+    ctx.tools, run.rep["freeze"]["tool_list"] = _secev_tool_freeze(ptools, mtools, ctx)
+    homes = {}
+
+    def home_about(node):
+        if node not in homes:
+            n = penv.notes.get(node) if penv else None
+            homes[node] = [str(x) for x in as_list(n.fields.get("about_code"))] if n is not None else []
+        return homes[node]
+    ctx.home_about = home_about
+    return ctx
+
+
+def _secev_freeze_kept(run, ctx, cid, pr, olds_in):
+    """推送版還是 active 資安的護欄:跟另外兩版比變弱而沒有 revision 核可 → 照嚴的那版(集合取聯集、表版號取最低種類多的)。"""
+    freeze = run.rep["freeze"]
+    olds = []
+    for name, o in olds_in:
+        w = _secev_weaker(pr, o, ctx.tools) if _secev_active_sec(o) else []
+        if not w:
+            continue
+        seq = _secev_revision_ok(ctx, cid, _secev_state(o), _secev_state(pr))
+        if seq:
+            freeze["approved_revisions"].append({"id": cid, "against": name, "fields": w, "approval_seq": seq})
+            continue
+        freeze["weakened"].append({"id": cid, "against": name, "fields": w})
+        olds.append(o)
+    if not olds:
+        return pr, {}
+    rec, missing = _secev_strict_merge(pr, olds)
+    rec["threat_table_version"] = max([pr, *olds], key=lambda x: len(_secev_min_kinds(x, ctx.tools)[0] or ())).get("threat_table_version")
+    return rec, missing
+
+
+def _secev_freeze_removed(run, ctx, cid, pr, br, mr):
+    """推送版沒有、降級或拿掉 security 的護欄:有 revision 核可(after=removed 或推送版的樣子)→ 不當必驗;否則照較新那版當必驗。"""
+    newer = mr if _secev_active_sec(mr) else br
+    after = {"removed": True} if pr is None else _secev_state(pr)
+    seq = _secev_revision_ok(ctx, cid, _secev_state(newer), after)
+    if seq:
+        run.rep["freeze"]["approved_revisions"].append({"id": cid, "against": "removed", "approval_seq": seq})
+        return None
+    why = ("主線新增了這條,先接上主線" if not _secev_active_sec(br) and _secev_active_sec(mr)
+           else "推送版刪掉、降成 candidate/retired 或拿掉 security 關注面,核可鏈上沒有有效的 revision 核可")
+    run.rep["freeze"]["removed"].append({"id": cid, "why": why})
+    return (newer, cid, why, {})
+
+
+def _secev_stage_freeze(run, ctx, idx):
+    """必驗集合=三版 active 資安條目的聯集;逐條決定照哪一版判 → [(記錄, id, 被刪的說明或 None, 少掉的列)]。"""
+    run.tick("凍結比對")
+    ids = sorted({i for n in ("push", "base", "main") for i, r in idx[n].items() if _secev_active_sec(r)})
+    work = []
+    for cid in ids:
+        pr, br, mr = idx["push"].get(cid), idx["base"].get(cid), idx["main"].get(cid)
+        if _secev_active_sec(pr):
+            rec, missing = _secev_freeze_kept(run, ctx, cid, pr, (("merge-base", br), ("主線 tip", mr)))
+            work.append((rec, cid, None, missing))
+            continue
+        w = _secev_freeze_removed(run, ctx, cid, pr, br, mr)
+        if w:
+            work.append(w)
+    return work
+
+
+def _secev_stage_judge(run, ctx, idx, work):
+    """凍結的證據項、額度預先算、逐條判必驗集合與候選、格子(驗過核可鏈)。"""
+    rep, penv, poversize = run.rep, run.reps["push"][1], run.reps["push"][2]
+    menv = run.reps["main"][1]
+    frozen, all_items = {}, []
+    for rec, cid, removed, _m in work:
+        pitems = _secev_items_for(penv, idx["push"].get(cid) if not removed else None, ctx._facts)
+        frozen[cid] = _secev_frozen(_secev_items_for(menv, idx["main"].get(cid), ctx._facts) if menv else [], pitems)
+        all_items.append((rec, pitems + frozen[cid]))
+    ctx.over_items = _secev_budget_prepass(ctx, all_items)
+    run.tick("逐條判定")
+    for rec, cid, removed, missing in work:
+        run.tick(f"判護欄 {cid}")
+        env_for = penv if not removed else (menv if _secev_active_sec(idx["main"].get(cid)) else run.reps["base"][1])
+        j = _secev_judge_control(rec, ctx, env_for, frozen[cid], removed=removed, missing_rows=missing, oversize=poversize)
+        j["mandatory"] = True
+        rep["controls"].append(j)
+    for _cid, r in sorted(idx["push"].items()):
+        if r.get("lifecycle") == "candidate" and "security" in (r.get("concerns") or []):
+            rep["candidates"].append(_secev_candidate(run, ctx, r))
+    run.tick("算格子")
+    rep["cells"], rep["cell_errors"], _pend = _seccell_compute(run.reps["push"][3], idx["push"].values(),
+                                                              run.reps["push"][0].get("considerations") or [],
+                                                              counted=lambda cid, row: _secev_consideration_counted(ctx, penv, cid, row))
+    rep["reminders"] += ctx.reminders
+    rep["parse_count"] = ctx.parse_count
+
+
+def _secev_candidate(run, ctx, r):
+    """candidate 照樣判給人看(不進必驗集合、不擋);放超過 30 天標出(d12)。"""
+    j = _secev_judge_control(r, ctx, run.reps["push"][1], [], oversize=run.reps["push"][2])
+    j["mandatory"] = False
+    age = _secev_candidate_age(run.repo_root, run.sha, r, run.reps["push"][0], run.today)
+    if age is not None and age > _SECEV_CANDIDATE_DAYS:
+        j["notes"].append(f"candidate 已放 {age} 天(超過 {_SECEV_CANDIDATE_DAYS} 天),該轉 active 或撤掉")
+        j["candidate_overdue"] = True
+    return j
+
+
+def _secev_evaluate_body(repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline):
+    """整道判定的階段:開頭(設定、主線、預檢、核可鏈)→ 三版盤點 → 上下文(配套、工具清單)→ 凍結比對 → 逐條判定。"""
+    run = _SecevRun(repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline)
+    done = _secev_stage_head(run)
+    if done is None:
+        done = _secev_stage_reports(run)
+    if done is not None:
+        return done
+    ctx = _secev_stage_ctx(run)
+    if ctx is None:
+        return _secev_finish(_secev_gate(rep, "toolchain_incomplete"))
+    idx = {n: (_secev_index(v[0]) if v[0] else {}) for n, v in run.reps.items()}
+    work = _secev_stage_freeze(run, ctx, idx)
+    _secev_stage_judge(run, ctx, idx, work)
+    return _secev_finish(rep)
+
+
+def _secev_consideration_counted(ctx, env, cid, row):
+    """一列 considerations 算不算數(驗核可鏈):鏈上 type=consideration、target=格子 id 有有效的一筆、內容雜湊蓋住整列;
+    核可決策有效;risk_accepted 最長 30 天(31 天起無效)、到期日要等於鏈上那一筆;not_applicable 最長 180 天;到期日當天有效、隔天回到 open。"""
+    st, e = _secapr_lookup(ctx.chain, "consideration", cid, _secev_sha(_secev_canon(row)))
+    if st != "ok" or _secinv_decision_problem(env, row.get("decision_ref"), ctx._facts):
+        return False
+    ap, ex = _secinv_date(e["approved_on"]), _secinv_date(e["expires_on"])
+    if row["outcome"] == "risk_accepted":
+        if row.get("expires_on") != e["expires_on"] or (ex - ap).days > 30:
+            return False
+    elif (ex - ap).days > 180:
+        return False
+    if ex < ctx.today:
+        return False
+    if (ex - ctx.today).days <= _SECEV_REMIND_DAYS:
+        ctx.remind(f"格子 {cid} 的 {row['outcome']} {ex.isoformat()} 到期")
+    return True
+
+
+def _seccell_consideration_content(prep, target):
+    """security approvals payload consideration <格子 id>:那一列 considerations 的全部鍵(閘門比對時算同一份雜湊)。"""
+    for cr in prep.get("considerations") or []:
+        c = cr.get("raw")
+        if not isinstance(c, dict) or _seccell_cons_problem(c):
+            continue
+        tbl = _sectt_table(_sectt_current()) or {}
+        act = c.get("actor") if (tbl.get(c["category"]) or {}).get("has_actor") else None
+        if _seccell_id(c["surface"], c["asset"], c["category"], act) == target:
+            return c
+    raise ValueError(f"找不到格子 {target} 的 considerations 列")
+
+
+def _secev_candidate_age(repo_root, sha, r, prep, today):
+    """candidate 放了幾天:revision 是 YYYY-MM-DD 就用它,否則用家節點在這個提交上最後一次改動的提交日期。"""
+    import datetime as _dt
+    d = _secinv_date(str(r.get("revision") or ""))
+    if d is None:
+        rr = _secev_git(repo_root, "log", "-1", "--format=%cI", sha, "--", "*" + str(r.get("node") or ""))
+        dt = _secev_iso(rr.stdout.strip()) if rr is not None and rr.returncode == 0 and rr.stdout.strip() else None
+        d = dt.astimezone(_dt.timezone.utc).date() if dt else None
+    return (today - d).days if d else None
+
+
+def _secev_chain_view(chain):
+    return {"entries": [{"seq": e["seq"], "type": e["type"], "target": e["target"],
+                         "status": "ok" if e["status"] == "ok" else f"approval:{e['status']}"} for e in chain["entries"]],
+            "keys": [{"principal": p, "fingerprint": _secapr_fingerprint(t, k), "expires_on": x.isoformat()}
+                     for p, (t, k, x) in sorted(chain["keys"].items())],
+            "warnings": list(chain["warnings"])}
+
+
+def _secev_finish(rep):
+    """擋不擋:整道代碼或必驗集合裡有 unsound;gate_setting=warn 有效而且這個整道代碼可以降級時照算照印、不擋。"""
+    blocking = []
+    for j in rep["controls"]:
+        if j.get("mandatory") and j.get("verdict") == "unsound":
+            for c in j["control_codes"]:
+                blocking.append({"id": j["id"], "kind": "護欄", "code": c})
+            for k in j["kinds"]:
+                if k["verdict"] != "qualified" and not k.get("excepted"):
+                    first = next((it for it in k["items"] if it.get("verdict") != "qualified"), {})
+                    blocking.append({"id": j["id"], "kind": k["kind"], "code": (k["codes"] or [k["verdict"]])[0],
+                                     "path": first.get("path")})
+    rep["blocking"] = blocking
+    hard = bool(rep["gate_code"]) or bool(blocking)
+    gs = rep["gate_setting"]
+    warn_ok = gs["effective"] == "warn" and (not rep["gate_code"] or _SECEV_WARN_OK.get(rep["gate_code"], False))
+    if gs["effective"] == "warn" and rep["gate_code"] and not _SECEV_WARN_OK.get(rep["gate_code"], False):
+        gs["reason"] = f"整道代碼 {rep['gate_code']} 不能降級,warn 這次無效"
+    rep["blocked"] = hard and not warn_ok
+    rep["warned_only"] = hard and warn_ok
+    return rep
+
+
+def _secev_grep_trace(repo_root, sha):
+    """廉價預檢:先一次 git grep 找提到 lumos-security-v1 的 .md;命中的那幾篇再照盤點的嚴格讀法(_secinv_blocks)看
+    有沒有真的圍欄或變體(散文裡提到這個字樣不算痕跡)。回 True/False/None(git 失敗,當成可能有)。"""
+    r = _secev_git(repo_root, "grep", "-l", "-z", "-F", "--no-color", _SECINV_MARK, sha, "--", "*.md")
+    if r is None:
+        return None
+    if r.returncode == 1:
+        return False
+    if r.returncode != 0:
+        return None
+    pre = sha + ":"
+    paths = [p.removeprefix(pre) for p in r.stdout.split("\0") if p]
+    if not paths:
+        return False
+    got = _nodehome_cat_blobs_capped(repo_root, [f"{sha}:{p}" for p in paths], _VAULT_SAFE_FILE_MAX)
+    if got is None:
+        return None
+    for p, b in zip(paths, got):
+        if b is None:
+            return True             # 讀不到(太大、特殊檔):交給完整快照判
+        try:
+            text = b.decode("utf-8")
+        except UnicodeDecodeError:
+            return True
+        blocks, errs = _secinv_blocks(p, text)
+        if blocks or errs:
+            return True
+    return False
+
+
+def _secev_show_code(c):
+    return _secinv_show(c, 200)
