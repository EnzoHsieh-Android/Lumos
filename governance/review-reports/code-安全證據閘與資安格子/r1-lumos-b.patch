+def _secev_sarif_calibration(it, ctx, rules, facts):
+    """掃描類的校準:同工具同版本、對每一條宣告規則都命中 → None;否則 uncalibrated 的代碼。"""
+    cp = it.get("calibration_path")
+    craw = ctx.read(cp)[0] if cp else None
+    cf, cwhy = (None, "calibration_missing") if craw is None else _secev_sarif_facts(craw, set(rules))
+    if cwhy:
+        return "calibration_missing"
+    if sorted(cf["drivers"]) != sorted(facts["drivers"]):
+        return "calibration_version_mismatch"
+    if set(rules) - {h["rule"] for h in cf["hits"]}:
+        return "calibration_rule_missing"
+    return None
+
+
+def _secev_judge_sarif(it, raw, ctx, tool):
+    """掃描類 SARIF:跑過(結構合格)→ 工具與版本 → 覆蓋證明 → 命中與處置(failed)→ 校準(uncalibrated)。"""
+    rules = it["targets"].get("rules") or []
+    if not rules:
+        return ["targets_empty"]
+    facts, why = ctx.cached(("sarif", it["path"], tuple(rules)), lambda: _secev_sarif_facts(raw, set(rules)))
+    if why:
+        return [why]
+    probs = []
+    if tool is not None and not any(n == tool["name"] and v == tool["version"] for n, v in facts["drivers"]):
+        probs.append("tool_version_mismatch")
+    proof = tool.get("coverage_proof") if tool else None
+    cr = ctx.read(it["coverage_path"])[0] if proof in _SECEV_COVERAGE_PROOFS else None
+    if cr is None or not _secev_coverage_ok(proof, cr):
+        probs.append("coverage_unproven")
+    unresolved = [h for h in facts["hits"] if not ctx.approved("suppression", f"{h['rule']}#{h['location_sha256']}", None, loose=True)]
+    if unresolved:
+        probs.append("finding_unresolved")
+        ctx.note(it, "unresolved_findings", [{"rule": h["rule"], "uri": h["uri"], "line": h["line"],
+                                               "location_sha256": h["location_sha256"]} for h in unresolved[:50]])
+    cal = _secev_sarif_calibration(it, ctx, rules, facts)
+    return probs + ([cal] if cal else [])
+
