+def _secev_evaluate(repo_root, sha, *, pushed_branch=None, range_start=None, today=None, budget=None):
+    """安全證據判定(security evidence 與 code-loop check 共用這一支)→ 報告 dict。只讀提交樹,不讀工作目錄。
+    同一個提交、同一個主線 tip、同一個 UTC 日期 → 同一個答案(本機與 CI 也是)。"""
+    import time as _t
+    today = today or _secinv_today()
+    budget = _SECEV_BUDGET_SEC if budget is None else budget
+    deadline = _t.monotonic() + budget
+    full = _lens_full_sha(repo_root, sha) if sha else None
+    rep = _secev_skeleton(full or sha, today)
+    if full is None:
+        if _secev_worktree_trace(repo_root):
+            return _secev_finish(_secev_gate(rep, "commit_unavailable"))
+        rep["status"] = "no_registration"
+        return rep
+    stage = {"name": "讀要推的提交", "config_done": False}
+    try:
+        return _secev_evaluate_body(repo_root, full, rep, stage, pushed_branch, range_start, today, deadline)
+    except _SecevTimeout:
+        _secev_gate(rep, "evaluation_timeout", f"判到「{stage['name']}」時超過 {budget:g} 秒預算")
+    except Exception as e:      # 判不清就擋(計劃〈讀不可信資料〉:任何沒預期到的例外一律轉成擋下),不放行、不印 traceback
+        _secev_gate(rep, "evaluation_error", f"判到「{stage['name']}」時出錯:{e.__class__.__name__}: {str(e)[:160]}")
+    if not stage["config_done"]:
+        rep["gate_setting"]["effective"] = "block"
+        if rep["gate_setting"]["configured"] == "warn":
+            rep["gate_setting"]["reason"] = "錯誤發生在讀設定或驗核可鏈那一步,warn 這次無效"
+    _secev_finish(rep)
+    return rep
+
+
+class _SecevRun:
+    """一次整道判定的狀態(各階段函式共用)。tick 換階段名並查時間預算。"""
+
+    def __init__(self, repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline):
+        self.repo_root, self.sha, self.rep, self.stage = repo_root, sha, rep, stage
+        self.pushed_branch, self.range_start, self.today, self.deadline = pushed_branch, range_start, today, deadline
+        self.tree = self.mtree = self.chain = self.ml = self.mb = None
+        self.reps = {}
+
+    def tick(self, name):
+        import time as _t
+        self.stage["name"] = name
+        if _t.monotonic() > self.deadline:
+            raise _SecevTimeout()
+
+
+def _secev_no_registration(run):
+    """兩邊預檢都沒有登記痕跡:不判、不寫帳;只帶標籤的篇章另列一行提醒。"""
+    rep = run.rep
+    rep["status"] = "no_registration"
+    fl = _secev_git(run.repo_root, "grep", "-l", "-F", "--no-color", _SECINV_FLAG_TAG, run.sha, "--", "*.md")
+    tagged = [p.split(":", 1)[-1] for p in (fl.stdout.splitlines() if fl is not None and fl.returncode == 0 else [])]
+    if tagged:
+        rep["warnings"].append("有 flag/security-relevant 標籤但零條目的篇章(不算登記痕跡、不擋):" + "、".join(tagged[:10]))
+    return rep
+
+
+def _secev_stage_head(run):
+    """設定、主線、預檢、merge-base、核可鏈與 gate 設定、淺層 clone → 整道結束就回報告,否則 None。"""
+    rep = run.rep
+    run.tree = _SecevTree(run.repo_root, run.sha)
+    cfg = _secev_config(run.tree.read(_SECEV_CONFIG_REL, deadline=run.deadline))
+    rep["warnings"] += cfg["warnings"]
+    run.tick("認主線")
+    run.ml, how, mlcode = _secev_mainline(run.repo_root, run.sha, cfg, run.pushed_branch, run.range_start, run.deadline)
+    rep["mainline"] = {"sha": run.ml, "how": how}
+    run.tick("預檢登記痕跡")
+    if _secev_grep_trace(run.repo_root, run.sha) is False and (not run.ml or _secev_grep_trace(run.repo_root, run.ml) is False):
+        return _secev_no_registration(run)
+    if mlcode:
+        return _secev_finish(_secev_gate(rep, mlcode, how))
+    run.tick("檢查淺層 clone")
+    shallow = _git_is_shallow(run.repo_root, timeout=20)
+    if run.ml:
+        r = _secev_git(run.repo_root, "merge-base", run.sha, run.ml)
+        if r is None:
+            raise RuntimeError("算 merge-base 時 git 失敗或逾時")
+        run.mb = r.stdout.strip() if r.returncode == 0 and _LENS_SHA_RE.match(r.stdout.strip()) else None
+    rep["merge_base"] = run.mb
+    done = _secev_stage_chain(run, cfg)
+    if done is not None:
+        return done
+    if shallow:
+        _secev_gate(rep, "shallow_clone")
+        if run.mtree is None or not run.mtree.files:
+            rep["gate_setting"]["effective"] = "block"
+        return _secev_finish(rep)
+    if run.ml and run.mb is None:
+        return _secev_finish(_secev_gate(rep, "freeze_base_unavailable"))
+    return None
+
+
+def _secev_stage_chain(run, cfg):
+    """核可鏈(推送版對主線 tip 版驗前綴、從頭重算)與 gate 設定(warn 要有效的 gate_setting 核可)。鏈分岔 → 整道結束。"""
+    rep = run.rep
+    run.tick("驗核可鏈")
+    run.mtree = _SecevTree(run.repo_root, run.ml) if run.ml else None
+    pid = _secev_project_id(run.repo_root, run.ml or run.sha)
+    main_chain = run.mtree.read(_SECEV_APPROVALS_REL, deadline=run.deadline) if run.mtree else None
+    run.chain = _secapr_verify(run.tree.read(_SECEV_APPROVALS_REL, deadline=run.deadline), main_chain, pid, run.today)
+    rep["approvals"] = _secev_chain_view(run.chain)
+    if run.chain["diverged"]:
+        return _secev_finish(_secev_gate(rep, "approvals_diverged"))
+    gs = rep["gate_setting"]
+    gs["configured"] = cfg["mode"]
+    if cfg["mode"] == "warn":
+        if _secapr_lookup(run.chain, "gate_setting", "security_evidence.gate", _secev_sha(_secev_canon({"value": "warn"})))[0] == "ok":
+            gs["effective"] = "warn"
+        else:
+            gs["reason"] = "security_evidence.gate 設成 warn,但核可鏈上沒有有效的 gate_setting 核可(沒有、過期或驗不過),照 block 判"
+    run.stage["config_done"] = True
+    return None
+
+
+def _secev_reg_errors(prep, poversize):
+    """整道 registration_error 要算的登記錯誤:來源決策失效歸得到單一護欄(落到護欄層 source_decision_invalid)、
+    Verification 太大(引用它的證據判 evidence_node_too_large)這兩種不算。"""
+    return [e for e in prep["errors"] if not (e.get("kind") == "reference_error" and e.get("field") == "source"
+                                              and str(e.get("detail", "")).startswith("decision_ref:"))
+            and not (poversize and e.get("kind") == "reference_error" and e.get("field") == "evidence_refs"
+                     and e.get("detail") == "這篇讀不到")]
+
+
+def _secev_stage_reports(run):
+    """三版盤點(推送版、merge-base 版、主線 tip 版)→ 整道結束就回報告,否則 None。"""
+    rep = run.rep
+    run.tick("讀三版盤點")
+    btree = _SecevTree(run.repo_root, run.mb) if run.mb else None
+    for name, tr in (("push", run.tree), ("base", btree), ("main", run.mtree)):
+        if tr is None:
+            run.reps[name] = (None, None, set(), None)
+            continue
+        r, env, _vrel, extra = _secev_vault_report(run.repo_root, tr, run.today, run.deadline)
+        if r is None:
+            return _secev_finish(_secev_gate(rep, "read_incomplete", f"{name} 版:{extra}"))
+        run.reps[name] = (r, env, extra, (r.pop("_inv_holder", None) or {}).get("inv"))
+    prep = run.reps["push"][0]
+    rep["inventory_report"] = prep
+    rep["inventory"] = {"read_complete": prep["read_complete"], "registration_complete": prep.get("registration_complete"),
+                        "errors": len(prep["errors"]), "security_verdict": "not_assessed"}
+    if not any(v[0] is not None and _secev_trace_in(v[0]) for v in run.reps.values()):
+        rep["status"] = "no_registration"
+        if prep.get("unregistered_nodes"):
+            rep["warnings"].append("有 flag/security-relevant 標籤但零條目的節點:" + "、".join(prep["unregistered_nodes"][:10]))
+        return rep
+    bad = next((n for n in ("push", "base", "main") if run.reps[n][0] is not None and not run.reps[n][0]["read_complete"]), None)
+    if bad:
+        return _secev_finish(_secev_gate(rep, "read_incomplete", f"{bad} 版的盤點讀取不完整"))
+    reg_errs = _secev_reg_errors(prep, run.reps["push"][2])
+    if reg_errs:
+        return _secev_finish(_secev_gate(rep, "registration_error", "盤點 errors 有 " + str(len(reg_errs)) + " 筆(security list 看細節)"))
+    return None
+
+
+def _secev_stage_ctx(run):
+    """配套、工具清單(跟主線比變弱)、提交時間 → 判定上下文;配套缺檔 → None(整道 toolchain_incomplete)。"""
+    tq = _secev_tq()
+    if tq is None:
+        return None
+    run.tick("讀工具清單")
+    penv = run.reps["push"][1]
+    cache = {}
+    ptools, perr = _secev_tools_load(run.tree.read(_SECEV_TOOLS_REL, deadline=run.deadline), penv, cache)
+    if perr:
+        run.rep["warnings"].append(perr)
+    mtools = _secev_tools_load(run.mtree.read(_SECEV_TOOLS_REL, deadline=run.deadline), run.reps["main"][1], {})[0] if run.mtree else {}
+    cdate = _secev_git(run.repo_root, "log", "-1", "--format=%cI", run.sha)
+    committer = _secev_iso((cdate.stdout.strip() if cdate is not None and cdate.returncode == 0 else "").replace("Z", "+00:00"))
+    ctx = _SecevCtx(run.repo_root, run.tree, run.today, run.deadline, tq, ptools, run.chain, committer, penv)
+    ctx._facts = cache
+    ctx.tools, run.rep["freeze"]["tool_list"] = _secev_tool_freeze(ptools, mtools, ctx)
+    homes = {}
+
+    def home_about(node):
+        if node not in homes:
+            n = penv.notes.get(node) if penv else None
+            homes[node] = [str(x) for x in as_list(n.fields.get("about_code"))] if n is not None else []
+        return homes[node]
+    ctx.home_about = home_about
+    return ctx
+
+
+def _secev_freeze_kept(run, ctx, cid, pr, olds_in):
+    """推送版還是 active 資安的護欄:跟另外兩版比變弱而沒有 revision 核可 → 照嚴的那版(集合取聯集、表版號取最低種類多的)。"""
+    freeze = run.rep["freeze"]
+    olds = []
+    for name, o in olds_in:
+        w = _secev_weaker(pr, o, ctx.tools) if _secev_active_sec(o) else []
+        if not w:
+            continue
+        seq = _secev_revision_ok(ctx, cid, _secev_state(o), _secev_state(pr))
+        if seq:
+            freeze["approved_revisions"].append({"id": cid, "against": name, "fields": w, "approval_seq": seq})
+            continue
+        freeze["weakened"].append({"id": cid, "against": name, "fields": w})
+        olds.append(o)
+    if not olds:
+        return pr, {}
+    rec, missing = _secev_strict_merge(pr, olds)
+    rec["threat_table_version"] = max([pr, *olds], key=lambda x: len(_secev_min_kinds(x, ctx.tools)[0] or ())).get("threat_table_version")
+    return rec, missing
+
+
+def _secev_freeze_removed(run, ctx, cid, pr, br, mr):
+    """推送版沒有、降級或拿掉 security 的護欄:有 revision 核可(after=removed 或推送版的樣子)→ 不當必驗;否則照較新那版當必驗。"""
+    newer = mr if _secev_active_sec(mr) else br
+    after = {"removed": True} if pr is None else _secev_state(pr)
+    seq = _secev_revision_ok(ctx, cid, _secev_state(newer), after)
+    if seq:
+        run.rep["freeze"]["approved_revisions"].append({"id": cid, "against": "removed", "approval_seq": seq})
+        return None
+    why = ("主線新增了這條,先接上主線" if not _secev_active_sec(br) and _secev_active_sec(mr)
+           else "推送版刪掉、降成 candidate/retired 或拿掉 security 關注面,核可鏈上沒有有效的 revision 核可")
+    run.rep["freeze"]["removed"].append({"id": cid, "why": why})
+    return (newer, cid, why, {})
+
+
+def _secev_stage_freeze(run, ctx, idx):
+    """必驗集合=三版 active 資安條目的聯集;逐條決定照哪一版判 → [(記錄, id, 被刪的說明或 None, 少掉的列)]。"""
+    run.tick("凍結比對")
+    ids = sorted({i for n in ("push", "base", "main") for i, r in idx[n].items() if _secev_active_sec(r)})
+    work = []
+    for cid in ids:
+        pr, br, mr = idx["push"].get(cid), idx["base"].get(cid), idx["main"].get(cid)
+        if _secev_active_sec(pr):
+            rec, missing = _secev_freeze_kept(run, ctx, cid, pr, (("merge-base", br), ("主線 tip", mr)))
+            work.append((rec, cid, None, missing))
+            continue
+        w = _secev_freeze_removed(run, ctx, cid, pr, br, mr)
+        if w:
+            work.append(w)
+    return work
+
+
+def _secev_stage_judge(run, ctx, idx, work):
+    """凍結的證據項、額度預先算、逐條判必驗集合與候選、格子(驗過核可鏈)。"""
+    rep, penv, poversize = run.rep, run.reps["push"][1], run.reps["push"][2]
+    menv = run.reps["main"][1]
+    frozen, all_items = {}, []
+    for rec, cid, removed, _m in work:
+        pitems = _secev_items_for(penv, idx["push"].get(cid) if not removed else None, ctx._facts)
+        frozen[cid] = _secev_frozen(_secev_items_for(menv, idx["main"].get(cid), ctx._facts) if menv else [], pitems)
+        all_items.append((rec, pitems + frozen[cid]))
+    ctx.over_items = _secev_budget_prepass(ctx, all_items)
+    run.tick("逐條判定")
+    for rec, cid, removed, missing in work:
+        run.tick(f"判護欄 {cid}")
+        env_for = penv if not removed else (menv if _secev_active_sec(idx["main"].get(cid)) else run.reps["base"][1])
+        j = _secev_judge_control(rec, ctx, env_for, frozen[cid], removed=removed, missing_rows=missing, oversize=poversize)
+        j["mandatory"] = True
+        rep["controls"].append(j)
+    for _cid, r in sorted(idx["push"].items()):
+        if r.get("lifecycle") == "candidate" and "security" in (r.get("concerns") or []):
+            rep["candidates"].append(_secev_candidate(run, ctx, r))
+    run.tick("算格子")
+    rep["cells"], rep["cell_errors"], _pend = _seccell_compute(run.reps["push"][3], idx["push"].values(),
+                                                              run.reps["push"][0].get("considerations") or [],
+                                                              counted=lambda cid, row: _secev_consideration_counted(ctx, penv, cid, row))
+    rep["reminders"] += ctx.reminders
+    rep["parse_count"] = ctx.parse_count
+
+
+def _secev_candidate(run, ctx, r):
+    """candidate 照樣判給人看(不進必驗集合、不擋);放超過 30 天標出(d12)。"""
+    j = _secev_judge_control(r, ctx, run.reps["push"][1], [], oversize=run.reps["push"][2])
+    j["mandatory"] = False
+    age = _secev_candidate_age(run.repo_root, run.sha, r, run.reps["push"][0], run.today)
+    if age is not None and age > _SECEV_CANDIDATE_DAYS:
+        j["notes"].append(f"candidate 已放 {age} 天(超過 {_SECEV_CANDIDATE_DAYS} 天),該轉 active 或撤掉")
+        j["candidate_overdue"] = True
+    return j
+
+
+def _secev_evaluate_body(repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline):
+    """整道判定的階段:開頭(設定、主線、預檢、核可鏈)→ 三版盤點 → 上下文(配套、工具清單)→ 凍結比對 → 逐條判定。"""
+    run = _SecevRun(repo_root, sha, rep, stage, pushed_branch, range_start, today, deadline)
+    done = _secev_stage_head(run)
+    if done is None:
+        done = _secev_stage_reports(run)
+    if done is not None:
+        return done
+    ctx = _secev_stage_ctx(run)
+    if ctx is None:
+        return _secev_finish(_secev_gate(rep, "toolchain_incomplete"))
+    idx = {n: (_secev_index(v[0]) if v[0] else {}) for n, v in run.reps.items()}
+    work = _secev_stage_freeze(run, ctx, idx)
+    _secev_stage_judge(run, ctx, idx, work)
+    return _secev_finish(rep)
+
+
