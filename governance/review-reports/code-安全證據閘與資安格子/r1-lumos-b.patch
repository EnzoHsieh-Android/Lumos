+_SECEV_K6_THRESHOLD_RE = re.compile(r"([A-Za-z_][A-Za-z0-9_]*) (count|rate) (==|>=|<=|>|<) (\d+(?:\.\d+)?)")
+
+
+def _secev_k6_parse(raw):
+    """k6 新格式摘要 → ((版本, 腳本全文, {指標名: values}), None) 或 (None, 代碼)。"""
+    try:
+        obj = _secev_loads(raw.decode("utf-8-sig"))
+    except RecursionError:
+        return None, "report_too_deep"
+    except (UnicodeDecodeError, ValueError):
+        return None, "report_unparseable"
+    try:
+        ver, script, metrics = obj["metadata"]["k6_version"], obj["config"]["script"], obj["results"]["metrics"]
+        if not isinstance(metrics, list) or not isinstance(script, str):
+            raise TypeError
+        vals = {m["name"]: m.get("values") or {} for m in metrics if isinstance(m, dict) and isinstance(m.get("name"), str)}
+    except (KeyError, TypeError):
+        return None, "report_unparseable"
+    return (ver, script, vals), None
+
+
+def _secev_k6_thresholds(ths, vals):
+    """宣告的安全門檻(只收「指標 count|rate 比較符號 數字」)用計數自己算;寫法不允許 → k6_threshold_form,指標不在 → k6_metric_missing,
+    沒過 → threshold_exceeded(failed)。"""
+    import operator as _op
+    ops = {"==": _op.eq, ">=": _op.ge, "<=": _op.le, ">": _op.gt, "<": _op.lt}
+    probs = [] if ths else ["targets_empty"]
+    for th in ths:
+        m = _SECEV_K6_THRESHOLD_RE.fullmatch(th)
+        if not m:
+            probs.append("k6_threshold_form")
+            continue
+        name, stat, op, num = m.group(1), m.group(2), m.group(3), float(m.group(4))
+        v = (vals.get(name) or {}).get(stat)
+        if v is None:
+            probs.append("k6_metric_missing")
+        elif not isinstance(v, (int, float)) or not ops[op](v, num):
+            probs.append("threshold_exceeded")
+    return probs
+
+
+def _secev_k6_legit(legit, vals):
+    """合法流量計數:沒宣告或為 0 → missing_legit_control;宣告了卻不在摘要(沒 add(0))→ k6_metric_missing。"""
+    if not legit:
+        return ["missing_legit_control"]
+    out = []
+    for name in legit:
+        c = (vals.get(name) or {}).get("count") if name in vals else None
+        out.append("k6_metric_missing" if c is None else None if c > 0 else "missing_legit_control")
+    return [x for x in out if x]
+
+
+def _secev_judge_k6(it, raw, ctx, tool):
+    """k6 新格式機器可讀摘要(--new-machine-readable-summary 的 summary-export):版本、腳本全文雜湊、整體請求數下限、
+    合法流量計數、宣告的安全門檻。安全門檻由這裡用計數自己算,不讀 k6 的門檻旗標。
+    摘要不帶退出碼:中止或逾時的執行在這裡看得到的是一個迭代都沒完成(iterations 不在或為 0)→ k6_aborted。"""
+    got, why = _secev_k6_parse(raw)
+    if why:
+        return [why]
+    ver, script, vals = got
+    t = it["targets"]
+    probs = ["tool_version_mismatch"] if tool is not None and str(ver) != tool["version"] else []
+    script_path = (t.get("tests") or [None])[0]
+    sb = ctx.read(script_path)[0] if script_path else None
+    if not script_path:
+        probs.append("targets_empty")
+    elif sb is None or sb != script.encode("utf-8"):
+        probs.append("k6_script_mismatch")
+    it_count = (vals.get("iterations") or {}).get("count")
+    if not isinstance(it_count, (int, float)) or it_count <= 0:
+        probs.append("k6_aborted")
+    reqs = (vals.get("http_reqs") or {}).get("count", 0)
+    mr = (tool or {}).get("min_requests")
+    floor = mr.get(script_path) if isinstance(mr, dict) else None
+    if not isinstance(floor, int) or not isinstance(reqs, (int, float)) or reqs <= 0 or reqs < floor:
+        probs.append("k6_requests_below_floor")
+    return probs + _secev_k6_legit(t.get("legit_controls") or [], vals) + _secev_k6_thresholds(t.get("thresholds") or [], vals)
+
