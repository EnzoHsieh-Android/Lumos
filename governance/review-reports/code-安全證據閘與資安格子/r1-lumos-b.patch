+def _secev_index(rep):
+    """盤點報告 → {id: 記錄}(主清單、撤除、純業務都收;重複 ID 已是 registration_error)。"""
+    out = {}
+    for sec in ("records", "retired", "excluded_business"):
+        for r in rep.get(sec) or []:
+            out.setdefault(r["id"], r)
+    return out
+
+
+def _secev_active_sec(r):
+    return r is not None and r.get("lifecycle") == "active" and "security" in (r.get("concerns") or [])
+
+
+def _secev_revision_ok(ctx, cid, before, after_state):
+    """核可鏈上有沒有一筆有效的 revision 核可:target 是「護欄 id|decision_ref」,內容蓋住 before、after(或 removed)與 decision_ref;
+    decision_ref 要指到有效決策。before/after 是 {revision, inputs_sha256} 或 {"removed": True}。"""
+    for ent in ctx.chain.get("entries", []):
+        e = ent.get("entry") or {}
+        if ent["status"] != "ok" or e.get("type") != "revision" or not str(e.get("target", "")).startswith(cid + "|"):
+            continue
+        dref = e["target"][len(cid) + 1:]
+        content = {"control_id": cid, "before": before, "decision_ref": dref}
+        content.update({"removed": True} if after_state == {"removed": True} else {"after": after_state})
+        if e.get("content_sha256") == _secev_sha(_secev_canon(content)) and ctx.env is not None \
+                and _pq_decision_state(ctx.env, "", dref) == "ok":
+            return ent["seq"]
+    return None
+
+
+def _secev_state(r):
+    return {"revision": r.get("revision"), "inputs_sha256": _secev_inputs_sha(r)}
+
+
+def _secev_items_for(env, rec, cache):
+    """這條護欄在某一版的全部證據項(evidence_refs 指到的 Verification 篇章、control_id 相符)。"""
+    out = []
+    if env is None or rec is None:
+        return out
+    seen = set()
+    for ref in rec.get("evidence_refs") or []:
+        rel, _w = _secinv_node_rel(env, ref["node"])
+        if rel is None or rel in seen:
+            continue
+        seen.add(rel)
+        items, _p = _secev_fence_items(env, rel, cache)
+        out += [it for it in (items or []) if it.get("control_id") == rec["id"]]
+    return out
+
+
+def _secev_frozen(main_items, push_items):
+    """主線 tip 版有、推送版刪掉的項照樣算數,除非推送版有同 control、同 kind、同 targets 且 observed_at 更新的項取代它。"""
+    pc = {_secev_canon(it) for it in push_items}
+    out = []
+    for it in main_items:
+        if _secev_canon(it) in pc:
+            continue
+        tk = _secev_canon(it.get("targets"))
+        o = _secev_iso(it.get("observed_at"))
+        if any(p["kind"] == it["kind"] and _secev_canon(p.get("targets")) == tk and o is not None
+               and _secev_iso(p.get("observed_at")) is not None and _secev_iso(p["observed_at"]) > o for p in push_items):
+            continue
+        out.append(it)
+    return out
+
+
+def _secev_tool_weak(pt, mt, cats_push):
+    """同一個工具跟主線 tip 版比,哪裡變弱 → 說明清單(只新增工具、調高下限、收窄目標不算)。"""
+    if pt is None:
+        return [] if mt["category"] in cats_push else ["刪掉某工具類別的最後一個工具"]
+    weak = []
+    mr_m, mr_p = mt.get("min_requests") or {}, pt.get("min_requests") or {}
+    if isinstance(mr_m, dict) and any(not isinstance(mr_p, dict) or mr_p.get(k, 0) < v for k, v in mr_m.items()):
+        weak.append("min_requests 調低")
+    if mt.get("coverage_proof") != pt.get("coverage_proof"):
+        weak.append("覆蓋證明換了")
+    if set(pt.get("allowed_targets") or []) - set(mt.get("allowed_targets") or []):
+        weak.append("允許目標放寬")
+    return weak
+
+
+def _secev_tool_strict(pt, mt):
+    """沒核可的變弱:兩版取嚴(下限取大、覆蓋證明用主線版、目標取交集;刪掉的照主線那一列)。"""
+    if pt is None:
+        return mt
+    merged = dict(pt)
+    mr = dict(pt.get("min_requests") or {}) if isinstance(pt.get("min_requests"), dict) else {}
+    for k, v in (mt.get("min_requests") or {}).items():
+        mr[k] = max(mr.get(k, 0), v)
+    merged["min_requests"] = mr
+    merged["coverage_proof"] = mt.get("coverage_proof")
+    merged["allowed_targets"] = sorted(set(pt.get("allowed_targets") or []) & set(mt.get("allowed_targets") or []))
+    return merged
+
+
+def _secev_tool_freeze(push_tools, main_tools, ctx):
+    """工具清單跟主線 tip 版比變弱而沒有 tool_list_change 核可 → 照主線那一列判(兩版取嚴)。回 (合併後的清單, 變弱說明)。"""
+    out, notes = dict(push_tools), []
+    cats_push = {t["category"] for t in push_tools.values()}
+    for name, mt in main_tools.items():
+        pt = push_tools.get(name)
+        weak = _secev_tool_weak(pt, mt, cats_push)
+        if not weak:
+            continue
+        content = _secev_sha(_secev_canon({k: v for k, v in pt.items() if not k.startswith("_")} if pt else {}))
+        ok = ctx.approved("tool_list_change", name, content)
+        notes.append({"tool": name, "weakened": weak, "approved": ok})
+        if not ok:
+            out[name] = _secev_tool_strict(pt, mt)
+    return out, notes
+
+
+def _secev_budget_paths(ctx, work, over_items):
+    """要讀的證據檔 → 照(路徑、blob)排序的清單(同一份檔被多條護欄引用只列一次)。"""
+    paths = set()
+    for _rec, its in work:
+        for it in (x for x in its if id(x) not in over_items):
+            paths |= {(p, ctx.tree.oids[p]) for p in (it.get(k) for k in ("path", "coverage_path", "calibration_path"))
+                      if isinstance(p, str) and p in ctx.tree.files}
+    return sorted(paths)
+
+
+def _secev_budget_prepass(ctx, work):
+    """證據項總數上限與讀取總量上限(按不同 blob 算一次,固定照(路徑、blob)排序累加)。超過的項或檔判 evidence_too_large。"""
+    items = sorted(((rec["id"], it["kind"], str(it.get("path") or ""), id(it)) for rec, its in work for it in its))
+    over_items = {x[3] for x in items[_SECEV_ITEMS_MAX:]}
+    ordered = _secev_budget_paths(ctx, work, over_items)
+    sizes = _nodehome_cat_sizes(ctx.repo_root, [o for _p, o in ordered], _git_timeout(ctx.deadline, cap=60)) if ordered else []
+    if sizes is None:
+        raise RuntimeError("問證據檔大小時 git 失敗或逾時")
+    used, seen = 0, set()
+    for (p, o), n in zip(ordered, sizes):
+        if o in seen or n is None or n > _SECEV_FILE_MAX:
+            seen.add(o)
+            continue
+        seen.add(o)
+        if used + n > _SECEV_TOTAL_MAX:
+            ctx.over.add(p)
+        else:
+            used += n
+    return over_items
+
