+            ("單檔超過 2 MiB", lambda r: r.write(f"{r.vault}/Systems/Huge.md", "---\ntype: system\n---\n" + "x" * (2 * 1024 * 1024 + 10)),
+             "file_too_large")):
+        r = _SgRepo()
+        r.commit()
+        setup(r)
+        _sg_git(r.root, "add", "-A")
+        _sg_git(r.root, "commit", "-qm", label)
