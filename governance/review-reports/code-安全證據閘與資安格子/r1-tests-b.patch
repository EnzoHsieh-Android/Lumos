+    samples = {"syntax": (b"<testsuite><testcase name='a'></testsuite>", "invalid:report_unparseable"),
+               "dtd": (b"<!DOCTYPE x [<!ENTITY a 'b'>]><testsuite><testcase name='a'/></testsuite>", "invalid:report_unparseable"),
+               "noname": (b"<testsuite><testcase classname='c'/></testsuite>", "invalid:report_malformed"),
+               "dup": (b"<testsuite><testcase classname='c' name='a'/><testcase classname='c' name='a'/></testsuite>",
+                       "invalid:report_duplicate_identity"),
+               "error": (b"<testsuite><testcase classname='t' name='illegal'><error/></testcase></testsuite>", "invalid:suite_error")}
