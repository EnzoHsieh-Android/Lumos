+def _secev_candidate_age(repo_root, sha, r, prep, today):
+    """candidate 放了幾天:revision 是 YYYY-MM-DD 就用它,否則用家節點在這個提交上最後一次改動的提交日期。"""
+    import datetime as _dt
+    d = _secinv_date(str(r.get("revision") or ""))
+    if d is None:
+        rr = _secev_git(repo_root, "log", "-1", "--format=%cI", sha, "--", "*" + str(r.get("node") or ""))
+        dt = _secev_iso(rr.stdout.strip()) if rr is not None and rr.returncode == 0 and rr.stdout.strip() else None
+        d = dt.astimezone(_dt.timezone.utc).date() if dt else None
+    return (today - d).days if d else None
+
