+def _secapr_c_keys(root, typ, target, opts):
+    keys = []
+    for spec in opts.get("keys") or []:
+        if "=" not in spec:
+            raise ValueError("--key 要寫成 <principal>=<公鑰檔>")
+        princ, path = spec.split("=", 1)
+        parts = Path(path).read_text(encoding="utf-8").strip().split()
+        if len(parts) < 2:
+            raise ValueError(f"{path} 不像 ssh 公鑰")
+        keys.append(f"{princ} {parts[0]} {parts[1]}")
+    if _secapr_parse_keys(keys) is None:
+        raise ValueError("金鑰格式不對、貼成私鑰或類型不收(收 ssh-ed25519、sk-ssh-ed25519@openssh.com、ecdsa、ssh-rsa)")
+    return keys, keys
+
+
+def _secapr_c_gate(root, typ, target, opts):
+    if target != "security_evidence.gate":
+        raise ValueError("gate_setting 的 target 只收 security_evidence.gate")
+    return {"value": "warn"}, None
+
+
+def _secapr_c_suppression(root, typ, target, opts):
+    if "#" not in target or not opts.get("reason"):
+        raise ValueError("suppression 的 target 寫 <規則 id>#<位置雜湊>,另帶 --reason")
+    rule, loc = target.split("#", 1)
+    return {"rule": rule, "location_sha256": loc, "reason": opts["reason"]}, None
+
