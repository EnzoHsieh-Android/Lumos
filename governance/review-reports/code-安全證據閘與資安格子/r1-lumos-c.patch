+def _secapr_chain_position(raw):
+    """工作目錄那條鏈 → (下一筆的 seq, prev_sha256)。"""
+    ents = _secapr_parse(raw)
+    if not ents:
+        return 1, ""
+    last = ents[-1][1]
+    if last is None:
+        raise ValueError("工作目錄的核可鏈最後一行讀不出來,先修好再加")
+    return len(ents) + 1, _secev_sha(_secev_canon(last))
+
