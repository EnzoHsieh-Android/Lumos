+def _secev_grep_trace(repo_root, sha):
+    """廉價預檢:先一次 git grep 找提到 lumos-security-v1 的 .md;命中的那幾篇再照盤點的嚴格讀法(_secinv_blocks)看
+    有沒有真的圍欄或變體(散文裡提到這個字樣不算痕跡)。回 True/False/None(git 失敗,當成可能有)。"""
+    r = _secev_git(repo_root, "grep", "-l", "-z", "-F", "--no-color", _SECINV_MARK, sha, "--", "*.md")
+    if r is None:
+        return None
+    if r.returncode == 1:
+        return False
+    if r.returncode != 0:
+        return None
+    pre = sha + ":"
+    paths = [p.removeprefix(pre) for p in r.stdout.split("\0") if p]
+    if not paths:
+        return False
+    got = _nodehome_cat_blobs_capped(repo_root, [f"{sha}:{p}" for p in paths], _VAULT_SAFE_FILE_MAX)
+    if got is None:
+        return None
+    for p, b in zip(paths, got):
+        if b is None:
+            return True             # 讀不到(太大、特殊檔):交給完整快照判
+        try:
+            text = b.decode("utf-8")
+        except UnicodeDecodeError:
+            return True
+        blocks, errs = _secinv_blocks(p, text)
+        if blocks or errs:
+            return True
+    return False
+
