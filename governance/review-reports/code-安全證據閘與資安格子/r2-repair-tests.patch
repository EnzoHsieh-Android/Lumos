+def _sg_norm(text, root):
+    """輸出裡隨機的部分換成佔位:暫存目錄路徑、提交編號。"""
+    import re
+    head = _sg_git(root, "rev-parse", "HEAD")
+    return re.sub(head[:7] + r"[0-9a-f]*", "<HEAD>", text.replace(str(root), "<ROOT>"))
