+    n = type("N", (), {"fields": {"type": "project"}})()
+    t0 = _t.monotonic()
+    out = m._lint_excluded_lines(n, text)
+    dt = _t.monotonic() - t0
+    check("①照樣唸冒號沒寫對", len(out) == 1 and "冒號沒寫對" in out[0], str(out)[:200])
+    check("②一秒內跑完", dt < 1.0, f"{dt:.2f}s")
