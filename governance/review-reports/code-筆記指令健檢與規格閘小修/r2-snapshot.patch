+def _rp_doctor_p(root):
+    import subprocess as sp
+    r = sp.run([sys.executable, GRAPHCTL, "--vault", str(root / "docs" / "kg-knowledge"), "doctor"], capture_output=True, text=True)
+    out = r.stdout
+    i = out.find("[P]")
+    j = out.find("[P2]", i)
+    return out[i:j if j > 0 else None]
