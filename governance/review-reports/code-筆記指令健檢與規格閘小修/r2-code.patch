+def _rp_repo():
+    root = _nh_repo()
+    _nh_file(root, "src/a.py", "x = 1\n")
+    _nh_file(root, "scripts/e2e.sh", "#!/bin/sh\n")
+    _nh_file(root, "e2e/.gitignore", ".run-state\n")
+    _nh_commit(root, "init")
