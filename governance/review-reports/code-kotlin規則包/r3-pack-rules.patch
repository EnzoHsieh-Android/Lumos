               regex: ^on[A-Z]\w*$
             inside:
               stopBy: end
               kind: function_declaration
               has:
                 kind: modifiers
                 has:
                   kind: annotation
                   regex: ^@Composable
+---
+# 自 rules/state.yml 搬來(代碼審 r2 規則B Finding 4):「理由」註解是不是寫給這一行,要看行距與語意,形狀判不準
+id: kt-statein-eagerly
+language: kotlin
+severity: info
+message: '[STATE-4]stateIn 用 Eagerly 沒寫理由,上游一開始就永遠收集、背景照樣耗電;改用 SharingStarted.WhileSubscribed(5_000),真要 Eagerly 附一行 // 理由: 註解'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**', '**/src/testFixtures/**', '**/src/*Test/**', '**/src/sharedTest/**', '**/*-test/src/**', '**/*testing/src/**']
+rule:
+  pattern: SharingStarted.Eagerly
+  # 型錄 STATE-4:真要 Eagerly 附一行理由。形狀只放行寫在 stateIn 引數裡、以 // 理由: 開頭的註解;
+  # 屬性上一行或行尾的註解分不出是哪一行的(鄰行的理由會被借走),一律報出來交盲判看(代碼審 r2 規則B Finding 4)
+  not:
+    inside:
+      kind: value_arguments
+      stopBy: end
+      has:
+        kind: line_comment
+        regex: '^//\s*(理由|[Rr]eason\b)'
