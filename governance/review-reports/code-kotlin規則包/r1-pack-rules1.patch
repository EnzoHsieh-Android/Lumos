+---
+id: kt-compose-pointerinput-stale-callback
+language: kotlin
+severity: warning
+message: '[UI-3]pointerInput(Unit) 只啟動一次,換新的 onXxx 回呼後還在用舊的;改用 pointerInput(onTap) { } 把回呼當 key,或 rememberUpdatedState'
+rule:
+  any:
+    - pattern: pointerInput(Unit) { $$$ }
+    - pattern: pointerInput(true) { $$$ }
+    - pattern: $M.pointerInput(Unit) { $$$ }
+    - pattern: $M.pointerInput(true) { $$$ }
+  has:
+    kind: call_expression
+    has:
+      kind: simple_identifier
+      regex: ^on[A-Z]\w*$
+    stopBy: end
+---
+id: kt-compose-navigate-in-body
+language: kotlin
+severity: error
+message: '[UI-70]在組建本體直接 navigate,每次重組都再導航一次、返回堆疊越疊越高;改用 LaunchedEffect(uiState) { } 依狀態導航'
+utils:
+  in-composable:
+    inside:
+      kind: function_declaration
+      has:
+        kind: modifiers
+        has:
+          kind: annotation
+          regex: ^@Composable
+      stopBy: end
+  deferred-lambda:
+    kind: lambda_literal
+    any:
+      - inside:
+          kind: value_argument
+          has:
+            kind: simple_identifier
+            regex: ^on[A-Z]\w*$
+      - inside:
+          kind: property_declaration
+      - inside:
+          kind: annotated_lambda
+          inside:
+            kind: call_suffix
+            inside:
+              kind: call_expression
+              any:
+                - has:
+                    kind: simple_identifier
+                    regex: '^(LaunchedEffect|SideEffect|DisposableEffect|onDispose|remember|rememberSaveable|derivedStateOf|produceState|snapshotFlow|rememberUpdatedState|clickable|combinedClickable|selectable|toggleable|pointerInput|detectTapGestures|detectDragGestures|launch|async|withContext|LifecycleEventEffect|LifecycleResumeEffect|LifecycleStartEffect|BackHandler|dropUnlessResumed|dropUnlessStarted|on[A-Z]\w*)$'
+                - has:
+                    kind: navigation_expression
+                    has:
+                      kind: navigation_suffix
+                      has:
+                        kind: simple_identifier
+                        regex: '^(LaunchedEffect|SideEffect|DisposableEffect|onDispose|remember|rememberSaveable|derivedStateOf|produceState|snapshotFlow|rememberUpdatedState|clickable|combinedClickable|selectable|toggleable|pointerInput|detectTapGestures|detectDragGestures|launch|async|withContext|LifecycleEventEffect|LifecycleResumeEffect|LifecycleStartEffect|BackHandler|dropUnlessResumed|dropUnlessStarted|on[A-Z]\w*)$'
+  in-composition:
+    all:
+      - matches: in-composable
+      - not:
+          inside:
+            matches: deferred-lambda
+            stopBy: end
+rule:
+  any:
+    - pattern: $N.navigate($$$)
+    - pattern: $N.popBackStack($$$)
+  matches: in-composition
+---
+id: kt-compose-navcontroller-param
+language: kotlin
+severity: warning
+message: '[UI-71]@Composable 參數收 NavController,畫面跟導航綁死、難預覽難測;改成傳事件 onNavigate: () -> Unit'
+rule:
+  kind: parameter
+  has:
+    kind: user_type
+    regex: ^Nav(Host)?Controller$
+  inside:
+    kind: function_declaration
+    has:
+      kind: modifiers
+      has:
+        kind: annotation
+        regex: ^@Composable
+    not:
+      has:
+        kind: call_expression
+        has:
+          kind: simple_identifier
+          regex: ^NavHost$
+        stopBy: end
+    stopBy: end
+---
+id: kt-compose-preview-real-viewmodel
+language: kotlin
+severity: error
+message: '[UI-102]預覽函式裡取真 ViewModel,預覽沒有 DI 與資料來源會崩潰;改成預覽無狀態版 ScreenContent(uiState = fakeState, onEvent = {})'
+rule:
+  kind: call_expression
+  has:
+    kind: simple_identifier
+    regex: ^(viewModel|hiltViewModel|koinViewModel|hiltNavGraphViewModel|[A-Z]\w*ViewModel)$
+  inside:
+    kind: function_declaration
+    has:
+      kind: modifiers
+      has:
+        kind: annotation
+        regex: ^@Preview
+    stopBy: end
+---
+id: kt-compose-clickable-icon-null-description
+language: kotlin
+severity: warning
+message: '[UI-104]可點擊圖示 contentDescription = null,讀屏不知道用途;改成 contentDescription = stringResource(R.string.close)'
+rule:
+  kind: value_argument
+  all:
+    - has:
+        kind: simple_identifier
+        regex: ^contentDescription$
+    - has:
+        kind: null_literal
+  any:
+    - inside:
+        kind: call_expression
+        has:
+          kind: simple_identifier
+          regex: ^(IconButton|FilledIconButton|FilledTonalIconButton|OutlinedIconButton|IconToggleButton|FilledIconToggleButton|FilledTonalIconToggleButton|OutlinedIconToggleButton|FloatingActionButton|SmallFloatingActionButton|LargeFloatingActionButton)$
+        stopBy: end
+    - inside:
+        kind: call_expression
+        all:
+          - has:
+              kind: simple_identifier
+              regex: ^(Icon|Image)$
+          - has:
+              kind: simple_identifier
+              regex: ^(clickable|combinedClickable|toggleable|selectable)$
+              stopBy: end
+        stopBy: end
+---
+id: kt-compose-hardcoded-content-description
+language: kotlin
+severity: warning
+message: "[UI-105]contentDescription 寫死字串,切語系不會翻譯;改用 stringResource(R.string.xxx)"
+rule:
+  any:
+    - kind: value_argument
+      all:
+        - has:
+            kind: simple_identifier
+            regex: ^contentDescription$
+        - has:
+            kind: string_literal
+            regex: ^".+"$
+    - kind: assignment
+      all:
+        - has:
+            kind: directly_assignable_expression
+            regex: ^contentDescription$
+        - has:
+            kind: string_literal
+            regex: ^".+"$
+---
+id: kt-compose-font-size-from-dp
+language: kotlin
+severity: warning
+message: '[UI-109]字級由 dp 換算成 sp,使用者調大字型不會放大;改用 16.sp 直接寫字級'
+rule:
+  any:
+    - pattern: $N.dp.value.sp
+    - pattern: $N.dp.toSp()
+---
+id: kt-launchedeffect-constant-key
+language: kotlin
+severity: warning
+message: '[UI-3]LaunchedEffect 的 key 是 Unit/true 卻用到參數,參數變了不重跑、讀到舊值;改成 key 放實際依賴 LaunchedEffect(id),只需最新回呼用 rememberUpdatedState'
+rule:
+  all:
+    - kind: simple_identifier
+      pattern: $P
+    - not:
+        inside:
+          kind: navigation_suffix
+    - inside:
+        stopBy: end
+        any:
+          - pattern: LaunchedEffect(Unit) { $$$ }
+          - pattern: LaunchedEffect(true) { $$$ }
+          - pattern: LaunchedEffect(key1 = Unit) { $$$ }
+    - inside:
+        stopBy: end
+        kind: function_declaration
+        has:
+          kind: function_value_parameters
+          has:
+            kind: parameter
+            has:
+              kind: simple_identifier
+              pattern: $P
+---
+# P31(補 LazyColumn 以外與 itemsIndexed)
+id: kt-lazy-items-no-key-ext
+language: kotlin
+severity: warning
+message: '[UI-1]Lazy 清單/格狀的 items 沒給 key,重排時整片重組、捲動位置跳;改用 items(list, key = { it.id })'
+rule:
+  any:
+    - pattern: items($$$ARGS)
+    - pattern: itemsIndexed($$$ARGS)
+  inside:
+    any:
+      - pattern: LazyRow { $$$ }
+      - pattern: LazyRow($$$) { $$$ }
+      - pattern: LazyColumn($$$) { $$$ }
+      - pattern: LazyVerticalGrid($$$) { $$$ }
+      - pattern: LazyHorizontalGrid($$$) { $$$ }
+      - pattern: LazyVerticalStaggeredGrid($$$) { $$$ }
+      - pattern: LazyHorizontalStaggeredGrid($$$) { $$$ }
+    stopBy: end
+  not:
+    any:
+      - regex: '\bkey\s*='
+      # 只給筆數、而且是整數字面值或全大寫常數:清單不會重排,預設用索引當 key 剛好是對的(2026-11-05 實驗專案實測誤報)
+      - regex: '^items\(\s*(\d+|([\w.]*\.)?[A-Z][A-Z0-9_]*)\s*\)'
+      - all:
+          - pattern: items($$$ARGS)
+          - inside:
+              pattern: LazyColumn { $$$ }
+              stopBy: end
+---
+id: kt-lazy-items-no-key
+language: kotlin
+severity: warning
+message: '[UI-1]Lazy 清單 items 沒給穩定 key,重排時整片重組、捲動位置跳;改用 items(list, key = { it.id })'
+rule:
+  pattern: items($$$ARGS)
+  inside:
+    pattern: LazyColumn { $$$ }
+    stopBy: end
+  not:
+    regex: '\bkey\s*='
