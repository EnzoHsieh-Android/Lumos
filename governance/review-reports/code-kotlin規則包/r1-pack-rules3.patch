+      - pattern: $S.launch(Dispatchers.IO) { $$$ }
+      - pattern: $S.launch(Dispatchers.Default) { $$$ }
+      - pattern: launch(Dispatchers.IO) { $$$ }
+      - pattern: launch(Dispatchers.Default) { $$$ }
+      - pattern: thread { $$$ }
+      - pattern: thread($$$) { $$$ }
+    stopBy: end
+  not:
+    inside:
+      any:
+        - pattern: withContext(Dispatchers.Main) { $$$ }
+        - pattern: withContext(Dispatchers.Main.immediate) { $$$ }
+      stopBy: end
+---
+id: kt-savedstate-bang
+language: kotlin
+severity: warning
+message: '[STATE-21]從 SavedStateHandle 取參數硬寫 !!,key 打錯或參數改名就崩潰;改用 savedStateHandle.toRoute<Route>() 或集中常數加預設值'
+rule:
+  any:
+    - pattern: $H.get<$T>($K)!!
+    - pattern: $H.get($K)!!
+    - pattern: $H[$K]!!
+constraints:
+  H:
+    regex: (?i)(savedState|handle)
+---
+id: kt-persistable-bundle
+language: kotlin
+severity: warning
+message: '[STATE-24]用 PersistableBundle 版 onSaveInstanceState 存 UI 狀態,只在 persistableMode 呼叫;改用 Bundle 版或 SavedStateHandle'
+rule:
+  kind: parameter
+  has:
+    kind: user_type
