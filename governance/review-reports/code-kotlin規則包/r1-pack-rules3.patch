+id: kt-statein-in-getter
+language: kotlin
+severity: warning
+message: '[STATE-3]stateIn/shareIn 寫在 get() 裡,每讀一次就建一條新熱流;改成 val uiState = ….stateIn(...) 屬性,只建一次'
+rule:
+  any:
+    - pattern: $E.stateIn($$$)
+    - pattern: $E.shareIn($$$)
+  inside:
+    kind: getter
+    stopBy: end
