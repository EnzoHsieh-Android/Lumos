diff --git a/configs/ast-grep/kotlin-android/rules-review/api.yml b/configs/ast-grep/kotlin-android/rules-review/api.yml
new file mode 100644
index 000000000..23fc7bda5
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-review/api.yml
@@ -0,0 +1,15 @@
+# 語意覆核級(info):形狀分不出對錯,要盲判代理逐筆判
+# 自 rules/api.yml 的 kt-suspendcoroutine 拆出(代碼審 r1 M11):包一次性 Task 這類沒有可取消資源的 wrapper 不加 invokeOnCancellation 本來就對,形狀分不出
+id: kt-suspendcancellable-no-oncancel
+language: kotlin
+severity: info
+message: '[API-11]suspendCancellableCoroutine 沒註冊 invokeOnCancellation,取消後請求還在跑;改成 cont.invokeOnCancellation { call.cancel() }'
+rule:
+  any:
+    - pattern: suspendCancellableCoroutine { $$$ }
+    - pattern: suspendCancellableCoroutine<$T> { $$$ }
+  not:
+    has:
+      kind: call_expression
+      regex: invokeOnCancellation
+      stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules/api.yml b/configs/ast-grep/kotlin-android/rules/api.yml
index e87572f2c..a59b45807 100644
--- a/configs/ast-grep/kotlin-android/rules/api.yml
+++ b/configs/ast-grep/kotlin-android/rules/api.yml
@@ -57,34 +57,39 @@ rule:
             - pattern: $X?.use { $$$ }
           stopBy: end
       - inside:
           kind: function_body
           has:
             any:
               - pattern: $Y.use { $$$ }
               - pattern: $Y?.use { $$$ }
               - pattern: $Y.close()
               - pattern: $Y?.close()
+              # 讀完 body 的 string()/bytes() 會關 body,連線跟著還回去(代碼審 r1 M10)
+              - kind: call_expression
+                regex: '\.body(\(\))?(\?|!!)?\.(string|bytes|close)\(\)$'
             stopBy: end
           stopBy: end
 ---
 id: kt-http-logging-body-unguarded
 language: kotlin
 severity: warning
 message: '[API-19]BODY 日誌沒用 DEBUG 包住,正式版把權杖與個資寫進 logcat;改成 if (BuildConfig.DEBUG) Level.BODY else Level.NONE,並 redactHeader'
 rule:
   any:
     - pattern: HttpLoggingInterceptor.Level.BODY
     - pattern: Level.BODY
   not:
     inside:
-      kind: if_expression
+      any:
+        - kind: if_expression
+        - kind: when_expression
       has:
         pattern: BuildConfig.DEBUG
         stopBy: end
       stopBy: end
 ---
 id: kt-catch-only-httpexception
 language: kotlin
 severity: warning
 message: '[API-24]只接 HttpException,斷網(IOException)與解析錯誤會直接往上炸;改成 HttpException、IOException、SerializationException 分開 catch 並轉成網域錯誤'
 rule:
@@ -143,20 +148,29 @@ rule:
             - has:
                 kind: modifiers
                 has:
                   kind: annotation
                   regex: ^@(Provides|Singleton|Bean)\b
                   stopBy: end
             - has:
                 kind: user_type
                 regex: ^HttpClient$
           stopBy: end
+      # 同函式裡有 close()(try/finally 關掉)就不算「沒關」(代碼審 r1 M14)
+      - inside:
+          kind: function_body
+          has:
+            any:
+              - pattern: $Y.close()
+              - pattern: $Y?.close()
+            stopBy: end
+          stopBy: end
