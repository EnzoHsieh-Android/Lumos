diff --git a/configs/ast-grep/kotlin-android/rules-review/api.yml b/configs/ast-grep/kotlin-android/rules-review/api.yml
index 23fc7bda5..fb1f850e6 100644
--- a/configs/ast-grep/kotlin-android/rules-review/api.yml
+++ b/configs/ast-grep/kotlin-android/rules-review/api.yml
@@ -6,10 +6,61 @@ severity: info
 message: '[API-11]suspendCancellableCoroutine 沒註冊 invokeOnCancellation,取消後請求還在跑;改成 cont.invokeOnCancellation { call.cancel() }'
 rule:
   any:
     - pattern: suspendCancellableCoroutine { $$$ }
     - pattern: suspendCancellableCoroutine<$T> { $$$ }
   not:
     has:
       kind: call_expression
       regex: invokeOnCancellation
       stopBy: end
+---
+# 語意覆核級(info):形狀分不出對錯,要盲判代理逐筆判
+# 自 rules/api.yml 搬來(代碼審 r3 規則席 Finding 1):OkHttp 5 的 body 是屬性(r.body.string()、r.body.use { }),
+# 讀完或 use 掉 body 的寫法列舉不完,同一個 Response 有沒有關要看資料流
+id: kt-okhttp-response-not-closed
+language: kotlin
+severity: info
+message: '[API-17]execute() 拿到的 Response 沒關閉會洩漏連線、耗盡連線池;改用 client.newCall(req).execute().use { … }'
+rule:
+  pattern: $C.newCall($$$).execute()
+  not:
+    any:
+      - inside:
+          any:
+            - pattern: $X.use { $$$ }
+            - pattern: $X?.use { $$$ }
+          stopBy: end
+      # 直接接著讀完 body:execute().body?.string() 會關 body,連線跟著還回去(代碼審 r1 M10)
+      - inside:
+          kind: call_expression
+          regex: '\.execute\(\)\s*\.body(\(\))?(\?|!!)?\.(string|bytes|close)\(\)$'
+          stopBy: end
+      # 先存進變數:同函式裡對「同一個變數」use/close,或讀完它的 body;
+      # 讀別的 Response 的 body 不算(代碼審 r1 M10、r2 規則A F5)
+      - all:
+          - inside:
+              kind: property_declaration
+              has:
+                kind: variable_declaration
+                has:
+                  kind: simple_identifier
+                  pattern: $V
+          - inside:
+              kind: function_body
+              has:
+                any:
+                  - pattern: $V.use { $$$ }
+                  - pattern: $V?.use { $$$ }
+                  - pattern: $V.close()
+                  - pattern: $V?.close()
+                  - pattern: $V.body!!.string()
+                  - pattern: $V.body?.string()
+                  - pattern: $V.body!!.bytes()
+                  - pattern: $V.body?.bytes()
+                  - pattern: $V.body!!.close()
+                  - pattern: $V.body?.close()
+                  - pattern: $V.body().string()
+                  - pattern: $V.body().bytes()
+                  - pattern: $V.body().close()
+                stopBy: end
+              stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules-review/data.yml b/configs/ast-grep/kotlin-android/rules-review/data.yml
index e8284650a..cb1baad51 100644
--- a/configs/ast-grep/kotlin-android/rules-review/data.yml
+++ b/configs/ast-grep/kotlin-android/rules-review/data.yml
@@ -21,10 +21,68 @@ rule:
           any:
             - kind: if_expression
             - kind: when_expression
           stopBy: end
         not:
           inside:
             kind: string_literal
             stopBy: end
         stopBy: end
       stopBy: end
+---
+# 語意覆核級(info):形狀分不出對錯,要盲判代理逐筆判
+# 自 rules/data.yml 搬來(代碼審 r3 規則席 Finding 2):try/runCatching 區塊裡接的終端操作
+# (collect、toList、single、collectLatest…)列舉不完,收集是否在區塊內完成要看語意
+id: kt-datastore-read-no-catch
+language: kotlin
+severity: info
+message: '[DATA-10]讀 DataStore 沒處理 IOException,檔案讀壞時整條 Flow 直接炸;改用 .catch 遇 IOException 就 emit(emptyPreferences())'
+rule:
+  any:
+    - pattern: $D.data.map { $$$ }
+    - pattern: $D.data.map($$$)
+    - pattern: $D.data.first()
+    - pattern: $D.data.firstOrNull()
+    - pattern: $D.data.collect { $$$ }
+    - pattern: $D.data.onEach { $$$ }
+  regex: (?i)^[\w.]*?(datastore|prefs|preferences)\.data\.
+  not:
+    any:
+      - inside:
+          any:
+            - pattern: $Y.catch { $$$ }
+            - pattern: $Y.catch($$$)
+          stopBy: end
+      # try/runCatching 只對「在區塊裡就收集完」的終端操作有用:first()/firstOrNull()/collect,或直接接 .first();
+      # 區塊裡只建立流(map)或排程到 launch/async 裡收集,IOException 發生在區塊外,不放行(代碼審 r2 規則B Finding 10)
+      - all:
+          - inside:
+              any:
+                - kind: try_expression
+                - pattern: runCatching { $$$ }
+                - pattern: $Y.runCatching { $$$ }
+              stopBy: end
+          - any:
+              - pattern: $D.data.first()
+              - pattern: $D.data.firstOrNull()
+              - pattern: $D.data.collect { $$$ }
+              - inside:
+                  kind: navigation_expression
+                  regex: '\.(first|firstOrNull)$'
+          - not:
+              inside:
+                any:
+                  - pattern: launch { $$$ }
+                  - pattern: launch($$$) { $$$ }
+                  - pattern: $S.launch { $$$ }
+                  - pattern: $S.launch($$$) { $$$ }
+                  - pattern: async { $$$ }
+                  - pattern: async($$$) { $$$ }
+                  - pattern: $S.async { $$$ }
+                  - pattern: $S.async($$$) { $$$ }
+                inside:
+                  any:
+                    - kind: try_expression
+                    - pattern: runCatching { $$$ }
+                    - pattern: $Y.runCatching { $$$ }
+                  stopBy: end
+                stopBy: end
