+                any:
+                  - kind: class_body
+                  - kind: function_body
+                  - kind: source_file
+                has:
+                  stopBy: end
+                  kind: property_declaration
+                  all:
+                    - has:
+                        kind: variable_declaration
+                        has:
+                          kind: simple_identifier
+                          pattern: $E
+                    - regex: '=\s*(java\.util\.concurrent\.)?(Executors\.new\w*|\w*ThreadPoolExecutor|ForkJoinPool)\s*\('
+    - any:
+        - all:
+            - inside:
+                stopBy: end
+                kind: function_body
+            - not:
+                inside:
+                  stopBy: end
+                  pattern: $X.use { $$$ }
+            - not:
+                inside:
+                  stopBy: end
+                  kind: function_body
+                  has:
+                    stopBy: end
+                    pattern: $Y.close()
+        - all:
+            - inside:
+                kind: property_declaration
+                inside:
+                  kind: class_body
+                  inside:
+                    kind: class_declaration
+                    not:
+                      has:
+                        stopBy: end
+                        pattern: $Y.close()
+            - not:
+                inside:
+                  stopBy: end
+                  kind: function_body
+---
+id: kt-volatile-compound-update
+language: kotlin
+severity: error
+message: '[CO-35]@Volatile 只保證看得到最新值,++ / += 是「讀-改-寫」三步,多協程同時做會掉更新;改用 AtomicInteger.incrementAndGet() 或 Mutex'
+rule:
+  all:
+    - any:
+        - pattern: $N++
+        - pattern: $N--
