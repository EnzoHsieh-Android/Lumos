+            stopBy: end
+        stopBy: end
+    - inside:
+        kind: getter
+        stopBy: end
+    - all:
+        - inside:
+            kind: class_declaration
+            has:
+              kind: delegation_specifier
+              regex: ViewModel\(
+              stopBy: end
+            stopBy: end
+        - not:
+            inside:
+              pattern: $X.cachedIn($$$)
+              stopBy: end
+---
+id: kt-paging-transform-after-cachedin
+language: kotlin
+severity: warning
+message: '[DATA-57]cachedIn 之後才 map/filter,轉換結果沒被快取、每次收集都重算;改成先 map 再 cachedIn(viewModelScope)'
+rule:
+  any:
+    - pattern: $F.cachedIn($S).map { $$$ }
+    - pattern: $F.cachedIn($S).map($$$)
+    - pattern: $F.cachedIn($S).mapLatest { $$$ }
+    - pattern: $F.cachedIn($S).filter { $$$ }
+---
+id: kt-remote-mediator-no-transaction
+language: kotlin
+severity: warning
+message: '[DATA-59]RemoteMediator 清表、寫資料、寫 remote key 分開呼叫,中途失敗會對不上;改用 db.withTransaction { } 包起來'
+rule:
+  kind: call_expression
+  regex: (?i)^[\w.]*?dao\w*(\(\))?\.(insert|upsert|delete|clear|remove)\w*\(
+  inside:
+    any:
+      - kind: class_declaration
+      - kind: object_declaration
+    has:
+      kind: delegation_specifier
+      regex: \bRemoteMediator<
+    stopBy: end
+  not:
+    inside:
+      any:
+        - pattern: $D.withTransaction { $$$ }
+        - pattern: withTransaction { $$$ }
+        - pattern: $D.runInTransaction { $$$ }
+        - pattern: $D.runInTransaction($$$)
+      stopBy: end
+---
+id: kt-room-main-thread-queries
+language: kotlin
+severity: error
+message: '[DATA-1]allowMainThreadQueries 讓資料庫查詢跑在主執行緒,卡頓甚至 ANR;改成拿掉,DAO 改 suspend fun 或回傳 Flow'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**', '**/src/testFixtures/**', '**/src/*Test/**', '**/src/sharedTest/**']
+rule:
+  pattern: $B.allowMainThreadQueries()
+---
+id: kt-room-dao-blocking
+language: kotlin
+severity: warning
+message: '[DATA-2]Room 的 DAO 函式是阻塞的,呼叫端在主執行緒會擋住或丟例外;改成 suspend fun 或回傳 Flow'
+rule:
+  kind: function_declaration
+  has:
+    kind: modifiers
+    has:
+      kind: annotation
+      regex: ^@(Query|Insert|Update|Delete|Upsert|RawQuery|Transaction)\b
+    stopBy: end
+  not:
+    any:
+      - has:
+          kind: modifiers
+          has:
+            regex: ^suspend$
+            stopBy: end
+      - has:
+          kind: user_type
+          regex: ^(Flow|LiveData|PagingSource|Observable|Flowable|Single|Maybe|Completable|ListenableFuture)\b
+      - has:
+          kind: modifiers
+          has:
+            regex: ^(abstract|open)$
+            stopBy: end
+          not:
+            has:
+              kind: annotation
+              stopBy: end
+  inside:
+    kind: class_declaration
+    has:
+      kind: modifiers
+      has:
+        kind: annotation
+        regex: ^@Dao\b
+      stopBy: end
+    stopBy: end
+---
+id: kt-datastore-not-singleton
+language: kotlin
+severity: error
+message: '[DATA-3]DataStore 只能在頂層建一次(同一個檔兩個實例會在執行期丟例外);改成檔案頂層的 by preferencesDataStore 或注入單例'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**', '**/src/testFixtures/**', '**/src/*Test/**', '**/src/sharedTest/**']
+rule:
+  any:
+    - pattern: PreferenceDataStoreFactory.create($$$)
+    - pattern: PreferenceDataStoreFactory.create { $$$ }
+    - pattern: PreferenceDataStoreFactory.create($$$) { $$$ }
+    - pattern: DataStoreFactory.create { $$$ }
+    - pattern: DataStoreFactory.create($$$) { $$$ }
+    - pattern: DataStoreFactory.create($$$)
+    - pattern: preferencesDataStore($$$)
+    - pattern: dataStore($$$)
+  inside:
+    any:
+      - kind: class_body
+      - kind: function_body
+    stopBy: end
+  not:
+    any:
+      - inside:
+          kind: object_declaration
+          stopBy: end
+      - inside:
+          kind: companion_object
+          stopBy: end
+      # DI 提供者:@Provides(Hilt/Dagger)函式只會照作用域建一次
+      - inside:
+          kind: function_declaration
+          stopBy: end
+          has:
+            kind: modifiers
+            has:
+              kind: annotation
+              regex: ^@Provides\b
+---
+# P6
+id: kt-onreceive-async-without-goasync
+language: kotlin
+severity: warning
+message: '[DATA-52]onReceive 起協程或執行緒卻沒 goAsync,一回傳程序就可能被殺、工作做一半;改用 goAsync() 並在 finally finish(),長工作交 WorkManager'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  kind: function_declaration
+  has:
+    kind: simple_identifier
+    regex: '^onReceive$'
+  all:
+    - has:
+        any:
+          - pattern: launch { $$$ }
+          - pattern: launch($$$) { $$$ }
+          - pattern: $S.launch { $$$ }
+          - pattern: $S.launch($$$) { $$$ }
+          - pattern: async { $$$ }
+          - pattern: $S.async { $$$ }
+          - pattern: $S.async($$$) { $$$ }
+          - pattern: thread { $$$ }
+          - pattern: thread($$$) { $$$ }
+        stopBy: end
+    - not:
+        has:
+          pattern: goAsync()
+          stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules/flow.yml b/configs/ast-grep/kotlin-android/rules/flow.yml
new file mode 100644
index 000000000..e307a0ae6
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules/flow.yml
@@ -0,0 +1,204 @@
+id: kt-vm-channel-event
+language: kotlin
+severity: warning
+message: '[FLOW-7]ViewModel 用 Channel/SharedFlow 送一次性事件,UI 停止收集時事件會遺失;改成 uiState 的欄位,UI 處理完呼叫 vm.xxxShown() 清掉'
+rule:
+  any:
+    - pattern: $C.receiveAsFlow()
+    - pattern: $C.consumeAsFlow()
+    - pattern: Channel<$CT>($$$)
+    - pattern: Channel($$$)
+    - pattern: MutableSharedFlow<$T>($$$)
+  inside:
+    kind: class_declaration
+    has:
+      kind: delegation_specifier
+      regex: ViewModel\(
+    stopBy: end
+  # 只認看得出是一次性事件的屬性:型別參數或屬性名帶 Event/Effect/Nav/Toast 等字;工作佇列 Channel<Int>、ChatMessage 資料流不算
+  all:
+    - inside:
+        kind: property_declaration
+        stopBy: end
+        regex: '<\w*(Event|Effect|Command|Navigation|Nav|Toast|Snackbar|UiMessage|UserMessage)\w*>|\b(val|var)\s+_?(\w*(Event|Effect|Command|Navigation|Toast|Snackbar)s?|events?|effects?|commands?|navigation\w*|navigate\w*|nav|toasts?|snackbars?)\b'
+---
+id: kt-flow-catch-empty
+language: kotlin
+severity: warning
+message: '[FLOW-8]Flow 的 .catch { } 空本體把錯誤全吞掉,畫面停在舊資料也沒紀錄;改成至少記錄並轉成錯誤狀態,例 catch { e -> _state.update { … } }'
+rule:
+  pattern: $F.catch { $$$ }
+  has:
+    kind: call_suffix
+    has:
+      kind: annotated_lambda
+      has:
+        kind: lambda_literal
+        not:
+          has:
+            kind: statements
+---
+id: kt-catch-before-operator
+language: kotlin
+severity: warning
+message: '[FLOW-11]catch 放在 map/onEach 等運算子之前,管不到下游運算子丟的例外;改成 .catch 放在所有可能丟例外的中間運算子之後'
+rule:
+  any:
+    - pattern: $F.catch { $$$ }.$OP { $$$ }
+    - pattern: $F.catch { $$$ }.$OP($$$)
+  not:
+    any:
+      - has:
+          kind: call_expression
+          regex: '^[\s\S]*\.\s*catch\s*\{[\s\S]*\bthrow\b'
+          stopBy: end
+      - inside:
+          kind: navigation_expression
+          regex: '\.\s*catch$'
+constraints:
+  OP:
+    # onEach 歸 kt-flow-catch-before-oneach 報,這裡不重複
+    regex: ^(map|mapNotNull|mapLatest|filter|filterNot|filterNotNull|transform|transformLatest|flatMapLatest|flatMapConcat|flatMapMerge|scan|runningFold|runningReduce|onStart|zip|combine)$
+---
+id: kt-try-emit-in-flow
+language: kotlin
+severity: error
+message: '[FLOW-12]flow { } 裡用 try 包 emit 會吞掉下游例外,違反例外透明而在執行期丟例外;改成 flow { emit(x) }.catch { emit(fallback) }'
+rule:
+  kind: try_expression
+  all:
+    - has:
+        kind: catch_block
+    - has:
+        kind: statements
+        has:
+          stopBy: end
+          any:
+            - pattern: emit($$$)
+            - pattern: emitAll($$$)
+    - inside:
+        stopBy: end
+        any:
+          - pattern: flow { $$$ }
+          - pattern: flow<$T> { $$$ }
+    - not:
+        has:
+          kind: catch_block
+          has:
+            stopBy: end
+            kind: jump_expression
+            regex: ^throw\b
+---
+id: kt-launch-emit-in-flow
+language: kotlin
+severity: error
+message: '[FLOW-15]flow { } 不能從別的協程 emit(違反情境保存,執行期丟 IllegalStateException);要並行生產改用 channelFlow { launch { send(x) } }'
+rule:
+  any:
+    - pattern: emit($$$)
+    - pattern: emitAll($$$)
+  inside:
+    stopBy: end
+    any:
+      - pattern: launch { $$$ }
+      - pattern: launch($$$) { $$$ }
+      - pattern: async { $$$ }
+      - pattern: async($$$) { $$$ }
+      - pattern: $S.launch { $$$ }
+      - pattern: $S.async { $$$ }
+    inside:
+      stopBy: end
+      any:
+        - pattern: flow { $$$ }
+        - pattern: flow<$T> { $$$ }
+---
+id: kt-sequential-hot-collects
+language: kotlin
+severity: warning
+message: '[FLOW-19]狀態流/事件流不會結束,前一個 collect 之後的 collect 永遠不會執行;改成每條各自 launch,或用 combine/merge'
+rule:
+  all:
+    - kind: call_expression
+    - any:
+        - pattern: $A.collect { $$$ }
+        - pattern: $A.collect($$$)
+        - pattern: $A.collectLatest { $$$ }
+    - inside:
+        kind: statements
+    - follows:
+        stopBy: end
+        kind: call_expression
+        regex: '(?i)^[\w.?]*(state|event|effect)s?(flow)?\s*\.\s*(collect|collectLatest)\b'
+---
+id: kt-stateflow-noop-operator
+language: kotlin
+severity: warning
+message: '[FLOW-21]對 StateFlow 套 distinctUntilChanged/flowOn/conflate/cancellable 沒有效果;改成拿掉,要換上游執行緒就在 stateIn 之前 .flowOn(io)'
+rule:
+  any:
+    - pattern: $S.distinctUntilChanged()
+    - pattern: $S.flowOn($$$)
+    - pattern: $S.conflate()
+    - pattern: $S.cancellable()
+constraints:
+  S:
+    regex: '(?is)(^[\w.]*state(flow)?$)|(\.asStateFlow\(\)$)|(\.stateIn\(.*\)$)'
+---
+id: kt-consumeasflow-as-property
+language: kotlin
+severity: warning
+message: '[FLOW-28]consumeAsFlow() 只能收集一次,放在屬性上被重新訂閱就丟 IllegalStateException;多處收集改用 receiveAsFlow() 或 SharedFlow'
+rule:
+  pattern: $C.consumeAsFlow()
+  inside:
+    stopBy: end
+    kind: property_declaration
+    inside:
+      kind: class_body
+---
+id: kt-flow-catch-before-oneach
+language: kotlin
+severity: warning
+message: '[FLOW-11].catch 只接上游,放在 onEach 之前接不到 onEach 丟的例外;改成 .catch 放在所有會丟例外的中間運算子之後'
+rule:
+  any:
+    - pattern: $F.catch { $$$ }.onEach { $$$ }
+    - pattern: $F.catch { $$$ }.onEach($$$)
+  not:
+    inside:
+      pattern: $Y.catch { $$$ }
+      stopBy: end
+---
+id: kt-nested-collect
+language: kotlin
+severity: warning
+message: '[FLOW-1]collect 裡又 collect,內層永不結束、外層新值卡住,畫面只反映部分來源;改用 combine(a, b) { x, y -> … }'
+rule:
+  any:
+    - pattern: $B.collect { $$$ }
+    - pattern: $B.collectLatest { $$$ }
+  inside:
+    any:
+      - pattern: $A.collect { $$$ }
+      - pattern: $A.collectLatest { $$$ }
+    # 內外層之間隔了 launch/async 就是另開協程,不卡外層;往上找到它就停
+    stopBy:
+      kind: call_expression
+      regex: '^(\w+\.)?(launch|async)\s*[({]'
+---
+id: kt-withcontext-in-flow
+language: kotlin
+severity: error
+message: '[FLOW-4]flow { } 裡用 withContext 換執行緒,執行期丟 Flow invariant is violated;改用 flow { emit(load()) }.flowOn(io)'
+rule:
+  pattern: withContext($$$)
+  has:
+    stopBy: end
+    any:
+      - pattern: emit($$$)
+      - pattern: emitAll($$$)
+  inside:
+    any:
+      - pattern: flow { $$$ }
+      - pattern: flow<$T> { $$$ }
+    stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules/perf.yml b/configs/ast-grep/kotlin-android/rules/perf.yml
new file mode 100644
index 000000000..4f6a8b409
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules/perf.yml
@@ -0,0 +1,320 @@
+id: kt-runblocking-in-main-code
+language: kotlin
+severity: warning
+message: '[PERF-4]正式程式碼裡 runBlocking 會卡住呼叫它的執行緒(在主執行緒就是 ANR);改用 lifecycleScope.launch / viewModelScope.launch,或把呼叫端改成 suspend'
+ignores:
+  - '**/src/test*/**'
+  - '**/src/androidTest*/**'
+  - '**/src/testFixtures/**'
+  - '**/*Test.kt'
+  - '**/src/*Test/**'
+rule:
+  any:
+    - pattern: runBlocking { $$$ }
+    - pattern: runBlocking($$$) { $$$ }
+  not:
+    any:
+      - inside:
+          stopBy: end
+          kind: function_declaration
+          has:
+            kind: simple_identifier
+            regex: ^main$
+      - inside:
+          stopBy: end
+          kind: class_declaration
+          has:
+            kind: delegation_specifier
+            regex: ^(okhttp3\.)?(Interceptor|Authenticator)$
+---
+id: kt-network-on-main-thread
+language: kotlin
+severity: warning
+message: '[PERF-2]Activity/Fragment 裡同步做網路請求,會丟 NetworkOnMainThreadException 或卡畫面;改成 suspend fun,或 withContext(ioDispatcher) { … }'
+rule:
+  any:
+    - pattern: $C.execute()
+    - pattern: $U.openStream()
+    - pattern: $U.openConnection()
+  inside:
+    kind: class_declaration
+    has:
+      kind: delegation_specifier
+      regex: (Activity|Fragment)\b
+      stopBy: end
+    stopBy: end
+  not:
+    any:
+      - regex: Task\(.*\)\.execute\(\)$
+      - inside:
+          any:
+            - pattern: withContext($$$) { $$$ }
+            - pattern: thread { $$$ }
+            - pattern: thread($$$) { $$$ }
+            - pattern: Thread { $$$ }
+            - pattern: $S.launch(Dispatchers.IO) { $$$ }
+            - pattern: launch(Dispatchers.IO) { $$$ }
+            - pattern: $E.execute { $$$ }
+            - pattern: $E.submit { $$$ }
+          stopBy: end
+---
+id: kt-datastore-runblocking-first
+language: kotlin
+severity: warning
+message: '[PERF-4]runBlocking 裡讀 DataStore,在主執行緒會卡住讀檔造成 ANR;改用 suspend 讀取,啟動時的預載改成非同步'
+rule:
+  any:
+    - pattern: runBlocking { $$$ }
+    - pattern: runBlocking($$$) { $$$ }
+  has:
+    kind: call_expression
+    regex: (?i)(datastore|prefs|preferences)\.data\.first
+    stopBy: end
+---
+id: kt-stream-not-closed
+language: kotlin
+severity: warning
+message: '[PERF-11]開了檔案或 ContentResolver 的串流卻沒關,檔案描述元會洩漏;改成 .use { }'
+rule:
+  any:
+    - pattern: FileInputStream($$$)
+    - pattern: FileOutputStream($$$)
+    - pattern: $R.openInputStream($$$)
+    - pattern: $R.openOutputStream($$$)
+  not:
+    any:
+      - inside:
+          any:
+            - pattern: $X.use { $$$ }
+            - pattern: $X?.use { $$$ }
+          stopBy: end
+      - inside:
+          kind: function_body
+          has:
+            any:
+              - pattern: $Y.close()
+              - pattern: $Y?.close()
+            stopBy: end
+          stopBy: end
+---
+id: kt-catch-log-return-empty
+language: kotlin
+severity: warning
+message: '[PERF-34]例外只記 log 就回空清單或 null,上層分不出沒資料還是出錯;改成往上回報錯誤狀態,只 catch 具體型別'
+rule:
+  kind: catch_block
+  has:
+    any:
+      - pattern: Log.$M($$$)
+      - pattern: Timber.$M($$$)
+      - pattern: $E.printStackTrace()
+    stopBy: end
+  regex: ((emptyList|emptyMap|emptySet|listOf|mapOf|setOf|emptyFlow)\(\)|\bnull)\s*\}$|return\s+(null|emptyList\(\)|emptyMap\(\)|listOf\(\))
+---
+id: kt-throw-without-cause
+language: kotlin
+severity: warning
+message: '[PERF-35]catch 裡丟新例外只給訊息字串,原本的 cause 丟了、追不到根因;改成 throw MyError("x", e)'
+rule:
+  pattern: throw $E($S)
+  inside:
+    kind: catch_block
+    stopBy: end
+constraints:
+  S:
+    regex: '^"'
+---
+# P4
+id: kt-runblocking-in-ui-code
+language: kotlin
+severity: warning
+message: '[PERF-4]畫面、ViewModel、Receiver 裡 runBlocking 會卡住主執行緒(ANR);改用 lifecycleScope.launch/viewModelScope.launch'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  any:
+    - pattern: runBlocking { $$$ }
+    - pattern: runBlocking($$$) { $$$ }
+  inside:
+    any:
+      - kind: class_declaration
+        has:
+          kind: delegation_specifier
+          regex: '\b(\w*Activity|\w*Fragment|\w*ViewModel|BroadcastReceiver|Application|Service|\w*View)\b'
+      - kind: function_declaration
+        has:
+          kind: modifiers
+          has:
+            kind: annotation
+            regex: '^@Composable\b'
+    stopBy: end
+---
+# P11
+id: kt-trampoline-activity
+language: kotlin
+severity: warning
+message: '[PERF-9]onCreate 只做 startActivity 再 finish 的跳板 Activity 多建一次畫面、拖慢啟動;改用 SplashScreen API(installSplashScreen)直接進主畫面'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  kind: function_declaration
+  has:
+    kind: simple_identifier
+    regex: '^onCreate$'
+  all:
+    - has:
+        pattern: startActivity($$$)
+        stopBy: end
+    - has:
+        pattern: finish()
+        stopBy: end
+    - not:
+        has:
+          regex: '^setContent(View)?\b'
+          stopBy: end
+  inside:
+    kind: class_declaration
+    has:
+      kind: delegation_specifier
+      regex: 'Activity\b'
+    stopBy: end
+---
+# P36
+id: kt-unbounded-bitmap-cache
+language: kotlin
+severity: warning
+message: '[PERF-17]用 HashMap 之類的無上限集合快取 Bitmap,遲早 OOM;改用 LruCache 並以 byteCount 設大小上限'
+rule:
+  any:
+    - pattern: HashMap<$K, Bitmap>($$$)
+    - pattern: LinkedHashMap<$K, Bitmap>($$$)
+    - pattern: ConcurrentHashMap<$K, Bitmap>($$$)
+    - pattern: mutableMapOf<$K, Bitmap>($$$)
+    - pattern: hashMapOf<$K, Bitmap>($$$)
+    - pattern: HashMap<$K, Bitmap?>($$$)
+    - pattern: LinkedHashMap<$K, Bitmap?>($$$)
+    - pattern: ConcurrentHashMap<$K, Bitmap?>($$$)
+    - pattern: mutableMapOf<$K, Bitmap?>($$$)
+    - pattern: hashMapOf<$K, Bitmap?>($$$)
+    - kind: property_declaration
+      all:
+        - has:
+            kind: variable_declaration
+            regex: ':\s*(Mutable|Hash|LinkedHash|ConcurrentHash)Map<[^>]*,\s*Bitmap\??>'
+        - regex: '=\s*(mutableMapOf|hashMapOf|HashMap|LinkedHashMap|ConcurrentHashMap)\(\)'
+---
+# P44
+id: kt-reflection-in-hot-path
+language: kotlin
+severity: warning
+message: '[PERF-25]每次綁定/繪製都跑反射(Class.forName、::class.memberProperties、getDeclaredField),又慢又會被 R8 混淆弄壞;改用程式碼生成或在初始化時快取一次'
+rule:
+  any:
+    - pattern: Class.forName($$$)
+    - pattern: $X::class.memberProperties
+    - pattern: $X::class.declaredMemberProperties
+    - pattern: $X::class.memberFunctions
+    - kind: call_expression
+      regex: '\.(getDeclaredField|getDeclaredMethod|getMethod|getField|getDeclaredFields|getDeclaredMethods)\('
+  inside:
+    kind: function_declaration
+    has:
+      kind: simple_identifier
+      regex: '^(onBindViewHolder|onBind|onDraw|dispatchDraw|onMeasure|onLayout|getView|onScrolled|onDrawFrame|doFrame)$'
+    stopBy: end
+---
+# P49
+id: kt-data-class-mutable-field
+language: kotlin
+severity: warning
+message: '[PERF-30]data class 帶 var 或可變集合,放進 HashSet/HashMap 後雜湊會變、StateFlow 判相等時不發新值;改成 val 加不可變集合,用 copy 產生新值'
+rule:
+  kind: class_parameter
+  any:
+    # Room @Entity 的 var 是框架要的寫法(主鍵回填),不算;豁免只涵蓋 var,可變集合欄位照報(代碼審 r2 規則B Finding 12)
+    - all:
+        - has:
+            kind: binding_pattern_kind
+            regex: '^var$'
+        - not:
+            inside:
+              kind: class_declaration
+              has:
+                kind: modifiers
+                has:
+                  kind: annotation
+                  regex: '^@(androidx\.room\.)?Entity\b'
+              stopBy: end
+    - has:
+        any:
+          - kind: user_type
+          - kind: nullable_type
+        regex: '^(MutableList|MutableSet|MutableMap|MutableCollection|ArrayList|HashMap|HashSet|LinkedHashMap|LinkedHashSet|MutableStateFlow)\b'
+  inside:
+    kind: primary_constructor
+    inside:
+      kind: class_declaration
+      has:
+        kind: modifiers
+        has:
+          kind: class_modifier
+          regex: '^data$'
+---
+# P51
+id: kt-data-class-array-field
+language: kotlin
+severity: warning
+message: '[PERF-32]data class 的陣列欄位用預設 equals 只比參照,內容一樣也不相等;改用 List,或覆寫 equals/hashCode 用 contentEquals/contentHashCode'
+rule:
+  kind: class_parameter
+  has:
+    any:
+      - kind: user_type
+      - kind: nullable_type
+    regex: '^(ByteArray|IntArray|LongArray|ShortArray|CharArray|FloatArray|DoubleArray|BooleanArray|UByteArray|Array<.*>)\??$'
+  inside:
+    kind: primary_constructor
+    inside:
+      kind: class_declaration
+      all:
+        - has:
+            kind: modifiers
+            has:
+              kind: class_modifier
+              regex: '^data$'
+        - not:
+            has:
+              kind: class_body
+              regex: '\bfun\s+equals\b'
+---
+id: kt-uistate-mutable-field
+language: kotlin
+severity: warning
+message: '[PERF-30]UiState 帶 var 或可變集合,改了內容參照不變、畫面不更新也不執行緒安全;改成 val 欄位與唯讀 List,變更用 copy(items = items + x)'
+rule:
+  all:
+    - any:
+        - kind: class_parameter
+        - kind: property_declaration
+    - any:
+        - has:
+            kind: binding_pattern_kind
+            regex: ^var$
+        - has:
+            kind: user_type
+            regex: ^(MutableList|MutableMap|MutableSet|ArrayList|HashMap|HashSet|LinkedList|MutableStateFlow|MutableLiveData)\b
+            stopBy: end
+  inside:
+    kind: class_declaration
+    all:
+      - has:
+          kind: modifiers
+          has:
+            regex: ^data$
+            stopBy: end
+      - any:
+          - has:
+              kind: type_identifier
+              regex: (State|UiModel)$
+          - has:
+              kind: delegation_specifier
+              regex: (State|UiModel)\b
+    stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules/state.yml b/configs/ast-grep/kotlin-android/rules/state.yml
new file mode 100644
