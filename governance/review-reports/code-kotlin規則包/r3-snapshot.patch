+                        regex: '^(LaunchedEffect|SideEffect|DisposableEffect|onDispose|remember\w*|derivedStateOf|produceState|snapshotFlow|clickable|combinedClickable|selectable|toggleable|pointerInput|detectTapGestures|detectDragGestures|launch|async|withContext|LifecycleEventEffect|LifecycleResumeEffect|LifecycleStartEffect|BackHandler|Canvas|drawBehind|drawWithContent|drawWithCache|layout|graphicsLayer|dropUnlessResumed|dropUnlessStarted|on[A-Z]\w*)$'
