+id: kt-try-wraps-launch
+language: kotlin
+severity: error
+message: '[CO-7]try/catch 包在 launch 外面接不到協程裡的例外(launch 立刻回傳);改成 launch { try { … } catch (e: IOException) { … } }'
+rule:
+  any:
+    - pattern: $S.launch { $$$ }
+    - pattern: $S.launch($$$) { $$$ }
+    - pattern: launch { $$$ }
+    - pattern: launch($$$) { $$$ }
+  inside:
+    any:
+      - kind: statements
