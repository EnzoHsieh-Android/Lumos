diff --git a/configs/ast-grep/kotlin-android/check.py b/configs/ast-grep/kotlin-android/check.py
new file mode 100644
index 000000000..d5aa915cf
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/check.py
@@ -0,0 +1,357 @@
+#!/usr/bin/env python3
+"""Kotlin 規則包自我檢查(Projects/Android協程與API寫法機械檢查標準_計劃 S1、S2)。
+
+白話:每條規則拿自己的壞例樣本跑,要至少命中兩處;拿好例樣本跑,要零命中而且好例至少兩段;
+規則訊息要以型錄裡真的有的編號開頭、不超過 120 字、寫明修法、不含 $ 變數;
+另外有一棵「祖先目錄叫 test 的正式碼」樣本,只該掃測試碼的規則對它不准命中。
+
+用法:python3 check.py [--sg <ast-grep 執行檔>] [--json]
+退出碼:0 全過、1 有問題、2 找不到 ast-grep。零依賴(只用標準庫)。
+"""
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+CATALOG = HERE.parents[2] / "skills" / "kotlin-idioms" / "checks-catalog.md"
+# 三級:rules=會擋(error/warning);rules-review=語意覆核級(info,形狀分不出對錯、要盲判代理逐筆判,
+# [[Projects/規則包語意覆核級命中走盲判_計劃]] 接上前不擋);rules-hints=提示級(hint,預設不接)
+CONFIGS = (("rules", "sgconfig.yml"), ("rules-review", "sgconfig-review.yml"), ("rules-hints", "sgconfig-hints.yml"))
+SEVERITIES = ("error", "warning", "info", "hint")
+_DIR_SEVERITY = {"rules-hints": ("hint",), "rules-review": ("info",), "rules": ("error", "warning")}
+MSG_MAX = 120
+REVIEW_FP_PREFIX = "review-fp-"   # 好例樣本裡記「語意覆核級規則已知會誤報、要靠盲判排除」的檔名開頭
+SCAN_TIMEOUT = 120     # 一次掃描的上限(秒);正常不到一秒,卡住時不要拖到外層測試逾時          # 新增告警閘解析 SARIF 時把訊息截在 120 字
+# 好例「一段」= 頂格開頭的宣告(函式、類別、物件、介面、帶註記的宣告)
+_DECL_RE = re.compile(r"^(?:@|fun |suspend fun |private |internal |public |class |data class |object |interface |abstract |open |sealed |enum |val |var |inline )")
+# 檢查會談暫存區路徑(型錄落地時要拿掉)
+_SCRATCH_RE = re.compile(r"(/private/tmp/|/tmp/claude-|lumos-scratch|scratchpad/)")
+TEST_ONLY_ANCESTOR = HERE / "samples" / "ancestor-named-test"
+
+
+def _files_block_is_test_only(doc):
+    """這條規則的 files: 區塊(只看那一段,不看 ignores 或訊息)是不是只列測試目錄。"""
+    m = re.search(r"^files:(.*?)(?=^[A-Za-z_\"'][^\n]*:)", doc + "\nzz:", re.M | re.S)
+    if not m:
+        return False
+    block = m.group(1)
+    return bool(re.search(r"src/(test|androidTest|testFixtures)", block)) and "src/main" not in block
+
+
+def load_rules():
+    """讀三個規則目錄 → [{id, severity, message, dir, file}];同一檔多份文件以 --- 分隔。"""
+    rules = []
+    for d, cfg in CONFIGS:
+        for f in sorted((HERE / d).glob("*.yml")):
+            for doc in re.split(r"^---\s*$", f.read_text(encoding="utf-8"), flags=re.M):
+                m = re.search(r"^id:\s*(\S+)", doc, re.M)
+                if not m:
+                    continue
+                sev = re.search(r"^severity:\s*(\S+)", doc, re.M)
+                msg = re.search(r"^message:\s*(.+)$", doc, re.M)
+                text = msg.group(1).strip() if msg else ""
+                if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
+                    text = text[1:-1].replace("''", "'") if text[0] == "'" else text[1:-1]
+                rules.append({"id": m.group(1), "severity": sev.group(1) if sev else "",
+                              "message": text, "dir": d, "config": cfg, "file": f.name,
+                              "test_only": _files_block_is_test_only(doc)})
+    return rules
+
+
+def catalog_ids():
+    """型錄主表裡的編號(〈待查證〉節以後不算)。"""
+    text = CATALOG.read_text(encoding="utf-8")
+    cut = text.find("\n## 情境決策表")   # 主表在決策表之前;決策表的 D-n 與來源索引的編號都不是規則該引的編號
+    main = text if cut < 0 else text[:cut]
+    return {m.group(1) for m in map(_MAIN_ROW_RE.match, main.splitlines()) if m}, text
+
+
+_CELL_RE = re.compile(r'(?<!\\)\|(?=(?:[^`]*`[^`]*`)*[^`]*$)')   # 反引號裡的直線不算欄位分隔
+_MAIN_ROW_RE = re.compile(r"^\|\s*((?:API|FLOW|STATE|CO|UI|ARCH|DATA|TEST|PERF)-\d+)\s*\|")
+_MAIN_COLS = 12      # 編號|名稱|壞寫法形狀|標準寫法|後果|現成規則|級|情境怎麼認|接電方式|通電批次|實測狀態|來源
+_DT_COLS = 7         # 列編號|情境|標準寫法|不適用時|觸發字|對應檢查|來源
+_WEAK_SRC = ("未開頁核對", "搜尋摘要", "無網址")
+# 觸發字停用字表:這些字幾乎每支 Kotlin 檔都有,當觸發字會讓改檔前推列與情境題每次都亮(第二、三批計劃的依賴)
+STOP_TRIGGERS = frozenset((
+    "map", "filter", "forEach", "let", "run", "apply", "also", "with", "if", "else", "when", "try", "catch",
+    "val", "var", "fun", "class", "object", "return", "suspend", "launch", "async", "await", "flow", "Flow",
+    "collect", "first", "take", "list", "List", "remember", "enabled", "Job", "cancel", "data", "String",
+    "Int", "Unit", "null", "true", "false", "this", "it", "get", "set", "value", "state", "State",
+    # r1 接手席點名的(第二、三批設計審):型別名或方法名太泛,出現在大量無關程式裡
+    "Exception", "Result", "Response", "insert", "offset", "sealed", "onClick", "isActive", "key", "test",
+    "version", "size", "token", "edit", "Application", "Intent", "Context", "delay", "Dao", "Repository",
+    # 第三批設計審 r2 通才席:幾乎每支 ViewModel 或資料層都有,當觸發字會讓每次推送都出一堆情境段
+    "suspend fun", "StateFlow", "withContext", "viewModelScope", "Deferred", "Dispatchers.IO", "Dispatchers.Default",
+))
+
+
+def _cells(line):
+    return [c.strip() for c in _CELL_RE.split(line)[1:-1]]
+
+
+def catalog_problems(rules=None):
+    """型錄自己的格式檢查(計劃 S3,與第二、三批要的觸發字停用字、出處要求)。不需要 ast-grep。"""
+    problems = []
+    text = CATALOG.read_text(encoding="utf-8")
+    i_dt, i_pend = text.find("\n## 情境決策表"), text.find("\n## 待查證")
+    if i_dt < 0 or i_pend < 0:
+        return [("<catalog>", "找不到〈情境決策表〉或〈待查證〉節")]
+    main, dt = text[:i_dt], text[i_dt:i_pend]
+    rows, seen = {}, set()
+    # 〈來源縮寫〉表登記過的縮寫才算來源;TBD、TODO 這類大寫佔位字不算
+    i_src = text.find("\n## 來源縮寫")
+    if i_src < 0:
+        return [("<catalog>", "找不到〈來源縮寫〉節(來源欄的縮寫要對照它)")]
+    i_src_end = text.find("\n## ", i_src + 5)
+    abbrs = set(re.findall(r"^\|\s*([A-Z][A-Z0-9-]+)\s*\|", text[i_src:i_src_end if i_src_end >= 0 else len(text)], re.M))
+    for ln in main.splitlines():
+        m = _MAIN_ROW_RE.match(ln)
+        if not m:
+            continue
+        rid, c = m.group(1), _cells(ln)
+        if rid in seen:
+            problems.append((rid, "編號重複"))
+        seen.add(rid)
+        if len(c) != _MAIN_COLS:
+            problems.append((rid, f"欄位數 {len(c)},應為 {_MAIN_COLS}"))
+            continue
+        rows[rid] = c
+        name, std, kind, wire, batch, src = c[1], c[3], c[7], c[8], c[9], c[11]
+        if not std or not wire or not batch:
+            problems.append((rid, "標準寫法、接電方式、通電批次不准空"))
+        if kind.startswith("形狀") and not ("告警帶寫法" in wire or "行為測試或正向約束" in wire):
+            problems.append((rid, "形狀類要有「告警帶寫法」或「行為測試或正向約束」"))
+        if kind.startswith("語意"):
+            if "表態對程式" not in wire:
+                problems.append((rid, "語意類要有「表態對程式」"))
+            if "(人裁)" not in name and "盲判席" not in wire:
+                problems.append((rid, "語意類(沒標人裁)要有「盲判席」"))
+        if "(出處不全)" not in name:
+            if any(w in src for w in _WEAK_SRC):
+                problems.append((rid, "來源還寫著未核對或無網址,要補查證網址或標(出處不全)"))
+            if not (re.search(r"https?://", src) or any(re.search(r"(?<![A-Z0-9-])" + re.escape(a) + r"(?![A-Z0-9-])", src) for a in abbrs)):
+                problems.append((rid, "來源沒有網址或來源縮寫"))
+    referenced, d_seen = set(), []
+    for ln in dt.splitlines():
+        if not re.match(r"^\|\s*D-\d+\s*\|", ln):
+            continue
+        c = _cells(ln)
+        did = c[0]
+        if len(c) != _DT_COLS:
+            problems.append((did, f"決策表欄位數 {len(c)},應為 {_DT_COLS}"))
+            continue
+        d_seen.append(did)
+        trig = [t.strip().strip("`") for t in re.split(r"[、,,]", c[4]) if t.strip()]
+        if c[4].strip() in ("(無)", "\uff08無\uff09"):
+            trig = []      # 刻意不設觸發字:這個情境沒有不常見的字面特徵,不出情境段,只靠規則包與代碼審
+        elif not trig:
+            problems.append((did, "觸發字不准空(刻意不設寫「(無)」)"))
+        bad = [t for t in trig if t in STOP_TRIGGERS]
+        if bad:
+            problems.append((did, "觸發字含常用字:" + "、".join(bad)))
+        if not c[6]:
+            problems.append((did, "來源不准空"))
+        refs = set(re.findall(r"[A-Z]+-\d+", c[5]))
+        for r in sorted(refs - set(rows)):
+            problems.append((did, f"對應檢查 {r} 不在型錄主表"))
+        referenced |= refs
+    want = [f"D-{i}" for i in range(1, len(d_seen) + 1)]
+    if d_seen != want:
+        problems.append(("<決策表>", "列編號要從 D-1 連號"))
+    for rid, c in rows.items():
+        if c[7].startswith("語意") and rid not in referenced and "(出處不全)" not in c[1] and "(人裁)" not in c[1]:
+            problems.append((rid, "語意類沒有被任何決策表列收進去"))
+    if _SCRATCH_RE.search(text):
+        problems.append(("<catalog>", "型錄裡有指向會談暫存區的路徑"))
+    weak_ids = {rid for rid, c in rows.items() if "(出處不全)" in c[1]}
+    for r in rules or []:
+        m = re.match(r"\[([A-Z]+-\d+)\]", r["message"])
+        if m and m.group(1) in weak_ids and r["severity"] != "hint":
+            problems.append((r["id"], f"引用出處不全的 {m.group(1)},只准 hint 級"))
+    return problems
+
+
+def message_problems(rules, cat_ids):
+    """每條規則的 id、severity、放哪個目錄、message 格式(計劃 S2)。不需要 ast-grep。"""
+    problems = []
+    for r in rules:
+        rid, msg = r["id"], r["message"]
+        if not rid.startswith("kt-"):
+            problems.append((rid, "id 要用 kt- 前綴"))
+        if r["severity"] not in SEVERITIES:
+            problems.append((rid, f"severity 只能是 {'/'.join(SEVERITIES)}"))
+        if r["severity"] not in _DIR_SEVERITY.get(r["dir"], ()):
+            problems.append((rid, f"{r['dir']}/ 只收 {'/'.join(_DIR_SEVERITY.get(r['dir'], ()))} 級(hint 放 rules-hints/、info 放 rules-review/)"))
+        m = re.match(r"\[([A-Z]+-\d+)\]", msg)
+        if not m:
+            problems.append((rid, "message 要以 [型錄編號] 開頭"))
+        elif m.group(1) not in cat_ids:
+            problems.append((rid, f"message 的編號 {m.group(1)} 不在型錄主表"))
+        if len(msg) > MSG_MAX:
+            problems.append((rid, f"message {len(msg)} 字,超過 {MSG_MAX}"))
+        if ";" not in msg or not ("改用" in msg or "改成" in msg):
+            problems.append((rid, "message 要有分號,並寫「改用」或「改成」"))
+        if "$" in msg:
+            problems.append((rid, "message 不准含 $"))
+    return problems
+
+
+_TIMED_OUT = [False]   # 一次掃描逾時後,這次自我檢查剩下的掃描都不跑(避免卡住時每次各等滿上限)
+
+
+def scan(sg, cfg, target):
+    """跑一次 ast-grep,回 [(ruleId, file)];失敗或之前已逾時回 None。"""
+    if _TIMED_OUT[0]:
+        return None
+    try:
+        r = subprocess.run([sg, "scan", "--config", str(HERE / cfg), "--json=stream", str(target)],
+                           capture_output=True, text=True, cwd=str(HERE), timeout=SCAN_TIMEOUT)
+    except subprocess.TimeoutExpired:
+        _TIMED_OUT[0] = True
+        return None
+    except OSError:
+        return None
+    if r.returncode not in (0, 1):
+        return None
+    out = []
+    for ln in r.stdout.splitlines():
+        if ln.strip():
+            d = json.loads(ln)
+            out.append((d["ruleId"], d["file"]))
+    return out
+
+
+def loaded_count(sg, cfg):
+    if _TIMED_OUT[0]:
+        return (None, None)
+    try:
+        r = subprocess.run([sg, "scan", "--config", str(HERE / cfg), "--inspect", "summary", str(HERE / "samples" / "good")],
+                           capture_output=True, text=True, cwd=str(HERE), timeout=SCAN_TIMEOUT)
+    except subprocess.TimeoutExpired:
+        _TIMED_OUT[0] = True
+        return (None, None)
+    except OSError:
+        return (None, None)
+    m = re.search(r"effectiveRuleCount=(\d+),skippedRuleCount=(\d+)", r.stderr)
+    return (int(m.group(1)), int(m.group(2))) if m else (None, None)
+
+
+def _sample_owner(f, kind):
+    """命中檔屬於哪條規則的樣本:samples/<kind>/<規則 id>/…;只看規則包底下那一段,祖先目錄叫什麼都不影響。"""
+    p = Path(f)
+    try:
+        p = p.resolve().relative_to(HERE.resolve()) if p.is_absolute() else p
+    except ValueError:
+        return ""
+    parts = p.parts
+    return parts[2] if len(parts) > 2 and parts[0] == "samples" and parts[1] == kind else ""
+
+
+def good_cases(path):
+    n = 0
+    for f in Path(path).rglob("*.kt"):
+        if f.name.startswith(REVIEW_FP_PREFIX):
+            continue      # 已知誤報樣本不算「好例」段數
+        n += sum(1 for ln in f.read_text(encoding="utf-8").splitlines() if _DECL_RE.match(ln))
+    return n
+
+
+def check(sg):
+    _TIMED_OUT[0] = False
+    problems = []
+    rules = load_rules()
+    if not rules:
+        problems.append(("<pack>", "一條規則都沒讀到(rules/、rules-review/、rules-hints/ 都是空的?)"))
+    ids = [r["id"] for r in rules]
+    dup = sorted({i for i in ids if ids.count(i) > 1})
+    if dup:
+        problems.append(("<pack>", "id 重複:" + ", ".join(dup)))
+    cat_ids, _cat_text = catalog_ids()
+    problems += message_problems(rules, cat_ids)
+    problems += catalog_problems(rules)
+    for d, cfg in CONFIGS:
+        want = sum(1 for r in rules if r["dir"] == d)
+        got, skipped = loaded_count(sg, cfg)
+        if got != want or skipped:
+            problems.append(("<pack>", f"{cfg} 載入 {got} 條(略過 {skipped}),規則檔裡有 {want} 個 id"))
+    review_ids = {r["id"] for r in rules if r["dir"] == "rules-review"}
+    # 每份設定檔對壞例、好例各掃一次,再依樣本所在目錄(samples/<bad|good>/<規則 id>/…)歸到各條規則
+    hits = {}
+    for kind in ("bad", "good"):
+        for _d, cfg in CONFIGS:
+            got = scan(sg, cfg, HERE / "samples" / kind)
+            if got is None:
+                problems.append(("<pack>", f"{cfg} 掃 samples/{kind} 跑不起來"))
+                continue
+            for rule_id, f in got:
+                owner = _sample_owner(f, kind)
+                if kind == "good" and owner == rule_id and Path(f).name.startswith(REVIEW_FP_PREFIX) and rule_id in review_ids:
+                    continue      # 語意覆核級規則已知的形狀誤報:記在樣本裡給盲判對照,不算好例誤報
+                hits[(kind, owner, rule_id)] = hits.get((kind, owner, rule_id), 0) + 1
+    for r in rules:
+        rid = r["id"]
+        bad, good = HERE / "samples" / "bad" / rid, HERE / "samples" / "good" / rid
+        if not bad.is_dir():
+            problems.append((rid, "缺壞例樣本 samples/bad/" + rid))
+        else:
+            n = hits.get(("bad", rid, rid), 0)
+            if n < 2:
+                problems.append((rid, f"壞例只命中 {n} 處,至少要 2"))
+        if not good.is_dir():
+            problems.append((rid, "缺好例樣本 samples/good/" + rid))
+        else:
+            n = hits.get(("good", rid, rid), 0)
+            if n:
+                problems.append((rid, f"好例誤報 {n} 處"))
+            if good_cases(good) < 2:
+                problems.append((rid, "好例至少要兩段(頂格宣告算一段)"))
+    test_only = [r for r in rules if r["test_only"]]
+    if test_only:
+        if not TEST_ONLY_ANCESTOR.is_dir():
+            problems.append(("<pack>", "缺 samples/ancestor-named-test(祖先目錄叫 test 的正式碼樣本)"))
+        else:
+            for d, cfg in CONFIGS:
+                got = scan(sg, cfg, TEST_ONLY_ANCESTOR)
+                if got is None:
+                    problems.append(("<pack>", f"{cfg} 掃 samples/ancestor-named-test 跑不起來"))
+                    continue
+                for (i, f) in got:
+                    if any(r["id"] == i for r in test_only):
+                        problems.append((i, "只掃測試碼的規則命中了祖先目錄叫 test 的正式碼:" + f))
+    return rules, problems
+
+
+def main(argv):
+    if "--catalog-only" in argv:
+        probs = catalog_problems(load_rules())
+        for rid, why in probs:
+            print(f"{rid}: {why}")
+        print(f"型錄問題 {len(probs)} 個")
+        return 1 if probs else 0
+    sg = None
+    if "--sg" in argv:
+        i = argv.index("--sg")
+        if i + 1 >= len(argv):
+            print("--sg 後面要給 ast-grep 執行檔路徑", file=sys.stderr)
+            return 2
+        sg = argv[i + 1]
+    sg = sg or shutil.which("ast-grep")   # 不退去找 sg:Linux 上 sg 是切換群組的系統工具
+    if not sg or not os.access(sg, os.X_OK):
+        print("找不到 ast-grep(帶 --sg <路徑>)", file=sys.stderr)
+        return 2
+    rules, problems = check(sg)
+    if "--json" in argv:
+        print(json.dumps({"rules": len(rules), "problems": problems}, ensure_ascii=False))
+    else:
+        for rid, why in problems:
+            print(f"{rid}: {why}")
+        print(f"規則 {len(rules)} 條,問題 {len(problems)} 個")
+    return 1 if problems else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/configs/ast-grep/kotlin-android/rules-hints/api.yml b/configs/ast-grep/kotlin-android/rules-hints/api.yml
new file mode 100644
index 000000000..f6024665f
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/api.yml
@@ -0,0 +1,125 @@
+id: kt-okhttp-body-string-twice
+language: kotlin
+severity: hint
+message: '[API-18]同一段程式讀了兩次 body.string(),同一個 body 第二次讀會丟 IllegalStateException;讀一次存進變數,大檔改用 byteStream()/source() 串流'
+utils:
+  body-string:
+    any:
+      - pattern: $R.body!!.string()
+      - pattern: $R.body?.string()
+      - pattern: $R.body.string()
+rule:
+  inside:
+    kind: statements
+  all:
+    - any:
+        - kind: call_expression
+        - kind: property_declaration
+        - kind: assignment
+        - kind: jump_expression
+    - any:
+        - matches: body-string
+        - has:
+            matches: body-string
+            stopBy: end
+  follows:
+    any:
+      - matches: body-string
+      - has:
+          matches: body-string
+          stopBy: end
+    stopBy: end
+---
+id: kt-ktor-body-without-status
+language: kotlin
+severity: hint
+message: '[API-28]Ktor 預設 expectSuccess = false,非 2xx 不丟例外,直接 body() 會把錯誤頁當資料;改成 expectSuccess = true,或先查 status.isSuccess()'
+rule:
+  any:
+    - pattern: $R.body<$T>()
+    - pattern: $R.body()
+  has:
+    kind: navigation_expression
+    regex: \.(get|post|put|patch|delete|request|submitForm)\s*[({]
+  not:
+    inside:
+      kind: source_file
+      has:
+        pattern: expectSuccess = true
+        stopBy: end
+      stopBy: end
+---
+id: kt-sequential-independent-await
+language: kotlin
+severity: hint
+message: '[API-1]兩個相鄰的呼叫沒有資料依賴卻串著等;改用 coroutineScope { async } 並行'
+# ★要用 all 排順序★:同一層平行寫 follows 與 not.has $A 時,ast-grep 不保證先綁 $A,規則對任何程式都不命中(2026-11-05 樣本實測 0 命中)
+rule:
+  all:
+    - pattern: val $B = $R2.$M2($$$ARGS)
+    - follows:
+        pattern: val $A = $R1.$M1($$$)
+    - not:
+        has:
+          pattern: $A
+          stopBy: end
+    - inside:
+        kind: function_declaration
+        has:
+          kind: modifiers
+          regex: suspend
+        stopBy: end
+---
+id: kt-error-by-message-string
+language: kotlin
+severity: hint
+message: '[API-36]靠例外訊息字串判斷錯誤種類,訊息一改或換語系就失效;改用型別判斷:is SocketTimeoutException、is UnknownHostException'
+utils:
+  message-check:
+    any:
+      - pattern: $E.message?.contains($$$)
+      - pattern: $E.message!!.contains($$$)
+      - pattern: $E.message.contains($$$)
+      - pattern: $E.message?.startsWith($$$)
+      - pattern: $E.localizedMessage?.contains($$$)
+      - pattern: $E.message == $S
+rule:
+  matches: message-check
+  any:
+    - regex: ^(e|ex|exc|exception|t|th|throwable|err|error|cause)\.
+    - inside:
+        any:
+          - kind: catch_block
+          - pattern: $X.catch { $$$ }
+          - pattern: $X.onFailure { $$$ }
+        stopBy: end
+---
+id: kt-stale-response-launch
+language: kotlin
+severity: hint
+message: '[API-8]帶參數的公開函式每次都 launch 新協程寫 state,舊的沒取消會蓋掉新的;改成輸入進 MutableStateFlow 再 flatMapLatest,或先 job?.cancel()'
+rule:
+  kind: function_declaration
+  has:
+    kind: function_value_parameters
+    has:
+      kind: parameter
+      stopBy: end
+  all:
+    - has:
+        pattern: viewModelScope.launch { $$$ }
+        stopBy: end
+        has:
+          stopBy: end
+          any:
+            - kind: assignment
+            - kind: call_expression
+              regex: '(?s)^[\w.?]*\.(update|emit|tryEmit|setValue|postValue)\b'
+    - not:
+        has:
+          regex: '\.cancel\(|cancelAndJoin'
+          stopBy: end
+  not:
+    has:
+      kind: modifiers
+      regex: private
diff --git a/configs/ast-grep/kotlin-android/rules-hints/architecture.yml b/configs/ast-grep/kotlin-android/rules-hints/architecture.yml
new file mode 100644
index 000000000..6f5ff007d
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/architecture.yml
@@ -0,0 +1,148 @@
+id: kt-compose-activity-lifecycle-override
+language: kotlin
+severity: hint
+message: '[ARCH-34]Compose 畫面的 Activity 覆寫 onResume/onStart 做 UI 工作,跟元件生命週期脫鉤;改用 LifecycleStartEffect 或 LifecycleResumeEffect'
+rule:
+  kind: function_declaration
+  all:
+    - has:
+        kind: simple_identifier
+        regex: ^(onResume|onStart|onPause|onStop)$
+    - has:
+        kind: modifiers
+        has:
+          regex: ^override$
+          stopBy: end
+  inside:
+    kind: class_declaration
+    has:
+      any:
+        - pattern: setContent { $$$ }
+        - pattern: setContent($$$) { $$$ }
+      stopBy: end
+    stopBy: end
+---
+id: kt-repo-suspend-snapshot
+language: kotlin
+severity: hint
+message: '[ARCH-51]Repository 用 suspend 回傳一次性快照顯示會變的資料,更新後畫面不跟著變;改成讀取回傳 Flow(getModelStream()),寫入才用 suspend'
+rule:
+  kind: function_declaration
+  all:
+    - has:
+        kind: modifiers
+        has:
+          regex: ^suspend$
+          stopBy: end
+    - has:
+        kind: simple_identifier
+        regex: ^(get|load|fetch|observe)
+    - has:
+        kind: user_type
+    - not:
+        has:
+          kind: user_type
+          regex: ^(Flow|Unit|Boolean|Result)\b
+  inside:
+    kind: class_declaration
+    has:
+      kind: type_identifier
+      regex: (Repository|Repo)$
+    stopBy: end
+---
+id: kt-view-launches-business-logic
+language: kotlin
+severity: hint
+message: '[ARCH-50]Activity/Fragment 用 lifecycleScope 直接呼叫 repository/DAO/API,畫面一關寫入就做一半;改成 UI 只呼叫 vm.onSave(x),交給 viewModelScope'
+rule:
+  any:
+    - pattern: lifecycleScope.launch { $$$ }
+    - pattern: lifecycleScope.launch($$$) { $$$ }
+    - pattern: viewLifecycleOwner.lifecycleScope.launch { $$$ }
+    - pattern: viewLifecycleOwner.lifecycleScope.launch($$$) { $$$ }
+  has:
+    stopBy: end
+    kind: navigation_expression
+    has:
+      nthChild: 1
+      kind: simple_identifier
+      regex: '(?i)(repo|repository|dao|api|database)$'
+---
+# P13(Context)
+id: kt-static-holds-context
+language: kotlin
+severity: hint
+message: '[ARCH-44]object/companion 存 Context,傳進來的若是 Activity 就整個洩漏;改成只存 context.applicationContext'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  kind: property_declaration
+  has:
+    kind: variable_declaration
+    regex: ':\s*Context\??$'
+  not:
+    any:
+      - has:
+          kind: variable_declaration
+          regex: '^(?i:app\w*context)\b'
+      - regex: 'applicationContext'
+  inside:
+    kind: class_body
+    inside:
+      any:
+        - kind: companion_object
+        - kind: object_declaration
+---
+id: kt-click-navigate-unguarded
+language: kotlin
+severity: hint
+message: '[ARCH-3]點擊直接 navigate,連點兩下會崩潰;Compose 改用 onClick = dropUnlessResumed { },View 先比對 currentDestination?.id'
+rule:
+  any:
+    - pattern: $V.setOnClickListener { $$$ }
+    - pattern: setOnClickListener { $$$ }
+    - pattern: $M.clickable { $$$ }
+    - kind: value_argument
+      regex: ^onClick\s*=\s*\{
+  has:
+    pattern: $N.navigate($$$)
+    stopBy: end
+  not:
+    has:
+      kind: simple_identifier
+      regex: ^currentDestination$
+      stopBy: end
+---
+id: kt-ui-uses-repository
+language: kotlin
+severity: hint
+message: '[ARCH-50]畫面層直接拿 Repository/UseCase,繞過 ViewModel、轉螢幕就中斷;改成 UI 只呼叫 vm.onSave(x),ViewModel 內 viewModelScope.launch'
+rule:
+  any:
+    - all:
+        - any:
+            - kind: property_declaration
+            - kind: class_parameter
+        - has:
+            kind: user_type
+            regex: ^\w*(Repository|UseCase)$
+            stopBy: end
+        - inside:
+            kind: class_declaration
+            has:
+              kind: delegation_specifier
+              regex: (Activity|Fragment)\(
+            stopBy: end
+    - all:
+        - kind: parameter
+        - has:
+            kind: user_type
+            regex: ^\w*(Repository|UseCase)$
+            stopBy: end
+        - inside:
+            kind: function_declaration
+            has:
+              kind: modifiers
+              has:
+                kind: annotation
+                regex: ^@Composable$
+            stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules-hints/compose.yml b/configs/ast-grep/kotlin-android/rules-hints/compose.yml
new file mode 100644
index 000000000..1d7eff4c9
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/compose.yml
@@ -0,0 +1,171 @@
+id: kt-viewmodel-in-reusable-composable
+language: kotlin
+severity: hint
+message: '[UI-10]可重用元件(列表項、卡片)裡取 ViewModel,元件跟 ViewModel 綁死、預覽與重用都壞;改成只有畫面層取 VM,元件用提升的狀態與回呼'
+rule:
+  any:
+    - pattern: viewModel()
+    - pattern: viewModel<$T>()
+    - pattern: viewModel($$$)
+    - pattern: hiltViewModel()
+    - pattern: hiltViewModel<$T>()
+    - pattern: hiltViewModel($$$)
+  inside:
+    kind: function_body
+    stopBy: end
+    inside:
+      kind: function_declaration
+      has:
+        kind: modifiers
+        has:
+          kind: annotation
+          regex: ^@Composable$
+      not:
+        has:
+          kind: simple_identifier
+          regex: (Screen|Route|Destination|Page|NavHost|NavGraph|Graph|App)$
+  not:
+    inside:
+      any:
+        - pattern: composable($$$) { $$$ }
+        - pattern: composable<$R> { $$$ }
+        - pattern: composable<$R>($$$) { $$$ }
+      stopBy: end
+---
+id: kt-compose-state-copies-param
+language: kotlin
+severity: hint
+message: '[UI-29]remember { mutableStateOf(參數) } 只在第一次組建拷貝,父層傳新值會被忽略;改成直接用參數,或 remember(param) { mutableStateOf(param) }'
+rule:
+  any:
+    - pattern: remember { mutableStateOf($X) }
+    - pattern: rememberSaveable { mutableStateOf($X) }
+    - pattern: remember { mutableIntStateOf($X) }
+    - pattern: remember { mutableFloatStateOf($X) }
+    - pattern: remember { mutableLongStateOf($X) }
+  inside:
+    kind: function_declaration
+    has:
+      kind: modifiers
+      has:
+        kind: annotation
+        regex: ^@Composable
+    stopBy: end
+constraints:
+  X:
+    kind: value_argument
+    has:
+      any:
+        - kind: simple_identifier
+        - kind: navigation_expression
+    regex: ^[a-z]
+---
+id: kt-compose-lazy-hetero-no-contenttype
+language: kotlin
+severity: hint
+message: '[UI-48]items 內容用 when 分型別卻沒給 contentType,不同型別的項目互相回收、複用差;改用 items(mixed, key = { it.id }, contentType = { it::class })'
+rule:
+  any:
+    - pattern: items($$$) { $$$ }
+    - pattern: itemsIndexed($$$) { $$$ }
+  has:
+    kind: when_entry
+    has:
+      kind: when_condition
+      has:
+        kind: type_test
+    stopBy: end
+  not:
+    has:
+      kind: value_arguments
+      has:
+        kind: value_argument
+        has:
+          kind: simple_identifier
+          regex: ^contentType$
+      stopBy: end
+---
+id: kt-compose-lazy-item-multiple-elements
+language: kotlin
+severity: hint
+message: '[UI-53]一個 item { } 裡並排好幾個元件,捲動索引與回收都以整包計;改成拆開 item { A() }; item { B() }'
+rule:
+  any:
+    - pattern: item { $$$ }
+    - pattern: item($$$) { $$$ }
+  has:
+    kind: call_suffix
+    has:
+      kind: annotated_lambda
+      has:
+        kind: lambda_literal
+        has:
+          kind: statements
+          all:
+            - has:
+                kind: call_expression
+                nthChild: 1
+                regex: ^[A-Z]
+                not:
+                  regex: '^(Spacer|Divider|HorizontalDivider|VerticalDivider)\b'
+            - has:
+                kind: call_expression
+                nthChild: 2
+                regex: ^[A-Z]
+                not:
+                  regex: '^(Spacer|Divider|HorizontalDivider|VerticalDivider)\b'
+---
+id: kt-compose-local-fake-default
+language: kotlin
+severity: hint
+message: '[UI-76]compositionLocalOf 的預設值直接 new 物件,忘了 provide 會靜默用到假物件;改成 compositionLocalOf<Foo> { error("No Foo provided") }'
+rule:
+  any:
+    - pattern: compositionLocalOf { $C($$$) }
+    - pattern: compositionLocalOf<$T> { $C($$$) }
+    - pattern: staticCompositionLocalOf { $C($$$) }
+    - pattern: staticCompositionLocalOf<$T> { $C($$$) }
+constraints:
+  C:
+    regex: ^[A-Z]\w*$
+    not:
+      regex: ^(Color|Dp|TextUnit|TextStyle|Offset|Size|DpSize|PaddingValues|IntOffset|IntSize|Shapes|Typography|ColorScheme|RoundedCornerShape|Locale)$
+---
+id: kt-compose-clickable-no-role
+language: kotlin
+severity: hint
+message: '[UI-107]非按鈕元件用 clickable 沒給 role/onClickLabel,讀屏不知道能操作、按了會怎樣;改用 clickable(role = Role.Button, onClickLabel = …) { }'
+rule:
+  any:
+    - pattern: $M.clickable { $$$ }
+    - pattern: $M.clickable($$$) { $$$ }
+    - pattern: $M.clickable($$$)
+  not:
+    has:
+      kind: call_suffix
+      has:
+        kind: value_arguments
+        has:
+          kind: value_argument
+          has:
+            kind: simple_identifier
+            regex: ^(role|onClickLabel)$
+---
+id: kt-compose-preview-no-theme
+language: kotlin
+severity: hint
+message: '[UI-103]預覽沒包 App 的主題,看到的顏色字型跟實機不同;改成 AppTheme { Screen() }'
+rule:
+  kind: function_declaration
+  has:
+    kind: modifiers
+    has:
+      kind: annotation
+      regex: ^@Preview
+  not:
+    has:
+      kind: function_body
+      has:
+        kind: simple_identifier
+        regex: Theme$
+        stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules-hints/coroutines.yml b/configs/ast-grep/kotlin-android/rules-hints/coroutines.yml
new file mode 100644
index 000000000..fd35ef169
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/coroutines.yml
@@ -0,0 +1,161 @@
+id: kt-cancel-then-proceed
+language: kotlin
+severity: hint
+message: '[CO-17]cancel() 只是發出取消請求,下一行時舊工作可能還在跑;改用 job.cancelAndJoin() 等它停下'
+rule:
+  all:
+    - any:
+        - pattern: $J.cancel()
+        - pattern: $J?.cancel()
+    - regex: '(?i)job\??\.cancel\(\)$'
+    - inside:
+        kind: statements
+    - precedes:
+        stopBy:
+          not:
+            any:
+              - kind: line_comment
+              - kind: multiline_comment
+        not:
+          any:
+            - kind: line_comment
+            - kind: multiline_comment
+            - pattern: $J.join()
+            - pattern: $J?.join()
+            - pattern: $J = $$$
+---
+id: kt-lazy-async-never-cancelled
+language: kotlin
+severity: hint
+message: '[CO-18]async(start = LAZY) 只在部分路徑 await,沒走到的那顆不會啟動也不會結束,父 scope 永遠等它;不用時明確 cancel(),或改成條件成立才建立'
+rule:
+  kind: property_declaration
+  all:
+    - has:
+        kind: variable_declaration
+        has:
+          kind: simple_identifier
+          pattern: $D
+    - has:
+        kind: call_expression
+        regex: '^(\w+\.)?async\s*\('
+        has:
+          kind: call_suffix
+          has:
+            kind: value_arguments
+            has:
+              kind: value_argument
+              regex: \bLAZY\b
+    - not:
+        inside:
+          kind: statements
+          has:
+            stopBy: end
+            any:
+              - pattern: $D.cancel()
+              - pattern: $D.start()
+              - pattern: awaitAll($$$)
+    - not:
+        precedes:
+          stopBy: end
+          any:
+            - pattern: $D.await()
+            - pattern: val $V = $D.await()
+            - pattern: return $D.await()
+---
+id: kt-fire-and-forget-api
+language: kotlin
+severity: hint
+message: '[CO-43]公開函式本體只有 scope.launch,呼叫端無法等待完成也接不到錯誤;資料層改成 suspend fun,或回傳 Job'
+rule:
+  kind: function_declaration
+  all:
+    - has:
+        kind: function_body
+        has:
+          kind: statements
+          all:
+            - has:
+                any:
+                  - pattern: $S.launch { $$$ }
+                  - pattern: $S.launch($$$) { $$$ }
+            - not:
+                has:
+                  nthChild: 2
+    - not:
+        has:
+          kind: user_type
+    - not:
+        has:
+          kind: receiver_type
+          regex: (ViewModel|Activity|Fragment|Service|Receiver)$
+    - not:
+        has:
+          kind: modifiers
+          has:
+            regex: ^(suspend|private|override|protected|internal)$
+            stopBy: end
+    - not:
+        inside:
+          stopBy: end
+          kind: class_declaration
+          has:
+            stopBy: end
+            kind: delegation_specifier
+            regex: \b(ViewModel|AndroidViewModel|Activity|AppCompatActivity|ComponentActivity|Fragment|Service|LifecycleService|BroadcastReceiver)\b
+---
+id: kt-parallel-io-unbounded
+language: kotlin
+severity: hint
+message: '[CO-30]迴圈裡對每個元素開 async/launch(Dispatchers.IO),量大時佔滿 IO 執行緒、打爆後端;改用 io.limitedParallelism(8) 或 Semaphore.withPermit 限流'
+rule:
+  all:
+    - kind: call_expression
+      regex: '^(async|launch)\s*\(\s*Dispatchers\.IO\s*\)'
+    - inside:
+        stopBy: end
+        any:
+          - pattern: $C.map { $$$ }
+          - pattern: $C.forEach { $$$ }
+          - pattern: $C.mapIndexed { $$$ }
+          - pattern: $C.forEachIndexed { $$$ }
+          - kind: for_statement
+    - not:
+        has:
+          stopBy: end
+          pattern: $S.withPermit { $$$ }
+---
+id: kt-runcatching-in-suspend
+language: kotlin
+severity: hint
+message: '[CO-2]suspend 函式裡用 runCatching 會把 CancellationException 包成失敗吞掉;改用會重拋 CancellationException 的 suspendRunCatching'
+rule:
+  any:
+    - pattern: runCatching { $$$ }
+    - pattern: $R.runCatching { $$$ }
+  not:
+    inside:
+      kind: navigation_expression
+      inside:
+        kind: call_expression
+        regex: '(?s)CancellationException.*\bthrow\b|\bthrow\b.*CancellationException'
+  inside:
+    kind: function_declaration
+    has:
+      kind: modifiers
+      has:
+        regex: ^suspend$
+        stopBy: end
+    stopBy: end
+---
+id: kt-mutex-reentrant
+language: kotlin
+severity: hint
+message: '[CO-37]Mutex 不可重入,withLock 裡再鎖同一把會永遠卡住;改成拆出不加鎖的內部函式 helperLocked() 給外層呼叫'
+rule:
+  pattern: $M.withLock { $$$ }
+  has:
+    stopBy: end
+    any:
+      - pattern: $M.withLock { $$$ }
+      - pattern: $M.lock()
diff --git a/configs/ast-grep/kotlin-android/rules-hints/data.yml b/configs/ast-grep/kotlin-android/rules-hints/data.yml
new file mode 100644
index 000000000..206bb5e97
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/data.yml
@@ -0,0 +1,35 @@
+id: kt-file-write-not-atomic
+language: kotlin
+severity: hint
+message: '[DATA-26]writeText/writeBytes 直接覆蓋原檔,寫到一半當機或斷電就留下壞檔;重要資料改用 AtomicFile,或先寫暫存檔再 renameTo'
+rule:
+  any:
+    - pattern: $F.writeText($$$)
+    - pattern: $F.writeBytes($$$)
+  not:
+    inside:
+      kind: function_body
+      has:
+        any:
+          - pattern: $X.renameTo($$$)
+          - pattern: Files.move($$$)
+          - regex: AtomicFile
+        stopBy: end
+      stopBy: end
+---
+id: kt-work-enqueue-not-unique
+language: kotlin
+severity: hint
+message: '[DATA-30]用 enqueue 排同步類工作會重複排進佇列、同時跑好幾份;改用 enqueueUniqueWork(name, KEEP 或 APPEND_OR_REPLACE, request)'
+rule:
+  kind: call_expression
+  regex: (?i)^(WorkManager\.getInstance\([^)]*\)|\w*workmanager\w*)\.enqueue\(
+---
+id: kt-work-policy-replace
+language: kotlin
+severity: hint
+message: '[DATA-30]ExistingWorkPolicy.REPLACE 會打斷正在跑的同名工作;改用 ExistingWorkPolicy.KEEP,要排隊接續用 APPEND_OR_REPLACE'
+rule:
+  any:
+    - pattern: ExistingWorkPolicy.REPLACE
+    - pattern: ExistingPeriodicWorkPolicy.REPLACE
diff --git a/configs/ast-grep/kotlin-android/rules-hints/flow.yml b/configs/ast-grep/kotlin-android/rules-hints/flow.yml
new file mode 100644
index 000000000..bcb2cd15f
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/flow.yml
@@ -0,0 +1,108 @@
+id: kt-catch-then-collect-lambda
+language: kotlin
+severity: hint
+message: '[FLOW-10].catch 只管上游,接不到 collect { } 裡丟的例外;改成會丟的邏輯放 .onEach { }.catch { }.collect()'
+rule:
+  any:
+    - pattern: $F.catch { $$$ }.collect { $$$ }
+    - pattern: $F.catch { $$$ }.collectLatest { $$$ }
+  has:
+    kind: call_suffix
+    has:
+      kind: annotated_lambda
+      has:
+        kind: lambda_literal
+        has:
+          kind: statements
+---
+id: kt-oncompletion-ignores-cause
+language: kotlin
+severity: hint
+message: '[FLOW-13]onCompletion 在失敗與取消時也會跑,沒看 cause 就當成功會顯示錯的狀態;改成 onCompletion { cause -> if (cause == null) showDone() }'
+rule:
+  pattern: $F.onCompletion { $$$ }
+  has:
+    kind: call_suffix
+    has:
+      kind: annotated_lambda
+      has:
+        kind: lambda_literal
+        all:
+          - not:
+              has:
+                kind: lambda_parameters
+          - not:
+              has:
+                stopBy: end
+                kind: simple_identifier
+                regex: ^it$
+---
+id: kt-asflow-not-cancellable
+language: kotlin
+severity: hint
+message: '[FLOW-14]集合/範圍轉的 asFlow() 不檢查取消,取消後還把整串跑完;改用 .asFlow().cancellable(),或 collect 裡 ensureActive()'
+rule:
+  pattern: $X.asFlow()
+  not:
+    inside:
+      stopBy: end
+      pattern: $Y.cancellable()
+constraints:
+  X:
+    not:
+      regex: '(?i)livedata|^::|^\(?suspend\b'
+---
+id: kt-unbounded-channel
+language: kotlin
+severity: hint
+message: '[FLOW-30]UNLIMITED 緩衝在消費者慢時會無限長大到 OOM;改成有上限加溢位策略,例 Channel(64, BufferOverflow.DROP_OLDEST)'
+rule:
+  kind: value_argument
+  regex: '^(capacity\s*=\s*)?(Channel\.)?UNLIMITED$'
+  inside:
+    kind: value_arguments
+    inside:
+      kind: call_suffix
+      inside:
+        kind: call_expression
+        any:
+          - has:
+              kind: simple_identifier
+              regex: ^(Channel|produce|actor)$
+          - has:
+              kind: navigation_expression
+              has:
+                kind: navigation_suffix
+                regex: '^\??\.\s*(buffer|produce|actor)$'
+---
+id: kt-callbackflow-trysend-ignored
+language: kotlin
+severity: hint
+message: '[FLOW-31]callbackFlow 緩衝滿時 trySend 回傳失敗,沒看結果資料就靜默遺失;改成 trySend(v).onFailure { log(it) },或 buffer 明講溢位要丟'
+rule:
+  all:
+    - any:
+        - pattern: trySend($$$)
+        - pattern: $C.trySend($$$)
+    - inside:
+        kind: statements
+    - inside:
+        stopBy: end
+        any:
+          - pattern: callbackFlow { $$$ }
+          - pattern: callbackFlow<$T> { $$$ }
+---
+id: kt-collectlatest-writes
+language: kotlin
+severity: hint
+message: '[FLOW-22]collectLatest 收到新值就取消上一次處理,寫入可能只做一半;必須做完的寫入改用 collect,或包進 withContext(NonCancellable) { }'
+rule:
+  pattern: $F.collectLatest { $$$ }
+  has:
+    stopBy: end
+    kind: navigation_suffix
+    regex: '^\??\.\s*(insert|save|upsert|delete|remove|write|persist|upload|submit)\w*$'
+  not:
+    has:
+      stopBy: end
+      pattern: withContext(NonCancellable) { $$$ }
diff --git a/configs/ast-grep/kotlin-android/rules-hints/perf.yml b/configs/ast-grep/kotlin-android/rules-hints/perf.yml
new file mode 100644
index 000000000..0edafdf17
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/perf.yml
@@ -0,0 +1,114 @@
+id: kt-dto-bang
+language: kotlin
+severity: hint
+message: '[PERF-28]對 API 回來的欄位用 !!,伺服器少給一個欄位就崩潰;改成在 DTO 對應層給預設值或回報錯誤'
+rule:
+  kind: postfix_expression
+  regex: (?i)^\w*(dto|response|resp)\.[\w.]*!!$
+  not:
+    regex: \.body(\(\))?!!$
+---
+# P5
+id: kt-ui-blocking-wait
+language: kotlin
+severity: hint
+message: '[PERF-5]UI 類別裡同步等待(future.get、latch.await、thread.join、Tasks.await)會卡主執行緒造成 ANR;改用回呼或協程的 suspend 版本'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  any:
+    - pattern: $X.get($T, $U)
+    - pattern: $X.await($T, $U)
+    - pattern: Tasks.await($$$)
+    - pattern: $FUT.get()
+    - pattern: $X.await()
+    - pattern: $X.join()
+  inside:
+    kind: class_declaration
+    has:
+      kind: delegation_specifier
+      regex: '\b(\w*Activity|\w*Fragment|BroadcastReceiver|\w*View)\b'
+    stopBy: end
+  not:
+    inside:
+      any:
+        - pattern: launch { $$$ }
+        - pattern: launch($$$) { $$$ }
+        - pattern: $S.launch { $$$ }
+        - pattern: $S.launch($$$) { $$$ }
+        - pattern: $S.async { $$$ }
+        - pattern: withContext($$$) { $$$ }
+        - pattern: thread { $$$ }
+        - pattern: thread($$$) { $$$ }
+        - pattern: $E.execute { $$$ }
+        - pattern: $E.submit { $$$ }
+        - kind: function_declaration
+          has:
+            kind: modifiers
+            regex: '\bsuspend\b'
+      stopBy: end
+constraints:
+  FUT:
+    regex: '(?i)future$'
+---
+# P42
+id: kt-string-concat-in-loop
+language: kotlin
+severity: hint
+message: '[PERF-23]迴圈裡用 + 拼字串每圈都配置新字串(O(n²));改用 buildString { } / StringBuilder / joinToString'
+rule:
+  any:
+    - kind: assignment
+      regex: '^[\w.]+\s*\+='
+      any:
+        - has:
+            kind: string_literal
+        - has:
+            kind: additive_expression
+            has:
+              kind: string_literal
+              stopBy:
+                not:
+                  kind: additive_expression
+    - kind: assignment
+      any:
+        - pattern: $S = $S + $X
+        - pattern: $S = $S + $X + $Y
+        - pattern: $S = $S + $X + $Y + $Z
+      has:
+        kind: additive_expression
+        has:
+          kind: string_literal
+          stopBy:
+            not:
+              kind: additive_expression
+  inside:
+    any:
+      - kind: for_statement
+      - kind: while_statement
+      - kind: do_while_statement
+      - pattern: $C.forEach { $$$ }
+      - pattern: $C.forEachIndexed { $$$ }
+      - pattern: repeat($$$) { $$$ }
+    stopBy: end
+---
+# P52
+id: kt-lazy-thread-mode-none
+language: kotlin
+severity: hint
+message: '[PERF-33]lazy(NONE) 沒有鎖,多執行緒同時讀會初始化兩次或拿到半成品;多執行緒改用預設的 by lazy { }'
+rule:
+  kind: call_expression
+  regex: '^lazy\(\s*(mode\s*=\s*)?(LazyThreadSafetyMode\.)?NONE\s*\)'
+---
+# P35
+id: kt-bitmap-decode-without-options
+language: kotlin
+severity: hint
+message: '[PERF-16]BitmapFactory 不帶 Options 會用原尺寸解碼,大圖直接 OOM;改用 Options 設 inSampleSize,或 Coil/Glide/ImageDecoder 指定尺寸'
+rule:
+  any:
+    - pattern: BitmapFactory.decodeFile($P)
+    - pattern: BitmapFactory.decodeResource($R, $I)
+    - pattern: BitmapFactory.decodeStream($S)
+    - pattern: BitmapFactory.decodeByteArray($B, $O, $L)
+    - pattern: BitmapFactory.decodeFileDescriptor($F)
diff --git a/configs/ast-grep/kotlin-android/rules-hints/state.yml b/configs/ast-grep/kotlin-android/rules-hints/state.yml
new file mode 100644
index 000000000..d8cfbb120
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/state.yml
@@ -0,0 +1,90 @@
+id: kt-value-assign-background
+language: kotlin
+severity: hint
+message: '[STATE-16]背景執行緒對 .value 賦值;若它是 LiveData 會拋 IllegalStateException,改用 postValue 或切回主執行緒(StateFlow 可忽略)'
+rule:
+  pattern: $L.value = $V
+  inside:
+    any:
+      - pattern: withContext(Dispatchers.IO) { $$$ }
+      - pattern: withContext(Dispatchers.Default) { $$$ }
+      - pattern: $S.launch(Dispatchers.IO) { $$$ }
+      - pattern: $S.launch(Dispatchers.Default) { $$$ }
+      - pattern: launch(Dispatchers.IO) { $$$ }
+      - pattern: launch(Dispatchers.Default) { $$$ }
+      - pattern: thread { $$$ }
+      - pattern: thread($$$) { $$$ }
+    stopBy: end
+  not:
+    inside:
+      any:
+        - pattern: withContext(Dispatchers.Main) { $$$ }
+        - pattern: withContext(Dispatchers.Main.immediate) { $$$ }
+      stopBy: end
+# 名字以 Flow 結尾的(_stateFlow、uiStateFlow)照命名慣例是 StateFlow,從任何執行緒賦值都安全,不提示
+constraints:
+  L:
+    not:
+      regex: '(?i)flow$'
+---
+id: kt-saved-state-large
+language: kotlin
+severity: hint
+message: '[STATE-18]往 saved state 塞清單、Serializable 或 Bitmap,超過 Binder 上限會 TransactionTooLargeException;改成只存 id 或查詢字串,用 id 重載'
+rule:
+  any:
+    - pattern: $B.putParcelableArrayList($$$)
+    - pattern: $B.putSerializable($$$)
+    - pattern: $B.putParcelable($K, $BMP)
+    - pattern: $H[$K] = ArrayList($$$)
+    - pattern: $H[$K] = $L.toList()
+    - pattern: $H[$K] = $L.toTypedArray()
+constraints:
+  BMP:
+    regex: (?i)bitmap|image|photo
+  H:
+    regex: (?i)(savedState|handle)
+---
+id: kt-nav-route-object-arg
+language: kotlin
+severity: hint
+message: '[STATE-19]導航路由直接帶整個物件,大小不受控、還原時可能已過期;改成只傳 id,目的地從 repository 載入'
+rule:
+  kind: class_parameter
+  not:
+    has:
+      kind: user_type
+      regex: ^(String|Int|Long|Boolean|Float|Double|Short|Byte|Char|UInt|ULong)$
+      stopBy: end
+  inside:
+    kind: class_declaration
+    all:
+      - has:
+          kind: modifiers
+          has:
+            kind: annotation
+            regex: ^@Serializable
+      - has:
+          kind: type_identifier
+          regex: (Route|Destination|Screen|Args)$
+    stopBy: end
+---
+id: kt-remember-text-not-saveable
+language: kotlin
+severity: hint
+message: '[STATE-27]文字輸入的狀態用 remember 會在轉螢幕或程序被殺後消失;使用者輸入改用 rememberSaveable'
+rule:
+  any:
+    - pattern: remember { mutableStateOf("") }
+    - pattern: remember { mutableStateOf(TextFieldValue($$$)) }
+---
+id: kt-whilesubscribed-no-timeout
+language: kotlin
+severity: hint
+message: '[STATE-9]WhileSubscribed() 沒給停止延遲,轉螢幕時收集者短暫歸零就停掉上游又重啟;改用 SharingStarted.WhileSubscribed(5_000)'
+rule:
+  any:
+    - pattern: SharingStarted.WhileSubscribed()
+    - pattern: WhileSubscribed()
+    - pattern: SharingStarted.WhileSubscribed(replayExpirationMillis = $R)
+    - pattern: WhileSubscribed(replayExpirationMillis = $R)
diff --git a/configs/ast-grep/kotlin-android/rules-hints/testing.yml b/configs/ast-grep/kotlin-android/rules-hints/testing.yml
new file mode 100644
index 000000000..b8be198f9
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-hints/testing.yml
@@ -0,0 +1,135 @@
+# T4(區塊本體)
+id: kt-test-runtest-block-body
+language: kotlin
+severity: hint
+message: '[TEST-13]runTest 寫在區塊本體裡,回傳值被丟掉(JS 等平台會靜默不跑);改成運算式本體 fun t() = runTest { }'
+files: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  any:
+    - pattern: runTest { $$$ }
+    - pattern: runTest($$$) { $$$ }
+    - pattern: $S.runTest { $$$ }
+    - pattern: $S.runTest($$$) { $$$ }
+  inside:
+    kind: statements
+    inside:
+      kind: function_body
+      inside:
+        kind: function_declaration
+        has:
+          kind: modifiers
+          has:
+            kind: annotation
+            regex: '^@Test\b'
+---
+# T14
+id: kt-prod-reads-system-clock
+language: kotlin
+severity: hint
+message: '[TEST-16]商業邏輯直接讀系統時鐘,時間邊界測不到;改成從建構子注入 Clock/TimeSource,測試用 testScheduler.timeSource'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  any:
+    - pattern: System.currentTimeMillis()
+    - pattern: System.nanoTime()
+    - pattern: Instant.now()
+    - pattern: LocalDateTime.now()
+    - pattern: LocalDate.now()
+    - pattern: ZonedDateTime.now()
+    - pattern: SystemClock.elapsedRealtime()
+    - pattern: SystemClock.uptimeMillis()
+    - pattern: Date()
+  not:
+    inside:
+      any:
+        - kind: class_declaration
+        - kind: object_declaration
+      has:
+        kind: delegation_specifier
+        regex: '\b(Clock|TimeSource|TimeProvider|\w*Clock)\b'
+      stopBy: end
+---
+# T15
+id: kt-test-hot-flow-terminal
+language: kotlin
+severity: hint
+message: '[TEST-17]對熱流直接 toList()/collect 永遠不會結束,測試卡到逾時;改用 Turbine 的 flow.test { awaitItem() },或 backgroundScope.launch 收'
+files: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  any:
+    - pattern: $F.toList()
+    - pattern: $F.collect { $$$ }
+  regex: '^[\w.]*(?i:state|stateflow|sharedflow|events?)\.(toList\(\)|collect\b)'
+  not:
+    inside:
+      any:
+        - pattern: launch { $$$ }
+        - pattern: launch($$$) { $$$ }
+        - pattern: $S.launch { $$$ }
+        - pattern: $S.launch($$$) { $$$ }
+      stopBy: end
+---
+# T25
+id: kt-test-verify-only
+language: kotlin
+severity: hint
+message: '[TEST-23]測試只驗呼叫(verify)不驗結果,重構就紅、行為錯也綠;改用假實作並斷言可觀察的狀態'
+files: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  kind: function_declaration
+  all:
+    - has:
+        kind: modifiers
+        has:
+          kind: annotation
+          regex: '^@Test\b'
+    - has:
+        kind: function_body
+        regex: '\b(co)?[vV]erify\w*\s*[({]'
+    - not:
+        has:
+          kind: function_body
+          regex: '\b(assert\w*|expect\w*|should\w*|awaitItem|awaitError|awaitComplete|check|checkNotNull|fail)\s*[({<]|\.should\w*'
+---
+# T29
+id: kt-test-no-assertion
+language: kotlin
+severity: hint
+message: '[TEST-27]@Test 函式裡沒有任何斷言,永遠綠;改成至少一個 assertEquals/verify/awaitItem()'
+files: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  kind: function_declaration
+  has:
+    kind: modifiers
+    has:
+      kind: annotation
+      regex: '^@Test$'
+  not:
+    has:
+      kind: function_body
+      regex: '(?i)\b(assert\w*|(co)?verify\w*|expect\w*|should\w*|check|checkNotNull|require|requireNotNull|fail|await\w*)\s*[({<]|\.should\w*|\s(should|shouldBe|shouldNotBe|shouldThrow)\w*\s|\.test\s*[({]'
+---
+# T33(文字)
+id: kt-compose-test-node-by-literal-text
+language: kotlin
+severity: hint
+message: '[TEST-31]用寫死的顯示文字找節點,改文案或切語系就壞;改用 testTag,或從資源取字串'
+files: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  kind: call_expression
+  regex: '\.onNodeWithText\(\s*"'
+  not:
+    has:
+      kind: call_expression
+      regex: '\.onNodeWithText\(\s*"'
+      stopBy: end
+---
+# T35
+id: kt-robolectric-legacy-looper
+language: kotlin
+severity: hint
+message: '[TEST-33]Robolectric 的 LEGACY looper 會立即執行主執行緒工作,跟真機不同、升級就壞;改用預設 PAUSED 並明確 shadowOf(getMainLooper()).idle()'
+files: ['**/src/test*/**', '**/src/androidTest*/**']
+rule:
+  kind: annotation
+  regex: '^@LooperMode\(.*\bLEGACY\b'
diff --git a/configs/ast-grep/kotlin-android/rules-review/api.yml b/configs/ast-grep/kotlin-android/rules-review/api.yml
new file mode 100644
index 000000000..23fc7bda5
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-review/api.yml
@@ -0,0 +1,15 @@
+# 語意覆核級(info):形狀分不出對錯,要盲判代理逐筆判
+# 自 rules/api.yml 的 kt-suspendcoroutine 拆出(代碼審 r1 M11):包一次性 Task 這類沒有可取消資源的 wrapper 不加 invokeOnCancellation 本來就對,形狀分不出
+id: kt-suspendcancellable-no-oncancel
+language: kotlin
+severity: info
+message: '[API-11]suspendCancellableCoroutine 沒註冊 invokeOnCancellation,取消後請求還在跑;改成 cont.invokeOnCancellation { call.cancel() }'
+rule:
+  any:
+    - pattern: suspendCancellableCoroutine { $$$ }
+    - pattern: suspendCancellableCoroutine<$T> { $$$ }
+  not:
+    has:
+      kind: call_expression
+      regex: invokeOnCancellation
+      stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules-review/coroutines.yml b/configs/ast-grep/kotlin-android/rules-review/coroutines.yml
new file mode 100644
index 000000000..d91e93c11
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-review/coroutines.yml
@@ -0,0 +1,33 @@
+# 語意覆核級(info):形狀分不出對錯,要盲判代理逐筆判
+# 自 rules/coroutines.yml 搬來(代碼審 r2 規則B Finding 1、2):是不是切回 Main 要知道派發器的型別與實際執行緒,
+# 名稱比對擋不住 Main.immediate、注入的 ui 派發器這類誤報,也會被外層 Main 吞掉內層 IO 的壞寫法
+id: kt-bg-dispatcher-touches-view
+language: kotlin
+severity: info
+message: '[CO-44]在 Dispatchers.IO/Default 上直接改 View 會丟 CalledFromWrongThreadException;改成 withContext(io) 取資料後再改 View,或寫入 StateFlow'
+rule:
+  all:
+    - any:
+        - kind: assignment
+          regex: '^\s*(_?binding\b[\w.?!]*|[\w.?!]+\.(text|isVisible|isGone|isInvisible|visibility|isEnabled|adapter|error|hint|alpha))\s*='
+        - pattern: $V.setText($$$)
+        - pattern: $V.setImageBitmap($$$)
+        - pattern: $V.setVisibility($$$)
+    - inside:
+        stopBy: end
+        kind: call_expression
+        regex: '^(\w+\.)?(launch|async|withContext)\s*\(\s*Dispatchers\.(IO|Default)\b'
+    - not:
+        inside:
+          stopBy: end
+          any:
+            # 切回 Main:Dispatchers.Main(.immediate)、Main + 其他 context、注入的 main/mainImmediate/mainDispatcher(含 main()),
+            # 名稱完整比對;而且這個切換要在背景區塊「裡面」,外層的 Main 不吞內層 IO(代碼審 r2 規則B Finding 1、2)
+            - kind: call_expression
+              regex: '^(\w+\.)?(withContext|launch|async)\s*\(\s*(\w+\.)*(Main|main|mainImmediate|mainDispatcher)(\.immediate)?(\(\))?\s*[,)+]'
+              inside:
+                stopBy: end
+                kind: call_expression
+                regex: '^(\w+\.)?(launch|async|withContext)\s*\(\s*Dispatchers\.(IO|Default)\b'
+            - pattern: runOnUiThread { $$$ }
+            - pattern: $W.post { $$$ }
diff --git a/configs/ast-grep/kotlin-android/rules-review/data.yml b/configs/ast-grep/kotlin-android/rules-review/data.yml
new file mode 100644
index 000000000..e8284650a
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-review/data.yml
@@ -0,0 +1,30 @@
+# 語意覆核級(info):形狀分不出對錯,要盲判代理逐筆判
+# 自 rules/data.yml 搬來(代碼審 r2 規則B Finding 3):retry 有沒有上限要看 runAttemptCount 的資料流
+# (先存變數、交給 helper 判),形狀只看得到它有沒有出現在條件裡
+id: kt-worker-retry-unbounded
+language: kotlin
+severity: info
+message: '[DATA-36]Result.retry() 沒看 runAttemptCount,永久錯誤也一直重試;改成 runAttemptCount >= MAX 就回 Result.failure(),IOException 才 retry'
+rule:
+  any:
+    - pattern: Result.retry()
+    - pattern: ListenableWorker.Result.retry()
+  # 同一個函式裡有 runAttemptCount 判斷(含先擋後回的早退寫法)就放行;只算出現在 if/when 裡的,
+  # 只賦值或寫進 log 字串的不算(代碼審 r2 規則B Finding 3)。先存變數再判的形狀看不出,留給盲判
+  not:
+    inside:
+      kind: function_declaration
+      has:
+        kind: simple_identifier
+        regex: ^runAttemptCount$
+        inside:
+          any:
+            - kind: if_expression
+            - kind: when_expression
+          stopBy: end
+        not:
+          inside:
+            kind: string_literal
+            stopBy: end
+        stopBy: end
+      stopBy: end
diff --git a/configs/ast-grep/kotlin-android/rules-review/state.yml b/configs/ast-grep/kotlin-android/rules-review/state.yml
new file mode 100644
index 000000000..077e133f1
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-review/state.yml
@@ -0,0 +1,131 @@
+id: kt-livedata-setvalue-background
+language: kotlin
+severity: info
+message: '[STATE-16]背景執行緒呼叫 LiveData.setValue 會拋 IllegalStateException;背景改用 postValue,或切回主執行緒再 setValue'
+rule:
+  pattern: $L.setValue($$$)
+  inside:
+    any:
+      - pattern: withContext(Dispatchers.IO) { $$$ }
+      - pattern: withContext(Dispatchers.Default) { $$$ }
+      - pattern: $S.launch(Dispatchers.IO) { $$$ }
+      - pattern: $S.launch(Dispatchers.Default) { $$$ }
+      - pattern: launch(Dispatchers.IO) { $$$ }
+      - pattern: launch(Dispatchers.Default) { $$$ }
+      - pattern: thread { $$$ }
+      - pattern: thread($$$) { $$$ }
+    # 往外找背景區塊時先碰到切回 Main 的區塊就停(放行);外層 Main、內層切 IO 時照樣報
+    stopBy:
+      any:
+        - pattern: withContext(Dispatchers.Main) { $$$ }
+        - pattern: withContext(Dispatchers.Main.immediate) { $$$ }
+---
+id: kt-mutate-state-nested-collection
+language: kotlin
+severity: info
+message: '[STATE-7]直接改狀態裡某個欄位集合的內容,參照沒變不會發新值;改用 update { it.copy(items = it.items + x) }'
+rule:
+  any:
+    - pattern: $X.value.$F.add($$$)
+    - pattern: $X.value.$F.addAll($$$)
+    - pattern: $X.value.$F.remove($$$)
+    - pattern: $X.value.$F.removeAt($$$)
+    - pattern: $X.value.$F.removeAll($$$)
+    - pattern: $X.value.$F.clear()
+    - pattern: $X.value.$F.put($$$)
+    - pattern: $X.value.$F.putAll($$$)
+    - pattern: $X.value.$F.set($$$)
+    - pattern: $X.value.$F.retainAll($$$)
+    - pattern: $X.value.$F.removeIf { $$$ }
+    - pattern: $X.value.$F.sortBy { $$$ }
+    - pattern: $X.value.$F.sortWith($$$)
+    - pattern: $X.value.$F.sort()
+    - pattern: $X.value.$F[$K] = $V
+---
+id: kt-state-value-property-assign
+language: kotlin
+severity: info
+message: '[STATE-7]改 state.value 裡物件的欄位,參照沒變不會發新值,畫面不更新;改成不可變 data class 並用 update { it.copy(…) }'
+rule:
+  any:
+    - kind: assignment
+      regex: '^\s*[\w?!]+(\.[\w?!]+)*\.value(\?|!!)?\.[\w.?!\[\]]+\s*(\+|-|\*|/|%)?='
+    - kind: postfix_expression
+      regex: '^[\w?!]+(\.[\w?!]+)*\.value(\?|!!)?\.[\w.?!]+\s*(\+\+|--)$'
+    - kind: prefix_expression
+      regex: '^(\+\+|--)\s*[\w?!]+(\.[\w?!]+)*\.value(\?|!!)?\.[\w.?!]+$'
+
+---
+id: kt-mutate-state-collection
+language: kotlin
+severity: info
+message: '[STATE-7]直接改狀態裡集合的內容,參照沒變不會發新值;改用 update { it + x } 或換新集合'
+rule:
+  any:
+    - pattern: $X.value.add($$$)
+    - pattern: $X.value.addAll($$$)
+    - pattern: $X.value.remove($$$)
+    - pattern: $X.value.removeAt($$$)
+    - pattern: $X.value.removeAll($$$)
+    - pattern: $X.value.clear()
+    - pattern: $X.value.put($$$)
+    - pattern: $X.value.putAll($$$)
+    - pattern: $X.value.removeIf { $$$ }
+    - pattern: $X.value.sortBy { $$$ }
+    - pattern: $X.value?.add($$$)
+    - pattern: $X.value?.remove($$$)
+    - pattern: $X.value?.clear()
+    - pattern: $X.value?.put($$$)
+    - pattern: $X.value!!.add($$$)
+    - pattern: $X.value[$K] = $V
+---
+id: kt-nonatomic-state-update
+language: kotlin
+severity: info
+message: '[STATE-1]讀改寫 state 不是原子操作,並行時後寫的蓋掉先寫的;改用 _uiState.update { it.copy(…) }'
+rule:
+  any:
+    - pattern: $X.value = $X.value.copy($$$A)
+    - pattern: $X.value = $X.value + $Y
+  not:
+    any:
+      # 放在鎖裡的讀改寫已經互斥
+      - inside:
+          stopBy: end
+          any:
+            - pattern: $MX.withLock { $$$ }
+            - pattern: synchronized($$$) { $$$ }
+      - inside:
+          stopBy: end
+          kind: lambda_literal
+          inside:
+            kind: value_argument
+            has:
+              kind: simple_identifier
+              regex: ^on[A-Z]\w*$
+            inside:
+              stopBy: end
+              kind: function_declaration
+              has:
+                kind: modifiers
+                has:
+                  kind: annotation
+                  regex: ^@Composable
+---
+# 自 rules/state.yml 搬來(代碼審 r2 規則B Finding 4):「理由」註解是不是寫給這一行,要看行距與語意,形狀判不準
+id: kt-statein-eagerly
+language: kotlin
+severity: info
+message: '[STATE-4]stateIn 用 Eagerly 沒寫理由,上游一開始就永遠收集、背景照樣耗電;改用 SharingStarted.WhileSubscribed(5_000),真要 Eagerly 附一行 // 理由: 註解'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**', '**/src/testFixtures/**', '**/src/*Test/**', '**/src/sharedTest/**', '**/*-test/src/**', '**/*testing/src/**']
+rule:
+  pattern: SharingStarted.Eagerly
+  # 型錄 STATE-4:真要 Eagerly 附一行理由。形狀只放行寫在 stateIn 引數裡、以 // 理由: 開頭的註解;
+  # 屬性上一行或行尾的註解分不出是哪一行的(鄰行的理由會被借走),一律報出來交盲判看(代碼審 r2 規則B Finding 4)
+  not:
+    inside:
+      kind: value_arguments
+      stopBy: end
+      has:
+        kind: line_comment
+        regex: '^//\s*(理由|[Rr]eason\b)'
diff --git a/configs/ast-grep/kotlin-android/rules-review/testing.yml b/configs/ast-grep/kotlin-android/rules-review/testing.yml
new file mode 100644
index 000000000..7550a8284
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-review/testing.yml
@@ -0,0 +1,42 @@
+id: kt-runtest-launch-collect-forever
+language: kotlin
+severity: info
+message: '[TEST-5]runTest 會等所有子協程,用一般 launch 收集永不結束的狀態流會卡到逾時;改用 backgroundScope.launch(UnconfinedTestDispatcher(…)) { }'
+files: ['**/src/test*/**', '**/src/androidTest*/**', '**/src/testFixtures/**', '**/src/*Test/**', '**/src/sharedTest/**']
+rule:
+  all:
+    - any:
+        - pattern: launch { $$$ }
+        - pattern: launch($$$) { $$$ }
+    - has:
+        stopBy: end
+        any:
+          - pattern: $F.collect { $$$ }
+          - pattern: $F.collect($$$)
+          - pattern: $F.toList($$$)
+    - inside:
+        stopBy: end
+        any:
+          - pattern: runTest { $$$ }
+          - pattern: runTest($$$) { $$$ }
+          - pattern: $T.runTest { $$$ }
+    - not:
+        has:
+          stopBy: end
+          any:
+            - pattern: $G.take($$$)
+            - pattern: $G.first()
+            - pattern: $G.first { $$$ }
+            - pattern: $G.takeWhile { $$$ }
+    - not:
+        inside:
+          stopBy: end
+          any:
+            - pattern: runTest { $$$ }
+            - pattern: runTest($$$) { $$$ }
+            - pattern: $T.runTest { $$$ }
+          has:
+            stopBy: end
+            any:
+              - pattern: $J.cancel()
+              - pattern: $J.cancelAndJoin()
diff --git a/configs/ast-grep/kotlin-android/rules/api.yml b/configs/ast-grep/kotlin-android/rules/api.yml
new file mode 100644
index 000000000..b9d890127
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules/api.yml
@@ -0,0 +1,308 @@
+id: kt-compose-globalscope-in-composable
+language: kotlin
+severity: error
+message: "[API-9]@Composable 裡用 GlobalScope 或自建 CoroutineScope 跑協程,離開畫面不會取消;改用 rememberCoroutineScope() 或 LaunchedEffect"
+rule:
+  any:
+    - kind: simple_identifier
+      regex: ^GlobalScope$
+    - pattern: CoroutineScope($$$)
+    - pattern: MainScope()
+  inside:
+    kind: function_declaration
+    has:
+      kind: modifiers
+      has:
+        kind: annotation
+        regex: ^@Composable
+    stopBy: end
+---
+id: kt-okhttp-client-per-call
+language: kotlin
+severity: warning
+message: '[API-16]函式裡每次都新建 OkHttpClient,連線池與執行緒池跟著重複建立;改成全程式共用一個實例,要不同設定用 client.newBuilder() 衍生'
+rule:
+  any:
+    - pattern: OkHttpClient()
+    - pattern: OkHttpClient.Builder()
+  inside:
+    kind: function_body
+    stopBy: end
+  not:
+    inside:
+      kind: function_declaration
+      any:
+        - has:
+            kind: modifiers
+            has:
+              kind: annotation
+              regex: ^@(Provides|Singleton|Bean)\b
+              stopBy: end
+        - has:
+            kind: user_type
+            regex: ^OkHttpClient$
+      stopBy: end
+---
+id: kt-okhttp-response-not-closed
+language: kotlin
+severity: warning
+message: '[API-17]execute() 拿到的 Response 沒關閉會洩漏連線、耗盡連線池;改用 client.newCall(req).execute().use { … }'
+rule:
+  pattern: $C.newCall($$$).execute()
+  not:
+    any:
+      - inside:
+          any:
+            - pattern: $X.use { $$$ }
+            - pattern: $X?.use { $$$ }
+          stopBy: end
+      # 直接接著讀完 body:execute().body?.string() 會關 body,連線跟著還回去(代碼審 r1 M10)
+      - inside:
+          kind: call_expression
+          regex: '\.execute\(\)\s*\.body(\(\))?(\?|!!)?\.(string|bytes|close)\(\)$'
+          stopBy: end
+      # 先存進變數:同函式裡對「同一個變數」use/close,或讀完它的 body;
+      # 讀別的 Response 的 body 不算(代碼審 r1 M10、r2 規則A F5)
+      - all:
+          - inside:
+              kind: property_declaration
+              has:
+                kind: variable_declaration
+                has:
+                  kind: simple_identifier
+                  pattern: $V
+          - inside:
+              kind: function_body
+              has:
+                any:
+                  - pattern: $V.use { $$$ }
+                  - pattern: $V?.use { $$$ }
+                  - pattern: $V.close()
+                  - pattern: $V?.close()
+                  - pattern: $V.body!!.string()
+                  - pattern: $V.body?.string()
+                  - pattern: $V.body!!.bytes()
+                  - pattern: $V.body?.bytes()
+                  - pattern: $V.body!!.close()
+                  - pattern: $V.body?.close()
+                  - pattern: $V.body().string()
+                  - pattern: $V.body().bytes()
+                  - pattern: $V.body().close()
+                stopBy: end
+              stopBy: end
+---
+id: kt-http-logging-body-unguarded
+language: kotlin
+severity: warning
+message: '[API-19]BODY 日誌沒用 DEBUG 包住,正式版把權杖與個資寫進 logcat;改成 if (BuildConfig.DEBUG) Level.BODY else Level.NONE,並 redactHeader'
+rule:
+  any:
+    - pattern: HttpLoggingInterceptor.Level.BODY
+    - pattern: Level.BODY
+  not:
+    inside:
+      any:
+        - kind: if_expression
+        - kind: when_expression
+      has:
+        pattern: BuildConfig.DEBUG
+        stopBy: end
+      stopBy: end
+---
+id: kt-catch-only-httpexception
+language: kotlin
+severity: warning
+message: '[API-24]只接 HttpException,斷網(IOException)與解析錯誤會直接往上炸;改成 HttpException、IOException、SerializationException 分開 catch 並轉成網域錯誤'
+rule:
+  kind: try_expression
+  has:
+    kind: catch_block
+    has:
+      kind: user_type
+      regex: ^(retrofit2\.)?HttpException$
+  not:
+    has:
+      kind: catch_block
+      has:
+        kind: user_type
+        regex: ^(java\.io\.)?(IOException|Exception|Throwable)$
+---
+id: kt-retrofit-converter-order
+language: kotlin
+severity: error
+message: '[API-27]通用 JSON converter 排在 Scalars/Protobuf 前面,會先吃掉 String 等型別;改成先加 ScalarsConverterFactory/protobuf,通用 JSON 放最後'
+rule:
+  pattern: $B.addConverterFactory($$$)
+  all:
+    - has:
+        kind: call_suffix
+        has:
+          regex: (Scalars|Proto|Protobuf|Wire)ConverterFactory
+          stopBy: end
+    - has:
+        kind: navigation_expression
+        has:
+          kind: call_suffix
+          regex: (Gson|Moshi|Jackson)ConverterFactory|asConverterFactory
+          stopBy: end
+---
+id: kt-ktor-client-per-call
+language: kotlin
+severity: warning
+message: '[API-29]函式裡新建 Ktor HttpClient 而且沒關,引擎的執行緒與連線跟著洩漏;改用單例,生命週期結束時 close(),臨時用就 HttpClient().use { }'
+rule:
+  any:
+    - pattern: HttpClient($$$)
+    - pattern: HttpClient($$$) { $$$ }
+    - pattern: HttpClient { $$$ }
+  inside:
+    kind: function_body
+    stopBy: end
+  not:
+    any:
+      - inside:
+          pattern: $X.use { $$$ }
+          stopBy: end
+      - inside:
+          kind: function_declaration
+          any:
+            - has:
+                kind: modifiers
+                has:
+                  kind: annotation
+                  regex: ^@(Provides|Singleton|Bean)\b
+                  stopBy: end
+            - has:
+                kind: user_type
+                regex: ^HttpClient$
+          stopBy: end
+      # 同函式裡對「這個 client 存進的變數」呼叫 close()(try/finally 關掉)就不算「沒關」;
+      # close() 的接收者要是同一個變數,關別的 stream/writer 不算(代碼審 r1 M14、r2 規則A F4)
+      - all:
+          - inside:
+              kind: property_declaration
+              has:
+                kind: variable_declaration
+                has:
+                  kind: simple_identifier
+                  pattern: $V
+          - inside:
+              kind: function_body
+              has:
+                any:
+                  - pattern: $V.close()
+                  - pattern: $V?.close()
+                stopBy: end
+              stopBy: end
+---
+id: kt-unmanaged-scope-launch
+language: kotlin
+severity: warning
+message: '[API-9]GlobalScope 或臨時 CoroutineScope(...) 開的協程沒人管,取消不了也接不到錯誤;改用 viewModelScope,要活過畫面用注入的 applicationScope'
+rule:
+  any:
+    - pattern: GlobalScope.launch { $$$ }
+    - pattern: GlobalScope.launch($$$) { $$$ }
+    - pattern: GlobalScope.async { $$$ }
+    - pattern: GlobalScope.async($$$) { $$$ }
+    - pattern: CoroutineScope($$$).launch { $$$ }
+    - pattern: CoroutineScope($$$).launch($$$) { $$$ }
+    - pattern: CoroutineScope($$$).async { $$$ }
+    - pattern: CoroutineScope($$$).async($$$) { $$$ }
+  not:
+    inside:
+      kind: function_declaration
+      has:
+        pattern: goAsync()
+        stopBy: end
+      stopBy: end
+---
+id: kt-async-await-immediately
+language: kotlin
+severity: warning
+message: '[API-14]async 立刻 await 等於沒並行;改成直接呼叫 f(),要換執行緒就改用 withContext(io) { f() }'
+rule:
+  any:
+    - pattern: async { $$$ }.await()
+    - pattern: async($$$) { $$$ }.await()
+    - pattern: $S.async { $$$ }.await()
+    - pattern: $S.async($$$) { $$$ }.await()
+---
+id: kt-retrofit-body-bang
+language: kotlin
+severity: error
+message: '[API-15]response.body()!! 沒先看 isSuccessful,伺服器回 4xx/5xx 時會崩潰;改成先判 isSuccessful,失敗就 throw HttpException(response)'
+rule:
+  pattern: $R.body()!!
+  not:
+    # 放行只認「同一個接收者」的 isSuccessful,而且要出現在 if/when/check/require 的判斷裡;
+    # 判別的回應、或只拿來印 log(字串樣板裡)都不算看過(代碼審 r1 M1、r2 規則A F1)
+    inside:
+      any:
+        - kind: function_declaration
+        - kind: lambda_literal
+        - kind: property_declaration
+      has:
+        pattern: $R.isSuccessful
+        inside:
+          any:
+            - kind: if_expression
+            - kind: when_expression
+            - pattern: check($$$)
+            - pattern: require($$$)
+          stopBy: end
+        not:
+          inside:
+            kind: string_literal
+            stopBy: end
+        stopBy: end
+      stopBy: end
+---
+id: kt-callbackflow-no-awaitclose
+language: kotlin
