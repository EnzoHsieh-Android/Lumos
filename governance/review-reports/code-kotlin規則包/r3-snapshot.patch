+  all:
+    - any:
+        - pattern: $L.add($$$)
+        - pattern: $L.addAll($$$)
+        - pattern: $L.put($$$)
+        - pattern: $L.remove($$$)
+        - pattern: $L[$K] = $V
+        - pattern: $L += $V
+    - inside:
+        stopBy: end
+        kind: call_expression
+        regex: '^(\w+\.)?(async|launch)\s*\(\s*Dispatchers\.(Default|IO)\b'
+    - not:
+        inside:
+          stopBy: end
+          any:
+            - pattern: $MX.withLock { $$$ }
+            - pattern: synchronized($$$) { $$$ }
+    - not:
+        inside:
+          stopBy: end
+          kind: call_expression
+          regex: '^(\w+\.)?(async|launch)\s*\(\s*Dispatchers'
+          has:
+            stopBy: end
+            kind: property_declaration
+            has:
+              kind: variable_declaration
+              has:
+                kind: simple_identifier
+                pattern: $L
+    # 執行緒安全的集合(ConcurrentHashMap、CopyOnWrite…、Collections.synchronized…)
+    - not:
+        inside:
+          stopBy: end
+          any:
+            - kind: function_body
+            - kind: class_body
+          has:
+            stopBy: end
+            kind: property_declaration
+            regex: '=\s*(java\.util\.concurrent\.)?(Concurrent\w+|CopyOnWrite\w+|Collections\.synchronized\w+|ConcurrentHashMap\.new\w*)\b'
+            has:
+              kind: variable_declaration
+              has:
+                kind: simple_identifier
+                pattern: $L
