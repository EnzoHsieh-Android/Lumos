 10282	def _selfdelete_risk(root: Path) -> bool:
 10283	    """Windows 專屬:正在跑的這份 lumos 就是 root 底下那份 vendored copy 嗎?
 10284	
 10285	    `_deinit_remove_vendored` 最後會刪 `scripts/lumos`——POSIX 上刪掉執行中的檔案
 10286	    無妨(所以刻意排最後),★但 Windows 不准刪執行中的檔案★,會拋 PermissionError,
 10287	    而那句 `p.unlink()` 沒有 try/except。後果不是「少刪一個檔」而是★半做★:走
 10288	    teardown 的話,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,才在這裡炸 traceback,
 10289	    ③uninstall 根本沒機會跑。使用者拿到一個拆一半又看不懂的狀態。
 10290	
 10291	    這條路很容易走到:Windows 裝完要重開 session 才吃得到 PATH,拿不到 `lumos`
 10292	    這個指令的人自然會打 `python scripts\\lumos teardown`。
 10293	
 10294	    ★只在 Windows 回 True★——POSIX 上這條路是合法且刻意支援的,不能一起擋掉。
 10295	    `LUMOS_SIMULATE_WINDOWS` 只是測試接縫(本機沒有 Windows 可驗)。
 10296	    """
 10297	    if not (_IS_WIN or os.environ.get("LUMOS_SIMULATE_WINDOWS") == "1"):
 10298	        return False
 10299	    try:
 10300	        me, r = Path(__file__).resolve().parts, root.resolve().parts
 10301	    except OSError:
 10302	        return False       # 路徑解不開(權限/壞連結)就不擋(never block on unknown)
 10303	    # ★不用 `Path.is_relative_to()`★——那是 Python 3.9+,本專案宣告 ≥3.8
 10304	    # (同檔 `_write_lf` 為了同一個理由避開 3.10 才有的 write_text(newline=))。
 10305	    # ★也不要把 except 放寬成 `except Exception`★:這道守衛的失敗模式是「回 False」,
 10306	    # 一旦把自己的程式錯誤(如 AttributeError)也吞掉,守衛就★靜默地等於不存在★
 10307	    # ——2026-08-02 代碼審 r2 抓到的正是這個組合。
 10308	    return len(me) > len(r) and me[:len(r)] == r
 10309	
