   107	def collect_turn_actions(transcript_path: Path):
   108	    """從 transcript 尾部反向掃,到最近一個「真實 user 輸入」為止
   109	    (排除 tool_result 之類也被標 type=user 的雜訊)。
   110	    回傳 (file_paths, bash_commands)。
   111	    """
   112	    if not transcript_path.is_file():
   113	        return [], []
   114	    lines = transcript_path.read_text(encoding="utf-8", errors="ignore").splitlines()
   115	    turn_lines = []
   116	    for line in reversed(lines):
   117	        if not line.strip():
   118	            continue
   119	        try:
   120	            obj = json.loads(line)
   121	        except json.JSONDecodeError:
   122	            continue
   123	        if _is_real_user_input(obj):
   124	            break
   125	        turn_lines.append(obj)
   126	    turn_lines.reverse()
   127	
   128	    file_paths: list[str] = []
   129	    bash_commands: list[str] = []
   130	    for obj in turn_lines:
   131	        if obj.get("type") != "assistant":
   132	            continue
   133	        for item in obj.get("message", {}).get("content", []) or []:
   134	            if not isinstance(item, dict) or item.get("type") != "tool_use":
   135	                continue
   136	            name = item.get("name", "")
   137	            inp = item.get("input", {}) or {}
   138	            if name in EDIT_TOOLS:
   139	                fp = inp.get("file_path", "")
   140	                if fp:
   141	                    file_paths.append(fp)
   142	            elif name == "Bash":
   143	                cmd = inp.get("command", "")
   144	                if cmd:
   145	                    bash_commands.append(cmd)
   146	    return file_paths, bash_commands
   147	
