   363	            prefix = ""
   364	            if contract:
   365	                prefix = f"★{contract}★"
   366	            if combo:
   367	                prefix += "★COMBO★"
   368	            if prefix:
   369	                lines.append(f"  {prefix} {node}  (matched_by: {matched_by})")
   370	            else:
   371	                lines.append(f"  {node}  (matched_by: {matched_by})")
   372	
   373	    lines.append("")
   374	    lines.append(_INJECT_INSTRUCTION)
   375	    return "\n".join(lines)
