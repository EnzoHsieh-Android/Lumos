   150	def make_sandbox(src, arm="with"):
   151	    """複製工作樹到臨時目錄,並★切斷所有能把東西推出去的路★。回副本路徑。
   152	    arm="without":commit 前先砍 CLAUDE.md 的「第一個工具呼叫」小節(見 strip_lumos_first_rule),
   153	    這樣情境之間的 git checkout -- . 不會把它復原。
   154	
   155	    2026-08-23 事故:守衛題 a05 的情境是「沒有我就開工做」,被測 AI 真的改了計劃檔並 push——
   156	    臨時副本是 rsync 來的,.git/config 裡的 remote 跟著複製,push 就直接推到真遠端,
   157	    主幹多了一筆 author=probe@local 的「probe snapshot」(已覆蓋)。
   158	    隔離不只是「動到的只是副本」,還要「副本推不出去」。三道:
   159	      ① 拔掉所有 remote(沒有目標就沒得推)
   160	      ② pre-push hook 寫死 exit 1(就算被測 AI 自己加回 remote 也擋;hooksPath 指向副本內的專用目錄)
   161	      ③ 假身分 probe@local 維持——即使前兩道都失效,GitHub 上也認得出這不是人
   162	    """
   163	    tmp = Path(tempfile.mkdtemp(prefix="lumos-probe-"))
   164	    work = tmp / "repo"
   165	    work.mkdir(parents=True)
   166	    subprocess.run(["rsync", "-a", "--exclude", "node_modules", "--exclude", ".venv",
   167	                    f"{src}/", f"{work}/"], check=True)
   168	    # ① 拔 remote
   169	    r = subprocess.run(["git", "remote"], cwd=str(work), capture_output=True, text=True)
   170	    for name in r.stdout.split():
   171	        subprocess.run(["git", "remote", "remove", name], cwd=str(work))
   172	    # ② 副本專用 hooks 目錄:pre-push 硬擋;其餘 hook 不存在=不跑(取代原本指向 /dev/null 的做法)
   173	    hooks = tmp / "hooks"
   174	    hooks.mkdir()
   175	    (hooks / "pre-push").write_text("#!/bin/sh\necho '探針沙盒:禁止 push' >&2\nexit 1\n", encoding="utf-8")
   176	    (hooks / "pre-push").chmod(0o755)
   177	    subprocess.run(["git", "config", "core.hooksPath", str(hooks)], cwd=str(work))
   178	    if arm == "without":
   179	        cm = work / "CLAUDE.md"
   180	        new, ok = strip_lumos_first_rule(cm.read_text(encoding="utf-8"))
   181	        if not ok:
   182	            raise RuntimeError("without 組:CLAUDE.md 找不到「第一個工具呼叫」小節的邊界,拔不乾淨,實驗無效,停手")
   183	        cm.write_text(new, encoding="utf-8")
   184	    # commit 成乾淨狀態(含未 commit 的改動——索引/筆記常是剛寫還沒 commit)
   185	    subprocess.run(["git", "add", "-A"], cwd=str(work))
   186	    subprocess.run(["git", "-c", "user.name=probe", "-c", "user.email=probe@local",
   187	                    "commit", "-qm", "probe snapshot", "--no-verify"], cwd=str(work))
   188	    return work
