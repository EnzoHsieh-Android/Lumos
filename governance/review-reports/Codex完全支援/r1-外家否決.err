 10311	def cmd_teardown(yes=False, source=None):
 10312	    """一鍵拆機:當前 repo 專案層 + 機器全域(CLI/skills/hooks),★永遠保留圖譜文件★。
 10313	    範圍(std F11)=當前 repo + 機器全域,非全機所有 repo(別 repo 的注入/hooks、來源 clone 都留)。
 10314	    三步順序(std F5,全域先——趁 deinit 還沒刪掉 vendored merge):
 10315	      ①_teardown_global_claude ②cmd_deinit(keep_graph=True) ③cmd_uninstall。
 10316	    設計/審計:Projects/teardown一鍵拆機_計劃。"""
 10317	    import subprocess
 10318	    try:                                       # repo root(對稱 deinit,非 git 中止)
 10319	        root = Path(subprocess.check_output(
 10320	            ["git", "rev-parse", "--show-toplevel"], text=True,
 10321	            stderr=subprocess.DEVNULL).strip())
 10322	    except Exception:
 10323	        print("擋下:這裡不是 git 專案,拆除需要確定的專案根目錄,不會拿目前目錄猜", file=sys.stderr)
 10324	        return 2
 10325	    src = _lumos_src(source)
 10326	    if root.resolve() == src.resolve():
 10327	        print("擋下:你現在就在 Lumos 工具鏈的來源 repo 裡,不能在這裡拆它自己", file=sys.stderr)
 10328	        return 2
 10329	    if _selfdelete_risk(root):   # Windows 自刪(見 _selfdelete_risk)——在任何 mutation 之前擋
 10330	        print("擋下:Windows 上不能用專案自帶的那份 lumos 拆它自己"
 10331	              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
 10332	              "留下拆一半的狀態。", file=sys.stderr)
 10333	        print("  改用全域指令重跑:  lumos teardown", file=sys.stderr)
 10334	        print("  (若 PATH 還沒吃到,先重開一個終端;或直接用來源那份:"
 10335	              f"  python {src / 'scripts' / 'lumos'} teardown)", file=sys.stderr)
 10336	        return 2
 10337	    # 確認——★拒絕/取消前零 mutation★(std F13)
 10338	    if not yes:
 10339	        if not sys.stdin.isatty():
 10340	            print("擋下:這不是互動式終端、沒辦法問你確認,又沒加 --yes,不拆。確定要拆就加 --yes", file=sys.stderr)
 10341	            return 2
 10342	        print("teardown 將拆【當前 repo 專案層】(pre-commit/pre-push 閘、CLAUDE.md 注入、vendored 工具)")
 10343	        print("  +【機器全域】(~/.local/bin/lumos、user-scope skills、~/.claude 全域 hooks)。")
 10344	        print("  圖譜文件保留;scripts/hooks|templates 只刪 lumos 檔、你的自有檔保留(F9)。")
 10345	        print("  ⚠ 仍在的破壞性:剝 CLAUDE.md 注入會正規化 sentinel 外空白/換行;移除全部 lumos 家族")
 10346	        print("     skills(含 csharp/kotlin/vue-idioms,你名字不同的 skill 不碰)。")
 10347	        print("  (只拆當前 repo——別的 repo 與 bootstrap 來源 clone 不動。)")
 10348	        try:
 10349	            ans = input("確定? [y/N] ").strip().lower()
 10350	        except EOFError:
 10351	            # isatty() 在某些終端/Windows 回 True 但 stdin 其實 EOF → 讀不到確認。
 10352	            # 對齊 cmd_deinit 與 _confirm_tty 的既有硬化(同一現場,Windows 真機踩過):
 10353	            # 破壞性操作安全預設=拒絕(rc2,同上面非互動分支),不是往下做。
 10354	            # ★不要拿 --yes 當解法★——那等於跳過確認直接執行破壞性操作。
 10355	            print("擋下:等不到你的確認輸入,不拆。"
 10356	                  "確定要拆再加 --yes", file=sys.stderr)
 10357	            return 2
 10358	        if ans not in ("y", "yes"):
 10359	            print("已取消(未改動)。")
 10360	            return 0
 10361	    # 三步(全域先)
 10362	    print("① 全域 hook 清理…")
 10363	    _teardown_global_claude(Path(__file__).resolve().parent.parent)
 10364	    print("② 拆專案層(deinit,保留圖譜)…")
 10365	    rc_deinit = cmd_deinit(keep_graph=True, yes=True, source=source)
 10366	    print("③ 拆機器 CLI/skills(uninstall)…")
 10367	    rc_uninstall = cmd_uninstall()
 10368	    print(f"✓ teardown 完成(deinit rc={rc_deinit} / uninstall rc={rc_uninstall};圖譜保留)。"
 10369	          "  重裝:bootstrap 或 install + init。")
 10370	    return 0
