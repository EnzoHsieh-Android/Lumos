 16822	def cmd_dispatch_lens(diff_range, repo=None, as_json=False, no_cache=False, cap=8, max_lines=400):
 16823	    import json as _json
 16824	    import io, contextlib, time as _time
 16825	    _t0 = _time.monotonic()   # v1.2:hook 內層 45 秒是總帳,備援段預算=45−已耗−保留
 16826	    parts = _lens_range_ok(diff_range)
 16827	    if parts is None:
 16828	        print("擋下:範圍要長成 <base>..<head>(恰好一個 ..、兩端都有、不能是 ... 或 - 開頭)", file=sys.stderr)
 16829	        return 2
 16830	    base_ref, head_ref = parts
 16831	    start = Path(repo) if repo else Path.cwd()
 16832	    r = _lens_git(start, "rev-parse", "--show-toplevel")
 16833	    if r is None or r.returncode != 0 or not r.stdout.strip():
 16834	        print(f"擋下:{start} 不在 git 專案裡", file=sys.stderr)
 16835	        return 2
 16836	    root = Path(r.stdout.strip())
 16837	    if not _git_commit_exists(root, base_ref) or not _git_commit_exists(root, head_ref):
 16838	        print(f"擋下:範圍 {diff_range} 有一端不是本地存在的 commit", file=sys.stderr)
 16839	        return 2
 16840	    base_sha, head_sha = _lens_full_sha(root, base_ref), _lens_full_sha(root, head_ref)
 16841	    if not base_sha or not head_sha:
 16842	        print("擋下:sha 解析不到或格式不對", file=sys.stderr)
 16843	        return 2
 16844	    ml = _mainline_ref(root)
 16845	    if ml is None:
 16846	        print("擋下:找不到主線(main/master 都沒有)", file=sys.stderr)
 16847	        return 4
 16848	    anc = _lens_git(root, "merge-base", "--is-ancestor", base_sha, ml[1])
 16849	    if anc is None or anc.returncode != 0:
 16850	        print(f"擋下:base {base_ref} 不在主線 {ml[0]} 的歷史上——鏡頭只信主線可達的 base", file=sys.stderr)
 16851	        return 4
 16852	    cpath = _lens_cache_path(root, base_sha, head_sha)
 16853	    cached = None if (no_cache or os.environ.get("LUMOS_DISPATCH_LENS_NO_CACHE")) else _lens_cache_read(cpath)
 16854	    if cached is not None:
 16855	        cached["cache_hit"] = True
 16856	        if as_json:
 16857	            print(_json.dumps(cached, ensure_ascii=False))
 16858	        else:
 16859	            print(cached.get("text", ""))
 16860	        return 0
 16861	    buf = io.StringIO()
 16862	    with contextlib.redirect_stdout(buf):
 16863	        rc = cmd_impact_diff(diff_range, repo=str(root), as_json=True)
 16864	    if rc != 0:
 16865	        return rc
 16866	    try:
 16867	        data = _json.loads(buf.getvalue().strip().splitlines()[-1])
 16868	    except (ValueError, IndexError):
 16869	        print("擋下:impact --diff 回傳讀不懂", file=sys.stderr)
 16870	        return 2
 16871	    pins = [v for v in data.get("results", []) if v.get("pinned")]
 16872	    # d8 記在案的污染源:凍結快照 patch 是審計證物,手貼時靠人眼剔,這裡機器剔
 16873	    pins = [v for v in pins if not all(str(f).startswith("governance/review-reports/") for f in (v.get("files") or []))]
 16874	    lt = _lens_git(root, "ls-tree", "-r", base_sha, quote=True)
 16875	    if lt is None or lt.returncode != 0:
 16876	        print("擋下:讀不到 base 樹", file=sys.stderr)
 16877	        return 2
 16878	    base_modes = {}
 16879	    for l in lt.stdout.splitlines():
 16880	        # 格式:<mode> <type> <sha>\t<path>
 16881	        try:
 16882	            meta_part, path_part = l.split("\t", 1)
 16883	            base_modes[path_part.strip()] = meta_part.split()[0]
 16884	        except ValueError:
 16885	            continue
 16886	    base_tree = set(base_modes)
 16887	    # 圖譜根從 base 樹解析(工作樹版 _vault_in 取排序第一個,分支加一個空目錄就能熄燈——r3 載荷席)
 16888	    slugs = sorted({p.split("/", 2)[1] for p in base_tree if p.startswith("docs/") and p.count("/") >= 2 and p.split("/", 2)[1].endswith("-knowledge")})
 16889	    if not slugs:
 16890	        print("擋下:base 樹裡沒有 docs/*-knowledge", file=sys.stderr)
 16891	        return 3
 16892	    vault_rel = f"docs/{slugs[0]}/"
 16893	    listed, omitted_nodes, omitted_files = [], 0, 0
 16894	    for v in pins:
 16895	        node = str(v.get("node", ""))
 16896	        rel = vault_rel + node
 16897	        if rel not in base_tree:
 16898	            omitted_nodes += 1
 16899	            continue
 16900	        files_ok = [f for f in (v.get("files") or []) if isinstance(f, str) and f in base_tree and len(f) <= 200]
 16901	        omitted_files += len(v.get("files") or []) - len(files_ok)
 16902	        listed.append({"node": node, "rel": rel, "kind": _LENS_KIND.get(v.get("kind"), None),
 16903	                       "contract": _lens_contract_class(v), "files": files_ok})
 16904	    # v1.1:綁定測試狀態——測試索引每次執行只建一次(對整 repo os.walk,逐節點重建會撞內層 45 秒);
 16905	    # 設定壞(多平台缺 default_platform)→整批不標、印固定「略」行,★例外訊息一字不印★(訊息內嵌 .lumos/config.json 字串)
 16906	    bound_status, _bidx = "ok", None
 16907	    try:
 16908	        _bidx = _platform_test_index(root)
 16909	    except Exception:
 16910	        bound_status = "skipped-no-config"
 16911	    lines = []
 16912	    fallback_status = "none"
 16913	    if not listed:
 16914	        # v1.2:固定席 0 篇不再靜默——附 code 層既有相依備援段(全部只用 base 樹;預算扣 impact 已耗)
 16915	        deadline = _t0 + _LENS_INNER_BUDGET - _LENS_FALLBACK_RESERVE
 16916	        fb_lines, fallback_status, _fb_meta = _lens_fallback(root, base_sha, head_sha, list(data.get("files") or []), base_tree, base_modes, deadline)
 16917	        lines.extend(fb_lines)
 16918	    if listed:
 16919	        lines.append(_LENS_HEADER)
 16920	        for i, it in enumerate(listed):
 16921	            if i < cap:
 16922	                lines.append(f"- {it['rel']}" + (f" [{it['kind']}]" if it["kind"] else "") + (f" ★{it['contract']}★" if it["contract"] else ""))
 16923	                if it["files"]:
 16924	                    lines.append("  牽連檔:" + ",".join(it["files"][:5]) + (f"(另 {len(it['files'])-5} 個)" if len(it["files"]) > 5 else ""))
 16925	                sh = _lens_git(root, "show", f"{base_sha}:{it['rel']}", quote=True)
 17920	
 17921	    p = sub.add_parser("prose-lint", help="spec 白話健檢:掃中文模糊措辭(恆 rc0 只提醒不擋;排除 code fence 與引句行)")
 17922	    p.add_argument("path", help="要掃的 markdown 檔路徑")
 17923	
 17924	    p = sub.add_parser("refcheck", help="spec 指涉宣稱確定性核對(vault-free):inline-code 路徑/行號 → 存在性 manifest")
 17925	    p.add_argument("md", help="要核對的 markdown 檔")
 17926	    p.add_argument("--repo", dest="refcheck_repo", help="repo root(預設 cwd 逐層向上找 .git)")
 17927	    p.add_argument("--json", dest="as_json", action="store_true", help="輸出 JSON manifest")
 17928	
 17929	    p = sub.add_parser("dispatch-lens", help="代碼審派工詞的固定席鏡頭:把 <base>..<head> 碰到的合約/事故節點整理成可附進派工詞的純文字(hook 用;內容從 base 讀,零自由文字)")
 17930	    p.add_argument("lens_range", help="diff 範圍,恰好 <base>..<head>;base 必須在主線歷史上")
 17931	    p.add_argument("--repo", dest="lens_repo", help="repo 內任一路徑(會自己找 repo 根)")
 17932	    p.add_argument("--json", dest="lens_json", action="store_true", help="JSON 輸出 {text,pinned,listed,omitted_nodes,omitted_files,mainline,cache_hit}")
 17933	    p.add_argument("--no-cache", dest="lens_nocache", action="store_true", help="不讀不寫 20 分鐘快取")
 17934	    p = sub.add_parser("impact", help="動手前算出哪些知識圖譜節點會被 code 改動波及")
 17935	    p.add_argument("--file", dest="impact_file", help="被改動的 code 檔路徑(單檔模式;與 --diff/--node 三擇一)")
 17936	    p.add_argument("--node", dest="impact_node", help="[M4/S2] typed hop-1 第三模式:列「誰以 verified_by/plan_refs 指向該節點」(單層;與 --depth 互斥)")
 17937	    p.add_argument("--diff", dest="impact_diff", help="diff range(如 main..HEAD):聚合各改動檔的 ranked impact 成受影響功能面 manifest(code-loop 審計鏡頭)")
 17938	    p.add_argument("--sync-only", action="store_true", dest="impact_sync_only",
 17939	                   help="配 --sync-check:只印「該動卻沒動」的點名(hooks 用),不印受影響功能面")
 17940	    p.add_argument("--sync-check", action="store_true", dest="impact_sync",
 17941	                   help="落成核對(配 --diff):預期受影響節點 vs 分支實際動過節點 → 未同步清單(advisory)")
 17942	    p.add_argument("--repo", dest="impact_repo", help="repo root(缺則退回 find_vault;hook 必傳)")
 17943	    p.add_argument("--depth", dest="impact_depth", type=int, default=None, help="BFS 展開深度(缺省讀 .lumos/impact.json;最終預設 2)")
 17944	    p.add_argument("--json", dest="impact_json", action="store_true", help="JSON 輸出(機器可讀)")
 17945	    p.add_argument("--ranked", action="store_true", dest="impact_ranked", help="融合排序+固定席+降噪(dormant v1)")
 17946	    p.add_argument("--top", type=int, dest="impact_top", default=8, help="--ranked 非固定項上限")
 17947	    p.add_argument("--min-score", type=float, dest="impact_min", default=0.20, help="--ranked 分數底線")
