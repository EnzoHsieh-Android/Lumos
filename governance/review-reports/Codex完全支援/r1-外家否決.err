    67	def _is_excluded_path(file_path: str) -> bool:
    68	    """判斷路徑是否在排除清單(EXCLUDE_PATH_CONTAINS + EXCLUDE_FILENAMES)。"""
    69	    norm = file_path.replace("\\", "/")
    70	    # 確保路徑段比對加 leading slash 一致性
    71	    if not norm.startswith("/"):
    72	        norm_check = "/" + norm
    73	    else:
    74	        norm_check = norm
    75	    for seg in EXCLUDE_PATH_CONTAINS:
    76	        if seg in norm_check:
    77	            return True
    78	    p = Path(file_path)
    79	    if p.name in EXCLUDE_FILENAMES:
    80	        return True
    81	    return False
    82	
    83	
    84	_SHEBANG_HINTS = (b"python", b"bash", b"/sh", b"env sh", b"zsh")
    85	
    86	
    87	def _shebang_is_code(abs_path: Path) -> bool:
    88	    """無副檔名檔靠首行 shebang 入樣(主session鏡頭利用率_計劃 前置修正①:scripts/lumos、git hooks 原本永不入樣)。
    89	    只讀前 128 bytes、包 try/except:二進位/不存在/讀不到 → False,現役 fail-open hook 不得因此炸。"""
    90	    try:
    91	        if not abs_path.is_file():
    92	            return False
    93	        with open(abs_path, "rb") as fh:
    94	            head = fh.read(128)
    95	    except OSError:
    96	        return False
    97	    if not head.startswith(b"#!"):
    98	        return False
    99	    first = head.split(b"\n", 1)[0]
   100	    return any(h in first for h in _SHEBANG_HINTS)
