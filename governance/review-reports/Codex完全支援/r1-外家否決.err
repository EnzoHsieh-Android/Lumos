    58	def extract_path(payload: dict) -> str | None:
    59	    """從 hook payload 的 tool_input.file_path 巢狀 dict 取路徑。
    60	
    61	    r8-F9 / r9-F8 說明:file_path 在 tool_input 巢狀 dict 內,非頂層。
