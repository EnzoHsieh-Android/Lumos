 10578	def _reinject_claude_block(root: Path, slug: str) -> "ReInjectResult":
 10579	    """讀 vendored 範本 → {{KG}} 替換 → 組 sentinel block → 依三態更新 CLAUDE.md。
 10580	
 10581	    status ∈ created|updated|unchanged|appended|sentinel_broken|no_template。
 10582	    diff:僅 updated 帶 difflib.unified_diff 字串,其餘 None。
 10583	    讀入時正規化 CRLF→LF 並去 BOM;寫入一律 _write_lf(強制 LF / 無 BOM)。
 10584	    """
 10585	    import difflib
 10586	
 10587	    # 1. 範本 + body(共用 _expected_claude_body 確保 Check D 比對算法一致)
 10588	    body = _expected_claude_body(root, slug)
 10589	    if body is None:
 10590	        return ReInjectResult("no_template", None)
 10591	
 10592	    # 3. 組 block(START 行帶當前版本戳,機械插值——版本在 body 外,不影響 Check D 比對)
 10593	    start_line = _START_TEMPLATE.format(version=LUMOS_VERSION)
 10594	    block = start_line + "\n" + body + "\n" + _CLAUDE_END
 10595	
 10596	    # 4. 讀 CLAUDE.md(去 BOM + CRLF 正規化)
 10597	    cm = root / "CLAUDE.md"
 10598	    if cm.exists():
 10599	        raw = cm.read_bytes()
 10600	        # 去 UTF-8 BOM
 10601	        if raw.startswith(b"\xef\xbb\xbf"):
 10602	            raw = raw[3:]
 10603	        claude_text = raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
 10604	    else:
 10605	        claude_text = None
 10606	
 10607	    # 5. 三態分派
 10608	    if claude_text is None:
 10609	        # CLAUDE.md 不存在 → created
 10610	        _write_lf(cm, "# CLAUDE.md\n\n" + block + "\n")
 10611	        return ReInjectResult("created", None)
 10612	
 10613	    state, span = _extract_claude_block_span(claude_text)
 10614	
 10615	    if state == "broken":
 10616	        return ReInjectResult("sentinel_broken", None)
 10617	
 10618	    if state == "absent":
 10619	        # 有 CLAUDE.md 但無 sentinel → appended
 10620	        new_text = claude_text.rstrip() + "\n\n" + block + "\n"
 10621	        _write_lf(cm, new_text)
 10622	        return ReInjectResult("appended", None)
 10623	
 10624	    # state == "found": splice body + 同步刷新 START 行(版本戳落在存量戶的唯一路徑——
 10625	    # 只換 body 會讓 updated 路徑永遠拿不到版本戳,標籤機制對存量安裝戶形同虛設。
 10626	    # START 行在管理區塊「內」,★INVARIANT★ 只保護 sentinel 之外,刷新它不違約)。
 10627	    old_body = span.body
 10628	    new_body = body
 10629	    si = claude_text.find(_CLAUDE_START_PREFIX)
 10630	    sl_begin = claude_text.rfind("\n", 0, si) + 1
 10975	                               capture_output=True, text=True, encoding="utf-8", errors="replace")
 10976	            if r.returncode != 0:
 10977	                raise OSError(r.stderr)
 10978	        else:
 10979	            dst.symlink_to(src)
 10980	    except OSError:
 10981	        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8
 10982	        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")
