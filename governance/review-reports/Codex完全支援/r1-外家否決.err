 10373	def cmd_deinit(keep_graph=False, dry_run=False, yes=False, source=None):
 10374	    """專案層反安裝(對稱 cmd_init):拆本 repo 的 pre-commit 閘 / vendored 工具組 /
 10375	    CLAUDE.md 注入區塊 /(預設)圖譜 vault。不碰機器共用項(~/.claude)。不自動 commit。"""
 10376	    import subprocess
 10377	    # root 走 git toplevel;非 git 目錄中止(不 fallback cwd——deinit 會刪檔)
 10378	    try:
 10379	        root = Path(subprocess.check_output(
 10380	            ["git", "rev-parse", "--show-toplevel"], text=True,
 10381	            stderr=subprocess.DEVNULL).strip())
 10382	    except Exception:
 10383	        print("擋下:這裡不是 git 專案,移除需要確定的專案根目錄,不會拿目前目錄猜", file=sys.stderr)
 10384	        return 2
 10385	    # pre-flight 守衛①:來源 repo 自我保護(對齊 cmd_update 的 root==src → return 2)
 10386	    src = _lumos_src(source)
 10387	    if root.resolve() == src.resolve():
 10388	        print("擋下:你現在就在 Lumos 工具鏈的來源 repo 裡,不能在這裡移除它自己", file=sys.stderr)
 10389	        return 2
 10390	    # ★dry-run 例外(2026-08-02 代碼審 r2)★:純預覽、零 mutation,不會走到刪自己那一步,
 10391	    # 擋它只是誤傷合法的唯讀操作(而且使用者正想用它看看會動到什麼)。
 10392	    if not dry_run and _selfdelete_risk(root):   # Windows 自刪——mutation 之前擋
 10393	        print("擋下:Windows 上不能用專案自帶的那份 lumos 拆它自己"
 10394	              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
 10395	              "留下拆一半的狀態。", file=sys.stderr)
 10396	        print("  改用全域指令重跑:  lumos deinit", file=sys.stderr)
 10397	        print("  (若 PATH 還沒吃到,先重開一個終端;或直接用來源那份:"
 10398	              f"  python {src / 'scripts' / 'lumos'} deinit)", file=sys.stderr)
 10399	        return 2
 10400	    vault = _vault_in(root)
 10401	    # pre-flight 守衛②:vault == root 鐵閘(防 rmtree 整個 repo)
 10402	    if vault is not None and vault.resolve() == root.resolve() and not keep_graph:
 10403	        keep_graph = True
 10404	        print("⚠ 偵測到 standalone vault(圖譜=repo 根):強制保留圖譜,只拆其餘專案層。",
 10405	              file=sys.stderr)
 10406	    will_delete_vault = (vault is not None) and (not keep_graph)
 10407	    installed = _deinit_detect_installed(root)
 10408	    has_claude = _claude_block_present(root)
 10409	    if not installed and not will_delete_vault and not has_claude:
 10410	        print("✓ 未安裝(此 repo 無 Lumos 專案層)")
 10411	        return 0
 10412	    if dry_run:
 10413	        print("lumos deinit --dry-run(僅預演,不改動):")
 10414	        print(f"  root: {root}")
 10415	        print("  拆閘: git config --unset core.hooksPath" if installed
 10416	              else "  拆閘: (core.hooksPath 未設,略)")
 10417	        if has_claude:
 10418	            print("  剝 CLAUDE.md graph-discipline 區塊")
 10419	        if will_delete_vault:
 10420	            n = len([f for f in vault.rglob("*") if f.is_file()])
 10421	            print(f"  刪圖譜 vault: {vault}({n} 檔)")
 10422	        elif vault is not None:
 10423	            print(f"  保留圖譜 vault: {vault}")
 10424	        print("  移除 vendored 工具組(白名單:5 檔 + hooks/templates 兩夾)")
 10425	        return 0
 10426	    if will_delete_vault and not yes:
 10427	        if not sys.stdin.isatty():
 10428	            print("擋下:這不是互動式終端、沒辦法問你確認,又沒加 --yes,不刪圖譜。確定要刪就加 --yes",
 10429	                  file=sys.stderr)
 10430	            return 2
 10431	        files = [f for f in vault.rglob("*") if f.is_file()]
 10432	        dirty = subprocess.run(["git", "-C", str(root), "status", "--porcelain", str(vault)],
 10433	                               capture_output=True, text=True).stdout
 10434	        n_dirty = len([ln for ln in dirty.splitlines() if ln.strip()])
 10435	        print(f"將刪除圖譜 vault: {vault}({len(files)} 檔)")
 10555	        body_start = body_raw_start
 10556	        body_end = body_raw_start
 10557	        stripped = ""
 10558	
 10559	    return ("found", BlockSpan(body=stripped, body_start=body_start, body_end=body_end))
