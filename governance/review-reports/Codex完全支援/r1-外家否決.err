   103	def hook_decide(payload: dict, repo: str | None = None) -> str | None:
   104	    """過濾邏輯:決定是否對此 payload 觸發 lumos impact。
   105	
   106	    回傳:
   107	      None   → 放行(非 code / 排除路徑)
   108	      str    → 要送給 lumos impact 的 file_path(非空字串)
   109	
   110	    此函式設計為可獨立 import 測試(不依賴 stdin/subprocess)。
   111	    repo 給了才做無副檔名 shebang 判定(相對路徑相對 repo 解;沒 repo 維持只看副檔名)。
   112	    """
   113	    file_path = extract_path(payload)
   114	    if not file_path:
   115	        return None
   116	    p = Path(file_path)
   117	    if p.suffix.lower() not in CODE_EXTS:
   118	        if not (p.suffix == "" and repo):
   119	            return None
   120	        abs_path = p if p.is_absolute() else Path(repo) / p
   121	        if not _shebang_is_code(abs_path):
   122	            return None
   123	    if _is_excluded_path(file_path):
   124	        return None
   125	    return file_path
