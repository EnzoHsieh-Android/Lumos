 10249	def cmd_uninstall():
 10250	    """對稱移除 cmd_install 裝的東西:全域指令(Unix symlink / Win lumos.cmd)+ user-scope skills。"""
 10251	    import os, shutil
 10252	    if _refuse_if_probe("uninstall"):
 10253	        return 2
 10254	    removed = []
 10255	    bindir = Path.home() / ".local" / "bin"
 10256	    for name in ("lumos.cmd", "lumos"):          # Win shim + Unix symlink
 10257	        g = bindir / name
 10258	        if g.is_symlink():
 10259	            removed.append(f"{g}(symlink → {g.resolve()})"); g.unlink()
 10260	        elif g.exists():
 10261	            # 守衛(std F10,teardown一鍵拆機_計劃):同名一般檔不刪(可能是使用者別的工具);
 10262	            # 只有 symlink 才是我方 install 產物。避免 uninstall/teardown 誤刪非我方檔。
 10263	            print(f"  ⚠ {g} 是一般檔(非 symlink),保留不動——非 lumos 安裝物", file=sys.stderr)
 10264	    sk = Path.home() / ".claude" / "skills"      # 對稱 _install_skills:junction/symlink/複製夾都清
 10265	    for s in _SKILLS:
 10266	        d = sk / s
 10267	        if d.is_symlink():
 10268	            d.unlink(); removed.append(str(d))
 10269	        elif d.is_dir():
 10270	            try:
 10271	                os.rmdir(d)                       # junction/空夾:只移連結本身,不跟進 target(同 W4)
 10272	            except OSError:
 10273	                shutil.rmtree(d, ignore_errors=True)
 10274	            removed.append(str(d))
 10275	    if removed:
 10276	        print("✓ 移除:\n  " + "\n  ".join(removed))
 10277	    else:
 10278	        print("✓ 未安裝(無全域 lumos / skills)")
 10279	    return 0
