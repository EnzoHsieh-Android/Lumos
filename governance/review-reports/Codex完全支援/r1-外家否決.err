 11003	def _scaffold_project(root: Path, slug: str):
 11004	    kg = root / "docs" / f"{slug}-knowledge"
 11005	    if kg.exists():
 11006	        print(f"  ✓ vault 已存在,跳過 scaffold(保護資料): {kg}")
 11007	        return
 11008	    for d in _INIT_SUBDIRS_FULL:
 11009	        (kg / d).mkdir(parents=True, exist_ok=True)
