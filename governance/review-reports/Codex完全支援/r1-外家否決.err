     1	#!/usr/bin/env python3
     2	"""dispatch-lens-hook — Claude Code PreToolUse(matcher Agent)薄殼(Projects/派工鏡頭注入_計劃,2026-09-03)。
     3	
     4	只做三件事:①派工詞裡逐行找 `LUMOS-IMPACT: <base>..<head>` ②subprocess 叫 `lumos dispatch-lens`
     5	③把回傳文字接在派工詞尾端,經 updatedInput 送給子代理(additionalContext 實測到不了子代理)。
     6	其餘判斷(範圍文法、base 主線可達、消毒、快取)全在 lumos 端。
     7	永不 deny、永不改 permissionDecision;任何失敗都原樣放行、預設靜默(LUMOS_HOOK_DEBUG=1 才印 stderr)。
     8	本檔在 ANCHOR_FILES 內:改它要 `lumos anchor approve --note`。
     9	"""
    10	from __future__ import annotations
    11	
    12	import json
    13	import os
    14	import re
    15	import subprocess
    16	import sys
    17	from pathlib import Path
    18	
    19	MARKER_RE = re.compile(r"^LUMOS-IMPACT:\s*(\S+)\s*$")
    20	INNER_TIMEOUT = 45   # 外層 HOOK_ENTRIES 宣告 60;內層必須明顯小於外層(enforcement儀表板_計劃 事故)
    21	
