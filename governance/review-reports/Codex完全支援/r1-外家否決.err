   252	def extract_delta_query(payload: dict, cap_tokens: int = 512, cap_chars: int = 8000) -> str:
   253	    """v1.1:從 tool_input 抽「這次改動的內容」當查詢詞(spec §3)。
   254	
   255	    Edit = old_string+new_string(刪與增都算「碰到」);MultiEdit = 各 edit 串接;
   256	    Write = content 全文。cap:512 distinct 空白分詞(CJK 連串視為一詞,罕觸頂)+ 字元上限兜底。
   257	    prospective 整檔重建刻意省略:content trigger 已 delta-scoped(比對本查詢詞),
   258	    新增/刪除的危險內容都在 delta 內,不需為觸發語意重建整檔。"""
   259	    ti = payload.get("tool_input") or {}
   260	    tool = payload.get("tool_name", "")
   261	    parts: list[str] = []
   262	    if tool == "Edit":
   263	        parts = [str(ti.get("old_string") or ""), str(ti.get("new_string") or "")]
   264	    elif tool == "MultiEdit":
   265	        for e in (ti.get("edits") or []):
   266	            if isinstance(e, dict):
   267	                parts += [str(e.get("old_string") or ""), str(e.get("new_string") or "")]
   268	    elif tool == "Write":
   269	        parts = [str(ti.get("content") or "")]
   270	    # 每段獨立配額(codex r1+r2 折入):先串接再整體截斷會讓「超長 old_string」吃掉整段 new;
   271	    # 地板配額×多段再尾切又會吃掉後段 edit(r2 抓到的同類假陰性)——
   272	    # 故:每段保底 300 字元、總量不再尾切(查詢只餵斷詞與 regex,尺寸無虞;512 token cap 照舊)。
   273	    nz = [p for p in parts if p]
   274	    per_part = max(300, cap_chars // max(1, len(nz)))
   275	    q = " ".join(p[:per_part] for p in nz)
   276	    toks = q.split()
   277	    if len(set(toks)) > cap_tokens:
   278	        seen: set[str] = set()
   279	        kept: list[str] = []
   280	        for tok in toks:
   281	            if tok not in seen:
   282	                seen.add(tok)
   283	                if len(seen) > cap_tokens:
   284	                    break
   285	            kept.append(tok)
   286	        q = " ".join(kept)
   287	    return q
