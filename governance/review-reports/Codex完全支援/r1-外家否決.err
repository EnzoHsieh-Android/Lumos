   113	
   114	def _prune_dangling(settings: dict) -> list:
   115	    """剪掉指向 ~/.claude/hooks/ 下「不存在檔案」的 hook 註冊(懸空只會每回合報錯)。
   116	    起因 2026-07-07 現場事故:code-loop-guard.py 被工具鏈更新刪除、settings 註冊沒清 →
   117	    每回合「檔案不存在」。只動 command 含 `.claude/hooks/` 的項;使用者自訂
   118	    (指向他處)的 command 一律不碰。回傳被剪的 (event, script) 列表。"""
   119	    pruned = []
   120	    for event, entries in list(settings.get("hooks", {}).items()):
   121	        kept_entries = []
   122	        for entry in entries:
   123	            kept_hooks = []
   124	            for h in entry.get("hooks", []):
   125	                cmd = h.get("command", "")
   126	                if ".claude/hooks/" in cmd.replace("\\", "/"):
   127	                    script = _hook_script(cmd)
   128	                    if script.endswith(".py") and not (HOOKS_DIR / script).exists():
   129	                        pruned.append((event, script))
   130	                        continue
   131	                kept_hooks.append(h)
   132	            if kept_hooks or not entry.get("hooks"):
   133	                entry = dict(entry)
   134	                if "hooks" in entry:
   135	                    entry["hooks"] = kept_hooks
   136	                kept_entries.append(entry)
   137	            # else:整組 hooks 都懸空 → entry 一併剪
   138	        settings["hooks"][event] = kept_entries
   139	    return pruned
   140	
   141	
   142	def _hook_script(cmd: str):
   143	    m = re.search(r"([\w.-]+\.py)", cmd or "")
   144	    return m.group(1) if m else cmd
   145	
   146	
   147	def _equivalent(a: dict, b: dict) -> bool:
   148	    """同一個 hook entry 認定為已存在 (避免重複註冊)。
   149	    比對:matcher (PostToolUse 需要) + 內層 hook 腳本檔名
   150	    (認出舊裸路徑 == 新 `python …/xxx.py` 為同一 hook)。"""
   151	    if a.get("matcher") != b.get("matcher"):
   152	        return False
   153	    a_s = sorted(_hook_script(h.get("command", "")) for h in a.get("hooks", []))
   154	    b_s = sorted(_hook_script(h.get("command", "")) for h in b.get("hooks", []))
   155	    return a_s == b_s
   156	
   157	
   158	def main() -> int:
   159	    if SETTINGS.exists():
   160	        try:
   161	            settings = json.loads(SETTINGS.read_text(encoding="utf-8"))
   162	        except json.JSONDecodeError as e:
   163	            print(f"ERROR: {SETTINGS} JSON 損毀: {e}", file=sys.stderr)
   164	            return 1
   165	    else:
   166	        settings = {}
   167	
   168	    settings.setdefault("hooks", {})
   169	    changed = False
   170	
   171	    # 先清懸空(腳本已被刪、註冊還在 → 每回合報錯),再 merge
   172	    for event, script in _prune_dangling(settings):
   173	        print(f"  [prune] {event} hook → {script}(檔案不存在,懸空註冊已清)")
   174	        changed = True
   175	
   176	    # --prune-only:只剪懸空、★不 re-add★(teardown 用——刪掉我方 hook .py 後跑此模式,
   177	    # 剪掉變懸空的我方註冊而不把它加回去;預設 merge 模式會 re-add,反而抵銷 teardown)。
   178	    prune_only = "--prune-only" in sys.argv
   179	
   180	    for event, entries_to_add in ({} if prune_only else HOOK_ENTRIES).items():
   181	        existing = settings["hooks"].setdefault(event, [])
   182	        for new_entry in entries_to_add:
   183	            match_idx = next((i for i, e in enumerate(existing) if _equivalent(new_entry, e)), None)
   184	            if match_idx is not None:
   185	                if existing[match_idx] != new_entry:
   186	                    existing[match_idx] = new_entry  # 遷移:取代成 resolved-python 格式
   187	                    print(f"  [migrate] {event} hook → resolved-python")
   188	                    changed = True
   189	                else:
   190	                    print(f"  [skip] {event} hook already current")
   191	                continue
   192	            existing.append(new_entry)
   193	            print(f"  [add ] {event} hook")
   194	            changed = True
   195	
   196	    # ★自癒去重(2026-08-21 體檢 #1)★:舊版安裝器在 _equivalent 上線前已把同一 hook 註冊兩次
   197	    # (verification-rot-check / check-graph-sync 各兩份,每次事件跑兩遍、Sonnet 呼叫翻倍)。
   198	    # 合併後再掃一次,等價項只留第一份;與 --prune-only 一樣是修復動作,每次執行都跑。
   199	    for event, entries in settings["hooks"].items():
   200	        kept = []
   201	        for e in entries:
   202	            if any(_equivalent(e, k) for k in kept):
   203	                print(f"  [dedupe] {event} hook 重複註冊,移除一份")
   204	                changed = True
   205	                continue
   206	            kept.append(e)
   207	        settings["hooks"][event] = kept
   208	
   209	    if not changed:
   210	        print("settings.json 已經是最新狀態,無需修改")
   211	        return 0
   212	
   213	    # Backup before write
   214	    if SETTINGS.exists():
   215	        backup = SETTINGS.with_suffix(".json.bak")
   216	        backup.write_text(SETTINGS.read_text(encoding="utf-8"), encoding="utf-8")
   217	        print(f"  備份到: {backup}")
   218	
   219	    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
   220	    SETTINGS.write_text(
