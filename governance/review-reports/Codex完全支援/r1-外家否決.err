 10954	def _link_or_copy(src: Path, dst: Path):
 10955	    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
 10956	    import os, shutil, subprocess
 10957	    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
 10958	    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
 10959	    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
 10960	    if dst.is_symlink():
 10961	        dst.unlink()                                  # Unix symlink
 10962	    elif dst.is_dir():
 10963	        try:
 10964	            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
 10965	        except OSError:
 10966	            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
 10967	    elif dst.exists():
 10968	        dst.unlink()
 10969	    dst.parent.mkdir(parents=True, exist_ok=True)
 10970	    try:
 10971	        if _IS_WIN:
 10972	            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
 10973	            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
 10974	            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
 10975	                               capture_output=True, text=True, encoding="utf-8", errors="replace")
 10976	            if r.returncode != 0:
 10977	                raise OSError(r.stderr)
 10978	        else:
 10979	            dst.symlink_to(src)
 10980	    except OSError:
 10981	        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8
 10982	        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")
 10983	
 10984	
 10985	def _install_skills():
 10986	    # ★r1 正確性席:防線下移到真正動全域機器狀態的地方★——原本只擋四個指令入口,
 10987	    # 但 cmd_init → _vendor_toolchain → _install_hooks_py 這條路也會重連 ~/.claude/skills、繞過入口守衛。
 10988	    # 擋在這個變動原語,不論從哪個指令進來都擋得住。
 10989	    if _refuse_if_probe("install-skills"):
 10990	        return
 10991	    repo = Path(__file__).resolve().parent.parent
 10992	    dest = Path.home() / ".claude" / "skills"
 10993	    for s in _SKILLS:
 10994	        src = repo / "skills" / s
 10995	        if src.is_dir():
 10996	            _link_or_copy(src, dest / s)
 10997	            print(f"  ✓ skill {s}")
