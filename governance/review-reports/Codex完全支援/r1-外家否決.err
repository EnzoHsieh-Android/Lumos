 11057	def _sync_global_claude(src_repo: Path):
 11058	    """全域 ~/.claude hooks/settings 同步(不需專案;install 與 _install_hooks_py 共用)。
 11059	    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)。
 11060	    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);寫 ~/.claude(HOME 隔離可測)。
 11061	    設計:Projects/install全域hook同步_計劃。回 True=有做、False=探針下被擋沒做(呼叫端據此不印假成功)。"""
 11062	    # ★r1 正確性席:同 _install_skills——cmd_init/_vendor_toolchain 這條路會經此覆寫真的 ~/.claude/hooks
 11063	    # 與動 settings.json,繞過四個指令入口的守衛。擋在變動原語。
 11064	    if _refuse_if_probe("sync-global-claude"):
 11065	        return False
 11066	    import subprocess, shutil
 11067	    chooks = Path.home() / ".claude" / "hooks"
 11068	    chooks.mkdir(parents=True, exist_ok=True)
 11069	    src_dir = src_repo / "scripts" / "hooks" / "claude"
 11070	    for f in _GLOBAL_CLAUDE_HOOKS:            # ① 現役 hooks copy
 11071	        s = src_dir / f
 11072	        if s.exists():
 11073	            shutil.copy2(s, chooks / f)
 11074	    for f in _RETIRED_STUB_CLAUDE_HOOKS:      # ②a 相容期:換 exit 0 空殼,★不刪檔★
 11075	        stub = chooks / f                     #     (刪了會炸掉還帶著舊註冊的 session)
 11076	        if stub.is_symlink():
 11077	            stub.unlink()                     #     symlink 先拆,免得寫穿到來源檔
 11078	        stub.write_text(_RETIRED_HOOK_STUB_BODY, encoding="utf-8")
 11079	        stub.chmod(0o755)
 11080	    for f in _RETIRED_CLAUDE_HOOKS:           # ②b 過了相容期:真刪殘留檔
 11081	        stale = chooks / f
 11082	        if stale.exists() or stale.is_symlink():
