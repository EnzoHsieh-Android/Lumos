    28	def find_marker(prompt: str) -> str | None:
    29	    for line in prompt.split("\n"):
    30	        m = MARKER_RE.match(line.strip())
    31	        if m:
    32	            return m.group(1)
    33	    return None
    34	
    35	
    36	def _find_lumos_script() -> str | None:
    37	    import shutil
    38	    w = shutil.which("lumos")
    39	    if w:
    40	        return w
    41	    cand = Path(__file__).resolve().parent.parent.parent.parent / "scripts" / "lumos"
    42	    return str(cand) if cand.is_file() else None
    43	
    44	
    45	def main() -> int:
    46	    try:
    47	        payload = json.loads(sys.stdin.read())
    48	    except (json.JSONDecodeError, ValueError):
    49	        return 0
    50	    if not isinstance(payload, dict) or payload.get("tool_name") != "Agent":
    51	        return 0
    52	    tool_input = payload.get("tool_input")
    53	    if not isinstance(tool_input, dict):
    54	        return 0
    55	    prompt = tool_input.get("prompt")
    56	    if not isinstance(prompt, str):
    57	        return 0
    58	    rng = find_marker(prompt)
    59	    if rng is None:
    60	        return 0
    61	    repo = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd", "")
    62	    if not repo:
    63	        _debug("沒有 CLAUDE_PROJECT_DIR 也沒有 cwd,放行")
    64	        return 0
    65	    lumos = _find_lumos_script()
    66	    if lumos is None:
    67	        _debug("找不到 lumos,放行")
    68	        return 0
    69	    try:
    70	        r = subprocess.run([sys.executable, lumos, "dispatch-lens", rng, "--repo", repo, "--json"],
    71	                           capture_output=True, text=True, timeout=INNER_TIMEOUT)
    72	    except (OSError, subprocess.TimeoutExpired) as e:
    73	        _debug(f"lumos dispatch-lens 失敗或超時({type(e).__name__}),放行")
    74	        return 0
    75	    if r.returncode != 0:
    76	        _debug(f"lumos dispatch-lens rc={r.returncode}:{r.stderr.strip()[:200]},放行")
    77	        return 0
    78	    try:
    79	        data = json.loads(r.stdout.strip().splitlines()[-1])
    80	    except (ValueError, IndexError):
    81	        _debug("回傳讀不懂,放行")
    82	        return 0
    83	    text = data.get("text") if isinstance(data, dict) else None
    84	    if not text:
    85	        _debug(f"固定席 0 篇(pinned={data.get('pinned') if isinstance(data, dict) else '?'}),不注入")
    86	        return 0
    87	    new_input = dict(tool_input)
    88	    new_input["prompt"] = prompt.rstrip("\n") + "\n\n" + text + "\n"
    89	    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": new_input}},
    90	                     ensure_ascii=False))
    91	    _debug(f"已附 {data.get('shown')} 篇(固定席 {data.get('pinned')},主線 {data.get('mainline')})")
    92	    return 0
    93	
    94	
    95	if __name__ == "__main__":
    96	    sys.exit(main())
    95	    if not isinstance(msg, dict):
