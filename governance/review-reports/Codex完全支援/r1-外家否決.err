   377	
   378	def build_ranked_context(data: dict) -> str:
   379	    """v1.1:把 ranked 輸出({results,meta})轉成降噪清單文字。固定席在前(合約/事故),
   380	    非固定帶分數;截斷數照 meta 標注。尾附棧別效能追問(若 lumos 輸出帶 stack_questions——
   381	    單源在 scripts/lumos 的 _STACK_PERF_QUESTIONS,本 hook 只格式化不持有內容)。"""
   382	    lines: list[str] = []
   383	    res = data.get("results", [])
   384	    meta = data.get("meta", {})
   385	    pins = [x for x in res if x.get("pinned")]
   386	    free = [x for x in res if not x.get("pinned") and not x.get("rescued")]
   387	    rescued = [x for x in res if x.get("rescued")]
   388	    if pins:
   389	        lines.append(f"必看——這 {len(pins)} 篇帶著不能破壞的合約或出過事故:")
   390	        for x in pins:
   391	            mk = {"incident": "⚠事故", "direct": "直接", "indirect": f"hop{x.get('hop','?')}"}.get(x.get("kind"), "")
   392	            ct = f" ★{x['contract']}★" if x.get("contract") else ""
   393	            mb = f"  (trigger: {x['matched_by']})" if x.get("matched_by") else ""
   394	            # about_code 語意欄位命中(工具清單 #9):讀 about_hit(只在 True 時存在),不碰既有 hit 來源標記
   395	            ab = "★關於★" if x.get("about_hit") else ""
   396	            lines.append(f"  {ab}{mk}{ct} {x.get('node','?')}{mb}")
   397	    if free:
   398	        lines.append(f"可能相關的 {len(free)} 篇(依關聯度排序):")
   399	        for x in free:
   400	            mk = {"direct": "直接", "indirect": f"hop{x.get('hop','?')}"}.get(x.get("kind"), "")
   401	            lines.append(f"  {x.get('score',0):.2f} {mk} {x.get('node','?')}")
   402	    if rescued:
   403	        # R1 直連保底(plan:hook必看召回修復):分數不過閾但為僅有的直連節點——信心層級不同於排序席
   404	        lines.append(f"另外 {len(rescued)} 篇分數不高但直接提到這個檔,一併列出:")
   405	        for x in rescued:
   406	            hit = f"/{x['hit']}" if x.get("hit") == "basename-match" else ""
   407	            lines.append(f"  {x.get('score',0):.2f} 直接{hit} {x.get('node','?')}")
   408	    if meta.get("truncated"):
   409	        lines.append(f"  (+{meta['truncated']} 條低分截斷,沒列出來)")
   410	    # pin-denoise-a-v4:參考道(JSON 獨立頂層鍵;.get 條件鍵慣例——knob=0 時鍵不存在)
   411	    lane = data.get("lane", [])
   412	    if lane:
   413	        lines.append(f"守衛面參考——這 {len(lane)} 篇是軟標記樞紐,跟每支檔都近,未被本次改動直接證實相關:")
   414	        for x in lane:
   415	            lines.append(f"  {x.get('score',0):.2f} hop{x.get('hop','?')} {x.get('node','?')}")
   416	        if meta.get("lane_truncated"):
   417	            lines.append(f"  (另有 {meta['lane_truncated']} 條守衛面參考未列出)")
   418	    for stk, qs in (data.get("stack_questions") or {}).items():
   419	        lines.append(f"[{stk} 效能檢核——動手時順答這幾個問題]")
   420	        for q in qs:
   421	            lines.append(f"  - {q}")
   422	    lines.append("")
   423	    # 收尾指令只在真的列了節點時附(單 reviewer 終審 minor:僅檢核問題時
   424	    # 「判上列節點」答非所問,會弱化對提問的聚焦——檢核段標題已自帶指令)
   425	    if res or lane:
   426	        lines.append(_INJECT_INSTRUCTION)
   427	    return "\n".join(lines)
   428	
   429	
   430	def inject_ranked_context(data: dict) -> bool:
   431	    """ranked 版注入:results/stack_questions/lane 皆空 → 不輸出(lane-only 的題也要注入,v4 Codex f2)。"""
   432	    if not data.get("results") and not data.get("stack_questions") and not data.get("lane"):
   433	        return False
   434	    print(json.dumps({"hookSpecificOutput": {
   435	        "hookEventName": "PreToolUse",
   436	        "additionalContext": build_ranked_context(data),
   437	    }}, ensure_ascii=False))
   438	    return True
   439	
   440	
   441	def inject_additional_context(impact_data: dict) -> None:
   442	    """非空影響集 → 印 hookSpecificOutput JSON 到 stdout;空集合 → 不輸出。
   443	
   444	    永不 block、永不改 permissionDecision。
   445	
   446	    注意 (r5-F2):此格式是 Claude Code 官方 PreToolUse additionalContext 能力。
   447	    上線後請用 `claude --debug` 實測注入時機(PreToolUse 的 additionalContext 注在
   448	    tool result 旁);若版本行為有變,可退回 stderr 備援(現有 hook 已證此路可行)。
   449	    """
   450	    direct = impact_data.get("direct", [])
   451	    indirect = impact_data.get("indirect", [])
   452	    incidents = impact_data.get("incidents", [])
   453	    if not direct and not indirect and not incidents:
   454	        return  # 空影響集(direct+indirect+incidents 皆空):不注入
   455	
