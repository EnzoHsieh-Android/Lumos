   149	def is_code_file(path: str, project_root: Path) -> bool:
   150	    p = Path(path)
   151	    if p.suffix.lower() not in CODE_EXTS:
   152	        return False
   153	    # 必須在 project_root 之下;避免改 ~/.claude/、/tmp 等外部檔案被誤判
   154	    try:
   155	        p.resolve().relative_to(project_root.resolve())
   156	    except (ValueError, OSError):
   157	        return False
   158	    norm = str(p).replace("\\", "/")
   159	    if any(seg in norm for seg in EXCLUDE_PATH_CONTAINS):
   160	        return False
   161	    if p.name in EXCLUDE_FILENAMES:
   162	        return False
   163	    return True
   164	
