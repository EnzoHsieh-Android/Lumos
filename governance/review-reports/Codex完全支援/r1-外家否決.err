 11090	def _teardown_global_claude(src_repo: Path):
 11091	    """_sync_global_claude 的移除半邊(teardown 用):清全域 ~/.claude 的我方 hook + 剪其懸空註冊。
 11092	    ①先驗 settings.json 可解析→壞則跳過+warn、★不刪 .py★(不製造懸空,std F6)②rm 我方現役+撤除 hook
 11093	    ③跑 merge --prune-only(★只剪懸空、不 re-add★——預設 merge 會把 hook 加回,抵銷 teardown)。
 11094	    須在 deinit 刪掉 vendored merge-claude-settings.py 之前跑(std F5,由 cmd_teardown 順序保證)。
 11095	    設計:Projects/teardown一鍵拆機_計劃。回 True=已處理 / False=因 settings 壞跳過。"""
 11096	    import subprocess, json
 11097	    chome = Path.home() / ".claude"
 11098	    chooks, settings = chome / "hooks", chome / "settings.json"
 11099	    if settings.exists():                     # ① 先驗可解析(壞 → 不半做)
 11100	        try:
 11101	            json.loads(settings.read_text(encoding="utf-8"))
 11102	        except Exception as e:
 11103	            print(f"  ⚠ ~/.claude/settings.json 無法解析({e}),跳過全域 hook 清理"
 11104	                  "(避免刪了檔卻剪不掉註冊、留懸空)", file=sys.stderr)
 11105	            return False
 11106	    removed = []                              # ② rm 我方 hook 真檔
 11107	    for f in _GLOBAL_CLAUDE_HOOKS + _RETIRED_CLAUDE_HOOKS + _RETIRED_STUB_CLAUDE_HOOKS:
 11108	        p = chooks / f            # ★含相容期空殼★:拆機後機器上不該留我方任何檔
 11109	        if p.exists() or p.is_symlink():
 11110	            p.unlink(); removed.append(f)
 11111	    merge = src_repo / "scripts" / "merge-claude-settings.py"   # ③ prune-only 剪懸空我方註冊
 11112	    if merge.exists() and settings.exists():
 11113	        subprocess.run([sys.executable, str(merge), "--prune-only"])
 11114	    print(f"  ✓ 全域 hook 清理:移除 {len(removed)} 檔 + 剪懸空我方註冊" if removed
 11115	          else "  ✓ 全域 hook:無我方殘留")
 11116	    return True
