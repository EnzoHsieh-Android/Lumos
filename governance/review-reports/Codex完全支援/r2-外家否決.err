  5828	    else:
  5829	        tier = next((r.get("tier") for r in rounds if r.get("tier")), None)
  5830	    _quiet(f"[roster] {loop_id}:類型 {kind}(從名稱前綴推的),分級 {tier or '沒指定'}")
  5831	    if tier is None:
