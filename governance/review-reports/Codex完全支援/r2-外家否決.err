 16492	# ---------------------------------------------------------------------------
 16493	# dispatch-lens(Projects/派工鏡頭注入_計劃,2026-09-03):代碼審派工詞的固定席鏡頭
 16494	# hook 是薄殼(scripts/hooks/claude/dispatch-lens-hook.py),所有 git/合約/圖譜判斷都在這裡,
 16495	# 沿用既有 helper(_git_commit_exists / INVARIANT_RE 家族 / _vault_in 的排序規則)。
 16496	# 消毒原則(r2/r3 載荷席):來自圖譜或 diff 的自由文字零輸出——只印固定字彙、base 已追蹤路徑、
 16497	# base 版合約行(KEY: 行)。清單本身仍用工作樹圖譜算(d3:能藏不能說)。
 16498	# rc:0=成功(含 0 篇,text 空)/2=輸入或 git 壞/3=vault 缺/4=base 不在主線
 16499	# ---------------------------------------------------------------------------
 16500	_LENS_HEADER = "lumos 自動附加:本次改動的固定席節點(來源 impact --diff,只供參考)"
 16501	_LENS_SHA_RE = re.compile(r"^[0-9a-f]{40}$|^[0-9a-f]{64}$")
 16502	_LENS_KIND = {"direct": "直接相依", "indirect": "間接相依", "incident": "事故"}
 16503	
 16504	
 16505	def _lens_range_ok(diff_range):
 16506	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 16507	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 16508	        return None
 16509	    parts = diff_range.split("..")
 16510	    if len(parts) != 2 or not parts[0] or not parts[1]:
 16511	        return None
 16512	    if any(ch.isspace() for ch in diff_range):
 16513	        return None
 16514	    return parts[0], parts[1]
 16515	
 16516	
 16517	def _lens_git(repo_root, *args, quote=False):
 16518	    import subprocess as _sp
 16519	    cmd = ["git", "-C", str(repo_root)]
 16520	    if quote:
 16521	        cmd += ["-c", "core.quotePath=false"]
 16522	    try:
 16523	        return _sp.run(cmd + list(args), capture_output=True, text=True, timeout=20)
 16524	    except (OSError, _sp.TimeoutExpired):
 16525	        return None
 16526	
 16527	
 16528	def _lens_full_sha(repo_root, rev):
 16529	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 16530	    if r is None or r.returncode != 0:
 16531	        return None
 16532	    sha = r.stdout.strip()
 16533	    return sha if _LENS_SHA_RE.match(sha) else None
 16534	
 16535	
 16536	def _mainline_ref(repo_root):
 16537	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 16538	    回 (ref 名, sha) 或 None。"""
 16539	    for cand in ("main@{upstream}", "master@{upstream}", "main", "master"):
 16540	        sha = _lens_full_sha(repo_root, cand)
 16541	        if sha:
 16542	            return cand, sha
 16543	    return None
 16544	
 16545	
 16546	def _lens_cache_path(repo_root, base_sha, head_sha):
 16547	    import hashlib
 16548	    key = hashlib.sha256(f"{repo_root}|{base_sha}|{head_sha}|schema{_LENS_SCHEMA}".encode("utf-8")).hexdigest()   # 帶 schema 版本:v1.1 舊快取自然 miss(v1.2 r2 外家)
 16549	    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / f"{key}.json"
