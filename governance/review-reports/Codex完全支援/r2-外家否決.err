  5833	        return anomalies
  5834	    entry = _TIER_ROSTER.get((kind, tier))
  5835	    if entry is None:
  5836	        _quiet(f"[roster] 無編制宣告:{kind}/{tier} 這個組合沒定義該派誰,跳過對帳")
  5837	        return anomalies
  5838	    root = Path(repo).resolve() if repo else _vault_repo_root(env)
