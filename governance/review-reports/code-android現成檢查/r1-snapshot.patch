             "https://github.com/detekt/detekt/releases/download/v${DETEKT_VERSION}/detekt-cli-${DETEKT_VERSION}.zip"
           echo "${DETEKT_SHA256}  $d/detekt-cli.zip" | sha256sum -c -
           unzip -q "$d/detekt-cli.zip" -d "$d"
           ln -s "$d/detekt-cli-${DETEKT_VERSION}/bin/detekt-cli" "$d/bin/detekt"
           echo "$d/bin" >> "$GITHUB_PATH"
           "$d/bin/detekt" --version
+      # compose-rules 的 detekt 外掛(0.4.28 對 detekt 1.23.8;Projects/Android現成檢查接上CI與推送前_計劃 範圍 2、S3):照上一步同一個做法,
+      # 下載 → 比對寫死的 sha256(2026-11-06 本機算的,官方沒公布)→ 路徑放進 LUMOS_DETEKT_COMPOSE_JAR;測試在 CI 上找不到這支會判紅。
+      - name: 裝釘版本的 compose-rules detekt 外掛
+        env:
+          COMPOSE_RULES_VERSION: "0.4.28"
+          COMPOSE_RULES_SHA256: "b8c732880e9d26fac90f44733ecd9dab099e2abb1f597b76ceab29e676d4ddd6"
+        run: |
+          set -eu
+          j="$RUNNER_TEMP/detekt/detekt-compose-${COMPOSE_RULES_VERSION}-all.jar"
+          curl -sSfL --retry 3 -o "$j" \
+            "https://github.com/mrmans0n/compose-rules/releases/download/v${COMPOSE_RULES_VERSION}/detekt-compose-${COMPOSE_RULES_VERSION}-all.jar"
+          echo "${COMPOSE_RULES_SHA256}  $j" | sha256sum -c -
+          echo "LUMOS_DETEKT_COMPOSE_JAR=$j" >> "$GITHUB_ENV"
       - name: 全套的這幾份(${{ matrix.shards }} / 共 ${{ env.SHARD_TOTAL }} 份)
         env:
           MY_SHARDS: ${{ matrix.shards }}
         run: |
           set -u
           rc=0
           for i in $MY_SHARDS; do
             # 每份印開始時間與「第 i 份耗時 N 秒」:看分片平不平均用;撤除條件量的是每台(兩份)的耗時,看這個工作的總時間(推送與CI提速 RETIRE-IF)
             # 子殼層裡先 set +e:預設 bash -e 會在測試紅時直接結束子殼層,紅的那份就印不出耗時(代碼審 r1 通才、合約圖譜席)
             ( set +e; s=$(date +%s); echo "第 $i 份開始 $(date -u +%H:%M:%S)"; python scripts/test_lumos.py --shard "$i/$SHARD_TOTAL"; rc=$?; echo "第 $i 份耗時 $(( $(date +%s) - s )) 秒"; exit $rc ) > "/tmp/shard-$i.log" 2>&1 &
diff --git a/configs/detekt/android.yml b/configs/detekt/android.yml
index 3f30b09ac..04483575b 100644
--- a/configs/detekt/android.yml
+++ b/configs/detekt/android.yml
@@ -1,26 +1,29 @@
 # detekt 共用差分設定——Android 專案標準（lumos-toolchain 分發，各專案 .lumos/lint.json 引用）
 #
 # 用法（兩段接法，見 docs/lumos-toolchain-knowledge/Systems/linter精選目錄.md 的 detekt 標準接法）:
 #   推送前(.lumos/lint.json 樣板):
 #   detekt --input {LINT_FILES_CSV} --build-upon-default-config --config $HOME/harness/lumos-toolchain/configs/detekt/android.yml --report sarif:{LINT_SARIF_OUT}
 #   CI(專案自己貼):detekt Gradle 外掛指這份設定,先 ./gradlew detektBaseline<變體> 產基準線並提交,CI 跑 ./gradlew detekt<變體>
+#   Compose 專案另加一條只跑 compose-rules 外掛的宣告,設定指同目錄的 compose.yml(寫法見 linter 目錄)
 #
 # ★講實話(2026-11-06,detekt 1.23.8 實測;lumos lint-check 與健檢會照指令字面印出同樣的提醒)★:
 #   ①下面標「要型別資訊」的規則,推送前那條命令不帶型別參數,所以推送前不跑、也不報錯;
 #     照 detekt 官方建議放在 CI 的 Gradle 型別解析任務(detekt<變體>)加基準線擋(上面的 CI 那行)。沒接 CI 時健檢印 T4。
 #   ②推送前用 {LINT_FILES_CSV}(這次改到的 kt 檔用逗號串成一個值,detekt 只收逗號分隔),新增告警閘會真的跑、只擋新增的,
 #     擋得到的是不用型別資訊的規則(GlobalScope 裸用、複雜度、命名這類)。用空白串的 {LINT_FILES} 多檔時 detekt 會拒跑。
 #   ③自有設定要跟這份疊加時,用逗號合成一個 --config a.yml,b.yml(分開寫兩次 --config 會拒跑);
 #     清單類欄位(例 ForbiddenMethodCall 的 methods)後面那份整份蓋掉前面那份,不合併、不警告。
 #
-# 定位:只收「detekt 預設關、但效能檢核目錄/kotlin-idioms 點名要開」的差分。
+# 定位:收兩種差分——①「detekt 預設關、但效能檢核目錄/kotlin-idioms 點名要開」的規則;②detekt 官方 Compose 頁
+#   (https://detekt.dev/docs/introduction/compose/ )建議的六項放寬,不然標準 Compose 寫法會被內建規則誤報
+#   (2026-11-06 實跑:一支標準 Compose 檔報 6 條;Projects/Android現成檢查接上CI與推送前_計劃)。
 # 格式規則歸 ktlint/ktfmt（linter精選目錄分工），不在此開。
 # 規則名與規則集要是 detekt 1.23.8 真的有的(寫錯整次拒跑);t_detekt_shared_config_valid 會擋。
 
 coroutines:
   # 效能三問②:GlobalScope 裸用（scope 不跟生命週期=洩漏）。不要型別資訊
   GlobalCoroutineUsage:
     active: true
   # 效能三問③:runCatching 裡呼叫 suspend 函式=取消訊號被吞。要型別資訊:只給 --input 的命令列跑法下零命中、也不出錯。
   #   1.23.8 只抓 runCatching 包 suspend 呼叫,try/catch(Exception) 那種寫法帶齊型別資訊也不報(2026-11-01 實測,見 kotlin-idioms R10);
   #   Kotlin 標準庫 2.2 以上時補了型別資訊也不響(2026-11-04 逐版實測)。
@@ -29,16 +32,39 @@ coroutines:
   # suspend 函式又掛在 CoroutineScope 上(兩種語意混用)。要型別資訊
   SuspendFunWithCoroutineScopeReceiver:
     active: true
 
 performance:
   # 效能三問⑤前半:長鏈 map/filter 該 asSequence（threshold 3 步起報）。要型別資訊:只給 --input 的命令列跑法下不報(2026-11-01 實測 1.23.8)
   CouldBeSequence:
     active: true
 
 style:
+  # Compose:屬性宣告裡的顏色、尺寸常數(例 Color(0xFFEA6D7E))是刻意的,不算魔術數字(detekt 官方 Compose 頁)
+  MagicNumber:
+    ignorePropertyDeclaration: true
+  # Compose:@Preview 函式沒人直接呼叫,不算沒用到;多重預覽註解(例 @PreviewLightDark)要各自列上,ignoreAnnotated 不看元註解
+  #   (detekt 官方 Compose 頁;compose-rules 規則頁也要求 ['Preview']。detekt 2.x 這條改名 UnusedPrivateFunction)
+  UnusedPrivateMember:
+    ignoreAnnotated: ['Preview']
   # 畫面收集要用 collectAsStateWithLifecycle(collectAsState 在 App 退到背景時照樣收)。要型別資訊;方法要寫全名
   ForbiddenMethodCall:
     active: true
     methods:
       - reason: 'collectAsState 在 App 退到背景時照樣收集,改用 collectAsStateWithLifecycle'
         value: 'androidx.compose.runtime.collectAsState'
+
+naming:
+  # Compose:回傳 Unit 的 @Composable 用大寫開頭命名(Compose 慣例);命名改由 compose-rules 的 ComposableNaming 檢查
+  FunctionNaming:
+    ignoreAnnotated: ['Composable']
+  # Compose:頂層常數用 PascalCase(Compose 指引)
+  TopLevelPropertyNaming:
+    constantPattern: '[A-Z][A-Za-z0-9]*'
+
+complexity:
+  # Compose:元件參數多半有預設值,不算進參數上限
+  LongParameterList:
+    ignoreDefaultParameters: true
+  # Compose:@Preview 函式不增加複雜度,不算進函式數
+  TooManyFunctions:
+    ignoreAnnotatedFunctions: ['Preview']
diff --git a/configs/detekt/compose.yml b/configs/detekt/compose.yml
new file mode 100644
index 000000000..928d23825
--- /dev/null
+++ b/configs/detekt/compose.yml
@@ -0,0 +1,20 @@
+# compose-rules(mrmans0n)detekt 外掛那條宣告用的設定——lumos-toolchain 分發,各 Android 專案 .lumos/lint.json 引用
+#
+# 用法(linter 目錄 docs/lumos-toolchain-knowledge/Systems/linter精選目錄.md 的 detekt 標準接法第二條):
+#   detekt --input {LINT_FILES_CSV} --disable-default-rulesets --plugins $HOME/.local/share/lumos/detekt-plugins/detekt-compose-0.4.28-all.jar
+#          --build-upon-default-config --config $HOME/harness/lumos-toolchain/configs/detekt/compose.yml --report sarif:{LINT_SARIF_OUT}
+#   ★--build-upon-default-config 不能少★:少了它外掛規則一條都不跑、也不報錯(2026-11-06 detekt 1.23.8 加外掛 0.4.28 實測)。
+#   --disable-default-rulesets 讓這條只跑外掛規則;detekt 內建規則照原本那條宣告跑,外掛檔不在時只有這條被判環境不可用。
+#
+# 這份只寫外掛預設關的三條要不要開:照外掛預設不開——外掛作者把它們標成選用
+# (UnstableCollections 在 Compose 預設開啟 strong skipping 之後多半是雜訊,Slack 官方規則頁同樣把它預設關;PreviewNaming 是命名偏好;Material2 只給還在用 M2 的專案)。
+# 其餘外掛規則照外掛自帶的預設(https://mrmans0n.github.io/compose-rules/detekt/ )。
+# Projects/Android現成檢查接上CI與推送前_計劃
+
+Compose:
+  UnstableCollections:
+    active: false
+  PreviewNaming:
+    active: false
+  Material2:
+    active: false
