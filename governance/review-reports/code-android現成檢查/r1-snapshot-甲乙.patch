+# 型錄第四批通電批次的判定口徑([[Projects/Android現成檢查接上CI與推送前_計劃]] 範圍 4;口徑原文寫在型錄〈輸入與口徑〉)。
+# 預設關的規則照官方規則頁列舉:Slack compose-lints 的兩條穩定性檢查與 M2 API(https://slackhq.github.io/compose-lints/rules/ ;
+# ComposeRememberMissing 已移除),compose-rules 外掛自帶設定 active: false 的三條。
+_KT_B4_DEFAULT_OFF = frozenset((
+    "ComposeUnstableReceiver", "ComposeUnstableCollections", "ComposeM2Api", "ComposeRememberMissing",
+    "unstable-collections", "UnstableCollections", "preview-naming", "PreviewNaming", "material-two", "Material2"))
+_KT_B4_LINT = r"(?:androidx(?:\.[\w.]+)?|內建|slack):\s*([A-Z][A-Za-z0-9]+)"
+_KT_B4_CR = r"cr:compose:([\w-]+)"
+_KT_B4_SKIP = ("待查", "預設關", "相近", "opt-in")
+_KT_B4_TAG_LINT = "CI 範本:Android Lint"
+_KT_B4_TAG_CR = "推送前:detekt 外掛 compose-rules"
+
+
+def _kt_b4_expected_tags(rule_col):
+    """一列現成規則欄 → 該有的第四批接電標籤(清單,依 Android Lint、compose-rules 順序)。"""
+    import re as _re
+    lint = cr = False
+    for seg in _re.split(r"[;；、]", rule_col):
+        if any(w in seg for w in _KT_B4_SKIP):
+            continue
+        for code in _re.findall(_KT_B4_LINT, seg):
+            if code not in _KT_B4_DEFAULT_OFF:
+                lint = True
+        for code in _re.findall(_KT_B4_CR, seg):
+            if code not in _KT_B4_DEFAULT_OFF:
+                cr = True
+    return [t for t, on in ((_KT_B4_TAG_LINT, lint), (_KT_B4_TAG_CR, cr)) if on]
+
+
+def t_kt_catalog_batch4_wiring():
+    """[[Projects/Android現成檢查接上CI與推送前_計劃]] S4:照範圍 4 的口徑重算型錄每一列,通電批次寫的第四批標籤要一字不差;
+    預設關、opt-in、待查的規則不准被標成已接電。"""
+    import re as _re
+    check("★前置★ slack 規則碼 → Android Lint 標籤", _kt_b4_expected_tags("slack:ComposeItemKeyHashCode") == [_KT_B4_TAG_LINT])
+    check("★前置★ 內建規則碼 → Android Lint 標籤", _kt_b4_expected_tags("內建:TrustAllX509TrustManager") == [_KT_B4_TAG_LINT])
+    check("★前置★ androidx.套件:規則碼 → Android Lint 標籤",
+          _kt_b4_expected_tags("androidx.lifecycle:NullSafeMutableLiveData") == [_KT_B4_TAG_LINT])
+    check("★前置★ opt-in 的 compose-rules → 不標",
+          _kt_b4_expected_tags("cr:compose:unstable-collections / UnstableCollections(opt-in)") == [])
+    check("★前置★ Slack 預設關的穩定性檢查 → 不標", _kt_b4_expected_tags("slack:ComposeUnstableCollections") == [])
+    check("★前置★ 預設關 → 不標", _kt_b4_expected_tags("內建:WrongThreadInterprocedural(預設關)") == [])
+    check("★前置★ 待查 → 不標", _kt_b4_expected_tags("androidx UnnecessaryLambdaCreation 待查") == [])
+    check("★前置★ 兩家都有 → 兩個標籤",
+          _kt_b4_expected_tags("cr:compose:mutable-params-check / MutableParams;slack:ComposeMutableParameters")
+          == [_KT_B4_TAG_LINT, _KT_B4_TAG_CR])
+    cat = Path(__file__).resolve().parent.parent / "skills" / "kotlin-idioms" / "checks-catalog.md"
+    text = cat.read_text(encoding="utf-8")
+    main_part = text.split("## 情境決策表")[0]
+    rows = [ln.split("|") for ln in main_part.splitlines()
+            if _re.match(r"\| (API|FLOW|STATE|CO|UI|ARCH|DATA|TEST|PERF)-\d+ ", ln)]
+    check("★前置★ 讀到型錄主表的列", len(rows) > 400, str(len(rows)))
+    bad, n_tag = [], 0
+    for r in rows:
+        rid, rule_col, batch = r[1].strip(), r[6], r[10]
+        want = _kt_b4_expected_tags(rule_col)
+        have = [t for t in (_KT_B4_TAG_LINT, _KT_B4_TAG_CR) if t in batch]
+        if "批四" not in batch and not have:
+            continue          # 不是第四批的列(批一等)不在這次口徑裡
+        if want:
+            n_tag += 1
+            exp = "批四(" + ";".join(want) + ")"
+            if exp not in batch or "批四(現成規則)" in batch:
+                bad.append(f"{rid}:要 {exp},寫的是 {batch.strip()[:60]}")
+        elif have:
+            bad.append(f"{rid}:口徑判成不該標,卻寫了 {have}")
+    check("S4 每一列的第四批標籤跟口徑重算一致", bad == [], "\n".join(bad[:15]))
+    check("S4 有列被標成接電(口徑不是空轉)", n_tag > 50, str(n_tag))
+    check("S4 型錄〈輸入與口徑〉寫了這兩個標籤", _KT_B4_TAG_LINT in text.split("## 來源縮寫")[0]
+          and _KT_B4_TAG_CR in text.split("## 來源縮寫")[0], "")
+    print("  ✓ t_kt_catalog_batch4_wiring")
