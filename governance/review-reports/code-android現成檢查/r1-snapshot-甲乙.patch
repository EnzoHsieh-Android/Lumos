+        return []
+    try:
+        words = _shlex.split(cmd)
+    except ValueError:
+        return []
+    out = []
+    for i, w in enumerate(words):
+        val = None
+        if w in ("--plugins", "-p") and i + 1 < len(words):
+            val = words[i + 1]
+        elif w.startswith("--plugins="):
+            val = w.split("=", 1)[1]
+        if val:
+            for part in val.split(","):
+                part = part.strip()
