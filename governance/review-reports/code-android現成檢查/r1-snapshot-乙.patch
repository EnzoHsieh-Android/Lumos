+def _sarif_rule_lines(path):
+    import json as _j
+    try:
+        d = _j.loads(Path(path).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    out = []
+    for run_ in d.get("runs", []):
+        for r in run_.get("results", []):
+            loc = (r.get("locations") or [{}])[0].get("physicalLocation", {}).get("region", {})
+            out.append((r.get("ruleId", ""), loc.get("startLine")))
+    return out
