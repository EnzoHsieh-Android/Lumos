+        rid, rule_col, batch = r[1].strip(), r[6], r[10]
+        want = _kt_b4_expected_tags(rule_col)
+        have = [t for t in (_KT_B4_TAG_LINT, _KT_B4_TAG_CR) if t in batch]
+        if "批四" not in batch and not have:
+            continue          # 不是第四批的列(批一等)不在這次口徑裡
+        if want:
+            n_tag += 1
+            exp = "批四(" + ";".join(want) + ")"
+            if exp not in batch or "批四(現成規則)" in batch:
+                bad.append(f"{rid}:要 {exp},寫的是 {batch.strip()[:60]}")
+        elif have:
+            bad.append(f"{rid}:口徑判成不該標,卻寫了 {have}")
+    check("S4 每一列的第四批標籤跟口徑重算一致", bad == [], "\n".join(bad[:15]))
+    check("S4 有列被標成接電(口徑不是空轉)", n_tag > 50, str(n_tag))
+    check("S4 型錄〈輸入與口徑〉寫了這兩個標籤", _KT_B4_TAG_LINT in text.split("## 來源縮寫")[0]
+          and _KT_B4_TAG_CR in text.split("## 來源縮寫")[0], "")
+    print("  ✓ t_kt_catalog_batch4_wiring")
