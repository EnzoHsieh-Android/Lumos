+def _local_ledger_doctor_msgs(docs_dir, mb_cap):
+    """doctor 對兩本本機帳的軟提醒行:超過大小上限;已被版控追蹤;或在 git 工作目錄裡存在、沒被追蹤、也沒被忽略
+    (`git check-ignore -q` 回 1)。check-ignore 回其他值(不在 git 裡、出錯)就不提醒。"""
+    import subprocess as _sp
+    msgs = []
+    for name in _LOCAL_LOG_IGNORE_LINES:
+        p = _docs_ledger_path(docs_dir, name)
+        if not p.is_file():
+            continue
+        mb = p.stat().st_size / 1048576.0
+        if mb > mb_cap:
+            msgs.append(f"{name} {mb:.1f} MB,超過 {mb_cap} MB")
+        try:
+            tracked = _sp.run(["git", "-C", str(docs_dir), "ls-files", "--error-unmatch", name],
+                              capture_output=True, timeout=10).returncode == 0
+            ign = _sp.run(["git", "-C", str(docs_dir), "check-ignore", "-q", name],
+                          capture_output=True, timeout=10).returncode
+        except (OSError, _sp.SubprocessError):
+            continue
+        if tracked:     # 忽略規則對已追蹤的檔無效,每次例行寫入都弄髒工作目錄(代碼審 r1 邊界、整合席)
+            msgs.append(f"{name} 已被版控追蹤,忽略規則對它無效;git rm --cached 它(檔案留在本機)")
+        elif ign == 1:
+            msgs.append(f"{name} 沒被 .gitignore 忽略,會以未追蹤檔出現")
+    return msgs
