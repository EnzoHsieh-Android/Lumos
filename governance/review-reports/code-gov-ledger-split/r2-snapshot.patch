+def _docs_ledger_path(docs_dir, name):
+    """docs 層帳檔(版控帳與本機帳都放這一層)的路徑。"""
+    return Path(docs_dir) / name
+
+
+def _gov_ts(ts):
+    """治理帳的 ts 欄 → 帶時區的時間;沒帶時區當本機時間;不是字串、不是 ISO、轉時區出界回 None。
+    度量段與兩本合讀共用(代碼審 code-gov-ledger-split r1 架構對齊席:原本兩處各寫一份、接的例外還不一樣)。"""
+    import datetime as _dt
+    if not isinstance(ts, str):
+        return None
+    try:
+        t = _dt.datetime.fromisoformat(ts)
+        return t.astimezone() if t.tzinfo is None else t
+    except (ValueError, OverflowError, OSError):
+        return None
+
+
+def _gov_ledger_rows_by_time(docs_dir):
+    """版控帳與本機帳的物件行,依時間排序(統計類讀者用;判定類讀者只讀版控帳,不走這支)。
+    讀法同 doctor 其他讀治理帳的段落:各讀檔尾(_gov_tail_bytes)、只在 \\n 切行(_drift_jsonl_iter,壞行只跳那一行)。
+    排序鍵:_gov_ts;解析不了的排最前;時間相同保留讀入順序(版控帳在前)。"""
+    rows = []
+    for name in (".governance-log.jsonl", GOV_LOCAL_LOG_NAME):
+        p = _docs_ledger_path(docs_dir, name)
+        try:
+            raw, _start = _gov_tail_bytes(p)
+        except OSError:
+            continue
+        rows.extend(_drift_jsonl_iter(raw))
+
+    def key(d):
+        t = _gov_ts(d.get("ts"))
+        try:
+            return (1, t.timestamp()) if t is not None else (0, 0.0)
+        except (OverflowError, OSError, ValueError):
+            return (0, 0.0)
+    return sorted(rows, key=key)
+
