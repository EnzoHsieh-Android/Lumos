+          v["n_pool"] >= max(v["n_any"], v["n_term"], v["n_cooccur"]),
+          _json.dumps(v, ensure_ascii=False))
+    check("池不大於三個來源相加(聯集的上界;超過代表有重複沒去掉)",
+          v["n_pool"] <= v["n_any"] + v["n_term"] + v["n_cooccur"],
+          _json.dumps(v, ensure_ascii=False))
+    print("  ✓ t_mw_pool_three_sources_all_contribute")
