+def pq_parse(fm_lines, line0=2):
+    """開頭欄位 pending_questions 的嚴格讀法(Projects/待決問題改存開頭欄位_計劃):只要有一處讀不懂,整份當無法判定。
+    回 (有沒有這個欄位, 題目清單 [{鍵: 值, _line}], [(檔案行號, 原因)]);錯誤非空時題目清單不可用。
+    line0 = fm_lines[0] 在檔案裡是第幾行(開頭的 --- 是第 1 行)。"""
+    present, raw_items, errs = _pq_scan(fm_lines or [], "pending_questions", line0)
+    qs, seen = [], {}
+    for it in raw_items:
+        q, ln = {"_line": it["_line"]}, it["_line"]
+        qid = it["id"][0]
+        if not _PQ_ID_RE.fullmatch(qid):
+            errs.append((ln, f"題號 {qid!r} 格式不對;寫成 Q 加不帶前導零的正整數(Q1、Q12)"))
+        elif qid in seen:
+            errs.append((ln, f"題號 {qid} 重複(第 {seen[qid]} 行也有)"))
+        seen.setdefault(qid, ln)
+        q["id"] = qid
+        for k, vn in it.items():
+            if k in ("_line", "id"):
+                continue
+            v, no = vn
+            if k not in _PQ_KEYS:
+                errs.append((no, f"{qid} 有不認得的鍵 {k};只收 {'、'.join(_PQ_KEYS)}"))
+                continue
+            if k in _PQ_BOOL_KEYS:
+                if v not in ("true", "false"):
+                    errs.append((no, f"{qid} 的 {k} 只收不加引號的 true 或 false,寫的是 {v!r}"))
+                q[k] = v == "true"
+                continue
+            val, why = _strict_scalar(v)
+            if why:
+                errs.append((no, f"{qid} 的 {k}:{why}"))
+                continue
+            q[k] = val
+        for k in _PQ_REQUIRED:
+            if k not in it:
+                errs.append((ln, f"{qid} 缺必有的鍵 {k}"))
+        if q.get("stage") is not None and q["stage"] not in PQ_STAGES:
+            errs.append((ln, f"{qid} 的 stage 要是 {'/'.join(PQ_STAGES)} 之一,寫的是 {q['stage']!r}"))
+        if q.get("status") is not None and q["status"] not in PQ_STATUSES:
+            errs.append((ln, f"{qid} 的 status 要是 {'/'.join(PQ_STATUSES)} 之一,寫的是 {q['status']!r}"))
+        if "tests" in q:
+            ts = [t.strip() for t in q["tests"].split(",")]
+            if any(not t for t in ts) or len(set(ts)) != len(ts):
+                errs.append((ln, f"{qid} 的 tests 有空的一段或重複的名字(半形逗號分隔,測試名不能含逗號)"))
+            q["tests"] = [t for t in ts if t]
+        q.setdefault("blocking", False)
+        q.setdefault("irreversible", False)
+        qs.append(q)
