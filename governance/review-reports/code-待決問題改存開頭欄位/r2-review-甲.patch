+def _pq_decision_state(env, rel, ref, self_fm=None, cache=None):
+    """決策連結 → ok / missing / superseded / bad。格式沿用決策紀錄的全域編號 <節點>#dN(解析 _dref_parse);本篇可簡寫 #dN。
+    self_fm:寫入指令在鎖內組好的開頭欄位——給了它,本篇用它、別篇從磁碟重讀(不信鎖外載入的舊內容,代碼審 r1 併發席)。
+    帶路徑的寫法要整條對得上;只寫短名而同名不只一篇,當格式不合(env.resolve 會退回比短名、撞名取第一篇,代碼審 r1 邊界席)。
+    cache:同一次判定裡每篇的決策只解析一次(代碼審 r1:原本每題重解析,題數乘決策數)。"""
+    ref = str(ref).strip()
+    if "[[" in ref or "]]" in ref:
+        return "bad"
+    if re.fullmatch(r"#d\d+", ref):
+        node, did = rel, ref[1:]
+    else:
+        pr = _dref_parse(ref)
+        if not pr or not pr[0]:
+            return "bad"
+        lit = pr[0][:-3] if pr[0].lower().endswith(".md") else pr[0]
+        if "/" in lit:
+            node = lit + ".md" if (lit + ".md") in env.notes else None
+        else:
+            hits = [r for r in env.notes if Path(r).stem == lit]
+            if len(hits) > 1:
+                return "bad"
+            node = hits[0] if hits else None
+        did = pr[1]
+        if not node:
+            return "missing"
+    cache = {} if cache is None else cache
+    if node not in cache:
+        if node == rel and self_fm is not None:
+            cache[node] = parse_decisions(self_fm)
+        elif self_fm is not None:
+            try:
+                fm, _b = split_frontmatter((env.vault / node).read_text(encoding="utf-8-sig"))
+            except (OSError, UnicodeDecodeError):
+                fm = None
+            cache[node] = parse_decisions(fm) if fm is not None else None
+        else:
+            cache[node] = _node_decisions(env, node) if node in env.notes else None
+    ds = cache[node]
+    if ds is None:
+        return "missing"
+    for d in ds:
+        if str(d.get("id", "")).strip() == did:
+            return "superseded" if str(d.get("valid", "true")).strip().lower() == "false" else "ok"
+    return "missing"
