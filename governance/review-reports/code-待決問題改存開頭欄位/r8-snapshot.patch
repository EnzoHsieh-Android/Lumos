+     "T=src/test/kotlin/com/example/order\ncat > $T/IntegrationTestBase.kt <<'EOF'\npackage com.example.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.jdbc.core.JdbcTemplate\nimport org.springframework.test.context.DynamicPropertyRegistry\nimport org.springframework.test.context.DynamicPropertySource\nimport org.testcontainers.containers.PostgreSQLContainer\n\n/** 所有整合測試共用一個真的 PostgreSQL(容器只起一次);庫存與鎖的行為不能用假資料庫驗。 */\n@SpringBootTest(properties = [\"order.worker.enabled=false\", \"order.worker.batch-size=10\"])\nabstract class IntegrationTestBase {\n\n    @Autowired\n    protected lateinit var jdbc: JdbcTemplate\n\n    @Autowired\n    protected lateinit var repo: OrderRepository\n\n    @BeforeEach\n    fun cleanDatabase() {\n        jdbc.execute(\"TRUNCATE outbox, order_items, orders, products RESTART IDENTITY CASCADE\")\n    }\n\n    protected fun stockOf(productId: Long): Int =\n        jdbc.queryForObject(\"SELECT stock FROM products WHERE id = ?\", Int::class.java, productId)!!\n\n    protected fun count(table: String): Int =\n        jdbc.queryForObject(\"SELECT count(*) FROM $table\", Int::class.java)!!\n\n    companion object {\n        private val postgres = PostgreSQLContainer(\"postgres:16-alpine\").apply { start() }\n\n        @JvmStatic\n        @DynamicPropertySource\n        fun datasource(registry: DynamicPropertyRegistry) {\n            registry.add(\"spring.datasource.url\", postgres::getJdbcUrl)\n            registry.add(\"spring.datasource.username\", postgres::getUsername)\n            registry.add(\"spring.datasource.password\", postgres::getPassword)\n        }\n    }\n}\nEOF\ncat > $T/OrderConcurrencyTest.kt <<'EOF'\npackage com.example.order\n\nimport org.junit.jupiter.api.Assertions.assertEquals\nimport org.junit.jupiter.api.Assertions.assertThrows\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport java.util.concurrent.Callable\nimport java.util.concurrent.CountDownLatch\nimport java.util.concurrent.Executors\nimport java.util.concurrent.atomic.AtomicInteger\n\nclass OrderConcurrencyTest : IntegrationTestBase() {\n\n    @Autowired\n    private lateinit var service: OrderService\n\n    /** 同時放出 [n] 個任務,回傳每個任務的結果(例外也當結果)。 */\n    private fun <T> race(n: Int, task: (Int) -> T): List<Result<T>> {\n        val pool = Executors.newFixedThreadPool(n)\n        val ready = CountDownLatch(n)\n        val go = CountDownLatch(1)\n        try {\n            val futures = (0 until n).map { i ->\n                pool.submit(Callable {\n                    ready.countDown()\n                    go.await()\n                    runCatching { task(i) }\n                })\n            }\n            ready.await()\n            go.countDown()\n            return futures.map { it.get() }\n        } finally {\n            pool.shutdownNow()\n        }\n    }\n\n    @Test\n    fun `concurrent orders never oversell`() {\n        val stock = 10\n        val buyers = 50\n        val product = repo.insertProduct(\"熱門商品\", 100, stock)\n\n        val results = race(buyers) { i -> service.placeOrder(\"user-$i\", \"key-$i\", listOf(OrderLine(product, 1))) }\n\n        val succeeded = results.count { it.isSuccess }\n        val soldOut = results.count { it.exceptionOrNull() is InsufficientStockException }\n        // 預期值直接來自「庫存 10、50 人各買 1 件」:恰好 10 人買到、其餘 40 人被拒、沒有別種錯誤\n        assertEquals(10, succeeded)\n        assertEquals(40, soldOut)\n        assertEquals(0, stockOf(product))\n        assertEquals(10, count(\"orders\"))\n        assertEquals(10, count(\"outbox\"))\n        assertEquals(10, jdbc.queryForObject(\"SELECT sum(quantity) FROM order_items\", Int::class.java))\n    }\n\n    @Test\n    fun `insufficient stock rolls back whole order`() {\n        // a 的 id 比 b 小,服務會先扣 a、再在 b 失敗;a 的庫存要被還原才算整筆回滾\n        val a = repo.insertProduct(\"a\", 100, 5)\n        val b = repo.insertProduct(\"b\", 200, 1)\n\n        val e = assertThrows(InsufficientStockException::class.java) {\n            service.placeOrder(\"u1\", \"k1\", listOf(OrderLine(a, 2), OrderLine(b, 2)))\n        }\n\n        assertEquals(b, e.productId)\n        assertEquals(5, stockOf(a))\n        assertEquals(1, stockOf(b))\n        assertEquals(0, count(\"orders\"))\n        assertEquals(0, count(\"order_items\"))\n        assertEquals(0, count(\"outbox\"))\n    }\n\n    @Test\n    fun `same idempotency key creates one order`() {\n        val product = repo.insertProduct(\"p\", 100, 10)\n\n        val results = race(20) { service.placeOrder(\"u1\", \"same-key\", listOf(OrderLine(product, 1))) }\n\n        assertEquals(20, results.count { it.isSuccess }) // 重送不是錯誤\n        val placed = results.map { it.getOrThrow() }\n        assertEquals(1, placed.count { it.created })\n        assertEquals(1, placed.map { it.order.id }.toSet().size)\n        assertEquals(9, stockOf(product))\n        assertEquals(1, count(\"orders\"))\n        assertEquals(1, count(\"outbox\"))\n\n        // 事後再重送一次,同樣回原訂單\n        val replay = service.placeOrder(\"u1\", \"same-key\", listOf(OrderLine(product, 1)))\n        assertEquals(false, replay.created)\n        assertEquals(placed.first().order.id, replay.order.id)\n        assertEquals(9, stockOf(product))\n    }\n\n    @Test\n    fun `orders touching same products in opposite order do not deadlock`() {\n        val a = repo.insertProduct(\"a\", 100, 1000)\n        val b = repo.insertProduct(\"b\", 100, 1000)\n        val deadlocks = AtomicInteger()\n\n        val results = race(40) { i ->\n            // 偶數號先列 a 後列 b,奇數號相反;若服務照請求順序扣,兩邊會互相等對方的列\n            val lines = if (i % 2 == 0) listOf(OrderLine(a, 1), OrderLine(b, 1)) else listOf(OrderLine(b, 1), OrderLine(a, 1))\n            service.placeOrder(\"u$i\", \"k$i\", lines)\n        }\n        results.forEach { if (it.exceptionOrNull() != null) deadlocks.incrementAndGet() }\n\n        assertEquals(0, deadlocks.get(), results.firstNotNullOfOrNull { it.exceptionOrNull() }?.toString())\n        assertEquals(960, stockOf(a))\n        assertEquals(960, stockOf(b))\n    }\n}\nEOF\ncat > $T/OutboxWorkerTest.kt <<'EOF'\npackage com.example.order\n\nimport org.junit.jupiter.api.Assertions.assertEquals\nimport org.junit.jupiter.api.Assertions.assertTrue\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.TestConfiguration\nimport org.springframework.context.annotation.Bean\nimport org.springframework.context.annotation.Primary\nimport java.util.UUID\nimport java.util.concurrent.ConcurrentHashMap\nimport java.util.concurrent.CopyOnWriteArrayList\nimport java.util.concurrent.atomic.AtomicInteger\n\n/** 測試用處理器:每個測試自己決定處理時要做什麼。 */\nclass ScriptedProcessor : OrderProcessor {\n    @Volatile\n    var behavior: (UUID) -> Unit = {}\n\n    override fun process(orderId: UUID) = behavior(orderId)\n}\n\n@TestConfiguration\nclass ScriptedProcessorConfig {\n    @Bean\n    @Primary\n    fun scriptedProcessor() = ScriptedProcessor()\n}\n\n@org.springframework.context.annotation.Import(ScriptedProcessorConfig::class)\nclass OutboxWorkerTest : IntegrationTestBase() {\n\n    @Autowired\n    private lateinit var service: OrderService\n\n    @Autowired\n    private lateinit var worker: OutboxWorker\n\n    @Autowired\n    private lateinit var processor: ScriptedProcessor\n\n    private var product = 0L\n\n    @BeforeEach\n    fun seed() {\n        processor.behavior = {}\n        product = repo.insertProduct(\"p\", 100, 1000)\n    }\n\n    private fun place(i: Int): UUID = service.placeOrder(\"u$i\", \"k$i\", listOf(OrderLine(product, 1))).order.id\n\n    private fun orderStatus(id: UUID) =\n        jdbc.queryForObject(\"SELECT status FROM orders WHERE id = ?\", String::class.java, id)\n\n    private fun outboxRow(id: UUID) =\n        jdbc.queryForMap(\"SELECT status, attempts, last_error, next_attempt_at > now() AS waiting FROM outbox WHERE order_id = ?\", id)\n\n    /** 把退避時間拉到現在,讓測試不用真的等。 */\n    private fun makeAllDue() = jdbc.update(\"UPDATE outbox SET next_attempt_at = now() WHERE status = 'PENDING'\")\n\n    @Test\n    fun `pending order becomes processed`() {\n        val id = place(1)\n        assertEquals(\"PENDING\", orderStatus(id))\n        assertEquals(\"PENDING\", outboxRow(id)[\"status\"])\n\n        assertEquals(1, worker.runOnce())\n\n        assertEquals(\"PROCESSED\", orderStatus(id))\n        assertEquals(\"DONE\", outboxRow(id)[\"status\"])\n        assertEquals(0, worker.runOnce(), \"處理完的工作不會再被領到\")\n    }\n\n    @Test\n    fun `failing job is retried then marked failed`() {\n        val id = place(1)\n        val calls = AtomicInteger()\n        processor.behavior = { calls.incrementAndGet(); error(\"下游掛了\") } // maxAttempts 預設 5\n\n        for (attempt in 1..4) {\n            assertEquals(1, worker.runOnce())\n            val row = outboxRow(id)\n            assertEquals(\"PENDING\", row[\"status\"], \"第 $attempt 次失敗後還在重試\")\n            assertEquals(attempt, row[\"attempts\"])\n            assertEquals(true, row[\"waiting\"], \"要等退避時間,不能立刻再被領\")\n            assertEquals(0, worker.runOnce(), \"退避中不會被領到\")\n            makeAllDue()\n        }\n        assertEquals(\"PENDING\", orderStatus(id))\n\n        assertEquals(1, worker.runOnce()) // 第 5 次,到上限\n        assertEquals(\"FAILED\", outboxRow(id)[\"status\"])\n        assertEquals(5, outboxRow(id)[\"attempts\"])\n        assertEquals(\"下游掛了\", outboxRow(id)[\"last_error\"])\n        assertEquals(\"FAILED\", orderStatus(id))\n        assertEquals(5, calls.get())\n\n        makeAllDue()\n        assertEquals(0, worker.runOnce(), \"放棄後不會再被領\")\n        assertEquals(5, calls.get())\n    }\n\n    @Test\n    fun `concurrent workers never process a job twice`() {\n        val ids = (1..100).map { place(it) }\n        val seen = ConcurrentHashMap<UUID, AtomicInteger>()\n        val threadsUsed = CopyOnWriteArrayList<String>()\n        processor.behavior = {\n            seen.computeIfAbsent(it) { AtomicInteger() }.incrementAndGet()\n            threadsUsed += Thread.currentThread().name\n            Thread.sleep(3) // 拉長持鎖時間,讓幾個工作者的批次真的重疊\n        }\n\n        val threads = (1..4).map {\n            Thread { while (worker.runOnce() > 0) Unit }.apply { start() }\n        }\n        threads.forEach { it.join() }\n\n        assertEquals(100, seen.size)\n        assertTrue(seen.values.all { it.get() == 1 }, \"有訂單被處理超過一次: ${seen.filterValues { it.get() != 1 }}\")\n        assertTrue(threadsUsed.toSet().size > 1, \"測試情境沒成立:只有一個工作者在做事\")\n        assertTrue(ids.all { orderStatus(it) == \"PROCESSED\" })\n    }\n}\nEOF\ncat > $T/OrderApiValidationTest.kt <<'EOF'\npackage com.example.order\n\nimport org.junit.jupiter.api.Assertions.assertEquals\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.header\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n@AutoConfigureMockMvc\nclass OrderApiValidationTest : IntegrationTestBase() {\n\n    @Autowired\n    private lateinit var mvc: MockMvc\n\n    private fun order(key: String?, body: String) = post(\"/orders\").apply {\n        contentType(MediaType.APPLICATION_JSON)\n        if (key != null) header(\"Idempotency-Key\", key)\n        content(body)\n    }\n\n    @Test\n    fun `invalid requests are rejected without touching stock`() {\n        val p = repo.insertProduct(\"p\", 100, 5)\n        val cases = listOf(\n            \"數量 0\" to order(\"k\", \"\"\"{\"userId\":\"u\",\"items\":[{\"productId\":$p,\"quantity\":0}]}\"\"\") to 400,\n            \"數量為負\" to order(\"k\", \"\"\"{\"userId\":\"u\",\"items\":[{\"productId\":$p,\"quantity\":-3}]}\"\"\") to 400,\n            \"品項為空\" to order(\"k\", \"\"\"{\"userId\":\"u\",\"items\":[]}\"\"\") to 400,\n            \"缺 userId\" to order(\"k\", \"\"\"{\"items\":[{\"productId\":$p,\"quantity\":1}]}\"\"\") to 400,\n            \"缺 Idempotency-Key\" to order(null, \"\"\"{\"userId\":\"u\",\"items\":[{\"productId\":$p,\"quantity\":1}]}\"\"\") to 400,\n            \"商品不存在\" to order(\"k\", \"\"\"{\"userId\":\"u\",\"items\":[{\"productId\":999999,\"quantity\":1}]}\"\"\") to 422,\n            \"同單混入不存在的商品\" to order(\"k\", \"\"\"{\"userId\":\"u\",\"items\":[{\"productId\":$p,\"quantity\":1},{\"productId\":999999,\"quantity\":1}]}\"\"\") to 422,\n        )\n\n        cases.forEach { (case, expected) ->\n            val (name, request) = case\n            assertEquals(expected, mvc.perform(request).andReturn().response.status, name)\n        }\n\n        assertEquals(5, stockOf(p))\n        assertEquals(0, count(\"orders\"))\n        assertEquals(0, count(\"outbox\"))\n    }\n\n    @Test\n    fun `create replay and sold out map to 201 200 and 409`() {\n        val p = repo.insertProduct(\"p\", 250, 3)\n        val body = \"\"\"{\"userId\":\"u\",\"items\":[{\"productId\":$p,\"quantity\":2}]}\"\"\"\n\n        val location = mvc.perform(order(\"k1\", body))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"PENDING\"))\n            .andExpect(jsonPath(\"$.totalCents\").value(500))\n            .andReturn().response.getHeader(\"Location\")!!\n\n        mvc.perform(get(location)).andExpect(status().isOk).andExpect(jsonPath(\"$.items[0].quantity\").value(2))\n\n        // 同 key 重送:200、同一筆、不再扣庫存\n        mvc.perform(order(\"k1\", body)).andExpect(status().isOk).andExpect(header().doesNotExist(\"Location\"))\n        assertEquals(1, stockOf(p))\n\n        // 新 key 要 2 件但只剩 1 件\n        mvc.perform(order(\"k2\", body)).andExpect(status().isConflict)\n        assertEquals(1, stockOf(p))\n        assertEquals(1, count(\"orders\"))\n    }\n}\nEOF\ncat >> docs/order-svc-knowledge/Projects/訂單服務_計劃.md <<'EOF'\nEOF\npython3 - <<'EOF'\np='docs/order-svc-knowledge/Projects/訂單服務_計劃.md'\ns=open(p).read()\ns=s.replace(\"\"\"- [S7]\"\"\",\"\"\"- [S8] 多筆訂單以相反順序列出同樣幾樣商品、同時下單,不會互鎖(死結);扣庫存一律依商品 id 由小到大。[test:OrderConcurrencyTest::orders touching same products in opposite order do not deadlock]\n- [S7]\"\"\")\ns=s.replace(\"\\n## 回退\",\"\"\"- [S9] HTTP 對應:首次建立回 201 加 Location,同 key 重送回 200,庫存不足回 409。[test:OrderApiValidationTest::create replay and sold out map to 201 200 and 409]\n\n## 回退\"\"\")\nopen(p,'w').write(s)\nEOF\n(./gradlew test --console=plain 2>&1 | tail -60)"
