+def _qfm_q(qid="Q1", text="訂單成功的定義是什麼", cls="需求", stage="需求", status="待人", **kw):
+    """一題的開頭欄位原文(2 格起頭、4 格鍵);kw 依序附在後面,值照原樣寫(要引號自己帶)。"""
+    lines = [f"  - id: {qid}", f"    text: {text}", f"    class: {cls}", f"    stage: {stage}", f"    status: {status}"]
