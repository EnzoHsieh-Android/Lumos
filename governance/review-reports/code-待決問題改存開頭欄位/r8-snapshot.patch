+            return None
+        key, val = parts
+    k = _pq_key_norm(key)
+    if k in _PQ_QUESTION_ONLY_KEYS:
+        return k
+    if k == "id":
+        v = unicodedata.normalize("NFKC", strip_quotes(_pq_unquoted_value(val))).strip()
+        return None if re.fullmatch(r"d[0-9]+", v) else k
+    return None
+
+
+def _pq_structural_value_problem(raw):
+    """結構位置不收 flow collection、anchor、alias、tag；引號與 block scalar 另走自己的文法。"""
+    v = _pq_unquoted_value(raw)
+    if not v or v[:1] in "\"'" or v in BLOCK_SCALAR_HEADERS:
+        return None
+    if v == "[]":
+        return None
+    if v[0] in "[{":
+        return f"flow collection {v[:40]!a} 只有空清單 [] 可用;改成一行一項"
+    if v[0] == "&":
+        return f"anchor {v[:40]!a} 不在待決問題開頭欄位使用"
+    if v[0] == "*":
+        return f"alias {v[:40]!a} 不在待決問題開頭欄位使用"
+    if v[0] == "!":
+        return f"tag {v[:40]!a} 不在待決問題開頭欄位使用"
+    return None
+
+
+def _pq_leading_problem(raw):
+    if not raw:
+        return None
+    c = raw[0]
+    if c == "\t":
+        return "縮排用了 tab;結構縮排只收 ASCII 空白"
+    if c == " " or 0x21 <= ord(c) <= 0x7E:
+        return None
+    if c.isspace() or _pq_is_default_ignorable(c) or c in _PQ_BLANK_LOOKALIKES:
+        return f"行首用了 U+{ord(c):04X};結構縮排只收 ASCII 空白"
+    return None
+
+
+def _pq_line_mapping(raw):
+    """一行的 mapping 與鍵欄位深度；只剝結構用的重複 `- `，不替任何擁有者解析文法。"""
+    indent = len(raw) - len(raw.lstrip(" "))
+    text, prefixes = raw[indent:], 0
+    while text.startswith("- "):
+        text, prefixes = text[2:].lstrip(" "), prefixes + 1
+    parts = _pq_mapping_parts(text)
+    return (parts, indent + 2 * prefixes) if parts is not None else (None, None)
+
+
+def _pq_flow_questionish(raw):
+    """只在能裝 mapping 的 flow 值／清單項裡找題目鍵；逐段線性掃，不解析各欄位自己的 YAML。"""
+    stripped = raw.lstrip(" ")
+    item = stripped
+    while item.startswith("- "):
+        item = item[2:].lstrip(" ")
+    parts, _key_col = _pq_line_mapping(raw)
+    candidate = item if item[:1] in "[{" else (parts[1].lstrip() if parts is not None else item)
+    if not candidate or not (candidate.startswith("{") or
+                             (candidate.startswith("[") and ("{" in candidate or re.search(r":[ \t]", candidate)))):
+        return None
+    start = 0
+    for i, c in enumerate(candidate + ","):
+        if c not in ",{}[]":
+            continue
+        segment = candidate[start:i].strip()
+        qk = _pq_questionish_key(segment)
+        if qk:
+            return qk
+        start = i + 1
+    return None
+
+
+def _pq_structure_marker_problem(raw):
+    """含待決問題時，結構位置的 anchor/alias/tag 維持拒讀；其他欄位語法交還原讀法。"""
+    item = raw.lstrip(" ")
+    while item.startswith("- "):
+        item = item[2:].lstrip(" ")
+    # YAML 的 anchor/tag 可以修飾鍵本身；只看 mapping 的值會漏掉 `&a text: ...`。
+    # 這裡仍只認結構位置的第一個記號，不替擁有者解析第二套文法（代碼審 r7 邊界席 E1/E2）。
+    if item[:1] == "&":
+        return f"anchor {item[:40]!a} 不在待決問題開頭欄位使用"
+    if item[:1] == "*":
+        return f"alias {item[:40]!a} 不在待決問題開頭欄位使用"
+    if item[:1] == "!":
+        return f"tag {item[:40]!a} 不在待決問題開頭欄位使用"
+    parts, _key_col = _pq_line_mapping(raw)
+    candidate = parts[1].lstrip() if parts is not None else raw.lstrip(" ")
+    while candidate.startswith("- "):
+        candidate = candidate[2:].lstrip(" ")
+    if candidate[:1] == "&":
+        return f"anchor {candidate[:40]!a} 不在待決問題開頭欄位使用"
+    if candidate[:1] == "*":
+        return f"alias {candidate[:40]!a} 不在待決問題開頭欄位使用"
+    if candidate[:1] == "!":
+        return f"tag {candidate[:40]!a} 不在待決問題開頭欄位使用"
+    return None
+
+
+def _pq_block_key_col(raw):
+    parts, key_col = _pq_line_mapping(raw)
+    return key_col if parts is not None and _pq_unquoted_value(parts[1]) in BLOCK_SCALAR_HEADERS else None
+
+
+def _pq_outside_line_problem(raw):
+    """清單外所有行只套同一條鍵名規則；不再替 decisions、純量清單或頂格鍵各寫文法。"""
+    lead = _pq_leading_problem(raw)
+    if lead:
+        return lead
+    qk = _pq_questionish_key(raw)
+    indent = len(raw) - len(raw.lstrip(" "))
+    if qk and not (qk == "status" and indent == 0):
+        return f"清單範圍外出現題目的鍵 {qk!r};是待決問題就移到 pending_questions 底下"
+    flow_key = _pq_flow_questionish(raw)
+    if flow_key:
+        return f"清單範圍外的流式寫法含題目的鍵 {flow_key!r};是待決問題就移到 pending_questions 底下"
+    return _pq_structure_marker_problem(raw)
+
+
+def _pq_scalar_char_problem(v):
+    """把 Unicode 位置、正規形與總量收在同一個字元邊界，避免值文法再長一套判斷。"""
+    bad = _pq_bad_char(v)
+    if unicodedata.normalize("NFC", v) != v:
+        return f"值不是 NFC Unicode 正規形(U+{ord(bad):04X});先正規化這個字再寫"
+    if bad is not None:
+        return f"看不見的字元(U+{ord(bad):04X})不在允許的位置;題目欄位只收單行可印的文字"
+    if _pq_invisible_over_limit(v):
+        return "值裡看不見的字元太多;請保留語文必要的最少數量"
+    return None
+
+
+def _strict_scalar(raw):
+    """嚴格讀法的一個值:回 (值, 錯誤)。只收三種寫法——不加引號且 _yaml_plain_ok 認可的、
+    整個包在雙引號裡且內部沒有雙引號與反斜線的、整個包在單引號裡且內部沒有單引號的(就是 _yaml_quote 寫得出的兩種)。"""
+    v = raw.strip()
+    if v == "" or _pq_blank(v):
+        return None, "值是空的(或只有看不見的字元)"
+    char_problem = _pq_scalar_char_problem(v)
+    if char_problem:
+        return None, char_problem
+    if v[0] in "|>[{":
+        return None, f"值用 {v[0]} 開頭(多行或清單寫法),這個欄位只收單行文字"
+    for q in ('"', "'"):
+        if v[0] == q:
+            inner = v[1:-1]
+            if len(v) < 2 or v[-1] != q or q in inner or (q == '"' and "\\" in inner):
+                return None, f"引號寫法讀不懂({v[:40]}):整個值包在一對引號裡,裡面不要再有同一種引號" + ("或反斜線" if q == '"' else "")
+            if _pq_blank(inner):
+                return None, "值是空的(引號裡只有空白或看不見的字元)"
+            return inner, None
+    if not _yaml_plain_ok(v):
+        return None, f"值 {v[:40]!r} 不加引號時標準 YAML 會讀成別的東西(布林、數字、日期,或「空白加 #」被當註解),要加雙引號"
+    return v, None
+
+
+def _pq_scan(fm_lines, key, line0):
+    """含 pending_questions 時，清單外每行只套鍵名規則；題目本身仍只收既有 2/4 格。"""
+    errs, items, heads, bounds = [], [], [], []
+    for i, ln in enumerate(fm_lines):
+        raw = ln.rstrip()
+        if not raw.strip() or raw[0] in " \t" or raw.startswith("- "):
+            continue
+        parts, _key_col = _pq_line_mapping(raw)
+        if parts is None:
+            continue
+        raw_name, val = parts
+        name = _pq_key_norm(raw_name)
+        bounds.append((i, raw_name, val))
+        if raw.startswith(key + ":") and raw_name == key:
+            heads.append(i)
+        elif name.replace("-", "_").replace(" ", "_").startswith(key[:-1]):
+            errs.append((i + line0, f"頂格的鍵 {raw[:40]!a} 像是 {key} 寫錯(拼字、大小寫、連字號、引號或冒號前的空白);改成恰好 `{key}:`"))
+    if not heads:
+        return bool(errs), items, errs
+    if len(heads) > 1:
+        errs.append((heads[1] + line0, f"開頭欄位裡 {key}: 寫了兩次;合成一個"))
+
+    h = heads[0]
+    hi = next(i for i, b in enumerate(bounds) if b[0] == h)
+    end = bounds[hi + 1][0] if hi + 1 < len(bounds) else len(fm_lines)
+    tail = _pq_unquoted_value(bounds[hi][2])
+    if tail not in ("", "[]"):
+        errs.append((h + line0, f"{key}: 後面直接接了值 {tail[:30]!a};只能空著(下面一行一題)或寫 []"))
+
+    # 代碼審 r7 A6/A7、E1/E2/E5/E6：清單外不解析各擁有者，只逐行套同一條鍵名／flow 規則；
+    # 唯一跳過的是四種既有 block scalar，內容連續到縮排不再深於「鍵」所在欄位。
+    block_col = None
+    for i, ln in enumerate(fm_lines):
+        if h <= i < end:
+            block_col = None
+            continue
+        raw, no = ln.rstrip(), i + line0
+        if not raw.strip():
+            continue
+        indent = len(raw) - len(raw.lstrip(" "))
+        if block_col is not None and indent > block_col:
+            continue
+        block_col = None
+        if raw.lstrip(" ").startswith("#"):
+            continue
+        problem = _pq_outside_line_problem(raw)
+        if problem:
+            errs.append((no, f"第 {no} 行{problem}"))
+        block_col = _pq_block_key_col(raw)
+
+    cur = None
+    for i in range(h + 1, end):
+        raw = fm_lines[i].rstrip()
+        no = i + line0
+        if not raw.strip() or raw.lstrip(" ").startswith("#"):
+            continue
+        lead_pb = _pq_leading_problem(raw)
+        if lead_pb:
+            errs.append((no, lead_pb + ";題目縮 2 格、鍵縮 4 格"))
+            continue
+        if tail == "[]":
+            errs.append((no, f"{key}: [] 是空清單,後面卻又接了題目;拿掉 [] 再寫題"))
+            continue
+        mi, ms = _PQ_ITEM_RE.match(raw), _PQ_SUB_RE.match(raw)
+        if mi:
+            m2 = re.fullmatch(r"id:(?: (.*))?", mi.group(1).rstrip())
+            if not m2:
+                errs.append((no, "一題的第一個鍵必須是 id(寫成 `  - id: Q<n>`)"))
+                cur = None
+                continue
+            cur = {"_line": no, "id": ((m2.group(1) or "").strip(), no)}
+            items.append(cur)
+        elif ms and cur is not None:
+            k = ms.group(1)
+            if k in cur:
+                qd = cur['id'][0] if _PQ_ID_RE.fullmatch(cur['id'][0]) else ascii(cur['id'][0])
+                errs.append((no, f"{qd} 的 {k} 寫了兩次;只留一個"))
+            cur[k] = ((ms.group(2) or "").strip(), no)
+        else:
+            errs.append((no, f"讀不懂這行 {raw.strip()[:40]!a}:題目縮 2 格寫 `  - id: Q<n>`,這一題的鍵縮 4 格寫 `鍵: 值`"))
+    return True, items, errs
+
+
+def pq_parse(fm_lines, line0=2):
+    """開頭欄位 pending_questions 的嚴格讀法(Projects/待決問題改存開頭欄位_計劃):只要有一處讀不懂,整份當無法判定。
+    回 (有沒有這個欄位, 題目清單 [{鍵: 值, _line}], [(檔案行號, 原因)]);錯誤非空時題目清單不可用。
+    line0 = fm_lines[0] 在檔案裡是第幾行(開頭的 --- 是第 1 行)。"""
+    # 代碼審 r6 正確性席：讀檔與直接餵文字必須同口徑；CRLF/裸 CR 都先轉 LF，只移除檔首一個 BOM。
+    raw = "\n".join(fm_lines or []).replace("\r\n", "\n").replace("\r", "\n")
+    if raw.startswith("\ufeff"):
+        raw = raw[1:]
+    fm_lines = raw.split("\n")
+    present, raw_items, errs = _pq_scan(fm_lines, "pending_questions", line0)
+    qs, seen = [], {}
+    for it in raw_items:
+        q, ln = {"_line": it["_line"]}, it["_line"]
+        qid = it["id"][0]
+        if not _PQ_ID_RE.fullmatch(qid):
+            errs.append((ln, f"題號 {qid!r} 格式不對;寫成 Q 加不帶前導零的正整數(Q1、Q12)"))
+            qid = ascii(qid)   # 後面的訊息會帶題號:格式不對的一律用跳脫後的寫法,控制字元不進終端(代碼審 r2 資安席)
+        elif qid in seen:
+            errs.append((ln, f"題號 {qid} 重複(第 {seen[qid]} 行也有)"))
+        seen.setdefault(qid, ln)
+        q["id"] = qid
+        for k, vn in it.items():
+            if k in ("_line", "id"):
+                continue
+            v, no = vn
+            if k not in _PQ_KEYS:
+                errs.append((no, f"{qid} 有不認得的鍵 {k};只收 {'、'.join(_PQ_KEYS)}"))
+                continue
+            if k in _PQ_BOOL_KEYS:
+                if v not in ("true", "false"):
+                    errs.append((no, f"{qid} 的 {k} 只收不加引號的 true 或 false,寫的是 {v!r}"))
+                q[k] = v == "true"
+                continue
+            val, why = _strict_scalar(v)
+            if why:
+                errs.append((no, f"{qid} 的 {k}:{why}"))
+                continue
+            q[k] = val
+        for k in _PQ_REQUIRED:
+            if k not in it:
+                errs.append((ln, f"{qid} 缺必有的鍵 {k}"))
+        if q.get("stage") is not None and q["stage"] not in PQ_STAGES:
+            errs.append((ln, f"{qid} 的 stage 要是 {'/'.join(PQ_STAGES)} 之一,寫的是 {q['stage']!r}"))
+        if q.get("status") is not None and q["status"] not in PQ_STATUSES:
+            errs.append((ln, f"{qid} 的 status 要是 {'/'.join(PQ_STATUSES)} 之一,寫的是 {q['status']!r}"))
+        if "tests" in q:
+            ts = [t.strip() for t in q["tests"].split(",")]
+            if any(not t for t in ts) or len(set(ts)) != len(ts) or any(c in t for t in ts for c in "[]"):
+                errs.append((ln, f"{qid} 的 tests 有空的一段、重複的名字或中括號(半形逗號分隔,測試名不能含逗號與中括號)"))
+            q["tests"] = [t for t in ts if t]
+        q.setdefault("blocking", False)
+        q.setdefault("irreversible", False)
+        qs.append(q)
+    return present, qs, sorted(errs)
+
+
+def _pq_fm_of_text(text):
+    """全文 → (開頭欄位行, 第一行在檔案的行號)；CRLF/裸 CR 同轉 LF，只去檔首一個 BOM。"""
+    text = (text or "").replace("\r\n", "\n").replace("\r", "\n")
+    if text.startswith("\ufeff"):
+        text = text[1:]
+    fm, _ = split_frontmatter(text)
+    return fm or [], 2
+
+
+def _pq_decision_state(env, rel, ref, self_fm=None, cache=None):
+    """決策連結 → ok / missing / superseded / bad。格式沿用決策紀錄的全域編號 <節點>#dN(解析 _dref_parse);本篇可簡寫 #dN。
+    self_fm:寫入指令在鎖內組好的開頭欄位——給了它,本篇用它、別篇從磁碟重讀(不信鎖外載入的舊內容,代碼審 r1 併發席)。
+    帶路徑的寫法要整條對得上;只寫短名而同名不只一篇,當格式不合(env.resolve 會退回比短名、撞名取第一篇,代碼審 r1 邊界席)。
+    cache:同一次判定裡每篇的決策只解析一次(代碼審 r1:原本每題重解析,題數乘決策數)。"""
+    ref = str(ref).strip()
+    if "[[" in ref or "]]" in ref:
+        return "bad"
+    if re.fullmatch(r"#d\d+", ref):
+        node, did = rel, ref[1:]
+    else:
+        pr = _dref_parse(ref)
+        if not pr or not pr[0]:
+            return "bad"
+        lit = nfc(pr[0][:-3] if pr[0].lower().endswith(".md") else pr[0])
+        cache = {} if cache is None else cache
+        if "/" in lit:   # 帶路徑:整條對上,不像 env.resolve 對不上就退回比短名
+            if (lit + ".md") in env.notes:   # 完全相符優先(只差大小寫的兩篇並存時不判撞名,代碼審 r3 邊界席)
+                hits = [lit + ".md"]
+            else:
+                if cache.get("paths") is None:   # 不分大小寫的路徑索引,同一次判定只建一次(代碼審 r2 後的效能檢查)
+                    idx = {}
+                    for r in env.notes:
+                        idx.setdefault(r[:-3].lower(), []).append(r)
+                    cache["paths"] = idx
+                hits = list(cache["paths"].get(lit.lower(), []))
+        else:            # 只寫短名:用共用的短名索引 by_stem(不分大小寫);撞名不像 env.resolve 取第一篇,當格式不合
+            hits = list(env.by_stem.get(lit.lower(), []))
+        if len(hits) > 1:
+            return "bad"
+        node = hits[0] if hits else None
+        did = pr[1]
+        if not node:
+            return "missing"
+    cache = {} if cache is None else cache
+    nodes = cache.setdefault("nodes", {})   # 同一次判定:每篇的決策(nodes)與路徑索引(paths)各放一格,不混在同一層
+    if node not in nodes:
+        if node == rel and self_fm is not None:
+            nodes[node] = parse_decisions(self_fm)
+        elif self_fm is not None:
+            try:
+                fm, _b = split_frontmatter((env.vault / node).read_text(encoding="utf-8-sig"))
+            except (OSError, UnicodeDecodeError):
+                fm = None
+            nodes[node] = parse_decisions(fm) if fm is not None else None
+        else:
+            nodes[node] = _node_decisions(env, node) if node in env.notes else None
+    ds = nodes[node]
+    if ds is None:
+        return "missing"
+    for d in ds:
+        if str(d.get("id", "")).strip() == did:
+            return "superseded" if str(d.get("valid", "true")).strip().lower() == "false" else "ok"
+    return "missing"
+
+
+def _pq_settled(env, rel, q, self_fm=None, cache=None):
+    """「結了」:狀態是已決或已驗,而且決策連結指到存在、沒作廢的決策。規格閘、lint、兩支指令共用這一條。"""
+    return (q.get("status") in ("已決", "已驗") and bool(q.get("decision"))
+            and _pq_decision_state(env, rel, q["decision"], self_fm, cache) == "ok")
+
+
+def _pq_rule_problems(env, rel, q, self_fm=None, cache=None):
+    """一題寫成這樣之後違反哪幾條(寫入規則=lint 的必附與「結了」那幾條);回原因清單。"""
+    out, st = [], q.get("status")
+    need = {"已決": ("decision",), "已驗": ("decision", "tests"), "自答": ("source",), "延後": ("reason",)}.get(st, ())
+    for k in need:
+        if not q.get(k):
+            out.append(f"狀態是{st}卻沒有 {k}")
+    if q.get("blocking") and st == "延後":
+        out.append("標了阻塞的題不能延後(阻塞就是不能往下做,要嘛決定、要嘛拿掉阻塞)")
+    if q.get("irreversible") and st == "自答":
+        out.append("標了不可逆的題不能自答,要人決定")
+    if q.get("decision"):
+        ds = _pq_decision_state(env, rel, q["decision"], self_fm, cache)
+        if ds == "bad":
+            out.append(f"決策連結 {q['decision']!r} 格式不合或短名撞名;寫成 <節點路徑>#dN(decision-add 印的全域編號),本篇可寫 #dN")
+        elif ds == "missing":
