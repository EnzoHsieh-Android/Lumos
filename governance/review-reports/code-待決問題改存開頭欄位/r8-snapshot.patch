+
+    pv = mkvault()
+    pn = note_at(pv)
+    plog = pv.parent / ".signoff-log.jsonl"
+    plog.write_bytes(b'{"old":true}\n')
+    pnb, plb = pn.read_bytes(), plog.read_bytes()
+    real_open, old_argv = builtins.open, sys.argv
+
+    class _PartialAppend:
+        def __init__(self, path):
+            self.fh = real_open(path, "ab")
+
+        def tell(self):
+            return self.fh.tell()
+
+        def fileno(self):
+            return self.fh.fileno()
+
+        def flush(self):
+            return self.fh.flush()
+
+        def truncate(self, n):
