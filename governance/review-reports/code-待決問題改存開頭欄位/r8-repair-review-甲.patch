+def _call_with_write_blocked_boundary(func, *args, **kwargs):
+    try:
+        return func(*args, **kwargs)
+    except WriteBlocked as exc:
+        # 邊界最後清洗一次：個別分派只處理自己的既有錯誤，所有直接呼叫 main() 的入口
+        # 則都會經過這個裝飾器(代碼審 r7 架構席 A3/A5、資安甲 S3)。
+        print(f"擋下:{_esc_clean(str(exc), 1000)}", file=sys.stderr)
+        return 2
+
+
+def _write_blocked_boundary(func):
+    """保留 `def main():` 入口形狀，並讓 CLI 與測試直接呼叫 main() 都共用同一個 WriteBlocked 邊界。"""
+    import functools
+    wrapped = functools.partial(_call_with_write_blocked_boundary, func)
+    functools.update_wrapper(wrapped, func)
+    return wrapped
