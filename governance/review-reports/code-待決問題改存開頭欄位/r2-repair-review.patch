+def _pq_git_read_many(rr, specs):
+    """一次讀多個 <版本>:<路徑>(git cat-file --batch,一個程序、有逾時):回 {spec: 文字,不存在=None};git 跑不起來回 None。"""
+    if not specs:
+        return {}
+    try:
+        r = subprocess.run(["git", "-C", str(rr), "cat-file", "--batch"], input=("\n".join(specs) + "\n").encode("utf-8"),
+                           capture_output=True, timeout=60)
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    if r.returncode != 0:
+        return None
+    out, buf, pos = {}, r.stdout, 0
+    for sp in specs:
+        nl = buf.find(b"\n", pos)
+        if nl < 0:
+            return None
+        head = buf[pos:nl].decode("utf-8", "replace")
+        pos = nl + 1
+        if head.endswith(" missing") or head.endswith(" ambiguous"):
+            out[sp] = None
+            continue
+        parts = head.split()
+        size = int(parts[2]) if len(parts) == 3 and parts[2].isdigit() else -1
+        if size < 0:
+            return None
+        out[sp] = buf[pos:pos + size].decode("utf-8", "replace")
+        pos += size + 1
+    return out
 
 
