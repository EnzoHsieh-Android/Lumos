+++def _pq_top_key(s):
+++    """頂格一行的鍵名(去引號、冒號前空白);不是「鍵: 值」的形狀回 None。只用 partition,沒有會回溯的正規式。"""
+++    if s[:1] in "-<=>" or ":" not in s:
+++        return None
+++    name = s.partition(":")[0].strip().strip("\"'")
+++    return name or None
