+++            continue
+++        if "\t" in raw[:len(raw) - len(raw.lstrip())]:
+++            errs.append((no, "縮排用了 tab;改成空白(題目 2 格、鍵 4 格)"))
+++            continue
+++        if tail == "[]":
+++            errs.append((no, f"{key}: [] 是空清單,後面卻又接了題目;拿掉 [] 再寫題"))
+++            continue
+++        mi, ms = _PQ_ITEM_RE.match(raw), _PQ_SUB_RE.match(raw)
+++        if mi:
