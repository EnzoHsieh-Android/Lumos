++def _pq_decision_state(env, rel, ref, self_fm=None, cache=None):
++    """決策連結 → ok / missing / superseded / bad。格式沿用決策紀錄的全域編號 <節點>#dN(解析 _dref_parse);本篇可簡寫 #dN。
++    self_fm:寫入指令在鎖內組好的開頭欄位——給了它,本篇用它、別篇從磁碟重讀(不信鎖外載入的舊內容,代碼審 r1 併發席)。
++    帶路徑的寫法要整條對得上;只寫短名而同名不只一篇,當格式不合(env.resolve 會退回比短名、撞名取第一篇,代碼審 r1 邊界席)。
++    cache:同一次判定裡每篇的決策只解析一次(代碼審 r1:原本每題重解析,題數乘決策數)。"""
++    ref = str(ref).strip()
++    if "[[" in ref or "]]" in ref:
++        return "bad"
++    if re.fullmatch(r"#d\d+", ref):
++        node, did = rel, ref[1:]
++    else:
++        pr = _dref_parse(ref)
++        if not pr or not pr[0]:
++            return "bad"
++        lit = nfc(pr[0][:-3] if pr[0].lower().endswith(".md") else pr[0])
++        cache = {} if cache is None else cache
++        if "/" in lit:   # 帶路徑:整條對上(不分大小寫),不像 env.resolve 對不上就退回比短名
++            if "\0paths" not in cache:   # 路徑索引同一次判定只建一次(代碼審 r2 後的效能檢查:原本每題掃整庫)
++                idx = {}
++                for r in env.notes:
++                    idx.setdefault(r[:-3].lower(), []).append(r)
++                cache["\0paths"] = idx
++            hits = list(cache["\0paths"].get(lit.lower(), []))
++        else:            # 只寫短名:用共用的短名索引 by_stem(不分大小寫);撞名不像 env.resolve 取第一篇,當格式不合
++            hits = list(env.by_stem.get(lit.lower(), []))
++        if len(hits) > 1:
++            return "bad"
++        node = hits[0] if hits else None
++        did = pr[1]
++        if not node:
++            return "missing"
++    cache = {} if cache is None else cache
++    if node not in cache:
++        if node == rel and self_fm is not None:
++            cache[node] = parse_decisions(self_fm)
