+++def _pq_scan(fm_lines, key, line0):
+++    """pending_questions 專用的嚴格掃描:只認 2 格的 `- id:` 起頭、4 格的 `鍵: 值`,看不懂就回報、不略過。
+++    ★不掛在 parse_decisions 底下★(代碼審 r1 架構席):決策那份清單收多行值與子清單、縮排從第一個 dash 推,
+++    這份只收單行值、縮排寫死——兩邊的文法本來就不同,硬掛成同一支的參數只是名義上共用。寫入端定位項目照樣用 decisions_items。
+++    回 (有沒有這個欄位, [每一項 {鍵: (原值, 檔案行號)} 加 _line], [(檔案行號, 原因)])。"""
+++    errs, items, heads = [], [], []
+++    for i, ln in enumerate(fm_lines):
+++        s = ln.rstrip()
+++        if not s or s[0] in " \t#":
+++            continue
+++        if s.startswith(key + ":"):
+++            heads.append(i)
+++            continue
+++        name = _pq_top_key(s)
+++        if name and name.lower().replace("-", "_").replace(" ", "_").startswith(key[:-1]):
+++            errs.append((i + line0, f"頂格的鍵 {s[:40]!r} 像是 {key} 寫錯(拼字、大小寫、連字號、引號或冒號前的空白);改成恰好 `{key}:`"))
+++    if not heads:
+++        return bool(errs), items, errs
+++    if len(heads) > 1:
+++        errs.append((heads[1] + line0, f"開頭欄位裡 {key}: 寫了兩次;合成一個"))
+++    h = heads[0]
+++    tail = fm_lines[h].rstrip()[len(key) + 1:].strip()
+++    if tail not in ("", "[]"):
+++        errs.append((h + line0, f"{key}: 後面直接接了值 {tail[:30]!r};只能空著(下面一行一題)或寫 []"))
+++    cur = None
+++    for i in range(h + 1, len(fm_lines)):
+++        raw = fm_lines[i].rstrip()
+++        no = i + line0
+++        if not raw.strip() or raw.lstrip(" ").startswith("#"):
+++            continue
+++        if raw[0] not in " \t":
+++            name = _pq_top_key(raw)
+++            if name in _PQ_KEYS:
+++                errs.append((no, f"{name} 是題目的鍵,卻寫在頂格(縮排掉了);縮 4 格放回它那一題底下"))
+++                continue
+++            if name:
+++                break
+++            errs.append((no, f"這行頂格寫了 {raw[:40]!r},不是鍵也不是題目;題目要縮 2 格寫成 `  - id: Q<n>`"))
+++            continue
+++        if "\t" in raw[:len(raw) - len(raw.lstrip())]:
+++            errs.append((no, "縮排用了 tab;改成空白(題目 2 格、鍵 4 格)"))
+++            continue
+++        if tail == "[]":
+++            errs.append((no, f"{key}: [] 是空清單,後面卻又接了題目;拿掉 [] 再寫題"))
+++            continue
+++        mi, ms = _PQ_ITEM_RE.match(raw), _PQ_SUB_RE.match(raw)
+++        if mi:
+++            m2 = re.fullmatch(r"id:(?: (.*))?", mi.group(1).rstrip())
+++            if not m2:
+++                errs.append((no, "一題的第一個鍵必須是 id(寫成 `  - id: Q<n>`)"))
+++                cur = None
+++                continue
+++            cur = {"_line": no, "id": ((m2.group(1) or "").strip(), no)}
+++            items.append(cur)
+++        elif ms and cur is not None:
+++            k = ms.group(1)
+++            if k in cur:
+++                errs.append((no, f"{cur['id'][0]} 的 {k} 寫了兩次;只留一個"))
+++            cur[k] = ((ms.group(2) or "").strip(), no)
+++        else:
+++            errs.append((no, f"讀不懂這行 {raw.strip()[:40]!r}:題目縮 2 格寫 `  - id: Q<n>`,這一題的鍵縮 4 格寫 `鍵: 值`"))
+++    return True, items, errs
