+++    p = kg / "Projects" / f"{name}_計劃.md"
+++    fm = "---\ntype: project\nstatus: doing\n" + decisions + ("" if pq is None else pq) + "---\n"
+++    p.write_text(fm + "# " + name + "\n\n" + "\n".join(clauses or ["- [S1] 系統應回 200 [test:t_green]"]) + "\n" + _SG_ROLLBACK + body,
+++                 encoding="utf-8")
+++    return p
