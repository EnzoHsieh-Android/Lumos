+++def _strict_scalar(raw):
+++    """嚴格讀法的一個值:回 (值, 錯誤)。只收三種寫法——不加引號且 _yaml_plain_ok 認可的、
+++    整個包在雙引號裡且內部沒有雙引號與反斜線的、整個包在單引號裡且內部沒有單引號的(就是 _yaml_quote 寫得出的兩種)。"""
+++    v = raw.strip()
+++    if v == "":
+++        return None, "值是空的"
+++    bad = _pq_bad_char(v)
+++    if bad is not None:
+++        return None, f"值裡有控制字元或換行類字元(U+{ord(bad):04X});題目欄位只收單行可印的文字"
+++    if v[0] in "|>[{":
+++        return None, f"值用 {v[0]} 開頭(多行或清單寫法),這個欄位只收單行文字"
+++    for q in ('"', "'"):
+++        if v[0] == q:
+++            inner = v[1:-1]
+++            if len(v) < 2 or v[-1] != q or q in inner or (q == '"' and "\\" in inner):
+++                return None, f"引號寫法讀不懂({v[:40]}):整個值包在一對引號裡,裡面不要再有同一種引號" + ("或反斜線" if q == '"' else "")
+++            if not inner.strip():
+++                return None, "值是空的(引號裡只有空白)"
+++            return inner, None
+++    if not _yaml_plain_ok(v):
+++        return None, f"值 {v[:40]!r} 不加引號時標準 YAML 會讀成別的東西(布林、數字、日期,或「空白加 #」被當註解),要加雙引號"
+++    return v, None
