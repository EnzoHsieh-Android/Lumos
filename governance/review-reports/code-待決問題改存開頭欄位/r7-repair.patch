+          and "✓" not in out.getvalue() and "改後" not in out.getvalue()
+          and note.read_bytes() == note_before and log.read_bytes() == log_before,
+          (rc, out.getvalue(), err.getvalue(), note.read_bytes() == note_before, log.read_bytes() == log_before))
