 def _pq_mapping_parts(text):
     """`鍵: 值` 的兩半；冒號後沒空白也沒到行尾不是 mapping 分隔。"""
     if ":" not in text:
         return None
     key, sep, val = text.partition(":")
     if not sep or not key.strip() or (val and val[0] not in " \t"):
