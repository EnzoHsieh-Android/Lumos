 def _kt_bump(item):
     """「名稱 數」裡最後一個整數加 1。"""
     import re as _re
     head, num, tail = _re.match(r"^(.*?)(\d+)(\D*)$", item).groups()
     return f"{head}{int(num) + 1}{tail}"
 
 
