 def _kt_drop_line(prefix):
     """改壞用:刪掉以 prefix 開頭的那一行(只刪第一處)。"""
     def f(t):
         i = t.find("\n" + prefix)
         return t if i < 0 else t[:i] + t[t.index("\n", i + 1):]
     return f
 
 
