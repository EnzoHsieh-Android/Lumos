+def cmd_prose_lint(path):
+    """spec 白話健檢([S1] 設計審收斂重定義 2026-08-25):掃中文模糊措辭。
+
+    恆 rc0(advisory:掃到也不擋,擋人的判斷歸審查與人);檔案讀不到才 rc2。
+    排除 code fence 內容與「引句:」行(引的是別人的原文,不歸 spec 作者改)。
+    design-loop 排乾步驟必跑;派工詞明寫「此掃描可及類別,席位不得報」。
+    """
+    md = Path(path)
+    if not md.is_file():
+        print(f"擋下:找不到這個檔案: {path}", file=sys.stderr)
+        return 2
+    try:
+        text = md.read_text(encoding="utf-8-sig")
+    except OSError as e:
+        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
+        return 2
+    hits = []
+    in_fence = False
+    for ln, line in enumerate(text.splitlines(), 1):
+        if line.lstrip().startswith("```"):
+            in_fence = not in_fence
+            continue
+        if in_fence or "引句:" in line or "引句:" in line:
+            continue
+        for family, words in _PROSE_WEAK_WORDS:
+            for w in words:
+                start = 0
+                while True:
+                    idx = line.find(w, start)
+                    if idx < 0:
+                        break
+                    frag = line[max(0, idx - 12):idx + len(w) + 12].strip()
+                    hits.append((ln, family, w, frag))
+                    start = idx + len(w)
+    n_words = sum(len(ws) for _, ws in _PROSE_WEAK_WORDS)
+    if not hits:
+        print(f"✓ prose-lint {md.name} — 沒掃到模糊措辭(詞表保守首版 {n_words} 個詞;掃不到不代表精確,詞表在下一個真實設計迴圈校準)")
+        return 0
+    print(f"掃到 {len(hits)} 處模糊措辭({md.name})。這不擋任何事(rc 仍是 0)——在意的原因:spec 裡的模糊詞會讓實作者自行腦補、審查員也錨不住:")
+    shown = hits[:40]
+    for ln, family, w, frag in shown:
+        print(f"  第 {ln} 行 「{w}」({family}):…{frag}…")
+    if len(hits) > len(shown):
+        print(f"  (其餘 {len(hits) - len(shown)} 處省略,全部列會淹掉重點)")
+    print("處理方式:能量化就量化;不能量化的,寫明「誰、什麼時候、用什麼判準」。改完重掃:")
+    print(f"    lumos prose-lint {path}")
+    return 0
