+    print()
+    print("沒關門「不等於」沒做完——關門事件(治理帳裡的放行紀錄)這個慣例 %s 才開始," % LOOP_CLOSE_SINCE)
+    print("更早的迴圈天生沒有這一筆;這裡只說「帳面沒看到關門事件」。")
+    if not stale_only and stale:
+        print("另有 %d 個超過 %d 天沒動也沒關門(空轉候選),看它們:" % (len(stale), days))
+        print("    lumos loop list --stale")
+    if n_excluded:
+        print("(依 --exclude 略過 %d 個編號)" % n_excluded)
+    print()
+    print("要接哪一個,先問它下一步:")
+    print("    lumos loop next <編號> --spec <計劃.md>")
+    return 0
+
