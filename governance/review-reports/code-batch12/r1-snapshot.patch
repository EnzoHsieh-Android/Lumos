+# ── loop list:哪些審查迴圈還開著(執行DAG_調研 排第一順位的缺口) ──
+# next/status/verify-progress 全都強制要 loop_id,卻沒有任何入口能先知道有哪些編號在飛,
+# 實務上只能 tail .canary-log.jsonl 或看 git 未追蹤檔。關門訊號取治理帳的放行事件——
+# 那是既有的、寫入當下就落的、可重算的東西,不新增任何要人維護的狀態。
+LOOP_CLOSE_EVENTS = {("design-loop", "converged"), ("design-loop", "cap-reached"),
+                     ("design-loop", "rewrite"), ("code-loop", "passed"), ("code-loop", "skipped")}
+LOOP_CLOSE_SINCE = "2026-08-22"   # 治理帳出現第一筆 design-loop converged 的日子
+
+
+def _loop_ts_key(ts):
+    """ISO 時間字串 → 可比較的 UTC 秒數;解析不動或沒帶時區就回 None(呼叫端退回字串比對)。
+
+    ★為什麼需要這一層★:審查帳與治理帳今天全部寫 +08:00(當場數過:1101 / 26443 筆都是),
+    所以直接拿字串比大小剛好會對。但那是巧合不是保證——只要有一筆從別的時區(或 UTC)
+    寫進來,字串比對就會**靜默**把開著判成關了、或反過來。這層把那個假設消掉,成本幾行。
+    沒帶時區的一律不猜(回 None):猜錯比退回字串比對更糟。"""
+    import datetime
+    if not ts:
+        return None
+    try:
+        d = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    if d.tzinfo is None:
+        return None
+    return d.timestamp()
+
+
+def _loop_ts_newer(a, b):
+    """a 是不是比 b 晚。兩邊都解得動就比 UTC 秒數,否則退回字串比對(舊帳相容)。"""
+    ka, kb = _loop_ts_key(a), _loop_ts_key(b)
+    if ka is not None and kb is not None:
+        return ka > kb
+    return (a or "") > (b or "")
+
+
+def _loop_close_stamps(env):
+    """治理帳 → {loop_id: 最後一次關門事件的 ts}。壞行跳過(回傳跳過行數)。"""
+    import json
+    path = env.vault.parent / ".governance-log.jsonl"
+    stamps, bad = {}, 0
+    if not path.exists():
+        return stamps, bad
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            d = json.loads(line)
+        except ValueError:
+            bad += 1
+            continue
+        if (d.get("gate"), d.get("kind")) not in LOOP_CLOSE_EVENTS:
+            continue
+        ts = d.get("ts") or ""
+        for n in (d.get("nodes") or []):
+            if isinstance(n, str) and _loop_ts_newer(ts, stamps.get(n, "")):
+                stamps[n] = ts
+    return stamps, bad
+
+
+def cmd_loop_list(env, days=14, show_all=False, stale_only=False, as_json=False, now=None,
+                  exclude=None):
+    """帳面上還開著的審查迴圈。開著=沒有關門事件,或關門後又記了新的審查輪次。
+
+    ★誠實界線★:關門事件的慣例 %s 才開始,更早的迴圈天生沒有這筆——所以「沒關門」
+    只等於「帳面沒看到關門事件」,不等於「沒做完」。唯讀恆 rc0(比照 canary-stats);
+    壞行跳過但出聲(不靜默,也不 fail-closed——這是查詢不是閘)。""" % LOOP_CLOSE_SINCE
+    import json, datetime
+    path = env.vault.parent / ".canary-log.jsonl"
+    per = {}
+    bad = 0
+    if path.exists():
+        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                d = json.loads(line)
+            except ValueError:
+                bad += 1
+                continue
+            lid = d.get("loop")
+            if not isinstance(lid, str) or not lid:
+                continue
+            e = per.setdefault(lid, {"loop": lid, "last_ts": "", "rounds": set(), "records": 0,
+                                     "last_severity": None, "tier": None, "orchestrator": None})
+            e["records"] += 1
+            ts = d.get("ts") or ""
+            if not _loop_ts_newer(e["last_ts"], ts):   # ts >= last_ts(時區安全)
+                e["last_ts"] = ts
+                e["last_severity"] = d.get("severity")
+            if d.get("round"):
+                e["rounds"].add(d["round"])
+            e["tier"] = e["tier"] or d.get("tier")
+            e["orchestrator"] = e["orchestrator"] or d.get("orchestrator")
+    closed, gbad = _loop_close_stamps(env)
+    bad += gbad
+    if now:
+        try:
+            today = datetime.date.fromisoformat(now)
+        except ValueError:
+            print("擋下:--now 要給 YYYY-MM-DD 這種格式的日期,你給的是 %r" % now, file=sys.stderr)
+            return 2
+    else:
+        today = datetime.date.today()
+
+    def _idle(ts):
+        try:
+            return (today - datetime.date.fromisoformat(ts[:10])).days
+        except ValueError:
+            return None
+
+    rows = []
+    for e in per.values():
+        cts = closed.get(e["loop"], "")
+        rows.append({"loop": e["loop"], "last_ts": e["last_ts"], "idle_days": _idle(e["last_ts"]),
+                     "rounds": len(e["rounds"]) or e["records"], "last_severity": e["last_severity"],
+                     "tier": e["tier"], "orchestrator": e["orchestrator"],
+                     "closed_ts": cts or None,
+                     "open": _loop_ts_newer(e["last_ts"], cts)})
+    # 排除前綴:自主迴圈的每日場次(auto-YYYY-MM-DD)天生不會有關門事件、一天長一個,
+    # 不排掉的話這份清單遲早被它們淹掉。★不寫死任何前綴★——要排什麼由呼叫端說。
+    n_excluded = 0
+    if exclude:
+        keep = [r for r in rows if not any(r["loop"].startswith(x) for x in exclude)]
+        n_excluded = len(rows) - len(keep)
+        rows = keep
+    rows.sort(key=lambda r: (_loop_ts_key(r["last_ts"]) or float("-inf"), r["last_ts"]), reverse=True)
+    fresh = [r for r in rows if r["open"] and (r["idle_days"] is None or r["idle_days"] <= days)]
+    stale = [r for r in rows if r["open"] and r["idle_days"] is not None and r["idle_days"] > days]
+    done = [r for r in rows if not r["open"]]
+    if bad:
+        print("提醒:審查帳/治理帳有 %d 行讀不動,已跳過(這份清單可能因此少列迴圈)" % bad, file=sys.stderr)
+    if as_json:
+        print(json.dumps({"now": today.isoformat(), "days": days, "open": fresh,
+                          "stale": stale, "closed": done}, ensure_ascii=False, indent=2))
+        return 0
+    if not rows:
+        print("審查帳裡還沒有任何迴圈。開第一輪:")
+        print("    lumos loop next <編號> --tier standard --orchestrator claude --spec <計劃.md>")
+        return 0
+
+    def _line(r):
+        idle = "?" if r["idle_days"] is None else "%d 天前" % r["idle_days"]
+        sev = r["last_severity"] or "—"
+        return "  %-8s %2d 輪  最後一筆 %-7s  %s" % (idle, r["rounds"], sev, r["loop"])
+
+    if stale_only:
+        print("審查迴圈:超過 %d 天沒動、帳面又沒關門的有 %d 個(空轉候選)" % (days, len(stale)))
+        for r in stale:
+            print(_line(r))
+    else:
+        print("審查迴圈:帳面上還沒關門的有 %d 個(最近 %d 天有動)" % (len(fresh), days))
+        for r in fresh:
