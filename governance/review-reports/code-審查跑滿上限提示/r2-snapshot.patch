+def _report_reported_count(text):
+    """[審查有沒有用記帳 S1] 報了幾條=檔級之後的獨立宣告行數(排除 clean)。前提是報告已通過 _report_normalize_issues。"""
+    decl = _report_severities(text)
+    return sum(1 for v in decl[1:] if v != "clean")
