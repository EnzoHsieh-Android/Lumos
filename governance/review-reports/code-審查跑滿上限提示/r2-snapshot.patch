+def _report_findings_missing_severity(lines, top):
+    """★檔首判成非 clean 時,發現段的數量不能多過 severity 行★(2026-09-25:一份 F1、F2 都漏寫的報告在收貨偵測被說成
+    已正規化,到記帳時才因「報了幾條」對不上被擋)。缺的不補值(不能替審查席決定等級),只回給呼叫端印出來要人改。
+    ★只數數量、不分析標題結構★(代碼審三輪、Enzo 裁甲:逐段找範圍的做法每輪都被標題寫法的邊界打穿——子標題、
+    層級錯位、一字不差的兩個標題、縮排、F1.1 編號子標題——而且每輪的洞都是上一輪修正帶進來的)。記帳時「報了幾條」
+    也是數 severity 行,兩邊同一種數法。
+    ★天花板★:指不出是哪一條漏寫;某條寫了兩行、另一條沒寫時數量對得上會漏看。
+    不算發現段的:clean 報告、標題寫明已驗過/沒問題/已看,無 的段、F 後面接小數點的編號子標題(F1.1)。"""
+    if top not in ("minor", "major", "blocker"):
+        return []
+    heads = [(no, ln) for no, ln in _visible_lines(lines, keep_fenced=False)
+             if re.match(r"^\s{0,3}#{2,6}\s*F\d+(?![.\d])", ln, re.I)
+             and not any(w in ln for w in _FINDING_VERIFIED_WORDS)]
+    n_sev = len(_report_severities("\n".join(lines))) - 1   # 扣掉檔首那一行
+    if len(heads) <= n_sev:
+        return []
+    return [(heads[0][0], f"有 {len(heads)} 個發現段、卻只有 {n_sev} 行 severity: <值>——有發現漏寫等級"
+                          "(檔首判成非 clean 時每個 F 段都要有自己一行;要請審查席自己補)", heads[0][1])]
+
