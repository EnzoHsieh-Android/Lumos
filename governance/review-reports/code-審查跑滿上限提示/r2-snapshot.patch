+def cmd_report_normalize(path, write=False):
+    """`lumos report-normalize <席報告.md> [--write]`:收貨正規化的機械那一半。不帶 --write 只印會改什麼與還剩什麼;帶了才原子覆寫。
+    vault-free(跟 fold-check/prose-lint/quote-check 同層:只吃一個 markdown 路徑,不碰圖譜;r1 架構席 a1——原本接在 canary 那組後面,沒圖譜的 repo 跑不了)。
+    rc:0=已正規化或改完沒殘留;1=改完仍有殘留(印行號,要人改);2=檔讀不到。"""
+    try:
+        text = Path(path).read_text(encoding="utf-8", errors="replace")
+    except OSError as e:
+        print(f"擋下:讀不到 {path}({e})", file=sys.stderr)
+        return 2
+    new, changed, issues = normalize_report_text(text)
+    if changed == 0 and not issues:
+        print(f"✓ {path} 已是正規化格式(檔級行在檔首、每條 finding 一行 severity),不用改")
+        return 0
+    if write and new != text:
+        _write_lf(Path(path), new)
+        print(f"✓ 改了 {changed} 處並寫回 {path}")
+    else:
+        print(f"會改 {changed} 處(加 --write 才寫回):")
+        import difflib
+        for d in list(difflib.unified_diff(text.splitlines(), new.splitlines(), lineterm="", n=0))[2:40]:
+            print("    " + d)
+    if issues:
+        print(f"⚠ 還有 {len(issues)} 處機器轉不了,要人改(不然 canary record 會擋):")
+        for no, why, ln in issues[:10]:
+            print(f"    第 {no} 行:{why}\n      {ln[:100]}")
+        return 1
+    return 0
+
