+def _intake_declared(text):
+    """intake守衛 T1(2026-08-30 d1):intake 檔的前掃宣告行判定。
+    規則(r2/r3 折入):①先剝 fenced 圍欄(```…```)再掃——同款行首 fullmatch 對圍欄內
+    頂格示例照計,模板照抄即偽造(r2 b-F6 實測)②行首錨定 fullmatch `preflight-4: ran`,
+    值域封閉單值 ③同檔多條宣告行=格式壞,視同無(fail-closed;後果只是 T2 的 ⚠,不擋)。
+    回傳 True=有且僅有一條合法宣告行。"""
+    import re as _re
+    # ★走全檔唯一那支剝圍欄實作★(2026-09-16 同族掃描):原本這裡自己寫了一個
+    # ```…``` 的正則,而那支共用函式的說明白紙黑字寫著「所有人都必須走這裡」——
+    # 自己寫的正則有兩個致命假設(圍欄一定成對、標記一定在第 0 欄)。實測兩種形狀
+    # 兩邊答案相反:①外層四個反引號、內層三個反引號 ②波浪號圍欄。
+    # 兩種都讓「把樣板原樣貼進圍欄裡」被算成真的跑過前掃,正是這支判定自己
+    # 宣稱要防的「模板照抄即偽造」。
+    hits = [ln for _no, ln in _visible_lines(text.split("\n"))
+            if ln.startswith("preflight-4:")]
+    if len(hits) != 1:
+        return False
+    return _re.fullmatch(r"preflight-4:[ \t]*ran[ \t]*", hits[0]) is not None
