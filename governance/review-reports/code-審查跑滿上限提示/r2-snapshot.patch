+_SEV_INLINE_DECL_RE = re.compile(r"^(\s*(?:[-*+]\s*)?(?:\*\*)?)(?:severity|Severity|嚴重度)(?:\*\*)?\s*[:：]\s*(clean|minor|major|blocker)\b\s*(.*)$")
+_SEV_HEADING_DECL_RE = re.compile(r"^(\s*#{1,6}\s.*?)\s*[—–-]{1,2}\s*(?:severity\s*[:：]\s*)?(blocker|major|minor|clean)\b\s*[,，;；]?\s*(.*)$", re.I)
