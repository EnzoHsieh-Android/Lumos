+def _report_normalize_issues(text):
+    """[審查有沒有用記帳 S1] 席報告「有沒有正規化」的★拒收偵測★(只用來拒、不用來數;數一律走 _report_severities):
+    ①檔首(跳過開頭 HTML 註解與空行)第一個非空行必須是檔級獨立宣告 `severity: <值>`;
+    ②其餘可見行(圍欄內不看)若含 severity/嚴重度/方括號等級字樣、卻不是 _report_severities 認得的獨立宣告行 → 殘留寫法;
+      引句行(引句:/引句:/> 開頭)不算——那是逐字引審材。
+    回 list[(行號, 原因, 行)];空=正規化過。r1–r3 五席各拿一種真實格式證明「放過就少算」,所以認不得就擋、不列舉例外。"""
+    text = text.lstrip("\ufeff")   # BOM 不算內容(codex r1 f4:帶 BOM 的外部報告會被永久誤擋、normalizer 也修不了)
+    lines = text.splitlines()
+    issues = []
+    i = 0
+    while i < len(lines) and not lines[i].strip():
+        i += 1
+    _mt = _SEV_DECL_LINE_RE.fullmatch(lines[i]) if i < len(lines) else None
+    _top = _mt.group(1) if _mt else None   # 檔級宣告的值;總結句豁免要拿它對
+    # ★不跳 HTML 註解★(r3 架構席:專案三處明令不偵測註解;來源註記寫在檔級行之後)
+    if _top is None:
+        issues.append((i + 1 if i < len(lines) else 1, "檔首第一個非空行要是檔級 severity: <clean|minor|major|blocker>(來源註記之類放它後面)", lines[i] if i < len(lines) else ""))
+    for no, ln in _visible_lines(lines, keep_fenced=False):
+        s = ln.lstrip()
+        if s.startswith(("引句:", "引句：", ">")):
+            continue
+        if _SEV_DECL_LINE_RE.fullmatch(ln):
+            continue
+        if _SEV_SUMMARY_LINE_RE.search(ln):
+            # 總結句豁免有條件(code-review-yield r1 外家席 f1):提到的等級不得高於檔級宣告——「severity: clean / 總結: severity: blocker」
+            # 就是拿白名單夾帶 blocker 又數成 0 條;檔級行缺(_top None)一律不豁免
+            # 「其中 major 0 條」是在數零條,不是宣告等級(架構對齊席範本必寫這句;2026-09-10 code-工具自裝檔不算消費專案 r2
+            # 檔級 minor 的架構席報告因此被擋)。只剝「等級字後面緊接 0 條」這種計數;非零、或 0 後面不是「條」
+            # (「blocker 0 台」數的是台數,r3 正確性席)照樣算夾帶
+            _vis_lv = re.sub(r"(?i)\b(?:clean|minor|major|blocker)\b\s*[:：]?\s*0\s*條", "", _strip_inline_markup(ln)[0])
+            _lv = [w.lower() for w in re.findall(r"(?i)\b(clean|minor|major|blocker)\b", _vis_lv)]
+            if _top is not None and all(_SEV_ORDER[w] <= _SEV_ORDER[_top] for w in _lv):
+                continue
+            if _lv:
+                issues.append((no, f"總結句提到的等級({'/'.join(_lv)})高於檔級宣告({_top or '缺'})——總結句只能重述,不能藏更高的等級", ln))
+                continue
+        vis = _strip_inline_markup(ln)[0]   # 反引號裡的是在「講」格式(`- severity: X`),不是在宣告——沿用行內可見規則
+        if _SEV_RESIDUE_RE.search(vis) or _SEV_HEADING_LEVEL_RE.match(vis):
+            issues.append((no, "嚴重度要寫成獨立一行 severity: <值>(不是列表項、標題、粗體、方括號、破折號或別的拼法)", ln))
+    issues.extend(_report_findings_missing_severity(lines, _top))
+    return issues
