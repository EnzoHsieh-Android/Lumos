+def normalize_report_text(text):
+    """[審查有沒有用記帳 S1/S4] 把席報告常見的嚴重度寫法機械轉成 SOP 格式(獨立一行 severity: <值>),回 (新文字, 改了幾處, 還剩的殘留清單)。
+    做的事只有三種、都是純格式:①行內/列表/粗體的 `severity: X ...` → 一行 `severity: X` + 其餘文字另起一行;
+    ②標題裡嵌等級(`### F1 —— severity: blocker,blocking: 是` / `## F1 — BLOCKER`)→ 標題保留、下一行插 `severity: x`;
+    ③第一個宣告不在檔首 → 檔首插一行檔級宣告(值=所有宣告裡最高的;原本就有檔級行則不動)。
+    ★不碰內容、不改 severity 值、不動引句/圍欄★;轉不了的原樣留下,由 _report_normalize_issues 印給人改。"""
+    if text.startswith("\ufeff"):
+        text = text[1:]; changed_bom = 1   # codex r1 f4:BOM 剝掉算一處修改
+    else:
+        changed_bom = 0
+    lines = text.splitlines()
+    out, changed = [], changed_bom
+    fence = None
+    for ln in lines:
+        s = ln.lstrip(" ")
+        if s.startswith(("```", "~~~")) and len(ln) - len(s) <= 3:
+            ch = s[0]; run = len(s) - len(s.lstrip(ch))
+            if fence is None: fence = (ch, run)
+            elif ch == fence[0] and run >= fence[1]: fence = None
+            out.append(ln); continue
+        if fence is not None or s.startswith(("引句:", "引句：", ">")) or _SEV_DECL_LINE_RE.fullmatch(ln):
+            out.append(ln); continue
+        if _SEV_SUMMARY_LINE_RE.search(ln):
+            out.append(ln); continue
+        m = _SEV_INLINE_DECL_RE.match(ln)
+        if m and "`" in ln[:m.start(2)]:
+            m = None   # 反引號裡的是在講格式,不轉
+        if m:
+            out.append(f"severity: {m.group(2).lower()}")
+            rest = m.group(3).strip().lstrip("/／|,，;；").strip()
+            if rest:
+                out.append(rest)
+            changed += 1
+            continue
+        m = _SEV_HEADING_DECL_RE.match(ln)
+        if m:
+            out.append(m.group(1).rstrip())
+            out.append(f"severity: {m.group(2).lower()}")
+            rest = m.group(3).strip()
+            if rest:
+                out.append(rest)
+            changed += 1
+            continue
+        out.append(ln)
+    decl = _report_severities("\n".join(out))
+    i = 0
+    while i < len(out) and not out[i].strip():
+        i += 1
+    if decl and not (i < len(out) and _SEV_DECL_LINE_RE.fullmatch(out[i])):
+        top = max(decl, key=lambda v: _SEV_ORDER[v])
+        out.insert(i, f"severity: {top}")
+        changed += 1
+    new = "\n".join(out) + ("\n" if text.endswith("\n") else "")
+    return new, changed, _report_normalize_issues(new)
+
