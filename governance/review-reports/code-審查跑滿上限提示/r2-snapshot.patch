+_SEV_DECL_LINE_RE = re.compile(r"severity:[ \t]*(clean|minor|major|blocker)[ \t]*")   # ★獨立宣告行的唯一定義★(code-review-yield r1 架構席 a2:原本逐字複製了五處,值域改一字要改五處)
