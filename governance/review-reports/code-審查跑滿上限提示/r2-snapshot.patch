+_SEV_RESIDUE_RE = re.compile(r"(?i)(?:\bsev(?:erity)?(?:\*\*|__)?\s*[:：]|嚴重度(?:\*\*|__)?\s*[:：]|\[(?:clean|minor|major|blocker)\]|[—–-]\s*(?:BLOCKER|MAJOR|MINOR)\b(?=\s*(?:$|[:：,，;；/|(（—–-])))")   # (?:\*\*|__)? = 粗體只包字不包冒號(**severity**: major);破折號型只在等級字後面接結尾或分隔符才算——「- minor 問題:…」「non-major 的調整」是散文(code-review-yield r1 f1),「- major / blocking: 是」「- MAJOR」才是殘留
+_SEV_HEADING_LEVEL_RE = re.compile(r"(?i)^\s*#{1,6}\s.*[—–:：-]\s*(?:blocker|major|minor)\b")   # 標題裡嵌等級(## F1 — BLOCKER / ## f1: major):r3 通才席拿 code-batch20 真報告證明會被放過;標題散文裡提到 major 這個字不算
+_SEV_SUMMARY_LINE_RE = re.compile(r"^\s*(?:#{1,6}\s*|[-*+>]\s*|\d+[.)]\s*)?(?:\*\*|__)?\s*(最嚴重|最高|整份|總結|不對齊共|blocking 條數)")
+# ↑ 總結句照 SOP 本來就要寫 severity 字樣,不算殘留。★只認行首★(可帶標題/清單/引用/編號/粗體記號;2026-09-10 code 迴圈 r3):
+#   原本整行任何位置出現「最高/總結/整份」就當總結句,內文講到「總結句」這條規則、或用到「最高並發」這種詞,
+#   又碰巧提到比檔級高的等級,就被誤擋。不在行首的行照一般規則檢查(帶 severity: 的照樣算殘留)。
