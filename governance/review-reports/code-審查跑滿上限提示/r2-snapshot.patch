+def _report_severities(text):
+    """[嚴重度綁定機械掃 S1] 報告檔 severity 宣告的★單一 parse 實作★(寫側+severity-check 共用)。
+    逐行 fullmatch、空白只認水平空白(反斜線s 會吞換行讓標籤與值跨行黏上,r2 ext);
+    行首錨定天生排掉引句行(以標籤起頭)與 blockquote(以 > 起頭)兩型逃逸(r1 s1/s2);
+    大小寫、全形冒號、行首雜字一律不認(fixture 釘)。回 list[str](出現序)。"""
+    out = []
+    text = text.lstrip("\ufeff")   # BOM 不算內容(codex r1 f4)
+    # 圍欄內不算(2026-09-09,審查有沒有用記帳 S1):reported 由這支數、拒收偵測走 _visible_lines 不看圍欄,
+    # 兩邊可見性要同一套——不然席位在 ``` 裡示範一行 severity: blocker 會灌進 reported 與帳面下限。
+    for _no, line in _visible_lines(text.splitlines(), keep_fenced=False):
+        m = _SEV_DECL_LINE_RE.fullmatch(line)
+        if m:
+            out.append(m.group(1))
+    return out
+
