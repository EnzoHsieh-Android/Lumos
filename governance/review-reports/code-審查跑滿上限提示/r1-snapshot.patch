+def _cap_vault(rows):
+    import json as _j
+    v = mkvault()
+    (v.parent / ".canary-log.jsonl").write_text("".join(_j.dumps(r, ensure_ascii=False) + "\n" for r in rows), encoding="utf-8")
+    spec = v.parent / "cap-spec.md"
+    spec.write_text("規則甲:照字面實作要對,十個字以上。\n", encoding="utf-8")
+    return v, spec
