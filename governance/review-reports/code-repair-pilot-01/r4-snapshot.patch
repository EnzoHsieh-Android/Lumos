++++    mostly = [q for q, (t, k) in per.items() if k > 1 and t * 2 > k]
++++    line = f"{p}/{n} 個情境 Claude 自己敲對了 lumos 指令" + (f"(組別 {arm})" if arm != "with" else "")
++++    parts = [f"{name} {k}" for name, k in (("截斷", n_trunc), ("用量上限", n_limit), ("其他儀器例外", n_other)) if k]
++++    if parts:
++++        line += ";不算分:" + "、".join(parts)
++++    if inconclusive:
