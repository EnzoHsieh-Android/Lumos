+def _c6_ln(path, marker):
+    """那篇裡第一個含 marker 的行號(1 起算);找不到回 0。"""
+    for i, l in enumerate(path.read_text(encoding="utf-8").split("\n"), 1):
+        if marker in l:
+            return i
+    return 0
+
