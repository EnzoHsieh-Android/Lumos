     import time as _t
     deadline = _t.monotonic() + budget
     for _ in range(tries):
         if _t.monotonic() + pause > deadline:
             break
         _t.sleep(pause)
         try:
             if check():
                 return True
         except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired):
             pass
     return False
 
 
