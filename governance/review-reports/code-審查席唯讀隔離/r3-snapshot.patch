+// (代碼審 r1:原本測試只測 spawnFields,把接線改回 e.agentId 照綠)
+export function spawnEvent(e: any, r: any): [string | null, string, Record<string, unknown>] {
+  const f = spawnFields(e, r)
+  return [f.agent, 'spawn', f.extra]
+}
