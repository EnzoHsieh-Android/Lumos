+        o = r.stdout + r.stderr
+        sec = o[o.find("[1/4]"):o.find("[1.5/4]")]
+        outs.add(tuple(l.strip() for l in sec.splitlines() if "↳" in l))
+    one = next(iter(outs))
+    check("①五項全列、不說較弱線索", sum("↳ 推薦" in l for l in one) == 5 and not any("較弱線索" in l for l in one), str(one))
