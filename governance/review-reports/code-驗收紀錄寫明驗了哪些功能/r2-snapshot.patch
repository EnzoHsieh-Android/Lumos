+
+def sp_run_env(vault, extra_env, *args):
+    import subprocess as sp
+    e = dict(_os_k2.environ)
+    e.update(extra_env)
+    return sp.run([sys.executable, GRAPHCTL, "--vault", str(vault), *args], capture_output=True, text=True, env=e)
