+++        "id": cid,
+++        "group": group,
+++        "split": ev.split_for(group),
+++        "loop": "code-example",
+++        "finding": "r2:F1",
+++        "start_commit": B,
+++        "case_sha256": H,
+++        "grader_sha256": H,
+++        "environment_sha256": H,
+++    }
