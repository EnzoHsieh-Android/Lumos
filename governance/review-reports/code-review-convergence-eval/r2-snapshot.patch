+            x = ev.compare(m, rs, root)
+            self.assertEqual(x["missing_slots"], 3)
+            self.assertIsNone(x["quality_delta"])
+            self.assertEqual(x["expected_trials"], 4)
+            rs += [
+                receipt(root, m, "candidate", 1, rounds=1),
