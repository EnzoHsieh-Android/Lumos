+def _plan_sources_uncomment(text):
+    """把 HTML 註解 <!-- … --> 換成空白(行數不變),圍欄裡的行原樣留著;註解沒關到就蓋到檔尾。
+    〈依據來源〉找節之前先過這一支:渲染後看不到的表不算(代碼審 r1 邊界席 F2)。只給這一節用,不動全檔共用的 _visible_lines
+    (它刻意不偵測 HTML 註解,見 _fence_regions)。"""
+    lines = _note_lines(text)
+    vis = {no for no, _ln in _visible_lines(lines)}
+    out, inside = [], False
+    for no, ln in enumerate(lines, 1):
+        if no not in vis:
+            out.append(ln)
+            continue
+        spans = [m.span() for m in _PLAN_SRC_CODE_SPAN_RE.finditer(ln)]   # 行內程式碼裡的 <!-- 不是註解(CommonMark)
+        buf, pos = [], 0
+        while pos < len(ln):
+            if inside:
+                j = ln.find("-->", pos)
+                if j < 0:
+                    break
+                inside, pos = False, j + 3
+            else:
+                j = ln.find("<!--", pos)
+                while j >= 0 and any(a <= j < b for a, b in spans):
+                    j = ln.find("<!--", j + 1)
+                if j < 0:
+                    buf.append(ln[pos:])
+                    break
+                buf.append(ln[pos:j])
+                inside, pos = True, j + 4
+        out.append("".join(buf))
+    return "\n".join(out)
