+def _plan_first_days_batch(rr, vrel):
+    """一次 git log 掃 <圖譜>/Projects,拿每支檔第一次進 git 歷史的日期 {圖譜內相對路徑: YYYY-MM-DD}(健檢用,免得逐篇呼叫 git)。
+    規則同 _plan_first_day:取提交日期、改名跟得過去(-M,依時間順序把舊路徑的日期接給新路徑)、複製不跟;淺複製或讀不到回 None(呼叫端只看 created)。"""
+    try:
+        sh = subprocess.run(["git", "-C", str(rr), "rev-parse", "--is-shallow-repository"], capture_output=True, text=True,
+                            errors="replace", timeout=20)
+        if not (sh.returncode == 0 and sh.stdout.strip() == "false"):
+            return None
+        r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "log", "--reverse", "-M", "--diff-filter=AR",
+                            "--name-status", "--format=%x01%cs", "--", f"{vrel}/Projects" if vrel else "Projects"],
+                           capture_output=True, text=True, errors="replace", timeout=60)
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    if r.returncode != 0:
+        return None
+    first, day, pre = {}, None, (vrel + "/") if vrel else ""
+    for ln in r.stdout.splitlines():
+        if ln.startswith("\x01"):
+            day = ln[1:].strip()
+            continue
+        parts = ln.split("\t")
+        if not day or not _DAY_RE.fullmatch(day) or len(parts) < 2:
+            continue
+        if parts[0] == "A":
+            first.setdefault(parts[1], day)
+        elif parts[0].startswith("R") and len(parts) >= 3:
+            first.setdefault(parts[2], first.get(parts[1], day))
+    return {k[len(pre):]: v for k, v in first.items() if k.startswith(pre)}
+
