     m = _REPO_REF_LINE_RE.fullmatch(str(line or "").strip())
     if m is None or n is None:
         return None
     lo, hi = int(m.group(1)), int(m.group(2) or m.group(1))
     return (lo, hi) if 1 <= lo <= hi <= n else None
 
 
