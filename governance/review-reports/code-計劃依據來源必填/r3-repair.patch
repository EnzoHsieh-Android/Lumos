+def _psrc_count_git(m, fn):
+    """跑 fn(),回 (結果, 這段時間開了幾次 subprocess.run);m.subprocess 與 _git_tree_* 裡 import 的是同一個模組物件。"""
+    calls = [0]
+    orig = m.subprocess.run
+
+    def counted(*a, **k):
+        calls[0] += 1
+        return orig(*a, **k)
+    m.subprocess.run = counted
+    try:
+        got = fn()
+    finally:
+        m.subprocess.run = orig
+    return got, calls[0]
