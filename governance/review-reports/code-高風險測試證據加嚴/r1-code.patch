+def _plan_first_day(rr, plan_repo_rel, hops=20):
+    """計劃第一次進 git 歷史的日期(YYYY-MM-DD),改名、搬目錄跟得過去;讀不到回 None。
+    ★不用 `git log --follow`★:它連「複製」一起追,拿舊計劃複製一份來寫新計劃時,新計劃會被追到舊計劃的日期而漏查(實作時測試現場實測 C097)。
+    改成只追改名:找這條路徑第一次新增的提交(同 _plan_first_commit 的 --diff-filter=A),再用 diff-tree -M(只開改名偵測)看那個提交是不是把別的檔改名過來,
+    是就換成舊路徑再找;最多 hops 跳。每次 git 逾時 20 秒,逾時當讀不到。"""
+    cur, day = plan_repo_rel, None
+    for _ in range(hops):
+        try:
+            r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "log", "--diff-filter=A", "--format=%H %cs", "--", cur],
+                               capture_output=True, text=True, errors="replace", timeout=20)
+        except (OSError, subprocess.TimeoutExpired):
+            return day
+        got = [x.split() for x in r.stdout.splitlines() if x.strip()] if r.returncode == 0 else []
+        if not got or len(got[-1]) != 2 or not _DAY_RE.fullmatch(got[-1][1]):
+            return day
+        sha, day = got[-1]
+        try:
+            t = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "diff-tree", "--no-commit-id", "--root", "-r", "-M", "--name-status", "-z", sha],
+                               capture_output=True, timeout=20)
+        except (OSError, subprocess.TimeoutExpired):
+            return day
+        codes = {}
+        _paths, src, _gone = _nodehome_name_status(t.stdout if t.returncode == 0 else b"", norm=False, codes=codes)
+        prev = src.get(cur)
+        if prev is None or codes.get(cur) != "R":
+            return day
+        cur = prev
+    return day
+
