+def _expected_split_cells(line):
+    """表格列拆格(GFM:格內 `\\|` 是字面管線、`\\\\` 是字面反斜線,其他反斜線照留);切完第一格與最後一格去空白後是空的就丟掉(外側管線),只丟這兩格。
+    ★這支是嚴格版★:為了表指紋穩定;專案另外兩處 `strip("|").split("|")` 的寬鬆拆法用途不同(讀報告、讀別人的表),不改。"""
+    cells, buf, i = [], [], 0
+    while i < len(line):
+        ch = line[i]
+        if ch == "\\" and i + 1 < len(line) and line[i + 1] in "\\|":
+            buf.append(line[i + 1])
+            i += 2
+            continue
+        if ch == "|":
+            cells.append("".join(buf))
+            buf = []
+        else:
+            buf.append(ch)
+        i += 1
+    cells.append("".join(buf))
+    if cells and not cells[0].strip():
+        cells = cells[1:]
+    if cells and not cells[-1].strip():
+        cells = cells[:-1]
+    return cells
