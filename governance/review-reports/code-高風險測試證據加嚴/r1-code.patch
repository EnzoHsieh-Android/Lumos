+def _plan_effective_day(rr, plan_repo_rel, created):
+    """計劃的日期:開頭欄位 created 與第一次進 git 歷史的日期(_plan_first_day,改名跟得過去)取較晚者;兩個都讀不到回 None(呼叫端當生效日之後)。
+    淺複製只看 created(設計審 r5 邊界席、決策 d11)。"""
+    days = []
+    c = str(created or "").strip()[:10]
+    if _DAY_RE.fullmatch(c):
+        days.append(c)
+    try:
+        sh = subprocess.run(["git", "-C", str(rr), "rev-parse", "--is-shallow-repository"], capture_output=True, text=True,
+                            errors="replace", timeout=20)
+        shallow = not (sh.returncode == 0 and sh.stdout.strip() == "false")
+    except (OSError, subprocess.TimeoutExpired):
+        shallow = True
+    if not shallow:
+        g = _plan_first_day(rr, plan_repo_rel)
+        if g:
+            days.append(g)
+    return max(days) if days else None
