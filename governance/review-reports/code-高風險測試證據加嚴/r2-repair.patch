++def _hre_signoff(kg, answer=None, extra=()):
++    """跑 lumos signoff --expected:answer=None → 沒有終端(記 AI);answer=b"y\\n"/b"n\\n" → 虛擬終端預先餵答案。"""
++    import os
++    env = dict(_os_mod.environ, LUMOS_TTY="/nonexistent-tty", LUMOS_TTY_TIMEOUT="2")
++    master = slave = None
