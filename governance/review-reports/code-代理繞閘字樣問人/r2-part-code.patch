+# https://github.com/EnzoHsieh-Android/Lumos
+"""PreToolUse hook(matcher Bash):代理要繞過 Lumos 的閘時,先問人。
+
+單源:Projects/代理繞閘字樣問人_計劃(d1 厚掛鉤偏離、d2 寧可漏問)。
+
+流程:
+  1. 讀一次 stdin 原文 → 便宜的預篩(在 guard 之外,不跑子程序、不記事件;絕大多數 Bash 停在這)。
+  2. 過了預篩才進 `_hookevent.guard`:解析事件 → `decide` → 命中就印 permissionDecision "ask"。
+  3. 任何例外都放行(這是問人層,不是安全邊界)。
+
+★存活事件只記「活著沒」★:不記問了幾次(_hookevent.py 檔頭的界線);事後量測拿 Claude 事件帳
+重跑 `bypass_reasons`。
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import shlex
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+try:
+    from _hookevent import guard as _guard, mark
+except Exception:          # 共用模組缺席也不能讓 Bash 卡住
+    _guard = None
+
+    def mark(kind, note=""):
+        return None
+
+
+# ── 逾時預算(逐字複本,見 impact-hook.py;有測試要求各份一模一樣)──────
+#
+# 天花板由註冊表 HOOK_BUDGET 一處生成,用 --budget 傳進來;這支只拿它當查遠端、查工作樹的 git 子程序逾時。
+_BUDGET_RATIO = 0.7
+_BUDGET_FLOOR = 1.0          # 再怎麼扣也留 1 秒,不要算出 0 或負數
+_BUDGET_START = None         # 這支 hook 開始跑的時刻(第一次用到時記)
+
+
+def _outer_budget(default=10.0):
+    """從 argv 讀 --budget <秒>;沒有就回 default(保守值,不是猜大的)。
+    ★上限夾住★:異常大的值會讓內層跟著失控放大,等於整個 fail-open 形同虛設。"""
+    import sys as _s
+    argv = _s.argv
+    got = None
+    for i, a in enumerate(argv):
+        if a == "--budget" and i + 1 < len(argv):
+            try:
+                got = float(argv[i + 1])
+            except ValueError:
+                got = None
+            break
+        if a.startswith("--budget="):
+            try:
+                got = float(a.split("=", 1)[1])
+            except ValueError:
+                got = None
+            break
+    if got is None or got <= 0:
+        got = default
+    return min(float(got), 600.0)
+
+
+def _inner_budget(elapsed=None, default=10.0):
+    """內層某一段還能用幾秒:天花板 × 0.7 − 這支 hook 到目前為止已經花掉的時間,下限 1 秒。
+
+    ★已耗時間自己算,不靠呼叫端記得傳★(2026-09-07 代碼審 r1 通才席抓到):
+    第一版的 elapsed 預設 0,而六個呼叫點裡只有一個真的傳了值——於是同一支 hook
+    只要依序呼叫兩次,理論上限就是 2 × 0.7 × 外層 = 1.4 倍外層,**結構性地超過天花板**。
+    實測:進場提醒那支 7+7=14 秒 vs 外層 10;CI 狀態那支 10.5+10.5=21 秒 vs 外層 15。
+    ★這正是這批改動宣稱要修掉的問題,只是換個地方重新發生。★
+
+    ★★這是「還剩多少」不是「每段配額」★★——很容易誤解,所以講清楚:
+    回傳的是「從現在到預算用完還有幾秒」。所以連續呼叫兩次拿到的兩個數字**不該相加**:
+    第一次拿到 7 秒、真的用掉 5 秒之後,第二次會拿到 2 秒。
+    只有在「第一段其實沒用多久」時第二次才會拿到接近 7 秒——那也是對的,因為時間真的還在。
+    ★守衛要驗的是「真的用掉時間之後,下一次拿到的會變少,而且總和不超過天花板」★,
+    不是「兩次的數字相加小於天花板」(那個判準本身就錯,會逼出錯誤的修法)。
+
+    ★誠實邊界★:天花板小於約 1.43 秒時,下限 1 秒會反過來大於外層。目前註冊表最小值是 10,
+    離這個門檻很遠;真要調到那麼小的話這個假設就不成立了。
+    """
+    import time as _tm
+    global _BUDGET_START
+    if _BUDGET_START is None:
+        _BUDGET_START = _tm.monotonic()
+    used = (_tm.monotonic() - _BUDGET_START) if elapsed is None else float(elapsed)
+    return max(_BUDGET_FLOOR, _outer_budget(default) * _BUDGET_RATIO - used)
+# ── ★逾時預算結束★ ──────────────────────────────────────────────────
+
+MAX_LEN = 20000                     # 超過就不做結構分類,走字面判(把要掃的字數壓在幾萬步以內)
+MAX_GIT_CALLS = 4                   # 一次判斷最多跑幾個 git 子程序;超過就當「查不到」(=不豁免、照問)
+_PRE_WORDS = ("--no-veri", "hookspath", "lumos_skip_")
+_PRE_SHORT_N = re.compile(r"(?<![\w-])-[a-z]*n[a-z]*\b")
+_ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*\+?=")
+_SKIP_ASSIGN = re.compile(r"^LUMOS_SKIP_[A-Za-z0-9_]*\+?=")
+_GITDIR_ASSIGN = re.compile(r"^(GIT_DIR|GIT_WORK_TREE|GIT_COMMON_DIR)=")
+_CFG_ENV_ASSIGN = re.compile(r"^GIT_CONFIG_(KEY_[0-9]+|PARAMETERS)=(.*)$", re.S)
+_KEYWORDS = {"if", "then", "else", "elif", "do", "while", "until", "!", "{", "}", "time", "exec", "command", "nohup", "builtin"}
+_HOOK_SUBS = ("commit", "push", "merge", "rebase", "am", "cherry-pick", "revert")
+_GIT_VALUE_OPTS = {"-c", "-C", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env"}
+_GIT_DIR_OPTS = ("--git-dir", "--work-tree")
+_COMMIT_VALUE_LONG = {"--message", "--file", "--author", "--date", "--template", "--reuse-message", "--reedit-message",
+                      "--fixup", "--squash", "--cleanup", "--trailer", "--pathspec-from-file"}
+_PUSH_VALUE_OPTS = {"-o", "--push-option", "--repo", "--receive-pack", "--exec"}
+_CONFIG_VALUE_OPTS = {"-f", "--file", "--blob", "--default", "--type", "--comment"}
+_CONFIG_WRITE_FLAGS = {"--unset", "--unset-all", "--replace-all", "--add"}
+_CONFIG_READ_FLAGS = {"--get", "--get-all", "--get-regexp", "--list", "-l", "--get-urlmatch"}
+_CONFIG_GLOBAL_FLAGS = {"--global", "--system", "--file", "-f", "--blob"}
+_UNKNOWN = ("unknown",)
+_MKTEMP = ("mktemp",)
+_MASK_CHARS = "();|&<>\n#`"         # 引號裡的這些字元先換成私用區字元,切詞時才不會被當成結構
+_MASK_BASE = 0xE000
+_REASON_TEXT = {
+    "no-verify": "推送、提交或合併帶了 --no-verify,推送前閘與提交前閘不會跑",
+    "commit-n": "提交帶了 -n(就是 --no-verify),提交前閘不會跑",
+    "c-hookspath": "用 -c、--config-env 或 GIT_CONFIG_* 把這次的掛鉤目錄換掉,Lumos 的閘不會跑",
+    "config-hookspath": "改寫或拆掉 core.hooksPath,之後每次提交與推送都不再經過 Lumos 的閘",
+    "lumos-skip": "設了 LUMOS_SKIP_* 環境變數,會關掉 Lumos 的一道閘",
+    "literal": "指令切不開或太長,照字面看是在跳過 Lumos 的閘",
+}
+
+
+def _command_text(raw: str) -> str:
+    """stdin 原文 → 指令本身;解不開 JSON 就回原文(壞事件照樣交給後面記失敗)。"""
+    try:
+        ev = json.loads(raw)
+        cmd = ev.get("tool_input", {}).get("command") if isinstance(ev, dict) else None
+        return cmd if isinstance(cmd, str) else ""
+    except Exception:
+        return raw
+
+
+def prefilter(raw: str) -> bool:
+    """看解碼後的指令:三個字樣任一個,或同時有 git、commit 與含 n 的短旗標(續行與 Tab 不會擋住 -n)。"""
+    low = _command_text(raw).lower()
+    if any(w in low for w in _PRE_WORDS):
+        return True
+    return "git" in low and re.search(r"\bcommit\b", low) is not None and _PRE_SHORT_N.search(low) is not None
+
+
+def _temp_roots():
+    """暫存根:與審查席外掛的暫存根取聯集,再加上本機的暫存目錄(同 scripts/lumos 的做法,一律加)。"""
+    return ["/tmp", "/private/tmp", "/var/tmp", "/private/var/tmp", "/var/folders", "/private/var/folders",
+            tempfile.gettempdir()]
+
+
+def _under_temp(path: str) -> bool:
+    rp = os.path.realpath(path)
+    for root in _temp_roots():
+        rr = os.path.realpath(root).rstrip("/")
+        if rr and (rp == rr or rp.startswith(rr + "/")):
+            return True
+    return False
+
+
+# ── 前處理:續行、註解、heredoc、引號遮罩、指令替換 ─────────────────
+
+def _join_continuations(cmd: str) -> str:
+    """不在單引號裡的「反斜線加換行」換成空白。"""
+    out, i, sq, dq = [], 0, False, False
+    while i < len(cmd):
+        ch = cmd[i]
+        if ch == "\\" and not sq:
+            out.append(" " if cmd.startswith("\\\n", i) else cmd[i:i + 2])
+            i += 2
+            continue
+        if ch == "'" and not dq:
+            sq = not sq
+        elif ch == '"' and not sq:
+            dq = not dq
+        out.append(ch)
+        i += 1
+    return "".join(out)
+
+
+def _skip_arith(cmd: str, i: int) -> int:
+    """i 指在 `$((` 上;回傳配對的 `))` 之後的位置(算式裡不會有引號,直接數括號)。"""
+    depth, j = 0, i + 1
+    while j < len(cmd):
+        if cmd[j] == "(":
+            depth += 1
+        elif cmd[j] == ")":
+            depth -= 1
+            if depth == 0:
+                return j + 1
+        j += 1
+    return len(cmd)
+
+
+def _read_delim(cmd: str, i: int):
+    """從 i 讀 heredoc 結束字;回 (字, 新位置),讀不到回 ("", i)。"""
+    while i < len(cmd) and cmd[i] in " \t":
+        i += 1
+    word = []
+    while i < len(cmd) and cmd[i] not in " \t\n;&|<>()":
+        ch = cmd[i]
+        if ch in "'\"":
+            j = cmd.find(ch, i + 1)
+            if j == -1:
+                return "", i
+            word.append(cmd[i + 1:j])
+            i = j + 1
+        elif ch == "\\" and i + 1 < len(cmd):
+            word.append(cmd[i + 1])
+            i += 2
+        else:
+            word.append(ch)
+            i += 1
+    return "".join(word), i
+
+
+def _find_terminator(cmd: str, pos: int, word: str, dash: bool):
+    """從 pos 那一行起找獨佔一行的結束字(<<- 允許前置 Tab);回結束字那一行之後的位置,找不到回 None。"""
+    n = len(cmd)
+    while pos <= n:
+        k = cmd.find("\n", pos)
+        line = cmd[pos:k if k != -1 else n]
+        if (line.lstrip("\t") if dash else line) == word:
+            return k + 1 if k != -1 else n
+        if k == -1:
+            return None
+        pos = k + 1
+    return None
+
+
+def _ansi_end(cmd: str, i: int) -> int:
+    """i 指在 `$'` 上;回傳結尾單引號之後的位置(裡面的反斜線會跳脫下一個字)。"""
+    j = i + 2
+    while j < len(cmd):
+        if cmd[j] == "\\":
+            j += 2
+            continue
+        if cmd[j] == "'":
+            return j + 1
+        j += 1
+    return len(cmd)
+
+
+def _mask(ch: str) -> str:
+    k = _MASK_CHARS.find(ch)
+    return chr(_MASK_BASE + k) if k >= 0 else ch
+
+
+def _unmask(tok: str) -> str:
+    if not any(_MASK_BASE <= ord(c) < _MASK_BASE + len(_MASK_CHARS) for c in tok):
+        return tok
+    return "".join(_MASK_CHARS[ord(c) - _MASK_BASE] if _MASK_BASE <= ord(c) < _MASK_BASE + len(_MASK_CHARS) else c
+                   for c in tok)
+
+
+class _Normalizer:
+    """一趟掃過指令:追蹤引號(`$(` 裡重開一層)、拿掉註解與 heredoc 內文、引號裡的結構字元換成遮罩字元、
+    ANSI 引號換成佔位詞。heredoc 找不到結束字就停止剝(寧可多問),整趟是線性的。"""
+
+    def __init__(self, cmd: str):
+        self.cmd = cmd
+        self.out = []
+        self.ctx = [[False, False, 0]]       # 每層:[在單引號裡, 在雙引號裡, 這層 `$(` 裡的括號深度]
+        self.pending = []
+        self.heredoc_ok = True
+
+    def run(self) -> str:
+        i = 0
+        while i < len(self.cmd):
+            i = self.step(i)
+        return "".join(self.out)
+
+    def step(self, i: int) -> int:
+        cur = self.ctx[-1]
+        if cur[0]:
+            return self._in_single(i, cur)
+        ch = self.cmd[i]
+        if ch == "\\":
+            nxt = self.cmd[i + 1:i + 2]
+            self.out.append("\\" + (_mask(nxt) if cur[1] else nxt))
+            return i + 2
+        if self.cmd.startswith("$(", i) and not self.cmd.startswith("$((", i):
+            self.ctx.append([False, False, 0])
+            self.out.append("$(")
+            return i + 2
+        if cur[1]:
+            return self._in_double(i, cur, ch)
+        return self._bare(i, cur, ch)
+
+    def _in_single(self, i: int, cur) -> int:
+        ch = self.cmd[i]
+        if ch == "'":
+            cur[0] = False
+            self.out.append(ch)
+        else:
+            self.out.append(_mask(ch))
+        return i + 1
+
+    def _in_double(self, i: int, cur, ch: str) -> int:
+        if ch == '"':
+            cur[1] = False
+            self.out.append(ch)
+        else:
+            self.out.append(_mask(ch))
+        return i + 1
+
+    def _bare(self, i: int, cur, ch: str) -> int:
+        special = self._bare_special(i, cur, ch)
+        if special is not None:
+            return special
+        if ch == "'":
+            cur[0] = True
+        elif ch == '"':
+            cur[1] = True
+        self.out.append(ch)
+        return i + 1
+
+    def _bare_special(self, i: int, cur, ch: str):
+        """引號外的結構:算式、ANSI 引號、括號層、註解、heredoc、換行剝內文;都不是回 None。"""
+        cmd = self.cmd
+        if cmd.startswith("$((", i):
+            j = _skip_arith(cmd, i + 1)
+            self.out.append(cmd[i:j])
+            return j
+        if cmd.startswith("$'", i):
+            self.out.append("__LUMOS_ANSI__")
+            return _ansi_end(cmd, i)
+        if ch in "()" and len(self.ctx) > 1:
+            return self._paren(i, cur, ch)
+        if ch == "#" and (i == 0 or cmd[i - 1] in " \t\n;&|()"):
+            k = cmd.find("\n", i)
+            return len(cmd) if k == -1 else k
+        if self.heredoc_ok and cmd.startswith("<<", i) and not cmd.startswith("<<<", i) and (i == 0 or cmd[i - 1] != "<"):
+            return self._heredoc_op(i)
+        if ch == "\n" and self.pending:
+            return self._drop_bodies(i)
+        return None
+
+    def _paren(self, i: int, cur, ch: str) -> int:
+        if ch == "(":
+            cur[2] += 1
+        elif cur[2] == 0:
+            self.ctx.pop()
+        else:
+            cur[2] -= 1
+        self.out.append(ch)
+        return i + 1
+
+    def _heredoc_op(self, i: int):
+        dash = self.cmd.startswith("<<-", i)
+        word, k = _read_delim(self.cmd, i + 2 + int(dash))
+        if not word:
+            return None
+        self.pending.append((word, dash))
+        self.out.append(self.cmd[i:k])
+        return k
+
+    def _drop_bodies(self, i: int) -> int:
+        self.out.append("\n")
+        pos = i + 1
+        for word, dash in self.pending:
+            end = _find_terminator(self.cmd, pos, word, dash)
+            if end is None:
+                self.heredoc_ok = False      # 找不到結束字:這個與之後都不剝,也不再找(避免每行重掃到尾)
+                break
+            pos = end
+        self.pending = []
+        return pos
+
+
+def _match_paren(text: str, i: int) -> int:
+    """text[i] 是 '(';回配對 ')' 的位置,找不到回 -1(引號裡的括號已被遮罩,直接數)。"""
+    depth = 0
+    for j in range(i, len(text)):
+        if text[j] == "(":
+            depth += 1
+        elif text[j] == ")":
+            depth -= 1
+            if depth == 0:
+                return j
+    return -1
+
+
+def _replace_cmdsubs(text: str):
+    """$(…)、$((…))、反引號換成佔位詞;回 (新字串, {佔位詞: 是否 mktemp})。找不到配對的保留原樣。"""
+    out, subs, i = [], {}, 0
+    while i < len(text):
+        j, body = _cmdsub_span(text, i)
+        if j is None:
+            out.append(text[i])
+            i += 1
+            continue
+        key = "__LUMOS_CMDSUB_%d__" % len(subs)
+        subs[key] = _unmask(body).strip().split(" ")[0] == "mktemp"
+        out.append(key)
+        i = j
+    return "".join(out), subs
+
+
+def _cmdsub_span(text: str, i: int):
+    """位置 i 開始的指令替換 → (結束位置, 內文);不是或沒配對 → (None, "")。"""
+    if text.startswith("$(", i):
+        close = _match_paren(text, i + 1)
+        if close == -1:
+            return None, ""
+        body = text[i + 2:close]
+        return close + 1, ("" if body.startswith("(") else body)
+    if text[i] == "`":
+        close = text.find("`", i + 1)
+        if close == -1:
+            return None, ""
+        return close + 1, text[i + 1:close]
+    return None, ""
+
+
+class _Sep(str):
+    """切詞時就認定的分隔符(`;`、`&&`、`|`、換行、括號…)。引號裡還原回來的同樣字元是一般 str,不會被當成分隔。"""
+
+
+def _tokens(text: str):
+    lex = shlex.shlex(text, posix=True, punctuation_chars="();<>|&\n")
+    lex.whitespace = " \t\r"
+    lex.whitespace_split = True
+    lex.commenters = ""
+    return [_Sep(t) if _is_sep(t) else _unmask(t) for t in lex]
+
+
+def _is_sep(tok: str) -> bool:
+    return bool(tok) and all(c in "();|&\n" for c in tok)
+
+
+def _is_redirect(tok: str) -> bool:
+    return bool(tok) and all(c in "<>&|" for c in tok) and any(c in "<>" for c in tok)
+
+
+# ── 目錄與變數 ──────────────────────────────────────────────────────
+
+def _expand(word: str, variables: dict, subs: dict):
+    """展開同一條指令裡先賦值的變數;判不出回 _UNKNOWN,mktemp 新目錄(含不帶 .. 的子路徑)回 _MKTEMP。"""
+    if word in subs:
+        return _MKTEMP if subs[word] else _UNKNOWN
+    head = re.match(r"^\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?(/|$)", word)
+    if head and variables.get(head.group(1)) is _MKTEMP:
+        rest = word[head.end():]
+        return _UNKNOWN if ".." in rest.split("/") else _MKTEMP
+    if word.startswith("~") or "__LUMOS_CMDSUB_" in word:
+        return _UNKNOWN
+    names = re.findall(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)", word)
+    if any(not isinstance(variables.get(a or b), str) for a, b in names):
+        return _UNKNOWN
+    return re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)",
+                  lambda m: variables[m.group(1) or m.group(2)], word)
+
+
+def _join(base, rel):
+    if rel is _UNKNOWN or rel is _MKTEMP:
+        return rel
+    if rel.startswith("/"):
+        return os.path.normpath(rel)
+    if isinstance(base, str):
+        return os.path.normpath(os.path.join(base, rel))
+    return _UNKNOWN
+
+
+_GIT_STATE = {"calls": 0, "cache": {}}
+
+
+def _git_out(d: str, *args):
+    """在 d 跑 git;回 (rc, stdout),逾時、起不來、或這次判斷已跑滿 MAX_GIT_CALLS 次回 (None, "")。同樣的查詢只跑一次。"""
+    key = (d, *args)
+    if key in _GIT_STATE["cache"]:
+        return _GIT_STATE["cache"][key]
+    if _GIT_STATE["calls"] >= MAX_GIT_CALLS:
+        return None, ""
+    _GIT_STATE["calls"] += 1
+    try:
+        r = subprocess.run(["git", "-C", d, *args], capture_output=True, text=True,
+                           timeout=_inner_budget(default=5.0))
+        res = (r.returncode, r.stdout.strip())
+    except Exception:
+        res = (None, "")
+    _GIT_STATE["cache"][key] = res
+    return res
+
+
+def _within(path: str, roots) -> bool:
+    return any(path == c or path.startswith(c.rstrip("/") + "/") for c in roots)
+
+
+def _not_real_repo(eff, created) -> bool:
+    """生效目錄確定不是真 repo(拋棄式):mktemp 新目錄、同一條指令裡才建的暫存目錄、
+    或已存在而且共用 git 目錄也在暫存根底下(不在任何 repo 裡的也算)。"""
+    if eff is _MKTEMP:
+        return True
+    if not isinstance(eff, str) or not _under_temp(eff):
+        return False
+    if not os.path.exists(eff):
+        return _within(eff, created)     # 不存在又不是這條指令建的:cd 會失敗,git 跑在原目錄
+    rc, out = _git_out(eff, "rev-parse", "--git-common-dir")
+    if rc is None:
+        return False
+    if rc != 0:
+        return True          # 存在但不在任何 repo 裡:之後建的 repo 只會是新的
+    return _under_temp(os.path.join(eff, out))
+
+
+def _strip_file_scheme(url: str) -> str:
+    return url[len("file://"):] if url.startswith("file://") else url
+
+
+def _is_local_path(url: str) -> bool:
+    return url.startswith(("/", "./", "../"))
+
+
+def _push_remote_arg(args):
+    """push 參數裡的第一個位置參數(遠端名稱或位址);沒有回 None。"""
+    skip = False
+    for a in args:
+        if skip:
+            skip = False
+        elif a in _PUSH_VALUE_OPTS:
+            skip = True
+        elif not a.startswith("-"):
+            return a
+    return None
+
+
+def _remote_url_temp(eff, url: str) -> bool:
+    """查到的遠端位址是本機路徑而且落在暫存根底下。"""
+    url = _strip_file_scheme(url)
+    if "://" in url or re.match(r"^[^/]+@[^/]+:", url):
+        return False
+    return _under_temp(os.path.join(eff, url))
+
+
+def _push_target_temp(eff, args, added=None) -> bool:
+    """push 的目標位址落在暫存根底下才算拋棄式;沒寫遠端、查不到都不算。
+    added:同一條指令裡先前 `git remote add/set-url` 設的遠端 {名稱: 位址}(判斷時還沒生效,查不到)。
+    遠端名稱查的是推送位址(`remote get-url --push`),不是抓取位址。"""
+    remote = _push_remote_arg(args)
+    if remote is None:
+        return False
+    remote = _strip_file_scheme(remote)
+    if _is_local_path(remote):
+        p = _join(eff, remote)
+        return isinstance(p, str) and _under_temp(p)
+    if added and remote in added:
+        p = added[remote]
+        return isinstance(p, str) and _under_temp(p)
+    if not isinstance(eff, str) or not os.path.isdir(eff):
+        return False
+    rc, url = _git_out(eff, "remote", "get-url", "--push", remote)
+    return rc == 0 and bool(url) and _remote_url_temp(eff, url)
+
+
+# ── git 指令解析 ────────────────────────────────────────────────────
+
+def _short_flags_n(flags: str):
+    """commit 的一組短旗標(不含開頭 -):回 (有沒有 n, 下一個詞是不是這組旗標吃的值)。"""
+    for idx, ch in enumerate(flags):
+        if ch == "n":
+            return True, False
+        if ch in "mFCct":
+            return False, idx == len(flags) - 1
+        if ch in "Su":
+            return False, False
+    return False, False
+
+
+def _commit_short_n(args) -> bool:
+    skip = False
+    for a in args:
+        if skip:
+            skip = False
+        elif a == "--":
+            return False
+        elif a in _COMMIT_VALUE_LONG:
+            skip = True
+        elif a.startswith("-") and not a.startswith("--") and len(a) > 1:
+            hit, skip = _short_flags_n(a[1:])
+            if hit:
+                return True
+    return False
+
+
+def _config_split(args):
+    """config 參數拆成 (旗標集合, 位置參數清單)。"""
+    flags, pos, skip = set(), [], False
+    for a in args:
+        if skip:
+            skip = False
+        elif a in _CONFIG_VALUE_OPTS:
+            flags.add(a)
+            skip = True
+        elif a.startswith("-") and a != "-":
+            flags.add(a.split("=", 1)[0])
+        else:
+            pos.append(a)
+    return flags, pos
+
+
+def _config_writes_hookspath(args) -> bool:
+    flags, pos = _config_split(args)
+    if pos and pos[0] in ("set", "unset"):
+        return len(pos) >= 2 and pos[1].lower() == "core.hookspath"
+    if not pos or pos[0].lower() != "core.hookspath":
+        return False
+    if flags & _CONFIG_WRITE_FLAGS:
+        return True
+    if flags & _CONFIG_READ_FLAGS:
+        return False
+    return len(pos) >= 2
+
+
+def _remote_set(eff, args, variables, subs, added):
+    """記下 `git remote add [選項] 名稱 位址` 與 `git remote set-url [--push] 名稱 位址`:
+    位址是本機路徑就存解析後的路徑,否則存 None(非本機)。"""
+    pos, skip = [], False
+    for a in args[1:]:
+        if skip:
+            skip = False
+        elif a in ("-t", "-m"):
+            skip = True
+        elif not a.startswith("-"):
+            pos.append(a)
+    if len(pos) < 2:
+        return
+    url = _expand(pos[1], variables, subs)
+    url = _strip_file_scheme(url) if isinstance(url, str) else url
+    added[pos[0]] = _join(eff, url) if isinstance(url, str) and _is_local_path(url) else None
+
+
+def _parse_git(words, gi):
+    """words[gi] 是 git;回 (子指令, 參數, -C 目錄們, 設定鍵們, 有沒有 --git-dir/--work-tree);沒有子指令回 None。"""
+    j, gdirs, cfgs, moved, n = gi + 1, [], [], False, len(words)
+    while j < n and words[j].startswith("-"):
+        w = words[j]
+        name, eq, val = w.partition("=")
+        if name in _GIT_DIR_OPTS:
+            moved = True
+        if name == "--config-env" and eq:
+            cfgs.append(val)
+        if w in _GIT_VALUE_OPTS and j + 1 < n:
+            if w in ("-c", "--config-env"):
+                cfgs.append(words[j + 1])
+            elif w == "-C":
+                gdirs.append(words[j + 1])
+            j += 1
+        j += 1
+    if j >= n:
+        return None
+    return words[j], [a for a in words[j + 1:] if not _is_redirect(a)], gdirs, cfgs, moved
+
+
+def _env_cfg_hookspath(words) -> bool:
+    """GIT_CONFIG_KEY_n=core.hooksPath 或 GIT_CONFIG_PARAMETERS 裡帶 core.hooksPath。"""
+    for w in words:
+        m = _CFG_ENV_ASSIGN.match(w)
+        if m and "core.hookspath" in m.group(2).lower():
+            return True
+    return False
+
+
+def _hit_codes(sub, args, cfgs, skip):
+    """這條 git 指令命中哪些繞閘形狀(還沒扣拋棄式)。"""
+    hits = []
+    if sub in ("commit", "push", "merge") and any(a.startswith("--no-veri") and "--no-verify".startswith(a) for a in args):
+        hits.append("no-verify")
+    if sub == "commit" and _commit_short_n(args):
+        hits.append("commit-n")
+    if sub in _HOOK_SUBS and any(c.split("=", 1)[0].lower() == "core.hookspath" for c in cfgs):
+        hits.append("c-hookspath")
+    if sub == "config" and _config_writes_hookspath(args):
+        hits.append("config-hookspath")
+    if sub in ("commit", "push", "merge") and skip:
+        hits.append("lumos-skip")
+    return hits
+
+
+def _exempt(sub, eff, args, added, created) -> bool:
+    """命中算不算拋棄式:push 看推送目標;commit/merge 與只寫 repo 本身的 config 看是不是真 repo;
+    寫使用者或系統層設定的 config、其他(rebase 等)一律不算。"""
+    if sub == "push":
+        return _push_target_temp(eff, args, added)
+    if sub == "config":
+        flags, _ = _config_split(args)
+        return not (flags & _CONFIG_GLOBAL_FLAGS) and _not_real_repo(eff, created)
+    if sub in ("commit", "merge"):
+        return _not_real_repo(eff, created)
+    return False
+
+
+def _lumos_at(words, k) -> bool:
+    """words[k] 的檔名是不是 lumos:lumos 本身,或直譯器跑的 `scripts/lumos` 腳本參數都是這個詞。"""
+    return os.path.basename(words[k]) == "lumos"
+
+
+class _Walker:
+    """逐段走過切好的詞:追蹤 cd 目錄(子殼層各一層、背景執行不算)、變數、export、
+    同指令建的目錄與設的遠端,收集命中代號。"""
+
+    def __init__(self, cwd, subs):
+        start = os.path.normpath(cwd) if isinstance(cwd, str) and cwd.startswith("/") else _UNKNOWN
+        self.stack = [start]
+        self.subs = subs
+        self.variables = {}
+        self.added = {}
+        self.created = set()
+        self.exported_skip = False
+        self.exported_cfg = False
+        self.found = []
+
+    def run(self, toks):
+        seg = []
+        for t in toks:
+            if not isinstance(t, _Sep):
+                seg.append(t)
+                continue
+            before = self.stack[-1]
+            self.segment(seg)
+            if t.replace("\n", "").startswith("&") and not t.startswith("&&"):
+                self.stack[-1] = before      # `cmd &` 在背景子殼層跑,cd 不影響後面
+            seg = []
+            for c in t:
+                if c == "(":
+                    self.stack.append(self.stack[-1])
+                elif c == ")" and len(self.stack) > 1:
+                    self.stack.pop()
+        self.segment(seg)
+        return list(dict.fromkeys(self.found))
+
+    def _assign(self, w):
+        name, val = w.split("=", 1)
+        name = name.rstrip("+")
+        self.variables[name] = _expand(val, self.variables, self.subs)
+        return name
+
+    def segment(self, seg):
+        i = 0
+        while i < len(seg) and (seg[i] in _KEYWORDS or _ASSIGN.match(seg[i])):
+            i += 1
+        if i >= len(seg):            # 只有賦值:設 shell 變數(沒有 export,子程序看不到)
+            for w in seg:
+                if _ASSIGN.match(w):
+                    self._assign(w)
+            return
+        handler = {"cd": self._cd, "pushd": self._lose_dir, "popd": self._lose_dir, "export": self._export,
+                   "declare": self._declare, "typeset": self._declare, "mkdir": self._mkdir}
+        cmd = os.path.basename(seg[i])
+        if cmd in handler:
+            handler[cmd](seg[i + 1:])
+            if cmd != "mkdir":
+                return
+        self._command(seg, i)
+
+    def _cd(self, rest):
+        rest = [a for a in rest if not (a.startswith("-") and a != "-")]
+        if not rest or rest[0] == "-":
+            self.stack[-1] = _UNKNOWN
+        else:
+            self.stack[-1] = _join(self.stack[-1], _expand(rest[0], self.variables, self.subs))
+
+    def _lose_dir(self, rest):
+        self.stack[-1] = _UNKNOWN
+
+    def _mark_exported(self, name):
+        if name.startswith("LUMOS_SKIP_"):
+            self.exported_skip = True
+        if name.startswith("GIT_CONFIG_") and "core.hookspath" in str(self.variables.get(name, "")).lower():
+            self.exported_cfg = True
+
+    def _export(self, rest):
+        if "-n" in rest:
+            return                   # export -n:取消匯出
+        for w in rest:
+            if _ASSIGN.match(w):
+                self._mark_exported(self._assign(w))
+            elif re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", w) and w in self.variables:
+                self._mark_exported(w)
+
+    def _declare(self, rest):
+        if not any(a.startswith("-") and "x" in a for a in rest):
+            return
+        for w in rest:
+            if _ASSIGN.match(w):
+                self._mark_exported(self._assign(w))
+
+    def _mkdir(self, rest):
+        for a in rest:
+            if not a.startswith("-"):
+                p = _join(self.stack[-1], _expand(a, self.variables, self.subs))
+                if isinstance(p, str):
+                    self.created.add(p)
+
+    def _skip_before(self, seg, end) -> bool:
+        """這一段在位置 end 之前有沒有設 LUMOS_SKIP_*(含先前 export 的)。"""
+        return self.exported_skip or any(_SKIP_ASSIGN.match(w) for w in seg[:end])
+
+    def _command(self, seg, i):
+        """一般指令:段裡的 lumos 指令前帶 LUMOS_SKIP_*、或段裡第一個 git 詞開始的 git 指令。"""
+        lk = next((k for k in range(i, len(seg)) if _lumos_at(seg, k)), None)
+        if lk is not None and self._skip_before(seg, lk):
+            self.found.append("lumos-skip")
+        gi = next((k for k in range(i, len(seg)) if os.path.basename(seg[k]) == "git"), None)
+        if gi is not None:
+            self._git(seg, gi)
+
+    def _git(self, seg, gi):
+        parsed = _parse_git(seg, gi)
+        if parsed is None:
+            return
+        sub, args, gdirs, cfgs, moved = parsed
+        eff = self.stack[-1]
+        for d in gdirs:
+            eff = _join(eff, _expand(d, self.variables, self.subs))
+        if moved or any(_GITDIR_ASSIGN.match(w) for w in seg[:gi]):
+            eff = _UNKNOWN           # --git-dir、--work-tree、GIT_DIR 指到別處:不知道動的是哪個 repo
+        self._note_created(sub, args, eff)
+        if sub == "remote" and args[:1] in (["add"], ["set-url"]):
+            _remote_set(eff, args, self.variables, self.subs, self.added)
+        if self.exported_cfg or _env_cfg_hookspath(seg[:gi]):
+            cfgs = [*cfgs, "core.hooksPath"]
+        for code in _hit_codes(sub, args, cfgs, self._skip_before(seg, gi)):
+            if not _exempt(sub, eff, args, self.added, self.created):
+                self.found.append(code)
+
+    def _note_created(self, sub, args, eff):
+        """`git init [目錄]`、`git clone 位址 [目錄]` 建的目錄記下來(同指令後面才 cd 進去)。"""
+        pos = [a for a in args if not a.startswith("-")]
+        target = None
+        if sub == "init":
+            target = pos[0] if pos else "."
+        elif sub == "clone" and pos:
+            target = pos[1] if len(pos) > 1 else re.sub(r"\.git$", "", pos[0].rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])
+        if target is not None:
+            p = _join(eff, _expand(target, self.variables, self.subs))
+            if isinstance(p, str):
+                self.created.add(p)
+
+
+def bypass_reasons(command: str, cwd) -> list:
+    """回這條指令的命中代號清單(去重、保序);空清單=放行。"""
+    _GIT_STATE["calls"] = 0
+    _GIT_STATE["cache"] = {}
+    if len(command) > MAX_LEN:
+        return _literal(command)
+    text = _Normalizer(_join_continuations(command)).run()
+    text, subs = _replace_cmdsubs(text)
+    try:
+        toks = _tokens(text)
+    except ValueError:
+        return _literal(command)
+    return _Walker(cwd, subs).run(toks)
+
+
+def _literal(command: str) -> list:
+    """切不動或太長時只看字面:有 git 而且看起來在跳過閘(--no-verify、改掛鉤目錄、LUMOS_SKIP、提交 -n)就問。"""
+    low = command.lower()
+    if "git" not in low and "lumos" not in low:
+        return []
+    if any(w in low for w in _PRE_WORDS):
+        return ["literal"]
+    if re.search(r"\bcommit\b", low) and _PRE_SHORT_N.search(low):
+        return ["literal"]
+    return []
+
+
+def _reason_text(codes) -> str:
+    what = ";".join(_REASON_TEXT.get(c, c) for c in codes)
+    return ("發生什麼:這條指令會跳過 Lumos 的閘(" + what + ")。\n"
+            "為什麼在意:閘被跳過就沒人檢查這次推送或提交;代理被擋時順手繞過是已知模式。\n"
+            "怎麼做:確定要跳過就按允許;不確定就拒絕,讓代理改成修好被擋的原因。")
+
+
+def decide(event):
+    """回要印的 JSON 物件,或 None(放行)。內部例外一律放行並 mark error。"""
+    try:
+        if not isinstance(event, dict):
+            return None
+        ti = event.get("tool_input")
+        if not isinstance(ti, dict):
+            return None
+        cmd = ti.get("command")
+        if not isinstance(cmd, str) or not cmd:
+            return None
+        cwd = event.get("cwd")
+        codes = bypass_reasons(cmd, cwd if isinstance(cwd, str) else None)
+    except Exception as e:
+        mark("error", type(e).__name__ + ":" + str(e)[:120])
+        return None
+    if not codes:
+        return None
+    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "ask",
+                                   "permissionDecisionReason": _reason_text(codes)}}
+
+
+def main(raw: str) -> int:
+    out = decide(json.loads(raw))
+    if out:
+        print(json.dumps(out, ensure_ascii=False))
+    return 0
+
+
+def entry(stdin_bytes: bytes) -> int:
+    """掛鉤進入點。跟鄰居掛鉤不同:讀 stdin 與預篩放在 guard 之外——guard 每次都跑 git 並寫存活事件,
+    每條 Bash 都進 guard 會擠掉其他掛鉤的存活紀錄(計劃〈做法〉、Systems/代理繞閘問人 的 PITFALL)。"""
+    _inner_budget()                  # 預算從進場就開始算,不是從第一次跑 git 才算
+    try:
+        raw = stdin_bytes.decode("utf-8", "replace")
+        go = prefilter(raw)
+    except Exception:
+        return 0
+    if not go:
+        return 0
+    if _guard:
+        return _guard("pretooluse-bypass-ask-hook", __file__, lambda: main(raw), swallow=True)
+    try:
+        return main(raw)
+    except Exception:
+        return 0
+
+
+if __name__ == "__main__":
+    try:
