 10224	_GIST_BAI_RE = re.compile(r"^>\s*白話[:\uff1a]\s*(.*)$")   # code-r1 B-1:全形冒號 2 篇實存
 10225	_GIST_LABEL_RE = re.compile(r"^(FLOW|KEY|FLAG|DEP|TEST|DECISION):\s*")
 10226	_GIST_BARE_RE = re.compile(r"^(FLOW|KEY|FLAG|DEP|TEST|DECISION):\s*[A-Z/\u2027\u3001 ,]*$")
 10227	_GIST_SENT_RE = re.compile(r"^.{0,79}?[\u3002!?;\uff1b\uff01\uff1f]")
 10228	
 10229	
 10230	def _gist_cut(s):
 10231	    """L0 截斷(Projects/一句話層供糧_計劃 T1,r1 M-5/E-2 折入):≤80 直取;
 10232	    >80 先取首句(句末符 。!?;;為界,首句 ≤80 才用);仍超 → 硬截 80+…。
 10233	    先 _esc_clean 消毒(控制碼換空格,同逃逸帳載重合約),大 limit=只消毒不在這層截。"""
 10234	    s = _esc_clean(nfc(str(s)).strip(), 100000)
 10235	    if len(s) <= 80:
 10236	        return s
 10237	    m = _GIST_SENT_RE.match(s)
 10238	    if m:
 10239	        return m.group(0)
 10240	    return s[:80] + "…"
 10241	
 10242	
 10243	def _gist(env, rel):
 10244	    """一句話層 L0(Projects/一句話層供糧_計劃 T1,2026-09-01,設計審 一句話層供糧-v2 r1):
 10245	    ①正文(=split_frontmatter 之後,r1 M-2 行為級定義:兩獨立席讀成「檔案前20行」
 10246	      會讓命中 84/390→43、Systems 歸零,故起算點寫死)前 20 行首個「> 白話:」行;
 10247	    ②無 → summary 第一個內容行——跳過裸分類標籤行(FLAG:DECISION 這型,全庫 40% 的
 10248	      summary 首行,r1 C-1)、剝 FLOW:/KEY: 等標籤前綴;
 10249	    ③都無 → 空字串(誠實缺席,絕不造假摘要——合約候選)。恆回 str;任何例外回空(fail-open)。"""
 10250	    try:
 10251	        n = env.notes.get(rel)
 10252	        if n is None:
 10253	            return ""
 10254	        try:
 10255	            text = (env.vault / rel).read_text(encoding="utf-8-sig")
 10256	        except Exception:
 10257	            text = ""
 10258	        if text:
 10259	            _fm, body = split_frontmatter(text)
 10260	            in_fence = False
 10261	            for raw in body.split("\n")[:20]:
 10262	                s = raw.strip()
 10263	                if s.startswith("```"):
 10264	                    in_fence = not in_fence   # code-r1 B-3:圍欄內字面示例不是真標記
 10265	                    continue
 10266	                if in_fence:
 10267	                    continue
 10268	                mbai = _GIST_BAI_RE.match(s)
 10269	                if mbai:
 10270	                    got = mbai.group(1).strip()
 10271	                    if got:
 10272	                        return _gist_cut(got)
 10273	                    break
 10274	        summ = n.fields.get("summary") if isinstance(n.fields, dict) else None
 10275	        if isinstance(summ, str):
 10276	            for raw in summ.split("\n"):
 10277	                s = raw.strip()
 10278	                if s[:1] in ("-", "*") and s[1:2] in (" ", "\t"):   # code-r1 B-5:tab 項目符號也剝
 10279	                    s = s[2:].strip()
 10280	                if not s or _GIST_BARE_RE.match(s):
 10281	                    continue
 10282	                s = _GIST_LABEL_RE.sub("", s, count=1).strip()
 10283	                if s:
 10284	                    return _gist_cut(s)
 10285	        return ""
 10286	    except Exception:
 10287	        return ""
 10288	
 10289	
 10290	def _el_related_nodes(env, source, top=5):
 10291	    """入口栓 A 的召回+排序(spec v3):OR 候選+_rank_score_candidates,★不走 cmd_search 頂層★
 10292	    (片語階段單命中即 break 會把 0.90 近名整篇藏掉——r1 邊界席拿事故本尊實測,EL-4/EL-11)。
 10293	    候選收集與 cmd_search 主迴圈同用 _search_visible_lines/nfc 原語,不另寫剝碼/切詞第二份。
 10294	    ★superseded 必納入★:「已裁不做」正是最值錢的命中(EL-10),輸出標 status 由讀者自判。
 10295	    回輸出合約 dict(EL-16):{"query","queried","nodes":[{"name","status","decisions","near_name","gist"}]};
 10296	    分支①未查:queried=false ②查了零候選:nodes=[](誠實零行只掛零候選這個機械事件,分數門檻已裁刪 EL-14)。
 10297	    任何內部例外由呼叫端 fail-open(EL-5)。"""
 10298	    tokens, has_cjk = _el_query_tokens(source)
 10299	    if len(tokens) <= 1 and not has_cjk:
 10300	        return {"query": str(source), "queried": False, "nodes": []}
 10301	    query = " ".join(tokens)
 10302	    cands = []
 10303	    for rel in sorted(env.notes):
 10304	        try:
 10305	            text = (env.vault / rel).read_text(encoding="utf-8-sig")
 10306	        except Exception:
 10307	            continue
 10308	        low = nfc("\n".join(pr for _no, _raw, pr
 10309	                             in _search_visible_lines(text.split("\n"), False))).lower()
 10310	        # 資格判定在收集端(code-r2 D2-1):ASCII token 要求詞邊界(「flow」不再吃「workflow」=r1 外家 F1 的假陽性),
 10311	        # CJK 照子字串。可見行含 frontmatter/decisions——「已裁不做」常只寫在 decisions 內容,
 10312	        # 而記分欄位不含 decisions;若用「分數>0」當資格會把這種真陽性整篇殺掉(EL-10 迴歸實錘)。
 10313	        # 分數(_rank_score_candidates)只管排序,不管資格;0 分=排最後,不=不相關。
 10314	        for t in tokens:
 10315	            if t.isascii():
 10316	                if re.search(r"(?<![a-z0-9])" + re.escape(t) + r"(?![a-z0-9])", low):
 10317	                    cands.append(rel)
 10318	                    break
 10319	            elif t in low:
 10320	                cands.append(rel)
 10321	                break
 10322	    if not cands:
 10323	        return {"query": query, "queried": True, "nodes": []}
 10324	    src_norm = str(source)   # 呼叫端已是 stem;再 .stem 會把 v1.1轉正 截成 v1(r1 正確性席 C-2)
 10325	    scored = _rank_score_candidates(env, query, cands)[:top]
 10326	    nodes = []
 10327	    for rel, _score, _hits in scored:
 10328	        st, dec = _el_node_meta(env, rel)
 10329	        stem = Path(rel).stem
 10330	        nodes.append({"name": stem, "status": st, "decisions": dec,
 10331	                      "near_name": _el_near_name(stem, src_norm),
 10332	                      "gist": _gist(env, rel)})
 10333	    return {"query": query, "queried": True, "nodes": nodes}
 10334	
 10335	
 10336	def cmd_loop_next(env, loop_id, tier=None, as_json=False, need=2, spec=None, repo=None, orchestrator=None):
 10337	    """M1包 #1(loop機械脊椎M1包_計劃):帳本吐唯一下一動作。唯讀指針——lumos 不 spawn agent,
 10338	    編排仍是 Claude(Systems/design-loop 分工)。phase 五值:escalate/gate-pending/converged/
 10339	    cap-reached/plant-canary;判定優先序=escalate→gate-pending(資訊不足,先於 cap)→converged
 10340	    (僅 full-basis)→cap-reached→plant-canary。converged=rc0/其餘 phase=rc1/錯誤=rc2。
 10341	    tier 定錨優先:帳面首個帶 tier 記錄定錨;僅無定錨舊帳按格式推導;零記錄 rc2 要 --tier。"""
 10342	    import json as _json
 10343	    import io
 10344	    import contextlib
 10345	    path = env.vault.parent / ".canary-log.jsonl"
 10346	    try:
 10347	        rounds = _loop_records(env, loop_id, strict=True)   # 單一讀法(架構席 s2 r1 major:曾與 helper 逐行重複)
 10348	    except OSError as e:
 10349	        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
 10350	        return 2
 10351	    n_round = sum(1 for r in rounds if "round" in r)
 10352	    if rounds and n_round not in (0, len(rounds)):
 10353	        print("擋下:這個審查編號的記錄有的帶輪次、有的不帶,格式前後不一致,沒辦法判斷收斂。打開審查記錄檔 .canary-log.jsonl,把這個編號的每一筆格式改一致", file=sys.stderr)
 10354	        return 2
 10355	    panel_fmt = n_round > 0
 10356	    if panel_fmt:   # 讀側損壞守衛不得因缺 --spec 提前 return 而繞過(code-loop r2 折入)
 10357	        seen, cur_rid = set(), None
 10358	        for r in rounds:
 10359	            rid = r["round"]
 10360	            if rid != cur_rid:
 10361	                if rid in seen:
 10362	                    print(f"擋下:第 {rid!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),這本帳只能照時間往後加,順序亂了就沒辦法判斷收斂。檢查 .canary-log.jsonl 裡這個編號的寫入順序",
 10363	                          file=sys.stderr)
 10364	                    return 2
 10365	                seen.add(rid)
 10366	                cur_rid = rid
 10367	    # ── tier 解析:定錨優先(v8);僅無定錨舊帳按格式推導;零記錄 rc2 ──
 10368	    anchor = _loop_anchor_tier(rounds)
 10369	    if tier and anchor and tier != anchor:
 10370	        print(f"擋下:你這次指定的分級是 {tier},但這個審查編號第一筆記錄就定成 {anchor} 了。分級第一筆定下就不能中途換——要換請開新的審查編號", file=sys.stderr)
 10371	        return 2
 10372	    eff_tier = anchor or tier
 10373	    # ── d4 編排者:首輪必帶(比照 --tier),不給預設;帳面定錨後要一致 ──
 10374	    orch_anchor = _loop_orchestrator(rounds)
