 10090	def _roster_next_payload(loop_id, eff_tier):
 10091	    """loop next 的應派 roster:(dict|None, note|None)。legacy=單席通才慣例;
 10092	    indeterminate 與查表 miss=None+對應 note(per-command 訊息:next 無對帳可跳,不印「跳過對帳」)。"""
 10093	    kind = _roster_kind(loop_id)
 10094	    if kind is None:
 10095	        return None, "kind 無法判定(code 開頭但非 code- 慣例)"
 10096	    if eff_tier == "legacy":
 10097	        return {"mode": "single", "seats": [_rseat("通才", "claude", True, "required")]}, None
 10098	    entry = _TIER_ROSTER.get((kind, eff_tier))
 10099	    if entry is None:
 10100	        return None, f"無編制宣告(組合 {kind}/{eff_tier} 未定義)"
 10101	    return entry, None
