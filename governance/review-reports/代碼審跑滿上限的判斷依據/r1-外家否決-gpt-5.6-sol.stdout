 10138	def _el_near_norm(s):
 10139	    s = _NODE_DATEPFX_RE.sub("", nfc(s).lower())
 10140	    for suf in ("_實作計畫", "_計劃"):   # r1 外家 F2:無關短名靠共同後綴恰達 0.6;剝後無關對歸 0、真近名對 0.917
 10141	        if s.endswith(suf):
 10142	            return s[: -len(suf)]
 10143	    return s
 10144	
 10145	
 10146	def _el_near_ratio(a, b):
 10147	    import difflib
 10148	    return difflib.SequenceMatcher(None, _el_near_norm(a), _el_near_norm(b)).ratio()
 10149	
 10150	
 10151	def _el_near_name(a, b):
 10152	    """近名判準(spec EL-8/EL-16/EL-17):剝 YYYY-MM-DD_ 前綴後 difflib ≥0.6 單判準(repo 無 stemmer,「詞幹」已裁刪)。"""
 10153	    return _el_near_ratio(a, b) >= _EL_NEAR_THRESHOLD
 10154	
