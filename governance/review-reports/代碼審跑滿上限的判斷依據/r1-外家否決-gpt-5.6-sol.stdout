 17849	def _quote_norm(s):
 17850	    """quote-check 的唯一正規化(T2 design-loop重設計):NFC → 剝 markdown 強調記號(*/`)
 17851	    → 空白(含全形\u3000/換行)摺疊單空格。★抽取與比對共用這一份——嚴禁第二份實作★
 17852	    (2026-08-02 教訓:預檢與主迴圈兩份實作當場漂移)。不做 lower(保留大小寫語意)。"""
 17853	    import re
 17854	    import unicodedata
 17855	    s = unicodedata.normalize("NFC", s)
 17856	    # Landmark 真場實測(2026-08-04):blockquote 折行的續行 > 記號會進 hay,引句永遠比不中
 17857	    s = re.sub(r"(?m)^\s*>\s?", "", s)
 17858	    s = s.replace("*", "").replace("`", "")
 17859	    return " ".join(s.split())
 17860	
 17861	
 17862	_QUOTE_MIN_NORM_LEN = 10   # 錨定紀律「引句 ≥10 字」轉機械(r1 否決席:一字引句必然錨得到=紀律被架空)
 17863	
 17864	
 17865	def _quote_rows(rtext, stext):
 17866	    """quote-check 核心(T4 抽出供 CLI 與 disposal gate 共用——★單一實作★):
 17867	    回 [{'quote','ok'},...];零引句回 None(呼叫端 fail loud)。
 17868	    引句止於★同型★閉引號:「…」內容許『』(r1 s1 席:原 [^」』]+ 在巢狀『就截斷,
 17869	    「規則『甲」被當前綴錨到,編造的後半永遠沒被驗);norm 後不足下限判 miss。"""
 17870	    import re
 17871	    # 標籤容錯(Landmark 真場實測 2026-08-04):席位自然寫成 **引句**：/**引句（註記）**：——
 17872	    # 只認裸「引句：」會把整份合規報告判成抽零條;容忍可選（…）註記與 * 強調記號
 17873	    _Q_LABEL = r"引句(?:（[^）\n]{0,40}）)?\**[：:]\s*"
 17874	    quotes = [m.group(1) if m.group(1) is not None else m.group(2)
 17875	              for m in re.finditer(_Q_LABEL + r"(?:「([^」]+)」|『([^』]+)』)", rtext)]
 17876	    # r3 修(s2 席):引號型態不成對(「…』)抽不出來會整條靜默消失=編造引句的逃逸口——
 17877	    # 「引句：」標記數 > 成功抽取數時,差額以格式 miss 入列(fail loud,不採信)
 17878	    n_markers = len(re.findall(_Q_LABEL + r"[「『]", rtext))
 17879	    if not quotes and not n_markers:
 17880	        return None
 17881	    hay = _quote_norm(stext)
 17882	    hay_ns = hay.replace(" ", "")
 17883	    rows = []
 17884	    for q in quotes:
 17885	        nq = _quote_norm(q)
 17886	        too_short = len(nq) < _QUOTE_MIN_NORM_LEN
 17887	        # CJK 折行 fallback(Landmark 真場實測):快照句中折行使 norm 後多一個空格,
 17888	        # 連續引句子字串必 miss——空白全剝再比一次(存在性檢查,黏合誤中風險可忽略:
 17889	        # 引句有 10 字下限,跨句黏合要恰好湊出同字序)
 17890	        anchored = nq in hay or nq.replace(" ", "") in hay_ns
 17891	        rows.append({"quote": q, "ok": (not too_short) and anchored,
 17892	                     **({"too_short": True} if too_short else {})})
 17893	    for _ in range(n_markers - len(quotes)):
 17894	        rows.append({"quote": "(引號未閉合/開閉型態不符,無法抽取)", "ok": False, "malformed": True})
 17895	    return rows
 17896	
 17897	
 17898	# ═══ 處置閘「資安席」一步(Projects/代碼審資安席_計劃,2026-09-11 Enzo 裁 d6)═══
 17899	# 高風險代碼審一律必派一席資安;編制表上 requirement=required-gated 的席,出席與否由這一步硬擋。
 17900	_REQUIREMENT_LABEL = {"required-gated": "必派(問閘會擋)"}   # loop next 人讀輸出用;--json 仍給原值
