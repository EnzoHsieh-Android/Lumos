 17911	def _auditor_matches_slot(auditor, slot):
 17912	    """這個席名坐的是不是這個席位:連字號切段,任一段(去頭尾空白)完全等於席位名或別名即算,英文不分大小寫。
 17913	    ★整段相等,不是子字串★:「資安審-sonnet」「非資安-sonnet」不算;模型名自己帶連字號(資安-gpt-5.6-terra)、
 17914	    前面帶席號(s4-資安-sonnet)都算。原本「取最後一個連字號前那段」會把多連字號的真實命名判錯
 17915	    (帳上 308 個席名有 109 個帶兩個以上連字號;r1 邊界 B1、整合 C1)。"""
 17916	    if not isinstance(auditor, str) or not auditor.strip():
 17917	        return False
 17918	    names = {a.casefold() for a in _GATED_SEAT_ALIASES.get(slot, (slot,))}
 17919	    return any(seg.strip().casefold() in names for seg in auditor.split("-"))
