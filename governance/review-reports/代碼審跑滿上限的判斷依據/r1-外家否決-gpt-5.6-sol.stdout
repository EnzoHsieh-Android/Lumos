 10106	# 日期前綴剝除復用既有 _NODE_DATEPFX_RE(scripts/lumos cmd_impact D2 近名判定同源;r1 架構席 A-1:禁第 N 份同型正則)
 10107	_EL_NEAR_THRESHOLD = 0.6      # B 的檔名 difflib 單判準;A 的 ★近名 沿用(spec EL-16)
 10108	
 10109	
 10110	def _el_is_cjk(ch):
 10111	    """與 _rank_tokenize 的 _RANK_CJK_RE 同源(單一真相;r1 三席同抓:原自寫範圍漏擴充A、多認切詞器
 10112	    根本不產出的假名/諺文=死碼)。"""
 10113	    return bool(_RANK_CJK_RE.match(ch))
 10114	
 10115	
 10116	def _el_query_tokens(source):
 10117	    """A 的切詞清洗(spec v3 三步):重用 _rank_tokenize(禁第二份切詞實作)後——
 10118	    ①丟可拆分母 token(含 -/_ 的複合 token;不丟則 auto-2026-08-23 整顆存活、誠實分支永不觸發,r2 D-5 實測)
 10119	    ②濾純數字(「2026」命中 381/385=全庫召回)與長度 1 的 ASCII token ③去重保序。回 (tokens, has_cjk)。"""
 10120	    out, seen, has_cjk = [], set(), False
 10121	    for t in _rank_tokenize(nfc(str(source)).lower()):
 10122	        if "-" in t or "_" in t:
 10123	            continue
 10124	        if t.isdigit():
 10125	            continue
 10126	        if len(t) <= 2 and t.isascii():
 10127	            continue          # r1 邊界席 B-1:2 字母尾碼(auto-…-ab)漏網率 14%、間歇打紅;真實編號詞皆 ≥4
 10128	        if len(t) == 1:
 10129	            continue          # r1 邊界席 B-2:單一常見漢字(「的」)=2026 型全庫召回,同病同濾
 10130	        if any(_el_is_cjk(ch) for ch in t):
 10131	            has_cjk = True
 10132	        if t not in seen:
 10133	            seen.add(t)
 10134	            out.append(t)
 10135	    return out, has_cjk
 10136	
