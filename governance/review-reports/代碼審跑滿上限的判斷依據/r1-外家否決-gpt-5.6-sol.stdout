 18153	def _disposal_clause_step(rows, spec, root, env, loop_id="", spec_sha_override=None):
 18154	    """處置閘第五步(條款綁測試算進度 [S3]):回 "fail" / "ok" / "skip",自己印一行 [disposal] 條款綁定。
 18155	    skip 四種:①凍結/回放模式(spec_sha_override 有值,對凍結 sha 判、不重讀活檔)②迴圈類型是 code(loop id 前綴 code-,同 _roster_kind;
 18156	    code 開頭但不是 code- 的一律當設計審,fail-closed;不看副檔名——外家席:.patch 跳過只看尾碼會被設計審拿 patch 當審材繞過)
 18157	    ③迴圈首筆帳早於 _CLAUSE_GATE_SINCE(不回溯)④計劃無 [SN](opt-in 未啟用)。
 18158	    fail 六種:設計審審材不是 .md / 首筆帳 ts 讀不動 / 測試索引建不起來 / [SN] 像清單項卻是不認得的寫法(零條定義)/ 條款編號重複定義 / 任一條款未標;
 18159	    計劃讀不成文字 → "abort"(呼叫端同 G3 擋下 rc2,兩步同一種處置)。只在散文/標題提到 [SN]、沒有定義行 → skip(視同 opt-in 未啟用)。
 18160	    這是「設計審出口真的有東西逼」的那一半——沒有它,綁測試名跟 spec-trace 一樣沒人做(33 篇 15 篇零認領)。"""
 18161	    if spec_sha_override is not None:
 18162	        print("[disposal] 條款綁定: —(凍結/回放模式:不重讀活檔,以問閘當下的判定為準)")
 18163	        return "skip"
 18164	    if _roster_kind(loop_id or "") == "code":
 18165	        print("[disposal] 條款綁定: —(code 迴圈,審材是 diff 不是計劃,不看條款)")
 18166	        return "skip"
 18167	    # _roster_kind 回 None(code 開頭但不是 code-)一律當設計審:fail-closed,免得取個 codeX 的編號就繞過(r2 外家席實跑抓到)
 18168	    tss = [str(r.get("ts", "")) for r in rows if r.get("ts")]
 18169	    keys = [(_loop_ts_key(x), x) for x in tss]
 18170	    if any(k is None for k, _ in keys):
 18171	        bad = next(x for k, x in keys if k is None)
 18172	        print(f"[disposal] 條款綁定: ✗ — 帳上有一筆 ts 讀不動或沒帶時區({bad!r}),判不了新舊迴圈;壞資料不放行(同 findings 壞值的 fail-closed)")
 18173	        return "fail"
 18174	    if keys and min(k for k, _ in keys) < _loop_ts_key(_CLAUSE_GATE_SINCE):
 18175	        print(f"[disposal] 條款綁定: —(迴圈首筆帳 {min(keys)[1][:19]} 早於 {_CLAUSE_GATE_SINCE[:10]},不回溯)")
 18176	        return "skip"
 18177	    if not str(spec).endswith(".md"):
 18178	        print(f"[disposal] 條款綁定: ✗ — 設計審的審材必須是計劃筆記(.md),不是 {Path(str(spec)).name}(拿 patch 當審材繞不過這一步)")
 18179	        return "fail"
 18180	    try:
 18181	        text = Path(spec).read_text(encoding="utf-8-sig")
 18182	    except (OSError, UnicodeDecodeError) as e:
 18183	        print(f"擋下:--spec 指的文件讀不成文字({e.__class__.__name__}),確認路徑對不對:\n    {spec}", file=sys.stderr)
 18184	        return "abort"
 18185	    if not SPEC_CLAUSE_RE.search(text):
 18186	        print("[disposal] 條款綁定: —(計劃無 [SN] 條款,opt-in 未啟用)")
 18187	        return "skip"
 18188	    rows_b, err = _clause_bindings_for(env, text, root=root)
 18189	    if err:
 18190	        print(f"[disposal] 條款綁定: ✗ — 測試索引建不起來({err}),驗不了≠通過")
 18191	        return "fail"
 18192	    # 規格落成可驗收條件_計劃(半套)S9/S14:判定走跟 lumos spec-gate 同一支 _clause_check;句式與回退節只對首筆帳晚於 _SPEC_GATE_SINCE 的迴圈驗(綁定照驗)
 18193	    grammar = not keys or min(k for k, _ in keys) >= _loop_ts_key(_SPEC_GATE_SINCE)
 18194	    status, lines = _clause_check(text, rows_b, grammar=grammar, tag="disposal")
 18195	    for ln in lines:
 18196	        print(ln)
 18197	    return status
 18198	
