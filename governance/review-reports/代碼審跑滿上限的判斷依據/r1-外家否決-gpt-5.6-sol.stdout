 17905	def _loop_anchor_tier(rounds):
 17906	    """迴圈的定錨分級:帳上第一筆帶 tier 的值。loop next 與處置閘資安席一步呼叫同一支——
 17907	    寫帳那側不擋中途改 tier,改用「任一筆 high」會對一個從沒被派過 high 編制的迴圈要求資安席(r1 邊界 B3)。"""
 17908	    return next((r["tier"] for r in rounds if r.get("tier")), None)
