 17922	def _git_unquote_path(s):
 17923	    """還原 git 在 diff 檔頭替路徑加的 C 式引號。core.quotePath 預設開:中文等非 ASCII 會寫成
 17924	    `"a/docs/\\344\\270\\255.md"` 這種八進位跳脫。沒加引號的原樣回。
 17925	    ★為什麼 lumos 自己呼叫 git 時用 -c core.quotePath=false、這裡卻要還原★(代碼審 r1 架構對齊 B1):
 17926	    專案慣例是從源頭關掉跳脫(本檔各處 git 呼叫都這樣做,代碼審 SKILL 的凍結指令也已補上同一個旗標);
 17927	    但凍結 patch 是編排者自己下指令產的輸入檔,舊迴圈、別家編排者、忘了帶旗標的都會帶引號——
 17928	    判不準就會把同一支檔當兩支、或把兩支當同一支,所以讀這種輸入時要容錯,不是另一套產生方式。
 17929	    ★只去掉行尾換行,不削空白★(r1 外家否決 E1):檔名尾端的空白是檔名的一部分,
 17930	    削掉會把「app/login.py」與「app/login.py 」併成一支,資安席只看過前者也能讓後者過關。"""
 17931	    s = s.rstrip("\r\n")
 17932	    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
 17933	        import codecs
 17934	        try:
 17935	            return codecs.escape_decode(s[1:-1].encode("latin-1", "backslashreplace"))[0].decode("utf-8", "surrogateescape")
 17936	        except Exception:
 17937	            return s[1:-1]
 17938	    return s
