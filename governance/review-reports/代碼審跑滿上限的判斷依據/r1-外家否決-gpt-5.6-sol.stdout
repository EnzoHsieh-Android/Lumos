 10683	# ───────────── guard: 合約守衛 scaffold(對談驅動)─────────────
 10684	# lumos 只做機械活:① 列出 ★INVARIANT★ 綁定狀態 ② 套範本產 stub(預設紅燈) ③ 把 [test:] 綁回 KEY 行(自驗)。
 10685	# 「斷言本體」由 Claude 經對談向人確認意圖後填 — claim 的真來自人確認,不來自 code 反推
 10686	# (反推=套套邏輯=Check T 在打的偽證據)。範本是技術棧專屬、放專案 .lumos/guard-templates/<type>.tmpl,
 10687	# lumos 本體維持語言無關。
 10688	GUARD_TYPES = ("pure", "behavioral", "state")
 10689	GUARD_ICON = {"real": "✅ 已綁真方法", "dangling": "❌ 懸空(找不到方法)",
 10690	              "fake": "⚠ 偽證據(非測試方法)", "naked": "❌ 裸合約(未綁)"}
