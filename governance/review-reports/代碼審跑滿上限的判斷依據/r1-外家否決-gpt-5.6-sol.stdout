 10211	def _el_node_meta(env, rel):
 10212	    """(status, 決策數)——status 取 frontmatter 欄位;決策數 len(parse_decisions)(機械數)。"""
 10213	    n = env.notes.get(rel)
 10214	    if n is None or not isinstance(n.fields, dict):
 10215	        return None, 0
 10216	    st = str(n.fields.get("status") or "").strip() or None
 10217	    try:
 10218	        dec = len(parse_decisions(n.fm_lines))
 10219	    except Exception:
