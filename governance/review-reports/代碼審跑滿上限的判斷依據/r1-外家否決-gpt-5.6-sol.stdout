 10176	def _node_not_found(env, name, *, write_side=False):
 10177	    """印「找不到這篇筆記」並給近名候選。★讀取指令與寫入指令用不同的後半句★。
 10178	
 10179	    出身(2026-09-07 全 repo 審視 #9):四支**讀取**指令(健康巡檢、看合約、看漂移史、
 10180	    決策重編)打錯節點名時,印的都是「決策沒地方掛」——那是**寫入側專用**的話,
 10181	    白話化那批複製貼上時漏改。讀的人拿到一句對不上自己在做什麼的訊息,而且不給近名候選,
 10182	    只能自己回去猜名字。
 10183	
 10184	    近名用既有的 _el_near_name(剝日期前綴後比相似度)。
 10185	    ★成本★:每次要走訪全圖譜比一次。本 repo 428 篇實測約 13 毫秒(含 CLI 啟動),無感;
 10186	    線性成長,一萬篇約 160 毫秒、五萬篇約 800 毫秒。
 10187	    REVISIT:2026-12-07 若有消費端圖譜超過一萬篇,這裡要改成先用便宜的前綴/長度篩再比
 10188	    ★這裡原本寫「repo 沒有第二種近名判準」——那是錯的事實(2026-09-07 代碼審 r1 架構席抓到)★:
 10189	    這個 repo 有兩支同型工具,_levenshtein_le1(只判差一個字,給開頭欄位鍵用,前一天才加的)
 10190	    與這支。兩支各有理由所以並存;要記住的是**不要再開第三支**——
 10191	    打錯指令那條第一版就又開了一支,已收斂回這支。
 10192	    """
 10193	    print(f"擋下:圖譜裡找不到叫「{name}」的筆記。", file=sys.stderr)
 10194	    try:
 10195	        cands = [rel for rel in env.notes if _el_near_name(name, Path(rel).stem)][:5]
 10196	    except Exception:                      # 找不到就找不到,不能因為找近名而炸
 10197	        cands = []
 10198	    if cands:
 10199	        print("  是不是想找這幾篇之一:", file=sys.stderr)
 10200	        for c in cands:
 10201	            print(f"      {c}", file=sys.stderr)
 10202	    else:
 10203	        print("  沒有名字接近的。用關鍵字找找看(中文查詢:概念之間加空白):", file=sys.stderr)
 10204	        print(f"      lumos search {name}", file=sys.stderr)
 10205	    if write_side:
 10206	        print("  確定要新建的話:", file=sys.stderr)
 10207	        print("      lumos new <類型> <名稱>", file=sys.stderr)
 10208	    return 2
