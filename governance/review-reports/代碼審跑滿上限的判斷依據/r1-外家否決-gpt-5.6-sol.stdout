 18067	def _disposal_security_step(rounds, rid, loop_id, prov_path):
 18068	    """處置閘第六步「資安席」(第五步是條款綁定):回 "fail" / "ok" / "skip",自己印 [disposal] 資安席 那幾行。
 18069	    定錨 high、生效日後的代碼審,編制表上每個 required-gated 席:①整個迴圈有它的帳(席名判法見 _auditor_matches_slot)
 18070	    ②那筆的報告與凍結 patch 還在、sha 對 ③它看過的檔(凍結 patch 檔案清單聯集)涵蓋判定輪全部檔。
 18071	    看整個迴圈不是每一輪(判定輪常是只派一席的 delta 輪)。凍結/回放模式照樣重讀檔——凍結閉包也收了這些檔,
 18072	    所以即時判不過的,凍結重算也判不過(r1 外家否決 E2)。"""
 18073	    st, why, slots = _gated_seats_for(rounds, loop_id)
 18074	    if st == "skip":
 18075	        print(f"[disposal] 資安席: —({why})")
 18076	        return "skip"
 18077	    if st == "fail":
 18078	        print(f"[disposal] 資安席: ✗ — {why}")
 18079	        return "fail"
 18080	    judge = [r for r in rounds if r.get("round") == rid]
 18081	    if not judge and isinstance(rid, str) and rid.startswith("__seq"):
 18082	        # 不帶 --round 的迴圈:判定輪是讀側合成的 __seqN(逐筆自成一輪),帳上 round 欄是 None,拿 rid 比永遠比不中
 18083	        # → 原本判定輪抓不到檔名、恆判不過、訊息還講成材料放錯(代碼審 r3 編排者自找)。混帶/不帶輪次在上游就擋,這裡全是不帶的
 18084	        judge = [r for r in rounds if r.get("round") is None][-1:]
 18085	    jchg, junread = {}, []
 18086	    for sp in sorted({r.get("snapshot_path") for r in judge if r.get("snapshot_path")}):
 18087	        try:
 18088	            jchg.update(_patch_file_changes(prov_path(sp).read_text(encoding="utf-8", errors="replace")))
 18089	        except OSError:
 18090	            junread.append(sp)
 18091	    jfiles = set(jchg)
 18092	    _odd_id = _roster_kind(loop_id or "") is None
 18093	    verdict = "ok"
 18094	    for slot in slots:
 18095	        rows = [r for r in rounds if _auditor_matches_slot(r.get("auditor"), slot)]
 18096	        if not rows:
 18097	            seen = sorted({r.get("auditor") for r in rounds if r.get("auditor")})
 18098	            print(f"[disposal] 資安席: ✗ — 這個迴圈沒有「{slot}」席的帳(高風險代碼審必派,而且問閘會擋)"
 18099	                  + ("——編號 code 開頭卻不是 code-,看不出是哪一種審查,照最嚴的當代碼審" if _odd_id else ""))
 18100	            print(f"  帳上出現過的席名:{'、'.join(seen) if seen else '(無)'}——席名要有一段是「{slot}」,例如 {slot}-sonnet")
 18101	            print("  在意的原因:高風險代碼審一律要有一席站在攻擊者那邊看過這份改動(2026-09-11 人裁);沒有它,能被利用的洞沒人負責找。")
 18102	            print("  接下來:派一席資安(派工用 lumos-design-loop templates.md §7.8);已經審過、只是席名寫錯的,用正確席名把同一份報告補記一筆:")
 18103	            import shlex as _shlex   # 代碼審 r2 資安 G3:編號原樣塞進建議指令,照抄執行會被當成 shell 語法
 18104	            print(f"    lumos canary record none --loop {_shlex.quote(loop_id)} --round <那一輪> --auditor {slot}-<模型> --severity <最高> "
 18105	                  "--findings <條數> --report <報告> --snapshot <那一輪凍結 patch> --spec <那一輪凍結 patch> --reviewed <sha256>")
 18106	            verdict = "fail"
 18107	            continue
 18108	        good, bad = [], []
 18109	        for r in rows:
 18110	            probs = []
 18111	            for label, key in (("報告", "report_path"), ("凍結 patch", "snapshot_path")):
 18112	                pst, pth = _prov_check(r, key, prov_path)
 18113	                if pst != "ok":
 18114	                    probs.append({"missing": f"{label}沒記", "unreadable": f"{label}讀不到({pth})",
 18115	                                  "mismatch": f"{label} sha256 與帳面不符(事後被改)"}[pst])
 18116	            (bad if probs else good).append((r, probs))
 18117	        if not good:
 18118	            print(f"[disposal] 資安席: ✗ — 「{slot}」席的帳在,但留痕對不上:"
 18119	                  + ";".join(f"{r.get('round')} {r.get('auditor')} {'、'.join(p)}" for r, p in bad))
 18120	            print("  在意的原因:報告不在或事後被改,就證明不了那一席真的看過、看的是哪一版。")
 18121	            print("  接下來:找回原檔;找不回就重派一席資安再記帳。")
 18122	            verdict = "fail"
 18123	            continue
 18124	        if junread or not jfiles:
 18125	            print("[disposal] 資安席: ✗ — 判定輪的凍結 patch 讀不到或抓不到任何檔名"
 18126	                  + (f"({'、'.join(junread)})" if junread else "") + ",沒辦法確認資安席看過的檔有沒有涵蓋最後一版;看不懂就不放行")
 18127	            print("  在意的原因:代碼審的凍結材料應該是整條分支的 diff(git diff <merge-base>..HEAD);抓不到檔名多半是材料放錯了。")
 18128	            verdict = "fail"
 18129	            continue
 18130	        seen = {}
 18131	        for r, _p in good:
 18132	            for f, h in _patch_file_changes(prov_path(r["snapshot_path"]).read_text(encoding="utf-8", errors="replace")).items():
 18133	                seen.setdefault(f, set()).add(h)
 18134	        unseen = sorted(f for f in jfiles if f not in seen)
 18135	        changed = sorted(f for f in jfiles if f in seen and jchg[f] not in seen[f])
 18136	        if unseen or changed:
 18137	            parts = []
 18138	            if changed:
 18139	                parts.append(f"{len(changed)} 支的內容跟資安席看的不一樣(之後又改過):" + "、".join(changed[:10])
 18140	                             + ("…" if len(changed) > 10 else ""))
 18141	            if unseen:
 18142	                parts.append(f"{len(unseen)} 支資安席沒看過:" + "、".join(unseen[:10]) + ("…" if len(unseen) > 10 else ""))
 18143	            print("[disposal] 資安席: ✗ — 最後一版改到的檔," + ";".join(parts))
 18144	            print("  在意的原因:資安席看的是早一輪的材料;之後新碰到或又改過的檔,沒有人從攻擊者角度看過最後的樣子。")
 18145	            print(f"  接下來:對最新的凍結 patch 再派一席資安,記帳席名用 {slot}-<模型>。")
 18146	            verdict = "fail"
 18147	            continue
 18148	        r0 = good[0][0]
 18149	        print(f"[disposal] 資安席: ✓ — {r0.get('round')} {r0.get('auditor')}(看過的檔涵蓋最後一版 {len(jfiles)} 個)")
 18150	    return verdict
 18151	
