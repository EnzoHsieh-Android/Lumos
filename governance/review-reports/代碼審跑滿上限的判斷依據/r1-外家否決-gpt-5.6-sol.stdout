  9950	def _roster_dispatch_entries(loop_dir, rid):
  9951	    """解析一輪的 rN-dispatch*.json → (auditor 串列, 跳過檔數)。三種真實形狀:
  9952	    ①dict 頂層 auditor ②dict 帶 seats 陣列 ③頂層 list;壞損 JSON 與不符形狀同一處置=跳過不計。"""
  9953	    import json as _json
  9954	    auditors, skipped = [], 0
  9955	    for f in sorted(loop_dir.glob(f"{rid}-dispatch*.json")):
  9956	        try:
  9957	            obj = _json.loads(f.read_text(encoding="utf-8"))
  9958	        except (OSError, UnicodeDecodeError, ValueError):
  9959	            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
  9960	            skipped += 1
  9961	            continue
  9962	        if isinstance(obj, dict) and "auditor" in obj:
  9963	            elems = [obj]
  9964	        elif isinstance(obj, dict) and isinstance(obj.get("seats"), list):
  9965	            elems = obj["seats"]
  9966	        elif isinstance(obj, list):
  9967	            elems = obj
  9968	        else:
  9969	            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
  9970	            skipped += 1
  9971	            continue
  9972	        for e in elems:
  9973	            a = e.get("auditor") if isinstance(e, dict) else None
  9974	            auditors.append(a if isinstance(a, str) else None)   # 非字串(數字/巢狀物)=無名席→unknown 桶,不炸整段觀測
  9975	    return auditors, skipped
