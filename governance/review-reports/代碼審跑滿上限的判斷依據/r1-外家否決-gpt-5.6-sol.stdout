 18022	def _prov_check(r, key, prov_path):
 18023	    """單一帳列的一份留痕(key=report_path/snapshot_path/intake_path)還對不對得上。
 18024	    回 (狀態, 路徑):ok / missing(帳上沒帶)/ unreadable(讀不到)/ mismatch(sha 與帳面不符=事後被改)。
 18025	    處置閘的留痕重驗與資安席一步共用這一支,不各抄一份(r1 前掃 ④b)。"""
 18026	    pth = r.get(key)
 18027	    if not pth:
 18028	        return "missing", None
 18029	    try:
 18030	        got = _sha256_file(prov_path(pth))
 18031	    except OSError:
 18032	        return "unreadable", pth
 18033	    return ("ok" if got == r.get(key.replace("_path", "_sha256")) else "mismatch"), pth
 18034	
