 18059	def _gated_seat_rows(rounds, loop_id):
 18060	    """適用時,帳上坐 required-gated 席的那些帳列(凍結閉包要把它們的報告與凍結 patch 一起收)。"""
 18061	    st, _why, slots = _gated_seats_for(rounds, loop_id)
 18062	    if st != "apply":
 18063	        return []
 18064	    return [r for r in rounds if any(_auditor_matches_slot(r.get("auditor"), s) for s in slots)]
