 17839	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 17840	            return None
 17841	        return p
 17842	    for cand in (Path.cwd(), *Path.cwd().parents):
 17843	        if (cand / ".git").exists():
 17844	            return cand
 17845	    print("擋下:從目前目錄往上找不到 git repo,用 --repo 指定專案根目錄", file=sys.stderr)
 17846	    return None
