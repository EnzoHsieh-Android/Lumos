  9926	def _loop_orchestrator(rounds):
  9927	    """帳面編排者定錨:首個帶 orchestrator 的記錄;舊帳沒有 → None(讀側視為 claude 並印一句,不給新呼叫預設——
  9928	    Projects/Codex完全支援_計劃 d4:預設 claude 會讓 Codex 編排漏旗標時靜默套錯家族)。"""
  9929	    return next((r.get("orchestrator") for r in rounds if r.get("orchestrator") in LOOP_ORCHESTRATORS), None)
