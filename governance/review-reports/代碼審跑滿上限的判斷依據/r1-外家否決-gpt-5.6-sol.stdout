 17941	def _patch_files_from_text(text):
 17942	    """凍結 patch 改到哪些檔(集合)。檔名判法見 _patch_file_changes。"""
 17943	    return set(_patch_file_changes(text))
 17944	
 17945	
 17946	def _patch_file_changes(text):
 17947	    """凍結 patch 裡每支檔的「改動指紋」:{檔名: sha256}。
 17948	    檔名:每段 `diff --git` 在第一個 `@@` 之前依序取 `+++ b/…`(不是 /dev/null)→ `rename to …` → `--- a/…`(刪檔)
 17949	    → `diff --git` 行本身 b/ 那側;hunk 內容裡剛好長得像檔頭的行不算。既有的 _delguard_parse_diff 只用
 17950	    「 b/(.+)$」抓、不處理引號,所以不能直接拿來用。
 17951	    ★指紋算 hunk 的內容,不算位置★(代碼審 r1 通才 A1/資安 C1;r3 外家否決改):hunk 裡的增刪行與上下文行、
 17952	    `@@` 後面的段落標頭(函式名),加上 mode/新增刪除/改名/二進位這幾種檔頭;不算 `@@` 的行號與 `index` 那行——
 17953	    只差行號(rebase 常見)還算同一版。原本只比檔名,同一支檔換成含後門的內容照樣算「資安席看過」;
 17954	    r1 改成只算增刪行之後,同一段 `-check(user)/+allow(user)` 從公開端點搬到管理員端點指紋完全相同(r3 外家 Codex 實測),
 17955	    所以上下文與段落標頭也要算。代價:rebase 之後這段附近的程式也變了,資安席要對最新版再看一次(誤擋方向)。
 17956	    ★二進位檔例外★(代碼審 r2 通才 F1):二進位檔沒有增刪行,內容變化只在 `index 舊..新` 的「新」那一半
 17957	    (改動後的版本雜湊)與 `GIT binary patch` 資料行——這兩樣要算進去,否則換掉整個二進位檔指紋也不變。
 17958	    文字檔不算 index,因為 rebase 會讓它變、改動本身卻沒變。"""
 17959	    import hashlib
 17960	    files, cur, in_hunk = {}, None, False
 17961	    _HDR_KEEP = ("old mode ", "new mode ", "new file mode ", "deleted file mode ", "rename from ", "rename to ",
 17962	                 "Binary files ", "copy from ", "copy to ")
 17963	
 17964	    def _strip(p, pre):
 17965	        p = _git_unquote_path(p.split("\t", 1)[0])
 17966	        return p[len(pre):] if p.startswith(pre) else p
 17967	
 17968	    def _flush():
 17969	        if cur:
 17970	            name = cur.get("plus") or cur.get("rename") or cur.get("minus") or cur.get("hdr")
 17971	            if name:
 17972	                chg = cur["chg"] + ([f"post-blob {cur['post']}"] if cur.get("bin") and cur.get("post") else [])
 17973	                h = hashlib.sha256("\n".join(chg).encode("utf-8", "surrogateescape")).hexdigest()
 17974	                files[name] = h
 17975	
 17976	    for ln in text.splitlines():
 17977	        if ln.startswith("diff --git "):
 17978	            _flush()
 17979	            rest, hdr = ln[len("diff --git "):], None
 17980	            if rest.endswith('"'):
 17981	                k = rest.rfind(' "b/')
 17982	                if k >= 0:
 17983	                    hdr = _strip(rest[k + 1:], "b/")
 17984	            else:
 17985	                k = rest.rfind(" b/")
 17986	                if k >= 0:
 17987	                    hdr = rest[k + 3:]
 17988	            cur, in_hunk = {"hdr": hdr, "chg": [], "bin": False, "post": None, "binpatch": False}, False
 17989	            continue
 17990	        if cur is None:
 17991	            continue
 17992	        if cur["binpatch"]:
 17993	            cur["chg"].append(ln)   # GIT binary patch 的資料行就是內容
 17994	            continue
 17995	        if in_hunk:
 17996	            if ln[:1] in ("+", "-", " ", "\\"):
 17997	                cur["chg"].append(ln)   # 增刪行、上下文行、「\ No newline」都是內容
 17998	            elif ln.startswith("@@"):
 17999	                cur["chg"].append("@@" + ln.split("@@", 2)[-1])   # 行號不算、段落標頭(函式名)算
 18000	            continue
 18001	        if ln.startswith("@@"):
 18002	            in_hunk = True
 18003	            cur["chg"].append("@@" + ln.split("@@", 2)[-1])   # 第一段的段落標頭也算
 18004	        elif ln.startswith("index ") and ".." in ln:
 18005	            cur["post"] = ln[len("index "):].split("..", 1)[1].split(" ", 1)[0]
 18006	        elif ln == "GIT binary patch":
 18007	            cur["bin"] = cur["binpatch"] = True
 18008	        elif ln.startswith(_HDR_KEEP):
 18009	            if ln.startswith("Binary files "):
 18010	                cur["bin"] = True
 18011	            cur["chg"].append(ln)
 18012	            if ln.startswith("rename to "):
 18013	                cur["rename"] = _git_unquote_path(ln[len("rename to "):])
 18014	        elif ln.startswith("+++ ") and ln[4:].strip() != "/dev/null":
 18015	            cur["plus"] = _strip(ln[4:], "b/")
 18016	        elif ln.startswith("--- ") and ln[4:].strip() != "/dev/null":
 18017	            cur["minus"] = _strip(ln[4:], "a/")
 18018	    _flush()
 18019	    return files
 18020	
