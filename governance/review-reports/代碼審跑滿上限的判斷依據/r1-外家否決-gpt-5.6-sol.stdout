 18588	def cmd_quote_check(report, spec, as_json=False):
 18589	    """錨定檢查(T2,vault-free):報告內每條「引句：「…」」norm 後須為凍結快照 norm 後的
 18590	    子字串。rc0=全 ok、rc1=有 miss、rc2=IO/零引句(★驗不了≠通過,fail loud★)。
 18591	    ★比對對象必須是派工當下的凍結快照,不是現檔★——對現檔跑,finding 折入後引句會
 18592	    「自我成真」(重設計 r1 Codex 折入:循環自證)。"""
 18593	    import json
 18594	    import re
 18595	    try:
 18596	        rtext = Path(report).read_text(encoding="utf-8")
 18597	        stext = Path(spec).read_text(encoding="utf-8")
 18598	    except (OSError, UnicodeDecodeError) as e:
 18599	        # UnicodeDecodeError 非 OSError——非 UTF-8 檔原本直接 traceback(r1 s4 席)
 18600	        print(f"擋下:檔案讀不到: {e}", file=sys.stderr)
 18601	        return 2
 18602	    rows = _quote_rows(rtext, stext)
 18603	    if rows is None:
 18604	        print("擋下:這份審查報告裡一句「引句：「…」」都抽不到;驗不了不等於通過——"
 18605	              "審查員沒照派工格式寫的話,先補引句再記帳。\n"
 18606	              "  常見原因:①標籤寫成『引文:』『Quote:』等別名(只認「引句」;粗體或加註記的變體可以)"
 18607	              " ②引號用半形 \"…\" 或【…】(只認「」『』) "
 18608	              "③引句跟標籤不在同一行 ④開閉引號不成對(這種會列成錨不到,不是零條)", file=sys.stderr)
 18609	        return 2
 18610	    miss = [r for r in rows if not r["ok"]]
 18611	    if as_json:
 18612	        print(json.dumps({"report": str(report), "spec": str(spec),
 18613	                          "total": len(rows), "miss": len(miss), "quotes": rows},
 18614	                         ensure_ascii=False))
 18615	    else:
 18616	        for i, r in enumerate(rows, 1):
 18617	            mark = "✓" if r["ok"] else "✗"
 18618	            short = f"(<{_QUOTE_MIN_NORM_LEN} 字下限)" if r.get("too_short") else ""
 18619	            print(f"  {mark} #{i} 「{r['quote'][:60]}」{short}")
 18620	        print(f"{'✅ 全數錨定:報告裡每句引言都能在凍結快照找到原文' if not miss else f'⛔ {len(rows)} 句引言有 {len(miss)} 句在凍結快照裡找不到(找不到的那幾句不採信)'}"
 18621	              f"(比對時忽略粗體、反引號和空白差異;比對對象應該是派工當下的凍結快照)")
 18622	    return 0 if not miss else 1
