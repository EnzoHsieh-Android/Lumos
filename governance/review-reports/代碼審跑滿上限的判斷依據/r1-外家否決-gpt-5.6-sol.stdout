 18200	_LANDING_GATE_SINCE = "2026-09-12T00:00:00+08:00"   # 處置閘的落點那一步只看首筆帳在這之後的迴圈——不回溯(同 _CLAUSE_GATE_SINCE)
 18201	_LANDS_IN_ITEM_RE = re.compile(r"^Systems/[^/\[\]|#]+$")
 18202	
 18203	
 18204	def _lands_in_bad(values):
 18205	    """[S20] lands_in 每項要寫 Systems/<名>(純字串,不是 [[連結]]、不帶 .md、只收圖譜節點)。回寫錯的那幾項。"""
 18206	    bad = []
 18207	    for v in values:
 18208	        x = str(v).strip()
 18209	        if not x or not _LANDS_IN_ITEM_RE.match(x) or x.endswith(".md"):
 18210	            bad.append(x)
 18211	    return bad
 18212	
 18213	
 18214	def _disposal_landing_step(rows, spec, root, env, loop_id="", spec_sha_override=None):
 18215	    """處置閘第六步(每支檔有家 [S21]):計劃要寫明落點(lands_in)。形狀照條款綁定那一步:回 "fail"/"ok"/"skip"/"abort"。
 18216	    skip:凍結/回放模式、code 迴圈、首筆帳早於 _LANDING_GATE_SINCE(不回溯)、審材不是圖譜 Projects 底下 type 為 project 的 .md。
 18217	    fail:lands_in 空的,或有一項不是 Systems/<名> 的樣子。"""
 18218	    if spec_sha_override is not None:
 18219	        print("[disposal] 落點: —(凍結/回放模式:以問閘當下的判定為準)")
 18220	        return "skip"
 18221	    if _roster_kind(loop_id or "") == "code":
 18222	        print("[disposal] 落點: —(code 迴圈,不看計劃落點)")
 18223	        return "skip"
 18224	    tss = [str(r.get("ts", "")) for r in rows if r.get("ts")]
 18225	    keys = [k for k in (_loop_ts_key(x) for x in tss) if k is not None]
 18226	    if keys and min(keys) < _loop_ts_key(_LANDING_GATE_SINCE):
