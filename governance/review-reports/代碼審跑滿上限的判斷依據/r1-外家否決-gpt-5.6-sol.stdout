 18036	def _gated_seats_for(rounds, loop_id):
 18037	    """資安席這一步對這個迴圈適不適用。回 (狀態, 說明, 席位清單):
 18038	    skip(不是代碼審 / 定錨分級的編制表沒有 required-gated 席 / 首筆帳早於生效日)、
 18039	    fail(帳上 ts 讀不動——判不了新舊迴圈,壞資料不放行,同 _disposal_clause_step)、apply(要檢查)。"""
 18040	    kind = _roster_kind(loop_id or "")
 18041	    if kind == "design":
 18042	        return "skip", "設計審不要求資安席——設計審編制不加", []
 18043	    # kind is None:編號 code 開頭卻不是 code-,看不出種類 → 照最嚴的當代碼審(代碼審 r1 通才 A2:
 18044	    # 原本整步跳過,換個名字就繞過;條款綁定那一步對同一種編號也是照它自己最嚴的方向判)
 18045	    tier = _loop_anchor_tier(rounds)
 18046	    entry = _TIER_ROSTER.get(("code", tier))
 18047	    slots = [s["slot"] for s in (entry or {}).get("seats", []) if s.get("requirement") == "required-gated"]
 18048	    if not slots:
 18049	        return "skip", f"定錨分級 {tier or '沒指定'},編制表沒有必派而且會擋的席", []
 18050	    keys = [(_loop_ts_key(str(r.get("ts", ""))), str(r.get("ts", ""))) for r in rounds if r.get("ts")]
 18051	    if any(k is None for k, _ in keys):
 18052	        bad = next(x for k, x in keys if k is None)
 18053	        return "fail", f"帳上有一筆 ts 讀不動或沒帶時區({bad!r}),判不了是不是生效日後開的迴圈;壞資料不放行", []
 18054	    if keys and min(k for k, _ in keys) < _loop_ts_key(_SECURITY_SEAT_SINCE):
 18055	        return "skip", f"迴圈首筆帳 {min(keys)[1][:19]} 早於生效日 {_SECURITY_SEAT_SINCE[:10]},不回溯", []
 18056	    return "apply", "", slots
 18057	
