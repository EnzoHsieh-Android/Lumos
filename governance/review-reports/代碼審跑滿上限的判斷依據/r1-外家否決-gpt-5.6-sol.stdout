 10066	            print(f"[roster] {rid}:seat_shortfall——同門({orch})審查員{hedge}不夠(實際 {n_c} 席,應有 {len(req_c)} 席)")
 10067	            anomalies.append("seat_shortfall")
 10068	        if len(req_e) >= 2:
 10069	            from collections import Counter as _Counter
 10070	            for name, cnt in _Counter(exts).items():
 10071	                if cnt >= 2:
 10072	                    print(f"[roster] {rid}:真兼任——外部審查員疑似一人兼任多席({cnt} 席都叫 {name})")
 10073	                    anomalies.append("真兼任")
 10074	        if nia and not exts:
 10075	            print(f"[roster] {rid}:單家族(只有同一家模型在審)——外家席本輪未派(編制={nia[0]['requirement']};"
 10076	                  f"辯方是否該派屬編排當場判斷,本行僅轉述編制對照,不裁決),收斂結論要講保守一點")
 10077	            anomalies.append("單家族")
 10078	        for s in seats:
 10079	            if s["requirement"] == "conditional":
 10080	                _quiet(f"[roster] {rid}:{s['slot']} 是條件席(條件:{s.get('note', '?')}),該不該派由編排者自己對")
 10081	        for a in unks:
 10082	            print(f"[roster] {rid}:看不出 {a} 是哪一家的審查員,列出但不判定")
 10083	            anomalies.append("unknown")
 10084	        for a in duals:
 10085	            print(f"[roster] {rid}:命名歧義——{a} 的名字同時像兩家,先當成外部審查員算")
 10086	            anomalies.append("命名歧義")
 10087	    return anomalies
