     return _DRIFT_QUOTE_RE.sub(lambda m: _DRIFT_QUOTED * len(m.group(0)), line)
 
 
 def _drift_pending_clause(cl):
-    """這個子句(遮好的)算不算待定:有待定詞、而且還沒補已裁定括號(括號補在子句結尾,同一行別的子句照判;代碼審 r1 正確性席)。"""
