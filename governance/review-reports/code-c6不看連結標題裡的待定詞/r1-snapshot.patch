+    """這個子句(遮好的)算不算待定:有待定詞、而且還沒補已裁定括號(括號補在子句結尾,同一行別的子句照判;代碼審 r1 正確性席)。
+    ★找待定詞前先遮掉 [[…]] 連結(含別名)★:連到標題寫「…還沒做」的已結案 Issue,不代表這句在說還沒做
+    (2026-10-06 rtb 盤點兩條誤報,Projects/c6不看連結標題裡的待定詞_計劃);找連結的那一步照用原文。"""
+    bare = WIKILINK_RE.sub(lambda m: _DRIFT_QUOTED * len(m.group(0)), cl)
+    return any(w in bare for w in _DRIFT_PENDING_WORDS) and _DRIFT_MASK not in cl
 
 
 def _drift_pending_clauses(line):
     """一行的待定子句 → [(起點, 終點, 遮好的子句)];終點是下一個切點之前,最後一個子句到去掉尾端空白為止。"""
     masked = _drift_mask_quotes(_drift_mask_settled(line))
     out, start = [], 0
     for m in [*_DRIFT_CLAUSE_SPLIT_RE.finditer(masked), None]:
         end = m.start() if m else len(masked.rstrip())
         if _drift_pending_clause(masked[start:end]):
             out.append((start, end, masked[start:end]))
