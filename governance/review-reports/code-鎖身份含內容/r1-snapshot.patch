 def _excl_lock_record_identity(identity_out, identity):
     """把建鎖時 fstat 的身份交給需要安全清理的呼叫端。"""
     if identity_out is not None:
         identity_out[:] = [identity]
 
 
+def _excl_lock_is_mine(lock, identity, partial=False):
+    """路徑上的鎖還是不是建鎖時那一把:裝置、inode 一樣,而且內容是當時寫的那份(含隨機識別碼)。
+    只比 inode 不夠:Linux(ext4、tmpfs)刪檔後馬上建同名檔幾乎必拿到同一個 inode 編號,別人剛換入的新鎖
+    會被認成自己的而刪掉(GitHub CI 上必紅,macOS 的 APFS 不馬上重用所以本機綠)。partial=True 給寫到一半
+    出錯的那條路:內容是當時要寫的開頭一段也算。讀不到回 False(寧可留鎖,不刪別人的)。"""
+    dev, ino, data = identity
+    try:
+        now = lock.lstat()
+        if (now.st_dev, now.st_ino) != (dev, ino):
+            return False
+        got = lock.read_bytes()
+    except OSError:
+        return False
+    return got == data or (partial and data.startswith(got))
+
