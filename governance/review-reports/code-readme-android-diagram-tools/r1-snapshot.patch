         b+=text(98,y+57,sub,15 if en else 16,"muted")
         b+=badge(562,y+20,tag,c,146)+'</g>'
         if i<len(layers)-1:
             b+=path(f"M380 {y+70}V{y+88}","line",2,"6 6",True)+arrow(380,y+92,"down")
     # 記憶體類 check 沒過時從 L0 直達 L3(L1、L2 看 CPU 時間,記憶體問題看不到)
