+MACROBENCH_DEFAULTS = {"tolerance_pct": 10.0, "abs_tolerance": 1.0, "higher_is_better": [], "ignore_metrics": ["frameCount"]}
+MACROBENCH_PERCENTILES = ("P50", "P90", "P95", "P99")   # 結果檔滑動類指標會有的百分位
+MACROBENCH_SAMPLED_JUDGED = ("P50", "P90")   # 滑動類只有百分位:這兩個過容差算退步
+MACROBENCH_SAMPLED_LISTED = ("P99",)         # P99 太吵:變慢只列出,不算退步
+MACROBENCH_ZERO_CROSS = {"frameOverrunMs": "P90"}   # 每幀超時從不大於 0 變成大於 0 = 開始掉幀,不看差幅
+
+
+def _macrobench_config_fields(raw, cfg):
+    """選填欄位驗型別並併進 cfg;回錯誤訊息或 None。"""
+    for k in ("tolerance_pct", "abs_tolerance"):
+        if k in raw:
+            if not _secev_num(raw[k]) or raw[k] <= 0:   # _secev_num:int/float 但不收 JSON 的 true/false
+                return f"macrobench.json 的 {k} 要是大於 0 的數字"
+            cfg[k] = float(raw[k])
+    for k in ("higher_is_better", "ignore_metrics"):
+        if k in raw:
+            if not isinstance(raw[k], list) or not all(isinstance(x, str) for x in raw[k]):
+                return f"macrobench.json 的 {k} 要是指標名稱字串的清單"
+            cfg[k] = list(raw[k])
+    return None
+
+
+def _macrobench_config(repo):
+    """讀 .lumos/macrobench.json。回 (cfg, None) / (None, 錯誤訊息) / (None, None)=沒接。"""
+    import json
+    path = Path(repo) / ".lumos" / "macrobench.json"
+    if not path.exists():
+        return None, None
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except Exception as e:
+        return None, f"macrobench.json 讀不了(JSON 格式壞了?): {e}"
+    if not isinstance(raw, dict):
+        return None, "macrobench.json 最外層要是物件"
+    dirs = raw.get("results_dirs")
+    if not isinstance(dirs, list) or not dirs or not all(isinstance(d, str) and d for d in dirs):
+        return None, "macrobench.json 要有 results_dirs:結果目錄的清單(相對 repo 根目錄的路徑字串)"
+    cfg = dict(MACROBENCH_DEFAULTS, results_dirs=dirs)
+    err = _macrobench_config_fields(raw, cfg)
+    return (None, err) if err else (cfg, None)
+
+
+def _macrobench_read_one(b, ignore):
+    """結果檔裡的一項 benchmark → (情境鍵, metrics, sampled)。格式不對丟 ValueError。
+    情境鍵 = 測試類別#測試名,有參數時再接 [排序後的參數 JSON]。"""
+    import json
+    if not isinstance(b, dict) or not isinstance(b.get("className"), str) or not isinstance(b.get("name"), str):
+        raise ValueError("benchmarks 裡每一項要有 className 與 name")
+    key = f"{b['className']}#{b['name']}"
+    if b.get("params"):
+        key += "[" + json.dumps(b["params"], sort_keys=True, ensure_ascii=False) + "]"
+    metrics, sampled = {}, {}
+    for name, v in (b.get("metrics") or {}).items():
+        if name in ignore:
+            continue
+        if not isinstance(v, dict) or not all(_secev_num(v.get(s)) for s in ("median", "minimum", "maximum")):
+            raise ValueError(f"{key} 的 {name} 缺 median/minimum/maximum")
+        metrics[name] = {s: float(v[s]) for s in ("median", "minimum", "maximum")}
+    for name, v in (b.get("sampledMetrics") or {}).items():
+        if name in ignore:
+            continue
+        stats = {s: float(v[s]) for s in MACROBENCH_PERCENTILES if isinstance(v, dict) and _secev_num(v.get(s))}
+        if not all(s in stats for s in MACROBENCH_SAMPLED_JUDGED):
+            raise ValueError(f"{key} 的 {name} 缺 P50/P90")
+        sampled[name] = stats
+    return key, metrics, sampled
+
+
+def _macrobench_read_file(path, ignore):
+    """讀一個 Macrobenchmark 結果檔 → {情境鍵: {device, metrics, sampled}}。格式不對丟 ValueError。"""
+    import json
+    data = json.loads(Path(path).read_text(encoding="utf-8"))
+    if not isinstance(data, dict) or not isinstance(data.get("benchmarks"), list):
+        raise ValueError("最外層要是物件、要有 benchmarks 清單")
+    build = ((data.get("context") or {}).get("build") or {})
+    device = {"model": str(build.get("model", "")), "fingerprint": str(build.get("fingerprint", ""))}
+    out = {}
+    for b in data["benchmarks"]:
+        key, metrics, sampled = _macrobench_read_one(b, ignore)
+        out[key] = {"device": device, "metrics": metrics, "sampled": sampled}
+    return out
+
+
+def _macrobench_collect(repo, cfg):
+    """掃設定的結果目錄底下所有 *-benchmarkData.json(含子目錄;檔名裡套件名的點會被換成底線,不能拼檔名)。
+    回 (entries, failed, n_files);同一個情境出現在兩個檔 → 兩個都不收、記進 failed。"""
+    entries, failed, seen, n_files = {}, [], {}, 0
+    for d in cfg["results_dirs"]:
+        base = Path(repo) / d
+        if not base.is_dir():
+            failed.append({"file": d, "reason": "結果目錄不存在", "kind": "missing_dir"})
+            continue
+        for f in sorted(base.rglob("*-benchmarkData.json")):
+            n_files += 1
+            rel = os.path.relpath(f, repo)
+            try:
+                got = _macrobench_read_file(f, set(cfg["ignore_metrics"]))
+            except Exception as e:
+                failed.append({"file": rel, "reason": f"讀不了:{e}", "kind": "unreadable"})
+                continue
+            for k, v in got.items():
+                if k in seen:
+                    failed.append({"file": rel, "reason": f"{k} 重複出現(也在 {seen[k]}),兩份都不收", "kind": "duplicate"})
+                    entries.pop(k, None)
+                    continue
+                seen[k] = rel
+                entries[k] = v
+    return entries, failed, n_files
+
+
+def _macrobench_worse(metric, base, cur, cfg):
+    """回 (變差了多少, 容差);變快或持平時差值 ≤ 0。容差 = max(|基準|×容差百分比, 絕對容差):
+    基準是負數也按絕對值算比例、基準是 0 時就是絕對容差;接近 0 的指標(例如每幀超時)只靠比例會被正常抖動誤報。"""
+    delta = (base - cur) if metric in cfg["higher_is_better"] else (cur - base)
+    tol = max(abs(base) * cfg["tolerance_pct"] / 100.0, cfg["abs_tolerance"])
+    return delta, tol
+
+
+def _macrobench_cmp_metrics(key, base, cur, cfg, res):
+    """啟動類(有 median/min/max):中位數慢超過容差,而且超出基準那次的浮動範圍,兩道都過才算退步。"""
+    for metric, c in sorted(cur["metrics"].items()):
+        b = (base.get("metrics") or {}).get(metric)
+        if not b:
+            continue
+        delta, tol = _macrobench_worse(metric, b["median"], c["median"], cfg)
+        outside = c["median"] < b["minimum"] if metric in cfg["higher_is_better"] else c["median"] > b["maximum"]
+        if delta > tol and outside:
+            res["regressions"].append({"key": key, "metric": metric, "stat": "median",
+                                       "baseline": b["median"], "current": c["median"], "delta": delta})
+
+
+def _macrobench_cmp_sampled(key, base, cur, cfg, res):
+    """滑動類(只有百分位):P50/P90 過容差算退步,P99 只列出;每幀超時跨零不看差幅。"""
+    for metric, c in sorted(cur["sampled"].items()):
+        b = (base.get("sampled") or {}).get(metric)
+        if not b:
+            continue
+        for stat in MACROBENCH_SAMPLED_JUDGED + MACROBENCH_SAMPLED_LISTED:
+            if stat not in b or stat not in c:
+                continue
+            delta, tol = _macrobench_worse(metric, b[stat], c[stat], cfg)
+            crossed = MACROBENCH_ZERO_CROSS.get(metric) == stat and b[stat] <= 0 < c[stat]
+            if not (delta > tol or crossed):
+                continue
+            rec = {"key": key, "metric": metric, "stat": stat, "baseline": b[stat], "current": c[stat], "delta": delta}
+            if crossed:
+                rec["zero_crossed"] = True
+            res["regressions" if stat in MACROBENCH_SAMPLED_JUDGED else "listed"].append(rec)
+
+
+def _macrobench_compare(baseline, current, cfg):
+    """比基準與現況。回 regressions(算退步)、listed(只列出)、new、missing、device_changed、checked。"""
+    res = {"regressions": [], "listed": [], "new": [], "missing": [], "device_changed": [], "checked": 0}
+    for key in sorted(current):
+        cur = current[key]
+        if key not in baseline:
+            res["new"].append(key)
+            continue
+        base = baseline[key]
+        if base.get("device") != cur["device"]:
+            res["device_changed"].append({"key": key, "baseline": base.get("device"), "current": cur["device"]})
+            continue
+        res["checked"] += 1
+        _macrobench_cmp_metrics(key, base, cur, cfg, res)
+        _macrobench_cmp_sampled(key, base, cur, cfg, res)
+    res["missing"] = sorted(k for k in baseline if k not in current)
+    return res
+
+
+def _macrobench_entry_ok(e):
+    """基準檔的一項要跟讀結果檔產出的形狀一樣(見 _macrobench_read_one):啟動類三個統計值都是數字;
+    滑動類只能有 P50–P99 這幾個鍵、全是數字,P50/P90 必有;device 是物件。比對會讀到的每個值都先驗過,才不會噴例外。"""
+    if not isinstance(e, dict) or not isinstance(e.get("device"), dict):
+        return False
+    metrics, sampled = e.get("metrics", {}), e.get("sampled", {})
+    if not isinstance(metrics, dict) or not isinstance(sampled, dict):
+        return False
+    if not all(isinstance(v, dict) and all(_secev_num(v.get(s)) for s in ("median", "minimum", "maximum"))
+               for v in metrics.values()):
+        return False
+    return all(isinstance(v, dict) and set(v) <= set(MACROBENCH_PERCENTILES) and all(_secev_num(x) for x in v.values())
+               and all(s in v for s in MACROBENCH_SAMPLED_JUDGED) for v in sampled.values())
