+    if not bpath.exists():
+        return {}, True, False
+    try:
+        entries = json.loads(bpath.read_text(encoding="utf-8"))["entries"]
+        if isinstance(entries, dict) and all(_macrobench_entry_ok(e) for e in entries.values()):
