+        why = "從準時變成掉幀" if r.get("zero_crossed") else f"慢了 {r['delta']:.1f}"
+        print(f"  [變慢] {r['key']} {r['metric']} {r['stat']}:{r['baseline']:.1f} → {r['current']:.1f}({why})")
+    for r in res["listed"]:
+        print(f"  [僅列出] {r['key']} {r['metric']} {r['stat']}:{r['baseline']:.1f} → {r['current']:.1f}(P99 浮動大,不算退步)")
+    for d in res["device_changed"]:
+        print(f"  [換了裝置,沒比] {d['key']}:基準是 {d['baseline'].get('model')},這次是 {d['current'].get('model')}")
+    if res["new"]:
+        print(f"  基準裡沒有、這次新出現的情境:{', '.join(res['new'])}")
+    if res["missing"]:
