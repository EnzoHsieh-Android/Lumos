+def _macrobench_print(res, cfg):
+    """把比對結果印成給人看的文字。"""
+    if res["baseline_missing"]:
+        print("還沒有基準:這次的結果先存成基準,之後才比得出有沒有變慢:")
+        print("    lumos macrobench --update-baseline")
+    elif res["baseline_unreadable"]:
+        print("基準檔讀不了,這次沒比。修好它,或刪掉後重存基準。")
+    else:
+        _macrobench_print_diff(res, cfg)
+    for f in res["failed"]:
+        label = "重複情境,沒收" if f.get("kind") == "duplicate" else "讀不了"
+        print(f"  {label} {f['file']}:{f['reason']}")
+
+
+def _macrobench_print_diff(res, cfg):
+    """有基準時的比對結果:變慢、僅列出、換裝置、新出現、沒跑到。"""
+    regs = res["regressions"]
+    print(f"比了 {res['checked']} 個情境,{len(regs)} 項變慢(容差 {cfg['tolerance_pct']:g}%;只提醒,不擋推送)。")
