+        return _r("warn")
+    if not isinstance(v, str) or v not in _NS_TR_MODES:
+        return _r("warn", [f"note_shape.test_refs={json.dumps(v, ensure_ascii=False)} 看不懂(只認小寫 block/warn/off),照 warn"], True)
+    return _r(v)
+
+
+def _ns_test_refs_mode(gate_mode, cfg_text, staged):
+    """總開關與子開關合起來 → (block|warn|off, 設定提醒):總開關 off 整組不跑、warn 也只提醒;提交時一律只提醒。"""
+    r = _note_shape_test_refs_parse(cfg_text)
+    if gate_mode == "off" or r["mode"] == "off":
+        return "off", r["warns"]
+    if staged or gate_mode == "warn":
+        return "warn", r["warns"]
+    return r["mode"], r["warns"]
+
+
+def _test_names_of(sp, key="test"):
+    """slot_parse 結果裡 test 或 test-gone 鍵的名稱 → (名稱清單, 有沒有空的方括號)。note-shape 與 doctor S20 共用。
+    半形或全形逗號切開、去空白與空項、去掉包住名稱的反引號(索引那邊 Kotlin 反引號測試名也是去掉後收);
+    平台前綴認半形或全形冒號(換成半形、去掉前綴與名稱間的空白);test-gone 去掉 @提交。名稱是空的留 ""。"""
+    names, empty = [], False
+    for k, v, err in sp["fields"]:
+        if k != key or err:
+            continue
+        items = [x.strip() for x in _NS_TR_SPLIT_RE.split(v)]
+        items = [x for x in items if x]
+        if not items:
+            empty = True
+        for x in items:
+            pre, nm = "", x
+            m = _NS_TR_PREFIX_RE.match(x)
+            if m:
+                pre, nm = m.group(1) + ":", x[m.end():]
+            if key == "test-gone":
+                nm = nm.split("@", 1)[0]
+            nm = nm.strip()
+            if len(nm) >= 2 and nm[0] == nm[-1] == "`":
+                nm = nm[1:-1].strip()
+            names.append(pre + nm if nm else "")
+    return names, empty
+
+
+def _ns_tr_placeholder(nm):
+    return nm.rsplit(":", 1)[-1].strip().lower() in _NS_TR_PLACEHOLDERS
+
+
+def _ns_test_ref_lines(rel, text):
+    """一篇筆記 → [(行號, 區 summary|body, 前綴或 None, slot_parse 結果, 種類 contract|clause|plain)],依行號排。
+    摘要條目用 doctor S16 到 S19 同一支 _note_summary_entries(區塊寫法接回續行、單行寫法整個值算一條);
+    正文一個實體行(圍欄裡的不算;HTML 註解照算——全檔可見性零件都不偵測註解,偵測本身是洞);
+    條款定義行取 clause_bindings 回的 defined 行號(只看 type: project;重複定義的第二行照一般正文行)。"""
+    n = _note_from_text(rel, text)
+    out = []
+    for no, line in _note_summary_entries(n).items():
+        pf, _s, rest = line.partition(":")
+        out.append((no, "summary", pf.strip(), slot_parse(rest), "contract" if INVARIANT_RE.match(line) else "plain"))
+    clause = set()
+    if n.fields.get("type") == "project" and "[S" in text:
+        try:      # 只要行號:分類用空的索引(純函式,不建真索引)
+            clause = {r["line"] for r in clause_bindings(text, {}, None, lambda _p: set(), lambda _p: "") if r.get("defined")}
+        except Exception:
+            clause = set()
+    regions = _notelines_regions(text)
+    for no, raw in _visible_lines(text.split("\n")):
+        if no > len(regions) or regions[no - 1] != "body" or "[" not in raw:
+            continue
+        sp = slot_parse(raw)
+        if sp["fields"]:
+            out.append((no, "body", None, sp, "clause" if no in clause else "plain"))
+    return sorted(out, key=lambda x: x[0])
+
+
+def _ns_tr_fix_dead(pf, nm, why):
+    pit = pf == "PITFALL"
+    s = ("改成真的測試名;測試已刪就寫 [test-gone:名稱]" + ("(PITFALL 另要 [防回歸:無 理由] 或 [repro:指令])" if pit else "")
+         + ";沒有測試就拿掉" + (",改寫 [防回歸:無 理由] 或 [repro:指令]" if pit else ""))
+    if why == "bad-name" and ":" in nm:
+        s += ";看起來是人工驗證就改用 [manual:一句怎麼驗]"
+    return s
+
+
+def _ns_tr_fix_missing(pf, empty=False):
+    if pf == "PITFALL":
+        return "改成真的測試名,或改寫 [防回歸:無 理由] 或 [repro:指令]"
+    return "改成真的測試名,或拿掉" + (";摘要裡要提到這個標記本身就包反引號寫成 `[test:]`" if empty else "")
+
+
+def _ns_tr_fix_retired(kind, pf):
+    if kind == "contract":
+        return "合約行整行刪掉,或拿掉 ★INVARIANT★ 記號降成一般條目再移走或拿掉綁定(只拿掉 [test:] 會變成裸合約,doctor --ci 照擋)"
+    if kind == "clause":
+        return "改寫成 [manual:已撤除,見 被取代 指的那裡](拿掉會變成沒標,spec-trace 會唸);測試還在,別改成 [test-gone:]"
+    s = "把綁定移到接手的那一條([被取代:] 指的那裡)或拿掉;測試還在,別改成 [test-gone:]"
+    return s + (";拿掉後補 [防回歸:無 已作廢]" if pf == "PITFALL" else "")
+
+
+def _ns_tr_retired(sp):
+    return any(k == "status" and v.lower() == "superseded" for k, v, e in sp["fields"] if not e)
+
+
+def _ns_tr_test_viol(rel, no, pf, kind, nm, retired, judge):
+    """一個 [test:] 名稱 → 違規或 None:佔位字先於判存在;指不到;作廢還掛活測試。"""
+    if _ns_tr_placeholder(nm):
+        return (rel, no, "佔位字", nm, _ns_tr_fix_missing(pf))
+    st, why = judge(nm)
+    if st == "no":
+        return (rel, no, f"指不到真測試({why})", nm, _ns_tr_fix_dead(pf, nm, why))
+    if st == "yes" and retired:
+        return (rel, no, "作廢的條目還掛活測試", nm, _ns_tr_fix_retired(kind, pf))
+    return None
+
+
+def _ns_tr_gone_viol(rel, no, nm, judge):
+    """一個 [test-gone:] 名稱 → 違規或 None:空的、佔位字、測試還在。"""
+    fix = "寫上被刪的測試名;不知道名字就整個拿掉"
+    if not nm:
+        return (rel, no, "[test-gone:] 名稱是空的", "", fix)
+    if _ns_tr_placeholder(nm):
+        return (rel, no, "[test-gone:] 寫的是佔位字", nm, fix)
+    if judge(nm)[0] == "yes":
+        return (rel, no, "[test-gone:] 的測試還在", nm, "測試還在就改回 [test:名稱]")
+    return None
+
+
+def _ns_tr_line_violations(rel, no, reg, pf, sp, kind, judge):
+    """一條(摘要條目或正文行)→ 違規清單。合約行與條款定義行只查「作廢還掛活測試」。"""
+    tests, empty = _test_names_of(sp, "test")
+    retired = _ns_tr_retired(sp)
+    if kind != "plain":
+        live = [nm for nm in tests if retired and nm and not _ns_tr_placeholder(nm) and judge(nm)[0] == "yes"]
+        return [(rel, no, "作廢的條目還掛活測試", nm, _ns_tr_fix_retired(kind, pf)) for nm in live]
+    out = [(rel, no, "[test:] 方括號裡沒有名稱", "", _ns_tr_fix_missing(pf, empty=True))] if (empty and reg == "summary") else []
+    out += [v for v in (_ns_tr_test_viol(rel, no, pf, kind, nm, retired, judge) for nm in tests if nm) if v]
+    gones, gempty = _test_names_of(sp, "test-gone")
+    out += [v for v in (_ns_tr_gone_viol(rel, no, nm, judge) for nm in dict.fromkeys(gones + ([""] if gempty else []))) if v]
+    keys = {k for k, _v, e in sp["fields"] if not e}
+    if pf == "PITFALL" and "test-gone" in keys and not keys & {"test", "repro", "防回歸"}:
+        out.append((rel, no, "PITFALL 只剩 [test-gone:]", "",
+                    "補 [防回歸:無 理由] 或 [repro:指令]([test-gone:] 只是紀錄,不算防回歸)"))
+    return out
+
+
+def _ns_test_ref_violations(rel, text, judge):
+    """〈做法〉3 五項 → [(rel, 行號, 原因, 名稱, 改法)]。judge(名稱) → (yes|no|undecidable|skip, 細節)。"""
+    out = []
+    for no, reg, pf, sp, kind in _ns_test_ref_lines(rel, text):
+        out += _ns_tr_line_violations(rel, no, reg, pf, sp, kind, judge)
+    return out
+
+
+def _ns_tr_profile(prof):
+    """load_platforms 給的 profile 可能是名字或已展開的 dict(同表態閘的取法)。"""
+    return prof if isinstance(prof, dict) else (TEST_PROFILES.get(prof) or {})
+
+
+class _NsTrJudge:
+    """每個名稱判指得到 / 指不到 / 判不了:呼叫 → (yes|no|undecidable|skip, 細節)。tip 是 None(提交時、doctor)只做第①道。
+    第①道 _classify_test_refs 判 real 才過;推送時再到終點用 _test_in_tree 找(類別.方法找最後一段,同第①道的取法);
+    找不到但平台根落在子模組底下或底下有子模組 → 判不了。名稱一次快取;時間用完、逾時的不快取。
+    一個步驟一個方法(比照 _NotelinesNet 的寫法),狀態放 st 給呼叫端印。"""
+
+    def __init__(self, repo_root, tip, pidx, budget=_NS_TR_BUDGET):
+        self.root, self.tip, self.budget = repo_root, tip, budget
+        self.pdata, self.split, self.default, self.methods_for, self.hay_for, _loose = pidx
+        self.st = {"t0": time.monotonic(), "out": False, "notes": [], "gitlinks": None, "plat_skip": set()}
+        self.cache = {}
+
+    def left(self):
+        return None if self.budget is None else self.budget - (time.monotonic() - self.st["t0"])
+
+    def __call__(self, nm):
+        if nm in self.cache:
+            return self.cache[nm]
+        if self._out_of_time():
+            return ("skip", "時間用完")
+        plat, why = self._plat(nm)
+        if plat is None:
+            r = ("no", why)
+        else:
+            mset = self._mset(plat)
+            if mset is None:
+                return ("skip", "平台跳過")
+            r = self._judge(nm, plat, mset)
+            if r is None:
+                return ("undecidable", "逾時")
+        self.cache[nm] = r
+        return r
+
+    def _out_of_time(self):
+        left = self.left()
+        if not self.st["out"] and (left is None or left > 0):
+            return False
+        if not self.st["out"]:
+            self.st["notes"].append(f"這組的 {self.budget:.0f} 秒用完了,剩下的名稱這次不查")
+        self.st["out"] = True
+        return True
+
+    def _plat(self, nm):
+        if any(c in nm for c in "[]"):
+            return None, "bad-name"
+        try:
+            pairs = resolve_test_refs(f"[test:{nm}]", self.split, self.default)
+        except ValueError:
+            return None, "bad-name"
+        return (pairs[0][0], "") if pairs else (None, "bad-name")
+
+    def _mset(self, plat):
+        """那個平台的測試方法集合;建不起來或是空的 → 記一行、回 None(這個平台這次不查)。"""
+        if plat in self.st["plat_skip"]:
+            return None
+        err = ""
+        try:
+            mset = self.methods_for(plat)
+        except Exception as e:
+            mset, err = None, f"({e.__class__.__name__})"
+        if mset:
+            return mset
+        self.st["plat_skip"].add(plat)
+        self.st["notes"].append(f"平台 {plat} 的測試索引建不起來或掃不到任何測試方法(根不存在?),這次不查這個平台的名稱{err}")
+        return None
+
+    def _judge(self, nm, plat, mset):
+        _n, _p, method, cls = _classify_test_refs(f"[test:{nm}]", None, self.split, self.default,
+                                                  self.methods_for, self.hay_for)[0]
+        if cls != "real":
+            return ("no", cls)
+        if not self.tip:
+            return ("yes", "")
+        r = self._tree(nm, plat, method if method in mset else method.rsplit(".", 1)[-1])
+        if r is not None and r[0] == "undecidable":
+            self.st["notes"].append(f"{nm}:判不了({r[1]}),不擋")
+        return r
+
+    def _tree(self, nm, plat, gname):
+        """第②道:到推送版本找 → 判定;逾時回 None(呼叫端當判不了、不快取)。"""
+        import subprocess as _sp
+        p = self.pdata["platforms"].get(plat) or {}
+        left = self.left()
+        try:
+            oc, detail = _test_in_tree(self.root, self.tip, p.get("root"), p.get("profile"), gname,
+                                       _NS_TR_GREP_CAP if left is None else max(0.1, min(_NS_TR_GREP_CAP, left)))
+        except _sp.TimeoutExpired:
+            self.st["out"] = True
+            self.st["notes"].append(f"{nm}:到推送版本找的 git 逾時,這個與剩下的名稱這次不查")
+            return None
+        if oc == "found":
+            return ("yes", "")
+        if oc != "notfound":
+            return ("undecidable", detail or oc)
+        if self._submodule_hit(p.get("root")):
+            return ("undecidable", "平台根跟子模組有關")
+        return ("no", "推送的版本裡找不到,測試還沒提交?")
+
+    def _submodule_hit(self, plat_root):
+        """終點的樹裡,平台根落在某個子模組底下(含等於它)、或平台根底下有子模組。子模組清單一次推送查一次。"""
+        if self.st["gitlinks"] is None:
+            r = _lens_git(self.root, "ls-tree", "-r", "-z", self.tip)
+            rows = r.stdout.split("\0") if r is not None and r.returncode == 0 else []
+            self.st["gitlinks"] = [x.split("\t", 1)[1] for x in rows if x.startswith("160000 ") and "\t" in x]
+        try:
+            rel = Path(plat_root).resolve().relative_to(Path(self.root).resolve()).as_posix()
+        except ValueError:
+            return False
+        rel = "" if rel == "." else rel
+        return any(not rel or rel == g or rel.startswith(g + "/") or g.startswith(rel + "/") for g in self.st["gitlinks"])
+
+
+def _ns_tr_judge(repo_root, tip, pidx, budget=_NS_TR_BUDGET):
+    """→ (judge, 狀態);judge 是 _NsTrJudge(可呼叫),狀態裡的 notes 是要印給人看的「判不了/跳過」原因。"""
+    j = _NsTrJudge(repo_root, tip, pidx, budget)
+    return j, j.st
+
+
+def _ns_tr_guard(repo_root, tip, pdata):
+    """推送時工作目錄跟被推的版本對不上的三種 → 原因字串或 None(〈做法〉5)。"""
+    import fnmatch as _fn
+    if _lens_full_sha(repo_root, "HEAD") != tip:
+        return "目前簽出的提交不是推送終點(推的分支不是目前這條)"
+    r = _lens_git(repo_root, "diff", "HEAD", "--name-only", "-z")
+    if r is None or r.returncode != 0:
+        return "git 讀不到工作目錄的改動"
+    if ".lumos/config.json" in [x for x in r.stdout.split("\0") if x]:
+        return ".lumos/config.json 有沒提交的改動"
+    r = _lens_git(repo_root, "diff", "HEAD", "--name-only", "-z", "--diff-filter=MD")
+    md = [x for x in (r.stdout.split("\0") if r is not None and r.returncode == 0 else []) if x]
+    rr = Path(repo_root).resolve()
+    for p in pdata["platforms"].values():
+        try:
+            rel = Path(p["root"]).resolve().relative_to(rr).as_posix()
+        except (ValueError, KeyError, TypeError):
+            continue
+        prof = _ns_tr_profile(p.get("profile"))
+        globs, exts = prof.get("file_name_match") or [], prof.get("exts") or []
+        for f in md:
+            if f.startswith(("docs/", "governance/")) or (rel not in (".", "") and not f.startswith(rel.rstrip("/") + "/")):
+                continue
+            base = f.rsplit("/", 1)[-1]
+            if any(_fn.fnmatch(base, g) for g in globs) if globs else any(base.endswith(e) for e in exts):
+                return f"已追蹤的測試檔 {f} 有沒提交的修改或刪除"
+    return None
+
+
+def _ns_tr_touched(notes):
+    """碰到的筆記 → [(路徑, 全文, 新寫行號集合)]:新寫行至少一行在 body/summary 區或是 summary: 鍵行本身(單行寫法);
+    只改其他開頭欄位、只刪行、改名、合進來的主線都不算。沒有任何 [test 標記的篇不必判。"""
+    out = []
+    for p, text, rows in notes:
+        hit = any(reg in ("body", "summary") or (reg == "other" and _NS_TR_SUMMARY_KEY_RE.match(ln)) for _i, ln, reg in rows)
+        if hit and _NS_TR_HAS_REF_RE.search(text):
+            out.append((p, text, {i for i, _l, _r in rows}))
+    return sorted(out, key=lambda x: x[0])
+
+
+def _ns_test_refs_collected(root, staged, tip, cfg_text, gate_mode, notes, quiet=False):
+    """eval 之後跑這組 → (有效模式, 違規, 資訊 {"new": {(路徑, 行號): 在不在新寫行上}})。
+    任何一步丟例外 → 印一句、當作沒有(fail-open,同這道檢查其他失敗)。"""
+    def say(s):
+        if not quiet:
+            print(s, file=sys.stderr)
+    try:
+        trmode, warns = _ns_test_refs_mode(gate_mode, cfg_text, staged)
+        for w in (warns if trmode != "off" else []):
+            say(f"提醒:{w}")
+        touched = _ns_tr_touched(notes) if trmode != "off" else []
+        if not touched:
+            return trmode, [], None
+        pidx = _platform_test_index(root)
+        judge, st = _ns_tr_judge(root, None if staged else tip, pidx)
+        viol, new = [], {}
+        for p, text, rows_new in touched:
+            for v in _ns_test_ref_violations(p, text, judge):
+                viol.append(v)
+                new[(v[0], v[1])] = v[1] in rows_new
+        for s in st["notes"]:
+            say(f"筆記測試綁定:{s}")
+        why = _ns_tr_guard(root, tip, pidx[0]) if (viol and trmode == "block" and not staged) else None
+        if why:
+            say(f"提醒:筆記測試綁定這次只提醒不擋——{why};工作目錄的測試索引跟被推的版本對不上,交給 CI(CI 的工作目錄就是終點)")
+            trmode = "warn"
+        return trmode, viol, {"new": new}
+    except Exception as e:
+        say(f"提醒:筆記測試綁定這次沒查({e.__class__.__name__}),不影響其他檢查")
+        return "off", [], None
+
+
+def _ns_tr_extra(trmode, trviol, info):
+    """治理帳 extra.test_refs:這組自己的模式與有沒有擋、條數、前 20 個(名稱、原因、筆記、在不在這次新寫的行上)。"""
+    new = (info or {}).get("new") or {}
+    return {"mode": trmode, "blocked": trmode == "block", "n": len(trviol),
+            "items": [{"name": nm[:80], "reason": why, "note": p, "new": bool(new.get((p, n)))}
+                      for p, n, why, nm, _fix in trviol[:20]]}
+
+
+def _ns_tr_format(trmode, trviol, mode_word):
+    head = "擋下" if trmode == "block" else "提醒(這組只提醒,不擋)"
+    lines = [f"{head}:{mode_word}{_NS_TR_HEAD}(碰到的筆記整篇要乾淨,舊行上的也算)——"]
+    for p, n, why, nm, fix in trviol:
+        lines.append(f"  {_esc_clean(p, 200)}:{n}  {why} {_esc_clean(nm, 80)}:{fix}")
+    lines.append("為什麼:筆記寫 [test:名稱] 是在說有這支測試守著,指不到就是假的守衛——見 Projects/筆記測試綁定要存在_計劃。"
+                 "只關這組:.lumos/config.json 的 note_shape.test_refs 設成 warn(或 off);誤擋就 LUMOS_SKIP_NOTE_SHAPE=1 單次跳過(會留帳)。")
+    return "\n".join(lines)
