+def _doctor_test_ref_lines(env, repo_root):
+    """doctor S20:全庫每一篇照〈做法〉3 判(判存在只做第①道)→ {類別: [字串]};另列散文撤除候選。"""
+    pidx = _platform_test_index(repo_root)
+    judge, _st = _ns_tr_judge(repo_root, None, pidx, budget=None)
