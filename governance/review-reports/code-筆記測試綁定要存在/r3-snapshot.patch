+            if mset is None:
+                return ("skip", "平台跳過")
+            r = self._judge(nm, plat, mset)
+            if r is None:
+                return ("undecidable", "逾時")
+        self.cache[nm] = r
+        return r
+
+    def _out_of_time(self):
