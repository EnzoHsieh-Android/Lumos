+
+    def __call__(self, nm):
+        if nm in self.cache:
+            return self.cache[nm]
+        if self._out_of_time():
+            return ("skip", "時間用完")
+        plat, why = self._plat(nm)
+        if plat is None:
+            r = ("no", why)
+        else:
