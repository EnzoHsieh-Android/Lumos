  3265	            s = ln.lstrip(" ")
  3266	            # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
  3267	            is_marker = indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))
  3268	            if is_marker:
