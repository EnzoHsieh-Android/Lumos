 23501	def _note_shape_config(text):
 23502	    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
 23503	    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
 23504	    if text is None:
 23505	        return "block", []
 23506	    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 23507	    try:
 23508	        data = json.loads(raw)
 23509	    except Exception as e:
 23510	        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
 23511	    ns = data.get("note_shape") if isinstance(data, dict) else None
 23512	    if ns is None:
 23513	        return "block", []
 23514	    if not isinstance(ns, dict):
 23515	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23516	    g = ns.get("gate", "block")
 23517	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23518	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23519	    return g, []
 23520	
 23521	
 23522	def _notelines_regions(text):
 23523	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23524	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23525	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23526	    lines = text.split("\n")
 23527	    fm, _body = split_frontmatter(text)
 23528	    if fm is None:
 23529	        if text.startswith("---"):
 23530	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23531	        return ["body"] * len(lines)
 23532	    out = ["body"] * len(lines)
 23533	    end = len(fm) + 1                            # 收尾 --- 那一行
 23534	    out[0] = out[end] = "other"
 23535	    cur = "other"
 23536	    for i in range(1, end):
 23537	        ln = lines[i]
 23538	        m = TOP_KEY_RE.match(ln)
 23539	        if m:
 23540	            k = m.group(1)
 23541	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23542	            out[i] = "other"
 23543	            continue
 23544	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23545	    return out
 23546	
 23547	
 23548	def _notelines_parse_added(raw):
 23549	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23550	    out, path, n = {}, None, 0
 23551	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23552	        if ln.startswith("+++ "):
 23553	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23554	            path = nfc(p[2:]) if p.startswith("b/") else None
 23555	            continue
 23556	        if ln.startswith("@@"):
 23557	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23558	            n = int(m.group(1)) if m else 0
 23559	            continue
 23560	        if path is None or ln.startswith("---"):
 23561	            continue
 23562	        if ln.startswith("+"):
 23563	            out.setdefault(path, []).append((n, ln[1:]))
 23564	            n += 1
 23565	    return out
 23566	
