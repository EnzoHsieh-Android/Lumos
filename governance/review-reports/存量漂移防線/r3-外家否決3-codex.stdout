 14349	def _set_conditions_locked(env, rel, key, values):
 14350	    """驗收紀錄的前提/回頭條件整欄換掉(Projects/驗收前提欄位可改_計劃)。
 14351	
 14352	    ★為什麼整欄換、不走 append/remove★:這兩欄是散文、常提到連結;append/remove 判斷「同一項」看連結目標,
 14353	    兩條提到同一篇的不同條件會被當成重複。原本四種寫法(單行、清單、空的、多行區塊)並存,一律整段拿掉重寫。"""
 14354	    vals = [str(v).strip() for v in values]
 14355	    if not vals or any(not v for v in vals):
 14356	        print(f"擋下:{key} 的每一條都不能是空的,檔案沒動(前提寫這個結論在什麼情況下才算數,回頭條件寫改到什麼該重驗)",
 14357	              file=sys.stderr)
 14358	        return 2
 14359	    if any("\n" in v or "\r" in v for v in vals):
 14360	        print(f"擋下:{key} 一條條件只能一行,檔案沒動(要寫多條就給多個值:lumos set <筆記> {key} \"條件一\" \"條件二\")",
 14361	              file=sys.stderr)
 14362	        return 2
 14363	    path = env.vault / rel
 14364	    lines, _s, e = load_raw_for_edit(path)
 14365	    fm = list(lines[1:e])
 14366	    new = ([f"{key}: {fmt_scalar(key, vals[0])}"] if len(vals) == 1
 14367	           else [f"{key}:"] + [f"  - {fmt_scalar(key, v)}" for v in vals])
 14368	    struct = {k: (a, b) for k, a, b, _kind in fm_structure(fm)}
 14369	    if key in struct:
 14370	        a, b = struct[key]
 22380	    Python 那份把 scripts 當測試資料夾、Playwright 的 tests/e2e 不限位置,錨定太鬆會把真程式檔放掉。"""
 22381	    global _NODEHOME_STACK_TEST_DIRS
 22382	    if _NODEHOME_STACK_TEST_DIRS is None:
 22383	        sufs, under_src = {}, {}
 22384	        for prof in TEST_PROFILES.values():
 22385	            names = {d for inc, _exc in prof.get("dirs", {}).values() for d in inc if d}
 22386	            if prof.get("dir_mode") == "suffix":
 22387	                for d in names:
 22388	                    sufs.setdefault(d, set()).update(prof.get("exts", ()))
 22389	            elif prof.get("rglob_under") == "src":
 22390	                for d in names:
 22391	                    under_src.setdefault(d, set()).update(prof.get("exts", ()))
 22392	        _NODEHOME_STACK_TEST_DIRS = ({k: frozenset(v) for k, v in sufs.items()}, {k: frozenset(v) for k, v in under_src.items()})
 22393	    return _NODEHOME_STACK_TEST_DIRS
