 22421	def _nodehome_in_stack_test_dir(path, layout):
 22422	    """在各棧的測試資料夾裡——兩種都要「旁邊的程式目標有同一種檔」,只看資料夾名會把業務資料夾放掉
 22423	    (2026-09-12 代碼審兩輪各席造出的反例:A/B 測試功能模組 ABTests/、Python 專案的 LoadTests/、
 22424	    scriptsTests/ 裡的 .cs、src/androidTest 裡的 .py):
 22425	    ① 頂層資料夾 = <X> 加對照表的結尾樣式(PosTerminalTests/、PosTerminalUITests/、Foo.IntegrationTests/),
 22426	       副檔名屬於貢獻那個結尾的棧,而且頂層的 <X> 資料夾裡有同一種副檔名的檔(Xcode 的 App 配 AppTests、
 22427	       .NET 的 Foo 配 Foo.Tests);資料夾就叫結尾樣式本身(UITests/、IntegrationTests/)的直接認;
 22428	    ② 緊接在 src 下一層的對照表測試資料夾名(app/src/androidTest/…),副檔名屬於貢獻那個名字的棧(Kotlin),
 22429	       而且同一個模組的 src/main 有同一種副檔名的檔——只看 src/main 有沒有同副檔名的檔,混在 src/main 的建置腳本
 22430	       (.py、.sh)就能讓 androidTest 裡同副檔名的檔免家(代碼審第三輪四席各自造出反例)。
 22431	    別種語言的測試輔助檔(Xcode 測試資料夾裡的橋接標頭 .h、Java 寫的 androidTest 輔助檔——對照表沒有 Java 棧)照舊要家:
 22432	    寧可過嚴,逃生口是 node_home.ignore;要認就把那一棧補進測試棧對照表,這裡自動跟著認。
 22433	    layout=_nodehome_layout 的結果。對不上的照舊要家(過嚴、不漏)。"""
 22434	    sufs, under_src = _nodehome_stack_test_dirs()
 22435	    top_exts, main_exts = layout
 22436	    parts = path.split("/")
 22437	    e = _testmap_ext(path)
 22438	    if len(parts) < 2 or not e:
 22439	        return False
 22440	    ext, top = "." + e, parts[0]
 22441	    for suf, exts in sufs.items():
 22442	        if ext not in exts or not top.endswith(suf):
 22443	            continue
 22444	        base = top[:-len(suf)].rstrip(".")
 22445	        if not base or ext in top_exts.get(base, ()):
 22446	            return True
 22447	    for i in range(1, len(parts) - 1):
 22448	        if parts[i - 1] == "src" and ext in under_src.get(parts[i], ()) and ext in main_exts.get("/".join(parts[:i]), ()):
 22449	            return True
 22450	    return False
