 14016	def edit_fm_append(fm_lines, key, value):
 14017	    fm = list(fm_lines)
 14018	    item = fmt_list_item(value)
 14019	    tgt = link_target(value)
 14020	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14021	    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
 14022	        cur = _list_scalar_value(fm, key, struct[key][0])
 14023	        if cur and link_target(cur) == tgt:
 14024	            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
 14025	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14026	        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14027	    if key in struct:
 14028	        s, e, kind = struct[key]
 14029	        if kind != "list":
 14030	            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
 14031	        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
 14032	        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
 14033	            fm[s] = f"{key}:"
 14034	        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
 14035	        for j in range(s + 1, e + 1):
 14036	            existing = fm[j].strip()
 14037	            if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14038	                return fm  # 已存在,no-op
 14039	        # 偵測現有項縮排,否則預設 2 空格
 14040	        indent = "  "
 14041	        for j in range(s + 1, e + 1):
 14042	            if fm[j].lstrip().startswith("-"):
 14043	                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
 14044	                break
 14045	        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
 14046	        last = e
 14047	        while last > s and not fm[last].strip():
 14048	            last -= 1
 14049	        fm.insert(last + 1, f"{indent}- {item}")
 14050	    else:
 14051	        ins = len(fm)
 14052	        fm.insert(ins, key + ":")
 14053	        fm.insert(ins + 1, f"  - {item}")
 14054	    return fm
 14055	
 14056	
 14057	def edit_fm_remove(fm_lines, key, value):
 14058	    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。
 14059	
 14060	    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
 14061	    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
 14062	    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
 14063	    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
 14064	    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
 14065	    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
 14066	    fm = list(fm_lines)
 14067	    tgt = link_target(value)
 14068	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14069	    if key not in struct:
 14070	        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
 14071	    if struct[key][2] == "scalar" and key in LIST_KEYS:
 14072	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14073	        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14074	    s, e, kind = struct[key]
 14075	    if kind != "list":
 14076	        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
 14077	    hits = []
 14078	    for j in range(s + 1, e + 1):
 14079	        existing = fm[j].strip()
 14080	        if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14081	            hits.append(j)
 14082	    if not hits:
 14083	        return fm, 0
 14084	    for j in reversed(hits):
 14085	        del fm[j]
 14086	    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
 14087	    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14088	    if key in struct2:
 14089	        s2, e2, _ = struct2[key]
 14090	        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
 14091	            del fm[s2:e2 + 1]
 14092	    return fm, len(hits)
 14093	
