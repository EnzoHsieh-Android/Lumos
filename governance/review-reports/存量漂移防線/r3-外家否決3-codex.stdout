 23548	def _notelines_parse_added(raw):
 23549	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23550	    out, path, n = {}, None, 0
 23551	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23552	        if ln.startswith("+++ "):
 23553	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23554	            path = nfc(p[2:]) if p.startswith("b/") else None
 23555	            continue
 23556	        if ln.startswith("@@"):
 23557	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23558	            n = int(m.group(1)) if m else 0
 23559	            continue
 23560	        if path is None or ln.startswith("---"):
 23561	            continue
 23562	        if ln.startswith("+"):
 23563	            out.setdefault(path, []).append((n, ln[1:]))
 23564	            n += 1
 23565	    return out
