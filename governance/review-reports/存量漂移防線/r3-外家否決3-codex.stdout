 23802	_NOTELINES_TABLE_SEP_RE = re.compile(r"^\s*[|:\-\s]*-[|:\-\s]*$")
 23803	_NOTELINES_RULE_RE = re.compile(r"^\s{0,3}(?:(?:-\s*){3,}|(?:\*\s*){3,}|(?:_\s*){3,})$")
 23804	_NOTELINES_BARE_LIST_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])(?:\s+\[[ xX]\])?\s*$")
