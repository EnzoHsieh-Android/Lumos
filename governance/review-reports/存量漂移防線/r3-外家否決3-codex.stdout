 succeeded in 0ms:
    if not successor or successor.strip() == loop_id.strip():
        print("擋下:--successor 要給新開的迴圈編號,而且不能跟舊編號一樣——重寫=換新編號載新版,同號沒有「重寫」可言", file=sys.stderr)
        return 2
    # 血緣一跳查詢:這個編號是不是已經是上一次重寫的產物?
    chain_prev = None
    try:
        import json as _j
        import re as _re
        gl = env.vault.parent / ".governance-log.jsonl"
        # 邊界比對:successor=<id> 後面必須是分號或字串結尾——裸子字串會讓前綴編號互撞
        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
        if gl.exists():
            for line in gl.read_text(encoding="utf-8").splitlines():
                try:
                    o = _j.loads(line)
                except ValueError:
                    continue
                if not isinstance(o, dict):
                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
                        and _pat.search(str(o.get("note", ""))):
                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
    except OSError:
        pass
    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
    if chain_prev:
        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
    print("  之後查血緣:")
    print("    lumos gov --stats")
    return 0


def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
                ref=None, nodes=None, extra=None):
    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。

    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。

    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
    逐 ref 的事件另外帶那一行真正的 sha。

    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
    """
    import json as _json
    import datetime as _dt
    root = Path(repo_root)
    docs = root / "docs"
    if not docs.is_dir():
        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
        return None
    if not head_sha:
        try:
            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
        except Exception:
            head_sha = ""
    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
    if gate not in _KNOWN_GATES:
        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
              file=sys.stderr)
        return False
    ev = {
        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "commit": (head_sha or "")[:7],
        "gate": gate, "kind": kind, "hard": bool(hard),
        "nodes": list(nodes or []), "note": note,
        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
        "detail": note,
    }
    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
    if att:
        ev["attempt_id"] = att[:64]
    if ref:
        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
        # 「目前不算功能性錯誤——新事件本來就不該被當成 marker」。
        # ★那句話講的是一個保護,不是一個不一致★——我第一次折的時候把它當成欄名不一致、
        # 順手加了 branch 別名,結果 blocked 事件當場被 _codeloop_read_from_ledger
        # 當成留痕讀走,既有測試翻紅。欄名對齊只做 note/detail 那一半,分支識別不對齊。
        ev["ref"] = ref
    if head_sha:
        ev["head_sha"] = head_sha
    if extra:
        ev.update(extra)
    try:
        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
        return True
    except OSError:
        return False


def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
    ok = _gate_event(repo_root, gate, kind, note, **kw)
    if ok is None:
        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
    if not ok:
        print(f"  ⚠ telemetry-write-failed:{gate} 這一筆帳寫不進去(判定不受影響,照原樣執行)",
              file=sys.stderr)
    return ok


def _sp_run_text(cmd):
    import subprocess as _sp
    return _sp.run(cmd, capture_output=True, text=True, errors="replace").stdout.strip()


    if not n:
        return "預告合約要給一個短名(--name)——不給的話,檔名只能拿合約原文截斷,會斷在句子中間"
    if len(n) > _GUARD_NAME_MAX:
        return f"短名太長({len(n)} 字,上限 {_GUARD_NAME_MAX} 字)"
    bad = sorted({c for c in n if not _GUARD_NAME_OK_RE.match(c)})
    if bad:
        return f"短名裡有檔名不能用的字:{' '.join(repr(c) for c in bad)}(只收字母、數字、中文、底線、連字號;不收空白與標點)"
    return None


def _guard_plan_check(env, node, claim, plan, phase, due, why, owner, name=None):
    """預告指令的入口檢查,全部擋下的理由集中在這裡。

    回 (rel, prel, phases, gname, gpath) 或 None(已經印過為什麼擋)。
    ★抽出來是因為主體分支太多★:檢查跟動手寫混在一支函式裡,靜態檢查判它複雜度 17(上限 10),
    而且讀的人要先跳過三十行檢查才看得到真正做事的那段。
    """
    import datetime
    # ★合約文字不准含換行★(代碼審 r1 blocker,實測會吃掉既有合約):
    # 摘要是 YAML block scalar,一個換行就把區塊打斷,後面每一行都變成別的欄位——
    # 同一篇裡原本綁了測試又審計過的真合約會整段從圖譜消失,而指令還回報成功。
    _c = (claim or "")
    if not _c.strip():
        print("擋下:合約那句話不能是空的", file=sys.stderr)
        return None
    if "\n" in _c or "\r" in _c:
        print("擋下:合約那句話不能換行(摘要是一行一條,換行會把整個摘要區塊打斷,"
              "連同這篇既有的合約一起從圖譜消失)", file=sys.stderr)
        return None
    # ★短名也進這張清單★(代碼審 r1 架構席):分開檢查的話,同時漏 --plan 跟 --name 要補兩次才看得到兩個問題
    missing = [(v, lbl) for v, lbl in ((plan, "計劃參照"), (phase, "階段"), (due, "最遲日期"),
                                       (why, "理由"), (owner, "負責人"), (name, "短名")) if not (v or "").strip()]
    if missing:
        names = "、".join(lbl for _v, lbl in missing)
        print(f"擋下:預告合約要寫清楚才追得動,還缺:{names}", file=sys.stderr)
        print("  缺什麼就補什麼:--plan <計劃節點> --phase <階段,可多個逗號分隔> "
              "--due YYYY-MM-DD --why <為什麼還不做> --owner <誰負責> "
              f"--name <短名,當檔名,{_GUARD_NAME_MAX} 字內,例:事故F2_確認前當機不重複副作用>", file=sys.stderr)
        return None
    try:
        datetime.date.fromisoformat(due.strip())
    except ValueError:
        print(f"擋下:最遲日期『{due}』不是 YYYY-MM-DD", file=sys.stderr)
        return None
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return None
    prel = env.find(plan)
    if prel is None:
        print(f"擋下:圖譜裡找不到計劃節點 {plan}", file=sys.stderr)
        return None
    phases = [x.strip() for x in str(phase).split(",") if x.strip()]
    # ★檔名用人給的短名,不再截合約原文★(必要合約清單_計劃 S19 到 S21,2026-09-23 rtb-production-agent-demo 回報):
    # 原本拿合約前 40 字當檔名,產生斷在句子中間的名字。日期前綴保留——本 repo 驗證紀錄全是「日期_短名」。
    _nerr = _guard_name_problem(name)
    if _nerr:
        print(f"擋下:{_nerr}", file=sys.stderr)
        print(f"  守衛節點的檔名要一個短名(會自動加日期前綴,{_GUARD_NAME_MAX} 字以內),例如:", file=sys.stderr)
        print("    --name 事故F2_確認前當機不重複副作用", file=sys.stderr)
        return None
    # ★用正規化過的寫法★(代碼審 r1 通才席):同一個字的組合寫法與預組合寫法位元組不同,
    # macOS 會摺成同一個檔,Linux 不會——撞名保護就會在 CI 那種機器上失效。載入圖譜時本來就用 nfc。
    gname = f"{datetime.date.today().isoformat()}_{nfc(name.strip())}"
    gpath = env.vault / "Verification" / f"{gname}.md"
    if gpath.exists():
        print(f"擋下:守衛節點 {gname} 已經存在,換一句話或改名再試"
              "(不靜默覆蓋:兩個人同時建同名節點會把對方的蓋掉)", file=sys.stderr)
        return None
    return rel, prel, phases, gname, gpath


def _guard_plan_write_node(gpath, gname, rel, prel, phases, today, claim, due, why, owner):
    """把守衛節點的內容組出來落盤,成功回 True(失敗已經印過為什麼)。

    ★先建守衛節點(可重建的那一邊),再寫功能節點的標記(權威那一邊)★(設計審 r1 blocker):
    本 repo 的寫入原語沒有刪除這一步,真回滾搭不起來;既有兩處同類問題都是
    「先寫衍生、後寫權威,後者失敗印警告不回滾」。
    """
    guard_lines = [
        "---\n", "type: verification\n", "status: pending\n",
        f"created: {today}\n", f"updated: {today}\n", f"due: {due.strip()}\n",
        f"owner: {owner.strip()}\n",
        f"{GUARD_MARK_FIELD}:\n", f"  - {rel[:-3] if rel.endswith('.md') else rel}\n",
        "phases:\n"] + [f"  - {x}\n" for x in phases] + [
        "plan_refs:\n", f"  - \"[[{prel[:-3] if prel.endswith('.md') else prel}]]\"\n",
        "tags:\n", "  - type/verification\n", "  - status/pending\n",
        "summary: |-\n",
        f"  WHY:[{today}]預告這條合約但還沒做:{why.strip()}\n",
        f"  TEST:還沒有測試在守這條;最遲 {due.strip()} 要做完,負責人 {owner.strip()}\n",
        "---\n", f"# {gname}\n", "\n",
        f"預告的合約:{claim.strip()}\n", "\n",
        f"為什麼還不做:{why.strip()}\n", "\n",
        "做完之後跑 `lumos guard settle` 轉正,不要手改狀態。\n",
    ]
    # 新建檔走 vault 唯一寫入原語(tmp→os.replace);atomic_write_verify 是給「改既有檔」用的,
    # 它會先讀原檔,對新檔會 FileNotFoundError。寫完自己讀回驗一次(★回報成功未落盤★的老教訓)。
    try:
        _write_lf(gpath, "".join(guard_lines))
        _back = gpath.read_text(encoding="utf-8")
        if "status: pending" not in _back or claim.strip() not in _back:
            raise RuntimeError("寫完讀回來對不上")
    except (OSError, RuntimeError) as ex:
        print(f"擋下:守衛節點寫不進去,什麼都沒動: {ex}", file=sys.stderr)
        return False
    return True


def cmd_guard_plan(env, node, claim, plan, phase, due, why, owner, name=None):
    """預告一條之後要有的合約:寫標記 + 建待完成守衛節點,雙向連好。"""
    import datetime
    checked = _guard_plan_check(env, node, claim, plan, phase, due, why, owner, name)
    if checked is None:
        return 2
    rel, prel, phases, gname, gpath = checked
    today = datetime.date.today().isoformat()

    if not _guard_plan_write_node(gpath, gname, rel, prel, phases, today, claim, due, why, owner):
        return 2
    # ── 再寫功能節點的預告標記
    gref = f"Verification/{gname}"
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"⚠ 守衛節點已建好({gref}),但功能節點打不開,標記沒寫進去: {ex}", file=sys.stderr)
        print("  不回滾(本 repo 的寫入原語沒有刪除這一步);手動補標記或把守衛節點刪掉重來", file=sys.stderr)
        return 2
    # ★行尾不帶換行★:load_raw_for_edit 回來的每一行都已經去掉換行,自己再加一個會多出空行
    marker = f"  KEY:{PLANNED_MARK} {claim.strip()} [watch:{gref}] [due:{due.strip()}]"
    # 插在摘要區塊第一行之前。★要跳過 summary: 那一行本身之後可能已有的空白行★,
    # 不然會在標記後面留一個空行,讀起來像摘要斷成兩段。
    ins = None
    for i in range(1, e):
        if lines[i].startswith("summary:"):
            ins = i + 1
            while ins < e and not lines[ins].strip():
                ins += 1
            break
    if ins is None:
        print(f"⚠ 守衛節點已建好({gref}),但功能節點沒有摘要區塊,標記沒寫進去", file=sys.stderr)
        print("  不回滾;先給那篇補 summary 再手動加這一行:", file=sys.stderr)
        print("    " + marker.strip(), file=sys.stderr)
        return 2
    new_lines = [*lines[:ins], marker, *lines[ins:]]
    try:
        atomic_write_verify(path, new_lines, PLANNED_MARK,
                            lambda f: PLANNED_MARK in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"⚠ 守衛節點已建好({gref}),但標記寫不進功能節點: {ex}", file=sys.stderr)
        print("  不回滾;手動補上這一行:", file=sys.stderr)
        print("    " + marker.strip(), file=sys.stderr)
        return 2
    # ★還要掛 verified_by★:不掛的話守衛節點在自檢裡是「沒人引用的孤兒驗證紀錄」,
    # 等於預告一條合約就多一個 issue——防忘記的機制自己製造雜訊,人會學會忽略它。
    # 掛了也順便讓「查那篇功能節點就看得到它」成立(設計審重點)。
    _rc_v = cmd_append(env, rel, "verified_by", f"[[{gref}]]")
    if _rc_v != 0:
        print("⚠ 標記與守衛節點都寫好了,但 verified_by 沒掛上——它會被當成孤兒驗證紀錄", file=sys.stderr)
        print(f"  手動補:lumos append {rel[:-3] if rel.endswith('.md') else rel} verified_by \"[[{gref}]]\"", file=sys.stderr)
    print(f"✓ 預告合約已登記:{rel} 多了一行預告標記,{gref} 在守它")
    print(f"  最遲 {due.strip()} 要做完(負責人 {owner.strip()});逾期會擋推送,而且不准延期")
    print(f"  做完之後:lumos guard settle {gref} --test <測試方法名>")
    return 0


def _guard_nodes(env):
    """帶本機制標記的守衛節點。★判準放節點身上,不看 status 字面值、不查外部帳★
    (設計審:手寫 pending 的人不該被拖進整套規則;判準跟著節點走,改名搬家都對得上)。"""
    out = []
    for rel, n in sorted(env.notes.items()):
        if n.fields.get("type") != "verification":
            continue
        g = n.fields.get(GUARD_MARK_FIELD)
        if not g:
            continue
        out.append((rel, n))
    return out


def _guard_find(env, ref):
    rel = env.find(ref)
    if rel is None:
        return None, None
    n = env.notes.get(rel)
    if n is None or not n.fields.get(GUARD_MARK_FIELD):
        return None, None
    return rel, n


def _guard_planned_line(env, home_rel, claim):
    """在功能節點裡找那一行預告標記,回 (lines, idx, e, err)。

    ★比照既有引擎的兩道防呆★(代碼審 r1 blocker):`cmd_guard_bind`/`cmd_guard_audit` 對
    「在功能節點裡找某條 KEY 行」都會 ①命中多條就擋,不猜是哪一條 ②找不到就擋。
    第一版用「合約前 12 字」當子字串比對,同一篇預告兩條而前 12 字相同時會改到別條、互相覆蓋。
    這裡改成比對「剝掉 [watch:]/[due:] 之後的完整文字」,並保留多條就擋。"""
    path = env.vault / home_rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        return None, None, None, f"{home_rel} 打不開:{ex}"
    want = (claim or "").strip()
    idx = None
    for i in range(1, e):
        m = PLANNED_RE.match(lines[i].strip())
        if not m:
            continue
        body = _PLANNED_TAIL_RE.sub("", m.group(1)).strip()
        if body != want:
            continue
        if idx is not None:
            return None, None, None, (f"{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條"
                                      "——先手動把重複的那行處理掉")
        idx = i
    if idx is None:
        return None, None, None, f"{home_rel} 裡找不到預告行『{want[:30]}』(被手改過或已經轉正?)"
    return lines, idx, e, None


def _guard_home_of(n):
    g = n.fields.get(GUARD_MARK_FIELD)
    if isinstance(g, list) and g:
        return str(g[0]).strip()
    return str(g or "").strip()


def _guard_touched_hits(files, touched):
    """家節點管的那些檔,跟這次改到的檔對得上哪幾個。回 (對上的清單, 是不是只在忽略大小寫時才對上)。

    ★比對鍵走既有那支★(代碼審 r2 架構席 blocker):about_code 的比對鍵全 repo 只有一個算法
    `_nodehome_key`(路徑正規化 + NFC),2026-09-10 那輪代碼審就是為了收斂「三處各寫一份、
    各版解得不一樣」才立的。第一版自己刻了一份,解不了 `a/../b`——而那正是這個 repo
    自己認證過、也修過一次的人手寫法,漏掉的話該擋的推送會安靜放行。

    在那之上多兩條**只會多擋、不會少擋**的保險:家節點寫的是資料夾(看底下的檔)、只有忽略大小寫
    才對得上。寫入端(`_about_code_path`)確實已經擋掉這兩種寫法(要求是檔案、大小寫要跟磁碟一致),
    所以走指令寫進去的不會踩到;留著是因為★寫入端的保證不等於讀取端的保證★——開頭欄位可以被手改,
    而這一層漏掉是沒人會發現的(多擋一次訊息會講清楚為什麼)。
    """
    tset = {_nodehome_key(x) for x in touched}
    tset.discard("")
    hits, only_case = [], []
    for raw in files:
        f = _nodehome_key(raw)
        if not f:
            continue
        if f in tset:
            hits.append(raw)
            continue
        under = sorted(x for x in tset if x.startswith(f + "/"))
        if under:
            hits.append(f"{raw}(底下的 {under[0]})")
            continue
        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上
        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。
        same = sorted(x for x in tset if x.lower() == f.lower())
        if same:
            hits.append(f"{raw}(大小寫不同:{same[0]})")
            only_case.append(raw)
    return hits, only_case


def _guard_touches(gn, env, touched):
    """這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。

    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):
    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。
    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。
    """
    if touched is None:
        return True, ""            # 沒給清單=CI 那一層,照舊全擋
    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點
    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。
    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]
    if not homes:
        return False, ";這篇沒寫它守的是哪篇功能節點,算不出有沒有碰到"
    files, found, missing, nocode = [], [], [], []
    for home in homes:
        hrel = env.find(home)
        hn = env.notes.get(hrel) if hrel else None
        if hn is None:
            missing.append(home)
            continue
        found.append(hrel)
        got = [str(x).strip() for x in as_list(hn.fields.get("about_code")) if str(x).strip()]
        if got:
            files += got
        else:
            nocode.append(hrel)
    # ★連結斷掉的那幾篇,不管這次擋不擋都要講★(代碼審 r2 通才席):
    # 半條算得出來、半條算不出來時,算不出來的那半原本會無聲消失,那條合約就一直帶著沒人發現的壞連結。
    broken = f"(另外 {'、'.join(missing)} 這幾篇找不到,連結可能斷了)" if missing else ""
    if not files:
        if missing and not found:
            return False, f";找不到它守的功能節點 {'、'.join(missing)},算不出有沒有碰到"
        return False, f";{'、'.join(nocode)} 沒寫它管哪幾支檔(about_code),算不出有沒有碰到{broken}"
    hits, only_case = _guard_touched_hits(files, touched)
    if hits:
        # ★只列解析得到的那幾篇★(代碼審 r2 通才席):這句話存在的目的是讓被擋的人知道去哪篇查,
        # 把找不到的節點也列進來,照著查的人會撲空。
        # ★收窄的粒度是「整篇家節點」不是「每條合約」★(代碼審 r1):同一篇掛兩條逾期合約時兩條都會擋。
        # 做得更細要讓每條合約自己記檔案清單(另一套資料);現在的代價是偶爾多擋一條,方向安全,
        # 但要讓人看得出來為什麼,不要變成無法解釋的誤擋。
        why = f";你這次改到 {'、'.join(hits[:3])}(它掛在 {'、'.join(found[:2])} 底下){broken}"
        if only_case and len(only_case) == len(hits):
            why += "——只有忽略大小寫才對得上,寧可多擋一次也不漏"
        return True, why
    return False, ("" if not broken else f";這次沒碰到它管的檔{broken}")


def cmd_guard_settle(env, ref, method):
    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過。"""
    if not IDENT_RE.match(method or ""):
        print(f"擋下:測試方法名『{method}』不合法(只能字母/數字/底線,不能數字開頭)", file=sys.stderr)
        return 2
    rel, n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    if str(n.fields.get("status")) != "pending":
        print(f"擋下:{rel} 現在是 {n.fields.get('status')},只有待完成的才能轉正", file=sys.stderr)
        return 2
    home = _guard_home_of(n)
    home_rel = env.find(home)
    if home_rel is None:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到", file=sys.stderr)
        return 2
    body = (env.vault / rel).read_text(encoding="utf-8")
    m = re.search(r"^預告的合約:(.+)$", body, re.M)
    claim = m.group(1).strip() if m else ""
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條", file=sys.stderr)
        return 2
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        print(f"擋下:{_err}", file=sys.stderr)
        return 2
    newline = f"  KEY:★INVARIANT★ {claim} [test:{method}]"
    try:
        atomic_write_verify(env.vault / home_rel, [*lines[:idx], newline, *lines[idx + 1:]],
                            f"[test:{method}]",
                            lambda f: f"[test:{method}]" in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:合約行換不過去,什麼都沒動: {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "status", "pass")
    print(f"✓ 轉正:{home_rel} 的預告行已換成正式合約並綁上 [test:{method}];{rel} 轉為已通過")
    print("  下一步:lumos guard audit 補獨立審計,推送前的閘會查")
    return rc


def _guard_signoff_refs(env):
    """簽核帳裡帶 --ref 的那些參照。"""
    import json as _j
    log = env.vault.parent / ".signoff-log.jsonl"
    refs = set()
    try:
        for ln in log.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                d = _j.loads(ln)
            except ValueError:
                continue
            r = str(d.get("ref") or "").strip()
            if r:
                refs.add(r)
                refs.add(r[:-3] if r.endswith(".md") else r)
    except OSError:
        pass
    return refs


def cmd_guard_abandon(env, ref, why):
    """棄置:留墓碑而不是刪掉。要有對得上的簽核紀錄——作用是留痕不是防偽造。"""
    if not (why or "").strip():
        print("擋下:棄置要寫 --why 說明為什麼決定不做了", file=sys.stderr)
        return 2
    rel, n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    refs = _guard_signoff_refs(env)
    stem = rel[:-3] if rel.endswith(".md") else rel
    if rel not in refs and stem not in refs:
        print(f"擋下:棄置一條預告的合約要有人簽核,帳上找不到對得上 {stem} 的紀錄", file=sys.stderr)
        print(f"  先簽核再來:lumos signoff {stem} --ref {stem} --note \"<為什麼決定不做>\"", file=sys.stderr)
        return 2
    home = _guard_home_of(n)
    home_rel = env.find(home)
    body = (env.vault / rel).read_text(encoding="utf-8")
    m = re.search(r"^預告的合約:(.+)$", body, re.M)
    claim = m.group(1).strip() if m else ""
    if not home_rel:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到——棄置前先把 guards 欄位指對,"
              "不然那篇的預告行會永遠留著,跟墓碑互相矛盾", file=sys.stderr)
        return 2
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條(被手改過?)", file=sys.stderr)
        return 2
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        # ★找不到就擋,不靜默略過★(代碼審 r1 blocker):guards 被改指到別篇時,
        # 原本會靜默成功,真正的家節點永久留著一條沒人管的預告行。
        print(f"擋下:{_err}", file=sys.stderr)
        print("  棄置會把功能節點那行預告拿掉;對不到那一行就不知道該拿掉哪一條,不能硬做", file=sys.stderr)
        return 2
    try:
        atomic_write_verify(env.vault / home_rel, lines[:idx] + lines[idx + 1:],
                            "", lambda f: claim not in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:功能節點的預告行拿不掉,墓碑也不立(不留半套): {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "status", "abandoned")
    print(f"✓ 已棄置:{rel} 立成墓碑(不是刪掉,下一個人看得到曾經打算做什麼、為什麼不做了)")
    return rc


def cmd_guard_required(env, as_json=False):
    """列必要集合現況:待完成幾條、逾期幾條、快到期幾條。"""
    import datetime
    today = datetime.date.today()
    rows, overdue, soon = [], [], []
    for rel, n in _guard_nodes(env):
        st = str(n.fields.get("status") or "")
        due = str(n.fields.get("due") or "").strip()
        home = _guard_home_of(n)
        owner = str(n.fields.get("owner") or "").strip()
        body = (env.vault / rel).read_text(encoding="utf-8")
        m = re.search(r"^預告的合約:(.+)$", body, re.M)
        claim = (m.group(1).strip() if m else rel)
        rows.append((rel, st, due, home, owner, claim))
        if st != "pending":
            continue
        try:
            d = datetime.date.fromisoformat(due)
        except ValueError:
            continue
        # ★到期當天不算過期,隔天才算★:最遲日期是人手寫的本地日期;
        # 誤擋一次的代價比漏擋一天高(設計審 r1)
        if d < today:
            overdue.append((rel, due, owner, claim))
        elif (d - today).days <= 7:
            soon.append((rel, due, owner, claim))
    pend = [r for r in rows if r[1] == "pending"]
    print(f"必要合約:待完成 {len(pend)}、逾期 {len(overdue)}、快到期(七天內) {len(soon)}、"
          f"已通過 {len([r for r in rows if r[1] == 'pass'])}、"
          f"已棄置 {len([r for r in rows if r[1] == 'abandoned'])}")
    for rel, due, owner, claim in overdue:
        print(f"  ✗ 逾期 {due}(負責人 {owner}):{claim}")
        print(f"      {rel} — 做完跑 lumos guard settle,不做了跑 lumos guard abandon(要先簽核)")
    for rel, due, owner, claim in soon:
        print(f"  ⚠ 快到期 {due}(負責人 {owner}):{claim}")
        print(f"      {rel}")
    if not overdue and not soon and pend:
        for _rel, _st, due, _home, owner, claim in pend:
            print(f"  · 待完成 {due}(負責人 {owner}):{claim}")
    return 1 if overdue else 0


def cmd_guard_bind(env, node, invariant_substr, method, platform=None):
    if not IDENT_RE.match(method):
        print(f"擋下:method『{method}』不是合法的方法名(只能用字母/數字/底線,不能數字開頭)", file=sys.stderr)
        return 2
    # 多平台:平台另帶(method 維持識別字、不含冒號),寫成 [test:平台:方法]。IDENT_RE 不放寬。
    ref = f"{platform}:{method}" if platform else method
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:{ex}", file=sys.stderr)
        return 2
    target_idx = None
    for i in range(1, e):
        # 比對去掉 [test:..] 後的行(子字串不誤命中既有測試名)
        if INVARIANT_RE.match(lines[i].strip()) and invariant_substr in TEST_REF_RE.sub("", lines[i]):
            if target_idx is not None:
                print(f"擋下:『{invariant_substr}』同時對到好幾條 KEY 行,分不清是哪條,請給更長、更精確的片段", file=sys.stderr)
                return 2
            target_idx = i
    if target_idx is None:
        print(f"擋下:{rel} 裡找不到內容含『{invariant_substr}』的合約 KEY 行", file=sys.stderr)
        return 2
    line = lines[target_idx]
    m = TEST_REF_RE.search(line)
    if m:
        refs = [t.strip() for t in m.group(1).split(",") if t.strip()]
        if ref in refs:   # 去重比完整 ref(platform:method),否則多平台漏判(審計 r3)
            print(f"已綁 [test:{ref}],無需重綁")
            return 0
        refs.append(ref)
        newline = line[:m.start()] + f"[test:{','.join(refs)}]" + line[m.end():]
    else:
        newline = line.rstrip() + f" [test:{ref}]"
    new_lines = lines[:target_idx] + [newline] + lines[target_idx + 1:]
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
        return v  # bare,絕不加引號
    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)


def fmt_list_item(value):
    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
    v = value.strip()
    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")


def edit_fm_scalar(fm_lines, key, value):
    fm = list(fm_lines)
    formatted = fmt_scalar(key, value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "scalar":
            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
        fm[s] = f"{key}: {formatted}"
    else:
        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
        ins = len(fm)
        for k, s, e, kind in fm_structure(fm):
            if kind in ("list", "block"):
                ins = s
                break
        fm.insert(ins, f"{key}: {formatted}")
    return fm


def edit_fm_sync_status_tag(fm_lines, status):
    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
    fm = list(fm_lines)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if "tags" not in struct or struct["tags"][2] != "list":
        return fm, False
    s, e, _kind = struct["tags"]
    found = False
    for i in range(s + 1, e + 1):
        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
        if m:
            fm[i] = f"{m.group(1)}status/{status}"
            found = True
    return fm, found


def _list_scalar_value(fm, key, line_idx):
    """清單欄位的單一值寫法(`key: 值`)讀出那一個值(去引號,空的回 "")。

    ★看起來是同一行清單就丟 ValueError★:工具不解析同一行裡的逗號(fm_structure 與
    parse_frontmatter 都把它當成一個值),照單一值轉會把整串 "[a, b]" 寫成一項。
    判準看「去引號後的值本身」,不列舉寫法(2026-09-10 代碼審 r2:只比對原始字串時,
    整串加引號、逗號前後多打空白都繞得過):以 [ 或 { 開頭(單一連結 [[X]] 除外),
    或一個值裡有兩個以上連結開頭。加了引號的空清單 "[]" 跟讀的一側一樣當成空的。"""
    m = TOP_KEY_RE.match(fm[line_idx])
    val = m.group(2).strip() if m else ""
    sval = strip_quotes(val)
    t = sval.strip()   # 引號裡面前面多一個空白也要認得(第三輪外家否決席:" [a, b]" 繞過)
    if t == "[]":
        return ""
    # 單一連結要「整個值恰好是一個連結」才豁免(第三輪外家找洞席:[[Systems/A], Systems/B] 開頭像連結就被放行)
    if (t.startswith(("[", "{")) and not _SINGLE_WIKILINK_RE.fullmatch(t)) or _multi_link_value(t):
        raise ValueError(f"{key} 寫成同一行的清單({val}),工具不解析這種寫法,"
                         f"硬加會把整串當成一項寫壞,檔案沒動。這種寫法目前只能手動改成一行一項"
                         f"({key}: 換行後每項一行「  - 值」),改完再重跑")
    return t   # 去掉前後空白:引號裡只有空白就是空的(第四輪正確性席:原本會留下一筆空白垃圾項)


def _list_key_scalar_to_list(fm, key, line_idx):
    """清單欄位被寫成單一值(`about_code: src/x.py`)時,改寫成一項的清單再給 append/remove 用。

    ★讀的一側本來就把單一值當成一項的清單★(as_list),只有寫的一側不認得——
    於是一篇筆記一旦是單一值寫法,append 說它不是清單、set 又不收清單欄位,
    沒有任何指令改得動(2026-09-10 代碼審 r1)。空值(`key:`)當成空清單;
    同一行的清單寫法擋下不轉(見 _list_scalar_value)。"""
    sval = _list_scalar_value(fm, key, line_idx)
    m = TOP_KEY_RE.match(fm[line_idx])
    raw = m.group(2).strip() if m else ""
    fm = list(fm)
    fm[line_idx] = f"{key}:"
    if sval:
        # ★原本那一項原封不動★:有引號就照原樣搬,不去掉再重新加(第三輪外家找洞席:'[[Systems/API "v2"]]'
        # 被重新加成帶反斜線的雙引號,讀的一側不解反斜線,讀回來就不是原本那篇了)
        quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
        fm.insert(line_idx + 1, f"  - {raw if quoted else fmt_list_item(sval)}")
    return fm


def edit_fm_append(fm_lines, key, value):
    fm = list(fm_lines)
    item = fmt_list_item(value)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
        cur = _list_scalar_value(fm, key, struct[key][0])
        if cur and link_target(cur) == tgt:
            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "list":
            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
            fm[s] = f"{key}:"
        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
        for j in range(s + 1, e + 1):
            existing = fm[j].strip()
            if existing.startswith("-") and link_target(existing[1:]) == tgt:
                return fm  # 已存在,no-op
        # 偵測現有項縮排,否則預設 2 空格
        indent = "  "
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-"):
                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
                break
        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
        last = e
        while last > s and not fm[last].strip():
            last -= 1
        fm.insert(last + 1, f"{indent}- {item}")
    else:
        ins = len(fm)
        fm.insert(ins, key + ":")
        fm.insert(ins + 1, f"  - {item}")
    return fm


def edit_fm_remove(fm_lines, key, value):
    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。

    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
    fm = list(fm_lines)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key not in struct:
        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
    if struct[key][2] == "scalar" and key in LIST_KEYS:
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    s, e, kind = struct[key]
    if kind != "list":
        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
    hits = []
    for j in range(s + 1, e + 1):
        existing = fm[j].strip()
        if existing.startswith("-") and link_target(existing[1:]) == tgt:
            hits.append(j)
    if not hits:
        return fm, 0
    for j in reversed(hits):
        del fm[j]
    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    if key in struct2:
        s2, e2, _ = struct2[key]
        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
            del fm[s2:e2 + 1]
    return fm, len(hits)


def decisions_items(fm_lines):
    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
    block = None
    for k, s, e, kind in fm_structure(fm_lines):
        if k == "decisions" and kind == "list":
            block = (s, e)
            break
    if block is None:
        return None
    s, e = block
    item_indent = None
    starts = []
    for i in range(s + 1, e + 1):
        ln = fm_lines[i]
        if not ln.strip():
            continue
        m = re.match(r"^(\s*)-\s", ln)
        if m:
            ind = len(m.group(1))
            if item_indent is None:
                item_indent = ind
            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
                starts.append(i)
    items = []
    for idx, st in enumerate(starts):
        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
        while en > st and not fm_lines[en].strip():
            en -= 1
        items.append((st, en))
    sub_indent = (item_indent + 2) if item_indent is not None else 4
    return s, e, items, (item_indent or 2), sub_indent


def load_raw_for_edit(path: Path):
    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
    raw = path.read_bytes()
    if raw.startswith(b"\xef\xbb\xbf"):
        raise ValueError("這個檔開頭帶 BOM 標記,工具不寫這種檔;先把檔案存成不帶 BOM 的 UTF-8")
    if b"\r\n" in raw:
        raise ValueError("這個檔的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)。Windows 上常是 git autocrlf 造成的;"
                         "修法:確認 .gitattributes 有套用(圖譜目錄標 eol=lf)再跑 git add --renormalize .,"
                         "或單檔跑 dos2unix。工具不會偷偷幫你改行尾。")
    lines = raw.decode("utf-8").split("\n")
    if not lines or lines[0].strip() != "---":
        raise ValueError("這篇筆記開頭沒有欄位區塊(---),沒辦法改欄位")
    fm_end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            fm_end = i
            break
    if fm_end is None:
        raise ValueError("開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),先補上")
    return lines, 1, fm_end


def _write_lf(path: Path, text: str):
    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.9。
    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
    整檔覆寫消費者)。read-modify-write 的併發:set/append/remove 由呼叫端上鎖(_vault_write_lock),
    其他寫入指令仍是 last-write-wins(單機 CLI,accepted)。
    ★暫存檔名每次都不一樣★(2026-09-10 代碼審 r3 併發資源席:原本同一篇筆記大家用同一個固定暫存檔名,
    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
    import os as _os, shutil as _sh, uuid as _uuid
    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
    try:
        with _os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
        if path.exists():
            _sh.copymode(path, tmp)
        _os.replace(tmp, path)
    except BaseException:
        try:
            _os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_write_verify(path: Path, new_lines, key, expected_check):
    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
    orig_fm = load_raw_for_edit(path)
    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
    text = "\n".join(new_lines)
    new_fm_lines = new_lines[1:]
    for i in range(1, len(new_lines)):
        if new_lines[i].strip() == "---":
            new_fm_lines = new_lines[1:i]
            break
    fields, _, new_lint = parse_frontmatter(new_fm_lines)
    if not expected_check(fields):
        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
    introduced = set(new_lint) - orig_lint
    if introduced:
        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)


_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己


_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)


def _vault_lock_where(vault):
    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。

    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。

    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
    互斥照樣成立。

    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
    """
    import hashlib
    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    return primary, None


def _vault_lock_say(lock, why):
    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
          file=sys.stderr)
    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)


def _vault_write_lock(vault):
    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。

    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
    import contextlib, time as _t

    @contextlib.contextmanager
    def _cm():
        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
        lock, why = _vault_lock_where(vault)
        k = str(lock)

        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
            _VAULT_LOCK_HELD[k] += 1
            try:
                yield
            finally:
                _VAULT_LOCK_HELD[k] -= 1
            return

        if why and not _VAULT_LOCK_WARNED.get(k):
            _VAULT_LOCK_WARNED[k] = True
            _vault_lock_say(lock, why)
        deadline = _t.monotonic() + 60
        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
            if _t.monotonic() > deadline:
                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
            _t.sleep(0.05)
        _VAULT_LOCK_HELD[k] = 1
        try:
            yield
        finally:
            _VAULT_LOCK_HELD.pop(k, None)
            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
                    lock.unlink()
            except OSError:
                pass
    return _cm()


def cmd_set(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_set_locked(env, rel, key, value)


def _cmd_set_locked(env, rel, key, value):
    if key in COND_KEYS:
        return _set_conditions_locked(env, rel, key, value if isinstance(value, list) else [value])
    if isinstance(value, list):
        if len(value) != 1:
            print(f"擋下:{key} 只收一個值,你給了 {len(value)} 個,檔案沒動(給多個值只有 {'、'.join(COND_KEYS)} 收)",
                  file=sys.stderr)
            return 2
        value = value[0]
    if key not in SCALAR_KEYS:
        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)},"
              f"以及整欄換掉的 {'、'.join(COND_KEYS)}"
              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
        return 2
    # ★負責範圍跟新開節點用同一支判斷、同樣擋★(筆記欄位關卡補齊_計劃 S11;不看開關——r3 架構席:
    # 同一個欄位的兩個寫入口擋法要一樣;原本只有 new 擋,set 可以寫進一個字)
    if key == "responsibility" and not _nodehome_resp_ok(value):
        print(f"擋下:負責範圍至少 {_NODEHOME_RESP_MIN_CHARS} 個字、要有實字(一句話講這篇負責什麼、不負責什麼),檔案沒動",
              file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    new_fm = edit_fm_scalar(lines[1:e], key, value)
    exp = fmt_scalar(key, value)
    exp_val = strip_quotes(exp)
    tag_synced = False
    if key == "status":
        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
    new_lines = lines[:1] + new_fm + lines[e:]

    def _check(f):
        if str(f.get(key, "")) != exp_val:
            return False
        if tag_synced:
            want = f"status/{exp_val}"
            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
            return want in tags and all(t == want for t in tags if t.startswith("status/"))
        return True

    atomic_write_verify(path, new_lines, key, _check)
    print(f"✓ set {rel}: {key} 已改成 {exp}" + ("(狀態標籤 status/* 也同步改了)" if tag_synced else ""))
    return 0


def _set_conditions_locked(env, rel, key, values):
    """驗收紀錄的前提/回頭條件整欄換掉(Projects/驗收前提欄位可改_計劃)。

    ★為什麼整欄換、不走 append/remove★:這兩欄是散文、常提到連結;append/remove 判斷「同一項」看連結目標,
    兩條提到同一篇的不同條件會被當成重複。原本四種寫法(單行、清單、空的、多行區塊)並存,一律整段拿掉重寫。"""
    vals = [str(v).strip() for v in values]
    if not vals or any(not v for v in vals):
        print(f"擋下:{key} 的每一條都不能是空的,檔案沒動(前提寫這個結論在什麼情況下才算數,回頭條件寫改到什麼該重驗)",
              file=sys.stderr)
        return 2
    if any("\n" in v or "\r" in v for v in vals):
        print(f"擋下:{key} 一條條件只能一行,檔案沒動(要寫多條就給多個值:lumos set <筆記> {key} \"條件一\" \"條件二\")",
              file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, _s, e = load_raw_for_edit(path)
    fm = list(lines[1:e])
    new = ([f"{key}: {fmt_scalar(key, vals[0])}"] if len(vals) == 1
           else [f"{key}:"] + [f"  - {fmt_scalar(key, v)}" for v in vals])
    struct = {k: (a, b) for k, a, b, _kind in fm_structure(fm)}
    if key in struct:
        a, b = struct[key]
        fm[a:b + 1] = new
    else:   # 插的位置照 edit_fm_scalar:第一個清單或多行區塊欄位之前,都沒有就放最後
        at = next((a for _k, a, _b, kind in fm_structure(fm) if kind in ("list", "block")), len(fm))
        fm[at:at] = new
    atomic_write_verify(path, lines[:1] + fm + lines[e:], key, lambda f: _conds(f.get(key)) == vals)
    print(f"✓ set {rel}: {key} 整欄換成 {len(vals)} 條" + ("" if len(vals) == 1 else "(一行一項的清單)"))
    return 0


def cmd_self_audit(env, rel, model="sonnet", date=None):
    return len(v) >= _NODEHOME_RESP_MIN_CHARS and bool(re.search(r"[^\W_]", v))


_NODEHOME_STACK_TEST_DIRS = None   # lazy:({頂層資料夾結尾樣式: 貢獻它的棧的副檔名}, {src/ 底下的測試資料夾名: 貢獻它的棧的副檔名})


def _nodehome_stack_test_dirs():
    """從測試棧對照表 TEST_PROFILES 推各棧的測試資料夾,不另寫清單(對照表多一個,這裡跟著認;
    t_nodehome_stack_test_dirs_not_required 的漂移守衛釘住):頂層比對模式的棧(Swift、C#)取「頂層資料夾名稱結尾」,
    限 src/ 底下遞迴找的棧(Kotlin/Gradle)取「src/ 底下的資料夾名」,兩種都連同那一棧的副檔名。其餘遞迴模式的棧不推——
    Python 那份把 scripts 當測試資料夾、Playwright 的 tests/e2e 不限位置,錨定太鬆會把真程式檔放掉。"""
    global _NODEHOME_STACK_TEST_DIRS
    if _NODEHOME_STACK_TEST_DIRS is None:
        sufs, under_src = {}, {}
        for prof in TEST_PROFILES.values():
            names = {d for inc, _exc in prof.get("dirs", {}).values() for d in inc if d}
            if prof.get("dir_mode") == "suffix":
                for d in names:
                    sufs.setdefault(d, set()).update(prof.get("exts", ()))
            elif prof.get("rglob_under") == "src":
                for d in names:
                    under_src.setdefault(d, set()).update(prof.get("exts", ()))
        _NODEHOME_STACK_TEST_DIRS = ({k: frozenset(v) for k, v in sufs.items()}, {k: frozenset(v) for k, v in under_src.items()})
    return _NODEHOME_STACK_TEST_DIRS


def _nodehome_top_dirs(all_paths):
    """repo 頂層的資料夾名;點開頭的不算(.git、.github 這類不是程式資料夾)。
    別人的檔的裸路徑判定([S8])與測試資料夾的同名資料夾錨共用這一支。"""
    return {p.split("/", 1)[0] for p in all_paths if "/" in p and not p.startswith(".")}


def _nodehome_layout(all_paths):
    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
    tops = _nodehome_top_dirs(all_paths)
    top_exts, main_exts = {}, {}
    for p in all_paths:
        e = _testmap_ext(p)
        if not e:
            continue
        parts = p.split("/")
        if len(parts) > 1 and parts[0] in tops:
            top_exts.setdefault(parts[0], set()).add("." + e)
        for k in range(len(parts) - 2):
            if parts[k] == "src" and parts[k + 1] == "main":
                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
                break
    return top_exts, main_exts


def _nodehome_in_stack_test_dir(path, layout):
    """在各棧的測試資料夾裡——兩種都要「旁邊的程式目標有同一種檔」,只看資料夾名會把業務資料夾放掉
    (2026-09-12 代碼審兩輪各席造出的反例:A/B 測試功能模組 ABTests/、Python 專案的 LoadTests/、
    scriptsTests/ 裡的 .cs、src/androidTest 裡的 .py):
    ① 頂層資料夾 = <X> 加對照表的結尾樣式(PosTerminalTests/、PosTerminalUITests/、Foo.IntegrationTests/),
       副檔名屬於貢獻那個結尾的棧,而且頂層的 <X> 資料夾裡有同一種副檔名的檔(Xcode 的 App 配 AppTests、
       .NET 的 Foo 配 Foo.Tests);資料夾就叫結尾樣式本身(UITests/、IntegrationTests/)的直接認;
    ② 緊接在 src 下一層的對照表測試資料夾名(app/src/androidTest/…),副檔名屬於貢獻那個名字的棧(Kotlin),
       而且同一個模組的 src/main 有同一種副檔名的檔——只看 src/main 有沒有同副檔名的檔,混在 src/main 的建置腳本
       (.py、.sh)就能讓 androidTest 裡同副檔名的檔免家(代碼審第三輪四席各自造出反例)。
    別種語言的測試輔助檔(Xcode 測試資料夾裡的橋接標頭 .h、Java 寫的 androidTest 輔助檔——對照表沒有 Java 棧)照舊要家:
    寧可過嚴,逃生口是 node_home.ignore;要認就把那一棧補進測試棧對照表,這裡自動跟著認。
    layout=_nodehome_layout 的結果。對不上的照舊要家(過嚴、不漏)。"""
    sufs, under_src = _nodehome_stack_test_dirs()
    top_exts, main_exts = layout
    parts = path.split("/")
    e = _testmap_ext(path)
    if len(parts) < 2 or not e:
        return False
    ext, top = "." + e, parts[0]
    for suf, exts in sufs.items():
        if ext not in exts or not top.endswith(suf):
            continue
        base = top[:-len(suf)].rstrip(".")
        if not base or ext in top_exts.get(base, ()):
            return True
    for i in range(1, len(parts) - 1):
        if parts[i - 1] == "src" and ext in under_src.get(parts[i], ()) and ext in main_exts.get("/".join(parts[:i]), ()):
            return True
    return False


def _nodehome_is_test(path, layout=({}, {})):
    """測試檔判定:先問測試地圖那一支;再認各棧的測試資料夾(2026-09-12:平板 POS 測試資料夾裡的輔助檔、
    Android 儀器測試的 Kotlin 檔都被要求有家——測試地圖的規格刻意只認 test/tests 資料夾與檔名,不動它);
    副檔名不在測試地圖清單裡的(shell、Go、Rust、C…),套它同一組目錄與檔名規則。layout 見 _nodehome_in_stack_test_dir。"""
    global _TESTMAP_DIR_RE
    if _testmap_is_test(path):
        return True
    if _nodehome_in_stack_test_dir(path, layout):
        return True
    if _testmap_ext(path) in _TESTMAP_EXTS:
        return False                      # 測試地圖認得這種副檔名,它說不是就不是
    if _TESTMAP_DIR_RE is None:
        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
    if _TESTMAP_DIR_RE.search(path):
        return True
    name = path.rsplit("/", 1)[-1]
    stem = _testmap_stem(path)
    return (".spec." in name or ".test." in name or stem.startswith("test_")
            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)


def _nodehome_code_kind(path):
    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
    base = path.rsplit("/", 1)[-1]
    stripped = base.lstrip(".")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    for ent in raw.split(b"\0"):
        if not ent or b"\t" not in ent:
            continue
        meta, p = ent.split(b"\t", 1)
        parts = meta.split()
        if where == "index":
            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
                continue
            mode = parts[0]
        else:
            if len(parts) != 3:
                continue
            mode = parts[0]
        path = nfc(os.fsdecode(p))
        allp.append(path)
        if mode in (b"100644", b"100755"):
            files[path] = mode.decode()
    return files, allp


def _nodehome_changed_vs_disk(repo_root, where):
    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
    if where == "index":
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
    else:
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
    if raw is None:
        return None
    return {nfc(x) for x in _nodehome_split_z(raw)}


def _nodehome_reader(repo_root, where):
    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
    if where is None:
        return lambda p: None
    disk_ok_all = False
    differ = None
    if where == "index":
        differ = _nodehome_changed_vs_disk(repo_root, "index")
    else:
        head = _lens_full_sha(repo_root, "HEAD")
        if head and head == where:
            differ = _nodehome_changed_vs_disk(repo_root, where)
    root = Path(repo_root)
    spec = "" if where == "index" else where

    def read(p):
        if differ is not None and p not in differ:
            fp = root / p
            try:
                if fp.is_file() and not fp.is_symlink():
                    return fp.read_bytes()
            except OSError:
                pass
        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
        if r is None or r.returncode != 0:
            return None
        return r.stdout
    return read


def _nodehome_parse_note(raw):
    """節點原文 → {type, status, about[], resp, sig, text}。sig=(摘要, 解析後的決策, 正文)——[S12] 內容有變
    逐欄比對用;★不沿用只算正文的那支雜湊★:摘要與決策都在開頭欄位裡,節點長大主要就長在摘要。"""
    text = raw.decode("utf-8-sig", errors="replace") if isinstance(raw, (bytes, bytearray)) else str(raw)
    fm_lines, body = split_frontmatter(text)
    fields = {}
    dec = ""
    if fm_lines is not None:
        fields, _bk, _lint = parse_frontmatter(fm_lines)
        # 決策比「解析後的值」:只把 content: a 改成 content: "a" 這種等價寫法不算內容有變(第二輪外家席)
        try:
            dec = json.dumps(parse_decisions(fm_lines), ensure_ascii=False, sort_keys=True)
        except Exception:
            dec = "\n".join(l.rstrip() for l in fm_lines if l.startswith(("decisions:", "  ")))
    summ = fields.get("summary")
    summ = summ if isinstance(summ, str) else ""
    return {"type": str(fields.get("type", "")).strip(),
            "status": str(fields.get("status", "")).strip(),
            "about": [str(x) for x in as_list(fields.get("about_code")) if str(x).strip()],
            "resp": fields.get("responsibility") if isinstance(fields.get("responsibility"), str) else None,
            # [S11] 從程式重建的章:蓋了章就代表這篇是還原出來的,那它更要說清楚自己管哪些檔
            "regen": fields.get("regen").strip() if isinstance(fields.get("regen"), str) else "",
            "sig": ("\n".join(l.rstrip() for l in summ.splitlines()).strip(), dec,
                    "\n".join(l.rstrip() for l in body.splitlines()).strip()),
            "text": text}


def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
def _nodehome_mark_note_content(repo_root, groups, vault_rel):
    """推送前逐提交看寫回:每個提交裡,哪幾篇 Systems 節點的內容(摘要、決策、正文)是在這個提交改的——只補驗證連結、
    計劃連結這類簿記欄位的不算——以及那篇在這個提交前後管哪些檔。在讀取這一層先算好放進分組的 content_notes
    {這個提交之後的路徑: {type, status, own}},判定那層只在同一個提交裡比「管的檔」跟「改的程式」,不必跨提交追名字
    (合併進來的平行分支、一次推送改名好幾次都不影響——代碼審 r2 單reviewer)。這個提交裡改名的,拿改名前的路徑去
    上一個提交讀;這個提交才新開的算有變;讀不到一律當有變,照原本那樣查。"""
    pre = vault_rel + "/Systems/"
    for g in groups or ():
        after = _nodehome_reader(repo_root, g["sha"])
        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
        notes = {}
        for p in g["paths"]:
            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
                continue
            new = after(p)
            n = _nodehome_parse_note(new) if new is not None else None
            olds = [b(g["src"].get(p, p)) for b in befores]
            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
            if n is not None and any(o["sig"] == n["sig"] for o in olds):
                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
            own, statuses = set(), set()
            for x in [n] + olds:
                if x is not None:
                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
                    statuses.add(x["status"])
            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
        g["content_notes"] = notes
    return groups


_NOTELINES_PRECOMMIT = "scripts/hooks/pre-commit"
_NOTELINES_PREPUSH = "scripts/hooks/pre-push"


def _nodehome_golive(repo_root, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。
    mark=要找的標記字串,預設是每支檔有家自己的;筆記形狀擋傳它自己的(Projects/筆記形狀擋_計劃 [S4])。"""
    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{mark or _NODEHOME_GOLIVE_MARK}",
                        tip or "HEAD", "--", hook)
    if not raw:
        return None
    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
    return first if _LENS_SHA_RE.match(first) else None


def _nodehome_clamp_base(repo_root, base, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。mark 見 _nodehome_golive。"""
    gl = _nodehome_golive(repo_root, tip, mark, hook)
    if gl is None:
        return base
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
    if r is None or r.returncode != 0:
        return base                                    # 上線點不在這條歷史上
    if base in (None, _EMPTY_TREE_SHA):
        return gl
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
    return gl if (r is not None and r.returncode == 0 and base != gl) else base


def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
    None=整批當成一個提交(提交前)。"""
    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
    homesN, ownN = _nodehome_homes(repo_root, N)
    homesB, ownB = _nodehome_homes(repo_root, B)
    blocks, reminders, pairs = [], [], []
    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
    for code, old, new in changes:
        if old is not None and (new is None or code == "R"):
            deleted.add(old)
        if new is None:
            continue
        changed_new.add(new)
        if code in ("A", "R", "C"):
            added.add(new)
        if code == "R" and old:
            renamed_from[new] = old
    code_changed = {p for p in changed_new if p in reqN}
    code_added = {p for p in added if p in reqN}
    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
    code_touched = code_changed | code_deleted
    vpre = vault_rel + "/"
    refs_cache = {}

    def refs_now(rel):
        if rel not in refs_cache:
            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
        return refs_cache[rel]

    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]
    edited = set()
    for p in sorted(changed_new):
        if not (p.startswith(vpre + "Systems/") and p.endswith(".md")):
            continue
        rel = p[len(vpre):]
        if rel not in N.notes:
            continue
        n = N.notes[rel]
        src = renamed_from.get(p)
        src_rel = src[len(vpre):] if src and src.startswith(vpre) else rel
        b = B.notes.get(src_rel)
        return 1
    # warn 模式有違規也記一筆(照鄰居的 warned;沒違規的放行才不寫——代碼審 r1 架構對齊席)
    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
                        nodes=sorted({v[0] for v in viol})[:50])
    return 0


# ── 筆記內容審(第二層,Projects/筆記內容審_計劃):推送前派判定者逐行判新寫的筆記是不是程式碼推得出來 ──
# 家:Systems/筆記內容審。只防疏忽、不防存心繞過(計劃〈做法〉第 0 節)。
_NOTE_AUDIT_GOLIVE_MARK = "note-audit check"          # 推送前掛鉤裡有這串=第二層上線了(範圍截斷用)
_NOTE_AUDIT_GATE_VALUES = ("block", "warn", "off")
_NOTE_AUDIT_VERDICT_DIR = "governance/note-verdicts"
_NOTE_AUDIT_WORK_DIR = ".lumos/note-audit"
_NOTE_AUDIT_TEMPLATE = "scripts/templates/note-audit-judge.md"
_NOTE_AUDIT_PROMPT_VERSION = 1                          # 範本檔改一個字就升版,並重跑 68 句小實驗(計劃 S14)
_NOTE_AUDIT_BATCH = 150
_NOTE_AUDIT_SEARCH_CAP = 20000
_NOTE_AUDIT_VERDICT_NAME_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{32}\.json$")
_NOTE_AUDIT_WEIGHT = {"CONTEXT": 0, "MIXED": 1, "CODE": 2}
_NOTE_AUDIT_CLASS_ALIASES = {"CODE": "CODE", "推得出": "CODE", "MIXED": "MIXED", "一半一半": "MIXED",
                             "CONTEXT": "CONTEXT", "脈絡": "CONTEXT"}
_NOTE_AUDIT_CLOSED = ("done", "superseded")


def _note_audit_judge_model(orchestrator):
    """判定者跟編排者同一家,模型寫死(計劃〈做法〉第 3 節第 2 點):claude → opus;codex → 既有 Codex 審查席常數。"""
    return {"claude": "opus", "codex": _CODEX_SEAT_MODEL}.get(orchestrator)


def _note_audit_config(text):
    """被檢查版本的 .lumos/config.json 內容(bytes 或 None)→ (gate, warnings)。照 _note_shape_config 的讀法。"""
    import json as _j
    if text is None:
        return "block", []
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        return "block", [".lumos/config.json 讀不成 JSON,筆記內容審照預設 block"]
    na = cfg.get("note_audit") if isinstance(cfg, dict) else None
    if na is not None and not isinstance(na, dict):
        return "block", ["設定檔的 note_audit 不是物件(要寫成 {\"note_audit\": {\"gate\": \"warn\"}}),筆記內容審照預設 block"]
    g = na.get("gate") if isinstance(na, dict) else None
    if g is None:
        return "block", []
    if g not in _NOTE_AUDIT_GATE_VALUES:
        return "block", [f"note_audit.gate 只能是 block/warn/off,你寫的是 {g!r},照 block"]
    return g, []


def _note_audit_status_of(blob):
    """筆記內容(bytes)→ (type, status)。讀不到回 (None, None)。"""
    if blob is None:
        return None, None
    try:
        fm, _b = split_frontmatter(blob.decode("utf-8-sig"))
    except UnicodeDecodeError:
        return None, None
    if not fm:
        return None, None
    fields = parse_frontmatter(fm)[0]
    return str(fields.get("type", "")).strip() or None, str(fields.get("status", "")).strip() or None


def _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader):
    """範圍裡被收尾的計劃(計劃〈做法〉第 1 節):`type: project`、終點 status 是 done/superseded,而且範圍裡有某個提交
    把它從非收尾改成收尾——逐提交讀那篇的 status(改名跟著走;起點沒有這篇時第一個提交就算)。回 [路徑]。"""
    # 候選=範圍裡任一個提交碰過的筆記,不是頭尾淨差異:收尾→改回→再收尾時頭尾一模一樣,淨差異看不到(S3)
    rng0 = f"{base_where}..{tip_where}" if base_where else tip_where
    touched = _ns_git(repo_root, "log", "--format=", "--name-only", "-z", "-M", rng0, "--", vault_rel)
    if touched is None:
        return None
    out = []
    for p in sorted({x.strip("\n") for x in touched.decode("utf-8", errors="surrogateescape").split("\0")
                     if x.strip("\n").endswith(".md")}):
        ty, st = _note_audit_status_of(reader(p))
        if ty != "project" or st not in _NOTE_AUDIT_CLOSED:
            continue
        rng = f"{base_where}..{tip_where}" if base_where else tip_where
        lg = _ns_git(repo_root, "log", "--follow", "--format=%H", "--name-only", "-z", rng, "--", p)
        if lg is None:
            return None
        # git log -z --format=%H --name-only:「sha\0\n路徑\0」一筆接一筆(實測;換行黏在路徑前面);逐筆取 (sha, 那時的路徑)
        pairs, cur = [], None
        for tok in lg.decode("utf-8", errors="surrogateescape").split("\0"):
            tok = tok.strip("\n")
            if not tok:
                continue
            if cur is None and _LENS_SHA_RE.fullmatch(tok):
                cur = tok
            elif cur is not None:
                pairs.append((cur, tok))
                cur = None
        specs = [f"{s}:{q}" for s, q in pairs]
        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
        states = [_note_audit_status_of(b)[1] for b in (blobs or [])]
        old = pairs[-1][1] if pairs else p
        base_state = None
        if base_where:
            if pairs:
                # 最舊那個碰到它的提交若是改名,git log 給的是新路徑;起點那時的路徑要對起點做改名偵測(代碼審 r1 正確性席:
                # 已收尾的計劃只改名,原本讀不到起點狀態、被當成這次收尾)
                rn = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", base_where, pairs[-1][0], "--", vault_rel)
                if rn is not None:
                    old = _nodehome_name_status(rn, norm=False)[1].get(old, old)
            bb = _nodehome_cat_blobs(repo_root, [f"{base_where}:{old}"])
            base_state = _note_audit_status_of(bb[0] if bb else None)[1]
        seq = [base_state, *states[::-1]]          # 由舊到新
        if any((a not in _NOTE_AUDIT_CLOSED) and (b in _NOTE_AUDIT_CLOSED) for a, b in zip(seq, seq[1:])):
            out.append(p)
    return out


def _note_audit_items(repo_root, base_where, tip_where, vault_rel):
    """這次要審的每一行 → (items, errs) 或 None。item={id, path, line, text, region, heading, done, context, ctx_fp}。
    一般新寫的行借第一層的共用函式(推送前掛鉤的標記、不逐提交判);被收尾的計劃整篇進完成審(已翻案的決策不進)。"""
    import hashlib
    reader = _nodehome_reader(repo_root, tip_where)
    res = _notelines_new(repo_root, False, base_where, tip_where, vault_rel, reader=reader,
                         mark=_NOTE_AUDIT_GOLIVE_MARK, hook=_NOTELINES_PREPUSH, per_commit=False)
    if res is None:
        return None
    notes, errs, _old = res
    closed = _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader)
    if closed is None:
        return None
    rows_by = {p: (text, {i for i, _l, _r in rows}) for p, text, rows in notes}
    for p in closed:
        if p in rows_by:
            continue
        b = reader(p)
        try:
            rows_by[p] = (b.decode("utf-8-sig"), set())
        except (UnicodeDecodeError, AttributeError):
            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
    items = []
    for p, (text, new_lines) in sorted(rows_by.items()):
        lines = text.split("\n")
        regs = _notelines_regions(text)
        heads = _notelines_headings(text, regs)
        struct = _notelines_structural_lines(text)
        dfields = _notelines_decision_fields(text) if p in closed else {}
        for i, ln in enumerate(lines, 1):
            reg = regs[i - 1]
            if not ln.strip() or reg == "other" or i in struct:
                continue
            done = p in closed
            if done and reg == "decisions" and not dfields.get(i, ("", "", True))[2]:
                if i not in new_lines:
                    continue
                done = False                        # 已翻案的決策只排除在完成審外,新寫的行照一般規則判
            if not done and i not in new_lines:
                continue
            ctx = lines[max(0, i - 3):i - 1] + lines[i:i + 2]
            items.append({"id": _notelines_content_id(p, reg, heads[i - 1], ln, done=done), "path": p, "line": i,
                          "text": ln, "region": reg, "heading": heads[i - 1], "done": done,
                          "context": (lines[max(0, i - 3):i - 1], lines[i:i + 2]),
                          "ctx_fp": hashlib.sha256("\n".join(ctx).encode("utf-8")).hexdigest()[:16]})
    return items, errs


def _note_audit_parse_verdict(raw):
    """判定檔內容 → dict 或 None(壞掉)。"""
    import json as _j
    try:
        d = _j.loads(raw.decode("utf-8") if isinstance(raw, bytes) else raw)
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(d, dict) or d.get("kind") not in ("判定", "申訴", "略過") or not isinstance(d.get("rows"), list):
        return None
    for r in d["rows"]:
        if not isinstance(r, dict) or not isinstance(r.get("id"), str) or r.get("class") not in ("CODE", "MIXED", "CONTEXT", "SKIP"):
# hook 是薄殼(scripts/hooks/claude/dispatch-lens-hook.py),所有 git/合約/圖譜判斷都在這裡,
# 沿用既有 helper(_git_commit_exists / INVARIANT_RE 家族 / _vault_in 的排序規則)。
# 消毒原則(r2/r3 載荷席):來自圖譜或 diff 的自由文字零輸出——只印固定字彙、base 已追蹤路徑、
# base 版合約行(KEY: 行)。清單本身仍用工作樹圖譜算(d3:能藏不能說)。
# rc:0=成功(含 0 篇,text 空)/2=輸入或 git 壞/3=vault 缺/4=base 不在主線
# ---------------------------------------------------------------------------
_LENS_HEADER = "lumos 自動附加:本次改動的固定席節點(來源 impact --diff,只供參考)"
_LENS_SHA_RE = re.compile(r"^[0-9a-f]{40}$|^[0-9a-f]{64}$")
_LENS_KIND = {"direct": "直接相依", "indirect": "間接相依", "incident": "事故", "home": "家"}


def _lens_kind_of(v):
    """派工鏡頭那一行要標什麼種類(推筆記認家 [S6][S8])。

    「家」是標記不是種類:一篇本來就因為直接相依進來、又剛好是這支檔的家,它的 kind 還是 direct。
    對讀派工單的人來說「這篇管這支檔」比「這篇有提到這支檔」重要,所以家優先顯示。
    """
    # ★事故不能被蓋掉★:一篇既是家、又出過事故,讀派工單的人最需要知道的是「這裡出過事」
    # ——所以兩個都印(代碼審 r1 正確性席)。
    base = _LENS_KIND.get(v.get("kind"), None)
    if not v.get("home"):
        return base
    return f"{base}·{_LENS_KIND['home']}" if base and v.get("kind") == "incident" else _LENS_KIND["home"]


def _lens_range_ok(diff_range):
    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
        return None
    parts = diff_range.split("..")
    if len(parts) != 2 or not parts[0] or not parts[1]:
        return None
    if any(ch.isspace() for ch in diff_range):
        return None
    return parts[0], parts[1]


_ZERO_SHA_RE = re.compile(r"0{40}|0{64}")          # SHA-1 與 SHA-256 專案的全零(筆記內容審代碼審 r3 兩席)


def _lens_push_base(repo_root, a, tip):
    """推送範圍的起點 → (起點 sha 或 None, 說明)。None=這次沒有新東西、不用查。
    起點是 40 個 0(GitHub 對新分支首推給的 before)或本機找不到(force-push 後的舊頂端)時:頂端落後或等於主線(本地主分支
    的 upstream)頂端就沒有新東西;其他從跟主線的分岔點算;連主線都找不到才用空樹(筆記形狀擋與每支檔有家之後截到上線點;
    代碼審那道照它原本拿到空樹的做法)。
    ★頂端等於主線頂端也算沒有新東西★:代碼審 r2 曾改成「從上線點起全查」想擋 force-push 改寫主線,r3 查出它讓零提交的新分支
    被主線舊帳誤擋、代碼審那道整庫當新增、而且 force-push 後再推一次照樣漏——「繞過本機掛鉤又 force-push 改寫主線」是存心繞過,
    跟筆記內容審只防疏忽同一條線,不在這道後盾要防的範圍(呼叫端回 None 時記一筆 skipped 帳,事後看得到)。
    ★不能直接回「範圍找不到、放行」★:照 doctor 給的 CI 步驟貼的消費專案,新分支首推會整批放過(2026-09-28 漏網
    ESC-61fc2d87);★也不能一律當空樹★:新分支開在主線頂端時會把主線上線後的舊帳當新增誤擋(同一件事的代碼審)。
    明寫空樹的起點照原意(從空樹比)。筆記形狀擋與每支檔有家共用這支。"""
    if a == _EMPTY_TREE_SHA:
        return a, ""
    if not _ZERO_SHA_RE.fullmatch(a or ""):
        s = _lens_full_sha(repo_root, a)
        if s is not None:
            return s, ""
    why = "新分支首推" if _ZERO_SHA_RE.fullmatch(a or "") else "起點在本機找不到"
    ml = _mainline_ref(repo_root, remote_only=True)
    if ml:
        anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
        if anc is not None and anc.returncode == 0:
            return None, f"{why},而且頂端已在主線({ml[0]})上——沒有新東西"
        mb = _lens_git(repo_root, "merge-base", tip, ml[1])
        if mb is not None and mb.returncode == 0 and mb.stdout.strip():
            return mb.stdout.strip(), f"{why}:從跟主線({ml[0]})的分岔點算"
    return _EMPTY_TREE_SHA, f"{why}:找不到主線,從空樹算(截到上線點)"


def _lens_git(repo_root, *args, quote=False, binary=False):
    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
    import subprocess as _sp
    cmd = ["git", "-C", str(repo_root)]
    if quote:
        cmd += ["-c", "core.quotePath=false"]
    try:
        if binary:
            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
    except (OSError, _sp.TimeoutExpired):
        return None


def _lens_full_sha(repo_root, rev):
    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
    if r is None or r.returncode != 0:
        return None
    sha = r.stdout.strip()
    return sha if _LENS_SHA_RE.match(sha) else None


def _mainline_ref(repo_root, remote_only=False):
    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
    拿它當「已在主線上」會把整批都排除掉)。"""
    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
        sha = _lens_full_sha(repo_root, cand)
        if sha:
            return cand, sha
    return None


