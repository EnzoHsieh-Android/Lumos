 22396	def _nodehome_top_dirs(all_paths):
 22397	    """repo 頂層的資料夾名;點開頭的不算(.git、.github 這類不是程式資料夾)。
 22398	    別人的檔的裸路徑判定([S8])與測試資料夾的同名資料夾錨共用這一支。"""
 22399	    return {p.split("/", 1)[0] for p in all_paths if "/" in p and not p.startswith(".")}
