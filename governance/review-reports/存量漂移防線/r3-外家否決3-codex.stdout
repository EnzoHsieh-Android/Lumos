 22492	def _nodehome_git(repo_root, *args):
 22493	    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
 22494	    r = _lens_git(repo_root, *args, binary=True)
 22495	    if r is None or r.returncode != 0:
 22496	        return None
 22497	    return r.stdout
