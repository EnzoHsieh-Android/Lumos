 23690	def _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, *, reader, mark, hook=_NOTELINES_PRECOMMIT,
 23691	                   per_commit=True, exclude_remote=True, max_count=None):
 23692	    """範圍裡新寫、而且終點版本還在的筆記行——筆記形狀擋與筆記內容審共用(Projects/筆記內容審_計劃 [S1][S2])。
 23693	    → (notes, errs, old_by) 或 None(git 失敗)。notes=[(路徑, 全文, [(行號, 行文字, 區塊)])],只收 body/summary/
 23694	    decisions 三塊的非空行;errs=讀不成 UTF-8 的筆記;old_by={NFC 路徑: 這道檢查還沒上線時寫的行}。
 23695	    ★per_commit★:True=逐提交看「那個提交自己的 hook 有沒有 mark」(提交前掛鉤在寫的那一刻跑,第一層);
 23696	    False=不逐提交判、只靠範圍截斷(推送時才跑的閘,跑的是當下工作目錄那份掛鉤,第二層)——★要明寫傳 False★,
 23697	    不傳會落到第一層的預設。找不到上線點時照既有語意不過濾。"""
 23698	    if staged:
 23699	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23700	        if d is None:
 23701	            return None
 23702	        added = {p: rows for p, rows in _notelines_parse_added(d).items() if p.endswith(".md")}
 23703	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23704	        texts_by, old_by = None, {}
 23705	    else:
 23706	        live_mark = mark if (per_commit and _nodehome_golive(repo_root, tip_where, mark, hook)) else None
 23707	        ra = _notelines_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
 23708	                                    mark=live_mark, max_count=max_count, hook=hook)
 23709	        if ra is None:
 23710	            return None
 23711	        texts_by, paths, old_by = ra
 23712	        cand = {p: None for p in paths}
 23713	    notes, errs = [], []
 23714	    for p, linenos in sorted(cand.items()):
 23715	        b = reader(p)
 23716	        if b is None:
 23717	            continue
 23718	        try:
 23719	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 23720	        except UnicodeDecodeError:
 23721	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 23722	            continue
 23723	        lines = text.split("\n")
 23724	        regs = _notelines_regions(text)
 23725	        rows = []
 23726	        for i, ln in enumerate(lines, 1):
 23727	            if linenos is not None and i not in linenos:
 23728	                continue
 23729	            if texts_by is not None and ln.strip() not in texts_by.get(nfc(p), ()):
 23730	                continue
 23731	            if not ln.strip() or regs[i - 1] == "other":
 23732	                continue
 23733	            rows.append((i, ln, regs[i - 1]))
 23734	        notes.append((p, text, rows))
 23735	    return notes, errs, old_by
