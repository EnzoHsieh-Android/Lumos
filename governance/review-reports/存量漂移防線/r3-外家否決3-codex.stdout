 23568	def _ns_git(repo_root, *args):
 23569	    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
 23570	    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
 23571	    r = _lens_git(repo_root, *args, quote=True, binary=True)
 23572	    if r is None or r.returncode != 0:
 23573	        return None
 23574	    return r.stdout
 23575	
 23576	
 23577	def _ns_diff(repo_root, *args):
 23578	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23579	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
 23580	
 23581	
 23582	def _ns_mainline_refs(repo_root):
 23583	    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
 23584	    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
 23585	    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
 23586	    ml = _mainline_ref(repo_root, remote_only=True)
 23587	    return [ml[1]] if ml else []
 23588	
 23589	
 23590	def _ns_exclusions(repo_root, tip):
 23591	    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
 23592	    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
 23593	    out = []
 23594	    for ref in _ns_mainline_refs(repo_root):
 23595	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
 23596	        if r is not None and r.returncode == 1:
 23597	            out.append(ref)
 23598	    return out
