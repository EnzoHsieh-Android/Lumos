 23848	def _ns_pin_ok(repo_root, p, lno, s):
 23849	    sha = _pin_commit(repo_root, s)
 23850	    return sha is not None and _validate_repo_ref(repo_root, p, lno, at_sha=sha)[0] == "ok"
