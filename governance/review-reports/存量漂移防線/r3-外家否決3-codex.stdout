 13956	def edit_fm_sync_status_tag(fm_lines, status):
 13957	    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
 13958	    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
 13959	    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
 13960	    fm = list(fm_lines)
 13961	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 13962	    if "tags" not in struct or struct["tags"][2] != "list":
 13963	        return fm, False
 13964	    s, e, _kind = struct["tags"]
 13965	    found = False
 13966	    for i in range(s + 1, e + 1):
 13967	        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
 13968	        if m:
 13969	            fm[i] = f"{m.group(1)}status/{status}"
 13970	            found = True
 13971	    return fm, found
