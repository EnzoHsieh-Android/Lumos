 23738	_NOTELINES_HEADING_RE = re.compile(r"^#{1,6}\s+(.*?)\s*#*\s*$")
 23739	_NOTELINES_DECISION_KEY_RE = re.compile(r"^(\s*)(?:-\s+)?([A-Za-z_][\w-]*)\s*:")
 23740	
 23741	
 23742	def _notelines_decision_fields(text):
 23743	    """decisions 裡每一行屬於哪一條決策的哪一欄 → {行號(從1起): (決策編號, 欄名, valid)}(Projects/筆記內容審_計劃 [S3][S4])。
 23744	    既有 decisions_items 只給每條決策的起訖行;決策編號用 decision-supersede 同一種 `id:` 比對,欄名逐行歸屬:
 23745	    跟項目子鍵同縮排、`鍵:` 開頭的行是那一欄,後面縮排更深或沒有 `鍵:` 的續行跟著前一欄。沒有編號的決策用 `#<序號>`。"""
 23746	    fm, _b = split_frontmatter(text)
 23747	    out = {}
 23748	    if not fm:
 23749	        return out
 23750	    di = decisions_items(fm)
 23751	    if di is None:
 23752	        return out
 23753	    _s, _e, items, _item_indent, sub_indent = di
 23754	    for n, (st, en) in enumerate(items, 1):
 23755	        did, valid, cur = f"#{n}", True, None
 23756	        fields = []
 23757	        for k in range(st, en + 1):
 23758	            ln = fm[k]
 23759	            m = _NOTELINES_DECISION_KEY_RE.match(ln)
 23760	            ind = len(ln) - len(ln.lstrip(" "))
 23761	            is_key = m and (k == st or ind == sub_indent)
 23762	            if is_key:
 23763	                cur = m.group(2)
 23764	                val = ln.split(":", 1)[1].strip()
 23765	                if cur == "id":
 23766	                    mm = re.match(r"^(d\d+)$", val)
 23767	                    if mm:
 23768	                        did = mm.group(1)
 23769	                elif cur == "valid":
 23770	                    valid = val.strip("\"'").lower() != "false"
 23771	            fields.append((k, cur))
 23772	        for k, f in fields:
 23773	            out[k + 2] = (did, f or "", valid)       # fm[0] 是全文第 2 行
 23774	    return out
 23775	
 23776	
 23777	def _notelines_headings(text, regs):
 23778	    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
 23779	    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
 23780	    lines = text.split("\n")
 23781	    vis = {i for i, _l in _visible_lines(lines)}
 23782	    dfields = _notelines_decision_fields(text)
 23783	    out, cur = [], ""
 23784	    for i, ln in enumerate(lines, 1):
 23785	        reg = regs[i - 1]
 23786	        if reg == "body" and i in vis:
 23787	            m = _NOTELINES_HEADING_RE.match(ln)
 23788	            if m:
 23789	                cur = m.group(1).strip()
 23790	        if reg == "summary":
 23791	            out.append("summary")
 23792	        elif reg == "decisions":
 23793	            did, f, _v = dfields.get(i, ("", "", True))
 23794	            out.append(f"decisions/{did}/{f}")
 23795	        elif reg == "body":
 23796	            out.append(cur)
 23797	        else:
 23798	            out.append("")
 23799	    return out
 23800	
