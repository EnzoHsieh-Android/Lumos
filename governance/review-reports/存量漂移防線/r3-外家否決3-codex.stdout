 23853	def _ns_is_regen(text):
 23854	    """帶 regen 的重建筆記:照 Check J 看解析後的值(空字串不算;代碼審 r3 外家席:原本看原始文字,`regen: ""` 也算)。"""
 23855	    fm, _b = split_frontmatter(text)
 23856	    if not fm:
 23857	        return False
 23858	    v = parse_frontmatter(fm)[0].get("regen")
 23859	    return isinstance(v, str) and bool(v.strip())
