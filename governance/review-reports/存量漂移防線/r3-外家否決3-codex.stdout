 23501	def _note_shape_config(text):
 23502	    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
 23503	    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
 23504	    if text is None:
 23505	        return "block", []
 23506	    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 23507	    try:
 23508	        data = json.loads(raw)
 23509	    except Exception as e:
 23510	        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
 23511	    ns = data.get("note_shape") if isinstance(data, dict) else None
 23512	    if ns is None:
 23513	        return "block", []
 23514	    if not isinstance(ns, dict):
 23515	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23516	    g = ns.get("gate", "block")
 23517	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23518	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23519	    return g, []
