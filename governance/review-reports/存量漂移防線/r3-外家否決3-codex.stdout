 23522	def _notelines_regions(text):
 23523	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23524	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23525	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23526	    lines = text.split("\n")
 23527	    fm, _body = split_frontmatter(text)
 23528	    if fm is None:
 23529	        if text.startswith("---"):
 23530	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23531	        return ["body"] * len(lines)
 23532	    out = ["body"] * len(lines)
 23533	    end = len(fm) + 1                            # 收尾 --- 那一行
 23534	    out[0] = out[end] = "other"
 23535	    cur = "other"
 23536	    for i in range(1, end):
 23537	        ln = lines[i]
 23538	        m = TOP_KEY_RE.match(ln)
 23539	        if m:
 23540	            k = m.group(1)
 23541	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23542	            out[i] = "other"
 23543	            continue
 23544	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23545	    return out
 23546	
