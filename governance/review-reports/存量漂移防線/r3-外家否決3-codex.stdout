 14341	            return want in tags and all(t == want for t in tags if t.startswith("status/"))
 14342	        return True
 14343	
 14344	    atomic_write_verify(path, new_lines, key, _check)
 14345	    print(f"✓ set {rel}: {key} 已改成 {exp}" + ("(狀態標籤 status/* 也同步改了)" if tag_synced else ""))
