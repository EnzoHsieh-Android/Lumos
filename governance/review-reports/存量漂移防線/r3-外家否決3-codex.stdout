 23484	def _pin_commit(repo_root, pin):
 23485	    """釘版本 `@<提交>` 的提交字串 → 完整提交編號;不合法回 None(筆記形狀擋 [S2])。
 23486	    ★至少 12 位十六進位★(HEAD、分支名、標籤、main~1 這類會移動的名字不收);★解析結果要以它開頭★
 23487	    (剛好取名成十六進位的分支會被 git 當分支解析,指到的是會移動的分支頂端);★要在某個本機或遠端追蹤分支的歷史上★
 23488	    (用 git commit-tree 在本機捏造、從沒進過任何分支的提交物件,只查存在性會被放過——r3 正確性席實測)。"""
 23489	    if not pin or not _NS_PIN_HEX_RE.match(pin):
 23490	        return None
 23491	    full = _lens_full_sha(repo_root, pin)
 23492	    if not full or not full.lower().startswith(pin.lower()):
 23493	        return None
 23494	    r = _lens_git(repo_root, "for-each-ref", "--count=1", "--contains", full, "--format=%(refname)",
 23495	                  "refs/heads", "refs/remotes")
 23496	    if r is None or r.returncode != 0 or not r.stdout.strip():
 23497	        return None
 23498	    return full
 23499	
