 23904	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 23905	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 23906	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 23907	    if ch is None:
 23908	        return []
 23909	    lst_t = _nodehome_list(repo_root, tip_where)
 23910	    lst_b = _nodehome_list(repo_root, base_where)
 23911	    if lst_t is None or lst_b is None:
 23912	        return []
 23913	    reader_b = _nodehome_reader(repo_root, base_where)
 23914	    out = []
 23915	    for code, _old, new in ch:
 23916	        if not new or code == "D":
 23917	            continue
 23918	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 23919	            continue
 23920	        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
 23921	        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
 23922	            out.append(new)
 23923	    return out
