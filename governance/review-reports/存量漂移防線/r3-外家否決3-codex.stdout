 23601	def _notelines_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, mark=None, max_count=None,
 23602	                           hook=_NOTELINES_PRECOMMIT):
 23603	    """推送前:範圍裡每個提交各自新增的筆記行 → ({NFC 路徑: 行文字集合}, [範圍淨改動的筆記路徑(git 原樣)],
 23604	    {NFC 路徑: 這道檢查還沒上線的提交寫的行})。git 失敗回 None。
 23605	    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
 23606	    改名照每個提交(合併提交是每個上一版)的改名偵測往後帶到終點路徑(r3 外家席)。
 23607	    ★鍵用 NFC、拿去 git 查的一律用原樣路徑★(驗收輪通才席:NFC 過的路徑對存 NFD 的樹 cat-file、路徑篩選都查不到)。
 23608	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
 23609	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
 23610	    ★寫的時候這道檢查還沒上線的提交不查★(mark):看那個提交自己的提交前掛鉤有沒有上線標記——上線前開的分支上線後
 23611	    才合進來,那些行是舊帳(r3 通才席);原本用「是不是上線點的後代」代替,兩條分支各自裝過時另一條整批漏查(驗收輪通才席)。
 23612	    那些行另外收進第三個回傳值,喚醒那條路也跳過(驗收輪外家席)。max_count:只看最新那幾個提交(doctor 的上限)。"""
 23613	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23614	    if exclude_remote:
 23615	        ml = _ns_exclusions(repo_root, tip)
 23616	        if ml:
 23617	            rl += ["--not", *ml]
 23618	    if max_count:
 23619	        rl.append(f"--max-count={int(max_count)}")
 23620	    raw = _nodehome_git(repo_root, *rl)
 23621	    if raw is None:
 23622	        return None
 23623	    commits = [ln.split() for ln in raw.decode("ascii", errors="replace").splitlines() if ln.split()]
 23624	    live = None
 23625	    if mark and commits:
 23626	        hb = _nodehome_cat_blobs(repo_root, [f"{c[0]}:{hook}" for c in commits])
 23627	        if hb is None:
 23628	            return None
 23629	        live = {c[0] for c, b in zip(commits, hb) if b is not None and mark.encode() in b}
 23630	    by_path, old_by = {}, {}
 23631	
 23632	    def _renames(a, b):
 23633	        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
 23634	        return None if r is None else _nodehome_name_status(r, norm=False)[1]     # 原樣 新路徑 → 舊路徑
 23635	
 23636	    def _carry(ren):
 23637	        for new_, old_ in (ren or {}).items():
 23638	            ko, kn = nfc(old_), nfc(new_)
 23639	            for d_ in (by_path, old_by):
 23640	                if ko in d_ and ko != kn:
 23641	                    d_.setdefault(kn, set()).update(d_.pop(ko))
 23642	
 23643	    for shas in commits:
 23644	        sha, parents = shas[0], shas[1:]
 23645	        first = parents[0] if parents else _EMPTY_TREE_SHA
 23646	        ren = _renames(first, sha)
 23647	        if ren is None:
 23648	            return None
 23649	        _carry(ren)
 23650	        dest = by_path if (live is None or sha in live) else old_by
 23651	        if len(parents) <= 1:
 23652	            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
 23653	            if d is None:
 23654	                return None
 23655	            for p, rows in _notelines_parse_added(d).items():
 23656	                dest.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23657	            continue
 23658	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 23659	        if names is None:
 23660	            return None
 23661	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23662	        pren = [_renames(pp, sha) or {} for pp in parents]
 23663	        for pr in pren[1:]:
 23664	            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
 23665	            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
 23666	            _carry(pr)
 23667	        specs = []
 23668	        for p in paths:
 23669	            specs.append(f"{sha}:{p}")
 23670	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
 23671	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23672	        k = 1 + len(parents)
 23673	        for i, p in enumerate(paths):
 23674	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23675	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23676	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23677	                d = _ns_diff(repo_root, first, sha, "--", p)
 23678	                if d is None:
 23679	                    return None
 23680	                for _p, rows in _notelines_parse_added(d).items():
 23681	                    dest.setdefault(nfc(p), set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23682	            else:
 23683	                dest.setdefault(nfc(p), set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
 23684	    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 23685	    if net is None:
 23686	        return None
 23687	    return by_path, [p for p in _nodehome_split_z(net) if p.endswith(".md")], old_by
 23688	
