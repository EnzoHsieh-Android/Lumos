  4960	    _FLAG_ENUM = {"TECHNICAL", "DECISION", "ORIGIN"}
  4961	    _created_e = str(n.fields.get("created") or n.fields.get("date") or "")
  4962	    if _created_e >= _ENUM_CUTOFF:
  4963	        _st = str(n.fields.get("status") or "")
  4964	        if t in _STATUS_ENUM and _st and _st not in _STATUS_ENUM[t]:
