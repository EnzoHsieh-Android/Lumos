 14095	def decisions_items(fm_lines):
 14096	    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
 14097	    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
 14098	    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
 14099	    block = None
 14100	    for k, s, e, kind in fm_structure(fm_lines):
 14101	        if k == "decisions" and kind == "list":
 14102	            block = (s, e)
 14103	            break
 14104	    if block is None:
 14105	        return None
 14106	    s, e = block
 14107	    item_indent = None
 14108	    starts = []
 14109	    for i in range(s + 1, e + 1):
 14110	        ln = fm_lines[i]
 14111	        if not ln.strip():
 14112	            continue
 14113	        m = re.match(r"^(\s*)-\s", ln)
 14114	        if m:
 14115	            ind = len(m.group(1))
 14116	            if item_indent is None:
 14117	                item_indent = ind
 14118	            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
 14119	                starts.append(i)
 14120	    items = []
 14121	    for idx, st in enumerate(starts):
 14122	        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
 14123	        while en > st and not fm_lines[en].strip():
 14124	            en -= 1
 14125	        items.append((st, en))
 14126	    sub_indent = (item_indent + 2) if item_indent is not None else 4
 14127	    return s, e, items, (item_indent or 2), sub_indent
