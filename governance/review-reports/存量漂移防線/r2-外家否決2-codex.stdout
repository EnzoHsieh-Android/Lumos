 11792	def cmd_guard_settle(env, ref, method):
 11793	    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過。"""
 11794	    if not IDENT_RE.match(method or ""):
 11795	        print(f"擋下:測試方法名『{method}』不合法(只能字母/數字/底線,不能數字開頭)", file=sys.stderr)
 11796	        return 2
