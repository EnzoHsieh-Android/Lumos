 11900	def cmd_guard_required(env, as_json=False):
 11901	    """列必要集合現況:待完成幾條、逾期幾條、快到期幾條。"""
 11902	    import datetime
 11903	    today = datetime.date.today()
 11904	    rows, overdue, soon = [], [], []
 11905	    for rel, n in _guard_nodes(env):
 11906	        st = str(n.fields.get("status") or "")
 11907	        due = str(n.fields.get("due") or "").strip()
 11908	        home = _guard_home_of(n)
 11909	        owner = str(n.fields.get("owner") or "").strip()
 11910	        body = (env.vault / rel).read_text(encoding="utf-8")
 11911	        m = re.search(r"^預告的合約:(.+)$", body, re.M)
 11912	        claim = (m.group(1).strip() if m else rel)
 11913	        rows.append((rel, st, due, home, owner, claim))
 11914	        if st != "pending":
 11915	            continue
 11916	        try:
 11917	            d = datetime.date.fromisoformat(due)
 11918	        except ValueError:
 11919	            continue
 11920	        # ★到期當天不算過期,隔天才算★:最遲日期是人手寫的本地日期;
 11921	        # 誤擋一次的代價比漏擋一天高(設計審 r1)
 11922	        if d < today:
 11923	            overdue.append((rel, due, owner, claim))
 11924	        elif (d - today).days <= 7:
 11925	            soon.append((rel, due, owner, claim))
 11926	    pend = [r for r in rows if r[1] == "pending"]
 11927	    print(f"必要合約:待完成 {len(pend)}、逾期 {len(overdue)}、快到期(七天內) {len(soon)}、"
 11928	          f"已通過 {len([r for r in rows if r[1] == 'pass'])}、"
 11929	          f"已棄置 {len([r for r in rows if r[1] == 'abandoned'])}")
 11930	    for rel, due, owner, claim in overdue:
 11931	        print(f"  ✗ 逾期 {due}(負責人 {owner}):{claim}")
 11932	        print(f"      {rel} — 做完跑 lumos guard settle,不做了跑 lumos guard abandon(要先簽核)")
 11933	    for rel, due, owner, claim in soon:
 11934	        print(f"  ⚠ 快到期 {due}(負責人 {owner}):{claim}")
 11935	        print(f"      {rel}")
 11936	    if not overdue and not soon and pend:
 11937	        for _rel, _st, due, _home, owner, claim in pend:
 11938	            print(f"  · 待完成 {due}(負責人 {owner}):{claim}")
 11939	    return 1 if overdue else 0
