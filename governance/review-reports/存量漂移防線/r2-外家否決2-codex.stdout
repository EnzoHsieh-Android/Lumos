 11581	            raise RuntimeError("寫完讀回來對不上")
 11582	    except (OSError, RuntimeError) as ex:
 11583	        print(f"擋下:守衛節點寫不進去,什麼都沒動: {ex}", file=sys.stderr)
 11584	        return False
 11585	    return True
