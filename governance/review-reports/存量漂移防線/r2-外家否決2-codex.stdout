 22509	def _nodehome_list(repo_root, where):
 22510	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 22511	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
 22512	    if where is None:
 22513	        return {}, []
 22514	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 22515	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 22516	    if raw is None:
 22517	        return None
 22518	    files, allp = {}, []
 22519	    for ent in raw.split(b"\0"):
 22520	        if not ent or b"\t" not in ent:
 22521	            continue
 22522	        meta, p = ent.split(b"\t", 1)
 22523	        parts = meta.split()
 22524	        if where == "index":
 22525	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 22526	                continue
 22527	            mode = parts[0]
 22528	        else:
 22529	            if len(parts) != 3:
 22530	                continue
 22531	            mode = parts[0]
 22532	        path = nfc(os.fsdecode(p))
 22533	        allp.append(path)
 22534	        if mode in (b"100644", b"100755"):
 22535	            files[path] = mode.decode()
 22536	    return files, allp
