 11778	    hits, only_case = _guard_touched_hits(files, touched)
 11779	    if hits:
 11780	        # ★只列解析得到的那幾篇★(代碼審 r2 通才席):這句話存在的目的是讓被擋的人知道去哪篇查,
 11781	        # 把找不到的節點也列進來,照著查的人會撲空。
 11782	        # ★收窄的粒度是「整篇家節點」不是「每條合約」★(代碼審 r1):同一篇掛兩條逾期合約時兩條都會擋。
 11783	        # 做得更細要讓每條合約自己記檔案清單(另一套資料);現在的代價是偶爾多擋一條,方向安全,
 11784	        # 但要讓人看得出來為什麼,不要變成無法解釋的誤擋。
 11785	        why = f";你這次改到 {'、'.join(hits[:3])}(它掛在 {'、'.join(found[:2])} 底下){broken}"
 11786	        if only_case and len(only_case) == len(hits):
 11787	            why += "——只有忽略大小寫才對得上,寧可多擋一次也不漏"
 11788	        return True, why
 11789	    return False, ("" if not broken else f";這次沒碰到它管的檔{broken}")
 11790	
