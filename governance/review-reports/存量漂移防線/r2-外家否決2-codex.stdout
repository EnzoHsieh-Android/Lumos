 22338	# 斜線也算檔名字元:不然正文寫 lib/src/pay.py 會被判成「有提到 src/pay.py」(代碼審 r2 合約席)
 22339	_HOME_MENTION_BOUNDARY = re.compile(r"[A-Za-z0-9_.@+/\-]")
 22340	
 22341	
 22342	def _home_mentions(scan_text, rel_path):
 22343	    """這段文字有沒有提到這支檔(完整路徑或裸檔名,整詞比對)。
 22344	
 22345	    ★不要用 `base in scan` 這種子字串比對★:新掛 `a.py`、正文只寫了 `xa.py`,子字串會判成「有提到」,
 22346	    提醒就被吃掉——代碼審 r1 邊界席實測。所以命中位置的前後要是非檔名字元(或字串邊界)才算。
 22347	    """
 22348	    base = rel_path.rsplit("/", 1)[-1]
 22349	    for token in (rel_path, base):
 22350	        if not token:
 22351	            continue
 22352	        start = 0
 22353	        while True:
 22354	            i = scan_text.find(token, start)
 22355	            if i < 0:
 22356	                break
 22357	            before = scan_text[i - 1] if i > 0 else ""
 22358	            after = scan_text[i + len(token)] if i + len(token) < len(scan_text) else ""
 22359	            if not _HOME_MENTION_BOUNDARY.match(before or " ") and not _HOME_MENTION_BOUNDARY.match(after or " "):
 22360	                return True
 22361	            start = i + 1
 22362	    return False
 22363	
