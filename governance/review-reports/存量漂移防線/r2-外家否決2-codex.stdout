  4948	    _ENUM_CUTOFF = "2026-08-06"
  4949	    _STATUS_ENUM = {
  4950	        "system": {"doing", "done", "planned", "deferred", "rejected", "superseded", "stale"},
  4951	        "project": {"todo", "doing", "done", "superseded"},
  4952	        "issue": {"open", "doing", "resolved", "done", "wontfix"},
  4953	        "verification": {"pass", "stale", "superseded", "pending", "abandoned"},
  4954	        # pending=預告了還沒做、abandoned=決定不做了的墓碑(必要合約清單_計劃)。
  4955	        # ★只是合法值,不代表被新規則管★:規則只認節點身上帶 guards 欄位的,手寫這兩個字行為照舊。
  4956	        "moc": {"doing", "done"},
  4957	    }
  4958	    _PRIORITY_ENUM = {"P0", "P1", "P2", "P3"}
