 13930	def fmt_list_item(value):
 13931	    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
 13932	    v = value.strip()
 13933	    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")
