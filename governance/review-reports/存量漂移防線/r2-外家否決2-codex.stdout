 22539	def _nodehome_changed_vs_disk(repo_root, where):
 22540	    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
 22541	    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
 22542	    if where == "index":
 22543	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
 22544	    else:
 22545	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
 22546	    if raw is None:
 22547	        return None
 22548	    return {nfc(x) for x in _nodehome_split_z(raw)}
