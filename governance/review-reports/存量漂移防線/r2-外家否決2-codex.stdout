 23862	def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name, regen=False):
 23863	    """一行新增內容 → [(規則, 片段, 改法)]。by_name(檔名)→ 同名的程式檔清單。"""
 23864	    out = []
 23865	    # [src:路徑:行號] 是從程式碼重建的筆記的出處標記,★只在帶 regen 的筆記的 summary 裡★歸重建守衛(Check J)驗;
 23866	    # 別的地方照一般行號引用判(代碼審 r2 通才席:原本對所有筆記豁免,一般筆記寫 [src:…] 就能夾帶行號)
 23867	    scan = SRC_REF_RE.sub(" ", text) if (regen and region == "summary") else text
 23868	    pins, singles = [], []
 23869	    full, _bare = _node_code_ref_tokens(scan, top_dirs, bare_text=True, anchors=True, keep_fences=True,
 23870	                                        pins=pins, singles=singles,
 23871	                                        exists=lambda x, _s=None: x in files or ("/" not in x and bool(by_name(x))))
 23872	    fix_pin = ("`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
 23873	               "HEAD、分支名、標籤會移動,不算釘住")
 23874	
 23875	    for p, lno, s in pins:
 23876	        # 只管程式檔與測試檔——跟沒釘版本時一致(.md、不存在的路徑都不管;代碼審 r1 測試席、r2 外家席)
 23877	        if lno and _ns_is_code(p, reader, files) and not _ns_pin_ok(repo_root, p, lno, s):
 23878	            out.append(("釘版本不合法", f"`{p}@{s}:{lno}`", fix_pin))
 23879	    for p, lno in full:
 23880	        if lno and _ns_is_code(p, reader, files):
 23881	            out.append(("程式行號引用", f"`{p}:{lno}`",
 23882	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{lno}`"))
 23883	    for name, lno, s in singles:
 23884	        cands = by_name(name)
 23885	        if len(cands) != 1:
 23886	            continue
 23887	        if s is None:
 23888	            out.append(("程式行號引用", f"`{name}:{lno}`(= {cands[0]})",
 23889	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{lno}`"))
 23890	        elif not _ns_pin_ok(repo_root, cands[0], lno, s):
 23891	            out.append(("釘版本不合法", f"`{name}@{s}:{lno}`(= {cands[0]})", fix_pin))
 23892	    if region == "summary":
 23893	        m = SYMBOL_RE.match(text.strip())
 23894	        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
 23895	        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
 23896	        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
 23897	        if m and not skip:
 23898	            for _w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
 23899	                out.append(("現況描述沒寫來源", text.strip()[:60],
 23900	                            "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
 23901	    return out
