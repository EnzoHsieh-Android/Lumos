 11798	    if rel is None:
 11799	        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
 11800	        return 2
 11801	    if str(n.fields.get("status")) != "pending":
 11802	        print(f"擋下:{rel} 現在是 {n.fields.get('status')},只有待完成的才能轉正", file=sys.stderr)
 11803	        return 2
 11804	    home = _guard_home_of(n)
 11805	    home_rel = env.find(home)
 11806	    if home_rel is None:
 11807	        print(f"擋下:守衛節點指名的功能節點 {home} 找不到", file=sys.stderr)
 11808	        return 2
 11809	    body = (env.vault / rel).read_text(encoding="utf-8")
 11810	    m = re.search(r"^預告的合約:(.+)$", body, re.M)
 11811	    claim = m.group(1).strip() if m else ""
 11812	    if not claim:
 11813	        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條", file=sys.stderr)
 11814	        return 2
 11815	    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
 11816	    if lines is None:
 11817	        print(f"擋下:{_err}", file=sys.stderr)
 11818	        return 2
 11819	    newline = f"  KEY:★INVARIANT★ {claim} [test:{method}]"
