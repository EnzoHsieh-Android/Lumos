 24199	def _note_audit_config(text):
 24200	    """被檢查版本的 .lumos/config.json 內容(bytes 或 None)→ (gate, warnings)。照 _note_shape_config 的讀法。"""
 24201	    import json as _j
 24202	    if text is None:
 24203	        return "block", []
 24204	    try:
 24205	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 24206	    except (ValueError, UnicodeDecodeError):
 24207	        return "block", [".lumos/config.json 讀不成 JSON,筆記內容審照預設 block"]
 24208	    na = cfg.get("note_audit") if isinstance(cfg, dict) else None
 24209	    if na is not None and not isinstance(na, dict):
 24210	        return "block", ["設定檔的 note_audit 不是物件(要寫成 {\"note_audit\": {\"gate\": \"warn\"}}),筆記內容審照預設 block"]
 24211	    g = na.get("gate") if isinstance(na, dict) else None
 24212	    if g is None:
 24213	        return "block", []
 24214	    if g not in _NOTE_AUDIT_GATE_VALUES:
 24215	        return "block", [f"note_audit.gate 只能是 block/warn/off,你寫的是 {g!r},照 block"]
 24216	    return g, []
