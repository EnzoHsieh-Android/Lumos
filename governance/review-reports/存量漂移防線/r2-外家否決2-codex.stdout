 11559	    guard_lines = [
 11560	        "---\n", "type: verification\n", "status: pending\n",
 11561	        f"created: {today}\n", f"updated: {today}\n", f"due: {due.strip()}\n",
 11562	        f"owner: {owner.strip()}\n",
 11563	        f"{GUARD_MARK_FIELD}:\n", f"  - {rel[:-3] if rel.endswith('.md') else rel}\n",
 11564	        "phases:\n"] + [f"  - {x}\n" for x in phases] + [
 11565	        "plan_refs:\n", f"  - \"[[{prel[:-3] if prel.endswith('.md') else prel}]]\"\n",
