 29249	def _lens_git(repo_root, *args, quote=False, binary=False):
 29250	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 29251	    import subprocess as _sp
 29252	    cmd = ["git", "-C", str(repo_root)]
 29253	    if quote:
 29254	        cmd += ["-c", "core.quotePath=false"]
 29255	    try:
 29256	        if binary:
 29257	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 29258	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 29259	    except (OSError, _sp.TimeoutExpired):
 29260	        return None
 29261	
