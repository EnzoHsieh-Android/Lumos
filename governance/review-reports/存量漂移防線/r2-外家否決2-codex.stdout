 23830	def _ns_is_code(path, reader, files):
 23831	    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
 23832	    if path not in files:
 23833	        return False
 23834	    kind = _nodehome_code_kind(path)
 23835	    if kind == "ext":
 23836	        return True
 23837	    if kind != "shebang?":
 23838	        return False
 23839	    b = reader(path)
 23840	    return b is not None and _head_is_shebang(b[:200])
