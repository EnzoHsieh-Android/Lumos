 11942	def cmd_guard_bind(env, node, invariant_substr, method, platform=None):
 11943	    if not IDENT_RE.match(method):
 11944	        print(f"擋下:method『{method}』不是合法的方法名(只能用字母/數字/底線,不能數字開頭)", file=sys.stderr)
 11945	        return 2
 11946	    # 多平台:平台另帶(method 維持識別字、不含冒號),寫成 [test:平台:方法]。IDENT_RE 不放寬。
 11947	    ref = f"{platform}:{method}" if platform else method
 11948	    rel = env.find(node)
 11949	    if rel is None:
 11950	        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
 11951	        return 2
 11952	    path = env.vault / rel
 11953	    try:
 11954	        lines, _, e = load_raw_for_edit(path)
 11955	    except (ValueError, RuntimeError) as ex:
 11956	        print(f"擋下:{ex}", file=sys.stderr)
 11957	        return 2
 11958	    target_idx = None
 11959	    for i in range(1, e):
 11960	        # 比對去掉 [test:..] 後的行(子字串不誤命中既有測試名)
 11961	        if INVARIANT_RE.match(lines[i].strip()) and invariant_substr in TEST_REF_RE.sub("", lines[i]):
 11962	            if target_idx is not None:
 11963	                print(f"擋下:『{invariant_substr}』同時對到好幾條 KEY 行,分不清是哪條,請給更長、更精確的片段", file=sys.stderr)
 11964	                return 2
 11965	            target_idx = i
 11966	    if target_idx is None:
 11967	        print(f"擋下:{rel} 裡找不到內容含『{invariant_substr}』的合約 KEY 行", file=sys.stderr)
 11968	        return 2
 11969	    line = lines[target_idx]
 11970	    m = TEST_REF_RE.search(line)
 13920	    v = value.strip()
 13921	    if key in DATE_KEYS:
 13922	        if not DATE_RE.match(v):
 13923	            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
 13924	        return v  # bare,絕不加引號
 13925	    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
 13926	    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
 13927	    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)
