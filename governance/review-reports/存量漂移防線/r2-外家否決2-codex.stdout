 23822	def _notelines_content_id(path, region, heading, line, done=False):
 23823	    """內容編號=(NFC 路徑、區塊、所屬小標題、去頭尾空白的行文字)的短雜湊;完成審多一個標記,不綁任何提交
 23824	    (Projects/筆記內容審_計劃 〈做法〉第 2 節)。"""
 23825	    import hashlib
 23826	    raw = "\0".join([nfc(path), region, heading, line.strip()] + (["完成審"] if done else []))
 23827	    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]
