 29263	def _lens_full_sha(repo_root, rev):
 29264	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 29265	    if r is None or r.returncode != 0:
 29266	        return None
 29267	    sha = r.stdout.strip()
 29268	    return sha if _LENS_SHA_RE.match(sha) else None
 29269	
