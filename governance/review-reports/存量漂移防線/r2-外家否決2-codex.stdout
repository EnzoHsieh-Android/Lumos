 22609	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22610	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
 22611	    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
 22612	    lst = _nodehome_list(repo_root, where)
 22613	    if lst is None:
 22614	        return None
 22615	    s = _NodehomeSide()
 22616	    s.files, s.all_paths = lst
 22617	    s.where = where
 22618	    s._reader = _nodehome_reader(repo_root, where)
 22619	    s.shebang = {}
 22620	    s.share = share
 22621	    s.changed = set(changed or ())
 22622	    s.notes = {}
 22623	    pre = vault_rel + "/Systems/"
 22624	    for p in s.files:
 22625	        if p.startswith(pre) and p.endswith(".md"):
 22626	            rel = p[len(vault_rel) + 1:]
 22627	            if share is not None and p not in s.changed and rel in share.notes:
 22628	                s.notes[rel] = share.notes[rel]
 22629	                continue
 22630	            raw = s._reader(p)
 22631	            if raw is not None:
 22632	                s.notes[rel] = _nodehome_parse_note(raw)
 22633	    return s
