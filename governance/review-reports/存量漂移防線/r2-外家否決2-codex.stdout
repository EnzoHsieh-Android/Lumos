 23926	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
 23927	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 23928	    reader = _nodehome_reader(repo_root, tip_where)
 23929	    lst = _nodehome_list(repo_root, tip_where)
 23930	    if lst is None:
 23931	        return None
 23932	    files = lst[0]
 23933	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 23934	    _names, _name_cache = {}, {}
 23935	    for p in files:
 23936	        if _nodehome_code_kind(p) is not None:
 23937	            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23938	
 23939	    def by_name(name):
 23940	        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
 23941	        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
 23942	        if name not in _name_cache:
 23943	            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
 23944	        return _name_cache[name]
 23945	    viol = []
 23946	    # 1) 這次新增的行(跟筆記內容審共用同一支,Projects/筆記內容審_計劃 [S1])
 23947	    mk = mark or _NOTE_SHAPE_GOLIVE_MARK
 23948	    res = _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, reader=reader, mark=mk,
 23949	                         exclude_remote=exclude_remote, max_count=max_count)
 23950	    if res is None:
 23951	        return None
 23952	    notes, errs, old_by = res
 23953	    for p, text, rows in notes:
 23954	        regen = _ns_is_regen(text)
 23955	        for i, ln, reg in rows:
 23956	            for rule, frag, fix in _ns_check_line(repo_root, ln, reg, files, reader, top_dirs, by_name, regen):
 23957	                viol.append((p, i, rule, frag, fix))
 23958	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 23959	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 23960	                             tip_where, reader)
 23961	    if became:
 23962	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 23963	        if gl is not None:
 23964	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 23965	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 23966	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 23967	            spec = "" if tip_where == "index" else tip_where
 23968	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 23969	            gl_reader = _nodehome_reader(repo_root, gl)
 23970	            seen = {(v[0], v[1]) for v in viol}
 23971	            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
 23972	            for p, blob in zip(notes_, blobs):
 23973	                if blob is None:
 23974	                    continue
 23975	                text = blob.decode("utf-8-sig", errors="replace")
 23976	                if not any(x in text for x in keys):
 23977	                    continue
 23978	                old, regs_, regen_ = None, _notelines_regions(text), _ns_is_regen(text)
 23979	                for n, ln in enumerate(text.split("\n"), 1):
 23980	                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
 23981	                        continue
 23982	                    if old is None:
 23983	                        ob = gl_reader(p)
 23984	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 23985	                    if ln.strip() in old or ln.strip() in old_by.get(nfc(p), ()):
 23986	                        continue
 23987	                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
 23988	                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
 23989	                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
 23990	                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
 23991	                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
 23992	                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
 23993	                                                             for x in became):
 23994	                            continue
 23995	                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
 23996	                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
 23997	    return viol, errs
 23998	
