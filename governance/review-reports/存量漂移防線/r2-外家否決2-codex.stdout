 23807	def _notelines_structural_lines(text):
 23808	    """沒有主張、不審的行號集合(Projects/筆記內容審_計劃 [S4]):圍欄記號行(照 _visible_lines 認的)、表格分隔行、
 23809	    分隔線、只有清單記號的行。空白行本來就不收,不在這裡。"""
 23810	    lines = text.split("\n")
 23811	    kept = {i for i, _l in _visible_lines(lines, keep_fenced=True)}
 23812	    out = set()
 23813	    for i, ln in enumerate(lines, 1):
 23814	        if not ln.strip():
 23815	            continue
 23816	        if i not in kept or (_NOTELINES_TABLE_SEP_RE.match(ln) and "|" in ln) or _NOTELINES_RULE_RE.match(ln) \
 23817	                or _NOTELINES_BARE_LIST_RE.match(ln):
 23818	            out.add(i)
 23819	    return out
