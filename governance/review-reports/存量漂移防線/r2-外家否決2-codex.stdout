 13974	def _list_scalar_value(fm, key, line_idx):
 13975	    """清單欄位的單一值寫法(`key: 值`)讀出那一個值(去引號,空的回 "")。
 13976	
 13977	    ★看起來是同一行清單就丟 ValueError★:工具不解析同一行裡的逗號(fm_structure 與
 13978	    parse_frontmatter 都把它當成一個值),照單一值轉會把整串 "[a, b]" 寫成一項。
 13979	    判準看「去引號後的值本身」,不列舉寫法(2026-09-10 代碼審 r2:只比對原始字串時,
 13980	    整串加引號、逗號前後多打空白都繞得過):以 [ 或 { 開頭(單一連結 [[X]] 除外),
 13981	    或一個值裡有兩個以上連結開頭。加了引號的空清單 "[]" 跟讀的一側一樣當成空的。"""
 13982	    m = TOP_KEY_RE.match(fm[line_idx])
 13983	    val = m.group(2).strip() if m else ""
 13984	    sval = strip_quotes(val)
 13985	    t = sval.strip()   # 引號裡面前面多一個空白也要認得(第三輪外家否決席:" [a, b]" 繞過)
 13986	    if t == "[]":
 13987	        return ""
 13988	    # 單一連結要「整個值恰好是一個連結」才豁免(第三輪外家找洞席:[[Systems/A], Systems/B] 開頭像連結就被放行)
 13989	    if (t.startswith(("[", "{")) and not _SINGLE_WIKILINK_RE.fullmatch(t)) or _multi_link_value(t):
 13990	        raise ValueError(f"{key} 寫成同一行的清單({val}),工具不解析這種寫法,"
 13991	                         f"硬加會把整串當成一項寫壞,檔案沒動。這種寫法目前只能手動改成一行一項"
 13992	                         f"({key}: 換行後每項一行「  - 值」),改完再重跑")
 13993	    return t   # 去掉前後空白:引號裡只有空白就是空的(第四輪正確性席:原本會留下一筆空白垃圾項)
 13994	
 13995	
 13996	def _list_key_scalar_to_list(fm, key, line_idx):
 13997	    """清單欄位被寫成單一值(`about_code: src/x.py`)時,改寫成一項的清單再給 append/remove 用。
 13998	
 13999	    ★讀的一側本來就把單一值當成一項的清單★(as_list),只有寫的一側不認得——
 14000	    於是一篇筆記一旦是單一值寫法,append 說它不是清單、set 又不收清單欄位,
 14001	    沒有任何指令改得動(2026-09-10 代碼審 r1)。空值(`key:`)當成空清單;
 14002	    同一行的清單寫法擋下不轉(見 _list_scalar_value)。"""
 14003	    sval = _list_scalar_value(fm, key, line_idx)
 14004	    m = TOP_KEY_RE.match(fm[line_idx])
 14005	    raw = m.group(2).strip() if m else ""
 14006	    fm = list(fm)
 14007	    fm[line_idx] = f"{key}:"
 14008	    if sval:
 14009	        # ★原本那一項原封不動★:有引號就照原樣搬,不去掉再重新加(第三輪外家找洞席:'[[Systems/API "v2"]]'
 14010	        # 被重新加成帶反斜線的雙引號,讀的一側不解反斜線,讀回來就不是原本那篇了)
 14011	        quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
 14012	        fm.insert(line_idx + 1, f"  - {raw if quoted else fmt_list_item(sval)}")
 14013	    return fm
 14014	
 14015	
 14016	def edit_fm_append(fm_lines, key, value):
 14017	    fm = list(fm_lines)
 14018	    item = fmt_list_item(value)
 14019	    tgt = link_target(value)
 14020	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14021	    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
 14022	        cur = _list_scalar_value(fm, key, struct[key][0])
 14023	        if cur and link_target(cur) == tgt:
 14024	            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
 14025	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14026	        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14027	    if key in struct:
 14028	        s, e, kind = struct[key]
 14029	        if kind != "list":
 14030	            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
 14031	        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
 14032	        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
 14033	            fm[s] = f"{key}:"
 14034	        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
 14035	        for j in range(s + 1, e + 1):
 14036	            existing = fm[j].strip()
 14037	            if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14038	                return fm  # 已存在,no-op
 14039	        # 偵測現有項縮排,否則預設 2 空格
 14040	        indent = "  "
 14041	        for j in range(s + 1, e + 1):
 14042	            if fm[j].lstrip().startswith("-"):
 14043	                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
 14044	                break
 14045	        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
 14046	        last = e
 14047	        while last > s and not fm[last].strip():
 14048	            last -= 1
 14049	        fm.insert(last + 1, f"{indent}- {item}")
 14050	    else:
 14051	        ins = len(fm)
 14052	        fm.insert(ins, key + ":")
 14053	        fm.insert(ins + 1, f"  - {item}")
 14054	    return fm
 14055	
 14056	
 14057	def edit_fm_remove(fm_lines, key, value):
 14058	    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。
 14059	
 14060	    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
 14061	    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
 14062	    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
 14063	    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
 14064	    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
 14065	    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
 14066	    fm = list(fm_lines)
 14067	    tgt = link_target(value)
 14068	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14069	    if key not in struct:
 14070	        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
 14071	    if struct[key][2] == "scalar" and key in LIST_KEYS:
 14072	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14073	        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14074	    s, e, kind = struct[key]
 14075	    if kind != "list":
 14076	        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
 14077	    hits = []
 14078	    for j in range(s + 1, e + 1):
 14079	        existing = fm[j].strip()
 14080	        if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14081	            hits.append(j)
 14082	    if not hits:
 14083	        return fm, 0
 14084	    for j in reversed(hits):
 14085	        del fm[j]
 14086	    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
 14087	    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14088	    if key in struct2:
 14089	        s2, e2, _ = struct2[key]
 14090	        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
 14091	            del fm[s2:e2 + 1]
 14092	    return fm, len(hits)
 14093	
 14094	
 14095	def decisions_items(fm_lines):
 14096	    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
 14097	    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
 14098	    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
 14099	    block = None
 14100	    for k, s, e, kind in fm_structure(fm_lines):
 14101	        if k == "decisions" and kind == "list":
 14102	            block = (s, e)
 14103	            break
 14104	    if block is None:
 14105	        return None
 14106	    s, e = block
 14107	    item_indent = None
 14108	    starts = []
 14109	    for i in range(s + 1, e + 1):
 14110	        ln = fm_lines[i]
 14111	        if not ln.strip():
 14112	            continue
 14113	        m = re.match(r"^(\s*)-\s", ln)
 14114	        if m:
 14115	            ind = len(m.group(1))
 14116	            if item_indent is None:
 14117	                item_indent = ind
 14118	            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
 14119	                starts.append(i)
 14120	    items = []
 14121	    for idx, st in enumerate(starts):
 14122	        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
 14123	        while en > st and not fm_lines[en].strip():
 14124	            en -= 1
 14125	        items.append((st, en))
 14126	    sub_indent = (item_indent + 2) if item_indent is not None else 4
 14127	    return s, e, items, (item_indent or 2), sub_indent
 14128	
