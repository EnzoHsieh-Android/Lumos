 24330	def _note_audit_parse_verdict(raw):
 24331	    """判定檔內容 → dict 或 None(壞掉)。"""
 24332	    import json as _j
 24333	    try:
 24334	        d = _j.loads(raw.decode("utf-8") if isinstance(raw, bytes) else raw)
 24335	    except (ValueError, UnicodeDecodeError):
 24336	        return None
 24337	    if not isinstance(d, dict) or d.get("kind") not in ("判定", "申訴", "略過") or not isinstance(d.get("rows"), list):
 24338	        return None
 24339	    for r in d["rows"]:
 24340	        if not isinstance(r, dict) or not isinstance(r.get("id"), str) or r.get("class") not in ("CODE", "MIXED", "CONTEXT", "SKIP"):
 24341	            return None
 24342	    return d
 24343	
