 29284	    disp = rec.get("dispositions") or {}
 29285	    human = [(q, e) for q, e in disp.items() if isinstance(e, dict) and not e.get("auto")]
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
