 11855	def cmd_guard_abandon(env, ref, why):
 11856	    """棄置:留墓碑而不是刪掉。要有對得上的簽核紀錄——作用是留痕不是防偽造。"""
 11857	    if not (why or "").strip():
 11858	        print("擋下:棄置要寫 --why 說明為什麼決定不做了", file=sys.stderr)
 11859	        return 2
 11860	    rel, n = _guard_find(env, ref)
 11861	    if rel is None:
 11862	        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
 11863	        return 2
 11864	    refs = _guard_signoff_refs(env)
 11865	    stem = rel[:-3] if rel.endswith(".md") else rel
 11866	    if rel not in refs and stem not in refs:
 11867	        print(f"擋下:棄置一條預告的合約要有人簽核,帳上找不到對得上 {stem} 的紀錄", file=sys.stderr)
 11868	        print(f"  先簽核再來:lumos signoff {stem} --ref {stem} --note \"<為什麼決定不做>\"", file=sys.stderr)
 11869	        return 2
 11870	    home = _guard_home_of(n)
 11871	    home_rel = env.find(home)
 11872	    body = (env.vault / rel).read_text(encoding="utf-8")
 11873	    m = re.search(r"^預告的合約:(.+)$", body, re.M)
 11874	    claim = m.group(1).strip() if m else ""
 11875	    if not home_rel:
 11876	        print(f"擋下:守衛節點指名的功能節點 {home} 找不到——棄置前先把 guards 欄位指對,"
 11877	              "不然那篇的預告行會永遠留著,跟墓碑互相矛盾", file=sys.stderr)
 11878	        return 2
 11879	    if not claim:
 11880	        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條(被手改過?)", file=sys.stderr)
 11881	        return 2
 11882	    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
 11883	    if lines is None:
 11884	        # ★找不到就擋,不靜默略過★(代碼審 r1 blocker):guards 被改指到別篇時,
 11885	        # 原本會靜默成功,真正的家節點永久留著一條沒人管的預告行。
 11886	        print(f"擋下:{_err}", file=sys.stderr)
 11887	        print("  棄置會把功能節點那行預告拿掉;對不到那一行就不知道該拿掉哪一條,不能硬做", file=sys.stderr)
 11888	        return 2
 11889	    try:
 11890	        atomic_write_verify(env.vault / home_rel, lines[:idx] + lines[idx + 1:],
 11891	                            "", lambda f: claim not in str(f.get("summary") or ""))
 11892	    except (ValueError, RuntimeError) as ex:
 11893	        print(f"擋下:功能節點的預告行拿不掉,墓碑也不立(不留半套): {ex}", file=sys.stderr)
 11894	        return 2
 11895	    rc = cmd_set(env, rel, "status", "abandoned")
 11896	    print(f"✓ 已棄置:{rel} 立成墓碑(不是刪掉,下一個人看得到曾經打算做什麼、為什麼不做了)")
 11897	    return rc
