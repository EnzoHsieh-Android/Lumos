 22982	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 22983	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 22984	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 22985	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 22986	    None=整批當成一個提交(提交前)。"""
 22987	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 22988	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 22989	    homesN, ownN = _nodehome_homes(repo_root, N)
 22990	    homesB, ownB = _nodehome_homes(repo_root, B)
 22991	    blocks, reminders, pairs = [], [], []
 22992	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 22993	    for code, old, new in changes:
 22994	        if old is not None and (new is None or code == "R"):
 22995	            deleted.add(old)
 22996	        if new is None:
 22997	            continue
 22998	        changed_new.add(new)
 22999	        if code in ("A", "R", "C"):
 23000	            added.add(new)
 23001	        if code == "R" and old:
 23002	            renamed_from[new] = old
 23003	    code_changed = {p for p in changed_new if p in reqN}
 23004	    code_added = {p for p in added if p in reqN}
 23005	    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
 23006	    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
 23007	    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
 23008	    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
 23009	    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
 23010	    code_touched = code_changed | code_deleted
 23011	    vpre = vault_rel + "/"
 23012	    refs_cache = {}
 23013	
 23014	    def refs_now(rel):
 23015	        if rel not in refs_cache:
 23016	            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
 23017	        return refs_cache[rel]
 23018	
 23019	    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]
 23020	    edited = set()
 23021	    for p in sorted(changed_new):
 23022	        if not (p.startswith(vpre + "Systems/") and p.endswith(".md")):
 23023	            continue
 23024	        rel = p[len(vpre):]
 23025	        if rel not in N.notes:
 23026	            continue
 23027	        n = N.notes[rel]
 23028	        src = renamed_from.get(p)
 23029	        src_rel = src[len(vpre):] if src and src.startswith(vpre) else rel
 23030	        b = B.notes.get(src_rel)
 23760	            ind = len(ln) - len(ln.lstrip(" "))
 23761	            is_key = m and (k == st or ind == sub_indent)
 23762	            if is_key:
 23763	                cur = m.group(2)
 23764	                val = ln.split(":", 1)[1].strip()
 23765	                if cur == "id":
 23766	                    mm = re.match(r"^(d\d+)$", val)
 23767	                    if mm:
 23768	                        did = mm.group(1)
 23769	                elif cur == "valid":
 23770	                    valid = val.strip("\"'").lower() != "false"
 23771	            fields.append((k, cur))
 23772	        for k, f in fields:
 23773	            out[k + 2] = (did, f or "", valid)       # fm[0] 是全文第 2 行
 23774	    return out
