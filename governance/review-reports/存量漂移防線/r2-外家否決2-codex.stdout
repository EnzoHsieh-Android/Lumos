 24000	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 24001	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 24002	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 24003	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 24004	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 24005	    out = []
 24006	    root = Path(repo_root)
 24007	    cp = root / ".lumos" / "config.json"
 24008	    txt = None
 24009	    try:
 24010	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 24011	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 24012	            txt = cp.read_bytes()
 24013	    except OSError:
 24014	        txt = None
 24015	    mode, _w = _note_shape_config(txt)
 24016	    if mode != "block":
 24017	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 24018	                   "沒寫來源的現況描述不會被擋")
 24019	    wf = root / ".github" / "workflows"
 24020	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 24021	    if ymls:
 24022	        # 跳過註解:整行被註解掉的那步不算有呼叫(第二層早就這樣判;代碼審 r3 通才席:兩句判法不一,中間漏唸)
 24023	        body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
 24024	        step = ("\n    - run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 24025	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
 24170	        return 1
 24171	    # warn 模式有違規也記一筆(照鄰居的 warned;沒違規的放行才不寫——代碼審 r1 架構對齊席)
 24172	    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
 24173	                        nodes=sorted({v[0] for v in viol})[:50])
 24174	    return 0
