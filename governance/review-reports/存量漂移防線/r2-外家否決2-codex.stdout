 24345	def _note_audit_load_verdicts(repo_root, where):
 24346	    """讀判定檔 → ({檔名: dict}, [壞掉的檔名])。where=None 讀工作目錄;給提交就讀那個提交的樹(check 只認這個)。
 24347	    只有檔名合格式的才算(`_write_lf` 中斷留下的暫存檔不算)。"""
 24348	    root = Path(repo_root)
 24349	    docs, bad = {}, []
 24350	    if where is None:
 24351	        d = root / _NOTE_AUDIT_VERDICT_DIR
 24352	        if not d.is_dir():
 24353	            return docs, bad
 24354	        for f in sorted(d.iterdir()):
 24355	            if not _NOTE_AUDIT_VERDICT_NAME_RE.match(f.name) or not f.is_file() or f.is_symlink():
 24356	                continue
 24357	            v = _note_audit_parse_verdict(f.read_bytes())
 24358	            (docs.__setitem__(f.name, v) if v is not None else bad.append(f.name))
 24359	        return docs, bad
 24360	    ls = _nodehome_git(repo_root, "ls-tree", "-z", "--name-only", f"{where}:{_NOTE_AUDIT_VERDICT_DIR}")
 24361	    if ls is None:
 24362	        return docs, bad
 24363	    names = [n for n in _nodehome_split_z(ls) if _NOTE_AUDIT_VERDICT_NAME_RE.match(n)]
 24364	    blobs = _nodehome_cat_blobs(repo_root, [f"{where}:{_NOTE_AUDIT_VERDICT_DIR}/{n}" for n in names]) if names else []
 24365	    for n, b in zip(names, blobs or []):

