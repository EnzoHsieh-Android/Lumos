 29256	        if binary:
 29257	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 29258	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 29259	    except (OSError, _sp.TimeoutExpired):
 29260	        return None
 29261	
 29262	
 29263	def _lens_full_sha(repo_root, rev):
 29264	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 29265	    if r is None or r.returncode != 0:
 29266	        return None
 29267	    sha = r.stdout.strip()
 29268	    return sha if _LENS_SHA_RE.match(sha) else None
 29269	
 29270	
 29271	def _mainline_ref(repo_root, remote_only=False):
 29272	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 29273	    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
 29274	    拿它當「已在主線上」會把整批都排除掉)。"""
 29275	    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
 29276	        sha = _lens_full_sha(repo_root, cand)
 29277	        if sha:
 29278	            return cand, sha

