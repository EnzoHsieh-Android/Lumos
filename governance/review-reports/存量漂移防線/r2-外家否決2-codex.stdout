 14130	def load_raw_for_edit(path: Path):
 14131	    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
 14132	    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
 14133	    raw = path.read_bytes()
 14134	    if raw.startswith(b"\xef\xbb\xbf"):
 14135	        raise ValueError("這個檔開頭帶 BOM 標記,工具不寫這種檔;先把檔案存成不帶 BOM 的 UTF-8")
 14136	    if b"\r\n" in raw:
 14137	        raise ValueError("這個檔的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)。Windows 上常是 git autocrlf 造成的;"
 14138	                         "修法:確認 .gitattributes 有套用(圖譜目錄標 eol=lf)再跑 git add --renormalize .,"
 14139	                         "或單檔跑 dos2unix。工具不會偷偷幫你改行尾。")
 14140	    lines = raw.decode("utf-8").split("\n")
 14141	    if not lines or lines[0].strip() != "---":
 14142	        raise ValueError("這篇筆記開頭沒有欄位區塊(---),沒辦法改欄位")
 14143	    fm_end = None
 14144	    for i in range(1, len(lines)):
 14145	        if lines[i].strip() == "---":
 14146	            fm_end = i
 14147	            break
 14148	    if fm_end is None:
 14149	        raise ValueError("開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),先補上")
 14150	    return lines, 1, fm_end
 14151	
 14152	
 14153	def _write_lf(path: Path, text: str):
 14154	    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
 14155	    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.9。
 14156	    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
 14157	    整檔覆寫消費者)。read-modify-write 的併發:set/append/remove 由呼叫端上鎖(_vault_write_lock),
 14158	    其他寫入指令仍是 last-write-wins(單機 CLI,accepted)。
 14159	    ★暫存檔名每次都不一樣★(2026-09-10 代碼審 r3 併發資源席:原本同一篇筆記大家用同一個固定暫存檔名,
 14160	    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
 14161	    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
 14162	    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
 14163	    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
 14164	    import os as _os, shutil as _sh, uuid as _uuid
 14165	    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
 14166	    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
 14167	    try:
 14168	        with _os.fdopen(fd, "wb") as fh:
 14169	            fh.write(text.encode("utf-8"))
 14170	        if path.exists():
 14171	            _sh.copymode(path, tmp)
 14172	        _os.replace(tmp, path)
 14173	    except BaseException:
 14174	        try:
 14175	            _os.unlink(tmp)
 14176	        except OSError:
 14177	            pass
 14178	        raise
 14179	
 14180	
 14181	def atomic_write_verify(path: Path, new_lines, key, expected_check):
 14182	    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
 14183	    orig_fm = load_raw_for_edit(path)
 14184	    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
 14185	    text = "\n".join(new_lines)
 14186	    new_fm_lines = new_lines[1:]
 14187	    for i in range(1, len(new_lines)):
 14188	        if new_lines[i].strip() == "---":
 14189	            new_fm_lines = new_lines[1:i]
 14190	            break
 14191	    fields, _, new_lint = parse_frontmatter(new_fm_lines)
 14192	    if not expected_check(fields):
 14193	        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
 14194	    introduced = set(new_lint) - orig_lint
 14195	    if introduced:
 14196	        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
 14197	    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)
 14198	
 14199	
 14200	_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
 14201	_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己
 14202	
 14203	
 14204	_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)
 14205	
 14206	
 14207	def _vault_lock_where(vault):
 14208	    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。
 14209	
 14210	    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
 14211	    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
 14212	    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。
 14213	
 14214	    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
 14215	    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
 14216	    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
 14217	    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
 14218	    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
 14219	    互斥照樣成立。
 14220	
 14221	    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
 14222	    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
 14223	    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
 14224	    """
 14225	    import hashlib
 14226	    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
 14227	    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
 14228	    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
 14229	    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
 14230	    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
 14231	        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
 14232	    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
 14233	        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
 14234	    return primary, None
 14235	
 14236	
 14237	def _vault_lock_say(lock, why):
 14238	    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
 14239	    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
 14240	    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
 14241	    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
 14242	    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
 14243	          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
 14244	    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
 14245	          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
 14246	          file=sys.stderr)
 14247	    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
 14248	    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)
 14249	
 14250	
 14251	def _vault_write_lock(vault):
 14252	    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
 14253	    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。
 14254	
 14255	    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
 14256	    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
 14257	    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
 14258	    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
 14259	    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
 14260	    import contextlib, time as _t
 14261	
 14262	    @contextlib.contextmanager
 14263	    def _cm():
 14264	        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
 14265	        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
 14266	        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
 14267	        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
 14268	        lock, why = _vault_lock_where(vault)
 14269	        k = str(lock)
 14270	
 14271	        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
 14272	            _VAULT_LOCK_HELD[k] += 1
 14273	            try:
 14274	                yield
 14275	            finally:
 14276	                _VAULT_LOCK_HELD[k] -= 1
 14277	            return
 14278	
 14279	        if why and not _VAULT_LOCK_WARNED.get(k):
 14280	            _VAULT_LOCK_WARNED[k] = True
 14281	            _vault_lock_say(lock, why)
 14282	        deadline = _t.monotonic() + 60
 14283	        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
 14284	            if _t.monotonic() > deadline:
 14285	                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
 14286	            _t.sleep(0.05)
 14287	        _VAULT_LOCK_HELD[k] = 1
 14288	        try:
 14289	            yield
 14290	        finally:
 14291	            _VAULT_LOCK_HELD.pop(k, None)
 14292	            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
 14293	                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
 14294	                    lock.unlink()
 14295	            except OSError:
 14296	                pass
 14297	    return _cm()
