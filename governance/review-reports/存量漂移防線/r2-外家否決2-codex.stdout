 24177	# ── 筆記內容審(第二層,Projects/筆記內容審_計劃):推送前派判定者逐行判新寫的筆記是不是程式碼推得出來 ──
 24178	# 家:Systems/筆記內容審。只防疏忽、不防存心繞過(計劃〈做法〉第 0 節)。
 24179	_NOTE_AUDIT_GOLIVE_MARK = "note-audit check"          # 推送前掛鉤裡有這串=第二層上線了(範圍截斷用)
 24180	_NOTE_AUDIT_GATE_VALUES = ("block", "warn", "off")
 24181	_NOTE_AUDIT_VERDICT_DIR = "governance/note-verdicts"
 24182	_NOTE_AUDIT_WORK_DIR = ".lumos/note-audit"
 24183	_NOTE_AUDIT_TEMPLATE = "scripts/templates/note-audit-judge.md"
 24184	_NOTE_AUDIT_PROMPT_VERSION = 1                          # 範本檔改一個字就升版,並重跑 68 句小實驗(計劃 S14)
 24185	_NOTE_AUDIT_BATCH = 150
 24186	_NOTE_AUDIT_SEARCH_CAP = 20000
 24187	_NOTE_AUDIT_VERDICT_NAME_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{32}\.json$")
 24188	_NOTE_AUDIT_WEIGHT = {"CONTEXT": 0, "MIXED": 1, "CODE": 2}
 24189	_NOTE_AUDIT_CLASS_ALIASES = {"CODE": "CODE", "推得出": "CODE", "MIXED": "MIXED", "一半一半": "MIXED",
 24190	                             "CONTEXT": "CONTEXT", "脈絡": "CONTEXT"}
 24191	_NOTE_AUDIT_CLOSED = ("done", "superseded")
 24192	
