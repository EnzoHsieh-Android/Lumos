 11833	def _guard_signoff_refs(env):
 11834	    """簽核帳裡帶 --ref 的那些參照。"""
 11835	    import json as _j
 11836	    log = env.vault.parent / ".signoff-log.jsonl"
 11837	    refs = set()
 11838	    try:
 11839	        for ln in log.read_text(encoding="utf-8").splitlines():
 11840	            if not ln.strip():
 11841	                continue
 11842	            try:
 11843	                d = _j.loads(ln)
 11844	            except ValueError:
 11845	                continue
 11846	            r = str(d.get("ref") or "").strip()
 11847	            if r:
 11848	                refs.add(r)
 11849	                refs.add(r[:-3] if r.endswith(".md") else r)
 11850	    except OSError:
 11851	        pass
 11852	    return refs
