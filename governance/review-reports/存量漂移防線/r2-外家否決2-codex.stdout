 24219	def _note_audit_status_of(blob):
 24220	    """筆記內容(bytes)→ (type, status)。讀不到回 (None, None)。"""
 24221	    if blob is None:
 24222	        return None, None
 24223	    try:
 24224	        fm, _b = split_frontmatter(blob.decode("utf-8-sig"))
 24225	    except UnicodeDecodeError:
 24226	        return None, None
 24227	    if not fm:
 24228	        return None, None
 24229	    fields = parse_frontmatter(fm)[0]
 24230	    return str(fields.get("type", "")).strip() or None, str(fields.get("status", "")).strip() or None
