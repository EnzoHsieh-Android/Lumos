 23777	def _notelines_headings(text, regs):
 23778	    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
 23779	    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
 23780	    lines = text.split("\n")
 23781	    vis = {i for i, _l in _visible_lines(lines)}
 23782	    dfields = _notelines_decision_fields(text)
 23783	    out, cur = [], ""
 23784	    for i, ln in enumerate(lines, 1):
 23785	        reg = regs[i - 1]
 23786	        if reg == "body" and i in vis:
 23787	            m = _NOTELINES_HEADING_RE.match(ln)
 23788	            if m:
 23789	                cur = m.group(1).strip()
 23790	        if reg == "summary":
 23791	            out.append("summary")
 23792	        elif reg == "decisions":
 23793	            did, f, _v = dfields.get(i, ("", "", True))
 23794	            out.append(f"decisions/{did}/{f}")
 23795	        elif reg == "body":
 23796	            out.append(cur)
 23797	        else:
 23798	            out.append("")
 23799	    return out
