 11827	    rc = cmd_set(env, rel, "status", "pass")
 11828	    print(f"✓ 轉正:{home_rel} 的預告行已換成正式合約並綁上 [test:{method}];{rel} 轉為已通過")
 11829	    print("  下一步:lumos guard audit 補獨立審計,推送前的閘會查")
 11830	    return rc
 11831	
