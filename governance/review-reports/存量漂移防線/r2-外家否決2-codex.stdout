 22202	def _lint_watch_mode(repo_root, as_json):
 22203	    """lumos lint-watch: 讀 .lumos/lint-watch.json、逐條查 registry、輸出 manifest。
 22204	    rc 0 = 成功(含空清單); rc 2 = config 格式錯誤。
 22205	    """
 22206	    import json
 22207	    cfg_path = Path(repo_root) / ".lumos" / "lint-watch.json"
 22208	    if not cfg_path.exists():
 22209	        entries = []
 22210	    else:
 22211	        try:
 22212	            with open(cfg_path, encoding="utf-8") as fh:
 22213	                entries = json.load(fh)
 22214	        except Exception as e:
 22215	            print(f"擋下:lint-watch.json 讀不了(JSON 格式壞了?): {e}", file=sys.stderr)
 22216	            return 2
 22217	        if not isinstance(entries, list):
 22218	            print("擋下:lint-watch.json 最外層要是陣列", file=sys.stderr)
 22219	            return 2
 22220	        for entry in entries:
 22221	            if not isinstance(entry, dict) or not all(k in entry for k in ("name", "registry", "current")):
 22222	                print("擋下:lint-watch.json 裡每一條都要有 name、registry、current 三個欄位", file=sys.stderr)
 22223	                return 2
 22224	
 22225	    candidates, failed, checked = [], [], 0
 22226	    for entry in entries:
 22227	        latest, reason = _registry_latest(entry["registry"])
 22228	        if latest is None:
 22229	            failed.append({"name": entry["name"], "reason": reason})
 22230	        else:
 22231	            state, r = _compare_versions(entry["current"], latest)
 22232	            if state == "behind":
 22233	                candidates.append({
 22234	                    "name": entry["name"],
 22235	                    "registry": entry["registry"],
 22236	                    "current": entry["current"],
 22237	                    "latest": latest,
 22238	                })
 22239	                checked += 1
 22240	            elif state == "current":
 22241	                checked += 1
 22242	            else:  # skip
 22243	                failed.append({"name": entry["name"], "reason": r})
 22244	
 22245	    if as_json:
 22246	        print(json.dumps({"candidates": candidates, "checked": checked, "failed": failed},
 22247	                         ensure_ascii=False))
 22248	    else:
 22249	        for c in candidates:
 22250	            print(f"{c['name']} {c['current']} → {c['latest']}")
 22251	    return 0
