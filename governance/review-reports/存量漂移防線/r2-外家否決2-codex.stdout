 11792	def cmd_guard_settle(env, ref, method):
 11793	    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過。"""
 11794	    if not IDENT_RE.match(method or ""):
 11795	        print(f"擋下:測試方法名『{method}』不合法(只能字母/數字/底線,不能數字開頭)", file=sys.stderr)
 11796	        return 2
 11797	    rel, n = _guard_find(env, ref)
 11798	    if rel is None:
 11799	        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
 11800	        return 2
 11801	    if str(n.fields.get("status")) != "pending":
 11802	        print(f"擋下:{rel} 現在是 {n.fields.get('status')},只有待完成的才能轉正", file=sys.stderr)
 11803	        return 2
 11804	    home = _guard_home_of(n)
 11805	    home_rel = env.find(home)
 11806	    if home_rel is None:
 11807	        print(f"擋下:守衛節點指名的功能節點 {home} 找不到", file=sys.stderr)
 11808	        return 2
 11809	    body = (env.vault / rel).read_text(encoding="utf-8")
 11810	    m = re.search(r"^預告的合約:(.+)$", body, re.M)
 11811	    claim = m.group(1).strip() if m else ""
 11812	    if not claim:
 11813	        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條", file=sys.stderr)
 11814	        return 2
 11815	    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
 11816	    if lines is None:
 11817	        print(f"擋下:{_err}", file=sys.stderr)
 11818	        return 2
 11819	    newline = f"  KEY:★INVARIANT★ {claim} [test:{method}]"
 11820	    try:
 11821	        atomic_write_verify(env.vault / home_rel, [*lines[:idx], newline, *lines[idx + 1:]],
 11822	                            f"[test:{method}]",
 11823	                            lambda f: f"[test:{method}]" in str(f.get("summary") or ""))
 11824	    except (ValueError, RuntimeError) as ex:
 11825	        print(f"擋下:合約行換不過去,什麼都沒動: {ex}", file=sys.stderr)
 11826	        return 2
 11827	    rc = cmd_set(env, rel, "status", "pass")
 11828	    print(f"✓ 轉正:{home_rel} 的預告行已換成正式合約並綁上 [test:{method}];{rel} 轉為已通過")
 11829	    print("  下一步:lumos guard audit 補獨立審計,推送前的閘會查")
 11830	    return rc
