 24282	def _note_audit_items(repo_root, base_where, tip_where, vault_rel):
 24283	    """這次要審的每一行 → (items, errs) 或 None。item={id, path, line, text, region, heading, done, context, ctx_fp}。
 24284	    一般新寫的行借第一層的共用函式(推送前掛鉤的標記、不逐提交判);被收尾的計劃整篇進完成審(已翻案的決策不進)。"""
 24285	    import hashlib
 24286	    reader = _nodehome_reader(repo_root, tip_where)
 24287	    res = _notelines_new(repo_root, False, base_where, tip_where, vault_rel, reader=reader,
 24288	                         mark=_NOTE_AUDIT_GOLIVE_MARK, hook=_NOTELINES_PREPUSH, per_commit=False)
 24289	    if res is None:
 24290	        return None
 24291	    notes, errs, _old = res
 24292	    closed = _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader)
 24293	    if closed is None:
 24294	        return None
 24295	    rows_by = {p: (text, {i for i, _l, _r in rows}) for p, text, rows in notes}
 24296	    for p in closed:
 24297	        if p in rows_by:
 24298	            continue
 24299	        b = reader(p)
 24300	        try:
 24301	            rows_by[p] = (b.decode("utf-8-sig"), set())
 24302	        except (UnicodeDecodeError, AttributeError):
 24303	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 24304	    items = []
 24305	    for p, (text, new_lines) in sorted(rows_by.items()):
 24306	        lines = text.split("\n")
 24307	        regs = _notelines_regions(text)
 24308	        heads = _notelines_headings(text, regs)
 24309	        struct = _notelines_structural_lines(text)
 24310	        dfields = _notelines_decision_fields(text) if p in closed else {}
 24311	        for i, ln in enumerate(lines, 1):
 24312	            reg = regs[i - 1]
 24313	            if not ln.strip() or reg == "other" or i in struct:
 24314	                continue
 24315	            done = p in closed
 24316	            if done and reg == "decisions" and not dfields.get(i, ("", "", True))[2]:
 24317	                if i not in new_lines:
 24318	                    continue
 24319	                done = False                        # 已翻案的決策只排除在完成審外,新寫的行照一般規則判
 24320	            if not done and i not in new_lines:
 24321	                continue
 24322	            ctx = lines[max(0, i - 3):i - 1] + lines[i:i + 2]
 24323	            items.append({"id": _notelines_content_id(p, reg, heads[i - 1], ln, done=done), "path": p, "line": i,
 24324	                          "text": ln, "region": reg, "heading": heads[i - 1], "done": done,
 24325	                          "context": (lines[max(0, i - 3):i - 1], lines[i:i + 2]),
 24326	                          "ctx_fp": hashlib.sha256("\n".join(ctx).encode("utf-8")).hexdigest()[:16]})
 24327	    return items, errs
 24328	
