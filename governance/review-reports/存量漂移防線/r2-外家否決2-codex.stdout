 13936	def edit_fm_scalar(fm_lines, key, value):
 13937	    fm = list(fm_lines)
 13938	    formatted = fmt_scalar(key, value)
 13939	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 13940	    if key in struct:
 13941	        s, e, kind = struct[key]
 13942	        if kind != "scalar":
 13943	            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
 13944	        fm[s] = f"{key}: {formatted}"
 13945	    else:
 13946	        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
 13947	        ins = len(fm)
 13948	        for k, s, e, kind in fm_structure(fm):
 13949	            if kind in ("list", "block"):
 13950	                ins = s
 13951	                break
 13952	        fm.insert(ins, f"{key}: {formatted}")
 13953	    return fm
