 22967	def _nodehome_clamp_base(repo_root, base, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
 22968	    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
 22969	    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。mark 見 _nodehome_golive。"""
 22970	    gl = _nodehome_golive(repo_root, tip, mark, hook)
 22971	    if gl is None:
 22972	        return base
 22973	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
 22974	    if r is None or r.returncode != 0:
 22975	        return base                                    # 上線點不在這條歷史上
 22976	    if base in (None, _EMPTY_TREE_SHA):
 22977	        return gl
 22978	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
 22979	    return gl if (r is not None and r.returncode == 0 and base != gl) else base
