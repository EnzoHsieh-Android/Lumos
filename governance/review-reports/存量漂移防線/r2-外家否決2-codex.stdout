 22956	def _nodehome_golive(repo_root, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
 22957	    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。
 22958	    mark=要找的標記字串,預設是每支檔有家自己的;筆記形狀擋傳它自己的(Projects/筆記形狀擋_計劃 [S4])。"""
 22959	    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{mark or _NODEHOME_GOLIVE_MARK}",
 22960	                        tip or "HEAD", "--", hook)
 22961	    if not raw:
 22962	        return None
 22963	    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
 22964	    return first if _LENS_SHA_RE.match(first) else None
 22965	
