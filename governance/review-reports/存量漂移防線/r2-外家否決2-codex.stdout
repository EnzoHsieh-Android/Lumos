 24233	def _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader):
 24234	    """範圍裡被收尾的計劃(計劃〈做法〉第 1 節):`type: project`、終點 status 是 done/superseded,而且範圍裡有某個提交
 24235	    把它從非收尾改成收尾——逐提交讀那篇的 status(改名跟著走;起點沒有這篇時第一個提交就算)。回 [路徑]。"""
 24236	    # 候選=範圍裡任一個提交碰過的筆記,不是頭尾淨差異:收尾→改回→再收尾時頭尾一模一樣,淨差異看不到(S3)
 24237	    rng0 = f"{base_where}..{tip_where}" if base_where else tip_where
 24238	    touched = _ns_git(repo_root, "log", "--format=", "--name-only", "-z", "-M", rng0, "--", vault_rel)
 24239	    if touched is None:
 24240	        return None
 24241	    out = []
 24242	    for p in sorted({x.strip("\n") for x in touched.decode("utf-8", errors="surrogateescape").split("\0")
 24243	                     if x.strip("\n").endswith(".md")}):
 24244	        ty, st = _note_audit_status_of(reader(p))
 24245	        if ty != "project" or st not in _NOTE_AUDIT_CLOSED:
 24246	            continue
 24247	        rng = f"{base_where}..{tip_where}" if base_where else tip_where
 24248	        lg = _ns_git(repo_root, "log", "--follow", "--format=%H", "--name-only", "-z", rng, "--", p)
 24249	        if lg is None:
 24250	            return None
 24251	        # git log -z --format=%H --name-only:「sha\0\n路徑\0」一筆接一筆(實測;換行黏在路徑前面);逐筆取 (sha, 那時的路徑)
 24252	        pairs, cur = [], None
 24253	        for tok in lg.decode("utf-8", errors="surrogateescape").split("\0"):
 24254	            tok = tok.strip("\n")
 24255	            if not tok:
 24256	                continue
 24257	            if cur is None and _LENS_SHA_RE.fullmatch(tok):
 24258	                cur = tok
 24259	            elif cur is not None:
 24260	                pairs.append((cur, tok))
 24261	                cur = None
 24262	        specs = [f"{s}:{q}" for s, q in pairs]
 24263	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 24264	        states = [_note_audit_status_of(b)[1] for b in (blobs or [])]
 24265	        old = pairs[-1][1] if pairs else p
 24266	        base_state = None
 24267	        if base_where:
 24268	            if pairs:
 24269	                # 最舊那個碰到它的提交若是改名,git log 給的是新路徑;起點那時的路徑要對起點做改名偵測(代碼審 r1 正確性席:
 24270	                # 已收尾的計劃只改名,原本讀不到起點狀態、被當成這次收尾)
 24271	                rn = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", base_where, pairs[-1][0], "--", vault_rel)
 24272	                if rn is not None:
 24273	                    old = _nodehome_name_status(rn, norm=False)[1].get(old, old)
 24274	            bb = _nodehome_cat_blobs(repo_root, [f"{base_where}:{old}"])
 24275	            base_state = _note_audit_status_of(bb[0] if bb else None)[1]
 24276	        seq = [base_state, *states[::-1]]          # 由舊到新
 24277	        if any((a not in _NOTE_AUDIT_CLOSED) and (b in _NOTE_AUDIT_CLOSED) for a, b in zip(seq, seq[1:])):
 24278	            out.append(p)
 24279	    return out
