  4966	                        "(同義詞要歸一:resolved/done 擇一、verification 用 pass)")
  4967	        for tg in (n.fields.get("tags") or []):
  4968	            if not isinstance(tg, str):
  4969	                continue
  4970	            if tg.startswith("priority/") and tg.split("/", 1)[1] not in _PRIORITY_ENUM:
