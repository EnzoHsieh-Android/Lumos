 22402	def _nodehome_layout(all_paths):
 22403	    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
 22404	    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
 22405	    tops = _nodehome_top_dirs(all_paths)
 22406	    top_exts, main_exts = {}, {}
 22407	    for p in all_paths:
 22408	        e = _testmap_ext(p)
 22409	        if not e:
 22410	            continue
 22411	        parts = p.split("/")
 22412	        if len(parts) > 1 and parts[0] in tops:
 22413	            top_exts.setdefault(parts[0], set()).add("." + e)
 22414	        for k in range(len(parts) - 2):
 22415	            if parts[k] == "src" and parts[k + 1] == "main":
 22416	                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
 22417	                break
 22418	    return top_exts, main_exts
