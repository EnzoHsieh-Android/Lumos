 24194	def _note_audit_judge_model(orchestrator):
 24195	    """判定者跟編排者同一家,模型寫死(計劃〈做法〉第 3 節第 2 點):claude → opus;codex → 既有 Codex 審查席常數。"""
 24196	    return {"claude": "opus", "codex": _CODEX_SEAT_MODEL}.get(orchestrator)
