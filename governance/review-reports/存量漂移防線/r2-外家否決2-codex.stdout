 22551	def _nodehome_reader(repo_root, where):
 22552	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 22553	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 22554	    if where is None:
 22555	        return lambda p: None
 22556	    disk_ok_all = False
 22557	    differ = None
 22558	    if where == "index":
 22559	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 22560	    else:
 22561	        head = _lens_full_sha(repo_root, "HEAD")
 22562	        if head and head == where:
 22563	            differ = _nodehome_changed_vs_disk(repo_root, where)
 22564	    root = Path(repo_root)
 22565	    spec = "" if where == "index" else where
 22566	
 22567	    def read(p):
 22568	        if differ is not None and p not in differ:
 22569	            fp = root / p
 22570	            try:
 22571	                if fp.is_file() and not fp.is_symlink():
 22572	                    return fp.read_bytes()
 22573	            except OSError:
 22574	                pass
 22575	        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
 22576	        if r is None or r.returncode != 0:
 22577	            return None
 22578	        return r.stdout
 22579	    return read
