 29205	def _lens_range_ok(diff_range):
 29206	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 29207	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 29208	        return None
 29209	    parts = diff_range.split("..")
 29210	    if len(parts) != 2 or not parts[0] or not parts[1]:
 29211	        return None
 29212	    if any(ch.isspace() for ch in diff_range):
 29213	        return None
 29214	    return parts[0], parts[1]
