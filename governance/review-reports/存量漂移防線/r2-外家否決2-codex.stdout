 11855	def cmd_guard_abandon(env, ref, why):
 11856	    """棄置:留墓碑而不是刪掉。要有對得上的簽核紀錄——作用是留痕不是防偽造。"""
 11857	    if not (why or "").strip():
 11858	        print("擋下:棄置要寫 --why 說明為什麼決定不做了", file=sys.stderr)
 11859	        return 2
 11860	    rel, n = _guard_find(env, ref)
