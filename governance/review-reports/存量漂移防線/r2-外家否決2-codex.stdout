 22365	def _nodehome_resp_ok(value):
 22366	    """[S16] 負責範圍:至少 10 個字、要有實字(全標點、空白視同沒寫)。實字判準同 [manual:] 那條。"""
 22367	    if not isinstance(value, str):
 22368	        return False
 22369	    v = value.strip()
 22370	    return len(v) >= _NODEHOME_RESP_MIN_CHARS and bool(re.search(r"[^\W_]", v))
