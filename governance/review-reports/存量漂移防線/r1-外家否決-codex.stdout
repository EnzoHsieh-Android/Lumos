32027:    REVISIT:2026-12-08 或這個 repo 開始用 PR / 加上分支保護時,重新判這一道能不能跳。
33293:    # ★獨立旗標,不共用 --no-any★(設計 [S5]):那支的語意有硬合約釘住只管多詞查詢。
        warn_soft([], f"這一段算不出來({_e.__class__.__name__}: {_e}),先跳過")
    print()

    section("S14", "風險低計劃放行(舊稱雙向門放行):放行了幾份、逃逸幾筆(按門與階段)、三條撤除條件的分子——人讀人裁,不自動擋(提醒,不擋)")
    try:
        _sg_latest = _spec_gate_latest_records(env)
        _two = {lp: r for lp, r in _sg_latest.items() if _rec_plan_risk(r) == "low"}
        _one = {lp: r for lp, r in _sg_latest.items() if _rec_plan_risk(r) == "high"}
        if not _sg_latest:
            ok("還沒有任何計劃留過規格閘的門(lumos spec-gate <計劃> 過了會留)")
        else:
            _mo = sum(1 for r in _two.values() if r.get("manual_only"))
            ok(f"風險低計劃放行 {len(_two)} 份(其中全靠人驗、走小改動閘的 {_mo} 份)、風險高計劃 {len(_one)} 份(每條迴圈只看最後一筆留痕;門判定規則版本 {_DOOR_RULE_VERSION}、小改動規則版本 {_SMALL_CHANGE_RULE_VERSION})")
            _esc = _escape_rows_for(env)
            _by = {}
            for _e in _esc:
                _dr = _rec_plan_risk(_e) if (_e.get("plan_risk") or _e.get("door")) else _door_for_loop(env, str(_e.get("loop", "")))
                _by.setdefault(_dr, {}).setdefault(str(_e.get("stage") or "?"), 0)
                _by[_dr][str(_e.get("stage") or "?")] += 1
            for _dr in ("low", "high", "unknown"):
                if _by.get(_dr):
                    print(f"    逃逸({'風險低計劃' if _dr == 'low' else '風險高計劃' if _dr == 'high' else '風險不明'})按階段:" + "、".join(f"{_esc_clean(k, 40)} {v}" for k, v in sorted(_by[_dr].items())))
            _tw_esc = [_e for _e in _esc if ((_rec_plan_risk(_e) if (_e.get("plan_risk") or _e.get("door")) else _door_for_loop(env, str(_e.get("loop", "")))) == "low") and _e.get("precision") != "round"]
            _first30 = set(sorted(_two, key=lambda lp: str(_two[lp].get("ts", "")))[:30])
            _n_blocker = len({str(_e.get("loop")) for _e in _tw_esc if _e.get("severity") == "blocker"})
            _n_major = len({str(_e.get("loop")) for _e in _tw_esc if _e.get("severity") in ("major", "blocker") and str(_e.get("loop")) in _first30})
            _n_unrev = len({str(_e.get("loop")) for _e in _tw_esc if _e.get("stage") == "push-gate-unreviewed"})
            _round_only = sum(1 for _e in _esc if _e.get("precision") == "round")
            print(f"    撤除條件分子(只數 precision≠round 與手動記的列;輪級粗判 {_round_only} 列另計不入):blocker 級逃逸 {_n_blocker} 份 / 前 30 份裡 major 以上 {_n_major} 份 / push-gate-unreviewed {_n_unrev} 份")
            print("    門檻(拍的,結果出來前不改):①blocker ≥1 份 → 立刻退回風險低計劃放行 ②前 30 份 major 以上 ≥3 份 → 退回 ③push-gate-unreviewed ≥2 份 → 門判定規則重審")
            if _two:
                _rows = [f"{lp}:條款 {r.get('n_clauses', '?')}/紅 {r.get('n_red', '?')}/keeps {r.get('n_keeps', 0)}(留痕 {str(r.get('ts', ''))[:10]})" for lp, r in sorted(_two.items())]
                warn_soft(_rows, f"風險低計劃的條款數與紅測試數({len(_rows)} 份;分不清「規則太嚴」還是「沒空寫測試」時看這裡):", "紅要在推送前做綠;一直沒推=沒人做,不是閘的問題")
                import datetime as _dtm
                _now = _dtm.datetime.now().astimezone()
                _stale = []
                for lp, r in sorted(_two.items()):
                    _pp = env.vault / str(r.get("plan") or "")
                    _nn = env.notes.get(str(r.get("plan") or ""))
                    if _nn is None or str(_nn.fields.get("status")) != "doing":
                        continue
                    try:
                        _age = (_now - _dtm.datetime.fromisoformat(str(r.get("ts")))).days
                    except (ValueError, TypeError):
                        continue
                    if _age > _DOOR_STALE_DAYS:
                        _stale.append(f"{lp}:{_age} 天沒新留痕({_pp.name})")
                if _stale:
                    warn_soft(_stale, f"風險低 doing 計劃超過 {_DOOR_STALE_DAYS} 天沒新留痕({len(_stale)} 份):", "做完就 lumos set 成 done;還在做就重跑 lumos spec-gate 留一筆")
    except Exception as _e:
        warn_soft([], f"這一段算不出來({_e.__class__.__name__}: {_e}),先跳過")
    print()

    section("S15", "預告了但還沒做的合約:逾期會擋(不准延期),七天內到期先唸(必要合約清單_計劃)")
    try:
        import datetime as _gd
        _gtoday = _gd.date.today()
        _gover, _gover_other, _gsoon = [], [], []
        for _grel, _gn in sorted(env.notes.items()):
            if _gn.fields.get("type") != "verification" or not _gn.fields.get(GUARD_MARK_FIELD):
                continue
            if str(_gn.fields.get("status") or "") != "pending":
                continue
            try:
                _gd2 = _gd.date.fromisoformat(str(_gn.fields.get("due") or "").strip())
            except ValueError:
                _gover.append(f"{_grel}:最遲日期寫壞了,讀不出來")
                continue
            _gowner = str(_gn.fields.get("owner") or "?").strip()
            _gbody = (env.vault / _grel).read_text(encoding="utf-8", errors="replace")
            _gm = re.search(r"^預告的合約:(.+)$", _gbody, re.M)
            _gclaim = (_gm.group(1).strip() if _gm else _grel)
            # ★到期當天不算過期★:最遲日期是人手寫的本地日期,誤擋一次比漏擋一天貴
            if _gd2 < _gtoday:
                _ghit, _gwhy = _guard_touches(_gn, env, touched)
                _gline = f"{_gclaim}(負責人 {_gowner},最遲 {_gd2});{_grel}"
                (_gover if _ghit else _gover_other).append(_gline + _gwhy)
            elif (_gd2 - _gtoday).days <= 7:
                _gsoon.append(f"{_gclaim}(負責人 {_gowner},最遲 {_gd2});{_grel}")
        if _gover:
            warn(_gover, f"有 {len(_gover)} 條預告的合約已經逾期(不准延期,只能做完或棄置):",
                 "做完了:lumos guard settle <守衛節點> --test <測試方法>;"
                 "決定不做:先 lumos signoff <守衛節點> --ref <守衛節點> --note \"<為什麼>\",再 lumos guard abandon")
        if _gover_other:
            # ★本機那一層只擋這次碰到的★(必要合約清單_計劃〈擋的範圍〉第一層):
            # 這幾條是別人的債,列出來讓人知道,但不擋這次推送——被擋的人解不開別人的合約,
            # 那不是嚴格,是防做事。CI 不給清單,所以那邊照舊全擋。
            warn_soft(_gover_other, f"另有 {len(_gover_other)} 條逾期的預告合約,但這次改動沒碰到它們(不擋這次推送):",
                      "推送前的閘只擋你這次碰到的,CI 會擋全部;想看全部待完成的:lumos guard required")
        if _gsoon:
            warn_soft(_gsoon, f"有 {len(_gsoon)} 條預告的合約七天內到期(先講,還不擋):",
                      "現在做完最省事:lumos guard settle <守衛節點> --test <測試方法>")
        # ★舊規則截斷出來的檔名★(必要合約清單_計劃 S22,2026-09-23):以前 guard plan 拿合約原文前 40 字當檔名,
        # 會斷在句子中間。判法是精確比對不是猜:每篇守衛節點都存著完整合約原文,檔名(去掉日期)等於
        # 「原文被舊規則截斷的樣子」、而且原文確實比截斷長度長,才算。手取的名字不會被點到。
        _gtrunc = []
        for _grel, _gn in sorted(env.notes.items()):
            if _gn.fields.get("type") != "verification" or not _gn.fields.get(GUARD_MARK_FIELD):
                continue
            _gm2 = re.search(r"^預告的合約:(.+)$", (env.vault / _grel).read_text(encoding="utf-8", errors="replace"), re.M)
            if not _gm2:
                continue
            _gc = nfc(_gm2.group(1).strip())   # 檔名那邊載入時已經是 NFC;原文不先正規化,含組合字元的會漏抓(代碼審 r2 通才席)
            _gfull = re.sub(f"[^{_GUARD_NAME_CHARS}]+", "-", _gc).strip("-")
            _gstem = re.sub(r"^\d{4}-\d{2}-\d{2}_", "", Path(_grel).stem)
            if _gstem == _guard_plan_slug(_gc) and _gstem != _gfull:
                _gtrunc.append(_grel)
        if _gtrunc:
            warn_soft(_gtrunc, f"有 {len(_gtrunc)} 篇守衛節點的檔名是舊規則從合約原文截斷出來的(斷在句子中間):",
                      "改成短名(日期前綴可留可拿掉),連同引用一起改:scripts/graph-rename.sh <舊名> <新名>")
        if not _gover and not _gsoon and not _gover_other:
            # ★有檔名提醒時不准印得像全都乾淨★(代碼審 r1 架構席):這一行是會被當成「沒事」掃過去的訊號,
            # 同一段先前就因為同樣形狀被擋過一次(逾期但沒碰到那一堆)
            ok("沒有逾期或快到期的預告合約" + (f"(但上面有 {len(_gtrunc)} 篇檔名要改)" if _gtrunc else ""))
        elif not _gover and not _gsoon:
            # ★收尾有兩條打勾的分支,兩條都會被當成「全都乾淨」掃過去★(代碼審 r1 通才席;
            # 2026-09-23 代碼審 r2 兩席:檔名提醒第一版只補了上面那條,這條漏了)。
            # 上面剛列完「還有 N 條逾期」或「幾篇檔名要改」,這裡再印得像沒事,人會誤信。
            ok(f"這次改動沒碰到任何逾期的預告合約(上面那 {len(_gover_other)} 條還在,只是不擋這次推送)"
               + (f"(另外上面有 {len(_gtrunc)} 篇檔名要改)" if _gtrunc else ""))
    except Exception as _e:
        warn_soft([], f"這一段算不出來({_e.__class__.__name__}: {_e}),先跳過")
    print()

    section("H", "這次改動碰到正式環境、外部 API 或寄送,筆記有沒有標「做了就回不去」(提醒,不擋)")
    if not ci:
        print("  (僅 --ci 模式掃 diff;互動模式略過)")
    else:
        hint_hits = _scan_diff_for_irreversible_hints(str(env.vault))
        if not hint_hits:
            ok("這次改動沒碰到疑似做了就回不去的操作")
        else:
            warn_soft(
                hint_hits,
                f"這次改動有 {len(hint_hits)} 行疑似碰到做了就回不去的操作(正式環境/外部 API/寄送):",
                "去對應的 Systems 筆記確認有沒有標 ★IRREVERSIBLE★ 並寫好回退或防護;確定其實可逆就忽略",
            )
    print()

    # Check K: ★COMBO★ 組合覆蓋提醒(軟,不擋,不計 issues)——標了 ★COMBO★ 的最重 ★INVARIANT★
    #   只綁 1 個 [test:] 標記 → 提醒補組合。數 [test:] 標記個數(TEST_REF_RE,非展開名數),免 [test:a,b] 逗號繞過。
    section("K", "最重要的合約是不是只綁了一條測試(提醒補組合情境)")
    combo_thin, combo_any = [], False
    for rel, n in sorted(notes.items()):
        invs, _ = extract_contracts(n)
        for inv in invs:
            if "★COMBO★" not in inv:
                continue
            combo_any = True
            if len(TEST_REF_RE.findall(inv)) == 1:
                combo_thin.append(inv.replace("★COMBO★", "").strip())
                gov_events.append({"gate": "check-k", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not combo_any:
        ok("沒有標成「最重要合約」的規則,不需要組合測試")
    elif combo_thin:
        _soft_list(combo_thin,
                   f"有 {len(combo_thin)} 條最重要的合約只綁了一條測試(只測正常路徑):",
                   "為這條最重鐵則補一條組合情境測試(多條件交叉),別只測 happy-path")
    else:
        ok("最重要的合約都綁了兩條以上的測試")
    print()

    # Check D: 紀律區塊漂移守衛(內容比對)
    # 範本 scripts/templates/graph-discipline.md ↔ CLAUDE.md sentinel block body。
    # guard: 範本不存在 → skip(不算 issue);CLAUDE.md absent → skip(未注入過的 repo 不罰)。
    # broken → 報漂移(算 issue,但不取 .body 避免 crash)。
    section("D", "專案 CLAUDE.md 與 Codex 指示檔(AGENTS.md)裡的工具鏈紀律區塊,跟範本有沒有對上")
    if repo_root is None:
        print("  (無 docs/ 佈局,略過 Check D)")
    else:
        # slug 從 vault 名取(慣例 docs/<slug>-knowledge → vault.name 去尾碼)
        _d_vault_name = env.vault.name
        _d_slug = (_d_vault_name[:-len("-knowledge")]
                   if _d_vault_name.endswith("-knowledge") else _d_vault_name)
        expected_body = _expected_claude_body(repo_root, _d_slug)
        if expected_body is None:
            print("  (無 scripts/templates/graph-discipline.md 範本,略過 Check D)")
        else:
            # 目標清單=CLAUDE.md + Codex 指示檔(d1;三端共用同一份清單)
            for _d_name in _reinject_targets(repo_root):
                _d_cm = repo_root / _d_name
                if not _d_cm.exists():
                    print(f"  (無 {_d_name},略過 — 尚未注入無需比對)")
                    continue
                _d_text = _d_cm.read_bytes()
                if _d_text.startswith(b"\xef\xbb\xbf"):
                    _d_text = _d_text[3:]
                _d_text = _d_text.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
                _d_state, _d_span = _extract_claude_block_span(_d_text)
                if _d_state == "absent":
                    print(f"  ({_d_name} 無 sentinel 區塊,略過 — 尚未注入)")
                elif _d_state == "broken":
                    warn([f"{_d_name} 紀律區塊的起訖標記 sentinel 損壞(只剩頭或只剩尾)——用 lumos update(或 lumos init)修復"],
                         f"{_d_name} sentinel 損壞(broken)— 無法比對,視為漂移:",
                         "lumos init --force 或 lumos update 修復 sentinel 再重驗")
                else:
                    # found: 比對 body
                    if _d_span.body == expected_body:
                        ok(f"{_d_name} 的工具鏈紀律區塊跟範本一致")
                    else:
                        warn([f"{_d_name} 紀律區塊跟範本不同步——用 lumos update(或 lumos init)刷新"],
                             f"{_d_name} 紀律區塊漂移(與範本不一致):",
                             f"lumos update 或 lumos init --force 刷新 {_d_name} 紀律區塊")
            # Codex 把 git 根到 cwd 每層生效的那一個 AGENTS 檔串起來,合計上限 32 KiB、超過靜默截斷
            # (官方文件;r1 邊界 F6b)。這裡只估本 repo 根這一層(有 override 只算 override),>75% 提醒。
            _d_eff = repo_root / _agents_target(repo_root)
            if _d_eff.exists():
                _d_bytes = _d_eff.stat().st_size
                if _d_bytes > 32768 * 0.75:
                    warn([f"{_d_eff.name} 有 {_d_bytes} bytes,Codex 整鏈 AGENTS 檔上限 32768、超過會靜默截掉後面——把非必要內容搬走或縮短"],
                         f"{_d_eff.name} 單這一層就佔整鏈上限 {_d_bytes * 100 // 32768}%(>75%;全域與子目錄另計):",
                         "縮短該檔或把長內容移到圖譜筆記")
                else:
                    print(f"  {_d_eff.name} {_d_bytes} bytes=整鏈上限 32768 的 {_d_bytes * 100 // 32768}%(只算 repo 根這一層;全域 ~/.codex/AGENTS.md 與子目錄另計,超過靜默截斷)")
            # 常駐紀律範本長回來要看得見([[Projects/skills提示工程優化_計劃]] S4):07-29 瘦身後 5.1KB,
            # 09-11 量到 8.2KB 才發現——中間沒有任何一處印過。只在範本所在的來源 repo 印;只提醒、不擋、不進 issues。
            _d_tpl = repo_root / "scripts" / "templates" / "graph-discipline.md"
            if _d_tpl.exists():
                _d_tb = _d_tpl.stat().st_size
                _d_pct = _d_tb * 100 // _DISCIPLINE_SLIM_BASELINE_BYTES
                if _d_tb > _DISCIPLINE_SLIM_BASELINE_BYTES * 1.5:
                    warn_soft([f"紀律範本 scripts/templates/graph-discipline.md 現在 {_d_tb} bytes,"
                               f"是上次瘦身後({_DISCIPLINE_SLIM_BASELINE_BYTES} bytes)的 {_d_pct}%"],
                              "常駐的紀律範本長回五成以上了——它每回合都注入每個專案的 CLAUDE.md/AGENTS.md:",
                              "再瘦一次:細節搬進 skill 參考檔、範本只留指路(搬家不刪義);見 Projects/skills提示工程優化_計劃")
                else:
                    print(f"  紀律範本 {_d_tb} bytes,是上次瘦身後({_DISCIPLINE_SLIM_BASELINE_BYTES} bytes)的 {_d_pct}%(超過 150% 才提醒)")
    print()

    section("V", "寫了「這個結論在什麼前提下成立」的筆記,有多少超過 90 天沒回頭看(提醒,不擋)")
    vu_total, vu_stale = [], []
    for rel, n in sorted(notes.items()):
        if not _conds(n.fields.get("valid_under")):
            continue
        vu_total.append(rel)
        age = _node_age_days(n)
        if age is not None and age > 90:
            vu_stale.append(f"{rel}(已 {age} 天未更新)")
    if not vu_total:
        ok("沒有筆記寫「這個結論在什麼前提下成立」,這項不用量")
    elif vu_stale:
        rate = len(vu_stale) / len(vu_total)
        warn_soft(vu_stale,
                  f"{len(vu_stale)}/{len(vu_total)} ({rate:.0%}) 個 valid_under 節點 >90 天未更新(前提可能失效):",
                  "進場 lumos context 已會警示;>90 天者建議重核 valid_under、必要時標 stale 或建新 Verification")
    else:
        ok(f"0/{len(vu_total)} (0%) — 所有 valid_under 節點 ≤90 天")
    print()

    section("P", "筆記提到的程式檔路徑,檔案還在不在(提醒,不擋)")
    if repo_root is None:
        ok("(這個專案沒有 docs/ 資料夾,檔案路徑檢查跳過)")
    else:
        top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
        _suffix_re = re.compile(r":([^/]+)$")
        stale_claims = []
        for rel, n in sorted(notes.items()):
            # ★體檢 #10(2026-08-21)降噪★:Verification 是「當時的紀錄」,引用當時路徑是它的職責,
            # 碼搬走不該叫它改;superseded/stale 節點同理。只守「宣稱現況」的活節點。
            if n.fields.get("type") == "verification" or \
               str(n.fields.get("status", "")).strip() in ("superseded", "stale"):
                continue
            try:
                text = (env.vault / rel).read_text(encoding="utf-8-sig")
            except OSError:
                continue
            # ★不可換回 FENCE_RE★:它錨第 0 欄、假設成對,縮排收尾會吞掉真散文(見 _visible_lines)
            spans = [s.strip("`") for s in INLINE_CODE_RE.findall(_strip_fences_text(text))]
            seen_paths = set()
            for raw in spans:
                if "://" in raw or any(c in raw for c in "*<>?"):
                    continue
                if "{" in raw or "}" in raw:      # 大括號展開寫法 a/{x,y}.md 不是路徑(體檢 #10 實測假陽性)
                    continue
                m = _suffix_re.search(raw)
                if m:
                    token, sfx = raw[:m.start()], m.group(1)
                    line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
                else:
                    token, line = raw, ""
                if "/" not in token or token in seen_paths:
                    continue
                if token.split("/")[0] not in top_dirs:
                    continue
                seen_paths.add(token)
                if not (repo_root / token).exists():
                    loc = f"{rel}:{line}" if line else rel
                    stale_claims.append(f"{loc} → {token}(已不存在)")
        if stale_claims:
            warn_soft(stale_claims,
                      f"有 {len(stale_claims)} 處筆記提到的程式檔路徑已經不存在(碼被刪或搬了?):",
                      "碼被刪/改名?更新節點正文的路徑引用,或補對應節點")
        else:
            ok("筆記提到的程式檔都還在")
    print()

    # ── Check N:可重算數字宣稱(存查詢不存答案;成因 F「寫死易漂的值」)──
    # 由來:2026-08-12 LandmarkMember 全 24 篇交叉審計,★F 類每一批都復發★——
    # 「共 5 處」(實為 7)、「8 場景通過」、「46 場景」(實為 40)、「9 個元件」(實為 8 少列一個)、
    # 行號 173/392(實為 189/415)。2026-06-10 首跑就記過教訓「計數/清單型主張最會漂」,
    # 但★沒有配任何機制★,兩個月後照樣復發。
        _scope = {"system", "issue"}
        for _m in _moc_notes:
            _mtxt = (env.vault / _m).read_text(encoding="utf-8", errors="replace")
            if re.search(r"只列\s*Systems|僅列\s*Systems|only\s+Systems", _mtxt, re.I):
                _scope = {"system"}
            for _t in notes[_m].targets:
                _d = env.resolve(_t)
                if _d:
                    _linked.add(_d)
        _unlisted = []
        for rel, n in sorted(notes.items()):
            _ty = n.fields.get("type")
            if not isinstance(_ty, str) or _ty not in _scope:   # type 寫成清單時拿去查集合會丟例外(代碼審 r1 邊界席順帶抓到的舊坑)
                continue
            if str(n.fields.get("status", "")).strip() in ("superseded", "stale"):
                continue
            if rel not in _linked:
                _unlisted.append(rel)
                # ★每個軟提醒分支都要落一筆帳★(代碼審 r1 噪音席):
                # 不掛的話這道的提醒永遠進不了治理統計與 14 天升級鏈,
                # 跟其餘五道軟提醒變成兩種形狀。
                gov_events.append({"gate": "check-s6", "kind": "warned",
                                   "hard": False, "nodes": [n.stem]})
        if not _unlisted:
            ok(f"總索引把 {len([1 for r, n in notes.items() if isinstance(n.fields.get('type'), str) and n.fields.get('type') in _scope])} 篇節點都列到了(範圍:{'/'.join(sorted(_scope))})")
        else:
            _soft_list(_unlisted,
                       f"有 {len(_unlisted)} 篇節點沒被總索引連到(找不到入口的節點,下一個人只會往舊的那篇塞):",
                       "在總索引補一行連過去;索引是「這條合約該放哪」的唯一地圖,漏列等於那篇不存在")
    print()

    section("S7", "有沒有哪一篇的合約多到讀不完(提醒,不擋)")
    # ★判準只看「一篇有幾條合約」★——這是拿六個真圖譜資料點校準出來的,而且改過一次:
    # 原本用「佔全圖比重 + 提到幾個檔」,抓不到第二種長歪形狀(一篇管一個模組裡的三個
    # 主題,只提一個檔)。改成數合約條數之後六個資料點全對而且更簡單。
    #
    # 校準(節點範圍與索引守衛_計劃 [S5] 的表):本工具鏈自己最多 7 條;兩次長歪都在
    # 15 條以上;兩次拆完都在 8 條以下。中間有明顯空隙。
    _cfg = _lumos_config_near_vault(env) or {}
    _ns = _cfg.get("node_scope") if isinstance(_cfg.get("node_scope"), dict) else {}
    _cap = _ns.get("max_contracts", 10)
    # ★bool 要單獨擋★(代碼審 r1 正確性席 major):Python 裡 bool 是 int 的子類,
    # isinstance(True, int) 為真、True < 1 為假,兩段防呆都會放行,
    # 門檻就悄悄變成 1——每篇有合約的節點都會被誤判「讀不完」。
    if isinstance(_cap, bool) or not isinstance(_cap, int) or _cap < 1:
        warn_soft([f"node_scope.max_contracts 的值看不懂({_cap!r}),退回預設 10"],
                  "專案設定裡的門檻不合法:", "改成 1 以上的整數")
        _cap = 10
    _overloaded = []
    for rel, n in sorted(notes.items()):
        if n.fields.get("type") not in ("system", "issue"):
            continue
        if str(n.fields.get("status", "")).strip() in ("superseded", "stale"):
            continue
        try:
            _inv, _debt = extract_contracts(n)
        except Exception:
            continue
        _cnt = len(_inv) + len(_debt)
        if _cnt >= _cap:
            _overloaded.append(f"{rel} ({_cnt} 條合約)")
            gov_events.append({"gate": "check-s7", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not _overloaded:
        ok(f"沒有哪一篇的合約超過 {_cap} 條(門檻:node_scope.max_contracts)")
    else:
        _soft_list(_overloaded,
                   f"有 {len(_overloaded)} 篇的合約多到一次讀不完(門檻 {_cap} 條):",
                   "跑 `lumos contracts <節點>` 把那些合約列出來,看它們是不是其實在講好幾件事——是的話一件一篇拆開;真的是同一件事就把門檻調高(專案設定 node_scope.max_contracts)。★這道量的是「還讀得完嗎」,不是「設計對不對」★")
    print()

    # ── 每支檔有家的舊帳(2026-09-11,Projects/每支檔有家_計劃 [S28]):排在合約條數那段之後、[H] 之前——
    # 軟段截斷那支測試切的是 [S] 到 [E1],插進那個窗口會被數進去而翻紅(鄰居三段同一條位置紀律)。
    _nhl = _nodehome_ledger(_vault_repo_root(env), env.vault)
    section("S8", "每支程式檔有沒有一篇管它的節點(提醒,不擋;新增的由提交前檢查擋)")
    if _nhl is None:
        print("  (不是 git 專案或讀不到檔案清單,跳過)")
    else:
        if not (_nhl["bypassed"] or _nhl["legacy"]):
            ok("每支需要家的程式檔都有家(about_code 列了它)")
        if _nhl["bypassed"]:
            warn_soft(_nhl["bypassed"],
                      f"有 {len(_nhl['bypassed'])} 支是守衛上線之後才新增、卻沒有家的檔——該被擋卻進來了(有人跳過提交前檢查,或開關被關):",
                      "替它們安家:lumos new system <名> --code <檔> --responsibility \"<負責什麼>\",或 lumos append <確實在講它的節點> about_code <檔>")
        if _nhl["legacy"]:
            warn_soft(_nhl["legacy"],
                      f"有 {len(_nhl['legacy'])} 支是上線前就在、還沒有家的舊檔(舊帳,分批還;下次要往圖譜寫它的說明時會被要求先安家):",
                      "一次替一個資料夾安家:lumos new system <名> --code <檔> …,或加進確實在講它的那篇")
        if _nhl["bad_names"]:
            warn_soft(_nhl["bad_names"],
                      f"有 {len(_nhl['bad_names'])} 支程式檔的檔名不是 UTF-8——圖譜是 UTF-8 文字,寫不進它的路徑,永遠當不了誰的家:",
                      "改名成 UTF-8,或加進 .lumos/config.json 的 node_home.ignore")
        for _f in _nhl["bypassed"] + _nhl["legacy"]:
            gov_events.append({"gate": "check-s8", "kind": "warned", "hard": False, "nodes": [_f]})
    print()
    section("S9", "節點有沒有用反引號寫別人的檔(提醒,不擋;新寫進去的由提交前檢查擋)")
    if _nhl is not None:
        if not (_nhl["foreign"] or _nhl["foreign_new"]):
            ok("沒有節點用反引號寫別人家的程式檔")
        def _nh_fmt(d):
            return [f"{r[:-3]}:{'、'.join(fs[:4])}{' …' if len(fs) > 4 else ''}" for r, fs in d.items()]
        if _nhl["foreign_new"]:
            warn_soft(_nh_fmt(_nhl["foreign_new"]),
                      f"有 {len(_nhl['foreign_new'])} 篇節點在守衛上線之後才寫進別人家的檔名——該被擋卻進來了(有人跳過提交前檢查,或開關被關):",
                      "改寫成那支檔的家的節點連結 [[Systems/…]];那支檔沒家就先替它安家")
        if _nhl["foreign"]:
            warn_soft(_nh_fmt(_nhl["foreign"]),
                      f"有 {len(_nhl['foreign'])} 篇節點用反引號寫了別人家的檔(上線前就在的舊帳)——改那些檔時工具會推出這篇,東西就越寫越多(長出一篇包全部的成因):",
                      "改寫成那支檔的家的節點連結 [[Systems/…]];那支檔沒家就先替它安家")
        for _r in list(_nhl["foreign_new"]) + list(_nhl["foreign"]):
            gov_events.append({"gate": "check-s9", "kind": "warned", "hard": False, "nodes": [Path(_r).stem]})
    print()
    check("★紅釘 ESC-03:null/陣列/非法行全跳過不炸,聚合警告帶行號★",
          "3 行壞損" in rl2.stderr and "3 筆" in rl2.stdout, (rl2.stderr + rl2.stdout)[:300])



def t_metric_criteria_drift_guard():
    """[換尺可比切片](spec:Projects/loop數據收集_計劃「換尺可比與自動回饋隔離」節,r1 五席縮案+r2 收斂)
    三數字治理帳的兩道機械守衛:
    ①判準句凍結:標記間原文 NFC sha256 前8碼 vs 變更日誌最新 rev——判準改了沒記日誌=紅;
      日誌欄非 8 碼 hex(bootstrap 首列佔位)=紅並印現算值供人工謄入(測試永不寫檔)。
    ②引用點漂移:三帳記號在執行面(scripts/+autonomous_loop)的引用檔必須在允許清單內——
      新引用出現=紅,人判「讀側/文件」入清單或「數字值進閘」立事故(spec C 節禁令)。"""
    import hashlib as _hl
    import re as _re
    import unicodedata as _ud
    root = Path(__file__).resolve().parent.parent
    plan = root / "docs" / "lumos-toolchain-knowledge" / "Projects" / "loop數據收集_計劃.md"
    text = plan.read_text(encoding="utf-8")
    m = _re.search(r"<!-- METRIC-CRITERIA:START -->\n(.*?)<!-- METRIC-CRITERIA:END -->", text, _re.S)
    check("★前置★ 判準句標記對存在且唯一", m is not None and text.count("METRIC-CRITERIA:START") == 1
          and text.count("METRIC-CRITERIA:END") == 1,
          "標記缺失或不唯一(含 END)——內文提早出現 END 字面會靜默截斷雜湊")
    calc = _hl.sha256(_ud.normalize("NFC", m.group(1)).encode("utf-8")).hexdigest()[:8]
    logm = _re.findall(r"^\| (\d{4}-\d{2}-\d{2}) \| (\S+) \|", text, _re.M)
    check("★前置★ 變更日誌表至少一列", bool(logm), text[-500:])
    latest = sorted(logm, key=lambda r: r[0])[-1][1] if logm else ""   # 最新=日期最大(同日取後出現;不賭加列方向,插上方實錘 code-r1 H-1)
    if not _re.fullmatch(r"[0-9a-f]{8}", latest):
        check("★判準凍結:日誌 rev 未回填(bootstrap)——把下列現算值謄入日誌最新列★",
              False, f"現算 rev={calc};謄入 Projects/loop數據收集_計劃.md 變更日誌表後重跑")
    else:
        check("★判準凍結:標記間現算 sha == 日誌最新 rev(改判準沒記日誌=紅)★",
              latest == calc, f"日誌={latest} 現算={calc}——判準句被改但變更日誌沒跟,記一列再說")
    # ② 引用點漂移(執行面掃描;governance/review-reports 與 docs/*-knowledge 屬允許引用不在掃描面)
    ALLOWED = {"scripts/lumos", "scripts/test_lumos.py"}
    hits = set()
    def _scannable(q):
        return q.is_file() and "__pycache__" not in q.parts and q.suffix != ".pyc"   # 兩掃描面共用(code-r2:漏掛=同支測試兩套邏輯)
    scan = [q for q in (root / "scripts").rglob("*") if _scannable(q)]   # 遞迴含 hooks/templates(code-r1 H-3)
    al = root / "governance" / "autonomous_loop"
    scan += [q for q in al.rglob("*") if _scannable(q)] if al.exists() else []
    for q in scan:
        try:
            body = q.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        if ".escape-log.jsonl" in body or "★圖譜攔截★" in body:
            hits.add(str(q.relative_to(root)))
    check("★引用點漂移:三帳記號在執行面的引用檔全數在允許清單內(新引用=先人判再放行)★",
          hits <= ALLOWED, f"清單外新引用:{sorted(hits - ALLOWED)}——讀側/文件就加進本測試的允許清單;是拿數字值當閘條件就立事故(spec C 節禁令)")



def t_doctor_revisit_reminder():
    """[回訪掃描](spec:Projects/回訪掃描_計劃 v3,r1 五席+r2 折入)
    E5 段:REVISIT 行到期掃描。紅釘:①到期會唸+最老優先+advice ②壞日期=損毀計數不靜默(fail-closed)
    ③列表前綴吃得到(原句棲地)④code/表格不算 ⑤全靜默 ⑥--ci 落 gov event nodes=stem
    ⑦★接電鏈:check-revisit warned 連喊 ≥14 天→gov --nags 14 升級清單(外家複判條件)★。"""
    import json as _j
    import datetime as _dt
    import subprocess as _sp
    v = mkvault()
    # 治理帳寫入器在非 git/無 HEAD 時靜默跳過(_append_governance_log 明文)——鏈測試需要真 git
    _sp.run(["git", "init", "-q"], cwd=v.parent, check=True)
    _sp.run(["git", "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-q", "--allow-empty", "-m", "x"],
            cwd=v.parent, check=True)
    y1 = (_dt.date.today() - _dt.timedelta(days=9)).isoformat()
    fut = (_dt.date.today() + _dt.timedelta(days=30)).isoformat()
    write(v, "Projects/回訪甲_計劃.md", "type: project\ntags:\n  - type/project",
          f"# 回訪甲_計劃\n- 承諾句在此。\n- REVISIT:{y1} 回頭看甲\nREVISIT:{fut} 未來的事\nREVISIT:2026-9-1 缺零壞日期\n")
    write(v, "Systems/回訪乙.md", "type: system\ntags:\n  - type/system",
          "# 回訪乙\n```\nREVISIT:2020-01-01 code區不算\n```\n| REVISIT:2020-01-01 表格不算 |\n")
    r = run(v, "doctor")
    check("★E5 到期會唸:件數+逾天數+打卡指路★",
          "1 件回訪到期" in r.stdout and "逾 9 天" in r.stdout and "回頭看甲" in r.stdout
          and "日期改下一次或刪行" in r.stdout, r.stdout[-800:])
    check("★紅釘②:壞日期=損毀計數印在 head(cap3 吞不掉;parse 不過永不到期)★",
          "1 行 REVISIT 日期格式壞損" in r.stdout
          and "壞損" in r.stdout.split("[E5]")[1].split("\n")[1], r.stdout[-800:])
    _e5 = r.stdout.split("[E5]")[1].split("\n[")[0] if "[E5]" in r.stdout else ""
    check("★紅釘③④:列表前綴吃到(到期那行是 bullet);code/表格行不算(乙不在 E5 段)★",
          "回訪甲_計劃" in _e5 and "回訪乙" not in _e5, _e5[:400])
    # ★紅釘 H-1(code-revisit):摘要控制碼消毒——ESC 位元組不得穿透到輸出★
    write(v, "Projects/回訪注入.md", "type: project\ntags:\n  - type/project",
          f"# 回訪注入\n- REVISIT:{y1} 摘要帶\x1b[31m控制碼\x07測試\n")
    r_inj = run(v, "doctor")
    check("★紅釘 H-1:ESC/BEL 位元組被消毒(兩天前逃逸帳同洞,勿三挖)★",
          "\x1b" not in r_inj.stdout.split("[E5]")[1].split("\n[")[0]
          and "\x07" not in r_inj.stdout.split("[E5]")[1].split("\n[")[0]
          and "控制碼" in r_inj.stdout, r_inj.stdout[-400:])
    (v / "Projects" / "回訪注入.md").unlink()
    check("advice 指令獨立行(不帶 --code:預設排碼恰排掉討論字)",
          'lumos search "REVISIT:"' in r.stdout, r.stdout[-400:])
    r2 = run(v, "doctor", "--ci")
    gl = (v.parent / ".governance-log.jsonl")
    evs = [_j.loads(l) for l in gl.read_text(encoding="utf-8").splitlines() if l.strip()]
    rv = [e for e in evs if e.get("gate") == "check-revisit"]
    check("★紅釘⑥:--ci 落 gov event,nodes=到期筆記 stem(nags 牙的鍵)★",
          rv and rv[-1]["kind"] == "warned" and rv[-1]["nodes"] == ["回訪甲_計劃"], str(rv[-1:]))
    # ⑤ 全靜默:清掉到期與壞行 → 無 E5 段
    (v / "Projects" / "回訪甲_計劃.md").write_text(
        (v / "Projects" / "回訪甲_計劃.md").read_text(encoding="utf-8")
        .replace(f"REVISIT:{y1} 回頭看甲", f"REVISIT:{fut} 回頭看甲")
        .replace("REVISIT:2026-9-1 缺零壞日期", ""), encoding="utf-8")
    r3 = run(v, "doctor")
    check("★紅釘⑤:0 到期 0 壞行=整段不印(全靜默慣例)★", "[E5]" not in r3.stdout and "回訪到期" not in r3.stdout,
          r3.stdout[-400:])
    # ⑦ 接電鏈:偽造 15 天前的首喊+剛才的 --ci 喊(同 gate 同 node),nags 14 應列出
    first = (_dt.datetime.now().astimezone() - _dt.timedelta(days=15)).isoformat(timespec="seconds")
    rows = gl.read_text(encoding="utf-8").splitlines()
    with open(gl, "w", encoding="utf-8") as f:
        f.write(_j.dumps({"ts": first, "commit": "x", "gate": "check-revisit", "kind": "warned",
                          "hard": False, "nodes": ["回訪甲_計劃"], "note": "seed"}, ensure_ascii=False) + "\n")
        f.write("\n".join(rows) + "\n")
    rn = run(v, "gov", "--nags", "14")
    check("★紅釘⑦(外家複判條件):連喊 ≥14 天→nags 升級清單列出該篇(牙有電)★",
          rn.returncode == 1 and "check-revisit" in rn.stdout and "回訪甲_計劃" in rn.stdout, rn.stdout[:500])




