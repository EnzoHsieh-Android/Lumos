    rows = classify_invariants(env)
    shown = 0
    for r in rows:
    if not out.is_dir():
        print(f"擋下:輸出目錄不存在,是不是路徑打錯?先建好目錄或改 --out: {out}", file=sys.stderr)
        return 2
    # scaffold_name 模板(python="test_{m}"→test_X.py 命中該 profile 檔名錨;無模板走 klass 慣例。
    # std F2:預設 XTests.py 會被 python 檔名錨排除,scaffold 產物必須自己能被 Check T 掃到)
    _tpl = profile.get("scaffold_name")
    _base = _tpl.format(m=method) if _tpl else klass
    target = out / f"{_base}{profile['scaffold_ext']}"
    if target.exists():
        print(f"擋下:這個檔已經存在,不覆寫(怕蓋掉你寫好的守衛): {target}", file=sys.stderr)
        return 2
    _write_lf(target, text)
    print(f"✓ 已產 stub: {target}")
    print(f"  類型: {gtype}  |  方法: {method}  |  守衛: {clean[:70]}")
    print("\n下一步(Claude/人):")
    print(f"  1. 開 {target.name},把 // TODO 換成『已向人確認的斷言』"
          f"(預設 {profile['fail_hint']} → 必須填到綠)")
    _pflag = f" --platform {platform}" if pdata["multiplatform"] else ""
    print(f"  2. 綁回圖譜:  lumos guard bind {rel} \"{invariant_substr}\" {method}{_pflag}")
    print(f"  3. lumos doctor 確認 Check T 通過")
    return 0


# ═══ 預告合約與待完成守衛節點(必要合約清單_計劃;設計審三輪 37 條全折) ═══
# 一句話:預告「之後要有這條合約」時,同一個指令一次做完「在功能節點寫預告標記」與
# 「建一個待完成的守衛節點」,由那個節點追蹤它;做完轉正,預告行換成正式合約行。
#
# ★記號為什麼不是 ★INVARIANT★★:既有自檢對每條合約判沒綁測試/綁了但方法不存在/綁到非測試,
# 三種都是推送前硬擋。預告時測試還沒寫,用正式記號會當場被擋,走不到「逾期才擋」——
# 核心承諾在第一步就自相矛盾(設計審 r1 blocker)。所以用另一個記號,既有正則撈不到它。
# ★標籤為什麼是 [watch:] 不是 [guard:]★:後者在本 repo 已被可逆性那一軸佔用(值固定 decisions),
# 同名兩義會讓既有正則把節點路徑撈進去(設計審 r2 blocker)。
PLANNED_MARK = "★INVARIANT-PLANNED★"
# ↑ 這一組的正則(PLANNED_RE / WATCH_REF_RE / DUE_REF_RE / _PLANNED_TAIL_RE)不在這裡,
#   在上面合約抽取那一區、緊貼 extract_planned——全檔每一支「從 KEY 行抽標記」的函式
#   都是正則貼著函式放(代碼審 r2 架構席:這支原本是唯一的例外,正則離函式 6800 行)。
# 節點自己身上的標記:規則只認帶這個欄位的節點,不看 status 字面值、也不查外部帳
# (設計審 r1/r2 blocker:pending 是很自然的英文字,手寫的人不該被拖進整套規則;
#  判準放節點自己身上,改名搬家都跟著走)
GUARD_MARK_FIELD = "guards"


def _guard_plan_slug(text):
    """守衛節點檔名:取合約前段做 slug,保留中文,砍掉檔名不能用的字。"""
    s = re.sub(f"[^{_GUARD_NAME_CHARS}]+", "-", text.strip())[:40].strip("-")
    return s or "guard"


_GUARD_NAME_MAX = 24
# ↑ 短名那段(不含日期)的上限。依據:本 repo 驗證紀錄含日期的長度中位數 24、90 分位 32,
#   扣掉 11 字的日期前綴,短名那段中位數約 13、90 分位約 21;24 留了餘裕又逼得出短名字。
# ★檔名能用的字只有這一份★(代碼審 r1 架構席:原本自動檔名與短名驗證各寫一份字面,容易悄悄不同步)。
# \w 在 Python 預設收所有語言的字母與數字(韓文、全形也算),不是只有中英數字——說明要照實講(代碼審 r1 通才席)。
_GUARD_NAME_CHARS = r"\w\u4e00-\u9fff-"
_GUARD_NAME_OK_RE = re.compile(f"[{_GUARD_NAME_CHARS}]")


def _guard_name_problem(name):
    """守衛節點短名哪裡不合格;合格回 None。"""
    n = nfc((name or "").strip())
    if not n:
        return "預告合約要給一個短名(--name)——不給的話,檔名只能拿合約原文截斷,會斷在句子中間"
    if len(n) > _GUARD_NAME_MAX:
        return f"短名太長({len(n)} 字,上限 {_GUARD_NAME_MAX} 字)"
    bad = sorted({c for c in n if not _GUARD_NAME_OK_RE.match(c)})
    if bad:
        return f"短名裡有檔名不能用的字:{' '.join(repr(c) for c in bad)}(只收字母、數字、中文、底線、連字號;不收空白與標點)"
    return None


def _guard_plan_check(env, node, claim, plan, phase, due, why, owner, name=None):
    """預告指令的入口檢查,全部擋下的理由集中在這裡。

    回 (rel, prel, phases, gname, gpath) 或 None(已經印過為什麼擋)。
    ★抽出來是因為主體分支太多★:檢查跟動手寫混在一支函式裡,靜態檢查判它複雜度 17(上限 10),
    而且讀的人要先跳過三十行檢查才看得到真正做事的那段。
    """
    import datetime
    # ★合約文字不准含換行★(代碼審 r1 blocker,實測會吃掉既有合約):
    # 摘要是 YAML block scalar,一個換行就把區塊打斷,後面每一行都變成別的欄位——
    # 同一篇裡原本綁了測試又審計過的真合約會整段從圖譜消失,而指令還回報成功。
    _c = (claim or "")
    if not _c.strip():
        print("擋下:合約那句話不能是空的", file=sys.stderr)
        return None
    if "\n" in _c or "\r" in _c:
        print("擋下:合約那句話不能換行(摘要是一行一條,換行會把整個摘要區塊打斷,"
              "連同這篇既有的合約一起從圖譜消失)", file=sys.stderr)
        return None
    # ★短名也進這張清單★(代碼審 r1 架構席):分開檢查的話,同時漏 --plan 跟 --name 要補兩次才看得到兩個問題
    missing = [(v, lbl) for v, lbl in ((plan, "計劃參照"), (phase, "階段"), (due, "最遲日期"),
                                       (why, "理由"), (owner, "負責人"), (name, "短名")) if not (v or "").strip()]
    if missing:
        names = "、".join(lbl for _v, lbl in missing)
        print(f"擋下:預告合約要寫清楚才追得動,還缺:{names}", file=sys.stderr)
        print("  缺什麼就補什麼:--plan <計劃節點> --phase <階段,可多個逗號分隔> "
              "--due YYYY-MM-DD --why <為什麼還不做> --owner <誰負責> "
              f"--name <短名,當檔名,{_GUARD_NAME_MAX} 字內,例:事故F2_確認前當機不重複副作用>", file=sys.stderr)
        return None
    try:
        datetime.date.fromisoformat(due.strip())
    except ValueError:
        print(f"擋下:最遲日期『{due}』不是 YYYY-MM-DD", file=sys.stderr)
        return None
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return None
    prel = env.find(plan)
    if prel is None:
        print(f"擋下:圖譜裡找不到計劃節點 {plan}", file=sys.stderr)
        return None
    phases = [x.strip() for x in str(phase).split(",") if x.strip()]
    # ★檔名用人給的短名,不再截合約原文★(必要合約清單_計劃 S19 到 S21,2026-09-23 rtb-production-agent-demo 回報):
    # 原本拿合約前 40 字當檔名,產生斷在句子中間的名字。日期前綴保留——本 repo 驗證紀錄全是「日期_短名」。
    _nerr = _guard_name_problem(name)
    if _nerr:
        print(f"擋下:{_nerr}", file=sys.stderr)
        print(f"  守衛節點的檔名要一個短名(會自動加日期前綴,{_GUARD_NAME_MAX} 字以內),例如:", file=sys.stderr)
        print("    --name 事故F2_確認前當機不重複副作用", file=sys.stderr)
        return None
    # ★用正規化過的寫法★(代碼審 r1 通才席):同一個字的組合寫法與預組合寫法位元組不同,
    # macOS 會摺成同一個檔,Linux 不會——撞名保護就會在 CI 那種機器上失效。載入圖譜時本來就用 nfc。
    gname = f"{datetime.date.today().isoformat()}_{nfc(name.strip())}"
    gpath = env.vault / "Verification" / f"{gname}.md"
    if gpath.exists():
        print(f"擋下:守衛節點 {gname} 已經存在,換一句話或改名再試"
              "(不靜默覆蓋:兩個人同時建同名節點會把對方的蓋掉)", file=sys.stderr)
        return None
    return rel, prel, phases, gname, gpath


def _guard_plan_write_node(gpath, gname, rel, prel, phases, today, claim, due, why, owner):
    """把守衛節點的內容組出來落盤,成功回 True(失敗已經印過為什麼)。

    ★先建守衛節點(可重建的那一邊),再寫功能節點的標記(權威那一邊)★(設計審 r1 blocker):
    本 repo 的寫入原語沒有刪除這一步,真回滾搭不起來;既有兩處同類問題都是
    「先寫衍生、後寫權威,後者失敗印警告不回滾」。
    """
    guard_lines = [
        "---\n", "type: verification\n", "status: pending\n",
        f"created: {today}\n", f"updated: {today}\n", f"due: {due.strip()}\n",
        f"owner: {owner.strip()}\n",
        f"{GUARD_MARK_FIELD}:\n", f"  - {rel[:-3] if rel.endswith('.md') else rel}\n",
        "phases:\n"] + [f"  - {x}\n" for x in phases] + [
        "plan_refs:\n", f"  - \"[[{prel[:-3] if prel.endswith('.md') else prel}]]\"\n",
        "tags:\n", "  - type/verification\n", "  - status/pending\n",
        "summary: |-\n",
        f"  WHY:[{today}]預告這條合約但還沒做:{why.strip()}\n",
        f"  TEST:還沒有測試在守這條;最遲 {due.strip()} 要做完,負責人 {owner.strip()}\n",
        "---\n", f"# {gname}\n", "\n",
        f"預告的合約:{claim.strip()}\n", "\n",
        f"為什麼還不做:{why.strip()}\n", "\n",
        "做完之後跑 `lumos guard settle` 轉正,不要手改狀態。\n",
    ]
    # 新建檔走 vault 唯一寫入原語(tmp→os.replace);atomic_write_verify 是給「改既有檔」用的,
    # 它會先讀原檔,對新檔會 FileNotFoundError。寫完自己讀回驗一次(★回報成功未落盤★的老教訓)。
    try:
        _write_lf(gpath, "".join(guard_lines))
        _back = gpath.read_text(encoding="utf-8")
        if "status: pending" not in _back or claim.strip() not in _back:
            raise RuntimeError("寫完讀回來對不上")
    except (OSError, RuntimeError) as ex:
        print(f"擋下:守衛節點寫不進去,什麼都沒動: {ex}", file=sys.stderr)
        return False
    return True


def cmd_guard_plan(env, node, claim, plan, phase, due, why, owner, name=None):
    """預告一條之後要有的合約:寫標記 + 建待完成守衛節點,雙向連好。"""
    import datetime
    checked = _guard_plan_check(env, node, claim, plan, phase, due, why, owner, name)
    if checked is None:
        return 2
    rel, prel, phases, gname, gpath = checked
    today = datetime.date.today().isoformat()

    if not _guard_plan_write_node(gpath, gname, rel, prel, phases, today, claim, due, why, owner):
        return 2
    # ── 再寫功能節點的預告標記
    gref = f"Verification/{gname}"
    path = env.vault / rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        print(f"⚠ 守衛節點已建好({gref}),但功能節點打不開,標記沒寫進去: {ex}", file=sys.stderr)
        print("  不回滾(本 repo 的寫入原語沒有刪除這一步);手動補標記或把守衛節點刪掉重來", file=sys.stderr)
        return 2
    # ★行尾不帶換行★:load_raw_for_edit 回來的每一行都已經去掉換行,自己再加一個會多出空行
    marker = f"  KEY:{PLANNED_MARK} {claim.strip()} [watch:{gref}] [due:{due.strip()}]"
    # 插在摘要區塊第一行之前。★要跳過 summary: 那一行本身之後可能已有的空白行★,
    # 不然會在標記後面留一個空行,讀起來像摘要斷成兩段。
    ins = None
    for i in range(1, e):
        if lines[i].startswith("summary:"):
            ins = i + 1
            while ins < e and not lines[ins].strip():
                ins += 1
            break
    if ins is None:
        print(f"⚠ 守衛節點已建好({gref}),但功能節點沒有摘要區塊,標記沒寫進去", file=sys.stderr)
        print("  不回滾;先給那篇補 summary 再手動加這一行:", file=sys.stderr)
        print("    " + marker.strip(), file=sys.stderr)
        return 2
    new_lines = [*lines[:ins], marker, *lines[ins:]]
    try:
        atomic_write_verify(path, new_lines, PLANNED_MARK,
                            lambda f: PLANNED_MARK in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"⚠ 守衛節點已建好({gref}),但標記寫不進功能節點: {ex}", file=sys.stderr)
        print("  不回滾;手動補上這一行:", file=sys.stderr)
        print("    " + marker.strip(), file=sys.stderr)
        return 2
    # ★還要掛 verified_by★:不掛的話守衛節點在自檢裡是「沒人引用的孤兒驗證紀錄」,
    # 等於預告一條合約就多一個 issue——防忘記的機制自己製造雜訊,人會學會忽略它。
    # 掛了也順便讓「查那篇功能節點就看得到它」成立(設計審重點)。
    _rc_v = cmd_append(env, rel, "verified_by", f"[[{gref}]]")
    if _rc_v != 0:
        print("⚠ 標記與守衛節點都寫好了,但 verified_by 沒掛上——它會被當成孤兒驗證紀錄", file=sys.stderr)
        print(f"  手動補:lumos append {rel[:-3] if rel.endswith('.md') else rel} verified_by \"[[{gref}]]\"", file=sys.stderr)
    print(f"✓ 預告合約已登記:{rel} 多了一行預告標記,{gref} 在守它")
    print(f"  最遲 {due.strip()} 要做完(負責人 {owner.strip()});逾期會擋推送,而且不准延期")
    print(f"  做完之後:lumos guard settle {gref} --test <測試方法名>")
    return 0


def _guard_nodes(env):
    """帶本機制標記的守衛節點。★判準放節點身上,不看 status 字面值、不查外部帳★
    (設計審:手寫 pending 的人不該被拖進整套規則;判準跟著節點走,改名搬家都對得上)。"""
    out = []
    for rel, n in sorted(env.notes.items()):
        if n.fields.get("type") != "verification":
            continue
        g = n.fields.get(GUARD_MARK_FIELD)
        if not g:
            continue
        out.append((rel, n))
    return out


def _guard_find(env, ref):
    rel = env.find(ref)
    if rel is None:
        return None, None
    n = env.notes.get(rel)
    if n is None or not n.fields.get(GUARD_MARK_FIELD):
        return None, None
    return rel, n


def _guard_planned_line(env, home_rel, claim):
    """在功能節點裡找那一行預告標記,回 (lines, idx, e, err)。

    ★比照既有引擎的兩道防呆★(代碼審 r1 blocker):`cmd_guard_bind`/`cmd_guard_audit` 對
    「在功能節點裡找某條 KEY 行」都會 ①命中多條就擋,不猜是哪一條 ②找不到就擋。
    第一版用「合約前 12 字」當子字串比對,同一篇預告兩條而前 12 字相同時會改到別條、互相覆蓋。
    這裡改成比對「剝掉 [watch:]/[due:] 之後的完整文字」,並保留多條就擋。"""
    path = env.vault / home_rel
    try:
        lines, _, e = load_raw_for_edit(path)
    except (ValueError, RuntimeError) as ex:
        return None, None, None, f"{home_rel} 打不開:{ex}"
    want = (claim or "").strip()
    idx = None
    for i in range(1, e):
        m = PLANNED_RE.match(lines[i].strip())
        if not m:
            continue
        body = _PLANNED_TAIL_RE.sub("", m.group(1)).strip()
        if body != want:
            continue
        if idx is not None:
            return None, None, None, (f"{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條"
                                      "——先手動把重複的那行處理掉")
        idx = i
    if idx is None:
        return None, None, None, f"{home_rel} 裡找不到預告行『{want[:30]}』(被手改過或已經轉正?)"
    return lines, idx, e, None


def _guard_home_of(n):
    g = n.fields.get(GUARD_MARK_FIELD)
    if isinstance(g, list) and g:
        return str(g[0]).strip()
    return str(g or "").strip()


def _guard_touched_hits(files, touched):
    """家節點管的那些檔,跟這次改到的檔對得上哪幾個。回 (對上的清單, 是不是只在忽略大小寫時才對上)。

    ★比對鍵走既有那支★(代碼審 r2 架構席 blocker):about_code 的比對鍵全 repo 只有一個算法
    `_nodehome_key`(路徑正規化 + NFC),2026-09-10 那輪代碼審就是為了收斂「三處各寫一份、
    各版解得不一樣」才立的。第一版自己刻了一份,解不了 `a/../b`——而那正是這個 repo
    自己認證過、也修過一次的人手寫法,漏掉的話該擋的推送會安靜放行。

    在那之上多兩條**只會多擋、不會少擋**的保險:家節點寫的是資料夾(看底下的檔)、只有忽略大小寫
    才對得上。寫入端(`_about_code_path`)確實已經擋掉這兩種寫法(要求是檔案、大小寫要跟磁碟一致),
    所以走指令寫進去的不會踩到;留著是因為★寫入端的保證不等於讀取端的保證★——開頭欄位可以被手改,
    而這一層漏掉是沒人會發現的(多擋一次訊息會講清楚為什麼)。
    """
    tset = {_nodehome_key(x) for x in touched}
    tset.discard("")
    hits, only_case = [], []
    for raw in files:
        f = _nodehome_key(raw)
        if not f:
            continue
        if f in tset:
            hits.append(raw)
            continue
        under = sorted(x for x in tset if x.startswith(f + "/"))
        if under:
            hits.append(f"{raw}(底下的 {under[0]})")
            continue
        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上
        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。
        same = sorted(x for x in tset if x.lower() == f.lower())
        if same:
            hits.append(f"{raw}(大小寫不同:{same[0]})")
            only_case.append(raw)
    return hits, only_case


def _guard_touches(gn, env, touched):
    """這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。

    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):
    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。
    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。
    """
    if touched is None:
        return True, ""            # 沒給清單=CI 那一層,照舊全擋
    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點
    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。
    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]
    if not homes:
        return False, ";這篇沒寫它守的是哪篇功能節點,算不出有沒有碰到"
    files, found, missing, nocode = [], [], [], []
    for home in homes:
        hrel = env.find(home)
        hn = env.notes.get(hrel) if hrel else None
        if hn is None:
            missing.append(home)
            continue
        found.append(hrel)
        got = [str(x).strip() for x in as_list(hn.fields.get("about_code")) if str(x).strip()]
        if got:
            files += got
        else:
            nocode.append(hrel)
    # ★連結斷掉的那幾篇,不管這次擋不擋都要講★(代碼審 r2 通才席):
    # 半條算得出來、半條算不出來時,算不出來的那半原本會無聲消失,那條合約就一直帶著沒人發現的壞連結。
    broken = f"(另外 {'、'.join(missing)} 這幾篇找不到,連結可能斷了)" if missing else ""
    if not files:
        if missing and not found:
            return False, f";找不到它守的功能節點 {'、'.join(missing)},算不出有沒有碰到"
        return False, f";{'、'.join(nocode)} 沒寫它管哪幾支檔(about_code),算不出有沒有碰到{broken}"
    hits, only_case = _guard_touched_hits(files, touched)
    if hits:
        # ★只列解析得到的那幾篇★(代碼審 r2 通才席):這句話存在的目的是讓被擋的人知道去哪篇查,
        # 把找不到的節點也列進來,照著查的人會撲空。
        # ★收窄的粒度是「整篇家節點」不是「每條合約」★(代碼審 r1):同一篇掛兩條逾期合約時兩條都會擋。
        # 做得更細要讓每條合約自己記檔案清單(另一套資料);現在的代價是偶爾多擋一條,方向安全,
        # 但要讓人看得出來為什麼,不要變成無法解釋的誤擋。
        why = f";你這次改到 {'、'.join(hits[:3])}(它掛在 {'、'.join(found[:2])} 底下){broken}"
        if only_case and len(only_case) == len(hits):
            why += "——只有忽略大小寫才對得上,寧可多擋一次也不漏"
        return True, why
    return False, ("" if not broken else f";這次沒碰到它管的檔{broken}")


def cmd_guard_settle(env, ref, method):
    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過。"""
    if not IDENT_RE.match(method or ""):
        print(f"擋下:測試方法名『{method}』不合法(只能字母/數字/底線,不能數字開頭)", file=sys.stderr)
        return 2
    rel, n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    if str(n.fields.get("status")) != "pending":
        print(f"擋下:{rel} 現在是 {n.fields.get('status')},只有待完成的才能轉正", file=sys.stderr)
        return 2
    home = _guard_home_of(n)
    home_rel = env.find(home)
    if home_rel is None:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到", file=sys.stderr)
        return 2
    body = (env.vault / rel).read_text(encoding="utf-8")
    m = re.search(r"^預告的合約:(.+)$", body, re.M)
    claim = m.group(1).strip() if m else ""
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條", file=sys.stderr)
        return 2
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        print(f"擋下:{_err}", file=sys.stderr)
        return 2
    newline = f"  KEY:★INVARIANT★ {claim} [test:{method}]"
    try:
        atomic_write_verify(env.vault / home_rel, [*lines[:idx], newline, *lines[idx + 1:]],
                            f"[test:{method}]",
                            lambda f: f"[test:{method}]" in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:合約行換不過去,什麼都沒動: {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "status", "pass")
    print(f"✓ 轉正:{home_rel} 的預告行已換成正式合約並綁上 [test:{method}];{rel} 轉為已通過")
    print("  下一步:lumos guard audit 補獨立審計,推送前的閘會查")
    return rc


def _guard_signoff_refs(env):
    """簽核帳裡帶 --ref 的那些參照。"""
    import json as _j
    log = env.vault.parent / ".signoff-log.jsonl"
    refs = set()
    try:
        for ln in log.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                d = _j.loads(ln)
            except ValueError:
                continue
            r = str(d.get("ref") or "").strip()
            if r:
                refs.add(r)
                refs.add(r[:-3] if r.endswith(".md") else r)
    except OSError:
        pass
    return refs


def cmd_guard_abandon(env, ref, why):
    """棄置:留墓碑而不是刪掉。要有對得上的簽核紀錄——作用是留痕不是防偽造。"""
    if not (why or "").strip():
        print("擋下:棄置要寫 --why 說明為什麼決定不做了", file=sys.stderr)
        return 2
    rel, n = _guard_find(env, ref)
    if rel is None:
        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
        return 2
    refs = _guard_signoff_refs(env)
    stem = rel[:-3] if rel.endswith(".md") else rel
    if rel not in refs and stem not in refs:
        print(f"擋下:棄置一條預告的合約要有人簽核,帳上找不到對得上 {stem} 的紀錄", file=sys.stderr)
        print(f"  先簽核再來:lumos signoff {stem} --ref {stem} --note \"<為什麼決定不做>\"", file=sys.stderr)
        return 2
    home = _guard_home_of(n)
    home_rel = env.find(home)
    body = (env.vault / rel).read_text(encoding="utf-8")
    m = re.search(r"^預告的合約:(.+)$", body, re.M)
    claim = m.group(1).strip() if m else ""
    if not home_rel:
        print(f"擋下:守衛節點指名的功能節點 {home} 找不到——棄置前先把 guards 欄位指對,"
              "不然那篇的預告行會永遠留著,跟墓碑互相矛盾", file=sys.stderr)
        return 2
    if not claim:
        print(f"擋下:{rel} 裡讀不出預告的合約是哪一條(被手改過?)", file=sys.stderr)
        return 2
    lines, idx, _e, _err = _guard_planned_line(env, home_rel, claim)
    if lines is None:
        # ★找不到就擋,不靜默略過★(代碼審 r1 blocker):guards 被改指到別篇時,
        # 原本會靜默成功,真正的家節點永久留著一條沒人管的預告行。
        print(f"擋下:{_err}", file=sys.stderr)
        print("  棄置會把功能節點那行預告拿掉;對不到那一行就不知道該拿掉哪一條,不能硬做", file=sys.stderr)
        return 2
    try:
        atomic_write_verify(env.vault / home_rel, lines[:idx] + lines[idx + 1:],
                            "", lambda f: claim not in str(f.get("summary") or ""))
    except (ValueError, RuntimeError) as ex:
        print(f"擋下:功能節點的預告行拿不掉,墓碑也不立(不留半套): {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "status", "abandoned")
    print(f"✓ 已棄置:{rel} 立成墓碑(不是刪掉,下一個人看得到曾經打算做什麼、為什麼不做了)")
    return rc


def cmd_guard_required(env, as_json=False):
    """列必要集合現況:待完成幾條、逾期幾條、快到期幾條。"""
    import datetime
    today = datetime.date.today()
    rows, overdue, soon = [], [], []
    for rel, n in _guard_nodes(env):
        st = str(n.fields.get("status") or "")
        due = str(n.fields.get("due") or "").strip()
        home = _guard_home_of(n)
        owner = str(n.fields.get("owner") or "").strip()
        body = (env.vault / rel).read_text(encoding="utf-8")
        m = re.search(r"^預告的合約:(.+)$", body, re.M)
        claim = (m.group(1).strip() if m else rel)
        rows.append((rel, st, due, home, owner, claim))
        if st != "pending":
            continue
        try:
            d = datetime.date.fromisoformat(due)
        except ValueError:
            continue
        # ★到期當天不算過期,隔天才算★:最遲日期是人手寫的本地日期;
        # 誤擋一次的代價比漏擋一天高(設計審 r1)
        if d < today:
            overdue.append((rel, due, owner, claim))
        elif (d - today).days <= 7:
            soon.append((rel, due, owner, claim))
    pend = [r for r in rows if r[1] == "pending"]
    print(f"必要合約:待完成 {len(pend)}、逾期 {len(overdue)}、快到期(七天內) {len(soon)}、"
          f"已通過 {len([r for r in rows if r[1] == 'pass'])}、"
          f"已棄置 {len([r for r in rows if r[1] == 'abandoned'])}")
    for rel, due, owner, claim in overdue:
        print(f"  ✗ 逾期 {due}(負責人 {owner}):{claim}")
        print(f"      {rel} — 做完跑 lumos guard settle,不做了跑 lumos guard abandon(要先簽核)")
    for rel, due, owner, claim in soon:
        print(f"  ⚠ 快到期 {due}(負責人 {owner}):{claim}")
        print(f"      {rel}")
    if not overdue and not soon and pend:
        for _rel, _st, due, _home, owner, claim in pend:
            print(f"  · 待完成 {due}(負責人 {owner}):{claim}")
    return 1 if overdue else 0


