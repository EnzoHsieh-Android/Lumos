_BOOKKEEPING_DIRS = ("governance/code-loop/", "governance/review-reports/", "governance/replay/",
                     "governance/note-verdicts/")   # 2026-09-17 小改動閘 r2:卷證目錄也是紀錄不是碼(三個消費者共用這一組)
_PITFALL_DIFF_TEST_PAT = re.compile(r"(test_|_test\.|\.spec\.|/tests?/)", re.I)
LINT_CMD_TIMEOUT = 180


def _diff_added_lines(diff_text):
    """從 git diff -U3 輸出建 {file: set(new_line_numbers)} 對應所有新增行(+ 開頭)。
    使用與 _pitfall_diff_mode 相同的 @@ 標頭推導邏輯。"""
    added = {}
    cur_file, new_ln = "", 0
    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            cur_file = line[6:]
            continue
        m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
        if m:
            new_ln = int(m.group(1))
            continue
        if line.startswith("+++") or line.startswith("---"):
            continue
        if line.startswith("-"):
            continue                          # 刪除行不推進新檔行號
        if not line.startswith("+"):
            new_ln += 1                       # context 行推進
            continue
        # 這是新增行(+ 開頭)
        if cur_file:
            added.setdefault(cur_file, set()).add(new_ln)
        new_ln += 1                           # 新增行推進新檔行號


_NOTELINES_TABLE_SEP_RE = re.compile(r"^\s*[|:\-\s]*-[|:\-\s]*$")
_NOTELINES_RULE_RE = re.compile(r"^\s{0,3}(?:(?:-\s*){3,}|(?:\*\s*){3,}|(?:_\s*){3,})$")
_NOTELINES_BARE_LIST_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])(?:\s+\[[ xX]\])?\s*$")


def _notelines_structural_lines(text):
    """沒有主張、不審的行號集合(Projects/筆記內容審_計劃 [S4]):圍欄記號行(照 _visible_lines 認的)、表格分隔行、
    分隔線、只有清單記號的行。空白行本來就不收,不在這裡。"""
    lines = text.split("\n")
    kept = {i for i, _l in _visible_lines(lines, keep_fenced=True)}
    out = set()
    for i, ln in enumerate(lines, 1):
        if not ln.strip():
            continue
        if i not in kept or (_NOTELINES_TABLE_SEP_RE.match(ln) and "|" in ln) or _NOTELINES_RULE_RE.match(ln) \
                or _NOTELINES_BARE_LIST_RE.match(ln):
            out.add(i)
    return out


def _notelines_content_id(path, region, heading, line, done=False):
    """內容編號=(NFC 路徑、區塊、所屬小標題、去頭尾空白的行文字)的短雜湊;完成審多一個標記,不綁任何提交
    (Projects/筆記內容審_計劃 〈做法〉第 2 節)。"""
    import hashlib
    raw = "\0".join([nfc(path), region, heading, line.strip()] + (["完成審"] if done else []))
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]


def _ns_is_code(path, reader, files):
    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
    if path not in files:
        return False
    kind = _nodehome_code_kind(path)
    if kind == "ext":
        return True
    if kind != "shebang?":
        return False
    b = reader(path)
    return b is not None and _head_is_shebang(b[:200])


# 只放連結的指路行:連結裡不准有別名或段落(`[[目標|別名]]`、`[[目標#段落]]` 都能夾帶現況,代碼審 r2、r3 通才席);
# 分隔認中文常用的標點與連接詞(r3 外家席:原本把全形逗號打成半形,測試也用半形,假綠)
_NS_POINTER_ONLY_RE = re.compile(r"^(?:\s*(?:\[\[[^\]|#]+\]\]|見|→|,|\uff0c|、|\u3002|;|\uff1b|與|和|及|\||｜)\s*)*$")


def _ns_pin_ok(repo_root, p, lno, s):
    sha = _pin_commit(repo_root, s)
    return sha is not None and _validate_repo_ref(repo_root, p, lno, at_sha=sha)[0] == "ok"
_LENS_FB_HEADER = "圖譜沒有釘到節點——以下是 code 層的既有相依,審查員自己判(這段不是合約,不必逐條答)"
_LENS_FB_FOOT = "以上是機械反查,不是圖譜結論;命中不代表相依成立、沒命中不代表沒有"
_LENS_HIT_RATIO_MAX = 0.20
_LENS_CAND_CAP = 40


def _json_at_ref(repo_root, ref, rel_path, timeout=10):
    """從 git ref 讀 JSON(`git show <ref>:<path>`);沒有/壞→None。只信 base 的設定要靠它,不讀工作樹。"""
    import json as _json
    r = _lens_git(repo_root, "show", f"{ref}:{rel_path}")
    if r is None or r.returncode != 0:
        return None
    try:
        d = _json.loads(r.stdout)
        return d if isinstance(d, dict) else None
    except ValueError:
        return None


def _lens_py_defs(text):
    """base 版 python 原文→頂層 def/class 的 [(name, start, end)](含裝飾器行);parse 失敗回 None。標準庫 ast,沿 slim-gen/slim-scan 先例。"""
    import ast as _ast
    try:
        tree = _ast.parse(text)
    except (SyntaxError, ValueError):
        return None
    out = []
    for node in tree.body:
        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef, _ast.ClassDef)):
            start = min([node.lineno] + [d.lineno for d in getattr(node, "decorator_list", [])])
            end = getattr(node, "end_lineno", node.lineno) or node.lineno
            if _LENS_IDENT_RE.match(node.name):
                out.append((node.name, start, end))
    return out


def _lens_hunks_base_ranges(repo_root, base_sha, head_sha, path, timeout=10):
    """`git diff -U0 base head -- path` 的 - 側行範圍 [(a, a+b-1)];純新增 b=0 不產生範圍(另計);整檔刪除回 ('deleted', n)。"""
    r = _lens_git(repo_root, "diff", "--no-ext-diff", "--no-textconv", "-U0",
                  base_sha, head_sha, "--", path, quote=True)
    if r is None or r.returncode != 0:
        return [], 0, False
    ranges, pure_add = [], 0
    deleted = False
    for m in re.finditer(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", r.stdout, re.M):
        a = int(m.group(1)); b = int(m.group(2)) if m.group(2) is not None else 1
        c = int(m.group(3)); d = int(m.group(4)) if m.group(4) is not None else 1
        if b == 0:
            pure_add += 1; continue
        if c == 0 and d == 0:
            deleted = True
        ranges.append((a, a + b - 1))
    return ranges, pure_add, deleted


def _lens_fallback(root, base_sha, head_sha, changed_files, base_tree, base_modes, deadline, cache_note=""):
    """固定席 0 篇時的既有相依三格。全部只用 base 樹;每格算完即定稿;超時保留已算好的格。
    回 (lines, status, meta)。"""
    import time as _time
    def left():
        return deadline - _time.monotonic()

