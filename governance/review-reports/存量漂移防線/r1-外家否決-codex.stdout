 29399	def _lens_py_defs(text):
 29400	    """base 版 python 原文→頂層 def/class 的 [(name, start, end)](含裝飾器行);parse 失敗回 None。標準庫 ast,沿 slim-gen/slim-scan 先例。"""
 29401	    import ast as _ast
 29402	    try:
 29403	        tree = _ast.parse(text)
 29404	    except (SyntaxError, ValueError):
 29405	        return None
 29406	    out = []
 29407	    for node in tree.body:
 29408	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef, _ast.ClassDef)):
 29409	            start = min([node.lineno] + [d.lineno for d in getattr(node, "decorator_list", [])])
 29410	            end = getattr(node, "end_lineno", node.lineno) or node.lineno
 29411	            if _LENS_IDENT_RE.match(node.name):
 29412	                out.append((node.name, start, end))
 29413	    return out
