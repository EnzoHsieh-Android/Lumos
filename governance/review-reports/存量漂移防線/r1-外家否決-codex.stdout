DATE_KEYS = {"updated", "created", "date", "decided", "ended"}
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def fm_structure(fm_lines):
    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
    end = 該 key 區塊最後一行的 index(含)。"""
    out = []
    i, n = 0, len(fm_lines)
    while i < n:
        m = TOP_KEY_RE.match(fm_lines[i])
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        start = i
        if val in ("|", "|-", ">", ">-"):
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "block"))
        elif val == "":
            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
            i += 1
            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
                i += 1
    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
    import os as _os, shutil as _sh, uuid as _uuid
    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
    try:
        with _os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
        if path.exists():
            _sh.copymode(path, tmp)
        _os.replace(tmp, path)
    except BaseException:
        try:
            _os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_write_verify(path: Path, new_lines, key, expected_check):
    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
    orig_fm = load_raw_for_edit(path)
    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
    text = "\n".join(new_lines)
    new_fm_lines = new_lines[1:]
    for i in range(1, len(new_lines)):
        if new_lines[i].strip() == "---":
            new_fm_lines = new_lines[1:i]
            break
    fields, _, new_lint = parse_frontmatter(new_fm_lines)
    if not expected_check(fields):
        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
    introduced = set(new_lint) - orig_lint
    if introduced:
        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)


_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己


_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)


def _vault_lock_where(vault):
    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。

    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。

    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
    互斥照樣成立。

    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
    """
    import hashlib
    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    return primary, None


def _vault_lock_say(lock, why):
    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
          file=sys.stderr)
    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)


def _vault_write_lock(vault):
    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。

    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
    import contextlib, time as _t

    @contextlib.contextmanager
    def _cm():
        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
        lock, why = _vault_lock_where(vault)
        k = str(lock)

        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
            _VAULT_LOCK_HELD[k] += 1
            try:
                yield
            finally:
                _VAULT_LOCK_HELD[k] -= 1
            return

        if why and not _VAULT_LOCK_WARNED.get(k):
            _VAULT_LOCK_WARNED[k] = True
            _vault_lock_say(lock, why)
        deadline = _t.monotonic() + 60
        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
            if _t.monotonic() > deadline:
                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
            _t.sleep(0.05)
        _VAULT_LOCK_HELD[k] = 1
        try:
            yield
        finally:
            _VAULT_LOCK_HELD.pop(k, None)
            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
                    lock.unlink()
            except OSError:
                pass
    return _cm()


def cmd_set(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_set_locked(env, rel, key, value)


def _cmd_set_locked(env, rel, key, value):
    if key in COND_KEYS:
        return _set_conditions_locked(env, rel, key, value if isinstance(value, list) else [value])
    if isinstance(value, list):
        if len(value) != 1:
            print(f"擋下:{key} 只收一個值,你給了 {len(value)} 個,檔案沒動(給多個值只有 {'、'.join(COND_KEYS)} 收)",
                  file=sys.stderr)
            return 2
        value = value[0]
    if key not in SCALAR_KEYS:
        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)},"
              f"以及整欄換掉的 {'、'.join(COND_KEYS)}"
              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
        return 2
    # ★負責範圍跟新開節點用同一支判斷、同樣擋★(筆記欄位關卡補齊_計劃 S11;不看開關——r3 架構席:
    # 同一個欄位的兩個寫入口擋法要一樣;原本只有 new 擋,set 可以寫進一個字)
    if key == "responsibility" and not _nodehome_resp_ok(value):
        print(f"擋下:負責範圍至少 {_NODEHOME_RESP_MIN_CHARS} 個字、要有實字(一句話講這篇負責什麼、不負責什麼),檔案沒動",
              file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    new_fm = edit_fm_scalar(lines[1:e], key, value)
    exp = fmt_scalar(key, value)
    exp_val = strip_quotes(exp)
    tag_synced = False
    if key == "status":
        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
    new_lines = lines[:1] + new_fm + lines[e:]

    def _check(f):
        if str(f.get(key, "")) != exp_val:
            return False
        if tag_synced:
            want = f"status/{exp_val}"
            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
            return want in tags and all(t == want for t in tags if t.startswith("status/"))
        return True

    atomic_write_verify(path, new_lines, key, _check)
    print(f"✓ set {rel}: {key} 已改成 {exp}" + ("(狀態標籤 status/* 也同步改了)" if tag_synced else ""))
    return 0


def _set_conditions_locked(env, rel, key, values):
    """驗收紀錄的前提/回頭條件整欄換掉(Projects/驗收前提欄位可改_計劃)。

    ★為什麼整欄換、不走 append/remove★:這兩欄是散文、常提到連結;append/remove 判斷「同一項」看連結目標,
    兩條提到同一篇的不同條件會被當成重複。原本四種寫法(單行、清單、空的、多行區塊)並存,一律整段拿掉重寫。"""
    vals = [str(v).strip() for v in values]
    if not vals or any(not v for v in vals):
        print(f"擋下:{key} 的每一條都不能是空的,檔案沒動(前提寫這個結論在什麼情況下才算數,回頭條件寫改到什麼該重驗)",
              file=sys.stderr)
        return 2
    if any("\n" in v or "\r" in v for v in vals):
        print(f"擋下:{key} 一條條件只能一行,檔案沒動(要寫多條就給多個值:lumos set <筆記> {key} \"條件一\" \"條件二\")",
              file=sys.stderr)
        return 2
    path = env.vault / rel
    lines, _s, e = load_raw_for_edit(path)
    fm = list(lines[1:e])
    new = ([f"{key}: {fmt_scalar(key, vals[0])}"] if len(vals) == 1
           else [f"{key}:"] + [f"  - {fmt_scalar(key, v)}" for v in vals])
    struct = {k: (a, b) for k, a, b, _kind in fm_structure(fm)}
    if key in struct:
        a, b = struct[key]
        fm[a:b + 1] = new
    else:   # 插的位置照 edit_fm_scalar:第一個清單或多行區塊欄位之前,都沒有就放最後
        at = next((a for _k, a, _b, kind in fm_structure(fm) if kind in ("list", "block")), len(fm))
        fm[at:at] = new
    atomic_write_verify(path, lines[:1] + fm + lines[e:], key, lambda f: _conds(f.get(key)) == vals)
    print(f"✓ set {rel}: {key} 整欄換成 {len(vals)} 條" + ("" if len(vals) == 1 else "(一行一項的清單)"))
    return 0


def cmd_self_audit(env, rel, model="sonnet", date=None):
    """L4 自足性審計留痕:寫 self_audit: <model>/<date> 到節點 frontmatter。
    語意:這整篇節點的「自足性」(無主對話脈絡的乾淨 agent 只讀圖譜能不能還原
    專案現況)已由一個獨立 agent 審過並通過。對應 guard audit 的角色(乾淨 agent
    審後蓋戳),但程式路徑獨立——這是節點級戳記,guard audit 是行級 [audit:]。
    工具只記留痕,不證明審計真乾淨——派 agent 的乾淨脈絡/中立 prompt 靠主對話誠實。"""
    import datetime
    if date is None:
        date = datetime.date.today().isoformat()
    else:
        try:
            datetime.date.fromisoformat(date)
        except ValueError:
            print(f"擋下:--date 要寫成 年-月-日(例如 2026-08-22),你給的是 {date!r}", file=sys.stderr)
            return 2
    return cmd_set(env, rel, "self_audit", f"{model}/{date}")


def _disk_spelling(root, relp):
    """relp 每一層照磁碟上的真實檔名拼回來(大小寫、Unicode 寫法以磁碟為準;只差 Unicode 寫法的算同一個)。
    回 (真實拼法, None);某一層目錄讀不到檔名清單回 (None, 那一層目錄)——擋不擋由呼叫端決定。"""
    cur, real = root, []
    for part in relp.split("/"):
        try:
            names = os.listdir(cur)
        except OSError:
            return None, ("/".join(real) or ".")
        hit = part if part in names else next((n for n in names if nfc(n) == nfc(part)), None)
        if hit is None:
            hit = next((n for n in names if nfc(n).casefold() == nfc(part).casefold()), part)
        real.append(hit)
        cur = cur / hit
    return "/".join(real), None


def _about_code_key(root, value):
    """about_code 一項「指的是哪一支檔」的比對鍵(append 去重、remove 找項共用)。
    檔案還在:用磁碟上的真實位置——解 symlink、大小寫與 Unicode 寫法照磁碟(2026-09-10 代碼審 r3:
    只做字面正規化時,symlink 別名、舊的大小寫錯字項都會被當成另一支檔,疊出重複又刪不掉);
    檔案不在了:退回字面正規化(remove 要清得掉檔已刪的舊項)。比較一律用 NFC。"""
    lex = _posix_norm(strip_quotes(str(value).strip()))
    if not lex:
        return ""
    try:
        target = (root / lex).resolve()
        rel = target.relative_to(root).as_posix()
    except (ValueError, OSError):
        return nfc(lex)
    if not target.is_file():
        return nfc(lex)
    real, _ = _disk_spelling(root, rel)
    return nfc(real or rel)


def _about_code_path(env, value):
    """about_code 的一項要是「這個 repo 裡真的存在的程式檔」(2026-09-10 代碼審 r1)。

    回 (正規化後的 repo 相對路徑, None) 或 (None, 擋下的理由)。
    ★先解析再比對 repo 根★:只看「存不存在」的話,絕對路徑與 ../ 都會繞出 repo 而且通過;
    存成正規化的樣子,排序加分用的鍵才對得上(src/../src/a.py 跟 src/a.py 要是同一個)。"""
    v = str(value).strip().replace("\\", "/")   # Windows 反斜線寫法也收(r3 邊界席:原本永遠「找不到」)
    if not v:
        return None, "about_code 不能是空的"
    if Path(v).is_absolute():
        return None, f"about_code 要寫 repo 相對路徑,「{v}」是絕對路徑"
    root = _vault_repo_root(env).resolve()
    target = (root / v).resolve()
    try:
        relp = target.relative_to(root).as_posix()
    except ValueError:
        return None, f"「{v}」跑出這個 repo 了(repo 根是 {root})"
    if not target.is_file():
        return None, (f"「{v}」不是這個 repo 裡的檔案" + ("(它是目錄;about_code 要寫到檔案)" if target.is_dir() else "(找不到)"))
    # ★筆記不是程式檔★(筆記欄位關卡補齊_計劃 S14):有一篇 Issue 就是用 append 把一篇筆記路徑寫進 about_code;
    # 要連結別篇筆記請寫進 related,about_code 只放這篇管的程式檔。
    try:
        target.relative_to(env.vault.resolve())
        return None, f"「{v}」在圖譜資料夾裡,是筆記不是程式檔——要連結別篇就寫進 related"
    except ValueError:
        pass
    # ★大小寫要跟磁碟上的真實檔名一致★(r2):排序加分拿這個值去比對 git 的改動路徑(大小寫敏感);
    """把一行代碼裡的字串字面挖空(保留引號),讓 pitfalls 的 open(/UPDATE 正則只看真代碼——
    print("…open(…") 這種訊息文字不算資源風險(#7)。單行粗剝,跨行字串不處理(剝不掉就照掃,寧誤傷不漏)。"""
    return _PITFALL_STRLIT_RE.sub('""', code)

# 簿記檔白名單(單一源,兩個消費者:pitfalls --diff 掃描排除 + code-loop 留痕失效豁免)。
# 兩處分開寫過會漂移;pitfalls 這端 2026-08-11 才補上——治理帳裡記的 skip 理由本身在
# 描述「命中 open(...)」,被當代碼掃就再次命中 → 再 skip → 再寫一行理由……自我餵食,
# 實測誤觸發 9 次。這些檔是紀錄不是要合入的碼。
_BOOKKEEPING_FILES = ("docs/.governance-log.jsonl", "docs/.usage-log.jsonl",
                      "docs/.ci-log.jsonl", "docs/.canary-log.jsonl",
                      "docs/.bypass-log.jsonl", "docs/.escape-log.jsonl",
                      "docs/.kill-log.jsonl", "docs/.signoff-log.jsonl",
                      "governance/anchor-baseline.json")
# ↑ canary-log/bypass-log 2026-08-27 補（[[Issues/簿記白名單漏canary與bypass帳]] 死結根治）:
# 審計記帳(canary record)在 loop 中發生,pass 後提交它們原本會讓留痕失效→擋推。
# ★真效果只在 code-loop 留痕豁免這第二消費者★:pitfalls 那端 canary-log 早被
