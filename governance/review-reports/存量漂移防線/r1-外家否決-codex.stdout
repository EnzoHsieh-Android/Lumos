  {doctor,links,backlinks,context,show,contracts,lint,gov,about-code,canary,report-normalize,loop,guard,spec-gate,spec-trace,signoff,sync-verified-by,search,map,decisions,stale,query,recent,stats,export,set,append,drift-history,remove,self-audit,new,decision-supersede,decision-amend,decision-reindex,rel-cascade,decision-add,decision-refs,install,uninstall,archive,update,bootstrap,init,deinit,teardown,fold-check,prose-lint,refcheck,handoff,dispatch-lens,impact,pitfalls,ci-wait,ci-status,testmap,test-layers,lint-check,lint-waive,rule-check,rule-gap,sqlfluff-sarif,stylelint-sarif,dart-sarif,anchor,enforcement,quote-check,link-candidates,severity-check,seat-check,lint-watch,compose-metrics,cochange,home,note-shape,note-audit,delguard,code-loop,bound-tests}
