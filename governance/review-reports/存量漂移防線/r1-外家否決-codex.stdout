    # 安全:不執行 shell、不 eval;只用 python re + fnmatch 掃 repo,有檔數/位元組上限,
    # 壞正則吞成單條提示不炸 doctor。
    # ── Check Y:被提及符號的存在性(成因 D「寫的時候就錯」)──
    # 與 delguard 的分工:delguard 驗「被刪的符號圖譜還在講」(diff-based,只在 commit 時);
    # 本檢查驗「圖譜提到的符號 repo 裡有沒有」(全量,寫錯當下就抓)——★code 從沒變過也抓得到★,
    # 那正是成因 D(diff-based 機制結構上無效的那一類)。
    # 首發實績:2026-08-12 抓到 [[活動報名]] 寫 `ActivityService.RegisterAsync`,實際是
    # SubmitRegistrationAsync——★這條在同日 10 個 agent 的兩階段交叉審計中被漏掉★
    # (實證員驗了行為、沒挑方法名)。
    # ★噪音實測(LandmarkMember 30 篇 Systems)★:
    #   寬鬆抽法(任何 PascalCase inline code)→ 930 候選 / 74 未命中(7%),抽樣多為環境變數名
    #   (ADMIN_LOG_VIEWER_KEY)、DB 欄位(TBmemberdisc.WelcomeCouponNo)、會員編號範例、
    #   別 repo 頁面(MemberDisc.aspx) = 精度極差;
    #   收緊成「方法/類別形狀」(無底線/無數字/非全大寫/無副檔名,且 以 Async 結尾 或 帶點)
    #   → 279 候選 / 1 未命中(0.4%),★該 1 條是真陽性★。
    section("Y", "筆記點名的方法或類別,程式碼裡找不找得到(寫錯或已改名;提醒,不擋)")
    if repo_root is None:
        ok("(這個專案沒有 docs/ 資料夾,符號檢查跳過)")
    else:
        _yprof, _yneg = load_symbol_profile(repo_root)
        _sym_re = re.compile(_yprof["shape_re"])
        _ext_re = re.compile(r"\.(aspx|html|cs|js|vue|sql|ps1|yml|json|md|kt|py)$", re.I)
        _sufs, _dot_ok = tuple(_yprof.get("suffixes") or ()), _yprof.get("dotted_ok", True)

        def _is_symbol_shaped(s):
            """方法/類別形狀(★由 symbol_profile 決定,不寫死語言慣例★)。
            共通排除:含底線/斜線/空白、有副檔名、帶數字(範例 ID)、全大寫(環境變數)。
            ★注意★:python profile 的 shape_re 允許底線,故底線排除只在 shape_re 不允許時才成立
            ——這裡改成先跑 shape_re,再套「非全大寫/無數字/無副檔名」的通用雜訊排除。"""
            if "/" in s or " " in s or _ext_re.search(s):
                return False
            if any(c.isdigit() for c in s) or s.isupper():
                return False
            if not _sym_re.match(s):
                return False
            if _sufs and any(s.endswith(x) for x in _sufs):
                return True
            return _dot_ok and "." in s

        _hay = build_code_haystack(repo_root)
        _ghosts, _seen = [], set()
        # ★只掃 Systems★:語意上只有它宣稱「現在長怎樣」。
        # Projects 提的是「打算做的方法」(還沒寫)、Verification/Issues 記的是歷史狀態
        # (當時存在、現已移除)——對那些節點報「repo 查無」是誤報而非發現。
        # 實測佐證:全型別掃 → 37 命中(多為計劃中的未來方法/已移除的歷史方法);
        # 限 Systems → 1 命中且為真陽性。
        for rel, n in sorted(notes.items()):
            if n.fields.get("type") != "system":
                continue
            try:
                text = (env.vault / rel).read_text(encoding="utf-8-sig")
            except OSError:
                continue
            # ★否定語境豁免★:節點常常「正確地記錄某符號已不存在」
            # (例:「`RefundPointsAsync` 全庫零命中」「已移除 `GetRollingTotalAsync`」)。
