        except Exception:
            continue
        if _err or not _rows:
            continue
        # ★懸空的定義要跟 spec-trace 自己算的一致★(代碼審 r1 正確性席 major):
        # 第一版我手抄成三個字串,其中兩個根本不存在於 _CLAUSE_STATE_ZH,
        # 是憑空造的死分支;而真正也算懸空的
        # unrecognized(設定認不到)與 mentioned(只被提到)反而漏掉。
        # ★同一件事兩套算法必定分岔★——這正是這批自己 [S11] 要防的事,
        # 我卻在實作時犯了同一個錯。改成引用同一組常數,不再手抄。
        _bad = [r for r in _rows if r.get("state") in _CLAUSE_HANG_STATES]
        if _bad:
            _ids = ", ".join(str(r.get("clause") or r.get("id") or "?") for r in _bad[:4])
            _dangling.append(f"{rel} ({len(_bad)} 條:{_ids})")
            gov_events.append({"gate": "check-s5", "kind": "warned", "hard": False, "nodes": [n.stem]})
    if not _dangling:
        ok("計劃條款寫的測試名,程式碼裡都找得到")
    else:
        _soft_list(_dangling,
                   f"有 {len(_dangling)} 份計劃的條款寫了測試名,但程式碼裡找不到那支測試:",
                   "逐份跑 `lumos spec-trace <計劃節點>` 看是哪幾條;測試名寫錯就改名字,測試根本沒寫就補寫——★計劃寫了測試名不等於測試存在★")
