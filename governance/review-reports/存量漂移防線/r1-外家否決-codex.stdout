exec
/bin/zsh -lc "sed -n '830,950p' scripts/lumos
sed -n '4740,4970p' scripts/lumos
sed -n '5180,5285p' scripts/lumos
sed -n '6580,6630p' scripts/lumos
sed -n '11160,11280p' scripts/lumos
sed -n '11420,11940p' scripts/lumos" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-ns
 succeeded in 0ms:
        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
        if gl.exists():
            for line in gl.read_text(encoding="utf-8").splitlines():
                try:
                    o = _j.loads(line)
                except ValueError:
                    continue
                if not isinstance(o, dict):
                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
                        and _pat.search(str(o.get("note", ""))):
                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
    except OSError:
        pass
    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
    if chain_prev:
        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
    print("  之後查血緣:")
    print("    lumos gov --stats")
    return 0


def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
                ref=None, nodes=None, extra=None):
    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。

    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。

    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
    逐 ref 的事件另外帶那一行真正的 sha。

    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
    """
    import json as _json
    import datetime as _dt
    root = Path(repo_root)
    docs = root / "docs"
    if not docs.is_dir():
        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
        return None
    if not head_sha:
        try:
            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
        except Exception:
            head_sha = ""
    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
    if gate not in _KNOWN_GATES:
        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
              file=sys.stderr)
        return False
    ev = {
        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "commit": (head_sha or "")[:7],
        "gate": gate, "kind": kind, "hard": bool(hard),
        "nodes": list(nodes or []), "note": note,
        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
        "detail": note,
    }
    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
    if att:
        ev["attempt_id"] = att[:64]
    if ref:
        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
        # 「目前不算功能性錯誤——新事件本來就不該被當成 marker」。
        # ★那句話講的是一個保護,不是一個不一致★——我第一次折的時候把它當成欄名不一致、
        # 順手加了 branch 別名,結果 blocked 事件當場被 _codeloop_read_from_ledger
        # 當成留痕讀走,既有測試翻紅。欄名對齊只做 note/detail 那一半,分支識別不對齊。
        ev["ref"] = ref
    if head_sha:
        ev["head_sha"] = head_sha
    if extra:
        ev.update(extra)
    try:
        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
        return True
    except OSError:
        return False


def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
    ok = _gate_event(repo_root, gate, kind, note, **kw)
    if ok is None:
        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
    if not ok:
        print(f"  ⚠ telemetry-write-failed:{gate} 這一筆帳寫不進去(判定不受影響,照原樣執行)",
              file=sys.stderr)
    return ok


def _sp_run_text(cmd):
    import subprocess as _sp
    return _sp.run(cmd, capture_output=True, text=True, errors="replace").stdout.strip()


    print(f"{'commit':10} {'date':11} {'節點':>4} {'候選':>5} {'幽靈':>5}  持續中的幽靈符號")
    for r in rows:
        print(f"{r['sha']:10} {r['date']:11} {r['notes']:4} {r['candidates']:5} "
              f"{len(r['ghosts']):5}  {', '.join(r['ghosts'][:4])}")
    persist = set(rows[0]["ghosts"])
    for r in rows[1:]:
        persist &= set(r["ghosts"])
    print()
    if persist:
        print(f"在全部 {len(rows)} 個取樣點都出現的幽靈符號(筆記點名但程式碼裡沒有):{', '.join(sorted(persist))}")
        print("  → 規律成立:這不是偶發,是穩態。這型 drift 值得開機械檢查(見 Check Y)。")
    elif any(r["ghosts"] for r in rows):
        print("幽靈符號有出現但非持續 → 有人在修,但沒有機制擋住它再發生。")
    else:
        print("所有取樣點都 0 幽靈 → 這個專案沒有這型 drift,"
              "或者是符號比對規則沒對上你的語言(先確認候選數不是 0)。")
    return 0


_KNOWN_FRONTMATTER_KEYS = (
    "type", "status", "tags", "summary", "created", "updated", "related", "aliases",
    "valid_under", "revalidate_when", "plan_refs", "date", "decisions", "verified_by",
    "about_code", "about_code_stamp", "self_audit", "feature", "commit",
    "decision_refs", "decision_refs_ai", "pitfall_when", "pitfall_ask", "pitfall_source",
    "signed_off", "kill_recipes", "core_refs", "regen",
    "responsibility", "lands_in",   # 2026-09-11 每支檔有家:Systems 的負責範圍、計劃的落點
    "guards", "due", "owner", "phases",   # 2026-09-22 預告合約:守衛節點的四個欄位(不登記的話這機制產的每篇節點都被唸欄位名打錯)
    "plan_risk", "door",   # 2026-09-17 計劃風險(作者只能往嚴標 high);door 是舊寫法,讀得懂但提醒改
)
# ↑ 2026-09-06 全 repo 審視 #16。★代碼審 r1 訂正★:初版清單來源是「掃本 vault 428 篇出現過的鍵」,
#   結果漏掉 core_refs(跨專案升格參照,doctor Check C 與 impact 跨 repo 展開都在讀)與 regen(重建溯源在讀)
#   ——這兩個欄位工具確實會讀,只是本 vault 目前沒節點寫,於是掃不到、被誤報成「不認得」。
#   正解是問工具認得哪些,不是問這個 vault 長怎樣:下面 cmd_lint 另在執行期併入 LIST_KEYS/LINK_KEYS,
#   那兩份常數再新增欄位時這裡不必跟著改。
#   ★這是軟提醒不是白名單硬擋★——別的 vault 有自己的欄位(consumer 專案、core-knowledge 的
#   project/implements/domain 等),所以留 .lumos/config.json 的 extra_frontmatter_keys 可擴充。


def _lumos_config_near_vault(env):
    """從 vault 往上找 .lumos/config.json 讀成 dict;找不到、讀不了、不是物件都回 {}(lint 側的擴充口
    一律 fail-open)。extra_frontmatter_keys 與 scope 值域兩個宣告共用這一支,免得兩套搜尋規則各漂各的。"""
    import json
    try:
        # ★r1 代碼審折入★:原本寫死「vault 往上兩層」,vault 巢得更深(monorepo 的
        # repo/subdir/docs/x-knowledge)就算到 repo/subdir/.lumos,擴充口悄悄失效且不報錯。
        # 改成從 vault 往上找設定檔本身;走到版控根就停(找不到 .git 時最多五層),
        # 免得爬到家目錄撿到別的專案的設定。
        base = Path(env.vault).resolve()
        cfg = None
        for hop, cand in enumerate((base, *base.parents)):
            probe = cand / ".lumos" / "config.json"
            if probe.is_file():
                cfg = probe
                break
            if (cand / ".git").exists() or hop >= 5:
                break
        if cfg is not None:
            data = json.loads(cfg.read_text(encoding="utf-8"))
            return data if isinstance(data, dict) else {}
    except Exception:
        pass
    return {}


def _extra_fm_keys(env):
    """讀 .lumos/config.json 的 extra_frontmatter_keys(消費專案自己的合法欄位)。讀不到就空。"""
    v = _lumos_config_near_vault(env).get("extra_frontmatter_keys")
    return [x for x in v if isinstance(x, str)] if isinstance(v, list) else []


def _scope_policy(env):
    """讀 .lumos/config.json 的 scope 區塊 {"values": [...], "required": bool}。

    [工具分類 2026-09-08,plan:Projects/工具分類_計劃] scope/ 標籤家族的值域由專案自己宣告——
    工具鏈自己用九個研究方向值、消費專案用業務域切片,兩邊語意不同,所以不能在程式裡寫死一張表。
    沒宣告(絕大多數消費專案)回 None,lint 對 scope 一個字都不說,行為與 2026-08-05 收編定版時相同。"""
    sc = _lumos_config_near_vault(env).get("scope")
    if not isinstance(sc, dict):
        return None
    vals = sc.get("values")
    if not isinstance(vals, list):
        return None
    return {"values": {x for x in vals if isinstance(x, str)}, "required": bool(sc.get("required", True))}


def _levenshtein_le1(a, b):
    """只判「編輯距離 ≤1」(打錯一個字的近名候選)——不做完整距離計算,夠用且便宜。"""
    if a == b:
        return False
    la, lb = len(a), len(b)
    if abs(la - lb) > 1:
        return False
    if la == lb:
        return sum(1 for x, y in zip(a, b) if x != y) == 1
    short, long_ = (a, b) if la < lb else (b, a)
    for i in range(len(long_)):
        if long_[:i] + long_[i + 1:] == short:
            return True
    return False


def cmd_lint(env, node):
    """單檔快檢:寫完一個節點立刻自驗標籤/格式(node-local,不掃 repo → 比 doctor 快;
    例外:regen 節點的 Check J 需檔案+git 存取,opt-in、量小)。
    抓「寫入當下」最常見的錯:type/summary 缺漏、★ 標記格式錯(漏被 contracts 抓)、
    裸合約 / 未審、symbol 行 typo、frontmatter 指紋(ghost trap…)。
    與 doctor 分工:doctor 是全圖權威(跨節點完整性 + [test:] 存在性),lint 只看這一篇、
    predicts pre-push 會不會擋(error 即 doctor --ci 會擋的同類)。"""
    rel = env.find(node)
    if rel is None:
        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
        return 2
    errs, warns = _lint_collect(env, rel)
    # ★這次新增的欄位規則擋不擋看專案開關★(筆記欄位關卡補齊_計劃;原有規則不受開關影響,S13)
    # 從跟「每支檔有家」同一個 repo 根讀(往上找 .git;代碼審 r1:圖譜在 repo 根、巢狀、monorepo 深層都曾讀錯)
    _nlc = _note_lint_config(_vault_repo_root(env))
    mode, cfg_warns = _nlc["mode"], _nlc["warnings"]
    for _cw in cfg_warns:
        print(f"⚠ {_cw}", file=sys.stderr)
    if mode != "off":
        new = _lint_new_rules(env, rel)
        if mode == "on":
            errs.extend(new)
        else:
            warns.extend(f"{x}(專案開關 note_lint.gate 是 warn,先提醒不擋)" for x in new)
    if not errs and not warns:
        print(f"✓ lint {rel} — 0 問題")
        return 0
    print(f"lint {rel}")
    for e in errs:
        print(f"  ✗ {e}")
    for w in warns:
        print(f"  ⚠ {w}")
    print(f"\n{len(errs)} error / {len(warns)} warning"
          + ("(error 不修,提交會被擋)" if errs else "(warning 不擋,但建議順手補)"))
    return 1 if errs else 0


def _lint_collect(env, rel):
    """lint 原有的判定(不含這次新增、看開關的欄位規則):回 (錯誤清單, 提醒清單)。
    `lumos lint` 與健檢 L 段都呼叫這支,不另寫一份規則(筆記欄位關卡補齊_計劃,r3 架構席)。"""
    n = env.notes[rel]
    errs = list(n.lint)          # frontmatter 指紋(ghost trap / 重複鍵 / 日期引號…)= error
    warns = []

    # ★驗證紀錄的兩個條件欄空著要出聲★(2026-09-16;Issues/lint不守驗證紀錄空回頭條件,
    # 2026-09-01 Enzo 委任裁辦)。出身:某天五篇驗證★全★把回頭條件寫進正文、欄位留空,
    # 於是掃描工具全掃不到、lint 全綠放行——鐵則四「承認風險要附回頭看的條件」被靜默架空
    # 而沒有任何機械提醒,是審查席讀出來的、不是工具抓到的。
    # ★只提醒不擋★:舊帳很多(上線當天光是排序那一篇就掛著五份空條件的驗證),擋了等於
    # 每個提交都紅;提醒的作用是讓寫的人當下看到,不是回頭清舊帳。
    # ★只對 pass 的驗證紀錄★:其他型別沒有這兩個欄位;stale/fail 本來就還在處理中,不必催。
    if n.fields.get("type") == "verification" and n.fields.get("status") == "pass":
        for _f, _what in (("valid_under", "這個結論在什麼前提下才算數"),
                          ("revalidate_when", "改到什麼時候該回頭重驗")):
            # ★用掃描端同一支 helper 判空★(2026-09-16 代碼審 r1 外家席):直接轉字串的話,
            # 一個裝著兩個空白字串的清單會變成有括號有引號的非空字串、被判成「有寫」,
            # 但掃描端逐項去空白之後拿到的是零條——兩邊口徑不一樣就等於這道提醒有洞。
            if not _conds(n.fields.get(_f)):
                warns.append(f"{_f} 是空的——沒寫「{_what}」,"
                             f"掃描工具就永遠掃不到這篇,這個結論會一直被當成還有效")

    # ★開頭欄位鍵打錯會被所有檢查靜默略過★(2026-09-06 全 repo 審視 #16):
    # 打成 valid_unde / verifed_by,lint 一句話都不說、doctor 也看不到,那個欄位等於沒寫。
    # ★只給軟提醒不升 error★:工具對未知欄位的立場是「前向相容、容忍」(消費專案與
    # core-knowledge 各有自己的欄位),升成 error 會讓別人的 vault 每次 lint 都被嘮叨。
    # 清單可用 .lumos/config.json 的 extra_frontmatter_keys 擴充。
    _known = set(_KNOWN_FRONTMATTER_KEYS) | set(LIST_KEYS) | set(LINK_KEYS) | set(_extra_fm_keys(env))
    _unknown = [k for k in n.fields.keys() if k not in _known]
    for _k in _unknown:
        _near = sorted(c for c in _known if _levenshtein_le1(_k, c))   # r1:_known 是 set,不排序的話多個等距候選每次給的建議會漂
        _hint = f"——是不是想寫 {_near[0]}?" if _near else "——工具不認得這個欄位,它不會被任何檢查讀到"
        warns.append(f"開頭欄位有個沒見過的鍵『{_k}』{_hint}(真的要用就加進 .lumos/config.json 的 extra_frontmatter_keys)")
    _pr = n.fields.get("plan_risk")
    if _pr is not None and str(_pr).strip() not in ("high", "low"):
        warns.append(f"plan_risk 只認 high / low,你寫的是 {str(_pr)!r}(規格閘會當沒寫;low 寫了也不會比機械判定更鬆)")
    if n.fields.get("door") is not None:
        _dv = str(n.fields.get("door")).strip()
        warns.append("door 是舊寫法(2026-09-17 改名),改成 plan_risk: high(舊值仍讀得懂)" + ("" if _plan_risk_norm(_dv) != "unknown" else f";而且 {_dv!r} 這個值工具不認得,會當沒寫"))

    t = n.fields.get("type")
    if t is not None and not isinstance(t, str):
        # 寫成清單等非字串:當成一條錯誤,後面一律當沒寫 type 處理——不然拿它去查允許值會直接丟例外,
        # 健檢 L 段整個圖譜跑時一篇壞筆記就讓整個健檢當掉(代碼審 r1 邊界席)
        errs.append(f"type 要是一個字串(一篇只有一種類型),你寫的是 {type(t).__name__}——改成 type: <類型>")
        t = None
    elif not isinstance(t, str) or not t:
        errs.append("沒寫 type(這篇是功能、問題還是驗證紀錄?),工具沒辦法分類——在開頭欄位加一行 type: <類型>")
    elif t not in KNOWN_TYPES:
        errs.append(f"type『{t}』工具不認得,會被歸錯類——改成其中一個:{'/'.join(sorted(KNOWN_TYPES))}")

    summ = n.fields.get("summary")
    summ = summ if isinstance(summ, str) else ""
    if t in ("system", "issue") and not summ.strip():
        errs.append(f"{t} 筆記沒有摘要區塊(FLOW:/KEY:/DEP: 那幾行),沒人能快速看懂這篇在講什麼——補上,範本可看 lumos new 產生的骨架")

    # aliases 宣告制(2026-08-05 Enzo 裁定,cutoff 起新 system/issue 逼「判過」不逼「有值」):
    # aliases 吃 3.5 檢索權重,湊數別名主動污染排序——故 `aliases: []`=明示判過,合法;
    # 缺鍵=沒判過,擋。舊節點不回溯(created < cutoff)。
    _ALIASES_CUTOFF = "2026-08-05"
    if t in ("system", "issue"):
        _created = str(n.fields.get("created") or "")
        if _created >= _ALIASES_CUTOFF and "aliases" not in n.fields:
            errs.append("沒寫 aliases:要想過一次這件事有沒有別的叫法(症狀語/縮寫/舊名),別人換個說法才搜得到——"
                        "有就列出來,確定沒有就明確寫 aliases: [](湊數的別名比空的更糟)")

    # 值域執法(2026-08-05 標籤結構優化,Enzo 裁;cutoff 制不回溯——Landmark 實測野化:
    # status 13 值同義混用、FLAG 50+ 自由文字淪為備註欄,可篩選性歸零)
    _ENUM_CUTOFF = "2026-08-06"
    _STATUS_ENUM = {
        "system": {"doing", "done", "planned", "deferred", "rejected", "superseded", "stale"},
        "project": {"todo", "doing", "done", "superseded"},
        "issue": {"open", "doing", "resolved", "done", "wontfix"},
        "verification": {"pass", "stale", "superseded", "pending", "abandoned"},
        # pending=預告了還沒做、abandoned=決定不做了的墓碑(必要合約清單_計劃)。
        # ★只是合法值,不代表被新規則管★:規則只認節點身上帶 guards 欄位的,手寫這兩個字行為照舊。
        "moc": {"doing", "done"},
    }
    _PRIORITY_ENUM = {"P0", "P1", "P2", "P3"}
    _RISK_ENUM = {"金流", "對外送出", "不可逆", "守衛面"}
    _FLAG_ENUM = {"TECHNICAL", "DECISION", "ORIGIN"}
    _created_e = str(n.fields.get("created") or n.fields.get("date") or "")
    if _created_e >= _ENUM_CUTOFF:
        _st = str(n.fields.get("status") or "")
        if t in _STATUS_ENUM and _st and _st not in _STATUS_ENUM[t]:
            errs.append(f"status『{_st}』不是 {t} 允許的狀態值,篩選統計會漏掉這篇——改成其中一個:{sorted(_STATUS_ENUM[t])}"
                        "(同義詞要歸一:resolved/done 擇一、verification 用 pass)")
        for tg in (n.fields.get("tags") or []):
            if not isinstance(tg, str):
                continue
            if tg.startswith("priority/") and tg.split("/", 1)[1] not in _PRIORITY_ENUM:
    if not _note_date_ok(str(v)):
        return f"{label} 要寫成年-月-日(例:2026-09-25),而且是真的日期;你寫的是 {str(v)!r}——{why}"
    return None


def _lint_new_rules(env, rel):
    """這次新增、擋不擋看開關的欄位規則(筆記欄位關卡補齊_計劃 S6 到 S10):回問題清單(每條講怎麼修)。每條規則一支小函式。"""
    n = env.notes[rel]
    return (_nl_rule_status(n) + _nl_rule_dates(n) + _nl_rule_decisions(n)
            + _nl_rule_about_code(env, n) + _nl_rule_lands_in(rel, n))


def _nl_rule_status(n):
    t = n.fields.get("type")
    st = n.fields.get("status")
    if t not in _NOTE_STATUS_REQUIRED_TYPES or (isinstance(st, str) and st.strip()):
        return []
    allowed = {"system": "doing/done/planned/deferred/rejected/superseded/stale", "project": "todo/doing/done/superseded",
               "issue": "open/doing/resolved/done/wontfix", "verification": "pass/stale/superseded/pending/abandoned"}[t]
    return [f"沒填 status(寫成空白也算),篩選與健檢各段都靠它判狀態——用 lumos set <節點> status <值> 補上,{t} 允許:{allowed}"]


def _nl_rule_dates(n):
    pbs = (_note_date_problem(k, k in n.fields, n.fields.get(k), "工具拿它比先後,寫錯會悄悄套錯規則") for k in _NOTE_DATE_FIELDS)
    return [x for x in pbs if x]


def _nl_rule_decisions(n):
    out = []
    for i, d in enumerate(parse_decisions(n.fm_lines or [])):
        for k in ("decided", "ended"):
            pb = _note_date_problem(f"第 {i} 條 decisions 的 {k}", k in d, d.get(k), "翻案時序比對會讀它")
            if pb:
                out.append(pb)
        v = d.get("valid")
        if v is not None and str(v).strip().lower() not in ("true", "false"):
            out.append(f"第 {i} 條 decisions 的 valid 只能是 true 或 false,你寫的是 {str(v)!r}——現在只有 false 會被當成推翻,寫成 no、0 會被當成仍有效")
    return out


def _nl_rule_about_code(env, n):
    ac = n.fields.get("about_code")
    out = []
    for item in (as_list(ac) if ac is not None else []):
        if str(item).strip() == "":
            continue
        _, err = _about_code_path(env, item)
        if err:
            out.append(f"about_code:{err}——改成這篇真的管的程式檔,或用 lumos remove <節點> about_code <值> 拿掉")
    return out


def _nl_rule_lands_in(rel, n):
    created = str(n.fields.get("created") or "")
    if not (n.fields.get("type") == "project" and Path(rel).name.endswith("_計劃.md")
            and (created >= _NOTE_LINT_PLAN_SINCE or not _note_date_ok(created))):
        return []
    li = n.fields.get("lands_in")
    vals = [x for x in (as_list(li) if li is not None else []) if str(x).strip()]
    if not vals:
        return ["計劃沒寫 lands_in(現況要寫進哪幾篇 Systems)——用 lumos append <計劃> lands_in Systems/<名稱> 補上,還沒開的篇也可以先寫"]
    bad = _lands_in_bad(vals)
    return [f"lands_in 這幾項不是 Systems/<名稱> 的純字串:{bad}(不帶 .md、不寫 [[連結]])"] if bad else []


SPEC_CLAUSE_RE = re.compile(r"\[S(\d+)\]")
_CLAUSE_ENUM = r"(?:(?:[A-Za-z]{1,2}|[一二三四五六七八九十]{1,3}|[甲乙丙丁戊己庚])[.、)）]\s*|[①-⑳⑴-⒇㈠-㈩ⅰ-ⅻⅠ-Ⅻ]\s*)?"   # a. / aa. / 一、/ 十一、/ 甲) / ① ㈠ ⅰ 這種短編號也是清單;★1–2 個字母/中文數字且必帶分隔符★——cf./vs. 也算編號(被當定義→沒標就擋,方向安全);三個字母以上才是詞
_CLAUSE_LEAD_RE = re.compile(r"^[\s>*#\-\d.、|+•—·)]*" + _CLAUSE_ENUM + r"(?:\[[ xX]\]\s*)?(?:\*\*)?\s*\[S(\d+)\]")   # 條款「定義行」:行首(去列表 - * + • — · 1. 1) a. 一、/標題 #/引用 >/粗體/表格 |/勾選框 [ ] 符號)就是 [SN];一行只認一條,後面的 [SN] 一律是引用
_CLAUSE_LISTLIKE_RE = re.compile(r"^\s*(?:[^\w\s]+\s*|(?:\d{1,3}|[A-Za-z]{1,2}|[一二三四五六七八九十]{1,3}|[甲乙丙丁戊己庚])[.、)）]\s*|[①-⑳⑴-⒇㈠-㈩ⅰ-ⅻⅠ-Ⅻ]\s*)*\[S(\d+)\]")   # 「像清單項卻認不得的前綴」:[SN] 前面只有符號或帶分隔符的短編號——用來判該擋還是當純引用;前面是詞或詞+冒號(規格 [S1]、注:[S1]、cf. [S1])才算散文(-b r2 兩席:冒號與任意短詞曾誤擋)
_CLAUSE_STATE_ZH = {"untagged": "未標", "manual": "靠人", "bound": "綁了", "dangling": "懸空(寫錯)",
                    "unrecognized": "懸空(設定認不到)", "mentioned": "懸空(只被提到)", "bad-name": "壞名(平台前綴未定義)",
                    "undefined": "非定義(只在範例/引用裡出現,不算條款)", "duplicate": "編號重複定義(兩行都寫 [SN])",
                    "shadowed": "定義過,又出現在認不得的清單行(第二次寫法看不懂)"}
# ★「懸空」的唯一定義★:spec-trace 的 hang 與 doctor 的 S5 都引用這一組,
# 不各自手抄(2026-09-10 代碼審抓到手抄版編了兩個不存在的字串、又漏掉兩種真的)。
_CLAUSE_HANG_STATES = ("dangling", "unrecognized", "mentioned")

_CLAUSE_GATE_SINCE = "2026-09-09T00:00:00+08:00"   # 處置閘的條款綁定步只看首筆帳在這之後的迴圈——不回溯舊迴圈(週跑回放會重跑閘,回溯=舊判定全翻)。
_SPEC_GATE_SINCE = "2026-09-18T00:00:00+08:00"     # 規格落成可驗收條件_計劃(半套):句式與回退節只看首筆帳在這之後的迴圈;綁定照驗(_CLAUSE_GATE_SINCE 管整步)
_TRIGGER_WORDS = ("若啟用", "當", "在", "若")          # 一條文法的觸發詞(長的先比);半套只認中文
_TRIGGER_STOPWORDS = ("當然", "當下", "當前", "在此", "在於", "若干", "若是")   # 句首命中就當無條件型;只准增不准刪(表列不齊是已知的,失敗是報錯不是靜默)
_CLAUSE_SEP_RE = re.compile(r"[,，]")
# 「主體 應 回應」那個「應」:前一字是這些就是複合詞(反應/效應/因應/適應/回應/對應/相應/供應/感應/響應/呼應/順應/理應/照應/接應/自應),不算
# (代碼審 v2 r1/r2:用負向 lookbehind 一次搜,跟本檔其他「排除上下文」的正則同一招;「答」「理」「自」不列——問答應於/處理應/自應 的應是真的應)
_SHALL_RE = re.compile(r"(?<![反效因適回對相供感響呼順照接])應")   # 「理應/自應」是情態(=應該)不排除(代碼審 v2 r3:「處理應在…」「系統自應…」被誤判缺應)


def _shall_index(text):
    """「主體 應 回應」那個「應」的位置;找不到回 -1。"""
    m = _SHALL_RE.search(text)
    return m.start() if m else -1
_ROLLBACK_H2_RE = re.compile(r"^##\s+回退\s*(?:[(（][^)）]*[)）])?\s*$")
_ROLLBACK_MIN_CHARS = 20


def _clause_body_of(line):
    """定義行去掉行首前綴與 [SN]、去掉尾端 [test:]/[manual:]/[keeps] 標記後的條款正文(給文法檢查用)。"""
    m = _CLAUSE_LEAD_RE.match(line)
    body = line[m.end():] if m else line
    body = INV_TAG_RE.sub("", body)
    body = MANUAL_REF_RE.sub("", body)
    body = re.sub(r"\[manual[:：][^\]]*\]|\[keeps\]", "", body)
    return _strip_inline_markup(body)[0].strip()


def _clause_grammar(body):
    try:
        with open(log, "a", encoding="utf-8") as fh:
            _rec = {"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                    "node": rel, "by": by or "", "note": note, "commit": commit}
            # ★可選的 ref★(必要合約清單_計劃):讓閘能機械比對「這次簽的是哪一個東西」,
            # 不必去自由文字裡撈 id(撈文字最容易寫錯也最容易漏)。沒帶就不寫,既有紀錄與用法不受影響。
            if (ref or "").strip():
                _rec["ref"] = ref.strip()
            fh.write(json.dumps(_rec, ensure_ascii=False) + "\n")
    except OSError as ex:
        print(f"擋下:簽核記錄寫不進去: {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "signed_off", today)
    if rc != 0:
        print("⚠ ledger 已記但 frontmatter 戳記失敗(見上)", file=sys.stderr)
        return rc
    print(f"✓ signoff {rel} — {today}{('(' + by + ')') if by else ''}: {note[:60]}")
    return 0


