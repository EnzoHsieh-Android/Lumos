 22816	    import subprocess as _sp
 22817	    if not specs:
 22818	        return []
 22819	    if any("\n" in s_ for s_ in specs):
 22820	        return None
 22821	    try:
 22822	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22823	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22824	                    capture_output=True, timeout=60)
 22825	    except (OSError, _sp.TimeoutExpired):
 22826	        return None
 22827	    if r.returncode != 0:
 22828	        return None
 22829	    out, pos, res = r.stdout, 0, []
 22830	    for _ in specs:
 22831	        nl = out.find(b"\n", pos)
 22832	        if nl < 0:
 22833	            return None
 22834	        head = out[pos:nl].split(b" ")
 22835	        pos = nl + 1
 22836	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22837	            size = int(head[2])
 22838	            res.append(out[pos:pos + size])
 22839	            pos += size + 1
 22840	        elif len(head) == 3 and head[2].isdigit():
 22841	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22842	            res.append(None)
 22843	        else:
 22844	            res.append(None)            # missing / ambiguous
 22845	    return res
