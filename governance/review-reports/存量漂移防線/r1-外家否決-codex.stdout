 29418	    r = _lens_git(repo_root, "diff", "--no-ext-diff", "--no-textconv", "-U0",
 29419	                  base_sha, head_sha, "--", path, quote=True)
 29420	    if r is None or r.returncode != 0:
 29421	        return [], 0, False
 29422	    ranges, pure_add = [], 0
 29423	    deleted = False
 29424	    for m in re.finditer(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", r.stdout, re.M):
 29425	        a = int(m.group(1)); b = int(m.group(2)) if m.group(2) is not None else 1
 29426	        c = int(m.group(3)); d = int(m.group(4)) if m.group(4) is not None else 1
 29427	        if b == 0:
 29428	            pure_add += 1; continue
 29429	        if c == 0 and d == 0:
