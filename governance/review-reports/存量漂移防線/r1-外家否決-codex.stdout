def _note_date_ok(v):
    if not isinstance(v, str) or not DATE_RE.match(v.strip()):
        return False
    import datetime as _dt
    try:
        _dt.date.fromisoformat(v.strip())
    except ValueError:
        return False
    return True


def _note_date_problem(label, present, v, why):
    """一個日期欄位的問題(沒問題回 None)。頂層日期與決策日期★共用這一支★(代碼審 r2 五席:
    只替頂層三個補了空字串防呆,同構的決策 decided/ended 沒跟上——同一種資料只准一套判法)。
    present:欄位有沒有寫(寫了卻空也算錯:會同時繞過日期規則與既有的建立日切點)。"""
    if not present:
        return None
    if v is None or str(v).strip() == "":
        return f"{label} 寫了卻是空的——填年-月-日(例:2026-09-25),不需要就整行拿掉"
    if not _note_date_ok(str(v)):
        return f"{label} 要寫成年-月-日(例:2026-09-25),而且是真的日期;你寫的是 {str(v)!r}——{why}"
    return None


def _lint_new_rules(env, rel):
    """這次新增、擋不擋看開關的欄位規則(筆記欄位關卡補齊_計劃 S6 到 S10):回問題清單(每條講怎麼修)。每條規則一支小函式。"""
    n = env.notes[rel]
    return (_nl_rule_status(n) + _nl_rule_dates(n) + _nl_rule_decisions(n)
            + _nl_rule_about_code(env, n) + _nl_rule_lands_in(rel, n))


def _nl_rule_status(n):
    t = n.fields.get("type")
    st = n.fields.get("status")
    if t not in _NOTE_STATUS_REQUIRED_TYPES or (isinstance(st, str) and st.strip()):
        return []
    allowed = {"system": "doing/done/planned/deferred/rejected/superseded/stale", "project": "todo/doing/done/superseded",
               "issue": "open/doing/resolved/done/wontfix", "verification": "pass/stale/superseded/pending/abandoned"}[t]
    return [f"沒填 status(寫成空白也算),篩選與健檢各段都靠它判狀態——用 lumos set <節點> status <值> 補上,{t} 允許:{allowed}"]


def _nl_rule_dates(n):
    pbs = (_note_date_problem(k, k in n.fields, n.fields.get(k), "工具拿它比先後,寫錯會悄悄套錯規則") for k in _NOTE_DATE_FIELDS)
    return [x for x in pbs if x]


def _nl_rule_decisions(n):
    out = []
    for i, d in enumerate(parse_decisions(n.fm_lines or [])):
        for k in ("decided", "ended"):
        return ["計劃沒寫 lands_in(現況要寫進哪幾篇 Systems)——用 lumos append <計劃> lands_in Systems/<名稱> 補上,還沒開的篇也可以先寫"]
    bad = _lands_in_bad(vals)
    return [f"lands_in 這幾項不是 Systems/<名稱> 的純字串:{bad}(不帶 .md、不寫 [[連結]])"] if bad else []


SPEC_CLAUSE_RE = re.compile(r"\[S(\d+)\]")
_CLAUSE_ENUM = r"(?:(?:[A-Za-z]{1,2}|[一二三四五六七八九十]{1,3}|[甲乙丙丁戊己庚])[.、)）]\s*|[①-⑳⑴-⒇㈠-㈩ⅰ-ⅻⅠ-Ⅻ]\s*)?"   # a. / aa. / 一、/ 十一、/ 甲) / ① ㈠ ⅰ 這種短編號也是清單;★1–2 個字母/中文數字且必帶分隔符★——cf./vs. 也算編號(被當定義→沒標就擋,方向安全);三個字母以上才是詞
_CLAUSE_LEAD_RE = re.compile(r"^[\s>*#\-\d.、|+•—·)]*" + _CLAUSE_ENUM + r"(?:\[[ xX]\]\s*)?(?:\*\*)?\s*\[S(\d+)\]")   # 條款「定義行」:行首(去列表 - * + • — · 1. 1) a. 一、/標題 #/引用 >/粗體/表格 |/勾選框 [ ] 符號)就是 [SN];一行只認一條,後面的 [SN] 一律是引用
_CLAUSE_LISTLIKE_RE = re.compile(r"^\s*(?:[^\w\s]+\s*|(?:\d{1,3}|[A-Za-z]{1,2}|[一二三四五六七八九十]{1,3}|[甲乙丙丁戊己庚])[.、)）]\s*|[①-⑳⑴-⒇㈠-㈩ⅰ-ⅻⅠ-Ⅻ]\s*)*\[S(\d+)\]")   # 「像清單項卻認不得的前綴」:[SN] 前面只有符號或帶分隔符的短編號——用來判該擋還是當純引用;前面是詞或詞+冒號(規格 [S1]、注:[S1]、cf. [S1])才算散文(-b r2 兩席:冒號與任意短詞曾誤擋)
_CLAUSE_STATE_ZH = {"untagged": "未標", "manual": "靠人", "bound": "綁了", "dangling": "懸空(寫錯)",
                    "unrecognized": "懸空(設定認不到)", "mentioned": "懸空(只被提到)", "bad-name": "壞名(平台前綴未定義)",
                    "undefined": "非定義(只在範例/引用裡出現,不算條款)", "duplicate": "編號重複定義(兩行都寫 [SN])",
                    "shadowed": "定義過,又出現在認不得的清單行(第二次寫法看不懂)"}
# ★「懸空」的唯一定義★:spec-trace 的 hang 與 doctor 的 S5 都引用這一組,
# 不各自手抄(2026-09-10 代碼審抓到手抄版編了兩個不存在的字串、又漏掉兩種真的)。
_CLAUSE_HANG_STATES = ("dangling", "unrecognized", "mentioned")

_CLAUSE_GATE_SINCE = "2026-09-09T00:00:00+08:00"   # 處置閘的條款綁定步只看首筆帳在這之後的迴圈——不回溯舊迴圈(週跑回放會重跑閘,回溯=舊判定全翻)。
_SPEC_GATE_SINCE = "2026-09-18T00:00:00+08:00"     # 規格落成可驗收條件_計劃(半套):句式與回退節只看首筆帳在這之後的迴圈;綁定照驗(_CLAUSE_GATE_SINCE 管整步)
_TRIGGER_WORDS = ("若啟用", "當", "在", "若")          # 一條文法的觸發詞(長的先比);半套只認中文
_TRIGGER_STOPWORDS = ("當然", "當下", "當前", "在此", "在於", "若干", "若是")   # 句首命中就當無條件型;只准增不准刪(表列不齊是已知的,失敗是報錯不是靜默)
_CLAUSE_SEP_RE = re.compile(r"[,，]")
# 「主體 應 回應」那個「應」:前一字是這些就是複合詞(反應/效應/因應/適應/回應/對應/相應/供應/感應/響應/呼應/順應/理應/照應/接應/自應),不算
# (代碼審 v2 r1/r2:用負向 lookbehind 一次搜,跟本檔其他「排除上下文」的正則同一招;「答」「理」「自」不列——問答應於/處理應/自應 的應是真的應)
_SHALL_RE = re.compile(r"(?<![反效因適回對相供感響呼順照接])應")   # 「理應/自應」是情態(=應該)不排除(代碼審 v2 r3:「處理應在…」「系統自應…」被誤判缺應)


def _shall_index(text):
    """「主體 應 回應」那個「應」的位置;找不到回 -1。"""
    m = _SHALL_RE.search(text)
    return m.start() if m else -1
_ROLLBACK_H2_RE = re.compile(r"^##\s+回退\s*(?:[(（][^)）]*[)）])?\s*$")
_ROLLBACK_MIN_CHARS = 20


def _clause_body_of(line):
    """定義行去掉行首前綴與 [SN]、去掉尾端 [test:]/[manual:]/[keeps] 標記後的條款正文(給文法檢查用)。"""
    m = _CLAUSE_LEAD_RE.match(line)
    body = line[m.end():] if m else line
    body = INV_TAG_RE.sub("", body)
    body = MANUAL_REF_RE.sub("", body)
    body = re.sub(r"\[manual[:：][^\]]*\]|\[keeps\]", "", body)
    return _strip_inline_markup(body)[0].strip()


