 25013	def _note_audit_doctor_lines(repo_root, vault, ci=False):
 25014	    """doctor 的筆記內容審提醒(計劃 S16):開關不是 block、專案 CI 沒呼叫 note-audit check(跳過註解行)、
 25015	    事後掃描遠端頂端沒被涵蓋的新增筆記行、主線歷史裡判定檔被刪過幾次。"""
 25016	    out = []
 25017	    root = Path(repo_root)
 25018	    cp = root / ".lumos" / "config.json"
 25019	    txt = None
 25020	    try:
 25021	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 25022	            txt = cp.read_bytes()
 25023	    except OSError:
 25024	        txt = None
 25025	    mode, _w = _note_audit_config(txt)
 25026	    if mode != "block":
 25027	        out.append(f"這個專案把「筆記內容審」設成 {mode}(.lumos/config.json 的 note_audit.gate)——新寫的筆記不會被判定者審")
 25028	    wf = root / ".github" / "workflows"
 25029	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 25030	    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
 25031	    wired = hk is not None and hk.returncode == 0 and _NOTE_AUDIT_GOLIVE_MARK in hk.stdout
 25032	    body = "\n".join(l for p in ymls for l in p.read_text(encoding="utf-8", errors="replace").split("\n")
 25033	                     if not l.lstrip().startswith("#"))
 25034	    shallow = _ci_jobs_calling_without_full_history(ymls, "note-audit check")
 25035	    if shallow:
 25036	        out.append("專案 CI 呼叫了 note-audit check,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
 25037	                   + "、".join(f"{f} 的 {j}" for f, j in shallow[:5]))
 25038	    if ymls and wired:          # 還沒接線(推送前掛鉤裡沒有這道)就不唸 CI 沒呼叫——接線前這道本來就不擋
 25039	        if "note-audit check" not in body:
 25040	            out.append("專案 CI 沒呼叫 `lumos note-audit check`,`--no-verify` 推上去的筆記沒人審——CI 在 note-shape 那步後面加:"
 25041	                       "\n    - run: python3 scripts/lumos note-audit check --diff \"${{ github.event.before || "
 25042	                       "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"")
 25043	    if ci:
 25044	        return out
 25045	    ml = _mainline_ref(root, remote_only=True)
 24440	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 24441	    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 24442	    return (None if base == _EMPTY_TREE_SHA else base), tip, vault_rel
