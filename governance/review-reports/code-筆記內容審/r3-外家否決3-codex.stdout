     lead = fm[k0][:fm[k0].index(field)]
     newtxt = text.replace("\n", " ").strip()
     new_fm = fm[:k0] + [f"{lead}{field}: {_fmt_decision_value(newtxt)}"] + fm[k1 + 1:]
     new_lines = lines[:1] + new_fm + lines[e_fm:]
 
     def _check(_fields):
         for d in parse_decisions(_fm_of(new_lines)):
             if str(d.get("id", "")).strip() == did:
                 return nfc(str(d.get(field, ""))).strip() == nfc(newtxt)
         return False
     atomic_write_verify(path, new_lines, "decisions", _check)
     print(f"✓ decision-amend {rel} {did}.{field} 改好了(這條決策還沒推上去)")
     return 0
 
 
+def _ci_jobs_calling_without_full_history(ymls, needle):
+    """GitHub Actions 設定裡,呼叫 needle(跳過註解行)的工作項目中,沒設 fetch-depth: 0 的那些 → [(檔名, 工作項目名)]。
+    照工作項目切,不看整份:別的工作項目設了完整歷史,不代表呼叫這道檢查的那個有(筆記內容審代碼審 r2 外家席)。"""
+    out = []
+    for p in ymls:
+        try:
+            lines = [l for l in p.read_text(encoding="utf-8", errors="replace").split("\n") if not l.lstrip().startswith("#")]
+        except OSError:
+            continue
+        jobs, cur, jind, in_jobs = {}, None, None, False
+        for ln in lines:
+            if not ln.strip():
+                continue
+            ind = len(ln) - len(ln.lstrip(" "))
+            if re.match(r"^jobs:\s*$", ln):
+                in_jobs, jind, cur = True, None, None
+                continue
+            if in_jobs and ind == 0:
+                in_jobs, cur = False, None
+            if not in_jobs:
+                continue
+            m = re.match(r"^(\s+)([\w.-]+):\s*$", ln)
+            if m and (jind is None or ind == jind):
+                jind, cur = ind, m.group(2)
+                jobs[cur] = []
+                continue
+            if cur is not None:
+                jobs[cur].append(ln)
+        for name, body in jobs.items():
+            text = "\n".join(body)
+            if needle in text and "fetch-depth: 0" not in text:
+                out.append((p.name, name))
+    return out
+
