 22810	def _nodehome_cat_blobs(repo_root, specs):
 22811	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22812	
 22813	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22814	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22815	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 29120	    對讀派工單的人來說「這篇管這支檔」比「這篇有提到這支檔」重要,所以家優先顯示。
 29121	    """
 29122	    # ★事故不能被蓋掉★:一篇既是家、又出過事故,讀派工單的人最需要知道的是「這裡出過事」
 29123	    # ——所以兩個都印(代碼審 r1 正確性席)。
 29124	    base = _LENS_KIND.get(v.get("kind"), None)
 29125	    if not v.get("home"):
 29126	        return base
 29127	    return f"{base}·{_LENS_KIND['home']}" if base and v.get("kind") == "incident" else _LENS_KIND["home"]
