 24543	def _note_audit_parse_list(text):
 24544	    """清單檔 → {orchestrator, model, version, fp, fp_ok, tip, rows:{id: [每一處的上下文指紋,排序過]}} 或 None。"""
 24545	    import hashlib
 24546	    if "\n---本文---\n" not in text:
 24547	        return None
 24548	    head, body = text.split("\n---本文---\n", 1)
 24549	    meta = dict(re.findall(r"^(編排者|判定者模型|派工詞版本|清單指紋): (.+)$", head, re.M))
 24550	    m = re.search(r"^頂端提交: ([0-9a-f]{40})$", body, re.M)
 24551	    rows = {}
 24552	    for rid, fp in re.findall(r"^## ([0-9a-f]{16}) \|.*\n上下文指紋: ([0-9a-f]{16})$", body, re.M):
 24553	        rows.setdefault(rid, []).append(fp)
 24554	    rows = {k: sorted(v) for k, v in rows.items()}
 24555	    if not meta.get("清單指紋") or not m:
 24556	        return None
 24557	    return {"orchestrator": meta.get("編排者"), "model": meta.get("判定者模型"), "version": meta.get("派工詞版本"),
 24558	            "fp": meta["清單指紋"], "fp_ok": hashlib.sha256(body.encode("utf-8")).hexdigest()[:16] == meta["清單指紋"],
 24559	            "tip": m.group(1), "rows": rows}
 24560	
 24561	
 24562	def _note_audit_parse_report(text):
 24563	    """判定者報告 → (header dict, rows[(id, class_or_None, evidence, reason)])。開頭四行 seat/provider/model/prepared。"""
 24564	    head = {}
 24565	    for k in ("seat", "provider", "model", "prepared"):
 24566	        m = re.search(rf"^{k}:\s*(\S.*?)\s*$", text, re.M)
 24567	        if m:
 24568	            head[k] = m.group(1)
 24569	    rows = []
 24570	    for ln in text.split("\n"):
 24571	        cells = [c.strip() for c in ln.strip().strip("|").split("|")]
 24572	        if len(cells) >= 2 and re.fullmatch(r"[0-9a-f]{16}", cells[0]):
 24573	            cls = _NOTE_AUDIT_CLASS_ALIASES.get(cells[1].strip("`*").upper() if cells[1].isascii() else cells[1].strip("`*"))
 24574	            rows.append((cells[0], cls, cells[2] if len(cells) > 2 else "", cells[3] if len(cells) > 3 else ""))
 24575	    return head, rows
 24576	
 24577	
 24578	def _note_audit_check_evidence(root, tip, evidence):
 24579	    """證據只做紀錄(計劃〈做法〉第 3 節第 5 點):file:line 讀清單當時頂端提交的 git 版本;search: 在那個提交的樹裡、
 24580	    repo 內相對路徑、最多掃 20,000 支檔。回 True/False(驗得過沒)。"""
 24581	    ok_any = False
 24582	    for m in re.finditer(r"`?([\w./\-]+):(\d+)(?:-(\d+))?`?", evidence or ""):
 24583	        st, _ex = _validate_repo_ref(root, m.group(1), m.group(2) + (f"-{m.group(3)}" if m.group(3) else ""), at_sha=tip)
 24584	        if st != "ok":
 24585	            return False
 24586	        ok_any = True
 24587	    ms = re.search(r"search:\s*(.+?)\s+in\s+(\S+)\s*=>\s*(\d+)", evidence or "")
 24588	    if ms:
 24589	        s, path, n = ms.group(1).strip().strip("`\"'"), ms.group(2).strip("`"), int(ms.group(3))
 24590	        if len(s) < 4 or path.startswith("/") or ".." in Path(path).parts:
 24591	            return False
 24592	        ls = _lens_git(root, "ls-tree", "-r", "--name-only", tip, "--", path)
 24593	        # 路徑在那個提交裡不存在時 ls-tree 也回 0、輸出空——不能當成「搜過、零命中」(代碼審 r1 兩席)
 24594	        if ls is None or ls.returncode != 0 or not ls.stdout.strip() or len(ls.stdout.splitlines()) > _NOTE_AUDIT_SEARCH_CAP:
 24595	            return False
 24596	        g = _lens_git(root, "grep", "-c", "-F", "-e", s, tip, "--", path)
 24597	        if g is None or g.returncode not in (0, 1):       # 1=沒命中;其他是出錯,不算零命中
 24598	            return False
 24599	        cnt = 0
 24600	        if g.returncode == 0:
 24601	            cnt = sum(int(x.rsplit(":", 1)[1]) for x in g.stdout.splitlines() if x.rsplit(":", 1)[-1].isdigit())
 24602	        return cnt == n
 24603	    return ok_any
 24604	
 24605	
 24606	def _note_audit_write_verdict(root, doc):
 24607	    """一份報告寫一個判定檔(暫存再原子換名;32 位亂數檔名)。回檔名。"""
 24608	    import json as _j, uuid as _uuid, datetime as _dt
 24609	    d = Path(root) / _NOTE_AUDIT_VERDICT_DIR
 24610	    d.mkdir(parents=True, exist_ok=True)
 24611	    name = _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + _uuid.uuid4().hex + ".json"
 24612	    _write_lf(d / name, _j.dumps(doc, ensure_ascii=False, indent=1) + "\n")
 24613	    return name
 24614	
 24615	
 24616	def _note_audit_work_dir(root):
 24617	    d = Path(root) / _NOTE_AUDIT_WORK_DIR
 24618	    first = not d.exists()
 24619	    d.mkdir(parents=True, exist_ok=True)
 24620	    if first or not (d / ".gitignore").exists():
 24621	        _write_lf(d / ".gitignore", "*\n")
 24622	    import time as _t
 24623	    for f in d.glob("*.md"):
 24624	        try:
 24625	            if _t.time() - f.stat().st_mtime > 14 * 86400:
 24626	                f.unlink()
 24627	        except OSError:
 24628	            pass
 24629	    return d
