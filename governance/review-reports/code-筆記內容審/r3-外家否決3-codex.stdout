 24475	def _note_audit_batches(pending):
 24476	    """待審超過 150 行就切:先照筆記分組、同篇同份;單篇超過時在小標題邊界切;單一小標題下還超過就照行數硬切。"""
 24477	    groups = []
 24478	    for p in sorted({it["path"] for it in pending}):
 24479	        rows = [it for it in pending if it["path"] == p]
 24480	        if len(rows) <= _NOTE_AUDIT_BATCH:
 24481	            groups.append(rows)
 24482	            continue
 24483	        units, seen = [], {}
 24484	        for it in rows:                         # 同一編號的幾處(同篇、同小標題)當成一個單位,不拆到兩份清單
 24485	            if it["id"] in seen:
 24486	                seen[it["id"]].append(it)
 24487	            else:
 24488	                seen[it["id"]] = [it]
 24489	                units.append(seen[it["id"]])
 24490	        # 單一編號就超過一份的上限:只列前 150 處(上限不破);清單少了幾處,輕的判定就收不下——
 24491	        # 那麼多處一字不差的行本來就該改寫(代碼審 r2 外家席)
 24492	        units = [u[:_NOTE_AUDIT_BATCH] for u in units]
 24493	        cur, cur_head = [], None
 24494	        for u in units:
 24495	            it = u[0]
 24496	            new_head = cur and it["heading"] != cur_head
 24497	            if cur and (len(cur) + len(u) > _NOTE_AUDIT_BATCH or (new_head and _note_audit_head_split(rows, cur, it))):
 24498	                groups.append(cur)
 24499	                cur = []
 24500	            cur.extend(u)
 24501	            cur_head = it["heading"]
 24502	        if cur:
 24503	            groups.append(cur)
 24504	    batches, cur = [], []
 24505	    for g in groups:
 24506	        if cur and len(cur) + len(g) > _NOTE_AUDIT_BATCH:
 24507	            batches.append(cur)
 24508	            cur = []
 24509	        cur.extend(g)
 24510	    if cur:
 24511	        batches.append(cur)
 24512	    return batches
 24513	
 24514	
 24515	def _note_audit_head_split(rows, cur, it):
 24516	    """單篇超過一批時:換小標題的地方,如果把下一個小標題整段放進來會超過一批,就在這裡切。"""
 24517	    nxt = sum(1 for r in rows if r["heading"] == it["heading"])
 24518	    return len(cur) + nxt > _NOTE_AUDIT_BATCH
 24519	
