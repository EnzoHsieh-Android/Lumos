 24632	def cmd_note_audit_prepare(repo=None, diff_range=None, orchestrator=None, only=None):
 24633	    """lumos note-audit prepare --diff A..B --orchestrator claude|codex [--only 編號…](計劃〈做法〉第 3 節第 1 點)。"""
 24634	    import datetime as _dt
 24635	    root = _note_audit_root(repo)
 24636	    if root is None:
 24637	        print("筆記內容審:這裡不是 git 專案", file=sys.stderr)
 24638	        return 2
 24639	    if orchestrator not in ("claude", "codex"):
 24640	        print("擋下:--orchestrator 要給 claude 或 codex(編排這次的那一家;判定者跟它同一家)", file=sys.stderr)
 24641	        return 2
 24642	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
 24643	    if tip is None or isinstance(tip, int):
 24644	        return tip if isinstance(tip, int) else 0
 24645	    got = _note_audit_items(root, base, tip, vault_rel)
 24646	    if got is None:
 24647	        print("筆記內容審:git 算不出這次的筆記行", file=sys.stderr)
 24648	        return 2
 24649	    items, errs = got
 24650	    for e in errs:
 24651	        print(f"  {e}", file=sys.stderr)
 24652	    docs, bad = _note_audit_load_verdicts(root, None)
 24653	    for n in bad:
 24654	        print(f"提醒:判定檔 {n} 壞掉了(讀不成 JSON 或缺欄位),當作不存在", file=sys.stderr)
 24655	    fold = _note_audit_fold(docs)
 24656	    # 同一個內容編號的每一處都列(同一小標題下一字不差的兩行,上下文可能一處是脈絡、一處是現況;代碼審 r1 兩席)
 24657	    want = set(only) if only else None
 24658	    pending = [it for it in items if (it["id"] in want if want is not None else not _note_audit_covered(fold.get(it["id"])))]
 24659	    if not pending:
 24660	        print("沒有待審的筆記行")
 24661	        return 0
 24662	    prompt = _note_audit_prompt(root)
 24663	    if prompt is None:
 24664	        print(f"擋下:找不到派工詞範本 {_NOTE_AUDIT_TEMPLATE}(跑一次 lumos update)", file=sys.stderr)
 24665	        return 2
 24666	    big = {}
 24667	    for it in pending:
 24668	        big[it["id"]] = big.get(it["id"], 0) + 1
 24669	    for rid, n in big.items():
 24670	        if n > _NOTE_AUDIT_BATCH:
 24671	            print(f"提醒:內容編號 {rid} 同一小標題下有 {n} 處一字不差的行,清單只列前 {_NOTE_AUDIT_BATCH} 處——"
 24672	                  "判成脈絡也收不下,請改寫那些重複行", file=sys.stderr)
 24673	    wd = _note_audit_work_dir(root)
 24674	    outs = []
 24675	    for batch in _note_audit_batches(pending):
 24676	        content, fp = _note_audit_render_list(orchestrator, tip, batch, prompt)
 24677	        f = wd / f"{fp}-{orchestrator}.md"
 24678	        _write_lf(f, content)
 24679	        outs.append((f, fp, len(batch)))
 24680	        _gate_event_or_warn(root, "note-audit", "prepare", f"清單 {fp}:{len(batch)} 行")
 24681	    print(f"待審 {len({it['id'] for it in pending})} 個編號({len(pending)} 處),切成 {len(outs)} 份清單;每份派一席 {_note_audit_judge_model(orchestrator)}"
 24682	          f"(跟編排者同一家),報告照清單開頭的格式寫:")
 24683	    for f, fp, n in outs:
 24684	        print(f"  {f}  ({n} 行,清單指紋 {fp})")
 24685	    print("判定者交回報告後:\n    lumos note-audit record --diff <同一個範圍> --prepared <清單檔> --report <報告>")
 24686	    return 0
