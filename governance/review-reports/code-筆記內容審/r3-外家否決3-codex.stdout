 24452	def _note_audit_prompt(root):
 24453	    """派工詞:範本檔三類定義與七句,專案路徑與技術棧換成被審 repo 的(計劃 S13)。"""
 24454	    here = Path(__file__).resolve().parent.parent
 24455	    tpl = None
 24456	    for cand in (Path(root) / _NOTE_AUDIT_TEMPLATE, here / _NOTE_AUDIT_TEMPLATE):
 24457	        if cand.is_file():
 24458	            tpl = cand.read_text(encoding="utf-8")
 24459	            break
 24460	    if tpl is None:
 24461	        return None
 24462	    # 檔頭授權標示與給維護者看的註解不進派工詞
 24463	    tpl = "".join(l for l in tpl.splitlines(keepends=True) if not l.startswith("# SPDX-"))
 24464	    if tpl.lstrip().startswith("<!--") and "-->" in tpl:
 24465	        tpl = tpl.split("-->", 1)[1].lstrip("\n")
 24466	    try:
 24467	        cnt = sorted(_stack_ext_counts(Path(root)).items(), key=lambda kv: -kv[1])[:5]
 24468	        stacks = "主要程式檔副檔名:" + (", ".join(f"{e}×{n}" for e, n in cnt) if cnt else "未偵測到")
 24469	    except OSError:
 24470	        stacks = "主要程式檔副檔名:未偵測到"
 24471	    return (tpl.replace("{{REPO_PATH}}", str(Path(root).resolve())).replace("{{STACK}}", stacks)
 24472	               .replace("{{PROMPT_VERSION}}", str(_NOTE_AUDIT_PROMPT_VERSION)))
