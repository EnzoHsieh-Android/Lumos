+    r = run(vault, "decision-amend", "Systems/Fresh", "d1", "--field", "context", "--text", "新的改")
+    check("②c 全新筆記(有遠端、沒刪檔、還沒 add):准改", r.returncode == 0, r.stderr[-300:])
