 24521	def _note_audit_render_list(orchestrator, tip, batch, prompt):
 24522	    """清單檔 → (內容, 清單指紋)。本文=頂端提交+逐行;指紋=本文的雜湊(開頭不算,所以開頭能寫出指紋給判定者照抄)。"""
 24523	    import hashlib
 24524	    body = [f"頂端提交: {tip}", ""]
 24525	    for it in batch:
 24526	        body.append(f"## {it['id']} | {it['region']} | {it['heading'] or '-'} | {it['path']}:{it['line']}"
 24527	                    + (" | 完成審" if it["done"] else ""))
 24528	        body.append(f"上下文指紋: {it['ctx_fp']}")
 24529	        body.append("~~~~text")
 24530	        body.extend(f"    {x}" for x in it["context"][0])
 24531	        body.append(f">>> {it['text']}")
 24532	        body.extend(f"    {x}" for x in it["context"][1])
 24533	        body.append("~~~~")
 24534	        body.append("")
 24535	    body_s = "\n".join(body)
 24536	    fp = hashlib.sha256(body_s.encode("utf-8")).hexdigest()[:16]
 24537	    head = ["# 筆記內容審清單", "", f"編排者: {orchestrator}", f"判定者模型: {_note_audit_judge_model(orchestrator)}",
 24538	            f"派工詞版本: {_NOTE_AUDIT_PROMPT_VERSION}", f"清單指紋: {fp}", "", "## 派工詞", "", prompt, "",
 24539	            "---本文---"]
 24540	    return "\n".join(head) + "\n" + body_s, fp
