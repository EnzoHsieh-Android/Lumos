 22744	def _nodehome_name_status(raw, norm=True):
 22745	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。
 22746	    norm=False 保留 git 原樣路徑(要拿去 git 查的呼叫端用;筆記形狀擋驗收輪:NFC 過的路徑對 NFD 樹查不到)。"""
 22747	    nfc = globals()["nfc"] if norm else (lambda x: x)
 22748	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 22749	    while i < len(toks):
 22750	        code = toks[i][:1]
 22751	        if code in ("R", "C") and i + 2 < len(toks):
 22752	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 22753	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 22754	            if code == "R":
 22755	                gone.add(nfc(toks[i + 1]))
 22756	            i += 3
 22757	        elif i + 1 < len(toks):
 22758	            paths.add(nfc(toks[i + 1]))
 22759	            if code == "D":
 22760	                gone.add(nfc(toks[i + 1]))
 22761	            i += 2
 22762	        else:
 22763	            break
 22764	    return paths, src, gone - set(src)
