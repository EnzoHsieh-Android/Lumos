 24881	def cmd_decision_amend(env, rel, did, field, text):
 24882	    """lumos decision-amend <節點> <決策編號> --field <欄名> --text "<新文字>"(計劃〈做法〉第 3 節第 4 點):
 24883	    只改還沒推上去的決策的一個文字子欄。先 fetch 所有遠端,再對每個遠端追蹤參照用改名偵測找這篇的舊路徑:
 24884	    那個版本裡有這個決策編號就拒絕(已推或撞號,兩種都講)。"""
 24885	    if field in ("id", "decided", "valid", "superseded_by", "ended", "decided_by", "replaces"):
 24886	        raise ValueError(f"「{field}」是結構欄,不能用 decision-amend 改;要翻案用 decision-supersede")
 24887	    if not re.fullmatch(r"d\d+", did or ""):
 24888	        raise ValueError("決策編號要寫成 d1、d2 這種形狀")
 24889	    path = env.vault / rel
 24890	    top = _lens_git(env.vault, "rev-parse", "--show-toplevel")
 24891	    if top is None or top.returncode != 0 or not top.stdout.strip():
 24892	        raise ValueError("這篇筆記不在 git 專案裡")
 24893	    root = Path(top.stdout.strip())
 24894	    rels = path.resolve().relative_to(root.resolve()).as_posix()
 24895	    # 改名偵測的路徑篩選給整個圖譜夾:只給新路徑的話舊路徑不在篩選裡,git 認不出改名
 24896	    vrel = env.vault.resolve().relative_to(root.resolve()).as_posix()
 24897	    rm = _lens_git(root, "remote")
 24898	    remotes = [x for x in (rm.stdout.split() if rm is not None and rm.returncode == 0 else []) if x]
 24899	    if remotes:
 24900	        tracked = _lens_git(root, "ls-files", "--error-unmatch", "--", rels)
 24901	        gone = _lens_git(root, "ls-files", "--deleted", "--", vrel)
 24902	        if (tracked is None or tracked.returncode != 0) and gone is not None and gone.stdout.strip():
 24903	            # 這篇還沒進 git、圖譜裡又有追蹤中的檔在磁碟上不見了:多半是用檔案總管或 Obsidian 改了名,
 24904	            # 認不出它在遠端的舊路徑(代碼審 r2 通才席);全新、從沒推過的筆記不在此列
 24905	            raise ValueError("這篇筆記還沒加進 git,而圖譜裡有檔在磁碟上被刪或搬走了——如果是改名,請先 git add 新舊兩邊"
 24906	                             "(或用 git mv),工具才認得出它在遠端的舊路徑")
 24907	        f = _lens_git(root, "fetch", "--all", "--quiet")
 24908	        if f is None or f.returncode != 0:
 24909	            raise ValueError("git fetch --all 失敗(沒網路或遠端要驗證),確認不了這條決策有沒有推上去,不改。"
 24910	                             + ((" " + f.stderr.strip()[:200]) if f is not None else ""))
 24911	        refs = _lens_git(root, "for-each-ref", "--format=%(refname)", "refs/remotes")
 24912	        for ref in (refs.stdout.split() if refs is not None and refs.returncode == 0 else []):
 24913	            if ref.endswith("/HEAD"):
 24914	                continue
 24915	            # 跟工作目錄比(不是 HEAD、也不只暫存區):還沒提交的 git mv、只暫存了新檔的搬檔都要認得出改名
 24916	            # (代碼審 r1 外家席、r2 通才席)
 24917	            ns = _ns_git(root, "diff", "--name-status", "-z", "-M", ref, "--", vrel)
 24918	            old = rels
 24919	            if ns is not None:
 24920	                src = _nodehome_name_status(ns, norm=False)[1]
 24921	                old = src.get(rels, rels)
 24922	            b = _nodehome_cat_blobs(root, [f"{ref}:{old}"])
 24923	            if b and b[0] is not None:
 24924	                if re.search(rf"^\s*(?:-\s+)?id:\s*{re.escape(did)}\s*$", b[0].decode("utf-8", errors="replace"), re.M):
 24925	                    raise ValueError(f"遠端 {ref} 上的這篇已經有決策 {did}:可能①已經推上去了——請用 "
 24926	                                     f"lumos decision-supersede 翻案;或②兩條分支撞號——請先把你的決策改號")
 24927	    lines, s_fm, e_fm = load_raw_for_edit(path)
 24928	    fm = lines[1:e_fm]
 24929	    loc = decisions_items(fm)
 24930	    if loc is None or not loc[2]:
 24931	        raise ValueError("這篇筆記沒有讀得出的決策紀錄(decisions)")
 24932	    _s, _e, items, _ii, sub = loc
 24933	    pad = " " * sub
 24934	    hit = [(st, en) for st, en in items
 24935	           if any(re.match(rf"^\s*(?:-\s+)?id:\s*{re.escape(did)}\s*$", fm[i]) for i in range(st, en + 1))]
 24936	    if not hit:
 24937	        raise ValueError(f"找不到決策 {did}")
 24938	    st, en = hit[0]
 24939	    k0 = next((i for i in range(st, en + 1) if re.match(rf"^(?:{pad}|\s*-\s+){re.escape(field)}:", fm[i])), None)
 24940	    if k0 is None:
 24941	        raise ValueError(f"決策 {did} 沒有欄位 {field}")
 24942	    def _ind(s):
 24943	        return len(s) - len(s.lstrip(" "))
 24944	    k1 = k0
 24945	    j = k0 + 1
 24946	    while j <= en:
 24947	        if not fm[j].strip():
 24948	            # 空行:後面還有比欄位深的行就算同一欄(多行值中間的空段落;代碼審 r1 正確性席:原本停在空行,後半段留在檔裡)
 24949	            nxt = next((q for q in range(j + 1, en + 1) if fm[q].strip()), None)
 24950	            if nxt is None or _ind(fm[nxt]) <= sub:
 24951	                break
 24952	            j += 1
 24953	            continue
 24954	        if _ind(fm[j]) <= sub:
 24955	            break
 24956	        k1 = j
 24957	        j += 1
 24958	    head_val = fm[k0].split(":", 1)[1].strip()
 24959	    # 欄位形狀照 parse_decisions 的判法:冒號後是空的=清單(或巢狀、空值),[ { 開頭=一行式清單或對照表;
 24960	    # 只有一般文字與 | > 多行文字能改(代碼審 r1、r2 外家席:原本會靜默把清單壓成一句)
 24961	    if not head_val or head_val.startswith(("[", "{")):
 24962	        raise ValueError(f"決策 {did} 的「{field}」是清單、巢狀或空的欄位,decision-amend 只改一段文字的欄位")
 24963	    lead = fm[k0][:fm[k0].index(field)]
 24964	    newtxt = text.replace("\n", " ").strip()
 24965	    new_fm = fm[:k0] + [f"{lead}{field}: {_fmt_decision_value(newtxt)}"] + fm[k1 + 1:]
 24966	    new_lines = lines[:1] + new_fm + lines[e_fm:]
 24967	
 24968	    def _check(_fields):
 24969	        for d in parse_decisions(_fm_of(new_lines)):
 24970	            if str(d.get("id", "")).strip() == did:
 24971	                return nfc(str(d.get(field, ""))).strip() == nfc(newtxt)
 24972	        return False
 24973	    atomic_write_verify(path, new_lines, "decisions", _check)
 24974	    print(f"✓ decision-amend {rel} {did}.{field} 改好了(這條決策還沒推上去)")
 24975	    return 0
