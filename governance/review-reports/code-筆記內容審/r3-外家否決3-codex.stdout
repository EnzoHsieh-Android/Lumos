 24978	def _ci_jobs_calling_without_full_history(ymls, needle):
 24979	    """GitHub Actions 設定裡,呼叫 needle(跳過註解行)的工作項目中,沒設 fetch-depth: 0 的那些 → [(檔名, 工作項目名)]。
 24980	    照工作項目切,不看整份:別的工作項目設了完整歷史,不代表呼叫這道檢查的那個有(筆記內容審代碼審 r2 外家席)。"""
 24981	    out = []
 24982	    for p in ymls:
 24983	        try:
 24984	            lines = [l for l in p.read_text(encoding="utf-8", errors="replace").split("\n") if not l.lstrip().startswith("#")]
 24985	        except OSError:
 24986	            continue
 24987	        jobs, cur, jind, in_jobs = {}, None, None, False
 24988	        for ln in lines:
 24989	            if not ln.strip():
 24990	                continue
 24991	            ind = len(ln) - len(ln.lstrip(" "))
 24992	            if re.match(r"^jobs:\s*$", ln):
 24993	                in_jobs, jind, cur = True, None, None
 24994	                continue
 24995	            if in_jobs and ind == 0:
 24996	                in_jobs, cur = False, None
 24997	            if not in_jobs:
 24998	                continue
 24999	            m = re.match(r"^(\s+)([\w.-]+):\s*$", ln)
 25000	            if m and (jind is None or ind == jind):
 25001	                jind, cur = ind, m.group(2)
 25002	                jobs[cur] = []
 25003	                continue
 25004	            if cur is not None:
 25005	                jobs[cur].append(ln)
 25006	        for name, body in jobs.items():
 25007	            text = "\n".join(body)
 25008	            if needle in text and "fetch-depth: 0" not in text:
 25009	                out.append((p.name, name))
 25010	    return out
 25011	
