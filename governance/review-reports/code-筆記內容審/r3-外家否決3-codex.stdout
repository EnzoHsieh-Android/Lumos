 29130	def _lens_range_ok(diff_range):
 29131	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 29132	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 29133	        return None
 29134	    parts = diff_range.split("..")
 29135	    if len(parts) != 2 or not parts[0] or not parts[1]:
 29136	        return None
 29137	    if any(ch.isspace() for ch in diff_range):
 29138	        return None
 29139	    return parts[0], parts[1]
