 24689	def cmd_note_audit_record(repo=None, diff_range=None, prepared=None, reports=None, dispute=False, disputes=None):
 24690	    """lumos note-audit record --diff A..B --prepared <清單> --report <報告>…[--dispute --disputes <判定檔>]
 24691	    (計劃〈做法〉第 3 節第 5 點)。照信任方向逐行收:重的(CODE/MIXED)照收,輕的(CONTEXT)要來源對、上下文沒變才收。"""
 24692	    root = _note_audit_root(repo)
 24693	    if root is None:
 24694	        return 2
 24695	    if not prepared or not reports:
 24696	        print("擋下:要給 --prepared <清單檔> 與至少一個 --report <報告>", file=sys.stderr)
 24697	        return 2
 24698	    try:
 24699	        # 照位元組讀:文字模式會把筆記裡的 CR 換掉,清單指紋就永遠對不上(代碼審 r1 正確性席:CRLF 筆記收不下脈絡判定)
 24700	        lst = _note_audit_parse_list(Path(prepared).read_bytes().decode("utf-8"))
 24701	    except (OSError, UnicodeDecodeError) as e:
 24702	        print(f"擋下:讀不了清單檔 {prepared}(不存在或不是 UTF-8):{e.__class__.__name__}", file=sys.stderr)
 24703	        return 2
 24704	    if lst is None:
 24705	        print(f"擋下:{prepared} 不是筆記內容審的清單檔", file=sys.stderr)
 24706	        return 2
 24707	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
 24708	    if tip is None or isinstance(tip, int):
 24709	        return tip if isinstance(tip, int) else 0
 24710	    got = _note_audit_items(root, base, tip, vault_rel)
 24711	    if got is None:
 24712	        return 2
 24713	    items, _errs = got
 24714	    cur_ctx = {}
 24715	    for it in items:
 24716	        cur_ctx.setdefault(it["id"], []).append(it["ctx_fp"])
 24717	    cur_ctx = {k: sorted(v) for k, v in cur_ctx.items()}
 24718	    target = None
 24719	    if dispute:
 24720	        if not disputes:
 24721	            print("擋下:--dispute 要配 --disputes <被申訴的判定檔名>", file=sys.stderr)
 24722	            return 2
 24723	        docs, _bad = _note_audit_load_verdicts(root, None)
 24724	        target = docs.get(Path(disputes).name)
 24725	        if target is None or target["kind"] != "判定":
 24726	            print(f"擋下:找不到被申訴的判定檔 {disputes}(要是工作目錄裡的一般判定檔)", file=sys.stderr)
 24727	            return 2
 24728	    written = []
 24729	    for rp in reports:
 24730	        try:
 24731	            head, rows = _note_audit_parse_report(Path(rp).read_bytes().decode("utf-8"))
 24732	        except (OSError, UnicodeDecodeError) as e:
 24733	            print(f"擋下:讀不了報告 {rp}(不存在或不是 UTF-8,請存成 UTF-8):{e.__class__.__name__}", file=sys.stderr)
 24734	            return 2
 24735	        prov_ok = (all(k in head for k in ("seat", "provider", "model", "prepared"))
 24736	                   and head.get("provider") == lst["orchestrator"] and head.get("model") == lst["model"]
 24737	                   and head.get("prepared") == lst["fp"] and lst["fp_ok"]
 24738	                   and str(lst["version"]) == str(_NOTE_AUDIT_PROMPT_VERSION))
 24739	        if dispute and head.get("seat") == target.get("seat"):
 24740	            print(f"擋下:{rp} 的席名跟被申訴那份一樣({head.get('seat')}),申訴要另派一席", file=sys.stderr)
 24741	            return 2
 24742	        best = {}
 24743	        for rid, cls, ev, why in rows:
 24744	            if cls is None:
 24745	                continue
 24746	            if rid not in best or _NOTE_AUDIT_WEIGHT[cls] > _NOTE_AUDIT_WEIGHT[best[rid][0]]:
 24747	                best[rid] = (cls, ev, why)
 24748	        keep, dropped = [], []
 24749	        for rid, (cls, ev, why) in best.items():
 24750	            if rid not in lst["rows"]:
 24751	                dropped.append((rid, "不在清單裡"))
 24752	                continue
 24753	            if dispute and not any(r["id"] == rid for r in target["rows"]):
 24754	                dropped.append((rid, "被申訴的判定檔沒判過這行"))
 24755	                continue
 24756	            heavy = cls in ("CODE", "MIXED")
 24757	            if not heavy and not prov_ok:
 24758	                dropped.append((rid, "來源對不上,輕的判定不收"))
 24759	                continue
 24760	            if not heavy and cur_ctx.get(rid) != lst["rows"][rid]:      # 每一處的上下文都要跟清單上的一樣
 24761	                dropped.append((rid, "上下文變了或那行不在了,輕的判定不收"))
 24762	                continue
 24763	            keep.append({"id": rid, "class": cls, "evidence": ev, "reason": why,
 24764	                         "evidence_ok": _note_audit_check_evidence(root, lst["tip"], ev) if heavy else None})
 24765	        if not keep:
 24766	            print(f"{rp}:沒有能收的行", file=sys.stderr)
 24767	            for rid, why in dropped[:10]:
 24768	                print(f"  {rid}:{why}", file=sys.stderr)
 24769	            continue
 24770	        doc = {"version": 1, "kind": "申訴" if dispute else "判定", "seat": head.get("seat"),
 24771	               "provider": head.get("provider"), "model": head.get("model"),
 24772	               "prompt_version": lst["version"], "prepared": lst["fp"], "prepared_tip": lst["tip"],
 24773	               "provenance_ok": prov_ok, "disputes": Path(disputes).name if dispute else None, "rows": keep}
 24774	        name = _note_audit_write_verdict(root, doc)
 24775	        written.append(name)
 24776	        cnt = {c: sum(1 for r in keep if r["class"] == c) for c in ("CODE", "MIXED", "CONTEXT")}
 24777	        _gate_event_or_warn(root, "note-audit", "recorded",
 24778	                            f"{name}:{'申訴' if dispute else '判定'} CODE {cnt['CODE']}/MIXED {cnt['MIXED']}/CONTEXT {cnt['CONTEXT']}")
 24779	        for rid, why in dropped[:10]:
 24780	            print(f"  沒收 {rid}:{why}", file=sys.stderr)

