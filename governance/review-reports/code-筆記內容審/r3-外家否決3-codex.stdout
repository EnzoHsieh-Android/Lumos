 29169	        if mb is not None and mb.returncode == 0 and mb.stdout.strip():
 29170	            return mb.stdout.strip(), f"{why}:從跟主線({ml[0]})的分岔點算"
 29171	    return _EMPTY_TREE_SHA, f"{why}:找不到主線,從空樹算(截到上線點)"
