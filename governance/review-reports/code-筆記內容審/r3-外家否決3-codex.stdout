 12926	def parse_decisions(fm_lines):
 12927	    """從 frontmatter 原始行解析 decisions 陣列(content/decided/valid/superseded_by/ended)"""
 12928	    items = []
 12929	    i, n = 0, len(fm_lines)
 12930	    while i < n and not re.match(r"^decisions:\s*$", fm_lines[i]):
 12931	        i += 1
 12932	    if i >= n:
 12933	        return items
 12934	    i += 1
 12935	    cur = None
 12936	
 12937	    def indent(s):
 12938	        return len(s) - len(s.lstrip(" "))
 12939	
 12940	    while i < n:
 12941	        line = fm_lines[i]
 12942	        if line.strip() and not line.startswith(" "):
 12943	            break  # 下一個 top-level key
 12944	        m_item = re.match(r"^(\s*)-\s+([\w-]+):\s*(.*)$", line)
 12945	        m_kv = re.match(r"^(\s+)([\w-]+):\s*(.*)$", line)
 12946	        if m_item:
 12947	            cur = {}
 12948	            items.append(cur)
 12949	            key, val = m_item.group(2), m_item.group(3).strip()
 12950	            base = indent(line)
 12951	            key_col = base + 2          # dash line: key 在「- 」之後,有效欄位 = base+2
 12952	        elif m_kv and cur is not None:
 12953	            key, val = m_kv.group(2), m_kv.group(3).strip()
 12954	            base = indent(line)
 12955	            key_col = base              # 子欄位: key 欄位 = base
 12956	        else:
 12957	            i += 1
 12958	            continue
 12959	        if val in ("|", "|-", ">", ">-"):
 12960	            # block scalar 終止 = 首個縮排 <= key_col 的非空行(否則會把兄弟欄位吸進 content,Bug1)
 12961	            block = []
 12962	            i += 1
 12963	            while i < n and (not fm_lines[i].strip() or indent(fm_lines[i]) > key_col):
 12964	                if fm_lines[i].strip():
 12965	                    block.append(fm_lines[i].strip())
 12966	                i += 1
 12967	            cur[key] = "\n".join(block)
 12968	            continue
 12969	        if val == "":
 12970	            lst = []
 12971	            i += 1
 12972	            while i < n and fm_lines[i].strip() and indent(fm_lines[i]) > base \
 12973	                    and re.match(r"^\s+-\s+", fm_lines[i]):
 12974	                lst.append(strip_quotes(re.match(r"^\s+-\s+(.*)$", fm_lines[i]).group(1).strip()))
 12975	                i += 1
 12976	            cur[key] = lst
 12977	            continue
 12978	        cur[key] = strip_quotes(val)
 12979	        i += 1
 12980	    return items
