 22723	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 22724	    raw = _nodehome_git(repo_root, *args)
 22725	    if raw is None:
 22726	        return None
 22727	    toks = _nodehome_split_z(raw)
 22728	    out, i = [], 0
 22729	    while i < len(toks):
 22730	        st = toks[i]
 22731	        code = st[:1]
 22732	        if code in ("R", "C") and i + 2 < len(toks):
 22733	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 22734	            i += 3
 22735	        elif i + 1 < len(toks):
 22736	            p = nfc(toks[i + 1])
 22737	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 22738	            i += 2
 22739	        else:
 22740	            break
 22741	    return out
