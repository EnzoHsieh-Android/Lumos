+    m = _load_lumos_inproc()
+    text = ("---\ntype: system\nsummary: |-\n  KEY:x\ndecisions:\n  - id: d1\n    decided: 2026-09-01\n"
+            "    context: 第一段\n      續行歸前一欄\n    why_chosen: 因為\n---\n# T\n## 甲\n同一句話\n```\n# 圍欄內不是標題\n```\n"
+            "~~~\n~~~\n| a | b |\n|---|:--:|\n---\n- \n1.\n- [ ]\n## 乙\n同一句話\n")
+    lines = text.split("\n")
+
+    def idx(s, nth=0):
