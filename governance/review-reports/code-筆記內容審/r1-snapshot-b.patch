+    check("⑥區塊不同 → 編號不同", i1 != m._notelines_content_id("p.md", "summary", "甲", "同一句話"), "")
+    struct = m._notelines_structural_lines(text)
+    for label, s, nth in (("三個反引號", "```", 0), ("三個波浪號", "~~~", 0), ("表格分隔", "|---|:--:|", 0),
