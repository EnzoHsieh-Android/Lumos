 24752	def cmd_note_audit_check(repo=None, diff_range=None):
 24753	    """lumos note-audit check --diff A..B(計劃〈做法〉第 3 節第 6 點):判定檔只認被推送頂端提交裡的。
 24754	    每一行都被涵蓋 rc0;否則 rc1(warn 模式只印、rc0);參數錯 rc2;不是 git / 沒圖譜 / 開關 off / 淺層 clone rc0。"""
 24755	    root = _note_audit_root(repo)
 24756	    if root is None:
 24757	        print("筆記內容審:這裡不是 git 專案,跳過", file=sys.stderr)
 24758	        return 0
 24759	    if os.environ.get("LUMOS_SKIP_NOTE_AUDIT"):
 24760	        print("筆記內容審:LUMOS_SKIP_NOTE_AUDIT 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 24761	        _gate_event_or_warn(root, "note-audit", "skipped-env", "LUMOS_SKIP_NOTE_AUDIT")
 24762	        return 0
 24763	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
 24764	    if tip is None or isinstance(tip, int):
 24765	        return tip if isinstance(tip, int) else 0
 24766	    mode, warns = _note_audit_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 24767	    for w in warns:
 24768	        print(f"提醒:{w}", file=sys.stderr)
 24769	    if mode == "off":
 24770	        print("筆記內容審:這個專案把這道檢查關掉了(note_audit.gate=off),跳過", file=sys.stderr)
 24771	        return 0
 24772	    got = _note_audit_items(root, base, tip, vault_rel)
 24773	    if got is None:
 24774	        print("筆記內容審:git 算不出這次的筆記行,跳過(fail-open)", file=sys.stderr)
 24775	        return 0
 24776	    items, errs = got
 24777	    docs, bad = _note_audit_load_verdicts(root, tip)
 24778	    for n in bad:
 24779	        print(f"提醒:判定檔 {n} 壞掉了,當作不存在", file=sys.stderr)
 24780	    fold = _note_audit_fold(docs)
 24781	    left = [it for it in items if not _note_audit_covered(fold.get(it["id"]))]
 24782	    if not left and not errs:
 24783	        return 0
 24784	    wdocs, _wb = _note_audit_load_verdicts(root, None)
 24785	    wfold = _note_audit_fold(wdocs)
 24835	    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
 24836	    return 0
