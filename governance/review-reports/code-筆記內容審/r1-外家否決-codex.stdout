 24484	def _note_audit_head_split(rows, cur, it):
 24485	    """單篇超過一批時:換小標題的地方,如果把下一個小標題整段放進來會超過一批,就在這裡切。"""
 24486	    nxt = sum(1 for r in rows if r["heading"] == it["heading"])
 24487	    return len(cur) + nxt > _NOTE_AUDIT_BATCH
