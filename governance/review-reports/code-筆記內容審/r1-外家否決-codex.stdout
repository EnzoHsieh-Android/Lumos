 24455	def _note_audit_batches(pending):
 24456	    """待審超過 150 行就切:先照筆記分組、同篇同份;單篇超過時在小標題邊界切;單一小標題下還超過就照行數硬切。"""
 24457	    groups = []
 24458	    for p in sorted({it["path"] for it in pending}):
 24459	        rows = [it for it in pending if it["path"] == p]
 24460	        if len(rows) <= _NOTE_AUDIT_BATCH:
 24461	            groups.append(rows)
 24462	            continue
 24463	        cur, cur_head = [], None
 24464	        for it in rows:
 24465	            new_head = cur and it["heading"] != cur_head
 24466	            if cur and (len(cur) >= _NOTE_AUDIT_BATCH or (new_head and _note_audit_head_split(rows, cur, it))):
 24467	                groups.append(cur)
 24468	                cur = []
 24469	            cur.append(it)
 24470	            cur_head = it["heading"]
 24471	        if cur:
 24472	            groups.append(cur)
 24473	    batches, cur = [], []
 24474	    for g in groups:
 24475	        if cur and len(cur) + len(g) > _NOTE_AUDIT_BATCH:
 24476	            batches.append(cur)
 24477	            cur = []
 24478	        cur.extend(g)
 24479	    if cur:
 24480	        batches.append(cur)
 24481	    return batches
