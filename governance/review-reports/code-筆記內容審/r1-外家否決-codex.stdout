 24392	    if rg is None:
 24393	        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 24394	        return None, 2, None
 24395	    sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 24396	    if sh is not None and sh.stdout.strip() == "true":
 24397	        print(f"{gate_word}:淺層 clone 算不出範圍,這次不查——CI 請設 fetch-depth: 0", file=sys.stderr)
 24398	        _gate_event_or_warn(root, "note-audit", "skipped-env", "shallow clone")
 24399	        return None, 0, None
 24400	    a, b = rg
 24401	    tip = _lens_full_sha(root, b)
 24402	    if tip is None:
 24403	        print(f"{gate_word}:範圍 {diff_range} 的終點在本機找不到,跳過(fail-open)", file=sys.stderr)
 24404	        return None, 0, None
 24405	    base, why = _lens_push_base(root, a, tip)
 24406	    if why:
 24407	        print(f"{gate_word}:{why}", file=sys.stderr)
 24408	    if base is None:
