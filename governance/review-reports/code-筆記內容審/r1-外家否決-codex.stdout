+def _note_audit_work_dir(root):
+    d = Path(root) / _NOTE_AUDIT_WORK_DIR
+    first = not d.exists()
+    d.mkdir(parents=True, exist_ok=True)
+    if first or not (d / ".gitignore").exists():
+        _write_lf(d / ".gitignore", "*\n")
+    import time as _t
+    for f in d.glob("*.md"):
+        try:
+            if _t.time() - f.stat().st_mtime > 14 * 86400:
+                f.unlink()
+        except OSError:
+            pass
+    return d
+
+
+def cmd_note_audit_prepare(repo=None, diff_range=None, orchestrator=None, only=None):
+    """lumos note-audit prepare --diff A..B --orchestrator claude|codex [--only 編號…](計劃〈做法〉第 3 節第 1 點)。"""
+    import datetime as _dt
+    root = _note_audit_root(repo)
+    if root is None:
+        print("筆記內容審:這裡不是 git 專案", file=sys.stderr)
+        return 2
+    if orchestrator not in ("claude", "codex"):
+        print("擋下:--orchestrator 要給 claude 或 codex(編排這次的那一家;判定者跟它同一家)", file=sys.stderr)
+        return 2
+    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
+    if tip is None or isinstance(tip, int):
+        return tip if isinstance(tip, int) else 0
+    got = _note_audit_items(root, base, tip, vault_rel)
+    if got is None:
+        print("筆記內容審:git 算不出這次的筆記行", file=sys.stderr)
+        return 2
+    items, errs = got
+    for e in errs:
+        print(f"  {e}", file=sys.stderr)
+    docs, bad = _note_audit_load_verdicts(root, None)
+    for n in bad:
+        print(f"提醒:判定檔 {n} 壞掉了(讀不成 JSON 或缺欄位),當作不存在", file=sys.stderr)
+    fold = _note_audit_fold(docs)
+    uniq = {}
+    for it in items:
+        uniq.setdefault(it["id"], it)
+    pending = [it for it in uniq.values() if not _note_audit_covered(fold.get(it["id"]))]
+    if only:
+        want = set(only)
+        pending = [it for it in uniq.values() if it["id"] in want]
+    if not pending:
+        print("沒有待審的筆記行")
+        return 0
+    prompt = _note_audit_prompt(root)
+    if prompt is None:
+        print(f"擋下:找不到派工詞範本 {_NOTE_AUDIT_TEMPLATE}(跑一次 lumos update)", file=sys.stderr)
+        return 2
+    wd = _note_audit_work_dir(root)
+    outs = []
+    for batch in _note_audit_batches(pending):
+        content, fp = _note_audit_render_list(orchestrator, tip, batch, prompt)
+        f = wd / f"{fp}-{orchestrator}.md"
+        _write_lf(f, content)
+        outs.append((f, fp, len(batch)))
+        _gate_event_or_warn(root, "note-audit", "prepare", f"清單 {fp}:{len(batch)} 行")
+    print(f"待審 {len(pending)} 行,切成 {len(outs)} 份清單;每份派一席 {_note_audit_judge_model(orchestrator)}"
+          f"(跟編排者同一家),報告照清單開頭的格式寫:")
+    for f, fp, n in outs:
+        print(f"  {f}  ({n} 行,清單指紋 {fp})")
+    print("判定者交回報告後:\n    lumos note-audit record --diff <同一個範圍> --prepared <清單檔> --report <報告>")
+    return 0
+
+
+def cmd_note_audit_record(repo=None, diff_range=None, prepared=None, reports=None, dispute=False, disputes=None):
+    """lumos note-audit record --diff A..B --prepared <清單> --report <報告>…[--dispute --disputes <判定檔>]
+    (計劃〈做法〉第 3 節第 5 點)。照信任方向逐行收:重的(CODE/MIXED)照收,輕的(CONTEXT)要來源對、上下文沒變才收。"""
+    root = _note_audit_root(repo)
+    if root is None:
+        return 2
+    if not prepared or not reports:
+        print("擋下:要給 --prepared <清單檔> 與至少一個 --report <報告>", file=sys.stderr)
+        return 2
+    try:
+        lst = _note_audit_parse_list(Path(prepared).read_text(encoding="utf-8"))
+    except OSError as e:
+        print(f"擋下:讀不到清單檔 {prepared}:{e}", file=sys.stderr)
+        return 2
+    if lst is None:
+        print(f"擋下:{prepared} 不是筆記內容審的清單檔", file=sys.stderr)
+        return 2
+    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
+    if tip is None or isinstance(tip, int):
+        return tip if isinstance(tip, int) else 0
+    got = _note_audit_items(root, base, tip, vault_rel)
+    if got is None:
+        return 2
+    items, _errs = got
+    cur_ctx = {}
+    for it in items:
+        cur_ctx.setdefault(it["id"], it["ctx_fp"])
+    target = None
+    if dispute:
+        if not disputes:
+            print("擋下:--dispute 要配 --disputes <被申訴的判定檔名>", file=sys.stderr)
+            return 2
+        docs, _bad = _note_audit_load_verdicts(root, None)
+        target = docs.get(Path(disputes).name)
+        if target is None or target["kind"] != "判定":
+            print(f"擋下:找不到被申訴的判定檔 {disputes}(要是工作目錄裡的一般判定檔)", file=sys.stderr)
+            return 2
+    written = []
+    for rp in reports:
+        try:
+            head, rows = _note_audit_parse_report(Path(rp).read_text(encoding="utf-8"))
+        except OSError as e:
+            print(f"擋下:讀不到報告 {rp}:{e}", file=sys.stderr)
+            return 2
+        prov_ok = (all(k in head for k in ("seat", "provider", "model", "prepared"))
+                   and head.get("provider") == lst["orchestrator"] and head.get("model") == lst["model"]
+                   and head.get("prepared") == lst["fp"] and lst["fp_ok"]
+                   and str(lst["version"]) == str(_NOTE_AUDIT_PROMPT_VERSION))
+        if dispute and head.get("seat") == target.get("seat"):
+            print(f"擋下:{rp} 的席名跟被申訴那份一樣({head.get('seat')}),申訴要另派一席", file=sys.stderr)
+            return 2
+        best = {}
+        for rid, cls, ev, why in rows:
+            if cls is None:
+                continue
+            if rid not in best or _NOTE_AUDIT_WEIGHT[cls] > _NOTE_AUDIT_WEIGHT[best[rid][0]]:
+                best[rid] = (cls, ev, why)
+        keep, dropped = [], []
+        for rid, (cls, ev, why) in best.items():
+            if rid not in lst["rows"]:
+                dropped.append((rid, "不在清單裡"))
+                continue
+            if dispute and not any(r["id"] == rid for r in target["rows"]):
+                dropped.append((rid, "被申訴的判定檔沒判過這行"))
+                continue
+            heavy = cls in ("CODE", "MIXED")
+            if not heavy and not prov_ok:
+                dropped.append((rid, "來源對不上,輕的判定不收"))
+                continue
+            if not heavy and cur_ctx.get(rid) != lst["rows"][rid]:
+                dropped.append((rid, "上下文變了或那行不在了,輕的判定不收"))
+                continue
+            keep.append({"id": rid, "class": cls, "evidence": ev, "reason": why,
+                         "evidence_ok": _note_audit_check_evidence(root, lst["tip"], ev) if heavy else None})
+        if not keep:
+            print(f"{rp}:沒有能收的行", file=sys.stderr)
+            for rid, why in dropped[:10]:
+                print(f"  {rid}:{why}", file=sys.stderr)
+            continue
+        doc = {"version": 1, "kind": "申訴" if dispute else "判定", "seat": head.get("seat"),
+               "provider": head.get("provider"), "model": head.get("model"),
+               "prompt_version": lst["version"], "prepared": lst["fp"], "prepared_tip": lst["tip"],
+               "provenance_ok": prov_ok, "disputes": Path(disputes).name if dispute else None, "rows": keep}
+        name = _note_audit_write_verdict(root, doc)
+        written.append(name)
+        cnt = {c: sum(1 for r in keep if r["class"] == c) for c in ("CODE", "MIXED", "CONTEXT")}
+        _gate_event_or_warn(root, "note-audit", "recorded",
+                            f"{name}:{'申訴' if dispute else '判定'} CODE {cnt['CODE']}/MIXED {cnt['MIXED']}/CONTEXT {cnt['CONTEXT']}")
+        for rid, why in dropped[:10]:
+            print(f"  沒收 {rid}:{why}", file=sys.stderr)
+    docs, _bad = _note_audit_load_verdicts(root, None)
+    fold = _note_audit_fold(docs)
+    left = [it for it in items if not _note_audit_covered(fold.get(it["id"]))]
+    print(f"寫了 {len(written)} 個判定檔:" + ", ".join(written))
+    if left:
+        print(f"還沒被涵蓋的行 {len(left)} 行(判了推得出/一半一半但還在的要刪或改,沒人判的要再 prepare):")
+        for it in left[:20]:
+            print(f"  {it['path']}:{it['line']}  [{fold.get(it['id'], '沒判過')}]  {it['text'].strip()[:60]}")
+    if written:
+        print("判定檔要提交才算數:\n    git add " + _NOTE_AUDIT_VERDICT_DIR + " && git commit")
+    return 0
+
+
+def cmd_note_audit_check(repo=None, diff_range=None):
+    """lumos note-audit check --diff A..B(計劃〈做法〉第 3 節第 6 點):判定檔只認被推送頂端提交裡的。
+    每一行都被涵蓋 rc0;否則 rc1(warn 模式只印、rc0);參數錯 rc2;不是 git / 沒圖譜 / 開關 off / 淺層 clone rc0。"""
+    root = _note_audit_root(repo)
+    if root is None:
+        print("筆記內容審:這裡不是 git 專案,跳過", file=sys.stderr)
+        return 0
+    if os.environ.get("LUMOS_SKIP_NOTE_AUDIT"):
+        print("筆記內容審:LUMOS_SKIP_NOTE_AUDIT 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
+        _gate_event_or_warn(root, "note-audit", "skipped-env", "LUMOS_SKIP_NOTE_AUDIT")
+        return 0
+    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
+    if tip is None or isinstance(tip, int):
+        return tip if isinstance(tip, int) else 0
+    mode, warns = _note_audit_config(_nodehome_reader(root, tip)(".lumos/config.json"))
+    for w in warns:
+        print(f"提醒:{w}", file=sys.stderr)
+    if mode == "off":
+        print("筆記內容審:這個專案把這道檢查關掉了(note_audit.gate=off),跳過", file=sys.stderr)
+        return 0
+    got = _note_audit_items(root, base, tip, vault_rel)
+    if got is None:
+        print("筆記內容審:git 算不出這次的筆記行,跳過(fail-open)", file=sys.stderr)
+        return 0
+    items, errs = got
+    docs, bad = _note_audit_load_verdicts(root, tip)
+    for n in bad:
+        print(f"提醒:判定檔 {n} 壞掉了,當作不存在", file=sys.stderr)
+    fold = _note_audit_fold(docs)
+    left = [it for it in items if not _note_audit_covered(fold.get(it["id"]))]
+    if not left and not errs:
+        return 0
+    wdocs, _wb = _note_audit_load_verdicts(root, None)
+    wfold = _note_audit_fold(wdocs)
+    uncommitted = [it for it in left if _note_audit_covered(wfold.get(it["id"]))]
+    head = "擋下" if mode == "block" else "提醒(note_audit.gate=warn,不擋)"
+    print(f"{head}:這次推送有 {len(left)} 行新寫的筆記還沒被判定涵蓋(筆記內容審)——", file=sys.stderr)
+    for e in errs:
+        print(f"  {e}", file=sys.stderr)
+    for it in left[:20]:
+        print(f"  {it['path']}:{it['line']}  [{fold.get(it['id'], '沒判過')}]  {it['text'].strip()[:60]}", file=sys.stderr)
+    if len(left) > 20:
+        print(f"  …還有 {len(left) - 20} 行", file=sys.stderr)
+    print(f"派判定者審:\n    lumos note-audit prepare --diff {diff_range} --orchestrator <claude|codex>", file=sys.stderr)
+    if uncommitted:
+        print(f"其中 {len(uncommitted)} 行在工作目錄的判定檔裡已經涵蓋、但還沒提交:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit",
+              file=sys.stderr)
+    if mode == "block":
+        _gate_event_or_warn(root, "note-audit", "blocked", f"沒涵蓋 {len(left)} 行", hard=True,
+                            nodes=sorted({it["path"] for it in left})[:50])
+        return 1
+    _gate_event_or_warn(root, "note-audit", "warned", f"沒涵蓋 {len(left)} 行(warn 模式不擋)")
+    return 0
+
+
+def cmd_note_audit_skip(repo=None, diff_range=None, note=None):
+    """lumos note-audit skip --diff A..B --note "理由"(計劃〈做法〉第 3 節第 7 點):只略過從來沒被判過的行。"""
+    root = _note_audit_root(repo)
+    if root is None:
+        return 2
+    if not note or len(note.strip()) < 4:
+        print("擋下:--note 要寫理由,至少 4 個字", file=sys.stderr)
+        return 2
+    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
+    if tip is None or isinstance(tip, int):
+        return tip if isinstance(tip, int) else 0
+    got = _note_audit_items(root, base, tip, vault_rel)
+    if got is None:
+        return 2
+    items, _errs = got
+    docs, _bad = _note_audit_load_verdicts(root, None)
+    fold = _note_audit_fold(docs)
+    judged = set(fold)
+    todo = sorted({it["id"] for it in items if it["id"] not in judged})
+    heavy = sorted({it["id"] for it in items if fold.get(it["id"]) in ("CODE", "MIXED")})
+    if heavy:
+        print(f"注意:{len(heavy)} 行已經判了推得出或一半一半,不能略過——要刪、改,或申訴", file=sys.stderr)
+    if not todo:

exec
/bin/zsh -lc "sed -n '1201,1528p' governance/review-reports/code-筆記內容審/r1-snapshot-a.patch" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-ns
 succeeded in 0ms:
+        print("沒有可以略過的行")
+        return 0
+    name = _note_audit_write_verdict(root, {"version": 1, "kind": "略過", "note": note.strip(),
+                                            "rows": [{"id": i, "class": "SKIP"} for i in todo]})
+    _gate_event_or_warn(root, "note-audit", "skipped", f"{name}:略過 {len(todo)} 行:{note.strip()[:80]}")
+    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
+    return 0
