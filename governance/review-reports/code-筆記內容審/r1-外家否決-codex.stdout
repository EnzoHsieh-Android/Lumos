 24518	    meta = dict(re.findall(r"^(編排者|判定者模型|派工詞版本|清單指紋): (.+)$", head, re.M))
 24519	    m = re.search(r"^頂端提交: ([0-9a-f]{40})$", body, re.M)
 24520	    rows = dict(re.findall(r"^## ([0-9a-f]{16}) \|.*\n上下文指紋: ([0-9a-f]{16})$", body, re.M))
 24521	    if not meta.get("清單指紋") or not m:
 24522	        return None
