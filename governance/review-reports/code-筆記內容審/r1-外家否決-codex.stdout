 24388	def _note_audit_resolve(root, diff_range, gate_word):
 24389	    """--diff 範圍 → (base_where, tip, vault_rel) 或 (None, rc, None)。起點照三道檢查共用的 _lens_push_base,
 24390	    再截到第二層上線點(推送前掛鉤的標記)。"""
