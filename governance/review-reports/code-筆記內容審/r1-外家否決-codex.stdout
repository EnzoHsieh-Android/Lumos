 24496	                    + (" | 完成審" if it["done"] else ""))
 24497	        body.append(f"上下文指紋: {it['ctx_fp']}")
 24498	        body.append("~~~~text")
 24499	        body.extend(f"    {x}" for x in it["context"][0])
 24500	        body.append(f">>> {it['text']}")
 24501	        body.extend(f"    {x}" for x in it["context"][1])
 24502	        body.append("~~~~")
 24503	        body.append("")
 24504	    body_s = "\n".join(body)
 24505	    fp = hashlib.sha256(body_s.encode("utf-8")).hexdigest()[:16]
 24506	    head = ["# 筆記內容審清單", "", f"編排者: {orchestrator}", f"判定者模型: {_note_audit_judge_model(orchestrator)}",
 24507	            f"派工詞版本: {_NOTE_AUDIT_PROMPT_VERSION}", f"清單指紋: {fp}", "", "## 派工詞", "", prompt, "",
 24508	            "---本文---"]
 24509	    return "\n".join(head) + "\n" + body_s, fp
