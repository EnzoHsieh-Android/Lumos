+def _notelines_structural_lines(text):
+    """沒有主張、不審的行號集合(Projects/筆記內容審_計劃 [S4]):圍欄記號行(照 _visible_lines 認的)、表格分隔行、
+    分隔線、只有清單記號的行。空白行本來就不收,不在這裡。"""
+    lines = text.split("\n")
+    kept = {i for i, _l in _visible_lines(lines, keep_fenced=True)}
+    out = set()
+    for i, ln in enumerate(lines, 1):
+        if not ln.strip():
+            continue
+        if i not in kept or _NOTELINES_TABLE_SEP_RE.match(ln) and "|" in ln or _NOTELINES_RULE_RE.match(ln) \
+                or _NOTELINES_BARE_LIST_RE.match(ln):
+            out.add(i)
+    return out
+
