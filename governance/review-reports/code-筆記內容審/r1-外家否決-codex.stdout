 24839	def cmd_decision_amend(env, rel, did, field, text):
 24840	    """lumos decision-amend <節點> <決策編號> --field <欄名> --text "<新文字>"(計劃〈做法〉第 3 節第 4 點):
 24841	    只改還沒推上去的決策的一個文字子欄。先 fetch 所有遠端,再對每個遠端追蹤參照用改名偵測找這篇的舊路徑:
 24842	    那個版本裡有這個決策編號就拒絕(已推或撞號,兩種都講)。"""
 24843	    if field in ("id", "decided", "valid", "superseded_by", "ended", "decided_by", "replaces"):
 24844	        raise ValueError(f"「{field}」是結構欄,不能用 decision-amend 改;要翻案用 decision-supersede")
 24845	    if not re.fullmatch(r"d\d+", did or ""):
 24846	        raise ValueError("決策編號要寫成 d1、d2 這種形狀")
 24847	    path = env.vault / rel
 24848	    top = _lens_git(env.vault, "rev-parse", "--show-toplevel")
 24849	    if top is None or top.returncode != 0 or not top.stdout.strip():
 24850	        raise ValueError("這篇筆記不在 git 專案裡")
 24851	    root = Path(top.stdout.strip())
 24852	    rels = path.resolve().relative_to(root.resolve()).as_posix()
 24853	    # 改名偵測的路徑篩選給整個圖譜夾:只給新路徑的話舊路徑不在篩選裡,git 認不出改名
 24854	    vrel = env.vault.resolve().relative_to(root.resolve()).as_posix()
 24855	    rm = _lens_git(root, "remote")
 24856	    remotes = [x for x in (rm.stdout.split() if rm is not None and rm.returncode == 0 else []) if x]
 24857	    if remotes:
 24858	        f = _lens_git(root, "fetch", "--all", "--quiet")
 24859	        if f is None or f.returncode != 0:
 24860	            raise ValueError("git fetch --all 失敗(沒網路或遠端要驗證),確認不了這條決策有沒有推上去,不改。"
 24861	                             + ((" " + f.stderr.strip()[:200]) if f is not None else ""))
 24862	        refs = _lens_git(root, "for-each-ref", "--format=%(refname)", "refs/remotes")
 24863	        for ref in (refs.stdout.split() if refs is not None and refs.returncode == 0 else []):
 24864	            if ref.endswith("/HEAD"):
 24865	                continue
 24866	            ns = _ns_git(root, "diff", "--name-status", "-z", "-M", ref, "HEAD", "--", vrel)
 24867	            old = rels
 24868	            if ns is not None:
 24869	                src = _nodehome_name_status(ns, norm=False)[1]
 24870	                old = src.get(rels, rels)
 24871	            b = _nodehome_cat_blobs(root, [f"{ref}:{old}"])
 24872	            if b and b[0] is not None:
 24873	                if re.search(rf"^\s*(?:-\s+)?id:\s*{re.escape(did)}\s*$", b[0].decode("utf-8", errors="replace"), re.M):
 24874	                    raise ValueError(f"遠端 {ref} 上的這篇已經有決策 {did}:可能①已經推上去了——請用 "
 24875	                                     f"lumos decision-supersede 翻案;或②兩條分支撞號——請先把你的決策改號")
 24876	    lines, s_fm, e_fm = load_raw_for_edit(path)
 24877	    fm = lines[1:e_fm]
 24878	    loc = decisions_items(fm)
 24879	    if loc is None or not loc[2]:
 24880	        raise ValueError("這篇筆記沒有讀得出的決策紀錄(decisions)")
 24881	    _s, _e, items, _ii, sub = loc
 24882	    pad = " " * sub
 24883	    hit = [(st, en) for st, en in items
 24884	           if any(re.match(rf"^\s*(?:-\s+)?id:\s*{re.escape(did)}\s*$", fm[i]) for i in range(st, en + 1))]
 24885	    if not hit:
 24886	        raise ValueError(f"找不到決策 {did}")
 24887	    st, en = hit[0]
 24888	    k0 = next((i for i in range(st, en + 1) if re.match(rf"^(?:{pad}|\s*-\s+){re.escape(field)}:", fm[i])), None)
 24889	    if k0 is None:
 24890	        raise ValueError(f"決策 {did} 沒有欄位 {field}")
 24891	    k1 = k0
 24892	    while k1 + 1 <= en and (len(fm[k1 + 1]) - len(fm[k1 + 1].lstrip(" "))) > sub and not \
 24893	            re.match(rf"^{pad}[A-Za-z_][\w-]*:", fm[k1 + 1]):
 24894	        k1 += 1
 24895	    lead = fm[k0][:fm[k0].index(field)]
 24896	    newtxt = text.replace("\n", " ").strip()
 24897	    new_fm = fm[:k0] + [f"{lead}{field}: {_fmt_decision_value(newtxt)}"] + fm[k1 + 1:]
 24898	    new_lines = lines[:1] + new_fm + lines[e_fm:]
 24899	
 24900	    def _check(_fields):
 24901	        for d in parse_decisions(_fm_of(new_lines)):
 24902	            if str(d.get("id", "")).strip() == did:
 24903	                return nfc(str(d.get(field, ""))).strip() == nfc(newtxt)
 24904	        return False
 24905	    atomic_write_verify(path, new_lines, "decisions", _check)
 24906	    print(f"✓ decision-amend {rel} {did}.{field} 改好了(這條決策還沒推上去)")
 24907	    return 0
