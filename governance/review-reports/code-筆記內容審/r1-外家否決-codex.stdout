+        return "block", []
+    try:
+        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
+    except (ValueError, UnicodeDecodeError):
+        return "block", [".lumos/config.json 讀不成 JSON,筆記內容審照預設 block"]
+    na = cfg.get("note_audit") if isinstance(cfg, dict) else None
+    g = na.get("gate") if isinstance(na, dict) else None
+    if g is None:
+        return "block", []
+    if g not in _NOTE_AUDIT_GATE_VALUES:
+        return "block", [f"note_audit.gate 只能是 block/warn/off,你寫的是 {g!r},照 block"]
+    return g, []
+
+
+def _note_audit_status_of(blob):
+    """筆記內容(bytes)→ (type, status)。讀不到回 (None, None)。"""
+    if blob is None:
+        return None, None
+    try:
+        fm, _b = split_frontmatter(blob.decode("utf-8-sig"))
+    except UnicodeDecodeError:
+        return None, None
+    if not fm:
+        return None, None
+    fields = parse_frontmatter(fm)[0]
+    return str(fields.get("type", "")).strip() or None, str(fields.get("status", "")).strip() or None
+
+
+def _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader):
+    """範圍裡被收尾的計劃(計劃〈做法〉第 1 節):`type: project`、終點 status 是 done/superseded,而且範圍裡有某個提交
+    把它從非收尾改成收尾——逐提交讀那篇的 status(改名跟著走;起點沒有這篇時第一個提交就算)。回 [路徑]。"""
+    # 候選=範圍裡任一個提交碰過的筆記,不是頭尾淨差異:收尾→改回→再收尾時頭尾一模一樣,淨差異看不到(S3)
+    rng0 = f"{base_where}..{tip_where}" if base_where else tip_where
+    touched = _ns_git(repo_root, "log", "--format=", "--name-only", "-z", "-M", rng0, "--", vault_rel)
+    if touched is None:
+        return None
+    out = []
+    for p in sorted({x.strip("\n") for x in touched.decode("utf-8", errors="surrogateescape").split("\0")
+                     if x.strip("\n").endswith(".md")}):
+        ty, st = _note_audit_status_of(reader(p))
+        if ty != "project" or st not in _NOTE_AUDIT_CLOSED:
+            continue
+        rng = f"{base_where}..{tip_where}" if base_where else tip_where
+        lg = _ns_git(repo_root, "log", "--follow", "--format=%H", "--name-only", "-z", rng, "--", p)
+        if lg is None:
+            return None
+        # git log -z --format=%H --name-only:「sha\0\n路徑\0」一筆接一筆(實測;換行黏在路徑前面);逐筆取 (sha, 那時的路徑)
+        pairs, cur = [], None
+        for tok in lg.decode("utf-8", errors="surrogateescape").split("\0"):
+            tok = tok.strip("\n")
+            if not tok:
+                continue
+            if cur is None and _LENS_SHA_RE.fullmatch(tok):
+                cur = tok
+            elif cur is not None:
+                pairs.append((cur, tok))
+                cur = None
+        specs = [f"{s}:{q}" for s, q in pairs]
+        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
+        states = [_note_audit_status_of(b)[1] for b in (blobs or [])]
+        old = pairs[-1][1] if pairs else p
+        base_state = None
+        if base_where:
+            bb = _nodehome_cat_blobs(repo_root, [f"{base_where}:{old}"])
+            base_state = _note_audit_status_of(bb[0] if bb else None)[1]
+        seq = [base_state] + states[::-1]          # 由舊到新
+        if any((a not in _NOTE_AUDIT_CLOSED) and (b in _NOTE_AUDIT_CLOSED) for a, b in zip(seq, seq[1:], strict=False)):
+            out.append(p)
+    return out
+
+
+def _note_audit_items(repo_root, base_where, tip_where, vault_rel):
+    """這次要審的每一行 → (items, errs) 或 None。item={id, path, line, text, region, heading, done, context, ctx_fp}。
+    一般新寫的行借第一層的共用函式(推送前掛鉤的標記、不逐提交判);被收尾的計劃整篇進完成審(已翻案的決策不進)。"""
+    import hashlib
+    reader = _nodehome_reader(repo_root, tip_where)
+    res = _notelines_new(repo_root, False, base_where, tip_where, vault_rel, reader=reader,
+                         mark=_NOTE_AUDIT_GOLIVE_MARK, hook=_NOTELINES_PREPUSH, per_commit=False)
+    if res is None:
+        return None
+    notes, errs, _old = res
+    closed = _note_audit_closed_plans(repo_root, base_where, tip_where, vault_rel, reader)
+    if closed is None:
+        return None
+    rows_by = {p: (text, {i for i, _l, _r in rows}) for p, text, rows in notes}
+    for p in closed:
+        if p in rows_by:
+            continue
+        b = reader(p)
+        try:
+            rows_by[p] = (b.decode("utf-8-sig"), set())
+        except (UnicodeDecodeError, AttributeError):
+            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
+    items = []
+    for p, (text, new_lines) in sorted(rows_by.items()):
+        lines = text.split("\n")
+        regs = _notelines_regions(text)
+        heads = _notelines_headings(text, regs)
+        struct = _notelines_structural_lines(text)
+        dfields = _notelines_decision_fields(text) if p in closed else {}
+        for i, ln in enumerate(lines, 1):
+            reg = regs[i - 1]
+            if not ln.strip() or reg == "other" or i in struct:
+                continue
+            done = p in closed
+            if done and reg == "decisions" and not dfields.get(i, ("", "", True))[2]:
+                if i not in new_lines:
+                    continue
+                done = False                        # 已翻案的決策只排除在完成審外,新寫的行照一般規則判
+            if not done and i not in new_lines:
+                continue
+            ctx = lines[max(0, i - 3):i - 1] + lines[i:i + 2]
+            items.append({"id": _notelines_content_id(p, reg, heads[i - 1], ln, done=done), "path": p, "line": i,
+                          "text": ln, "region": reg, "heading": heads[i - 1], "done": done,
+                          "context": (lines[max(0, i - 3):i - 1], lines[i:i + 2]),
+                          "ctx_fp": hashlib.sha256("\n".join(ctx).encode("utf-8")).hexdigest()[:16]})
+    return items, errs
+
+
+def _note_audit_parse_verdict(raw):
+    """判定檔內容 → dict 或 None(壞掉)。"""
+    import json as _j
+    try:
+        d = _j.loads(raw.decode("utf-8") if isinstance(raw, bytes) else raw)
+    except (ValueError, UnicodeDecodeError):
+        return None
+    if not isinstance(d, dict) or d.get("kind") not in ("判定", "申訴", "略過") or not isinstance(d.get("rows"), list):
+        return None
+    for r in d["rows"]:
+        if not isinstance(r, dict) or not isinstance(r.get("id"), str) or r.get("class") not in ("CODE", "MIXED", "CONTEXT", "SKIP"):
+            return None
+    return d
+
+
+def _note_audit_load_verdicts(repo_root, where):
+    """讀判定檔 → ({檔名: dict}, [壞掉的檔名])。where=None 讀工作目錄;給提交就讀那個提交的樹(check 只認這個)。
+    只有檔名合格式的才算(`_write_lf` 中斷留下的暫存檔不算)。"""
+    root = Path(repo_root)
+    docs, bad = {}, []
+    if where is None:
+        d = root / _NOTE_AUDIT_VERDICT_DIR
+        if not d.is_dir():
+            return docs, bad
+        for f in sorted(d.iterdir()):
+            if not _NOTE_AUDIT_VERDICT_NAME_RE.match(f.name) or not f.is_file() or f.is_symlink():
+                continue
+            v = _note_audit_parse_verdict(f.read_bytes())
+            (docs.__setitem__(f.name, v) if v is not None else bad.append(f.name))
+        return docs, bad
+    ls = _nodehome_git(repo_root, "ls-tree", "-z", "--name-only", f"{where}:{_NOTE_AUDIT_VERDICT_DIR}")
+    if ls is None:
+        return docs, bad
+    names = [n for n in _nodehome_split_z(ls) if _NOTE_AUDIT_VERDICT_NAME_RE.match(n)]
+    blobs = _nodehome_cat_blobs(repo_root, [f"{where}:{_NOTE_AUDIT_VERDICT_DIR}/{n}" for n in names]) if names else []
+    for n, b in zip(names, blobs or [], strict=False):
+        v = _note_audit_parse_verdict(b) if b is not None else None
+        (docs.__setitem__(n, v) if v is not None else bad.append(n))
+    return docs, bad
+
+
+def _note_audit_fold(docs):
+    """判定怎麼算(計劃〈做法〉第 2 節):對每個內容編號——①一般判定逐筆,被申訴過就換成所有指名它的申訴裡最重的結果;
+    ②取最重(CODE > MIXED > CONTEXT);③沒有任何判定時,有略過就算略過。→ {id: 'CODE'|'MIXED'|'CONTEXT'|'SKIP'}。
+    跟讀檔順序無關。"""
+    disputes = {}
+    for name, d in docs.items():
+        if d["kind"] == "申訴" and d.get("disputes"):
+            for r in d["rows"]:
+                if r["class"] in _NOTE_AUDIT_WEIGHT:
+                    k = (d["disputes"], r["id"])
+                    if k not in disputes or _NOTE_AUDIT_WEIGHT[r["class"]] > _NOTE_AUDIT_WEIGHT[disputes[k]]:
+                        disputes[k] = r["class"]
+    best, skipped = {}, set()
+    for name, d in docs.items():
+        if d["kind"] == "略過":
+            skipped.update(r["id"] for r in d["rows"])
+            continue
+        if d["kind"] != "判定":
+            continue
+        for r in d["rows"]:
+            c = r["class"]
+            if c not in _NOTE_AUDIT_WEIGHT:
+                continue
+            c = disputes.get((name, r["id"]), c)
+            if r["id"] not in best or _NOTE_AUDIT_WEIGHT[c] > _NOTE_AUDIT_WEIGHT[best[r["id"]]]:
+                best[r["id"]] = c
+    out = dict(best)
+    for i in skipped:
+        out.setdefault(i, "SKIP")
+    return out
+
+
+def _note_audit_covered(cls):
+    return cls in ("CONTEXT", "SKIP")
+
+
+def _note_audit_resolve(root, diff_range, gate_word):
+    """--diff 範圍 → (base_where, tip, vault_rel) 或 (None, rc, None)。起點照三道檢查共用的 _lens_push_base,
+    再截到第二層上線點(推送前掛鉤的標記)。"""
+    rg = _lens_range_ok(diff_range)
+    if rg is None:
+        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
+        return None, 2, None
+    sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
+    if sh is not None and sh.stdout.strip() == "true":
+        print(f"{gate_word}:淺層 clone 算不出範圍,這次不查——CI 請設 fetch-depth: 0", file=sys.stderr)
+        _gate_event_or_warn(root, "note-audit", "skipped-env", "shallow clone")
+        return None, 0, None
+    a, b = rg
+    tip = _lens_full_sha(root, b)
+    if tip is None:
+        print(f"{gate_word}:範圍 {diff_range} 的終點在本機找不到,跳過(fail-open)", file=sys.stderr)
+        return None, 0, None
+    base, why = _lens_push_base(root, a, tip)
+    if why:
+        print(f"{gate_word}:{why}", file=sys.stderr)
+    if base is None:
+        _gate_event_or_warn(root, "note-audit", "skipped", why)
+        return None, 0, None
+    base = _nodehome_clamp_base(root, base, tip, _NOTE_AUDIT_GOLIVE_MARK, _NOTELINES_PREPUSH)
+    lst = _nodehome_list(root, tip)
+    if lst is None:
+        return None, 0, None
+    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
+    if not vaults:
+        print(f"{gate_word}:這個專案沒有圖譜,跳過")
+        return None, 0, None
+    wv = _vault_in(root)
+    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
+    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
+    return (None if base == _EMPTY_TREE_SHA else base), tip, vault_rel
+
+
+def _note_audit_root(repo):
+    if repo:
+        return Path(repo).resolve()
+    r = _lens_git(".", "rev-parse", "--show-toplevel")
+    return Path(r.stdout.strip()) if (r is not None and r.returncode == 0) else None

