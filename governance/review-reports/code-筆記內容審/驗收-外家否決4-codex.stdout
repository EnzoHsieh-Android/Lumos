+def _ci_jobs_calling_without_full_history(ymls, needle):
+    """GitHub Actions 設定裡,呼叫 needle 的工作項目中,沒設 fetch-depth: 0 的那些 → [(檔名, 工作項目名)]。
+    照工作項目切,不看整份:別的工作項目設了完整歷史,不代表呼叫這道檢查的那個有(筆記內容審代碼審 r2 外家席)。
+    工作項目=jobs: 底下第一層縮排的每一個鍵(名字可加引號、行尾可帶註解;代碼審 r3 兩席:原本只認不帶引號、
+    冒號後什麼都沒有的鍵,合法寫法就會漏)。"""
+    out = []
+    for p, lines in _ci_workflow_texts(ymls):
