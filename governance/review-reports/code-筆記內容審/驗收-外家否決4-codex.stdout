+def t_note_audit_modes_and_event_kinds():
+    """[S11] gate=off 放行不寫帳、warn 只印不擋記 warned,兩者 doctor 各印一行;LUMOS_SKIP_NOTE_AUDIT=1 放行記 skipped-env;
