+    check("③b 第一層同族:note-shape 那步同樣照工作項目看",
+          m._ci_jobs_calling_without_full_history([wf / "ci.yml"], "note-shape --diff") == [("ci.yml", "audit")], "")
+    # ④ 同一編號超過 150 處:每份清單不超過 150
+    root, base = _na_repo()
+    _na_body(root, ["## 重複"] + ["一字不差"] * 160)
