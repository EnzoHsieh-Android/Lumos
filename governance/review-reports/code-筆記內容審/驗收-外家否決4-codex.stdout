            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
            out[i] = "other"
            continue
        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
    return out


def _notelines_parse_added(raw):
    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
    out, path, n = {}, None, 0
    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
        if ln.startswith("+++ "):
            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
            path = nfc(p[2:]) if p.startswith("b/") else None
            continue
        if ln.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
            n = int(m.group(1)) if m else 0
            continue
        if path is None or ln.startswith("---"):
            continue
        if ln.startswith("+"):
            out.setdefault(path, []).append((n, ln[1:]))
            n += 1
    return out


def _ns_git(repo_root, *args):
    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
    r = _lens_git(repo_root, *args, quote=True, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _ns_diff(repo_root, *args):
    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
                   "--src-prefix=a/", "--dst-prefix=b/", *args)


def _ns_mainline_refs(repo_root):
    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""

def _lens_range_ok(diff_range):
    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
        return None
    parts = diff_range.split("..")
    if len(parts) != 2 or not parts[0] or not parts[1]:
        return None
    if any(ch.isspace() for ch in diff_range):
        return None
    return parts[0], parts[1]


_ZERO_SHA_RE = re.compile(r"0{40}|0{64}")          # SHA-1 與 SHA-256 專案的全零(筆記內容審代碼審 r3 兩席)


def _lens_push_base(repo_root, a, tip):
    """推送範圍的起點 → (起點 sha 或 None, 說明)。None=這次沒有新東西、不用查。
    起點是 40 個 0(GitHub 對新分支首推給的 before)或本機找不到(force-push 後的舊頂端)時:頂端落後或等於主線(本地主分支
    的 upstream)頂端就沒有新東西;其他從跟主線的分岔點算;連主線都找不到才用空樹(筆記形狀擋與每支檔有家之後截到上線點;
    代碼審那道照它原本拿到空樹的做法)。
    ★頂端等於主線頂端也算沒有新東西★:代碼審 r2 曾改成「從上線點起全查」想擋 force-push 改寫主線,r3 查出它讓零提交的新分支
    被主線舊帳誤擋、代碼審那道整庫當新增、而且 force-push 後再推一次照樣漏——「繞過本機掛鉤又 force-push 改寫主線」是存心繞過,
    跟筆記內容審只防疏忽同一條線,不在這道後盾要防的範圍(呼叫端回 None 時記一筆 skipped 帳,事後看得到)。
    ★不能直接回「範圍找不到、放行」★:照 doctor 給的 CI 步驟貼的消費專案,新分支首推會整批放過(2026-09-28 漏網
    ESC-61fc2d87);★也不能一律當空樹★:新分支開在主線頂端時會把主線上線後的舊帳當新增誤擋(同一件事的代碼審)。
    明寫空樹的起點照原意(從空樹比)。筆記形狀擋與每支檔有家共用這支。"""
    if a == _EMPTY_TREE_SHA:
        return a, ""
    if not _ZERO_SHA_RE.fullmatch(a or ""):
        s = _lens_full_sha(repo_root, a)
        if s is not None:
            return s, ""
    why = "新分支首推" if _ZERO_SHA_RE.fullmatch(a or "") else "起點在本機找不到"
    ml = _mainline_ref(repo_root, remote_only=True)
    if ml:
        anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
        if anc is not None and anc.returncode == 0:
            return None, f"{why},而且頂端已在主線({ml[0]})上——沒有新東西"
        mb = _lens_git(repo_root, "merge-base", tip, ml[1])
        if mb is not None and mb.returncode == 0 and mb.stdout.strip():
            return mb.stdout.strip(), f"{why}:從跟主線({ml[0]})的分岔點算"
    return _EMPTY_TREE_SHA, f"{why}:找不到主線,從空樹算(截到上線點)"


def _lens_git(repo_root, *args, quote=False, binary=False):
    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
    import subprocess as _sp
    cmd = ["git", "-C", str(repo_root)]
    if quote:
        cmd += ["-c", "core.quotePath=false"]
    try:
        if binary:
            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
    except (OSError, _sp.TimeoutExpired):
        return None


def _lens_full_sha(repo_root, rev):
    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
    if r is None or r.returncode != 0:
        return None
    sha = r.stdout.strip()
    return sha if _LENS_SHA_RE.match(sha) else None


def _mainline_ref(repo_root, remote_only=False):
    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
    拿它當「已在主線上」會把整批都排除掉)。"""
    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
        sha = _lens_full_sha(repo_root, cand)
        if sha:
            return cand, sha
    return None
    fail-open:pitfalls 出錯 / 非 git / 無 merge-base → tier 視作非 high(不 blocked)。
    回傳 dict{blocked:bool, reason:str, tier:str}。
    """
    import json as _json
    import subprocess as _sp

    # 留痕比對座標:優先用傳入的(hook 綁被推送 ref),否則讀 checkout
    _codeloop_guard_verdict.last_bound = None   # 每次呼叫先清,提早 fail-open 的分支不會拿到上一輪的殘留
    _codeloop_guard_verdict.last_dispositions = None
    _codeloop_guard_verdict.last_lint_new = None
    marker_sha = at_sha or _codeloop_git_head(repo_root)
    marker_branch = branch or _codeloop_git_branch(repo_root)
    if not marker_sha:
        _gate_failopen(repo_root, "code-loop", "無法取得 HEAD sha")
        return {"blocked": False, "reason": "無法取得 HEAD sha(fail-open)", "tier": "unknown"}

    if diff_range is None:
        # 現行為:merge-base..HEAD 推導(向後相容)
        head_sha = _codeloop_git_head(repo_root)
        mb = None
        for base_branch in ("main", "master"):
            r = _sp.run(["git", "merge-base", "HEAD", base_branch],
                        capture_output=True, text=True, errors="replace", cwd=str(repo_root))
            if r.returncode == 0 and r.stdout.strip():
                mb = r.stdout.strip()
                if mb == head_sha:
                    return {"blocked": False, "reason": "merge-base == HEAD(無 branch diff)", "tier": "standard"}
                break
        if not mb:
            _gate_failopen(repo_root, "code-loop", "算不出 merge-base")
            return {"blocked": False, "reason": "無 merge-base(fail-open)", "tier": "unknown"}
        diff_range = f"{mb}..HEAD"
    else:
        # 起點是 40 個 0(新分支首推)或本機找不到(force-push 後)時,照筆記形狀擋與每支檔有家共用的判法換成真的起點;
        # 原本原樣交給 pitfalls、它回 rc2、這裡走 fail-open(2026-09-28 全零修正的代碼審通才席)
        rg = _lens_range_ok(diff_range)
        if rg is not None:
            a, b = rg
            if a != _EMPTY_TREE_SHA and (_ZERO_SHA_RE.fullmatch(a) or _lens_full_sha(repo_root, a) is None):
                tip = _lens_full_sha(repo_root, b)
                if tip is not None:
                    base, _why = _lens_push_base(repo_root, a, tip)
                    if base is None:
                        return {"blocked": False, "reason": _why, "tier": "standard"}
                    diff_range = f"{base}..{tip}"

    # 2.5 受波及合約測試真跑(不分 tier;紅就擋)
    # ★高風險這條路也要吃那份算好的★(2026-09-07 代碼審 r1 通才席的附註,查證屬實):
    # 第一版只接了低風險那條,於是高風險推送仍然算兩次(一次給同步點名、一次在這裡)
    # ——而我在 pre-push 的註解裡寫的是「★一次推送只算一次波及★」。
    # ★那句話當時只在低風險成立,是我自己寫太大的宣稱。★ 接上之後才是真的。
    bt = _bound_tests_check(repo_root, diff_range, skip=skip_bound, skip_note=skip_note,
                            payload=payload, advisory=bound_advisory)   # advisory 也要傳進去(r1 外家否決 f3:不傳會對低風險跑整套 600 秒)
    _codeloop_guard_verdict.last_bound = bt
    # ★「證不出跑過」跟紅一樣擋★(2026-09-09 r1 單reviewer f2,blocker):
    # 第一版只把狀態從 green 換成 unfilterable、印一行到 stderr 就結束,決定擋不擋的這裡
    # 只認 red——也就是說「假綠改成擋」這句話當時是假的,實際上只是換了一行字。
    # 假綠的殺傷力跟紅一樣(你以為合約被測試守著,其實沒有),所以走同一條路:
    # 高風險擋、低風險比照紅只提醒(那是 2026-09-07 的人裁,理由是擋下去人會改走 --no-verify)。
    # 真的修不動的話逃生門跟紅共用:--skip-bound-tests --note "<理由>",會留痕。
    if bt["status"] in ("red", "unfilterable") and not bound_advisory:

