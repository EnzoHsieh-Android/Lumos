+                cur = m.group(2) if m else ln.strip()
+                jobs.setdefault(cur, [])
                 continue
             if cur is not None:
                 jobs[cur].append(ln)
         for name, body in jobs.items():
             text = "\n".join(body)
             if needle in text and "fetch-depth: 0" not in text:
                 out.append((p.name, name))
