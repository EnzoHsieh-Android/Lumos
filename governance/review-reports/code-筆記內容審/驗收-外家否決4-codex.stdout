+    d.mkdir(parents=True, exist_ok=True)
+    (d / ("20260928T000000Z-" + "a" * 32 + ".json.123-abcd.tmp-wlf")).write_text(
+        '{"version":1,"kind":"判定","rows":[{"id":"0123456789abcdef","class":"CONTEXT"}]}', encoding="utf-8")
