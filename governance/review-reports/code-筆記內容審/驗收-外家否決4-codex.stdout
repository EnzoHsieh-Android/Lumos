+                        disputes[k] = r["class"]
+    best, skipped = {}, set()
+    for name, d in docs.items():
+        if d["kind"] == "略過":
+            skipped.update(r["id"] for r in d["rows"])
+            continue
+        if d["kind"] != "判定":
+            continue
+        for r in d["rows"]:
+            c = r["class"]

