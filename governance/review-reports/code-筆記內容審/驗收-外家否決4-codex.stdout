+    if not ml or gl is None:
+        return out
+    try:
+        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
+    except ValueError:
+        return out
+    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{ml[1]}")
+    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
+    base = gl
+    if capped:
+        rl = _lens_git(root, "rev-list", f"--max-count={_NS_DOCTOR_SCAN_CAP}", f"{gl}..{ml[1]}")
+        tail = rl.stdout.split()[-1] if rl is not None and rl.returncode == 0 and rl.stdout.split() else None
+        if tail:
+            b2 = _lens_full_sha(root, f"{tail}~1")
+            base = b2 or gl
+        out.append(f"(筆記內容審的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交)")
+    got = _note_audit_items(root, base, ml[1], vault_rel)
+    if got is None:
+        return out
+    items, _e = got
+    docs, _b = _note_audit_load_verdicts(root, ml[1])
+    fold = _note_audit_fold(docs)
+    left = [it for it in items if not _note_audit_covered(fold.get(it["id"]))]
+    if left:
+        shown = "; ".join(f"{it['path']}:{it['line']}" for it in left[:10])
+        out.append(f"已推上遠端({ml[0]})卻沒被筆記內容審涵蓋的新增筆記行 {len(left)} 行(多半是 --no-verify 或 warn 期間):{shown}")
+    return out
