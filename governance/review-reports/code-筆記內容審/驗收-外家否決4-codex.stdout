+def _note_audit_parse_verdict(raw):
+    """判定檔內容 → dict 或 None(壞掉)。"""
+    import json as _j
+    try:
+        d = _j.loads(raw.decode("utf-8") if isinstance(raw, bytes) else raw)
+    except (ValueError, UnicodeDecodeError):
+        return None
+    if not isinstance(d, dict) or d.get("kind") not in ("判定", "申訴", "略過") or not isinstance(d.get("rows"), list):
+        return None
+    for r in d["rows"]:
+        if not isinstance(r, dict) or not isinstance(r.get("id"), str) or r.get("class") not in ("CODE", "MIXED", "CONTEXT", "SKIP"):
+            return None
+    return d
+
+
+def _note_audit_load_verdicts(repo_root, where):
+    """讀判定檔 → ({檔名: dict}, [壞掉的檔名])。where=None 讀工作目錄;給提交就讀那個提交的樹(check 只認這個)。
+    只有檔名合格式的才算(`_write_lf` 中斷留下的暫存檔不算)。"""
+    root = Path(repo_root)
+    docs, bad = {}, []
+    if where is None:
+        d = root / _NOTE_AUDIT_VERDICT_DIR
+        if not d.is_dir():
+            return docs, bad
+        for f in sorted(d.iterdir()):
+            if not _NOTE_AUDIT_VERDICT_NAME_RE.match(f.name) or not f.is_file() or f.is_symlink():
+                continue
+            v = _note_audit_parse_verdict(f.read_bytes())
+            (docs.__setitem__(f.name, v) if v is not None else bad.append(f.name))
+        return docs, bad
+    ls = _nodehome_git(repo_root, "ls-tree", "-z", "--name-only", f"{where}:{_NOTE_AUDIT_VERDICT_DIR}")
+    if ls is None:
+        return docs, bad
+    names = [n for n in _nodehome_split_z(ls) if _NOTE_AUDIT_VERDICT_NAME_RE.match(n)]
+    blobs = _nodehome_cat_blobs(repo_root, [f"{where}:{_NOTE_AUDIT_VERDICT_DIR}/{n}" for n in names]) if names else []
+    for n, b in zip(names, blobs or [], strict=False):
+        v = _note_audit_parse_verdict(b) if b is not None else None
+        (docs.__setitem__(n, v) if v is not None else bad.append(n))
+    return docs, bad
+
