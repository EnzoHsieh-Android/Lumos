+def _note_audit_render_list(orchestrator, tip, batch, prompt):
+    """清單檔 → (內容, 清單指紋)。本文=頂端提交+逐行;指紋=本文的雜湊(開頭不算,所以開頭能寫出指紋給判定者照抄)。"""
+    import hashlib
+    body = [f"頂端提交: {tip}", ""]
+    for it in batch:
+        body.append(f"## {it['id']} | {it['region']} | {it['heading'] or '-'} | {it['path']}:{it['line']}"
+                    + (" | 完成審" if it["done"] else ""))
+        body.append(f"上下文指紋: {it['ctx_fp']}")
+        body.append("~~~~text")
+        body.extend(f"    {x}" for x in it["context"][0])
+        body.append(f">>> {it['text']}")
+        body.extend(f"    {x}" for x in it["context"][1])
+        body.append("~~~~")
+        body.append("")
+    body_s = "\n".join(body)
+    fp = hashlib.sha256(body_s.encode("utf-8")).hexdigest()[:16]
+    head = ["# 筆記內容審清單", "", f"編排者: {orchestrator}", f"判定者模型: {_note_audit_judge_model(orchestrator)}",

