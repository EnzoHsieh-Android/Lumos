+def _note_audit_prompt(root):
+    """派工詞:範本檔三類定義與七句,專案路徑與技術棧換成被審 repo 的(計劃 S13)。"""
+    here = Path(__file__).resolve().parent.parent
+    tpl = None
+    for cand in (Path(root) / _NOTE_AUDIT_TEMPLATE, here / _NOTE_AUDIT_TEMPLATE):
+        if cand.is_file():
+            tpl = cand.read_text(encoding="utf-8")
+            break
+    if tpl is None:
+        return None
+    # 檔頭授權標示與給維護者看的註解不進派工詞
+    tpl = "".join(l for l in tpl.splitlines(keepends=True) if not l.startswith("# SPDX-"))
+    if tpl.lstrip().startswith("<!--") and "-->" in tpl:
+        tpl = tpl.split("-->", 1)[1].lstrip("\n")
+    try:
+        cnt = sorted(_stack_ext_counts(Path(root)).items(), key=lambda kv: -kv[1])[:5]
+        stacks = "主要程式檔副檔名:" + (", ".join(f"{e}×{n}" for e, n in cnt) if cnt else "未偵測到")
+    except OSError:
+        stacks = "主要程式檔副檔名:未偵測到"
+    return (tpl.replace("{{REPO_PATH}}", str(Path(root).resolve())).replace("{{STACK}}", stacks)
+               .replace("{{PROMPT_VERSION}}", str(_NOTE_AUDIT_PROMPT_VERSION)))
+
+
+def _note_audit_batches(pending):
+    """待審超過 150 行就切:先照筆記分組、同篇同份;單篇超過時在小標題邊界切;單一小標題下還超過就照行數硬切。"""
+    groups = []
+    for p in sorted({it["path"] for it in pending}):
+        rows = [it for it in pending if it["path"] == p]
+        if len(rows) <= _NOTE_AUDIT_BATCH:
+            groups.append(rows)
+            continue
+        units, seen = [], {}
+        for it in rows:                         # 同一編號的幾處(同篇、同小標題)當成一個單位,不拆到兩份清單
+            if it["id"] in seen:
+                seen[it["id"]].append(it)
+            else:
+                seen[it["id"]] = [it]
+                units.append(seen[it["id"]])
+        cur, cur_head = [], None
+        for u in units:
+            it = u[0]
+            new_head = cur and it["heading"] != cur_head
+            if cur and (len(cur) + len(u) > _NOTE_AUDIT_BATCH or (new_head and _note_audit_head_split(rows, cur, it))):
+                groups.append(cur)
+                cur = []
+            cur.extend(u)
+            cur_head = it["heading"]
+        if cur:
+            groups.append(cur)
+    batches, cur = [], []
+    for g in groups:
+        if cur and len(cur) + len(g) > _NOTE_AUDIT_BATCH:
+            batches.append(cur)
+            cur = []
+        cur.extend(g)
+    if cur:
+        batches.append(cur)
+    return batches
+
+
+def _note_audit_head_split(rows, cur, it):
+    """單篇超過一批時:換小標題的地方,如果把下一個小標題整段放進來會超過一批,就在這裡切。"""
+    nxt = sum(1 for r in rows if r["heading"] == it["heading"])
+    return len(cur) + nxt > _NOTE_AUDIT_BATCH
+
+
+def _note_audit_render_list(orchestrator, tip, batch, prompt):
+    """清單檔 → (內容, 清單指紋)。本文=頂端提交+逐行;指紋=本文的雜湊(開頭不算,所以開頭能寫出指紋給判定者照抄)。"""
+    import hashlib
+    body = [f"頂端提交: {tip}", ""]
+    for it in batch:
+        body.append(f"## {it['id']} | {it['region']} | {it['heading'] or '-'} | {it['path']}:{it['line']}"
+                    + (" | 完成審" if it["done"] else ""))
+        body.append(f"上下文指紋: {it['ctx_fp']}")
+        body.append("~~~~text")
+        body.extend(f"    {x}" for x in it["context"][0])
+        body.append(f">>> {it['text']}")
+        body.extend(f"    {x}" for x in it["context"][1])
+        body.append("~~~~")
+        body.append("")
+    body_s = "\n".join(body)
+    fp = hashlib.sha256(body_s.encode("utf-8")).hexdigest()[:16]
+    head = ["# 筆記內容審清單", "", f"編排者: {orchestrator}", f"判定者模型: {_note_audit_judge_model(orchestrator)}",
+            f"派工詞版本: {_NOTE_AUDIT_PROMPT_VERSION}", f"清單指紋: {fp}", "", "## 派工詞", "", prompt, "",
+            "---本文---"]
+    return "\n".join(head) + "\n" + body_s, fp
+
+
+def _note_audit_parse_list(text):
+    """清單檔 → {orchestrator, model, version, fp, fp_ok, tip, rows:{id: ctx_fp}} 或 None。"""
+    import hashlib
+    if "\n---本文---\n" not in text:
+        return None
+    head, body = text.split("\n---本文---\n", 1)
+    meta = dict(re.findall(r"^(編排者|判定者模型|派工詞版本|清單指紋): (.+)$", head, re.M))
+    m = re.search(r"^頂端提交: ([0-9a-f]{40})$", body, re.M)
+    rows = {}
+    for rid, fp in re.findall(r"^## ([0-9a-f]{16}) \|.*\n上下文指紋: ([0-9a-f]{16})$", body, re.M):
+        rows.setdefault(rid, []).append(fp)
+    rows = {k: sorted(v) for k, v in rows.items()}
+    if not meta.get("清單指紋") or not m:
+        return None
+    return {"orchestrator": meta.get("編排者"), "model": meta.get("判定者模型"), "version": meta.get("派工詞版本"),
+            "fp": meta["清單指紋"], "fp_ok": hashlib.sha256(body.encode("utf-8")).hexdigest()[:16] == meta["清單指紋"],
+            "tip": m.group(1), "rows": rows}
+
+
+def _note_audit_parse_report(text):
+    """判定者報告 → (header dict, rows[(id, class_or_None, evidence, reason)])。開頭四行 seat/provider/model/prepared。"""
+    head = {}
+    for k in ("seat", "provider", "model", "prepared"):
+        m = re.search(rf"^{k}:\s*(\S.*?)\s*$", text, re.M)
+        if m:
+            head[k] = m.group(1)
+    rows = []
+    for ln in text.split("\n"):
+        cells = [c.strip() for c in ln.strip().strip("|").split("|")]
+        if len(cells) >= 2 and re.fullmatch(r"[0-9a-f]{16}", cells[0]):
+            cls = _NOTE_AUDIT_CLASS_ALIASES.get(cells[1].strip("`*").upper() if cells[1].isascii() else cells[1].strip("`*"))
+            rows.append((cells[0], cls, cells[2] if len(cells) > 2 else "", cells[3] if len(cells) > 3 else ""))
+    return head, rows
+
+
+def _note_audit_check_evidence(root, tip, evidence):
+    """證據只做紀錄(計劃〈做法〉第 3 節第 5 點):file:line 讀清單當時頂端提交的 git 版本;search: 在那個提交的樹裡、
+    repo 內相對路徑、最多掃 20,000 支檔。回 True/False(驗得過沒)。"""
+    ok_any = False
+    for m in re.finditer(r"`?([\w./\-]+):(\d+)(?:-(\d+))?`?", evidence or ""):
+        st, _ex = _validate_repo_ref(root, m.group(1), m.group(2) + (f"-{m.group(3)}" if m.group(3) else ""), at_sha=tip)
+        if st != "ok":
+            return False
+        ok_any = True
+    ms = re.search(r"search:\s*(.+?)\s+in\s+(\S+)\s*=>\s*(\d+)", evidence or "")
+    if ms:
+        s, path, n = ms.group(1).strip().strip("`\"'"), ms.group(2).strip("`"), int(ms.group(3))
+        if len(s) < 4 or path.startswith("/") or ".." in Path(path).parts:
+            return False
+        ls = _lens_git(root, "ls-tree", "-r", "--name-only", tip, "--", path)
+        # 路徑在那個提交裡不存在時 ls-tree 也回 0、輸出空——不能當成「搜過、零命中」(代碼審 r1 兩席)
+        if ls is None or ls.returncode != 0 or not ls.stdout.strip() or len(ls.stdout.splitlines()) > _NOTE_AUDIT_SEARCH_CAP:
+            return False
+        g = _lens_git(root, "grep", "-c", "-F", "-e", s, tip, "--", path)
+        if g is None or g.returncode not in (0, 1):       # 1=沒命中;其他是出錯,不算零命中
+            return False
+        cnt = 0
+        if g.returncode == 0:
+            cnt = sum(int(x.rsplit(":", 1)[1]) for x in g.stdout.splitlines() if x.rsplit(":", 1)[-1].isdigit())
+        return cnt == n
+    return ok_any
+
+
+def _note_audit_write_verdict(root, doc):
+    """一份報告寫一個判定檔(暫存再原子換名;32 位亂數檔名)。回檔名。"""
+    import json as _j, uuid as _uuid, datetime as _dt
+    d = Path(root) / _NOTE_AUDIT_VERDICT_DIR
+    d.mkdir(parents=True, exist_ok=True)
+    name = _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + _uuid.uuid4().hex + ".json"
+    _write_lf(d / name, _j.dumps(doc, ensure_ascii=False, indent=1) + "\n")
+    return name
+
+
+def _note_audit_work_dir(root):
+    d = Path(root) / _NOTE_AUDIT_WORK_DIR
+    first = not d.exists()
+    d.mkdir(parents=True, exist_ok=True)
+    if first or not (d / ".gitignore").exists():
+        _write_lf(d / ".gitignore", "*\n")
+    import time as _t
+    for f in d.glob("*.md"):
+        try:
+            if _t.time() - f.stat().st_mtime > 14 * 86400:
+                f.unlink()
+        except OSError:
+            pass
+    return d
+
+
+def cmd_note_audit_prepare(repo=None, diff_range=None, orchestrator=None, only=None):
+    """lumos note-audit prepare --diff A..B --orchestrator claude|codex [--only 編號…](計劃〈做法〉第 3 節第 1 點)。"""
+    import datetime as _dt
+    root = _note_audit_root(repo)
+    if root is None:
+        print("筆記內容審:這裡不是 git 專案", file=sys.stderr)
+        return 2
+    if orchestrator not in ("claude", "codex"):
+        print("擋下:--orchestrator 要給 claude 或 codex(編排這次的那一家;判定者跟它同一家)", file=sys.stderr)
+        return 2
+    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
+    if tip is None or isinstance(tip, int):
+        return tip if isinstance(tip, int) else 0
+    got = _note_audit_items(root, base, tip, vault_rel)
+    if got is None:
+        print("筆記內容審:git 算不出這次的筆記行", file=sys.stderr)
+        return 2
+    items, errs = got
+    for e in errs:
+        print(f"  {e}", file=sys.stderr)
+    docs, bad = _note_audit_load_verdicts(root, None)
+    for n in bad:
+        print(f"提醒:判定檔 {n} 壞掉了(讀不成 JSON 或缺欄位),當作不存在", file=sys.stderr)
+    fold = _note_audit_fold(docs)
+    # 同一個內容編號的每一處都列(同一小標題下一字不差的兩行,上下文可能一處是脈絡、一處是現況;代碼審 r1 兩席)
+    want = set(only) if only else None
+    pending = [it for it in items if (it["id"] in want if want is not None else not _note_audit_covered(fold.get(it["id"])))]
+    if not pending:
+        print("沒有待審的筆記行")
+        return 0
+    prompt = _note_audit_prompt(root)
+    if prompt is None:
+        print(f"擋下:找不到派工詞範本 {_NOTE_AUDIT_TEMPLATE}(跑一次 lumos update)", file=sys.stderr)
+        return 2
+    wd = _note_audit_work_dir(root)
+    outs = []
+    for batch in _note_audit_batches(pending):
+        content, fp = _note_audit_render_list(orchestrator, tip, batch, prompt)
+        f = wd / f"{fp}-{orchestrator}.md"
+        _write_lf(f, content)
+        outs.append((f, fp, len(batch)))
+        _gate_event_or_warn(root, "note-audit", "prepare", f"清單 {fp}:{len(batch)} 行")
+    print(f"待審 {len({it['id'] for it in pending})} 個編號({len(pending)} 處),切成 {len(outs)} 份清單;每份派一席 {_note_audit_judge_model(orchestrator)}"
+          f"(跟編排者同一家),報告照清單開頭的格式寫:")
+    for f, fp, n in outs:
+        print(f"  {f}  ({n} 行,清單指紋 {fp})")
+    print("判定者交回報告後:\n    lumos note-audit record --diff <同一個範圍> --prepared <清單檔> --report <報告>")
+    return 0
+
