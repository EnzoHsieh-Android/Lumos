+def _na_prepare(root, rng, orch="claude", *extra):
+    import re as _re
+    rc, out = _na(root, "prepare", "--diff", rng, "--orchestrator", orch, *extra)
+    return rc, out, [Path(f) for f in _re.findall(r"^\s+(\S+\.md)\s+\(", out, _re.M)]
