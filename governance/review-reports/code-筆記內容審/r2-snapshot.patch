+    v = _na_verdicts(root)
+    check("②對照組:來源都對 → 三類都收", sorted(r["class"] for d in v for r in d["rows"]) == ["CODE", "CONTEXT", "MIXED"]
+          and all(d["provenance_ok"] is True for d in v), out[-300:])
