+def _note_audit_resolve(root, diff_range, gate_word):
+    """--diff 範圍 → (base_where, tip, vault_rel) 或 (None, rc, None)。起點照三道檢查共用的 _lens_push_base,
+    再截到第二層上線點(推送前掛鉤的標記)。"""
+    rg = _lens_range_ok(diff_range)
+    if rg is None:
+        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
+        return None, 2, None
+    sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
+    if sh is not None and sh.stdout.strip() == "true":
+        print(f"{gate_word}:淺層 clone 算不出範圍,這次不查——CI 請設 fetch-depth: 0", file=sys.stderr)
+        _gate_event_or_warn(root, "note-audit", "skipped-env", "shallow clone")
+        return None, 0, None
+    a, b = rg
+    if re.fullmatch(r"0{40}|0{64}", b):
+        print(f"{gate_word}:範圍終點是全 0(刪除分支),沒有要審的東西", file=sys.stderr)
+        return None, 0, None
+    tip = _lens_full_sha(root, b)
+    if tip is None:
+        # 推送前的終點是本機要推的提交、CI 的是剛 checkout 的那個,都一定找得到;找不到就是範圍寫錯,
+        # 放行等於整道檢查沒跑(代碼審 r1 外家席),所以當參數錯
+        print(f"擋下:範圍 {diff_range} 的終點在本機找不到——範圍寫錯了?", file=sys.stderr)
+        return None, 2, None
+    base, why = _lens_push_base(root, a, tip)
+    if why:
+        print(f"{gate_word}:{why}", file=sys.stderr)
+    if base is None:
+        _gate_event_or_warn(root, "note-audit", "skipped", why)
+        return None, 0, None
+    base = _nodehome_clamp_base(root, base, tip, _NOTE_AUDIT_GOLIVE_MARK, _NOTELINES_PREPUSH)
+    lst = _nodehome_list(root, tip)
+    if lst is None:
+        return None, 0, None
+    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
+    if not vaults:
+        print(f"{gate_word}:這個專案沒有圖譜,跳過")
+        return None, 0, None
+    wv = _vault_in(root)
+    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
+    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
+    return (None if base == _EMPTY_TREE_SHA else base), tip, vault_rel
+
+
+def _note_audit_root(repo):
+    if repo:
+        return Path(repo).resolve()
+    r = _lens_git(".", "rev-parse", "--show-toplevel")
+    return Path(r.stdout.strip()) if (r is not None and r.returncode == 0) else None
