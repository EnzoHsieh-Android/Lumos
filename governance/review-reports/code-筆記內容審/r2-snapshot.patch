+    if len(left) > 20:
+        print(f"  …還有 {len(left) - 20} 行", file=sys.stderr)
+    print(f"派判定者審:\n    lumos note-audit prepare --diff {diff_range} --orchestrator <claude|codex>", file=sys.stderr)
+    if uncommitted:
+        print(f"其中 {len(uncommitted)} 行在工作目錄的判定檔裡已經涵蓋、但還沒提交:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit",
