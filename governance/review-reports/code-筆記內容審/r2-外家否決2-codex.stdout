 29114	def _lens_git(repo_root, *args, quote=False, binary=False):
 29115	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 29116	    import subprocess as _sp
 29117	    cmd = ["git", "-C", str(repo_root)]
 29118	    if quote:
 29119	        cmd += ["-c", "core.quotePath=false"]
 29120	    try:
 29121	        if binary:
 29122	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 29123	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 29124	    except (OSError, _sp.TimeoutExpired):
 29125	        return None
 29126	
