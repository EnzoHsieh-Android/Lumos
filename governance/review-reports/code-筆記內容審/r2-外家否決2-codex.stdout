+                cur = m.group(2)
+                val = ln.split(":", 1)[1].strip()
+                if cur == "id":
+                    mm = re.match(r"^(d\d+)$", val)
+                    if mm:
+                        did = mm.group(1)
+                elif cur == "valid":
+                    valid = val.strip("\"'").lower() != "false"
+            fields.append((k, cur))
+        for k, f in fields:
+            out[k + 2] = (did, f or "", valid)       # fm[0] 是全文第 2 行
+    return out
+
+
+def _notelines_headings(text, regs):
+    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
+    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
+    lines = text.split("\n")
+    vis = {i for i, _l in _visible_lines(lines)}
+    dfields = _notelines_decision_fields(text)
+    out, cur = [], ""
+    for i, ln in enumerate(lines, 1):
+        reg = regs[i - 1]
+        if reg == "body" and i in vis:
+            m = _NOTELINES_HEADING_RE.match(ln)
+            if m:
+                cur = m.group(1).strip()
+        if reg == "summary":
+            out.append("summary")
+        elif reg == "decisions":
+            did, f, _v = dfields.get(i, ("", "", True))
+            out.append(f"decisions/{did}/{f}")
+        elif reg == "body":
+            out.append(cur)
+        else:
+            out.append("")
+    return out
+
+
+_NOTELINES_TABLE_SEP_RE = re.compile(r"^\s*[|:\-\s]*-[|:\-\s]*$")
+_NOTELINES_RULE_RE = re.compile(r"^\s{0,3}(?:(?:-\s*){3,}|(?:\*\s*){3,}|(?:_\s*){3,})$")
+_NOTELINES_BARE_LIST_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])(?:\s+\[[ xX]\])?\s*$")
+
+
+def _notelines_structural_lines(text):
+    """沒有主張、不審的行號集合(Projects/筆記內容審_計劃 [S4]):圍欄記號行(照 _visible_lines 認的)、表格分隔行、
+    分隔線、只有清單記號的行。空白行本來就不收,不在這裡。"""
+    lines = text.split("\n")
+    kept = {i for i, _l in _visible_lines(lines, keep_fenced=True)}
+    out = set()
+    for i, ln in enumerate(lines, 1):
+        if not ln.strip():
+            continue
+        if i not in kept or _NOTELINES_TABLE_SEP_RE.match(ln) and "|" in ln or _NOTELINES_RULE_RE.match(ln) \
+                or _NOTELINES_BARE_LIST_RE.match(ln):

