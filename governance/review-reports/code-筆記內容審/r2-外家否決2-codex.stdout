 12950	            base = indent(line)
 12951	            key_col = base + 2          # dash line: key 在「- 」之後,有效欄位 = base+2
 12952	        elif m_kv and cur is not None:
 12953	            key, val = m_kv.group(2), m_kv.group(3).strip()
 12954	            base = indent(line)
 12955	            key_col = base              # 子欄位: key 欄位 = base
 12956	        else:
 12957	            i += 1
 12958	            continue
 12959	        if val in ("|", "|-", ">", ">-"):
 12960	            # block scalar 終止 = 首個縮排 <= key_col 的非空行(否則會把兄弟欄位吸進 content,Bug1)
