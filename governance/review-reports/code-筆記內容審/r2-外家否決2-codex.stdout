 29128	def _lens_full_sha(repo_root, rev):
 29129	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 29130	    if r is None or r.returncode != 0:
 29131	        return None
 29132	    sha = r.stdout.strip()
 29133	    return sha if _LENS_SHA_RE.match(sha) else None
 29134	
