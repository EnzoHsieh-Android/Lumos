     if _nh_mode != "on":
         print(f"  {C['Y']}⚠{C['X']} 這個專案把「每支檔有家」的擋設成 {_nh_mode}(.lumos/config.json 的 node_home.gate)——新增沒家的檔、寫回落錯篇不會被擋")
     try:
         for _ln in _note_shape_doctor_lines(_vault_repo_root(env), env.vault, ci=ci):
             print(f"  {C['Y']}⚠{C['X']} {_ln}")
     except Exception as _e:        # 體檢的提醒段不因這段壞掉而整支中斷
         print(f"  (筆記形狀擋的健檢提醒算不出來:{_e.__class__.__name__})")
+    try:
+        for _ln in _note_audit_doctor_lines(_vault_repo_root(env), env.vault, ci=ci):
+            print(f"  {C['Y']}⚠{C['X']} {_ln}")
+    except Exception as _e:
+        print(f"  (筆記內容審的健檢提醒算不出來:{_e.__class__.__name__})")
     print()
     issues = 0
     gov_events = []          # 本輪 gate findings → governance-log(--ci 才寫)
 
     def section(idx, title):
         print(f"{C['B']}[{idx}]{C['X']} {title}")
 
     def ok(msg):
         print(f"  {C['G']}✓{C['X']} {msg}")
 
