 19869	        file_lines = None
 19870	    if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
 19871	        return "line_out_of_range", ""
 19872	    if lo == hi:
 19873	        return "ok", file_lines[lo - 1]
 19874	    return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]
