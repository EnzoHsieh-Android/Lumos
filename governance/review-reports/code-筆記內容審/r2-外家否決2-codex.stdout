+    check("⑦b 行號範圍都在檔內 → 驗得過", m._note_audit_check_evidence(root, tip, "`src/a.py:3-5`") is True, "")
+    check("⑦c search 指向不存在的路徑 → 驗不過", m._note_audit_check_evidence(root, tip, "search: TIMEOUT in no/such/dir => 0") is False, "")
