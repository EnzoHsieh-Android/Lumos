 # 筆記內容閘
 
 白話:筆記裡只留程式碼推不出來的東西。這道閘在提交前與推送前,擋下兩種一看就知道是「程式碼推得出來、而且會過期」的新寫法:指向程式某一行的行號引用,以及沒寫出程式碼答不了之來源的現況描述(FACT/FLOW/DEP 摘要行)。舊筆記不回頭清,只看這次新寫的行。
 
 設計、條款、三輪設計審的處置見 [[Projects/筆記形狀擋_計劃]];問題來源與裁定見 [[Issues/筆記把程式現況寫進脈絡而漂移_rtb實測回饋]]。治理帳寫入沒上鎖的問題不在這裡處理,見 [[Issues/治理帳多個寫入者都沒上鎖]]。
 
 這篇管 `scripts/lumos` 裡的 note-shape 子指令(提交前 `--staged`、推送前與 CI `--diff`)、doctor 開頭那三行筆記形狀擋提醒,以及為它加的共用零件:共用抽取器的三個選項與釘版本解析、refcheck 對釘版本改用那個提交驗、摘要行前綴規則表的來源判定。範圍、上線點、合併的算法本身的家是 [[Systems/每支檔有家]]。另外管三處呼叫它的地方:`scripts/hooks/pre-commit` 裡的筆記形狀擋那一段、`scripts/hooks/pre-push` 裡推送範圍那一次呼叫、`.github/workflows/ci.yml` 的 note-shape 那一步(`--no-verify` 繞過時的後盾;這三支檔的其餘部分各有各的家)。
diff --git a/scripts/lumos b/scripts/lumos
index e5a35295..d42f44c2 100755
--- a/scripts/lumos
+++ b/scripts/lumos
@@ -995,20 +995,25 @@ def run_doctor(env: Env, strict: bool, color: bool, suggest=False, ci=False, ver
     print(f"{C['B']}lumos doctor{C['X']} — vault: {C['B']}{env.vault}{C['X']} (self-contained, no Obsidian)")
     # [S37] 每支檔有家的擋被關成 warn/off 時開頭就講——關掉這件事要看得見
     _nh_mode = _nodehome_config(_vault_repo_root(env))["mode"]
     if _nh_mode != "on":
         print(f"  {C['Y']}⚠{C['X']} 這個專案把「每支檔有家」的擋設成 {_nh_mode}(.lumos/config.json 的 node_home.gate)——新增沒家的檔、寫回落錯篇不會被擋")
     try:
         for _ln in _note_shape_doctor_lines(_vault_repo_root(env), env.vault, ci=ci):
             print(f"  {C['Y']}⚠{C['X']} {_ln}")
     except Exception as _e:        # 體檢的提醒段不因這段壞掉而整支中斷
         print(f"  (筆記形狀擋的健檢提醒算不出來:{_e.__class__.__name__})")
+    try:
+        for _ln in _note_audit_doctor_lines(_vault_repo_root(env), env.vault, ci=ci):
+            print(f"  {C['Y']}⚠{C['X']} {_ln}")
+    except Exception as _e:
+        print(f"  (筆記內容審的健檢提醒算不出來:{_e.__class__.__name__})")
     print()
     issues = 0
     gov_events = []          # 本輪 gate findings → governance-log(--ci 才寫)
 
     def section(idx, title):
         print(f"{C['B']}[{idx}]{C['X']} {title}")
 
     def ok(msg):
         print(f"  {C['G']}✓{C['X']} {msg}")
 
@@ -6605,21 +6610,23 @@ _KNOWN_GATES = ("L2", "anchor-approve", "canary", "check-cascade", "check-revisi
                 "anchor", "pitfalls",
                 # 2026-09-17 逃逸自動記 fail-open 失敗留痕(escape-auto-failed)與規格閘每次跑的觀測行(spec-gate-run)
                 "escape-auto", "spec-gate",
                 # 2026-09-11 每支檔有家:提交前/推送前的檢查、健檢三段(沒家的檔/寫了別人的檔名/管太多沒寫負責範圍)
                 "nodehome-check", "check-s8", "check-s9", "check-s10",
