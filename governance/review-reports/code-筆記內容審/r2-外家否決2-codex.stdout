+def _note_audit_doctor_lines(repo_root, vault, ci=False):
+    """doctor 的筆記內容審提醒(計劃 S16):開關不是 block、專案 CI 沒呼叫 note-audit check(跳過註解行)、
+    事後掃描遠端頂端沒被涵蓋的新增筆記行、主線歷史裡判定檔被刪過幾次。"""
