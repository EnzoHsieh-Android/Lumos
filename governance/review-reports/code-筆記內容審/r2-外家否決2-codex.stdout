 29106	        if anc is not None and anc.returncode == 0:
 29107	            return None, f"{why},而且頂端已在主線({ml[0]})上——沒有新東西"
 29108	        mb = _lens_git(repo_root, "merge-base", tip, ml[1])
 29109	        if mb is not None and mb.returncode == 0 and mb.stdout.strip():
 29110	            return mb.stdout.strip(), f"{why}:從跟主線({ml[0]})的分岔點算"
