 29070	def _lens_range_ok(diff_range):
 29071	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 29072	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 29073	        return None
 29074	    parts = diff_range.split("..")
 29075	    if len(parts) != 2 or not parts[0] or not parts[1]:
 29076	        return None
 29077	    if any(ch.isspace() for ch in diff_range):
 29078	        return None
 29079	    return parts[0], parts[1]
