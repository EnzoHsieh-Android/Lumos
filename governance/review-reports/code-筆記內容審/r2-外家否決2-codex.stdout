 12982	
 12983	def fmt_decision(d):
 12984	    mark = "✅" if str(d.get("valid", "true")).lower() != "false" else "❌"
 12985	    line = f"{mark} [{d.get('decided', '?')}] {first_line(d.get('content', ''), 100)}"
 12986	    if d.get("superseded_by"):
 12987	        line += f" → {d['superseded_by']}"
 12988	    return line
 12989	
