+    wired = hk is not None and hk.returncode == 0 and _NOTE_AUDIT_GOLIVE_MARK in hk.stdout
+    body = "\n".join(l for p in ymls for l in p.read_text(encoding="utf-8", errors="replace").split("\n")
+                     if not l.lstrip().startswith("#"))
+    if "note-audit check" in body and "fetch-depth: 0" not in body:
+        out.append("專案 CI 呼叫了 note-audit check,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
+    if ymls and wired:          # 還沒接線(推送前掛鉤裡沒有這道)就不唸 CI 沒呼叫——接線前這道本來就不擋
+        if "note-audit check" not in body:
+            out.append("專案 CI 沒呼叫 `lumos note-audit check`,`--no-verify` 推上去的筆記沒人審——CI 在 note-shape 那步後面加:"
