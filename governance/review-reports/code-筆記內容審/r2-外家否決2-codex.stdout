+        txt = None
+    mode, _w = _note_audit_config(txt)
+    if mode != "block":
+        out.append(f"這個專案把「筆記內容審」設成 {mode}(.lumos/config.json 的 note_audit.gate)——新寫的筆記不會被判定者審")
+    wf = root / ".github" / "workflows"
