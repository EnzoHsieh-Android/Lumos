 def _note_audit_items(repo_root, base_where, tip_where, vault_rel):
     """這次要審的每一行 → (items, errs) 或 None。item={id, path, line, text, region, heading, done, context, ctx_fp}。
@@ -24391,24 +24399,29 @@ def _note_audit_resolve(root, diff_range, gate_word):
     rg = _lens_range_ok(diff_range)
     if rg is None:
         print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
         return None, 2, None
     sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
