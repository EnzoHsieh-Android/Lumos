 22767	def _nodehome_merge_own_changes(repo_root, sha, parents):
 22768	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 22769	
 22770	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 22771	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 22772	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 22773	    或順手多改的部分,正是這道檢查要看的。
 22774	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 22775	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 22776	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 22777	    """
 22778	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 22779	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22780	        return None
 23540	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23541	    return out
