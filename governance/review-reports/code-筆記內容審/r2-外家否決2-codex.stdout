 23544	def _notelines_parse_added(raw):
 23545	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23546	    out, path, n = {}, None, 0
 23547	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23548	        if ln.startswith("+++ "):
 23549	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23550	            path = nfc(p[2:]) if p.startswith("b/") else None
 23551	            continue
 23552	        if ln.startswith("@@"):
 23553	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23554	            n = int(m.group(1)) if m else 0
 23555	            continue
 23556	        if path is None or ln.startswith("---"):
 23557	            continue
 23558	        if ln.startswith("+"):
 23559	            out.setdefault(path, []).append((n, ln[1:]))
 23560	            n += 1
 23561	    return out
