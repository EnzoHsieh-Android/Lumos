 29085	def _lens_push_base(repo_root, a, tip):
 29086	    """推送範圍的起點 → (起點 sha 或 None, 說明)。None=這次沒有新東西、不用查。
 29087	    起點是 40 個 0(GitHub 對新分支首推給的 before)或本機找不到(force-push 後的舊頂端)時:頂端落後或等於主線(本地主分支
 29088	    的 upstream)頂端就沒有新東西;其他從跟主線的分岔點算;連主線都找不到才用空樹(筆記形狀擋與每支檔有家之後截到上線點;
 29089	    代碼審那道照它原本拿到空樹的做法)。
 29090	    ★頂端等於主線頂端也算沒有新東西★:代碼審 r2 曾改成「從上線點起全查」想擋 force-push 改寫主線,r3 查出它讓零提交的新分支
 29091	    被主線舊帳誤擋、代碼審那道整庫當新增、而且 force-push 後再推一次照樣漏——「繞過本機掛鉤又 force-push 改寫主線」是存心繞過,
 29092	    跟筆記內容審只防疏忽同一條線,不在這道後盾要防的範圍(呼叫端回 None 時記一筆 skipped 帳,事後看得到)。
 29093	    ★不能直接回「範圍找不到、放行」★:照 doctor 給的 CI 步驟貼的消費專案,新分支首推會整批放過(2026-09-28 漏網
 29094	    ESC-61fc2d87);★也不能一律當空樹★:新分支開在主線頂端時會把主線上線後的舊帳當新增誤擋(同一件事的代碼審)。
 29095	    明寫空樹的起點照原意(從空樹比)。筆記形狀擋與每支檔有家共用這支。"""
 29096	    if a == _EMPTY_TREE_SHA:
 29097	        return a, ""
 29098	    if not _ZERO_SHA_RE.fullmatch(a or ""):
 29099	        s = _lens_full_sha(repo_root, a)
 29100	        if s is not None:
 29101	            return s, ""
 29102	    why = "新分支首推" if _ZERO_SHA_RE.fullmatch(a or "") else "起點在本機找不到"
