  3152	def _rank_score_candidates(env, query, candidates):
  3153	    """對候選集跑 BM25F(欄位 tf 加權於飽和前,單一虛擬文件)× 型別先驗乘數(A1)。
  3154	    回 [(rel, score, hits)]。N/df/avgdl 以候選集為 corpus(排序目的,絕對值不跨查詢比較)。"""
