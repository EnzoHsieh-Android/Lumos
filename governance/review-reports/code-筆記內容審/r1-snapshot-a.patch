+def cmd_note_audit_skip(repo=None, diff_range=None, note=None):
+    """lumos note-audit skip --diff A..B --note "理由"(計劃〈做法〉第 3 節第 7 點):只略過從來沒被判過的行。"""
+    root = _note_audit_root(repo)
+    if root is None:
+        return 2
+    if not note or len(note.strip()) < 4:
+        print("擋下:--note 要寫理由,至少 4 個字", file=sys.stderr)
+        return 2
+    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
+    if tip is None or isinstance(tip, int):
+        return tip if isinstance(tip, int) else 0
+    got = _note_audit_items(root, base, tip, vault_rel)
+    if got is None:
+        return 2
+    items, _errs = got
+    docs, _bad = _note_audit_load_verdicts(root, None)
+    fold = _note_audit_fold(docs)
+    judged = set(fold)
+    todo = sorted({it["id"] for it in items if it["id"] not in judged})
+    heavy = sorted({it["id"] for it in items if fold.get(it["id"]) in ("CODE", "MIXED")})
+    if heavy:
+        print(f"注意:{len(heavy)} 行已經判了推得出或一半一半,不能略過——要刪、改,或申訴", file=sys.stderr)
+    if not todo:
+        print("沒有可以略過的行")
+        return 0
+    name = _note_audit_write_verdict(root, {"version": 1, "kind": "略過", "note": note.strip(),
+                                            "rows": [{"id": i, "class": "SKIP"} for i in todo]})
+    _gate_event_or_warn(root, "note-audit", "skipped", f"{name}:略過 {len(todo)} 行:{note.strip()[:80]}")
+    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
+    return 0
