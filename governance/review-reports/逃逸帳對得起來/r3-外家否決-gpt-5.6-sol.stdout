def _review_yield_round(rows):
    """[審查有沒有用記帳 S3] 一輪帳列 → 漏斗數字 dict(N 報/M 存活/R 重現不到/F 折/A 放行/S 存活多於席位報)。
    N=席位列 reported 加總,★同席同報告只算一次★(同一席會先留痕一筆、再當載體一筆;以 (auditor, report_sha256) 去重);
    任一欄缺(2026-09-09 前的帳沒這些鍵)→ 該格 None(印 ?),N/M/R 任一 None 就不算 S。純函式,disposal 尾與 gov --stats 共用。"""
    seen, N, n_missing = set(), 0, False
    for r in rows:
        key = (r.get("auditor"), r.get("report_sha256"))
        if key in seen:
            continue
        seen.add(key)
        if r.get("reported") is None:
            n_missing = True
        else:
            N += int(r["reported"])
    carrier = next((r for r in rows if r.get("findings_set")), None)
    M = len(carrier["findings_set"]) if carrier else None
    R = len(carrier["refuted_set"]) if carrier and carrier.get("refuted_set") is not None else None
    F = len(carrier.get("folded_set") or []) if carrier else None
    A = len(carrier.get("accepted_set") or []) if carrier else None
    N = None if n_missing or not seen else N
    S = None if (N is None or M is None or R is None) else max(0, M + R - N)
    return {"N": N, "M": M, "R": R, "F": F, "A": A, "S": S, "has_carrier": carrier is not None}


def _review_yield_line(y, escapes=None):
    """把 _review_yield_round 的 dict 印成一行(問閘尾與 gov --stats 同一種措辭)。"""
    q = lambda v: "?" if v is None else str(v)
    s_part = "算不了(缺欄位)" if y["S"] is None else f"存活多於席位報的 {y['S']} 條(編排者自找或漏併)"
    tail = f";這條迴圈累計逃逸 {escapes}" if escapes is not None else ""
    return (f"席位報 {q(y['N'])}(機器數)→ 存活 {q(y['M'])} / 編排者重現不到 {q(y['R'])}(人填,已對 intake)"
            f"→ 折 {q(y['F'])} / 放行 {q(y['A'])};{s_part}{tail}")


def _escape_rows_for(env, loop_id=None):
    """讀逃逸帳(append-only,不進閘);loop_id 給了就只回那條迴圈的。壞行跳過。"""
    out = []
    try:
        log = env.vault.parent / ".escape-log.jsonl"
        if not log.exists():
            return out
        for ln in log.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if loop_id is None or d.get("loop") == loop_id:
                out.append(d)
    except OSError:
        pass
    return out


def _severity_check_row(rec, root, trust_sha=False):
    """[嚴重度綁定機械掃 S2] 單帳列 severity 對帳核心(CLI 與 disposal 尾端共用,單一實作)。
    回 (status, 白話訊息):ok/over(高報,保守)/under(低報)/noparse(報告無宣告行)/
    nofile(報告檔佚失)/shafail(報告與帳面指紋不符)。trust_sha=True 時跳過重算
    (disposal ③ 已對判定輪全席逐檔驗過,不對同一檔重算兩遍雜湊;r1 arch-f4)。"""
    rp = rec.get("report_path")
    if not rp:
        return "nofile", "帳列沒有報告檔路徑(舊形狀,寫側 2026-08-26 起已拒)"
    fp = Path(rp)
    if not fp.is_absolute():
        fp = Path(root) / rp
    try:
        text = fp.read_text(encoding="utf-8", errors="replace")
    except OSError as e:
        return "nofile", f"報告檔讀不到({e}): {rp}"
    if not trust_sha:
        want = rec.get("report_sha256")
        if want and _sha256_file(fp) != want:
                    _anchored = True
                    break
        except OSError:
            _anchored = False   # 整檔讀不到=環境層問題,寫側不因此誤擋
        if _anchored:
            print(f"擋下:{loop!r} 這個審查編號已經走「每個發現都要處置」的嚴格模式(之前的記錄帶了發現清單),"
                  "之後每筆記錄都要帶 --report(審查報告)和 --snapshot(凍結快照)留痕", file=sys.stderr)
            return 2
    rc = _jsonl_append_verified(path, rec, "token", token)
    if rc != 0:
        return rc
    print(f"✓ 這筆審查結果({kind})記下來了,憑證 {token}" + (f" (審查員 {auditor})" if auditor else "")
          + f"\n    寫入 {path.resolve()}")
    # 逃逸自動記(規格落成可驗收條件_計劃 第五節):代碼審(code-<主題>)記到 major 以上,
    # 對回 <主題> 那條設計迴圈/計劃就記一筆。永遠不影響審查帳本身(任何失敗只印一行)。
    _kinds = rec.get("finding_kinds") if isinstance(rec.get("finding_kinds"), dict) else None
    _sevs = rec.get("finding_severities") if isinstance(rec.get("finding_severities"), dict) else None
    if _sevs is not None:
        # 逐條判(r2 回滾席):code 型那條自己要是 major 以上;沒標型別的那條當分不出、保守算
        _hit = any(v in ("major", "blocker") and (_kinds is None or _kinds.get(k) == "code") for k, v in _sevs.items())
        _precision = "finding" if _kinds is not None else "round"   # 沒標型別=分不出是不是 code 型,不能謊報成逐條精度(r3 邊界席)
    else:
        _has_code = (_kinds is None) or any(str(v) == "code" for v in _kinds.values())   # 沒標型別=分不出,保守記;標了就只收 code 型
        _hit = severity in ("major", "blocker") and _has_code
        _precision = "round"   # 輪級判準:這輪最高 major 且任一條是 code 型——粗,帳上標出來讓讀側分得出
    if loop and str(loop).startswith("code-") and _hit:
        try:
            derived = str(loop)[len("code-"):]
            _auto_escape(env, "code-loop", severity,
                         f"代碼審記到 {severity}({auditor or '?'}{' ' + str(round_id) if round_id else ''})",
                         [(derived, _plan_for_loop(env, derived))],
                         _git_head(env.vault.parent.parent), source="code-loop", extra={"precision": _precision})
        except Exception as _ex:   # 掛勾不准弄壞記帳
            _escape_auto_failed(env, str(loop), "code-loop", str(_ex))
    return 0


def _jsonl_append_verified(path, rec, key_field, key_value):
    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
    import json
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"擋下:寫不進記錄檔({e}):\n    {path}", file=sys.stderr)
        return 2
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if isinstance(d, dict) and d.get(key_field) == key_value:
                    return 0
    except (OSError, ValueError) as e:
        print(f"canary record: 落盤自驗失敗——寫完讀回來檢查時讀不到({e}),這筆不算記成功:\n    {path.resolve()}", file=sys.stderr)
        return 2
    print(f"canary record: 落盤自驗失敗——系統說寫成功了,但讀回來找不到這一筆,這筆不算記成功:\n    {path.resolve()}",
          file=sys.stderr)
    return 2


def cmd_canary_second(env, ref_id=None, verdict=None, auditor=None, note=None):
    """[S2 oracle品質包] canary 判定的第二判者留痕(抽樣分權,telemetry-only)。
    走 [S1] 同一自驗 helper(唯一鍵=自身新 token);loop status 天然忽略(second 行無 loop 欄)。
    print("# 壓縮狀態(規則式;白名單壓不掉)")
    for title, bucket in (("壓不掉白名單", pinned), ("已驗證證據", evidence), ("未結約束", open_items)):
        print(f"## {title}")
        for s in bucket:
            print(f"- {s}")
    print(f"[compress] 輸入 {len(lines)} 行 → 保留 {len(pinned) + len(evidence) + len(open_items)} 行"
          f"(白名單 {len(pinned)}/證據 {len(evidence)}/未結 {len(open_items)})")
    return 0


# ── loop list:哪些審查迴圈還開著(執行DAG_調研 排第一順位的缺口) ──
# next/status/verify-progress 全都強制要 loop_id,卻沒有任何入口能先知道有哪些編號在飛,
# 實務上只能 tail .canary-log.jsonl 或看 git 未追蹤檔。關門訊號取治理帳的放行事件——
# 那是既有的、寫入當下就落的、可重算的東西,不新增任何要人維護的狀態。
# ★關門事件分成兩組,因為兩本帳認迴圈的方式不一樣★(2026-09-07 代碼審 r1,三席獨立抓到)
# 設計審那組把迴圈編號寫進 nodes 欄(109 筆全部有);
# ★code-loop 那組的 nodes 欄永遠是空陣列★(148 筆全空)——因為那本帳認的是「分支 + 版本」
# 不是迴圈編號,兩套識別體系從來沒建過對應關係。
# 第一版把兩組混在同一個集合裡用 nodes 比對,結果 code-loop 那半是死碼,
# 而且**實測有 23 個早就過閘的 code 迴圈被報成「空轉候選」**(code-234 / code-kill / code-cochange …)。
LOOP_CLOSE_EVENTS = {("design-loop", "converged"), ("design-loop", "cap-reached"),
                     ("design-loop", "rewrite")}
# code-loop 這組只能從自由文字的 detail 認編號(慣例上 detail 開頭就是編號)。
# ★這是啟發式,不是保證★:detail 是人寫的欄位,沒有任何機制強制它以編號開頭。
# 失效方式=編號沒寫在 detail 裡 → 那個迴圈會被報成沒關門(偏保守,不會反過來誤報成關了)。
# REVISIT:2026-11-07 正解是讓 code-loop pass/skip 收一個 --loop 參數、把編號寫進 nodes,
#   跟設計審那組同形;那要動到推送閘會呼叫的路徑,本批不做。
LOOP_CLOSE_EVENTS_BY_DETAIL = {("code-loop", "passed"), ("code-loop", "skipped")}
# ★這兩組以外的 (gate, kind) 都要在下面這張表裡分類過★——新增一種收工事件卻忘了歸類,
# 守衛會翻紅(t_loop_close_kinds_classified)。沒有這道,新的 kind 只會被靜默當成「沒關門」。
LOOP_NOT_CLOSE_EVENTS = {
    ("design-loop", "replay-refreeze"),   # 已凍結的判定重新凍一次,是基準更新不是收斂;
                                          # 而且重凍在判定 FAIL 時也會發生,當成關門會製造新洞
    # 2026-09-08 #19:閘擋人時由做判定的子命令自己落 kind=blocked 的 hard 帳。
    # ★擋人不是關門★——那是一次推送被擋下,迴圈本身沒有任何狀態變化。
    # 同族的 skipped-env / fail-open 在真實帳上出現第一筆時,守衛 t_loop_close_kinds_classified
    # 會再提醒;那時同樣歸這裡(★不得歸「算關門」★)。表裡只列真的出現過的(守衛的反向條件)。
    ("code-loop", "blocked"),
    # 棧別提問表態閘(2026-09-09):表態記錄與 recall-miss 帳都是陳述,不是關門(r2 接手席 H1:忘了登記守衛翻紅)。
    ("code-loop", "dispositions"),
    ("code-loop", "recall-miss"),
    if n_bad:
        print(f"  (帳面 {n_bad} 行不可解析,已跳過——壞行只影響觀測完整性,不進 gate)")
    print("  ★觀測非閘:caught 只證席位醒著,不證審得夠廣(caught≠覆蓋);missed 席 findings 不作廢(d4)★")
    return 0


def cmd_loop_verify_progress(env, loop_id, settle=None, as_json=False):
    """[S3] 獨立進度驗證器(結清式收斂_計劃,2026-07-28):看不到被審材料的覆核原語——
    直讀 .canary-log.jsonl(+選配 settle 清單檔),**只吃結構欄位**(kind/severity/findings/
    auditor 存在性/hash 存在性),note/--clusters 理由字串一律丟棄(LoopTrap 散文注入面隔離)。
    fail-closed:壞行/kind 缺失=rc2。誠實天花板:結構欄位≠客觀真值(findings/severity 源頭仍是
    LLM 裁決、帳由被驗方寫)——隔離的是散文注入,不是帳本自報。輸出=結構 JSON/純事實行,
    供編排者對照自己的收斂認知,非 oracle。"""
    import json
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    try:
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    print("擋下:審查記錄檔有讀不懂的行,輪次順序不可信,整個檔先不信"
                          "(修好或搬走壞行再重跑)", file=sys.stderr)
                    return 2
                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16):不計席、不判無效
                    rounds.append(d)
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
        return 2
    for i, r in enumerate(rounds, 1):
        if not isinstance(r.get("kind"), str):
            print(f"擋下:審查記錄第 {i} 筆少了 kind 欄位(抓到/漏掉/無植入),缺欄位就不信整份", file=sys.stderr)
            return 2
    def caught_ok(r):
        # none=協議停用制無植入輪(2026-08-14 d5),與 caught 同計合格輪
        return r.get("kind") in ("caught", "none") and bool(r.get("auditor"))
    streak = 0
    for r in reversed(rounds):
        if caught_ok(r) and r.get("severity") in ("clean", "minor"):
            streak += 1
        else:
            break
        return r.stdout.strip() if r.returncode == 0 else ""
    except OSError:
        return ""


def _plans_in_range(repo_root, git_range, vault):
    """提交範圍碰到的計劃筆記(repo 相對路徑)。對回啟發式:碰到 Projects/*.md 就算。"""
    try:
        # ★中文檔名:git 預設把非 ASCII 路徑加引號並轉義,不關掉會一個計劃都對不上(taskbank 同型坑 2026-09-15)★
        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return []
    if r.returncode != 0:
        return []
    try:
        vrel = str(Path(vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
    except ValueError:
        return []
    out = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith(vrel + "/Projects/") and line.endswith(".md"):
            out.append(line)
    return out


def _loop_id_for_plan(plan_rel):
    """計劃檔名 → 迴圈編號:去 _計劃(design-loop skill 的慣例)。"""
    stem = Path(plan_rel).stem
    return stem[:-len("_計劃")] if stem.endswith("_計劃") else stem


def _plan_for_loop(env, loop_id):
    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。"""
    for cand in (f"{loop_id}_計劃.md", f"{loop_id}.md"):
        if (env.vault / "Projects" / cand).is_file():
            return f"Projects/{cand}"
    return None


def _door_for_loop(env, loop_id):
    """規格閘留痕裡這條迴圈最後一次判的門;沒有就 unknown(規格閘上線前一律 unknown)。"""
    path = env.vault.parent / ".canary-log.jsonl"
    door = "unknown"
    if not path.exists():
        return door
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not ln.strip():
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
    return door


def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
    log = env.vault.parent / ".escape-log.jsonl"
    ledger = env.vault.parent / ".canary-log.jsonl"
    known = set()
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                v = json.loads(ln).get("loop")
            except ValueError:
                continue
            if isinstance(v, str):
                known.add(nfc(v))
    import datetime as _dt
    import secrets as _sec
    written = 0
    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
    with _vault_write_lock(env.vault):
        existing = set()
        for r in _escape_rows_for(env):
            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
        for loop_id, plan_rel in loops:
            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
            if nfc(loop_id) in known:
                attribution = "ledger"
            elif plan_ok:
                attribution = "plan-file"
            else:
                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
                continue
            door = _door_for_loop(env, loop_id)
            if stage == "push-gate-unreviewed" and door != "low":
                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
                continue
            if (nfc(loop_id), stage, sha) in existing:
                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
                continue
            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "token": "ESC-" + _sec.token_hex(4),
                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door}
            if plan_rel:
                rec["plan"] = plan_rel
            if extra:
                rec.update(extra)
            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
                written += 1
                existing.add((nfc(loop_id), stage, sha))
                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
            else:
                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
    return written


def _plan_file_exists(env, plan_rel):
    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
    if (env.vault / plan_rel).is_file():
        return True
    parent = (env.vault / plan_rel).parent
    if not parent.is_dir():
        return False
    want = nfc(Path(plan_rel).name)
    try:
        return any(nfc(q.name) == want for q in parent.iterdir())
    except OSError:
        return False


def _escape_auto_failed(env, loop_id, stage, why):
    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
    try:
        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
    except Exception:
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)


def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None):
    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
    整套審查系統的 ground truth 側;與攔截帳(★圖譜攔截★記號)互為兩面。
    append-only、不進任何閘;歸因是人工判斷(GIGO 同 cluster 歸併,計劃天花板明載)。
    ★歸因守衛的職責範圍(r1 外家 ESC-01 裁明)★:只防「編號打錯」(實存性),不驗迴圈
    收斂/放行狀態——那是語意判斷,歸人;守衛驗語意=偷渡閘,計劃明文不做。"""
    log = env.vault.parent / ".escape-log.jsonl"
    _SEV_W = {"minor": 0, "major": 1, "blocker": 2}
    if auto:
        # 自動模式(規格落成可驗收條件_計劃 第五節):給提交範圍,碰到的計劃筆記各記一筆;對不回就不記。
        if loop_id or list_mode:
            print("擋下:--auto 不吃迴圈編號也不能跟 --list 混用;編號由提交範圍碰到的計劃筆記推出來", file=sys.stderr)
            return 2
        if severity not in _SEV_W or not (stage or "").strip() or not (desc or "").strip():
            print("擋下:--auto 一樣要帶 --stage、--severity(minor|major|blocker)、--desc", file=sys.stderr)
            return 2
        if not git_range:
            print("擋下:--auto 要帶 --range <a..b>(推送/CI 的提交範圍),沒有範圍就對不回計劃", file=sys.stderr)
            return 2
        repo_root = Path(repo) if repo else env.vault.parent.parent
        plans = _plans_in_range(repo_root, git_range, env.vault)
        if not plans:
            print(f"逃逸自動記:範圍 {git_range} 對不回任何計劃筆記,不記(這不是錯,只是這次推送沒碰到計劃)")
            return 0
        vrel = str(Path(env.vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
        loops = [(_loop_id_for_plan(p), p[len(vrel) + 1:]) for p in plans]
        _auto_escape(env, stage.strip(), severity, desc, loops, sha or _git_head(repo_root), source=stage.strip())
        return 0
    if list_mode:
        if loop_id or stage or severity or desc or defect_ref:
            print("擋下:--list 是唯讀,不能跟記帳參數混用——照原樣執行你會以為記了、其實一筆都沒寫。要記帳就拿掉 --list 重跑", file=sys.stderr)
            return 2
        if not log.exists():
            print("逃逸帳是空的:還沒有任何一筆「迴圈放行後下游抓到可歸因缺陷」的紀錄。空≠零逃逸——也可能是沒人記;要記:")
            print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <minor|major|blocker> --desc <一句描述>")
            return 0
        import json as _je
        rows, bad = [], []
        for no, ln in enumerate(log.read_text(encoding="utf-8").splitlines(), 1):
            if not ln.strip():
                continue
            try:
                d = _je.loads(ln)
            except ValueError:
                bad.append(no)
                continue
            if not isinstance(d, dict):
                bad.append(no)      # 合法 JSON 但非物件(null/陣列)——r1 外家 ESC-03:一筆就能弄壞整個 --list
                continue
            rows.append(d)
        if bad:
            print(f"提醒:逃逸帳有 {len(bad)} 行壞損被跳過(行 {', '.join(map(str, bad[:5]))}"
                  + ("…" if len(bad) > 5 else "") + f");帳檔:{log}", file=sys.stderr)
        by_loop = {}
        for r in rows:
            by_loop.setdefault(str(r.get("loop", "?")), []).append(r)
        print(f"逃逸帳:{len(rows)} 筆(迴圈收斂放行後、下游抓到的可歸因缺陷;歸因為人工判斷)")
        for lp, rs in sorted(by_loop.items()):
            worst_row = max(rs, key=lambda r: _SEV_W.get(r.get("severity"), -1))
            wsev = worst_row.get("severity")
            wlabel = wsev if wsev in _SEV_W else f"非標準值 {_esc_clean(wsev, 20)}(手改帳?)"
            print(f"  {_esc_clean(lp, 60)}:{len(rs)} 筆(最重 {wlabel})")
            for r in rs:
                sev = r.get("severity")
                sev_disp = sev if sev in _SEV_W else f"?{_esc_clean(sev, 12)}"
                print(f"    {str(r.get('ts') or '?')[:10]} [{sev_disp}@{_esc_clean(r.get('stage', '?'), 30)}] {_esc_clean(r.get('desc', ''))}"
                      + (f"(佐證:{_esc_clean(r['defect_ref'], 80)})" if r.get("defect_ref") else "")
                      # ★逐筆看得到有沒有標規則★(r1 通才席):只有彙總看得到的話,巡帳的人不知道哪一筆漏標
                      + (f"[本來該抓的規則:{_esc_clean(str(r['rule']), 40)}]" if r.get("rule") else "[沒標該抓的規則]"))
        return 0
    # ── 記帳模式:全部驗證在此(r1 架構席 R-2:dispatch 只路由,驗證不拆層) ──
    if not loop_id:
        print("擋下:要記逃逸就得說是哪個迴圈編號放行的。看帳:\n    lumos loop escape --list", file=sys.stderr)
        return 2
    if severity not in _SEV_W:
        print("擋下:--severity 必填且只能是 minor|major|blocker(同審查帳值域)", file=sys.stderr)
        return 2
    if not (stage or "").strip():
        print("擋下:--stage 必填(在哪一站發現:實作/code-loop/CI/prod/使用者回報…)——缺階段的逃逸帳之後做不了「在哪一站漏的」分層統計", file=sys.stderr)
        return 2
    if not (desc or "").strip():
        print("擋下:--desc 不能空——沒有描述的逃逸帳讀側無從歸因,等於沒記", file=sys.stderr)
        return 2
    ledger = env.vault.parent / ".canary-log.jsonl"
    known, led_bad = set(), 0
    if ledger.exists():
        import json as _je2
        for ln in ledger.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                v = _je2.loads(ln).get("loop")
            except ValueError:
                led_bad += 1
                continue
            if isinstance(v, str):
                known.add(nfc(v))     # r1 邊界席 B-3:NFC 正規化,NFD 貼上形不再肉眼無解
    if nfc(loop_id) not in known:
        msg = f"擋下:審查帳裡沒有叫「{loop_id}」的迴圈——逃逸要歸因到真實存在的迴圈,先確認編號:\n    lumos gov --stats"
        if led_bad:
            msg += f"\n  (審查帳另有 {led_bad} 行壞損被跳過——查不到也可能是編號在那幾行裡)"
        print(msg, file=sys.stderr)
        return 2
    import datetime as _dt_esc
    import secrets as _sec_esc
    rec = {"ts": _dt_esc.datetime.now().astimezone().isoformat(timespec="seconds"),
           "token": "ESC-" + _sec_esc.token_hex(4),       # 落盤自驗唯一鍵(canary auto-mint 慣例)
           "loop": loop_id, "stage": stage.strip(), "severity": severity, "desc": desc.strip()}
    if defect_ref:
        rec["defect_ref"] = defect_ref
    if rule:
        # ★閉環的那一格★:標「本來哪條規則該抓」,漏網才長得出新的守衛;
        # 不標的話這本帳只記得「漏掉了」,永遠不會變成下次擋得住的東西(看待辦:lumos rule-gap)
        rec["rule"] = rule.strip()
    if log.is_symlink():
        # r2 終態席實測:既存 symlink 會繞過建檔保護、共用寫入原語 open('a') 跟隨連結寫進外部檔——
        # 每次寫前先擋本體(殘餘=判斷與開檔間競態,best-effort 同 _ledger_append 家族誠實降級)
        print(f"擋下:逃逸帳檔是一個符號連結,不往裡寫(帳本必須是普通檔案):\n    {log}", file=sys.stderr)
        return 2
    if not log.exists():
        try:
            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
        except FileExistsError:
            pass
        except OSError as e:
            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
            return 2
    rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])   # 共用硬化原語(OSError 擋下+讀回自驗);已知天花板=撞鍵時讀回比對可能對到舊筆(canary 全家族同款,hex4 空間機率極低)
    if rc_w:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。
    讀 .canary-log.jsonl 的 **append 序**(不 ts-sort:ts 只到秒、同秒會並列),篩 loop==id。
    tail-K 滑動窗:前面髒輪不影響、只看最後 K 筆;missed/缺 severity 視同未收斂。
    exit 0=CONVERGED / 1=未收斂(含無記錄=還沒開始)/ 2=真錯誤。
    天花板:收斂=連 K 輪醒著的審計員沒找到 blocker/major,非完整正確;severity 自報(見設計 doc)。"""
    import json
    if light and panel:
        print("擋下:--light 和 --panel 不能一起用(light 是單人審、panel 是多人審,兩條不同的路),擇一", file=sys.stderr)
        return 2
    explicit_need = need is not None
    if need is None:
    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
    互斥照樣成立。

    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
    """
    import hashlib
    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
    return primary, None


def _vault_lock_say(lock, why):
    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
          file=sys.stderr)
    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)


def _vault_write_lock(vault):
    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。

    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
    import contextlib, time as _t

    @contextlib.contextmanager
    def _cm():
        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
        lock, why = _vault_lock_where(vault)
        k = str(lock)

        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
            _VAULT_LOCK_HELD[k] += 1
            try:
                yield
            finally:
                _VAULT_LOCK_HELD[k] -= 1
            return

        if why and not _VAULT_LOCK_WARNED.get(k):
            _VAULT_LOCK_WARNED[k] = True
            _vault_lock_say(lock, why)
        deadline = _t.monotonic() + 60
        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
            if _t.monotonic() > deadline:
                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
            _t.sleep(0.05)
        _VAULT_LOCK_HELD[k] = 1
        try:
            yield
        finally:
            _VAULT_LOCK_HELD.pop(k, None)
            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
                    lock.unlink()
            except OSError:
                pass
    return _cm()


def cmd_set(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_set_locked(env, rel, key, value)


def _cmd_set_locked(env, rel, key, value):
    if key in COND_KEYS:
        return _set_conditions_locked(env, rel, key, value if isinstance(value, list) else [value])
    if isinstance(value, list):
        if len(value) != 1:
        return None
    hay = _quote_norm(stext)
    hay_ns = hay.replace(" ", "")
    rows = []
    for q in quotes:
        nq = _quote_norm(q)
        too_short = len(nq) < _QUOTE_MIN_NORM_LEN
        # CJK 折行 fallback(Landmark 真場實測):快照句中折行使 norm 後多一個空格,
        # 連續引句子字串必 miss——空白全剝再比一次(存在性檢查,黏合誤中風險可忽略:
        # 引句有 10 字下限,跨句黏合要恰好湊出同字序)
        anchored = nq in hay or nq.replace(" ", "") in hay_ns
        rows.append({"quote": q, "ok": (not too_short) and anchored,
                     **({"too_short": True} if too_short else {})})
    for _ in range(n_markers - len(quotes)):
        rows.append({"quote": "(引號未閉合/開閉型態不符,無法抽取)", "ok": False, "malformed": True})
    return rows


# ═══ 處置閘「資安席」一步(Projects/代碼審資安席_計劃,2026-09-11 Enzo 裁 d6)═══
# 高風險代碼審一律必派一席資安;編制表上 requirement=required-gated 的席,出席與否由這一步硬擋。
_REQUIREMENT_LABEL = {"required-gated": "必派(問閘會擋)"}   # loop next 人讀輸出用;--json 仍給原值
# 席名怎麼認:用連字號切段,任一段完全等於席位名或別名即算(英文不分大小寫)。只有人裁能加一個 required-gated 席。
_GATED_SEAT_ALIASES = {"資安": ("資安", "security")}


def _loop_anchor_tier(rounds):
    """迴圈的定錨分級:帳上第一筆帶 tier 的值。loop next 與處置閘資安席一步呼叫同一支——
    寫帳那側不擋中途改 tier,改用「任一筆 high」會對一個從沒被派過 high 編制的迴圈要求資安席(r1 邊界 B3)。"""
    return next((r["tier"] for r in rounds if r.get("tier")), None)


def _auditor_matches_slot(auditor, slot):
    """這個席名坐的是不是這個席位:連字號切段,任一段(去頭尾空白)完全等於席位名或別名即算,英文不分大小寫。
    ★整段相等,不是子字串★:「資安審-sonnet」「非資安-sonnet」不算;模型名自己帶連字號(資安-gpt-5.6-terra)、
    前面帶席號(s4-資安-sonnet)都算。原本「取最後一個連字號前那段」會把多連字號的真實命名判錯
    (帳上 308 個席名有 109 個帶兩個以上連字號;r1 邊界 B1、整合 C1)。"""
    if not isinstance(auditor, str) or not auditor.strip():
        return False
    names = {a.casefold() for a in _GATED_SEAT_ALIASES.get(slot, (slot,))}
    return any(seg.strip().casefold() in names for seg in auditor.split("-"))


def _git_unquote_path(s):
    """還原 git 在 diff 檔頭替路徑加的 C 式引號。core.quotePath 預設開:中文等非 ASCII 會寫成
    `"a/docs/\\344\\270\\255.md"` 這種八進位跳脫。沒加引號的原樣回。
    ★為什麼 lumos 自己呼叫 git 時用 -c core.quotePath=false、這裡卻要還原★(代碼審 r1 架構對齊 B1):
    專案慣例是從源頭關掉跳脫(本檔各處 git 呼叫都這樣做,代碼審 SKILL 的凍結指令也已補上同一個旗標);
    但凍結 patch 是編排者自己下指令產的輸入檔,舊迴圈、別家編排者、忘了帶旗標的都會帶引號——
    判不準就會把同一支檔當兩支、或把兩支當同一支,所以讀這種輸入時要容錯,不是另一套產生方式。
    ★只去掉行尾換行,不削空白★(r1 外家否決 E1):檔名尾端的空白是檔名的一部分,
    削掉會把「app/login.py」與「app/login.py 」併成一支,資安席只看過前者也能讓後者過關。"""
    s = s.rstrip("\r\n")
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        import codecs
        try:
            return codecs.escape_decode(s[1:-1].encode("latin-1", "backslashreplace"))[0].decode("utf-8", "surrogateescape")
                    _tag = "寫側有 bug,開 Issue 攤人;" if _new_era else "歷史帳,"
                    print(f"[severity] {_r.get('auditor','?')}: {_msg}({_tag}觀測,不進合取)")
                    _hits.append(f"severity_underreport:{_r.get('auditor','?')}")
            if _hits:
                try:
                    _ldir = (Path(repo).resolve() if repo else _vault_repo_root(env)) / "governance" / "review-reports" / loop_id
                    _ldir.mkdir(parents=True, exist_ok=True)
                    import datetime as _dt2
                    with open(_ldir / "roster-alerts.log", "a", encoding="utf-8") as _f2:
                        _f2.write(f"{_dt2.date.today().isoformat()} {rid} {','.join(_hits)}\n")
                except OSError as _e2:
                    print(f"[severity] 異常留痕寫入失敗({_e2})——轉述已印,只是覆核帳少這筆")
        except Exception as _e2:
            print(f"[severity] 嚴重度對帳失敗(降級不擋):{_e2}")
    if not readonly:
        # replay 唯讀:觀測尾巴不跑——roster 尾端會寫 roster-alerts.log(r2 delta d-f3 抓的第三個寫入點),
        # severity 尾端同理;純判定核心=四合取本體。
        _roster_tail()
        _severity_tail()
    # intake守衛 T2(2026-08-30 d1;advisory 不進合取不改 rc):非 code 迴圈才看
    # (r3-F2:code-loop 零前掃步驟,code 的 intake 是撈回紀錄非前掃紀錄——計數它=逼偽宣告)。
    if not readonly and not str(loop_id).startswith("code"):
        _ik_st = _intake_dir_status(root if root is not None else Path.cwd(), loop_id)
        if _ik_st == "ok":
            print("[disposal] intake(觀測,不進合取): ✓ — 迴圈目錄有帶 preflight-4 宣告行的前掃留痕")
        elif _ik_st == "missing":
            print("[disposal] intake(觀測,不進合取): ⚠ 迴圈目錄無帶 preflight-4 宣告行的 intake——"
                  "首輪前掃第四類可能沒跑(慣例=skills/lumos-design-loop/SKILL.md 步驟 2;不擋,記著補)")
        # no-dir(scratch 迴圈,如自主迴圈 /tmp 工作區)= 跳過不印
        # ── 審查有沒有用記帳 S3(2026-09-08):問閘這一輪的漏斗,觀測不進合取 ──
        _y = _review_yield_round(latest)
        _esc = len(_escape_rows_for(env, loop_id)) if env is not None else None
        print("[disposal] 審查有沒有用(觀測,不進合取;N 機器數、R 人填,別算比率): " + _review_yield_line(_y, _esc))
    # ── ⑤ 條款綁定(條款綁測試算進度 [S3],2026-09-08):計劃有 [SN] 的,每條要嘛 [test:] 要嘛 [manual:],否則不得 PASS。
    #    只看 .md 計劃、首筆帳在 _CLAUSE_GATE_SINCE 之後的迴圈(不回溯);懸空只印不擋(存在性歸 doctor/spec-trace 唸)。
    _cl = _disposal_clause_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _cl == "abort":
        return 2          # 同 G3:審材讀不到是用法錯誤,整支停,不是「這一項沒過」(r1/r2 架構席)
    if _cl == "fail":
        fails.append("條款綁定")
    # ── ⑥ 資安席(代碼審資安席 [S2],2026-09-11 d6):定錨 high 的代碼審,編制表上 required-gated 席要出席、留痕對、
    #    看過的檔涵蓋判定輪。只看生效日後開的迴圈(不回溯)。凍結/回放照樣重讀檔(凍結閉包也收了這些檔)。
    _sec = _disposal_security_step(rounds, rid, loop_id, _prov_path)
    if _sec == "fail":
        fails.append("資安席")
    # ── ⑦ 落點(每支檔有家 [S21],2026-09-11):計劃要寫明現況落在哪幾篇;首筆帳在 _LANDING_GATE_SINCE 之後的迴圈才看。
    _ld = _disposal_landing_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _ld == "abort":
        return 2
    if _ld == "fail":
        fails.append("落點")
    if result_out is not None:
        result_out["rid"] = rid
        result_out["fails"] = list(fails)
    if fails:
        print(f"⛔ DISPOSAL GATE FAIL ({loop_id} 輪 {rid}: {'/'.join(fails)})")
                          "problems": problems}, ensure_ascii=False))
        return 1 if problems else 0
    if not problems:
        print("✓ rule-check: " + str(fired) + " 條自寫規則,每條都有樣本而且樣本真的被抓到了")
        print("  (這只證明規則活著、抓得到它自己的樣本;不證明它在真實程式碼上不誤報)")
        return 0
    print("✗ rule-check: " + str(len(problems)) + " 條規則沒有會翻紅的樣本:")
    for pr in problems:
        print("  [" + pr["rule"] + "] " + pr["issue"])
    print("在意的原因:規則寫了不等於它會抓到東西。沒有樣本的規則可能從頭到尾都是死的,而死規則跟沒有規則一樣。")
    print("接下來:")
    print("    在 .lumos/rules/samples/ 放一支會被它抓到的樣本,登記進 .lumos/rules/index.json 的 rules")
    return 1


def cmd_rule_gap(repo=None, as_json=False):
    """把逃逸帳裡「本來哪條規則該抓」的標記,變成「該寫哪條規則」的待辦。
    ★這是閉環的那一環★:審查放行之後下游才發現的缺陷,如果有人標了它屬於哪條規則,
    就能算出「這條規則還沒寫」——沒有這一步,逃逸帳只是一本帳,不會長出新的守衛。"""
    import json
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        print("✗ rule-gap: 從目前目錄往上找不到 git repo——帶 --repo <根> 指定,或到 repo 內執行", file=sys.stderr)
        return 2
    # 逃逸帳位置:記帳那支寫在「知識庫的上一層」,標準佈局是 <repo>/docs/,
    # 但知識庫本身就是 repo 根的那種佈局(standalone)會落在別的地方——兩個都找(r1 通才席)
    cands = [Path(repo_root) / "docs" / ".escape-log.jsonl", Path(repo_root) / ".escape-log.jsonl"]
    log = next((c for c in cands if c.is_file()), cands[0])
    counts, unlabeled = {}, 0
    if log.is_file():
        for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            _raw = ev.get("rule")
            rid = _raw.strip() if isinstance(_raw, str) else ""   # 非字串不要整支崩,當成沒標
            if not rid or rid == "none":
                unlabeled += 1
                continue
            counts.setdefault(rid, {"n": 0, "desc": ev.get("desc", "")[:60]})
            counts[rid]["n"] += 1
    have = set(_rules_declared_ids(repo_root))
    idx, idx_err = _rules_load(repo_root)
    have |= set((idx.get("rules") or {}))
    if idx_err:
        # ★不要吞掉★(r1 邊界席):索引讀不了就少算「已經寫成規則的」,清單會憑空多出待辦
        print("提醒:" + idx_err + "——這份清單少算了索引裡登記過的規則,先修好索引再看", file=sys.stderr)
    missing = {k: v for k, v in counts.items() if k not in have}
    if as_json:
        print(json.dumps({"missing": missing, "covered": sorted(set(counts) & have),
                          "unlabeled": unlabeled}, ensure_ascii=False))
        return 0
    if not counts and not unlabeled:
        print("逃逸帳是空的:還沒有任何一筆「審查放行後下游才抓到」的紀錄。")
        print("  空≠零逃逸——也可能是沒人記。要記:")
        print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <等級> --desc <一句> --rule <本來哪條規則該抓|none>")
        return 0
    if missing:
        print("這些漏網的問題有人標了「本來哪條規則該抓」,但那條規則還不存在(" + str(len(missing)) + " 條):")
        for rid, v in sorted(missing.items(), key=lambda kv: -kv[1]["n"]):
            print("  " + rid + "(漏過 " + str(v["n"]) + " 次)—— " + v["desc"])
        print("在意的原因:逃逸帳只記「漏掉了」,不會自己長出守衛;把重複漏過的那幾條寫成規則,下次才擋得住。")
        print("接下來:")
        print("    在 .lumos/rules/ 寫規則 + 在 samples/ 放會翻紅的樣本,然後 lumos rule-check")
    else:
        print("逃逸帳裡標到的規則都已經寫出來了(" + str(len(counts)) + " 條)。")
    if unlabeled:
        print("另有 " + str(unlabeled) + " 筆沒標「本來哪條規則該抓」——沒標的算不進這個統計,記的時候順手帶 --rule。")
    return 0


def _testlayers_load_config(repo_root):
    """讀取 repo_root/.lumos/test-layers.json → dict;不存在/解析失敗/非 dict → None(fail-open)。"""
    import json
    p = Path(repo_root) / ".lumos" / "test-layers.json"
    if not p.exists():
        return None
    try:
        with open(p, encoding="utf-8") as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else None
    except Exception:
        return None


def _testlayers_hits(files, config):
    """files 副檔名(lstrip '.')比對 config key(語意同 _lint_stacks_for_diff)。
    cr.add_argument("--orchestrator", dest="rec_orch", choices=("claude", "codex"),
                    help="d4 編排者定錨欄:誰在編排這個迴圈(外家席=不是編排者那一家);首筆定錨,之後要一致")
    cr.add_argument("--report", help="[T1 處置帳] 審查員報告檔路徑(存 path+sha256;檔案須存在且非空)")
    cr.add_argument("--snapshot", help="[T1 處置帳] 派工凍結快照檔路徑(quote-check 的比對對象;存 path+sha256)")
    cr.add_argument("--intake", help="首輪前掃留痕檔(rN-intake.md;選配——給了就存 path+sha256 且處置閘會全輪重驗,不給不擋。intake守衛案 2026-08-30)")
    cr.add_argument("--findings-set", dest="findings_set",
                    help="[T1 處置帳] 逐條 finding id 逗號串(集合核對的全集;與 folded/accepted 配套)")
    cr.add_argument("--folded-set", dest="folded_set", help="[T1 處置帳] 折入計劃節點的 id 子集")
    cr.add_argument("--accepted-set", dest="accepted_set",
                    help="[T1 處置帳] 附理由放行的 id 子集(與 folded 互斥;聯集須=全集;blocker 輪必空)")
    cr.add_argument("--accept-reason", dest="accept_reasons", action="append",
                    help="[T1 處置帳] id=理由(可重複;鍵集合須=accepted-set,理由非空)")
    cr.add_argument("--finding-kind", dest="finding_kinds", action="append",
                    help="每條發現在修什麼:id=code(程式缺陷)|spec(被審文件缺陷)|process(流程要求的文件/留痕/範本);選填,給了要全集對得上——量「流程自產工作量」用")
    cr.add_argument("--finding-severity", dest="finding_severities", action="append",
                    help="每條發現自己的嚴重度:id=clean|minor|major|blocker;選填,給了要每條各標一個——逃逸自動記靠它判「code 型那條是不是 major 以上」,沒給就退回輪級判準並在逃逸帳標 precision=round")
    cr.add_argument("--refute-verdict", dest="refute_verdicts", action="append",
                    help="辯方對某條發現的明確表態:id=agree(同意是真的,維持)|evidence(拿反證降級,須附 file:line)|concern(只存疑無反證,維持);選填,鍵是辯方判過的子集(⊆全集,辯方只判低共識≥major)——純記帳不改判閘,供日後偵測『辯方降級的後來證明是真的』(2026-08-22 三分類裁定的重啟條件)")

    cr.add_argument("--refuted-set", dest="refuted_set",
                    help="[審查有沒有用記帳 S2] 編排者機械重現不到、沒折也沒放行的發現:id=理由 逗號串,或 none(這輪 0 條);帶 --findings-set 就必帶;id 不得在 findings-set 裡、要對得上 --intake 的重現表列(整字+HIT/MISS)、理由 ≥4 字含實字")

    rn = sub.add_parser("report-normalize", help="[審查有沒有用記帳 S4] 席報告收貨正規化:把行內/列表/標題式的 severity 轉成獨立宣告行、補檔級行;不帶 --write 只印")
    rn.add_argument("path", help="要正規化的席報告 markdown 檔路徑")
    rn.add_argument("--write", action="store_true", help="真的寫回(原子覆寫);不帶只印會改什麼、還剩什麼")

    lp = sub.add_parser("loop", help="審計 loop 收斂查詢(消費 canary-log 的 --loop 記錄)")
    lsub = lp.add_subparsers(dest="lcmd", required=True)
    ls = lsub.add_parser("status", help="算某 loop 收斂:連 K 輪 caught 且無 blocker/major")
    ls.add_argument("loop_id")
    ls.add_argument("--need", type=int, default=None, help="連續乾淨輪數 K(預設 2;--settle 下禁用)")
    ls.add_argument("--disposal", action="store_true",
                    help="[T4] 處置閘(獨立路徑,與 --panel/--light/--settle/--need/--min-seats 互斥;需 --spec)")
    ls.add_argument("--gate", action="store_true",
                    help="證據閘:K-streak(必要)∧ G1 refcheck 引用座標 ∧ G2 發現枯竭,全過才 rc 0")
    ls.add_argument("--spec", dest="gate_spec", help="--gate 必填:要核對引用座標的最終 spec md")
    ls.add_argument("--repo", dest="gate_repo", help="repo root(預設 cwd 逐層向上找 .git)")
    ls.add_argument("--panel", action="store_true",
                    help="平行 panel 模式:按 round-id 分組。無-cluster 帳=兩條合取(輪有效∧存活max≤minor;capture-recapture 殘餘=advisory 不進合取,2026-08-14 降級);cluster 帳(M2,首個有效輪帶 --clusters 定錨)=兩條合取(輪有效∧fold後無disputed-major),新生cluster/capture-recapture 同 advisory。--gate 對 panel 為相容 no-op(panel 判準恆生效)")
    ls.add_argument("--light", action="store_true",
                    help="M1包 light K=1 謂詞:單席 caught∧max≤minor∧欄位互證∧hash 雙欄(強制 fail-closed);ratchet=任一 caught 輪≥major 永久 FAIL;與 --panel 互斥;需 --spec")
    ls.add_argument("--settle", metavar="清單檔",
                    help="結清模式(opt-in,v1 只接 legacy):JSON 約束清單,全結清∧G1∧G3 才收斂;"
                         "與 --panel/--light/--need/--min-seats 互斥,需 --gate+--spec")
    ls.add_argument("--min-seats", type=int, dest="min_seats",
                    help="M1包 席數下限:判定輪相異 auditor 數<N 即 FAIL(同席重複 append 不計;不帶=行為不變)")
    ls.add_argument("--roster", action="store_true",
                    help="[派工編制資料化] 編制對帳觀測(advisory 恆不影響 rc):應派(_TIER_ROSTER)vs 實派"
                         "(rN-dispatch*.json)逐輪分桶比;與所有模式相容,建議配 --repo。"
                         "全史觀測/回放用——問閘 --disposal 偵測到席位異常會自動轉述當輪,"
                         "同帶本旗標時尾端不重複(詳 Projects/roster對帳併入問閘_計劃)")
    lc = lsub.add_parser("compress", help="[S2] 結構化壓縮:長跑上下文規則式三欄(白名單壓不掉/證據/未結)")
    lc.add_argument("compress_file", metavar="檔")
    lc.add_argument("--json", dest="compress_json", action="store_true")
    lv = lsub.add_parser("verify-progress", help="[S3] 獨立進度驗證器:直讀帳只吃結構欄位,散文注入免疫")
    lv.add_argument("vp_loop_id", metavar="loop_id")
    lv.add_argument("--settle", dest="vp_settle", metavar="清單檔")
    lv.add_argument("--json", dest="vp_json", action="store_true")
    lr = lsub.add_parser("rewrite", help="人裁「整份重寫」收尾:記 rewrite 事件+血緣 note(prev/successor),自動查「連續兩次」")
    lr.add_argument("rw_loop_id", metavar="loop_id")
    lr.add_argument("--successor", dest="rw_successor", required=True, help="接手的新迴圈編號")
    lr.add_argument("--note", dest="rw_note", default="", help="一句為什麼判重寫(人裁依據)")
    ln = lsub.add_parser("next", help="M1包 機械脊椎:帳本吐唯一下一動作(phase/輪數/canary 型別/席數/記帳模板);唯讀指針,不 spawn agent")
    ln.add_argument("loop_id")
    ln.add_argument("--tier", dest="next_tier", choices=("light", "standard", "high"),
                    help="編排者宣告 tier(有帳面定錨時須一致否則 rc2;零記錄必填)")
    ln.add_argument("--orchestrator", dest="next_orch", choices=("claude", "codex"),
                    help="誰在編排(claude|codex;零記錄必填、不預設;有帳面定錨須一致)——外家席=不是編排者那一家(d4)")
    ln.add_argument("--json", action="store_true", dest="next_json", help="機讀輸出")
    ln.add_argument("--need", type=int, default=2, help="legacy 收斂窗 K(委派 gate 用,預設 2)")
    ln.add_argument("--spec", dest="gate_spec", help="gate 委派用 spec 檔;缺=判 converged 資訊不足→gate-pending")
    ln.add_argument("--repo", dest="gate_repo", help="repo root(gate 委派用)")
    le = lsub.add_parser("escape",
                         help="逃逸帳:迴圈放行後下游抓到可歸因缺陷→記一筆(--list 看全帳)",
                         description="什麼時候用:某個審查迴圈收斂放行了,但下游(實作/CI/prod/人)發現可歸因的缺陷——記一筆逃逸帳。append-only、不進任何閘;歸因是人工判斷,編號必須實存於審查帳。看全帳用 --list(唯讀,不能與記帳參數混用)。")
    le.add_argument("esc_loop_id", nargs="?", default=None, metavar="loop_id", help="放行該缺陷的迴圈編號(必須存在於審查帳)")
    le.add_argument("--stage", dest="esc_stage", help="在哪一站發現:實作/code-loop/CI/prod/使用者回報…(自由字串)")
    le.add_argument("--severity", dest="esc_severity", choices=("minor", "major", "blocker"), help="缺陷嚴重度(同審查帳值域)")
    le.add_argument("--desc", dest="esc_desc", help="一句描述:什麼缺陷、為何可歸因到該迴圈")
    le.add_argument("--defect-ref", dest="esc_ref", help="佐證指標(commit/Issue/報告路徑,選配)")
    le.add_argument("--auto", dest="esc_auto", action="store_true",
                    help="自動記:不給編號,改給 --range,碰到的計劃筆記各記一筆(推送閘/CI 用);對不回不記")
    le.add_argument("--range", dest="esc_range", help="--auto 用:提交範圍 a..b")
    le.add_argument("--sha", dest="esc_sha", help="--auto 用:去重鍵的 sha(不給就取 HEAD)")
    le.add_argument("--repo", dest="esc_repo", help="--auto 用:repo 根(不給就用 vault 的上兩層)")
    le.add_argument("--rule", dest="esc_rule", help="本來哪條規則該抓到它(規則 id;真的沒有對應規則就寫 none)。標了才算得出「該寫哪條規則」——看待辦:lumos rule-gap")
    le.add_argument("--list", dest="esc_list", action="store_true", help="列全帳(按迴圈分組)")
    ll = lsub.add_parser("list", help="哪些審查迴圈還開著(帳面沒關門的);next/status 都要 loop_id,這支先給你編號")
    ll.add_argument("--days", dest="ll_days", type=int, default=14, help="幾天內有動才算「在飛」(預設 14)")
    ll.add_argument("--stale", dest="ll_stale", action="store_true", help="只看超過門檻沒動又沒關門的(空轉候選)")
    ll.add_argument("--all", dest="ll_all", action="store_true", help="連已關門的也列")
    ll.add_argument("--exclude", dest="ll_exclude", action="append", default=[], metavar="前綴",
                    help="略過編號以此開頭的迴圈(可重複;例:--exclude auto- 排掉自主迴圈的每日場次)")
    ll.add_argument("--json", dest="ll_json", action="store_true")
    ll.add_argument("--now", dest="ll_now", metavar="YYYY-MM-DD", help="指定「今天」是哪一天(重算/測試用;預設系統日期)")
    lcs = lsub.add_parser("canary-stats",
        if args.sg_door_rule:
            print(f"door_rule={_DOOR_RULE_VERSION} inputs_sha={_door_rule_fingerprint()}")
            return 0
        if args.sg_push:
            return _spec_gate_push_check(env, args.sg_push, repo=args.sg_repo)
        if not args.node:
            print("擋下:要給計劃節點(lumos spec-gate Projects/<名>_計劃),或用 --push-check <範圍> / --door-rule", file=sys.stderr)
            return 2
        return cmd_spec_gate(env, args.node, no_run=args.sg_no_run)
    if args.cmd == "spec-trace":
        return cmd_spec_trace(env, args.node, as_json=args.st_json)
    if args.cmd == "signoff":
        return cmd_signoff(env, args.node, note=args.note, by=args.by, ref=args.so_ref)
    if args.cmd == "gov":
        return cmd_gov(env, args.node, since_days=args.since, full=args.full, stats=args.stats, nags=args.gov_nags)

    if args.cmd == "ci-wait":
        return cmd_ci_wait(env, timeout=args.cw_timeout, repo_dir=args.cw_repo,
                           sha=args.cw_sha, branch=args.cw_branch,
                           grace=args.cw_grace, as_json=args.cw_json)
    if args.cmd == "ci-status":
        return cmd_ci_status(env, repo_dir=args.cs_repo, as_json=args.cs_json)
    if args.cmd == "about-code":
        if args.accmd == "revert":
            return cmd_about_code_revert(env, args.batch, dry_run=args.dry_run)
        if args.accmd == "restamp":
            return cmd_about_code_restamp(env, args.node, by=args.by)
        if args.accmd == "migrate-stamp":
            return cmd_about_code_migrate_stamp(env, args.at, repo_root=args.acm_repo, dry_run=args.dry_run)
    if args.cmd == "canary":
        if args.ccmd == "second":
            return cmd_canary_second(env, ref_id=args.sec_ref, verdict=args.sec_verdict,
                                     auditor=args.sec_auditor, note=args.sec_note)
        return cmd_canary(env, args.kind, args.auditor, args.token, args.note, args.loop,
                          args.severity, findings=args.findings, round_id=args.round_id,
                          canary_type=args.canary_type, probe=args.probe,
                          capture_counts=args.capture_counts, clusters=args.clusters,
                          spec=args.rec_spec, reviewed=args.reviewed,
                          tokens=args.tokens, wallclock_min=args.wallclock_min, tier=args.rec_tier,
                          outcome=args.rec_outcome, usd=args.rec_usd, orchestrator=args.rec_orch,
                          scope_lines=args.scope_lines, report=args.report, snapshot=args.snapshot, intake=args.intake,
                          findings_set=args.findings_set, folded_set=args.folded_set,
                          accepted_set=args.accepted_set, accept_reasons=args.accept_reasons,
                          finding_kinds=getattr(args, 'finding_kinds', None),
                          finding_severities=getattr(args, 'finding_severities', None),
                          refute_verdicts=getattr(args, 'refute_verdicts', None),
                          refuted_set=getattr(args, 'refuted_set', None))


    if args.cmd == "handoff":
        return cmd_handoff(env, args.handoff_node, as_json=args.handoff_json,
                           transcript=args.handoff_transcript, turns=args.handoff_turns)
    if args.cmd == "loop":
        if args.lcmd == "list":
            return cmd_loop_list(env, days=args.ll_days, show_all=args.ll_all,
                                 stale_only=args.ll_stale, as_json=args.ll_json, now=args.ll_now,
                                 exclude=args.ll_exclude)
        if args.lcmd == "canary-stats":
            return cmd_loop_canary_stats(env, args.loop_id)
        if args.lcmd == "status":
            return cmd_loop_status(env, args.loop_id, args.need,
                                   gate=args.gate, spec=args.gate_spec, repo=args.gate_repo,
                                   panel=args.panel, light=args.light, min_seats=args.min_seats,
                                   settle=args.settle, disposal=args.disposal, roster=args.roster)
        if args.lcmd == "compress":
            return cmd_loop_compress(args.compress_file, as_json=args.compress_json)
        if args.lcmd == "verify-progress":
            return cmd_loop_verify_progress(env, args.vp_loop_id, settle=args.vp_settle,
                                            as_json=args.vp_json)
        if args.lcmd == "replay":
            return cmd_loop_replay(env, args.rp_loop_id, golden=args.rp_golden, freeze=args.rp_freeze,
                                   spec=args.rp_spec, note=args.rp_note, repo=args.rp_repo)
        if args.lcmd == "rewrite":
            return cmd_loop_rewrite(env, args.rw_loop_id, args.rw_successor, args.rw_note)
        if args.lcmd == "escape":
            return cmd_loop_escape(env, loop_id=args.esc_loop_id, stage=args.esc_stage,
                                   severity=args.esc_severity, desc=args.esc_desc,
                                   defect_ref=args.esc_ref, list_mode=args.esc_list, rule=args.esc_rule,
                                   auto=args.esc_auto, git_range=args.esc_range, sha=args.esc_sha, repo=args.esc_repo)
        if args.lcmd == "next":
            return cmd_loop_next(env, args.loop_id, tier=args.next_tier, as_json=args.next_json, orchestrator=args.next_orch,
                                 need=args.need, spec=args.gate_spec, repo=args.gate_repo)
        # capture-counts 已在 vault-free 段提前處理(見上)

    if args.cmd == "guard":
        if args.gcmd == "list":
            return cmd_guard_list(env, unbound_only=args.unbound)
        if args.gcmd == "scaffold":
            return cmd_guard_scaffold(env, args.node, args.invariant, args.method,
                                      args.type, args.claim, out_dir=args.out,
                                      template=args.template, klass=args.klass,
                                      platform=args.platform)
        if args.gcmd == "plan":
            return cmd_guard_plan(env, args.node, args.claim, args.gp_plan, args.gp_phase,
                                  args.gp_due, args.gp_why, args.gp_owner, args.gp_name)
        if args.gcmd == "settle":
            return cmd_guard_settle(env, args.ref, args.gs_test)
        if args.gcmd == "abandon":
            return cmd_guard_abandon(env, args.ref, args.ga_why)
        if args.gcmd == "required":
            return cmd_guard_required(env)

exec
