  8613	def cmd_loop_compress(file, as_json=False):
  8614	    """[S2] 結構化壓縮(結清式收斂_計劃,2026-07-28):長跑上下文不交通用摘要——規則式三欄:
  8615	    壓不掉白名單(★合約/停在放行點/anchor 驗證/[PIN] 口頭約定)/已驗證證據(VERIFY:/✅/[test:)/
  8616	    未結約束(checkbox/TODO/BLOCKER)。白名單行在輸出**必存在**(治 governance decay 殘餘面:
  8617	    對話中途口頭約定寫成 [PIN] 行即壓不掉);無標記散文可丟。零模型、純規則,輸出走 stdout
  8618	    (落檔權在消費者——orchestrator 自行重導)。rc0 成功/rc2 檔不可讀。"""
  8619	    import json
  8620	    try:
  8621	        lines = Path(file).read_text(encoding="utf-8-sig").splitlines()
  8622	    except OSError as e:
  8623	        print(f"擋下:檔案讀不到({e}): {file}", file=sys.stderr)
  8624	        return 2
  8625	    pinned, evidence, open_items = [], [], []
  8626	    for ln in lines:
  8627	        s = ln.strip()
  8628	        if not s:
  8629	            continue
  8630	        if _COMPRESS_PIN_RE.search(s):
  8631	            pinned.append(s)
  8632	        elif _COMPRESS_EVID_RE.search(s):
  8633	            evidence.append(s)
  8634	        elif _COMPRESS_OPEN_RE.search(s):
  8635	            open_items.append(s)
  8636	    if as_json:
  8637	        print(json.dumps({"pinned": pinned, "evidence": evidence, "open": open_items,
  8638	                          "input_lines": len(lines)}, ensure_ascii=False, indent=1))
  8639	        return 0
  8640	    print("# 壓縮狀態(規則式;白名單壓不掉)")
  8641	    for title, bucket in (("壓不掉白名單", pinned), ("已驗證證據", evidence), ("未結約束", open_items)):
  8642	        print(f"## {title}")
  8643	        for s in bucket:
  8644	            print(f"- {s}")
  8645	    print(f"[compress] 輸入 {len(lines)} 行 → 保留 {len(pinned) + len(evidence) + len(open_items)} 行"
  8646	          f"(白名單 {len(pinned)}/證據 {len(evidence)}/未結 {len(open_items)})")
  8647	    return 0
