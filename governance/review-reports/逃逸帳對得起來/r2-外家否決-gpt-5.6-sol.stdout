 33813	def t_metric_criteria_drift_guard():
 33814	    """[換尺可比切片](spec:Projects/loop數據收集_計劃「換尺可比與自動回饋隔離」節,r1 五席縮案+r2 收斂)
 33815	    三數字治理帳的兩道機械守衛:
 33816	    ①判準句凍結:標記間原文 NFC sha256 前8碼 vs 變更日誌最新 rev——判準改了沒記日誌=紅;
 33817	      日誌欄非 8 碼 hex(bootstrap 首列佔位)=紅並印現算值供人工謄入(測試永不寫檔)。
 33818	    ②引用點漂移:三帳記號在執行面(scripts/+autonomous_loop)的引用檔必須在允許清單內——
 33819	      新引用出現=紅,人判「讀側/文件」入清單或「數字值進閘」立事故(spec C 節禁令)。"""
 33820	    import hashlib as _hl
 33821	    import re as _re
 33822	    import unicodedata as _ud
 33823	    root = Path(__file__).resolve().parent.parent
 33824	    plan = root / "docs" / "lumos-toolchain-knowledge" / "Projects" / "loop數據收集_計劃.md"
 33825	    text = plan.read_text(encoding="utf-8")
 33826	    m = _re.search(r"<!-- METRIC-CRITERIA:START -->\n(.*?)<!-- METRIC-CRITERIA:END -->", text, _re.S)
 33827	    check("★前置★ 判準句標記對存在且唯一", m is not None and text.count("METRIC-CRITERIA:START") == 1
 33828	          and text.count("METRIC-CRITERIA:END") == 1,
 33829	          "標記缺失或不唯一(含 END)——內文提早出現 END 字面會靜默截斷雜湊")
 33830	    calc = _hl.sha256(_ud.normalize("NFC", m.group(1)).encode("utf-8")).hexdigest()[:8]
 33831	    logm = _re.findall(r"^\| (\d{4}-\d{2}-\d{2}) \| (\S+) \|", text, _re.M)
 33832	    check("★前置★ 變更日誌表至少一列", bool(logm), text[-500:])
 33833	    latest = sorted(logm, key=lambda r: r[0])[-1][1] if logm else ""   # 最新=日期最大(同日取後出現;不賭加列方向,插上方實錘 code-r1 H-1)
 33834	    if not _re.fullmatch(r"[0-9a-f]{8}", latest):
 33835	        check("★判準凍結:日誌 rev 未回填(bootstrap)——把下列現算值謄入日誌最新列★",

