 20215	def cmd_rule_gap(repo=None, as_json=False):
 20216	    """把逃逸帳裡「本來哪條規則該抓」的標記,變成「該寫哪條規則」的待辦。
 20217	    ★這是閉環的那一環★:審查放行之後下游才發現的缺陷,如果有人標了它屬於哪條規則,
 20218	    就能算出「這條規則還沒寫」——沒有這一步,逃逸帳只是一本帳,不會長出新的守衛。"""
 20219	    import json
 20220	    repo_root = _anchor_repo_root(repo)
 20221	    if repo_root is None:
 20222	        print("✗ rule-gap: 從目前目錄往上找不到 git repo——帶 --repo <根> 指定,或到 repo 內執行", file=sys.stderr)
 20223	        return 2
 20224	    # 逃逸帳位置:記帳那支寫在「知識庫的上一層」,標準佈局是 <repo>/docs/,
 20225	    # 但知識庫本身就是 repo 根的那種佈局(standalone)會落在別的地方——兩個都找(r1 通才席)
 20226	    cands = [Path(repo_root) / "docs" / ".escape-log.jsonl", Path(repo_root) / ".escape-log.jsonl"]
 20227	    log = next((c for c in cands if c.is_file()), cands[0])
 20228	    counts, unlabeled = {}, 0
 20229	    if log.is_file():
 20230	        for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
 20231	            line = line.strip()
 20232	            if not line.startswith("{"):
 20233	                continue
 20234	            try:
 20235	                ev = json.loads(line)
 20236	            except Exception:
 20237	                continue
 20238	            _raw = ev.get("rule")
 20239	            rid = _raw.strip() if isinstance(_raw, str) else ""   # 非字串不要整支崩,當成沒標
 20240	            if not rid or rid == "none":
 20241	                unlabeled += 1
 20242	                continue
 20243	            counts.setdefault(rid, {"n": 0, "desc": ev.get("desc", "")[:60]})
 20244	            counts[rid]["n"] += 1
 20245	    have = set(_rules_declared_ids(repo_root))
 20246	    idx, idx_err = _rules_load(repo_root)
 20247	    have |= set((idx.get("rules") or {}))
 20248	    if idx_err:
 20249	        # ★不要吞掉★(r1 邊界席):索引讀不了就少算「已經寫成規則的」,清單會憑空多出待辦
 20250	        print("提醒:" + idx_err + "——這份清單少算了索引裡登記過的規則,先修好索引再看", file=sys.stderr)
 20251	    missing = {k: v for k, v in counts.items() if k not in have}
 20252	    if as_json:
 20253	        print(json.dumps({"missing": missing, "covered": sorted(set(counts) & have),
 20254	                          "unlabeled": unlabeled}, ensure_ascii=False))
 20255	        return 0
 20256	    if not counts and not unlabeled:
 20257	        print("逃逸帳是空的:還沒有任何一筆「審查放行後下游才抓到」的紀錄。")
 20258	        print("  空≠零逃逸——也可能是沒人記。要記:")
 20259	        print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <等級> --desc <一句> --rule <本來哪條規則該抓|none>")
 20260	        return 0
 20261	    if missing:
 20262	        print("這些漏網的問題有人標了「本來哪條規則該抓」,但那條規則還不存在(" + str(len(missing)) + " 條):")
 20263	        for rid, v in sorted(missing.items(), key=lambda kv: -kv[1]["n"]):
 20264	            print("  " + rid + "(漏過 " + str(v["n"]) + " 次)—— " + v["desc"])
 20265	        print("在意的原因:逃逸帳只記「漏掉了」,不會自己長出守衛;把重複漏過的那幾條寫成規則,下次才擋得住。")
 20266	        print("接下來:")
 20267	        print("    在 .lumos/rules/ 寫規則 + 在 samples/ 放會翻紅的樣本,然後 lumos rule-check")
 20268	    else:
 20269	        print("逃逸帳裡標到的規則都已經寫出來了(" + str(len(counts)) + " 條)。")
 20270	    if unlabeled:
 20271	        print("另有 " + str(unlabeled) + " 筆沒標「本來哪條規則該抓」——沒標的算不進這個統計,記的時候順手帶 --rule。")
 20272	    return 0
