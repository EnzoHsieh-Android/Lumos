  9301	def _door_for_loop(env, loop_id):
  9302	    """規格閘留痕裡這條迴圈最後一次判的門;沒有就 unknown(規格閘上線前一律 unknown)。"""
  9303	    path = env.vault.parent / ".canary-log.jsonl"
  9304	    door = "unknown"
  9305	    if not path.exists():
  9306	        return door
  9307	    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
  9308	        if not ln.strip():
  9309	            continue
  9310	        try:
  9311	            d = json.loads(ln)
  9312	        except ValueError:
  9313	            continue
  9314	        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
  9315	            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
  9316	    return door
