def _review_yield_round(rows):
    """[審查有沒有用記帳 S3] 一輪帳列 → 漏斗數字 dict(N 報/M 存活/R 重現不到/F 折/A 放行/S 存活多於席位報)。
    N=席位列 reported 加總,★同席同報告只算一次★(同一席會先留痕一筆、再當載體一筆;以 (auditor, report_sha256) 去重);
    任一欄缺(2026-09-09 前的帳沒這些鍵)→ 該格 None(印 ?),N/M/R 任一 None 就不算 S。純函式,disposal 尾與 gov --stats 共用。"""
    seen, N, n_missing = set(), 0, False
    for r in rows:
        key = (r.get("auditor"), r.get("report_sha256"))
        if key in seen:
            continue
        seen.add(key)
        if r.get("reported") is None:
            n_missing = True
        else:
            N += int(r["reported"])
    carrier = next((r for r in rows if r.get("findings_set")), None)
    M = len(carrier["findings_set"]) if carrier else None
    R = len(carrier["refuted_set"]) if carrier and carrier.get("refuted_set") is not None else None
    F = len(carrier.get("folded_set") or []) if carrier else None
    A = len(carrier.get("accepted_set") or []) if carrier else None
    N = None if n_missing or not seen else N
    S = None if (N is None or M is None or R is None) else max(0, M + R - N)
    return {"N": N, "M": M, "R": R, "F": F, "A": A, "S": S, "has_carrier": carrier is not None}


def _review_yield_line(y, escapes=None):
    """把 _review_yield_round 的 dict 印成一行(問閘尾與 gov --stats 同一種措辭)。"""
    q = lambda v: "?" if v is None else str(v)
    s_part = "算不了(缺欄位)" if y["S"] is None else f"存活多於席位報的 {y['S']} 條(編排者自找或漏併)"
    tail = f";這條迴圈累計逃逸 {escapes}" if escapes is not None else ""
    return (f"席位報 {q(y['N'])}(機器數)→ 存活 {q(y['M'])} / 編排者重現不到 {q(y['R'])}(人填,已對 intake)"
            f"→ 折 {q(y['F'])} / 放行 {q(y['A'])};{s_part}{tail}")


def _escape_rows_for(env, loop_id=None):
    """讀逃逸帳(append-only,不進閘);loop_id 給了就只回那條迴圈的。壞行跳過。"""
    out = []
    try:
        log = env.vault.parent / ".escape-log.jsonl"
        if not log.exists():
            return out
        for ln in log.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if loop_id is None or d.get("loop") == loop_id:
                out.append(d)
    except OSError:
        pass
    return out


def _severity_check_row(rec, root, trust_sha=False):
    """[嚴重度綁定機械掃 S2] 單帳列 severity 對帳核心(CLI 與 disposal 尾端共用,單一實作)。
    回 (status, 白話訊息):ok/over(高報,保守)/under(低報)/noparse(報告無宣告行)/
    print("# 壓縮狀態(規則式;白名單壓不掉)")
    for title, bucket in (("壓不掉白名單", pinned), ("已驗證證據", evidence), ("未結約束", open_items)):
        print(f"## {title}")
        for s in bucket:
            print(f"- {s}")
    print(f"[compress] 輸入 {len(lines)} 行 → 保留 {len(pinned) + len(evidence) + len(open_items)} 行"
          f"(白名單 {len(pinned)}/證據 {len(evidence)}/未結 {len(open_items)})")
    return 0


# ── loop list:哪些審查迴圈還開著(執行DAG_調研 排第一順位的缺口) ──
# next/status/verify-progress 全都強制要 loop_id,卻沒有任何入口能先知道有哪些編號在飛,
# 實務上只能 tail .canary-log.jsonl 或看 git 未追蹤檔。關門訊號取治理帳的放行事件——
# 那是既有的、寫入當下就落的、可重算的東西,不新增任何要人維護的狀態。
# ★關門事件分成兩組,因為兩本帳認迴圈的方式不一樣★(2026-09-07 代碼審 r1,三席獨立抓到)
# 設計審那組把迴圈編號寫進 nodes 欄(109 筆全部有);
# ★code-loop 那組的 nodes 欄永遠是空陣列★(148 筆全空)——因為那本帳認的是「分支 + 版本」
# 不是迴圈編號,兩套識別體系從來沒建過對應關係。
# 第一版把兩組混在同一個集合裡用 nodes 比對,結果 code-loop 那半是死碼,
# 而且**實測有 23 個早就過閘的 code 迴圈被報成「空轉候選」**(code-234 / code-kill / code-cochange …)。
LOOP_CLOSE_EVENTS = {("design-loop", "converged"), ("design-loop", "cap-reached"),
                     ("design-loop", "rewrite")}
# code-loop 這組只能從自由文字的 detail 認編號(慣例上 detail 開頭就是編號)。
# ★這是啟發式,不是保證★:detail 是人寫的欄位,沒有任何機制強制它以編號開頭。
# 失效方式=編號沒寫在 detail 裡 → 那個迴圈會被報成沒關門(偏保守,不會反過來誤報成關了)。
# REVISIT:2026-11-07 正解是讓 code-loop pass/skip 收一個 --loop 參數、把編號寫進 nodes,
#   跟設計審那組同形;那要動到推送閘會呼叫的路徑,本批不做。
LOOP_CLOSE_EVENTS_BY_DETAIL = {("code-loop", "passed"), ("code-loop", "skipped")}
# ★這兩組以外的 (gate, kind) 都要在下面這張表裡分類過★——新增一種收工事件卻忘了歸類,
# 守衛會翻紅(t_loop_close_kinds_classified)。沒有這道,新的 kind 只會被靜默當成「沒關門」。
LOOP_NOT_CLOSE_EVENTS = {
    ("design-loop", "replay-refreeze"),   # 已凍結的判定重新凍一次,是基準更新不是收斂;
                                          # 而且重凍在判定 FAIL 時也會發生,當成關門會製造新洞
    # 2026-09-08 #19:閘擋人時由做判定的子命令自己落 kind=blocked 的 hard 帳。
    # ★擋人不是關門★——那是一次推送被擋下,迴圈本身沒有任何狀態變化。
    # 同族的 skipped-env / fail-open 在真實帳上出現第一筆時,守衛 t_loop_close_kinds_classified
    # 會再提醒;那時同樣歸這裡(★不得歸「算關門」★)。表裡只列真的出現過的(守衛的反向條件)。
    ("code-loop", "blocked"),
    # 棧別提問表態閘(2026-09-09):表態記錄與 recall-miss 帳都是陳述,不是關門(r2 接手席 H1:忘了登記守衛翻紅)。
    ("code-loop", "dispositions"),
    ("code-loop", "recall-miss"),
}
LOOP_CLOSE_SINCE = "2026-08-22"   # 治理帳出現第一筆 design-loop converged 的日子
# ★誠實記★:code-loop 的放行事件早得多(最早 2026-07-05),比這個日期早六週。
# 上面那個日期只用在「設計審那組」的免責聲明,不涵蓋 code-loop 那組。


def _loop_ts_key(ts):
    """ISO 時間字串 → 可比較的 UTC 秒數;解析不動或沒帶時區就回 None(呼叫端退回字串比對)。

    ★為什麼需要這一層★:審查帳與治理帳今天全部寫 +08:00(當場數過:1101 / 26443 筆都是),
    所以直接拿字串比大小剛好會對。但那是巧合不是保證——只要有一筆從別的時區(或 UTC)
    寫進來,字串比對就會**靜默**把開著判成關了、或反過來。這層把那個假設消掉,成本幾行。
    沒帶時區的一律不猜(回 None):猜錯比退回字串比對更糟。"""
    import datetime
    if not ts:
        return None
    try:
        d = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    if d.tzinfo is None:
        return None
    return d.timestamp()


def _loop_ts_newer(a, b):
    """a 是不是比 b 晚。兩邊都解得動就比 UTC 秒數,否則退回字串比對(舊帳相容)。"""
    ka, kb = _loop_ts_key(a), _loop_ts_key(b)
    if ka is not None and kb is not None:
        return ka > kb
    return (a or "") > (b or "")


# ★「關門後又記帳」不等於「重開」★(2026-09-07 代碼審 r1 折入時發現)
# 第一版判「最後一筆記錄比關門事件晚 → 算開著」。對真實資料是錯的:**過閘之後才補記帳是常態**
# ——實測 code-234 唯一那筆審查記錄比 code-loop 過閘晚 8 分鐘、code-kill 晚 14 分鐘,
# 兩個都是同一次工作的收尾簿記,卻被判成「又開新輪」而永遠列在空轉候選裡。
# 判準改成看時間差:同一天內的記帳算收尾,隔天以後才算真的重開。
# ★24 小時是拍的,不是量出來的★——它擋掉的是「幾分鐘的簿記時差」這個已觀察到的形態;
# 真的重開一個迴圈通常隔天以後,但沒有資料能證明這個門檻的最佳值。
# REVISIT:2026-11-07 若出現「關門後隔天以內真的重開」的實例,這個門檻要改成看輪次標籤而不是時間。
_LOOP_REOPEN_GRACE_SEC = 24 * 3600


def _loop_reopened(last_ts, close_ts):
    """還開著嗎。沒有關門事件=開著;有關門事件但之後隔了超過寬限期又記帳=重開。"""
    if not close_ts:
        return True
    ka, kb = _loop_ts_key(last_ts), _loop_ts_key(close_ts)
    if ka is None or kb is None:                  # 解不動就退回舊行為(字串比對)
        return (last_ts or "") > (close_ts or "")
    return (ka - kb) > _LOOP_REOPEN_GRACE_SEC


def _loop_close_stamps(env, known_loops=()):
    """治理帳 → {loop_id: 最後一次關門事件的 ts}。壞行跳過(回傳跳過行數)。

    兩條認法(理由見 LOOP_CLOSE_EVENTS 上面那段):
    - 設計審那組:編號寫在 nodes 欄,直接比對。
    - code-loop 那組:nodes 永遠空,只能從自由文字 detail 認編號——所以要先知道有哪些編號
      (known_loops,從審查帳來),再看 detail 裡有沒有出現。★啟發式,失效偏保守★。
    """
    import json, re as _re
    path = env.vault.parent / ".governance-log.jsonl"
    stamps, bad = {}, 0
    if not path.exists():
        return stamps, bad
    # 長的編號先比,免得 code-audit-batch4 吃掉 code-audit-batch4b 的 detail
    ordered = sorted((l for l in known_loops if l), key=len, reverse=True)
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            bad += 1
            continue
        # ★合法 JSON 但不是物件(例如一行 []、null、42)也要跳過★(2026-09-07 代碼審 r1 外家席):
        # 第一版只接 json.loads 的 ValueError,接著就 d.get(),這三種會拋 AttributeError 讓整支炸掉,
        # 違反自己承諾的「壞行跳過」。測試也只餵語法壞掉的行,沒餵這種。
        if not isinstance(d, dict):
            bad += 1
            continue
        gk = (d.get("gate"), d.get("kind"))
        ts = d.get("ts") or ""
        if gk in LOOP_CLOSE_EVENTS:
            for n in (d.get("nodes") or []):
                if isinstance(n, str) and _loop_ts_newer(ts, stamps.get(n, "")):
                    stamps[n] = ts
        elif gk in LOOP_CLOSE_EVENTS_BY_DETAIL and ordered:
            detail = d.get("detail") or ""
            for lid in ordered:
                if _re.search(r"(?<![\w-])" + _re.escape(lid) + r"(?![\w-])", detail):
                    if _loop_ts_newer(ts, stamps.get(lid, "")):
                        stamps[lid] = ts
                    break
    return stamps, bad


def cmd_loop_list(env, days=14, show_all=False, stale_only=False, as_json=False, now=None,
                  exclude=None):
    """帳面上還開著的審查迴圈。開著=沒有關門事件,或關門後又記了新的審查輪次。

    ★誠實界線★:設計審那組的關門事件慣例 %s 才開始,更早的迴圈天生沒有這筆
    (code-loop 那組早得多,最早 2026-07-05)——所以「沒關門」只等於「帳面沒看到關門事件」,
    不等於「沒做完」。code-loop 那組還多一層:它的編號只在自由文字裡,認法是啟發式,
    認不到就報成沒關門(偏保守)。唯讀恆 rc0(比照 canary-stats);
    壞行跳過但出聲(不靜默,也不 fail-closed——這是查詢不是閘)。""" % LOOP_CLOSE_SINCE
    import json, datetime
    path = env.vault.parent / ".canary-log.jsonl"
    per = {}
    bad = 0
    if path.exists():
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if not isinstance(d, dict):      # 合法 JSON 但不是物件(見 _loop_close_stamps 的說明)
                bad += 1
                continue
            lid = d.get("loop")
            if not isinstance(lid, str) or not lid:
                continue
            e = per.setdefault(lid, {"loop": lid, "last_ts": "", "rounds": set(), "records": 0,
                                     "last_severity": None, "tier": None, "orchestrator": None})
            e["records"] += 1
            ts = d.get("ts") or ""
            if not _loop_ts_newer(e["last_ts"], ts):   # ts >= last_ts(時區安全)
                e["last_ts"] = ts
                e["last_severity"] = d.get("severity")
            if d.get("round"):
                e["rounds"].add(d["round"])
            else:
                e["roundless"] = e.get("roundless", 0) + 1
            e["tier"] = e["tier"] or d.get("tier")
            e["orchestrator"] = e["orchestrator"] or d.get("orchestrator")
    closed, gbad = _loop_close_stamps(env, known_loops=per.keys())
    bad += gbad
    if now:
        try:
            today = datetime.date.fromisoformat(now)
        except ValueError:
            print("擋下:--now 要給 YYYY-MM-DD 這種格式的日期,你給的是 %r" % now, file=sys.stderr)
            print("  為什麼在意:這個值決定「幾天沒動」怎麼算,猜錯會把還在跑的迴圈報成空轉。", file=sys.stderr)
            print("  正確用法(不帶就是今天):", file=sys.stderr)
            print("      lumos loop list --now 2026-09-07", file=sys.stderr)
            return 2
    else:
        today = datetime.date.today()

    def _idle(ts):
        try:
            return (today - datetime.date.fromisoformat(ts[:10])).days
        except ValueError:
            return None

    rows = []
    for e in per.values():
        cts = closed.get(e["loop"], "")
        # ★輪數在「有的帶輪次、有的不帶」時不吐精確數字★(2026-09-07 代碼審 r1,兩席獨立指出):
        # 第一版是「有 round 就數相異值,全沒有才數筆數」,於是 3 筆裡只有 1 筆帶 r1 會顯示「1 輪」
        # ——比實際少、而且看起來像剛開始。同一份帳餵給 loop next / loop status 都是 rc2 擋下並說
        # 「分不出哪輪是判定輪」。這支是唯讀查詢不該擋,但也不該假裝算得準:混用就回 None。
        _mixed = bool(e["rounds"]) and e.get("roundless")
        rows.append({"loop": e["loop"], "last_ts": e["last_ts"], "idle_days": _idle(e["last_ts"]),
                     "rounds": None if _mixed else (len(e["rounds"]) or e["records"]),
                     "rounds_mixed": bool(_mixed), "last_severity": e["last_severity"],
                     "tier": e["tier"], "orchestrator": e["orchestrator"],
                     "closed_ts": cts or None,
                     "open": _loop_reopened(e["last_ts"], cts)})
    # 排除前綴:自主迴圈的每日場次(auto-YYYY-MM-DD)天生不會有關門事件、一天長一個,
    # 不排掉的話這份清單遲早被它們淹掉。★不寫死任何前綴★——要排什麼由呼叫端說。
    n_excluded = 0
    if exclude and any((x or "") == "" for x in exclude):
        # ★空前綴等於排除全部★(2026-09-07 代碼審 r1,兩席獨立指出):任何字串都以空字串開頭,
        # 於是 --exclude "" 會把清單清空,而人讀模式印出來的是「還沒關門的有 0 個」
        # ——跟「真的全部結案了」長得一模一樣。這支工具存在的理由就是不要讓人漏看還開著的迴圈,
        # 一個常見的手滑(組指令時某項是空的)會造成方向完全相反的靜默假全清。擋下,不猜。
        print("擋下:--exclude 不能給空字串——任何編號都以空字串開頭,那會把整份清單排空,",
              file=sys.stderr)
        print("      而印出來會跟「真的全部結案了」長得一樣。要排什麼就寫什麼,例如:", file=sys.stderr)
        print("      lumos loop list --exclude auto-", file=sys.stderr)
        return 2
    if exclude:
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith(vrel + "/Projects/") and line.endswith(".md"):
            out.append(line)
    return out


def _loop_id_for_plan(plan_rel):
    """計劃檔名 → 迴圈編號:去 _計劃(design-loop skill 的慣例)。"""
    stem = Path(plan_rel).stem
    return stem[:-len("_計劃")] if stem.endswith("_計劃") else stem


def _plan_for_loop(env, loop_id):
    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。"""
    for cand in (f"{loop_id}_計劃.md", f"{loop_id}.md"):
        if (env.vault / "Projects" / cand).is_file():
            return f"Projects/{cand}"
    return None


def _door_for_loop(env, loop_id):
    """規格閘留痕裡這條迴圈最後一次判的門;沒有就 unknown(規格閘上線前一律 unknown)。"""
    path = env.vault.parent / ".canary-log.jsonl"
    door = "unknown"
    if not path.exists():
        return door
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not ln.strip():
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
    return door


def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
    log = env.vault.parent / ".escape-log.jsonl"
    ledger = env.vault.parent / ".canary-log.jsonl"
    known = set()
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                v = json.loads(ln).get("loop")
            except ValueError:
                continue
            if isinstance(v, str):
                known.add(nfc(v))
    import datetime as _dt
    import secrets as _sec
    written = 0
    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
    with _vault_write_lock(env.vault):
        existing = set()
        for r in _escape_rows_for(env):
            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
        for loop_id, plan_rel in loops:
            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
            if nfc(loop_id) in known:
                attribution = "ledger"
            elif plan_ok:
                attribution = "plan-file"
            else:
                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
                continue
            door = _door_for_loop(env, loop_id)
            if stage == "push-gate-unreviewed" and door != "low":
                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
                continue
            if (nfc(loop_id), stage, sha) in existing:
                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
                continue
            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "token": "ESC-" + _sec.token_hex(4),
                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door}
            if plan_rel:
                rec["plan"] = plan_rel
            if extra:
                rec.update(extra)
            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
                written += 1
                existing.add((nfc(loop_id), stage, sha))
                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
            else:
                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
    return written


def _plan_file_exists(env, plan_rel):
    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
    if (env.vault / plan_rel).is_file():
        return True
    parent = (env.vault / plan_rel).parent
    if not parent.is_dir():
        return False
    want = nfc(Path(plan_rel).name)
    try:
        return any(nfc(q.name) == want for q in parent.iterdir())
    except OSError:
        return False


def _escape_auto_failed(env, loop_id, stage, why):
    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
    try:
        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
    except Exception:
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)


def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None):
    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
    整套審查系統的 ground truth 側;與攔截帳(★圖譜攔截★記號)互為兩面。
    append-only、不進任何閘;歸因是人工判斷(GIGO 同 cluster 歸併,計劃天花板明載)。
    ★歸因守衛的職責範圍(r1 外家 ESC-01 裁明)★:只防「編號打錯」(實存性),不驗迴圈
    收斂/放行狀態——那是語意判斷,歸人;守衛驗語意=偷渡閘,計劃明文不做。"""
    log = env.vault.parent / ".escape-log.jsonl"
    _SEV_W = {"minor": 0, "major": 1, "blocker": 2}
    if auto:
        # 自動模式(規格落成可驗收條件_計劃 第五節):給提交範圍,碰到的計劃筆記各記一筆;對不回就不記。
        if loop_id or list_mode:
            print("擋下:--auto 不吃迴圈編號也不能跟 --list 混用;編號由提交範圍碰到的計劃筆記推出來", file=sys.stderr)
            return 2
        if severity not in _SEV_W or not (stage or "").strip() or not (desc or "").strip():
            print("擋下:--auto 一樣要帶 --stage、--severity(minor|major|blocker)、--desc", file=sys.stderr)
            return 2
        if not git_range:
            print("擋下:--auto 要帶 --range <a..b>(推送/CI 的提交範圍),沒有範圍就對不回計劃", file=sys.stderr)
            return 2
        repo_root = Path(repo) if repo else env.vault.parent.parent
        plans = _plans_in_range(repo_root, git_range, env.vault)
        if not plans:
            print(f"逃逸自動記:範圍 {git_range} 對不回任何計劃筆記,不記(這不是錯,只是這次推送沒碰到計劃)")
            return 0
        vrel = str(Path(env.vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
        loops = [(_loop_id_for_plan(p), p[len(vrel) + 1:]) for p in plans]
        _auto_escape(env, stage.strip(), severity, desc, loops, sha or _git_head(repo_root), source=stage.strip())
        return 0
    if list_mode:
        if loop_id or stage or severity or desc or defect_ref:
            print("擋下:--list 是唯讀,不能跟記帳參數混用——照原樣執行你會以為記了、其實一筆都沒寫。要記帳就拿掉 --list 重跑", file=sys.stderr)
            return 2
        if not log.exists():
            print("逃逸帳是空的:還沒有任何一筆「迴圈放行後下游抓到可歸因缺陷」的紀錄。空≠零逃逸——也可能是沒人記;要記:")
            print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <minor|major|blocker> --desc <一句描述>")
            return 0
        import json as _je
        rows, bad = [], []
        for no, ln in enumerate(log.read_text(encoding="utf-8").splitlines(), 1):
            if not ln.strip():
                continue
            try:
                d = _je.loads(ln)
            except ValueError:
                bad.append(no)
                continue
            if not isinstance(d, dict):
                bad.append(no)      # 合法 JSON 但非物件(null/陣列)——r1 外家 ESC-03:一筆就能弄壞整個 --list
                continue
            rows.append(d)
        if bad:
            print(f"提醒:逃逸帳有 {len(bad)} 行壞損被跳過(行 {', '.join(map(str, bad[:5]))}"
                  + ("…" if len(bad) > 5 else "") + f");帳檔:{log}", file=sys.stderr)
        by_loop = {}
        for r in rows:
            by_loop.setdefault(str(r.get("loop", "?")), []).append(r)
        print(f"逃逸帳:{len(rows)} 筆(迴圈收斂放行後、下游抓到的可歸因缺陷;歸因為人工判斷)")
        for lp, rs in sorted(by_loop.items()):
            worst_row = max(rs, key=lambda r: _SEV_W.get(r.get("severity"), -1))
            wsev = worst_row.get("severity")
            wlabel = wsev if wsev in _SEV_W else f"非標準值 {_esc_clean(wsev, 20)}(手改帳?)"
            print(f"  {_esc_clean(lp, 60)}:{len(rs)} 筆(最重 {wlabel})")
            for r in rs:
                sev = r.get("severity")
                sev_disp = sev if sev in _SEV_W else f"?{_esc_clean(sev, 12)}"
                print(f"    {str(r.get('ts') or '?')[:10]} [{sev_disp}@{_esc_clean(r.get('stage', '?'), 30)}] {_esc_clean(r.get('desc', ''))}"
                      + (f"(佐證:{_esc_clean(r['defect_ref'], 80)})" if r.get("defect_ref") else "")
                      # ★逐筆看得到有沒有標規則★(r1 通才席):只有彙總看得到的話,巡帳的人不知道哪一筆漏標
                      + (f"[本來該抓的規則:{_esc_clean(str(r['rule']), 40)}]" if r.get("rule") else "[沒標該抓的規則]"))
        return 0
    # ── 記帳模式:全部驗證在此(r1 架構席 R-2:dispatch 只路由,驗證不拆層) ──
    if not loop_id:
        print("擋下:要記逃逸就得說是哪個迴圈編號放行的。看帳:\n    lumos loop escape --list", file=sys.stderr)
        return 2
    if severity not in _SEV_W:
        print("擋下:--severity 必填且只能是 minor|major|blocker(同審查帳值域)", file=sys.stderr)
        return 2
    if not (stage or "").strip():
        print("擋下:--stage 必填(在哪一站發現:實作/code-loop/CI/prod/使用者回報…)——缺階段的逃逸帳之後做不了「在哪一站漏的」分層統計", file=sys.stderr)
        return 2
    if not (desc or "").strip():
        print("擋下:--desc 不能空——沒有描述的逃逸帳讀側無從歸因,等於沒記", file=sys.stderr)
        return 2
    ledger = env.vault.parent / ".canary-log.jsonl"
    known, led_bad = set(), 0
    if ledger.exists():
        import json as _je2
        for ln in ledger.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                v = _je2.loads(ln).get("loop")
            except ValueError:
                led_bad += 1
                continue
            if isinstance(v, str):
                known.add(nfc(v))     # r1 邊界席 B-3:NFC 正規化,NFD 貼上形不再肉眼無解
    if nfc(loop_id) not in known:
        msg = f"擋下:審查帳裡沒有叫「{loop_id}」的迴圈——逃逸要歸因到真實存在的迴圈,先確認編號:\n    lumos gov --stats"
        if led_bad:
            msg += f"\n  (審查帳另有 {led_bad} 行壞損被跳過——查不到也可能是編號在那幾行裡)"
        print(msg, file=sys.stderr)
        return 2
    import datetime as _dt_esc
    import secrets as _sec_esc
    rec = {"ts": _dt_esc.datetime.now().astimezone().isoformat(timespec="seconds"),
           "token": "ESC-" + _sec_esc.token_hex(4),       # 落盤自驗唯一鍵(canary auto-mint 慣例)
           "loop": loop_id, "stage": stage.strip(), "severity": severity, "desc": desc.strip()}
    if defect_ref:
        rec["defect_ref"] = defect_ref
    if rule:
        # ★閉環的那一格★:標「本來哪條規則該抓」,漏網才長得出新的守衛;
        # 不標的話這本帳只記得「漏掉了」,永遠不會變成下次擋得住的東西(看待辦:lumos rule-gap)
        rec["rule"] = rule.strip()
    if log.is_symlink():
        # r2 終態席實測:既存 symlink 會繞過建檔保護、共用寫入原語 open('a') 跟隨連結寫進外部檔——
        # 每次寫前先擋本體(殘餘=判斷與開檔間競態,best-effort 同 _ledger_append 家族誠實降級)
        print(f"擋下:逃逸帳檔是一個符號連結,不往裡寫(帳本必須是普通檔案):\n    {log}", file=sys.stderr)
        return 2
    if not log.exists():
        try:
            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
        except FileExistsError:
            pass
        except OSError as e:
            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
            return 2
    rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])   # 共用硬化原語(OSError 擋下+讀回自驗);已知天花板=撞鍵時讀回比對可能對到舊筆(canary 全家族同款,hex4 空間機率極低)
    if rc_w:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。


def _roster_kind(loop_id):
    """loop id 前綴三值判:code-(含連字號)=code;code 開頭無連字號=None(indeterminate,
    歷史帳實有 code側刪除傳播守衛/codestage);其餘=design。"""
    if loop_id.startswith("code-"):
        return "code"
    if loop_id.startswith("code"):
        return None
    return "design"


LOOP_ORCHESTRATORS = ("claude", "codex")
_ROSTER_CODEX_KEYS = ("codex", "gpt")     # 編排者是 Codex 時,這幾個字眼=同門


def _loop_records(env, loop_id, strict=False):
    """canary-log 裡某編號的全部記錄(唯讀;壞行跳過)。單一讀法——cmd_loop_next 與 record 定錨檢查共用
    (code-codex-s2 r1 架構席:兩份逐行相同的讀帳迴圈會各自漂)。strict=True 時檔讀不到就丟 OSError 給呼叫端印。"""
    import json as _json
    path = env.vault.parent / ".canary-log.jsonl"
    out = []
    try:
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    d = _json.loads(line)
                except ValueError:
                    continue
                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16)
                    out.append(d)
    except OSError:
        if strict:
            raise
        return out
    return out


def _loop_orchestrators(rounds):
    """帳面出現過的編排者值集合(矛盾偵測用)。"""
    return {r.get("orchestrator") for r in rounds if r.get("orchestrator") in LOOP_ORCHESTRATORS}


def _loop_orchestrator(rounds):
    """帳面編排者定錨:首個帶 orchestrator 的記錄;舊帳沒有 → None(讀側視為 claude 並印一句,不給新呼叫預設——
    Projects/Codex完全支援_計劃 d4:預設 claude 會讓 Codex 編排漏旗標時靜默套錯家族)。"""
    return next((r.get("orchestrator") for r in rounds if r.get("orchestrator") in LOOP_ORCHESTRATORS), None)


def _roster_family(auditor, orchestrator="claude"):
    """auditor 字串→(family, dual_hit)。family 是★相對編排者★的:"claude"=同門(編排者那一家)、"external"=外家
    (保留舊字串,_TIER_ROSTER 的 family 欄同義:claude 席=同門席、external 席=外家席;d4 相對化 2026-09-04)。
    lower() 子串比對;判序寫死外家先比、先命中先贏。orchestrator=codex 時 codex/gpt 是同門、sonnet/opus/claude 是外家。"""
    s = (auditor or "").lower()
    if orchestrator == "codex":
        own = any(k in s for k in _ROSTER_CODEX_KEYS)
        other = any(k in s for k in _ROSTER_CLAUDE_KEYS) or any(k in s for k in _ROSTER_EXTERNAL_KEYS if k not in _ROSTER_CODEX_KEYS)
    else:
        own = any(k in s for k in _ROSTER_CLAUDE_KEYS)
        other = any(k in s for k in _ROSTER_EXTERNAL_KEYS)
    if other:
        return ("external", own)
    if own:
        return ("claude", False)
    return ("unknown", False)


def _roster_dispatch_entries(loop_dir, rid):
    """解析一輪的 rN-dispatch*.json → (auditor 串列, 跳過檔數)。三種真實形狀:
    ①dict 頂層 auditor ②dict 帶 seats 陣列 ③頂層 list;壞損 JSON 與不符形狀同一處置=跳過不計。"""
    import json as _json
    auditors, skipped = [], 0
    for f in sorted(loop_dir.glob(f"{rid}-dispatch*.json")):
        try:
            obj = _json.loads(f.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, ValueError):
            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
            skipped += 1
            continue
        if isinstance(obj, dict) and "auditor" in obj:
            elems = [obj]
        elif isinstance(obj, dict) and isinstance(obj.get("seats"), list):
            elems = obj["seats"]
        elif isinstance(obj, list):
            elems = obj
        else:
            print(f"[roster] 提醒:派工快照 {f.name} 壞掉或格式不對,跳過不算")
            skipped += 1
            continue
        for e in elems:
            a = e.get("auditor") if isinstance(e, dict) else None
            auditors.append(a if isinstance(a, str) else None)   # 非字串(數字/巢狀物)=無名席→unknown 桶,不炸整段觀測
    return auditors, skipped


def _roster_observe(env, loop_id, rounds, repo, only_rid=None, anomalies_only=False):
    """loop status --roster 觀測段(advisory 恆不影響 rc):應派(_TIER_ROSTER)vs 實派(dispatch 快照)
    逐輪分桶對帳。落點=cmd_loop_status 入口、各模式分支 early-return 之前(四模式皆吃得到)。
    roster對帳併入問閘 [S1]:only_rid=只對這一輪(同時抑制內部 dispatch glob 補漏——問閘尾端用);
    anomalies_only=只印異常六種(external_missing/單家族/真兼任/命名歧義/unknown 降級/shortfall),
    抑制摘要與診斷四種;回傳本次印出的異常種類清單(留痕用)。同一實作服務兩種呼叫,禁抄改。"""
    anomalies = []
    def _quiet(msg):
        if not anomalies_only:
            print(msg)
    kind = _roster_kind(loop_id)
    if kind is None:
        _quiet(f"[roster] {loop_id}:看不出是設計審還是代碼審(名稱 code 開頭但不是 code- 格式),跳過派工對帳")
        return anomalies
    # only_rid(問閘單輪)時 tier 取「該輪自己」的紀錄——跨輪 tier 不同時拿第一筆會查錯編制表,
    # high 輪的 fail-closed 警訊被降級成 standard 的軟提醒(code-batch2 s1-f1,席位純 CLI 重現)
    # only_rid(問閘單輪):tier 只認判定輪自己的紀錄,★不 fallback 借別輪的★——
    # 借用=同型病換觸發條件(r2 d-f1);判定輪沒記 tier → 走「沒有編制表可以對」照實講。
    # 副作用即縱深:__seqN 合成鍵永遠對不到 round 欄 → tier=None → 天然安靜,
    # 下方 startswith("__") guard 成為第二道防禦(單釘無法只殺 guard,兩道要一起拔才會響)。
    if only_rid:
        tier = next((r.get("tier") for r in rounds
                     if r.get("round") == only_rid and r.get("tier")), None)
    else:
        tier = next((r.get("tier") for r in rounds if r.get("tier")), None)
    orch = _loop_orchestrator(rounds)
    _quiet(f"[roster] {loop_id}:類型 {kind}(從名稱前綴推的),分級 {tier or '沒指定'},編排者 {orch or '帳面沒記,視為 claude'}"
           + ("" if orch else "(舊帳相容;新迴圈 loop next 首輪要帶 --orchestrator)"))
    _orchs = _loop_orchestrators(rounds)
    if len(_orchs) > 1:
        print(f"[roster] {loop_id}:帳面編排者不一致({'/'.join(sorted(_orchs))})——以下家族對帳照第一筆算,但這本帳本身矛盾,先修帳再信對帳結果")
        anomalies.append("編排者不一致")
    orch = orch or "claude"
    if tier is None:
        _quiet("[roster] 這個編號沒指定過分級(舊格式或還沒記錄),沒有編制表可以對")
        return anomalies
    entry = _TIER_ROSTER.get((kind, tier))
    if entry is None:
        _quiet(f"[roster] 無編制宣告:{kind}/{tier} 這個組合沒定義該派誰,跳過對帳")
        return anomalies
    root = Path(repo).resolve() if repo else _vault_repo_root(env)
    loop_dir = root / "governance" / "review-reports" / loop_id
    if only_rid is not None:
        rids = [only_rid]   # 問閘當輪:不掃 log、不 glob 補漏(std-r1 s1-f1)
    else:
        rids = []
        for r in rounds:
            rid = r.get("round")
        return "skip"
    items = [str(x).strip() for x in as_list(fields.get("lands_in")) if str(x).strip()]
    if not items:
        print("[disposal] 落點: ✗ — 計劃沒寫 lands_in(現況會寫進哪幾篇、或新開哪一篇);節點長成一篇包全部,就是因為落點從來沒被審過")
        print("    lumos append <計劃> lands_in Systems/<名>")
        return "fail"
    bad = _lands_in_bad(items)
    if bad:
        print("[disposal] 落點: ✗ — lands_in 這幾項不是 Systems/<名> 的樣子:" + "、".join(bad) + "(純字串、不帶 .md、不寫 [[連結]];落到 skill 或範本的寫在計劃正文)")
        return "fail"
    news = [x for x in items if not (vault / f"{x}.md").is_file()]
    print(f"[disposal] 落點: ✓ — {len(items)} 篇(" + "、".join(x + ("(新開)" if x in news else "") for x in items) + ")")
    return "ok"


def _loop_status_disposal(rounds, loop_id, spec, n_badlines=0, root=None, bad_linenos=None, env=None, roster=False, repo=None, readonly=False, spec_sha_override=None, result_out=None):
    """[T4] 處置閘(design-loop重設計 三):七步合取,全部讀側可重算(原本寫「四條合取」,2026-09-08 加⑤、2026-09-11 加⑥⑦後過期)——
    ①G3 hash 鏈 ②處置集合重算(不信寫側) ③留痕重驗(判定輪★全部★帶留痕欄的席,
    report/snapshot 存在且 sha 一致——r1 否決席:原只驗 carrier,竄改 missed 席報告照樣 PASS)
    ④quote-check 對 carrier 的帳面 snapshot 全 ok
    ⑤條款綁定(設計審計劃每條 [SN] 要標 [test:]/[manual:];代碼審 skip,見 _disposal_clause_step)
    ⑥資安席(定錨 high 的代碼審,required-gated 席出席+留痕+涵蓋最後一版;見 _disposal_security_step)
    ⑦落點(設計審計劃要寫明 lands_in;代碼審 skip,見 _disposal_landing_step)。
    ★canary caught/missed 不進合取(d4:觀測非閘;missed 不作廢 findings)★。
    壞行 fail-closed(r1 四席重疊:原壞行靜默跳過→latest 判錯輪可偽 PASS);
    round-id 非連續重現 rc2(reuse panel 守衛;原 OrderedDict 首現序拿錯輪)。
    留痕路徑:非絕對路徑以 repo root(root)解析(與寫側落帳慣例對稱)。
    exit 0=收斂 / 1=未過 / 2=帳面損壞或參數錯。"""
    from collections import OrderedDict
    if n_badlines:
        print(f"擋下:審查記錄檔有 {n_badlines} 行讀不懂,沒辦法確定「最後一輪」是哪輪,先不判"
              "(修好或搬走壞行再問)"
              + (f"——壞行行號: {bad_linenos}" if bad_linenos else "")
              + "(檔案有 git 版控,對照上一版找出壞行一分鐘就能修)",
              file=sys.stderr)
        return 2
    # r3 修:round 與 round-less 混用=rc2(同 panel 混用守衛精神;原樣混排會落進
    # 「非連續重現」的誤導訊息,或與內部 __seq 鍵互動出偽輪)
    n_round_ = sum(1 for r in rounds if "round" in r)
    if rounds and 0 < n_round_ < len(rounds):
        print("擋下:這個審查編號的記錄有的帶輪次、有的不帶,分不出哪輪是判定輪;"
              "統一補 --round,或全部不帶", file=sys.stderr)
        return 2
    groups = OrderedDict()
    for r in rounds:
        rid_ = r.get("round")
        if rid_ is None:
            # round-less 逐筆自成一輪(r2 回歸修:併成單一 __legacy 組會讓較早 carrier
            # 冒充最新判定/合法 legacy 第二筆假 rc2;守衛只管顯式 round-id)
            groups[f"__seq{len(groups)}"] = [r]
            continue
        if rid_.startswith("__"):
            # r3 修(3 席重疊):防舊帳/手改帳撞內部鍵(寫側已擋新寫入,讀側防守舊資料)
            print(f"擋下:記錄裡有輪次編號 {rid_!r} 用了工具保留的 __ 字首(手改過或舊版寫的),先改掉", file=sys.stderr)
            return 2
        if rid_ in groups and next(reversed(groups)) != rid_:
            # 同 panel 守衛:round-id 被其他輪隔開後重現=append-only 帳次序損壞
            print(f"擋下:第 {rid_!r} 輪的記錄被別的輪次隔開後又出現(非連續重現),帳的順序亂了,沒辦法判斷",
                  file=sys.stderr)
            return 2
        groups.setdefault(rid_, []).append(r)
    if not groups:
        print(f"⏳ 無記錄({loop_id} 目前一筆記錄都還沒有)")
        return 1
    rid, latest = next(reversed(groups.items()))

    def _prov_path(p):
        pp = Path(p)
        return pp if pp.is_absolute() or root is None else Path(root) / pp
    fails = []
    # ── ① G3 hash 鏈(fail-closed:unbound 也擋——disposal 是新閘,無舊帳包袱) ──
    if str(rid).startswith("__") and any("findings_set" in r for r in latest):
        print("擋下:這一輪是無輪次(round-less)帳列卻帶了處置結果——處置帳必須綁輪次"
              "(2026-08-26 關繞道:無輪次處置帳可讓低報逃過寫側守衛;真帳歷史零筆此形狀,fail-closed 不誤傷)",
              file=sys.stderr)
        return 2
    try:
        err, info = _hash_chain_check([latest], spec, cur_sha_override=spec_sha_override)
    except OSError as e:
        print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return 2
    if err:
        print(f"[disposal] G3 hash: ✗ — {err}")
        fails.append("G3")
    elif info == "unbound":
        print("[disposal] G3 hash: ✗ — 判定輪未綁 hash(disposal 閘 fail-closed,record 帶 --spec/--reviewed)")
        fails.append("G3")
    else:
        print(f"[disposal] G3 hash: ✓ — {info}")
    # ── ② 處置集合(輪級重算,不信寫側) ──
    carriers = [r for r in latest if "findings_set" in r]
    if len(carriers) > 1:
        print(f"擋下:第 {rid} 輪有 {len(carriers)} 筆記錄都帶了處置結果,一輪只能有一筆", file=sys.stderr)
        if _panel_retired_for(rounds):
            print("  多席審查(2026-08-25 甲裁後)一律彙總記帳:處置清單只掛一席,其餘席只留痕(severity/report)。", file=sys.stderr)
            print("  帳不可撤——換一個新編號照上式重記,再問 --disposal。(詳 Projects/probe輪退場_計劃)", file=sys.stderr)
        else:
            print("  這種「多席各自記帳」是 panel 型,不歸 --disposal 管(它只收一輪一筆處置帳的循序記帳)。改問:", file=sys.stderr)
            print("    lumos loop status <編號> --gate --panel --min-seats 3 --spec … --repo …", file=sys.stderr)
            print("  (2026-08-06 後的迴圈要連續兩輪乾淨才過;此路僅供 2026-08-25 前定錨的舊迴圈)", file=sys.stderr)
        return 2
    carrier = carriers[0] if carriers else None
    # findings 欄壞值(手改帳/舊寫入殘留)→ fail-closed rc2,同 clusters 型別防禦慣例(不 traceback)
    def _findings_zero(r):
        v = r.get("findings")
        if v is None:
            return False       # 沒填 ≠ 明說 0(legacy 帳缺欄不放行,逐筆成輪加固測試釘的)
        try:
            return int(v) == 0
        except (TypeError, ValueError):
            return None        # 壞值
    _fz = [_findings_zero(r) for r in latest]
    if any(x is None for x in _fz):
        print("擋下:有筆記錄的 findings 欄不是整數(檔案壞了或被手改過?)——fail-closed。"
              "對照 git 上一版找出壞行改回整數:\n    git diff HEAD -- docs/.canary-log.jsonl", file=sys.stderr)
        return 2
    vacuous = False
    if carrier is None:
        # 零發現的乾淨輪:record 端明文「沒發現別帶處置選項」,這裡再要求處置帳=兩邊打架、乾淨輪永遠過不了
        # (2026-08-24 code-out-top3 實踩)。手冊語意=「每個發現都有去向即過」→ 0 條發現視同全處置(vacuous)。
        # ★vacuous 只免「處置集合」這一項★——留痕重驗照跑(r1 blocker:免驗通行證);引句無可驗,橫幅不宣稱。
        if latest and all(_fz):
            vacuous = True
            print("[disposal] 處置集合: ✓ — 這輪 0 條發現,沒有東西要處置(空輪;留痕仍要重驗)")
        else:
            print("[disposal] 處置集合: ✗ — 判定輪有發現但無處置帳(record 帶 --findings-set/--folded-set/--accepted-set)")
            fails.append("無處置帳")
    else:
        F = set(carrier.get("findings_set") or [])
        FO = set(carrier.get("folded_set") or [])
        AC = set(carrier.get("accepted_set") or [])
        reasons = carrier.get("accept_reasons") or {}
        bad = None
        if FO & AC:
            bad = f"folded∩accepted 非空: {sorted(FO & AC)}"
        elif FO | AC != F:
            bad = f"未處置: {sorted(F - FO - AC)}"
        elif set(reasons) != AC or any(not str(v).strip() for v in reasons.values()):
            bad = "accepted 理由缺席或空"
        elif AC and any(r.get("severity") == "blocker" for r in latest):
            bad = "★輪內有 blocker 席,accepted 必須為空(d1;輪級重算,不信寫側單席視角)★"
        elif AC and str(loop_id).startswith("code-") and any(r.get("severity") in ("major", "blocker") for r in latest):
            bad = "★code 迴圈輪內有 major 以上的席,accepted 必須為空——major 一律折,不得附理由放行(probe輪退場 d2,Enzo 2026-08-25 裁:與 panel 時代 max≤minor 同嚴度;散文設計審不受此限)★"
        if bad:
            print(f"[disposal] 處置集合: ✗ — {bad}")
            fails.append("處置集合")
        else:
            print(f"[disposal] 處置集合: ✓ — {len(F)} 條全處置(折 {len(FO)}/放行 {len(AC)},理由齊)")
    # ── ③ 留痕重驗(判定輪全席) + ④ quote-check(carrier;vacuous 輪無引句可驗,只跑 ③) ──
    if carrier is not None or vacuous:
        _qsrc = carrier if carrier is not None else latest[-1]
        rp, sp = _qsrc.get("report_path"), _qsrc.get("snapshot_path")
        if not rp or not sp:
            print("[disposal] 留痕: ✗ — 判定輪未帶 report/snapshot(留痕缺席)")
            fails.append("留痕缺席")
        else:
            ok = True
            n_files = 0
            # 全席重驗:T6 定錨後每席都被迫留痕,讀側就得每席都重驗——
            # 只驗 carrier 等於把 missed 席留痕降回「寫側形式要求」(r1 否決席 finding)。
            for i, r in enumerate(latest, 1):
                for label, key in (("report", "report_path"), ("snapshot", "snapshot_path")):
                    pst, pth = _prov_check(r, key, _prov_path)   # 與資安席一步共用(代碼審資安席 [S2])
                    if pst == "missing":
                        # r2 回歸修(否決席):缺欄席不得靜默跳過——「全席重驗」對缺欄席
                        # 也要成立,否則定錨前搶跑的席=讀側盲區
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} 未帶 {label}(disposal 判定輪全席都要留痕)")
                        fails.append("留痕")
                        ok = False
                        continue
                    n_files += 1
                    if pst == "unreadable":
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} 讀不到({pth})——record 完刪檔照樣擋")
                        fails.append("留痕")
                        ok = False
                    elif pst == "mismatch":
                        print(f"[disposal] 留痕: ✗ — {rid}.{i} {label} sha256 與帳面不符(事後被改)")
                        fails.append("留痕")
                        ok = False
            # intake守衛 T3 讀側(2026-08-30 d1):★全輪掃★——intake_path 掛 r1 帳列而判定輪
            # 多為 r2+,照 report/snapshot 只掃判定輪=常態空轉(r3-F3);任一輪帳列有 intake_path
            # 就重驗,沒有就跳過(選配欄,不強制)。竄改 intake 與竄改 report 同罪(sha 不符=FAIL)。
            _ik_n = 0
            for _rid_g, _rows_g in groups.items():
                for _r_g in _rows_g:
                    _pst, _ip = _prov_check(_r_g, "intake_path", _prov_path)
                    if _pst == "missing":
                        continue
                    _ik_n += 1
                    if _pst == "unreadable":
                        print(f"[disposal] 留痕: ✗ — {_rid_g} intake 讀不到({_ip})——record 完刪檔照樣擋")
                        fails.append("留痕")
                        ok = False
                    elif _pst == "mismatch":
                        print(f"[disposal] 留痕: ✗ — {_rid_g} intake sha256 與帳面不符(事後被改)")
                        fails.append("留痕")
                        ok = False
            if ok:
                _ik_note = f"(含全輪 intake {_ik_n} 份)" if _ik_n else ""
                print(f"[disposal] 留痕: ✓ — 判定輪全席 {n_files} 份留痕存在且 sha256 與帳面一致{_ik_note}")
            if ok and vacuous and carrier is None:
                print("[disposal] quote-check: —(零發現報告無引句可驗,略過;橫幅不宣稱錨定)")
            elif ok:
                try:
                    rows = _quote_rows(_prov_path(rp).read_text(encoding="utf-8"),
                                       _prov_path(sp).read_text(encoding="utf-8"))
                except (OSError, UnicodeDecodeError) as e:
                    # sha 讀二進位過了,text 讀可炸(非 UTF-8)——FAIL 不 traceback(r1 s4 席)
                    print(f"[disposal] quote-check: ✗ — 報告/快照讀不成文字({e.__class__.__name__})")
                    fails.append("quote")
                    rows = None
                else:
                    if rows is None:
                        print("[disposal] quote-check: ✗ — 報告零引句(驗不了≠通過)")
                        fails.append("quote")
                    else:
                        miss = [q for q in rows if not q["ok"]]
                        n_short = sum(1 for q in rows if q.get("too_short"))
                        if miss:
                            print(f"[disposal] quote-check: ✗ — {len(miss)}/{len(rows)} 條錨不到快照"
                                  + (f"(其中 {n_short} 條低於 {_QUOTE_MIN_NORM_LEN} 字下限)" if n_short else ""))
                            fails.append("quote")
                        else:
                            print(f"[disposal] quote-check: ✓ — {len(rows)} 條引句全數錨定")
    # ── canary 觀測(不進合取——d4;none=停用制無植入輪——d5) ──
    ca = sum(1 for r in latest if r.get("kind") == "caught")
    mi = sum(1 for r in latest if r.get("kind") == "missed")
    nn = sum(1 for r in latest if r.get("kind") == "none")
    print(f"[disposal] canary(觀測,不進合取): caught {ca} / missed {mi}"
          + (f" / none {nn}(協議停用,d5)" if nn else "")
          + ("——missed 席 findings ★不作廢★(d4),供跨輪累積帳" if mi else ""))
    for i, r in enumerate(latest, 1):
        print(f"  {rid}.{i}\t{r.get('kind','?')}\t{r.get('severity','-')}\t{r.get('auditor','')}")

    def _roster_tail():
        # roster對帳併入問閘 [S1]:問閘當輪異常轉述(異常才發聲;advisory 恆不動 rc)。
        # 三個提前 return 2 路(G3 spec 讀不到/一輪多處置帳/findings 壞值)刻意不掛——
        # 帳面異常優先於席位對帳(r3 e-f2)。roster 同帶=全史已印,尾端跳過(r2 d-f1)。
        if roster or str(rid).startswith("__"):
            return   # __seqN 合成鍵:round-less 無派工快照可對,沉默勝過錯誤示警(std-r1 s1-f2)
        try:
            kinds = _roster_observe(env, loop_id, rounds, repo, only_rid=rid, anomalies_only=True)
            if kinds:
                print("[roster] ↑ 席位對帳為觀測,不進合取")   # 免責字樣(severity-scan r1 s3-f4 順手補)
                # 留痕([S1c]):收集完、印完才一次性寫;寫入自身再包一層,失敗只損留痕不吞輸出(r3 e-f3)
                try:
                    _ldir = (Path(repo).resolve() if repo else _vault_repo_root(env)) / "governance" / "review-reports" / loop_id
                    _ldir.mkdir(parents=True, exist_ok=True)
                    import datetime as _dt
                    with open(_ldir / "roster-alerts.log", "a", encoding="utf-8") as _f:
                        _f.write(f"{_dt.date.today().isoformat()} {rid} {','.join(kinds)}\n")
                except OSError as _e:
                    print(f"[roster] 異常留痕寫入失敗({_e})——轉述已印,只是兩季覆核帳少這筆")
        except Exception as _e:
            print(f"[roster] 席位對帳失敗(降級不擋):{_e}")

    def _severity_tail():
        # 嚴重度綁定機械掃 [S3](2026-08-26):問閘收尾對判定輪逐席跑第二層 severity 對帳。
        # 異常才發聲;advisory 恆不動 rc;③已對判定輪全席報告逐檔重算過 sha→trust_sha 不重算
        # (r1 arch-f4);__seqN 合成鍵跳過(無派工上下文);例外降級不擋(比照 roster 尾端)。
        # 生效日後的帳列抓到低報=寫側 [S1] 有 bug(本應拒帳)——轉述+指路開 Issue,converged 不自動撤。
        if str(rid).startswith("__"):
            return
        try:
            _root = Path(repo).resolve() if repo else _vault_repo_root(env)
            _hits = []
            for _r in latest:
                _st, _msg = _severity_check_row(_r, _root, trust_sha=True)
                _new_era = str(_r.get("ts", "")) >= _SEV_WRITESIDE_CUTOFF
                if _st == "under" or (_st == "noparse" and _new_era):
                    _tag = "寫側有 bug,開 Issue 攤人;" if _new_era else "歷史帳,"
                    print(f"[severity] {_r.get('auditor','?')}: {_msg}({_tag}觀測,不進合取)")
                    _hits.append(f"severity_underreport:{_r.get('auditor','?')}")
            if _hits:
                try:
                    _ldir = (Path(repo).resolve() if repo else _vault_repo_root(env)) / "governance" / "review-reports" / loop_id
                    _ldir.mkdir(parents=True, exist_ok=True)
                    import datetime as _dt2
                    with open(_ldir / "roster-alerts.log", "a", encoding="utf-8") as _f2:
                        _f2.write(f"{_dt2.date.today().isoformat()} {rid} {','.join(_hits)}\n")
                except OSError as _e2:
                    print(f"[severity] 異常留痕寫入失敗({_e2})——轉述已印,只是覆核帳少這筆")
        except Exception as _e2:
            print(f"[severity] 嚴重度對帳失敗(降級不擋):{_e2}")
    if not readonly:
        # replay 唯讀:觀測尾巴不跑——roster 尾端會寫 roster-alerts.log(r2 delta d-f3 抓的第三個寫入點),
        # severity 尾端同理;純判定核心=四合取本體。
        _roster_tail()
        _severity_tail()
    # intake守衛 T2(2026-08-30 d1;advisory 不進合取不改 rc):非 code 迴圈才看
    # (r3-F2:code-loop 零前掃步驟,code 的 intake 是撈回紀錄非前掃紀錄——計數它=逼偽宣告)。
    if not readonly and not str(loop_id).startswith("code"):
        _ik_st = _intake_dir_status(root if root is not None else Path.cwd(), loop_id)
        if _ik_st == "ok":
            print("[disposal] intake(觀測,不進合取): ✓ — 迴圈目錄有帶 preflight-4 宣告行的前掃留痕")
        elif _ik_st == "missing":
            print("[disposal] intake(觀測,不進合取): ⚠ 迴圈目錄無帶 preflight-4 宣告行的 intake——"
                  "首輪前掃第四類可能沒跑(慣例=skills/lumos-design-loop/SKILL.md 步驟 2;不擋,記著補)")
        # no-dir(scratch 迴圈,如自主迴圈 /tmp 工作區)= 跳過不印
        # ── 審查有沒有用記帳 S3(2026-09-08):問閘這一輪的漏斗,觀測不進合取 ──
        _y = _review_yield_round(latest)
        _esc = len(_escape_rows_for(env, loop_id)) if env is not None else None
        print("[disposal] 審查有沒有用(觀測,不進合取;N 機器數、R 人填,別算比率): " + _review_yield_line(_y, _esc))
    # ── ⑤ 條款綁定(條款綁測試算進度 [S3],2026-09-08):計劃有 [SN] 的,每條要嘛 [test:] 要嘛 [manual:],否則不得 PASS。
    #    只看 .md 計劃、首筆帳在 _CLAUSE_GATE_SINCE 之後的迴圈(不回溯);懸空只印不擋(存在性歸 doctor/spec-trace 唸)。
    _cl = _disposal_clause_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _cl == "abort":
        return 2          # 同 G3:審材讀不到是用法錯誤,整支停,不是「這一項沒過」(r1/r2 架構席)
    if _cl == "fail":
        fails.append("條款綁定")
    # ── ⑥ 資安席(代碼審資安席 [S2],2026-09-11 d6):定錨 high 的代碼審,編制表上 required-gated 席要出席、留痕對、
    #    看過的檔涵蓋判定輪。只看生效日後開的迴圈(不回溯)。凍結/回放照樣重讀檔(凍結閉包也收了這些檔)。
    _sec = _disposal_security_step(rounds, rid, loop_id, _prov_path)
    if _sec == "fail":
        fails.append("資安席")
    # ── ⑦ 落點(每支檔有家 [S21],2026-09-11):計劃要寫明現況落在哪幾篇;首筆帳在 _LANDING_GATE_SINCE 之後的迴圈才看。
    _ld = _disposal_landing_step(rounds, spec, root, env, loop_id=loop_id, spec_sha_override=spec_sha_override)
    if _ld == "abort":
        return 2
    if _ld == "fail":
        fails.append("落點")
    if result_out is not None:
        result_out["rid"] = rid
        result_out["fails"] = list(fails)
    if fails:
        print(f"⛔ DISPOSAL GATE FAIL ({loop_id} 輪 {rid}: {'/'.join(fails)})")
        return 1
    # 橫幅只列這次真的跑過而且過了的步驟(代碼審 r3 編排者自找:加了⑤⑥之後橫幅還寫死四項);skip 的不列、不宣稱
    _extra = "".join(f" ∧ {n}" for n, st in (("條款綁定", _cl), ("資安席", _sec), ("落點", _ld)) if st == "ok")
    if vacuous and carrier is None:
        print(f"✅ DISPOSAL GATE PASS ({loop_id} 輪 {rid}: G3 ∧ 0 發現空輪 ∧ 留痕可重算{_extra};引句無可驗不宣稱)")
    else:
        print(f"✅ DISPOSAL GATE PASS ({loop_id} 輪 {rid}: G3 ∧ 處置全清 ∧ 留痕可重算 ∧ 引句全錨定{_extra})")
    if not readonly:
        _loop_gov_mark(env, loop_id, "converged", "disposal gate PASS")
    return 0


