    "refcheck": "文件裡引的 檔案:行號 還存不存在。",
    "impact": "動手前:改這個檔 / 這段 diff 會波及哪些筆記、驗證、決策。--sync-check 查波及的筆記有沒有同步。",
    "pitfalls": "這份 spec 或這段改動有什麼實務隱患、風險分級多高(tier: high 要過代碼審)。",
    "ci-wait": "push 後等 CI 結論,綠 rc0 紅 rc1;結果進治理帳。別用 gh run list。",
    "ci-status": "只看上次 CI 結果,不打網路。",
    "testmap": "檔案↔測試的依賴地圖:build 挖一次,affected 依 diff 推薦該跑哪些測試。",
    "build": "挖掘檔案↔測試的關係,存成地圖。",
    "affected": "改了這些檔,具體該跑哪幾個測試(建議,不擋)。",
    "test-layers": "改了這些檔,該跑哪一層測試(單元 / 整合 / UI)的提醒,不擋。",
    "lint-check": ".lumos/lint.json 宣告的 linter 真的跑得動嗎。--smoke 真跑。",
    "lint-waive": "新增告警閘擋下來的那條是誤報?帶指紋和理由放行,會留痕被統計。--list 看放行過什麼。",
    "rule-check": "自寫規則每條都有會翻紅的樣本嗎。沒樣本的規則可能是死的。",
    "rule-gap": "逃逸帳標了該抓卻還沒寫的規則,列成待辦。",
    "sqlfluff-sarif": "把 sqlfluff 的 JSON 輸出轉成 SARIF,接進 lint 適配器。",
    "stylelint-sarif": "把 stylelint 的 JSON 輸出轉成 SARIF,接進 lint 適配器。",
    "dart-sarif": "把 dart analyze 的 JSON 輸出轉成 SARIF,接進 lint 適配器;讀不懂就失敗、不吐空結果。",
    "anchor": "測試 / hook 檔有沒有被動過:verify 比對,approve 核可並留痕。",
    "enforcement": "各層防護現在到底有沒有生效(唯讀):hooks 註冊了嗎、pre-commit/pre-push 接了嗎、CI/anchor 在不在。",
    "dispatch-lens": "代碼審派工詞的固定席鏡頭:Claude 側 hook 自動叫;Codex 編排時派工前一刻敲 `--arm <base>..<head> --seats N`(子代理開場各領一席,10 分 TTL),派完 `--disarm`。手動看內容給 <base>..<head>(從 base 讀、零自由文字;base 不在主線→rc4 放行)。",
    "verify": "比對驗證器檔案指紋與基準線,不符 rc1。",
    "approve": "刻意改了驗證器,重算指紋寫回基準線並留理由。",
    "quote-check": "審查報告的引句是不是真的在凍結快照裡;錨不到的不採信。",
    "link-candidates": "哪些 code 沒有任何筆記連到它,列候選;要不要補由人裁。",
    "seat-check": "派工單要查的材料,審查報告有沒有都碰到;引句有沒有超出範圍。",
    "lint-watch": "專案依賴版本落後 registry 最新版了嗎。",
    "compose-metrics": "Compose 可組合指標有沒有比 baseline 退步。",
    "home": "每支程式檔有沒有一篇管它的節點、寫回有沒有落在改到那支檔的那一篇(提交前與推送前擋新違規)。",
    "home check": "這次提交(--staged)或這段推送(--diff)有沒有「每支檔有家」的新違規;有就擋。",
    "cochange": "改了 A 檔,歷史上常一起改的 B 檔要不要跟著改。rules 看規則,check 對變更集比對。",
    "rules": "列出共改規則集。",
    "cochange check": "對這次變更集比對規則,列出可能漏改的夥伴檔(提醒不擋)。",
    "code-loop check": "我現在推得上去嗎:合約測試紅、觸發到的效能檢核題沒表態、tier=high 又沒有效留痕,任一成立就 BLOCKED,並講原因。",
    "code-loop dispositions": "推送前對這次改動觸發到的棧別效能檢核題逐題表態(做到了附證據/不適用附理由/待辦連 Issue);樣板從 pitfalls --diff --dispositions-template 來。",
    "code-loop recall-miss": "審查席抓到「對得上某未觸發題」的問題時登記一筆;同題累積 3 次 gov --stats 列成觸發太窄候選。",
    "delguard": "commit 時自動跑:刪掉 / 改名的符號,筆記還在不在講它。",
    "code-loop": "推送前的留痕:pass 審過、skip 刻意不審、dispositions 對效能檢核題表態、check 現在推得上去嗎。",
    "loop rewrite": "人裁判「整份重寫」後收尾:記 rewrite 事件+血緣(prev/successor)進治理帳;連續第二次判重寫會警告強制攤人。",
    "pass": "代碼審過了,留痕綁當下版本;之後再改 code 就失效要重跑。",
    "skip": "刻意不審,留痕寫理由(合法,但會被統計)。",
}


def _fill_help_when(parser, parent=""):
    """遞迴把 HELP_WHEN 灌進每個沒有 description 的子指令,讓 `lumos X --help` 第一行講人話。
    同名二層子指令(cochange check / code-loop check)先查「父 子」鍵再退回單名。"""
    for act in parser._actions:
        if isinstance(act, argparse._SubParsersAction):
            for name, sp in act.choices.items():
                if not sp.description:
                    when = HELP_WHEN.get(f"{parent} {name}".strip()) or HELP_WHEN.get(name)
                    if when:
                        sp.description = "什麼時候用:" + when
                _fill_help_when(sp, name)

def main():
    cr.add_argument("--capture-counts", dest="capture_counts",
                    help="panel 輪的 capture-recapture 輸入:各 distinct 缺陷被幾個審計員找到,逗號分隔(如 '2,2,1');供殘餘估計")
    cr.add_argument("--clusters",
                    help="M2 risk-cluster 三態帳:'名=狀態,...'(resolved/accepted-minor:理由/disputed-major);每輪至多一筆帶,loop status --panel 消費")
    cr.add_argument("--spec", dest="rec_spec",
                    help="M1包 雙 hash:計算當下真檔 sha256 存 result_sha256(record 於 fold 後執行=post-fold);須與 --reviewed 同現")
    cr.add_argument("--reviewed", help="M1包 雙 hash:派工當下真檔 sha256 hex(dispatch 快照);須與 --spec 同現")
    cr.add_argument("--tokens", type=int, help="M1包 成本欄:該輪 subagent tokens(非負整數,選配)")
    cr.add_argument("--scope-lines", type=int, dest="scope_lines",
                    help="這輪被審材料的行數(diff/spec;非負整數,選配)。★不進任何 gate★——"
                         "純telemetry,供日後分析『caught 率是不是隨規模掉』(外部實測:規模是主導混淆變數)")
    cr.add_argument("--wallclock-min", type=int, dest="wallclock_min", help="M1包 成本欄:該輪 wall-clock 分鐘(非負整數,選配)")
    cr.add_argument("--outcome", dest="rec_outcome",
                    help="[自主迴圈結局帳] 這一輪最後怎麼收:converged / unconverged:<細類> / "
                         "tier-blocked:<細類> / skipped / pipeline_fail:<死因>。"
                         "機器要回讀的資料開結構化欄,不塞 note 散文(auto-loop-repair-v2)")
    cr.add_argument("--usd", dest="rec_usd", type=float,
                    help="[自主迴圈結局帳] 這一輪實際花的美元(claude -p 回傳,非估算;非負,選配)")
    cr.add_argument("--tier", dest="rec_tier", choices=("light", "standard", "high"),
                    help="M1包 tier 定錨欄:該 loop 首個帶 tier 的記錄定錨 loop tier(loop next/gate 讀取)")
    cr.add_argument("--orchestrator", dest="rec_orch", choices=("claude", "codex"),
                    help="d4 編排者定錨欄:誰在編排這個迴圈(外家席=不是編排者那一家);首筆定錨,之後要一致")
    cr.add_argument("--report", help="[T1 處置帳] 審查員報告檔路徑(存 path+sha256;檔案須存在且非空)")
    cr.add_argument("--snapshot", help="[T1 處置帳] 派工凍結快照檔路徑(quote-check 的比對對象;存 path+sha256)")
    cr.add_argument("--intake", help="首輪前掃留痕檔(rN-intake.md;選配——給了就存 path+sha256 且處置閘會全輪重驗,不給不擋。intake守衛案 2026-08-30)")
    cr.add_argument("--findings-set", dest="findings_set",
                    help="[T1 處置帳] 逐條 finding id 逗號串(集合核對的全集;與 folded/accepted 配套)")
    cr.add_argument("--folded-set", dest="folded_set", help="[T1 處置帳] 折入計劃節點的 id 子集")
    cr.add_argument("--accepted-set", dest="accepted_set",
                    help="[T1 處置帳] 附理由放行的 id 子集(與 folded 互斥;聯集須=全集;blocker 輪必空)")
    cr.add_argument("--accept-reason", dest="accept_reasons", action="append",
                    help="[T1 處置帳] id=理由(可重複;鍵集合須=accepted-set,理由非空)")
    cr.add_argument("--finding-kind", dest="finding_kinds", action="append",
                    help="每條發現在修什麼:id=code(程式缺陷)|spec(被審文件缺陷)|process(流程要求的文件/留痕/範本);選填,給了要全集對得上——量「流程自產工作量」用")
    cr.add_argument("--finding-severity", dest="finding_severities", action="append",
                    help="每條發現自己的嚴重度:id=clean|minor|major|blocker;選填,給了要每條各標一個——逃逸自動記靠它判「code 型那條是不是 major 以上」,沒給就退回輪級判準並在逃逸帳標 precision=round")
    cr.add_argument("--refute-verdict", dest="refute_verdicts", action="append",
                    help="辯方對某條發現的明確表態:id=agree(同意是真的,維持)|evidence(拿反證降級,須附 file:line)|concern(只存疑無反證,維持);選填,鍵是辯方判過的子集(⊆全集,辯方只判低共識≥major)——純記帳不改判閘,供日後偵測『辯方降級的後來證明是真的』(2026-08-22 三分類裁定的重啟條件)")

    cr.add_argument("--refuted-set", dest="refuted_set",
                    help="[審查有沒有用記帳 S2] 編排者機械重現不到、沒折也沒放行的發現:id=理由 逗號串,或 none(這輪 0 條);帶 --findings-set 就必帶;id 不得在 findings-set 裡、要對得上 --intake 的重現表列(整字+HIT/MISS)、理由 ≥4 字含實字")

    rn = sub.add_parser("report-normalize", help="[審查有沒有用記帳 S4] 席報告收貨正規化:把行內/列表/標題式的 severity 轉成獨立宣告行、補檔級行;不帶 --write 只印")
    rn.add_argument("path", help="要正規化的席報告 markdown 檔路徑")
    rn.add_argument("--write", action="store_true", help="真的寫回(原子覆寫);不帶只印會改什麼、還剩什麼")

    lp = sub.add_parser("loop", help="審計 loop 收斂查詢(消費 canary-log 的 --loop 記錄)")
    lsub = lp.add_subparsers(dest="lcmd", required=True)
    ls = lsub.add_parser("status", help="算某 loop 收斂:連 K 輪 caught 且無 blocker/major")
    ls.add_argument("loop_id")
    ls.add_argument("--need", type=int, default=None, help="連續乾淨輪數 K(預設 2;--settle 下禁用)")
    ls.add_argument("--disposal", action="store_true",
                    help="[T4] 處置閘(獨立路徑,與 --panel/--light/--settle/--need/--min-seats 互斥;需 --spec)")
    ls.add_argument("--gate", action="store_true",
                    help="證據閘:K-streak(必要)∧ G1 refcheck 引用座標 ∧ G2 發現枯竭,全過才 rc 0")
    ls.add_argument("--spec", dest="gate_spec", help="--gate 必填:要核對引用座標的最終 spec md")
    ls.add_argument("--repo", dest="gate_repo", help="repo root(預設 cwd 逐層向上找 .git)")
    ls.add_argument("--panel", action="store_true",
                    help="平行 panel 模式:按 round-id 分組。無-cluster 帳=兩條合取(輪有效∧存活max≤minor;capture-recapture 殘餘=advisory 不進合取,2026-08-14 降級);cluster 帳(M2,首個有效輪帶 --clusters 定錨)=兩條合取(輪有效∧fold後無disputed-major),新生cluster/capture-recapture 同 advisory。--gate 對 panel 為相容 no-op(panel 判準恆生效)")
    ls.add_argument("--light", action="store_true",
                    help="M1包 light K=1 謂詞:單席 caught∧max≤minor∧欄位互證∧hash 雙欄(強制 fail-closed);ratchet=任一 caught 輪≥major 永久 FAIL;與 --panel 互斥;需 --spec")
    ls.add_argument("--settle", metavar="清單檔",
                    help="結清模式(opt-in,v1 只接 legacy):JSON 約束清單,全結清∧G1∧G3 才收斂;"
                         "與 --panel/--light/--need/--min-seats 互斥,需 --gate+--spec")
    ls.add_argument("--min-seats", type=int, dest="min_seats",
                    help="M1包 席數下限:判定輪相異 auditor 數<N 即 FAIL(同席重複 append 不計;不帶=行為不變)")
    ls.add_argument("--roster", action="store_true",
                    help="[派工編制資料化] 編制對帳觀測(advisory 恆不影響 rc):應派(_TIER_ROSTER)vs 實派"
                         "(rN-dispatch*.json)逐輪分桶比;與所有模式相容,建議配 --repo。"
                         "全史觀測/回放用——問閘 --disposal 偵測到席位異常會自動轉述當輪,"
                         "同帶本旗標時尾端不重複(詳 Projects/roster對帳併入問閘_計劃)")
    lc = lsub.add_parser("compress", help="[S2] 結構化壓縮:長跑上下文規則式三欄(白名單壓不掉/證據/未結)")
    lc.add_argument("compress_file", metavar="檔")
    lc.add_argument("--json", dest="compress_json", action="store_true")
    lv = lsub.add_parser("verify-progress", help="[S3] 獨立進度驗證器:直讀帳只吃結構欄位,散文注入免疫")
    lv.add_argument("vp_loop_id", metavar="loop_id")
    lv.add_argument("--settle", dest="vp_settle", metavar="清單檔")
    lv.add_argument("--json", dest="vp_json", action="store_true")
    lr = lsub.add_parser("rewrite", help="人裁「整份重寫」收尾:記 rewrite 事件+血緣 note(prev/successor),自動查「連續兩次」")
    lr.add_argument("rw_loop_id", metavar="loop_id")
    lr.add_argument("--successor", dest="rw_successor", required=True, help="接手的新迴圈編號")
    lr.add_argument("--note", dest="rw_note", default="", help="一句為什麼判重寫(人裁依據)")
    ln = lsub.add_parser("next", help="M1包 機械脊椎:帳本吐唯一下一動作(phase/輪數/canary 型別/席數/記帳模板);唯讀指針,不 spawn agent")
    ln.add_argument("loop_id")
    ln.add_argument("--tier", dest="next_tier", choices=("light", "standard", "high"),
                    help="編排者宣告 tier(有帳面定錨時須一致否則 rc2;零記錄必填)")
    ln.add_argument("--orchestrator", dest="next_orch", choices=("claude", "codex"),
                    help="誰在編排(claude|codex;零記錄必填、不預設;有帳面定錨須一致)——外家席=不是編排者那一家(d4)")
    ln.add_argument("--json", action="store_true", dest="next_json", help="機讀輸出")
    ln.add_argument("--need", type=int, default=2, help="legacy 收斂窗 K(委派 gate 用,預設 2)")
    ln.add_argument("--spec", dest="gate_spec", help="gate 委派用 spec 檔;缺=判 converged 資訊不足→gate-pending")
    ln.add_argument("--repo", dest="gate_repo", help="repo root(gate 委派用)")
    le = lsub.add_parser("escape",
                         help="逃逸帳:迴圈放行後下游抓到可歸因缺陷→記一筆(--list 看全帳)",
                         description="什麼時候用:某個審查迴圈收斂放行了,但下游(實作/CI/prod/人)發現可歸因的缺陷——記一筆逃逸帳。append-only、不進任何閘;歸因是人工判斷,編號必須實存於審查帳。看全帳用 --list(唯讀,不能與記帳參數混用)。")
    le.add_argument("esc_loop_id", nargs="?", default=None, metavar="loop_id", help="放行該缺陷的迴圈編號(必須存在於審查帳)")
    le.add_argument("--stage", dest="esc_stage", help="在哪一站發現:實作/code-loop/CI/prod/使用者回報…(自由字串)")
    le.add_argument("--severity", dest="esc_severity", choices=("minor", "major", "blocker"), help="缺陷嚴重度(同審查帳值域)")
    le.add_argument("--desc", dest="esc_desc", help="一句描述:什麼缺陷、為何可歸因到該迴圈")
    le.add_argument("--defect-ref", dest="esc_ref", help="佐證指標(commit/Issue/報告路徑,選配)")
    le.add_argument("--auto", dest="esc_auto", action="store_true",
                    help="自動記:不給編號,改給 --range,碰到的計劃筆記各記一筆(推送閘/CI 用);對不回不記")
    le.add_argument("--range", dest="esc_range", help="--auto 用:提交範圍 a..b")
    le.add_argument("--sha", dest="esc_sha", help="--auto 用:去重鍵的 sha(不給就取 HEAD)")
    le.add_argument("--repo", dest="esc_repo", help="--auto 用:repo 根(不給就用 vault 的上兩層)")
    le.add_argument("--rule", dest="esc_rule", help="本來哪條規則該抓到它(規則 id;真的沒有對應規則就寫 none)。標了才算得出「該寫哪條規則」——看待辦:lumos rule-gap")
    le.add_argument("--list", dest="esc_list", action="store_true", help="列全帳(按迴圈分組)")
    ll = lsub.add_parser("list", help="哪些審查迴圈還開著(帳面沒關門的);next/status 都要 loop_id,這支先給你編號")
    ll.add_argument("--days", dest="ll_days", type=int, default=14, help="幾天內有動才算「在飛」(預設 14)")
    ll.add_argument("--stale", dest="ll_stale", action="store_true", help="只看超過門檻沒動又沒關門的(空轉候選)")
    ll.add_argument("--all", dest="ll_all", action="store_true", help="連已關門的也列")
    ll.add_argument("--exclude", dest="ll_exclude", action="append", default=[], metavar="前綴",
                    help="略過編號以此開頭的迴圈(可重複;例:--exclude auto- 排掉自主迴圈的每日場次)")
    ll.add_argument("--json", dest="ll_json", action="store_true")
    ll.add_argument("--now", dest="ll_now", metavar="YYYY-MM-DD", help="指定「今天」是哪一天(重算/測試用;預設系統日期)")
    lcs = lsub.add_parser("canary-stats",
                          help="[d4 讀取面] 跨輪 canary 累積帳:席位×caught/missed×尾端連續 missed;唯讀恆 rc0")
    lcs.add_argument("loop_id", nargs="?", default=None, help="省略=全 loop 摘要")

    lcc = lsub.add_parser("capture-counts",
                          help="異質 finder 接線:多 --finder 的 finding-key → capture_counts + 殘餘估計(餵 canary record --capture-counts)")
    lcc.add_argument("--finder", dest="finders", action="append", default=[],
                     help="一個 finder 找到的 finding-key 逗號串(LLM reviewer / SARIF linter / 測試失敗 / mutation 存活各給一個)")
    lcc.add_argument("--from-pitfalls", dest="cc_pitfalls",
                     help="自動收割 pitfalls --diff <range> 命中成確定性 finder(按 source 分組,免手貼)")
    lcc.add_argument("--repo", dest="cc_repo", help="repo root(--from-pitfalls 用;預設 cwd 向上找 .git)")
    lrp = lsub.add_parser("replay", help="改制回測:判定回放(--golden 對凍結閉包重算比對;--freeze 產 golden 判定檔;唯讀不落帳)")
    lrp.add_argument("rp_loop_id", metavar="loop_id")
    lrp.add_argument("--golden", dest="rp_golden", default=None, metavar="verdict.json", help="回放模式:與這份標準答案比對")
    lrp.add_argument("--freeze", dest="rp_freeze", action="store_true", help="凍結模式:產 governance/replay/<id>/verdict.json")
    lrp.add_argument("--spec", dest="rp_spec", default=None, help="凍結模式必帶:被審計劃檔(帳裡沒路徑欄,操作者給)")
    lrp.add_argument("--note", dest="rp_note", default=None, help="重凍理由(目的檔已存在時必填,留痕治理帳)")
    lrp.add_argument("--repo", dest="rp_repo", default=None, help="repo root(預設向上找 .git)")

    g = sub.add_parser("guard", help="合約守衛 scaffold(對談驅動):列出未綁 / 套範本產 stub / 綁定")
    gsub = g.add_subparsers(dest="gcmd", required=True)
    if args.cmd == "fold-check":
        return cmd_fold_check(args.path, as_json=args.as_json)
    if args.cmd == "refcheck":
        return cmd_refcheck(args.md, repo=args.refcheck_repo, as_json=args.as_json)
    if args.cmd == "pitfalls":
        return cmd_pitfalls(md=args.md, diff=args.pf_diff, repo=args.pf_repo,
                            check=args.check, as_json=args.pf_json, no_lint=args.pf_no_lint,
                            disp_tpl=getattr(args, "pf_disp_tpl", False), carry=getattr(args, "pf_carry", False),
                            branch=getattr(args, "pf_branch", None))
    if args.cmd == "testmap":
        if args.tmcmd == "build":
            return cmd_testmap_build(repo=args.tm_repo, as_json=args.tm_json)
        return cmd_testmap_affected(diff=args.tm_diff, repo=args.tm_repo,
                                    as_json=args.tm_json)
    if args.cmd == "test-layers":
        return cmd_test_layers(diff=args.tl_diff, repo=args.tl_repo, as_json=args.tl_json)
    if args.cmd == "lint-check":
        return cmd_lint_check(repo=args.lc_repo, smoke=args.lc_smoke, as_json=args.lc_json)
