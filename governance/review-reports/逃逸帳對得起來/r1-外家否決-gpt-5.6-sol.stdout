  9319	def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
  9320	    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
  9321	    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
  9322	    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
  9323	    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
  9324	    log = env.vault.parent / ".escape-log.jsonl"
  9325	    ledger = env.vault.parent / ".canary-log.jsonl"
  9326	    known = set()
  9327	    if ledger.exists():
  9328	        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
  9329	            if not ln.strip():
  9330	                continue
  9331	            try:
  9332	                v = json.loads(ln).get("loop")
  9333	            except ValueError:
  9334	                continue
  9335	            if isinstance(v, str):
  9336	                known.add(nfc(v))
  9337	    import datetime as _dt
  9338	    import secrets as _sec
  9339	    written = 0
  9340	    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
  9341	    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
  9342	    with _vault_write_lock(env.vault):
  9343	        existing = set()
  9344	        for r in _escape_rows_for(env):
  9345	            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
  9346	        for loop_id, plan_rel in loops:
  9347	            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
  9348	            if nfc(loop_id) in known:
  9349	                attribution = "ledger"
  9350	            elif plan_ok:
  9351	                attribution = "plan-file"
  9352	            else:
  9353	                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
  9354	                continue
  9355	            door = _door_for_loop(env, loop_id)
  9356	            if stage == "push-gate-unreviewed" and door != "low":
  9357	                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
  9358	                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
  9359	                continue
  9360	            if (nfc(loop_id), stage, sha) in existing:
  9361	                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
  9362	                continue
  9363	            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
  9364	                   "token": "ESC-" + _sec.token_hex(4),
  9365	                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
  9366	                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door}
  9367	            if plan_rel:
  9368	                rec["plan"] = plan_rel
  9369	            if extra:
  9370	                rec.update(extra)
  9371	            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
  9372	                written += 1
  9373	                existing.add((nfc(loop_id), stage, sha))
  9374	                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
  9375	            else:
  9376	                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
  9377	    return written
