        _dl = None if os.environ.get(_LENS_WARM_ENV) else args.lens_deadline
        return cmd_dispatch_lens(args.lens_range, repo=args.lens_repo, as_json=args.lens_json,
                                 no_cache=args.lens_nocache, deadline=_dl)
    if args.cmd == "impact":
        if sum(1 for x in (args.impact_file, args.impact_diff, args.impact_node) if x) > 1:
            print("擋下:--file、--diff、--node 只能選一個用", file=sys.stderr)
            return 2
        if args.impact_node:
            if args.impact_depth is not None:
                print("擋下:--node 只列直接相連的一層,沒有「深度」可言,不能搭 --depth", file=sys.stderr)
                return 2
            return cmd_impact_node(args.impact_node, repo=args.impact_repo, as_json=args.impact_json)
