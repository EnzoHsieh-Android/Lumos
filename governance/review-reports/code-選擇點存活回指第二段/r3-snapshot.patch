+    import hashlib
+    import json as _j
+    hp = Path(fake) / "hits.json"
+    t = _j.loads(hp.read_text(encoding="utf-8"))
+    first = next(v for k, v in t.items() if k != "bad")
+    t[hashlib.sha256(src2.encode("utf-8")).hexdigest()] = first
+    hp.write_text(_j.dumps(t), encoding="utf-8")
