+    out = Path(tmp) / "checks-catalog.md"
+    out.write_text(cat.replace(old, "| C-7 | ROR | `ror.yml` `$A === $B` | 運算子 | `$A !== $B`、`$A == $B`、`$A != $B` |"), encoding="utf-8")
