+    回 (內容, None) 或 (None, 不讀的理由)。"""
+    import stat as _st
+    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        fd = os.open(str(f), flags)
+    except OSError as e:
+        if f.is_symlink():
