 >     "app":     {"profile": "kotlin-junit", "root": "."},          // 前端 App(同 repo)
 >     "e2e":     {"profile": "maestro",      "root": "."},          // 同 repo 的 E2E flow
 >     "backend": {"profile": "csharp-xunit", "root": "../<後端 repo>"}  // 後端 API(另一 repo)
 >   } }
 > ```
