+             ("search legacy nDCG", v.get("_ln_eq"), cs.get("ndcg_legacy")),
+             ("edit fusion P", v.get("_fp_eq"), ce.get("p")),
+             ("edit bm25 P", v.get("_bp_eq"), ce.get("bm25_p")),
+             ("edit graph P", v.get("_gp_eq"), ce.get("graph_p"))]
     for name, old, new in pairs:
