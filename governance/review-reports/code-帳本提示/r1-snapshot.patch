+def _codeloop_print_dirty_bookkeeping(repo_root, status):
+    """留痕之後,把「還沒提交的簿記檔」列成一行可直接貼的提交指令。
+
+    ★不是新的閘,是把手打路徑清單換成工具列出來★(2026-09-21 同一天犯兩次):
+    留痕前通常剛跑過 anchor approve,簽名檔因此變髒;人手打清單時漏掉它,
+    推送會被「簽名檔改過了但沒提交」擋下——重複犯的是打字,不是判斷。
+    清單沿用 _BOOKKEEPING_FILES / _BOOKKEEPING_DIRS,不自開第二份判準。
+    """
+    import subprocess as _sp
+    # -uall:未追蹤的目錄預設會被摺成一行(例如只印 governance/),逐檔列才對得上白名單
+    r = _sp.run(["git", "status", "--porcelain", "-z", "-uall"], cwd=str(repo_root),
+                capture_output=True, text=True, errors="replace")
+    if r.returncode != 0:
+        return
+    dirty = []
+    for ent in r.stdout.split("\0"):
+        if len(ent) < 4:
+            continue
+        rel = ent[3:]
+        # ★只列帳本檔本身,不列卷證目錄★(2026-09-21 自己試跑時踩到):
+        # 把 _BOOKKEEPING_DIRS 一起算進來會列出 126 個檔,裡面全是別的 session 的
+        # 審查卷證與舊的未提交證據——照貼會把別人的檔一起提交(同工作區夾帶風險)。
+        # 卷證屬於功能提交,帳本檔才是留痕之後該單獨提交的東西。
+        if rel in _BOOKKEEPING_FILES and rel not in dirty:
+            dirty.append(rel)
+    if not dirty:
+        return
+    msg = "chore(lumos): 記錄代碼審通過" if status == "passed" else "chore(lumos): 記錄代碼審跳過"
+    print(f"  這幾個簿記檔還沒提交({len(dirty)} 個)——留痕之後只准提交它們,漏掉哪個推送都會被擋:")
+    quoted = " ".join(_sh_quote(d) for d in dirty)
+    print(f"    git commit -m '{msg}' -- {quoted}")
+
+
+def _sh_quote(s):
+    """路徑含空白或中文時照樣貼得上去。"""
+    import shlex
+    return shlex.quote(s)
+
+
