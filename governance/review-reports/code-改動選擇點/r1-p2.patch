+def _choice_kill_base(env, diff, branch, only, max_mutants, max_seconds):
+    """choice-kill 跑之前的前半檢查 → (repo 根, 範圍, HEAD, --only 的 (檔, 行) 或 None) 或 rc(已印原因):參數、範圍(右端要是 HEAD)、
+    工作目錄除簿記檔外乾淨(〈範圍〉2 跑之前)。"""
+    say = _situation_rule_say
+    loc = None
+    if only is not None:
+        loc = _choice_loc_parse(only)
+        if loc is None:
+            return say(f"--only {_kill_esc(str(only))[:80]} 要寫成 <檔>:<行>(行號是正整數)")
+    if max_mutants < 1 or max_seconds <= 0:
+        return say("--max-mutants 要是正整數、--max-seconds 要大於 0")
+    rr = Path(_vault_repo_root(env))
+    rng, at_sha, why = _choice_range(rr, diff, branch)
+    if why:
+        return say(f"choice-kill:{why}")
+    if at_sha != _lens_full_sha(rr, "HEAD"):
+        return say("範圍的右端要是 HEAD(殺傷力在 HEAD 建隔離工作樹,兩邊要同一版)")
+    dirty = _dirty_non_bookkeeping(rr)
+    if dirty is None:
+        return say("查不到工作目錄有沒有未提交改動(git 跑不起來)")
+    if dirty:
+        return say(f"工作目錄有未提交改動(簿記檔以外):{'、'.join(_kill_esc(x) for x in dirty[:8])}——殺傷力照 HEAD 跑,先提交再跑")
+    return rr, rng, at_sha, loc
