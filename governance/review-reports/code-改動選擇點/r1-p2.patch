+    note = f"選擇點 {extra['file']} {extra['row']} {extra['verdict']}"
+    ok = _gate_event(rr, _CHOICE_KILL_GATE, _CHOICE_KILL_GATE, note, hard=False, head_sha=head, nodes=[], extra=extra)
+    if ok is not True:
+        print(f"⚠ 治理帳寫不進去(choice-kill {_kill_esc(extra['file'])} {extra['verdict']}),這一行的判定沒記到", file=sys.stderr)
