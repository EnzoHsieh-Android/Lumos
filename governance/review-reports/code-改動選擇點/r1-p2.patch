+    live = [p + ".md" for p in plans if _plan_live(p + ".md", tenv.notes.get(p + ".md"), touched_plans)]
+    if not live:
+        today = time.strftime("%Y-%m-%d")
+        return (today >= since), ("沒碰到計劃、今天在生效日之後" if today >= since else "沒碰到計劃、今天早於生效日")
+    days = [_plan_effective_day(rr, f"{vrel}/{p}", (tenv.notes.get(p).fields.get("created") if tenv.notes.get(p) else None), scope="note")
+            for p in live]
+    if any(d is None or d >= since for d in days):
