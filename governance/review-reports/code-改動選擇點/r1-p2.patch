+def _choice_test_blobs(rr, at_sha, names):
+    """run 那筆的 tests:[[測試名, 所在檔的物件編號]…];測試名在被讀版本的樹裡第一支含它的檔(git grep -F),找不到記空字串。"""
+    out = []
+    for n in names:
+        blob = ""
+        r = _lens_git(rr, "grep", "-l", "-F", "-e", n, at_sha, "--")
+        hit = (r.stdout.splitlines()[0] if r is not None and r.returncode == 0 and r.stdout.strip() else "")
+        if hit:
+            b = _lens_git(rr, "rev-parse", hit)
+            blob = b.stdout.strip() if b is not None and b.returncode == 0 else ""
+        out.append([n, blob])
+    return out
