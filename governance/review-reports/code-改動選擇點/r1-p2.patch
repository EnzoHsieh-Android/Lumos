+    rr, head, x = got
+    ident, mut = x["mutant"]["identity"], x["mutant"]
+    got = _situation_rule_plan(env, plan)
+    if got is None:
+        return 2
+    pn, prel, ppath, text = got
+    why = _situation_rule_args_problem(clause, test, ident["file"], ident["old"], ident["new"], consent)
