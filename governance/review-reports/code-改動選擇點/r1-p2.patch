+    算不出來(設定讀不了、git 讀不到)往外丟,呼叫端照「算不出來」處理。"""
+    pdata = load_platforms(rr)
+    if not any(p.get("profile_name") == "kotlin-junit" for p in pdata["platforms"].values()):
+        return False, "專案沒有 kotlin-junit 平台"
+    changed, _big = _choice_changed(rr, rng, at_sha, deadline=deadline)
+    if not changed:
+        return False, "改到的行沒有 Kotlin 正式碼"
+    since = _choice_since()
+    meta = {}
+    plans, why = _kt_sit_spec_names_calc(rr, rng, at_sha, deadline=deadline, meta=meta)
