+    m = re.match(r"\s*(" + "|".join(_CHOICE_WAIVE_LABELS) + r")\s*[:：]\s*(.*)\Z", note or "", re.S)
+    if not m or _real_chars(m.group(2)) < _CHOICE_WAIVE_MIN:
+        return _situation_rule_say(f"選擇點放行的理由寫成 --note \"<{'|'.join(_CHOICE_WAIVE_LABELS)}>:<理由>\",理由至少 {_CHOICE_WAIVE_MIN} 個實字"
