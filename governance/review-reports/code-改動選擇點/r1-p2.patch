+    import secrets
+    ex = {"file": ident["file"], "fp": ident["fp"], "row": ident["row"], "new_sha": ident["new_sha"], "verdict": verdict,
+          "killing_test": killing or "", "clauses": list(clauses or []), "plans": list(plans or []), "tests_sha": tests_sha,
+          "reason": (reason or "")[:_CHOICE_REASON_MAX], "via": via, "attempt": int(attempt), "run_id": run_id,
+          "catalog": _choice_catalog_sha(), "token": secrets.token_hex(8)}
+    if aborted:
+        ex["aborted"] = list(aborted)
