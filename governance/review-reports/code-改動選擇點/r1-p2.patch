+def _choice_kill_guard(rr, rng, at_sha):
+    """守的測試 → _choice_guard 的 dict 或 rc 2:範圍沒碰到進行中計劃(沒規格判不了)、沒有可守的測試、run_cmd 沒有 {method}(S10)。"""
+    say = _situation_rule_say
+    guard, why = _choice_guard(rr, rng, at_sha)
+    if why:
+        return say(f"碰到的計劃算不出來({_kill_esc(why)[:200]})")
+    if not guard["live"]:
+        return say("這次的改動沒碰到任何進行中計劃——沒規格就判不了選擇點要哪條需求守(若計劃存在但沒連到被改檔的家,補 lands_in 或連結)")
+    if not guard["tests"]:
+        return say("碰到的計劃沒有可守的測試條款(條款都是 [manual:]、[keeps],或綁的測試不在 kotlin-junit 平台)——這次的選擇點只能人驗")
+    plats = guard["pdata"]["platforms"]
+    for plat in sorted({t["plat"] for t in guard["tests"]}):
+        cmd = plats[plat].get("run_cmd")
+        if not isinstance(cmd, str) or "{method}" not in cmd:
+            key = f"platforms.{plat}.run_cmd" if guard["pdata"].get("multiplatform") else "test.run_cmd"
+            return say(f".lumos/config.json 的 {key} 要是含 {{method}} 的字串(只跑那一支測試);整套一起跑判不出是哪支守住這一行")
