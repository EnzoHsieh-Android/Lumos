+def _choice_kill_scan(rr, rng, at_sha, only):
+    """型錄與語法樹掃描 → 掃描結果(_choice_compute)或 rc:型錄缺檔提醒 rc 0;表壞、ast-grep 不在(S6)、算不出來、--only 不是有選擇點的行 rc 2。"""
+    say = _situation_rule_say
+    tables, why, missing = _choice_tables()
+    if missing:
+        print(f"提醒:{why},這次不檢查選擇點(工具鏈安裝不完整?)", file=sys.stderr)
+        return 0
+    if why:
+        return say(f"Kotlin 型錄的選擇點表{why}")
+    try:
+        res = _choice_compute(rr, rng, at_sha, tables)
+    except _ChoiceNoTool as e:
+        return say(f"ast-grep 不在({_kill_esc(str(e))[:160]}),選擇點算不出來;裝 ast-grep 後重跑(brew install ast-grep 或 pip install ast-grep-cli)")
+    except (_ChoiceUnverifiable, _KtSitUnverifiable, OSError, subprocess.TimeoutExpired) as e:
+        return say(f"選擇點算不出來({_kill_esc(str(e))[:160] or e.__class__.__name__})")
+    if only is not None and not any((x["file"], x["line"]) == only for x in res["lines"]):
+        return say(f"--only {_kill_esc(only[0])}:{only[1]} 不是這次範圍裡有選擇點的改到的行(lumos choice-points 看有哪些)")
+    return res
