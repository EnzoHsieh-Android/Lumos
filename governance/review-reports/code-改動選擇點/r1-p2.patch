+class _ChoiceKillRun:
+    """choice-kill 一次呼叫的批次(〈用詞〉殺掉判定):組配方、交 cmd_guard_kill 跑、逐列收(on_row)、判定完整的壞法當場記帳、
+    中斷(defer 模式的兩段式訊號)與總時限停在配方之間。"""
+
+    def __init__(self, env, rr, head, guard, idx, tests_sha, max_seconds):
+        import time as _t
+        import uuid as _uuid
+        self.env, self.rr, self.head, self.guard, self.tests_sha = env, rr, head, guard, tests_sha
+        self.t0, self.max_seconds = _t.monotonic(), max_seconds
+        self.run_id = _uuid.uuid4().hex[:12]
+        self.stats = {"killed": 0, "survived": 0, "no_result": 0}
+        self.attempts = {k: len(v) for k, v in idx.items()}
+        self.plan_of, self.recipes, self.rid_map, self.orders = {}, [], {}, {}
+        self.halted, self.interrupted, self.wrote_fail = False, False, 0
+        self.out = sys.stdout
+        self.node = sorted({p for t in guard["tests"] for p in t["plans"]})[0]
+
+    def add(self, x):
+        """一行的壞法 → 每支守的測試一條臨時配方(invariant <定位>|<測試名>、platform 帶那支測試的平台、group <定位>);
+        檔不在那個平台所在 repo 的測試直接記一列 error。"""
+        loc = f"{x['file']}:{x['line']}"
+        ident = x["mutant"]["identity"]
+        if x["file"] not in self.orders:
+            self.orders[x["file"]] = _choice_test_order(self.guard, x["file"])
+        order = self.orders[x["file"]]
+        p = self.plan_of[loc] = {"x": x, "order": [(t["plat"], t["name"]) for t in order],
+                                 "tests": {(t["plat"], t["name"]): t for t in order}, "rows": {}, "done": False}
+        plats, ctx = self.guard["pdata"]["platforms"], {"tops": {}}
+        for t in order:
+            top, terr = _kill_plat_top(ctx, plats[t["plat"]]["root"])
+            src = os.path.join(os.path.realpath(str(self.rr)), x["file"])
+            kfile = os.path.relpath(src, os.path.realpath(str(top))).replace(os.sep, "/") if top is not None else ".."
+            if kfile.startswith(".."):
+                p["rows"][(t["plat"], t["name"])] = {"verdict": "error", "weak": False, "compile_error": False, "weak_why": [],
+                                                     "detail": f"這支檔不在平台 {t['plat']} 所在的 repo 裡({terr or ''})", "fail_excerpt": ""}
+                continue
+            self.recipes.append({"invariant": f"{loc}|{t['name']}", "test": t["name"], "platform": t["plat"], "file": kfile,
+                                 "old": ident["old"], "new": ident["new"], "group": loc, "note": "改動選擇點(lumos choice-kill)",
+                                 **({"also": x["mutant"]["also"]} if x["mutant"].get("also") else {})})
+
+    def finish(self, loc):
+        """一個壞法判定完整 → 判(_choice_kill_judge)、記一筆 choice-kill、印一行。"""
+        p = self.plan_of[loc]
+        if p["done"]:
+            return
+        p["done"] = True
+        x = p["x"]
+        verdict, kt, why, excerpt, aborted = _choice_kill_judge(p["order"], p["rows"])
+        self.stats[verdict] += 1
+        key = (x["file"], x["fp"])
+        self.attempts[key] = self.attempts.get(key, 0) + 1
+        k = p["tests"].get(kt) if kt else None
+        reason = (why + ((":" + " ".join(excerpt.split())) if excerpt else "")) if verdict == "no_result" else ""
+        extra = _choice_event_extra(x["mutant"]["identity"], verdict, k["name"] if k else "", k["clauses"] if k else [],
+                                    [q[:-3] for q in self.guard["live"]], self.tests_sha, reason, "run", self.attempts[key], self.run_id,
+                                    aborted=[n for _p, n in aborted])
+        self.wrote_fail += 0 if _choice_record(self.rr, self.head, extra) else 1
+        shown = {"killed": f"殺掉 by {k['name']}({'、'.join(k['clauses'])})" if k else "殺掉",
+                 "survived": "存活:沒有測試守著這個選擇", "no_result": f"跑不出結果:{_kill_esc(reason)[:160]}"}[verdict]
+        ab = f"(基準不綠沒跑:{'、'.join(n for _p, n in aborted)})" if aborted else ""
+        print(f"  {_kill_esc(loc)}  {x['mutant']['row']}  {shown}{ab}", file=self.out)
+        self.out.flush()
+
+    def on_row(self, row):
+        """cmd_guard_kill 每條配方結束交出的列:依 recipe_id 對回壞法;有決定性的結果(強 killed、編不過、逾時)就當場判——同組其餘配方
+        一定略過,不等它們的列(總時限在中間停時也記得到);每支測試都有列了也判。"""
+        hit = self.rid_map.get(row.get("recipe_id"))
+        if hit is None:
+            return
+        loc, tk = hit
+        p = self.plan_of[loc]
+        p["rows"][tk] = row
+        decisive = row.get("compile_error") or row["verdict"] == "timed_out_weak" or (row["verdict"] == "killed" and not row.get("weak"))
+        if decisive or len(p["rows"]) >= len(p["order"]):
+            self.finish(loc)
+
+    def stop(self, st):
+        """should_stop:收到第一個中斷訊號、或總時限到了 → 停在配方之間。"""
+        import time as _t
+        if st.got or _t.monotonic() - self.t0 >= self.max_seconds:
+            self.halted = True
+        return self.halted
+
+    def run(self):
+        """跑:沒有配方的壞法(每支測試都不在平台 repo 裡)直接判;其餘一次 cmd_guard_kill(guard kill 的逐條輸出收起來);呼叫正常結束還沒判的
+        壞法(有測試沒有列,例:還原失敗後同組作廢)→ 缺結果照記;被中斷或時限到了的不記。"""
+        import contextlib
+        import io
+        rel = self.env.find(self.node[:-3]) or self.node
+        self.rid_map = {_kill_recipe_id(str(rel), r): (r["group"], (r["platform"], r["test"])) for r in self.recipes}
+        with _situation_rule_signals(hint="收到中斷:正在跑的那條配方跑完就停;再按一次 Ctrl-C(或再送一次終止訊號)強制結束",
+                                     force_msg="強制結束(第二個終止訊號):測試的程序群組已收掉;沒判完的壞法沒記帳") as st:
+            st.defer = True
+            for loc in [q for q, p in self.plan_of.items() if len(p["rows"]) >= len(p["order"])]:
+                self.finish(loc)
+            if self.recipes:
+                with contextlib.redirect_stdout(io.StringIO()):
+                    cmd_guard_kill(self.env, self.node[:-3], recipes_override=self.recipes, source=_CHOICE_KILL_GATE,
+                                   stop_group_on=_CHOICE_STOP_ON, on_row=self.on_row, should_stop=lambda: self.stop(st))
+            self.interrupted = bool(st.got)
+        for loc in [q for q, p in self.plan_of.items() if not self.halted and not p["done"] and p["rows"]]:
+            self.finish(loc)
+
+
+def _choice_kill_report(kr, res, rr, at_sha, carried, nu, left, done, max_mutants, max_seconds):
+    """choice-kill 收尾:記一筆 run(_gate_event_fit 縮 tests 清單)、印帶過去的行與不唯一的行、統計與下一步 → rc(〈範圍〉2 rc 取最大)。"""
+    import secrets
+    import time as _t
+    unrun = sum(1 for p in kr.plan_of.values() if not p["done"]) + left
+    secs = int(_t.monotonic() - kr.t0)
+    rx = {"run_id": kr.run_id, "changed": res["changed"], "points": sum(1 for x in res["lines"] if x["status"] != "arid"),
+          "mutant_lines": sum(1 for x in res["lines"] if x["mutant"] is not None), "ran": sum(kr.stats.values()), "counts": dict(kr.stats),
+          "secs": secs, "ast_grep": res["ast_grep"], "tests": _choice_test_blobs(rr, at_sha, [t["name"] for t in kr.guard["tests"]]),
+          "interrupted": kr.interrupted, "tests_sha": kr.tests_sha, "token": secrets.token_hex(8)}
+    st = kr.stats
+    note = f"choice-kill 跑了 {rx['ran']} 個壞法(殺掉 {st['killed']}、存活 {st['survived']}、跑不出結果 {st['no_result']})"
+    nodes = _gate_event_fit(rr, _CHOICE_KILL_GATE, "run", note, rx, "tests", head_sha=kr.head)
+    if _gate_event(rr, _CHOICE_KILL_GATE, "run", note, hard=False, head_sha=kr.head, nodes=nodes, extra=rx) is not True:
+        print("⚠ 治理帳寫不進去(這次呼叫的 run 那筆沒記到)", file=sys.stderr)
+        kr.wrote_fail += 1
+    for (f, _fp), v in sorted(carried.items()):
+        print(f"  {_kill_esc(f)}  上次{'存活' if v == 'survived' else '跑不出結果'}、守的測試沒變,這次不重跑(補測試或改綁後會自動重跑;要人處置見 lumos choice-points)")
+    for x in nu:
+        print(f"  {_kill_esc(x['file'])}:{x['line']}  不唯一(前後各 2 行都相同,old 帶不出唯一的一段)——不跑;要放行:"
+              f"lumos lint-waive choice:{_kill_esc(x['file'])}:{x['line']} --note \"不適用:<理由>\"")
+    if kr.interrupted:
+        print(f"中斷:判定完整的壞法已記帳,還有 {unrun} 個沒跑(rc 2)", file=sys.stderr)
+    elif unrun:
+        print(f"還有 {unrun} 個沒跑(--max-mutants {max_mutants}、--max-seconds {int(max_seconds)}),再跑一次 lumos choice-kill")
+    print(f"統計:改到的行 {res['changed']}、有壞法的行 {rx['mutant_lines']}、這次跑 {rx['ran']} 個(殺掉 {st['killed']}、存活 {st['survived']}、"
+          f"跑不出結果 {st['no_result']})、已有有效處置 {done} 行、耗時 {secs} 秒")
+    print(f"下一步:提交治理帳({GOV_LOG_REL};推送閘只讀被推送版本的帳)")
+    surv = st["survived"] + sum(1 for v in carried.values() if v == "survived")
+    nores = st["no_result"] + sum(1 for v in carried.values() if v == "no_result")
+    if surv:
+        print("有存活:規格沒寫 → lumos situation-rule --point <檔>:<行> …;測試太弱 → 補測試後重跑;換了一樣、不是需求、壞法不適用 → "
+              "lumos lint-waive choice:<檔>:<行> --note \"<等價|不是需求|不適用>:<理由>\"")
+    return 2 if (nores or nu or unrun or kr.interrupted or kr.wrote_fail) else (1 if surv else 0)
+
+
+def cmd_choice_kill(env, diff=None, branch=None, only=None, max_mutants=_CHOICE_MAX_MUTANTS, max_seconds=_CHOICE_MAX_SECONDS):
+    """lumos choice-kill(〈範圍〉2):對還沒有有效處置的行,把挑到的壞法批次交 cmd_guard_kill 跑碰到的進行中計劃綁的測試、逐筆記治理帳。
+    跑之前(_choice_kill_base、_choice_kill_scan、_choice_kill_guard):參數、範圍右端是 HEAD、工作目錄乾淨、ast-grep 在、碰到進行中計劃、
+    有可守的測試、run_cmd 有 {method}、Android 的 run_cmd 跑得了單支(同人裁那一道)。挑哪些行(_choice_kill_pick):沒紀錄或過期的先,
+    survived 與 no_result 只在守的測試變了才重跑,--only 不受這條限制;--max-mutants 截。
+    rc 取最大:全部有效處置 0;有存活 1;有 no_result、不唯一、沒跑完或中斷 2;跑之前的檢查不過 2(不跑)。不寫計劃、不改程式。"""
+    base = _choice_kill_base(env, diff, branch, only, max_mutants, max_seconds)
+    if isinstance(base, int):
