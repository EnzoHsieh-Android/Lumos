+    parts = rel.split("/")
+    for i in range(len(parts) - 2):
+        if parts[i] == "src":
+            ss = parts[i + 1]
+            if ss.endswith("Test") or ss.startswith("test") or ss == "sharedTest":
+                return True
+    return any(x in ("testing", "test-utils") for x in parts[:-1])
