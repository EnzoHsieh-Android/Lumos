+def _situation_rule_clause_line(text, cid):
+    """計劃裡條款 cid 的定義行(沒有、重複或被遮回 None)。"""
+    lines = _note_lines(text)
+    row = next((r for r in clause_bindings(text, {}, None, lambda _p: set(), lambda _p: "")
+                if r.get("defined") and r["id"] == cid and r.get("state") not in ("duplicate", "shadowed")), None)
+    return lines[row["line"] - 1] if row and 0 < row["line"] <= len(lines) else None
