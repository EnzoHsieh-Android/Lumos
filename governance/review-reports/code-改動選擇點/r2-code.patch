+def _choice_test_blobs(rr, at_sha, names, deadline=None):
+    """守的測試所在檔的物件編號 → ([[測試名, 所在檔的物件編號]…], 每支都查完了嗎)。測試名在被讀版本的樹裡第一支含它的檔(git grep -F),
+    找不到記空字串;deadline 給了就共用那個時限(_lens_git_dl;choice-kill 的總時限,代碼審 code-改動選擇點 r1 r4:原本在總時限外每支
+    各 20 秒),時限用完剩下的記空字串、第二個值 False。run 那筆的 tests 欄與守的測試雜湊(_choice_tests_sha)都用這份。"""
+    out, complete = [], True
+    for n in sorted(set(names)):
+        blob = ""
+        r = _lens_git_dl(rr, "grep", "-l", "-F", "-e", n, at_sha, "--", deadline=deadline)
+        if r is None:
+            complete = False
+        hit = (r.stdout.splitlines()[0] if r is not None and r.returncode == 0 and r.stdout.strip() else "")
+        if hit:
+            b = _lens_git_dl(rr, "rev-parse", hit, deadline=deadline)
+            blob = b.stdout.strip() if b is not None and b.returncode == 0 else ""
+            complete = complete and b is not None
+        out.append([n, blob])
+    return out, complete
+
