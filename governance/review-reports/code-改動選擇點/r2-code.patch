+def _choice_ledger_status(repo_root, at_sha, keys, rng=None):
+    """choice-points 印的帳上狀態(〈範圍〉1):{(檔, 行指紋): 狀態字}。讀工作目錄的版控治理帳與放行檔(同 choice-kill;推送前那一道才讀被推版本),
+    判法同推送前那一道(_choice_disposition);過期要被讀版本所有計劃綁的測試(_choice_guard 的 bound),算不出來時殺掉照印殺掉。
+    帳或放行檔讀不了 → 每一行都印「帳讀不了」。不在字典裡的行 = 沒跑。"""
+    if not keys:
+        return {}
+    evs, gerr = _gov_vc_gate_events(repo_root, _CHOICE_KILL_GATE)
+    waivers, werr = _lint_waivers_load(repo_root)
+    if gerr or werr:
+        return {k: "帳讀不了" for k in keys}
+    idx, wk = _choice_ledger_index(evs), _choice_waived_keys(waivers)
+    bound = None
+    if rng:
+        try:
+            guard, _why = _choice_guard(Path(repo_root), rng, at_sha)
+        except (_KtSitUnverifiable, ValueError, OSError, subprocess.TimeoutExpired):
+            guard = None
+        bound = guard["bound"] if guard else None
+    out = {}
+    for k in keys:
+        evs_k = idx.get(k) or []
+        disp = _choice_disposition(evs_k, k in wk, bound if bound is not None else {str(e.get("killing_test")) for e in evs_k})
+        if disp == "killed":
+            last = evs_k[-1]
+            out[k] = f"殺掉 by {_kill_esc(str(last.get('killing_test')))}({'、'.join(_kill_esc(str(c)) for c in last.get('clauses') or [])})"
+        elif disp is not None:
+            out[k] = {"waived": "已放行", "stale": "過期(殺掉它的測試已沒有條款綁)", "survived": "存活", "no_result": "跑不出結果"}[disp]
+    return out
