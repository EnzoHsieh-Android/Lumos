+def _choice_scan_one(exe, cfg, tmp, name, rel, text, timeout):
+    """_choice_scan 的一支檔:跑 ast-grep、讀輸出 → 那支檔的 {"choice", "arid", "error"};算不出來 raise _ChoiceUnverifiable。"""
+    out_path = Path(tmp) / "out.json"
+    try:
+        rc = _choice_sg_run([exe, "scan", "--config", cfg, "--json=stream", f"src/{name}"], tmp, str(out_path), timeout)
+        if rc is None:
+            raise _ChoiceUnverifiable(f"ast-grep 掃描超過 {int(timeout)} 秒")
+        if rc not in (0, 1):
+            raise _ChoiceUnverifiable(f"ast-grep 掃描回 {rc}")
+        if out_path.stat().st_size > _LINT_SARIF_MAX_BYTES:
+            raise _ChoiceUnverifiable("ast-grep 輸出超過讀取上限")
+        raw = out_path.read_text(encoding="utf-8", errors="replace")
+    finally:
+        out_path.unlink(missing_ok=True)
+    return _choice_scan_parse(raw, {name: rel}, {rel: text})[rel]
+
