+        kw["nodes"] = _gate_event_fit(rr, _CHOICE_KILL_GATE, kind, note, extra, list_key, hard=kw.get("hard", False),
+                                      head_sha=kw.get("head_sha"), nodes=kw.get("nodes"))
+    ok = _gate_event_or_warn(rr, _CHOICE_KILL_GATE, kind, note, extra=extra, **kw)
+    if ok is False:
+        print(f"  ⚠ 沒記到的是:{what}", file=sys.stderr)
+    return ok is not False
