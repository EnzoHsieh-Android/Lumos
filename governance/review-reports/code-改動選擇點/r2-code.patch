+def _choice_scan(repo_root, texts, timeout):
+    """{檔: 文字} → ({檔: {"choice": [命中…], "arid": [(起, 迄)…], "error": [(起, 迄)…]}}, ast-grep 版本, {檔: 算不出來的原因})。
+    檔寫進 tempfile.TemporaryDirectory(檔名用序號加 .kt,不用 repo 路徑,收尾一定刪),★按檔分開★以參數清單各跑一次
+    `ast-grep scan --config <設定> --json=stream <那支檔>`:一支檔逾時、rc 異常、輸出超過讀取上限或剖不了,只把那支檔記進第三個值、
+    不放進第一個值,其他檔照判(代碼審 code-改動選擇點 r1 r1/b12:原本整批一次跑,一支長函式讓整次推送全部算不出來;ast-grep 官方
+    建議大量命中用 --json=stream 逐筆讀 https://ast-grep.github.io/guide/tools/json.html)。timeout 是整批的總時限,每支檔用剩下的時間;
+    用完後還沒掃的檔記「超過時限」。設定路徑經 _lint_wt_cfg_inside 限定在工具鏈 configs/ast-grep/ 底下,不帶 -U、-i、--custom-languages。
+    工具照 _lint_wt_resolve_tool 解成 PATH 上的絕對路徑(不吃 repo 裡的同名檔);子程序在工作樹模式(_lint_wt_begin)裡跑、暫存目錄登記成
+    work,SIGTERM 時一起收(_lint_wt_reap)。rc 0 與 1 都算掃完(同 check.py)。
+    命中:{"rule", "s", "e"(UTF-8 位元組位移), "line", "end_line"(1 起算), "mv": {名: (起, 迄, 原文)}}。
+    工具不在 → raise _ChoiceNoTool;設定不在工具鏈底下 → raise _ChoiceUnverifiable(整批都算不出來)。"""
+    import tempfile
+    exe, why = _lint_wt_resolve_tool("ast-grep", repo_root)
+    if exe is None:
+        raise _ChoiceNoTool(why)
+    root = _kt_toolchain_root()
+    cfg, why = _lint_wt_cfg_inside(str(root / _CHOICE_CFG_REL), root)
+    if cfg is None or not Path(cfg).is_file():
+        raise _ChoiceUnverifiable(why or f"選擇點規則設定不在({root / _CHOICE_CFG_REL})")
+    deadline = time.monotonic() + timeout
+    res, bad = {}, {}
+    own = _LINT_WT_REG is None
+    if own:
+        _lint_wt_begin()
+    try:
+        with tempfile.TemporaryDirectory(prefix="lumos-choice-") as tmp:
+            if own:
+                _LINT_WT_REG["work"] = tmp
+            src = Path(tmp) / "src"
+            src.mkdir()
+            version = _choice_sg_version(exe, tmp, min(timeout, 30))
+            for i, (rel, text) in enumerate(sorted(texts.items())):
+                left = deadline - time.monotonic()
+                if left <= 0:
+                    bad[rel] = f"ast-grep 掃描超過 {int(timeout)} 秒(這支檔沒掃到)"
+                    continue
+                name = f"{i}.kt"
+                (src / name).write_bytes(text.encode("utf-8"))
+                try:
+                    res[rel] = _choice_scan_one(exe, cfg, tmp, name, rel, text, left)
+                except _ChoiceUnverifiable as e:
+                    bad[rel] = str(e)
