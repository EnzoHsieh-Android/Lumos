+def _choice_changed(repo_root, rng, at_sha, deadline=None):
+    """範圍內 .kt 正式碼的改到的行 → ({檔: {"text": 被讀版本全文, "lines": [行號…]}}, 超過讀檔上限沒掃的檔清單)。
+    hunk 走 _kt_sit_hunks(只 *.kt、整檔刪除不收);路徑照 _kt_sit_path_ok(帶 _vendored_skip)與 _choice_is_test(版面照 at_sha 那棵樹);
+    只改空白的增行與 import/package 行沿用 _kt_sit_hits 的過濾;單檔超過 _KT_SIT_READ_MAX 先用 _nodehome_cat_sizes 篩掉、列出、不掃。
+    git 讀不到 → raise _KtSitUnverifiable。"""
+    hunks = _kt_sit_hunks(repo_root, rng)
+    vend = _vendored_skip(repo_root, rng)
+    lst = _drift_list(repo_root, at_sha)
+    layout = _nodehome_layout(lst[1]) if lst else ({}, {})
+    todo = [rel for rel in sorted(hunks) if any(adds for adds, _d in hunks[rel])
+            and _kt_sit_path_ok(rel, vend) and not _choice_is_test(rel, layout)]
+    big = []
+    if todo:
+        sizes = _nodehome_cat_sizes(repo_root, [f"{at_sha}:{r}" for r in todo], timeout=_git_timeout(deadline, cap=_disp_git_timeout()))
+        if sizes is None:
+            raise _KtSitUnverifiable(f"git cat-file 讀不到 {str(at_sha)[:12]} 的檔大小")
+        big = [r for r, n in zip(todo, sizes) if n is not None and n > _KT_SIT_READ_MAX]
+        todo = [r for r in todo if r not in big]
+    texts = _kt_sit_read_many(repo_root, at_sha, todo, deadline=deadline)
+    out = {}
+    for rel in todo:
+        text = texts[rel]
+        stripped = _strip_c_comments(text, blank_strings=True, keep_length=True, kotlin=True).split("\n")
+        lines = sorted({ln for h in hunks[rel] for ln, _g in _kt_sit_hits(h, stripped, _CHOICE_ANY_RX)})
+        if lines:
+            out[rel] = {"text": text, "lines": lines}
+    return out, big
