+def _choice_sg_version(exe, tmp, timeout):
+    """ast-grep --version → 版本字串(記進每筆 run;讀不到回空字串)。"""
+    ver_out = Path(tmp) / "version.txt"
+    if _choice_sg_run([exe, "--version"], tmp, str(ver_out), timeout) != 0:
+        return ""
+    m = re.search(r"\d+(?:\.\d+)+", ver_out.read_text(encoding="utf-8", errors="replace"))
+    return m.group(0) if m else ""
