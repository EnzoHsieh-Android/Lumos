+# 乾節點規則(論文 3.1、附錄 A):命中節點的範圍內不產生壞法;列號對應型錄〈乾節點規則〉
+id: A-1
+language: kotlin
+severity: hint
+message: log(論文附錄 A.1.1)
+rule:
+  kind: call_expression
+  any:
+    - regex: '^(Log|Timber|logger|log)\s*\.'
+    - regex: '^(println|print)\s*\('
+    - regex: '\.\s*printStackTrace\s*\(\s*\)$'
+---
+id: A-2
+language: kotlin
+severity: hint
+message: 斷言與前置條件(論文附錄 A.1.5)
+rule:
+  kind: call_expression
+  regex: '^(require|check|assert|requireNotNull|checkNotNull|error)\s*[({]'
+---
+id: A-3
+language: kotlin
+severity: hint
+message: 除錯旗標(論文附錄 A.1.5 除錯碼)
+rule:
+  any:
+    - kind: navigation_expression
+      regex: '^BuildConfig\s*\.\s*DEBUG$'
+    - kind: if_expression
+      has: {field: condition, regex: '^BuildConfig\s*\.\s*DEBUG$'}
+---
+id: A-4
+language: kotlin
+severity: hint
+message: 時間(論文附錄 A.1.4)
+rule:
+  kind: call_expression
+  regex: '^(delay|withTimeout|withTimeoutOrNull)\s*[({]'
+---
+id: A-5
+language: kotlin
+severity: hint
+message: 監控與追蹤(論文附錄 A.1.3)
+rule:
+  kind: call_expression
+  regex: '^(Trace|FirebaseAnalytics|FirebaseCrashlytics|analytics)\s*\.'
+---
+id: A-6
+language: kotlin
+severity: hint
+message: 容量預配(論文附錄 A.1.2)
+rule:
+  kind: value_argument
+  has:
+    any:
+      - kind: integer_literal
+      - kind: additive_expression
+      - kind: multiplicative_expression
+  all:
+    - nthChild: {position: 1}
+    - nthChild: {position: 1, reverse: true}
+  inside:
+    kind: value_arguments
+    inside:
+      kind: call_suffix
+      inside:
+        kind: call_expression
+        has: {kind: simple_identifier, regex: '^(ArrayList|HashMap|StringBuilder)$'}
+---
+id: A-7
+language: kotlin
+severity: hint
+message: 樣板方法(論文附錄 A.1.21)
+rule:
+  kind: function_body
+  inside:
+    kind: function_declaration
+    all:
+      - has: {kind: modifiers, regex: '\boverride\b'}
+      - has: {kind: simple_identifier, regex: '^(equals|hashCode|toString)$'}
+---
+id: A-8
+language: kotlin
+severity: hint
+message: 與 null 比較(論文附錄 A.1.10)
+rule:
+  kind: equality_expression
+  has: {kind: null_literal}
+---
+id: A-9
+language: kotlin
+severity: hint
+message: 集合大小與 0 比較(論文附錄 A.1.20)
+rule:
+  any:
+    - kind: comparison_expression
+    - kind: equality_expression
+  all:
+    - has: {kind: navigation_expression, regex: '\.\s*(size|length)$'}
+    - has: {kind: integer_literal, regex: '^0$'}
+---
+id: A-10
+language: kotlin
+severity: hint
+message: 提早回傳空容器(論文附錄 A.1.22)
+rule:
+  kind: if_expression
+  regex: '^if\s*\(\s*[\w.?!]+\s*\.\s*isEmpty\s*\(\s*\)\s*\)\s*\{?\s*return\s+(emptyList\(\)|emptyMap\(\)|emptySet\(\)|listOf\(\)|mapOf\(\)|setOf\(\)|"")\s*\}?$'
+---
+id: A-11
+language: kotlin
+severity: hint
+message: 取界(論文附錄 A.1.24)
+rule:
+  kind: value_arguments
+  inside:
+    kind: call_suffix
+    inside:
+      kind: call_expression
+      any:
+        - has: {kind: simple_identifier, regex: '^(minOf|maxOf|coerceIn|coerceAtLeast|coerceAtMost)$'}
+        - has:
+            kind: navigation_expression
+            has: {kind: navigation_suffix, regex: '^(\?\.|\.)\s*(coerceIn|coerceAtLeast|coerceAtMost)$'}
+---
+id: A-12
+language: kotlin
+severity: hint
+message: 浮點與字面值比較(論文附錄 A.1.11)
+rule:
+  kind: comparison_expression
+  has: {kind: real_literal}
+---
+id: A-13
+language: kotlin
+severity: hint
+message: 資料流 flush/close(論文附錄 A.1.15)
+rule:
+  kind: call_expression
+  inside: {kind: statements}
+  regex: '\.\s*(flush|close)\s*\(\s*\)$'
+---
+id: A-14
+language: kotlin
+severity: hint
+message: 依賴注入(論文附錄 A.3.2)
+rule:
+  any:
+    - kind: class_body
+      inside:
+        kind: class_declaration
+        has:
+          kind: modifiers
+          has: {kind: annotation, regex: '^@(dagger\.)?Module\b'}
+    - kind: function_body
+      inside:
+        kind: function_declaration
+        has:
