+def _choice_push_judge(lines, idx, waived, bound, cap):
+    """每一行要處置的行(挑到壞法或不唯一)→ ({原因: [行…]}, 沒抽中的存活行, 曾經存活的行數)。放行過的不算;有效處置(killed 而殺掉它的測試仍被
+    條款綁著)不算;不唯一沒放行、同鍵最新一筆缺、過期、no_result → 擋;survived 只擋回報上限抽中的(_choice_cap_pick)。
+    ★放行過的行也進種子集合★(〈用詞〉回報上限:「曾經存活過的行」是帳上同鍵有任一筆 survived,已處置的仍算處置),只在「要不要擋」排除:
+    放行一行不會讓抽中的那批重洗(代碼審 code-改動選擇點 r1 k1、b31、g2、c32);第三個值是真的曾經存活數(b32 原本印成抽中數)。"""
+    by = {r: [] for r in _CHOICE_PUSH_REASONS}
+    survivors, ever = [], set()
+    for x in lines:
+        if x["status"] not in ("mutant", "not_unique"):
+            continue
+        key = (x["file"], x["fp"])
+        evs = idx.get(key) or []
+        if any(e.get("verdict") == "survived" for e in evs):
+            ever.add(key)
+        if key in waived:
+            continue
+        if x["status"] == "not_unique":
+            by["不唯一"].append(x)
+            continue
+        disp = _choice_disposition(evs, False, bound)
+        if disp == "killed":
+            continue
+        if disp == "survived":
+            survivors.append(x)
+            continue
+        by[{None: "缺紀錄", "stale": "過期", "no_result": "跑不出結果"}[disp]].append(x)
+    picked = _choice_cap_pick(ever, cap)
+    unpicked = []
+    for x in survivors:
+        (by["存活"] if (x["file"], x["fp"]) in picked else unpicked).append(x)
+    return by, unpicked, len(ever)
+
