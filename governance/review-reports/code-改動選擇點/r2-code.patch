+def _choice_record(rr, head, extra):
+    """記一筆 choice-kill 判定 → True 沒有寫失敗 / False 寫不進去(已印;_choice_gate_event)。aborted 清單交 _gate_event_fit 縮(r1 g5)。"""
+    note = f"選擇點 {extra['file']} {extra['row']} {extra['verdict']}"
+    return _choice_gate_event(rr, _CHOICE_KILL_GATE, note, f"choice-kill {_kill_esc(extra['file'])} {extra['verdict']} 這一行的判定",
+                              list_key="aborted", hard=False, head_sha=head, nodes=[], extra=extra)
