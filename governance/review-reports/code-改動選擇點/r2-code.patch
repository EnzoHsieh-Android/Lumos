+def _choice_test_order(guard, rel):
+    """這支被改檔的守的測試排序(〈用詞〉守的測試排序):先放「計劃的 lands_in 或連結指到這支檔的家」的計劃所綁的,再依計劃名、條款順序。"""
+    tenv = guard["tenv"]
