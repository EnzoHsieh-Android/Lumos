+    systems = {s[:-3] if s.endswith(".md") else s for s in homes.get(_nodehome_key(rel), [])}
+    near = {p for p in guard["live"] if set(_plan_system_links(tenv.notes.get(p), text=env_text(tenv, p) or "", systems_only=False)) & systems}
+    return sorted(guard["tests"], key=lambda t: min((0 if p in near else 1, p, n) for p, n in t["keys"]))
