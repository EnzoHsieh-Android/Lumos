+def _choice_sg_run(argv, cwd, out_path, timeout):
+    """跑一次 ast-grep(參數清單、不開 shell、新程序群組)→ rc 或 None(逾時)。開程序走 _lint_spawn(標準輸出接到 out_path、
+    工作樹模式時登記進程序群組);逾時整組收掉(_kill_proc_group);收尾從登記拿掉。"""
+    proc = _lint_spawn(None, cwd, out_path=out_path, argv=argv)
+    if proc is None:
+        raise _ChoiceNoTool("ast-grep 開不起來")
+    try:
+        proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        _kill_proc_group(proc)
+        proc.wait()
+        return None
+    except BaseException:
+        _kill_proc_group(proc)
+        raise
+    finally:
+        _lint_wt_unregister(proc)
+    return proc.returncode
