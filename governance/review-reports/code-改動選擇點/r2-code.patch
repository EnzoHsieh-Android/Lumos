+def _choice_scan_parse(raw, names, texts):
+    """ast-grep 的 --json=stream 輸出(一行一個 JSON)→ {檔: {"choice", "arid", "error"}};行號 0 起算換成 1 起算。剖不了 → raise _ChoiceUnverifiable。"""
+    import json as _json
+    res = {rel: {"choice": [], "arid": [], "error": []} for rel in texts}
+    for ln in raw.splitlines():
+        if not ln.strip():
+            continue
+        try:
+            d = _json.loads(ln)
+            rel = names[Path(d["file"]).name]
+            rg = d["range"]
+            hit = {"rule": str(d["ruleId"]), "s": int(rg["byteOffset"]["start"]), "e": int(rg["byteOffset"]["end"]),
+                   "line": int(rg["start"]["line"]) + 1, "end_line": int(rg["end"]["line"]) + 1,
+                   "mv": {k: (int(v["range"]["byteOffset"]["start"]), int(v["range"]["byteOffset"]["end"]), str(v["text"]))
+                          for k, v in ((d.get("metaVariables") or {}).get("single") or {}).items()}}
+        except (ValueError, KeyError, TypeError, AttributeError) as e:
+            raise _ChoiceUnverifiable(f"ast-grep 輸出剖不了({e.__class__.__name__})") from None
+        if hit["rule"] == _CHOICE_SYNTAX_RULE:
+            res[rel]["error"].append((hit["s"], hit["e"]))
+        elif hit["rule"].startswith("A-"):
+            res[rel]["arid"].append((hit["s"], hit["e"]))
+        else:
+            res[rel]["choice"].append(hit)
+    return res
+
+
+def _choice_anchor(b, hit, row):
+    """命中節點 → (錨點位移, 運算子 (起, 迄) 或 None)。錨點照那一列的錨點欄:運算子(二元運算是兩個運算元之間跳過空白與註解後的運算子,
+    前綴 ! 是節點開頭)、運算元起始與陳述起始是節點開頭、方法名是 navigation_suffix 裡跳過 ?. 或 . 之後的識別字。對不上回 (None, None)。"""
+    mv = hit["mv"]
+    if row["anchor"] == "方法名":
+        m = re.match(rb"(\?\.|\.)\s*([A-Za-z_]\w*)", b[hit["s"]:hit["e"]])
+        return (hit["s"] + m.start(2), (hit["s"] + m.start(2), hit["s"] + m.end(2))) if m else (None, None)
+    if row["anchor"] == "運算子" and "A" in mv and "B" in mv:
+        gs, ge = mv["A"][1], mv["B"][0]
+        k = _CHOICE_GAP_SKIP_RE.match(b, gs, ge).end()   # 帶 pos 的 match:end() 是整份的位移
+        m = _CHOICE_OP_RE.match(b, k, ge)
+        return (k, (k, m.end())) if m else (None, None)
+    return hit["s"], None
+
+
+def _choice_line_index(b):
+    """位元組文字 → 每一行開頭的位移清單(給 bisect 換行號)。"""
+    starts, i = [0], b.find(b"\n")
+    while i >= 0:
+        starts.append(i + 1)
+        i = b.find(b"\n", i + 1)
+    return starts
+
+
+def _choice_ctx_safe(b, s, e):
+    """節點 [s, e) 放回原處時不用加括號:前一個非空白字元是 ( [ { , ; 或單獨的 =、-> 、檔頭,而且後一個非空白字元是 ) ] } , ; 、檔尾,
+    或隔了換行、下一行不是運算子開頭(Kotlin 換行結束陳述)。判不準的一律當要加括號(多加括號不改語意)。"""
+    pre = b[:s].rstrip()
+    ok_pre = (not pre or pre[-1:] in (b"(", b"[", b"{", b",", b";") or pre.endswith(b"->")
+              or (pre[-1:] == b"=" and pre[-2:-1] not in (b"=", b"!", b"<", b">"))
+              or re.search(rb"(?:^|[^\w])(?:return|throw|else|in)$", pre[-8:]) is not None)
+    post_raw = b[e:]
+    post = post_raw.lstrip()
+    nl = b"\n" in post_raw[:len(post_raw) - len(post)]
+    ok_post = (not post or post[:1] in (b")", b"]", b"}", b",", b";")
+               or (nl and not re.match(rb"[.?&|+\-*/%<>=!:]", post)))
+    return ok_pre and ok_post
+
+
+def _choice_top_level(text):
+    """去掉成對括號與字串內容後剩下的頂層字(_choice_atomic 與 _choice_top_prec 共用)。"""
+    s, depth, out, q = text.strip(), 0, [], None
+    for ch in s:
+        if q:
+            q = None if ch == q else q
+            continue
+        if ch == '"':
+            q = '"'
+        elif ch in "([{":
+            depth += 1
+        elif ch in ")]}":
+            depth -= 1
+        elif depth == 0:
+            out.append(ch)
+    return "".join(out)
+
+
+def _choice_top_prec(text):
+    """運算元頂層最鬆的運算子層級(_CHOICE_PREC);單一記號回 99;有表外的運算子(?:、..、as、in、is、中綴呼叫)回 0(一律加括號)。
+    開頭的前綴 - ! + 不算二元運算子。"""
+    top = _choice_top_level(text).lstrip("-!+ ")
+    if ".." in top:
+        return 0
+    if _CHOICE_ATOMIC_RE.fullmatch(top or "x"):
+        return 99
+    precs = []
+    for m in _CHOICE_OP_RE.finditer(top.encode("utf-8")):
+        precs.append(_CHOICE_PREC[m.group(0).decode("utf-8")])
+    rest = _CHOICE_OP_RE.sub(b" ", top.encode("utf-8")).decode("utf-8")
+    words = rest.split()
+    if len(words) != len(precs) + 1 or any(not _CHOICE_ATOMIC_RE.fullmatch(w) for w in words):
+        return 0
+    return min(precs) if precs else 99
+
+
+def _choice_atomic(text):
+    """替換文字不需要括號:去掉成對括號與字串內容後只剩識別字、點、?、!(呼叫、屬性、!! 都算)。"""
+    top = _choice_top_level(text)
+    return ".." not in top and bool(_CHOICE_ATOMIC_RE.fullmatch(top))   # a..b 是區間運算子,不是屬性鏈
+
+
+def _choice_excluded(row, hit):
+    """型別前提(論文 3.2.1 事前擋編不過的壞法;語法樹沒有型別,用語法情境近似)→ 這個節點的候選要不要排除。"""
+    pre = row["precondition"]
+    ops = [hit["mv"][k][2].strip() for k in ("A", "B") if k in hit["mv"]]
+    if pre == "運算元有 null 字面值":
+        return "null" in ops
+    if pre == "運算元是字串":
+        # 直接運算元是字串字面值或字串樣板,或這個 + 在一條頂層運算元有字串的 + 鏈上(_choice_str_chains 蓋的 strcat;代碼審 code-改動選擇點 r1 g3)
+        return bool(hit.get("strcat")) or any(x.startswith('"') for x in ops)
+    return False
+
+
+def _choice_plus_nodes(b, hits, rows):
+    """型別前提是「運算元是字串」而運算子是 + 的命中 → {(起, 迄): 命中}(_choice_str_chains 用)。"""
+    plus = {}
+    for h in hits:
+        row = rows.get(h["rule"])
+        if row is None or row.get("precondition") != "運算元是字串" or row.get("anchor") != "運算子":
+            continue
+        _a, op = _choice_anchor(b, h, row)
+        if op is not None and b[op[0]:op[1]] == b"+":
+            plus[(h["s"], h["e"])] = h
+    return plus
+
+
+def _choice_str_chains(b, hits, rows):
+    """字串串接的 + 鏈(〈用詞〉型別前提「運算元是字串」;論文 3.2.1 事前擋編不過的壞法)→ 要排除的 + 節點 {(起, 迄)}。
+    鏈:一個 + 節點的 $A 或 $B 範圍恰好是另一個 + 節點時連在一起(括號隔開的不連:`(a + b)` 是另一個運算式);鏈上不是 + 節點的運算元是
+    「頂層運算元」,任一個是字串字面值或字串樣板(開頭是 ")→ 整條鏈每個 + 都排除。只看直接運算元時 `name + ": " + id` 外層的
+    A 是 `name + ": "`、`f1 + id + "/"` 內層兩邊都是變數,會挑到編不過的 -、*、/、%(代碼審 code-改動選擇點 r1 g3、c13、b13)。
+    只收型別前提是「運算元是字串」而運算子是 + 的命中(運算子照 _choice_anchor 的運算子錨點切)。"""
+    plus = _choice_plus_nodes(b, hits, rows)
+    parent = {k: k for k in plus}
+
+    def find(k):
+        while parent[k] != k:
+            parent[k] = parent[parent[k]]
+            k = parent[k]
+        return k
+    for k, h in plus.items():
+        for name in ("A", "B"):
+            sub = h["mv"].get(name)
+            if sub is not None and (sub[0], sub[1]) in plus:
+                parent[find((sub[0], sub[1]))] = find(k)
+    stringy = set()
+    for k, h in plus.items():
+        for name in ("A", "B"):
+            sub = h["mv"].get(name)
+            if sub is not None and (sub[0], sub[1]) not in plus and sub[2].strip().startswith('"'):
+                stringy.add(find(k))
+    return {k for k in plus if find(k) in stringy}
+
+
+def _choice_edits(b, hit, row, op, tpl):
+    """一個候選壞法 → 編輯清單 [(起, 迄, 新位元組)] 或 None(這個節點產不出這個候選)。
+    二元運算換運算子:只換運算子記號(保留原排版),優先層級變了而外層是運算式時節點前後加括號;`$A`、`$B`、`true`、`false` 換掉整個節點
+    (不是單一記號又放在運算式裡時加括號);`!$X` 在節點前插 !;前綴 ! 的 `$B` 拿掉 !;(刪掉)刪整個陳述;API 換方法名,(拿掉呼叫)
+    刪掉 `.方法名()` 那一段。"""
+    s, e, mv = hit["s"], hit["e"], hit["mv"]
+    if tpl == "delete":
+        return [(s, e, b"")]
+    if row["anchor"] == "方法名":
+        return _choice_api_edits(b, s, e, op, tpl)
+    m = re.fullmatch(r"\$A (\S+) \$B", tpl)
+    if m and op is not None:
+        return _choice_swap_edits(b, hit, op, m.group(1))
+    if tpl == "!$X":
+        return [(s, s, b"!")]
+    if tpl == "$B" and "A" not in mv and "B" in mv:
+        return [(s, mv["B"][0], b"")]
+    text = tpl
+    for k in ("A", "B", "X"):
+        if "$" + k in text:
+            val = b[s:e].decode("utf-8") if k == "X" else (mv[k][2] if k in mv else None)
+            if val is None:
+                return None
+            text = text.replace("$" + k, val)
+    if not _choice_atomic(text) and not _choice_ctx_safe(b, s, e):
+        text = f"({text})"
+    return [(s, e, text.encode("utf-8"))]
+
+
+def _choice_api_edits(b, s, e, op, tpl):
+    """API 列:換方法名那個識別字;(拿掉呼叫)刪掉從 .方法名 到後面那對空括號(命中節點是 navigation_suffix,[s, e) 是它的範圍)。"""
+    if op is None:
+        return None
+    if tpl == "drop_call":
+        m = re.match(rb"\s*\(\s*\)", b[e:e + 200])
+        return [(s, e + m.end(), b"")] if m else None
+    return [(op[0], op[1], tpl.encode("utf-8"))]
+
+
+def _choice_swap_edits(b, hit, op, new_op):
+    """二元運算換運算子:只換運算子記號(保留原排版);層級變了時,運算元自己的頂層運算子綁得不比新運算子緊就加括號
+    (x + a * b 換成 / 不能變成 (x / a) * b;左運算元同層級照左結合不用加),外層是運算式時整個節點也加。"""
+    s, e, mv = hit["s"], hit["e"], hit["mv"]
+    old_op = b[op[0]:op[1]].decode("utf-8")
+    edits = [(op[0], op[1], new_op.encode("utf-8"))]
+    if _CHOICE_PREC.get(new_op) == _CHOICE_PREC.get(old_op):
+        return edits
+    lvl = _CHOICE_PREC[new_op]
+    for k, loose in (("A", _choice_top_prec(mv["A"][2]) < lvl), ("B", _choice_top_prec(mv["B"][2]) <= lvl)):
+        if loose:
+            edits += [(mv[k][0], mv[k][0], b"("), (mv[k][1], mv[k][1], b")")]
+    if not _choice_ctx_safe(b, s, e):
+        edits += [(s, s, b"("), (e, e, b")")]
+    return edits
+
+
+def _choice_fp(rel, lines, ln):
+    """行指紋(〈用詞〉):<檔> 加上那一行與前後各 2 行剝前後空白後的原文,sha256 前 16 碼;檔頭檔尾外的行當空字串。"""
+    import hashlib
+    win = [lines[i - 1].strip() if 1 <= i <= len(lines) else "" for i in range(ln - _CHOICE_FP_CTX, ln + _CHOICE_FP_CTX + 1)]
+    return hashlib.sha256((rel + "\0" + "\n".join(win)).encode("utf-8")).hexdigest()[:16]
+
+
+def _choice_identity(rel, text, fp, row, edits, line_of, ctx=None):
+    """壞法身分(〈用詞〉壞法身分;segment 2 的 choice-kill 用這支組殺傷力配方)→ {"file", "fp", "row", "old", "new", "new_sha"}
+    或 None(往外帶行到前後各 2 行仍不唯一)。old 是編輯落到的那幾行(運算子與 API 換記號時就是錨點那一行),整支檔不是恰好一次
+    (重疊的出現也算,_count_overlapping;代碼審 code-改動選擇點 r1 b11)時依序先往上一行、再往下一行輪流多帶;new 是 old 套上壞法;
+    換行都是 \\n。只在 old 可能用到的那幾行(前後各 _CHOICE_OLD_PAD 行)上套編輯,不複製整份檔(r1 r2)。
+    ctx:同一支檔共用的 {"b": 位元組, "lines": 行清單, "starts": 每行開頭位移};沒給就現算。"""
+    import hashlib
+    if ctx is None:
+        bb = text.encode("utf-8")
+        ctx = {"b": bb, "lines": text.split("\n"), "starts": _choice_line_index(bb)}
+    b, lines, starts = ctx["b"], ctx["lines"], ctx["starts"]
+    l1 = min(line_of(s) for s, _e, _r in edits)
+    l2 = max(line_of(max(s, e - 1)) for s, e, _r in edits)
+    w1, w2 = max(1, l1 - _CHOICE_OLD_PAD), min(len(lines), l2 + _CHOICE_OLD_PAD)
+    ws = starts[w1 - 1]
+    we = starts[w2] - 1 if w2 < len(starts) else len(b)
+    win = b[ws:we]
+    for s, e, rep in sorted(edits, key=lambda x: (x[0], x[1]), reverse=True):
+        win = win[:s - ws] + rep + win[e - ws:]
+    nwin = win.decode("utf-8").split("\n")
+    delta = len(nwin) - (w2 - w1 + 1)
+    tries = [(l1, l2)]
+    for k in range(1, _CHOICE_OLD_PAD + 1):
+        tries += [(l1 - k, l2 + k - 1), (l1 - k, l2 + k)]
+    seen = set()
+    for a, z in tries:
+        a, z = max(1, a), min(len(lines), z)
+        if (a, z) in seen:
+            continue
+        seen.add((a, z))
+        old = "\n".join(lines[a - 1:z])
+        if _count_overlapping(text, old, stop=2) == 1:
+            new = "\n".join(nwin[a - w1:z - w1 + 1 + delta])
+            return {"file": rel, "fp": fp, "row": row["id"], "old": old, "new": new,
+                    "new_sha": hashlib.sha256(new.encode("utf-8")).hexdigest()[:16]}
+    return None
+
+
+def _choice_also(text, row, b, op, new):
+    """API 列的需補 import(〈用詞〉選擇點表 API):檔頭逐一 import 了原寫法(套件.原名)時,補兄弟寫法那一行;走人裁的
+    _situation_rule_header_scan / _situation_rule_imports_problem(插入點、已 import 不補都照它)。沒有要補的回 None。"""
+    imp = row.get("import")
+    if not imp or row["anchor"] != "方法名" or op is None:
+        return None
+    pkg = imp.rsplit(".", 1)[0]
+    orig = b[op[0]:op[1]].decode("utf-8")
+    heads = _situation_rule_header_imports(_situation_rule_header_scan(text))
+    if not any(re.sub(r"\s+", "", st[len("import"):]) == f"{pkg}.{orig}" for st in heads):
+        return None
+    also, why = _situation_rule_imports_problem(text, new, [f"import {imp}"])
+    return None if why else also
+
+
+def _choice_pick(rel, text, b, line_of, ln, nodes, rows, categories, fp, ctx=None):
+    """一行一個壞法(〈用詞〉;論文 4.1 Listing 2):①這一行有選擇點的類別用行指紋當種子打亂;②依序取類別;③那個類別的節點照錨點由左到右、
+    同欄外層優先;④節點的候選用同一種子打亂,取第一個沒被型別前提排除、產得出來的;⑤都沒有換下一個節點、下一個類別。
+    → (壞法 dict 或 None)。壞法 dict 帶身分(_choice_identity;不唯一時 identity 是 None)、列、類別、錨點行、編輯與 also。
+    ctx 交給 _choice_identity(同一支檔共用)。"""
+    import random
+    seed = int(fp, 16)
+    cats = [c for c in categories if any(rows[n["rule"]]["category"] == c for n in nodes)]
+    random.Random(seed).shuffle(cats)
+    for cat in cats:
+        for n in sorted((n for n in nodes if rows[n["rule"]]["category"] == cat), key=lambda n: (n["anchor"], -(n["e"] - n["s"]), n["s"])):
+            row = rows[n["rule"]]
+            cands = list(row["candidates"]) or [row["special"]]
+            random.Random(seed).shuffle(cands)
+            if _choice_excluded(row, n):
+                continue
+            for tpl in cands:
+                edits = _choice_edits(b, n, row, n["op"], tpl)
+                if not edits:
+                    continue
+                ident = _choice_identity(rel, text, fp, row, edits, line_of, ctx)
+                return {"row": row["id"], "category": cat, "template": tpl, "line": ln, "edits": edits, "identity": ident,
+                        "also": _choice_also(text, row, b, n["op"], ident["new"]) if ident else None}
+    return None
+
