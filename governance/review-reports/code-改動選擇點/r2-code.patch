+def _choice_kill_ledger(rr, res, guard, only, blobs):
+    """讀帳(工作目錄的治理帳與放行檔)挑這次要跑的行 → (帳索引, 守的測試雜湊, _choice_kill_pick 的四個值) 或 rc 2(帳讀不了)。
+    blobs:_choice_test_blobs 的清單(守的測試雜湊含測試檔內容)。"""
+    gevs, gerr = _gov_vc_gate_events(rr, _CHOICE_KILL_GATE)
+    if gerr:
+        return _situation_rule_say(f"治理帳讀不了({_kill_esc(gerr)[:200]}),判不了哪些行已處置")
+    waivers, werr = _lint_waivers_load(rr)
+    if werr:
+        return _situation_rule_say(f"{werr},判不了哪些行已放行")
+    idx = _choice_ledger_index(gevs)
+    tests_sha = _choice_tests_sha(guard["tests"], blobs)
+    return idx, tests_sha, _choice_kill_pick(res, idx, _choice_waived_keys(waivers), guard["bound"], tests_sha, only)
