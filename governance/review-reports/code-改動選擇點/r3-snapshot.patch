+def _choice_cap_pick(ever, cap):
+    """回報上限的抽法(〈用詞〉回報上限,論文 2.3「從存活隨機挑」):「曾經存活過的行」(檔, 行指紋) 集合排序後的雜湊當種子,抽 cap 個。
+    種子只看行指紋集合:提交帳本、rebase 改行號、型錄改動都不重抽;新的存活行出現時集合變了才重抽。用同一種子洗牌後取前 cap 個:
+    上限變大時抽中的是原本那批的超集(照構造成立;CPython 的 sample 實測也是前綴一致,但文件沒保證),處置途中改到別的檔讓上限變了也不會換掉已抽中的行。"""
+    import hashlib
+    import random
+    keys = sorted(ever)
+    if len(keys) <= cap:
+        return set(keys)
+    seed = int(hashlib.sha256("\n".join(f"{f}\t{fp}" for f, fp in keys).encode("utf-8")).hexdigest(), 16)
+    random.Random(seed).shuffle(keys)
+    return set(keys[:cap])
