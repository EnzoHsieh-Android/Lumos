+def _choice_bound_names(tenv, split, default):
+    """被讀版本的圖譜(記憶體圖譜或磁碟圖譜)裡所有計劃(不論狀態)定義條款綁的測試(〈用詞〉有效處置、過期的「仍被條款綁著」)
+    → {"<平台>:<測試名>"…}(帳上 killing_test 存的就是這個形狀,兩個平台同名的測試分得開)。預設平台的測試另收一份不帶前綴的名字:
+    舊紀錄(第二段、沒有平台前綴)當成預設平台的測試(編排者 2026-11-14 裁)。"""
+    out = set()
+    for prel in sorted(tenv.notes):
+        if not prel.startswith("Projects/"):
+            continue
+        text = env_text(tenv, prel) or ""
+        for r in clause_bindings(text, {}, None, lambda _p: set(), lambda _p: ""):
+            if not r.get("defined"):
+                continue
+            for ref in r.get("refs") or []:
+                try:
+                    plat, name, _ex = _split_test_ref_ex(ref, split, default)
+                except ValueError:
+                    continue
+                out.add(_choice_test_key(plat, name))
