+def _choice_killing_name(rr, test):
+    """situation-rule --point 那筆 choice-kill 的 killing_test:--test 的值照平台設定切成 (平台, 名稱) 再組 _choice_test_key;
+    設定讀不了或前綴不認得時照殺傷力配方的寬鬆切法(_kill_method_name 同一支 _split_test_ref_ex)、平台記預設。"""
+    try:
