+def _choice_plat_prefix(rr, plat_entry):
+    """平台根相對 repo 根的路徑前綴("" 是整個 repo);平台根不在這個 repo 裡回 None(那個平台的測試檔這裡查不到)。"""
+    root = (plat_entry or {}).get("root")
+    if root is None:
+        return None
+    rel = os.path.relpath(os.path.realpath(str(root)), os.path.realpath(str(rr))).replace(os.sep, "/")
