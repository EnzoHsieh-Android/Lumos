+def _choice_compute(repo_root, rng, at_sha, tables, deadline=None, scan_timeout=_CHOICE_CLI_SCAN_TIMEOUT, cache=None, pick_timeout=None):
+    """範圍(rng)在被讀版本(at_sha)上的選擇點 → {"lines": [改到的行…](見 _choice_file_points), "changed": 改到的行數,
+    "big": 超過讀檔上限沒掃的檔, "ast_grep": 版本}。choice-points 與後面幾段(choice-kill、推送前那一道)共用這一支。
+    沒有改到的 .kt 正式碼時不跑 ast-grep(判定順序:不需要 ast-grep 的條件先判,〈範圍〉4)。
+    "unverified": [(檔, 原因)…] 這幾支檔算不出來(掃描或挑壞法逾時、ast-grep 回錯、輸出過大),其他檔照判(代碼審 code-改動選擇點 r1 r1)。
+    pick_timeout 給了:挑壞法(_choice_file_points)從掃描結束起自己計時,不跟讀檔、掃描共用 deadline(推送前那一道;代碼審 code-改動選擇點
+    r2 H3:掃描用光時限時,掃完的檔被丟成「挑壞法超過時限」)。沒給就照 deadline。
+    例外:_KtSitUnverifiable(git 讀不到)、_ChoiceNoTool(ast-grep 不在)、_ChoiceUnverifiable(設定不在,整批算不出來)。"""
+    changed, big = _choice_changed_cached(repo_root, rng, at_sha, deadline=deadline, cache=cache)
+    res = {"lines": [], "changed": sum(len(v["lines"]) for v in changed.values()), "big": big, "ast_grep": "", "unverified": []}
+    if not changed:
+        return res
+    scan, res["ast_grep"], bad = _choice_scan(repo_root, {rel: v["text"] for rel, v in changed.items()}, scan_timeout)
+    pick_dl = deadline if pick_timeout is None else time.monotonic() + pick_timeout
+    for rel in sorted(changed):
+        if rel in bad:
+            res["unverified"].append((rel, bad[rel]))
+            continue
+        try:
+            res["lines"] += _choice_file_points(rel, changed[rel]["text"], changed[rel]["lines"], scan[rel], tables, deadline=pick_dl)
+        except _ChoiceUnverifiable as e:
+            res["unverified"].append((rel, str(e)))
+    return res
