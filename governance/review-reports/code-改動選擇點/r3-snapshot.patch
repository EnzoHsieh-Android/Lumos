+def _choice_test_blobs(rr, at_sha, tests, plats, deadline=None):
+    """守的測試所在檔的物件編號 → ([[平台, 測試名, 所在檔物件編號]…], 查完了嗎)。一次 `git grep -z -o -w -F -e <名>…` 帶全部測試名,
+    只收「那個平台的根底下、測試路徑裡(_choice_is_test,建在 _nodehome_is_test 上,跟改到的行排除測試的判法同一支)、副檔名屬於那個平台」
+    的檔(副檔名由 git grep 的路徑樣式限定);同名測試在多支測試檔都出現時全收(物件編號排序後用 + 接);以 (平台, 測試名) 為鍵,兩平台同名各自算(代碼審 code-改動選擇點 r2 H1:
+    原本取全樹第一個含測試名的檔,計劃筆記 docs/ 排在 feature/ 前面就取到筆記;每支測試各一次全樹 grep)。整個字比對(-w):測試名是別的字的
+    子字串不算。時限用完、git 跑不起來或逾時 → 每支記 _CHOICE_TESTS_UNKNOWN、第二個值 False;查完了但測試路徑裡找不到那支 → 那支記
+    _CHOICE_TESTS_UNKNOWN(sourceSets 改過根目錄的專案判不到時只多跑)。deadline 共用呼叫端的時限(_lens_git_dl;r1 r4)。
+    run 那筆的 tests 欄與守的測試雜湊(_choice_tests_sha)都用這份。plats:平台設定({平台: {"root", "profile": {"exts"}}})。"""
+    keys = sorted({(t["plat"], t["name"]) for t in tests})
+    unknown = [[p, n, _CHOICE_TESTS_UNKNOWN] for p, n in keys]
+    if not keys:
+        return [], True
+    if _git_timeout(deadline) <= 0:
+        return unknown, False
+    tree = _choice_tree_oids(rr, at_sha, deadline=deadline)
+    exts = sorted({e for p, _n in keys for e in ((plats.get(p) or {}).get("profile") or {}).get("exts") or ()})
+    if tree is None or not exts:
+        return unknown, tree is not None
+    args = ["grep", "-z", "-o", "-w", "-F", "-I"]
+    for n in sorted({n for _p, n in keys}):
+        args += ["-e", n]
+    r = _lens_git_dl(rr, *args, at_sha, "--", *[f"*{e}" for e in exts], deadline=deadline)
+    if r is None or r.returncode not in (0, 1):
