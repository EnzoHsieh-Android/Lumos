+def _choice_rules_match(rows, rules_dir, sub, tag):
+    """表的列 ↔ 規則目錄 id 一一對上 → 問題清單:每列的規則檔在、裡面有 id 等於列號的規則;規則目錄裡多出來的 id 也報。"""
