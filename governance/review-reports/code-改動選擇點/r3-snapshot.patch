+def _choice_catalog_sha():
+    """型錄雜湊前 12 碼(帳上記著備查,〈實務隱患〉型錄改了);讀不到回空字串。"""
+    import hashlib
+    try:
+        return hashlib.sha256(Path(_kt_catalog_path()[0]).read_bytes()).hexdigest()[:12]
+    except OSError:
+        return ""
+
