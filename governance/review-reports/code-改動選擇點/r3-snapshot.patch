+def cmd_choice_kill(env, diff=None, branch=None, only=None, max_mutants=_CHOICE_MAX_MUTANTS, max_seconds=_CHOICE_MAX_SECONDS):
+    """lumos choice-kill(〈範圍〉2):對還沒有有效處置的行,把挑到的壞法批次交 cmd_guard_kill 跑碰到的進行中計劃綁的測試、逐筆記治理帳。
+    跑之前(_choice_kill_base、_choice_kill_scan、_choice_kill_guard):參數、範圍右端是 HEAD、工作目錄乾淨、ast-grep 在、碰到進行中計劃、
+    有可守的測試、run_cmd 有 {method}、Android 的 run_cmd 跑得了單支(同人裁那一道)。挑哪些行(_choice_kill_pick):沒紀錄或過期的先,
+    survived 只在守的測試雜湊變了(或帶不明標記)才重跑、no_result 一律重跑,--only 不受這條限制;--max-mutants 截。
+    rc 取最大:全部有效處置 0;有存活 1;有 no_result、不唯一、沒跑完或中斷、有檔算不出選擇點(那幾支這次不跑)2;跑之前的檢查不過 2(不跑)。
+    不寫計劃、不改程式。"""
+    base = _choice_kill_base(env, diff, branch, only, max_mutants, max_seconds)
+    if isinstance(base, int):
+        return base
+    rr, rng, at_sha, only = base
+    res = _choice_kill_scan(rr, rng, at_sha, only)
+    if isinstance(res, int):
+        return res
+    guard = _choice_kill_guard(rr, rng, at_sha)
+    if isinstance(guard, int):
+        return guard
+    # 守的測試所在檔的物件編號:算進守的測試雜湊、也是 run 那筆的 tests;算進這次呼叫的總時限(從這裡起算,代碼審 code-改動選擇點 r1 r4)
+    t0 = time.monotonic()
+    blobs, complete = _choice_test_blobs(rr, at_sha, guard["tests"], guard["pdata"]["platforms"], deadline=t0 + max_seconds)
+    lost = [f"{p}:{n}" for p, n, s in blobs if s == _CHOICE_TESTS_UNKNOWN]
+    if lost:
+        print(f"⚠ 守的測試 {'、'.join(_kill_esc(x) for x in lost[:5])}{f' 等 {len(lost)} 支' if len(lost) > 5 else ''} "
+              f"{'時限內沒查完所在檔' if not complete else '在測試路徑裡找不到所在檔'},守的測試雜湊標成不明:上次存活的行這次一律重跑", file=sys.stderr)
+    got = _choice_kill_ledger(rr, res, guard, only, blobs)
+    if isinstance(got, int):
+        return got
+    idx, tests_sha, (todo, carried, done, nu) = got
+    for plat in sorted({t["plat"] for t in guard["tests"]}) if todo else []:
+        why = _situation_rule_android_cmd_problem(dict(guard["pdata"], default_platform=plat), os.path.join(os.path.realpath(str(rr)), todo[0]["file"]))
+        if why:
+            return _situation_rule_say(why)
+    kr = _ChoiceKillRun(env, rr, at_sha, guard, idx, tests_sha, max_seconds, t0=t0, blobs=blobs)
+    for x in todo[:max_mutants]:
+        kr.add(x)
+    floor = _kill_timeout_floor()
+    print(f"choice-kill:{len(kr.plan_of)} 個壞法 × 最多 {len(guard['tests'])} 支測試(基準每條測試指令只跑一次、最長 {int(max(600.0, floor))} 秒;"
+          f"壞法最長基準耗時的 5 倍、至少 {int(floor)} 秒;總時限 {int(max_seconds)} 秒,到了就停在配方之間)")
+    sys.stdout.flush()
+    kr.run()
+    return _choice_kill_report(kr, res, rr, at_sha, carried, nu, len(todo) - len(kr.plan_of), done, max_mutants, max_seconds)
+
