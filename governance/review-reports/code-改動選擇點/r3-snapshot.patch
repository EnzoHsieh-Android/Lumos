+def _choice_tree_oids(rr, at_sha, deadline=None):
+    """被讀版本的 (所有路徑, {NFC 路徑: 物件編號}) 或 None(列不出)。完整提交編號走 _drift_list 的記憶(_choice_changed 已列過同一棵樹);
+    其他寫法(測試用 HEAD)直接 ls-tree 一次。"""
+    if _LENS_SHA_RE.fullmatch(str(at_sha)):
+        lst = _drift_list(rr, at_sha)
+        return (lst[1], _drift_oids(rr, at_sha)) if lst else None
+    oids = {}
+    lst = _nodehome_list(rr, at_sha, oids=oids, timeout=_git_timeout(deadline))
+    return (lst[1], oids) if lst else None
