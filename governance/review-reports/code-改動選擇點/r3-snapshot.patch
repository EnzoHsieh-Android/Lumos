+        print(f"提醒:{why},這次不檢查選擇點(工具鏈安裝不完整?)", file=sys.stderr)
+        return 0
+    if why:
+        print(f"choice-points:Kotlin 型錄的選擇點表{why}", file=sys.stderr)
+        return 2
+    try:
+        res = _choice_compute(rr, rng, at_sha, tables)
+    except _ChoiceNoTool as e:
+        print(f"沒檢查到:ast-grep 不在({_kill_esc(str(e))[:160]});裝 ast-grep 後重跑(brew install ast-grep 或 pip install ast-grep-cli)",
+              file=sys.stderr)
+        return 3
+    except _ChoiceUnverifiable as e:
+        print(f"沒檢查到:語法樹掃描算不出來({_kill_esc(str(e))[:160]})", file=sys.stderr)
+        return 3
+    except (_KtSitUnverifiable, OSError, subprocess.TimeoutExpired) as e:
+        print(f"choice-points:讀不到改動({_kill_esc(str(e))[:160] or e.__class__.__name__})", file=sys.stderr)
+        return 2
+    status = _choice_ledger_status(rr, at_sha, [(x["file"], x["fp"]) for x in res["lines"] if x["mutant"] is not None], rng=rng)
+    print(f"改動選擇點(範圍 {rng[:12]}..{at_sha[:12]};論文 4.1 每行最多一個壞法)")
+    for x in res["lines"]:
+        loc = f"{_kill_esc(x['file'])}:{x['line']}"
+        decl = f" [{_kill_esc(x['decl'])}]" if x["decl"] else ""
+        mut = x["mutant"]
+        if mut is None:
+            print(f"  {loc}  {_CHOICE_STATUS_TEXT[x['status']]}{decl}")
+            continue
+        ident = mut["identity"]
+        shown = (f"{_kill_esc(ident['old'].strip())[:_CHOICE_SHOW_MAX]} → {_kill_esc(ident['new'].strip())[:_CHOICE_SHOW_MAX]}"
+                 if ident else _kill_esc(mut["template"]))
+        st = _CHOICE_STATUS_TEXT["not_unique"] if x["status"] == "not_unique" else status.get((x["file"], x["fp"]), _CHOICE_STATUS_TEXT["unrun"])
+        also = "(補 import)" if mut.get("also") else ""
+        print(f"  {loc}  {mut['row']} {mut['category']}  {shown}{also}{decl}  {st}")
+    for rel in res["big"]:
+        print(f"  {_kill_esc(rel)}  超過讀檔上限 {_KT_SIT_READ_MAX // 1048576}MB,沒掃")
+    print("".join(f"  {_kill_esc(rel)}  沒檢查到:語法樹掃描算不出來({_kill_esc(why)[:160]})\n" for rel, why in res["unverified"]), end="")
+    n_point = sum(1 for x in res["lines"] if x["status"] != "arid")
+    n_mut = sum(1 for x in res["lines"] if x["mutant"] is not None)
+    print(f"統計:改到的行 {res['changed']}、有選擇點的行 {n_point}、有壞法的行 {n_mut}"
+          + (f"(ast-grep {res['ast_grep']})" if res["ast_grep"] else ""))
