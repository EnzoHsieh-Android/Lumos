+def _choice_tests_sha(tests, blobs=None):
+    """守的測試雜湊(〈範圍〉2 挑哪些行跑:survived 只在這個值變了才重跑)。tests 是 [{"plat", "name"}…];blobs 是 _choice_test_blobs 的清單
+    [[平台, 測試名, 所在檔物件編號]…],給了就以 (平台, 測試名) 為鍵把所在檔的物件編號一起算進去:原地補強測試(名字不變、內容變了)也會重跑
+    (代碼審 code-改動選擇點 r1 g1、c22;Stryker 增量模式比對測試檔內容 https://stryker-mutator.io/docs/stryker-js/incremental/)。
+    有任一支是 _CHOICE_TESTS_UNKNOWN(或清單裡沒有那支)→ 回傳值尾端帶 _CHOICE_TESTS_UNKNOWN,_choice_kill_pick 一律當成變了(只多跑不漏;r2 H1)。
+    blobs 不給只算名字(舊呼叫法)。"""
+    import hashlib
+    bm = None if blobs is None else {(p, n): s for p, n, s in blobs}
+    keys = sorted({f"{t['plat']}:{t['name']}" + ("" if bm is None else f"@{bm.get((t['plat'], t['name']), _CHOICE_TESTS_UNKNOWN)}") for t in tests})
+    h = hashlib.sha256("\n".join(keys).encode("utf-8")).hexdigest()[:16]
+    unknown = bm is not None and any(bm.get((t["plat"], t["name"]), _CHOICE_TESTS_UNKNOWN) == _CHOICE_TESTS_UNKNOWN for t in tests)
+    return h + _CHOICE_TESTS_UNKNOWN if unknown else h
