+    layout, oids, pre = _nodehome_layout(tree[0]), tree[1], f"{at_sha}:"
+    found = {}
+    for ln in r.stdout.splitlines():
+        head, _z, word = ln.partition("\0")
+        if head.startswith(pre):
+            found.setdefault(word, set()).add(nfc(head[len(pre):]))
+    out = []
+    for p, n in keys:
+        ent = plats.get(p) or {}
+        pfx = _choice_plat_prefix(rr, ent)
+        files = sorted(f for f in found.get(n, ()) if pfx is not None and f.startswith(pfx) and _choice_is_test(f, layout))
+        sig = "+".join(sorted(oids.get(f) or _CHOICE_TESTS_UNKNOWN for f in files)) if files else _CHOICE_TESTS_UNKNOWN
+        out.append([p, n, _CHOICE_TESTS_UNKNOWN if _CHOICE_TESTS_UNKNOWN in sig else sig])
