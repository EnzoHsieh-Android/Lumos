+def _choice_requirement(rr, rng, at_sha, deadline=None, cache=None):
+    """推送前那一道判定順序的前半(〈範圍〉4 判定順序;S21:不需要 ast-grep 就判得出來)→ (要不要求, 原因)。
+    專案沒有 kotlin-junit 平台、改到的行裡沒有 .kt 正式碼、碰到的進行中計劃的計劃日期(_plan_effective_day scope="note")都早於生效日
+    (沒碰到計劃時看今天)→ 不要求。改到的行有沒有壞法要掃描才知道(_choice_compute 之後看有沒有 mutant、not_unique 的行)。
+    算不出來(設定讀不了、git 讀不到)往外丟,呼叫端照「算不出來」處理。"""
+    pdata = load_platforms(rr)
+    if not any(p.get("profile_name") == "kotlin-junit" for p in pdata["platforms"].values()):
+        return False, "專案沒有 kotlin-junit 平台"
+    changed, _big = _choice_changed_cached(rr, rng, at_sha, deadline=deadline, cache=cache)
+    if not changed:
+        return False, "改到的行沒有 Kotlin 正式碼"
+    since = _choice_since()
+    plans, why, meta = _choice_spec_calc(rr, rng, at_sha, deadline=deadline, cache=cache)
+    if why:
+        raise _KtSitUnverifiable(why)
+    tenv, vrel = meta["env"], meta["vrel"]
+    touched_plans = _spec_gate_touched_plans(vrel, meta["touched"])
+    live = [p + ".md" for p in plans if _plan_live(p + ".md", tenv.notes.get(p + ".md"), touched_plans)]
+    if not live:
+        today = time.strftime("%Y-%m-%d")
+        return (today >= since), ("沒碰到計劃、今天在生效日之後" if today >= since else "沒碰到計劃、今天早於生效日")
+    days = [_plan_effective_day(rr, f"{vrel}/{p}", (tenv.notes.get(p).fields.get("created") if tenv.notes.get(p) else None), scope="note")
+            for p in live]
+    if any(d is None or d >= since for d in days):
+        return True, "碰到的進行中計劃在生效日之後"
+    return False, "碰到的進行中計劃都早於生效日"
+
