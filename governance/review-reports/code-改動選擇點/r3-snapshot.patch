+    for col in ("乾的範圍", "論文對應節", "為什麼沒用", "加入日期與依據"):
+        if not get(col).strip():
+            probs.append(f"{col}不准空")
+    if probs:
+        return None, probs
+    return {"id": rid, "rule_file": mf.group(1), "rule": get("ast-grep 規則"), "scope": get("乾的範圍"), "paper": get("論文對應節"),
