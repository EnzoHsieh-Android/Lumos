+def _choice_push_range(rr, git_range, push):
+    """推送前那一道的改到的行範圍(〈範圍〉4 範圍)→ (範圍, B, 說明) 或 (None, None, 原因)。B 取推送範圍右端;帶 push=(遠端, 被推 ref) 時
+    起點走單一來源 _push_range_start(推送範圍左端當遠端舊值);它回「頂端已在主線」、沒有起點或 git 查不到(_PUSH_START_UNKNOWN)→ 用推送範圍本身
+    (推主線本身也走這條)。沒帶 push(舊掛鉤、手動跑)→ 推送範圍本身。"""
+    ends = _lens_range_ok(git_range)
+    if ends is None:
+        return None, None, f"範圍 {_kill_esc(str(git_range))[:60]} 不是 A..B"
+    tip = _lens_full_sha(rr, ends[1])
+    if not tip:
+        return None, None, f"B({_kill_esc(ends[1])[:40]})取不到"
+    if push is None:
+        return f"{ends[0]}..{tip}", tip, "推送範圍"
+    start, why = _push_range_start(rr, ends[0], tip, push[0], push[1])
+    if start is None or start == _PUSH_START_UNKNOWN:
+        return f"{ends[0]}..{tip}", tip, f"推送範圍({why})"
