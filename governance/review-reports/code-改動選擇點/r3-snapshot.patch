+def _kill_timeout_floor():
+    """殺傷力壞法逾時下限(LUMOS_KILL_TIMEOUT_FLOOR,預設 20 秒;同 cmd_guard_kill 讀法)。"""
+    try:
+        return float(os.environ.get("LUMOS_KILL_TIMEOUT_FLOOR", "20"))
+    except ValueError:
+        return 20.0
