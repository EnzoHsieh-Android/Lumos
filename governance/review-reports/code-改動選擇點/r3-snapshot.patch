+def _choice_kill_judge(order, rows):
+    """一個壞法的判定(〈用詞〉殺掉判定)。order:這個壞法的測試鍵(排序後);rows:{測試鍵: cmd_guard_kill 的 on_row 列}。
+    → (verdict, 殺掉它的測試鍵或 None, 原因, 失敗摘錄, 基準不綠拿掉的測試鍵)。
+    基準 abort 的測試拿掉、其餘照判;全部 abort → no_result。任一支沒有弱證據、不是編不過的 killed → killed(取排序第一支);
+    否則編不過 → no_result「壞法編不過」、逾時 → 「測試掛住」、弱證據(含帶弱證據的 survived)或 drifted 或 error → 那一種、
+    有測試沒有列 → 「缺結果」;每支都有列而且都是沒有弱證據的 survived → survived。"""
+    aborted = [t for t in order if (rows.get(t) or {}).get("verdict") == "abort"]
+    live = [t for t in order if t not in aborted]
+    if not live:
+        ex = next((rows[t].get("fail_excerpt") or rows[t].get("detail") or "" for t in aborted if rows.get(t)), "")
+        return "no_result", None, "基準不綠沒跑", ex, aborted
+    for t in live:
+        r = rows.get(t)
+        if r and r["verdict"] == "killed" and not r.get("weak") and not r.get("compile_error"):
+            return "killed", t, "", "", aborted
+    # 帶弱證據的 survived 也算弱證據(計劃 S9「沒有強 killed 而有弱證據記 no_result」;例:修改時間沒錯開,壞法可能沒被編進去,
+    # 綠不代表沒有測試守著;代碼審 code-改動選擇點 r1 c21)
+    checks = (("壞法編不過", lambda r: r.get("compile_error")), ("測試掛住", lambda r: r["verdict"] == "timed_out_weak"),
+              ("弱證據或結果不明", lambda r: r["verdict"] in _CHOICE_JUDGE_WEAK or (r["verdict"] == "survived" and r.get("weak"))))
+    for label, hit in checks:
+        for t in live:
+            r = rows.get(t)
+            if r and hit(r):
+                why = label if label != "弱證據或結果不明" else f"{r['verdict']}{('(' + ';'.join(r.get('weak_why') or []) + ')') if r.get('weak_why') else ''}"
+                return "no_result", None, why, r.get("fail_excerpt") or r.get("detail") or "", aborted
+    if any(t not in rows or rows[t]["verdict"] != "survived" for t in live):
+        return "no_result", None, "缺結果", "", aborted
+    return "survived", None, "", "", aborted
+
