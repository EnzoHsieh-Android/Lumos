+def _choice_loc_parse(loc):
+    """定位 <檔>:<行> → (檔, 行) 或 None(〈用詞〉定位:從右邊切最後一個 :,行號要是正整數;檔名可以含冒號)。"""
+    f, sep, n = str(loc or "").rpartition(":")
+    if not sep or not f.strip() or not re.fullmatch(r"[1-9][0-9]{0,8}", n):
