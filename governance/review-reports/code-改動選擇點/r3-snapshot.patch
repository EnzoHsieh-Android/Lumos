+def _choice_spec_calc(rr, rng, at_sha, deadline=None, cache=None):
+    """碰到的計劃(_kt_sit_spec_names_calc:被讀版本的樹建記憶體圖譜、改到的行的範圍交 _spec_gate_push_candidates)→ (計劃, 原因, meta)。
+    cache 給一個 dict 時同一輪只算一次(推送前那一道的判定順序與守的測試共用;〈範圍〉4 同一輪按 (提交, 檔) 快取只讀一次)。"""
+    key = ("spec", rng, at_sha)
+    if cache is not None and key in cache:
+        return cache[key]
+    meta = {}
+    plans, why = _kt_sit_spec_names_calc(rr, rng, at_sha, deadline=deadline, meta=meta)
+    got = (plans, why, meta)
+    if cache is not None:
+        cache[key] = got
+    return got
