+    那一行要挑得到唯一的壞法(old 在 HEAD 恰好一次由壞法身分保證)。"""
+    say = _situation_rule_say
+    loc = _choice_loc_parse(point)
+    if loc is None:
+        return say(f"--point {_kill_esc(str(point))[:80]} 要寫成 <檔>:<行>(行號是正整數)")
+    rr = Path(_vault_repo_root(env))
+    head = _lens_full_sha(rr, "HEAD")
+    if not head:
