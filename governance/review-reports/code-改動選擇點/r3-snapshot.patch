+def _choice_disposition(evs, waived, bound):
+    """一行(以 (檔, 行指紋) 為鍵)的帳上狀態(〈用詞〉有效處置、過期)→ "waived" 放行過、"killed" 殺掉而且殺掉它的測試在被讀版本仍被某份計劃
+    (不論進行中或已完成)的條款綁著、"stale" 過期(殺掉它的測試已沒有條款綁)、"survived"、"no_result"、None(沒紀錄)。只看同鍵最新一筆。
+    waived:放行檔有 choice:<檔>:<行指紋>;bound:被讀版本所有計劃條款綁的測試名集合(_choice_bound_names)。型錄改了、挑到的壞法換了,
+    行指紋沒變就照算(S24)。前兩種是有效處置。"""
+    if waived:
+        return "waived"
+    if not evs:
+        return None
+    last = evs[-1]
+    v = last.get("verdict")
+    if v == "killed":
+        return "killed" if last.get("killing_test") in bound else "stale"
+    return v if v in ("survived", "no_result") else None
+
