+def _situation_rule_point_events(rr, prel, ident):
+    """選擇點路徑自己的讀帳(冪等用):版控治理帳裡帶 point、壞法身分 (file, fp, new_sha) 與計劃都對得上的 situation-rule 事件,
+    另回同一行 (file, fp) 的 choice-kill 事件 → (人裁事件, choice-kill 事件, 帳壞原因)。"""
+    evs, gerr = _gov_vc_gate_events(rr, (_SITUATION_RULE_SOURCE, _CHOICE_KILL_GATE))
+    if gerr:
+        return [], [], gerr
+    ruled = [e for e in evs if e.get("gate") == _SITUATION_RULE_SOURCE and e.get("kind") == _SITUATION_RULE_SOURCE and e.get("point")
+             and (e.get("file"), e.get("fp"), e.get("new_sha")) == (ident["file"], ident["fp"], ident["new_sha"])
+             and isinstance(e.get("plan"), str) and nfc(e["plan"]) == nfc(prel)]
+    ck = _choice_ledger_index(evs).get((ident["file"], ident["fp"])) or []
+    return ruled, ck, None
