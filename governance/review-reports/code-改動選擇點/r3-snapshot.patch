+    hits = [_choice_hit(src, "C-11", n1, mv={"A": '"id="', "B": "id"}), _choice_hit(src, "C-11", n2, mv={"A": n1, "B": '", total="'}),
+            _choice_hit(src, "C-11", n3, mv={"A": n2, "B": "(a + b)"}), _choice_hit(src, "C-11", "a + b", mv={"A": "a", "B": "b"})]
