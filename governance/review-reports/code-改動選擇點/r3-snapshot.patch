+def _choice_range(rr, diff, branch):
+    """choice-points 的範圍 → (範圍字串, 被讀版本 sha, None) 或 (None, None, 原因)。給了 --diff:只收 A..B(_lens_range_ok)、兩端解得到提交,
+    被讀版本是 B。沒給:跟推送前那一道同一套——頂端是 --branch 那條或目前分支,起點 _push_range_start(遠端舊值全零、遠端照
+    _lens_default_remote);目前分支就是主線(_note_reread_mainline_names:main、master 或主線候選指到的那條)、頂端已在主線、
+    或算不出起點 → 原因(rc 2)。"""
+    if diff is not None:
+        ends = _lens_range_ok(diff)
+        if ends is None:
+            return None, None, f"--diff {_kill_esc(str(diff))[:60]} 要寫成 A..B(恰好一個 ..、兩端都要有、不以 - 開頭)"
+        a, z = _lens_full_sha(rr, ends[0]), _lens_full_sha(rr, ends[1])
+        if not a or not z:
+            return None, None, f"--diff {_kill_esc(diff)[:60]} 的兩端要解得到提交"
+        return f"{a}..{z}", z, None
+    if branch is not None and not branch.strip():
+        return None, None, "--branch 給了空字串——要用哪個分支講清楚"
+    name = branch
+    if name is None:
+        r = _lens_git(rr, "symbolic-ref", "-q", "--short", "HEAD")
+        name = r.stdout.strip() if r is not None and r.returncode == 0 else ""
+    tip = _lens_full_sha(rr, f"refs/heads/{name}" if name else "HEAD")
+    if not tip:
+        return None, None, f"解不出分支 {_kill_esc(name or 'HEAD')} 的頂端提交"
+    remote = _lens_default_remote(rr, tip if branch else None, None)
+    # 主線分支名走共用的 _note_reread_mainline_names(main、master 加主線候選實際指到的分支;遠端名可以帶斜線),不另寫一套
+    # (代碼審 code-改動選擇點 r1 a1:原本自己切 symbolic-ref,遠端名 my/fork 時認不出 trunk 是主線)
+    if name and name in _note_reread_mainline_names(rr, tip):
+        return None, None, f"目前分支 {_kill_esc(name)} 就是主線——要看哪一段改動,帶 --diff <A..B>"
+    start, why = _push_range_start(rr, "0" * len(tip), tip, remote, f"refs/heads/{name}" if name else None)
+    if start is None:
+        return None, None, f"{why};帶 --diff <A..B> 指定要看的範圍"
+    if start == _PUSH_START_UNKNOWN:
+        return None, None, f"算不出範圍的起點({why})"
+    return f"{start}..{tip}", tip, None
+
