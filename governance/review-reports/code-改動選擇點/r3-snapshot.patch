+def _choice_since():
+    """生效日:常數 _CHOICE_SINCE;環境變數 LUMOS_CHOICE_SINCE 供測試覆寫(測試總檔預設 9999-12-31);不是 YYYY-MM-DD 就用常數。"""
+    v = os.environ.get("LUMOS_CHOICE_SINCE", "").strip()
