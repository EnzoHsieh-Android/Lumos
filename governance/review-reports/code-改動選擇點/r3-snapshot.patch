+def _choice_kill_pick(res, idx, waived, bound, tests_sha, only):
+    """挑哪些行跑(〈範圍〉2):→ (要跑的 [行…](沒紀錄或過期的先)、帶過去的 {(檔, 指紋): 狀態}(survived 而守的測試沒變)、
+    有效處置的行數、不唯一沒放行的行)。only 給了只看那一行,而且不受「守的測試沒變不重跑」限制。
+    no_result 一律重跑:原因多半是環境(基準不綠、逾時、編譯快取),跟守的測試變沒變無關,推送閘叫人「修好後重跑」要真的會重跑
+    (代碼審 code-改動選擇點 r1 g1)。守的測試雜湊帶 _CHOICE_TESTS_UNKNOWN(所在檔查不完或找不到)→ 當成變了,survived 也重跑(只多跑不漏;r2 H1)。"""
+    first, again, carried, done, nu = [], [], {}, 0, []
+    for x in res["lines"]:
+        if only is not None and (x["file"], x["line"]) != only:
+            continue
+        key = (x["file"], x["fp"])
+        if x["status"] not in ("mutant", "not_unique"):
+            continue
+        evs = idx.get(key) or []
+        disp = _choice_disposition(evs, key in waived, bound)
+        if disp in ("waived", "killed"):
+            done += 1
+            continue
+        if x["status"] == "not_unique":
+            nu.append(x)
+            continue
+        if disp == "survived" and only is None and evs[-1].get("tests_sha") == tests_sha and _CHOICE_TESTS_UNKNOWN not in str(tests_sha):
+            carried[key] = disp
+            continue
+        (first if disp in (None, "stale") else again).append(x)
+    return first + again, carried, done, nu
