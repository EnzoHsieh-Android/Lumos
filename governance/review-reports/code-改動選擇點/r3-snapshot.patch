+def _choice_ledger_index(events):
+    """治理帳的 choice-kill 事件 → {(檔, 行指紋): [kind choice-kill 的事件…](檔內順序)};欄位型別不對的略過。
+    第三段推送前那一道讀 B 版的帳(_gov_rows_at)也交這一支。"""
+    idx = {}
+    for e in events or []:
+        if not isinstance(e, dict) or e.get("gate") != _CHOICE_KILL_GATE or e.get("kind") != _CHOICE_KILL_GATE:
+            continue
+        if not all(isinstance(e.get(k), str) for k in ("file", "fp", "verdict")):
+            continue
+        idx.setdefault((e["file"], e["fp"]), []).append(e)
+    return idx
