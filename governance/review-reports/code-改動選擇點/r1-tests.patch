+    停止旗標不看 → 第 4、5 個跑了那條紅。"""
+    import signal as _sig
+    import time as _time
+    if not hasattr(_sig, "SIGINT") or _os_mod.name == "nt":
+        raise _SrcOnly("非 POSIX,這段沒驗到")
+    tmp = Path(tempfile.mkdtemp(prefix="gctl-ck-"))
+    root = fake = None
