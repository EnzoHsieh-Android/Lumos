+def _choice_fp(rel, lines, ln):
+    """行指紋(〈用詞〉):<檔> 加上那一行與前後各 2 行剝前後空白後的原文,sha256 前 16 碼;檔頭檔尾外的行當空字串。"""
+    import hashlib
+    win = [lines[i - 1].strip() if 1 <= i <= len(lines) else "" for i in range(ln - _CHOICE_FP_CTX, ln + _CHOICE_FP_CTX + 1)]
+    return hashlib.sha256((rel + "\0" + "\n".join(win)).encode("utf-8")).hexdigest()[:16]
+
