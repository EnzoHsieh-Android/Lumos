+def _choice_swap_edits(b, hit, op, new_op):
+    """二元運算換運算子:只換運算子記號(保留原排版);層級變了時,運算元自己的頂層運算子綁得不比新運算子緊就加括號
+    (x + a * b 換成 / 不能變成 (x / a) * b;左運算元同層級照左結合不用加),外層是運算式時整個節點也加。"""
+    s, e, mv = hit["s"], hit["e"], hit["mv"]
+    old_op = b[op[0]:op[1]].decode("utf-8")
+    edits = [(op[0], op[1], new_op.encode("utf-8"))]
+    if _CHOICE_PREC.get(new_op) == _CHOICE_PREC.get(old_op):
+        return edits
+    lvl = _CHOICE_PREC[new_op]
+    for k, loose in (("A", _choice_top_prec(mv["A"][2]) < lvl), ("B", _choice_top_prec(mv["B"][2]) <= lvl)):
+        if loose:
+            edits += [(mv[k][0], mv[k][0], b"("), (mv[k][1], mv[k][1], b")")]
+    if not _choice_ctx_safe(b, s, e):
+        edits += [(s, s, b"("), (e, e, b")")]
+    return edits
