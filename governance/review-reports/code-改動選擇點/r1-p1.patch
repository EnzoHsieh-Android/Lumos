+def _choice_file_points(rel, text, lines_changed, scan, tables):
+    """一支檔 → 改到的行清單 [{"file", "line", "fp", "decl", "status", "mutant"}]:只列錨點落在這一行的選擇點節點(含乾節點);
+    status:mutant(挑到壞法)、not_unique(挑到了但身分不唯一,或行指紋跟同檔別行相同)、none(有選擇點但候選都被型別前提擋掉)、
+    arid(這一行的節點全落在乾節點範圍)。ERROR 節點重疊的節點不算。"""
+    import bisect
+    b = text.encode("utf-8")
+    starts = _choice_line_index(b)
+
+    def line_of(off):
+        return bisect.bisect_right(starts, off)
+    rows = {r["id"]: r for r in tables["choice"]}
+    by_line = {}
+    for h in scan["choice"]:
+        row = rows.get(h["rule"])
+        if row is None or any(_choice_err_lines(x, h, line_of) for x in scan["error"]):
+            continue
+        anchor, op = _choice_anchor(b, h, row)
+        if anchor is None:
+            continue
+        n = dict(h, anchor=anchor, op=op, arid=any(a <= h["s"] and h["e"] <= z for a, z in scan["arid"]))
+        by_line.setdefault(line_of(anchor), []).append(n)
+    lines = text.split("\n")
+    stripped = _strip_c_comments(text, blank_strings=True, keep_length=True, kotlin=True).split("\n")
+    levels = _kt_sit_levels("\n".join(stripped))
+    cache, out = {}, []
+    for ln in lines_changed:
+        nodes = by_line.get(ln) or []
+        if not nodes:
+            continue
+        fp = _choice_fp(rel, lines, ln)
+        mat = _kt_sit_material(stripped, levels, ln, cache) if ln <= len(stripped) else None
+        decl = lines[mat[0] - 1].strip()[:_CHOICE_SHOW_MAX] if mat else ""
+        ent = {"file": rel, "line": ln, "fp": fp, "decl": decl, "status": "arid", "mutant": None}
+        live = [n for n in nodes if not n["arid"]]
+        if live:
+            mut = _choice_pick(rel, text, b, line_of, ln, live, rows, tables["categories"], fp)
+            ent["mutant"] = mut
+            # 連前後各 2 行都相同的兩行共用指紋,old 往外帶到前後各 2 行也一定不唯一 → 身分 None,標不唯一(〈用詞〉行指紋)
+            ent["status"] = "none" if mut is None else ("mutant" if mut["identity"] else "not_unique")
+        out.append(ent)
+    return out
