+def _choice_compute(repo_root, rng, at_sha, tables, deadline=None, scan_timeout=_CHOICE_CLI_SCAN_TIMEOUT):
+    """範圍(rng)在被讀版本(at_sha)上的選擇點 → {"lines": [改到的行…](見 _choice_file_points), "changed": 改到的行數,
+    "big": 超過讀檔上限沒掃的檔, "ast_grep": 版本}。choice-points 與後面幾段(choice-kill、推送前那一道)共用這一支。
+    沒有改到的 .kt 正式碼時不跑 ast-grep(判定順序:不需要 ast-grep 的條件先判,〈範圍〉4)。
+    例外:_KtSitUnverifiable(git 讀不到)、_ChoiceNoTool(ast-grep 不在)、_ChoiceUnverifiable(掃描算不出來)。"""
+    changed, big = _choice_changed(repo_root, rng, at_sha, deadline=deadline)
+    res = {"lines": [], "changed": sum(len(v["lines"]) for v in changed.values()), "big": big, "ast_grep": ""}
+    if not changed:
+        return res
+    scan, res["ast_grep"] = _choice_scan(repo_root, {rel: v["text"] for rel, v in changed.items()}, scan_timeout)
+    for rel in sorted(changed):
