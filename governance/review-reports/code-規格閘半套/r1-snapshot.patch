+def _sg_system(kg, name, key_lines):
+    d = kg / "Systems"; d.mkdir(exist_ok=True)
+    body = "---\ntype: system\nstatus: doing\nsummary: |-\n  FLOW:x\n" + "".join(f"  {k}\n" for k in key_lines) + "---\n# " + name + "\n"
+    (d / f"{name}.md").write_text(body, encoding="utf-8")
