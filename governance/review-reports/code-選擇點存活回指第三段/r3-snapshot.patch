+def _choice_layer_write_parts(sc, ctx, segs, wd, lid, cache, sides, split):
+    """每份材料寫成 <編號>-<n>.md → (份清單的 parts, items)。超過上限的那份 stderr 註明原因。"""
+    parts, items = [], {}
+    for n, (its, over) in enumerate(split, 1):
+        text = _choice_layer_render(sc, ctx, segs, its, cache, lid, n=n, sides=sides)
