+def _choice_layer_items_md(sc, ctx, segs, xs, cache):
+    """存活那幾段的材料行(xs 的編號從 1 起)。"""
+    live, out = sc["guard"]["live"], []
+    for k, x in enumerate(xs, 1):
+        out += _choice_layer_item_md(k, x, segs[(x["file"], x["fp"])], _choice_layer_code(sc["rr"], sc["at_sha"], x, cache), ctx, live)
+    return out
