+def _choice_layer_part_cmd(env, lid, n):
+    """lumos choice-layer --part n --list <編號>:印第 n 份(從清單取,不重算)。"""
+    lst, wd = _choice_layer_list(Path(_vault_repo_root(env)), lid)
+    if lst is None:
+        return _situation_rule_say("清單不在了,重跑 `lumos choice-layer --template`")
+    text, why = _choice_layer_read_part(wd, lid, n)
+    if text is None:
+        return _situation_rule_say(f"第 {n} 份:{why}(共 {len(lst['parts'])} 份);重跑 `lumos choice-layer --template`")
+    print(text, end="")
+    return 0
+
+
+def _choice_layer_str_errs(it):
+    """一筆判讀的文字欄位:before、after 必填,question、reason 選填,都要是字串、各最多 _CHOICE_LAYER_FIELD_MAX 個實字(原始字元另有上限)。"""
+    errs = []
+    for k in ("before", "after", "question", "reason"):
+        v = it.get(k, "")
+        if not isinstance(v, str):
+            errs.append(f"{k} 要是字串")
+        elif k in ("before", "after") and not v.strip():
+            errs.append(f"{k} 不能空")
+        elif _real_chars(v) > _CHOICE_LAYER_FIELD_MAX or len(v) > _CHOICE_LAYER_RAW_MAX:
+            errs.append(f"{k} 超過長度上限({_CHOICE_LAYER_FIELD_MAX} 字)")
+    return errs
+
+
+def _choice_layer_quote_in(quote, text):
+    return text is not None and _kt_sit_quote_norm(quote) in _kt_sit_quote_norm(text)
+
+
+def _choice_layer_basis_errs(basis, plans, ctx):
+    """basis 的形狀與每一項的出處(〈範圍〉9):清單、最多 _CHOICE_LAYER_BASIS_MAX 項;每項恰好 plan、where、quote 三個字串,plan 是材料涉及的計劃,
+    where 是那份計劃的條款號或段名,quote 10 到 200 個實字、逐字出自它標的那條條款或那一段(_kt_sit_quote_norm 比)。→ (錯誤句, [(項, 是條款, 出處原文)…])。"""
+    if not isinstance(basis, list) or len(basis) > _CHOICE_LAYER_BASIS_MAX:
+        return [f"basis 要是最多 {_CHOICE_LAYER_BASIS_MAX} 項的清單"], []
+    errs, ok = [], []
+    for j, b in enumerate(basis, 1):
+        if not isinstance(b, dict) or set(b) != {"plan", "where", "quote"} or not all(isinstance(b[k], str) for k in b):
+            errs.append(f"basis 第 {j} 項要恰好有 plan、where、quote 三個字串")
+            continue
+        n = _real_chars(_kt_sit_quote_norm(b["quote"]))
+        if len(b["quote"]) > _CHOICE_LAYER_QUOTE_RAW:
+            errs.append(f"basis 第 {j} 項引句原始長度超過上限({_CHOICE_LAYER_QUOTE_RAW} 字元)")
+            continue
+        if n < _CHOICE_LAYER_QUOTE[0] or n > _CHOICE_LAYER_QUOTE[1]:
+            errs.append(f"basis 第 {j} 項引句{'少於' if n < _CHOICE_LAYER_QUOTE[0] else '多於'} {_CHOICE_LAYER_QUOTE[0] if n < _CHOICE_LAYER_QUOTE[0] else _CHOICE_LAYER_QUOTE[1]} 實字")
+            continue
+        v = ctx.view(b["plan"]) if b["plan"] in plans else None
+        if v is None:
+            errs.append(f"basis 第 {j} 項的 plan {_kill_esc(b['plan'])[:80]} 不是這份材料涉及的計劃")
+            continue
+        is_cl = b["where"] in v["clauses"]
+        src = v["clauses"].get(b["where"]) if is_cl else dict(v["sections"]).get(b["where"])
+        if src is None:
+            errs.append(f"basis 第 {j} 項的 where {_kill_esc(b['where'])[:80]} 不是那份計劃的條款號或段名")
+        elif not _choice_layer_quote_in(b["quote"], src):
+            errs.append(f"basis 第 {j} 項的引句不在 {_kill_esc(b['where'])[:80]} 裡")
+        else:
+            ok.append((j - 1, b, is_cl, src))
+    return errs, ok
+
+
+def _choice_layer_cite(layer, ok, plans, ctx):
+    """各層「通過驗證的那一項」在 basis 的序號(顯示用,第三段代碼審 r1 邊界 #6):第 3 層是第一項有綁測試的條款、第 2 層是第一項只在正文(不在任何條款與預期值表)的段;
+    第 1、4 層或找不到 → None。ok 是 _choice_layer_basis_errs 驗過的 [(序號, 項, 是條款, 出處原文)…]。"""
+    for j, b, is_cl, _s in ok:
+        if layer == 3 and is_cl and b["where"] in ctx.view(b["plan"])["bound"]:
+            return j
+        if layer == 2 and not is_cl and not any(_choice_layer_quote_in(b["quote"], (ctx.view(p) or {}).get("block")) for p in plans):
+            return j
+    return None
+
+
+def _choice_layer_rule_errs(layer, it, ok, plans, ctx):
+    """各層的出處要求(〈範圍〉9):第 3 層至少一項是有綁測試的條款(不是 [manual:] 或 [keeps]);第 2 層至少一項是段名、引句不在任何條款原文與預期值表裡;
+    第 1 層問題含「當」「要」「還是」「現在」;第 4 層理由至少 10 實字。"""
+    if layer == 3 and _choice_layer_cite(3, ok, plans, ctx) is None:
+        return ["第 3 層要至少一項 where 是那份計劃有綁測試的條款號(不是 [manual:] 或 [keeps]),引句出自那條條款"]
+    if layer == 2 and not any(not is_cl for _j, _b, is_cl, _s in ok):
+        return ["第 2 層要至少一項 where 是計劃正文的段名,引句出自那一段"]
+    if layer == 2 and _choice_layer_cite(2, ok, plans, ctx) is None:
+        return ["第 2 層的引句也在條款原文或預期值表裡(條款收了就是第 3 層)"]
+    if layer == 1 and not all(w in str(it.get("question", "")) for w in _CHOICE_LAYER_Q_WORDS):
+        return ["第 1 層的 question 要寫成「當…時,要 A 還是 B,現在程式是哪個」(含「當」「要」「還是」「現在」)"]
+    if layer == 4 and _real_chars(str(it.get("reason", ""))) < _CHOICE_LAYER_REASON_MIN:
+        return [f"第 4 層的 reason 要至少 {_CHOICE_LAYER_REASON_MIN} 個實字"]
+    return []
+
+
+def _choice_layer_item_errs(it, lst, seen, ctx, cites):
+    """一筆判讀的全部檢查 → 錯誤句清單(空的是合格);cites 收每個鍵通過驗證的那一項序號(_choice_layer_cite,寫進判讀檔的 cite)。"""
+    if not isinstance(it, dict):
+        return ["要是物件"]
+    extra = sorted(set(it) - set(_CHOICE_LAYER_KEYS))
+    if extra:
+        return [f"有不認得的欄位 {'、'.join(_kill_esc(str(k))[:40] for k in extra[:5])}"]
+    key = f"{it.get('file')}\t{it.get('fp')}"
+    if not isinstance(it.get("file"), str) or not isinstance(it.get("fp"), str) or key not in lst["items"]:
+        return ["file+fp 不在這份清單裡"]
+    if key in seen:
+        return ["同一個鍵出現兩次"]
+    seen.add(key)
+    if type(it.get("layer")) is not int or not 1 <= it["layer"] <= 4:
+        return ["layer 要是 1 到 4 的整數"]
+    plans = lst["items"][key].get("plans") or []
+    errs = _choice_layer_str_errs(it)
+    berrs, ok = _choice_layer_basis_errs(it.get("basis", []), plans, ctx)
+    cites[key] = _choice_layer_cite(it["layer"], ok, plans, ctx)
+    return errs + berrs + _choice_layer_rule_errs(it["layer"], it, ok, plans, ctx)
+
