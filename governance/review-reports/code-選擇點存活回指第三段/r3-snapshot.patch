+def _choice_layer_side(lid, plan):
+    """一份計劃的正文旁檔(repo 相對路徑):<工作目錄>/choice-layer/<清單編號>-plan-<計劃路徑雜湊前 12 碼>.md。"""
+    return f"{_NOTE_AUDIT_WORK_DIR}/{_CHOICE_LAYER_WORK}/{lid}-plan-{_choice_sha(str(plan), 12)}.md"
