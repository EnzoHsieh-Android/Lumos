+        return _situation_rule_say(f"choice-layer:清單 {lid} 第 1 份讀回失敗({why});重跑 `lumos choice-layer --template`")
+    print(first, end="")
+    print(f"choice-layer:清單 {lid},{len(xs)} 個存活分成 {len(parts)} 份;這是第 1 份。其他份:lumos choice-layer --part <n> --list {lid};"
+          f"派全新代理只看材料判讀,結果存成 JSON 後 lumos choice-layer <結果.json> --list {lid}", file=sys.stderr)
