+def _choice_layer_list(rr, lid):
+    """讀份清單 → (清單 dict, 工作目錄) 或 (None, None)(編號不合格式、工作目錄拿不到、檔不在或壞掉)。"""
+    import json as _j
+    if not re.fullmatch(r"[0-9a-f]{12}", str(lid or "")):
+        return None, None
+    wd, _why = _choice_layer_work(rr)
+    if wd is None:
+        return None, None
+    try:
+        d = _j.loads((wd / f"{lid}.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError, UnicodeDecodeError):
+        return None, None
+    ok = isinstance(d, dict) and isinstance(d.get("parts"), list) and isinstance(d.get("items"), dict) and isinstance(d.get("at_sha"), str) and isinstance(d.get("rng"), str)
+    return (d, wd) if ok and _choice_layer_list_inner_ok(d) else (None, None)
