+    ctx = _choice_layer_ctx_here(sc["rr"], sc["guard"], sc["blobs"])
+    segs = _choice_seg_fill(sc, _choice_nsha(surv), ctx)
+    xs = _choice_layer_want(sc, segs, set(redo or ()))
+    if not xs:
