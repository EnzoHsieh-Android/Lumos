+def _choice_layer_reject(bad):
+    """整份拒收的輸出(照情境題盲判:前綴「擋下:」、最多列 10 條再印另有 N 處;r1 架構對齊 #2)→ rc 2。"""
+    if not bad:
+        print("擋下:判讀結果是空的,整份沒寫", file=sys.stderr)
+        return 2
+    print(f"擋下:判讀結果有 {len(bad)} 處不合,整份沒寫:", file=sys.stderr)
+    for e in bad[:10]:
+        print(f"  - {e}", file=sys.stderr)
+    if len(bad) > 10:
+        print(f"  …另有 {len(bad) - 10} 處", file=sys.stderr)
+    return 2
