+def _choice_layer_list_inner_ok(d):
+    """份清單內層形狀(r1 邊界 #4:不對時當成清單不在、不丟堆疊):parts 每份是帶整數 n、字串 sha、清單 keys 的物件;items 每個值是帶字串 new_sha、清單 plans 的物件。"""
+    parts_ok = all(isinstance(p, dict) and type(p.get("n")) is int and isinstance(p.get("sha"), str) and isinstance(p.get("keys"), list) for p in d["parts"])
+    items_ok = all(isinstance(v, dict) and isinstance(v.get("new_sha"), str) and isinstance(v.get("plans"), list) for v in d["items"].values())
+    return parts_ok and items_ok
