+    _write_lf(wd / f"{lid}.json", _j.dumps({"v": 1, "id": lid, "rng": sc["rng"], "at_sha": sc["at_sha"], "parts": parts, "items": items}, ensure_ascii=False) + "\n")
+    first, why = _choice_layer_read_part(wd, lid, 1)
