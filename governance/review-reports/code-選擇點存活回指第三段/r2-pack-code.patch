+def _choice_layer_render(sc, ctx, segs, xs, body, cache, list_id, n=None):
+    """一份材料的全文(〈用詞〉判讀材料)。xs 的編號從 1 起;n 是第幾份(分份時 None);body=False 時每份計劃的正文改指到那份計劃的旁檔
+    (_choice_layer_side;同一份清單同一份計劃只一份,各份共用)。"""
+    live = sc["guard"]["live"]
+    plans = list(dict.fromkeys(p for x in xs for p in _choice_layer_plans(x, segs[(x["file"], x["fp"])], live)[1]))
+    head = [f"# 選擇點存活判讀材料(清單 {list_id}" + (f" 第 {n} 份" if n else "") + ")", "",
+            ("下面每個存活都是:把那一行換成壞法之後,守的測試仍然全綠。請拿計劃的條款原文與正文,判條款字面能不能排除改壞後的行為、不能的話正文能不能,"
+             "照最後的作答格式回答。只看這份材料。"), "", "## 涉及的計劃", ""]
+    for p in plans:
+        v = ctx.view(p)
+        head += _choice_layer_plan_md(p, v, body, _choice_layer_side(list_id, p)) if v else [f"### 計劃 {p}", "(讀不到)", ""]
+    head += ["## 存活", ""]
+    for k, x in enumerate(xs, 1):
+        head += _choice_layer_item_md(k, x, segs[(x["file"], x["fp"])], _choice_layer_code(sc["rr"], sc["at_sha"], x, cache), ctx, live)
+    return "\n".join(head) + "\n" + _CHOICE_LAYER_ANSWER
