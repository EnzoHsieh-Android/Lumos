+    for k, it in enumerate(res, 1):
+        bad += [f"第 {k} 筆({_kill_esc(str((it or {}).get('file') if isinstance(it, dict) else '?'))[:80]}):{e}" for e in _choice_layer_item_errs(it, lst, seen, ctx, cites)]
+    if bad or not res:
