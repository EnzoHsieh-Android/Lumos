+class _ChoiceLayerCtx:
+    """一次呼叫裡判讀的讀端現場(〈範圍〉9 判讀狀態):計劃視圖、條款綁的測試與所在檔 blob、判讀檔各只算一次、存活之間共用。
+    text_of(計劃圖譜內路徑)→ 文字或 None;doc_raw(判讀檔 repo 相對路徑)→ 位元組或 None(choice-points 讀工作目錄、推送閘讀 B 版的樹);
+    blob_of {(平台, 測試名): 所在檔物件編號};split、default 拆測試引用。"""
+
+    def __init__(self, text_of, doc_raw, tidx, blob_of=None):
+        self.text_of, self.doc_raw, self.tidx, self.blob_of = text_of, doc_raw, tidx, dict(blob_of or {})
+        self._views, self._docs = {}, {}
+
+    def view(self, plan):
+        if plan not in self._views:
+            t = self.text_of(plan)
+            self._views[plan] = None if t is None else _choice_plan_view(t, self.tidx)
+        return self._views[plan]
+
+    def clause_tests(self, plan, cid):
+        """條款綁的測試清單與所在檔 blob(第 3 層的依據)。"""
+        v = self.view(plan)
+        out = []
+        for ref in (v or {}).get("refs", {}).get(cid) or []:
+            try:
+                plat, name, _ex = _split_test_ref_ex(ref, self.tidx[1], self.tidx[2])
+            except ValueError:
+                plat, name = "", ref
+            out.append([ref, str(self.blob_of.get((plat, name)) or "")])
+        return out
+
+    def doc(self, ev):
+        """layer 事件 → 判讀檔內容(dict)或 None(讀不到、雜湊對不上、不是合格的 JSON 物件:當成沒有判讀)。"""
+        rel = ev.get("judgment") or ""
+        if rel not in self._docs:
+            self._docs[rel] = _choice_layer_doc_read(rel, ev.get("judgment_sha"), self.doc_raw)
+        return self._docs[rel]
+
+    def deps(self, doc):
+        return _choice_layer_deps(doc["layer"], doc.get("basis") or [], doc.get("plans") or [], self)
+
