+def _choice_layer_read_part(wd, lid, n):
+    """第 n 份材料 → (文字, None) 或 (None, 原因):從清單取、不重算;檔讀不到或內容雜湊跟清單記的不同 → 原因。"""
+    import json as _j
+    try:
+        d = _j.loads((wd / f"{lid}.json").read_text(encoding="utf-8"))
+        part = next(p for p in d["parts"] if p.get("n") == n)
+        text = (wd / f"{lid}-{n}.md").read_text(encoding="utf-8")
+    except (OSError, ValueError, UnicodeDecodeError, StopIteration, KeyError, TypeError):
+        return None, "清單或那一份不在了"
+    return (text, None) if _choice_sha(text, 32) == part.get("sha") else (None, "那一份的內容跟清單記的不同")
