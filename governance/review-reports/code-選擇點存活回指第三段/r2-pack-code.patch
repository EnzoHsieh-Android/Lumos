+        return _situation_rule_say("清單不在了,重跑 `lumos choice-layer --template`" if lst is None else f"結果檔 {_kill_esc(str(result))[:120]} 讀不到或不是 JSON 陣列")
+    sc = _choice_layer_scope_at(env, rr, lst)
