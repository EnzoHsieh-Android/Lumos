+def _choice_layer_write(rr, lst, res, ctx, cites=None):
+    """驗過的判讀全部寫:判讀檔(檔名是內容雜湊、原子換名、單份上限)與 layer 事件(單筆不超過 4096 位元組,_gate_event 的上限)。
+    寫任何東西之前先把每份判讀檔組好、整份預檢大小,任一份超過 _CHOICE_LAYER_DOC_MAX 就整份拒收、什麼都不寫(第三段代碼審 r1 M3:原本寫到一半停在第 N 筆)。"""
