+def _choice_plan_view(text, tidx):
+    """一份計劃 → 判讀用的視圖:clauses {條款號: 定義行原文}、bound(有綁測試的條款號:綁了 [test:] 而且不是 [keeps];[manual:] 不算)、
+    refs {條款號: [測試引用…]}、expected(預期值表那一節的原文)、sections(_choice_plan_sections)、block(條款原文接預期值表,第 2 層的「仍不在條款裡」)、
+    all(條款全文接正文,第 1、4 層的依據)。tidx 是 _platform_test_index 的結果(clause_bindings 認測試用)。"""
+    _pd, split, default, methods_for, hay_for, _loose = tidx
+    lines = _note_lines(text)
+    rows = [r for r in clause_bindings(text, split, default, methods_for, hay_for) if r.get("defined")]
+    keeps, _variant = _spec_gate_keeps_rows(text, rows)
+    clauses = {r["id"]: lines[r["line"] - 1] if 0 < r["line"] <= len(lines) else "" for r in rows}
+    bound = {r["id"] for r in rows if r.get("refs") and r["id"] not in keeps}
+    exp = "\n".join(ln for _no, ln in _h2_section_lines(text, _EXPECTED_H2_RE) or [])
+    secs = _choice_plan_sections(text)
+    ids = sorted(clauses, key=lambda c: int(c[1:]))
+    cl = "\n".join(f"{c}\t{clauses[c]}" for c in ids)
+    return {"clauses": clauses, "bound": bound, "refs": {r["id"]: list(r.get("refs") or []) for r in rows}, "expected": exp, "sections": secs,
+            "block": cl + "\n" + exp, "all": cl + "\n" + "\n".join(f"{n}\t{t}" for n, t in secs)}
