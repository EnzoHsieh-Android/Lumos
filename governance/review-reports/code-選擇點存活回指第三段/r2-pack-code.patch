+def _choice_layer_plan_md(p, v, body, side=None):
+    """材料裡一份計劃那一段:全部條款(標有綁測試的)、預期值表、分段正文(body=False 只附段名清單,正文在 side 那支旁檔)。"""
+    out = [f"### 計劃 {p}", "#### 驗收條款(條款號:定義行原文)"]
+    for cid in sorted(v["clauses"], key=lambda c: int(c[1:])):
+        out.append(f"- {cid}{'(有綁測試)' if cid in v['bound'] else ''}:{v['clauses'][cid]}")
+    out += ["#### 預期值表", v["expected"] or "(沒有)", "#### 計劃正文(段名與原文)" if body else f"#### 計劃正文(段名清單;全文在 `{side}`,判讀時要讀)"]
+    for name, txt in v["sections"]:
+        out += ([f"##### {name}", txt] if body else [f"- {name}"])
+    return [*out, ""]
+
