+def _choice_plan_sections(text):
+    """計劃正文分段(〈用詞〉計劃正文)→ [(段名, 原文)]:frontmatter、〈驗收條款〉、〈預期值表〉、〈審計修正紀錄〉以外;段名是二級標題起到最近標題的路徑
+    (〈範圍〉/〈1. 覆蓋〉),同名加 #2;第一個二級標題前的文字(含一級標題底下)段名〈前言〉。標題只認圍欄外的(_visible_lines);空段不收。"""
+    lines = _note_lines(text)
+    start = _choice_fm_end(lines)
+    visible = {no for no, _ln in _visible_lines(lines)}
+    stack, name, buf, out, seen = [], "〈前言〉", [], [], {"〈前言〉": 1}   # 初始段名也登記:一級標題後的〈前言〉才會編成 #2(r1 邊界 #3、通才 #3)
+
+    def flush():
+        body = "\n".join(buf).strip()
+        if body and not (stack and _CHOICE_LAYER_NOT_BODY_RE.match(stack[0][1])):
+            out.append((name, body))
+    for no in range(start + 1, len(lines) + 1):
+        m = _CHOICE_HEAD_RE.match(lines[no - 1]) if no in visible else None
+        if m is None:
+            buf.append(lines[no - 1])
+            continue
+        flush()
+        buf, lv = [], len(m.group(1))
+        stack = [] if lv == 1 else [x for x in stack if x[0] < lv] + [(lv, m.group(2).strip())]
+        base = "/".join(f"〈{t}〉" for _l, t in stack) or "〈前言〉"
+        seen[base] = seen.get(base, 0) + 1
+        name = base if seen[base] == 1 else f"{base}#{seen[base]}"
+    flush()
+    return out
+
+
+def _choice_fm_end(lines):
+    """frontmatter 結尾那一行的行號(0 起算的「下一行之前」:沒有 frontmatter 回 0)。"""
+    if not lines or lines[0].strip() != "---":
+        return 0
+    for i in range(1, len(lines)):
+        if lines[i].strip() == "---":
+            return i + 1
+    return 0
+
