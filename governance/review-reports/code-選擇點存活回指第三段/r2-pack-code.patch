+def _choice_layer_plans(x, seg, live):
+    """一個存活的主計劃與涉及的計劃(〈範圍〉8 分份):有效 reach 有經過條款 → 主計劃是第一條經過條款的計劃、涉及經過的條款所屬的計劃;
+    沒有 → 主計劃 None(未歸計劃)、涉及碰到的全部計劃。"""
+    _st, r, ok = seg
+    cl = [str(c) for c in (r or {}).get("reach_clauses") or []] if ok and (r or {}).get("reach") == "clause" else []
+    plans = list(dict.fromkeys(c.split("#S")[0] + ".md" for c in cl if "#S" in c))
+    plans = [p for p in plans if p in live]
+    return (plans[0], plans) if plans else (None, list(live))
+
+
+def _choice_layer_split(groups, render):
+    """分份(〈範圍〉8;第三段代碼審 r1 O1 改):groups [(主計劃或 None, [存活…])](已排好序)→ [(存活清單, 材料文字, 正文另存與否, 超過上限的原因或空字串)…]。
+    每份最多 _CHOICE_LAYER_PART_MAX 個;render(存活清單, 附正文) 的 UTF-8 位元組數超過 _CHOICE_LAYER_PART_BYTES 時先改成計劃正文另存旁檔(存活數不變);
+    仍超過時看是不是共用的計劃材料本身就超過(只放一個存活、正文另存也超過):是 → 不再減半、照這個存活數出,標原因(實驗專案 75 個存活原本切成 75 份);
+    不是 → 存活數減半再切。"""
+    parts = []
+    for _plan, items in groups:
+        i = 0
+        while i < len(items):
+            n = min(_CHOICE_LAYER_PART_MAX, len(items) - i)
+            parts.append(_choice_layer_one_part(items[i:i + n], render))
+            i += len(parts[-1][0])
+    return parts
+
+
+def _choice_layer_over(text):
+    return len(text.encode("utf-8")) > _CHOICE_LAYER_PART_BYTES
+
+
+def _choice_layer_one_part(chunk, render):
+    """從 chunk 起切出一份 → (存活清單, 材料文字, 正文另存與否, 超過原因)。"""
+    text = render(chunk, True)
+    if not _choice_layer_over(text):
+        return chunk, text, False, ""
+    if _choice_layer_over(render(chunk[:1], False)):   # 共用的計劃材料本身就超過:減半也縮不下來
+        return chunk, render(chunk, False), True, "涉及計劃的條款與預期值表本身就超過上限,這份照存活數出"
+    n = len(chunk)
+    while n > 1 and _choice_layer_over(render(chunk[:n], False)):
+        n = max(1, n // 2)
+    return chunk[:n], render(chunk[:n], False), True, ""
+
+
+def _choice_layer_groups(xs, segs, live):
+    """依主計劃分組:計劃名排序,未歸計劃那組放最後;組內照改到的行的順序。"""
+    by = {}
+    for x in xs:
+        main, _pl = _choice_layer_plans(x, segs[(x["file"], x["fp"])], live)
+        by.setdefault(main, []).append(x)
+    return [(p, by[p]) for p in sorted(k for k in by if k is not None)] + ([(None, by[None])] if None in by else [])
+
+
+def _choice_layer_code(rr, at_sha, x, cache):
+    """包住那一行的宣告(取法同 _kt_sit_material;取不到時改附前後各 20 行)→ (起行, 迄行, 原文)。讀被讀版本的那支檔(同一支檔只讀一次)。"""
+    if x["file"] not in cache:
+        try:
+            text = _kt_sit_read_many(rr, at_sha, [x["file"]]).get(x["file"]) or ""
+        except (_KtSitUnverifiable, OSError, subprocess.TimeoutExpired):
+            text = ""
+        lines = text.split("\n")
+        stripped = _strip_c_comments(text, blank_strings=True, keep_length=True, kotlin=True).split("\n")
+        cache[x["file"]] = (lines, stripped, _kt_sit_levels("\n".join(stripped)), {})
+    lines, stripped, levels, mc = cache[x["file"]]
+    ln = int(x["line"])
+    mat = _kt_sit_material(stripped, levels, ln, mc) if 0 < ln <= len(stripped) else None
+    a, b = mat if mat else (max(1, ln - 20), min(len(lines), ln + 20))
+    return a, b, "\n".join(lines[a - 1:b])
+
+
+def _choice_layer_fence(text):
+    """包程式碼的圍欄:比內容裡最長的反引號串多一個(至少 3 個)。"""
+    runs = [len(m.group(0)) for m in re.finditer(r"`+", text)]
+    return "`" * max(3, max(runs, default=0) + 1)
+
+
+def _choice_layer_item_md(k, x, seg, code, ctx, live):
+    """材料裡一個存活那一段(〈用詞〉判讀材料):位置、鍵、型錄列號與類別、壞法(原文 → 改壞後)、覆蓋分類與經過的條款原文、包住那一行的宣告;
+    不含任何已記的層、處置提示或放行理由。"""
+    ident = x["mutant"]["identity"]
+    _st, r, ok = seg
+    a, b, src = code
+    cls = _choice_reach_text(r) if ok else "未分類(沒有有效的覆蓋分類)"
+    out = [f"### 存活 {k}:{x['file']}:{x['line']}", f"- 鍵:file = `{x['file']}`、fp = `{x['fp']}`", f"- 型錄列號與類別:{x['mutant']['row']} {x['mutant'].get('category', '')}",
+           f"- 覆蓋分類:{cls}"]
+    for c in ((r or {}).get("reach_clauses") or []) if ok and (r or {}).get("reach") == "clause" else []:
+        p, _s, cid = str(c).partition("#")
+        v = ctx.view(p + ".md") if ctx is not None else None
+        out.append(f"  - {c} 原文:{(v or {}).get('clauses', {}).get(cid, '(讀不到)')}")
+    why = x["mutant"].get("why")
+    if why and str(why).strip() not in ("", "—", "(無)"):
+        out.append(f"- 型錄說明(這種改法為什麼行為不同):{why}")
+    for label, txt in (("原文", ident["old"]), ("改壞後", ident["new"])):
+        f = _choice_layer_fence(txt)
+        out += [f"- 壞法{label}:", f + "kotlin", txt, f]
+    f = _choice_layer_fence(src)
+    out += [f"- 包住那一行的程式(第 {a} 到 {b} 行):", f + "kotlin", src, f, ""]
+    return out
+
