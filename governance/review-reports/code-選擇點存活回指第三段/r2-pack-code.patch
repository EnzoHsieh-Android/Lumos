+def _choice_layer_state(ent, new_sha, ctx):
+    """一行的判讀狀態(〈用詞〉判讀狀態)→ None(沒有判讀:沒有 layer 事件、最後一筆是撤回、壞法身分變了(作廢)、判讀檔讀不到或雜湊對不上)或
+    {"layer", "pending"(依據變了、待複核), "doc"}。同一鍵取帳上最後一筆 layer 事件(_choice_ledger_aux)。"""
+    ev = (ent or {}).get("layer")
+    if ev is None or ev["layer"] == 0 or ev["new_sha"] != new_sha:
+        return None
+    doc = ctx.doc(ev)
+    if doc is None:
+        return None
+    return {"layer": ev["layer"], "pending": ctx.deps(doc) != ev["deps_sha"], "doc": doc}
