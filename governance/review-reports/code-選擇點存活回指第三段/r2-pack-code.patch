+def _choice_layer_doc_read(rel, sha, doc_raw):
+    """判讀檔 → dict 或 None:路徑要是 governance/choice-layers/<64 位十六進位>.json、內容的 sha256 等於檔名也等於事件記的 judgment_sha、
+    單份不超過 _CHOICE_LAYER_DOC_MAX、是帶 layer(1 到 4 的整數)、basis(清單)、plans(清單)的 JSON 物件。"""
+    import hashlib
+    import json as _j
+    name = rel[len(_CHOICE_LAYER_DIR) + 1:] if rel.startswith(_CHOICE_LAYER_DIR + "/") else ""
+    if not _CHOICE_LAYER_NAME_RE.fullmatch(name) or name[:-5] != sha:
+        return None
+    raw = doc_raw(rel)
+    if raw is None or len(raw) > _CHOICE_LAYER_DOC_MAX or hashlib.sha256(raw).hexdigest() != sha:
+        return None
+    try:
+        d = _j.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError):
+        return None
+    ok = isinstance(d, dict) and type(d.get("layer")) is int and 1 <= d["layer"] <= 4 and isinstance(d.get("basis"), list) and isinstance(d.get("plans"), list)
+    return d if ok else None
+
+
+def _choice_layer_deps(layer, basis, plans, ctx):
+    """判讀依據指紋 deps_sha(〈範圍〉9 的表):第 3 層 = 引的每條條款原文、那條條款綁的測試清單與所在檔 blob;第 2 層 = 引句所在那一段的原文、
+    涉及的每份計劃的全部條款原文與預期值表;第 1、4 層 = 涉及的每份計劃的條款全文加正文(不含 frontmatter 與審計修正紀錄)。計劃讀不到記 None(一定對不上)。"""
+    import json as _j
+    parts = []
+    for b in basis if layer in (2, 3) else ():
+        if not isinstance(b, dict):
+            continue
+        v = ctx.view(str(b.get("plan")))
+        where = str(b.get("where"))
+        if layer == 3:
+            parts.append([b.get("plan"), where, (v or {}).get("clauses", {}).get(where), ctx.clause_tests(str(b.get("plan")), where)])
+        else:
+            parts.append([b.get("plan"), where, dict((v or {}).get("sections") or []).get(where)])
+    for p in plans if layer != 3 else ():
+        v = ctx.view(str(p))
+        parts.append([p, (v or {}).get("block" if layer == 2 else "all")])
+    return _choice_sha(_j.dumps([layer, parts], ensure_ascii=False, sort_keys=True), 32)
+
