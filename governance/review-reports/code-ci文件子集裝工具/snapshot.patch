           if [ "${{ github.event_name }}" = push ] && [ -n "$BEFORE" ] && [ "$BEFORE" != "0000000000000000000000000000000000000000" ] \
              && git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
             out="$(python scripts/lumos pitfalls --diff "$BEFORE..$SHA" --no-lint --json --repo . 2>/dev/null || true)"
             s="$(printf '%s' "$out" | python -c 'import json,sys; d=json.load(sys.stdin); print(d.get("suite","full")); print(d.get("suite_reason","")); print("graph" if d.get("suite_graph") else "")' 2>/dev/null || printf 'full\nlumos 算不出來\n')"
             suite="$(printf '%s' "$s" | sed -n 1p)"; why="$(printf '%s' "$s" | sed -n 2p)"; graph="$(printf '%s' "$s" | sed -n 3p)"
             [ "$suite" = docs ] || suite=full
           fi
           echo "suite=$suite" >> "$GITHUB_OUTPUT"
           echo "graph=$graph" >> "$GITHUB_OUTPUT"
           echo "測試範圍:$suite($why)"
+      # 文件子集裡也有要外部工具的測試(例:t_detekt_compose_rules_shared_config),CI 上沒裝會判紅(2026-11-08 #178 合併後撞到)
+      - name: 裝測試要的外部工具(文件子集)
+        if: steps.suite.outputs.suite == 'docs'
+        uses: ./.github/actions/test-tools
       - name: 純文件推送的文件子集
         if: steps.suite.outputs.suite == 'docs'
         env:
           GRAPH: ${{ steps.suite.outputs.graph }}
         run: |
           set -u
           extra="--suite docs"; echo "純文件推送:只跑文件子集(--suite docs),不跑全套"
           if [ "$GRAPH" = graph ]; then extra="$extra --graph"; echo "含圖譜筆記:加跑讀真圖譜的測試(--graph)"; fi
           rc=0
           for i in 1 2 3 4; do
             python scripts/test_lumos.py --shard "$i/4" $extra > "/tmp/shard-$i.log" 2>&1 &
           done
           for job in $(jobs -p); do wait "$job" || rc=1; done
-          for i in 1 2 3 4; do echo "===== 第 $i 片 ====="; tail -25 "/tmp/shard-$i.log"; done
+          for i in 1 2 3 4; do
+            echo "===== 第 $i 片 ====="
+            # 紅的時候先撈失敗的斷言與所在測試(tail 只看得到尾巴;2026-11-08 文件子集紅了查不出名字,照全套那步補)
+            grep -nE "^  ✗|EXCEPTION" "/tmp/shard-$i.log" | tail -40 || true
+            tail -25 "/tmp/shard-$i.log"
+          done
           exit $rc
   shards:
     needs: prep
     if: needs.prep.outputs.suite == 'full'
     runs-on: ubuntu-latest
     timeout-minutes: 30
     strategy:
       fail-fast: false
       matrix:
         # 每台跑幾份、共幾份:Projects/CI加速_計劃〈做法〉0 量出來的(一台同時跑兩份不會變慢,瓶頸是每份的量);改台數時兩處一起改,t_ci_yml_matrix_and_gates_shape 守 1..N 各一次
@@ -131,58 +140,24 @@ jobs:
           fetch-depth: 0   # code-loop gate 要算 before..sha 的 diff(體檢 #5);全套與範圍判定也要歷史
       # PR 事件取出的是不在任何分支上的合併提交,本機只有 origin/main、沒有 main;找主線的測試(main@{upstream})
       # 會整支紅。補一個追蹤 origin/main 的本機 main,讓 PR 跟推到 main 時是同一種環境(2026-10-03 第一個 PR 實際踩到)。
