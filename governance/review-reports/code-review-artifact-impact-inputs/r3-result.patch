   x = str(x).strip()\n    return x in (\"\", \"null\", \"~\") or x.startswith(\"#\")\n\n\ndef _system_ref_item(env, item):\n    \"\"\"system_refs 的一項 → (Systems rel, None) 或 (None, 原因與改法);判法就是具名欄位的 _typed_link_target,只多「要落在 Systems」。\"\"\"\n    if _system_ref_blank(item):\n        return None, \"空的項——拿掉,或寫成 [[Systems/X]]\"\n    kind, val = _typed_link_target(env, item)\n    raw = str(item).strip()\n    if kind == \"ok\":\n        return (val[0], None) if val[0].startswith(\"Systems/\") else (None, f\"指到的 {val[0]} 不是功能筆記(Systems/)\")\n    if kind == \"skip\":\n        return None, \"空的項——拿掉,或寫成 [[Systems/X]]\"\n    if kind == \"scalar\":\n        return None, (\"一行寫了多個連結——拆成一項一行\" if raw.count(\"[[\") > 1\n                      else \"不是單一連結(多寫了字、純文字路徑或括號不對)——整項只寫 [[Systems/X]]\")\n    if kind == \"ghost\":\n        return None, \"找不到這篇——寫了路徑的要跟檔案路徑完全一致(大小寫也算),或只寫檔名\"\n    return None, \"同名的有好幾篇(\" + \"、\".join(val[1][:3]) + \")——寫完整路徑 [[Systems/X]]\"\n\n\ndef _verification_system_targets(env, rel, n):\n    \"\"\"一份驗收紀錄驗了哪些功能(Projects/驗收紀錄寫明驗了哪些功能_計劃〈做法〉2)→ None(已失效或作廢,呼叫端照各自原本的規則)\n    或 (宣告了沒, {Systems rel}, [(原文, 原因與改法)])。\n    沒有 system_refs 鍵 → 沒宣告,照舊用 n.targets 落在 Systems/ 的;有 → 只看它,逐項照具名欄位的單項規則判,寫壞的全列,\n    ★寫壞不默默當成沒驗★(設計審 r1 三席:鍵在而解出來空,等於靜默關掉檢查)。\"\"\"\n    if _verification_status(env, rel) in _VERIF_INACTIVE:\n        return None\n    if \"system_refs\" not in n.fields:\n        got = set()\n        for t in n.targets:\n            d = env.resolve(t)\n            if d and d.startswith(\"Systems/\"):\n                got.add(d)\n        return False, got, []\n    if \"system_refs\" in n.block_keys:\n        return True, set(), [(\"system_refs: |\", \"區塊寫法讀不出清單——改成一項一行的 - \\\"[[Systems/X]]\\\"\")]\n    raw_items = as_list(n.fields.get(\"system_refs\"))\n    items = raw_items if any(not _system_ref_blank(x) for x in raw_items) else []   # 全是空的才算「讀不出任何一項」;混在好項裡的照報空的項(r2 通才席)\n    got, bad = set(), []\n    for it in items:\n        dest, why = _system_ref_item(env, it)\n        if dest:\n            got.add(dest)\n        else:\n            bad.append((str(it).strip() or \"(空字串)\", why))\n    if not items:\n        bad.append((\"system_refs\", \"讀不出任何一項——空的,或清單項沒縮排\"))\n    return True, got, bad\n\n\nTYPED_EDGE_FIELDS = (\"verified_by\", \"plan_refs\", \"related\")\n\n\ndef build_typed_index(env):\n    \"\"\"[M2/P0] typed-edge 反向索引——從 frontmatter 具名欄位(verified_by/plan_refs/related)建\n    「每節點 ← 誰、以哪種邊型指向我」。補 Env.edges 無型別的洞(建圖層以 target 去重丟來源欄位)。\n    每次呼叫現建現用(天生新鮮、無持久化=無腐爛)。合約(關係層主網 M2):\n    - 只索引「整個值恰為一個 wikilink」(沿 load_vault fm_targets 規則);殘留 scalar → scalars\n      warnings、不進索引(不靜默納入)。block scalar 欄位整段排除(鐵則 2)。\n    - ghost(unresolved)→ ghosts 清單(不靜默丟);path 式不 fallback 到 stem(那是靜默猜)。\n    - 同名無路徑 [[X]] 多篇候選 → ambiguous + 候選清單(嚴禁靜默指第一篇——不走 env.resolve,\n      直接查 by_stem 候選數)。\n    - 去重鍵 (source, target字面, type);ambiguous 條目 target=原 wikilink 字面。\n    回傳 dict: rev={target_rel:[(source_rel,etype)]} fwd={source_rel:{etype:[target_rel]}}\n              ghosts=[(src,字面,etype)] ambiguous=[(src,字面,etype,[候選])] scalars=[(src,etype,值)]\"\"\"\n    rev = defaultdict(list)\n    fwd = defaultdict(lambda: defaultdict(list))\n    ghosts, ambiguous, scalars = [], [], []\n    seen = set()\n    for rel, n in sorted(env.notes.items()):\n        for etype in TYPED_EDGE_FIELDS:\n            if etype in n.block_keys:\n                continue\n            for item in as_list(n.fields.get(etype)):\n                kind, val = _typed_link_target(env, item)   # 單項判法共用(驗收紀錄的 system_refs 也用它)\n                if kind == \"skip\":\n                    continue\n                if kind == \"scalar\":\n                    scalars.append((rel, etype, val))\n                    continue\n                t = val[1] if kind == \"ok\" else (val[0] if kind == \"ambiguous\" else val)\n                key = (rel, t, etype)\n                if key in seen:\n                    continue\n                seen.add(key)\n                if kind == \"ok\":\n                    rev[val[0]].append((rel, etype))\n                    fwd[rel][etype].append(val[0])\n                elif kind == \"ghost\":\n                    ghosts.append((rel, t, etype))\n                else:\n                    ambiguous.append((rel, t, etype, val[1]))\n    return {\"rev\": rev, \"fwd\": fwd, \"ghosts\": ghosts, \"ambiguous\": ambiguous, \"scalars\": scalars}\n\n\n    if standalone:\n        # inline cytoscape/marked(去 CDN,防火牆/離線可開);字體退化系統字(移除 google link)\n        vendor = Path(__file__).resolve().parent / \"vendor\"\n        for name, (url, tag) in _VIZ_LIBS.items():\n            try:\n                src = _fetch_text(url, vendor / f\"{name}.min.js\").replace(\"</script\", \"<\\\\/script\")\n            except Exception as e:\n                print(f\"擋下:--standalone 模式要先下載 {name},這台機器至少要連一次網,現在抓不到: {e}\", file=sys.stderr)\n                return 2\n            html = html.replace(tag, f\"<script>{src}</script>\")\n        html = html.replace(_FONT_LINKS, \"<!-- standalone: 字體退化系統字(無外部 CDN) -->\")\n    Path(out_path).write_text(html, encoding=\"utf-8\")\n    mode = \"standalone(自包含/離線可開)\" if standalone else \"CDN\"\n    print(f\"✓ export html [{mode}]: {out_path}  ({len(model['nodes'])} 節點 / {len(model['edges'])} 邊)\")\n    return 0\n\n\n# ═══════════════════════ 階段三: 寫側 T1(行級手術) ═══════════════════════\n\nSCALAR_KEYS = {\"status\", \"updated\", \"created\", \"type\", \"self_audit\", \"signed_off\", \"regen\", \"pitfall_ask\", \"pitfall_source\", \"about_code_stamp\", \"responsibility\"}  # pitfall_* 2026-08-09 已知坑策展庫;about_code_stamp 2026-08-23(語意欄位基礎,計劃:固定席扇出降權)\nLIST_KEYS = {\"verified_by\", \"plan_refs\", \"related\", \"tags\", \"aliases\", \"pitfall_when\", \"core_refs\", \"about_code\", \"lands_in\", \"system_refs\"}   # aliases 2026-08-05;pitfall_when 2026-08-09(已知坑策展庫,content-trigger);core_refs 2026-08-11(升格加指針/降格拆指針,兩向都要 T1;值是純路徑非 wikilink——lumos-core-knowledge skill 明令禁跨 vault wikilink)\n# drift fix --kind c4 證據頁印的佔位字,整欄改 valid_under/revalidate_when 時原樣留著就擋(漂移修法補強 第 2 節):\n# 第一個是預填 lumos set 指令裡要人填的那一項;後兩個是範本句裡要人從清單挑的卷證目錄與查不到時的提交。\n# 證據頁的範本與預填指令都從這裡取字面。跟 _DRIFT_PLACEHOLDER_RE(擋 drift fix 的 --reason)用途不同,不合併。\n_SET_COND_SLOTS = (\"<整項新內容>\", \"<卷證>\", \"<sha>\")\n_SET_COND_SLOT = _SET_COND_SLOTS[0]\n# 佔位字的打錯變體(代碼審 r1 邊界席):全形角括號、括號內多空白、sha 大小寫。★只認兩邊都有角括號、中間只有佔位字本身★:\n# 第一版也擋少一邊角括號的(<卷證、sha>),代碼審第二輪四席重現「若卷證>20個就重驗」「輸出 git-sha> 時」這種正常內容被誤擋,\n# 拿掉;<卷證 目錄>、<sha 1>、<git-sha>、<SHA-1>、<sha256> 這種括號裡還有別的字的照收。\ndef _set_cond_slot_variant_re(slot):\n    w = slot[1:-1]\n    word = f\"(?i:{w})\" if w.isascii() else w                       # sha 不分大小寫;中文字面照原樣\n    # 全形角括號寫成 \\uff1c/\\uff1e(ruff RUF001:字面的全形字元跟半形長得一樣,讀的人分不出)\n    return re.compile(\"[<\\uff1c]\" + r\"\\s*\" + word + r\"\\s*\" + \"[>\\uff1e]\")\n\n\n_SET_COND_SLOT_VARIANTS = [(x, _set_cond_slot_variant_re(x)) for x in _SET_COND_SLOTS]\n_SET_COND_SLOT_HINT = {\"<整項新內容>\": \"換成那一項改寫後的整句\", \"<卷證>\": \"換成從證據頁清單挑的卷證目錄\",\n                       \"<sha>\": \"換成真的提交編號\"}\nCOND_KEYS = (\"valid_under\", \"revalidate_when\")   # 驗收前提/回頭條件:set 整欄換掉(一個值=單行、多個=清單);spec=Projects/驗收前提欄位可改_計劃\nLINK_KEYS = (\"verified_by\", \"plan_refs\", \"related\", \"core_refs\")  # S2「純連結欄位」子集(≠LIST_KEYS:那是 append 白名單,pitfall_when=content-trigger 不算連結);spec=Projects/code側刪除傳播守衛_計劃\nDATE_KEYS = {\"updated\", \"created\", \"date\", \"decided\", \"ended\"}\nDATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n\n\ndef fm_structure(fm_lines):\n    \"\"\"回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。\n    end = 該 key 區塊最後一行的 index(含)。\"\"\"\n    out = []\n    i, n = 0, len(fm_lines)\n    while i < n:\n        m = TOP_KEY_RE.match(fm_lines[i])\n        if not m:\n            i += 1\n            continue\n        key, val = m.group(1), m.group(2).strip()\n        start = i\n        if val in (\"|\", \"|-\", \">\", \">-\"):\n            i += 1\n            while i < n and (fm_lines[i].startswith(\"  \") or not fm_lines[i].strip()):\n                i += 1\n            out.append((key, start, i - 1, \"block\"))\n        elif val == \"\":\n            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),\n            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)\n            i += 1\n            while i < n and (fm_lines[i].startswith(\" \") or not fm_lines[i].strip()):\n                i += 1\n            out.append((key, start, i - 1, \"list\"))\n        elif val == \"[]\":\n            # YAML 合法空清單(範本 `aliases: []` 就是這樣寫)。2026-08-23 前被判成 scalar →\n            # 從範本建的節點第一次 append 必敗,全庫 15 篇在此狀態。★只認空的 `[]`★,\n            # 非空 inline list(`[a, b]`)仍當 scalar——那要真的解析逗號與引號,不在本次,\n            # 且 append 遇到它會被擋(不會壞),可接受。\n            out.append((key, start, start, \"list\"))\n            i += 1\n        else:\n            out.append((key, start, start, \"scalar\"))\n            i += 1\n    return out\n\n\n# 標準 YAML(1.1/1.2,Obsidian 用的 js-yaml)不加引號會讀成數字、日期、無限大的寫法——這些要加引號才是字串\n# (2026-09-26 代碼審 r2 通才席:原本只認十進位整數與小數)。日期欄位(DATE_KEYS)刻意不加引號,走另一條路,不經這裡。\n_YAML_TYPED_RE = re.compile(\n    r\"[-+]?(\\d[\\d_]*(\\.[\\d_]*)?|\\.\\d[\\d_]*)([eE][-+]?\\d+)?\"       # 十進位、小數、科學記號\n    for rel, n in sorted(env.notes.items()):\n        stamp = n.fields.get(\"about_code_stamp\")\n        if not isinstance(stamp, str):\n            continue\n        if stamp.split(\"/\", 1)[0].strip() == want:\n            targets.append((rel, [str(x) for x in as_list(n.fields.get(\"about_code\"))]))\n    if not targets:\n        print(f\"擋下:沒有任何節點的 about_code_stamp 第一段是 {want},沒東西可撤。\"\n              f\"(人工修正過的會是 claude/… 之類,不算批次;日期格式 YYYY-MM-DD)\", file=sys.stderr)\n        return 2\n    print(f\"{'[dry-run] ' if dry_run else ''}批次 {want}:{len(targets)} 篇\")\n    for rel, vals in targets:\n        print(f\"  {rel}  about_code {len(vals)} 項\")\n    if dry_run:\n        return 0\n    done, failed = 0, 0\n    for rel, vals in targets:\n        # std-r1 s3f8:單篇任一值拿不掉 → ★stamp 留著★(下次 revert 還找得到它)、不算撤成功;\n        # 值先去重——清單重複時第一次 re