[\"git\", *a], cwd=d, capture_output=True, text=True)\n 22158\t        g(\"init\", \"-q\", \"-b\", \"main\")\n 22159\t        g(\"config\", \"user.email\", \"t@t.t\")\n 22160\t        g(\"config\", \"user.name\", \"t\")\n 22161\t        (Path(d) / \"README.md\").write_text(\"init\\n\", encoding=\"utf-8\")\n 22162\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"init\")\n 22163\t        g(\"checkout\", \"-qb\", \"feat\")\n 22164\t        rr = Path(d) / \"governance\" / \"review-reports\" / \"code-x\"\n 22165\t        rr.mkdir(parents=True)\n 22166\t        (rr / \"r1-snapshot.patch\").write_text(\n 22167\t            \"+++ b/app.py\\n+import requests\\n+fh = open('x')\\n+requests.post('http://x')\\n\",\n 22168\t            encoding=\"utf-8\")\n 22169\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"archive artifacts\")\n 22170\t        r = _sp.run([sys.executable, GRAPHCTL, \"pitfalls\", \"--diff\", \"main..HEAD\",\n 22171\t                     \"--no-lint\", \"--json\", \"--repo\", d], capture_output=True, text=True)\n 22172\t        import json as _j\n 22173\t        data = _j.loads([l for l in r.stdout.splitlines() if l.strip().startswith(\"{\")][0])\n 22174\t        check(\"★review-reports 下的證物不掃(tier 不因歸檔變 high)★\",\n 22175\t              data.get(\"tier\") != \"high\" and not data.get(\"claims\"),\n 22176\t              f\"tier={data.get('tier')} claims={data.get('claims')}\")\n 22177\t        # 收緊釘:同內容放在 review-reports 外照掃\n 22178\t        (Path(d) / \"app_real.py\").write_text(\"import requests\\nrequests.post('http://x')\\n\",\n 22179\t                                             encoding=\"utf-8\")\n 22180\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"real code\")\n 22181\t        r2 = _sp.run([sys.executable, GRAPHCTL, \"pitfalls\", \"--diff\", \"main..HEAD\",\n 22182\t                      \"--no-lint\", \"--json\", \"--repo\", d], capture_output=True, text=True)\n 22183\t        data2 = _j.loads([l for l in r2.stdout.splitlines() if l.strip().startswith(\"{\")][0])\n 22184\t        check(\"★收緊釘:真代碼照掃(排除不外溢)★\", data2.get(\"tier\") == \"high\",\n 22185\t              f\"tier={data2.get('tier')}\")\n 22186\t\n 22187\t\n 22188\tdef t_pitfalls_diff_skips_bookkeeping_ledgers():\n 22189\t    \"\"\"[2026-08-11 遞迴誤判實錄]簿記帳(docs/.governance-log.jsonl 等)被 pitfalls --diff\n 22190\t    當代碼掃——治理帳裡記的 skip 理由本身在★描述★「pitfalls 命中 open(...)」,掃描器\n 22191\t    掃到自己的歷史紀錄再次命中,tier 變 high 擋 push,只好再 skip 一次、再寫一行理由進\n 22192\t    治理帳……自我餵食的迴圈,實測已誤觸發 9 次。修=比照 review-reports 排除簿記檔白名單\n 22193\t    (與 code-loop 留痕豁免共用 _BOOKKEEPING_* 常數,避免兩處漂移)。收緊釘:同內容在白名單\n 22194\t    外照掃。\"\"\"\n 22195\t    import subprocess as _sp\n 22196\t    with tempfile.TemporaryDirectory() as d:\n 22197\t        g = lambda *a: _sp.run([\"git\", *a], cwd=d, capture_output=True, text=True)\n 22198\t        g(\"init\", \"-q\", \"-b\", \"main\")\n 22199\t        g(\"config\", \"user.email\", \"t@t.t\")\n 22200\t        g(\"config\", \"user.name\", \"t\")\n 22201\t        (Path(d) / \"README.md\").write_text(\"init\\n\", encoding=\"utf-8\")\n 22202\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"init\")\n 22203\t        g(\"checkout\", \"-qb\", \"feat\")\n 22204\t        led = Path(d) / \"docs\"\n 22205\t        led.mkdir(parents=True)\n 22206\t        # 治理帳一行:理由文字裡引用了會觸發 [資源] pattern 的字樣(真實形態)\n 22207\t        (led / \".governance-log.jsonl\").write_text(\n 22208\t            '{\"gate\": \"code-loop\", \"kind\": \"skipped\", \"detail\": \"假陽性:命中 fh = open(\\'x\\') '\n 22209\t            '——one-shot 程序退出即釋放\"}\\n', encoding=\"utf-8\")\n 22210\t        (Path(d) / \"governance\" / \"code-loop\").mkdir(parents=True)\n 22211\t        (Path(d) / \"governance\" / \"code-loop\" / \"main.json\").write_text(\n 22212\t            '{\"note\": \"fh = open(\\'y\\') 假陽\"}\\n', encoding=\"utf-8\")\n 22213\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"ledger append\")\n 22214\t        r = _sp.run([sys.executable, GRAPHCTL, \"pitfalls\", \"--diff\", \"main..HEA