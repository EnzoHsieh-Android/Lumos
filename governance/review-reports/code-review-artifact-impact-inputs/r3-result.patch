ode:   # 實作提交常只動程式檔不動筆記(編排者實測 E2):被改的檔的家也算被碰到——家對照表走唯一算法 _impact_home_map(代碼審 r2 架構席:自己掃 about_code 會漏掉 status 過濾與路徑正規化)\n  7503\t        homes, _own = _impact_home_map(env)\n  7504\t        for f in code:\n  7505\t            for srel in homes.get(_nodehome_key(f), []):\n  7506\t                systems.add(srel[:-3] if srel.endswith(\".md\") else srel)\n  7507\t    if systems:   # 落點被碰到:lands_in/related/正文連結任一指向被改的 Systems 節點(跟門判定訊號 2 同一份連結來源)\n  7508\t        for prel, n in env.notes.items():\n  7509\t            if not prel.startswith(\"Projects/\") or str(n.fields.get(\"status\")) != \"doing\":\n  7510\t                continue\n  7511\t            try:\n  7512\t                ptxt = (env.vault / prel).read_text(encoding=\"utf-8-sig\")\n  7513\t            except (OSError, UnicodeDecodeError):\n  7514\t                ptxt = \"\"\n  7515\t            if set(_plan_system_links(n, text=ptxt, systems_only=False)) & systems:\n  7516\t                plans.add(prel)\n  7517\t    return plans\n  7518\t\n  7519\t\n  7520\tdef _head_is_shebang(head, lenient=False):\n  7521\t    \"\"\"檔案開頭那段 bytes 的第一行是不是 #!(每支檔有家與 _is_code_file 共用這一支——代碼審 r2 架構席:別各寫一份)。\n  7522\t    lenient=True 先去掉 UTF-8 BOM 與行首空白(空格、tab、CR、FF、VT;不去換行,#! 在第二行照舊不算)再看:\n  7523\t    只有代碼審留痕有效性的簿記判法用(回頭重讀代碼審 r3 資安席 F2——這兩種 bash 照樣跑得起來);每支檔有家維持嚴格口徑。\"\"\"\n  7524\t    if not head:\n  7525\t        return False\n  7526\t    if lenient:\n  7527\t        head = head[3:] if head.startswith(b\"\\xef\\xbb\\xbf\") else head\n  7528\t        head = head.lstrip(b\" \\t\\r\\f\\v\")\n  7529\t    return head[:200].split(b\"\\n\", 1)[0].startswith(b\"#!\")\n  7530\t\n  7531\t\n  7532\tdef _shebang_line_is_python(first_line):\n  7533\t    \"\"\"檔案首行是不是 python 的 #!(派工鏡頭的退路與存量漂移的條件判定共用;跟 _head_is_shebang 放一起——代碼審 r3 架構對齊席)。\"\"\"\n  7534\t    return first_line.startswith(\"#!\") and \"python\" in first_line\n  7535\t\n  7536\t\n  7537\tdef _is_code_file(rr, path, base=None):\n  7538\t    \"\"\"「需要有家的程式檔」判定(每支檔有家同一套):副檔名在清單裡=是;沒副檔名要看首行是不是 #!(.gitignore/Makefile 這種不是)。\n  7539\t    磁碟上沒有(這次被刪)就從範圍起點 base 讀;兩邊都讀不到★保守當程式檔★(代碼審 r2 通才席 blocker:刪掉 hook 本身被判成沒程式檔 → light 漏派審)。\n  7540\t    豁免層也同一套(代碼審 r3 通才席):排除 glob(docs/*、node_modules、bin…)、測試檔、.lumos/config 的 ignore——這些每支檔有家不要求有家,這裡也不算程式檔。\"\"\"\n 26505\t    if as_json:\n 26506\t        print(json.dumps({\"candidates\": candidates, \"checked\": checked, \"failed\": failed},\n 26507\t                         ensure_ascii=False))\n 26508\t    else:\n 26509\t        for c in candidates:\n 26510\t            print(f\"{c['name']} {c['current']} → {c['latest']}\")\n 26511\t    return 0\n 26512\t\n 26513\t\n 26514\t# ── 每支檔有家:程式檔歸屬與寫回落點的檢查(Projects/每支檔有家_計劃,2026-09-11) ──────────────\n 26515\t# ★為什麼存在★:一篇節點在依賴行用反引號寫別人的檔,改那些檔時推筆記就推它、寫回就落它——兩個消費專案兩天內\n 26516\t# 長歪兩次、工具全綠。這一段在提交與推送的當下擋「新違規」,舊帳交給健檢提醒(決策 d1)。\n 26517\t# 單源=計劃節點;每條規則的註解標它對回的條款編號 [SN]。\n 26518\t_NODEHOME_CODE_EXTS = {\".cs\", \".vue\", \".js\", \".ts\", \".tsx\", \".jsx\", \".mjs\", \".sql\", \".py\", \".kt\", \".kts\",\n 26519\t                       \".java\", \".swift\", \".go\", \".rs\", \".c\", \".cc\", \".cpp\", \".h\", \".hpp\", \".sh\", \".ps1\"}\n 26520\t# ↑「改程式要動圖譜」那道閘的第五份副本(另外四份在提交前/提交後掛鉤與 Claude 端兩支掛鉤)——\n 26521\t#   t_code_exts_lists_agree 釘五份一致 [S1]。不借 CODE_EXTS_T:那份是符號查核用的,內容不同。\n 26522\t_NODEHOME_EXCLUDE_GLOBS = (\"docs/*\", \"*/node_modules/*\", \"*/bin/*\", \"*/obj/*\", \"*/.git/*\",\n 26523\t                           \"*/dist/*\", \"*/build/*\", \"*/__pycache__/*\")\n 26524\t# ↑ 跟提交前掛鉤 should_exclude 的目錄排除同一份(t_nodehome_required_files_definition 逐字比對)\n 26525\t_NODEHOME_HOME_STATUSES = (\"doing\", \"done\", \"stale\")   # [S2] planned/deferred 還不是現況、rejected/superseded 已不是\n 26526\t_NODEHOME_GATE_VALUES = (\"on\", \"warn\", \"off\")          # [S37]\n 26527\t_NODEHOME_MAX_FILES_DEFAULT = 3                        # [S18] 跟開新節點提示的「0~3 支」一致\n 26528\t_NODEHOME_RESP_MIN_CHARS = 10                          # [S16]\n 26529\t_NODEHOME_MSG_CAP = 10                                 # [S6] 跟「改程式沒動圖譜」那道擋下訊息同一個上限\n 26530\t_NODEHOME_GOLIVE_MARK = \"home check --staged\"          # [S39] 提交前掛鉤裡有這串=這道檢查上線了\n 26531\t\n 26532\t\n 26533\tdef _nodehome_config(repo_root, text=None, from_snapshot=False):\n 26534\t    \"\"\"讀 node_home 設定。回 {mode: on|warn|off, max_files: int, ignore: [str], warnings: [str]};壞值一律退回預設並留一句。\n 26535\t    from_snapshot=True:text 是被檢查那個版本裡 .lumos/config.json 的內容(None=那個版本沒有這支檔)——\n 26720\t    if _nodehome_in_stack_test_dir(path, layout):\n 26721\t        return True\n 26722\t    if _testmap_ext(path) in _TESTMAP_EXTS:\n 26723\t        return False                      # 測試地圖認得這種副檔名,它說不是就不是\n 26724\t    if _TESTMAP_DIR_RE is None:\n 26725\t        _TESTMAP_DIR_RE = re.compile(r\"(^|/)(tests?|__tests__|specs?)/\", re.IGNORECASE)\n 26726\t    if _TESTMAP_DIR_RE.search(path):\n 26727\t        return True\n 26728\t    name = path.rsplit(\"/\", 1)[-1]\n 26729\t    stem = _testmap_stem(path)\n 26730\t    return (\".spec.\" in name or \".test.\" in name or stem.startswith(\"test_\")\n 26731\t            or stem.lower().endswith((\"_tests\", \"_specs\", \"_test\", \"_spec\")))   # 底線變體同測試地圖(Go 的 foo_test.go)\n 26732\t\n 26733\t\n 26734\tdef _nodehome_code_kind(path):\n 26735\t    \"\"\"回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。\n 26736\t    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。\"\"\"\n 26737\t    base = path.rsplit(\"/\", 1)[-1]\n 26738\t    stripped = base.lstrip(\".\")\n 26739\t    if \".\" in stripped:\n 26740\t        return \"ext\" if (\".\" + stripped.rsplit(\".\", 1)[1]) in _NODEHOME_CODE_EXTS else None\n 26741\t    return \"shebang?\"\n 26742\t\n 26743\t\n 26744\tclass _NodehomeSide:\n 26745\t    \"\"\"一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);\n 26746\t    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);\n 26747\t    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。\n 26748\t    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。\"\"\"\n 26749\t    __slots__ = (\"files\", \"all_paths\", \"notes\", \"where\", \"_reader\", \"shebang\", \"share\", \"changed\")\n 26750\t\n 26751\t\n 26752\tdef _nodehome_git(repo_root, *args):\n 26753\t    \"\"\"跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。\"\"\"\n 26754\t    r = _lens_git(repo_root, *args, binary=True)\n 26755\t    if r is None or r.returncode != 0:\n 27070\t    if blobs is None or any(ren is None for _, ren in pairs):\n 27071\t        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)\n 27072\t        return paths, src, gone\n 27073\t    kept = set()\n 27074\t    for n, x in enumerate(order):\n 27075\t        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]\n 27076\t        if _nodehome_merge_wrote_new_lines(merged, olds):\n 27077\t            kept.add(x)\n 27078\t    return kept, {k: v for k, v in src.items() if k in kept}, gone\n 27079\t\n 27080\t\n 27081\tdef _nodehome_cat_sizes(repo_root, specs, timeout=60):\n 27082\t    \"\"\"同 _nodehome_cat_blobs 的批次讀取,只問大小(cat-file --batch-check):回同順序的 int|None(沒有這個物件=None);git 跑不起來回 None。\"\"\"\n 27083\t    import subprocess as _sp\n 27084\t    try:\n 27085\t        chk = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch-check\"],\n 27086\t                      input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n 27087\t                      capture_output=True, timeout=timeout)\n 27088\t    except (OSError, _sp.TimeoutExpired):\n 27089\t        return None\n 27090\t    if chk.returncode != 0:\n 27091\t        return None\n 27092\t    heads = chk.stdout.split(b\"\\n\")\n 27093\t    out = []\n 27094\t    for i in range(len(specs)):\n 27095\t        parts = heads[i].split(b\" \") if i < len(heads) else []\n 27096\t        out.append(int(parts[2]) if len(parts) == 3 and parts[2].isdigit() else None)\n 27097\t    return out\n 27098\t\n 27099\t\n 27100\tdef _nodehome_cat_blobs_capped(repo_root, specs, max_bytes, timeout=60):\n 27101\t    \"\"\"_nodehome_cat_blobs 加大小上限:先用 _nodehome_cat_sizes 問大小,超過 max_bytes 的回 None、不讀進記憶體\n 27102\t    (角色鏡頭代碼審 r1 外家 F6、r2 架構對齊 F1:上限放在批次讀取這一層,不另起查法)。回同順序的 bytes|None;git 跑不起來回 None。\"\"\"\n 27103\t    sizes = _nodehome_cat_sizes(repo_root, specs, timeout)\n 27104\t    if sizes is None:\n 27105\t        return None\n 27106\t    ok = [i for i, n in enumerate(sizes) if n is not None and n <= max_bytes]\n 27107\t    got = _nodehome_cat_blobs(repo_root, [specs[i] for i in ok], timeout=timeout) if ok else []\n 27108\t    if got is None:\n 27109\t        return None\n 27110\t    res = [None] * len(specs)\n 27111\t    for i, v in zip(ok, got):\n 27112\t        res[i] = v\n 27113\t    return res\n 27114\t\n 27115\t\n 27116\tdef _nodehome_cat_blobs(repo_root, specs, timeout=60):\n 27117\t    \"\"\"一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。\n 27118\t\n 27119\t    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,\n 27120\t    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。\n 27121\t    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。\"\"\"\n 27122\t    import subprocess as _sp\n 27123\t    if not specs:\n 27124\t        return []\n 27125\t    if any(\"\\n\" in s_ for s_ in specs):\n 27126\t        return None\n 27127\t    try:\n 27128\t        r = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch\"],\n 27129\t                    input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n 27130\t                    capture_output=True, timeout=timeout)\n 27131\t    except (OSError, _sp.TimeoutExpired):\n 27132\t        return None\n 27133\t    if r.returncode != 0:\n 27134\t        return None\n 27135\t    out, pos, res = r.stdout, 0, []\n 27136\t    for _ in specs:\n 27137\t        nl = out.find(b\"\\n\", pos)\n 27138\t        if nl < 0:\n 27139\t            return None\n 27140\t        head = out[pos:nl].split(b\" \")\n 27141\t        pos = nl + 1\n 27142\t        if len(head) == 3 and head[1] == b\"blob\" and head[2].isdigit():\n 27143\t            size = int(head[2])\n 27144\t            res.append(out[pos:pos + size])\n 27145\t            pos += size + 1\n 31345\t_NOTE_REREAD_GATE_VALUES = (\"block\", \"warn\", \"off\")\n 31346\t_NOTE_REREAD_BUDGET_SEC = 30         # reread-check 的軟上限(同舊句檢查 _DRIFT_M1_BUDGET_SEC 的量級,不吃別道檢查的時間)\n 31347\t_NOTE_REREAD_DIFF_CAP = 100000       # 給判定者的 diff 字元上限(照實驗)\n 31348\t_NOTE_REREAD_OTHERS_MAX = 40         # 「另外改到的程式檔」只列前幾支(照實驗)\n 31349\t_NOTE_REREAD_TEXT_MAX = 500          # 報告裡每項的原句與理由各截到幾個字\n 31350\t_NOTE_REREAD_LIST_MAX = 10           # reread-check 最多列幾篇\n 31351\t_NOTE_REREAD_COST_NOTES = 15         # 候選超過這個篇數時 reread-prepare 另印成本估計\n 31352\t_NOTE_REREAD_DIFF_ARGS = (\"--no-ext-diff\", \"--no-textconv\", \"--no-color\", \"--src-prefix=a/\", \"--dst-prefix=b/\")\n 31353\t_NOTE_REREAD_HEAD = (\"編排者\", \"判定者模型\", \"範本版本\", \"材料指紋\", \"對照指紋\", \"筆記路徑\", \"筆記 blob\", \"筆記行數\", \"範圍終點\")\n 31354\t_NOTE_REREAD_TAIL = \"這只是提醒、不擋,忽略照推也可以\"\n 31355\t# ★路徑/名稱裡「要當特殊字元處理」的 Unicode 類別只有這一份★(回頭重讀代碼審 r3 架構對齊席 F1:原本回頭重讀與存量漂移\n 31356\t# 舊句檢查各寫一組,日後補類別要改兩處)。Cc 控制字元、Cf 方向控制與零寬、Zl/Zp 行段分隔(str.splitlines 會在這裡切行)、\n 31357\t# Cs 無損解碼留下的替身字元(不是 UTF-8)。要不要算 Cs 各處自己決定,用 _path_special_chars 的 surrogate 參數表達,不另抄一組。\n 31358\t_PATH_SPECIAL_CATS = frozenset((\"Cc\", \"Cf\", \"Zl\", \"Zp\", \"Cs\"))\n 31359\t\n 31360\t\n 31361\tdef _path_special_chars(s, surrogate=True):\n 31362\t    \"\"\"字串帶 _PATH_SPECIAL_CATS 那幾類的字元 → True;surrogate=False 不算 Cs(非 UTF-8 的路徑照常處理)。\"\"\"\n 31363\t    cats = _PATH_SPECIAL_CATS if surrogate else _PATH_SPECIAL_CATS - {\"Cs\"}\n 31364\t    return any(unicodedata.category(c) in cats for c in str(s))\n 31365\t\n 31366\t\n 31367\t# 路徑裡的控制字元:帶這種字元的筆記不對照(代碼審 r1 資安席 F2——換行能在項目檔頭多造一行「對照指紋: …」蓋掉真的那行、\n 31368\t# 讓沒讀過的篇被算成已對照;跳脫碼會原樣送進終端)。★範圍是 Unicode 類別 Cc、Cf、Zl、Zp★(代碼審 r2 資安席 F1):\n 31369\t# 第一版只認 C0/DEL/C1,漏了 U+2028/U+2029——str.splitlines() 會在那裡切行,原樣路徑寫進治理帳後 lumos gov 每次當掉;\n 31370\t# Cf 含雙向覆寫 U+202E(終端上把檔名顯示成別的樣子)與零寬字元。非 UTF-8 的替身字元是 Cs,不在內(那種照常對照:\n 31371\t# 無損解碼留下的替身字元原樣編回去就是原本的位元組,git 讀得到、也造不出假檔頭)——所以是共用那組減掉 Cs。\n 31372\t_NOTE_REREAD_CTRL_CATS = _PATH_SPECIAL_CATS - {\"Cs\"}\n 31373\t\n 31374\t\n 31375\tdef _note_reread_has_ctrl(s):\n\nhook: PostToolUse\nhook: PostToolUse Completed\ncodex\n目前主要邊界已收斂到「特殊字元路徑」：raw 解析器本身用 `-z` 無損，但 `impact --diff` 在進入它前仍以文字版 `--name-only` 拆行。我會用 repo 外的臨時 Git 小例子確認這是否真的把程式路徑改寫，並同時檢查測試是否有釘到「家與事故仍命中」而不只是不排除。\nhook: PreToolUse\nhook: PreToolUse Completed\nhook: PostToolUse\nhook: PostToolUse Completed\nhook: PreToolUse\nhook: PreToolUse Completed\nexec\n/bin/zsh -lc \"nl -ba docs/lumos-toolchain-knowledge/Systems/測試假綠形態.md | sed -n '1,70p'; git diff --name-only ce2a961f..HEAD; python3 scripts/lumos impact --file scripts/lumos --json | tail -n 1; python3 scripts/lumos impact --file scripts/test_lumos.py --json | tail -n 1\" in /private/tmp/lumos-review-artifact-impact-inputs\n succeeded in 6775ms:\n     1\t---\n     2\ttype: system\n     3\tstatus: done\n     4\tcreated: 2026-08-01\n     5\tupdated: 2026-10-05\n     6\tself_audit: sonnet/2026-08-30\n     7\trelated:\n     8\t  - \"[[Systems/canary-audit]]\"\n     9\t  - \"[[Projects/skill寫法學借鑒與design-loop剪枝]]\"\n    10\t  - \"[[Projects/檢索多詞回退_計劃]]\"\n    11\t  - \"[[Issues/loop-next吐不可宣告的tier]]\"\n    12\ttags:\n    13\t  - type/system\n    14\t  - status/done\n    15\t  - scope/ux-docs-hygiene\n    16\tsummary: |-\n    17\t  PITFALL:t_prepush_docs_and_light_run_subset 本機約 105 秒,CI 機器慢約一倍就超過全域 180 秒上限被砍,斷言全過卻判紅,而且重跑一樣紅 [出處:2026-10-05 PR #7、#8 的 CI] [根因:測試本身要跑真的推送閘子流程,天生慢,全域上限對它只剩不到 2 倍餘裕] [修法:放進 TIMEOUT_OVERRIDE 給 360 秒,同 t_ci_wait 的做法,不拉高全域上限] [防回歸:測試總檔收尾印的最慢五支會標「餘裕不足 3 倍」,看到同一支反覆上榜就照這樣處理] [同族:[[Systems/bound-tests-gate]]]\n    18\t  FLOW:寫測試/審測試時逐條對照本清單 → 命中哪一型就照該型的「怎麼接住」處理 → 修 bug 收尾跑「還原翻紅釘」時★必須同時放一條「現場成立」前置斷言★(否則對第④型全瞎)\n    19\t  PITFALL:[2026-09-23 CI 實踩,假紅不是假綠]★對 pty 只讀一次就斷言內容★:測試先往 master 寫 \"y\\n\",pty 立刻回顯成 b\"y\\r\\n\";只讀一次的話,在快的機器上只拿到回顯、被測程式寫的 prompt 還沒到,斷言就紅——跟被測程式對不對無關。本機五次都綠、前兩次 CI 也綠,重跑就過,是典型的時序競態。接法:讀到看見要的內容為止(select 加截止時間),不要信單次 read。重現:`python3 scripts/test_lumos.py -k t_confirm_tty_unit`(修前在快的 CI 機器上偶發紅) [test:t_confirm_tty_unit]\n    20\t  PITFALL:鏡頭逾時暖快取那支測試在主線合併一個大 PR 之後 CI 假紅(背景 60 秒內算不完快取) [出處:2026-10-04 PR #2 合併後主線與 PR #3 的 CI] [根因:測試範圍取主線 tip 與 tip~1,一般合併時 tip~1 是合併前的主線,範圍等於整個 PR(那次 6279 行)——仍是拿範圍大小當開關] [修法:改在主線最近 30 個非合併提交裡挑改動最小的 X,範圍取 X~1..X] [test:t_lens_timeout_keeps_warming_cache]\n    21\t  PITFALL:用唯讀權限造「寫不進去」的測試在 root 身分下假紅(root 不受唯讀限制,寫入照樣成功) [出處:[[Projects/雲端環境跑綠全套測試_計劃]]] [根因:現場靠權限造,而雲端容器以 root 執行] [修法:用 _break_for_write 把檔換成同名資料夾,root 也寫不進去;repo 裡其他在 root 下直接略過的同類測試可照改] [test:t_gate_ledger_write_failure_does_not_change_verdict]\n    22\t  PITFALL:同一支測試跑兩次檢查、用「兩本帳合併後的最後一筆」取第二次的紀錄,機器忙時偶爾拿到第一次的那筆而假紅 [出處:2026-10-05 推送 README 更新時推送閘全套只紅 t_drift_m1_review_r3_long_lines_narrowed ③、單獨跑綠] [根因:放行記本機帳、擋下記版控帳,時間只到秒;兩筆落在同一秒時合併排序版控帳在前,[-1] 變成先前那次放行] [修法:先存跑之前的事件,用 _gov_since 取這次多出來的那筆;同檔其他十多處 _m1_events(root)[-1] 只在同一支測試前後兩次分寫不同本帳時才會中] [test:t_drift_m1_review_r3_long_lines_narrowed]\n    23\t  KEY:★新增兩型(2026-09-16 linter 送檔那批代碼審)★ ①★「巢狀」測試寫成前後兩個不重疊的區塊★——斷言名字叫「巢狀拿同一把鎖不會卡死自己」,實際寫的是先 with 一次、退出、再 with 一次,根本沒進入巢狀;被測的可重入判斷剛好壞掉而測試全綠,改成真巢狀當場卡住。判準:★測試名字裡出現的那個情境,要在程式碼結構上看得到★(巢狀=縮排進去,並行=真的兩個執行緒)②★守衛的能力宣稱比它實際擋得住的寬★——同一個守衛連續三次:先寫「唯一實作」(其實另外兩處還在自己手寫)、再寫「機械保證」(其實是逐行字串比對,拆成多行就繞過)、再寫「拿變數繞也擋得住」(其實先賦值給變數就看不到)。三次都是註解裡的一句話,機器看不見,只有人去試才發現。判準:★寫「擋得住 X」之前,先用 X 那招真的繞一次★;繞得過去就改形狀(最後改成白名單制才真的擋住),繞不過去才准寫,而且要同時寫明擋不住什麼\n    24\t  KEY:本專案撞最多次的坑=「測試存在但沒在驗它宣稱要驗的」,已累計 ★16 次★(2026-08-02 第 12、2026-08-03 第 13/14/15/16,★五次都是新測試自己中第④型★)。過去只有一句程序(還原翻紅釘)與散落個案,★沒有可查的形態清單★——本節點就是那張清單\n    25\t  KEY:★INVARIANT★ 修 bug 的「還原翻紅釘」必須配一條**前置斷言證明現場成立**(被測那條路真的被執行到)——否則對第④型「現場走不到被測分支」完全無效:把修法還原回去,測試照樣全綠 [test:t_slim_uninstall_manifest_parent_cleanup_is_best_effort,t_deinit_vendored_unlink_failure_does_not_abort] [audit:opus/2026-08-01](因果驗證:2026-08-01 r3 第一版翻紅釘的現場用「父目錄非空」,`if ... and not any(parent.iterdir())` 直接判假、`rmdir()` 根本不執行,把修法還原成共用 try 的突變照樣全綠;改成 `chmod ~/.local/share 0o500` 讓 `rmdir` 真的拋 PermissionError 後才翻紅 3 條斷言)\n    26\t  KEY:★翻紅釘第二盲區=斷言重疊(2026-08-04,design-loop T1 實例)★——現場同時違反多條檢查時,拔掉目標檢查、鄰近檢查用同一 rc「代打」,釘假紅;接法=現場把目標以外的檢查全餵到滿足(讓目標檢查成唯一翻紅路)+rc-型斷言儘量同時斷錯誤訊息。與「現場成立」前置成對:一個守現場、一個守鑑別力\n    27\t  KEY:★2026-08-26 code-batch3 實例(s3 席一次抓四條,都靠「拔守衛後仍全綠」證實)★——④型(現場走不到被測分支):斷言「__seqN 尾巴沉默」實際被更早的混用守衛擋成 rc2 空 stdout,`not in 空字串` 恆真,拔掉目標守衛照綠→改成「純 round-less 帶處置帳」才真走到被測分支;⑤型(fixture 產不出有鑑別力的值):replay readonly「不產 roster-alerts.log」的 fixture 報告與帳面一致、也無異常,尾巴跑不跑都不寫檔→改「報告 blocker/帳 minor」的真低報形,拔守衛才會翻紅;另兩條=負案例缺席(新舊帳分流只有新帳、and rc!=0 只有 rc≠0 側)。四條的共通接法=每修一條都「拔掉被測守衛重跑,確認翻紅」才算數\n    28\t  KEY:★假設一定有第九型★——本清單是「我枚舉了 N 種形態」,而本專案已被這句話打臉多次(slim-scan 五形態掃不到路徑型、CLI 揭露段列三支漏第四支)。★不得把「對照過清單」當成「測試夠格」的證明★;清單是提示器,不是偵測器\n    29\t  KEY:外部對照——mattpocock/skills 的 tdd skill 定義了 **tautological**(斷言用跟程式碼同樣的方式重算期望值,天生會過、永遠不可能跟程式碼唱反調;期望值必須來自★獨立的真相來源★:已知良好字面值/手算例子/規格)。★那只是本清單第①型★,不是超集,故 borrow 定義、不 borrow 為全集\n    30\t  KEY:[2026-09-05]第 ★17★ 次,又是新測試自己中第④型:daily-governance 包 main() 的守衛首版只比「有 main() {」「最後一行 main」「收尾 echo 在後面」三個字串——主體搬回頂層、函式外多一行、刪掉一整步,全假綠;代碼審 r1 通才席與外家 Codex 各自用變體實跑抓到,修成前奏白名單+五步名冊+結尾 exit,四種壞檔各自翻紅 [[Verification/2026-09-05_wrapper邊跑邊改實驗]]\n    31\t  KEY:[2026-09-06]★新型:不是假綠是「假紅」,但同源——測試沒在驗它宣稱要驗的東西★。t_codex_s1_lens_arm_claim 驗的是席次 token 原子認領,卻用 `<upstream>..HEAD` 武裝四次;算一次鏡頭的成本跟「本機比遠端多幾個 commit」成正比(當天多 5 個、73 檔、單次 47 秒),四次撞破 180 秒上限。**推的東西越多它越容易紅,而 pre-push 正是它唯一被跑到的時機**。改法:只留第一次用真範圍,其餘三次用 `<upstream>..<upstream>`(空 diff、仍過 base 在主線的守衛、走完整路徑),180 秒逾時→55 秒。找法:看「最慢 5 支」那張表裡有沒有哪支的耗時會隨 repo 狀態浮動 [[Projects/全repo審視_計劃]]\n    32\t  KEY:★新增一型(2026-09-12 Java 補棧代碼審 r1)——「掃描器認錯名字」★:測試本身沒問題,壞的是「找出有哪些測試」的那一步。兩種症狀互為表裡:①沒掛註解的方法被收成真測試 → 合約綁到一個永遠不會執行的東西,閘照樣綠 ②真測試因為附近字串干擾而整支掃不到 → 一支好測試被判懸空擋下。這一型的特徵是★所有既有斷言都照樣全綠★(它們驗的是「接線會動」,不是「壞情況會被擋」),只有刻意造壞樣本才驗得到 [test:t_java_profile_discovery]\n    33\t  KEY:★同一型的另一面(2026-09-12 同日,另一個 session)——「斷言只問會不會擋,不問為什麼擋」★:斷言寫成「這個情況要被擋下來」就過關,於是擋人的理由整個換掉、原本要驗的那一關根本沒跑,測試照樣綠。實例=代碼審守衛那組測試,原本驗「審查留痕不符要擋」,Python 棧題目上線後改由表態閘擋,兩支測試綠了但驗的東西沒了。★判準:斷言寫「會不會擋」不夠,要寫「為什麼擋」——把理由欄位一起斷言,理由換掉就翻紅★ [test:t_codeloop_guard_verdict]\n    34\t  KEY:★另一面:紅的也不一定是真的★——共用工作目錄時,別人還沒提交的檔會讓全套跑出跟真紅一模一樣的紅(2026-09-13 實際 4 條紅裡 2 條是假的);合起來的意思是全套跑完★兩種顏色都不能直接信★:綠的要問「它到底驗到了什麼」、紅的要問「這是不是我改的」。判準與作法見 [[Issues/共用工作目錄的未追蹤檔讓全套測試假紅]]\n    35\t  TEST:清單本身不可測(它是判讀用的分類法);上方那條硬合約由 t_slim_uninstall_manifest_parent_cleanup_is_best_effort 與 t_deinit_vendored_unlink_failure_does_not_abort 的「★前置★ 現場成立」斷言示範並守住\n    36\tverified_by:\n    37\t  - \"[[Verification/2026-08-02_slim三缺陷修復_實驗產出]]\"\n    38\t  - \"[[Verification/2026-08-03_Windows回歸測試三缺陷]]\"\n    39\t  - \"[[Verification/2026-08-04_design-loop重設計落地T1-T7]]\"\n    40\t  - \"[[Verification/2026-08-21_L4交叉審計30節點清帳]]\"\n    41\t  - \"[[Verification/2026-09-05_wrapper邊跑邊改實驗]]\"\n    42\t  - \"[[Verification/2026-10-05_背景快取命中清鎖驗證]]\"\n    43\t  - \"[[Verification/2026-10-05_背景啟動失敗即時回報驗證]]\"\n    44\t  - \"[[Verification/2026-10-06_附件種子修復獨立驗收]]\"\n    45\tabout_code:\n    46\t  - scripts/test_lumos.py\n    47\taliases:\n    48\t  - 翻紅釘\n    49\t  - 現場成立前置斷言\n    50\t  - 斷言只問會不會擋不問為什麼\n    51\t  - 假紅不一定是真的\n    52\t---\n    53\t# 測試假綠形態（「測試存在，但沒在驗它宣稱要驗的」）\n    54\t\n    55\t## ★第 20 次:席位說「我實測過,這條量不到差別」,我還是寫了一支去量它★\n    56\t\n    57\t**症狀**:測試名字與說明宣稱在量互斥性,實際量到的是時序巧合。\n    58\t本機(macOS)綠、CI(Linux)紅——★兩邊都不代表任何事★。\n    59\t\n    60\t**經過**:接管權小鎖的破鎖從「rm 掉再 mkdir」改成 mv。我寫了一支測試數\n    61\t「同一輪有幾個行程走進接管區」,並把「進來後發現鎖已經換人」算成走進去了。\n    62\t**但那句話的意思正好相反**:它代表這個行程是在**別人做完之後**才進去的,\n    63\t是合法的接續,不是同時。\n    64\t\n    65\t**最難看的部分**:審查席在報告裡已經明說過這條量不到差別(15 輪 × 8 行程 0/15),\n    66\t還講出了原因(真正的互斥在下一層的原子改名)。我在收貨記錄裡寫了「這兩條我都採信」,\n    67\t**然後還是寫了那支測試**。\n    68\t\n    69\t**收束(新規則)**:\n    70\t★當審查席說「我實測過,這條量不到差別」時,那句話同時是「不要再去量它」。★\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ndocs/.canary-log.jsonl\ndocs/.governance-log.jsonl\n\"docs/lumos-toolchain-knowledge/Projects/\\345\\257\\251\\346\\237\\245\\351\\231\\204\\344\\273\\266\\344\\270\\215\\344\\275\\234\\347\\250\\213\\345\\274\\217\\345\\275\\261\\351\\237\\277\\347\\250\\256\\345