\"dispatch-lens\", \"main..HEAD\", \"--repo\", str(d3), \"--json\", \"--no-cache\", \"--role-cards\")\n 38485\t    dd = _j.loads(r.stdout.strip().splitlines()[-1]) if r.stdout.strip() else {}\n 38486\t    check(\"S9: 宣告壞掉、全部判不出 → 只附警告那一行\", dd.get(\"role_text\", \"\").startswith(\"(角色鏡頭)⚠\") and \"[角色鏡頭]\" not in dd.get(\"role_text\", \"\"), str(dd)[:300])\n 38487\t    hm = _load_hook_mod(\"dlens_role\", \"dispatch-lens-hook.py\")\n 38488\t    seen = []\n 38489\t    def fake_run(argv, timeout=None, **k):\n 38490\t        seen.append(list(argv))\n 38491\t        class R: returncode = 0; stdout = _j.dumps({\"text\": \"x\", \"shown\": 0, \"pinned\": 0}); stderr = \"\"\n 38492\t        return R()\n 38493\t    for prompt in (\"審查。\\nLUMOS-IMPACT: main..HEAD\\n\", \"審查。\\nLUMOS-IMPACT: main..HEAD\\nLUMOS-ROLE-CARDS: on\\n\"):\n 38494\t        payload = {\"hook_event_name\": \"PreToolUse\", \"tool_name\": \"Agent\", \"cwd\": str(d), \"tool_input\": {\"prompt\": prompt}}\n 38495\t        with patch.object(hm.subprocess, \"run\", fake_run), patch.object(hm.sys, \"stdin\", _io.StringIO(_j.dumps(payload))), patch.object(hm.sys, \"stdout\", _io.StringIO()):\n 38496\t            hm.main()\n 38497\t    check(\"S9: 掛鉤沒有 LUMOS-ROLE-CARDS: on 不傳 --role-cards、有才傳\",\n 38498\t          len(seen) == 2 and \"--role-cards\" not in seen[0] and \"--role-cards\" in seen[1], str(seen)[:300])\n 38499\t\n 38500\t\n 38501\tdef t_dispatch_lens_role_cards_survive_graph_failure():\n 38502\t    \"\"\"[S10] 圖譜那段超時、沒有圖譜、base 不在主線時角色卡照附;範圍不合法什麼都不附。\"\"\"\n 38503\t    import json as _j, io as _io\n 38504\t    from unittest.mock import patch\n 38505\t    d, g, w, c = _role_lens_repo(with_vault=False)\n 38506\t    w(\"web/App.vue\", \"<template/>\\n\"); c(\"fe\")\n 38507\t    r = run(d, \"dispatch-lens\", \"main..HEAD\", \"--repo\", str(d), \"--json\", \"--no-cache\", \"--role-cards\")\n 38508\t    dd = _j.loads(r.stdout.strip().splitlines()[-1]) if r.stdout.strip() else {}\n 38509\t    check(\"S10: 沒有圖譜