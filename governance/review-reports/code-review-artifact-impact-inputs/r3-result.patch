[], []\n    shape = \"要是清單,每條 {\\\"path\\\": 路徑樣式, \\\"role\\\": frontend|backend|none}\"\n    if not isinstance(v, list):\n        return [], [f\"review_roles {shape};這次整份不用\"]\n    rules = []\n    for i, item in enumerate(v, 1):\n        if not isinstance(item, dict) or set(item) != {\"path\", \"role\"}:\n            return [], [f\"review_roles 第 {i} 條形狀不對({shape});這次整份不用\"]\n        pat, role = item[\"path\"], item[\"role\"]\n        if role not in _ROLE_VALUES:\n            return [], [f\"review_roles 第 {i} 條的 role 不合法(只認 {'/'.join(_ROLE_VALUES)});這次整份不用\"]\n        if not isinstance(pat, str) or not pat.strip() or pat.startswith((\"./\", \"/\")) or \"\\\\\" in pat:\n            return [], [f\"review_roles 第 {i} 條的 path 不合法(不能空白、不能以 ./ 或 / 開頭、不能有反斜線);這次整份不用\"]\n        rules.append((pat, role))\n    return rules, []\n\n\ndef _review_role_for(file_rel, repo_root, rules=(), reader=None, content=None):\n    \"\"\"一支改動檔的審查角色:\"frontend\" / \"backend\" / None(判不出就不附,不猜)。依序:\n    專案宣告(第一條命中的算數)→ 現在沒有題組鍵的前端副檔名 → 手機檔看匯入 → 題組鍵(.ts/.js 走 package.json)。\n    建立在 _stack_key_for_file 上,不另造一套分類(設計審 r1 架構對齊席 F2)。\n    reader:讀指定版本的 package.json(見 _node_flavor);content:手機檔的內容,None=沒讀(超過上限)→ 判不出。\"\"\"\n    if rules:\n        i = _glob_first_match(file_rel, [p for p, _ in rules])\n        if i is not None:\n            return None if rules[i][1] == \"none\" else rules[i][1]\n    ext = Path(file_rel).suffix.lstrip(\".\").lower()\n    if ext in _ROLE_FRONT_EXTS:\n        return \"frontend\"\n    if ext in _ROLE_MOBILE_EXTS:\n        if content is None:\n            return None\n        if _ROLE_UI_IMPORT[ext].search(content):\n            return \"frontend\"\n        if ext == \"swift\" and _ROLE_UIKIT_IMPORT.search(content) and _ROLE_UIKIT_SUBCLASS.search(content):\n            return \"frontend\"\n        if ext == \"java\" and not _ROLE_ANDROID_IMPORT.search(content):\n            return \"backend\"    # Java 後端服務常見;Android 純 Java 資料類也會落在這裡(已知限制,出路是宣告)\n        return None\n    key = _stack_key_for_file(file_rel, repo_root, reader=reader)\n    if key == \"vue\":\n        return \"frontend\"\n    return \"backend\" if key in _ROLE_BACK_KEYS else None\n\n\ndef _review_role_changed_files(root, base, head):\n    \"\"\"角色鏡頭的改動檔清單:[(路徑, 讀內容用的版本)]。派工角色段與推送前分級那一行共用這一支。\n    改名算新路徑;刪除的檔照樣算、讀起點版本。剔除測試檔(_PITFALL_DIFF_TEST_PAT)、消費專案裡原封不動的工具檔\n    (_vendored_skip)、文件與帳檔(_impact_diff_seed_ok)。git 跑不起來回 None。\"\"\"\n    r = _lens_git(root, \"diff\", \"--no-ext-diff\", \"--name-status\", \"-M\", \"-z\", base, head)\n    if r is None or r.returncode != 0:\n        return None\n    toks = r.stdout.split(\"\\0\")\n    skip = _vendored_skip(root, f\"{base}..{head}\")\n    out, i = [], 0\n    while i < len(toks) and toks[i]:\n        st = toks[i]\n        if st[:1] in (\"R\", \"C\"):\n            path, ref, i = toks[i + 2], head, i + 3\n        else:\n            path, ref, i = toks[i + 1], (base if st[:1] == \"D\" else head), i + 2\n        out.append((path, ref))\n    modes = _impact_diff_modes(root, [path for path, _ref in out], base, head)\n    if modes is None:\n        return None\n    return [(path, ref) for path, ref in out\n            if not _PITFALL_DIFF_TEST_PAT.search(path)\n            and _impact_diff_seed_ok(path, *modes.get(path, (None, None))) and path not in skip]\n\n\ndef _review_roles(root, base, head, budget=_ROLE_BUDGET):\n    \"\"\"算這段改動每支檔的角色。回 {\"roles\": {路徑: 角色|None}, \"counts\": {...}, \"warnings\": [...], \"capped\": N, \"timed_out\": bool};\n    git 讀不到改動清單回 None。成本:內容一次批次讀取(_nodehome_cat_blobs),最多讀 _ROLE_READ_CAP 支,整體受 budget 秒限制。\"\"\"\n    import time as _t\n    if budget <= 0:\n        return {\"roles\": {}, \"counts\": {\"frontend\": 0, \"backend\": 0, \"unknown\": 0},\n                \"warnings\": [], \"capped\": 0, \"timed_out\": True}\n    t0 = _t.monotonic()\n    cfg = _json_at_ref(root, base, \".lumos/config.json\")\n    _cfg_there = cfg is None and _lens_git(root, \"cat-file\", \"-e\", f\"{base}:.lumos/config.json\")\n    rules, warnings = _review_roles_config(cfg, unreadable=bool(_cfg_there and _cfg_there.returncode == 0))\n    files = _review_role_changed_files(root, base, head)\n    if files is None:\n        return None\n    want, capped = _review_role_wanted(files, rules)\n    blobs, timed_out = {}, False\n    left = budget - (_t.monotonic() - t0)\n    if want and left > 0.2:\n        got = _nodehome_cat_blobs_capped(root, want, _ROLE_MAX_BYTES, timeout=left)\n        if got is None:\n            timed_out = True\n        else:\n            blobs = {k: (v.decode(\"utf-8\", \"replace\") if v is not None else None) for k, v in zip(want, got)}\n    elif want:\n        timed_out = True\n    roles = {}\n    for p, ref in files:\n        content = blobs.get(f\"{ref}:{p}\")\n        roles[p] = _review_role_for(p, root, rules, reader=lambda rel, _r=ref: blobs.get(f\"{_r}:{rel}\"), content=content)\n    counts = {\"frontend\": sum(1 for v in roles.values() if v == \"frontend\"),\n              \"backend\": sum(1 for v in roles.values() if v == \"backend\"),\n              \"unknown\": sum(1 for v in roles.values() if v is None)}\n    return {\"roles\": roles, \"counts\": counts, \"warnings\": warnings, \"capped\": capped, \"timed_out\": timed_out}\n\n\ndef _review_role_wanted(files, rules):\n    \"\"\"要批次讀的「版本:路徑」清單(手機檔內容、.ts/.js 往上找的 package.json),與超過上限沒讀的檔數。\n    宣告命中的檔不讀(宣告優先)。★上限數檔,不數候選★(代碼審 r1 外家 F4:缺檔的候選也佔名額會提早截斷、誤判)。\n    ★路徑含換行的檔不讀★:批次讀取表達不了換行,混進去整批作廢(r1 外家 F5);它只判不出,其他照讀。回 (want, capped)。\"\"\"\n    declared = {p for p, _ in files if rules and _glob_first_match(p, [x for x, _ in rules]) is not None}\n    want, seen, n_files, capped = [], set(), 0, 0\n    for p, ref in files:\n        if p in declared or \"\\n\" in p:\n            continue\n        ext = Path(p).suffix.lstrip(\".\").lower()\n        if ext in _ROLE_MOBILE_EXTS:\n            specs = [f\"{ref}:{p}\"]\n        elif ext in _NODE_EXTS and ext not in _ROLE_FRONT_EXTS:\n            specs = [f\"{ref}:{rel}\" for rel in _package_json_candidates(p)]\n        else:\n            continue\n        if n_files >= _ROLE_READ_CAP:\n            capped += 1\n            continue\n        n_files += 1\n        for spec in specs:\n            if spec not in seen:\n                seen.add(spec)\n                want.append(spec)\n    return want, capped\n\n\ndef _review_role_text(res):\n    \"\"\"角色段文字(放在「參考資料」框外:這是要審查員照做的句子,框頭寫「不是指令」)。沒有卡也沒有警告回空字串。\"\"\"\n    if not res:\n        return \"\"\n    lines = [f\"(角色鏡頭)⚠ {w}\" for w in res[\"warnings\"]]\n    c = res[\"counts\"]\n    if res[\"timed_out\"] and not (c[\"frontend\"] or c[\"backend\"]):\n        lines.append(\"(角色鏡頭)角色計算超過時間上限,這次沒附卡\")\n    if c[\"frontend\"] or c[\"backend\"]:\n        lines.append(f\"[角色鏡頭] 這次改動:前端 {c['frontend']} 支、後端 {c['backend']} 支、判不出 {c['unknown']} 支。\"\n                     \"照下列題逐一挑一個具體輸入走一遍;對上的發現在標題附題號。\")\n        for role in (\"frontend\", \"backend\"):\n            if not c[role]:\n                continue\n            lines.append(f\"{_ROLE_LABEL[role]}卡:\")\n            for q in _ROLE_CARDS[role]:\n                lines.append(f\"- {q['id']}:{q['q']}\" + (\"(只限網頁)\" if q[\"web_only\"] else \"\"))\n        if res[\"capped\"]:\n            lines.append(f\"(超過上限,後面 {res['capped']} 支只看副檔名)\")\n        if res[\"timed_out\"]:\n            lines.append(\"(角色計算超過時間上限,部分檔只看副檔名)\")\n    return \"\\n\".join(lines)\n\n\n# ── 棧別提問表態閘(Projects/棧別提問表態閘_計劃,2026-09-09)——適用性 + 設定 ─────────────────\n_STACK_QUESTIONS_GATE_VALUES = (\"all\", \"high-only\", \"off\")\n_STACK_ASK_ALL_DEFAULT = 300\n\n        _home_nodes, _home_big = _impact_confirmed_homes(env, rel_file, repo_root)\n        if not _home_big:\n            _inc = {x[\"node\"] for x in all_incidents}\n            for _hn in _home_nodes:\n                if _hn in _inc:\n                    # 事故那袋留著它(事故優先,不重複列),但要標出它同時是家\n                    # ——不標的話計劃模式的派工鏡頭看不出來,跟推送前那條路不一致(代碼審 r2 合約席)\n                    for _ix in all_incidents:\n                        if _ix.get(\"node\") == _hn:\n                            _ix[\"home\"] = True\n                    continue\n                _hnote = env.notes.get(_hn)\n                _hc, _hcombo = _impact_contract(_hnote) if _hnote else (None, False)\n                all_homes.append({\"node\": _hn, \"contract\": _hc, \"combo\": _hcombo})\n            _hset = {x[\"node\"] for x in all_homes}\n            if _hset:\n                all_direct = [x for x in all_direct if x[\"node\"] not in _hset]\n                all_indirect = [x for x in all_indirect if x[\"node\"] not in _hset]\n\n    # 9. 輸出\n    if as_json:\n        print(json.dumps(\n            {\"file\": rel_file,\n             **({\"homes\": all_homes} if all_homes else {}),\n             \"direct\": all_direct, \"indirect\": all_indirect,\n             \"incidents\": all_incidents},\n            ensure_ascii=False,\n        ))\n    else:\n        # 人讀輸出\n        print(f\"改動 {rel_file} (由讀盤 refcheck 抽取)\")\n        if all_homes:\n            print(f\"── 這支檔的家 ({len(all_homes)}) ──\")\n            for x in all_homes:\n                contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n                print(f\"  {x['node']}{contract_tag}\")\n        print(f\"── 直接關聯 ({len(all_direct)}) ──\")\n        for x in all_direct:\n            contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n            combo_tag = \"★COMBO★\" if x.get(\"combo\") else \"\"\n            tags = (contract_tag + (\" \" + combo_tag if combo_tag else \"\")).rstrip()\n            print(f\"  {'⚠合約 ' if x.get('contract') else ''}{x['node']}{tags}  ({x['hit']})\")\n        print(f\"── 間接關聯 ({len(all_indirect)}) ──\")\n        for x in all_indirect:\n            cross = \" [跨repo葉,不展開]\" if x.get(\"cross_repo\") else \"\"\n            print(f\"  hop{x['hop']}  {x['node']}  {x['direction']} ← via {x['via']} ← {x['from']}{cross}\")\n        if all_incidents:\n            print(f\"── 相關事故 ({len(all_incidents)}) ──\")\n            for x in all_incidents:\n                contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n                print(f\"  {x['node']}{contract_tag}  (trigger: {x['matched_by']})\")\n\n    return 0\n\n\n_IMPACT_DIFF_SKIP = (\"docs/\", \"governance/golden/\")   # 圖譜/凍結快照非 code,不當 impact 種子\n\n\ndef _impact_diff_seed_ok(f, file_mode=None, shebang=None):\n    \"\"\"--diff 種子過濾:只收 code 檔。剔除圖譜/凍結快照/帳檔(.jsonl)/文檔(.md)/\n    簿記分類沿用 _BOOKKEEPING_FILES/_BOOKKEEPING_DIRS,卷證不是程式;\n    governance 資料 .json(goldset/裁決紀錄內嵌歷史 code 片段,會偽觸發事故 pin——r1 panel 實證)。\"\"\"\n    if not f or any(f.startswith(p) for p in _IMPACT_DIFF_SKIP):\n        return False\n    # 固定帳檔仍排除；目錄內的程式例外先成立，不再被文檔副檔名二次排掉。\n    if f in _BOOKKEEPING_FILES:\n        return False\n    if f.startswith(_BOOKKEEPING_DIRS):\n        kind = _nodehome_code_kind(f)\n        if file_mode == \"100755\" or kind == \"ext\":\n            return True\n        if kind == \"shebang?\":\n            return shebang is not False  # 超過上限／讀不到時沿既有保守判法。\n        return file_mode is None\n    if f.endswith((\".jsonl\", \".md\")):\n        return False\n    if f.endswith(\".json\") and f.startswith(\"governance/\"):\n        return False\n    return True\n\n\ndef _impact_diff_modes(repo_root, files, *diff_args):\n    \"\"\"簿記來源取凍結模式與首行；普通來源不多查 Git。刪檔取舊物件。\"\"\"\n    if not any(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):\n        return {}\n    raw = _nodehome_git(repo_root, \"diff\", \"--no-ext-diff\", \"--no-textconv\",\n                        \"--raw\", \"--no-renames\", \"--no-abbrev\", \"-z\", *diff_args)\n    changes = _codeloop_raw_changes(raw) if raw is not None else None\n    if changes is None:\n        return None\n    out, ask = {}, []\n    for f, (old, new, old_oid, new_oid) in changes.items():\n        mode, oid = (old, old_oid) if new == \"000000\" else (new, new_oid)\n        out[f] = (mode, None)\n        if (f.startswith(_BOOKKEEPING_DIRS) and mode != \"100755\"\n                and _nodehome_code_kind(f) == \"shebang?\" and not _path_special_chars(f, surrogate=False)\n                and oid.strip(\"0\")):\n            ask.append((f, oid))\n    if ask:\n        heads = _nodehome_cat_blobs_capped(repo_root, [oid for _f, oid in ask],\n                                          _CODELOOP_BOOKKEEPING_HEAD_CAP, timeout=_disp_git_timeout())\n        if heads is not None:\n            for (f, _oid), head in zip(ask, heads):\n                out[f] = (out[f][0], True if head is None else _head_is_shebang(head, lenient=True))\n    return out\n\n\ndef _impact_payload_read(path):\n    \"\"\"讀一份已經算好的波及結果(pre-push 每次推送只算一次,兩個消費者共用同一份)。\n\n    ★為什麼要有這支★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):\n    推送關卡本來就對每個 ref 跑一次完整的波及計算(同步點名用)。合約測試閘要的是\n    同一份東西裡「帶合約而且綁了測試」的那幾篇——★再算一次就是把一次推送算兩次★,\n    而那正是這一案 r1 拿來否決原設計的那個成本(那條裁定後來被查出已作廢,\n    但「不要算兩次」本身仍然是對的)。\n\n    ★失敗要隔離★:讀不到就回 None,呼叫端各自決定怎麼降級——\n    同步點名維持靜默,合約測試閘記一筆帳放行。一個失敗不准拖垮另一個。\n    \"\"\"\n    import json as _json, stat as _stat\n    # ★擁有權要驗,理由跟 dispatch-lens 那支快取一模一樣★\n    # (2026-09-07 代碼審 r1 架構對齊席判 blocking,說得對):\n    # 這個 repo 已經有一套硬化過的「算一次、之後讀」——_lens_cache_read,\n    # 它會先驗 st_uid 與 group/other 可不可寫,註解明寫「$TMPDIR 路徑可預測可偽造」。\n    # 而這裡收的正是一個從命令列傳進來的 $TMPDIR 路徑,同一種曝險。\n    # ★但沒有照抄整套★,理由是生命週期不同,而這一點原本沒寫下來所以席位抓到了:\n    #   dispatch-lens 那支是「跨呼叫、可被別人發現、要 TTL、要 key 去對」的快取;\n    #   這裡是「同一次 hook 執行內、由呼叫端明確指定路徑、用完就刪」的交接。\n    #   要 TTL 與 key 是多餘的,要擁有權驗證則是必要的——所以只借那一半。\n    try:\n        st = Path(path).stat()\n        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):\n            return None\n        data = _json.loads(Path(path).read_text(encoding=\"utf-8\"))\n    except Exception:\n        return None\n    # ★形狀要驗到位★(代碼審 r1 外家否決席判 major):只驗「是 dict 而且有 results」不夠——\n    # `{\"results\":[1],\"sync\":[]}` 這種合法 JSON 會通過,然後在下游 r.get(...) 當場拋例外,\n    # 而那個例外會被 pre-push 的 || true 吞掉:★不是按設計記 range-unavailable,是靜默失效★。\n    if not isinstance(data, dict):\n        return None\n    res = data.get(\"results\")\n    if not isinstance(res, list) or any(not isinstance(r, dict) for r in res):\n        return None\n    sync = data.get(\"sync\")\n    if sync is not None and not (isinstance(sync, dict)\n                                 and isinstance(sync.get(\"missing\"), list)\n                                 and isinstance(sync.get(\"touched_nodes\"), list)):\n        return None\n    return data\n\n\ndef cmd_impact_diff(diff_range, repo=None, depth=None, top=8, min_score=0.20, as_json=False,\n                    sync_check=False, sync_only=False, from_json=None):\n    \"\"\"code-loop 橋接:對整段 diff 的每支改動 code 檔跑 ranked impact(query=該檔 hunk 文字),\n    聚合成「受影響功能面」manifest——固定席(合約/事故)全保、非固定取跨檔最高分 top-N。\n    定位=審計員鏡頭(advisory,人判),非自動推播(hook 面 goldset 評測未過線,故不接 hook)。\n    rc: 0=成功 / 2=git 失敗 / 3=vault 缺。\n\n    from_json:吃一份已經算好的結果,不自己算(見 _impact_payload_read)。目前只支援\n    搭 --sync-only 用——推送關卡算一次、同步點名與合約測試閘各讀一次。\"\"\"\n    if from_json is not None:\n        _pl = _impact_payload_read(from_json)\n        if _pl is None or _pl.get(\"sync\") is None:\n            return 0          # 失敗隔離:維持同步點名現在的行為(靜默)\n        _print_sync_nudge(_pl[\"sync\"], _pl.get(\"range\") or diff_range)\n        return 0\n    import json as _json\n    import subprocess as _sp\n    if diff_range == \"staged\":\n        # 圖譜同步覆蓋(2026-08-22):pre-commit 要對「這次 commit 的內容」算波及,用 staged 代替 range\n        diff_range = \"--staged\"\n    elif diff_range.startswith(\"-\"):\n        # 同 pitfalls/cochange-check:'-' 開頭值會被 git 誤認成選項,查詢命令 rc2 拒收\n        print(\"擋下:--diff 的值不能用 - 開頭(會被當成選項)\", file=sys.stderr)\n        return 2\n    repo_root = Path(repo) if repo else None\n    if repo_root is None:\n        for cand in (Path.cwd(), *Path.cwd().parents):\n            if (cand / \".git\").exists():\n                repo_root = cand\n                break\n    if repo_root is None or not (repo_root / \".git\").exists():\n        print(\"擋下:找不到 git 專案,用 --repo 指定\", file=sys.stderr)\n        return 2\n    # core.quotePath=false:CJK 檔名不轉義加引號(否則 startswith/endswith 過濾全失效,r2 panel major)\n    r = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n                 \"diff\", \"--name-only\", diff_range], capture_output=True, text=True, errors=\"replace\")\n    if r.returncode != 0:\n        print(f\"擋下:git 算不出差異: {r.stderr.strip()[:200]}\", file=sys.stderr)\n        return 2\n    candidates = [f.strip() for f in r.stdout.splitlines()]\n    modes = _impact_diff_modes(repo_root, candidates, diff_range)\n    if modes is None:\n        print(\"擋下:git 算不出差異檔案模式\", file=sys.stderr)\n        return 2\n    files = []\n    for f in candidates:\n        if not _impact_diff_seed_ok(f, *modes.get(f, (None, None))):\n            continue\n        # 已刪檔不跳過:反查靠「節點 body 引用該路徑」而非檔案存在——\n        # 刪除/改名正是合約節點最該被推到審計員眼前的時刻(r1 codex major)\n        files.append(f)\n    merged = {}          # node -> entry(跨檔取最高分;pinned 任一檔 pinned 即 pinned)\n    per_file_meta = []\n    import io, contextlib\n    _vault = _vault_in(repo_root)\n    # ★沒有圖譜就直接說,不要印「0 篇」裝作查過了★(2026-09-07 全 repo 審視 #9)\n    #\n    # 出身:這條路原本只在**逐檔迴圈裡**才發現沒圖譜——而「這個範圍 0 個檔」時迴圈根本不跑,\n    # 於是一路走到最後印出「固定席 0 + top 0」並回成功。\n    # ★對新手最危險的就是這個★:同一件事(找不到圖譜),另外兩種問法一個回 rc3、一個回 rc2\n    # 並印白話擋下,只有這條印「0 篇」**看起來像查過了**——而它根本沒有圖譜可查。\n    # 文件本來就寫著這條路會回「圖譜缺」,只是零檔時走不到。\n    if _vault is None:\n        return _no_vault_msg()\n    _env_shared = Env(_vault)   # 建一次,逐檔復用(r1 N+1)\n    for f in files:\n        d = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n                     \"diff\", \"--no-ext-diff\", \"--no-textconv\", diff_range, \"--\", f], capture_output=True, text=True, errors=\"replace\")\n        hunk = \" \".join(l[1:].strip() for l in d.stdout.splitlines()\n                        if l[:1] in \"+-\" and not l.startswith((\"+++\", \"---\")))[:4000]\n        buf = io.StringIO()\n        with contextlib.redirect_stdout(buf):\n            rc = cmd_impact(f, repo=str(repo_root), depth=depth, as_json=True,\n                            ranked=True, top=top, min_score=min_score,\n                            payload={\"query\": hunk, \"prospective\": {}},\n                            preloaded=(_vault, _env_shared) if _env_shared is not None else None)\n        if rc == 3:\n            print(\"IMPACT-DEBUG: vault 找不到(rc3)\", file=sys.stderr)\n            return 3\n        if rc != 0:\n            continue\n        try:\n            data = _json.loads(buf.getvalue().strip().splitlines()[-1])\n        except (ValueError, IndexError):\n            continue\n        _pm = {\"file\": f, **data.get(\"meta\", {})}\n        if data.get(\"query_gated\"):\n            _pm[\"query_gated\"] = True   # 觀測欄聚合轉發(r1 f5:code-loop 鏡頭可見)\n        per_file_meta.append(_pm)\n        for x in data.get(\"results\", []):\n            cur = merged.get(x[\"node\"])\n            if cur is None:\n                merged[x[\"node\"]] = {**x, \"files\": [f]}\n            else:\n                if f not in cur[\"files\"]:\n                    cur[\"files\"].append(f)\n                pinned = cur[\"pinned\"] or x.get(\"pinned\", False)\n                # ★家是「哪支檔的家」,不是「這一輪分數高不高」★(推筆記認家 [S6]):\n                # 同一篇在 A 檔是家、在 B 檔只是被提到,B 檔那筆分數較高就會整項重建——\n        return (False, (f\"記錄 sha {rec_sha[:8]} 在這份 repo 裡找不到(寫錯、淺 clone、或已被清掉),\"\n                        \"判不了是不是祖先——先確認那個提交還在,不在就照重來的步驟重記\"), True)\n    return (False, (f\"記錄 sha {rec_sha[:8]} 在這份 repo 的完整歷史裡找不到(寫錯或已被清掉),\"\n                    \"不可能是目標的祖先——照重來的步驟重記\"), False)\n\n\ndef _codeloop_record_valid_ex(repo_root, rec_sha, marker_sha, timeout=None):\n    \"\"\"同 `_codeloop_record_valid` 的判定,但固定回三元組 (ok, 為什麼, 判不了):判不了=git 逾時、讀不懂 git diff 的輸出、\n    讀不到簿記資料夾裡檔案的內容、或淺 clone 裡找不到那個提交(缺歷史時它可能正是祖先)。算破壞測試背書時,判不了的紀錄不能當無效丟掉\n    (那可能正是一筆 survived)。timeout 給了就用它當每次 git 的上限(算背書時傳剩餘預算)。\"\"\"\n    import subprocess as _sp\n    _to = timeout if timeout is not None else _disp_git_timeout()\n    if not rec_sha:\n        return (False, \"記錄沒有 sha\", False)\n    if rec_sha == marker_sha:\n        return (True, f\"同版本 {marker_sha[:8]}\", False)\n    try:\n        anc = _sp.run([\"git\", \"merge-base\", \"--is-ancestor\", rec_sha, marker_sha],\n                      capture_output=True, text=True, errors=\"replace\", cwd=str(repo_root), timeout=_to)\n        if anc.returncode not in (0, 1):\n            # ★git 回 1 才是「不是祖先」;其他非零是那個提交在這份 repo 裡根本找不到★(代碼審 r1 通才席):\n            # 寫錯的 sha、淺 clone、或物件被清掉。第一版把這種也講成「多半是壓過提交」,給了文不對題的重來指令。\n            return _codeloop_missing_commit(repo_root, rec_sha, _to)\n        if anc.returncode != 0:\n            # ★講出最常見的原因與怎麼重來★(2026-09-22 rtb-production-agent-demo 回報):\n            # 把本機提交壓成一個、或 rebase 之後,內容可以一模一樣,原本記的那個提交卻不再是祖先。\n            # 只丟兩個 sha 的話,人看不出是自己剛做的壓提交造成的,也不知道要重跑哪兩個指令。\n            return (False, (f\"記錄 sha {rec_sha[:8]} 不是目標 {marker_sha[:8]} 的祖先——多半是壓過提交或 rebase 改寫過歷史\"\n                           \"(內容沒變也一樣失效)。重來:表態 `lumos pitfalls --diff <範圍> --dispositions-template --carry`\"\n                           \" 再 `lumos code-loop dispositions <檔>`;審查留痕重跑 `lumos code-loop pass --note \\\"…\\\"`\"), False)\n        # ★--no-renames★:改名偵測只列新路徑,把程式檔改名搬進簿記資料夾(還能順便換副檔名)就看不到「程式檔被刪」;\n        # ★-z★:預設會把中文等檔名加引號印出(core.quotepath),簿記資料夾裡的中文檔名就比不到前綴(回頭重讀代碼審 r1 資安席 F4)\n        # ★--raw★(回頭重讀代碼審 r3 資安席 F2):連兩邊的檔案模式一起拿,簿記資料夾裡可執行的檔要認得出來;路徑清單跟 --name-only 同一份\n        df = _sp.run([\"git\", \"diff\", \"--no-ext-diff\", \"--raw\", \"--no-renames\", \"-z\", rec_sha, marker_sha],\n                     capture_output=True, cwd=str(repo_root), timeout=_to)\n    except _sp.TimeoutExpired:\n        return (False, f\"git 超過 {_to:.0f} 秒沒回(merge-base/diff),判不了有效性\", True)\n    modes = _codeloop_raw_modes(df.stdout) if df.returncode == 0 else None\n    if modes is None:\n        return (False, f\"讀不懂 git diff {rec_sha[:8]}..{marker_sha[:8]} 的輸出,判不了是不是純簿記增量\", True)\n    files = list(modes)\n    # 簿記資料夾底下的程式檔不算簿記(只改這一個消費者;小改動閘、風險掃描、推送前測試範圍、來源髒檔合併照舊只看前綴)\n    if all(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):\n        _code = _codeloop_bookkeeping_code(repo_root, rec_sha, marker_sha,\n                                           {f: m_ for f, m_ in modes.items() if f not in _BOOKKEEPING_FILES},\n                                           timeout=_to, unknown=None)\n        if _code is None:\n            return (False, f\"讀不到簿記資料夾裡檔案的內容,判不了 {rec_sha[:8]} 之後是不是純簿記增量\", True)\n        if not _code:\n            return (True, f\"祖先 {rec_sha[:8]}+簿記豁免(其後 {len(files)} 檔皆簿記)\", False)\n    return (False, f\"記錄 sha {rec_sha[:8]} 之後動了代碼(非純簿記增量)\", False)\n\n\ndef _codeloop_raw_changes(out):\n    \"\"\"git diff --raw -z(不偵測改名)的輸出 → {路徑: (舊模式, 新模式, 舊物件, 新物件)};模式是 \"100644\" 這種字串,\n    那一版沒有這支檔是 \"000000\"。格式對不上回 None(呼叫端當判不了)。路徑用無損解碼。\"\"\"\n    parts = out.split(b\"\\0\")\n    res, i = {}, 0\n    while i < len(parts) and parts[i]:\n        meta = parts[i]\n        if i + 1 >= len(parts) or not meta.startswith(b\":\"):\n            return None\n        fields = meta[1:].split(b\" \")\n        if len(fields) < 5 or not parts[i + 1]:\n            return None\n        res[os.fsdecode(parts[i + 1])] = tuple(v.decode(\"ascii\", \"replace\") for v in fields[:4])\n        i += 2\n    return res\n\n\ndef _codeloop_raw_modes(out):\n    \"\"\"既有留痕消費者只取模式；模式與首行消費者共用同一個 raw 解析器。\"\"\"\n    changes = _codeloop_raw_changes(out)\n    return None if changes is None else {f: row[:2] for f, row in changes.items()}\n\n\n# 留痕有效性讀簿記資料夾裡沒副檔名那幾支的首行時,單支的大小上限(回頭重讀代碼審 r3 架構對齊席 F2:走帶上限的批次讀取)。\n# 超過上限讀不到 → 判不了 → 保守當程式檔(留痕失效)。2026-10-01 本 repo 簿記資料夾裡沒副檔名的只有 .weekly-stamp(9 位元組)\n# 與 .rotation-cursor(約 5.6 KB、每輪加一行),離上限很遠。\n_CODELOOP_BOOKKEEPING_HEAD_CAP = 1024 * 1024\n\n\ndef _codeloop_bookkeeping_code(repo_root, rec_sha, marker_sha, files, timeout=None, unknown=True):\n    \"\"\"簿記資料夾底下這幾支裡有沒有程式檔(有就不算簿記)。files={路徑: (記錄那版模式, 目標那版模式)}(_codeloop_raw_modes)。\n    判的是目標提交 marker_sha 裡那一版;那一版刪掉了(模式 000000)就判記錄 rec_sha 那一版。任一條成立就算程式檔:\n    ①那一版的模式是可執行(100755),有沒有副檔名、有沒有寫 #! 都算(回頭重讀代碼審 r3 資安席 F2:沒有可用 #! 的\n      可執行檔,bash 會改用 sh 直接跑它的內容);\n    ②副檔名在清單裡(_nodehome_code_kind,跟每支檔有家同一套);\n    ③沒副檔名、首行是 #!——首行從 git 讀那一版(不讀磁碟,磁碟上可以是別的),判之前先去掉 UTF-8 BOM 與行首空白\n      (_head_is_shebang lenient;#! 在第二行不算,跟每支檔有家同口徑);\n    ④沒副檔名、首行判不了:路徑帶控制字元(_path_special_chars,不算替身字元)——git 的批次讀取會吃掉行尾的 \\r,查「run\\r」\n      拿回的是同目錄另一支「run」(回頭重讀代碼審 r3 資安席 F1,major);超過 _CODELOOP_BOOKKEEPING_HEAD_CAP 或讀不到\n      (子模組、批次讀取失敗)——都保守當程式檔(同 _is_code_file)。\n    代碼審 r2 架構對齊席 F1:第一版只接副檔名那一半,沒副檔名的 #! 腳本搬進簿記資料夾照樣豁免。\"\"\"\n    ask = []\n    for f, (old_mode, new_mode) in files.items():\n        deleted = new_mode == \"000000\"\n        if (old_mode if deleted else new_mode) == \"100755\":\n            return True\n        kind = _nodehome_code_kind(f)\n        if kind == \"ext\":\n            return True\n        if kind == \"shebang?\":\n            if _path_special_chars(f, surrogate=False):\n                return True\n            ask.append(f\"{rec_sha if deleted else marker_sha}:{f}\")\n    if not ask:\n        return False\n    blobs = _nodehome_cat_blobs_capped(repo_root, ask, _CODELOOP_BOOKKEEPING_HEAD_CAP,\n                                       timeout=timeout if timeout is not None else _disp_git_timeout())\n    if blobs is None:\n        return unknown   # 預設保守當程式檔;算破壞測試背書時傳 None,讓呼叫端判「判不了」\n    return any(head is None or _head_is_shebang(head, lenient=True) for head in blobs)\n\n\ndef _disp_git_timeout():\n    \"\"\"單次 git 子程序上限(秒;r1 併發席 f2:20 秒預算只在每題迴圈頂端查,單次 git 卡住預算攔不住)。\n    超時往上拋 subprocess.TimeoutExpired,由每題的例外接手判「無法驗證」(擋,不放行)。\"\"\"\n    try:\n        return max(0.1, float(os.environ.get(\"LUMOS_DISP_GIT_TIMEOUT\", \"8\")))\n    except ValueError:\n        return 8.0\n\n\ndef _git_tree_has(repo_root, at_sha, path):\n    import subprocess as _sp\n    r = _sp.run([\"git\", \"cat-file\", \"-e\", f\"{at_sha}:{path}\"], capture_output=True, text=True, errors=\"replace\", cwd=str(repo_root), timeout=_disp_git_timeout())\n    return r.returncode == 0\n\n\ndef _git_tree_text(repo_root, at_sha, path):\n    import subprocess as _sp\n    r = _sp.run([\"git\", \"show\", f\"{at_sha}:{path}\"], capture_output=True, text=True, cwd=str(repo_root), errors=\"ignore\", timeout=_disp_git_timeout())\n    return r.stdout if r.returncode == 0 else None\n\n\ndef _dispositions_check_path_line(repo_root, at_sha, ev):\n    \"\"\"satisfied 的 path:line 錨點:走 refcheck 同一個入口 _validate_repo_ref(有 at_sha 對被推送的樹、沒有對工作樹;\n    三態 missing/line_out_of_range/ok 同義;r3 架構對齊席 A3)。只驗存在不驗內容。\"\"\"\n    p, line = _dispositions_split_path_line(ev)\n    if p is None:\n        return False, line\n    st, _ = _validate_repo_ref(Path(repo_root), p, line, at_sha=at_sha)\n    if st == \"ok\":\n        return True, \"\"\n    where = f\"推送版本 {at_sha[:8]} 的樹\" if at_sha else \"工作樹\"\n    why = \"不存在(未追蹤/未提交?)\" if st == \"missing\" else \"行號超出檔案長度\"\n    return False, f\"{p}:{line} 在{where}{why}\"\n\n\ndef _dispositions_check_test(repo_root, at_sha, ev, pidx):\n697:def t_codeloop_pass_lists_dirty_bookkeeping():\n9590:        check(f\"code-exts: check-graph-sync 對 {name} 判 {want}\", cgs._shebang_script(d / name) is want, \"\")\n9591:        check(f\"code-exts: impact-hook 對 {name} 判 {want}\", imp._shebang_is_code(d / name) is want, \"\")\n9594:        check(f\"code-exts: {k} 的 shebang 規則是「任何 #!」而不是直譯器清單\", 'is_shebang_code()' in src and '\"$first\" == \"#!\"*' in src and \"python|bash\" not in src, \"\")\n9600:def t_precommit_shebang_script_counts_as_code():\n9617:    check(\"precommit shebang: 只改無副檔名的 python 主程式、不帶節點 → 擋\", r1.returncode != 0 and \"擋下\" in r1.stderr + r1.stdout, f\"rc={r1.returncode} {(r1.stderr+r1.stdout)[-160:]}\")\n9619:    check(\"precommit shebang: #!/bin/dash 也算程式碼 → 擋(r1 外家:直譯器清單漏 dash)\", r2.returncode != 0, f\"rc={r2.returncode}\")\n9621:    check(\"precommit shebang: env -S 形式也算 → 擋\", r2b.returncode != 0, f\"rc={r2b.returncode}\")\n9623:    check(\"precommit shebang: 只有開頭一個點的 dotfile 也看 shebang → 擋(通才 minor)\"