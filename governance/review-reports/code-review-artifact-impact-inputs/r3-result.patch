    has_remote = subprocess.run([\"git\", \"-C\", str(src), \"remote\"],\n                                capture_output=True, text=True, errors=\"replace\").stdout.strip()\n    if not has_remote:\n        print(\"  (來源無 remote:離線 clone,跳過 pull)\")\n        return 0\n    print(\"  git pull 來源(取最新工具組)…\")\n    if subprocess.run([\"git\", \"-C\", str(src), \"pull\", \"--ff-only\"]).returncode == 0:\n        return 0\n    # ★來源「只髒了工具自己寫的帳」不該擋人★(2026-09-06 全 repo 審視 #5)\n    # 症狀:唯讀的 `lumos show`/`context` 就會 append docs/.usage-log.jsonl,而那本帳是版控的。\n    # (2026-10-04 起使用紀錄與例行治理觀察改寫不進版控的 .usage-local / .governance-local,\n    #  這條路弄髒的機會變少;舊帳與主動決定仍會被寫,聯集合併照留。)\n    # 只要有人在來源 clone 裡查過一次圖譜,之後這台機器所有專案的 update / bootstrap --pull\n    # 全部被 fail-closed 擋住;逃生門寫在錯誤訊息最後一行,沒人會讀到那裡。\n    #\n    # ★做法是「聯集合併」,不是 stash/pop★:這幾本是 append-only 的 JSONL,兩邊各自加了行,\n_LENS_BADGE = {\"real\": \"[綁定測試:有]\", \"dangling\": \"[綁定測試:懸空]\", \"fake\": \"[綁定測試:偽證據]\",\n               \"naked\": \"★裸合約——閘守不到,只剩你讀★\"}\n_LENS_FOOT_OK = \"「有」=方法存在於本分支測試索引,不代表跑過、也不代表有殺傷力(閘只看 rc,空殼測試 rc=0 照樣放行;殺傷力見 guard kill)\"\n_LENS_FOOT_SKIP = \"綁定測試狀態:略(平台設定讀不到)\"\n\n\ndef _lens_contract_rows(text):\n    \"\"\"base 版節點全文裡的合約行→[(kind, 完整行)];只認 KEY: 行(三個既有正規式),★不截斷★——分類要用原文,截斷只在顯示。\"\"\"\n    return [(kind, s) for s, _m, kind in _contract_key_matches(text, with_kind=True)]\n\n\n# v1.2 備援段:所有邏輯只用 base 樹;預算=hook 內層 45 秒總帳扣 impact 已耗\n_LENS_SCHEMA = 3   # 3:2026-10-03 外部事實行與外部碼表補選(輸出多了段落與 extcode_status)\n_LENS_INNER_BUDGET = 45.0\n_LENS_FALLBACK_RESERVE = 5.0\n_LENS_IDENT_RE = re.compile(r\"^[A-Za-z_][A-Za-z0-9_]{0,120}$\")\n_LENS_FB_HEADER = \"圖譜沒有釘到節點——以下是 code 層的既有相依,審查員自己判(這段不是合約,不必逐條答)\"\n_LENS_FB_FOOT = \"以上是機械反查,不是圖譜結論;命中不代表相依成立、沒命中不代表沒有\"\n_LENS_HIT_RATIO_MAX = 0.20\n_LENS_CAND_CAP = 40\n\n\ndef _json_at_ref(repo_root, ref, rel_path, timeout=10):\n    \"\"\"從 git ref 讀 JSON(`git show <ref>:<path>`);沒有/壞→None。只信 base 的設定要靠它,不讀工作樹。\n    容許開頭的 BOM(Windows 編輯器常見);超深巢狀丟的 RecursionError 也當壞(2026-09-29 角色鏡頭代碼審 r2 正確性席)。\"\"\"\n    import json as _json\n    r = _lens_git(repo_root, \"show\", f\"{ref}:{rel_path}\")\n    if r is None or r.returncode != 0:\n        return None\n    try:\n        d = _json.loads(r.stdout.lstrip(\"\\ufeff\"))\n        return d if isinstance(d, dict) else None\n    except (ValueError, RecursionError):\n        return None\n\n\ndef _lens_py_defs(text):\n    \"\"\"base 版 python 原文→頂層 def/class 的 [(name, start, end)](含裝飾器行);parse 失敗回 None。標準庫 ast,沿 slim-gen/slim-scan 先例。\"\"\"\n    import ast as _ast\n    try:\n        tree = _ast.parse(text)\n    except (SyntaxError, ValueError):\n        return None\n    out = []\n    for node in tree.body:\n        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef, _ast.ClassDef)):\n            start = min([node.lineno] + [d.lineno for d in getattr(node, \"decorator_list\", [])])\n            end = getattr(node, \"end_lineno\", node.lineno) or node.lineno\n            if _LENS_IDENT_RE.match(node.name):\n                out.append((node.name, start, end))\n    return out\n\n\ndef _lens_hunks_base_ranges(repo_root, base_sha, head_sha, path, timeout=10):\n    \"\"\"`git diff -U0 base head -- path` 的 - 側行範圍 [(a, a+b-1)];純新增 b=0 不產生範圍(另計);整檔刪除回 ('deleted', n)。\"\"\"\n    r = _lens_git(repo_root, \"diff\", \"--no-ext-diff\", \"--no-textconv\", \"-U0\",\n    _STACK_QUESTION_SPECS[_stk].append({\"id\": f\"{_stk}-extcode\", \"q\": _EXTCODE_Q, \"when\": list(_EXTCODE_WHEN),\n                                        \"when_raw\": list(_EXTCODE_WHEN_RAW), \"shape_only\": True})\n_STACK_PERF_QUESTIONS = {_k: [_s[\"q\"] for _s in _v if not _s.get(\"shape_only\")] for _k, _v in _STACK_QUESTION_SPECS.items()}   # 派生:舊語意(命中棧整組原文;shape_only 題不進)\n_EXTCODE_RX_PLAIN = tuple(re.compile(_p, re.I) for _p in _EXTCODE_WHEN)      # 鏡頭用:同兩組字串、同 re.I\n_EXTCODE_RX_RAW = tuple(re.compile(_p, re.I) for _p in _EXTCODE_WHEN_RAW)\n# when=範式詞+反面詞(2026-09-09 Enzo:用爛的方法寫同一個功能不能亮不同題或不亮——舊法/土法會出現的字也讓同一題亮;反面詞要具體到不誤傷,Thread\\( 不是 Thread)\n# 第三欄 when_raw(r1 外家 finder f7 → code-反面詞 r1 單席 f1 改成逐 pattern):只有這幾條要看字串內容(.on(\"error\"、LIKE '%、\n# import from \"./x\"、\"SELECT 、require('child_process')),同題其他 pattern 照樣剝字串——整題看字串會讓 log 訊息裡的 SELECT/JSON.parse 變假命中\n_STACK_TRIGGERS = {_k: [(_s[\"id\"], tuple(re.compile(_p, re.I) for _p in _s[\"when\"]), tuple(re.compile(_p, re.I) for _p in _s.get(\"when_raw\", ()))) for _s in _v]\n                   for _k, _v in _STACK_QUESTION_SPECS.items()}   # 載入時編譯:壞 regex=啟動即錯\n# 以 \"node\" 鍵而非副檔名為棧的原因:.ts/.js 在 Vue 前端與 Node 後端都出現,單看副檔名分不出來。\n_NODE_FRONTEND_MARKERS = (\"vue\", \"nuxt\", \"react\", \"next\", \"svelte\", \"@angular/core\", \"solid-js\", \"preact\")\n_NODE_FLAVOR_CACHE = {}\n\n\ndef _node_flavor(file_rel, repo_root, reader=None):\n    \"\"\"判一支 .ts/.js 檔是「前端(vue)」還是「Node 後端(node)」:從檔案所在目錄往上找最近的 package.json\n    (monorepo 各包各判),依賴裡有前端框架 → \"vue\"(只有 vue-idioms 這一份前端慣例,先都歸它);有 package.json\n    但沒前端框架 → \"node\";找不到 package.json → None(呼叫端沿用舊行為,不多附東西)。\n    ★只看 dependencies/devDependencies 的鍵,不猜檔案內容★——猜錯會把後端問題塞給前端檔。\n    ★最近那份 package.json 讀得到卻解析不了 → None★(容許開頭的 BOM;2026-09-29 角色鏡頭設計審 r1 邊界席:\n    原本當成沒有依賴、判成 node,前端專案的 package.json 多一個逗號就拿到後端題)。\n    reader:給了就改讀「某個版本」的 package.json(repo 相對路徑 → 文字或 None);沒給就讀工作樹(同一條往上找的路)。\"\"\"\n    if reader is None:\n        reader = lambda rel: _node_pkg_text(repo_root, rel)   # noqa: E731 — 同一條找法,只換讀取來源\n    return _node_flavor_at(file_rel, reader)\n\n\ndef _node_pkg_text(repo_root, rel):\n    \"\"\"工作樹裡某個相對路徑的 package.json 文字;沒有這個檔回 None。同一個 repo 同一份檔只讀一次(_NODE_FLAVOR_CACHE)。\n    ★檔在但讀不了(權限、非 UTF-8)回空字串★=「在但解析不了」→ 判不出;回 None 會被當成沒有、往上找到父層改判\n    (代碼審 r2 正確性席:UTF-16 的前端 package.json 被判成根層的後端)。非 UTF-8 照 git 版的讀法換字元,解析自然失敗。\"\"\"\n    key = str(Path(repo_root) / rel)\n    if key not in _NODE_FLAVOR_CACHE:\n        p = Path(key)\n        try:\n            _NODE_FLAVOR_CACHE[key] = p.read_text(encoding=\"utf-8\", errors=\"replace\") if p.is_file() else None\n        except OSError:\n            _NODE_FLAVOR_CACHE[key] = \"\"\n    return _NODE_FLAVOR_CACHE[key]\n\n\ndef _node_flavor_of(txt):\n    \"\"\"一份 package.json 的文字 → \"vue\" / \"node\";解析不了(容許開頭的 BOM)回 None。\"\"\"\n    import json\n    try:\n        data = json.loads(txt.lstrip(\"\\ufeff\"))\n    except (ValueError, RecursionError):   # 超深巢狀丟的是 RecursionError(代碼審 r1 正確性 F3)\n        return None\n    deps = set()\n    for k in (\"dependencies\", \"devDependencies\", \"peerDependencies\"):\n        v = data.get(k) if isinstance(data, dict) else None\n        if isinstance(v, dict):\n            deps.update(v.keys())\n    return \"vue\" if any(m in deps for m in _NODE_FRONTEND_MARKERS) else \"node\"\n\n\ndef _package_json_candidates(file_rel):\n    \"\"\"從檔案所在目錄往上到 repo 根,每一層的 package.json 相對路徑(近的在前)。\"\"\"\n    from pathlib import PurePosixPath\n    parts = PurePosixPath(file_rel).parts[:-1]\n    return [\"/\".join((*parts[:i], \"package.json\")) for i in range(len(parts), -1, -1)]\n\n\ndef _node_flavor_at(file_rel, reader):\n    \"\"\"_node_flavor 的「讀指定版本」那一半:最近一份讀得到的 package.json 決定。\"\"\"\n    for rel in _package_json_candidates(file_rel):\n        txt = reader(rel)\n        if txt is not None:\n            return _node_flavor_of(txt)\n    return None\n\n\n_NODE_EXTS = {\"ts\", \"tsx\", \"js\", \"jsx\", \"mjs\", \"cjs\", \"mts\", \"cts\"}\n\n\ndef _stack_key_for_file(file_rel, repo_root, reader=None):\n    \"\"\"一支改動檔對到 _STACK_PERF_QUESTIONS 的鍵:一般=副檔名;.ts/.js 家族要看 package.json——\n    後端回 \"node\",前端回 \"vue\"(.vue 檔本來就命中 vue 鍵;純 .ts 前端檔目前無獨立題組,回 None)。\n    兩個消費者(pitfalls --diff / impact hook)都走這一支,別各自抄副檔名邏輯。\"\"\"\n    ext = Path(file_rel).suffix.lstrip(\".\").lower()\n    if ext in _NODE_EXTS:\n        # 2026-09-09(表態閘 r2 邊界席 B4):前端 .ts/.js 原本回 None=零覆蓋零稽核;改歸 vue 棧(watch/ref/await 那幾題有觸發)。\n        _fl = _node_flavor(file_rel, repo_root, reader=reader)\n        return \"node\" if _fl == \"node\" else (\"vue\" if _fl == \"vue\" else None)\n    return ext if ext in _STACK_PERF_QUESTIONS else None\n\n\n# ── 代碼審角色鏡頭(Projects/代碼審前後端角色鏡頭_計劃,2026-