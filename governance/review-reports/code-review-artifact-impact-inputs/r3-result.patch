.dart';\\n\") is None, \"\")\n 38387\t    check(\"S6: 沒讀內容(超過上限)的手機檔 → 判不出\", F(\"a/Screen.kt\", None) is None, \"\")\n 38388\t\n 38389\t\n 38390\tdef t_review_role_changed_files_population():\n 38391\t    \"\"\"[S7] 改動檔清單:剔測試、消費專案原封不動的工具檔、.md;改名算新路徑;刪除讀起點(連 package.json 一起刪也讀得到)。\"\"\"\n 38392\t    import json as _j\n 38393\t    m = _load_lumos_inproc()\n 38394\t    d, g, w, c = _role_git_repo()\n 38395\t    vend = sorted(p for p in m._VENDORED_ALL if p.endswith(\".py\"))[0]\n 38396\t    w(\"web/package.json\", '{\"dependencies\": {\"vue\": \"3\"}}'); w(\"web/src/old.ts\", \"export const a = 1\\n\")\n 38397\t    w(\"api/Old.py\", \"x = 1\\n\"); w(vend, \"print('tool')\\n\")\n 38398\t    w(m._VENDORED_MANIFEST, _j.dumps({\"files\": {vend: m._vendored_digest(b\"print('tool')\\n\")}}))\n 38399\t    base = c(\"base\")\n 38400\t    g(\"rm\", \"-rq\", \"web\"); g(\"mv\", \"api/Old.py\", \"api/New.py\")\n 38401\t    w(\"api/test_new.py\", \"def test_x(): pass\\n\"); w(\"README.md\", \"x\\n\"); w(\"api/svc.py\", \"y = 2\\n\")\n 38402\t    head = c(\"head\")\n 38403\t    files = dict(m._review_role_changed_files(d, base, head))\n 38404\t    check(\"S7: 測試檔、.md 被剔除\", \"api/test_new.py\" not in files and \"README.md\" not in files, str(files))\n 38405\t    check(\"S7: 改名算新路徑\", \"api/New.py\" in files and \"api/Old.py\" not in files, str(files))\n 38406\t    check(\"S7: 刪除的檔照樣算、讀起點版本\", files.get(\"web/src/old.ts\") == base, str(files))\n 38407\t    # 此案驗凍結內容，給真 Git 充足預算；期限降級由 file_cap_and_budget 案驗。\n 38408\t    res = m._review_roles(d, base, head, budget=30)\n 38409\t    check(\"S7: 刪除的 .ts 連 package.json 一起刪,照樣從起點讀到 vue → 前端\",\n 38410\t          res[\"roles\"].get(\"web/src/old.ts\") == \"frontend\", str(res))\n 38411\t    # 消費專案跑 lumos update:工具檔換新內容、指紋清單同步換新 → 它在範圍內、而且在終點原封不動 → 要剔掉\n 38412\t    w(vend, \"print('tool v2')\\n\")\n 38413\t    w(m._VENDORED_MANIFEST, _j.dumps({\"files\": {vend: m._vendored_digest(b\"print('tool v2')\\n\")}}))\n 38414\t    w(\"api/svc.py\",