es3, str(files3))\n 38421\t\n 38422\t\n 38423\tdef t_review_role_reads_head_content_base_config():\n 38424\t    \"\"\"[S8] 內容讀終點提交、不讀工作樹;宣告讀起點,被審分支改宣告不影響自己。\"\"\"\n 38425\t    import json as _j\n 38426\t    m = _load_lumos_inproc()\n 38427\t    d, g, w, c = _role_git_repo()\n 38428\t    w(\"pkg/package.json\", '{\"dependencies\": {\"vue\": \"3\"}}'); w(\"pkg/a.ts\", \"export const a = 1\\n\")\n 38429\t    w(\".lumos/config.json\", _j.dumps({\"review_roles\": [{\"path\": \"srv/*\", \"role\": \"backend\"}]}))\n 38430\t    base = c(\"base\")\n 38431\t    w(\"pkg/a.ts\", \"export const a = 2\\n\"); w(\"srv/x.tsx\", \"export const X = 1\\n\")\n 38432\t    w(\".lumos/config.json\", _j.dumps({\"review_roles\": [{\"path\": \"srv/*\", \"role\": \"none\"}, {\"path\": \"pkg/*\", \"role\": \"none\"}]}))\n 38433\t    head = c(\"head\")\n 38434\t    (d / \"pkg\" / \"package.json\").write_text('{\"dependencies\": {\"fastify\": \"5\"}}', encoding=\"utf-8\")   # 工作樹不同、沒提交\n 38435\t    # 此案驗凍結內容，給真 Git 充足預算；期限降級由 file_cap_and_budget 案驗。\n 38436\t    res = m._review_roles(d, base, head, budget=30)\n 38437\t    check(\"S8: 依終點提交的 package.json(vue)判前端,不理工作樹(fastify)\", res[\"roles\"].get(\"pkg/a.ts\") == \"frontend\", str(res))\n 38438\t    check(\"S8: 被審分支把宣告改成 none 不算數,照起點的 srv/* → backend\", res[\"roles\"].get(\"srv/x.tsx\") == \"backend\", str(res))\n 38439\t\n 38440\t\n 38441\tdef _role_lens_repo(with_vault=True):\n 38442\t    \"\"\"給派工鏡頭跑的 repo:main 上有(或沒有)圖譜,feat 分支改一支前端 .vue 與一支後端 .py。\"\"\"\n 38443\t    d, g, w, c = _role_git_repo()\n 38444\t    w(\"src/api.py\", \"def f():\\n    return 1\\n\")\n 38445\t    if with_vault:\n 38446\t        w(\"docs/t-knowledge/Systems/api.md\", \"---\\ntype: system\\nstatus: done\\nsummary: |-\\n  KEY:api\\n---\\n\\n管 `src/api.py`。\\n\")\n 38447\t    c(\"main\")\n 38448\t    g(\"checkout\", \"-qb\", \"feat\")\n 38449\t    return d, g, w, c\n 38450\t\n 38451\t\n 38452\tdef t_dispatch_lens_role_cards_opt_in():\n 38453\t    \"\"\"[S9] 開了才附;框外;回傳文字本身也含(舊掛鉤照附);全端兩張;判不出不附;壞宣告只附警告;掛鉤沒標記不傳旗標。\"\"\"\n 38454\t    import json as _j, io as _io\n 38455\t    from unittest.mock import patch\n 38456\t    d, g, w, c = _role_lens_repo()\n 38457\t    w(\"web/App.vue\", \"<template/>\\n\"); c(\"fe\")\n 38458\t\n 38459\t    def lens(*extra):\n 38460\t        r = run(d / \"docs\" / \"t-knowledge\", \"dispatch-lens\", \"main..HEAD\", \"--repo\", str(d), \"--json\", \"--no-cache\", *extra)\n 38461\t        try:\n 38462\t            return r.returncode, _j.loads(r.stdout.strip().splitlines()[-1])\n 38463\t        except (ValueError, IndexError):\n 38464\t            return r.returncode, {}\n 38465\t    rc, data = lens()\n 38466\t    check(\"S9: 沒開 --role-cards → 沒有角色段\", rc == 0 and \"role_text\" not in data and \"fe-race\" not in data.get(\"text\", \"\"), str(data)[:300])\n 38467\t    rc, data = lens(\"--role-cards\")\n 38468\t    t = data.get(\"text\", \"\")\n 38469\t    check(\"S9: 開了、改到前端 → 前端卡全文與題號、沒有後端卡\",\n 38470\t          rc == 0 and all(q[\"id\"] in t for q in _load_lumos_inproc()._ROLE_CARDS[\"frontend\"]) and \"be-authz\" not in t, t[-600:])\n 38471\t    check(\"S9: 角色段在參考資料框外(框結束線之後)、且回傳 text 本身就含(舊掛鉤照附)\",\n 38472\t          \"[角色鏡頭]\" in t and (\"─────\" not in t or t.rfind(\"─────\") < t.find(\"[角色鏡頭]\")) and data.get(\"role_text\", \"\") in t, t[-600:])\n 38473\t    w(\"src/api.py\", \"def f():\\n    return 2\\n\"); c(\"be\")\n 38474\t    rc, data = lens(\"--role-cards\")\n 38475\t    check(\"S9: 全端改動 → 兩張都附\", \"fe-race\" in data.get(\"text\", \"\") and \"be-authz\" in data.get(\"text\", \"\"), data.get(\"text\", \"\")[-400:])\n 38476\t    d2, g2, w2, c2 = _role_lens_repo()\n 38477\t    w2(\"notes.txt\", \"x\\n\"); c2(\"unknown only\")\n 38478\t    r = run(d2 / \"docs\" / \"t-knowledge\", \"dispatch-lens\", \"main..HEAD\", \"--repo\", str(d2), \"--json\", \"--no-cache\", \"--role-cards\")\n 38479\t    dd = _j.loads(r.stdout.strip().splitlines()[-1]) if r.stdout.strip() else {}\n 38480\t    check(\"S9: 全部判不出 → 一張都