y:\n 12423\t        print(f\"[fix-check] base 留空:{why}\", file=sys.stderr)\n 12424\t    if exempt:\n 12425\t        print(f\"[fix-check] 這幾條記成 spec/process,不用修正紀錄:{', '.join(exempt)}\", file=sys.stderr)\n 12426\t    if not has_kinds:\n 12427\t        print(\"[fix-check] 記帳時帶 --finding-kind 可讓文件、流程類發現免填\", file=sys.stderr)\n 12428\t    groups = [{\"id\": f\"G{i}\", \"category\": \"\", \"findings\": [f],\n 12429\t               \"paths\": [{\"at\": \"<檔案:函式>\", \"status\": \"fixed\", \"tests\": [\"<測試名>\"]}]}\n 12430\t              for i, f in enumerate(need, 1)]\n\nhook: PostToolUse\nhook: PostToolUse Completed\nhook: PreToolUse\nhook: PreToolUse Completed\nexec\n/bin/zsh -lc \"nl -ba scripts/lumos | sed -n '7490,7545p'; nl -ba scripts/lumos | sed -n '24570,24630p'; nl -ba scripts/lumos | sed -n '26700,26770p'; nl -ba scripts/lumos | sed -n '27060,27145p'; nl -ba scripts/lumos | sed -n '31340,31380p'\" in /private/tmp/lumos-review-artifact-impact-inputs\n succeeded in 0ms:\n  7490\t        except ValueError:\n  7491\t            continue\n  7492\t        if isinstance(d, dict) and d.get(\"kind\") == \"spec-gate\" and d.get(\"loop\"):\n  7493\t            latest[nfc(str(d[\"loop\"]))] = d\n  7494\t    return latest\n  7495\t\n  7496\t\n  7497\tdef _spec_gate_push_candidates(env, rr, vrel, touched):\n  7498\t    \"\"\"推送前要查哪些計劃:範圍碰到的計劃檔,加上 lands_in/related/正文連結指向「被碰到的 Systems 節點或被改程式檔的家」的 doing 計劃。\"\"\"\n  7499\t    plans = {t[len(vrel) + 1:] for t in touched if t.startswith(vrel + \"/Projects/\") and t.endswith(\".md\")}\n  7500\t    systems = {t[len(vrel) + 1:-3] for t in touched if t.startswith(vrel + \"/Systems/\") and t.endswith(\".md\")}\n  7501\t    code = [t for t in touched if not t.startswith(vrel + \"/\")]\n  7502\t    if code:   # 實作提交常只動程式檔不動筆記(編排者實測 E2):被改的檔的家也算被碰到——家對照表走唯一算法 _impact_home_map(代碼審 r2 架構席:自己掃 about_code 會漏掉 status 過濾與路徑正規化)\n  7503\t        homes, _own = _impact_home_map(env)\n  7504\t        for f in code:\n  7505\t            for srel in homes.get(_nodehome_key(f), []):\n  7506\t                systems.add(srel[:-3] if srel.endswith(\".md\") else srel)\n  7507\t    if systems:   # 落點被碰到:lands_in/related/正文連結任一指向被改的 Systems 節點(跟門判定訊號 2 同一份連結來源)\n  7508\t        for prel, n in env.notes.items():\n  7509\t            if not prel.startswith(\"Projects/\") or str(n.fields.get(\"status\")) != \"doing\":\n  7510\t                continue\n  7511\t            try:\n  7512\t                ptxt = (env.vault / prel).read_text(encoding=\"utf-8-sig\")\n  7513\t            except (OSError, UnicodeDecodeError):\n  7514\t                ptxt = \"\"\n  7515\t            if set(_plan_system_links(n, text=ptxt, systems_only=False)) & systems:\n  7516\t                plans.add(prel)\n  7517\t    return plans\n  7518\t\n  7519\t\n  7520\tdef _head_is_shebang(head, lenient=False):\n  7521\t    \"\"\"檔案開頭那段 bytes 的第一行是不是 #!(每支檔有家與 _is_code_file 共用這一支——代碼審 r2 架構席:別各寫一份)。\n  7522\t    lenient=True 先去掉 UTF-8 BOM 與行首空白(空格、tab、CR、FF、VT;不去換行,#! 在第二行照舊不算)再看:\n  7523\t    只有代碼審留痕有效性的簿記判法用(回頭重讀代碼審 r3 資安席 F2——這兩種 bash 照樣跑得起來);每支檔有家維持嚴格口徑。\"\"\"\n  7524\t    if not head:\n  7525\t        return False\n  7526\t    if lenient:\n  7527\t        head = head[3:] if head.startswith(b\"\\xef\\xbb\\xbf\") else head\n  7528\t        head = head.lstrip(b\" \\t\\r\\f\\v\")\n  7529\t    return head[:200].split(b\"\\n\", 1)[0].startswith(b\"#!\")\n  7530\t\n  7531\t\n  7532\tdef _shebang_line_is_python(first_line):\n  7533\t    \"\"\"檔案首行是不是 python 的 #!(派工鏡頭的退路與存量漂移的條件判定共用;跟 _head_is_shebang 放一起——代碼審 r3 架構對齊席)。\"\"\"\n  7534\t    return first_line.startswith(\"#!\") and \"python\" in first_line\n  7535\t\n  7536\t\n  7537\tdef _is_code_file(rr, path, base=None):\n  7538\t    \"\"\"「需要有家的程式檔」判定(每支檔有家同一套):副檔名在清單裡=是;沒副檔名要看首行是不是 #!(.gitignore/Makefile 這種不是)。\n  7539\t    磁碟上沒有(這次被刪)就從範圍起點 base 讀;兩邊都讀不到★保守當程式檔★(代碼審 r2 通才席 blocker:刪掉 hook 本身被判成沒程式檔 → light 漏派審)。\n  7540\t    豁免層也同一套(代碼審 r3 通才席):排除 glob(docs/*、node_modules、bin…)、測試檔、.lumos/config 的 ignore——這些每支檔有家不要求有家,這裡也不算程式檔。\"\"\"\n  7541\t    import fnmatch as _fn\n  7542\t    if any(_fn.fnmatch(path, g) for g in _NODEHOME_EXCLUDE_GLOBS) or _nodehome_is_test(path):\n  7543\t        return False\n  7544\t    try:\n  7545\t        if _cochange_excluded(path, _nodehome_config(rr)[\"ignore\"]):\n 24570\t    # SELECT … FROM(欄位任意:COUNT(*)、u.id、別名都算)或 SELECT 常數;表名限 ASCII 識別字起頭,「UPDATE 失敗」這種訊息文字不算\n 24571\t    (re.compile(r\"\\bSELECT\\b.*\\bFROM\\b|\\bSELECT\\s+\\d\", re.I), \"效能\", \"是否在迴圈內、造成 N+1?\", True),\n 24572\t    (re.compile(r\"\\btime\\.sleep\\s*\\(\", re.I), \"效能\", \"sleep 在迴圈裡會不會累積延遲?\", False),\n 24573\t    (re.compile(r\"\\bthreading\\.|\\bLock\\s*\\(|global\\s+\\w+\", re.I), \"併發\", \"共享狀態有沒有鎖保護?\", False),\n 24574\t    (re.compile(r\"\\bINSERT\\s+INTO\\b|\\bUPDATE\\s+[A-Za-z_`\\\"\\[][\\w.`\\\"\\]]*\\s*$|\\bUPDATE\\s+[A-Za-z_`\\\"\\[][\\w.`\\\"\\]]*\\s+(?:SET|AS\\b|\\w+\\s+SET)|\\bDELETE\\s+FROM\\b\", re.I), \"併發\", \"寫入有沒有交易包裹?\", True),\n 24575\t]\n 24576\t_PITFALL_DIFF_SKIP_EXT = {\".md\", \".txt\", \".rst\",\n 24577\t                          # 資料/紀錄檔不是代碼(工具鏈補強十件 #7,2026-08-22):探針結果 JSON、\n 24578\t                          # 治理帳、log 裡記的指令字串被當代碼掃,三批推送連判 high。\n 24579\t                          \".json\", \".jsonl\", \".csv\", \".log\", \".lock\", \".svg\", \".html\", \".patch\", \".diff\"}\n 24580\t_PITFALL_STRLIT_RE = re.compile(r'\"\"\"[\\s\\S]*?\"\"\"|\\'\\'\\'[\\s\\S]*?\\'\\'\\'|\"(?:\\\\.|[^\"\\\\])*\"|\\'(?:\\\\.|[^\\'\\\\])*\\'')\n 24581\t\n 24582\t\n 24583\tdef _strip_string_literals(code):\n 24584\t    \"\"\"把一行代碼裡的字串字面挖空(保留引號),讓 pitfalls 的 open(/UPDATE 正則只看真代碼——\n 24585\t    print(\"…open(…\") 這種訊息文字不算資源風險(#7)。單行粗剝,跨行字串不處理(剝不掉就照掃,寧誤傷不漏)。\"\"\"\n 24586\t    return _PITFALL_STRLIT_RE.sub('\"\"', code)\n 24587\t\n 24588\t# 簿記檔白名單(單一源,兩個消費者:pitfalls --diff 掃描排除 + code-loop 留痕失效豁免)。\n 24589\t# 兩處分開寫過會漂移;pitfalls 這端 2026-08-11 才補上——治理帳裡記的 skip 理由本身在\n 24590\t# 描述「命中 open(...)」,被當代碼掃就再次命中 → 再 skip → 再寫一行理由……自我餵食,\n 24591\t# 實測誤觸發 9 次。這些檔是紀錄不是要合入的碼。\n 24592\t_BOOKKEEPING_FILES = (\"docs/.governance-log.jsonl\", \"docs/.usage-log.jsonl\",\n 24593\t                      # 本機帳(被忽略)萬一被 git add -A 提交,也只是簿記、不讓代碼審留痕失效(治理帳例行紀錄分流_計劃)\n 24594\t                      \"docs/\" + GOV_LOCAL_LOG_NAME, \"docs/\" + USAGE_LOCAL_LOG_NAME,\n 24595\t                      \"docs/.ci-log.jsonl\", \"docs/.canary-log.jsonl\",\n 24596\t                      \"docs/.bypass-log.jsonl\", \"docs/.escape-log.jsonl\",\n 24597\t                      \"docs/.kill-log.jsonl\", \"docs/.signoff-log.jsonl\",\n 24598\t                      \"governance/anchor-baseline.json\",\n 24599\t                      # 存量漂移守衛的表態檔:跟判定檔一樣是人對發現的回應,不是程式改動(存量漂移防線 [S3])\n 24600\t                      \"governance/drift-acks.jsonl\",\n 24601\t                      # 存量漂移的修復帳(drift fix 每改一筆記一行稽核紀錄;同表態檔,是人對發現的處理紀錄;存量漂移改法 第 7 節)\n 24602\t                      \"governance/drift-fixes.jsonl\")\n 24603\t# ↑ canary-log/bypass-log 2026-08-27 補（[[Issues/簿記白名單漏canary與bypass帳]] 死結根治）:\n 24604\t# 審計記帳(canary record)在 loop 中發生,pass 後提交它們原本會讓留痕失效→擋推。\n 24605\t# ★真效果只在 code-loop 留痕豁免這第二消費者★:pitfalls 那端 canary-log 早被\n 24606\t# _PITFALL_DIFF_SKIP_EXT(.json/.jsonl,2026-08-22)按副檔名擋掉、輪不到白名單這關(s1-f1)。\n 24607\t# ↑ kill-log/signoff-log 2026-09-06 補([[Projects/全repo審視_計劃]] #5):兩本同樣是工具自己\n 24608\t# 寫的 append-only 帳(kill-log 由 guard kill 寫、signoff-log 由 signoff 寫),而這次替\n 24609\t# _pull_source_or_abort 加「來源只髒簿記帳就聯集合併不擋人」時,漏了它們就等於那條路對這兩本\n 24610\t# 失效——有人在來源 clone 跑過 guard kill 或 signoff,更新照樣被擋。\n 24611\t_BOOKKEEPING_DIRS = (\"governance/code-loop/\", \"governance/review-reports/\", \"governance/replay/\",\n 24612\t                     \"governance/note-verdicts/\",   # 2026-09-17 小改動閘 r2:卷證目錄也是紀錄不是碼(三個消費者共用這一組)\n 24613\t                     # 2026-10-01 回頭重讀的對照紀錄:理由同筆記內容審判定檔——紀錄不是碼,提交它不該讓代碼審留痕失效\n 24614\t                     # (Projects/守檔筆記對照改動_計劃 [S8];整案回退時要同一個 revert 提交裡 git rm -r 這個資料夾)\n 24615\t                     \"governance/reread-verdicts/\")\n 24616\t_PITFALL_DIFF_TEST_PAT = re.compile(r\"(test_|_test\\.|\\.spec\\.|/tests?/)\", re.I)\n 24617\tLINT_CMD_TIMEOUT = 180\n 24618\t\n 24619\t\n 24620\tdef _diff_added_lines(diff_text):\n 24621\t    \"\"\"從 git diff -U3 輸出建 {file: set(new_line_numbers)} 對應所有新增行(+ 開頭)。\n 24622\t    使用與 _pitfall_diff_mode 相同的 @@ 標頭推導邏輯。\"\"\"\n 24623\t    added = {}\n 24624\t    cur_file, new_ln = \"\", 0\n 24625\t    for line in diff_text.splitlines():\n 24626\t        if line.startswith(\"+++ b/\"):\n 24627\t            cur_file = line[6:]\n 24628\t            continue\n 24629\t        m = re.match(r\"@@ -\\d+(?:,\\d+)? \\+(\\d+)\", line)\n 24630\t        if m:\n 26700\t    ext, top = \".\" + e, parts[0]\n 26701\t    for suf, exts in sufs.items():\n 26702\t        if ext not in exts or not top.endswith(suf):\n 26703\t            continue\n 26704\t        base = top[:-len(suf)].rstrip(\".\")\n 26705\t        if not base or ext in top_exts.get(base, ()):\n 26706\t            return True\n 26707\t    for i in range(1, len(parts) - 1):\n 26708\t        if parts[i - 1] == \"src\" and ext in under_src.get(parts[i], ()) and ext in main_exts.get(\"/\".join(parts[:i]), ()):\n 26709\t            return True\n 26710\t    return False\n 26711\t\n 26712\t\n 26713\tdef _nodehome_is_test(path, layout=({}, {})):\n 26714\t    \"\"\"測試檔判定:先問測試地圖那一支;再認各棧的測試資料夾(2026-09-12:平板 POS 測試資料夾裡的輔助檔、\n 26715\t    Android 儀器測試的 Kotlin 檔都被要求有家——測試地圖的規格刻意只認 test/tests 資料夾與檔名,不動它);\n 26716\t    副檔名不在測試地圖清單裡的(shell、Go、Rust、C…),套它同一組目錄與檔名規則。layout 見 _nodehome_in_stack_test_dir。\"\"\"\n 26717\t    global _TESTMAP_DIR_RE\n 26718\t    if _testmap_is_test(path):\n 26719\t        return True\n 26720\t    if _nodehome_in_stack_test_dir(path, layout):\n 26721\t        return True\n 26722\t    if _testmap_ext(path) in _TESTMAP_EXTS:\n 26723\t        return False                      # 測試地圖認得這種副檔名,它說不是就不是\n 26724\t    if _TESTMAP_DIR_RE is None:\n 26725\t        _TESTMAP_DIR_RE = re.compile(r\"(^|/)(tests?|__tests__|specs?)/\", re.IGNORECASE)\n 26726\t    if _TESTMAP_DIR_RE.search(path):\n 26727\t        return True\n 26728\t    name = path.rsplit(\"/\", 1)[-1]\n 26729\t    stem = _testmap_stem(path)\n 26730\t    return (\".spec.\" in name or \".test.\" in name or stem.startswith(\"test_\")\n 26731\t            or stem.lower().endswith((\"_tests\", \"_specs\", \"_test\", \"_spec\")))   # 底線變體同測試地圖(Go 的 foo_test.go)\n 26732\t\n 26733\t\n 26734\tdef _nodehome_code_kind(path):\n 26735\t    \"\"\"回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。\n 26736\t    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。\"\"\"\n 26737\t    base = path.rsplit(\"/\", 1)[-1]\n 26738\t    stripped = base.lstrip(\".\")\n 26739\t    if \".\" in stripped:\n 26740\t        return \"ext\" if (\".\" + stripped.rsplit(\".\", 1)[1]) in _NODEHOME_CODE_EXTS else None\n 26741\t    return \"shebang?\"\n 26742\t\n 26743\t\n 26744\tclass _NodehomeSide:\n 26745\t    \"\"\"一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);\n 26746\t    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);\n 26747\t    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。\n 26748\t    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。\"\"\"\n 26749\t    __slots__ = (\"files\", \"all_paths\", \"notes\", \"where\", \"_reader\", \"shebang\", \"share\", \"changed\")\n 26750\t\n 26751\t\n 26752\tdef _nodehome_git(repo_root, *args):\n 26753\t    \"\"\"跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。\"\"\"\n 26754\t    r = _lens_git(repo_root, *args, binary=True)\n 26755\t    if r is None or r.returncode != 0:\n 26756\t        return None\n 26757\t    return r.stdout\n 26758\t\n 26759\t\n 26760\tdef _nodehome_show(path):\n 26761\t    \"\"\"路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。\"\"\"\n 26762\t    return os.fsencode(path).decode(\"utf-8\", errors=\"replace\") if isinstance(path, str) else str(path)\n 26763\t\n 26764\t\n 26765\tdef _nodehome_split_z(raw):\n 26766\t    return [os.fsdecode(x) for x in raw.split(b\"\\0\") if x]\n 26767\t\n 26768\t\n 26769\tdef _nodehome_list(repo_root, where, oids=None):\n 26770\t    \"\"\"where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。\n 27060\t    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None\n 27061\t    for p in parents:\n 27062\t        rr = _nodehome_git(repo_root, \"diff-tree\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", p, sha)\n 27063\t        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))\n 27064\t    order = sorted(paths)\n 27065\t    specs = []\n 27066\t    for x in order:\n 27067\t        specs.append(f\"{sha}:{x}\")\n 27068\t        specs += [f\"{p}:{x if ren is None else ren.get(x, x)}\" for p, ren in pairs]\n 27069\t    blobs = _nodehome_cat_blobs(repo_root, specs)\n 27070\t    if blobs is None or any(ren is None for _, ren in pairs):\n 27071\t        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)\n 27072\t        return paths, src, gone\n 27073\t    kept = set()\n 27074\t    for n, x in enumerate(order):\n 27075\t        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]\n 27076\t        if _nodehome_merge_wrote_new_lines(merged, olds):\n 27077\t            kept.add(x)\n 27078\t    return kept, {k: v for k, v in src.items() if k in kept}, gone\n 27079\t\n 27080\t\n 27081\tdef _nodehome_cat_sizes(repo_root, specs, timeout=60):\n 27082\t    \"\"\"同 _nodehome_cat_blobs 的批次讀取,只問大小(cat-file --batch-check):回同順序的 int|None(沒有這個物件=None);git 跑不起來回 None。\"\"\"\n 27083\t    import subprocess as _sp\n 27084\t    try:\n 27085\t        chk = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch-check\"],\n 27086\t                      input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n 27087\t                      capture_output=True, timeout=timeout)\n 27088\t    except (OSError, _sp.TimeoutExpired):\n 27089\t        return None\n 27090\t    if chk.returncode != 0:\n 27091\t        return None\n 27092\t    heads = chk.stdout.split(b\"\\n\")\n 27093\t    out = []\n 27094\t    for i in range(len(specs)):\n 27095\t        parts = heads[i].split(b\" \") if i < len(heads) else []\n 27096\t        out.append(int(parts[2]) if len(parts) == 3 and parts[2].isdigit() else None)\n 27097\t    return out\n 27098\t\n 27099\t\n 27100\tdef _nodehome_cat_blobs_capped(repo_root, specs, max_bytes, timeout=60):\n 27101\t    \"\"\"_nodehome_cat_blobs 加大小上限:先用 _nodehome_cat_sizes 問大小,超過 max_bytes 的回 None、不讀進記憶體\n 27102\t    (角色鏡頭代碼審 r1 外家 F6、r2 架構對齊 F1:上限放在批次讀取這一層,不另起查法)。回同順序的 bytes|None;git 跑不起來回 None。\"\"\"\n 27103\t    sizes = _nodehome_cat_sizes(repo_root, specs, timeout)\n 27104\t    if sizes is None:\n 27105\t        return None\n 27106\t    ok = [i for i, n in enumerate(sizes) if n is not None and n <= max_bytes]\n 27107\t    got = _nodehome_cat_blobs(repo_root, [specs[i] for i in ok], timeout=timeout) if ok else []\n 27108\t    if got is None:\n 27109\t        return None\n 27110\t    res = [None] * len(specs)\n 27111\t    for i, v in zip(ok, got):\n 27112\t        res[i] = v\n 27113\t    return res\n 27114\t\n 27115\t\n 27116\tdef _nodehome_cat_blobs(repo_root, specs, timeout=60):\n 27117\t    \"\"\"一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。\n 27118\t\n 27119\t    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,\n 27120\t    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。\n 27121\t    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。\"\"\"\n 27122\t    import subprocess as _sp\n 27123\t    if not specs:\n 27124\t        return []\n 27125\t    if any(\"\\n\" in s_ for s_ in specs):\n 27126\t        return None\n 27127\t    try:\n 27128\t        r = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch\"],\n 27129\t                    input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n 27130\t                    capture_output=True, timeout=timeout)\n 27131\t    except (OSError, _sp.TimeoutExpired):\n 27132\t        return None\n 27133\t    if r.returncode != 0:\n 27134\t        return None\n 27135\t    out, pos, res = r.stdout, 0, []\n 27136\t    for _ in specs:\n 27137\t        nl = out.find(b\"\\n\", pos)\n 27138\t        if nl < 0:\n 27139\t            return None\n 27140\t        head = out[pos:nl].split(b\" \")\n 27141\t        pos = nl + 1\n 27142\t        if len(head) == 3 and head[1] == b\"blob\" and head[2].isdigit():\n 27143\t            size = int(head[2])\n 27144\t            res.append(out[pos:pos + size])\n 27145\t            pos += size + 1\n 31340\t# 推送前掛鉤的上線標記(範圍起點截到這裡);★不含連續字串「note-audit check」★——那是筆記內容審找自己上線點用的\n 31341\t_NOTE_REREAD_GOLIVE_MARK = \"note-audit reread-check\"\n 31342\t_NOTE_REREAD_VERDICT_DIR = \"governance/reread-verdicts\"\n 31343\t# 紀錄檔名:<對照指紋>-<UTC 時間>-<32 位亂數>.json;_write_lf 中斷留下的 .tmp-wlf 殘檔不合、不算已對照\n 31344\t_NOTE_REREAD_VERDICT_NAME_RE = re.compile(r\"^([0-9a-f]{16})-\\d{8}T\\d{6}Z-[0-9a-f]{32}\\.json$\")\n 31345\t_NOTE_REREAD_GATE_VALUES = (\"block\", \"warn\", \"off\")\n 31346\t_NOTE_REREAD_BUDGET_SEC = 30         # reread-check 的軟上限(同舊句檢查 _DRIFT_M1_BUDGET_SEC 的量級,不吃別道檢查的時間)\n 31347\t_NOTE_REREAD_DIFF_CAP = 100000       # 給判定者的 diff 字元上限(照實驗)\n 31348\t_NOTE_REREAD_OTHERS_MAX = 40         # 「另外改到的程式檔」只列前幾支(照實驗)\n 31349\t_NOTE_REREAD_TEXT_MAX = 500          # 報告裡每項的原句與理由各截到幾個字\n 31350\t_NOTE_REREAD_LIST_MAX = 10           # reread-check 最多列幾篇\n 31351\t_NOTE_REREAD_COST_NOTES = 15         # 候選超過這個篇數時 reread-prepare 另印成本估計\n 31352\t_NOTE_REREAD_DIFF_ARGS = (\"--no-ext-diff\", \"--no-textconv\", \"--no-color\", \"--src-prefix=a/\", \"--dst-prefix=b/\")\n 31353\t_NOTE_REREAD_HEAD = (\"編排者\", \"判定者模型\", \"範本版本\", \"材料指紋\", \"對照指紋\", \"筆記路徑\", \"筆記 blob\", \"筆記行數\", \"範圍終點\")\n 31354\t_NOTE_REREAD_TAIL = \"這只是提醒、不擋,忽略照推也可以\"\n 31355\t# ★路徑/名稱裡「要當特殊字元處理」的 Unicode 類別只有這一份★(回頭重讀代碼審 r3 架構對齊席 F1:原本回頭重讀與存量漂移\n 31356\t# 舊句檢查各寫一組,日後補類別要改兩處)。Cc 控制字元、Cf 方向控制與零寬、Zl/Zp 行段分隔(str.splitlines 會在這裡切行)、\n 31357\t# Cs 無損解碼留下的替身字元(不是 UTF-8)。要不要算 Cs 各處自己決定,用 _path_special_chars 的 surrogate 參數表達,不另抄一組。\n 31358\t_PATH_SPECIAL_CATS = frozenset((\"Cc\", \"Cf\", \"Zl\", \"Zp\", \"Cs\"))\n 31359\t\n 31360\t\n 31361\tdef _path_special_chars(s, surrogate=True):\n 31362\t    \"\"\"字串帶 _PATH_SPECIAL_CATS 那幾類的字元 → True;surrogate=False 不算 Cs(非 UTF-8 的路徑照常處理)。\"\"\"\n 31363\t    cats = _PATH_SPECIAL_CATS if surrogate else _PATH_SPECIAL_CATS - {\"Cs\"}\n 31364\t    return any(unicodedata.category(c) in cats for c in str(s))\n 31365\t\n 31366\t\n 31367\t# 路徑裡的控制字元:帶這種字元的筆記不對照(代碼審 r1 資安席 F2——換行能在項目檔頭多造一行「對照指紋: …」蓋掉真的那行、\n 31368\t# 讓沒讀過的篇被算成已對照;跳脫碼會原樣送進終端)。★範圍是 Unicode 類別 Cc、Cf、Zl、Zp★(代碼審 r2 資安席 F1):\n 31369\t# 第一版只認 C0/DEL/C1,漏了 U+2028/U+2029——str.splitlines() 會在那裡切行,原樣路徑寫進治理帳後 lumos gov 每次當掉;\n 31370\t# Cf 含雙向覆寫 U+202E(終端上把檔名顯示成別的樣子)與零寬字元。非 UTF-8 的替身字元是 Cs,不在內(那種照常對照:\n 31371\t# 無損解碼留下的替身字元原樣編回去就是原本的位元組,git 讀得到、也造不出假檔頭)——所以是共用那組減掉 Cs。\n 31372\t_NOTE_REREAD_CTRL_CATS = _PATH_SPECIAL_CATS - {\"Cs\"}\n 31373\t\n 31374\t\n 31375\tdef _note_reread_has_ctrl(s):\n 31376\t    \"\"\"路徑裡有沒有 _NOTE_REREAD_CTRL_CATS 那幾類的字元(共用謂詞、不算替身字元)。\"\"\"\n 31377\t    return _path_special_chars(s, surrogate=False)\n 31378\t\n 31379\t\n 31380\tdef _note_reread_show(path):\n\nhook: PostToolUse\nhook: PostToolUse Completed\nhook: PreToolUse\nhook: PreToolUse Completed\nexec\n/bin/zsh -lc 'wc -l docs/lumos-toolchain-knowledge/Systems/retrieval-ranking.md docs/lumos-toolchain-knowledge/Systems/測試假綠形態.md docs/lumos-toolchain-knowledge/Systems/pitfalls-code-loop.md && nl -ba docs/lumos-toolchain-knowledge/Systems/retrieval-ranking.md && nl -ba docs/lumos-toolchain-knowledge/Systems/測試假綠形態.md && nl -ba docs/lumos-toolchain-knowledge/Systems/pitfalls-code-loop.md' in /private/tmp/lumos-review-artifact-impact-inputs\n succeeded in 0ms:\n      92 docs/lumos-toolchain-knowledge/Systems/retrieval-ranking.md\n     590 docs/lumos-toolchain-knowledge/Systems/測試假綠形態.md\n     166 docs/lumos-toolchain-knowledge/Systems/pitfalls-code-loop.md\n     848 total\n     1\t---\n   