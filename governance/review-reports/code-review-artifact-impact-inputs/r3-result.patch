ag}{_orch_flag}\"\n 13011\t                                 f\" --scope-lines <這輪審了幾行>\")   # cb3 s3-f1:寫側 2026-08-26 起審查席必附報告,模板同步\n 13012\t            # [T5 design-loop重設計] 處置閘模板(選用;record_cmd 原樣保留給 code-loop/舊流程)\n 13013\t            if not light and eff_tier != \"legacy\":\n 13014\t                out[\"disposal_cmd\"] = _disposal_tpl()\n 13015\t                out[\"disposal_gate\"] = f\"lumos loop status {_qid} --disposal --spec <計劃節點.md> --repo <root>\"\n 13016\t            if eff_tier == \"legacy\":\n 13017\t                if _roster_kind(loop_id) == \"code\":\n 13018\t                    # 循序codeloop-tier錨定案:standard 對 code 循序已格式相容,但補標=cap 陷阱——警告式,不邀請\n 13019\t                    out[\"tier_hint\"] = (\n 13020\t                        \"提醒:這個審查編號從沒指定過分級,現在用最寬鬆的舊規則在跑(單人審、最多 6 輪;正式的 standard 只給 3 輪)。\"\n 13021\t                        \"想中途改嚴:補 --tier high 會因格式不合直接被擋;補 --tier standard 格式相容,\"\n 13022\t                        \"但已經跑過的輪數會整批算進 3 輪上限,跑過 3 輪以上的一補標下一步就到頂。\"\n 13023\t                        \"要走嚴格規則,請開新的審查編號,並在第一筆記錄就帶 --tier。\")\n 13024\t                else:\n 13025\t                    out[\"tier_hint\"] = (\n 13026\t                        \"提醒:這個審查編號從沒指定過分級,現在用最寬鬆的舊規則在跑(單人審、最多 6 輪),而且沒辦法事後補分級——\"\n 13027\t                        \"記錄格式已經定型(不帶輪次),補 --tier standard 或 high 會直接被擋;\"\n 13028\t                        \"--tier light 格式相容但只給 2 輪,跑過幾輪的通常一補就到頂。\"\n 13029\t                        \"要走嚴格規則,請開新的審查編號,並在第一筆記錄就帶 --tier。\")\n 13030\t            # ★預防端:警告必須在派工「之前」★——記帳時才喊已經來不及(輪跑完了)。\n 13031\t            # loop next 是每輪第一步,所以量尺放這裡。\n 13032\t            out[\"scope_cap\"] = (\n 13033\t                f\"派工前先量這輪要審的東西有多少行(wc -l <工作副本或 patch>):超過 {_CANARY_SCOPE_SOFT_CAP_LINES} 行\"\n 13034\t                \"就拆開審——切成多輪,或分給多人各審一段。\"\n 13035\t                \"材料太長審查員會看不完、漏東西,這是外部研究的結論;\"\n 13036\t                \"本專案自己跑過三次對照實驗都量不到這個效應,所以別拿自家資料當佐證。\"\n 13037\t                \"超標不擋,但帳上會標成範圍過大、那輪抓到的結果算弱證據。\")\n 13038\t        # ★cluster 帳的選擇只有第一輪能做★(2026-08-02):模式由「第一個有效輪」定錨,之後\n 13039\t        # 要換只能開新 loop id。而 M2 落地至今 316 筆 canary 記錄裡★只有 1 筆帶 clusters★,\n 13040\t        # 且那一筆是開發它的 code-m2cluster 自己——34 個 panel loop 中有 33 個靜默落回\n 13041\t        # 無-cluster 舊帳。根因不是機制不好,是★沒有任何地方在該選的時候提起它★。\n 13042\t        # 只在 N=1 提(那是選擇真正還開著的唯一時刻),避免對已定錨的 loop 噴無效噪音。\n 13043\t        if phase == \"plant-canary\" and not light and eff_tier != \"legacy\" and not seq and n_next == 1:\n 13044\t            out[\"cluster_hint\"] = (\n 13045\t                \"這是第一輪,要不要把發現分組追蹤只有現在能決定(第一個有效輪定下模式,之後要換只能開新編號):\"\n 13046\t                \"如果預期發現會散成性質不同的幾群(例如「規格縮水」和「邊界 bug」),\"\n 13047\t                \"記錄時加 --clusters '群名=resolved|accepted-minor:理由|disputed-major' 逐群追蹤,\"\n 13048\t                \"收斂改看「沒有爭議且嚴重的群」——不然不同性質的問題被壓成一個最高等級,一邊會蓋掉另一邊。\"\n 13049\t                \"單一主題、發現性質相同的用預設(不分組)就好。\")\n 13050\t        # 圖譜入口栓 A(spec v3 EL-1):只在首輪+plant-canary、只掛正常 emit 出口;\n 13051\t        # --spec 有給→計劃檔名優先當查詢源,否則退編號(EL-3);fail-open:例外不得改 rc/既有輸出(EL-5)\n 13052\t        if phase == \"plant-canary\" and n_next == 1:\n 13053\t            try:\n 13054\t                # ★fail-open 鐵則:本 try 內禁止 sys.exit/SystemExit(except Exception 攔不到)★\n 13055\t                _rn0 = _el_related_nodes(env, Path(spec).stem) if spec else None\n 13056\t                if _rn0 is None or not _rn0[\"queried\"]:\n 13057\t                    # r1 合約席 G-1+r2 delta D2-2:code loop 的 --spec 慣用值=凍結 patch(stem 如\n 13058\t                    # r1-snapshot→無訊號);spec 版查無訊號就一律改用編號版——spec 檔名是工具慣例名\n 13059\t                    # 非主題,其殘渣(snapshot)不得流進「要查自己跑」建議行\n 13060\t                    _rn0 = _el_related_nodes(env, loop_id)\n 13061\t                out[\"related_nodes\"] = _rn0\n 13062\t            except Exception:\n 13063\t                pass\n 13064\t        # ★把「這個迴圈在審哪份東西」印出來★(2026-09-07,另一個 session 提的缺口:\n 13065\t        # 一個只拿到編號的新 session,loop next 給的東西已經夠它直接派工——現在狀態、\n 13066\t        # 分級、第幾輪、幾個人、五個席位各自的家族,全都有。★唯一斷掉的一步是「在審什麼」★,\n 13067\t        # 而那個資訊其實就在帳上,只是沒印出來,接手的人得自己去 tail 帳本。)\n 13068\t        #\n 13069\t        # ★取「最後一筆有值的」,不是「最後一筆」★:spec_path 是選配欄位,如果 r1 有記、\n 13070\t        # r2 沒記,取最後一筆會印「沒記」——而接手的人會誤解成「這個迴圈從來沒記過在審什麼」。\n 13071\t        # 兩種語意不能共用同一句話。(實測本庫 209 個迴圈:0 個落在這個差異上,\n 13072\t        # 兩種取法今天結果完全一致——但欄位是選配的,一致是現況不是保證,所以照安全的取。)\n 13073\t        #\n 13074\t        # ★措辭要帶輪次★:這裡說「接下來第 N 輪」,而帳上最後那筆是第 N-1 輪的材料。\n 13075\t        # 講成「這個迴圈在審 X」會讓人以為那就是下一輪要審的東西,而下一輪要自己凍一份新的。\n 13076\t        _sp_degraded = None\n 13077\t        try:\n 13078\t            _sp_rec = next((r for r in reversed(rounds)\n 13079\t                            if isinstance(r.get(\"spec_path\"), str) and r[\"spec_path\"].strip()), None)\n 13080\t            if _sp_rec:\n 13081\t                _sp = _sp_rec[\"spec_path\"]\n 13082\t                # ★路徑要以「vault 所屬的 repo 根」為錨,不是 cwd★\n 13083\t                # (2026-09-07 代碼審 r1 外家否決席判 major,實測屬實:從 governance/ 底下\n 13084\t                #  不帶 --repo 呼叫,會對一個★確實存在★的檔案印「這個檔案現在不在了」\n 13085\t                #  ——正好是我想避免的「遞一條死路給人」的反面)。\n 13086\t                # _vault_repo_root 是這個 repo 既有的那支(從 vault 往上找 .git),\n 13087\t                # 判定閘的卷證解析用的也是它,不另寫一份。\n 13088\t                # ★連 .resolve() 都要跟既有那支一致★(代碼審 r1 架構對齊席:\n 13089\t                # 判定閘的解析根寫的是 `Path(repo).resolve() if repo else _vault_repo_root(env)`,\n 13090\t                # 而 _vault_repo_root 自己也是回 resolve 過的。少一個 resolve 就是第二套規則。)\n 13091\t                _root = Path(repo).resolve() if repo else _vault_repo_root(env)\n 13092\t                _sp_abs = Path(_sp) if Path(_sp).is_absolute() else (_root / _sp)\n 13093\t                out[\"reviewed_spec\"] = {\"path\": _sp, \"round\": _sp_rec.get(\"round\"),\n 13094\t                                        \"exists\": _sp_abs.exists(),\n 13095\t                                        \"is_latest_round\": _sp_rec is rounds[-1]}\n 13096\t        except Exception as _e:\n 13097\t            # ★不要謊稱「沒記」★(代碼審 r1 外家否決席 minor):壞掉的帳(spec_path 是 list/dict)\n 13098\t            # 會走到這裡,而文字模式接著會印「帳上沒記這個迴圈在審什麼」——那是假話,\n 13099\t            # 使用者分不出「真的沒記」和「記了但工具讀不動」。rc 不變,但要出聲。\n 13100\t            _sp_degraded = str(_e)\n 13101\t        if extra:\n 13102\t            out.update(extra)\n 13103\t        # 跑滿上限提示(審查跑滿上限提示_計劃 S1/S10):只附加,不改 phase 與退出碼\n 13104\t        try:\n 13105\t            _ch = _cap_hint(rounds)\n 13106\t        except Exception:\n 13107\t            _ch = None\n 13108\t        if _ch:\n 13109\t            out[\"cap_hint\"] = {\"rounds\": _ch[\"rounds\"], \"hint\": _ch[\"hint\"], \"breaker\": _ch[\"breaker\"]}\n 13110\t        # 修正關卡提醒(Projects/代碼審修正關卡第0步_計劃 S8):只附加,不改 phase 與退出碼;設計審迴圈不看\n 13111\t        _fc = None\n 13112\t        if str(loop_id).startswith(\"code-\"):\n 13113\t            try:\n 13114\t                _fc = _fix_check_status(env, repo, loop_id, rounds)\n 13115\t            except Exception:\n 13116\t                _fc = None\n 13117\t        if _fc:\n 13118\t            out[\"fix_check\"] = _fc\n 13119\t        if as_json:\n 13120\t            print(_json.dumps(out, ensure_ascii=False))\n 14020\t    claim = m.group(1).strip() if m else \"\"\n 14021\t    home = _guard_home_of_fields(gfields)\n 14022\t    home_rel = env.find(home) if home else None\n 14023\t    htext = env_text(env, home_rel) if home_rel else None\n 14024\t    if claim and htext is not None:\n 14025\t        hfm, _hb = split_frontmatter(htext)\n 14026\t        if hfm is not None and _guard_formal_line(htext.split(\"\\n\"), len(hfm) + 1, claim, None) is not None:\n 14027\t            return home_rel, None\n 14028\t    what = (\"讀不出預告的合約\" if not claim else f\"找不到家節點 {home or '(沒寫)'}\" if htext is None\n 14029\t            else f\"家節點 {home_rel[:-3]} 的摘要裡沒有這條合約綁了測試的正式行\")\n 14030\t    return None, (f\"{what}。兩條出路:這條合約其實還沒轉正——把 status 改回 pending 後走 lumos guard settle;\"\n 14031\t                  \"或正式行寫在別處——手動改句後,對剩下的 c1 用 lumos drift ack\")\n 14032\t\n 14033\t\n 14034\tdef _guard_pass_rewrite(env, root, repo_rel, glines, date_arg):\n 14035\t    \"\"\"已 pass 但還留著預告句的守衛紀錄 → (改寫後的行, 找不到的句型, 用的日期, 錯誤)。前提、日期、不疊都在這裡;\n 14036\t    guard settle 與 drift fix --kind c1 共用(drift 往下呼叫 guard,guard 不呼叫 drift)。\"\"\"\n 14037\t    home_rel, err = _guard_pass_home(env, glines)\n 14038\t    if err:\n 14039\t        return None, None, None, err\n 14040\t    ops = _guard_prose_ops(glines)\n 14041\t    day = None\n 14042\t    if _guard_prose_needs_date(ops):\n 14043\t        day, err = _guard_settled_date(root, repo_rel, glines, date_arg)\n 14044\t        if err:\n 14045\t            return None, None, None, err\n 14046\t    elif date_arg is not None:\n 14047\t        day, err = _guard_date_arg(date_arg)\n 14048\t        if err:\n 14049\t            return None, None, None, err\n 14050\t    new, missing = _guard_settle_rewrite(glines, day, home_rel[:-3])\n 14051\t    return new, missing, day, None\n 14052\t\n 14053\t\n 14054\tdef _guard_touched_hits(files, touched):\n 14055\t    \"\"\"家節點管的那些檔,跟這次改到的檔對得上哪幾個。回 (對上的清單, 是不是只在忽略大小寫時才對上)。\n 14056\t\n 14057\t    ★比對鍵走既有那支★(代碼審 r2 架構席 blocker):about_code 的比對鍵全 repo 只有一個算法\n 14058\t    `_nodehome_key`(路徑正規化 + NFC),2026-09-10 那輪代碼審就是為了收斂「三處各寫一份、\n 14059\t    各版解得不一樣」才立的。第一版自己刻了一份,解不了 `a/../b`——而那正是這個 repo\n 14060\t    自己認證過、也修過一次的人手寫法,漏掉的話該擋的推送會安靜放行。\n 14061\t\n 14062\t    在那之上多兩條**只會多擋、不會少擋**的保險:家節點寫的是資料夾(看底下的檔)、只有忽略大小寫\n 14063\t    才對得上。寫入端(`_about_code_path`)確實已經擋掉這兩種寫法(要求是檔案、大小寫要跟磁碟一致),\n 14064\t    所以走指令寫進去的不會踩到;留著是因為★寫入端的保證不等於讀取端的保證★——開頭欄位可以被手改,\n 14065\t    而這一層漏掉是沒人會發現的(多擋一次訊息會講清楚為什麼)。\n 14066\t    \"\"\"\n 14067\t    tset = {_nodehome_key(x) for x in touched}\n 14068\t    tset.discard(\"\")\n 14069\t    hits, only_case = [], []\n 14070\t    for raw in files:\n 14071\t        f = _nodehome_key(raw)\n 14072\t        if not f:\n 14073\t            continue\n 14074\t        if f in tset:\n 14075\t            hits.append(raw)\n 14076\t            continue\n 14077\t        under = sorted(x for x in tset if x.startswith(f + \"/\"))\n 14078\t        if under:\n 14079\t            hits.append(f\"{raw}(底下的 {under[0]})\")\n 14080\t            continue\n 14081\t        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上\n 14082\t        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。\n 14083\t        same = sorted(x for x in tset if x.lower() == f.lower())\n 14084\t        if same:\n 14085\t            hits.append(f\"{raw}(大小寫不同:{same[0]})\")\n 14086\t            only_case.append(raw)\n 14087\t    return hits, only_case\n 14088\t\n 14089\t\n 14090\tdef _guard_touches(gn, env, touched):\n 14091\t    \"\"\"這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。\n 14092\t\n 14093\t    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):\n 14094\t    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。\n 14095\t    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:\n 14096\t    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。\n 14097\t    \"\"\"\n 14098\t    if touched is None:\n 14099\t        return True, \"\"            # 沒給清單=CI 那一層,照舊全擋\n 14100\t    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點\n 14101\t    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。\n 14102\t    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]\n 14103\t    if not homes:\n 14104\t        return False, \";這篇沒寫它守的是哪篇功能節點,算不出有沒有碰到\"\n 14105\t    files, found, missing, nocode = [], [], [], []\n 14106\t    for home in homes:\n 14107\t        hrel = env.find(home)\n 14108\t        hn = env.notes.get(hrel) if hrel else None\n 14109\t        if hn is None:\n 14110\t            missing.append(home)\n 14111\t            continue\n 14112\t        found.append(hrel)\n 14113\t        got = [str(x).strip() for x in as_list(hn.fields.get(\"about_code\")) if str(x).strip()]\n 14114\t        if got:\n 14115\t            files += got\n 14116\t        else:\n 14117\t            nocode.append(hrel)\n 14118\t    # ★連結斷掉的那幾篇,不管這次擋不擋都要講★(代碼審 r2 通才席):\n 14119\t    # 半條算得出來、半條算不出來時,算不出來的那半原本會無聲消失,那條合約就一直帶著沒人發現的壞連結。\n 14120\t    broken = f\"(另外 {'、'.join(missing)} 這幾篇找不到,連結可能斷了)\" if missing else \"\