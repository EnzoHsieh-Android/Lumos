)\n 38728\t\n 38729\t\n 38730\tdef t_review_role_config_bom_and_deep_json_at_base():\n 38731\t    \"\"\"[代碼審 r2 正確性 F1/F3] 起點版本的設定檔帶 BOM 照常用;超深巢狀當成讀不懂、有警告、不丟例外。\"\"\"\n 38732\t    m = _load_lumos_inproc()\n 38733\t    d, g, w, c = _role_git_repo()\n 38734\t    (d / \".lumos\").mkdir()\n 38735\t    (d / \".lumos\" / \"config.json\").write_text('﻿{\"review_roles\": [{\"path\": \"api/*\", \"role\": \"frontend\"}]}', encoding=\"utf-8\")\n 38736\t    base = c(\"base\"); w(\"api/a.py\", \"x = 1\\n\"); head = c(\"head\")\n 38737\t    res = m._review_roles(d, base, head)\n 38738\t    check(\"BOM 設定照常生效、沒有警告\", res[\"warnings\"] == [] and res[\"roles\"].get(\"api/a.py\") == \"frontend\", str(res))\n 38739\t    (d / \".lumos\" / \"config.json\").write_text(\"[\" * 200000, encoding=\"utf-8\"); base2 = c(\"deep\"); w(\"api/b.py\", \"y = 1\\n\"); head2 = c(\"head2\")\n 38740\t    try:\n 38741\t        res2 = m._review_roles(d, base2, head2)\n 38742\t        ok = len(res2[\"warnings\"]) == 1 and res2[\"roles\"].get(\"api/b.py\") == \"backend\"\n 38743\t    except RecursionError:\n 38744\t        res2, ok = \"RecursionError\", False\n 38745\t    check(\"超深巢狀設定 → 讀不懂警告、宣告不用、不丟例外\", ok, str(res2)[:300])\n 38746\t\n 38747\t\n 38748\tdef t_node_flavor_unreadable_nearest_package_json_is_none():\n 38749\t    \"\"\"[代碼審 r2 正確性 F2] 最近那份 package.json 讀不了(UTF-16、權限)時判不出,不往上找父層改判。\"\"\"\n 38750\t    m = _load_lumos_inproc()\n 38751\t    d = Path(tempfile.mkdtemp(prefix=\"gctl-pkj16-\"))\n 38752\t    (d / \"package.json\").write_text('{\"dependencies\": {\"express\": \"4\"}}', encoding=\"utf-8\")\n 38753\t    (d / \"pkg\").mkdir(); (d / \"pkg\" / \"package.json\").write_bytes('{\"dependencies\": {\"vue\": \"3\"}}'.encode(\"utf-16\"))\n 38754\t    m._NODE_FLAVOR_CACHE.clear()\n 38755\t    check(\"工作樹:最近那份是 UTF-16 → 判不出(不是往上判成 node)\", m._node_flavor(\"pkg/a.ts\", str(d)) is None, str(m._node_flavor(\"pkg/a.ts\", str(d))))\n 38756\t\n 38757\t\n 38758\tdef t_cat_blobs_max_bytes_skips_big_objects():\n 38759\t    \"\"\"[代碼審 r2 架構對齊 F1] 大小上限放在既有的批次讀取那一層:超過上限的物件回 None,不讀進記憶體。\"\"\"\n 38760\t    m = _load_lumos_inproc()\n 59090\t\n 59091\t    def slow_reader(r, where):\n 59092\t        inner = real(r, where)\n 59093\t\n 59094\t        def rd(p):\n 59095\t            if \"/Systems/\" in p:\n 59096\t                reads.append(p)\n 59097\t                _t.sleep(0.2)\n 59098\t            return inner(p)\n 59099\t        return rd\n 59100\t    saved = {k: g[k] for k in (\"_nodehome_reader\", \"_NOTE_REREAD_BUDGET_SEC\")}\n 59101\t    so = io.StringIO()\n 59102\t    try:\n 59103\t        g.update({\"_nodehome_reader\": slow_reader, \"_NOTE_REREAD_BUDGET_SEC\": 0.5})\n 59104\t        t0 = _t.monotonic()\n 59105\t        with contextlib.redirect_stdout(so), contextlib.redirect_stderr(io.StringIO()):\n 59106\t            rc = m.cmd_note_audit_reread_check(repo=str(root), diff_range=f\"{base}..{tip}\")\n 59107\t        spent = _t.monotonic() - t0\n 59108\t    finally:\n 59109\t        g.update(saved)\n 59110\t    check(\"③每篇讀 0.2 秒、上限 0.5 秒:印逾時、回 0,讀到上限就停(沒把 18 篇讀完)\",\n 59111\t          rc == 0 and \"逾時\" in so.getvalue() and len(reads) < 10 and spent < 3.0,\n 59112\t          f\"rc={rc} 讀了 {len(reads)} 篇、花 {spent:.1f} 秒\\n{so.getvalue()}\")\n 59113\t\n 59114\t\n 59115\tdef t_note_audit_reread_non_utf8_path_logs():\n 59116\t    \"\"\"代碼審 r1 邊界席 F1:筆記檔名含非 UTF-8 位元組時,reread-check 照常提醒並寫一筆 reminded 進治理帳\n 59117\t    (原本寫帳時編碼失敗,外層改印「這次沒提醒」、提醒沒進帳、同一次輸出自相矛盾)。\"\"\"\n 59118\t    print(\"t_note_audit_reread_non_utf8_path_logs\")\n 59119\t    import os as _os\n 59120\t    root, base = _rr_repo()\n 59121\t    _rr_touch(root, \"src/c.py\")\n 59122\t    bad = _os.fsdecode(f\"{_NA_VAULT}/Systems/ba\".encode() + b\"\\xff\" + b\"d.md\")\n 59123\t    _rr_index_add(root, bad, (root / _rr_note(\"C\")).read_bytes())\n 59124\t    _rr_commit_index(root, \"non-utf8 name\", \"src/c.py\")\n 59125\t    n0 = _ns_gov(root)\n 59126\t    rc, o, e = _rr(root, \"reread-check\", \"--diff\", f\"{base}..HEAD\")\n 59127\t    new = [x for x in _gov_since(_ns_gov(root), n0) if x.get(\"gate\") == \"note-reread\"]\n 59128\t    check(\"非 UTF-8 檔名:照常列出、沒有「這次沒提醒」、治理帳恰好一筆 reminded、最後一行是不擋那句\",\n 59129\t          rc == 0 and \"還沒對照\" in o and \"這次沒提醒\" not in o and [x.get(\"kind\") for x in new] == [\"reminded\"]\n 59130\t          and o.strip().splitlines()[-1] == \"這只是提醒、不擋,忽略照推也可以\", f\"rc={rc}\\n{o}\\n{e}\\n{new}\")\n 59131\t\n 59132\t\n 59133\tdef t_code_loop_bookkeeping_shebang_script_not_exempt():\n 59134\t    \"\"\"代碼審 r2 架構對齊席 F1(major):留痕有效性判「簿記資料夾底下的程式檔不算簿記」,跟每支檔有家同一套判法\n 59135\t    (副檔名在清單裡,或沒副檔名、首行是 #!);首行讀目標提交裡那一版(刪掉的讀記錄那一版),不讀磁碟。\n 59136\t    沒副檔名、首行不是 #! 的(.weekly-stamp、.rotation-cursor 這類)照舊算簿記。\n 59137\t\n 59138\t    翻紅釘:只看副檔名(沒副檔名一律算簿記)→ ①③⑤紅;首行改讀磁碟 → ③④紅。\"\"\"\n 59139\t    print(\"t_code_loop_bookkeeping_shebang_script_not_exempt\")\n 59140\t    import os as _os\n 59141\t    m = _load_lumos_inproc()\n 59142\t\n 59143\t    def fresh():\n 59144\t        r = _nh_repo()\n 59145\t        _nh_file(r, \"src/auth.py\", \"def allowed(u):\\n    return u.is_admin\\n\")\n 59146\t        _nh_file(r, \"governance/replay/old.md\", \"舊紀錄\\n\")\n 59147\t        _nh_commit(r, \"init\")\n 59148\t        return r, _na_head(r)\n 59149\t    r, p = fresh()\n 59150\t    _os.chmod(_nh_file(r, \"governance/replay/run\", \"#!/bin/sh\\nrm -rf /\\n\"), 0o755)\n 59151\t    _nh_commit(r, \"script in bookkeeping dir\")\n 59152\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59153\t    check(\"①簿記資料夾裡新增沒副檔名、首行 #! 的腳本 → 不算簿記、留痕失效(席位重現)\", not ok, why)\n 59154\t    r, p = fresh()\n 59155\t    _nh_file(r, \"governance/replay/.weekly-stamp\", \"2026-10-01\\n\")\n 59156\t    _nh_file(r, \"governance/replay/x/.rotation-cursor\", \"3\\n\")\n 59157\t    _nh_file(r, \"governance/replay/x/.gitkeep\", \"\")\n 59158\t    _nh_commit(r, \"stamps\")\n 59159\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59160\t    check(\"②對照組:沒副檔名、首行不是 #!(戳記、游標、空的 .gitkeep)→ 照舊算簿記\", ok, why)\n 59161\t    r, p = fresh()\n 59162\t    _nh_file(r, \"governance/replay/run\", \"#!/bin/sh\\necho hi\\n\")\n 59163\t    _nh_commit(r, \"script\")\n 59164\t    (r / \"governance\" / \"replay\" / \"run\").write_text(\"只是紀錄\\n\", encoding=\"utf-8\")\n 59165\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59166\t    check(\"③首行讀目標提交那一版:提交的是 #! 腳本、磁碟上改成不是 → 照樣失效\", not ok, why)\n 59167\t    r, p = fresh()\n 59168\t    _nh_file(r, \"governance/replay/stamp\", \"2026-10-01\\n\")\n 59169\t    _nh_commit(r, \"stamp\")\n 59170\t    (r / \"governance\" / \"replay\" / \"stamp\").write_text(\"#!/bin/sh\\necho hi\\n\", encoding=\"utf-8\")\n 59171\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59172\t    check(\"④反過來:提交的是一般紀錄、磁碟上改成 #! → 照樣算簿記\", ok, why)\n 59173\t    r = _nh_repo()\n 59174\t    _nh_file(r, \"src/auth.py\", \"x = 1\\n\")\n 59175\t    _nh_file(r, \"governance/replay/run\", \"#!/bin/sh\\necho hi\\n\")\n 59176\t    _nh_commit(r, \"init\")\n 59177\t    p = _na_head(r)\n 59178\t    _nh_git(r, \"rm\", \"-q\", \"governance/replay/run\")\n 59179\t    _nh_commit(r, \"drop script\")\n 59180\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59181\t    check(\"⑤目標那一版刪掉了:讀記錄那一版的首行,是 #! 腳本 → 不算簿記、留痕失效\", not ok, why)\n 59182\t\n 59183\t\n 59184\tdef t_note_audit_drift_share_repo_path_guard():\n 59185\t    \"\"\"代碼審 r2 架構對齊席 F2:「從 repo 根往下逐層不准是符號連結、解析後要在 repo 根底下」只有一份\n 59186\t    (_repo_path_unsafe),筆記內容審的資料夾守衛與存量漂移的帳檔路徑檢查都呼叫它;兩邊的錯誤訊息照舊。\n 59187\t\n 59188\t    翻紅釘:任一邊改回自己逐層查 → ①紅。\"\"\"\n 59189\t    print(\"t_note_audit_drift_share_repo_path_guard\")\n 59190\t    import inspect as _insp, os as _os\n 59191\t    m = _load_lumos_inproc()\n 59192\t    s1 = _insp.getsource(m._note_audit_safe_dir)\n 59193\t    s2 = _insp.getsource(m._drift_ledger_path_err)\n 59194\t    check(\"①兩支都呼叫共用守衛、自己不再逐層查符號連結\",\n 59195\t          hasattr(m, \"_repo_path_unsafe\") and \"_repo_path_unsafe(\" in s1 and \"_repo_path_unsafe(\" in s2\n 59196\t          and \".is_symlink()\" not in s1 and \".is_symlink()\" not in s2, \"\")\n 59197\t    root = _nh_repo()\n 59198\t    out = Path(tempfile.mkdtemp(prefix=\"gctl-guard-outside-\"))\n 59199\t    _os.symlink(out, root / \"lnk\")\n 59200\t    (root / \"plain\").write_text(\"x\\n\", encoding=\"utf-8\")\n 59201\t    if not hasattr(m, \"_repo_path_unsafe\"):\n 59202\t        return\n 59203\t    check(\"②共用守衛:上層是連結 → symlink、指出那一層\", m._repo_path_unsafe(root, \"lnk/a/b\") == (\"symlink\", root / \"lnk\"), \"\")\n 59204\t    check(\"②共用守衛:要資料夾的那層是檔 → notdir\", m._repo_path_unsafe(root, \"plain/a\", dirs=True) == (\"notdir\", root / \"plain\"), \"\")\n 59205\t    check(\"②共用守衛:一般路徑 → None\", m._repo_path_unsafe(root, \"governance/x/y.jsonl\") is None, \"\")\n 59206\t    d, why = m._note_audit_safe_dir(root, \"lnk/note-audit\")\n 59207\t    check(\"③筆記內容審訊息照舊\", d is None and why == \"lnk 是符號連結(可能指到 repo 外),不寫也不清——刪掉那個連結再跑\", str(why))\n 59208\t    d, why = m._note_audit_safe_dir(root, \"plain/x\")\n 59209\t    check(\"③筆記內容審:不是資料夾訊息照舊\", d is None and why == \"plain 不是資料夾,沒法用\", str(why))\n 59210\t    err = m._drift_ledger_path_err(root, \"lnk/a.jsonl\")\n 59211\t    check(\"③存量漂移訊息照舊\",\n 59212\t          err == f\"{root / 'lnk'} 是符號連結——帳檔與它在 repo 裡的上層目錄都要是一般的檔案與目錄,不往裡寫\", str(err))\n 59213\t    check(\"④兩邊的對照組:一般路徑放行\", m._drift_ledger_path_err(root, \"governance/a.jsonl\") is None\n 59214\t          and m._note_audit_safe_dir(root, \"governance/ok\")[1] is None, \"\")\n 59215\t\n 59216\t\n 59217\tdef t_note_audit_reread_unicode_separator_paths():\n 59218\t    \"\"\"代碼審 r2 資安席 F1:筆記路徑帶 U+2028/U+2029(splitlines 會在這裡切行)或雙向覆寫 U+202E 等 Unicode 類別\n 59219\t    Cc、Cf、Zl、Zp 的字元時,跟控制字元一樣跳過、印出前清掉;治理帳每一段 splitlines 都還是完整的物件(lumos gov 不會當)。\n 59220\t    reread-record 寫帳的路徑也過同一道(項目檔頭的筆記路徑可以手改)。\n 59221\t\n 59222\t    翻紅釘:過濾改回只認 C0/DEL/C1 → ①②③紅。\"\"\"\n 59223\t    print(\"t_note_audit_reread_unicode_separator_paths\")\n 59224\t    import json as _j\n 59225\t\n 59226\t    def gov_ok(root):\n 59227\t        p = root / \"docs\" / \".governance-log.jsonl\"\n 59228\t        if not p.is_file():\n 59229\t            return True\n 59230\t        for frag in p.read_text(encoding=\"utf-8\").splitlines():\n 59231\t            if frag.strip():\n 59232\t                try:\n 59233\t                    if not isinstance(_j.loads(frag), dict):\n 59234\t                        return False\n 59235\t                except ValueError:\n 59236\t                    return False\n 59237\t        return True\n 59238\t    root, base = _rr_repo()\n 59239\t    _rr_touch(root, \"src/c.py\")\n 59240\t    for name in (\"X [1] \", \"P [2]\", \"Y‮gpj\"):\n 59241\t        _rr_index_add(root, f\"{_NA_VAULT}/Systems/{name}.md\", (root / _rr_note(\"C\")).read_bytes())\n 59242\t    _rr_commit_index(root, \"separator names\", \"src/c.py\")\n 59243\t    rc, out, files = _rr_prepare(root, f\"{base}..HEAD\")\n 59244\t    check(\"①prepare:三篇都跳過、講控制字元、輸出沒有 U+2028/U+2029/U+202E、不產檔\",\n 59245\t          rc == 0 and \"控制字元\" in out and not any(c in out for c in \"  ‮\") and not files, repr(out[-500:]))\n 59246\t    rc, o, e = _rr(root, \"reread-check\", \"--diff\", f\"{base}..HEAD\")\n 59247\t    check(\"②check:一樣跳過、輸出乾淨、治理帳每一段 splitlines 都是物件\",\n 59248\t          rc == 0 and \"控制字元\" in o and not any(c in o + e for c in \"  ‮\") and gov_ok(root), repr(o[-500:]))\n 59249\t    r2, b2 = _rr_repo()\n 59250\t    _rr_touch(r2, \"src/a.py\")\n 59251\t    _rr_touch(r2, _rr_note(\"A\"), \"A 追加\")\n 59252\t    _nh_commit(r2, \"a\")\n 59253\t    rc, out, files = _rr_prepare(r2, f\"{b2}..HEAD\")\n 59254\t    if not files:\n 59255\t        check(\"③前置:產得出項目檔\", False, out[-400:])\n 59256\t        return\n 59257\t    item = files[0]\n 59258\t    txt = item.read_text(encoding=\"utf-8\")\n 59259\t    item.write_text(txt.replace(f\"筆記路徑: {_rr_note('A')}\", f\"筆記路徑: {_NA_VAULT}/Systems/A [1] .md\", 1),\n 59260\t                    encoding=\"utf-8\")\n 59261\t    tmp = Path(tempfile.mkdtemp(prefix=\"gctl-rr-rep-\"))\n 59262\t    rc, o, e = _rr(r2, \"reread-record\", \"--prepared\", str(item), \"--report\", str(_rr_report(tmp / \"r.md\", item, [])))\n 59263\t    check(\"③reread-record:手改過的項目檔頭帶 U+2028 → 寫帳前清掉,治理帳每一段 splitlines 都是物件\",\n 59264\t          rc == 0 and gov_ok(r2) and \" \" not in o, repr(o[-400:] + e[-400:]))\n 59265\t\n 59266\t\n 59267\tdef t_gov_skips_non_object_lines():\n 59268\t    \"\"\"代碼審 r2 資安席 F1 ②:lumos gov 讀帳時,合法 JSON 但不是物件的行(U+2028 切出來的 [1]、[]、null、42)跳過,\n 59269\t    不丟 AttributeError(比照 LOOP_CLOSE 讀帳那處 2026-09-07 的寫法);其他正常事件照列。\n 59270\t\n 59271\t    翻紅釘:拿掉 isinstance(d, dict) → ①②紅。\"\"\"\n 59272\t    print(\"t_gov_skips_non_object_lines\")\n 59273\t    import shutil, datetime as _dt\n 59274\t    d1 = (_dt.date.today() - _dt.timedelta(days=3)).isoformat()\n 59275\t    gov = [\n 59276\t        f'{{\"ts\":\"{d1}T09:00:00\",\"commit\":\"aaa\",\"gate\":\"check-r\",\"kind\":\"blocked\",\"hard\":true,\"nodes\":[\"OrderSvc\"]}}\\n',\n 59277\t        f'{{\"ts\":\"{d1}T10:00:00\",\"commit\":\"bbb\",\"gate\":\"note-reread\",\"kind\":\"reminded\",\"nodes\":[\"docs/kg/Systems/X [1] .md\"],\"note\":\"x\"}}\\n',\n 59278\t        \"[]\\n\", \"null\\n\", \"42\\n\",\n 59279\t    ]\n 59280\t    root, vault = _stats_fixture(\"gctl-gov-nonobj-\", gov)\n 59281\t    try:\n 59282\t        r = run(vault, \"gov\")\n 59283\t        check(\"①gov 不當、正常事件照列\", r.returncode == 0 and \"check-r\" in r.stdout and \"Traceback\" not in r.stderr,\n 59284\t              (r.stdout + r.stderr)[-600:])\n 59285\t        r = run(vault, \"gov\", \"--since\", \"9999\", \"--stats\")\n 59286\t        check(\"②gov --stats 也不當\", r.returncode == 0 and \"Traceback\" not in r.stderr, (r.stdout + r.stderr)[-600:])\n 59287\t    finally:\n 59288\t        shutil.rmtree(root, ignore_errors=True)\n 59289\t\n 59290\t\n 59291\tdef _clbk_fresh():\n 59292\t    \"\"\"留痕有效性簿記判法的測試專案:一支程式檔+一篇簿記紀錄,提交後回 (repo, 記錄點 sha)。\"\"\"\n 59293\t    r = _nh_repo()\n 59294\t    _nh_file(r, \"src/auth.py\", \"def allowed(u):\\n    return u.is_admin\\n\")\n 59295\t    _nh_file(r, \"governance/replay/old.md\", \"舊紀錄\\n\")\n 59296\t    _nh_commit(r, \"init\")\n 59297\t    return r, _na_head(r)\n 59298\t\n 59299\t\n 59300\tdef t_code_loop_bookkeeping_ctrl_char_path_not_exempt():\n 59301\t    \"\"\"回頭重讀代碼審 r3 資安席 F1(major):git 的批次讀取會把每行結尾的 \\\\r 吃掉,查「run\\\\r」拿回的是同目錄\n 59302\t    另一支「run」的內容。攻擊者放一支檔名結尾帶 \\\\r 的 #! 腳本、再放一支同名不帶 \\\\r 的戳記當誘餌,\n 59303\t    首行就讀成誘餌的、整批算簿記、留痕照樣有效。修法:沒副檔名、要讀首行的路徑帶控制字元(Unicode 類別 Cc、Cf、\n 59304\t    Zl、Zp)一律當判不了 → 保守算程式檔。\n 59305\t\n 59306\t    翻紅釘:拿掉控制字元那道 → ①③紅。\"\"\"\n 59307\t    print(\"t_code_loop_bookkeeping_ctrl_char_path_not_exempt\")\n 59308\t    import os as _os\n 59309\t    m = _load_lumos_inproc()\n 59310\t    r, p = _clbk_fresh()\n 59311\t    _nh_file(r, \"governance/replay/run\", \"2026-10-01\\n\")\n 59312\t    _os.chmod(_nh_file(r, \"governance/replay/run\\r\", \"#!/bin/sh\\necho pwn\\n\"), 0o644)\n 59313\t    _nh_commit(r, \"decoy + CR script\")\n 59314\t    import subprocess as _sp\n 59315\t    ls = _sp.run([\"git\", \"-C\", str(r), \"ls-files\", \"-z\", \"governance/replay\"], capture_output=True).stdout.split(b\"\\0\")\n 59316\t    check(\"前置:run 與 run\\\\r 兩支都進了版控\", b\"governance/replay/run\" in ls and b\"governance/replay/run\\r\" in ls, repr(ls))\n 59317\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59318\t    check(\"①檔名結尾 \\\\r 的 #! 腳本+同名誘餌戳記 → 不算簿記、留痕失效(席位重現)\", not ok, why)\n 59319\t    r, p = _clbk_fresh()\n 59320\t    _nh_file(r, \"governance/replay/run\", \"2026-10-01\\n\")\n 59321\t    _nh_commit(r, \"decoy only\")\n 59322\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59323\t    check(\"②對照組:只有誘餌那支一般戳記 → 照舊算簿記\", ok, why)\n 59324\t    r, p = _clbk_fresh()\n 59325\t    _nh_file(r, \"governance/replay/stamp\\t\", \"2026-10-01\\n\")\n 59326\t    _nh_commit(r, \"tab name\")\n 59327\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59328\t    check(\"③其他控制字元(\\\\t)的沒副檔名檔,內容就算不是 #! 也當判不了 → 保守算程式、留痕失效\", not ok, why)\n 59329\t\n 59330\t\n 59331\tdef t_code_loop_bookkeeping_exec_mode_and_bom():\n 59332\t    \"\"\"回頭重讀代碼審 r3 資安席 F2:簿記資料夾底下「看起來不像 #!」但一樣跑得起來的檔:git 記的模式是可執行(100755)\n 59333\t    的一律算程式檔(沒寫 #!、甚至有副檔名也算);首行判 #! 前先去掉 UTF-8 BOM 與行首空白。\n 59334\t    #! 在第二行照舊不算(跟每支檔有家同口徑,理由見 Systems/pitfalls-code-loop)。\n 59335\t\n 59336\t    翻紅釘:拿掉模式那道 → ③④⑥紅;首行不去 BOM/空白 → ①②紅。\"\"\"\n 59337\t    print(\"t_code_loop_bookkeeping_exec_mode_and_bom\")\n 59338\t    import os as _os\n 59339\t    m = _load_lumos_inproc()\n 59340\t\n 59341\t    def one(rel, data, mode=0o644):\n 59342\t        r, p = _clbk_fresh()\n 59343\t        f = r / rel\n 59344\t        f.parent.mkdir(parents=True, exist_ok=True)\n 59345\t        f.write_bytes(data)\n 59346\t        _os.chmod(f, mode)\n 59347\t        _nh_commit(r, \"add \" + rel)\n 59348\t        got = _nh_git(r, \"ls-files\", \"-s\", rel).stdout[:6]\n 59349\t        want = \"100755\" if mode & 0o100 else \"100644\"\n 59350\t        return (got == want,) + m._codeloop_record_valid(r, p, _na_head(r))\n 59351\t    for label, rel, data, mode in (\n 59352\t            (\"①BOM 開頭的 #!\", \"governance/replay/bom\", b\"\\xef\\xbb\\xbf#!/bin/sh\\necho pwn\\n\", 0o644),\n 59353\t            (\"②行首空白的 #!\", \"governance/replay/sp\", b\"  #!/bin/sh\\necho pwn\\n\", 0o644),\n 59354\t            (\"②行首 tab 的 #!\", \"governance/replay/tb\", b\"\\t#!/bin/sh\\necho pwn\\n\", 0o644),\n 59355\t            (\"③可執行、沒寫 #!\", \"governance/replay/nx\", b\"echo pwn-noshebang\\n\", 0o755),\n 59356\t            (\"④可執行、副檔名是 .md\", \"governance/review-reports/x/run.md\", b\"echo pwn\\n\", 0o755)):\n 59357\t        mode_ok, ok, why = one(rel, data, mode)\n 59358\t        check(f\"{label} → 不算簿記、留痕失效\", mode_ok and not ok, f\"mode_ok={mode_ok} {why}\")\n 59359\t    for label, rel, data in (\n 59360\t            (\"⑤#! 在第二行(一般模式)→ 照舊算簿記(跟每支檔有家同口徑)\", \"governance/replay/l2\", b\"2026\\n#!/bin/sh\\n\"),\n 59361\t            (\"⑤對照組:BOM 開頭的一般戳記 → 照舊算簿記\", \"governance/replay/bs\", b\"\\xef\\xbb\\xbf2026-10-01\\n\")):\n 59362\t        mode_ok, ok, why = one(rel, data)\n 59363\t        check(label, mode_ok and ok, f\"mode_ok={mode_ok} {why}\")\n 59364\t    r = _nh_repo()\n 59365\t    _nh_file(r, \"src/auth.py\", \"x = 1\\n\")\n 59366\t    _os.chmod(_nh_file(r, \"governance/replay/tool\", \"echo hi\\n\"), 0o755)\n 59367\t    _nh_commit(r, \"init\")\n 59368\t    p = _na_head(r)\n 59369\t    _nh_git(r, \"rm\", \"-q\", \"governance/replay/tool\")\n 59370\t    _nh_commit(r, \"drop tool\")\n 59371\t    ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59372\t    check(\"⑥目標那一版刪掉了:照記錄那一版的模式判,可執行 → 不算簿記、留痕失效\", not ok, why)\n 59373\t\n 59374\t\n 59375\tdef t_code_loop_bookkeeping_head_read_capped_and_deleted_stamp():\n 59376\t    \"\"\"回頭重讀代碼審 r3 架構對齊席 F2+通才席 F2:\n 59377\t    ①②讀首行走同檔帶上限的批次讀取 _nodehome_cat_blobs_capped;超過上限的讀不到 → 判不了 → 保守算程式檔(順帶守住\n 59378\t    「讀不到首行一律當程式檔」那個方向)。\n 59379\t    ③目標那一版刪掉了,退回讀記錄那一版的首行:刪掉的是一般戳記(.weekly-stamp)→ 照舊算簿記、留痕有效。\n 59380\t\n 59381\t    翻紅釘:改回不設上限的讀法 → ①紅;讀不到改成不算程式 → ①紅;拿掉「刪掉就讀記錄那一版」→ ③紅。\"\"\"\n 59382\t    print(\"t_code_loop_bookkeeping_head_read_capped_and_deleted_stamp\")\n 59383\t    m = _load_lumos_inproc()\n 59384\t    r, p = _clbk_fresh()\n 59385\t    _nh_file(r, \"governance/replay/.rotation-cursor\", \"{\\n \\\"done\\\": [\" + \", \".join(f\"\\\"x{i}\\\"\" for i in range(40)) + \"]\\n}\\n\")\n 59386\t    _nh_commit(r, \"cursor\")\n 59387\t    cap = getattr(m, \"_CODELOOP_BOOKKEEPING_HEAD_CAP\", None)\n 59388\t    check(\"前置:上限常數存在、真實最大的簿記戳記(.rotation-cursor 約 5.6 KB)遠在上限內\",\n 59389\t          isinstance(cap, int) and cap >= 256 * 1024, repr(cap))\n 59390\t    saved = cap\n 59391\t    try:\n 59392\t        m._CODELOOP_BOOKKEEPING_HEAD_CAP = 16\n 59393\t        ok, why = m._codeloop_record_valid(r, p, _na_head(r))\n 59394\t        check(\"①首行那支超過上限(暫時把上限調成 16 位元組)→ 讀不到、保守算程式、留痕失效\", not ok, why)\n 59395\t    finally:\n 59396\t        if saved is not None:\n 59397\t            m._CODELO