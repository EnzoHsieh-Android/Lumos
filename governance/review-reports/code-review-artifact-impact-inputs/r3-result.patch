\"git\", *a], cwd=d, capture_output=True, text=True)\n 22158\t        g(\"init\", \"-q\", \"-b\", \"main\")\n 22159\t        g(\"config\", \"user.email\", \"t@t.t\")\n 22160\t        g(\"config\", \"user.name\", \"t\")\n 22161\t        (Path(d) / \"README.md\").write_text(\"init\\n\", encoding=\"utf-8\")\n 22162\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"init\")\n 22163\t        g(\"checkout\", \"-qb\", \"feat\")\n 22164\t        rr = Path(d) / \"governance\" / \"review-reports\" / \"code-x\"\n 22165\t        rr.mkdir(parents=True)\n 22166\t        (rr / \"r1-snapshot.patch\").write_text(\n 22167\t            \"+++ b/app.py\\n+import requests\\n+fh = open('x')\\n+requests.post('http://x')\\n\",\n 22168\t            encoding=\"utf-8\")\n 22169\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"archive artifacts\")\n 22170\t        r = _sp.run([sys.executable, GRAPHCTL, \"pitfalls\", \"--diff\", \"main..HEAD\",\n 22171\t                     \"--no-lint\", \"--json\", \"--repo\", d], capture_output=True, text=True)\n 22172\t        import json as _j\n 22173\t        data = _j.loads([l for l in r.stdout.splitlines() if l.strip().startswith(\"{\")][0])\n 22174\t        check(\"★review-reports 下的證物不掃(tier 不因歸檔變 high)★\",\n 22175\t              data.get(\"tier\") != \"high\" and not data.get(\"claims\"),\n 22176\t              f\"tier={data.get('tier')} claims={data.get('claims')}\")\n 22177\t        # 收緊釘:同內容放在 review-reports 外照掃\n 22178\t        (Path(d) / \"app_real.py\").write_text(\"import requests\\nrequests.post('http://x')\\n\",\n 22179\t                                             encoding=\"utf-8\")\n 22180\t        g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"real code\")\n 22181\t        r2 = _sp.run([sys.executable, GRAPHCTL, \"pitfalls\", \"--diff\", \"main..HEAD\",\n 22182\t                      \"--no-lint\", \"--json\", \"--repo\", d], capture_output=True, text=True)\n 22183\t        data2 = _j.loads([l for l in r2.stdout.splitlines() if l.st