 24295\t_ROLE_UI_IMPORT[\"java\"] = _ROLE_UI_IMPORT[\"kt\"]\n 24296\t_ROLE_ANDROID_IMPORT = re.compile(r\"^\\s*import\\s+(?:android|androidx)\\.\", re.M)\n 24297\t_ROLE_UIKIT_IMPORT = re.compile(r\"^\\s*import\\s+UIKit\\b\", re.M)\n 24298\t_ROLE_UIKIT_SUBCLASS = re.compile(r\"\\bclass\\s+\\w+\\s*:[^{\\n]*\\bUI\\w*(?:ViewController|View)\\b\")\n 24299\t_ROLE_READ_CAP = 300     # 最多讀幾支檔的內容(數檔,不數往上找 package.json 的候選);超過的只看副檔名(手機檔判不出)\n 24300\t_ROLE_MAX_BYTES = 512 * 1024   # 單支檔超過這個大小不讀內容(判不出);上限交給批次讀取那一層守\n 24301\t_ROLE_BUDGET = 3.0       # 角色計算自己最多幾秒\n 24302\t_ROLE_BUDGET_FLOOR = 1.0  # 期限很短時角色至少拿這麼多(消費專案光算工具檔清單就要半秒,代碼審 r1 正確性 F2)\n 24303\t\n 24304\t\n 24305\tdef _role_budget(deadline):\n 24306\t    \"\"\"派工時角色計算能用幾秒:最多 _ROLE_BUDGET、至少 _ROLE_BUDGET_FLOOR,平常取期限的三分之一。\"\"\"\n 24307\t    if not deadline or deadline <= 0:\n 24308\t        return _ROLE_BUDGET\n 24309\t    return min(_ROLE_BUDGET, max(_ROLE_BUDGET_FLOOR, deadline / 3))\n 24310\t\n 24311\t\n 24312\tdef _review_roles_config(data, unreadable=False):\n 24313\t    \"\"\"data=改動起點那個版本的 .lumos/config.json 內容(_json_at_ref 讀的;None=沒有這個檔);unreadable=檔案在但讀不懂。\n 24314\t    回 (rules, warnings),rules=[(樣式, 角色)]。★壞宣告整份不用★、退回不宣告的判定並回一句警告(做法照 _stack_questions_config)。\n 24315\t    ★警告只寫第幾條與固定原因,不回填專案寫的值★——角色段放在框外,回填等於讓被審專案往指令區塞字(代碼審 r1 兩席)。\n 24316\t    讀起點版本的理由同派工鏡頭「圖譜只信起點」:被審的分支不能自己改宣告決定自己拿到哪張卡。\"\"\"\n 24317\t    if unreadable:\n 24318\t        return [], [\".lumos/config.json 讀不懂,review_roles 這次不用\"]\n 24319\t    v = data.get(\"review_roles\") if isinstance(data, dict) else None\n 24320\t    if v is None:\n 24321\t        return [], []\n 24322\t    shape = \"要是清單,每條 {\\\"path\\\": 路徑樣式, \\\"role\\\": frontend|backend|none}\"\n 24323\t    if not isinstance(v, list):\n 24324\t        return [], [f\"review_roles {shape};這次整份不用\"]\n 24325\t    rules = []\n 24326\t    for i, item in enumerate(v, 1):\n 24327\t        if not isinstance(item, dict) or set(item) != {\"path\", \"role\"}:\n 24328\t            return [], [f\"review_roles 第 {i} 條形狀不對({shape});這次整份不用\"]\n 24329\t        pat, role = item[\"path\"], item[\"role\"]\n 24330\t        if role not in _ROLE_VALUES:\n 24331\t            return [], [f\"review_roles 第 {i} 條的 role 不合法(只認 {'/'.join(_ROLE_VALUES)});這次整份不用\"]\n 24332\t        if not isinstance(pat, str) or not pat.strip() or pat.startswith((\"./\", \"/\")) or \"\\\\\" in pat:\n 24333\t            return [], [f\"review_roles 第 {i} 條的 path 不合法(不能空白、不能以 ./ 或 / 開頭、不能有反斜線);這次整份不用\"]\n 24334\t        rules.append((pat, role))\n 24335\t    return rules, []\n 24336\t\n 24337\t\n 24338\tdef _review_role_for(file_rel, repo_root, rules=(), reader=None, content=None):\n 24339\t    \"\"\"一支改動檔的審查角色:\"frontend\" / \"backend\" / None(判不出就不附,不猜)。依序:\n 24340\t    專案宣告(第一條命中的算數)→ 現在沒有題組鍵的前端副檔名 → 手機檔看匯入 → 題組鍵(.ts/.js 走 package.json)。\n 24341\t    建立在 _stack_key_for_file 上,不另造一套分類(設計審 r1 架構對齊席 F2)。\n 24342\t    reader:讀指定版本的 package.json(見 _node_flavor);content:手機檔的內容,None=沒讀(超過上限)→ 判不出。\"\"\"\n 24343\t    if rules:\n 24344\t        i = _glob_first_match(file_rel, [p for p, _ in rules])\n 24345\t        if i is not None:\n 24346\t            return None if rules[i][1] == \"none\" else rules[i][1]\n 24347\t    ext = Path(file_rel).suffix.lstrip(\".\").lower()\n 24348\t    if ext in _ROLE_FRONT_EXTS:\n 24349\t        return \"frontend\"\n 24350\t    if ext in _ROLE_MOBILE_EXTS:\n 24351\t        if content is None:\n 24352\t            return None\n 24353\t        if _ROLE_UI_IMPORT[ext].search(content):\n 24354\t            return \"frontend\"\n 24355\t        if ext == \"swift\" and _ROLE_UIKIT_IMPORT.search(content) and _ROLE_UIKIT_SUBCLASS.search(content):\n 24356\t            return \"frontend\"\n 24357\t        if ext == \"java\" and not _ROLE_ANDROID_IMPORT.search(content):\n 24358\t            return \"backend\"    # Java 後端服務常見;Android 純 Java 資料類也會落在這裡(已知限制,出路是宣告)\n 24359\t        return None\n 24360\t    key = _stack_key_for_file(file_rel, repo_root, reader=reader)\n 24361\t    if key == \"vue\":\n 24362\t        return \"frontend\"\n 24363\t    return \"backend\" if key in _ROLE_BACK_KEYS else None\n 24364\t\n 24365\t\n 24366\tdef _review_role_changed_files(root, base, head):\n 24367\t    \"\"\"角色鏡頭的改動檔清單:[(路徑, 讀內容用的版本)]。派工角色段與推送前分級那一行共用這一支。\n 24368\t    改名算新路徑;刪除的檔照樣算、讀起點版本。剔除測試檔(_PITFALL_DIFF_TEST_PAT)、消費專案裡原封不動的工具檔\n 24369\t    (_vendored_skip)、文件與帳檔(_impact_diff_seed_ok)。git 跑不起來回 None。\"\"\"\n 24370\t    r = _lens_git(root, \"diff\", \"--no-ext-diff\", \"--name-status\", \"-M\", \"-z\", base, head)\n 24371\t    if r is None or r.returncode != 0:\n 24372\t        return None\n 24373\t    toks = r.stdout.split(\"\\0\")\n 24374\t    skip = _vendored_skip(root, f\"{base}..{head}\")\n 24375\t    out, i = [], 0\n 24376\t    while i < len(toks) and toks[i]:\n 24377\t        st = toks[i]\n 24378\t        if st[:1] in (\"R\", \"C\"):\n 24379\t            path, ref, i = toks[i + 2], head, i + 3\n 24380\t        else:\n 24381\t            path, ref, i = toks[i + 1], (base if st[:1] == \"D\" else head), i + 2\n 24382\t        out.append((path, ref))\n 24383\t    modes = _impact_diff_modes(root, [path for path, _ref in out], base, head)\n 24384\t    if modes is None:\n 24385\t        return None\n 24386\t    return [(path, ref) for path, ref in out\n 24387\t            if not _PITFALL_DIFF_TEST_PAT.search(path)\n 24388\t            and _impact_diff_seed_ok(path, *modes.get(path, (None, None))) and path not in skip]\n 24389\t\n 24390\t\n 24391\tdef _review_roles(root, base, head, budget=_ROLE_BUDGET):\n 24392\t    \"\"\"算這段改動每支檔的角色。回 {\"roles\": {路徑: 角色|None}, \"counts\": {...}, \"warnings\": [...], \"capped\": N, \"timed_out\": bool};\n 24393\t    git 讀不到改動清單回 None。成本:內容一次批次讀取(_nodehome_cat_blobs),最多讀 _ROLE_READ_CAP 支,整體受 budget 秒限制。\"\"\"\n 24394\t    import time as _t\n 24395\t    if budget <= 0:\n 24396\t        return {\"roles\": {}, \"counts\": {\"frontend\": 0, \"backend\": 0, \"unknown\": 0},\n 24397\t                \"warnings\": [], \"capped\": 0, \"timed_out\": True}\n 24398\t    t0 = _t.monotonic()\n 24399\t    cfg = _json_at_ref(root, base, \".lumos/config.json\")\n 24400\t    _cfg_there = cfg is None and _lens_git(root, \"cat-file\", \"-e\", f\"{base}:.lumos/config.json\")\n 24401\t    rules, warnings = _review_roles_config(cfg, unreadable=bool(_cfg_there and _cfg_there.returncode == 0))\n 24402\t    files = _review_role_changed_files(root, base, head)\n 24403\t    if files is None:\n 24404\t        return None\n 24405\t    want, capped = _review_role_wanted(files, rules)\n 24406\t    blobs, timed_out = {}, False\n 24407\t    left = budget - (_t.monotonic() - t0)\n 24408\t    if want and left > 0.2:\n 24409\t        got = _nodehome_cat_blobs_capped(root, want, _ROLE_MAX_BYTES, timeout=left)\n 24410\t        if got is None:\n 24411\t            timed_out = True\n 24412\t        else:\n 24413\t            blobs = {k: (v.decode(\"utf-8\", \"replace\") if v is not None else None) for k, v in zip(want, got)}\n 24414\t    elif want:\n 24415\t        timed_out = True\n 24416\t    roles = {}\n 24417\t    for p, ref in files:\n 24418\t        content = blobs.get(f\"{ref}:{p}\")\n 24419\t        roles[p] = _review_role_for(p, root, rules, reader=lambda rel, _r=ref: blobs.get(f\"{_r}:{rel}\"), content=content)\n 24420\t    counts = {\"frontend\": sum(1 for v in roles.values() if v == \"frontend\"),\n 24421\t              \"backend\": sum(1 for v in roles.values() if v == \"backend\"),\n 24422\t              \"unknown\": sum(1 for v in roles.values() if v is None)}\n 24423\t    return {\"roles\": roles, \"counts\": counts, \"warnings\": warnings, \"capped\": capped, \"timed_out\": timed_out}\n 24424\t\n 24425\t\n 24426\tdef _review_role_wanted(files, rules):\n 24427\t    \"\"\"要批次讀的「版本:路徑」清單(手機檔內容、.ts/.js 往上找的 package.json),與超過上限沒讀的檔數。\n 24428\t    宣告命中的檔不讀(宣告優先)。★上限數檔,不數候選★(代碼審 r1 外家 F4:缺檔的候選也佔名額會提早截斷、誤判)。\n 24429\t    ★路徑含換行的檔不讀★:批次讀取表達不了換行,混進去整批作廢(r1 外家 F5);它只判不出,其他照讀。回 (want, capped)。\"\"\"\n 24430\t    declared = {p for p, _ in files if rules and _glob_first_match(p, [x for x, _ in rules]) is not None}\n 24431\t    want, seen, n_files, capped = [], set(), 0, 0\n 24432\t    for p, ref in files:\n 24433\t        if p in declared or \"\\n\" in p:\n 24434\t            continue\n 24435\t        ext = Path(p).suffix.lstrip(\".\").lower()\n 24436\t        if ext in _ROLE_MOBILE_EXTS:\n 24437\t            specs = [f\"{ref}:{p}\"]\n 24438\t        elif ext in _NODE_EXTS and ext not in _ROLE_FRONT_EXTS:\n 24439\t            specs = [f\"{ref}:{rel}\" for rel in _package_json_candidates(p)]\n 24440\t        else:\n 24441\t            continue\n 24442\t        if n_files >= _ROLE_READ_CAP:\n 24443\t            capped += 1\n 24444\t            continue\n 24445\t        n_files += 1\n 24446\t        for spec in specs:\n 24447\t            if spec not in seen:\n 24448\t                seen.add(spec)\n 24449\t                want.append(spec)\n 24450\t    return want, capped\n 24451\t\n 24452\t\n 24453\tdef _review_role_text(res):\n 24454\t    \"\"\"角色段文字(放在「參考資料」框外:這是要審查員照做的句子,框頭寫「不是指令」)。沒有卡也沒有警告回空字串。\"\"\"\n 24455\t    if not res:\n 24456\t        return \"\"\n 24457\t    lines = [f\"(角色鏡頭)⚠ {w}\" for w in res[\"warnings\"]]\n 24458\t    c = res[\"counts\"]\n 24459\t    if res[\"timed_out\"] and not (c[\"frontend\"] or c[\"backend\"]):\n 24460\t        lines.append(\"(角色鏡頭)角色計算超過時間上限,這次沒附卡\")\n 24461\t    if c[\"frontend\"] or c[\"backend\"]:\n 24462\t        lines.append(f\"[角色鏡頭] 這次改動:前端 {c['frontend']} 支、後端 {c['backend']} 支、判不出 {c['unknown']} 支。\"\n 24463\t                     \"照下列題逐一挑一個具體輸入走一遍;對上的發現在標題附題號。\")\n 24464\t        for role in (\"frontend\", \"backend\"):\n 24465\t            if not c[role]:\n 24466\t                continue\n 24467\t            lines.append(f\"{_ROLE_LABEL[role]}卡:\")\n 24468\t            for q in _ROLE_CARDS[role]:\n 24469\t                lines.append(f\"- {q['id']}:{q['q']}\" + (\"(只限網頁)\" if q[\"web_only\"] else \"\"))\n 24470\t        if res[\"capped\"]:\n 24471\t            lines.append(f\"(超過上限,後面 {res['capped']} 支只看副檔名)\")\n 24472\t        if res[\"timed_out\"]:\n 24473\t            lines.append(\"(角色計算超過時間上限,部分檔只看副檔名)\")\n 24474\t    return \"\\n\".join(lines)\n 24475\t\n 24476\t\n 24477\t# ── 棧別提問表態閘(Projects/棧別提問表態閘_計劃,2026-09-09)——適用性 + 設定 ─────────────────\n 24478\t_STACK_QUESTIONS_GATE_VALUES = (\"all\", \"high-only\", \"off\")\n 24479\t_STACK_ASK_ALL_DEFAULT = 300\n 24480\t\n 40960\t        _home_nodes, _home_big = _impact_confirmed_homes(env, rel_file, repo_root)\n 40961\t        if not _home_big:\n 40962\t            _inc = {x[\"node\"] for x in all_incidents}\n 40963\t            for _hn in _home_nodes:\n 40964\t                if _hn in _inc:\n 40965\t                    # 事故那袋留著它(事故優先,不重複列),但要標出它同時是家\n 40966\t                    # ——不標的話計劃模式的派工鏡頭看不出來,跟推送前那條路不一致(代碼審 r2 合約席)\n 40967\t                    for _ix in all_incidents:\n 40968\t                        if _ix.get(\"node\") == _hn:\n 40969\t                            _ix[\"home\"] = True\n 40970\t                    continue\n 40971\t                _hnote = env.notes.get(_hn)\n 40972\t                _hc, _hcombo = _impact_contract(_hnote) if _hnote else (None, False)\n 40973\t                all_homes.append({\"node\": _hn, \"contract\": _hc, \"combo\": _hcombo})\n 40974\t            _hset = {x[\"node\"] for x in all_homes}\n 40975\t            if _hset:\n 40976\t                all_direct = [x for x in all_direct if x[\"node\"] not in _hset]\n 40977\t                all_indirect = [x for x in all_indirect if x[\"node\"] not in _hset]\n 40978\t\n 40979\t    # 9. 輸出\n 40980\t    if as_json:\n 40981\t        print(json.dumps(\n 40982\t            {\"file\": rel_file,\n 40983\t             **({\"homes\": all_homes} if all_homes else {}),\n 40984\t             \"direct\": all_direct, \"indirect\": all_indirect,\n 40985\t             \"incidents\": all_incidents},\n 40986\t            ensure_ascii=False,\n 40987\t        ))\n 40988\t    else:\n 40989\t        # 人讀輸出\n 40990\t        print(f\"改動 {rel_file} (由讀盤 refcheck 抽取)\")\n 40991\t        if all_homes:\n 40992\t            print(f\"── 這支檔的家 ({len(all_homes)}) ──\")\n 40993\t            for x in all_homes:\n 40994\t                contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n 40995\t                print(f\"  {x['node']}{contract_tag}\")\n 40996\t        print(f\"── 直接關聯 ({len(all_direct)}) ──\")\n 40997\t        for x in all_direct:\n 40998\t            contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n 40999\t            combo_tag = \"★COMBO★\" if x.get(\"combo\") else \"\"\n 41000\t            tags = (contract_tag + (\" \" + combo_tag if combo_tag else \"\")).rstrip()\n 41001\t            print(f\"  {'⚠合約 ' if x.get('contract') else ''}{x['node']}{tags}  ({x['hit']})\")\n 41002\t        print(f\"── 間接關聯 ({len(all_indirect)}) ──\")\n 41003\t        for x in all_indirect:\n 41004\t            cross = \" [跨repo葉,不展開]\" if x.get(\"cross_repo\") else \"\"\n 41005\t            print(f\"  hop{x['hop']}  {x['node']}  {x['direction']} ← via {x['via']} ← {x['from']}{cross}\")\n 41006\t        if all_incidents:\n 41007\t            print(f\"── 相關事故 ({len(all_incidents)}) ──\")\n 41008\t            for x in all_incidents:\n 41009\t                contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n 41010\t                print(f\"  {x['node']}{contract_tag}  (trigger: {x['matched_by']})\")\n 41011\t\n 41012\t    return 0\n 41013\t\n 41014\t\n 41015\t_IMPACT_DIFF_SKIP = (\"docs/\", \"governance/golden/\")   # 圖譜/凍結快照非 code,不當 impact 種子\n 41016\t\n 41017\t\n 41018\tdef _impact_diff_seed_ok(f, file_mode=None, shebang=None):\n 41019\t    \"\"\"--diff 種子過濾:只收 code 檔。剔除圖譜/凍結快照/帳檔(.jsonl)/文檔(.md)/\n 41020\t    簿記分類沿用 _BOOKKEEPING_FILES/_BOOKKEEPING_DIRS,卷證不是程式;\n 41021\t    governance 資料 .json(goldset/裁決紀錄內嵌歷史 code 片段,會偽觸發事故 pin——r1 panel 實證)。\"\"\"\n 41022\t    if not f or any(f.startswith(p) for p in _IMPACT_DIFF_SKIP):\n 41023\t        return False\n 41024\t    # 固定帳檔仍排除；目錄內的程式例外先成立，不再被文檔副檔名二次排掉。\n 41025\t    if f in _BOOKKEEPING_FILES:\n 41026\t        return False\n 41027\t    if f.startswith(_BOOKKEEPING_DIRS):\n 41028\t        kind = _nodehome_code_kind(f)\n 41029\t        if file_mode == \"100755\" or kind == \"ext\":\n 41030\t            return True\n 41031\t        if kind == \"shebang?\":\n 41032\t            return shebang is not False  # 超過上限／讀不到時沿既有保守判法。\n 41033\t        return file_mode is None\n 41034\t    if f.endswith((\".jsonl\", \".md\")):\n 41035\t        return False\n 41036\t    if f.endswith(\".json\") and f.startswith(\"governance/\"):\n 41037\t        return False\n 41038\t    return True\n 41039\t\n 41040\t\n 41041\tdef _impact_diff_modes(repo_root, files, *diff_args):\n 41042\t    \"\"\"簿記來源取凍結模式與首行；普通來源不多查 Git。刪檔取舊物件。\"\"\"\n 41043\t    if not any(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):\n 41044\t        return {}\n 41045\t    raw = _nodehome_git(repo_root, \"diff\", \"--no-ext-diff\", \"--no-textconv\",\n 41046\t                        \"--raw\", \"--no-renames\", \"--no-abbrev\", \"-z\", *diff_args)\n 41047\t    changes = _codeloop_raw_changes(raw) if raw is not None else None\n 41048\t    if changes is None:\n 41049\t        return None\n 41050\t    out, ask = {}, []\n 41051\t    for f, (old, new, old_oid, new_oid) in changes.items():\n 41052\t        mode, oid = (old, old_oid) if new == \"000000\" else (new, new_oid)\n 41053\t        out[f] = (mode, None)\n 41054\t        if (f.startswith(_BOOKKEEPING_DIRS) and mode != \"100755\"\n 41055\t                and _nodehome_code_kind(f) == \"shebang?\" and not _path_special_chars(f, surrogate=False)\n 41056\t                and oid.strip(\"0\")):\n 41057\t            ask.append((f, oid))\n 41058\t    if ask:\n 41059\t        heads = _nodehome_cat_blobs_capped(repo_root, [oid for _f, oid in ask],\n 41060\t                                          _CODELOOP_BOOKKEEPING_HEAD_CAP, timeout=_disp_git_timeout())\n 41061\t        if heads is not None:\n 41062\t            for (f, _oid), head in zip(ask, heads):\n 41063\t                out[f] = (out[f][0], True if head is None else _head_is_shebang(head, lenient=True))\n 41064\t    return out\n 41065\t\n 41066\t\n 41067\tdef _impact_payload_read(path):\n 41068\t    \"\"\"讀一份已經算好的波及結果(pre-push 每次推送只算一次,兩個消費者共用同一份)。\n 41069\t\n 41070\t    ★為什麼要有這支★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):\n 41071\t    推送關卡本來就對每個 ref 跑一次完整的波及計算(同步點名用)。合約測試閘要的是\n 41072\t    同一份東西裡「帶合約而且綁了測試」的那幾篇——★再算一次就是把一次推送算兩次★,\n 41073\t    而那正是這一案 r1 拿來否決原設計的那個成本(那條裁定後來被查出已作廢,\n 41074\t    但「不要算兩次」本身仍然是對的)。\n 41075\t\n 41076\t    ★失敗要隔離★:讀不到就回 None,呼叫端各自決定怎麼降級——\n 41077\t    同步點名維持靜默,合約測試閘記一筆帳放行。一個失敗不准拖垮另一個。\n 41078\t    \"\"\"\n 41079\t    import json as _json, stat as _stat\n 41080\t    # ★擁有權要驗,理由跟 dispatch-lens 那支快取一模一樣★\n 41081\t    # (2026-09-07 代碼審 r1 架構對齊席判 blocking,說得對):\n 41082\t    # 這個 repo 已經有一套硬化過的「算一次、之後讀」——_lens_cache_read,\n 41083\t    # 它會先驗 st_uid 與 group/other 可不可寫,註解明寫「$TMPDIR 路徑可預測可偽造」。\n 41084\t    # 而這裡收的正是一個從命令列傳進來的 $TMPDIR 路徑,同一種曝險。\n 41085\t    # ★但沒有照抄整套★,理由是生命週期不同,而這一點原本沒寫下來所以席位抓到了:\n 41086\t    #   dispatch-lens 那支是「跨呼叫、可被別人發現、要 TTL、要 key 去對」的快取;\n 41087\t    #   這裡是「同一次 hook 執行內、由呼叫端明確指定路徑、用完就刪」的交接。\n 41088\t    #   要 TTL 與 key 是多餘的,要擁有權驗證則是必要的——所以只借那一半。\n 41089\t    try:\n 41090\t        st = Path(path).stat()\n 41091\t        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):\n 41092\t            return None\n 41093\t        data = _json.loads(Path(path).read_text(encoding=\"utf-8\"))\n 41094\t    except Exception:\n 41095\t        return None\n 41096\t    # ★形狀要驗到位★(代碼審 r1 外家否決席判 major):只驗「是 dict 而且有 results」不夠——\n 41097\t    # `{\"results\":[1],\"sync\":[]}` 這種合法 JSON 會通過,然後在下游 r.get(...) 當場拋例外,\n 41098\t    # 而那個例外會被 pre-push 的 || true 吞掉:★不是按設計記 range-unavailable,是靜默失效★。\n 41099\t    if not isinstance(data, dict):\n 41100\t        return None\n 41101\t    res = data.get(\"results\")\n 41102\t    if not isinstance(res, list) or any(not isinstance(r, dict) for r in res):\n 41103\t        return None\n 41104\t    sync = data.get(\"sync\")\n 41105\t    if sync is not None and not (isinstance(sync, dict)\n 41106\t                                 and isinstance(sync.get(\"missing\"), list)\n 41107\t                                 and isinstance(sync.get(\"touched_nodes\"), list)):\n 41108\t        return None\n 41109\t    return data\n 41110\t\n 41111\t\n 41112\tdef cmd_impact_diff(diff_range, repo=None, depth=None, top=8, min_score=0.20, as_json=False,\n 41113\t                    sync_check=False, sync_only=False, from_json=None):\n 41114\t    \"\"\"code-loop 橋接:對整段 diff 的每支改動 code 檔跑 ranked impact(query=該檔 hunk 文字),\n 41115\t    聚合成「受影響功能面」manifest——固定席(合約/事故)全保、非固定取跨檔最高分 top-N。\n 41116\t    定位=審計員鏡頭(advisory,人判),非自動推播(hook 面 goldset 評測未過線,故不接 hook)。\n 41117\t    rc: 0=成功 / 2=git 失敗 / 3=vault 缺。\n 41118\t\n 41119\t    from_json:吃一份已經算好的結果,不自己算(見 _impact_payload_read)。目前只支援\n 41120\t    搭 --sync-only 用——推送關卡算一次、同步點名與合約測試閘各讀一次。\"\"\"\n 41121\t    if from_json is not None:\n 41122\t        _pl = _impact_payload_read(from_json)\n 41123\t        if _pl is None or _pl.get(\"sync\") is None:\n 41124\t            return 0          # 失敗隔離:維持同步點名現在的行為(靜默)\n 41125\t        _print_sync_nudge(_pl[\"sync\"], _pl.get(\"range\") or diff_range)\n 41126\t        return 0\n 41127\t    import json as _json\n 41128\t    import subprocess as _sp\n 41129\t    if diff_range == \"staged\":\n 41130\t        # 圖譜同步覆蓋(2026-08-22):pre-commit 要對「這次 commit 的內容」算波及,用 staged 代替 range\n 41131\t        diff_range = \"--staged\"\n 41132\t    elif diff_range.startswith(\"-\"):\n 41133\t        # 同 pitfalls/cochange-check:'-' 開頭值會被 git 誤認成選項,查詢命令 rc2 拒收\n 41134\t        print(\"擋下:--diff 的值不能用 - 開頭(會被當成選項)\", file=sys.stderr)\n 41135\t        return 2\n 41136\t    repo_root = Path(repo) if repo else None\n 41137\t    if repo_root is None:\n 41138\t        for cand in (Path.cwd(), *Path.cwd().parents):\n 41139\t            if (cand / \".git\").exists():\n 41140\t                repo_root = cand\n 41141\t                break\n 41142\t    if repo_root is None or not (repo_root / \".git\").exists():\n 41143\t        print(\"擋下:找不到 git 專案,用 --repo 指定\", file=sys.stderr)\n 41144\t        return 2\n 41145\t    # core.quotePath=false:CJK 檔名不轉義加引號(否則 startswith/endswith 過濾全失效,r2 panel major)\n 41146\t    r = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n 41147\t                 \"diff\", \"--name-only\", diff_range], capture_output=True, text=True, errors=\"replace\")\n 41148\t    if r.returncode != 0:\n 41149\t        print(f\"擋下:git 算不出差異: {r.stderr.strip()[:200]}\", file=sys.stderr)\n 41150\t        return 2\n 41151\t    candidates = [f.strip() for f in r.stdout.splitlines()]\n 41152\t    modes = _impact_diff_modes(repo_root, candidates, diff_range)\n 41153\t    if modes is None:\n 41154\t        print(\"擋下:git 算不出差異檔案模式\", file=sys.stderr)\n 41155\t        return 2\n 41156\t    files = []\n 41157\t    for f in candidates:\n 41158\t        if not _impact_diff_seed_ok(f, *modes.get(f, (None, None))):\n 41159\t            continue\n 41160\t        # 已刪檔不跳過:反查靠「節點 body 引用該路徑」而非檔案存在——\n 41161\t        # 刪除/改名正是合約節點最該被推到審計員眼前的時刻(r1 codex major)\n 41162\t        files.append(f)\n 41163\t    merged = {}          # node -> entry(跨檔取最高分;pinned 任一檔 pinned 即 pinned)\n 41164\t    per_file_meta = []\n 41165\t    import io, contextlib\n 41166\t    _vault = _vault_in(repo_root)\n 41167\t    # ★沒有圖譜就直接說,不要印「0 篇」裝作查過了★(2026-09-07 全 repo 審視 #9)\n 41168\t    #\n 41169\t    # 出身:這條路原本只在**逐檔迴圈裡**才發現沒圖譜——而「這個範圍 0 個檔」時迴圈根本不跑,\n 41170\t    # 於是一路走到最後印出「固定席 0 + top 0」並回成功。\n 41171\t    # ★對新手最危險的就是這個★:同一件事(找不到圖譜),另外兩種問法一個回 rc3、一個回 rc2\n 41172\t    # 並印白話擋下,只有這條印「0 篇」**看起來像查過了**——而它根本沒有圖譜可查。\n 41173\t    # 文件本來就寫著這條路會回「圖譜缺」,只是零檔時走不到。\n 41174\t    if _vault is None:\n 41175\t        return _no_vault_msg()\n 41176\t    _env_shared = Env(_vault)   # 建一次,逐檔復用(r1 N+1)\n 41177\t    for f in files:\n 41178\t        d = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n 41179\t                     \"diff\", \"--no-ext-diff\", \"--no-textconv\", diff_range, \"--\", f], capture_output=True, text=True, errors=\"replace\")\n 41180\t        hunk = \" \".join(l[1:].strip() for l in d.stdout.splitlines()\n 41181\t                        if l[:1] in \"+-\" and not l.startswith((\"+++\", \"---\")))[:4000]\n 41182\t        buf = io.StringIO()\n 41183\t        with contextlib.redirect_stdout(buf):\n 41184\t            rc = cmd_impact(f, repo=str(repo_root), depth=depth, as_json=True,\n 41185\t                            ranked=True, top=top, min_score=min_score,\n 41186\t                            payload={\"query\": hunk, \"prospective\": {}},\n 41187\t                            preloaded=(_vault, _env_shared) if _env_shared is not None else None)\n 41188\t        if rc == 3:\n 41189\t            print(\"IMPACT-DEBUG: vault 找不到(rc3)\", file=sys.stderr)\n 41190\t            return 3\n 41191\t        if rc != 0:\n 41192\t            continue\n 41193\t        try:\n 41194\t            data = _json.loads(buf.getvalue().strip().splitlines()[-1])\n 41195\t        except (ValueError, IndexError):\n 41196\t            continue\n 41197\t        _pm = {\"file\": f, **data.get(\"meta\", {})}\n 41198\t        if data.get(\"query_gated\"):\n 41199\t            _pm[\"query_gated\"] = True   # 觀測欄聚合轉發(r1 f5:code-loop 鏡頭可見)\n 41200\t        per_file_meta.append(_pm)\n 41201\t        for x in data.get(\"results\", []):\n 41202\t            cur = merged.get(x[\"node\"])\n 41203\t            if cur is None:\n 41204\t                merged[x[\"node\"]] = {**x, \"files\": [f]}\n 41205\t            else:\n 41206\t                if f not in cur[\"files\"]:\n 41207\t                    cur[\"files\"].append(f)\n 41208\t                pinned = cur[\"pinned\"] or x.get(\"pinned\", False)\n 41209\t                # ★家是「哪支檔的家」,不是「這一輪分數高不高」★(推筆記認家 [S6]):\n 41210\t                # 同一篇在 A 檔是家、在 B 檔只是被提到,B 檔那筆分數較高就會整項重建——\n 44220\t                last = ev\n 44221\t    except OSError:\n 44222\t        return None\n 44223\t    if last is None:\n 44224\t        return None\n 44225\t    return {\"head_sha\": last[\"head_sha\"], \"branch\": branch, \"ts\": last.get(\"ts\"),\n 44226\t            \"dispositions\": last.get(\"dispositions\") or {}, \"_source\": \"ledger\"}\n 44227\t\n 44228\t\n 44229\tdef _codeloop_record_valid(repo_root, rec_sha, marker_sha):\n 44230\t    \"\"\"留痕座標有效性(pass/skip 與表態共用同一套):同 sha;或 rec_sha 是 marker_sha 的祖先且中間只動簿記檔\n 44231\t    ([[Issues/code-loop-pass自失效追尾]] 的豁免)。回 (ok, 一句為什麼)——固定二元組,既有呼叫端的說法不變。\"\"\"\n 44232\t    ok, why, _unsure = _codeloop_record_valid_ex(repo_root, rec_sha, marker_sha)\n 44233\t    return ok, why\n 44234\t\n 44235\t\n 44236\tdef _codeloop_missing_commit(repo_root, rec_sha, timeout):\n 44237\t    \"\"\"記錄的提交在這份 repo 裡找不到時的三元組:判不了只限淺 clone(缺歷史時它可能正是祖先);\n 44238\t    完整歷史裡找不到的提交不可能是祖先,確定無效(代碼審 r3 正確性席:別講成判不了)。逾時照丟 TimeoutExpired 由呼叫端接。\"\"\"\n 44239\t    if _git_is_shallow(repo_root, timeout=timeout):\n 44240\t        return (False, (f\"記錄 sha {rec_sha[:8]} 在這份 repo 裡找不到(寫錯、淺 clone、或已被清掉),\"\n 44241\t                        \"判不了是不是祖先——先確認那個提交還在,不在就照重來的步驟重記\"), True)\n 44242\t    return (False, (f\"記錄 sha {rec_sha[:8]} 在這份 repo 的完整歷史裡找不到(寫錯或已被清掉),\"\n 44243\t                    \"不可能是目標的祖先——照重來的步驟重記\"), False)\n 44244\t\n 44245\t\n 44246\tdef _codeloop_record_valid_ex(repo_root, rec_sha, marker_sha, timeout=None):\n 44247\t    \"\"\"同 `_codeloop_record_valid` 的判定,但固定回三元組 (ok, 為什麼, 判不了):判不了=git 逾時、讀不懂 git diff 的輸出、\n 44248\t    讀不到簿記資料夾裡檔案的內容、或淺 clone 裡找不到那個提交(缺歷史時它可能正是祖先)。算破壞測試背書時,判不了的紀錄不能當無效丟掉\n 44249\t    (那可能正是一筆 survived)。timeout 給了就用它當每次 git 的上限(算背書時傳剩餘預算)。\"\"\"\n 44250\t    import subprocess as _sp\n 44251\t    _to = timeout if timeout is not None else _disp_git_timeout()\n 44252\t    if not rec_sha:\n 44253\t        return (False, \"記錄沒有 sha\", False)\n 44254\t    if rec_sha == marker_sha:\n 44255\t        return (True, f\"同版本 {marker_sha[:8]}\", False)\n 44256\t    try:\n 44257\t        anc = _sp.run([\"git\", \"merge-base\", \"--is-ancestor\", rec_sha, marker_sha],\n 44258\t                      capture_output=True, text=True, errors=\"replace\", cwd=str(repo_root), timeout=_to)\n 44259\t        if anc.returncode not in (0, 1):\n 44260\t            # ★git 回 1 才是「不是祖先」;其他非零是那個提交在這份 repo 裡根本找不到★(代碼審 r1 通才席):\n 44261\t            # 寫錯的 sha、淺 clone、或物件被清掉。第一版把這種也講成「多半是壓過提交」,給了文不對題的重來指令。\n 44262\t            return _codeloop_missing_commit(repo_root, rec_sha, _to)\n 44263\t        if anc.returncode != 0:\n 44264\t            # ★講出最常見的原因與怎麼重來★(2026-09-22 rtb-production-agent-demo 回報):\n 44265\t            # 把本機提交壓成一個、或 rebase 之後,內容可以一模一樣,原本記的那個提交卻不再是祖先。\n 44266\t            # 只丟兩個 sha 的話,人看不出是自己剛做的壓提交造成的,也不知道要重跑哪兩個指令。\n 44267\t            return (False, (f\"記錄 sha {rec_sha[:8]} 不是目標 {marker_sha[:8]} 的祖先——多半是壓過提交或 rebase 改寫過歷史\"\n 44268\t                           \"(內容沒變也一樣失效)。重來:表態 `lumos pitfalls --diff <範圍> --dispositions-template --carry`\"\n 44269\t                           \" 再 `lumos code-loop dispositions <檔>`;審查留痕重跑 `lumos code-loop pass --note \\\"…\\\"`\"), False)\n 44270\t        # ★--no-renames★:改名偵測只列新路徑,把程式檔改名搬進簿記資料夾(還能順便換副檔名)就看不到「程式檔被刪」;\n 44271\t        # ★-z★:預設會把中文等檔名加引號印出(core.quotepath),簿記資料夾裡的中文檔名就比不到前綴(回頭重讀代碼審 r1 資安席 F4)\n 44272\t        # ★--raw★(回頭重讀代碼審 r3 資安席 F2):連兩邊的檔案模式一起拿,簿記資料夾裡可執行的檔要認得出來;路徑清單跟 --name-only 同一份\n 44273\t        df = _sp.run([\"git\", \"diff\", \"--no-ext-diff\", \"--raw\", \"--no-renames\", \"-z\", rec_sha, marker_sha],\n 44274\t                     capture_output=True, cwd=str(repo_root), timeout=_to)\n 44275\t    except _sp.TimeoutExpired:\n 44276\t        return (False, f\"git 超過 {_to:.0f} 秒沒回(merge-base/diff),判不了有效性\", True)\n 44277\t    modes = _codeloop_raw_modes(df.stdout) if df.returncode == 0 else None\n 44278\t    if modes is None:\n 44279\t        return (False, f\"讀不懂 git diff {rec_sha[:8]}..{marker_sha[:8]} 的輸出,判不了是不是純簿記增量\", True)\n 44280\t    files = list(modes)\n 44281\t    # 簿記資料夾底下的程式檔不算簿記(只改這一個消費者;小改動閘、風險掃描、推送前測試範圍、來源髒檔合併照舊只看前綴)\n 44282\t    if all(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):\n 44283\t        _code = _codeloop_bookkeeping_code(repo_root, rec_sha, marker_sha,\n 44284\t                                           {f: m_ for f, m_ in modes.items() if f not in _BOOKKEEPING_FILES},\n 44285\t                                           timeout=_to, unknown=None)\n 44286\t        if _code is None:\n 44287\t            return (False, f\"讀不到簿記資料夾裡檔案的內容,判不了 {rec_sha[:8]} 之後是不是純簿記增量\", True)\n 44288\t        if not _code:\n 44289\t            return (True, f\"祖先 {rec_sha[:8]}+簿記豁免(其後 {len(files)} 檔皆簿記)\", False)\n 44290\t    return (False, f\"記錄 sha {rec_sha[:8]} 之後動了代碼(非純簿記增量)\", False)\n 44291\t\n 44292\t\n 44293\tdef _codeloop_raw_changes(out):\n 44294\t    \"\"\"git diff --raw -z(不偵測改名)的輸出 → {路徑: (舊模式, 新模式, 舊物件, 新物件)};模式是 \"100644\" 這種字串,\n 44295\t    那一版沒有這支檔是 \"000000\"。格式對不上回 None(呼叫端當判不了)。路徑用無損解碼。\"\"\"\n 44296\t    parts = out.split(b\"\\0\")\n 44297\t    res, i = {}, 0\n 44298\t    while i < len(parts) and parts[i]:\n 44299\t        meta = parts[i]\n 44300\t        if i + 1 >= len(parts) or not meta.startswith(b\":\"):\n 44301\t            return None\n 44302\t        fields = meta[1:].split(b\" \")\n 44303\t        if len(fields) < 5 or not parts[i + 1]:\n 44304\t            return None\n 44305\t        res[os.fsdecode(parts[i + 1])] = tuple(v.decode(\"ascii\", \"replace\") for v in fields[:4])\n 44306\t        i += 2\n 44307\t    return res\n 44308\t\n 44309\t\n 44310\tdef _codeloop_raw_modes(out):\n 44311\t    \"\"\"既有留痕消費者只取模式；模式與首行消費者共用同一個 raw 解析器。\"\"\"\n 44312\t    changes = _codeloop_raw_changes(out)\n 44313\t    return None if changes is None else {f: row[:2] for f, row in changes.items()}\n 44314\t\n 44315\t\n 44316\t# 留痕有效性讀簿記資料夾裡沒副檔名那幾支的首行時,單支的大小上限(回頭重讀代碼審 r3 架構對齊席 F2:走帶上限的批次讀取)。\n 44317\t# 超過上限讀不到 → 判不了 → 保守當程式檔(留痕失效)。2026-10-01 本 repo 簿記資料夾裡沒副檔名的只有 .weekly-stamp(9 位元組)\n 44318\t# 與 .rotation-cursor(約 5.6 KB、每輪加一行),離上限很遠。\n 44319\t_CODELOOP_BOOKKEEPING_HEAD_CAP = 1024 * 1024\n 44320\t\n 44321\t\n 44322\tdef _codeloop_bookkeeping_code(repo_root, rec_sha, marker_sha, files, timeout=None, unknown=True):\n 44323\t    \"\"\"簿記資料夾底下這幾支裡有沒有程式檔(有就不算簿記)。files={路徑: (記錄那版模式, 目標那版模式)}(_codeloop_raw_modes)。\n 44324\t    判的是目標提交 marker_sha 裡那一版;那一版刪掉了(模式 000000)就判記錄 rec_sha 那一版。任一條成立就算程式檔:\n 44325\t    ①那一版的模式是可執行(100755),有沒有副檔名、有沒有寫 #! 都算(回頭重讀代碼審 r3 資安席 F2:沒有可用 #! 的\n 44326\t      可執行檔,bash 會改用 sh 直接跑它的內容);\n 44327\t    ②副檔名在清單裡(_nodehome_code_kind,跟每支檔有家同一套);\n 44328\t    ③沒副檔名、首行是 #!——首行從 git 讀那一版(不讀磁碟,磁碟上可以是別的),判之前先去掉 UTF-8 BOM 與行首空白\n 44329\t      (_head_is_shebang lenient;#! 在第二行不算,跟每支檔有家同口徑);\n 44330\t    ④沒副檔名、首行判不了:路徑帶控制字元(_path_special_chars,不算替身字元)——git 的批次讀取會吃掉行尾的 \\r,查「run\\r」\n 44331\t      拿回的是同目錄另一支「run」(回頭重讀代碼審 r3 資安席 F1,major);超過 _CODELOOP_BOOKKEEPING_HEAD_CAP 或讀不到\n 44332\t      (子模組、批次讀取失敗)——都保守當程式檔(同 _is_code_file)。\n 44333\t    代碼審 r2 架構對齊席 F1:第一版只接副檔名那一半,沒副檔名的 #! 腳本搬進簿記資料夾照樣豁免。\"\"\"\n 44334\t    ask = []\n 44335\t    for f, (old_mode, new_mode) in files.items():\n 44336\t        deleted = new_mode == \"000000\"\n 44337\t        if (old_mode if deleted else new_mode) == \"100755\":\n 44338\t            return True\n 44339\t        kind = _nodehome_code_kind(f)\n 44340\t        if kind == \"ext\":\n 44341\t            return True\n 44342\t        if kind == \"shebang?\":\n 44343\t            if _path_special_chars(f, surrogate=False):\n 44344\t                return True\n 44345\t            ask.append(f\"{rec_sha if deleted else marker_sha}:{f}\")\n 44346\t    if not ask:\n 44347\t        return False\n 44348\t    blobs = _nodehome_cat_blobs_capped(repo_root, ask, _CODELOOP_BOOKKEEPING_HEAD_CAP,\n 44349\t                                       timeout=timeout if timeout is not None else _disp_git_timeout())\n 44350\t    if blobs is None:\n 44351\t        return unknown   # 預設保守當程式檔;算破壞測試背書時傳 None,讓呼叫端判「判不了」\n 44352\t    return any(head is None or _head_is_shebang(head, lenient=True) for head in blobs)\n 44353\t\n 44354\t\n 44355\tdef _disp_git_timeout():\n 44356\t    \"\"\"單次 git 子程序上限(秒;r1 併發席 f2:20 秒預算只在每題迴圈頂端查,單次 git 卡住預算攔不住)。\n 44357\t    超時往上拋 subprocess.TimeoutExpired,由每題的例外接手判「無法驗證」(擋,不放行)。\"\"\"\n 44358\t    try:\n 44359\t        return max(0.1, float(os.environ.get(\"LUMOS_DISP_GIT_TIMEOUT\", \"8\")))\n 44360\t    except ValueError:\n 44361\t        return 8.0\n 44362\t\n 44363\t\n 44364\tdef _git_tree_has(repo_root, at_sha, path):\n 44365\t    import subprocess as _sp\n 44366\t    r = _sp.run([\"git\", \"cat-file\", \"-e\", f\"{at_sha}:{path}\"], capture_output=True, text=True, errors=\"replace\", cwd=str(repo_root), timeout=_disp_git_timeout())\n 44367\t    return r.returncode == 0\n 44368\t\n 44369\t\n 44370\tdef _git_tree_text(repo_root, at_sha, path):\n 44371\t    import subprocess as _sp\n 44372\t    r = _sp.run([\"git\", \"show\", f\"{at_sha}:{path}\"], capture_output=True, text=True, cwd=str(repo_root), errors=\"ignore\", timeout=_disp_git_timeout())\n 44373\t    return r.stdout if r.returncode == 0 else None\n 44374\t\n 44375\t\n 44376\tdef _dispositions_check_path_line(repo_root, at_sha, ev):\n 44377\t    \"\"\"satisfied 的 path:line 錨點:走 refcheck 同一個入口 _validate_repo_ref(有 at_sha 對被推送的樹、沒有對工作樹;\n 44378\t    三態 missing/line_out_of_range/ok 同義;r3 架構對齊席 A3)。只驗存在不驗內容。\"\"\"\n 44379\t    p, line = _dispositions_split_path_line(ev)\n 44380\t    if p is None:\n 44381\t        return False, line\n 44382\t    st, _ = _validate_repo_ref(Path(repo_root), p, line, at_sha=at_sha)\n 44383\t    if st == \"ok\":\n 44384\t        return True, \"\"\n 44385\t    where = f\"推送版本 {at_sha[:8]} 的樹\" if at_sha else \"工作樹\"\n 44386\t    why = \"不存在(未追蹤/未提交?)\" if st == \"missing\" else \"行號超出檔案長度\"\n 44387\t    return False, f\"{p}:{line} 在{where}{why}\"\n 44388\t\n 44389\t\n 44390\tdef _dispositions_check_test(repo_root, at_sha, ev, pidx):\n 22980\t    (v / \"Systems\").mkdir(parents=True); (v / \"Issues\").mkdir(); (v / \"MOC\").mkdir()\n 22981\t    (v / \"MOC\" / \"i.md\").write_text(\"---\\ntype: moc\\n---\\n\", encoding=\"utf-8\")\n 22982\t    # 直接引用 svc.py 的節點 + 一個含合約 + 一個事故(pitfall_when content trigger)\n 22983\t    (v / \"Systems\" / \"SvcCore.md\").write_text(\n 22984\t        \"---\\ntype: system\\nstatus: done\\nsummary: |-\\n  KEY:★INVARIANT★ 不可空寫 [test:X]\\n---\\n\"\n 22985\t        \"# SvcCore\\n實作在 `src/svc.py`。\\n\", encoding=\"utf-8\")\n 22986\t    (v / \"Systems\" / \"Helper.md\").write_text(\n 22987\t        \"---\\ntype: system\\nstatus: done\\nsummary: |-\\n  KEY:普通\\n---\\n# Helper\\n`src/svc.py` 的輔助。\\n\",\n 22988\t        encoding=\"utf-8\")\n 22989\t    (v / \"Issues\" / \"SQL注入踩雷.md\").write_text(\n 22990\t        \"---\\ntype: issue\\nstatus: open\\npitfall_when:\\n  - \\\"content:SELECT.*FROM\\\"\\n\"\n 22991\t        \"summary: |-\\n  FLAG:TECHNICAL\\n---\\n# SQL 注入\\n拼字串 SQL 的坑。\\n\", encoding=\"utf-8\")\n 22992\t    (root / \"src\").mkdir()\n 22993\t    (root / \"src\" / \"svc.py\").write_text(\"def save(x):\\n    pass\\n\", encoding=\"utf-8\")\n 22994\t    g(\"add\", \"-A\"); g(\"commit\", \"-qm\", \"init\")\n 22995\t    def lum(*a, stdin=None):\n 22996\t        return sp.run([sys.executable, GRAPHCTL, *a], capture_output=True, text=True,\n 22997\t                      cwd=root, input=stdin)\n 22998\t    # legacy impact --json 四段不變\n 22999\t    r = lum(\"impact\", \"--file\", \"src/svc.py\", \"--json\")\n 23000\t    d0 = json.loads(r.stdout.strip().splitlines()[-1])\n 23001\t    check(\"impact legacy 四段\", set(d0) >= {\"file\", \"direct\", \"indirect\", \"incidents\"}, str(d0)[:150])\n 23002\t    # ranked:合約節點固定席在前、帶分數\n 23003\t    r = lum(\"impact\", \"--file\", \"src/svc.py\", \"--ranked\", \"--json\")\n 23004\t    check(\"impact --ranked rc0\", r.returncode == 0, r.stderr[:200])\n 23005\t    dr = json.loads(r.stdout.strip().splitlines()[-1])\n 23006\t    check(\"ranked 有 results+meta\", \"results\" in dr and \"meta\" in dr, str(dr)[:150])\n 23007\t    pinned = [x for x in dr[\"results\"] if x.get(\"pinned\")]\n 23008\t    check(\"合約節點被固定(SvcCore)\", any(\"SvcCore\" in x[\"node\"] for x in pinned), str(pinned)[:200])\n 23009\t    check(\"每項有分數\", all(\"score\" in x for x in dr[\"results\"]), str(dr)[:150])\n 23010\t    # v1.1 精度語意:content trigger 比對「這次改動的內容」(payload.query,即 hook 端的 old+new)——\n 23011\t    # 新增危險內容在 delta 裡 → 觸發;整檔含危險符號但 delta 無關 → 不誤觸發(單體大檔恆誤傷修正)\n 23012\t    payload = json.dumps({\"query\": \"def save(x): q='SELECT id FROM t'\",\n 23013\t                          \"prospective\": {\"src/svc.py\": \"def save(x):\\n    q='SELECT id FROM t'\\n\"}})\n 23014\t    r = lum(\"impact\", \"--file\", \"src/svc.py\", \"--ranked\", \"--stdin-payload\", \"--json\", stdin=payload)\n 23015\t    dp = json.loads(r.stdout.strip().splitlines()[-1])\n 23016\t    check(\"delta 含危險內容 → incident 觸發\", any(\"SQL\" in x[\"node\"] for x in dp[\"results\"] if x.get(\"kind\") == \"incident\"),\n 23017\t          str([x for x in dp[\"results\"] if x.get(\"kind\")==\"incident\"]))\n 23018\t    payload2 = json.dumps({\"query\": \"rename helper only\",\n 23019\t                           \"prospective\": {\"src/svc.py\": \"def save(x):\\n    q='SELECT id FROM t'\\n\"}})\n 23020\t    r = lum(\"impact\", \"--file\", \"src/svc.py\", \"--ranked\", \"--stdin-payload\", \"--json\", stdin=payload2)\n 23021\t    dp2 = json.loads(r.stdout.strip().splitlines()[-1])\n 23022\t    check(\"delta 無關 → 整檔危險符號不誤觸發(v1.1)\", not any(\"SQL\" in x[\"node\"] for x in dp2[\"results\"] if x.get(\"kind\") == \"incident\"),\n 23023\t          str([x for x in dp2[\"results\"] if x.get(\"kind\")==\"incident\"]))\n 23024\t    # incidents-only:只回事故段、不做 BFS\n 23025\t    r = lum(\"impact\", \"--file\", \"src/svc.py\", \"--incidents-only\", 