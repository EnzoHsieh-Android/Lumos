.compile(r\"^##\\s+(?:[(（]?[一二三四五六七八九十\\d]+[)）.、]?\\s*)?實務隱患\\s*(?:[(（][^)）]*[)）])?\\s*$\")\n_KEEPS_RE = re.compile(r\"\\[keeps\\]\")\n_KEEPS_VARIANT_RE = re.compile(r\"[\\[［【]\\s*keeps\\s*[\\]］】]\", re.I)\n_DOOR_STALE_DAYS = 30   # 健檢:風險低 doing 計劃多少天沒新留痕就提醒(不擋)\n# 小改動閘(雙向門放行_計劃 S27;Enzo 2026-09-17 裁「小改動不至於要綁測試」+「行數太 low,看 AWS/Meta/學術怎麼判」):\n# 全靠人驗的風險低計劃,推送時四個維度全部成立才放行。判準借即時缺陷預測(Mockus&Weiss 2000、Kamei 2013)的擴散/相對量/歷史/目的,\n# 不拿絕對行數當唯一判準;數字是拍的(RETIRE-IF 在計劃),改了就 bump 版本(留痕記 small_change_rule)。\n_SMALL_CHANGE_RULE_VERSION = 1\n_SMALL_CHANGE = {\"max_files\": 5, \"max_dirs\": 2, \"max_rel_churn\": 0.2, \"max_abs_lines\": 300, \"escape_days\": 90}\n# 「哪些檔不算程式改動」沿用既有單一源:簿記檔 _BOOKKEEPING_FILES/_BOOKKEEPING_DIRS + 圖譜筆記(代碼審 r1 架構席:自開正則=第二套判準會漂);\n# ★不按副檔名排除★(r2 通才席 blocker:借 _PITFALL_DIFF_SKIP_EXT 會讓 .json/.html/.svg 整支量不到,前端專案的大改動 fail-open)\n\n\ndef _excluded_line(line):\n    \"\"\"「已排除:<類>:<理由>」行的★唯一★解析——判定(掃描跳不跳這行)與證明(算不算四行之一)共用同一支\n    (r2 正確性/邊界席:兩邊各寫一份、只認字首,任何段落寫一行「已排除:…」就能把它洗出掃描)。\n    回 None(不是已排除行)或 (類名, 理由, 合格):合格=類名是四類中文名之一且理由 ≥4 個實字;半形全形冒號都收。\"\"\"\n    s = _EXCL_LEAD_RE.sub(\"\", _strip_inline_markup(line)[0]).strip()\n    m = _EXCLUDED_RE.match(s)\n    if not m:\n        return None\n    cls, reason = m.group(1).strip(\"*_ \"), m.group(2).strip().strip(\"*_ \").strip()   # 粗體寫法 `- **已排除:金流:** 理由` 的星號不進理由(全面實測抓到理由被記成「** 純本機…」)\n    return cls, reason, (cls in _DOOR_CLASS_ZH.values() and _real_chars(reason) >= 4)\n\n\ndef _real_chars(s):\n    \"\"\"實字數:字母、數字或漢字(標點、空白、底線不算)。「已排除」行理由與回頭條件結案理由共用\n    (Projects/回頭條件寫法補齊_計劃〈做法〉2.2,設計審 r1 架構對齊席:不抄第二份)。\"\"\"\n    return len(re.findall(r\"[^\\W_]\", s or \"\"))\n\n\ndef _door_exclusions(text):\n    \"\"\"實務隱患節裡合格的已排除行:回 ({類: 理由}, {合格行的行號});同類多行取第一行;引用塊行不算。\"\"\"\n    found, linenos = {}, set()\n    for no, ln in _h2_section_lines(text, _HAZARD_H2_RE) or []:\n        if ln.lstrip().startswith(\">\"):   # 引用塊=引來的話,不是本計劃的宣稱(跟回退節「引用塊不算實字」同一條;代碼審 r1 F2)\n            continue\n        ex = _excluded_line(ln)\n    if not path.exists():\n        return latest\n    for ln in path.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines():\n        if not ln.strip():\n            continue\n        try:\n            d = _j.loads(ln)\n        except ValueError:\n            continue\n        if isinstance(d, dict) and d.get(\"kind\") == \"spec-gate\" and d.get(\"loop\"):\n            latest[nfc(str(d[\"loop\"]))] = d\n    return latest\n\n\ndef _spec_gate_push_candidates(env, rr, vrel, touched):\n    \"\"\"推送前要查哪些計劃:範圍碰到的計劃檔,加上 lands_in/related/正文連結指向「被碰到的 Systems 節點或被改程式檔的家」的 doing 計劃。\"\"\"\n    plans = {t[len(vrel) + 1:] for t in touched if t.startswith(vrel + \"/Projects/\") and t.endswith(\".md\")}\n    systems = {t[len(vrel) + 1:-3] for t in touched if t.startswith(vrel + \"/Systems/\") and t.endswith(\".md\")}\n    code = [t for t in touched if not t.startswith(vrel + \"/\")]\n    if code:   # 實作提交常只動程式檔不動筆記(編排者實測 E2):被改的檔的家也算被碰到——家對照表走唯一算法 _impact_home_map(代碼審 r2 架構席:自己掃 about_code 會漏掉 status 過濾與路徑正規化)\n        homes, _own = _impact_home_map(env)\n        for f in code:\n            for srel in homes.get(_nodehome_key(f), []):\n                systems.add(srel[:-3] if srel.endswith(\".md\") else srel)\n    if systems:   # 落點被碰到:lands_in/related/正文連結任一指向被改的 Systems 節點(跟門判定訊號 2 同一份連結來源)\n        for prel, n in env.notes.items():\n            if not prel.startswith(\"Projects/\") or str(n.fields.get(\"status\")) != \"doing\":\n                continue\n            try:\n                ptxt = (env.vault / prel).read_text(encoding=\"utf-8-sig\")\n            except (OSError, UnicodeDecodeError):\n                ptxt = \"\"\n            if set(_plan_system_links(n, text=ptxt, systems_only=False)) & systems:\n                plans.add(prel)\n    return plans\n\n\ndef _head_is_shebang(head, lenient=False):\n    \"\"\"檔案開頭那段 bytes 的第一行是不是 #!(每支檔有家與 _is_code_file 共用這一支——代碼審 r2 架構席:別各寫一份)。\n    lenient=True 先去掉 UTF-8 BOM 與行首空白(空格、tab、CR、FF、VT;不去換行,#! 在第二行照舊不算)再看:\n    只有代碼審留痕有效性的簿記判法用(回頭重讀代碼審 r3 資安席 F2——這兩種 bash 照樣跑得起來);每支檔有家維持嚴格口徑。\"\"\"\n    if not head:\n        return False\n    if lenient:\n        head = head[3:] if head.startswith(b\"\\xef\\xbb\\xbf\") else head\n        head = head.lstrip(b\" \\t\\r\\f\\v\")\n    return head[:200].split(b\"\\n\", 1)[0].startswith(b\"#!\")\n\n\ndef _shebang_line_is_python(first_line):\n    \"\"\"檔案首行是不是 python 的 #!(派工鏡頭的退路與存量漂移的條件判定共用;跟 _head_is_shebang 放一起——代碼審 r3 架構對齊席)。\"\"\"\n    return first_line.startswith(\"#!\") and \"python\" in first_line\n\n\ndef _is_code_file(rr, path, base=None):\n    \"\"\"「需要有家的程式檔」判定(每支檔有家同一套):副檔名在清單裡=是;沒副檔名要看首行是不是 #!(.gitignore/Makefile 這種不是)。\n    磁碟上沒有(這次被刪)就從範圍起點 base 讀;兩邊都讀不到★保守當程式檔★(代碼審 r2 通才席 blocker:刪掉 hook 本身被判成沒程式檔 → light 漏派審)。\n    豁免層也同一套(代碼審 r3 通才席):排除 glob(docs/*、node_modules、bin…)、測試檔、.lumos/config 的 ignore——這些每支檔有家不要求有家,這裡也不算程式檔。\"\"\"\n    import fnmatch as _fn\n    if any(_fn.fnmatch(path, g) for g in _NODEHOME_EXCLUDE_GLOBS) or _nodehome_is_test(path):\n        return False\n    try:\n        if _cochange_excluded(path, _nodehome_config(rr)[\"ignore\"]):\n            return False\n    except Exception:\n        pass\n    kind = _nodehome_code_kind(path)\n    if kind == \"ext\":\n        return True\n    if kind != \"shebang?\":\n        return False\n    try:\n        with open(Path(rr) / path, \"rb\") as f:\n            return _head_is_shebang(f.read(200))\n    except OSError:\n        pass\n    if base:\n        try:\n            g = subprocess.run([\"git\", \"-C\", str(rr), \"show\", f\"{base}:{path}\"], capture_output=True, errors=None)\n            if g.returncode == 0:\n                return _head_is_shebang(g.stdout[:200])\n        except OSError:\n            pass\n    return True\n\n\ndef _sc_changed_files(rr, git_range, vrel):\n    \"\"\"小改動閘的改動清單 [(新路徑, 新增, 刪除, 二進位, 舊路徑)];算不出回 (None, 原因)。\n    用 -z:改名印成 la\\tld\\t\\0舊\\0新\\0 各自完整欄位(r3 架構席:repo 慣例是 -z + 欄位,不自刻正則解 {a => b};r2 通才席:純改名的大檔不算重寫)。\n    帳本/卷證/筆記不算程式改動;★從程式目錄搬進卷證目錄的不豁免★(r3 通才席:路徑前綴是內容無關的過濾器,搬進去就能躲掉四維度)。\"\"\"\n    try:\n        r = subprocess.run([\"git\", \"-C\", str(rr), \"-c\", \"core.quotePath=false\", \"diff\", \"--numstat\", \"-z\", git_range, \"--\"], capture_output=True, text=True, errors=\"replace\")\n    except OSError as e:\n        return None, f\"算不出改動量({e})\"\n    if r.returncode != 0:\n        return None, f\"範圍 {git_range} 算不出來\"\n    def _bk(x):\n        return x in _BOOKKEEPING_FILES or x.startswith(_BOOKKEEPING_DIRS) or (vrel and x.startswith(vrel + \"/\"))\n    files, toks, i = [], r.stdout.split(\"\\0\"), 0\n    while i < len(toks):\n        t = toks[i]\n        i += 1\n        if not t.strip():\n            continue\n        parts = t.split(\"\\t\")\n        if len(parts) == 3 and parts[2]:\n            la, ld, path, old = parts[0], parts[1], parts[2], parts[2]\n        elif len(parts) in (2, 3) and i + 1 < len(toks):   # 改名:第三欄空,下兩個欄位是舊路徑、新路徑\n            la, ld = parts[0], parts[1]\n            old, path = toks[i], toks[i + 1]\n            i += 2\n_ROLE_VALUES = (\"frontend\", \"backend\", \"none\")\n_ROLE_LABEL = {\"frontend\": \"前端\", \"backend\": \"後端\"}\n_ROLE_FRONT_EXTS = {\"vue\", \"svelte\", \"tsx\", \"jsx\", \"css\", \"scss\", \"html\"}   # 現在沒有題組鍵的前端檔\n_ROLE_BACK_KEYS = {\"node\", \"cs\", \"py\", \"sql\"}\n_ROLE_MOBILE_EXTS = {\"kt\", \"java\", \"swift\", \"dart\"}\n# 手機畫面判定只看匯入,名單刻意窄:androidx 底下的 room/work/datastore、android.content 這些資料層也常匯入,\n# 寬名單會把 DAO、Repository 判成畫面(設計審 r1 正確性席 F1)。\n_ROLE_UI_IMPORT = {\n    \"kt\": re.compile(r\"^\\s*import\\s+(?:androidx\\.compose|android\\.widget|android\\.view|androidx\\.recyclerview|androidx\\.fragment|androidx\\.activity|androidx\\.appcompat)\\.\", re.M),\n    \"swift\": re.compile(r\"^\\s*import\\s+SwiftUI\\b\", re.M),\n    \"dart\": re.compile(r\"\"\"^\\s*import\\s+['\"]package:flutter/(?:material|widgets|cupertino)\\.dart['\"]\"\"\", re.M),\n}\n_ROLE_UI_IMPORT[\"java\"] = _ROLE_UI_IMPORT[\"kt\"]\n_ROLE_ANDROID_IMPORT = re.compile(r\"^\\s*import\\s+(?:android|androidx)\\.\", re.M)\n_ROLE_UIKIT_IMPORT = re.compile(r\"^\\s*import\\s+UIKit\\b\", re.M)\n_ROLE_UIKIT_SUBCLASS = re.compile(r\"\\bclass\\s+\\w+\\s*:[^{\\n]*\\bUI\\w*(?:ViewController|View)\\b\")\n_ROLE_READ_CAP = 300     # 最多讀幾支檔的內容(數檔,不數往上找 package.json 的候選);超過的只看副檔名(手機檔判不出)\n_ROLE_MAX_BYTES = 512 * 1024   # 單支檔超過這個大小不讀內容(判不出);上限交給批次讀取那一層守\n_ROLE_BUDGET = 3.0       # 角色計算自己最多幾秒\n_ROLE_BUDGET_FLOOR = 1.0  # 期限很短時角色至少拿這麼多(消費專案光算工具檔清單就要半秒,代碼審 r1 正確性 F2)\n\n\ndef _role_budget(deadline):\n    \"\"\"派工時角色計算能用幾秒:最多 _ROLE_BUDGET、至少 _ROLE_BUDGET_FLOOR,平常取期限的三分之一。\"\"\"\n    if not deadline or deadline <= 0:\n        return _ROLE_BUDGET\n    return min(_ROLE_BUDGET, max(_ROLE_BUDGET_FLOOR, deadline / 3))\n\n\ndef _review_roles_config(data, unreadable=False):\n    \"\"\"data=改動起點那個版本的 .lumos/config.json 內容(_json_at_ref 讀的;None=沒有這個檔);unreadable=檔案在但讀不懂。\n    回 (rules, warnings),rules=[(樣式, 角色)]。★壞宣告整份不用★、退回不宣告的判定並回一句警告(做法照 _stack_questions_config)。\n    ★警告只寫第幾條與固定原因,不回填專案寫的值★——角色段放在框外,回填等於讓被審專案往指令區塞字(代碼審 r1 兩席)。\n    讀起點版本的理由同派工鏡頭「圖譜只信起點」:被審的分支不能自己改宣告決定自己拿到哪張卡。\"\"\"\n    if unreadable:\n        return [], [\".lumos/config.json 讀不懂,review_roles 這次不用\"]\n    v = data.get(\"review_roles\") if isinstance(data, dict) else None\n    if v is None:\n        return [], []\n    shape = \"要是清單,每條 {\\\"path\\\": 路徑樣式, \\\"role\\\": frontend|backend|none}\"\n    if not isinstance(v, list):\n        return [], [f\"review_roles {shape};這次整份不用\"]\n    rules = []\n    for i, item in enumerate(v, 1):\n        if not isinstance(item, dict) or set(item) != {\"path\", \"role\"}:\n            return [], [f\"review_roles 第 {i} 條形狀不對({shape});這次整份不用\"]\n        pat, role = item[\"path\"], item[\"role\"]\n        if role not in _ROLE_VALUES:\n            return [], [f\"review_roles 第 {i} 條的 role 不合法(只認 {'/'.join(_ROLE_VALUES)});這次整份不用\"]\n        if not isinstance(pat, str) or not pat.strip() or pat.startswith((\"./\", \"/\")) or \"\\\\\" in pat:\n            return [], [f\"review_roles 第 {i} 條的 path 不合法(不能空白、不能以 ./ 或 / 開頭、不能有反斜線);這次整份不用\"]\n        rules.append((pat, role))\n    return rules, []\n\n\ndef _review_role_for(file_rel, repo_root, rules=(), reader=None, content=None):\n    \"\"\"一支改動檔的審查角色:\"frontend\" / \"backend\" / None(判不出就不附,不猜)。依序:\n    專案宣告(第一條命中的算數)→ 現在沒有題組鍵的前端副檔名 → 手機檔看匯入 → 題組鍵(.ts/.js 走 package.json)。\n    建立在 _stack_key_for_file 上,不另造一套分類(設計審 r1 架構對齊席 F2)。\n    reader:讀指定版本的 package.json(見 _node_flavor);content:手機檔的內容,None=沒讀(超過上限)→ 判不出。\"\"\"\n    if rules:\n        i = _glob_first_match(file_rel, [p for p, _ in rules])\n        if i is not None:\n            return None if rules[i][1] == \"none\" else rules[i][1]\n    ext = Path(file_rel).suffix.lstrip(\".\").lower()\n    if ext in _ROLE_FRONT_EXTS:\n        return \"frontend\"\n    if ext in _ROLE_MOBILE_EXTS:\n        if content is None:\n            return None\n        if _ROLE_UI_IMPORT[ext].search(content):\n            return \"frontend\"\n        if ext == \"swift\" and _ROLE_UIKIT_IMPORT.search(content) and _ROLE_UIKIT_SUBCLASS.search(content):\n            return \"frontend\"\n        if ext == \"java\" and not _ROLE_ANDROID_IMPORT.search(content):\n            return \"backend\"    # Java 後端服務常見;Android 純 Java 資料類也會落在這裡(已知限制,出路是宣告)\n        return None\n    key = _stack_key_for_file(file_rel, repo_root, reader=reader)\n    if key == \"vue\":\n        return \"frontend\"\n    return \"backend\" if key in _ROLE_BACK_KEYS else None\n\n\ndef _review_role_changed_files(root, base, head, deadline=None):\n    \"\"\"角色鏡頭的改動檔清單:[(路徑, 讀內容用的版本)]。派工角色段與推送前分級那一行共用這一支。\n    一般改名算新路徑；跨到被排除的簿記終點另保留舊程式、讀起點版本。\n    刪除的檔照樣算、讀起點版本。剔除測試檔(_PITFALL_DIFF_TEST_PAT)、消費專案裡原封不動的工具檔\n    (_vendored_skip)、文件與帳檔(_impact_diff_seed_ok)。git 跑不起來回 None。\"\"\"\n    r = _lens_git(root, \"diff\", \"--no-ext-diff\", \"--name-status\", \"-M\", \"-z\", base, head)\n    if r is None or r.returncode != 0:\n        return None\n    toks = r.stdout.split(\"\\0\")\n    skip = _vendored_skip(root, f\"{base}..{head}\")\n    out, renamed, i = [], [], 0\n    while i < len(toks) and toks[i]:\n        st = toks[i]\n        if st[:1] in (\"R\", \"C\"):\n            if st[:1] == \"R\":\n                renamed.append((toks[i + 1], toks[i + 2]))\n            path, ref, i = toks[i + 2], head, i + 3\n        else:\n            path, ref, i = toks[i + 1], (base if st[:1] == \"D\" else head), i + 2\n        out.append((path, ref))\n    modes = _impact_diff_modes(root, [path for path, _ref in out] + [old for old, _new in renamed],\n                               base, head, deadline=deadline)\n    if modes is None:\n        return None\n    # 一般改名仍取新路徑；只有簿記終點被排除時，不能把舊程式刪除一起藏掉。\n    out += [(old, base) for old, new in renamed if new.startswith(_BOOKKEEPING_DIRS)\n            and not _impact_diff_seed_ok(new, *modes.get(new, (None, None)))\n            and _impact_diff_seed_ok(old, *modes.get(old, (None, None)))]\n    return [(path, ref) for path, ref in out\n            if not _PITFALL_DIFF_TEST_PAT.search(path)\n            and _impact_diff_seed_ok(path, *modes.get(path, (None, None))) and path not in skip]\n\n\ndef _review_roles(root, base, head, budget=_ROLE_BUDGET):\n    \"\"\"算這段改動每支檔的角色。回 {\"roles\": {路徑: 角色|None}, \"counts\": {...}, \"warnings\": [...], \"capped\": N, \"timed_out\": bool};\n    git 讀不到改動清單回 None。成本:內容一次批次讀取(_nodehome_cat_blobs),最多讀 _ROLE_READ_CAP 支,整體受 budget 秒限制。\"\"\"\n    import time as _t\n    if budget <= 0:\n        return {\"roles\": {}, \"counts\": {\"frontend\": 0, \"backend\": 0, \"unknown\": 0},\n                \"warnings\": [], \"capped\": 0, \"timed_out\": True}\n    t0 = _t.monotonic()\n    cfg = _json_at_ref(root, base, \".lumos/config.json\")\n    _cfg_there = cfg is None and _lens_git(root, \"cat-file\", \"-e\", f\"{base}:.lumos/config.json\")\n    rules, warnings = _review_roles_config(cfg, unreadable=bool(_cfg_there and _cfg_there.returncode == 0))\n    files = _review_role_changed_files(root, base, head, deadline=t0 + budget)\n    if files is None:\n        return None\n    want, capped = _review_role_wanted(files, rules)\n    blobs = {}\n    left = budget - (_t.monotonic() - t0)\n    timed_out = left <= 0\n    if want and left > 0.2:\n        got = _nodehome_cat_blobs_capped(root, want, _ROLE_MAX_BYTES, timeout=left)\n        if got is None:\n            timed_out = True\n        else:\n            blobs = {k: (v.decode(\"utf-8\", \"replace\") if v is not None else None) for k, v in zip(want, got)}\n    elif want:\n        timed_out = True\n    roles = {}\n    for p, ref in files:\n        content = blobs.get(f\"{ref}:{p}\")\n        roles[p] = _review_role_for(p, root, rules, reader=lambda rel, _r=ref: blobs.get(f\"{_r}:{rel}\"), content=content)\n    counts = {\"frontend\": sum(1 for v in roles.values() if v == \"frontend\"),\n              \"backend\": sum(1 for v in roles.values() if v == \"backend\"),\n              \"unknown\": sum(1 for v in roles.values() if v is None)}\n    return {\"roles\": roles, \"counts\": counts, \"warnings\": warnings, \"capped\": capped, \"timed_out\": timed_out}\n\n\ndef _review_role_wanted(files, rules):\n    \"\"\"要批次讀的「版本:路徑」清單(手機檔內容、.ts/.js 往上找的 package.json),與超過上限沒讀的檔數。\n    宣告命中的檔不讀(宣告優先)。★上限數檔,不數候選★(代碼審 r1 外家 F4:缺檔的候選也佔名額會提早截斷、誤判)。\n    ★路徑含換行的檔不讀★:批次讀取表達不了換行,混進去整批作廢(r1 外家 F5);它只判不出,其他照讀。回 (want, capped)。\"\"\"\n    declared = {p for p, _ in files if rules and _glob_first_match(p, [x for x, _ in rules]) is not None}\n    want, seen, n_files, capped = [], set(), 0, 0\n    for p, ref in files:\n        if p in declared or \"\\n\" in p:\n            continue\n        ext = Path(p).suffix.lstrip(\".\").lower()\n        if ext in _ROLE_MOBILE_EXTS:\n            specs = [f\"{ref}:{p}\"]\n        elif ext in _NODE_EXTS and ext not in _ROLE_FRONT_EXTS:\n            specs = [f\"{ref}:{rel}\" for rel in _package_json_candidates(p)]\n        else:\n            continue\n        if n_files >= _ROLE_READ_CAP:\n            capped += 1\n            continue\n        n_files += 1\n        for spec in specs:\n            if spec not in seen:\n                seen.add(spec)\n                want.append(spec)\n    return want, capped\n\n\ndef _review_role_text(res):\n    \"\"\"角色段文字(放在「參考資料」框外:這是要審查員照做的句子,框頭寫「不是指令」)。沒有卡也沒有警告回空字串。\"\"\"\n    if not res:\n        return \"\"\n    lines = [f\"(角色鏡頭)⚠ {w}\" for w in res[\"warnings\"]]\n    c = res[\"counts\"]\n    if res[\"timed_out\"] and not (c[\"frontend\"] or c[\"backend\"]):\n        lines.append(\"(角色鏡頭)角色計算超過時間上限,這次沒附卡\")\n    if c[\"frontend\"] or c[\"backend\"]:\n        lines.append(f\"[角色鏡頭] 這次改動:前端 {c['frontend']} 支、後端 {c['backend']} 支、判不出 {c['unknown']} 支。\"\n                     \"照下列題逐一挑一個具體輸入走一遍;對上的發現在標題附題號。\")\n        for role in (\"frontend\", \"backend\"):\n            if not c[role]:\n                continue\n            lines.append(f\"{_ROLE_LABEL[role]}卡:\")\n            for q in _ROLE_CARDS[role]:\n                lines.append(f\"- {q['id']}:{q['q']}\" + (\"(只限網頁)\" if q[\"web_only\"] else \"\"))\n        if res[\"capped\"]:\n            lines.append(f\"(超過上限,後面 {res['capped']} 支只看副檔名)\")\n        if res[\"timed_out\"]:\n            lines.append(\"(角色計算超過時間上限,部分檔只看副檔名)\")\n    return \"\\n\".join(lines)\n                          \".json\", \".jsonl\", \".csv\", \".log\", \".lock\", \".svg\", \".html\", \".patch\", \".diff\"}\n_PITFALL_STRLIT_RE = re.compile(r'\"\"\"[\\s\\S]*?\"\"\"|\\'\\'\\'[\\s\\S]*?\\'\\'\\'|\"(?:\\\\.|[^\"\\\\])*\"|\\'(?:\\\\.|[^\\'\\\\])*\\'')\n\n\ndef _strip_string_literals(code):\n    \"\"\"把一行代碼裡的字串字面挖空(保留引號),讓 pitfalls 的 open(/UPDATE 正則只看真代碼——\n    print(\"…open(…\") 這種訊息文字不算資源風險(#7)。單行粗剝,跨行字串不處理(剝不掉就照掃,寧誤傷不漏)。\"\"\"\n    return _PITFALL_STRLIT_RE.sub('\"\"', code)\n\n# 簿記檔白名單(單一源,兩個消費者:pitfalls --diff 掃描排除 + code-loop 留痕失效豁免)。\n# 兩處分開寫過會漂移;pitfalls 這端 2026-08-11 才補上——治理帳裡記的 skip 理由本身在\n# 描述「命中 open(...)」,被當代碼掃就再次命中 → 再 skip → 再寫一行理由……自我餵食,\n# 實測誤觸發 9 次。這些檔是紀錄不是要合入的碼。\n_BOOKKEEPING_FILES = (\"docs/.governance-log.jsonl\", \"docs/.usage-log.jsonl\",\n                      # 本機帳(被忽略)萬一被 git add -A 提交,也只是簿記、不讓代碼審留痕失效(治理帳例行紀錄分流_計劃)\n                      \"docs/\" + GOV_LOCAL_LOG_NAME, \"docs/\" + USAGE_LOCAL_LOG_NAME,\n                      \"docs/.ci-log.jsonl\", \"docs/.canary-log.jsonl\",\n                      \"docs/.bypass-log.jsonl\", \"docs/.escape-log.jsonl\",\n                      \"docs/.kill-log.jsonl\", \"docs/.signoff-log.jsonl\",\n                      \"governance/anchor-baseline.json\",\n                      # 存量漂移守衛的表態檔:跟判定檔一樣是人對發現的回應,不是程式改動(存量漂移防線 [S3])\n                      \"governance/drift-acks.jsonl\",\n                      # 存量漂移的修復帳(drift fix 每改一筆記一行稽核紀錄;同表態檔,是人對發現的處理紀錄;存量漂移改法 第 7 節)\n                      \"governance/drift-fixes.jsonl\")\n# ↑ canary-log/bypass-log 2026-08-27 補（[[Issues/簿記白名單漏canary與bypass帳]] 死結根治）:\n# 審計記帳(canary record)在 loop 中發生,pass 後提交它們原本會讓留痕失效→擋推。\n# ★真效果只在 code-loop 留痕豁免這第二消費者★:pitfalls 那端 canary-log 早被\n# _PITFALL_DIFF_SKIP_EXT(.json/.jsonl,2026-08-22)按副檔名擋掉、輪不到白名單這關(s1-f1)。\n# ↑ kill-log/signoff-log 2026-09-06 補([[Projects/全repo審視_計劃]] #5):兩本同樣是工具自己\n# 寫的 append-only 帳(kill-log 由 guard kill 寫、signoff-log 由 signoff 寫),而這次替\n# _pull_source_or_abort 加「來源只髒簿記帳就聯集合併不擋人」時,漏了它們就等於那條路對這兩本\n# 失效——有人在來源 clone 跑過 guard kill 或 signoff,更新照樣被擋。\n_BOOKKEEPING_DIRS = (\"governance/code-loop/\", \"governance/review-reports/\", \"governance/replay/\",\n                     \"governance/note-verdicts/\",   # 2026-09-17 小改動閘 r2:卷證目錄也是紀錄不是碼(三個消費者共用這一組)\n                     # 2026-10-01 回頭重讀的對照紀錄:理由同筆記內容審判定檔——紀錄不是碼,提交它不該讓代碼審留痕失效\n                     # (Projects/守檔筆記對照改動_計劃 [S8];整案回退時要同一個 revert 提交裡 git rm -r 這個資料夾)\n                     \"governance/reread-verdicts/\")\n_PITFALL_DIFF_TEST_PAT = re.compile(r\"(test_|_test\\.|\\.spec\\.|/tests?/)\", re.I)\nLINT_CMD_TIMEOUT = 180\n\n\ndef _diff_added_lines(diff_text):\n    \"\"\"從 git diff -U3 輸出建 {file: set(new_line_numbers)} 對應所有新增行(+ 開頭)。\n    使用與 _pitfall_diff_mode 相同的 @@ 標頭推導邏輯。\"\"\"\n    added = {}\n    cur_file, new_ln = \"\", 0\n    for line in diff_text.splitlines():\n        if line.startswith(\"+++ b/\"):\n            cur_file = line[6:]\n            continue\n        m = re.match(r\"@@ -\\d+(?:,\\d+)? \\+(\\d+)\", line)\n        if m:\n            new_ln = int(m.group(1))\n            continue\n        if line.startswith(\"+++\") or line.startswith(\"---\"):\n            continue\n        return False\n    ext, top = \".\" + e, parts[0]\n    for suf, exts in sufs.items():\n        if ext not in exts or not top.endswith(suf):\n            continue\n        base = top[:-len(suf)].rstrip(\".\")\n        if not base or ext in top_exts.get(base, ()):\n            return True\n    for i in range(1, len(parts) - 1):\n        if parts[i - 1] == \"src\" and ext in under_src.get(parts[i], ()) and ext in main_exts.get(\"/\".join(parts[:i]), ()):\n            return True\n    return False\n\n\ndef _nodehome_is_test(path, layout=({}, {})):\n    \"\"\"測試檔判定:先問測試地圖那一支;再認各棧的測試資料夾(2026-09-12:平板 POS 測試資料夾裡的輔助檔、\n    Android 儀器測試的 Kotlin 檔都被要求有家——測試地圖的規格刻意只認 test/tests 資料夾與檔名,不動它);\n    副檔名不在測試地圖清單裡的(shell、Go、Rust、C…),套它同一組目錄與檔名規則。layout 見 _nodehome_in_stack_test_dir。\"\"\"\n    global _TESTMAP_DIR_RE\n    if _testmap_is_test(path):\n        return True\n    if _nodehome_in_stack_test_dir(path, layout):\n        return True\n    if _testmap_ext(path) in _TESTMAP_EXTS:\n        return False                      # 測試地圖認得這種副檔名,它說不是就不是\n    if _TESTMAP_DIR_RE is None:\n        _TESTMAP_DIR_RE = re.compile(r\"(^|/)(tests?|__tests__|specs?)/\", re.IGNORECASE)\n    if _TESTMAP_DIR_RE.search(path):\n        return True\n    name = path.rsplit(\"/\", 1)[-1]\n    stem = _testmap_stem(path)\n    return (\".spec.\" in name or \".test.\" in name or stem.startswith(\"test_\")\n            or stem.lower().endswith((\"_tests\", \"_specs\", \"_test\", \"_spec\")))   # 底線變體同測試地圖(Go 的 foo_test.go)\n\n\ndef _nodehome_code_kind(path):\n    \"\"\"回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。\n    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。\"\"\"\n    base = path.rsplit(\"/\", 1)[-1]\n    stripped = base.lstrip(\".\")\n    if \".\" in stripped:\n        return \"ext\" if (\".\" + stripped.rsplit(\".\", 1)[1]) in _NODEHOME_CODE_EXTS else None\n    return \"shebang?\"\n\n\nclass _NodehomeSide:\n    \"\"\"一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);\n    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);\n    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。\n    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。\"\"\"\n    __slots__ = (\"files\", \"all_paths\", \"notes\", \"where\", \"_reader\", \"shebang\", \"share\", \"changed\")\n\n\ndef _nodehome_git(repo_root, *args):\n    \"\"\"跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。\"\"\"\n    r = _lens_git(repo_root, *args, binary=True)\n    if r is None or r.returncode != 0:\n        return None\n    return r.stdout\n\n\ndef _nodehome_show(path):\n    \"\"\"路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。\"\"\"\n    return os.fsencode(path).decode(\"utf-8\", errors=\"replace\") if isinstance(path, str) else str(path)\n\n\ndef _nodehome_split_z(raw):\n    return [os.fsdecode(x) for x in raw.split(b\"\\0\") if x]\n\n\ndef _nodehome_list(repo_root, where, oids=None):\n    \"\"\"where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。\n    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。\n    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。\"\"\"\n    if where is None:\n        return {}, []\n    raw = _nodehome_git(repo_root, \"ls-files\", \"-s\", \"-z\") if where == \"index\" else \\\n        _nodehome_git(repo_root, \"ls-tree\", \"-r\", \"-z\", \"--full-tree\", where)\n    if raw is None:\n        return None\n    files, allp = {}, []\n\n    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):\n    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記\n    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突\n    或順手多改的部分,正是這道檢查要看的。\n    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,\n    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。\n    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。\n    \"\"\"\n    drv = _lens_git(repo_root, \"config\", \"--get-regexp\", r\"^merge\\..*\\.driver$\", binary=True)\n    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險\n        return None\n    r = _nodehome_git(repo_root, \"show\", \"--remerge-diff\", \"--no-ext-diff\", \"--no-textconv\", \"--format=\",\n                      \"--name-status\", \"-z\", \"-M\", sha)\n    if r is None:\n        return None\n    paths, src, gone = _nodehome_name_status(r)\n    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,\n    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,\n    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。\n    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None\n    for p in parents:\n        rr = _nodehome_git(repo_root, \"diff-tree\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", p, sha)\n        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))\n    order = sorted(paths)\n    specs = []\n    for x in order:\n        specs.append(f\"{sha}:{x}\")\n        specs += [f\"{p}:{x if ren is None else ren.get(x, x)}\" for p, ren in pairs]\n    blobs = _nodehome_cat_blobs(repo_root, specs)\n    if blobs is None or any(ren is None for _, ren in pairs):\n        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)\n        return paths, src, gone\n    kept = set()\n    for n, x in enumerate(order):\n        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]\n        if _nodehome_merge_wrote_new_lines(merged, olds):\n            kept.add(x)\n    return kept, {k: v for k, v in src.items() if k in kept}, gone\n\n\ndef _nodehome_cat_sizes(repo_root, specs, timeout=60):\n    \"\"\"同 _nodehome_cat_blobs 的批次讀取,只問大小(cat-file --batch-check):回同順序的 int|None(沒有這個物件=None);git 跑不起來回 None。\"\"\"\n    import subprocess as _sp\n    try:\n        chk = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch-check\"],\n                      input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n                      capture_output=True, timeout=timeout)\n    except (OSError, _sp.TimeoutExpired):\n        return None\n    if chk.returncode != 0:\n        return None\n    heads = chk.stdout.split(b\"\\n\")\n    out = []\n    for i in range(len(specs)):\n        parts = heads[i].split(b\" \") if i < len(heads) else []\n        out.append(int(parts[2]) if len(parts) == 3 and parts[2].isdigit() else None)\n    return out\n\n\ndef _nodehome_cat_blobs_capped(repo_root, specs, max_bytes, timeout=60, max_total_bytes=None, deadline=None):\n    \"\"\"_nodehome_cat_blobs 加大小上限:先用 _nodehome_cat_sizes 問大小,超過 max_bytes 的回 None、不讀進記憶體\n    (角色鏡頭代碼審 r1 外家 F6、r2 架構對齊 F1:上限放在批次讀取這一層,不另起查法)。\n    max_total_bytes 選填，限制整批宣告內容大小；deadline 選填，大小／內容兩趟共用剩餘時間。\n    未指定時保留既有逐物件上限與每趟 timeout 語意。回同順序 bytes|None；失敗或截止期耗盡回 None。\"\"\"\n    import time as _t\n    def left():\n        return timeout if deadline is None else min(timeout, deadline - _t.monotonic())\n    remaining = left()\n    if remaining <= 0:\n        return None\n    sizes = _nodehome_cat_sizes(repo_root, specs, remaining)\n    if sizes is None:\n        return None\n    ok, total = [], 0\n    for i, n in enumerate(sizes):\n        if n is None or n > max_bytes or (max_total_bytes is not None and total + n > max_total_bytes):\n            continue\n        ok.append(i)\n        total += n\n    remaining = left()\n    if remaining <= 0:\n        return None\n    got = _nodehome_cat_blobs(repo_root, [specs[i] for i in ok], timeout=remaining) if ok else []\n    if got is None:\n        return None\n    res = [None] * len(specs)\n    for i, v in zip(ok, got):\n        res[i] = v\n    return res\n\n\ndef _nodehome_cat_blobs(repo_root, specs, timeout=60):\n    \"\"\"一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。\n\n    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,\n    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。\n    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。\"\"\"\n    import subprocess as _sp\n    if not specs:\n        return []\n    if any(\"\\n\" in s_ for s_ in specs):\n        return None\n    try:\n        r = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch\"],\n                    input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n                    capture_output=True, timeout=timeout)\n    except (OSError, _sp.TimeoutExpired):\n        return None\n    if r.returncode != 0:\n        return None\n    out, pos, res = r.stdout, 0, []\n    for _ in specs:\n        nl = out.find(b\"\\n\", pos)\n        if nl < 0:\n            return None\n        head = out[pos:nl].split(b\" \")\n        pos = nl + 1\n        if len(head) == 3 and head[1] == b\"blob\" and head[2].isdigit():\n            size = int(head[2])\n            res.append(out[pos:pos + size])\n                print(f\"  {x['node']}{contract_tag}\")\n        print(f\"── 直接關聯 ({len(all_direct)}) ──\")\n        for x in all_direct:\n            contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n            combo_tag = \"★COMBO★\" if x.get(\"combo\") else \"\"\n            tags = (contract_tag + (\" \" + combo_tag if combo_tag else \"\")).rstrip()\n            print(f\"  {'⚠合約 ' if x.get('contract') else ''}{x['node']}{tags}  ({x['hit']})\")\n        print(f\"── 間接關聯 ({len(all_indirect)}) ──\")\n        for x in all_indirect:\n            cross = \" [跨repo葉,不展開]\" if x.get(\"cross_repo\") else \"\"\n            print(f\"  hop{x['hop']}  {x['node']}  {x['direction']} ← via {x['via']} ← {x['from']}{cross}\")\n        if all_incidents:\n            print(f\"── 相關事故 ({len(all_incidents)}) ──\")\n            for x in all_incidents:\n                contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n                print(f\"  {x['node']}{contract_tag}  (trigger: {x['matched_by']})\")\n\n    return 0\n\n\n_IMPACT_DIFF_SKIP = (\"docs/\", \"governance/golden/\")   # 圖譜/凍結快照非 code,不當 impact 種子\n\n\ndef _impact_diff_seed_ok(f, file_mode=None, shebang=None):\n    \"\"\"--diff 種子過濾:只收 code 檔。剔除圖譜/凍結快照/帳檔(.jsonl)/文檔(.md)/\n    簿記分類沿用 _BOOKKEEPING_FILES/_BOOKKEEPING_DIRS,卷證不是程式;\n    governance 資料 .json(goldset/裁決紀錄內嵌歷史 code 片段,會偽觸發事故 pin——r1 panel 實證)。\"\"\"\n    if not f or any(f.startswith(p) for p in _IMPACT_DIFF_SKIP):\n        return False\n    # 固定帳檔仍排除；目錄內的程式例外先成立，不再被文檔副檔名二次排掉。\n    if f in _BOOKKEEPING_FILES:\n        return False\n    if f.startswith(_BOOKKEEPING_DIRS):\n        kind = _nodehome_code_kind(f)\n        if file_mode == \"100755\" or kind == \"ext\":\n            return True\n        if kind == \"shebang?\":\n            return shebang is not False  # 超過上限／讀不到時沿既有保守判法。\n        return file_mode is None\n    if f.endswith((\".jsonl\", \".md\")):\n        return False\n    if f.endswith(\".json\") and f.startswith(\"governance/\"):\n        return False\n    return True\n\n\ndef _impact_diff_raw(repo_root, diff_args, deadline):\n    \"\"\"分類的 raw 讀取；截止期耗盡回空資料保留未知，其他失敗回 None。\"\"\"\n    import time as _t\n    args = (\"diff\", \"--no-ext-diff\", \"--no-textconv\", \"--raw\", \"--no-renames\", \"--no-abbrev\", \"-z\", *diff_args)\n    if deadline is None:\n        raw = _nodehome_git(repo_root, *args)\n    else:\n        left = min(_disp_git_timeout(), deadline - _t.monotonic())\n        if left <= 0:\n            return b\"\"  # 未知模式，不把它當附件排除。\n        r = _lens_git(repo_root, *args, binary=True, timeout=left)\n        raw = r.stdout if r is not None and r.returncode == 0 else None\n        if raw is None and _t.monotonic() >= deadline:\n            return b\"\"\n    return raw\n\n\ndef _impact_diff_modes(repo_root, files, *diff_args, deadline=None):\n    \"\"\"簿記來源取凍結模式與首行；普通來源不多查 Git。刪檔取舊物件。\"\"\"\n    if not any(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):\n        return {}\n    import time as _t\n    raw = _impact_diff_raw(repo_root, diff_args, deadline)\n    changes = _codeloop_raw_changes(raw) if raw is not None else None\n    if changes is None:\n        return None\n    out, ask = {}, []\n    for f, (old, new, old_oid, new_oid) in changes.items():\n        mode, oid = (old, old_oid) if new == \"000000\" else (new, new_oid)\n        out[f] = (mode, None)\n        if (f.startswith(_BOOKKEEPING_DIRS) and mode != \"100755\"\n                and _nodehome_code_kind(f) == \"shebang?\" and not _path_special_chars(f, surrogate=False)\n                and oid.strip(\"0\") and len(ask) < _ROLE_READ_CAP):\n            ask.append((f, oid))\n    if ask:\n        left = _disp_git_timeout() if deadline is None else min(_disp_git_timeout(), deadline - _t.monotonic())\n        if left <= 0:\n            return out\n        heads = _nodehome_cat_blobs_capped(repo_root, [oid for _f, oid in ask],\n                                          _CODELOOP_BOOKKEEPING_HEAD_CAP, timeout=left,\n                                          max_total_bytes=_CODELOOP_BOOKKEEPING_HEAD_CAP, deadline=deadline)\n        if heads is not None:\n            for (f, _oid), head in zip(ask, heads):\n                out[f] = (out[f][0], True if head is None else _head_is_shebang(head, lenient=True))\n    return out\n\n\ndef _impact_payload_read(path):\n    \"\"\"讀一份已經算好的波及結果(pre-push 每次推送只算一次,兩個消費者共用同一份)。\n\n    ★為什麼要有這支★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):\n    推送關卡本來就對每個 ref 跑一次完整的波及計算(同步點名用)。合約測試閘要的是\n    同一份東西裡「帶合約而且綁了測試」的那幾篇——★再算一次就是把一次推送算兩次★,\n    而那正是這一案 r1 拿來否決原設計的那個成本(那條裁定後來被查出已作廢,\n    但「不要算兩次」本身仍然是對的)。\n\n    ★失敗要隔離★:讀不到就回 None,呼叫端各自決定怎麼降級——\n    同步點名維持靜默,合約測試閘記一筆帳放行。一個失敗不准拖垮另一個。\n    \"\"\"\n    import json as _json, stat as _stat\n    # ★擁有權要驗,理由跟 dispatch-lens 那支快取一模一樣★\n    # (2026-09-07 代碼審 r1 架構對齊席判 blocking,說得對):\n    # 這個 repo 已經有一套硬化過的「算一次、之後讀」——_lens_cache_read,\n    # 它會先驗 st_uid 與 group/other 可不可寫,註解明寫「$TMPDIR 路徑可預測可偽造」。\n    # 而這裡收的正是一個從命令列傳進來的 $TMPDIR 路徑,同一種曝險。\n    # ★但沒有照抄整套★,理由是生命週期不同,而這一點原本沒寫下來所以席位抓到了:\n    #   dispatch-lens 那支是「跨呼叫、可被別人發現、要 TTL、要 key 去對」的快取;\n    #   這裡是「同一次 hook 執行內、由呼叫端明確指定路徑、用完就刪」的交接。\n    #   要 TTL 與 key 是多餘的,要擁有權驗證則是必要的——所以只借那一半。\n    try:\n        st = Path(path).stat()\n        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):\n            return None\n        data = _json.loads(Path(path).read_text(encoding=\"utf-8\"))\n    except Exception:\n        return None\n    # ★形狀要驗到位★(代碼審 r1 外家否決席判 major):只驗「是 dict 而且有 results」不夠——\n    # `{\"results\":[1],\"sync\":[]}` 這種合法 JSON 會通過,然後在下游 r.get(...) 當場拋例外,\n    # 而那個例外會被 pre-push 的 || true 吞掉:★不是按設計記 range-unavailable,是靜默失效★。\n    if not isinstance(data, dict):\n        return None\n    res = data.get(\"results\")\n    if not isinstance(res, list) or any(not isinstance(r, dict) for r in res):\n        return None\n    sync = data.get(\"sync\")\n    if sync is not None and not (isinstance(sync, dict)\n                                 and isinstance(sync.get(\"missing\"), list)\n                                 and isinstance(sync.get(\"touched_nodes\"), list)):\n        return None\n    return data\n\n\ndef cmd_impact_diff(diff_range, repo=None, depth=None, top=8, min_score=0.20, as_json=False,\n                    sync_check=False, sync_only=False, from_json=None):\n    \"\"\"code-loop 橋接:對整段 diff 的每支改動 code 檔跑 ranked impact(query=該檔 hunk 文字),\n    聚合成「受影響功能面」manifest——固定席(合約/事故)全保、非固定取跨檔最高分 top-N。\n    定位=審計員鏡頭(advisory,人判),非自動推播(hook 面 goldset 評測未過線,故不接 hook)。\n    rc: 0=成功 / 2=git 失敗 / 3=vault 缺。\n\n    from_json:吃一份已經算好的結果,不自己算(見 _impact_payload_read)。目前只支援\n    搭 --sync-only 用——推送關卡算一次、同步點名與合約測試閘各讀一次。\"\"\"\n    if from_json is not None:\n        _pl = _impact_payload_read(from_json)\n        if _pl is None or _pl.get(\"sync\") is None:\n            return 0          # 失敗隔離:維持同步點名現在的行為(靜默)\n        _print_sync_nudge(_pl[\"sync\"], _pl.get(\"range\") or diff_range)\n        return 0\n    import json as _json\n    import subprocess as _sp\n    if diff_range == \"staged\":\n        # 圖譜同步覆蓋(2026-08-22):pre-commit 要對「這次 commit 的內容」算波及,用 staged 代替 range\n        diff_range = \"--staged\"\n    elif diff_range.startswith(\"-\"):\n        # 同 pitfalls/cochange-check:'-' 開頭值會被 git 誤認成選項,查詢命令 rc2 拒收\n        print(\"擋下:--diff 的值不能用 - 開頭(會被當成選項)\", file=sys.stderr)\n        return 2\n    repo_root = Path(repo) if repo else None\n    if repo_root is None:\n        for cand in (Path.cwd(), *Path.cwd().parents):\n            if (cand / \".git\").exists():\n                repo_root = cand\n                break\n    if repo_root is None or not (repo_root / \".git\").exists():\n        print(\"擋下:找不到 git 專案,用 --repo 指定\", file=sys.stderr)\n        return 2\n    # NUL 分隔且無損解碼，特殊檔名不能被引號化／拆行；改名兩側與 raw 判法一致。\n    r = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n                 \"diff\", \"--name-only\", \"--no-renames\", \"-z\", diff_range], capture_output=True)\n    if r.returncode != 0:\n        print(f\"擋下:git 算不出差異: {r.stderr.decode('utf-8', 'replace').strip()[:200]}\", file=sys.stderr)\n        return 2\n    candidates = [os.fsdecode(f) for f in r.stdout.split(b\"\\0\") if f]\n    modes = _impact_diff_modes(repo_root, candidates, diff_range)\n    if modes is None:\n        print(\"擋下:git 算不出差異檔案模式\", file=sys.stderr)\n        return 2\n    files = []\n    for f in candidates:\n        if not _impact_diff_seed_ok(f, *modes.get(f, (None, None))):\n            continue\n        # 已刪檔不跳過:反查靠「節點 body 引用該路徑」而非檔案存在——\n        # 刪除/改名正是合約節點最該被推到審計員眼前的時刻(r1 codex major)\n        files.append(f)\n    merged = {}          # node -> entry(跨檔取最高分;pinned 任一檔 pinned 即 pinned)\n    per_file_meta = []\n    import io, contextlib\n    _vault = _vault_in(repo_root)\n    # ★沒有圖譜就直接說,不要印「0 篇」裝作查過了★(2026-09-07 全 repo 審視 #9)\n    #\n    # 出身:這條路原本只在**逐檔迴圈裡**才發現沒圖譜——而「這個範圍 0 個檔」時迴圈根本不跑,\n    # 於是一路走到最後印出「固定席 0 + top 0」並回成功。\n    # ★對新手最危險的就是這個★:同一件事(找不到圖譜),另外兩種問法一個回 rc3、一個回 rc2\n    # 並印白話擋下,只有這條印「0 篇」**看起來像查過了**——而它根本沒有圖譜可查。\n    # 文件本來就寫著這條路會回「圖譜缺」,只是零檔時走不到。\n    if _vault is None:\n        return _no_vault_msg()\n    _env_shared = Env(_vault)   # 建一次,逐檔復用(r1 N+1)\n    for f in files:\n        d = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n                     \"diff\", \"--no-ext-diff\", \"--no-textconv\", diff_range, \"--\", f], capture_output=True, text=True, errors=\"replace\")\n        hunk = \" \".join(l[1:].strip() for l in d.stdout.splitlines()\n                        if l[:1] in \"+-\" and not l.startswith((\"+++\", \"---\")))[:4000]\n        buf = io.StringIO()\n        with contextlib.redirect_stdout(buf):\n            rc = cmd_impact(f, repo=str(repo_root), depth=depth, as_json=True,\n                            ranked=True, top=top, min_score=min_score,\n                            payload={\"query\": hunk, \"prospective\": {}},\n                            preloaded=(_vault, _env_shared) if _env_shared is not None else None)\n        if rc == 3:\n            print(\"IMPACT-DEBUG: vault 找不到(rc3)\", file=sys.stderr)\n\ndef _codeloop_record_valid_ex(repo_root, rec_sha, marker_sha, timeout=None):\n    \"\"\"同 `_codeloop_record_valid` 的判定,但固定回三元組 (ok, 為什麼, 判不了):判不了=git 逾時、讀不懂 git diff 的輸出、\n    讀不到簿記資料夾裡檔案的內容、或淺 clone 裡找不到那個提交(缺歷史時它可能正是祖先)。算破壞測試背書時,判不了的紀錄不能當無效丟掉\n    (那可能正是一筆 survived)。timeout 給了就用它當每次 git 的上限(算背書時傳剩餘預算)。\"\"\"\n    import subprocess as _sp\n    _to = timeout if timeout is not None else _disp_git_timeout()\n    if not rec_sha:\n        return (False, \"記錄沒有 sha\", False)\n    if rec_sha == marker_sha:\n        return (True, f\"同版本 {marker_sha[:8]}\", False)\n    try:\n        anc = _sp.run([\"git\", \"merge-base\", \"--is-ancestor\", rec_sha, marker_sha],\n                      capture_output=True, text=True, errors=\"replace\", cwd=str(repo_root), timeout=_to)\n        if anc.returncode not in (0, 1):\n            # ★git 回 1 才是「不是祖先」;其他非零是那個提交在這份 repo 裡根本找不到★(代碼審 r1 通才席):\n            # 寫錯的 sha、淺 clone、或物件被清掉。第一版把這種也講成「多半是壓過提交」,給了文不對題的重來指令。\n            return _codeloop_missing_commit(repo_root, rec_sha, _to)\n        if anc.returncode != 0:\n            # ★講出最常見的原因與怎麼重來★(2026-09-22 rtb-production-agent-demo 回報):\n            # 把本機提交壓成一個、或 rebase 之後,內容可以一模一樣,原本記的那個提交卻不再是祖先。\n            # 只丟兩個 sha 的話,人看不出是自己剛做的壓提交造成的,也不知道要重跑哪兩個指令。\n            return (False, (f\"記錄 sha {rec_sha[:8]} 不是目標 {marker_sha[:8]} 的祖先——多半是壓過提交或 rebase 改寫過歷史\"\n                           \"(內容沒變也一樣失效)。重來:表態 `lumos pitfalls --diff <範圍> --dispositions-template --carry`\"\n                           \" 再 `lumos code-loop dispositions <檔>`;審查留痕重跑 `lumos code-loop pass --note \\\"…\\\"`\"), False)\n        # ★--no-renames★:改名偵測只列新路徑,把程式檔改名搬進簿記資料夾(還能順便換副檔名)就看不到「程式檔被刪」;\n        # ★-z★:預設會把中文等檔名加引號印出(core.quotepath),簿記資料夾裡的中文檔名就比不到前綴(回頭重讀代碼審 r1 資安席 F4)\n        # ★--raw★(回頭重讀代碼審 r3 資安席 F2):連兩邊的檔案模式一起拿,簿記資料夾裡可執行的檔要認得出來;路徑清單跟 --name-only 同一份\n        df = _sp.run([\"git\", \"diff\", \"--no-ext-diff\", \"--raw\", \"--no-renames\", \"-z\", rec_sha, marker_sha],\n                     capture_output=True, cwd=str(repo_root), timeout=_to)\n    except _sp.TimeoutExpired:\n        return (False, f\"git 超過 {_to:.0f} 秒沒回(merge-base/diff),判不了有效性\", True)\n    modes = _codeloop_raw_modes(df.stdout) if df.returncode == 0 else None\n    if modes is None:\n        return (False, f\"讀不懂 git diff {rec_sha[:8]}..{marker_sha[:8]} 的輸出,判不了是不是純簿記增量\", True)\n    files = list(modes)\n    # 簿記資料夾底下的程式檔不算簿記(只改這一個消費者;小改動閘、風險掃描、推送前測試範圍、來源髒檔合併照舊只看前綴)\n    if all(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):\n        _code = _codeloop_bookkeeping_code(repo_root, rec_sha, marker_sha,\n                                           {f: m_ for f, m_ in modes.items() if f not in _BOOKKEEPING_FILES},\n                                           timeout=_to, unknown=None)\n        if _code is None:\n            return (False, f\"讀不到簿記資料夾裡檔案的內容,判不了 {rec_sha[:8]} 之後是不是純簿記增量\", True)\n        if not _code:\n            return (True, f\"祖先 {rec_sha[:8]}+簿記豁免(其後 {len(files)} 檔皆簿記)\", False)\n    return (False, f\"記錄 sha {rec_sha[:8]} 之後動了代碼(非純簿記增量)\", False)\n\n\ndef _codeloop_raw_changes(out):\n    \"\"\"git diff --raw -z(不偵測改名)的輸出 → {路徑: (舊模式, 新模式, 舊物件, 新物件)};模式是 \"100644\" 這種字串,\n    那一版沒有這支檔是 \"000000\"。格式對不上回 None(呼叫端當判不了)。路徑用無損解碼。\"\"\"\n    parts = out.split(b\"\\0\")\n    res, i = {}, 0\n    while i < len(parts) and parts[i]:\n        meta = parts[i]\n        if i + 1 >= len(parts) or not meta.startswith(b\":\"):\n            return None\n        fields = meta[1:].split(b\" \")\n        if len(fields) < 5 or not parts[i + 1]:\n            return None\n        res[os.fsdecode(parts[i + 1])] = tuple(v.decode(\"ascii\", \"replace\") for v in fields[:4])\n        i += 2\n    return res\n\n\ndef _codeloop_raw_modes(out):\n    \"\"\"既有留痕消費者只取模式；模式與首行消費者共用同一個 raw 解析器。\"\"\"\n    changes = _codeloop_raw_changes(out)\n    return None if changes is None else {f: row[:2] for f, row in changes.items()}\n\n\n# 留痕有效性讀簿記資料夾裡沒副檔名那幾支的首行時,單支的大小上限(回頭重讀代碼審 r3 架構對齊席 F2:走帶上限的批次讀取)。\n# 超過上限讀不到 → 判不了 → 保守當程式檔(留痕失效)。2026-10-01 本 repo 簿記資料夾裡沒副檔名的只有 .weekly-stamp(9 位元組)\n# 與 .rotation-cursor(約 5.6 KB、每輪加一行),離上限很遠。\n_CODELOOP_BOOKKEEPING_HEAD_CAP = 1024 * 1024\n\n\ndef _codeloop_bookkeeping_code(repo_root, rec_sha, marker_sha, files, timeout=None, unknown=True):\n    \"\"\"簿記資料夾底下這幾支裡有沒有程式檔(有就不算簿記)。files={路徑: (記錄那版模式, 目標那版模式)}(_codeloop_raw_modes)。\n    判的是目標提交 marker_sha 裡那一版;那一版刪掉了(模式 000000)就判記錄 rec_sha 那一版。任一條成立就算程式檔:\n    ①那一版的模式是可執行(100755),有沒有副檔名、有沒有寫 #! 都算(回頭重讀代碼審 r3 資安席 F2:沒有可用 #! 的\n      可執行檔,bash 會改用 sh 直接跑它的內容);\n    ②副檔名在清單裡(_nodehome_code_kind,跟每支檔有家同一套);\n    ③沒副檔名、首行是 #!——首行從 git 讀那一版(不讀磁碟,磁碟上可以是別的),判之前先去掉 UTF-8 BOM 與行首空白\n      (_head_is_shebang lenient;#! 在第二行不算,跟每支檔有家同口徑);\n    ④沒副檔名、首行判不了:路徑帶控制字元(_path_special_chars,不算替身字元)——git 的批次讀取會吃掉行尾的 \\r,查「run\\r」\n      拿回的是同目錄另一支「run」(回頭重讀代碼審 r3 資安席 F1,major);超過 _CODELOOP_BOOKKEEPING_HEAD_CAP 或讀不到\n      (子模組、批次讀取失敗)——都保守當程式檔(同 _is_code_file)。\n    代碼審 r2 架構對齊席 F1:第一版只接副檔名那一半,沒副檔名的 #! 腳本搬進簿記資料夾照樣豁免。\"\"\"\n    ask = []\n    for f, (old_mode, new_mode) in files.items():\n        deleted = new_mode == \"000000\"\n        if (old_mode if deleted else new_mode) == \"100755\":\n            return True\n        kind = _nodehome_code_kind(f)\n        if kind == \"ext\":\n            return True\n        if kind == \"shebang?\":\n            if _path_special_chars(f, surrogate=False):\n                return True\n            ask.append(f\"{rec_sha if deleted else marker_sha}:{f}\")\n    if not ask:\n        return False\n    blobs = _nodehome_cat_blobs_capped(repo_root, ask, _CODELOOP_BOOKKEEPING_HEAD_CAP,\n                                       timeout=timeout if timeout is not None else _disp_git_timeout())\n    if blobs is None:\n        return unknown   # 預設保守當程式檔;算破壞測試背書時傳 None,讓呼叫端判「判不了」\n    return any(head is None or _head_is_shebang(head, lenient=True) for head in blobs)\n\n\ndef _disp_git_timeout():\n    \"\"\"單次 git 子程序上限(秒;r1 併發席 f2:20 秒預算只在每題迴圈頂端查,單次 git 卡住預算攔不住)。\n    超時往上拋 subprocess.TimeoutExpired,由每題的例外接手判「無法驗證」(擋,不放行)。\"\"\"\n    try:\n        return max(0.1, float(os.environ.get(\"LUMOS_DISP_GIT_TIMEOUT\", \"8\")))\n    except ValueError:\n        return 8.0\n\n\ndef _git_tree_has(repo_root, at_sha, path):\n    import subprocess as _sp\n    r = _sp.run([\"git\", \"cat-file\", \"-e\", f\"{at_sha}:{path}\"], capture_output=True, text=True, errors=\"replace\", cwd=str(repo_root), timeout=_disp_git_timeout())\n    return r.returncode == 0\n\n\ndef _git_tree_text(repo_root, at_sha, path):\n\nhook: PostToolUse\nhook: PostToolUse Completed\nhook: PreToolUse\nhook: PreToolUse\nhook: PreToolUse\nhook: PreToolUse\nhook: PreToolUse\nhook: PreToolUse Completed\nhook: PreToolUse Completed\nhook: PreToolUse Completed\nhook: PreToolUse Completed\nhook: PreToolUse Completed\nexec\n/bin/zsh -lc \"sed -n '27195,27315p' scripts/lumos\" in /private/tmp/lumos-review-artifact-impact-inputs\nexec\n/bin/zsh -lc \"sed -n '41175,41470p' scripts/lumos\" in /private/tmp/lumos-review-artifact-impact-inputs\nexec\n/bin/zsh -lc \"sed -n '24635,24680p' scripts/lumos\" in /private/tmp/lumos-review-artifact-impact-inputs\nexec\n/bin/zsh -lc \"sed -n '26770,26820p' scripts/lumos\" in /private/tmp/lumos-review-artifact-impact-inputs\nexec\n/bin/zsh -lc \"sed -n '24325,24535p' scripts/lumos\" in /private/tmp/lumos-review-artifact-impact-inputs\n succeeded in 0ms:\n    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險\n        return None\n    r = _nodehome_git(repo_root, \"show\", \"--remerge-diff\", \"--no-ext-diff\", \"--no-textconv\", \"--format=\",\n                      \"--name-status\", \"-z\", \"-M\", sha)\n    if r is None:\n        return None\n    paths, src, gone = _nodehome_name_status(r)\n    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,\n    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,\n    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。\n    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None\n    for p in parents:\n        rr = _nodehome_git(repo_root, \"diff-tree\", \"--no-commit-id\", \"--name-status\", \"-z\", \"-M\", \"-r\", p, sha)\n        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))\n    order = sorted(paths)\n    specs = []\n    for x in order:\n        specs.append(f\"{sha}:{x}\")\n        specs += [f\"{p}:{x if ren is None else ren.get(x, x)}\" for p, ren in pairs]\n    blobs = _nodehome_cat_blobs(repo_root, specs)\n    if blobs is None or any(ren is None for _, ren in pairs):\n        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)\n        return paths, src, gone\n    kept = set()\n    for n, x in enumerate(order):\n        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]\n        if _nodehome_merge_wrote_new_lines(merged, olds):\n            kept.add(x)\n    return kept, {k: v for k, v in src.items() if k in kept}, gone\n\n\ndef _nodehome_cat_sizes(repo_root, specs, timeout=60):\n    \"\"\"同 _nodehome_cat_blobs 的批次讀取,只問大小(cat-file --batch-check):回同順序的 int|None(沒有這個物件=None);git 跑不起來回 None。\"\"\"\n    import subprocess as _sp\n    try:\n        chk = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch-check\"],\n                      input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n                      capture_output=True, timeout=timeout)\n    except (OSError, _sp.TimeoutExpired):\n        return None\n    if chk.returncode != 0:\n        return None\n    heads = chk.stdout.split(b\"\\n\")\n    out = []\n    for i in range(len(specs)):\n        parts = heads[i].split(b\" \") if i < len(heads) else []\n        out.append(int(parts[2]) if len(parts) == 3 and parts[2].isdigit() else None)\n    return out\n\n\ndef _nodehome_cat_blobs_capped(repo_root, specs, max_bytes, timeout=60, max_total_bytes=None, deadline=None):\n    \"\"\"_nodehome_cat_blobs 加大小上限:先用 _nodehome_cat_sizes 問大小,超過 max_bytes 的回 None、不讀進記憶體\n    (角色鏡頭代碼審 r1 外家 F6、r2 架構對齊 F1:上限放在批次讀取這一層,不另起查法)。\n    max_total_bytes 選填，限制整批宣告內容大小；deadline 選填，大小／內容兩趟共用剩餘時間。\n    未指定時保留既有逐物件上限與每趟 timeout 語意。回同順序 bytes|None；失敗或截止期耗盡回 None。\"\"\"\n    import time as _t\n    def left():\n        return timeout if deadline is None else min(timeout, deadline - _t.monotonic())\n    remaining = left()\n    if remaining <= 0:\n        return None\n    sizes = _nodehome_cat_sizes(repo_root, specs, remaining)\n    if sizes is None:\n        return None\n    ok, total = [], 0\n    for i, n in enumerate(sizes):\n        if n is None or n > max_bytes or (max_total_bytes is not None and total + n > max_total_bytes):\n            continue\n        ok.append(i)\n        total += n\n    remaining = left()\n    if remaining <= 0:\n        return None\n    got = _nodehome_cat_blobs(repo_root, [specs[i] for i in ok], timeout=remaining) if ok else []\n    if got is None:\n        return None\n    res = [None] * len(specs)\n    for i, v in zip(ok, got):\n        res[i] = v\n    return res\n\n\ndef _nodehome_cat_blobs(repo_root, specs, timeout=60):\n    \"\"\"一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。\n\n    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,\n    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。\n    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。\"\"\"\n    import subprocess as _sp\n    if not specs:\n        return []\n    if any(\"\\n\" in s_ for s_ in specs):\n        return None\n    try:\n        r = _sp.run([\"git\", \"-C\", str(repo_root), \"cat-file\", \"--batch\"],\n                    input=(\"\\n\".join(specs) + \"\\n\").encode(\"utf-8\", \"surrogateescape\"),\n                    capture_output=True, timeout=timeout)\n    except (OSError, _sp.TimeoutExpired):\n        return None\n    if r.returncode != 0:\n        return None\n    out, pos, res = r.stdout, 0, []\n    for _ in specs:\n        nl = out.find(b\"\\n\", pos)\n        if nl < 0:\n            return None\n        head = out[pos:nl].split(b\" \")\n        pos = nl + 1\n        if len(head) == 3 and head[1] == b\"blob\" and head[2].isdigit():\n            size = int(head[2])\n            res.append(out[pos:pos + size])\n            pos += size + 1\n        elif len(head) == 3 and head[2].isdigit():\n            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到\n            res.append(None)\n        else:\n            res.append(None)            # missing / ambiguous\n    return res\n\n\ndef _nodehome_merge_wrote_new_lines(merged, olds):\n\n succeeded in 0ms:\n    \"\"\"把一行代碼裡的字串字面挖空(保留引號),讓 pitfalls 的 open(/UPDATE 正則只看真代碼——\n    print(\"…open(…\") 這種訊息文字不算資源風險(#7)。單行粗剝,跨行字串不處理(剝不掉就照掃,寧誤傷不漏)。\"\"\"\n    return _PITFALL_STRLIT_RE.sub('\"\"', code)\n\n# 簿記檔白名單(單一源,兩個消費者:pitfalls --diff 掃描排除 + code-loop 留痕失效豁免)。\n# 兩處分開寫過會漂移;pitfalls 這端 2026-08-11 才補上——治理帳裡記的 skip 理由本身在\n# 描述「命中 open(...)」,被當代碼掃就再次命中 → 再 skip → 再寫一行理由……自我餵食,\n# 實測誤觸發 9 次。這些檔是紀錄不是要合入的碼。\n_BOOKKEEPING_FILES = (\"docs/.governance-log.jsonl\", \"docs/.usage-log.jsonl\",\n                      # 本機帳(被忽略)萬一被 git add -A 提交,也只是簿記、不讓代碼審留痕失效(治理帳例行紀錄分流_計劃)\n                      \"docs/\" + GOV_LOCAL_LOG_NAME, \"docs/\" + USAGE_LOCAL_LOG_NAME,\n                      \"docs/.ci-log.jsonl\", \"docs/.canary-log.jsonl\",\n                      \"docs/.bypass-log.jsonl\", \"docs/.escape-log.jsonl\",\n                      \"docs/.kill-log.jsonl\", \"docs/.signoff-log.jsonl\",\n                      \"governance/anchor-baseline.json\",\n                      # 存量漂移守衛的表態檔:跟判定檔一樣是人對發現的回應,不是程式改動(存量漂移防線 [S3])\n                      \"governance/drift-acks.jsonl\",\n                      # 存量漂移的修復帳(drift fix 每改一筆記一行稽核紀錄;同表態檔,是人對發現的處理紀錄;存量漂移改法 第 7 節)\n                      \"governance/drift-fixes.jsonl\")\n# ↑ canary-log/bypass-log 2026-08-27 補（[[Issues/簿記白名單漏canary與bypass帳]] 死結根治）:\n# 審計記帳(canary record)在 loop 中發生,pass 後提交它們原本會讓留痕失效→擋推。\n# ★真效果只在 code-loop 留痕豁免這第二消費者★:pitfalls 那端 canary-log 早被\n# _PITFALL_DIFF_SKIP_EXT(.json/.jsonl,2026-08-22)按副檔名擋掉、輪不到白名單這關(s1-f1)。\n# ↑ kill-log/signoff-log 2026-09-06 補([[Projects/全repo審視_計劃]] #5):兩本同樣是工具自己\n# 寫的 append-only 帳(kill-log 由 guard kill 寫、signoff-log 由 signoff 寫),而這次替\n# _pull_source_or_abort 加「來源只髒簿記帳就聯集合併不擋人」時,漏了它們就等於那條路對這兩本\n# 失效——有人在來源 clone 跑過 guard kill 或 signoff,更新照樣被擋。\n_BOOKKEEPING_DIRS = (\"governance/code-loop/\", \"governance/review-reports/\", \"governance/replay/\",\n                     \"governance/note-verdicts/\",   # 2026-09-17 小改動閘 r2:卷證目錄也是紀錄不是碼(三個消費者共用這一組)\n                     # 2026-10-01 回頭重讀的對照紀錄:理由同筆記內容審判定檔——紀錄不是碼,提交它不該讓代碼審留痕失效\n                     # (Projects/守檔筆記對照改動_計劃 [S8];整案回退時要同一個 revert 提交裡 git rm -r 這個資料夾)\n                     \"governance/reread-verdicts/\")\n_PITFALL_DIFF_TEST_PAT = re.compile(r\"(test_|_test\\.|\\.spec\\.|/tests?/)\", re.I)\nLINT_CMD_TIMEOUT = 180\n\n\ndef _diff_added_lines(diff_text):\n    \"\"\"從 git diff -U3 輸出建 {file: set(new_line_numbers)} 對應所有新增行(+ 開頭)。\n    使用與 _pitfall_diff_mode 相同的 @@ 標頭推導邏輯。\"\"\"\n    added = {}\n    cur_file, new_ln = \"\", 0\n    for line in diff_text.splitlines():\n        if line.startswith(\"+++ b/\"):\n            cur_file = line[6:]\n            continue\n        m = re.match(r\"@@ -\\d+(?:,\\d+)? \\+(\\d+)\", line)\n\n succeeded in 0ms:\n_ROLE_VALUES = (\"frontend\", \"backend\", \"none\")\n_ROLE_LABEL = {\"frontend\": \"前端\", \"backend\": \"後端\"}\n_ROLE_FRONT_EXTS = {\"vue\", \"svelte\", \"tsx\", \"jsx\", \"css\", \"scss\", \"html\"}   # 現在沒有題組鍵的前端檔\n_ROLE_BACK_KEYS = {\"node\", \"cs\", \"py\", \"sql\"}\n_ROLE_MOBILE_EXTS = {\"kt\", \"java\", \"swift\", \"dart\"}\n# 手機畫面判定只看匯入,名單刻意窄:androidx 底下的 room/work/datastore、android.content 這些資料層也常匯入,\n# 寬名單會把 DAO、Repository 判成畫面(設計審 r1 正確性席 F1)。\n_ROLE_UI_IMPORT = {\n    \"kt\": re.compile(r\"^\\s*import\\s+(?:androidx\\.compose|android\\.widget|android\\.view|androidx\\.recyclerview|androidx\\.fragment|androidx\\.activity|androidx\\.appcompat)\\.\", re.M),\n    \"swift\": re.compile(r\"^\\s*import\\s+SwiftUI\\b\", re.M),\n    \"dart\": re.compile(r\"\"\"^\\s*import\\s+['\"]package:flutter/(?:material|widgets|cupertino)\\.dart['\"]\"\"\", re.M),\n}\n_ROLE_UI_IMPORT[\"java\"] = _ROLE_UI_IMPORT[\"kt\"]\n_ROLE_ANDROID_IMPORT = re.compile(r\"^\\s*import\\s+(?:android|androidx)\\.\", re.M)\n_ROLE_UIKIT_IMPORT = re.compile(r\"^\\s*import\\s+UIKit\\b\", re.M)\n_ROLE_UIKIT_SUBCLASS = re.compile(r\"\\bclass\\s+\\w+\\s*:[^{\\n]*\\bUI\\w*(?:ViewController|View)\\b\")\n_ROLE_READ_CAP = 300     # 最多讀幾支檔的內容(數檔,不數往上找 package.json 的候選);超過的只看副檔名(手機檔判不出)\n_ROLE_MAX_BYTES = 512 * 1024   # 單支檔超過這個大小不讀內容(判不出);上限交給批次讀取那一層守\n_ROLE_BUDGET = 3.0       # 角色計算自己最多幾秒\n_ROLE_BUDGET_FLOOR = 1.0  # 期限很短時角色至少拿這麼多(消費專案光算工具檔清單就要半秒,代碼審 r1 正確性 F2)\n\n\ndef _role_budget(deadline):\n    \"\"\"派工時角色計算能用幾秒:最多 _ROLE_BUDGET、至少 _ROLE_BUDGET_FLOOR,平常取期限的三分之一。\"\"\"\n    if not deadline or deadline <= 0:\n        return _ROLE_BUDGET\n    return min(_ROLE_BUDGET, max(_ROLE_BUDGET_FLOOR, deadline / 3))\n\n\ndef _review_roles_config(data, unreadable=False):\n    \"\"\"data=改動起點那個版本的 .lumos/config.json 內容(_json_at_ref 讀的;None=沒有這個檔);unreadable=檔案在但讀不懂。\n    回 (rules, warnings),rules=[(樣式, 角色)]。★壞宣告整份不用★、退回不宣告的判定並回一句警告(做法照 _stack_questions_config)。\n    ★警告只寫第幾條與固定原因,不回填專案寫的值★——角色段放在框外,回填等於讓被審專案往指令區塞字(代碼審 r1 兩席)。\n    讀起點版本的理由同派工鏡頭「圖譜只信起點」:被審的分支不能自己改宣告決定自己拿到哪張卡。\"\"\"\n    if unreadable:\n        return [], [\".lumos/config.json 讀不懂,review_roles 這次不用\"]\n    v = data.get(\"review_roles\") if isinstance(data, dict) else None\n    if v is None:\n        return [], []\n    shape = \"要是清單,每條 {\\\"path\\\": 路徑樣式, \\\"role\\\": frontend|backend|none}\"\n    if not isinstance(v, list):\n        return [], [f\"review_roles {shape};這次整份不用\"]\n    rules = []\n    for i, item in enumerate(v, 1):\n        if not isinstance(item, dict) or set(item) != {\"path\", \"role\"}:\n            return [], [f\"review_roles 第 {i} 條形狀不對({shape});這次整份不用\"]\n        pat, role = item[\"path\"], item[\"role\"]\n        if role not in _ROLE_VALUES:\n            return [], [f\"review_roles 第 {i} 條的 role 不合法(只認 {'/'.join(_ROLE_VALUES)});這次整份不用\"]\n        if not isinstance(pat, str) or not pat.strip() or pat.startswith((\"./\", \"/\")) or \"\\\\\" in pat:\n            return [], [f\"review_roles 第 {i} 條的 path 不合法(不能空白、不能以 ./ 或 / 開頭、不能有反斜線);這次整份不用\"]\n        rules.append((pat, role))\n    return rules, []\n\n\ndef _review_role_for(file_rel, repo_root, rules=(), reader=None, content=None):\n    \"\"\"一支改動檔的審查角色:\"frontend\" / \"backend\" / None(判不出就不附,不猜)。依序:\n    專案宣告(第一條命中的算數)→ 現在沒有題組鍵的前端副檔名 → 手機檔看匯入 → 題組鍵(.ts/.js 走 package.json)。\n    建立在 _stack_key_for_file 上,不另造一套分類(設計審 r1 架構對齊席 F2)。\n    reader:讀指定版本的 package.json(見 _node_flavor);content:手機檔的內容,None=沒讀(超過上限)→ 判不出。\"\"\"\n    if rules:\n        i = _glob_first_match(file_rel, [p for p, _ in rules])\n        if i is not None:\n            return None if rules[i][1] == \"none\" else rules[i][1]\n    ext = Path(file_rel).suffix.lstrip(\".\").lower()\n    if ext in _ROLE_FRONT_EXTS:\n        return \"frontend\"\n    if ext in _ROLE_MOBILE_EXTS:\n        if content is None:\n            return None\n        if _ROLE_UI_IMPORT[ext].search(content):\n            return \"frontend\"\n        if ext == \"swift\" and _ROLE_UIKIT_IMPORT.search(content) and _ROLE_UIKIT_SUBCLASS.search(content):\n            return \"frontend\"\n        if ext == \"java\" and not _ROLE_ANDROID_IMPORT.search(content):\n            return \"backend\"    # Java 後端服務常見;Android 純 Java 資料類也會落在這裡(已知限制,出路是宣告)\n        return None\n    key = _stack_key_for_file(file_rel, repo_root, reader=reader)\n    if key == \"vue\":\n        return \"frontend\"\n    return \"backend\" if key in _ROLE_BACK_KEYS else None\n\n\ndef _review_role_changed_files(root, base, head, deadline=None):\n    \"\"\"角色鏡頭的改動檔清單:[(路徑, 讀內容用的版本)]。派工角色段與推送前分級那一行共用這一支。\n    一般改名算新路徑；跨到被排除的簿記終點另保留舊程式、讀起點版本。\n    刪除的檔照樣算、讀起點版本。剔除測試檔(_PITFALL_DIFF_TEST_PAT)、消費專案裡原封不動的工具檔\n    (_vendored_skip)、文件與帳檔(_impact_diff_seed_ok)。git 跑不起來回 None。\"\"\"\n    r = _lens_git(root, \"diff\", \"--no-ext-diff\", \"--name-status\", \"-M\", \"-z\", base, head)\n    if r is None or r.returncode != 0:\n        return None\n    toks = r.stdout.split(\"\\0\")\n    skip = _vendored_skip(root, f\"{base}..{head}\")\n    out, renamed, i = [], [], 0\n    while i < len(toks) and toks[i]:\n        st = toks[i]\n        if st[:1] in (\"R\", \"C\"):\n            if st[:1] == \"R\":\n                renamed.append((toks[i + 1], toks[i + 2]))\n            path, ref, i = toks[i + 2], head, i + 3\n        else:\n            path, ref, i = toks[i + 1], (base if st[:1] == \"D\" else head), i + 2\n        out.append((path, ref))\n    modes = _impact_diff_modes(root, [path for path, _ref in out] + [old for old, _new in renamed],\n                               base, head, deadline=deadline)\n    if modes is None:\n        return None\n    # 一般改名仍取新路徑；只有簿記終點被排除時，不能把舊程式刪除一起藏掉。\n    out += [(old, base) for old, new in renamed if new.startswith(_BOOKKEEPING_DIRS)\n            and not _impact_diff_seed_ok(new, *modes.get(new, (None, None)))\n            and _impact_diff_seed_ok(old, *modes.get(old, (None, None)))]\n    return [(path, ref) for path, ref in out\n            if not _PITFALL_DIFF_TEST_PAT.search(path)\n            and _impact_diff_seed_ok(path, *modes.get(path, (None, None))) and path not in skip]\n\n\ndef _review_roles(root, base, head, budget=_ROLE_BUDGET):\n    \"\"\"算這段改動每支檔的角色。回 {\"roles\": {路徑: 角色|None}, \"counts\": {...}, \"warnings\": [...], \"capped\": N, \"timed_out\": bool};\n    git 讀不到改動清單回 None。成本:內容一次批次讀取(_nodehome_cat_blobs),最多讀 _ROLE_READ_CAP 支,整體受 budget 秒限制。\"\"\"\n    import time as _t\n    if budget <= 0:\n        return {\"roles\": {}, \"counts\": {\"frontend\": 0, \"backend\": 0, \"unknown\": 0},\n                \"warnings\": [], \"capped\": 0, \"timed_out\": True}\n    t0 = _t.monotonic()\n    cfg = _json_at_ref(root, base, \".lumos/config.json\")\n    _cfg_there = cfg is None and _lens_git(root, \"cat-file\", \"-e\", f\"{base}:.lumos/config.json\")\n    rules, warnings = _review_roles_config(cfg, unreadable=bool(_cfg_there and _cfg_there.returncode == 0))\n    files = _review_role_changed_files(root, base, head, deadline=t0 + budget)\n    if files is None:\n        return None\n    want, capped = _review_role_wanted(files, rules)\n    blobs = {}\n    left = budget - (_t.monotonic() - t0)\n    timed_out = left <= 0\n    if want and left > 0.2:\n        got = _nodehome_cat_blobs_capped(root, want, _ROLE_MAX_BYTES, timeout=left)\n        if got is None:\n            timed_out = True\n        else:\n            blobs = {k: (v.decode(\"utf-8\", \"replace\") if v is not None else None) for k, v in zip(want, got)}\n    elif want:\n        timed_out = True\n    roles = {}\n    for p, ref in files:\n        content = blobs.get(f\"{ref}:{p}\")\n        roles[p] = _review_role_for(p, root, rules, reader=lambda rel, _r=ref: blobs.get(f\"{_r}:{rel}\"), content=content)\n    counts = {\"frontend\": sum(1 for v in roles.values() if v == \"frontend\"),\n              \"backend\": sum(1 for v in roles.values() if v == \"backend\"),\n              \"unknown\": sum(1 for v in roles.values() if v is None)}\n    return {\"roles\": roles, \"counts\": counts, \"warnings\": warnings, \"capped\": capped, \"timed_out\": timed_out}\n\n\ndef _review_role_wanted(files, rules):\n    \"\"\"要批次讀的「版本:路徑」清單(手機檔內容、.ts/.js 往上找的 package.json),與超過上限沒讀的檔數。\n    宣告命中的檔不讀(宣告優先)。★上限數檔,不數候選★(代碼審 r1 外家 F4:缺檔的候選也佔名額會提早截斷、誤判)。\n    ★路徑含換行的檔不讀★:批次讀取表達不了換行,混進去整批作廢(r1 外家 F5);它只判不出,其他照讀。回 (want, capped)。\"\"\"\n    declared = {p for p, _ in files if rules and _glob_first_match(p, [x for x, _ in rules]) is not None}\n    want, seen, n_files, capped = [], set(), 0, 0\n    for p, ref in files:\n        if p in declared or \"\\n\" in p:\n            continue\n        ext = Path(p).suffix.lstrip(\".\").lower()\n        if ext in _ROLE_MOBILE_EXTS:\n            specs = [f\"{ref}:{p}\"]\n        elif ext in _NODE_EXTS and ext not in _ROLE_FRONT_EXTS:\n            specs = [f\"{ref}:{rel}\" for rel in _package_json_candidates(p)]\n        else:\n            continue\n        if n_files >= _ROLE_READ_CAP:\n            capped += 1\n            continue\n        n_files += 1\n        for spec in specs:\n            if spec not in seen:\n                seen.add(spec)\n                want.append(spec)\n    return want, capped\n\n\ndef _review_role_text(res):\n    \"\"\"角色段文字(放在「參考資料」框外:這是要審查員照做的句子,框頭寫「不是指令」)。沒有卡也沒有警告回空字串。\"\"\"\n    if not res:\n        return \"\"\n    lines = [f\"(角色鏡頭)⚠ {w}\" for w in res[\"warnings\"]]\n    c = res[\"counts\"]\n    if res[\"timed_out\"] and not (c[\"frontend\"] or c[\"backend\"]):\n        lines.append(\"(角色鏡頭)角色計算超過時間上限,這次沒附卡\")\n    if c[\"frontend\"] or c[\"backend\"]:\n        lines.append(f\"[角色鏡頭] 這次改動:前端 {c['frontend']} 支、後端 {c['backend']} 支、判不出 {c['unknown']} 支。\"\n                     \"照下列題逐一挑一個具體輸入走一遍;對上的發現在標題附題號。\")\n        for role in (\"frontend\", \"backend\"):\n            if not c[role]:\n                continue\n            lines.append(f\"{_ROLE_LABEL[role]}卡:\")\n            for q in _ROLE_CARDS[role]:\n                lines.append(f\"- {q['id']}:{q['q']}\" + (\"(只限網頁)\" if q[\"web_only\"] else \"\"))\n        if res[\"capped\"]:\n            lines.append(f\"(超過上限,後面 {res['capped']} 支只看副檔名)\")\n        if res[\"timed_out\"]:\n            lines.append(\"(角色計算超過時間上限,部分檔只看副檔名)\")\n    return \"\\n\".join(lines)\n\n\n# ── 棧別提問表態閘(Projects/棧別提問表態閘_計劃,2026-09-09)——適用性 + 設定 ─────────────────\n_STACK_QUESTIONS_GATE_VALUES = (\"all\", \"high-only\", \"off\")\n_STACK_ASK_ALL_DEFAULT = 300\n\n\ndef _stack_questions_config(repo_root):\n    \"\"\"讀 .lumos/config.json 的 stack_questions 區塊(直讀 repo_root,同 _ci_config/load_test_profile 慣例,\n    ★不走載 vault 的 helper★——check 跑在 pre-push,自稱 vault-free;r2 架構對齊席 A4)。\n\n succeeded in 0ms:\n        return True\n    if _nodehome_in_stack_test_dir(path, layout):\n        return True\n    if _testmap_ext(path) in _TESTMAP_EXTS:\n        return False                      # 測試地圖認得這種副檔名,它說不是就不是\n    if _TESTMAP_DIR_RE is None:\n        _TESTMAP_DIR_RE = re.compile(r\"(^|/)(tests?|__tests__|specs?)/\", re.IGNORECASE)\n    if _TESTMAP_DIR_RE.search(path):\n        return True\n    name = path.rsplit(\"/\", 1)[-1]\n    stem = _testmap_stem(path)\n    return (\".spec.\" in name or \".test.\" in name or stem.startswith(\"test_\")\n            or stem.lower().endswith((\"_tests\", \"_specs\", \"_test\", \"_spec\")))   # 底線變體同測試地圖(Go 的 foo_test.go)\n\n\ndef _nodehome_code_kind(path):\n    \"\"\"回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。\n    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。\"\"\"\n    base = path.rsplit(\"/\", 1)[-1]\n    stripped = base.lstrip(\".\")\n    if \".\" in stripped:\n        return \"ext\" if (\".\" + stripped.rsplit(\".\", 1)[1]) in _NODEHOME_CODE_EXTS else None\n    return \"shebang?\"\n\n\nclass _NodehomeSide:\n    \"\"\"一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);\n    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);\n    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。\n    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。\"\"\"\n    __slots__ = (\"files\", \"all_paths\", \"notes\", \"where\", \"_reader\", \"shebang\", \"share\", \"changed\")\n\n\ndef _nodehome_git(repo_root, *args):\n    \"\"\"跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。\"\"\"\n    r = _lens_git(repo_root, *args, binary=True)\n    if r is None or r.returncode != 0:\n        return None\n    return r.stdout\n\n\ndef _nodehome_show(path):\n    \"\"\"路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。\"\"\"\n    return os.fsencode(path).decode(\"utf-8\", errors=\"replace\") if isinstance(path, str) else str(path)\n\n\ndef _nodehome_split_z(raw):\n    return [os.fsdecode(x) for x in raw.split(b\"\\0\") if x]\n\n\ndef _nodehome_list(repo_root, where, oids=None):\n\n succeeded in 0ms:\n            print(f\"  hop{x['hop']}  {x['node']}  {x['direction']} ← via {x['via']} ← {x['from']}{cross}\")\n        if all_incidents:\n            print(f\"── 相關事故 ({len(all_incidents)}) ──\")\n            for x in all_incidents:\n                contract_tag = f\" ★{x['contract']}★\" if x.get(\"contract\") else \"\"\n                print(f\"  {x['node']}{contract_tag}  (trigger: {x['matched_by']})\")\n\n    return 0\n\n\n_IMPACT_DIFF_SKIP = (\"docs/\", \"governance/golden/\")   # 圖譜/凍結快照非 code,不當 impact 種子\n\n\ndef _impact_diff_seed_ok(f, file_mode=None, shebang=None):\n    \"\"\"--diff 種子過濾:只收 code 檔。剔除圖譜/凍結快照/帳檔(.jsonl)/文檔(.md)/\n    簿記分類沿用 _BOOKKEEPING_FILES/_BOOKKEEPING_DIRS,卷證不是程式;\n    governance 資料 .json(goldset/裁決紀錄內嵌歷史 code 片段,會偽觸發事故 pin——r1 panel 實證)。\"\"\"\n    if not f or any(f.startswith(p) for p in _IMPACT_DIFF_SKIP):\n        return False\n    # 固定帳檔仍排除；目錄內的程式例外先成立，不再被文檔副檔名二次排掉。\n    if f in _BOOKKEEPING_FILES:\n        return False\n    if f.startswith(_BOOKKEEPING_DIRS):\n        kind = _nodehome_code_kind(f)\n        if file_mode == \"100755\" or kind == \"ext\":\n            return True\n        if kind == \"shebang?\":\n            return shebang is not False  # 超過上限／讀不到時沿既有保守判法。\n        return file_mode is None\n    if f.endswith((\".jsonl\", \".md\")):\n        return False\n    if f.endswith(\".json\") and f.startswith(\"governance/\"):\n        return False\n    return True\n\n\ndef _impact_diff_raw(repo_root, diff_args, deadline):\n    \"\"\"分類的 raw 讀取；截止期耗盡回空資料保留未知，其他失敗回 None。\"\"\"\n    import time as _t\n    args = (\"diff\", \"--no-ext-diff\", \"--no-textconv\", \"--raw\", \"--no-renames\", \"--no-abbrev\", \"-z\", *diff_args)\n    if deadline is None:\n        raw = _nodehome_git(repo_root, *args)\n    else:\n        left = min(_disp_git_timeout(), deadline - _t.monotonic())\n        if left <= 0:\n            return b\"\"  # 未知模式，不把它當附件排除。\n        r = _lens_git(repo_root, *args, binary=True, timeout=left)\n        raw = r.stdout if r is not None and r.returncode == 0 else None\n        if raw is None and _t.monotonic() >= deadline:\n            return b\"\"\n    return raw\n\n\ndef _impact_diff_modes(repo_root, files, *diff_args, deadline=None):\n    \"\"\"簿記來源取凍結模式與首行；普通來源不多查 Git。刪檔取舊物件。\"\"\"\n    if not any(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):\n        return {}\n    import time as _t\n    raw = _impact_diff_raw(repo_root, diff_args, deadline)\n    changes = _codeloop_raw_changes(raw) if raw is not None else None\n    if changes is None:\n        return None\n    out, ask = {}, []\n    for f, (old, new, old_oid, new_oid) in changes.items():\n        mode, oid = (old, old_oid) if new == \"000000\" else (new, new_oid)\n        out[f] = (mode, None)\n        if (f.startswith(_BOOKKEEPING_DIRS) and mode != \"100755\"\n                and _nodehome_code_kind(f) == \"shebang?\" and not _path_special_chars(f, surrogate=False)\n                and oid.strip(\"0\") and len(ask) < _ROLE_READ_CAP):\n            ask.append((f, oid))\n    if ask:\n        left = _disp_git_timeout() if deadline is None else min(_disp_git_timeout(), deadline - _t.monotonic())\n        if left <= 0:\n            return out\n        heads = _nodehome_cat_blobs_capped(repo_root, [oid for _f, oid in ask],\n                                          _CODELOOP_BOOKKEEPING_HEAD_CAP, timeout=left,\n                                          max_total_bytes=_CODELOOP_BOOKKEEPING_HEAD_CAP, deadline=deadline)\n        if heads is not None:\n            for (f, _oid), head in zip(ask, heads):\n                out[f] = (out[f][0], True if head is None else _head_is_shebang(head, lenient=True))\n    return out\n\n\ndef _impact_payload_read(path):\n    \"\"\"讀一份已經算好的波及結果(pre-push 每次推送只算一次,兩個消費者共用同一份)。\n\n    ★為什麼要有這支★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):\n    推送關卡本來就對每個 ref 跑一次完整的波及計算(同步點名用)。合約測試閘要的是\n    同一份東西裡「帶合約而且綁了測試」的那幾篇——★再算一次就是把一次推送算兩次★,\n    而那正是這一案 r1 拿來否決原設計的那個成本(那條裁定後來被查出已作廢,\n    但「不要算兩次」本身仍然是對的)。\n\n    ★失敗要隔離★:讀不到就回 None,呼叫端各自決定怎麼降級——\n    同步點名維持靜默,合約測試閘記一筆帳放行。一個失敗不准拖垮另一個。\n    \"\"\"\n    import json as _json, stat as _stat\n    # ★擁有權要驗,理由跟 dispatch-lens 那支快取一模一樣★\n    # (2026-09-07 代碼審 r1 架構對齊席判 blocking,說得對):\n    # 這個 repo 已經有一套硬化過的「算一次、之後讀」——_lens_cache_read,\n    # 它會先驗 st_uid 與 group/other 可不可寫,註解明寫「$TMPDIR 路徑可預測可偽造」。\n    # 而這裡收的正是一個從命令列傳進來的 $TMPDIR 路徑,同一種曝險。\n    # ★但沒有照抄整套★,理由是生命週期不同,而這一點原本沒寫下來所以席位抓到了:\n    #   dispatch-lens 那支是「跨呼叫、可被別人發現、要 TTL、要 key 去對」的快取;\n    #   這裡是「同一次 hook 執行內、由呼叫端明確指定路徑、用完就刪」的交接。\n    #   要 TTL 與 key 是多餘的,要擁有權驗證則是必要的——所以只借那一半。\n    try:\n        st = Path(path).stat()\n        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):\n            return None\n        data = _json.loads(Path(path).read_text(encoding=\"utf-8\"))\n    except Exception:\n        return None\n    # ★形狀要驗到位★(代碼審 r1 外家否決席判 major):只驗「是 dict 而且有 results」不夠——\n    # `{\"results\":[1],\"sync\":[]}` 這種合法 JSON 會通過,然後在下游 r.get(...) 當場拋例外,\n    # 而那個例外會被 pre-push 的 || true 吞掉:★不是按設計記 range-unavailable,是靜默失效★。\n    if not isinstance(data, dict):\n        return None\n    res = data.get(\"results\")\n    if not isinstance(res, list) or any(not isinstance(r, dict) for r in res):\n        return None\n    sync = data.get(\"sync\")\n    if sync is not None and not (isinstance(sync, dict)\n                                 and isinstance(sync.get(\"missing\"), list)\n                                 and isinstance(sync.get(\"touched_nodes\"), list)):\n        return None\n    return data\n\n\ndef cmd_impact_diff(diff_range, repo=None, depth=None, top=8, min_score=0.20, as_json=False,\n                    sync_check=False, sync_only=False, from_json=None):\n    \"\"\"code-loop 橋接:對整段 diff 的每支改動 code 檔跑 ranked impact(query=該檔 hunk 文字),\n    聚合成「受影響功能面」manifest——固定席(合約/事故)全保、非固定取跨檔最高分 top-N。\n    定位=審計員鏡頭(advisory,人判),非自動推播(hook 面 goldset 評測未過線,故不接 hook)。\n    rc: 0=成功 / 2=git 失敗 / 3=vault 缺。\n\n    from_json:吃一份已經算好的結果,不自己算(見 _impact_payload_read)。目前只支援\n    搭 --sync-only 用——推送關卡算一次、同步點名與合約測試閘各讀一次。\"\"\"\n    if from_json is not None:\n        _pl = _impact_payload_read(from_json)\n        if _pl is None or _pl.get(\"sync\") is None:\n            return 0          # 失敗隔離:維持同步點名現在的行為(靜默)\n        _print_sync_nudge(_pl[\"sync\"], _pl.get(\"range\") or diff_range)\n        return 0\n    import json as _json\n    import subprocess as _sp\n    if diff_range == \"staged\":\n        # 圖譜同步覆蓋(2026-08-22):pre-commit 要對「這次 commit 的內容」算波及,用 staged 代替 range\n        diff_range = \"--staged\"\n    elif diff_range.startswith(\"-\"):\n        # 同 pitfalls/cochange-check:'-' 開頭值會被 git 誤認成選項,查詢命令 rc2 拒收\n        print(\"擋下:--diff 的值不能用 - 開頭(會被當成選項)\", file=sys.stderr)\n        return 2\n    repo_root = Path(repo) if repo else None\n    if repo_root is None:\n        for cand in (Path.cwd(), *Path.cwd().parents):\n            if (cand / \".git\").exists():\n                repo_root = cand\n                break\n    if repo_root is None or not (repo_root / \".git\").exists():\n        print(\"擋下:找不到 git 專案,用 --repo 指定\", file=sys.stderr)\n        return 2\n    # NUL 分隔且無損解碼，特殊檔名不能被引號化／拆行；改名兩側與 raw 判法一致。\n    r = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n                 \"diff\", \"--name-only\", \"--no-renames\", \"-z\", diff_range], capture_output=True)\n    if r.returncode != 0:\n        print(f\"擋下:git 算不出差異: {r.stderr.decode('utf-8', 'replace').strip()[:200]}\", file=sys.stderr)\n        return 2\n    candidates = [os.fsdecode(f) for f in r.stdout.split(b\"\\0\") if f]\n    modes = _impact_diff_modes(repo_root, candidates, diff_range)\n    if modes is None:\n        print(\"擋下:git 算不出差異檔案模式\", file=sys.stderr)\n        return 2\n    files = []\n    for f in candidates:\n        if not _impact_diff_seed_ok(f, *modes.get(f, (None, None))):\n            continue\n        # 已刪檔不跳過:反查靠「節點 body 引用該路徑」而非檔案存在——\n        # 刪除/改名正是合約節點最該被推到審計員眼前的時刻(r1 codex major)\n        files.append(f)\n    merged = {}          # node -> entry(跨檔取最高分;pinned 任一檔 pinned 即 pinned)\n    per_file_meta = []\n    import io, contextlib\n    _vault = _vault_in(repo_root)\n    # ★沒有圖譜就直接說,不要印「0 篇」裝作查過了★(2026-09-07 全 repo 審視 #9)\n    #\n    # 出身:這條路原本只在**逐檔迴圈裡**才發現沒圖譜——而「這個範圍 0 個檔」時迴圈根本不跑,\n    # 於是一路走到最後印出「固定席 0 + top 0」並回成功。\n    # ★對新手最危險的就是這個★:同一件事(找不到圖譜),另外兩種問法一個回 rc3、一個回 rc2\n    # 並印白話擋下,只有這條印「0 篇」**看起來像查過了**——而它根本沒有圖譜可查。\n    # 文件本來就寫著這條路會回「圖譜缺」,只是零檔時走不到。\n    if _vault is None:\n        return _no_vault_msg()\n    _env_shared = Env(_vault)   # 建一次,逐檔復用(r1 N+1)\n    for f in files:\n        d = _sp.run([\"git\", \"-C\", str(repo_root), \"-c\", \"core.quotePath=false\",\n                     \"diff\", \"--no-ext-diff\", \"--no-textconv\", diff_range, \"--\", f], capture_output=True, text=True, errors=\"replace\")\n        hunk = \" \".join(l[1:].strip() for l in d.stdout.splitlines()\n                        if l[:1] in \"+-\" and not l.startswith((\"+++\", \"---\")))[:4000]\n        buf = io.StringIO()\n        with contextlib.redirect_stdout(buf):\n            rc = cmd_impact(f, repo=str(repo_root), depth=depth, as_json=True,\n                            ranked=True, top=top, min_score=min_score,\n                            payload={\"query\": hunk, \"prospective\": {}},\n                            preloaded=(_vault, _env_shared) if _env_shared is not None else None)\n        if rc == 3:\n            print(\"IMPACT-DEBUG: vault 找不到(rc3)\", file=sys.stderr)\n            return 3\n        if rc != 0:\n            continue\n        try:\n            data = _json.loads(buf.getvalue().strip().splitlines()[-1])\n        except (ValueError, IndexError):\n            continue\n        _pm = {\"file\": f, **data.get(\"meta\", {})}\n        if data.get(\"query_gated\"):\n            _pm[\"query_gated\"] = True   # 觀測欄聚合轉發(r1 f5:code-loop 鏡頭可見)\n        per_file_meta.append(_pm)\n        for x in data.get(\"results\", []):\n            cur = merged.get(x[\"node\"])\n            if cur is None:\n                merged[x[\"node\"]] = {**x, \"files\": [f]}\n            else:\n                if f not in cur[\"files\"]:\n                    cur[\"files\"].append(f)\n                pinned = cur[\"pinned\"] or x.get(\"pinned\", False)\n                # ★家是「哪支檔的家」,不是「這一輪分數高不高」★(推筆記認家 [S6]):\n                # 同一篇在 A 檔是家、在 B 檔只是被提到,B 檔那筆分數較高就會整項重建——\n                # 不把這兩個欄位接住,家的標記會被自己的高分沖掉,必推名單就少一篇。\n                home = cur.get(\"home\", False) or x.get(\"home\", False)\n                home_of = list(cur.get(\"home_of\", []))\n                for _hf in x.get(\"home_of\", []):\n                    if _hf not in home_of:\n                        home_of.append(_hf)\n                if x[\"score\"] > cur[\"score\"]:\n                    # 整項以勝出結果重建(避免 hop/L 舊值殘留成幽靈欄位,r1 s4 minor)\n                    merged[x[\"node\"]] = {**x, \"files\": cur[\"files\"], \"pinned\": pinned}\n                    cur = merged[x[\"node\"]]\n                cur[\"pinned\"] = pinned\n                if home:\n                    cur[\"home\"], cur[\"home_of\"] = True, home_of\n    # 必推名單的順序=事故 → 家 → 其餘照分數(推筆記認家 [S6],跟逐檔那側同一套口徑)。\n    # 家的分數是它原本的相依分數(新增項為 0),照分數排會把「這批改動的管家」排到最後,\n    # 而派工鏡頭只把前幾篇貼內容、其餘只列名——排錯等於白認。\n    _home_on = int(_impact_knob(\"LUMOS_IMPACT_HOME\", 1))\n    # ★跟逐檔那側共用同一支排序★(2026-09-15 code r1 正確性席:這裡原本自己手寫一份,\n    # 而註解卻寫著「跟逐檔那側同一套口徑」——實測餵同一批候選給兩份公式★順序相反★,\n    # 那句話是假宣稱)。差別用參數表達:這一側所有固定席都照分數排(家的分數是相依分數,\n    # 排錯等於白認家),逐檔那側只有家之間照分數。\n    pins = _impact_sort_pins([v for v in merged.values() if v[\"pinned\"]], _home_on,\n                             score_all=True)\n    free = sorted([v for v in merged.values() if not v[\"pinned\"]],\n                  key=lambda v: (-v[\"score\"], v[\"node\"]))[:int(top)]\n    # 落成位置閉環(sync-check):預期受影響節點 ∩ 分支實際動過的圖譜節點——\n    # 「這功能被改了,它的節點卻沒動」= 受影響未同步清單(advisory,人判;固定席可信度高、自由席≈P@8 .70)\n    sync = None\n    if sync_check:\n        _vault_name = _vault.name if _vault is not None else None\n        touched = set()\n        if _vault_name:\n            _prefix = f\"docs/{_vault_name}/\"\n            for f2 in candidates:\n                if f2.startswith(_prefix) and f2.endswith(\".md\"):\n                    touched.add(f2[len(_prefix):])\n        missing = [v for v in (pins + free) if v[\"node\"] not in touched]\n        sync = {\"touched_nodes\": sorted(touched),\n                \"missing\": [{\"node\": v[\"node\"], \"pinned\": v[\"pinned\"],\n                             \"score\": v[\"score\"], \"files\": v[\"files\"]} for v in missing]}\n    if as_json:\n        print(_json.dumps({\"range\": diff_range, \"files\": files,\n                           \"results\": pins + free,\n                           **({\"sync\": sync} if sync is not None else {}),\n                           \"meta\": {\"files\": len(files), \"pinned\": len(pins),\n                                    \"free_kept\": len(free),\n                                    \"free_total\": sum(1 for v in merged.values() if not v[\"pinned\"]),\n                                    \"per_file\": per_file_meta}}, ensure_ascii=False))\n        return 0\n    if sync_only and sync is not None:\n        _print_sync_nudge(sync, diff_range)\n        return 0\n    print(f\"受影響功能面({diff_range};{len(files)} 檔;固定席 {len(pins)}+top {len(free)}——審計鏡頭,人判):\")\n    for v in pins + free:\n        mk = {\"incident\": \"⚠事故\", \"direct\": \"直接\", \"indirect\": f\"hop{v.get('hop','?')}\", \"home\": \"\"}.get(v[\"kind\"], \"\")\n        hm = \"★家★\" if v.get(\"home\") else \"\"            # 推筆記認家 [S8]:這篇管其中某幾支檔\n        ct = f\" ★{v['contract']}★\" if v.get(\"contract\") else \"\"\n        pin = \" [固定]\" if v[\"pinned\"] else \"\"\n        print(f\"  {v['score']:5.2f} {' '.join(x for x in (hm, mk) if x)} {v['node']}{ct}{pin}  ←{','.join(v['files'][:3])}\")\n    if not merged:\n        print(\"  (無節點引用這些檔——圖譜對此 diff 無覆蓋)\")\n    if sync is not None:\n        _print_sync_nudge(sync, diff_range)\n    return 0\n\n\ndef _print_sync_nudge(sync, diff_range, cap=8):\n    \"\"\"落成核對的唯一呈現(2026-08-22 架構對齊席抓到三套並存後收斂成這一份):\n    固定席(合約/事故/直接相依)優先、最多 cap 篇;hooks(pre-commit/pre-push/Stop)只呼叫,不自己重排。\"\"\"\n\nhook: PostToolUse\nhook: PostToolUse\nhook: PostToolUse\nhook: PostToolUse\nhook: PostToolUse\nhook: PostToolUse Completed\nhook: PostToolUse Completed\nhook: PostToolUse Completed\nhook: PostToolUse Completed\nhook: PostToolUse Completed\nhook: PreToolUse\nhook: PreToolUse Completed\nexec\n/bin/zsh -lc 'for f in governance/review-reports/code-review-artifact-impact-inputs/r2-integrated-subsets.json governance/review-reports/code-review-artifact-impact-inputs/r2-delivery-fix-check.json governance/review-reports/code-review-artifact-impact-inputs/r2-final-lint-new.json governance/review-reports/code-review-artifact-impact-inputs/r2-integrated-spec-push.json; do wc -l \"$f\"; sha256sum \"$f\"; sed -n '\"'1,260p' \