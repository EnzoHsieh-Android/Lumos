+def _impact_diff_modes(repo_root, files, *diff_args):
+    """簿記來源需要凍結模式；普通來源沿舊路，不多查 Git。刪檔用舊模式。"""
+    if not any(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):
+        return {}
+    raw = _nodehome_git(repo_root, "diff", "--no-ext-diff", "--no-textconv",
+                        "--raw", "--no-renames", "-z", *diff_args)
+    pairs = _codeloop_raw_modes(raw) if raw is not None else None
+    if pairs is None:
+        return None
+    return {f: old if new == "000000" else new for f, (old, new) in pairs.items()}
