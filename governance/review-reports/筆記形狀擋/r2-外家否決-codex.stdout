 22602	def _nodehome_homes(repo_root, side):
 22603	    """[S2] {檔: [家那幾篇]}——每支檔有家這邊:拿提交快照的解析結果餵 _home_map_from_notes。"""
 22604	    return _home_map_from_notes((rel, n["type"], n["status"], n["about"]) for rel, n in side.notes.items())
