 22676	def _nodehome_merge_own_changes(repo_root, sha, parents):
 22677	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 22678	
 22679	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 22680	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 22681	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 22682	    或順手多改的部分,正是這道檢查要看的。
 22683	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 22684	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 22685	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 22686	    """
 22687	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 22688	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22689	        return None
 22690	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 22691	                      "--name-status", "-z", "-M", sha)
 22692	    if r is None:
 22693	        return None
 22694	    paths, src, gone = _nodehome_name_status(r)
 22695	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 22696	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 22697	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 22698	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 22699	    for p in parents:
 22700	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22701	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22702	    order = sorted(paths)
 22703	    specs = []
 22704	    for x in order:
 22705	        specs.append(f"{sha}:{x}")
 22706	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 22707	    blobs = _nodehome_cat_blobs(repo_root, specs)
 22708	    if blobs is None or any(ren is None for _, ren in pairs):
 22709	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 22710	        return paths, src, gone
 22711	    kept = set()
 22712	    for n, x in enumerate(order):
 22713	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 22714	        if _nodehome_merge_wrote_new_lines(merged, olds):
 22715	            kept.add(x)
 22716	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 22717	
 22718	
 22719	def _nodehome_cat_blobs(repo_root, specs):
 22720	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22721	
 22722	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22723	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22724	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 22725	    import subprocess as _sp
 22726	    if not specs:
 22727	        return []
 22728	    if any("\n" in s_ for s_ in specs):
 22729	        return None
 22730	    try:
 22731	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22732	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22733	                    capture_output=True, timeout=60)
 22734	    except (OSError, _sp.TimeoutExpired):
 22735	        return None
 22736	    if r.returncode != 0:
 22737	        return None
 22738	    out, pos, res = r.stdout, 0, []
 22739	    for _ in specs:
 22740	        nl = out.find(b"\n", pos)
 22741	        if nl < 0:
 22742	            return None
 22743	        head = out[pos:nl].split(b" ")
 22744	        pos = nl + 1
 22745	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22746	            size = int(head[2])
 22747	            res.append(out[pos:pos + size])
 22748	            pos += size + 1
 22749	        elif len(head) == 3 and head[2].isdigit():
 22750	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22751	            res.append(None)
 22752	        else:
 22753	            res.append(None)            # missing / ambiguous
 22754	    return res
 22755	
 22756	
 22757	def _nodehome_merge_wrote_new_lines(merged, olds):
 22758	    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。
 22759	
 22760	    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
 22761	    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
 22762	    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
 22763	    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
