 22625	def _nodehome_changes(repo_root, base, tip):
 22626	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22627	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22628	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22629	    if tip == "index":
 22630	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22631	        if base is None:
 22632	            args.append(_EMPTY_TREE_SHA)
 22633	    else:
 22634	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 22635	    raw = _nodehome_git(repo_root, *args)
 22636	    if raw is None:
 22637	        return None
 22638	    toks = _nodehome_split_z(raw)
 22639	    out, i = [], 0
 22640	    while i < len(toks):
 22641	        st = toks[i]
 22642	        code = st[:1]
 22643	        if code in ("R", "C") and i + 2 < len(toks):
 22644	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 22645	            i += 3
 22646	        elif i + 1 < len(toks):
 22647	            p = nfc(toks[i + 1])
 22648	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 22649	            i += 2
 22650	        else:
 22651	            break
 22652	    return out
 22653	
