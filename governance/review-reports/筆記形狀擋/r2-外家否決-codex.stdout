def _lint_new_cmd_targets(code_pairs, dep_pairs, lint_cfg, dep_cmds=(), repo_root=None, ref=None):
    """把「哪條命令該吃哪些檔」配對好。回 [(命令, [現在路徑…]) …]。
    ★每條命令只拿自己那個棧的檔★——不分的話,Python 的檢查器會收到 Kotlin 檔,
    白跑一趟還可能吐出對不上的告警。依賴掃描只拿依賴宣告檔。
    ★副檔名比對共用 _lint_stacks_for_diff★(r1 架構對齊席):自己再寫一份等於同一件事兩套實作,
    以後只改一邊就會悄悄漂移;這裡只負責「把命令對回它那個棧的檔」。"""
    out = []
    by_ext = {}
    for now_path, _b in code_pairs:
        by_ext.setdefault(_lint_file_ext(now_path, repo_root, ref), []).append(now_path)
    for ext, files in sorted(by_ext.items()):
        if not ext:
            continue      # 認不出是什麼語言的檔(沒副檔名也沒 shebang):不硬猜
        # 用共用那支挑命令(它負責「這個副檔名有沒有宣告、順序與去重」),這裡只補上檔案清單。
        # 餵一個帶正確副檔名的假檔名進去:真檔名可能沒有副檔名(靠 shebang 認出來的),
        # 而那支共用函式只看副檔名——不這樣接的話等於又寫一份比對邏輯
        # ★明寫只要命令★(2026-09-16 代碼審 r1 架構席):那支 2026-09-16 起回的是
        # 「命令 → 檔清單」的對應表,這裡自己算檔清單、只借它挑命令。原本寫成直接迭代,
        # ★只是剛好因為迭代對應表拿到的是鍵才還能動★——那種相容沒人釘住,寫明比較誠實。
        for cmd in list(_lint_stacks_for_diff({("_." + ext): set()}, lint_cfg)):
            out.append((cmd, sorted(files)))
    if dep_pairs:
        dep_files = sorted({a for a, _b in dep_pairs})
        for cmd in dep_cmds:
            if isinstance(cmd, str):
                out.append((cmd, dep_files))
    return out


def _lint_new_config(repo_root):
    """讀 .lumos/config.json 的 lint_new 區塊(同 _stack_questions_config 慣例,直讀不載 vault)。
    ★不放 .lumos/lint.json★:那個檔的每個頂層鍵都被當成「副檔名→命令清單」嚴格驗證,
    多一個設定鍵會讓 lint-check/doctor 對每個採用的專案判紅。
    回 {gate, budget_sec, per_cmd_floor_sec, max_file_lines, max_file_bytes, warnings}。"""
    import json
    cfg = dict(_LINT_NEW_DEFAULTS)
    cfg["warnings"] = []
    p = Path(repo_root) / ".lumos" / "config.json"
    if not p.is_file():
        return cfg
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except Exception as e:
        cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),新增告警閘用預設值")
        return cfg
    sec = data.get("lint_new") if isinstance(data, dict) else None
    if not isinstance(sec, dict):
        return cfg
    g = sec.get("gate", cfg["mode"])
    if g not in _LINT_NEW_GATE_MODES:
        cfg["warnings"].append(f"設定檔的 lint_new.gate={g!r} 不合法(只認 {'/'.join(_LINT_NEW_GATE_MODES)}),已用 {cfg['mode']}")
    else:
        cfg["mode"] = g
    for key in ("budget_sec", "per_cmd_floor_sec", "max_file_lines", "max_file_bytes"):
        v = sec.get(key, cfg[key])
        if isinstance(v, bool) or not isinstance(v, int) or v < 1:
            if key in sec:
                cfg["warnings"].append(f"設定檔的 lint_new.{key}={v!r} 不合法(要正整數),已用 {cfg[key]}")
        else:
            cfg[key] = v
    return cfg


def _lint_new_changed_files(repo_root, diff_range):
    """算這次要掃哪些檔,並把改名對回舊路徑。
    ★另開一支只給這道閘用的查詢★:既有那支 git diff -U3 同時餵給風險掃描、棧別提問、架構對照,
    在上面加改名偵測會悄悄改掉它們的既有輸出。
    回 ([(現在路徑, 基準路徑 or None), …], 錯誤訊息 or None);刪除的檔不收(沒有「現在」可掃)。"""
    import subprocess
    try:
        r = subprocess.run(["git", "-c", "core.quotePath=false", "diff", "--name-status",
                            "--find-renames", "-z", diff_range],
                           capture_output=True, text=True, errors="replace", cwd=str(repo_root))
    except FileNotFoundError:
        return ([], "這台機器找不到 git 指令")
    if r.returncode != 0:
        return ([], f"git 算不出 {diff_range} 這段差異:{r.stderr.strip()[:120]}")
    out, parts, i = [], r.stdout.split("\0"), 0
    while i < len(parts):
        status = parts[i]
        if not status:
            i += 1
            continue
        code = status[0]
        if code in ("R", "C"):          # 改名/複製:舊路徑、新路徑各一欄
            if i + 2 >= len(parts):
                break
            out.append((parts[i + 2], parts[i + 1]))
            i += 3
        elif code == "D":               # 刪除:沒有「現在」的內容可掃
            i += 2
        elif code == "A":               # 新增:基準版沒有這支檔,它的告警全算新增
            if i + 1 >= len(parts):
                break
            out.append((parts[i + 1], None))
            i += 2
        else:                           # M/T 等:兩邊同一條路徑
            if i + 1 >= len(parts):
                break
            out.append((parts[i + 1], parts[i + 1]))
            i += 2
    return (out, None)


# 工具要跑得起來,光有被掃的檔還不夠(2026-09-13 真專案實測):
# ①它的設定檔:eslint 的設定在子目錄裡,快照只有改動檔的話它找不到而直接拒跑
# ②它的依賴:eslint 要 node_modules 才載得了外掛——那不進版控,所以用連結指回真的專案
# ★設定檔一律取「現在版」★:兩次掃描要用同一份規則,基準版那次用舊設定的話比出來的差集沒有意義
_LINT_CONFIG_GLOBS = ("*.config.js", "*.config.mjs", "*.config.cjs", "*.config.ts",
                      ".eslintrc*", "package.json", "tsconfig*.json", "pyproject.toml",
                      "setup.cfg", "ruff.toml", ".ruff.toml", "detekt.yml", ".swiftlint.yml",
                      ".stylelintrc*", "stylelint.config.*", ".sqlfluff", "analysis_options.yaml")
_LINT_DEP_DIRS = ("node_modules", ".venv", "venv")
_LINT_CONFIG_MAX_BYTES = 200000     # 設定檔本來就小;超過這個大小的不像設定檔,不搬


def _lint_support_dirs(rel_paths):
    """被掃的那些檔的所有祖先目錄(含專案根),由淺到深。"""
    dirs = set()
    for rp in rel_paths:
        d = Path(rp).parent
        while True:
            dirs.add("" if d.as_posix() == "." else d.as_posix())
            if d.as_posix() in (".", "/", ""):
                break
            d = d.parent
    return sorted(dirs)


def _lint_copy_configs(repo_root, config_ref, real_dir, snap_dir, rel_dir):
    """把這一層的設定檔複製進快照。★一律取現在版★——兩次掃描要用同一份規則,
    基準版那次用舊設定的話,比出來的差集沒有意義。"""
    import subprocess
    for pat in _LINT_CONFIG_GLOBS:
        for f in real_dir.glob(pat):
            try:
                if not f.is_file() or f.stat().st_size > _LINT_CONFIG_MAX_BYTES:
                    continue
            except OSError:
                continue
            target = snap_dir / f.name
            if target.exists():
                continue
            rel = (Path(rel_dir) / f.name).as_posix() if rel_dir else f.name
            r = subprocess.run(["git", "show", f"{config_ref}:{rel}"],
                               capture_output=True, cwd=str(repo_root))
            try:
                target.write_bytes(r.stdout if r.returncode == 0 else f.read_bytes())
            except OSError:
                continue


def _lint_link_deps(real_dir, snap_dir):
    """依賴目錄用連結指回真的專案(那本來就不進版控,而工具要它才載得動外掛)。"""
    for dep in _LINT_DEP_DIRS:
        src, link = real_dir / dep, snap_dir / dep
        if src.is_dir() and not link.exists():
            try:
                link.symlink_to(src, target_is_directory=True)
            except OSError:
                pass


def _lint_new_support(repo_root, config_ref, rel_paths, dest):
    """把工具跑得起來需要的周邊東西放進快照:祖先目錄的設定檔(取現在版)+依賴目錄的連結。
    ★沒有這一步,需要專案脈絡的工具會整個跑不起來★——實測 eslint 對落在設定檔那棵樹之外的檔案直接拒跑。"""
    for rel_dir in _lint_support_dirs(rel_paths):
        real_dir = Path(repo_root) / rel_dir if rel_dir else Path(repo_root)
        snap_dir = Path(dest) / rel_dir if rel_dir else Path(dest)
        if not real_dir.is_dir():
            continue
        try:
            snap_dir.mkdir(parents=True, exist_ok=True)
        except OSError:
            continue
        _lint_copy_configs(repo_root, config_ref, real_dir, snap_dir, rel_dir)
        _lint_link_deps(real_dir, snap_dir)


def _lint_new_extract(repo_root, sha, pairs, dest, side):
    """把某一版的檔案內容逐檔取出來寫進 dest(保持相對路徑)。
    ★逐檔取,不整批打包★:整批打包時只要清單裡有一個檔在那一版不存在,整條指令 fatal 失敗、零輸出;
    逐檔取時「取不到」正好等於「這支在那一版不存在」,語意剛好就是我們要的。
    side='base' 用基準路徑、'head' 用現在路徑。回 {現在路徑: 解出來的絕對路徑};取不到的不列。"""
    import subprocess
    got = {}
    for now_path, base_path in pairs:
        want = base_path if side == "base" else now_path
        if want is None:
            continue
        r = subprocess.run(["git", "show", f"{sha}:{want}"],
                           capture_output=True, cwd=str(repo_root))
        if r.returncode != 0:
            continue
        target = Path(dest) / now_path
        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(r.stdout)
        except OSError:
            continue
        got[now_path] = str(target)
    return got


def _lint_new_norm_snippet(lines):
    """指紋用的片段正規化:每行去行尾空白、內部連續空白壓成一個、丟空行,★前導空白原樣保留★。
    保留縮排是刻意的取捨——抹掉縮排的話,「同一段程式碼被搬進另一個會執行的區塊」會比不出來,
    那是行為改變卻無聲放行、沒有補救;保留縮排的代價只是「整批重新縮排」會產生一批假新增,那有放行管道可處理。"""
    out = []
    for ln in lines:
        m = re.match(r"^([ \t]*)(.*?)[ \t]*$", ln.rstrip("\n"))
        if m is None:
            continue
        lead, body = m.group(1), re.sub(r"\s+", " ", m.group(2))
        if body:
            out.append(lead + body)
    return "\n".join(out)


_LINT_NEW_SEP = "\x00"   # 指紋各段之間的分隔(程式碼裡不會出現,不怕跟內容撞)


def _lint_new_key(claim, text_by_file):
    """一條告警的身分。回 (key, 是不是弱比對)。
    ★不能用行號當身分★:行號會因為上下文位移而變。優先用「命中處的程式碼片段」;
    工具沒附片段就自己去讀那幾行補上(實測:主流 Python 檢查器完全不附,所以自己補是常態不是例外);
    行號缺失、小於一、或超出檔案長度=取不到片段,退到「規則+檔名+訊息」的弱比對並標明。"""
    rule = claim.get("rule") or ""
    f = claim.get("file") or ""
    line = claim.get("line") or 0
    end = claim.get("end_line") or line
    lines = text_by_file.get(f)
    if lines and isinstance(line, int) and 1 <= line <= len(lines):
        hi = end if isinstance(end, int) and line <= end <= len(lines) else line
        snippet = _lint_new_norm_snippet(lines[line - 1:hi])
        if snippet:
            return (_LINT_NEW_SEP.join([rule, f, snippet]), False)
    return (_LINT_NEW_SEP.join([rule, f, "~msg~" + str(claim.get("message", ""))]), True)


def _lint_new_read_lines(path):
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None


def _lint_new_diff_claims(base_claims, head_claims, base_files, head_files):
    """比差集:同一個指紋出現幾次。★算次數不算有無★——基準版一次、現在版三次就是新增兩條;
    用「有沒有出現過」會讓複製貼上多出來的問題被吃掉。
    回 (新增的告警清單, 有幾條是弱比對)。"""
    from collections import Counter
    import hashlib as _hl
    base_text = {f: (_lint_new_read_lines(p) or []) for f, p in base_files.items()}
    head_text = {f: (_lint_new_read_lines(p) or []) for f, p in head_files.items()}
    base_count = Counter()
    for c in base_claims:
        k, _weak = _lint_new_key(c, base_text)
        base_count[k] += 1
    new, weak = [], 0
    seen = Counter()
    for c in head_claims:
        k, is_weak = _lint_new_key(c, head_text)
        seen[k] += 1
        if seen[k] > base_count.get(k, 0):
            c = dict(c)
            c["key"] = _hl.sha256(k.encode("utf-8")).hexdigest()[:16]
            c["weak"] = is_weak
            new.append(c)
            if is_weak:
                weak += 1
    return (new, weak)


def _lint_waivers_path(repo_root):
    return Path(repo_root) / _LINT_NEW_WAIVERS_REL


def _lint_waivers_load(repo_root):
    """讀放行檔。回 ({指紋: 那筆紀錄}, 錯誤訊息 or None)。
    ★讀不了時不可以當成「沒有放行紀錄」★——那會讓所有既有放行瞬間復活、整批擋人;
    回錯誤訊息讓呼叫端歸進「環境不可用」。"""
    import json
    p = _lint_waivers_path(repo_root)
    if not p.is_file():
        return ({}, None)
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except Exception as e:
        return ({}, "放行檔讀不了(" + e.__class__.__name__ + "):" + _LINT_NEW_WAIVERS_REL)
    items = data.get("waivers") if isinstance(data, dict) else None
    if not isinstance(items, list):
        return ({}, "放行檔格式不對(要有 waivers 清單):" + _LINT_NEW_WAIVERS_REL)
    out = {}
    for it in items:
        if isinstance(it, dict) and isinstance(it.get("key"), str):
            out[it["key"]] = it
    return (out, None)


def _lint_waivers_add(repo_root, key, rule, file_rel, reason, who):
    """加一筆放行。★讀-改-寫要上鎖★:只做原子換名不夠——兩個工作階段同時放行不同指紋,
    後寫的會整份蓋掉先寫的,一條放行就這樣靜默消失(既有 _write_lf 的說明也講了讀改寫要呼叫端上鎖)。"""
    import json
    import time as _time
    p = _lint_waivers_path(repo_root)
    with _vault_write_lock(p):
        cur, err = _lint_waivers_load(repo_root)
        if err:
            return (False, err)
        if key in cur:
            return (False, "這個指紋已經放行過了(" + key + ")")
        items = list(cur.values())
        items.append({"key": key, "rule": rule, "file": file_rel, "reason": reason,
                      "by": who, "ts": _time.strftime("%Y-%m-%dT%H:%M:%S")})
        p.parent.mkdir(parents=True, exist_ok=True)
        _write_lf(p, json.dumps({"waivers": items}, ensure_ascii=False, indent=2) + "\n")
    return (True, None)


def _lint_new_clean_stale(repo_root):
    """開跑前清掉同前綴、超過一天的殘骸。★強殺(機器休眠判死)時收尾不會執行★,
    殘骸會留在專案底下那個被忽略的目錄裡;每次名字不同所以不會污染下一次比對,但要有人掃。"""
    import shutil
    import time as _time
    base = Path(repo_root) / ".lumos"
    if not base.is_dir():
        return
    now = _time.time()
    for d in base.glob("lintbase-*"):
        try:
            if d.is_dir() and now - d.stat().st_mtime > _LINT_NEW_STALE_SEC:
                shutil.rmtree(d, ignore_errors=True)
        except OSError:
            continue


def _lint_new_oversize(head_files, base_files, cfg):
    """挑出「太大所以不掃」的檔,並從兩邊的清單裡拿掉。回 [{file,lines,bytes,key,over}…]。
    ★大檔也要有指紋才放行得掉★:綁路徑不綁內容——那支檔會一直很大,綁內容的話每改一次就要重新登記。
    ★只看行數會被「整支檔只有一行」的壓縮檔騙過去★,所以兩個門檻都看。"""
    import hashlib as _hl
    out = []
    for f, path in list(head_files.items()):
        try:
            raw = Path(path).read_bytes()
        except OSError:
            continue
        n_bytes, n_lines = len(raw), raw.count(b"\n") + 1
        if n_lines <= cfg["max_file_lines"] and n_bytes <= cfg["max_file_bytes"]:
            continue
        key = _hl.sha256(("oversize" + _LINT_NEW_SEP + f).encode("utf-8")).hexdigest()[:16]
        out.append({"file": f, "lines": n_lines, "bytes": n_bytes, "key": key,
                    "over": "行數" if n_lines > cfg["max_file_lines"] else "位元組數"})
        head_files.pop(f, None)
        base_files.pop(f, None)
    return out


def _lint_new_classify(out, cfg):
    """把跑完的結果判成擋或不擋(就地改 out)。★兩類失敗分開★:
    環境不可用(工具沒裝/逾時/拉不到規則/放行檔讀不了)→自動放行並記帳;
    真的有未放行的新增告警、檔太大沒被檢查、預算不足沒跑到的命令→擋,逃生門是人手動放行寫理由。"""
    env_undone = [u for u in out["undone"] if u["kind"] == "env"]
    hard_undone = [u for u in out["undone"] if u["kind"] != "env"]
    if env_undone:
        out["autopass"] = True
    hard = bool(out["new"]) or bool(out["oversize"]) or bool(hard_undone)
    if hard and cfg["mode"] == "block":
        bits = []
        if out["new"]:
            bits.append("%d 條新增告警" % len(out["new"]))
        if out["oversize"]:
            bits.append("%d 支檔太大沒被檢查" % len(out["oversize"]))
        if hard_undone:
            bits.append("%d 條命令因為時間預算沒跑到" % len(hard_undone))
        out["status"], out["blocked"], out["reason"] = "blocked", True, "、".join(bits)
    elif hard:
        out["status"], out["reason"] = "warn", "設定檔把這道閘設成只報告,不擋"
    elif env_undone:
        out["status"] = "env-unavailable"
        out["reason"] = "有命令跑不動(已自動放行並記帳)"
    elif not out["ran"] and out["report_only"]:
        # ★一條都沒跑就不准說「乾淨」★:宣告沒帶檔案清單佔位的命令會被降級成只報不擋,
        # 全部都是這種的時候等於整道閘沒作用。原本這裡回 clean,收尾行就寫成「沒有新增的告警」——
        # 那句話會讓人以為檢查過了。真機坐實:某個 742 支檔的專案五條宣告沒有一條帶佔位。
        out["status"] = "not-checked"
        out["reason"] = ("宣告的 %d 條檢查命令都沒有 {LINT_FILES} 佔位,一條都沒跑"
                         "——這次改動其實沒有被檢查" % len(out["report_only"]))
    else:
        out["status"] = "clean"
        out["reason"] = "沒有新增的告警"


def _lint_new_verdict(repo_root, diff_range, deadline=None):
    """新增告警閘的判定——這道閘只問一件事:這次改動有沒有帶進新的告警。
    回 dict{status, blocked, mode, new, waived, weak, oversize, undone, autopass, ran, report_only, reason, warnings}。
    status:off(關掉) / no-config(沒宣告檢查工具) / no-files(沒有要掃的檔) / not-checked(宣告都沒帶檔案清單佔位,一條都沒跑) / clean / blocked / env-unavailable
    ★兩類失敗分開★:環境不可用(工具沒裝、命令逾時、拉不到規則、版本代號解析不出、放行檔讀不了)
    →自動放行並自動記一筆帳;真的有未放行的新增告警、或檔太大沒被檢查→擋,逃生門是人手動放行寫理由。"""
    import os
    import shutil
    import subprocess
    import tempfile
    import time as _time

    out = {"status": "clean", "blocked": False, "mode": "block", "new": [], "waived": 0,
           "weak": 0, "oversize": [], "oversize_waived": [], "undone": [], "autopass": False, "ran": [],
           "report_only": [], "reason": "", "warnings": []}

    cfg = _lint_new_config(repo_root)
    out["mode"] = cfg["mode"]
    out["warnings"] = cfg["warnings"]
    if os.environ.get("LUMOS_SKIP_LINT_NEW"):
        out["status"], out["reason"] = "off", "環境變數 LUMOS_SKIP_LINT_NEW 有設,整道閘關掉"
        return out
    if cfg["mode"] == "off":
        out["status"], out["reason"] = "off", "設定檔把這道閘設成 off"
        return out

    lint_cfg = _lint_load_config(repo_root) or {}
    _dep_probe, _ = _lint_deps_load(repo_root)
    if not lint_cfg and not _dep_probe:
        out["status"], out["reason"] = "no-config", "這個專案沒有宣告任何檢查工具(.lumos/lint.json 與 .lumos/lint-deps.json 都不在)"
        return out

    # 版本代號:兩端都要解析得出來,任一端解析不出(例如只給單一參考點、終點其實是工作樹)就是環境不可用
    base_ref, head_ref = _diff_range_ends(repo_root, diff_range)
    if not base_ref or not head_ref:
        out.update(status="env-unavailable", autopass=True,
                   reason="這段範圍算不出「改動前」與「現在」兩個版本代號(終點可能是工作目錄),不硬猜")
        return out

    pairs_all, err = _lint_new_changed_files(repo_root, diff_range)
    if err:
        out.update(status="env-unavailable", autopass=True, reason=err)
        return out
    # 兩路分開:程式碼檔走既有的「要不要掃」過濾;依賴宣告檔走自己的判斷
    # (那個過濾把 .json/.txt/.lock 整批當成非程式碼擋掉,依賴宣告檔大多是那幾種副檔名)
    code_pairs = [(a, b) for (a, b) in pairs_all if _stack_changed_ok(a)]
    dep_pairs = [(a, b) for (a, b) in pairs_all if _is_dep_manifest(a)]
    pairs = code_pairs + [x for x in dep_pairs if x not in code_pairs]
    if not pairs:
        out["status"], out["reason"] = "no-files", "這次改動沒有要掃的程式碼檔或依賴宣告檔"
        return out

    dep_cmds, dep_err = _lint_deps_load(repo_root)
    if dep_err:
        out.update(status="env-unavailable", autopass=True, reason=dep_err)
        return out
    cmd_targets = _lint_new_cmd_targets(code_pairs, dep_pairs, lint_cfg, dep_cmds,
                                        repo_root=repo_root, ref=head_ref)
    if not cmd_targets:
        out["status"], out["reason"] = "no-files", "這次改動的副檔名沒有對應的檢查工具宣告"
        return out

    waivers, werr = _lint_waivers_load(repo_root)
    if werr:
        out.update(status="env-unavailable", autopass=True, reason=werr)
        return out

    _lint_new_clean_stale(repo_root)
    root = Path(repo_root) / ".lumos"
    root.mkdir(parents=True, exist_ok=True)
    work = tempfile.mkdtemp(prefix="lintbase-", dir=str(root))

