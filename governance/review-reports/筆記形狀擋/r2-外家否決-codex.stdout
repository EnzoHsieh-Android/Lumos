 23058	def _nodehome_candidates(f, homes, side):
 23059	    """[S6] 候選家:同資料夾其他檔的家、正文用反引號提到它的節點。"""
 23060	    d = f.rsplit("/", 1)[0] if "/" in f else ""
 23061	    cand = []
 23062	    for g, hs in sorted(homes.items()):
 23063	        if g != f and (g.rsplit("/", 1)[0] if "/" in g else "") == d:
 23064	            cand.extend(h for h in hs if h not in cand)
 23065	    base = f.rsplit("/", 1)[-1]
 23066	    for rel, n in sorted(side.notes.items()):
 23067	        if rel not in cand and (f in n["text"] or f"`{base}`" in n["text"]):
 23068	            cand.append(rel)
 23069	    return cand[:3]
