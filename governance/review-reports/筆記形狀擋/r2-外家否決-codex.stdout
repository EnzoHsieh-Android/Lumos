 22520	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22521	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
 22522	    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
 22523	    lst = _nodehome_list(repo_root, where)
 22524	    if lst is None:
 22525	        return None
 22526	    s = _NodehomeSide()
 22527	    s.files, s.all_paths = lst
 22528	    s.where = where
 22529	    s._reader = _nodehome_reader(repo_root, where)
 22530	    s.shebang = {}
 22531	    s.share = share
 22532	    s.changed = set(changed or ())
 22533	    s.notes = {}
 22534	    pre = vault_rel + "/Systems/"
 22535	    for p in s.files:
 22536	        if p.startswith(pre) and p.endswith(".md"):
 22537	            rel = p[len(vault_rel) + 1:]
 22538	            if share is not None and p not in s.changed and rel in share.notes:
 22539	                s.notes[rel] = share.notes[rel]
 22540	                continue
 22541	            raw = s._reader(p)
 22542	            if raw is not None:
 22543	                s.notes[rel] = _nodehome_parse_note(raw)
 22544	    return s
