 22655	def _nodehome_name_status(raw):
 22656	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
 22657	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 22658	    while i < len(toks):
 22659	        code = toks[i][:1]
 22660	        if code in ("R", "C") and i + 2 < len(toks):
 22661	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 22662	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 22663	            if code == "R":
 22664	                gone.add(nfc(toks[i + 1]))
 22665	            i += 3
 22666	        elif i + 1 < len(toks):
 22667	            paths.add(nfc(toks[i + 1]))
 22668	            if code == "D":
 22669	                gone.add(nfc(toks[i + 1]))
 22670	            i += 2
 22671	        else:
 22672	            break
 22673	    return paths, src, gone - set(src)
 22674	
