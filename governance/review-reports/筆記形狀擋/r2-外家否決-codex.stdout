 22462	def _nodehome_reader(repo_root, where):
 22463	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 22464	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 22465	    if where is None:
 22466	        return lambda p: None
 22467	    disk_ok_all = False
 22468	    differ = None
 22469	    if where == "index":
 22470	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 22471	    else:
 22472	        head = _lens_full_sha(repo_root, "HEAD")
 22473	        if head and head == where:
 22474	            differ = _nodehome_changed_vs_disk(repo_root, where)
 22475	    root = Path(repo_root)
 22476	    spec = "" if where == "index" else where
 22477	
 22478	    def read(p):
 22479	        if differ is not None and p not in differ:
 22480	            fp = root / p
 22481	            try:
 22482	                if fp.is_file() and not fp.is_symlink():
 22483	                    return fp.read_bytes()
 22484	            except OSError:
 22485	                pass
 22486	        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
 22487	        if r is None or r.returncode != 0:
 22488	            return None
 22489	        return r.stdout
 22490	    return read
 22491	
