 22779	def _nodehome_commit_groups(repo_root, base, tip):
 22780	    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
 22781	    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
 22782	    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
 22783	    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
 22784	    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
 22785	    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
 22786	    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
 22787	    if raw is None:
 22788	        return None
 22789	    out = []
 22790	    for line in raw.decode("ascii", errors="replace").splitlines():
 22791	        shas = line.split()
 22792	        if not shas:
 22793	            continue
 22794	        sha, parents = shas[0], shas[1:]
 22795	        if len(parents) <= 1:
 22796	            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
 22797	            if r is None:
 22798	                return None
 22799	            paths, src, gone = _nodehome_name_status(r)
 22800	        else:
 22801	            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
 22802	            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
 22803	            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
 22804	            if rm is not None:
 22805	                paths, src, gone = rm
 22806	            else:
 22807	                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
 22808	                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
 22809	                per = []
 22810	                for p in parents:
 22811	                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22812	                    if r is None:
 22813	                        return None
 22814	                    per.append(_nodehome_name_status(r))
 22815	                paths = set.intersection(*(x[0] for x in per))
 22816	                src = {k: v for k, v in per[0][1].items() if k in paths}
 22817	                gone = set.intersection(*(x[2] for x in per))
 22818	        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
 22819	    return out
