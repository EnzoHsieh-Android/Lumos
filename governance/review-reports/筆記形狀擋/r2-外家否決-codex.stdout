 19849	    if lo == hi:
 19850	        return "ok", file_lines[lo - 1]
 19851	    return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]
 19852	
 19853	
 19854	def _node_code_ref_tokens(text, top_dirs):
 19855	    """節點文字裡用反引號寫的程式路徑引用,回 (full, bare):
 19856	    full=含 / 且頂層目錄存在的 (token, 行號) 清單(依出現順序、去重,帶 :行號 的剝成第二欄);bare=不含 / 的裸 token 集合。
 19857	    ★refcheck、改檔前推筆記、每支檔有家三處共用這一支★——推筆記認得的,跟每支檔有家認得的,一定一樣
 19858	    (兩套算法一定分岔,而分岔時沒有東西會翻紅;Projects/每支檔有家_計劃 [S7])。"""
 19859	    _suffix_re = re.compile(r":([^/]+)$")
 19860	    # ★不可換回 FENCE_RE★(見 _visible_lines):此處餵 G1 硬閘與 impact hook
 19861	    spans = [s.strip("`") for s in INLINE_CODE_RE.findall(_strip_fences_text(text))]
 19862	    seen = set()
 19863	    full = []
 19864	    for raw in spans:
 19865	        if "://" in raw or any(c in raw for c in "*<>?"):
 19866	            continue
 19867	        m = _suffix_re.search(raw)
 19868	        if m:
 19869	            token, sfx = raw[:m.start()], m.group(1)
 19870	            line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
 19871	        else:
 19872	            token, line = raw, ""
 19873	        if "/" not in token or (token, line) in seen:
 19874	            continue
 19875	        if token.split("/")[0] not in top_dirs:
 19876	            continue
 19877	        seen.add((token, line))
 19878	        full.append((token, line))
 19879	    return full, {s for s in spans if "/" not in s}
 19880	
 19881	
 19882	def _refcheck_scan(text, repo_root):
 19883	    """refcheck 抽取+核對核心(不列印):回 (claims, n_missing, n_oor, n_ok)。
 19884	    cmd_refcheck 與 loop status --gate(G1 錨)共用;抽取規則見 cmd_refcheck docstring。
 19885	    核對段走 _validate_repo_ref(與 Check J 共用);抽取段(inline-code+top_dirs 過濾)維持原規則。"""
 19886	    top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
 19887	    full, _bare = _node_code_ref_tokens(text, top_dirs)
 19888	    claims = []
 19889	    for token, line in full:
 19890	        status, excerpt = _validate_repo_ref(repo_root, token, line)
 19891	        claim = {"token": token, "line": line, "status": status, "excerpt": excerpt}
 19892	        if status == "ok" and (repo_root / token).is_dir():
 19893	            claim["dir"] = True
 19894	        claims.append(claim)
 19895	
 19896	    n_missing = sum(1 for c in claims if c["status"] == "missing")
 19897	    n_oor = sum(1 for c in claims if c["status"] == "line_out_of_range")
 19898	    n_ok = sum(1 for c in claims if c["status"] == "ok")
 19899	    return claims, n_missing, n_oor, n_ok
