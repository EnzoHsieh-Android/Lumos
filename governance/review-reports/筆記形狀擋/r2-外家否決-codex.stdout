 22625	def _nodehome_changes(repo_root, base, tip):
 22626	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22627	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22628	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22629	    if tip == "index":
 22630	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22631	        if base is None:
 22632	            args.append(_EMPTY_TREE_SHA)
 22633	    else:
 22634	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 22635	    raw = _nodehome_git(repo_root, *args)
 22636	    if raw is None:
 22637	        return None
 22638	    toks = _nodehome_split_z(raw)
 22639	    out, i = [], 0
 22640	    while i < len(toks):
 22641	        st = toks[i]
 22642	        code = st[:1]
 22643	        if code in ("R", "C") and i + 2 < len(toks):
 22644	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 22645	            i += 3
 22646	        elif i + 1 < len(toks):
 22647	            p = nfc(toks[i + 1])
 22648	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 22649	            i += 2
 22650	        else:
 22651	            break
 22652	    return out
 22653	
 22654	
 22655	def _nodehome_name_status(raw):
 22656	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
 22657	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 22658	    while i < len(toks):
 22659	        code = toks[i][:1]
 22660	        if code in ("R", "C") and i + 2 < len(toks):
 22661	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 22662	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 22663	            if code == "R":
 22664	                gone.add(nfc(toks[i + 1]))
 22665	            i += 3
 22666	        elif i + 1 < len(toks):
 22667	            paths.add(nfc(toks[i + 1]))
 22668	            if code == "D":
 22669	                gone.add(nfc(toks[i + 1]))
 22670	            i += 2
 22671	        else:
 22672	            break
 22673	    return paths, src, gone - set(src)
 22674	
 22675	
 22676	def _nodehome_merge_own_changes(repo_root, sha, parents):
 22677	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 22678	
 22679	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 22680	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 22681	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 22682	    或順手多改的部分,正是這道檢查要看的。
 22683	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 22684	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 22685	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 22686	    """
 22687	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 22688	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22689	        return None
 22690	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 22691	                      "--name-status", "-z", "-M", sha)
 22692	    if r is None:
 22693	        return None
 22694	    paths, src, gone = _nodehome_name_status(r)
 22695	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 22696	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 22697	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 22698	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 22699	    for p in parents:
 22700	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22701	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22702	    order = sorted(paths)
 22703	    specs = []
 22704	    for x in order:
 22705	        specs.append(f"{sha}:{x}")
 22706	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 22707	    blobs = _nodehome_cat_blobs(repo_root, specs)
 22708	    if blobs is None or any(ren is None for _, ren in pairs):
 22709	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 22710	        return paths, src, gone
 22711	    kept = set()
 22712	    for n, x in enumerate(order):
 22713	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 22714	        if _nodehome_merge_wrote_new_lines(merged, olds):
 22715	            kept.add(x)
 22716	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 22717	
 22718	
 22719	def _nodehome_cat_blobs(repo_root, specs):
 22720	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22721	
 22722	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22723	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22724	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 22725	    import subprocess as _sp
 22726	    if not specs:
 22727	        return []
 22728	    if any("\n" in s_ for s_ in specs):
 22729	        return None
 22730	    try:
 22731	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22732	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22733	                    capture_output=True, timeout=60)
 22734	    except (OSError, _sp.TimeoutExpired):
 22735	        return None
 22736	    if r.returncode != 0:
 22737	        return None
 22738	    out, pos, res = r.stdout, 0, []
 22739	    for _ in specs:
 22740	        nl = out.find(b"\n", pos)
 22741	        if nl < 0:
 22742	            return None
 22743	        head = out[pos:nl].split(b" ")
 22744	        pos = nl + 1
 22745	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22746	            size = int(head[2])
 22747	            res.append(out[pos:pos + size])
 22748	            pos += size + 1
 22749	        elif len(head) == 3 and head[2].isdigit():
 22750	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22751	            res.append(None)
 22752	        else:
 22753	            res.append(None)            # missing / ambiguous
 22754	    return res
 22755	
 22756	
 22757	def _nodehome_merge_wrote_new_lines(merged, olds):
 22758	    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。
 22759	
 22760	    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
 22761	    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
 22762	    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
 22763	    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
 22764	    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
 22765	    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
 22766	    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
 22767	    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
 22768	    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
 22769	    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
 22770	    if merged is None or b"\0" in merged:
 22771	        return True
 22772	    seen = set()
 22773	    for blob in olds:
 22774	        if blob is not None:
 22775	            seen.update(ln.strip() for ln in blob.split(b"\n"))
 22776	    return any(ln.strip() and ln.strip() not in seen for ln in merged.split(b"\n"))
 22777	
 22778	
 22779	def _nodehome_commit_groups(repo_root, base, tip):
 22780	    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
 22781	    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
 22782	    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
 22783	    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
 22784	    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
 22785	    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
 22786	    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
 22787	    if raw is None:
 22788	        return None
 22789	    out = []
 22790	    for line in raw.decode("ascii", errors="replace").splitlines():
 22791	        shas = line.split()
 22792	        if not shas:
 22793	            continue
 22794	        sha, parents = shas[0], shas[1:]
 22795	        if len(parents) <= 1:
 22796	            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
 22797	            if r is None:
 22798	                return None
 22799	            paths, src, gone = _nodehome_name_status(r)
 22800	        else:
 22801	            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
 22802	            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
 22803	            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
 22804	            if rm is not None:
 22805	                paths, src, gone = rm
 22806	            else:
 22807	                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
 22808	                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
 22809	                per = []
 22810	                for p in parents:
 22811	                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22812	                    if r is None:
 22813	                        return None
 22814	                    per.append(_nodehome_name_status(r))
 22815	                paths = set.intersection(*(x[0] for x in per))
 22816	                src = {k: v for k, v in per[0][1].items() if k in paths}
 22817	                gone = set.intersection(*(x[2] for x in per))
 22818	        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
 22819	    return out
 22820	
 22821	
 22822	def _nodehome_mark_note_content(repo_root, groups, vault_rel):
 22823	    """推送前逐提交看寫回:每個提交裡,哪幾篇 Systems 節點的內容(摘要、決策、正文)是在這個提交改的——只補驗證連結、
 22824	    計劃連結這類簿記欄位的不算——以及那篇在這個提交前後管哪些檔。在讀取這一層先算好放進分組的 content_notes
 22825	    {這個提交之後的路徑: {type, status, own}},判定那層只在同一個提交裡比「管的檔」跟「改的程式」,不必跨提交追名字
 22826	    (合併進來的平行分支、一次推送改名好幾次都不影響——代碼審 r2 單reviewer)。這個提交裡改名的,拿改名前的路徑去
 22827	    上一個提交讀;這個提交才新開的算有變;讀不到一律當有變,照原本那樣查。"""
 22828	    pre = vault_rel + "/Systems/"
 22829	    for g in groups or ():
 22830	        after = _nodehome_reader(repo_root, g["sha"])
 22831	        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
 22832	        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
 22833	        notes = {}
 22834	        for p in g["paths"]:
 22835	            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
 22836	                continue
 22837	            new = after(p)
 22838	            n = _nodehome_parse_note(new) if new is not None else None
 22839	            olds = [b(g["src"].get(p, p)) for b in befores]
 22840	            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
 22841	            if n is not None and any(o["sig"] == n["sig"] for o in olds):
 22842	                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
 22843	            own, statuses = set(), set()
 22844	            for x in [n] + olds:
 22845	                if x is not None:
 22846	                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
 22847	                    statuses.add(x["status"])
 22848	            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
 22849	            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
 22850	        g["content_notes"] = notes
 22851	    return groups
 22852	
