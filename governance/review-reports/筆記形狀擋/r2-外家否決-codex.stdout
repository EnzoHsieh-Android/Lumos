 22854	def _nodehome_golive(repo_root, tip):
 22855	    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。"""
 22856	    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{_NODEHOME_GOLIVE_MARK}",
 22857	                        tip or "HEAD", "--", "scripts/hooks/pre-commit")
 22858	    if not raw:
 22859	        return None
 22860	    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
 22861	    return first if _LENS_SHA_RE.match(first) else None
 22862	
 22863	
 22864	def _nodehome_clamp_base(repo_root, base, tip):
 22865	    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
 22866	    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。"""
 22867	    gl = _nodehome_golive(repo_root, tip)
 22868	    if gl is None:
 22869	        return base
 22870	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
 22871	    if r is None or r.returncode != 0:
 22872	        return base                                    # 上線點不在這條歷史上
 22873	    if base in (None, _EMPTY_TREE_SHA):
 22874	        return gl
 22875	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
 22876	    return gl if (r is not None and r.returncode == 0 and base != gl) else base
 22877	
