 22547	def _nodehome_required(repo_root, side, cfg, vendored_skip):
 22548	    """[S1] 需要家的檔集合,另回檔名不是 UTF-8 的程式檔(永遠寫不進圖譜,只提醒改名或排除)。"""
 22549	    import fnmatch
 22550	    req, bad_names = set(), set()
 22551	    layout = _nodehome_layout(side.all_paths)   # 測試資料夾要旁邊的程式目標有同一種檔
 22552	    for p in side.files:
 22553	        kind = _nodehome_code_kind(p)
 22554	        if kind is None:
 22555	            continue
 22556	        if any(fnmatch.fnmatch(p, g) for g in _NODEHOME_EXCLUDE_GLOBS):
 22557	            continue
 22558	        if p in vendored_skip or _cochange_excluded(p, cfg["ignore"]) or _nodehome_is_test(p, layout):
 22559	            continue
 22560	        if kind == "shebang?":
 22561	            if p in side.shebang:
 22562	                ok = side.shebang[p]
 22563	            elif side.share is not None and p not in side.changed and p in side.share.shebang:
 22564	                ok = side.shebang[p] = side.share.shebang[p]
 22565	            else:
 22566	                head = side._reader(p)
 22567	                ok = side.shebang[p] = _head_is_shebang(head)
 22568	            if not ok:
 22569	                continue
 22570	        try:
 22571	            p.encode("utf-8")
 22572	        except UnicodeEncodeError:
 22573	            bad_names.add(p)
 22574	            continue
 22575	        req.add(p)
 22576	    return req, bad_names
