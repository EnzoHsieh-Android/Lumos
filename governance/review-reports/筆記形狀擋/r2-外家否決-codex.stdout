 22607	def _nodehome_refs(text, side, req):
 22608	    """[S7][S8] 這篇用反引號寫到哪幾支需要家的檔:抽取跟改檔前推筆記同一支(完整路徑+在受版控檔裡唯一的裸檔名)。
 22609	    裸檔名不唯一時推筆記那支不認它,這裡也不認——不構成「別人檔的入口」,就不算認領。"""
 22610	    top_dirs = _nodehome_top_dirs(side.all_paths)
 22611	    full, bare = _node_code_ref_tokens(text, top_dirs)
 22612	    refs = {nfc(t) for t, _l in full if nfc(t) in req}
 22613	    if int(_impact_knob("LUMOS_IMPACT_BASENAME_MATCH", 1)):
 22614	        counts, where = {}, {}
 22615	        for p in side.all_paths:
 22616	            b = p.rsplit("/", 1)[-1]
 22617	            counts[b] = counts.get(b, 0) + 1
 22618	            where[b] = p
 22619	        for b in bare:
 22620	            if counts.get(b) == 1 and where[b] in req:
 22621	                refs.add(where[b])
 22622	    return refs
 22623	
