 27435	def _lens_full_sha(repo_root, rev):
 27436	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 27437	    if r is None or r.returncode != 0:
 27438	        return None
 27439	    sha = r.stdout.strip()
 27440	    return sha if _LENS_SHA_RE.match(sha) else None
