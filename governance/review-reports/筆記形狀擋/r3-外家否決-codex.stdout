 18321	def _quote_norm(s):
 18322	    """quote-check 的唯一正規化(T2 design-loop重設計):NFC → 剝 markdown 強調記號(*/`)
 18323	    → 空白(含全形\u3000/換行)摺疊單空格。★抽取與比對共用這一份——嚴禁第二份實作★
 18324	    (2026-08-02 教訓:預檢與主迴圈兩份實作當場漂移)。不做 lower(保留大小寫語意)。"""
 18325	    import re
 18326	    import unicodedata
 18327	    s = unicodedata.normalize("NFC", s)
 18328	    # Landmark 真場實測(2026-08-04):blockquote 折行的續行 > 記號會進 hay,引句永遠比不中
 18329	    s = re.sub(r"(?m)^\s*>\s?", "", s)
 18330	    s = s.replace("*", "").replace("`", "")
 18331	    return " ".join(s.split())
