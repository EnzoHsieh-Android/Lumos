 19873	        if "/" not in token or (token, line) in seen:
 19874	            continue
 19875	        if token.split("/")[0] not in top_dirs:
 19876	            continue
 19877	        seen.add((token, line))
 19878	        full.append((token, line))
 19879	    return full, {s for s in spans if "/" not in s}
