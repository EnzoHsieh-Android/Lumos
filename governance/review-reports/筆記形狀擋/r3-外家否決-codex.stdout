  4537	def _git_commit_exists(repo_root, sha):
  4538	    """[git:sha] Tier B 驗證:git cat-file -e sha^{commit}。非 git repo/物件缺 → False。"""
  4539	    import subprocess
  4540	    try:
  4541	        r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=str(repo_root),
  4542	                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
  4543	        return r.returncode == 0
  4544	    except OSError:
  4545	        return False
  4546	
  4547	
  4548	def _git_is_shallow(repo_root):
  4549	    import subprocess
  4550	    try:
  4551	        r = subprocess.run(["git", "rev-parse", "--is-shallow-repository"], cwd=str(repo_root),
  4552	                           capture_output=True, text=True, errors="replace")
  4553	        return r.returncode == 0 and r.stdout.strip() == "true"
  4554	    except OSError:
  4555	        return False
