  4532	# ★2026-09-15 放寬:認得連字號★——原本 ^([A-Z]{2,}): 只吃連續大寫,
  4533	# 含連字號的前綴整行躲過檢查(打成 PRIOR-ARTT: 也沒人唸)。
  4534	SYMBOLISH_RE = re.compile(r"^([A-Z][A-Z-]*[A-Z]):")   # 像「符號宣告」的行→ 抓 typo
