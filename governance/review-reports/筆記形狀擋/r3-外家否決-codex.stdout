 20305	def _lint_aligned(diff_range, repo_root):
 20306	    """判斷 diff_range 右端 ref 是否與工作區 HEAD 對齊(座標系一致)。
 20307	    右端:先 rsplit('...', 1) 再 rsplit('..', 1);空→HEAD;無 .. → 工作區比較恆 True。
 20308	    對齊 = git rev-parse <right> == git rev-parse HEAD 且 git status --porcelain 空。
 20309	    任何子程序失敗 → False。"""
 20310	    import subprocess
 20311	    # 提取右端 ref
 20312	    if "..." in diff_range:
 20313	        right = diff_range.rsplit("...", 1)[1]
 20314	    elif ".." in diff_range:
 20315	        right = diff_range.rsplit("..", 1)[1]
 20316	    else:
 20317	        # 無 .. → 工作區比較,恆對齊
 20318	        return True
 20319	    if not right:
 20320	        right = "HEAD"
 20321	    try:
 20322	        r_right = subprocess.run(
 20323	            ["git", "rev-parse", right],
 20324	            capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 20325	        r_head = subprocess.run(
 20326	            ["git", "rev-parse", "HEAD"],
