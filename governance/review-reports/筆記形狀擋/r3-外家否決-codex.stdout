 23693	def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
 23694	    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
 23695	    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
 23696	    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
 23697	    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
 23698	    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
 23699	    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
 23700	    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
 23701	    import re, subprocess
 23702	    if not tokens:
 23703	        return {}
 23704	    cmd = ["git", "-c", "core.quotePath=off", "grep", "--cached", "-n", "-I", "-w", "-F"]
 23705	    for t in tokens:
 23706	        cmd += ["-e", t]
 23707	    cmd += ["--", ".", f":(exclude){graph_root}"]
 23708	    for d in _DELGUARD_ALL_EXCLUDE_DIRS:
 23709	        cmd += [f":(exclude){d.rstrip('/')}"]
 23710	    r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", cwd=repo_root, timeout=timeout)

