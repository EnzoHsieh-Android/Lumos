 26445	def _home_confirmed(text, path, top_dirs, all_paths):
 26446	    # ★路徑比對區分大小寫,這是刻意的★(代碼審 r1 邊界席提出,編排者裁):git 記錄的路徑是權威,
 26447	    # 而 `Foo.py` 與 `foo.py` 在一般系統上就是兩支不同的檔——做大小寫不敏感比對,會讓兩支真的
 26448	    # 同名不同大小寫的檔互相認到對方的家。代價是使用者大小寫打錯時只會「少推」不會「多推」,
 26449	    # 方向安全,而且健檢的「管了卻沒提到」那段會把它唸出來。
 26450	    """[S2] 這篇算不算這支檔「確認過的家」:摘要或正文寫出完整路徑,或反引號裡寫出在受版控檔裡唯一的裸檔名。
 26451	    沒確認的家不保送、不加分——about_code 的品質沒有機械保證,分兩級讓填錯的家大多落在不保送那一級。"""
 26452	    full, bare = _node_code_ref_tokens_all(_home_scan_text(text), top_dirs)
 26453	    if nfc(_posix_norm(path)) in {nfc(t) for t, _l in full}:
 26454	        return True
 26455	    base = path.rsplit("/", 1)[-1]
 26456	    if base not in bare:
 26457	        return False
 26458	    return sum(1 for p in all_paths if p.rsplit("/", 1)[-1] == base) == 1
 26459	
