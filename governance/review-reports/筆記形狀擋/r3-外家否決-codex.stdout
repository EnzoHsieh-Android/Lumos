 22184	def _nodehome_config(repo_root, text=None, from_snapshot=False):
 22185	    """讀 node_home 設定。回 {mode: on|warn|off, max_files: int, ignore: [str], warnings: [str]};壞值一律退回預設並留一句。
 22186	    from_snapshot=True:text 是被檢查那個版本裡 .lumos/config.json 的內容(None=那個版本沒有這支檔)——
 22187	    ★提交前讀提交索引、推送前讀終點那個提交★,不讀工作目錄(工作目錄裡沒暫存的「關掉」不得關掉提交索引的檢查)。
 22188	    from_snapshot=False:直讀工作目錄(健檢開頭那一行用;同 _stack_questions_config 慣例)。
 22189	    ★鍵叫 mode 不叫 gate★:治理閘名的漂移掃描會把 gate 鍵的字面值當閘名(同 _stack_questions_config)。"""
 22190	    cfg = {"mode": "on", "max_files": _NODEHOME_MAX_FILES_DEFAULT, "ignore": [], "warnings": []}
 22191	    if from_snapshot:
 22192	        if text is None:
 22193	            return cfg
 22194	        raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 22195	    else:
 22196	        p = Path(repo_root) / ".lumos" / "config.json"
 22197	        # 捷徑檔不跟過去讀:跟讀快照那條路一樣(git 裡的捷徑檔讀出來是目標路徑字串,解析失敗退預設)——
 22198	        # 不然設定檔被做成指到本機任意檔的捷徑,健檢每次都會去讀那支檔(代碼審 r1 資安席)。
 22199	        # ★整條路徑都要看★:只看 config.json 本身,.lumos 資料夾是捷徑時照樣讀到外面(代碼審 r2 資安席、邊界席)
 22200	        try:
 22201	            _via_link = p.is_symlink() or (p.exists() and p.resolve() != Path(repo_root).resolve() / ".lumos" / "config.json")
 22202	        except OSError:
 22203	            _via_link = True
 22204	        if _via_link:
 22205	            cfg["warnings"].append(".lumos/config.json(或 .lumos 資料夾)是捷徑檔,不跟過去讀,每支檔有家用預設(會擋、上限 "
 22206	                                   f"{_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)——要設定就放一支一般檔")
 22207	            return cfg
 22208	        if not p.is_file():
 22209	            return cfg
 22210	        try:
 22211	            raw = p.read_text(encoding="utf-8")
 22212	        except Exception as e:
 22213	            cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
 22214	            return cfg
 22215	    try:
 22216	        data = json.loads(raw)
 22217	    except Exception as e:
 22218	        cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
 22219	        return cfg
 22220	    nh = data.get("node_home") if isinstance(data, dict) else None
 22221	    if nh is None:
 22222	        return cfg
 22223	    if not isinstance(nh, dict):
 22224	        cfg["warnings"].append("設定檔的 node_home 不是物件,整段用預設")
 22225	        return cfg
 22226	    g = nh.get("gate", "on")
 22227	    if g not in _NODEHOME_GATE_VALUES:
 22228	        cfg["warnings"].append(f"設定檔的 node_home.gate={g!r} 看不懂(只認 {'/'.join(_NODEHOME_GATE_VALUES)}),已用 on")
 22229	    else:
 22230	        cfg["mode"] = g
 22231	    mf = nh.get("max_files", _NODEHOME_MAX_FILES_DEFAULT)
 22232	    # ★bool 要單獨擋★:Python 的 True 是 int 的子類,不擋的話上限悄悄變成 1(同合約條數門檻那支)
 22233	    if isinstance(mf, bool) or not isinstance(mf, int) or mf < 1:
 22234	        cfg["warnings"].append(f"設定檔的 node_home.max_files={mf!r} 不合法(要 1 以上的整數),已用 {_NODEHOME_MAX_FILES_DEFAULT}")
 22235	    else:
 22236	        cfg["max_files"] = mf
 22237	    ig = nh.get("ignore", [])
 22238	    if not isinstance(ig, list):
 22239	        cfg["warnings"].append("設定檔的 node_home.ignore 要是字串清單,整段略過")
 22240	    else:
 22241	        for i, item in enumerate(ig):
 22242	            if isinstance(item, str) and item.strip():
 22243	                cfg["ignore"].append(item.strip())
 22244	            else:
 22245	                cfg["warnings"].append(f"設定檔的 node_home.ignore 第 {i + 1} 項不是字串({item!r}),略過這一項")
 22355	        base = top[:-len(suf)].rstrip(".")
 22356	        if not base or ext in top_exts.get(base, ()):
