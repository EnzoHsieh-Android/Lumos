 22779	def _nodehome_commit_groups(repo_root, base, tip):
 22780	    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
 22781	    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
 22782	    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
 22783	    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
 22784	    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
 22785	    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
 22786	    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
 22787	    if raw is None:
 22788	        return None
 22789	    out = []
 22790	    for line in raw.decode("ascii", errors="replace").splitlines():
 22840	            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
 22841	            if n is not None and any(o["sig"] == n["sig"] for o in olds):
 22842	                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
 22843	            own, statuses = set(), set()
 22844	            for x in [n] + olds:
 22845	                if x is not None:
 22846	                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
 22847	                    statuses.add(x["status"])
 22848	            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
 22849	            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
 22850	        g["content_notes"] = notes
 22851	    return groups
