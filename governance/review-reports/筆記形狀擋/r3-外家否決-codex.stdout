/bin/zsh -lc "sed -n '820,965p' scripts/lumos
sed -n '2870,3045p' scripts/lumos
sed -n '3190,3245p' scripts/lumos
sed -n '19770,19915p' scripts/lumos
sed -n '22160,22320p' scripts/lumos
sed -n '22620,22885p' scripts/lumos
sed -n '23255,23375p' scripts/lumos" in /Users/enzo/harness/lumos-toolchain
 succeeded in 0ms:
    if not successor or successor.strip() == loop_id.strip():
        print("擋下:--successor 要給新開的迴圈編號,而且不能跟舊編號一樣——重寫=換新編號載新版,同號沒有「重寫」可言", file=sys.stderr)
        return 2
    # 血緣一跳查詢:這個編號是不是已經是上一次重寫的產物?
    chain_prev = None
    try:
        import json as _j
        import re as _re
        gl = env.vault.parent / ".governance-log.jsonl"
        # 邊界比對:successor=<id> 後面必須是分號或字串結尾——裸子字串會讓前綴編號互撞
        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
        if gl.exists():
            for line in gl.read_text(encoding="utf-8").splitlines():
                try:
                    o = _j.loads(line)
                except ValueError:
                    continue
                if not isinstance(o, dict):
                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
                        and _pat.search(str(o.get("note", ""))):
                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
    except OSError:
        pass
    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
    if chain_prev:
        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
    print("  之後查血緣:")
    print("    lumos gov --stats")
    return 0


def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
                ref=None, nodes=None, extra=None):
    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。

    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。

    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
    逐 ref 的事件另外帶那一行真正的 sha。

    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
    """
    import json as _json
    import datetime as _dt
    root = Path(repo_root)
    docs = root / "docs"
    if not docs.is_dir():
        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
        return None
    if not head_sha:
        try:
            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
        except Exception:
            head_sha = ""
    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
    if gate not in _KNOWN_GATES:
        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
              file=sys.stderr)
        return False
    ev = {
        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "commit": (head_sha or "")[:7],
        "gate": gate, "kind": kind, "hard": bool(hard),
        "nodes": list(nodes or []), "note": note,
        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
        "detail": note,
    }
    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
    if att:
        ev["attempt_id"] = att[:64]
    if ref:
        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
        # 「目前不算功能性錯誤——新事件本來就不該被當成 marker」。
        # ★那句話講的是一個保護,不是一個不一致★——我第一次折的時候把它當成欄名不一致、
        # 順手加了 branch 別名,結果 blocked 事件當場被 _codeloop_read_from_ledger
        # 當成留痕讀走,既有測試翻紅。欄名對齊只做 note/detail 那一半,分支識別不對齊。
        ev["ref"] = ref
    if head_sha:
        ev["head_sha"] = head_sha
    if extra:
        ev.update(extra)
    try:
        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
        return True
    except OSError:
        return False


def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
    ok = _gate_event(repo_root, gate, kind, note, **kw)
    if ok is None:
        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
    if not ok:
        print(f"  ⚠ telemetry-write-failed:{gate} 這一筆帳寫不進去(判定不受影響,照原樣執行)",
              file=sys.stderr)
    return ok


def _sp_run_text(cmd):
    import subprocess as _sp
    return _sp.run(cmd, capture_output=True, text=True, errors="replace").stdout.strip()


def _append_governance_log(vault, events):
    """寫者=doctor --ci + anchor approve:把 gate findings append 到 docs/.governance-log.jsonl。
    非 git / 取不到 HEAD → 跳過(不報錯)。dedup 留給讀時(lumos gov)。"""
    if not events:
        return
    import json
    import datetime
    import subprocess
    try:
        commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
                                capture_output=True, text=True, errors="replace", cwd=str(vault)).stdout.strip()
    except Exception:
        commit = ""
    if not commit:
        return
# 那幾行會被 lint 唸成打錯字,也不會被當成摘要行——規範直接空轉。
SYMBOL_NAMES = {"KEY", "FLOW", "DEP", "TEST", "AUTH", "FLAG", "DECISION", "VERIFY", "CORE",
                "PRIOR-ART", "REVISIT",
                "WHY", "RULE", "PITFALL", "FACT"}
SYMBOL_RE = re.compile(r"^(" + "|".join(sorted(SYMBOL_NAMES, key=len, reverse=True)) + r"):")

# ★脈絡標記的「同一行還要有什麼」★(2026-09-21 第三階段;單源=紀律範本〈寫筆記時〉那一節)
# 只唸警告不擋:規則是寫給人判斷的,機械只能看形狀,判錯就擋會逼人繞過去。
# ★只套四個新前綴★:FLOW:/DEP: 在本 repo 就有 277 行舊的,一開就是幾百條警告——
# 「誤報多過真報」的機制活不過一週,舊帳不追改,新寫的現況描述請改用 FACT:。
# RETIRE-IF:連續兩個月零觸發(大家本來就寫對了),或誤報多過真報 → 撤掉這一段。
# REVISIT:2026-11-21 看觸發統計,順便決定要不要延伸到 FLOW:/DEP:。
_CTX_REGRESS_RE = re.compile(r"\[test:|重現|repro", re.I)
_CTX_QUERY_RE = re.compile(r"`[^`]{6,}`")          # 一條可重跑的查詢指令(反引號包起來)
# 出處 = 日期 / 決策編號 / [[節點]] / 既有的 [src:] 標記 / 真的像 sha 的字串
# (★不收純數字★:2026-09-21 通才席 F5——原本 [0-9a-f]{7,40} 讓任意 7 位數字都算出處)
_CTX_SRC_RE = re.compile(r"20\d\d-\d\d-\d\d|#d\d+|\[\[|\[src:|\bd\d+\b"
                         r"|\b(?=[0-9a-f]{7,40}\b)[0-9a-f]*[a-f][0-9a-f]*\b")

# 前綴 → (判定函式, 缺什麼的白話, 怎麼補)
_CONTEXT_MARKER_RULES = {
    "WHY": (lambda s: bool(_CTX_SRC_RE.search(s)),
            "出處",
            "行內補一個日期、決策編號(#d3)、提交 sha 或 [[節點]],不然下一個人沒辦法查證這句話"),
    "PITFALL": (lambda s: bool(_CTX_REGRESS_RE.search(s)),
                "防回歸",
                "補 [test:測試名],或寫一條會重現的指令;兩個都沒有,這條只是感想"),
    "FACT": (lambda s: "以程式碼為準" in s and bool(_CTX_QUERY_RE.search(s)),
             "以程式碼為準的標註或查詢指令",
             "現況描述會過期:同一行標「以程式碼為準」並用反引號附一條可重跑的查詢指令;"
             "能從程式碼直接查到的,其實不該抄進筆記"),
}

# ★RULE: 的生命週期欄位★(2026-09-21 外家審計 F4 折入)
# 原本只驗「行內有日期字樣 + 有退場字樣」,`RULE:2030-99-99 退場:永不撤` 這種假規則零警告,
# 而且「這條過期了沒」沒人判得出來——散文寫的有效期不等於可執行的有效期。
# 欄位沿用本 repo 既有的 [test:]/[audit:] 行內寫法,不新發明語法:
#   [since:YYYY-MM-DD] 什麼時候立的(必填)   [retire:<條件>] 看到什麼就該撤掉(必填)
#   [until:YYYY-MM-DD] 硬到期日(選填)       [confirmed:YYYY-MM-DD] 最後一次確認(選填)
#   [status:active|superseded] 預設 active  [applies:<版本或範圍>](選填)
# 只有 since 與 retire 都寫齊、且不是 superseded 的 RULE 行,才有挑戰程式碼的效力(見紀律範本第 3 條)。
# 一欄位一個正則,形狀跟鄰居 TEST_REF_RE / AUDIT_REF_RE / ROLLBACK_REF_RE 一致
# (2026-09-21 架構對齊席:原本寫成一條合併正則+dict,是這支檔裡的第二種做法)
SINCE_REF_RE = re.compile(r"\[since:\s*([^\]]*)\]")
UNTIL_REF_RE = re.compile(r"\[until:\s*([^\]]*)\]")
CONFIRMED_REF_RE = re.compile(r"\[confirmed:\s*([^\]]*)\]")
STATUS_REF_RE = re.compile(r"\[status:\s*([^\]]*)\]")
RETIRE_REF_RE = re.compile(r"\[retire:\s*([^\]]*)\]")
APPLIES_REF_RE = re.compile(r"\[applies:\s*([^\]]*)\]")
_RULE_FIELD_RES = {"since": SINCE_REF_RE, "until": UNTIL_REF_RE, "confirmed": CONFIRMED_REF_RE,
                   "status": STATUS_REF_RE, "retire": RETIRE_REF_RE, "applies": APPLIES_REF_RE}
_RULE_CONFIRM_STALE_DAYS = 180


def parse_rule_fields(rest):
    """把 RULE: 行裡的 [key:value] 抓成 dict(重複出現取最後一個,跟鄰居一樣)。"""
    out = {}
    for k, rx in _RULE_FIELD_RES.items():
        ms = list(rx.finditer(rest))
        if ms:
            out[k] = ms[-1].group(1).strip()
    return out


def rule_field_truncated(rest):
    """值裡含右中括號(典型:退場條件引用 [[節點]])會被截斷,截掉的部分沒人看得到。

    既有的 [test:]/[audit:] 家族也是同一種截斷,差別在那些欄位的值本來就是識別字;
    [retire:] 是散文,踩到的機會高很多,所以這裡主動唸出來而不是默默截掉。
    """
    bad = []
    for k, rx in _RULE_FIELD_RES.items():
        for m in rx.finditer(rest):
            if rest[m.end():m.end() + 1] == "]":
                bad.append(k)
    return sorted(set(bad))


def _rule_date(v):
    import datetime as _dt
    try:
        return _dt.date.fromisoformat(v)
    except Exception:
        return None


def rule_lifecycle_warnings(rest, today=None):
    """一條 RULE: 行的生命週期檢查,回傳警告清單(不擋)。"""
    f = parse_rule_fields(rest)
    out = []
    # 同一行塞兩條 RULE:,後面那條沒填欄位也會借用前面的(2026-09-21 通才席 F4)
    if rest.count("RULE:") >= 1:
        out.append("一行只放一條 RULE:——同一行寫兩條時欄位會混在一起算,"
                   f"沒填欄位的那條會借用旁邊的而被判過關:{rest.strip()[:40]}")
    trunc = rule_field_truncated(rest)
    if trunc:
        out.append("這幾個欄位的值裡有右中括號,會被截斷(常見於退場條件引用 [[節點]]):"
                   + "、".join(f"[{k}:…]" for k in trunc)
                   + "——改寫成不帶中括號的一句話,或把節點名寫在欄位外面"
                   + f":{rest.strip()[:40]}")
    missing = [k for k in ("since", "retire") if not f.get(k)]
    if missing:
        out.append("脈絡標記『RULE:』缺 " + "、".join(f"[{k}:…]" for k in missing)
                   + "——規則要機械讀得到「什麼時候立的」和「看到什麼就該撤掉」,"
                     "散文寫的有效期沒人判得出來;寫不出退場條件,就是還沒想清楚這條該不該立"
                   + f":{rest.strip()[:40]}")
    st = (f.get("status") or "active").lower()
    if st == "superseded":
        out.append("這條 RULE 標了 [status:superseded],已經沒有挑戰程式碼的效力,"
                   "只能當歷史線索;確定撤掉就把整行刪掉,別留著讓人誤讀"
                   f":{rest.strip()[:40]}")
    elif st != "active":
        out.append(f"[status:{st}] 不是認得的值(只收 active / superseded):{rest.strip()[:40]}")
    import datetime as _dt
    today = today or _dt.date.today()
    for key, label in (("since", "立的日期"), ("until", "到期日"), ("confirmed", "最後確認")):
        v = f.get(key)
        if v and _rule_date(v) is None:
            out.append(f"[{key}:{v}] 不是合法日期({label}要寫成 YYYY-MM-DD):{rest.strip()[:40]}")
    until = _rule_date(f.get("until") or "")
    if until and until < today and st == "active":
        out.append(f"這條 RULE 的 [until:{f['until']}] 已經過期({today} 了)還標著 active——"
                   "確認還要不要留:要留就往後延並補 [confirmed:],不留就刪掉或標 superseded"
                   f":{rest.strip()[:40]}")
    conf = _rule_date(f.get("confirmed") or "")
    if conf and (today - conf).days > _RULE_CONFIRM_STALE_DAYS and st == "active":
        out.append(f"這條 RULE 超過 {_RULE_CONFIRM_STALE_DAYS} 天沒人確認過"
                   f"(最後一次是 {f['confirmed']})——還成立就更新 [confirmed:],不成立就撤掉"
                   f":{rest.strip()[:40]}")
    return out


def context_marker_warnings(summary_text):
    """檢查摘要裡四個脈絡前綴的形狀,回傳警告字串清單(不產生 error)。"""
    out = []
    for raw in (summary_text or "").split("\n"):
        line = raw.strip()
        if not line:
            continue
        m = SYMBOL_RE.match(line)
        if not m:
            continue
        if m.group(1) == "RULE":
            out.extend(rule_lifecycle_warnings(line[len("RULE:"):]))
            continue
        rule = _CONTEXT_MARKER_RULES.get(m.group(1))
        if not rule:
            continue
        ok, missing, how = rule
        rest = line[len(m.group(1)) + 1:]
        if not ok(rest):
            out.append(f"脈絡標記『{m.group(1)}:』缺{missing}——{how}:{rest.strip()[:40]}")
    return out

FM_KEY_RE = re.compile(r"^\s*([A-Za-z_][\w-]*):")


def _search_region(lineno, line, fm_end):
    """標記命中行所在的結構區域 — 讓「合約行 vs 散文」一眼可辨(尊重標籤哲學)。"""
    s = line.strip()
    if "★INVARIANT★" in s:
        return "★INVARIANT★"
    if "★DEBT★" in s:
        return "★DEBT★"
    if lineno <= fm_end:
        m = SYMBOL_RE.match(s)
        if m:
            return m.group(1)            # summary 符號行: KEY/FLOW/DEP...
        mk = FM_KEY_RE.match(line)
        if mk:
            return f"fm:{mk.group(1)}"    # frontmatter 欄位
        return "fm"
    return "body"


# ── 檢索排序核心(BM25F,borrow Whoosh 公式+Robertson BM25F tf 加權;spec:檢索優化_計劃) ──
      ① `load_vault()`:未閉合圍欄裡的 `[[wikilink]]` ★被當成真的圖譜邊索引進去★
         → 幽靈連結進入持久化的圖結構(backlinks 實測會多報一條)。
      ② `cmd_guard_trace()`:未閉合圍欄裡的測試名 ★被當成合約的真實佐證★
         → 污染 ★INVARIANT★→[test:]→Verification 證據鏈,正好打臉該指令自己的保證。
    逐行 toggle 的語意才是對的:未閉合圍欄之後一律視為 code(隱形),與主搜尋一致。
    ★爆炸半徑(2026-08-03 r3 由 Codex 覆核後修正,原宣稱過強)★:
      ・全庫 220 篇★無任何未閉合圍欄★(兩方各自掃過,一致)
      ・wikilink 邊集合 ★新舊完全相同(差集為空)★
        ★這裡刻意★不寫具體數字★,只寫不變量★——2026-08-03 r4 三位審查員各自
        獨立量,得到 436/382/728、976/728/240 等多組互不相同的值,沒有一個等於
        我原本抄來的「354」(那是 `lumos export --format dot` 的邊數口徑)。
        ★「邊數是多少」取決於你怎麼數(出現次數/去重/含不含 frontmatter/解析前後),
        但「新舊相同」與口徑無關——★該記的是不變量,不是那個數★。
        要自己驗:任選一種口徑,對 `body_clean` 用舊寫法與 `_strip_code_text`
        各算一次邊集合,比差集。
        ★過程檢討:我當初把 r3 審查員報告裡的數字直接抄進 docstring、沒有自己量,
         正是本專案同日剛在圖譜更正過的「數字被沿用進句子」——只是碰巧站得住★
      ・`guard trace` 全 vault 輸出 ★逐字元相同★(67 行,實測 diff)
      ・★但「清洗後文字一個字都不變」這個更強的說法不成立★:33-36 篇不同
        (兩位審查員各自量到 33 與 36,計數口徑略異;方向一致)——新法(逐行
        `lstrip().startswith("```")`)接受★縮排的圍欄★,舊 `FENCE_RE` 只認第 1 欄。
        ★這是與不閉合圍欄★正交★的另一類變化,原本的「爆炸半徑=0」理由沒涵蓋它★;
        方向上新法與主搜尋一致(search 一直都是逐行 lstrip)、也與 CommonMark 一致,
        故判定為修正而非回歸——但★這是事後補的論證,不是原本就驗過的★。
    """
    return "\n".join(pr for _no, _raw, pr in _search_visible_lines(text.split("\n"), include_code))


def _visible_lines(lines, keep_fenced=False):
    """★全檔唯一的 fenced-code 判定實作★:逐行 toggle,回 (行號從1起, 原始行)。

    `keep_fenced=True` 時保留圍欄★內★的文字(但仍跳過 ``` 標記行本身)。

    ★為什麼所有人都必須走這裡(2026-08-03 code-loop r2/r4)★:原本各處自己用
    `FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)`,那個正則有兩個致命假設——
      ① 假設圍欄★成對★:未閉合的圍欄看不見(r2 抓到:幽靈圖譜邊、假合約佐證)
      ② 假設圍欄標記★在第 0 欄★:收尾圍欄一縮排就跟下一個區塊的開頭錯配,
         ★把中間的真散文整段當程式碼吞掉★(r4 抓到,實測某條路徑宣稱直接消失)
    ②的消費端是治理機制本身(refcheck → design-loop 的 G1 硬閘、Edit/Write 前
    自動注入必看合約的 impact hook)——★一個縮排的 ``` 就能把某節點的鐵則警告
    靜默關掉★。逐行 toggle 對兩個假設都免疫。
    
    ★兩段式讀法(2026-09-16 代碼審 r2)★:先照 CommonMark 讀——收尾圍欄後面只能有空白,
    帶語言標記的那行不算收尾(不然巢狀範例裡的樣板會被當成真的)。但這條規則比題目寬:
    收尾★打錯一個字、多敲一鍵★也會變成「關不掉」,後面到檔尾所有內容(含合約行)
    無聲隱形——正是下面警告過的最危險模式換個門長出來。所以規格讀法如果讀完還有圍欄沒關,
    就整份退回寬鬆讀法(同字元、長度夠就算關)。取捨:同一份文件裡同時有巢狀範例★和★
    沒關到的圍欄時,會退回寬鬆、巢狀那題就擋不住——那等於回到 2026-09-16 之前的行為,
    不算退步,而且真的有沒關到的圍欄本來就該先修那個。
    """
    def _scan(strict):
        """回 (看得見的行, 收尾時還有沒有圍欄開著)。strict=照 CommonMark(收尾不得帶東西)。"""
        fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
        # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
        out = []
        for i, ln in enumerate(lines):
    if repo_root is None:
        return 2
    anchors, absent = {}, []
    for rel in ANCHOR_FILES:
        f = repo_root / rel
        if f.is_file():
            anchors[rel] = hashlib.sha256(f.read_bytes()).hexdigest()
        else:
            absent.append(rel)
    if absent:
        print(f"提醒:這些驗證器檔案不存在,沒列進基準線: {', '.join(absent)}")
    bp = repo_root / _ANCHOR_BASELINE_REL
    prev = {}
    if bp.exists():
        try:
            prev = json.loads(bp.read_text(encoding="utf-8")).get("anchors", {})
        except (OSError, ValueError):
            prev = {}
    changed = sorted({k for k in anchors if anchors[k] != prev.get(k)} | (set(prev) - set(anchors)))
    bp.parent.mkdir(parents=True, exist_ok=True)
    payload = {"version": 1, "anchors": anchors,
               "approved_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
               "note": note}
    bp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    v = vault or find_vault(Path.cwd())
    if v is None:
        print("⚠ 無 vault:baseline 已寫,governance-log 留痕跳過")
    else:
        _append_governance_log(v, [{"gate": "anchor-approve", "kind": "approved",
                                    "hard": False, "nodes": changed, "note": note}])
    print(f"✓ anchor approve — {len(anchors)} 個錨點寫入 baseline({len(changed)} 個變更)")
    return 0


def _validate_repo_ref(repo_root, token, line, at_sha=None):
    """驗一條 repo 內檔案指涉:回 (status, excerpt)。status ∈ missing/line_out_of_range/ok。
    _refcheck_scan 與 check_regen_provenance(Check J 的 [src:] 驗證)共用——
    J-c 不得走 _refcheck_scan 抽取入口(inline-code 抽取 + top_dirs 靜默過濾會把假目錄放行,
    正是 J-c 要擋的幻覺;此 helper 直收已解析 path/line,無靜默過濾)。
    token 消毒(code-review blocker 修):空/絕對路徑/含 .. 一律 missing——top_dirs 過濾
    被拆掉時它隱含的安全性(空值/絕對/traversal 天然進不了 top_dirs)必須在此顯式補回,
    否則 [src: ]/[src:/etc/passwd]/[src:../..] 會 resolve 到 repo 外真實存在的路徑而判 ok。"""
    token = token.strip()
    from pathlib import PurePosixPath, PureWindowsPath
    if (not token
            or PurePosixPath(token).is_absolute() or PureWindowsPath(token).is_absolute()
            or ".." in PurePosixPath(token).parts):
        return "missing", ""
    # at_sha 給了就對那個 commit 的 git 樹驗,不看工作樹(表態閘 2026-09-09,r3 架構對齊席 A3:同一件事同一個入口,
    # 別在 code-loop 那邊另造一套);三態語意(missing/line_out_of_range/ok)兩條路一致。
    if at_sha:
        if not _git_tree_has(repo_root, at_sha, token):
            return "missing", ""
        if not line:
            return "ok", ""
        txt = _git_tree_text(repo_root, at_sha, token)
        file_lines = txt.splitlines() if txt is not None else None
        if "-" in line:
            lo, hi = (int(x) for x in line.split("-", 1))
        else:
            lo = hi = int(line)
        if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
            return "line_out_of_range", ""   # r1 邊界席 f1:10-5 / 5-0 這種範圍以前會 IndexError 或負索引繞回
        return "ok", (file_lines[lo - 1] if lo == hi else file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1])
    target = repo_root / token
    if not target.exists():
        return "missing", ""
    if target.is_dir() or not line:
        return "ok", ""
    if "-" in line:
        lo, hi = (int(x) for x in line.split("-", 1))
    else:
        lo = hi = int(line)
    try:
        file_lines = target.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except OSError:
        file_lines = None
    if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
        return "line_out_of_range", ""
    if lo == hi:
        return "ok", file_lines[lo - 1]
    return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]


def _node_code_ref_tokens(text, top_dirs):
    """節點文字裡用反引號寫的程式路徑引用,回 (full, bare):
    full=含 / 且頂層目錄存在的 (token, 行號) 清單(依出現順序、去重,帶 :行號 的剝成第二欄);bare=不含 / 的裸 token 集合。
    ★refcheck、改檔前推筆記、每支檔有家三處共用這一支★——推筆記認得的,跟每支檔有家認得的,一定一樣
    (兩套算法一定分岔,而分岔時沒有東西會翻紅;Projects/每支檔有家_計劃 [S7])。"""
    _suffix_re = re.compile(r":([^/]+)$")
    # ★不可換回 FENCE_RE★(見 _visible_lines):此處餵 G1 硬閘與 impact hook
    spans = [s.strip("`") for s in INLINE_CODE_RE.findall(_strip_fences_text(text))]
    seen = set()
    full = []
    for raw in spans:
        if "://" in raw or any(c in raw for c in "*<>?"):
            continue
        m = _suffix_re.search(raw)
        if m:
            token, sfx = raw[:m.start()], m.group(1)
            line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
        else:
            token, line = raw, ""
        if "/" not in token or (token, line) in seen:
            continue
        if token.split("/")[0] not in top_dirs:
            continue
        seen.add((token, line))
        full.append((token, line))
    return full, {s for s in spans if "/" not in s}


def _refcheck_scan(text, repo_root):
    """refcheck 抽取+核對核心(不列印):回 (claims, n_missing, n_oor, n_ok)。
    cmd_refcheck 與 loop status --gate(G1 錨)共用;抽取規則見 cmd_refcheck docstring。
    核對段走 _validate_repo_ref(與 Check J 共用);抽取段(inline-code+top_dirs 過濾)維持原規則。"""
    top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
    full, _bare = _node_code_ref_tokens(text, top_dirs)
    claims = []
    for token, line in full:
        status, excerpt = _validate_repo_ref(repo_root, token, line)
        claim = {"token": token, "line": line, "status": status, "excerpt": excerpt}
        if status == "ok" and (repo_root / token).is_dir():
            claim["dir"] = True
        claims.append(claim)

    n_missing = sum(1 for c in claims if c["status"] == "missing")
    n_oor = sum(1 for c in claims if c["status"] == "line_out_of_range")
    n_ok = sum(1 for c in claims if c["status"] == "ok")
    return claims, n_missing, n_oor, n_ok


PITFALL_CLASSES = {
    "payment": [r"金流", r"payment", r"stripe", r"billing", r"退款", r"refund", r"扣款"],
    "external-send": [r"寄送", r"送出", r"\bsend\b", r"webhook", r"notify", r"LINE 推送", r"\bmail\b", r"簡訊", r"對外"],
    "prod-irreversible": [r"\bprod\b", r"production", r"遷移", r"migration", r"不可逆", r"DROP TABLE", r"DELETE FROM", r"上架"],
    "self-governance": [r"錨點", r"anchor verify", r"收斂判準", r"canary", r"審計閘", r"pre-push hook"],
}
_PITFALL_COMPILED = {c: [re.compile(p, re.I) for p in pats] for c, pats in PITFALL_CLASSES.items()}
_PITFALL_GENERAL = [
    "併發——同資源兩請求同時進來會怎樣?",
    "效能——這段會進熱路徑/大資料量嗎?",
    "資源——連線/檔案/鎖有沒有確定釋放?",
    # 風險類廣度反問(已知坑機械前置 S0,2026-08-08):寫死 4 類太少,改反問在場 LLM
    # 自我分類——分類是語意判斷,不該 regex 猜。★三處同步:此處+templates.md:31+design-loop skill★
    "列出此功能碰到的風險類(不限既有金流/寄送/不可逆/守衛面:認證/並發/快取/遷移/PII/限流/狀態同步…),逐類答隱患;無則寫『無+為什麼』。",
        for c in candidates:
            print(f"{c['name']} {c['current']} → {c['latest']}")
    return 0


# ── 每支檔有家:程式檔歸屬與寫回落點的檢查(Projects/每支檔有家_計劃,2026-09-11) ──────────────
# ★為什麼存在★:一篇節點在依賴行用反引號寫別人的檔,改那些檔時推筆記就推它、寫回就落它——兩個消費專案兩天內
# 長歪兩次、工具全綠。這一段在提交與推送的當下擋「新違規」,舊帳交給健檢提醒(決策 d1)。
# 單源=計劃節點;每條規則的註解標它對回的條款編號 [SN]。
_NODEHOME_CODE_EXTS = {".cs", ".vue", ".js", ".ts", ".tsx", ".jsx", ".mjs", ".sql", ".py", ".kt", ".kts",
                       ".java", ".swift", ".go", ".rs", ".c", ".cc", ".cpp", ".h", ".hpp", ".sh", ".ps1"}
# ↑「改程式要動圖譜」那道閘的第五份副本(另外四份在提交前/提交後掛鉤與 Claude 端兩支掛鉤)——
#   t_code_exts_lists_agree 釘五份一致 [S1]。不借 CODE_EXTS_T:那份是符號查核用的,內容不同。
_NODEHOME_EXCLUDE_GLOBS = ("docs/*", "*/node_modules/*", "*/bin/*", "*/obj/*", "*/.git/*",
                           "*/dist/*", "*/build/*", "*/__pycache__/*")
# ↑ 跟提交前掛鉤 should_exclude 的目錄排除同一份(t_nodehome_required_files_definition 逐字比對)
_NODEHOME_HOME_STATUSES = ("doing", "done", "stale")   # [S2] planned/deferred 還不是現況、rejected/superseded 已不是
_NODEHOME_GATE_VALUES = ("on", "warn", "off")          # [S37]
_NODEHOME_MAX_FILES_DEFAULT = 3                        # [S18] 跟開新節點提示的「0~3 支」一致
_NODEHOME_RESP_MIN_CHARS = 10                          # [S16]
_NODEHOME_MSG_CAP = 10                                 # [S6] 跟「改程式沒動圖譜」那道擋下訊息同一個上限
_NODEHOME_GOLIVE_MARK = "home check --staged"          # [S39] 提交前掛鉤裡有這串=這道檢查上線了


def _nodehome_config(repo_root, text=None, from_snapshot=False):
    """讀 node_home 設定。回 {mode: on|warn|off, max_files: int, ignore: [str], warnings: [str]};壞值一律退回預設並留一句。
    from_snapshot=True:text 是被檢查那個版本裡 .lumos/config.json 的內容(None=那個版本沒有這支檔)——
    ★提交前讀提交索引、推送前讀終點那個提交★,不讀工作目錄(工作目錄裡沒暫存的「關掉」不得關掉提交索引的檢查)。
    from_snapshot=False:直讀工作目錄(健檢開頭那一行用;同 _stack_questions_config 慣例)。
    ★鍵叫 mode 不叫 gate★:治理閘名的漂移掃描會把 gate 鍵的字面值當閘名(同 _stack_questions_config)。"""
    cfg = {"mode": "on", "max_files": _NODEHOME_MAX_FILES_DEFAULT, "ignore": [], "warnings": []}
    if from_snapshot:
        if text is None:
            return cfg
        raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
    else:
        p = Path(repo_root) / ".lumos" / "config.json"
        # 捷徑檔不跟過去讀:跟讀快照那條路一樣(git 裡的捷徑檔讀出來是目標路徑字串,解析失敗退預設)——
        # 不然設定檔被做成指到本機任意檔的捷徑,健檢每次都會去讀那支檔(代碼審 r1 資安席)。
        # ★整條路徑都要看★:只看 config.json 本身,.lumos 資料夾是捷徑時照樣讀到外面(代碼審 r2 資安席、邊界席)
        try:
            _via_link = p.is_symlink() or (p.exists() and p.resolve() != Path(repo_root).resolve() / ".lumos" / "config.json")
        except OSError:
            _via_link = True
        if _via_link:
            cfg["warnings"].append(".lumos/config.json(或 .lumos 資料夾)是捷徑檔,不跟過去讀,每支檔有家用預設(會擋、上限 "
                                   f"{_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)——要設定就放一支一般檔")
            return cfg
        if not p.is_file():
            return cfg
        try:
            raw = p.read_text(encoding="utf-8")
        except Exception as e:
            cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
            return cfg
    try:
        data = json.loads(raw)
    except Exception as e:
        cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
        return cfg
    nh = data.get("node_home") if isinstance(data, dict) else None
    if nh is None:
        return cfg
    if not isinstance(nh, dict):
        cfg["warnings"].append("設定檔的 node_home 不是物件,整段用預設")
        return cfg
    g = nh.get("gate", "on")
    if g not in _NODEHOME_GATE_VALUES:
        cfg["warnings"].append(f"設定檔的 node_home.gate={g!r} 看不懂(只認 {'/'.join(_NODEHOME_GATE_VALUES)}),已用 on")
    else:
        cfg["mode"] = g
    mf = nh.get("max_files", _NODEHOME_MAX_FILES_DEFAULT)
    # ★bool 要單獨擋★:Python 的 True 是 int 的子類,不擋的話上限悄悄變成 1(同合約條數門檻那支)
    if isinstance(mf, bool) or not isinstance(mf, int) or mf < 1:
        cfg["warnings"].append(f"設定檔的 node_home.max_files={mf!r} 不合法(要 1 以上的整數),已用 {_NODEHOME_MAX_FILES_DEFAULT}")
    else:
        cfg["max_files"] = mf
    ig = nh.get("ignore", [])
    if not isinstance(ig, list):
        cfg["warnings"].append("設定檔的 node_home.ignore 要是字串清單,整段略過")
    else:
        for i, item in enumerate(ig):
            if isinstance(item, str) and item.strip():
                cfg["ignore"].append(item.strip())
            else:
                cfg["warnings"].append(f"設定檔的 node_home.ignore 第 {i + 1} 項不是字串({item!r}),略過這一項")
    return cfg


# 斜線也算檔名字元:不然正文寫 lib/src/pay.py 會被判成「有提到 src/pay.py」(代碼審 r2 合約席)
_HOME_MENTION_BOUNDARY = re.compile(r"[A-Za-z0-9_.@+/\-]")


def _home_mentions(scan_text, rel_path):
    """這段文字有沒有提到這支檔(完整路徑或裸檔名,整詞比對)。

    ★不要用 `base in scan` 這種子字串比對★:新掛 `a.py`、正文只寫了 `xa.py`,子字串會判成「有提到」,
    提醒就被吃掉——代碼審 r1 邊界席實測。所以命中位置的前後要是非檔名字元(或字串邊界)才算。
    """
    base = rel_path.rsplit("/", 1)[-1]
    for token in (rel_path, base):
        if not token:
            continue
        start = 0
        while True:
            i = scan_text.find(token, start)
            if i < 0:
                break
            before = scan_text[i - 1] if i > 0 else ""
            after = scan_text[i + len(token)] if i + len(token) < len(scan_text) else ""
            if not _HOME_MENTION_BOUNDARY.match(before or " ") and not _HOME_MENTION_BOUNDARY.match(after or " "):
                return True
            start = i + 1
    return False


def _nodehome_resp_ok(value):
    """[S16] 負責範圍:至少 10 個字、要有實字(全標點、空白視同沒寫)。實字判準同 [manual:] 那條。"""
    if not isinstance(value, str):
        return False
    v = value.strip()
    return len(v) >= _NODEHOME_RESP_MIN_CHARS and bool(re.search(r"[^\W_]", v))


_NODEHOME_STACK_TEST_DIRS = None   # lazy:({頂層資料夾結尾樣式: 貢獻它的棧的副檔名}, {src/ 底下的測試資料夾名: 貢獻它的棧的副檔名})


def _nodehome_stack_test_dirs():
    """從測試棧對照表 TEST_PROFILES 推各棧的測試資料夾,不另寫清單(對照表多一個,這裡跟著認;
    t_nodehome_stack_test_dirs_not_required 的漂移守衛釘住):頂層比對模式的棧(Swift、C#)取「頂層資料夾名稱結尾」,
    限 src/ 底下遞迴找的棧(Kotlin/Gradle)取「src/ 底下的資料夾名」,兩種都連同那一棧的副檔名。其餘遞迴模式的棧不推——
    Python 那份把 scripts 當測試資料夾、Playwright 的 tests/e2e 不限位置,錨定太鬆會把真程式檔放掉。"""
    global _NODEHOME_STACK_TEST_DIRS
    if _NODEHOME_STACK_TEST_DIRS is None:
        sufs, under_src = {}, {}
        for prof in TEST_PROFILES.values():
            names = {d for inc, _exc in prof.get("dirs", {}).values() for d in inc if d}
            if prof.get("dir_mode") == "suffix":
                for d in names:
                    sufs.setdefault(d, set()).update(prof.get("exts", ()))
            elif prof.get("rglob_under") == "src":
                for d in names:
                    under_src.setdefault(d, set()).update(prof.get("exts", ()))
        _NODEHOME_STACK_TEST_DIRS = ({k: frozenset(v) for k, v in sufs.items()}, {k: frozenset(v) for k, v in under_src.items()})
    return _NODEHOME_STACK_TEST_DIRS


def _nodehome_top_dirs(all_paths):
    """repo 頂層的資料夾名;點開頭的不算(.git、.github 這類不是程式資料夾)。
    別人的檔的裸路徑判定([S8])與測試資料夾的同名資料夾錨共用這一支。"""
    return {p.split("/", 1)[0] for p in all_paths if "/" in p and not p.startswith(".")}


def _nodehome_layout(all_paths):
    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
    tops = _nodehome_top_dirs(all_paths)
    top_exts, main_exts = {}, {}
    for p in all_paths:
        e = _testmap_ext(p)
        if not e:
            if counts.get(b) == 1 and where[b] in req:
                refs.add(where[b])
    return refs


def _nodehome_changes(repo_root, base, tip):
    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
    if tip == "index":
        args = ["diff", "--cached", "--name-status", "-z", "-M"]
        if base is None:
            args.append(_EMPTY_TREE_SHA)
    else:
        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
    raw = _nodehome_git(repo_root, *args)
    if raw is None:
        return None
    toks = _nodehome_split_z(raw)
    out, i = [], 0
    while i < len(toks):
        st = toks[i]
        code = st[:1]
        if code in ("R", "C") and i + 2 < len(toks):
            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
            i += 3
        elif i + 1 < len(toks):
            p = nfc(toks[i + 1])
            out.append((code, p if code != "A" else None, p if code != "D" else None))
            i += 2
        else:
            break
    return out


def _nodehome_name_status(raw):
    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
    while i < len(toks):
        code = toks[i][:1]
        if code in ("R", "C") and i + 2 < len(toks):
            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
            if code == "R":
                gone.add(nfc(toks[i + 1]))
            i += 3
        elif i + 1 < len(toks):
            paths.add(nfc(toks[i + 1]))
            if code == "D":
                gone.add(nfc(toks[i + 1]))
            i += 2
        else:
            break
    return paths, src, gone - set(src)


def _nodehome_merge_own_changes(repo_root, sha, parents):
    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。

    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
    或順手多改的部分,正是這道檢查要看的。
    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
    """
    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
        return None
    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
                      "--name-status", "-z", "-M", sha)
    if r is None:
        return None
    paths, src, gone = _nodehome_name_status(r)
    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
    for p in parents:
        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
    order = sorted(paths)
    specs = []
    for x in order:
        specs.append(f"{sha}:{x}")
        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
    blobs = _nodehome_cat_blobs(repo_root, specs)
    if blobs is None or any(ren is None for _, ren in pairs):
        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
        return paths, src, gone
    kept = set()
    for n, x in enumerate(order):
        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
        if _nodehome_merge_wrote_new_lines(merged, olds):
            kept.add(x)
    return kept, {k: v for k, v in src.items() if k in kept}, gone


def _nodehome_cat_blobs(repo_root, specs):
    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。

    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
    import subprocess as _sp
    if not specs:
        return []
    if any("\n" in s_ for s_ in specs):
        return None
    try:
        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
                    capture_output=True, timeout=60)
    except (OSError, _sp.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    out, pos, res = r.stdout, 0, []
    for _ in specs:
        nl = out.find(b"\n", pos)
        if nl < 0:
            return None
        head = out[pos:nl].split(b" ")
        pos = nl + 1
        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
            size = int(head[2])
            res.append(out[pos:pos + size])
            pos += size + 1
        elif len(head) == 3 and head[2].isdigit():
            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
            res.append(None)
        else:
            res.append(None)            # missing / ambiguous
    return res


def _nodehome_merge_wrote_new_lines(merged, olds):
    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。

    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
    if merged is None or b"\0" in merged:
        return True
    seen = set()
    for blob in olds:
        if blob is not None:
            seen.update(ln.strip() for ln in blob.split(b"\n"))
    return any(ln.strip() and ln.strip() not in seen for ln in merged.split(b"\n"))


def _nodehome_commit_groups(repo_root, base, tip):
    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
    if raw is None:
        return None
    out = []
    for line in raw.decode("ascii", errors="replace").splitlines():
        shas = line.split()
        if not shas:
            continue
        sha, parents = shas[0], shas[1:]
        if len(parents) <= 1:
            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
            if r is None:
                return None
            paths, src, gone = _nodehome_name_status(r)
        else:
            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
            if rm is not None:
                paths, src, gone = rm
            else:
                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
                per = []
                for p in parents:
                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
                    if r is None:
                        return None
                    per.append(_nodehome_name_status(r))
                paths = set.intersection(*(x[0] for x in per))
                src = {k: v for k, v in per[0][1].items() if k in paths}
                gone = set.intersection(*(x[2] for x in per))
        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
    return out


def _nodehome_mark_note_content(repo_root, groups, vault_rel):
    """推送前逐提交看寫回:每個提交裡,哪幾篇 Systems 節點的內容(摘要、決策、正文)是在這個提交改的——只補驗證連結、
    計劃連結這類簿記欄位的不算——以及那篇在這個提交前後管哪些檔。在讀取這一層先算好放進分組的 content_notes
    {這個提交之後的路徑: {type, status, own}},判定那層只在同一個提交裡比「管的檔」跟「改的程式」,不必跨提交追名字
    (合併進來的平行分支、一次推送改名好幾次都不影響——代碼審 r2 單reviewer)。這個提交裡改名的,拿改名前的路徑去
    上一個提交讀;這個提交才新開的算有變;讀不到一律當有變,照原本那樣查。"""
    pre = vault_rel + "/Systems/"
    for g in groups or ():
        after = _nodehome_reader(repo_root, g["sha"])
        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
        notes = {}
        for p in g["paths"]:
            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
                continue
            new = after(p)
            n = _nodehome_parse_note(new) if new is not None else None
            olds = [b(g["src"].get(p, p)) for b in befores]
            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
            if n is not None and any(o["sig"] == n["sig"] for o in olds):
                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
            own, statuses = set(), set()
            for x in [n] + olds:
                if x is not None:
                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
                    statuses.add(x["status"])
            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
        g["content_notes"] = notes
    return groups


def _nodehome_golive(repo_root, tip):
    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。"""
    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{_NODEHOME_GOLIVE_MARK}",
                        tip or "HEAD", "--", "scripts/hooks/pre-commit")
    if not raw:
        return None
    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
    return first if _LENS_SHA_RE.match(first) else None


def _nodehome_clamp_base(repo_root, base, tip):
    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。"""
    gl = _nodehome_golive(repo_root, tip)
    if gl is None:
        return base
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
    if r is None or r.returncode != 0:
        return base                                    # 上線點不在這條歷史上
    if base in (None, _EMPTY_TREE_SHA):
        return gl
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
    return gl if (r is not None and r.returncode == 0 and base != gl) else base


def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
    None=整批當成一個提交(提交前)。"""
    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
            "bad_names": sorted(_nodehome_show(x) for x in bad), "golive": gl}


def cmd_home_check(repo=None, staged=False, diff_range=None):
    """lumos home check --staged | --diff A..B [S24]:有新違規 rc1,沒有 rc0;沒有圖譜/合併中/開關 off 說一句跳過、rc0。
    git 跑不起來=fail-open(說一句、rc0):這道閘只擋「確定是新違規」的,不因為環境壞了擋人。
    ★設定、工具自裝檔、圖譜位置都從被檢查的那個版本讀★(提交前=提交索引、推送前=終點那個提交),不讀工作目錄。"""
    root = Path(repo).resolve() if repo else None
    if root is None:
        r = _lens_git(".", "rev-parse", "--show-toplevel")
        if r is None or r.returncode != 0:
            print("擋下:這裡不是 git 專案,用 --repo 指定", file=sys.stderr)
            return 2
        root = Path(r.stdout.strip())
    if staged:
        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
        if mh is not None and mh.returncode == 0:
            print("每支檔有家:合併提交跳過(推送前會把合併的結果整段查一次)", file=sys.stderr)
            return 0
        head = _lens_full_sha(root, "HEAD")
        base_where, tip_where, mode_word = head, "index", "這次提交"
        changes = _nodehome_changes(root, head, "index")
    else:
        # 寫法用派工鏡頭那支判法:恰好兩個點、兩端都有、不收三個點——原本只切第一個「..」,
        # 三個點的寫法變成「起點 到 .終點」、找不到就放行,同一條違規完全沒擋(代碼審 r1 邊界席)
        rg = _lens_range_ok(diff_range)
        if rg is None:
            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有(三個點的寫法這裡不收:"
                  "先用 git merge-base 算出起點再給)", file=sys.stderr)
            return 2
        a, b = rg
        tip = _lens_full_sha(root, b)
        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
        if tip is None or base is None:
            print(f"每支檔有家:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
            return 0
        base = _nodehome_clamp_base(root, base, tip)
        base_where = None if base == _EMPTY_TREE_SHA else base
        tip_where, mode_word = tip, "這次推送"
        changes = _nodehome_changes(root, base_where, tip)
    if changes is None:
        print("每支檔有家:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
        return 0
    lst = _nodehome_list(root, tip_where)
    if lst is None:
        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
        return 0
    # 圖譜位置:被檢查的那個版本裡的 docs/*-knowledge(推送一個不是目前 checkout 的分支,工作目錄那份可能不一樣)
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    wv = _vault_in(root)
    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
    if wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults:
        vault_rel = wv_rel
    elif vaults:
        vault_rel = "docs/" + vaults[0]
    else:
        print("每支檔有家:這個專案沒有圖譜,跳過")
        return 0
    reader = _nodehome_reader(root, tip_where)
    cfg = _nodehome_config(root, reader(".lumos/config.json"), from_snapshot=True)
    for w in cfg["warnings"]:
        print(f"提醒:{w}", file=sys.stderr)
    if cfg["mode"] == "off":
        print("每支檔有家:這個專案把這道檢查關掉了(node_home.gate=off),跳過", file=sys.stderr)
        return 0
    N = _nodehome_side(root, tip_where, vault_rel)
    changed_paths = {p for _c, o, n in changes for p in (o, n) if p}
    B = _nodehome_side(root, base_where, vault_rel, share=N, changed=changed_paths)
    if B is None or N is None:
        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
        return 0
    skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root, "" if staged else tip_where)[0]
    groups = None if staged else _nodehome_mark_note_content(root, _nodehome_commit_groups(root, base_where, tip_where), vault_rel)
    res = _nodehome_evaluate(root, B, N, changes, cfg, skip, vault_rel, groups=groups)
    homesN, _own = _nodehome_homes(root, N)
    lines = _nodehome_render(res, homesN, N, cfg, mode_word)
    blocked = bool(res["blocks"])
    if blocked and cfg["mode"] == "warn":
        lines = [l.replace("擋下:", "提醒(node_home.gate=warn,不擋):", 1) for l in lines]
    for l in lines:
        print(l, file=sys.stderr)
    # 治理帳:nodes 只放程式檔路徑(統計語意表這麼宣告);沒有程式檔的違規(負責範圍)把節點另放 notes
    files, notes_ = set(), set()
    for kind, it in res["blocks"]:
        if kind in ("new-homeless", "write-back-homeless"):
            files.add(it)
        elif kind == "home-removed":
            files.add(it[0])
        elif kind in ("foreign", "foreign-awakened"):
            files.add(it[1]); notes_.add(it[0])
        elif kind == "route":
            files.update(it[1]); notes_.add(it[0])
        else:
            notes_.add(it[0])
    kind = "blocked" if blocked and cfg["mode"] == "on" else ("warned" if blocked else "passed")
    extra = {}
    if res["pairs"]:
        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
    if notes_:
        extra["notes"] = sorted(notes_)[:50]
    _gate_event_or_warn(root, "nodehome-check", kind,
                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
    return 1 if kind == "blocked" else 0


# ── cochange:co-change 漏改守衛(vault-free;borrow-design ROSE error-prevention) ──
# 規則:conf(A⇒B)=shared/freq(A)(非對稱條件機率,ROSE TSE 2005 §5);support=絕對共改次數。
# 設計 spec:docs/lumos-toolchain-knowledge/Projects/cochange守衛_計劃.md

_COCHANGE_DEFAULTS = {"min_support": 3, "min_confidence": 0.8, "max_changeset": 20}
_COCHANGE_DEFAULT_EXCLUDE = [
    "docs/.governance-log.jsonl", "docs/.bypass-log.jsonl", "docs/.ci-log.jsonl",
    "docs/.canary-log.jsonl", "docs/.rot-queue.jsonl", "docs/.kill-log.jsonl",
    "docs/.signoff-log.jsonl", "docs/.usage-log.jsonl",
    "**/*-lock.json", "**/*.lock", "**/node_modules/**", "**/dist/**",
    "**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs",
]


