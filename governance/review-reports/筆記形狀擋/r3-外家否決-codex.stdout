 25981	def cmd_refcheck(md_path, repo=None, as_json=False):
 25982	    """spec 指涉宣稱確定性核對(vault-free):inline-code 檔路徑/行號 → 存在性 manifest。
 25983	    抽取規則同 doctor Check P step 1-2(刻意複製、不共用——去重粒度不同:
 25984	    Check P 是 token 級,這裡是 (token, line);同檔多行號各自成 claim)。
 25985	    只驗 spec→repo 指涉,不驗 spec 內部一致性(canary 保留地)。"""
 25986	    import json
 25987	    md = Path(md_path)
 25988	    if not md.is_file():
 25989	        print(f"擋下:找不到這個檔案: {md_path}", file=sys.stderr)
 25990	        return 2
 25991	    if repo is not None:
 25992	        repo_root = Path(repo)
 25993	        if not repo_root.is_dir():
 25994	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 25995	            return 2
 25996	    else:
 25997	        repo_root = None
 25998	        for cand in (Path.cwd(), *Path.cwd().parents):
 25999	            if (cand / ".git").exists():
 26000	                repo_root = cand
 26001	                break
 26002	        if repo_root is None:
 26003	            print("擋下:從目前目錄往上找不到 git repo,用 --repo 指定專案根目錄", file=sys.stderr)
 26004	            return 2
 26005	    try:
 26006	        text = md.read_text(encoding="utf-8-sig")
 26007	    except OSError as e:
 26008	        print(f"擋下:檔案讀不到({e}): {md_path}", file=sys.stderr)
 26009	        return 2
 26010	
 26011	    claims, n_missing, n_oor, n_ok = _refcheck_scan(text, repo_root)
 26012	    if as_json:
 26013	        print(json.dumps({"claims": claims, "missing": n_missing,
 26014	                          "out_of_range": n_oor, "ok": n_ok}, ensure_ascii=False))
 26015	    else:
 26016	        print(f"refcheck {md}(對照的程式碼在 {repo_root})")
 26017	        for c in claims:
 26018	            loc = f"{c['token']}:{c['line']}" if c["line"] else c["token"]
 26019	            mark = "✓" if c["status"] == "ok" else "✗"
 26020	            tail = f" | {c['excerpt']}" if c["excerpt"] and "\n" not in c["excerpt"] else ""
 26021	            print(f"  {mark} {c['status']:<17} {loc}{tail}")
 26022	        print(f"統計: 對得上 ok {n_ok} / 檔案不存在 missing {n_missing} / 行號超出檔案長度 out_of_range {n_oor}")
 26023	    return 1 if (n_missing or n_oor) else 0
