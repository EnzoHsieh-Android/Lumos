 18311	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 18312	            return None
 18313	        return p
 18314	    for cand in (Path.cwd(), *Path.cwd().parents):
 18315	        if (cand / ".git").exists():
 18316	            return cand
