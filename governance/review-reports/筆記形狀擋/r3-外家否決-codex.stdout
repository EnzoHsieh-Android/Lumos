 26510	            continue
 27070	
 27071	    # 8.9 家(推筆記認家 [S6]):這條路沒有分數可排,家只能自己成一袋。
 27072	    # 同一篇既是家又在直接/間接袋裡就只留在家那袋——兩邊都列,下游(派工鏡頭)會把同一篇貼兩次。
 27073	    # 大檔照樣不當入口(家太多就沒有鑑別力),整袋留空。
 27074	    all_homes = []
 27075	    if int(_impact_knob("LUMOS_IMPACT_HOME", 1)):
 27076	        _home_nodes, _home_big = _impact_confirmed_homes(env, rel_file, repo_root)
 27077	        if not _home_big:
 27078	            _inc = {x["node"] for x in all_incidents}
 27079	            for _hn in _home_nodes:
 27080	                if _hn in _inc:
 27081	                    # 事故那袋留著它(事故優先,不重複列),但要標出它同時是家
 27082	                    # ——不標的話計劃模式的派工鏡頭看不出來,跟推送前那條路不一致(代碼審 r2 合約席)
 27083	                    for _ix in all_incidents:
 27084	                        if _ix.get("node") == _hn:
 27085	                            _ix["home"] = True
 27086	                    continue
 27087	                _hnote = env.notes.get(_hn)
 27088	                _hc, _hcombo = _impact_contract(_hnote) if _hnote else (None, False)
 27089	                all_homes.append({"node": _hn, "contract": _hc, "combo": _hcombo})
 27090	            _hset = {x["node"] for x in all_homes}
 27091	            if _hset:
 27092	                all_direct = [x for x in all_direct if x["node"] not in _hset]
 27093	                all_indirect = [x for x in all_indirect if x["node"] not in _hset]
 27094	
 27095	    # 9. 輸出
 27096	    if as_json:
 27097	        print(json.dumps(
 27098	            {"file": rel_file,
 27099	             **({"homes": all_homes} if all_homes else {}),
 27100	             "direct": all_direct, "indirect": all_indirect,
 27101	             "incidents": all_incidents},
 27102	            ensure_ascii=False,
 27103	        ))
 27104	    else:
 27105	        # 人讀輸出
 27106	        print(f"改動 {rel_file} (由讀盤 refcheck 抽取)")
 27107	        if all_homes:
 27108	            print(f"── 這支檔的家 ({len(all_homes)}) ──")
 27109	            for x in all_homes:
 27110	                contract_tag = f" ★{x['contract']}★" if x.get("contract") else ""
 27111	                print(f"  {x['node']}{contract_tag}")
 27112	        print(f"── 直接關聯 ({len(all_direct)}) ──")
 27113	        for x in all_direct:
 27114	            contract_tag = f" ★{x['contract']}★" if x.get("contract") else ""
 27115	            combo_tag = "★COMBO★" if x.get("combo") else ""
 27116	            tags = (contract_tag + (" " + combo_tag if combo_tag else "")).rstrip()
 27117	            print(f"  {'⚠合約 ' if x.get('contract') else ''}{x['node']}{tags}  ({x['hit']})")
