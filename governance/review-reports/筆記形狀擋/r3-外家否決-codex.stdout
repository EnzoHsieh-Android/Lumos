 22520	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22521	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
