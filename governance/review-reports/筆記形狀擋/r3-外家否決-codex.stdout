 26461	def _impact_confirmed_homes(env, rel_file, repo_root):
 26462	    """★這支檔「確認過的家」有哪幾篇★(推筆記認家 [S1][S2][S4];有排序、沒排序兩條路共用同一個答案)。
 26463	
 26464	    回 (節點清單, 是不是大檔)。大檔=家 ≥ LUMOS_IMPACT_ABOUT_MAX:那時「家」沒有鑑別力,
 26465	    呼叫端只加標記、不當入口。沒確認的家不列(摘要或正文要寫出完整路徑,或反引號裡寫唯一的裸檔名)。
 26466	    """
 26467	    homes, _own = _impact_home_map(env)
 26468	    mine = homes.get(_nodehome_key(rel_file), [])
 26469	    if not mine:
 26470	        return [], False
 26471	    big = len(mine) >= _impact_about_max()
 26472	    all_paths = _impact_repo_files(repo_root)
 26473	    tops = _nodehome_top_dirs(all_paths)
 26474	    target = _nodehome_key(rel_file)
 26475	    out = []
 26476	    for node in mine:
 26477	        if env.notes.get(node) is None:
 26478	            continue
 26479	        try:
 26480	            text = (env.vault / node).read_text(encoding="utf-8-sig")
 26481	        except OSError:
 26482	            continue
 26483	        if _home_confirmed(text, target, tops, all_paths):
 26484	            out.append(node)
 26485	    return out, big
