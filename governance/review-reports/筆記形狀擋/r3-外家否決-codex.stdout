 22854	def _nodehome_golive(repo_root, tip):
 22855	    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。"""
 22856	    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{_NODEHOME_GOLIVE_MARK}",
 22857	                        tip or "HEAD", "--", "scripts/hooks/pre-commit")
 22858	    if not raw:
 22859	        return None
 22860	    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
 22861	    return first if _LENS_SHA_RE.match(first) else None
