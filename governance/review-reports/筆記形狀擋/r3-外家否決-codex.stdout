 23614	def _delguard_parse_diff(diff_text, graph_root):
 23615	    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
 23616	    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
 23617	    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
 23618	    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
 23619	    2026-08-11 code-loop r1 C);stopword 表剔除;
 23620	    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
 23621	    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
 23622	    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
 23623	    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
 23624	    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
 23625	        ,"vault_diffs": {path: [line...]}}"""
 23626	    import re
 23627	    tok_re = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
 23628	
 23629	    def _flags(ln):
 23630	        m = re.search(r" b/(.+)$", ln)
 23631	        c = m.group(1) if m else None
 23632	        # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
 23633	        # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
 23634	        # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
 23635	        vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
 23636	        # 建置產物:任何深度都排(src/robin/ 不撞 bin/ 靠前面那個 "/" )
 23637	        # ★散文與帳本:只認 repo 根★(2026-09-06 代碼審 r1 外家席)——消費專案的
 23638	        # src/docs/parser.py、packages/governance/rules.py 很可能是真程式,不是散文;
 23639	        # 而且 git grep 那側的 :(exclude)docs 本來就只排根目錄、pre-commit 寫的也是
 23640	        # docs/*,三處要同一個語意才不會各自漂。
 23641	        excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
 23642	                                for seg in _DELGUARD_EXCLUDE_DIRS)
 23643	                            or any(c.startswith(seg) for seg in _DELGUARD_PROSE_DIRS)
 23644	                            or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
 23645	        return c, vault, excl
 23646	
 23647	    lines = diff_text.splitlines()
 23648	    # 第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔不收(文件提及不算「還活著」)
 23649	    added, cur, skip, in_binary = {}, None, True, False
 23650	    for ln in lines:
 23651	        if ln.startswith("diff --git"):
 23652	            cur, is_v, is_e = _flags(ln)
 23653	            skip = (cur is None) or is_v or is_e or cur.endswith(".md")
 23654	            in_binary = False
 23655	            continue
 23656	        if ln.startswith("Binary files"):
 23657	            in_binary = True
 23658	            continue
 23659	        if skip or in_binary:
 23660	            continue
 23661	        if ln.startswith("+") and not _delguard_is_diff_header(ln):
 23662	            added.setdefault(cur, set()).update(tok_re.findall(ln))
 23663	    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
 23664	    tokens, seen = [], set()
 23665	    vault_diffs, cur, is_vault, is_excl, in_binary = {}, None, False, False, False
 23666	    for ln in lines:
 23667	        if ln.startswith("diff --git"):
 23668	            cur, is_vault, is_excl = _flags(ln)
 23669	            in_binary = False
 23670	            continue
 23671	        if ln.startswith("Binary files"):
 23672	            in_binary = True
 23673	            continue
 23674	        if in_binary or cur is None:
 23675	            continue
 23676	        if is_vault and (ln.startswith("+") or ln.startswith("-")) and not _delguard_is_diff_header(ln):
 23677	            vault_diffs.setdefault(cur, []).append(ln)
 23678	            continue
 23679	        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
 23680	        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
 23681	        # (r2 code-loop 折入:N5)
 23682	        if is_vault or is_excl or cur.endswith(".md"):
 23683	            continue
 23684	        if ln.startswith("-") and not _delguard_is_diff_header(ln):
 23685	            fadd = added.get(cur) or frozenset()
 23686	            for t in tok_re.findall(ln):
 23687	                if t in _DELGUARD_STOP or t in fadd or t in seen:
 23688	                    continue
 23689	                seen.add(t); tokens.append(t)
 23690	    return {"tokens": tokens, "vault_diffs": vault_diffs}
 23691	
