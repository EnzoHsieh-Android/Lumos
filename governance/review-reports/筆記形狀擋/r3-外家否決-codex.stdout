  4504	def cmd_contracts(env, rel=None):
  4505	    """合約登記簿: ★INVARIANT★(改=breaking) / ★DEBT★(可改)。
  4506	    動某模組前先查它的硬合約 — Obsidian 做不到(子字串不在它的 graph 裡)。
  4507	    ★INVARIANT★ 顯示綁定的測試(可執行證據);未綁=⚠(doctor Check T 會擋)。"""
  4508	    targets = [rel] if rel else sorted(env.notes)
  4509	    n_inv = n_debt = 0
  4510	    for r in targets:
  4511	        inv, debt = extract_contracts(env.notes[r])
  4512	        if not inv and not debt:
  4513	            continue
  4514	        print(f"# {r}")
  4515	        for x in inv:
  4516	            clean, refs = strip_test_refs(x)
  4517	            print(f"  ★INVARIANT★ {clean}")
  4518	            print(f"      ↳ 綁的測試: {', '.join(refs)}" if refs else "      ↳ 提醒:沒綁測試,沒有可執行的證據")
  4519	            n_inv += 1
  4520	        for x in debt:
  4521	            print(f"  ★DEBT★ {x}")
  4522	            n_debt += 1
  4523	    if n_inv == 0 and n_debt == 0:
  4524	        print("(這篇沒有登記任何「動了會壞」的合約)" if rel else "(整個圖譜都沒有登記合約——要標的話在 KEY 行前面加 ★INVARIANT★ 或 ★DEBT★)")
  4525	    else:
  4526	        print(f"\n合約 {n_inv} 條(改了就是破壞性變更) | 技術債 {n_debt} 條(可以改)")
  4527	    return 0
