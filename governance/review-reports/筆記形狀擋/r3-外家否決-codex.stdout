 27421	def _lens_git(repo_root, *args, quote=False, binary=False):
 27422	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 27423	    import subprocess as _sp
 27424	    cmd = ["git", "-C", str(repo_root)]
 27425	    if quote:
 27426	        cmd += ["-c", "core.quotePath=false"]
 27427	    try:
 27428	        if binary:
 27429	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 27430	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 27431	    except (OSError, _sp.TimeoutExpired):
 27432	        return None
