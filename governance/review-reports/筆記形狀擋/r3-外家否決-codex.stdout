 20278	def _diff_added_lines(diff_text):
 20279	    """從 git diff -U3 輸出建 {file: set(new_line_numbers)} 對應所有新增行(+ 開頭)。
 20280	    使用與 _pitfall_diff_mode 相同的 @@ 標頭推導邏輯。"""
 20281	    added = {}
 20282	    cur_file, new_ln = "", 0
 20283	    for line in diff_text.splitlines():
 20284	        if line.startswith("+++ b/"):
 20285	            cur_file = line[6:]
 20286	            continue
 20287	        m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
 20288	        if m:
 20289	            new_ln = int(m.group(1))
 20290	            continue
 20291	        if line.startswith("+++") or line.startswith("---"):
 20292	            continue
 20293	        if line.startswith("-"):
 20294	            continue                          # 刪除行不推進新檔行號
 20295	        if not line.startswith("+"):
 20296	            new_ln += 1                       # context 行推進
 20297	            continue
 20298	        # 這是新增行(+ 開頭)
 20299	        if cur_file:
 20300	            added.setdefault(cur_file, set()).add(new_ln)
 20301	        new_ln += 1                           # 新增行推進新檔行號
 20302	    return added
