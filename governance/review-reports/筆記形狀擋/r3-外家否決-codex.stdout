 27409	def _lens_range_ok(diff_range):
 27410	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 27411	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 27412	        return None
