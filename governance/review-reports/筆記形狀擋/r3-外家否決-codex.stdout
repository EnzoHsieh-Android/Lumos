 22586	def _home_map_from_notes(items):
 22587	    """★家對照表的唯一算法★(推筆記認家 [S1]):輸入 (節點名, type, status, about_code 清單) 的序列,
 22588	    回 ({檔: [家那幾篇]}, {節點名: 自己管的檔集合})。只看 about_code 欄位值、不看預標指紋有沒有過期
 22589	    (指紋在每次寫回都會過期)。每支檔有家從提交快照餵、改檔前推筆記從已載入的圖譜餵,★兩邊共用這一支★——
 22590	    兩套算法一定分岔,而分岔時沒有東西會翻紅。"""
 22591	    homes, own = {}, {}
 22592	    for rel, typ, status, about in items:
 22593	        keys = {k for k in (_nodehome_key(v) for v in about) if k}
 22594	        own[rel] = keys
 22595	        if typ != "system" or status not in _NODEHOME_HOME_STATUSES:
 22596	            continue
 22597	        for k in keys:
 22598	            homes.setdefault(k, []).append(rel)
 22599	    return homes, own
