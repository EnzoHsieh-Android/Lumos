 26085	def _impact_reverse_lookup(rel_code_path, env, repo_root):
 26086	    """給一支 code 路徑,反查「哪些圖譜節點的 body inline-code 引用了它」。
 26087	
 26088	    設計要點(Task 2):
 26089	    - 只掃 body inline-code,絕不掃 core_refs(r7-F2)。
 26090	    - 複用 _refcheck_scan(text, repo_root) 抽取 body inline-code 路徑;
 26091	      Note 不存 body → 重讀盤每個 .md 餵它(r1-F1)。
 26092	    - 路徑規範化(r3-F5):輸入若為絕對路徑先轉 repo-relative 再比對。
 26093	    - _refcheck_scan 的 top_dirs 靜默過濾照舊(§4 天花板 5)。
 26094	
 26095	    回傳: list[(node_rel, hit)] — hit ∈ "body-inline-code"(完整路徑命中)|
 26096	    "basename-match"(裸檔名容錯,R2 2026-08-07,plan:hook必看召回修復)。
 26097	    同節點兩路皆中時完整路徑優先(單節點單筆,provenance 合併序明文)。
 26098	
 26099	    R2 裸檔名容錯:inline-code 中不含 `/` 的裸 token == 目標檔 basename,且該
 26100	    basename 在 `git ls-files` 母體內唯一(tracked-only:untracked/ignored 混入會把
 26101	    唯一誤判歧義;大小寫敏感)→ 命中。★不動共用的 _refcheck_scan★(其 `/` 過濾
 26102	    是 refcheck CLI/G1 gate 的既有合約,此處自建第二條抽取路)。git 缺席/重名
 26103	    → degrade 為不比對(裸檔名路靜默停用,完整路徑路不受影響)。
 26104	    knob:LUMOS_IMPACT_BASENAME_MATCH(2026-08-07 轉正預設 1;0=逃生/A 臂)。ls-files 結果以 repo_root 為鍵行程內快取(--diff 多檔不重跑子行程)。
 26105	    """
 26106	    import os
 26107	    import subprocess
 26108	
 26109	    repo_root = Path(repo_root)
 26110	
 26111	    # 路徑規範化:絕對路徑 → repo-relative
 26112	    rp = str(rel_code_path)
 26113	    if os.path.isabs(rp):
 26114	        rp = os.path.relpath(rp, str(repo_root))
 26115	
 26116	    # R2:裸檔名比對的前置——目標檔 basename 在 tracked 母體唯一才啟用
 26117	    base_ok = False
 26118	    base = Path(rp).name
 26119	    if int(_impact_knob("LUMOS_IMPACT_BASENAME_MATCH", 1)):   # 2026-08-07 考卷轉正預設 1(knob=0 留逃生)
 26120	        key = str(repo_root)
 26121	        counts = _BASENAME_COUNTS_CACHE.get(key)
 26122	        if counts is None:
 26123	            counts = {}
 26124	            for ln in _impact_repo_files(repo_root):   # git 缺席=degrade(空表=永不唯一)
 26125	                b = Path(ln).name
 26126	                counts[b] = counts.get(b, 0) + 1
 26127	            _BASENAME_COUNTS_CACHE[key] = counts
 26128	        base_ok = counts.get(base, 0) == 1
 26129	
 26130	    hits = []
 26131	    for node_rel, note in env.notes.items():
 26132	        # 重讀盤:Note 不存 body,直接讀原始 .md 文字
 26133	        md_path = env.vault / node_rel
 26134	        try:
 26135	            text = md_path.read_text(encoding="utf-8-sig", errors="replace")
 26136	        except OSError:
 26137	            continue
 26138	        claims, _n_missing, _n_oor, _n_ok = _refcheck_scan(text, repo_root)
 26139	        hit = None
 26140	        for claim in claims:
 26141	            if claim["token"] == rp:
 26142	                hit = "body-inline-code"   # 完整路徑優先
 26143	                break
 26144	        if hit is None and base_ok:
 26145	            # 第二條抽取路:裸 token(無 /)——與 _refcheck_scan 同一支抽取(_node_code_ref_tokens)
 26146	            if base in _node_code_ref_tokens(text, set())[1]:
 26147	                hit = "basename-match"
 26148	        if hit:
