  4558	def check_regen_provenance(note, repo_root):
  4559	    """Check J(regen 重生來源守衛)共用檢查器——cmd_lint 與 run_doctor 同呼叫同一函式(防兩入口
  4560	    規則漂移)。只對 frontmatter 帶 regen 的節點生效;非 regen 節點回三空。只掃 summary 行。
  4561	    回 (errs, warns, gov_events),兩入口映射(spec 映射表,照抄不猜):
  4562	      errs → lint errs 計 rc1 / doctor warn(hard) 計 issues
  4563	      warns → lint 顯示不計 rc / doctor warn_soft(J-d 提醒與 shallow 降級兩入口皆非阻擋)
  4564	      gov_events → 僅 doctor --ci 落 _append_governance_log;lint 高頻一律不落帳(防治理帳灌水)
  4565	    註:本函式為 regen 節點對 lint「node-local 不掃 repo」原則的 opt-in 例外(檔案+git 存取)。
  4566	    設計:Projects/from-scratch重生守衛_計劃;golden: governance/golden/fromscratch-m1。"""
  4567	    errs, warns, gov = [], [], []
  4568	    regen = note.fields.get("regen")
  4569	    if not (isinstance(regen, str) and regen.strip()):
  4570	        return errs, warns, gov
  4571	    summ = note.fields.get("summary")
  4572	    summ = summ if isinstance(summ, str) else ""
  4573	    shallow = None  # 惰性判定(每節點至多一次 rev-parse)
  4574	    untagged_keys = 0
  4575	    has_git_ptr = "[git:" in summ  # presence-guard:整節點無 [git: 子串即不 spawn
  4576	    for raw in summ.split("\n"):
  4577	        line = raw.strip()
  4578	        if not line:
  4579	            continue
  4580	        has_src = SRC_REF_RE.search(line)
  4581	        has_git = GIT_REF_RE.search(line)
  4582	        prefix_m = REGEN_PREFIX_RE.match(line)
  4583	        # 不對稱接線:推測/佚失 不得承載合約/不可逆(raw 行獨立偵測——INVARIANT_RE 對此形態
  4584	        # 整行不 match,靠它=該行對 Check T/contracts 隱形,比擋下更毒;四組合皆觸發)
  4585	        if prefix_m and ("★INVARIANT★" in line or "★IRREVERSIBLE★" in line):
  4586	            errs.append(f"『{prefix_m.group(1)}:』行不得承載 ★INVARIANT★/★IRREVERSIBLE★"
  4587	                        f"(合約不能建在推測上;補 [src:]/[git:] 或走 signoff 升級):{line[:48]}")
  4588	            continue
  4589	        # J-a:regen ★INVARIANT★ 需 [src:]/[git:] 意圖證據(與 Check T 的 [test:] 疊加——
  4590	        # [test:] 只證行為現在成立,不證意圖是合約;拒絕發明合約)
  4591	        if INVARIANT_RE.match(line) and not (has_src or has_git):
  4592	            errs.append(f"regen 節點的 ★INVARIANT★ 缺 [src:]/[git:] 意圖證據"
  4593	                        f"(J-a 拒絕發明合約):{line[:48]}")
  4594	        # J-b:DECISION 行需證據指針或顯式標 推測:/佚失:(重建的 why 必須標來源或標推測)
  4595	        if line.startswith("DECISION:") and not (has_src or has_git or prefix_m):
  4596	            errs.append(f"regen 節點的 DECISION 行無證據指針且未標 推測:/佚失:(J-b):{line[:48]}")
  4597	        # J-d:無 tier 標記的 KEY 行計數(唯讀提醒,不寫回任何欄位)
  4598	        if line.startswith("KEY:") and not (has_src or has_git or prefix_m):
  4599	            untagged_keys += 1
  4600	        # J-c:[src:] substring gate(直走 _validate_repo_ref,不經 top_dirs 靜默過濾)
  4601	        for m in SRC_REF_RE.finditer(line):
  4602	            path, lno = m.group(1).strip(), (m.group(2) or "")
  4603	            status, _ = _validate_repo_ref(repo_root, path, lno)
  4604	            if status == "missing":
  4605	                errs.append(f"[src:{path}] 目標不存在(J-c dangling=幻覺證據)")
  4606	            elif status == "line_out_of_range":
  4607	                errs.append(f"[src:{path}:{lno}] 行號越界(J-c)")
  4608	        # J-c:[git:sha](presence-guard 後才 spawn;shallow 降級=顯性+僅 doctor --ci 留痕,不得靜默)
  4609	        if has_git_ptr:
  4610	            for m in GIT_REF_RE.finditer(line):
  4611	                sha = m.group(1)
  4612	                if _git_commit_exists(repo_root, sha):
  4613	                    continue
  4614	                if shallow is None:
  4615	                    shallow = _git_is_shallow(repo_root)
  4616	                if shallow:
  4617	                    warns.append(f"[git:{sha[:12]}] Tier B 驗證跳過(shallow clone,本地無該物件;"
  4618	                                 f"非擋——full clone 下會重驗)")
  4619	                    gov.append({"gate": "check-j", "kind": "shallow-skip", "hard": False,
  4620	                                "nodes": [note.stem]})
  4621	                else:
  4622	                    errs.append(f"[git:{sha[:12]}] commit 不存在(J-c dangling=幻覺證據)")
  4623	    if untagged_keys:
  4624	        warns.append(f"{untagged_keys} 條 KEY 行無 tier 標記([src:]/[git:]/推測:/佚失:)"
  4625	                     f"——J-d 提醒:prose 級誠實機械驗不了,建議補標或過對抗審")
  4626	    return errs, warns, gov
