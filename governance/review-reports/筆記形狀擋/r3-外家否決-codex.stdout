  4477	def discover_test_methods(repo_root, profile=None):
  4478	    """掃 repo 內測試檔,回傳「真實測試方法名」集合(被測試框架註解標註者)。
  4479	    測試棧 profile 決定掃哪些副檔名 + 用哪條方法 regex(預設 csharp-xunit;P5 語言可插拔)。
  4480	    Check T 用此集合驗證 ★INVARIANT★ 綁定的是『可執行證據』而非散文裡的字面巧合(B6 審計)。"""
  4481	    profile = profile or load_test_profile(repo_root)
  4482	    mre = profile["method_re"]
  4483	    strip = profile.get("comment_strip", "c-style")  # 預設 c-style 向後相容;python="none"
  4484	    methods = set()
  4485	    for txt in _walk_test_files(repo_root, profile):
  4486	        # 去註解(語言感知,2026-07-25 根因修):c-style 剝 // 與 /*..*/(行尾註解會打斷
  4487	        # 「註解串→方法簽章」連續比對,真測試被誤判偽證據)。★python 走 "none" 不剝★——
  4488	        # Python 無 C 式註解,剝了反被中文註解/字串字面裡的 /*..*/ 配對誤吃大段內容
  4489	        # (實測 test_lumos.py 260→94);被註解的 # def 不在行首,PYTHON_TEST_RE 行首錨排除。
  4490	        if strip in ("c-style", "c-style+strings"):
  4491	            txt = re.sub(r"//[^\n]*", "", txt)
  4492	            txt = re.sub(r"/\*.*?\*/", "", txt, flags=re.S)
  4493	        # ★"c-style+strings" 多剝字串字面★(2026-09-12 Java 補棧代碼審 r1):字串內容清空但保留
  4494	        # 引號本身,所以「字串裡剛好寫著方法簽章」不會被當成真的測試方法。單行內比對(不跨換行),
  4495	        # 跨行的 Java text block 不在此列——那是已知邊界,寫在 JAVA_TEST_RE 的註解裡。
  4496	        if strip == "c-style+strings":
  4497	            txt = re.sub(r'"(?:\\.|[^"\\\n])*"', '""', txt)
  4498	            txt = re.sub(r"'(?:\\.|[^'\\\n])*'", "''", txt)
  4499	        for m in mre.finditer(txt):
  4500	            methods.add(m.group(1).strip("`"))  # Kotlin 反引號測試名去引號
  4501	    return methods
