 27443	def _mainline_ref(repo_root):
 27444	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 27445	    回 (ref 名, sha) 或 None。"""
 27446	    for cand in ("main@{upstream}", "master@{upstream}", "main", "master"):
 27447	        sha = _lens_full_sha(repo_root, cand)
 27448	        if sha:
 27449	            return cand, sha
 27450	    return None

