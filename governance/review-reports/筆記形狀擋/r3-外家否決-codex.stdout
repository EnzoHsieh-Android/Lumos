 26026	_GIT_DATES_CACHE = {}   # (repo_root, vault) → {vault 相對路徑: 最後改動日期}(行程內)
 26027	
 26028	
 26029	def git_last_change_dates(repo_root, vault):
 26030	    """★一次 git log 拿 vault 底下每個檔的最後改動日期★(工具清單 #5,2026-08-23)。
 26031	
 26032	    回 {vault 相對路徑: "YYYY-MM-DD"}。git 缺席/不是 repo/失敗 → 回 {}(fail-open)。
 26033	    ★2026-08-24:about_code 過期判準已改記正文雜湊(note_body_hash),本函式不再是它的材料、目前無呼叫者★
 26034	    (三輪設計審實證日期表達不了「標記在同日序列的哪一格」);保留供日後批次日期需求。
 26035	
 26036	    為什麼要批次:design-loop about-code-field r3 實測逐篇 `git log -1 -- <檔>` 83 次 5.3s,
 26037	    批次 0.22s,差 18 倍;impact 跑在 PreToolUse hook,逐篇會把它拖進秒級。
 26038	    為什麼要 `-c core.quotepath=false`:vault 檔名幾乎全中文,預設輸出是八進位跳脫
 26039	    (`\347\257\204…`),對不回路徑——★沒這旗標整張表是空的,而且不報錯★。
 26040	    用 `updated` 欄的問題:席三抽 15 篇,5 篇(33%)落後 git 實際改動日期——正文改了沒 lumos set。
 26041	    """
 26042	    import subprocess
 26043	    key = (str(repo_root), str(vault))
 26044	    if key in _GIT_DATES_CACHE:
 26045	        return _GIT_DATES_CACHE[key]
 26046	    out = {}
 26047	    try:
 26048	        rel_vault = os.path.relpath(str(vault), str(repo_root))
 26049	        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotepath=false",
 26050	                            "log", "--name-only", "--format=@%cs", "--", rel_vault],
 26051	                           capture_output=True, text=True, errors="replace", timeout=30)
 26052	        if r.returncode == 0:
 26053	            cur = None
 26054	            prefix = rel_vault.rstrip("/") + "/"
 26055	            for line in r.stdout.splitlines():
 26056	                if line.startswith("@"):
 26057	                    cur = line[1:11]
 26058	                elif line.strip() and cur and line.startswith(prefix):
 26059	                    rel = line[len(prefix):]
 26060	                    if rel not in out:          # log 是新→舊,第一次看到就是最新
 26061	                        out[rel] = cur
 26062	    except (OSError, subprocess.SubprocessError):
 26063	        out = {}
 26064	    _GIT_DATES_CACHE[key] = out
 26065	    return out
