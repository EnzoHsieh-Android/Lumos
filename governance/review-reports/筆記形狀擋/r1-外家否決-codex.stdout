  6188	    try:
  6189	        if _cochange_excluded(path, _nodehome_config(rr)["ignore"]):
  6190	            return False
  6191	    except Exception:
  6192	        pass
  6193	    kind = _nodehome_code_kind(path)
  6194	    if kind == "ext":
  6195	        return True
  6196	    if kind != "shebang?":
  6197	        return False
  6198	    try:
  6199	        with open(Path(rr) / path, "rb") as f:
