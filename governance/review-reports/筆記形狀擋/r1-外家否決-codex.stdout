 28183	def _excl_lock_try(lock, stale_sec):
 28184	    """獨佔建鎖檔(內容=程序編號+時間),搶到回 True、沒搶到回 False;專案裡唯一的一套鎖檔做法
 28185	    (dispatch-lens 的「同範圍只讓一個在算」與筆記庫寫入鎖 _vault_write_lock 共用;2026-09-10 從 dispatch-lens 抽出來)。
 28186	
 28187	    ★接手也要原子★(2026-09-07 代碼審 r2 外家席):第一版的過期判斷是
 28188	    「建不成 → 看鎖檔多舊 → 太舊就當它死了」,**但只是把 already 設成 False 就繼續往下派工,
 28189	    沒有真的把鎖換成自己的**。於是鎖一旦過期,同時進來的每一個呼叫者都會各自派一支去算
 28190	    (實測兩個呼叫者都判定要派工)。更糟的是先算完的那支會無條件刪掉鎖檔,
 28191	    可能刪掉另一支正在用的。
 28192	    現在:過期(比 stale_sec 舊)時用「換名字」的方式原子接手——只有真的把舊鎖搬走的那個人才算搶到。"""
 28193	    import time as _t
 28194	    try:
 28195	        lock.parent.mkdir(parents=True, exist_ok=True)
 28196	        fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
 28197	        os.write(fd, f"{os.getpid()}\n{_t.time():.0f}".encode())
 28198	        os.close(fd)
 28199	        return True
 28200	    except FileExistsError:
 28201	        pass
 28202	    except OSError:
 28203	        return False
 28204	    # 鎖已存在:只有「明顯過期」才嘗試接手,而且接手本身必須是原子的
 28205	    try:
 28206	        if _t.time() - lock.stat().st_mtime < stale_sec:
 28207	            return False                      # 還新,別人在用
 28208	    except OSError:
 28209	        return False
 28210	    stale = lock.with_name(lock.name + f".stale-{os.getpid()}")
 28211	    try:
 28212	        os.rename(str(lock), str(stale))      # ★原子★:同時兩個人只有一個 rename 得到
 28213	    except OSError:
 28214	        return False                          # 別人先接手了
 28215	    try:
 28216	        stale.unlink()
 28217	    except OSError:
 28218	        pass
 28219	    return _excl_lock_try(lock, stale_sec)     # 舊鎖清掉了,再正常搶一次
