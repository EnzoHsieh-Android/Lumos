  6160	        for f in code:
  6161	            for srel in homes.get(_nodehome_key(f), []):
  6162	                systems.add(srel[:-3] if srel.endswith(".md") else srel)
  6163	    if systems:   # 落點被碰到:lands_in/related/正文連結任一指向被改的 Systems 節點(跟門判定訊號 2 同一份連結來源)
  6164	        for prel, n in env.notes.items():
  6165	            if not prel.startswith("Projects/") or str(n.fields.get("status")) != "doing":
  6166	                continue
  6167	            try:
  6168	                ptxt = (env.vault / prel).read_text(encoding="utf-8-sig")
  6169	            except (OSError, UnicodeDecodeError):
  6170	                ptxt = ""
  6171	            if set(_plan_system_links(n, text=ptxt, systems_only=False)) & systems:
  6172	                plans.add(prel)
  6173	    return plans
