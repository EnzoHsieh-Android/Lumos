 22284	_NODEHOME_STACK_TEST_DIRS = None   # lazy:({頂層資料夾結尾樣式: 貢獻它的棧的副檔名}, {src/ 底下的測試資料夾名: 貢獻它的棧的副檔名})
 22285	
 22286	
 22287	def _nodehome_stack_test_dirs():
 22288	    """從測試棧對照表 TEST_PROFILES 推各棧的測試資料夾,不另寫清單(對照表多一個,這裡跟著認;
 22289	    t_nodehome_stack_test_dirs_not_required 的漂移守衛釘住):頂層比對模式的棧(Swift、C#)取「頂層資料夾名稱結尾」,
 22290	    限 src/ 底下遞迴找的棧(Kotlin/Gradle)取「src/ 底下的資料夾名」,兩種都連同那一棧的副檔名。其餘遞迴模式的棧不推——
 22291	    Python 那份把 scripts 當測試資料夾、Playwright 的 tests/e2e 不限位置,錨定太鬆會把真程式檔放掉。"""
 22292	    global _NODEHOME_STACK_TEST_DIRS
 22293	    if _NODEHOME_STACK_TEST_DIRS is None:
 22294	        sufs, under_src = {}, {}
 22295	        for prof in TEST_PROFILES.values():
 22296	            names = {d for inc, _exc in prof.get("dirs", {}).values() for d in inc if d}
 22297	            if prof.get("dir_mode") == "suffix":
 22298	                for d in names:
 22299	                    sufs.setdefault(d, set()).update(prof.get("exts", ()))
 22300	            elif prof.get("rglob_under") == "src":
 22301	                for d in names:
 22302	                    under_src.setdefault(d, set()).update(prof.get("exts", ()))
 22303	        _NODEHOME_STACK_TEST_DIRS = ({k: frozenset(v) for k, v in sufs.items()}, {k: frozenset(v) for k, v in under_src.items()})
 22304	    return _NODEHOME_STACK_TEST_DIRS
 22305	
