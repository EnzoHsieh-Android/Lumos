  6153	def _spec_gate_push_candidates(env, rr, vrel, touched):
  6154	    """推送前要查哪些計劃:範圍碰到的計劃檔,加上 lands_in/related/正文連結指向「被碰到的 Systems 節點或被改程式檔的家」的 doing 計劃。"""
