 23052	                reminders.append(("home-unmentioned", (rel, f)))
 23053	    for f in sorted(bad_names & changed_new):
 23054	        reminders.append(("bad-name", f))
 23055	    return {"blocks": blocks, "reminders": reminders, "pairs": pairs}
