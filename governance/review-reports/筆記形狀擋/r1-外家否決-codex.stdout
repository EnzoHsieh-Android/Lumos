 14229	def _vault_write_lock(vault):
 14230	    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
 14231	    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。
 14232	
 14233	    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
 14234	    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
 14235	    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
 14236	    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
 14237	    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
 14238	    import contextlib, time as _t
 14239	
 14240	    @contextlib.contextmanager
 14241	    def _cm():
 14242	        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
 14243	        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
 14244	        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
 14245	        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
 14246	        lock, why = _vault_lock_where(vault)
 14247	        k = str(lock)
 14248	
 14249	        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
 14250	            _VAULT_LOCK_HELD[k] += 1
 14251	            try:
 14252	                yield
 14253	            finally:
 14254	                _VAULT_LOCK_HELD[k] -= 1
 14255	            return
 14256	
 14257	        if why and not _VAULT_LOCK_WARNED.get(k):
 14258	            _VAULT_LOCK_WARNED[k] = True
 14259	            _vault_lock_say(lock, why)
 14260	        deadline = _t.monotonic() + 60
 14261	        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
 14262	            if _t.monotonic() > deadline:
 14263	                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
 14264	            _t.sleep(0.05)
 14265	        _VAULT_LOCK_HELD[k] = 1
 14266	        try:
 14267	            yield
 14268	        finally:
 14269	            _VAULT_LOCK_HELD.pop(k, None)
 14270	            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
 14271	                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
 14272	                    lock.unlink()
 14273	            except OSError:
 14274	                pass
 14275	    return _cm()
