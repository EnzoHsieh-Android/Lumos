 29969	def _codeloop_guard_verdict(repo_root, diff_range=None, at_sha=None, branch=None, skip_bound=False, skip_note="", payload=None, bound_advisory=False):
 29970	    """判定式:tier=high(pitfalls --diff <range> --no-lint --json)
 29971	    AND 無有效 pass/skip 留痕 → blocked=True。
 29972	    留痕座標(prepush範圍修法 #2):at_sha/branch 給了則綁該座標(hook 傳被推送 ref 的
 29973	    local_sha 與 remote_ref 分支),否則讀當前 checkout HEAD/branch(向後相容)。
 29974	    diff_range 給了則跳 merge-base 推導直接算 tier;否則沿 merge-base..HEAD 現行為。
 29975	    fail-open:pitfalls 出錯 / 非 git / 無 merge-base → tier 視作非 high(不 blocked)。
 29976	    回傳 dict{blocked:bool, reason:str, tier:str}。
 29977	    """
 29978	    import json as _json
 29979	    import subprocess as _sp
 29980	
 29981	    # 留痕比對座標:優先用傳入的(hook 綁被推送 ref),否則讀 checkout
 29982	    _codeloop_guard_verdict.last_bound = None   # 每次呼叫先清,提早 fail-open 的分支不會拿到上一輪的殘留
 29983	    _codeloop_guard_verdict.last_dispositions = None
 29984	    _codeloop_guard_verdict.last_lint_new = None
 29985	    marker_sha = at_sha or _codeloop_git_head(repo_root)
 29986	    marker_branch = branch or _codeloop_git_branch(repo_root)
 29987	    if not marker_sha:
 29988	        _gate_failopen(repo_root, "code-loop", "無法取得 HEAD sha")
 29989	        return {"blocked": False, "reason": "無法取得 HEAD sha(fail-open)", "tier": "unknown"}
 29990	
 29991	    if diff_range is None:
 29992	        # 現行為:merge-base..HEAD 推導(向後相容)
 29993	        head_sha = _codeloop_git_head(repo_root)
 29994	        mb = None
 29995	        for base_branch in ("main", "master"):
 29996	            r = _sp.run(["git", "merge-base", "HEAD", base_branch],
 29997	                        capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 29998	            if r.returncode == 0 and r.stdout.strip():
 29999	                mb = r.stdout.strip()
 30000	                if mb == head_sha:
 30001	                    return {"blocked": False, "reason": "merge-base == HEAD(無 branch diff)", "tier": "standard"}
 30002	                break
 30003	        if not mb:
 30004	            _gate_failopen(repo_root, "code-loop", "算不出 merge-base")
 30005	            return {"blocked": False, "reason": "無 merge-base(fail-open)", "tier": "unknown"}
 30006	        diff_range = f"{mb}..HEAD"
 30007	
