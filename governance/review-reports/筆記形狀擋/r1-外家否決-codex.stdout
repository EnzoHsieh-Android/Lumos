 23258	def cmd_home_check(repo=None, staged=False, diff_range=None):
 23259	    """lumos home check --staged | --diff A..B [S24]:有新違規 rc1,沒有 rc0;沒有圖譜/合併中/開關 off 說一句跳過、rc0。
 23260	    git 跑不起來=fail-open(說一句、rc0):這道閘只擋「確定是新違規」的,不因為環境壞了擋人。
 23261	    ★設定、工具自裝檔、圖譜位置都從被檢查的那個版本讀★(提交前=提交索引、推送前=終點那個提交),不讀工作目錄。"""
 23262	    root = Path(repo).resolve() if repo else None
 23263	    if root is None:
 23264	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 23265	        if r is None or r.returncode != 0:
 23266	            print("擋下:這裡不是 git 專案,用 --repo 指定", file=sys.stderr)
 23267	            return 2
 23268	        root = Path(r.stdout.strip())
 23269	    if staged:
 23270	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 23271	        if mh is not None and mh.returncode == 0:
 23272	            print("每支檔有家:合併提交跳過(推送前會把合併的結果整段查一次)", file=sys.stderr)
 23273	            return 0
 23274	        head = _lens_full_sha(root, "HEAD")
 23275	        base_where, tip_where, mode_word = head, "index", "這次提交"
 23276	        changes = _nodehome_changes(root, head, "index")
 23277	    else:
 23278	        # 寫法用派工鏡頭那支判法:恰好兩個點、兩端都有、不收三個點——原本只切第一個「..」,
 23279	        # 三個點的寫法變成「起點 到 .終點」、找不到就放行,同一條違規完全沒擋(代碼審 r1 邊界席)
 23280	        rg = _lens_range_ok(diff_range)
 23281	        if rg is None:
 23282	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有(三個點的寫法這裡不收:"
 23283	                  "先用 git merge-base 算出起點再給)", file=sys.stderr)
 23284	            return 2
 23285	        a, b = rg
 23286	        tip = _lens_full_sha(root, b)
 23287	        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
 23288	        if tip is None or base is None:
 23289	            print(f"每支檔有家:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
 23290	            return 0
 23291	        base = _nodehome_clamp_base(root, base, tip)
 23292	        base_where = None if base == _EMPTY_TREE_SHA else base
 23293	        tip_where, mode_word = tip, "這次推送"
 23294	        changes = _nodehome_changes(root, base_where, tip)
 23295	    if changes is None:
 23296	        print("每支檔有家:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
 23297	        return 0
 23298	    lst = _nodehome_list(root, tip_where)
 23299	    if lst is None:
 23300	        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23301	        return 0
 23302	    # 圖譜位置:被檢查的那個版本裡的 docs/*-knowledge(推送一個不是目前 checkout 的分支,工作目錄那份可能不一樣)
 23303	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 23304	    wv = _vault_in(root)
 23305	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23306	    if wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults:
 23307	        vault_rel = wv_rel
 23308	    elif vaults:
 23309	        vault_rel = "docs/" + vaults[0]
 23310	    else:
 23311	        print("每支檔有家:這個專案沒有圖譜,跳過")
 23312	        return 0
 23313	    reader = _nodehome_reader(root, tip_where)
 23314	    cfg = _nodehome_config(root, reader(".lumos/config.json"), from_snapshot=True)
 23315	    for w in cfg["warnings"]:
 23316	        print(f"提醒:{w}", file=sys.stderr)
 23317	    if cfg["mode"] == "off":
 23318	        print("每支檔有家:這個專案把這道檢查關掉了(node_home.gate=off),跳過", file=sys.stderr)
 23319	        return 0
 23320	    N = _nodehome_side(root, tip_where, vault_rel)
 23321	    changed_paths = {p for _c, o, n in changes for p in (o, n) if p}
 23322	    B = _nodehome_side(root, base_where, vault_rel, share=N, changed=changed_paths)
 23323	    if B is None or N is None:
 23324	        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23325	        return 0
 23326	    skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root, "" if staged else tip_where)[0]
 23327	    groups = None if staged else _nodehome_mark_note_content(root, _nodehome_commit_groups(root, base_where, tip_where), vault_rel)
 23328	    res = _nodehome_evaluate(root, B, N, changes, cfg, skip, vault_rel, groups=groups)
 23329	    homesN, _own = _nodehome_homes(root, N)
 23330	    lines = _nodehome_render(res, homesN, N, cfg, mode_word)
 23331	    blocked = bool(res["blocks"])
 23332	    if blocked and cfg["mode"] == "warn":
 23333	        lines = [l.replace("擋下:", "提醒(node_home.gate=warn,不擋):", 1) for l in lines]
 23334	    for l in lines:
 23335	        print(l, file=sys.stderr)
 23336	    # 治理帳:nodes 只放程式檔路徑(統計語意表這麼宣告);沒有程式檔的違規(負責範圍)把節點另放 notes
 23337	    files, notes_ = set(), set()
 23338	    for kind, it in res["blocks"]:
 23339	        if kind in ("new-homeless", "write-back-homeless"):
 23340	            files.add(it)
 23341	        elif kind == "home-removed":
 23342	            files.add(it[0])
 23343	        elif kind in ("foreign", "foreign-awakened"):
 23344	            files.add(it[1]); notes_.add(it[0])
 23345	        elif kind == "route":
 23346	            files.update(it[1]); notes_.add(it[0])
 23347	        else:
 23348	            notes_.add(it[0])
 23349	    kind = "blocked" if blocked and cfg["mode"] == "on" else ("warned" if blocked else "passed")
 23350	    extra = {}
 23351	    if res["pairs"]:
 23352	        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
 23353	    if notes_:
 23354	        extra["notes"] = sorted(notes_)[:50]
