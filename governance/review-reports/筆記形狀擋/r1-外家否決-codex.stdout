 22421	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 22422	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
 22423	    if where is None:
 22424	        return {}, []
 22425	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 22426	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 22427	    if raw is None:
 22428	        return None
 22429	    files, allp = {}, []
 22430	    for ent in raw.split(b"\0"):
 22431	        if not ent or b"\t" not in ent:
 22432	            continue
 22433	        meta, p = ent.split(b"\t", 1)
 22434	        parts = meta.split()
 22435	        if where == "index":
 22436	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 22437	                continue
 22438	            mode = parts[0]
 22439	        else:
 22440	            if len(parts) != 3:
 22441	                continue
 22442	            mode = parts[0]
 22443	        path = nfc(os.fsdecode(p))
 22444	        allp.append(path)
 22445	        if mode in (b"100644", b"100755"):
 22446	            files[path] = mode.decode()
 22447	    return files, allp
