   951	def _append_governance_log(vault, events):
   952	    """寫者=doctor --ci + anchor approve:把 gate findings append 到 docs/.governance-log.jsonl。
   953	    非 git / 取不到 HEAD → 跳過(不報錯)。dedup 留給讀時(lumos gov)。"""
   954	    if not events:
   955	        return
   956	    import json
   957	    import datetime
   958	    import subprocess
   959	    try:
   960	        commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
   961	                                capture_output=True, text=True, errors="replace", cwd=str(vault)).stdout.strip()
   962	    except Exception:
   963	        commit = ""
   964	    if not commit:
   965	        return
   966	    ts = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
   967	    path = vault.parent / ".governance-log.jsonl"
   968	    try:
   969	        with open(path, "a", encoding="utf-8") as f:
   970	            for e in events:
   971	                f.write(json.dumps({"ts": ts, "commit": commit, **e}, ensure_ascii=False) + "\n")
   972	    except OSError:
   973	        pass
