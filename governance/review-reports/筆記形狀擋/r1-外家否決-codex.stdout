 30275	def cmd_code_loop(subcmd, note=None, repo=None, as_json=False, diff_range=None, at_sha=None, marker_branch=None, skip_bound=False, from_json=None, disp_file=None, qid=None, bound_advisory=False):
 30276	    """code-loop 留痕讀寫。
 30277	    pass  → status=passed(綁 HEAD sha);
 30278	    skip  → status=skipped(綁 HEAD sha,留逃生痕);
 30279	    dispositions <檔> → 棧別提問表態(表態閘 2026-09-09;派審查員之前寫,skip 也要先表態);
 30280	    recall-miss <id> → 審查席抓到未觸發題的問題時登記一筆;
 30281	    check → 跑判定式回報 verdict(blocked=合約測試紅 ∨ 有適用題表態不完整 ∨ tier=high∧無有效留痕);--json 輸出 verdict dict。
 30282	    rc: 0=OK / 1=check:blocked / 2=參數錯。
 30283	    """
 30284	    # resolve repo root
 30285	    if repo is not None:
 30286	        repo_root = Path(repo)
 30287	        if not repo_root.is_dir():
 30288	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 30289	            return 2
