   976	def _read_touched_list(path):
   977	    """讀「這次推送改到哪些檔」的清單(一行一個)。沒給=None(代表不收窄、照舊全擋)。
   978	
   979	    ★讀不到也回 None,不是回空集合★:空集合的意思是「這次什麼都沒碰到」,會讓整段靜音;
   980	    檔案打不開是我們自己的問題,不該因此少擋一條(必要合約清單_計劃〈擋的範圍〉)。
   981	    """
   982	    if not path:
   983	        return None
   984	    try:
   985	        lines = Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
   986	    except OSError:
   987	        return None
   988	    return {ln.strip() for ln in lines if ln.strip()}
