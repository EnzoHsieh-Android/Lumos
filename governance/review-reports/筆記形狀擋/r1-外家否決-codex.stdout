   951	def _append_governance_log(vault, events):
   952	    """寫者=doctor --ci + anchor approve:把 gate findings append 到 docs/.governance-log.jsonl。
   953	    非 git / 取不到 HEAD → 跳過(不報錯)。dedup 留給讀時(lumos gov)。"""
