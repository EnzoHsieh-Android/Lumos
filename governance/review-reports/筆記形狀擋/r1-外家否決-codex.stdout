 23083	        by.setdefault(kind, []).append(item)
 23084	    if B:
 23085	        L.append(f"擋下:{mode_word}有 {len(B)} 條「每支檔有家」的新違規。")
 23086	        L.append("每支程式檔要有一篇管它的節點(about_code 列了它);沒有家的檔,改它時工具推不出該看的筆記,寫回也不知道該落哪——兩個專案就是這樣長出一篇包全部的節點。")
 23087	    homeless = sorted(set(by.get("new-homeless", []) + by.get("write-back-homeless", [])))
 23088	    if homeless:
 23089	        L.append("")
 23090	        L.append(f"■ 這幾支程式檔沒有家({len(homeless)} 支)——新增的檔、或這次要寫說明卻還沒家的檔:")
 23091	        groups = {}
 23092	        for f in homeless:
 23093	            groups.setdefault(f.rsplit("/", 1)[0] if "/" in f else "(根目錄)", []).append(f)
 23094	        shown = 0
 23095	        for d, fs in sorted(groups.items()):
 23096	            if shown >= cap:
 23097	                break
 23098	            take = fs[:cap - shown]
 23099	            shown += len(take)
