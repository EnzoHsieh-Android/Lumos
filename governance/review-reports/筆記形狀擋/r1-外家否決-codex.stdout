 23729	def _delguard_vault_scan(tokens, conf, graph_root_abs, deadline_check=None):
 23730	    """回 [{"node": "Systems/憑證.md", "folder": "Systems", "line_no": int,
 23731	            "line": str(strip,截 160 字), "tokens": [..], "conf": "high"|"low"}...]
 23732	       排序: (conf!=high, folder!="Systems", node, line_no)——高信心先、Systems 先。
 23733	       deadline_check: 選用 callable(),os.walk 外層迴圈每檔呼叫一次;回 True 立即
 23734	       return 目前累積 hits(部分結果,呼叫端已知逾時語意)。"""
 23735	    import re, os
 23736	    if not tokens:
 23737	        return []
 23738	    rx = re.compile(r"\b(?:" + "|".join(map(re.escape, tokens)) + r")\b", re.ASCII)
 23739	    per = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 23740	    hits = []
 23741	    for dirpath, _dirs, files in os.walk(graph_root_abs):
 23742	        for fn in files:
 23743	            if deadline_check is not None and deadline_check():
 23744	                hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 23745	                return hits
 23746	            if not fn.endswith(".md"):
 23747	                continue
 23748	            fp = os.path.join(dirpath, fn)
 23749	            rel = os.path.relpath(fp, graph_root_abs)
 23750	            folder = rel.split(os.sep, 1)[0]
 23751	            try:
 23752	                text = open(fp, encoding="utf-8", errors="replace").read()
 23753	            except OSError:
 23754	                continue
 23755	            for i, line in enumerate(text.splitlines(), 1):
 23756	                # 單巨檔也要能中止:只在 os.walk 外層檢查的話,一份幾十萬行的節點會整份掃完
 23757	                # 才輪到下一次檢查,deadline 直接超支(2026-08-11 code-loop r1 H)
 23758	                if deadline_check is not None and i % 2000 == 0 and deadline_check():
 23759	                    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 23760	                    return hits
 23761	                if not rx.search(line):
 23762	                    continue
 23763	                ts = [t for t, p in per.items() if p.search(line)]
 23764	                hits.append({"node": rel.replace(os.sep, "/"), "folder": folder, "line_no": i,
 23765	                             "line": line.strip()[:160], "tokens": ts,
 23766	                             "conf": "high" if any(conf.get(t) == "high" for t in ts) else "low"})
 23767	    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 23768	    return hits
