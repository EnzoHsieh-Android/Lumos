 22307	def _nodehome_top_dirs(all_paths):
 22308	    """repo 頂層的資料夾名;點開頭的不算(.git、.github 這類不是程式資料夾)。
 22309	    別人的檔的裸路徑判定([S8])與測試資料夾的同名資料夾錨共用這一支。"""
 22310	    return {p.split("/", 1)[0] for p in all_paths if "/" in p and not p.startswith(".")}
 22311	
 22312	
 22313	def _nodehome_layout(all_paths):
 22314	    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
 22315	    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
 22316	    tops = _nodehome_top_dirs(all_paths)
 22317	    top_exts, main_exts = {}, {}
 22318	    for p in all_paths:
 22319	        e = _testmap_ext(p)
 22320	        if not e:
 22321	            continue
 22322	        parts = p.split("/")
 22323	        if len(parts) > 1 and parts[0] in tops:
 22324	            top_exts.setdefault(parts[0], set()).add("." + e)
 22325	        for k in range(len(parts) - 2):
 22326	            if parts[k] == "src" and parts[k + 1] == "main":
 22327	                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
 22328	                break
 22329	    return top_exts, main_exts
 22330	
 22331	
 22332	def _nodehome_in_stack_test_dir(path, layout):
 22333	    """在各棧的測試資料夾裡——兩種都要「旁邊的程式目標有同一種檔」,只看資料夾名會把業務資料夾放掉
 22334	    (2026-09-12 代碼審兩輪各席造出的反例:A/B 測試功能模組 ABTests/、Python 專案的 LoadTests/、
 22335	    scriptsTests/ 裡的 .cs、src/androidTest 裡的 .py):
 22336	    ① 頂層資料夾 = <X> 加對照表的結尾樣式(PosTerminalTests/、PosTerminalUITests/、Foo.IntegrationTests/),
 22337	       副檔名屬於貢獻那個結尾的棧,而且頂層的 <X> 資料夾裡有同一種副檔名的檔(Xcode 的 App 配 AppTests、
 22338	       .NET 的 Foo 配 Foo.Tests);資料夾就叫結尾樣式本身(UITests/、IntegrationTests/)的直接認;
 22339	    ② 緊接在 src 下一層的對照表測試資料夾名(app/src/androidTest/…),副檔名屬於貢獻那個名字的棧(Kotlin),
 22340	       而且同一個模組的 src/main 有同一種副檔名的檔——只看 src/main 有沒有同副檔名的檔,混在 src/main 的建置腳本
 22341	       (.py、.sh)就能讓 androidTest 裡同副檔名的檔免家(代碼審第三輪四席各自造出反例)。
 22342	    別種語言的測試輔助檔(Xcode 測試資料夾裡的橋接標頭 .h、Java 寫的 androidTest 輔助檔——對照表沒有 Java 棧)照舊要家:
 22343	    寧可過嚴,逃生口是 node_home.ignore;要認就把那一棧補進測試棧對照表,這裡自動跟著認。
 22344	    layout=_nodehome_layout 的結果。對不上的照舊要家(過嚴、不漏)。"""
 22345	    sufs, under_src = _nodehome_stack_test_dirs()
 22346	    top_exts, main_exts = layout
 22347	    parts = path.split("/")
 22348	    e = _testmap_ext(path)
 22349	    if len(parts) < 2 or not e:
 22350	        return False
 22351	    ext, top = "." + e, parts[0]
 22352	    for suf, exts in sufs.items():
 22353	        if ext not in exts or not top.endswith(suf):
 22354	            continue
 22355	        base = top[:-len(suf)].rstrip(".")
 22356	        if not base or ext in top_exts.get(base, ()):
 22357	            return True
 22358	    for i in range(1, len(parts) - 1):
 22359	        if parts[i - 1] == "src" and ext in under_src.get(parts[i], ()) and ext in main_exts.get("/".join(parts[:i]), ()):
 22360	            return True
 22361	    return False
