 23421	def _cochange_excluded(path, patterns):
 23422	    """glob 命中判定。雙試補 stdlib fnmatch 的坑:`**/` 的 `/` 被當字面斜線,
 23423	    `**/*-lock.json` 比不到根層 package-lock.json → 去掉 `**/` 前綴再試一次。"""
 23424	    import fnmatch
 23425	    for pat in patterns:
 23426	        if fnmatch.fnmatch(path, pat):
 23427	            return True
 23428	        if pat.startswith("**/") and fnmatch.fnmatch(path, pat[3:]):
 23429	            return True
 23430	    return False
