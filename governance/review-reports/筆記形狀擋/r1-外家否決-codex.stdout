 23190	def _nodehome_ledger(repo_root, vault):
 23191	    """[S28][S29][S39] 健檢三段的母體與判定——跟 home check 共用同一套函式(需要家的檔、家、別人的檔)。
 23192	    讀提交索引那一份(跟磁碟一樣的直接讀磁碟)。三段都分「守衛上線後才出現的」(該被擋卻進來了)與「上線前就在的」舊帳。
 23193	    回 dict,或 None(不是 git 專案/讀不到)。"""
 23194	    root = Path(repo_root)
 23195	    try:
 23196	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 23197	    except ValueError:
 23198	        return None
 23199	    side = _nodehome_side(root, "index", vault_rel)
 23200	    if side is None:
 23201	        return None
 23202	    cfg = _nodehome_config(root, side._reader(".lumos/config.json"), from_snapshot=True)
 23203	    skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root, "")[0]
 23204	    req, bad = _nodehome_required(root, side, cfg, skip)
 23205	    homes, own = _nodehome_homes(root, side)
 23206	    homeless = sorted(f for f in req if not homes.get(f))
 23207	    gl = _nodehome_golive(root, "HEAD")
 23208	    after, G = set(), None
 23209	    if gl:
 23210	        # [S39] 上線後才新增(含改名成新路徑)的檔;改名只看新路徑(第二輪外家席:只收新增會把繞過的改名算成舊帳)
 23211	        for args in (("log", "-M", "--diff-filter=AR", "--name-only", "--format=", "-z", f"{gl}..HEAD"),
 23212	                     ("show", "-M", "--diff-filter=AR", "--name-only", "--format=", "-z", gl)):
 23213	            raw = _nodehome_git(root, *args)
 23214	            if raw:
 23215	                after |= {nfc(x) for x in _nodehome_split_z(raw)}
 23216	        # 上線點那一刻的圖譜(沒變動的節點跟現在共用,只讀有變的)——拿來分「別人的檔」「管太多」兩段的舊帳與繞過
 23217	        ch = _nodehome_git(root, "diff", "--cached", "--name-only", "-z", "--no-renames", gl)
 23218	        G = _nodehome_side(root, gl, vault_rel, share=side,
 23219	                           changed={nfc(x) for x in _nodehome_split_z(ch)} if ch is not None else None)
 23220	    reqG = _nodehome_required(root, G, cfg, skip)[0] if G is not None else set()
 23221	    ownG = _nodehome_homes(root, G)[1] if G is not None else {}
 23222	    foreign, foreign_new, over, over_new = {}, {}, [], []
 23223	    regen_no_home, unmentioned = [], []      # [S11] 蓋了重建章卻不管檔的舊帳;[S15] 管了某支檔卻連檔名都沒提
 23224	    for rel, n in sorted(side.notes.items()):
 23225	        if n["type"] != "system":
 23226	            continue
 23227	        if n["status"] in _NODEHOME_HOME_STATUSES:
 23228	            _mine = sorted(k for k in own.get(rel, set()) if k in side.files)
 23229	            if n["regen"] and not _mine and not _nodehome_resp_ok(n["resp"]):
 23230	                regen_no_home.append(rel)
 23231	            _scan = _home_scan_text(n["text"])
 23232	            for _f in _mine:
 23233	                if not _home_mentions(_scan, _f):
 23234	                    unmentioned.append((rel, _f))
 23235	        f = sorted(_nodehome_refs(n["text"], side, req) - own.get(rel, set()))
 23236	        if f:
 23237	            then = set()
 23238	            if G is not None and rel in G.notes:
 23239	                then = _nodehome_refs(G.notes[rel]["text"], G, reqG) - ownG.get(rel, set())
 23240	            newer = [x for x in f if G is not None and x not in then]
 23241	            if newer:
 23242	                foreign_new[rel] = newer
 23243	            older = [x for x in f if x not in newer]
 23244	            if older:
 23245	                foreign[rel] = older
 23246	        cnt = len({k for k in own.get(rel, set()) if k in side.files})
 23247	        if n["status"] in _NODEHOME_HOME_STATUSES and cnt > cfg["max_files"] and not _nodehome_resp_ok(n["resp"]):
 23248	            g = G.notes.get(rel) if G is not None else None
 23249	            was_over = g is not None and g["status"] in _NODEHOME_HOME_STATUSES and not _nodehome_resp_ok(g["resp"]) \
 23250	                and len({k for k in ownG.get(rel, set()) if k in G.files}) > cfg["max_files"]
 23251	            (over if (G is None or was_over) else over_new).append((rel, cnt))
 23252	    return {"cfg": cfg, "bypassed": [f for f in homeless if f in after], "legacy": [f for f in homeless if f not in after],
 23253	            "foreign": foreign, "foreign_new": foreign_new, "over": over, "over_new": over_new,
 23254	            "regen_no_home": regen_no_home, "unmentioned": unmentioned,
 23255	            "bad_names": sorted(_nodehome_show(x) for x in bad), "golive": gl}
