 19804	def _validate_repo_ref(repo_root, token, line, at_sha=None):
 19805	    """驗一條 repo 內檔案指涉:回 (status, excerpt)。status ∈ missing/line_out_of_range/ok。
 19806	    _refcheck_scan 與 check_regen_provenance(Check J 的 [src:] 驗證)共用——
 19807	    J-c 不得走 _refcheck_scan 抽取入口(inline-code 抽取 + top_dirs 靜默過濾會把假目錄放行,
 19808	    正是 J-c 要擋的幻覺;此 helper 直收已解析 path/line,無靜默過濾)。
 19809	    token 消毒(code-review blocker 修):空/絕對路徑/含 .. 一律 missing——top_dirs 過濾
 19810	    被拆掉時它隱含的安全性(空值/絕對/traversal 天然進不了 top_dirs)必須在此顯式補回,
 19811	    否則 [src: ]/[src:/etc/passwd]/[src:../..] 會 resolve 到 repo 外真實存在的路徑而判 ok。"""
 19812	    token = token.strip()
 19813	    from pathlib import PurePosixPath, PureWindowsPath
 19814	    if (not token
 19815	            or PurePosixPath(token).is_absolute() or PureWindowsPath(token).is_absolute()
 19816	            or ".." in PurePosixPath(token).parts):
 19817	        return "missing", ""
 19818	    # at_sha 給了就對那個 commit 的 git 樹驗,不看工作樹(表態閘 2026-09-09,r3 架構對齊席 A3:同一件事同一個入口,
 19819	    # 別在 code-loop 那邊另造一套);三態語意(missing/line_out_of_range/ok)兩條路一致。
 19820	    if at_sha:
 19821	        if not _git_tree_has(repo_root, at_sha, token):
 19822	            return "missing", ""
 19823	        if not line:
 19824	            return "ok", ""
 19825	        txt = _git_tree_text(repo_root, at_sha, token)
 19826	        file_lines = txt.splitlines() if txt is not None else None
 19827	        if "-" in line:
 19828	            lo, hi = (int(x) for x in line.split("-", 1))
 19829	        else:
 19830	            lo = hi = int(line)
 19831	        if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
 19832	            return "line_out_of_range", ""   # r1 邊界席 f1:10-5 / 5-0 這種範圍以前會 IndexError 或負索引繞回
 19833	        return "ok", (file_lines[lo - 1] if lo == hi else file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1])
 19834	    target = repo_root / token
 19835	    if not target.exists():
 19836	        return "missing", ""
 19837	    if target.is_dir() or not line:
 19838	        return "ok", ""
 19839	    if "-" in line:
 19840	        lo, hi = (int(x) for x in line.split("-", 1))
 19841	    else:
 19842	        lo = hi = int(line)
 19843	    try:
 19844	        file_lines = target.read_text(encoding="utf-8-sig", errors="replace").splitlines()
 19845	    except OSError:
 19846	        file_lines = None
 19847	    if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
 19848	        return "line_out_of_range", ""
 19849	    if lo == hi:
 19850	        return "ok", file_lines[lo - 1]
 19851	    return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]
