 28678	def _codeloop_read(repo_root, branch):
 28679	    """讀 governance/code-loop/<branch>.json;不存在回 None。"""
 28680	    import json
 28681	    safe = _codeloop_branch_filename(branch)
 28682	    p = Path(repo_root) / "governance" / "code-loop" / f"{safe}.json"
 28683	    if not p.exists():
 28684	        return _codeloop_read_from_ledger(repo_root, branch)
 28685	    try:
 28686	        return json.loads(p.read_text(encoding="utf-8"))
 28687	    except Exception:
 28688	        return None
