 23771	def _delguard_purelink(diff_lines):
 23772	    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
 23773	       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
 23774	       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
 23775	       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
 23776	       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
 23777	    import re
 23778	    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
 23779	    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
 23780	    plus = [ln[1:] for ln in diff_lines
 23781	            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
 23782	    minus = [ln[1:] for ln in diff_lines
 23783	             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
 23784	    changed = plus + minus
 23785	    if not changed:
 23786	        return False
 23787	    ms = {c.strip() for c in minus}
 23788	    if any(p.strip() in ms for p in plus):
 23789	        return False
 23790	    return all(item_re.match(c) or key_re.match(c) for c in changed)
 23791	
