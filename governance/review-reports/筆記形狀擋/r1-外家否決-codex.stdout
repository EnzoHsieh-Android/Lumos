 23433	def _cochange_transactions(repo_root, cfg, upto="HEAD", timeout=None):
 23434	    """git 歷史 → transactions(list of set,repo-relative)。挖掘母體挖到 upto 為止
 23435	    (--diff A..B 時 upto=A:規則來自變更之前的歷史,被查 commit 不自我豁免)。
 23436	    回 (txns, err):zero-commit 回 ([], None);git 失敗回 (None, msg)。
 23437	    排除:merge、raw 檔數 > max_changeset(tangled,以排除前的原始檔數計)、exclude pattern。"""
 23438	    import subprocess as sp
 23439	    head = sp.run(["git", "-C", str(repo_root), "rev-parse", upto],
 23440	                  capture_output=True, text=True, errors="replace", timeout=timeout)

