 21095	def _lint_new_config(repo_root):
 21096	    """讀 .lumos/config.json 的 lint_new 區塊(同 _stack_questions_config 慣例,直讀不載 vault)。
 21097	    ★不放 .lumos/lint.json★:那個檔的每個頂層鍵都被當成「副檔名→命令清單」嚴格驗證,
 21098	    多一個設定鍵會讓 lint-check/doctor 對每個採用的專案判紅。
 21099	    回 {gate, budget_sec, per_cmd_floor_sec, max_file_lines, max_file_bytes, warnings}。"""
 21100	    import json
 21101	    cfg = dict(_LINT_NEW_DEFAULTS)
 21102	    cfg["warnings"] = []
 21103	    p = Path(repo_root) / ".lumos" / "config.json"
 21104	    if not p.is_file():
 21105	        return cfg
 21106	    try:
 21107	        data = json.loads(p.read_text(encoding="utf-8"))
 21108	    except Exception as e:
 21109	        cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),新增告警閘用預設值")
 21110	        return cfg
 21111	    sec = data.get("lint_new") if isinstance(data, dict) else None
 21112	    if not isinstance(sec, dict):
 21113	        return cfg
 21114	    g = sec.get("gate", cfg["mode"])
 21115	    if g not in _LINT_NEW_GATE_MODES:
 21116	        cfg["warnings"].append(f"設定檔的 lint_new.gate={g!r} 不合法(只認 {'/'.join(_LINT_NEW_GATE_MODES)}),已用 {cfg['mode']}")
 21117	    else:
 21118	        cfg["mode"] = g
 21119	    for key in ("budget_sec", "per_cmd_floor_sec", "max_file_lines", "max_file_bytes"):
 21120	        v = sec.get(key, cfg[key])
 21121	        if isinstance(v, bool) or not isinstance(v, int) or v < 1:
 21122	            if key in sec:
 21123	                cfg["warnings"].append(f"設定檔的 lint_new.{key}={v!r} 不合法(要正整數),已用 {cfg[key]}")
 21124	        else:
 21125	            cfg[key] = v
 21126	    return cfg
 21127	
