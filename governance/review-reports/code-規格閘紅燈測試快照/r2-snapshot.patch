+def _tg_rb_compare(root, base, head, snaps, test_files, consumed=0, deadline=None):
+    """每支有紅燈版的測試:分岔點已有就不看;推送版找得到(同路徑,或改動清單裡唯一一處同函式鍵)就把歷次紅燈版依序兩兩比、
+    最後一份跟推送版比,命中列 tq/redbase-weakened;找不到、不只一處、有同名多載、那支檔讀不出或配不平列 tq/redbase-unmatched。
+    → (候選, 錯誤或 None)。"""
+    by_path = {p: (fb, fh, kt) for p, _b, _h, fb, fh, kt in test_files}
+    err = _tg_rb_fill(root, base, head, by_path, sorted({p for p, _k in snaps if p not in by_path}), consumed, deadline)
+    if err:
+        return None, err
+    out = []
+    for (p, k), lst in snaps.items():
+        if deadline is not None and _git_timeout(deadline) <= 0:
+            raise TimeoutError("比對工具超過截止時間")
+        if isinstance(by_path[p], str):
+            out.append(_tg_rb_unmatched(lst[-1], p, k, by_path[p]))
+            continue
+        if k in by_path[p][0]:
+            continue                                   # 分岔點就有:照舊拿分岔點當前一版
+        where = _tg_rb_locate(p, k, by_path)
+        if isinstance(where, str):
+            out.append(_tg_rb_unmatched(lst[-1], p, k, where))
+            continue
+        out += _tg_rb_chain(lst, k, *where)
+    return out, None
+
+
+def _tg_rb_fill(root, base, head, by_path, need, consumed=0, deadline=None):
+    """紅燈版記到、但不在這次改動清單裡的測試檔:讀兩端(算進這次推送的總量)、照 _tg_analyze 對測試檔的同一套前置處理
+    (超長行抹掉、括號配不平不切)補進 by_path;那支檔讀不出、太大或配不平時 by_path 放原因字串。git 讀不出回原因,讀得出回 None。"""
+    if not need:
+        return None
+    text = _tg_read(root, base, head, [(p, p) for p in need], deadline, max_total=max(0, _TG_MAX_TOTAL - consumed))
+    if text is None:
+        return "git 讀不出紅燈版記的測試檔(逾時或 git 跑不動)"
+    for p in need:
+        b, h = text.get(("base", p), ""), text.get(("head", p), "")
+        if "TOOLARGE" in (b, h) or "UNREADABLE" in (b, h):
+            by_path[p] = "推送版這支測試檔太大或讀不出,沒比"
+            continue
+        b, h = _tg_blank_long_lines(b), _tg_blank_long_lines(h)
+        fb, okb = _tg_functions(b, p.endswith(".java")) if b else ({}, True)
+        fh, okh = _tg_functions(h, p.endswith(".java")) if h else ({}, True)
+        by_path[p] = (fb, fh, bool(_TG_MSG_LAST_RE.search(h + "\n" + b))) if okb and okh else "推送版這支測試檔括號配不平,沒比"
+    return None
+
+
+def _tg_rb_locate(p, k, by_path):
+    """推送版裡紅燈版那支測試在哪 → (檔案路徑, 函式表, 斷言訊息在後);找不到、不只一處、有同名多載回原因字串。"""
+    fh, kt = by_path[p][1], by_path[p][2]
+    found = [(p, fh, kt)] if k in fh else [(p2, e[1], e[2]) for p2, e in by_path.items()
+                                           if p2 != p and not isinstance(e, str) and k in e[1] and k not in e[0]]
+    if len(found) != 1:
+        return "推送版找不到這支測試(被刪或改名)" if not found else "推送版有不只一處同類別同名的測試"
+    if any(x.startswith(k + "#") for x in found[0][1]):
+        return "推送版有同名多載,不猜是哪一支"
+    return found[0]
+
+
+def _tg_rb_chain(lst, k, tp, tfh, tkt):
+    """歷次紅燈版依序兩兩比、最後一份跟推送版比 → tq/redbase-weakened 候選。推送版沒有斷言不比(分岔點那邊已列 tq/no-assertion)。"""
+    f = tfh[k]
+    if not _tg_has_assertion(f):
+        return []
+    out = []
+    chain = [(s["tok"], s["fn"], s["kt"]) for s in lst] + [(None, f, tkt)]
+    for i in range(len(chain) - 1):
+        tok, prev, _pk = chain[i]
+        _nt, cur, ck = chain[i + 1]
+        label = "推送版" if i == len(chain) - 2 else f"第 {i + 2} 份紅燈版"
+        for c in _tg_fn_cands(tp, k, cur, prev, ck):
+            if c["rule"] in ("tq/no-assertion", "tq/catch-no-fail"):
+                continue                               # 這兩條由分岔點比對列,不重複
+            out.append(_tg_cand("tq/redbase-weakened", tp, f["start"], f"{tok}\x00{c['rule']}\x00{c['ident']}\x00{c['key']}",
+                                extra=f"相對規格閘紅燈版 {tok} → {label}:{c['message']}"))
+    return out
+
+
+def _tg_rb_unmatched(last, path, key, reason):
+    """一條 tq/redbase-unmatched:原因寫最後一份紅燈版的 token、測試名與它綁的條款編號。"""
+    clauses = ",".join(last["clauses"]) or "?"
+    return _tg_cand("tq/redbase-unmatched", path, 0, f"{last['tok']}\x00{key}",
+                    extra=f"規格閘紅燈版 {last['tok']} 記的 {last['name']}(條款 {clauses}):{reason}")
+
