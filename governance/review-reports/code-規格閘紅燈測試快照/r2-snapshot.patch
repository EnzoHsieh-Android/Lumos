+    """紅燈版裡的一列 → (測試檔路徑, 函式鍵, 函式, 斷言訊息在後, 測試名, 條款清單);形狀不對或內嵌文字過不了病態輸入處理回原因字串。
+    內嵌文字跟 _tg_analyze 對終點測試檔一樣:有超長行、括號配不平就不比。測試檔路徑只收 repo 相對的 .kt/.java(不准 ..、反斜線、
+    控制字元、開頭的 /)。cache:{(路徑, 文字): 切函式的結果},同一份檔很多支測試時只切一次(代碼審 r1 正確性席 F4)。"""
+    if not isinstance(t, dict):
+        return "tests 裡有一列不是物件"
+    tpath, key, name, clauses = t.get("path"), t.get("key"), t.get("name"), t.get("clauses")
+    if not all(isinstance(x, str) and x for x in (tpath, key, name)) or not isinstance(clauses, list):
+        return "tests 裡有一列缺測試名、路徑、函式鍵或條款清單"
+    parts = tpath.split("/")
+    if (not tpath.endswith((".kt", ".java")) or tpath.startswith("/") or "\\" in tpath
+            or any(x in ("", ".", "..") for x in parts) or any(ord(ch) < 32 for ch in tpath)):
+        return f"內嵌的測試檔路徑 {_out_clean(tpath, 200)} 不合法(要 repo 相對的 .kt 或 .java)"
+    text = files.get(tpath)
+    if not isinstance(text, str):
+        return f"files 裡沒有 {_out_clean(tpath, 200)} 的內容"
+    cache = {} if cache is None else cache
+    ck = (tpath, text)
+    if ck not in cache:
+        if _tg_has_long_line(text):
+            cache[ck] = f"內嵌的 {_out_clean(tpath, 200)} 有一行超過 {_TG_MAX_LINE_CHARS} 字"
+        else:
+            fs, ok = _tg_functions(text, tpath.endswith(".java"))
+            cache[ck] = (fs, bool(_TG_MSG_LAST_RE.search(text))) if ok else f"內嵌的 {_out_clean(tpath, 200)} 括號配不平"
+    got = cache[ck]
+    if isinstance(got, str):
+        return got
+    fs, kt = got
+    fn = fs.get(key)
+    if fn is None:
+        return f"內嵌的 {_out_clean(tpath, 200)} 裡找不到 {_out_clean(key, 200)}"
+    return tpath, key, fn, kt, name, [str(c) for c in clauses]
+
