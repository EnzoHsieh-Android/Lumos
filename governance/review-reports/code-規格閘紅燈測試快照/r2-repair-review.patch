 def _redbase_row_reason(p, v, detail):
     """一支測試的判定 → 不存的原因;要存回 None;不是 Kotlin/Java 而且不是紅回空字串(不記)。"""
     if not ({".kt", ".java"} & set((p.get("profile") or {}).get("exts") or ())):
         return "不是 Kotlin 或 Java 的測試" if v == "red" else ""
     if v != "red":
         return "判綠" if v == "green" else "弱證據"
     if str(detail or "").startswith("超時"):
         return "逾時的紅不算"
     return None
 
 
