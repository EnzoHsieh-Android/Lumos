+def _redbase_parse_file(rr, path):
+    """一支測試檔 → (相對路徑, 文字, 位元組 sha256, 函式表) 或不存的原因字串。"""
+    import hashlib
+    try:
+        rel = path.resolve().relative_to(Path(rr).resolve()).as_posix()
+    except (OSError, ValueError):
+        return "測試檔不在 repo 根底下"
+    if not rel.endswith((".kt", ".java")):
+        return "不是 .kt 或 .java 檔"
+    ign = _lens_git(rr, "check-ignore", "-q", "--", rel, timeout=30)
+    if ign is None or ign.returncode not in (0, 1):
+        return "git 判不了這支測試檔有沒有被忽略"
+    if ign.returncode == 0:
+        return "測試檔被 git 忽略(紅燈版只存會進版本紀錄的檔)"
+    try:
+        data = path.read_bytes()
+    except OSError:
+        return "讀不到測試檔"
+    try:
+        text = data.decode("utf-8")
+    except UnicodeDecodeError:
+        return "測試檔不是合法 UTF-8"
+    if _tg_has_long_line(text):
+        return f"測試檔有超過 {_TG_MAX_LINE_CHARS // 10000} 萬字的行"
+    fs, ok = _tg_functions(text, rel.endswith(".java"))
+    if not ok:
+        return "測試檔剝完字串與註解後括號配不平"
+    return rel, text, hashlib.sha256(data).hexdigest(), fs
