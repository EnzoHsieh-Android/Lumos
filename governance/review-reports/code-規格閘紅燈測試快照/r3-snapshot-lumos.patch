+    import hashlib
+    import json as _json
+    skipped = list(skipped)
+    greened, prev_body = _redbase_branch_state(rr, loop, branch_rows)
+    tests, files, size = [], {}, 256
+    for c in caps:
+        why = _redbase_cap_reason(c, greened, prev_body)
+        add = 0 if c["path"] in files else len(_json.dumps(c["text"], ensure_ascii=False).encode("utf-8")) + len(c["path"]) + 16
+        add += len(_json.dumps([c["name"], c["key"], c["path"], sorted(c["clauses"])], ensure_ascii=False).encode("utf-8")) + 64
+        if why is None and size + add > _TG_MAX_BYTES:
+            why = f"加進去會讓紅燈版超過 {_TG_MAX_BYTES // 1_000_000} MB(JSON 跳脫後)"
+        if why is not None:
+            skipped.append((c["name"], why))
+            continue
+        size += add
+        files[c["path"]] = c["text"]
+        tests.append({"name": c["name"], "clauses": sorted(c["clauses"], key=lambda x: (len(x), x)), "path": c["path"], "key": c["key"]})
+    if not tests:
+        return None, skipped
+    data = (_json.dumps({"version": _TG_RB_VERSION, "tests": tests, "files": files}, ensure_ascii=False, sort_keys=True) + "\n").encode("utf-8")
+    if len(data) > _TG_MAX_BYTES:
