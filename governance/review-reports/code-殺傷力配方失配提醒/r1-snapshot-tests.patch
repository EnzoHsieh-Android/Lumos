+           {"invariant": "上限恆為5", "file": 5, "old": "x"}, 3, _kr_recipe("prod.py", platform="zz")]
+    (v / "Systems" / "Mix.md").write_text(_kr_note(mix), encoding="utf-8")
+    (v / "Systems" / "BadJ.md").write_text(_kr_note("{not json"), encoding="utf-8")
