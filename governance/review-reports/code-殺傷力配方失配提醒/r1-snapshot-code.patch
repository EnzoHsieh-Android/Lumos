+def _kill_plat_top(ctx, proot):
+    """平台根 → (所在 repo 的最上層, None) 或 (None, 找不到的原因)。guard kill 對平台根下 `git worktree add`,
+    工作樹的根就是那個 repo 的最上層,配方的 file 從那裡算。"""
+    import subprocess
+    key = str(proot)
+    if key in ctx["tops"]:
+        return ctx["tops"][key]
+    res = (None, "不存在")
+    if Path(proot).is_dir():
+        r = subprocess.run(["git", "-C", key, "rev-parse", "--show-toplevel"],
+                           capture_output=True, text=True, errors="replace")
+        top = r.stdout.strip()
+        if r.returncode != 0 or not top:
+            res = (None, "不在 git repo 裡")
+        elif subprocess.run(["git", "-C", top, "rev-parse", "--verify", "-q", "HEAD"],
+                            capture_output=True).returncode != 0:
+            res = (None, "所在 repo 還沒有任何提交")
+        else:
+            res = (Path(top), None)
+    ctx["tops"][key] = res
+    return res
+
