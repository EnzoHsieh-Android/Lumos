+def _kill_read_text(path):
+    """工作目錄裡讀一支檔的全文:回 ("ok", 全文) 或 (狀態, 原因)。不是一般檔不開(具名管線會卡住)。"""
+    import stat as _stat
+    try:
+        st = os.stat(path)
+    except OSError as ex:
+        return "missing", f"工作目錄裡沒有這支檔({ex.strerror or ex})"
+    if not _stat.S_ISREG(st.st_mode):
+        return "missing", "不是一般檔"
+    try:
+        with open(path, encoding="utf-8") as fh:     # 跟 guard kill 同一種讀法:文字模式 UTF-8(換行會正規化)
+            return "ok", fh.read()
+    except UnicodeDecodeError:
+        return "undecodable", "不是 UTF-8"
+    except OSError as ex:
+        return "missing", f"開不了({ex.strerror or ex})"
+
