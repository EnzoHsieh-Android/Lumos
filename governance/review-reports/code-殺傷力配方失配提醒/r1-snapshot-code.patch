+def _kill_recipe_judge(ctx, r):
+    """一條配方判一次。回 dict:status、detail、plat、file(、count)。status:
+    判得出來的 ok(原文恰好一次)/hits(不是一次)/missing(讀不到)/undecodable(讀不成 UTF-8)/outside(跑出 repo);
+    malformed(欄位格式不對);判不了的 cfg(設定檔讀不了)/noplat(平台不在設定裡)/noroot(平台根找不到或不在 git repo)。
+    對應 guard kill:ok=套得上壞法、hits/missing=drifted、outside=error(逃逸)、undecodable=讀檔出錯。"""
+    out = {"status": "malformed", "detail": "配方欄位格式不對", "plat": "", "file": ""}
+    # ★先判是不是物件、欄位型別對不對,再讀任何欄位★(型別壞的配方不能在取平台時先出錯)
+    if not isinstance(r, dict) or not isinstance(r.get("file"), str) or not isinstance(r.get("old"), str) \
+            or any(r.get(k) is not None and not isinstance(r.get(k), str) for k in ("platform", "invariant")):
+        return out
+    out["file"] = r["file"]
+    if ctx["cfg_err"]:
+        out.update(status="cfg", detail=f"設定檔讀不了:{ctx['cfg_err']}")
+        return out
+    pdata = ctx["pdata"]
+    plat = r.get("platform") or pdata["default_platform"]
+    out["plat"] = plat
+    pentry = pdata["platforms"].get(plat)
+    if pentry is None:
+        out.update(status="noplat", detail=f"平台 {plat} 不在設定裡")
+        return out
+    top, why = _kill_plat_top(ctx, pentry["root"])
+    if top is None:
+        out.update(status="noroot", detail=f"平台 {plat} 的根找不到({pentry['root']}:{why})")
+        return out
+    out.update(_kill_judge_file(ctx, top, r["file"], r["old"]))
+    return out
+
