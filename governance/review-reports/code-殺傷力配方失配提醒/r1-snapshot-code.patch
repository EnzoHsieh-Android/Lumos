+def _kill_tree(ctx, top):
+    """repo 頂 → (HEAD 裡每個路徑的模式, HEAD 裡的所有資料夾)。guard kill 的工作樹是從 HEAD 檢出的:
+    還沒提交的新檔、被忽略的檔、子模組裡的檔它都沒有。每個 repo 頂只跑一次 git ls-tree。"""
+    import subprocess
+    key = str(top)
+    if key not in ctx["trees"]:
+        r = subprocess.run(["git", "-C", key, "ls-tree", "-r", "-z", "--full-tree", "HEAD"], capture_output=True)
+        if r.returncode != 0:
+            raise RuntimeError(f"讀不了 HEAD 的檔案清單:{r.stderr.decode('utf-8', 'replace').strip()[:120]}")
+        modes, dirs = {}, set()
+        for rec in r.stdout.split(b"\0"):
+            if not rec:
+                continue
+            meta, _tab, raw = rec.partition(b"\t")
+            rel = os.fsdecode(raw)
+            modes[rel] = meta.split(b" ", 1)[0].decode("ascii", "replace")
+            parts = rel.split("/")
+            for i in range(1, len(parts)):
+                dirs.add("/".join(parts[:i]))
+        ctx["trees"][key] = (modes, dirs)
+    return ctx["trees"][key]
+
+
+_KILL_OUT = object()   # 解析落在暫存資料夾外面(上一層的名字是隨機的,再怎麼走都回不來)
+
+
+def _kill_path_kind(pth, modes, dirs):
+    """模擬工作樹裡某個位置是什麼:"dir"/"file"/"link"/None(不存在)。pth 從暫存資料夾算起,("wt",) 就是 repo 頂。"""
+    if pth[0] != "wt":
+        return None                       # 暫存資料夾裡只有 wt
+    if len(pth) == 1:
+        return "dir"
+    rel = "/".join(pth[1:])
+    mode = modes.get(rel)
+    if mode == "120000":
+        return "link"
+    if mode == "160000":
+        return "dir"                      # 子模組:工作樹裡是空資料夾
+    if mode is not None:
+        return "file"
+    return "dir" if rel in dirs else None
+
+
+def _kill_readlink(top, pth):
+    """連結目標:讀工作目錄的;工作目錄裡不是連結才讀 HEAD 的。"""
+    import subprocess
+    rel = "/".join(pth[1:])
+    try:
+        return os.readlink(str(Path(top) / rel))
+    except OSError:
+        r = subprocess.run(["git", "-C", str(top), "cat-file", "-p", f"HEAD:{rel}"],
+                           capture_output=True, text=True, errors="surrogateescape")
+        return r.stdout
+
+
+def _kill_split(s):
+    return re.split(r"[\\/]", s) if _IS_WIN else s.split("/")
+
+
+def _kill_parent(path):
+    """`..` 照字面退一層:wt 退到暫存資料夾,暫存資料夾再退就落到外面。"""
+    if path is _KILL_OUT:
+        return path
+    return path[:-1] if path else _KILL_OUT
+
+
+def _kill_resolve(top, modes, dirs, file):
+    """重演 guard kill 的 `os.path.realpath(<暫存資料夾>/wt/<file>)`,回 (repo 內路徑, 最後一段的種類);
+    落在 wt 外、或剛好等於 wt 本身(不以「wt 加分隔字元」開頭,guard kill 判逃逸)→ (None, None)。
+
+    模型:wt 就是 repo 頂(內容照 HEAD),它的上一層是只有 wt 這一個子資料夾的暫存資料夾。
+    走法逐行照 posixpath.realpath(非 strict):`.` 與空段略過;`..` 照字面退一層;不存在的段照字面接上
+    (之後的 `..` 可以把它退掉);遇到連結讀目標——絕對目標落在 wt 外,相對目標把各段接回去繼續走;
+    連結迴圈停在連結本身(guard kill 接著開檔會失敗)。"""
+    if os.path.isabs(file):
+        return None, None          # os.path.join 遇到絕對路徑直接用它,不可能落在新建的暫存資料夾裡
+    rest = _kill_split(file)[::-1]
+    count = len(rest)
+    path = ("wt",)
+    seen = {}
+    while count:
+        name = rest.pop()
+        if name is None:              # 一個連結的目標走完了:記下它解析到哪
+            seen[rest.pop()] = path
+            continue
+        count -= 1
+        if name == "..":
+            path = _kill_parent(path)
+            continue
+        if path is _KILL_OUT or name in ("", "."):
+            continue
+        newpath = (*path, name)
+        if _kill_path_kind(newpath, modes, dirs) != "link":
+            path = newpath
+            continue
+        if newpath in seen:           # 走過的連結:有結果用結果,還沒結果就是迴圈(realpath 停在連結本身)
+            path = seen[newpath] if seen[newpath] is not None else newpath
+            continue
+        target = _kill_readlink(top, newpath)
+        if target.startswith("/") or os.path.isabs(target):
+            path = _KILL_OUT
+            continue
+        seen[newpath] = None
+        rest += [newpath, None]
+        tparts = _kill_split(target)[::-1]
+        rest.extend(tparts)
+        count += len(tparts)
+    if path is _KILL_OUT or len(path) < 2 or path[0] != "wt":
+        return None, None
+    return "/".join(path[1:]), _kill_path_kind(path, modes, dirs)
+
