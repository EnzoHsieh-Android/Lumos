+def _kill_judge_file(ctx, top, file, old):
+    """平台的 repo 頂找到之後:解析路徑、確認在提交裡、讀檔、數原文。回要蓋進結果的欄位。"""
+    if file.endswith(("/", "\\") if _IS_WIN else "/"):
+        # realpath 會把結尾斜線吃掉,guard kill 套得上壞法,但接著 `git checkout -- <file>/` 還原失敗、判 error(實跑)
+        return {"status": "missing", "detail": "路徑以斜線結尾(guard kill 套得上壞法、還原會失敗,判 error)"}
+    modes, dirs = _kill_tree(ctx, top)
+    rel, kind = _kill_resolve(top, modes, dirs, file)
+    if rel is None:
