+def _kill_plat_top(ctx, proot):
+    """平台根 → (所在 repo 的最上層, None) 或 (None, 找不到的原因)。guard kill 對平台根下 `git worktree add`,
+    工作樹的根就是那個 repo 的最上層,配方的 file 從那裡算。"""
+    import subprocess
+    key = str(proot)
