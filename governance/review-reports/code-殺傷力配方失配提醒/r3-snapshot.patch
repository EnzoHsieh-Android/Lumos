+def _kill_recipe_judge(ctx, r):
+    """一條配方判一次。回 dict:status、detail、plat、file(、count)。status:
+    判得出來的 ok(原文恰好一次、還原得回去)/hits(不是一次)/missing(讀不到)/undecodable(讀不成 UTF-8)/
+    outside(跑出 repo)/unrestorable(壞法套得上、還原一定失敗);malformed(guard kill 會拒跑或程式出錯);
+    判不了的 cfg(設定檔讀不了)/noplat(平台不在設定裡)/noroot(平台根找不到、不在 git repo 或提交讀不了)。
+    對應 guard kill:ok=套得上壞法、hits/missing=drifted、outside=error(逃逸)、undecodable=讀檔出錯、
+    unrestorable=error(還原失敗,同組後面的配方不跑)、malformed=error(test 名不合法)或程式出錯。
+    ★判的順序照 guard kill 走到哪一步★(代碼審第 2 輪正確性席:先判還原會把「原文對不上」講成「路徑寫錯」):
+    分平台 → test 名白名單 → 路徑與圍欄 → 開檔讀檔 → 數原文 → 套壞法(new)→ 還原。
+    欄位讀法也照它:old、file、test 沒寫當空字串,test 先轉字串再比白名單。"""
+    out = {"status": "malformed", "detail": "", "plat": "", "file": ""}
+    if not isinstance(r, dict):
+        out["detail"] = f"配方欄位格式不對(不是物件,是 {type(r).__name__})"
+        return out
+    file, plat0 = r.get("file", ""), r.get("platform")
+    if not isinstance(file, str) or "\0" in file:
+        out["detail"] = "配方欄位格式不對(file 不是字串或含 NUL 字元,guard kill 會程式出錯)"
+        return out
+    try:
+        hash(plat0)
+    except TypeError:
+        out["detail"] = "配方欄位格式不對(platform 是清單或物件,guard kill 會程式出錯)"
+        return out
+    out["file"] = file
+    if ctx["cfg_err"]:
+        out.update(status="cfg", detail=f"設定檔讀不了:{ctx['cfg_err']}")
+        return out
+    pdata = ctx["pdata"]
+    plat = plat0 or pdata["default_platform"]
+    out["plat"] = plat
+    pentry = pdata["platforms"].get(plat)
+    if pentry is None:
+        out.update(status="noplat", detail=f"平台 {_kill_show(plat)} 不在設定裡")
+        return out
+    if not _KILL_METHOD_OK_RE.fullmatch(_kill_method_name(r.get("test", ""), pdata.get("multiplatform")) or ""):
+        out["detail"] = f"配方欄位格式不對(test 名 {_kill_show(r.get('test', ''))} 不合法,guard kill 會拒跑)"
+        return out
+    top, why = _kill_plat_top(ctx, pentry["root"])
+    if top is None:
+        out.update(status="noroot", detail=f"平台 {_kill_show(plat)} 的根找不到({_kill_show(pentry['root'])}:{why})")
+        return out
+    modes, dirs = _kill_tree(ctx, top)
+    if modes is None:
+        out.update(status="noroot", detail=f"平台 {_kill_show(plat)} 的提交讀不了({_kill_show(top)}:{_kill_esc(dirs)})")
+        return out
+    out.update(_kill_judge_file(ctx, top, modes, dirs, r))
+    return out
+
+
+def _kill_judge_file(ctx, top, modes, dirs, r):
+    """平台的 repo 頂找到之後,照 guard kill 的順序:解析路徑與圍欄、開檔讀檔、數原文、new 能不能套、還原得不得回去。
+    回要蓋進結果的欄位。"""
+    file = r.get("file", "")
+    rel, kind = _kill_resolve(ctx, top, modes, dirs, file)
+    if rel is None:
+        return {"status": "outside", "detail": "解析後跑出 repo"}
+    if kind != "file":
+        why = {"link": "連結迴圈", "dir": "是資料夾,不是一般檔"}.get(kind)
+        if why is None:
+            why = "不在提交裡(guard kill 的工作樹沒有它)" if os.path.lexists(str(top / rel)) else "不存在"
+        return {"status": "missing", "detail": why}
+    key = (str(top), rel)
+    if key not in ctx["texts"]:          # ★同一支檔只讀一次★
+        ctx["texts"][key] = _kill_read_text(str(top / rel))
+    st, val = ctx["texts"][key]
+    if st != "ok":
+        return {"status": st, "detail": val}
+    old = r.get("old", "")
+    if not isinstance(old, str):
+        return {"status": "malformed", "detail": "配方欄位格式不對(old 不是字串,guard kill 數原文時會程式出錯)"}
+    n = val.count(old)
+    if n != 1:
+        return {"status": "hits", "detail": f"原文出現 {n} 次", "count": n}
+    if not isinstance(r.get("new"), str):
+        return {"status": "malformed", "detail": "配方欄位格式不對(new 沒寫或不是字串,guard kill 套壞法時會程式出錯)"}
+    if _kill_restorable(ctx, top, file) is False:
+        # 套得上壞法,但 guard kill 接著 `git checkout -- <file>` 還原失敗、判 error,同組後面的配方都不跑(實跑)
+        return {"status": "unrestorable",
+                "detail": f"這樣寫路徑還原會失敗(git 對不到提交裡的檔:結尾斜線、`..` 爬出、經過資料夾連結、大小寫不同…),"
+                          f"改寫成 {_kill_show(rel)}"}
+    return {"status": "ok", "detail": ""}
+
