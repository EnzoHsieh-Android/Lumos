+def _kill_tree(ctx, top):
+    """repo 頂 → (HEAD 裡每個路徑的模式, HEAD 裡的所有資料夾)。guard kill 的工作樹是從 HEAD 檢出的:
+    還沒提交的新檔、被忽略的檔、子模組裡的檔它都沒有。每個 repo 頂只跑一次 git ls-tree;
+    ★讀不了也記住★(同一個 repo 的每條配方不必各重跑一次、各印一行,代碼審第 1 輪併發席),回 (None, 原因)。"""
+    import subprocess
+    key = str(top)
+    if key not in ctx["trees"]:
+        try:
+            r = subprocess.run(["git", "-C", key, "ls-tree", "-r", "-z", "--full-tree", "HEAD"],
+                               capture_output=True, timeout=_KILL_GIT_TIMEOUT)
+            why = "" if r.returncode == 0 else r.stderr.decode("utf-8", "replace").strip()[:120]
+        except (OSError, subprocess.SubprocessError) as ex:
+            why = f"{ex.__class__.__name__}: {ex}"[:120]
+        if why:
+            ctx["trees"][key] = (None, why)
+            return ctx["trees"][key]
+        modes, dirs = {}, set()
+        for rec in r.stdout.split(b"\0"):
+            if not rec:
+                continue
+            meta, _tab, raw = rec.partition(b"\t")
+            rel = os.fsdecode(raw)
+            modes[rel] = meta.split(b" ", 1)[0].decode("ascii", "replace")
+            parts = rel.split("/")
+            for i in range(1, len(parts)):
+                dirs.add("/".join(parts[:i]))
+        ctx["trees"][key] = (modes, dirs)
+    return ctx["trees"][key]
