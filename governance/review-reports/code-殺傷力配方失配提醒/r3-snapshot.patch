+def _krc_match(label, status, r):
+    """S5 對應表:判斷函式的狀態 ↔ 真跑 guard kill(--json)的結果。回 (對不對得上, verdict, detail)。"""
+    import json as _json
+    data = None
+    for ln in reversed(r.stdout.splitlines()):
+        if ln.strip().startswith("{"):
+            try:
+                data = _json.loads(ln)
+            except ValueError:
+                pass
+            break
+    res = (data or {}).get("results") or [{}]
+    verdict, detail = res[0].get("verdict"), res[0].get("detail", "") or ""
+    reverted_fail = verdict == "error" and "revert 失敗" in detail
+    want = {"ok": verdict in ("killed", "killed_unattributed", "survived", "timed_out_weak"),
+            "hits": verdict == "drifted", "missing": verdict == "drifted",
+            "outside": verdict == "error" and "逃逸" in detail,
+            "unrestorable": reverted_fail,
+            "malformed": (verdict == "error" and "test 名不合法" in detail)
+            or (data is None and r.returncode == 1 and any(e in r.stderr for e in ("KeyError", "TypeError", "ValueError"))),
+            "undecodable": data is None and r.returncode == 1 and "UnicodeDecodeError" in r.stderr}
+    return want.get(status, False), verdict, detail
+
