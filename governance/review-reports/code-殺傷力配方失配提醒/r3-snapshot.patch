+        idx = os.path.join(d, "index")
+        try:
+            r = subprocess.run(["git", "-C", key, "read-tree", "HEAD"], capture_output=True,
+                               env={**os.environ, "GIT_INDEX_FILE": idx}, timeout=_KILL_GIT_TIMEOUT)
+            ctx["idx"][key] = idx if r.returncode == 0 else None
+        except (OSError, subprocess.SubprocessError):
+            ctx["idx"][key] = None
+    idx = ctx["idx"][key]
+    if idx is None:
+        return None
+    try:
+        r = subprocess.run(["git", "-C", key, "ls-files", "--error-unmatch", "--", file], capture_output=True,
+                           env={**os.environ, "GIT_INDEX_FILE": idx}, timeout=_KILL_GIT_TIMEOUT)
+    except (OSError, subprocess.SubprocessError):
