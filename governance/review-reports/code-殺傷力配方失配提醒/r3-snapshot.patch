+def _kill_fix_hint(rel, elem):
+    """可以直接貼的修法(kill-add 提醒與 P2 共用)。"""
+    return f"lumos guard kill-rm {_kill_node_arg(rel)} --id {_kill_recipe_id(str(rel), elem)[:12]}"
