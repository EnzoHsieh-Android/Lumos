+    res = (None, "不存在")
+    if Path(proot).is_dir():
+        try:
+            r = subprocess.run(["git", "-C", key, "rev-parse", "--show-toplevel"],
+                               capture_output=True, text=True, errors="replace", timeout=_KILL_GIT_TIMEOUT)
+            top = r.stdout.strip()
+            if r.returncode != 0 or not top:
+                res = (None, "不在 git repo 裡")
+            elif subprocess.run(["git", "-C", top, "rev-parse", "--verify", "-q", "HEAD"],
+                                capture_output=True, timeout=_KILL_GIT_TIMEOUT).returncode != 0:
+                res = (None, "所在 repo 還沒有任何提交")
+            else:
+                res = (Path(top), None)
+        except (OSError, subprocess.SubprocessError) as ex:
+            res = (None, f"git 問不出來({ex.__class__.__name__})")
+    ctx["tops"][key] = res
