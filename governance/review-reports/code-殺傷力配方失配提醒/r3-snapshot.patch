+        f = _kill_show(f)
+        if st == "hits":
+            msg = f"這條配方的原文在 {f} 出現 {res['count']} 次;guard kill 跑到它會判 drifted。{fix}"
+        elif st == "missing":
+            msg = f"{f} 讀不到({res['detail']});guard kill 跑到它會判 drifted。{fix}"
+        elif st == "undecodable":
+            msg = f"{f} 讀不到({res['detail']});guard kill 跑到它會讀檔出錯。{fix}"
+        elif st == "outside":
+            msg = f"{f} 解析後跑出 repo;guard kill 會擋在圍欄外(判 error)。{fix}"
+        elif st == "unrestorable":
+            msg = f"{f} 壞法套得上,但{res['detail']};guard kill 會判 error、同組後面的配方不跑。{fix}"
+        elif st == "malformed":
