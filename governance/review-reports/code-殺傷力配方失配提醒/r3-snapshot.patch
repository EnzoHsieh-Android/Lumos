+def _kill_alias(ctx, pth, name, modes, dirs):
+    """字面不在提交裡的一段路徑名 → 暫存資料夾的檔案系統會把它當成提交裡的哪個名字(沒有、或對到不只一個回 None)。
+    guard kill 在工作樹裡 realpath 不改字面、開檔照樣開得到(代碼審第 1 輪正確性席:拆開寫法的檔名被誤判不在提交裡)。"""
+    ci, ni = _kill_fs_fold(ctx)
+    if not (ci or ni):
+        return None
+
+    def fold(x):
+        x = nfc(x) if ni else x
+        return x.casefold() if ci else x
+    want = fold(name)
+    pre = "/".join(pth[1:])
+    pre = pre + "/" if pre else ""
+    hits = {c[len(pre):] for c in (*modes, *dirs)
+            if c.startswith(pre) and "/" not in c[len(pre):] and fold(c[len(pre):]) == want}
+    return hits.pop() if len(hits) == 1 else None
