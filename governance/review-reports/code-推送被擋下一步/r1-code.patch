+def t_push_summary_last_line_is_next_step():
+    """彙總的最後一行是第一筆擋下的重查指令:代理被擋後讀到的最後一句要是做得到的動作,不是散文或繞過指令。
+    ①每道閘的指令都交給真的 lumos 解析一次(參數寫錯或指令改名這裡就紅,比對字面抓不到);
+    ②要範圍的閘沒拿到範圍、或範圍不像範圍、或閘名不認得 → 不印「下一步」,不印跑不動的指令;
+    ③不要範圍的閘不靠範圍。翻紅釘:拿掉最後那行 → ①紅;某閘的指令打錯旗標 → ①紅;不驗範圍形狀 → ②紅。"""
+    print("t_push_summary_last_line_is_next_step")
+    import shlex
+    import shutil
+    import subprocess as sp
+    lm = _load_lumos_module()
+    d = Path(tempfile.mkdtemp(prefix="gctl-psnext-"))
+    try:
+        bf = d / "blocks"
+
+        def run(gate, *extra):
+            bf.write_text(f"{gate}\trefs/heads/x\t原因\n", encoding="utf-8")
+            r = sp.run([sys.executable, GRAPHCTL, "push-summary", "--blocks-file", str(bf), "--count", "1", "--refs", "1",
+                        "--repo", str(d), *extra], capture_output=True, text=True)
+            return r.returncode, _ppc_last_line(r.stderr)
+        rng = "a" * 40 + ".." + "b" * 40
+        gates = ("anchor", "anchor-baseline", "doctor", "home", "note-shape", "spec-gate", "code-loop", "drift", "room-guard", "reread")
+        check("①十道閘都有下一步(閘名對照掛鉤記的那一份)", sorted(lm._PUSH_SUMMARY_NEXT) == sorted(gates), sorted(lm._PUSH_SUMMARY_NEXT))
+        for g in gates:
+            rc, last = run(g, "--first-range", rng)
+            check(f"①{g}:最後一行是下一步,不含繞過指令", rc == 0 and last.startswith("下一步:") and "--no-verify" not in last, last)
+            cmd = last.split(":", 1)[-1]
+            if cmd.startswith("lumos "):
+                argv = shlex.split(cmd)[1:]
+                # 不帶 --help:help 一讀到就結束,後面的旗標寫錯不會被抓到。指令本身在暫存夾裡可能回非零,這裡只看參數解析(訊息是 lumos 自己的中文版)
+                p = sp.run([sys.executable, GRAPHCTL, *argv], capture_output=True, text=True, cwd=str(d))
+                check(f"①{g}:真的 lumos 認得這行指令", not any(x in p.stderr for x in ("這個指令", "不認得這幾個參數", "少了必須要給的", "這個值")),
+                      p.stderr[-300:])
+            else:
+                check(f"①{g}:不是 lumos 就是簽名檔那條 git 提交", g == "anchor-baseline" and cmd.startswith("git add "), cmd)
+            if lm._PUSH_SUMMARY_NEXT[g].count("{range}"):
+                check(f"①{g}:指令帶上掛鉤給的範圍", rng in cmd, cmd)
+        for label, gate, extra in (("要範圍卻沒給", "home", ()), ("範圍空字串", "drift", ("--first-range", "")),
+                                   ("範圍不像範圍", "home", ("--first-range", "x; rm -rf y")), ("不認得的閘", "new-gate", ("--first-range", rng))):
+            rc, last = run(gate, *extra)
+            check(f"②{label} → 回 0、不印下一步", rc == 0 and "下一步" not in last and "每一道怎麼處理" in last, last)
+        rc, last = run("doctor")
+        check("③不要範圍的閘沒給範圍也印", rc == 0 and last == "下一步:" + lm._PUSH_SUMMARY_NEXT["doctor"], last)
+    finally:
+        shutil.rmtree(d, ignore_errors=True)
