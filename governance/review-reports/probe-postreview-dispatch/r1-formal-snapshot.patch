+        check("原子取代仍保留既有普通摘要權限", done.returncode == 0
+              and all(stat.S_IMODE((outdir / name).stat().st_mode) == 0o640
+                      for name in ("meta.json", "summary.json", "summary.md")),
+              {name: oct(stat.S_IMODE((outdir / name).stat().st_mode))
+               for name in ("meta.json", "summary.json", "summary.md")})
