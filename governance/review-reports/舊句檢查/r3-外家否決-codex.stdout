   282	def _shape_ok(name):
   283	    """r1 設計的形狀過濾:4 字以上、含底線或大小寫混合(旗標與路徑另計)。"""
   284	    if name.startswith("--") or "/" in name or name.endswith(".py"):
   285	        return True
   286	    return len(name) >= 4 and ("_" in name or (any(c.isupper() for c in name) and any(c.islower() for c in name)))
