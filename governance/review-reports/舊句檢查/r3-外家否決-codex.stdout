 26243	# ═══════════════════════════════════════════════════════════════════════════════════
 26244	_DRIFT_CLOSED = ("done", "superseded")
 26245	_DRIFT_OPEN_ISSUE = ("open", "doing")
 26246	# c4 的關鍵詞。★清單裡刻意不放「工作樹」★:「釘在某提交的乾淨工作樹」是合法的可重現寫法,本來就不含這三個詞;
 26247	# 同一句裡同時有「未提交」與「工作樹」照樣成立(考卷 E3 就是這樣寫,設計審 r3 接手席)
 26248	_DRIFT_UNCOMMITTED_WORDS = ("未提交", "還沒提交", "uncommitted")
