 27367	def _drift_jsonl_parse(raw):
 27368	    """帳檔的位元組 → [dict](不是 JSON 物件的行略過)。表態檔與修復帳共用。
 27369	    ★只在 \\n 切行★:str.splitlines() 還會在 U+2028、U+0085、換頁字元切開,而寫入端 json.dumps(ensure_ascii=False)
 27370	    不跳脫這些字元——工具自己寫進去的一筆會被劈成兩段壞行、讀不回來,乾淨檢查與序號都跟著錯(代碼審 r1 邊界、併發席)。"""
 27371	    import json as _j
 27372	    out = []
 27373	    for ln in (raw or b"").decode("utf-8", errors="replace").split("\n"):
 27374	        if not ln.strip():
 27375	            continue
 27376	        try:
 27377	            d = _j.loads(ln)
 27378	        except (ValueError, RecursionError):
 27379	            continue
 27380	        if isinstance(d, dict):
 27381	            out.append(d)
 27382	    return out
