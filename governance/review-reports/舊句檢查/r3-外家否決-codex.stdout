 26514	def _drift_vault_rel(root, where):
 26515	    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
 26516	    lst = _drift_list(root, where)
 26517	    if lst is None:
 26518	        return None
 26519	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 26520	    if not vaults:
 26521	        return None
 26522	    wv = _vault_in(Path(root))
 26523	    try:
 26524	        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
 26525	    except ValueError:
 26526	        wv_rel = None
 26527	    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
