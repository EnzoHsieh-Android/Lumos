   289	def _is_banner(line):
   290	    s = line.strip()
   291	    if not s or s[0] not in ">(（":
   292	        return False
   293	    if NOT_YET.search(s):
   294	        return False
   295	    return any(w in s for w in RETIRE_WORDS)
