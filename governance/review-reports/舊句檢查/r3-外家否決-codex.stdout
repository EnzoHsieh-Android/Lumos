   391	class Vault:
   392	    def __init__(self, repo):
   393	        self.repo = repo
   394	        self._notes = {}
   395	
   396	    def notes(self, commit):
   397	        t = self.repo.tree(commit)
   398	        pre = self.repo.vault + "/"
   399	        out = {}
   400	        for p, sha in t.items():
   401	            if p.startswith(pre) and p.endswith(".md"):
   402	                if sha not in self._notes:
   403	                    self._notes[sha] = Note(p[len(pre):], self.repo.blob(sha))
   404	                n = self._notes[sha]
   405	                if n.path != p[len(pre):]:
   406	                    n = Note(p[len(pre):], self.repo.blob(sha))
   407	                out[p[len(pre):]] = n
   408	        return out
