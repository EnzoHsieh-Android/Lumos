 28196	def _drift_config(text):
 28197	    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
 28198	    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
 28199	    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
 28200	    import json as _j
 28201	    if text is None:
 28202	        return _DRIFT_DEFAULT_GATE, [], False
 28203	    try:
 28204	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 28205	    except (ValueError, UnicodeDecodeError):
 28206	        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
 28207	        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
 28208	    if not isinstance(cfg, dict) or "drift_check" not in cfg:
 28209	        return _DRIFT_DEFAULT_GATE, [], False
 28210	    dc = cfg["drift_check"]
 28211	    if not isinstance(dc, dict):
 28212	        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
 28213	                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
 28214	    g = dc.get("gate")
 28215	    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
 28216	        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
 28217	    if g not in _DRIFT_GATE_VALUES:
 28218	        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
 28219	    return g, [], True
