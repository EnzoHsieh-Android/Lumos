 26816	def _drift_py_def_re(name, test):
 26817	    """解析不了的 Python 檔退回逐行正則(寧可多認一次,也不讓一支語法壞掉的檔讓整批條件判不了)。"""
 26818	    n = re.escape(name)
 26819	    if test:
 26820	        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
 26821	    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)
