 23981	def _nodehome_cat_blobs(repo_root, specs, timeout=60):
 23982	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 23983	
 23984	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 23985	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 23986	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 23987	    import subprocess as _sp
 23988	    if not specs:
 23989	        return []
 23990	    if any("\n" in s_ for s_ in specs):
 23991	        return None
 23992	    try:
 23993	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 23994	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 23995	                    capture_output=True, timeout=timeout)
 23996	    except (OSError, _sp.TimeoutExpired):
 23997	        return None
 23998	    if r.returncode != 0:
 23999	        return None
 24000	    out, pos, res = r.stdout, 0, []
 24001	    for _ in specs:
 24002	        nl = out.find(b"\n", pos)
 24003	        if nl < 0:
 24004	            return None
 24005	        head = out[pos:nl].split(b" ")
 24006	        pos = nl + 1
 24007	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 24008	            size = int(head[2])
 24009	            res.append(out[pos:pos + size])
 24010	            pos += size + 1
 24011	        elif len(head) == 3 and head[2].isdigit():
 24012	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 24013	            res.append(None)
 24014	        else:
 24015	            res.append(None)            # missing / ambiguous
 24016	    return res
