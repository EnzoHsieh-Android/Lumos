 27619	_DRIFT_PLACEHOLDER_RE = re.compile(r"<(?:為什麼[^<>\n]{0,30}|sha|卷證)>")
 27620	
 27621	
 27622	def _drift_placeholder_err(text, what):
 27623	    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
 27624	    Issue 標成結案、理由是佔位字)。只認 _drift_fix_hint 與 c4 證據頁真的印過、而且會被貼進 --reason/--new 的那幾種
 27625	    (為什麼…、sha、卷證);`Map<K,V>`、`<src/lib>` 這種真理由照收(代碼審 r2 正確性席、r3 邊界席)。"""
 27626	    m = _DRIFT_PLACEHOLDER_RE.search(text or "")
 27627	    return f"{what} 裡還留著提示的佔位字「{m.group(0)}」——換成真的內容再跑" if m else None
