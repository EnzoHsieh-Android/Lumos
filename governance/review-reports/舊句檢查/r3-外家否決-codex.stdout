 28222	def _drift_print_findings(rows, stream, acks=None, alive=None):
 28223	    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
 28224	    for f in rows[:20]:
 28225	        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
 28226	              file=stream)
 28227	        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
 28228	        prev = _drift_prev_ack_line(f)
 28229	        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
 28230	        if prev:
 28231	            print(f"      ({_esc_clean(prev, 400)})", file=stream)
 28232	        elif old:
 28233	            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
 28234	    if len(rows) > 20:
 28235	        print(f"  …還有 {len(rows) - 20} 筆", file=stream)
