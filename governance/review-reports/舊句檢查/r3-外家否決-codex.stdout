 28238	def cmd_drift_check(repo=None, diff_range=None):
 28239	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 28240	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
 28241	    import time as _t
 28242	    root = _note_audit_root(repo)
 28243	    if root is None:
 28244	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 28245	        return 0
 28246	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 28247	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 28248	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 28249	        return 0
 28250	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 28251	                                               mark=_DRIFT_GOLIVE_MARK)
 28252	    if tip is None or isinstance(tip, int):
 28253	        return tip if isinstance(tip, int) else 0
 28254	    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 28255	    for w in warns:
 28256	        print(f"提醒:{w}", file=sys.stderr)
 28257	    if mode == "off":
 28258	        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 28259	        return 0
 28260	    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 28261	                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 28262	    acks = _drift_load_acks(root, tip)
 28263	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 28264	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 28265	    lst = _nodehome_list(root, tip)
 28266	    alive = set(lst[1]) if lst else None
 28267	    if listed:
 28268	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 28269	        _drift_print_findings(listed, sys.stderr, acks, alive)
 28270	        _drift_print_hints(listed, sys.stderr)
 28271	    if not must and not unknown:
 28272	        return 0
 28273	    return _drift_report_must(root, mode, must, unknown, acks, alive)
