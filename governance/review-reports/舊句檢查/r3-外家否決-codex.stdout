 33164	def _contract_key_matches(text, with_kind=False):
 33165	    """★全檔唯一的「合約行」掃描★:逐行只認 KEY: 行(INVARIANT_RE/CHECKPOINT_RE/IRREVERSIBLE_RE),回 [(整行, match)];不掃正文。
 33166	    派工鏡頭(_lens_contract_lines/_lens_contract_rows)與規格閘的相依回歸(_contract_texts)都走這裡(代碼審 r1/r2 架構席:別再各寫一份);with_kind=True 多回哪一種合約。"""
 33167	    out = []
 33168	    for line in text.split("\n"):
 33169	        s = line.strip()
 33170	        for kind, rx in (("INVARIANT", INVARIANT_RE), ("CHECKPOINT", CHECKPOINT_RE), ("IRREVERSIBLE", IRREVERSIBLE_RE)):
 33450	        return "?"
 33451	    s = str(raw).replace("\r", " ").replace("\n", " ").replace("─", "-")
 33452	    s = "".join(ch for ch in s if ch == "\t" or ord(ch) >= 32)
 33453	    s = s.strip()
 33454	    return (s[:cap] + "…") if len(s) > cap else (s or "?")
