 33142	def _lens_cache_write(path, data):
 33143	    """★寫入端也要驗目錄★(2026-09-06 全 repo 審視 #6):原本直接 mkdir + chmod(0700),
 33144	    目錄若被換成指向別處的 symlink,就會把**別人的目錄**權限改掉。讀取端一直都有檢查,
 33145	    寫入端沒有——現在兩邊都走同一支 _trusted_private_dir。不過關就靜默不寫(fail-open)。"""
 33146	    import json as _json, tempfile as _tf
 33147	    try:
 33148	        # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
 33149	        # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
 33150	        if not _mkdir_trusted_under_home(".cache", "lumos", "dispatch-lens"):
 33151	            return
 33152	        if not _trusted_private_dir(path.parent, ".cache", "lumos", "dispatch-lens"):
 33153	            return
 33154	        os.chmod(path.parent, 0o700)
 33155	        fd, tmp = _tf.mkstemp(dir=str(path.parent), suffix=".tmp")
 33156	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
 33157	            fh.write(_json.dumps(data, ensure_ascii=False))
 33158	        os.chmod(tmp, 0o600)
 33159	        os.replace(tmp, path)
 33160	    except OSError:
 33161	        pass
