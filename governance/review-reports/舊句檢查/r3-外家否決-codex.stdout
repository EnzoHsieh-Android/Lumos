 15825	def _ledger_append(path, obj):
 15826	    """[M3 並行合約] O_APPEND fd + 單次 os.write() 整行 bytes(≤4KB 寫前拒,不截斷)。
 15827	    POSIX regular file 實務原子;Windows/跨平台 best-effort、預期單寫者(誠實降級,r1 D10)。
 15828	    無 O_CREAT——confirm/prune 永不建檔(建檔只屬觸發端 rel_cascade_create,r2 R4)。
 15829	    [code-loop r1] O_NOFOLLOW 拒 symlink 終點(字元白名單擋不住,CX1);os.write 回傳驗滿寫
 15830	    (ENOSPC 短寫會留中段殘行且 rc=0 假成功,B1)——短寫即 RuntimeError,呼叫端 rc=2。"""
 15831	    import json
 15832	    data = (json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8")
 15833	    if len(data) > 4096:
 15834	        raise ValueError(f"這筆事件有 {len(data)} 位元組,超過 4KB 上限,不寫(不截斷,免得寫一半)")
 15835	    fd = os.open(str(path), os.O_WRONLY | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0))
 15836	    try:
 15837	        written = os.write(fd, data)
 15838	        if written != len(data):
 15839	            raise RuntimeError(f"帳本短寫:只寫進 {written}/{len(data)} 位元組,可能磁碟滿了——這筆沒完整寫入,重試前先查空間")
 15840	    finally:
 15841	        os.close(fd)
