 26530	def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
 26531	    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
 26532	    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
 26533	    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
 26534	    import time as _t
 26535	    pre = vault_rel.rstrip("/") + "/"
 26536	    if deadline is not None and _t.monotonic() > deadline:
 26537	        return None
 26538	    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _drift_empty_tree(root), tip, "--", vault_rel)
 26539	    if raw is None:
 26540	        return None
 26541	    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
 26542	               if x.strip("\n").startswith(pre)}
 26543	    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
 26544	              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
 26545	    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
 26546	              and _drift_str(n, "status") in _DRIFT_CLOSED}
 26547	    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 26548	                                   lambda ty, st: ty == "verification" and st == "pass",
 26549	                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
 26550	    if passed is None:
 26551	        return None
 26552	    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 26553	                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
 26554	                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
 26555	    if closed is None:
 26556	        return None
 26557	    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
 26558	            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}
