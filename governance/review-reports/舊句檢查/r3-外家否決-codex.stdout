   441	class Push:
   442	    """一個推送範圍(base..tip)的共用材料,各候選懶載入。"""
   443	
   444	    def __init__(self, ctx, base, tip):
   445	        self.ctx, self.base, self.tip = ctx, base, tip
   446	        self.repo = ctx.repo
   447	        self._m = {}
   448	
   449	    def memo(self, k, fn):
   450	        if k not in self._m:
   451	            self._m[k] = fn()
   452	        return self._m[k]
   453	
   454	    # 改到的檔
   455	    def changes(self, renames):
   456	        def f():
   457	            args = ["diff", "--name-status", "-z", "--no-ext-diff"] + (["-M"] if renames else ["--no-renames"]) + [self.base, self.tip]
   458	            out = self.repo.git(*args, binary=True).decode("utf-8", "replace").split("\0")
   459	            res, i = [], 0
   460	            while i < len(out) and out[i]:
   461	                st = out[i]
   462	                if st[0] in "RC":
   463	                    res.append((st[0], out[i + 1], out[i + 2]))
   464	                    i += 3
   465	                else:
   466	                    res.append((st[0], out[i + 1], out[i + 1]))
   467	                    i += 2
   468	            return res
   469	        return self.memo(("chg", renames), f)
   470	
   471	    def code_changes(self, renames):
   472	        """[(status, 起點路徑, 終點路徑, kind)] 只收程式檔。"""
   473	        def f():
   474	            bt, tt = self.repo.tree(self.base), self.repo.tree(self.tip)
   475	            res = []
   476	            for st, a, b in self.changes(renames):
   477	                sha = tt.get(b) or bt.get(a)
   478	                path = b if b in tt else a
   479	                k = self.ctx.code.kind(path, sha) if sha else None
   480	                if k:
   481	                    res.append((st, a, b, k))
   482	            return res
   483	        return self.memo(("cchg", renames), f)
   484	
   485	    def tip_notes(self):
   486	        return self.memo("tipn", lambda: self.ctx.vault.notes(self.tip))
   487	
   488	    def base_notes(self):
   489	        return self.memo("basen", lambda: self.ctx.vault.notes(self.base))
   490	
   491	    def new_lines(self):
   492	        """這次範圍裡新寫或改過的筆記行 {筆記相對路徑: set(終點行號)}(-M 認改名)。"""
   493	        def f():
   494	            raw = self.repo.git("diff", "--no-ext-diff", "-U0", "-M", "--no-color", self.base, self.tip,
   495	                                "--", self.repo.vault, binary=True)
   496	            added = LM._notelines_parse_added(raw)
   497	            pre = self.repo.vault + "/"
   498	            return {p[len(pre):]: {n for n, _ in v} for p, v in added.items() if p.startswith(pre)}
   499	        return self.memo("newl", f)
