 33475	def _trusted_private_dir(d, *rel_segments):
 33476	    """★私有目錄信任檢查(單一來源)★——這套工具在家目錄底下寫的暫存/標記目錄都走這支。
 33477	
 33478	    檢查四件事,少一件都不算過:
 33479	      ① 它自己不是 symlink;
 33480	      ② **整條路徑都沒有經過 symlink**——拿「解析過的預期路徑」對照,所以父層(例如 ~/.cache
 33481	         或 ~/.cache/lumos)被換成指向別處的 symlink 也擋得下來;家目錄本身可以是 symlink
 33482	         (macOS 的 /var → /private/var 就是),所以預期路徑也先解析再比;
 33483	      ③ 是目錄、而且 owner 是自己;
 33484	      ④ group / other 不可寫。
 33485	
 33486	    ★出身(2026-09-06 全 repo 審視 #6)★:收工擋停那道檢查在 r2/r3 各補過一刀(拒 symlink、
 33487	    解析後路徑必須相等),但派工鏡頭那道**沒跟上**。實測同一個「指向別處的 symlink」:
 33488	    收工擋停那道拒絕、鏡頭那道照信——而鏡頭那邊真的會對那個目錄做 rmtree 與 chmod。
 33489	    現在兩邊共用這一支,不會再各自漂。
 33490	
 33491	    ★★第一版我把這支做得比抄來的那道還弱,外家審查席抓到(2026-09-07)★★:
 33492	    我原本收的參數是一個「預期路徑」,而且**把它整條 resolve 之後才比對**。兩邊一起跟著
 33493	    symlink 走,結果就是自己比自己——中間層被換成指向別處的 symlink 時完全擋不住。
 33494	    實測:把中間一層做成指向另一棵樹的 symlink,舊寫法照樣通過。
 33495	    ★正解是「預期路徑只解析家目錄那一段,後面用字面段」★(抄來的那道本來就是這樣做的):
 33496	    家目錄本身可以是 symlink(macOS 的 /var → /private/var 就是),但家目錄以下每一層
 33497	    都必須是真目錄。所以這支改成收「相對家目錄的字面段」,呼叫端沒辦法再傳一個
 33498	    會自我抵銷的預期路徑。
 33499	
 33500	    不過關一律「不信、不碰」(不擋、不寫、不刪),寧可少一層功能,不在別人的目錄上動手。
 33501	
 33502	    ★誠實邊界:這是路徑層檢查,擋不住同一個帳號底下的搶跑(TOCTOU)★——
 33503	    檢查完到真正動手之間有時間差,同 UID 的程序可以在那個縫裡把目錄換掉。要真正關掉
 33504	    得改用 dirfd / O_NOFOLLOW 那一套。沒做的理由:能在你的帳號下跑程式的人本來就能
 33505	    做任何事,這條的邊際價值低。**但不得宣稱「換掉也擋得住」**——那是假的。
 33506	    REVISIT:2026-12-07 若出現「非同帳號但能寫家目錄」的實際情境(共用機器、容器掛載),
 33507	    這條的成本效益要重算,那時就該做 dirfd 版
 33508	    """
 33509	    import stat as _stat
 33510	    try:
 33511	        if d.is_symlink():
 33512	            return False
 33513	        # ★只解析家目錄那一段,後面字面接★——整條 resolve 會讓兩邊一起跟著 symlink 走,
 33514	        # 檢查就變成自我抵銷(第一版的錯法,見上面)。
 33515	        expected = Path.home().resolve().joinpath(*rel_segments)
 33516	        if Path(d).resolve() != expected:
 33517	            return False
 33518	        st = d.stat()
 33519	    except OSError:
 33520	        return False
 33521	    if not d.is_dir():
 33522	        return False
 33523	    if hasattr(os, "getuid"):
 33524	        if st.st_uid != os.getuid():
 33525	            return False
 33526	        if st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH):
 33527	            return False
 33528	    return True
