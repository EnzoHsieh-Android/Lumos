 28313	def cmd_drift_scan(env, at=None, as_json=False, budget=None):
 28314	    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
 28315	    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
 28316	    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
 28317	    import json as _j, math as _m, time as _t
 28318	    budget = _DRIFT_BUDGET_SEC if budget is None else budget
 28319	    if not _m.isfinite(budget) or not 0 < budget <= 86400:
 28320	        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
 28321	        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
 28322	        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
 28323	        return 2
 28324	    deadline = _t.monotonic() + budget
 28325	    root, vault_rel = _drift_vault_of(env)
 28326	    tenv, sha = env, None
 28327	    if at:
 28328	        sha = _lens_full_sha(root, at)
 28329	        if sha is None:
 28330	            print(f"擋下:找不到提交 {at}", file=sys.stderr)
 28331	            return 2
 28332	        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
 28333	        vault_rel = _drift_vault_rel(root, sha) or vault_rel
 28334	        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
 28335	        if tenv is None:
 28336	            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
 28337	            return 2
 28338	    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
 28339	    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
 28340	    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
 33100	
 33101	def _lens_dispositions_lines(lines, rec):
 33102	    """派工鏡頭附表態記錄(表態閘 S8):只列人答的題(未觸發自動 na 只給個數);工具驗過錨點存在、沒驗答案對不對——審查席反駁的就是這些答案。回人答題數。"""
 33103	    disp = rec.get("dispositions") or {}
 33104	    human = [(q, e) for q, e in disp.items() if isinstance(e, dict) and not e.get("auto")]
 33105	    n_auto = sum(1 for e in disp.values() if isinstance(e, dict) and e.get("auto"))
 33106	    lines.append(f"[表態記錄(棧別效能檢核;分支 {rec.get('branch')},版本 {str(rec.get('head_sha') or '')[:8]})——寫入時工具只驗了形狀,證據存不存在要到推送前 code-loop check 才驗,答案對不對沒人驗]")
 33107	    for q, e in human:
 33108	        st = e.get("status")
 33109	        tail = (str(e.get("evidence") or "") if st == "satisfied"
 33110	                else (str(e.get("issue") or "") + " " + str(e.get("reason") or "")) if st == "todo"
 33111	                # tension 四欄都給審查席看——反駁的就是這四欄(2026-09-09 兩席相反時端出張力;「｜」分隔是編排者裁的,四欄需要分隔)
 33112	                else (f"選 {e.get('chosen') or ''}｜既有 {', '.join(str(x) for x in (e.get('existing') or []))}｜隱患 {e.get('hazard') or ''}｜建議 {e.get('suggestion') or ''}") if st == "tension"
 33113	                else str(e.get("reason") or ""))   # 全部 str(… or ""):治理帳重建來的紀錄不重驗形狀,缺欄不能炸(r1 正確性席 f3)
 33114	        lines.append(f"  {q} {st} — {str(tail)[:200]}")
 33115	    if n_auto:
 33116	        lines.append(f"  (另有 {n_auto} 題未觸發、工具自動記不適用)")
 33117	    return len(human)
