   678	def cand_P(push, spec):
   679	    """P 家族:規格欄位
   680	       dis: file|repo|move        消失怎麼判
   681	       newlines: skip|keep        這次新寫/改過的行跳不跳
   682	       retire: bq_near|full       撤除節怎麼認(r1 字面 vs 括號行+子節繼承)
   683	       clause: bool               提到名稱的那一句有撤除/歷史字眼就不列
   684	       home: any|origin|none      「家」怎麼算(none=全部算要處理)
   685	       ghost: None|test|all|all_hist  新寫的行提到終點找不到的名稱也列
   686	    回 [(筆記, 行號, 層, 觸發名)]"""
   687	    notes = push.tip_notes()
   688	    gone, _unp = push.disappeared(spec["dis"], spec.get("shape", True))
   689	    newl = push.new_lines() if spec["newlines"] == "skip" or spec.get("ghost") else {}
   690	    rx = _mk_rx(gone.keys())
   691	    hits = {}
   692	    home_any = push.homes_any() if spec["home"] in ("any", "origin", "origin_fb") else set()
   693	
   694	    def layer(rel, lno, toks, ghost=False):
   695	        n = notes[rel]
   696	        if spec["home"] == "none":
   697	            return "handle"
   698	        if n.regs[lno - 1] == "summary":
   699	            return "handle"
   700	        if spec["home"] == "any" or ghost:
   701	            return "handle" if rel in home_any else "list"
   702	        origins = set()
