   642	class Ctx:
   643	    def __init__(self, repo_path, vault):
   644	        self.repo = Repo(repo_path, vault)
   645	        self.code = Code(self.repo)
   646	        self.vault = Vault(self.repo)
   647	        self._hist = None
   648	
   649	    def history_defs(self):
   650	        """全歷史 py 定義索引(每個歷史 blob 剖一次)——r1 想用 git log -G 做的「曾經定義過」的便宜替代。"""
   651	        if self._hist is None:
   652	            out = self.repo.git("rev-list", "--objects", "--all")
   653	            s = set()
   654	            for ln in out.splitlines():
   655	                parts = ln.split(" ", 1)
   656	                if len(parts) == 2 and (parts[1].endswith(".py") or parts[1] == "scripts/lumos") and not _excluded(parts[1]):
   657	                    info = self.code.py(parts[0])
   658	                    if info:
   659	                        s |= info["defs"] | info["flags"]
   660	            self._hist = s
   661	        return self._hist
