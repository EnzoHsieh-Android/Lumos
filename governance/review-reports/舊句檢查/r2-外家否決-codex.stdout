   312	        self.ret_full2 = [False] * (n + 1)     # P4r2:ret_full + 節內任一行獨立引用區塊含撤除字樣,從那行到節尾(含子節)
   313	        self.ret_full3 = [False] * (n + 1)     # P4r3:同 P4r2,但那行引用區塊還要含範圍宣告字(SCOPE_WORDS)
   314	        self._bq_mid = []                      # (行號, 所在節層級;0=第一個標題之前)
   315	        stack = []   # [(level, bq_flag, full_flag)]
   316	        i = 0
   317	        while i < n:
   318	            ln = self.lines[i]
   319	            lno = i + 1
   320	            if self.regs[i] == "body" and lno in self.vis:
   321	                m = HEAD_RE.match(ln)
   322	                if m:
   323	                    lvl = len(m.group(1))
   324	                    while stack and stack[-1][0] >= lvl:
   325	                        stack.pop()
   326	                    j = i + 1
   327	                    while j < n and not self.lines[j].strip():
   328	                        j += 1
   329	                    first = self.lines[j] if j < n else ""
   330	                    bq = first.lstrip().startswith(">") and _is_banner(first)
   331	                    full = _is_banner(first)
   332	                    stack.append((lvl, bq, full))
   333	            if self.regs[i] == "body":
   334	                self.ret_bq_near[lno] = bool(stack and stack[-1][1])
   335	                self.ret_full[lno] = any(s[2] for s in stack)
   336	            i += 1
   337	        # P4r2:節中任意位置的引用區塊撤除行 → 該行到節尾(下一個同層或更高層標題之前)都不看
   338	        self.ret_full2 = self._mid_retire(lambda ln: True)
   339	        # P4r3:同上,但那一行還要有範圍宣告字(「golden 已凍結」這種描述動作的句子不算宣告)
   340	        self.ret_full3 = self._mid_retire(lambda ln: any(w in ln for w in SCOPE_WORDS))
   341	        # 標題行本身若落在仍有效的標記內不會發生(上面已把 l>=標題層級的標記移除)
   342	
   343	    def _mid_retire(self, extra_ok):
   344	        out = list(self.ret_full)
   345	        lvl_now, marks = 0, []   # marks: [(起始行, 層級)]
   346	        for i2, ln2 in enumerate(self.lines):
   347	            lno2 = i2 + 1
   348	            if self.regs[i2] != "body" or lno2 not in self.vis:
   349	                continue
   350	            m2 = HEAD_RE.match(ln2)
   351	            if m2:
   352	                lvl_now = len(m2.group(1))
   353	                marks = [(a, l) for a, l in marks if l < lvl_now]  # 同層或更高層的標題結束了它
   354	                continue
   355	            if ln2.lstrip().startswith(">") and _is_banner(ln2) and extra_ok(ln2):
   356	                marks.append((lno2, lvl_now))
   357	            if marks:
   358	                out[lno2] = True
   359	        return out
   360	
   361	    def _about(self, text):
   362	        fm, _ = LM.split_frontmatter(text)
   363	        out, cur = [], False
   364	        for ln in fm or []:
   365	            m = LM.TOP_KEY_RE.match(ln)
   366	            if m:
   367	                cur = m.group(1) == "about_code"
   368	                continue
   369	            if cur:
   370	                s = ln.strip()
   371	                if s.startswith("- "):
   372	                    out.append(s[2:].strip().strip('"').strip("'").strip("`"))
   373	        return out
   374	
   375	    def _type(self):
   376	        for ln in self.lines[1:40]:
   377	            if ln.startswith("type:"):
   378	                return ln.split(":", 1)[1].strip()
   379	            if ln.strip() == "---":
   380	                break
   381	        return ""
   382	
   383	    def scan_lines(self):
   384	        """要掃的行:正文、摘要、決策欄的散文;跳過圍欄內與其他開頭欄位。"""
   385	        for i, ln in enumerate(self.lines):
   386	            lno = i + 1
   387	            if self.regs[i] in ("body", "summary", "decisions") and lno in self.vis:
   388	                yield lno, ln
