  1254	def cmd_revisit(a):
  1255	    """舊句檢查兩週回頭量(Projects/舊句檢查_計劃〈做法〉4):--pairs 每行一組 <base>..<head>(從治理帳 extra.base_sha 與 head_sha 抽)。
  1256	    每一組:P4r3 的命中、關掉句內字眼過濾多出來的行(P4r3c − P4r3)、拿掉形狀過濾多出來的行(P4r3s − P4r3);
  1257	    再對每組終點的圖譜數只因撤除節②(P4r3 那種)被豁免的非空行與觸發行,以及帶否定或「撤除條件」字樣的撤除行。只讀。"""
  1258	    ctx = Ctx(a.repo, a.vault)
  1259	    out = {"pairs": [], "retire2": {}, "neg_banner": {}}
  1260	    for raw in open(a.pairs, encoding="utf-8"):
  1261	        raw = raw.strip()
  1262	        if not raw or raw.startswith("#"):
  1263	            continue
  1264	        base, tip = raw.split("..", 1)
  1265	        base, tip = ctx.repo.full(base), ctx.repo.full(tip)
  1266	        push = Push(ctx, base, tip)
  1267	        notes = push.tip_notes()
  1268	
  1269	        def rows(hs):
  1270	            return {(h[0], h[1]): {"note": h[0], "line": h[1], "layer": h[2], "tokens": h[3],
  1271	                                   "text": notes[h[0]].lines[h[1] - 1][:260]} for h in hs}
  1272	        main_ = rows(run_cand(ctx, "P4r3", base, tip, push))
  1273	        noclause = rows(run_cand(ctx, "P4r3c", base, tip, push))
  1274	        noshape = rows(run_cand(ctx, "P4r3s", base, tip, push))
  1275	        out["pairs"].append({"base": base, "head": tip, "hits": list(main_.values()),
  1276	                             "clause_released": [v for k, v in noclause.items() if k not in main_],
  1277	                             "shape_released": [v for k, v in noshape.items() if k not in main_]})
  1278	        if tip not in out["retire2"]:
  1279	            per, neg = {}, []
  1280	            for rel, n in notes.items():
  1281	                cnt = sum(1 for lno, ln in n.scan_lines() if ln.strip() and n.ret_full3[lno] and not n.ret_full[lno])
  1282	                if cnt:
  1283	                    per[rel] = {"lines": cnt, "triggers": [i + 1 for i, ln in enumerate(n.lines)
  1284	                                                           if n.regs[i] == "body" and (i + 1) in n.vis
  1285	                                                           and ln.lstrip().startswith(">") and _is_banner(ln)
  1286	                                                           and any(w in ln for w in SCOPE_WORDS)]}
  1287	                neg += [f"{rel}:{i + 1}" for i, ln in enumerate(n.lines)
  1288	                        if n.regs[i] == "body" and (i + 1) in n.vis and _is_banner(ln) and NEG_BANNER_RE.search(ln)]
  1289	            out["retire2"][tip] = per
  1290	            out["neg_banner"][tip] = neg
  1291	        p = out["pairs"][-1]
  1292	        print(f"{base[:8]}..{tip[:8]} 命中 {len(p['hits'])}(要處理 {sum(1 for h in p['hits'] if h['layer'] == 'handle')})"
  1293	              f" 字眼過濾放過 {len(p['clause_released'])} 形狀過濾放過 {len(p['shape_released'])}"
  1294	              f" 撤除節②豁免 {sum(v['lines'] for v in out['retire2'][tip].values())} 行 否定撤除行 {len(out['neg_banner'][tip])}")
  1295	    ctx.repo.close()
  1296	    json.dump(out, open(a.out, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
