   501	    def defs_of(self, commit, path):
   502	        sha = self.repo.tree(commit).get(path)
   503	        if not sha:
   504	            return set(), True
   505	        info = self.ctx.code.py(sha)
   506	        if info is None:
   507	            return None, False
   508	        return info["defs"] | info["flags"], True
   509	
   510	    def tip_all_defs(self):
   511	        def f():
   512	            s = set()
   513	            for p, sha in self.repo.tree(self.tip).items():
   514	                if self.ctx.code.kind(p, sha) == "py":
   515	                    info = self.ctx.code.py(sha)
   516	                    if info:
   517	                        s |= info["defs"] | info["flags"]
   518	            return s
   519	        return self.memo("tipdefs", f)
   520	
   521	    def tip_haystack(self):
   522	        """終點「程式裡找得到」的識別字、旗標、路徑:py 用 ast(連字串內容),其他非散文文字檔用切詞。"""
   523	        def f():
   524	            ids, flags, paths, bases = set(), set(), set(), set()
   525	            for p, sha in self.repo.tree(self.tip).items():
   526	                paths.add(p)
   527	                bases.add(p.rsplit("/", 1)[-1])
   528	                k = self.ctx.code.kind(p, sha)
   529	                if k == "py":
   530	                    info = self.ctx.code.py(sha)
   531	                    if info:
   532	                        ids |= info["idents"] | info["defs"]
   533	                        flags |= info["flags"] | info["strflags"]
   534	                        continue
   535	                if k or (not _excluded(p) and os.path.splitext(p)[1].lower() in TEXT_EXTS):
   536	                    a, b = self.ctx.code.raw_tokens(sha)
   537	                    ids |= a
   538	                    flags |= b
   539	            return ids, flags, paths, bases
   540	        return self.memo("hay", f)
   541	
   542	    def disappeared(self, mode, shape=True):
   543	        """消失的名稱 → 起點原本所在的檔(集合)。mode: file | repo | move | loose
   544	        (loose=全 repo 比之外,終點程式裡任何地方(識別字、字串內容、其他程式檔)還出現這個名稱就不算消失)。
   545	        剖不動的那一版:整支檔不算(不能當成全部消失),記在 unparsable。"""
   546	        def f():
   547	            renames = mode == "move"
   548	            gone, unparsable = {}, []
   549	            added_elsewhere = set()
   550	            chg = self.code_changes(renames)
   551	            py_chg = [c for c in chg if c[3] == "py"]
   552	            if mode == "move":
   553	                for st, a, b, _k in py_chg:
   554	                    tdefs, ok_t = self.defs_of(self.tip, b)
   555	                    bdefs, ok_b = self.defs_of(self.base, a) if st != "A" else (set(), True)
   556	                    if tdefs is not None and bdefs is not None:
   557	                        added_elsewhere |= (tdefs - bdefs)
   558	            tipdefs = self.tip_all_defs() if mode in ("repo", "loose") else None
   559	            hay = self.tip_haystack() if mode == "loose" else None
   560	            for st, a, b, _k in py_chg:
   561	                if st == "A":
   562	                    continue
   563	                bdefs, _ = self.defs_of(self.base, a)
   564	                tdefs, _ = self.defs_of(self.tip, b) if st != "D" else (set(), True)
   565	                if bdefs is None or tdefs is None:
   566	                    unparsable.append(a)
   567	                    continue
   568	                for n in bdefs - tdefs:
   569	                    if mode in ("repo", "loose") and n in tipdefs:
   570	                        continue
   571	                    if mode == "loose" and (n in hay[0] or n in hay[1]):
   572	                        continue
   573	                    if mode == "move" and n in added_elsewhere:
   574	                        continue
   575	                    gone.setdefault(n, set()).add(a)
   576	            # 被刪或改名的舊路徑(改名配對模式下,-M 認到的改名不算消失)
   577	            tt = self.repo.tree(self.tip)
   578	            tip_bases = {p.rsplit("/", 1)[-1] for p in tt}
   579	            for st, a, b, _k in chg:
   580	                if st == "D" or (st == "R" and mode != "move"):
   581	                    gone.setdefault(a, set()).add(a)
   582	                    bn = a.rsplit("/", 1)[-1]
   583	                    if bn not in tip_bases:
   584	                        gone.setdefault(bn, set()).add(a)
   585	            if mode != "move":
   586	                # --no-renames 下改名長成 D+A,上面 D 已處理
   587	                pass
   588	            if shape:
   589	                gone = {n: v for n, v in gone.items() if _shape_ok(n)}
   590	            return gone, unparsable
   591	        return self.memo(("gone", mode) if shape else ("gone", mode, "noshape"), f)
   592	
   593	    def changed_consts(self):
   594	        def f():
   595	            out = {}
   596	            for st, a, b, k in self.code_changes(True):
   597	                if k != "py" or st in "AD":
   598	                    continue
   599	                bs, ts = self.repo.tree(self.base).get(a), self.repo.tree(self.tip).get(b)
   600	                bi, ti = self.ctx.code.py(bs), self.ctx.code.py(ts)
   601	                if not bi or not ti:
   602	                    continue
   603	                for n, v in bi["consts"].items():
   604	                    if n in ti["consts"] and ti["consts"][n] != v:
   605	                        out.setdefault(n, set()).add(a)
   606	            return out
   607	        return self.memo("consts", f)
