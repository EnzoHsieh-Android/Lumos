   485	    def tip_notes(self):
   486	        return self.memo("tipn", lambda: self.ctx.vault.notes(self.tip))
   487	
   488	    def base_notes(self):
   489	        return self.memo("basen", lambda: self.ctx.vault.notes(self.base))
   490	
   491	    def new_lines(self):
   492	        """這次範圍裡新寫或改過的筆記行 {筆記相對路徑: set(終點行號)}(-M 認改名)。"""
   493	        def f():
   494	            raw = self.repo.git("diff", "--no-ext-diff", "-U0", "-M", "--no-color", self.base, self.tip,
   495	                                "--", self.repo.vault, binary=True)
   496	            added = LM._notelines_parse_added(raw)
   497	            pre = self.repo.vault + "/"
   498	            return {p[len(pre):]: {n for n, _ in v} for p, v in added.items() if p.startswith(pre)}
   499	        return self.memo("newl", f)
