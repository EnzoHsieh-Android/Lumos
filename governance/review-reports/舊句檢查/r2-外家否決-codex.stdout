 26282	def _drift_field_line(text, key, pred=None):
 26283	    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
 26284	    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
 26285	    lines = text.split("\n")
 26286	    e = _drift_fm_end(lines)
 26287	    for i in range(1, e):
 26288	        m = TOP_KEY_RE.match(lines[i])
 26289	        if not (m and m.group(1) == key):
 26290	            continue
 26291	        if pred is None:
 26292	            return i + 1
 26293	        for j in range(i, e):
 26294	            if j > i and TOP_KEY_RE.match(lines[j]):
 26295	                break
 26296	            if pred(lines[j]):
 26297	                return j + 1
 26298	        return i + 1
 26299	    return 1
