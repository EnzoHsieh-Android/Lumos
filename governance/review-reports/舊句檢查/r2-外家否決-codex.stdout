 27460	def _drift_prev_ack_line(f):
 27461	    """c2/c3 以前表態過、現在清單多了新的 → 要印的一句;沒有回 None。"""
 27462	    pa = f.get("prev_ack")
 27463	    if not pa:
 27464	        return None
 27465	    old = [str(x) for x in pa["related"]] if isinstance(pa.get("related"), list) else []
 27466	    more = [x for x in f.get("related", []) if nfc(str(x)) not in {nfc(y) for y in old}]
 27467	    return (f"這篇以前表態過(最近一次當時連著 {'、'.join(x[:-3] for x in old) or '(清單壞了)'}),"
 27468	            f"現在多了 {'、'.join(str(x)[:-3] for x in more) or '(清單壞了,讀不出)'};最近一次理由:{str(pa.get('reason') or '')[:80]}")
 27469	
