 28416	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 28417	            txt = cp.read_bytes()
 28418	    except OSError:
 28419	        txt = None
 28420	    mode, cfg_warns, explicit = _drift_config(txt)

