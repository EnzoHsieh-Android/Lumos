   609	    def homes_any(self):
   610	        """家(讀法甲):範圍裡任何一支改到的程式檔,起點或終點樹上 about_code 列了它的筆記。"""
   611	        def f():
   612	            paths = set()
   613	            for st, a, b, _k in self.code_changes(True):
   614	                paths.add(a)
   615	                paths.add(b)
   616	            out = set()
   617	            for nm in (self.tip_notes(), self.base_notes()):
   618	                for rel, n in nm.items():
   619	                    if paths & set(n.about):
   620	                        out.add(rel)
   621	            return out
   622	        return self.memo("homeany", f)
   623	
   624	    def homes_of(self, files):
   625	        """家(讀法乙):這些起點檔的家——起點樹與終點樹的 about_code 都算(改名後終點已換新路徑也認)。"""
   626	        key = ("homeof", frozenset(files))
   627	
   628	        def f():
   629	            fs = set(files)
   630	            for st, a, b, _k in self.code_changes(True):
   631	                if a in fs:
   632	                    fs.add(b)
   633	            out = set()
   634	            for nm in (self.tip_notes(), self.base_notes()):
   635	                for rel, n in nm.items():
   636	                    if fs & set(n.about):
   637	                        out.add(rel)
   638	            return out
   639	        return self.memo(key, f)
