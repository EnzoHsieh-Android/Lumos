 27446	def _drift_bound_latest(rows):
 27447	    """同一個鍵、記了 related 的表態裡 seq 最大的那幾筆(同號的全算;兩個工作樹各自追加後合併可能同號)。"""
 27448	    if not rows:
 27449	        return []
 27450	    top = max(_drift_ack_seq(a) for a in rows)
 27451	    return [a for a in rows if _drift_ack_seq(a) == top]
 27452	
