 28353	def _drift_scan_print(at, left, done, bad, probs=()):
 28354	    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)、回頭條件的問題。"""
 28355	    if bad:   # 路徑與原文都來自筆記,印之前換掉控制字元(代碼審 r5 資安席)
 28356	        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(_esc_clean(b) for b in bad[:10]))
 28357	    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
 28358	    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
 28359	          + (f";已表態 {len(done)}" if done else ""))
 28360	    for k in _DRIFT_KINDS:
 28361	        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
 28362	        if rows:
 28363	            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
 28364	            for f, acked in rows:
 28365	                print(f"  {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 70)}" + ("  (已表態)" if acked else ""))
 28366	                if not acked:
 28367	                    print(f"      {_esc_clean(f['why'], 1000)}")
 28368	                    if _drift_prev_ack_line(f):
 28369	                        print(f"      ({_esc_clean(_drift_prev_ack_line(f), 400)})")
 28370	            _drift_print_hints([f for f, acked in rows if not acked], sys.stdout, "  改法:")
 28371	    if probs:
 28372	        print(f"[回頭條件的問題] {len(probs)} 處(寫錯、沒帶期限、指不到、寫在不評估的地方、判不了):")
 28373	        for p, n, t, w in probs:
 28374	            print(f"  {_esc_clean(p)}:{n}  {_esc_clean(t, 70)}")
 28375	            print(f"      {_esc_clean(w, 1000)}")
