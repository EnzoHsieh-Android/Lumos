  1315	    ap.add_argument("--skip-sweep", action="store_true")
  1316	    a = ap.parse_args()
  1317	    {"run": cmd_run, "time": cmd_time, "q6": cmd_q6, "show": cmd_show, "scan": cmd_scan, "revisit": cmd_revisit}[a.cmd](a)
