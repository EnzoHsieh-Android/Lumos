 28378	def _drift_doctor_lines(env):
 28379	    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
 28380	    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
 28381	    root, vault_rel = _drift_vault_of(env)
 28382	    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
 28383	    out = []
 28384	    # 乙:只讀筆記、不評估條件(要看哪些成立跑 drift scan)
 28385	    n_rows = n_noby = n_bad = n_dead = 0
 28386	    for p in env.notes:
 28387	        rows, dead = _probe_lines(env_text(env, p) or "")
 28388	        n_rows += len(rows)
 28389	        n_dead += len(dead)
 28390	        n_noby += sum(1 for _n, _t, pr in rows if pr["by"] is None)
 28391	        n_bad += sum(1 for _n, _t, pr in rows if pr["errs"])
 28392	    if n_rows or n_dead:
 28393	        out.append(f"條件式回頭條件 {n_rows} 條(由 lumos drift scan 評估)"
 28394	                   + (f";沒帶期限 {n_noby} 條" if n_noby else "") + (f";寫錯的 {n_bad} 條" if n_bad else "")
 28395	                   + (f";寫在不評估的地方 {n_dead} 處" if n_dead else ""))
 28396	    for k in ("c1", "c2", "c3", "c4", "c5"):
 28397	        rows = [f for f in left if f["kind"] == k]
 28398	        nd = sum(1 for f in done if f["kind"] == k)
 28399	        if rows:     # 只剩已表態的不開段(全靜默;代碼審 r2 正確性席:表態完那一段永遠不會安靜);全部清單看 drift scan
 28400	            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
 28401	            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else "")
 28402	                       + ";改法例:" + _drift_fix_hint(k, rows[0]["path"], rows[0]["line"])[0])
 28403	    return out
