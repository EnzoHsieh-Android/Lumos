 23587	    if _testmap_is_test(path):
 23588	        return True
 23589	    if _nodehome_in_stack_test_dir(path, layout):
 23590	        return True
 23591	    if _testmap_ext(path) in _TESTMAP_EXTS:
 23592	        return False                      # 測試地圖認得這種副檔名,它說不是就不是
 23593	    if _TESTMAP_DIR_RE is None:
 23594	        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
 23595	    if _TESTMAP_DIR_RE.search(path):
 23596	        return True
