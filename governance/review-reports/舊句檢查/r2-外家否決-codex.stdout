   664	# ───────────────────────── 候選判法 ─────────────────────────
   665	
   666	
   667	def _mk_rx(names):
   668	    ids = sorted((n for n in names if not n.startswith("--") and "/" not in n and "." not in n), key=len, reverse=True)
   669	    others = sorted((n for n in names if n not in set(ids)), key=len, reverse=True)
   670	    parts = []
   671	    if ids:
   672	        parts.append(r"(?<![A-Za-z0-9_])(?:" + "|".join(map(re.escape, ids)) + r")(?![A-Za-z0-9_])")
   673	    if others:
   674	        parts.append(r"(?<![A-Za-z0-9_/.-])(?:" + "|".join(map(re.escape, others)) + r")(?![A-Za-z0-9_-])")
   675	    return re.compile("|".join(parts)) if parts else None
