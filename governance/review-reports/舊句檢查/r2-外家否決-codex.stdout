   471	    def code_changes(self, renames):
   472	        """[(status, 起點路徑, 終點路徑, kind)] 只收程式檔。"""
   473	        def f():
   474	            bt, tt = self.repo.tree(self.base), self.repo.tree(self.tip)
   475	            res = []
   476	            for st, a, b in self.changes(renames):
   477	                sha = tt.get(b) or bt.get(a)
   478	                path = b if b in tt else a
   479	                k = self.ctx.code.kind(path, sha) if sha else None
   480	                if k:
   481	                    res.append((st, a, b, k))
   482	            return res
   483	        return self.memo(("cchg", renames), f)
