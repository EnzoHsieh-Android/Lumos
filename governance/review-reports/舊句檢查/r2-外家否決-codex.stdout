   411	def _clause_has_hist(line, pos, rx=None):
   412	    """提到名稱的那一句(括號內就只看括號內;括號外把括號內容剝掉)裡有沒有歷史/撤除字眼。"""
   413	    depth_open = []
   414	    span = None
   415	    for i, ch in enumerate(line):
   416	        if ch in "(（":
   417	            depth_open.append(i)
   418	        elif ch in ")）" and depth_open:
   419	            a = depth_open.pop()
   420	            if a < pos < i and (span is None or a > span[0]):
   421	                span = (a, i)
   422	    if span is None and depth_open and depth_open[-1] < pos:
   423	        span = (depth_open[-1], len(line))
   424	    if span is not None:
   425	        seg = line[span[0] + 1:span[1]]
   426	        rel = pos - span[0] - 1
   427	    else:
   428	        seg = re.sub(r"[(（][^()（）]*[)）]", lambda m: "\0" * len(m.group(0)), line)
   429	        rel = pos
   430	    cuts = [m.end() for m in re.finditer(r"[。;；!?！？]", seg) if m.end() <= rel]
   431	    a = cuts[-1] if cuts else 0
   432	    m2 = re.search(r"[。;；!?！？]", seg[rel:])
   433	    b = rel + m2.start() if m2 else len(seg)
   434	    clause = seg[a:b]
   435	    return bool((rx or HIST_RX).search(clause))
