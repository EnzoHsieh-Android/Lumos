 27385	def _drift_load_acks(root, where=None):
 27386	    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
 27387	    raw = None
 27388	    if where is None:
 27389	        fp = Path(root) / _DRIFT_ACKS
 27390	        try:
 27391	            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
 27392	        except OSError:
 27393	            raw = None
 27394	    else:
 27395	        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
 27396	        raw = bl[0] if bl else None
 27397	    return [d for d in _drift_jsonl_parse(raw) if d.get("path") and d.get("kind") in _DRIFT_KINDS]
