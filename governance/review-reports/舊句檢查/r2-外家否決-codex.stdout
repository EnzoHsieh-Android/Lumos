  9223	def _loop_ts_newer(a, b):
  9224	    """a 是不是比 b 晚。兩邊都解得動就比 UTC 秒數,否則退回字串比對(舊帳相容)。"""
  9225	    ka, kb = _loop_ts_key(a), _loop_ts_key(b)
  9226	    if ka is not None and kb is not None:
  9227	        return ka > kb
  9228	    return (a or "") > (b or "")
