  9204	def _loop_ts_key(ts):
  9205	    """ISO 時間字串 → 可比較的 UTC 秒數;解析不動或沒帶時區就回 None(呼叫端退回字串比對)。
  9206	
  9207	    ★為什麼需要這一層★:審查帳與治理帳今天全部寫 +08:00(當場數過:1101 / 26443 筆都是),
  9208	    所以直接拿字串比大小剛好會對。但那是巧合不是保證——只要有一筆從別的時區(或 UTC)
  9209	    寫進來,字串比對就會**靜默**把開著判成關了、或反過來。這層把那個假設消掉,成本幾行。
  9210	    沒帶時區的一律不猜(回 None):猜錯比退回字串比對更糟。"""
  9211	    import datetime
  9212	    if not ts:
  9213	        return None
  9214	    try:
  9215	        d = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
  9216	    except ValueError:
  9217	        return None
  9218	    if d.tzinfo is None:
  9219	        return None
  9220	    return d.timestamp()
