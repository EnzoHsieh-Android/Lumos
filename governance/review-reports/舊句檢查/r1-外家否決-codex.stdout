 27436	def _drift_ack_seq(a):
 27437	    v = a.get("seq")
 27438	    return v if isinstance(v, int) and not isinstance(v, bool) else 0
 27439	
 27440	
 27441	def _drift_seq_ok(a):
 27442	    v = a.get("seq")
 27443	    return isinstance(v, int) and not isinstance(v, bool) and v > 0
 27444	
