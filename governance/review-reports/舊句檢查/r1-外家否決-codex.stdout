   491	    def defs_of(self, commit, path):
   492	        sha = self.repo.tree(commit).get(path)
   493	        if not sha:
   494	            return set(), True
   495	        info = self.ctx.code.py(sha)
   496	        if info is None:
   497	            return None, False
   498	        return info["defs"] | info["flags"], True
   499	
   500	    def tip_all_defs(self):
   501	        def f():
   502	            s = set()
   503	            for p, sha in self.repo.tree(self.tip).items():
   504	                if self.ctx.code.kind(p, sha) == "py":
   505	                    info = self.ctx.code.py(sha)
   506	                    if info:
   507	                        s |= info["defs"] | info["flags"]
   508	            return s
   509	        return self.memo("tipdefs", f)
   510	
   511	    def tip_haystack(self):
   512	        """終點「程式裡找得到」的識別字、旗標、路徑:py 用 ast(連字串內容),其他非散文文字檔用切詞。"""
   513	        def f():
   514	            ids, flags, paths, bases = set(), set(), set(), set()
   515	            for p, sha in self.repo.tree(self.tip).items():
   516	                paths.add(p)
   517	                bases.add(p.rsplit("/", 1)[-1])
   518	                k = self.ctx.code.kind(p, sha)
   519	                if k == "py":
   520	                    info = self.ctx.code.py(sha)
   521	                    if info:
   522	                        ids |= info["idents"] | info["defs"]
   523	                        flags |= info["flags"] | info["strflags"]
   524	                        continue
   525	                if k or (not _excluded(p) and os.path.splitext(p)[1].lower() in TEXT_EXTS):
   526	                    a, b = self.ctx.code.raw_tokens(sha)
   527	                    ids |= a
   528	                    flags |= b
   529	            return ids, flags, paths, bases
   530	        return self.memo("hay", f)
   531	
   532	    def disappeared(self, mode):
   533	        """消失的名稱 → 起點原本所在的檔(集合)。mode: file | repo | move | loose
   534	        (loose=全 repo 比之外,終點程式裡任何地方(識別字、字串內容、其他程式檔)還出現這個名稱就不算消失)。
   535	        剖不動的那一版:整支檔不算(不能當成全部消失),記在 unparsable。"""
   536	        def f():
   537	            renames = mode == "move"
   538	            gone, unparsable = {}, []
   539	            added_elsewhere = set()
   540	            chg = self.code_changes(renames)
   541	            py_chg = [c for c in chg if c[3] == "py"]
   542	            if mode == "move":
   543	                for st, a, b, _k in py_chg:
   544	                    tdefs, ok_t = self.defs_of(self.tip, b)
   545	                    bdefs, ok_b = self.defs_of(self.base, a) if st != "A" else (set(), True)
   546	                    if tdefs is not None and bdefs is not None:
   547	                        added_elsewhere |= (tdefs - bdefs)
   548	            tipdefs = self.tip_all_defs() if mode in ("repo", "loose") else None
   549	            hay = self.tip_haystack() if mode == "loose" else None
   550	            for st, a, b, _k in py_chg:
   551	                if st == "A":
   552	                    continue
   553	                bdefs, _ = self.defs_of(self.base, a)
   554	                tdefs, _ = self.defs_of(self.tip, b) if st != "D" else (set(), True)
   555	                if bdefs is None or tdefs is None:
   556	                    unparsable.append(a)
   557	                    continue
   558	                for n in bdefs - tdefs:
   559	                    if mode in ("repo", "loose") and n in tipdefs:
   560	                        continue
   561	                    if mode == "loose" and (n in hay[0] or n in hay[1]):
   562	                        continue
   563	                    if mode == "move" and n in added_elsewhere:
   564	                        continue
   565	                    gone.setdefault(n, set()).add(a)
   566	            # 被刪或改名的舊路徑(改名配對模式下,-M 認到的改名不算消失)
   567	            tt = self.repo.tree(self.tip)
   568	            tip_bases = {p.rsplit("/", 1)[-1] for p in tt}
   569	            for st, a, b, _k in chg:
   570	                if st == "D" or (st == "R" and mode != "move"):
   571	                    gone.setdefault(a, set()).add(a)
   572	                    bn = a.rsplit("/", 1)[-1]
   573	                    if bn not in tip_bases:
   574	                        gone.setdefault(bn, set()).add(a)
   575	            if mode != "move":
   576	                # --no-renames 下改名長成 D+A,上面 D 已處理
   577	                pass
   578	            gone = {n: v for n, v in gone.items() if _shape_ok(n)}
   579	            return gone, unparsable
   580	        return self.memo(("gone", mode), f)
   581	
   582	    def changed_consts(self):
   583	        def f():
   584	            out = {}
   585	            for st, a, b, k in self.code_changes(True):
   586	                if k != "py" or st in "AD":
   587	                    continue
   588	                bs, ts = self.repo.tree(self.base).get(a), self.repo.tree(self.tip).get(b)
   589	                bi, ti = self.ctx.code.py(bs), self.ctx.code.py(ts)
   590	                if not bi or not ti:
   591	                    continue
   592	                for n, v in bi["consts"].items():
   593	                    if n in ti["consts"] and ti["consts"][n] != v:
   594	                        out.setdefault(n, set()).add(a)
   595	            return out
   596	        return self.memo("consts", f)
