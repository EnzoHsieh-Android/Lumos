 28276	def _drift_report_must(root, mode, must, unknown, acks, alive=None):
 28277	    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
 28278	    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
 28279	    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
 28280	    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
 28281	    for u in unknown:
 28282	        print(f"  判不了:{_esc_clean(u, 1000)}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
 28283	              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
 28284	    _drift_print_findings(must, sys.stderr, acks, alive)
 28285	    kinds = {f["kind"] for f in must}
 28286	    # 改法指令由 _drift_fix_hint 單一產生(存量漂移改法 [S10]):c1 到 c5 指到 lumos drift fix(c1 一篇一條),
 28287	    # 條件式回頭條件(probe)的修法不一樣,同一支給它自己的說法
 28288	    _drift_print_hints(must, sys.stderr, "改法(每一筆一條指令;c1 一篇一條):")
 28289	    if must:
 28290	        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
 28291	        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
 28292	        for k in sorted(kinds):
 28293	            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
 28294	    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
 28295	    if mode == "block":
 28296	        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
 28297	                            nodes=sorted({f["path"][:-3] for f in must})[:50])
 28298	        return 1
 28299	    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
 28300	    return 0
