   294	
   295	class Note:
   296	    def __init__(self, path, text):
   297	        self.path = path
   298	        self.lines = text.split("\n")
   299	        try:
   300	            self.regs = LM._notelines_regions(text)
   301	        except Exception:
   302	            self.regs = ["body"] * len(self.lines)
   303	        self.vis = {i for i, _ in LM._visible_lines(self.lines)}
   304	        self.about = self._about(text)
   305	        self.type = self._type()
   306	        n = len(self.lines)
   307	        self.ret_bq_near = [False] * (n + 1)   # r1 字面:只認引用區塊、只算最近一個小標題
   308	        self.ret_full = [False] * (n + 1)      # 加嚴版:引用區塊或括號行、子節繼承
   309	        self.ret_full2 = [False] * (n + 1)     # P4r2:ret_full + 節內任一行獨立引用區塊含撤除字樣,從那行到節尾(含子節)
   310	        self._bq_mid = []                      # (行號, 所在節層級;0=第一個標題之前)
   311	        stack = []   # [(level, bq_flag, full_flag)]
   312	        i = 0
   313	        while i < n:
   314	            ln = self.lines[i]
   315	            lno = i + 1
   316	            if self.regs[i] == "body" and lno in self.vis:
   317	                m = HEAD_RE.match(ln)
   318	                if m:
   319	                    lvl = len(m.group(1))
   320	                    while stack and stack[-1][0] >= lvl:
   321	                        stack.pop()
   322	                    j = i + 1
   323	                    while j < n and not self.lines[j].strip():
   324	                        j += 1
   325	                    first = self.lines[j] if j < n else ""
   326	                    bq = first.lstrip().startswith(">") and _is_banner(first)
   327	                    full = _is_banner(first)
   328	                    stack.append((lvl, bq, full))
   329	            if self.regs[i] == "body":
   330	                self.ret_bq_near[lno] = bool(stack and stack[-1][1])
   331	                self.ret_full[lno] = any(s[2] for s in stack)
   332	            i += 1
   333	        # P4r2:節中任意位置的引用區塊撤除行 → 該行到節尾(下一個同層或更高層標題之前)都不看
   334	        self.ret_full2 = list(self.ret_full)
   335	        lvl_now, marks, ends = 0, [], []   # marks: [(起始行, 層級)]
   336	        for i2, ln2 in enumerate(self.lines):
   337	            lno2 = i2 + 1
   338	            if self.regs[i2] != "body" or lno2 not in self.vis:
   339	                continue
   340	            m2 = HEAD_RE.match(ln2)
   341	            if m2:
   342	                lvl_now = len(m2.group(1))
   343	                marks = [(a, l) for a, l in marks if l < lvl_now]  # 同層或更高層的標題結束了它
   344	                continue
   345	            if ln2.lstrip().startswith(">") and _is_banner(ln2):
   346	                marks.append((lno2, lvl_now))
   347	            if marks:
   348	                self.ret_full2[lno2] = True
   349	        # 標題行本身若落在仍有效的標記內不會發生(上面已把 l>=標題層級的標記移除)
   350	
   351	    def _about(self, text):
   352	        fm, _ = LM.split_frontmatter(text)
   353	        out, cur = [], False
   354	        for ln in fm or []:
   355	            m = LM.TOP_KEY_RE.match(ln)
   356	            if m:
   357	                cur = m.group(1) == "about_code"
   358	                continue
   359	            if cur:
   360	                s = ln.strip()
   361	                if s.startswith("- "):
   362	                    out.append(s[2:].strip().strip('"').strip("'").strip("`"))
   363	        return out
