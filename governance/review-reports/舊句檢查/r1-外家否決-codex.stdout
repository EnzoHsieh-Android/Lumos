   602	            for st, a, b, _k in self.code_changes(True):
   603	                paths.add(a)
   604	                paths.add(b)
   605	            out = set()
   606	            for nm in (self.tip_notes(), self.base_notes()):
   607	                for rel, n in nm.items():
   608	                    if paths & set(n.about):
   609	                        out.add(rel)
   610	            return out
   611	        return self.memo("homeany", f)
   612	
   613	    def homes_of(self, files):
   614	        """家(讀法乙):這些起點檔的家——起點樹與終點樹的 about_code 都算(改名後終點已換新路徑也認)。"""
