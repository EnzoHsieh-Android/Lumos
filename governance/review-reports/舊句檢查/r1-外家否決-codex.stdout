   258	# ───────────────────────── 筆記解析 ─────────────────────────
   259	
   260	RETIRE_WORDS = ("撤除", "撤掉", "作廢", "已失效", "已過時", "不是現況", "被取代", "已凍結", "superseded",
   261	                "已結案", "歷史紀錄", "Superseded")
   262	NOT_YET = re.compile(r"(尚未|還沒|未)(撤除|撤掉|作廢|失效|取代|凍結|結案)")
   263	HIST_WORDS = tuple(LM.NEG_LEXICONS["zh"]) + (
   264	    "撤除", "撤掉", "拿掉", "原寫", "原本", "原先", "不再", "舊版", "舊的", "刪除", "刪掉", "取代", "搬到",
   265	    "搬去", "改為", "改叫", "改成", "曾", "前身", "撤", "刪", "拔掉", "去掉", "不帶", "沒有")
   266	HIST_WORDS2 = HIST_WORDS + ("當時叫", "擴成", "改名為")
   267	# 英文字眼要整字比(不然 test_..._stays_dead_... 這種測試名會因為含 dead 被當成歷史句豁免)
   268	HIST_RX = re.compile("|".join(
   269	    (r"(?<![A-Za-z0-9_])" + re.escape(w) + r"(?![A-Za-z0-9_])") if w.isascii() else re.escape(w)
   270	    for w in sorted(set(HIST_WORDS), key=len, reverse=True)))
   271	HIST_RX2 = re.compile("|".join(
   272	    (r"(?<![A-Za-z0-9_])" + re.escape(w) + r"(?![A-Za-z0-9_])") if w.isascii() else re.escape(w)
   273	    for w in sorted(set(HIST_WORDS2), key=len, reverse=True)))
   274	HEAD_RE = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
   275	TESTREF_RE = re.compile(r"\[test:([^\]]+)\]")
   276	BACKTICK_SYM_RE = re.compile(r"^(?:--[a-z][a-z0-9-]+|[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*(?:\(\))?)$")
   277	
   278	
   279	def _shape_ok(name):
   280	    """r1 設計的形狀過濾:4 字以上、含底線或大小寫混合(旗標與路徑另計)。"""
   281	    if name.startswith("--") or "/" in name or name.endswith(".py"):
   282	        return True
   283	    return len(name) >= 4 and ("_" in name or (any(c.isupper() for c in name) and any(c.islower() for c in name)))
   284	
   285	
   286	def _is_banner(line):
   287	    s = line.strip()
   288	    if not s or s[0] not in ">(（":
   289	        return False
   290	    if NOT_YET.search(s):
   291	        return False
   292	    return any(w in s for w in RETIRE_WORDS)
