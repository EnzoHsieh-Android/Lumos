   481	    def new_lines(self):
   482	        """這次範圍裡新寫或改過的筆記行 {筆記相對路徑: set(終點行號)}(-M 認改名)。"""
   483	        def f():
   484	            raw = self.repo.git("diff", "--no-ext-diff", "-U0", "-M", "--no-color", self.base, self.tip,
   485	                                "--", self.repo.vault, binary=True)
   486	            added = LM._notelines_parse_added(raw)
   487	            pre = self.repo.vault + "/"
   488	            return {p[len(pre):]: {n for n, _ in v} for p, v in added.items() if p.startswith(pre)}
   489	        return self.memo("newl", f)
