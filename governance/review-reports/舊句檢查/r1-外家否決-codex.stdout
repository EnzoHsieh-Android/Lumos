 27642	def _drift_fix_hint(kind, path, line):
 27643	    """一筆發現該印的改法指令 → [指令]。★提示的單一產生處★(存量漂移改法 [S10]):drift check 擋下與只列出、drift scan、
 27644	    doctor Z 段、計劃收尾的連帶待辦都從這裡拿,不再各自教人手改。"""
 27645	    node = _drift_sh(path[:-3] if path.endswith(".md") else path, node=True)
 27646	    base = f"lumos drift fix {node} {line} --kind {kind}"
 27647	    if kind == "c2":
 27648	        return [base + ' --close --status done --reason "<為什麼算解決,附提交或測試>"',
 27649	                base + ' --keep --reason "<為什麼還沒解決>"']
 27650	    if kind == "c3":
 27651	        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + ">"]
 27652	    if kind == "c4":
 27653	        return [base + "   # 列證據、範本與預填好的 lumos set 整欄指令(c4 不自己寫檔)"]
 27654	    if kind == "probe":
 27655	        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
 27656	                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
 27657	    return [base]
