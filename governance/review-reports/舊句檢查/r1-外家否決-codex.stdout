 27491	def cmd_drift_ack(env, node, line, kind, reason, dry_run=False):
 27492	    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。
 27493	    c2、c3 先確認那一行當下真的是這一種發現,記下當時連著的已收尾計劃(related);每筆都記遞增序號 seq(存量漂移改法 [S8])。"""
 27494	    import datetime, secrets
 27495	    err = _drift_ack_args_err(kind, reason)
 27496	    if err:
 27497	        print(f"擋下:{err}", file=sys.stderr)
 27498	        return 2
 27499	    rel = env.find(node)
 27500	    if rel is None:
 27501	        return _node_not_found(env, node, write_side=True)
 27502	    text = env_text(env, rel)
 27503	    lines = (text or "").split("\n")
 27504	    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
 27505	        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
 27506	        return 2
 27507	    root, vault_rel = _drift_vault_of(env)
 27508	    head = ""
 27509	    for ln in reversed(lines[:line]):
 27510	        if ln.startswith("#"):
 27511	            head = ln.lstrip("#").strip()
 27512	            break
 27513	    token = "DACK-" + secrets.token_hex(4)
 27514	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 27515	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
 27516	    if kind in _DRIFT_BOUND_KINDS:
 27517	        # 鎖外新建圖譜物件重判(大圖譜重建可能超過鎖的 30 秒接手線)
 27518	        f, err = _drift_current_finding(Env(env.vault), rel, line, kind)
 27519	        if err:
 27520	            print(f"擋下:{err}", file=sys.stderr)
 27521	            return 2
 27522	        rec["related"] = sorted(nfc(str(x)) for x in f.get("related", []))
 27523	    if dry_run:     # drift fix --kind c2 --keep --dry-run:判定做完、不拿鎖不寫(代碼審 r1 六席同報:原本照樣寫表態)
 27524	        print(f"預覽(沒寫):會記一筆表態——{_esc_clean(rel, 200)} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]}),"
 27525	              f"理由:{_esc_clean(reason.strip(), 200)}"
 27526	              + (f";當時連著 {_esc_clean('、'.join(x[:-3] for x in rec['related']), 300)}" if rec.get("related") else ""))
 27527	        return 0
 27528	    # 表態檔跟筆記庫其他寫入者排同一把鎖(代碼審 r1 併發席;跟治理帳其他寫入者沒共用鎖的整體問題在 Issue 那篇);
 27529	    # 序號在鎖內取現有最大加 1
 27530	    with _vault_write_lock(env.vault):
 27531	        rec["seq"] = _drift_next_seq(root, _DRIFT_ACKS)
 27532	        rc = _drift_ledger_append(root, _DRIFT_ACKS, rec)
 27533	    if rc != 0:
 27534	        return rc
 27535	    _gate_event_or_warn(root, "drift-check", "acked", f"{rel}:{line} {kind}:{reason.strip()[:80]}")
 27536	    print(f"✓ 表態記下了({token}):{_esc_clean(rel, 200)} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]})"
 27537	          + (f";當時連著 {_esc_clean('、'.join(x[:-3] for x in rec['related']), 300)}" if rec.get("related") else ""))
 27538	    print(f"推送前的檢查只認提交進去的表態檔:\n    git add {_DRIFT_ACKS} && git commit")
 27539	    return 0
