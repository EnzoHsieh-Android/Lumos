   156	    def py(self, sha):
   157	        """回 dict 或 None(剖不動)。defs=ast.walk 抓到的 def/class + 模組層/類別層指派名;
   158	        consts=模組層大寫常數→正規化值;flags=add_argument 的 --旗標;idents=程式裡出現過的所有識別字
   159	        (名稱、屬性、參數、字串內容切詞)——給「終點存不存在」用。"""
   160	        if sha in self._py:
   161	            return self._py[sha]
   162	        src = self.repo.blob(sha)
   163	        try:
   164	            tree = ast.parse(src)
   165	        except (SyntaxError, ValueError, RecursionError):
   166	            self._py[sha] = None
   167	            self.stats["parse_fail"].add(sha)
   168	            return None
   169	        defs, top, consts, flags, idents, strs = set(), set(), {}, set(), set(), set()
   170	        for node in ast.walk(tree):
   171	            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
   172	                defs.add(node.name)
   173	                idents.add(node.name)
   174	            elif isinstance(node, ast.Name):
   175	                idents.add(node.id)
   176	            elif isinstance(node, ast.Attribute):
   177	                idents.add(node.attr)
   178	            elif isinstance(node, ast.arg):
   179	                idents.add(node.arg)
   180	            elif isinstance(node, ast.keyword) and node.arg:
   181	                idents.add(node.arg)
   182	            elif isinstance(node, ast.alias):
   183	                idents.update(IDENT_RE.findall(node.name))
   184	                if node.asname:
   185	                    idents.add(node.asname)
   186	            elif isinstance(node, ast.Constant) and isinstance(node.value, str):
   187	                s = node.value
   188	                idents.update(IDENT_RE.findall(s))
   189	                strs.update(FLAG_RE.findall(s))
   190	                if s.startswith("--"):
   191	                    strs.add(s.split("=")[0])
   192	            if isinstance(node, ast.Call):
   193	                f = node.func
   194	                fname = f.attr if isinstance(f, ast.Attribute) else (f.id if isinstance(f, ast.Name) else "")
   195	                if fname == "add_argument":
   196	                    for a in node.args:
   197	                        if isinstance(a, ast.Constant) and isinstance(a.value, str) and a.value.startswith("--"):
   198	                            flags.add(a.value)
   199	
   200	        def _assigns(body, module):
   201	            for st in body:
   202	                tgts = []
   203	                if isinstance(st, ast.Assign):
   204	                    tgts = [t for t in st.targets]
   205	                    val = st.value
   206	                elif isinstance(st, ast.AnnAssign):
   207	                    tgts = [st.target]
   208	                    val = st.value
   209	                for t in tgts:
   210	                    for n in ([t] if isinstance(t, ast.Name) else [e for e in getattr(t, "elts", []) if isinstance(e, ast.Name)]):
   211	                        defs.add(n.id)
   212	                        if module and n.id.isupper() and val is not None:
   213	                            consts[n.id] = _norm_const(val)
   214	                if isinstance(st, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and module:
   215	                    top.add(st.name)
   216	                if isinstance(st, ast.ClassDef):
   217	                    for s2 in st.body:
   218	                        if isinstance(s2, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
   219	                            top.add(s2.name)
   220	                    _assigns(st.body, False)
   221	                if isinstance(st, (ast.If, ast.Try)) and module:
   222	                    for blk in ([st.body, st.orelse] + ([h.body for h in st.handlers] + [st.finalbody] if isinstance(st, ast.Try) else [])):
   223	                        _assigns(blk, True)
   224	        _assigns(tree.body, True)
   225	        # 只在條件式/巢狀位置定義的 def(r1 邊界 F8 問的盲點):頂層與類別內抽法會漏掉的量
   226	        info = {"defs": defs, "top": top, "consts": consts, "flags": flags,
   227	                "idents": idents, "strflags": strs}
   228	        self._py[sha] = info
   229	        return info
