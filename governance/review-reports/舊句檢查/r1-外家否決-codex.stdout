 27660	def _drift_print_hints(rows, stream, head="改法:"):
 27661	    """一批發現的改法指令;c1 一篇一條(改一次整篇的預告句都改掉)。"""
 27662	    seen, out = set(), []
 27663	    for f in rows:
 27664	        k = (f["kind"], f["path"]) if f["kind"] == "c1" else (f["kind"], f["path"], f["line"])
 27665	        if k in seen:
 27666	            continue
 27667	        seen.add(k)
 27668	        out += _drift_fix_hint(f["kind"], f["path"], f["line"])
 27669	    if out:
 27670	        print(head, file=stream)
 27671	        for x in out[:20]:
 27672	            print(f"    {_esc_clean(x, 300)}", file=stream)
 27673	        if len(out) > 20:
 27674	            print(f"    …還有 {len(out) - 20} 條(lumos drift scan 看全部)", file=stream)
