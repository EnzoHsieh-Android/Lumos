   247	def _norm_const(v):
   248	    """常數值:字面量正規化字串;清單/tuple 另記長度;運算式標 expr(r1 邊界 F7)。"""
   249	    try:
   250	        lit = ast.literal_eval(v)
   251	        n = len(lit) if isinstance(lit, (list, tuple, set, frozenset, dict)) else None
   252	        return ("lit", repr(lit), n)
   253	    except Exception:
   254	        n = len(v.elts) if isinstance(v, (ast.Tuple, ast.List, ast.Set)) else None
   255	        return ("expr", ast.unparse(v) if hasattr(ast, "unparse") else "", n)
