 26790	def _drift_py_names(txt):
 26791	    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
 26792	    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
 26793	    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。"""
 26794	    import ast as _ast
 26795	    try:
 26796	        tree = _ast.parse(txt)
 26797	    except (SyntaxError, ValueError, MemoryError, RecursionError):
 26798	        # 巢狀很深的合法檔,CPython 的解析器丟 MemoryError(「too complex to parse」)而不是 SyntaxError,
 26799	        # 原本沒接住,整支 scan 與推送檢查當掉(代碼審 r2 邊界席)。3.12 以前的解析器碰到極長運算式會直接 SIGSEGV、
 26800	        # 接不到;工具最低版本改成 3.14 之後,原本為它加的事先量測已刪([[Projects/最低Python版本改3.14_計劃]])
 26801	        return None
 26802	    funcs, classes, assigns = set(), set(), set()
 26803	    for node in _ast.walk(tree):
 26804	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
 26805	            funcs.add(node.name)
 26806	        elif isinstance(node, _ast.ClassDef):
 26807	            classes.add(node.name)
 26808	    for node in tree.body:
 26809	        if isinstance(node, _ast.Assign):
 26810	            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
 26811	        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
 26812	            assigns.add(node.target.id)
 26813	    return funcs, classes, assigns
 26814	
