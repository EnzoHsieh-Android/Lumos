 27542	def _drift_current_finding(env2, rel, line, kind):
 27543	    """env2 是呼叫端剛新建的圖譜物件(Env(vault)):算那一篇當下的發現,第 line 行要真的是 kind → (發現, 錯誤)。
 27544	    drift ack 的 c2/c3 與 drift fix 共用。"""
 27545	    for f in _drift_state_findings(env2, only={rel}):
 27546	        if f["kind"] == kind and f["line"] == line:
 27547	            return f, None
 27548	    return None, (f"{rel} 第 {line} 行現在不是 {kind}({_DRIFT_KIND_NAMES.get(kind, kind)}):可能已經被修掉,"
 27549	                  "重跑 lumos drift scan 看最新清單")
