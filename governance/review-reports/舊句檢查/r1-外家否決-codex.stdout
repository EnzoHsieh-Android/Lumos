 27404	def _drift_split_acked(findings, acks, vault_rel):
 27405	    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。
 27406	    ★c2、c3 另外要綁當時的關係★(存量漂移改法 [S8]):只看記了 related 的表態,取 seq 最大的那幾筆(同號全算),
 27407	    全部都涵蓋現在的已收尾計劃清單才算已表態;沒記 related 的舊表態、seq 不是正整數的(手改壞了)都不算數
 27408	    (不然會永久豁免之後才收尾的計劃;壞序號原本被當成 0 號照樣生效,代碼審 r1 外家席)。
 27409	    沒涵蓋但以前表態過的,沒表態那一邊的發現多帶 prev_ack(最近一次當時連著哪幾篇、理由),印的時候講出來。"""
 27410	    keys, bound = set(), {}
 27411	    for a in acks:
 27412	        k = _drift_ack_key(a["path"], a.get("text", ""), a["kind"])
 27413	        if a["kind"] in _DRIFT_BOUND_KINDS:
 27414	            if "related" in a and _drift_seq_ok(a):
 27415	                bound.setdefault(k, []).append(a)
 27416	        else:
 27417	            keys.add(k)
 27418	    pre = vault_rel.rstrip("/") + "/"
 27419	    left, done = [], []
 27420	    for f in findings:
 27421	        k = _drift_ack_key(pre + f["path"], f["text"], f["kind"])
 27422	        if f["kind"] not in _DRIFT_BOUND_KINDS:
 27423	            (done if k in keys else left).append(f)
 27424	            continue
 27425	        top = _drift_bound_latest(bound.get(k, []))
 27426	        cur = {nfc(str(x)) for x in f.get("related", [])}
 27427	        if top and all(_drift_related_ok(a) and cur <= {nfc(x) for x in a["related"]} for a in top):
 27428	            done.append(f)
 27429	        elif top:
 27430	            left.append(dict(f, prev_ack={"related": top[-1].get("related"), "reason": top[-1].get("reason")}))
 27431	        else:
 27432	            left.append(f)
 27433	    return left, done
 27434	
