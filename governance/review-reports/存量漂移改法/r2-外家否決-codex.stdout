 26319	
 26320	# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
 26321	# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
 26322	#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
 26323	# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
 26324	_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
 26325	_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
 26326	_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
 26327	_PROBE_KEYS = ("file", "symbol", "test", "status")
 26328	_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")
 26329	
 26330	
 26331	def _revisit_split(line):
 26332	    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
 26333	    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
 26334	    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
 26335	    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
 26336	    import datetime
 26337	    if line.lstrip().startswith("|"):
 26338	        return None, None
 26339	    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
 26340	    if not s.startswith("REVISIT:"):
 26341	        return None, None
 26342	    rest = s[len("REVISIT:"):]
 26343	    if rest.lstrip().startswith("[when-"):
 26344	        return "cond", rest
 26345	    try:
 26346	        datetime.date.fromisoformat(rest.partition(" ")[0])
 26347	        return "date", rest
 26348	    except ValueError:
 26349	        return "bad", rest
 26350	
 26351	
 26352	def _probe_value_err(k, v):
 26353	    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
 26354	    if k not in _PROBE_KEYS:
 26355	        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
 26356	    if not v:
 26357	        return f"when-{k} 的值是空的"
 26358	
 26359	    if k == "file":
 26360	        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
 26361	    if k in ("symbol", "test"):
 26362	        return _probe_named_err(k, v)
 26363	    node, eq, vals = v.partition("=")
 26364	    if not eq or not node.strip() or not vals.strip():
 26365	        return "when-status 要寫成 <節點>=<值>"
 26366	    if any(not x.strip() for x in vals.split("|")):
 26367	        return "when-status 的值用 | 分開時每一段都不能空"
 26368	    return None
 26369	
 26370	
 26371	def _probe_norm_value(k, v):
 26372	    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
 26373	    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
 26374	    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
 26375	    if k == "file":
 26376	        return nfc(_posix_norm(v))
 26377	    if k in ("symbol", "test") and "::" in v:
 26378	        path, name = v.rsplit("::", 1)
 26379	        return nfc(_posix_norm(path)) + "::" + name.strip()
 26380	    return v
 26381	
 26382	
 26383	def _probe_bad_path(p):
 26384	    return (not p) or p == "." or p.startswith("/") or ".." in p.split("/")
 26385	
 26386	
 26387	def _probe_named_err(k, v):
 26388	    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
 26389	    if "::" not in v:
 26390	        return None
 26391	    path, name = v.rsplit("::", 1)
 26392	    if not name.strip():
 26393	        return f"when-{k} 的名稱是空的"
 26394	    if _probe_bad_path(path.strip()):
 26395	        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
 26396	    return None
 26397	
 26398	
 26399	def _probe_parse(rest):
 26400	    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
 26401	    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
 26402	    import datetime
 26403	    conds, by, errs, pos, bad = [], None, [], 0, False
 26404	    while True:
 26405	        m = _PROBE_TOKEN_RE.match(rest, pos)
 26406	        if not m:
 26407	            break
 26408	        pos = m.end()
 26409	        key, val = m.group(1), m.group(2).strip()
 26410	        if key == "by":
 26411	            if by is not None:
 26412	                errs.append("期限寫了兩個")
 26413	                continue
 26414	            try:
 26415	                datetime.date.fromisoformat(val)
 26416	                by = val
 26417	            except ValueError:
 26418	                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
 26419	            continue
 26420	        k = key[len("when-"):]
 26421	        # 反斜線先轉斜線再驗(代碼審 r3 正確性席:`a\..\x.py` 原本收成 x.py 過關,字面相同的 `a/../x.py` 卻被擋)
 26422	        err = _probe_value_err(k, val.replace("\\", "/") if k in ("file", "symbol", "test") else val)
 26423	        nv = val if err else _probe_norm_value(k, val)
 26424	        # 正規化之後再驗一次(代碼審 r2 正確性席、邊界席:`..\x.py` 原文用 / 切不出 .. 段,轉成斜線才是 ../x.py,
 26425	        # 原本第一層放行、check 與 scan 又默默丟掉,變成沒人看得到的死條件)
 26426	        err = err or _probe_value_err(k, nv)
 26427	        if err:
 26428	            errs.append(err)
 26429	            bad = True
 26430	        conds.append((k, val if err else nv))

