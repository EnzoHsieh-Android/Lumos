 14432	def fmt_scalar(key, value):
 14433	    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
 14434	    v = value.strip()
 14435	    if key in DATE_KEYS:
 14436	        if not DATE_RE.match(v):
 14437	            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
 14438	        return v  # bare,絕不加引號
 14439	    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
 14440	    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
 14441	    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)
