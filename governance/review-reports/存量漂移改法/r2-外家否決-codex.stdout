 26078	def _drift_state_findings(env, only=None):
 26079	    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
 26080	    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
 26081	    only=要算的路徑集合(None=全部)。"""
 26082	    out = []
 26083	    ti = build_typed_index(env)
 26084	    for rel, n in sorted(env.notes.items()):
 26085	        if only is not None and rel not in only:
 26086	            continue
 26087	        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
 26088	        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
 26089	            out += _drift_guard_findings(env, rel, n, st)
 26090	        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
 26091	            out += _drift_c2(env, rel)
 26092	        if ty == "verification":
 26093	            plans = _drift_c3_hit(env, rel, ti=ti)
 26094	            if plans:
 26095	                text = env_text(env, rel) or ""
 26096	                ln = _drift_field_line(text, "status")
 26097	                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
 26098	                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
 26099	        vu = n.fields.get("valid_under")
 26100	        vtxt = " ".join(as_list(vu)) if vu else ""
 26101	        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
 26102	            text = env_text(env, rel) or ""
 26103	            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
 26104	            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
 26105	                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
 26106	    return out
 26107	
 26108	
 26109	def _drift_c2(env, rel):
 26110	    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
 26111	             if _drift_str(env.notes.get(p), "type") == "project"
 26112	             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
 26113	    if not plans:
 26114	        return []
 26115	    text = env_text(env, rel) or ""
 26116	    ln = _drift_field_line(text, "status")
 26117	    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
 26118	    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
 26119	             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]
 26120	
 26121	
 26122	def _drift_guard_findings(env, rel, n, st):
 26123	    """守衛紀錄的 c1(轉正了還寫預告,一句一筆)與 c5(轉正做了一半)。"""
 26124	    text = env_text(env, rel)
 26125	    if text is None:
 26126	        return []
 26127	    out = []
 26128	    lines = text.split("\n")
 26129	    if st == "pass":
 26130	        regs = _notelines_regions(text)
 26131	        for i, ln in enumerate(lines):
 26132	            k = _guard_planned_prose(ln, regs[i])
 26133	            if k:
 26134	                out.append({"kind": "c1", "path": rel, "line": i + 1, "text": ln.strip(), "related": [],
 26135	                            "why": "已轉正(status: pass)但還留著預告句"})
 26136	    elif st == "pending":
 26137	        m = re.search(r"^預告的合約:(.+)$", text, re.M)
 26138	        home = env.resolve(link_target(_guard_home_of_fields(n.fields))) if _guard_home_of_fields(n.fields) else None
 26139	        htext = env_text(env, home) if home else None
 26140	        if m and htext is not None:
 26141	            hl = htext.split("\n")
 26142	            if _guard_formal_line(hl, _drift_fm_end(hl), m.group(1).strip(), None) is not None:
 26143	                ln = _drift_field_line(text, "status")
 26144	                out.append({"kind": "c5", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [home],
 26145	                            "why": f"家筆記 {home[:-3]} 已經是正式合約行——重跑 lumos guard settle 補完"})
 26146	    return out
 26147	
