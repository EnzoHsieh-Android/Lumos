 25997	def _drift_fm_end(lines):
 25998	    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
 25999	    if not lines or lines[0].strip() != "---":
 26000	        return 0
 26001	    for i in range(1, len(lines)):
 26002	        if lines[i].strip() == "---":
 26003	            return i
 26004	    return 0
 26005	
 26006	
 26007	def _drift_field_line(text, key, pred=None):
 26008	    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
 26009	    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
 26010	    lines = text.split("\n")
 26011	    e = _drift_fm_end(lines)
 26012	    for i in range(1, e):
 26013	        m = TOP_KEY_RE.match(lines[i])
 26014	        if not (m and m.group(1) == key):
 26015	            continue
 26016	        if pred is None:
 26017	            return i + 1
 26018	        for j in range(i, e):
 26019	            if j > i and TOP_KEY_RE.match(lines[j]):
 26020	                break
 26021	            if pred(lines[j]):
 26022	                return j + 1
 26023	        return i + 1
 26024	    return 1
 26025	
