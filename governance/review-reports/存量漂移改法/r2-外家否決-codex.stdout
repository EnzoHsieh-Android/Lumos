 14470	def edit_fm_sync_status_tag(fm_lines, status):
 14471	    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
 14472	    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
 14473	    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
 14474	    fm = list(fm_lines)
 14475	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14476	    if "tags" not in struct or struct["tags"][2] != "list":
 14477	        return fm, False
 14478	    s, e, _kind = struct["tags"]
 14479	    found = False
 14480	    for i in range(s + 1, e + 1):
 14481	        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
 14482	        if m:
 14483	            fm[i] = f"{m.group(1)}status/{status}"
 14484	            found = True
 14485	    return fm, found
