 14571	def edit_fm_remove(fm_lines, key, value):
 14572	    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。
 14573	
 14574	    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
 14575	    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
 14576	    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
 14577	    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
 14578	    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
 14579	    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
 14580	    fm = list(fm_lines)
 14581	    tgt = link_target(value)
 14582	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14583	    if key not in struct:
 14584	        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
 14585	    if struct[key][2] == "scalar" and key in LIST_KEYS:
 14586	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14587	        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14588	    s, e, kind = struct[key]
 14589	    if kind != "list":
 14590	        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
 14591	    hits = []
 14592	    for j in range(s + 1, e + 1):
 14593	        existing = fm[j].strip()
 14594	        if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14595	            hits.append(j)
 14596	    if not hits:
 14597	        return fm, 0
 14598	    for j in reversed(hits):
 14599	        del fm[j]
 14600	    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
 14601	    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14602	    if key in struct2:
 14603	        s2, e2, _ = struct2[key]
 14604	        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
 14605	            del fm[s2:e2 + 1]
 14606	    return fm, len(hits)
