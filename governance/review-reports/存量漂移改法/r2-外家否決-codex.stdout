 26067	def _drift_linked(env, rel):
 26068	    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
 26069	    out_e, in_e = env.edges
 26070	    got = {}
 26071	    for d in out_e.get(rel, []):
 26072	        got[d] = "out"
 26073	    for s in in_e.get(rel, []):
 26074	        got[s] = "both" if s in got else "in"
 26075	    return got
