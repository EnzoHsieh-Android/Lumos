 26331	def _revisit_split(line):
 26332	    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
 26333	    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
 26334	    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
 26335	    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
 26336	    import datetime
 26337	    if line.lstrip().startswith("|"):
 26338	        return None, None
 26339	    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
 26340	    if not s.startswith("REVISIT:"):
 26341	        return None, None
 26342	    rest = s[len("REVISIT:"):]
 26343	    if rest.lstrip().startswith("[when-"):
 26344	        return "cond", rest
 26345	    try:
 26346	        datetime.date.fromisoformat(rest.partition(" ")[0])
 26347	        return "date", rest
 26348	    except ValueError:
 26349	        return "bad", rest
