 25992	def _drift_str(n, key):
 25993	    v = n.fields.get(key, "") if n is not None else ""
 25994	    return v.strip() if isinstance(v, str) else ""
 25995	
 25996	
 25997	def _drift_fm_end(lines):
 25998	    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
 25999	    if not lines or lines[0].strip() != "---":
 26000	        return 0
 26001	    for i in range(1, len(lines)):
 26002	        if lines[i].strip() == "---":
 26003	            return i
 26004	    return 0
 26005	
 26006	
 26007	def _drift_field_line(text, key, pred=None):
 26008	    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
 26009	    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
 26010	    lines = text.split("\n")
 26011	    e = _drift_fm_end(lines)
 26012	    for i in range(1, e):
 26013	        m = TOP_KEY_RE.match(lines[i])
 26014	        if not (m and m.group(1) == key):
 26015	            continue
 26016	        if pred is None:
 26017	            return i + 1
 26018	        for j in range(i, e):
 26019	            if j > i and TOP_KEY_RE.match(lines[j]):
 26020	                break
 26021	            if pred(lines[j]):
 26022	                return j + 1
 26023	        return i + 1
 26024	    return 1
 26025	
 26026	
 26027	def _drift_line_text(text, ln):
 26028	    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
 26029	    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
 26030	    lines = text.split("\n")
 26031	    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""
 26032	
 26033	
 26034	def _drift_c3_hit(env, vrel, override=None, ti=None):
 26035	    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
 26036	    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
 26037	    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
 26038	    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
 26039	    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
 26040	    n = env.notes.get(vrel)
 26041	    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
 26042	        return None
 26043	    if GUARD_MARK_FIELD in n.fields:
 26044	        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
 26045	    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
 26046	    if not refs:
 26047	        return None
 26048	    ti = ti if ti is not None else build_typed_index(env)
 26049	    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
 26050	    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
 26051	    if any(not link_target(x) for x in refs) \
 26052	            or any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
 26053	            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
 26054	        return None
 26055	    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
 26056	    if not plans:
 26057	        return None
 26058	    for prel in plans:
 26059	        pn = env.notes.get(prel)
 26060	        if pn is None or _drift_str(pn, "type") != "project":
 26061	            return None
 26062	        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
 26063	            return None
 26064	    return plans
 26065	
