   525	
   526	def load_vault(vault: Path):
   527	    notes = {}
   528	    for p in sorted(vault.rglob("*.md")):
   529	        rel = nfc(p.relative_to(vault).as_posix())
   530	        try:
   531	            mtime = p.stat().st_mtime
   532	            text = p.read_text(encoding="utf-8-sig")  # -sig: BOM 檔也偵測得到 frontmatter
   533	        except Exception as e:
   534	            n = Note()
   535	            n.rel, n.stem = rel, nfc(p.stem)
   536	            n.fields, n.block_keys, n.fm_lines = {}, set(), []
   537	            n.targets, n.lint, n.mtime = [], [f"{_READ_FAIL}: {e}"], 0
   538	            notes[rel] = n
   539	            continue
