 14530	def edit_fm_append(fm_lines, key, value):
 14531	    fm = list(fm_lines)
 14532	    item = fmt_list_item(value)
 14533	    tgt = link_target(value)
 14534	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14535	    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
 14536	        cur = _list_scalar_value(fm, key, struct[key][0])
 14537	        if cur and link_target(cur) == tgt:
 14538	            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
 14539	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14540	        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14541	    if key in struct:
 14542	        s, e, kind = struct[key]
 14543	        if kind != "list":
 14544	            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
 14545	        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
 14546	        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
 14547	            fm[s] = f"{key}:"
 14548	        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
 14549	        for j in range(s + 1, e + 1):
 14550	            existing = fm[j].strip()
 14551	            if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14552	                return fm  # 已存在,no-op
 14553	        # 偵測現有項縮排,否則預設 2 空格
 14554	        indent = "  "
 14555	        for j in range(s + 1, e + 1):
 14556	            if fm[j].lstrip().startswith("-"):
 14557	                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
 14558	                break
 14559	        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
 14560	        last = e
 14561	        while last > s and not fm[last].strip():
 14562	            last -= 1
 14563	        fm.insert(last + 1, f"{indent}- {item}")
 14564	    else:
 14565	        ins = len(fm)
 14566	        fm.insert(ins, key + ":")
 14567	        fm.insert(ins + 1, f"  - {item}")
 14568	    return fm
