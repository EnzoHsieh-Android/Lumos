 14445	    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
 14446	    v = value.strip()
 14447	    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")
