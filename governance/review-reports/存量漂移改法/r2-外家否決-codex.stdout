 12042	def _guard_formal_line(lines, e, claim, method=None, plat=None):
 12043	    """家筆記的摘要裡有沒有這條合約的正式行 → 行索引或 None:剝掉合約標記家族(INV_TAG_RE:test/audit/kill/src/git/manual/keeps)
 12044	    之後文字相同,而且綁的測試(invariant_test_refs,逗號清單拆開比完整名)含這支方法(method=None 時有綁任一支就算)。
 12045	    ★比對全用 guard 家族既有那兩支★(代碼審 r3 架構對齊席、正確性席:前兩輪自己寫行尾正規式,連續兩輪被抓到——
 12046	    剝全部 [鍵:值] 會把原文自帶的標籤剝掉、只認 test/audit/kill 又漏了 src/git,[test:a,b] 用子字串比也對不上);
 12047	    只看摘要(代碼審 r1 外家席:其他開頭欄位裡的同一句會被誤認成正式行)。"""
 12048	    want = INV_TAG_RE.sub("", claim).strip()
 12049	    regs = _notelines_regions("\n".join(lines))
 12050	    for i in range(1, e):
 12051	        if i < len(regs) and regs[i] != "summary":
 12052	            continue
 12053	        m = INVARIANT_RE.match(lines[i].strip())
 12054	        if not m or INV_TAG_RE.sub("", m.group(1)).strip() != want:
 12055	            continue
 12056	        refs = invariant_test_refs(m.group(1))
 12057	        if method is None:
 12058	            if refs:
 12059	                return i
 12060	            continue
 12061	        # 帶平台前綴的綁定照 resolve_test_refs 解(plat=(split, default),load_platforms 那一套):前綴是專案定義過的平台
 12062	        # 才拆,沒定義就不猜(代碼審 r4 架構對齊席);沒給 plat 時只認完全相同的名字(代碼審 r5 正確性席:多平台專案
 12063	        # 綁成 [test:ios:t_x] 時,只比完全相同會擋下又指到一條走不出去的路)
 12064	        names = set(refs)
 12065	        if plat is not None:
 12066	            try:
 12067	                names = {mm for _pl, mm in resolve_test_refs(m.group(1), plat[0], plat[1])}
 12068	            except ValueError:
 12069	                names = set()
 12070	        if method in names:
 12071	            return i
 12072	    return None
