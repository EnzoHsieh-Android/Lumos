 14721	def _vault_lock_where(vault):
 14722	    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。
 14723	
 14724	    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
 14725	    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
 14726	    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。
 14727	
 14728	    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
 14729	    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
 14730	    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
 14731	    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
 14732	    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
 14733	    互斥照樣成立。
 14734	
 14735	    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
 14736	    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
 14737	    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
 14738	    """
 14739	    import hashlib
 14740	    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
 14741	    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
 14742	    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
 14743	    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
 14744	    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
 14745	        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
 14746	    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
 14747	        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
 14748	    return primary, None
