 51020	def t_drift_unknown_blocks_check_not_scan():
 51021	    """[S2] check 判不了(git 算不出範圍事件)→ 算要處理、印原因(block 模式 rc1)。
 51022	
 51023	    乙那一半:條件指到的程式檔讀不出來 → check 擋、scan 列判不了且不寫帳。
 51024	
 51025	    翻紅釘:判不了改成放行 → ①②紅;scan 把判不了當不成立 → ③紅。
 51026	    """
 51027	    print("t_drift_unknown_blocks_check_not_scan")
 51028	    import contextlib, io
 51029	    m = _load_lumos_inproc()
 51030	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 51031	    base = _na_head(root)
 51032	    _nh_node(root, "Pay", summary="FLOW:b")
 51033	    _nh_commit(root, "c")
 51034	    orig = m._drift_range_events
 51035	    m._drift_range_events = lambda *a, **k: None
 51036	    err = io.StringIO()
 51037	    try:
 51038	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
 51039	            rc = m.cmd_drift_check(repo=str(root), diff_range=f"{base}..HEAD")
 51040	    finally:
 51041	        m._drift_range_events = orig
 51042	    check("①判不了:算要處理、rc1、印原因", rc == 1 and "判不了" in err.getvalue(), err.getvalue())
 51043	    # 乙那一半(圖譜一致 F3:原本只測甲的路徑):讀不出條件指到的程式檔 → check 擋、scan 列判不了且不寫帳
 51044	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 51045	    base = _na_head(root)
 51046	    _nh_file(root, "src/runner.py", "def start_up():\n    pass\n")
 51047	    _nh_node(root, "Pay", summary="FLOW:a", body="REVISIT:[when-symbol:src/runner.py::start_up][by:2099-12-31] 補測試")
 51048	    _nh_commit(root, "c")
 51049	    tip = _na_head(root)
 51050	    orig_cat, orig_ev = m._nodehome_cat_blobs, m._gate_event_or_warn
 51051	    events = []
 51052	    # 讀程式檔改用內容編號(乙代碼審 r3),所以認的是 runner.py 的內容編號,不是路徑
 51053	    runner = _nh_git(root, "rev-parse", "HEAD:src/runner.py").stdout.strip()
 51054	    m._nodehome_cat_blobs = lambda r, specs, **k: None if any(x == runner or "runner.py" in x for x in specs) \
 51055	        else orig_cat(r, specs, **k)
 51056	    m._gate_event_or_warn = lambda *a, **k: events.append(a)
 51057	    err, out = io.StringIO(), io.StringIO()
 51058	    try:
 51059	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
 51060	            rc = m.cmd_drift_check(repo=str(root), diff_range=f"{base}..HEAD")
 51061	        n_check = len(events)
 51062	        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
 51063	            rs = m.cmd_drift_scan(m.Env(root / "docs" / "kg-knowledge"), at=tip, as_json=True)
 51064	    finally:
 51065	        m._nodehome_cat_blobs, m._gate_event_or_warn = orig_cat, orig_ev
 51066	    check("②乙的條件判不了:check 算要處理、rc1、指到那一行", rc == 1 and "判不了" in err.getvalue()
 51067	          and "Systems/Pay.md" in err.getvalue(), err.getvalue())
 51068	    import json as _j
 51069	    probs = [x["why"] for x in _j.loads(out.getvalue() or "{}").get("problems", [])]
 51070	    check("③乙的條件判不了:scan 列成判不了、rc0、不寫帳", rs == 0 and any("判不了" in w for w in probs)
 51071	          and len(events) == n_check, str(probs) + str(events))
 51072	
 51073	
 51074	def t_drift_exam_scores():
 51075	    """[S13](甲的部分)exam 依考法算擋到/點到/漏/誤列,status_replay 照 status_targets 改狀態,用 note_at_event 比對,
 51076	    略過機制①並印幾題、不認得的考法回 2,不寫任何帳或檔。
 51077	
 51078	    翻紅釘:status_replay 不套 status_targets → ②E 題漏;note_at_event 不用 → ①A 題漏。
 51079	    """
 51080	    print("t_drift_exam_scores")
 51081	    import json as _j
 51082	    root = _dr_repo()
 51083	    vault = root / _DR_VAULT
 51084	    (vault / "Issues").mkdir(exist_ok=True)
 51085	    (vault / "Verification" / "長檔名守衛.md").write_text(_dr_guard_text("pending"), encoding="utf-8")
 51086	    _nh_file(root, f"{_DR_VAULT}/Issues/I.md", "---\ntype: issue\nstatus: open\n---\n# I\n[[Projects/退款_計劃]]\n")
 51087	    _nh_file(root, f"{_DR_VAULT}/Issues/OK.md", "---\ntype: issue\nstatus: open\n---\n# OK\n")
 51088	    _nh_commit(root, "base")
 51089	    g = vault / "Verification" / "長檔名守衛.md"
 51090	    g.write_text(g.read_text(encoding="utf-8").replace("status: pending", "status: pass"), encoding="utf-8")
 51091	    _nh_commit(root, "轉正")
 51092	    ev_commit = _na_head(root)
 51093	    tline = [i + 1 for i, l in enumerate(g.read_text(encoding="utf-8").split("\n")) if "TEST:還沒有" in l][0]
 51094	    _nh_git(root, "mv", f"{_DR_VAULT}/Verification/長檔名守衛.md", f"{_DR_VAULT}/Verification/短名.md")
 51095	    _nh_commit(root, "改短名")
 51096	    p = vault / "Projects" / "退款_計劃.md"
 51097	    p.write_text(p.read_text(encoding="utf-8").replace("status: doing", "status: done"), encoding="utf-8")
 51098	    _nh_commit(root, "收尾")
 51099	    close_commit = _na_head(root)
 51100	    gov = vault.parent / ".governance-log.jsonl"
 51101	    gov_before = gov.read_text(encoding="utf-8") if gov.exists() else ""
 51102	    exam = [
 51103	        {"id": "A", "exam_event": "commit", "note": "Verification/短名.md", "note_at_event": "Verification/長檔名守衛.md",
 51104	         "line": tline, "invalidating_commits": [ev_commit]},
 51105	        {"id": "E", "exam_event": "status_replay", "note": "Issues/I.md", "line": 3,
 51106	         "invalidating_commits": [close_commit], "status_targets": ["Projects/退款_計劃"]},
 51107	        # 只有記憶體重放抓得到:這個提交本身沒收尾計劃,真實範圍的 check 列不到 I(翻紅釘:不套 status_targets → 漏)
 51108	        {"id": "E2", "exam_event": "status_replay", "note": "Issues/I.md", "line": 3,
 51109	         "invalidating_commits": [ev_commit], "status_targets": ["Projects/退款_計劃"]},
 51110	        {"id": "N", "exam_event": "current_state", "note": "Issues/OK.md", "line": 3},
 51111	        {"id": "M", "exam_event": "mechanism1_experiment", "note": "x", "line": 1},
 51112	    ]
 51113	    ef = root / "exam.json"
 51114	    ef.write_text(_j.dumps(exam, ensure_ascii=False), encoding="utf-8")
 51115	    import subprocess as sp
 51116	    r = sp.run([sys.executable, GRAPHCTL, "drift", "exam", str(ef), "--repo", str(root), "--json"], capture_output=True, text=True)
 51117	    try:
 51118	        d = _j.loads(r.stdout)
 51119	    except ValueError:
 51120	        d = {}
 51121	    res = {x["id"]: x["result"] for x in d.get("rows", [])}
 51122	    check("①commit 題用 note_at_event 比對:擋到", res.get("A") == "擋到", r.stdout + r.stderr)
 51123	    check("②status_replay 照 status_targets:點到(含只有重放才抓得到的那題)",
 51124	          res.get("E") == "點到" and res.get("E2") == "點到", str(res))
 51125	    check("③current_state 非漂移題:沒誤列", res.get("N") == "沒誤列", str(res))
 51126	    check("④機制①略過並計數", d.get("skipped_mechanism1") == 1 and "M" not in res, str(d)[:300])
 51127	    check("⑤不寫治理帳", (gov.read_text(encoding="utf-8") if gov.exists() else "") == gov_before, "")
 51128	    ef.write_text(_j.dumps(exam + [{"id": "X", "exam_event": "亂寫", "note": "x", "line": 1}], ensure_ascii=False), encoding="utf-8")
 51129	    r2 = sp.run([sys.executable, GRAPHCTL, "drift", "exam", str(ef), "--repo", str(root)], capture_output=True, text=True)
 51130	    check("⑥不認得的考法回 2", r2.returncode == 2, r2.stdout + r2.stderr)

