 14510	def _list_key_scalar_to_list(fm, key, line_idx):
 14511	    """清單欄位被寫成單一值(`about_code: src/x.py`)時,改寫成一項的清單再給 append/remove 用。
 14512	
 14513	    ★讀的一側本來就把單一值當成一項的清單★(as_list),只有寫的一側不認得——
 14514	    於是一篇筆記一旦是單一值寫法,append 說它不是清單、set 又不收清單欄位,
 14515	    沒有任何指令改得動(2026-09-10 代碼審 r1)。空值(`key:`)當成空清單;
 14516	    同一行的清單寫法擋下不轉(見 _list_scalar_value)。"""
 14517	    sval = _list_scalar_value(fm, key, line_idx)
 14518	    m = TOP_KEY_RE.match(fm[line_idx])
 14519	    raw = m.group(2).strip() if m else ""
 14520	    fm = list(fm)
 14521	    fm[line_idx] = f"{key}:"
 14522	    if sval:
 14523	        # ★原本那一項原封不動★:有引號就照原樣搬,不去掉再重新加(第三輪外家找洞席:'[[Systems/API "v2"]]'
 14524	        # 被重新加成帶反斜線的雙引號,讀的一側不解反斜線,讀回來就不是原本那篇了)
 14525	        quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
 14526	        fm.insert(line_idx + 1, f"  - {raw if quoted else fmt_list_item(sval)}")
 14527	    return fm
