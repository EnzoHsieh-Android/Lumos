 23371	    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。"""
 23372	    if where is None:
 23373	        return {}, []
 23374	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 23375	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 23376	    if raw is None:
 23377	        return None
 23378	    files, allp = {}, []
 23379	    for ent in raw.split(b"\0"):
 23380	        if not ent or b"\t" not in ent:
 23381	            continue
