 26281	def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None, override_base=None):
 26282	    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
 26283	    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
 26284	    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
 26285	    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
 26286	    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
 26287	    import time as _t
 26288	
 26289	    def _left():
 26290	        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
 26291	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
 26292	    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
 26293	    if tenv is None:
 26294	        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
 26295	    if _left() <= 0:
 26296	        return [], [], [over]
 26297	    reader = _nodehome_reader(root, tip)
 26298	    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
 26299	    if ev is None:
 26300	        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
 26301	    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
 26302	               if _note_unreadable(n) and p in ev["touched"]]
 26303	    must, listed = [], []
 26304	    for f in _drift_state_findings(tenv):
 26305	        p, k = f["path"], f["kind"]
 26306	        if k == "c1":
 26307	            if p in ev["passed"]:
 26308	                must.append(f)
 26309	            continue
 26310	        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
 26311	        if hit:
 26312	            listed.append(f)
 26313	    if _left() <= 0:
 26314	        return must, listed, [*unknown, over]
 26315	    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
 26316	    return must + pm, listed + pl, unknown + pu
