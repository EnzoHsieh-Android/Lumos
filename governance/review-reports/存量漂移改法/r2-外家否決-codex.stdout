 14609	def decisions_items(fm_lines):
 14610	    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
 14611	    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
 14612	    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
 14613	    block = None
 14614	    for k, s, e, kind in fm_structure(fm_lines):
 14615	        if k == "decisions" and kind == "list":
 14616	            block = (s, e)
 14617	            break
 14618	    if block is None:
 14619	        return None
 14620	    s, e = block
 14621	    item_indent = None
 14622	    starts = []
 14623	    for i in range(s + 1, e + 1):
 14624	        ln = fm_lines[i]
 14625	        if not ln.strip():
 14626	            continue
 14627	        m = re.match(r"^(\s*)-\s", ln)
 14628	        if m:
 14629	            ind = len(m.group(1))
 14630	            if item_indent is None:
 14631	                item_indent = ind
 14632	            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
 14633	                starts.append(i)
 14634	    items = []
 14635	    for idx, st in enumerate(starts):
 14636	        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
 14637	        while en > st and not fm_lines[en].strip():
 14638	            en -= 1
 14639	        items.append((st, en))
 14640	    sub_indent = (item_indent + 2) if item_indent is not None else 4
 14641	    return s, e, items, (item_indent or 2), sub_indent
