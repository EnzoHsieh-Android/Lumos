 27176	def _drift_print_findings(rows, stream, acks=None, alive=None):
 27177	    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
 27178	    for f in rows[:20]:
 27179	        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
 27180	              file=stream)
 27181	        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
 27182	        old = _drift_old_reason(f, acks, alive) if acks else None
 27183	        if old:
 27184	            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
 27185	    if len(rows) > 20:
 27186	        print(f"  …還有 {len(rows) - 20} 筆", file=stream)
