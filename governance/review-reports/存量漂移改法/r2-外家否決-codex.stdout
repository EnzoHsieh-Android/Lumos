  4872	    """Check J(regen 重生來源守衛)共用檢查器——cmd_lint 與 run_doctor 同呼叫同一函式(防兩入口
  4873	    規則漂移)。只對 frontmatter 帶 regen 的節點生效;非 regen 節點回三空。只掃 summary 行。
  4874	    回 (errs, warns, gov_events),兩入口映射(spec 映射表,照抄不猜):
  4875	      errs → lint errs 計 rc1 / doctor warn(hard) 計 issues
  4876	      warns → lint 顯示不計 rc / doctor warn_soft(J-d 提醒與 shallow 降級兩入口皆非阻擋)
  4877	      gov_events → 僅 doctor --ci 落 _append_governance_log;lint 高頻一律不落帳(防治理帳灌水)
  4878	    註:本函式為 regen 節點對 lint「node-local 不掃 repo」原則的 opt-in 例外(檔案+git 存取)。
  4879	    設計:Projects/from-scratch重生守衛_計劃;golden: governance/golden/fromscratch-m1。"""
  4880	    errs, warns, gov = [], [], []
  4881	    regen = note.fields.get("regen")
  4882	    if not (isinstance(regen, str) and regen.strip()):
  4883	        return errs, warns, gov
  4884	    summ = note.fields.get("summary")
  4885	    summ = summ if isinstance(summ, str) else ""
  4886	    shallow = None  # 惰性判定(每節點至多一次 rev-parse)
  4887	    untagged_keys = 0
  4888	    has_git_ptr = "[git:" in summ  # presence-guard:整節點無 [git: 子串即不 spawn
  4889	    for raw in summ.split("\n"):
  4890	        line = raw.strip()
  4891	        if not line:
  4892	            continue
  4893	        has_src = SRC_REF_RE.search(line)
  4894	        has_git = GIT_REF_RE.search(line)
  4895	        prefix_m = REGEN_PREFIX_RE.match(line)
  4896	        # 不對稱接線:推測/佚失 不得承載合約/不可逆(raw 行獨立偵測——INVARIANT_RE 對此形態
  4897	        # 整行不 match,靠它=該行對 Check T/contracts 隱形,比擋下更毒;四組合皆觸發)
  4898	        if prefix_m and ("★INVARIANT★" in line or "★IRREVERSIBLE★" in line):
  4899	            errs.append(f"『{prefix_m.group(1)}:』行不得承載 ★INVARIANT★/★IRREVERSIBLE★"
  4900	                        f"(合約不能建在推測上;補 [src:]/[git:] 或走 signoff 升級):{line[:48]}")
  4901	            continue
  4902	        # J-a:regen ★INVARIANT★ 需 [src:]/[git:] 意圖證據(與 Check T 的 [test:] 疊加——
  4903	        # [test:] 只證行為現在成立,不證意圖是合約;拒絕發明合約)
  4904	        if INVARIANT_RE.match(line) and not (has_src or has_git):
  4905	            errs.append(f"regen 節點的 ★INVARIANT★ 缺 [src:]/[git:] 意圖證據"

