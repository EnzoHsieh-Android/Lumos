 27258	def _drift_vault_of(env):
 27259	    root = _vault_repo_root(env)
 27260	    try:
 27261	        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 27262	    except ValueError:
 27263	        return root, env.vault.name
