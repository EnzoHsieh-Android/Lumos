 14488	def _list_scalar_value(fm, key, line_idx):
 14489	    """清單欄位的單一值寫法(`key: 值`)讀出那一個值(去引號,空的回 "")。
 14490	
 14491	    ★看起來是同一行清單就丟 ValueError★:工具不解析同一行裡的逗號(fm_structure 與
 14492	    parse_frontmatter 都把它當成一個值),照單一值轉會把整串 "[a, b]" 寫成一項。
 14493	    判準看「去引號後的值本身」,不列舉寫法(2026-09-10 代碼審 r2:只比對原始字串時,
 14494	    整串加引號、逗號前後多打空白都繞得過):以 [ 或 { 開頭(單一連結 [[X]] 除外),
 14495	    或一個值裡有兩個以上連結開頭。加了引號的空清單 "[]" 跟讀的一側一樣當成空的。"""
 14496	    m = TOP_KEY_RE.match(fm[line_idx])
 14497	    val = m.group(2).strip() if m else ""
 14498	    sval = strip_quotes(val)
 14499	    t = sval.strip()   # 引號裡面前面多一個空白也要認得(第三輪外家否決席:" [a, b]" 繞過)
 14500	    if t == "[]":
 14501	        return ""
 14502	    # 單一連結要「整個值恰好是一個連結」才豁免(第三輪外家找洞席:[[Systems/A], Systems/B] 開頭像連結就被放行)
 14503	    if (t.startswith(("[", "{")) and not _SINGLE_WIKILINK_RE.fullmatch(t)) or _multi_link_value(t):
 14504	        raise ValueError(f"{key} 寫成同一行的清單({val}),工具不解析這種寫法,"
 14505	                         f"硬加會把整串當成一項寫壞,檔案沒動。這種寫法目前只能手動改成一行一項"
 14506	                         f"({key}: 換行後每項一行「  - 值」),改完再重跑")
 14507	    return t   # 去掉前後空白:引號裡只有空白就是空的(第四輪正確性席:原本會留下一筆空白垃圾項)
