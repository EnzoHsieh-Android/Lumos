 26027	def _drift_line_text(text, ln):
 26028	    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
 26029	    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
 26030	    lines = text.split("\n")
 26031	    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""
