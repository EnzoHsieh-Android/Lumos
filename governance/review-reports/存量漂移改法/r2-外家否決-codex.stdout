 12022	def _guard_planned_prose(line, region, settled_ok=False):
 12023	    """這一行是不是 guard plan 寫的預告句 → 'test'|'why'|'whynot'|'settle' 或 None。
 12024	    region 是 _notelines_regions 給的那一行所在區。WHY 行尾已經有「已轉正」不算預告
 12025	    (settled_ok=True 時回 'why-done',給 settle 分辨「已經改過」與「找不到」)。"""
 12026	    s = line.strip()
 12027	    if region == "summary":
 12028	        if s.startswith("TEST:還沒有測試在守這條"):
 12029	            return "test"
 12030	        if s.startswith("WHY:[") and _GUARD_WHY_MID in s:
 12031	            if _GUARD_SETTLED_TAIL_RE.search(s):
 12032	                return "why-done" if settled_ok else None
 12033	            return "why"
 12034	    elif region == "body":
 12035	        if s.startswith("為什麼還不做:"):
 12036	            return "whynot"
 12037	        if s.startswith("做完之後跑 `lumos guard settle` 轉正"):
 12038	            return "settle"
 12039	    return None
