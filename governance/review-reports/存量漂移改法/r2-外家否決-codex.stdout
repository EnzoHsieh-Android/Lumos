 14420	def _yaml_quote(v, what):
 14421	    """加引號,只用兩邊讀法一致的寫法:本工具讀的一側只剝掉頭尾一層引號、不解任何跳脫。
 14422	    雙引號在標準 YAML 裡會解反斜線跳脫 → 只在沒有反斜線、沒有雙引號時用;
 14423	    否則單引號(標準 YAML 裡除了 '' 以外一律照字面)→ 只在沒有單引號時用;兩種都不行就擋。"""
 14424	    if '"' not in v and "\\" not in v:
 14425	        return '"' + v + '"'
 14426	    if "'" not in v:
 14427	        return "'" + v + "'"
 14428	    raise ValueError(f"{what}「{v}」同時有單引號、又有雙引號或反斜線,工具寫不出本工具和 Obsidian 都讀得一樣的寫法,"
 14429	                     "檔案沒動;把其中一種引號換掉再寫")
 14430	
