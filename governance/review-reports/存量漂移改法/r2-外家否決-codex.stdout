 25977	# 同一句裡同時有「未提交」與「工作樹」照樣成立(考卷 E3 就是這樣寫,設計審 r3 接手席)
 25978	_DRIFT_UNCOMMITTED_WORDS = ("未提交", "還沒提交", "uncommitted")
 25979	_DRIFT_KINDS = ("probe", "c1", "c2", "c3", "c4", "c5")
 25980	_DRIFT_KIND_NAMES = {"c1": "轉正了還寫預告", "c2": "計劃收尾了、連著的 Issue 還開著",
 25981	                     "c3": "計劃收尾了、驗證紀錄還待定", "c4": "前提寫「還沒提交」",
 25982	                     "c5": "轉正做了一半", "probe": "回頭條件成立了"}
 25983	_DRIFT_ACKS = "governance/drift-acks.jsonl"
 25984	_DRIFT_GOLIVE_MARK = "drift check"
 25985	_DRIFT_GATE_VALUES = ("block", "warn", "off")
 25986	# ★沒寫設定時的預設★(計劃〈做法〉第 4 節第 4 點):三條門檻(考卷正例全對、工具鏈歷史重放不亂擋、噪音 ≤5)
 25987	# 都過才改成 block;還沒考就是 warn。
 25988	_DRIFT_DEFAULT_GATE = "warn"
 25989	_DRIFT_BUDGET_SEC = 60
