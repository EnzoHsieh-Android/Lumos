 14714	_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
 14715	_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己
 14716	
 14717	
 14718	_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)
 14719	
