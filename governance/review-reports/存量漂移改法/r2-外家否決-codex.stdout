 26170	        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
 26171	                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
 26172	            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
 26173	    return out
