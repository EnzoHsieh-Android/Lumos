 12086	def _guard_settle_rewrite(lines, today, home_link):
 12087	    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。"""
 12088	    regs = _notelines_regions("\n".join(lines))
 12089	    out, seen = [], set()
 12090	    for i, ln in enumerate(lines):
 12091	        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
 12092	        if k is None:
 12093	            out.append(ln)
 12094	            continue
 12095	        seen.add("why" if k == "why-done" else k)
 12096	        ind = ln[:len(ln) - len(ln.lstrip())]
 12097	        if k == "test":
 12098	            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
 12099	        elif k == "why":
 12100	            out.append(f"{ln.rstrip()}({today} 已轉正)")
 12101	        elif k == "whynot":
 12102	            out.append(f"{ind}預告當時{ln.lstrip()}")
 12103	        elif k == "settle":
 12104	            out.append(f"{ind}({today} 已轉正)")
 12105	        else:
 12106	            out.append(ln)
 12107	    return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]
