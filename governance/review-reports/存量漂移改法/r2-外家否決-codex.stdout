 14450	def edit_fm_scalar(fm_lines, key, value):
 14451	    fm = list(fm_lines)
 14452	    formatted = fmt_scalar(key, value)
 14453	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14454	    if key in struct:
 14455	        s, e, kind = struct[key]
 14456	        if kind != "scalar":
 14457	            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
 14458	        fm[s] = f"{key}: {formatted}"
 14459	    else:
 14460	        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
 14461	        ins = len(fm)
 14462	        for k, s, e, kind in fm_structure(fm):
 14463	            if kind in ("list", "block"):
 14464	                ins = s
 14465	                break
 14466	        fm.insert(ins, f"{key}: {formatted}")
 14467	    return fm
