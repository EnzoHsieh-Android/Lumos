_LENS_WARM_ENV = "LUMOS_LENS_WARMING"
# 鎖多久沒動就當它死了。★這個數字有依據★:實測單 commit 12 秒、41 檔 17.7 秒、
# 120 個 commit 137 秒;900 秒是最慢實測的 6.5 倍餘裕。
# 第一版寫 300——而 137 秒的範圍再大一點就會撞到,那時鎖會被誤判成死的(r2 外家席指出)。
# REVISIT:2026-12-07 若出現實際算超過 900 秒的範圍,這個數字要跟著調,或改成看行程還在不在
_LENS_LOCK_STALE_SEC = 900


def _excl_lock_try(lock, stale_sec):
    """獨佔建鎖檔(內容=程序編號+時間),搶到回 True、沒搶到回 False;專案裡唯一的一套鎖檔做法
    (dispatch-lens 的「同範圍只讓一個在算」與筆記庫寫入鎖 _vault_write_lock 共用;2026-09-10 從 dispatch-lens 抽出來)。

    ★接手也要原子★(2026-09-07 代碼審 r2 外家席):第一版的過期判斷是
    「建不成 → 看鎖檔多舊 → 太舊就當它死了」,**但只是把 already 設成 False 就繼續往下派工,
    沒有真的把鎖換成自己的**。於是鎖一旦過期,同時進來的每一個呼叫者都會各自派一支去算
    (實測兩個呼叫者都判定要派工)。更糟的是先算完的那支會無條件刪掉鎖檔,
    可能刪掉另一支正在用的。
    現在:過期(比 stale_sec 舊)時用「換名字」的方式原子接手——只有真的把舊鎖搬走的那個人才算搶到。"""
    import time as _t
    try:
        lock.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.write(fd, f"{os.getpid()}\n{_t.time():.0f}".encode())
        os.close(fd)
        return True
    except FileExistsError:
        pass
    except OSError:
        return False
    # 鎖已存在:只有「明顯過期」才嘗試接手,而且接手本身必須是原子的
    try:
        if _t.time() - lock.stat().st_mtime < stale_sec:
            return False                      # 還新,別人在用
    except OSError:
        return False
    stale = lock.with_name(lock.name + f".stale-{os.getpid()}")
    try:
        os.rename(str(lock), str(stale))      # ★原子★:同時兩個人只有一個 rename 得到
    except OSError:
        return False                          # 別人先接手了
    try:
        stale.unlink()
    except OSError:
        pass
    return _excl_lock_try(lock, stale_sec)     # 舊鎖清掉了,再正常搶一次


def _lens_wait_or_warm(root, cpath, diff_range, repo, as_json, deadline):
