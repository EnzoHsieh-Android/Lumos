  4516	def _safe_user_regex(pattern):
  4517	    """編譯使用者提供的 regex,並用【靜態】啟發式擋常見巢狀量詞 ReDoS。
  4518	    關鍵:**絕不執行**該 regex 來探測 — 在 CPython 裡 catastrophic regex 持有 GIL,
  4519	    用 thread/probe 探測反而會把整個 process 卡死(GIL 餓死主執行緒)。故只做模式檢查。
  4520	    非窮舉(擋不到 alternation 型),擋得到 (a+)+ / (a*)+ / (a+)* 這類經典款。
  4521	    回傳 (compiled, None) 或 (None, 原因)。"""
  4522	    if not isinstance(pattern, str):
  4523	        return None, "非字串"
  4524	    # 巢狀量詞:帶量詞的群組整體又被量詞修飾(經典 catastrophic backtracking)
  4525	    if re.search(r"\([^()]*[+*][^()]*\)\s*[+*?]", pattern) or \
  4526	       re.search(r"\([^()]*\)\s*[+*]\s*[+*]", pattern):
  4527	        return None, "疑似巢狀量詞 ReDoS(如 (a+)+);請改寫或用 profile 內建"
  4528	    try:
  4529	        return re.compile(pattern, re.S), None
  4530	    except re.error as e:
