 15269	def cmd_about_code_revert(env, batch_date, dry_run=False):
 15270	    """★整批撤銷某天的 about_code 預標★(工具清單 #7,2026-08-23)。
 15271	
 15272	    批次寫入時 stamp 第一段固定 `batch-<日期>`;本指令找第一段★精確等於★它的節點,
 15273	    逐值拿掉 about_code、整欄拿掉 stamp。人工修正過的 stamp 第一段會變(`claude/…`),
 15274	    不在範圍——★這是本指令最怕誤傷的那類,比對用精確字串不用包含★。
 15275	    r3 抓到原計劃寫的 `lumos query --field` 根本不存在,所以這是新子命令。
 15276	    """
 15277	    want = f"batch-{batch_date}"
 15278	    targets = []
 15279	    for rel, n in sorted(env.notes.items()):
 15280	        stamp = n.fields.get("about_code_stamp")
 15281	        if not isinstance(stamp, str):
 15282	            continue
 15283	        if stamp.split("/", 1)[0].strip() == want:
 15284	            targets.append((rel, [str(x) for x in as_list(n.fields.get("about_code"))]))
 15285	    if not targets:
 15286	        print(f"擋下:沒有任何節點的 about_code_stamp 第一段是 {want},沒東西可撤。"
 15287	              f"(人工修正過的會是 claude/… 之類,不算批次;日期格式 YYYY-MM-DD)", file=sys.stderr)
 15288	        return 2
 15289	    print(f"{'[dry-run] ' if dry_run else ''}批次 {want}:{len(targets)} 篇")
 15290	    for rel, vals in targets:
 15291	        print(f"  {rel}  about_code {len(vals)} 項")
 15292	    if dry_run:
 15293	        return 0
 15294	    done, failed = 0, 0
 15295	    for rel, vals in targets:
 15296	        # std-r1 s3f8:單篇任一值拿不掉 → ★stamp 留著★(下次 revert 還找得到它)、不算撤成功;
 15297	        # 值先去重——清單重複時第一次 remove 會把同值全拿掉,第二次拋 ValueError(實測崩潰)
 15298	        bad = None
 15299	        for v in list(dict.fromkeys(vals)):
 15300	            try:
 15301	                if cmd_remove(env, rel, "about_code", v) != 0:
 15302	                    bad = v
 15303	                    break
 15304	            except Exception as e:   # 一篇壞不該拖垮整批
 15305	                bad = f"{v}({e})"
 15306	                break
 15307	        if bad is not None:
 15308	            print(f"  ⚠ {rel} 拿 {bad} 失敗:這篇 stamp 保留、不算撤成功,其餘繼續", file=sys.stderr)
 15309	            failed += 1
 15310	            continue
 15311	        if cmd_remove(env, rel, "about_code_stamp", None) == 0:   # 走有上鎖的入口(第四輪併發資源席:原本直接呼叫底層函式、繞過寫入鎖)
 15312	            done += 1
 15313	        else:
 15314	            failed += 1
 15315	    tail = f",{failed} 篇失敗(stamp 還在,修好再跑一次)" if failed else ""
 15316	    print(f"✓ about-code revert:撤了 {done} 篇(批次 {want}){tail}")
 15317	    return 0 if failed == 0 and done == len(targets) else 1
