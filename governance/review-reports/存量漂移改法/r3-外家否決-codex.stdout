def _fill_help_when(parser, parent=""):
    """遞迴把 HELP_WHEN 灌進每個沒有 description 的子指令,讓 `lumos X --help` 第一行講人話。
    同名二層子指令(cochange check / code-loop check)先查「父 子」鍵再退回單名。"""
    for act in parser._actions:
        if isinstance(act, argparse._SubParsersAction):
            for name, sp in act.choices.items():
                if not sp.description:
                    when = HELP_WHEN.get(f"{parent} {name}".strip()) or HELP_WHEN.get(name)
                    if when:
                        sp.description = "什麼時候用:" + when
                _fill_help_when(sp, name)

def cmd_python_path():
    """lumos python-path:印一支 ≥3.14 直譯器的絕對路徑,git 掛鉤之後的呼叫都用它(Systems/python直譯器選擇)。
            return 2
        return cmd_home_check(repo=args.hm_repo, staged=args.hm_staged, diff_range=args.hm_diff)
    if args.cmd == "note-audit":
        if args.nacmd == "prepare":
            return cmd_note_audit_prepare(repo=args.na_repo, diff_range=args.na_diff, orchestrator=args.na_orch, only=args.na_only)
        if args.nacmd == "record":
            return cmd_note_audit_record(repo=args.na_repo, diff_range=args.na_diff, prepared=args.na_prepared,
                                         reports=args.na_reports, dispute=args.na_dispute, disputes=args.na_disputes)
        if args.nacmd == "check":
            return cmd_note_audit_check(repo=args.na_repo, diff_range=args.na_diff)
        return cmd_note_audit_skip(repo=args.na_repo, diff_range=args.na_diff, note=args.na_note)
    if args.cmd == "drift" and args.drcmd in ("check", "exam"):
        if args.drcmd == "check":
            return cmd_drift_check(repo=args.dr_repo, diff_range=args.dr_diff)
        if not args.dr_history and not args.dr_exam:
            print("擋下:lumos drift exam 要給考卷,或帶 --history N", file=sys.stderr)
            return 2
        return cmd_drift_exam(args.dr_exam, args.dr_repo, probes=args.dr_probes, at=args.dr_at,
                              history=args.dr_history, as_json=args.dr_json)
    if args.cmd == "note-shape":
        if args.ns_staged and args.ns_diff is not None:
            print("擋下:--staged 和 --diff 不能一起用,擇一", file=sys.stderr)
            return 2
        if not args.ns_staged and args.ns_diff is None:
            print("擋下:lumos note-shape 要帶 --staged 或 --diff <起點>..<終點>", file=sys.stderr)
            return 2
        return cmd_note_shape(repo=args.ns_repo, staged=args.ns_staged, diff_range=args.ns_diff)
    if args.cmd == "delguard":
        return cmd_delguard_check(repo=args.repo, as_json=args.json)
    if args.cmd == "bound-tests":
        if args.bt_skip and not (args.bt_note or "").strip():
            print("擋下:--skip 要附一句理由(--note),不然帳上看不出為什麼跳過", file=sys.stderr)
            return 2
        if not args.bt_diff and not args.bt_from_json:
            print("擋下:要嘛給 --diff <範圍>,要嘛給 --from-json <已算好的結果>", file=sys.stderr)
            return 2
        return cmd_bound_tests(args.bt_diff, repo=args.bt_repo, as_json=args.bt_json,
                               advisory=args.bt_advisory, from_json=args.bt_from_json,
                               skip=args.bt_skip, skip_note=args.bt_note)
    if args.cmd == "code-loop":
        note = getattr(args, "note", None) or ""
        cl_json = getattr(args, "cl_json", False)
        return cmd_code_loop(args.clcmd, note=note, repo=args.cl_repo, as_json=cl_json,
                             diff_range=getattr(args, "cl_diff", None),
                             at_sha=getattr(args, "cl_at_sha", None),
                             skip_bound=getattr(args, "cl_skip_bound", False),
                             marker_branch=getattr(args, "cl_branch", None),
                             disp_file=getattr(args, "cl_disp_file", None),
                             qid=getattr(args, "cl_qid", None),
                             from_json=getattr(args, "cl_from_json", None),
                             bound_advisory=getattr(args, "cl_bound_advisory", False))
    if args.cmd == "loop" and args.lcmd == "capture-counts":
        # 純機械原語(不碰圖譜):跨異質 finder 算 capture-recapture 重疊,vault-free
        return cmd_loop_capture_counts(None, args.finders,
                                       from_pitfalls=args.cc_pitfalls, repo=args.cc_repo)

    vault = args.vault or find_vault(Path.cwd())
    if vault is None or not vault.is_dir():
        print("擋下:找不到知識圖譜(docs/*-knowledge),用 --vault 指定", file=sys.stderr)
        return 2
    env = Env(vault)

    if args.cmd == "doctor":
        color = sys.stdout.isatty() and not args.ci
        _touched = _read_touched_list(getattr(args, "touched_from", None))
        return run_doctor(env, strict=(args.strict or args.ci), color=color, suggest=args.suggest,
                          ci=args.ci, verbose=args.verbose, touched=_touched)

    if args.cmd in ("links", "backlinks", "context", "map", "show") or \
       (args.cmd == "decisions" and not args.superseded):
        rel = env.find(getattr(args, "note", None) or "")
        if rel is None:
            return _node_not_found(env, args.note)
        if args.cmd == "links":
            return cmd_links(env, rel)
        if args.cmd == "backlinks":
            return cmd_links(env, rel, reverse=True)
        if args.cmd == "context":
            # 大節點提示(Landmark 2026-08-11 實測:熱節點 context 43KB、--brief 19KB;2026-08-22 收進工具):
            # 全量輸出超過 20KB 就在尾端提醒下次用 --brief(合約行照樣在頭部)。--brief/--json 不提示。
            import io as _io, contextlib as _ctx
            _buf = _io.StringIO()
            with _ctx.redirect_stdout(_buf):
                _rc = cmd_context(env, rel, brief=args.brief, recommend=args.recommend, top=args.ctx_top, min_score=args.ctx_min, as_json=args.ctx_json)
            _txt = _buf.getvalue()
            sys.stdout.write(_txt)
            if not args.brief and not args.ctx_json and len(_txt.encode("utf-8")) > 20_000:
                print(f"提醒:這篇的脈絡輸出有 {len(_txt.encode('utf-8')) // 1024} KB,佔掉不少注意力。下次先用 --brief(合約行照樣在頭部,只省鄰居摘要),要全文再 lumos show:\n    lumos context {rel} --brief", file=sys.stderr)
            return _rc
        if args.cmd == "map":
            return cmd_map(env, rel, args.depth)
        if args.cmd == "show":
            return cmd_show(env, rel, body_only=args.body_only)
        return cmd_decisions(env, rel)  # 無條件 fallback:新掛組內指令必須在此行前插 if 分支

    if args.cmd == "search":
        # 2026-07-11 轉正:相關性排序為預設(goldset 評測 §6 search 面全過);
        # --legacy 逃生;--regex 自動走舊路(候選語意不同,靜默、不印 fallback note)
        _use_ranked = not args.search_legacy and not args.regex
        if args.ranked and args.regex:
            print("(--regex 模式不做相關性排序,照舊順序輸出)", file=sys.stderr)
        return cmd_search(env, args.term, path_prefix=args.path_prefix,
                          regex=args.regex, files_only=args.files_only,
                          include_code=args.code, ranked=_use_ranked, top=args.top,
                          as_json=args.search_json, include_superseded=args.include_superseded,
                          any_terms=not args.search_no_any,
                          cjk_loose=args.search_cjk_loose)

    if args.cmd == "contracts":
        rel = None
        if args.note:
            rel = env.find(args.note)
            if rel is None:
                return _node_not_found(env, args.note)
        return cmd_contracts(env, rel)

    if args.cmd == "lint":
        return cmd_lint(env, args.note)

    if args.cmd == "spec-gate":
        if args.sg_door_rule:
            print(f"door_rule={_DOOR_RULE_VERSION} inputs_sha={_door_rule_fingerprint()}")
            return 0
        if args.sg_push:
            return _spec_gate_push_check(env, args.sg_push, repo=args.sg_repo)
        if not args.node:
            print("擋下:要給計劃節點(lumos spec-gate Projects/<名>_計劃),或用 --push-check <範圍> / --door-rule", file=sys.stderr)
            return 2
        return cmd_spec_gate(env, args.node, no_run=args.sg_no_run)
    if args.cmd == "spec-trace":
        return cmd_spec_trace(env, args.node, as_json=args.st_json)
    if args.cmd == "signoff":
        return cmd_signoff(env, args.node, note=args.note, by=args.by, ref=args.so_ref)
    if args.cmd == "gov":
        return cmd_gov(env, args.node, since_days=args.since, full=args.full, stats=args.stats, nags=args.gov_nags)

    if args.cmd == "ci-wait":
        return cmd_ci_wait(env, timeout=args.cw_timeout, repo_dir=args.cw_repo,
                           sha=args.cw_sha, branch=args.cw_branch,
                           grace=args.cw_grace, as_json=args.cw_json)
    if args.cmd == "ci-status":
        return cmd_ci_status(env, repo_dir=args.cs_repo, as_json=args.cs_json)
    if args.cmd == "about-code":
        if args.accmd == "revert":
            return cmd_about_code_revert(env, args.batch, dry_run=args.dry_run)
        if args.accmd == "restamp":
            return cmd_about_code_restamp(env, args.node, by=args.by)
        if args.accmd == "migrate-stamp":
            return cmd_about_code_migrate_stamp(env, args.at, repo_root=args.acm_repo, dry_run=args.dry_run)
    if args.cmd == "canary":
        if args.ccmd == "second":
            return cmd_canary_second(env, ref_id=args.sec_ref, verdict=args.sec_verdict,
                                     auditor=args.sec_auditor, note=args.sec_note)
        return cmd_canary(env, args.kind, args.auditor, args.token, args.note, args.loop,
                          args.severity, findings=args.findings, round_id=args.round_id,
                          canary_type=args.canary_type, probe=args.probe,
                          capture_counts=args.capture_counts, clusters=args.clusters,
                          spec=args.rec_spec, reviewed=args.reviewed,
                          tokens=args.tokens, wallclock_min=args.wallclock_min, tier=args.rec_tier,
                          outcome=args.rec_outcome, usd=args.rec_usd, orchestrator=args.rec_orch,
                          scope_lines=args.scope_lines, report=args.report, snapshot=args.snapshot, intake=args.intake,
                          findings_set=args.findings_set, folded_set=args.folded_set,
                          accepted_set=args.accepted_set, accept_reasons=args.accept_reasons,
                          finding_kinds=getattr(args, 'finding_kinds', None),
                          finding_severities=getattr(args, 'finding_severities', None),
                          refute_verdicts=getattr(args, 'refute_verdicts', None),
                          refuted_set=getattr(args, 'refuted_set', None))


    if args.cmd == "handoff":
        return cmd_handoff(env, args.handoff_node, as_json=args.handoff_json,
                           transcript=args.handoff_transcript, turns=args.handoff_turns)
    if args.cmd == "loop":
        if args.lcmd == "list":
            return cmd_loop_list(env, days=args.ll_days, show_all=args.ll_all,
                                 stale_only=args.ll_stale, as_json=args.ll_json, now=args.ll_now,
                                 exclude=args.ll_exclude)
        if args.lcmd == "canary-stats":
            return cmd_loop_canary_stats(env, args.loop_id)
        if args.lcmd == "escape-stats":
            return cmd_loop_escape_stats(env, as_json=args.es_json)
        if args.lcmd == "status":
            return cmd_loop_status(env, args.loop_id, args.need,
                                   gate=args.gate, spec=args.gate_spec, repo=args.gate_repo,
                                   panel=args.panel, light=args.light, min_seats=args.min_seats,
                                   settle=args.settle, disposal=args.disposal, roster=args.roster)
        if args.lcmd == "compress":
            return cmd_loop_compress(args.compress_file, as_json=args.compress_json)
        if args.lcmd == "verify-progress":
            return cmd_loop_verify_progress(env, args.vp_loop_id, settle=args.vp_settle,
                                            as_json=args.vp_json)
        if args.lcmd == "replay":
            return cmd_loop_replay(env, args.rp_loop_id, golden=args.rp_golden, freeze=args.rp_freeze,
                                   spec=args.rp_spec, note=args.rp_note, repo=args.rp_repo)
        if args.lcmd == "rewrite":
            return cmd_loop_rewrite(env, args.rw_loop_id, args.rw_successor, args.rw_note)
        if args.lcmd == "escape":
            try:   # 寫入鎖拿不到會拋 RuntimeError;照其他寫入指令一樣印「擋下」,不讓例外直接冒出來
                return cmd_loop_escape(env, loop_id=args.esc_loop_id, stage=args.esc_stage,
                                       severity=args.esc_severity, desc=args.esc_desc,
                                       defect_ref=args.esc_ref, list_mode=args.esc_list, rule=args.esc_rule,
                                       auto=args.esc_auto, git_range=args.esc_range, sha=args.esc_sha, repo=args.esc_repo,
                                       withdraw=args.esc_withdraw, reason=args.esc_reason, by=args.esc_by,
                                       withdrawn=args.esc_withdrawn, missing_ref=args.esc_missing_ref)
            except (ValueError, RuntimeError) as e:
                print(f"擋下:{e}", file=sys.stderr)
                return 2
        if args.lcmd == "next":
            return cmd_loop_next(env, args.loop_id, tier=args.next_tier, as_json=args.next_json, orchestrator=args.next_orch,
                                 need=args.need, spec=args.gate_spec, repo=args.gate_repo)
        # capture-counts 已在 vault-free 段提前處理(見上)

    if args.cmd == "guard":
        if args.gcmd == "list":
            return cmd_guard_list(env, unbound_only=args.unbound)
        if args.gcmd == "scaffold":
            return cmd_guard_scaffold(env, args.node, args.invariant, args.method,
                                      args.type, args.claim, out_dir=args.out,
                                      template=args.template, klass=args.klass,
                                      platform=args.platform)
        if args.gcmd == "plan":
            return cmd_guard_plan(env, args.node, args.claim, args.gp_plan, args.gp_phase,
                                  args.gp_due, args.gp_why, args.gp_owner, args.gp_name)
        if args.gcmd == "settle":
            return cmd_guard_settle(env, args.ref, args.gs_test)
        if args.gcmd == "abandon":
            return cmd_guard_abandon(env, args.ref, args.ga_why)
        if args.gcmd == "required":
            return cmd_guard_required(env)
        if args.gcmd == "bind":
            return cmd_guard_bind(env, args.node, args.invariant, args.method,
                                  platform=args.platform)
        if args.gcmd == "audit":
            return cmd_guard_audit(env, args.node, args.invariant, args.model, args.date)
        if args.gcmd == "kill-add":
            return cmd_guard_kill_add(env, args.node, args.invariant, file=args.file,
                                      old=args.old, new=args.new, test=args.test,
                                      platform=args.gk_platform, note=args.note)
        if args.gcmd == "kill":
            return cmd_guard_kill(env, args.node, invariant_substr=args.invariant,
                                  platform_override=args.gk_platform,
                                  as_json=args.gk_json, keep_worktree=args.keep_worktree)
        if args.gcmd == "trace":
            return cmd_guard_trace(env, args.node)

    if args.cmd == "sync-verified-by":
        return cmd_sync_verified_by(env, apply=args.apply)

    if args.cmd == "decisions":
        return cmd_decisions(env, superseded=True)
    if args.cmd == "stale":
        return cmd_stale(env, match=args.match, candidate=args.candidate, legacy=args.stale_legacy)
    if args.cmd == "query":
        return cmd_query(env, tags=args.tag, no_tags=args.no_tag, active=args.active,
                         contract=args.contract, linked=args.linked,
                         include_superseded=args.include_superseded, as_json=args.q_json)
    if args.cmd == "recent":
        return cmd_recent(env, args.days)
    if args.cmd == "stats":
        return cmd_stats(env)
    if args.cmd == "export":
        if args.format == "html":
            return cmd_export_html(env, args.output, standalone=args.standalone)
        return cmd_export(env, args.format, set(args.folders))

    if args.cmd == "self-audit":
        rel = env.find(args.node)
        if rel is None:
            print(f"擋下:圖譜裡找不到叫 {args.node} 的筆記,先確認名稱或路徑", file=sys.stderr)
            return 2
        try:
            return cmd_self_audit(env, rel, args.model, args.date)
        except (ValueError, RuntimeError) as e:
            print(f"擋下:{e}", file=sys.stderr)
            return 2

    # T1 寫側
    if args.cmd == "drift-history":
        return cmd_drift_history(env, every=args.every, limit=args.limit, as_json=args.dh_json)
    if args.cmd == "drift":
        if args.drcmd == "scan":
            return cmd_drift_scan(env, at=args.dr_at, as_json=args.dr_json, budget=args.dr_budget)
        return cmd_drift_ack(env, args.dr_node, args.dr_line, args.dr_kind, args.dr_reason)
    if args.cmd in ("set", "append", "remove"):
        rel = env.find(args.note)
        if rel is None:
            return _node_not_found(env, args.note, write_side=True)
        try:
            if args.cmd == "set":
                rc = cmd_set(env, rel, args.key, args.value)
                if rc == 0 and args.key == "status":
                    # 計劃收尾時列連帶待辦(存量漂移防線 [S6]):只多印、不擋、不寫;env 是改之前載入的,連結沒變
                    _v = args.value[0] if isinstance(args.value, list) and len(args.value) == 1 else args.value
                    _drift_print_followups(env, rel, str(_v).strip())
                return rc
            if args.cmd == "remove":

