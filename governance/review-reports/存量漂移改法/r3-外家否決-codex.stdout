 32780	
 32781	def _excl_lock_try(lock, stale_sec):
 32782	    """獨佔建鎖檔(內容=程序編號+時間),搶到回 True、沒搶到回 False;專案裡唯一的一套鎖檔做法
 32783	    (dispatch-lens 的「同範圍只讓一個在算」與筆記庫寫入鎖 _vault_write_lock 共用;2026-09-10 從 dispatch-lens 抽出來)。
 32784	
 32785	    ★接手也要原子★(2026-09-07 代碼審 r2 外家席):第一版的過期判斷是
 32786	    「建不成 → 看鎖檔多舊 → 太舊就當它死了」,**但只是把 already 設成 False 就繼續往下派工,
 32787	    沒有真的把鎖換成自己的**。於是鎖一旦過期,同時進來的每一個呼叫者都會各自派一支去算
 32788	    (實測兩個呼叫者都判定要派工)。更糟的是先算完的那支會無條件刪掉鎖檔,
 32789	    可能刪掉另一支正在用的。
 32790	    現在:過期(比 stale_sec 舊)時用「換名字」的方式原子接手——只有真的把舊鎖搬走的那個人才算搶到。"""
 32791	    import time as _t
 32792	    try:
 32793	        lock.parent.mkdir(parents=True, exist_ok=True)
 32794	        fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
 32795	        os.write(fd, f"{os.getpid()}\n{_t.time():.0f}".encode())
 32796	        os.close(fd)
 32797	        return True
 32798	    except FileExistsError:
 32799	        pass
 32800	    except OSError:
 32801	        return False
 32802	    # 鎖已存在:只有「明顯過期」才嘗試接手,而且接手本身必須是原子的
 32803	    try:
 32804	        if _t.time() - lock.stat().st_mtime < stale_sec:
 32805	            return False                      # 還新,別人在用
 32806	    except OSError:
 32807	        return False
 32808	    stale = lock.with_name(lock.name + f".stale-{os.getpid()}")
 32809	    try:
 32810	        os.rename(str(lock), str(stale))      # ★原子★:同時兩個人只有一個 rename 得到
 32811	    except OSError:
 32812	        return False                          # 別人先接手了
 32813	    try:
 32814	        stale.unlink()
 32815	    except OSError:
 32816	        pass
 32817	    return _excl_lock_try(lock, stale_sec)     # 舊鎖清掉了,再正常搶一次
