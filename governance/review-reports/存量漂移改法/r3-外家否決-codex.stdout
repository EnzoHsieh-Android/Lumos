 14667	def _write_lf(path: Path, text: str):
 14668	    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
 14669	    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.9。
 14670	    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
 14671	    整檔覆寫消費者)。read-modify-write 的併發:set/append/remove 由呼叫端上鎖(_vault_write_lock),
 14672	    其他寫入指令仍是 last-write-wins(單機 CLI,accepted)。
 14673	    ★暫存檔名每次都不一樣★(2026-09-10 代碼審 r3 併發資源席:原本同一篇筆記大家用同一個固定暫存檔名,
 14674	    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
 14675	    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
 14676	    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
 14677	    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
 14678	    import os as _os, shutil as _sh, uuid as _uuid
 14679	    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
 14680	    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
 14681	    try:
 14682	        with _os.fdopen(fd, "wb") as fh:
 14683	            fh.write(text.encode("utf-8"))
 14684	        if path.exists():
 14685	            _sh.copymode(path, tmp)
 14686	        _os.replace(tmp, path)
 14687	    except BaseException:
 14688	        try:
 14689	            _os.unlink(tmp)
 14690	        except OSError:
 14691	            pass
 14692	        raise
