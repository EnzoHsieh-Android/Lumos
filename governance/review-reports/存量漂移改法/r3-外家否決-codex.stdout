  4861	def _git_is_shallow(repo_root):
  4862	    import subprocess
  4863	    try:
  4864	        r = subprocess.run(["git", "rev-parse", "--is-shallow-repository"], cwd=str(repo_root),
  4865	                           capture_output=True, text=True, errors="replace")
  4866	        return r.returncode == 0 and r.stdout.strip() == "true"
  4867	    except OSError:
  4868	        return False
