 50551	def t_note_audit_code_review_r3_regressions():
 50552	    """代碼審 r3(三席)抓到的問題各一條回歸:CI 工作項目切分認得行尾註解、加引號的名字、jobs: 帶註解;
 50553	    第一層 doctor 走同一支、整行註解掉的那步算沒呼叫、訊息指名工作項目並講還有幾個;
 50554	    decision-amend 在 git add -u / commit -a 之後認不出改名時拒絕(本機已提交的改名不誤擋全新筆記);
 50555	    SHA-256 專案的 64 個 0 照跳過。"""
 50556	    print("t_note_audit_code_review_r3_regressions")
 50557	    import subprocess as sp
 50558	    m = _load_lumos_inproc()
 50559	    tmp = Path(tempfile.mkdtemp(prefix="gctl-na-r3-"))
 50560	    wf = tmp / "wf"
 50561	    wf.mkdir()
 50562	    full = "      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n"
 50563	    call = "      - uses: actions/checkout@v4\n      - run: python3 scripts/lumos note-audit check --diff x\n"
 50564	    cases = {
 50565	        "行尾註解的工作項目名": "jobs:\n  audit:\n    steps:\n" + call + "  full:   # needs full history\n    steps:\n" + full,
 50566	        "jobs 行帶註解": "jobs:  # all jobs\n  audit:\n    steps:\n" + call,
 50567	        "加引號的名字": 'jobs:\n  "audit":\n    steps:\n' + call + '  "later":\n    steps:\n      - run: echo ok\n',
 50568	        "對照組": "jobs:\n  audit:\n    steps:\n" + call + "  full:\n    steps:\n" + full,
 50569	    }
 50570	    for label, y in cases.items():
 50571	        f = wf / f"{abs(hash(label))}.yml"
 50572	        f.write_text(y, encoding="utf-8")
 50573	        got = m._ci_jobs_calling_without_full_history([f], "note-audit check")
 50574	        check(f"①{label}:認得出 audit 沒抓完整歷史", got == [(f.name, "audit")], str(got))
 50575	    # ② 第一層 doctor 走同一支:別的工作項目設了完整歷史照唸、指名工作項目;整行註解掉算沒呼叫
 50576	    root, _b = _na_repo()
 50577	    w = root / ".github" / "workflows"
 50578	    w.mkdir(parents=True)
 50579	    (w / "ci.yml").write_text("jobs:\n  full:\n    steps:\n" + full + "  audit:\n    steps:\n"
 50580	                              "      - uses: actions/checkout@v4\n      - run: python3 scripts/lumos note-shape --diff x\n", encoding="utf-8")
 50581	    lines = m._note_shape_doctor_lines(root, root / _NA_VAULT, ci=True)
 50582	    check("②第一層 doctor:呼叫那個工作項目沒抓完整歷史 → 照唸並指名", any("fetch-depth: 0" in l and "ci.yml 的 audit" in l for l in lines), str(lines))
 50583	    (w / "ci.yml").write_text("jobs:\n  audit:\n    steps:\n      # - run: python3 scripts/lumos note-shape --diff x\n", encoding="utf-8")
 50584	    lines = m._note_shape_doctor_lines(root, root / _NA_VAULT, ci=True)
 50585	    check("②b 整行註解掉的那步算沒呼叫 → 唸沒呼叫", any("沒呼叫" in l for l in lines), str(lines))
 50586	    many = "jobs:\n" + "".join(f"  j{i}:\n    steps:\n" + call for i in range(7))
 50587	    (w / "ci.yml").write_text(many, encoding="utf-8")
 50588	    lines = m._note_audit_doctor_lines(root, root / _NA_VAULT, ci=True)
 50589	    check("②c 超過 5 個只列 5 個並講共幾個", any("等 7 個" in l for l in lines), str(lines))
 50590	    # ③ decision-amend:git add -u、commit -a 之後認不出改名 → 拒絕;本機已提交的改名不誤擋全新筆記
 50591	    bare = tmp / "r.git"
 50592	    sp.run(["git", "init", "-q", "--bare", str(bare)], capture_output=True)
 50593	    root, _b = _na_repo()
 50594	    _nh_node(root, "D", extra="decisions:\n  - id: d1\n    decided: 2026-09-01\n    context: 已推的", body="x")
 50595	    _nh_commit(root, "d")
 50596	    _nh_git(root, "remote", "add", "origin", str(bare))
 50597	    _nh_git(root, "push", "-q", "origin", "HEAD:refs/heads/main")
 50598	    _nh_git(root, "fetch", "-q", "origin")
 50599	    vault = root / _NA_VAULT
 50600	    (vault / "Systems" / "D.md").rename(vault / "Systems" / "New.md")
 50601	    _nh_git(root, "add", "-u")
 50602	    r = run(vault, "decision-amend", "Systems/New", "d1", "--field", "context", "--text", "偷改")
 50603	    check("③git add -u 之後:認不出改名 → 拒絕", r.returncode != 0 and "已推的" in (vault / "Systems" / "New.md").read_text(encoding="utf-8"),
 50604	          r.stdout + r.stderr[-300:])
 50605	    _nh_git(root, "commit", "-qam", "commit -a", "--no-verify")
 50606	    r = run(vault, "decision-amend", "Systems/New", "d1", "--field", "context", "--text", "偷改")
 50607	    check("③b commit -a 之後:照拒", r.returncode != 0, r.stdout + r.stderr[-300:])
 50608	    _nh_git(root, "add", "-A")
 50609	    _nh_git(root, "commit", "-qm", "rename committed", "--no-verify")
 50610	    _nh_node(root, "Fresh", extra="decisions:\n  - id: d1\n    decided: 2026-09-01\n    context: 新的", body="y")
 50611	    r = run(vault, "decision-amend", "Systems/Fresh", "d1", "--field", "context", "--text", "新的改")
 50612	    check("③c 本機已提交的改名不誤擋全新筆記", r.returncode == 0, r.stderr[-300:])
 50613	    # ④ SHA-256 專案的 64 個 0(刪分支)照跳過
 50614	    root, _b = _na_repo()
 50615	    for cmd, label in ((["note-shape", "--diff"], "筆記形狀擋"), (["home", "check", "--diff"], "每支檔有家"),
 50616	                       (["note-audit", "check", "--diff"], "筆記內容審")):
 50617	        r = sp.run([sys.executable, GRAPHCTL, *cmd, "HEAD.." + "0" * 64, "--repo", str(root)], capture_output=True, text=True)
 50618	        check(f"④{label}:終點 64 個 0 → 跳過 rc0", r.returncode == 0, r.stderr[-200:])
