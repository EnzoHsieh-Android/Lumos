 14845	    if key == "status":
 14846	        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
 14847	    new_lines = lines[:1] + new_fm + lines[e:]
 14848	
 14849	    def _check(f):
 14850	        if str(f.get(key, "")) != exp_val:
 14851	            return False
 14852	        if tag_synced:
 14853	            want = f"status/{exp_val}"
 14854	            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
 14855	            return want in tags and all(t == want for t in tags if t.startswith("status/"))
