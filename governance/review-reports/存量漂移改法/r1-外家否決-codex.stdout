 51198	    _nh_file(root, "docs/kg-knowledge/Issues/I.md", "---\ntype: issue\nstatus: open\n---\n# I\n[[Projects/退款_計劃]]\n")
 51199	    _nh_commit(root, "old vault")
 51200	    old = _na_head(root)
 51201	    _nh_git(root, "mv", "docs/kg-knowledge", "docs/new-knowledge")
 51202	    _nh_commit(root, "rename vault")
 51203	    r = run(root / "docs" / "new-knowledge", "drift", "scan", "--json", "--at", old)
 51204	    try:
 51205	        got = [f["kind"] for f in _j.loads(r.stdout)["findings"]]
 51206	    except ValueError:
 51207	        got = r.stdout + r.stderr
 51208	    check("⑥scan --at 讀舊提交時用它自己的圖譜位置", got == ["c2"], str(got))
 51209	    # ⑦ 考卷形狀
 51210	    ef = root / "exam.json"
 51211	    for bad in ("42", '["a", "b"]', '[{"id": "X", "exam_event": "current_state", "line": 3}]'):
 51212	        ef.write_text(bad, encoding="utf-8")
 51213	        rr = sp.run([sys.executable, GRAPHCTL, "drift", "exam", str(ef), "--repo", str(root)], capture_output=True, text=True)
 51214	        check(f"⑦考卷 {bad[:30]}:不崩(擋下或略過,沒有 Traceback)", "Traceback" not in rr.stderr, rr.stderr[-300:])
 51215	    # ⑧ 解不開的守衛紀錄
 51216	    root2 = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 51217	    gp = root2 / _DR_VAULT / "Verification" / "G.md"
 51218	    gp.write_text(_dr_guard_text("pending"), encoding="utf-8")
 51219	    _nh_commit(root2, "base")
 51220	    b2 = _na_head(root2)
 51221	    gp.write_bytes(_dr_guard_text("pass").encode("utf-8") + b"\n\xff\xfe\n")
 51222	    _nh_commit(root2, "非 UTF-8 的轉正")
 51223	    rc, out = _dr(root2, "check", "--diff", f"{b2}..HEAD")
 51224	    check("⑧解不開的守衛紀錄:判不了、擋", rc == 1 and "判不了" in out, out)
 51225	    check("⑬只有判不了時訊息講判不了,不說有 0 處要處理", "有 0 處要處理" not in out, out)
 51226	    # ⑨ 欄位發現用實際文字
 51227	    T = {"Projects/P.md": "---\ntype: project\nstatus: done\n---\n# P\n",
 51228	         "Issues/I.md": "---\ntype: issue\nstatus: \"open\"\n---\n# I\n[[Projects/P]]\n",
 51229	         "Verification/E.md": "---\ntype: verification\nstatus: pass\nvalid_under:\n  - 釘在提交 abc\n  - 本工作樹(未提交)\n---\n# E\n"}
 51230	    e = m.Env.from_texts(Vp, T)
 51231	    fs = {f["kind"]: f for f in m._drift_state_findings(e)}
 51232	    check("⑨c2 的原文是那一行實際的字", fs.get("c2", {}).get("text") == 'status: "open"', str(fs.get("c2")))
 51233	    check("⑨c4 指到真的含未提交的那一行", fs.get("c4", {}).get("line") == 6 and "未提交" in fs.get("c4", {}).get("text", ""),
 51234	          str(fs.get("c4")))
 51235	    # ⑩ 舊理由
