 28693	def _range_base(rr, diff_range):
 28694	    """範圍起點:a..b 是 a;a...b 是 merge-base(a,b)(代碼審 r1 正確性席:三點範圍拿左端點當起點,刪掉的檔會從錯的版本讀);其他回 None。"""
 28695	    if not diff_range:
 28696	        return None
 28697	    if "..." in diff_range:
 28698	        a, b = diff_range.split("...", 1)
 28699	        try:
 28700	            r = subprocess.run(["git", "-C", str(rr), "merge-base", a or "HEAD", b or "HEAD"], capture_output=True, text=True, errors="replace")
 28701	            return r.stdout.strip() or None if r.returncode == 0 else None
 28702	        except OSError:
 28703	            return None
 28704	    if ".." in diff_range:
 28705	        return diff_range.split("..", 1)[0] or None
 28706	    return None
