 50939	def t_drift_check_state_events_in_range():
 50940	    """[S8][S1][S3] 推送範圍裡有守衛紀錄 pending→pass 且留著預告句 → 擋那一篇的 c1;c2–c5 只列出;範圍外的不擋、scan 照列;
 50941	    三態開關、略過只認 1、上線點之前的不查;表態要提交才算、改那行就失效並印舊理由、理由太短拒絕。
 50942	
 50943	    翻紅釘:c1 不看「範圍裡轉正」→ ⑤範圍外那篇紅;表態讀工作目錄 → ⑧紅;略過改成有設就跳 → ③紅。
 50944	    """
 50945	    print("t_drift_check_state_events_in_range")
 50946	    import json as _j
 50947	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 50948	    vault = root / _DR_VAULT
 50949	    (vault / "Issues").mkdir(exist_ok=True)
 50950	    (vault / "Verification" / "Old.md").write_text(_dr_guard_text("pass", claim="早就轉正的"), encoding="utf-8")
 50951	    (vault / "Verification" / "G.md").write_text(_dr_guard_text("pending"), encoding="utf-8")
 50952	    _nh_file(root, f"{_DR_VAULT}/Issues/I.md", "---\ntype: issue\nstatus: open\n---\n# I\n[[Projects/退款_計劃]]\n")
 50953	    _nh_commit(root, "base")
 50954	    base = _na_head(root)
 50955	    g = vault / "Verification" / "G.md"
 50956	    g.write_text(g.read_text(encoding="utf-8").replace("status: pending", "status: pass").replace("status/pending", "status/pass"),
 50957	                 encoding="utf-8")
 50958	    p = vault / "Projects" / "退款_計劃.md"
 50959	    p.write_text(p.read_text(encoding="utf-8").replace("status: doing", "status: done").replace("status/doing", "status/done"),
 50960	                 encoding="utf-8")
 50961	    _nh_commit(root, "舊版 settle 的轉正,順手收尾計劃")
 50962	    rng = f"{base}..HEAD"
 50963	    rc, out = _dr(root, "check", "--diff", rng)
 50964	    check("①block:範圍裡轉正還留著預告句 → rc1", rc == 1 and "Verification/G.md" in out, out)
 50965	    check("②c1 一句一筆都列出", out.count("[c1 ") == 4, out)
 50966	    check("②c2 只列出(計劃在範圍裡收尾、連著開著的 Issue)", "只列出" in out and "Issues/I.md" in out, out)
 50967	    check("⑤範圍外早就轉正的那篇不擋", "Old.md" not in out, out)
 50968	    fs = _dr_scan(vault)
 50969	    check("⑤但 scan 照列範圍外那篇", any(f["path"] == "Verification/Old.md" and f["kind"] == "c1" for f in fs), str(fs)[:300])
 50970	    rc, out = _dr(root, "check", "--diff", rng, env={"LUMOS_SKIP_DRIFT_CHECK": "1"})
 50971	    check("③略過設成 1:放行並記 skipped-env", rc == 0 and "skipped-env" in (vault.parent / ".governance-log.jsonl").read_text(
 50972	        encoding="utf-8"), out)
 50973	    rc, out = _dr(root, "check", "--diff", rng, env={"LUMOS_SKIP_DRIFT_CHECK": "0"})
 50974	    check("③設成別的值不算略過", rc == 1, out)
 50975	    (root / ".lumos" / "config.json").write_text(_j.dumps({"drift_check": {"gate": "warn"}}), encoding="utf-8")
 50976	    _nh_commit(root, "warn")
 50977	    rc, out = _dr(root, "check", "--diff", rng)
 50978	    check("④warn:只印、rc0、記 warned", rc == 0 and "提醒(drift_check.gate=warn" in out and "\"warned\"" in (
 50979	        vault.parent / ".governance-log.jsonl").read_text(encoding="utf-8"), out)
 50980	    (root / ".lumos" / "config.json").write_text(_j.dumps({"drift_check": {"gate": "off"}}), encoding="utf-8")
 50981	    _nh_commit(root, "off")
 50982	    rc, out = _dr(root, "check", "--diff", rng)
 50983	    check("④off:放行", rc == 0 and "關掉" in out, out)
 50984	    (root / ".lumos" / "config.json").write_text(_j.dumps({"drift_check": {"gate": "block"}}), encoding="utf-8")
 50985	    _nh_commit(root, "block again")
 50986	    # 表態
 50987	    lines = g.read_text(encoding="utf-8").split("\n")
 50988	    nums = [i + 1 for i, l in enumerate(lines) if l.strip().startswith(("WHY:[", "TEST:還沒有", "為什麼還不做:", "做完之後跑"))]
 50989	    r = run(vault, "drift", "ack", "Verification/G", str(nums[0]), "--kind", "c1", "--reason", "短")
 50990	    check("⑦理由少於 4 個字拒絕", r.returncode == 2, r.stdout + r.stderr)
