 50713	def _dr_repo(cfg=None, golive=True):
 50714	    """存量漂移的測試專案:每支檔有家那個骨架 + 含 drift check 上線標記的推送前掛鉤 + 家筆記 Pay 與計劃。"""
 50715	    root = _nh_repo(cfg)
 50716	    if golive:
 50717	        _nh_file(root, "scripts/hooks/pre-push", "#!/bin/bash\n# lumos drift check\n")
 50718	    _nh_node(root, "Pay", summary="FLOW:a")
 50719	    _nh_node(root, "退款_計劃", typ="project", folder="Projects", resp=None, summary="KEY:p")
 50720	    _nh_commit(root, "init")
 50721	    return root
