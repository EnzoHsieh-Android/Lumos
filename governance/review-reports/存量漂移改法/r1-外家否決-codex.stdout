 50740	def t_guard_settle_rewrites_planned_prose():
 50741	    """[S4] settle 轉正把 guard plan 寫的四種預告句改成歷史說法、其他行不動、status 同一次寫入;
 50742	    新版轉正後的推送不被自己的 c1 擋;找不到句型時提醒但照樣成功。
 50743	
 50744	    翻紅釘:拿掉 _guard_settle_rewrite 的呼叫 → ②③紅;第四句前綴拿掉反引號 → ② 第四句紅;
 50745	    c1 改成子字串比對(不從行首)→ ⑤ 被「預告當時為什麼還不做」擋紅。
 50746	    """
 50747	    print("t_guard_settle_rewrites_planned_prose")
 50748	    import datetime
 50749	    today = datetime.date.today().isoformat()
 50750	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 50751	    vault = root / _DR_VAULT
