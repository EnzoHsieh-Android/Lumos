 12327	def _guard_signoff_refs(env):
 12328	    """簽核帳裡帶 --ref 的那些參照。"""
 12329	    import json as _j
 12330	    log = env.vault.parent / ".signoff-log.jsonl"
 12331	    refs = set()
 12332	    try:
 12333	        for ln in log.read_text(encoding="utf-8").splitlines():
 12334	            if not ln.strip():
 12335	                continue
