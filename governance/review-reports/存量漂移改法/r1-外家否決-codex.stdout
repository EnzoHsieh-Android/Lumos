 50861	def t_set_plan_closed_lists_followups():
 50862	    """[S6] lumos set 把計劃改成 done/superseded 時列連帶待辦:有連結的開著的 Issue(寫方向)、跟 c3 同一個集合的
 50863	    pending 驗證紀錄,每項附檢視指令;其他狀態、非計劃不多印;改狀態本身照舊成功。
 50864	
 50865	    翻紅釘:拿掉 set 那段 _drift_print_followups → ①紅;_drift_c3_hit 的 override 拿掉 → ③V1 紅。
 50866	    """
 50867	    print("t_set_plan_closed_lists_followups")
 50868	    v = mkvault()
 50869	    (v / "Issues").mkdir()
 50870	    write(v, "Projects/P_計劃.md", "type: project\nstatus: doing", body="# P\n見 [[Issues/I3]]\n")
 50871	    write(v, "Projects/Q_計劃.md", "type: project\nstatus: doing", body="# Q\n")
 50872	    write(v, "Issues/I1.md", "type: issue\nstatus: open", body="# I1\n跟 [[Projects/P_計劃]] 有關\n")
 50873	    write(v, "Issues/I2.md", "type: issue\nstatus: done", body="# I2\n跟 [[Projects/P_計劃]] 有關\n")
 50874	    write(v, "Issues/I3.md", "type: issue\nstatus: doing", body="# I3\n")
 50875	    write(v, "Verification/V1.md", 'type: verification\nstatus: pending\nplan_refs:\n  - "[[Projects/P_計劃]]"', body="# V1\n")
 50876	    write(v, "Verification/V2.md", 'type: verification\nstatus: pending\nplan_refs:\n  - "[[Projects/P_計劃]]"\n'
 50877	          '  - "[[Projects/Q_計劃]]"', body="# V2\n")
 50878	    write(v, "Verification/V3.md", 'type: verification\nstatus: pending\nguards:\n  - Systems/X\nplan_refs:\n'
 50879	          '  - "[[Projects/P_計劃]]"', body="# V3\n")
 50880	    r = run(v, "set", "Projects/P_計劃", "status", "done")
 50881	    out = r.stdout
 50882	    check("①改狀態成功並列連帶待辦", r.returncode == 0 and "連帶待辦" in out, out + r.stderr)
 50883	    check("②開著的 Issue 列出並寫方向", "Issues/I1(open,它連到計劃)" in out and "Issues/I3(doing,計劃連到它)" in out, out)
 50884	    check("②已結案的 Issue 不列", "Issues/I2" not in out, out)
 50885	    check("③跟 c3 同一個集合:V1 列、另一份計劃還開著的 V2 不列、守衛紀錄 V3 不列",
 50886	          "Verification/V1" in out and "Verification/V2" not in out and "Verification/V3" not in out, out)
 50887	    check("③每項附檢視指令、不給改狀態的指令", "lumos context Issues/I1" in out and "lumos set Issues" not in out, out)
 50888	    r2 = run(v, "set", "Projects/Q_計劃", "status", "doing")
 50889	    check("④不是收尾狀態不多印", r2.returncode == 0 and "連帶待辦" not in r2.stdout, r2.stdout)
 50890	    r3 = run(v, "set", "Issues/I3", "status", "done")
 50891	    check("④不是計劃不多印", r3.returncode == 0 and "連帶待辦" not in r3.stdout, r3.stdout)
