 27051	def _drift_load_acks(root, where=None):
 27052	    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
 27053	    import json as _j
 27054	    raw = None
 27055	    if where is None:
 27056	        fp = Path(root) / _DRIFT_ACKS
 27057	        try:
 27058	            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
 27059	        except OSError:
 27060	            raw = None
 27061	    else:
 27062	        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
 27063	        raw = bl[0] if bl else None
 27064	    out = []
 27065	    for ln in (raw or b"").decode("utf-8", errors="replace").splitlines():
 27066	        try:
 27067	            d = _j.loads(ln)
 27068	        except ValueError:
 27069	            continue
 27070	        if isinstance(d, dict) and d.get("path") and d.get("kind") in _DRIFT_KINDS:
 27071	            out.append(d)
 27072	    return out
