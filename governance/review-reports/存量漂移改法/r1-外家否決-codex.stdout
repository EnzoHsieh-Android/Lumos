 51607	def _py314_fake_env(tmp, entries, extra=None):
 51608	    """造一個只看得到 tmp/bin 的環境:entries={名字: "good"|"old"|"sleep"|"fail"}。
 51609	    good = 指到跑這支測試的 3.14 直譯器;old = 印舊版號回 1 的假直譯器;sleep = 卡住;fail = 一執行就失敗。"""
 51610	    import os as _os
 51611	    b = tmp / "bin"
 51612	    b.mkdir(parents=True, exist_ok=True)
 51613	    for name, kind in entries.items():
 51614	        p = b / name
 51615	        if kind == "good":
 51616	            _os.symlink(sys.executable, p)
 51617	            continue
 51618	        body = {"old": "echo 'OLD 3.9.6'\nexit 1\n", "sleep": "exec /bin/sleep 30\n", "fail": "exit 9\n"}[kind]
 51619	        p.write_text("#!/bin/sh\n" + body, encoding="utf-8")
 51620	        p.chmod(0o755)

