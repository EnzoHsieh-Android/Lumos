 26234	def _drift_vault_rel(root, where):
 26235	    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
 27020	def _drift_probe_scan(nenv, tree, deadline=None):
 27021	    """scan 的乙部分 → (成立的行[發現], 問題[(路徑, 行號, 原文, 原因)])。問題:寫錯的條件、沒帶期限、指到的筆記找不到、
 27022	    file 指到資料夾、symbol/test 的路徑不像檔案路徑、寫在不評估的地方、判不了(分 git 讀不出與超過預算)。"""
 27023	    import time as _t
 27024	
 27025	    def _over():
 27026	        return deadline is not None and _t.monotonic() >= deadline
 27027	    found, probs, per = [], [], []
 27028	    for p in sorted(nenv.notes):
 27029	        rows, dead = _probe_lines(env_text(nenv, p) or "")
 27030	        probs += [(p, no, tx, why) for no, tx, why in dead]
 27031	        per.append((p, rows))
 27032	    if not _over():
 27033	        _drift_probe_prefetch([c for _p, rows in per for _n, _t, pr in rows for c in pr["conds"]], [tree])
 27034	    for p, rows in per:
 27035	        for no, tx, pr in rows:
 27036	            probs += [(p, no, tx, why) for why in _drift_probe_row_problems(pr, nenv, tree)]
 27037	            if not pr["conds"] or pr["bad"]:
 27038	                continue
 27039	            ok = None if _over() else _drift_probe_line(tree, nenv, tuple(pr["conds"]))
 27040	            if ok is None:
 27041	                probs.append((p, no, tx, "判不了(超過預算)" if _over() else
 27042	                              "判不了(git 讀不出程式檔或筆記" + _drift_bad_note(_drift_row_unread(pr["conds"], (nenv,), (tree,))) + ")"))
 27043	            elif ok:
 27044	                found.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [],
 27045	                              "why": "條件已經成立,該處理了" + (f"(期限 {pr['by']})" if pr["by"] else "")})
 27046	    return found, probs
