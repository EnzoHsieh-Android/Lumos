 51546	def t_drift_code_review_r5_regressions():
 51547	    """存量漂移守衛代碼審 r5 的回歸釘。
 51548	
 51549	    ①嚴格:起點那一版解不開也判不了 ②多平台專案:正式行綁 [test:ios:t_x](ios 有定義)算綁了 t_x,settle 只補紀錄;
 51550	    前綴沒定義的照樣不猜 ③doctor 開關提醒:設定檔寫壞、drift_check 空物件、gate 寫 null 都算自己寫了,說明照實講
 51551	    ④考試重放碰到讀不出來的計劃:記成略過,不記成漏
 51552	    """
 51553	    print("t_drift_code_review_r5_regressions")
 51554	    import pathlib, json as _j
 51555	    m = _load_lumos_inproc()
 51556	    f = m._note_status_seq
 51557	    g_ = f.__globals__
 51558	    saved = {k: g_[k] for k in ("_ns_git", "_nodehome_cat_blobs")}
 51559	    p = "docs/kg-knowledge/Verification/G.md"
 51560	    a = "a" * 40
 51561	    try:
 51562	        g_["_ns_git"] = lambda root, *args: ((a + "\0\n" + p + "\0").encode() if "--follow" in args else b"")
 51563	        g_["_nodehome_cat_blobs"] = lambda root, specs, **kw: ([b"---\nstatus: pass\n---\n"] if specs[0].startswith(a)
 51564	                                                               else [b"---\nstatus: pending\n---\n\xff"])
 51565	        check("①嚴格:起點那一版解不開判不了", f(".", "BASE", "TIP", "docs/kg-knowledge", p, strict=True) is None, "")
 51566	        check("①不嚴格:照舊當成讀到的狀態(不整支判不了)", f(".", "BASE", "TIP", "docs/kg-knowledge", p) is not None, "")
 51567	    finally:
 51568	        g_.update(saved)
 51569	    # ②
 51570	    ls = ["---", "summary: |-", "  KEY:★INVARIANT★ 大額退費要人工核可 [test:ios:t_refund]", "---"]
 51571	    check("②ios 有定義:算綁了 t_refund", m._guard_formal_line(ls, 3, "大額退費要人工核可", "t_refund",
 51572	                                                     plat=({"ios": {}, "android": {}}, "android")) is not None, "")
 51573	    check("②前綴沒定義:不猜", m._guard_formal_line(ls, 3, "大額退費要人工核可", "t_refund",
 51574	                                              plat=({"android": {}}, "android")) is None, "")
 51575	    check("②單平台(不切前綴):不算", m._guard_formal_line(ls, 3, "大額退費要人工核可", "t_refund", plat=({}, "x")) is None, "")
 51576	    # ③
 51577	    for label, txt in (("設定檔寫壞", b'{"drift_check": {"gate": "block"},}'), ("drift_check 空物件", b'{"drift_check": {}}'),
 51578	                       ("gate 寫 null", b'{"drift_check": {"gate": null}}')):
 51579	        mode, warns, explicit = m._drift_config(txt)
 51580	        check(f"③{label}:算自己寫了", explicit is True, str((mode, warns, explicit)))
 51581	    root = _nh_repo()
 51582	    _nh_file(root, "scripts/hooks/pre-push", "#!/bin/bash\n# lumos drift check\n")
 51583	    (root / ".lumos").mkdir()
 51584	    (root / ".lumos" / "config.json").write_text('{"drift_check": {"gate": "blokc"}}', encoding="utf-8")
 51585	    _nh_commit(root, "wired")
 51586	    r = run(root / "docs" / "kg-knowledge", "doctor")
 51587	    check("③gate 拼錯:提醒講出寫錯的值", "blokc" in r.stdout, r.stdout[:600])
 51588	    # ④
 51589	    fone = m._drift_exam_one
 51590	    g2 = fone.__globals__
 51591	    sv = {k: g2[k] for k in ("_lens_full_sha", "_drift_vault_rel", "_drift_check_core", "_drift_tree_env")}
 51592	    try:
 51593	        g2["_lens_full_sha"] = lambda root, ref: {"x": "C", "x^": "P"}.get(ref)
 51594	        g2["_drift_vault_rel"] = lambda root, w: "docs/kg-knowledge"
 51595	        g2["_drift_check_core"] = lambda *a_, **k: ([], [], [])
 51596	        g2["_drift_tree_env"] = lambda root, w, v, override=None, **k: m.Env.from_texts(
 51597	            pathlib.Path(v), {"Issues/I.md": "---\ntype: issue\nstatus: open\n---\n# I\n", **(override or {})},
 51598	            unreadable=["Projects/壞.md"])
 51599	        q = {"exam_event": "status_replay", "note": "Issues/I.md", "line": 3, "invalidating_commits": ["x"],
 51600	             "status_targets": ["Projects/壞"]}
 51601	        res = fone(".", "docs/kg-knowledge", q, "C")
 51602	        check("④讀不出來的計劃:記成略過", res[0].startswith("略過"), str(res))
 51603	    finally:
 51604	        g2.update(sv)
