 12244	def _guard_settle_home(env, home_rel, claim, method):
 12245	    """轉正第一步:家筆記的預告行換成正式合約行;已經是正式行(上次做到一半)就不動。成功回 True(失敗已印原因)。"""
 12246	    hpath = env.vault / home_rel
 12247	    try:
 12248	        hlines, _hs, he = load_raw_for_edit(hpath)
 12249	    except (ValueError, RuntimeError) as ex:
 12250	        print(f"擋下:{home_rel} 打不開:{ex}", file=sys.stderr)
 12251	        return False
 12252	    try:
 12253	        _pd = load_platforms(_vault_repo_root(env))
 12254	        plat = (_pd["platforms"] if _pd["multiplatform"] else {}, _pd["default_platform"])
 12255	    except (ValueError, OSError):
 12256	        plat = None
