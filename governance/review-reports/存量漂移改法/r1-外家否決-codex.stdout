 27075	def _drift_ack_key(path, text, kind):
 27076	    return (nfc(str(path)), str(text).strip(), kind)
 27077	
 27078	
 27079	def _drift_split_acked(findings, acks, vault_rel):
 27080	    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。"""
 27081	    keys = {_drift_ack_key(a["path"], a.get("text", ""), a["kind"]) for a in acks}
 27082	    pre = vault_rel.rstrip("/") + "/"
 27083	    left, done = [], []
 27084	    for f in findings:
 27085	        (done if _drift_ack_key(pre + f["path"], f["text"], f["kind"]) in keys else left).append(f)
 27086	    return left, done
 27087	
 27088	
 27089	def _drift_old_reason(f, acks, alive=None):
 27090	    """表態失效時(筆記改名),用「原文與種類相同」找舊理由供照抄。alive=現在還在的筆記路徑(repo 相對):
 27091	    表態原本那篇還在,就不是改名、是另一篇剛好一樣的樣板句——不借它的理由(代碼審 r1 正確性席:
 27092	    守衛紀錄的預告句是樣板,兩篇會一字不差,原本會把 A 的理由印給從沒表態過的 B)。"""
 27093	    for a in reversed(acks):
 27094	        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
 27095	            if alive is not None and nfc(str(a.get("path"))) in alive:
 27096	                continue
 27097	            return a.get("reason")
 27098	    return None
