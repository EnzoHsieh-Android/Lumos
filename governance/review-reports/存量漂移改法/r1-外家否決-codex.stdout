 14894	def cmd_self_audit(env, rel, model="sonnet", date=None):
 14895	    """L4 自足性審計留痕:寫 self_audit: <model>/<date> 到節點 frontmatter。
 14896	    語意:這整篇節點的「自足性」(無主對話脈絡的乾淨 agent 只讀圖譜能不能還原
 14897	    專案現況)已由一個獨立 agent 審過並通過。對應 guard audit 的角色(乾淨 agent
 14898	    審後蓋戳),但程式路徑獨立——這是節點級戳記,guard audit 是行級 [audit:]。
 14899	    工具只記留痕,不證明審計真乾淨——派 agent 的乾淨脈絡/中立 prompt 靠主對話誠實。"""
 14900	    import datetime
 14901	    if date is None:
 14902	        date = datetime.date.today().isoformat()
 14903	    else:
 14904	        try:
 14905	            datetime.date.fromisoformat(date)
 14906	        except ValueError:
 14907	            print(f"擋下:--date 要寫成 年-月-日(例如 2026-08-22),你給的是 {date!r}", file=sys.stderr)
 14908	            return 2
 14909	    return cmd_set(env, rel, "self_audit", f"{model}/{date}")
 14910	
 14911	
 14912	def _disk_spelling(root, relp):
 14913	    """relp 每一層照磁碟上的真實檔名拼回來(大小寫、Unicode 寫法以磁碟為準;只差 Unicode 寫法的算同一個)。
 14914	    回 (真實拼法, None);某一層目錄讀不到檔名清單回 (None, 那一層目錄)——擋不擋由呼叫端決定。"""
 14915	    cur, real = root, []
 14916	    for part in relp.split("/"):
 14917	        try:
 14918	            names = os.listdir(cur)
 14919	        except OSError:
 14920	            return None, ("/".join(real) or ".")
 14921	        hit = part if part in names else next((n for n in names if nfc(n) == nfc(part)), None)
 14922	        if hit is None:
 14923	            hit = next((n for n in names if nfc(n).casefold() == nfc(part).casefold()), part)
 14924	        real.append(hit)
 14925	        cur = cur / hit
 14926	    return "/".join(real), None
 14927	
 14928	
 14929	def _about_code_key(root, value):
 14930	    """about_code 一項「指的是哪一支檔」的比對鍵(append 去重、remove 找項共用)。
 14931	    檔案還在:用磁碟上的真實位置——解 symlink、大小寫與 Unicode 寫法照磁碟(2026-09-10 代碼審 r3:
 14932	    只做字面正規化時,symlink 別名、舊的大小寫錯字項都會被當成另一支檔,疊出重複又刪不掉);
 14933	    檔案不在了:退回字面正規化(remove 要清得掉檔已刪的舊項)。比較一律用 NFC。"""
 14934	    lex = _posix_norm(strip_quotes(str(value).strip()))
 14935	    if not lex:
 14936	        return ""
 14937	    try:
 14938	        target = (root / lex).resolve()
 14939	        rel = target.relative_to(root).as_posix()
 14940	    except (ValueError, OSError):

