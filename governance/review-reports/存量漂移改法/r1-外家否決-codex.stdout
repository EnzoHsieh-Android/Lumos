 51436	    r = run(root / "docs" / "kg-knowledge", "drift", "scan")
 51437	    check("⑨磁碟讀檔失敗也列成判不了(同一個管道)", "判不了" in r.stdout and "Bad.md" in r.stdout, r.stdout)
 51438	    # ⑧ c3 寫法
 51439	    base = {"Projects/P.md": "---\ntype: project\nstatus: done\n---\n# P\n"}
