 50622	def t_note_audit_acceptance_regressions():
 50623	    """代碼審驗收輪(兩席)抓到的問題各一條回歸:decision-amend 別的遠端分支多一篇有 d1 的無關筆記時,全新筆記照准改;
 50624	    已加進 git 但改寫太多、git 配不成改名的搬檔照拒;CI 多行腳本裡的 fetch-depth 字樣不算設定;
 50625	    註解裡有撇號也切得掉;整步被行尾註解掉的呼叫不算有呼叫。"""
 50626	    print("t_note_audit_acceptance_regressions")
 50627	    import subprocess as sp
 50628	    m = _load_lumos_inproc()
 50629	    tmp = Path(tempfile.mkdtemp(prefix="gctl-na-acc-"))
 50630	    bare = tmp / "r.git"
 50631	    sp.run(["git", "init", "-q", "--bare", str(bare)], capture_output=True)
 50632	    root, _b = _na_repo()
 50633	    dec = "decisions:\n  - id: d1\n    decided: 2026-09-01\n    context: 已推的脈絡\n    why_chosen: 因為一"
 50634	    _nh_node(root, "D", extra=dec, body="\n".join(f"正文第 {i} 行" for i in range(30)))
 50635	    _nh_commit(root, "d")
 50636	    _nh_git(root, "remote", "add", "origin", str(bare))
 50637	    _nh_git(root, "push", "-q", "origin", "HEAD:refs/heads/main")
 50638	    main = _nh_git(root, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
 50639	    _nh_git(root, "checkout", "-qb", "feat")
 50640	    _nh_node(root, "Other", extra="decisions:\n  - id: d1\n    decided: 2026-09-02\n    context: 別人的決策", body="z")
 50641	    _nh_commit(root, "other note on feat")
 50642	    _nh_git(root, "push", "-q", "origin", "feat")
 50643	    _nh_git(root, "checkout", "-q", main)
 50644	    vault = root / _NA_VAULT
 50645	    _nh_node(root, "Fresh", extra="decisions:\n  - id: d1\n    decided: 2026-09-03\n    context: 新的", body="y")
 50646	    check("①前置:別的遠端分支真的有一篇工作目錄沒有、也帶 d1 的筆記",
 50647	          "Other.md" in _nh_git(root, "diff", "--name-status", "origin/feat", "--", _NA_VAULT).stdout, "")
 50648	    r = run(vault, "decision-amend", "Systems/Fresh", "d1", "--field", "context", "--text", "新的改")
 50649	    check("①別的遠端分支多一篇無關筆記:全新筆記照准改", r.returncode == 0, r.stderr[-300:])
 50650	    (vault / "Systems" / "Fresh.md").unlink()
 50651	    # ② 已加進 git、改寫太多、git 配不成改名的搬檔:照拒
 50652	    old = vault / "Systems" / "D.md"
 50653	    t = old.read_text(encoding="utf-8").replace("\n".join(f"正文第 {i} 行" for i in range(30)), "\n".join(f"全部重寫 {i}" for i in range(30)))
 50654	    (vault / "Systems" / "Moved.md").write_text(t, encoding="utf-8")
 50655	    _nh_git(root, "rm", "-q", f"{_NA_VAULT}/Systems/D.md")
 50656	    _nh_git(root, "add", f"{_NA_VAULT}/Systems/Moved.md")
 50657	    ns = _nh_git(root, "diff", "--name-status", "-M", "origin/main", "--", _NA_VAULT).stdout
 50658	    check("②前置:git 真的配不成改名(D 加 A,不是 R)", "\nA\t" in "\n" + ns and "D\t" in ns and "R" not in ns.split("\t")[0], ns)
 50659	    r = run(vault, "decision-amend", "Systems/Moved", "d1", "--field", "context", "--text", "偷改")
 50660	    check("②配不成改名的搬檔:遠端不見的那篇有一模一樣的決策 → 拒絕", r.returncode != 0 and "decision-supersede" in r.stderr,
 50661	          r.stdout + r.stderr[-300:])
 50662	    # ③ CI:多行腳本裡的字樣不算設定;註解有撇號照切;整步被行尾註解掉不算呼叫
 50663	    wf = tmp / "wf"
 50664	    wf.mkdir()
 50665	    call = "      - run: python3 scripts/lumos note-audit check --diff x\n"
 50666	    cases = {
 50667	        "多行腳本裡的 fetch-depth 字樣": ("jobs:\n  audit:\n    steps:\n      - uses: actions/checkout@v4\n      - run: |\n"
 50668	                                   "          echo fetch-depth: 0\n" + call, [("audit",)]),
 50669	        "註解有撇號": ("jobs:\n  audit:\n    steps:\n      - uses: actions/checkout@v4\n        with:\n"
 50670	                  "          fetch-depth: 1  # don't: fetch-depth: 0 is slow\n" + call, [("audit",)]),
 50671	        "設定行照認(對照組)": ("jobs:\n  audit:\n    steps:\n      - uses: actions/checkout@v4\n        with:\n"
 50672	                       "          fetch-depth: 0\n" + call, []),
 50673	    }
 50674	    for label, (y, want) in cases.items():
 50675	        f = wf / f"{abs(hash(label))}.yml"
 50676	        f.write_text(y, encoding="utf-8")
 50677	        got = m._ci_jobs_calling_without_full_history([f], "note-audit check")
 50678	        check(f"③{label}", [j for _f, j in got] == [w[0] for w in want], str(got))
 50679	    txt = m._ci_workflow_texts([_w for _w in [wf / "c.yml"] if _w.write_text(
 50680	        "jobs:\n  a:\n    steps:\n      - run: echo skip  # python3 scripts/lumos note-audit check (it's off)\n", encoding="utf-8") or True])
 50681	    check("③b 整步被行尾註解掉(註解裡有撇號):不算有呼叫", not any("note-audit check" in l for _p, ls in txt for l in ls), str(txt))
 50682	
