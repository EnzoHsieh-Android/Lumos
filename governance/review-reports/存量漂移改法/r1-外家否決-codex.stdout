 27101	def cmd_drift_ack(env, node, line, kind, reason):
 27102	    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。"""
 27103	    import datetime, secrets
 27104	    if kind not in _DRIFT_KINDS:
 27105	        print(f"擋下:--kind 只能是 {'/'.join(_DRIFT_KINDS)}", file=sys.stderr)
 27106	        return 2
 27107	    if len((reason or "").strip()) < 4:
 27108	        print("擋下:--reason 要寫為什麼照留,至少 4 個字", file=sys.stderr)
 27109	        return 2
 27110	    rel = env.find(node)
 27111	    if rel is None:
 27112	        return _node_not_found(env, node, write_side=True)
 27113	    text = env_text(env, rel)
 27114	    lines = (text or "").split("\n")
 27115	    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
 27116	        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
 27117	        return 2
 27118	    root = _vault_repo_root(env)
 27119	    try:
 27120	        vault_rel = env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 27121	    except ValueError:
 27122	        vault_rel = env.vault.name
 27123	    head = ""
 27124	    for ln in reversed(lines[:line]):
 27125	        if ln.startswith("#"):
 27126	            head = ln.lstrip("#").strip()
 27127	            break
 27128	    token = "DACK-" + secrets.token_hex(4)
 27129	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 27130	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
 27131	    fp = Path(root) / _DRIFT_ACKS
 27132	    try:
 27133	        fp.parent.mkdir(parents=True, exist_ok=True)
 27134	    except OSError as ex:
 27135	        print(f"擋下:建不了 {fp.parent}:{ex}", file=sys.stderr)
 27136	        return 2
