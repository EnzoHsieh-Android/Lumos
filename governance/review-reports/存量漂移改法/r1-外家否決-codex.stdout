 13683	        if objs:
 13684	            p_ = max(pct[s] for s in objs)
 13685	            risk = p_ * (1 + math.log1p(days))
 13686	            band = "高" if p_ >= 2 / 3 else ("中" if p_ >= 1 / 3 else "低")
 13687	            linked.append((-risk, -days, rel, p_, band, days))
 13688	        else:
 13689	            unlinked.append((-days, rel, days))
 13690	    linked.sort()
 13691	    unlinked.sort()
 13692	    for negr, _nd, rel, p_, band, days in linked:
 13693	        arch = " [archived]" if "/Archive/" in rel else ""
 13694	        print(f"{rel} [stale]{arch}  risk={-negr:.2f} band={band} 天數={days}")
 13695	    for _nd, rel, days in unlinked:
 13696	        arch = " [archived]" if "/Archive/" in rel else ""
 13697	        print(f"{rel} [stale]{arch}  無鏈組 天數={days}")
 13698	    return 0
