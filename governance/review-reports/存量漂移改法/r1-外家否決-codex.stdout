 28741	def _keys_mentioned(text, keys):
 28742	    """回 text 裡★整字★出現過的 keys(前後都不是英數字底線;key 照字面比,句點不當萬用字元)。
 28743	    整字比對的唯一定義:測試執行器的 --suite keys 與推送前「自主迴圈要不要整支跑」都用它
 28744	    (2026-09-18 代碼審 code-light自主迴圈 r1 架構席:掛鉤原本自己用 grep -w,句點被當萬用字元,跟執行器判得不一樣)。"""
 28745	    return [k for k in keys if k and re.search(r"(?<![A-Za-z0-9_])" + re.escape(k) + r"(?![A-Za-z0-9_])", text)]
