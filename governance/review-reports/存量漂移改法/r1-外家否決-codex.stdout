 14309	def _fetch_text(url, cache):
 14310	    """下載文字資源並快取(scripts/vendor/)。離線重複 export 不再抓。
 14311	    用 curl(走系統憑證;macOS python urllib 常無 cert store 致 SSL verify 失敗)。"""
 14312	    import subprocess
 14313	    if cache.exists():
 14314	        return cache.read_text(encoding="utf-8")
 14315	    cache.parent.mkdir(parents=True, exist_ok=True)
 14316	    txt = subprocess.run(["curl", "-fsSL", url], capture_output=True, text=True,
 14317	                         timeout=60, check=True).stdout
 14318	    if not txt:
 14319	        raise RuntimeError("空回應")
 14320	    cache.write_text(txt, encoding="utf-8")
 14321	    return txt
