 50818	def t_guard_commands_hold_vault_lock():
 50819	    """[S19] guard plan/settle/abandon 讀家筆記時已經拿著寫入鎖(從讀到寫整段在鎖裡,另一個程序才蓋不掉)。
 50820	
 50821	    翻紅釘:把任一支的 `with _vault_write_lock` 拿掉 → 對應那條紅。
 50822	    """
 50823	    print("t_guard_commands_hold_vault_lock")
 50824	    m = _load_lumos_inproc()
 50825	    v = mkvault()
 50826	    write(v, "Systems/Pay.md", "type: system\nstatus: doing\nsummary: |-\n  FLOW:a", body="# Pay\n")
 50827	    write(v, "Projects/退款_計劃.md", "type: project\nstatus: doing", body="# 退款\n")
 50828	    seen = []
 50829	    orig = m.load_raw_for_edit
 50830	
 50831	    def spy(path, *a, **kw):
 50832	        if Path(path).name == "Pay.md":
 50833	            seen.append(bool(m._VAULT_LOCK_HELD))
 50834	        return orig(path, *a, **kw)
 50835	    import contextlib, io
 50836	    m.load_raw_for_edit = spy
 50837	    try:
 50838	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
 50839	            rc = m.cmd_guard_plan(m.Env(v), "Systems/Pay", "合約甲", "Projects/退款_計劃", "P1", "2099-12-31",
 50840	                                  "還沒定", "enzo", name="合約甲")
 50841	        check("①plan 讀家筆記時拿著鎖", rc == 0 and seen and all(seen), f"rc={rc} {seen}")
 50842	        g = [x for x in (v / "Verification").glob("*.md")][0]
 50843	        seen.clear()
 50844	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
 50845	            rc = m.cmd_guard_settle(m.Env(v), "Verification/" + g.stem, "t_a")
 50846	        check("②settle 讀家筆記時拿著鎖", rc == 0 and seen and all(seen), f"rc={rc} {seen}")
 50847	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
 50848	            m.cmd_guard_plan(m.Env(v), "Systems/Pay", "合約乙", "Projects/退款_計劃", "P1", "2099-12-31",
 50849	                             "還沒定", "enzo", name="合約乙")
 50850	        g2 = [x for x in (v / "Verification").glob("*.md") if "合約乙" in x.stem][0]
 50851	        run(v, "signoff", "Verification/" + g2.stem, "--note", "確認不做了", "--ref", "Verification/" + g2.stem)
 50852	        seen.clear()
 50853	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
 50854	            rc = m.cmd_guard_abandon(m.Env(v), "Verification/" + g2.stem, "決定不做")
 50855	        check("③abandon 讀家筆記時拿著鎖", rc == 0 and seen and all(seen), f"rc={rc} {seen}")
 50856	    finally:
 50857	        m.load_raw_for_edit = orig
 50858	    check("④鎖用完放掉", not m._VAULT_LOCK_HELD, str(m._VAULT_LOCK_HELD))
 50859	
