 28709	def _test_suite_for_range(repo_root, diff_range):
 28710	    """這段範圍推送前/CI 該跑哪個測試範圍。回 dict:suite(docs|full)、reason、code(非文件且是程式檔的清單)、
 28711	    light_ok(非文件檔★全部★是「需要有家的程式檔」——小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
 28712	    會從它眼皮下溜過,所以 light 不准帶著這種檔一起少跑全套;代碼審 r1 資安席)。
 28713	    自己用 git 算檔清單(不用 pitfalls 的 files:那份已經把 .json/.jsonl 按副檔名擋掉);--no-renames:從 scripts/ 搬進 docs/ 的檔會拆成
 28714	    「刪程式檔+加文件」,刪的那支讓它跑全套。簿記帳與卷證不算;算不出範圍 → full(fail-safe 是多跑,不是少跑)。"""
 28715	    base = _range_base(repo_root, diff_range)
 28716	    full = {"suite": "full", "code": [], "light_ok": False, "graph": False}
 28717	    try:
 28718	        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", "-z",
 28719	                            "--no-renames", diff_range, "--"], capture_output=True, text=True, errors="replace")
 28720	    except OSError:
 28721	        return dict(full, reason="算不出改動清單")
 28722	    if r.returncode != 0:
 28723	        return dict(full, reason=f"範圍 {diff_range} 算不出來")
 28724	    raw = [f for f in r.stdout.split("\0") if f.strip()]
 28725	    guard = [f for f in raw if f in _DOCS_ONLY_NEVER or f.startswith(tuple(w for w in _DOCS_ONLY_NEVER if w.endswith("/")))]
 28726	    if guard:
 28727	        return dict(full, reason="改到 " + "、".join(guard[:3]) + " 這種守衛本身的檔(基準線/留痕),要全套")
 28728	    files = [f for f in raw if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS))]
 28729	    non_docs = [f for f in files if not _docs_only_file(f)]
 28730	    if not non_docs:
