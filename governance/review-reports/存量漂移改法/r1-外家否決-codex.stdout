 28685	    if not any(path == w or (w.endswith("/") and path.startswith(w)) for w in _DOCS_ONLY_PATHS):
 28686	        return False
 28687	    if path in _DOCS_ONLY_PATHS:          # 根目錄的全名白名單(LICENSE 沒副檔名)
 28688	        return True
 28689	    base = path.rsplit("/", 1)[-1]
 28690	    return "." in base.lstrip(".") and ("." + base.rsplit(".", 1)[1].lower()) in _DOCS_ONLY_EXTS
