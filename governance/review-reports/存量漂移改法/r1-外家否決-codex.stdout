 27189	def cmd_drift_check(repo=None, diff_range=None):
 27190	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 27191	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
 27192	    import time as _t
 27193	    root = _note_audit_root(repo)
 27194	    if root is None:
 27195	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 27196	        return 0
 27197	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 27198	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 27199	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 27200	        return 0
 27201	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 27202	                                               mark=_DRIFT_GOLIVE_MARK)
 27203	    if tip is None or isinstance(tip, int):
 27204	        return tip if isinstance(tip, int) else 0
 27205	    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 27206	    for w in warns:
 27207	        print(f"提醒:{w}", file=sys.stderr)
 27208	    if mode == "off":
 27209	        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 27210	        return 0
 27211	    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 27212	                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 27213	    acks = _drift_load_acks(root, tip)
 27214	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 27215	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 27216	    lst = _nodehome_list(root, tip)
 27217	    alive = set(lst[1]) if lst else None
 27218	    if listed:
 27219	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 27220	        _drift_print_findings(listed, sys.stderr, acks, alive)
 27221	    if not must and not unknown:
 27222	        return 0
 27223	    return _drift_report_must(root, mode, must, unknown, acks, alive)
 27224	
