 26193	def _drift_print_followups(env, rel, new_status):
 26194	    items = _drift_plan_followups(env, rel, new_status)
 26195	    if not items:
 26196	        return
 26197	    print(f"連帶待辦(這份計劃收尾了,下面 {len(items)} 篇連著它;只列出、不擋——連結有時只是參考,是不是該結案要人看):")
 26198	    for kind, p, why in items:
 26199	        print(f"  · {kind} {p[:-3]}({why})")
 26200	        print(f"      看:lumos context {p[:-3]}")
