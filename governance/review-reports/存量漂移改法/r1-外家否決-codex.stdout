 50861	def t_set_plan_closed_lists_followups():
 50862	    """[S6] lumos set 把計劃改成 done/superseded 時列連帶待辦:有連結的開著的 Issue(寫方向)、跟 c3 同一個集合的
 50863	    pending 驗證紀錄,每項附檢視指令;其他狀態、非計劃不多印;改狀態本身照舊成功。
 50864	
 50865	    翻紅釘:拿掉 set 那段 _drift_print_followups → ①紅;_drift_c3_hit 的 override 拿掉 → ③V1 紅。
 50866	    """
 50867	    print("t_set_plan_closed_lists_followups")
 50868	    v = mkvault()
 50869	    (v / "Issues").mkdir()
 50870	    write(v, "Projects/P_計劃.md", "type: project\nstatus: doing", body="# P\n見 [[Issues/I3]]\n")
 50871	    write(v, "Projects/Q_計劃.md", "type: project\nstatus: doing", body="# Q\n")
 50872	    write(v, "Issues/I1.md", "type: issue\nstatus: open", body="# I1\n跟 [[Projects/P_計劃]] 有關\n")
 50873	    write(v, "Issues/I2.md", "type: issue\nstatus: done", body="# I2\n跟 [[Projects/P_計劃]] 有關\n")
 50874	    write(v, "Issues/I3.md", "type: issue\nstatus: doing", body="# I3\n")
