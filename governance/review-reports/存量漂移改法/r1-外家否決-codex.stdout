 50939	def t_drift_check_state_events_in_range():
 50940	    """[S8][S1][S3] 推送範圍裡有守衛紀錄 pending→pass 且留著預告句 → 擋那一篇的 c1;c2–c5 只列出;範圍外的不擋、scan 照列;
 50941	    三態開關、略過只認 1、上線點之前的不查;表態要提交才算、改那行就失效並印舊理由、理由太短拒絕。
 50942	
 50943	    翻紅釘:c1 不看「範圍裡轉正」→ ⑤範圍外那篇紅;表態讀工作目錄 → ⑧紅;略過改成有設就跳 → ③紅。
 50944	    """
 50945	    print("t_drift_check_state_events_in_range")
 50946	    import json as _j
 50947	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 50948	    vault = root / _DR_VAULT
 50949	    (vault / "Issues").mkdir(exist_ok=True)
 50950	    (vault / "Verification" / "Old.md").write_text(_dr_guard_text("pass", claim="早就轉正的"), encoding="utf-8")
 50951	    (vault / "Verification" / "G.md").write_text(_dr_guard_text("pending"), encoding="utf-8")
 50952	    _nh_file(root, f"{_DR_VAULT}/Issues/I.md", "---\ntype: issue\nstatus: open\n---\n# I\n[[Projects/退款_計劃]]\n")
 50953	    _nh_commit(root, "base")
 50954	    base = _na_head(root)
 50955	    g = vault / "Verification" / "G.md"
 50956	    g.write_text(g.read_text(encoding="utf-8").replace("status: pending", "status: pass").replace("status/pending", "status/pass"),
 50957	                 encoding="utf-8")
 50958	    p = vault / "Projects" / "退款_計劃.md"
 50959	    p.write_text(p.read_text(encoding="utf-8").replace("status: doing", "status: done").replace("status/doing", "status/done"),
 50960	                 encoding="utf-8")
 50961	    _nh_commit(root, "舊版 settle 的轉正,順手收尾計劃")
 50962	    rng = f"{base}..HEAD"
 50963	    rc, out = _dr(root, "check", "--diff", rng)
 50964	    check("①block:範圍裡轉正還留著預告句 → rc1", rc == 1 and "Verification/G.md" in out, out)
 50965	    check("②c1 一句一筆都列出", out.count("[c1 ") == 4, out)
 50966	    check("②c2 只列出(計劃在範圍裡收尾、連著開著的 Issue)", "只列出" in out and "Issues/I.md" in out, out)
 50967	    check("⑤範圍外早就轉正的那篇不擋", "Old.md" not in out, out)
 50968	    fs = _dr_scan(vault)
 50969	    check("⑤但 scan 照列範圍外那篇", any(f["path"] == "Verification/Old.md" and f["kind"] == "c1" for f in fs), str(fs)[:300])
 50970	    rc, out = _dr(root, "check", "--diff", rng, env={"LUMOS_SKIP_DRIFT_CHECK": "1"})
 50971	    check("③略過設成 1:放行並記 skipped-env", rc == 0 and "skipped-env" in (vault.parent / ".governance-log.jsonl").read_text(
 50972	        encoding="utf-8"), out)
 50973	    rc, out = _dr(root, "check", "--diff", rng, env={"LUMOS_SKIP_DRIFT_CHECK": "0"})
 50974	    check("③設成別的值不算略過", rc == 1, out)
 50975	    (root / ".lumos" / "config.json").write_text(_j.dumps({"drift_check": {"gate": "warn"}}), encoding="utf-8")
 50976	    _nh_commit(root, "warn")
 50977	    rc, out = _dr(root, "check", "--diff", rng)
 50978	    check("④warn:只印、rc0、記 warned", rc == 0 and "提醒(drift_check.gate=warn" in out and "\"warned\"" in (
 50979	        vault.parent / ".governance-log.jsonl").read_text(encoding="utf-8"), out)
 50980	    (root / ".lumos" / "config.json").write_text(_j.dumps({"drift_check": {"gate": "off"}}), encoding="utf-8")
 50981	    _nh_commit(root, "off")
 50982	    rc, out = _dr(root, "check", "--diff", rng)
 50983	    check("④off:放行", rc == 0 and "關掉" in out, out)
 50984	    (root / ".lumos" / "config.json").write_text(_j.dumps({"drift_check": {"gate": "block"}}), encoding="utf-8")
 50985	    _nh_commit(root, "block again")
 50986	    # 表態
 50987	    lines = g.read_text(encoding="utf-8").split("\n")
 50988	    nums = [i + 1 for i, l in enumerate(lines) if l.strip().startswith(("WHY:[", "TEST:還沒有", "為什麼還不做:", "做完之後跑"))]
 50989	    r = run(vault, "drift", "ack", "Verification/G", str(nums[0]), "--kind", "c1", "--reason", "短")
 50990	    check("⑦理由少於 4 個字拒絕", r.returncode == 2, r.stdout + r.stderr)
 50991	    for n in nums:
 50992	        r = run(vault, "drift", "ack", "Verification/G", str(n), "--kind", "c1", "--reason", "歷史紀錄照留,不改")
 50993	    check("⑦表態寫進表態檔並記 acked", r.returncode == 0 and (root / "governance" / "drift-acks.jsonl").is_file()
 50994	          and "\"acked\"" in (vault.parent / ".governance-log.jsonl").read_text(encoding="utf-8"), r.stdout + r.stderr)
 50995	    rc, out = _dr(root, "check", "--diff", rng)
 50996	    check("⑧表態還沒提交:照擋(只認被推送頂端提交裡的表態檔)", rc == 1, out)
 50997	    _nh_commit(root, "acks")
 50998	    rc, out = _dr(root, "check", "--diff", f"{base}..HEAD")
 50999	    check("⑧表態提交後:不再擋", rc == 0, out)
 51000	    g.write_text(g.read_text(encoding="utf-8").replace("為什麼還不做:下游介面還沒定案", "為什麼還不做:下游介面還沒定案,改了一個字"),
 51001	                 encoding="utf-8")
 51002	    _nh_commit(root, "edit line")
 51003	    rc, out = _dr(root, "check", "--diff", f"{base}..HEAD")
 51004	    check("⑨改了那一行:表態失效照擋", rc == 1 and "為什麼還不做" in out, out)
 51005	    # 上線點:標記在範圍中段才出現,之前的轉正不查
 51006	    root2 = _dr_repo(cfg={"drift_check": {"gate": "block"}}, golive=False)
 51007	    v2 = root2 / _DR_VAULT
 51008	    (v2 / "Verification" / "G.md").write_text(_dr_guard_text("pending"), encoding="utf-8")
 51009	    _nh_commit(root2, "base")
 51010	    b2 = _na_head(root2)
 51011	    gg = v2 / "Verification" / "G.md"
 51012	    gg.write_text(gg.read_text(encoding="utf-8").replace("status: pending", "status: pass"), encoding="utf-8")
 51013	    _nh_commit(root2, "舊轉正")
 51014	    _nh_file(root2, "scripts/hooks/pre-push", "#!/bin/bash\n# lumos drift check\n")
 51015	    _nh_commit(root2, "上線")
 51016	    rc, out = _dr(root2, "check", "--diff", f"{b2}..HEAD")
 51017	    check("⑩上線點之前的轉正不查(起點截到推送前掛鉤出現標記的提交)", rc == 0, out)
 51018	
 51019	
 51020	def t_drift_unknown_blocks_check_not_scan():
 51021	    """[S2] check 判不了(git 算不出範圍事件)→ 算要處理、印原因(block 模式 rc1)。
 51022	
 51023	    乙那一半:條件指到的程式檔讀不出來 → check 擋、scan 列判不了且不寫帳。
 51024	
 51025	    翻紅釘:判不了改成放行 → ①②紅;scan 把判不了當不成立 → ③紅。
 51026	    """
 51027	    print("t_drift_unknown_blocks_check_not_scan")
 51028	    import contextlib, io
 51029	    m = _load_lumos_inproc()
 51030	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 51031	    base = _na_head(root)
 51032	    _nh_node(root, "Pay", summary="FLOW:b")
 51033	    _nh_commit(root, "c")
 51034	    orig = m._drift_range_events
 51035	    m._drift_range_events = lambda *a, **k: None
 51036	    err = io.StringIO()
 51037	    try:
 51038	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
 51039	            rc = m.cmd_drift_check(repo=str(root), diff_range=f"{base}..HEAD")
 51040	    finally:
 51041	        m._drift_range_events = orig
 51042	    check("①判不了:算要處理、rc1、印原因", rc == 1 and "判不了" in err.getvalue(), err.getvalue())
 51043	    # 乙那一半(圖譜一致 F3:原本只測甲的路徑):讀不出條件指到的程式檔 → check 擋、scan 列判不了且不寫帳
 51044	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 51045	    base = _na_head(root)
 51046	    _nh_file(root, "src/runner.py", "def start_up():\n    pass\n")
 51047	    _nh_node(root, "Pay", summary="FLOW:a", body="REVISIT:[when-symbol:src/runner.py::start_up][by:2099-12-31] 補測試")
 51048	    _nh_commit(root, "c")
 51049	    tip = _na_head(root)
 51050	    orig_cat, orig_ev = m._nodehome_cat_blobs, m._gate_event_or_warn
 51051	    events = []
 51052	    # 讀程式檔改用內容編號(乙代碼審 r3),所以認的是 runner.py 的內容編號,不是路徑
 51053	    runner = _nh_git(root, "rev-parse", "HEAD:src/runner.py").stdout.strip()
 51054	    m._nodehome_cat_blobs = lambda r, specs, **k: None if any(x == runner or "runner.py" in x for x in specs) \
 51055	        else orig_cat(r, specs, **k)
 51056	    m._gate_event_or_warn = lambda *a, **k: events.append(a)
 51057	    err, out = io.StringIO(), io.StringIO()
 51058	    try:
 51059	        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
 51060	            rc = m.cmd_drift_check(repo=str(root), diff_range=f"{base}..HEAD")
 51061	        n_check = len(events)
 51062	        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
 51063	            rs = m.cmd_drift_scan(m.Env(root / "docs" / "kg-knowledge"), at=tip, as_json=True)
 51064	    finally:
 51065	        m._nodehome_cat_blobs, m._gate_event_or_warn = orig_cat, orig_ev
 51066	    check("②乙的條件判不了:check 算要處理、rc1、指到那一行", rc == 1 and "判不了" in err.getvalue()
 51067	          and "Systems/Pay.md" in err.getvalue(), err.getvalue())
 51068	    import json as _j
 51069	    probs = [x["why"] for x in _j.loads(out.getvalue() or "{}").get("problems", [])]
 51070	    check("③乙的條件判不了:scan 列成判不了、rc0、不寫帳", rs == 0 and any("判不了" in w for w in probs)
 51071	          and len(events) == n_check, str(probs) + str(events))
 51072	
