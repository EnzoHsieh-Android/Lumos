 50724	def _dr(root, *args, env=None):
 50725	    import subprocess as sp, os as _os
 50726	    e = dict(_os.environ)
 50727	    e.pop("LUMOS_SKIP_DRIFT_CHECK", None)
 50728	    if env:
 50729	        e.update(env)
 50730	    r = sp.run([sys.executable, GRAPHCTL, "drift", *args, "--repo", str(root)], capture_output=True, text=True, env=e)
 50731	    return r.returncode, r.stdout + r.stderr
 50732	
 50733	
 50734	def _dr_scan(vault, *extra):
 50735	    import json as _j
 50736	    r = run(vault, "drift", "scan", "--json", *extra)
 50737	    return _j.loads(r.stdout)["findings"] if r.returncode == 0 else r.stdout + r.stderr
