 27391	def _drift_set_status_text(text, status):
 27392	    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
 27393	    lines = text.split("\n")
 27394	    e = _drift_fm_end(lines)
 27395	    if not e:
 27396	        return text
 27397	    fm = edit_fm_scalar(lines[1:e], "status", status)
 27398	    fm, _s = edit_fm_sync_status_tag(fm, status)
 27399	    return "\n".join(lines[:1] + fm + lines[e:])
