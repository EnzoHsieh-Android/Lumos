 51190	         "Verification/V2.md": "---\ntype: verification\nstatus: pending\nplan_refs:\n  - \"[[退款]]\"\n---\n# V\n"}
 51191	    e = m.Env.from_texts(Vp, T)
 51192	    fu = m._drift_plan_followups(e, "Projects/退款.md", "done")
 51193	    check("⑤明確寫路徑的照列;只寫檔名、同名猜不準的另列並註明猜不準(不靜默猜第一篇)",
 51194	          [p for _k, p, _w in fu] == ["Verification/V1.md", "Verification/V2.md"] and "猜不準" in fu[1][2], str(fu))
