 50894	def t_drift_state_consistency_checks():
 50895	    """[S7] c1–c5 各自成立與不成立判對、每筆回報所在行(c1 一句一筆);c3 排除空的/壞的/非計劃的 plan_refs 與守衛紀錄;
 50896	    c4 同一句有「未提交」與「工作樹」照樣成立、「釘在某提交的乾淨工作樹」不成立。
 50897	
 50898	    翻紅釘:c4 加回「含工作樹就排除」→ ⑤E3 那種寫法紅;c1 改成一篇一筆 → ②紅;c3 拿掉「全都是計劃」→ ④紅。
 50899	    """
 50900	    print("t_drift_state_consistency_checks")
 50901	    v = mkvault()
 50902	    (v / "Issues").mkdir()
 50903	    write(v, "Systems/Pay.md", "type: system\nstatus: doing\nsummary: |-\n"
 50904	          "  KEY:★INVARIANT★ 半套的合約 [test:t_x] [audit:opus/2026-09-01]", body="# Pay\n")
 50905	    write(v, "Projects/Done_計劃.md", "type: project\nstatus: done", body="# D\n")
 50906	    write(v, "Projects/Open_計劃.md", "type: project\nstatus: doing", body="# O\n")
 50907	    (v / "Verification" / "G1.md").write_text(_dr_guard_text("pass"), encoding="utf-8")
 50908	    (v / "Verification" / "G2.md").write_text(_dr_guard_text("pass", prose=False), encoding="utf-8")
 50909	    (v / "Verification" / "G3.md").write_text(_dr_guard_text("pass", settled_why=True).replace(
 50910	        "  TEST:還沒有測試在守這條;最遲 2099-12-31 要做完,負責人 enzo\n", "").replace("為什麼還不做:", "預告當時為什麼還不做:")
 50911	        .replace("做完之後跑 `lumos guard settle` 轉正,不要手改狀態。", "(2026-09-20 已轉正)"), encoding="utf-8")
 50912	    (v / "Verification" / "G4.md").write_text(_dr_guard_text("pending", claim="半套的合約"), encoding="utf-8")
 50913	    write(v, "Issues/I.md", "type: issue\nstatus: open", body="# I\n[[Projects/Done_計劃]]\n")
 50914	    write(v, "Verification/V_ok.md", 'type: verification\nstatus: pending\nplan_refs:\n  - "[[Projects/Done_計劃]]"', body="# v\n")
 50915	    write(v, "Verification/V_empty.md", "type: verification\nstatus: pending\nplan_refs: []", body="# v\n")
 50916	    write(v, "Verification/V_ghost.md", 'type: verification\nstatus: pending\nplan_refs:\n  - "[[Projects/不存在]]"', body="# v\n")
 50917	    write(v, "Verification/V_issue.md", 'type: verification\nstatus: pending\nplan_refs:\n  - "[[Issues/I]]"', body="# v\n")
 50918	    write(v, "Verification/V_mixed.md", 'type: verification\nstatus: pending\nplan_refs:\n  - "[[Projects/Done_計劃]]"\n'
 50919	          '  - "[[Projects/Open_計劃]]"', body="# v\n")
 50920	    write(v, "Verification/E3.md", "type: verification\nstatus: pass\nvalid_under: 僅本工作樹(未提交、未過代碼審);全套測試", body="# e\n")
 50921	    write(v, "Verification/Clean.md", "type: verification\nstatus: pass\nvalid_under: 釘在提交 abc123 的乾淨工作樹", body="# c\n")
 50922	    fs = _dr_scan(v)
 50923	    check("①scan 跑得起來", isinstance(fs, list), str(fs))
 50924	    if not isinstance(fs, list):
 50925	        return
 50926	    by = lambda k: sorted((f["path"], f["line"]) for f in fs if f["kind"] == k)
 50927	    g1 = (v / "Verification" / "G1.md").read_text(encoding="utf-8").split("\n")
 50928	    want = sorted(("Verification/G1.md", i + 1) for i, l in enumerate(g1)
 50929	                  if l.strip().startswith(("WHY:[", "TEST:還沒有", "為什麼還不做:", "做完之後跑")))
 50930	    check("②c1 一句一筆、四句都在、行號對", by("c1") == want and len(want) == 4, f"{by('c1')} vs {want}")
 50931	    check("②c1 不列沒有預告句的、也不列已改成歷史說法的", not any(p in ("Verification/G2.md", "Verification/G3.md")
 50932	                                                   for p, _l in by("c1")), str(by("c1")))
 50933	    check("③c2:開著的 Issue 連到收尾計劃,回報 status 那行", by("c2") == [("Issues/I.md", 3)], str(by("c2")))
 50934	    check("④c3 只列 plan_refs 全是已收尾計劃的那篇", [p for p, _l in by("c3")] == ["Verification/V_ok.md"], str(by("c3")))
 50935	    check("⑤c4:同一句有未提交與工作樹照樣成立;乾淨工作樹不成立", [p for p, _l in by("c4")] == ["Verification/E3.md"], str(by("c4")))
 50936	    check("⑥c5:pending 但家筆記已是正式行(audit 標記不影響)", [p for p, _l in by("c5")] == ["Verification/G4.md"], str(by("c5")))
