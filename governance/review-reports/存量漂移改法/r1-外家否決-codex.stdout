 27266	def cmd_drift_scan(env, at=None, as_json=False, budget=None):
 27267	    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
 27268	    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
 27269	    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
 27270	    import json as _j, math as _m, time as _t
 27271	    budget = _DRIFT_BUDGET_SEC if budget is None else budget
 27272	    if not _m.isfinite(budget) or not 0 < budget <= 86400:
 27273	        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
 27274	        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
 27275	        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
 27276	        return 2
 27277	    deadline = _t.monotonic() + budget
 27278	    root, vault_rel = _drift_vault_of(env)
 27279	    tenv, sha = env, None
 27280	    if at:
 27281	        sha = _lens_full_sha(root, at)
 27282	        if sha is None:
 27283	            print(f"擋下:找不到提交 {at}", file=sys.stderr)
 27284	            return 2
 27285	        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
 27286	        vault_rel = _drift_vault_rel(root, sha) or vault_rel
 27287	        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
 27288	        if tenv is None:
 27289	            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
 27290	            return 2
 27291	    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
 27292	    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
 27293	    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
 27294	    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
 27295	    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
 27296	    if as_json:
 27297	        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
 27298	                        "problems": [{"path": p, "line": n, "text": t, "why": w} for p, n, t, w in probs],
 27299	                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
 27300	                       ensure_ascii=False, indent=1))
 27301	        return 0
 27302	    _drift_scan_print(at, left, done, bad, probs)
 27303	    return 0
