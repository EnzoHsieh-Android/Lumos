 50740	def t_guard_settle_rewrites_planned_prose():
 50741	    """[S4] settle 轉正把 guard plan 寫的四種預告句改成歷史說法、其他行不動、status 同一次寫入;
 50742	    新版轉正後的推送不被自己的 c1 擋;找不到句型時提醒但照樣成功。
 50743	
 50744	    翻紅釘:拿掉 _guard_settle_rewrite 的呼叫 → ②③紅;第四句前綴拿掉反引號 → ② 第四句紅;
 50745	    c1 改成子字串比對(不從行首)→ ⑤ 被「預告當時為什麼還不做」擋紅。
 50746	    """
 50747	    print("t_guard_settle_rewrites_planned_prose")
 50748	    import datetime
 50749	    today = datetime.date.today().isoformat()
 50750	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 50751	    vault = root / _DR_VAULT
 50752	    base = _na_head(root)
 50753	    _gp(vault, "guard", "plan", "Systems/Pay", "大額退費要人工核可", "--plan", "Projects/退款_計劃",
 50754	        "--phase", "P1", "--due", "2099-12-31", "--why", "下游介面還沒定案", "--owner", "enzo", "--name", "大額退費")
 50755	    g = [x for x in (vault / "Verification").glob("*.md")][0]
 50756	    before = g.read_text(encoding="utf-8")
 50757	    check("①前置:樣板真的寫了四種預告句", all(x in before for x in (
 50758	        "TEST:還沒有測試在守這條", "]預告這條合約但還沒做:", "\n為什麼還不做:", "做完之後跑 `lumos guard settle` 轉正")), before)
 50759	    _nh_commit(root, "plan")
 50760	    r = run(vault, "guard", "settle", "Verification/" + g.stem, "--test", "t_refund_manual")
 50761	    after = g.read_text(encoding="utf-8")
 50762	    check("①settle 成功", r.returncode == 0, r.stdout + r.stderr)
 50763	    check("②TEST 句改成哪天轉正、由家筆記的正式行守,不寫測試名",
 50764	          f"TEST:[{today}] 預告已轉正,合約改由 [[Systems/Pay]] 的正式合約行守" in after and "t_refund_manual" not in after, after)
 50765	    check("②WHY 句行尾加已轉正", f"預告這條合約但還沒做:下游介面還沒定案({today} 已轉正)" in after, after)
 50766	    check("②正文「為什麼還不做」改成預告當時", "\n預告當時為什麼還不做:下游介面還沒定案" in after and "\n為什麼還不做:" not in after, after)
 50767	    check("②第四句整行換成已轉正", f"\n({today} 已轉正)\n" in after and "做完之後跑" not in after, after)
 50768	    check("③status 與標籤同一次改成 pass", "status: pass" in after and "status/pass" in after and "status/pending" not in after, after)
 50769	    check("③其他行一字不動", "預告的合約:大額退費要人工核可" in after and "due: 2099-12-31" in after, after)
 50770	    fs = _dr_scan(vault)
 50771	    check("④新版轉正後 scan 沒有 c1", isinstance(fs, list) and not [f for f in fs if f["kind"] == "c1"], str(fs))
 50772	    _nh_commit(root, "settle")
 50773	    rc, out = _dr(root, "check", "--diff", f"{base}..HEAD")
 50774	    check("⑤轉正後緊接的推送不被自己的 c1 擋", rc == 0 and "c1" not in out, out)
 50775	    # 找不到句型:手改掉 TEST 句 → 提醒、照樣成功
 50776	    _gp(vault, "guard", "plan", "Systems/Pay", "另一條合約", "--plan", "Projects/退款_計劃",
 50777	        "--phase", "P1", "--due", "2099-12-31", "--why", "還沒定", "--owner", "enzo", "--name", "另一條")
 50778	    g2 = [x for x in (vault / "Verification").glob("*.md") if "另一條" in x.stem][0]
 50779	    g2.write_text(g2.read_text(encoding="utf-8").replace("TEST:還沒有測試在守這條", "TEST:作者自己改寫過"), encoding="utf-8")
 50780	    r2 = run(vault, "guard", "settle", "Verification/" + g2.stem, "--test", "t_other")
 50781	    check("⑥找不到句型:照樣成功並提醒那一句", r2.returncode == 0 and "找不到摘要的 TEST 預告句" in r2.stdout,
 50782	          r2.stdout + r2.stderr)
 50783	    check("⑥手改過的那句不動", "TEST:作者自己改寫過" in g2.read_text(encoding="utf-8"), g2.read_text(encoding="utf-8"))
 50784	
