 26149	def _drift_plan_followups(env, rel, new_status):
 26150	    """lumos set <計劃> status done|superseded 要列的連帶待辦(計劃〈做法〉第 1 節第 3 點)→ [(種類, 路徑, 說明)]。
 26151	    只讀筆記、不跑 git、不寫;不是計劃或不是收尾狀態回 []。
 26152	    驗證紀錄走 build_typed_index 的反向索引(代碼審 r1 架構對齊席:不自己拿 env.resolve 猜同名第一篇);
 26153	    只寫檔名、同名猜不準的另列一項「猜不準」,讓人自己看。"""
 26154	    n = env.notes.get(rel)
 26155	    if n is None or _drift_str(n, "type") != "project" or new_status not in _DRIFT_CLOSED:
 26156	        return []
 26157	    out = []
 26158	    names = {"out": "計劃連到它", "in": "它連到計劃", "both": "互相連"}
 26159	    for p, d in sorted(_drift_linked(env, rel).items()):
 26160	        pn = env.notes.get(p)
 26161	        if _drift_str(pn, "type") == "issue" and _drift_str(pn, "status") in _DRIFT_OPEN_ISSUE:
 26162	            out.append(("Issue", p, f"{_drift_str(pn, 'status')},{names[d]}"))
 26163	    ti = build_typed_index(env)
 26164	    for p in sorted({s for s, et in ti["rev"].get(rel, []) if et == "plan_refs"}):
 26165	        if _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
 26166	            out.append(("驗證紀錄", p, "pending,plan_refs 指的計劃都已收尾"))
 26167	    out += _drift_status_probe_followups(env, rel, new_status)
 26168	    for src, lit, et, cands in ti["ambiguous"]:
 26169	        sn = env.notes.get(src)
 26170	        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
 26171	                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
 26172	            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
 26173	    return out
 26174	
 26175	
 26176	def _drift_status_probe_followups(env, rel, new_status):
 26177	    """連帶待辦第③項(乙,[S15]):[when-status:<這份計劃>=…] 的 status 條件因這次收尾成立的回頭條件——只做文字比對,
 26178	    不跑 git;同一行還有別的條件時註明,不宣稱整行成立。env 是改之前的圖譜:舊狀態本來就在值裡的,條件早就成立,
 26179	    不是這次收尾造成的,不列(代碼審 r1 正確性席、外家席:doing→done 對 =doing|done 原本也說成因這次成立)。"""
 26180	    out = []
 26181	    old = _drift_str(env.notes.get(rel), "status")
 26182	    for p in sorted(env.notes):
 26183	        for no, _tx, pr in _probe_lines(env_text(env, p) or "")[0]:
 26184	            hit = [v for k, v in pr["conds"] if k == "status" and _probe_value_err(k, v) is None
 26185	                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
 26186	                   and new_status in (vals := {x.strip() for x in v.partition("=")[2].split("|")}) and old not in vals]
 26187	            if hit:
 26188	                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
 26189	                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
 26190	    return out
 26191	
