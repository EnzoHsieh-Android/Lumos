 51184	    e = m.Env.from_texts(Vp, T)
 51185	    check("④guards 欄在但是空的:不算 c3", not [f for f in m._drift_state_findings(e) if f["kind"] == "c3"], "")
 51186	    # ⑤ 同名筆記
 51187	    T = {"Projects/退款.md": "---\ntype: project\nstatus: doing\n---\n# P\n",
