 50699	def _dr_guard_text(status="pending", home="Systems/Pay", claim="大額退費要人工核可", why="下游介面還沒定案",
 50700	                   plan="Projects/退款_計劃", prose=True, settled_why=False):
 50701	    """一篇 guard plan 樣板長相的守衛紀錄(直接寫檔,不經指令——用來造「舊版 settle 轉正後留著預告句」的現場)。"""
 50702	    wline = f"  WHY:[2026-09-01]預告這條合約但還沒做:{why}" + ("(2026-09-20 已轉正)" if settled_why else "")
 50703	    summ = [wline, "  TEST:還沒有測試在守這條;最遲 2099-12-31 要做完,負責人 enzo"] if prose else ["  KEY:x"]
 50704	    body = [f"預告的合約:{claim}", ""]
 50705	    if prose:
 50706	        body += [f"為什麼還不做:{why}", "", "做完之後跑 `lumos guard settle` 轉正,不要手改狀態。"]
 50707	    return ("---\ntype: verification\nstatus: " + status + "\ncreated: 2026-09-01\nupdated: 2026-09-01\n"
 50708	            "due: 2099-12-31\nowner: enzo\nguards:\n  - " + home + "\nphases:\n  - P1\nplan_refs:\n"
 50709	            f"  - \"[[{plan}]]\"\ntags:\n  - type/verification\n  - status/{status}\nsummary: |-\n"
 50710	            + "\n".join(summ) + "\n---\n# G\n\n" + "\n".join(body) + "\n")
 50711	
