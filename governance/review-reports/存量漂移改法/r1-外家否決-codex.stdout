 14695	def atomic_write_verify(path: Path, new_lines, key, expected_check):
 14696	    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
 14697	    orig_fm = load_raw_for_edit(path)
 14698	    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
 14699	    text = "\n".join(new_lines)
 14700	    new_fm_lines = new_lines[1:]
 14701	    for i in range(1, len(new_lines)):
 14702	        if new_lines[i].strip() == "---":
 14703	            new_fm_lines = new_lines[1:i]
 14704	            break
 14705	    fields, _, new_lint = parse_frontmatter(new_fm_lines)
 14706	    if not expected_check(fields):
 14707	        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
 14708	    introduced = set(new_lint) - orig_lint
 14709	    if introduced:
 14710	        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
 14711	    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)
