 51240	    # ⑪ 排序
 51241	    T = {"Projects/X.md": "---\ntype: project\n---\n", "Projects-old/X.md": "---\ntype: project\n---\n"}
 51242	    e = m.Env.from_texts(Vp, T)
 51243	    check("⑪樹上的同名排序跟磁碟一致(逐層比)", e.by_stem["x"][0] == "Projects/X.md", str(e.by_stem["x"]))
 51244	    # ⑫ 考試誤報
 51245	    must = [{"kind": "c1", "path": "N.md", "line": 3}, {"kind": "c1", "path": "N.md", "line": 4},
 51246	            {"kind": "c4", "path": "N.md", "line": 9}, {"kind": "c1", "path": "O.md", "line": 3}]
