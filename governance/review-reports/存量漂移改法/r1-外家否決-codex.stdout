 51457	def t_drift_code_review_r4_regressions():
 51458	    """存量漂移守衛代碼審 r4 的回歸釘。
 51459	
 51460	    ①筆記內容審(不嚴格):一篇的 git log --follow 失敗只丟那一篇,別篇照算 ②樹的批次讀逾時扣掉列路徑花掉的時間
 51461	    ③測試名只認完全相同,不猜平台前綴 ④開關「有沒有自己寫」從 _drift_config 同一次解析來,格式寫錯也算寫了
 51462	    ⑤嚴格:歷史裡有一版解不開就判不了 ⑥空連結不算有落點 ⑦嚴格:頂端那一版逐篇讀失敗判不了
 51463	    ⑧考試重放碰到讀不出來的計劃不崩 ⑨沒寫設定但已接線時,提醒講明是預設值
 51464	    """
 51465	    print("t_drift_code_review_r4_regressions")
 51466	    import pathlib, time as _t
 51467	    m = _load_lumos_inproc()
 51468	    Vp = pathlib.Path("docs/kg-knowledge")
 51469	    f = m._notes_status_flipped
 51470	    g_ = f.__globals__
 51471	    saved = {k: g_[k] for k in ("_ns_git", "_nodehome_cat_blobs", "_nodehome_list")}
 51472	    a, b = "a" * 40, "b" * 40
 51473	    p1, p2 = "docs/kg-knowledge/Projects/P1.md", "docs/kg-knowledge/Projects/P2.md"
 51474	    done = b"---\ntype: project\nstatus: done\n---\n"
 51475	    doing = b"---\ntype: project\nstatus: doing\n---\n"
 51476	    try:
 51477	        def git1(root, *args):
 51478	            if "--follow" in args:
 51479	                return None if args[-1] == p1 else (a + "\0\n" + p2 + "\0").encode()
 51480	            if "--name-status" in args:
 51481	                return b""
 51482	            return (p1 + "\0" + p2 + "\0").encode()
 51483	        g_["_ns_git"] = git1
 51484	        g_["_nodehome_cat_blobs"] = lambda root, specs, **kw: [doing if s.startswith("BASE") else done for s in specs]
 51485	        got = f(".", "BASE", "TIP", "docs/kg-knowledge", lambda q: done, lambda ty, st: ty == "project" and st == "done",
 51486	                lambda x, y: x != "done" and y == "done")
 51487	        check("①不嚴格:P1 的歷史讀失敗只丟 P1、P2 照算", got == [p2], str(got))
 51488	        got = f(".", "BASE", "TIP", "docs/kg-knowledge", lambda q: done, lambda ty, st: ty == "project" and st == "done",
 51489	                lambda x, y: x != "done" and y == "done", strict=True)
 51490	        check("①嚴格:同一情況判不了", got is None, str(got))
 51491	        # ⑤ 歷史裡一版解不開
 51492	        g_["_ns_git"] = lambda root, *args: ((a + "\0\n" + p1 + "\0" + b + "\0\n" + p1 + "\0").encode() if "--follow" in args else b"")
 51493	        g_["_nodehome_cat_blobs"] = lambda root, specs, **kw: ([b"---\nstatus: pass\n---\n", bytes([255])] if len(specs) == 2
 51494	                                                               else [b"---\nstatus: pending\n---\n"])
 51495	        check("⑤嚴格:歷史裡有一版解不開就判不了",
 51496	              m._note_status_seq(".", "BASE", "TIP", "docs/kg-knowledge", p1, strict=True) is None, "")
 51497	        # ⑦ 頂端那一版逐篇讀失敗
 51498	        g_["_ns_git"] = lambda root, *args: (p1 + "\0").encode() if "log" in args and "--follow" not in args else b""
 51499	        got = f(".", "BASE", "TIP", "docs/kg-knowledge", lambda q: None, lambda ty, st: True, lambda x, y: True, strict=True)
 51500	        check("⑦嚴格:頂端那一版讀失敗判不了", got is None, str(got))
 51501	        # ② 樹的批次讀逾時
 51502	        seen = {}
 51503	
 51504	        def slow_list(root, where):
 51505	            _t.sleep(0.5)
 51506	            return ({"docs/kg-knowledge/A.md": "100644"}, ["docs/kg-knowledge/A.md"])
 51507	        g_["_nodehome_list"] = slow_list
 51508	        g_["_nodehome_cat_blobs"] = lambda root, specs, **kw: (seen.setdefault("t", kw.get("timeout")) and [b"---\n---\n"])
 51509	        m._drift_tree_env(".", "TIP", "docs/kg-knowledge", deadline=_t.monotonic() + 3)
 51510	        check("②樹的批次讀逾時扣掉列路徑已花的時間", seen.get("t") is not None and seen["t"] <= 2.6, str(seen))
 51511	    finally:
 51512	        g_.update(saved)
 51513	    # ③
 51514	    ls = ["---", "summary: |-", "  KEY:★INVARIANT★ 大額退費要人工核可 [test:oops:refund_test]", "---"]
 51515	    check("③平台前綴不猜:不算綁了這支", m._guard_formal_line(ls, 3, "大額退費要人工核可", "refund_test") is None, "")
 51516	    # ④
 51517	    check("④格式寫錯也算自己寫了開關", m._drift_config(b'{"drift_check": "block"}')[2] is True, "")
 51518	    check("④沒寫就不算", m._drift_config(b'{"note_audit": {"gate": "warn"}}')[2] is False, "")
 51519	    # ⑥
 51520	    T = {"Projects/P.md": "---\ntype: project\nstatus: done\n---\n# P\n",
