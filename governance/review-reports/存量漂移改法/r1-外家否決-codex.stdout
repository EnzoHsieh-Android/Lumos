 51252	def t_drift_code_review_r2_regressions():
 51253	    """存量漂移守衛代碼審 r2 的回歸釘(修正本身帶進來的與沒修乾淨的)。
 51254	
 51255	    ①行尾只認工具接上去的標記(test/audit/kill),合約原文結尾的 [鍵:值] 是原文 ②已有正式行綁別的測試:擋,不寫第二條
 51256	    ③正式行在、預告行重複兩條:擋,不當成做到一半 ④批次讀失敗不當成沒有狀態翻轉 ⑤狀態歷史的批次讀接上預算
 51257	    ⑥plan_refs 同一份計劃兩種寫法照樣算 c3 ⑦猜不準那一項不列守衛紀錄 ⑧status_replay 用上一版自己的圖譜位置
 51258	    ⑨scan 列出解不開的筆記 ⑩status_replay 點到的那筆不同時算誤報 ⑪Z 段只剩已表態時不開段
 51259	    """
 51260	    print("t_drift_code_review_r2_regressions")
 51261	    import pathlib, types, contextlib, io, json as _j
 51262	    m = _load_lumos_inproc()
 51263	    Vp = pathlib.Path("docs/kg-knowledge")
 51264	    # ①
 51265	    ls = ["---", "summary: |-", "  KEY:★INVARIANT★ 大額退費要人工核可 [scope:企業戶] [test:t_refund]", "---"]
 51266	    check("①原文結尾的 [scope:…] 是原文,不算這句的正式行", m._guard_formal_line(ls, 3, "大額退費要人工核可", "t_refund") is None, "")
 51267	    ls = ["---", "summary: |-", "  KEY:★INVARIANT★ 大額退費要人工核可 [test:t_refund] [audit:opus/2026-09-20] [kill:recipes]", "---"]
 51268	    check("①工具接的 test/audit/kill 照樣剝", m._guard_formal_line(ls, 3, "大額退費要人工核可", "t_refund") is not None, "")
 51269	    # ② ③:走真指令
 51270	    for label, extra_formal, dup in (("②", "[test:t_old]", False), ("③", "[test:t_refund]", True)):
 51271	        v = mkvault()
 51272	        write(v, "Systems/Pay.md", "type: system\nstatus: doing\nsummary: |-\n  KEY:★INVARIANT★ 大額退費要人工核可 " + extra_formal,
 51273	              body="# Pay\n")
 51274	        write(v, "Projects/退款_計劃.md", "type: project\nstatus: doing", body="# 退款\n")
 51275	        _gp(v, "guard", "plan", "Systems/Pay", "大額退費要人工核可", "--plan", "Projects/退款_計劃", "--phase", "P1",
 51276	            "--due", "2099-12-31", "--why", "還沒定", "--owner", "enzo", "--name", "大額退費")
 51277	        pay = v / "Systems" / "Pay.md"
 51278	        if dup:
 51279	            t = pay.read_text(encoding="utf-8")
 51280	            pl = [x for x in t.split("\n") if "★INVARIANT-PLANNED★" in x][0]
 51281	            pay.write_text(t.replace(pl, pl + "\n" + pl), encoding="utf-8")
 51282	        before = pay.read_text(encoding="utf-8")
 51283	        g = list((v / "Verification").glob("*.md"))[0]
 51284	        r = run(v, "guard", "settle", "Verification/" + g.stem, "--test", "t_refund")
 51285	        check(f"{label}擋下、家筆記不動、守衛紀錄還是 pending",
 51286	              r.returncode == 2 and pay.read_text(encoding="utf-8") == before and "status: pending" in g.read_text(encoding="utf-8"),
 51287	              r.stdout + r.stderr)
 51288	    # ④ ⑤
 51289	    f = m._note_status_seq
 51290	    g_ = f.__globals__
 51291	    saved = {k: g_[k] for k in ("_ns_git", "_nodehome_cat_blobs")}
 51292	    p = "docs/kg-knowledge/Verification/G.md"
 51293	    a = "a" * 40
 51294	    calls = []
 51295	    try:
 51296	        g_["_ns_git"] = lambda root, *args: ((a + "\0\n" + p + "\0").encode() if "--follow" in args else b"")
 51297	        # 只讓「歷史那一批」讀失敗、起點那一版讀得到(兩批都失敗時起點那道會先接住,分不出這一處有沒有修)
 51298	        g_["_nodehome_cat_blobs"] = lambda root, specs, **kw: (None if specs[0].startswith(a) else
 51299	                                                                [b"---\nstatus: pending\n---\n" for _ in specs])
 51300	        # r3 起只有存量漂移那條路嚴格(strict=True);筆記內容審照舊把讀不到當成沒有翻轉,見 r3 回歸釘 ④
 51301	        check("④歷史那一批讀失敗:回 None(判不了),不回只有起點的序列",
 51302	              f(".", "BASE", "TIP", "docs/kg-knowledge", p, strict=True) is None, "")
 51303	        g_["_nodehome_cat_blobs"] = lambda root, specs, **kw: (calls.append(kw) or [b"---\nstatus: pass\n---\n" for _ in specs])
 51304	        import time as _t
 51305	        f(".", "BASE", "TIP", "docs/kg-knowledge", p, deadline=_t.monotonic() + 30)
 51306	        check("⑤狀態歷史的批次讀接上剩下的預算", calls and all("timeout" in kw and kw["timeout"] <= 30 for kw in calls), str(calls))
 51307	    finally:
 51308	        g_.update(saved)
 51309	    # ⑥ ⑦
 51310	    T = {"Projects/P.md": "---\ntype: project\nstatus: done\n---\n# P\n",
 51311	         "Verification/V.md": "---\ntype: verification\nstatus: pending\nplan_refs:\n  - \"[[Projects/P]]\"\n  - \"[[P]]\"\n---\n# V\n"}
 51312	    e = m.Env.from_texts(Vp, T)
 51313	    check("⑥同一份計劃兩種寫法:照樣算 c3", [x["kind"] for x in m._drift_state_findings(e)] == ["c3"], "")
 51314	    T = {"Projects/P.md": "---\ntype: project\nstatus: doing\n---\n# P\n", "Issues/P.md": "---\ntype: issue\nstatus: open\n---\n# I\n",
 51315	         "Verification/G.md": "---\ntype: verification\nstatus: pending\nguards:\n  - Systems/X\nplan_refs:\n  - \"[[P]]\"\n---\n# G\n"}
 51316	    e = m.Env.from_texts(Vp, T)
 51317	    check("⑦猜不準那一項不列守衛紀錄", not m._drift_plan_followups(e, "Projects/P.md", "done"), "")
 51318	    # ⑧ ⑩
 51319	    fone = m._drift_exam_one
 51320	    g2 = fone.__globals__
 51321	    saved = {k: g2[k] for k in ("_lens_full_sha", "_drift_vault_rel", "_drift_check_core", "_drift_tree_env")}
 51322	    plan = "---\ntype: project\nstatus: doing\n---\n# P\n[[Issues/I]]\n"
 51323	    issue = "---\ntype: issue\nstatus: open\n---\n# I\n\n第 7 行講等計劃做完\n"
 51324	    seen = []
 51325	    try:
 51326	        g2["_lens_full_sha"] = lambda root, ref: {"x": "C", "x^": "P"}.get(ref)
 51327	        g2["_drift_vault_rel"] = lambda root, w: "docs/new-knowledge" if w == "C" else "docs/old-knowledge"
 51328	        g2["_drift_check_core"] = lambda *a_, **k: ([], [{"kind": "c2", "path": "Issues/I.md", "line": 3, "text": "status: open"}], [])
 51329	
 51330	        def _tree(root, w, v, override=None, timeout=60):
