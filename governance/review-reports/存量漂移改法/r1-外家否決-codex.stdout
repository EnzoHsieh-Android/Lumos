 14362	def fm_structure(fm_lines):
 14363	    """回傳 ordered [(key, start, end, kind)]，kind ∈ scalar/list/block。
 14364	    end = 該 key 區塊最後一行的 index(含)。"""
 14365	    out = []
 14366	    i, n = 0, len(fm_lines)
 14367	    while i < n:
 14368	        m = TOP_KEY_RE.match(fm_lines[i])
 14369	        if not m:
 14370	            i += 1
 14371	            continue
 14372	        key, val = m.group(1), m.group(2).strip()
 14373	        start = i
 14374	        if val in ("|", "|-", ">", ">-"):
 14375	            i += 1
 14376	            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
 14377	                i += 1
 14378	            out.append((key, start, i - 1, "block"))
 14379	        elif val == "":
 14380	            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
 14381	            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
 14382	            i += 1
 14383	            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
 14384	                i += 1
 14385	            out.append((key, start, i - 1, "list"))
 14386	        elif val == "[]":
