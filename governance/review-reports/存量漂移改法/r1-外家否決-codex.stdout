 50684	def t_lumos_no_zip_strict_for_py39():
 50685	    """專案宣告支援 Python 3.9,zip(..., strict=) 要 3.10 才有——筆記形狀擋上線時用了三處,3.9 跑推送範圍會直接 TypeError
 50686	    (筆記內容審代碼審收尾時用系統 3.9 編譯才發現;編譯過不代表跑得過,所以靜態掃)。"""
 50687	    print("t_lumos_no_zip_strict_for_py39")
 50688	    import re as _re
 50689	    src = Path(GRAPHCTL).read_text(encoding="utf-8")
 50690	    hits = [i for i, l in enumerate(src.split("\n"), 1) if _re.search(r"\bzip\([^#]*\bstrict\s*=", l)]
 50691	    check("主程式沒有 zip(..., strict=)(3.10 才有)", not hits, str(hits[:10]))
 50692	
