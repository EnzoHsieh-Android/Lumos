 13672	    pct = _hazen_percentile(_graph_pagerank(env))
 13673	    idx = build_typed_index(env)
 13674	    today = datetime.date.today()
 13675	    linked, unlinked = [], []
 13676	    for rel, n in cands:
 13677	        days = _stale_days(n, today)
 13678	        if days is None:
 13679	            print(f"⚠ {rel}: date/檔名前綴/created 三層皆缺,無法算陳舊天數——已剔除(fail-visible),請補 date 欄",
