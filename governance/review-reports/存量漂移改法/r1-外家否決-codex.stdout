 27150	def _drift_config(text):
 27151	    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
 27152	    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
 27153	    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
 27154	    import json as _j
 27155	    if text is None:
 27156	        return _DRIFT_DEFAULT_GATE, [], False
 27157	    try:
 27158	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 27159	    except (ValueError, UnicodeDecodeError):
 27160	        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
 27161	        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
 27162	    if not isinstance(cfg, dict) or "drift_check" not in cfg:
 27163	        return _DRIFT_DEFAULT_GATE, [], False
 27164	    dc = cfg["drift_check"]
 27165	    if not isinstance(dc, dict):
 27166	        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
 27167	                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
 27168	    g = dc.get("gate")
 27169	    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
 27170	        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
 27171	    if g not in _DRIFT_GATE_VALUES:
 27172	        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
 27173	    return g, [], True
