 50786	def t_guard_settle_recovers_half_done():
 50787	    """[S5] 家筆記已經是正式行(其他標記不影響)而守衛紀錄還是 pending:只補第二步;已經 pass:印已轉正、回 0。
 50788	
 50789	    翻紅釘:拿掉 _guard_formal_line 那個分支 → ①紅(找不到預告行擋下);拿掉 status==pass 的早退 → ③紅。
 50790	    """
 50791	    print("t_guard_settle_recovers_half_done")
 50792	    v = mkvault()
 50793	    write(v, "Systems/Pay.md", "type: system\nstatus: doing\nsummary: |-\n  FLOW:a", body="# Pay\n")
 50794	    write(v, "Projects/退款_計劃.md", "type: project\nstatus: doing", body="# 退款\n")
 50795	    _gp(v, "guard", "plan", "Systems/Pay", "大額退費要人工核可", "--plan", "Projects/退款_計劃",
 50796	        "--phase", "P1", "--due", "2099-12-31", "--why", "還沒定", "--owner", "enzo", "--name", "大額退費")
 50797	    g = list((v / "Verification").glob("*.md"))[0]
 50798	    pay = v / "Systems" / "Pay.md"
 50799	    t = pay.read_text(encoding="utf-8")
 50800	    import re as _re
 50801	    t2 = _re.sub(r"  KEY:★INVARIANT-PLANNED★ 大額退費要人工核可.*",
 50802	                 "  KEY:★INVARIANT★ 大額退費要人工核可 [test:t_refund] [audit:opus/2026-09-20]", t)
 50803	    pay.write_text(t2, encoding="utf-8")
 50804	    check("①前置:家筆記已是正式行、守衛紀錄還是 pending", "★INVARIANT-PLANNED★" not in t2
 50805	          and "status: pending" in g.read_text(encoding="utf-8"), t2)
 50806	    r = run(v, "guard", "settle", "Verification/" + g.stem, "--test", "t_refund")
 50807	    check("①做到一半:只補守衛紀錄、成功", r.returncode == 0 and "只補守衛紀錄" in r.stdout, r.stdout + r.stderr)
 50808	    check("②守衛紀錄轉成 pass、預告句改寫", "status: pass" in g.read_text(encoding="utf-8")
 50809	          and "還沒有測試在守" not in g.read_text(encoding="utf-8"), g.read_text(encoding="utf-8"))
 50810	    check("②家筆記那行沒被再動", pay.read_text(encoding="utf-8") == t2, pay.read_text(encoding="utf-8"))
 50811	    r2 = run(v, "guard", "settle", "Verification/" + g.stem, "--test", "t_refund")
 50812	    check("③已經 pass:印已轉正、回 0", r2.returncode == 0 and "已轉正,不用再做" in r2.stdout, r2.stdout + r2.stderr)
 50813	    g.write_text(g.read_text(encoding="utf-8").replace("status: pass", "status: abandoned"), encoding="utf-8")
 50814	    r3 = run(v, "guard", "settle", "Verification/" + g.stem, "--test", "t_refund")
 50815	    check("④墓碑照舊擋", r3.returncode == 2, r3.stdout + r3.stderr)
