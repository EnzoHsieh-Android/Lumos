+def _extra_fm_keys(env):
+    """讀 .lumos/config.json 的 extra_frontmatter_keys(消費專案自己的合法欄位)。讀不到就空。"""
+    import json
+    try:
+        cfg = Path(env.vault).parent.parent / ".lumos" / "config.json"
+        if cfg.is_file():
+            v = json.loads(cfg.read_text(encoding="utf-8")).get("extra_frontmatter_keys")
+            return [x for x in v if isinstance(x, str)] if isinstance(v, list) else []
+    except Exception:
+        pass
+    return []
+
+
+def _levenshtein_le1(a, b):
+    """只判「編輯距離 ≤1」(打錯一個字的近名候選)——不做完整距離計算,夠用且便宜。"""
+    if a == b:
+        return False
+    la, lb = len(a), len(b)
+    if abs(la - lb) > 1:
+        return False
+    if la == lb:
+        return sum(1 for x, y in zip(a, b) if x != y) == 1
+    short, long_ = (a, b) if la < lb else (b, a)
+    for i in range(len(long_)):
+        if long_[:i] + long_[i + 1:] == short:
+            return True
+    return False
+
