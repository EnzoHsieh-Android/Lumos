  3925	def _severity_check_row(rec, root, trust_sha=False):
  3926	    """[嚴重度綁定機械掃 S2] 單帳列 severity 對帳核心(CLI 與 disposal 尾端共用,單一實作)。
  3927	    回 (status, 白話訊息):ok/over(高報,保守)/under(低報)/noparse(報告無宣告行)/
  3928	    nofile(報告檔佚失)/shafail(報告與帳面指紋不符)。trust_sha=True 時跳過重算
  3929	    (disposal ③ 已對判定輪全席逐檔驗過,不對同一檔重算兩遍雜湊;r1 arch-f4)。"""
  3930	    rp = rec.get("report_path")
  3931	    if not rp:
  3932	        return "nofile", "帳列沒有報告檔路徑(舊形狀,寫側 2026-08-26 起已拒)"
  3933	    fp = Path(rp)
  3934	    if not fp.is_absolute():
  3935	        fp = Path(root) / rp
  3936	    try:
  3937	        text = fp.read_text(encoding="utf-8", errors="replace")
  3938	    except OSError as e:
  3939	        return "nofile", f"報告檔讀不到({e}): {rp}"
  3940	    if not trust_sha:
  3941	        want = rec.get("report_sha256")
  3942	        if want and _sha256_file(fp) != want:
  3943	            return "shafail", f"報告檔與帳面指紋不符(檔案被動過?)——先跑 lumos quote-check 查: {rp}"
  3944	    decl = _report_severities(text)
  3945	    led = rec.get("severity")
  3946	    if not decl:
  3947	        return "noparse", "報告裡沒有任何「severity: <值>」獨立宣告行(格式無法機械驗)"
