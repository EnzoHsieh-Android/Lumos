  3880	def _intake_declared(text):
  3881	    """intake守衛 T1(2026-08-30 d1):intake 檔的前掃宣告行判定。
  3882	    規則(r2/r3 折入):①先剝 fenced 圍欄(```…```)再掃——同款行首 fullmatch 對圍欄內
  3883	    頂格示例照計,模板照抄即偽造(r2 b-F6 實測)②行首錨定 fullmatch `preflight-4: ran`,
  3884	    值域封閉單值 ③同檔多條宣告行=格式壞,視同無(fail-closed;後果只是 T2 的 ⚠,不擋)。
  3885	    回傳 True=有且僅有一條合法宣告行。"""
  3886	    import re as _re
  3887	    body = _re.sub(r"```.*?```", "", text, flags=_re.S)   # 未閉合圍欄:剝到文末=保守方向(視同無)
  3888	    body = _re.sub(r"```.*\Z", "", body, flags=_re.S)
  3889	    hits = [ln for ln in body.splitlines() if ln.startswith("preflight-4:")]
  3890	    if len(hits) != 1:
  3891	        return False
  3892	    return _re.fullmatch(r"preflight-4:[ \t]*ran[ \t]*", hits[0]) is not None
  3893	
