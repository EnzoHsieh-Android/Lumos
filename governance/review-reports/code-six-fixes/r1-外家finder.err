    47	def _emit_updated(tool_input: dict, prompt: str, text: str) -> None:
    48	    new_input = dict(tool_input)
    49	    new_input["prompt"] = prompt.rstrip("\n") + "\n\n" + text + "\n"
    50	    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": new_input}}, ensure_ascii=False))
    51	
    52	
    53	def _find_lumos_script() -> str | None:
    54	    import shutil
    55	    w = shutil.which("lumos")
    56	    if w:
    57	        return w
    58	    cand = Path(__file__).resolve().parent.parent.parent.parent / "scripts" / "lumos"
    59	    return str(cand) if cand.is_file() else None
