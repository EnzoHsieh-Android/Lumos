  3833	
  3834	def _parse_clusters(raw):
  3835	    """M2 risk-cluster 寫側解析:--clusters '名=狀態,...' → (dict{名:狀態}, None) 或 (None, 錯誤訊息)。
  3836	    三態白名單;accepted-minor 需冒號內嵌理由(整筆單一 note 對多 accepted-minor 無法對應=模糊過帳);
  3837	    尾逗號空段靜默過濾,但過濾後空列表=rc2(帶旗標即須有效內容,無「空字串=未帶」特例);
  3838	    設計:Projects/design-loop提效_計劃 M2(golden: governance/golden/dloop-m2-cluster)。"""
  3839	    parts = [p.strip() for p in str(raw).split(",") if p.strip()]
  3840	    if not parts:
  3841	        return None, "帶了 --clusters 但無有效內容(空字串/全逗號)"
  3842	    out = {}
  3843	    for p in parts:
  3844	        if "=" not in p:
  3845	            return None, f"段缺 '='(格式 名=狀態): {p!r}"
  3846	        name, state = p.split("=", 1)
  3847	        name, state = name.strip(), state.strip()
  3848	        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", name):
  3849	            return None, f"cluster 名非法(kebab 短 slug:小寫英數起頭+[-_],≤64): {name!r}"
  3850	        base = state.split(":", 1)[0]
  3851	        if base not in CLUSTER_STATES:
  3852	            return None, f"狀態 {base!r} 不在白名單 {'/'.join(CLUSTER_STATES)}"
  3853	        if base == "accepted-minor":
  3854	            if ":" not in state or not state.split(":", 1)[1].strip():
  3855	                return None, f"accepted-minor 需逐 cluster 內嵌理由(accepted-minor:理由): {p!r}"
  3856	        elif state != base:
  3857	            # resolved/disputed-major 必須精確相等——夾帶冒號後綴=未定義第四態(帳面破三態白名單)
  3858	            return None, f"狀態 {state!r} 夾帶後綴(僅 accepted-minor 可帶冒號理由)"
  3859	        if name in out:
  3860	            return None, f"同輪同名 cluster 重複: {name!r}"
  3861	        out[name] = state
  3862	    return out, None
