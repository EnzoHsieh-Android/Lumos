 17723	def _codeloop_git_head(repo_root):
 17724	    """取 HEAD full sha。"""
 17725	    import subprocess
 17726	    r = subprocess.run(["git", "rev-parse", "HEAD"],
 17727	                       capture_output=True, text=True, cwd=str(repo_root))
 17728	    return r.stdout.strip()
 17729	
