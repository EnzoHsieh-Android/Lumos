  3895	def _intake_dir_status(repo_root, loop_id):
  3896	    """intake守衛 T2 判準:迴圈目錄的前掃留痕狀態。
  3897	    回傳 "no-dir"(目錄不存在=scratch 迴圈,跳過不印——r2 b-F1:自主迴圈 /tmp 工作區,
  3898	    不跳會每天印進沒人讀的 log)/"ok"(至少一份 *intake*.md 含合法宣告行——綁迴圈不綁輪,
  3899	    r2 b-F4/c-F5:實帳 11 份有 10 份在 r1、判定輪多為 r2+,綁輪必長噪)/"missing"。"""
  3900	    d = Path(repo_root) / "governance" / "review-reports" / str(loop_id)
  3901	    if not d.is_dir():
  3902	        return "no-dir"
  3903	    for f in sorted(d.glob("*intake*.md")):
  3904	        try:
  3905	            if _intake_declared(f.read_text(encoding="utf-8", errors="replace")):
  3906	                return "ok"
  3907	        except OSError:
  3908	            continue
  3909	    return "missing"
