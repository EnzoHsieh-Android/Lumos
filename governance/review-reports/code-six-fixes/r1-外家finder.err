  2919	def discover_test_methods(repo_root, profile=None):
  2920	    """掃 repo 內測試檔,回傳「真實測試方法名」集合(被測試框架註解標註者)。
  2921	    測試棧 profile 決定掃哪些副檔名 + 用哪條方法 regex(預設 csharp-xunit;P5 語言可插拔)。
  2922	    Check T 用此集合驗證 ★INVARIANT★ 綁定的是『可執行證據』而非散文裡的字面巧合(B6 審計)。"""
  2923	    import os, fnmatch
  2924	    profile = profile or load_test_profile(repo_root)
  2925	    exts, mre = profile["exts"], profile["method_re"]
  2926	    must = profile.get("file_must_match")   # 選填:只認內容含此 marker 的檔(如 Maestro ^appId:)
  2927	    fname_globs = profile.get("file_name_match")   # 選填:basename fnmatch 檔名錨(python:test_*.py)
  2928	    strip = profile.get("comment_strip", "c-style")  # 預設 c-style 向後相容;python="none"
  2929	    methods = set()
  2930	    for dp, dirs, files in os.walk(repo_root):
  2931	        dirs[:] = [d for d in dirs if d not in CODE_SKIP_DIRS]
  2932	        for f in files:
  2933	            if Path(f).suffix.lower() in exts:
  2934	                # 檔名錨:ext 檢查後、讀檔前套(CheckT-Python-profile_計劃 std F4)
  2935	                if fname_globs and not any(fnmatch.fnmatch(f, g) for g in fname_globs):
  2936	                    continue
  2937	                try:
  2938	                    txt = (Path(dp) / f).read_text(encoding="utf-8", errors="ignore")
  2939	                except Exception:
  2940	                    continue
  2941	                # file_must_match:讀檔後、去註解前先過濾(如 .yaml 一堆,只認真 Maestro flow;
  2942	                # 濾掉 CI yaml 的 name: 被誤收)。現有 profile 無此鍵→.get() 回 None→不過濾。
  2943	                if must is not None and not must.search(txt):
  2944	                    continue
  2945	                # 去註解(語言感知,2026-07-25 根因修):c-style 剝 // 與 /*..*/(行尾註解會打斷
  2946	                # 「註解串→方法簽章」連續比對,真測試被誤判偽證據)。★python 走 "none" 不剝★——
  2947	                # Python 無 C 式註解,剝了反被中文註解/字串字面裡的 /*..*/ 配對誤吃大段內容
  2948	                # (實測 test_lumos.py 260→94);被註解的 # def 不在行首,PYTHON_TEST_RE 行首錨排除。
  2949	                if strip == "c-style":
  2950	                    txt = re.sub(r"//[^\n]*", "", txt)
  2951	                    txt = re.sub(r"/\*.*?\*/", "", txt, flags=re.S)
  2952	                for m in mre.finditer(txt):
  2953	                    methods.add(m.group(1).strip("`"))  # Kotlin 反引號測試名去引號
  2954	    return methods
  2955	
