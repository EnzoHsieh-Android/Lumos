    62	def _claim_codex_seat(payload: dict) -> int:
    63	    """Codex 側(SubagentStart):派工訊息對 hook 是密文、改不了(實驗 A),改由 `lumos dispatch-lens --claim`
    64	    從派工前武裝的 armed 檔原子領一席,經 additionalContext 給子代理(實驗 5 證到得了)。
    65	    沒武裝/過期/領完 → 什麼都不回(lumos 端判,這裡只轉送)。"""
    66	    repo = payload.get("cwd", "") or os.environ.get("CLAUDE_PROJECT_DIR", "")
    67	    if not repo:
    68	        _debug("Codex SubagentStart 沒有 cwd,放行")
    69	        return 0
    70	    lumos = _find_lumos_script()
    71	    if lumos is None:
    72	        _debug("找不到 lumos,放行")
    73	        return 0
    74	    try:
    75	        r = subprocess.run([sys.executable, lumos, "dispatch-lens", "--claim", "--repo", repo, "--json"],
    76	                           capture_output=True, text=True, timeout=INNER_TIMEOUT)
    77	    except (OSError, subprocess.TimeoutExpired) as e:
    78	        _debug(f"lumos dispatch-lens --claim 失敗或超時({type(e).__name__}),放行")
    79	        return 0
    80	    if r.returncode != 0:
    81	        _debug(f"lumos dispatch-lens --claim rc={r.returncode}:{r.stderr.strip()[:200]},放行")
    82	        return 0
    83	    try:
    84	        data = json.loads(r.stdout.strip().splitlines()[-1])
    85	    except (ValueError, IndexError):
    86	        _debug("--claim 回傳讀不懂,放行")
    87	        return 0
    88	    text = data.get("text") if isinstance(data, dict) else None
    89	    if not text:
    90	        _debug(f"Codex 沒領到席({data.get('reason') if isinstance(data, dict) else '?'})")
    91	        return 0
    92	    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SubagentStart", "additionalContext": text}},
    93	                     ensure_ascii=False))
    94	    return 0
    95	
