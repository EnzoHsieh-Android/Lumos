 14027	def _delguard_parse_diff(diff_text, graph_root):
 14028	    """從 staged diff 抽被刪識別字(token)＋vault(graph_root 下 .md)的 +/- 行分流。
 14029	    規則:只吃 `-` 行(跳過檔頭/hunk 頭/binary 檔段);token regex [A-Za-z_][A-Za-z0-9_]{2,};
 14030	    出現在**同一檔** `+` 行的 token 剔除(檔內改名/搬行即刻回收,降誤報;
 14031	    ★per-file 而非全 diff★——否則 CHANGELOG/文件檔提一句就把 code 檔真刪除滅聲,
 14032	    2026-08-11 code-loop r1 C);stopword 表剔除;
 14033	    vault 與排除路徑(node_modules/ bin/ obj/ dist/ build/ __pycache__/ .git/,
 14034	    ★路徑段比對★:`src/robin/` 不得撞 `bin/`)、
 14035	    以及 lockfile(package-lock.json/yarn.lock/pnpm-lock.yaml,與 pre-commit should_exclude 對齊)的檔案不抽 token,
 14036	    vault .md 的 diff 行另收進 vault_diffs 供 S2 純連結欄位判定用。
 14037	    回 {"tokens": [str...]  # 依出現序去重,cap 前不截
 14038	        ,"vault_diffs": {path: [line...]}}"""
 14039	    import re
 14040	    tok_re = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
 14041	
 14042	    def _flags(ln):
 14043	        m = re.search(r" b/(.+)$", ln)
 14044	        c = m.group(1) if m else None
 14045	        # ★路徑邊界★:c.startswith(graph_root) 對 graph_root="docs/kg" 會誤配手足目錄
 14046	        # docs/kg-legacy/notes.md(字首相同、不同目錄)——必須是同一路徑或其子路徑
 14047	        # (r2 code-loop 折入:r1 兩席點名、上一修波漏掉)
 14048	        vault = bool(c) and (c == graph_root or c.startswith(graph_root + "/")) and c.endswith(".md")
 14049	        excl = bool(c) and (any(c.startswith(seg) or ("/" + seg) in c
 14050	                                for seg in _DELGUARD_EXCLUDE_DIRS)
 14051	                            or c.endswith(_DELGUARD_EXCLUDE_LOCKFILES))
 14052	        return c, vault, excl
 14053	
 14054	    lines = diff_text.splitlines()
 14055	    # 第一遍:per-file 收 `+` 行 token(回收表);vault/.md/排除檔不收(文件提及不算「還活著」)
 14056	    added, cur, skip, in_binary = {}, None, True, False
 14057	    for ln in lines:
 14058	        if ln.startswith("diff --git"):
 14059	            cur, is_v, is_e = _flags(ln)
 14060	            skip = (cur is None) or is_v or is_e or cur.endswith(".md")
 14061	            in_binary = False
 14062	            continue
 14063	        if ln.startswith("Binary files"):
 14064	            in_binary = True
 14065	            continue
 14066	        if skip or in_binary:
 14067	            continue
 14068	        if ln.startswith("+") and not _delguard_is_diff_header(ln):
 14069	            added.setdefault(cur, set()).update(tok_re.findall(ln))
 14070	    # 第二遍:抽被刪 token(回收表只查同檔)＋vault diff 分流
 14071	    tokens, seen = [], set()
 14072	    vault_diffs, cur, is_vault, is_excl, in_binary = {}, None, False, False, False
 14073	    for ln in lines:
 14074	        if ln.startswith("diff --git"):
 14075	            cur, is_vault, is_excl = _flags(ln)
 14076	            in_binary = False
 14077	            continue
 14078	        if ln.startswith("Binary files"):
 14079	            in_binary = True
 14080	            continue
 14081	        if in_binary or cur is None:
 14082	            continue
 14083	        if is_vault and (ln.startswith("+") or ln.startswith("-")) and not _delguard_is_diff_header(ln):
 14084	            vault_diffs.setdefault(cur, []).append(ln)
 14085	            continue
 14086	        # ★兩遍對稱★:第一遍收 `+` 行(回收表)時非 vault 的 .md 也跳過(見上 skip 判定);
 14087	        # 這裡若漏跳,非 vault .md(如 README.md)的重排 diff 會把散文詞彙當 token 抽出去
 14088	        # (r2 code-loop 折入:N5)
 14089	        if is_vault or is_excl or cur.endswith(".md"):
 14090	            continue
 14091	        if ln.startswith("-") and not _delguard_is_diff_header(ln):
 14092	            fadd = added.get(cur) or frozenset()
 14093	            for t in tok_re.findall(ln):
 14094	                if t in _DELGUARD_STOP or t in fadd or t in seen:
 14095	                    continue
 14096	                seen.add(t); tokens.append(t)
 14097	    return {"tokens": tokens, "vault_diffs": vault_diffs}
