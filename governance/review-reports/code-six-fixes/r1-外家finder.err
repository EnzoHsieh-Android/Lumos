 16377	def cmd_impact(file, repo=None, depth=None, as_json=False,
 16378	               ranked=False, top=8, min_score=0.20, stdin_payload=False, incidents_only=False,
 16379	               payload=None, preloaded=None):
 16380	    """動手前算出哪些知識圖譜節點會被 code 改動波及。
 16381	    rc 協定: 0=成功(有/無影響集都算) / 3=vault 找不到 / 其他非 0=內部錯。
 16382	    Task 7: 排序 + --json schema + 人讀輸出。
 16383	    """
 16384	    import json
 16385	
 16386	    # 1. 解析 repo root
 16387	    if repo is not None:
 16388	        repo_root = Path(repo)
 16389	        if not repo_root.is_dir():
 16390	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 16391	            return 2
 16392	    else:
 16393	        repo_root = None
 16394	        for cand in (Path.cwd(), *Path.cwd().parents):
 16395	            if (cand / ".git").exists():
 16396	                repo_root = cand
 16397	                break
 16398	
 16399	    # 2. 找 vault(rc 3 = vault 找不到)
 16400	    if repo_root is not None:
 16401	        vault = _vault_in(repo_root)
 16402	    else:
 16403	        vault = find_vault(Path.cwd())
 16404	    if vault is None:
 16405	        print("IMPACT-DEBUG: vault 找不到(rc3)——非圖譜專案或 --repo 未指向含 vault 的目錄", file=sys.stderr)
 16406	        return 3
 16407	
 16408	    # 3. 解析 depth:CLI(顯式 --depth) > .lumos/impact.json config > 預設 2
 16409	    _cfg_root = repo_root if repo_root is not None else vault.parent.parent
 16410	    _impact_cfg = _impact_load_config(_cfg_root)
 16411	    if depth is None:
 16412	        depth = _impact_cfg["depth"]
 16413	
 16414	    # 4. 載入圖譜環境(preloaded=(vault,env) 由 --diff 聚合復用,避免逐檔重建 N+1)
 16415	    if preloaded is not None and preloaded[0] == vault:
 16416	        env = preloaded[1]
 16417	    else:
 16418	        env = Env(vault)
 16419	    repo_root_for_lookup = repo_root if repo_root is not None else vault.parent.parent
 16420	
 16421	    # 5. code → node 反查(只認 body inline-code,r7-F2)
 16422	    # incidents_only 真快速路(r1 終審親驗修正:原實作僅「不顯示」,反查/BFS 照跑——宣稱落空):
 16423	    # 事故比對只需 rel_file+內容,不需 direct/BFS → 整段跳過,冷卻窗成本回到近零。
 16424	    if incidents_only:
 16425	        direct_pairs = []
 16426	    else:
 16427	        direct_pairs = _impact_reverse_lookup(file, env, repo_root_for_lookup)
 16428	    direct_rels = [n for n, _h in direct_pairs]
 16429	    direct_hit = dict(direct_pairs)   # node → body-inline-code|basename-match(R2 provenance)
 16430	
 16431	    # 6. 組裝影響清單:single multi-source BFS 保證 hop = 距最近直接節點的 min 距離(I1)。
 16432	    #
 16433	    # 舊做法(per-node loop)問題:各直接節點各跑一次 BFS → first-wins 去重 → 若節點 N
 16434	    # 從 D1 hop=2、從 D2 hop=1,但 D1 先迭代,N 以 hop=2 進 indirect_seen → D2 的 hop=1
 16435	    # 被跳過,違反設計 §2 indirect.hop=距最近直接節點。
 16436	    #
 16437	    # 新做法:
 16438	    #   ① direct 資料:逐一收(hit/contract/combo 是 per-node 屬性)。
 16439	    #   ② core_refs 葉:逐一從各直接節點抽(也是 per-node 屬性,hop=1 固定)。
 16440	    #   ③ BFS 間接:single multi-source BFS(全部直接節點一起當種子)→ hop 自然是 min。
 16441	    #
 16442	    # 直接節點預種 direct_seen 確保:BFS 不把另一直接節點誤加進 indirect。
 16443	    all_direct = []
 16444	    all_indirect = []
 16445	    direct_seen = set(direct_rels)  # ← 預種全量,BFS seen 初始集 + dedup guard
 16446	    indirect_seen = set()  # 去重:core_refs 葉 + BFS 間接
 16447	    processed_direct = set()  # 避免同一 direct 重複展開 direct/core_refs
 16448	
 16449	    # ① 直接節點資料 + ② core_refs 葉(per-node,保留原 _impact_collect 語意)
 16450	    # (incidents_only 時 direct_rels 為空,以下兩段自然零工作——BFS multi-source 種子空集即不擴散)
 16451	    for d_rel in direct_rels:
 16452	        if d_rel in processed_direct:
 16453	            continue
 16454	        processed_direct.add(d_rel)
 16455	        direct_note = env.notes.get(d_rel)
 16456	        contract, combo = _impact_contract(direct_note) if direct_note else (None, False)
 16457	        all_direct.append({"node": d_rel, "hit": direct_hit.get(d_rel, "body-inline-code"),
 16458	                           "contract": contract, "combo": combo})
 16459	        # core_refs 跨 repo 葉(r7-F2):hop=1 固定,不入 BFS
 16460	        if direct_note is not None:
 16461	            for core_ref in as_list(direct_note.fields.get("core_refs")):
 16462	                if core_ref not in direct_seen and core_ref not in indirect_seen:
 16463	                    indirect_seen.add(core_ref)
