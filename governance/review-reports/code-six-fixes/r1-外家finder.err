 14100	def _delguard_confidence(tokens, repo_root, graph_root, timeout=None):
 14101	    """回 {token: "high"|"low"}。high=staged index 全域消失(排除 vault/排除域後零命中)。
 14102	    單次 git -c core.quotePath=off grep --cached -n -I -w -F -e t1 -e t2 ... --
 14103	    . ':(exclude)<graph_root>' ':(exclude)node_modules' ...;rc>1 視為失敗丟 RuntimeError(上層 fail-open)。
 14104	    命中歸屬在 python 端做:對 grep 輸出每行,用 Task 4 同款三件套 regex 判哪些 token 出現
 14105	    (`-w` 是 git 側粗篩,py 側再精配)。快照契約:讀 staged index(--cached),worktree 未 add 的改動不影響結果。
 14106	    timeout: 選用秒數上限,轉傳 subprocess.run;逾時拋 subprocess.TimeoutExpired,
 14107	    落進呼叫端 cmd_delguard_check 既有 except Exception → 降級 rc0(行為契約自動成立)。"""
 14108	    import re, subprocess
 14109	    if not tokens:
 14110	        return {}
 14111	    cmd = ["git", "-c", "core.quotePath=off", "grep", "--cached", "-n", "-I", "-w", "-F"]
 14112	    for t in tokens:
 14113	        cmd += ["-e", t]
 14114	    cmd += ["--", ".", f":(exclude){graph_root}"]
 14115	    for d in _DELGUARD_EXCLUDE_DIRS:
 14116	        cmd += [f":(exclude){d.rstrip('/')}"]
 14117	    r = subprocess.run(cmd, capture_output=True, text=True, cwd=repo_root, timeout=timeout)
 14118	    if r.returncode > 1:
 14119	        raise RuntimeError(f"git grep rc={r.returncode}: {r.stderr.strip()[:200]}")
 14120	    alive = set()
 14121	    pats = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 14122	    for line in r.stdout.splitlines():
 14123	        # ★只對內容域配 token★:git grep 輸出是 `path:lineno:content`,連路徑一起配
 14124	        # 會被檔名撞名誤降級(刪掉 Login() → app/Login.kt 這個路徑本身讓 Login 判 low,
 14125	        # 2026-08-11 code-loop r1 B)。len<3 的行(如 `Binary file … matches`)直接丟。
 14126	        parts = line.split(":", 2)
 14127	        if len(parts) < 3:
 14128	            continue
 14129	        content = parts[2]
 14130	        for t, p in pats.items():
 14131	            if t not in alive and p.search(content):
 14132	                alive.add(t)
 14133	    return {t: ("low" if t in alive else "high") for t in tokens}
