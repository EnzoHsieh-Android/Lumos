    97	def main() -> int:
    98	    try:
    99	        payload = json.loads(sys.stdin.read())
   100	    except (json.JSONDecodeError, ValueError):
   101	        return 0
   102	    if not isinstance(payload, dict):
   103	        return 0
   104	    if payload.get("hook_event_name") == "SubagentStart":
   105	        return _claim_codex_seat(payload)
   106	    if payload.get("tool_name") != "Agent":
   107	        return 0
   108	    tool_input = payload.get("tool_input")
