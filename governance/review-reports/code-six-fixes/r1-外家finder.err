  2903	def build_code_haystack(repo_root):
  2904	    """讀 repo 內所有 code 檔串成大字串,供 ★INVARIANT★ 綁定的測試名做存在性檢查。
  2905	    (閉環外接觸:doctor 不執行測試,只驗證『載重宣稱認領的證據真的存在於程式碼』)"""
  2906	    import os
  2907	    parts = []
  2908	    for dp, dirs, files in os.walk(repo_root):
  2909	        dirs[:] = [d for d in dirs if d not in CODE_SKIP_DIRS]
  2910	        for f in files:
  2911	            if Path(f).suffix.lower() in CODE_EXTS_T:
  2912	                try:
  2913	                    parts.append((Path(dp) / f).read_text(encoding="utf-8", errors="ignore"))
  2914	                except Exception:
  2915	                    pass
  2916	    return "\n".join(parts)
