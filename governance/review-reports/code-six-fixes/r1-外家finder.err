  2988	def _git_commit_exists(repo_root, sha):
  2989	    """[git:sha] Tier B 驗證:git cat-file -e sha^{commit}。非 git repo/物件缺 → False。"""
  2990	    import subprocess
  2991	    try:
  2992	        r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=str(repo_root),
  2993	                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
  2994	        return r.returncode == 0
  2995	    except OSError:
  2996	        return False
