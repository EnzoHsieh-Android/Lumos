 17731	def _codeloop_git_ts(repo_root):
 17732	    """取 HEAD committer date(ISO 8601);失敗回空字串。"""
 17733	    import subprocess
 17734	    r = subprocess.run(["git", "show", "-s", "--format=%cI", "HEAD"],
 17735	                       capture_output=True, text=True, cwd=str(repo_root))
 17736	    return r.stdout.strip().splitlines()[0] if r.stdout.strip() else ""
