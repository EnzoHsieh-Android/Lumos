  2957	def cmd_contracts(env, rel=None):
  2958	    """合約登記簿: ★INVARIANT★(改=breaking) / ★DEBT★(可改)。
  2959	    動某模組前先查它的硬合約 — Obsidian 做不到(子字串不在它的 graph 裡)。
  2960	    ★INVARIANT★ 顯示綁定的測試(可執行證據);未綁=⚠(doctor Check T 會擋)。"""
  2961	    targets = [rel] if rel else sorted(env.notes)
  2962	    n_inv = n_debt = 0
  2963	    for r in targets:
  2964	        inv, debt = extract_contracts(env.notes[r])
  2965	        if not inv and not debt:
  2966	            continue
  2967	        print(f"# {r}")
  2968	        for x in inv:
  2969	            clean, refs = strip_test_refs(x)
  2970	            print(f"  ★INVARIANT★ {clean}")
  2971	            print(f"      ↳ 綁的測試: {', '.join(refs)}" if refs else "      ↳ 提醒:沒綁測試,沒有可執行的證據")
  2972	            n_inv += 1
  2973	        for x in debt:
  2974	            print(f"  ★DEBT★ {x}")
  2975	            n_debt += 1
  2976	    if n_inv == 0 and n_debt == 0:
  2977	        print("(這篇沒有登記任何「動了會壞」的合約)" if rel else "(整個圖譜都沒有登記合約——要標的話在 KEY 行前面加 ★INVARIANT★ 或 ★DEBT★)")
  2978	    else:
  2979	        print(f"\n合約 {n_inv} 條(改了就是破壞性變更) | 技術債 {n_debt} 條(可以改)")
  2980	    return 0
