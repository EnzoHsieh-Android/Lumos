  2872	def extract_reversibility(note):
  2873	    """從 summary KEY 行抽 (marker, 去 [rollback:]/[guard:] 的乾淨文字, rollback_ref, guard_ref)。"""
  2874	    summ = note.fields.get("summary")
  2875	    out = []
  2876	    if isinstance(summ, str):
  2877	        for raw in summ.split("\n"):
  2878	            line = raw.strip()
  2879	            for marker, rx in (("★CHECKPOINT★", CHECKPOINT_RE), ("★IRREVERSIBLE★", IRREVERSIBLE_RE)):
  2880	                m = rx.match(line)
  2881	                if m:
  2882	                    body = m.group(1)
  2883	                    clean_body = ROLLBACK_REF_RE.sub("", GUARD_REF_RE.sub("", body)).strip()
  2884	                    out.append((marker, clean_body,
  2885	                                reversibility_rollback_ref(body), reversibility_guard_ref(body)))
  2886	    return out
