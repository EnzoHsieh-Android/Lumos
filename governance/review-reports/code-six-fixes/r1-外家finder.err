 14019	def _delguard_is_diff_header(ln):
 14020	    """True=這行是 unified diff 的檔頭行(--- a/… / +++ b/… / …/dev/null),不是內容行。
 14021	    ★不可寫成 startswith(("---","+++"))★——被刪的 SQL/Lua 註解行 `-- x` 在 diff 裡長成
 14022	    `--- x`,那樣會被當檔頭吃掉、整行 token 靜默漏抽(2026-08-11 code-loop r1 s5 F6)。"""
 14023	    return (ln.startswith("--- a/") or ln.startswith("+++ b/")
 14024	            or ln.startswith("--- /dev/null") or ln.startswith("+++ /dev/null"))
