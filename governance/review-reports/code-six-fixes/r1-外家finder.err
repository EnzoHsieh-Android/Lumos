   185	  echo "   1. 把該改的筆記改一改,加進 commit,再提交一次。"
   186	  echo "   2. 這次真的不需要動筆記(改錯字、排版、註解、還在進行中的半成品)→ 跳過這道檢查:"
   187	  echo "        git commit --no-verify -m '<訊息>'"
