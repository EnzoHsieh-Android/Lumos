   110	        return 0
   111	    prompt = tool_input.get("prompt")
   112	    if not isinstance(prompt, str):
   113	        return 0
   114	    rng = find_marker(prompt)
   115	    spec = find_spec_marker(prompt) if rng is None else None
   116	    if rng is None and spec is None:
   117	        return 0
   118	    repo = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd", "")
   119	    if not repo:
   120	        _debug("沒有 CLAUDE_PROJECT_DIR 也沒有 cwd,放行")
   121	        return 0
   122	    lumos = _find_lumos_script()
   123	    if lumos is None:
   124	        _debug("找不到 lumos,放行")
   125	        return 0
   126	    argv = [sys.executable, lumos, "dispatch-lens"] + ([rng] if rng else ["--spec", spec]) + ["--repo", repo, "--json"]
   127	    try:
   128	        r = subprocess.run(argv, capture_output=True, text=True, timeout=INNER_TIMEOUT)
   129	    except subprocess.TimeoutExpired:
   130	        # 2026-09-05 第二輪審視 d1:超時不再靜默——今天 39 次派工 21 次放空,編排者完全不知道。附一行固定句(零自由文字)。
   131	        what = rng or spec
   132	        _emit_updated(tool_input, prompt, TIMEOUT_NOTE.format(what=what, n=10))
   133	        _debug("lumos dispatch-lens 超時,已附超時說明行")
   134	        return 0
   135	    except OSError as e:
   136	        _debug(f"lumos dispatch-lens 失敗({type(e).__name__}),放行")
   137	        return 0
   138	    if r.returncode != 0:
   139	        _debug(f"lumos dispatch-lens rc={r.returncode}:{r.stderr.strip()[:200]},放行")
   140	        return 0
   141	    try:
   142	        data = json.loads(r.stdout.strip().splitlines()[-1])
   143	    except (ValueError, IndexError):
   144	        _debug("回傳讀不懂,放行")
   145	        return 0
   146	    text = data.get("text") if isinstance(data, dict) else None
   147	    if not text:
   148	        _debug(f"固定席 0 篇(pinned={data.get('pinned') if isinstance(data, dict) else '?'}),不注入")
   149	        return 0
   150	    _emit_updated(tool_input, prompt, text)
   151	    _debug(f"已附 {data.get('shown')} 篇(固定席 {data.get('pinned')},主線 {data.get('mainline', data.get('mode'))})")
   152	    return 0
   153	
   154	
   155	if __name__ == "__main__":
   156	    sys.exit(main())
