   423	def main():
   424	    ap = argparse.ArgumentParser()
   425	    ap.add_argument("--repo", default=str(ROOT),
   426	                    help="要被探的專案根目錄(預設=本 repo)。★探別的專案必須給★——"
   427	                         "沒給的話不論在哪個目錄執行,複製的都是 lumos-toolchain 自己,"
   428	                         "題目再怎麼寫都是在探錯的 repo(2026-08-22 實際踩過)")
   429	    ap.add_argument("--scenarios", default=str(ROOT / "governance" / "scenarios" / "commands.jsonl"))
