+def _scenario_max_turns(sc, default):
+    """每題可自帶 max_turns(2026-09-05 第二輪審視 d6:s15 這種要先查再建的題 18 步不夠,24 步時被砍在建檔前)。壞值退預設。"""
+    try:
+        v = int(sc.get("max_turns", default))
+        return v if v > 0 else default
+    except (TypeError, ValueError):
+        return default
