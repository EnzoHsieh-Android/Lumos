  3009	def check_regen_provenance(note, repo_root):
  3010	    """Check J(regen 重生來源守衛)共用檢查器——cmd_lint 與 run_doctor 同呼叫同一函式(防兩入口
  3011	    規則漂移)。只對 frontmatter 帶 regen 的節點生效;非 regen 節點回三空。只掃 summary 行。
  3012	    回 (errs, warns, gov_events),兩入口映射(spec 映射表,照抄不猜):
  3013	      errs → lint errs 計 rc1 / doctor warn(hard) 計 issues
  3014	      warns → lint 顯示不計 rc / doctor warn_soft(J-d 提醒與 shallow 降級兩入口皆非阻擋)
  3015	      gov_events → 僅 doctor --ci 落 _append_governance_log;lint 高頻一律不落帳(防治理帳灌水)
  3016	    註:本函式為 regen 節點對 lint「node-local 不掃 repo」原則的 opt-in 例外(檔案+git 存取)。
  3017	    設計:Projects/from-scratch重生守衛_計劃;golden: governance/golden/fromscratch-m1。"""
  3018	    errs, warns, gov = [], [], []
  3019	    regen = note.fields.get("regen")
  3020	    if not (isinstance(regen, str) and regen.strip()):
  3021	        return errs, warns, gov
  3022	    summ = note.fields.get("summary")
  3023	    summ = summ if isinstance(summ, str) else ""
  3024	    shallow = None  # 惰性判定(每節點至多一次 rev-parse)
  3025	    untagged_keys = 0
  3026	    has_git_ptr = "[git:" in summ  # presence-guard:整節點無 [git: 子串即不 spawn
  3027	    for raw in summ.split("\n"):
  3028	        line = raw.strip()
  3029	        if not line:
  3030	            continue
  3031	        has_src = SRC_REF_RE.search(line)
  3032	        has_git = GIT_REF_RE.search(line)
  3033	        prefix_m = REGEN_PREFIX_RE.match(line)
  3034	        # 不對稱接線:推測/佚失 不得承載合約/不可逆(raw 行獨立偵測——INVARIANT_RE 對此形態
  3035	        # 整行不 match,靠它=該行對 Check T/contracts 隱形,比擋下更毒;四組合皆觸發)
  3036	        if prefix_m and ("★INVARIANT★" in line or "★IRREVERSIBLE★" in line):
  3037	            errs.append(f"『{prefix_m.group(1)}:』行不得承載 ★INVARIANT★/★IRREVERSIBLE★"
  3038	                        f"(合約不能建在推測上;補 [src:]/[git:] 或走 signoff 升級):{line[:48]}")
  3039	            continue
  3040	        # J-a:regen ★INVARIANT★ 需 [src:]/[git:] 意圖證據(與 Check T 的 [test:] 疊加——
  3041	        # [test:] 只證行為現在成立,不證意圖是合約;拒絕發明合約)
  3042	        if INVARIANT_RE.match(line) and not (has_src or has_git):
  3043	            errs.append(f"regen 節點的 ★INVARIANT★ 缺 [src:]/[git:] 意圖證據"
  3044	                        f"(J-a 拒絕發明合約):{line[:48]}")
  3045	        # J-b:DECISION 行需證據指針或顯式標 推測:/佚失:(重建的 why 必須標來源或標推測)
  3046	        if line.startswith("DECISION:") and not (has_src or has_git or prefix_m):
  3047	            errs.append(f"regen 節點的 DECISION 行無證據指針且未標 推測:/佚失:(J-b):{line[:48]}")
  3048	        # J-d:無 tier 標記的 KEY 行計數(唯讀提醒,不寫回任何欄位)
  3049	        if line.startswith("KEY:") and not (has_src or has_git or prefix_m):
  3050	            untagged_keys += 1
  3051	        # J-c:[src:] substring gate(直走 _validate_repo_ref,不經 top_dirs 靜默過濾)
  3052	        for m in SRC_REF_RE.finditer(line):
  3053	            path, lno = m.group(1).strip(), (m.group(2) or "")
  3054	            status, _ = _validate_repo_ref(repo_root, path, lno)
  3055	            if status == "missing":
  3056	                errs.append(f"[src:{path}] 目標不存在(J-c dangling=幻覺證據)")
  3057	            elif status == "line_out_of_range":
  3058	                errs.append(f"[src:{path}:{lno}] 行號越界(J-c)")
  3059	        # J-c:[git:sha](presence-guard 後才 spawn;shallow 降級=顯性+僅 doctor --ci 留痕,不得靜默)
  3060	        if has_git_ptr:
  3061	            for m in GIT_REF_RE.finditer(line):
  3062	                sha = m.group(1)
  3063	                if _git_commit_exists(repo_root, sha):
  3064	                    continue
  3065	                if shallow is None:
  3066	                    shallow = _git_is_shallow(repo_root)
  3067	                if shallow:
  3068	                    warns.append(f"[git:{sha[:12]}] Tier B 驗證跳過(shallow clone,本地無該物件;"
  3069	                                 f"非擋——full clone 下會重驗)")
  3070	                    gov.append({"gate": "check-j", "kind": "shallow-skip", "hard": False,
  3071	                                "nodes": [note.stem]})
  3072	                else:
  3073	                    errs.append(f"[git:{sha[:12]}] commit 不存在(J-c dangling=幻覺證據)")
  3074	    if untagged_keys:
  3075	        warns.append(f"{untagged_keys} 條 KEY 行無 tier 標記([src:]/[git:]/推測:/佚失:)"
  3076	                     f"——J-d 提醒:prose 級誠實機械驗不了,建議補標或過對抗審")
  3077	    return errs, warns, gov
  3078	
