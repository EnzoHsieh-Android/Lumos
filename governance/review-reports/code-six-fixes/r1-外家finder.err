 16480	        via = _impact_via(from_node, node, is_backlink, env)
 16481	        direction = "backlink" if is_backlink else "outlink"
 16482	        all_indirect.append({
 16483	            "node": node, "hop": hop, "via": via, "direction": direction,
 16484	            "from": from_node, "contract": bfs_contract, "combo": bfs_combo,
 16485	        })
 16486	
 16487	    # 6. 排序(§2.4):合約節點優先 → 直接優先於間接(已分層) → 同層 hop 升序
 16488	    # 合約優先權:IRREVERSIBLE=2, INVARIANT=1, None=0
 16489	    def contract_priority(contract):
 16490	        if contract == "IRREVERSIBLE":
 16491	            return 2
 16492	        if contract == "INVARIANT":
 16493	            return 1
 16494	        return 0
 16495	
 16496	    all_direct.sort(key=lambda x: -contract_priority(x.get("contract")))
 16497	    all_indirect.sort(key=lambda x: (x.get("hop", 999), -contract_priority(x.get("contract"))))
 16498	
 16499	    # 7. 路徑規範化(用於輸出 + _match_incident_triggers 的 file_rel)
