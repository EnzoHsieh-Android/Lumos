  3912	def _report_severities(text):
  3913	    """[嚴重度綁定機械掃 S1] 報告檔 severity 宣告的★單一 parse 實作★(寫側+severity-check 共用)。
  3914	    逐行 fullmatch、空白只認水平空白(反斜線s 會吞換行讓標籤與值跨行黏上,r2 ext);
  3915	    行首錨定天生排掉引句行(以標籤起頭)與 blockquote(以 > 起頭)兩型逃逸(r1 s1/s2);
  3916	    大小寫、全形冒號、行首雜字一律不認(fixture 釘)。回 list[str](出現序)。"""
  3917	    out = []
  3918	    for line in text.splitlines():
  3919	        m = re.fullmatch(r"severity:[ \t]*(clean|minor|major|blocker)[ \t]*", line)
  3920	        if m:
  3921	            out.append(m.group(1))
  3922	    return out
