 14178	def _delguard_purelink(diff_lines):
 14179	    """True=本檔 diff 只有「連結欄位鍵頭/連結列表項」的變更。
 14180	       合格行(±開頭,剝符號後): `- "[[..]]"` 列表項,或 `<LINK_KEYS 之一>:` 鍵頭。
 14181	       其他任何 ± 行(含 pitfall_when:/tags: 鍵頭、body 文字、YAML 重排)→ False。
 14182	       ★縮排/重排也算動過內容★:某 `-` 與某 `+` 行 strip 後相同(純空白差異)=搬行/重縮排,
 14183	       不是「只掛連結」,一律 False(保守朝報;2026-08-11 code-loop r1 N / spec C5)。"""
 14184	    import re
 14185	    item_re = re.compile(r'^\s*-\s*"?\[\[[^\]]+\]\]"?\s*$')
 14186	    key_re = re.compile(r"^(%s):\s*$" % "|".join(LINK_KEYS))
 14187	    plus = [ln[1:] for ln in diff_lines
 14188	            if ln.startswith("+") and not _delguard_is_diff_header(ln)]
 14189	    minus = [ln[1:] for ln in diff_lines
 14190	             if ln.startswith("-") and not _delguard_is_diff_header(ln)]
 14191	    changed = plus + minus
 14192	    if not changed:
 14193	        return False
 14194	    ms = {c.strip() for c in minus}
 14195	    if any(p.strip() in ms for p in plus):
 14196	        return False
 14197	    return all(item_re.match(c) or key_re.match(c) for c in changed)
 14198	
