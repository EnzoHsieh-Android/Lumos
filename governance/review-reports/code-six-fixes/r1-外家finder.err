    31	def find_marker(prompt: str) -> str | None:
    32	    for line in prompt.split("\n"):
    33	        m = MARKER_RE.match(line.strip())
    34	        if m:
    35	            return m.group(1)
    36	    return None
    37	
    38	
    39	def find_spec_marker(prompt: str) -> str | None:
    40	    for line in prompt.split("\n"):
    41	        m = SPEC_RE.match(line.strip())
    42	        if m:
    43	            return m.group(1)
    44	    return None
