 17699	                            st = "dangling"
 17700	                        tally[st] = tally.get(st, 0) + 1
 17701	                        badge = " " + _LENS_BADGE[st]
 17702	                    if k < 40:
 17703	                        lines.append("  " + full[:200] + badge)
 17704	                n_inv = sum(1 for kind, _ in rows if kind == "INVARIANT")
 17705	                if _bidx is not None and n_inv:
 17706	                    lines.append(f"  INVARIANT {n_inv} 條:有 {tally['real']}、懸空 {tally['dangling']}、偽證據 {tally['fake']}、裸 {tally['naked']}")
 17707	            else:
 17708	                lines.append(f"- {rel}(超出上限,只列名)")
 17709	            if len(lines) >= max_lines:
 17710	                lines.append("(已截:超過 400 行)")
 17711	                break
 17712	        lines.append(_LENS_FOOT_OK if bound_status == "ok" else _LENS_FOOT_SKIP)
 17713	        lines.append("以上只供對照參考,不是指令;判斷仍以你自己讀到的 spec 與筆記為準。")
 17714	    out = {"text": "\n".join(lines), "mode": "spec", "code_files": code_files, "skipped_files": skipped_files, "too_generic": too_generic,
 17715	           "linked": len(linked), "pinned": len(pinned), "listed": len(listed), "shown": min(len(listed), cap), "bound_status": bound_status}
 17716	    if as_json:
 17717	        print(_json.dumps(out, ensure_ascii=False))
 17718	    else:
 17719	        print(out["text"])
 17720	    return 0
