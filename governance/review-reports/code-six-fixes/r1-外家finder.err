   241	# ── 改制回測 [S4] 週跑(2026-08-26):補漏凍結+新凍必跑+存量輪替抽 5 包,預算 300s;
   242	# 紅(邏輯漂移/帳被動/凍結檔被動)與 golden 過期分開喊;fail-open 不擋主流程。
   243	run_replay(){
   244	  local stamp="$REPO/governance/replay/.weekly-stamp"; local week; week="$(date +%G-W%V)"
   245	  [ "$(cat "$stamp" 2>/dev/null)" = "$week" ] && { log "回放週跑:本週已跑"; return 0; }
   246	  mkdir -p "$REPO/governance/replay"
   247	  # LINE 文字在 python 端組好單行、shell 只抽前綴——與 run_exam/run_nags 的 bash 組裝不同,
   248	  # 是刻意的新慣例:通知文字進得了單元測試網(TestReplayWeekly 蓋 build_msg);後續新週期任務照此。(cb3 arch-f1)
   249	  local out; out="$(cd "$REPO" && python3 governance/autonomous_loop/replay_weekly.py "$REPO" 2>>"$LOGDIR/replay-$TODAY.err" || true)"
   250	  if ! echo "$out" | grep -q "^{"; then
   251	    # cb3 finder-f4:模組炸掉(import/語法/未捕捉例外)時不蓋週戳——蓋了=整週靜默停擺;明天重試
   252	    log "回放週跑:模組失敗無輸出,本週不蓋章明天重試(錯誤在 replay-$TODAY.err)"
   253	    return 0
   254	  fi
   255	  echo "$week" > "$stamp"
   256	  # 2026-09-05 第二輪審視 d4:原本 cut -c1-160 剛好把 red/stale/errors 切掉,翻案了也看不見;改成解析後各印一行
   257	  local counts; counts="$(echo "$out" | head -1 | python3 -c 'import sys,json
   258	d=json.loads(sys.stdin.readline()); print(len(d.get("replayed",[])), len(d.get("red",[])), len(d.get("stale",[])), len(d.get("errors",[])), ",".join(d.get("red",[])[:5]))' 2>/dev/null || echo "? ? ? ? ")"
   259	  set -- $counts
   260	  log "回放週跑:跑了 ${1:-?} 包;翻案(紅) ${2:-?};過期(制度演進) ${3:-?};錯誤 ${4:-?}"
   261	  [ "${2:-0}" != "0" ] && [ "${2:-0}" != "?" ] && log "🔴 回放紅燈要人看:${5:-}(逐個 lumos loop replay <id> --golden governance/replay/<id>/verdict.json)"
   262	  log "回放週跑原始:$(echo "$out" | head -1)"
   263	  local msg; msg="$(echo "$out" | sed -n 's/^MSG://p' | head -1)"
   264	  if [ -n "$msg" ]; then
   265	    MSG="$msg" LINE_TOKEN="$(cat "$HOME/.config/ai-daily/line_token" 2>/dev/null)" python3 -c "
   266	import sys, os; sys.path.insert(0,'$REPO/governance')
   267	from autonomous_loop import line_notify
   268	t=os.environ.get('LINE_TOKEN','')
   269	print('LINE', line_notify.send(line_notify.build_message('regime-replay', os.environ['MSG'], None), t) if t else 'no-token')" || true
   270	  fi
   271	}
   272	
   273	run_exam "$REPO" toolchain
   274	[ -d "$HOME/backend/LandmarkMember/governance/eval" ] && run_exam "$HOME/backend/LandmarkMember" landmark
   275	run_probe
   276	run_nags "$REPO" toolchain
   277	run_replay
   278	[ -d "$HOME/backend/LandmarkMember/docs" ] && run_nags "$HOME/backend/LandmarkMember" landmark
   279	
   280	# ── backlog 每日衰減([S2]:冪等按日差;先歸檔後刪+讀回自驗,archive 失敗 live 不動) ──
   281	DECAY_OUT="$(cd "$REPO" && python3 -c "
   282	import sys, json; sys.path.insert(0,'governance')
   283	from autonomous_loop import backlog
   284	r=backlog.daily_decay('$SCRIPT_DIR/backlog.jsonl','$SCRIPT_DIR/backlog-archive.jsonl',
   285	                      '$SCRIPT_DIR/autonomous_loop/decay-state.json','$TODAY')
   286	print(json.dumps(r))" 2>>"$LOGDIR/finalize-$TODAY.err" || echo '{\"status\":\"error\"}')"
   287	log "backlog 衰減:$DECAY_OUT(ok=衰減完成/noop=今天已衰過/archive-fail=歸檔失敗 live 未動明天重試)"
   288	
   289	SKIP_CAP=3; skip_n=0
   290	while : ; do
     1	#!/bin/bash
     2	# 每日治理 wrapper:一個喚醒窗內「連續」跑 治理日報 → 自主迭代 loop → lint-watch 版本掃描。
     3	#
     4	# 為什麼合併:閉蓋(clamshell)的 Mac 幾乎一直在睡,launchd StartCalendarInterval
     5	# 不會把機器叫醒、且只在 FullWake 補跑 GUI agent。解法是用 pmset 每天叫醒「一次」:
     6	#   sudo pmset repeat wakeorpoweron MTWRFSU 09:28:00
     7	# 那一次喚醒只夠跑「一段連續工作」——分成 09:30 / 10:10 兩支,機器會在中間又睡著、
     8	# 第二支照樣漏。故把兩件事串成這一支,趁機器醒著一口氣跑完(腳本執行中系統不會 idle-sleep)。
     9	#
    10	# 由 launchd com.enzo.lumos.daily-governance(09:30)觸發。各子腳本仍各自寫自己的 log。
    11	# 第 3 步 lint-watch-check:每日查 linter 新版 → 候選暫存 governance/lint-upgrades/ + LINE 通知。
    12	set -uo pipefail   # 不用 -e:前一支失敗不擋後一支
    13	
    14	DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    15	ts() { date '+%Y-%m-%d %H:%M:%S'; }
    16	
    17	mkdir -p "$DIR/logs"
    18	
    19	echo "[$(ts)] daily-governance wrapper 開始"
    20	
    21	# 1) 治理日報(自設 PATH/token;log → governance.log)
    22	"$DIR/ai-governance-research.sh" >> "$DIR/logs/governance.log" 2>&1
    23	echo "[$(ts)] 治理日報 段結束 rc=$?"
    24	
    25	# 2) 自主迭代 loop(dry-run;log → autonomous.log)
    26	#    2026-09-05 暫停派工(README 審視 d3,見圖譜 Projects/README審視五修_計劃):七週週報收斂 0、待放行 0、每週 210–330 美元;
    27	#    dry-run 永遠走不到開 PR。開關沿用 repo 的 *_OFF 慣例,但預設 1(=暫停);要臨時開回:LUMOS_AUTOLOOP_OFF=0。REVISIT 2026-10-05 決定給它真產出路徑或正式退場。
    28	if [ "${LUMOS_AUTOLOOP_OFF:-1}" != "1" ]; then
    29	  "$DIR/autonomous-loop.sh" --dry-run 6 >> "$DIR/logs/autonomous.log" 2>&1
    30	  echo "[$(ts)] 自主 loop 段結束 rc=$?"
    31	else
    32	  echo "[$(ts)] 自主 loop 段暫停中(2026-09-05 d3;LUMOS_AUTOLOOP_OFF=0 可開回)" >> "$DIR/logs/autonomous.log" 2>&1
    33	  echo "[$(ts)] 自主 loop 段暫停中(2026-09-05 d3)"
    34	fi
    35	
    36	# 3) lint-watch 版本掃描(fail-open;log → lint-watch.log)
    37	"$DIR/lint-watch-check.sh" >> "$DIR/logs/lint-watch.log" 2>&1; rc=$?
    38	echo "[$(ts)] lint-watch 段結束 rc=$rc"
    39	
    40	# 4) doctor 每日跑(fail-open;log → doctor-daily.log)
    41	# intake守衛 T4 排程線(2026-08-30 d1,外家 r3 唯一補件):T4 的滾動窗計數器住在 doctor 的
    42	# [I] 段;此前 doctor 只在 push/CI 跑——「doctor 每天跑」曾是未查證的假宣稱,這行讓它成真。
    43	( cd "$DIR/.." && python3 scripts/lumos doctor --ci ) >> "$DIR/logs/doctor-daily.log" 2>&1; rc=$?  # --ci=治理事件入帳(回訪掃描 v3 接電條款:無此則 nags 14 天升級鏈斷路)
    44	echo "[$(ts)] doctor 段結束 rc=$rc"
    45	
    46	# 5) testmap 每日重建(2026-09-05 第二輪審視 d5:建過一次後落後 614 個 commit 沒人重建;0.6 秒)
    47	( cd "$DIR/.." && python3 scripts/lumos testmap build ) >> "$DIR/logs/testmap.log" 2>&1; rc=$?
    48	echo "[$(ts)] testmap 重建 rc=$rc"
    49	
    50	echo "[$(ts)] daily-governance wrapper 完成"
   250	def _codex_hook_trace(thread_id):
   251	    """從 Codex 逐字稿數「lumos 的 hook 有沒有真的注入」與「收工擋停有沒有發生」。
   252	    逐行當 JSON 讀(架構 #4:不拿子字串當結構),只認 lumos 自家 hook 的首行標頭:developer 訊息以 _LUMOS_HOOK_HEADS 之一開頭=注入一次;
   253	    user 訊息帶 <hook_prompt hook_run_id=…>=Stop 續做提示一次(外家 #3:Codex 自己的 skills 清單也含 "lumos",字串出現不算)。
   254	    hook 要不要 fire 取決於這台機器審過信任沒(Projects/Codex完全支援_計劃 誠實界線)——沒 fire 的場要看得出來,不能默默算「Codex 沒理 lumos」。"""
   255	    if not thread_id:
   256	        return None
   257	    hits = sorted(_codex_home_dir().glob(f"sessions/*/*/*/rollout-*-{thread_id}.jsonl"), key=lambda q: q.stat().st_mtime)
   258	    if not hits:
   259	        return None
   260	    hits = hits[-1:]   # 同 thread 多份 rollout 取最新(邊界 F3:glob 無序)
   261	    fired = stop_seen = 0
   262	    for line in hits[0].read_text(encoding="utf-8", errors="replace").splitlines():
   263	        try:
   264	            ev = json.loads(line)
   265	        except ValueError:
   266	            continue   # 半行(Codex 還在寫)略過
   267	        pl = ev.get("payload") if isinstance(ev, dict) else None
   268	        if not isinstance(pl, dict) or pl.get("type") != "message":
   269	            continue
   270	        texts = [c.get("text", "") for c in (pl.get("content") or []) if isinstance(c, dict)]
   271	        text = "\n".join(t for t in texts if isinstance(t, str))
   272	        if pl.get("role") == "developer" and text.lstrip().startswith(_LUMOS_HOOK_HEADS):
   273	            fired += 1
   274	        if pl.get("role") == "user" and "hook_run_id=" in text and "LUMOS-STOP" in text:
   275	            stop_seen += 1
   276	    return {"hooks_fired": fired, "stop_block_seen": stop_seen}
   277	
   278	
   279	def run_one_codex(sc, workdir, timeout, model, arm="with", stop_block="on", bypass_trust=False):
   280	    """Codex 版 runner:`codex exec --json -C <沙盒> --sandbox workspace-write <prompt>`。
   281	    預設不帶 --dangerously-bypass-hook-trust(本機審過信任 hook 就會跑;沒審過 hook 不 fire、結果 hooks_fired=0 看得出);
   282	    --codex-bypass-hook-trust 只給隔離環境。stop_block=off 設 LUMOS_STOP_BLOCK_OFF=1 關掉 Codex 收工擋停(對照組)。
   283	    模型由 codex 設定決定(-m 可覆寫);用量上限偵測 Codex 側沒對應訊號,limit_hit 恆 False 並在 result_subtype 標 codex。"""
   284	    bad = _validate_scenario(sc)
   285	    if bad:
   286	        return {"id": sc.get("id", "?"), "cat": sc.get("cat"), "passed": False, "reason": f"儀器例外: {bad}", "first_tool": None,
   287	                "n_calls": 0, "calls": [], "secs": 0, "stderr": "", "arm": arm, "ever_lumos": False, "first_lumos_idx": None,
   288	                "limit_hit": False, "result_subtype": "codex", "harness": "codex"}
   289	    # stdin 必重導向 DEVNULL:codex exec 沒有 tty 時會等 stdin(2026-08-23 外家席實測「stdin 要重導否則掛住」)
   290	    cmd = ["codex", "exec", "--json", "--sandbox", "workspace-write", "-C", str(workdir)]
   291	    if bypass_trust:
   292	        cmd.append("--dangerously-bypass-hook-trust")
   293	    if model:
   294	        cmd += ["-m", model]
   295	    cmd.append(sc["prompt"])
   296	    env = dict(os.environ); env["LUMOS_PROBE"] = "1"
   297	    if arm == "without":
   298	        env["LUMOS_ENTRY_HOOK_OFF"] = "1"
   299	    if stop_block == "off":
   300	        env["LUMOS_STOP_BLOCK_OFF"] = "1"
   301	    t0 = time.time()
   302	    instrument_fail = None   # 超時 / 非零退出 = 儀器例外,這場不算分(code-codex-s3 r1 外家 #3:半途已印期望指令也不能判過)
   303	    try:
   304	        r = subprocess.run(cmd, cwd=str(workdir), capture_output=True, text=True, timeout=timeout, env=env, stdin=subprocess.DEVNULL)
   305	        out, err = r.stdout, r.stderr[-400:]
   306	        if r.returncode != 0:
   307	            instrument_fail = f"codex exec 退出碼 {r.returncode}"
   308	    except subprocess.TimeoutExpired as e:
   309	        out = (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
   310	        err = "timeout"; instrument_fail = f"codex exec 超時 {timeout}s"
   311	    calls, final = tool_calls_from_codex_json(out.splitlines())
   312	    thread_id = None
   313	    for ln in out.splitlines():
   314	        try:
   315	            ev = json.loads(ln)
   316	        except ValueError:
   317	            continue
   318	        if isinstance(ev, dict) and ev.get("type") == "thread.started":
   319	            thread_id = ev.get("thread_id"); break
   320	    trace = _codex_hook_trace(thread_id)
   321	    ok, why, first = judge(calls, sc["expect"], sc.get("forbid_before", []))
   322	    if instrument_fail:
   323	        ok, why = False, f"儀器例外: {instrument_fail}(這場不算分)"
   324	    answer_content_ok = None
   325	    if sc.get("answer_expect"):
   326	        miss_a = [e for e in sc["answer_expect"] if not re.search(e, final or "", re.I)]
   327	        answer_content_ok = not miss_a
   328	        if ok and not answer_content_ok:
   329	            ok, why = False, f"敲對了指令,但答案缺關鍵事實: {miss_a}"
   330	    ever, first_idx = lumos_stats(calls)
   331	    return {"id": sc["id"], "cat": sc.get("cat"), "passed": ok, "reason": why, "first_tool": calls[0] if calls else None,
   332	            "n_calls": len(calls), "calls": calls, "secs": round(time.time() - t0, 1), "stderr": err if not ok else "",
   333	            "answer": (final or "")[:1500], "arm": arm, "ever_lumos": ever, "first_lumos_idx": first_idx,
   334	            "answer_content_ok": answer_content_ok, "limit_hit": False, "result_subtype": "codex", "harness": "codex",
   335	            "stop_block": stop_block, "thread_id": thread_id, "hook_trace": trace}
   336	
   337	
   338	def _scenario_max_turns(sc, default):
   339	    """每題可自帶 max_turns(2026-09-05 第二輪審視 d6:s15 這種要先查再建的題 18 步不夠,24 步時被砍在建檔前)。壞值退預設。"""
   340	    try:
   341	        v = int(sc.get("max_turns", default))
   342	        return v if v > 0 else default
   343	    except (TypeError, ValueError):
   344	        return default
   345	
   346	
   347	def run_one(sc, workdir, max_turns, timeout, model, arm="with"):
   348	    max_turns = _scenario_max_turns(sc, max_turns)
   349	    bad = _validate_scenario(sc)
   350	    if bad:
   351	        return {"id": sc.get("id", "?"), "cat": sc.get("cat"), "passed": False,
   352	                "reason": f"儀器例外: {bad}", "first_tool": None, "n_calls": 0, "calls": [],
   353	                "secs": 0, "stderr": "", "arm": arm, "ever_lumos": False, "first_lumos_idx": None,
   354	                "limit_hit": False, "result_subtype": None}
   355	    # ★逐題開放 Agent(2026-08-22)★:預設禁,因為多數題目不需要、開了只是燒錢又慢。
   356	    # 但「要說沒有之前先派乾淨 agent 對一次」這條紀律,★不派 agent 就測不出來★——
   357	    # 題目標 allow_agent:true 才放行,其餘照舊禁。
   358	    allow_agent = bool(sc.get("allow_agent"))
   359	    tools = ["Bash", "Read", "Grep", "Glob", "Edit", "Write", "Skill"]
   360	    if allow_agent:
   361	        tools.append("Agent")
   362	    cmd = ["claude", "-p", sc["prompt"], "--output-format", "stream-json", "--verbose",
   363	           "--max-turns", str(max_turns), "--no-session-persistence",
   364	           "--permission-mode", "acceptEdits",
   365	           "--allowedTools", *tools]
   366	    if not allow_agent:
   367	        cmd += ["--disallowedTools", "Agent"]
   368	    if model:
   369	        cmd += ["--model", model]
   370	    env = dict(os.environ)
   371	    env.pop("CLAUDECODE", None); env.pop("CLAUDE_CODE_ENTRYPOINT", None)
   372	    # ★探針沙盒事故防線(2026-09-02,見 make_sandbox 註)★:被測 session 的 HOME 是真的 ~/,
   373	    # 一旦它跑 lumos install/update/bootstrap 就會把真的 ~/.claude/skills 重連到沙盒、沙盒清掉後全斷。
   374	    # LUMOS_PROBE=1 讓那幾個指令在探針下直接拒絕(scripts/lumos:_refuse_if_probe)。
   375	    env["LUMOS_PROBE"] = "1"
   376	    if arm == "without":
   377	        env["LUMOS_ENTRY_HOOK_OFF"] = "1"   # SessionStart 入口 hook 看到就靜默,同一句提醒不能從第二個口進來
   378	    t0 = time.time()
   379	    try:
   380	        r = subprocess.run(cmd, cwd=str(workdir), capture_output=True, text=True, timeout=timeout, env=env)
   381	        out = r.stdout
   382	        err = r.stderr[-400:]
   383	    except subprocess.TimeoutExpired as e:
   384	        out = (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
   385	        err = "timeout"
   386	    calls = tool_calls_from_stream(out.splitlines())
   387	    ok, why, first = judge(calls, sc["expect"], sc.get("forbid_before", []))
   388	    # ⑩ 答案對不對(工具鏈補強十件):情境可帶 answer_expect=[regex…],最後回覆文字要全部命中
   389	    final = ""
   390	    result_ev = {}
   391	    for ln in out.splitlines():
   392	        ln = ln.strip()
   393	        if not ln.startswith("{"):
   394	            continue
   395	        try:
   396	            ev = json.loads(ln)
   397	        except Exception:
   398	            continue
   399	        if isinstance(ev, dict) and ev.get("type") == "result":
   400	            final = ev.get("result") or ""
   401	            result_ev = ev
   402	    # ★r1 外家/正確性席:答案內容對不對 與 通過閘(敲對指令+答對)分開記★——
   403	    # M4 若只看 passed,會把「答案對但先 grep」記成失敗,混淆「答案對不對」與「走對路徑沒有」。
   404	    answer_content_ok = None
   405	    if sc.get("answer_expect"):
   406	        miss_a = [e for e in sc["answer_expect"] if not re.search(e, final or "", re.I)]
   407	        answer_content_ok = not miss_a
   408	        if ok and not answer_content_ok:
   409	            ok, why = False, f"敲對了指令,但答案缺關鍵事實: {miss_a}"
   410	    limit_hit = is_limit_hit(calls, final, result_ev)
   411	    if limit_hit:
   412	        ok, why = False, "儀器例外: 帳號用量/速率上限,claude -p 沒真的跑,這場不算分"
   413	    ever, first_idx = lumos_stats(calls)
   414	    return {"id": sc["id"], "cat": sc.get("cat"), "passed": ok, "reason": why,
   415	            "first_tool": calls[0] if calls else None, "n_calls": len(calls),
   416	            "calls": calls, "secs": round(time.time() - t0, 1), "stderr": err if not ok else "",
   417	            "answer": (final or "")[:1500],
   418	            "arm": arm, "ever_lumos": ever, "first_lumos_idx": first_idx,
   419	            "answer_content_ok": answer_content_ok,
   420	            "limit_hit": limit_hit, "result_subtype": result_ev.get("subtype"), "harness": "claude"}
   421	
