  2999	def _git_is_shallow(repo_root):
  3000	    import subprocess
  3001	    try:
  3002	        r = subprocess.run(["git", "rev-parse", "--is-shallow-repository"], cwd=str(repo_root),
  3003	                           capture_output=True, text=True)
  3004	        return r.returncode == 0 and r.stdout.strip() == "true"
  3005	    except OSError:
  3006	        return False
