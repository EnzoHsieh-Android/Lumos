 14136	def _delguard_vault_scan(tokens, conf, graph_root_abs, deadline_check=None):
 14137	    """回 [{"node": "Systems/憑證.md", "folder": "Systems", "line_no": int,
 14138	            "line": str(strip,截 160 字), "tokens": [..], "conf": "high"|"low"}...]
 14139	       排序: (conf!=high, folder!="Systems", node, line_no)——高信心先、Systems 先。
 14140	       deadline_check: 選用 callable(),os.walk 外層迴圈每檔呼叫一次;回 True 立即
 14141	       return 目前累積 hits(部分結果,呼叫端已知逾時語意)。"""
 14142	    import re, os
 14143	    if not tokens:
 14144	        return []
 14145	    rx = re.compile(r"\b(?:" + "|".join(map(re.escape, tokens)) + r")\b", re.ASCII)
 14146	    per = {t: re.compile(r"\b" + re.escape(t) + r"\b", re.ASCII) for t in tokens}
 14147	    hits = []
 14148	    for dirpath, _dirs, files in os.walk(graph_root_abs):
 14149	        for fn in files:
 14150	            if deadline_check is not None and deadline_check():
 14151	                hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 14152	                return hits
 14153	            if not fn.endswith(".md"):
 14154	                continue
 14155	            fp = os.path.join(dirpath, fn)
 14156	            rel = os.path.relpath(fp, graph_root_abs)
 14157	            folder = rel.split(os.sep, 1)[0]
 14158	            try:
 14159	                text = open(fp, encoding="utf-8", errors="replace").read()
 14160	            except OSError:
 14161	                continue
 14162	            for i, line in enumerate(text.splitlines(), 1):
 14163	                # 單巨檔也要能中止:只在 os.walk 外層檢查的話,一份幾十萬行的節點會整份掃完
 14164	                # 才輪到下一次檢查,deadline 直接超支(2026-08-11 code-loop r1 H)
 14165	                if deadline_check is not None and i % 2000 == 0 and deadline_check():
 14166	                    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 14167	                    return hits
 14168	                if not rx.search(line):
 14169	                    continue
 14170	                ts = [t for t, p in per.items() if p.search(line)]
 14171	                hits.append({"node": rel.replace(os.sep, "/"), "folder": folder, "line_no": i,
 14172	                             "line": line.strip()[:160], "tokens": ts,
 14173	                             "conf": "high" if any(conf.get(t) == "high" for t in ts) else "low"})
 14174	    hits.sort(key=lambda h: (h["conf"] != "high", h["folder"] != "Systems", h["node"], h["line_no"]))
 14175	    return hits
 14176	
