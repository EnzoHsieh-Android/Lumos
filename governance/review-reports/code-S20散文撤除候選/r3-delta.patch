 def _ns_tr_sub_says_retire(lines, no):
     """條款定義行(第 no 行)的下一層子項(緊接在後、縮排比它深的連續行;遇到空行就停)有沒有一行在講撤除。"""
     ind = len(lines[no - 1]) - len(lines[no - 1].lstrip())
     for ln in lines[no:]:
         if not ln.strip() or len(ln) - len(ln.lstrip()) <= ind:
             return False
         if _ns_tr_says_retire(ln):
             return True
