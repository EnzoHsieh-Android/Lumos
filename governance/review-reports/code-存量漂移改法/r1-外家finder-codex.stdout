# 標準 YAML(1.1/1.2,Obsidian 用的 js-yaml)不加引號會讀成數字、日期、無限大的寫法——這些要加引號才是字串
# (2026-09-26 代碼審 r2 通才席:原本只認十進位整數與小數)。日期欄位(DATE_KEYS)刻意不加引號,走另一條路,不經這裡。
_YAML_TYPED_RE = re.compile(
    r"[-+]?(\d[\d_]*(\.[\d_]*)?|\.\d[\d_]*)([eE][-+]?\d+)?"       # 十進位、小數、科學記號
    r"|[-+]?0[xX][0-9a-fA-F_]+|[-+]?0[oO]?[0-7_]+|[-+]?0[bB][01_]+"  # 十六、八、二進位
    r"|[-+]?\d[\d_]*(:[0-5]?\d)+(\.[\d_]*)?"                        # 六十進位(1:20:30)
    r"|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN)"                          # 無限大、非數
    r"|\d{4}-\d\d?-\d\d?([Tt ].*)?")                                  # 日期、日期時間
_YAML_PLAIN_BAD_START = set("-?:,[]{}#&*!|>'\"%@`")


def _yaml_plain_ok(v):
    """★白名單★:這個值不加引號時,本工具的簡易讀法與標準 YAML(Obsidian 等)讀出來一模一樣嗎。
    只放行確定沒事的;拿不準的一律加引號(2026-09-26 代碼審 r1:原本只列「要加引號的」,
    漏了「空白 + #」被標準 YAML 當註解切掉、「- 」開頭被當清單)。"""
    return (v != "" and v == v.strip() and "\n" not in v and "\t" not in v
            and v[0] not in _YAML_PLAIN_BAD_START and ": " not in v and " #" not in v and not v.endswith(":")
            and v.lower() not in ("true", "false", "null", "yes", "no", "on", "off", "~")
            and not _YAML_TYPED_RE.fullmatch(v))


def _yaml_quote(v, what):
    """加引號,只用兩邊讀法一致的寫法:本工具讀的一側只剝掉頭尾一層引號、不解任何跳脫。
    雙引號在標準 YAML 裡會解反斜線跳脫 → 只在沒有反斜線、沒有雙引號時用;
    否則單引號(標準 YAML 裡除了 '' 以外一律照字面)→ 只在沒有單引號時用;兩種都不行就擋。"""
    if '"' not in v and "\\" not in v:
        return '"' + v + '"'
    if "'" not in v:
        return "'" + v + "'"
    raise ValueError(f"{what}「{v}」同時有單引號、又有雙引號或反斜線,工具寫不出本工具和 Obsidian 都讀得一樣的寫法,"
                     "檔案沒動;把其中一種引號換掉再寫")


def fmt_scalar(key, value):
    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
        return v  # bare,絕不加引號
    return b is not None and _head_is_shebang(b[:200])


# 只放連結的指路行:連結裡不准有別名或段落(`[[目標|別名]]`、`[[目標#段落]]` 都能夾帶現況,代碼審 r2、r3 通才席);
# 分隔認中文常用的標點與連接詞(r3 外家席:原本把全形逗號打成半形,測試也用半形,假綠)
_NS_POINTER_ONLY_RE = re.compile(r"^(?:\s*(?:\[\[[^\]|#]+\]\]|見|→|,|\uff0c|、|\u3002|;|\uff1b|與|和|及|\||｜)\s*)*$")


def _ns_pin_ok(repo_root, p, lno, s):
    sha = _pin_commit(repo_root, s)
    return sha is not None and _validate_repo_ref(repo_root, p, lno, at_sha=sha)[0] == "ok"


def _ns_is_regen(text):
    """帶 regen 的重建筆記:照 Check J 看解析後的值(空字串不算;代碼審 r3 外家席:原本看原始文字,`regen: ""` 也算)。"""
    fm, _b = split_frontmatter(text)
    if not fm:
        return False
    v = parse_frontmatter(fm)[0].get("regen")
    return isinstance(v, str) and bool(v.strip())


def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name, regen=False):
    """一行新增內容 → [(規則, 片段, 改法)]。by_name(檔名)→ 同名的程式檔清單。"""
    out = []
    # [src:路徑:行號] 是從程式碼重建的筆記的出處標記,★只在帶 regen 的筆記的 summary 裡★歸重建守衛(Check J)驗;
    # 別的地方照一般行號引用判(代碼審 r2 通才席:原本對所有筆記豁免,一般筆記寫 [src:…] 就能夾帶行號)
    scan = SRC_REF_RE.sub(" ", text) if (regen and region == "summary") else text
    pins, singles = [], []
    full, _bare = _node_code_ref_tokens(scan, top_dirs, bare_text=True, anchors=True, keep_fences=True,
                                        pins=pins, singles=singles,
                                        exists=lambda x, _s=None: x in files or ("/" not in x and bool(by_name(x))))
    fix_pin = ("`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
               "HEAD、分支名、標籤會移動,不算釘住")

    for p, lno, s in pins:
        # 只管程式檔與測試檔——跟沒釘版本時一致(.md、不存在的路徑都不管;代碼審 r1 測試席、r2 外家席)
        if lno and _ns_is_code(p, reader, files) and not _ns_pin_ok(repo_root, p, lno, s):
            out.append(("釘版本不合法", f"`{p}@{s}:{lno}`", fix_pin))
    for p, lno in full:
        if lno and _ns_is_code(p, reader, files):
            out.append(("程式行號引用", f"`{p}:{lno}`",
                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{lno}`"))
    for name, lno, s in singles:
        cands = by_name(name)
        if len(cands) != 1:
            continue
        if s is None:
            out.append(("程式行號引用", f"`{name}:{lno}`(= {cands[0]})",
                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{lno}`"))
        elif not _ns_pin_ok(repo_root, cands[0], lno, s):
            out.append(("釘版本不合法", f"`{name}@{s}:{lno}`(= {cands[0]})", fix_pin))
    if region == "summary":
        m = SYMBOL_RE.match(text.strip())
        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
        if m and not skip:
            for _w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
                out.append(("現況描述沒寫來源", text.strip()[:60],
                            "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
    return out


def _ns_revisit_violations(ln, reg, visible):
    """新寫的一行回頭條件或條件標記合不合規矩(存量漂移防線 [S10])→ [(規則, 片段, 改法)]。
    用跟 E5、第二層同一支 _revisit_split;圍欄裡的、行內程式碼裡的是範例,不管。"""
    if not visible:
        return []
    probe = _strip_inline_markup(ln)[0]
    table = probe.lstrip().startswith("|")
    if reg in ("body", "summary") and not table:
        kind, rest = _revisit_split(probe)
        if kind == "bad":
            return [("回頭條件格式不合", ln.strip()[:60],
                     "REVISIT: 後面第一個位置要是日期 YYYY-MM-DD,或條件標記加期限:REVISIT:[when-file:路徑][by:YYYY-MM-DD] 待辦")]
        if kind == "cond":
            pr = _probe_parse(rest)
            errs = list(pr["errs"])
            if pr["conds"] and pr["by"] is None:
                errs.append("沒帶期限 [by:YYYY-MM-DD](條件寫錯就永遠不會成立,期限到了至少會被唸)")
            if errs:
                return [("條件寫錯", ln.strip()[:60], ";".join(errs) + "——文法見 Projects/存量漂移防線_計劃〈做法〉第 0 節")]
        return []
    if _PROBE_ANY_RE.search(probe):
        return [("條件寫在不評估的地方", ln.strip()[:60],
                 "條件標記只在正文與摘要的 REVISIT 行生效;寫在表格或開頭欄位其他欄裡不會被判,移到 REVISIT 行")]
    return []


def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
    ch = _nodehome_changes(repo_root, base_where, tip_where)
    if ch is None:
        return []
    lst_t = _nodehome_list(repo_root, tip_where)
    lst_b = _nodehome_list(repo_root, base_where)
    if lst_t is None or lst_b is None:
        return []
    reader_b = _nodehome_reader(repo_root, base_where)
    out = []
    for code, _old, new in ch:
        if not new or code == "D":
            continue
        if not _ns_is_code(new, reader_tip, lst_t[0]):
            continue
        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
            out.append(new)
    return out


def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
    reader = _nodehome_reader(repo_root, tip_where)
    lst = _nodehome_list(repo_root, tip_where)
    if lst is None:
        return None
    files = lst[0]
    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
    _names, _name_cache = {}, {}
    for p in files:
        if _nodehome_code_kind(p) is not None:
            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)

    def by_name(name):
        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
        if name not in _name_cache:
            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
        return _name_cache[name]
    viol = []
    # 1) 這次新增的行(跟筆記內容審共用同一支,Projects/筆記內容審_計劃 [S1])
    mk = mark or _NOTE_SHAPE_GOLIVE_MARK
    res = _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, reader=reader, mark=mk,
                         exclude_remote=exclude_remote, max_count=max_count, keep_other=True)
    if res is None:
        return None
    notes, errs, old_by = res
    for p, text, rows in notes:
        regen = _ns_is_regen(text)

