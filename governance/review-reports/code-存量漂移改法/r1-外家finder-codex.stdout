 12298	def _guard_touches(gn, env, touched):
 12299	    """這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。
 12300	
 12301	    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):
 12302	    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。
 12303	    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
 12304	    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。
 12305	    """
 12306	    if touched is None:
 12307	        return True, ""            # 沒給清單=CI 那一層,照舊全擋
 12308	    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點
 12309	    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。
 12310	    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]
 12311	    if not homes:
 12312	        return False, ";這篇沒寫它守的是哪篇功能節點,算不出有沒有碰到"
 12313	    files, found, missing, nocode = [], [], [], []
 12314	    for home in homes:
 12315	        hrel = env.find(home)
 12316	        hn = env.notes.get(hrel) if hrel else None
 12317	        if hn is None:
 12318	            missing.append(home)
 12319	            continue
 12320	        found.append(hrel)
 12321	        got = [str(x).strip() for x in as_list(hn.fields.get("about_code")) if str(x).strip()]
 12322	        if got:
 12323	            files += got
 12324	        else:
 12325	            nocode.append(hrel)
 12326	    # ★連結斷掉的那幾篇,不管這次擋不擋都要講★(代碼審 r2 通才席):
 12327	    # 半條算得出來、半條算不出來時,算不出來的那半原本會無聲消失,那條合約就一直帶著沒人發現的壞連結。
 12328	    broken = f"(另外 {'、'.join(missing)} 這幾篇找不到,連結可能斷了)" if missing else ""
 12329	    if not files:
 12330	        if missing and not found:
 12331	            return False, f";找不到它守的功能節點 {'、'.join(missing)},算不出有沒有碰到"
 12332	        return False, f";{'、'.join(nocode)} 沒寫它管哪幾支檔(about_code),算不出有沒有碰到{broken}"
 12333	    hits, only_case = _guard_touched_hits(files, touched)
 12334	    if hits:
 12335	        # ★只列解析得到的那幾篇★(代碼審 r2 通才席):這句話存在的目的是讓被擋的人知道去哪篇查,
 12336	        # 把找不到的節點也列進來,照著查的人會撲空。
 12337	        # ★收窄的粒度是「整篇家節點」不是「每條合約」★(代碼審 r1):同一篇掛兩條逾期合約時兩條都會擋。
 12338	        # 做得更細要讓每條合約自己記檔案清單(另一套資料);現在的代價是偶爾多擋一條,方向安全,
 12339	        # 但要讓人看得出來為什麼,不要變成無法解釋的誤擋。
 12340	        why = f";你這次改到 {'、'.join(hits[:3])}(它掛在 {'、'.join(found[:2])} 底下){broken}"
 12341	        if only_case and len(only_case) == len(hits):
 12342	            why += "——只有忽略大小寫才對得上,寧可多擋一次也不漏"
 12343	        return True, why
 12344	    return False, ("" if not broken else f";這次沒碰到它管的檔{broken}")
 12345	
