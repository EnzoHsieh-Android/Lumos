 27940	def _drift_fix_c5(cx):
 27941	    """c5:轉正做了一半——只改守衛紀錄(status 改 pass、同步標籤、四種預告句改寫;跟 settle 第二步同一支算內容)。"""
 27942	    import datetime
 27943	    lines, fe = cx["lines"], cx["fe"]
 27944	    m = re.search(r"^預告的合約:(.+)$", "\n".join(lines), re.M)
 27945	    home_rel = (cx["f"].get("related") or [None])[0]
 27946	    htext = env_text(cx["env2"], home_rel) if home_rel and m else None
 27947	    if htext is None:
 27948	        return None, "讀不出預告的合約或家節點"
 27949	    claim, hl = m.group(1).strip(), htext.split("\n")
 27950	    he = _drift_fm_end(hl)
 27951	    if _guard_planned_idx(hl, he, claim):
 27952	        return None, f"家節點 {home_rel[:-3]} 同時有預告行與正式行,先手動刪掉預告行再跑"
 27953	    fi = _guard_formal_line(hl, he, claim, None)
 27954	    names, err = _drift_c5_test(cx["root"], hl[fi]) if fi is not None else (None, "家節點找不到綁了測試的正式行")
 27955	    if err:
 27956	        return None, err
 27957	    new, _missing, synced = _guard_settle_record_lines(lines, fe, home_rel, datetime.date.today().isoformat())
 27958	
 27959	    def _handled(fs, txt):
 27960	        fm, _b = split_frontmatter(txt)
 27961	        st = str(parse_frontmatter(fm)[0].get("status", "")) if fm is not None else ""
 27962	        return st == "pass" and not any(x["kind"] in ("c5", "c1") for x in fs)
 27963	    more = f"(正式行綁了 {len(names)} 支,取第一支)" if len(names) > 1 else ""
 27964	    return {"new": new, "key": "status", "check": _guard_record_ok(synced), "handled": _handled,
 27965	            "extra": {"test": names[0]}, "texts": [],
 27966	            "msg": f"守衛紀錄轉為 pass、預告句改成歷史說法;用家節點正式行綁的測試 {names[0]}{more}"}, None
 27967	
