 12079	def _guard_manual_settled_after(lines, i):
 12080	    """第 i 行之後(跳過空行)的下一個非空行是不是人手補的「已轉正」段。"""
 12081	    for ln in lines[i + 1:]:
 12082	        if ln.strip():
 12083	            return bool(_GUARD_MANUAL_SETTLED_RE.match(ln.strip()))
 12084	    return False
