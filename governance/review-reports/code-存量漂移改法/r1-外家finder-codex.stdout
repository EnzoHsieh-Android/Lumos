 12063	def _guard_planned_idx(lines, e, claim):
 12064	    """家筆記裡「剝掉 [watch:]/[due:] 之後完整文字等於這句合約」的預告行索引清單(0 條、1 條、好幾條由呼叫端判)。"""
 12065	    want = (claim or "").strip()
 12066	    out = []
 12067	    for i in range(1, e):
 12068	        m = PLANNED_RE.match(lines[i].strip())
 12069	        if m and _PLANNED_TAIL_RE.sub("", m.group(1)).strip() == want:
 12070	            out.append(i)
 12071	    return out
