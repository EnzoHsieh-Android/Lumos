 27830	def _drift_c4_evidence(cx):
 27831	    """c4 的證據與範本:那篇第一次被提交的提交、卷證目錄(名字比對猜的)、範本句。"""
 27832	    root = cx["root"]
 27833	    sha = None if _git_is_shallow(root) else _plan_first_commit(root, cx["repo_rel"], timeout=20)
 27834	    first = "shallow,查不到最早提交" if _git_is_shallow(root) else (sha or "查不到")
 27835	    n = cx["env2"].notes.get(cx["rel"])
 27836	    keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
 27837	            if link_target(x)}
 27838	    rr = Path(root) / "governance" / "review-reports"
 27839	    try:
 27840	        dirs = sorted(d.name for d in rr.iterdir() if d.is_dir() and any(k and k in _drift_c4_key(d.name) for k in keys))
 27841	    except OSError:
 27842	        dirs = []
 27843	    reports = [f"governance/review-reports/{d}" for d in dirs]
 27844	    tpl = f"提交 {sha[:12] if sha else '<sha>'};代碼審見 {'、'.join(reports) or '<卷證>'}"
 27845	    return {"first": first, "reports": reports, "template": tpl}
