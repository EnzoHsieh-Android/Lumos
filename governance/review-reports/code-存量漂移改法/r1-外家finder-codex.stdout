 12167	def _guard_raw_git_path(root, repo_rel):
 12168	    """repo 相對路徑(NFC)→ git ls-files 列出的原樣路徑(無損解碼,傳回給 git 用);找不到或 git 失敗回 None。"""
 12169	    raw = _nodehome_git(root, "ls-files", "-z")
 12170	    if raw is None:
 12171	        return None
 12172	    want = nfc(repo_rel)
 12173	    for x in _nodehome_split_z(raw):
 12174	        if nfc(x) == want:
 12175	            return x
 12176	    return None
