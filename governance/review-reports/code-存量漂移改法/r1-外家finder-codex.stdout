 27993	def _drift_fix_changes(old, new):
 27994	    """改前改後 → [{line, before, after}]:line 是改前的行號;新插入的行 line、before 記 null;刪掉的行 after 記 null。"""
 27995	    import difflib
 27996	    out = []
 27997	    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
 27998	        if tag == "equal":
 27999	            continue
 28000	        for k in range(max(i2 - i1, j2 - j1)):
 28001	            b = old[i1 + k] if i1 + k < i2 else None
 28002	            out.append({"line": i1 + k + 1 if b is not None else None, "before": b,
 28003	                        "after": new[j1 + k] if j1 + k < j2 else None})
 28004	    return out
 28005	
