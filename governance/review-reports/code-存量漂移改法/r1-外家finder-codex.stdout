 12242	def _guard_pass_rewrite(env, root, repo_rel, glines, date_arg):
 12243	    """已 pass 但還留著預告句的守衛紀錄 → (改寫後的行, 找不到的句型, 用的日期, 錯誤)。前提、日期、不疊都在這裡;
 12244	    guard settle 與 drift fix --kind c1 共用(drift 往下呼叫 guard,guard 不呼叫 drift)。"""
 12245	    home_rel, err = _guard_pass_home(env, glines)
 12246	    if err:
 12247	        return None, None, None, err
 12248	    ops = _guard_prose_ops(glines)
 12249	    day = None
 12250	    if _guard_prose_needs_date(ops):
 12251	        day, err = _guard_settled_date(root, repo_rel, glines, date_arg)
 12252	        if err:
 12253	            return None, None, None, err
 12254	    elif date_arg is not None:
 12255	        day, err = _guard_date_arg(date_arg)
 12256	        if err:
 12257	            return None, None, None, err
 12258	    new, missing = _guard_settle_rewrite(glines, day, home_rel[:-3])
 12259	    return new, missing, day, None
