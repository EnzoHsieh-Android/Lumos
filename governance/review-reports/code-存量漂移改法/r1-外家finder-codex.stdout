 27536	def _drift_ledger_append(root, rel, rec):
 27537	    """表態檔與修復帳共用的追加(存量漂移改法 第 7 節):①路徑檢查 ②檔尾不是換行先補一個 ③交給 _jsonl_append_verified
 27538	    追加並讀回自驗。不改其他帳共用的 _jsonl_append_verified。回 rc。"""
 27539	    fp = Path(root) / rel
 27540	    err = _drift_ledger_path_err(root, rel)
 27541	    if err is None:
 27542	        try:
 27543	            fp.parent.mkdir(parents=True, exist_ok=True)
 27544	        except OSError as ex:
 27545	            err = f"建不了 {fp.parent}:{ex}"
 27546	    err = err or _drift_ledger_path_err(root, rel)
 27547	    if err is None:
 27548	        try:
 27549	            if fp.is_file() and fp.stat().st_size > 0:
 27550	                with open(fp, "rb") as fh:
 27551	                    fh.seek(-1, 2)
 27552	                    tail = fh.read(1)
 27553	                if tail != b"\n":
 27554	                    with open(fp, "a", encoding="utf-8") as fh:
 27555	                        fh.write("\n")
 27556	        except OSError as ex:
 27557	            err = f"補不了檔尾換行:{ex}"
 27558	    if err:
 27559	        print(f"擋下:{err}", file=sys.stderr)
 27560	        return 2
 27561	    return _jsonl_append_verified(fp, rec, "id", rec["id"])
