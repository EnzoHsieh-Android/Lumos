 28007	def _drift_fix_preview(cx, res):
 28008	    print(f"預覽(--dry-run;沒寫筆記、沒寫修復帳):{cx['rel']}——{res['msg']}")
 28009	    for ch in _drift_fix_changes(cx["lines"], res["new"]):
 28010	        if ch["before"] is not None:
 28011	            print(f"  - 第 {ch['line']} 行:{_esc_clean(ch['before'], 200)}")
 28012	        if ch["after"] is not None:
 28013	            print(f"  + {_esc_clean(ch['after'], 200)}")
