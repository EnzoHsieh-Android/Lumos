 12179	def _guard_pass_commit_date(root, repo_rel):
 12180	    """守衛紀錄第一次變成 status: pass 的提交日期 → (日期, 錯誤)。那一筆若也是這個檔第一次出現的提交(匯入、搬目錄、
 12181	    改名後重新加入)就不算。不用 git log -S <合約文字>:settle 是原地換行,出現次數不變,找不到轉正那次(設計審 r1)。"""
 12182	    if _git_is_shallow(root):
 12183	        return None, "這個 repo 是 shallow clone,查不到完整歷史"
 12184	    raw = _guard_raw_git_path(root, repo_rel)
 12185	    if raw is None:
 12186	        return None, f"git 裡找不到 {repo_rel}(沒被追蹤,或 git 查詢失敗/逾時)"
 12187	    log = _nodehome_git(root, "log", "--reverse", "--format=%H%x09%as", "-G", "^status: pass", "--", raw)
 12188	    added = _nodehome_git(root, "log", "--diff-filter=A", "--format=%H", "--", raw)
 12189	    if log is None or added is None:
 12190	        return None, "git 查詢失敗或逾時"
 12191	    adds = set(added.decode("utf-8", "replace").split())
 12192	    for row in log.decode("utf-8", "replace").splitlines():
 12193	        sha, _t, day = row.partition("\t")
 12194	        blob = _nodehome_git(root, "show", f"{sha}:{raw}")
 12195	        if blob is None:
 12196	            continue
 12197	        fm, _b = split_frontmatter(blob.decode("utf-8", "replace"))
 12198	        if not fm or str(parse_frontmatter(fm)[0].get("status", "")).strip() != "pass":
 12199	            continue
 12200	        if sha in adds:
 12201	            return None, f"第一次是 pass 的提交 {sha[:12]} 也是這個檔第一次出現的提交(整批匯入或搬過目錄),那天不是轉正日"
 12202	        return day.strip(), None
 12203	    return None, "歷史裡找不到它變成 pass 的提交"
 12204	
