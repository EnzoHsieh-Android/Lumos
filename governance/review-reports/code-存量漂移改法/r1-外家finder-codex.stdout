 27802	def _drift_fix_c3(cx):
 27803	    """c3:驗證紀錄的 status 改掉、正文最後加一行依狀態措辭的說明;原本的正文不改。"""
 27804	    import datetime
 27805	    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
 27806	    link = None
 27807	    if o.get("by"):
 27808	        link, err = _drift_fix_by(cx["env2"], o["by"])
 27809	        if err:
 27810	            return None, err
 27811	    st = o["status"]
 27812	    txt = f"{datetime.date.today().isoformat()} 狀態改為 {st}(存量漂移 c3)"
 27813	    if link:
 27814	        txt += f",由 [[{link}]] 解決" if st == "pass" else f",參考 [[{link}]]"
 27815	    body, err = _drift_append_note(lines[fe + 1:], txt)
 27816	    if err:
 27817	        return None, err
 27818	    fm, ok = _drift_fm_status(lines, fe, st)
 27819	    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c3"),
 27820	            "extra": {}, "texts": [(txt, "body")], "msg": f"status 改成 {st},正文最後加了一行說明"}, None
