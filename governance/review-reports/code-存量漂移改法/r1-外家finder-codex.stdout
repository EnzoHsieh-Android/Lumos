 12106	def _guard_settle_rewrite(lines, today, home_link):
 12107	    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。
 12108	    settle 句下一個非空行已是手補的「已轉正」段:刪掉 settle 句那一行(連同緊接的一個空行),算處理過、不進 missing
 12109	    ——pending 轉正與 pass 補改走同一支,同一種句子不因入口不同而結果不同(存量漂移改法 第 2 節)。
 12110	    today 只在要寫日期時用得到(見 _guard_prose_needs_date)。"""
 12111	    ops = dict(_guard_prose_ops(lines))
 12112	    out, seen, skip = [], set(), set()
 12113	    for i, ln in enumerate(lines):
 12114	        if i in skip:
 12115	            continue
 12116	        k = ops.get(i)
 12117	        if k is None:
 12118	            out.append(ln)
 12119	            continue
 12120	        seen.add({"why-done": "why", "settle-del": "settle"}.get(k, k))
 12121	        ind = ln[:len(ln) - len(ln.lstrip())]
 12122	        if k == "test":
 12123	            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
 12124	        elif k == "why":
 12125	            out.append(f"{ln.rstrip()}({today} 已轉正)")
 12126	        elif k == "whynot":
 12127	            out.append(f"{ind}預告當時{ln.lstrip()}")
 12128	        elif k == "settle":
 12129	            out.append(f"{ind}({today} 已轉正)")
 12130	        elif k == "settle-del":
 12131	            if i + 1 < len(lines) and not lines[i + 1].strip():
 12132	                skip.add(i + 1)
 12133	        else:
 12134	            out.append(ln)
 12135	    return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]
 12136	
