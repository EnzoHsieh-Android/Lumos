 27492	def _drift_jsonl_rows(fp):
 27493	    """帳檔 → [dict](讀不到、不是 JSON 物件的行略過;符號連結不跟)。"""
 27494	    import json as _j
 27495	    try:
 27496	        raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else b""
 27497	    except OSError:
 27498	        raw = b""
 27499	    out = []
 27500	    for ln in raw.decode("utf-8", errors="replace").splitlines():
 27501	        try:
 27502	            d = _j.loads(ln)
 27503	        except (ValueError, RecursionError):
 27504	            continue
 27505	        if isinstance(d, dict):
 27506	            out.append(d)
 27507	    return out
