 12150	def _guard_written_settled_dates(lines):
 12151	    """那篇守衛紀錄裡已經寫過的轉正日期:正文手補的「<日期> 已轉正」段、摘要 WHY 行尾的「(<日期> 已轉正)」。"""
 12152	    regs = _notelines_regions("\n".join(lines))
 12153	    got = set()
 12154	    for i, ln in enumerate(lines):
 12155	        r = regs[i] if i < len(regs) else "body"
 12156	        if r == "body":
 12157	            m = _GUARD_MANUAL_SETTLED_RE.match(ln.strip())
 12158	        elif r == "summary" and _guard_planned_prose(ln, r, settled_ok=True) == "why-done":
 12159	            m = _GUARD_WHY_SETTLED_DATE_RE.search(ln)
 12160	        else:
 12161	            m = None
 12162	        if m:
 12163	            got.add(m.group(1))
 12164	    return got
