 27566	def _drift_fix_hint(kind, path, line):
 27567	    """一筆發現該印的改法指令 → [指令]。★提示的單一產生處★(存量漂移改法 [S10]):drift check 擋下與只列出、drift scan、
 27568	    doctor Z 段、計劃收尾的連帶待辦都從這裡拿,不再各自教人手改。"""
 27569	    node = path[:-3] if path.endswith(".md") else path
 27570	    base = f"lumos drift fix {node} {line} --kind {kind}"
 27571	    if kind == "c2":
 27572	        return [base + ' --close --status done --reason "<為什麼算解決,附提交或測試>"',
 27573	                base + ' --keep --reason "<為什麼還沒解決>"']
 27574	    if kind == "c3":
 27575	        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + ">"]
 27576	    if kind == "c4":
 27577	        return [base + '   # 先看證據與範本,再加 --old "<原片段>" --new "<新片段>"']
 27578	    if kind == "probe":
 27579	        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
 27580	                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
 27581	    return [base]
