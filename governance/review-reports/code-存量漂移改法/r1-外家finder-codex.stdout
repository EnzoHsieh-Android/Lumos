 27848	def _drift_c4_print(cx, ev):
 27849	    print(f"{cx['rel']} 第 {cx['line']} 行(c4 前提寫「還沒提交」)的證據——只列出、不寫檔:")
 27850	    print(f"  ①這篇第一次被提交:{ev['first']}")
 27851	    print(f"  ②卷證目錄(用計劃名比對猜的,可能漏或多):{'、'.join(ev['reports']) or '查不到'}")
 27852	    print(f"  ③範本句:{ev['template']}")
 27853	    print("確認後把「還沒提交」那段換掉(--old 要含那三個詞之一、在 valid_under 的值裡剛好出現一次):")
 27854	    print(f'    lumos drift fix {cx["rel"][:-3]} {cx["line"]} --kind c4 --old "<原片段>" --new "{ev["template"]}"')
