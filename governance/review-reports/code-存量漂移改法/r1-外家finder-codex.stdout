 12206	def _guard_settled_date(root, repo_rel, lines, date_arg):
 12207	    """補改句要寫的轉正日期 → (日期, 錯誤)。依序:--date、那篇已寫的轉正日期、守衛紀錄第一次變成 pass 的提交日期;
 12208	    推不出來回錯誤,★不拿今天充數★(存量漂移改法 第 2 節)。"""
 12209	    if date_arg is not None:
 12210	        return _guard_date_arg(date_arg)
 12211	    got = _guard_written_settled_dates(lines)
 12212	    if len(got) > 1:
 12213	        return None, f"這篇已寫的轉正日期不一致({'、'.join(sorted(got))}),用 --date 指定"
 12214	    if got:
 12215	        return next(iter(got)), None
 12216	    d, why = _guard_pass_commit_date(root, repo_rel)
 12217	    if d is None:
 12218	        return None, f"推不出轉正日期({why}),用 --date YYYY-MM-DD 指定"
 12219	    return d, None
