 28044	def _drift_fix_record(env, cx, res):
 28045	    """第 7 步:寫修復帳(稽核紀錄)、記治理事件。帳寫不進去回 2,不動筆記。"""
 28046	    import datetime, hashlib, secrets
 28047	    rec = {"id": "DFIX-" + secrets.token_hex(4), "date": datetime.date.today().isoformat(), "path": cx["repo_rel"],
 28048	           "line": cx["line"], "kind": cx["kind"], "changed": _drift_fix_changes(cx["lines"], res["new"]),
 28049	           "after_sha256": hashlib.sha256("\n".join(res["new"]).encode("utf-8")).hexdigest(), **res["extra"]}
 28050	    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "ledger":
 28051	        rc = 2
 28052	    else:
 28053	        with _vault_write_lock(env.vault):
 28054	            rec["seq"] = _drift_next_seq(cx["root"], _DRIFT_FIXES)
 28055	            rc = _drift_ledger_append(cx["root"], _DRIFT_FIXES, rec)
 28056	    if rc != 0:
 28057	        print(f"擋下:筆記已改好,但修復帳沒記到;{cx['repo_rel']} 的改動用 git diff 看得到", file=sys.stderr)
 28058	        return 2
 28059	    _gate_event_or_warn(cx["root"], "drift-check", "fix", f"{cx['rel']}:{cx['line']} {cx['kind']}({rec['id']})")
 28060	    return 0
 28061	
