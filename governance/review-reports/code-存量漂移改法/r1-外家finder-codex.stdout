 27973	def _drift_fix_shape_err(root, texts):
 27974	    """工具要寫的自由文字先跑筆記形狀擋的同一支判定(_ns_check_line、_ns_revisit_violations)→ 錯誤或 None;
 27975	    不寫出一份提交前一定被擋的筆記。"""
 27976	    if not texts:
 27977	        return None
 27978	    lst = _nodehome_list(root, "index")
 27979	    if lst is None:
 27980	        return "git 列不出檔案清單,沒辦法先跑筆記形狀擋"
 27981	    files, reader = lst[0], _nodehome_reader(root, "index")
 27982	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 27983	
 27984	    def by_name(name):
 27985	        return [p for p in files if p.rsplit("/", 1)[-1] == name and _ns_is_code(p, reader, files)]
 27986	    for t, reg in texts:
 27987	        v = _ns_check_line(root, t, reg, files, reader, top_dirs, by_name) + _ns_revisit_violations(t, reg, True)
 27988	        if v:
 27989	            return f"要寫進去的文字過不了筆記形狀擋({v[0][0]}:{v[0][1]})——{v[0][2]}"
 27990	    return None
 27991	
