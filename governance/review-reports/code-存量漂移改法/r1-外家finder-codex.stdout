 27892	def _drift_fix_c4(cx):
 27893	    """c4:不帶 --old/--new 只列證據與範本(回 None, None);帶了就在 valid_under 的原始文字上精確替換剛好一次的那段。"""
 27894	    ev = _drift_c4_evidence(cx)
 27895	    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
 27896	    if o.get("old") is None:
 27897	        _drift_c4_print(cx, ev)
 27898	        return None, None
 27899	    old, new = o["old"], o["new"]
 27900	    err = _drift_c4_text_err(old, new)
 27901	    if err:
 27902	        return None, err
 27903	    hits = _drift_valid_under_hits(lines, fe, old)
 27904	    if len(hits) != 1:
 27905	        where = "、".join(f"第 {i + 1} 行" for i in sorted({i for i, _c in hits}))
 27906	        return None, f"--old 在 valid_under 的值裡出現 {len(hits)} 次(要剛好一次){(':' + where) if where else ''}——給更長的片段"
 27907	    i, c = hits[0]
 27908	    out = list(lines)
 27909	    out[i] = lines[i][:c] + new + lines[i][c + len(old):]
 27910	    before = as_list(parse_frontmatter(lines[1:fe])[0].get("valid_under"))
 27911	    after = as_list(parse_frontmatter(out[1:fe])[0].get("valid_under"))
 27912	    diff = [k for k in range(min(len(before), len(after))) if before[k] != after[k]]
 27913	    if len(before) != len(after) or len(diff) != 1 or any(w in after[diff[0]] for w in _DRIFT_UNCOMMITTED_WORDS):
 27914	        return None, "換完之後 valid_under 的項數變了、不只一項不同,或被換的那一整項還含那三個詞——沒寫,給更精確的片段"
 27915	    idx = diff[0]
 27916	
 27917	    def _handled(_fs, txt):
 27918	        fm, _b = split_frontmatter(txt)
 27919	        got = as_list(parse_frontmatter(fm)[0].get("valid_under")) if fm is not None else []
 27920	        return len(got) > idx and not any(w in got[idx] for w in _DRIFT_UNCOMMITTED_WORDS)
 27921	    return {"new": out, "key": "valid_under", "check": lambda f: as_list(f.get("valid_under")) == after,
 27922	            "handled": _handled, "extra": {"template_used": new.strip() == ev["template"]},
 27923	            "texts": [(new, "other")], "msg": f"valid_under 第 {idx + 1} 項換掉了還沒提交的說法"}, None
 27924	
