+
+
+def _guard_prose_needs_date(ops):
+    """改句要不要寫日期:TEST、WHY 兩句與換成「(日期 已轉正)」的 settle 句要;只改「為什麼還不做:」或刪 settle 句不要。"""
+    return any(k in ("test", "why", "settle") for _i, k in ops)
+
+
+def _guard_settle_rewrite(lines, today, home_link):
+    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。
+    settle 句下一個非空行已是手補的「已轉正」段:刪掉 settle 句那一行(連同緊接的一個空行),算處理過、不進 missing
+    ——pending 轉正與 pass 補改走同一支,同一種句子不因入口不同而結果不同(存量漂移改法 第 2 節)。
+    today 只在要寫日期時用得到(見 _guard_prose_needs_date)。"""
+    ops = dict(_guard_prose_ops(lines))
+    out, seen, skip = [], set(), set()
+    for i, ln in enumerate(lines):
+        if i in skip:
+            continue
+        k = ops.get(i)
         if k is None:
             out.append(ln)
             continue
-        seen.add("why" if k == "why-done" else k)
+        seen.add({"why-done": "why", "settle-del": "settle"}.get(k, k))
         ind = ln[:len(ln) - len(ln.lstrip())]
         if k == "test":
             out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
         elif k == "why":
             out.append(f"{ln.rstrip()}({today} 已轉正)")
         elif k == "whynot":
             out.append(f"{ind}預告當時{ln.lstrip()}")
         elif k == "settle":
             out.append(f"{ind}({today} 已轉正)")
+        elif k == "settle-del":
+            if i + 1 < len(lines) and not lines[i + 1].strip():
+                skip.add(i + 1)
         else:
             out.append(ln)
     return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]
 
 
+def _guard_date_arg(s):
+    """--date 的值 → (日期字串, 錯誤)。格式要 YYYY-MM-DD、不晚於今天。"""
+    import datetime
+    try:
+        d = datetime.date.fromisoformat(str(s).strip())
+    except ValueError:
+        return None, f"--date 要寫成 YYYY-MM-DD,你給的是 {s!r}"
+    if d > datetime.date.today():
+        return None, f"--date {d.isoformat()} 晚於今天,轉正日期不能是未來"
+    return d.isoformat(), None
+
+
+def _guard_written_settled_dates(lines):
+    """那篇守衛紀錄裡已經寫過的轉正日期:正文手補的「<日期> 已轉正」段、摘要 WHY 行尾的「(<日期> 已轉正)」。"""
+    regs = _notelines_regions("\n".join(lines))
+    got = set()
+    for i, ln in enumerate(lines):
+        r = regs[i] if i < len(regs) else "body"
+        if r == "body":
+            m = _GUARD_MANUAL_SETTLED_RE.match(ln.strip())
+        elif r == "summary" and _guard_planned_prose(ln, r, settled_ok=True) == "why-done":
+            m = _GUARD_WHY_SETTLED_DATE_RE.search(ln)
+        else:
+            m = None
+        if m:
+            got.add(m.group(1))
+    return got
+
+
+def _guard_raw_git_path(root, repo_rel):
+    """repo 相對路徑(NFC)→ git ls-files 列出的原樣路徑(無損解碼,傳回給 git 用);找不到或 git 失敗回 None。"""
+    raw = _nodehome_git(root, "ls-files", "-z")
+    if raw is None:
+        return None
+    want = nfc(repo_rel)
+    for x in _nodehome_split_z(raw):
+        if nfc(x) == want:
+            return x
+    return None
+
+
+def _guard_pass_commit_date(root, repo_rel):
+    """守衛紀錄第一次變成 status: pass 的提交日期 → (日期, 錯誤)。那一筆若也是這個檔第一次出現的提交(匯入、搬目錄、
+    改名後重新加入)就不算。不用 git log -S <合約文字>:settle 是原地換行,出現次數不變,找不到轉正那次(設計審 r1)。"""
+    if _git_is_shallow(root):
+        return None, "這個 repo 是 shallow clone,查不到完整歷史"
+    raw = _guard_raw_git_path(root, repo_rel)
+    if raw is None:
+        return None, f"git 裡找不到 {repo_rel}(沒被追蹤,或 git 查詢失敗/逾時)"
+    log = _nodehome_git(root, "log", "--reverse", "--format=%H%x09%as", "-G", "^status: pass", "--", raw)
+    added = _nodehome_git(root, "log", "--diff-filter=A", "--format=%H", "--", raw)
+    if log is None or added is None:
+        return None, "git 查詢失敗或逾時"
+    adds = set(added.decode("utf-8", "replace").split())
+    for row in log.decode("utf-8", "replace").splitlines():
+        sha, _t, day = row.partition("\t")
+        blob = _nodehome_git(root, "show", f"{sha}:{raw}")
+        if blob is None:
+            continue
+        fm, _b = split_frontmatter(blob.decode("utf-8", "replace"))
+        if not fm or str(parse_frontmatter(fm)[0].get("status", "")).strip() != "pass":
+            continue
+        if sha in adds:
+            return None, f"第一次是 pass 的提交 {sha[:12]} 也是這個檔第一次出現的提交(整批匯入或搬過目錄),那天不是轉正日"
+        return day.strip(), None
+    return None, "歷史裡找不到它變成 pass 的提交"
+
+
+def _guard_settled_date(root, repo_rel, lines, date_arg):
+    """補改句要寫的轉正日期 → (日期, 錯誤)。依序:--date、那篇已寫的轉正日期、守衛紀錄第一次變成 pass 的提交日期;
+    推不出來回錯誤,★不拿今天充數★(存量漂移改法 第 2 節)。"""
+    if date_arg is not None:
+        return _guard_date_arg(date_arg)
+    got = _guard_written_settled_dates(lines)
+    if len(got) > 1:
+        return None, f"這篇已寫的轉正日期不一致({'、'.join(sorted(got))}),用 --date 指定"
+    if got:
+        return next(iter(got)), None
+    d, why = _guard_pass_commit_date(root, repo_rel)
+    if d is None:
+        return None, f"推不出轉正日期({why}),用 --date YYYY-MM-DD 指定"
+    return d, None
+
+
+def _guard_pass_home(env, glines):
+    """已 pass 的守衛紀錄補改句的前提:讀得出預告的合約、家節點摘要裡有這條合約綁了測試的正式行。
+    → (家節點路徑, 錯誤)。"""
+    gfm, _gb = split_frontmatter("\n".join(glines))
