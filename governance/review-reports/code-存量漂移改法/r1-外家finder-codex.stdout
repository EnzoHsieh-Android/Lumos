 27776	def _drift_fix_by(env, by):
 27777	    """--by → (完整相對路徑去 .md, 錯誤)。完整路徑直接查那一篇;短名看 by_stem,找不到或同名好幾篇擋。"""
 27778	    a = nfc(str(by).strip())
 27779	    a = a[:-3] if a.lower().endswith(".md") else a
 27780	    if "/" in a:
 27781	        return (a, None) if (a + ".md") in env.notes else (None, f"--by 找不到 {by}")
 27782	    hits = env.by_stem.get(a.lower(), [])
 27783	    if len(hits) == 1:
 27784	        return hits[0][:-3], None
 27785	    if not hits:
 27786	        return None, f"--by 找不到 {by}"
 27787	    return None, f"--by {by} 同名好幾篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"
 27788	
