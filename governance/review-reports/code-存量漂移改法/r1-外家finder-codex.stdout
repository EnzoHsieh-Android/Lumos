 28063	def cmd_drift_fix(env, node, line, kind, o):
 28064	    """lumos drift fix <節點> <行號> --kind c1..c5 [--dry-run] [種類專屬參數](Projects/存量漂移改法_計劃 第 1 節)。
 28065	    順序:乾淨檢查 → 鎖外讀與判定、前提、git 查詢 → 算改後內容、自由文字先過形狀擋 → (--dry-run 到此)→
 28066	    鎖內比指紋寫入 → 鎖外驗證磁碟內容與「已處理」→ 寫修復帳。不自動還原:改之前保證了 git 退得回來。"""
 28067	    err = _drift_fix_args_err(kind, o)
 28068	    rel = None
 28069	    if err is None:
 28070	        rel, err = _drift_fix_target(env, node)
 28071	    if err is None and kind == "c2" and o.get("keep"):
 28072	        return cmd_drift_ack(env, rel, line, "c2", o["reason"])      # 照留:等同帶清單的 c2 表態
 28073	    cx = None
 28074	    if err is None:
 28075	        cx, err = _drift_fix_load(env, rel, line, kind, o)
 28076	    res = None
 28077	    if err is None:
 28078	        res, err = _DRIFT_FIX_COMPUTE[kind](cx)
 28079	        if err is None and res is None:
 28080	            return 0                                                 # c4 只列證據與範本
 28081	    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
 28082	    if err is None and o.get("dry_run"):
 28083	        _drift_fix_preview(cx, res)
 28084	        return 0
 28085	    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
 28086	    if err:
 28087	        print(f"擋下:{err}", file=sys.stderr)
 28088	        return 2
 28089	    if _drift_fix_record(env, cx, res) != 0:
 28090	        return 2
 28091	    print(f"✓ drift fix {kind}:{rel} 第 {line} 行——{res['msg']}")
 28092	    if kind == "c2":
 28093	        _issue_close_revisits(env, rel, o["status"])
 28094	    print(f"修復帳要跟筆記一起提交:\n    git add {_DRIFT_FIXES} {cx['repo_rel']} && git commit")
 28095	    return 0
