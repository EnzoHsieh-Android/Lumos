 27515	def _drift_ledger_path_err(root, rel):
 27516	    """帳檔寫入前的路徑檢查 → 錯誤或 None:從 repo 根往下到帳檔的每一層都不是符號連結(repo 根以上不管;
 27517	    逐層查照 _mkdir_trusted_under_home 的寫法)、解析後的真實路徑在 repo 根底下、帳檔已存在時硬連結數是 1。
 27518	    檢查後到寫入前的時間差不處理(存量漂移改法〈誠實界線〉)。"""
 27519	    rootp = Path(root)
 27520	    cur = rootp
 27521	    try:
 27522	        for seg in Path(rel).parts:
 27523	            cur = cur / seg
 27524	            if cur.is_symlink():
 27525	                return f"{cur} 是符號連結——帳檔與它在 repo 裡的上層目錄都要是一般的檔案與目錄,不往裡寫"
 27526	        fp = rootp / rel
 27527	        if not fp.resolve().is_relative_to(rootp.resolve()):
 27528	            return f"{fp} 解析後不在 repo 底下,不往裡寫"
 27529	        if fp.exists() and fp.stat().st_nlink != 1:
 27530	            return f"{fp} 有別的硬連結指著同一個檔,不往裡寫"
 27531	    except OSError as ex:
 27532	        return f"查不了 {cur}:{ex}"
 27533	    return None
