 27926	def _drift_c5_test(root, hline):
 27927	    """家節點那條正式行綁的測試 → (測試名清單, 錯誤)。多平台專案帶平台前綴時取識別字(resolve_test_refs)。"""
 27928	    m = INVARIANT_RE.match(hline.strip())
 27929	    if not m:
 27930	        return None, "讀不出家節點的正式合約行"
 27931	    try:
 27932	        pd = load_platforms(root)
 27933	        names = [mm for _pl, mm in resolve_test_refs(m.group(1), pd["platforms"] if pd["multiplatform"] else {},
 27934	                                                      pd["default_platform"])]
 27935	    except (ValueError, OSError) as ex:
 27936	        return None, f"解不出正式行綁的測試:{ex}"
 27937	    return (names, None) if names else (None, "家節點的正式行沒有綁測試")
