 12138	def _guard_date_arg(s):
 12139	    """--date 的值 → (日期字串, 錯誤)。格式要 YYYY-MM-DD、不晚於今天。"""
 12140	    import datetime
 12141	    try:
 12142	        d = datetime.date.fromisoformat(str(s).strip())
 12143	    except ValueError:
 12144	        return None, f"--date 要寫成 YYYY-MM-DD,你給的是 {s!r}"
 12145	    if d > datetime.date.today():
 12146	        return None, f"--date {d.isoformat()} 晚於今天,轉正日期不能是未來"
 12147	    return d.isoformat(), None
