 27359	def _drift_split_acked(findings, acks, vault_rel):
 27360	    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。
 27361	    ★c2、c3 另外要綁當時的關係★(存量漂移改法 [S8]):只看記了 related 的表態,取 seq 最大的那幾筆(同號全算),
 27362	    全部都涵蓋現在的已收尾計劃清單才算已表態;沒記 related 的舊表態不再算數(不然會永久豁免之後才收尾的計劃)。
 27363	    沒涵蓋但以前表態過的,沒表態那一邊的發現多帶 prev_ack(最近一次當時連著哪幾篇、理由),印的時候講出來。"""
 27364	    keys, bound = set(), {}
 27365	    for a in acks:
 27366	        k = _drift_ack_key(a["path"], a.get("text", ""), a["kind"])
 27367	        if a["kind"] in _DRIFT_BOUND_KINDS:
 27368	            if "related" in a:
 27369	                bound.setdefault(k, []).append(a)
 27370	        else:
 27371	            keys.add(k)
 27372	    pre = vault_rel.rstrip("/") + "/"
 27373	    left, done = [], []
 27374	    for f in findings:
 27375	        k = _drift_ack_key(pre + f["path"], f["text"], f["kind"])
 27376	        if f["kind"] not in _DRIFT_BOUND_KINDS:
 27377	            (done if k in keys else left).append(f)
 27378	            continue
 27379	        top = _drift_bound_latest(bound.get(k, []))
 27380	        cur = {nfc(str(x)) for x in f.get("related", [])}
 27381	        if top and all(_drift_related_ok(a) and cur <= {nfc(x) for x in a["related"]} for a in top):
 27382	            done.append(f)
 27383	        elif top:
 27384	            left.append(dict(f, prev_ack={"related": top[-1].get("related"), "reason": top[-1].get("reason")}))
 27385	        else:
 27386	            left.append(f)
 27387	    return left, done
