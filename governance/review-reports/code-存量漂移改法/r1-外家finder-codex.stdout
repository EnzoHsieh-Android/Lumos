 12101	def _guard_prose_needs_date(ops):
 12102	    """改句要不要寫日期:TEST、WHY 兩句與換成「(日期 已轉正)」的 settle 句要;只改「為什麼還不做:」或刪 settle 句不要。"""
 12103	    return any(k in ("test", "why", "settle") for _i, k in ops)
