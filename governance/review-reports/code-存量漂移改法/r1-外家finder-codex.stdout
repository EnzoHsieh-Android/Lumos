 12087	def _guard_prose_ops(lines):
 12088	    """守衛紀錄裡的預告句 → [(行索引, 種類)]。種類:test/why/why-done/whynot/settle,
 12089	    settle 句下一個非空行已是手補的「已轉正」段時記 settle-del(刪掉 settle 句那一行)。"""
 12090	    regs = _notelines_regions("\n".join(lines))
 12091	    ops = []
 12092	    for i, ln in enumerate(lines):
 12093	        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
 12094	        if k == "settle" and _guard_manual_settled_after(lines, i):
 12095	            k = "settle-del"
 12096	        if k is not None:
 12097	            ops.append((i, k))
 12098	    return ops
