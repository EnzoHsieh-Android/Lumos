 27857	def _drift_c4_text_err(old, new):
 27858	    if "\n" in old or "\r" in old:
 27859	        return "--old 不能跨行"
 27860	    if not any(w in old for w in _DRIFT_UNCOMMITTED_WORDS):
 27861	        return f"--old 要含 {'/'.join(_DRIFT_UNCOMMITTED_WORDS)} 其中之一(換掉不相干的文字不算修)"
 27862	    if "\n" in new or "\r" in new:
 27863	        return "--new 不能有換行"
 27864	    if any(w in new for w in _DRIFT_UNCOMMITTED_WORDS):
 27865	        return f"--new 不能再含 {'/'.join(_DRIFT_UNCOMMITTED_WORDS)}"
 27866	    t = new.strip()
 27867	    if (t.startswith(("-", "#")) or ": " in new or t.endswith(":") or " #" in new or new.count('"') % 2
 27868	            or new.count("'") % 2 or any(c in new for c in "[]{}")):
 27869	        return "--new 不能含會改變開頭欄位結構的字元(開頭的 - 或 #、冒號加空白、成對以外的引號、[ ] { })"
 27870	    return None
