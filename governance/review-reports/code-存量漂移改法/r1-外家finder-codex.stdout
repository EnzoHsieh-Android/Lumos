 27767	    fm, ok = _drift_fm_status(lines, fe, o["status"])
 27768	    banner = (f"> 已結案({datetime.date.today().isoformat()},{o['status']}):{o['reason'].strip().rstrip('。')}。"
 27769	              "以下是當時的排查紀錄,不是現況。")
 27770	    body, had = _drift_close_banner(lines[fe + 1:], banner)
 27771	    return {"new": lines[:1] + fm + [lines[fe]] + body, "key": "status", "check": ok, "handled": _drift_no_kind("c2"),
 27772	            "extra": {}, "texts": [] if had else [(banner, "body")],
 27773	            "msg": f"status 改成 {o['status']}" + (";第一段已經是已結案橫幅,沒再加" if had else ",正文加了結案橫幅")}, None
