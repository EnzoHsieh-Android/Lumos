 succeeded in 0ms:
# BlockSpan: body=兩 sentinel 之間的內容(strip 首尾空行),
#            body_start/body_end=body 在原 text 中的字元位移,
#            保證 text[body_start:body_end] == body。
BlockSpan = namedtuple("BlockSpan", "body body_start body_end")
# Task 2: ReInjectResult ─ status ∈ created|updated|unchanged|appended|sentinel_broken|no_template
ReInjectResult = namedtuple("ReInjectResult", "status diff")

# ★FENCE_RE 已於 2026-08-03 移除,不要再加回來★——它有兩個致命假設:
#   ①圍欄成對(未閉合就看不見) ②標記在第 0 欄(收尾縮排會與下一個區塊錯配、
#   把中間的真散文整段吞掉)。這兩個假設在 code-loop r2/r4 各造成實測的靜默錯答:
#   幽靈圖譜邊、假合約佐證、G1 硬閘對壞引用放行、impact hook 漏掉合約節點。
# ★一律改用 `_visible_lines`(全檔唯一的 fence 判定)★:
#   要「剝圍欄 + 剝 inline code」→ `_strip_code_text`
#   要「只剝圍欄、★保留 inline code★」→ `_strip_fences_text`(refcheck 家族要這個)
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
_DOUBLE_BACKTICK_RE = re.compile(r"``.+?``")


def _strip_inline_markup(line):
    """行內層級的「哪些字看得見」——跟 `_visible_lines`(行層級)配成一對,★全檔唯一★,別在別處自寫第二份
    (條款綁定 -b r2 架構席:三條規則散在 clause_bindings 裡就是第二份)。
    剝:雙反引號 span、單反引號 span(INLINE_CODE_RE);★未閉合的反引號之後一律不信★(程式碼範例裡的 [test:]/[manual:] 不能當證據,寧可少認)。
    ★不碰 HTML 註解★:-b r3 兩席證明「偵測註解」本身就是洞(先關再開、註解正則不認反引號邊界),註解裡的 [SN] 一律走「認不得→擋」。
    回 (看得見的文字, 有沒有因未閉合反引號截掉東西)。search 的 probe 刻意只用 INLINE_CODE_RE 不走這裡:搜尋寧可多看見,截掉=靜默看不見(2026-08-03 那個坑)。"""
    s = INLINE_CODE_RE.sub("", _DOUBLE_BACKTICK_RE.sub("", line))
    if "`" in s:
        return s.split("`", 1)[0], True
    return s, False
WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")
DATE_PREFIX_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})")
TOP_KEY_RE = re.compile(r"^([A-Za-z_][\w-]*):\s*(.*)$")
LIST_ITEM_RE = re.compile(r"^\s+-\s+(.*)$")
QUOTED_DATE_RE = re.compile(
    r'^\s*(?:-\s+)?(?:date|created|updated|decided|ended):\s*"\d{4}-\d{2}-\d{2}"')
RULE3_RE = re.compile(r"^\s+-\s+\w+: [^\"'|>\s][^\"']*: \S")  # 未引號值含 ": "


def nfc(s):
    return unicodedata.normalize("NFC", s)


def strip_quotes(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    return s


def _posix_norm(s):
    """路徑比對鍵的共用正規化:反斜線轉斜線、去 ./ 與 a/../b(純字面,不查檔案);空的回空字串。
    工具自裝檔判別、about_code 的比對、排序加分讀 about_code 共用這一個(2026-09-10 代碼審 r3 架構席/整合席:
    原本三處各寫一份,排序那側只剝開頭的 ./,不解 ..)。"""
    import posixpath
    v = str(s).strip().replace("\\", "/")
    return posixpath.normpath(v) if v else ""


# doctor 印給消費專案的三處 CI 步驟提示共用這一句(Projects/最低Python版本改3.14_計劃 做法第 7 點):
# GitHub 的 ubuntu 預設 python3 是 3.12,不裝 3.14 的話更新後 lumos 在 CI 回 2
_CI_PY314_NOTE = ("\n  (這一步要在 Python 3.14 上跑:actions/setup-python 的 python-version 設 \"3.14\";"
                  "lumos 的最低版本是 3.14,舊版會回 2 並說明)")

_SINGLE_WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")   # 整個值恰好是一個連結(fullmatch 用;讀側索引與寫側判斷共用)


def _multi_link_value(s):
    """清單欄位的一個值裡有兩個以上連結開頭——一項只能是一個連結或一個值。
    讀的一側(parse_frontmatter 的 lint)與寫的一側(_list_scalar_value)共用這一個判斷(2026-09-10 代碼審 r3 架構席:
    原本讀側只認 `]], [[` 與 `]],[[`,寫側看兩個以上 [[,`[[A]],  [[B]]` 讀側不吭聲、寫側卻擋)。
    只用在清單欄位:散文欄位(例如 valid_under)講到兩個連結是正常的。"""
    return str(s).count("[[") > 1


def link_target(s):
    """從 wikilink 字串/list 項抽**完整 target**(去 [[]]、alias、heading、引號;**保留路徑**)。
    `[[Verification/X|y]]` → `Verification/X`。寫側 dedup 用它做精確比對:
    既修子字串誤判(A vs A_v2 不同),又不像 basename-only 把跨資料夾 Systems/X vs
    Verification/X 誤判相同(2026-06-13 第二輪審計 NEW-A)。"""
    t = strip_quotes(str(s).strip())
    t = t.replace("[[", "").replace("]]", "")
    t = t.split("|")[0].split("#")[0].strip()
    if t.lower().endswith(".md"):
        t = t[:-3]
    return nfc(t)


def split_frontmatter(text):
    """回傳 (fm_lines or None, body)"""
    if not text.startswith("---"):
        return None, text
    lines = text.split("\n")
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1:])
    return None, text


def parse_frontmatter(fm_lines):
    """極簡 parser(本 vault 慣例範圍): top-level 純量 + 字串 list + block scalar 內文。
    回傳 (fields, block_keys, lint)
      fields: dict[key] = str | list[str];block scalar 的 key 也存內文(供 context 用)
      block_keys: block scalar 的 key 集合(其值內的 [[..]] 不得索引,鐵則 2)
      lint: 鐵則指紋發現
    """
    fields, block_keys, lint = {}, set(), []
    seen = set()
    i, n = 0, len(fm_lines)
    while i < n:
        line = fm_lines[i]
        m = TOP_KEY_RE.match(line)
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        if key in seen:
            lint.append(f"同一層欄位名重複,工具不知道該信哪個: {key}")
        seen.add(key)
        if val in ("|", "|-", ">", ">-"):
            block = []
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                if fm_lines[i].strip():
                    block.append(fm_lines[i].strip())
                i += 1
            fields[key] = "\n".join(block)
            block_keys.add(key)
            continue
        if val == "":
            items = []
            i += 1
            while i < n:
                l2 = fm_lines[i]
                if not l2.strip():
                    i += 1
                    continue
                if not l2.startswith(" "):
                    break
                ms = LIST_ITEM_RE.match(l2)
                if ms:
                    item = strip_quotes(ms.group(1).strip())
                    items.append(item)
                    if "]], [[" in item or "]],[[" in item or (key in LIST_KEYS and _multi_link_value(item)):
                        lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key} 項")
                if RULE3_RE.match(l2):
                    lint.append(f"欄位值裡有「冒號+空白」又沒加引號,讀出來會被切斷,整個值請用引號包起來: {l2.strip()[:60]}")
                i += 1
            fields[key] = items
            continue
        sval = strip_quotes(val)
        if sval == "[]":  # 行內空列表(YAML flow style)
            fields[key] = []
            i += 1
            continue
        fields[key] = sval
        if "]], [[" in sval or "]],[[" in sval or (key in LIST_KEYS and _multi_link_value(sval)):
            lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key}")
        i += 1
    for line in fm_lines:
        if QUOTED_DATE_RE.match(line):
            lint.append(f"日期加了引號會被當成文字、排序比較都失效,引號拿掉: {line.strip()}")
    return fields, block_keys, lint


def extract_targets(text):
    out = []
    for raw in WIKILINK_RE.findall(text):
        t = raw.split("|")[0].split("#")[0].strip()
        if t:
            out.append(nfc(t))
    return out


class Note:
    __slots__ = ("rel", "stem", "fields", "block_keys", "fm_lines",
                 "targets", "lint", "mtime")


def load_vault(vault: Path):
    notes = {}
    for p in sorted(vault.rglob("*.md")):
        rel = nfc(p.relative_to(vault).as_posix())
        try:
            mtime = p.stat().st_mtime
            text = p.read_text(encoding="utf-8-sig")  # -sig: BOM 檔也偵測得到 frontmatter
        except Exception as e:
            n = Note()
            n.rel, n.stem = rel, nfc(p.stem)
            n.fields, n.block_keys, n.fm_lines = {}, set(), []
            n.targets, n.lint, n.mtime = [], [f"{_READ_FAIL}: {e}"], 0
            notes[rel] = n
            continue
        notes[rel] = _note_from_text(rel, text, mtime)
    return notes


_READ_FAIL = "讀檔失敗"      # 讀不進來的筆記在 Note.lint 的前綴:磁碟(load_vault)與提交的樹(Env.from_texts)共用這一個管道


def _note_unreadable(n):
    return any(str(x).startswith(_READ_FAIL) for x in (n.lint or []))


def _note_from_text(rel, text, mtime=0):
    """一篇筆記的文字 → Note。load_vault 與「某個提交的樹」共用(存量漂移防線_計劃:狀態一致檢查要能跑在
    任一提交上,不另寫第二套解析)。"""
    n = Note()
    n.rel = rel
    n.stem = nfc(rel.rsplit("/", 1)[-1][:-3] if rel.endswith(".md") else rel.rsplit("/", 1)[-1])
    n.mtime = mtime
    fm_lines, body = split_frontmatter(text)
    if fm_lines is not None:
        fields, block_keys, lint = parse_frontmatter(fm_lines)
    else:
        fm_lines, fields, block_keys, lint = [], {}, set(), []
    body_clean = _strip_code_text(body)   # ★不可換回 FENCE_RE:看不見未閉合圍欄→幽靈邊★
    # frontmatter 連結規則(對齊 Obsidian): 整個值恰為一個 wikilink 才索引,
    # 夾在散文中間的 [[..]] 不算;block scalar 整段排除(鐵則 2)
    fm_targets = []
    for key, v in fields.items():
        if key in block_keys:
            continue
        for item in (v if isinstance(v, list) else [v]):
            s = str(item).strip()
            fm = _SINGLE_WIKILINK_RE.fullmatch(s)
            if fm:
                t = fm.group(1).split("|")[0].split("#")[0].strip()
                if t:
                    fm_targets.append(nfc(t))
    n.fields = fields
    n.block_keys = block_keys
    n.fm_lines = fm_lines
    n.targets = extract_targets(body_clean) + fm_targets
    n.lint = lint
    return n


def build_index(notes):
    by_stem = defaultdict(list)
    for rel, n in notes.items():
        by_stem[n.stem.lower()].append(rel)
    return by_stem


def make_resolver(notes, by_stem):
    rels = set(notes)

    def resolve(target):
        t = target
        if t.lower().endswith(".md"):
            t = t[:-3]
        if "/" in t:
            cand = t + ".md"
            if cand in rels:
                return cand
            t = t.rsplit("/", 1)[1]
        hits = by_stem.get(t.lower())
        if hits:
            return hits[0]
        return None

    return resolve


def as_list(v):
    if v is None:
        return []
    if isinstance(v, list):
        return [str(x) for x in v]
    return [str(v)]


class Env:
    def __init__(self, vault):
        self.vault = vault
        self.notes = load_vault(vault)
        self.by_stem = build_index(self.notes)
        self.resolve = make_resolver(self.notes, self.by_stem)
        self._edges = None
        self._texts = None

    @classmethod
    def from_texts(cls, vault, texts, unreadable=()):
        """{圖譜內相對路徑: 全文} → 只在記憶體裡的 Env(某個提交的樹、或考試時改過狀態的樹)。
        讀全文用 env_text,不要自己開檔——這種 Env 的檔不在磁碟上。unreadable=解不開的路徑:照 load_vault 讀檔失敗的
        做法建成 lint 帶「讀檔失敗」的空筆記(代碼審 r3 架構對齊席:同一件事不另開第二個管道)。"""
        self = cls.__new__(cls)
        self.vault = vault
        self._texts = {nfc(r): t for r, t in texts.items()}
        # 照路徑逐層排序,跟 load_vault 的 Path 排序一致(代碼審 r1 正確性席:整串字串排序時 Projects-old/X
        # 會排在 Projects/X 前面,同名筆記在磁碟與樹上解到不同篇)
        notes = {r: _note_from_text(r, t) for r, t in self._texts.items()}
        for r in unreadable:
            n = Note()
            n.rel, n.stem, n.mtime = nfc(r), nfc(r.rsplit("/", 1)[-1][:-3]), 0
            n.fields, n.block_keys, n.fm_lines, n.targets, n.lint = {}, set(), [], [], [f"{_READ_FAIL}: 不是 UTF-8"]
            notes[n.rel] = n
        self.notes = dict(sorted(notes.items(), key=lambda kv: kv[0].split("/")))
        self.by_stem = build_index(self.notes)
        self.resolve = make_resolver(self.notes, self.by_stem)
        self._edges = None
        return self

    @property
    def edges(self):
        if self._edges is None:
            out_e, in_e = defaultdict(list), defaultdict(list)
            for rel, n in self.notes.items():
                seen = set()
                for t in n.targets:
                    d = self.resolve(t)
                    if d and d != rel and d not in seen:
                        seen.add(d)
                        out_e[rel].append(d)
                        in_e[d].append(rel)
            self._edges = (out_e, in_e)
        return self._edges

    def find(self, arg):
        """以 stem 或相對路徑找筆記,回傳 rel 或 None"""
        a = nfc(arg.strip())
        if a.lower().endswith(".md"):
            a = a[:-3]
        if "/" in a and (a + ".md") in self.notes:
            return a + ".md"
        hits = self.by_stem.get(a.rsplit("/", 1)[-1].lower())
        if hits:
            if len(hits) > 1:
                print(f"⚠ 同名筆記 {len(hits)} 個,取第一個: {hits[0]}", file=sys.stderr)
            return hits[0]
        return None


def env_text(env, rel):
    """一篇筆記的全文:記憶體裡的 Env 從記憶體拿,一般的從磁碟讀。讀不到回 None。"""
    t = getattr(env, "_texts", None)
    if t is not None:
        return t.get(rel)
    try:
        return (env.vault / rel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        return None


def first_line(s, width=72):
    s = (s or "").strip().split("\n")[0]
    return s if len(s) <= width else s[:width] + "…"


def status_of(env, rel):
    v = env.notes[rel].fields.get("status", "")
    return v if isinstance(v, str) else ""


TYPED_EDGE_FIELDS = ("verified_by", "plan_refs", "related")


def build_typed_index(env):
    """[M2/P0] typed-edge 反向索引——從 frontmatter 具名欄位(verified_by/plan_refs/related)建
    「每節點 ← 誰、以哪種邊型指向我」。補 Env.edges 無型別的洞(建圖層以 target 去重丟來源欄位)。
    每次呼叫現建現用(天生新鮮、無持久化=無腐爛)。合約(關係層主網 M2):
    - 只索引「整個值恰為一個 wikilink」(沿 load_vault fm_targets 規則);殘留 scalar → scalars
      warnings、不進索引(不靜默納入)。block scalar 欄位整段排除(鐵則 2)。
    - ghost(unresolved)→ ghosts 清單(不靜默丟);path 式不 fallback 到 stem(那是靜默猜)。
    - 同名無路徑 [[X]] 多篇候選 → ambiguous + 候選清單(嚴禁靜默指第一篇——不走 env.resolve,
      直接查 by_stem 候選數)。
    - 去重鍵 (source, target字面, type);ambiguous 條目 target=原 wikilink 字面。
    回傳 dict: rev={target_rel:[(source_rel,etype)]} fwd={source_rel:{etype:[target_rel]}}
              ghosts=[(src,字面,etype)] ambiguous=[(src,字面,etype,[候選])] scalars=[(src,etype,值)]"""
    rev = defaultdict(list)
    fwd = defaultdict(lambda: defaultdict(list))
    ghosts, ambiguous, scalars = [], [], []
    seen = set()
      ② `cmd_guard_trace()`:未閉合圍欄裡的測試名 ★被當成合約的真實佐證★
         → 污染 ★INVARIANT★→[test:]→Verification 證據鏈,正好打臉該指令自己的保證。
    逐行 toggle 的語意才是對的:未閉合圍欄之後一律視為 code(隱形),與主搜尋一致。
    ★爆炸半徑(2026-08-03 r3 由 Codex 覆核後修正,原宣稱過強)★:
      ・全庫 220 篇★無任何未閉合圍欄★(兩方各自掃過,一致)
      ・wikilink 邊集合 ★新舊完全相同(差集為空)★
        ★這裡刻意★不寫具體數字★,只寫不變量★——2026-08-03 r4 三位審查員各自
        獨立量,得到 436/382/728、976/728/240 等多組互不相同的值,沒有一個等於
        我原本抄來的「354」(那是 `lumos export --format dot` 的邊數口徑)。
        ★「邊數是多少」取決於你怎麼數(出現次數/去重/含不含 frontmatter/解析前後),
        但「新舊相同」與口徑無關——★該記的是不變量,不是那個數★。
        要自己驗:任選一種口徑,對 `body_clean` 用舊寫法與 `_strip_code_text`
        各算一次邊集合,比差集。
        ★過程檢討:我當初把 r3 審查員報告裡的數字直接抄進 docstring、沒有自己量,
         正是本專案同日剛在圖譜更正過的「數字被沿用進句子」——只是碰巧站得住★
      ・`guard trace` 全 vault 輸出 ★逐字元相同★(67 行,實測 diff)
      ・★但「清洗後文字一個字都不變」這個更強的說法不成立★:33-36 篇不同
        (兩位審查員各自量到 33 與 36,計數口徑略異;方向一致)——新法(逐行
        `lstrip().startswith("```")`)接受★縮排的圍欄★,舊 `FENCE_RE` 只認第 1 欄。
        ★這是與不閉合圍欄★正交★的另一類變化,原本的「爆炸半徑=0」理由沒涵蓋它★;
        方向上新法與主搜尋一致(search 一直都是逐行 lstrip)、也與 CommonMark 一致,
        故判定為修正而非回歸——但★這是事後補的論證,不是原本就驗過的★。
    """
    return "\n".join(pr for _no, _raw, pr in _search_visible_lines(text.split("\n"), include_code))


def _visible_lines(lines, keep_fenced=False):
    """★全檔唯一的 fenced-code 判定實作★:逐行 toggle,回 (行號從1起, 原始行)。

    `keep_fenced=True` 時保留圍欄★內★的文字(但仍跳過 ``` 標記行本身)。

    ★為什麼所有人都必須走這裡(2026-08-03 code-loop r2/r4)★:原本各處自己用
    `FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)`,那個正則有兩個致命假設——
      ① 假設圍欄★成對★:未閉合的圍欄看不見(r2 抓到:幽靈圖譜邊、假合約佐證)
      ② 假設圍欄標記★在第 0 欄★:收尾圍欄一縮排就跟下一個區塊的開頭錯配,
         ★把中間的真散文整段當程式碼吞掉★(r4 抓到,實測某條路徑宣稱直接消失)
    ②的消費端是治理機制本身(refcheck → design-loop 的 G1 硬閘、Edit/Write 前
    自動注入必看合約的 impact hook)——★一個縮排的 ``` 就能把某節點的鐵則警告
    靜默關掉★。逐行 toggle 對兩個假設都免疫。
    
    ★兩段式讀法(2026-09-16 代碼審 r2)★:先照 CommonMark 讀——收尾圍欄後面只能有空白,
    帶語言標記的那行不算收尾(不然巢狀範例裡的樣板會被當成真的)。但這條規則比題目寬:
    收尾★打錯一個字、多敲一鍵★也會變成「關不掉」,後面到檔尾所有內容(含合約行)
    無聲隱形——正是下面警告過的最危險模式換個門長出來。所以規格讀法如果讀完還有圍欄沒關,
    就整份退回寬鬆讀法(同字元、長度夠就算關)。取捨:同一份文件裡同時有巢狀範例★和★
    沒關到的圍欄時,會退回寬鬆、巢狀那題就擋不住——那等於回到 2026-09-16 之前的行為,
    不算退步,而且真的有沒關到的圍欄本來就該先修那個。
    """
    def _scan(strict):
        """回 (看得見的行, 收尾時還有沒有圍欄開著)。strict=照 CommonMark(收尾不得帶東西)。"""
        fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
        # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
        out = []
        for i, ln in enumerate(lines):
            indent = len(ln) - len(ln.lstrip(" "))
            s = ln.lstrip(" ")
            # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
            is_marker = indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))
            if is_marker:
                ch = s[0]
                run = len(s) - len(s.lstrip(ch))
                if fence is None:
                    fence = (ch, run)
                    continue
                if ch == fence[0] and run >= fence[1] and (not strict or s[run:].strip() == ""):
                    fence = None
                    continue
            if fence is not None and not keep_fenced:
                continue
            out.append((i + 1, ln))
        return out, fence is not None

    out, unterminated = _scan(True)
    if unterminated:                      # 規格讀法讀不完 → 退回寬鬆(見說明的取捨)
        out, _ = _scan(False)
    yield from out


def _strip_fences_text(text):
    """只剝 fenced code block,★保留 inline code★——給 refcheck 家族用。

    ★為什麼不能用 `_strip_code_text`★:那支連 inline code 一起剝,而 refcheck
    要抽的路徑宣稱★正是寫在 inline code 裡★(`` `scripts/foo.py:12` ``)。
    用錯會讓所有宣稱憑空消失、G1 對著空清單宣告通過。
    """
    return "\n".join(ln for _no, ln in _visible_lines(text.split("\n")))


def _search_visible_lines(lines, include_code):
    """產生 (行號從1起, 原始行, 比對用 probe)——★search 的「哪些字看得見」唯一實作★。

    ★為什麼要抽出來(2026-08-03 code-loop r1,slot3 附實測)★:多詞回退的預檢原本自己
    寫了一份「整段 regex 剝 fence」,與主迴圈的「逐行 in_fence toggle」是★兩份實作★,
    遇到★未閉合的 ``` 圍欄★就分岔:主迴圈把圍欄後全部視為 code(隱形),預檢的成對
    regex 剝不掉懸空那半段(仍可見)。後果不是「回退多觸發一次」這種小事——是
    ★逐詞覆蓋虛報非零★:實測單獨搜某詞 0 篇,覆蓋卻印該詞 1 篇,直接打臉 M1.5
    「告訴你哪個詞 0 命中」的存在理由。
    ★我原本在註解裡把這個邊界寫成「方向保守、無害」——那個評估只涵蓋了「回退觸發
    與否」,沒涵蓋「覆蓋數字本身」。同一個坑今天第六次:用一個後果描述邊界,另一個
    後果就不在視野裡。★ 修法不是補正則,是讓兩邊共用這一份。
    """
    for _no, ln in _visible_lines(lines, keep_fenced=include_code):
        yield _no, ln, (ln if include_code else INLINE_CODE_RE.sub("", ln))


# ★字對回退的觸發下限(暫用值,還沒校準)★:只有「連續漢字段長度 ≥ 這個數」才拿它切字對。
# 4 個字 = 3 個字對,跟既有那句提示的觸發條件同一個數,不是另外拍的。
# ★這個數還沒有實測依據★——計劃 [S2] 明寫門檻要在對照組裡定,而對照組要等這支能跑才組得出
# 候選池(這就是為什麼實作排在量測前面)。目前預設關,所以拍錯也不影響任何人。
# REVISIT:2026-10-14 用 [S2] 那套獨立評測校準這個數,連同查詢長度一起看(短查詢與長問句
# 的風險不同,實測四個漢字三題有兩題仍正確回 0,真正的風險在長問句)。
_CJK_LOOSE_MIN_RUN = 4
# ★字對數上限★(2026-09-07 代碼審 r1 通才席判 major,兩邊各自量過):
# 這條回退的成本是 O(字對數 × 篇數 × 篇幅)——預檢對每個字對、每篇筆記做一次子字串比對,
# 主迴圈再對每一行比一次。本庫 441 篇實測(我自己量的,通才席另外量到同一個量級):
#   10 字 0.55s / 30 字 0.87s / 50 字 1.18s / 100 字 1.94s / 300 字 5.13s(通才席量到 3000 字 47.9s)
# ★2026-09-15 放寬:認得連字號★——原本 ^([A-Z]{2,}): 只吃連續大寫,
# 含連字號的前綴整行躲過檢查(打成 PRIOR-ARTT: 也沒人唸)。
SYMBOLISH_RE = re.compile(r"^([A-Z][A-Z-]*[A-Z]):")   # 像「符號宣告」的行→ 抓 typo


def _git_commit_exists(repo_root, sha):
    """[git:sha] Tier B 驗證:git cat-file -e sha^{commit}。非 git repo/物件缺 → False。"""
    import subprocess
    try:
        r = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=str(repo_root),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    except OSError:
        return False


def _git_is_shallow(repo_root):
    import subprocess
    try:
        r = subprocess.run(["git", "rev-parse", "--is-shallow-repository"], cwd=str(repo_root),
                           capture_output=True, text=True, errors="replace")
        return r.returncode == 0 and r.stdout.strip() == "true"
    except OSError:
        return False


def check_regen_provenance(note, repo_root):
    """Check J(regen 重生來源守衛)共用檢查器——cmd_lint 與 run_doctor 同呼叫同一函式(防兩入口
    規則漂移)。只對 frontmatter 帶 regen 的節點生效;非 regen 節點回三空。只掃 summary 行。
    回 (errs, warns, gov_events),兩入口映射(spec 映射表,照抄不猜):
      errs → lint errs 計 rc1 / doctor warn(hard) 計 issues
      warns → lint 顯示不計 rc / doctor warn_soft(J-d 提醒與 shallow 降級兩入口皆非阻擋)
      gov_events → 僅 doctor --ci 落 _append_governance_log;lint 高頻一律不落帳(防治理帳灌水)
    註:本函式為 regen 節點對 lint「node-local 不掃 repo」原則的 opt-in 例外(檔案+git 存取)。
    設計:Projects/from-scratch重生守衛_計劃;golden: governance/golden/fromscratch-m1。"""
    errs, warns, gov = [], [], []
        # 逐條判(r2 回滾席):code 型那條自己要是 major 以上;沒標型別的那條當分不出、保守算
        _hit = any(v in ("major", "blocker") and (_kinds is None or _kinds.get(k) == "code") for k, v in _sevs.items())
        _precision = "finding" if _kinds is not None else "round"   # 沒標型別=分不出是不是 code 型,不能謊報成逐條精度(r3 邊界席)
    else:
        _has_code = (_kinds is None) or any(str(v) == "code" for v in _kinds.values())   # 沒標型別=分不出,保守記;標了就只收 code 型
        _hit = severity in ("major", "blocker") and _has_code
        _precision = "round"   # 輪級判準:這輪最高 major 且任一條是 code 型——粗,帳上標出來讓讀側分得出
    if loop and str(loop).startswith("code-") and _hit:
        try:
            derived = str(loop)[len("code-"):]
            _auto_escape(env, "code-loop", severity,
                         f"代碼審記到 {severity}({auditor or '?'}{' ' + str(round_id) if round_id else ''})",
                         [(derived, _plan_for_loop(env, derived))],
                         _git_head(env.vault.parent.parent), source="code-loop", extra={"precision": _precision})
        except Exception as _ex:   # 掛勾不准弄壞記帳
            _escape_auto_failed(env, str(loop), "code-loop", str(_ex))
    return 0


def _jsonl_append_verified(path, rec, key_field, key_value):
    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
    import json
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"擋下:寫不進記錄檔({e}):\n    {path}", file=sys.stderr)
        return 2
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except (ValueError, RecursionError):   # 別筆是超深巢狀行也只跳過;否則已寫進去卻報沒記成功(code-逃逸帳 r3 邊界席)
                    continue
                if isinstance(d, dict) and d.get(key_field) == key_value:
                    return 0
    except (OSError, ValueError) as e:
        print(f"canary record: 落盤自驗失敗——寫完讀回來檢查時讀不到({e}),這筆不算記成功:\n    {path.resolve()}", file=sys.stderr)
        return 2
    print(f"canary record: 落盤自驗失敗——系統說寫成功了,但讀回來找不到這一筆,這筆不算記成功:\n    {path.resolve()}",
    want = (claim or "").strip()
    idxs = _guard_planned_idx(lines, e, claim)
    if len(idxs) > 1:
        return None, None, None, (f"{home_rel} 裡同時有好幾行預告寫著同一句話,分不清是哪一條"
                                  "——先手動把重複的那行處理掉")
    if not idxs:
        return None, None, None, f"{home_rel} 裡找不到預告行『{want[:30]}』(被手改過或已經轉正?)"
    return lines, idxs[0], e, None


def _guard_home_of(n):
    return _guard_home_of_fields(n.fields)


def _guard_home_of_fields(fields):
    g = fields.get(GUARD_MARK_FIELD)
    if isinstance(g, list) and g:
        return str(g[0]).strip()
    return str(g or "").strip()


# ★預告句型只有這一份★(存量漂移防線_計劃〈做法〉第 1 節):guard plan 樣板(_guard_plan_write_node)寫出的
# 四種預告句,settle 轉正時改寫、狀態一致檢查 c1 找殘留,兩邊用同一支比對——各寫一份的話,settle 改完的
# 句子可能又被 c1 認成預告,轉正後的推送被自己擋(設計審 r3 正確性席)。從行首比對(去掉摘要縮排);
# 第四句照樣板的實際字元,含反引號(r3 邊界席:照設計稿漏掉反引號會永遠對不上)。
_GUARD_WHY_MID = "]預告這條合約但還沒做:"
_GUARD_SETTLED_TAIL_RE = re.compile(r"已轉正\)\s*$")
_GUARD_PROSE_KINDS = ("test", "why", "whynot", "settle")


def _guard_planned_prose(line, region, settled_ok=False):
    """這一行是不是 guard plan 寫的預告句 → 'test'|'why'|'whynot'|'settle' 或 None。
    region 是 _notelines_regions 給的那一行所在區。WHY 行尾已經有「已轉正」不算預告
    (settled_ok=True 時回 'why-done',給 settle 分辨「已經改過」與「找不到」)。"""
    s = line.strip()
    if region == "summary":
        if s.startswith("TEST:還沒有測試在守這條"):
            return "test"
        if s.startswith("WHY:[") and _GUARD_WHY_MID in s:
            if _GUARD_SETTLED_TAIL_RE.search(s):
                return "why-done" if settled_ok else None
            return "why"
    elif region == "body":
        if s.startswith("為什麼還不做:"):
            return "whynot"
        if s.startswith("做完之後跑 `lumos guard settle` 轉正"):
            return "settle"
    return None


def _guard_formal_line(lines, e, claim, method=None, plat=None):
    """家筆記的摘要裡有沒有這條合約的正式行 → 行索引或 None:剝掉合約標記家族(INV_TAG_RE:test/audit/kill/src/git/manual/keeps)
    之後文字相同,而且綁的測試(invariant_test_refs,逗號清單拆開比完整名)含這支方法(method=None 時有綁任一支就算)。
    ★比對全用 guard 家族既有那兩支★(代碼審 r3 架構對齊席、正確性席:前兩輪自己寫行尾正規式,連續兩輪被抓到——
    剝全部 [鍵:值] 會把原文自帶的標籤剝掉、只認 test/audit/kill 又漏了 src/git,[test:a,b] 用子字串比也對不上);
    只看摘要(代碼審 r1 外家席:其他開頭欄位裡的同一句會被誤認成正式行)。"""
    want = INV_TAG_RE.sub("", claim).strip()
    regs = _notelines_regions("\n".join(lines))
    for i in range(1, e):
        if i < len(regs) and regs[i] != "summary":
            continue
        m = INVARIANT_RE.match(lines[i].strip())
        if not m or INV_TAG_RE.sub("", m.group(1)).strip() != want:
            continue
        refs = invariant_test_refs(m.group(1))
        if method is None:
            if refs:
                return i
            continue
        # 帶平台前綴的綁定照 resolve_test_refs 解(plat=(split, default),load_platforms 那一套):前綴是專案定義過的平台
        # 才拆,沒定義就不猜(代碼審 r4 架構對齊席);沒給 plat 時只認完全相同的名字(代碼審 r5 正確性席:多平台專案
        # 綁成 [test:ios:t_x] 時,只比完全相同會擋下又指到一條走不出去的路)
        names = set(refs)
        if plat is not None:
            try:
                names = {mm for _pl, mm in resolve_test_refs(m.group(1), plat[0], plat[1])}
            except ValueError:
                names = set()
        if method in names:
            return i
    return None


def _yaml_quote(v, what):
    """加引號,只用兩邊讀法一致的寫法:本工具讀的一側只剝掉頭尾一層引號、不解任何跳脫。
    雙引號在標準 YAML 裡會解反斜線跳脫 → 只在沒有反斜線、沒有雙引號時用;
    否則單引號(標準 YAML 裡除了 '' 以外一律照字面)→ 只在沒有單引號時用;兩種都不行就擋。"""
    if '"' not in v and "\\" not in v:
        return '"' + v + '"'
    if "'" not in v:
        return "'" + v + "'"
    raise ValueError(f"{what}「{v}」同時有單引號、又有雙引號或反斜線,工具寫不出本工具和 Obsidian 都讀得一樣的寫法,"
                     "檔案沒動;把其中一種引號換掉再寫")


def fmt_scalar(key, value):
    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
        return v  # bare,絕不加引號
    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)


def fmt_list_item(value):
    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
    v = value.strip()
    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")


def edit_fm_scalar(fm_lines, key, value):
    fm = list(fm_lines)
    formatted = fmt_scalar(key, value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "scalar":
            raise ValueError(f"{key} 是{kind}型欄位,set 只能改單一值的欄位(清單用 lumos append;決策用 lumos decision-add)")
        fm[s] = f"{key}: {formatted}"
    else:
        # 插在開頭純量區之後(第一個 list/block key 之前,否則末尾)
        ins = len(fm)
        for k, s, e, kind in fm_structure(fm):
            if kind in ("list", "block"):
                ins = s
                break
        fm.insert(ins, f"{key}: {formatted}")
    return fm


def edit_fm_sync_status_tag(fm_lines, status):
    """set status 的反正規化同步:tags 內既有 status/* 項就地改寫為 status/<新值>。
    無 tags/無 status/* 標籤則不動(純同步不發明;繞過本路徑的寫入由 lint/doctor
    漂移守衛兜底)。回傳 (new_fm, tags 內有無 status/* 標籤)。"""
    fm = list(fm_lines)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if "tags" not in struct or struct["tags"][2] != "list":
        return fm, False
    s, e, _kind = struct["tags"]
    found = False
    for i in range(s + 1, e + 1):
        m = re.match(r"^(\s*-\s*)status/\S+\s*$", fm[i])
        if m:
            fm[i] = f"{m.group(1)}status/{status}"
            found = True
    return fm, found


def _list_scalar_value(fm, key, line_idx):
    """清單欄位的單一值寫法(`key: 值`)讀出那一個值(去引號,空的回 "")。

    ★看起來是同一行清單就丟 ValueError★:工具不解析同一行裡的逗號(fm_structure 與
    parse_frontmatter 都把它當成一個值),照單一值轉會把整串 "[a, b]" 寫成一項。
    判準看「去引號後的值本身」,不列舉寫法(2026-09-10 代碼審 r2:只比對原始字串時,
    整串加引號、逗號前後多打空白都繞得過):以 [ 或 { 開頭(單一連結 [[X]] 除外),
    或一個值裡有兩個以上連結開頭。加了引號的空清單 "[]" 跟讀的一側一樣當成空的。"""
    m = TOP_KEY_RE.match(fm[line_idx])
    val = m.group(2).strip() if m else ""
    sval = strip_quotes(val)
    t = sval.strip()   # 引號裡面前面多一個空白也要認得(第三輪外家否決席:" [a, b]" 繞過)
    if t == "[]":
        return ""
    # 單一連結要「整個值恰好是一個連結」才豁免(第三輪外家找洞席:[[Systems/A], Systems/B] 開頭像連結就被放行)
    if (t.startswith(("[", "{")) and not _SINGLE_WIKILINK_RE.fullmatch(t)) or _multi_link_value(t):
        raise ValueError(f"{key} 寫成同一行的清單({val}),工具不解析這種寫法,"
                         f"硬加會把整串當成一項寫壞,檔案沒動。這種寫法目前只能手動改成一行一項"
                         f"({key}: 換行後每項一行「  - 值」),改完再重跑")
    return t   # 去掉前後空白:引號裡只有空白就是空的(第四輪正確性席:原本會留下一筆空白垃圾項)


def _list_key_scalar_to_list(fm, key, line_idx):
    """清單欄位被寫成單一值(`about_code: src/x.py`)時,改寫成一項的清單再給 append/remove 用。

    ★讀的一側本來就把單一值當成一項的清單★(as_list),只有寫的一側不認得——
    於是一篇筆記一旦是單一值寫法,append 說它不是清單、set 又不收清單欄位,
    沒有任何指令改得動(2026-09-10 代碼審 r1)。空值(`key:`)當成空清單;
    同一行的清單寫法擋下不轉(見 _list_scalar_value)。"""
    sval = _list_scalar_value(fm, key, line_idx)
    m = TOP_KEY_RE.match(fm[line_idx])
    raw = m.group(2).strip() if m else ""
    fm = list(fm)
    fm[line_idx] = f"{key}:"
    if sval:
        # ★原本那一項原封不動★:有引號就照原樣搬,不去掉再重新加(第三輪外家找洞席:'[[Systems/API "v2"]]'
        # 被重新加成帶反斜線的雙引號,讀的一側不解反斜線,讀回來就不是原本那篇了)
        quoted = len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'"
        fm.insert(line_idx + 1, f"  - {raw if quoted else fmt_list_item(sval)}")
    return fm


def edit_fm_append(fm_lines, key, value):
    fm = list(fm_lines)
    item = fmt_list_item(value)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
        cur = _list_scalar_value(fm, key, struct[key][0])
        if cur and link_target(cur) == tgt:
            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key in struct:
        s, e, kind = struct[key]
        if kind != "list":
            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
            fm[s] = f"{key}:"
        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
        for j in range(s + 1, e + 1):
            existing = fm[j].strip()
            if existing.startswith("-") and link_target(existing[1:]) == tgt:
                return fm  # 已存在,no-op
        # 偵測現有項縮排,否則預設 2 空格
        indent = "  "
        for j in range(s + 1, e + 1):
            if fm[j].lstrip().startswith("-"):
                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
                break
        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
        last = e
        while last > s and not fm[last].strip():
            last -= 1
        fm.insert(last + 1, f"{indent}- {item}")
    else:
        ins = len(fm)
        fm.insert(ins, key + ":")
        fm.insert(ins + 1, f"  - {item}")
    return fm


def edit_fm_remove(fm_lines, key, value):
    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。

    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
    fm = list(fm_lines)
    tgt = link_target(value)
    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
    if key not in struct:
        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
    if struct[key][2] == "scalar" and key in LIST_KEYS:
        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    s, e, kind = struct[key]
    if kind != "list":
        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
    hits = []
    for j in range(s + 1, e + 1):
        existing = fm[j].strip()
        if existing.startswith("-") and link_target(existing[1:]) == tgt:
            hits.append(j)
    if not hits:
        return fm, 0
    for j in reversed(hits):
        del fm[j]
    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
    if key in struct2:
        s2, e2, _ = struct2[key]
        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
            del fm[s2:e2 + 1]
    return fm, len(hits)


def decisions_items(fm_lines):
    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
    block = None
    for k, s, e, kind in fm_structure(fm_lines):
        if k == "decisions" and kind == "list":
            block = (s, e)
            break
    if block is None:
        return None
    s, e = block
    item_indent = None
    starts = []
    for i in range(s + 1, e + 1):
        ln = fm_lines[i]
        if not ln.strip():
            continue
        m = re.match(r"^(\s*)-\s", ln)
        if m:
            ind = len(m.group(1))
            if item_indent is None:
                item_indent = ind
            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
                starts.append(i)
    items = []
    for idx, st in enumerate(starts):
        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
        while en > st and not fm_lines[en].strip():
            en -= 1
        items.append((st, en))
    sub_indent = (item_indent + 2) if item_indent is not None else 4
    return s, e, items, (item_indent or 2), sub_indent


def load_raw_for_edit(path: Path):
    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
    raw = path.read_bytes()
    if raw.startswith(b"\xef\xbb\xbf"):
        raise ValueError("這個檔開頭帶 BOM 標記,工具不寫這種檔;先把檔案存成不帶 BOM 的 UTF-8")
    if b"\r\n" in raw:
        raise ValueError("這個檔的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)。Windows 上常是 git autocrlf 造成的;"
                         "修法:確認 .gitattributes 有套用(圖譜目錄標 eol=lf)再跑 git add --renormalize .,"
                         "或單檔跑 dos2unix。工具不會偷偷幫你改行尾。")
    lines = raw.decode("utf-8").split("\n")
    if not lines or lines[0].strip() != "---":
        raise ValueError("這篇筆記開頭沒有欄位區塊(---),沒辦法改欄位")
    fm_end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            fm_end = i
            break
    if fm_end is None:
        raise ValueError("開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),先補上")
    return lines, 1, fm_end


def _write_lf(path: Path, text: str):
    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.9。
    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
    整檔覆寫消費者)。read-modify-write 的併發:set/append/remove 由呼叫端上鎖(_vault_write_lock),
    其他寫入指令仍是 last-write-wins(單機 CLI,accepted)。
    ★暫存檔名每次都不一樣★(2026-09-10 代碼審 r3 併發資源席:原本同一篇筆記大家用同一個固定暫存檔名,
    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
    import os as _os, shutil as _sh, uuid as _uuid
    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
    try:
        with _os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
        if path.exists():
            _sh.copymode(path, tmp)
        _os.replace(tmp, path)
    except BaseException:
        try:
            _os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_write_verify(path: Path, new_lines, key, expected_check):
    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
    orig_fm = load_raw_for_edit(path)
    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
    text = "\n".join(new_lines)
    new_fm_lines = new_lines[1:]
    for i in range(1, len(new_lines)):
        if new_lines[i].strip() == "---":
            new_fm_lines = new_lines[1:i]
            break
    fields, _, new_lint = parse_frontmatter(new_fm_lines)
    if not expected_check(fields):
        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
    introduced = set(new_lint) - orig_lint
    if introduced:
        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)


_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己


_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)


def _vault_lock_where(vault):
    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。

    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。

    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
    互斥照樣成立。

    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
    """

hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "sed -n '3520,3608p' scripts/lumos && sed -n '23560,23620p' scripts/lumos && sed -n '23740,23790p' scripts/lumos && sed -n '26220,26380p' scripts/lumos && sed -n '28180,28230p' scripts/lumos && sed -n '32955,32995p' scripts/lumos && sed -n '8488,8520p' scripts/lumos" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-ns
 succeeded in 0ms:
        方向上新法與主搜尋一致(search 一直都是逐行 lstrip)、也與 CommonMark 一致,
        故判定為修正而非回歸——但★這是事後補的論證,不是原本就驗過的★。
    """
    return "\n".join(pr for _no, _raw, pr in _search_visible_lines(text.split("\n"), include_code))


def _visible_lines(lines, keep_fenced=False):
    """★全檔唯一的 fenced-code 判定實作★:逐行 toggle,回 (行號從1起, 原始行)。

    `keep_fenced=True` 時保留圍欄★內★的文字(但仍跳過 ``` 標記行本身)。

    ★為什麼所有人都必須走這裡(2026-08-03 code-loop r2/r4)★:原本各處自己用
    `FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)`,那個正則有兩個致命假設——
      ① 假設圍欄★成對★:未閉合的圍欄看不見(r2 抓到:幽靈圖譜邊、假合約佐證)
      ② 假設圍欄標記★在第 0 欄★:收尾圍欄一縮排就跟下一個區塊的開頭錯配,
         ★把中間的真散文整段當程式碼吞掉★(r4 抓到,實測某條路徑宣稱直接消失)
    ②的消費端是治理機制本身(refcheck → design-loop 的 G1 硬閘、Edit/Write 前
    自動注入必看合約的 impact hook)——★一個縮排的 ``` 就能把某節點的鐵則警告
    靜默關掉★。逐行 toggle 對兩個假設都免疫。
    
    ★兩段式讀法(2026-09-16 代碼審 r2)★:先照 CommonMark 讀——收尾圍欄後面只能有空白,
    帶語言標記的那行不算收尾(不然巢狀範例裡的樣板會被當成真的)。但這條規則比題目寬:
    收尾★打錯一個字、多敲一鍵★也會變成「關不掉」,後面到檔尾所有內容(含合約行)
    無聲隱形——正是下面警告過的最危險模式換個門長出來。所以規格讀法如果讀完還有圍欄沒關,
    就整份退回寬鬆讀法(同字元、長度夠就算關)。取捨:同一份文件裡同時有巢狀範例★和★
    沒關到的圍欄時,會退回寬鬆、巢狀那題就擋不住——那等於回到 2026-09-16 之前的行為,
    不算退步,而且真的有沒關到的圍欄本來就該先修那個。
    """
    def _scan(strict):
        """回 (看得見的行, 收尾時還有沒有圍欄開著)。strict=照 CommonMark(收尾不得帶東西)。"""
        fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
        # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
        out = []
        for i, ln in enumerate(lines):
            indent = len(ln) - len(ln.lstrip(" "))
            s = ln.lstrip(" ")
            # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
            is_marker = indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))
            if is_marker:
                ch = s[0]
                run = len(s) - len(s.lstrip(ch))
                if fence is None:
                    fence = (ch, run)
                    continue
                if ch == fence[0] and run >= fence[1] and (not strict or s[run:].strip() == ""):
                    fence = None
                    continue
            if fence is not None and not keep_fenced:
                continue
            out.append((i + 1, ln))
        return out, fence is not None

    out, unterminated = _scan(True)
    if unterminated:                      # 規格讀法讀不完 → 退回寬鬆(見說明的取捨)
        out, _ = _scan(False)
    yield from out


def _strip_fences_text(text):
    """只剝 fenced code block,★保留 inline code★——給 refcheck 家族用。

    ★為什麼不能用 `_strip_code_text`★:那支連 inline code 一起剝,而 refcheck
    要抽的路徑宣稱★正是寫在 inline code 裡★(`` `scripts/foo.py:12` ``)。
    用錯會讓所有宣稱憑空消失、G1 對著空清單宣告通過。
    """
    return "\n".join(ln for _no, ln in _visible_lines(text.split("\n")))


def _search_visible_lines(lines, include_code):
    """產生 (行號從1起, 原始行, 比對用 probe)——★search 的「哪些字看得見」唯一實作★。

    ★為什麼要抽出來(2026-08-03 code-loop r1,slot3 附實測)★:多詞回退的預檢原本自己
    寫了一份「整段 regex 剝 fence」,與主迴圈的「逐行 in_fence toggle」是★兩份實作★,
    遇到★未閉合的 ``` 圍欄★就分岔:主迴圈把圍欄後全部視為 code(隱形),預檢的成對
    regex 剝不掉懸空那半段(仍可見)。後果不是「回退多觸發一次」這種小事——是
    ★逐詞覆蓋虛報非零★:實測單獨搜某詞 0 篇,覆蓋卻印該詞 1 篇,直接打臉 M1.5
    「告訴你哪個詞 0 命中」的存在理由。
    ★我原本在註解裡把這個邊界寫成「方向保守、無害」——那個評估只涵蓋了「回退觸發
    與否」,沒涵蓋「覆蓋數字本身」。同一個坑今天第六次:用一個後果描述邊界,另一個
    後果就不在視野裡。★ 修法不是補正則,是讓兩邊共用這一份。
    """
    for _no, ln in _visible_lines(lines, keep_fenced=include_code):
        yield _no, ln, (ln if include_code else INLINE_CODE_RE.sub("", ln))


# ★字對回退的觸發下限(暫用值,還沒校準)★:只有「連續漢字段長度 ≥ 這個數」才拿它切字對。
# 4 個字 = 3 個字對,跟既有那句提示的觸發條件同一個數,不是另外拍的。
# ★這個數還沒有實測依據★——計劃 [S2] 明寫門檻要在對照組裡定,而對照組要等這支能跑才組得出
# 候選池(這就是為什麼實作排在量測前面)。目前預設關,所以拍錯也不影響任何人。
        return True
    name = path.rsplit("/", 1)[-1]
    stem = _testmap_stem(path)
    return (".spec." in name or ".test." in name or stem.startswith("test_")
            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)


def _nodehome_code_kind(path):
    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
    base = path.rsplit("/", 1)[-1]
    stripped = base.lstrip(".")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where, oids=None):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。
    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    for ent in raw.split(b"\0"):
        if not ent or b"\t" not in ent:
            continue
        meta, p = ent.split(b"\t", 1)
        parts = meta.split()
        if where == "index":
            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
                continue
            continue
        if any(fnmatch.fnmatch(p, g) for g in _NODEHOME_EXCLUDE_GLOBS):
            continue
        if p in vendored_skip or _cochange_excluded(p, cfg["ignore"]) or _nodehome_is_test(p, layout):
            continue
        if kind == "shebang?":
            if p in side.shebang:
                ok = side.shebang[p]
            elif side.share is not None and p not in side.changed and p in side.share.shebang:
                ok = side.shebang[p] = side.share.shebang[p]
            else:
                head = side._reader(p)
                ok = side.shebang[p] = _head_is_shebang(head)
            if not ok:
                continue
        try:
            p.encode("utf-8")
        except UnicodeEncodeError:
            bad_names.add(p)
            continue
        req.add(p)
    return req, bad_names


def _nodehome_key(value):
    """about_code 一項的比對鍵(字面):路徑正規化+NFC。★不讀磁碟★——比對的是被檢查那個版本裡的樣子,
    推送一個不是目前 checkout 的分支時,磁碟上的拼法跟那個提交對不上(第二輪邊界席實跑重現的誤擋)。
    about_code 寫入時已經照磁碟校正過(解連結、大小寫、Unicode 寫法;_about_code_path),所以字面比就夠。"""
    return nfc(_posix_norm(strip_quotes(str(value).strip())))


def _home_map_from_notes(items):
    """★家對照表的唯一算法★(推筆記認家 [S1]):輸入 (節點名, type, status, about_code 清單) 的序列,
    回 ({檔: [家那幾篇]}, {節點名: 自己管的檔集合})。只看 about_code 欄位值、不看預標指紋有沒有過期
    (指紋在每次寫回都會過期)。每支檔有家從提交快照餵、改檔前推筆記從已載入的圖譜餵,★兩邊共用這一支★——
    兩套算法一定分岔,而分岔時沒有東西會翻紅。"""
    homes, own = {}, {}
    for rel, typ, status, about in items:
        keys = {k for k in (_nodehome_key(v) for v in about) if k}
        own[rel] = keys
        if typ != "system" or status not in _NODEHOME_HOME_STATUSES:
            continue
        for k in keys:
            homes.setdefault(k, []).append(rel)
    return homes, own


def _nodehome_homes(repo_root, side):
    """[S2] {檔: [家那幾篇]}——每支檔有家這邊:拿提交快照的解析結果餵 _home_map_from_notes。"""
    return _home_map_from_notes((rel, n["type"], n["status"], n["about"]) for rel, n in side.notes.items())

_DRIFT_FIXES = "governance/drift-fixes.jsonl"
_DRIFT_FIX_KINDS = ("c1", "c2", "c3", "c4", "c5")
_DRIFT_BOUND_KINDS = ("c2", "c3")          # 表態要綁當時連著的已收尾計劃(related)與序號(seq)的種類
_DRIFT_GOLIVE_MARK = "drift check"
_DRIFT_GATE_VALUES = ("block", "warn", "off")
# ★沒寫設定時的預設★(計劃〈做法〉第 4 節第 4 點):三條門檻(考卷正例全對、工具鏈歷史重放不亂擋、噪音 ≤5)
# 都過才改成 block;還沒考就是 warn。
_DRIFT_DEFAULT_GATE = "warn"
_DRIFT_BUDGET_SEC = 60


def _drift_str(n, key):
    v = n.fields.get(key, "") if n is not None else ""
    return v.strip() if isinstance(v, str) else ""


def _drift_fm_end(lines):
    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
    if not lines or lines[0].strip() != "---":
        return 0
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return i
    return 0


def _drift_field_line(text, key, pred=None):
    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    for i in range(1, e):
        m = TOP_KEY_RE.match(lines[i])
        if not (m and m.group(1) == key):
            continue
        if pred is None:
            return i + 1
        for j in range(i, e):
            if j > i and TOP_KEY_RE.match(lines[j]):
                break
            if pred(lines[j]):
                return j + 1
        return i + 1
    return 1


def _drift_line_text(text, ln):
    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
    lines = text.split("\n")
    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""


def _drift_c3_hit(env, vrel, override=None, ti=None):
    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
    n = env.notes.get(vrel)
    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
        return None
    if GUARD_MARK_FIELD in n.fields:
        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
    if not refs:
        return None
    ti = ti if ti is not None else build_typed_index(env)
    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
    if any(not link_target(x) for x in refs) \
            or any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
        return None
    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
    if not plans:
        return None
    for prel in plans:
        pn = env.notes.get(prel)
        if pn is None or _drift_str(pn, "type") != "project":
            return None
        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
            return None
    return plans


def _drift_linked(env, rel):
    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
    out_e, in_e = env.edges
    got = {}
    for d in out_e.get(rel, []):
        got[d] = "out"
    for s in in_e.get(rel, []):
        got[s] = "both" if s in got else "in"
    return got


def _drift_state_findings(env, only=None):
    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
    only=要算的路徑集合(None=全部)。"""
    out = []
    ti = build_typed_index(env)
    for rel, n in sorted(env.notes.items()):
        if only is not None and rel not in only:
            continue
        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
            out += _drift_guard_findings(env, rel, n, st)
        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
            out += _drift_c2(env, rel)
        if ty == "verification":
            plans = _drift_c3_hit(env, rel, ti=ti)
            if plans:
                text = env_text(env, rel) or ""
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
        vu = n.fields.get("valid_under")
        vtxt = " ".join(as_list(vu)) if vu else ""
        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
            text = env_text(env, rel) or ""
            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
    return out


def _drift_c2(env, rel):
    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
             if _drift_str(env.notes.get(p), "type") == "project"
             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
    if not plans:
        return []
    text = env_text(env, rel) or ""
    ln = _drift_field_line(text, "status")
    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]


def _drift_guard_findings(env, rel, n, st):
    """守衛紀錄的 c1(轉正了還寫預告,一句一筆)與 c5(轉正做了一半)。"""
    text = env_text(env, rel)
    if text is None:
        return []
    out = []
    lines = text.split("\n")
    if st == "pass":
        regs = _notelines_regions(text)
        for i, ln in enumerate(lines):
            k = _guard_planned_prose(ln, regs[i])
            if k:
                out.append({"kind": "c1", "path": rel, "line": i + 1, "text": ln.strip(), "related": [],
                            "why": "已轉正(status: pass)但還留著預告句"})
    elif st == "pending":
        m = re.search(r"^預告的合約:(.+)$", text, re.M)
        home = env.resolve(link_target(_guard_home_of_fields(n.fields))) if _guard_home_of_fields(n.fields) else None
        htext = env_text(env, home) if home else None
        if m and htext is not None:
            hl = htext.split("\n")
def _drift_report_must(root, mode, must, unknown, acks, alive=None):
    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
    for u in unknown:
        print(f"  判不了:{_esc_clean(u, 1000)}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
    _drift_print_findings(must, sys.stderr, acks, alive)
    kinds = {f["kind"] for f in must}
    # 改法指令由 _drift_fix_hint 單一產生(存量漂移改法 [S10]):c1–c5 指到 lumos drift fix(c1 一篇一條),
    # 條件式回頭條件(probe)的修法不一樣,同一支給它自己的說法
    _drift_print_hints(must, sys.stderr, "改法(每一筆一條指令;c1 一篇一條):")
    if must:
        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
        for k in sorted(kinds):
            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
    if mode == "block":
        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
                            nodes=sorted({f["path"][:-3] for f in must})[:50])
        return 1
    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
    return 0


# ── 健檢與 doctor ────────────────────────────────────────────────────────────────────

def _drift_vault_of(env):
    root = _vault_repo_root(env)
    try:
        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        return root, env.vault.name


def cmd_drift_scan(env, at=None, as_json=False, budget=None):
    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
    import json as _j, math as _m, time as _t
    budget = _DRIFT_BUDGET_SEC if budget is None else budget
    if not _m.isfinite(budget) or not 0 < budget <= 86400:
        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
        return 2
    deadline = _t.monotonic() + budget
    root, vault_rel = _drift_vault_of(env)
    tenv, sha = env, None
        return a, ""
    if not _ZERO_SHA_RE.fullmatch(a or ""):
        s = _lens_full_sha(repo_root, a)
        if s is not None:
            return s, ""
    why = "新分支首推" if _ZERO_SHA_RE.fullmatch(a or "") else "起點在本機找不到"
    ml = _mainline_ref(repo_root, remote_only=True)
    if ml:
        anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
        if anc is not None and anc.returncode == 0:
            return None, f"{why},而且頂端已在主線({ml[0]})上——沒有新東西"
        mb = _lens_git(repo_root, "merge-base", tip, ml[1])
        if mb is not None and mb.returncode == 0 and mb.stdout.strip():
            return mb.stdout.strip(), f"{why}:從跟主線({ml[0]})的分岔點算"
    return _EMPTY_TREE_SHA, f"{why}:找不到主線,從空樹算(截到上線點)"


def _lens_git(repo_root, *args, quote=False, binary=False):
    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
    import subprocess as _sp
    cmd = ["git", "-C", str(repo_root)]
    if quote:
        cmd += ["-c", "core.quotePath=false"]
    try:
        if binary:
            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
    except (OSError, _sp.TimeoutExpired):
        return None


def _lens_full_sha(repo_root, rev):
    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
    if r is None or r.returncode != 0:
        return None
    sha = r.stdout.strip()
    return sha if _LENS_SHA_RE.match(sha) else None


def _mainline_ref(repo_root, remote_only=False):
    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
