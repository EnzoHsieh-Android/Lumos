 12222	def _guard_pass_home(env, glines):
 12223	    """已 pass 的守衛紀錄補改句的前提:讀得出預告的合約、家節點摘要裡有這條合約綁了測試的正式行。
 12224	    → (家節點路徑, 錯誤)。"""
 12225	    gfm, _gb = split_frontmatter("\n".join(glines))
 12226	    gfields = parse_frontmatter(gfm)[0] if gfm is not None else {}
 12227	    m = re.search(r"^預告的合約:(.+)$", "\n".join(glines), re.M)
 12228	    claim = m.group(1).strip() if m else ""
 12229	    home = _guard_home_of_fields(gfields)
 12230	    home_rel = env.find(home) if home else None
 12231	    htext = env_text(env, home_rel) if home_rel else None
 12232	    if claim and htext is not None:
 12233	        hfm, _hb = split_frontmatter(htext)
 12234	        if hfm is not None and _guard_formal_line(htext.split("\n"), len(hfm) + 1, claim, None) is not None:
 12235	            return home_rel, None
 12236	    what = ("讀不出預告的合約" if not claim else f"找不到家節點 {home or '(沒寫)'}" if htext is None
 12237	            else f"家節點 {home_rel[:-3]} 的摘要裡沒有這條合約綁了測試的正式行")
 12238	    return None, (f"{what}。兩條出路:這條合約其實還沒轉正——把 status 改回 pending 後走 lumos guard settle;"
 12239	                  "或正式行寫在別處——手動改句後,對剩下的 c1 用 lumos drift ack")
