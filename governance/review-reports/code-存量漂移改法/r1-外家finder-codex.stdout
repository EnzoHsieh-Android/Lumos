 12347	def cmd_guard_settle(env, ref, method=None, date=None):
 12348	    """轉正:預告行換成正式合約行並綁上測試,守衛節點轉成已通過,四種預告句改成歷史說法。
 12349	
 12350	    ★整段拿寫入鎖、守衛紀錄一次寫入、做到一半可以補完★(存量漂移防線_計劃 [S4][S5][S19]):
 12351	    原本第一步在鎖外、第二步才經 cmd_set 拿鎖,中間斷掉會留下「家筆記是正式行、守衛紀錄還是 pending」,
 12352	    舊版再跑 settle 找不到預告行就擋,guard-kill 記過這種卡死。
 12353	
 12354	    ★已經 pass 但還留著預告句★(存量漂移改法 第 3 節):補改句(前提、日期、不疊跟 drift fix --kind c1 同一支);
 12355	    前提不符回 2(以前一律回 0)。--test 只有 pending 要;--date 只給 pass 補改句用。"""
 12356	    rel, _n = _guard_find(env, ref)
 12357	    if rel is None:
 12358	        print(f"擋下:找不到守衛節點 {ref}(或那篇不是這套機制建的)", file=sys.stderr)
 12359	        return 2
 12360	    try:
 12361	        glines, _s, ge = load_raw_for_edit(env.vault / rel)
 12362	    except (ValueError, RuntimeError, OSError) as ex:
 12363	        print(f"擋下:{rel} 打不開:{ex}", file=sys.stderr)
 12364	        return 2
