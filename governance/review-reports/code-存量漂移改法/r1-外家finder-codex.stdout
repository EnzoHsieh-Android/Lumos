 27747	def _drift_close_banner(body, banner):
 27748	    """正文第一個 `# ` 標題之後、第一段之前加結案橫幅 → (新的正文行, 原本就有橫幅)。"""
 27749	    h = next((i for i, ln in enumerate(body) if ln.startswith("# ")), None)
 27750	    start = 0 if h is None else h + 1
 27751	    j = start
 27752	    while j < len(body) and not body[j].strip():
 27753	        j += 1
 27754	    if j < len(body) and body[j].lstrip("> ").startswith("已結案"):
 27755	        return body, True
 27756	    if h is None:
 27757	        return [banner, "", *body], False
 27758	    if j > start:
 27759	        return [*body[:j], banner, "", *body[j:]], False
 27760	    return [*body[:start], "", banner, "", *body[start:]], False
