                         [(derived, _plan_for_loop(env, derived))],
                         _git_head(env.vault.parent.parent), source="code-loop", extra={"precision": _precision})
        except Exception as _ex:   # 掛勾不准弄壞記帳
            _escape_auto_failed(env, str(loop), "code-loop", str(_ex))
    return 0


