 27395	def _drift_bound_latest(rows):
 27396	    """同一個鍵、記了 related 的表態裡 seq 最大的那幾筆(同號的全算;兩個工作樹各自追加後合併可能同號)。"""
 27397	    if not rows:
 27398	        return []
 27399	    top = max(_drift_ack_seq(a) for a in rows)
 27400	    return [a for a in rows if _drift_ack_seq(a) == top]
