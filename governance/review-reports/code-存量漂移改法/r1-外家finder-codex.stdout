 28016	def _drift_fix_write(env, cx, res):
 28017	    """第 5 步(鎖內):從磁碟重讀,指紋要等於判定時的才寫(atomic_write_verify);寫入例外一律轉成錯誤。"""
 28018	    try:
 28019	        with _vault_write_lock(env.vault):
 28020	            if cx["path"].read_bytes() != cx["raw"]:
 28021	                return "判定之後這一篇被改過,沒寫;重跑一次"
 28022	            atomic_write_verify(cx["path"], res["new"], res["key"], res["check"])
 28023	    except (ValueError, RuntimeError, OSError) as ex:
 28024	        return f"寫不進去,筆記沒動:{ex}"
 28025	    return None
 28026	
 28027	
 28028	def _drift_fix_verify(env, cx, res):
 28029	    """第 6 步(鎖外):磁碟內容等於算出的改後內容,而且重建圖譜物件後這一筆已處理。★不自動還原★。"""
 28030	    want = "\n".join(res["new"]).encode("utf-8")
 28031	    try:
 28032	        got = cx["path"].read_bytes()
 28033	    except OSError:
 28034	        got = None
 28035	    ok = got == want and res["handled"](_drift_state_findings(Env(env.vault), only={cx["rel"]}), got.decode("utf-8"))
 28036	    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "verify":      # 故障注入接縫(測試用),只認這兩個值
 28037	        ok = False
 28038	    if ok:
 28039	        return None
 28040	    return (f"寫入後內容跟預期不同(或這一筆還沒處理掉)——在 repo 根目錄跑 git checkout -- {cx['repo_rel']} "
 28041	            "還原後重跑;工具不自動還原")
 28042	
