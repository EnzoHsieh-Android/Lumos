 27759	def _drift_fix_clean_err(root, repo_rel, raw):
 27760	    """乾淨檢查 → 錯誤或 None:那一篇要在 git 裡有追蹤,而且跟 HEAD 沒差,或現在的指紋等於修復帳裡這一篇最後一筆的
 27761	    after_sha256(改動全是工具自己留下的,同一篇可以一項一項修、修完一起提交)。"""
 27762	    import hashlib
 27763	    ps = _drift_git_paths(root, repo_rel)
 27764	    if not ps:
 27765	        return f"{repo_rel} 沒被 git 追蹤(或 git 查不到)——不在版控裡,改壞了退不回來;先提交"
 27766	    if len(ps) > 1:
 27767	        return f"{repo_rel} 這個名字在 git 裡有 {len(ps)} 種 Unicode 拼法的檔並存,工具分不出要改哪一篇;先手動整理成一篇"
 27768	    gp = ps[0]
 27769	    r = _lens_git(root, "diff", "--quiet", "HEAD", "--", gp)
 27770	    if r is None or r.returncode not in (0, 1):
 27771	        return "git 查詢失敗或逾時(git diff HEAD),查不出這一篇乾不乾淨"
 27772	    if r.returncode == 0 or _drift_fix_last_sha(root, repo_rel) == hashlib.sha256(raw).hexdigest():
 27773	        return None
 27774	    return f"{repo_rel} 有未提交的改動(不是 drift fix 自己留下的)——先提交或還原再修"
