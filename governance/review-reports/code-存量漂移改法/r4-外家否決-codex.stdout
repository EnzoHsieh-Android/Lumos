 27611	def _drift_placeholder_err(text, what):
 27612	    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
