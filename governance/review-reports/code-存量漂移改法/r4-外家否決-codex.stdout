 27649	def _drift_print_hints(rows, stream, head="改法:"):
 27650	    """一批發現的改法指令;c1 一篇一條(改一次整篇的預告句都改掉)。"""
 27651	    seen, out = set(), []
 27652	    for f in rows:
 27653	        k = (f["kind"], f["path"]) if f["kind"] == "c1" else (f["kind"], f["path"], f["line"])
 27654	        if k in seen:
 27655	            continue
 27656	        seen.add(k)
 27657	        out += _drift_fix_hint(f["kind"], f["path"], f["line"])
 27658	    if out:
 27659	        print(head, file=stream)
 27660	        for x in out[:20]:
 27700	    return None
 27701	
