 27962	def _drift_c4_text_err(old, new):
 27963	    """c4 的 --old(指是哪一項)與 --new(那一項整個換成什麼)。★c4 由工具寫整項、自己加引號★:前三輪改成「人給片段、
 27964	    工具換原始文字」,人給的片段一路碰到引號、空白、冒號、控制字元都能寫出本工具與標準 YAML 讀法不同的開頭欄位
 27965	    (代碼審 r1 到 r3 邊界、外家、正確性席,同一類第三次);Enzo 2026-09-29 裁換形狀——語法全由工具決定,人給的內容
 27966	    只剩「一行、沒有控制字元與看不見的格式字元、頭尾沒空白」。"""
 27967	    import unicodedata
 27968	    if not _drift_one_line(old):
 27969	        return "--old 不能跨行"
 27970	    if not any(w in old for w in _DRIFT_UNCOMMITTED_WORDS):
 27971	        return f"--old 要含 {'/'.join(_DRIFT_UNCOMMITTED_WORDS)} 其中之一(換掉不相干的文字不算修)"
 27972	    if not _drift_one_line(new):
 27973	        return "--new 不能有換行(含 U+2028 這類會被當成分行的字元)"
 27974	    if new != new.strip() or any(unicodedata.category(c)[0] == "C" for c in new):
 27975	        return "--new 頭尾不能有空白,也不能有控制字元或看不見的格式字元"
 27976	    if any(w in new for w in _DRIFT_UNCOMMITTED_WORDS):
 27977	        return f"--new 不能再含 {'/'.join(_DRIFT_UNCOMMITTED_WORDS)}"
 27978	    return _drift_placeholder_err(new, "--new")
