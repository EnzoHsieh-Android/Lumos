 16430	        tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
 16431	        print(f"  NEIGHBOR {src} EDGE {etype}{tag}")
 16432	    for (lit, n) in ambigs:
 16433	        print(f"  NEIGHBOR-AMBIG {lit} CANDIDATES {n}")
 16434	    if not neighbors and not ambigs:
 16435	        print("  (無 typed 連入鄰居)")
 16436	    return 0
