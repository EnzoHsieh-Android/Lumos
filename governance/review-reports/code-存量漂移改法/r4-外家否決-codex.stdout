 16392	def cascade_surface(env, node_rel, root_decision_id, stream=None):
 16393	    """[M4/S1] surfacing 印行器:對 ledger 唯讀、不叫 AI(判斷閘=外部 agent 步驟)。
 16394	    NEIGHBOR 行由本函式印(dispatcher 印 CASCADE 行——它持有 mint 的 id 與 root id,T2 職責切分)。
 16395	    行式 schema=交接通道(編排者從此組 confirm/prune 參數)。回攤出的鄰居數。"""
 16396	    out = stream if stream is not None else sys.stderr
 16397	    neighbors, ambigs = _typed_hop1(env, node_rel)
 16398	    for (src, etype, inv_n) in neighbors:
 16399	        tag = f" INVARIANT_COUNT {inv_n}" if inv_n else ""
 16400	        print(f"NEIGHBOR {src} EDGE {etype}{tag}", file=out)
 16401	    for (lit, n) in ambigs:
 16402	        print(f"NEIGHBOR-AMBIG {lit} CANDIDATES {n}", file=out)
 16403	    return len(neighbors) + len(ambigs)
