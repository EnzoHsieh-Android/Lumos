 27712	_DRIFT_FIX_KIND_ARGS = {"c1": lambda o: None, "c2": _drift_fix_c2_args, "c3": _drift_fix_c3_args,
 27713	                        "c4": _drift_fix_c4_args, "c5": lambda o: None}
