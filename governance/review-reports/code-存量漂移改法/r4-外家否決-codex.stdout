 28020	def _drift_fix_c4(cx):
 28021	    """c4:不帶 --old/--new 只列證據與範本(回 None, None);帶了就用 --old 找出剛好一項,那一項整個換成 --new(工具加引號)。"""
 28022	    ev = _drift_c4_evidence(cx)
 28023	    o, lines, fe = cx["o"], cx["lines"], cx["fe"]
 28024	    if o.get("old") is None:
 28025	        _drift_c4_print(cx, ev)
 28026	        return None, None
 28027	    old, new = o["old"], o["new"]
 28028	    err = _drift_c4_text_err(old, new)
 28029	    if err:
 28030	        return None, err
 28031	    hits = _drift_valid_under_hits(lines, fe, old)
 28032	    if len(hits) != 1:
 28033	        where = "、".join(f"第 {i + 1} 行" for i in sorted({i for i, _c in hits}))
 28034	        return None, f"--old 在 valid_under 的值裡出現 {len(hits)} 次(要剛好一次){(':' + where) if where else ''}——給更長的片段"
 28035	    i, _c = hits[0]
 28036	    prefix, err = _drift_c4_item(lines, fe, i)
 28037	    if err:
 28038	        return None, err
 28039	    try:
 28040	        quoted = _yaml_quote(new, "--new")          # 既有的安全寫法:本工具與標準 YAML 讀出來一樣
 28041	    except ValueError as ex:
 28042	        return None, str(ex)
 28043	    out = list(lines)
 28044	    out[i] = prefix + quoted
 28045	    before = as_list(parse_frontmatter(lines[1:fe])[0].get("valid_under"))
 28046	    after = as_list(parse_frontmatter(out[1:fe])[0].get("valid_under"))
 28047	    diff = [k for k in range(min(len(before), len(after))) if before[k] != after[k]]
 28048	    if len(before) != len(after) or len(diff) != 1 or after[diff[0]] != new:
 28049	        return None, "換完之後 valid_under 的項數變了、不只一項不同,或讀回來不是 --new——沒寫"
 28050	    idx = diff[0]
 28051	
 28052	    def _handled(_fs, txt):
 28053	        fm, _b = split_frontmatter(txt)
 28054	        got = as_list(parse_frontmatter(fm)[0].get("valid_under")) if fm is not None else []
 28055	        return len(got) > idx and not any(w in got[idx] for w in _DRIFT_UNCOMMITTED_WORDS)
 28056	    return {"new": out, "key": "valid_under", "check": lambda f: as_list(f.get("valid_under")) == after,
 28057	            "handled": _handled, "extra": {"template_used": new.strip() == ev["template"]},
 28058	            "texts": [(new, "other")], "msg": f"valid_under 第 {idx + 1} 項整項換成 --new(工具加引號)"}, None
