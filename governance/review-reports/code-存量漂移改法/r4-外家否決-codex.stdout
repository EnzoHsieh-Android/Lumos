 28178	def _drift_fix_write(env, cx, res):
 28179	    """第 5 步(鎖內):從磁碟重讀,指紋要等於判定時的才寫(atomic_write_verify);寫入例外一律轉成錯誤。"""
 28180	    try:
 28181	        with _vault_write_lock(env.vault):
 28182	            if cx["path"].read_bytes() != cx["raw"]:
 28183	                return "判定之後這一篇被改過,沒寫;重跑一次"
 28184	            for dp, db in res.get("deps", []):
 28185	                try:
 28186	                    now = dp.read_bytes()
 28187	                except OSError:
 28188	                    now = None
 28189	                if now != db:
 28190	                    return f"判定之後它依賴的 {_esc_clean(str(dp.name), 120)} 被改過,沒寫;重跑一次"
 28191	            atomic_write_verify(cx["path"], res["new"], res["key"], res["check"])
 28192	    except (ValueError, RuntimeError, OSError) as ex:
 28193	        return f"寫不進去,筆記沒動:{ex}"
 28194	    return None
