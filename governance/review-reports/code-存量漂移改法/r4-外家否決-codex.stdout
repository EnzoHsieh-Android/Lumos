 27619	def _drift_sh(v, node=False):
 27620	    """印給人照貼的指令裡的一個參數:只由文字、數字(含中日韓文字)、底線與 ./@%+=:,- 組成就原樣,其他一律 shlex.quote
 27621	    (代碼審 r1 資安席:檔名帶 $(…)、; 或反引號的筆記,照貼提示就會執行攻擊者的指令;正確性席:帶空白會被切成兩個參數)。
 27622	    不直接全部 _sh_quote:它把中文也當危險字元,圖譜裡幾乎每條提示都會被包上引號;其他字元一律交給 _sh_quote。
 27623	    node=True(drift fix 的節點參數):以 - 開頭會被當成選項,加引號也沒用(shell 會拿掉引號),補成 ./ 開頭——
 27624	    _drift_fix_target 認得這個寫法(代碼審 r2 資安席)。"""
 27625	    v = str(v)
 27626	    if node and v.startswith("-"):
 27627	        v = "./" + v
 27628	    return v if v and re.fullmatch(r"[\w./@%+=:,-]+", v) else _sh_quote(v)
