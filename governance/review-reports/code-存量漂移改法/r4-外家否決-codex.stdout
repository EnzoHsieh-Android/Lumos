   477	def parse_frontmatter(fm_lines):
   478	    """極簡 parser(本 vault 慣例範圍): top-level 純量 + 字串 list + block scalar 內文。
   479	    回傳 (fields, block_keys, lint)
   480	      fields: dict[key] = str | list[str];block scalar 的 key 也存內文(供 context 用)
   481	      block_keys: block scalar 的 key 集合(其值內的 [[..]] 不得索引,鐵則 2)
   482	      lint: 鐵則指紋發現
   483	    """
   484	    fields, block_keys, lint = {}, set(), []
   485	    seen = set()
   486	    i, n = 0, len(fm_lines)
   487	    while i < n:
   488	        line = fm_lines[i]
   489	        m = TOP_KEY_RE.match(line)
   490	        if not m:
   491	            i += 1
   492	            continue
   493	        key, val = m.group(1), m.group(2).strip()
   494	        if key in seen:
   495	            lint.append(f"同一層欄位名重複,工具不知道該信哪個: {key}")
   496	        seen.add(key)
   497	        if val in ("|", "|-", ">", ">-"):
   498	            block = []
   499	            i += 1
   500	            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
   501	                if fm_lines[i].strip():
   502	                    block.append(fm_lines[i].strip())
   503	                i += 1
   504	            fields[key] = "\n".join(block)
   505	            block_keys.add(key)
   506	            continue
   507	        if val == "":
   508	            items = []
   509	            i += 1
   510	            while i < n:
   511	                l2 = fm_lines[i]
   512	                if not l2.strip():
   513	                    i += 1
   514	                    continue
   515	                if not l2.startswith(" "):
   516	                    break
   517	                ms = LIST_ITEM_RE.match(l2)
   518	                if ms:
   519	                    item = strip_quotes(ms.group(1).strip())
   520	                    items.append(item)
   521	                    if "]], [[" in item or "]],[[" in item or (key in LIST_KEYS and _multi_link_value(item)):
   522	                        lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key} 項")
   523	                if RULE3_RE.match(l2):
   524	                    lint.append(f"欄位值裡有「冒號+空白」又沒加引號,讀出來會被切斷,整個值請用引號包起來: {l2.strip()[:60]}")
   525	                i += 1
   526	            fields[key] = items
   527	            continue
   528	        sval = strip_quotes(val)
   529	        if sval == "[]":  # 行內空列表(YAML flow style)
   530	            fields[key] = []
   531	            i += 1
   532	            continue
   533	        fields[key] = sval
   534	        if "]], [[" in sval or "]],[[" in sval or (key in LIST_KEYS and _multi_link_value(sval)):
   535	            lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key}")
   630	        if "/" in t:
   631	            cand = t + ".md"
   632	            if cand in rels:
   633	                return cand
   634	            t = t.rsplit("/", 1)[1]
   635	        hits = by_stem.get(t.lower())
   636	        if hits:
   637	            return hits[0]
   638	        return None
