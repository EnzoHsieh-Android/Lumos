 27608	_DRIFT_PLACEHOLDER_RE = re.compile(r"<(?:為什麼[^<>\n]{0,30}|sha|卷證|原片段|新片段|整項新內容)>")
 27609	
 27610	
 27611	def _drift_placeholder_err(text, what):
 27612	    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
 27613	    Issue 標成結案、理由是佔位字)。只認 _drift_fix_hint 與 c4 證據頁真的印過、而且會被貼進 --reason/--new 的那幾種
 27614	    (為什麼…、sha、卷證、原片段、新片段、整項新內容);`Map<K,V>`、`<src/lib>` 這種真理由照收(代碼審 r2 正確性席、r3 邊界席)。"""
 27615	    m = _DRIFT_PLACEHOLDER_RE.search(text or "")
 27616	    return f"{what} 裡還留著提示的佔位字「{m.group(0)}」——換成真的內容再跑" if m else None
 27617	
 27618	
 27619	def _drift_sh(v, node=False):
 27620	    """印給人照貼的指令裡的一個參數:只由文字、數字(含中日韓文字)、底線與 ./@%+=:,- 組成就原樣,其他一律 shlex.quote
 27621	    (代碼審 r1 資安席:檔名帶 $(…)、; 或反引號的筆記,照貼提示就會執行攻擊者的指令;正確性席:帶空白會被切成兩個參數)。
 27622	    不直接全部 _sh_quote:它把中文也當危險字元,圖譜裡幾乎每條提示都會被包上引號;其他字元一律交給 _sh_quote。
 27623	    node=True(drift fix 的節點參數):以 - 開頭會被當成選項,加引號也沒用(shell 會拿掉引號),補成 ./ 開頭——
 27624	    _drift_fix_target 認得這個寫法(代碼審 r2 資安席)。"""
 27625	    v = str(v)
 27626	    if node and v.startswith("-"):
 27627	        v = "./" + v
 27628	    return v if v and re.fullmatch(r"[\w./@%+=:,-]+", v) else _sh_quote(v)
 27629	
 27630	
 27631	def _drift_fix_hint(kind, path, line):
 27632	    """一筆發現該印的改法指令 → [指令]。★提示的單一產生處★(存量漂移改法 [S10]):drift check 擋下與只列出、drift scan、
 27633	    doctor Z 段、計劃收尾的連帶待辦都從這裡拿,不再各自教人手改。"""
 27634	    node = _drift_sh(path[:-3] if path.endswith(".md") else path, node=True)
 27635	    base = f"lumos drift fix {node} {line} --kind {kind}"
 27636	    if kind == "c2":
 27637	        return [base + ' --close --status done --reason "<為什麼算解決,附提交或測試>"',
 27638	                base + ' --keep --reason "<為什麼還沒解決>"']
 27639	    if kind == "c3":
 27640	        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + ">"]
 27641	    if kind == "c4":
 27642	        return [base + '   # 先看證據與範本,再加 --old "<原片段>" --new "<新片段>"']
 27643	    if kind == "probe":
 27644	        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
 27645	                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
 27646	    return [base]
 27647	
