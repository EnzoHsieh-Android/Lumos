 16077	def cmd_dref_candidates(env, rel_in, as_json=False):
 16078	    """[V2] 列某節點候選決策(含翻案),讀側去重已填,附 skipped_no_id。"""
 16079	    import json as _j
 16080	    rel = env.find(rel_in)
 16081	    if rel is None:
 16082	        print(f"擋下:圖譜裡找不到叫 {rel_in} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
 16083	        return 2
 16084	    tidx = build_typed_index(env)
 16085	    cands, skipped = _dref_candidates(env, rel, tidx)
 16086	    filled = _dref_filled(env, rel)
 16087	    n = env.notes.get(rel)
 16088	    summary = first_line(str((n.fields.get("summary") if n else "") or ""), 80)
 16089	    out_rows = []
 16090	    for trel, did, content, valid in cands:
 16091	        already = (trel, did) in filled
 16092	        out_rows.append({"ref": f"{trel}#{did}", "content": content,
 16093	                         "valid": bool(valid), "already_filled": already})   # valid 已是 bool(_dref_candidates 轉好,arch-f3)
 16094	    if as_json:
 16095	        print(_j.dumps({"node": rel, "summary": summary, "candidates": out_rows,
 16096	                        "skipped_no_id": skipped}, ensure_ascii=False))
 16097	    else:
 16098	        print(f"節點 {rel}:{summary}")
