 27703	def _drift_fix_c4_args(o):
 27704	    old, new = o.get("old"), o.get("new")
 27705	    if (old is None) != (new is None):
 27706	        return "--old 與 --new 要一起給(都不給就是只列證據與範本)"
 27707	    if old is not None and (not old.strip() or not new.strip()):
 27708	        return "--old、--new 不能是空字串"
 27709	    return None
