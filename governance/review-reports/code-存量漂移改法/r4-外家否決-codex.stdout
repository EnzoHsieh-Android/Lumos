  5147	def _levenshtein_le1(a, b):
  5148	    """只判「編輯距離 ≤1」(打錯一個字的近名候選)——不做完整距離計算,夠用且便宜。"""
  5149	    if a == b:
  5150	        return False
  5151	    la, lb = len(a), len(b)
  5152	    if abs(la - lb) > 1:
  5153	        return False
  5154	    if la == lb:
  5155	        return sum(1 for x, y in zip(a, b) if x != y) == 1
  5156	    short, long_ = (a, b) if la < lb else (b, a)
  5157	    for i in range(len(long_)):
  5158	        if long_[:i] + long_[i + 1:] == short:
  5159	            return True
  5160	    return False
