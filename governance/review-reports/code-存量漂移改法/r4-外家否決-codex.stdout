 28214	def _drift_fix_record(env, cx, res):
 28215	    """第 7 步:寫修復帳(稽核紀錄)、記治理事件。帳寫不進去回 2,不動筆記。"""
 28216	    import datetime, hashlib, secrets
 28217	    rec = {"id": "DFIX-" + secrets.token_hex(4), "date": datetime.date.today().isoformat(), "path": cx["repo_rel"],
 28218	           "line": cx["line"], "kind": cx["kind"], "changed": _drift_fix_changes(cx["lines"], res["new"]),
 28219	           "after_sha256": hashlib.sha256("\n".join(res["new"]).encode("utf-8")).hexdigest(), **res["extra"]}
 28220	    want = "\n".join(res["new"]).encode("utf-8")
 28221	    moved = False
 28222	    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "ledger":
 28223	        rc = 2
 28224	    else:
 28225	        with _vault_write_lock(env.vault):
 28226	            # 驗證在鎖外,記帳前在鎖內再比一次:帳上的指紋要是記帳那一刻磁碟上的內容(代碼審 r1 外家席)
 28227	            try:
 28228	                if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "moved":   # 故障注入:模擬別人在驗證與記帳之間改了這一篇
 28229	                    cx["path"].write_bytes(want + b"\n")
 28230	                moved = cx["path"].read_bytes() != want
 28231	            except OSError:
 28232	                moved = True
 28233	            if moved:
 28234	                rc = 2
 28235	            else:
 28236	                rec["seq"] = _drift_next_seq(cx["root"], _DRIFT_FIXES)
 28237	                rc = _drift_ledger_append(cx["root"], _DRIFT_FIXES, rec)
 28238	    if rc != 0:
 28239	        why = ("寫好、驗過之後這一篇又被別人改了,修復帳沒記(帳上的指紋要是記帳那一刻的內容)" if moved
 28240	               else "筆記已改好,但修復帳沒記到")
 28241	        print(f"擋下:{why};{_esc_clean(cx['repo_rel'], 200)} 的改動用 git diff 看得到——確認沒問題就直接提交"
 28242	              "(修復帳只是稽核紀錄,少這一筆不影響之後的修;沒提交之前,同一篇的下一項 drift fix 會因為指紋對不上帳而擋下);"
 28243	              f"要退就 {_drift_git_hint(cx, 'checkout --')}", file=sys.stderr)
 28244	        return 2
 28245	    _gate_event_or_warn(cx["root"], "drift-check", "fix", f"{cx['rel']}:{cx['line']} {cx['kind']}({rec['id']})")
 28246	    return 0
