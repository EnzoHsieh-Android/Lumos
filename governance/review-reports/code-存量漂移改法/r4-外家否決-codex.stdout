 27735	def _drift_fix_target(env, node):
 27736	    """節點 → (筆記路徑, 錯誤)。同名好幾篇不猜(fix 會改檔,不能靠 env.find 取第一篇)。"""
 27737	    a = nfc(str(node).strip())
 27738	    explicit = a.startswith("./")                      # 提示對 - 開頭的節點印成 ./-x(_drift_sh);./ 開頭就是明確路徑
 27739	    a = a[2:] if explicit else a
 27740	    a = a[:-3] if a.lower().endswith(".md") else a
 27741	    if explicit or "/" in a:        # 給了路徑就只認那一篇,不退回用檔名猜(代碼審 r3 正確性席:./-x 原本被剝掉後改用檔名猜)
 27742	        return (a + ".md", None) if (a + ".md") in env.notes else (None, f"找不到筆記 {node}")
 27743	    hits = env.by_stem.get(a.lower(), [])
 27744	    if len(hits) > 1:
 27745	        return None, f"同名筆記有 {len(hits)} 篇({'、'.join(h[:-3] for h in hits[:5])}),給完整路徑"
 27746	    if not hits:
 27747	        return None, f"找不到筆記 {node}"
 27748	    return hits[0], None
