 28001	def _drift_valid_under_hits(lines, fe, old):
 28002	    """valid_under 值的原始文字裡 old 出現的位置 → [(行索引, 欄位)];欄位名 valid_under: 那幾個字不算。"""
 28003	    hits, inside = [], False
 28004	    for i in range(1, fe):
 28005	        m = TOP_KEY_RE.match(lines[i])
 28006	        if m:
 28007	            inside = m.group(1) == "valid_under"
 28008	            col = lines[i].index(":") + 1 if inside else 0
 28009	        elif inside:
 28010	            col = 0
 28011	        if not inside:
 28012	            continue
 28013	        pos = lines[i].find(old, col)
 28014	        while pos >= 0:
 28015	            hits.append((i, pos))
 28016	            pos = lines[i].find(old, pos + 1)
 28017	    return hits
