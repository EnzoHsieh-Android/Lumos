 28197	def _drift_fix_verify(env, cx, res):
 28198	    """第 6 步(鎖外):磁碟內容等於算出的改後內容,而且重建圖譜物件後這一筆已處理。★不自動還原★。"""
 28199	    want = "\n".join(res["new"]).encode("utf-8")
 28200	    try:
 28201	        got = cx["path"].read_bytes()
 28202	    except OSError:
 28203	        got = None
 28204	    ok = got == want and res["handled"](_drift_state_findings(Env(env.vault), only={cx["rel"]}), got.decode("utf-8"))
 28205	    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "verify":      # 故障注入接縫(測試用),只認 verify|ledger|moved
 28206	        ok = False
 28207	    if ok:
 28208	        return None
 28209	    return (f"寫入後內容跟預期不同(或這一筆還沒處理掉)——工具不自動還原。在 repo 根目錄跑 "
 28210	            f"{_drift_git_hint(cx, 'checkout --')} 退回上次提交的版本(★這一篇之前用 drift fix 改過、還沒提交的也會一起退掉★,"
 28211	            "修復帳裡那幾筆就只剩稽核紀錄;代碼審 r1 正確性、併發席);退完重跑 lumos drift scan,照新清單再修")
