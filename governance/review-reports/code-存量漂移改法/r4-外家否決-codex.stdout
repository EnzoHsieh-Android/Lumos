  9826	def _door_for_loop(env, loop_id):
  9827	    """規格閘留痕裡這條迴圈最後一次判的門;沒有就 unknown(規格閘上線前一律 unknown)。"""
  9828	    path = env.vault.parent / ".canary-log.jsonl"
  9829	    door = "unknown"
  9830	    if not path.exists():
  9831	        return door
  9832	    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
  9833	        if not ln.strip():
  9834	            continue
  9835	        try:
  9836	            d = json.loads(ln)
  9837	        except (ValueError, RecursionError):   # 自動記逃逸會走到這裡,它答應不炸(code-逃逸帳 r3 邊界席)
  9838	            continue
  9839	        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
  9840	            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
  9841	    return door
