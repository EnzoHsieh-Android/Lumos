   466	def split_frontmatter(text):
   467	    """回傳 (fm_lines or None, body)"""
   468	    if not text.startswith("---"):
   469	        return None, text
   470	    lines = text.split("\n")
   471	    for i in range(1, len(lines)):
   472	        if lines[i].strip() == "---":
   473	            return lines[1:i], "\n".join(lines[i + 1:])
   474	    return None, text
