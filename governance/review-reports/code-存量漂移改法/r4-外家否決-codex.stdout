 27981	_DRIFT_VU_ITEM_RE = re.compile(r"^([ \t]*-[ \t]+|valid_under:[ \t]*)(.*)$")
 27982	
 27983	
 27984	def _drift_c4_item(lines, fe, i):
 27985	    """第 i 行那一項能不能整項改寫 → (要保留的前綴, 錯誤)。只收單行的「- 項目」與「valid_under: 值」;行內清單、區塊文字、
 27986	    YAML 標記開頭、帶行尾註解、值跨到下一行的,工具不改、要手改(改了會丟掉或弄壞原本的結構)。"""
 27987	    m = _DRIFT_VU_ITEM_RE.match(lines[i])
 27988	    if not m:
 27989	        return None, "那一項不是單行的「- 項目」或「valid_under: 值」寫法,工具不改,要手改"
 27990	    raw = m.group(2).rstrip()
 27991	    if not raw or raw[0] in "[{|>&*!%@`":
 27992	        return None, "那一項是行內清單、區塊文字或 YAML 標記開頭,工具不改,要手改"
 27993	    if re.search(r"[ \t]#", raw):
 27994	        return None, "那一項帶行尾註解,整項改寫會丟掉它,工具不改,要手改"
 27995	    nxt = lines[i + 1] if i + 1 < fe else ""
 27996	    if nxt.strip() and nxt[:1] in " \t" and not re.match(r"^[ \t]*-[ \t]", nxt):
 27997	        return None, "那一項的值跨到下一行,工具不改,要手改"
 27998	    return (m.group(1) if m.group(1).lstrip().startswith("-") else "valid_under: "), None
 27999	
