  9807	def _plan_for_loop(env, loop_id):
  9808	    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。
  9809	    代碼審編號先去掉 code- 前綴;檔名比對兩邊都做 NFC(Projects/逃逸帳對得起來_計劃 第四節)。"""
  9810	    lid = nfc(str(loop_id or ""))
  9811	    if any(ch in lid for ch in ("/", "\\", "..")) or not lid.strip():
  9812	        return None   # 迴圈編號帶路徑字元不查(r1 資安席:否則拼出的路徑可能跳出 Projects/)
  9813	    if lid.startswith("code-"):
  9814	        lid = lid[len("code-"):]
  9815	    proj = env.vault / "Projects"
  9816	    for cand in (f"{lid}_計劃.md", f"{lid}.md"):
  9817	        if (proj / cand).is_file():
  9818	            return f"Projects/{cand}"
  9819	    for cand in (f"{lid}_計劃.md", f"{lid}.md"):
  9820	        q = _nfc_child(proj, cand) if proj.is_dir() else None
  9821	        if q is not None:
  9822	            return f"Projects/{q.name}"
  9823	    return None
