 28249	def cmd_drift_fix(env, node, line, kind, o):
 28250	    """lumos drift fix <節點> <行號> --kind c1..c5 [--dry-run] [種類專屬參數](Projects/存量漂移改法_計劃 第 1 節)。
 28251	    順序:乾淨檢查 → 鎖外讀與判定、前提、git 查詢 → 算改後內容、自由文字先過形狀擋 → (--dry-run 到此)→
 28252	    鎖內比指紋寫入 → 鎖外驗證磁碟內容與「已處理」→ 寫修復帳。不自動還原:改之前保證了 git 退得回來。"""
 28253	    err = _drift_fix_args_err(kind, o)
 28254	    rel = None
 28255	    if err is None:
 28256	        rel, err = _drift_fix_target(env, node)
 28257	    if err is None and kind == "c2" and o.get("keep"):
 28258	        return cmd_drift_ack(env, rel, line, "c2", o["reason"], dry_run=bool(o.get("dry_run")))   # 照留:等同帶清單的 c2 表態
 28259	    cx = None
 28260	    if err is None:
 28261	        cx, err = _drift_fix_load(env, rel, line, kind, o)
 28262	    res = None
 28263	    if err is None:
 28264	        res, err = _DRIFT_FIX_COMPUTE[kind](cx)
 28265	        if err is None and res is None:
 28266	            return 0                                                 # c4 只列證據與範本
 28267	    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
 28268	    if err is None and o.get("dry_run"):
 28269	        _drift_fix_preview(cx, res)
 28270	        return 0
 28271	    # 帳檔路徑在寫筆記之前先查(代碼審 r1 邊界席:原本寫完筆記才發現帳寫不進去,留下改了筆記、沒帳、又不讓重跑的狀態)
 28272	    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
 28273	    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
 28274	    if err:
 28275	        print(f"擋下:{err}", file=sys.stderr)
 28276	        return 2
 28277	    if _drift_fix_record(env, cx, res) != 0:
 28278	        return 2
 28279	    print(f"✓ drift fix {kind}:{_esc_clean(rel, 200)} 第 {line} 行——{res['msg']}")
 28280	    if kind == "c2":
 28281	        _issue_close_revisits(env, rel, o["status"])
 28282	    print(f"修復帳要跟筆記一起提交:\n    {_drift_git_hint(cx, 'add ' + _DRIFT_FIXES)} && git commit")
 28283	    return 0
