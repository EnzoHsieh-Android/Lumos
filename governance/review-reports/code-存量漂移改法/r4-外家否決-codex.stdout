 13222	def cmd_guard_audit(env, node, invariant_substr, model="sonnet", date=None):
 13223	    """把 [audit:模型/日期] 留痕寫回 ★INVARIANT★ KEY 行(寫後自驗)。
 13224	    語意:這條鐵則的「合法性」(是不是真鐵則 / 綁的測試夠不夠格)已由一個
 13225	    *無對話脈絡的獨立 agent* 判過並通過。工具只記留痕,不證明審計真的乾淨——
 13226	    那靠 skill 的 maker/checker 誠實鐵則(別餵結論給審計者、提出者不得自評)。"""
 13227	    import datetime
 13228	    if date is None:
 13229	        date = datetime.date.today().isoformat()
 13230	    stamp = f"{model}/{date}"
 13231	    rel = env.find(node)
 13232	    if rel is None:
 13233	        print(f"擋下:圖譜裡找不到叫 {node} 的筆記,先確認名稱或路徑(lumos search <關鍵字> 可以找)", file=sys.stderr)
 13234	        return 2
 13235	    path = env.vault / rel
 13236	    try:
 13237	        lines, _, e = load_raw_for_edit(path)
 13238	    except (ValueError, RuntimeError) as ex:
 13239	        print(f"擋下:{ex}", file=sys.stderr)
 13240	        return 2
 13241	    target_idx = None
 13242	    for i in range(1, e):
 13243	        # 比對去掉 [test:]/[audit:] 後的行(子字串不誤命中既有標記內容)
 13244	        if INVARIANT_RE.match(lines[i].strip()) and invariant_substr in INV_TAG_RE.sub("", lines[i]):
 13245	            if target_idx is not None:
 13246	                print(f"擋下:『{invariant_substr}』同時對到好幾條 KEY 行,分不清是哪條,請給更長、更精確的片段", file=sys.stderr)
 13247	                return 2
 13248	            target_idx = i
 13249	    if target_idx is None:
 13250	        print(f"擋下:{rel} 裡找不到內容含『{invariant_substr}』的合約 KEY 行", file=sys.stderr)
