 26440	def _drift_status_probe_followups(env, rel, new_status):
 26441	    """連帶待辦第③項(乙,[S15]):[when-status:<這份計劃>=…] 的 status 條件因這次收尾成立的回頭條件——只做文字比對,
 26442	    不跑 git;同一行還有別的條件時註明,不宣稱整行成立。env 是改之前的圖譜:舊狀態本來就在值裡的,條件早就成立,
 26443	    不是這次收尾造成的,不列(代碼審 r1 正確性席、外家席:doing→done 對 =doing|done 原本也說成因這次成立)。"""
 26444	    out = []
 26445	    old = _drift_str(env.notes.get(rel), "status")
 26446	    for p in sorted(env.notes):
 26447	        for no, _tx, pr in _probe_lines(env_text(env, p) or "")[0]:
 26448	            hit = [v for k, v in pr["conds"] if k == "status" and _probe_value_err(k, v) is None
 26449	                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
 26450	                   and new_status in (vals := {x.strip() for x in v.partition("=")[2].split("|")}) and old not in vals]
 26451	            if hit:
 26452	                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
 26453	                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
 26454	    return out
