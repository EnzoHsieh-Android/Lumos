 16424	                                        for (s, e, n) in neighbors],
 16425	                          "ambiguous": [{"literal": l, "candidates": n} for (l, n) in ambigs]},
 16426	                         ensure_ascii=False))
 16427	        return 0
 16428	    print(f"NODE {rel}  typed-hop1 連入(verified_by/plan_refs;related 弱恆不展):")
