 26474	def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
 26475	    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
 26476	    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
 26477	    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
 26478	    lst = _drift_list(root, where)
 26479	    if lst is None:
 26480	        return None
 26481	    pre = vault_rel.rstrip("/") + "/"
 26482	    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
 26483	    import time as _t
 26484	    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
 26485	    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
 27580	    追加並讀回自驗。不改其他帳共用的 _jsonl_append_verified。回 rc。"""
 27581	    fp = Path(root) / rel
 27582	    err = _drift_ledger_path_err(root, rel)
 27583	    if err is None:
 27584	        try:
 27585	            fp.parent.mkdir(parents=True, exist_ok=True)
 27586	        except OSError as ex:
 27587	            err = f"建不了 {fp.parent}:{ex}"
 27588	    err = err or _drift_ledger_path_err(root, rel)
 27589	    if err is None:
 27590	        try:
 27591	            if fp.is_file() and fp.stat().st_size > 0:
 27592	                with open(fp, "rb") as fh:
 27593	                    fh.seek(-1, 2)
 27594	                    tail = fh.read(1)
 27595	                if tail != b"\n":
 27596	                    with open(fp, "a", encoding="utf-8") as fh:
 27597	                        fh.write("\n")
 27598	        except OSError as ex:
 27599	            err = f"補不了檔尾換行:{ex}"
 27600	    if err:
 27601	        print(f"擋下:{err}", file=sys.stderr)
 27602	        return 2
 27603	    return _jsonl_append_verified(fp, rec, "id", rec["id"])
