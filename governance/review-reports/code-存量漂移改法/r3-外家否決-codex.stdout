     r'^\s*(?:-\s+)?(?:date|created|updated|decided|ended):\s*"\d{4}-\d{2}-\d{2}"')
 RULE3_RE = re.compile(r"^\s+-\s+\w+: [^\"'|>\s][^\"']*: \S")  # 未引號值含 ": "
 
 
 def nfc(s):
     return unicodedata.normalize("NFC", s)
 
 
+def _nfc_child(parent, name):
+    """parent 目錄底下,名字 NFC 後等於 nfc(name) 的那一個實際項目 → Path 或 None。git 回的路徑、索引鍵都是 NFC,
+    磁碟上可能是 NFD(Linux 不幫忙正規化);OSError 當成沒有。"""
+    want = nfc(name)
+    try:
+        return next((q for q in Path(parent).iterdir() if nfc(q.name) == want), None)
+    except OSError:
+        return None
+
+
+def _phys_path(root, rel):
+    """root 底下的相對路徑(NFC)→ 磁碟上的實際路徑:直接存在就用它,不然逐層找 NFC 相同的名字;
+    找不到就回原路徑,讓呼叫端照常報「打不開」。"""
+    p = Path(root) / rel
+    if p.exists():
+        return p
+    cur = Path(root)
+    for seg in Path(rel).parts:
+        nxt = cur / seg
+        if not nxt.exists():
+            nxt = _nfc_child(cur, seg) or nxt
+        cur = nxt
+    return cur
+
+
