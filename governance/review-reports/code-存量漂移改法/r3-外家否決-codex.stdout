 28000	def _drift_valid_under_hits(lines, fe, old):
 28001	    """valid_under 值的原始文字裡 old 出現的位置 → [(行索引, 欄位)];欄位名 valid_under: 那幾個字不算。"""
 28002	    hits, inside = [], False
 28003	    for i in range(1, fe):
 28004	        m = TOP_KEY_RE.match(lines[i])
 28005	        if m:
 28006	            inside = m.group(1) == "valid_under"
 28007	            col = lines[i].index(":") + 1 if inside else 0
 28008	        elif inside:
 28009	            col = 0
 28010	        if not inside:
 28011	            continue
 28012	        pos = lines[i].find(old, col)
 28013	        while pos >= 0:
 28014	            hits.append((i, pos))
 28015	            pos = lines[i].find(old, pos + 1)
 28016	    return hits
