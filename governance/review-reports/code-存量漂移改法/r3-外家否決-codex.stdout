+        check(f"③{n} 已有本專案寫法的結案橫幅:不再疊一個", rc == 0 and t.count("已結案") == 1 and "沒再加" in out, out + t)
+    r = run(v, "drift", "ack", "Issues/K", "3", "--kind", "c2", "--reason", "等 Map<K,V> 泛型那支修好再結案")
