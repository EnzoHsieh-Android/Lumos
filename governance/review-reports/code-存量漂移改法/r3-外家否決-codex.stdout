    # [M3] ledger 抑制:掃 rel-cascade 帳本折疊出 terminal 事件(判過的粒度鍵)——terminal ts
    #   不早於決策 ended(日級;同日判定=翻案後立即處理的常態)→ 該邊跳過(解「判過無關卻每輪重報」
    #   永久假陽性)。E2 定位帳檔=全目錄掃(復用 list 的讀法),不需重建含秒數的檔名。
    _led_terminal = {}
    _casc_unseen_ts = []   # [T1 連鎖佇列軟提醒] header 合法且零筆判定=開了沒人看過的待辦單
    _casc_broken = 0       # header 損毀(壞 JSON/空檔)——全庫無主動管道報它(E2 只抽 transitions 不看 header)
    _rcd = _rel_cascade_dir(env)
    if _rcd.exists():
        for _p in sorted(_rcd.glob("*.jsonl")):
            _h, _trs = _ledger_read(_p)
            if _h is None:
                _casc_broken += 1
            elif not _trs:
                _casc_unseen_ts.append(str(_h.get("ts", "")))
            for _k, _t in _ledger_fold(_trs).items():
                _led_terminal[_k] = max(_led_terminal.get(_k, ""), str(_t.get("ts", "")))
    build_on_dead = []
    for drel, dn in sorted(notes.items()):
        for d in parse_decisions(dn.fm_lines):
            if str(d.get("valid", "true")).lower() != "false":
                continue
            ended = _ymd(d.get("ended"))
            if not ended:                        # 無 ended → 無從時序比對(P1 起新翻案自動補),跳過
                continue
            dcontent = first_line(str(d.get("content", "")), 40)
            did = str(d.get("id", "")).strip()
            for arel, etype in typed_in.get(drel, []):
                aupd = _ymd(notes[arel].fields.get("updated"))
                if not (aupd and aupd < ended):
                    continue
                # [M1] E2 首判精化:鄰居有 decision_refs → 只在指到「那條」翻案決策時才標
                #   (指到別條=已聲明依賴面、與本翻案無關,不冤枉);無 refs → 退回節點+ended 級(相容不退化)
                # [自動養成 不對稱信任] 抑制向只讀 decision_refs(human/cascade),**不讀 decision_refs_ai**
                #   ——誤 ai-ref 拿來抑制真落後邊=靜默漏傳播=頭號腐爛;ai-ref 抑制不了 E2(結構保證)
                refs = [str(x).strip() for x in as_list(notes[arel].fields.get("decision_refs"))]
                if refs:
                    def _hits(s):
                        mm = re.fullmatch(r"(.+?)#(d\d+)", s)
                        return bool(mm and did and mm.group(2) == did and env.resolve(mm.group(1)) == drel)
                    if not any(_hits(s) for s in refs):
                        continue
                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
                                                             for x in became):
                            continue
                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
    return viol, errs


def _note_shape_doctor_lines(repo_root, vault, ci=False):
    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:
        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, _w = _note_shape_config(txt)
    if mode != "block":
        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
                   "沒寫來源的現況描述不會被擋")
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    if ymls:
        # 跳過註解:整行被註解掉的那步不算有呼叫(第二層早就這樣判;代碼審 r3 通才席:兩句判法不一,中間漏唸)
        body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
        step = ("\n    - run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
                "python3 scripts/lumos note-shape --diff \"${{ github.event.before || '0000000000000000000000000000000000000000' }}..${{ github.sha }}\""
                "\n  (這步只在 push 事件跑(`if: github.event_name == 'push'`),pull_request 沒有前一版;checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了找得到主線:"
                "已在主線上的提交不重查,新分支首推(前一版是 40 個 0)或 force-push 後舊頂端找不到時,lumos 從跟主線的分岔點算)"
                + _CI_PY314_NOTE)
        if "note-shape --diff" not in body:
            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
        else:
            shallow = _ci_jobs_calling_without_full_history(ymls, "note-shape --diff")
            if shallow:
                out.append("專案 CI 呼叫了 note-shape,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
                           + _ci_jobs_list(shallow))
    if ci:
        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
        return out
    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
    if gl is None:
        return out
    ref = None
    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    if up is not None and up.returncode == 0 and up.stdout.strip():
        ref = up.stdout.strip()
    else:
        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
        ref = cands[0] if cands else None
    tip = _lens_full_sha(root, ref) if ref else None
        # 帶平台前綴的綁定照 resolve_test_refs 解(plat=(split, default),load_platforms 那一套):前綴是專案定義過的平台
        # 才拆,沒定義就不猜(代碼審 r4 架構對齊席);沒給 plat 時只認完全相同的名字(代碼審 r5 正確性席:多平台專案
        # 綁成 [test:ios:t_x] 時,只比完全相同會擋下又指到一條走不出去的路)
        names = set(refs)
        if plat is not None:
            try:
                names = {mm for _pl, mm in resolve_test_refs(m.group(1), plat[0], plat[1])}
            except ValueError:
                names = set()
        if method in names:
            return i
    return None


def _guard_planned_idx(lines, e, claim):
    """家筆記裡「剝掉 [watch:]/[due:] 之後完整文字等於這句合約」的預告行索引清單(0 條、1 條、好幾條由呼叫端判)。"""
    want = (claim or "").strip()
    out = []
    for i in range(1, e):
        m = PLANNED_RE.match(lines[i].strip())
        if m and _PLANNED_TAIL_RE.sub("", m.group(1)).strip() == want:
            out.append(i)
    return out


# 人手補的「已轉正」段(正文):settle 句下一個非空行長這樣,改句時刪掉 settle 句本身、不再疊一行(存量漂移改法 第 2 節)
_GUARD_MANUAL_SETTLED_RE = re.compile(r"^\(?(\d{4}-\d{2}-\d{2})\)? ?已轉正")
_GUARD_WHY_SETTLED_DATE_RE = re.compile(r"\((\d{4}-\d{2}-\d{2}) 已轉正\)\s*$")


def _guard_manual_settled_after(lines, i):
    """第 i 行之後(跳過空行)的下一個非空行是不是人手補的「已轉正」段。"""
    for ln in lines[i + 1:]:
        if ln.strip():
            return bool(_GUARD_MANUAL_SETTLED_RE.match(ln.strip()))
    return False


def _guard_prose_ops(lines):
    """守衛紀錄裡的預告句 → [(行索引, 種類)]。種類:test/why/why-done/whynot/settle,
    settle 句下一個非空行已是手補的「已轉正」段時記 settle-del(刪掉 settle 句那一行)。"""
    regs = _notelines_regions("\n".join(lines))
    ops = []
    for i, ln in enumerate(lines):
        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
        if k == "settle" and _guard_manual_settled_after(lines, i):
            k = "settle-del"
        if k is not None:
            ops.append((i, k))
    return ops


def _guard_prose_needs_date(ops):
    """改句要不要寫日期:TEST、WHY 兩句與換成「(日期 已轉正)」的 settle 句要;只改「為什麼還不做:」或刪 settle 句不要。"""
    return any(k in ("test", "why", "settle") for _i, k in ops)


def _guard_settle_rewrite(lines, today, home_link):
    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。
    settle 句下一個非空行已是手補的「已轉正」段:刪掉 settle 句那一行(連同緊接的一個空行),算處理過、不進 missing
    ——pending 轉正與 pass 補改走同一支,同一種句子不因入口不同而結果不同(存量漂移改法 第 2 節)。
    today 只在要寫日期時用得到(見 _guard_prose_needs_date)。"""
    ops = dict(_guard_prose_ops(lines))
    out, seen, skip = [], set(), set()
    for i, ln in enumerate(lines):
        if i in skip:
            continue
        k = ops.get(i)
        if k is None:
            out.append(ln)
            continue
        seen.add({"why-done": "why", "settle-del": "settle"}.get(k, k))
        ind = ln[:len(ln) - len(ln.lstrip())]
        if k == "test":
            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
        elif k == "why":

