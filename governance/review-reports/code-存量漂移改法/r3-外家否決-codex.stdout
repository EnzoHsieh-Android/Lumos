 24939	_NOTELINES_HEADING_RE = re.compile(r"^#{1,6}\s+(.*?)\s*#*\s*$")
 24940	_NOTELINES_DECISION_KEY_RE = re.compile(r"^(\s*)(?:-\s+)?([A-Za-z_][\w-]*)\s*:")
 24941	
 24942	
 24943	def _notelines_decision_fields(text):
 24944	    """decisions 裡每一行屬於哪一條決策的哪一欄 → {行號(從1起): (決策編號, 欄名, valid)}(Projects/筆記內容審_計劃 [S3][S4])。
 24945	    既有 decisions_items 只給每條決策的起訖行;決策編號用 decision-supersede 同一種 `id:` 比對,欄名逐行歸屬:
 24946	    跟項目子鍵同縮排、`鍵:` 開頭的行是那一欄,後面縮排更深或沒有 `鍵:` 的續行跟著前一欄。沒有編號的決策用 `#<序號>`。"""
 24947	    fm, _b = split_frontmatter(text)
 24948	    out = {}
 24949	    if not fm:
 24950	        return out
 24951	    di = decisions_items(fm)
 24952	    if di is None:
 24953	        return out
 24954	    _s, _e, items, _item_indent, sub_indent = di
 24955	    for n, (st, en) in enumerate(items, 1):
 24956	        did, valid, cur = f"#{n}", True, None
 24957	        fields = []
 24958	        for k in range(st, en + 1):
 24959	            ln = fm[k]
 24960	            m = _NOTELINES_DECISION_KEY_RE.match(ln)
 24961	            ind = len(ln) - len(ln.lstrip(" "))
 24962	            is_key = m and (k == st or ind == sub_indent)
 24963	            if is_key:
 24964	                cur = m.group(2)
 24965	                val = ln.split(":", 1)[1].strip()
 24966	                if cur == "id":
 24967	                    mm = re.match(r"^(d\d+)$", val)
 24968	                    if mm:
 24969	                        did = mm.group(1)
 24970	                elif cur == "valid":
 24971	                    valid = val.strip("\"'").lower() != "false"
 24972	            fields.append((k, cur))
 24973	        for k, f in fields:
 24974	            out[k + 2] = (did, f or "", valid)       # fm[0] 是全文第 2 行
 24975	    return out
 24976	
