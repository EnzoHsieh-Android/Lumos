#   幽靈圖譜邊、假合約佐證、G1 硬閘對壞引用放行、impact hook 漏掉合約節點。
# ★一律改用 `_visible_lines`(全檔唯一的 fence 判定)★:
#   要「剝圍欄 + 剝 inline code」→ `_strip_code_text`
#   要「只剝圍欄、★保留 inline code★」→ `_strip_fences_text`(refcheck 家族要這個)
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
_DOUBLE_BACKTICK_RE = re.compile(r"``.+?``")


def _strip_inline_markup(line):
    """行內層級的「哪些字看得見」——跟 `_visible_lines`(行層級)配成一對,★全檔唯一★,別在別處自寫第二份
    (條款綁定 -b r2 架構席:三條規則散在 clause_bindings 裡就是第二份)。
    剝:雙反引號 span、單反引號 span(INLINE_CODE_RE);★未閉合的反引號之後一律不信★(程式碼範例裡的 [test:]/[manual:] 不能當證據,寧可少認)。
    ★不碰 HTML 註解★:-b r3 兩席證明「偵測註解」本身就是洞(先關再開、註解正則不認反引號邊界),註解裡的 [SN] 一律走「認不得→擋」。
    回 (看得見的文字, 有沒有因未閉合反引號截掉東西)。search 的 probe 刻意只用 INLINE_CODE_RE 不走這裡:搜尋寧可多看見,截掉=靜默看不見(2026-08-03 那個坑)。"""
    s = INLINE_CODE_RE.sub("", _DOUBLE_BACKTICK_RE.sub("", line))
    if "`" in s:
        return s.split("`", 1)[0], True
    return s, False
WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")
DATE_PREFIX_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})")
TOP_KEY_RE = re.compile(r"^([A-Za-z_][\w-]*):\s*(.*)$")
LIST_ITEM_RE = re.compile(r"^\s+-\s+(.*)$")
QUOTED_DATE_RE = re.compile(
    r'^\s*(?:-\s+)?(?:date|created|updated|decided|ended):\s*"\d{4}-\d{2}-\d{2}"')
RULE3_RE = re.compile(r"^\s+-\s+\w+: [^\"'|>\s][^\"']*: \S")  # 未引號值含 ": "


def nfc(s):
    return unicodedata.normalize("NFC", s)


def _nfc_child(parent, name):
    """parent 目錄底下,名字 NFC 後等於 nfc(name) 的那一個實際項目 → Path 或 None。git 回的路徑、索引鍵都是 NFC,
    磁碟上可能是 NFD(Linux 不幫忙正規化);OSError 當成沒有。"""
    want = nfc(name)
    try:
        return next((q for q in Path(parent).iterdir() if nfc(q.name) == want), None)
    except OSError:
        return None


def _phys_path(root, rel):
    """root 底下的相對路徑(NFC)→ 磁碟上的實際路徑:直接存在就用它,不然逐層找 NFC 相同的名字;
    找不到就回原路徑,讓呼叫端照常報「打不開」。"""
    p = Path(root) / rel
    if p.exists():
        return p
    cur = Path(root)
    for seg in Path(rel).parts:
        nxt = cur / seg
        if not nxt.exists():
            nxt = _nfc_child(cur, seg) or nxt
        cur = nxt
    return cur


def strip_quotes(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    return s


def _posix_norm(s):
    """路徑比對鍵的共用正規化:反斜線轉斜線、去 ./ 與 a/../b(純字面,不查檔案);空的回空字串。
    工具自裝檔判別、about_code 的比對、排序加分讀 about_code 共用這一個(2026-09-10 代碼審 r3 架構席/整合席:
    原本三處各寫一份,排序那側只剝開頭的 ./,不解 ..)。"""
        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
    return door


def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
    log = env.vault.parent / ".escape-log.jsonl"
    ledger = env.vault.parent / ".canary-log.jsonl"
    known = set()
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                v = json.loads(ln).get("loop")
            except (ValueError, AttributeError, RecursionError):   # 超深巢狀行解析會遞迴過深(code-逃逸帳 r3 邊界席)
                continue
            if isinstance(v, str):
                known.add(nfc(v))
    import datetime as _dt
    import secrets as _sec
    review_ids = _review_loop_ids(env)
    written = 0
    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
    with _vault_write_lock(env.vault):
        existing = set()
        for r in _escape_rows_for(env, include_withdrawn=True):   # 撤回過的仍算記過,同觸發不會悄悄補回來
            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
        for loop_id, plan_rel in loops:
            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
            if nfc(loop_id) in known:
                attribution = "ledger"
            elif plan_ok:
                attribution = "plan-file"
            else:
                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
                continue
            door = _door_for_loop(env, loop_id)
            if stage == "push-gate-unreviewed" and door != "low":
                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
                continue
            if (nfc(loop_id), stage, sha) in existing:
                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
                continue
            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "token": "ESC-" + _sec.token_hex(4),
                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door,
                   "loop_kind": _escape_loop_kind(loop_id, review_ids)}
            if plan_rel:
                rec["plan"] = plan_rel
            if extra:
                rec.update(extra)
            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
                written += 1
                existing.add((nfc(loop_id), stage, sha))
                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
            else:
                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
    return written


def _plan_file_exists(env, plan_rel):
    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
    if (env.vault / plan_rel).is_file():
        return True
    parent = (env.vault / plan_rel).parent
    if not parent.is_dir():
        return False
    return _nfc_child(parent, Path(plan_rel).name) is not None


def _escape_auto_failed(env, loop_id, stage, why):
    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
    try:
        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
    except Exception:
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)
        elif k == "why":
            out.append(f"{ln.rstrip()}({today} 已轉正)")
        elif k == "whynot":
            out.append(f"{ind}預告當時{ln.lstrip()}")
        elif k == "settle":
            out.append(f"{ind}({today} 已轉正)")
        elif k == "settle-del":
            if i + 1 < len(lines) and not lines[i + 1].strip():
                skip.add(i + 1)
        else:
            out.append(ln)
    return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]


def _guard_date_arg(s):
    """--date 的值 → (日期字串, 錯誤)。格式要 YYYY-MM-DD、不晚於今天。"""
    import datetime
    try:
        d = datetime.date.fromisoformat(str(s).strip())
    except ValueError:
        return None, f"--date 要寫成 YYYY-MM-DD,你給的是 {s!r}"
    if d > datetime.date.today():
        return None, f"--date {d.isoformat()} 晚於今天,轉正日期不能是未來"
    return d.isoformat(), None


def _guard_written_settled_dates(lines):
    """那篇守衛紀錄裡已經寫過的轉正日期:正文手補的「<日期> 已轉正」段、摘要 WHY 行尾的「(<日期> 已轉正)」。"""
    regs = _notelines_regions("\n".join(lines))
    got = set()
    for i, ln in enumerate(lines):
        r = regs[i] if i < len(regs) else "body"
        if r == "body":
            m = _GUARD_MANUAL_SETTLED_RE.match(ln.strip())
        elif r == "summary" and _guard_planned_prose(ln, r, settled_ok=True) == "why-done":
            m = _GUARD_WHY_SETTLED_DATE_RE.search(ln)
        else:
            m = None
        if m:
            got.add(m.group(1))
    return got


def _guard_raw_git_path(root, repo_rel):
    """repo 相對路徑(NFC)→ git ls-files 列出的原樣路徑(無損解碼,傳回給 git 用);找不到或 git 失敗回 None。"""
    raw = _nodehome_git(root, "ls-files", "-z")
    if raw is None:
        return None
    want = nfc(repo_rel)
    for x in _nodehome_split_z(raw):
        if nfc(x) == want:
            return x
    return None


def _guard_pass_commit_date(root, repo_rel):
    """守衛紀錄第一次變成 status: pass 的提交日期 → (日期, 錯誤)。那一筆若也是這個檔第一次出現的提交(匯入、搬目錄、
    改名後重新加入)就不算。不用 git log -S <合約文字>:settle 是原地換行,出現次數不變,找不到轉正那次(設計審 r1)。"""
    if _git_is_shallow(root):
        return None, "這個 repo 是 shallow clone,查不到完整歷史"
    raw = _guard_raw_git_path(root, repo_rel)
    if raw is None:
        return None, f"git 裡找不到 {repo_rel}(沒被追蹤,或 git 查詢失敗/逾時)"
    log = _nodehome_git(root, "log", "--reverse", "--format=%H%x09%as", "-G", "^status: pass", "--", raw)
    added = _nodehome_git(root, "log", "--diff-filter=A", "--format=%H", "--", raw)
    if log is None or added is None:
        return None, "git 查詢失敗或逾時"
    adds = set(added.decode("utf-8", "replace").split())
    for row in log.decode("utf-8", "replace").splitlines():
        sha, _t, day = row.partition("\t")
        blob = _nodehome_git(root, "show", f"{sha}:{raw}")
        if blob is None:
            continue
        fm, _b = split_frontmatter(blob.decode("utf-8", "replace"))
        if not fm or str(parse_frontmatter(fm)[0].get("status", "")).strip() != "pass":
            continue
    while i < n:
        m = TOP_KEY_RE.match(fm_lines[i])
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        start = i
        if val in ("|", "|-", ">", ">-"):
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "block"))
        elif val == "":
            # 消費所有縮排行(含 list item 的 sub-mapping,如 decisions 的 content/decided),
            # 與 parse_frontmatter 一致 → fm_structure 算出的 end 涵蓋整個區塊(BUG-5 對齊)
            i += 1
            while i < n and (fm_lines[i].startswith(" ") or not fm_lines[i].strip()):
                i += 1
            out.append((key, start, i - 1, "list"))
        elif val == "[]":
            # YAML 合法空清單(範本 `aliases: []` 就是這樣寫)。2026-08-23 前被判成 scalar →
            # 從範本建的節點第一次 append 必敗,全庫 15 篇在此狀態。★只認空的 `[]`★,
            # 非空 inline list(`[a, b]`)仍當 scalar——那要真的解析逗號與引號,不在本次,
            # 且 append 遇到它會被擋(不會壞),可接受。
            out.append((key, start, start, "list"))
            i += 1
        else:
            out.append((key, start, start, "scalar"))
            i += 1
    return out


# 標準 YAML(1.1/1.2,Obsidian 用的 js-yaml)不加引號會讀成數字、日期、無限大的寫法——這些要加引號才是字串
# (2026-09-26 代碼審 r2 通才席:原本只認十進位整數與小數)。日期欄位(DATE_KEYS)刻意不加引號,走另一條路,不經這裡。
_YAML_TYPED_RE = re.compile(
    r"[-+]?(\d[\d_]*(\.[\d_]*)?|\.\d[\d_]*)([eE][-+]?\d+)?"       # 十進位、小數、科學記號
    r"|[-+]?0[xX][0-9a-fA-F_]+|[-+]?0[oO]?[0-7_]+|[-+]?0[bB][01_]+"  # 十六、八、二進位
    r"|[-+]?\d[\d_]*(:[0-5]?\d)+(\.[\d_]*)?"                        # 六十進位(1:20:30)
    r"|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN)"                          # 無限大、非數
    r"|\d{4}-\d\d?-\d\d?([Tt ].*)?")                                  # 日期、日期時間
_YAML_PLAIN_BAD_START = set("-?:,[]{}#&*!|>'\"%@`")


def _yaml_plain_ok(v):
    """★白名單★:這個值不加引號時,本工具的簡易讀法與標準 YAML(Obsidian 等)讀出來一模一樣嗎。
    只放行確定沒事的;拿不準的一律加引號(2026-09-26 代碼審 r1:原本只列「要加引號的」,
    漏了「空白 + #」被標準 YAML 當註解切掉、「- 」開頭被當清單)。"""
    return (v != "" and v == v.strip() and "\n" not in v and "\t" not in v
            and v[0] not in _YAML_PLAIN_BAD_START and ": " not in v and " #" not in v and not v.endswith(":")
            and v.lower() not in ("true", "false", "null", "yes", "no", "on", "off", "~")
            and not _YAML_TYPED_RE.fullmatch(v))


def _yaml_quote(v, what):
    """加引號,只用兩邊讀法一致的寫法:本工具讀的一側只剝掉頭尾一層引號、不解任何跳脫。
    雙引號在標準 YAML 裡會解反斜線跳脫 → 只在沒有反斜線、沒有雙引號時用;
    否則單引號(標準 YAML 裡除了 '' 以外一律照字面)→ 只在沒有單引號時用;兩種都不行就擋。"""
    if '"' not in v and "\\" not in v:
        return '"' + v + '"'
    if "'" not in v:
        return "'" + v + "'"
    raise ValueError(f"{what}「{v}」同時有單引號、又有雙引號或反斜線,工具寫不出本工具和 Obsidian 都讀得一樣的寫法,"
                     "檔案沒動;把其中一種引號換掉再寫")


def fmt_scalar(key, value):
    """純量值格式化。日期 bare(不加引號避污染指紋);含 ': ' 或特殊字元才引號。"""
    v = value.strip()
    if key in DATE_KEYS:
        if not DATE_RE.match(v):
            raise ValueError(f"{key} 要寫成 年-月-日(例如 2026-08-22),你給的是 {v}")
        return v  # bare,絕不加引號
    # YAML 型別劫持守衛: true/false/null/yes/no/~ 與純數字當 status 會被解析成 bool/num/null
    # YAML 型別劫持守衛(true/false/null/純數字會被讀成布林/空值/數字)也在白名單判斷裡
    return v if _yaml_plain_ok(v) else _yaml_quote(v, key)


def fmt_list_item(value):
    """list 項格式化。wikilink / 含特殊字元 → 引號(鐵則1 安全:一項一行)。"""
    v = value.strip()
    return v if _yaml_plain_ok(v) else _yaml_quote(v, "清單項")


def edit_fm_scalar(fm_lines, key, value):
    fm = list(fm_lines)
    formatted = fmt_scalar(key, value)
def _codeloop_print_dirty_bookkeeping(repo_root, status):
    """留痕之後,把「還沒提交的簿記檔」列成一行可直接貼的提交指令。

    ★不是新的閘,是把手打路徑清單換成工具列出來★(2026-09-21 同一天犯兩次):
    留痕前通常剛跑過 anchor approve,簽名檔因此變髒;人手打清單時漏掉它,
    推送會被「簽名檔改過了但沒提交」擋下——重複犯的是打字,不是判斷。
    清單沿用 _BOOKKEEPING_FILES / _BOOKKEEPING_DIRS,不自開第二份判準。
    """
    import subprocess as _sp
    # -uall:未追蹤的目錄預設會被摺成一行(例如只印 governance/),逐檔列才對得上白名單
    r = _sp.run(["git", "status", "--porcelain", "-z", "-uall"], cwd=str(repo_root),
                capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return
    dirty = []
    for rel in _porcelain_z_paths(r.stdout):
        # ★只列帳本檔本身,不列卷證目錄★(2026-09-21 自己試跑時踩到):
        # 把 _BOOKKEEPING_DIRS 一起算進來會列出 126 個檔,裡面全是別的 session 的
        # 審查卷證與舊的未提交證據——照貼會把別人的檔一起提交(同工作區夾帶風險)。
        # 卷證屬於功能提交,帳本檔才是留痕之後該單獨提交的東西。
        if rel in _BOOKKEEPING_FILES and rel not in dirty:
            dirty.append(rel)
    if not dirty:
        return
    msg = "chore(lumos): 記錄代碼審通過" if status == "passed" else "chore(lumos): 記錄代碼審跳過"
    print(f"  這幾個簿記檔還沒提交({len(dirty)} 個)——留痕之後只准提交它們,漏掉哪個推送都會被擋:")
    quoted = " ".join(_sh_quote(d) for d in dirty)
    print(f"    git commit -m '{msg}' -- {quoted}")


def _sh_quote(s):
    """路徑含空白或中文時照樣貼得上去。"""
    import shlex
    return shlex.quote(s)


def _codeloop_write(repo_root, branch, status, note, head_sha, ts):
    """寫 governance/code-loop/<branch>.json。"""
    import json
    safe = _codeloop_branch_filename(branch)
    d = Path(repo_root) / "governance" / "code-loop"
    d.mkdir(parents=True, exist_ok=True)
    rec = {"head_sha": head_sha, "status": status, "note": note, "ts": ts}
    (d / f"{safe}.json").write_text(
        json.dumps(rec, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


