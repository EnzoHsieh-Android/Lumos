+    try:
+        buf = io.StringIO()
+        ln = min(f["line"] for f in _df_find(v, "c1", "Verification/G.md"))
+        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
+            rc = m.cmd_drift_fix(m.Env(v), "Verification/G", ln, "c1",
