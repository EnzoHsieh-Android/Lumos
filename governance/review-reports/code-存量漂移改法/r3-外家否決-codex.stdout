 24920	def _notelines_rows(text, linenos, texts, keep_other, net):
 24921	    """一篇筆記裡算新寫的行 → [(行號, 行文字, 區塊)]。linenos:staged 的新增行號;texts:推送範圍逐提交新增的文字;
 24922	    net:回推送範圍淨差異新增行號的函式(只拿來核對開頭欄位其他欄,用到才呼叫)。"""
 24923	    lines = text.split("\n")
 24924	    regs = _notelines_regions(text)
 24925	    rows = []
 24926	    for i, ln in enumerate(lines, 1):
 24927	        if linenos is not None and i not in linenos:
 24928	            continue
 24929	        if texts is not None and ln.strip() not in texts:
 24930	            continue
 24931	        if not ln.strip() or (regs[i - 1] == "other" and not keep_other):
 24932	            continue
 24933	        if regs[i - 1] == "other" and net is not None and i not in net():
 24934	            continue
 24935	        rows.append((i, ln, regs[i - 1]))
 24936	    return rows
