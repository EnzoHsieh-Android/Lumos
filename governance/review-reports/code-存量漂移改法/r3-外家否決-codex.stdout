 24902	class _NotelinesNet:
 24903	    """範圍淨差異的新增行號,★用到才算★:只有開頭欄位其他欄真的有一行跟逐提交新增的文字對上時才跑那一次 diff
 24904	    (代碼審 r2 併發席:原本筆記形狀擋每次推送都固定多跑一次整個圖譜範圍的 diff)。git 失敗記 failed,呼叫端當場整次回 None。
 24905	    ★為什麼用旗標不回 None★(代碼審 r3 架構對齊席問過):它是以無參數函式傳進 _notelines_rows 的,那一層只回行清單、
 24906	    沒有失敗出口;要回 None 得改 rows 的回傳形狀與三個呼叫端,旗標只多呼叫端一行檢查。"""
 24907	
 24908	    def __init__(self, repo_root, base_where, tip_where, vault_rel):
 24909	        self.args, self._m, self.failed = (repo_root, base_where, tip_where, vault_rel), None, False
 24910	
 24911	    def lines(self, p):
 24912	        if self._m is None and not self.failed:
 24913	            repo_root, base_where, tip_where, vault_rel = self.args
 24914	            dn = _ns_diff(repo_root, base_where or _EMPTY_TREE_SHA, tip_where, "--", vault_rel)
 24915	            self.failed = dn is None
 24916	            self._m = {} if dn is None else {nfc(q): {n for n, _t in rows} for q, rows in _notelines_parse_added(dn).items()}
 24917	        return self._m.get(p, ())
