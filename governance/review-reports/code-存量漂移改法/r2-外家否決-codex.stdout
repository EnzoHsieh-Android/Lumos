 27816	def _drift_fix_c1(cx):
 27817	    """c1:已 pass 的守衛紀錄補改預告句(改句、前提、日期都在 guard 區段,這裡往下呼叫)。"""
 27818	    new, missing, day, err = _guard_pass_rewrite(cx["env2"], cx["root"], cx["repo_rel"], cx["lines"], cx["o"].get("date"))
 27819	    if err:
 27820	        return None, err
 27821	    names = "、".join(_GUARD_PROSE_NAMES[k] for k in missing)
 27822	    return {"new": new, "key": "status", "check": lambda f: str(f.get("status", "")) == "pass",
 27823	            "handled": _drift_no_kind("c1"), "extra": {}, "texts": [],
 27824	            "deps": _drift_deps(cx, [_guard_pass_home(cx["env2"], cx["lines"])[0]]),
 27825	            "msg": "預告句改成歷史說法" + (f"(轉正日期 {day})" if day else "") + (f";找不到{names},沒改" if names else "")}, None
