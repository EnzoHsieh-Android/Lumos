# ═══════════════════════════════════════════════════════════════════════════════════
# 存量漂移守衛(Projects/存量漂移防線_計劃;家 [[Systems/存量漂移守衛]])
# 已經寫進圖譜的句子,因為別處的狀態變了而過期——這裡是「甲」:狀態指令連帶處理(五種狀態一致檢查、
# 計劃收尾時列連帶待辦、推送時只擋「這次轉正、預告句還留著」)。「乙」(回頭條件改成機器能判的條件)接在後面。
# ═══════════════════════════════════════════════════════════════════════════════════
_DRIFT_CLOSED = ("done", "superseded")
_DRIFT_OPEN_ISSUE = ("open", "doing")
# c4 的關鍵詞。★清單裡刻意不放「工作樹」★:「釘在某提交的乾淨工作樹」是合法的可重現寫法,本來就不含這三個詞;
# 同一句裡同時有「未提交」與「工作樹」照樣成立(考卷 E3 就是這樣寫,設計審 r3 接手席)
_DRIFT_UNCOMMITTED_WORDS = ("未提交", "還沒提交", "uncommitted")
_DRIFT_KINDS = ("probe", "c1", "c2", "c3", "c4", "c5")
_DRIFT_KIND_NAMES = {"c1": "轉正了還寫預告", "c2": "計劃收尾了、連著的 Issue 還開著",
                     "c3": "計劃收尾了、驗證紀錄還待定", "c4": "前提寫「還沒提交」",
                     "c5": "轉正做了一半", "probe": "回頭條件成立了"}
_DRIFT_ACKS = "governance/drift-acks.jsonl"
# 修復帳(drift fix 每改一筆記一行稽核紀錄;存量漂移改法 第 7 節)。★稽核紀錄,不是還原工具★:要退回用 git;
# 帳也是乾淨檢查認得「工具自己的改動」的依據。進簿記檔名單 _BOOKKEEPING_FILES(那邊寫的是同一個字串)
_DRIFT_FIXES = "governance/drift-fixes.jsonl"
_DRIFT_FIX_KINDS = ("c1", "c2", "c3", "c4", "c5")
_DRIFT_BOUND_KINDS = ("c2", "c3")          # 表態要綁當時連著的已收尾計劃(related)與序號(seq)的種類
_DRIFT_GOLIVE_MARK = "drift check"
_DRIFT_GATE_VALUES = ("block", "warn", "off")
# ★沒寫設定時的預設★(計劃〈做法〉第 4 節第 4 點):三條門檻(考卷正例全對、工具鏈歷史重放不亂擋、噪音 ≤5)
# 都過才改成 block;還沒考就是 warn。
_DRIFT_DEFAULT_GATE = "warn"
_DRIFT_BUDGET_SEC = 60


def _drift_str(n, key):
    v = n.fields.get(key, "") if n is not None else ""
    return v.strip() if isinstance(v, str) else ""


def _drift_fm_end(lines):
    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
    if not lines or lines[0].strip() != "---":
        return 0
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return i
    return 0


def _drift_field_line(text, key, pred=None):
    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    for i in range(1, e):
        m = TOP_KEY_RE.match(lines[i])
        if not (m and m.group(1) == key):
            continue
        if pred is None:
            return i + 1
        for j in range(i, e):
            if j > i and TOP_KEY_RE.match(lines[j]):
                break
            if pred(lines[j]):
                return j + 1
        return i + 1
    return 1


def _drift_line_text(text, ln):
    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
    lines = text.split("\n")
    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""


def _drift_c3_hit(env, vrel, override=None, ti=None):
    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
    n = env.notes.get(vrel)
    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
        return None
    if GUARD_MARK_FIELD in n.fields:
        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
    if not refs:
        return None
    ti = ti if ti is not None else build_typed_index(env)
    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
    if any(not link_target(x) for x in refs) \
            or any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
        return None
    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
    if not plans:
        return None
    for prel in plans:
        pn = env.notes.get(prel)
        if pn is None or _drift_str(pn, "type") != "project":
            return None
        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
            return None
    return plans


def _drift_linked(env, rel):
    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
    out_e, in_e = env.edges
    got = {}
    for d in out_e.get(rel, []):
        got[d] = "out"
    for s in in_e.get(rel, []):
        got[s] = "both" if s in got else "in"
    return got


def _drift_state_findings(env, only=None):
    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
    only=要算的路徑集合(None=全部)。"""
    out = []
    ti = build_typed_index(env)
    for rel, n in sorted(env.notes.items()):
        if only is not None and rel not in only:
            continue
        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
            out += _drift_guard_findings(env, rel, n, st)
        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
            out += _drift_c2(env, rel)
        if ty == "verification":
            plans = _drift_c3_hit(env, rel, ti=ti)
            if plans:
                text = env_text(env, rel) or ""
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
        vu = n.fields.get("valid_under")
        vtxt = " ".join(as_list(vu)) if vu else ""
        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
            text = env_text(env, rel) or ""
            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
    return out


def _drift_c2(env, rel):
    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
             if _drift_str(env.notes.get(p), "type") == "project"
             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
    if not plans:
        return []
    text = env_text(env, rel) or ""
    ln = _drift_field_line(text, "status")
    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]


def _drift_guard_findings(env, rel, n, st):
    """守衛紀錄的 c1(轉正了還寫預告,一句一筆)與 c5(轉正做了一半)。"""
    text = env_text(env, rel)
    if text is None:
        return []
    out = []
    lines = text.split("\n")
    if st == "pass":
        regs = _notelines_regions(text)
        for i, ln in enumerate(lines):
            k = _guard_planned_prose(ln, regs[i])
            if k:
                out.append({"kind": "c1", "path": rel, "line": i + 1, "text": ln.strip(), "related": [],
                            "why": "已轉正(status: pass)但還留著預告句"})
    elif st == "pending":
        m = re.search(r"^預告的合約:(.+)$", text, re.M)
        home = env.resolve(link_target(_guard_home_of_fields(n.fields))) if _guard_home_of_fields(n.fields) else None
        htext = env_text(env, home) if home else None
        if m and htext is not None:
            hl = htext.split("\n")
            if _guard_formal_line(hl, _drift_fm_end(hl), m.group(1).strip(), None) is not None:
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c5", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [home],
                            "why": f"家筆記 {home[:-3]} 已經是正式合約行——重跑 lumos guard settle 補完"})
    return out


def _drift_plan_followups(env, rel, new_status):
    """lumos set <計劃> status done|superseded 要列的連帶待辦(計劃〈做法〉第 1 節第 3 點)→ [(種類, 路徑, 說明)]。
    只讀筆記、不跑 git、不寫;不是計劃或不是收尾狀態回 []。
    驗證紀錄走 build_typed_index 的反向索引(代碼審 r1 架構對齊席:不自己拿 env.resolve 猜同名第一篇);
    只寫檔名、同名猜不準的另列一項「猜不準」,讓人自己看。"""
    n = env.notes.get(rel)
    if n is None or _drift_str(n, "type") != "project" or new_status not in _DRIFT_CLOSED:
        return []
    out = []
    names = {"out": "計劃連到它", "in": "它連到計劃", "both": "互相連"}
    for p, d in sorted(_drift_linked(env, rel).items()):
        pn = env.notes.get(p)
        if _drift_str(pn, "type") == "issue" and _drift_str(pn, "status") in _DRIFT_OPEN_ISSUE:
            out.append(("Issue", p, f"{_drift_str(pn, 'status')},{names[d]}"))
    ti = build_typed_index(env)
    for p in sorted({s for s, et in ti["rev"].get(rel, []) if et == "plan_refs"}):
        if _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            out.append(("驗證紀錄", p, "pending,plan_refs 指的計劃都已收尾"))
    out += _drift_status_probe_followups(env, rel, new_status)
    for src, lit, et, cands in ti["ambiguous"]:
        sn = env.notes.get(src)
        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
    return out


def _drift_status_probe_followups(env, rel, new_status):
    """連帶待辦第③項(乙,[S15]):[when-status:<這份計劃>=…] 的 status 條件因這次收尾成立的回頭條件——只做文字比對,
    不跑 git;同一行還有別的條件時註明,不宣稱整行成立。env 是改之前的圖譜:舊狀態本來就在值裡的,條件早就成立,
    不是這次收尾造成的,不列(代碼審 r1 正確性席、外家席:doing→done 對 =doing|done 原本也說成因這次成立)。"""
    out = []
    old = _drift_str(env.notes.get(rel), "status")
    for p in sorted(env.notes):
        for no, _tx, pr in _probe_lines(env_text(env, p) or "")[0]:
            hit = [v for k, v in pr["conds"] if k == "status" and _probe_value_err(k, v) is None
                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
                   and new_status in (vals := {x.strip() for x in v.partition("=")[2].split("|")}) and old not in vals]
            if hit:
                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
    return out


def _drift_print_followups(env, rel, new_status):
    items = _drift_plan_followups(env, rel, new_status)
    if not items:
        return
    print(f"連帶待辦(這份計劃收尾了,下面 {len(items)} 篇連著它;只列出、不擋——連結有時只是參考,是不是該結案要人看):")
    ti = build_typed_index(env)
    for kind, p, why in items:
        print(f"  · {kind} {p[:-3]}({why})")
        print(f"      看:lumos context {p[:-3]}")
        if kind == "驗證紀錄" and _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            # c3 那一項給改法指令(存量漂移改法 [S10];單一產生處 _drift_fix_hint)
            ln = _drift_field_line(env_text(env, p) or "", "status")
            print(f"      改:{_drift_fix_hint('c3', p, ln)[0]}")


# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────

def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    pre = vault_rel.rstrip("/") + "/"
    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
    import time as _t
    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
    blobs = _drift_cat(root, where, paths, left) if paths else []
    if blobs is None:
        return None
    texts, bad = {}, []
    for p, b in zip(paths, blobs):
        if b is None:
            # 樹上列得出、內容讀不出來:建成讀不出的筆記(代碼審 r2 外家席:原本跳過,等於當成不存在)
            bad.append(p[len(pre):])
            continue
        try:
            texts[p[len(pre):]] = b.decode("utf-8-sig")
        except UnicodeDecodeError:
            bad.append(p[len(pre):])
    texts.update(override or {})
    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])


def _drift_vault_rel(root, where):
    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        return None
    wv = _vault_in(Path(root))
    try:
        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
    except ValueError:
        wv_rel = None
    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]


def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
    import time as _t
    pre = vault_rel.rstrip("/") + "/"
    if deadline is not None and _t.monotonic() > deadline:
        return None
    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _drift_empty_tree(root), tip, "--", vault_rel)
    if raw is None:
        return None
    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
               if x.strip("\n").startswith(pre)}
    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
              and _drift_str(n, "status") in _DRIFT_CLOSED}
    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "verification" and st == "pass",
                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
    if passed is None:
        return None
    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
    if closed is None:
        return None
    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}


def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None, override_base=None):
    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
    import time as _t

    def _left():
        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
    if tenv is None:
        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
    if _left() <= 0:
        return [], [], [over]
    reader = _nodehome_reader(root, tip)
    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
    if ev is None:
        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
               if _note_unreadable(n) and p in ev["touched"]]
    must, listed = [], []
    for f in _drift_state_findings(tenv):
        p, k = f["path"], f["kind"]
        if k == "c1":
            if p in ev["passed"]:
                must.append(f)
            continue
        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
        if hit:
            listed.append(f)
    if _left() <= 0:
        return must, listed, [*unknown, over]
    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
    return must + pm, listed + pl, unknown + pu



# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
_PROBE_KEYS = ("file", "symbol", "test", "status")
_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")


def _revisit_split(line):
    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
    import datetime
    if line.lstrip().startswith("|"):
        return None, None
    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
    if not s.startswith("REVISIT:"):
        return None, None
    rest = s[len("REVISIT:"):]
    if rest.lstrip().startswith("[when-"):
        return "cond", rest
    try:
        datetime.date.fromisoformat(rest.partition(" ")[0])
        return "date", rest
    except ValueError:
        return "bad", rest


def _revisit_lines(text):
    """一篇筆記的每一條回頭條件 → [(行號, 種類, 日期或 None, 摘要, 原文)];種類 date/cond/bad(同 _revisit_split)。
    剝程式碼區(_search_visible_lines)、餵剝過行內程式碼的那一版給 _revisit_split。doctor E5 與 set 把 Issue 結案時的列出
    共用這一支(存量漂移改法 第 6 節);乙的 _probe_lines、第一層、第二層各自的逐行迴圈不在這裡。"""
    out = []
    for no, raw, _pr in _search_visible_lines(text.split("\n"), False):
        kind, rest = _revisit_split(_strip_inline_markup(raw)[0])
        if kind is None:
            continue
        date, summ = None, ""
        if kind == "cond":
            date, summ = _probe_parse(rest)["by"], _PROBE_LEAD_RE.sub("", rest)
        elif kind == "date":
            date, _sp, summ = rest.partition(" ")
        out.append((no, kind, date, summ.strip(), raw))
    return out


def _issue_close_revisits(env, rel, new_status):
    """lumos set <Issue> status <結案值>、drift fix --kind c2 --close 之後:列出這篇★全部★回頭條件(不只到期的),
    提示結案了要改成結案說明或刪掉。只印、不擋、不改;行號用寫完之後從磁碟重讀的內容算(存量漂移改法 [S7])。"""
    n = env.notes.get(rel)
    if _drift_str(n, "type") != "issue" or str(new_status).strip() not in _ISSUE_CLOSED_STATUSES:
        return
    try:
        text = (env.vault / rel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        return
    rows = _revisit_lines(text)
    if not rows:
        return
    print(f"這篇 Issue 結案了,還留著 {len(rows)} 行回頭條件——要改成結案說明或刪掉(只列出、不擋):")
    for no, _k, _d, _s, raw in rows:
        print(f"  · {rel}:{no}  {_esc_clean(raw.strip(), 100)}")


def _probe_value_err(k, v):
    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
    if k not in _PROBE_KEYS:
        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
    if not v:
        return f"when-{k} 的值是空的"

    if k == "file":
        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
    if k in ("symbol", "test"):
        return _probe_named_err(k, v)
    node, eq, vals = v.partition("=")
    if not eq or not node.strip() or not vals.strip():
        return "when-status 要寫成 <節點>=<值>"
    if any(not x.strip() for x in vals.split("|")):
        return "when-status 的值用 | 分開時每一段都不能空"
    return None


def _probe_norm_value(k, v):
    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
    if k == "file":
        return nfc(_posix_norm(v))
    if k in ("symbol", "test") and "::" in v:
        path, name = v.rsplit("::", 1)
        return nfc(_posix_norm(path)) + "::" + name.strip()
    return v


def _probe_bad_path(p):
    return (not p) or p == "." or p.startswith("/") or ".." in p.split("/")


def _probe_named_err(k, v):
    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
    if "::" not in v:
        return None
    path, name = v.rsplit("::", 1)
    if not name.strip():
        return f"when-{k} 的名稱是空的"
    if _probe_bad_path(path.strip()):
        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
    return None


def _probe_parse(rest):
    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
    import datetime
    conds, by, errs, pos, bad = [], None, [], 0, False
    while True:
        m = _PROBE_TOKEN_RE.match(rest, pos)
        if not m:
            break
        pos = m.end()
        key, val = m.group(1), m.group(2).strip()
        if key == "by":
            if by is not None:
                errs.append("期限寫了兩個")
                continue
            try:
                datetime.date.fromisoformat(val)
                by = val
            except ValueError:
                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
            continue
        k = key[len("when-"):]
        # 反斜線先轉斜線再驗(代碼審 r3 正確性席:`a\..\x.py` 原本收成 x.py 過關,字面相同的 `a/../x.py` 卻被擋)
        err = _probe_value_err(k, val.replace("\\", "/") if k in ("file", "symbol", "test") else val)
        nv = val if err else _probe_norm_value(k, val)
        # 正規化之後再驗一次(代碼審 r2 正確性席、邊界席:`..\x.py` 原文用 / 切不出 .. 段,轉成斜線才是 ../x.py,
        # 原本第一層放行、check 與 scan 又默默丟掉,變成沒人看得到的死條件)
        err = err or _probe_value_err(k, nv)
        if err:
            errs.append(err)
            bad = True
        conds.append((k, val if err else nv))
    if not conds:
        errs.append("沒有條件標記")
    # bad:有條件寫錯——check 與 scan 看這個旗標決定評不評估,不拿存下來的值重驗(代碼審 r3 正確性席:寫錯的條件存的是
    # 原文,原文重驗可能過關,寫錯的行照樣被評估);只缺期限不算 bad,照評估
    return {"conds": conds, "by": by, "errs": errs, "bad": bad}


def _probe_lines(text):
    """一篇筆記的條件式回頭條件 → (清單[(行號, 原文, 解析結果)], 寫在不評估的地方[(行號, 原文, 原因)])。
    只認正文與摘要的可見行:圍欄(_visible_lines)、行內程式碼(_strip_inline_markup)、表格行裡的都不算;
    開頭欄位裡 summary 以外的欄與表格行裡的條件標記列成「寫在不評估的地方」(計劃〈做法〉第 0 節)。"""
    lines = text.split("\n")
    regs = _notelines_regions(text)
    vis = {no for no, _ln in _visible_lines(lines)}
    out, dead = [], []
    for i, ln in enumerate(lines, 1):
        if i not in vis:
            continue
        probe = _strip_inline_markup(ln)[0]
        table = probe.lstrip().startswith("|")
        if regs[i - 1] in ("body", "summary") and not table:
            kind, rest = _revisit_split(probe)
            if kind == "cond":
                out.append((i, ln.strip(), _probe_parse(rest)))
            continue
        if _PROBE_ANY_RE.search(probe):
            dead.append((i, ln.strip(), "寫在表格行裡,不評估" if table else "寫在開頭欄位裡 summary 以外的欄,不評估"))
    return out, dead


def _drift_probe_code_path(p):
    """乙拿來判 symbol/test、算候選的檔:副檔名在清單裡或沒副檔名(要看 #!),不含 docs/、governance/。
    候選篩選(_drift_probe_changes)與語料(_DriftProbeTree.corpus)共用這一支(代碼審 r1 圖譜一致席:原本兩邊範圍不同;
    正確性席:工具鏈主程式 scripts/lumos 沒有副檔名,原本整支不在語料裡,上面的 symbol 條件全是死條件)。"""
    return _nodehome_code_kind(p) in ("ext", "shebang?") and not p.startswith(("docs/", "governance/"))


def _drift_probe_is_py(p, txt):
    """要不要當 Python 檔用 ast 判:.py,或沒副檔名、首行是 python 的 #!(跟 _shebang_python_blob 共用首行判定——代碼審 r2
    架構對齊席:原本另寫一份,少了 #! 門檻、多了轉小寫)。"""
    return p.endswith(".py") or (_nodehome_code_kind(p) == "shebang?" and _shebang_line_is_python(txt.split("\n", 1)[0]))


def _drift_py_names(txt):
    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。"""
    import ast as _ast
    try:
        tree = _ast.parse(txt)
    except (SyntaxError, ValueError, MemoryError, RecursionError):
        # 巢狀很深的合法檔,CPython 的解析器丟 MemoryError(「too complex to parse」)而不是 SyntaxError,
        # 原本沒接住,整支 scan 與推送檢查當掉(代碼審 r2 邊界席)。3.12 以前的解析器碰到極長運算式會直接 SIGSEGV、
        # 接不到;工具最低版本改成 3.14 之後,原本為它加的事先量測已刪([[Projects/最低Python版本改3.14_計劃]])
        return None
    funcs, classes, assigns = set(), set(), set()
    for node in _ast.walk(tree):
        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
            funcs.add(node.name)
        elif isinstance(node, _ast.ClassDef):
            classes.add(node.name)
    for node in tree.body:
        if isinstance(node, _ast.Assign):
            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
            assigns.add(node.target.id)
    return funcs, classes, assigns


def _drift_py_def_re(name, test):
    """解析不了的 Python 檔退回逐行正則(寧可多認一次,也不讓一支語法壞掉的檔讓整批條件判不了)。"""
    n = re.escape(name)
    if test:
        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)


def _drift_disk_list(root):
    """工作目錄裡的路徑 → (一般檔集合, 所有路徑) 或 None:index 加上沒追蹤(沒被忽略)的,扣掉磁碟上已經不在的
    (代碼審 r1 外家席:scan 預設看工作目錄,原本卻讀 index,沒追蹤的新檔判成不存在、刪了沒 stage 的判成還在)。"""
    lst = _nodehome_list(root, "index")
    raw = _nodehome_git(root, "ls-files", "--others", "--exclude-standard", "-z") if lst is not None else None
    if raw is None:
        return None
    base = Path(root)
    allp = sorted(set(lst[1]) | {nfc(os.fsdecode(p)) for p in raw.split(b"\0") if p})
    allp = [p for p in allp if os.path.lexists(base / p)]
    files = {p for p in allp if (base / p).is_file() and not (base / p).is_symlink()}
    return files, allp


_DRIFT_LS_CACHE = {}
_DRIFT_OID_CACHE = {}   # 跟 _DRIFT_LS_CACHE 同鍵同壽命:列檔那一次順便記的內容編號


def _drift_list(root, where):
    """_nodehome_list 加記憶:同一個提交的樹一次 check 裡只列一次(代碼審 r1 併發席:終點列 2 次、起點列 3 次)。
    只記完整提交編號(內容不會變;SHA-1 的 40 碼與 SHA-256 的 64 碼都算——r4 外家席:原本只認 40 碼,SHA-256 的 repo
    記不到內容編號、退回用路徑讀,怪檔名又讀不到);index 與其他寫法照舊每次列。"""
    if not (isinstance(where, str) and _LENS_SHA_RE.fullmatch(where)):
        return _nodehome_list(root, where)
    key = (str(root), where)
    if key not in _DRIFT_LS_CACHE:
        oids = {}
        got = _nodehome_list(root, where, oids=oids)
        if got is None:
            return None
        _DRIFT_OID_CACHE[key] = oids
        # ★有上限,跟本檔其他模組層快取不同★(代碼審 r2 架構對齊席問過):那幾支的鍵是 repo 或圖譜,一次呼叫裡天然有界;
        # 這支的鍵是提交編號,drift exam --history 一次走上百個提交,不設上限會跟著提交數長。一次 check 只用到起點與終點兩個。
        if len(_DRIFT_LS_CACHE) >= 8:
            _DRIFT_LS_CACHE.clear()
            _DRIFT_OID_CACHE.clear()
            _DRIFT_OID_CACHE[key] = oids
        _DRIFT_LS_CACHE[key] = got
    return _DRIFT_LS_CACHE[key]


def _drift_oids(root, where):
    """那個提交的 {NFC 路徑: 內容編號};列不出或不是完整提交編號回 {}(呼叫端退回用「版本:路徑」讀)。"""
    if _drift_list(root, where) is None:
        return {}
    return _DRIFT_OID_CACHE.get((str(root), where), {})


def _drift_decode(b):
    """程式檔的 bytes → 文字:去 BOM(全庫讀取器都用 utf-8-sig;代碼審 r2 正確性席、邊界席:原本 BOM 留在開頭,
    python3.9 的 ast 解析失敗退回正則、docstring 範例又被當定義,沒副檔名的 #! 腳本整支不進語料),解不開的位元組換掉。"""
    return b.decode("utf-8-sig", errors="replace")


def _drift_cat(root, where, paths, timeout):
    """批次讀那個提交裡的這幾支檔,回同順序的 bytes|None;git 跑不起來回 None。★用列檔時記下的內容編號讀★,
    不用「版本:路徑」:樹清單把路徑轉成 NFC 了,git 裡存的可能是 NFD、兩種混用、或相容表意字(NFC 與 NFD 都會把它換掉),
    用路徑讀永遠讀不到;路徑含換行時批次讀也整批失敗(代碼審 r2 外家席、r3 正確性席、邊界席;r2 的 NFD 重讀補不到混用
    與相容表意字,還多開一次行程、沿用整段逾時——r3 併發席、外家席、架構對齊席)。查不到編號的才退回用路徑讀。"""
    oids = _drift_oids(root, where)
    return _nodehome_cat_blobs(root, [oids.get(p) or f"{where}:{p}" for p in paths], timeout=timeout)


def _drift_cond_split(v):
    """symbol/test 條件的值 → (路徑或空字串, 名稱)。判定、預讀、候選篩選、判不了的點名共用這一支
    (代碼審 r5 架構對齊席:原本四處各自 rsplit,點名的範圍跟判定的範圍連三輪對不上)。"""
    path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
    return path.strip(), name.strip()


def _drift_status_target(env, v):
    """status 條件 → (指到的筆記相對路徑或 None, 筆記或 None, 允許的狀態集合)。判定與點名共用。"""
    node, _eq, vals = v.partition("=")
    rel = env.resolve(link_target(node.strip())) if env is not None else None
    return rel, (env.notes.get(rel) if rel else None), {x.strip() for x in vals.split("|")}


_DRIFT_EMPTY_TREE = {}


def _drift_empty_tree(root):
    """這個 repo 的空樹編號:SHA-256 的 repo 跟 SHA-1 的不一樣(代碼審 r5 外家席、正確性席:寫死 SHA-1 的空樹,
    SHA-256 repo 首推時 git diff 認不得、一律判不了)。算不出來退回 SHA-1 那個。全工具其他閘的同一個問題另開 Issue。"""
    import subprocess as _sp
    key = str(root)
    if key not in _DRIFT_EMPTY_TREE:
        try:    # 明確餵空輸入:在推送掛鉤裡繼承標準輸入會去讀掛鉤自己的 ref 清單
            r = _sp.run(["git", "-C", key, "hash-object", "-t", "tree", "--stdin"], input=b"", capture_output=True, timeout=20)
            got = r.stdout.decode("ascii", "replace").strip() if r.returncode == 0 else ""
        except (OSError, _sp.TimeoutExpired):
            got = ""
        _DRIFT_EMPTY_TREE[key] = got if _LENS_SHA_RE.fullmatch(got) else _EMPTY_TREE_SHA
    return _DRIFT_EMPTY_TREE[key]

