 27438	    守衛紀錄的預告句是樣板,兩篇會一字不差,原本會把 A 的理由印給從沒表態過的 B)。"""
 27439	    for a in reversed(acks):
 27440	        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
 27441	            if alive is not None and nfc(str(a.get("path"))) in alive:
 27442	                continue
 27443	            return a.get("reason")
 27444	    return None
