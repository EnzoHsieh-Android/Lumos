_PITFALL_DIFF_TEST_PAT = re.compile(r"(test_|_test\.|\.spec\.|/tests?/)", re.I)
LINT_CMD_TIMEOUT = 180


def _diff_added_lines(diff_text):
            if ok is None:
                probs.append((p, no, tx, "判不了(超過預算)" if _over() else
                              "判不了(git 讀不出程式檔或筆記" + _drift_bad_note(_drift_row_unread(pr["conds"], (nenv,), (tree,))) + ")"))
            elif ok:
