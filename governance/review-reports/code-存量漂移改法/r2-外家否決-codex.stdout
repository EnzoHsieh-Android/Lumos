 succeeded in 0ms:
            i += 1
            continue
        fields[key] = sval
        if "]], [[" in sval or "]],[[" in sval or (key in LIST_KEYS and _multi_link_value(sval)):
            lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key}")
        i += 1
    for line in fm_lines:
        if QUOTED_DATE_RE.match(line):
            lint.append(f"日期加了引號會被當成文字、排序比較都失效,引號拿掉: {line.strip()}")
    return fields, block_keys, lint


def extract_targets(text):
    out = []
    for raw in WIKILINK_RE.findall(text):
        t = raw.split("|")[0].split("#")[0].strip()
        if t:
            out.append(nfc(t))
    return out


class Note:
    __slots__ = ("rel", "stem", "fields", "block_keys", "fm_lines",
                 "targets", "lint", "mtime")


def load_vault(vault: Path):
    notes = {}
    for p in sorted(vault.rglob("*.md")):
        rel = nfc(p.relative_to(vault).as_posix())
        try:
            mtime = p.stat().st_mtime
            text = p.read_text(encoding="utf-8-sig")  # -sig: BOM 檔也偵測得到 frontmatter
        except Exception as e:
            n = Note()
            n.rel, n.stem = rel, nfc(p.stem)
            n.fields, n.block_keys, n.fm_lines = {}, set(), []
            n.targets, n.lint, n.mtime = [], [f"{_READ_FAIL}: {e}"], 0
            notes[rel] = n
            continue
        notes[rel] = _note_from_text(rel, text, mtime)
    return notes


_READ_FAIL = "讀檔失敗"      # 讀不進來的筆記在 Note.lint 的前綴:磁碟(load_vault)與提交的樹(Env.from_texts)共用這一個管道


def _note_unreadable(n):
    return any(str(x).startswith(_READ_FAIL) for x in (n.lint or []))


def _note_from_text(rel, text, mtime=0):
    """一篇筆記的文字 → Note。load_vault 與「某個提交的樹」共用(存量漂移防線_計劃:狀態一致檢查要能跑在
    任一提交上,不另寫第二套解析)。"""
    n = Note()
    n.rel = rel
    n.stem = nfc(rel.rsplit("/", 1)[-1][:-3] if rel.endswith(".md") else rel.rsplit("/", 1)[-1])
    n.mtime = mtime
    fm_lines, body = split_frontmatter(text)
    if fm_lines is not None:
        fields, block_keys, lint = parse_frontmatter(fm_lines)
    else:
        fm_lines, fields, block_keys, lint = [], {}, set(), []
    body_clean = _strip_code_text(body)   # ★不可換回 FENCE_RE:看不見未閉合圍欄→幽靈邊★
    # frontmatter 連結規則(對齊 Obsidian): 整個值恰為一個 wikilink 才索引,
    # 夾在散文中間的 [[..]] 不算;block scalar 整段排除(鐵則 2)
    fm_targets = []
    for key, v in fields.items():
        if key in block_keys:
            continue
        for item in (v if isinstance(v, list) else [v]):
            s = str(item).strip()
            fm = _SINGLE_WIKILINK_RE.fullmatch(s)
            if fm:
                t = fm.group(1).split("|")[0].split("#")[0].strip()
                if t:
                    fm_targets.append(nfc(t))
    n.fields = fields
    n.block_keys = block_keys
    n.fm_lines = fm_lines
    n.targets = extract_targets(body_clean) + fm_targets
    n.lint = lint
    return n


def build_index(notes):
    by_stem = defaultdict(list)
    for rel, n in notes.items():
        by_stem[n.stem.lower()].append(rel)
    return by_stem


def make_resolver(notes, by_stem):
    rels = set(notes)

    def resolve(target):
        t = target
        if t.lower().endswith(".md"):
            t = t[:-3]
        if "/" in t:
            cand = t + ".md"
            if cand in rels:
                return cand
            t = t.rsplit("/", 1)[1]
        hits = by_stem.get(t.lower())
        if hits:
            return hits[0]
        return None

    return resolve


def as_list(v):
    if v is None:
        return []
    if isinstance(v, list):
        return [str(x) for x in v]
    return [str(v)]


class Env:
    def __init__(self, vault):
        self.vault = vault
        self.notes = load_vault(vault)
        self.by_stem = build_index(self.notes)
        self.resolve = make_resolver(self.notes, self.by_stem)
        self._edges = None
        self._texts = None

    @classmethod
    def from_texts(cls, vault, texts, unreadable=()):
        """{圖譜內相對路徑: 全文} → 只在記憶體裡的 Env(某個提交的樹、或考試時改過狀態的樹)。
        讀全文用 env_text,不要自己開檔——這種 Env 的檔不在磁碟上。unreadable=解不開的路徑:照 load_vault 讀檔失敗的
        做法建成 lint 帶「讀檔失敗」的空筆記(代碼審 r3 架構對齊席:同一件事不另開第二個管道)。"""
        self = cls.__new__(cls)
        self.vault = vault
        self._texts = {nfc(r): t for r, t in texts.items()}
        # 照路徑逐層排序,跟 load_vault 的 Path 排序一致(代碼審 r1 正確性席:整串字串排序時 Projects-old/X
        # 會排在 Projects/X 前面,同名筆記在磁碟與樹上解到不同篇)
        notes = {r: _note_from_text(r, t) for r, t in self._texts.items()}
        for r in unreadable:
            n = Note()
            n.rel, n.stem, n.mtime = nfc(r), nfc(r.rsplit("/", 1)[-1][:-3]), 0
            n.fields, n.block_keys, n.fm_lines, n.targets, n.lint = {}, set(), [], [], [f"{_READ_FAIL}: 不是 UTF-8"]
            notes[n.rel] = n
        self.notes = dict(sorted(notes.items(), key=lambda kv: kv[0].split("/")))
        self.by_stem = build_index(self.notes)
        self.resolve = make_resolver(self.notes, self.by_stem)
        self._edges = None
        return self

    @property
    def edges(self):
        if self._edges is None:
            out_e, in_e = defaultdict(list), defaultdict(list)
            for rel, n in self.notes.items():
                seen = set()
                for t in n.targets:
                    d = self.resolve(t)
                    if d and d != rel and d not in seen:
                        seen.add(d)
                        out_e[rel].append(d)
                        in_e[d].append(rel)
            self._edges = (out_e, in_e)
        return self._edges

    def find(self, arg):
        """以 stem 或相對路徑找筆記,回傳 rel 或 None"""
        a = nfc(arg.strip())
        if a.lower().endswith(".md"):
            a = a[:-3]
        if "/" in a and (a + ".md") in self.notes:
            return a + ".md"
        hits = self.by_stem.get(a.rsplit("/", 1)[-1].lower())
        if hits:
            if len(hits) > 1:
                print(f"⚠ 同名筆記 {len(hits)} 個,取第一個: {hits[0]}", file=sys.stderr)
            return hits[0]
        return None


def env_text(env, rel):
    """一篇筆記的全文:記憶體裡的 Env 從記憶體拿,一般的從磁碟讀。讀不到回 None。"""
    t = getattr(env, "_texts", None)
    if t is not None:
        return t.get(rel)
    try:
        return (env.vault / rel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        return None


def first_line(s, width=72):
    s = (s or "").strip().split("\n")[0]
    return s if len(s) <= width else s[:width] + "…"


def status_of(env, rel):
    v = env.notes[rel].fields.get("status", "")
    return v if isinstance(v, str) else ""


TYPED_EDGE_FIELDS = ("verified_by", "plan_refs", "related")


def build_typed_index(env):
    """[M2/P0] typed-edge 反向索引——從 frontmatter 具名欄位(verified_by/plan_refs/related)建
    「每節點 ← 誰、以哪種邊型指向我」。補 Env.edges 無型別的洞(建圖層以 target 去重丟來源欄位)。
    每次呼叫現建現用(天生新鮮、無持久化=無腐爛)。合約(關係層主網 M2):
    - 只索引「整個值恰為一個 wikilink」(沿 load_vault fm_targets 規則);殘留 scalar → scalars
      warnings、不進索引(不靜默納入)。block scalar 欄位整段排除(鐵則 2)。
    try:
        raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else b""
    except OSError:
        raw = b""
    return _drift_jsonl_parse(raw)


def _drift_next_seq(root, rel):
    """帳檔現有最大 seq 加 1(沒有就從 1 開始);檔內的遞增序號,不是時間。呼叫端要拿著寫入鎖。"""
    return max((_drift_ack_seq(d) for d in _drift_jsonl_rows(Path(root) / rel)), default=0) + 1


def _drift_ledger_path_err(root, rel):
    """帳檔寫入前的路徑檢查 → 錯誤或 None:從 repo 根往下到帳檔的每一層都不是符號連結(repo 根以上不管;
    逐層查照 _mkdir_trusted_under_home 的寫法)、解析後的真實路徑在 repo 根底下、帳檔已存在時硬連結數是 1。
    檢查後到寫入前的時間差不處理(存量漂移改法〈誠實界線〉)。"""
    rootp = Path(root)
    cur = rootp
    try:
        for seg in Path(rel).parts:
            cur = cur / seg
            if cur.is_symlink():
                return f"{cur} 是符號連結——帳檔與它在 repo 裡的上層目錄都要是一般的檔案與目錄,不往裡寫"
        fp = rootp / rel
        if not fp.resolve().is_relative_to(rootp.resolve()):
            return f"{fp} 解析後不在 repo 底下,不往裡寫"
        if fp.exists() and fp.stat().st_nlink != 1:
            return f"{fp} 有別的硬連結指著同一個檔,不往裡寫"
    except OSError as ex:
        return f"查不了 {cur}:{ex}"
    return None


def _drift_ledger_append(root, rel, rec):
    """表態檔與修復帳共用的追加(存量漂移改法 第 7 節):①路徑檢查 ②檔尾不是換行先補一個 ③交給 _jsonl_append_verified
    追加並讀回自驗。不改其他帳共用的 _jsonl_append_verified。回 rc。"""
    fp = Path(root) / rel
    err = _drift_ledger_path_err(root, rel)
    if err is None:
        try:
            fp.parent.mkdir(parents=True, exist_ok=True)
        except OSError as ex:
            err = f"建不了 {fp.parent}:{ex}"
    err = err or _drift_ledger_path_err(root, rel)
    if err is None:
        try:
            if fp.is_file() and fp.stat().st_size > 0:
                with open(fp, "rb") as fh:
                    fh.seek(-1, 2)
                    tail = fh.read(1)
                if tail != b"\n":
                    with open(fp, "a", encoding="utf-8") as fh:
                        fh.write("\n")
        except OSError as ex:
            err = f"補不了檔尾換行:{ex}"
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    return _jsonl_append_verified(fp, rec, "id", rec["id"])


