 27797	def _drift_deps(cx, rels):
 27798	    """判定依賴的其他筆記(c1、c5 的家節點)此刻的位元組 → [(路徑, 位元組)];寫入時在鎖內再比一次,判定之後被改過就不寫
 27799	    (代碼審 r1 併發席:鎖內原本只比守衛紀錄那一篇)。建圖譜物件到這裡的時間差不處理(〈誠實界線〉)。"""
 27800	    out = []
 27801	    for r in rels:
 27802	        if not r:
 27803	            continue
 27804	        p = _drift_phys(cx["env2"].vault, r)
 27805	        try:
 27806	            out.append((p, p.read_bytes()))
 27807	        except OSError:
 27808	            out.append((p, None))
 27809	    return out
