 27743	def _drift_phys(vault, rel):
 27744	    """索引鍵 → 磁碟上的實際路徑。load_vault 把檔名正規化成 NFC 當鍵,實際追蹤 NFD 拼法的檔直接拿鍵開會找不到
 27745	    (代碼審 r1 外家席);逐層找 NFC 相同的名字,找不到就回原路徑讓呼叫端照常報錯。"""
 27746	    p = Path(vault) / rel
 27747	    if p.exists():
 27748	        return p
 27749	    cur = Path(vault)
 27750	    for seg in Path(rel).parts:
 27751	        nxt = cur / seg
 27752	        if not nxt.exists():
 27753	            try:
 27754	                nxt = next((c for c in cur.iterdir() if nfc(c.name) == nfc(seg)), nxt)
 27755	            except OSError:
 27756	                return p
 27757	        cur = nxt
 27758	    return cur
 27759	
