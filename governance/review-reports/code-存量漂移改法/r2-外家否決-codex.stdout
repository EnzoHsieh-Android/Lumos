 27728	def _drift_fix_clean_err(root, repo_rel, raw):
 27729	    """乾淨檢查 → 錯誤或 None:那一篇要在 git 裡有追蹤,而且跟 HEAD 沒差,或現在的指紋等於修復帳裡這一篇最後一筆的
 27730	    after_sha256(改動全是工具自己留下的,同一篇可以一項一項修、修完一起提交)。"""
 27731	    import hashlib
 27732	    gp = _guard_raw_git_path(root, repo_rel)
 27733	    if gp is None:
 27734	        return f"{repo_rel} 沒被 git 追蹤(或 git 查不到)——不在版控裡,改壞了退不回來;先提交"
 27735	    r = _lens_git(root, "diff", "--quiet", "HEAD", "--", gp)
 27736	    if r is None or r.returncode not in (0, 1):
 27737	        return "git 查詢失敗或逾時(git diff HEAD),查不出這一篇乾不乾淨"
 27738	    if r.returncode == 0 or _drift_fix_last_sha(root, repo_rel) == hashlib.sha256(raw).hexdigest():
 27739	        return None
 27740	    return f"{repo_rel} 有未提交的改動(不是 drift fix 自己留下的)——先提交或還原再修"
