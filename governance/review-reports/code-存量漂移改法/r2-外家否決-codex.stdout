 27447	def _drift_ack_args_err(kind, reason):
 27448	    if kind not in _DRIFT_KINDS:
 27449	        return f"--kind 只能是 {'/'.join(_DRIFT_KINDS)}"
 27450	    if len((reason or "").strip()) < 4 or not _drift_one_line(reason or ""):
 27451	        return "--reason 要寫為什麼照留,一行、至少 4 個字"
 27452	    return _drift_placeholder_err(reason, "--reason")
