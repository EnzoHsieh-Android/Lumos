 28168	def _drift_fix_record(env, cx, res):
 28169	    """第 7 步:寫修復帳(稽核紀錄)、記治理事件。帳寫不進去回 2,不動筆記。"""
 28170	    import datetime, hashlib, secrets
 28171	    rec = {"id": "DFIX-" + secrets.token_hex(4), "date": datetime.date.today().isoformat(), "path": cx["repo_rel"],
 28172	           "line": cx["line"], "kind": cx["kind"], "changed": _drift_fix_changes(cx["lines"], res["new"]),
 28173	           "after_sha256": hashlib.sha256("\n".join(res["new"]).encode("utf-8")).hexdigest(), **res["extra"]}
 28174	    want = "\n".join(res["new"]).encode("utf-8")
 28175	    moved = False
 28176	    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "ledger":
 28177	        rc = 2
 28178	    else:
 28179	        with _vault_write_lock(env.vault):
 28180	            # 驗證在鎖外,記帳前在鎖內再比一次:帳上的指紋要是記帳那一刻磁碟上的內容(代碼審 r1 外家席)
 28181	            try:
 28182	                if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "moved":   # 故障注入:模擬別人在驗證與記帳之間改了這一篇
 28183	                    cx["path"].write_bytes(want + b"\n")
 28184	                moved = cx["path"].read_bytes() != want
 28185	            except OSError:
 28186	                moved = True
 28187	            if moved:
 28188	                rc = 2
 28189	            else:
 28190	                rec["seq"] = _drift_next_seq(cx["root"], _DRIFT_FIXES)
 28191	                rc = _drift_ledger_append(cx["root"], _DRIFT_FIXES, rec)
 28192	    if rc != 0:
 28193	        why = ("寫好、驗過之後這一篇又被別人改了,修復帳沒記(帳上的指紋要是記帳那一刻的內容)" if moved
 28194	               else "筆記已改好,但修復帳沒記到")
 28195	        print(f"擋下:{why};{_esc_clean(cx['repo_rel'], 200)} 的改動用 git diff 看得到——確認沒問題就直接提交"
 28196	              "(修復帳只是稽核紀錄,少這一筆不影響之後的修;沒提交之前,同一篇的下一項 drift fix 會因為指紋對不上帳而擋下);"
 28197	              f"要退就 git checkout -- {_drift_sh(cx['repo_rel'])}", file=sys.stderr)
 28198	        return 2
 28199	    _gate_event_or_warn(cx["root"], "drift-check", "fix", f"{cx['rel']}:{cx['line']} {cx['kind']}({rec['id']})")
 28200	    return 0
