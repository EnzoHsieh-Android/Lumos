 28203	def cmd_drift_fix(env, node, line, kind, o):
 28204	    """lumos drift fix <節點> <行號> --kind c1..c5 [--dry-run] [種類專屬參數](Projects/存量漂移改法_計劃 第 1 節)。
 28205	    順序:乾淨檢查 → 鎖外讀與判定、前提、git 查詢 → 算改後內容、自由文字先過形狀擋 → (--dry-run 到此)→
 28206	    鎖內比指紋寫入 → 鎖外驗證磁碟內容與「已處理」→ 寫修復帳。不自動還原:改之前保證了 git 退得回來。"""
 28207	    err = _drift_fix_args_err(kind, o)
 28208	    rel = None
 28209	    if err is None:
 28210	        rel, err = _drift_fix_target(env, node)
 28211	    if err is None and kind == "c2" and o.get("keep"):
 28212	        return cmd_drift_ack(env, rel, line, "c2", o["reason"], dry_run=bool(o.get("dry_run")))   # 照留:等同帶清單的 c2 表態
 28213	    cx = None
 28214	    if err is None:
 28215	        cx, err = _drift_fix_load(env, rel, line, kind, o)
 28216	    res = None
 28217	    if err is None:
 28218	        res, err = _DRIFT_FIX_COMPUTE[kind](cx)
 28219	        if err is None and res is None:
 28220	            return 0                                                 # c4 只列證據與範本
 28221	    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
 28222	    if err is None and o.get("dry_run"):
 28223	        _drift_fix_preview(cx, res)
 28224	        return 0
 28225	    # 帳檔路徑在寫筆記之前先查(代碼審 r1 邊界席:原本寫完筆記才發現帳寫不進去,留下改了筆記、沒帳、又不讓重跑的狀態)
 28226	    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
 28227	    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
 28228	    if err:
 28229	        print(f"擋下:{err}", file=sys.stderr)
 28230	        return 2
