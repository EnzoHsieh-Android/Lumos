 27783	def _drift_fm_status(lines, fe, status):
 27784	    """開頭欄位的 status 改掉、同步 status/* 標籤(同 cmd_set)→ (新的開頭欄位行, 寫後自驗)。"""
 27785	    fm = edit_fm_scalar(lines[1:fe], "status", status)
 27786	    fm, synced = edit_fm_sync_status_tag(fm, status)
 27787	    want = strip_quotes(fmt_scalar("status", status))
 27788	
 27789	    def _ok(f):
 27790	        if str(f.get("status", "")) != want:
 27791	            return False
 27792	        tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
 27793	        return (not synced) or (f"status/{want}" in tags and all(t == f"status/{want}" for t in tags if t.startswith("status/")))
 27794	    return fm, _ok
