 28132	def _drift_fix_write(env, cx, res):
 28133	    """第 5 步(鎖內):從磁碟重讀,指紋要等於判定時的才寫(atomic_write_verify);寫入例外一律轉成錯誤。"""
 28134	    try:
 28135	        with _vault_write_lock(env.vault):
 28136	            if cx["path"].read_bytes() != cx["raw"]:
 28137	                return "判定之後這一篇被改過,沒寫;重跑一次"
 28138	            for dp, db in res.get("deps", []):
 28139	                try:
 28140	                    now = dp.read_bytes()
 28141	                except OSError:
 28142	                    now = None
 28143	                if now != db:
 28144	                    return f"判定之後它依賴的 {_esc_clean(str(dp.name), 120)} 被改過,沒寫;重跑一次"
 28145	            atomic_write_verify(cx["path"], res["new"], res["key"], res["check"])
 28146	    except (ValueError, RuntimeError, OSError) as ex:
 28147	        return f"寫不進去,筆記沒動:{ex}"
 28148	    return None
