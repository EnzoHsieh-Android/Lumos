 27828	_DRIFT_BANNER_RE = re.compile(r"^(?:>\s*)?(?:\*\*)?已結案(?:\*\*)?\s*[(（:：]")
 27829	
 27830	
 27831	def _drift_close_banner(body, banner):
 27832	    """正文第一個 `# ` 標題之後、第一段之前加結案橫幅 → (新的正文行, 原本就有橫幅)。
 27833	    標題只在圍欄外找(圍欄裡的 `# comment` 不算,代碼審 r1 邊界席);已有橫幅只認「已結案」後面接括號或冒號的形狀,
 27834	    「已結案通知功能仍會重複寄信」這種正文不算(外家席)。"""
 27835	    vis = {n - 1 for n, _ln in _visible_lines(body)}
 27836	    h = next((i for i, ln in enumerate(body) if i in vis and ln.startswith("# ")), None)
 27837	    start = 0 if h is None else h + 1
 27838	    j = start
 27839	    while j < len(body) and not body[j].strip():
 27840	        j += 1
 27841	    if j < len(body) and _DRIFT_BANNER_RE.match(body[j]):
 27842	        return body, True
 27843	    if h is None:
 27844	        return [banner, "", *body], False
 27845	    if j > start:
 27846	        return [*body[:j], banner, "", *body[j:]], False
 27847	    return [*body[:start], "", banner, "", *body[start:]], False
 27848	
