                rc = cmd_set(env, rel, args.key, args.value)
                if rc == 0 and args.key == "status":
                    # 計劃收尾時列連帶待辦(存量漂移防線 [S6]):只多印、不擋、不寫;env 是改之前載入的,連結沒變
                    _v = args.value[0] if isinstance(args.value, list) and len(args.value) == 1 else args.value
                    _drift_print_followups(env, rel, str(_v).strip())

