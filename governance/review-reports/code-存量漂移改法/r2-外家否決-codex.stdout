def _guard_prose_ops(lines):
    """守衛紀錄裡的預告句 → [(行索引, 種類)]。種類:test/why/why-done/whynot/settle,
    settle 句下一個非空行已是手補的「已轉正」段時記 settle-del(刪掉 settle 句那一行)。"""
    regs = _notelines_regions("\n".join(lines))
    ops = []
    for i, ln in enumerate(lines):
        k = _guard_planned_prose(ln, regs[i] if i < len(regs) else "body", settled_ok=True)
        if k == "settle" and _guard_manual_settled_after(lines, i):
            k = "settle-del"
        if k is not None:
            ops.append((i, k))
    return ops


def _guard_prose_needs_date(ops):
    """改句要不要寫日期:TEST、WHY 兩句與換成「(日期 已轉正)」的 settle 句要;只改「為什麼還不做:」或刪 settle 句不要。"""
    return any(k in ("test", "why", "settle") for _i, k in ops)


def _guard_settle_rewrite(lines, today, home_link):
    """守衛紀錄(已改成 pass 的行)→ (改寫後的行, 找不到的句型)。只動四種預告句,其他行一字不動。
    settle 句下一個非空行已是手補的「已轉正」段:刪掉 settle 句那一行(連同緊接的一個空行),算處理過、不進 missing
    ——pending 轉正與 pass 補改走同一支,同一種句子不因入口不同而結果不同(存量漂移改法 第 2 節)。
    today 只在要寫日期時用得到(見 _guard_prose_needs_date)。"""
    ops = dict(_guard_prose_ops(lines))
    out, seen, skip = [], set(), set()
    for i, ln in enumerate(lines):
        if i in skip:
            continue
        k = ops.get(i)
        if k is None:
            out.append(ln)
            continue
        seen.add({"why-done": "why", "settle-del": "settle"}.get(k, k))
        ind = ln[:len(ln) - len(ln.lstrip())]
        if k == "test":
            out.append(f"{ind}TEST:[{today}] 預告已轉正,合約改由 [[{home_link}]] 的正式合約行守")
        elif k == "why":
            out.append(f"{ln.rstrip()}({today} 已轉正)")
        elif k == "whynot":
            out.append(f"{ind}預告當時{ln.lstrip()}")
        elif k == "settle":
            out.append(f"{ind}({today} 已轉正)")
        elif k == "settle-del":
            if i + 1 < len(lines) and not lines[i + 1].strip():
                skip.add(i + 1)
        else:
            out.append(ln)
    return out, [k for k in _GUARD_PROSE_KINDS if k not in seen]


def _guard_date_arg(s):
    """--date 的值 → (日期字串, 錯誤)。格式要 YYYY-MM-DD、不晚於今天。"""
    import datetime
    try:
        d = datetime.date.fromisoformat(str(s).strip())
    except ValueError:
        return None, f"--date 要寫成 YYYY-MM-DD,你給的是 {s!r}"
    if d > datetime.date.today():
        return None, f"--date {d.isoformat()} 晚於今天,轉正日期不能是未來"
    return d.isoformat(), None


def _guard_written_settled_dates(lines):
    """那篇守衛紀錄裡已經寫過的轉正日期:正文手補的「<日期> 已轉正」段、摘要 WHY 行尾的「(<日期> 已轉正)」。"""
    regs = _notelines_regions("\n".join(lines))
    got = set()
    for i, ln in enumerate(lines):
        r = regs[i] if i < len(regs) else "body"
        if r == "body":
            m = _GUARD_MANUAL_SETTLED_RE.match(ln.strip())
        elif r == "summary" and _guard_planned_prose(ln, r, settled_ok=True) == "why-done":
            m = _GUARD_WHY_SETTLED_DATE_RE.search(ln)
        else:
            m = None
        if m:
            got.add(m.group(1))
    return got


def _guard_raw_git_path(root, repo_rel):
    """repo 相對路徑(NFC)→ git ls-files 列出的原樣路徑(無損解碼,傳回給 git 用);找不到或 git 失敗回 None。"""
    raw = _nodehome_git(root, "ls-files", "-z")
    if raw is None:
        return None
    want = nfc(repo_rel)
    for x in _nodehome_split_z(raw):
        if nfc(x) == want:
            return x
    return None


def _guard_pass_commit_date(root, repo_rel):
    """守衛紀錄第一次變成 status: pass 的提交日期 → (日期, 錯誤)。那一筆若也是這個檔第一次出現的提交(匯入、搬目錄、
    改名後重新加入)就不算。不用 git log -S <合約文字>:settle 是原地換行,出現次數不變,找不到轉正那次(設計審 r1)。"""
    if _git_is_shallow(root):
        return None, "這個 repo 是 shallow clone,查不到完整歷史"
    raw = _guard_raw_git_path(root, repo_rel)
    if raw is None:
        return None, f"git 裡找不到 {repo_rel}(沒被追蹤,或 git 查詢失敗/逾時)"
    log = _nodehome_git(root, "log", "--reverse", "--format=%H%x09%as", "-G", "^status: pass", "--", raw)
    added = _nodehome_git(root, "log", "--diff-filter=A", "--format=%H", "--", raw)
    if log is None or added is None:
        return None, "git 查詢失敗或逾時"
    adds = set(added.decode("utf-8", "replace").split())
    for row in log.decode("utf-8", "replace").splitlines():
        sha, _t, day = row.partition("\t")
        blob = _nodehome_git(root, "show", f"{sha}:{raw}")
        if blob is None:
            continue
        fm, _b = split_frontmatter(blob.decode("utf-8", "replace"))
        if not fm or str(parse_frontmatter(fm)[0].get("status", "")).strip() != "pass":
            continue
        if sha in adds:
            return None, f"第一次是 pass 的提交 {sha[:12]} 也是這個檔第一次出現的提交(整批匯入或搬過目錄),那天不是轉正日"
        return day.strip(), None
    return None, "歷史裡找不到它變成 pass 的提交"


def _guard_settled_date(root, repo_rel, lines, date_arg):
    """補改句要寫的轉正日期 → (日期, 錯誤)。依序:--date、那篇已寫的轉正日期、守衛紀錄第一次變成 pass 的提交日期;
    推不出來回錯誤,★不拿今天充數★(存量漂移改法 第 2 節)。"""
    if date_arg is not None:
        return _guard_date_arg(date_arg)
    got = _guard_written_settled_dates(lines)
    if len(got) > 1:
        return None, f"這篇已寫的轉正日期不一致({'、'.join(sorted(got))}),用 --date 指定"
    if got:
        return next(iter(got)), None
    d, why = _guard_pass_commit_date(root, repo_rel)
    if d is None:
        return None, f"推不出轉正日期({why}),用 --date YYYY-MM-DD 指定"
    return d, None


def _guard_pass_home(env, glines):
    """已 pass 的守衛紀錄補改句的前提:讀得出預告的合約、家節點摘要裡有這條合約綁了測試的正式行。
    → (家節點路徑, 錯誤)。"""
    gfm, _gb = split_frontmatter("\n".join(glines))
    gfields = parse_frontmatter(gfm)[0] if gfm is not None else {}
    m = re.search(r"^預告的合約:(.+)$", "\n".join(glines), re.M)
    claim = m.group(1).strip() if m else ""
    home = _guard_home_of_fields(gfields)
    home_rel = env.find(home) if home else None
    htext = env_text(env, home_rel) if home_rel else None
    if claim and htext is not None:
        hfm, _hb = split_frontmatter(htext)
        if hfm is not None and _guard_formal_line(htext.split("\n"), len(hfm) + 1, claim, None) is not None:
            return home_rel, None
    what = ("讀不出預告的合約" if not claim else f"找不到家節點 {home or '(沒寫)'}" if htext is None
            else f"家節點 {home_rel[:-3]} 的摘要裡沒有這條合約綁了測試的正式行")
    return None, (f"{what}。兩條出路:這條合約其實還沒轉正——把 status 改回 pending 後走 lumos guard settle;"
                  "或正式行寫在別處——手動改句後,對剩下的 c1 用 lumos drift ack")


def _guard_pass_rewrite(env, root, repo_rel, glines, date_arg):
    """已 pass 但還留著預告句的守衛紀錄 → (改寫後的行, 找不到的句型, 用的日期, 錯誤)。前提、日期、不疊都在這裡;
    guard settle 與 drift fix --kind c1 共用(drift 往下呼叫 guard,guard 不呼叫 drift)。"""
    home_rel, err = _guard_pass_home(env, glines)
    if err:
        return None, None, None, err
    ops = _guard_prose_ops(glines)
    day = None
    if _guard_prose_needs_date(ops):
        day, err = _guard_settled_date(root, repo_rel, glines, date_arg)
        if err:
            return None, None, None, err
    elif date_arg is not None:
        day, err = _guard_date_arg(date_arg)
        if err:
            return None, None, None, err
    new, missing = _guard_settle_rewrite(glines, day, home_rel[:-3])
    return new, missing, day, None


def _guard_touched_hits(files, touched):
    """家節點管的那些檔,跟這次改到的檔對得上哪幾個。回 (對上的清單, 是不是只在忽略大小寫時才對上)。

    ★比對鍵走既有那支★(代碼審 r2 架構席 blocker):about_code 的比對鍵全 repo 只有一個算法
    `_nodehome_key`(路徑正規化 + NFC),2026-09-10 那輪代碼審就是為了收斂「三處各寫一份、
    各版解得不一樣」才立的。第一版自己刻了一份,解不了 `a/../b`——而那正是這個 repo
    自己認證過、也修過一次的人手寫法,漏掉的話該擋的推送會安靜放行。

    在那之上多兩條**只會多擋、不會少擋**的保險:家節點寫的是資料夾(看底下的檔)、只有忽略大小寫
    才對得上。寫入端(`_about_code_path`)確實已經擋掉這兩種寫法(要求是檔案、大小寫要跟磁碟一致),
    所以走指令寫進去的不會踩到;留著是因為★寫入端的保證不等於讀取端的保證★——開頭欄位可以被手改,
    而這一層漏掉是沒人會發現的(多擋一次訊息會講清楚為什麼)。
    """
    tset = {_nodehome_key(x) for x in touched}
    tset.discard("")
    hits, only_case = [], []
    for raw in files:
        f = _nodehome_key(raw)
        if not f:
            continue
        if f in tset:
            hits.append(raw)
            continue
        under = sorted(x for x in tset if x.startswith(f + "/"))
        if under:
            hits.append(f"{raw}(底下的 {under[0]})")
            continue
        # ★排序後取第一個★(代碼審 r2 通才席):只差大小寫的兩支檔在大小寫敏感的檔案系統上
        # 可以同時存在,用 dict 收會因為雜湊順序而每次點名到不同那支,排查訊息不穩定。
        same = sorted(x for x in tset if x.lower() == f.lower())
        if same:
            hits.append(f"{raw}(大小寫不同:{same[0]})")
            only_case.append(raw)
    return hits, only_case


def _guard_touches(gn, env, touched):
    """這條逾期的預告合約,跟「這次改動碰到的檔」有沒有關係。回 (要不要擋, 補充說明)。

    ★本機那一層只擋碰到的、CI 擋全部★(必要合約清單_計劃〈擋的範圍〉三層):
    分辨兩層靠的是有沒有給清單——推送前的閘算得出這次推了哪些檔就給,CI 不給。
    給了清單卻算不出這條跟哪些檔有關(家節點不見、或家節點沒寫 about_code),本機這一層放行:
    這一層的定位是窄而準,誤擋一次的代價是有人被卡住又解不開別人的合約;CI 那邊照樣會擋,漏不掉。
    """
    if touched is None:
        return True, ""            # 沒給清單=CI 那一層,照舊全擋
    # ★guards 可以有好幾個值★(代碼審 r1 通才席):欄位本來就是清單,只看第一個會讓第二篇家節點
    # 管的檔永遠算不到。_guard_home_of 是給「改哪一篇」用的(只能有一個目標),這裡要全看。
    homes = [str(x).strip() for x in as_list(gn.fields.get(GUARD_MARK_FIELD)) if str(x).strip()]
def _about_code_path(env, value):
    """about_code 的一項要是「這個 repo 裡真的存在的程式檔」(2026-09-10 代碼審 r1)。

    回 (正規化後的 repo 相對路徑, None) 或 (None, 擋下的理由)。
    ★先解析再比對 repo 根★:只看「存不存在」的話,絕對路徑與 ../ 都會繞出 repo 而且通過;
    存成正規化的樣子,排序加分用的鍵才對得上(src/../src/a.py 跟 src/a.py 要是同一個)。"""
    v = str(value).strip().replace("\\", "/")   # Windows 反斜線寫法也收(r3 邊界席:原本永遠「找不到」)
    if not v:
        return None, "about_code 不能是空的"
    if Path(v).is_absolute():
        return None, f"about_code 要寫 repo 相對路徑,「{v}」是絕對路徑"
    root = _vault_repo_root(env).resolve()
    target = (root / v).resolve()
    try:
        relp = target.relative_to(root).as_posix()
    except ValueError:
        return None, f"「{v}」跑出這個 repo 了(repo 根是 {root})"
    if not target.is_file():
        return None, (f"「{v}」不是這個 repo 裡的檔案" + ("(它是目錄;about_code 要寫到檔案)" if target.is_dir() else "(找不到)"))
    # ★筆記不是程式檔★(筆記欄位關卡補齊_計劃 S14):有一篇 Issue 就是用 append 把一篇筆記路徑寫進 about_code;
    # 要連結別篇筆記請寫進 related,about_code 只放這篇管的程式檔。
    try:
        target.relative_to(env.vault.resolve())
        return None, f"「{v}」在圖譜資料夾裡,是筆記不是程式檔——要連結別篇就寫進 related"
    except ValueError:
        pass
    # ★大小寫要跟磁碟上的真實檔名一致★(r2):排序加分拿這個值去比對 git 的改動路徑(大小寫敏感);
    # 大小寫不敏感的檔案系統上 SRC/A.TS 也通過 is_file,存進去就永遠對不上
    # 只差 Unicode 正規化寫法(é 一個字 vs e 加重音符號)的是同一個檔,不算寫錯:Mac 的磁碟兩種都認,
    # 目錄清單卻只列存進去的那一種(派第三輪之前自己抓到的誤擋)——兩邊都轉成 NFC 再比。
    # ★讀不到目錄的檔名清單就擋★(r3 併發資源席:原本當成「寫對了」放行,錯字大小寫照樣存進去)
    real, unreadable = _disk_spelling(root, relp)
    if unreadable:
        return None, f"讀不到目錄 {unreadable} 的檔名清單,沒辦法確認「{v}」的大小寫有沒有寫對"
    if nfc(real) != nfc(relp):
        return None, f"「{v}」的大小寫跟磁碟上的檔名不一致(磁碟上是 {real})"
    return relp, None


def cmd_append(env, rel, key, value):
    with _vault_write_lock(env.vault):
        return _cmd_append_locked(env, rel, key, value)


def _cmd_append_locked(env, rel, key, value):
    if key not in LIST_KEYS:
        print(f"擋下:{key} 不能用 append 加,檔案沒動。append 只能加這些清單欄位:{sorted(LIST_KEYS)}(純量欄位用 lumos set)", file=sys.stderr)
        return 2
    if key == "about_code":
        value, why = _about_code_path(env, value)
        if why:
            print(f"擋下:{why},檔案沒動。about_code 要填這個 repo 裡真的存在的程式檔(repo 相對路徑)", file=sys.stderr)
            return 2
    path = env.vault / rel
    lines, s, e = load_raw_for_edit(path)
    if key == "about_code":
        root = _vault_repo_root(env).resolve()
        want = _about_code_key(root, value)
        same = [x for x in as_list(parse_frontmatter(lines[1:e])[0].get(key)) if _about_code_key(root, x) == want]
        if same:
            hint = "" if value in same else f"(現有寫法是 {same[0]},指的是同一支檔;要換成 {value}:先 remove 再 append)"
            if lines[i].strip() == "---":
                fm_end = i + 1
                break
    body = "\n".join(lines[fm_end:])
    f = n.fields if n else {}
    tags = f.get("tags")
    tags = " ".join(tags) if isinstance(tags, list) else str(tags or "")
    aliases = f.get("aliases")
    aliases = " ".join(str(a) for a in aliases) if isinstance(aliases, list) else str(aliases or "")
    return {"title": (n.stem if n else Path(rel).stem),
            "aliases": aliases,
            "summary": str(f.get("summary") or ""),
            "tags": tags, "body": body, "type": str(f.get("type") or "")}


_RANK_TYPE_MULT_MOC = 0.4   # A1 型別先驗:MOC=hub 降權(goldset 實證關鍵字磁鐵;train 網格凍結)


_RANK_STATUS_MULT = 1.0   # A1.5 狀態先驗(stale/superseded 降權;goldset 網格後凍結,1.0=關)


def _rank_type_mult(env, rel):
    """型別/狀態先驗乘數(A1/A1.5,節點靜態先驗_調研):moc 降權、stale/superseded 降權、其餘 1.0。
    降權用乘法(比例效果跨 query 一致,企業搜尋標準);LUMOS_RANK_* env 供評測消融覆寫。"""
    n = env.notes.get(rel)
    fields = n.fields if n and isinstance(n.fields, dict) else {}
    t = str((fields.get("type") or "")).strip().lower()
    m = 1.0
    if t == "moc":
        try:
            m *= float(os.environ.get("LUMOS_RANK_MOC_MULT", _RANK_TYPE_MULT_MOC))
        except ValueError:
            m *= _RANK_TYPE_MULT_MOC
    st = str((fields.get("status") or "")).strip().lower()
    if st in ("stale", "superseded"):
        try:
            m *= float(os.environ.get("LUMOS_RANK_STATUS_MULT", _RANK_STATUS_MULT))
        except ValueError:
            m *= _RANK_STATUS_MULT
    return m


def _rank_score_candidates(env, query, candidates):
    """對候選集跑 BM25F(欄位 tf 加權於飽和前,單一虛擬文件)× 型別先驗乘數(A1)。
    回 [(rel, score, hits)]。N/df/avgdl 以候選集為 corpus(排序目的,絕對值不跨查詢比較)。"""
    q_tokens = list(dict.fromkeys(_rank_tokenize(query)))
    if not q_tokens or not candidates:
        return [(r, 0.0, []) for r in candidates]
    docs = {}
    for rel in candidates:
        fields = _rank_fields(env, rel)
        tfs = {}
        dl = 0.0
        for fname, ftext in fields.items():
            w = _RANK_FIELD_W[fname]
            toks = _rank_tokenize(ftext)
            dl += len(toks)          # 長度用未加權 token 數(spec §1)
            for tok in toks:
                if tok in q_tokens:
                    tfs[tok] = tfs.get(tok, 0.0) + w   # tf 加權於飽和前
        docs[rel] = (tfs, dl)
    n_docs = len(docs)
    avgdl = sum(d for _, d in docs.values()) / max(n_docs, 1)
    df = {t: sum(1 for tfs, _ in docs.values() if t in tfs) for t in q_tokens}
    out = []
    for rel, (tfs, dl) in docs.items():
        score = 0.0
        hits = []
        for tok in q_tokens:
            tf = tfs.get(tok, 0.0)
            if tf <= 0:
                continue
            score += _rank_bm25(tf, _rank_idf(n_docs, df[tok]), dl, avgdl)
            hits.append(tok)
        out.append((rel, round(score * _rank_type_mult(env, rel), 4), hits))
    # A3 權威度(in-degree 飽和加分)已試已殺(2026-07-11 goldset 雙面負增益:
    # search 0.875→0.847@w0.2、edit P@8 0.70→0.65@w0.1——本圖的高連結節點=導覽樞紐非答案,
    # 與 MOC 磁鐵實證同構)。詳見 Projects/節點靜態先驗_調研 消融紀錄;勿憑直覺復活。
    out.sort(key=lambda x: (-x[1], x[0]))
    return out


def _is_forgotten(env, rel):
    """召回層真遺忘判定:status=superseded 預設藏(GateMem 2026-07-24 吸收)。
    ★只認 superseded,不含 stale★——stale 是「待重驗」警訊,藏了=把該看見的提醒也遺忘、製造新洞
    (見 Projects/真遺忘召回過濾_計劃 樞紐陷阱)。valid:false 決策屬 decisions 層、不歸此節點層判定。"""
    n = env.notes.get(rel)
    if not n or not isinstance(n.fields, dict):
        return False
    return str(n.fields.get("status") or "").strip().lower() == "superseded"


def _strip_code_text(text, include_code=False):
    """把「程式碼區塊/inline code 以外看得見的文字」串成一段——★整段文字層的唯一實作★。

    ★為什麼不用 `FENCE_RE.sub("")`(2026-08-03 code-loop r2,全局哨兵抓到,附兩處實測重現)★:

hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "sed -n '3500,3575p' scripts/lumos && sed -n '8480,8535p' scripts/lumos && sed -n '14840,14970p' scripts/lumos && sed -n '38125,38165p' scripts/lumos" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-ns
 succeeded in 0ms:
      ② `cmd_guard_trace()`:未閉合圍欄裡的測試名 ★被當成合約的真實佐證★
         → 污染 ★INVARIANT★→[test:]→Verification 證據鏈,正好打臉該指令自己的保證。
    逐行 toggle 的語意才是對的:未閉合圍欄之後一律視為 code(隱形),與主搜尋一致。
    ★爆炸半徑(2026-08-03 r3 由 Codex 覆核後修正,原宣稱過強)★:
      ・全庫 220 篇★無任何未閉合圍欄★(兩方各自掃過,一致)
      ・wikilink 邊集合 ★新舊完全相同(差集為空)★
        ★這裡刻意★不寫具體數字★,只寫不變量★——2026-08-03 r4 三位審查員各自
        獨立量,得到 436/382/728、976/728/240 等多組互不相同的值,沒有一個等於
        我原本抄來的「354」(那是 `lumos export --format dot` 的邊數口徑)。
        ★「邊數是多少」取決於你怎麼數(出現次數/去重/含不含 frontmatter/解析前後),
        但「新舊相同」與口徑無關——★該記的是不變量,不是那個數★。
        要自己驗:任選一種口徑,對 `body_clean` 用舊寫法與 `_strip_code_text`
        各算一次邊集合,比差集。
        ★過程檢討:我當初把 r3 審查員報告裡的數字直接抄進 docstring、沒有自己量,
         正是本專案同日剛在圖譜更正過的「數字被沿用進句子」——只是碰巧站得住★
      ・`guard trace` 全 vault 輸出 ★逐字元相同★(67 行,實測 diff)
      ・★但「清洗後文字一個字都不變」這個更強的說法不成立★:33-36 篇不同
        (兩位審查員各自量到 33 與 36,計數口徑略異;方向一致)——新法(逐行
        `lstrip().startswith("```")`)接受★縮排的圍欄★,舊 `FENCE_RE` 只認第 1 欄。
        ★這是與不閉合圍欄★正交★的另一類變化,原本的「爆炸半徑=0」理由沒涵蓋它★;
        方向上新法與主搜尋一致(search 一直都是逐行 lstrip)、也與 CommonMark 一致,
        故判定為修正而非回歸——但★這是事後補的論證,不是原本就驗過的★。
    """
    return "\n".join(pr for _no, _raw, pr in _search_visible_lines(text.split("\n"), include_code))


def _visible_lines(lines, keep_fenced=False):
    """★全檔唯一的 fenced-code 判定實作★:逐行 toggle,回 (行號從1起, 原始行)。

    `keep_fenced=True` 時保留圍欄★內★的文字(但仍跳過 ``` 標記行本身)。

    ★為什麼所有人都必須走這裡(2026-08-03 code-loop r2/r4)★:原本各處自己用
    `FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)`,那個正則有兩個致命假設——
      ① 假設圍欄★成對★:未閉合的圍欄看不見(r2 抓到:幽靈圖譜邊、假合約佐證)
      ② 假設圍欄標記★在第 0 欄★:收尾圍欄一縮排就跟下一個區塊的開頭錯配,
         ★把中間的真散文整段當程式碼吞掉★(r4 抓到,實測某條路徑宣稱直接消失)
    ②的消費端是治理機制本身(refcheck → design-loop 的 G1 硬閘、Edit/Write 前
    自動注入必看合約的 impact hook)——★一個縮排的 ``` 就能把某節點的鐵則警告
    靜默關掉★。逐行 toggle 對兩個假設都免疫。
    
    ★兩段式讀法(2026-09-16 代碼審 r2)★:先照 CommonMark 讀——收尾圍欄後面只能有空白,
    帶語言標記的那行不算收尾(不然巢狀範例裡的樣板會被當成真的)。但這條規則比題目寬:
    收尾★打錯一個字、多敲一鍵★也會變成「關不掉」,後面到檔尾所有內容(含合約行)
    無聲隱形——正是下面警告過的最危險模式換個門長出來。所以規格讀法如果讀完還有圍欄沒關,
    就整份退回寬鬆讀法(同字元、長度夠就算關)。取捨:同一份文件裡同時有巢狀範例★和★
    沒關到的圍欄時,會退回寬鬆、巢狀那題就擋不住——那等於回到 2026-09-16 之前的行為,
    不算退步,而且真的有沒關到的圍欄本來就該先修那個。
    """
    def _scan(strict):
        """回 (看得見的行, 收尾時還有沒有圍欄開著)。strict=照 CommonMark(收尾不得帶東西)。"""
        fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
        # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
        out = []
        for i, ln in enumerate(lines):
            indent = len(ln) - len(ln.lstrip(" "))
            s = ln.lstrip(" ")
            # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
            is_marker = indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))
            if is_marker:
                ch = s[0]
                run = len(s) - len(s.lstrip(ch))
                if fence is None:
                    fence = (ch, run)
                    continue
                if ch == fence[0] and run >= fence[1] and (not strict or s[run:].strip() == ""):
                    fence = None
                    continue
            if fence is not None and not keep_fenced:
                continue
            out.append((i + 1, ln))
        return out, fence is not None

    out, unterminated = _scan(True)
    if unterminated:                      # 規格讀法讀不完 → 退回寬鬆(見說明的取捨)
        out, _ = _scan(False)
    yield from out
        # 逐條判(r2 回滾席):code 型那條自己要是 major 以上;沒標型別的那條當分不出、保守算
        _hit = any(v in ("major", "blocker") and (_kinds is None or _kinds.get(k) == "code") for k, v in _sevs.items())
        _precision = "finding" if _kinds is not None else "round"   # 沒標型別=分不出是不是 code 型,不能謊報成逐條精度(r3 邊界席)
    else:
        _has_code = (_kinds is None) or any(str(v) == "code" for v in _kinds.values())   # 沒標型別=分不出,保守記;標了就只收 code 型
        _hit = severity in ("major", "blocker") and _has_code
        _precision = "round"   # 輪級判準:這輪最高 major 且任一條是 code 型——粗,帳上標出來讓讀側分得出
    if loop and str(loop).startswith("code-") and _hit:
        try:
            derived = str(loop)[len("code-"):]
            _auto_escape(env, "code-loop", severity,
                         f"代碼審記到 {severity}({auditor or '?'}{' ' + str(round_id) if round_id else ''})",
                         [(derived, _plan_for_loop(env, derived))],
                         _git_head(env.vault.parent.parent), source="code-loop", extra={"precision": _precision})
        except Exception as _ex:   # 掛勾不准弄壞記帳
            _escape_auto_failed(env, str(loop), "code-loop", str(_ex))
    return 0


def _jsonl_append_verified(path, rec, key_field, key_value):
    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
    import json
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"擋下:寫不進記錄檔({e}):\n    {path}", file=sys.stderr)
        return 2
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except (ValueError, RecursionError):   # 別筆是超深巢狀行也只跳過;否則已寫進去卻報沒記成功(code-逃逸帳 r3 邊界席)
                    continue
                if isinstance(d, dict) and d.get(key_field) == key_value:
                    return 0
    except (OSError, ValueError) as e:
        print(f"canary record: 落盤自驗失敗——寫完讀回來檢查時讀不到({e}),這筆不算記成功:\n    {path.resolve()}", file=sys.stderr)
        return 2
    print(f"canary record: 落盤自驗失敗——系統說寫成功了,但讀回來找不到這一筆,這筆不算記成功:\n    {path.resolve()}",
          file=sys.stderr)
    return 2


