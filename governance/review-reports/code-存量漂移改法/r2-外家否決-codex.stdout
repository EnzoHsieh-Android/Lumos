 27455	def cmd_drift_ack(env, node, line, kind, reason, dry_run=False):
 27456	    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。
 27457	    c2、c3 先確認那一行當下真的是這一種發現,記下當時連著的已收尾計劃(related);每筆都記遞增序號 seq(存量漂移改法 [S8])。"""
 27458	    import datetime, secrets
 27459	    err = _drift_ack_args_err(kind, reason)
 27460	    if err:
 27461	        print(f"擋下:{err}", file=sys.stderr)
 27462	        return 2
 27463	    rel = env.find(node)
 27464	    if rel is None:
 27465	        return _node_not_found(env, node, write_side=True)
 27466	    text = env_text(env, rel)
 27467	    lines = (text or "").split("\n")
 27468	    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
 27469	        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
 27470	        return 2
 27471	    root, vault_rel = _drift_vault_of(env)
 27472	    head = ""
 27473	    for ln in reversed(lines[:line]):
 27474	        if ln.startswith("#"):
 27475	            head = ln.lstrip("#").strip()
 27476	            break
 27477	    token = "DACK-" + secrets.token_hex(4)
 27478	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 27479	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
 27480	    if kind in _DRIFT_BOUND_KINDS:
 27481	        # 鎖外新建圖譜物件重判(大圖譜重建可能超過鎖的 30 秒接手線)
 27482	        f, err = _drift_current_finding(Env(env.vault), rel, line, kind)
 27483	        if err:
 27484	            print(f"擋下:{err}", file=sys.stderr)
 27485	            return 2
 27486	        rec["related"] = sorted(nfc(str(x)) for x in f.get("related", []))
 27487	    if dry_run:     # drift fix --kind c2 --keep --dry-run:判定做完、不拿鎖不寫(代碼審 r1 六席同報:原本照樣寫表態)
 27488	        print(f"預覽(沒寫):會記一筆表態——{_esc_clean(rel, 200)} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]}),"
 27489	              f"理由:{_esc_clean(reason.strip(), 200)}"
 27490	              + (f";當時連著 {'、'.join(x[:-3] for x in rec['related'])}" if rec.get("related") else ""))
 27491	        return 0
 27492	    # 表態檔跟筆記庫其他寫入者排同一把鎖(代碼審 r1 併發席;跟治理帳其他寫入者沒共用鎖的整體問題在 Issue 那篇);
 27493	    # 序號在鎖內取現有最大加 1
 27494	    with _vault_write_lock(env.vault):
 27495	        rec["seq"] = _drift_next_seq(root, _DRIFT_ACKS)
 27725	    return _drift_bound_latest(rows)[-1].get("after_sha256")
 27726	
