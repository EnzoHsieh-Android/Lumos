+    r = run(v, "updated-sync", "--stale")
+    check("④再跑一次(都已是今天、但還沒提交):照樣改成今天、不報錯", r.returncode == 0, r.stdout + r.stderr)
+    print("  ✓ t_updated_sync_stale")
