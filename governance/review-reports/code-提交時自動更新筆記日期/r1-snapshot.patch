+    r = run(v, "updated-sync", "Systems/不存在", "Systems/Ship")
+    check("②找不到的走近名候選、rc 非 0、其他照改", r.returncode != 0 and "找不到叫「Systems/不存在」的筆記" in r.stdout + r.stderr
+          and _us_updated(v, "Systems/Ship.md") == _us_today(), r.stdout + r.stderr)
