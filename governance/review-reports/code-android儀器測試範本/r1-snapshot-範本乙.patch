+@Composable
+fun CheckoutScreen(vm: CheckoutViewModel, onDone: () -> Unit) {
+    val done by vm.done.collectAsState()
+    LaunchedEffect(done) {
+        if (done) {
+            onDone()
+            vm.onNavigated()
+        }
+    }
+    Button(onClick = vm::pay) { Text("付款") }
