+            rc = m.cmd_note_audit_reread_check(repo=str(root), diff_range=f"{base}..HEAD")
+    finally:
+        g.update(saved)
+    ev = [x for x in _gov_since(_ns_gov(root), n0) if x.get("gate") == "note-reread"]
+    e = _rfp_ev(ev)
