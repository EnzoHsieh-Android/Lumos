+def _rfp_check(root, rng, *extra):
+    """不帶 --gate 跑 reread-check → (rc, 輸出, 這次新增的 note-reread 事件)。"""
+    n0 = _ns_gov(root)
+    rc, o, e = _rr(root, "reread-check", "--diff", rng, *extra)
+    return rc, o + e, [x for x in _gov_since(_ns_gov(root), n0) if x.get("gate") == "note-reread"]
