+          and (e.get("fp_counts") or {}).get("v2") == 1, f"{fp} {v1}\n{body[-400:]}\n{e}")
+    fp, body, e = run({"_NOTE_REREAD_DIFF_CAP": cap, "_NOTE_REREAD_DIFF_CTX": (3,)})
+    check("①規則改成只試 3 行 → 材料截掉,prepare 與 check 都用 v1(記「判定者材料被縮短」)",
