+    rng, tip = f"{base}..HEAD", _na_head(root)
+    l0 = len(m._note_reread_diff_once(root, base, tip, ["src/a.py"], 0))
+    l3 = len(m._note_reread_diff_once(root, base, tip, ["src/a.py"], 3))
+    cap = (l0 + l3) // 2
+    v1 = _rfp_v1(m, root, _rr_note("A"), ["src/a.py"])
+
+    def run(patch):
