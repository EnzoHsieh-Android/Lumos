+def _rfp_why(ev):
+    """事件的 fp_counts → (v2 篇數, {退回原因: 篇數})。"""
+    fc = _rfp_ev(ev).get("fp_counts") or {}
+    return fc.get("v2"), fc.get("v1_why") or {}
