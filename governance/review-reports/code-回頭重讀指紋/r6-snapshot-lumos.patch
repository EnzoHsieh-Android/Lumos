+    只會出現在頂端那一版是空的(刪檔、清空)——那時舊側從第 1 行起,第 1 行之上沒有任何一行,鏈本來就是空的,不必另讀分岔點那一版。
+    刪檔、子模組沒有頂端內容,鏈也是空的。沒有 hunk(二進位、只改 mode)不讀內容。"""
+    keys = []
+    for ln in text.split("\n"):
+        if ln.startswith("@@ "):
+            m = _NOTELINES_HUNK_RE.match(ln)
+            if m:
+                keys.append(m.groups())
+    spans = [(int(k[2]), int(k[3] if k[3] is not None else 1)) for k in keys]
+    want = [i for i, (_c, d) in enumerate(spans) if d > 0]
+    data = None
+    if want and not _NOTE_REREAD_FP_ZERO.fullmatch(ent["noid"]) and ent["nmode"] != "160000":
+        data, why = _note_reread_fp_blob(scan, base, ent["noid"])
+        if why:
+            return None, why
+    got = _note_reread_hunk_tags(data, [spans[i] for i in want], base["dl"])
+    if got is None:
+        return None, "逾時"
+    tags = dict.fromkeys(keys, "")
+    tags.update((keys[i], g) for i, g in zip(want, got))
+
+    def tag(ln):
+        m = _NOTELINES_HUNK_RE.match(ln)
+        return tags.get(m.groups(), "") if m else ""
+    return tag, None
