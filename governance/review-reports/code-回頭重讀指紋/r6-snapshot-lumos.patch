+    pos, n = 0, len(data)
+    while True:
+        cut = data.find(b"\n", min(pos + block, n))
+        if cut < 0:
+            yield data[pos:].split(b"\n")
+            return
+        yield data[pos:cut].split(b"\n")
+        pos = cut + 1
