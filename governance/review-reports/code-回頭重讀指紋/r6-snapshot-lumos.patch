+    data = blobs.get(oid)
+    if data is not None:
+        return data, None
+    got = _nodehome_cat_blobs_capped(scan["root"], [oid], _NOTE_REREAD_FP_MAX, timeout=20, deadline=base["dl"], sizes=[size])
+    if not got or got[0] is None:
+        return None, ("逾時" if _note_reread_fp_expired(base["dl"]) or _git_timeout(base["dl"]) <= 0 else "git 失敗")
+    return got[0], None
