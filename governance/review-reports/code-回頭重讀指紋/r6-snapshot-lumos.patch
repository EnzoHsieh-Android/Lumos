+        base["diff_order"] = list(dict.fromkeys(e["path"] for rel in scan["cands"]
+                                                for k in _note_reread_fp_walk_keys(_note_reread_about(scan, rel))
+                                                for e in base["raw"].get(k, ()) if wanted(e)))
