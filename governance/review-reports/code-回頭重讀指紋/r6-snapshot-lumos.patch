+    for node in _note_reread_hunk_nodes(data, spans) or ():
+        chain = []
+        while node is not None:
+            chain.append(node[0].decode("utf-8", "surrogateescape"))
+            node = node[1]
+        res.append(tuple(reversed(chain)))
+    return res
