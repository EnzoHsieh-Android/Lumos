+def _note_reread_fp_blob(scan, base, oid):
+    """算縮排鏈要的頂端內容 → (bytes, None) 或 (None, 退回原因)。先看手上這一批批次讀好的;不在裡面就從這支起再批次讀一批
+    (_note_reread_fp_prefetch,換掉上一批,記憶體只留一批);批次讀不了(超過單支 1 MB)再單支讀。兩條都走有上限的共用讀法
+    _nodehome_cat_blobs_capped(單支上限 _NOTE_REREAD_FP_MAX,大小用已經查好的、不再問一次)。"""
+    size = (base.get("sizes") or {}).get(oid)
+    blobs = base.get("blobs") or {}
+    if oid not in blobs and size is not None and size <= _NOTE_REREAD_FP_PREFETCH_MAX:
+        # 只有批次讀得了的那支缺了才換下一批;超過單支 1 MB 的直接單支讀,不換掉手上這一批(交錯的大小檔不會每支大檔都重讀 64 MB)
