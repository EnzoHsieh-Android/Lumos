+def _note_reread_split_diff(raw):
+    """多支檔的 diff(bytes)→ {檔名: (起, 訖)}。每段從行首的 `diff --git ` 起(內容行一定帶 +、-、空白、\\ 前綴,GIT binary patch 的
+    base85 資料行沒有空白,不會被當成檔頭);檔名交給 _patch_file_changes 只看那段的檔頭(第一個 `@@` 或 GIT binary patch 之前),
+    跟單支 diff 用同一套引號還原。認不出、或同一個檔名出現兩次的段不放(呼叫端單支再問)。"""
+    starts = _diff_git_starts(raw)
+    out, dup = {}, set()
+    for i, a in enumerate(starts):
+        b = starts[i + 1] if i + 1 < len(starts) else len(raw)
+        cut = [j for j in (raw.find(b"\n@@ ", a, b), raw.find(b"\nGIT binary patch\n", a, b)) if j >= 0]
+        head = raw[a:min(cut) + 1 if cut else b]
+        names = list(_patch_file_changes(head.decode("utf-8", "surrogateescape"), headers=False, lf_only=True))
+        if len(names) != 1:
+            continue
+        if names[0] in out:
+            dup.add(names[0])
+        out[names[0]] = (a, b)
+    for n in dup:
+        del out[n]
+    return out
+
