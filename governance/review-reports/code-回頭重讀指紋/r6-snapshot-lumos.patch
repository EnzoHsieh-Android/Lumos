+def _diff_git_same_name(line):
+    """`diff --git a/X b/X` 那一行兩半相同時的檔名 X(引號照 git 的規則還原)→ str 或 None(兩半不同、找不到切點)。
+    沒有 `---`/`+++` 的段(二進位、只改權限、空檔新增刪除)只能從這一行取名;路徑本身含「 b/」時取最後一個「 b/」之後會取錯
+    (`src/x b/y2` 取成 `y2`,代碼審 r5 正確性 1、邊界 1)。兩半一樣長、中間一個空白,切點只有一個,不用猜。"""
+    rest = line[len("diff --git "):] if line.startswith("diff --git ") else None
+    if rest is None or len(rest) % 2 == 0 or rest[len(rest) // 2] != " ":
+        return None
+    left, right = rest[:len(rest) // 2], rest[len(rest) // 2 + 1:]
+    for q in ("", '"'):
+        if left.startswith(q + "a/") and right.startswith(q + "b/") and left[len(q) + 2:] == right[len(q) + 2:]:
+            p = _git_unquote_path(right) if q else right
+            return p[2:] if p.startswith("b/") else None
+    return None
+
