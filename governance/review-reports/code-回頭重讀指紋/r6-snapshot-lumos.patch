+def _note_reread_indent(ln):
+    """一行(bytes)的縮排欄寬:開頭的空白與 tab,tab 照 _NOTE_REREAD_TAB 欄展開;縮排鏈要跳過的行(_NOTE_REREAD_SKIP:空行、只有空白、
+    只有標點)回 None。這是可讀的參照版:_note_reread_hunk_nodes 的熱迴圈內聯了同一套算法(邊切行邊算,不呼叫這支),
+    t_reread_fp_indent_inline_same 綁住兩邊一樣——改規則兩邊一起改。"""
+    if not ln.strip(_NOTE_REREAD_SKIP):
+        return None
+    c = ln[:1]
+    if c != b" " and c != b"\t":
+        return 0
+    pre = ln[:len(ln) - len(ln.lstrip(b" \t"))]
+    return len(pre) if b"\t" not in pre else len(pre.expandtabs(_NOTE_REREAD_TAB))
