+def _note_reread_fp_prefetch(scan, base):
+    """候選 about_code 列到、這條分支改過的檔,頂端內容不超過 _NOTE_REREAD_FP_PREFETCH_MAX 的,一次 cat-file 批次讀進來 → {物件編號: bytes}。
