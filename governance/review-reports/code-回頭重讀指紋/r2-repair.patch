     "status"}…]};同一個鍵對到好幾支(樹裡 NFC 與 NFD 各一支)時照原樣位元組排序、全部算進那一項。"""
     toks, out, i = raw.split(b"\0"), {}, 0
     while i + 1 < len(toks):
         parts = toks[i][1:].decode("ascii", "replace").split(" ") if toks[i].startswith(b":") else None
         if parts is None:
             i += 1
             continue
         path, i = os.fsdecode(toks[i + 1]), i + 2
         k = _nodehome_key(path) if len(parts) >= 5 else ""
         if k:
             out.setdefault(k, []).append({"path": path, "omode": parts[0], "nmode": parts[1], "ooid": parts[2],
                                           "noid": parts[3], "status": parts[4][:1]})
     for ents in out.values():
         ents.sort(key=lambda e: os.fsencode(e["path"]))
     return out
 
 
