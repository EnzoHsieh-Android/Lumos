+    rb = _rfp_main_advance(root, lambda r: _rfp_line(r, "src/a.py", ln["def check_b(user):"], "def check_b(user, extra=None):"),
+                           branch="fb")
+    after, _f, _o = _rfp_items(root, f"{_RFP_ZERO}..HEAD", *_rfp_push("fb"))
+    check("④主線只改了 check_b 的參數列、rebase 上去 → 指紋不變", rb.returncode == 0 and after.get(_rr_note("A")) == fb,
+          f"{rb.stderr} {after} {fb}")
