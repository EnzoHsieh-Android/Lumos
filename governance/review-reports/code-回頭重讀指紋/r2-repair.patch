+                              if e["nmode"] != "160000" and not _NOTE_REREAD_FP_ZERO.fullmatch(e["noid"])
+                              and sizes.get(e["noid"], _NOTE_REREAD_FP_PREFETCH_MAX + 1) <= _NOTE_REREAD_FP_PREFETCH_MAX))
+    t = _git_timeout(base["dl"])
+    got = _nodehome_cat_blobs(scan["root"], oids, timeout=t) if (oids and t > 0) else None
