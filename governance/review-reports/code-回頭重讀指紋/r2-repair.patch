+def _note_reread_hunk_tags(data, hunks):
+    """每個 hunk 所在函式的識別名(代碼審 r1 資安席 major、正確性席 1:原本 v2 連段落標頭一起拿掉,同一段改動搬到同檔另一個
+    前後三行相同的函式指紋不變)→ 跟 hunks 同順序的字串清單。data 是頂端版本的內容(bytes;刪檔給 None → 全是空字串),
+    hunks 是 [(新側起點 c, 新側行數 d)…](`@@ -a,b +c,d @@`)。
+    ① 頂格行:hunk 起點之前(d>0 是第 c 行之前,d=0 是第 c 行之後的位置、含第 c 行)最近一行第一個字是英文字母、底線或 $
+       ——跟 git 預設段落標頭同一條規則,但不靠 git 依屬性檔(diff=python 這類)選規則,簽出什麼都一樣;
+    ② 名字:那一行 def/class/function/func/fn 後面那個識別字(可帶 async、export、pub 這類修飾字;Go 的方法接收者跳過),
+       都沒有就取第一個識別字——★參數與簽名不算★:主線改了函式的參數列,作者的改動一字未變,名字不變(S8);
+    ③ 方法:頂格那行之後、hunk 之前若有縮排的定義行(同②的關鍵字),接「/方法名」——類別裡兩個前後三行相同的方法也分得開。
+    只看到最大的那個起點為止;一次往前掃,各區間不重複掃。"""
+    if not hunks:
+        return []
+    if data is None:
+        return [""] * len(hunks)
+    needs = [c if d == 0 else c - 1 for c, d in hunks]
+    mx = max(needs)
+    lines = data.split(b"\n", mx)[:mx] if mx > 0 else []
+    at, top, inner, prev = {}, "", "", 0
+    for need in sorted(set(needs)):
+        end = min(need, len(lines))
+        t_new = i_new = None
+        for k in range(end - 1, prev - 1, -1):
+            ln = lines[k]
+            if ln[:1] and ln[0] in _NOTE_REREAD_TOP_BYTES:
+                s = ln.decode("utf-8", "surrogateescape")
+                m = _NOTE_REREAD_DEF_RE.match(s)
+                t_new = m.group(1) if m else _NOTE_REREAD_IDENT_RE.match(s).group(0)
+                break
+            if i_new is None and ln[:1] in (b" ", b"\t"):
+                m = _NOTE_REREAD_DEF_RE.match(ln.decode("utf-8", "surrogateescape").lstrip(" \t"))
+                if m:
+                    i_new = m.group(1)
+        if t_new is not None:
+            top, inner = t_new, i_new or ""
+        elif i_new is not None:
+            inner = i_new
+        prev = max(prev, end)
+        at[need] = top + ("/" + inner if inner else "")
+    return [at[n] for n in needs]
