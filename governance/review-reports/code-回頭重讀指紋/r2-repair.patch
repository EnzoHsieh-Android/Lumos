+def _rfp_twin_src(names, indent=""):
+    """幾個結構相同的函式(或方法):每個的本體前後三行都一樣,中間一行 check(user)。"""
+    out = []
+    for n in names:
+        out += [f"{indent}def {n}(user):"] + [f"{indent}    p{i} = {i}" for i in range(1, 4)] + [f"{indent}    check(user)"]
+        out += [f"{indent}    q{i} = {i}" for i in range(1, 4)] + [""]
+    return out
