+    主線只改了 check_b 的參數列(離改動超過三行)、rebase 上去 → 指紋不變。兩邊都先確認用的是 v2。
+    判準來源:代碼審 r1 資安席(major)、正確性席 1。翻紅釘:hunk 不帶所在函式的名字 → ②③紅;名字帶參數 → ④紅。"""
+    print("t_reread_fp_hunk_moved_between_functions")
+    m = _load_lumos_inproc()
+    src = "\n".join(_rfp_twin_src(["check_a", "check_b"]) + ["class H:"] + _rfp_twin_src(["public_list", "admin_list"], "    "))
+    root, base = _rfp_repo(lambda r: _nh_file(r, "src/a.py", src + "\n"))
+    lines = src.split("\n")
+    ln = {k: i + 1 for i, k in enumerate(lines)}
+
+    def branch(name, target):
+        _nh_git(root, "checkout", "-q", "-b", name, base)
+        idx = [i for i, t in enumerate(lines) if t.strip() == "check(user)"][target]
+        _rfp_line(root, "src/a.py", idx + 1, lines[idx].replace("check(user)", "allow(user)"))
+        _rr_touch(root, _rr_note("A"), "A 追加")
+        _nh_commit(root, name)
+        fps, _f, _o = _rfp_items(root, f"{base}..HEAD")
+        return fps.get(_rr_note("A")), _rfp_v1(m, root, _rr_note("A"), ["src/a.py"])
+    fa, va = branch("fa", 0)
+    fb, vb = branch("fb", 1)
+    fm1, vm1 = branch("fm1", 2)
+    fm2, vm2 = branch("fm2", 3)
