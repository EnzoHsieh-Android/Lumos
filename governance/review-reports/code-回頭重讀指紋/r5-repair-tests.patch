+def _rfp_insert(root, rel, n, text):
+    """rel 第 n 行(從 1 起)之前插一行 text。"""
+    p = root / rel
+    ls = p.read_text(encoding="utf-8").split("\n")
+    ls.insert(n - 1, text)
+    p.write_text("\n".join(ls), encoding="utf-8")
