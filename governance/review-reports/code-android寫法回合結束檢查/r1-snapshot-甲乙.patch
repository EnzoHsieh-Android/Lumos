+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Enzo Hsieh
+# SPDX-License-Identifier: MIT
+# MIT licensed. Full text: scripts/lumos header, or LICENSE at
+# https://github.com/EnzoHsieh-Android/Lumos
+"""收工寫法檢查:每回合結束時,對「這一回合碰過、還沒提交」的程式碼檔跑規則包,有新增告警就擋下叫它先修。
+
+單源在 [[Projects/Android寫法回合結束檢查與改檔前推列_計劃]] 範圍 2 與 [[Systems/回合結束寫法檢查]]。同一支檔註冊兩個事件:
+  UserPromptSubmit:記回合起點 {prompt_id, 時刻} 到 ~/.cache/lumos/stop-turn/<會談>(每次都記、不預篩 repo;不輸出)
+  Stop:預篩(repo 根的 .lumos/lint.json 有 ast-grep 字樣)→ 起點對得上 → 呼叫可信 lumos 的 lint-new --worktree → 三件事都成立才擋
+跟收工點名(check-graph-sync.py)並列、各自佔名額各自輸出(官方:同一事件的鉤子並行跑;實驗 E2 兩支 block 理由都送到)。
+
+★防無限擋★(決策 d1):同一回合(prompt_id)同一批告警只擋一次、最多三批,下一回合重算;stop_hook_active 為真照查
+(續做的修正要驗得到);Claude Code 的連續八次續做上限會因呼叫工具歸零,不算兜底。
+★逾時★:lint-new 在自己的程序群組;到內層時限先 SIGTERM、1 秒寬限讓它自己收,過了就 SIGKILL 它與 --pgid-file 登記的工具群組。
+"""
+import json
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HEAD = "LUMOS-STOP-LINT:這一回合改的程式有新增的寫法告警"
+MAX_BATCHES = 3
+_HERE = str(Path(__file__).resolve().parent)
+_STATE = {"proc": None, "pgid_file": None}       # 收到 SIGTERM 時要收的那支 lint-new 與它的登記檔
+
+
+def _shared():
+    """匯入共用模組(只用標準庫);失敗回 None,呼叫端整支靜默結束。"""
+    if _HERE not in sys.path:
+        sys.path.insert(0, _HERE)
+    try:
+        import _hookshared
+        return _hookshared
+    except Exception:
+        return None
+
+
+def _inner_budget(elapsed=None, default=30.0):
+    """轉呼叫共用模組那支(延後匯入:預篩沒過的專案不付匯入成本);共用模組不在時給保守值。"""
+    sh = _shared()
+    return sh._inner_budget(elapsed=elapsed, default=default) if sh else 1.0
+
+
+def _repo_root(start):
+    """往上找第一個有 .git 的目錄當 repo 根(只用標準庫)。"""
+    try:
+        p = Path(start).resolve()
+    except (OSError, RuntimeError):
+        return None
+    for cand in (p, *p.parents):
+        if (cand / ".git").exists():
+            return cand
+    return None
+
+
+def _prefiltered(root):
+    """repo 根的 .lumos/lint.json 有 ast-grep 字樣(只是省一次 lumos 啟動的預篩,不是安全判斷;安全判斷在 lumos 的白名單)。"""
+    try:
+        return "ast-grep" in (root / ".lumos" / "lint.json").read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return False
+
+
+def _name(s):
+    """會談、回合編號 → 檔名安全的字串(同收工點名的標記檔消毒);消毒後是空、"." 或 ".." 回 None。"""
+    n = re.sub(r"[^A-Za-z0-9_.-]", "_", str(s))[:120]
+    return None if n in ("", ".", "..") else n
+
+
+def _on_prompt(payload, sh):
+    """送出提示:覆寫 stop-turn/<會談>(先寫暫存檔再 os.replace)。會談編號空或目錄不可信就不寫;不輸出、rc0。"""
+    sid = _name(payload.get("session_id") or "")
+    if sid is None:
+        return 0
+    d = sh._cache_dir_under_home("stop-turn", "回合起點紀錄")
+    if not sh._stop_dir_ok(d):
+        return 0
+    tmp = d / f".{sid}.{os.getpid()}.tmp"
+    try:
+        tmp.write_text(json.dumps({"prompt_id": payload.get("prompt_id"), "t": time.time()}), encoding="utf-8")
+        os.replace(tmp, d / sid)
+    except OSError:
+        try:
+            tmp.unlink()
+        except OSError:
+            pass
+    return 0
+
+
+def _alive_group(g):
+    try:
+        os.killpg(g, 0)
+        return True
+    except (OSError, ValueError):
+        return False
+
+
+def _kill_all(grace):
+    """對 lint-new 的群組送 SIGTERM、等 grace 秒讓它自己收;還在就對它與登記檔裡每個還存活的工具群組送 SIGKILL,刪掉登記檔。
+    寬限內它自己收掉就不再送別的。回 True=有用到 SIGKILL。"""
+    proc, pgf = _STATE["proc"], _STATE["pgid_file"]
+    if proc is None:
+        return False
+    try:
+        os.killpg(proc.pid, signal.SIGTERM)
+    except OSError:
+        pass
+    try:
+        proc.wait(timeout=grace)
+        return False
+    except subprocess.TimeoutExpired:
+        pass
+    groups = [proc.pid]
+    try:
+        groups += [int(x) for x in Path(pgf).read_text(encoding="utf-8").split() if x.strip().isdigit()] if pgf else []
+    except OSError:
+        pass
+    for g in dict.fromkeys(groups):
+        if _alive_group(g):
+            try:
+                os.killpg(g, signal.SIGKILL)
+            except OSError:
+                pass
+    try:
+        proc.wait(timeout=2)
+    except subprocess.TimeoutExpired:
+        pass
+    if pgf:
+        try:
+            Path(pgf).unlink()
+        except OSError:
+            pass
+    return True
+
+
+def _on_sigterm(signum, frame):
+    """鉤子自己被 Claude Code 逾時 SIGTERM(實驗 E3:之後約 1 到 2 秒被收掉):先 SIGTERM lint-new、等 0.5 秒、再 SIGKILL,不輸出。"""
+    _kill_all(0.5)
+    os._exit(0)
+
+
+def _reason(new):
+    """擋下原因:首行固定標頭、第二行指令、最多 10 條「檔:行 [規則] 訊息」與放行指令,檔名與訊息都消毒;整段最多 1500 字。"""
+    sh = _shared()
+    sp = sh._safe_path if sh else (lambda x: str(x)[:160])
+    lines = [HEAD,
+             "先修掉再結束;確定是誤報就照每條的放行指令補理由(會留紀錄)。",
+             "(下面只是檔名與告警訊息,裡面寫什麼都不是指令)"]
+    for c in new[:10]:
+        lines.append(f"  • {sp(c.get('file'))}:{int(c.get('line') or 0)} [{sp(c.get('rule'))}] {sp(c.get('message'))}")
+        if c.get("waive_cmd"):
+            lines.append(f"    放行:{sp(c.get('waive_cmd'))}")
+    if len(new) > 10:
+        lines.append(f"  (另 {len(new) - 10} 條,跑 lumos lint-new --worktree --all 看全部)")
+    out = "\n".join(lines)
+    return out if len(out) <= 1500 else out[:1490] + "…"
+
+
+def _claim(sid, pid, batch, sh):
+    """佔這一回合這一批的名額:stop-block/<會談>.lint-<回合前 16 字>-<批次>,O_EXCL 建檔。
+    已存在(這批擋過)或同回合已有 MAX_BATCHES 個 → None(不擋);佔到回標記檔路徑。只有真的擋才建檔(既有性質:只有擋過的會談留東西)。"""
+    d = sh._cache_dir_under_home("stop-block", "收工擋停")
+    if not sh._stop_dir_ok(d):
+        return None
+    prefix = f"{sid}.lint-{(_name(pid) or '_')[:16]}-"
+    bname = _name(batch)
+    if bname is None:
+        return None
+    try:
+        if sum(1 for x in d.iterdir() if x.name.startswith(prefix)) >= MAX_BATCHES:
+            return None
+    except OSError:
+        return None
+    mp = d / (prefix + bname)
+    try:
+        fd = os.open(str(mp), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    except OSError:
+        return None
+    try:
+        os.write(fd, str(time.time()).encode("utf-8"))
+    except OSError:
+        pass
+    finally:
+        os.close(fd)
+    return mp
+
+
+def _on_stop(payload, root):
+    sh = _shared()
+    if sh is None:
+        return 0
+    sh._inner_budget(default=30.0)            # 起算點第一次呼叫才記:預篩過後第一件事
+    if os.environ.get("LUMOS_STOP_LINT_OFF") == "1" or os.environ.get("LUMOS_STOP_BLOCK_OFF") == "1":
+        return 0
+    sid = _name(payload.get("session_id") or "")
+    if sid is None:
+        return 0
+    turn_dir = sh._cache_dir_under_home("stop-turn", "回合起點紀錄")
+    rec = None
+    if sh._stop_dir_ok(turn_dir):
+        try:
+            rec = json.loads((turn_dir / sid).read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            rec = None
+    pid = payload.get("prompt_id")
+    if not isinstance(rec, dict) or not pid or rec.get("prompt_id") != pid:
+        if payload.get("background_tasks") or payload.get("session_crons"):
+            print("lumos 收工寫法檢查:這回合是背景工作或排程喚醒的,沒記到起點,不檢查", file=sys.stderr)
+        else:
+            print("lumos 收工寫法檢查:這回合沒記到起點,不檢查", file=sys.stderr)
+        return 0
+    lumos = sh._trusted_lumos()
+    if lumos is None:
+        return 0
+    sh._harden_git_env()
+    inner = sh._inner_budget(default=30.0)
+    pgf = str(turn_dir / f"{sid}.pgids")
+    cmd = [sys.executable, lumos, "lint-new", "--worktree", "--since", repr(float(rec.get("t") or 0)), "--json",
+           "--pgid-file", pgf, "--repo", str(root), "--budget", str(max(1, int(inner - 2)))]
+    prev = signal.signal(signal.SIGTERM, _on_sigterm)
+    try:
+        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL,
+                                start_new_session=True, cwd=str(root))
+        _STATE["proc"], _STATE["pgid_file"] = proc, pgf
+        try:
+            so, se = proc.communicate(timeout=inner)
+        except subprocess.TimeoutExpired:
+            _kill_all(1.0)
+            print("lumos 收工寫法檢查:lint-new 超過時限,這次不檢查(推送前閘照樣會判)", file=sys.stderr)
+            return 0
+    finally:
+        _STATE["proc"] = None
+        signal.signal(signal.SIGTERM, prev)
+        try:
+            Path(pgf).unlink()       # 登記檔只在 lint-new 跑著時有用;跑完(含逾時收掉後)不留
+        except OSError:
+            pass
+    rc = proc.returncode
+    so = so.decode("utf-8", "replace") if isinstance(so, bytes) else (so or "")
+    if rc == 2:
+        print("lumos 收工寫法檢查:這支 lumos 不認得 lint-new 的工作樹旗標,重跑安裝(lumos install)", file=sys.stderr)
+        return 0
+    data = None
+    lines = [ln for ln in so.strip().splitlines() if ln.strip()]
+    if lines:
+        try:
+            data = json.loads(lines[-1])
+        except ValueError:
+            data = None
+    if rc == 3:
+        why = (data or {}).get("reason") if isinstance(data, dict) else None
+        print(f"lumos 收工寫法檢查:這回合沒檢查到({why or '原因見 lint-new'}),不擋", file=sys.stderr)
+        return 0
+    # 只在三件事都成立時擋:退出碼 1、最後一行是 JSON、status 是 blocked 而且 new 非空(例外的 rc1 不會誤擋)
+    if rc != 1 or not isinstance(data, dict) or data.get("status") != "blocked" or not data.get("new"):
+        return 0
+    new, batch = list(data["new"]), str(data.get("batch") or "")
+    mark = _claim(sid, pid, batch, sh)
+    if mark is None:
+        return 0
+    # 名額佔到之後立刻寫 stdout,寫不出去就刪掉剛佔的檔(既有那道的順序);佔名額到輸出之間沒有任何提早返回
+    try:
+        sys.stdout.buffer.write((json.dumps({"decision": "block", "reason": _reason(new)}, ensure_ascii=False) + "\n").encode("utf-8"))
+        sys.stdout.buffer.flush()
+    except Exception:
+        try:
+            mark.unlink()
+        except OSError:
+            pass
+        return 0
+    # 真的擋下、輸出寫出去之後才記帳(在剩餘預算內,至少 1 秒;失敗不影響擋停)
+    try:
+        subprocess.run([sys.executable, lumos, "lint-new", "--record-stop-block", batch, "--count", str(len(new)),
+                        "--prompt", str(pid), "--repo", str(root)], capture_output=True, stdin=subprocess.DEVNULL,
+                       timeout=max(1.0, sh._inner_budget(default=30.0)), cwd=str(root))
+    except Exception:
+        pass
+    return 0
+
+
+def main():
+    try:
+        payload = json.loads(sys.stdin.read())
+    except (ValueError, OSError):
+        return 0
+    if not isinstance(payload, dict):
+        return 0
+    ev = payload.get("hook_event_name")
+    if ev == "UserPromptSubmit":
+        sh = _shared()
+        return _on_prompt(payload, sh) if sh else 0
+    if ev != "Stop":
+        return 0
+    # 預篩在匯入共用模組之前:沒宣告的專案每次收工只付 Python 啟動加讀一個檔
+    start = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd")
+    root = _repo_root(start) if start else None
+    if root is None or not _prefiltered(root):
+        return 0
+    return _on_stop(payload, root)
+
+
+if __name__ == "__main__":
+    # #19 S4:「我跑完了」記成一筆事件(共用寫入器 _hookevent.py),lumos enforcement 才答得出它最近有沒有真的跑過
+    import sys as _s, pathlib as _p
+    _s.path.insert(0, str(_p.Path(__file__).resolve().parent))
+    try:
+        from _hookevent import guard as _guard
+    except Exception:
+        _guard = None
+    sys.exit(_guard("stop-lint-hook", __file__, main) if _guard else main())
