+def _claim_mark(d: Path, name: str) -> bool:
+    """在標記目錄 d 底下用 O_EXCL 原子建檔佔名額(兩個 hook 同時來只有一個成功);目錄不可信、名字不安全或任何 OSError 都回 False=不擋(寧可漏)。
