+def _lwt_json(r):
+    import json as _j
+    lines = [ln for ln in (r.stdout or "").strip().splitlines() if ln.strip()]
+    try:
+        return _j.loads(lines[-1]) if lines else {}
+    except ValueError:
+        return {}
