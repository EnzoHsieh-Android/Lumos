+def _lwt_nogit_path(helper):
+    """只有 git 的 PATH(沒有 ast-grep):CI 有真的 ast-grep 也找不到。"""
+    import os as _os
+    import shutil as _sh
+    d = Path(helper) / "nobin"
+    d.mkdir(parents=True, exist_ok=True)
+    g = _sh.which("git")
+    if g and not (d / "git").exists():
