+def _lwt_put(root, rel, text, when):
+    """寫一支檔並把修改時間設成 when(epoch 秒)。"""
+    import os as _os
+    p = Path(root) / rel
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(text, encoding="utf-8")
+    _os.utime(p, (when, when))
+    return p
