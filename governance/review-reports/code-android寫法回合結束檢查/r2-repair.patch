+    check("r1戊 lint-new 的說明講到只有 --record-stop-block 記帳", "--record-stop-block" in (sub.stdout + r.stdout)
+          and "檢查本身不寫治理帳" in sub.stdout, sub.stdout[-400:])
+    m = _lng_module()
+    check("★前置★ r1戊 有共用骨架", callable(getattr(m, "_lint_new_out", None)), "")
