+            alive = None
+    finally:
+        _os.killpg = saved
+        hm._STATE["proc"] = None
+    check("r1乙 沒有 killpg 時查群組不崩、回 False", err is None and alive is False, repr(err))
+    check("r1乙 沒有 killpg 時逾時收尾不崩、lint-new 本身被收掉", err is None and p.poll() is not None, repr(err))
