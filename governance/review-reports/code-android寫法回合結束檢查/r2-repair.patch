+    import sys as _s
+    argv = _s.argv
+    got = None
+    for i, a in enumerate(argv):
+        if a == "--budget" and i + 1 < len(argv):
+            try:
+                got = float(argv[i + 1])
+            except ValueError:
+                got = None
+            break
+        if a.startswith("--budget="):
