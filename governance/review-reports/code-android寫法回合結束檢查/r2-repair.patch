+    p = _sp.Popen(["sleep", "30"], start_new_session=True)
+    saved = _os.killpg
+    err = None
+    try:
+        del _os.killpg
+        hm._STATE["proc"], hm._STATE["pgid_file"] = p, None
+        try:
+            alive = hm._alive_group(p.pid)
+            hm._kill_all(0.2)
+        except Exception as e:      # noqa: BLE001
