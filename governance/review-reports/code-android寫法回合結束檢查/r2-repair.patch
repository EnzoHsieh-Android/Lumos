+def t_slh_r1_no_killpg():
+    """[r1 乙] 沒有 os.killpg 的平台(Windows):逾時收尾不崩,退回收 lint-new 本身。出身:邊界席 F4(只捕 OSError,AttributeError 漏出去)。"""
