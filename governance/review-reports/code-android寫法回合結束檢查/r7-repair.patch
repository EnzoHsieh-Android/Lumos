 def _git_toplevel(repo_root):
     """取 repo 根的唯一一支(代碼審 r5 架構對齊席 F1:原本 lint-new 與影響分析各寫一份,失敗語意不同)→ 已經是根就回 repo_root 本身
     (路徑寫法不變)、是子目錄就回 git 的 repo 根、git 問不出來回 None。走 _lint_wt_git(不信任 repo 的 -c 參數)。
     呼叫端:lint-new --worktree(問不出來照原值,之後 _lint_wt_unready 判沒能檢查)、影響分析 _impact_wt_nofilter(問不出來整次 None)、
     cmd_impact_diff 的 --worktree-nofilter 判「--repo 是不是 git 專案」(子目錄底下沒有 .git,代碼審 r5 正確性席 F2、通才席 F2)。
-    收工點名鉤子的找改動(_wt_changed_nofilter)是逐字複本、匯入不到這支,自己取根。"""
+    收工點名鉤子的找改動(_wt_changed_nofilter)是逐字複本、匯入不到這支,自己取根。
+    ★跟派工鏡頭的 _lens_repo_root 不共用★(代碼審 r6 架構對齊席 F1):那支走 _lens_git、不帶 _git_untrusted_c,沒給 repo 時從目前目錄找、
+    一律回 git 印的根(macOS 暫存目錄會變成 /private/… 的寫法),給鏡頭在使用者自己的 repo 上用;這支專給收工路徑在被打開的、
+    不信任的目錄上用,要帶那份 -c 參數,已經是根時回原路徑寫法(下游拿它跟呼叫端給的路徑比前綴)。把兩支併成一支得替其中一邊改語意,
+    不在這次修補範圍。"""
     pfx = _lint_wt_git(repo_root, "rev-parse", "--show-prefix")
     top = _lint_wt_git(repo_root, "rev-parse", "--show-toplevel")
     if pfx is None or top is None or pfx.returncode != 0 or top.returncode != 0 or not top.stdout.strip():
         return None
     if not pfx.stdout.strip():
         return Path(repo_root)
     return Path(os.fsdecode(top.stdout[:-1] if top.stdout.endswith(b"\n") else top.stdout))
 
 
