     parts = _delta_parts(payload)
     full, full_tr = _join_capped([t for _n, t in parts], cap_bytes)
     new, new_tr = _join_capped([t for is_new, t in parts if is_new], cap_bytes)
     return full, full_tr, new, new_tr
 
