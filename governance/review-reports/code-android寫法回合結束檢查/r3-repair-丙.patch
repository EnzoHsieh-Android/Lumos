+def t_hook_r2_mark_event_verbatim():
+    """[r2 戊] 吞掉失敗時記事件的 _mark_event 在各支 hook 是逐字複本(說明文字除外;架構對齊席 F3:收工寫法檢查那份多了一層判斷、
