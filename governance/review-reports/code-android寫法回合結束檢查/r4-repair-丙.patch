+def _r3_impact_run(root, *extra, env=None):
+    import json as _j
+    import subprocess as _sp
+    r = _sp.run([sys.executable, GRAPHCTL, "impact", "--diff", "HEAD", "--sync-check", "--json", "--repo", str(root), *extra],
+                capture_output=True, text=True, env=env, timeout=120)
