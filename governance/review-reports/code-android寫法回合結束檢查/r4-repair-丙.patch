+    print("t_r3_one_def_probe")
+    one = "def f():\n    return 1\n\n\ndef main():\n    return f()\n"
+    check("r3丁 恰好一個定義 → 乾淨", _r3_one_def_problems(one, "f") == [], str(_r3_one_def_problems(one, "f")))
