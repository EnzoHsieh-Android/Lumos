+                         ("import 別名", "from shutil import which as f\n"), ("setattr 字串", "import sys\nsetattr(sys.modules[__name__], 'f', print)\n"),
+                         ("巢狀第二個定義", "def g():\n    def f():\n        return 3\n    return f\n")):
