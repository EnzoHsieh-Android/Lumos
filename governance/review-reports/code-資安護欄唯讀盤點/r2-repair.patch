+# 逐層 dir_fd+O_NOFOLLOW 開檔、單檔/總量/檔數/項目數都有上限、讀前讀後比屬性並重列舉,只回記憶體快照(不建 Note)。
+# 誰用哪種:讀不可信圖譜而且輸出要當證據看的指令(目前只有 security list)用 safe,再交 Env.from_texts;其他照舊用 load_vault。
+_VAULT_SAFE_FILE_MAX = 2 * 1024 * 1024          # 單檔上限(計劃〈實務隱患〉防失控設計值,不是量測容量)
+_VAULT_SAFE_TOTAL_MAX = 64 * 1024 * 1024        # 全部內容快照上限
+_VAULT_SAFE_FILES_MAX = 10000                   # Markdown 檔數上限;見第 10001 檔就停
+_VAULT_SAFE_ENTRIES_MAX = 50000                 # 列舉的總項目數上限(含非 .md 與目錄;代碼審 r1 資源席:只限 .md 時 30 萬個 .txt 吃掉 260MB)
+# 必要的平台能力在載入時算好(之後就算有人換掉 os 模組的屬性也不影響判斷)
+_VAULT_SAFE_OK = bool(hasattr(os, "O_NOFOLLOW") and hasattr(os, "O_DIRECTORY")
+                            and os.open in getattr(os, "supports_dir_fd", ()) and os.scandir in getattr(os, "supports_fd", ())
+                            and os.stat in getattr(os, "supports_dir_fd", ()))
+
+
+def _vault_safe_attrs(st):
+    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+
+
+def _vault_safe_list_dir(fd, rel, md_left, entries_left):
+    """一層目錄 → ([(名字, lstat)] 依名字排序, 是否超過總項目上限)。串流讀:.md 數超過 md_left、或總項目數超過 entries_left 就停
+    (不讀完整層;.md 超限由呼叫端見到第 md_left+1 個時記)。rel 只用來定位(錯誤訊息、測試替身)。"""
+    out, md = [], 0
+    with os.scandir(fd) as it:
+        for e in it:
+            if len(out) >= entries_left:
+                return out, True
+            out.append((e.name, e.stat(follow_symlinks=False)))
+            if e.name.endswith(".md"):
+                md += 1
+                if md > md_left:
+                    break
+    out.sort(key=lambda x: x[0])
+    return out, False
+
+
+def _vault_safe_entry_kind(name, mode):
+    """列舉到的一項 → link / dir / md / special / skip(不是 .md 的一般檔或特殊檔不管)。"""
+    import stat as _stat
+    if _stat.S_ISLNK(mode):
+        return "link"
+    if _stat.S_ISDIR(mode):
+        return "dir"
+    if not name.endswith(".md"):
+        return "skip"
+    return "md" if _stat.S_ISREG(mode) else "special"
+
+
+def _vault_safe_walk(dfd, rel_dir, manifest, errors, state):
+    """_vault_safe_enumerate 的一層:捷徑一律拒絕(檔或目錄都不跟),.md 的特殊檔拒絕,子目錄用 O_DIRECTORY|O_NOFOLLOW 開。"""
+    try:
+        entries, too_many = _vault_safe_list_dir(dfd, rel_dir or ".", _VAULT_SAFE_FILES_MAX - len(manifest),
+                                                 _VAULT_SAFE_ENTRIES_MAX - state["entries"])
+    except OSError as e:
+        errors.append(_vault_issue("enumeration_failed", nfc(rel_dir or "."), detail=e.strerror or type(e).__name__))
+        return
+    state["entries"] += len(entries)
+    if too_many:
+        state["over"] = True
+        errors.append(_vault_issue("enumeration_failed", nfc(rel_dir or "."),
+                                   detail=f"列舉的總項目數(含非 .md 與目錄)超過 {_VAULT_SAFE_ENTRIES_MAX},停止列舉"))
+        return
+    for name, st in entries:
+        rel = f"{rel_dir}/{name}" if rel_dir else name
+        kind = _vault_safe_entry_kind(name, st.st_mode)
+        if kind == "link":
+            errors.append(_vault_issue("symlink_rejected", nfc(rel), detail="捷徑不跟隨、不讀"))
+        elif kind == "special":
+            errors.append(_vault_issue("special_file", nfc(rel), detail="不是一般檔,不讀"))
+        elif kind == "dir":
+            _vault_safe_descend(dfd, name, rel, manifest, errors, state)
+        elif kind == "md" and len(manifest) >= _VAULT_SAFE_FILES_MAX:
+            state["over"] = True
+            errors.append(_vault_issue("too_many_files", nfc(rel), detail=f"Markdown 超過 {_VAULT_SAFE_FILES_MAX} 個,見到這一個就停止列舉"))
+        elif kind == "md":
+            manifest[rel] = _vault_safe_attrs(st)
+        if state["over"]:
+            return
+
+
+def _vault_safe_descend(dfd, name, rel, manifest, errors, state):
+    try:
+        sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
+    except OSError as e:
+        errors.append(_vault_issue("enumeration_failed", nfc(rel), detail=e.strerror or type(e).__name__))
+        return
+    try:
+        _vault_safe_walk(sub, rel, manifest, errors, state)
+    finally:
+        os.close(sub)
+
+
+def _vault_safe_enumerate(root_fd):
+    """整個圖譜列一次 → (manifest {相對路徑: 屬性}, 錯誤, 是否超過檔數上限)。"""
+    manifest, errors, state = {}, [], {"over": False, "entries": 0}
+    try:
+        _vault_safe_walk(root_fd, "", manifest, errors, state)
+    except RecursionError:
+        errors.append(_vault_issue("enumeration_failed", ".", detail="目錄巢狀太深"))
+    return manifest, errors, state["over"]
+
+
+def _vault_safe_open_rel(root_fd, rel):
+    """從圖譜根的代號逐層開到 rel:中間目錄 O_DIRECTORY|O_NOFOLLOW,檔案走 _regular_own_fd(dir_fd,不跟捷徑、非阻塞、開檔後判一般檔)。
+    → 檔案代號或 None。中間目錄代號用完就關。"""
+    parts = rel.split("/")
+    opened = []
+    try:
+        d = root_fd
+        for p in parts[:-1]:
+            d = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=d)
+            opened.append(d)
+        return _regular_own_fd(parts[-1], os.O_RDONLY, require_owner=False, dir_fd=d)
+    except OSError:
+        return None
+    finally:
+        for f in opened:
+            os.close(f)
+
+
+def _vault_safe_lstat_rel(root_fd, rel):
+    """rel 現在的 lstat 屬性(不跟捷徑);拿不到回 None。只用來分辨「開不了」是被換掉還是單純讀不到。"""
+    parts = rel.split("/")
+    opened = []
+    try:
+        d = root_fd
+        for p in parts[:-1]:
+            d = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=d)
+            opened.append(d)
+        return _vault_safe_attrs(os.stat(parts[-1], dir_fd=d, follow_symlinks=False))
+    except OSError:
+        return None
+    finally:
+        for f in opened:
+            os.close(f)
+
+
+def _vault_safe_read_rel(root_fd, rel, remaining):
+    """有界讀一個檔 → (開檔後 fstat, 讀完 fstat, 內容 bytes 或 None, 問題種類或 None)。
+    最多讀 min(單檔上限, 剩餘總額度)+1 位元組;先判容量,超限不回內容(不解碼、不解析)。開不了回 (None, None, None, "open_failed")。"""
+    fd = _vault_safe_open_rel(root_fd, rel)
+    if fd is None:
+        return None, None, None, "open_failed"
+    try:
+        st0 = os.fstat(fd)
+        if st0.st_size > _VAULT_SAFE_FILE_MAX:
+            return st0, st0, None, "file_too_large"
+        if st0.st_size > remaining:
+            return st0, st0, None, "total_size_exceeded"
+        want = min(_VAULT_SAFE_FILE_MAX, remaining) + 1
+        buf = bytearray()
+        while len(buf) < want:
+            chunk = os.read(fd, want - len(buf))
+            if not chunk:
+                break
+            buf += chunk
+        st1 = os.fstat(fd)
+        if len(buf) > _VAULT_SAFE_FILE_MAX:
+            return st0, st1, None, "file_too_large"
+        if len(buf) > remaining:
+            return st0, st1, None, "total_size_exceeded"
+        return st0, st1, bytes(buf), None
+    finally:
+        os.close(fd)
+
+
+def _vault_safe_read_one(root_fd, rel, manifest, snap, run):
+    """快照的一篇:有界讀、比對列舉時的屬性、解碼。run 是這一輪的累計狀態(total、exhausted、skipped、changed)。"""
+    errors = snap["errors"]
+    if run["exhausted"]:
+        run["skipped"].append(nfc(rel))
+        return
+    try:
+        st0, st1, data, why = _vault_safe_read_rel(root_fd, rel, _VAULT_SAFE_TOTAL_MAX - run["total"])
+    except OSError as e:
+        errors.append(_vault_issue("read_error", nfc(rel), detail=e.strerror or type(e).__name__))
+        return
+    if why == "open_failed":
+        if _vault_safe_lstat_rel(root_fd, rel) != manifest[rel]:
+            run["changed"].add(rel)
+            errors.append(_vault_issue("changed_during_read", nfc(rel), detail="開檔時已不是列舉時那個一般檔(被刪、換成捷徑或特殊檔)"))
+        else:
+            errors.append(_vault_issue("read_error", nfc(rel), detail="開不了檔"))
+        return
+    if why == "file_too_large":
+        errors.append(_vault_issue("file_too_large", nfc(rel), detail=f"超過單檔上限 {_VAULT_SAFE_FILE_MAX} 位元組,不解析"))
+        return
+    if why == "total_size_exceeded":
+        run["exhausted"] = True
+        errors.append(_vault_issue("total_size_exceeded", nfc(rel), detail=f"累計超過 {_VAULT_SAFE_TOTAL_MAX} 位元組,這篇與後面都不讀",
+                                  unread=run["skipped"]))
+        return
+    if _vault_safe_attrs(st0) != manifest[rel] or _vault_safe_attrs(st1) != manifest[rel] or len(data) != st0.st_size:
+        run["changed"].add(rel)
+        errors.append(_vault_issue("changed_during_read", nfc(rel), detail="讀取前後的檔案屬性與列舉時不同"))
+        return
+    run["total"] += len(data)
+    snap["stats"]["files"] += 1
+    try:
+        snap["texts"].append((rel, data.decode("utf-8-sig")))
+    except UnicodeDecodeError:
+        snap["unreadable"].append(rel)
+        errors.append(_vault_issue("not_utf8", nfc(rel), detail="不是 UTF-8"))
+
+
+def _vault_safe_recheck(root_fd, manifest, changed, errors):
+    """讀完重列舉一次(沿用同一個檔數上限),集合或屬性有差就列 changed_during_read。"""
+    manifest2, errs2, _over2 = _vault_safe_enumerate(root_fd)
+    seen = {(e["kind"], e["node"]) for e in errors}
+    diff = (set(manifest) ^ set(manifest2)) | {r for r in manifest if r in manifest2 and manifest2[r] != manifest[r]}
+    for r in sorted(diff - changed):
+        errors.append(_vault_issue("changed_during_read", nfc(r), detail="讀完重列舉時,這個路徑新增、消失或屬性變了"))
+    for e in errs2:
+        if (e["kind"], e["node"]) not in seen:
+            errors.append(_vault_issue("changed_during_read", e["node"], detail=f"重列舉時才出現的問題:{e['kind']}"))
+
+
+def load_vault_safe(vault):
+    """安全讀整個圖譜進記憶體 → {"texts": [(原始相對路徑, 全文)], "unreadable": [...], "errors": [...], "stats": {...}}。
+    完不完整由 _secinv_build 依錯誤種類判(只有一處算)。每篇只讀一次;後面所有解析與引用都從這份快照拿,不再開檔。"""
+    snap = {"texts": [], "unreadable": [], "errors": [],
+            "stats": {"files": 0, "bytes": 0, "limits": {"file_bytes": _VAULT_SAFE_FILE_MAX, "total_bytes": _VAULT_SAFE_TOTAL_MAX,
+                                                         "files": _VAULT_SAFE_FILES_MAX, "entries": _VAULT_SAFE_ENTRIES_MAX}}}
+    if not _VAULT_SAFE_OK:
+        snap["errors"].append(_vault_issue("unsupported_safe_read", ".", detail="這個平台沒有 dir_fd/O_NOFOLLOW/O_DIRECTORY,不降級成跟隨捷徑的讀法"))
+        return snap
+    try:     # 圖譜根本身也不跟捷徑(最後一段;上層路徑照系統解析,代碼審 r1 資安席 F3)
+        root_fd = os.open(str(vault), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    except OSError as e:
+        kind = "symlink_rejected" if os.path.islink(str(vault)) else "read_error"
+        snap["errors"].append(_vault_issue(kind, ".", detail=e.strerror or type(e).__name__))
+        return snap
+    try:
+        manifest, errs, overflow = _vault_safe_enumerate(root_fd)
+        snap["errors"].extend(errs)
+        run = {"total": 0, "exhausted": False, "skipped": [], "changed": set()}
+        for rel in sorted(manifest, key=lambda r: r.split("/")):
+            _vault_safe_read_one(root_fd, rel, manifest, snap, run)
+        snap["stats"]["bytes"] = run["total"]
+        if not overflow:
+            _vault_safe_recheck(root_fd, manifest, run["changed"], snap["errors"])
+    finally:
+        os.close(root_fd)
+    return snap
+
+
+def _vault_issue(kind, node, **kw):
+    e = {"kind": kind, "node": node}
+    e.update(kw)
+    return e
