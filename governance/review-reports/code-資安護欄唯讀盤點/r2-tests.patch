+def t_seclist_g8_read_request_bound():
+    """G8(S10 補):讀取請求真的不超過「剩餘總額度+1」;檔案在 fstat 之後長大也不多讀、不採用。"""
+    import os as _os
+    mod = _load_lumos_inproc()
+    v = mkvault()
+    p = v / "Systems" / "Grow.md"
+    p.write_bytes(b"x" * 50)
+    reads = []
+    orig_os = mod.os
+
+    class _OsSpy:
+        def __getattr__(self, k):
+            return getattr(orig_os, k)
+
+        def read(self, fd, n):
+            if not reads:
+                with open(p, "ab") as f:      # fstat 之後、第一次讀之前長大
+                    f.write(b"y" * 1000)
+            reads.append(n)
+            return orig_os.read(fd, n)
+    root = _os.open(str(v), _os.O_RDONLY | _os.O_DIRECTORY)
+    mod.os = _OsSpy()
+    try:
+        st0, _st1, data, why = mod._vault_safe_read_rel(root, "Systems/Grow.md", 100)
+    finally:
+        mod.os = orig_os
+        _os.close(root)
+    check("G8 前置:檔案在讀取前長大了", p.stat().st_size == 1050 and st0 is not None and st0.st_size == 50)
+    check("G8 讀取請求不超過剩餘額度+1(101)", reads and max(reads) <= 101 and sum(reads) <= 101 + 101, str(reads))
+    check("G8 長大的檔不回內容", data is None and why == "total_size_exceeded", f"{why} {None if data is None else len(data)}")
