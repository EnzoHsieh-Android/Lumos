+def t_seclist_g1_field_type_fuzz():
+    """G1:控制項、inventory、頂層每個欄位依序換成容器、數字、布林、null、代理字元:不得崩潰;
+    JSON 可解析且能編成 UTF-8;不合法的退出 2;同庫正常控制項照列。"""
+    import copy as _cp, json as _j
+    v = _sl_vault()
+    write(v, "Systems/SlGood.md", "type: system\nstatus: done", body="# g\n" + _sl_block([_sl_ctrl("GOOD-1")]))
+    base_c = _sl_ctrl("FZ-1", exception={"decision_ref": "Systems/SlPay#d1", "reason": "r", "expires_on": "2026-12-31"})
+    base_ret = _sl_ctrl("FZ-R", lifecycle="retired", retirement_reason="拿掉", replacement_id="GOOD-1")
+    paths = [("c", k) for k in base_c] + [("c", "source", k) for k in ("kind", "claim", "decision_ref")] \
+        + [("c", "evidence_refs", 0, k) for k in ("kind", "node")] + [("c", "exception", k) for k in base_c["exception"]] \
+        + [("r", "retirement_reason"), ("r", "replacement_id")] \
+        + [("inv", k) for k in ("revision", "decision_ref", "assets", "surfaces")] \
+        + [("inv", "assets", 0, "id"), ("inv", "assets", 0, "description"), ("inv", "surfaces", 0, "id"),
+           ("inv", "surfaces", 0, "asset_ids"), ("inv", "surfaces", 0, "description"), ("inv", "surfaces", 0, "asset_ids", 0)] \
+        + [("top", "schema_version"), ("top", "controls"), ("top", "inventory")]
+    crashes, wrong_rc, lost_good, bad_json = [], [], [], []
+    inv_note = v / "Systems" / "SlInv.md"
+    for path in paths:
+        for val in _SL_WEIRD:
+            c, ret, inv = _cp.deepcopy(base_c), _cp.deepcopy(base_ret), _sl_inventory()
+            top = {"schema_version": 1, "controls": [c, ret]}
+            target = {"c": c, "r": ret, "inv": inv, "top": top}[path[0]]
+            _sl_set_path(target, path[1:], _cp.deepcopy(val))
+            if path[0] == "top" and path[1] == "controls":
+                top["controls"] = _cp.deepcopy(val)
+            (v / "Systems" / "SlFz.md").write_text("---\ntype: system\nstatus: done\n---\n# fz\n```lumos-security-v1\n"
+                                                    + _j.dumps(top, ensure_ascii=True) + "\n```\n", encoding="utf-8")
+            inv_note.write_text("---\ntype: system\nstatus: done\n---\n# inv\n```lumos-security-v1\n"
+                                + _j.dumps({"schema_version": 1, "controls": [], "inventory": inv}, ensure_ascii=True)
+                                + "\n```\n", encoding="utf-8")
+            label = f"{'.'.join(map(str, path))}={val!r}"
+            try:
+                rc, doc, _err = _sl_inproc(v)
+            except Exception as e:      # 指令自己崩潰:就是本題要抓的
