+    import hashlib as _h, json as _j, socket as _sock, subprocess as _sp
+    v = _sl_vault()
+    pwn = v.parent / "PWNED"
+    bait = f"$(touch {pwn}) `touch {pwn}` ; touch {pwn}"
+    write(v, "Systems/SlBait.md", "type: system\nstatus: done", body="# bait\n" + _sl_block([
+        _sl_ctrl("BAIT-1", scope=bait, abuse_case="\x1b[31mRED\x1b[0m ‮evil‬ \x07",
