+# ── security list 代碼審 r1 修正(governance/review-reports/code-資安護欄唯讀盤點/r1-intake.md G1 到 G8)──────────
+# 預期值照子計劃〈鍵的必填規則〉〈CLI契約〉〈輸出契約〉與 intake 的裁定手寫。
+
+_SL_WEIRD = ([], {}, 0, 1.5, True, None, "\ud800", "a\ud800", [[]], [{}], ["\ud800"], [1])
+_SL_NULLABLE = ("scope", "trust_boundary", "enforcement", "legitimate_control", "abuse_case",
+                "status_reason", "owner", "revalidate_when")
+
+
+def _sl_set_path(obj, path, value):
+    cur = obj
+    for k in path[:-1]:
+        cur = cur[k]
+    cur[path[-1]] = value
+
+
+def _sl_fuzz_legal(path, value):
+    """子計劃〈鍵的必填規則〉:哪些(欄位, 值)本身合法。合法的不該退出 2;其餘都是 schema 或引用錯誤。"""
+    head = path[0]
+    if value is None and len(path) == 2 and path[0] in ("c", "r") and path[1] in (*_SL_NULLABLE, "exception", "replacement_id"):
+        return True
+    if value == [] and type(value) is list and path in (("c", "assets"), ("c", "surfaces"), ("c", "required_evidence"),
+                                                        ("c", "evidence_refs"), ("top", "controls"),
+                                                        ("inv", "surfaces", 0, "asset_ids")):
+        return True
+    return head == "never"
+
