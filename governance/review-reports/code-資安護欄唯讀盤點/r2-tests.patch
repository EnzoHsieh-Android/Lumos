+    _os.symlink(str(secret), str(v / "Systems" / "SlLink.md"))
+    _os.symlink(str(outside), str(v / "Systems" / "LinkDir"))
+    write(v, "Systems/SlOld.md", "type: system\nstatus: superseded\nsummary: |-\n  KEY:★INVARIANT★ 舊合約 [test:t_x]")
+    write(v, "Systems/SlRefs.md", "type: system\nstatus: done", body="# r\n" + _sl_block([
+        _sl_ctrl("OK-1"),
+        _sl_ctrl("ESC-1", evidence_refs=[{"kind": "behavior", "node": "../outside/secret.md"}]),
+        _sl_ctrl("ABS-1", evidence_refs=[{"kind": "behavior", "node": str(secret)}]),
+        _sl_ctrl("MISS-1", source={"kind": "invariant", "node": "Systems/SlNope", "exact_claim": "不存在",
+                                   "decision_ref": "Systems/SlPay#d1"}),
+        _sl_ctrl("OLD-1", source={"kind": "invariant", "node": "Systems/SlOld", "exact_claim": "舊合約",
+                                  "decision_ref": "Systems/SlPay#d1"}),
+    ]))
+    r, doc = _sl_json(v)
+    doc = doc or {}
+    check("S3 有越界或連結時退出 2", r.returncode == 2, f"rc={r.returncode}")
+    check("S3 檔案捷徑列 symlink_rejected", bool(_sl_err(doc, "symlink_rejected", "Systems/SlLink.md")), str(doc.get("errors"))[:900])
+    check("S3 目錄捷徑列 symlink_rejected", bool(_sl_err(doc, "symlink_rejected", "Systems/LinkDir")), str(doc.get("errors"))[:900])
+    check("S3 哨兵內容零外洩", "SENTINEL-SECRET" not in r.stdout + r.stderr and "OUTSIDE-1" not in r.stdout)
+    refs = {(e.get("id"), e.get("field")) for e in _sl_err(doc, "reference_error")}
+    for cid, field in (("ESC-1", "evidence_refs"), ("ABS-1", "evidence_refs"), ("MISS-1", "source"), ("OLD-1", "source")):
+        check(f"S3 {cid} 的 {field} 被拒為 reference_error", (cid, field) in refs, str(refs))
