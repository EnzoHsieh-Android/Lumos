+    write(v, "Systems/SlCrlf.md", "type: system\nstatus: done", body=_sl_block([_sl_ctrl("CRLF-1")]).replace("\n", "\r\n"))
+    write(v, "Systems/SlMarkUnclosed.md", "type: system\nstatus: done", body="# u\n提到 lumos-security-v1\n```python\nx\n")
+    write(v, "Systems/SlOldUnclosed.md", "type: system\nstatus: done", body="# old\n```python\nx\n")
+    write(v, "Systems/SlStrictOnly.md", "type: system\nstatus: done",
+          body="# s\n" + _sl_block([_sl_ctrl("STRICT-1")]) + "```py\nx\n```py\n")
+    _r, doc = _sl_json(v)
+    doc = doc or {}
+    ids = _sl_ids(doc.get("records"))
+    check("S12 合法登記與範例混在同篇:只認頂層那塊", "FENCE-OK" in ids and "EXAMPLE-1" not in ids, str(ids))
+    check("S12 範例篇不報錯", not [e for e in doc.get("errors", []) if e.get("node") == "Systems/SlMixed.md"], str(doc.get("errors"))[:600])
+    for node in ("Systems/SlIndent.md", "Systems/SlQuote.md", "Systems/SlTrail.md"):
