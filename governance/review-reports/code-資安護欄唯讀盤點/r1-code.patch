+    opened_inodes = []
+
+    class _OsSpy:
+        def __getattr__(self, k):
+            return getattr(orig_os, k)
+
+        def open(self, *a, **kw):
+            fd = orig_os.open(*a, **kw)
+            try:
+                opened_inodes.append(orig_os.fstat(fd).st_ino)
+            except OSError:
+                pass
+            return fd
