+def _fence_regions(lines, strict):
+    """圍欄區段的唯一判定(_visible_lines 與 security list 共用) → (區段清單, 收尾時還有沒有圍欄開著)。
+    區段是 (開頭行索引, 收尾行索引);沒關到的最後一段收尾是 None。行索引從 0 起。
+    strict=照 CommonMark(收尾那行除了圍欄字元只能有空白);寬鬆讀法同字元、長度夠就算關。
+    規則細節(縮排 ≤3 格、tab 不算、不偵測 HTML 註解)見 _visible_lines 的說明;本函式只回區段,不做退回寬鬆——
+    要不要退回由呼叫端決定(_visible_lines 退回;專用安全登記不退回,未閉合直接列錯)。"""
+    fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
+    start = None
+    regions = []
+    # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
+    for i, ln in enumerate(lines):
+        indent = len(ln) - len(ln.lstrip(" "))
+        s = ln.lstrip(" ")
+        # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
+        if not (indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))):
+            continue
+        ch = s[0]
+        run = len(s) - len(s.lstrip(ch))
+        if fence is None:
+            fence, start = (ch, run), i
+            continue
+        if ch == fence[0] and run >= fence[1] and (not strict or s[run:].strip() == ""):
+            regions.append((start, i))
+            fence = None
+    if fence is not None:
+        regions.append((start, None))
+    return regions, fence is not None
