+def _secinv_open_rel(root_fd, rel):
+    """從圖譜根的代號逐層開到 rel:中間目錄 O_DIRECTORY|O_NOFOLLOW,檔案走 _regular_own_fd(dir_fd,不跟捷徑、非阻塞、開檔後判一般檔)。
+    → 檔案代號或 None。中間目錄代號用完就關。"""
+    parts = rel.split("/")
+    opened = []
+    try:
+        d = root_fd
+        for p in parts[:-1]:
+            d = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=d)
+            opened.append(d)
+        return _regular_own_fd(parts[-1], os.O_RDONLY, require_owner=False, dir_fd=d)
+    except OSError:
+        return None
+    finally:
+        for f in opened:
+            os.close(f)
+
+
+def _secinv_lstat_rel(root_fd, rel):
+    """rel 現在的 lstat 屬性(不跟捷徑);拿不到回 None。只用來分辨「開不了」是被換掉還是單純讀不到。"""
+    parts = rel.split("/")
+    opened = []
+    try:
+        d = root_fd
+        for p in parts[:-1]:
+            d = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=d)
+            opened.append(d)
+        return _secinv_attrs(os.stat(parts[-1], dir_fd=d, follow_symlinks=False))
+    except OSError:
+        return None
+    finally:
+        for f in opened:
+            os.close(f)
