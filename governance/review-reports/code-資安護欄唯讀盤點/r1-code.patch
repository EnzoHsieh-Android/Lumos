+def _secinv_walk(dfd, rel_dir, manifest, errors, state):
+    """_secinv_enumerate 的一層:捷徑一律拒絕(檔或目錄都不跟),.md 的特殊檔拒絕,子目錄用 O_DIRECTORY|O_NOFOLLOW 開。"""
+    try:
+        entries, _over = _secinv_list_dir(dfd, rel_dir or ".", _SECINV_FILES_MAX - len(manifest))
+    except OSError as e:
+        errors.append(_secinv_err("enumeration_failed", nfc(rel_dir or "."), detail=e.strerror or type(e).__name__))
+        return
+    for name, st in entries:
+        rel = f"{rel_dir}/{name}" if rel_dir else name
+        kind = _secinv_entry_kind(name, st.st_mode)
+        if kind == "link":
+            errors.append(_secinv_err("symlink_rejected", nfc(rel), detail="捷徑不跟隨、不讀"))
+        elif kind == "special":
+            errors.append(_secinv_err("special_file", nfc(rel), detail="不是一般檔,不讀"))
+        elif kind == "dir":
+            _secinv_descend(dfd, name, rel, manifest, errors, state)
+        elif kind == "md" and len(manifest) >= _SECINV_FILES_MAX:
+            state["over"] = True
+            errors.append(_secinv_err("too_many_files", nfc(rel), detail=f"Markdown 超過 {_SECINV_FILES_MAX} 個,見到這一個就停止列舉"))
+        elif kind == "md":
+            manifest[rel] = _secinv_attrs(st)
+        if state["over"]:
+            return
+
