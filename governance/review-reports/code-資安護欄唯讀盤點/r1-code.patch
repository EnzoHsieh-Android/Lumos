+def _secinv_list_dir(fd, rel, md_left):
+    """一層目錄 → ([(名字, lstat)] 依名字排序, 是否超過 md_left 個 .md)。串流讀,.md 數超過 md_left 就停(不讀完整層)。
+    rel 只用來定位(錯誤訊息、測試替身)。"""
+    out, md = [], 0
+    with os.scandir(fd) as it:
+        for e in it:
+            out.append((e.name, e.stat(follow_symlinks=False)))
+            if e.name.endswith(".md"):
+                md += 1
+                if md > md_left:
+                    break
+    out.sort(key=lambda x: x[0])
+    return out, md > md_left
