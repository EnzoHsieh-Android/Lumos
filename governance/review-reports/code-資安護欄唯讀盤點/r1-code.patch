+    def swapping(root_fd, rel, remaining):
+        if rel == "Systems/SlSwap.md" and not swap.is_symlink():
+            swap.unlink()
+            _os.symlink(str(sec2), str(swap))
+        return orig_read(root_fd, rel, remaining)
+    mod._secinv_read_rel, mod.os = swapping, _OsSpy()
