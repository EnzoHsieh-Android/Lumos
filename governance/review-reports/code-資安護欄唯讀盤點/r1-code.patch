+def _secinv_descend(dfd, name, rel, manifest, errors, state):
+    try:
+        sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
+    except OSError as e:
+        errors.append(_secinv_err("enumeration_failed", nfc(rel), detail=e.strerror or type(e).__name__))
+        return
+    try:
+        _secinv_walk(sub, rel, manifest, errors, state)
+    finally:
+        os.close(sub)
+
+
+def _secinv_enumerate(root_fd):
+    """整個圖譜列一次 → (manifest {相對路徑: 屬性}, 錯誤, 是否超過檔數上限)。"""
+    manifest, errors, state = {}, [], {"over": False}
+    try:
+        _secinv_walk(root_fd, "", manifest, errors, state)
+    except RecursionError:
+        errors.append(_secinv_err("enumeration_failed", ".", detail="目錄巢狀太深"))
+    return manifest, errors, state["over"]
+
