+def t_seclist_s11_change_during_read():
+    """S11:讀 A 之後改寫已讀 A、改寫未讀 B、新增檔、刪除檔 → 列不完整並退出 2;沒有變動的對照退出 0。"""
+    import os as _os
+    mod = _load_lumos_inproc()
+    orig_read = mod._secinv_read_rel
+
+    def scenario(mutate):
+        v = _sl_vault()
+        write(v, "Systems/SlA.md", "type: system\nstatus: done", body="# A\n")
+        write(v, "Systems/SlB.md", "type: system\nstatus: done", body="# B\n")
+        fired = []
+
+        def hooked(root_fd, rel, remaining):
+            res = orig_read(root_fd, rel, remaining)
+            if rel == "Systems/SlA.md" and not fired:
+                fired.append(1)
+                mutate(v)
+            return res
+        mod._secinv_read_rel = hooked
+        try:
+            rc, doc, _err = _sl_inproc(v)
+        finally:
+            mod._secinv_read_rel = orig_read
+        return rc, doc or {}, fired
+
+    def rewrite(rel, text):
+        def f(v):
+            p = v / rel
+            st = p.stat()
+            p.write_text(text, encoding="utf-8")
+            _os.utime(p, ns=(st.st_atime_ns, st.st_mtime_ns + 5_000_000_000))
+        return f
+    rc0, d0, f0 = scenario(lambda v: None)
+    check("S11 對照:沒有變動退出 0、read_complete=true", f0 and rc0 == 0 and d0.get("read_complete") is True, str(d0.get("errors"))[:400])
+    cases = (("改寫已讀 A", rewrite("Systems/SlA.md", "---\ntype: system\n---\n# A2\n"), "Systems/SlA.md"),
+             ("改寫未讀 B", rewrite("Systems/SlB.md", "---\ntype: system\n---\n# B2\n" + _sl_block([_sl_ctrl("B-NEW")])),
+              "Systems/SlB.md"),
+             ("新增檔", lambda v: (v / "Systems" / "SlNew.md").write_text("# new\n", encoding="utf-8"), "Systems/SlNew.md"),
+             ("刪除未讀檔", lambda v: (v / "Systems" / "SlB.md").unlink(), "Systems/SlB.md"))
+    for label, mut, path in cases:
+        rc, d, fired = scenario(mut)
+        hits = [e for e in d.get("errors", []) if e.get("kind") == "changed_during_read" and e.get("node") == path]
+        check(f"S11 {label}:退出 2、read_complete=false、指名 {path}",
+              fired and rc == 2 and d.get("read_complete") is False and bool(hits), str(d.get("errors"))[:600])
+        if label == "改寫未讀 B":
+            check("S11 讀取中被改的內容不當成有效登記", "B-NEW" not in _sl_ids(d.get("records")), str(_sl_ids(d.get("records"))))
+    check("S11 輸出附變動偵測的限制說明", any("原子" in x for x in d0.get("limitations", [])), str(d0.get("limitations")))
+
