+    write(v, "Systems/SlTrail.md", "type: system\nstatus: done", body="# t\n" + _sl_block([_sl_ctrl("TR-1")]).replace("v1\n", "v1 \n", 1))
+    write(v, "Systems/SlCrlf.md", "type: system\nstatus: done", body=_sl_block([_sl_ctrl("CRLF-1")]).replace("\n", "\r\n"))
+    write(v, "Systems/SlMarkUnclosed.md", "type: system\nstatus: done", body="# u\n提到 lumos-security-v1\n```python\nx\n")
