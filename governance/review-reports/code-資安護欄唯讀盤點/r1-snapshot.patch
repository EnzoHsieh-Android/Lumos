+def t_seclist_s10_size_caps():
+    """S10:單檔 2MiB、總量 64MiB、10000 檔的上限在解碼與解析前執行;超限退出 2、JSON 仍可解析;讀取請求長度有界。"""
+    import json as _j
+    MiB = 1024 * 1024
+    mod = _load_lumos_inproc()
+    v = _sl_vault()
+
+    def sized(rel, n, cid=None):
+        head = "---\ntype: system\nstatus: done\n---\n# big\n" + (_sl_block([_sl_ctrl(cid, evidence_refs=[])]) if cid else "")
+        pad = n - len(head.encode("utf-8"))
+        p = v / rel
+        p.write_bytes(head.encode("utf-8") + (("x" * 999 + "\n") * (pad // 1000)).encode() + b"y" * (pad % 1000))
+        check(f"S10 前置:{rel} 大小 {n}", p.stat().st_size == n)
+    sized("Systems/SlBig.md", 2 * MiB, "BIG-OK")
+    sized("Systems/SlBig1.md", 2 * MiB + 1, "BIG-OVER")
+    orig_os, orig_from = mod.os, mod.Env.from_texts
+    reads, parsed = [], []
+
+    class _OsSpy:
+        def __getattr__(self, k):
+            return getattr(orig_os, k)
+
+        def read(self, fd, n):
+            reads.append(n)
+            return orig_os.read(fd, n)
+
+    def spy_from(cls, vault, texts, unreadable=()):
+        parsed.extend(texts)
+        return orig_from.__func__(cls, vault, texts, unreadable)
+    mod.os, mod.Env.from_texts = _OsSpy(), classmethod(spy_from)
+    try:
+        rc, doc, err = _sl_inproc(v)
+    finally:
+        mod.os, mod.Env.from_texts = orig_os, orig_from
+    check("S10 單檔超限退出 2、JSON 可解析", rc == 2 and doc is not None, err[:400])
+    check("S10 2MiB+1 列 file_too_large", bool(_sl_err(doc, "file_too_large", "Systems/SlBig1.md")), str((doc or {}).get("errors"))[:400])
+    check("S10 剛好 2MiB 照讀", "BIG-OK" in _sl_ids((doc or {}).get("records")))
+    check("S10 超限檔不進解析器", "Systems/SlBig1.md" not in parsed and "Systems/SlBig.md" in parsed, str(parsed)[:300])
+    check("S10 每次讀取請求不超過 2MiB+1", reads and max(reads) <= 2 * MiB + 1, str(max(reads) if reads else None))
+    # 總量:剛好 64MiB 照讀,多 1 位元組就超限
+    (v / "Systems" / "SlBig1.md").unlink()
+    have = sum(p.stat().st_size for p in v.rglob("*.md"))
+    k = 0
+    while have + 2 * MiB <= 64 * MiB:
+        sized(f"Projects/F{k:02d}.md", 2 * MiB)
+        have += 2 * MiB
+        k += 1
+    if 64 * MiB - have > 0:
+        sized("Projects/Ffill.md", 64 * MiB - have)
+    check("S10 前置:總量剛好 64MiB", sum(p.stat().st_size for p in v.rglob("*.md")) == 64 * MiB)
+    r1, d1 = _sl_json(v)
+    check("S10 總量剛好 64MiB:退出 0、讀完整", r1.returncode == 0 and (d1 or {}).get("read_complete") is True, r1.stderr[:400])
+    (v / "Verification" / "SlZ.md").write_bytes(b"z")
+    reads.clear()
+    mod.os = _OsSpy()
+    try:
+        rc2, d2, err2 = _sl_inproc(v)
+    finally:
+        mod.os = orig_os
+    check("S10 總量 64MiB+1:退出 2、列 total_size_exceeded", rc2 == 2 and bool(_sl_err(d2, "total_size_exceeded")),
+          str((d2 or {}).get("errors"))[:400] + err2[:300])
+    check("S10 總量超限仍保留已讀項", "BIG-OK" in _sl_ids((d2 or {}).get("records")))
+    check("S10 總量超限時讀取請求不超過剩餘額度+1", reads and max(reads) <= 2 * MiB + 1)
+    # 檔數:10000 照讀,10001 停
+    v2 = mkvault()
+    have_n = sum(1 for _ in v2.rglob("*.md"))
+    bulk = v2 / "Projects" / "bulk"
+    bulk.mkdir()
+    for i in range(10000 - have_n):
+        (bulk / f"n{i:05d}.md").write_bytes(b"---\ntype: project\n---\n")
+    r3, d3 = _sl_json(v2)
+    check("S10 剛好 10000 檔:退出 0", r3.returncode == 0 and (d3 or {}).get("read_complete") is True, r3.stderr[:300])
+    (bulk / "n99999.md").write_bytes(b"x")
+    r4, d4 = _sl_json(v2)
+    check("S10 第 10001 檔:退出 2、列 too_many_files、JSON 可解析",
+          r4.returncode == 2 and bool(_sl_err(d4, "too_many_files")), r4.stdout[:300] + r4.stderr[:300])
+    check("S10 錯誤輸出仍是單一 JSON", d4 is not None and isinstance(_j.loads(r4.stdout), dict))
+
