+def t_seclist_s11_change_during_read():
+    """S11:讀 A 之後改寫已讀 A、改寫未讀 B、新增檔、刪除檔 → 列不完整並退出 2;沒有變動的對照退出 0。"""
+    import os as _os
+    mod = _load_lumos_inproc()
+    orig_read = mod._secinv_read_rel
+
+    def scenario(mutate):
+        v = _sl_vault()
+        write(v, "Systems/SlA.md", "type: system\nstatus: done", body="# A\n")
+        write(v, "Systems/SlB.md", "type: system\nstatus: done", body="# B\n")
+        fired = []
+
+        def hooked(root_fd, rel, remaining):
+            res = orig_read(root_fd, rel, remaining)
+            if rel == "Systems/SlA.md" and not fired:
+                fired.append(1)
+                mutate(v)
+            return res
+        mod._secinv_read_rel = hooked
+        try:
+            rc, doc, _err = _sl_inproc(v)
+        finally:
+            mod._secinv_read_rel = orig_read
+        return rc, doc or {}, fired
+
+    def rewrite(rel, text):
+        def f(v):
+            p = v / rel
+            st = p.stat()
+            p.write_text(text, encoding="utf-8")
+            _os.utime(p, ns=(st.st_atime_ns, st.st_mtime_ns + 5_000_000_000))
+        return f
+    rc0, d0, f0 = scenario(lambda v: None)
+    check("S11 對照:沒有變動退出 0、read_complete=true", f0 and rc0 == 0 and d0.get("read_complete") is True, str(d0.get("errors"))[:400])
+    cases = (("改寫已讀 A", rewrite("Systems/SlA.md", "---\ntype: system\n---\n# A2\n"), "Systems/SlA.md"),
+             ("改寫未讀 B", rewrite("Systems/SlB.md", "---\ntype: system\n---\n# B2\n" + _sl_block([_sl_ctrl("B-NEW")])),
+              "Systems/SlB.md"),
+             ("新增檔", lambda v: (v / "Systems" / "SlNew.md").write_text("# new\n", encoding="utf-8"), "Systems/SlNew.md"),
+             ("刪除未讀檔", lambda v: (v / "Systems" / "SlB.md").unlink(), "Systems/SlB.md"))
+    for label, mut, path in cases:
+        rc, d, fired = scenario(mut)
+        hits = [e for e in d.get("errors", []) if e.get("kind") == "changed_during_read" and e.get("node") == path]
+        check(f"S11 {label}:退出 2、read_complete=false、指名 {path}",
+              fired and rc == 2 and d.get("read_complete") is False and bool(hits), str(d.get("errors"))[:600])
+        if label == "改寫未讀 B":
+            check("S11 讀取中被改的內容不當成有效登記", "B-NEW" not in _sl_ids(d.get("records")), str(_sl_ids(d.get("records"))))
+    check("S11 輸出附變動偵測的限制說明", any("原子" in x for x in d0.get("limitations", [])), str(d0.get("limitations")))
+
+
+def t_seclist_s12_fence_refactor():
+    """S12:共用圍欄原語抽出後 _visible_lines 原輸出不變(四反引號包範例、波浪號、縮排、未閉合寬鬆回退);
+    專用入口嚴格拒絕含標記的未閉合篇章與變體,但不擋沒有標記的舊筆記。預期值照 CommonMark 與 _visible_lines 說明手算。"""
+    mod = _load_lumos_inproc()
+    def vl(lines, keep=False):
+        return list(mod._visible_lines(lines, keep_fenced=keep))
+    four = ["a", "````md", "```lumos-security-v1", "{}", "```", "````", "b"]
+    check("S12 釘:四反引號包住的範例整段隱藏", vl(four) == [(1, "a"), (7, "b")], str(vl(four)))
+    check("S12 釘:keep_fenced 保留內文、跳過外層標記",
+          vl(four, True) == [(1, "a"), (3, "```lumos-security-v1"), (4, "{}"), (5, "```"), (7, "b")], str(vl(four, True)))
+    check("S12 釘:波浪號圍欄", vl(["x", "~~~", "```", "~~~", "y"]) == [(1, "x"), (5, "y")])
+    check("S12 釘:縮排四格不是圍欄", vl(["p", "    ```", "q"]) == [(1, "p"), (2, "    ```"), (3, "q")])
+    check("S12 釘:縮排三格仍是圍欄", vl(["p", "   ```", "q", "```", "r"]) == [(1, "p"), (5, "r")])
+    check("S12 釘:嚴格讀不完時退回寬鬆", vl(["s", "```py", "t", "```py", "u"]) == [(1, "s"), (5, "u")])
+    check("S12 釘:整份未閉合隱藏到檔尾", vl(["a", "```", "b"]) == [(1, "a")])
+    regions, unterminated = mod._fence_regions(["s", "```py", "t", "```py", "u"], True)
+    check("S12 共用原語回報嚴格讀法的未閉合狀態", unterminated is True and regions == [(1, None)], str((regions, unterminated)))
+    regions2, un2 = mod._fence_regions(four, True)
+    check("S12 共用原語回報區段", un2 is False and regions2 == [(1, 5)], str(regions2))
+    v = _sl_vault()
+    good = _sl_block([_sl_ctrl("FENCE-OK")])
+    write(v, "Systems/SlMixed.md", "type: system\nstatus: done",
+          body="# m\n````markdown\n" + _sl_block([_sl_ctrl("EXAMPLE-1")]) + "````\n~~~\n```lumos-security-v1\n~~~\n" + good)
+    write(v, "Systems/SlIndent.md", "type: system\nstatus: done", body="# i\n  " + _sl_block([_sl_ctrl("IND-1")]))
+    write(v, "Systems/SlQuote.md", "type: system\nstatus: done", body="# q\n> ```lumos-security-v1\n> {}\n> ```\n")
+    write(v, "Systems/SlTrail.md", "type: system\nstatus: done", body="# t\n" + _sl_block([_sl_ctrl("TR-1")]).replace("v1\n", "v1 \n", 1))
+    write(v, "Systems/SlCrlf.md", "type: system\nstatus: done", body=_sl_block([_sl_ctrl("CRLF-1")]).replace("\n", "\r\n"))
+    write(v, "Systems/SlMarkUnclosed.md", "type: system\nstatus: done", body="# u\n提到 lumos-security-v1\n```python\nx\n")
+    write(v, "Systems/SlOldUnclosed.md", "type: system\nstatus: done", body="# old\n```python\nx\n")
+    write(v, "Systems/SlStrictOnly.md", "type: system\nstatus: done",
+          body="# s\n" + _sl_block([_sl_ctrl("STRICT-1")]) + "```py\nx\n```py\n")
+    _r, doc = _sl_json(v)
+    doc = doc or {}
+    ids = _sl_ids(doc.get("records"))
+    check("S12 合法登記與範例混在同篇:只認頂層那塊", "FENCE-OK" in ids and "EXAMPLE-1" not in ids, str(ids))
+    check("S12 範例篇不報錯", not [e for e in doc.get("errors", []) if e.get("node") == "Systems/SlMixed.md"], str(doc.get("errors"))[:600])
+    for node in ("Systems/SlIndent.md", "Systems/SlQuote.md", "Systems/SlTrail.md"):
+        check(f"S12 變體 {node} 列 malformed_block", bool(_sl_err(doc, "malformed_block", node)), str(doc.get("errors"))[:900])
+    check("S12 變體不登記", not ({"IND-1", "TR-1"} & set(ids)), str(ids))
+    check("S12 CRLF 行尾照常認", "CRLF-1" in ids, str(ids))
+    check("S12 含標記的未閉合篇章列 unclosed_block", bool(_sl_err(doc, "unclosed_block", "Systems/SlMarkUnclosed.md")))
+    check("S12 嚴格讀法未閉合(寬鬆讀法會閉合)也列 unclosed_block、不登記",
+          bool(_sl_err(doc, "unclosed_block", "Systems/SlStrictOnly.md")) and "STRICT-1" not in ids, str(doc.get("errors"))[:600])
+    check("S12 沒標記的舊筆記未閉合不報", not [e for e in doc.get("errors", []) if e.get("node") == "Systems/SlOldUnclosed.md"])
