+# ── lumos security list(資安護欄唯讀盤點;Projects/資安護欄唯讀盤點_計劃 S1 到 S13)──────────────
+# 判準來源一律是那篇計劃的〈CLI契約〉〈資料位置與單一來源〉〈讀取、證據與狀態算法〉〈輸出契約〉;
+# 預期值照條文手寫,不呼叫被測函式產生。fixture 只用 json.dumps 組登記塊(登記格式本來就是 JSON)。
+
+def _sl_ctrl(cid, **over):
+    """一條欄位齊全、引用都指得到的安全護欄(預設:active、verified、behavior 證據指到 pass 紀錄)。"""
+    c = {"id": cid, "revision": "r1", "concerns": ["security"],
+         "source": {"kind": "requirement", "claim": f"{cid} 的獨立安全要求", "decision_ref": "Systems/SlPay#d1"},
+         "lifecycle": "active", "assets": ["A1"], "surfaces": ["S-pay"],
+         "scope": "付款 API", "trust_boundary": "外部使用者到服務端", "enforcement": "服務端授權中介層",
+         "legitimate_control": "擁有者付款成功", "abuse_case": "別人的訂單付款被拒",
+         "required_evidence": ["behavior"],
+         "evidence_refs": [{"kind": "behavior", "node": "Verification/SlPass.md"}],
+         "reported_status": "verified", "status_reason": "作者說測過", "owner": "enzo",
+         "revalidate_when": "改授權時", "exception": None}
+    c.update(over)
+    return c
+
+
+def _sl_block(controls=None, inventory=None, version=1):
+    import json as _j
+    obj = {"schema_version": version, "controls": controls if controls is not None else []}
+    if inventory is not None:
+        obj["inventory"] = inventory
+    return "```lumos-security-v1\n" + _j.dumps(obj, ensure_ascii=False, indent=1) + "\n```\n"
+
+
+def _sl_inventory(surfaces=("S-pay", "S-refund")):
+    return {"revision": "inv1", "decision_ref": "Systems/SlPay#d1",
+            "assets": [{"id": "A1", "description": "訂單資料"}],
+            "surfaces": [{"id": s, "asset_ids": ["A1"], "description": f"{s} 外部入口,信任邊界在 API"} for s in surfaces]}
+
+
+_SL_PAY_FM = ("type: system\nstatus: done\nsummary: |-\n"
+              "  KEY:★INVARIANT★ 只有訂單擁有者能付款 [test:t_sl_fake]\n"
+              "  KEY:★INVARIANT★ 訂單金額不得為負 [test:t_sl_fake2]\n"
+              "decisions:\n"
+              "  - content: 付款要擁有者\n    id: d1\n    decided: 2026-10-01\n    valid: true\n"
+              "  - content: 舊的放行規則\n    id: d2\n    decided: 2026-09-01\n    valid: false\n")
+
+
+def _sl_vault(pay_body="# SlPay\n", inventory=True):
+    """固定隔離樣本:付款節點(兩條合約、d1 有效、d2 作廢)、盤點節點、各種狀態的驗收紀錄。"""
+    v = mkvault()
+    write(v, "Systems/SlPay.md", _SL_PAY_FM.rstrip("\n"), body=pay_body)
+    if inventory:
+        write(v, "Systems/SlInv.md", "type: system\nstatus: done", body="# 入口盤點\n" + _sl_block([], _sl_inventory()))
+    for name, extra in (("SlPass", "status: pass\nvalid_under: 本機 sqlite\nrevalidate_when: 改授權時"),
+                        ("SlPassNoPremise", "status: pass"),
+                        ("SlStale", "status: stale\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlSuperseded", "status: superseded\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlPending", "status: pending\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlAbandoned", "status: abandoned\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlWeird", "status: greenish\nvalid_under: x\nrevalidate_when: y")):
+        write(v, f"Verification/{name}.md", "type: verification\n" + extra, body=f"# {name}\n")
+    return v
+
+
+def _sl_json(v):
+    import json as _j
+    r = run(v, "security", "list", "--json")
+    try:
+        return r, _j.loads(r.stdout)
+    except ValueError:
+        return r, None
+
+
+def _sl_inproc(v, as_json=True, today=None):
+    """同一行程跑指令(要換掉讀檔原語、凍結日期時用)。回 (rc, JSON 物件或文字, stderr)。"""
+    import contextlib as _cl, io as _io, json as _j
+    mod = _load_lumos_inproc()
+    out, err = _io.StringIO(), _io.StringIO()
+    old_today = mod._secinv_today
+    if today is not None:
+        mod._secinv_today = lambda: today
+    try:
+        with _cl.redirect_stdout(out), _cl.redirect_stderr(err):
+            rc = mod.cmd_security_list(Path(v), as_json=as_json)
+    finally:
+        mod._secinv_today = old_today
+    s = out.getvalue()
+    if as_json:
+        try:
+            return rc, _j.loads(s), err.getvalue()
+        except ValueError:
+            return rc, None, err.getvalue() + "\n[stdout 不是單一 JSON]\n" + s[:2000]
+    return rc, s, err.getvalue()
+
+
+def _sl_ids(rows):
+    return sorted(r.get("id") for r in (rows or []))
+
+
+def _sl_err(doc, kind, node=None):
+    return [e for e in (doc or {}).get("errors", []) if e.get("kind") == kind and (node is None or e.get("node") == node)]
+
+
+def _sl_rec(doc, cid):
+    for sec in ("records", "retired", "excluded_business"):
+        for r in (doc or {}).get(sec, []):
+            if r.get("id") == cid:
+                return r
+    return {}
+
