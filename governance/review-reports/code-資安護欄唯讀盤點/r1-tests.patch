+    check("S13 補齊兩種也只到 declared_only", _sl_rec(doc, "K-FULL").get("evidence_check") == "declared_only")
+    check("S13 沒宣告必要證據至少 incomplete", _sl_rec(doc, "K-NONE").get("evidence_check") == "incomplete")
+    check("S13 每項都顯示 kind 只核對宣告對應的限制",
