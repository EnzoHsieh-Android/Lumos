+def t_seclist_integration_gaps():
+    """母計劃〈證據交接與首案整合驗收〉六項反例在盤點層的預期:都只列缺口、保持 not_assessed,不判通過。"""
+    import datetime as _dt
+    v = _sl_vault("# SlPay\n" + _sl_block([
+        # ①權限來源決策被撤銷 / 不存在
+        _sl_ctrl("I-REVOKED", source={"kind": "requirement", "claim": "撤銷的權限答案", "decision_ref": "Systems/SlPay#d2"}),
+        _sl_ctrl("I-NODEC", source={"kind": "requirement", "claim": "沒有決策", "decision_ref": "Systems/SlPay#d9"}),
+        # ②測試重抄錯 oracle 但故障翻紅:作者照樣報 verified、紀錄是 pass → 仍只 declared_only
+        _sl_ctrl("I-ORACLE"),
+        # ③因缺身分或資源不存在而被拒(目標情境無效):紀錄還在 pending
+        _sl_ctrl("I-FALSEREJ", evidence_refs=[{"kind": "fault_sensitivity", "node": "Verification/SlPending.md"}],
+                 required_evidence=["fault_sensitivity"]),
+        # ④編譯錯/零案例/非目標失敗 = 執行無效:紀錄 abandoned
+        _sl_ctrl("I-INVALIDRUN", evidence_refs=[{"kind": "fault_sensitivity", "node": "Verification/SlAbandoned.md"}],
+                 required_evidence=["fault_sensitivity"]),
+        # ⑤換版本或環境後套舊證據:紀錄 stale
+        _sl_ctrl("I-OLDENV", evidence_refs=[{"kind": "behavior", "node": "Verification/SlStale.md"}]),
+        # ⑥清單完整但有未驗與過期例外
+        _sl_ctrl("I-EXPIRED", reported_status="untested", evidence_refs=[],
+                 exception={"decision_ref": "Systems/SlPay#d1", "reason": "暫時接受", "expires_on": "2026-01-01"}),
+    ]))
+    rc, doc, _err = _sl_inproc(v, today=_dt.date(2026, 10, 19))
+    doc = doc or {}
+    refs = {e.get("id") for e in _sl_err(doc, "reference_error") if e.get("field") == "source"}
+    check("整合① 撤銷或不存在的決策列引用錯誤、退出 2", rc == 2 and {"I-REVOKED", "I-NODEC"} <= refs, str(doc.get("errors"))[:600])
