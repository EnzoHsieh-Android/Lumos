+        _sl_ctrl("K-NONE", required_evidence=[]),
+        _sl_ctrl("NA-1", reported_status="not_applicable", status_reason="這入口不收卡號"),
+        _sl_ctrl("DEF-1", reported_status="defect", status_reason="漏驗擁有者"),
+    ]))
+    r, doc = _sl_json(v)
+    doc = doc or {}
+    check("S13 退出 0(缺口不是讀取錯誤)", r.returncode == 0, r.stdout[:500] + r.stderr[:300])
