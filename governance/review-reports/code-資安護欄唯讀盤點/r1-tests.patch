+    check("整合③ 假拒絕情境的證據 incomplete", _sl_rec(doc, "I-FALSEREJ").get("evidence_check") == "incomplete")
+    check("整合④ 執行無效的證據 incomplete、主張仍算未驗", _sl_rec(doc, "I-INVALIDRUN").get("evidence_check") == "incomplete")
+    check("整合⑤ 舊證據 stale", _sl_rec(doc, "I-OLDENV").get("evidence_check") == "stale")
+    iss = [i.get("kind") for i in _sl_rec(doc, "I-EXPIRED").get("issues", [])]
