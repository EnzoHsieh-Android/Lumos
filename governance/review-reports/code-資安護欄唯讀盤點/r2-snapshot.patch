+def _sl_vault(pay_body="# SlPay\n", inventory=True):
+    """固定隔離樣本:付款節點(兩條合約、d1 有效、d2 作廢)、盤點節點、各種狀態的驗收紀錄。"""
+    v = mkvault()
+    write(v, "Systems/SlPay.md", _SL_PAY_FM.rstrip("\n"), body=pay_body)
+    if inventory:
+        write(v, "Systems/SlInv.md", "type: system\nstatus: done", body="# 入口盤點\n" + _sl_block([], _sl_inventory()))
+    for name, extra in (("SlPass", "status: pass\nvalid_under: 本機 sqlite\nrevalidate_when: 改授權時"),
+                        ("SlPassNoPremise", "status: pass"),
+                        ("SlStale", "status: stale\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlSuperseded", "status: superseded\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlPending", "status: pending\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlAbandoned", "status: abandoned\nvalid_under: x\nrevalidate_when: y"),
+                        ("SlWeird", "status: greenish\nvalid_under: x\nrevalidate_when: y")):
+        write(v, f"Verification/{name}.md", "type: verification\n" + extra, body=f"# {name}\n")
+    return v
+
+
+def _sl_json(v):
+    import json as _j
+    r = run(v, "security", "list", "--json")
+    try:
+        return r, _j.loads(r.stdout)
+    except ValueError:
+        return r, None
+
+
+def _sl_inproc(v, as_json=True, today=None):
+    """同一行程跑指令(要換掉讀檔原語、凍結日期時用)。回 (rc, JSON 物件或文字, stderr)。"""
+    import contextlib as _cl, io as _io, json as _j
+    mod = _load_lumos_inproc()
+    out, err = _io.StringIO(), _io.StringIO()
+    old_today = mod._secinv_today
+    if today is not None:
+        mod._secinv_today = lambda: today
+    try:
+        with _cl.redirect_stdout(out), _cl.redirect_stderr(err):
+            rc = mod.cmd_security_list(Path(v), as_json=as_json)
+    finally:
+        mod._secinv_today = old_today
+    s = out.getvalue()
+    if as_json:
+        try:
+            return rc, _j.loads(s), err.getvalue()
+        except ValueError:
+            return rc, None, err.getvalue() + "\n[stdout 不是單一 JSON]\n" + s[:2000]
+    return rc, s, err.getvalue()
+
+
+def _sl_ids(rows):
+    return sorted(r.get("id") for r in (rows or []))
+
+
+def _sl_err(doc, kind, node=None):
+    return [e for e in (doc or {}).get("errors", []) if e.get("kind") == kind and (node is None or e.get("node") == node)]
+
+
+def _sl_rec(doc, cid):
+    for sec in ("records", "retired", "excluded_business"):
+        for r in (doc or {}).get(sec, []):
+            if r.get("id") == cid:
+                return r
+    return {}
