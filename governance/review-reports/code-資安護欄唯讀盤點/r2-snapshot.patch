+    check("S3 正常項保留", _sl_rec(doc, "OK-1").get("evidence_check") == "declared_only")
+    check("S3 讀取不完整", doc.get("read_complete") is False)
+    # 列舉之後、開檔之前把一般檔換成指向外面的捷徑:要被 O_NOFOLLOW 擋下,不讀到哨兵
+    v2 = _sl_vault()
+    swap = v2 / "Systems" / "SlSwap.md"
+    swap.write_text("---\ntype: system\n---\n# swap\n", encoding="utf-8")
+    sec2 = v2.parent / "secret2.md"
