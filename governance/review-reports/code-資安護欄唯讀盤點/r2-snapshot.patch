+_VAULT_SAFE_ENTRIES_MAX = 50000                 # 列舉的總項目數上限(含非 .md 與目錄;代碼審 r1 資源席:只限 .md 時 30 萬個 .txt 吃掉 260MB)
+# 必要的平台能力在載入時算好(之後就算有人換掉 os 模組的屬性也不影響判斷)
+_VAULT_SAFE_OK = bool(hasattr(os, "O_NOFOLLOW") and hasattr(os, "O_DIRECTORY")
+                            and os.open in getattr(os, "supports_dir_fd", ()) and os.scandir in getattr(os, "supports_fd", ())
+                            and os.stat in getattr(os, "supports_dir_fd", ()))
