+    check("S7 文字輸出把控制字元顯示成可見跳脫", "\\u001b" in (txt or "") and "\\u202e" in (txt or ""), repr((txt or "")[:300]))
+    check("S7 JSON 保留原字面值", _sl_rec(doc, "BAIT-1").get("abuse_case") == "\x1b[31mRED\x1b[0m ‮evil‬ \x07",
+          repr(_sl_rec(doc, "BAIT-1").get("abuse_case")))
+    check("S7 誘餌證據路徑只當資料判 missing", _sl_rec(doc, "BAIT-1").get("evidence_check") == "missing")
+    r = run(v, "security", "list", "--help")
+    check("S7 命令說明標示唯讀盤點,不是安全驗收", "唯讀盤點" in r.stdout and "不是安全驗收" in r.stdout, r.stdout[:600])
+    check("S7 每份輸出標示唯讀盤點,不是安全驗收", "唯讀盤點,不是安全驗收" in (txt or "")
+          and "唯讀盤點,不是安全驗收" in _j.dumps(doc, ensure_ascii=False))
