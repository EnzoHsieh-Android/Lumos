+def _vault_safe_recheck(root_fd, manifest, changed, errors):
+    """讀完重列舉一次(沿用同一個檔數上限),集合或屬性有差就列 changed_during_read。"""
+    manifest2, errs2, _over2 = _vault_safe_enumerate(root_fd)
+    seen = {(e["kind"], e["node"]) for e in errors}
+    diff = (set(manifest) ^ set(manifest2)) | {r for r in manifest if r in manifest2 and manifest2[r] != manifest[r]}
+    for r in sorted(diff - changed):
+        errors.append(_vault_issue("changed_during_read", nfc(r), detail="讀完重列舉時,這個路徑新增、消失或屬性變了"))
+    for e in errs2:
+        if (e["kind"], e["node"]) not in seen:
+            errors.append(_vault_issue("changed_during_read", e["node"], detail=f"重列舉時才出現的問題:{e['kind']}"))
+
