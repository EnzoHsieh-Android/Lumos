+def _sl_g4_spy_run(mod, v, hook_name, hook):
+    """換掉 mod 的一支讀取原語(hook 包住原本那支),同時記下每次 os.open 開到的 inode;回 (rc, JSON, 開過的 inode)。"""
+    orig_hook, orig_os = getattr(mod, hook_name), mod.os
+    opened = []
+
+    class _OsSpy:
+        def __getattr__(self, k):
+            return getattr(orig_os, k)
+
+        def open(self, *a, **kw):
+            fd = orig_os.open(*a, **kw)
+            try:
+                opened.append(orig_os.fstat(fd).st_ino)
+            except OSError:
+                pass
+            return fd
+    setattr(mod, hook_name, hook(orig_hook))
+    mod.os = _OsSpy()
+    try:
+        rc, doc, _err = _sl_inproc(v)
+    finally:
+        setattr(mod, hook_name, orig_hook)
+        mod.os = orig_os
+    return rc, doc or {}, opened
+
+
+def _sl_g4_swap_case():
+    """圖譜裡有 Systems/Sub/N.md,圖譜外有同名哨兵目錄 → (圖譜, 外部目錄, 外部兩個 inode)。"""
+    v = _sl_vault()
+    (v / "Systems" / "Sub").mkdir()
+    (v / "Systems" / "Sub" / "N.md").write_text("---\ntype: system\n---\n# n\n", encoding="utf-8")
+    out = v.parent / "outside-sub"
+    out.mkdir()
+    (out / "N.md").write_text("SENTINEL-DIR\n", encoding="utf-8")
+    return v, out, {out.stat().st_ino, (out / "N.md").stat().st_ino}
+
+
+def _sl_g4_do_swap(v, out):
+    """把 Systems/Sub 換成指向圖譜外的捷徑(只換一次)。"""
+    import os as _os
+    sub = v / "Systems" / "Sub"
+    if not sub.is_symlink():
+        (sub / "N.md").unlink()
+        sub.rmdir()
+        _os.symlink(str(out), str(sub))
+
+
+def _sl_g4_swap_checks(mod):
+    """G4 (a)(b):列舉後、列舉中把中間目錄換成捷徑。"""
+    # (a) 列舉後、讀檔前把中間目錄換成捷徑
+    v, out, out_inos = _sl_g4_swap_case()
+
+    def after_enum(orig):
+        def h(root_fd, rel, remaining):
+            if rel == "Systems/Sub/N.md":
+                _sl_g4_do_swap(v, out)
+            return orig(root_fd, rel, remaining)
+        return h
+    rc, doc, opened = _sl_g4_spy_run(mod, v, "_vault_safe_read_rel", after_enum)
+    check("G4 讀檔前中間目錄換成捷徑:外部目錄與檔從沒被開", not (out_inos & set(opened)), str(out_inos & set(opened)))
+    check("G4 讀檔前中間目錄換成捷徑:列錯誤、退出 2", rc == 2 and any(e.get("node") == "Systems/Sub/N.md" for e in doc.get("errors", [])),
+          str(doc.get("errors"))[:400])
+    check("G4 外部哨兵內容零外洩", "SENTINEL-DIR" not in str(doc))
+    # (b) 列舉中:列完 Systems 這層、還沒進 Sub 之前換掉
+    v2, out2, out2_inos = _sl_g4_swap_case()
+
+    def during_enum(orig):
+        def h(fd, rel, *rest):
+            res = orig(fd, rel, *rest)
+            if rel == "Systems":
+                _sl_g4_do_swap(v2, out2)
+            return res
+        return h
+    rc2, doc2, opened2 = _sl_g4_spy_run(mod, v2, "_vault_safe_list_dir", during_enum)
+    check("G4 列舉中子目錄換成捷徑:外部目錄從沒被開", not (out2_inos & set(opened2)), str(out2_inos & set(opened2)))
+    check("G4 列舉中子目錄換成捷徑:退出 2", rc2 == 2, str(doc2.get("errors"))[:400])
+
