+    列舉的總項目數(含非 .md 與目錄)有上限,超過記 enumeration_failed。"""
+    import time as _t
+    MiB = 1024 * 1024
+    v = _sl_vault(inventory=False)
+    n_s, per = 4000, 3
+    inv = {"revision": "i", "decision_ref": "Systems/SlPay#d1", "assets": [{"id": "A1", "description": "d"}],
+           "surfaces": [{"id": f"S{i}", "asset_ids": ["A1"], "description": "d"} for i in range(n_s)]}
+    write(v, "Systems/SlInv.md", "type: system\nstatus: done", body="# inv\n" + _sl_block([], inv))
+    k = 0
