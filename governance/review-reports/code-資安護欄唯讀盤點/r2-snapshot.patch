+def t_seclist_s07_read_only_no_exec():
+    """S7:唯讀、無網路、無程序執行;筆記裡的命令與控制字元不會變成操作,文字輸出跳脫、JSON 保留字面。"""
+    import hashlib as _h, json as _j, socket as _sock, subprocess as _sp
+    v = _sl_vault()
+    pwn = v.parent / "PWNED"
+    bait = f"$(touch {pwn}) `touch {pwn}` ; touch {pwn}"
+    write(v, "Systems/SlBait.md", "type: system\nstatus: done", body="# bait\n" + _sl_block([
+        _sl_ctrl("BAIT-1", scope=bait, abuse_case="\x1b[31mRED\x1b[0m ‮evil‬ \x07",
+                 enforcement="http://127.0.0.1:9/should-not-open",
+                 evidence_refs=[{"kind": "behavior", "node": f"Verification/x; touch {pwn}"}])]))
+
+    def fingerprint():
+        out = {}
+        for p in sorted(v.rglob("*")):
+            if p.is_file():
+                st = p.stat()
+                out[str(p)] = (_h.sha256(p.read_bytes()).hexdigest(), st.st_mtime_ns, st.st_size)
+        return out
+    before = fingerprint()
+    mod = _load_lumos_inproc()
+    blocked = []
+
+    def _deny(*a, **kw):
+        blocked.append(a[:1])
+        raise RuntimeError("盤點不准開網路或子程序")
+    old = (_sock.socket, _sp.Popen, mod.subprocess.run if hasattr(mod, "subprocess") else None)
+    _sock.socket, _sp.Popen = _deny, _deny
+    try:
+        _rcj, doc, _ej = _sl_inproc(v, as_json=True)
+        _rct, txt, _et = _sl_inproc(v, as_json=False)
+    finally:
+        _sock.socket, _sp.Popen = old[0], old[1]
+    check("S7 沒開網路、沒起子程序", not blocked, str(blocked))
+    check("S7 誘餌命令沒有產物", not pwn.exists())
+    check("S7 檔案指紋前後一致", fingerprint() == before)
+    check("S7 文字輸出沒有原生 ESC、BEL、雙向覆寫字元", txt is not None and "\x1b" not in txt and "‮" not in txt and "\x07" not in txt,
