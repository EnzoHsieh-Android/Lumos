+def _sl_g4_vault_checks(mod):
+    """G4 (e)(f):圖譜根或自動找到的圖譜是捷徑、--vault 不像圖譜。"""
+    import os as _os
+    # (e) 圖譜根本身是捷徑;自動找到的 docs/x-knowledge 是捷徑
+    v5 = _sl_vault("# SlPay\n" + _sl_block([_sl_ctrl("ROOT-1")]))
+    link = v5.parent / "kg-link"
+    _os.symlink(str(v5), str(link))
+    r5 = subprocess.run([sys.executable, GRAPHCTL, "--vault", str(link), "security", "list", "--json"], capture_output=True, text=True)
+    check("G4 --vault 是捷徑:拒讀、退出 2、沒有登記內容", r5.returncode == 2 and "ROOT-1" not in r5.stdout and '"read_complete": false' in r5.stdout,
+          r5.stdout[:300] + r5.stderr[:200])
+    snap5 = mod.load_vault_safe(link)
+    check("G4 讀取家族自己也拒讀捷徑根(不靠選圖譜那道)", snap5["texts"] == []
