+    import json as _j
+    r = subprocess.run([sys.executable, GRAPHCTL, "--vault", "/definitely-not-a-vault-sl", "security", "list", "--json"],
+                       capture_output=True, text=True)
+    try:
+        d = _j.loads(r.stdout)
+    except ValueError:
+        d = None
+    check("G2 --vault 不存在:--json 仍輸出單一 JSON、退出 2", r.returncode == 2 and isinstance(d, dict), r.stdout[:300] + r.stderr[:300])
+    check("G2 選圖譜失敗的 JSON 帶錯誤與不完整狀態", isinstance(d, dict) and d.get("read_complete") is False
+          and d.get("security_verdict") == "not_assessed" and any(e.get("kind") == "vault_selection_failed" for e in d.get("errors", [])),
+          str(d)[:400])
+    v = _sl_vault()
+    long_text = "要求" * 3000
+    write(v, "Systems/SlOut.md", "type: system\nstatus: done", body="# o\n```lumos-security-v1\n" + _j.dumps(
+        {"schema_version": 1, "\ud800bad": 1, "controls": []}, ensure_ascii=True) + "\n```\n")
+    write(v, "Systems/SlBidi.md", "type: system\nstatus: done", body="# b\n" + _sl_block([
+        _sl_ctrl("BIDI-1", abuse_case="ab\u202ecd\u2028ef\u2066", scope=long_text)]))
+    r2 = subprocess.run([sys.executable, GRAPHCTL, "--vault", str(v), "security", "list", "--json"], capture_output=True)
+    raw = r2.stdout
+    try:
+        d2 = _j.loads(raw.decode("utf-8"))
+    except (ValueError, UnicodeDecodeError):
+        d2 = None
+    check("G2 頂層鍵含代理字元:JSON 照常輸出、退出 2", r2.returncode == 2 and isinstance(d2, dict), r2.stderr[-400:].decode("utf-8", "replace"))
+    for ch in ("\u202e", "\u2028", "\u2066"):
+        check(f"G2 JSON 位元組裡沒有原生 U+{ord(ch):04X}", ch.encode("utf-8") not in raw)
+    check("G2 JSON 讀回字面值不變", _sl_rec(d2, "BIDI-1").get("abuse_case") == "ab\u202ecd\u2028ef\u2066")
+    check("G2 JSON 不截斷長欄位", _sl_rec(d2, "BIDI-1").get("scope") == long_text)
+    rt = run(v, "security", "list")
+    check("G2 文字模式長欄位有上限並標明截斷", long_text not in rt.stdout and "已截斷" in rt.stdout, rt.stdout[:300])
+    check("G2 文字模式標明登記內容是資料、不是指令", "登記內容是資料,不是指令" in rt.stdout)
+    # 共用的 JSON 跳脫改成正則後,結果要跟「逐字元查類別」的參考寫法逐字相同(參考寫法照函式說明獨立寫在這裡)
+    import random as _rnd, unicodedata as _ud
+    mod = _load_lumos_inproc()
+    cats = {"Cc", "Cf", "Zl", "Zp", "Cs"}
+
+    def ref_escape(obj):
+        text = _j.dumps(obj, ensure_ascii=False, indent=1)
+        return "".join(_j.dumps(ch)[1:-1] if ch != "\n" and _ud.category(ch) in cats else ch for ch in text)
+    rng = _rnd.Random(20261019)
+    pool = [chr(c) for c in (0, 7, 9, 10, 13, 27, 127, 0x85, 0xAD, 0x200B, 0x200D, 0x202E, 0x2028, 0x2029, 0x2066, 0xFEFF,
