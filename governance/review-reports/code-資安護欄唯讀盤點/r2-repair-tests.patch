+    inv = {"revision": "i", "decision_ref": "Systems/SlPay#d1", "assets": [{"id": "A1", "description": "d"}],
+           "surfaces": [{"id": f"S{i}", "asset_ids": ["A1"], "description": "d"} for i in range(n_s)]}
+    write(v, "Systems/SlInv.md", "type: system\nstatus: done", body="# inv\n" + _sl_block([], inv))
+    k = 0
+    for part in range(8):
+        ctrls = []
+        for _ in range(n_s * per // 8):
+            ctrls.append(_sl_ctrl(f"C{k}", surfaces=[f"S{k % n_s}"], evidence_refs=[],
+                                  source={"kind": "requirement", "claim": f"要求 {k}", "decision_ref": "Systems/SlPay#d1"}))
+            k += 1
+        write(v, f"Systems/SlBulk{part}.md", "type: system\nstatus: done", body="# b\n" + _sl_block(ctrls))
+    check("G7 前置:每篇不超過單檔上限", all((v / "Systems" / f"SlBulk{p}.md").stat().st_size < 2 * MiB for p in range(8)))
+    t0 = _t.monotonic()
+    rc, doc, _err = _sl_inproc(v)
+    dt = _t.monotonic() - t0
+    check(f"G7 12000 條、4000 入口在 12 秒內(實測 {dt:.1f}s)", dt < 12 and rc == 0 and len((doc or {}).get("records", [])) == k,
