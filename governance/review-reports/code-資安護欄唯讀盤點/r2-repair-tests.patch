+def t_seclist_g4_read_guards():
+    """G4:中間目錄在列舉後或列舉中被換成捷徑都不跟;JSON 與目錄巢狀過深都退出 2 且輸出 JSON;
+    圖譜根或自動找到的 docs/*-knowledge 是捷徑時拒讀;--vault 指到不像圖譜的目錄是輸入錯誤。"""
+    mod = _load_lumos_inproc()
