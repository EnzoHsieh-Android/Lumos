+    samples = [{"k" + "".join(rng.choice(pool) for _ in range(5)): ["".join(rng.choice(pool) for _ in range(rng.randint(0, 30)))]}
+               for _ in range(400)]
+    diff = [x for x in samples if mod._json_text_escaped(x, indent=1) != ref_escape(x)]
+    check("G2 共用 JSON 跳脫結果與逐字元參考寫法相同(400 組含各類控制字元)", not diff, repr(diff[:2]))
