+def load_vault_safe(vault):
+    """安全讀整個圖譜進記憶體 → {"texts": [(原始相對路徑, 全文)], "unreadable": [...], "errors": [...], "stats": {...}}。
+    完不完整由 _secinv_build 依錯誤種類判(只有一處算)。每篇只讀一次;後面所有解析與引用都從這份快照拿,不再開檔。"""
+    snap = {"texts": [], "unreadable": [], "errors": [],
+            "stats": {"files": 0, "bytes": 0, "limits": {"file_bytes": _VAULT_SAFE_FILE_MAX, "total_bytes": _VAULT_SAFE_TOTAL_MAX,
+                                                         "files": _VAULT_SAFE_FILES_MAX, "entries": _VAULT_SAFE_ENTRIES_MAX}}}
+    if not _VAULT_SAFE_OK:
+        snap["errors"].append(_vault_issue("unsupported_safe_read", ".", detail="這個平台沒有 dir_fd/O_NOFOLLOW/O_DIRECTORY,不降級成跟隨捷徑的讀法"))
+        return snap
+    try:     # 圖譜根本身也不跟捷徑(最後一段;上層路徑照系統解析,代碼審 r1 資安席 F3)
+        root_fd = os.open(str(vault), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    except OSError as e:
+        kind = "symlink_rejected" if os.path.islink(str(vault)) else "read_error"
+        snap["errors"].append(_vault_issue(kind, ".", detail=e.strerror or type(e).__name__))
+        return snap
+    try:
+        manifest, errs, overflow = _vault_safe_enumerate(root_fd)
+        snap["errors"].extend(errs)
+        run = {"total": 0, "exhausted": False, "skipped": [], "changed": set()}
+        for rel in sorted(manifest, key=lambda r: r.split("/")):
+            _vault_safe_read_one(root_fd, rel, manifest, snap, run)
+        snap["stats"]["bytes"] = run["total"]
+        if not overflow:
+            _vault_safe_recheck(root_fd, manifest, run["changed"], snap["errors"])
+    finally:
+        os.close(root_fd)
+    return snap
+
