+
+def _vault_safe_attrs(st):
+    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+
+
+def _vault_safe_list_dir(fd, rel, md_left, entries_left):
+    """一層目錄 → ([(名字, lstat)] 依名字排序, 是否超過總項目上限)。串流讀:.md 數超過 md_left、或總項目數超過 entries_left 就停
+    (不讀完整層;.md 超限由呼叫端見到第 md_left+1 個時記)。rel 只用來定位(錯誤訊息、測試替身)。"""
+    out, md = [], 0
+    with os.scandir(fd) as it:
+        for e in it:
+            if len(out) >= entries_left:
+                return out, True
+            out.append((e.name, e.stat(follow_symlinks=False)))
+            if e.name.endswith(".md"):
+                md += 1
+                if md > md_left:
+                    break
+    out.sort(key=lambda x: x[0])
+    return out, False
+
+
+def _vault_safe_entry_kind(name, mode):
+    """列舉到的一項 → link / dir / md / special / skip(不是 .md 的一般檔或特殊檔不管)。"""
+    import stat as _stat
+    if _stat.S_ISLNK(mode):
+        return "link"
+    if _stat.S_ISDIR(mode):
+        return "dir"
+    if not name.endswith(".md"):
+        return "skip"
+    return "md" if _stat.S_ISREG(mode) else "special"
+
+
+def _vault_safe_walk(dfd, rel_dir, manifest, errors, state):
+    """_vault_safe_enumerate 的一層:捷徑一律拒絕(檔或目錄都不跟),.md 的特殊檔拒絕,子目錄用 O_DIRECTORY|O_NOFOLLOW 開。"""
+    try:
+        entries, too_many = _vault_safe_list_dir(dfd, rel_dir or ".", _VAULT_SAFE_FILES_MAX - len(manifest),
+                                                 _VAULT_SAFE_ENTRIES_MAX - state["entries"])
+    except OSError as e:
+        errors.append(_vault_issue("enumeration_failed", nfc(rel_dir or "."), detail=e.strerror or type(e).__name__))
+        return
+    state["entries"] += len(entries)
+    if too_many:
+        state["over"] = True
+        errors.append(_vault_issue("enumeration_failed", nfc(rel_dir or "."),
+                                   detail=f"列舉的總項目數(含非 .md 與目錄)超過 {_VAULT_SAFE_ENTRIES_MAX},停止列舉"))
+        return
+    for name, st in entries:
+        rel = f"{rel_dir}/{name}" if rel_dir else name
+        kind = _vault_safe_entry_kind(name, st.st_mode)
+        if kind == "link":
+            errors.append(_vault_issue("symlink_rejected", nfc(rel), detail="捷徑不跟隨、不讀"))
+        elif kind == "special":
+            errors.append(_vault_issue("special_file", nfc(rel), detail="不是一般檔,不讀"))
+        elif kind == "dir":
+            _vault_safe_descend(dfd, name, rel, manifest, errors, state)
+        elif kind == "md" and len(manifest) >= _VAULT_SAFE_FILES_MAX:
+            state["over"] = True
+            errors.append(_vault_issue("too_many_files", nfc(rel), detail=f"Markdown 超過 {_VAULT_SAFE_FILES_MAX} 個,見到這一個就停止列舉"))
+        elif kind == "md":
+            manifest[rel] = _vault_safe_attrs(st)
+        if state["over"]:
+            return
+
+
+def _vault_safe_descend(dfd, name, rel, manifest, errors, state):
+    try:
+        sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
+    except OSError as e:
+        errors.append(_vault_issue("enumeration_failed", nfc(rel), detail=e.strerror or type(e).__name__))
+        return
+    try:
+        _vault_safe_walk(sub, rel, manifest, errors, state)
+    finally:
+        os.close(sub)
+
+
+def _vault_safe_enumerate(root_fd):
+    """整個圖譜列一次 → (manifest {相對路徑: 屬性}, 錯誤, 是否超過檔數上限)。"""
+    manifest, errors, state = {}, [], {"over": False, "entries": 0}
+    try:
+        _vault_safe_walk(root_fd, "", manifest, errors, state)
+    except RecursionError:
+        errors.append(_vault_issue("enumeration_failed", ".", detail="目錄巢狀太深"))
+    return manifest, errors, state["over"]
+
+
+def _vault_safe_open_rel(root_fd, rel):
+    """從圖譜根的代號逐層開到 rel:中間目錄 O_DIRECTORY|O_NOFOLLOW,檔案走 _regular_own_fd(dir_fd,不跟捷徑、非阻塞、開檔後判一般檔)。
+    → 檔案代號或 None。中間目錄代號用完就關。"""
+    parts = rel.split("/")
+    opened = []
+    try:
+        d = root_fd
+        for p in parts[:-1]:
+            d = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=d)
+            opened.append(d)
+        return _regular_own_fd(parts[-1], os.O_RDONLY, require_owner=False, dir_fd=d)
+    except OSError:
+        return None
+    finally:
+        for f in opened:
+            os.close(f)
+
+
+def _vault_safe_lstat_rel(root_fd, rel):
+    """rel 現在的 lstat 屬性(不跟捷徑);拿不到回 None。只用來分辨「開不了」是被換掉還是單純讀不到。"""
+    parts = rel.split("/")
+    opened = []
+    try:
+        d = root_fd
+        for p in parts[:-1]:
+            d = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=d)
+            opened.append(d)
+        return _vault_safe_attrs(os.stat(parts[-1], dir_fd=d, follow_symlinks=False))
+    except OSError:
+        return None
+    finally:
+        for f in opened:
+            os.close(f)
+
+
+def _vault_safe_read_rel(root_fd, rel, remaining):
+    """有界讀一個檔 → (開檔後 fstat, 讀完 fstat, 內容 bytes 或 None, 問題種類或 None)。
+    最多讀 min(單檔上限, 剩餘總額度)+1 位元組;先判容量,超限不回內容(不解碼、不解析)。開不了回 (None, None, None, "open_failed")。"""
+    fd = _vault_safe_open_rel(root_fd, rel)
+    if fd is None:
+        return None, None, None, "open_failed"
+    try:
+        st0 = os.fstat(fd)
+        if st0.st_size > _VAULT_SAFE_FILE_MAX:
+            return st0, st0, None, "file_too_large"
+        if st0.st_size > remaining:
+            return st0, st0, None, "total_size_exceeded"
+        want = min(_VAULT_SAFE_FILE_MAX, remaining) + 1
+        buf = bytearray()
+        while len(buf) < want:
+            chunk = os.read(fd, want - len(buf))
+            if not chunk:
+                break
+            buf += chunk
+        st1 = os.fstat(fd)
+        if len(buf) > _VAULT_SAFE_FILE_MAX:
+            return st0, st1, None, "file_too_large"
+        if len(buf) > remaining:
+            return st0, st1, None, "total_size_exceeded"
+        return st0, st1, bytes(buf), None
+    finally:
+        os.close(fd)
+
