+    import unicodedata as _ud
+    return sorted({f"U+{ord(ch):04X}" for ch in text if (ch not in "\n\t" and _ud.category(ch) in ("Cc", "Cf", "Zl", "Zp", "Cs"))
+                   or ch == "ㅤ"})
