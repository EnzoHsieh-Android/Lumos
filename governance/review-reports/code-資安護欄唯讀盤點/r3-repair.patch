+def _read_fd_capped(fd, limit):
+    """從已開的檔案代號讀到檔尾,或讀滿 limit+1 位元組就停(limit=None 讀到底)→ 位元組。超不超過 limit 由呼叫端判。
+    每次請求最多 64KB、也不超過離 limit+1 還差的量,所以總共最多讀 limit+1。OSError 往上拋。
+    ★有界讀的唯一一份★:跑滿回顧一族(_retro_read_bytes)與 security list 的安全讀取(_vault_safe_read_rel)共用
+    (代碼審 code-資安護欄唯讀盤點 r2 架構對齊席:原本兩邊各寫一個迴圈)。"""
+    chunks, n = [], 0
+    while limit is None or n <= limit:
+        want = 65536 if limit is None else min(65536, limit + 1 - n)
+        b = os.read(fd, want)
+        if not b:
+            break
+        chunks.append(b)
+        n += len(b)
+    return b"".join(chunks)
