+
+    def __init__(self, initial=()):
+        super().__init__()
+        from collections import Counter as _Counter
+        self._per_node = _Counter()
+        self._omitted = defaultdict(_Counter)
+        self._tried = _Counter()
+        for e in initial:
+            self.append(e)
+
+    def append(self, e):
+        self._tried[e["kind"]] += 1
+        node = e.get("node")
+        if self._per_node[node] >= _SECINV_ERRORS_PER_NODE:
+            self._omitted[node][e["kind"]] += 1
+            return
+        self._per_node[node] += 1
+        super().append(e)
+
+    def extend(self, es):
+        for e in es:
+            self.append(e)
+
+    def __iadd__(self, es):
+        self.extend(es)
+        return self
+
+    def attempted(self, kinds):
+        return sum(self._tried[k] for k in kinds)
+
+    def finalize(self):
+        for node, c in self._omitted.items():
+            n = sum(c.values())
+            super().append(_vault_issue("errors_truncated", node, omitted=n, omitted_by_kind=dict(c),
+                                        detail=f"這篇另有 {n} 筆同類錯誤沒有逐筆列出(每篇最多 {_SECINV_ERRORS_PER_NODE} 筆)"))
