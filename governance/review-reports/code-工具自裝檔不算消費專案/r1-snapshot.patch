+    out = run(v, "set", "S", "about_code", "src/沒這個檔.ts", expect_rc=2)
+    check("③寫不存在的路徑要當場擋下(這正是手改一手滑會產生的東西)",
+          "about_code: src/real.ts" in read(p), read(p) + str(out))
