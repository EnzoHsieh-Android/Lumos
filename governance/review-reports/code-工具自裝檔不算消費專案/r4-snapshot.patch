+def _git_show_many(root, ref, paths):
+    """一次讀出 ref 版本裡多支檔的內容(git cat-file --batch);不存在或讀不到的回 None。"""
+    import subprocess
+    req = "".join(f"{ref}:{p}\n" for p in paths).encode("utf-8")
+    try:
+        r = subprocess.run(["git", "cat-file", "--batch"], input=req, capture_output=True,
+                           cwd=str(root), timeout=_disp_git_timeout())
+    except (OSError, subprocess.TimeoutExpired):
+        return {p: None for p in paths}
+    out, i, res = r.stdout, 0, {}
+    for p in paths:
+        nl = out.find(b"\n", i)
+        if nl < 0:
+            res[p] = None
+            continue
+        head = out[i:nl].decode("utf-8", "replace")
+        i = nl + 1
+        parts = head.split(" ")
+        if len(parts) == 3 and parts[2].isdigit() and not head.endswith((" missing", " ambiguous")):
+            size = int(parts[2])
+            res[p] = out[i:i + size] if parts[1] == "blob" else None
+            i += size + 1
+        else:
+            res[p] = None
+    return res
