+    about_code 寫入時已經照磁碟校正過(解連結、大小寫、Unicode 寫法;_about_code_path),所以字面比就夠。"""
+    return nfc(_posix_norm(strip_quotes(str(value).strip())))
+
+
+def _nodehome_homes(repo_root, side):
+    """[S2] {檔: [家那幾篇]}。只看 about_code 欄位值、不看預標指紋有沒有過期(指紋在每次寫回都會過期)。
+    回 (homes, 每篇自己的檔集合)。"""
+    homes, own = {}, {}
+    for rel, n in side.notes.items():
+        keys = {k for k in (_nodehome_key(v) for v in n["about"]) if k}
+        own[rel] = keys
+        if n["type"] != "system" or n["status"] not in _NODEHOME_HOME_STATUSES:
+            continue
+        for k in keys:
+            homes.setdefault(k, []).append(rel)
+    return homes, own
+
+
+def _nodehome_refs(text, side, req):
+    """[S7][S8] 這篇用反引號寫到哪幾支需要家的檔:抽取跟改檔前推筆記同一支(完整路徑+在受版控檔裡唯一的裸檔名)。
+    裸檔名不唯一時推筆記那支不認它,這裡也不認——不構成「別人檔的入口」,就不算認領。"""
+    top_dirs = {p.split("/", 1)[0] for p in side.all_paths if "/" in p and not p.startswith(".")}
+    full, bare = _node_code_ref_tokens(text, top_dirs)
+    refs = {nfc(t) for t, _l in full if nfc(t) in req}
+    if int(_impact_knob("LUMOS_IMPACT_BASENAME_MATCH", 1)):
+        counts, where = {}, {}
+        for p in side.all_paths:
+            b = p.rsplit("/", 1)[-1]
+            counts[b] = counts.get(b, 0) + 1
+            where[b] = p
+        for b in bare:
+            if counts.get(b) == 1 and where[b] in req:
+                refs.add(where[b])
+    return refs
+
+
+def _nodehome_changes(repo_root, base, tip):
+    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
+    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
+    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
+    if tip == "index":
+        args = ["diff", "--cached", "--name-status", "-z", "-M"]
+        if base is None:
+            args.append(_EMPTY_TREE_SHA)
+    else:
+        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
+    raw = _nodehome_git(repo_root, *args)
+    if raw is None:
+        return None
+    toks = _nodehome_split_z(raw)
+    out, i = [], 0
+    while i < len(toks):
+        st = toks[i]
+        code = st[:1]
+        if code in ("R", "C") and i + 2 < len(toks):
+            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
+            i += 3
+        elif i + 1 < len(toks):
+            p = nfc(toks[i + 1])
+            out.append((code, p if code != "A" else None, p if code != "D" else None))
+            i += 2
+        else:
+            break
+    return out
+
+
+def _nodehome_commit_groups(repo_root, base, tip):
+    """推送前:範圍裡每個非合併提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。"""
+    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--no-merges", f"{base}..{tip}" if base else tip)
+    if raw is None:
+        return None
+    out = []
+    for sha in raw.decode("ascii", errors="replace").split():
+        r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
+        if r is None:
+            return None
+        toks, paths, i = _nodehome_split_z(r), set(), 0
+        while i < len(toks):
+            code = toks[i][:1]
+            if code in ("R", "C") and i + 2 < len(toks):
+                paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
+                i += 3
+            elif i + 1 < len(toks):
+                paths.add(nfc(toks[i + 1]))
+                i += 2
+            else:
+                break
+        out.append(paths)
+    return out
+
+
+def _nodehome_golive(repo_root, tip):
+    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。"""
+    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{_NODEHOME_GOLIVE_MARK}",
+                        tip or "HEAD", "--", "scripts/hooks/pre-commit")
+    if not raw:
+        return None
+    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
+    return first if _LENS_SHA_RE.match(first) else None
+
+
+def _nodehome_clamp_base(repo_root, base, tip):
+    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
+    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。"""
+    gl = _nodehome_golive(repo_root, tip)
+    if gl is None:
+        return base
+    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
+    if r is None or r.returncode != 0:
+        return base                                    # 上線點不在這條歷史上
+    if base in (None, _EMPTY_TREE_SHA):
+        return gl
+    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
+    return gl if (r is not None and r.returncode == 0 and base != gl) else base
+
+
+def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
+    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
+    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
+    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
+    None=整批當成一個提交(提交前)。"""
+    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
+    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
+    homesN, ownN = _nodehome_homes(repo_root, N)
+    homesB, ownB = _nodehome_homes(repo_root, B)
+    blocks, reminders, pairs = [], [], []
+    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
+    for code, old, new in changes:
+        if old is not None and (new is None or code == "R"):
+            deleted.add(old)
+        if new is None:
+            continue
+        changed_new.add(new)
+        if code in ("A", "R", "C"):
+            added.add(new)
+        if code == "R" and old:
+            renamed_from[new] = old
+    code_changed = {p for p in changed_new if p in reqN}
+    code_added = {p for p in added if p in reqN}
+    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
+    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
+    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
+    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
+    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
+    code_touched = code_changed | code_deleted
+    vpre = vault_rel + "/"
+    refs_cache = {}
+
+    def refs_now(rel):
+        if rel not in refs_cache:
+            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
+        return refs_cache[rel]
+
+    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]
+    edited = set()
+    for p in sorted(changed_new):
+        if not (p.startswith(vpre + "Systems/") and p.endswith(".md")):
+            continue
+        rel = p[len(vpre):]
+        if rel not in N.notes:
+            continue
+        n = N.notes[rel]
+        src = renamed_from.get(p)
+        src_rel = src[len(vpre):] if src and src.startswith(vpre) else rel
+        b = B.notes.get(src_rel)
+        if n["type"] != "system":
+            continue
+        edited.add(rel)
+        route_src[rel] = src_rel
+        if (b is None or b["sig"] != n["sig"]) and n["status"] in _NODEHOME_HOME_STATUSES:
+            content_changed.append(rel)
+        # [S9] 規則二:這篇之後比之前多出來的別人的檔(新節點=全部都算新)
+        foreign_now = refs_now(rel) - ownN.get(rel, set())
+        foreign_before = (_nodehome_refs(b["text"], B, reqB) - ownB.get(src_rel, set())) if b else set()
+        for f in sorted(foreign_now - foreign_before):
+            blocks.append(("foreign", (rel, f, homesN.get(f, []))))
+            pairs.append((f, rel))
+        # [S17] 新開的、或這次才成為現況(planned/deferred 之類升成 doing/done/stale)的沒寫負責範圍;
+        # [S18] 舊篇管的檔變多、超過上限、沒寫(只數還存在的檔)
+        cnt_now = len({k for k in ownN.get(rel, set()) if k in N.files})
+        becomes_home = n["status"] in _NODEHOME_HOME_STATUSES and (b is None or b["status"] not in _NODEHOME_HOME_STATUSES)
+        if b is None or becomes_home:
+            if not _nodehome_resp_ok(n["resp"]):
+                blocks.append(("new-node-resp", (rel, cnt_now)))
+        else:
+            cnt_before = len({k for k in ownB.get(src_rel, set()) if k in B.files})
+            if cnt_now > cnt_before and cnt_now > cfg["max_files"] and not _nodehome_resp_ok(n["resp"]):
+                blocks.append(("over-limit-resp", (rel, cnt_now)))
+    # [S9] 新增的檔喚醒了沒改的節點裡原本就寫著的檔名:那篇沒改,但它從這次起就是別人檔的入口(第二輪外家席)
+    if code_added:
+        for rel in sorted(N.notes):
+            if rel in edited or N.notes[rel]["type"] != "system":
+                continue
+            for f in sorted((refs_now(rel) & code_added) - ownN.get(rel, set())):
+                blocks.append(("foreign-awakened", (rel, f, homesN.get(f, []))))
+                pairs.append((f, rel))
+    # [S3][S34] 新增的程式檔之後沒有家
+    for f in sorted(code_added):
+        if not homesN.get(f):
+            blocks.append(("new-homeless", f))
+    # [S4] 原本有家的檔這次變沒家(stale 照樣是家,所以例行標過期不會觸發)
+    for f in sorted(reqN & reqB):
+        if homesB.get(f) and not homesN.get(f):
+            blocks.append(("home-removed", (f, homesB[f])))
+    if code_touched:
+        cc = set(content_changed)
+        if groups is None:
+            groups = [{p for _c, o, n in changes for p in (o, n) if p}]
+        routed, wb_files, wb_notes = {}, set(), set()
+        for g in groups:
+            g_code = {p for p in g if p in reqN or p in reqB}
+            if not g_code:
+                continue                                    # 純整理節點的提交:規則三不管 [S11]
+            g_notes = {rel for rel in content_changed
+                       if (vpre + rel) in g or (vpre + route_src.get(rel, rel)) in g}
+            for rel in g_notes:
+                routed.setdefault(rel, set()).update(g_code)
+            if g_notes:
+                wb_files |= g_code
+                wb_notes |= g_notes
+        # [S13] 寫進去的節點要是同一個提交裡某支改動(含刪掉)的檔的家——刪掉的檔看它刪之前的家
+        for rel in content_changed:
+            if rel not in routed:
+                continue
+            mine = ownN.get(rel, set()) | ownB.get(route_src.get(rel, rel), set())
+            if not (mine & routed[rel]):
+                blocks.append(("route", (rel, sorted(routed[rel]))))
+                pairs.extend((f, rel) for f in sorted(routed[rel]))
+        legacy = sorted(f for f in code_changed - code_added if not homesN.get(f))
+        for f in legacy:
+            if f in wb_files:
+                # [S13b] 有寫回的提交裡,每支改動檔都要有家(新增的那幾支已由 [S3] 報)——提交層級:跟那篇講什麼無關
+                blocks.append(("write-back-homeless", f))
+                pairs.extend((f, rel) for rel in sorted(wb_notes))
+            else:
+                reminders.append(("legacy-homeless", f))    # [S5] 沒寫回:只提醒
+        # [S15] 「該動哪篇」照家算
+        many = int(_impact_knob("LUMOS_IMPACT_ABOUT_MAX", 8))
+        for f in sorted(code_changed):
+            hs = homesN.get(f) or []
+            if not hs or any(h in cc for h in hs):
+                continue
+            reminders.append(("nudge-many" if len(hs) > many else "nudge", (f, hs)))
+    for f in sorted(bad_names & changed_new):
+        reminders.append(("bad-name", f))
+    return {"blocks": blocks, "reminders": reminders, "pairs": pairs}
+
+
+def _nodehome_candidates(f, homes, side):
+    """[S6] 候選家:同資料夾其他檔的家、正文用反引號提到它的節點。"""
+    d = f.rsplit("/", 1)[0] if "/" in f else ""
+    cand = []
+    for g, hs in sorted(homes.items()):
+        if g != f and (g.rsplit("/", 1)[0] if "/" in g else "") == d:
+            cand.extend(h for h in hs if h not in cand)
+    base = f.rsplit("/", 1)[-1]
+    for rel, n in sorted(side.notes.items()):
+        if rel not in cand and (f in n["text"] or f"`{base}`" in n["text"]):
+            cand.append(rel)
+    return cand[:3]
+
+
+def _nodehome_render(res, homes, side, cfg, mode_word):
