+        L.append("    lumos append <節點> about_code <檔>")
+    foreign = [(r, f, h, False) for r, f, h in by.get("foreign", [])] + [(r, f, h, True) for r, f, h in by.get("foreign-awakened", [])]
+    if foreign:
+        L.append("")
+        L.append(f"■ 節點裡新寫進了別人的檔名({len(foreign)} 處)——用反引號寫別人的檔,改那支檔時就會推出這篇,東西就越寫越多:")
