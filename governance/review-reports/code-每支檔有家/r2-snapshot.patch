+    env = m.Env(root / "docs" / "kg-knowledge")
+    hit_b = [n for n, _h in m._impact_reverse_lookup("src/b.py", env, root) if n == "Systems/A.md"]
+    check("③推筆記會把 A 推給 src/b.py,每支檔有家也認得 A 寫到 src/b.py", bool(hit_b) and "src/b.py" in refs, f"{hit_b} {refs}")
