+    import ast as _ast
+    src = Path(GRAPHCTL).read_text(encoding="utf-8")
+    tree = _ast.parse(src)
+    calls = {}
+    for fn in tree.body:
+        if isinstance(fn, _ast.FunctionDef):
+            names = {c.func.id for c in _ast.walk(fn) if isinstance(c, _ast.Call) and isinstance(c.func, _ast.Name)}
+            calls[fn.name] = names
+    for who in ("_refcheck_scan", "_impact_reverse_lookup", "_nodehome_refs"):
+        check(f"①{who} 呼叫共用抽取 _node_code_ref_tokens", "_node_code_ref_tokens" in calls.get(who, set()), str(sorted(calls.get(who, set())))[:300])
+    for who in ("_refcheck_scan", "_impact_reverse_lookup", "_nodehome_refs"):
+        body = _ast.get_source_segment(src, next(f for f in tree.body if isinstance(f, _ast.FunctionDef) and f.name == who))
+        check(f"②{who} 不再自己跑 INLINE_CODE_RE(不另寫一套)", "INLINE_CODE_RE" not in body, who)
+    # 行為面:推筆記與每支檔有家對同一段文字認得的檔一樣
+    root = _nh_repo()
+    _nh_base(root)
