+    if routes:
+        L.append("")
+        L.append(f"■ 這次寫了說明的節點,不是任何一支改動檔的家({len(routes)} 篇):")
+        for rel, files in routes[:cap]:
+            L.append(f"  {stem(rel)}(這次改的檔:{'、'.join(files[:5])}{' …' if len(files) > 5 else ''})")
