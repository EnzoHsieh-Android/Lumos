+def _nodehome_ledger(repo_root, vault):
+    """[S28][S29][S39] 健檢三段的母體與判定——跟 home check 共用同一套函式(需要家的檔、家、別人的檔)。
+    讀提交索引那一份(跟磁碟一樣的直接讀磁碟)。三段都分「守衛上線後才出現的」(該被擋卻進來了)與「上線前就在的」舊帳。
+    回 dict,或 None(不是 git 專案/讀不到)。"""
+    root = Path(repo_root)
+    try:
+        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
+    except ValueError:
+        return None
+    side = _nodehome_side(root, "index", vault_rel)
+    if side is None:
+        return None
+    cfg = _nodehome_config(root, side._reader(".lumos/config.json"), from_snapshot=True)
+    skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root, "")[0]
+    req, bad = _nodehome_required(root, side, cfg, skip)
+    homes, own = _nodehome_homes(root, side)
+    homeless = sorted(f for f in req if not homes.get(f))
+    gl = _nodehome_golive(root, "HEAD")
+    after, G = set(), None
+    if gl:
+        # [S39] 上線後才新增(含改名成新路徑)的檔;改名只看新路徑(第二輪外家席:只收新增會把繞過的改名算成舊帳)
+        for args in (("log", "-M", "--diff-filter=AR", "--name-only", "--format=", "-z", f"{gl}..HEAD"),
+                     ("show", "-M", "--diff-filter=AR", "--name-only", "--format=", "-z", gl)):
+            raw = _nodehome_git(root, *args)
+            if raw:
+                after |= {nfc(x) for x in _nodehome_split_z(raw)}
+        # 上線點那一刻的圖譜(沒變動的節點跟現在共用,只讀有變的)——拿來分「別人的檔」「管太多」兩段的舊帳與繞過
+        ch = _nodehome_git(root, "diff", "--cached", "--name-only", "-z", "--no-renames", gl)
+        G = _nodehome_side(root, gl, vault_rel, share=side,
+                           changed={nfc(x) for x in _nodehome_split_z(ch)} if ch is not None else None)
+    reqG = _nodehome_required(root, G, cfg, skip)[0] if G is not None else set()
+    ownG = _nodehome_homes(root, G)[1] if G is not None else {}
+    foreign, foreign_new, over, over_new = {}, {}, [], []
+    for rel, n in sorted(side.notes.items()):
+        if n["type"] != "system":
+            continue
+        f = sorted(_nodehome_refs(n["text"], side, req) - own.get(rel, set()))
+        if f:
+            then = set()
+            if G is not None and rel in G.notes:
+                then = _nodehome_refs(G.notes[rel]["text"], G, reqG) - ownG.get(rel, set())
+            newer = [x for x in f if G is not None and x not in then]
+            if newer:
+                foreign_new[rel] = newer
+            older = [x for x in f if x not in newer]
+            if older:
+                foreign[rel] = older
+        cnt = len({k for k in own.get(rel, set()) if k in side.files})
+        if n["status"] in _NODEHOME_HOME_STATUSES and cnt > cfg["max_files"] and not _nodehome_resp_ok(n["resp"]):
+            g = G.notes.get(rel) if G is not None else None
+            was_over = g is not None and g["status"] in _NODEHOME_HOME_STATUSES and not _nodehome_resp_ok(g["resp"]) \
+                and len({k for k in ownG.get(rel, set()) if k in G.files}) > cfg["max_files"]
+            (over if (G is None or was_over) else over_new).append((rel, cnt))
+    return {"cfg": cfg, "bypassed": [f for f in homeless if f in after], "legacy": [f for f in homeless if f not in after],
+            "foreign": foreign, "foreign_new": foreign_new, "over": over, "over_new": over_new,
+            "bad_names": sorted(_nodehome_show(x) for x in bad), "golive": gl}
+
