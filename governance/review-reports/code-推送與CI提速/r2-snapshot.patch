+            old = e
+        tests = old.get("tests") if isinstance(old, dict) else None
+        if not isinstance(tests, dict) or not all(_duration_ok(v) for v in tests.values()):
+            why = f"讀不進來({old})" if isinstance(old, Exception) else "格式不對或有不合法的秒數"
+            print(f"擋下:舊耗時表 {_TEST_DURATIONS_REL} {why},這次不覆蓋;修好它,或刪掉它再刷新(刪掉就只用這次的實測重建)",
+                  file=sys.stderr)
+            return 2
+        table = dict(tests)
+    before, got, seen = len(table), 0, {}
+    for p in runs:
+        try:
+            st = p.stat()
+            seen[p] = (st.st_mtime_ns, st.st_size)   # 刪之前對一次:讀完之後被改寫的留給下次(代碼審 r1 併發資源席)
+            tests = json.loads(p.read_bytes())["tests"]
+            if not isinstance(tests, dict):
+                raise TypeError
+        except (OSError, ValueError, RecursionError, TypeError, KeyError):
+            print(f"  略過讀不懂的 {p.name}", file=sys.stderr)
+            continue
+        for k, v in tests.items():
