+def _duration_ok(v):
+    """耗時表的一筆秒數合不合法:非負的有限數字;布林不算,轉不成浮點的超大整數也不算。
+    跟 scripts/test_lumos.py 的 _duration_ok 同一條規則(刷新寫得出來的表,執行器一定讀得進),t_test_durations_refresh 對照兩邊。"""
+    import math
+    if isinstance(v, bool) or not isinstance(v, (int, float)):
+        return False
+    try:
+        return math.isfinite(float(v)) and v >= 0
+    except OverflowError:
+        return False
+
+
