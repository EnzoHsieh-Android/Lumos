     tails = {}
     results, rerr = _run_bound_tests(rr, items, tails=tails)
     if results is None:
         return None, rerr
     rows = []
     for node_id, plat, method, verdict, detail, _secs in results:
         tail = tails.get((node_id, plat, method), "")
         n, skipped = _ran_count(per_prof(plat), tail)
         v, why = _spec_gate_verdict(n, skipped, verdict, detail,
                                     declared=_spec_gate_declared(method, loose_for(plat)))
