+    check("S7 治理帳已被追蹤:照舊措辭", len(cs3) == 1 and "被 git 忽略" not in cs3[0]["message"], cs3)
+    # 規則長:全域忽略檔放在 150 字的路徑底下
+    longdir = Path(tempfile.mkdtemp(prefix="gctl-igl-")) / ("x" * 150)
