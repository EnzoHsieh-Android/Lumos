+def _gov_ledger_ignored(root, rel=GOV_LOG_REL, deadline=None):
+    """治理帳是不是被 git 忽略 → ("ignored", 蓋到的規則) | ("not", "") | ("unknown", "")。比對工具、規格閘、doctor 共用這一支,放在帳檔這一區(跟 _local_ledger_doctor_msgs 同區)
+    (Projects/紅燈版實跑三缺口_計劃 做法 4)。check-ignore -q 判被忽略:它照 ! 否定規則算,也不回報已追蹤的檔(已追蹤就不算被忽略,改動照樣能提交);
+    被忽略才 -v 取規則——-v 對否定規則照樣印那一行、回 0,所以不能只看 -v。-v 輸出 tab 前那段(來源:行號:規則)原樣清洗、不拆欄位
+    (來源路徑可能含冒號)。任一次 git 回不來、逾時、回傳碼不是 0/1 就是判不了,呼叫端照舊措辭。"""
+    q = _lens_git_dl(root, "check-ignore", "-q", "--", rel, quote=True, deadline=deadline)
+    if q is None or q.returncode not in (0, 1):
+        return "unknown", ""
+    if q.returncode == 1:
+        return "not", ""
+    v = _lens_git_dl(root, "check-ignore", "-v", "--", rel, quote=True, deadline=deadline)
+    rule = v.stdout.split("\t", 1)[0].strip() if v is not None and v.returncode == 0 else ""
+    return "ignored", _out_clean(rule, 300) or "(讀不出是哪一條)"
