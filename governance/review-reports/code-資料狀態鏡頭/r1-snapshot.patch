+_DATA_STATE_NEW_HEADS = ("新舊互讀", "寫一半", "衍生資料", "時間", "不可逆")
+_CORRECTNESS_LENS_ITEMS = {
+    "邊界": ("空集合",), "資源": ("錯誤路徑和提早 return",), "例外與 None": ("丟例外或回 None",),
+    "冪等與併發": ("讀了兩次", "重複生效"),
+    "新舊互讀": ("舊程式讀新資料",), "寫一半": ("救得回",), "衍生資料": ("取哪一筆",),
+    "時間": ("具體時刻",), "不可逆": ("不該動",),
+}
