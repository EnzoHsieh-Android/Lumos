+        root, v, g = _rc_repo(tag, commit=False); roots.append(root)
+        (root / "docs" / ".governance-log.jsonl").write_bytes(base.encode("utf-8"))
+        g("add", "-A"); g("commit", "-qm", "init"); g("checkout", "-qb", "feat")
+        return root, v, g
+    real = m.subprocess
+    try:
+        for name, base, head, extra, want in (
