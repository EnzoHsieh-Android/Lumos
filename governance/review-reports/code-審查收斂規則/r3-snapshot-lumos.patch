+def _residual_scan(env, notes=None):
+    """圖譜裡每個 [residual:] 標記 → [(rel, body, ref, 決策狀態, 問題清單)]。治理帳只讀一次、決策解析共用一份快取。"""
+    notes = env.notes if notes is None else notes
+    asks, ask_err = _residual_ask_index(_vault_repo_root(env))
+    cache, out = {}, []
+    for rel, n in sorted(notes.items()):
+        invs, _ = extract_contracts(n)
+        for body in invs:
+            for ref in invariant_residual_refs(body):
+                st = _pq_decision_state(env, rel, ref, cache=cache)
+                out.append((rel, body, ref, st, _residual_check(env, rel, body, ref, asks=asks, ask_err=ask_err, cache=cache)))
+    return out
