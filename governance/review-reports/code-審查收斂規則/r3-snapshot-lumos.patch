+                return 0, None, False
+        elif path.is_file() and not path.is_symlink():
+            try:
+                if _j.loads(path.read_text(encoding="utf-8")) == want:
+                    return len(entries), None, False
+            except (ValueError, UnicodeDecodeError, RecursionError):
+                pass   # 讀不出就重寫
+        why = _write_refusal_reason(path)
+        if why:
+            return None, f"殘留索引 {_RESIDUAL_INDEX_REL}:{why}", False
+        path.parent.mkdir(parents=True, exist_ok=True)
