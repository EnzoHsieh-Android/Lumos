+def _residual_index_write(env):
+    """重算 governance/residual-index.json(呼叫端拿著寫入鎖)→ (筆數, None, 有沒有改檔) 或 (None, 寫不進去的原因, False)。
+    索引跟重算結果相同(含「檔不在、圖譜也沒有殘留」)就不碰檔案(代碼審 r2 G6:沒事可做的路原本也重寫,打錯字的指令在工作樹留下沒要求的改動)。
+    寫不進去(捷徑、不是一般檔、建資料夾失敗、磁碟錯)一律回原因、不丟例外——合約行已經寫了,呼叫端要照實講「合約行已改、索引沒更新」(代碼審 r1 G2)。
+    同檔已有這種「回原因不丟例外」的先例:_drift_fix_load(讀檔失敗回 (None, 原因))、_signoff_append(寫帳失敗回原因);
+    一般寫入被拒的唯一信號仍是 WriteBlocked(派發層印「擋下」),這裡不用它,因為那句「擋下」會讓人以為合約行也沒寫(代碼審 r2 架構席)。"""
+    import json as _j
+    try:
+        entries = _residual_index_entries(Env(env.vault))   # 重新載入:剛寫的那篇要用磁碟上的新內容
+        path = _vault_repo_root(env) / _RESIDUAL_INDEX_REL
+        want = {"version": 1, "entries": entries}
+        if not os.path.lexists(path):
