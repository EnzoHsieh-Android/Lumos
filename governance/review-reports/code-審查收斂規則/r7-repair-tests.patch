+def t_pitfalls_ignores_git_external_diff_env():
+    """[r6 G5] 主程式入口拿掉 GIT_EXTERNAL_DIFF(它讓 git diff 改用外部工具輸出,各閘讀到的差異不再是 git 的):
+    環境帶一支會改輸出的外部差異工具跑 pitfalls --diff,結果(分級、理由、挑出的測試關鍵字)跟沒帶時相同。
+    固定例子:主線有殘留 d12 守 src/a.py,分支改 src/a.py 的 compute_total() → high(改到帶殘留合約守的程式)、關鍵字有 compute_total。
+    前置用乾淨環境證明那支工具真的會改 git diff 的輸出。lumos 自己產生差異的呼叫都已帶 --no-ext-diff,所以入口那行實際管的是 lumos 起的子行程:
+    另跑一次 code-loop check(bound-tests 真跑使用者專案的測試執行器),執行器看到的 GIT_EXTERNAL_DIFF 應是空的。
+    判準來源:r6 合約席(入口那行沒有測試,刪掉照綠)。應抓到的錯:入口不拿掉 → 子行程那條紅。"""
+    import json as _j
+    import os as _os
+    import shutil as _sh
+    import subprocess as _sp
+    import tempfile as _tf
+    roots = []
+    try:
+        root, v, g = _rc_r4_main_with_residual("rc-r6g5-ext", roots)
+        body = "def a():\n    return 1\n\n\ndef compute_total():\n    return 2\n"
+        _rc_r5_rebase_main(g, lambda: (root / "src" / "a.py").write_text(body, encoding="utf-8"))
+        (root / "src" / "a.py").write_text(body.replace("return 2", "return 42"), encoding="utf-8")
+        g("commit", "-qam", "改 compute_total")
+        tool_dir = Path(_tf.mkdtemp(prefix="gctl-rc-r6g5-tool-"))
+        roots.append(tool_dir)
+        tool = tool_dir / "extdiff.sh"
+        tool.write_text("#!/bin/sh\necho \"EXTDIFF-REPLACED $1\"\n", encoding="utf-8")
+        _os.chmod(tool, 0o755)
+        env0 = _rc_git_env()
+        def tier(extra):
+            r = _sp.run([sys.executable, GRAPHCTL, "--vault", str(v), "pitfalls", "--diff", "main..HEAD", "--no-lint", "--json", "--repo", str(root)],
+                        capture_output=True, text=True, env=dict(env0, **extra), check=False)
+            try:
+                d = _j.loads(r.stdout)
+            except ValueError:
+                return ("?", r.stdout[-200:] + r.stderr[-200:], None)
+            return (d.get("tier"), d.get("tier_reason"), d.get("affected_keys"))
+        base = tier({})
+        check("★前置★ 沒帶外部差異工具 → high、關鍵字有 compute_total", base[0] == "high" and base[2] and "compute_total" in base[2], repr(base))
+        plain = _sp.run(["git", "-C", str(root), "diff", "-U0", "main..HEAD"], capture_output=True, text=True, env=env0, check=False).stdout
+        ext = _sp.run(["git", "-C", str(root), "diff", "-U0", "main..HEAD"], capture_output=True, text=True,
+                      env=dict(env0, GIT_EXTERNAL_DIFF=str(tool)), check=False).stdout
+        check("★前置★ 外部差異工具真的會改 git diff 的輸出(情境成立)", "EXTDIFF-REPLACED" in ext and "EXTDIFF-REPLACED" not in plain
+              and "return 42" in plain and "return 42" not in ext, ext[:200])
+        got = tier({"GIT_EXTERNAL_DIFF": str(tool)})
+        check("G5 環境帶會改輸出的 GIT_EXTERNAL_DIFF → 結果跟沒帶時相同", got == base, f"{got!r} vs {base!r}")
+        # lumos 自己產生差異的 git diff 都帶 --no-ext-diff,入口那行實際作用在 lumos 起的子行程(代價:使用者自己設的值在 lumos 底下不生效)。
+        # 固定例子:bound-tests 真跑使用者專案的測試執行器,執行器把它看到的 GIT_EXTERNAL_DIFF 寫進檔案 → 應是 None。
+        bt = _mk_bound_tests_repo(_tf.mkdtemp(prefix="gctl-rc-r6g5-bt-"))
