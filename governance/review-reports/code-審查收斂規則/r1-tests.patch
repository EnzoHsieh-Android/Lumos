+def _rc_repo(tag="rc", residual_line=None, commit=True):
+    """git 專案(.git 在 root)+ docs/kg 圖譜;Systems/S 兩條合約(一條已審、一條未審),about_code=src/a.py;
+    Projects/a_計劃 帶 d12–d15;tests/test_a.py 有 test_rc_guard。residual_line 給了就直接寫在已審那條行尾(不經指令)。"""
+    import subprocess as _sp, json as _j
+    root = Path(tempfile.mkdtemp(prefix=f"gctl-{tag}-"))
+    g = lambda *a: _sp.run(["git", "-C", str(root), *a], capture_output=True, text=True)
+    g("init", "-q", "-b", "main"); g("config", "user.email", "t@t"); g("config", "user.name", "t")
+    (root / ".lumos").mkdir()
+    (root / ".lumos" / "config.json").write_text(_j.dumps({"test_profile": "python"}), encoding="utf-8")
+    (root / "src").mkdir()
+    (root / "src" / "a.py").write_text("def a():\n    return 1\n", encoding="utf-8")
+    (root / "src" / "b.py").write_text("def b():\n    return 2\n", encoding="utf-8")
+    (root / "tests").mkdir()
+    (root / "tests" / "test_a.py").write_text("def test_rc_guard():\n    assert True\n", encoding="utf-8")
+    v = root / "docs" / "kg"
+    for sub in ("Systems", "Verification", "Projects", "MOC"):
+        (v / sub).mkdir(parents=True)
+    (v / "MOC" / "idx.md").write_text("---\ntype: moc\n---\n# idx\n", encoding="utf-8")
+    tail = f" {residual_line}" if residual_line else ""
+    (v / "Systems" / "S.md").write_text(
+        "---\ntype: system\nstatus: done\nsummary: |-\n"
+        f"  KEY:★INVARIANT★ {_RC_CONTRACT} [test:test_rc_guard] [audit:sonnet/2026-10-13]{tail}\n"
+        f"  KEY:★INVARIANT★ {_RC_UNAUDITED} [test:test_rc_guard]\n"
+        "about_code:\n  - src/a.py\n---\n# S\n", encoding="utf-8")
+    (v / "Projects" / "a_計劃.md").write_text(
+        "---\ntype: project\nstatus: doing\n" + _RC_PLAN_DECISIONS + "---\n# a\n", encoding="utf-8")
+    if commit:
+        g("add", "-A"); g("commit", "-qm", "init")
+    return root, v, g
