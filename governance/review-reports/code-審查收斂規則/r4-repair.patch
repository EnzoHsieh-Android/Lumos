 def _residual_checker_ok(checker):
     """--checker 要是 <模型>/<YYYY-MM-DD>,而且日期是真的日期(9999-99-99、2026-02-30 都不收)。"""
     import datetime
     m = _RESIDUAL_CHECKER_RE.fullmatch(checker or "")
     if not m:
         return False
     try:
         datetime.date.fromisoformat(m.group(1))
     except ValueError:
         return False
     return True
 
 
