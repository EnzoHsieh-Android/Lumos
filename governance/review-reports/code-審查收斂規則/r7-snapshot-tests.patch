+def t_doctor_checks_residual_ref():
+    """[審查收斂規則 S3] [residual:] 指到的決策事後被翻案或被刪:doctor 報錯、指出去哪一篇補或用 --remove 拿掉。"""
+    import shutil as _sh
+    root, v, g = _rc_repo("rc-s3", residual_line="[residual:Projects/a_計劃#d12]")
+    p = v / "Projects" / "a_計劃.md"
+    try:
+        _rc_ask(v, "c1")   # 手寫的標記要有第二個代理的問答才合格(r1 G3:doctor 跟 --add 同一套驗法),前置才是「決策好好的」
+        run(v, "guard", "residual", "--reindex", expect_rc=0)
+        r0 = run(v, "doctor")
+        check("★前置★ 決策好好的 → doctor 不報殘留", "[residual:Projects/a_計劃#d12]" not in r0.stdout, r0.stdout[-600:])
+        p.write_text(p.read_text(encoding="utf-8").replace("    id: d12\n    decided: 2026-10-14\n",
+                                                           "    id: d12\n    decided: 2026-10-14\n    valid: false\n    superseded_by: Projects/a_計劃#d14\n    ended: 2026-10-15\n"),
+                     encoding="utf-8")
+        r1 = run(v, "doctor")
+        check("S3 被翻案 → doctor 報錯並指路", "[residual:Projects/a_計劃#d12]" in r1.stdout and "已被翻案" in r1.stdout
+              and "去 Projects/a_計劃 補回那筆決策" in r1.stdout and "guard residual" in r1.stdout and "--remove" in r1.stdout, r1.stdout[-1200:])
