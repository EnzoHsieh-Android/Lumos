+# ── 審查收斂規則(Projects/審查收斂規則_計劃):殘留標記、第二個代理的問答留痕、索引與風險分級 ──
+# 判準來源:計劃〈做法〉2–6 與驗收條款 S1–S9;預期值是手寫的固定例子(決策 d12 有 checker 行、d13 已翻案、d14 沒 checker、d15 內容空白),
+# 不呼叫被測函式產生 expected。
+_RC_CONTRACT = "下單不得超賣"
+# 合約行的 [audit:] 日期要不早於那筆 untestable 問答的日期(代碼審 r2 G8:手冊的順序是先問答、再審計);問答日期是跑測試當天,
+# 固定例子的審計日期寫在很遠的將來,保證「已照順序」;要測順序被擋的另外用 guard audit --date 改成較早的日期。
+_RC_AUDIT = "sonnet/2099-01-01"
+_RC_UNAUDITED = "未審的另一條規則"
+_RC_PLAN_DECISIONS = (
+    "decisions:\n"
+    "  - content: 殘留:多節點程式內互斥屬繞過設計(反例 c1、c3);第 3 輪審計收斂 checker:sonnet/2026-10-14\n"
+    "    id: d12\n    decided: 2026-10-14\n"
+    "  - content: 已被翻案的殘留 checker:sonnet/2026-10-14\n"
+    "    id: d13\n    decided: 2026-10-14\n    valid: false\n    superseded_by: Projects/a_計劃#d12\n    ended: 2026-10-14\n"
+    "  - content: 沒寫第二個代理是誰的殘留\n"
+    "    id: d14\n    decided: 2026-10-14\n"
+    "  - content: \"\"\n"
+    "    id: d15\n    decided: 2026-10-14\n")
+
+
+_RC_GIT_ENV_DROP = ("GIT_NO_REPLACE_OBJECTS", "GIT_GRAFT_FILE", "GIT_DIFF_OPTS", "GIT_EXTERNAL_DIFF")
+
+
+def _rc_git_env():
+    """測試自己叫 git 用的乾淨環境:拿掉 lumos 入口會設的那幾個變數(代碼審 r5 G5)。測試經 lumos 跑時(fix-check、bound-tests)
+    會繼承入口設的值,證明「替身、grafts、差異選項會生效」的前置檢查就不成立;被測的 lumos 端照樣走入口。"""
+    import os as _os
+    return {k: x for k, x in _os.environ.items() if k not in _RC_GIT_ENV_DROP}
+
+
+def _rc_repo(tag="rc", residual_line=None, commit=True, vault="kg"):
+    """git 專案(.git 在 root)+ docs/<vault> 圖譜;Systems/S 兩條合約(一條已審、一條未審),about_code=src/a.py;
+    Projects/a_計劃 帶 d12 到 d15;tests/test_a.py 有 test_rc_guard。residual_line 給了就直接寫在已審那條行尾(不經指令)。
+    派工鏡頭只認 docs/*-knowledge,測鏡頭的傳 vault="rc-knowledge"。"""
+    import subprocess as _sp, json as _j
+    root = Path(tempfile.mkdtemp(prefix=f"gctl-{tag}-"))
+    g = lambda *a: _sp.run(["git", "-C", str(root), *a], capture_output=True, text=True, env=_rc_git_env())
+    g("init", "-q", "-b", "main"); g("config", "user.email", "t@t"); g("config", "user.name", "t")
+    (root / ".lumos").mkdir()
+    (root / ".lumos" / "config.json").write_text(_j.dumps({"test_profile": "python"}), encoding="utf-8")
+    (root / "src").mkdir()
+    (root / "src" / "a.py").write_text("def a():\n    return 1\n", encoding="utf-8")
+    (root / "src" / "b.py").write_text("def b():\n    return 2\n", encoding="utf-8")
+    (root / "tests").mkdir()
+    (root / "tests" / "test_a.py").write_text("def test_rc_guard():\n    assert True\n", encoding="utf-8")
+    v = root / "docs" / vault
+    for sub in ("Systems", "Verification", "Projects", "MOC"):
+        (v / sub).mkdir(parents=True)
+    (v / "MOC" / "idx.md").write_text("---\ntype: moc\n---\n# idx\n", encoding="utf-8")
+    tail = f" {residual_line}" if residual_line else ""
+    (v / "Systems" / "S.md").write_text(
+        "---\ntype: system\nstatus: done\nsummary: |-\n"
+        f"  KEY:★INVARIANT★ {_RC_CONTRACT} [test:test_rc_guard] [audit:{_RC_AUDIT}]{tail}\n"
+        f"  KEY:★INVARIANT★ {_RC_UNAUDITED} [test:test_rc_guard]\n"
+        "about_code:\n  - src/a.py\n---\n# S\n", encoding="utf-8")
+    (v / "Projects" / "a_計劃.md").write_text(
+        "---\ntype: project\nstatus: doing\n" + _RC_PLAN_DECISIONS + "---\n# a\n", encoding="utf-8")
+    if commit:
+        g("add", "-A"); g("commit", "-qm", "init")
+    return root, v, g
+
