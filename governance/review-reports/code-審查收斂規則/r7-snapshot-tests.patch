+def t_guard_audit_keeps_residual():
+    """[審查收斂規則 S2] 對帶 [residual:] 的合約重跑 guard audit:只換 [audit:] 那一段,[residual:] 與其餘原文不變。"""
+    import shutil as _sh
+    root, v, g = _rc_repo("rc-s2", residual_line="[residual:Projects/a_計劃#d12] [residual:Projects/a_計劃#d13]")
+    s = v / "Systems" / "S.md"
+    try:
+        old = next(l for l in s.read_text(encoding="utf-8").splitlines() if _RC_CONTRACT in l)
+        check("★前置★ 現場有兩個殘留標記", old.count("[residual:") == 2, old)
+        r = run(v, "guard", "audit", "Systems/S", _RC_CONTRACT, "--model", "opus", "--date", "2026-10-20")
+        new = next(l for l in s.read_text(encoding="utf-8").splitlines() if _RC_CONTRACT in l)
+        check("S2 重審成功、新戳記生效", r.returncode == 0 and "[audit:opus/2026-10-20]" in new and _RC_AUDIT not in new, f"{r.stderr[-200:]}\n{new}")
+        check("S2 [residual:] 原樣保留(位置與內容都不變)",
+              new == old.replace(f"[audit:{_RC_AUDIT}]", "[audit:opus/2026-10-20]"), f"\n舊:{old}\n新:{new}")
+    finally:
+        _sh.rmtree(root, ignore_errors=True)
