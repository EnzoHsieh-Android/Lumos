+        before = s.read_text(encoding="utf-8")
+        bad = (("決策找不到", [_RC_CONTRACT, "--add", "Projects/a_計劃#d99", "--case", "c1"], "找不到"),
+               ("決策已被翻案", [_RC_CONTRACT, "--add", "Projects/a_計劃#d13", "--case", "c1"], "翻案"),
+               ("決策內容空白", [_RC_CONTRACT, "--add", "Projects/a_計劃#d15", "--case", "c1"], "內容是空的"),
+               ("c2 沒有問過", [_RC_CONTRACT, "--add", "Projects/a_計劃#d12", "--case", "c2"], "沒有 residual-ask"),
+               ("c3 問過但判測得到", [_RC_CONTRACT, "--add", "Projects/a_計劃#d12", "--case", "c3"], "testable"),
+               ("決策內容沒有那一筆的 checker:", [_RC_CONTRACT, "--add", "Projects/a_計劃#d14", "--case", "c1"], "checker:sonnet/2026-10-14"),
+               ("指標是短名", [_RC_CONTRACT, "--add", "a_計劃#d12", "--case", "c1"], "全名"),
+               ("合約行還沒有 [audit:]", [_RC_UNAUDITED, "--add", "Projects/a_計劃#d12", "--case", "c1"], "[audit:]"),
+               ("--add 沒帶 --case", [_RC_CONTRACT, "--add", "Projects/a_計劃#d12"], "--case"))
+        for name, args, why in bad:
+            r = run(v, "guard", "residual", "Systems/S", *args)
+            check(f"S1 {name} → 回 2 且說明理由", r.returncode == 2 and why in r.stderr, f"rc={r.returncode} {r.stderr[-300:]}")
+            check(f"S1 {name} → 筆記沒動", s.read_text(encoding="utf-8") == before, "")
+        check("S1 不合格的都沒有產生索引", not (root / "governance" / "residual-index.json").exists(), "")
+        r = run(v, "guard", "residual", "Systems/S", _RC_CONTRACT, "--add", "Projects/a_計劃#d12", "--case", "c1")
+        txt = s.read_text(encoding="utf-8")
+        line = next(l for l in txt.splitlines() if _RC_CONTRACT in l)
+        check("S1 合格 → 回 0、標記加在那條合約行尾", r.returncode == 0 and line.endswith(f"[audit:{_RC_AUDIT}] [residual:Projects/a_計劃#d12]"),
+              f"rc={r.returncode} {r.stderr[-300:]}\n{line}")
+        check("S1 另一條合約沒被動到", f"{_RC_UNAUDITED} [test:test_rc_guard]\n" in txt, txt)
+        idx = _j.loads((root / "governance" / "residual-index.json").read_text(encoding="utf-8"))
+        ent = idx.get("entries") or []
+        check("S1 索引一筆:節點、殘留決策、about_code、測試所在的檔",
+              len(ent) == 1 and ent[0].get("node") == "Systems/S" and ent[0].get("residuals") == ["Projects/a_計劃#d12"]
+              and ent[0].get("about_code") == ["src/a.py"] and ent[0].get("test_files") == ["tests/test_a.py"] and ent[0].get("fp"),
+              repr(idx))
+        r2 = run(v, "guard", "residual", "Systems/S", _RC_CONTRACT, "--add", "Projects/a_計劃#d12", "--case", "c1")
+        txt2 = s.read_text(encoding="utf-8")
+        check("S1 同一個標記再寫 → 回 0、說已經有了、不重複加", r2.returncode == 0 and "已經有了" in r2.stdout and txt2.count("[residual:") == 1,
+              f"rc={r2.returncode} {r2.stdout[-200:]}")
+        r3 = run(v, "guard", "residual", "Systems/S", _RC_CONTRACT, "--remove", "Projects/a_計劃#d99")
+        check("S1 --remove 找不到那個標記 → 回 2", r3.returncode == 2 and s.read_text(encoding="utf-8") == txt2, r3.stderr[-200:])
+        r4 = run(v, "guard", "residual", "Systems/S", _RC_CONTRACT, "--remove", "Projects/a_計劃#d12")
+        idx2 = _j.loads((root / "governance" / "residual-index.json").read_text(encoding="utf-8"))
