+def _rc_ask(v, case, verdict="untestable", checker="sonnet/2026-10-14", substr=_RC_CONTRACT, reaudit=True):
+    """記一筆 residual-ask;reaudit(預設)時問答成功後照手冊順序重審那條合約(guard audit,戳記照舊是 _RC_AUDIT),
+    --add 才驗得過「最近一次 guard audit 事件晚於問答」(代碼審 r3 G5)。未審那條(_RC_UNAUDITED)不重審,它要維持沒有 [audit:]。
+    要測順序被擋的傳 reaudit=False。"""
+    r = run(v, "guard", "residual-ask", "Systems/S", substr, "--case", case, "--checker", checker, "--verdict", verdict)
+    if r.returncode == 0 and reaudit and substr != _RC_UNAUDITED:
+        model, date = _RC_AUDIT.split("/")
+        run(v, "guard", "audit", "Systems/S", substr, "--model", model, "--date", date, expect_rc=0)
+    return r
+
