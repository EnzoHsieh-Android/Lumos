+def t_pitfalls_tier_high_on_residual_index():
+    """[審查收斂規則 S6] 推送範圍改到殘留索引(起點或頂端版本)列的檔 → high;同一提交拿掉標記、改名也 high;沒有索引 → 分級照舊。"""
+    import json as _j, shutil as _sh
+    def tier(v, root):
+        r = run(v, "pitfalls", "--diff", "main..HEAD", "--no-lint", "--json", "--repo", str(root))
+        try:
+            return _j.loads(r.stdout)
+        except ValueError:
+            return {"tier": None, "tier_reason": r.stdout[-200:] + r.stderr[-200:]}
+    idx = {"version": 1, "entries": [{"node": "Systems/S", "fp": "x", "residuals": ["Projects/a_計劃#d12"],
+                                      "about_code": ["src/a.py"], "test_files": ["tests/test_a.py"]}]}
+    roots = []
+    try:
+        # 沒有索引:分級照舊(改程式檔、沒命中型樣 → standard,理由不提殘留)
+        root, v, g = _rc_repo("rc-s6-none"); roots.append(root)
