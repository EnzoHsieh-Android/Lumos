+def t_pitfalls_residual_test_file_whole():
+    """[r2 G1] 綁定測試所在的檔整檔算命中(拿掉上一輪「diff 碰到綁定測試名才算」的收窄):縮排在 class 裡的測試方法
+    (Kotlin、class 式 pytest)只改方法本體、或只改它呼叫的輔助函式,都要升 high;改索引外的檔照舊不升。
+    判準來源:r2 正確性、邊界、通才、資安四席實測——git 的 hunk 標頭只帶頂格的那一行(class 名),增刪行不含測試名,
+    收窄判成沒碰到;索引裡仍帶 tests 欄的舊索引也照整檔讀。"""
+    import json as _j
+    import shutil as _sh
+    kt = ("class FooTest {\n    @Test\n    fun guardWorks() {\n        assertEquals(1, check())\n    }\n\n"
+          "    private fun check(): Int {\n        return 1\n    }\n}\n")
+    py = ("def helper_assert(x):\n    assert x == 1\n\n\nclass TestFoo:\n    def test_guard(self):\n        helper_assert(1)\n")
+    idx = {"version": 1, "entries": [{"node": "Systems/S", "fp": "x", "residuals": ["Projects/a_計劃#d12"], "about_code": ["src/a.py"],
+                                      "test_files": ["tests/FooTest.kt", "tests/test_c.py"], "tests": ["guardWorks", "test_guard"]}]}
+    roots = []
+    def prep(tag, ix):
+        root, v, g = _rc_repo(tag, commit=False); roots.append(root)
+        (root / "tests" / "FooTest.kt").write_text(kt, encoding="utf-8")
+        (root / "tests" / "test_c.py").write_text(py, encoding="utf-8")
+        (root / "governance").mkdir()
+        (root / "governance" / "residual-index.json").write_text(_j.dumps(ix, ensure_ascii=False), encoding="utf-8")
+        g("add", "-A"); g("commit", "-qm", "init"); g("checkout", "-qb", "feat")
+        return root, v, g
+    try:
+        cases = (("Kotlin 只改縮排測試方法的本體", "tests/FooTest.kt", kt, "assertEquals(1, check())", "assertEquals(9, check())"),
+                 ("Kotlin 只改它呼叫的輔助函式", "tests/FooTest.kt", kt, "return 1", "return 2"),
+                 ("class 式 pytest 只改縮排測試方法的本體", "tests/test_c.py", py, "helper_assert(1)", "helper_assert(1) or True"),
+                 ("class 式 pytest 只改它呼叫的輔助函式", "tests/test_c.py", py, "assert x == 1", "assert True"))
+        for i, (name, rel, src, old, new_) in enumerate(cases):
