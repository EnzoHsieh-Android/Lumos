+def _rc_gov(root, gate="residual-ask"):
+    import json as _j
+    p = root / "docs" / ".governance-log.jsonl"
+    if not p.is_file():
+        return []
+    out = []
+    for ln in p.read_text(encoding="utf-8").splitlines():
+        try:
+            d = _j.loads(ln)
+        except ValueError:
+            continue
+        if isinstance(d, dict) and d.get("gate") == gate:
+            out.append(d)
+    return out
+
