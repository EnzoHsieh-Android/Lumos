-    殘留索引(_residual_tier_hits:改到殘留守的檔、拿掉殘留、頂端索引讀不出)→ high,最先判;命中風險型樣或新告警 → high;改動裡沒有任何「需要有家的程式檔」(_is_code_file,每支檔有家同一套定義)→ light;其餘 standard。
+    殘留索引與問答帳(_residual_tier_hits:改到殘留守的檔、拿掉或縮小殘留、索引或檔名清單讀不出、刪改 residual-ask 帳列)→ high,最先判;命中風險型樣或新告警 → high;改動裡沒有任何「需要有家的程式檔」(_is_code_file,每支檔有家同一套定義)→ light;其餘 standard。
     「計劃風險低且小改動閘過 → light」那一層要讀圖譜,由 spec-gate --push-check(本來就有圖譜、本來就在 pre-push 跑)印;這裡只用審查帳字串便宜提示一句。回 (tier, 一句為什麼)。"""
     res = _residual_tier_hits(repo_root, diff_range)
     why = []
     if res.get("files"):
         fs = res["files"]
         why.append("改到帶殘留合約守的程式(" + "、".join(fs[:3]) + (f" 等 {len(fs)} 支" if len(fs) > 3 else "") + ";那幾型壞法測試抓不到,要靠代碼審)")
     if res.get("removed"):
         rm = res["removed"]
         why.append("推送範圍裡拿掉殘留(" + "、".join(rm[:3]) + (f" 等 {len(rm)} 筆" if len(rm) > 3 else "") + ";拿掉殘留要過代碼審)")
+    if res.get("shrunk"):
+        sh = res["shrunk"]
+        why.append("推送範圍裡縮小殘留守的範圍(" + "、".join(sh[:3]) + (f" 等 {len(sh)} 筆" if len(sh) > 3 else "")
+                   + ";起點守的檔頂端沒列了,等於拿掉那部分殘留,先縮範圍、下次再改程式就躲得掉,所以這次就要過代碼審)")
     if res.get("head_bad"):
         why.append("頂端版本的殘留索引讀不出或形狀不對、起點有殘留(看不出這次碰了什麼,當成碰到;修好索引:lumos guard residual --reindex)")
+    if res.get("base_bad"):
+        why.append("起點版本的殘留索引讀不出(git show 失敗、不是檔案不存在:淺層 clone、物件遺失或逾時;看不出原本有什麼殘留,當成有)")
+    if res.get("files_unknown"):
+        why.append("列不出這次改了哪些檔(git diff --name-only 失敗)、索引裡有殘留(看不出有沒有改到它守的程式,當成改到)")
+    if res.get("asks_dropped"):
+        k = res["asks_dropped"]
+        why.append("推送範圍刪掉或改掉治理帳裡 residual-ask 的列" + (f" {k} 筆" if k > 0 else "(git 讀不出那段差異,當成有)")
+                   + "(刪掉判過 testable 的問答就能重問到想要的答案;第二個代理的問答只准增不准減)")
     if why:
         return "high", ";".join(why) + (";另命中風險型樣或新告警" if claims else "")
     if claims:
         return "high", "命中風險型樣或新告警"
     base = _range_base(repo_root, diff_range)
     code = [f for f in files if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS)) and _is_code_file(repo_root, f, base)]
     if not code:
         return "light", "改動裡沒有程式檔(只有文件/資料/圖譜)"
     return "standard", "有程式檔改動、沒命中風險型樣" + (";審查帳有全靠人驗的風險低留痕,跑 lumos spec-gate --push-check <範圍> 看是不是 light" if _ledger_has_manual_only(repo_root) else "")
 
 
