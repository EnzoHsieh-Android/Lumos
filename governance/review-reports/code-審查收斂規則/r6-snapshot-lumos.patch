+def _residual_ref_key(env, ref, cache=None):
+    """殘留指標的正規形:_pq_decision_target 解出的正式節點路徑(不帶 .md)+ #dN;解不出(找不到、撞名、格式不合)就回 NFC 原文。
+    「已經有了」、--remove 找標記、索引的 residuals 都比它——projects/A_計劃#d12 跟 Projects/a_計劃#d12 是同一筆。
+    跟決策引用的 _dref_norm 分工不同(那支走 env.resolve、撞名取第一篇):殘留指標撞名時回原文、不取第一篇(代碼審 r2 架構席)。"""
+    st, node, did = _pq_decision_target(env, "", ref, cache=cache)
+    if st is None and node:
+        return f"{node[:-3]}#{did}"
+    return nfc(str(ref).strip())
