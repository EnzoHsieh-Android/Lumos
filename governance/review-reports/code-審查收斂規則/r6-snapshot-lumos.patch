+def _residual_blob_at(repo_root, rev, rel, timeout=60, deadline=None):
+    """某個版本的一支檔 → ("ok", 原始位元組) / ("missing", None)(那個版本確定沒有這個路徑)/ ("unreadable", None)(git 讀不出:
+    版本不存在、物件遺失、逾時)。殘留索引與治理帳兩版比對共用這一支(代碼審 r4 G5 架構對齊席:原本一支用 git show、一支用 cat-file)。
+    讀法是 git show --no-textconv <版本>:<路徑>(全檔讀某版檔案的主流寫法 _lens_git binary=True;代碼審 r5 架構對齊席):檔案物件照原始位元組輸出,
+    不經 diff、不套 textconv 與 filter,.gitattributes 標 -diff、掛 textconv、帳裡的 NUL 位元組都影響不了(r3 G2);--no-textconv 明寫,不靠預設。
+    git show 失敗時再用 ls-tree 分辨:版本讀得到、樹裡確定沒有這個路徑才算 missing(r2 G5)——這支只多這一層分辨。
+    deadline(time.monotonic 的時刻,派工鏡頭用):每次 git 呼叫的上限夾進剩餘秒數,不足 1 秒當讀不出(r5 G4)。
+    replace refs 由主程式入口統一關掉(main 開頭的 GIT_NO_REPLACE_OBJECTS,r5 G5),這裡不另帶環境。"""
+    def left(cap):
+        return cap if deadline is None else min(cap, deadline - time.monotonic())
+    t = left(timeout)
+    r = _lens_git(repo_root, "show", "--no-textconv", f"{rev}:{rel}", binary=True, timeout=t) if t >= 1 else None
+    if r is not None and r.returncode == 0:
+        return "ok", r.stdout
+    t = left(20)
+    if r is None or t < 1:
+        return "unreadable", None
+    lt = _lens_git(repo_root, "ls-tree", "-z", rev, "--", rel, binary=True, timeout=t)
+    if lt is not None and lt.returncode == 0 and not lt.stdout.strip(b"\0"):
+        return "missing", None
+    return "unreadable", None
+
