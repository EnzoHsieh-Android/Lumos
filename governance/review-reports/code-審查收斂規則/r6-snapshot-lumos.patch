+def _residual_ask_rows_at(repo_root, rev, deadline=None):
+    """某個版本的版控治理帳裡 residual-ask 的列 → (狀態, Counter{整列去頭尾空白的位元組: 出現幾次})。狀態 "ok" / "missing"(那個版本確定沒有帳檔)/
