+def _residual_index_changes(bguard, hguard):
+    """起點與頂端兩版索引的殘留 → {"added", "reworded", "removed", "shrunk"} 裡有東西的那幾個(值是給人看的字串清單)。
+    同一篇、同一筆殘留一邊拿掉一條指紋、一邊加入一條新指紋的,一對一配成「合約句子改了」(r4 G5);其餘照舊是新增或拿掉。"""
+    def fmt(k):
+        return f"{k[0]} [residual:{k[2]}]"
+    added, gone = set(hguard) - set(bguard), set(bguard) - set(hguard)
+    pool = {}
+    for k in sorted(gone):
+        pool.setdefault((k[0], k[2]), []).append(k)
+    rew = []
+    for k in sorted(added):
+        olds = pool.get((k[0], k[2]))
+        if olds:
+            gone.discard(olds.pop(0))
+            rew.append(k)
+    added -= set(rew)
+    out = {}
+    for name, ks in (("added", added), ("reworded", rew), ("removed", gone)):
+        if ks:
+            out[name] = sorted(fmt(k) for k in ks)
+    shr = sorted(fmt(k) + " 少了 " + "、".join(sorted(bguard[k] - hguard[k])[:3])
+                 for k in set(bguard) & set(hguard) if bguard[k] - hguard[k])
+    if shr:
+        out["shrunk"] = shr
+    return out
