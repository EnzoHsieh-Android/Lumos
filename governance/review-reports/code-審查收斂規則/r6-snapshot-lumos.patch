+    多出來與少掉的先按(節點、指紋、殘留)配對,配得上的報哪幾欄不同;配不上的報「不在索引裡」或「對不到圖譜」。"""
+    from collections import Counter
+    miss, extra = list((Counter(want) - Counter(got)).elements()), list((Counter(got) - Counter(want)).elements())
+    out = []
+    names = ("residuals", "about_code", "test_files", "notes")
+    for w in sorted(miss):
+        pair = next((g for g in extra if g[:3] == w[:3]), None) or next((g for g in extra if g[:2] == w[:2]), None)
+        res = "、".join(w[2]) or "無"
+        if pair is None:
+            out.append(f"{_kill_esc(w[0])} 帶殘留的合約(指紋 {_kill_esc(w[1])}、殘留 {_kill_esc(res)})不在索引裡")
+            continue
+        extra.remove(pair)
+        diff = [n for n, a, b in zip(names, w[2:], pair[2:]) if a != b]
+        out.append(f"{_kill_esc(w[0])} 帶殘留的合約(指紋 {_kill_esc(w[1])}、殘留 {_kill_esc(res)})索引的 {'、'.join(diff)} 跟圖譜不同")
+    for g in sorted(extra):
+        out.append(f"索引裡的 {_kill_esc(g[0])}(指紋 {_kill_esc(g[1])}、殘留 {_kill_esc('、'.join(g[2]) or '無')})對不到圖譜裡任何帶 [residual:] 的合約行"
+                   "(或同一條合約在索引裡重複)")
+    return out
