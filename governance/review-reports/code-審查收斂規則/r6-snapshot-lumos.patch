+    含閘名字串、JSON 讀不出的那列當成是 residual-ask(帶著閘名,寧可多算);讀得出而 gate 是別的閘就不算。"""
+    import json as _j
+    from collections import Counter
+    try:
+        if rev is None:
+            p = Path(repo_root) / GOV_LOG_REL
+            if not os.path.lexists(p):
+                return "missing", Counter()
+            if p.is_symlink() or not p.is_file():
+                return "unreadable", Counter()
+            raw = p.read_bytes()
+        else:
+            st, raw = _residual_blob_at(repo_root, rev, GOV_LOG_REL, deadline=deadline)
+            if st != "ok":
+                return st, Counter()
+    except OSError:
+        return "unreadable", Counter()
+    rows = Counter()
+    for ln in raw.split(b"\n"):
+        if b"residual-ask" not in ln:
+            continue
+        ln = ln.strip()
+        try:
+            d = _j.loads(ln.decode("utf-8"))
+        except (UnicodeDecodeError, ValueError, RecursionError):
