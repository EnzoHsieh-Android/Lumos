+def cmd_guard_residual_ask(env, node, substr, case, checker, verdict):
+    """記第二個獨立代理對一條反例的判定(能不能在現有測試設施下穩定測到);同一條合約、同一個反例只准問一次是方便(〈做法〉2)。
