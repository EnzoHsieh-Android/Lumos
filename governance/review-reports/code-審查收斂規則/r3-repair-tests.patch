+def t_guard_residual_noop_keeps_index():
+    """[r2 G6] 「已經有了」「沒有這個標記」兩條沒事可做的路:索引跟重算結果相同就不碰檔案(打錯字的指令不在工作樹留改動);
+    不同才寫,寫了印「索引原本沒跟上,已補好」。判準來源:r2 併發、通才兩席。"""
+    import json as _j
+    import shutil as _sh
+    root, v, _g = _rc_repo("rc-r2g6")
+    ip = root / "governance" / "residual-index.json"
+    add = ("guard", "residual", "Systems/S", _RC_CONTRACT, "--add", "Projects/a_計劃#d12", "--case", "c1")
+    typo = ("guard", "residual", "Systems/S", _RC_CONTRACT, "--remove", "Projects/a_計劃#d99")
+    try:
+        r = run(v, *typo)
+        check("G6 沒有殘留、沒有索引時 --remove 打錯 → 回 2、不建索引檔", r.returncode == 2 and not ip.exists(), f"rc={r.returncode} exists={ip.exists()}")
+        check("★前置★ c1 判 untestable、--add 寫好索引", _rc_ask(v, "c1").returncode == 0 and run(v, *add).returncode == 0 and ip.is_file(), "")
+        st = lambda: (ip.stat().st_ino, ip.stat().st_mtime_ns, ip.read_bytes())
+        before = st()
+        for name, args, rc in (("已經有了", add, 0), ("沒有這個標記", typo, 2)):
+            r = run(v, *args)
+            check(f"G6 {name}、索引本來就對 → 回 {rc}、索引檔沒被碰、不說補好", r.returncode == rc and st() == before and "已補好" not in r.stdout + r.stderr,
+                  f"rc={r.returncode} {r.stdout[-200:]} {r.stderr[-200:]}")
+        for name, args, rc in (("已經有了", add, 0), ("沒有這個標記", typo, 2)):
+            ip.write_text(_j.dumps({"version": 1, "entries": []}), encoding="utf-8")
+            r = run(v, *args)
+            ents = _j.loads(ip.read_text(encoding="utf-8")).get("entries")
+            check(f"G6 {name}、索引沒跟上 → 回 {rc}、補好並說「索引原本沒跟上,已補好」", r.returncode == rc and len(ents) == 1
+                  and "索引原本沒跟上,已補好" in r.stdout + r.stderr, f"rc={r.returncode} {r.stdout[-200:]} {r.stderr[-200:]} {ents}")
+    finally:
+        _sh.rmtree(root, ignore_errors=True)
