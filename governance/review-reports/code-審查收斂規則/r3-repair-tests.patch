+def t_pitfalls_residual_git_failures():
+    """[r2 G5] git 出錯一律往多升 high 的方向:起點索引讀不出(物件遺失,不是路徑不存在)→ high;
+    檔名清單的 git diff 失敗而索引有殘留 → high;沒有任何殘留時檔名清單失敗照舊不升。判準來源:r2 併發席。"""
+    import json as _j
+    import shutil as _sh
+    import types as _ty
+    m = _load_lumos()
+    ent = {"node": "Systems/S", "fp": "x", "residuals": ["Projects/a_計劃#d12"], "about_code": ["src/a.py"], "test_files": []}
+    roots = []
+    real = m.subprocess
+    try:
+        root, v, g = _rc_with_index("rc-r2g5-base", {"version": 1, "entries": [ent]}, roots)
+        (root / "governance" / "residual-index.json").write_text(_j.dumps({"version": 1, "entries": [ent]}, indent=2), encoding="utf-8")
+        (root / "src" / "b.py").write_text("def b():\n    return 5\n", encoding="utf-8"); g("commit", "-qam", "x")
+        blob = g("rev-parse", "main:governance/residual-index.json").stdout.strip()
+        obj = root / ".git" / "objects" / blob[:2] / blob[2:]
+        check("★前置★ 起點索引是鬆散物件", obj.is_file(), str(obj))
+        obj.unlink()
+        check("★前置★ git show 讀不出、ls-tree 還列得到(不是路徑不存在)",
+              g("show", "main:governance/residual-index.json").returncode != 0 and "residual-index.json" in g("ls-tree", "main", "--", "governance/residual-index.json").stdout, "")
+        res = m._residual_tier_hits(root, "main..HEAD")
+        check("G5 起點索引讀不出 → 記成讀不出", res.get("base_bad") is True, repr(res))
+        tier, why = m._pitfall_tier([], ["src/b.py"], root, "main..HEAD")
+        check("G5 起點索引讀不出 → high、理由說起點版本的索引讀不出", tier == "high" and "起點版本的殘留索引讀不出" in why, f"{tier} {why}")
+        root, _v, g = _rc_repo("rc-r2g5-new"); roots.append(root)
+        g("checkout", "-qb", "feat"); (root / "governance").mkdir()
+        (root / "governance" / "residual-index.json").write_text(_j.dumps({"version": 1, "entries": [ent]}), encoding="utf-8")
+        g("add", "-A"); g("commit", "-qm", "index")
+        check("G5 起點沒有索引檔(路徑不存在)→ 不算讀不出", "base_bad" not in m._residual_tier_hits(root, "main..HEAD"), "")
+
+        def fake(args, *a, **kw):
+            if "--name-only" in args:
+                return real.CompletedProcess(args, 128, "", "fatal: 模擬失敗")
+            return real.run(args, *a, **kw)
+        root, _v, g = _rc_with_index("rc-r2g5-names", {"version": 1, "entries": [ent]}, roots)
+        (root / "src" / "b.py").write_text("def b():\n    return 5\n", encoding="utf-8"); g("commit", "-qam", "x")
+        root0, _v0, g0 = _rc_repo("rc-r2g5-none"); roots.append(root0)
+        g0("checkout", "-qb", "feat"); (root0 / "src" / "b.py").write_text("x = 1\n", encoding="utf-8"); g0("commit", "-qam", "x")
+        m.subprocess = _ty.SimpleNamespace(run=fake, TimeoutExpired=real.TimeoutExpired, CompletedProcess=real.CompletedProcess, PIPE=real.PIPE)
+        try:
+            res = m._residual_tier_hits(root, "main..HEAD")
+            tier, why = m._pitfall_tier([], ["src/b.py"], root, "main..HEAD")
+            res0 = m._residual_tier_hits(root0, "main..HEAD")
+        finally:
+            m.subprocess = real
+        check("G5 檔名清單失敗、索引有殘留 → 記成判不出改了哪些檔", res.get("files_unknown") is True, repr(res))
+        check("G5 檔名清單失敗、索引有殘留 → high、理由說列不出改了哪些檔", tier == "high" and "列不出這次改了哪些檔" in why, f"{tier} {why}")
+        check("G5 沒有任何殘留時檔名清單失敗 → 不升(跟沒有殘留機制時一樣)", res0 == {}, repr(res0))
+    finally:
+        m.subprocess = real
+        for r_ in roots:
+            _sh.rmtree(r_, ignore_errors=True)
