+def _strip_test_comments(txt, strip):
+    """測試檔內容去註解(語言感知):discover_test_methods 與殘留索引找測試所在的檔共用這一份(代碼審 r1 G3)。
+    c-style 剝 // 與 /*..*/;c-style+strings 再清空單行字串字面;python 走 "none" 不剝(理由見 discover_test_methods)。"""
+    if strip in ("c-style", "c-style+strings"):
+        txt = re.sub(r"//[^\n]*", "", txt)
+        txt = re.sub(r"/\*.*?\*/", "", txt, flags=re.S)
+    if strip == "c-style+strings":
+        txt = re.sub(r'"(?:\\.|[^"\\\n])*"', '""', txt)
+        txt = re.sub(r"'(?:\\.|[^'\\\n])*'", "''", txt)
+    return txt
+
