+def _residual_check(env, rel, body, ref, cases=None, asks=None, ask_err=None, cache=None):
+    """一個 [residual:] 標記合不合格 → 問題清單(空 = 合格)。--add(寫入當下,帶 cases)、--reindex 與 doctor(事後,不帶)共用(代碼審 r1 G3)。
+    都驗:合約行有 [audit:];決策指標是全名、狀態 ok;決策內容非空。問答比「這條合約」(節點 + 指紋)與反例正規形:
+    帶 cases → 每個反例都要有判 untestable 的問答、沒有同反例判 testable 的、決策內容有那一筆的 checker:;
+    不帶 → 至少一個反例只有判 untestable 的問答、沒有任何反例同時判過 testable、決策內容有其中一筆的 checker:。
+    asks/ask_err:呼叫端先讀好的治理帳(_residual_ask_index),逐條查時不重讀整本帳。"""
+    probs = []
+    if not invariant_audit_refs(body):
+        probs.append("這條合約行還沒有 [audit:]——殘留是審計的產物,先審計(lumos guard audit)再記殘留")
+    why = _residual_ref_problem(env, rel, ref, cache=cache)
+    if why:
+        return probs + [why]
+    d = _residual_decision(env, ref) or {}
+    content = str(d.get("content") or "").strip()
+    if not content or content in ('""', "''"):
+        return probs + [f"決策 {_esc_clean(ref, 80)} 的內容是空的;殘留決策要逐型列出殘留、標殺不掉或繞過設計、反例編號與 checker:<模型>/<日期>"]
+    if cases is not None and not cases:
+        return probs + ["--add 要帶 --case <反例編號>…(每個都要先有一筆判 untestable 的 lumos guard residual-ask)"]
+    if asks is None:
+        asks, ask_err = _residual_ask_index(_vault_repo_root(env))
+    if ask_err:
+        return probs + [f"{ask_err};查不到第二個代理的問答"]
+    by = {}
+    for x in asks.get((nfc(rel[:-3]), _residual_claim_fp(body)), []):
+        by.setdefault(_residual_case_key(x.get("case")), []).append(x)
+    verdicts = lambda k: {str(x.get("verdict")) for x in by.get(k, [])}
+    checkers = lambda k: [f"checker:{x.get('checker')}" for x in by.get(k, []) if x.get("verdict") == "untestable"]
+    if cases:
+        for c in cases:
+            k = _residual_case_key(c)
+            if not by.get(k):
+                probs.append(f"反例 {_esc_clean(c, 40)} 在治理帳裡沒有 residual-ask(這條合約的);先派第二個獨立代理問、用 lumos guard residual-ask 記下")
+            elif "testable" in verdicts(k):
+                probs.append(f"反例 {_esc_clean(c, 40)} 第二個代理判的是 testable(測得到):照它說的補測試,不能記殘留")
+            elif not any(n in content for n in checkers(k)):
+                probs.append(f"決策 {_esc_clean(ref, 80)} 的內容裡沒有 {_esc_clean(checkers(k)[0], 80)}(反例 {_esc_clean(c, 40)} 那一筆問答的第二個代理);寫在決策內容尾端")
+        return probs
+    for k in sorted(k for k in by if "testable" in verdicts(k)):
+        if "untestable" in verdicts(k):
+            probs.append(f"反例 {_esc_clean(k, 40)} 同時有判 testable 與 untestable 的 residual-ask(同一個反例只准問一次;測得到就該補測試)")
+    ok = [k for k in by if verdicts(k) == {"untestable"}]
+    if not ok:
+        probs.append("治理帳裡沒有這條合約判 untestable 的 residual-ask(標記沒經過第二個代理;合約宣稱改過字也要重問)")
+    elif "checker:" not in content:
+        probs.append(f"決策 {_esc_clean(ref, 80)} 的內容沒有 checker:<模型>/<日期>(第二個代理是誰)")
+    elif not any(n in content for k in ok for n in checkers(k)):
+        probs.append(f"決策 {_esc_clean(ref, 80)} 的 checker: 跟判 untestable 那幾筆問答的第二個代理都對不上")
+    return probs
