+def _residual_decision(env, ref):
+    """帶資料夾全名的 <節點>#dN → 那筆決策 dict(找不到、撞名 None)。節點解析就是 _pq_decision_target(代碼審 r1 G9:不另寫一份)。"""
+    st, node, did = _pq_decision_target(env, "", ref)
