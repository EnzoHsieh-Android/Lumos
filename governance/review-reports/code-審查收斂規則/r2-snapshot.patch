+def _residual_ref_problem(env, rel, ref, cache=None):
+    """殘留決策指標寫入/記帳前的格式與狀態檢查 → 給人看的原因或 None。只收帶資料夾的全名(短名日後可能撞名),不帶 .md。"""
+    pr = _dref_parse(ref)
+    if not pr or "/" not in pr[0] or "[[" in ref:
+        return f"決策指標 {_esc_clean(ref, 80)} 要寫帶資料夾的全名 <資料夾>/<節點>#dN(例 Projects/a_計劃#d12),不收短名"
+    if pr[0].lower().endswith(".md"):
+        return f"決策指標 {_esc_clean(ref, 80)} 的節點不帶 .md(寫成 {_esc_clean(pr[0][:-3], 60)}#{pr[1]})"
+    st = _pq_decision_state(env, rel, ref, cache=cache)
+    if st == "missing":
+        return f"決策 {_esc_clean(ref, 80)} 找不到(節點不在或沒有這個編號)"
+    if st == "superseded":
+        return f"決策 {_esc_clean(ref, 80)} 已被翻案(valid:false),殘留要指到現行的決策"
+    if st != "ok":
+        return f"決策指標 {_esc_clean(ref, 80)} 解析不明(格式不合或名稱撞名)"
+    return None
