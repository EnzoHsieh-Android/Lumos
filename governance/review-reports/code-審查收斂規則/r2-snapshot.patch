+def _residual_index_entries(env):
+    """圖譜裡每條帶 [residual:] 的合約 → 索引一筆(node、fp、residuals(正規形)、about_code、test_files、tests),依節點與指紋排序。
+    tests = 綁定測試名:pitfalls 只在 diff 真的碰到這些測試時才把 test_files 算成命中(代碼審 r1 G8)。"""
+    rows, cache = [], {}
+    for rel, n in sorted(env.notes.items()):
+        invs, _ = extract_contracts(n)
+        for body in invs:
+            refs = invariant_residual_refs(body)
+            if not refs:
+                continue
+            ac = sorted({_posix_norm(strip_quotes(str(x).strip())) for x in as_list(n.fields.get("about_code")) if str(x).strip()})
+            rows.append((body, {"node": rel[:-3], "fp": _residual_claim_fp(body),
+                                "residuals": sorted({_residual_ref_key(env, r, cache=cache) for r in refs}), "about_code": ac}))
+    if rows:
+        tf = _residual_test_files(_vault_repo_root(env), [b for b, _e in rows])
+        for b, e in rows:
+            got = tf.get(b) or {}
+            e["test_files"], e["tests"] = got.get("files", []), got.get("tests", [])
+    return sorted((e for _b, e in rows), key=lambda e: (e["node"], e["fp"]))
