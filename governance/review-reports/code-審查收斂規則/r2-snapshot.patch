+def _residual_test_files(repo_root, inv_bodies):
+    """合約行綁的測試名 → {合約內文: {"files": 測試所在的檔(repo 相對路徑,排序去重), "tests": 綁定的測試名}}。
+    走 _walk_test_files(同一份測試檔篩選)、先剝註解(_strip_test_comments,跟 discover_test_methods 同一套)再比對 profile 的方法正規式;
+    設定讀不到、測試根在 repo 外或找不到 → 那一支不列(索引只是讓分級多升 high,少列只少升,不會誤放行既有分級)。"""
+    try:
+        pdata = load_platforms(repo_root)
+    except Exception:
+        return {}
+    split = pdata["platforms"] if pdata["multiplatform"] else {}
+    cache, out = {}, {}
+    rr = Path(repo_root).resolve()
+    for body in inv_bodies:
+        try:
+            resolved = resolve_test_refs(body, split, pdata["default_platform"])
+        except ValueError:
+            resolved = []
+        files, names = set(), set()
+        for plat, name in resolved:
+            p = pdata["platforms"].get(plat)
+            if not p:
+                continue
+            if plat not in cache:
+                where = {}
+                strip = p["profile"].get("comment_strip", "c-style")
+                for fpath, txt in _walk_test_files(p["root"], p["profile"], with_path=True):
+                    for m in p["profile"]["method_re"].finditer(_strip_test_comments(txt, strip)):
+                        where.setdefault(m.group(1).strip("`"), set()).add(fpath)
+                cache[plat] = where
+            for fpath in cache[plat].get(name, ()):
+                try:
+                    files.add(Path(fpath).resolve().relative_to(rr).as_posix())
+                    names.add(name)
+                except ValueError:
+                    pass
+        out[body] = {"files": sorted(files), "tests": sorted(names)}
+    return out
+
