     # ③判定途中出錯:不擋、記一筆沒判
     root = _dr_repo()
     base = _rt_push(root, [rule], msg="rule")
     tip = _rt_push(root, [rule], files=("src/new.py",), msg="add file")
     orig = m._drift_probe_check
 
     def judge_boom(*a, **k):
         if k.get("kind") == "retire":
             raise RuntimeError("x")
         return orig(*a, **k)
