+def _tg_fn_cands(path, k, f, prev, kt):
+    """一支新增或本體有變的測試函式 → 候選:沒斷言、catch 沒 fail、新加 expected=、斷言變弱、預期值被改、逾時調大。
+    prev 是改動前那一支(新寫的、或找不到的是 None);本體與註記都沒變的不判。"""
+    if prev is not None and prev["sig"] == f["sig"] and prev["annot"] == f["annot"]:
+        return []
+    out = []
+    if not _tg_has_assertion(f):
+        out.append(_tg_cand("tq/no-assertion", path, f["start"], k))
+    if _tg_catch_no_fail(f):
+        out.append(_tg_cand("tq/catch-no-fail", path, f["start"], k))
+    if prev is None:
+        return out
+    if _TG_EXPECTED_ANN.search(f["annot"]) and not _TG_EXPECTED_ANN.search(prev["annot"]):
+        out.append(_tg_cand("tq/skip-added", path, f["start"], k + "\x00expected="))
+    so, sn = _tg_statements(prev), _tg_statements(f)
+    co, cn = sum(_tg_const_stmt(x, kt) for x in so), sum(_tg_const_stmt(x, kt) for x in sn)
+    if len(sn) < len(so) or _tg_strong(sn) < _tg_strong(so) or cn > co:
+        out.append(_tg_cand("tq/assert-weakened", path, f["start"],
+                            f"{k}\x00{len(so)}/{_tg_strong(so)}/{co}->{len(sn)}/{_tg_strong(sn)}/{cn}",
+                            extra=f"斷言 {len(so)}→{len(sn)},相等比對 {_tg_strong(so)}→{_tg_strong(sn)},實際值是常值的 {co}→{cn}"))
+    seen = {}
+    for a, c in _tg_pairs(so, sn, kt):
+        if _tg_expected_changed(a, c, kt):
+            seen[c] = seen.get(c, 0) + 1          # 同一條改動出現第二次,指紋不同(放行一條不會順帶放掉另一條)
+            out.append(_tg_cand("tq/expected-changed", path, f["start"], f"{k}\x00{c}", seen[c]))
+    ol = [_tg_norm(x) for x in (prev["annot"] + "\n" + prev["raw"]).split("\n")]
+    nl = [_tg_norm(x) for x in (f["annot"] + "\n" + f["raw"]).split("\n")]
+    out += [_tg_cand("tq/timeout-raised", path, f["start"], f"{k}\x00{line}") for line in _tg_timeout_raised(ol, nl)]
+    return out
+
