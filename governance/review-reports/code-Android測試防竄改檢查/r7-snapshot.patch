+def _tqg_ignore(root, commit, n=1):
+    """在測試檔替前 n 支測試加 @Ignore 並提交 → 新提交。"""
+    names = "ab"[:n]
+    body = [("    @Ignore\n" if x in names else "") + f"    @Test\n    fun {x}() {{ assertEquals({i + 1}, f()) }}\n" for i, x in enumerate("ab")]
+    return commit({_TQG_T: _tqg_kt(*body)})
