+def _tg_cand(rule, file, line, ident, nth=1, side="head", extra=""):
+    """一條候選。檔名與原因裡的外來字串(檔名、測試名、正式程式的那一行)印出前清控制字元(換行、ESC、雙向覆寫),
+    擋下訊息是給 AI 讀的,不讓外來文字偽造出「接下來」這類段落;指紋用清過的檔名(只有怪檔名才會不同)。"""
+    import hashlib
+    why, verify = _TG_WHY[rule]
+    file = _out_clean(file, 500)
+    key = hashlib.sha256("\x00".join([rule, file, ident, str(nth)]).encode("utf-8", "replace")).hexdigest()[:16]
+    return {"rule": rule, "file": file, "line": line, "side": side, "key": key, "ident": ident,
+            "message": why + (f"({_out_clean(extra, 300)})" if extra else ""), "verify": verify}
+
+
+def _tg_changes(root, base, head, deadline=None):
+    """改了哪些檔(含刪除與改名)→ [(狀態, 改動前路徑, 改動後路徑, 改動後物件編號, 檔名是不是合法 UTF-8)];git 失敗回 None。
+    --raw 帶物件編號(基準圖指紋綁它);輸出照位元組讀,檔名不是 UTF-8 的照實標出來,不讓替換字元把它變成讀不到的空檔。"""
+    r = _lens_git_dl(root, "diff", "--raw", "-z", "-M", "--no-abbrev", "--no-ext-diff", "--no-textconv", base, head,
+                     deadline=deadline, binary=True)
+    if r is None or r.returncode != 0:
+        return None
+    parts = r.stdout.split(b"\0")
+    out, i = [], 0
+    while i < len(parts) and parts[i].startswith(b":"):
+        meta = parts[i].decode("ascii", "replace").split()
+        st, new_sha = meta[4][:1], meta[3]
+        n_paths = 2 if st in "RC" else 1
+        paths, good = [], True
+        for rp in parts[i + 1:i + 1 + n_paths]:
+            try:
+                paths.append(rp.decode("utf-8"))
+            except UnicodeDecodeError:
+                paths.append(rp.decode("utf-8", "replace"))
+                good = False
+        if n_paths == 2:
+            old, new = paths
+        else:
+            old, new = (None if st == "A" else paths[0]), (None if st == "D" else paths[0])
+        out.append((st, old, new, None if st == "D" else new_sha, good))
+        i += 1 + n_paths
+    return out
+
+
+def _tg_read(root, base, head, items, deadline=None):
+    """[(改動前路徑, 改動後路徑)] → {(side, path): 文字 | 'TOOLARGE' | 'UNREADABLE'}(那一端沒有就不在表裡)。
+    批次讀(_nodehome_cat_blobs_capped:先問大小再讀內容),單檔上限、總量上限都在這一層;不是 UTF-8 的內容照換字元讀。
+    批次讀取本身失敗回 None。測試檔的單行上限在 _tg_analyze(要知道檔類,只套測試檔)。"""
+    specs, slots = [], []
+    for old, new in items:
+        for side, rev, path in (("base", base, old), ("head", head, new)):
+            if path and rev != _EMPTY_TREE_SHA:
+                specs.append(f"{rev}:{path}")
+                slots.append((side, path))
+    res = {}
+    if not specs:
+        return res
+    sizes = _nodehome_cat_sizes(root, specs, max(1, int(_git_timeout(deadline, cap=60))))
+    blobs = None
+    if sizes is not None:
+        blobs = _nodehome_cat_blobs_capped(root, specs, _TG_MAX_BYTES, deadline=deadline, sizes=sizes, max_total_bytes=_TG_MAX_TOTAL)
+    if sizes is None or blobs is None:
+        return None                 # 批次讀取本身失敗(逾時或 git 跑不動):整次比對沒跑完,由呼叫端記成錯誤
+    for i, slot in enumerate(slots):
+        if sizes[i] is None:
+            res[slot] = "UNREADABLE"
+        elif sizes[i] > _TG_MAX_BYTES or blobs[i] is None:
+            res[slot] = "TOOLARGE"
+        else:
+            t = blobs[i].decode("utf-8", "replace")
+            res[slot] = "TOOLARGE" if t.count("\n") >= _TG_MAX_LINES else t
+    return res
+
+
+def _tg_start(root, base, head, deadline=None):
+    """比對的起點:跟主線的分岔點(_lens_default_base,Room 守衛手動跑用的同一支)找得到、而且不是終點本身就用它——
+    合過主線之後推送,主線的改動不會算到推送者頭上;同一條分支先前推送已經處理過的候選,不是改掉就是已在放行檔,不會重複擋。
+    找不到(沒有主線、推的就是主線)照給的起點。"""
+    # 遠端主線優先:本機 main 上還沒推出去的提交不能當成已在主線(回頭重讀的分岔點也是同一個理由不收本機主線);沒有遠端主線才用本機的
+    fork = _lens_default_base(root, tip=head, include_local=False, deadline=deadline) \
+        or _lens_default_base(root, tip=head, include_local=True, deadline=deadline)
+    if fork and fork != _lens_full_sha(root, head):
+        return fork
+    return base
+
+
+def _tg_analyze(root, base, head, deadline=None):
+    """一段範圍的作弊候選 → (候選清單, 錯誤訊息或 None)。git 算不出改動清單回 (None, 訊息);超過截止時間丟 TimeoutError(呼叫端記成沒跑完)。"""
+    ch = _tg_changes(root, base, head, deadline)
+    if ch is None:
+        return None, "git 算不出這次改了哪些檔"
+    cands, rows, images = _tg_sort_changes(ch)
+    text = _tg_read(root, base, head, [(o, n) for _k, o, n, _s in rows], deadline)
+    if text is None:
+        return None, "git 讀不出改動的內容(逾時或 git 跑不動)"
+    test_files, base_hits, head_hits = [], {}, {}
+    for kind, old, new, new_sha in rows:
+        if deadline is not None and _git_timeout(deadline) <= 0:
+            raise TimeoutError("比對工具超過截止時間")
+        path = new or old
+        b = text.get(("base", old), "") if old else ""
+        h = text.get(("head", new), "") if new else ""
+        if "TOOLARGE" in (b, h) or "UNREADABLE" in (b, h):
+            cands.append(_tg_cand("tq/too-large", path, 0, f"{path}:{new_sha or 'deleted'}",
+                                  extra=f"整支檔超過 {_TG_MAX_BYTES // 1_000_000} MB 或 {_TG_MAX_LINES} 行的上限,這支整支沒比對")
+                         if "TOOLARGE" in (b, h)
+                         else _tg_cand("tq/unreadable", path, 0, path))
+        elif kind == "test":
+            if _tg_has_long_line(b) or _tg_has_long_line(h):
+                # 超長的行(壓縮資料、產生的程式、病態輸入)抹成空行再比:同檔其他改動照樣逐條列,那幾行要人另外看
+                cands.append(_tg_cand("tq/too-large", path, 0, f"{path}:{new_sha or 'deleted'}:line",
+                                      extra=f"有一行超過 {_TG_MAX_LINE_CHARS} 字,那幾行沒比對,其餘照比"))
+                b, h = _tg_blank_long_lines(b), _tg_blank_long_lines(h)
+            cands += _tg_test_file(test_files, base_hits, head_hits, old, new, new_sha, b, h)
+        else:
+            cands += _tg_main_cands(path, b, h)
+    cands += _tg_test_rules(test_files, base_hits, head_hits, deadline)
+    return cands + _tg_image_cands(images), None
+
+
+def _tg_has_long_line(text):
+    """測試檔有沒有一行超過 _TG_MAX_LINE_CHARS 字(行尾的 \r 不算)。只測試檔要:函式切法與斷言判讀在單行上有平方級的風險,
+    正式程式檔的判讀是逐行一條正規式,不設這道上限。"""
+    return any(len(x) - x.endswith("\r") > _TG_MAX_LINE_CHARS for x in text.split("\n"))
+
+
+def _tg_blank_long_lines(text):
+    """超過 _TG_MAX_LINE_CHARS 字的行換成空行(換行照留、行號不變)。"""
+    return "\n".join("" if len(x) - x.endswith("\r") > _TG_MAX_LINE_CHARS else x for x in text.split("\n"))
+
+
+def _tg_sort_changes(ch):
+    """改動清單 → (直接成候選的怪檔名, 要讀內容比的 [(種類, 改動前路徑, 改動後路徑, 物件編號)], 按目錄分的基準圖)。"""
+    cands, rows, images = [], [], {}
+    for st, old, new, new_sha, good in ch:
+        kind = _tg_kinds(old, new)
+        if kind is None:
+            continue
+        path = new or old
+        if not good or "\n" in path or (old and "\n" in old):
+            cands.append(_tg_cand("tq/unreadable", path, 0, path))
+        elif kind == "image":
+            d = path.rsplit("/", 1)[0] if "/" in path else "."
+            images.setdefault(d, []).append(f"{st}:{old}:{new}:{new_sha}")
+        else:
+            rows.append((kind, old, new, new_sha))
+    return cands, rows, images
+
+
+def _tg_test_file(test_files, base_hits, head_hits, old, new, new_sha, b, h):
+    """一支測試檔:切出兩端的測試函式、累計跳過與門檻字樣的次數(收進 test_files 與兩張次數表,規則在 _tg_test_rules 一起判)
+    → 這支檔直接成的候選(配不平時的 tq/unparsable)。整支刪掉或改名成非測試檔時,候選記在原本那支測試檔。"""
+    path = new if (new and _tg_kind(new) == "test") else old
+    fb, okb = _tg_functions(b, (old or "").endswith(".java")) if (old and _tg_kind(old) == "test") else ({}, True)
+    fh, okh = _tg_functions(h, (new or "").endswith(".java")) if (new and _tg_kind(new) == "test") else ({}, True)
+    if not (okb and okh):
+        return [_tg_cand("tq/unparsable", path, 0, f"{path}:{new_sha or 'deleted'}")]
+    kt = bool(_TG_MSG_LAST_RE.search(h + "\n" + b))   # 斷言訊息在最後(kotlin.test、JUnit 5)
+    test_files.append((path, b, h, fb, fh, kt))
+    same = new if (old and new and _tg_kind(new) == "test") else None   # 改名或搬家:兩邊用新路徑,類別層級的註記不因換路徑算新增
+    for src, dst in ((_tg_test_hits(b, fb, same or old or path), base_hits), (_tg_test_hits(h, fh, same or new or path), head_hits)):
+        for ident, locs in src.items():
+            dst.setdefault(ident, []).extend(locs)
+    return []
+
+
+def _tg_main_cands(path, b, h):
+    """一支正式程式檔的候選:新增偵測測試環境的字樣。"""
+    return [_tg_cand(rule, path, ln, line, nth) for (rule, _o, line), nth, ln in _tg_diff_locs(_tg_main_hits(b), _tg_main_hits(h))]
+
+
+def _tg_image_cands(images):
+    """按目錄分的基準圖 → 每個目錄一條 tq/snapshot-changed(指紋綁那批圖的路徑與物件編號)。"""
+    import hashlib
+    out = []
+    for d, items in sorted(images.items()):
+        sig = hashlib.sha256("\n".join(sorted(items)).encode("utf-8", "replace")).hexdigest()[:16]
+        out.append(_tg_cand("tq/snapshot-changed", d, 0, d + ":" + sig, extra=f"{len(items)} 張基準圖"))
+    return out
+
+
+def _tg_test_rules(test_files, base_hits, head_hits, deadline=None):
+    """測試檔那幾條規則一起判(刪測試、加跳過、斷言變弱、預期值被改…);每支函式判之前看一次截止時間,超過丟 TimeoutError。"""
+    renamed, moved_from = _tg_renames(test_files)
+    fns_base = {(p, k): f for p, _b, _h, fb, _fh, _kt in test_files for k, f in fb.items()}
+    out = _tg_hit_cands(test_files, base_hits, head_hits)
+    for path, _b, _h, fb, fh, kt in test_files:
+        gone = sorted(k for k in fb if k not in fh and (path, k) not in renamed)
+        if gone:
+            out.append(_tg_cand("tq/test-removed", path, fb[gone[0]]["start"], ",".join(gone), side="base",
+                                extra="、".join(gone[:5]) + (f" 等 {len(gone)} 支" if len(gone) > 5 else "")))
+        for k, f in fh.items():
+            if deadline is not None and _git_timeout(deadline) <= 0:
+                raise TimeoutError("比對工具超過截止時間")
+            prev = fb.get(k) if k in fb else fns_base.get(moved_from.get((path, k)))
+            out += _tg_fn_cands(path, k, f, prev, kt)
+    return out
+
+
+def _tg_renames(test_files):
+    """本體簽名一樣、一邊不見一邊新出現的測試函式一對一配成改名或搬家 → (被認成改名的 {(檔, 函式鍵)}, {新(檔, 鍵): 舊(檔, 鍵)})。
+    兩支一樣的刪掉、只加回一支,另一支照樣算刪除。"""
+    gone_by_sig, came_by_sig = {}, {}
+    for path, _b, _h, fb, fh, _kt in test_files:
+        for k, f in fb.items():
+            if k not in fh and f["sig"]:
+                gone_by_sig.setdefault(f["sig"], []).append((path, k))
+        for k, f in fh.items():
+            if k not in fb and f["sig"]:
+                came_by_sig.setdefault(f["sig"], []).append((path, k))
+    renamed, moved_from = set(), {}
+    for sig, gone in gone_by_sig.items():
+        for g, c in zip(gone, came_by_sig.get(sig, [])):
+            renamed.add(g)
+            moved_from[c] = g
+    return renamed, moved_from
+
+
+def _tg_hit_cands(test_files, base_hits, head_hits):
+    """跳過標記與比對門檻字樣比改動前多出來的 → 候選,記在多出來的那一處:同一個身分在各支檔的出現次數跟改動前比,
+    多出來的那支檔優先(搬檔的不算),再取那支檔裡排後面的那幾處。"""
+    out = []
+    for ident, locs in head_hits.items():
+        before = base_hits.get(ident, [])
+        extra = len(locs) - len(before)
+        if extra <= 0:
+            continue
+        left = {}
+        for p, _ln in before:
+            left[p] = left.get(p, 0) + 1
+        fresh = []
+        for p, ln in locs:
+            if left.get(p, 0) > 0:
+                left[p] -= 1
+            else:
+                fresh.append((p, ln))
+        fresh_set = set(fresh)
+        picks = (fresh + [x for x in reversed(locs) if x not in fresh_set])[:extra]
+        rule, owner, kind = ident
+        for k, (p, ln) in enumerate(picks):
+            out.append(_tg_cand(rule, p, ln, f"{owner}\x00{kind}", len(before) + k + 1))
+    return out
+
