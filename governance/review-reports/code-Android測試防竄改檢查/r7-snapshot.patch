+_TG_LIT = re.compile(r'"(?:[^"\\\n]|\\.)*+"|\'(?:[^\'\\\n]|\\.)\'')   # 佔有式:長字串常值不回溯(同 _C_STRIP_PAT)
+_TG_FIRST_ARG = ("assertEquals", "assertNotEquals", "assertArrayEquals", "assertContentEquals", "assertSame")
+_TG_FLIP = {"assertTrue": "assertFalse", "assertFalse": "assertTrue", "assertNull": "assertNotNull", "assertNotNull": "assertNull"}
+# Truth / AssertJ 串接的方向互換:assertThat(x).isTrue() 改 isFalse() 跟 assertTrue 改 assertFalse 同一種
+_TG_CHAIN_FLIP = {"isTrue": "isFalse", "isFalse": "isTrue", "isEmpty": "isNotEmpty", "isNotEmpty": "isEmpty",
+                  "isNull": "isNotNull", "isNotNull": "isNull"}
+# 斷言的訊息在最後(kotlin.test、JUnit 5 的 Assertions):三個參數時第三個是字串就是訊息、不是字串就是容差
+_TG_MSG_LAST_RE = re.compile(r"^\s*import\s+(?:static\s+)?(?:kotlin\.test\.(?:\*|assert)|org\.junit\.jupiter\.api\.Assertions\b)", re.M)
+
+
+def _tg_call_parts(stmt):
+    """敘述 → (呼叫名, [參數…], [(鏈上名稱, [參數…])…])。參數切法不把 < > 當括號(比較運算與 lambda 箭頭)。"""
+    m = re.match(r"\.?([\w.]+?)\s*(?:<[^>()]*>)?\s*\(", stmt)
+    if not m:
+        return None, [], []
+    name = m.group(1).rsplit(".", 1)[-1]
+    br = _rg_bracket_map(_tg_strip(stmt))
+    close = br.get(m.end() - 1, len(stmt))
+    args = _rg_split_args(stmt[m.end():close], angle=False)
+    chain, k = [], close + 1
+    while True:
+        mm = re.compile(r"\s*\.\s*(\w+)\s*\(").match(stmt, k)
+        if not mm or mm.end() - 1 not in br:
+            break
+        en = br[mm.end() - 1]
+        chain.append((mm.group(1), _rg_split_args(stmt[mm.end():en], angle=False)))
+        k = en + 1
+    return name, args, chain
+
+
+def _tg_split_expected(stmt, kotlin_test=False):
+    """敘述 → (預期值那部分, 其餘部分的簽名, 實際值清單);判不出預期值位置回 None。
+    JUnit:三個參數第一個是字串常值 → 訊息在前;kotlin.test(檔案匯入 kotlin.test 的斷言):訊息在最後、容差在第三個。"""
+    if re.search(r"\bshouldBe\b", stmt):
+        a, b = re.split(r"\bshouldBe\b", stmt, maxsplit=1)
+        return b.strip(), "shouldBe:" + a.strip(), [a.strip()]
+    name, args, chain = _tg_call_parts(stmt)
+    if not name:
+        return None
+    hit = _tg_split_chain(name, args, chain) or _tg_split_named(name, args)
+    if hit:
+        return hit
+    if name in _TG_FIRST_ARG:
+        return _tg_split_first_arg(name, args, kotlin_test)
+    if name == "assertThat" and len(args) == 2:
+        return args[1], repr((name, args[0])), [args[0]]
+    return None
+
+
+def _tg_split_chain(name, args, chain):
+    """串接寫法(assertThat(x).isEqualTo(y)、containsExactly…)→ 同 _tg_split_expected 的三元組或 None。"""
+    for cn, cargs in reversed(chain):
+        if cn in ("isEqualTo", "isSameInstanceAs") or cn.startswith("containsExactly"):
+            rest = (name, tuple(args), tuple((c, tuple(a)) for c, a in chain if c != cn))
+            return ",".join(cargs), repr(rest), list(args)
+    return None
+
+
+def _tg_split_named(name, args):
+    """具名參數 expected = … → 同 _tg_split_expected 的三元組或 None。"""
+    named = [a for a in args if re.match(r"expected\s*=", a)]
+    if not named:
+        return None
+    others = [a for a in args if a not in named]
+    return named[0], repr((name, tuple(others))), [a for a in others if not re.match(r"message\s*=", a)]
+
+
+def _tg_split_first_arg(name, args, kotlin_test):
+    """預期值在第一個參數的那幾種(assertEquals 這類):依參數個數與 JUnit/kotlin.test 判訊息與容差的位置。"""
+    if len(args) == 2:
+        return args[0], repr((name, args[1])), [args[1]]
+    if kotlin_test and len(args) in (3, 4):
+        tol = args[2] if (len(args) == 4 or not _TG_LIT.fullmatch(args[2].strip())) else ""   # 三個參數而第三個不是字串 → 容差
+        return args[0] + ("|tol=" + tol if tol else ""), repr((name, args[1])), [args[1]]
+    if len(args) == 3 and _TG_LIT.fullmatch(args[0].strip()):
+        return args[1], repr((name, args[2])), [args[2]]
+    if len(args) == 3:
+        return args[0] + "|delta=" + args[2], repr((name, args[1])), [args[1]]
+    if len(args) == 4:
+        return args[1] + "|delta=" + args[3], repr((name, args[2])), [args[2]]
+    return None
+
+
+def _tg_const_stmt(stmt, kotlin_test=False):
+    """斷言的實際值是常值或恆真 → True:assertTrue(true)、assertEquals(88, 88)、assertThat(3).isEqualTo(3)、
+    assertThat(true).isTrue()、assertTrue(1 == 1)、assertTrue(!false)、assertTrue(x || true)、assertFalse(x && false)。"""
+    name, args, chain = _tg_call_parts(stmt)
+    if not name:
+        return False
+    if name == "assertThat" and len(args) == 1 and chain and _TG_CONST.fullmatch(args[0]):
+        return True
+    if name in _TG_FLIP and args:
+        cond = args[0] if (kotlin_test or len(args) == 1 or not _TG_LIT.fullmatch(args[0].strip())) else args[-1]
+        return bool(_TG_CONST.fullmatch(cond)) or _tg_tautology(cond, name)
+    sp = _tg_split_expected(stmt, kotlin_test)
+    return bool(sp and sp[2] and all(_TG_CONST.fullmatch(a) for a in sp[2]))
+
+
+def _tg_tautology(cond, name):
+    """條件式是不是恆真(或 assertFalse 的恆假):只剩常值與運算子(1 == 1、!false),或最外層接 || true / && false。"""
+    bare = _TG_LIT.sub('""', cond)
+    bare = re.sub(r"\b0[xX][0-9a-fA-F_]+[lLuU]*\b|\b\d[\d_]*(?:\.\d+)?(?:[eE][+-]?\d+)?[lLfFdDuU]*\b", "0", bare)   # 1L、1.0f、0x10
+    if not re.search(r"[A-Za-z_]", re.sub(r"\b(?:true|false|null)\b", "", bare)):
+        return True
+    tail = r"\|\|\s*true" if name == "assertTrue" else r"&&\s*false" if name == "assertFalse" else None
+    return bool(tail and re.search(tail + r"\s*$", bare))
+
+
+def _tg_expected_changed(old, new, kotlin_test=False):
+    """兩個斷言敘述 → 是不是「只有預期值不同」(含 assertTrue↔assertFalse 這類方向互換)。"""
+    if old == new:
+        return False
+    on, oa, _oc = _tg_call_parts(old)
+    nn, na, _nc = _tg_call_parts(new)
+    if on and nn and _TG_FLIP.get(on) == nn and oa == na:
+        return True
+    if on and on == nn and oa == na and _oc and _nc and len(_oc) == len(_nc) and _oc[:-1] == _nc[:-1] \
+            and _TG_CHAIN_FLIP.get(_oc[-1][0]) == _nc[-1][0]:
+        return True
+    a, b = _tg_split_expected(old, kotlin_test), _tg_split_expected(new, kotlin_test)
+    return bool(a and b and a[1] == b[1] and a[0] != b[0])
+
+
+def _tg_pair_key(stmt, kotlin_test=False):
+    """斷言敘述 → 配對用的分組鍵(預期值以外的部分):有預期值位置的取其餘部分的簽名;assertTrue/assertFalse 這類方向互換、
+    Truth 串接的 isTrue/isFalse 這類,把兩個方向歸成同一組;判不出的回 None(不配對)。"""
+    sp = _tg_split_expected(stmt, kotlin_test)
+    if sp:
+        return ("sp", sp[1])
+    name, args, chain = _tg_call_parts(stmt)
+    if not name:
+        return None
+    if name in _TG_FLIP:
+        return ("flip", min(name, _TG_FLIP[name]), tuple(args))
+    if chain and chain[-1][0] in _TG_CHAIN_FLIP:
+        return ("chain", name, tuple(args), tuple((c, tuple(a)) for c, a in chain[:-1]), min(chain[-1][0], _TG_CHAIN_FLIP[chain[-1][0]]))
+    return None
+
+
+def _tg_pairs(old, new, kotlin_test=False):
+    """兩份斷言敘述清單 → 可能被改了預期值的 (舊, 新) 配對。依「預期值以外的部分」分組(同一個被測呼叫的斷言一組),
+    組內先扣掉兩邊一字不差的,剩下的照順序配。重複的相同斷言、前面多插一條都配得對;只看分組不做序列對齊,跟條數成正比。"""
+    groups = {}
+    for side, stmts in ((0, old), (1, new)):
+        for st in stmts:
+            k = _tg_pair_key(st, kotlin_test)
+            if k is not None:
+                groups.setdefault(k, ([], []))[side].append(st)
+    out = []
+    for o, n in groups.values():
+        left = list(n)
+        rest = []
+        for st in o:
+            if st in left:
+                left.remove(st)
+            else:
+                rest.append(st)
+        out.extend(zip(rest, left))
+    return out
+
+
+_TG_TRY = re.compile(r"\btry\s*\{")
+_TG_CATCH = re.compile(r"\s*catch\s*\(")
+_TG_OPEN_BRACE = re.compile(r"\s*\{")
+# catch 接得住斷言失敗的型別:AssertionError 本身、或比它寬的 Error、Throwable(Kotlin 與 Java 寫法都認)
+_TG_CATCH_ASSERT = re.compile(r"\b(?:AssertionError|AssertionFailedError|Error|Throwable)\b")
+_TG_TRY_OK = re.compile(r"(?<![\w])(?:(?:Assert|Assertions|org\.junit\.Assert)\.)?(?:fail|assertThrows|assertFailsWith|assertFails)\s*[({<]")
+_TG_RUNCATCH = re.compile(r"\brunCatching\s*\{")
+_TG_FAIL_CALL = re.compile(r"(?<![\w])(?:Assert\.)?fail\s*\(")
+_TG_THROW = re.compile(r"\bthrow\b")
+_TG_CHECK_CALL = re.compile(r"(?<![\w.])(?:check|require)\s*\((?!\s*true\s*\))")   # Kotlin 標準庫的檢查,不成立就丟例外;恆成立的 check(true) 不算
+# Kotest 匹配器照名字認(shouldBe、shouldNot…、shouldHave…、shouldContain…、shouldStart…、shouldEnd…、shouldMatch…、shouldThrow…、
+# shouldExist…),中綴(`a shouldBe b`)與點號呼叫(`a.shouldBe(b)`)都算;shouldRetry、shouldLog 這種一般名字、後面接 = 或 : 的宣告不算。
+# _TG_INFIX_RE 是「這支測試有沒有斷言」用的寬判法(寧可多認),catch 判讀要分辨有沒有真的檢查,所以另用這條照名字認的
+_TG_KOTEST_CHECK = re.compile(r"(?<!\w)should(?:Be|Not|Have|Contain|Start|End|Match|Throw|Exist)\w*(?!\w)(?!\s*[=:])")
+_TG_NONSPACE = re.compile(r"\S")
+
+
+def _tg_catch_no_fail(fn):
+    """try 沒有 fail、catch 裡斷言或是空的;try 裡有斷言、catch 接住斷言失敗卻不再丟出;runCatching 裡斷言沒接 getOrThrow。
+    斷言、fail、throw、catch 型別字的位置整支函式各算一次,每個 try 用二分查範圍裡有沒有,巢狀很深也跟長度成正比。"""
+    import bisect
+    b = fn["mbody"]
+    br = _rg_bracket_map(b)
+    pos = {k: [m.start() for m in rx.finditer(b)] for k, rx in
+           (("assert", _TG_ASSERT_RE), ("infix", _TG_KOTEST_CHECK), ("ctype", _TG_CATCH_ASSERT), ("check", _TG_CHECK_CALL), ("ok", _TG_TRY_OK), ("fail", _TG_FAIL_CALL),
+            ("throw", _TG_THROW))}
+
+    def has(kind, lo, hi):
+        p = pos[kind]
+        i = bisect.bisect_left(p, lo)
+        return i < len(p) and p[i] < hi
+    for t in _TG_TRY.finditer(b):
+        tb_end = br.get(t.end() - 1)
+        c = _TG_CATCH.match(b, tb_end + 1) if tb_end is not None else None
+        close = br.get(c.end() - 1) if c else None
+        o = _TG_OPEN_BRACE.match(b, close + 1) if close is not None else None
+        if not o or (o.end() - 1) not in br:
+            continue
+        cs, cb_end = o.end(), br[o.end() - 1]
+        if has("fail", cs, cb_end):
+            continue
+        catch_checks = has("assert", cs, cb_end) or has("infix", cs, cb_end) or has("check", cs, cb_end)
+        # 「try 沒有 fail、catch 裡斷言或是空的」:try 有 fail/assertThrows 是預期例外的寫法,不算
+        if not has("ok", t.end(), tb_end) and (catch_checks or not _TG_NONSPACE.search(b, cs, cb_end)):
+            return True
+        # try 裡的斷言(含 fail 本身,它丟的也是 AssertionError;含 Kotest 中綴斷言)被接得住它的 catch 接住、catch 不檢查也不再丟出:吞掉了
+        tried = has("assert", t.end(), tb_end) or has("infix", t.end(), tb_end)
+        if has("ctype", c.end(), close) and tried and not catch_checks and not has("throw", cs, cb_end):
+            return True
+    for r in _TG_RUNCATCH.finditer(b):
+        end = br.get(r.end() - 1)
+        if end is not None and has("assert", r.end(), end) and not re.match(r"\s*\.\s*getOrThrow\s*\(", b[end + 1:end + 60]):
+            return True
+    return False
+
+
+# 跳過標記:短名或完整類別名(@org.junit.jupiter.api.Disabled)都認;JUnit 5 的條件式(@DisabledOnOs、@EnabledOnOs…)在 CI 平台上等於關掉
+_TG_SKIP_ANN_RE = re.compile(r"@(?:[\w.]+\.)?(?:Ignore|Disabled\w*|Enabled(?:On|If|For)\w*|SdkSuppress|FlakyTest)\b|@(?:[\w.]+\.)?Config\s*\(\s*sdk\b")
+# 執行時才決定跳不跳的 assume:身分要帶那一行(條件改成永遠跳過也算新增)
+_TG_ASSUME_RE = re.compile(r"\bAssume\.assume\w*\s*\(|(?<![\w.])assume(?:True|False|NotNull|That)\s*\(|\bAssumptions\.assum\w*\s*\("
+                           r"|\bTruthJUnit\.assume\s*\(")
+_TG_SNAP_WORDS = re.compile(r"\bchangeThreshold\b|\bmaxDistance\b|\bImageComparator\b|roborazzi\.test\.record")
+_TG_SNIFF = re.compile(r"\"robolectric\"|\bisRunningTest\b|\bisRobolectric\b|Class\.forName\(\s*\"(?:org\.junit|androidx\.test|org\.robolectric)", re.I)
+_TG_TIMEOUT = re.compile(r"timeout|withTimeout\s*\(", re.I)
+_TG_NUM = re.compile(r"\d[\d_]*(?:\.\d+)?[lLfF]?")
+
+
+def _tg_norm(s):
+    return re.sub(r"\s+", " ", s).strip()
+
+
+def _tg_test_hits(text, fns, path):
+    """測試檔 → {身分: [(檔, 行號), …]}。身分是(規則, 擁有者, 種類):
+    - 擁有者:在測試函式裡就是函式名(不帶類別與本體:測試原樣搬到另一支檔、或只改本體,帶過去的跳過標記不算新增);
+      不在任何函式裡(類別層級的 @Ignore)就是「檔:<路徑>」,不跟別支檔的類別層級註記互抵。
+    - 種類:跳過註記一律算「跳過」(@Ignore 換成 @Disabled、改跳過理由都不算新增);assume 呼叫與比對門檻帶「整個敘述、字串外的空白整理過」
+      (_tg_stmt_at:括號用共用的對應表跳過、跨行照接、到分號或敘述結尾為止):條件改成永遠跳過、門檻調高都算新增;
+      只換行重排、改同一行別的斷言不算;字串常值裡的空白差異照樣算(含頭尾,_tg_ident)。
+    代價:不同類別裡同名的兩支測試,一支拿掉跳過、另一支加上,會互抵(寫進標準的「抓不到」)。"""
+    import bisect
+    hits, owner = {}, {}
+    for _key, f in fns.items():
+        for ln in range(f["start"], f["end"] + 1):
+            owner[ln] = f["name"]
+    kept = _tg_strip(text, keep_strings=True)
+    blank = bmap = None
+    for i, line in enumerate(kept.split("\n"), 1):
+        if _TG_SKIP_ANN_RE.search(line):
+            hits.setdefault(("tq/skip-added", owner.get(i) or "檔:" + path, "跳過"), []).append((path, i))
+    nls = None
+    for rx, rule, tag in ((_TG_ASSUME_RE, "tq/skip-added", "跳過:"), (_TG_SNAP_WORDS, "tq/snapshot-changed", "")):
+        span_end, ident = -1, None
+        for m in rx.finditer(kept):
+            if nls is None:
+                nls = [k for k, ch in enumerate(kept) if ch == "\n"]
+                blank = _tg_strip(text)                  # 字串內容換成空白(位置一一對應):字串裡的括號不算進配對
+                bmap = _rg_bracket_map(blank)
+            i = bisect.bisect_left(nls, m.start()) + 1
+            if m.start() >= span_end:             # 落在前一個敘述裡的命中併進那個敘述(巢狀、同一行連寫),總工作量跟長度成正比
+                stmt, span_end = _tg_stmt_at(kept, blank, bmap, m.start())
+                ident = (rule, owner.get(i) or "檔:" + path, tag + stmt)
+            hits.setdefault(ident, []).append((path, i))
+    return hits
+
+
+_TG_STMT_GOES_ON = ("=", ",", "(", "+", "&&", "||")
+_TG_STMT_STOP = re.compile(r"[(\[{)\]};\n]")
+
+
+def _tg_stmt_at(kept, blank, bmap, i):
+    """位置 i 起的那個敘述 → (身分用的敘述字串, 結束位置)。邊界在剝掉字串的文字(blank)上找:左括號照共用的括號對應表
+    (bmap,_rg_bracket_map)整段跳過;深度 0 遇到分號、多出來的右括號,或換行而上一段不像沒寫完(結尾不是 = , ( + && ||、
+    下一行也不是 . ?. && || 開頭)就停;最多看 _TG_MAX_STMT_CHARS 字。身分取留字串的原文(_tg_ident:字串外的空白整理、字串常值原樣;
+    換行重排不算改動,字串常值 "c i" 跟 "ci"、" ci" 跟 "ci" 仍不同)。"""
+    end = min(len(blank), i + _TG_MAX_STMT_CHARS)
+    k = i
+    while k < end:
+        m = _TG_STMT_STOP.search(blank, k, end)
+        if not m:
+            k = end
+            break
+        k = m.start()
+        ch = blank[k]
+        if ch in "([{":
+            close = bmap.get(k)
+            k = end if close is None else close + 1
+            continue
+        if ch != "\n":
+            break
+        if blank[i:k].rstrip().endswith(_TG_STMT_GOES_ON) or blank[k + 1:k + 200].lstrip().startswith((".", "?.", "&&", "||")):
+            k += 1
+            continue
+        break
+    k = min(k, end)
+    return _tg_ident(kept[i:k]), k
+
+
+def _tg_ident(text):
+    """敘述原文 → 身分:字串常值原樣保留(頭尾與逗號後的空白都算內容),字串外字詞之間的空白壓成一格、標點兩側的空白拿掉。
+    字串用剝註解那支的掃描式(_C_STRIP_PAT)認,不另寫一套。"""
+    out, last = [], 0
+    for mo in _lazy_re(_C_STRIP_PAT, re.S).finditer(text):
+        if mo.group(0)[:2] in ("//", "/*"):
+            continue
+        out += [_tg_ws_fold(text[last:mo.start()]), mo.group(0)]
+        last = mo.end()
+    out.append(_tg_ws_fold(text[last:]))
+    return "".join(out).strip()
+
+
+def _tg_ws_fold(code):
+    return re.sub(r"\s*([^\w\s])\s*", r"\1", re.sub(r"\s+", " ", code))
+
+
+def _tg_main_hits(text):
+    hits = {}
+    for i, line in enumerate(_tg_strip(text, keep_strings=True).split("\n"), 1):
+        if _TG_SNIFF.search(line):
+            hits.setdefault(("tq/test-env-sniff", "", _tg_norm(line)), []).append(i)
+    return hits
+
+
+def _tg_diff_locs(base, head):
+    """兩邊 {身分: [行號, …]} → [(身分, 第幾個, 行號)]:改動後比改動前多出來的那幾個,行號取改動後排在後面的那幾處。"""
+    out = []
+    for ident, locs in head.items():
+        b = len(base.get(ident, ()))
+        extra = len(locs) - b
+        for k in range(max(0, extra)):
+            out.append((ident, b + k + 1, locs[len(locs) - extra + k]))
+    return out
+
+
+def _tg_timeout_raised(old_lines, new_lines):
+    """改動前、後的各行 → 逾時數字被調大的那幾行(數字換成 # 之後同形的一對,改動後的最大值比較大)。用集合與同形分組,跟行數成正比。"""
+    olds, news = set(old_lines), set(new_lines)
+    gone = {}
+    for x in old_lines:
+        if x not in news and _TG_TIMEOUT.search(x):
+            nb = [float(v.rstrip("lLfF").replace("_", "")) for v in _TG_NUM.findall(x)]
+            if nb:
+                shape = _TG_NUM.sub("#", x)
+                gone[shape] = min(gone.get(shape, max(nb)), max(nb))
+    out = []
+    for a in new_lines:
+        if a in olds or not _TG_TIMEOUT.search(a):
+            continue
+        shape = _TG_NUM.sub("#", a)
+        na = [float(v.rstrip("lLfF").replace("_", "")) for v in _TG_NUM.findall(a)]
+        if shape in gone and na and max(na) > gone[shape]:
+            out.append(a)
+    return out
