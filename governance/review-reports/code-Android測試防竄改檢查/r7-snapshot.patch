+def _tg_strong(stmts):
+    """強斷言(相等比對)的條數;字串常值的內容先清空,訊息裡寫的 assertEquals 不算。"""
+    return sum(1 for s in stmts if _TG_STRONG.search(_TG_LIT.sub('""', s)))
