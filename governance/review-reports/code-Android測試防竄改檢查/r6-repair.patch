+++++                         r"|\bAssume\.assume\w*\s*\(|(?<![\w.])assume(?:True|False|NotNull|That)\s*\(|\bAssumptions\.assum\w*\s*\(")
+++++_TG_SET = r"(?:\s*=\s*|\s+|\.set\(\s*|\(\s*)"
+++++_TG_BUILD_RES = (
+++++    re.compile(r"\bexcludeTestsMatching\b"),
+++++    re.compile(r"\b(?:is)?[Ff]ailOn(?:NoMatchingTests|NoDiscoveredTests)" + _TG_SET + r"false\b"),
+++++    re.compile(r"\b(?:is)?[Rr]eturnDefaultValues" + _TG_SET + r"true\b"),
+++++    re.compile(r"\bfailOnPassedAfterRetry" + _TG_SET + r"false\b"),
+++++    re.compile(r"\bnot(?:Annotation|Class|Package)\b"),
+++++)
+++++# 測試任務的區塊:test {}、tasks.test、withType<Test>、任務名含 test 的 named(Android 的 testDebugUnitTest)、unitTests.all
+++++_TG_TEST_BLOCK = re.compile(r"(?i)(?<![\w])test\s*\{|\btasks\.test\b|withType\s*[<(]\s*Test\b|named\s*[<(][^)]*[\"'][^\"']*test[^\"']*[\"']|^\s*test\b"
+++++                            r"|\bunitTests\.all\b")
+++++# 同一行點名了測試任務(引號裡含 test,或 unitTests.all):tasks.matching { it.name.contains("UnitTest") }.configureEach { enabled = false }
+++++_TG_TEST_NAMED_LINE = re.compile(r"(?i)[\"'][^\"'\n]*test[^\"'\n]*[\"']|\bunitTests\.all\b")
