+++++_TG_STRONG = re.compile(r"\b(?:assertEquals|assertArrayEquals|assertContentEquals|assertSame|isEqualTo|isSameInstanceAs"
+++++                        r"|containsExactly\w*|shouldBe)\b")
+++++_TG_EXPECTED_ANN = re.compile(r"\bexpected\s*=")
