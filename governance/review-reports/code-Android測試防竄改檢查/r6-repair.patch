+++# 執行時才決定跳不跳的 assume:身分要帶那一行(條件改成永遠跳過也算新增)
+++_TG_ASSUME_RE = re.compile(r"\bAssume\.assume\w*\s*\(|(?<![\w.])assume(?:True|False|NotNull|That)\s*\(|\bAssumptions\.assum\w*\s*\("
+++                           r"|\bTruthJUnit\.assume\s*\(")
+++_TG_SET = r"(?:\s*=\s*|\s+|\.set\(\s*|\(\s*)"
+++_TG_IGNORE_FAIL = re.compile(r"\bignoreFailures" + _TG_SET + r"true\b")
+++# 跟測試無關、但也有 ignoreFailures、enabled、exclude 這類同名設定的外掛與報表區塊
+++# 只比對區塊開頭(左大括號之前那段),不比對同一行後面的字(`tasks.test { …; finalizedBy("jacocoTestReport") }` 仍是測試區塊)
