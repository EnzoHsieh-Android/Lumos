+++    lines, slines, klines = text.split("\n"), stripped.split("\n"), keep.split("\n")
+++    cls, memo = _tg_class_at(stripped), {}
+++    out, seen = {}, {}
+++    for _nm, s, e, _tx in _rg_methods(stripped, java, kinds=_TG_TEST_ANNS):
+++        name, decl = None, None
+++        for k in range(s - 1, min(e, len(lines))):
+++            mm = _TG_NAME_RE.search(lines[k])
+++            if mm:
+++                name, decl = (mm.group(1) or mm.group(2) or "").strip("`"), k
+++                break
+++        if not name:
+++            continue
+++        path = _tg_class_path(cls.get(s), memo)
+++        key = (path + "." if path else "") + name
+++        seen[key] = seen.get(key, 0) + 1
+++        if seen[key] > 1:                       # 同名多載依出現順序加 #2、#3(計數器,不逐個試名字)
+++            key = f"{key}#{seen[key]}"
