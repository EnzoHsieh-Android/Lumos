+++def _tg_class_has_body(stripped, j, bmap, nxt=None):
+++    """類別名之後的位置 j → 這個宣告有沒有大括號本體。跳過泛型(_tg_skip_generic)、建構子與父型別的參數列(可跨行),
+++    父型別寫在下一行(`:`、`,`、extends、implements、where 開頭)也接著看,最多 8 段。
+++    下一個 `{`、`(`、換行的位置用 nxt 快取(同一段區間的查詢答案相同),一行塞很多類別宣告也跟長度成正比。"""
+++    n = len(stripped)
+++    nxt = nxt if nxt is not None else [0, -1]
+++    while j < n and stripped[j] in " \t":
+++        j += 1
+++    j = _tg_skip_generic(stripped, j)
+++    for _step in range(8):
+++        p = _tg_next_stop(stripped, j, nxt)
+++        if p >= n:
+++            return False
+++        if stripped[p] == "{":
+++            return True
+++        if stripped[p] == "(":
+++            j = bmap.get(p, n - 1) + 1
+++            continue
+++        k = _tg_supertype_next_line(stripped, p + 1)
+++        if k is None:
+++            return False
+++        if k < n and stripped[k] == "{":
+++            return True
+++        j = k
+++    return False
+++
+++
+++def _tg_skip_generic(stripped, j):
+++    """j 是 `<` 就跳過配平的角括號(同一行、最多 _TG_GENERIC_MAX 字,用 C 層的 find/count);配不平或不是 `<` 回原位。"""
+++    if j >= len(stripped) or stripped[j] != "<":
+++        return j
+++    nl = stripped.find("\n", j)
+++    lim = min(len(stripped) if nl < 0 else nl, j + _TG_GENERIC_MAX)
+++    k, opened, closed = j, 0, 0
+++    while True:
+++        e = stripped.find(">", k, lim)
+++        if e < 0:
+++            return j
+++        opened += stripped.count("<", k, e + 1)
+++        closed += 1
+++        k = e + 1
+++        if opened == closed:
+++            return k
+++
+++
+++def _tg_supertype_next_line(stripped, k):
+++    """換行之後的位置 k → 下一個非空白字的位置,如果它是 `{` 或父型別的續寫(`:`、`,`、extends、implements、where);否則 None。"""
+++    n = len(stripped)
+++    while k < n and stripped[k] in " \t\n":
+++        k += 1
+++    if k < n and (stripped[k] in "{:," or _TG_SUPERTYPE.match(stripped, k)):
+++        return k
+++    return None
