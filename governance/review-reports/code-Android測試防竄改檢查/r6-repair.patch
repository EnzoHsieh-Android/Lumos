+++def _tg_class_path(node, memo):
+++    """類別節點 → 「外層.內層」路徑字串(None → "")。往外走一次收名稱、一次接好;memo 只存被查過的那個節點
+++    (不存沿路每一層:那又會變回深度平方的記憶體)。"""
+++    if node is None:
+++        return ""
+++    if id(node) not in memo:
+++        names, cur = [], node
+++        while cur is not None:
+++            names.append(cur[0])
+++            cur = cur[1]
+++        memo[id(node)] = ".".join(reversed(names))
+++    return memo[id(node)]
+++
