++_TG_CONST = re.compile(r'\s*(?:-?\d[\d_]*(?:\.\d+)?[lLfFdD]?|true|false|null|"(?:[^"\\\n]|\\.)*+"|\'(?:[^\'\\\n]|\\.)\')\s*')   # 佔有式:長字串常值不回溯
++_TG_CHAIN = re.compile(r"\s*\.\s*\w+\s*(?:<[^>]*>)?\s*[({]")
++
++
++def _tg_statements(fn):
++    """一支函式 → 斷言敘述清單(原文、壓空白):從斷言字到它的右括號或右大括號,再接後面連著的 .名稱(…) 鏈;可跨行。"""
++    sb, rb = fn["mbody"], fn["raw"]
++    br = _rg_bracket_map(sb)
++    out, pos = [], 0
++    while len(out) < _TG_MAX_STMTS:
++        m = _TG_ASSERT_RE.search(sb, pos)
++        if not m:
++            break
++        opener = m.end() - 1
++        if sb[opener] == "<":
++            p2 = sb.find("(", opener)
++            opener = p2 if p2 >= 0 else opener
++        k = br.get(opener, opener) + 1 if sb[opener] in "({" else m.end()
++        while True:
++            mm = _TG_CHAIN.match(sb, k, min(len(sb), k + 400))
++            if not mm or mm.end() - 1 not in br:
++                break
++            k = br[mm.end() - 1] + 1
++        out.append(re.sub(r"\s+", " ", rb[m.start():k]).strip())
++        pos = max(k, m.end())
++    import bisect
++    nls, text_of = None, {}
++    for m in _TG_INFIX_RE.finditer(sb):           # 中綴斷言照個數算(同一行三個就是三條),那一行的文字只取一次
++        if len(out) >= _TG_MAX_STMTS:
++            break
++        if nls is None:
++            nls = [k for k, ch in enumerate(sb) if ch == "\n"]
++        li = bisect.bisect_left(nls, m.start())
++        if li not in text_of:
++            ls = nls[li - 1] + 1 if li > 0 else 0
++            le = nls[li] if li < len(nls) else len(rb)
++            text_of[li] = re.sub(r"\s+", " ", rb[ls:le]).strip()
++        out.append(text_of[li])
++    return out[:_TG_MAX_STMTS]
++
++
++def _tg_has_assertion(fn):
++    return bool(_TG_ASSERT_RE.search(fn["mbody"]) or _TG_INFIX_RE.search(fn["mbody"]) or _TG_EXPECTED_ANN.search(fn["annot"]))
++
++
++def _tg_strong(stmts):
++    """強斷言(相等比對)的條數;字串常值的內容先清空,訊息裡寫的 assertEquals 不算。"""
++    return sum(1 for s in stmts if _TG_STRONG.search(_TG_LIT.sub('""', s)))
++
++
++_TG_LIT = re.compile(r'"(?:[^"\\\n]|\\.)*+"|\'(?:[^\'\\\n]|\\.)\'')   # 佔有式:長字串常值不回溯(同 _C_STRIP_PAT)
++_TG_FIRST_ARG = ("assertEquals", "assertNotEquals", "assertArrayEquals", "assertContentEquals", "assertSame")
++_TG_FLIP = {"assertTrue": "assertFalse", "assertFalse": "assertTrue", "assertNull": "assertNotNull", "assertNotNull": "assertNull"}
++# Truth / AssertJ 串接的方向互換:assertThat(x).isTrue() 改 isFalse() 跟 assertTrue 改 assertFalse 同一種
++_TG_CHAIN_FLIP = {"isTrue": "isFalse", "isFalse": "isTrue", "isEmpty": "isNotEmpty", "isNotEmpty": "isEmpty",
++                  "isNull": "isNotNull", "isNotNull": "isNull"}
++# 斷言的訊息在最後(kotlin.test、JUnit 5 的 Assertions):三個參數時第三個是字串就是訊息、不是字串就是容差
++_TG_MSG_LAST_RE = re.compile(r"^\s*import\s+(?:static\s+)?(?:kotlin\.test\.(?:\*|assert)|org\.junit\.jupiter\.api\.Assertions\b)", re.M)
++
++
++def _tg_call_parts(stmt):
++    """敘述 → (呼叫名, [參數…], [(鏈上名稱, [參數…])…])。參數切法不把 < > 當括號(比較運算與 lambda 箭頭)。"""
++    m = re.match(r"\.?([\w.]+?)\s*(?:<[^>()]*>)?\s*\(", stmt)
++    if not m:
++        return None, [], []
++    name = m.group(1).rsplit(".", 1)[-1]
++    br = _rg_bracket_map(_tg_strip(stmt))
++    close = br.get(m.end() - 1, len(stmt))
++    args = _rg_split_args(stmt[m.end():close], angle=False)
++    chain, k = [], close + 1
++    while True:
++        mm = re.compile(r"\s*\.\s*(\w+)\s*\(").match(stmt, k)
++        if not mm or mm.end() - 1 not in br:
++            break
++        en = br[mm.end() - 1]
++        chain.append((mm.group(1), _rg_split_args(stmt[mm.end():en], angle=False)))
++        k = en + 1
++    return name, args, chain
++
++
++def _tg_split_expected(stmt, kotlin_test=False):
++    """敘述 → (預期值那部分, 其餘部分的簽名, 實際值清單);判不出預期值位置回 None。
++    JUnit:三個參數第一個是字串常值 → 訊息在前;kotlin.test(檔案匯入 kotlin.test 的斷言):訊息在最後、容差在第三個。"""
++    if re.search(r"\bshouldBe\b", stmt):
++        a, b = re.split(r"\bshouldBe\b", stmt, maxsplit=1)
++        return b.strip(), "shouldBe:" + a.strip(), [a.strip()]
++    name, args, chain = _tg_call_parts(stmt)
++    if not name:
++        return None
++    hit = _tg_split_chain(name, args, chain) or _tg_split_named(name, args)
++    if hit:
++        return hit
++    if name in _TG_FIRST_ARG:
++        return _tg_split_first_arg(name, args, kotlin_test)
++    if name == "assertThat" and len(args) == 2:
++        return args[1], repr((name, args[0])), [args[0]]
++    return None
++
++
++def _tg_split_chain(name, args, chain):
++    """串接寫法(assertThat(x).isEqualTo(y)、containsExactly…)→ 同 _tg_split_expected 的三元組或 None。"""
++    for cn, cargs in reversed(chain):
++        if cn in ("isEqualTo", "isSameInstanceAs") or cn.startswith("containsExactly"):
++            rest = (name, tuple(args), tuple((c, tuple(a)) for c, a in chain if c != cn))
++            return ",".join(cargs), repr(rest), list(args)
++    return None
++
++
++def _tg_split_named(name, args):
++    """具名參數 expected = … → 同 _tg_split_expected 的三元組或 None。"""
++    named = [a for a in args if re.match(r"expected\s*=", a)]
++    if not named:
++        return None
++    others = [a for a in args if a not in named]
++    return named[0], repr((name, tuple(others))), [a for a in others if not re.match(r"message\s*=", a)]
++
++
++def _tg_split_first_arg(name, args, kotlin_test):
++    """預期值在第一個參數的那幾種(assertEquals 這類):依參數個數與 JUnit/kotlin.test 判訊息與容差的位置。"""
++    if len(args) == 2:
++        return args[0], repr((name, args[1])), [args[1]]
++    if kotlin_test and len(args) in (3, 4):
++        tol = args[2] if (len(args) == 4 or not _TG_LIT.fullmatch(args[2].strip())) else ""   # 三個參數而第三個不是字串 → 容差
++        return args[0] + ("|tol=" + tol if tol else ""), repr((name, args[1])), [args[1]]
++    if len(args) == 3 and _TG_LIT.fullmatch(args[0].strip()):
++        return args[1], repr((name, args[2])), [args[2]]
++    if len(args) == 3:
++        return args[0] + "|delta=" + args[2], repr((name, args[1])), [args[1]]
++    if len(args) == 4:
++        return args[1] + "|delta=" + args[3], repr((name, args[2])), [args[2]]
++    return None
++
++
++def _tg_const_stmt(stmt, kotlin_test=False):
++    """斷言的實際值是常值或恆真 → True:assertTrue(true)、assertEquals(88, 88)、assertThat(3).isEqualTo(3)、
++    assertThat(true).isTrue()、assertTrue(1 == 1)、assertTrue(!false)、assertTrue(x || true)、assertFalse(x && false)。"""
++    name, args, chain = _tg_call_parts(stmt)
++    if not name:
++        return False
++    if name == "assertThat" and len(args) == 1 and chain and _TG_CONST.fullmatch(args[0]):
++        return True
++    if name in _TG_FLIP and args:
++        cond = args[0] if (kotlin_test or len(args) == 1 or not _TG_LIT.fullmatch(args[0].strip())) else args[-1]
++        return bool(_TG_CONST.fullmatch(cond)) or _tg_tautology(cond, name)
++    sp = _tg_split_expected(stmt, kotlin_test)
++    return bool(sp and sp[2] and all(_TG_CONST.fullmatch(a) for a in sp[2]))
++
++
++def _tg_tautology(cond, name):
++    """條件式是不是恆真(或 assertFalse 的恆假):只剩常值與運算子(1 == 1、!false),或最外層接 || true / && false。"""
++    bare = _TG_LIT.sub('""', cond)
++    bare = re.sub(r"\b0[xX][0-9a-fA-F_]+[lLuU]*\b|\b\d[\d_]*(?:\.\d+)?(?:[eE][+-]?\d+)?[lLfFdDuU]*\b", "0", bare)   # 1L、1.0f、0x10
++    if not re.search(r"[A-Za-z_]", re.sub(r"\b(?:true|false|null)\b", "", bare)):
++        return True
++    tail = r"\|\|\s*true" if name == "assertTrue" else r"&&\s*false" if name == "assertFalse" else None
++    return bool(tail and re.search(tail + r"\s*$", bare))
++
++
++def _tg_expected_changed(old, new, kotlin_test=False):
++    """兩個斷言敘述 → 是不是「只有預期值不同」(含 assertTrue↔assertFalse 這類方向互換)。"""
++    if old == new:
++        return False
++    on, oa, _oc = _tg_call_parts(old)
++    nn, na, _nc = _tg_call_parts(new)
++    if on and nn and _TG_FLIP.get(on) == nn and oa == na:
++        return True
++    if on and on == nn and oa == na and _oc and _nc and len(_oc) == len(_nc) and _oc[:-1] == _nc[:-1] \
++            and _TG_CHAIN_FLIP.get(_oc[-1][0]) == _nc[-1][0]:
++        return True
++    a, b = _tg_split_expected(old, kotlin_test), _tg_split_expected(new, kotlin_test)
++    return bool(a and b and a[1] == b[1] and a[0] != b[0])
++
++
++def _tg_pair_key(stmt, kotlin_test=False):
++    """斷言敘述 → 配對用的分組鍵(預期值以外的部分):有預期值位置的取其餘部分的簽名;assertTrue/assertFalse 這類方向互換、
++    Truth 串接的 isTrue/isFalse 這類,把兩個方向歸成同一組;判不出的回 None(不配對)。"""
++    sp = _tg_split_expected(stmt, kotlin_test)
++    if sp:
++        return ("sp", sp[1])
++    name, args, chain = _tg_call_parts(stmt)
++    if not name:
++        return None
++    if name in _TG_FLIP:
++        return ("flip", min(name, _TG_FLIP[name]), tuple(args))
++    if chain and chain[-1][0] in _TG_CHAIN_FLIP:
++        return ("chain", name, tuple(args), tuple((c, tuple(a)) for c, a in chain[:-1]), min(chain[-1][0], _TG_CHAIN_FLIP[chain[-1][0]]))
++    return None
++
++
++def _tg_pairs(old, new, kotlin_test=False):
++    """兩份斷言敘述清單 → 可能被改了預期值的 (舊, 新) 配對。依「預期值以外的部分」分組(同一個被測呼叫的斷言一組),
++    組內先扣掉兩邊一字不差的,剩下的照順序配。重複的相同斷言、前面多插一條都配得對;只看分組不做序列對齊,跟條數成正比。"""
++    groups = {}
++    for side, stmts in ((0, old), (1, new)):
++        for st in stmts:
++            k = _tg_pair_key(st, kotlin_test)
++            if k is not None:
++                groups.setdefault(k, ([], []))[side].append(st)
++    out = []
++    for o, n in groups.values():
++        left = list(n)
++        rest = []
++        for st in o:
++            if st in left:
++                left.remove(st)
++            else:
++                rest.append(st)
++        out.extend(zip(rest, left))
++    return out
++
++
++_TG_TRY = re.compile(r"\btry\s*\{")
++_TG_CATCH = re.compile(r"\s*catch\s*\(([^)]*)\)\s*\{")
++# catch 接得住斷言失敗的型別:AssertionError 本身、或比它寬的 Error、Throwable(Kotlin 與 Java 寫法都認)
++_TG_CATCH_ASSERT = re.compile(r"\b(?:AssertionError|AssertionFailedError|Error|Throwable)\b")
++_TG_TRY_OK = re.compile(r"(?<![\w])(?:(?:Assert|Assertions|org\.junit\.Assert)\.)?(?:fail|assertThrows|assertFailsWith|assertFails)\s*[({<]")
++_TG_RUNCATCH = re.compile(r"\brunCatching\s*\{")
++_TG_FAIL_CALL = re.compile(r"(?<![\w])(?:Assert\.)?fail\s*\(")
++_TG_THROW = re.compile(r"\bthrow\b")
++_TG_CHECK_CALL = re.compile(r"(?<![\w.])(?:check|require)\s*\(")       # Kotlin 標準庫的檢查,不成立就丟例外
++_TG_NONSPACE = re.compile(r"\S")
++
++
++def _tg_catch_no_fail(fn):
++    """try 沒有 fail、catch 裡斷言或是空的;try 裡有斷言、catch 接住斷言失敗卻不再丟出;runCatching 裡斷言沒接 getOrThrow。
++    斷言、fail、throw 的位置整支函式各算一次,每個 try 用二分查範圍裡有沒有,巢狀很深也跟長度成正比。"""
++    import bisect
++    b = fn["mbody"]
++    br = _rg_bracket_map(b)
++    pos = {k: [m.start() for m in rx.finditer(b)] for k, rx in
++           (("assert", _TG_ASSERT_RE), ("infix", _TG_INFIX_RE), ("check", _TG_CHECK_CALL), ("ok", _TG_TRY_OK), ("fail", _TG_FAIL_CALL),
++            ("throw", _TG_THROW))}
++
++    def has(kind, lo, hi):
++        p = pos[kind]
++        i = bisect.bisect_left(p, lo)
++        return i < len(p) and p[i] < hi
++    for t in _TG_TRY.finditer(b):
++        tb_end = br.get(t.end() - 1)
++        c = _TG_CATCH.match(b, tb_end + 1) if tb_end is not None else None
++        if not c or (c.end() - 1) not in br:
++            continue
++        cb_end = br[c.end() - 1]
++        if has("fail", c.end(), cb_end):
++            continue
++        catch_checks = has("assert", c.end(), cb_end) or has("infix", c.end(), cb_end) or has("check", c.end(), cb_end)
++        # 「try 沒有 fail、catch 裡斷言或是空的」:try 有 fail/assertThrows 是預期例外的寫法,不算
++        if not has("ok", t.end(), tb_end) and (catch_checks or not _TG_NONSPACE.search(b, c.end(), cb_end)):
++            return True
++        # try 裡的斷言(含 fail 本身,它丟的也是 AssertionError)被接得住它的 catch 接住、catch 不檢查也不再丟出:吞掉了
++        if _TG_CATCH_ASSERT.search(c.group(1)) and has("assert", t.end(), tb_end) and not catch_checks and not has("throw", c.end(), cb_end):
++            return True
++    for r in _TG_RUNCATCH.finditer(b):
++        end = br.get(r.end() - 1)
++        if end is not None and has("assert", r.end(), end) and not re.match(r"\s*\.\s*getOrThrow\s*\(", b[end + 1:end + 60]):
++            return True
++    return False
++
++
++# 跳過標記:短名或完整類別名(@org.junit.jupiter.api.Disabled)都認;JUnit 5 的條件式(@DisabledOnOs、@EnabledOnOs…)在 CI 平台上等於關掉
++_TG_SKIP_ANN_RE = re.compile(r"@(?:[\w.]+\.)?(?:Ignore|Disabled\w*|Enabled(?:On|If|For)\w*|SdkSuppress|FlakyTest)\b|@(?:[\w.]+\.)?Config\s*\(\s*sdk\b")
++# 執行時才決定跳不跳的 assume:身分要帶那一行(條件改成永遠跳過也算新增)
++_TG_ASSUME_RE = re.compile(r"\bAssume\.assume\w*\s*\(|(?<![\w.])assume(?:True|False|NotNull|That)\s*\(|\bAssumptions\.assum\w*\s*\("
++                           r"|\bTruthJUnit\.assume\s*\(")
++_TG_SNAP_WORDS = re.compile(r"\bchangeThreshold\b|\bmaxDistance\b|\bImageComparator\b|roborazzi\.test\.record")
++_TG_SNIFF = re.compile(r"\"robolectric\"|\bisRunningTest\b|\bisRobolectric\b|Class\.forName\(\s*\"(?:org\.junit|androidx\.test|org\.robolectric)", re.I)
++_TG_TIMEOUT = re.compile(r"timeout|withTimeout\s*\(", re.I)
++_TG_NUM = re.compile(r"\d[\d_]*(?:\.\d+)?[lLfF]?")
++
++
++def _tg_norm(s):
++    return re.sub(r"\s+", " ", s).strip()
++
++
++def _tg_test_hits(text, fns, path):
++    """測試檔 → {身分: [(檔, 行號), …]}。身分是(規則, 擁有者, 種類):
++    - 擁有者:在測試函式裡就是函式名(不帶類別與本體:測試原樣搬到另一支檔、或只改本體,帶過去的跳過標記不算新增);
++      不在任何函式裡(類別層級的 @Ignore)就是「檔:<路徑>」,不跟別支檔的類別層級註記互抵。
++    - 種類:跳過註記一律算「跳過」(@Ignore 換成 @Disabled、改跳過理由都不算新增);assume 呼叫與比對門檻帶「整個敘述去掉空白」
++      (_tg_stmt_at:括號用共用的對應表跳過、跨行照接、到分號或敘述結尾為止):條件改成永遠跳過、門檻調高都算新增;
++      只換行重排、改同一行別的斷言不算;字串常值裡的空白差異照樣算(只在標點兩側去空白)。
++    代價:不同類別裡同名的兩支測試,一支拿掉跳過、另一支加上,會互抵(寫進標準的「抓不到」)。"""
++    import bisect
++    hits, owner = {}, {}
++    for _key, f in fns.items():
++        for ln in range(f["start"], f["end"] + 1):
++            owner[ln] = f["name"]
++    kept = _tg_strip(text, keep_strings=True)
++    blank = bmap = None
++    for i, line in enumerate(kept.split("\n"), 1):
++        if _TG_SKIP_ANN_RE.search(line):
++            hits.setdefault(("tq/skip-added", owner.get(i) or "檔:" + path, "跳過"), []).append((path, i))
++    nls = None
++    for rx, rule, tag in ((_TG_ASSUME_RE, "tq/skip-added", "跳過:"), (_TG_SNAP_WORDS, "tq/snapshot-changed", "")):
++        span_end, ident = -1, None
++        for m in rx.finditer(kept):
++            if nls is None:
++                nls = [k for k, ch in enumerate(kept) if ch == "\n"]
++                blank = _tg_strip(text)                  # 字串內容換成空白(位置一一對應):字串裡的括號不算進配對
++                bmap = _rg_bracket_map(blank)
++            i = bisect.bisect_left(nls, m.start()) + 1
++            if m.start() >= span_end:             # 落在前一個敘述裡的命中併進那個敘述(巢狀、同一行連寫),總工作量跟長度成正比
++                stmt, span_end = _tg_stmt_at(kept, blank, bmap, m.start())
++                ident = (rule, owner.get(i) or "檔:" + path, tag + stmt)
++            hits.setdefault(ident, []).append((path, i))
++    return hits
++
++
++_TG_STMT_GOES_ON = ("=", ",", "(", "+", "&&", "||")
++_TG_STMT_STOP = re.compile(r"[(\[{)\]};\n]")
++
++
++def _tg_stmt_at(kept, blank, bmap, i):
++    """位置 i 起的那個敘述 → (身分用的敘述字串, 結束位置)。邊界在剝掉字串的文字(blank)上找:左括號照共用的括號對應表
++    (bmap,_rg_bracket_map)整段跳過;深度 0 遇到分號、多出來的右括號,或換行而上一段不像沒寫完(結尾不是 = , ( + && ||、
++    下一行也不是 . ?. && || 開頭)就停;最多看 _TG_MAX_STMT_CHARS 字。身分取留字串的原文,字詞之間的空白壓成一格、標點兩側的空白拿掉
++    (換行重排不算改動,字串常值 "c i" 跟 "ci" 仍不同)。"""
++    end = min(len(blank), i + _TG_MAX_STMT_CHARS)
++    k = i
++    while k < end:
++        m = _TG_STMT_STOP.search(blank, k, end)
++        if not m:
++            k = end
++            break
++        k = m.start()
++        ch = blank[k]
++        if ch in "([{":
++            close = bmap.get(k)
++            k = end if close is None else close + 1
++            continue
++        if ch != "\n":
++            break
++        if blank[i:k].rstrip().endswith(_TG_STMT_GOES_ON) or blank[k + 1:k + 200].lstrip().startswith((".", "?.", "&&", "||")):
++            k += 1
++            continue
++        break
++    k = min(k, end)
++    text = re.sub(r"\s+", " ", kept[i:k]).strip()
++    return re.sub(r"\s*([^\w\s])\s*", r"\1", text), k
++
++
++def _tg_main_hits(text):
++    hits = {}
++    for i, line in enumerate(_tg_strip(text, keep_strings=True).split("\n"), 1):
++        if _TG_SNIFF.search(line):
++            hits.setdefault(("tq/test-env-sniff", "", _tg_norm(line)), []).append(i)
++    return hits
++
++
++def _tg_diff_locs(base, head):
++    """兩邊 {身分: [行號, …]} → [(身分, 第幾個, 行號)]:改動後比改動前多出來的那幾個,行號取改動後排在後面的那幾處。"""
++    out = []
++    for ident, locs in head.items():
++        b = len(base.get(ident, ()))
++        extra = len(locs) - b
++        for k in range(max(0, extra)):
++            out.append((ident, b + k + 1, locs[len(locs) - extra + k]))
++    return out
++
++
++def _tg_timeout_raised(old_lines, new_lines):
++    """改動前、後的各行 → 逾時數字被調大的那幾行(數字換成 # 之後同形的一對,改動後的最大值比較大)。用集合與同形分組,跟行數成正比。"""
++    olds, news = set(old_lines), set(new_lines)
++    gone = {}
++    for x in old_lines:
++        if x not in news and _TG_TIMEOUT.search(x):
++            nb = [float(v.rstrip("lLfF").replace("_", "")) for v in _TG_NUM.findall(x)]
++            if nb:
++                shape = _TG_NUM.sub("#", x)
++                gone[shape] = min(gone.get(shape, max(nb)), max(nb))
++    out = []
++    for a in new_lines:
++        if a in olds or not _TG_TIMEOUT.search(a):
++            continue
++        shape = _TG_NUM.sub("#", a)
++        na = [float(v.rstrip("lLfF").replace("_", "")) for v in _TG_NUM.findall(a)]
++        if shape in gone and na and max(na) > gone[shape]:
++            out.append(a)
++    return out
++
++
++_TG_WHY = {
++    "tq/skip-added": ("測試被加了跳過或假設條件,紅的測試會變成「略過」而不是失敗", "確認這支測試真的不適用,不是為了讓紅燈消失而跳過"),
++    "tq/test-removed": ("改動前有的測試函式不見了", "確認是需求拿掉了這個行為,不是為了讓紅燈消失而刪測試"),
++    "tq/assert-weakened": ("同一支測試的斷言變少、相等比對變少,或實際值被換成常值", "確認新斷言仍檢查需求要的結果"),
++    "tq/expected-changed": ("同一支測試的預期值被改了", "確認新預期值來自需求或人工確認,不是照程式目前的輸出改"),
++    "tq/no-assertion": ("新增或本體有變的測試沒有任何斷言", "補上檢查結果的斷言;只呼叫不檢查的測試永遠綠"),
++    "tq/catch-no-fail": ("例外被 catch 或 runCatching 接住,不丟例外或斷言失敗時測試照樣綠", "改用 assertThrows/assertFailsWith,或在 try 結尾加 fail()"),
++    "tq/timeout-raised": ("測試逾時被調大", "確認不是用放寬逾時掩蓋變慢或卡住"),
++    "tq/snapshot-changed": ("截圖基準圖或比對門檻有變", "看新舊比較圖,確認畫面變化是需求要的"),
++    "tq/test-env-sniff": ("正式程式碼在偵測自己是不是跑在測試裡", "確認不是在測試時走另一條路讓測試過"),
++    "tq/too-large": ("檔案超過比對工具的上限,超過的部分沒有比對", "人工看這支檔的改動,或拆小"),
++    "tq/unparsable": ("剝完字串與註解後括號配不平或含 NUL,函式級規則判不了", "人工看這支檔的改動"),
++    "tq/unreadable": ("這支檔從 git 讀不出來(含檔名不是 UTF-8、含換行),沒有比對", "人工看這支檔的改動"),
++}
++
++
++def _tg_cand(rule, file, line, ident, nth=1, side="head", extra=""):
++    """一條候選。檔名與原因裡的外來字串(檔名、測試名、正式程式的那一行)印出前清控制字元(換行、ESC、雙向覆寫),
++    擋下訊息是給 AI 讀的,不讓外來文字偽造出「接下來」這類段落;指紋用清過的檔名(只有怪檔名才會不同)。"""
++    import hashlib
++    why, verify = _TG_WHY[rule]
++    file = _out_clean(file, 500)
++    key = hashlib.sha256("\x00".join([rule, file, ident, str(nth)]).encode("utf-8", "replace")).hexdigest()[:16]
++    return {"rule": rule, "file": file, "line": line, "side": side, "key": key, "ident": ident,
++            "message": why + (f"({_out_clean(extra, 300)})" if extra else ""), "verify": verify}
++
++
++def _tg_changes(root, base, head, deadline=None):
++    """改了哪些檔(含刪除與改名)→ [(狀態, 改動前路徑, 改動後路徑, 改動後物件編號, 檔名是不是合法 UTF-8)];git 失敗回 None。
++    --raw 帶物件編號(基準圖指紋綁它);輸出照位元組讀,檔名不是 UTF-8 的照實標出來,不讓替換字元把它變成讀不到的空檔。"""
++    r = _lens_git_dl(root, "diff", "--raw", "-z", "-M", "--no-abbrev", "--no-ext-diff", "--no-textconv", base, head,
++                     deadline=deadline, binary=True)
++    if r is None or r.returncode != 0:
++        return None
++    parts = r.stdout.split(b"\0")
++    out, i = [], 0
++    while i < len(parts) and parts[i].startswith(b":"):
++        meta = parts[i].decode("ascii", "replace").split()
++        st, new_sha = meta[4][:1], meta[3]
++        n_paths = 2 if st in "RC" else 1
++        paths, good = [], True
++        for rp in parts[i + 1:i + 1 + n_paths]:
++            try:
++                paths.append(rp.decode("utf-8"))
++            except UnicodeDecodeError:
++                paths.append(rp.decode("utf-8", "replace"))
++                good = False
++        if n_paths == 2:
++            old, new = paths
++        else:
++            old, new = (None if st == "A" else paths[0]), (None if st == "D" else paths[0])
++        out.append((st, old, new, None if st == "D" else new_sha, good))
++        i += 1 + n_paths
++    return out
++
++
++def _tg_read(root, base, head, items, deadline=None):
++    """[(改動前路徑, 改動後路徑)] → {(side, path): 文字 | 'TOOLARGE' | 'UNREADABLE'}(那一端沒有就不在表裡)。
++    批次讀(_nodehome_cat_blobs_capped:先問大小再讀內容),單檔上限、總量上限都在這一層;不是 UTF-8 的內容照換字元讀。
++    批次讀取本身失敗回 None。測試檔的單行上限在 _tg_analyze(要知道檔類,只套測試檔)。"""
++    specs, slots = [], []
++    for old, new in items:
++        for side, rev, path in (("base", base, old), ("head", head, new)):
++            if path and rev != _EMPTY_TREE_SHA:
++                specs.append(f"{rev}:{path}")
++                slots.append((side, path))
++    res = {}
++    if not specs:
++        return res
++    sizes = _nodehome_cat_sizes(root, specs, max(1, int(_git_timeout(deadline, cap=60))))
++    blobs = None
++    if sizes is not None:
++        blobs = _nodehome_cat_blobs_capped(root, specs, _TG_MAX_BYTES, deadline=deadline, sizes=sizes, max_total_bytes=_TG_MAX_TOTAL)
++    if sizes is None or blobs is None:
++        return None                 # 批次讀取本身失敗(逾時或 git 跑不動):整次比對沒跑完,由呼叫端記成錯誤
++    for i, slot in enumerate(slots):
++        if sizes[i] is None:
++            res[slot] = "UNREADABLE"
++        elif sizes[i] > _TG_MAX_BYTES or blobs[i] is None:
++            res[slot] = "TOOLARGE"
++        else:
++            t = blobs[i].decode("utf-8", "replace")
++            res[slot] = "TOOLARGE" if t.count("\n") >= _TG_MAX_LINES else t
++    return res
++
++
++def _tg_start(root, base, head, deadline=None):
++    """比對的起點:跟主線的分岔點(_lens_default_base,Room 守衛手動跑用的同一支)找得到、而且不是終點本身就用它——
++    合過主線之後推送,主線的改動不會算到推送者頭上;同一條分支先前推送已經處理過的候選,不是改掉就是已在放行檔,不會重複擋。
++    找不到(沒有主線、推的就是主線)照給的起點。"""
++    # 遠端主線優先:本機 main 上還沒推出去的提交不能當成已在主線(回頭重讀的分岔點也是同一個理由不收本機主線);沒有遠端主線才用本機的
++    fork = _lens_default_base(root, tip=head, include_local=False, deadline=deadline) \
++        or _lens_default_base(root, tip=head, include_local=True, deadline=deadline)
++    if fork and fork != _lens_full_sha(root, head):
++        return fork
++    return base
++
++
++def _tg_analyze(root, base, head, deadline=None):
++    """一段範圍的作弊候選 → (候選清單, 錯誤訊息或 None)。git 算不出改動清單回 (None, 訊息);超過截止時間丟 TimeoutError(呼叫端記成沒跑完)。"""
++    ch = _tg_changes(root, base, head, deadline)
++    if ch is None:
++        return None, "git 算不出這次改了哪些檔"
++    cands, rows, images = _tg_sort_changes(ch)
++    text = _tg_read(root, base, head, [(o, n) for _k, o, n, _s in rows], deadline)
++    if text is None:
++        return None, "git 讀不出改動的內容(逾時或 git 跑不動)"
++    test_files, base_hits, head_hits = [], {}, {}
++    per_kind = {"main": _tg_main_cands}
++    for kind, old, new, new_sha in rows:
++        if deadline is not None and _git_timeout(deadline) <= 0:
++            raise TimeoutError("比對工具超過截止時間")
++        path = new or old
++        b = text.get(("base", old), "") if old else ""
++        h = text.get(("head", new), "") if new else ""
++        if "TOOLARGE" in (b, h) or "UNREADABLE" in (b, h):
++            cands.append(_tg_cand("tq/too-large", path, 0, f"{path}:{new_sha or 'deleted'}") if "TOOLARGE" in (b, h)
++                         else _tg_cand("tq/unreadable", path, 0, path))
++        elif kind == "test":
++            if _tg_has_long_line(b) or _tg_has_long_line(h):
++                # 超長的行(壓縮資料、產生的程式、病態輸入)抹成空行再比:同檔其他改動照樣逐條列,那幾行要人另外看
++                cands.append(_tg_cand("tq/too-large", path, 0, f"{path}:{new_sha or 'deleted'}:line",
++                                      extra=f"有一行超過 {_TG_MAX_LINE_CHARS} 字,那幾行沒比對,其餘照比"))
++                b, h = _tg_blank_long_lines(b), _tg_blank_long_lines(h)
++            cands += _tg_test_file(test_files, base_hits, head_hits, old, new, new_sha, b, h)
++        else:
++            cands += per_kind[kind](path, b, h)
++    cands += _tg_test_rules(test_files, base_hits, head_hits, deadline)
++    return cands + _tg_image_cands(images), None
++
++
++def _tg_has_long_line(text):
++    """測試檔有沒有一行超過 _TG_MAX_LINE_CHARS 字(行尾的 \r 不算)。只測試檔要:函式切法與斷言判讀在單行上有平方級的風險,
++    正式程式、建置檔、CI 是逐行線性的判讀,不設這道上限。"""
++    return any(len(x) - x.endswith("\r") > _TG_MAX_LINE_CHARS for x in text.split("\n"))
++
++
++def _tg_blank_long_lines(text):
++    """超過 _TG_MAX_LINE_CHARS 字的行換成空行(換行照留、行號不變)。"""
++    return "\n".join("" if len(x) - x.endswith("\r") > _TG_MAX_LINE_CHARS else x for x in text.split("\n"))
++
++
++def _tg_sort_changes(ch):
++    """改動清單 → (直接成候選的怪檔名, 要讀內容比的 [(種類, 改動前路徑, 改動後路徑, 物件編號)], 按目錄分的基準圖)。"""
++    cands, rows, images = [], [], {}
++    for st, old, new, new_sha, good in ch:
++        kind = _tg_kinds(old, new)
++        if kind is None:
++            continue
++        path = new or old
++        if not good or "\n" in path or (old and "\n" in old):
++            cands.append(_tg_cand("tq/unreadable", path, 0, path))
++        elif kind == "image":
++            d = path.rsplit("/", 1)[0] if "/" in path else "."
++            images.setdefault(d, []).append(f"{st}:{old}:{new}:{new_sha}")
++        else:
++            rows.append((kind, old, new, new_sha))
++    return cands, rows, images
++
++
++def _tg_test_file(test_files, base_hits, head_hits, old, new, new_sha, b, h):
++    """一支測試檔:切出兩端的測試函式、累計跳過與門檻字樣的次數(收進 test_files 與兩張次數表,規則在 _tg_test_rules 一起判)
++    → 這支檔直接成的候選(配不平時的 tq/unparsable)。整支刪掉或改名成非測試檔時,候選記在原本那支測試檔。"""
++    path = new if (new and _tg_kind(new) == "test") else old
++    fb, okb = _tg_functions(b, (old or "").endswith(".java")) if (old and _tg_kind(old) == "test") else ({}, True)
++    fh, okh = _tg_functions(h, (new or "").endswith(".java")) if (new and _tg_kind(new) == "test") else ({}, True)
++    if not (okb and okh):
++        return [_tg_cand("tq/unparsable", path, 0, f"{path}:{new_sha or 'deleted'}")]
++    kt = bool(_TG_MSG_LAST_RE.search(h + "\n" + b))   # 斷言訊息在最後(kotlin.test、JUnit 5)
++    test_files.append((path, b, h, fb, fh, kt))
++    same = new if (old and new and _tg_kind(new) == "test") else None   # 改名或搬家:兩邊用新路徑,類別層級的註記不因換路徑算新增
++    for src, dst in ((_tg_test_hits(b, fb, same or old or path), base_hits), (_tg_test_hits(h, fh, same or new or path), head_hits)):
++        for ident, locs in src.items():
++            dst.setdefault(ident, []).extend(locs)
++    return []
++
++
++def _tg_main_cands(path, b, h):
++    """一支正式程式檔的候選:新增偵測測試環境的字樣。"""
++    return [_tg_cand(rule, path, ln, line, nth) for (rule, _o, line), nth, ln in _tg_diff_locs(_tg_main_hits(b), _tg_main_hits(h))]
++
++
++def _tg_image_cands(images):
++    """按目錄分的基準圖 → 每個目錄一條 tq/snapshot-changed(指紋綁那批圖的路徑與物件編號)。"""
++    import hashlib
++    out = []
++    for d, items in sorted(images.items()):
++        sig = hashlib.sha256("\n".join(sorted(items)).encode("utf-8", "replace")).hexdigest()[:16]
++        out.append(_tg_cand("tq/snapshot-changed", d, 0, d + ":" + sig, extra=f"{len(items)} 張基準圖"))
++    return out
++
++
++def _tg_test_rules(test_files, base_hits, head_hits, deadline=None):
++    """測試檔那幾條規則一起判(刪測試、加跳過、斷言變弱、預期值被改…);每支函式判之前看一次截止時間,超過丟 TimeoutError。"""
++    renamed, moved_from = _tg_renames(test_files)
++    fns_base = {(p, k): f for p, _b, _h, fb, _fh, _kt in test_files for k, f in fb.items()}
++    out = _tg_hit_cands(test_files, base_hits, head_hits)
++    for path, _b, _h, fb, fh, kt in test_files:
++        gone = sorted(k for k in fb if k not in fh and (path, k) not in renamed)
++        if gone:
++            out.append(_tg_cand("tq/test-removed", path, fb[gone[0]]["start"], ",".join(gone), side="base",
++                                extra="、".join(gone[:5]) + (f" 等 {len(gone)} 支" if len(gone) > 5 else "")))
++        for k, f in fh.items():
++            if deadline is not None and _git_timeout(deadline) <= 0:
++                raise TimeoutError("比對工具超過截止時間")
++            prev = fb.get(k) if k in fb else fns_base.get(moved_from.get((path, k)))
++            out += _tg_fn_cands(path, k, f, prev, kt)
++    return out
++
++
++def _tg_renames(test_files):
++    """本體簽名一樣、一邊不見一邊新出現的測試函式一對一配成改名或搬家 → (被認成改名的 {(檔, 函式鍵)}, {新(檔, 鍵): 舊(檔, 鍵)})。
++    兩支一樣的刪掉、只加回一支,另一支照樣算刪除。"""
++    gone_by_sig, came_by_sig = {}, {}
++    for path, _b, _h, fb, fh, _kt in test_files:
++        for k, f in fb.items():
++            if k not in fh and f["sig"]:
++                gone_by_sig.setdefault(f["sig"], []).append((path, k))
++        for k, f in fh.items():
++            if k not in fb and f["sig"]:
++                came_by_sig.setdefault(f["sig"], []).append((path, k))
++    renamed, moved_from = set(), {}
++    for sig, gone in gone_by_sig.items():
++        for g, c in zip(gone, came_by_sig.get(sig, [])):
++            renamed.add(g)
++            moved_from[c] = g
++    return renamed, moved_from
++
++
++def _tg_hit_cands(test_files, base_hits, head_hits):
++    """跳過標記與比對門檻字樣比改動前多出來的 → 候選,記在多出來的那一處:同一個身分在各支檔的出現次數跟改動前比,
++    多出來的那支檔優先(搬檔的不算),再取那支檔裡排後面的那幾處。"""
++    out = []
++    for ident, locs in head_hits.items():
++        before = base_hits.get(ident, [])
++        extra = len(locs) - len(before)
++        if extra <= 0:
++            continue
++        left = {}
++        for p, _ln in before:
++            left[p] = left.get(p, 0) + 1
++        fresh = []
++        for p, ln in locs:
++            if left.get(p, 0) > 0:
++                left[p] -= 1
++            else:
++                fresh.append((p, ln))
++        fresh_set = set(fresh)
++        picks = (fresh + [x for x in reversed(locs) if x not in fresh_set])[:extra]
++        rule, owner, kind = ident
++        for k, (p, ln) in enumerate(picks):
++            out.append(_tg_cand(rule, p, ln, f"{owner}\x00{kind}", len(before) + k + 1))
++    return out
++
++
++def _tg_fn_cands(path, k, f, prev, kt):
++    """一支新增或本體有變的測試函式 → 候選:沒斷言、catch 沒 fail、新加 expected=、斷言變弱、預期值被改、逾時調大。
++    prev 是改動前那一支(新寫的、或找不到的是 None);本體與註記都沒變的不判。"""
++    if prev is not None and prev["sig"] == f["sig"] and prev["annot"] == f["annot"]:
++        return []
++    out = []
++    if not _tg_has_assertion(f):
++        out.append(_tg_cand("tq/no-assertion", path, f["start"], k))
++    if _tg_catch_no_fail(f):
++        out.append(_tg_cand("tq/catch-no-fail", path, f["start"], k))
++    if prev is None:
++        return out
++    if _TG_EXPECTED_ANN.search(f["annot"]) and not _TG_EXPECTED_ANN.search(prev["annot"]):
++        out.append(_tg_cand("tq/skip-added", path, f["start"], k + "\x00expected="))
++    so, sn = _tg_statements(prev), _tg_statements(f)
++    co, cn = sum(_tg_const_stmt(x, kt) for x in so), sum(_tg_const_stmt(x, kt) for x in sn)
++    if len(sn) < len(so) or _tg_strong(sn) < _tg_strong(so) or cn > co:
++        out.append(_tg_cand("tq/assert-weakened", path, f["start"],
++                            f"{k}\x00{len(so)}/{_tg_strong(so)}/{co}->{len(sn)}/{_tg_strong(sn)}/{cn}",
++                            extra=f"斷言 {len(so)}→{len(sn)},相等比對 {_tg_strong(so)}→{_tg_strong(sn)},實際值是常值的 {co}→{cn}"))
++    seen = {}
++    for a, c in _tg_pairs(so, sn, kt):
++        if _tg_expected_changed(a, c, kt):
++            seen[c] = seen.get(c, 0) + 1          # 同一條改動出現第二次,指紋不同(放行一條不會順帶放掉另一條)
++            out.append(_tg_cand("tq/expected-changed", path, f["start"], f"{k}\x00{c}", seen[c]))
++    ol = [_tg_norm(x) for x in (prev["annot"] + "\n" + prev["raw"]).split("\n")]
++    nl = [_tg_norm(x) for x in (f["annot"] + "\n" + f["raw"]).split("\n")]
++    out += [_tg_cand("tq/timeout-raised", path, f["start"], f"{k}\x00{line}") for line in _tg_timeout_raised(ol, nl)]
++    return out
