+++def _tg_head_id(norm):
+++    """區塊開頭當身分用的字串:短的照原文,超過 200 字的換成前 120 字加摘要(候選身分不複製整條很長的開頭)。"""
+++    if len(norm) <= 200:
+++        return norm
+++    import hashlib
+++    return norm[:120] + "…#" + hashlib.sha1(norm.encode("utf-8", "replace")).hexdigest()[:12]
