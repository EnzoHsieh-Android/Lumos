+++
+++_TG_GENERIC_MAX = 400
+++_TG_CLASS_STOP = re.compile(r"[{(\n]")
+++_TG_SUPERTYPE = re.compile(r"(?:extends|implements|where)\b")
+++
+++
+++def _tg_next_stop(stripped, j, nxt):
+++    """j 之後第一個 `{`、`(`、換行的位置(沒有就是文字長度)。nxt=[查過的起點, 答案]:j 落在這段區間裡答案不變,不重查。"""
+++    if nxt[0] <= j <= nxt[1]:
+++        return nxt[1]
+++    m = _TG_CLASS_STOP.search(stripped, j)
+++    nxt[0], nxt[1] = j, (m.start() if m else len(stripped))
+++    return nxt[1]
+++
+++
+++_TG_MODIFIERS = re.compile(r"\b(?:public|private|protected|internal|open|override|final|suspend|static|abstract|inline|operator|infix"
+++                           r"|tailrec|external|actual|expect|synchronized|native|strictfp|default)\b")
+++
