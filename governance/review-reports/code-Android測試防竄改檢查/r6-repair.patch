+++++_TG_IN_TEST_BLOCK = (re.compile(r"\benabled" + _TG_SET + r"false\b|\bonlyIf\s*\{\s*false\s*\}"),
+++++                     re.compile(r"\bexclude\s*\(?\s*[\"'][^\"']*Test"),
+++++                     re.compile(r"\bignoreFailures" + _TG_SET + r"true\b"))
