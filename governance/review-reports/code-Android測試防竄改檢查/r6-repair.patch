++++def _tg_ci_blocks(indent, gradle):
++++    """每一行 → (它所屬區塊裡有沒有呼叫 Gradle 的行, 它的區塊開頭行索引或 -1)。區塊 = 縮排比它淺的最近一行開頭、到下一個同層;
++++    用堆疊一趟算完,跟行數成正比(區塊開頭也從這裡取,不逐行往回掃)。"""
++++    n = len(indent)
++++    parent, stack = [-1] * n, []
++++    for i in range(n):
++++        if indent[i] is None:
++++            continue
++++        while stack and indent[stack[-1]] >= indent[i]:
++++            stack.pop()
++++        parent[i] = stack[-1] if stack else -1
++++        stack.append(i)
++++    end, stack = [n] * n, []
++++    for i in range(n):
++++        if indent[i] is None:
++++            continue
++++        while stack and indent[stack[-1]] >= indent[i]:
++++            end[stack.pop()] = i
++++        stack.append(i)
++++    pref = [0]
++++    for g in gradle:
++++        pref.append(pref[-1] + (1 if g else 0))
++++    return [parent[i] >= 0 and pref[end[parent[i]]] - pref[parent[i]] > 0 for i in range(n)], parent
++++
