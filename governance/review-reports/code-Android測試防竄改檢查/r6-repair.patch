+++++        annot = "\n".join(x for x in (_tg_norm(y) for y in [*klines[s - 1:decl], pre]) if x)
+++++        out[key] = {"start": s, "end": e, "decl": decl + 1, "name": name, "annot": annot,
+++++                    "raw": "\n".join(lines[decl:e]), "mbody": seg_s,
+++++                    "sig": re.sub(r"\s+", "", seg_k[close + 1:]) if close >= 0 else ""}
