+++def _tg_stmt_at(t, i):
+++    """位置 i 起的那個敘述 → (去掉全部空白的敘述, 結束位置):括號配平、跨行照接;深度 0 時遇到分號、多出來的右括號,或換行而上一段不像沒寫完
+++    (結尾不是 = , ( + && ||、下一行也不是 . ?. && || 開頭)就停;最多看 _TG_STMT_MAX 字。"""
+++    depth, k, end = 0, i, min(len(t), i + _TG_STMT_MAX)
+++    while k < end:
+++        ch = t[k]
+++        if ch in "([{":
+++            depth += 1
+++        elif ch in ")]}":
+++            depth -= 1
+++            if depth < 0:
+++                break
+++        elif depth == 0 and ch == ";":
+++            break
+++        elif depth == 0 and ch == "\n":
+++            if not (t[i:k].rstrip().endswith(_TG_STMT_GOES_ON) or t[k + 1:k + 200].lstrip().startswith((".", "?.", "&&", "||"))):
