+++def _tg_block_heads(lines):
+++    """剝過的各行 → 每一行的區塊情境 (最內層區塊開頭的身分, 外層有沒有測試任務區塊, 外層有沒有靜態檢查外掛區塊)。
+++    區塊開頭的判斷在開區塊那一刻算一次、存在堆疊上,內層每一行不再重掃開頭(很長的開頭配很多內層行也跟長度成正比)。
+++    `tasks.matching { it.name.contains("UnitTest") }.configureEach {`(一行或換行寫):剛關掉的區塊裡有點名測試任務、
+++    同一行接著開的區塊算測試任務區塊;`tasks.register("ci") {` 換行 `dependsOn("testX")` 不會讓 ci 這個區塊變成測試區塊。"""
+++    out, stack, closed_named = [], [], False      # stack 元素:[開頭身分, 測試區塊, 外掛區塊, 內層有一行點名測試任務]
+++    for line in lines:
+++        top = stack[-1] if stack else None
+++        out.append((top[0], top[1], top[2]) if top else ("", False, False))
+++        named = _tg_names_test_task(line)
+++        if top is not None and named:
+++            top[3] = True
+++        if "{" not in line and "}" not in line:
+++            continue
+++        norm = _tg_norm(line)
+++        pre = norm.split("{", 1)[0]
+++        head_test = bool(_TG_TEST_BLOCK.search(pre) or _tg_names_test_task(pre))
+++        head_plugin = bool(_TG_NOT_TEST_PLUGIN.search(pre)) and not head_test
+++        hid = _tg_head_id(norm)
+++        after_close = False                       # 同一行裡剛關掉一個區塊(`}.configureEach {`、`… }.configureEach {`)
+++        for ch in line:
+++            if ch == "{":
+++                par = stack[-1] if stack else None
+++                in_test = head_test or bool(par and par[1]) or (after_close and closed_named)
+++                stack.append([hid, in_test, (head_plugin or bool(par and par[2])) and not head_test, named and not head_test])
