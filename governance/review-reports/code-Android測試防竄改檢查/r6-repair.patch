++++def _tg_retry_ok(root, head, deadline=None):
++++    """終點那一版有沒有任何建置檔把 failOnPassedAfterRetry 設成 true(重試後才過要算失敗)。git grep 只用固定字串粗篩,
++++    設成 true 的判法用 Python 的 _TG_SET 句式(同 _TG_BUILD_RES 那條),行註解不算。"""
++++    r = _lens_git_dl(root, "grep", "-h", "-I", "-F", "failOnPassedAfterRetry", head, "--", "*.gradle", "*.gradle.kts", "buildSrc/*",
++++                     "build-logic/*", deadline=deadline)
++++    if r is None or r.returncode != 0:
++++        return False
++++    pat = re.compile(r"\bfailOnPassedAfterRetry" + _TG_SET + r"true\b")
++++    return any(pat.search(ln.split("//", 1)[0]) for ln in r.stdout.splitlines())
