+++def _tg_retry_ok(root, head, deadline=None):
+++    """終點那一版有沒有任何建置檔把 failOnPassedAfterRetry 設成 true(重試後才過要算失敗)。git grep 只用固定字串找出有提到的檔
+++    (最多 50 支),逐支讀內容用 _tg_strip 剝註解(行註解與區塊註解都不算)、留字串,再用 _TG_SET 句式判。"""
+++    r = _lens_git_dl(root, "grep", "-l", "-I", "-F", "failOnPassedAfterRetry", head, "--", "*.gradle", "*.gradle.kts", "buildSrc/*",
+++                     "build-logic/*", deadline=deadline)
+++    if r is None or r.returncode != 0:
+++        return False
+++    pat = re.compile(r"\bfailOnPassedAfterRetry" + _TG_SET + r"true\b")
+++    for ref in r.stdout.splitlines()[:50]:            # git grep -l 對提交印「提交:路徑」
+++        got = _lens_git_dl(root, "show", ref, deadline=deadline)
+++        if got is not None and got.returncode == 0 and pat.search(_tg_strip(got.stdout, keep_strings=True)):
+++            return True
+++    return False
+++
