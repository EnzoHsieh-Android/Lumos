+++        ignore_fail = _TG_IGNORE_FAIL.search(joined) and not ((ctx_plugin and not line_test) or line_plugin)
+++        if ignore_fail or any(r.search(joined) for r in _TG_BUILD_RES) or (in_test and any(r.search(joined) for r in _TG_IN_TEST_BLOCK)):
+++            hits.setdefault(("tq/build-config", head, n), []).append(i + 1)
+++        if _TG_RETRY_RE.search(line):
+++            hits.setdefault(("tq/build-config:retry", head, n), []).append(i + 1)
+++        if _TG_DEP_TEST.search(line):
+++            hits.setdefault(("tq/build-config:dep", head, n), []).append(i + 1)
