+++# `gradle ` 前面不能緊接 . / 或字:`app/build.gradle || echo` 是檔名,不是在叫 Gradle
+++_TG_GRADLE_CALL = re.compile(r"(?:^|[\s;&|(:])(?:\./)?gradlew?(?:\.bat)?\b|(?<![\w./-])gradle\s|\bgradle-build-action\b|\bgradle/actions\b"
+++                             r"|\bgradle-runner\b|^\s*-?\s*(?:arguments|gradle_task)\s*:")
+++# -x test、-xtest、--exclude-task test、--exclude-task=test(Gradle 都收)
+++_TG_CI_X = re.compile(r"(?:^|\s)(?:-x\s*|--exclude-task(?:\s+|=))[\"']?:?[\w:.-]*(?:test|check)[\w:.-]*", re.I)
