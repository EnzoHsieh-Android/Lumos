+++        seg_k = "\n".join(klines[decl:e])
+++        p = seg_s.find("(", _TG_NAME_RE.search(lines[decl]).start())
+++        close = _rg_bracket_map(seg_s).get(p, -1) if p >= 0 else -1
+++        # 註記:宣告行以上的註記行加上宣告行裡名字之前那段(`@Test(expected = …) fun x()` 寫在同一行);剝註解、壓空白,
