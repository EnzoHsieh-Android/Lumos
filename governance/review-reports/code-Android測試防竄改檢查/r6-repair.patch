+++++def _tg_ci_lines(text):
+++++    """CI 檔 → [(行號, 合併續行後的指令文字)]:剝 `#` 註解(不走 C 式剝法:`https://` 不是註解),行尾 `\\` 的續行併進同一行。"""
+++++    out, buf, start = [], "", None
+++++    for i, line in enumerate(text.split("\n"), 1):
+++++        code = "" if re.match(r"^\s*#", line) else _ci_strip_comment(line)
+++++        if start is None:
+++++            start = i
+++++        if code.rstrip().endswith("\\"):
+++++            buf += code.rstrip()[:-1] + " "
+++++            continue
+++++        out.append((start, buf + code))
+++++        buf, start = "", None
+++++    if buf:
+++++        out.append((start, buf))
+++++    return out
+++++
+++++
+++++def _tg_ci_hits(text):
+++++    """CI 檔 → 次數表。呼叫 Gradle 的指令看 -x、|| true;呼叫的測試任務以任務名記(同一行加旗標、接管線都不算拿掉);
+++++    放寬鍵看所屬區塊(縮排比它淺的最近一行開頭、到下一個同層)裡有沒有 Gradle 呼叫——步驟層與工作層(GitHub、GitLab 的 job)都涵蓋。"""
+++++    hits = {}
+++++    rows = _tg_ci_lines(text)
+++++    indent = [(len(c) - len(c.lstrip())) if c.strip() else None for _n, c in rows]
+++++    gradle = [bool(_TG_GRADLE_CALL.search(c)) for _n, c in rows]
+++++    block = _tg_ci_blocks(indent, gradle)
+++++    for idx, (_n, code) in enumerate(rows):
+++++        if not code.strip():
+++++            continue
+++++        if gradle[idx] and (_TG_CI_X.search(code) or _TG_CI_TRUE.search(code)):
+++++            _tg_count(hits, ("tq/ci-config", _tg_ci_head(rows, indent, idx), _tg_norm(code)))
+++++        if gradle[idx]:
+++++            after = re.split(r"gradlew?(?:\.bat)?|arguments\s*:|gradle_task\s*:", code, maxsplit=1)[-1]
+++++            for task in _TG_CI_TEST_TASK.findall(re.split(r"\s(?:-x|--exclude-task)\s+\S+|[|;&]", after)[0] if after else ""):
+++++                _tg_count(hits, ("tq/ci-config:test-call", "", task))
+++++        if _TG_CI_KEYS.match(code) and block[idx]:
+++++            _tg_count(hits, ("tq/ci-config", _tg_ci_head(rows, indent, idx), _tg_norm(code)))
+++++    return hits
+++++
+++++
+++++def _tg_ci_blocks(indent, gradle):
+++++    """每一行 → 它所屬區塊(縮排比它淺的最近一行開頭、到下一個同層)裡有沒有呼叫 Gradle 的行。用堆疊一趟算完,跟行數成正比。"""
+++++    n = len(indent)
+++++    parent, stack = [-1] * n, []
+++++    for i in range(n):
+++++        if indent[i] is None:
+++++            continue
+++++        while stack and indent[stack[-1]] >= indent[i]:
+++++            stack.pop()
+++++        parent[i] = stack[-1] if stack else -1
+++++        stack.append(i)
+++++    end, stack = [n] * n, []
+++++    for i in range(n):
+++++        if indent[i] is None:
+++++            continue
+++++        while stack and indent[stack[-1]] >= indent[i]:
+++++            end[stack.pop()] = i
+++++        stack.append(i)
+++++    pref = [0]
+++++    for g in gradle:
+++++        pref.append(pref[-1] + (1 if g else 0))
+++++    return [parent[i] >= 0 and pref[end[parent[i]]] - pref[parent[i]] > 0 for i in range(n)]
+++++
+++++
+++++def _tg_ci_head(rows, indent, idx):
+++++    """CI 一行 → 所屬區塊的開頭(縮排比它淺的最近一行,壓空白);身分帶它,不同工作裡同樣的指令不會互相抵銷。"""
+++++    me, p = indent[idx], idx - 1
+++++    while p >= 0 and (indent[p] is None or indent[p] >= me):
+++++        p -= 1
+++++    return _tg_norm(rows[p][1]) if p >= 0 else ""
+++++
+++++
+++++def _tg_main_hits(text):
+++++    hits = {}
+++++    for line in _tg_strip(text, keep_strings=True).split("\n"):
+++++        if _TG_SNIFF.search(line):
+++++            _tg_count(hits, ("tq/test-env-sniff", "", _tg_norm(line)))
+++++    return hits
+++++
+++++
+++++def _tg_diff_hits(base, head):
+++++    """兩邊次數表 → [(身分, 第幾個)]:改動後比改動前多出來的那幾個(算次數不算有無)。"""
+++++    out = []
+++++    for ident, n in head.items():
+++++        b = base.get(ident, 0)
+++++        out.extend((ident, b + k + 1) for k in range(n - b))
+++++    return out
+++++
+++++
+++++def _tg_timeout_raised(old_lines, new_lines):
+++++    gone = [s for s in old_lines if s not in new_lines and _TG_TIMEOUT.search(s)]
+++++    came = [s for s in new_lines if s not in old_lines and _TG_TIMEOUT.search(s)]
+++++    out = []
+++++    for a in came:
+++++        for b in gone:
+++++            if _TG_NUM.sub("#", a) == _TG_NUM.sub("#", b):
+++++                na = [float(x.rstrip("lLfF").replace("_", "")) for x in _TG_NUM.findall(a)]
+++++                nb = [float(x.rstrip("lLfF").replace("_", "")) for x in _TG_NUM.findall(b)]
+++++                if na and nb and max(na) > max(nb):
+++++                    out.append(a)
+++++                    break
+++++    return out
+++++
