+++def _tg_ci_hits(text):
+++    """CI 檔 → {身分: [行號, …]}。呼叫 Gradle 的指令看 -x、|| true;呼叫的測試任務以任務名記(_tg_ci_test_tasks,加旗標、接管線、
+++    -x 寫在前面都不影響);放寬鍵看所屬區塊(縮排比它淺的最近一行開頭、到下一個同層)裡有沒有 Gradle 呼叫。"""
+++    hits = {}
+++    rows = _tg_ci_lines(text)
+++    indent = [(len(c) - len(c.lstrip())) if c.strip() else None for _n, c in rows]
+++    gradle = [bool(_TG_GRADLE_CALL.search(c)) for _n, c in rows]
+++    block, parent = _tg_ci_blocks(indent, gradle)
+++    heads = {}
+++
+++    def head(idx):
+++        """所屬區塊開頭的身分,每個開頭只正規化一次(續行可以把開頭併成很長的一條)。"""
+++        p = parent[idx]
+++        if p < 0:
+++            return ""
+++        if p not in heads:
+++            heads[p] = _tg_head_id(_tg_norm(rows[p][1]))
+++        return heads[p]
+++    for idx, (ln, code) in enumerate(rows):
+++        if not code.strip():
+++            continue
+++        if gradle[idx] and (_TG_CI_X.search(code) or _TG_CI_TRUE.search(code)):
+++            hits.setdefault(("tq/ci-config", head(idx), _tg_head_id(_tg_norm(code))), []).append(ln)
+++        if gradle[idx]:
+++            for task in _tg_ci_test_tasks(code):
+++                hits.setdefault(("tq/ci-config:test-call", "", task), []).append(ln)
+++        if _TG_CI_KEYS.match(code) and block[idx]:
+++            hits.setdefault(("tq/ci-config", head(idx), _tg_head_id(_tg_norm(code))), []).append(ln)
+++    return hits
