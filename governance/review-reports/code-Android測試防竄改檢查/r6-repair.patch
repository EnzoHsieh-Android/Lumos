+++
+++_TG_CI_ARG_FLAGS = frozenset(("-x", "--exclude-task", "--tests", "-p", "--project-dir", "-b", "--build-file", "-c", "--settings-file",
+++                              "-I", "--init-script", "-g", "--gradle-user-home"))
