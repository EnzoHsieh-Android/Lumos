+++def _tg_ci_test_tasks(code):
+++    """一行 CI 指令 → 它叫 Gradle 跑的測試任務名(含 check)。照 && || ; | & 切段,只看有 Gradle 呼叫的那幾段;
+++    旗標(- 開頭)與 -x、--tests 這類旗標帶的參數不算任務;:app:testDebugUnitTest 取最後一段。"""
+++    out = []
+++    for seg in re.split(r"&&|\|\||[;|&]", code):
+++        m = _TG_GRADLE_CALL.search(seg)
+++        if not m:
+++            continue
+++        skip = False
+++        for tok in re.findall(r"[^\s()<>{}`]+", seg[m.end():]):     # 子殼層、$()、轉向黏著的標點不算進任務名
+++            if skip:
+++                skip = False
+++                continue
+++            if tok in _TG_CI_ARG_FLAGS:
+++                skip = True
+++                continue
+++            if tok.startswith(("-", "$")) or "=" in tok:
+++                continue
+++            name = tok.strip("'\"").rsplit(":", 1)[-1]
+++            if re.fullmatch(r"\w*(?:[Tt]est\w*|check)", name):
+++                out.append(name)
+++    return out
