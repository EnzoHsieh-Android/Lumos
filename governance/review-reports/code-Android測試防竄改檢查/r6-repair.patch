+++++        for ln in range(f["start"], f["end"] + 1):
+++++            owner[ln] = f["name"]
+++++    for i, line in enumerate(_tg_strip(text, keep_strings=True).split("\n"), 1):
+++++        who = owner.get(i) or "檔:" + path
+++++        if _TG_SKIP_RE.search(line):
+++++            hits.setdefault(("tq/skip-added", who, "跳過"), []).append((path, i))
+++++        m = _TG_SNAP_WORDS.search(line)
+++++        if m:
+++++            hits.setdefault(("tq/snapshot-changed", who, m.group(0)), []).append((path, i))
+++++    return hits
+++++
+++++
+++++def _tg_build_hits(text):
+++++    """建置檔 → 次數表。留字串(exclude 的字串、dependsOn("test") 要看內容)、剝註解。"""
+++++    hits = {}
+++++    kept = _tg_strip(text, keep_strings=True).split("\n")
+++++    heads = _tg_block_heads(_tg_strip(text, keep_strings=True))
+++++    for i, line in enumerate(kept):
+++++        head = heads[i] if i < len(heads) else ""
+++++        n = _tg_norm(line)
+++++        in_test = bool(_TG_TEST_BLOCK.search(head) or ("{" in line and _TG_TEST_BLOCK.search(line.split("{")[0]))
+++++                       or _TG_TEST_NAMED_LINE.search(line))
+++++        # 行尾是 = 的把下一行接上來一起判(`enabled =` 換行 `false`);次數照記在這一行
+++++        joined = line + " " + kept[i + 1].strip() if line.rstrip().endswith("=") and i + 1 < len(kept) else line
+++++        if any(r.search(joined) for r in _TG_BUILD_RES) or (in_test and any(r.search(joined) for r in _TG_IN_TEST_BLOCK)):
+++++            _tg_count(hits, ("tq/build-config", head, n))
+++++        if _TG_RETRY_RE.search(line):
+++++            _tg_count(hits, ("tq/build-config:retry", head, n))
+++++        if _TG_DEP_TEST.search(line):
+++++            _tg_count(hits, ("tq/build-config:dep", head, n))
+++++        if _TG_SNAP_WORDS.search(line):
+++++            _tg_count(hits, ("tq/snapshot-changed", head, n))
+++++    return hits
+++++
+++++
+++++_TG_GRADLE_CALL = re.compile(r"(?:^|[\s;&|(:])(?:\./)?gradlew?(?:\.bat)?\b|\bgradle\s|\bgradle-build-action\b|\bgradle/actions\b"
+++++                             r"|\bgradle-runner\b|^\s*-?\s*(?:arguments|gradle_task)\s*:")
+++++_TG_CI_X = re.compile(r"(?:^|\s)(?:-x|--exclude-task)\s+:?[\w:.-]*(?:test|check)[\w:.-]*", re.I)
+++++_TG_CI_TRUE = re.compile(r"\|\|\s*true\s*$")
+++++_TG_CI_KEYS = re.compile(r"^\s*-?\s*(?:continue-on-error\s*:\s*true|allow_failure\s*:\s*true|if\s*:\s*false|continueOnError\s*:\s*true"
+++++                         r"|is_skippable\s*:\s*true|ignore_failure\s*:\s*true)\s*$")
+++++_TG_CI_TEST_TASK = re.compile(r"\b(?:\w*[Tt]est\w*|check)\b")
