+++    if low.endswith(_TG_IMG_EXT):
+++        if _TG_IMG_NOT.search(p) or (_rg_is_test_path(p) and re.search(r"/(?:assets|resources)/", p)):
+++            return None
+++        return "image" if (_rg_is_test_path(p) or _TG_IMG_DIR.search(p)) else None
+++    if (p.startswith(".github/workflows/") and low.endswith((".yml", ".yaml"))) \
+++            or re.match(r"\.github/actions/[^/]+/action\.ya?ml$", p) or name in _TG_CI_NAMES or p == ".circleci/config.yml":
+++        return "ci"
+++    in_build_dir = (p.startswith(("buildSrc/", "build-logic/")) or "/buildSrc/" in p or "/build-logic/" in p) and not _rg_is_test_path(p)
+++    if name.endswith((".gradle", ".gradle.kts")) or name in ("gradle.properties", "robolectric.properties") \
+++            or (in_build_dir and name.endswith((".kt", ".kts"))):
+++        return "build"
+++    if name.endswith((".kt", ".java")):
+++        if _rg_is_test_path(p) or (re.search(r"Tests?\.(?:kt|java)$", name) and "/src/main/" not in "/" + p):
