+++    for m in re.finditer(r"\n|\{|\}|(?<!::)\b(?:class|object|interface)[ \t]+(?:`[^`\n]*`|[A-Za-z_]\w*)", stripped):
+++        tok = m.group(0)
+++        if tok == "\n":
+++            path_at[line] = stack[-1][2] if stack else None
+++            line += 1
+++        elif tok == "{":
+++            depth += 1
+++            if pending is not None:
+++                stack.append((depth, pending, (pending, stack[-1][2] if stack else None)))
+++                pending = None
+++        elif tok == "}":
+++            if stack and stack[-1][0] == depth:
+++                stack.pop()
+++            depth -= 1
+++        elif _tg_class_has_body(stripped, m.end(), bmap, nxt):
+++            pending = tok.split(None, 1)[1].strip("`") or "_"
+++    path_at[line] = stack[-1][2] if stack else None
+++    return path_at
