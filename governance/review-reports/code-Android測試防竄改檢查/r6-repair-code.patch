     if len(full) <= _TG_MAX_PATH_CHARS:
         return full
     import hashlib
     return "#" + hashlib.sha256(full.encode("utf-8", "replace")).hexdigest()[:16] + "…" + full[-(_TG_MAX_PATH_CHARS // 2):]
 
 
