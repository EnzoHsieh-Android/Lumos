+
+def _tg_class_has_body(stripped, j, bmap, nxt=None, memo=None):
+    """類別名之後的位置 j → 這個宣告有沒有大括號本體。跳過泛型(_tg_skip_generic)、建構子與父型別的參數列(可跨行),
+    父型別寫在下一行(行尾 `,`、`:`,或下一行 `:`、`,`、extends、implements、where 開頭;中間夾空行或註解行也算)也接著看,最多 8 段。
+    下一個 `{`、`(`、換行的位置用 nxt 快取(同一段區間的查詢答案相同);一行最後一個非空白字、換行後第一個非空白字用 memo 快取
+    (同一行的類別宣告共用),一行塞很多類別宣告、後面接大段空白也跟長度成正比。"""
+    n = len(stripped)
+    nxt = nxt if nxt is not None else [0, -1]
+    memo = memo if memo is not None else {}
+    while j < n and stripped[j] in " \t":
+        j += 1
+    j = _tg_skip_generic(stripped, j)
+    for _step in range(8):
+        p = _tg_next_stop(stripped, j, nxt)
+        if p >= n:
+            return False
+        if stripped[p] == "{":
+            return True
+        if stripped[p] == "(":
+            j = bmap.get(p, n - 1) + 1
+            continue
+        last = _tg_line_last(stripped, p, memo)
+        if last >= j and stripped[last] in ",:":       # 行尾逗號或冒號:父型別接在下一個非空白字(跳過空行與剝掉的註解行)
+            j = _tg_next_nonspace(stripped, p + 1, memo)
+            continue
+        k = _tg_supertype_next_line(stripped, p + 1, memo)
+        if k is None:
+            return False
+        if k < n and stripped[k] == "{":
+            return True
+        j = k
+    return False
+
+
+def _tg_skip_generic(stripped, j):
+    """j 是 `<` 就跳過配平的角括號(同一行、最多 _TG_MAX_GENERIC_CHARS 字,用 C 層的 find/count);配不平或不是 `<` 回原位。"""
+    if j >= len(stripped) or stripped[j] != "<":
+        return j
+    nl = stripped.find("\n", j)
+    lim = min(len(stripped) if nl < 0 else nl, j + _TG_MAX_GENERIC_CHARS)
+    k, opened, closed = j, 0, 0
+    while True:
+        e = stripped.find(">", k, lim)
+        if e < 0:
+            return j
+        opened += stripped.count("<", k, e + 1)
+        closed += 1
+        k = e + 1
+        if opened == closed:
+            return k
+
+
+def _tg_next_nonspace(stripped, k, memo):
+    """位置 k 起第一個不是空白字(含 tab、CR、換行、FF、VT、全形空白)的位置(沒有就是文字長度);同一個起點只找一次。"""
+    key = ("ws", k)
+    if key not in memo:
+        m = _TG_NONSPACE.search(stripped, k)
+        memo[key] = m.start() if m else len(stripped)
+    return memo[key]
+
+
+def _tg_line_last(stripped, p, memo):
+    """換行位置 p 那一行最後一個不是空白字的位置(整行空白回 -1);同一行只算一次。"""
+    key = ("last", p)
+    if key not in memo:
+        ls = stripped.rfind("\n", 0, p) + 1
+        body = stripped[ls:p].rstrip()
+        memo[key] = ls + len(body) - 1 if body else -1
+    return memo[key]
+
+
+def _tg_supertype_next_line(stripped, k, memo):
+    """換行之後的位置 k → 下一個非空白字的位置,如果它是 `{` 或父型別的續寫(`:`、`,`、extends、implements、where);否則 None。"""
+    n = len(stripped)
+    k = _tg_next_nonspace(stripped, k, memo)
+    if k < n and (stripped[k] in "{:," or _TG_SUPERTYPE.match(stripped, k)):
+        return k
+    return None
+
+
+def _tg_next_stop(stripped, j, nxt):
+    """j 之後第一個 `{`、`(`、換行的位置(沒有就是文字長度)。nxt=[查過的起點, 答案]:j 落在這段區間裡答案不變,不重查。"""
+    if nxt[0] <= j <= nxt[1]:
+        return nxt[1]
+    m = _TG_CLASS_STOP.search(stripped, j)
+    nxt[0], nxt[1] = j, (m.start() if m else len(stripped))
+    return nxt[1]
