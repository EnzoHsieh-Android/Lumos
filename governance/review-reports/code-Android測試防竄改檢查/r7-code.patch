+        return b.strip(), "shouldBe:" + a.strip(), [a.strip()]
+    name, args, chain = _tg_call_parts(stmt)
+    if not name:
+        return None
+    hit = _tg_split_chain(name, args, chain) or _tg_split_named(name, args)
+    if hit:
+        return hit
+    if name in _TG_FIRST_ARG:
+        return _tg_split_first_arg(name, args, kotlin_test)
+    if name == "assertThat" and len(args) == 2:
+        return args[1], repr((name, args[0])), [args[0]]
+    return None
+
+
+def _tg_split_chain(name, args, chain):
+    """串接寫法(assertThat(x).isEqualTo(y)、containsExactly…)→ 同 _tg_split_expected 的三元組或 None。"""
+    for cn, cargs in reversed(chain):
+        if cn in ("isEqualTo", "isSameInstanceAs") or cn.startswith("containsExactly"):
+            rest = (name, tuple(args), tuple((c, tuple(a)) for c, a in chain if c != cn))
+            return ",".join(cargs), repr(rest), list(args)
+    return None
+
+
+def _tg_split_named(name, args):
+    """具名參數 expected = … → 同 _tg_split_expected 的三元組或 None。"""
+    named = [a for a in args if re.match(r"expected\s*=", a)]
+    if not named:
+        return None
+    others = [a for a in args if a not in named]
+    return named[0], repr((name, tuple(others))), [a for a in others if not re.match(r"message\s*=", a)]
+
+
+def _tg_split_first_arg(name, args, kotlin_test):
