+_TG_NAME_RE = re.compile(r"\bfun\s+(?:<(?:[^<>\n]|<[^<>\n]{0,%d}>){0,%d}>\s*)?" % (_TG_MAX_GENERIC_CHARS, _TG_MAX_GENERIC_CHARS) + r"(?:[\w.]+\.)?(`[^`\n]+`|[A-Za-z_]\w*)\s*\(|\bvoid\s+([^\W\d]\w*)\s*\(")
