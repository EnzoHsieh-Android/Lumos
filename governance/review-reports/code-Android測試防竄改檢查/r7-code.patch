+    nls, text_of = None, {}
+    for m in _TG_INFIX_RE.finditer(sb):           # 中綴斷言照個數算(同一行三個就是三條),那一行的文字只取一次
+        if len(out) >= _TG_MAX_STMTS:
+            break
+        if nls is None:
+            nls = [k for k, ch in enumerate(sb) if ch == "\n"]
+        li = bisect.bisect_left(nls, m.start())
+        if li not in text_of:
+            ls = nls[li - 1] + 1 if li > 0 else 0
+            le = nls[li] if li < len(nls) else len(rb)
+            text_of[li] = re.sub(r"\s+", " ", rb[ls:le]).strip()
+        out.append(text_of[li])
+    return out[:_TG_MAX_STMTS]
