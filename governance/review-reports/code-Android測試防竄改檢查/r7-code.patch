+def cmd_test_guard(repo=None, diff_range=None, as_json=False):
+    """lumos test-guard --diff A..B [--json](Projects/Android測試防竄改檢查_計劃):比對一段範圍的改動前後,列作弊候選。
+    有候選 rc1、沒有 rc0;不是 git 專案講一句 rc0;範圍寫錯或終點找不到 rc2(退出碼照 Room 守衛)。只讀 git,不跑測試、不改檔。"""
+    import json as _json
+    root = _note_audit_root(repo)
+    if root is None or not _is_git_worktree(root):
+        print("test-guard:這裡不是 git 專案,沒比", file=sys.stderr)
+        return 0
+    ends = _lens_range_ok(diff_range)
+    if ends is None:
+        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
+        return 2
+    a, b = ends
+    tip = _lens_full_sha(root, b)
+    start = _EMPTY_TREE_SHA if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
+    if tip is None or start is None:
+        print(f"擋下:範圍 {diff_range} 有一端在本機找不到——範圍寫錯了?", file=sys.stderr)
+        return 2
+    used = _tg_start(root, start, tip)
+    cands, err = _tg_analyze(root, used, tip)
+    if cands is None:
+        print(f"test-guard:{err}", file=sys.stderr)
+        return 2
+    if as_json:
+        print(_json.dumps({"range": diff_range, "start": used, "end": tip, "candidates": cands, "limitations": list(_TG_LIMITS)},
+                          ensure_ascii=False, indent=2))
+    else:
+        note = "" if used == start else f"(從跟主線的分岔點 {used[:12]} 起算)"
+        print(f"作弊候選 {len(cands)} 條{note}——候選不是定罪,改掉或附理由放行")
+        for c in cands:
+            print(f"  {c['file']}:{c['line']} [{c['rule']}] {c['message']}")
+            print(f"    該確認:{c['verify']}")
+            print("    " + _lint_waive_cmd(c))
+        print("抓不到的(這支工具的天花板,靠測試設計與審查):")
