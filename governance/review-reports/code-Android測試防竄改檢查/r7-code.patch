+def _tg_class_at(stripped):
+    """剝過的文字 → {行號: 外層類別路徑}。沿大括號深度追 class/object/interface 宣告;`Foo::class` 不算宣告,
+    沒有本體的類別(`data class Row(val a: Int)`)不會把下一個大括號當成自己的本體。路徑在開類別時接一次、存在堆疊上,
+    超過 _TG_MAX_PATH_CHARS 就換成前段加摘要(_tg_path_join):很深的巢狀每層都有測試時,路徑與函式鍵的總長也跟深度成正比。"""
+    bmap = _rg_bracket_map(stripped)
+    stack, depth, path_at, line, pending, nxt, memo = [], 0, {}, 1, None, [0, -1], {}
+    for m in re.finditer(r"\n|\{|\}|(?<!::)\b(?:class|object|interface)[ \t]+(?:`[^`\n]*`|[A-Za-z_]\w*)", stripped):
+        tok = m.group(0)
+        if tok == "\n":
+            path_at[line] = stack[-1][1] if stack else ""
+            line += 1
+        elif tok == "{":
+            depth += 1
+            if pending is not None:
+                stack.append((depth, _tg_path_join(stack[-1][1] if stack else "", pending)))
+                pending = None
+        elif tok == "}":
+            if stack and stack[-1][0] == depth:
+                stack.pop()
+            depth -= 1
+        elif _tg_class_has_body(stripped, m.end(), bmap, nxt, memo):
+            pending = tok.split(None, 1)[1].strip("`") or "_"
+    path_at[line] = stack[-1][1] if stack else ""
+    return path_at
+
+
+def _tg_path_join(parent, name):
+    """外層路徑接一層名稱;結果超過 _TG_MAX_PATH_CHARS 就換成「#」加 sha256 前 16 碼(同模組指紋的寫法)加「…」加最內層那段
+    (後 _TG_MAX_PATH_CHARS/2 字):長度有上限,結尾仍是最靠近測試的類別名。"""
+    full = (parent + "." if parent else "") + name
+    if len(full) <= _TG_MAX_PATH_CHARS:
+        return full
+    import hashlib
+    return "#" + hashlib.sha256(full.encode("utf-8", "replace")).hexdigest()[:16] + "…" + full[-(_TG_MAX_PATH_CHARS // 2):]
