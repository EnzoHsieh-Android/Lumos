+    連四輪被新寫法打穿,不在這一批);buildSrc、build-logic 底下的程式也不當正式程式檔。"""
+    p = str(path).replace("\\", "/")
+    name = p.rsplit("/", 1)[-1]
+    low = p.lower()
+    if low.endswith(_TG_IMG_EXT):
+        if _TG_IMG_NOT.search(p) or (_rg_is_test_path(p) and re.search(r"/(?:assets|resources)/", p)):
+            return None
