+    if not m:
+        return None, [], []
+    name = m.group(1).rsplit(".", 1)[-1]
+    br = _rg_bracket_map(_tg_strip(stmt))
+    close = br.get(m.end() - 1, len(stmt))
+    args = _rg_split_args(stmt[m.end():close], angle=False)
+    chain, k = [], close + 1
+    while True:
+        mm = re.compile(r"\s*\.\s*(\w+)\s*\(").match(stmt, k)
+        if not mm or mm.end() - 1 not in br:
+            break
+        en = br[mm.end() - 1]
+        chain.append((mm.group(1), _rg_split_args(stmt[mm.end():en], angle=False)))
+        k = en + 1
+    return name, args, chain
+
+
+def _tg_split_expected(stmt, kotlin_test=False):
+    """敘述 → (預期值那部分, 其餘部分的簽名, 實際值清單);判不出預期值位置回 None。
+    JUnit:三個參數第一個是字串常值 → 訊息在前;kotlin.test(檔案匯入 kotlin.test 的斷言):訊息在最後、容差在第三個。"""
