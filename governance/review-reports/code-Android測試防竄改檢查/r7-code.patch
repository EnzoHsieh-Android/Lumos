+    in_build_dir = (p.startswith(("buildSrc/", "build-logic/")) or "/buildSrc/" in p or "/build-logic/" in p) and not _rg_is_test_path(p)
+    if name.endswith((".gradle", ".gradle.kts", ".kts")) or in_build_dir:
+        return None
+    if name.endswith((".kt", ".java")):
