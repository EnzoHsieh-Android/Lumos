+
+def _tg_statements(fn):
+    """一支函式 → 斷言敘述清單(原文、壓空白):從斷言字到它的右括號或右大括號,再接後面連著的 .名稱(…) 鏈;可跨行。"""
+    sb, rb = fn["mbody"], fn["raw"]
+    br = _rg_bracket_map(sb)
+    out, pos = [], 0
+    while len(out) < _TG_MAX_STMTS:
+        m = _TG_ASSERT_RE.search(sb, pos)
+        if not m:
+            break
+        opener = m.end() - 1
+        if sb[opener] == "<":
+            p2 = sb.find("(", opener)
+            opener = p2 if p2 >= 0 else opener
+        k = br.get(opener, opener) + 1 if sb[opener] in "({" else m.end()
+        while True:
+            mm = _TG_CHAIN.match(sb, k, min(len(sb), k + 400))
+            if not mm or mm.end() - 1 not in br:
+                break
+            k = br[mm.end() - 1] + 1
+        out.append(re.sub(r"\s+", " ", rb[m.start():k]).strip())
+        pos = max(k, m.end())
