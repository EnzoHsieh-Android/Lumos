+_TG_MODIFIERS = re.compile(r"\b(?:public|private|protected|internal|open|override|final|suspend|static|abstract|inline|operator|infix"
+                           r"|tailrec|external|actual|expect|synchronized|native|strictfp|default)\b")
+
