+        ("步驟的 continue-on-error", W, start, "jobs:\n  b:\n    runs-on: x\n    steps:\n      - run: ./gradlew test\n        continue-on-error: true\n"),
+        ("工作層級的 continue-on-error", W, start, "jobs:\n  b:\n    runs-on: x\n    continue-on-error: true\n    steps:\n      - run: ./gradlew test\n"),
