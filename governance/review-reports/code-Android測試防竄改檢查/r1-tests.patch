+def _tqg_say(fn, *a):
+    """抓某支印訊息函式的 stdout+stderr。"""
+    import contextlib
+    import io
+    buf = io.StringIO()
+    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
+        fn(*a)
+    return buf.getvalue()
