@@ -0,0 +1,8 @@
+import requests
+from app.Domain.Order.Order import Order
+
+def checkout(req):
+    order = Order(req["id"], req["lines"])
+    order._status = "paid"
+    requests.post("https://pay.example/charge", json={"id": req["id"]})
+    return {"ok": True}
