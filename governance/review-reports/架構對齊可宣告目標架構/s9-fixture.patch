@@ -0,0 +1,9 @@
+import db
+from app.Domain.Order.Order import Order
+
+class OrderRepository:
+    def save(self, order):
+        db.execute("insert into orders(id, status) values (?, ?)", order.order_id, order._status)
+
+    def update_line_qty(self, order_id, line_no, qty):
+        db.execute("update order_lines set qty=? where order_id=? and no=?", qty, order_id, line_no)
