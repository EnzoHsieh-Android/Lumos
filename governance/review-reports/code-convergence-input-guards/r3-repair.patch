+def _cap_retro_status(env, loop_id, root, events=None, rows=None, rows_err=None, dir_exists=None, gov_err=None):
+    """★合格回顧的唯一判定★(處置閘第八步、canary record、loop next、doctor、retro-stats 全部呼叫這一支)。
+    取這個編號最新一筆人裁紀錄 D(治理帳檔內順序),再取 D 之後最新一筆 recorded 或 skipped 事件 E:
+    skipped → 已跳過;recorded → 回顧檔現在的 sha256 等於 E.retro_sha256 而且通過檢查(rounds 等於 D.rounds)→ 已記回顧,否則過期;沒有 E → 沒有。
+    回 dict:applies(有人裁紀錄而且卷證資料夾存在)、reason(不適用時 no-decision/no-dir)、decision(D)、
+    state(recorded/skipped/stale/none/gov-bad)、problems(過期或帳壞的原因)、data(已記回顧時的回顧內容)。
+    ★治理帳壞(gov_err)fail-closed★:讀不到人裁紀錄不等於沒有;只要這個迴圈「可能有」人裁紀錄(審查帳讀得動時:在 cap-decision 的範圍、
+    帳上輪數已到上限——不到上限記不了人裁;審查帳也讀不動時一律算可能有)而且有卷證,就判 state=gov-bad(decision 是 None)、要回顧(代碼審 r3)。"""
+    if events is None:
+        events, gov_err = _retro_gov_events(root, loop_id)
+    res = {"applies": False, "reason": "no-decision", "decision": None, "state": None, "problems": [], "data": None}
+    if gov_err:
+        if rows is None:
+            rows, rows_err = _loop_records_checked(env, loop_id)
+        if not rows_err:
+            scope = _cap_hint_scope(rows)
+            if scope is None or len(_retro_ledger_rounds(rows)) < scope[1]:
+                return res
+        if not (dir_exists if dir_exists is not None else _retro_dossier_seen(root, loop_id, rows, rows_err)):
+            res["reason"] = "no-dir"
+            return res
+        res.update(applies=True, reason=None, state="gov-bad", problems=[gov_err])
+        return res
+    evs = [e for e in events if e.get("loop") == loop_id]
+    di = None
+    for i, e in enumerate(evs):
+        if _retro_is_decision(e):
+            di = i
+    if di is None:
+        return res
+    dec = evs[di]
+    res["decision"] = dec
+    if dir_exists is None:
+        _rows, _err = (rows, rows_err) if rows is not None else _loop_records_checked(env, loop_id)
+        dir_exists = _retro_dossier_seen(root, loop_id, _rows, _err)
+    exists = dir_exists
+    if not exists:
+        res["reason"] = "no-dir"
+        return res
+    res["applies"], res["reason"] = True, None
+    last = None
+    for e in evs[di + 1:]:
+        if e.get("kind") in ("recorded", "skipped"):
+            last = e
+    if last is None:
+        res["state"] = "none"
+        return res
+    if last.get("kind") == "skipped":
+        res["state"] = "skipped"
+        return res
+    import hashlib as _hl
+    raw, _rerr = _retro_read_file(root, loop_id)
+    cur = _hl.sha256(raw).hexdigest() if raw is not None else None
+    if cur is None or cur != last.get("retro_sha256"):
+        res["state"] = "stale"
+        res["problems"] = (["回顧檔現在讀不到、不是一般檔或超過 256KB(記過之後被移走、刪掉、換掉或改大)"] if cur is None
+                           else ["回顧檔在 --record 之後被改過(指紋對不上),改完要重新 --record"])
+        return res
+    if rows is None:
+        rows, rows_err = _loop_records_checked(env, loop_id)
+    probs, data = _cap_retro_check(root, loop_id, dec, rows, rows_err, raw=raw)
+    if probs:
+        res["state"], res["problems"] = "stale", ["回顧檔指紋相符但不再通過檢查:" + ";".join(probs[:3])]
+    else:
+        res["state"], res["data"] = "recorded", data
+    return res
+
+
+def _cap_retro_fix_cmd(root, loop_id, state):
+    """★回顧不合格時該叫人做什麼,只由這一支決定★(處置閘、canary 擋下、loop next、doctor、retro-stats、--check、--template --write 都呼叫它)。
+    ★每種狀態都給走得通的指令,照做之後不會回到同一句★(代碼審 code-審查跑滿回顧 r2 通才、正確性、邊界席;r3 合約、通才、正確性、邊界、併發席):
+    | 狀態 | 提示 |
+    | 治理帳壞(gov-bad) | 把治理帳換回 repo 裡的一般檔(--skip 也寫不進去,不給);是一般檔而讀不動 → 改回讀寫權限 |
+    | 卷證資料夾或上層是捷徑、跑出 repo | 換成一般資料夾,或人裁決定不寫 --skip(--template --write 會被拒,不給) |
+    | 回顧檔不在(含記過之後被刪) | --template --write(只在檔不存在時建) |
+    | 回顧檔位置是資料夾、捷徑、管線 | 移除該路徑後 --template --write |
+    | 一般檔但讀不動、超過 256KB、空檔、建一半、不是 JSON 物件 | 刪除或改名該檔後 --template --write(不叫人跑 --check:它只會再說一次讀不動) |
+    | 讀得動的 JSON 物件、過期 | 改好現有回顧檔,--check 過了再 --record |
+    | 讀得動的 JSON 物件、還沒記 | --check(不合格照它逐條列的改),過了再 --record |
+    ★不印 `--template > 檔`★:照貼會先把已寫好的回顧截斷清空(代碼審 r1 四席)。"""
+    import stat as _stat
+    if state == "gov-bad":
+        gp = Path(root) / "docs" / GOV_LOG_NAME
+        # 路徑規則過了(一般檔、一個硬連結、不是捷徑)卻讀不動 → 多半是權限,換檔沒用(代碼審 code-審查跑滿回顧 r4 併發、邊界席)
+        if _retro_gov_path_err(root) is None and os.path.lexists(gp) and not os.access(gp, os.R_OK):
+            return (f"治理帳 docs/{GOV_LOG_NAME} 是一般檔但目前帳號讀不動(權限不足):把讀寫權限改回來"
+                    f"(例如 chmod u+rw docs/{GOV_LOG_NAME},或換回檔案擁有者的帳號)再重跑——權限修好之前跳過也寫不進去")
+        return (f"把治理帳 docs/{GOV_LOG_NAME} 換回 repo 裡的一般檔(不是符號連結、管線、資料夾,也沒有別的硬連結;"
+                f"對照 git 上一版:git diff HEAD -- docs/{GOV_LOG_NAME})再重跑——帳修好之前跳過也寫不進去")
+    p = _retro_path(root, loop_id)
+    q = _retro_qpath(root, p)
+    tw = _retro_cmd(loop_id, "--template --write")
+    chk_rec = f"{_retro_cmd(loop_id, '--check')} 過了再 {_retro_cmd(loop_id, '--record')}"
+    if _retro_path_unsafe(root, loop_id) == "dossier":
+        return (f"卷證資料夾 {_retro_qpath(root, _retro_dir(root, loop_id))}(或它的上層)是符號連結、或解析後不在 repo 裡,"
+                f"工具不在那裡讀寫回顧檔:把它換成 repo 裡的一般資料夾再重跑;或人裁決定不寫:{_retro_cmd(loop_id, '--skip --note')} \"<理由>\"")
+    try:
+        st = os.lstat(p)
+    except (OSError, ValueError):
+        st = None
+    if st is None:
+        return tw if state != "stale" else f"回顧檔不在了(記過之後被移走或刪掉):{tw} 重建,{chk_rec}"
+    if not _stat.S_ISREG(st.st_mode):
+        return f"回顧檔位置 {q} 是資料夾、捷徑或其他特殊檔,移除該路徑後再 {tw}"
+    raw, why = _retro_read_bytes(p)
+    if raw is not None:
+        _data, why = _retro_parse(raw)
+    if why:
+        return f"回顧檔 {q} {why}:刪除或改名該檔後再 {tw}"
+    if state == "stale":
+        return f"改好現有回顧檔 {q}(或刪掉後 {tw} 重建),{chk_rec}"
+    return f"回顧檔已在、還沒記:{chk_rec}"
+
+
+def _cap_retro_scan(env, root):
+    """有人裁紀錄的迴圈逐個判(retro-stats 與 doctor 共用):治理帳與審查帳各讀一次;一個迴圈判壞了只標它,不中斷。
+    回 ([(編號, 判定 dict)], 治理帳壞原因或 None);判壞的那個 dict 只有 error 與 decision。
+    ★治理帳壞時回 ([], 原因)★:列不出有哪些迴圈記了人裁,呼叫端要另外報「治理帳讀不了」(不當成零個、也不當成一個迴圈)——
+    r3 曾塞一筆假編號「(治理帳)」進清單,retro-stats 的迴圈數被灌 1(代碼審 code-審查跑滿回顧 r4 架構、通才、正確性、邊界、合約席)。"""
+    events, gerr = _retro_gov_events(root)
+    if gerr:
+        return [], gerr
+    order, seen, per = [], set(), {}
+    for e in events:
+        lp = e.get("loop")
+        if not isinstance(lp, str):
+            continue
+        per.setdefault(lp, []).append(e)
+        if _retro_is_decision(e) and lp not in seen:
+            seen.add(lp)
+            order.append(lp)
+    try:
+        cache = _canary_ledger_scan(env) if env is not None else None
+    except OSError:
+        cache = None          # 每個迴圈各自再讀一次,讀不到就各自標帳壞
+    out = []
+    for lp in order:
+        try:
+            rows, err = _loop_records_checked(env, lp, scan=cache)
+            out.append((lp, _cap_retro_status(env, lp, root, events=per[lp], rows=rows, rows_err=err)))
+        except Exception as e:   # 一個迴圈判壞了只標它(計劃 S9)
+            d = next((x for x in reversed(per[lp]) if _retro_is_decision(x)), {})
+            out.append((lp, {"error": f"{e.__class__.__name__}: {e}", "decision": d, "applies": True, "state": None, "problems": []}))
+    return out, None
+
+
+def _cap_retro_record_block(env, loop_id, round_id):
+    """canary record 的擋點(計劃〈三〉1):要記的列是新的一輪(輪次 id 不在帳上)而且這個迴圈要回顧時才讀治理帳。
+    回 None=放行;否則 (原因碼, 要印到 stderr 的幾行)。沒有人裁紀錄的迴圈一律放行(行為與現狀相同)。"""
+    import shlex as _shlex
+    root = _vault_repo_root(env)
+    rows, err = _loop_records_checked(env, loop_id)
+    if err is None and round_id in _retro_ledger_rounds(rows):
+        return None          # 同一輪第二席以後:只讀審查帳就知道,不碰治理帳
+    st = _cap_retro_status(env, loop_id, root, rows=rows, rows_err=err)
+    if not st["applies"]:
+        return None
+    if st["state"] == "gov-bad":   # 原因碼 cap-gov-bad:呼叫端不把這筆擋下寫進治理帳(帳本身就是不能碰的那個)
+        return ("cap-gov-bad", [
+            f"擋下:{_esc_clean(loop_id, 60)} 帳上已到上限、有卷證,但{st['problems'][0]}——判不了有沒有人裁紀錄,所以先不記。",
+            f"  出口:{_cap_retro_fix_cmd(root, loop_id, 'gov-bad')}"])
+    q = _esc_clean(_shlex.quote(loop_id), 200)
+    dec = st["decision"].get("decision")
+    skip_cmd = _retro_cmd(loop_id, '--skip --note "<理由>"')
+    if err:
+        if dec == "extra-round" and st["state"] == "skipped":
+            return None
+        exit_ = (f"修好審查帳再記;或人裁決定不寫回顧:{skip_cmd}" if dec == "extra-round" else
+                 f"修好審查帳再記;或人裁改記破例再開一輪(lumos loop cap-decision {q} --decision extra-round --note \"<理由>\")"
+                 "再決定寫回顧或跳過——最新人裁是接受風險時,跳過回顧解不了這個擋下")
+        return ("cap-ledger-bad", [
+            f"擋下:{_esc_clean(loop_id, 60)} 有人裁紀錄,但{err}——判不了這一列是不是人裁之後的新一輪,所以先不記。",
+            "  帳壞在哪:上面那句;對照 git 上一版找出壞列(git diff HEAD -- docs/.canary-log.jsonl)。",
+            f"  出口:{exit_}"])
+    if dec == "accept-risk":
+        return ("cap-accept-risk", [
+            f"擋下:{_esc_clean(loop_id, 60)} 到上限後人裁記的是接受風險(accept-risk),不是再開一輪。",
+            ("  要再開一輪,先改記人裁:"
+             f"lumos loop cap-decision {q} --decision extra-round --note \"<理由>\"(跳過回顧解不了這個擋下)")])
+    if st["state"] in ("recorded", "skipped"):
+        return None
+    lines = [(f"擋下:{_esc_clean(loop_id, 60)} 到上限後人裁記了破例再開一輪,但這筆人裁之後的跑滿回顧"
+              f"{_RETRO_STATE_LABEL.get(st['state'], '?')}——繼續之前要先留一份回顧。")]
+    lines.append("  為什麼:回顧把這幾輪的問題歸族、寫下下次怎麼少跑一輪;再開一輪之後就沒人回頭寫了。"
+                 + (f"過期原因:{_esc_clean(';'.join(st['problems'][:3]), 400)}" if st["problems"] else ""))
+    lines.append(f"  怎麼做:{_cap_retro_fix_cmd(root, loop_id, st['state'])}(起草派沒參與這個迴圈的乾淨代理);"
+                 f"人裁決定不寫:{skip_cmd}")
+    return ("cap-retro-missing", lines)
+
+
+def _disposal_retro_step(rounds, loop_id, root, env, spec_sha_override=None, retro_skip=False, dir_exists=None):
+    """處置閘第八步「跑滿回顧」:回 "fail"/"ok"/"skip"(形狀照落點那一步)。
+    skip:凍結/回放任一趟(spec_sha_override 或凍結第一趟多帶的 retro_skip;不讀回顧檔)、沒有人裁紀錄、沒有卷證資料夾。
+    fail:要回顧的迴圈回顧沒有或過期。"""
+    if spec_sha_override is not None or retro_skip:
+        print("[disposal] 跑滿回顧: —(凍結/回放模式:以問閘當下的判定為準,不讀回顧檔)")
+        return "skip"
+    if root is None:
+        root = _vault_repo_root(env) if env is not None else None
+    if root is None:
+        print("[disposal] 跑滿回顧: —(找不到 repo 根,讀不到治理帳)")
+        return "skip"
+    try:
+        err = next((f"審查帳有一列輪次不是字串({_esc_clean(repr(r.get('round')), 40)})"
+                    for r in rounds if "round" in r and not isinstance(r.get("round"), str)), None)
+        st = _cap_retro_status(env, loop_id, root, rows=rounds, rows_err=err, dir_exists=dir_exists)
+    except Exception as e:   # 新步驟自己壞掉不放行,也不丟堆疊
+        print(f"[disposal] 跑滿回顧: ✗ — 判不了({e.__class__.__name__}: {e})")
+        return "fail"
+    if not st["applies"]:
+        why = "沒有人裁紀錄,不需要回顧" if st["reason"] == "no-decision" else "這個迴圈沒有卷證資料夾,不需要回顧"
+        print(f"[disposal] 跑滿回顧: —({why})")
+        return "skip"
