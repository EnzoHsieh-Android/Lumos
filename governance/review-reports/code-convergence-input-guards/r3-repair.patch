+    import json as _j
+    lg = c["docs"] / ".canary-log.jsonl"
+    rows = [_j.loads(x) for x in lg.read_text(encoding="utf-8").split("\n") if x.strip()]
+    for r in rows:
+        if r.get("loop") == loop and pick(r):
+            r[key] = val
+    lg.write_text("".join(_j.dumps(x) + "\n" for x in rows), encoding="utf-8")
