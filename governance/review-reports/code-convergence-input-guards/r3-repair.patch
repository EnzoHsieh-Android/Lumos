+def _cr_write_retro(c, doc=None, loop="crx", raw=None):
+    import json as _j
+    p = c["loops"][loop]["rdir"] / "cap-retro.json"
+    if raw is not None:
+        p.write_bytes(raw)
+    else:
+        p.write_text(_j.dumps(doc if doc is not None else _cr_retro_doc(c, loop), ensure_ascii=False, indent=1), encoding="utf-8")
+    return p
