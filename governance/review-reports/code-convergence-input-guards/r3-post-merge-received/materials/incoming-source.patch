+                  "--", vault_rel, binary=True)
+    if r is None or r.returncode != 0:
+        return None
+    parts, out, i = [os.fsdecode(x) for x in r.stdout.split(b"\0")], [], 0
+    while i < len(parts) and parts[i]:
+        tag = parts[i]
+        if tag.startswith("R"):
+            old, new, i = parts[i + 1], parts[i + 2], i + 3
+        else:
+            old = new = parts[i + 1]
