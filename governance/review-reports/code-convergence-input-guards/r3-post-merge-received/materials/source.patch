+                (root / target).write_text(replacement)   # 迫使既有 reader 走索引而非相同工作樹捷徑
+            elif mode == "declaration":
+                replacement = home.read_text().replace("about_code: []", "about_code:\n  - tests/check.py")
+                home.write_text(replacement)
+            else:
