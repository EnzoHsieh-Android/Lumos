+            elif tg == "none":
+                if not _retro_text_ok(ch.get("reason"), 10):
+                    bad(f"{tag}.reason", "target 是 none 時要附 reason 至少 10 字")
+            else:
+                if not _retro_text_ok(ch.get("ref"), 1):
+                    bad(f"{tag}.ref", "要寫改哪裡(非空字串)")
+                if not _retro_text_ok(ch.get("change"), 10):
