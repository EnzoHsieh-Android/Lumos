+        print(f"[disposal] 跑滿回顧: —({why})")
+        return "skip"
+    if st["state"] == "gov-bad":
+        print(f"[disposal] 跑滿回顧: ✗ — 判不了:{st['problems'][0]}(讀不到人裁紀錄不等於沒有,先不放行)")
