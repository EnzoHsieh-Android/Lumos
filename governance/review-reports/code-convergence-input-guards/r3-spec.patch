+def cmd_loop_cap_decision(env, loop_id, decision, note, repo=None):
+    """記人裁紀錄(計劃〈二〉):多席迴圈到分級上限時,人裁破例再開一輪(extra-round)或接受剩下的風險(accept-risk)。
