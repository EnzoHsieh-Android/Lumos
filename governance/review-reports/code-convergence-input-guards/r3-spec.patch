+def _sl_summary(p):
+    lines = p.read_text(encoding="utf-8").split("\n")
+    i = next(k for k, ln in enumerate(lines) if ln.startswith("summary:"))
+    out = []
+    for ln in lines[i + 1:]:
+        if ln.startswith("  "):
+            out.append(ln[2:])
+        else:
+            break
+    return out
+
