+    why = _retro_id_bad(loop_id)
+    if why:
+        print(f"擋下:{why}", file=sys.stderr)
+        return 2
+    if decision not in _RETRO_DECISIONS:
+        print(f"擋下:--decision 只能是 {'/'.join(_RETRO_DECISIONS)}", file=sys.stderr)
