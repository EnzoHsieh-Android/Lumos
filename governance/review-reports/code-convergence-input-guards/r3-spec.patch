+
+def _retro_parse(raw):
+    """回顧檔位元組 → (物件, None) 或 (None, 原因)。--check 與下一步提示共用這一份判法(提示要知道檔是不是壞到該刪掉重建)。"""
+    import json as _j
+    if len(raw) > _RETRO_MAX_BYTES:
+        return None, f"超過 256KB({len(raw)} 位元組)"
+    if not raw.strip():
+        return None, "是空檔(多半是建檔中途被中斷)"
+    try:
+        text = raw.decode("utf-8-sig")
+    except UnicodeDecodeError as e:
+        return None, f"不是 UTF-8(第 {e.start} 個位元組讀不動)"
+    try:
+        data = _j.loads(text)
+    except (ValueError, RecursionError) as e:
+        return None, f"不是合法 JSON({e.__class__.__name__})"
+    if not isinstance(data, dict):
+        return None, f"的根不是物件(要是 {{…}},現在是 {type(data).__name__})"
+    return data, None
+
+
+def _json_text_escaped(obj, indent=2):
+    """json.dumps(ensure_ascii=False) 的文字,再把共用 _PATH_SPECIAL_CATS 類別的字元(C0/C1、雙向覆寫與零寬、行段分隔、孤立代理字元)
+    換成 JSON 的 \\uXXXX(超出 BMP 的用代理對)——讀回來值不變,印到終端或 cat 檔都不會被當成控制序列執行。
+    中文照原樣(不用 ensure_ascii=True:骨架要給人與起草代理讀)。結構用的換行(indent)保留:字串裡的 C0 json.dumps 本來就跳脫,
+    原樣的 \\n 只會是排版。★為什麼不用 _kill_esc★:它把換行也跳脫(排版會壞),超出 BMP 的字寫成 \\u 加五位數,不是合法 JSON 跳脫。
+    跑滿回顧 --template 的標準輸出與 --write 建的檔共用(代碼審 code-審查跑滿回顧 r3 資安席)。"""
+    import json as _j
+    text = _j.dumps(obj, ensure_ascii=False, indent=indent)
+    return "".join(_j.dumps(ch)[1:-1] if ch != "\n" and unicodedata.category(ch) in _PATH_SPECIAL_CATS else ch for ch in text)
+
