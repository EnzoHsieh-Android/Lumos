+def _retro_cmd(loop_id, tail):
+    """印給人照貼的 lumos loop retro 指令的唯一組法:編號先 shlex.quote,整行再過 _esc_clean(帳上編號含控制字元也不會打穿終端)。"""
+    import shlex as _shlex
+    return _esc_clean(f"lumos loop retro {_shlex.quote(str(loop_id))} {tail}".rstrip(), 400)
+
+
+def _retro_qpath(root, p):
+    import shlex as _shlex
+    return _esc_clean(_shlex.quote(_retro_rel(root, p)), 300)
