+def _cap_retro_fix_cmd(root, loop_id, state):
+    """★回顧不合格時該叫人做什麼,只由這一支決定★(處置閘、canary 擋下、loop next、doctor、retro-stats、--check、--template --write 都呼叫它)。
+    ★每種狀態都給走得通的指令,照做之後不會回到同一句★(代碼審 code-審查跑滿回顧 r2 通才、正確性、邊界席;r3 合約、通才、正確性、邊界、併發席):
+    | 狀態 | 提示 |
+    | 治理帳壞(gov-bad) | 把治理帳換回 repo 裡的一般檔(--skip 也寫不進去,不給);是一般檔而讀不動 → 改回讀寫權限 |
+    | 卷證資料夾或上層是捷徑、跑出 repo | 換成一般資料夾,或人裁決定不寫 --skip(--template --write 會被拒,不給) |
+    | 回顧檔不在(含記過之後被刪) | --template --write(只在檔不存在時建) |
+    | 回顧檔位置是資料夾、捷徑、管線 | 移除該路徑後 --template --write |
+    | 一般檔但讀不動、超過 256KB、空檔、建一半、不是 JSON 物件 | 刪除或改名該檔後 --template --write(不叫人跑 --check:它只會再說一次讀不動) |
+    | 讀得動的 JSON 物件、過期 | 改好現有回顧檔,--check 過了再 --record |
+    | 讀得動的 JSON 物件、還沒記 | --check(不合格照它逐條列的改),過了再 --record |
+    ★不印 `--template > 檔`★:照貼會先把已寫好的回顧截斷清空(代碼審 r1 四席)。"""
+    import stat as _stat
+    if state == "gov-bad":
+        gp = Path(root) / "docs" / GOV_LOG_NAME
+        # 路徑規則過了(一般檔、一個硬連結、不是捷徑)卻讀不動 → 多半是權限,換檔沒用(代碼審 code-審查跑滿回顧 r4 併發、邊界席)
+        if _retro_gov_path_err(root) is None and os.path.lexists(gp) and not os.access(gp, os.R_OK):
+            return (f"治理帳 docs/{GOV_LOG_NAME} 是一般檔但目前帳號讀不動(權限不足):把讀寫權限改回來"
+                    f"(例如 chmod u+rw docs/{GOV_LOG_NAME},或換回檔案擁有者的帳號)再重跑——權限修好之前跳過也寫不進去")
+        return (f"把治理帳 docs/{GOV_LOG_NAME} 換回 repo 裡的一般檔(不是符號連結、管線、資料夾,也沒有別的硬連結;"
+                f"對照 git 上一版:git diff HEAD -- docs/{GOV_LOG_NAME})再重跑——帳修好之前跳過也寫不進去")
+    p = _retro_path(root, loop_id)
+    q = _retro_qpath(root, p)
+    tw = _retro_cmd(loop_id, "--template --write")
+    chk_rec = f"{_retro_cmd(loop_id, '--check')} 過了再 {_retro_cmd(loop_id, '--record')}"
+    if _retro_path_unsafe(root, loop_id) == "dossier":
+        return (f"卷證資料夾 {_retro_qpath(root, _retro_dir(root, loop_id))}(或它的上層)是符號連結、或解析後不在 repo 裡,"
+                f"工具不在那裡讀寫回顧檔:把它換成 repo 裡的一般資料夾再重跑;或人裁決定不寫:{_retro_cmd(loop_id, '--skip --note')} \"<理由>\"")
+    try:
+        st = os.lstat(p)
+    except (OSError, ValueError):
+        st = None
+    if st is None:
+        return tw if state != "stale" else f"回顧檔不在了(記過之後被移走或刪掉):{tw} 重建,{chk_rec}"
+    if not _stat.S_ISREG(st.st_mode):
+        return f"回顧檔位置 {q} 是資料夾、捷徑或其他特殊檔,移除該路徑後再 {tw}"
+    raw, why = _retro_read_bytes(p)
+    if raw is not None:
+        _data, why = _retro_parse(raw)
+    if why:
+        return f"回顧檔 {q} {why}:刪除或改名該檔後再 {tw}"
+    if state == "stale":
+        return f"改好現有回顧檔 {q}(或刪掉後 {tw} 重建),{chk_rec}"
+    return f"回顧檔已在、還沒記:{chk_rec}"
