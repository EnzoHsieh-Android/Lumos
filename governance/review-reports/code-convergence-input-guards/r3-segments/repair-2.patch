+def _cap_retro_next_lines(env, loop_id, repo=None, ask=True):
+    """★到上限時「人裁」該印什麼的唯一決定處★(計劃〈三〉3、S19;[cap-hint] 的「人裁:」那段與 loop next --json 的 cap_retro 都用它):
