+# ───────────── 審查跑滿回顧(Projects/審查跑滿回顧_計劃)─────────────
+# 多席審查迴圈到分級上限時,人裁用 `loop cap-decision` 記一筆(破例再開一輪或接受風險);有人裁紀錄、而且有卷證資料夾的迴圈,
+# 要先留一份固定格式的回顧(或記跳過)才能繼續:canary record 記新一輪、處置閘第八步、loop next 到 cap-reached、doctor、retro-stats
+# ★五個呼叫端共用 _cap_retro_status 一支判定★(計劃〈名詞〉合格回顧;任何一處自己另判就會口徑分岔)。
+# 讀治理帳直接讀原始 jsonl、檔內順序、壞行跳過——不經 gov 的載入器(它以提交與種類去重、保留第一筆,同一提交上兩次 --record 會折成舊的那筆)。
+_RETRO_FAMILIES = ("same-family-unswept", "fix-induced", "scope-too-big", "spec-unclear",
+                   "seat-noise", "bar-moved", "hostile-surface", "other")
+_RETRO_TARGETS = ("rule", "tool", "dispatch", "skill", "none")
+_RETRO_DECISIONS = ("extra-round", "accept-risk")
+_RETRO_MAX_BYTES = 256 * 1024
+_RETRO_FILE = "cap-retro.json"
+_RETRO_STATE_LABEL = {"recorded": "已記回顧", "skipped": "已跳過", "stale": "過期", "none": "沒有", "gov-bad": "判不了(治理帳壞)"}
+_RETRO_NO_BAD = object()   # 「沒有壞輪次」的哨兵(輪次值本身可能是 None)
+
+
+def _retro_id_bad(loop_id):
+    """回顧相關指令的編號檢查:既有 _FIX_ID_BAD_RE(/、\\、控制字元、DEL、..),另擋空字串、只有空白、「.」。回原因或空字串。"""
+    if not isinstance(loop_id, str) or not loop_id.strip():
+        return "編號是空的或只有空白"
+    if loop_id.strip() == ".":
+        return "編號不能是「.」"
+    if _fix_bad_strings(loop_id, nul=False):
+        return "編號含不能編碼成 UTF-8 的字元"
+    if _FIX_ID_BAD_RE.search(loop_id):
+        return f"編號 {_esc_clean(loop_id, 60)!r} 含路徑字元或控制字元(/、\\、..、控制字元)"
+    return ""
+
+
+def _retro_root(env, repo=None):
+    return Path(repo).resolve() if repo else _vault_repo_root(env)
+
+
+def _retro_dir(root, loop_id):
+    return Path(root) / "governance" / "review-reports" / str(loop_id)
+
+
+def _retro_has_dossier(root, loop_id, rows):
+    """「有卷證資料夾」= 資料夾存在,而且裡面真的有這個編號帳上某一列的席報告(正規化後在資料夾底下、檔存在)。
+    ★只看資料夾在不在不夠★:處置閘的 roster 尾端遇到席位異常會自己 mkdir 這個資料夾(既有副作用),
+    沒有卷證的暫存迴圈問過一次閘就會被誤判成要回顧(實作期發現,計劃〈一〉補寫)。"""
+    d = _retro_dir(root, loop_id)
+    try:
+        if not d.is_dir():
+            return False
+    except (OSError, ValueError):
+        return False
+    prefix = os.path.normpath(str(Path("governance") / "review-reports" / str(loop_id))) + os.sep
+    for r in rows or []:
+        rp = r.get("report_path") if isinstance(r, dict) else None
+        if not isinstance(rp, str) or not rp.strip():
+            continue
+        try:
+            n = _retro_norm_path(rp, root)
+            if n.startswith(prefix) and (Path(root) / n).is_file():
+                return True
+        except (OSError, ValueError):
+            continue          # 帳上路徑打不開(含 NUL 等):當作不是卷證,不丟堆疊
+
+    return False
+
+
+def _retro_dossier_seen(root, loop_id, rows, err):
+    """帳讀得動 → 照 _retro_has_dossier;帳讀不動(err)時拿不到席報告清單,退回只看資料夾在不在(寧擋不放:S17 帳壞要 fail-closed)。"""
+    if err:
+        return _retro_dir(root, loop_id).is_dir()
+    return _retro_has_dossier(root, loop_id, rows)
+
+
+def _retro_path(root, loop_id):
+    return _retro_dir(root, loop_id) / _RETRO_FILE
+
+
+def _retro_rel(root, p):
+    try:
+        return str(Path(p).relative_to(Path(root)))
+    except ValueError:
+        return str(p)
+
+
+def _retro_ledger_rounds(rows):
+    """帳上輪次:相異輪次 id 依第一次出現的順序(跟 loop next 同一套,集合計數)。"""
+    out, seen = [], set()
+    for r in rows:
+        rid = r.get("round")
+        if isinstance(rid, str) and rid not in seen:
+            seen.add(rid)
+            out.append(rid)
+    return out
+
+
+def _retro_gov_path_err(root):
+    """跑滿回顧一族讀寫治理帳前的路徑檢查 → 給人看的原因或 None。★讀寫同一條規則★:走既有帳檔寫入前檢查 _drift_ledger_path_err
+    (repo 根往下任一層是符號連結、解析後不在 repo 裡、不是一般檔、有別的硬連結 = 帳壞)。讀端遇到就 fail-closed(_cap_retro_status 的 gov-bad),
+    寫端(cap-decision、--record、--skip)回 2 不寫——不往捷徑目標追加,捷徑指到 repo 外時也不會寫到外面
+    (代碼審 code-審查跑滿回顧 r3 合約、併發、資安、邊界四席:r2 把讀端改成不跟捷徑,寫端照舊跟,人裁寫得進去、閘讀不到)。"""
+    err = _drift_ledger_path_err(root, f"docs/{GOV_LOG_NAME}")
+    if not err:
+        return None
+    return _esc_clean("治理帳 docs/" + GOV_LOG_NAME + " 讀寫都不碰:" + err.replace(str(Path(root)) + os.sep, ""), 300)
+
+
+def _retro_gov_events(root, loop_id=None):
+    """治理帳裡 gate=loop-retro 的事件 → (事件清單, 帳壞原因或 None)。帳不存在 = ([], None);路徑不合 _retro_gov_path_err 或讀不動 = ([], 原因),
+    呼叫端要當成帳壞(fail-closed),★不得當成沒有人裁紀錄★。
+    檔內順序;壞行(不是 UTF-8、不是 JSON、不是物件)跳過;loop_id 給了就以結構化欄位 loop 逐字比對。
+    ★只讀版控帳(docs/.governance-log.jsonl)是對的★:_gate_event 只把 _GOV_LOCAL_PAIRS 白名單裡、hard=False 的「閘名+種類」分流到本機帳,
+    loop-retro 三種都不在白名單,永遠寫版控帳(t_cap_retro_gate_registered_and_close_unaffected 釘著);哪天把它加進白名單,這裡要跟著讀兩本。
+    ★不共用 _gov_ledger_rows_by_time★:那支把兩本帳合起來依時間排序(給度量用),這裡要的是版控帳的檔內順序(「最新一筆人裁之後」靠它),
+    依時間排會讓同一秒的人裁與回顧前後顛倒。開檔照既有守衛只讀一般檔(走 _retro_read_bytes → _regular_own_fd,管線不卡住);切行用 _ledger_lines。"""
+    import json as _j
+    gerr = _retro_gov_path_err(root)
+    if gerr:
+        return [], gerr
+    gp = Path(root) / "docs" / GOV_LOG_NAME
+    if not os.path.lexists(gp):
+        return [], None
+    raw, rerr = _retro_read_bytes(gp, limit=None)
+    if raw is None:
+        return [], _esc_clean(f"治理帳 docs/{GOV_LOG_NAME} {rerr}", 300)
+    out = []
+    for ln in _ledger_lines(raw):
+        if b"loop-retro" not in ln:
+            continue
+        try:
+            d = _j.loads(ln.decode("utf-8"))
+        except (UnicodeDecodeError, ValueError, RecursionError):
+            continue
+        if not isinstance(d, dict) or d.get("gate") != "loop-retro":
+            continue
+        if loop_id is not None and d.get("loop") != loop_id:
+            continue
+        out.append(d)
+    return out, None
+
+
+def _retro_is_decision(e):
+    return (e.get("kind") == "cap-decision" and e.get("decision") in _RETRO_DECISIONS
+            and isinstance(e.get("rounds"), list))
+
+
+def _retro_norm_path(p, root):
+    """證據與帳上 report_path 比對前的正規化:repo 內的絕對路徑轉成 repo 相對,再 normpath(去 ./、重複斜線、..)。
+    ★為什麼不共用處置閘的 _prov_path★:那支是「把帳上路徑解析成要打開的檔」(相對路徑接到 repo 根,絕對路徑原樣),
+    這支是「兩邊寫法不同的路徑比對前要長得一樣」(回顧檔手寫的 ./a//b、repo 內絕對路徑,要跟帳上的相對寫法相等)——
+    方向相反,硬併會讓其中一邊多做或少做正規化。含 NUL 等打不開的路徑不解析,只做字面 normpath(不丟堆疊)。"""
+    s = str(p).strip()
+    if os.path.isabs(s):
+        rr = Path(root)
+        cands = [Path(os.path.normpath(s))]
+        try:
+            cands.append(Path(s).resolve())
+        except (OSError, ValueError, RuntimeError):
+            pass
+        for cand in cands:
+            try:
+                s = str(cand.relative_to(rr))
+                break
+            except ValueError:
+                continue
+        else:
+            s = os.path.normpath(s)
+    return os.path.normpath(s)
+
+
+def _retro_read_bytes(p, limit=_RETRO_MAX_BYTES):
+    """讀跑滿回顧一族要讀的檔(回顧檔、治理帳)的位元組,只讀一次。回 (位元組, 錯誤或 None)。
+    開檔走既有 _regular_own_fd(不跟捷徑、管線不卡住、開檔後判一般檔),require_owner=False:別的帳號 checkout 的檔也讀得到。
+    limit=None 不設上限(治理帳);回顧檔上限 256KB。驗與算指紋都用這一份(--record 先驗後算若各讀一次,中間被換掉會記到沒驗過的內容)。"""
+    fd = _regular_own_fd(p, os.O_RDONLY, require_owner=False)
+    if fd is None:
+        return None, "讀不到(不存在、是資料夾、捷徑或管線,或打不開)"
+    try:
+        chunks, n = [], 0
+        while limit is None or n <= limit:
+            b = os.read(fd, 65536)
+            if not b:
+                break
+            chunks.append(b)
+            n += len(b)
+    except OSError as e:
+        return None, f"讀不到({e.__class__.__name__})"
+    finally:
+        os.close(fd)
+    raw = b"".join(chunks)
+    if limit is not None and len(raw) > limit:
+        return None, f"超過 256KB(至少 {len(raw)} 位元組)"
+    return raw, None
+
+
+def _retro_path_unsafe(root, loop_id):
+    """回顧檔落點安不安全(讀端、寫端、提示共用一個答案)→ None、"dossier"(卷證資料夾或它的上層是符號連結、或解析後不在 repo 裡)、
+    "file"(回顧檔本身是符號連結)。逐層判走共用的 _repo_path_unsafe,不另寫 realpath/startswith(代碼審 code-審查跑滿回顧 r3 架構對齊席:
+    自寫版只看資料夾本身,上層是捷徑就放行,寫端建到別處、讀端讀這裡)。"""
+    rel = Path("governance") / "review-reports" / str(loop_id) / _RETRO_FILE
+    try:
+        bad = _repo_path_unsafe(root, rel)
+    except (OSError, ValueError):
+        return "dossier"
+    if not bad:
+        return None
+    return "file" if bad[0] == "symlink" and bad[1] == _retro_path(root, loop_id) else "dossier"
+
+
+_RETRO_DOSSIER_UNSAFE = "所在的卷證資料夾(或它的上層)是符號連結、或解析後不在 repo 裡——工具不在那裡讀寫回顧檔"
+
+
+def _retro_read_file(root, loop_id):
+    """讀回顧檔 → (位元組, 錯誤或 None)。落點先過 _retro_path_unsafe(跟 --template --write 同一個答案),再走 _retro_read_bytes。"""
+    if _retro_path_unsafe(root, loop_id) == "dossier":
+        return None, _RETRO_DOSSIER_UNSAFE
+    return _retro_read_bytes(_retro_path(root, loop_id))
+
+
+def _retro_parse(raw):
+    """回顧檔位元組 → (物件, None) 或 (None, 原因)。--check 與下一步提示共用這一份判法(提示要知道檔是不是壞到該刪掉重建)。"""
+    import json as _j
+    if len(raw) > _RETRO_MAX_BYTES:
+        return None, f"超過 256KB({len(raw)} 位元組)"
+    if not raw.strip():
+        return None, "是空檔(多半是建檔中途被中斷)"
+    try:
+        text = raw.decode("utf-8-sig")
+    except UnicodeDecodeError as e:
+        return None, f"不是 UTF-8(第 {e.start} 個位元組讀不動)"
+    try:
+        data = _j.loads(text)
+    except (ValueError, RecursionError) as e:
+        return None, f"不是合法 JSON({e.__class__.__name__})"
+    if not isinstance(data, dict):
+        return None, f"的根不是物件(要是 {{…}},現在是 {type(data).__name__})"
+    return data, None
+
+
+def _json_text_escaped(obj, indent=2):
+    """json.dumps(ensure_ascii=False) 的文字,再把共用 _PATH_SPECIAL_CATS 類別的字元(C0/C1、雙向覆寫與零寬、行段分隔、孤立代理字元)
+    換成 JSON 的 \\uXXXX(超出 BMP 的用代理對)——讀回來值不變,印到終端或 cat 檔都不會被當成控制序列執行。
+    中文照原樣(不用 ensure_ascii=True:骨架要給人與起草代理讀)。結構用的換行(indent)保留:字串裡的 C0 json.dumps 本來就跳脫,
+    原樣的 \\n 只會是排版。★為什麼不用 _kill_esc★:它把換行也跳脫(排版會壞),超出 BMP 的字寫成 \\u 加五位數,不是合法 JSON 跳脫。
+    跑滿回顧 --template 的標準輸出與 --write 建的檔共用(代碼審 code-審查跑滿回顧 r3 資安席)。"""
+    import json as _j
+    text = _j.dumps(obj, ensure_ascii=False, indent=indent)
+    return "".join(_j.dumps(ch)[1:-1] if ch != "\n" and unicodedata.category(ch) in _PATH_SPECIAL_CATS else ch for ch in text)
+
+
+def _retro_cmd(loop_id, tail):
+    """印給人照貼的 lumos loop retro 指令的唯一組法:編號先 shlex.quote,整行再過 _esc_clean(帳上編號含控制字元也不會打穿終端)。"""
+    import shlex as _shlex
+    return _esc_clean(f"lumos loop retro {_shlex.quote(str(loop_id))} {tail}".rstrip(), 400)
+
+
+def _retro_qpath(root, p):
+    import shlex as _shlex
+    return _esc_clean(_shlex.quote(_retro_rel(root, p)), 300)
+
+
+def _retro_text_ok(v, n):
+    return isinstance(v, str) and len(v.strip()) >= n
+
+
+def _cap_retro_check(root, loop_id, decision, rows, rows_err, raw=None):
+    """驗回顧檔(--check 與合格回顧判定共用)。回 (問題清單, 解析後的物件或 None)。壞檔一律判不合格並講原因,不丟堆疊。
+    raw=呼叫端已讀好的位元組(--record 與合格判定拿同一份算指紋);沒給就自己讀(_retro_read_bytes)。"""
+    p = _retro_path(root, loop_id)
+    rel = _retro_qpath(root, p)
+    if raw is None:
+        raw, rerr = _retro_read_file(root, loop_id)
+        if rerr:
+            return [f"回顧檔{rerr}:{rel} → {_cap_retro_fix_cmd(root, loop_id, 'none')}"], None
+    data, perr = _retro_parse(raw)
+    if perr:
+        return [f"回顧檔{perr} → {_cap_retro_fix_cmd(root, loop_id, 'none')}"], None
+    if _fix_bad_strings(data, nul=False):
+        return ["回顧檔有字串含孤立代理字元(\\ud800 這類,不是合法文字),型別不合格"], None
+    probs = []
+
+    def bad(field, why):
+        probs.append(f"{field}: {why}")
+
+    v = data.get("version")
+    if not (isinstance(v, int) and not isinstance(v, bool) and v == 1):
+        bad("version", f"要是 1,現在是 {_esc_clean(repr(v), 40)}")
+    if data.get("loop") != loop_id:
+        bad("loop", f"要等於指令給的編號 {loop_id!r},現在是 {_esc_clean(repr(data.get('loop')), 60)}")
+    want = [x for x in (decision.get("rounds") or []) if isinstance(x, str)]
+    rnds = data.get("rounds")
+    rset = set()
+    if not (isinstance(rnds, list) and all(isinstance(x, str) for x in rnds)):
+        bad("rounds", "要是字串清單")
+    else:
+        rset = set(rnds)
+        if rnds != want:
+            bad("rounds", f"要等於最新一筆人裁紀錄的輪次 {want}(順序也要一致),現在是 {_esc_clean(rnds, 120)}")
+    auditors = {r["auditor"].strip() for r in rows if isinstance(r.get("auditor"), str) and r["auditor"].strip()}
+    db, cb = data.get("drafted_by"), data.get("completed_by")
+    if not _retro_text_ok(db, 1):
+        bad("drafted_by", "要填起草的代理名稱(非空字串)")
+    if not _retro_text_ok(cb, 1):
+        bad("completed_by", "要填補完的人或編排者(非空字串)")
+    if _retro_text_ok(db, 1) and _retro_text_ok(cb, 1) and db.strip() == cb.strip():
+        bad("drafted_by", "不得等於 completed_by(起草與補完要是不同的人)")
+    if _retro_text_ok(db, 1) and db.strip() in auditors:
+        bad("drafted_by", f"{_esc_clean(db, 60)!r} 是這個迴圈的審查席;起草者要是沒參與這個迴圈的乾淨代理")
+    if rows_err:
+        bad("evidence", f"{rows_err},驗不了證據與起草者")
+    reports = set()
+    for r in rows:
+        rp = r.get("report_path")
+        if isinstance(rp, str) and rp.strip():
+            reports.add(_retro_norm_path(rp, root))
+    fams = data.get("families")
+    if not isinstance(fams, list) or not fams:
+        bad("families", "要是至少一項的清單")
+    else:
+        for i, f in enumerate(fams, 1):
+            tag = f"families[{i}]"
+            if not isinstance(f, dict):
+                bad(tag, "要是物件 {family, rounds, evidence, note}")
+                continue
+            fam = f.get("family")
+            if fam not in _RETRO_FAMILIES:
+                bad(f"{tag}.family", f"{_esc_clean(repr(fam), 40)} 不在固定清單({'、'.join(_RETRO_FAMILIES)})")
+            note = f.get("note")
+            if note is not None and not isinstance(note, str):
+                bad(f"{tag}.note", "要是字串")
+            if fam == "other" and not _retro_text_ok(note, 10):
+                bad(f"{tag}.note", "family 是 other 時要附 note 至少 10 字")
+            fr = f.get("rounds")
+            if not (isinstance(fr, list) and fr and all(isinstance(x, str) for x in fr)):
+                bad(f"{tag}.rounds", "要是至少一項的字串清單")
+            else:
+                out = [x for x in fr if x not in rset]
+                if out:
+                    bad(f"{tag}.rounds", f"{_esc_clean(out, 120)} 不在回顧的 rounds 裡")
+            ev = f.get("evidence")
+            if not (isinstance(ev, list) and ev and all(isinstance(x, str) and x.strip() for x in ev)):
+                bad(f"{tag}.evidence", "要是至少一條的席報告路徑清單")
+            elif not rows_err:
+                for x in ev:
+                    nx = _retro_norm_path(x, root)
+                    if nx not in reports:
+                        bad(f"{tag}.evidence", f"{_esc_clean(x, 100)!r} 不是這個編號帳上任何一列的席報告(report_path)")
+                    elif not (Path(nx) if os.path.isabs(nx) else Path(root) / nx).is_file():
+                        bad(f"{tag}.evidence", f"{_esc_clean(x, 100)!r} 是帳上的報告,但檔案現在不存在")
+    for key, n, what in (("why_cap", 20, "為什麼跑滿"), ("avoid", 20, "當初怎樣做能少跑一輪")):
+        if not _retro_text_ok(data.get(key), n):
+            bad(key, f"要是至少 {n} 字的字串({what})")
+    chs = data.get("changes")
+    if not isinstance(chs, list) or not chs:
+        bad("changes", "要是至少一項的清單")
+    else:
+        for i, ch in enumerate(chs, 1):
+            tag = f"changes[{i}]"
+            if not isinstance(ch, dict):
+                bad(tag, "要是物件 {target, ref, change}")
