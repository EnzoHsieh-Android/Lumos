+def _disposal_retro_ledger_bad(env, loop_id, root, why):
+    """處置閘讀審查帳時帳壞(不是 UTF-8、某列輪次不是字串):這個迴圈要回顧 → 印第八步 ✗ 與 FAIL,回 True;
+    否則回 False,呼叫端照原樣往下走(沒有人裁紀錄的迴圈行為不變,計劃 S17)。"""
