+@_cap_real_cutoff
+def t_cap_retro_accept_risk_blocks_new_round():
+    """[S2] 最新人裁是 accept-risk → 新一輪回 2、落 cap-accept-risk、叫人先記 extra-round;--skip 解不了。"""
