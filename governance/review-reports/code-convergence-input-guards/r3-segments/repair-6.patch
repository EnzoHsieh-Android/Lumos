+def _cr_gov_link(c, target):
+    """把治理帳換成指向 target 的符號連結(target 先放治理帳現在的內容)。"""
+    import os as _o
+    gl = c["docs"] / ".governance-log.jsonl"
+    target.write_bytes(gl.read_bytes() if gl.exists() else b"")
+    gl.unlink()
+    _o.symlink(target, gl)
+    return gl
