+def _updated_stale_notes(env, repo_root):
+    """開頭 updated(YYYY-MM-DD)早於 git 上那一篇最後一次提交日期的筆記 → [(圖譜內路徑, updated, git 日期)],照路徑排序。
+    git 不可用(不是 repo、失敗)時 git_last_change_dates 回空表,這裡就回 []。doctor 的 U 段與 updated-sync --stale 共用。
+    ★淺複製不判★:只有最近幾個提交時,每篇的 git 日期都變成同一天,會誤列大批、勸人蓋掉真日期(代碼審 r1 正確性席 F1)。
+    ★早一天以內不算★:今天跑 updated-sync、隔天才提交時,git 日期比 updated 晚一天,不該再被列(代碼審 r1 正確性席 F3)。"""
+    import datetime as _dt
+    if not repo_root or _git_is_shallow(repo_root):
+        return []
+    dates = git_last_change_dates(repo_root, env.vault)
+    out = []
+    for rel, n in sorted(env.notes.items()):
+        if _note_unreadable(n):
+            continue
+        u, g = _drift_str(n, "updated"), dates.get(rel)
+        if not (g and re.fullmatch(r"\d{4}-\d{2}-\d{2}", u)):
+            continue
+        try:
+            lag = (_dt.date.fromisoformat(g) - _dt.date.fromisoformat(u)).days
+        except ValueError:      # 形狀像日期但不存在(2026-02-30):當成落後列出,一鍵修會改成今天(代碼審 r2 回歸席 F2)
+            lag = 2
+        if lag > 1:
+            out.append((rel, u, g))
+    return out
+
