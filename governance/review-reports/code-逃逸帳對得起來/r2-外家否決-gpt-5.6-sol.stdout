def _review_yield_line(y, escapes=None):
    """把 _review_yield_round 的 dict 印成一行(問閘尾與 gov --stats 同一種措辭)。"""
    q = lambda v: "?" if v is None else str(v)
    s_part = "算不了(缺欄位)" if y["S"] is None else f"存活多於席位報的 {y['S']} 條(編排者自找或漏併)"
    tail = f";這條迴圈累計逃逸 {escapes}" if escapes is not None else ""
    return (f"席位報 {q(y['N'])}(機器數)→ 存活 {q(y['M'])} / 編排者重現不到 {q(y['R'])}(人填,已對 intake)"
            f"→ 折 {q(y['F'])} / 放行 {q(y['A'])};{s_part}{tail}")


def _escape_raw_rows(env):
    """讀逃逸帳的原始列:含撤回紀錄,只跳過壞行與不是 JSON 物件的行(Projects/逃逸帳對得起來_計劃 第三節)。
    撤回確認目標、自動記的去重要用這支——`_escape_rows_for` 永遠不吐撤回紀錄,拿它確認會判不出「已撤過」。"""
    out = []
    try:
        log = env.vault.parent / ".escape-log.jsonl"
        if not log.exists():
            return out
        for ln in log.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if isinstance(d, dict):
                out.append(d)
    except OSError:
        pass
    return out


_REVIEW_RECORD_KINDS = ("none", "caught", "missed")   # 審查帳裡真正的審查紀錄;kind=spec-gate 是規格閘自己的留痕


def _review_loop_ids(env):
    """審查帳裡有審查紀錄的迴圈編號(NFC);規格閘留痕不算——風險低沒審的計劃也會有那種列。"""
    return set(_escape_review_rows_by_loop(env))


def _escape_loop_kind(loop_id, review_ids):
    """逃逸列歸給哪一種迴圈:code-(代碼審)/design(有審查紀錄的設計審)/plan(沒審查帳的計劃)。寫與讀共用這一支。"""
    lid = nfc(str(loop_id or ""))
    if lid.startswith("code-"):
        return "code"
    return "design" if lid in review_ids else "plan"


def _escape_reason_ok(v):
    """理由門檻:去空白後至少 _MANUAL_MIN_CHARS 個字且至少一個實字(跟 [manual:] 那條同一個判法)。"""
    return isinstance(v, str) and len(v.strip()) >= _MANUAL_MIN_CHARS and bool(re.search(r"[^\W_]", v))


def _escape_log_guard(log):
    """寫逃逸帳前的共同檢查:帳檔是符號連結就擋、不存在就安全建檔(手動記帳與撤回共用)。回 0 或 2。"""
    if log.is_symlink():
        # r2 終態席實測:既存 symlink 會繞過建檔保護、共用寫入原語 open('a') 跟隨連結寫進外部檔——
        # 每次寫前先擋本體(殘餘=判斷與開檔間競態,best-effort 同 _ledger_append 家族誠實降級)
        print(f"擋下:逃逸帳檔是一個符號連結,不往裡寫(帳本必須是普通檔案):\n    {log}", file=sys.stderr)
        return 2
    if not log.exists():
        try:
            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
        except FileExistsError:
            pass
        except OSError as e:
            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
            return 2
    return 0


def _escape_is_withdraw(r):
    """撤回紀錄本身不是逃逸事件:任何統計都不當成一筆逃逸。"""
    return isinstance(r, dict) and r.get("kind") == "withdraw"


def _escape_withdrawn_targets(rows):
    """哪些逃逸列被撤回了(撤回紀錄的 target token 集合)。"""
        fails.append("G3")
    elif last.get("result_sha256") != cur_sha:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✗ — 對不上(文件在最後一輪審完之後又改過了,請重審一輪)")
        fails.append("G3")
    else:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✓")
    fs = [r.get("findings") for r in rounds[-3:]]
    print(f"[settle] G2(僅供參考,不影響過不過)各輪問題數: {fs}")
    for i, r in enumerate(rounds, 1):
        print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
    if fails:
        print(f"⛔ SETTLE GATE FAIL({loop_id} 沒通過,卡在:{'/'.join(fails)})")
        return 1
    print(f"✅ SETTLE GATE PASS({loop_id} 通過:清單全收尾、引用對得上、文件沒被事後改過)")
    _loop_gov_mark(env, loop_id, "converged", "gate PASS")
    return 0


def _esc_clean(v, limit=200):
    """逃逸帳顯示消毒(code-escape r1 B-1/B-2):控制字元(含換行/ESC)換空格——
    --list 的「一行一筆」是攔截/逃逸週報 grep 的載重合約,使用者可控的 desc 不得打穿;
    ANSI 逃逸碼進終端=帳本可信度風險。截斷防超長刷版。"""
    out = "".join(ch if ch >= " " and ch != "\x7f" else " " for ch in str(v))
    return out if len(out) <= limit else out[:limit] + "…"



def _git_head(repo_root):
    try:
        r = subprocess.run(["git", "-C", str(repo_root), "rev-parse", "HEAD"], capture_output=True, text=True, errors="replace")
        return r.stdout.strip() if r.returncode == 0 else ""
    except OSError:
        return ""


def _plans_in_range(repo_root, git_range, vault):
    """提交範圍碰到的計劃筆記(repo 相對路徑)。對回啟發式:碰到 Projects/*.md 就算。"""
    try:
        # ★中文檔名:git 預設把非 ASCII 路徑加引號並轉義,不關掉會一個計劃都對不上(taskbank 同型坑 2026-09-15)★
        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return []
    if r.returncode != 0:
        return []
    try:
        vrel = str(Path(vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
    except ValueError:
        return []
    out = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith(vrel + "/Projects/") and line.endswith(".md"):
            out.append(line)
    return out


def _loop_id_for_plan(plan_rel):
    """計劃檔名 → 迴圈編號:去 _計劃(design-loop skill 的慣例)。"""
    stem = Path(plan_rel).stem
    return stem[:-len("_計劃")] if stem.endswith("_計劃") else stem


def _plan_for_loop(env, loop_id):
    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。
    代碼審編號先去掉 code- 前綴;檔名比對兩邊都做 NFC(Projects/逃逸帳對得起來_計劃 第四節)。"""
    lid = nfc(str(loop_id or ""))
    if any(ch in lid for ch in ("/", "\\", "..")) or not lid.strip():
        return None   # 迴圈編號帶路徑字元不查(r1 資安席:否則拼出的路徑可能跳出 Projects/)
    if lid.startswith("code-"):
        lid = lid[len("code-"):]
    proj = env.vault / "Projects"
    for cand in (f"{lid}_計劃.md", f"{lid}.md"):
        if (proj / cand).is_file():
            return f"Projects/{cand}"
    try:
        names = {nfc(q.name): q.name for q in proj.iterdir()} if proj.is_dir() else {}
    except OSError:
        names = {}
    for cand in (f"{lid}_計劃.md", f"{lid}.md"):
        if nfc(cand) in names:
            return f"Projects/{names[nfc(cand)]}"
    return None


def _door_for_loop(env, loop_id):
    """規格閘留痕裡這條迴圈最後一次判的門;沒有就 unknown(規格閘上線前一律 unknown)。"""
    path = env.vault.parent / ".canary-log.jsonl"
    door = "unknown"
    if not path.exists():
        return door
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not ln.strip():
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
    return door


def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
    log = env.vault.parent / ".escape-log.jsonl"
    ledger = env.vault.parent / ".canary-log.jsonl"
    known = set()
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                v = json.loads(ln).get("loop")
            except ValueError:
                continue
            if isinstance(v, str):
                known.add(nfc(v))
    import datetime as _dt
    import secrets as _sec
    review_ids = _review_loop_ids(env)
    written = 0
    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
    with _vault_write_lock(env.vault):
        existing = set()
        for r in _escape_rows_for(env, include_withdrawn=True):   # 撤回過的仍算記過,同觸發不會悄悄補回來
            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
        for loop_id, plan_rel in loops:
            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
            if nfc(loop_id) in known:
                attribution = "ledger"
            elif plan_ok:
                attribution = "plan-file"
            else:
                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
                continue
            door = _door_for_loop(env, loop_id)
            if stage == "push-gate-unreviewed" and door != "low":
                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
                continue
            if (nfc(loop_id), stage, sha) in existing:
                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
                continue
            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "token": "ESC-" + _sec.token_hex(4),
                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door,
                   "loop_kind": _escape_loop_kind(loop_id, review_ids)}
            if plan_rel:
                rec["plan"] = plan_rel
            if extra:
                rec.update(extra)
            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
                written += 1
                existing.add((nfc(loop_id), stage, sha))
                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
            else:
                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
    return written


def _plan_file_exists(env, plan_rel):
    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
    if (env.vault / plan_rel).is_file():
        return True
    parent = (env.vault / plan_rel).parent
    if not parent.is_dir():
        return False
    want = nfc(Path(plan_rel).name)
    try:
        return any(nfc(q.name) == want for q in parent.iterdir())
    except OSError:
        return False


def _escape_auto_failed(env, loop_id, stage, why):
    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
    try:
        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
    except Exception:
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)


def _escape_withdraw(env, log, target, reason, by, others, auto, list_mode, withdrawn):
    """撤回一筆逃逸:追加一列撤回紀錄,不改舊列(Projects/逃逸帳對得起來_計劃 第三節)。"""
    import datetime as _dtw
    import secrets as _secw
    if auto or list_mode or withdrawn or any(x not in (None, "") for x in others):
        print("擋下:--withdraw 只能跟 --reason、--withdrawn-by 一起給,不能混記帳參數、--repo、--list 或 --auto(以免你以為做了兩件事)", file=sys.stderr)
        return 2
    target = (target or "").strip()
    if not (by or "").strip():
        print("擋下:撤回要明講是誰撤的:--withdrawn-by <誰>", file=sys.stderr)
        return 2
    if not _escape_reason_ok(reason):
        print(f"擋下:撤回理由至少 {_MANUAL_MIN_CHARS} 個字、要有實字(撤回會讓統計數字變好看,一定要留得下為什麼)", file=sys.stderr)
        return 2
    with _vault_write_lock(env.vault):
        rows = _escape_raw_rows(env)
        hits = [r for r in rows if r.get("token") == target]
        if not hits:
            print(f"擋下:逃逸帳裡沒有 token {_esc_clean(target, 40)} 這一列,帳本沒動。看全帳(每列都印 token):\n"
                  "    lumos loop escape --list", file=sys.stderr)
            return 2
        if len(hits) > 1:
            print(f"擋下:token {_esc_clean(target, 40)} 在帳上出現 {len(hits)} 次(帳本損毀或撞號),撤回會連帶藏掉別的列;"
                  "先對照 git 上一版把重複的那列修好再撤", file=sys.stderr)
            return 2
        hit = hits[0]
        if _escape_is_withdraw(hit):
            print(f"擋下:{_esc_clean(target, 40)} 本身是一筆撤回紀錄,撤回不能再撤;要反悔就重記一列逃逸", file=sys.stderr)
            return 2
        if target in _escape_withdrawn_targets(rows):
            print(f"擋下:{_esc_clean(target, 40)} 已經撤回過了,帳本沒動", file=sys.stderr)
            return 2
        rc_g = _escape_log_guard(log)
        if rc_g:
            return rc_g
        rec = {"kind": "withdraw", "target": target, "reason": reason.strip(), "by": by.strip(),
               "ts": _dtw.datetime.now().astimezone().isoformat(timespec="seconds"),
               "token": "ESC-" + _secw.token_hex(4)}
        rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])
    if rc_w:
        return rc_w
    print(f"✓ 撤回 {_esc_clean(target, 40)}:之後統計(問閘尾漏斗、治理帳統計、escape-stats、規則缺口)都不算它;清單照樣列、標已撤回")
    print("  撤回者是呼叫的人自報的,工具不驗身分;撤回清單:")
    print("    lumos loop escape --list --withdrawn")
    print("  ★還沒更新的 lumos 不認得撤回紀錄★:會把它印成可疑列、治理帳統計多算;共用這本帳的地方都要先跑 lumos update")
    return 0


def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None,
                    withdraw=None, reason=None, by=None, withdrawn=False, missing_ref=None):
    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
    整套審查系統的 ground truth 側;與攔截帳(★圖譜攔截★記號)互為兩面。
    append-only、不進任何閘;歸因是人工判斷(GIGO 同 cluster 歸併,計劃天花板明載)。
    ★歸因守衛的職責範圍(r1 外家 ESC-01 裁明)★:只防「編號打錯」(實存性),不驗迴圈
    收斂/放行狀態——那是語意判斷,歸人;守衛驗語意=偷渡閘,計劃明文不做。"""
    log = env.vault.parent / ".escape-log.jsonl"
    _SEV_W = {"minor": 0, "major": 1, "blocker": 2}
    if withdraw is not None:
        return _escape_withdraw(env, log, withdraw, reason, by,
                                others=(loop_id, stage, severity, desc, defect_ref, rule, git_range, sha, missing_ref, repo),
                                auto=auto, list_mode=list_mode, withdrawn=withdrawn)
    if reason is not None or by is not None:
        print("擋下:--reason 與 --withdrawn-by 只給撤回用(跟 --withdraw <token> 一起給)", file=sys.stderr)
        return 2
    if withdrawn and not list_mode:
        print("擋下:--withdrawn 是 --list 的修飾(只列撤回過的);要看就用:\n    lumos loop escape --list --withdrawn", file=sys.stderr)
        return 2
    if auto:
        # 自動模式(規格落成可驗收條件_計劃 第五節):給提交範圍,碰到的計劃筆記各記一筆;對不回就不記。
        if loop_id or list_mode:
            print("擋下:--auto 不吃迴圈編號也不能跟 --list 混用;編號由提交範圍碰到的計劃筆記推出來", file=sys.stderr)
            return 2
        if severity not in _SEV_W or not (stage or "").strip() or not (desc or "").strip():
            print("擋下:--auto 一樣要帶 --stage、--severity(minor|major|blocker)、--desc", file=sys.stderr)
            return 2
        if not git_range:
            print("擋下:--auto 要帶 --range <a..b>(推送/CI 的提交範圍),沒有範圍就對不回計劃", file=sys.stderr)
            return 2
        repo_root = Path(repo) if repo else env.vault.parent.parent
        plans = _plans_in_range(repo_root, git_range, env.vault)
        if not plans:
            print(f"逃逸自動記:範圍 {git_range} 對不回任何計劃筆記,不記(這不是錯,只是這次推送沒碰到計劃)")
            return 0
        vrel = str(Path(env.vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
        loops = [(_loop_id_for_plan(p), p[len(vrel) + 1:]) for p in plans]
        _auto_escape(env, stage.strip(), severity, desc, loops, sha or _git_head(repo_root), source=stage.strip())
        return 0
    if list_mode:
        if loop_id or stage or severity or desc or defect_ref or missing_ref:
            print("擋下:--list 是唯讀,不能跟記帳參數混用——照原樣執行你會以為記了、其實一筆都沒寫。要記帳就拿掉 --list 重跑", file=sys.stderr)
            return 2
        if not log.exists():
            print("逃逸帳是空的:還沒有任何一筆「迴圈放行後下游抓到可歸因缺陷」的紀錄。空≠零逃逸——也可能是沒人記;要記:")
            print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <minor|major|blocker> --desc <一句描述>")
            return 0
        import json as _je
        rows, bad = [], []
        for no, ln in enumerate(log.read_text(encoding="utf-8").splitlines(), 1):
            if not ln.strip():
                continue
            try:
                d = _je.loads(ln)
            except ValueError:
                bad.append(no)
                continue
            if not isinstance(d, dict):
                bad.append(no)      # 合法 JSON 但非物件(null/陣列)——r1 外家 ESC-03:一筆就能弄壞整個 --list
                continue
            rows.append(d)
        # 撤回紀錄不當成一筆逃逸;被撤回的列照樣列、標出來(Projects/逃逸帳對得起來_計劃 第三節)
        _wd = {r.get("target"): r for r in rows if _escape_is_withdraw(r) and r.get("target")}
        rows = [r for r in rows if not _escape_is_withdraw(r)]
        if withdrawn:
            rows = [r for r in rows if r.get("token") in _wd]
        if bad:
            print(f"提醒:逃逸帳有 {len(bad)} 行壞損被跳過(行 {', '.join(map(str, bad[:5]))}"
                  + ("…" if len(bad) > 5 else "") + f");帳檔:{log}", file=sys.stderr)
        by_loop = {}
        for r in rows:
            by_loop.setdefault(str(r.get("loop", "?")), []).append(r)
        _n_wd = sum(1 for r in rows if r.get("token") in _wd)
        print(f"逃逸帳:{len(rows)} 筆(迴圈收斂放行後、下游抓到的可歸因缺陷;歸因為人工判斷)"
              + (f";其中 {_n_wd} 筆已撤回(統計不算)" if _n_wd else "")
              + (";只列撤回過的" if withdrawn else ""))
        for lp, rs in sorted(by_loop.items()):
            worst_row = max(rs, key=lambda r: _SEV_W.get(r.get("severity"), -1))
            wsev = worst_row.get("severity")
            wlabel = wsev if wsev in _SEV_W else f"非標準值 {_esc_clean(wsev, 20)}(手改帳?)"
            print(f"  {_esc_clean(lp, 60)}:{len(rs)} 筆(最重 {wlabel})")
            for r in rs:
                sev = r.get("severity")
                sev_disp = sev if sev in _SEV_W else f"?{_esc_clean(sev, 12)}"
                print(f"    {str(r.get('ts') or '?')[:10]} {_esc_clean(r.get('token', '?'), 20)} [{sev_disp}@{_esc_clean(r.get('stage', '?'), 30)}] {_esc_clean(r.get('desc', ''))}"
                      + (f"(佐證:{_esc_clean(r['defect_ref'], 80)})" if r.get("defect_ref") else "")
                      # ★逐筆看得到有沒有標規則★(r1 通才席):只有彙總看得到的話,巡帳的人不知道哪一筆漏標
                      + (f"[本來該抓的規則:{_esc_clean(str(r['rule']), 40)}]" if r.get("rule") else "[沒標該抓的規則]")
                      + (lambda w: f" ★已撤回({_esc_clean(w.get('reason', ''), 60)};{_esc_clean(w.get('by', '?'), 20)},"
                                   f"{str(w.get('ts') or '?')[:10]})★" if w else "")(_wd.get(r.get("token"))))
        return 0
    # ── 記帳模式:全部驗證在此(r1 架構席 R-2:dispatch 只路由,驗證不拆層) ──
    if not loop_id:
        print("擋下:要記逃逸就得說是哪個迴圈編號放行的。看帳:\n    lumos loop escape --list", file=sys.stderr)
        return 2
    if severity not in _SEV_W:
        print("擋下:--severity 必填且只能是 minor|major|blocker(同審查帳值域)", file=sys.stderr)
        return 2
    if not (stage or "").strip():
        print("擋下:--stage 必填(在哪一站發現:實作/code-loop/CI/prod/使用者回報…)——缺階段的逃逸帳之後做不了「在哪一站漏的」分層統計", file=sys.stderr)
        return 2
    if not (desc or "").strip():
        print("擋下:--desc 不能空——沒有描述的逃逸帳讀側無從歸因,等於沒記", file=sys.stderr)
        return 2
    ledger = env.vault.parent / ".canary-log.jsonl"
    known, led_bad = set(), 0
    if ledger.exists():
        import json as _je2
        for ln in ledger.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                v = _je2.loads(ln).get("loop")
            except ValueError:
                led_bad += 1
                continue
            if isinstance(v, str):
                known.add(nfc(v))     # r1 邊界席 B-3:NFC 正規化,NFD 貼上形不再肉眼無解
    if nfc(loop_id) not in known:
        msg = f"擋下:審查帳裡沒有叫「{loop_id}」的迴圈——逃逸要歸因到真實存在的迴圈,先確認編號:\n    lumos gov --stats"
        if led_bad:
            msg += f"\n  (審查帳另有 {led_bad} 行壞損被跳過——查不到也可能是編號在那幾行裡)"
        print(msg, file=sys.stderr)
        return 2
    # 佐證(Projects/逃逸帳對得起來_計劃 第二節):sha 或 defect_ref 至少一個;都沒有要講為什麼沒有
    if missing_ref is not None and ((sha or "").strip() or (defect_ref or "").strip()):
        print("擋下:已經附了 --sha 或 --defect-ref,就不要再給 --missing-defect-ref(兩個一起給,理由會被丟掉)", file=sys.stderr)
        return 2
    if not (sha or "").strip() and not (defect_ref or "").strip():
        if missing_ref is None:
            print("擋下:要附佐證——--sha <提交> 或 --defect-ref <Issue/報告/提交>;真的沒有就講為什麼:\n"
                  "    --missing-defect-ref \"<為什麼沒有>\"\n"
                  "  (沒有佐證的逃逸列之後沒辦法去重,同一個缺陷會被記成好幾筆)", file=sys.stderr)
            return 2
        if not _escape_reason_ok(missing_ref):
            print(f"擋下:--missing-defect-ref 的理由至少 {_MANUAL_MIN_CHARS} 個字、要有實字", file=sys.stderr)
            return 2
    import datetime as _dt_esc
    import secrets as _sec_esc
    rec = {"ts": _dt_esc.datetime.now().astimezone().isoformat(timespec="seconds"),
           "token": "ESC-" + _sec_esc.token_hex(4),       # 落盤自驗唯一鍵(canary auto-mint 慣例)
           "loop": loop_id, "stage": stage.strip(), "severity": severity, "desc": desc.strip()}
    if (defect_ref or "").strip():
        rec["defect_ref"] = defect_ref.strip()
    if (sha or "").strip():
        rec["sha"] = sha.strip()
    if missing_ref is not None and not rec.get("defect_ref") and not rec.get("sha"):
        rec["defect_ref_missing"] = missing_ref.strip()
    rec["loop_kind"] = _escape_loop_kind(loop_id, _review_loop_ids(env))
    if rule:
        # ★閉環的那一格★:標「本來哪條規則該抓」,漏網才長得出新的守衛;
        # 不標的話這本帳只記得「漏掉了」,永遠不會變成下次擋得住的東西(看待辦:lumos rule-gap)
        rec["rule"] = rule.strip()
    with _vault_write_lock(env.vault):   # 手動記帳也上鎖(跟自動記、撤回同一把)
        rc_g = _escape_log_guard(log)
        if rc_g:
            return rc_g
        rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])   # 共用硬化原語(OSError 擋下+讀回自驗);已知天花板=撞鍵時讀回比對可能對到舊筆(canary 全家族同款,hex4 空間機率極低)
    if rc_w:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


_ESCAPE_NEXT_STAGES = ("實作", "code-loop")   # 以 push-gate 開頭的站名也算下一站接住
_ESCAPE_LEAK_STAGES = ("CI", "prod", "使用者回報")
_ESCAPE_STATS_MIN_N = 20


def _wilson_interval(k, n, z=1.96):
    """比例的 Wilson 95% 信賴區間;n=0 回 None。"""
    if n <= 0:
        return None
    import math
    p = k / n
    den = 1 + z * z / n
    mid = (p + z * z / (2 * n)) / den
    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
    return (max(0.0, mid - half), min(1.0, mid + half))


def _escape_stage_class(stage):
    """站名分類:next=下一站就接住、leak=漏網、unknown=不認得(算漏網、另列)。"""
    st = str(stage or "")
    if st in _ESCAPE_NEXT_STAGES or st.startswith("push-gate"):
        return "next"
    return "leak" if st in _ESCAPE_LEAK_STAGES else "unknown"


def _escape_plan_scopes(env, loop_id):
    """迴圈對應計劃的 scope/<類> 標籤;對不到計劃或沒標就 ["未分類"]。欄位照全檔慣例從 env.notes 讀。"""
    rel = _plan_for_loop(env, loop_id)
    n = env.notes.get(rel) if rel else None
    if n is None:
        return ["未分類"]
    sc = [t[len("scope/"):] for t in as_list(n.fields.get("tags")) if isinstance(t, str) and t.startswith("scope/")]
    return sc or ["未分類"]


def _escape_review_rows_by_loop(env):
    """審查帳裡的審查紀錄,依迴圈編號(NFC)分組;規格閘留痕不算。"""
    by_loop = {}
    try:
        for ln in (env.vault.parent / ".canary-log.jsonl").read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if isinstance(d, dict) and d.get("kind") in _REVIEW_RECORD_KINDS and isinstance(d.get("loop"), str):
                by_loop.setdefault(nfc(d["loop"]), []).append(d)
    except OSError:
        pass
    return by_loop


def _escape_released_loops(env, review_ids):
    """放行了的迴圈:治理帳有 converged 紀錄(設計審與代碼審過處置閘都寫在 gate=design-loop 這個閘名下、
    nodes 帶編號;有任何一筆 converged 就算),而且審查帳有它的審查紀錄。"""
    released = set()
    try:
        for ln in (env.vault.parent / ".governance-log.jsonl").read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if (isinstance(d, dict) and d.get("kind") == "converged" and d.get("gate") == "design-loop"
                    and isinstance(d.get("nodes"), list) and d["nodes"] and isinstance(d["nodes"][0], str)):
                lid = nfc(d["nodes"][0])
                if lid in review_ids:
                    released.add(lid)
    except OSError:
        pass
    return released


def _escape_evidence_keys(r):
    """一列的佐證:sha 與 defect_ref 各算一個鍵(r1 外家否決席:只取其一時,同一個 defect_ref 配不同 sha 會逃過比對)。"""
    return [f"{k}:{str(r.get(k) or '').strip()}" for k in ("sha", "defect_ref") if str(r.get(k) or "").strip()]


def _escape_shared_evidence(rows, released):
    """歸因不明用:先剔無佐證,只在分母母體內,每個佐證對到哪些迴圈。"""
    ev = {}
    for r in rows:
        lid = nfc(str(r.get("loop", "")))
        if lid in released:
            for key in _escape_evidence_keys(r):
                ev.setdefault(key, set()).add(lid)
    return ev


def _escape_stats(env):
    """逃逸率依類別(Projects/逃逸帳對得起來_計劃 第四節):單位一律是迴圈。回 dict,唯讀。"""
    rows = _escape_rows_for(env)                      # 已去掉撤回紀錄與被撤回的列
    review_ids = _review_loop_ids(env)
    by_loop = _escape_review_rows_by_loop(env)
    released = _escape_released_loops(env, review_ids)

    _cat_cache = {}

    def _cats(lid):   # 每個迴圈只算一次(r1 併發席:原本每一列逃逸都重讀計劃)
        if lid not in _cat_cache:
            kind = "code" if lid.startswith("code-") else "design"
            tier = _loop_anchor_tier(by_loop.get(lid, [])) or "未定錨"
            _cat_cache[lid] = [(kind, tier, sc) for sc in _escape_plan_scopes(env, lid)]
        return _cat_cache[lid]

    cats = {}
    for lid in released:
        for c in _cats(lid):
            cats.setdefault(c, {"released": set(), "leaked": set(), "next": 0})["released"].add(lid)
    totals = {"no_evidence": 0, "unattributed": 0, "unknown_stage": 0, "unreleased": 0, "plan": 0,
              "withdrawn": len(_escape_withdrawn_targets(_escape_raw_rows(env)))}
    ev_loops = _escape_shared_evidence(rows, released)
    for r in rows:
        lid = nfc(str(r.get("loop", "")))
        bucket = _escape_row_bucket(r, lid, review_ids, released, ev_loops)
        if bucket in ("plan", "unreleased", "unattributed"):
            totals[bucket] += 1
            continue
        if bucket == "no_evidence":
            totals["no_evidence"] += 1
        cls = _escape_stage_class(r.get("stage"))
        for c in _cats(lid):
            if cls == "next":
                cats[c]["next"] += 1
            else:
                cats[c]["leaked"].add(lid)
        if cls == "unknown":
            totals["unknown_stage"] += 1
    return {"categories": _escape_cat_rows(cats), "totals": totals}


def _escape_row_bucket(r, lid, review_ids, released, ev_loops):
    """一列逃逸落在哪一桶:plan / unreleased / unattributed / no_evidence(仍算進它的迴圈)/ counted。"""
    kind = r.get("loop_kind") if r.get("loop_kind") in ("code", "design", "plan") else _escape_loop_kind(lid, review_ids)
    if kind == "plan":   # 落帳時已決定的種類為準,不因後來才有審查紀錄就事後改類(r1 外家兩席)
        return "plan"
    if lid not in released:
        return "unreleased"
    keys = _escape_evidence_keys(r)
    if not keys:
        return "no_evidence"
    return "unattributed" if any(len(ev_loops.get(k, ())) > 1 for k in keys) else "counted"


def _escape_cat_rows(cats):
    out = []
    for (kind, tier, sc), v in sorted(cats.items(), key=lambda kv: (kv[0][0], str(kv[0][1]), kv[0][2])):
        n, k = len(v["released"]), len(v["leaked"])
        out.append({"kind": kind, "tier": tier, "scope": sc, "released": n, "leaked": k,
                    "rate": (k / n) if n else None, "ci95": _wilson_interval(k, n), "next_stage": v["next"],
                    "small_sample": n < _ESCAPE_STATS_MIN_N})
    return out


def cmd_loop_escape_stats(env, as_json=False):
    """唯讀:逃逸率依類別(分級 × 範圍類)。"""
    st = _escape_stats(env)
    if as_json:
        print(json.dumps(st, ensure_ascii=False))
        return 0
    print("逃逸率依類別(單位:迴圈;分母=處置閘過關放行的迴圈,分子=其中有漏網的迴圈;撤回的不算)")
    if not st["categories"]:
        print("  還沒有放行的迴圈可算")
    for c in st["categories"]:
        rate = "—" if c["rate"] is None else f"{c['rate']:.0%}"
        ci = "" if not c["ci95"] else f"(95% 區間 {c['ci95'][0]:.0%} 至 {c['ci95'][1]:.0%})"
        line = (f"  {c['kind']} × {c['tier']} × {c['scope']}:放行 {c['released']}、有漏網 {c['leaked']}、率 {rate}{ci}"
                f"、下一站接住 {c['next_stage']}")
        if c["small_sample"]:
            line += "  ★樣本太少不下結論(放行少於 20)★"
        if c["kind"] == "code":
            line += "  (code 類只含手動記的逃逸,低估)"
        print(line)
    t = st["totals"]
    print(f"  另列:無佐證 {t['no_evidence']} 列、歸因不明 {t['unattributed']} 列、站名不認得 {t['unknown_stage']} 列、"
          f"未放行迴圈的逃逸 {t['unreleased']} 列、沒審查帳的計劃 {t['plan']} 列、撤回過 {t['withdrawn']} 列")
    print("  範圍類有兩個以上標籤的計劃每類各算一次,各列加總會大於全體")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。
    讀 .canary-log.jsonl 的 **append 序**(不 ts-sort:ts 只到秒、同秒會並列),篩 loop==id。
    tail-K 滑動窗:前面髒輪不影響、只看最後 K 筆;missed/缺 severity 視同未收斂。
    exit 0=CONVERGED / 1=未收斂(含無記錄=還沒開始)/ 2=真錯誤。
    天花板:收斂=連 K 輪醒著的審計員沒找到 blocker/major,非完整正確;severity 自報(見設計 doc)。"""
    import json
    if light and panel:
        print("擋下:--light 和 --panel 不能一起用(light 是單人審、panel 是多人審,兩條不同的路),擇一", file=sys.stderr)
        return 2
    ls.add_argument("--need", type=int, default=None, help="連續乾淨輪數 K(預設 2;--settle 下禁用)")
    ls.add_argument("--disposal", action="store_true",
                    help="[T4] 處置閘(獨立路徑,與 --panel/--light/--settle/--need/--min-seats 互斥;需 --spec)")
    ls.add_argument("--gate", action="store_true",
                    help="證據閘:K-streak(必要)∧ G1 refcheck 引用座標 ∧ G2 發現枯竭,全過才 rc 0")
    ls.add_argument("--spec", dest="gate_spec", help="--gate 必填:要核對引用座標的最終 spec md")
    ls.add_argument("--repo", dest="gate_repo", help="repo root(預設 cwd 逐層向上找 .git)")
    ls.add_argument("--panel", action="store_true",
                    help="平行 panel 模式:按 round-id 分組。無-cluster 帳=兩條合取(輪有效∧存活max≤minor;capture-recapture 殘餘=advisory 不進合取,2026-08-14 降級);cluster 帳(M2,首個有效輪帶 --clusters 定錨)=兩條合取(輪有效∧fold後無disputed-major),新生cluster/capture-recapture 同 advisory。--gate 對 panel 為相容 no-op(panel 判準恆生效)")
    ls.add_argument("--light", action="store_true",
                    help="M1包 light K=1 謂詞:單席 caught∧max≤minor∧欄位互證∧hash 雙欄(強制 fail-closed);ratchet=任一 caught 輪≥major 永久 FAIL;與 --panel 互斥;需 --spec")
    ls.add_argument("--settle", metavar="清單檔",
                    help="結清模式(opt-in,v1 只接 legacy):JSON 約束清單,全結清∧G1∧G3 才收斂;"
                         "與 --panel/--light/--need/--min-seats 互斥,需 --gate+--spec")
    ls.add_argument("--min-seats", type=int, dest="min_seats",
                    help="M1包 席數下限:判定輪相異 auditor 數<N 即 FAIL(同席重複 append 不計;不帶=行為不變)")
    ls.add_argument("--roster", action="store_true",
                    help="[派工編制資料化] 編制對帳觀測(advisory 恆不影響 rc):應派(_TIER_ROSTER)vs 實派"
                         "(rN-dispatch*.json)逐輪分桶比;與所有模式相容,建議配 --repo。"
                         "全史觀測/回放用——問閘 --disposal 偵測到席位異常會自動轉述當輪,"
                         "同帶本旗標時尾端不重複(詳 Projects/roster對帳併入問閘_計劃)")
    lc = lsub.add_parser("compress", help="[S2] 結構化壓縮:長跑上下文規則式三欄(白名單壓不掉/證據/未結)")
    lc.add_argument("compress_file", metavar="檔")
    lc.add_argument("--json", dest="compress_json", action="store_true")
    lv = lsub.add_parser("verify-progress", help="[S3] 獨立進度驗證器:直讀帳只吃結構欄位,散文注入免疫")
    lv.add_argument("vp_loop_id", metavar="loop_id")
    lv.add_argument("--settle", dest="vp_settle", metavar="清單檔")
    lv.add_argument("--json", dest="vp_json", action="store_true")
    lr = lsub.add_parser("rewrite", help="人裁「整份重寫」收尾:記 rewrite 事件+血緣 note(prev/successor),自動查「連續兩次」")
    lr.add_argument("rw_loop_id", metavar="loop_id")
    lr.add_argument("--successor", dest="rw_successor", required=True, help="接手的新迴圈編號")
    lr.add_argument("--note", dest="rw_note", default="", help="一句為什麼判重寫(人裁依據)")
    ln = lsub.add_parser("next", help="M1包 機械脊椎:帳本吐唯一下一動作(phase/輪數/canary 型別/席數/記帳模板);唯讀指針,不 spawn agent")
    ln.add_argument("loop_id")
    ln.add_argument("--tier", dest="next_tier", choices=("light", "standard", "high"),
                    help="編排者宣告 tier(有帳面定錨時須一致否則 rc2;零記錄必填)")
    ln.add_argument("--orchestrator", dest="next_orch", choices=("claude", "codex"),
                    help="誰在編排(claude|codex;零記錄必填、不預設;有帳面定錨須一致)——外家席=不是編排者那一家(d4)")
    ln.add_argument("--json", action="store_true", dest="next_json", help="機讀輸出")
    ln.add_argument("--need", type=int, default=2, help="legacy 收斂窗 K(委派 gate 用,預設 2)")
    ln.add_argument("--spec", dest="gate_spec", help="gate 委派用 spec 檔;缺=判 converged 資訊不足→gate-pending")
    ln.add_argument("--repo", dest="gate_repo", help="repo root(gate 委派用)")
    le = lsub.add_parser("escape",
                         help="逃逸帳:迴圈放行後下游抓到可歸因缺陷→記一筆(--list 看全帳)",
                         description="什麼時候用:某個審查迴圈收斂放行了,但下游(實作/CI/prod/人)發現可歸因的缺陷——記一筆逃逸帳。append-only、不進任何閘;歸因是人工判斷,編號必須實存於審查帳。看全帳用 --list(唯讀,不能與記帳參數混用)。")
    le.add_argument("esc_loop_id", nargs="?", default=None, metavar="loop_id", help="放行該缺陷的迴圈編號(必須存在於審查帳)")
    le.add_argument("--stage", dest="esc_stage", help="在哪一站發現:實作/code-loop/CI/prod/使用者回報…(自由字串)")
    le.add_argument("--severity", dest="esc_severity", choices=("minor", "major", "blocker"), help="缺陷嚴重度(同審查帳值域)")
    le.add_argument("--desc", dest="esc_desc", help="一句描述:什麼缺陷、為何可歸因到該迴圈")
    le.add_argument("--defect-ref", dest="esc_ref", help="佐證指標(commit/Issue/報告路徑,選配)")
    le.add_argument("--auto", dest="esc_auto", action="store_true",
                    help="自動記:不給編號,改給 --range,碰到的計劃筆記各記一筆(推送閘/CI 用);對不回不記")
    le.add_argument("--range", dest="esc_range", help="--auto 用:提交範圍 a..b")
    le.add_argument("--sha", dest="esc_sha", help="缺陷佐證的提交;--auto 時也是去重鍵(不給就取 HEAD)")
    le.add_argument("--repo", dest="esc_repo", help="--auto 用:repo 根(不給就用 vault 的上兩層)")
    le.add_argument("--rule", dest="esc_rule", help="本來哪條規則該抓到它(規則 id;真的沒有對應規則就寫 none)。標了才算得出「該寫哪條規則」——看待辦:lumos rule-gap")
    le.add_argument("--list", dest="esc_list", action="store_true", help="列全帳(按迴圈分組;被撤回的標出來)")
    le.add_argument("--missing-defect-ref", dest="esc_missing_ref", metavar="理由",
                    help="手動記帳既沒有 --sha 也沒有 --defect-ref 時,講為什麼沒有(至少 4 個字)")
    le.add_argument("--withdraw", dest="esc_withdraw", metavar="token", help="撤回一筆逃逸(追加撤回紀錄,不改舊列);要一起給 --reason 與 --withdrawn-by;token 看 --list")
    le.add_argument("--reason", dest="esc_reason", help="--withdraw 用:為什麼撤回(至少 4 個字)")
    le.add_argument("--withdrawn-by", dest="esc_by", help="--withdraw 用:誰撤的(自報,不驗身分)")
    le.add_argument("--withdrawn", dest="esc_withdrawn", action="store_true", help="--list 的修飾:只列撤回過的")
    ll = lsub.add_parser("list", help="哪些審查迴圈還開著(帳面沒關門的);next/status 都要 loop_id,這支先給你編號")
    ll.add_argument("--days", dest="ll_days", type=int, default=14, help="幾天內有動才算「在飛」(預設 14)")
    ll.add_argument("--stale", dest="ll_stale", action="store_true", help="只看超過門檻沒動又沒關門的(空轉候選)")
    ll.add_argument("--all", dest="ll_all", action="store_true", help="連已關門的也列")
    ll.add_argument("--exclude", dest="ll_exclude", action="append", default=[], metavar="前綴",
                    help="略過編號以此開頭的迴圈(可重複;例:--exclude auto- 排掉自主迴圈的每日場次)")
    ll.add_argument("--json", dest="ll_json", action="store_true")
    ll.add_argument("--now", dest="ll_now", metavar="YYYY-MM-DD", help="指定「今天」是哪一天(重算/測試用;預設系統日期)")
    les = lsub.add_parser("escape-stats", help="逃逸率依類別(分級×範圍類;單位是迴圈,撤回的不算);唯讀")
    les.add_argument("--json", dest="es_json", action="store_true")
    lcs = lsub.add_parser("canary-stats",
                          help="[d4 讀取面] 跨輪 canary 累積帳:席位×caught/missed×尾端連續 missed;唯讀恆 rc0")
    lcs.add_argument("loop_id", nargs="?", default=None, help="省略=全 loop 摘要")

    lcc = lsub.add_parser("capture-counts",
                          help="異質 finder 接線:多 --finder 的 finding-key → capture_counts + 殘餘估計(餵 canary record --capture-counts)")
    lcc.add_argument("--finder", dest="finders", action="append", default=[],
                     help="一個 finder 找到的 finding-key 逗號串(LLM reviewer / SARIF linter / 測試失敗 / mutation 存活各給一個)")
    lcc.add_argument("--from-pitfalls", dest="cc_pitfalls",
                     help="自動收割 pitfalls --diff <range> 命中成確定性 finder(按 source 分組,免手貼)")
    lcc.add_argument("--repo", dest="cc_repo", help="repo root(--from-pitfalls 用;預設 cwd 向上找 .git)")
    lrp = lsub.add_parser("replay", help="改制回測:判定回放(--golden 對凍結閉包重算比對;--freeze 產 golden 判定檔;唯讀不落帳)")
    lrp.add_argument("rp_loop_id", metavar="loop_id")
    lrp.add_argument("--golden", dest="rp_golden", default=None, metavar="verdict.json", help="回放模式:與這份標準答案比對")
    lrp.add_argument("--freeze", dest="rp_freeze", action="store_true", help="凍結模式:產 governance/replay/<id>/verdict.json")
    lrp.add_argument("--spec", dest="rp_spec", default=None, help="凍結模式必帶:被審計劃檔(帳裡沒路徑欄,操作者給)")
    lrp.add_argument("--note", dest="rp_note", default=None, help="重凍理由(目的檔已存在時必填,留痕治理帳)")
    lrp.add_argument("--repo", dest="rp_repo", default=None, help="repo root(預設向上找 .git)")

    g = sub.add_parser("guard", help="合約守衛 scaffold(對談驅動):列出未綁 / 套範本產 stub / 綁定")
    gsub = g.add_subparsers(dest="gcmd", required=True)
    gl = gsub.add_parser("list", help="列 ★INVARIANT★ 綁定狀態(real/dangling/fake/naked)")
    gl.add_argument("--unbound", action="store_true", help="只列未綁(懸空/偽證據/裸)")

