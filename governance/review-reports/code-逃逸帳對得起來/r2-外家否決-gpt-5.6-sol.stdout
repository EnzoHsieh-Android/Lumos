_REVIEW_RECORD_KINDS = ("none", "caught", "missed")   # 審查帳裡真正的審查紀錄;kind=spec-gate 是規格閘自己的留痕


def _review_loop_ids(env):
    """審查帳裡有審查紀錄的迴圈編號(NFC);規格閘留痕不算——風險低沒審的計劃也會有那種列。"""
    return set(_escape_review_rows_by_loop(env))


def _escape_loop_kind(loop_id, review_ids):
    """逃逸列歸給哪一種迴圈:code-(代碼審)/design(有審查紀錄的設計審)/plan(沒審查帳的計劃)。寫與讀共用這一支。"""
    lid = nfc(str(loop_id or ""))
    if lid.startswith("code-"):
        return "code"
    return "design" if lid in review_ids else "plan"


def _escape_reason_ok(v):
    """理由門檻:去空白後至少 _MANUAL_MIN_CHARS 個字且至少一個實字(跟 [manual:] 那條同一個判法)。"""
    return isinstance(v, str) and len(v.strip()) >= _MANUAL_MIN_CHARS and bool(re.search(r"[^\W_]", v))


def _escape_log_guard(log):
    """寫逃逸帳前的共同檢查:帳檔是符號連結就擋、不存在就安全建檔(手動記帳與撤回共用)。回 0 或 2。"""
    if log.is_symlink():
        # r2 終態席實測:既存 symlink 會繞過建檔保護、共用寫入原語 open('a') 跟隨連結寫進外部檔——
        # 每次寫前先擋本體(殘餘=判斷與開檔間競態,best-effort 同 _ledger_append 家族誠實降級)
        print(f"擋下:逃逸帳檔是一個符號連結,不往裡寫(帳本必須是普通檔案):\n    {log}", file=sys.stderr)
        return 2
    if not log.exists():
        try:
            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
        except FileExistsError:
            pass
        except OSError as e:
            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
            return 2
    return 0


def _escape_is_withdraw(r):
    """撤回紀錄本身不是逃逸事件:任何統計都不當成一筆逃逸。"""
    return isinstance(r, dict) and r.get("kind") == "withdraw"


def _escape_withdrawn_targets(rows):
    """哪些逃逸列被撤回了(撤回紀錄的 target token 集合)。"""
    return {r.get("target") for r in rows if _escape_is_withdraw(r) and r.get("target")}


def _escape_rows_for(env, loop_id=None, include_withdrawn=False):
    """讀逃逸帳(append-only,不進閘);loop_id 給了就只回那條迴圈的。壞行、非物件行跳過。
    撤回紀錄永遠不回;被撤回的列預設不回,include_withdrawn=True 才回(自動記的去重要把撤過的當成記過)。"""
    rows = _escape_raw_rows(env)
    gone = set() if include_withdrawn else _escape_withdrawn_targets(rows)
    return [d for d in rows if not _escape_is_withdraw(d) and d.get("token") not in gone
            and (loop_id is None or d.get("loop") == loop_id)]


def _severity_check_row(rec, root, trust_sha=False):
    """[嚴重度綁定機械掃 S2] 單帳列 severity 對帳核心(CLI 與 disposal 尾端共用,單一實作)。
    回 (status, 白話訊息):ok/over(高報,保守)/under(低報)/noparse(報告無宣告行)/
    nofile(報告檔佚失)/shafail(報告與帳面指紋不符)。trust_sha=True 時跳過重算
    (disposal ③ 已對判定輪全席逐檔驗過,不對同一檔重算兩遍雜湊;r1 arch-f4)。"""
    rp = rec.get("report_path")
    if not rp:
        return "nofile", "帳列沒有報告檔路徑(舊形狀,寫側 2026-08-26 起已拒)"
                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door,
                   "loop_kind": _escape_loop_kind(loop_id, review_ids)}
            if plan_rel:
                rec["plan"] = plan_rel
            if extra:
                rec.update(extra)
            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
                written += 1
                existing.add((nfc(loop_id), stage, sha))
                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
            else:
                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
    return written


def _plan_file_exists(env, plan_rel):
    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
    if (env.vault / plan_rel).is_file():
        return True
    parent = (env.vault / plan_rel).parent
    if not parent.is_dir():
        return False
    want = nfc(Path(plan_rel).name)
    try:
        return any(nfc(q.name) == want for q in parent.iterdir())
    except OSError:
        return False


def _escape_auto_failed(env, loop_id, stage, why):
    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
    try:
        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
    except Exception:
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)


def _escape_withdraw(env, log, target, reason, by, others, auto, list_mode, withdrawn):
    """撤回一筆逃逸:追加一列撤回紀錄,不改舊列(Projects/逃逸帳對得起來_計劃 第三節)。"""
    import datetime as _dtw
    import secrets as _secw
    if auto or list_mode or withdrawn or any(x not in (None, "") for x in others):
        print("擋下:--withdraw 只能跟 --reason、--withdrawn-by 一起給,不能混記帳參數、--repo、--list 或 --auto(以免你以為做了兩件事)", file=sys.stderr)
        return 2
    target = (target or "").strip()
    if not (by or "").strip():
        print("擋下:撤回要明講是誰撤的:--withdrawn-by <誰>", file=sys.stderr)
        return 2
    if not _escape_reason_ok(reason):
        print(f"擋下:撤回理由至少 {_MANUAL_MIN_CHARS} 個字、要有實字(撤回會讓統計數字變好看,一定要留得下為什麼)", file=sys.stderr)
        return 2
    with _vault_write_lock(env.vault):
        rows = _escape_raw_rows(env)
        hits = [r for r in rows if r.get("token") == target]
        if not hits:
            print(f"擋下:逃逸帳裡沒有 token {_esc_clean(target, 40)} 這一列,帳本沒動。看全帳(每列都印 token):\n"
                  "    lumos loop escape --list", file=sys.stderr)
            return 2
        if len(hits) > 1:
            print(f"擋下:token {_esc_clean(target, 40)} 在帳上出現 {len(hits)} 次(帳本損毀或撞號),撤回會連帶藏掉別的列;"
                  "先對照 git 上一版把重複的那列修好再撤", file=sys.stderr)
            return 2
        hit = hits[0]
        if _escape_is_withdraw(hit):
            print(f"擋下:{_esc_clean(target, 40)} 本身是一筆撤回紀錄,撤回不能再撤;要反悔就重記一列逃逸", file=sys.stderr)
            return 2
        if target in _escape_withdrawn_targets(rows):
            print(f"擋下:{_esc_clean(target, 40)} 已經撤回過了,帳本沒動", file=sys.stderr)
            return 2
        rc_g = _escape_log_guard(log)
        if rc_g:
            return rc_g
        rec = {"kind": "withdraw", "target": target, "reason": reason.strip(), "by": by.strip(),
               "ts": _dtw.datetime.now().astimezone().isoformat(timespec="seconds"),
               "token": "ESC-" + _secw.token_hex(4)}
        rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])
    if rc_w:
        return rc_w
    print(f"✓ 撤回 {_esc_clean(target, 40)}:之後統計(問閘尾漏斗、治理帳統計、escape-stats、規則缺口)都不算它;清單照樣列、標已撤回")
    print("  撤回者是呼叫的人自報的,工具不驗身分;撤回清單:")
    print("    lumos loop escape --list --withdrawn")
    print("  ★還沒更新的 lumos 不認得撤回紀錄★:會把它印成可疑列、治理帳統計多算;共用這本帳的地方都要先跑 lumos update")
    return 0


def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None,
                    withdraw=None, reason=None, by=None, withdrawn=False, missing_ref=None):
    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
    整套審查系統的 ground truth 側;與攔截帳(★圖譜攔截★記號)互為兩面。
    append-only、不進任何閘;歸因是人工判斷(GIGO 同 cluster 歸併,計劃天花板明載)。
    ★歸因守衛的職責範圍(r1 外家 ESC-01 裁明)★:只防「編號打錯」(實存性),不驗迴圈
    收斂/放行狀態——那是語意判斷,歸人;守衛驗語意=偷渡閘,計劃明文不做。"""
    log = env.vault.parent / ".escape-log.jsonl"
    _SEV_W = {"minor": 0, "major": 1, "blocker": 2}
    if withdraw is not None:
        return _escape_withdraw(env, log, withdraw, reason, by,
                                others=(loop_id, stage, severity, desc, defect_ref, rule, git_range, sha, missing_ref, repo),
                                auto=auto, list_mode=list_mode, withdrawn=withdrawn)
    if reason is not None or by is not None:
        print("擋下:--reason 與 --withdrawn-by 只給撤回用(跟 --withdraw <token> 一起給)", file=sys.stderr)
        return 2
    if withdrawn and not list_mode:
        print("擋下:--withdrawn 是 --list 的修飾(只列撤回過的);要看就用:\n    lumos loop escape --list --withdrawn", file=sys.stderr)
        return 2
    if auto:
        # 自動模式(規格落成可驗收條件_計劃 第五節):給提交範圍,碰到的計劃筆記各記一筆;對不回就不記。
        if loop_id or list_mode:
            print("擋下:--auto 不吃迴圈編號也不能跟 --list 混用;編號由提交範圍碰到的計劃筆記推出來", file=sys.stderr)
            return 2
        if severity not in _SEV_W or not (stage or "").strip() or not (desc or "").strip():
            print("擋下:--auto 一樣要帶 --stage、--severity(minor|major|blocker)、--desc", file=sys.stderr)
            return 2
        if not git_range:
            print("擋下:--auto 要帶 --range <a..b>(推送/CI 的提交範圍),沒有範圍就對不回計劃", file=sys.stderr)
            return 2
        repo_root = Path(repo) if repo else env.vault.parent.parent
        plans = _plans_in_range(repo_root, git_range, env.vault)
        if not plans:
            print(f"逃逸自動記:範圍 {git_range} 對不回任何計劃筆記,不記(這不是錯,只是這次推送沒碰到計劃)")
            return 0
        vrel = str(Path(env.vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
        loops = [(_loop_id_for_plan(p), p[len(vrel) + 1:]) for p in plans]
        _auto_escape(env, stage.strip(), severity, desc, loops, sha or _git_head(repo_root), source=stage.strip())
        return 0
    if list_mode:
        if loop_id or stage or severity or desc or defect_ref or missing_ref:
            print("擋下:--list 是唯讀,不能跟記帳參數混用——照原樣執行你會以為記了、其實一筆都沒寫。要記帳就拿掉 --list 重跑", file=sys.stderr)
            return 2
        if not log.exists():
            print("逃逸帳是空的:還沒有任何一筆「迴圈放行後下游抓到可歸因缺陷」的紀錄。空≠零逃逸——也可能是沒人記;要記:")
            print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <minor|major|blocker> --desc <一句描述>")
            return 0
        import json as _je
        rows, bad = [], []
        for no, ln in enumerate(log.read_text(encoding="utf-8").splitlines(), 1):
            if not ln.strip():
                continue
            try:
                d = _je.loads(ln)
            except ValueError:
                bad.append(no)
                continue
            if not isinstance(d, dict):
                bad.append(no)      # 合法 JSON 但非物件(null/陣列)——r1 外家 ESC-03:一筆就能弄壞整個 --list
                continue
            rows.append(d)
        # 撤回紀錄不當成一筆逃逸;被撤回的列照樣列、標出來(Projects/逃逸帳對得起來_計劃 第三節)
        _wd = {r.get("target"): r for r in rows if _escape_is_withdraw(r) and r.get("target")}
        rows = [r for r in rows if not _escape_is_withdraw(r)]
        if withdrawn:
            rows = [r for r in rows if r.get("token") in _wd]
        if bad:
            print(f"提醒:逃逸帳有 {len(bad)} 行壞損被跳過(行 {', '.join(map(str, bad[:5]))}"
                  + ("…" if len(bad) > 5 else "") + f");帳檔:{log}", file=sys.stderr)
        by_loop = {}
        for r in rows:
            by_loop.setdefault(str(r.get("loop", "?")), []).append(r)
        _n_wd = sum(1 for r in rows if r.get("token") in _wd)
        print(f"逃逸帳:{len(rows)} 筆(迴圈收斂放行後、下游抓到的可歸因缺陷;歸因為人工判斷)"
              + (f";其中 {_n_wd} 筆已撤回(統計不算)" if _n_wd else "")
              + (";只列撤回過的" if withdrawn else ""))
        for lp, rs in sorted(by_loop.items()):
            worst_row = max(rs, key=lambda r: _SEV_W.get(r.get("severity"), -1))
            wsev = worst_row.get("severity")
            wlabel = wsev if wsev in _SEV_W else f"非標準值 {_esc_clean(wsev, 20)}(手改帳?)"
            print(f"  {_esc_clean(lp, 60)}:{len(rs)} 筆(最重 {wlabel})")
            for r in rs:
                sev = r.get("severity")
                sev_disp = sev if sev in _SEV_W else f"?{_esc_clean(sev, 12)}"
                print(f"    {str(r.get('ts') or '?')[:10]} {_esc_clean(r.get('token', '?'), 20)} [{sev_disp}@{_esc_clean(r.get('stage', '?'), 30)}] {_esc_clean(r.get('desc', ''))}"
                      + (f"(佐證:{_esc_clean(r['defect_ref'], 80)})" if r.get("defect_ref") else "")
                      # ★逐筆看得到有沒有標規則★(r1 通才席):只有彙總看得到的話,巡帳的人不知道哪一筆漏標
                      + (f"[本來該抓的規則:{_esc_clean(str(r['rule']), 40)}]" if r.get("rule") else "[沒標該抓的規則]")
                      + (lambda w: f" ★已撤回({_esc_clean(w.get('reason', ''), 60)};{_esc_clean(w.get('by', '?'), 20)},"
                                   f"{str(w.get('ts') or '?')[:10]})★" if w else "")(_wd.get(r.get("token"))))
        return 0
    # ── 記帳模式:全部驗證在此(r1 架構席 R-2:dispatch 只路由,驗證不拆層) ──
    if not loop_id:
        print("擋下:要記逃逸就得說是哪個迴圈編號放行的。看帳:\n    lumos loop escape --list", file=sys.stderr)
        return 2
    if severity not in _SEV_W:
        print("擋下:--severity 必填且只能是 minor|major|blocker(同審查帳值域)", file=sys.stderr)
        return 2
    if not (stage or "").strip():
        print("擋下:--stage 必填(在哪一站發現:實作/code-loop/CI/prod/使用者回報…)——缺階段的逃逸帳之後做不了「在哪一站漏的」分層統計", file=sys.stderr)
        return 2
    if not (desc or "").strip():
        print("擋下:--desc 不能空——沒有描述的逃逸帳讀側無從歸因,等於沒記", file=sys.stderr)
        return 2
    ledger = env.vault.parent / ".canary-log.jsonl"
    known, led_bad = set(), 0
    if ledger.exists():
        import json as _je2
        for ln in ledger.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                v = _je2.loads(ln).get("loop")
            except ValueError:
                led_bad += 1
                continue
            if isinstance(v, str):
                known.add(nfc(v))     # r1 邊界席 B-3:NFC 正規化,NFD 貼上形不再肉眼無解
    if nfc(loop_id) not in known:
        msg = f"擋下:審查帳裡沒有叫「{loop_id}」的迴圈——逃逸要歸因到真實存在的迴圈,先確認編號:\n    lumos gov --stats"
        if led_bad:
            msg += f"\n  (審查帳另有 {led_bad} 行壞損被跳過——查不到也可能是編號在那幾行裡)"
        print(msg, file=sys.stderr)
        return 2
    # 佐證(Projects/逃逸帳對得起來_計劃 第二節):sha 或 defect_ref 至少一個;都沒有要講為什麼沒有
    if missing_ref is not None and ((sha or "").strip() or (defect_ref or "").strip()):
        print("擋下:已經附了 --sha 或 --defect-ref,就不要再給 --missing-defect-ref(兩個一起給,理由會被丟掉)", file=sys.stderr)
        return 2
    if not (sha or "").strip() and not (defect_ref or "").strip():
        if missing_ref is None:
            print("擋下:要附佐證——--sha <提交> 或 --defect-ref <Issue/報告/提交>;真的沒有就講為什麼:\n"
                  "    --missing-defect-ref \"<為什麼沒有>\"\n"
                  "  (沒有佐證的逃逸列之後沒辦法去重,同一個缺陷會被記成好幾筆)", file=sys.stderr)
            return 2
        if not _escape_reason_ok(missing_ref):
            print(f"擋下:--missing-defect-ref 的理由至少 {_MANUAL_MIN_CHARS} 個字、要有實字", file=sys.stderr)
            return 2
    import datetime as _dt_esc
    import secrets as _sec_esc
    rec = {"ts": _dt_esc.datetime.now().astimezone().isoformat(timespec="seconds"),
           "token": "ESC-" + _sec_esc.token_hex(4),       # 落盤自驗唯一鍵(canary auto-mint 慣例)
           "loop": loop_id, "stage": stage.strip(), "severity": severity, "desc": desc.strip()}
    if (defect_ref or "").strip():
        rec["defect_ref"] = defect_ref.strip()
    if (sha or "").strip():
        rec["sha"] = sha.strip()
    if missing_ref is not None and not rec.get("defect_ref") and not rec.get("sha"):
        rec["defect_ref_missing"] = missing_ref.strip()
    rec["loop_kind"] = _escape_loop_kind(loop_id, _review_loop_ids(env))
    if rule:
        # ★閉環的那一格★:標「本來哪條規則該抓」,漏網才長得出新的守衛;
        # 不標的話這本帳只記得「漏掉了」,永遠不會變成下次擋得住的東西(看待辦:lumos rule-gap)
        rec["rule"] = rule.strip()
    with _vault_write_lock(env.vault):   # 手動記帳也上鎖(跟自動記、撤回同一把)
        rc_g = _escape_log_guard(log)
        if rc_g:
            return rc_g
        rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])   # 共用硬化原語(OSError 擋下+讀回自驗);已知天花板=撞鍵時讀回比對可能對到舊筆(canary 全家族同款,hex4 空間機率極低)
    if rc_w:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


_ESCAPE_NEXT_STAGES = ("實作", "code-loop")   # 以 push-gate 開頭的站名也算下一站接住
_ESCAPE_LEAK_STAGES = ("CI", "prod", "使用者回報")
_ESCAPE_STATS_MIN_N = 20


def _wilson_interval(k, n, z=1.96):
    """比例的 Wilson 95% 信賴區間;n=0 回 None。"""
    if n <= 0:
        return None
    import math
    repo = Path(_tf.mkdtemp(prefix="gctl-sevtail-"))
    (repo / "governance" / "review-reports" / "sevtail").mkdir(parents=True)
    spec = repo / "spec.md"
    spec.write_text("規則甲:嚴重度要忠實轉錄,十個字以上。\n", encoding="utf-8")
    hsp = _h.sha256(spec.read_bytes()).hexdigest()
    rpt = repo / "governance" / "review-reports" / "sevtail" / "r1-s1.md"
    rpt.write_text("severity: blocker\n引句:「嚴重度要忠實轉錄,十個字以上」\n", encoding="utf-8")
    hr = _h.sha256(rpt.read_bytes()).hexdigest()
    snap = repo / "governance" / "review-reports" / "sevtail" / "r1-snapshot.md"
    snap.write_text(spec.read_text(encoding="utf-8"), encoding="utf-8")
    hs = _h.sha256(snap.read_bytes()).hexdigest()
    # 低報 carrier(帳 minor、報告 blocker)——寫側現已拒,這種列只可能來自舊碼/直寫=正是第二層要接的
    row = {"ts": "2026-08-30T10:00:00+08:00", "kind": "none", "loop": "sevtail", "round": "r1",
           "auditor": "s1", "token": "TT", "severity": "minor", "findings": 1,
           "findings_set": ["f1"], "folded_set": ["f1"], "accepted_set": [],
           "result_sha256": hsp, "reviewed_sha256": hsp,
           "report_path": "governance/review-reports/sevtail/r1-s1.md", "report_sha256": hr,
           "snapshot_path": "governance/review-reports/sevtail/r1-snapshot.md", "snapshot_sha256": hs}
    rpt_old = repo / "governance" / "review-reports" / "sevtail" / "r1-s0.md"
    rpt_old.write_text("severity: blocker\n引句:「嚴重度要忠實轉錄,十個字以上」\n", encoding="utf-8")
    hro = _h.sha256(rpt_old.read_bytes()).hexdigest()
    row_old = {"ts": "2026-08-20T10:00:00+08:00", "kind": "none", "loop": "sevtail", "round": "r1",
               "auditor": "s0", "token": "TT0", "severity": "minor",
               "result_sha256": hsp, "reviewed_sha256": hsp,
               "report_path": "governance/review-reports/sevtail/r1-s0.md", "report_sha256": hro,
               "snapshot_path": "governance/review-reports/sevtail/r1-snapshot.md", "snapshot_sha256": hs}
    (v.parent / ".canary-log.jsonl").write_text(_j.dumps(row_old) + "\n" + _j.dumps(row) + "\n", encoding="utf-8")
    r = run(v, "loop", "status", "sevtail", "--disposal", "--spec", str(spec), "--repo", str(repo))
    check("sevtail:歷史帳(生效日前)低報標「歷史帳」非寫側 bug(cb3 s3-f3 負案例)",
          "歷史帳" in r.stdout and "s0" in r.stdout, r.stdout[-400:])
    check("sevtail:低報轉述行出現且帶免責字樣", "[severity]" in r.stdout and "觀測,不進合取" in r.stdout, r.stdout[-400:])
    check("sevtail:新帳低報標寫側 bug", "寫側有 bug" in r.stdout, r.stdout[-400:])
    check("sevtail:advisory 不動 rc(四合取過=PASS 照舊)", r.returncode == 0 and "DISPOSAL GATE PASS" in r.stdout, f"rc={r.returncode}\n{r.stdout[-300:]}")
    alog = repo / "governance" / "review-reports" / "sevtail" / "roster-alerts.log"
    check("sevtail:留痕落 roster-alerts.log 且 kind=severity_underreport",
          alog.exists() and "severity_underreport:s1" in alog.read_text(encoding="utf-8"), "")
    # cb3 s3-f2:原「__seqN 尾巴沉默」釘現場走不到(混用守衛先 rc2,空 stdout 讓斷言恆真=假綠④型)。
    # 改釘真守衛:純 round-less 處置帳=讀側 fail-closed 拒判(cb3 ext-f1 繞道的讀側關門;真帳零此形狀)
    row2 = dict(row); row2.pop("round"); row2["token"] = "TT2"; row2["loop"] = "sevtail-rl"
    (v.parent / ".canary-log.jsonl").open("a", encoding="utf-8").write(_j.dumps(row2) + "\n")
    r2 = run(v, "loop", "status", "sevtail-rl", "--disposal", "--spec", str(spec), "--repo", str(repo))
    check("sevtail:round-less 處置帳讀側拒判 rc2(繞道關死)",
          r2.returncode == 2 and "必須綁輪次" in r2.stderr, f"rc={r2.returncode} {r2.stderr[:200]}")


# ── 逃逸帳對得起來(Projects/逃逸帳對得起來_計劃)──
def _mk_escape_fixture(review=(), converged=(), escapes=(), plans=None):
    """review:[(迴圈, tier或None)];converged:[迴圈](可重複、可帶 kind);escapes:逃逸列 dict;plans:{計劃名:[scope...]}。"""
    import json as _j
    v = mkvault()
    rows = []
    for lid, tier in review:
        r = {"ts": "2026-09-20T10:00:00+08:00", "kind": "none", "loop": lid, "round": "r1", "auditor": "s1",
             "severity": "minor", "findings": 0, "token": "T" + lid}
        if tier:
            r["tier"] = tier
        rows.append(r)
    (v.parent / ".canary-log.jsonl").write_text("".join(_j.dumps(r, ensure_ascii=False) + "\n" for r in rows), encoding="utf-8")
    gov = []
    for c in converged:
        lid, kind = (c if isinstance(c, tuple) else (c, "converged"))
        gov.append({"ts": "2026-09-21T10:00:00+08:00", "gate": "design-loop", "kind": kind, "nodes": [lid]})
    (v.parent / ".governance-log.jsonl").write_text("".join(_j.dumps(g, ensure_ascii=False) + "\n" for g in gov), encoding="utf-8")
    (v.parent / ".escape-log.jsonl").write_text("".join((e if isinstance(e, str) else _j.dumps(e, ensure_ascii=False)) + "\n" for e in escapes), encoding="utf-8")
    for name, scopes in (plans or {}).items():
        tags = "".join(f"\n  - scope/{x}" for x in scopes)
        write(v, f"Projects/{name}_計劃.md", f"type: project\nstatus: doing\ntags:\n  - type/project{tags}")
    return v


def _esc_stats(v):
    import json as _j
    r = run(v, "loop", "escape-stats", "--json")
    return _j.loads(r.stdout)


def _esc_row(loop, stage="CI", token=None, **kw):
    d = {"ts": "2026-09-22T10:00:00+08:00", "token": token or f"ESC-{loop}-{stage}", "loop": loop, "stage": stage,
         "severity": "major", "desc": "x"}
    d.update(kw)
    return d


def _esc_cat(st, kind, tier="standard", scope="未分類"):
    return next((c for c in st["categories"] if c["kind"] == kind and c["tier"] == tier and c["scope"] == scope), None)


def t_escape_loop_kind_written_and_inferred():
    """[S1] 新寫列帶 loop_kind;只看 loop 欄與審查紀錄(規格閘留痕不算);讀舊列用同一支推出同樣的值。"""
    import json as _j
    m = _load_lumos()
    ids = {"甲"}
    check("S1 code- 開頭 → code", m._escape_loop_kind("code-甲", ids) == "code", "")
    check("S1 有審查紀錄 → design", m._escape_loop_kind("甲", ids) == "design", "")
    check("S1 沒審查紀錄 → plan", m._escape_loop_kind("乙", ids) == "plan", "")
    v = _mk_escape_fixture(review=[("甲", "standard")])
    lg = v.parent / ".canary-log.jsonl"
    lg.write_text(lg.read_text(encoding="utf-8") + _j.dumps({"kind": "spec-gate", "loop": "乙", "token": "SPEC-1"}) + "\n", encoding="utf-8")
    check("S1 規格閘留痕不算審查紀錄", "乙" not in m._review_loop_ids(type("E", (), {"vault": v})()), "")
    run(v, "loop", "escape", "甲", "--stage", "CI", "--severity", "major", "--desc", "d", "--sha", "abc1234", expect_rc=0)
    rec = [_j.loads(l) for l in (v.parent / ".escape-log.jsonl").read_text(encoding="utf-8").splitlines() if l.strip()][-1]
    check("S1 手動記帳寫進 loop_kind=design", rec.get("loop_kind") == "design", repr(rec))


def t_escape_manual_requires_defect_ref():
    """[S2] 手動記帳 sha/defect_ref 都空(含只有空白)又沒有夠長的理由 → 擋;--sha 寫進列;理由寫進 defect_ref_missing。"""
    import json as _j
    v = _mk_escape_fixture(review=[("甲", "standard")])
    base = ["loop", "escape", "甲", "--stage", "CI", "--severity", "major", "--desc", "d"]
    _r0 = run(v, *base)
    check("S2 都沒有 → 擋,而且是因為沒附佐證", _r0.returncode == 2 and "要附佐證" in _r0.stderr, _r0.stderr[-200:])
    check("S2 只有空白 → 擋", run(v, *base, "--defect-ref", "   ").returncode == 2, "")
    check("S2 理由太短 → 擋", run(v, *base, "--missing-defect-ref", "!!").returncode == 2, "")
    run(v, *base, "--sha", "abc1234", expect_rc=0)
    run(v, *base, "--missing-defect-ref", "口頭回報沒留下提交", expect_rc=0)
    recs = [_j.loads(l) for l in (v.parent / ".escape-log.jsonl").read_text(encoding="utf-8").splitlines() if l.strip()]
    check("S2 --sha 寫進列", recs[0].get("sha") == "abc1234", repr(recs[0]))
    check("S2 理由寫進 defect_ref_missing", recs[1].get("defect_ref_missing") == "口頭回報沒留下提交", repr(recs[1]))


def t_escape_withdraw_hidden_from_stats_shown_in_list():
    """[S3] 撤回後統計不算、清單照列並標已撤回與理由。"""
    v = _mk_escape_fixture(review=[("甲", "standard")], converged=["甲"], escapes=[_esc_row("甲", token="ESC-A", sha="s1")])
    check("S3 撤回前算一條漏網", _esc_cat(_esc_stats(v), "design")["leaked"] == 1, "")
    run(v, "loop", "escape", "--withdraw", "ESC-A", "--reason", "重現後確認是誤判", "--withdrawn-by", "tester", expect_rc=0)
    check("S3 撤回後統計不算", _esc_cat(_esc_stats(v), "design")["leaked"] == 0, "")
    r = run(v, "loop", "escape", "--list")
    check("S3 清單照列並在那一列標已撤回與理由", "★已撤回(重現後確認是誤判" in r.stdout, r.stdout)
    r2 = run(v, "loop", "escape", "--list", "--withdrawn")
    check("S3 --list --withdrawn 只列撤回過的", "ESC" not in r2.stderr and "已撤回" in r2.stdout, r2.stdout)


def t_escape_withdraw_validation():
    """[S4] 目標不存在、本身是撤回紀錄、撤回者空白、理由不夠 → 擋且帳不變;鎖拿不到印擋下不拋例外。"""
    v = _mk_escape_fixture(review=[("甲", "standard")], escapes=[_esc_row("甲", token="ESC-A", sha="s1")])
    log = v.parent / ".escape-log.jsonl"
    before = log.read_text(encoding="utf-8")
    for name, args in (("目標不存在", ["--withdraw", "ESC-NOPE", "--reason", "理由夠長了", "--withdrawn-by", "t"]),
                       ("撤回者空白", ["--withdraw", "ESC-A", "--reason", "理由夠長了", "--withdrawn-by", "  "]),
                       ("理由不夠", ["--withdraw", "ESC-A", "--reason", "..", "--withdrawn-by", "t"])):
        r = run(v, "loop", "escape", *args)
        check(f"S4 {name} → 擋", r.returncode == 2 and "擋下" in r.stderr, r.stderr[-200:])
        check(f"S4 {name} → 帳不變", log.read_text(encoding="utf-8") == before, "")
    run(v, "loop", "escape", "--withdraw", "ESC-A", "--reason", "理由夠長了", "--withdrawn-by", "t", expect_rc=0)
    import json as _j
    wtok = [_j.loads(l) for l in log.read_text(encoding="utf-8").splitlines() if l.strip()][-1]["token"]
    r = run(v, "loop", "escape", "--withdraw", wtok, "--reason", "理由夠長了", "--withdrawn-by", "t")
    check("S4 撤回紀錄本身不能撤", r.returncode == 2 and "撤回紀錄" in r.stderr, r.stderr[-200:])
    # 鎖拿不到:在同一個行程換掉寫入鎖讓它拋逾時例外,走真正的指令入口
    import io, contextlib, sys as _sys
    m = _load_lumos()

    @contextlib.contextmanager
    def _busy(_v):
        raise RuntimeError("等了 60 秒還輪不到寫入(測試模擬)")
        yield
    m._vault_write_lock = _busy
    _argv = _sys.argv
    err = io.StringIO()
    try:
        _sys.argv = ["lumos", "--vault", str(v), "loop", "escape", "--withdraw", "ESC-A", "--reason", "理由夠長了", "--withdrawn-by", "t"]
        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
            try:
                rc = m.main()
            except SystemExit as e:
                rc = e.code
            except RuntimeError as e:
                rc = f"例外冒出來:{e}"
    finally:
        _sys.argv = _argv
    check("S4 鎖拿不到 → 印擋下、退出碼 2、不讓例外冒出來", rc == 2 and "擋下" in err.getvalue(), f"{rc!r} {err.getvalue()[-200:]}")


def t_escape_withdrawn_not_resurrected_by_auto():
    """[S5] 撤回後同 (迴圈,站名,sha) 再自動記 → 不寫新列。"""
    import json as _j
    m = _load_lumos()
    v = _mk_escape_fixture(review=[("甲", "standard")], escapes=[_esc_row("甲", token="ESC-A", sha="s1", auto=True)])
    run(v, "loop", "escape", "--withdraw", "ESC-A", "--reason", "重現後確認是誤判", "--withdrawn-by", "t", expect_rc=0)
    env = type("E", (), {"vault": v})()
    n = m._auto_escape(env, "CI", "major", "again", [("甲", None)], "s1", "CI")
    check("S5 撤回過的同觸發不補回", n == 0, str(n))


def t_escape_stats_rate_unit_is_loop():
    """[S6] 分子分母都是迴圈、只認 converged,率不超過 1,放行 0 的格不算率。"""
    v = _mk_escape_fixture(review=[("甲", "standard"), ("乙", "standard")], converged=["甲", ("乙", "cap-reached")],
                escapes=[_esc_row("甲", token="E1", sha="a"), _esc_row("甲", token="E2", sha="b"), _esc_row("甲", token="E3", sha="c")])
    c = _esc_cat(_esc_stats(v), "design")
    check("S6 同一迴圈三筆逃逸只算一個迴圈", c and c["released"] == 1 and c["leaked"] == 1 and c["rate"] <= 1, repr(c))
    check("S6 cap-reached 不算放行", c and c["released"] == 1, repr(c))


def t_escape_stats_next_stage_and_unknown_stage():
    """[S7] 實作、code-loop、push-gate 開頭 → 下一站接住;不認得的站名算漏網並另列。"""
    v = _mk_escape_fixture(review=[("甲", "standard"), ("乙", "standard")], converged=["甲", "乙"],
                escapes=[_esc_row("甲", stage="code-loop", token="E1", sha="a"), _esc_row("甲", stage="push-gate-unreviewed", token="E2", sha="b"),
                         _esc_row("乙", stage="消費專案真推送", token="E3", sha="c")])
    st = _esc_stats(v)
    c = _esc_cat(st, "design")
    check("S7 下一站接住另列、不算漏網", c["next_stage"] == 2 and c["leaked"] == 1, repr(c))
    check("S7 不認得的站名另列", st["totals"]["unknown_stage"] == 1, repr(st["totals"]))


def t_escape_stats_unattributed_and_unreleased_buckets():
    """[S8] 同佐證對到兩個以上放行迴圈 → 歸因不明;沒放行迴圈的逃逸另列;兩者都不進分子。"""
    v = _mk_escape_fixture(review=[("甲", "standard"), ("乙", "standard"), ("丙", "standard")], converged=["甲", "乙"],
                escapes=[_esc_row("甲", token="E1", sha="same"), _esc_row("乙", token="E2", sha="same"), _esc_row("丙", token="E3", sha="z")])
    st = _esc_stats(v)
    c = _esc_cat(st, "design")
    check("S8 歸因不明不進分子", c["leaked"] == 0 and st["totals"]["unattributed"] == 2, repr(st))
    check("S8 未放行迴圈的逃逸另列", st["totals"]["unreleased"] == 1, repr(st["totals"]))


def t_escape_stats_category_untiered_and_multi_scope():
    """[S9] 沒分級 → 未定錨;分級不一致取第一筆;兩個範圍標籤各算一次。"""
    import json as _j
    v = _mk_escape_fixture(review=[("甲", None), ("乙", "standard")], converged=["甲", "乙"], plans={"乙": ["evals", "guards-gates"]})
    lg = v.parent / ".canary-log.jsonl"
    lg.write_text(lg.read_text(encoding="utf-8") + _j.dumps({"kind": "none", "loop": "乙", "round": "r2", "tier": "high", "token": "X"}) + "\n", encoding="utf-8")
    st = _esc_stats(v)
    check("S9 沒分級 → 未定錨", _esc_cat(st, "design", "未定錨") is not None, repr(st["categories"]))
    check("S9 分級不一致取第一筆(standard)", _esc_cat(st, "design", "standard", "evals") is not None and _esc_cat(st, "design", "high", "evals") is None, repr(st["categories"]))
    check("S9 兩個範圍標籤各算一次", _esc_cat(st, "design", "standard", "guards-gates") is not None, repr(st["categories"]))


def t_plan_for_loop_strips_code_prefix_nfc():
    """[S10] code- 開頭先去前綴,兩邊 NFC 後找到計劃。"""
