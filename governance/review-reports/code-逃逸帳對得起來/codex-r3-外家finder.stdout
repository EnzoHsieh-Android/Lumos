   103	def t_escape_withdraw_validation():
   104	    """[S4] 目標不存在、本身是撤回紀錄、撤回者空白、理由不夠 → 擋且帳不變;鎖拿不到印擋下不拋例外。"""
   105	    v = _mk_escape_fixture(review=[("甲", "standard")], escapes=[_esc_row("甲", token="ESC-A", sha="s1")])
   106	    log = v.parent / ".escape-log.jsonl"
   107	    before = log.read_text(encoding="utf-8")
   108	    for name, args in (("目標不存在", ["--withdraw", "ESC-NOPE", "--reason", "理由夠長了", "--withdrawn-by", "t"]),
   109	                       ("撤回者空白", ["--withdraw", "ESC-A", "--reason", "理由夠長了", "--withdrawn-by", "  "]),
   110	                       ("理由不夠", ["--withdraw", "ESC-A", "--reason", "..", "--withdrawn-by", "t"])):
   111	        r = run(v, "loop", "escape", *args)
   112	        check(f"S4 {name} → 擋", r.returncode == 2 and "擋下" in r.stderr, r.stderr[-200:])
   113	        check(f"S4 {name} → 帳不變", log.read_text(encoding="utf-8") == before, "")
   114	    run(v, "loop", "escape", "--withdraw", "ESC-A", "--reason", "理由夠長了", "--withdrawn-by", "t", expect_rc=0)
   115	    import json as _j
   116	    wtok = [_j.loads(l) for l in log.read_text(encoding="utf-8").splitlines() if l.strip()][-1]["token"]
   117	    r = run(v, "loop", "escape", "--withdraw", wtok, "--reason", "理由夠長了", "--withdrawn-by", "t")
   118	    check("S4 撤回紀錄本身不能撤", r.returncode == 2 and "撤回紀錄" in r.stderr, r.stderr[-200:])
   119	    # 鎖拿不到:在同一個行程換掉寫入鎖讓它拋逾時例外,走真正的指令入口
   120	    import io, contextlib, sys as _sys
   121	    m = _load_lumos()
   122	
   123	    @contextlib.contextmanager
   124	    def _busy(_v):
   125	        raise RuntimeError("等了 60 秒還輪不到寫入(測試模擬)")
   126	        yield
   127	    m._vault_write_lock = _busy
   128	    _argv = _sys.argv
   129	    err = io.StringIO()
   130	    try:
   131	        _sys.argv = ["lumos", "--vault", str(v), "loop", "escape", "--withdraw", "ESC-A", "--reason", "理由夠長了", "--withdrawn-by", "t"]
   132	        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
   133	            try:
   134	                rc = m.main()
   135	            except SystemExit as e:
   136	                rc = e.code
   137	            except RuntimeError as e:
   138	                rc = f"例外冒出來:{e}"
   139	    finally:
   140	        _sys.argv = _argv
   141	    check("S4 鎖拿不到 → 印擋下、退出碼 2、不讓例外冒出來", rc == 2 and "擋下" in err.getvalue(), f"{rc!r} {err.getvalue()[-200:]}")
   142	
