    96	    check("S3 撤回後統計不算", _esc_cat(_esc_stats(v), "design")["leaked"] == 0, "")
    97	    r = run(v, "loop", "escape", "--list")
    98	    check("S3 清單照列並在那一列標已撤回與理由", "★已撤回(重現後確認是誤判" in r.stdout, r.stdout)
    99	    r2 = run(v, "loop", "escape", "--list", "--withdrawn")
   100	    check("S3 --list --withdrawn 只列撤回過的", "ESC" not in r2.stderr and "已撤回" in r2.stdout, r2.stdout)
