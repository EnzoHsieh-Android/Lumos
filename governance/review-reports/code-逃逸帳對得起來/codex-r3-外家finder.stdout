def _sc_diffusion(env, rr, files, links, base=None):
    """擴散:檔數/目錄數上限、每支都在計劃落點(lands_in/related 節點的 about_code)內。"""
    C, bad = _SMALL_CHANGE, []
    code = [f for f in files if _is_code_file(rr, f[0], base)]   # 擴散與落點只算需要有家的程式檔;文件/圖/資料只在相對量那一維度算(2026-09-18:README+圖把目錄數撐破)
    dirs = {str(Path(f[0]).parent) for f in code}
    if len(code) > C["max_files"] or len(dirs) > C["max_dirs"]:
        bad.append(f"擴散:碰了 {len(code)} 個程式檔/{len(dirs)} 個目錄,小改動上限 {C['max_files']} 檔/{C['max_dirs']} 目錄")
    _homes, own = _impact_home_map(env)
    allowed = set()
    for lk in links:
        allowed |= own.get(lk + ".md", set()) | own.get(lk, set())
    # 落點只查「需要有家的程式檔」(每支檔有家同一套定義 _nodehome_code_kind);README/圖/JSON 這種不需要家的檔只算檔數與改動量(2026-09-18 實測:改 README 被判落點外)
    outside = [f[0] for f in code if _nodehome_key(f[0]) not in allowed]
    if outside:
        bad.append("落點外:" + "、".join(outside[:5]) + (f" 等 {len(outside)} 支" if len(outside) > 5 else "") + "(計劃 lands_in/related 那些節點的 about_code 沒列它)")
    return bad


def _sc_churn(rr, git_range, files):
    """相對量:每檔 (新增+刪除) ≤ 原本行數×比例 或 ≤ 絕對上限;二進位算不出量不當小改動;原本行數用舊路徑查 base 樹(r3 通才席)。"""
    C, bad = _SMALL_CHANGE, []
    base = _range_base(rr, git_range)   # 三點範圍要 merge-base(代碼審 r2 架構席:同檔同算法要收斂成一份)
    for path, la, ld, binary, old in files:
        if binary:
            bad.append(f"相對量:{path} 是二進位檔,算不出改動量,不當小改動")
            continue
        churn = la + ld
        if churn <= C["max_abs_lines"]:
            continue
        lt = None
        if base:
            g = subprocess.run(["git", "-C", str(rr), "show", f"{base}:{old}"], capture_output=True, text=True, errors="replace")
            lt = len(g.stdout.splitlines()) if g.returncode == 0 else 0
        if lt is None or churn > lt * C["max_rel_churn"]:
            bad.append(f"相對量:{path} 改了 {churn} 行(原本 {lt if lt is not None else '?'} 行),超過 {int(C['max_rel_churn'] * 100)}% 也超過 {C['max_abs_lines']} 行")
    return bad


def _sc_history(env, rr, files, links):
    """歷史:落點掛 risk/ 標籤、碰到裁判檔(錨點清單/scripts/hooks/)、近 N 天逃逸帳有同落點的列。"""
    C, bad = _SMALL_CHANGE, []
    for lk in links:
        hn = env.notes.get(lk + ".md") or env.notes.get(lk)
        if hn is not None and any(str(t).startswith("risk/") for t in as_list(hn.fields.get("tags"))):
            bad.append(f"歷史:落點 {lk} 掛了風險標籤,不算小改動")
    anchors = set()
    try:   # 錨點清單走既有路徑常數與解析寫法(r1 架構席)
        import json as _j
        anchors = {nfc(str(k)) for k in (_j.loads((rr / _ANCHOR_BASELINE_REL).read_text(encoding="utf-8")).get("anchors") or {})}
    except (OSError, ValueError, AttributeError):
        pass
    judge = [f[0] for f in files if f[0] in anchors or f[0].startswith("scripts/hooks/")]
    if judge:
        bad.append("歷史:碰到裁判檔(hook/錨點):" + "、".join(judge[:5]))
    import datetime as _dt
    cutoff_str = (_dt.datetime.now().astimezone() - _dt.timedelta(days=C["escape_days"])).isoformat()
    cutoff_key = _loop_ts_key(cutoff_str)
    for e in _escape_rows_for(env):
        k = _loop_ts_key(str(e.get("ts", "")))   # 換算 UTC 再比(r1 兩席);解析不動退回字串比對(r2 複核)
        too_old = (str(e.get("ts", "")) < cutoff_str) if (k is None or cutoff_key is None) else (k < cutoff_key)
        if too_old or not e.get("plan"):
            continue
        en = env.notes.get(str(e["plan"]))
        if en is not None and set(_plan_system_links(en)) & set(links):
            bad.append(f"歷史:近 {C['escape_days']} 天逃逸帳有同落點的列(迴圈 {e.get('loop')},{str(e.get('ts'))[:10]}),這個落點最近出過事")
            break
    return bad


def _small_change_check(env, rr, git_range, prel, note):
    """全靠人驗的風險低計劃的推送閘:回沒過的原因清單(空=過)。四維度各一支:擴散 _sc_diffusion、相對量 _sc_churn、歷史 _sc_history、目的(計劃連 Issues 不算小改動)。"""
    try:
        vrel = str(env.vault.resolve().relative_to(rr)).replace(os.sep, "/")
    except ValueError:
        vrel = None
    files, err = _sc_changed_files(rr, git_range, vrel)
    if files is None:
        return [err]
    if not files:
        return []
    links = _plan_system_links(note)
    base = _range_base(rr, git_range)
    bad = _sc_diffusion(env, rr, files, links, base) + _sc_churn(rr, git_range, files) + _sc_history(env, rr, files, links)
    try:
        ptxt = (env.vault / prel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        ptxt = ""
    if any(str(lk).startswith("Issues/") for lk in _plan_system_links(note, text=ptxt, systems_only=False)):
        bad.append("目的:計劃連到 Issues(修 bug),缺陷率高於新功能,不算小改動")
    return bad


def _spec_gate_push_stale(env, rr, prel, n, rec):
    """推送前先驗留痕還算不算數:讀得到、綁得到、門重判仍是雙向、條款指紋沒變。回原因或 None。"""
    try:
        text = (env.vault / prel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        return f"{prel}:讀不成文字({e.__class__.__name__})"
            try:
                if _pp.exists() and SPEC_CLAUSE_RE.search(_pp.read_text(encoding="utf-8", errors="replace")):
                    _with += 1
            except OSError:
                pass
        if not _new:
            ok("有條款的計劃比例 0/0,還沒有計劃掛條款(句式閘上線後還沒有新迴圈)")
        else:
            ok(f"有條款的計劃比例 {_with}/{len(_new)}(分母=首筆帳晚於 {_SPEC_GATE_SINCE[:10]} 的設計迴圈;RETIRE-IF ① 看它降不降)")
        _latest = {}
        _gl = env.vault.parent / ".governance-log.jsonl"
        if _gl.exists():
            for _ln in _gl.read_text(encoding="utf-8", errors="replace").splitlines():
                try:
                    _d = json.loads(_ln)
                except ValueError:
                    continue
                if isinstance(_d, dict) and _d.get("kind") == "spec-gate-run":
                    for _nd in _d.get("nodes") or []:
                        _latest[str(_nd)] = _d.get("note", "")
        if _latest:
            _rows = []
            for _nd, _note in sorted(_latest.items()):
                _m = re.search(r"red=(\d+) green=(\d+) weak=(\d+)", _note or "")
                _rows.append(f"{Path(_nd).stem}: 紅 {_m.group(1)}/綠 {_m.group(2)}/弱證據 {_m.group(3)}" if _m else f"{Path(_nd).stem}: {_note}")
            warn_soft(_rows, f"最近一次規格閘跑出來的紅綠弱證據({len(_rows)} 份計劃;紅=新行為還沒做,綠=做完或既有,弱=證據不夠):",
                      "紅的條款做完會變綠;一直紅=沒人理它,RETIRE-IF ② 看這個")
        else:
            ok("還沒有任何計劃跑過規格閘(lumos spec-gate <計劃>)")
    except Exception as _e:   # 健檢一段壞了不能拖垮整份;標題寫「不擋」就只准 warn_soft
