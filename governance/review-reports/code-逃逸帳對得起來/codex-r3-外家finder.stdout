   229	    rows = [_esc_row("甲", token="E1", rule="R-X"), _esc_row("甲", token="E2", rule="R-X"),
   230	            {"kind": "withdraw", "target": "E2", "reason": "誤判", "by": "t", "token": "W1"}]
   231	    (repo / ".escape-log.jsonl").write_text("".join(_j.dumps(r, ensure_ascii=False) + "\n" for r in rows), encoding="utf-8")
   232	    r = _sp.run([sys.executable, GRAPHCTL, "rule-gap", "--repo", str(repo), "--json"], capture_output=True, text=True)
   233	    d = _j.loads(r.stdout)
   234	    check("S13 讀得到且撤回的不算", d["missing"].get("R-X", {}).get("n") == 1, r.stdout + r.stderr)
