    17	def _mk_escape_fixture(review=(), converged=(), escapes=(), plans=None):
    18	    """review:[(迴圈, tier或None)];converged:[迴圈](可重複、可帶 kind);escapes:逃逸列 dict;plans:{計劃名:[scope...]}。"""
    19	    import json as _j
    20	    v = mkvault()
    21	    rows = []
    22	    for lid, tier in review:
    23	        r = {"ts": "2026-09-20T10:00:00+08:00", "kind": "none", "loop": lid, "round": "r1", "auditor": "s1",
    24	             "severity": "minor", "findings": 0, "token": "T" + lid}
    25	        if tier:
    26	            r["tier"] = tier
    27	        rows.append(r)
    28	    (v.parent / ".canary-log.jsonl").write_text("".join(_j.dumps(r, ensure_ascii=False) + "\n" for r in rows), encoding="utf-8")
    29	    gov = []
    30	    for c in converged:
    31	        lid, kind = (c if isinstance(c, tuple) else (c, "converged"))
    32	        gov.append({"ts": "2026-09-21T10:00:00+08:00", "gate": "design-loop", "kind": kind, "nodes": [lid]})
    33	    (v.parent / ".governance-log.jsonl").write_text("".join(_j.dumps(g, ensure_ascii=False) + "\n" for g in gov), encoding="utf-8")
    34	    (v.parent / ".escape-log.jsonl").write_text("".join((e if isinstance(e, str) else _j.dumps(e, ensure_ascii=False)) + "\n" for e in escapes), encoding="utf-8")
    35	    for name, scopes in (plans or {}).items():
    36	        tags = "".join(f"\n  - scope/{x}" for x in scopes)
    37	        write(v, f"Projects/{name}_計劃.md", f"type: project\nstatus: doing\ntags:\n  - type/project{tags}")
    38	    return v
