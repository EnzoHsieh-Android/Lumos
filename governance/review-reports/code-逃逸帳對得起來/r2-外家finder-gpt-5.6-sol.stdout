  7091	def _parse_clusters(raw):
  7092	    """M2 risk-cluster 寫側解析:--clusters '名=狀態,...' → (dict{名:狀態}, None) 或 (None, 錯誤訊息)。
  7093	    三態白名單;accepted-minor 需冒號內嵌理由(整筆單一 note 對多 accepted-minor 無法對應=模糊過帳);
  7094	    尾逗號空段靜默過濾,但過濾後空列表=rc2(帶旗標即須有效內容,無「空字串=未帶」特例);
  7095	    設計:Projects/design-loop提效_計劃 M2(golden: governance/golden/dloop-m2-cluster)。"""
  7096	    parts = [p.strip() for p in str(raw).split(",") if p.strip()]
  7097	    if not parts:
  7098	        return None, "帶了 --clusters 但無有效內容(空字串/全逗號)"
  7099	    out = {}
  7100	    for p in parts:
  7101	        if "=" not in p:
  7102	            return None, f"段缺 '='(格式 名=狀態): {p!r}"
  7103	        name, state = p.split("=", 1)
  7104	        name, state = name.strip(), state.strip()
  7105	        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", name):
  7106	            return None, f"cluster 名非法(kebab 短 slug:小寫英數起頭+[-_],≤64): {name!r}"
  7107	        base = state.split(":", 1)[0]
  7108	        if base not in CLUSTER_STATES:
  7109	            return None, f"狀態 {base!r} 不在白名單 {'/'.join(CLUSTER_STATES)}"
  7110	        if base == "accepted-minor":
