  9857	def _escape_released_loops(env, review_ids):
  9858	    """放行了的迴圈:治理帳有 converged 紀錄(設計審與代碼審過處置閘都寫在 gate=design-loop 這個閘名下、
  9859	    nodes 帶編號;有任何一筆 converged 就算),而且審查帳有它的審查紀錄。"""
  9860	    released = set()
  9861	    try:
  9862	        for ln in (env.vault.parent / ".governance-log.jsonl").read_text(encoding="utf-8", errors="replace").splitlines():
  9863	            try:
  9864	                d = json.loads(ln)
  9865	            except ValueError:
  9866	                continue
  9867	            if (isinstance(d, dict) and d.get("kind") == "converged" and d.get("gate") == "design-loop"
  9868	                    and isinstance(d.get("nodes"), list) and d["nodes"] and isinstance(d["nodes"][0], str)):
  9869	                lid = nfc(d["nodes"][0])
  9870	                if lid in review_ids:
  9871	                    released.add(lid)
  9872	    except OSError:
  9873	        pass
  9874	    return released
