  9893	def _escape_stats(env):
  9894	    """逃逸率依類別(Projects/逃逸帳對得起來_計劃 第四節):單位一律是迴圈。回 dict,唯讀。"""
  9895	    rows = _escape_rows_for(env)                      # 已去掉撤回紀錄與被撤回的列
  9896	    review_ids = _review_loop_ids(env)
  9897	    by_loop = _escape_review_rows_by_loop(env)
  9898	    released = _escape_released_loops(env, review_ids)
  9899	
  9900	    _cat_cache = {}
  9901	
  9902	    def _cats(lid):   # 每個迴圈只算一次(r1 併發席:原本每一列逃逸都重讀計劃)
  9903	        if lid not in _cat_cache:
  9904	            kind = "code" if lid.startswith("code-") else "design"
  9905	            tier = _loop_anchor_tier(by_loop.get(lid, [])) or "未定錨"
  9906	            _cat_cache[lid] = [(kind, tier, sc) for sc in _escape_plan_scopes(env, lid)]
  9907	        return _cat_cache[lid]
  9908	
  9909	    cats = {}
  9910	    for lid in released:
  9911	        for c in _cats(lid):
  9912	            cats.setdefault(c, {"released": set(), "leaked": set(), "next": 0})["released"].add(lid)
  9913	    totals = {"no_evidence": 0, "unattributed": 0, "unknown_stage": 0, "unreleased": 0, "plan": 0,
  9914	              "withdrawn": len(_escape_withdrawn_targets(_escape_raw_rows(env)))}
  9915	    ev_loops = _escape_shared_evidence(rows, released)
  9916	    for r in rows:
  9917	        lid = nfc(str(r.get("loop", "")))
  9918	        bucket = _escape_row_bucket(r, lid, review_ids, released, ev_loops)
  9919	        if bucket in ("plan", "unreleased", "unattributed"):
  9920	            totals[bucket] += 1
  9921	            continue
  9922	        if bucket == "no_evidence":
  9923	            totals["no_evidence"] += 1
  9924	        cls = _escape_stage_class(r.get("stage"))
  9925	        for c in _cats(lid):
  9926	            if cls == "next":
  9927	                cats[c]["next"] += 1
  9928	            else:
  9929	                cats[c]["leaked"].add(lid)
  9930	        if cls == "unknown":
  9931	            totals["unknown_stage"] += 1
  9932	    return {"categories": _escape_cat_rows(cats), "totals": totals}
