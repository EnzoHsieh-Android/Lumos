 14195	def _vault_lock_say(lock, why):
 14196	    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
 14197	    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
 14198	    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
 14199	    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
 14200	    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
 14201	          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
 14202	    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
 14203	          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
 14204	          file=sys.stderr)
 14205	    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
 14206	    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)
 14207	
 14208	
 14209	def _vault_write_lock(vault):
 14210	    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
 14211	    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。
 14212	
 14213	    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
 14214	    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
 14215	    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
 14216	    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
 14217	    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
 14218	    import contextlib, time as _t
 14219	
 14220	    @contextlib.contextmanager
 14221	    def _cm():
 14222	        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
 14223	        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
 14224	        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
 14225	        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
 14226	        lock, why = _vault_lock_where(vault)
 14227	        k = str(lock)
 14228	
 14229	        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
 14230	            _VAULT_LOCK_HELD[k] += 1
 14231	            try:
 14232	                yield
 14233	            finally:
 14234	                _VAULT_LOCK_HELD[k] -= 1
 14235	            return
 14236	
 14237	        if why and not _VAULT_LOCK_WARNED.get(k):
 14238	            _VAULT_LOCK_WARNED[k] = True
 14239	            _vault_lock_say(lock, why)
 14240	        deadline = _t.monotonic() + 60
 14241	        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
 14242	            if _t.monotonic() > deadline:
 14243	                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
 14244	            _t.sleep(0.05)
 14245	        _VAULT_LOCK_HELD[k] = 1
 14246	        try:
 14247	            yield
 14248	        finally:
 14249	            _VAULT_LOCK_HELD.pop(k, None)
 14250	            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
 14251	                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
 14252	                    lock.unlink()
 14253	            except OSError:
 14254	                pass
 14255	    return _cm()
 14256	
