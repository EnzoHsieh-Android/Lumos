  9571	    if not parent.is_dir():
  9572	        return False
  9573	    want = nfc(Path(plan_rel).name)
  9574	    try:
  9575	        return any(nfc(q.name) == want for q in parent.iterdir())
  9576	    except OSError:
  9577	        return False
