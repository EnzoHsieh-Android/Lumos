  9503	def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
  9504	    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
  9505	    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
  9506	    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
  9507	    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
  9508	    log = env.vault.parent / ".escape-log.jsonl"
  9509	    ledger = env.vault.parent / ".canary-log.jsonl"
  9510	    known = set()
  9511	    if ledger.exists():
  9512	        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
  9513	            if not ln.strip():
  9514	                continue
  9515	            try:
  9516	                v = json.loads(ln).get("loop")
  9517	            except ValueError:
  9518	                continue
  9519	            if isinstance(v, str):
  9520	                known.add(nfc(v))
  9521	    import datetime as _dt
  9522	    import secrets as _sec
  9523	    review_ids = _review_loop_ids(env)
  9524	    written = 0
  9525	    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
  9526	    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
  9527	    with _vault_write_lock(env.vault):
  9528	        existing = set()
  9529	        for r in _escape_rows_for(env, include_withdrawn=True):   # 撤回過的仍算記過,同觸發不會悄悄補回來
  9530	            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
  9531	        for loop_id, plan_rel in loops:
  9532	            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
  9533	            if nfc(loop_id) in known:
  9534	                attribution = "ledger"
  9535	            elif plan_ok:
  9536	                attribution = "plan-file"
  9537	            else:
  9538	                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
  9539	                continue
  9540	            door = _door_for_loop(env, loop_id)
  9541	            if stage == "push-gate-unreviewed" and door != "low":
  9542	                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
  9543	                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
  9544	                continue
  9545	            if (nfc(loop_id), stage, sha) in existing:
  9546	                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
  9547	                continue
  9548	            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
  9549	                   "token": "ESC-" + _sec.token_hex(4),
  9550	                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
