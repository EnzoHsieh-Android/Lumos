 14273	        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)},"
 14274	              f"以及整欄換掉的 {'、'.join(COND_KEYS)}"
 14275	              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
 14276	        return 2
