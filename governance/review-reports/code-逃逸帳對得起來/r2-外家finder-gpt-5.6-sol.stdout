  9958	def cmd_loop_escape_stats(env, as_json=False):
  9959	    """唯讀:逃逸率依類別(分級 × 範圍類)。"""
  9960	    st = _escape_stats(env)
  9961	    if as_json:
  9962	        print(json.dumps(st, ensure_ascii=False))
  9963	        return 0
  9964	    print("逃逸率依類別(單位:迴圈;分母=處置閘過關放行的迴圈,分子=其中有漏網的迴圈;撤回的不算)")
  9965	    if not st["categories"]:
  9966	        print("  還沒有放行的迴圈可算")
  9967	    for c in st["categories"]:
  9968	        rate = "—" if c["rate"] is None else f"{c['rate']:.0%}"
  9969	        ci = "" if not c["ci95"] else f"(95% 區間 {c['ci95'][0]:.0%} 至 {c['ci95'][1]:.0%})"
  9970	        line = (f"  {c['kind']} × {c['tier']} × {c['scope']}:放行 {c['released']}、有漏網 {c['leaked']}、率 {rate}{ci}"
  9971	                f"、下一站接住 {c['next_stage']}")
  9972	        if c["small_sample"]:
  9973	            line += "  ★樣本太少不下結論(放行少於 20)★"
  9974	        if c["kind"] == "code":
  9975	            line += "  (code 類只含手動記的逃逸,低估)"
  9976	        print(line)
  9977	    t = st["totals"]
  9978	    print(f"  另列:無佐證 {t['no_evidence']} 列、歸因不明 {t['unattributed']} 列、站名不認得 {t['unknown_stage']} 列、"
  9979	          f"未放行迴圈的逃逸 {t['unreleased']} 列、沒審查帳的計劃 {t['plan']} 列、撤回過 {t['withdrawn']} 列")
  9980	    print("  範圍類有兩個以上標籤的計劃每類各算一次,各列加總會大於全體")
  9981	    return 0
