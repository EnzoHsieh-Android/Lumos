  9831	def _escape_plan_scopes(env, loop_id):
  9832	    """迴圈對應計劃的 scope/<類> 標籤;對不到計劃或沒標就 ["未分類"]。欄位照全檔慣例從 env.notes 讀。"""
  9833	    rel = _plan_for_loop(env, loop_id)
  9834	    n = env.notes.get(rel) if rel else None
  9835	    if n is None:
  9836	        return ["未分類"]
  9837	    sc = [t[len("scope/"):] for t in as_list(n.fields.get("tags")) if isinstance(t, str) and t.startswith("scope/")]
  9838	    return sc or ["未分類"]
  9839	
  9840	
  9841	def _escape_review_rows_by_loop(env):
  9842	    """審查帳裡的審查紀錄,依迴圈編號(NFC)分組;規格閘留痕不算。"""
  9843	    by_loop = {}
  9844	    try:
  9845	        for ln in (env.vault.parent / ".canary-log.jsonl").read_text(encoding="utf-8", errors="replace").splitlines():
  9846	            try:
  9847	                d = json.loads(ln)
  9848	            except ValueError:
  9849	                continue
  9850	            if isinstance(d, dict) and d.get("kind") in _REVIEW_RECORD_KINDS and isinstance(d.get("loop"), str):
  9851	                by_loop.setdefault(nfc(d["loop"]), []).append(d)
  9852	    except OSError:
  9853	        pass
  9854	    return by_loop
  9855	
