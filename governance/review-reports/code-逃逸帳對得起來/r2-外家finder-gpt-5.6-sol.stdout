 33016	def _mk_escape_fixture(review=(), converged=(), escapes=(), plans=None):
 33017	    """review:[(迴圈, tier或None)];converged:[迴圈](可重複、可帶 kind);escapes:逃逸列 dict;plans:{計劃名:[scope...]}。"""
 33018	    import json as _j
 33019	    v = mkvault()
 33020	    rows = []
 33021	    for lid, tier in review:
 33022	        r = {"ts": "2026-09-20T10:00:00+08:00", "kind": "none", "loop": lid, "round": "r1", "auditor": "s1",
 33023	             "severity": "minor", "findings": 0, "token": "T" + lid}
 33024	        if tier:
 33025	            r["tier"] = tier
 33026	        rows.append(r)
 33027	    (v.parent / ".canary-log.jsonl").write_text("".join(_j.dumps(r, ensure_ascii=False) + "\n" for r in rows), encoding="utf-8")
 33028	    gov = []
 33029	    for c in converged:
 33030	        lid, kind = (c if isinstance(c, tuple) else (c, "converged"))
 33031	        gov.append({"ts": "2026-09-21T10:00:00+08:00", "gate": "design-loop", "kind": kind, "nodes": [lid]})
 33032	    (v.parent / ".governance-log.jsonl").write_text("".join(_j.dumps(g, ensure_ascii=False) + "\n" for g in gov), encoding="utf-8")
 33033	    (v.parent / ".escape-log.jsonl").write_text("".join((e if isinstance(e, str) else _j.dumps(e, ensure_ascii=False)) + "\n" for e in escapes), encoding="utf-8")
 33034	    for name, scopes in (plans or {}).items():
 33035	        tags = "".join(f"\n  - scope/{x}" for x in scopes)
 33036	        write(v, f"Projects/{name}_計劃.md", f"type: project\nstatus: doing\ntags:\n  - type/project{tags}")
 33037	    return v
