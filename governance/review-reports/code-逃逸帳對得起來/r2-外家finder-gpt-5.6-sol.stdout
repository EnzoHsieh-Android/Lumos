  9806	_ESCAPE_NEXT_STAGES = ("實作", "code-loop")   # 以 push-gate 開頭的站名也算下一站接住
  9807	_ESCAPE_LEAK_STAGES = ("CI", "prod", "使用者回報")
  9808	_ESCAPE_STATS_MIN_N = 20
