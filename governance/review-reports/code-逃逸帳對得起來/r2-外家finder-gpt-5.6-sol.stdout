  9823	def _escape_stage_class(stage):
  9824	    """站名分類:next=下一站就接住、leak=漏網、unknown=不認得(算漏網、另列)。"""
  9825	    st = str(stage or "")
  9826	    if st in _ESCAPE_NEXT_STAGES or st.startswith("push-gate"):
  9827	        return "next"
  9828	    return "leak" if st in _ESCAPE_LEAK_STAGES else "unknown"
