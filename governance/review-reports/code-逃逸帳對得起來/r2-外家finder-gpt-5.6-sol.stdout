  9934	
  9935	def _escape_row_bucket(r, lid, review_ids, released, ev_loops):
  9936	    """一列逃逸落在哪一桶:plan / unreleased / unattributed / no_evidence(仍算進它的迴圈)/ counted。"""
  9937	    kind = r.get("loop_kind") if r.get("loop_kind") in ("code", "design", "plan") else _escape_loop_kind(lid, review_ids)
  9938	    if kind == "plan":   # 落帳時已決定的種類為準,不因後來才有審查紀錄就事後改類(r1 外家兩席)
  9939	        return "plan"
  9940	    if lid not in released:
  9941	        return "unreleased"
  9942	    keys = _escape_evidence_keys(r)
  9943	    if not keys:
  9944	        return "no_evidence"
  9945	    return "unattributed" if any(len(ev_loops.get(k, ())) > 1 for k in keys) else "counted"
  9946	
  9947	
  9948	def _escape_cat_rows(cats):
  9949	    out = []
  9950	    for (kind, tier, sc), v in sorted(cats.items(), key=lambda kv: (kv[0][0], str(kv[0][1]), kv[0][2])):
  9951	        n, k = len(v["released"]), len(v["leaked"])
  9952	        out.append({"kind": kind, "tier": tier, "scope": sc, "released": n, "leaked": k,
  9953	                    "rate": (k / n) if n else None, "ci95": _wilson_interval(k, n), "next_stage": v["next"],
  9954	                    "small_sample": n < _ESCAPE_STATS_MIN_N})
  9955	    return out
  9956	
