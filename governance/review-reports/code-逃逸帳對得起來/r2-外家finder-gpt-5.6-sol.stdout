  9498	        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
  9499	            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
  9500	    return door
