  9877	def _escape_evidence_keys(r):
  9878	    """一列的佐證:sha 與 defect_ref 各算一個鍵(r1 外家否決席:只取其一時,同一個 defect_ref 配不同 sha 會逃過比對)。"""
  9879	    return [f"{k}:{str(r.get(k) or '').strip()}" for k in ("sha", "defect_ref") if str(r.get(k) or "").strip()]
  9880	
