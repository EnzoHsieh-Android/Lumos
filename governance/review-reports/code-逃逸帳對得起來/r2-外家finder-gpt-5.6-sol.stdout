 25515	def _ci_red_escape(env, sha, concl, workflow):
 25516	    """CI 紅 → 逃逸自動記(規格落成可驗收條件_計劃 第五節第三來源)。
 25517	    範圍=上一個綠 sha..這個 sha(帳上找;找不到就 sha^..sha);碰到的計劃各記一筆,對不回不記。
 25518	    ★fail-open★:任何一步失敗只印一行,不影響 CI 帳。"""
 25519	    try:
 25520	        root = env.vault.parent.parent
 25521	        prev_green = None
 25522	        lp = _ci_log_path(env)
 25523	        if lp.exists():
 25524	            for ln in lp.read_text(encoding="utf-8", errors="replace").splitlines():
 25525	                if not ln.strip():
 25526	                    continue
 25527	                try:
 25528	                    d = json.loads(ln)
 25529	                except ValueError:
 25530	                    continue
 25531	                if isinstance(d, dict) and d.get("sha") and d.get("sha") != sha and (d.get("conclusion") or "") in _CI_GREEN:
 25532	                    prev_green = d["sha"]
 25533	        rng = f"{prev_green}..{sha}" if prev_green else f"{sha}^..{sha}"
 25534	        plans = _plans_in_range(root, rng, env.vault)
 25535	        if not plans:
 25536	            return 0
 25537	        vrel = str(Path(env.vault).resolve().relative_to(Path(root).resolve())).replace(os.sep, "/")
 25538	        loops = [(_loop_id_for_plan(pl), pl[len(vrel) + 1:]) for pl in plans]
 25539	        return _auto_escape(env, "CI", "major", f"CI {concl} {sha[:7]} [{workflow}]", loops, sha, source="CI")
 25540	    except Exception as _ex:
 25541	        _escape_auto_failed(env, "?", "CI", str(_ex))
 25542	        return 0
