 33350	# ── 審查跑滿上限提示(Projects/審查跑滿上限提示_計劃)──
 33351	def _cap_real_cutoff(fn):
 33352	    """測試總開關把舊閘退役日設成 9999(舊測試凍結在退役前語意);跑滿上限提示只給退役後的迴圈,
 33353	    這幾支在跑的期間改回真實退役日,跑完還原。"""
 33354	    import functools
 33355	    @functools.wraps(fn)
 33356	    def _w(*a, **k):
 33357	        old = _os_mod.environ.get("LUMOS_PANEL_RETIRE_CUTOFF")
 33358	        _os_mod.environ["LUMOS_PANEL_RETIRE_CUTOFF"] = "2026-08-26"
 33359	        try:
 33360	            return fn(*a, **k)
 33361	        finally:
 33362	            if old is None:
 33363	                _os_mod.environ.pop("LUMOS_PANEL_RETIRE_CUTOFF", None)
 33364	            else:
 33365	                _os_mod.environ["LUMOS_PANEL_RETIRE_CUTOFF"] = old
 33366	    return _w
 33367	
