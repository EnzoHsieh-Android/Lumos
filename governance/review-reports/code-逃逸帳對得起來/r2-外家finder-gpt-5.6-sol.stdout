  9418	def _esc_clean(v, limit=200):
  9419	    """逃逸帳顯示消毒(code-escape r1 B-1/B-2):控制字元(含換行/ESC)換空格——
  9420	    --list 的「一行一筆」是攔截/逃逸週報 grep 的載重合約,使用者可控的 desc 不得打穿;
  9421	    ANSI 逃逸碼進終端=帳本可信度風險。截斷防超長刷版。"""
  9422	    out = "".join(ch if ch >= " " and ch != "\x7f" else " " for ch in str(v))
  9423	    return out if len(out) <= limit else out[:limit] + "…"
