  9882	def _escape_shared_evidence(rows, released):
  9883	    """歸因不明用:先剔無佐證,只在分母母體內,每個佐證對到哪些迴圈。"""
  9884	    ev = {}
  9885	    for r in rows:
  9886	        lid = nfc(str(r.get("loop", "")))
  9887	        if lid in released:
  9888	            for key in _escape_evidence_keys(r):
  9889	                ev.setdefault(key, set()).add(lid)
  9890	    return ev
