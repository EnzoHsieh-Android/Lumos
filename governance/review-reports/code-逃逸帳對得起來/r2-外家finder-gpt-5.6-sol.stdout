  9841	def _escape_review_rows_by_loop(env):
  9842	    """審查帳裡的審查紀錄,依迴圈編號(NFC)分組;規格閘留痕不算。"""
  9843	    by_loop = {}
  9844	    try:
  9845	        for ln in (env.vault.parent / ".canary-log.jsonl").read_text(encoding="utf-8", errors="replace").splitlines():
  9846	            try:
  9847	                d = json.loads(ln)
  9848	            except ValueError:
  9849	                continue
  9850	            if isinstance(d, dict) and d.get("kind") in _REVIEW_RECORD_KINDS and isinstance(d.get("loop"), str):
  9851	                by_loop.setdefault(nfc(d["loop"]), []).append(d)
  9852	    except OSError:
  9853	        pass
  9854	    return by_loop
