  9463	def _plan_for_loop(env, loop_id):
  9464	    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。
  9465	    代碼審編號先去掉 code- 前綴;檔名比對兩邊都做 NFC(Projects/逃逸帳對得起來_計劃 第四節)。"""
  9466	    lid = nfc(str(loop_id or ""))
  9467	    if any(ch in lid for ch in ("/", "\\", "..")) or not lid.strip():
  9468	        return None   # 迴圈編號帶路徑字元不查(r1 資安席:否則拼出的路徑可能跳出 Projects/)
  9469	    if lid.startswith("code-"):
  9470	        lid = lid[len("code-"):]
  9471	    proj = env.vault / "Projects"
  9472	    for cand in (f"{lid}_計劃.md", f"{lid}.md"):
  9473	        if (proj / cand).is_file():
  9474	            return f"Projects/{cand}"
  9475	    try:
  9476	        names = {nfc(q.name): q.name for q in proj.iterdir()} if proj.is_dir() else {}
  9477	    except OSError:
  9478	        names = {}
  9479	    for cand in (f"{lid}_計劃.md", f"{lid}.md"):
  9480	        if nfc(cand) in names:
  9481	            return f"Projects/{names[nfc(cand)]}"
  9482	    return None
