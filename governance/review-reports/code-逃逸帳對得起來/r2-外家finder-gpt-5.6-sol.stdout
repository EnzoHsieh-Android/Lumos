  8171	    else:
  8172	        _has_code = (_kinds is None) or any(str(v) == "code" for v in _kinds.values())   # 沒標型別=分不出,保守記;標了就只收 code 型
  8173	        _hit = severity in ("major", "blocker") and _has_code
  8174	        _precision = "round"   # 輪級判準:這輪最高 major 且任一條是 code 型——粗,帳上標出來讓讀側分得出
  8175	    if loop and str(loop).startswith("code-") and _hit:
