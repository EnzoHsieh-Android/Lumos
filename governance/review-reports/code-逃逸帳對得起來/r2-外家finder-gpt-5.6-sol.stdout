 20677	def cmd_rule_gap(repo=None, as_json=False):
 20678	    """把逃逸帳裡「本來哪條規則該抓」的標記,變成「該寫哪條規則」的待辦。
 20679	    ★這是閉環的那一環★:審查放行之後下游才發現的缺陷,如果有人標了它屬於哪條規則,
 20680	    就能算出「這條規則還沒寫」——沒有這一步,逃逸帳只是一本帳,不會長出新的守衛。"""
 20681	    import json
 20682	    repo_root = _anchor_repo_root(repo)
 20683	    if repo_root is None:
 20684	        print("✗ rule-gap: 從目前目錄往上找不到 git repo——帶 --repo <根> 指定,或到 repo 內執行", file=sys.stderr)
 20685	        return 2
 20686	    # 逃逸帳位置:記帳那支寫在「知識庫的上一層」,標準佈局是 <repo>/docs/,
 20687	    # 但知識庫本身就是 repo 根的那種佈局(standalone)會落在別的地方——兩個都找(r1 通才席)
 20688	    cands = [Path(repo_root) / "docs" / ".escape-log.jsonl", Path(repo_root) / ".escape-log.jsonl"]
 20689	    log = next((c for c in cands if c.is_file()), cands[0])
 20690	    counts, unlabeled = {}, 0
 20691	    if log.is_file():
 20692	        _evs = []
 20693	        for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
 20694	            line = line.strip()
 20695	            if not line.startswith("{"):
 20696	                continue
 20697	            try:
 20698	                ev = json.loads(line)
 20699	            except Exception:
 20700	                continue
 20701	            if isinstance(ev, dict):
 20702	                _evs.append(ev)
 20703	        # 撤回紀錄不算逃逸、被撤回的列不算(跟 _escape_rows_for 同一支判斷;這裡保留自己找檔,要支援 standalone 佈局)
 20704	        _gone = _escape_withdrawn_targets(_evs)
 20705	        for ev in _evs:
 20706	            if _escape_is_withdraw(ev) or ev.get("token") in _gone:
 20707	                continue
 20708	            _raw = ev.get("rule")
 20709	            rid = _raw.strip() if isinstance(_raw, str) else ""   # 非字串不要整支崩,當成沒標
 20710	            if not rid or rid == "none":
 20711	                unlabeled += 1
 20712	                continue
 20713	            counts.setdefault(rid, {"n": 0, "desc": ev.get("desc", "")[:60]})
 20714	            counts[rid]["n"] += 1
 20715	    have = set(_rules_declared_ids(repo_root))
 20716	    idx, idx_err = _rules_load(repo_root)
 20717	    have |= set((idx.get("rules") or {}))
 20718	    if idx_err:
 20719	        # ★不要吞掉★(r1 邊界席):索引讀不了就少算「已經寫成規則的」,清單會憑空多出待辦
 20720	        print("提醒:" + idx_err + "——這份清單少算了索引裡登記過的規則,先修好索引再看", file=sys.stderr)
 20721	    missing = {k: v for k, v in counts.items() if k not in have}
 20722	    if as_json:
 20723	        print(json.dumps({"missing": missing, "covered": sorted(set(counts) & have),
 20724	                          "unlabeled": unlabeled}, ensure_ascii=False))
 20725	        return 0
 20726	    if not counts and not unlabeled:
 20727	        print("逃逸帳是空的:還沒有任何一筆「審查放行後下游才抓到」的紀錄。")
 20728	        print("  空≠零逃逸——也可能是沒人記。要記:")
 20729	        print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <等級> --desc <一句> --rule <本來哪條規則該抓|none>")
 20730	        return 0
 20731	    if missing:
 20732	        print("這些漏網的問題有人標了「本來哪條規則該抓」,但那條規則還不存在(" + str(len(missing)) + " 條):")
 20733	        for rid, v in sorted(missing.items(), key=lambda kv: -kv[1]["n"]):
 20734	            print("  " + rid + "(漏過 " + str(v["n"]) + " 次)—— " + v["desc"])
 20735	        print("在意的原因:逃逸帳只記「漏掉了」,不會自己長出守衛;把重複漏過的那幾條寫成規則,下次才擋得住。")
 25510	        if any(w in ("test", "tests", "pytest", "unittest", "testing") for w in words):
 25511	            return True
 25512	    return False
