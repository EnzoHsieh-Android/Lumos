  9439	        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
  9440	                           capture_output=True, text=True, errors="replace")
  9441	    except OSError:
  9442	        return []
  9443	    if r.returncode != 0:
  9444	        return []
  9445	    try:
  9446	        vrel = str(Path(vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
  9447	    except ValueError:
  9448	        return []
  9449	    out = []
  9450	    for line in r.stdout.splitlines():
  9451	        line = line.strip()
  9452	        if line.startswith(vrel + "/Projects/") and line.endswith(".md"):
  9453	            out.append(line)
