  9831	def _escape_plan_scopes(env, loop_id):
  9832	    """迴圈對應計劃的 scope/<類> 標籤;對不到計劃或沒標就 ["未分類"]。欄位照全檔慣例從 env.notes 讀。"""
  9833	    rel = _plan_for_loop(env, loop_id)
  9834	    n = env.notes.get(rel) if rel else None
  9835	    if n is None:
  9836	        return ["未分類"]
  9837	    sc = [t[len("scope/"):] for t in as_list(n.fields.get("tags")) if isinstance(t, str) and t.startswith("scope/")]
  9838	    return sc or ["未分類"]
