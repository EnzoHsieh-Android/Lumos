  9811	def _wilson_interval(k, n, z=1.96):
  9812	    """比例的 Wilson 95% 信賴區間;n=0 回 None。"""
  9813	    if n <= 0:
  9814	        return None
  9815	    import math
  9816	    p = k / n
  9817	    den = 1 + z * z / n
  9818	    mid = (p + z * z / (2 * n)) / den
  9819	    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
  9820	    return (max(0.0, mid - half), min(1.0, mid + half))
  9821	
