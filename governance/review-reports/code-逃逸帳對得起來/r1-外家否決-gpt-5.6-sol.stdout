+
+def _wilson_interval(k, n, z=1.96):
+    """比例的 Wilson 95% 信賴區間;n=0 回 None。"""
+    if n <= 0:
+        return None
+        return None
+    import math
+    p = k / n
+    den = 1 + z * z / n
+    mid = (p + z * z / (2 * n)) / den
+    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
+    return (max(0.0, mid - half), min(1.0, mid + half))
+
+
+def _escape_stage_class(stage):
+    """站名分類:next=下一站就接住、leak=漏網、unknown=不認得(算漏網、另列)。"""
+    st = str(stage or "")
+    if st in _ESCAPE_NEXT_STAGES or st.startswith("push-gate"):
+        return "next"
+    return "leak" if st in _ESCAPE_LEAK_STAGES else "unknown"
+
+
+def _escape_plan_scopes(env, loop_id):
+    """迴圈對應計劃的 scope/<類> 標籤;對不到計劃或沒標就 ["未分類"]。"""
+    rel = _plan_for_loop(env, loop_id)
+    if not rel:
+        return ["未分類"]
+    try:
+        fm, _ = split_frontmatter((env.vault / rel).read_text(encoding="utf-8"))
+        tags = parse_frontmatter(fm or [])[0].get("tags") or []
+    except (OSError, ValueError):
+        return ["未分類"]
+    sc = [t[len("scope/"):] for t in as_list(tags) if isinstance(t, str) and t.startswith("scope/")]
+    return sc or ["未分類"]
+
