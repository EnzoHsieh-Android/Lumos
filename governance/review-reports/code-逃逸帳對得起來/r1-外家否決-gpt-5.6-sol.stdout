    return bad


def _sc_churn(rr, git_range, files):
    """相對量:每檔 (新增+刪除) ≤ 原本行數×比例 或 ≤ 絕對上限;二進位算不出量不當小改動;原本行數用舊路徑查 base 樹(r3 通才席)。"""
    C, bad = _SMALL_CHANGE, []
    base = _range_base(rr, git_range)   # 三點範圍要 merge-base(代碼審 r2 架構席:同檔同算法要收斂成一份)
    for path, la, ld, binary, old in files:
        if binary:
            bad.append(f"相對量:{path} 是二進位檔,算不出改動量,不當小改動")
            continue
        churn = la + ld
        if churn <= C["max_abs_lines"]:
            continue
        lt = None
        if base:
            g = subprocess.run(["git", "-C", str(rr), "show", f"{base}:{old}"], capture_output=True, text=True, errors="replace")
            lt = len(g.stdout.splitlines()) if g.returncode == 0 else 0
        if lt is None or churn > lt * C["max_rel_churn"]:
            bad.append(f"相對量:{path} 改了 {churn} 行(原本 {lt if lt is not None else '?'} 行),超過 {int(C['max_rel_churn'] * 100)}% 也超過 {C['max_abs_lines']} 行")
    return bad


def _sc_history(env, rr, files, links):
    """歷史:落點掛 risk/ 標籤、碰到裁判檔(錨點清單/scripts/hooks/)、近 N 天逃逸帳有同落點的列。"""
    C, bad = _SMALL_CHANGE, []
    for lk in links:
        hn = env.notes.get(lk + ".md") or env.notes.get(lk)
        if hn is not None and any(str(t).startswith("risk/") for t in as_list(hn.fields.get("tags"))):
            bad.append(f"歷史:落點 {lk} 掛了風險標籤,不算小改動")
    anchors = set()
    try:   # 錨點清單走既有路徑常數與解析寫法(r1 架構席)
        import json as _j
        anchors = {nfc(str(k)) for k in (_j.loads((rr / _ANCHOR_BASELINE_REL).read_text(encoding="utf-8")).get("anchors") or {})}
    except (OSError, ValueError, AttributeError):
        pass
    judge = [f[0] for f in files if f[0] in anchors or f[0].startswith("scripts/hooks/")]
    if judge:
        bad.append("歷史:碰到裁判檔(hook/錨點):" + "、".join(judge[:5]))
    import datetime as _dt
    cutoff_str = (_dt.datetime.now().astimezone() - _dt.timedelta(days=C["escape_days"])).isoformat()
    cutoff_key = _loop_ts_key(cutoff_str)
    for e in _escape_rows_for(env):
        k = _loop_ts_key(str(e.get("ts", "")))   # 換算 UTC 再比(r1 兩席);解析不動退回字串比對(r2 複核)
        too_old = (str(e.get("ts", "")) < cutoff_str) if (k is None or cutoff_key is None) else (k < cutoff_key)
        if too_old or not e.get("plan"):
            continue
        en = env.notes.get(str(e["plan"]))
        if en is not None and set(_plan_system_links(en)) & set(links):
            bad.append(f"歷史:近 {C['escape_days']} 天逃逸帳有同落點的列(迴圈 {e.get('loop')},{str(e.get('ts'))[:10]}),這個落點最近出過事")
            break
    return bad


def _small_change_check(env, rr, git_range, prel, note):
    """全靠人驗的風險低計劃的推送閘:回沒過的原因清單(空=過)。四維度各一支:擴散 _sc_diffusion、相對量 _sc_churn、歷史 _sc_history、目的(計劃連 Issues 不算小改動)。"""
    try:
        vrel = str(env.vault.resolve().relative_to(rr)).replace(os.sep, "/")
    except ValueError:
        vrel = None
    files, err = _sc_changed_files(rr, git_range, vrel)
    if files is None:
        return [err]
    if not files:
        return []
    links = _plan_system_links(note)
    base = _range_base(rr, git_range)
    bad = _sc_diffusion(env, rr, files, links, base) + _sc_churn(rr, git_range, files) + _sc_history(env, rr, files, links)
            print(f"    {_qid}:審查席抓到未觸發題的問題 {_n} 次" + (" ← 觸發太窄候選(修它的 when)" if _n >= 3 else "(累積 3 次列候選)"))
        print()
    # ── 審查有沒有用(審查有沒有用記帳 S3,2026-09-08):只算有 reported 欄的輪(2026-09-09 起才有) ──
    _by_round = {}
    for r in rows:
        if r.get("gate") == "canary" and r.get("loop") and r.get("round"):
            _by_round.setdefault((r["loop"], r["round"]), []).append(r)
    _ys = {k: _review_yield_round(v) for k, v in _by_round.items()}
    _ys = {k: y for k, y in _ys.items() if y["N"] is not None}
    _K = len(_ys)
    _rej = [r for r in ded if r.get("gate") == "canary" and r.get("kind") == "blocked"]   # kind=blocked 跟 anchor/code-loop「這次動作被擋」同字(r1 架構席 a3)
    if _K or escapes or _rej:   # 只有「被擋」沒有「記成」也要印(r1 f2):不然撞牆三次、一輪都沒補記=這段整個不見,正好是留 blocked 事件要防的盲點
        print("  審查有沒有用(只算有 reported 欄的 %d 輪,2026-09-09 起;人記的帳跟上面『閘的動作』那段可信度不同級,不要拿這裡的數字去算那裡的比率)" % _K)
        print("  (N 是機器從報告數的、R 是人填的;這段內部也不印比率、別自己算 Σ折/Σ報 當『審查有用率』)")
        if _K:
            _sum = lambda key: sum(y[key] for y in _ys.values() if y[key] is not None)
            _n_carrier = sum(1 for y in _ys.values() if y["has_carrier"])
            _n_r_known = sum(1 for y in _ys.values() if y["R"] is not None)
            _n_r_nonzero = sum(1 for y in _ys.values() if y["R"])
            _n_s_pos = sum(1 for y in _ys.values() if y["S"])
            print(f"    Σ席位報 {_sum('N')} → Σ存活 {_sum('M')} / Σ編排者重現不到 {_sum('R')} → Σ折 {_sum('F')} / Σ放行 {_sum('A')};存活多於席位報的輪 {_n_s_pos}(共 Σ{_sum('S')} 條)")
            print(f"    給回頭條件的兩個數:有載體的 {_n_carrier} 輪裡記了 refuted-set 的 {_n_r_known} 輪、其中非 0 的 {_n_r_nonzero} 輪;S>0 的輪 {_n_s_pos}")
            _recent = sum(1 for (lp, rd), v in _by_round.items() if (lp, rd) in _ys and any(str(x.get("ts", "")) >= cutoff for x in v))
            if _K < 5 or _recent < 3:
                print(f"    樣本太少,別下結論(K={_K},窗口內 {_recent} 輪;門檻 5/3 是暫用值)")
        if escapes is not None:
            _worst = max((e.get("severity", "minor") for e in escapes), key=lambda s: _SEV_ORDER.get(s, 0), default=None)
            print(f"    逃逸帳 {len(escapes)} 筆(審查放行後下游抓到的;最重 {_worst or '—'};歸因是人工判斷)")
        if _rej:
            _d = lambda r: str(r.get("detail", "") or r.get("note", ""))
            _rn = sum(1 for r in _rej if "report-not-normalized" in _d(r))
            _rf = sum(1 for r in _rej if "findings-over-reported" in _d(r))
            print(f"    記帳被寫側擋下 {len(_rej)} 次(報告沒正規化 {_rn} / 缺 refuted-set {len(_rej) - _rn - _rf} / findings 多於 reported {_rf});擋下後有沒有補記,對照上面 K 看")
        print()
    # 設計迴圈結案方式(工具鏈補強十件 #6):達上限卻從沒過關的審查編號 = 人裁放行。
    # 只看 gate=design-loop 的事件(2026-08-22 起才記;之前的迴圈沒帳,算不出來,這裡如實講)。
    dl = [r for r in ded if r.get("gate") == "design-loop"]
    if dl:
        by = {}
        for r in dl:
            for nd_ in (r.get("nodes") or []):
                by.setdefault(nd_, set()).add(r.get("kind"))
        conv = sum(1 for k in by.values() if "converged" in k)
        capped = sum(1 for k in by.values() if "cap-reached" in k and "converged" not in k and "rewrite" not in k)
        rewrote = sum(1 for k in by.values() if "rewrite" in k and "converged" not in k)
        print(f"  審查迴圈結案方式(只算有記帳的 {len(by)} 個編號):閘過了 {conv} 個、跑滿上限沒過關(人裁放行) {capped} 個、人裁判整份重寫收尾 {rewrote} 個"
              + (f"——人裁放行率 {capped / len(by):.0%}" if by else ""))
        print("  (2026-08-22 起 loop next / loop status 才會記這個帳;更早的迴圈沒資料,不在分母)")
        print()
    # ── 閘的硬擋 / 放行 / 被跳過(#19 S1-S3)────────────────────────────────
    # ★每一種新事件都要指名一個讀它的地方★——這裡就是那個地方。
    # 沒有消費者的帳只是更大的垃圾場;而這批新增的三種事件的消費者就是這一段。
    hard = [r for r in ded if r.get("kind") == "blocked"]
    skipped = [r for r in ded if str(r.get("kind", "")).startswith("skipped")]
    fo = [r for r in ded if r.get("kind") == "fail-open"]
    if hard or skipped or fo:
        print("  閘的動作(#19 起才有帳;更早的擋下與放行沒有紀錄,不在分母):")
        if hard:
            _by = {}
            for r in hard:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    硬擋 %d 次:%s" % (len(hard), "、".join(f"{k} {v}" for k, v in sorted(_by.items()))))
        if skipped:
            _by = {}
            for r in skipped:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    被跳過 %d 次:%s" % (len(skipped), "、".join(f"{k} {v}" for k, v in sorted(_by.items())))
                  + "  ← ★這一行是「哪一道最常被跳」的答案★")
        if fo:
            _by = {}
            for r in fo:
            _ag = sum(1 for r in _sec if "verdict=agree" in r.get("detail", ""))
            _ov = len(_sec) - _ag
            print(f"  覆核紀錄: {len(_sec)} 筆(同意原判 {_ag} / 翻盤 {_ov}"
                  + (f" ← 分歧率 {_ov/len(_sec):.0%},翻盤的那幾輪值得回頭看" if _ov else "") + ")")
        # 對抗層增量帳(2026-07-26,borrow arXiv 2605.25665 實戰報告欄):折入=caught 輪辯方裁決後
        # 存活折入的真缺陷數——測試綠後仍被對抗層(canary 護審/辯方/跨家族)抓到,天生就是「測試漏掉的」。
        # 長期趨零=整套機關裝飾品該砍;這是驗證層對自己的驗證。missed 輪判決不採信不計;
        # findings 欄 2026-07-21(M1)起才有,舊輪無欄誠實另計不混入。
        fold_total, fold_sev, fold_aud, legacy_rounds = 0, {}, {}, 0
        for r in can:
            # none=停用制無植入輪(2026-08-14 d5):折入 findings 語意不變,照計——
            # 只讀 caught 會使本帳(文檔標一級指標)自停用日起永凍 0(終審 F2)
            if r["kind"] not in ("caught", "none"):
                continue
            fnd = r.get("findings")
            if fnd is None:
                legacy_rounds += 1
                continue
            fold_total += fnd
            if fnd:
                sv = r.get("severity") or "?"
                fold_sev[sv] = fold_sev.get(sv, 0) + fnd
                aud = r.get("auditor", "?")
                fold_aud[aud] = fold_aud.get(aud, 0) + fnd
        sev_s = " ".join(f"{k} {v}" for k, v in sorted(fold_sev.items())) or "無"
        aud_s = " · ".join(f"{k} {v}" for k, v in sorted(fold_aud.items())) or "無"
        legacy_s = f"(另 {legacy_rounds} 舊輪無 findings 欄不計)" if legacy_rounds else ""
        print(f"  對抗層增量帳(測試都綠了之後審查還抓到、折回去修的缺陷;長期趨零就代表這層審查沒用、該砍): "
              f"折入 {fold_total} 筆缺陷 [{sev_s}] | 依審計員: {aud_s} {legacy_s}".rstrip())
    _shown = len(ded) if full else sum(1 for r in ded if r["gate"] != "doctor-run")
    print(f"\n近 {since_days} 天共 {_shown} 筆治理事件")
    if stats:
        # 原始行也要吃 node 縮限,否則同一張表兩欄母體不同(去重欄已縮、原始欄沒縮)
        _raw = [r for r in rows if (not node) or stem(node) in r["nodes"]]
        _render_gov_stats(_raw, ded, loaded, since_days, cutoff, node, repo_root=_vault_repo_root(env), escapes=_escape_rows_for(env))
    return 0


CLUSTER_STATES = ("resolved", "accepted-minor", "disputed-major")


def _parse_clusters(raw):
    """M2 risk-cluster 寫側解析:--clusters '名=狀態,...' → (dict{名:狀態}, None) 或 (None, 錯誤訊息)。
    三態白名單;accepted-minor 需冒號內嵌理由(整筆單一 note 對多 accepted-minor 無法對應=模糊過帳);
    尾逗號空段靜默過濾,但過濾後空列表=rc2(帶旗標即須有效內容,無「空字串=未帶」特例);
    設計:Projects/design-loop提效_計劃 M2(golden: governance/golden/dloop-m2-cluster)。"""
    parts = [p.strip() for p in str(raw).split(",") if p.strip()]
    if not parts:
        return None, "帶了 --clusters 但無有效內容(空字串/全逗號)"
    out = {}
    for p in parts:
        if "=" not in p:
            return None, f"段缺 '='(格式 名=狀態): {p!r}"
        name, state = p.split("=", 1)
        name, state = name.strip(), state.strip()
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", name):
            return None, f"cluster 名非法(kebab 短 slug:小寫英數起頭+[-_],≤64): {name!r}"
        base = state.split(":", 1)[0]
        if base not in CLUSTER_STATES:
            return None, f"狀態 {base!r} 不在白名單 {'/'.join(CLUSTER_STATES)}"
        if base == "accepted-minor":
        if not s:
            continue
        if _COMPRESS_PIN_RE.search(s):
            pinned.append(s)
        elif _COMPRESS_EVID_RE.search(s):
            evidence.append(s)
        elif _COMPRESS_OPEN_RE.search(s):
            open_items.append(s)
    if as_json:
        print(json.dumps({"pinned": pinned, "evidence": evidence, "open": open_items,
                          "input_lines": len(lines)}, ensure_ascii=False, indent=1))
        return 0
    print("# 壓縮狀態(規則式;白名單壓不掉)")
    for title, bucket in (("壓不掉白名單", pinned), ("已驗證證據", evidence), ("未結約束", open_items)):
        print(f"## {title}")
        for s in bucket:
            print(f"- {s}")
    print(f"[compress] 輸入 {len(lines)} 行 → 保留 {len(pinned) + len(evidence) + len(open_items)} 行"
          f"(白名單 {len(pinned)}/證據 {len(evidence)}/未結 {len(open_items)})")
    return 0


