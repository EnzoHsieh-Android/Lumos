+_REVIEW_RECORD_KINDS = ("none", "caught", "missed")   # 審查帳裡真正的審查紀錄;kind=spec-gate 是規格閘自己的留痕
+
+
+def _review_loop_ids(env):
+    """審查帳裡有審查紀錄的迴圈編號(NFC);規格閘留痕不算——風險低沒審的計劃也會有那種列。"""
+    ids = set()
+    ledger = env.vault.parent / ".canary-log.jsonl"
+    try:
+        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
+            try:
+                d = json.loads(ln)
+            except ValueError:
+                continue
+            if isinstance(d, dict) and d.get("kind") in _REVIEW_RECORD_KINDS and isinstance(d.get("loop"), str):
+                ids.add(nfc(d["loop"]))
+    except OSError:
+        pass
+    return ids
+
+
+def _escape_loop_kind(loop_id, review_ids):
+    """逃逸列歸給哪一種迴圈:code-(代碼審)/design(有審查紀錄的設計審)/plan(沒審查帳的計劃)。寫與讀共用這一支。"""
+    lid = nfc(str(loop_id or ""))
+    if lid.startswith("code-"):
+        return "code"
+    return "design" if lid in review_ids else "plan"
+
+
+def _escape_reason_ok(v):
+    """理由門檻:去空白後至少 _MANUAL_MIN_CHARS 個字且至少一個實字(跟 [manual:] 那條同一個判法)。"""
+    return isinstance(v, str) and len(v.strip()) >= _MANUAL_MIN_CHARS and bool(re.search(r"[^\W_]", v))
+
+
+def _escape_log_guard(log):
+    """寫逃逸帳前的共同檢查:帳檔是符號連結就擋、不存在就安全建檔(手動記帳與撤回共用)。回 0 或 2。"""
+    if log.is_symlink():
+        # r2 終態席實測:既存 symlink 會繞過建檔保護、共用寫入原語 open('a') 跟隨連結寫進外部檔——
+        # 每次寫前先擋本體(殘餘=判斷與開檔間競態,best-effort 同 _ledger_append 家族誠實降級)
+        print(f"擋下:逃逸帳檔是一個符號連結,不往裡寫(帳本必須是普通檔案):\n    {log}", file=sys.stderr)
+        return 2
+    if not log.exists():
+        try:
+            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
+        except FileExistsError:
+            pass
+        except OSError as e:
+            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
+            return 2
+    return 0
+
+
+def _escape_is_withdraw(r):
+    """撤回紀錄本身不是逃逸事件:任何統計都不當成一筆逃逸。"""
+    return isinstance(r, dict) and r.get("kind") == "withdraw"
+
+
+def _escape_withdrawn_targets(rows):
+    """哪些逃逸列被撤回了(撤回紀錄的 target token 集合)。"""
+    return {r.get("target") for r in rows if _escape_is_withdraw(r) and r.get("target")}
+
+
+def _escape_rows_for(env, loop_id=None, include_withdrawn=False):
+    """讀逃逸帳(append-only,不進閘);loop_id 給了就只回那條迴圈的。壞行、非物件行跳過。
+    撤回紀錄永遠不回;被撤回的列預設不回,include_withdrawn=True 才回(自動記的去重要把撤過的當成記過)。"""
+    rows = _escape_raw_rows(env)
+    gone = set() if include_withdrawn else _escape_withdrawn_targets(rows)
+    return [d for d in rows if not _escape_is_withdraw(d) and d.get("token") not in gone
+            and (loop_id is None or d.get("loop") == loop_id)]
+
+
