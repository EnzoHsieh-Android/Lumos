+
+def _esc_row(loop, stage="CI", token=None, **kw):
+    d = {"ts": "2026-09-22T10:00:00+08:00", "token": token or f"ESC-{loop}-{stage}", "loop": loop, "stage": stage,
+         "severity": "major", "desc": "x"}
+    d.update(kw)
+    return d
