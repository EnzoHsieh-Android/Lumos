+def t_escape_manual_requires_defect_ref():
+    """[S2] 手動記帳 sha/defect_ref 都空(含只有空白)又沒有夠長的理由 → 擋;--sha 寫進列;理由寫進 defect_ref_missing。"""
+    import json as _j
+    v = _esc_fx(review=[("甲", "standard")])
