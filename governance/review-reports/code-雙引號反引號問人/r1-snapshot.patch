     def _in_double(self, i: int, cur, ch: str) -> int:
         if ch == '"':
             cur[1] = False
             self.out.append(ch)
+        elif ch == "`":
+            return self._double_tick(i)
         else:
             self.out.append(ch if ch == "$" else _mask(ch))    # 雙引號裡的 $ 照常展開("$D")
         return i + 1
 
+    def _double_tick(self, i: int) -> int:
+        """雙引號裡的反引號一樣會執行(bash 實測 echo "`git status`");原本跟其他字一起遮掉,裡面的繞閘就看不到
+        (/code-review 實跑 echo "`git commit --no-verify`" 回空清單)。找到沒被跳脫的結尾反引號,中間那段當成
+        新指令重整一趟,原樣包回反引號交給 _split_cmdsubs 抽出另外判;找不到結尾就照普通字遮掉(bash 本身也會報錯)。
+        每段只重整一次,整趟仍是線性的。"""
+        cmd, k = self.cmd, i + 1
+        while k < len(cmd) and cmd[k] != "`":
+            k += 2 if cmd[k] == "\\" else 1
+        if k >= len(cmd):
+            self.out.append(_mask("`"))
+            return i + 1
+        self.out.append("`" + _Normalizer(cmd[i + 1:k]).run() + "`")
+        return k + 1
+
     def _bare(self, i: int, cur, ch: str) -> int:
         special = self._bare_special(i, cur, ch)
         if special is not None:
             return special
         if ch == "'":
             cur[0] = True
         elif ch == '"':
             cur[1] = True
         self.out.append(ch)
         return i + 1
