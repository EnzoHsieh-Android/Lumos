+    m = _load_lumos_inproc()
+    reset("good")
+
+    class _Deep:       # 函式裡的 import json 拿 sys.modules 那一份:換成 loads 一律丟 RecursionError 的替身
+        def loads(self, *a, **k):
+            raise RecursionError("測試造的遞迴爆掉")
+    real_json = sys.modules["json"]
