   228	def scan_codex_file(path: Path, slug: str, repo_set: set[str]):
   229	    """Codex rollout → rows(同 scan_file 的欄位,多 harness=codex)。版本不在 fixture 表 → 跳過並回 (rows, bad, skipped=True)。"""
   230	    rows = []
   231	    try:
   232	        lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
   233	    except OSError:
   234	        return rows, 0
   235	    objs, bad = [], 0
   236	    for ln in lines:
   237	        if not ln.strip():
   238	            continue
   239	        try:
   240	            objs.append(json.loads(ln))
   241	        except Exception:
   242	            bad += 1
   243	    if not objs or objs[0].get("type") != "session_meta":
   244	        return rows, bad
   245	    meta = objs[0].get("payload") or {}
   246	    if str(meta.get("cli_version") or "") not in CODEX_TRANSCRIPT_VERSIONS:
   247	        return rows, bad
   248	    cwd = str(Path(str(meta.get("cwd") or "")).resolve()) if meta.get("cwd") else ""
   249	    if not cwd or not any(cwd == r or cwd.startswith(r + "/") for r in repo_set):
   250	        return rows, bad
   251	    is_sub = meta.get("thread_source") == "subagent" or isinstance(meta.get("source"), dict)
   252	    sid = meta.get("session_id") or meta.get("id")
   253	    for idx, o in enumerate(objs):
   254	        p = o.get("payload") or {}
   255	        if o.get("type") != "response_item" or p.get("type") != "message" or p.get("role") != "developer":
   256	            continue
   257	        txt = _cx_text(p)
   258	        first = txt.split("\n", 1)[0].strip()
   259	        lens = LENS_HDR.match(first)
   260	        if lens:
   261	            rows.append({"session_id": sid, "is_subagent": is_sub, "harness": "codex", "hook_name": "SubagentStart:dispatch-lens",
   262	                         "header_version": "lens", "file": "", "n_pinned": 0, "pinned_complete": True, "anchored": True, "ftype": "repo",
   263	                         "lens_range": lens.group(1), "lens_seat": f"{lens.group(2)}/{lens.group(3)}",
   264	                         "touched": [], "touched_loose": [], "pre_touched": [], "wrote_back": [], "search_touched": [], "any": False, "any_loose": False})
   265	            continue
   266	        if not (HDR_OLD.match(first) or HDR_NEW.match(first)):
   267	            continue
   268	        ver, pins, complete = parse_pins(txt)
   269	        # 錨=同輪內離注入最近的 apply_patch 呼叫(先往後找,沒有再往前找——0.144.1 實看兩種順序都有);
   270	        # 目標檔=其 patch 標頭第一個路徑;同輪內找不到 apply_patch → 退而取最近的任一 custom_tool_call(anchored 仍 True 但 file 空)
   271	        def _is_boundary(o2):
   272	            q2 = o2.get("payload") or {}
   273	            return (o2.get("type") == "event_msg" and q2.get("type") == "user_message") or \
   274	                   (o2.get("type") == "response_item" and q2.get("type") == "message" and q2.get("role") == "user")
   275	        def _patch_target(q2):
   276	            inp2 = q2.get("input") if isinstance(q2.get("input"), str) else ""
   277	            for m in _CX_PATCH_RE.finditer(inp2):
   278	                for ln2 in _cx_unescape(m.group(1)).split("\n"):
   279	                    h = _CX_HDR_RE.match(ln2.strip())
   280	                    if h:
   281	                        return h.group(1).strip()
   282	            return ""
   283	        anchor, target, fallback = None, "", None
   284	        for direction in (1, -1):
   285	            j = idx + direction
   286	            while 0 <= j < len(objs) and not _is_boundary(objs[j]):
   287	                q = objs[j].get("payload") or {}
   288	                if objs[j].get("type") == "response_item" and q.get("type") == "custom_tool_call":
   289	                    t = _patch_target(q)
   290	                    if t:
   291	                        anchor, target = j, t
   292	                        break
   293	                    if fallback is None:
   294	                        fallback = j
   295	                j += direction
   296	            if anchor is not None:
   297	                break
   298	        if anchor is None and fallback is not None:
   299	            anchor = fallback
   300	        ftype = "scratch" if ("/scratchpad/" in target or "/tmp/" in target) else ("repo" if target else "unknown")
   301	        row = {"session_id": sid, "is_subagent": is_sub, "harness": "codex", "hook_name": "PreToolUse:apply_patch",
   302	               "header_version": ver, "file": target, "n_pinned": len(pins), "pinned_complete": complete,
   303	               "anchored": anchor is not None, "ftype": ftype, "touched": [], "touched_loose": [], "pre_touched": [], "wrote_back": [], "search_touched": []}
   304	        if anchor is not None and pins:
   305	            pinset = set(pins); stems = {}
   306	            for pth in pins:
   307	                stems.setdefault(pth.rsplit("/", 1)[-1][:-3], []).append(pth)
   308	            row["ambiguous"] = []
   309	            for j, o2 in enumerate(objs):
   310	                q = o2.get("payload") or {}
   311	                if o2.get("type") != "response_item" or q.get("type") != "custom_tool_call":
   312	                    continue
   313	                inp = q.get("input") if isinstance(q.get("input"), str) else ""
   314	                for m in _CX_CMD_RE.finditer(inp):
   315	                    cmd = _cx_unescape(m.group(1))
   316	                    hit_read, hit_loose, hit_write, terms, sterms = classify_bash(cmd, slug)
   317	                    for t in terms:   # lumos show/context/contracts <詞> → 對到釘住節點(同 scan_file:單一 stem 才算命中)
   318	                        if t in stems:
   319	                            if len(stems[t]) == 1:
   320	                                hit_read.add(stems[t][0])
   321	                            else:
   322	                                for pth in stems[t]:
   323	                                    if pth not in row["ambiguous"]:
   324	                                        row["ambiguous"].append(pth)
   325	                    bucket = row["touched"] if j > anchor else row["pre_touched"]
   326	                    for n in sorted(hit_read & pinset):
   327	                        if n not in bucket:
   328	                            bucket.append(n)
   329	                    if j > anchor:
   330	                        for n in sorted(hit_loose & pinset):
   331	                            if n not in row["touched_loose"]:
   332	                                row["touched_loose"].append(n)
   333	                        for n in sorted(hit_write & pinset):
   334	                            if n not in row["wrote_back"]:
   335	                                row["wrote_back"].append(n)
   336	                        for t in sterms:
   337	                            for st, plist in stems.items():
   338	                                for pth in plist:
   339	                                    if t and t in st and pth not in row["search_touched"]:
   340	                                        row["search_touched"].append(pth)
   341	        row["any"] = bool(row["touched"]); row["any_loose"] = bool(row["touched"] or row["touched_loose"])
   342	        rows.append(row)
   343	    return rows, bad
