   346	def scan_file(path: Path, slug: str, repo_set: set[str]):
   347	    rows = []
   348	    try:
   349	        lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
   350	    except OSError:
   351	        return rows, 0
   352	    objs, bad = [], 0
   353	    for ln in lines:
   354	        try:
   355	            objs.append(json.loads(ln))
   356	        except Exception:
   357	            bad += 1
   358	    # cwd 篩:任一行 cwd 在 repo/worktree 之下才算本專案
   359	    cwds = {str(Path(o.get("cwd")).resolve()) for o in objs if isinstance(o, dict) and o.get("cwd")}
   360	    if not any(any(c == r or c.startswith(r + "/") for r in repo_set) for c in cwds):
   361	        return rows, bad
   362	    is_sub = "/subagents/" in str(path)
   363	    # 索引 tool_use by id → 行序
   364	    tu_index = {}
   365	    for idx, o in enumerate(objs):
   366	        if o.get("type") != "assistant":
   367	            continue
   368	        for it in (o.get("message", {}).get("content") or []):
   369	            if isinstance(it, dict) and it.get("type") == "tool_use":
   370	                tu_index[it.get("id")] = (idx, it.get("name"), it.get("input") or {})
   371	    seen = set()
   372	    for idx, o in enumerate(objs):
   373	        att = o.get("attachment") if isinstance(o.get("attachment"), dict) else None
   374	        if not att or att.get("type") != "hook_additional_context" or att.get("hookName") not in HOOKS:
   375	            continue
   376	        tid = att.get("toolUseID")
   377	        if not tid or tid in seen:
   378	            continue
   379	        seen.add(tid)
   380	        ver, pins, complete = parse_pins(att.get("content"))
    20	"""
    21	import argparse, json, os, re, shutil, subprocess, sys, tempfile, time
    22	from pathlib import Path
    23	
    24	ROOT = Path(__file__).resolve().parent.parent
    25	
    26	
    27	def tool_calls_from_codex_json(lines):
    28	    """codex exec --json → [(tool_name, 摘要字串)] 依時間序(Projects/Codex完全支援_計劃 S3)。
    29	    只認 item.completed:command_execution→("Bash", 指令全文,剝掉 /bin/zsh -lc '…' 外殼);file_change→("Edit", 路徑串);
    30	    回 (calls, final_text)。事件形狀在 0.144.1 實看,改版要重驗。"""
    31	    calls, final = [], ""
    32	    for ln in lines:
    33	        ln = ln.strip()
    34	        if not ln.startswith("{"):
    35	            continue
    36	        try:
    37	            ev = json.loads(ln)
    38	        except Exception:
    39	            continue
    40	        if ev.get("type") != "item.completed":
    41	            continue
    42	        it = ev.get("item") or {}
    43	        t = it.get("type")
    44	        if t == "command_execution":
    45	            cmd = str(it.get("command", ""))
    46	            m = re.match(r"^\S*(?:zsh|bash|sh) -lc (['\"])(.*)\1$", cmd, re.S)   # 0.144.1 實看單、雙引號外殼都有
    47	            calls.append(("Bash", (m.group(2).replace("'\\''", "'") if m.group(1) == "'" else m.group(2).replace('\\"', '"')) if m else cmd))
    48	        elif t == "file_change":
    49	            calls.append(("Edit", " ".join(str(c.get("path", "")) for c in (it.get("changes") or []) if isinstance(c, dict))[:200]))
    50	        elif t == "agent_message":
    51	            final = str(it.get("text") or "")
    52	    return calls, final
    53	
    54	
    55	def tool_calls_from_stream(lines):
    56	    """stream-json → [(tool_name, 摘要字串)] 依時間序。"""
    57	    calls = []
    58	    for ln in lines:
    59	        ln = ln.strip()
    60	        if not ln.startswith("{"):
    61	            continue
    62	        try:
    63	            ev = json.loads(ln)
    64	        except Exception:
    65	            continue
    66	        msg = ev.get("message") if isinstance(ev, dict) else None
    67	        content = (msg or {}).get("content") if isinstance(msg, dict) else None
    68	        if ev.get("type") == "assistant" and isinstance(content, list):
    69	            for blk in content:
    70	                if isinstance(blk, dict) and blk.get("type") == "tool_use":
    71	                    name = blk.get("name", "?")
    72	                    inp = blk.get("input") or {}
    73	                    if name == "Bash":
    74	                        # ★不截斷 Bash 指令★(code-ablation-probe r1 邊界席):判「有沒有敲 lumos」的正則比對這個字串,
    75	                        # 截到 200 字會把落在後面的 `lumos <子指令>` 漏掉,系統性低估 M1/M2/M3。存全文,只有純顯示的其他工具截。
    76	                        summ = str(inp.get("command", ""))
    77	                    elif name in ("Read", "Edit", "Write", "Glob", "Grep"):
    78	                        summ = " ".join(str(inp.get(k, "")) for k in ("file_path", "pattern", "path") if inp.get(k))[:200]
    79	                    elif name == "Skill":
    80	                        summ = str(inp.get("skill", ""))
    81	                    else:
    82	                        summ = json.dumps(inp, ensure_ascii=False)[:200]
    83	                    calls.append((name, summ))
    84	    return calls
    85	
    86	
    87	def judge(calls, expect, forbid_before):
    88	    """回 (passed, reason, first_hit_index)。
    89	    expect:每條 regex 必須各自命中至少一次(對 Bash 指令字串比對)。
    90	    forbid_before:任何一條命中(工具名或 Bash 指令字串)若發生在「第一條 expect 命中」之前 → 不過。"""
    91	    exp_idx = {}
    92	    for i, (name, summ) in enumerate(calls):
    93	        hay = summ if name == "Bash" else f"{name}:{summ}"   # 非 Bash 工具用「工具名:參數」比,紀律題可寫 Edit:docs/…
    94	        for e in expect:
    95	            if e not in exp_idx and re.search(e, hay):
    96	                exp_idx[e] = i
    97	    missing = [e for e in expect if e not in exp_idx]
    98	    if missing:
    99	        return False, f"沒敲到期望指令: {missing}", None
   100	    first = min(exp_idx.values())
   101	    for i, (name, summ) in enumerate(calls[:first]):
   102	        if name in ("Read", "Grep", "Glob") and "/.claude/skills/" in summ:
   103	            continue   # 讀索引/skill 手冊是期望行為,不算「先做了別的」
   104	        for f in forbid_before:
   105	            if re.search(f, name) or (name == "Bash" and re.search(f, summ)):
   106	                return False, f"在敲 lumos 之前先做了 {name}: {summ[:80]!r}", first
   107	    return True, "ok", first
   108	
   109	
   110	# ── 修法 A ablation(Projects/修法A_lumos先行ablation_計劃)──────────────────────────
   111	# 「不帶」組要拔的是 CLAUDE.md 裡「第一個工具呼叫是 lumos」那一小節(到「三條鐵則」之前),
   112	# 其餘(## 標題、兩行前提、三條鐵則、白話、skill 表)原樣。邊界字串跟 scripts/templates/graph-discipline.md 同源;
   113	# 範本改標題這裡會找不到 → make_sandbox 直接炸,寧可實驗跑不起來,不要靜默跑一個沒拔乾淨的「不帶」組。
   114	RULE_HEAD = "### 第一個工具呼叫是 `lumos`"
   115	RULE_END = "### 三條鐵則"
   116	
   117	
   118	def strip_lumos_first_rule(text):
   119	    """回 (新文字, 有沒有砍到)。找不到兩個邊界、順序反了、或標記不只出現一次 → 原文、False。
   120	    ★r1 邊界席:兩個標記若各出現多次,find 只取第一個、可能砍錯段且無聲。要求各恰好一次,否則安全回退★。"""
   121	    if text.count(RULE_HEAD) != 1 or text.count(RULE_END) != 1:
   122	        return text, False
   123	    s = text.find(RULE_HEAD)
   124	    e = text.find(RULE_END)
   125	    if s < 0 or e < 0 or e <= s:
   126	        return text, False
   127	    return text[:s] + text[e:], True
   128	
   129	
   130	# 2026-09-02 實跑教訓:帳號用量上限(「You've hit your session limit · resets 12:10pm」)一到,claude -p 4 秒就回、
   131	# 零工具呼叫,探針把它記成「沒敲到期望指令」——168 場裡 115 場是這種假失敗。這類場次要標出來、不算分。
   132	LIMIT_RE = re.compile(r"hit your (session|usage) limit|usage limit|rate limit|too many requests|overloaded", re.I)
   133	
   134	
   135	def is_limit_hit(calls, final_text, result_event):
   136	    """零工具呼叫 + 回覆/結果事件寫著用量或速率上限 → 這場是儀器被擋,不是被測 AI 的行為。"""
   137	    if calls:
   138	        return False
   139	    if LIMIT_RE.search(final_text or ""):
   140	        return True
   141	    ev = result_event or {}
   142	    return bool(ev.get("is_error")) and bool(LIMIT_RE.search(json.dumps(ev, ensure_ascii=False)))
   143	
   144	
   145	# 「敲 lumos」=Bash 裡跑了 lumos 的某個子指令:`scripts/lumos search`、`python3 scripts/lumos show`、`lumos doctor`。
   146	# ★2026-09-02 第一版用 \blumos\b 字界比對,把 `grep … docs/lumos-toolchain-knowledge/` 這種路徑也算成敲了 lumos,
   147	# 拔散文那組的「敲過率」被灌到 98.8%——路徑裡的 lumos 後面接的是 -,子指令後面接的是空白+字母。★
   148	# ★r1 code-ablation-probe 再修★:原前置字元類含引號 ' 與 ",害 rg 'lumos search'、echo "lumos doctor"
   149	# 這種只是搜尋/印出規則文字的被算成敲了 lumos(灌 M2/M3)。移除引號、留路徑分隔 / 與指令分隔符。
   150	LUMOS_CALL_RE = re.compile(r"(?:^|[\s;&|(`/])lumos\s+[a-z]")
   151	
   152	
   153	def lumos_stats(calls):
   154	    """回 (整場有沒有敲過 lumos 子指令, 第一次敲的是第幾個工具呼叫)。只認 Bash 指令字串;Skill 調用不算;路徑裡的 lumos 不算。"""
   155	    for i, (name, summ) in enumerate(calls):
   156	        if name == "Bash" and LUMOS_CALL_RE.search(str(summ)):   # str() 防禦:與 backfill_limit 一致(r1 邊界席)
   157	            return True, i
   158	    return False, None
   159	
   160	
   161	def global_skills_health():
   162	    """回「壞掉的」全域 skill symlink 清單 [(名字, 指向)](空=健康)。
   163	    壞掉=懸空(目標不存在)或指進臨時沙盒(路徑含 lumos-probe-)。偵測探針把 ~/.claude/skills 重連到沙盒的事故;
   164	    LUMOS_PROBE 擋不到的未知路徑靠這道事後抓。"""
   165	    skills = Path.home() / ".claude" / "skills"
   166	    bad = []
   167	    if not skills.exists():
   168	        return bad
   169	    for d in sorted(skills.iterdir()):
   170	        if not d.is_symlink():
   171	            continue
   172	        tgt = os.readlink(str(d))
   173	        if not d.exists() or "lumos-probe-" in tgt:   # d.exists() 對 symlink 是「跟隨後存不存在」
   174	            bad.append((d.name, tgt))
   175	    return bad
   176	
   177	
   178	def make_sandbox(src, arm="with"):
   179	    """複製工作樹到臨時目錄,並★切斷所有能把東西推出去的路★。回副本路徑。
   180	    arm="without":commit 前先砍 CLAUDE.md 的「第一個工具呼叫」小節(見 strip_lumos_first_rule),
   181	    這樣情境之間的 git checkout -- . 不會把它復原。
   182	
   183	    2026-08-23 事故:守衛題 a05 的情境是「沒有我就開工做」,被測 AI 真的改了計劃檔並 push——
   184	    臨時副本是 rsync 來的,.git/config 裡的 remote 跟著複製,push 就直接推到真遠端,
   185	    主幹多了一筆 author=probe@local 的「probe snapshot」(已覆蓋)。
   186	    隔離不只是「動到的只是副本」,還要「副本推不出去」。三道:
   187	      ① 拔掉所有 remote(沒有目標就沒得推)
   188	      ② pre-push hook 寫死 exit 1(就算被測 AI 自己加回 remote 也擋;hooksPath 指向副本內的專用目錄)
   189	      ③ 假身分 probe@local 維持——即使前兩道都失效,GitHub 上也認得出這不是人
   190	    """
   191	    tmp = Path(tempfile.mkdtemp(prefix="lumos-probe-"))
   192	    work = tmp / "repo"
   193	    work.mkdir(parents=True)
   194	    subprocess.run(["rsync", "-a", "--exclude", "node_modules", "--exclude", ".venv",
   195	                    f"{src}/", f"{work}/"], check=True)
   196	    # ① 拔 remote
   197	    r = subprocess.run(["git", "remote"], cwd=str(work), capture_output=True, text=True)
   198	    for name in r.stdout.split():
   199	        subprocess.run(["git", "remote", "remove", name], cwd=str(work))
   200	    # ② 副本專用 hooks 目錄:pre-push 硬擋;其餘 hook 不存在=不跑(取代原本指向 /dev/null 的做法)
   201	    hooks = tmp / "hooks"
   202	    hooks.mkdir()
   203	    (hooks / "pre-push").write_text("#!/bin/sh\necho '探針沙盒:禁止 push' >&2\nexit 1\n", encoding="utf-8")
   204	    (hooks / "pre-push").chmod(0o755)
   205	    subprocess.run(["git", "config", "core.hooksPath", str(hooks)], cwd=str(work))
   206	    if arm == "without":
   207	        cm = work / "CLAUDE.md"
   208	        new, ok = strip_lumos_first_rule(cm.read_text(encoding="utf-8"))
   209	        if not ok:
   210	            raise RuntimeError("without 組:CLAUDE.md 找不到「第一個工具呼叫」小節的邊界,拔不乾淨,實驗無效,停手")
   211	        cm.write_text(new, encoding="utf-8")
   212	    # commit 成乾淨狀態(含未 commit 的改動——索引/筆記常是剛寫還沒 commit)
   213	    subprocess.run(["git", "add", "-A"], cwd=str(work))
   214	    subprocess.run(["git", "-c", "user.name=probe", "-c", "user.email=probe@local",
   215	                    "commit", "-qm", "probe snapshot", "--no-verify"], cwd=str(work))
   216	    return work
   217	
   218	
   219	def _validate_scenario(sc):
   220	    """題目缺必要欄位就回一句錯誤字串(否則 None)。★r1 邊界席:缺 expect 的畸形題原本會先燒一次真實
   221	    claude -p 才在索引時炸,白花稀缺配額;改成派工前先擋。"""
   222	    if not sc.get("id"):
   223	        return "題目缺 id"
   224	    if not sc.get("prompt"):
   225	        return f"題目 {sc.get('id')} 缺 prompt"
   226	    if not sc.get("expect"):
   227	        return f"題目 {sc.get('id')} 缺 expect(判準),不跑"
   228	    return None
   229	
   230	
   231	def run_one_codex(sc, workdir, timeout, model, arm="with"):
   232	    """Codex 版 runner:`codex exec --json -C <沙盒> --sandbox workspace-write <prompt>`。
   233	    不帶 --dangerously-bypass-hook-trust(探針測的是「會不會自己敲 lumos」,不靠 hook;要測 hook 另開)。
   234	    模型由 codex 設定決定(-m 可覆寫);用量上限偵測 Codex 側沒對應訊號,limit_hit 恆 False 並在 result_subtype 標 codex。"""
   235	    bad = _validate_scenario(sc)
   236	    if bad:
   237	        return {"id": sc.get("id", "?"), "cat": sc.get("cat"), "passed": False, "reason": f"儀器例外: {bad}", "first_tool": None,
   238	                "n_calls": 0, "calls": [], "secs": 0, "stderr": "", "arm": arm, "ever_lumos": False, "first_lumos_idx": None,
   239	                "limit_hit": False, "result_subtype": "codex", "harness": "codex"}
   240	    cmd = ["codex", "exec", "--json", "--sandbox", "workspace-write", "-C", str(workdir)]
   241	    if model:
   242	        cmd += ["-m", model]
   243	    cmd.append(sc["prompt"])
   244	    env = dict(os.environ); env["LUMOS_PROBE"] = "1"
   245	    if arm == "without":
   246	        env["LUMOS_ENTRY_HOOK_OFF"] = "1"
   247	    t0 = time.time()
   248	    try:
   249	        r = subprocess.run(cmd, cwd=str(workdir), capture_output=True, text=True, timeout=timeout, env=env, stdin=subprocess.DEVNULL)
   250	        out, err = r.stdout, r.stderr[-400:]
   251	    except subprocess.TimeoutExpired as e:
   252	        out = (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
   253	        err = "timeout"
   254	    calls, final = tool_calls_from_codex_json(out.splitlines())
   255	    ok, why, first = judge(calls, sc["expect"], sc.get("forbid_before", []))
   256	    answer_content_ok = None
   257	    if sc.get("answer_expect"):
   258	        miss_a = [e for e in sc["answer_expect"] if not re.search(e, final or "", re.I)]
   259	        answer_content_ok = not miss_a
   260	        if ok and not answer_content_ok:
   261	            ok, why = False, f"敲對了指令,但答案缺關鍵事實: {miss_a}"
   262	    ever, first_idx = lumos_stats(calls)
   263	    return {"id": sc["id"], "cat": sc.get("cat"), "passed": ok, "reason": why, "first_tool": calls[0] if calls else None,
   264	            "n_calls": len(calls), "calls": calls, "secs": round(time.time() - t0, 1), "stderr": err if not ok else "",
   265	            "answer": (final or "")[:1500], "arm": arm, "ever_lumos": ever, "first_lumos_idx": first_idx,
   266	            "answer_content_ok": answer_content_ok, "limit_hit": False, "result_subtype": "codex", "harness": "codex"}
   267	
   268	
   269	def run_one(sc, workdir, max_turns, timeout, model, arm="with"):
   270	    bad = _validate_scenario(sc)
   271	    if bad:
   272	        return {"id": sc.get("id", "?"), "cat": sc.get("cat"), "passed": False,
   273	                "reason": f"儀器例外: {bad}", "first_tool": None, "n_calls": 0, "calls": [],
   274	                "secs": 0, "stderr": "", "arm": arm, "ever_lumos": False, "first_lumos_idx": None,
   275	                "limit_hit": False, "result_subtype": None}
   276	    # ★逐題開放 Agent(2026-08-22)★:預設禁,因為多數題目不需要、開了只是燒錢又慢。
   277	    # 但「要說沒有之前先派乾淨 agent 對一次」這條紀律,★不派 agent 就測不出來★——
   278	    # 題目標 allow_agent:true 才放行,其餘照舊禁。
   279	    allow_agent = bool(sc.get("allow_agent"))
   280	    tools = ["Bash", "Read", "Grep", "Glob", "Edit", "Write", "Skill"]
   281	    if allow_agent:
   282	        tools.append("Agent")
   283	    cmd = ["claude", "-p", sc["prompt"], "--output-format", "stream-json", "--verbose",
   284	           "--max-turns", str(max_turns), "--no-session-persistence",
   285	           "--permission-mode", "acceptEdits",

