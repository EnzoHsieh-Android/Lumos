+def _cx_unescape(x: str) -> str:
+    try:
+        return json.loads('"' + x + '"')
+    except ValueError:
+        return x.replace("\\n", "\n").replace('\\"', '"')
+
+
+def _cx_text(p: dict) -> str:
+    c = p.get("content")
+    if isinstance(c, list):
+        return "\n".join(str(it.get("text", "")) for it in c if isinstance(it, dict))
+    return str(c or p.get("message") or "")
 
 
