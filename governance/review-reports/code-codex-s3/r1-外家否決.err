   172	def classify_bash(cmd: str, slug: str) -> tuple[set[str], set[str], set[str], set[str], set[str]]:
   173	    """回 (高信心讀, 啟發式讀, 寫回, lumos context/show/contracts 的詞, search 的詞)。
   174	    高信心讀=單純段落(無 heredoc/子殼/python -c)裡讀動詞帶筆記路徑;啟發式讀=腳本/heredoc/子殼內判出來的(低信心,報表分開印)。
   175	    寫回=引號外重導向(> >> 1> &> >|)到筆記 / sed -i / 腳本內就近 write。純拼字串提到路徑兩者都不算。"""
   176	    import shlex
   177	    strict, loose, wrote, lumos_terms, search_terms = set(), set(), set(), set(), set()
   178	    complex_cmd = bool(COMPLEX_RE.search(cmd))
   179	    if HEREDOC_RE.search(cmd) or re.search(r"\bpython3?\b[^\n]*\s-c\s", cmd):
   180	        r2, w2 = _script_marks(cmd, slug); loose |= r2; wrote |= w2
   181	        for m in REDIRECT_RE.finditer(_strip_quoted(cmd.split("\n")[0])):
   182	            n2 = norm_note(m.group(1), slug)
   183	            if n2: wrote.add(n2)
   184	        return strict, loose, wrote, lumos_terms, search_terms
   185	    for idx, piece in enumerate(_split_subshells(cmd)):     # 先拆子殼再切段:否則 ; | 會把 $(…) 切成不成對的半截
   186	        for seg in _segment_command(piece):
   187	            bare = _strip_quoted(seg)
   188	            for m in REDIRECT_RE.finditer(bare):
   189	                n2 = norm_note(m.group(1), slug)
   190	                if n2: wrote.add(n2)
   191	            st = _safe_tokens(seg)
   192	            if not st:
   193	                continue
   194	            j = 0
   195	            while j < len(st) and ("=" in st[j] and not st[j].startswith("-")):
   196	                j += 1
   197	            if j >= len(st):
   198	                continue
   199	            verb = os.path.basename(st[j]); args = st[j + 1:]
   200	            if verb in ("python", "python3") and args and os.path.basename(args[0]).endswith("lumos"):   # `python3 scripts/lumos …`(Codex 稿常見;S3)
   201	                j += 1; verb = os.path.basename(st[j]); args = st[j + 1:]
   202	            target = strict if (idx == 0 and not complex_cmd) else loose   # 子殼內/複合指令的讀=啟發式
   203	            if verb == "sed" and any(a == "-i" or a.startswith("-i") for a in args):
   204	                for a in args:
   205	                    n = norm_note(a, slug)
   206	                    if n: wrote.add(n)
   207	            elif verb in READ_VERBS:
   208	                for a in args:
   209	                    n = norm_note(a, slug)
   210	                    if n: target.add(n)
   211	            elif verb.endswith("lumos") and args:
   212	                sub = args[0]
   213	                try:
   214	                    raw = shlex.split(seg)
   215	                except ValueError:
   216	                    raw = st
   217	                terms = [a for a in raw[raw.index(sub) + 1:] if not a.startswith("-")] if sub in raw else [a for a in args[1:] if not a.startswith("-")]
   218	                if sub in LUMOS_CMDS:
   219	                    lumos_terms.update(terms); lumos_terms.add("".join(terms))
   220	                    for t2 in terms:   # 帶路徑的節點名(Systems/a.md、Systems/a)也對到 stem(S3;Claude 稿多用裸名,Codex 稿實看帶路徑)
   221	                        base = t2.rsplit("/", 1)[-1]
   222	                        lumos_terms.add(base[:-3] if base.endswith(".md") else base)
   223	                elif sub == "search":
   224	                    search_terms.update(terms); search_terms.update(w for t2 in terms for w in t2.split())
   225	    return strict, loose, wrote, lumos_terms, search_terms
