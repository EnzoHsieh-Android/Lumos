+            (d / "scripts" / name).write_text(runner_body, encoding="utf-8")
+        (d / "x.txt").write_text("x\n", encoding="utf-8")
+        _sp.run(["git", "-C", str(d), "add", "-A"], capture_output=True)
+        _sp.run(["git", "-C", str(d), "commit", "-qm", "init"], capture_output=True)
+        return d
+
+    def run(d):
+        env = dict(_os.environ, GIT_DIR=str(Path(d) / ".git"))
