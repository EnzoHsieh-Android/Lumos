+def t_runner_exitfirst_and_failfirst():
+    """★有紅就停、上次紅的先跑、隨機序探順序相依★(2026-09-06 全 repo 審視 #12)。
+
+    出身:全套要八分鐘,而且是純串行。開發時最常見的情況是「改了東西、某支紅了」,
+    但你得等八分鐘跑完才看得到,修完再等八分鐘確認。這三個旗標針對的就是這段來回:
+    -x 第一支紅就停、--ff 上次紅過的排最前面、--seed 打亂順序探順序相依(預設關)。
+
+    ★這支靠植入一支必紅的假測試來驗★,不是比對原始碼字串——旗標有沒有真的改變執行行為,
+    只能用真的跑一次來證明。"""
+    import subprocess as _sp, os as _os, json as _j, textwrap
+    runner_src = Path(__file__).resolve().read_text(encoding="utf-8")
+    work = Path(tempfile.mkdtemp(prefix="gctl-flags-"))
+    # 造一支只有三支測試的迷你 runner:借真 runner 的 main()/check() 太重,直接搭一個同形狀的
+    mini = work / "mini_runner.py"
+    mini.write_text(textwrap.dedent('''
+        import sys, json, argparse
+        from pathlib import Path
+        PASS = FAIL = 0
+        def check(name, cond, diag=""):
+            global PASS, FAIL
+            if cond: PASS += 1; print(f"  ok {name}")
+            else: FAIL += 1; print(f"  ng {name} {diag}")
+        def t_a(): check("a", True)
+        def t_b(): check("b", False, "刻意紅")
+        def t_c(): check("c", True)
+        def main():
+            global FAIL
+            p = argparse.ArgumentParser()
+            p.add_argument("-x", "--exitfirst", action="store_true")
+            p.add_argument("--ff", action="store_true")
+            p.add_argument("--seed", type=int, default=None)
+            a = p.parse_args()
+            cache = Path(__file__).with_name("cache.json")
+            last = []
+            try: last = json.loads(cache.read_text()).get("failed", [])
+            except Exception: pass
+            tests = [v for k, v in sorted(globals().items()) if k.startswith("t_")]
+            if a.ff and last:
+                s = set(last)
+                tests = [t for t in tests if t.__name__ in s] + [t for t in tests if t.__name__ not in s]
+            if a.seed is not None:
+                import random; random.Random(a.seed).shuffle(tests)
+            order, failed = [], []
+            for t in tests:
+                before = FAIL
+                order.append(t.__name__)
+                t()
+                if FAIL > before:
+                    failed.append(t.__name__)
+                    if a.exitfirst: break
+            cache.write_text(json.dumps({"failed": failed}))
+            print("ORDER=" + ",".join(order))
+            return 1 if FAIL else 0
+        sys.exit(main())
+    '''), encoding="utf-8")
+
+    def run(*args):
+        return _sp.run([sys.executable, str(mini), *args], capture_output=True, text=True)
+
+    # ① 不帶 -x:三支都跑
+    r = run()
+    check("★前置★ 現場成立: 不帶 -x 時三支都跑到", "ORDER=t_a,t_b,t_c" in r.stdout, r.stdout)
+    # ② 帶 -x:停在紅的那支,後面不跑
+    r = run("-x")
+    check("旗標 -x: 第一支紅就停,後面的不跑", "ORDER=t_a,t_b" in r.stdout, r.stdout)
+    # ③ --ff:上次紅的排最前面
