+
+    def mk(d, runner_body):
+        d = Path(d)
+        _sp.run(["git", "init", "-b", "main", str(d)], capture_output=True)
+        _sp.run(["git", "-C", str(d), "config", "user.email", "t@t"], capture_output=True)
+        _sp.run(["git", "-C", str(d), "config", "user.name", "t"], capture_output=True)
