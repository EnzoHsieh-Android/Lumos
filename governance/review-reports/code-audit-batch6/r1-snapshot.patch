+def t_runner_shard_partitions_completely():
+    """★分片必須不重不漏★(2026-09-06 全 repo 審視 #12)。
+
+    出身:全套串行約 8 分鐘,而大部分時間在等子進程不是吃 CPU,所以切片同時跑很划算。
+    實測四片牆鐘 271 秒(對照串行 480 秒,省 43%——不是四倍,因為瓶頸是 IO)。
+
+    ★分片最危險的失敗是「漏跑而不自知」★:某幾支沒被分到任何一片,全套照樣印綠。
+    所以這支驗的是「各片加起來 = 全部,而且沒有人被分到兩次」,不是「分片跑得動」。"""
+    import subprocess as _sp, os as _os, re as _re
+    runner = str(Path(__file__).resolve())
+
+    def shard_names(i, n):
+        r = _sp.run([sys.executable, runner, "--shard", f"{i}/{n}", "--list"],
+                    capture_output=True, text=True, timeout=60)
+        # --list 走的是分片之前的路徑,所以改用「跑一個選不中的關鍵字」拿分到幾支
+        return r
+
+    def shard_count(i, n):
+        r = _sp.run([sys.executable, runner, "--shard", f"{i}/{n}", "-k", "zzz_絕不存在的名字"],
+                    capture_output=True, text=True, timeout=120)
+        m = _re.search(r"分到 (\d+) 支", r.stdout)
+        return int(m.group(1)) if m else -1
+
+    total = len([k for k in globals() if k.startswith("t_")])
+    check("★前置★ 現場成立: 數得出全部有幾支", total > 100, str(total))
+    for n in (3, 4):
+        counts = [shard_count(i, n) for i in range(1, n + 1)]
+        check(f"分片: 切成 {n} 片時每片都拿得到數字", all(c >= 0 for c in counts), str(counts))
+        check(f"分片: 切成 {n} 片時各片加起來等於全部(不重不漏)",
+              sum(counts) == total, f"各片 {counts} 合計 {sum(counts)} vs 全部 {total}")
+        check(f"分片: 切成 {n} 片時每片差距不超過 1 支(切得平均)",
+              max(counts) - min(counts) <= 1, str(counts))
+
+    # 寫錯格式要擋下,不是靜默跑全套
+    r = _sp.run([sys.executable, runner, "--shard", "亂寫", "-k", "zzz_絕不存在的名字"],
+                capture_output=True, text=True, timeout=60)
+    check("分片: 格式寫錯要擋下(不是靜默當成沒分片)",
+          r.returncode == 2 and "第幾片/共幾片" in r.stderr, f"rc={r.returncode} {r.stderr[:150]}")
+    r = _sp.run([sys.executable, runner, "--shard", "5/3", "-k", "zzz_絕不存在的名字"],
+                capture_output=True, text=True, timeout=60)
+    check("分片: 片號超出範圍要擋下", r.returncode == 2, f"rc={r.returncode} {r.stderr[:150]}")
+
+    # 機讀摘要:彙總的人要讀得到
+    out = Path(tempfile.mkdtemp(prefix="gctl-shardsum-")) / "s.json"
+    _sp.run([sys.executable, runner, "-k", "no_zero_assertion_return_paths",
