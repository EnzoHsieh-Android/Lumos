+def _ksp_vault(land="Systems/搜尋", code="app/Screen.kt", extra=""):
+    return {f"{_KSP_V}/Projects/搜尋_計劃.md": _KSP_SEARCH_PLAN.format(land=land, extra=extra),
+            f"{_KSP_V}/Projects/結帳_計劃.md": _KSP_CHECKOUT_PLAN,
