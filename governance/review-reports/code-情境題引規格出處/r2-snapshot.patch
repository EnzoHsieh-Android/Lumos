+def _situation_rule_signals():
+    """with 區塊:殺傷力驗證期間把 SIGTERM、SIGHUP 轉成 KeyboardInterrupt,跟 Ctrl-C 走同一條收尾(_kill_run 收程序群組、
+    _isolated_worktree 收工作樹、rc 2、計劃與帳都不寫;代碼審 r1 資源 z1:對話工具逾時與關終端送的是這兩個,預設處理直接結束程序、
+    開在自己 session 的測試成孤兒)。寫法照 _lint_wt_begin/_lint_wt_end:處理器只裝在這一段、離開時還原成進來前的;
+    進來前是「忽略」的(例:nohup 開的)照留忽略,不替人改掉。不在主執行緒(signal 丟 ValueError)就不裝。
+    ★誠實邊界★:孫程序自己另開 session 會逃出程序群組,收不到(同 _kill_proc_group 的盡力而為)。"""
+    import contextlib
+    import signal
+
+    def _on(_signum, _frame):
+        raise KeyboardInterrupt
+
+    @contextlib.contextmanager
+    def _cm():
+        saved = {}
+        for name in ("SIGTERM", "SIGHUP"):
+            s = getattr(signal, name, None)
+            if s is None:
+                continue
+            try:
+                cur = signal.getsignal(s)
+                if cur == signal.SIG_IGN:
+                    continue
+                signal.signal(s, _on)
+                saved[s] = cur
+            except (ValueError, OSError):
+                pass
+        try:
+            yield
+        finally:
+            for s, h in saved.items():
+                try:
+                    signal.signal(s, h if h is not None else signal.SIG_DFL)
+                except (ValueError, OSError):
+                    pass
