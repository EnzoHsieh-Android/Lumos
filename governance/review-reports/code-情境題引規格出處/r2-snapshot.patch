+def _situation_rule_insert(text, clause, test):
+    """計劃全文插一條人裁條款 → (新全文, 條款編號, None) 或 (None, None, 原因)。號碼 = 全文所有定義行的最大號加一(不填缺號);
+    插在〈驗收條款〉節最後一條定義行之後(那一條緊接的縮排續行算它的,插在續行之後),節內一條都沒有就插在節標題下一行。
+    計劃已有同條款文字(_clause_sha 相同)而且綁同一支測試的定義行 → 不插,講已寫過哪一條(寫了計劃、帳沒記到又重跑時不寫第二條;代碼審 r1 c7)。
+    插好的全文再跑一次 clause_bindings 與 _clause_grammar,確認新條款是定義行、沒有重複、綁到 test;不是就不插(範圍 4 寫回那點)。
+    只處理 LF 計劃(CRLF 由 _situation_rule_read 先拒絕)。"""
+    heads = []
+    sec = _h2_section_lines(text, _KT_SIT_ACCEPT_H2_RE, heads=heads)
+    if sec is None or not heads:
+        return None, None, "計劃沒有〈驗收條款〉節(## 驗收條款)——先補節再跑,工具不自動建節"
+    def defined(t):
+        return [r for r in clause_bindings(t, {}, None, lambda _p: set(), lambda _p: "") if r.get("defined")]
+    rows = defined(text)
+    lines = _note_lines(text)
+    want = _clause_sha(f"- [S1] {clause} [test:{test}]")
+    same = next((r for r in rows if r.get("state") not in ("duplicate", "shadowed") and test in (r.get("refs") or [])
+                 and 0 < r["line"] <= len(lines) and _clause_sha(lines[r["line"] - 1]) == want), None)
+    if same is not None:
+        return None, None, (f"計劃已寫過 {same['id']}(同一段條款文字、綁同一支 {test});不再插第二條。"
+                            f"治理帳沒有那一筆 situation-rule 就照補記方法補(印出那一行事件加到 {GOV_LOG_REL} 尾端),不要重跑")
+    cid = f"S{max((int(r['id'][1:]) for r in rows), default=0) + 1}"
+    in_sec = {no for no, _ln in sec}
+    last = [r["line"] for r in rows if r["line"] in in_sec]
+    after = max(last or [heads[0]])
+    if last:   # 最後一條定義行緊接的縮排續行屬於它(代碼審 r1 邊界 b4):續行之後才插
+        while after < len(lines) and after + 1 in in_sec and lines[after][:1] in (" ", "\t") and lines[after].strip():
+            after += 1
+    line = f"- [{cid}] {clause} [test:{test}]"
+    new = "\n".join([*lines[:after], line, *lines[after:]]) + ("\n" if text.endswith("\n") else "")
+    got = {r["id"]: r for r in defined(new)}.get(cid)
+    if (got is None or got["line"] != after + 1 or got.get("state") in ("duplicate", "shadowed")
+            or test not in (got.get("refs") or [])):
+        return None, None, f"插進去之後 {cid} 不是一條綁到 {test} 的定義行(條款文字裡有東西讓它變成引用或吞掉了 [test:]);計劃沒動"
+    ok, _ty, why = _clause_grammar(_clause_body_of(_note_lines(new)[after]))
+    if not ok:
+        return None, None, f"插進去之後 {cid} 的句式不合一條文法({why});計劃沒動"
+    return new, cid, None
