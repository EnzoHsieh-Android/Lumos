+def _situation_rule_read(ppath):
+    """讀計劃全文 → (文字, None) 或 (None, 原因)。CRLF 換行照 load_raw_for_edit 的先例拒絕、不靜默改成 LF
+    (原本用通用換行讀、寫回整份變 LF,diff 整份重寫;代碼審 r1 b1、c8)。"""
+    try:
+        raw = ppath.read_bytes()
+    except OSError as e:
+        return None, f"計劃讀不到({e.__class__.__name__})"
+    if b"\r\n" in raw:
+        return None, ("計劃的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)、不偷偷幫你改行尾——先把計劃轉成 LF"
+                      "(確認 .gitattributes 讓圖譜目錄 eol=lf 再 git add --renormalize,或單檔 dos2unix)並提交,再跑")
+    try:
+        return raw.decode("utf-8"), None
+    except UnicodeDecodeError as e:
+        return None, f"計劃讀不成文字({e.__class__.__name__})"
