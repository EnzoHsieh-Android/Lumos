+    寫完讀回比對留在這裡。呼叫端拿著 _vault_write_lock。"""
+    try:
+        why = _write_refusal_reason(path)
+    except WriteBlocked as e:
+        return f"{e}"
+    if why:
+        return f"{why};計劃沒動"
+    try:
+        data = text.encode("utf-8")
+        _write_bytes_atomic(path, data)
+    except (OSError, UnicodeError) as e:
+        return f"計劃寫不進去({e.__class__.__name__}:{_kill_esc(str(e))[:80]});計劃沒動"
+    try:
+        back = path.read_bytes()
+    except OSError as e:
+        back = e
+    if back != data:
+        return (f"計劃寫完讀回跟要寫的不一樣({'讀不回來:' + back.__class__.__name__ if isinstance(back, OSError) else '內容不同,可能有別的程式同時改它'});"
+                "治理帳沒記——先看計劃現在的內容再決定")
+    return None
