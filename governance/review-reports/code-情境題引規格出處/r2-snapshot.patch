+def _situation_rule_clause_problem(clause):
+    """人裁的條款文字 → 問題句或 None:要能編成 UTF-8;不准有換行、[test:、[manual:、<!--;不准有 [S 接數字(會被當成別的條款編號;
+    大小寫敏感,反引號裡的 Kotlin `items[size]` 照收);不准帶 [keeps](含變體);反引號要成對;反引號外不准有 |
+    (反引號裡的 | 照收:實測 clause_bindings、_clause_grammar、規格閘、_kt_sit_plan_clauses 都讀得對;代碼審 r1 t2);
+    再用規格閘的 _clause_grammar 判句式(範圍 4 條款文字那點)。"""
+    c = clause or ""
+    if not c.strip():
+        return "條款文字是空的"
+    try:
+        c.encode("utf-8")
+    except UnicodeEncodeError:
+        return "條款文字有不能編成 UTF-8 的字(多半是命令列帶了壞位元組)——重打一次條款文字"
+    low = c.lower()
+    for bad, name in _SITUATION_RULE_BAD:
+        if bad.lower() in low:
+            return f"條款文字不准有 {name}(一行一條;測試由 --test 帶,工具自己加 [test:])"
+    if _SITUATION_RULE_CID_RE.search(c):
