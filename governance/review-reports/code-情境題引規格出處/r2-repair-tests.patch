+def _srl_group_gone(pgid, wait=5.0):
+    """程序群組 pgid 在 wait 秒內有沒有收乾淨(killpg 0 號訊號查不到 → 收掉了)。"""
+    import os, time as _t
+    t0 = _t.time()
+    while pgid and _t.time() - t0 < wait:
+        try:
+            os.killpg(pgid, 0)
+        except ProcessLookupError:
+            return True
+        except PermissionError:
+            return False
+        _t.sleep(0.05)
+    return False
