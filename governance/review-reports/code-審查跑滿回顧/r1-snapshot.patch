+def _retro_canary_load(env):
+    """審查帳全部列(濾掉規格閘留痕)依編號分組。回 (by_loop, bad_by_loop, global_err)。
+    壞行跳過;整本不是 UTF-8 → global_err;某列輪次不是字串 → bad_by_loop[編號](既有 _loop_records 會冒解碼錯誤、
+    分輪會冒 startswith 錯誤,新路徑自己接住,計劃〈實務隱患〉帳壞)。"""
+    import json as _j
+    path = env.vault.parent / ".canary-log.jsonl"
+    by, bad = {}, {}
+    try:
+        raw = path.read_bytes() if path.exists() else b""
+    except OSError as e:
+        return by, bad, f"審查帳讀不到({e.__class__.__name__})"
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as e:
+        return by, bad, f"審查帳不是 UTF-8(第 {e.start} 個位元組讀不動)"
+    for ln in text.splitlines():
+        if not ln.strip():
+            continue
+        try:
+            d = _j.loads(ln)
+        except (ValueError, RecursionError):
+            continue
+        if not isinstance(d, dict) or d.get("kind") == "spec-gate":
+            continue
+        lp = d.get("loop")
+        if not isinstance(lp, str):
+            continue
+        by.setdefault(lp, []).append(d)
+        if "round" in d and not isinstance(d["round"], str) and lp not in bad:
+            bad[lp] = f"審查帳 {_esc_clean(lp, 60)} 有一列輪次不是字串({_esc_clean(repr(d['round']), 40)})"
+    return by, bad, None
+
+
+def _retro_canary_rows(env, loop_id, cache=None):
+    """某編號的審查帳列與帳壞原因(None=讀得動)。cache=_retro_canary_load 的結果(統計一次讀完共用)。"""
+    if env is None and cache is None:
+        return [], "沒有審查帳可對"
+    by, bad, gerr = cache if cache is not None else _retro_canary_load(env)
+    return by.get(loop_id, []), (gerr or bad.get(loop_id))
+
+
+def _retro_ledger_rounds(rows):
+    """帳上輪次:相異輪次 id 依第一次出現的順序(跟 loop next 同一套,集合計數)。"""
+    out, seen = [], set()
+    for r in rows:
+        rid = r.get("round")
+        if isinstance(rid, str) and rid not in seen:
+            seen.add(rid)
+            out.append(rid)
+    return out
+
+
+def _retro_gov_events(root, loop_id=None):
+    """治理帳裡 gate=loop-retro 的事件,檔內順序;壞行(不是 UTF-8、不是 JSON、不是物件)跳過;loop_id 給了就以結構化欄位 loop 逐字比對。"""
+    import json as _j
+    try:
+        raw = (Path(root) / "docs" / GOV_LOG_NAME).read_bytes()
+    except OSError:
+        return []
+    out = []
+    for ln in raw.split(b"\n"):
+        if b"loop-retro" not in ln:
+            continue
+        try:
+            d = _j.loads(ln.decode("utf-8"))
+        except (UnicodeDecodeError, ValueError, RecursionError):
+            continue
+        if not isinstance(d, dict) or d.get("gate") != "loop-retro":
+            continue
+        if loop_id is not None and d.get("loop") != loop_id:
+            continue
+        out.append(d)
+    return out
+
+
+def _retro_is_decision(e):
+    return (e.get("kind") == "cap-decision" and e.get("decision") in _RETRO_DECISIONS
+            and isinstance(e.get("rounds"), list))
+
