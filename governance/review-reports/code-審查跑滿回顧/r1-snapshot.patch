+def _cap_retro_check(root, loop_id, decision, rows, rows_err):
+    """驗回顧檔(--check 與合格回顧判定共用)。回 (問題清單, 解析後的物件或 None)。壞檔一律判不合格並講原因,不丟堆疊。"""
+    import json as _j
+    p = _retro_path(root, loop_id)
+    rel = _retro_rel(root, p)
+    try:
+        size = p.stat().st_size
+        if not p.is_file():
+            return [f"回顧檔讀不到:{rel} 不是一般檔案"], None
+    except OSError:
+        return [f"回顧檔讀不到:{rel}(用 lumos loop retro {loop_id} --template 產骨架)"], None
+    if size > _RETRO_MAX_BYTES:
+        return [f"回顧檔超過 256KB({size} 位元組)"], None
+    try:
+        raw = p.read_bytes()
+    except OSError as e:
+        return [f"回顧檔讀不到({e.__class__.__name__}):{rel}"], None
+    if len(raw) > _RETRO_MAX_BYTES:
+        return [f"回顧檔超過 256KB({len(raw)} 位元組)"], None
+    try:
+        text = raw.decode("utf-8-sig")
+    except UnicodeDecodeError as e:
+        return [f"回顧檔不是 UTF-8(第 {e.start} 個位元組讀不動)"], None
+    try:
+        data = _j.loads(text)
+    except (ValueError, RecursionError) as e:
+        return [f"回顧檔不是合法 JSON({e.__class__.__name__})"], None
+    if not isinstance(data, dict):
+        return [f"回顧檔的根不是物件(要是 {{…}},現在是 {type(data).__name__})"], None
+    probs = []
+
+    def bad(field, why):
+        probs.append(f"{field}: {why}")
+
+    v = data.get("version")
+    if not (isinstance(v, int) and not isinstance(v, bool) and v == 1):
+        bad("version", f"要是 1,現在是 {_esc_clean(repr(v), 40)}")
+    if data.get("loop") != loop_id:
+        bad("loop", f"要等於指令給的編號 {loop_id!r},現在是 {_esc_clean(repr(data.get('loop')), 60)}")
+    want = [x for x in (decision.get("rounds") or []) if isinstance(x, str)]
+    rnds = data.get("rounds")
+    rset = set()
+    if not (isinstance(rnds, list) and all(isinstance(x, str) for x in rnds)):
+        bad("rounds", "要是字串清單")
+    else:
+        rset = set(rnds)
+        if rnds != want:
+            bad("rounds", f"要等於最新一筆人裁紀錄的輪次 {want}(順序也要一致),現在是 {_esc_clean(rnds, 120)}")
+    auditors = {r["auditor"].strip() for r in rows if isinstance(r.get("auditor"), str) and r["auditor"].strip()}
+    db, cb = data.get("drafted_by"), data.get("completed_by")
+    if not _retro_text_ok(db, 1):
+        bad("drafted_by", "要填起草的代理名稱(非空字串)")
+    if not _retro_text_ok(cb, 1):
+        bad("completed_by", "要填補完的人或編排者(非空字串)")
+    if _retro_text_ok(db, 1) and _retro_text_ok(cb, 1) and db.strip() == cb.strip():
+        bad("drafted_by", "不得等於 completed_by(起草與補完要是不同的人)")
+    if _retro_text_ok(db, 1) and db.strip() in auditors:
+        bad("drafted_by", f"{_esc_clean(db, 60)!r} 是這個迴圈的審查席;起草者要是沒參與這個迴圈的乾淨代理")
+    if rows_err:
+        bad("evidence", f"{rows_err},驗不了證據與起草者")
+    reports = set()
+    for r in rows:
+        rp = r.get("report_path")
+        if isinstance(rp, str) and rp.strip():
+            reports.add(_retro_norm_path(rp, root))
+    fams = data.get("families")
+    if not isinstance(fams, list) or not fams:
+        bad("families", "要是至少一項的清單")
+    else:
+        for i, f in enumerate(fams, 1):
+            tag = f"families[{i}]"
+            if not isinstance(f, dict):
+                bad(tag, "要是物件 {family, rounds, evidence, note}")
+                continue
+            fam = f.get("family")
+            if fam not in _RETRO_FAMILIES:
+                bad(f"{tag}.family", f"{_esc_clean(repr(fam), 40)} 不在固定清單({'、'.join(_RETRO_FAMILIES)})")
+            note = f.get("note")
+            if note is not None and not isinstance(note, str):
+                bad(f"{tag}.note", "要是字串")
+            if fam == "other" and not _retro_text_ok(note, 10):
+                bad(f"{tag}.note", "family 是 other 時要附 note 至少 10 字")
+            fr = f.get("rounds")
+            if not (isinstance(fr, list) and fr and all(isinstance(x, str) for x in fr)):
+                bad(f"{tag}.rounds", "要是至少一項的字串清單")
+            else:
+                out = [x for x in fr if x not in rset]
+                if out:
+                    bad(f"{tag}.rounds", f"{_esc_clean(out, 120)} 不在回顧的 rounds 裡")
+            ev = f.get("evidence")
+            if not (isinstance(ev, list) and ev and all(isinstance(x, str) and x.strip() for x in ev)):
+                bad(f"{tag}.evidence", "要是至少一條的席報告路徑清單")
+            elif not rows_err:
+                for x in ev:
+                    nx = _retro_norm_path(x, root)
+                    if nx not in reports:
+                        bad(f"{tag}.evidence", f"{_esc_clean(x, 100)!r} 不是這個編號帳上任何一列的席報告(report_path)")
+                    elif not (Path(nx) if os.path.isabs(nx) else Path(root) / nx).is_file():
+                        bad(f"{tag}.evidence", f"{_esc_clean(x, 100)!r} 是帳上的報告,但檔案現在不存在")
+    for key, n, what in (("why_cap", 20, "為什麼跑滿"), ("avoid", 20, "當初怎樣做能少跑一輪")):
+        if not _retro_text_ok(data.get(key), n):
+            bad(key, f"要是至少 {n} 字的字串({what})")
+    chs = data.get("changes")
+    if not isinstance(chs, list) or not chs:
+        bad("changes", "要是至少一項的清單")
+    else:
+        for i, ch in enumerate(chs, 1):
+            tag = f"changes[{i}]"
+            if not isinstance(ch, dict):
+                bad(tag, "要是物件 {target, ref, change}")
+                continue
+            tg = ch.get("target")
+            if tg not in _RETRO_TARGETS:
+                bad(f"{tag}.target", f"{_esc_clean(repr(tg), 40)} 不在固定清單({'、'.join(_RETRO_TARGETS)})")
+            elif tg == "none":
+                if not _retro_text_ok(ch.get("reason"), 10):
+                    bad(f"{tag}.reason", "target 是 none 時要附 reason 至少 10 字")
+            else:
+                if not _retro_text_ok(ch.get("ref"), 1):
+                    bad(f"{tag}.ref", "要寫改哪裡(非空字串)")
+                if not _retro_text_ok(ch.get("change"), 10):
+                    bad(f"{tag}.change", "要寫改什麼,至少 10 字")
+    return probs, (None if probs else data)
+
