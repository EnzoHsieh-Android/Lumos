+def _retro_id_bad(loop_id):
+    """回顧相關指令的編號檢查:既有 _FIX_ID_BAD_RE(/、\\、控制字元、DEL、..),另擋空字串、只有空白、「.」。回原因或空字串。"""
+    if not isinstance(loop_id, str) or not loop_id.strip():
+        return "編號是空的或只有空白"
+    if loop_id.strip() == ".":
+        return "編號不能是「.」"
+    if _FIX_ID_BAD_RE.search(loop_id):
+        return f"編號 {_esc_clean(loop_id, 60)!r} 含路徑字元或控制字元(/、\\、..、控制字元)"
+    return ""
+
+
+def _retro_root(env, repo=None):
+    return Path(repo).resolve() if repo else _vault_repo_root(env)
+
+
+def _retro_dir(root, loop_id):
+    return Path(root) / "governance" / "review-reports" / str(loop_id)
+
+
+def _retro_has_dossier(root, loop_id, rows):
+    """「有卷證資料夾」= 資料夾存在,而且裡面真的有這個編號帳上某一列的席報告(正規化後在資料夾底下、檔存在)。
+    ★只看資料夾在不在不夠★:處置閘的 roster 尾端遇到席位異常會自己 mkdir 這個資料夾(既有副作用),
+    沒有卷證的暫存迴圈問過一次閘就會被誤判成要回顧(實作期發現,計劃〈一〉補寫)。"""
+    d = _retro_dir(root, loop_id)
+    if not d.is_dir():
+        return False
+    prefix = os.path.normpath(str(Path("governance") / "review-reports" / str(loop_id))) + os.sep
