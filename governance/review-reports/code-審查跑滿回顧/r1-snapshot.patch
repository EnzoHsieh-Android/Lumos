+def _cap_retro_status(env, loop_id, root, events=None, rows=None, rows_err=None, dir_exists=None):
+    """★合格回顧的唯一判定★(處置閘第八步、canary record、loop next、doctor、retro-stats 全部呼叫這一支)。
+    取這個編號最新一筆人裁紀錄 D(治理帳檔內順序),再取 D 之後最新一筆 recorded 或 skipped 事件 E:
+    skipped → 已跳過;recorded → 回顧檔現在的 sha256 等於 E.retro_sha256 而且通過檢查(rounds 等於 D.rounds)→ 已記回顧,否則過期;沒有 E → 沒有。
+    回 dict:applies(有人裁紀錄而且卷證資料夾存在)、reason(不適用時 no-decision/no-dir)、decision(D)、
+    state(recorded/skipped/stale/none)、problems(過期的原因)、data(已記回顧時的回顧內容)。"""
+    if events is None:
+        events = _retro_gov_events(root, loop_id)
+    evs = [e for e in events if e.get("loop") == loop_id]
+    di = None
+    for i, e in enumerate(evs):
+        if _retro_is_decision(e):
+            di = i
+    res = {"applies": False, "reason": "no-decision", "decision": None, "state": None, "problems": [], "data": None}
+    if di is None:
+        return res
+    dec = evs[di]
+    res["decision"] = dec
+    if dir_exists is None:
+        _rows, _err = (rows, rows_err) if rows is not None else _retro_canary_rows(env, loop_id)
+        dir_exists = _retro_dossier_seen(root, loop_id, _rows, _err)
+    exists = dir_exists
+    if not exists:
+        res["reason"] = "no-dir"
+        return res
+    res["applies"], res["reason"] = True, None
+    last = None
+    for e in evs[di + 1:]:
+        if e.get("kind") in ("recorded", "skipped"):
+            last = e
+    if last is None:
+        res["state"] = "none"
+        return res
+    if last.get("kind") == "skipped":
+        res["state"] = "skipped"
+        return res
+    p = _retro_path(root, loop_id)
+    try:
+        if p.stat().st_size > _RETRO_MAX_BYTES:
+            raise ValueError("too-big")
+        cur = _sha256_file(p)
+    except (OSError, ValueError):
+        cur = None
+    if cur is None or cur != last.get("retro_sha256"):
+        res["state"] = "stale"
+        res["problems"] = (["回顧檔現在讀不到或超過 256KB(記過之後被移走、刪掉或改大)"] if cur is None
+                           else ["回顧檔在 --record 之後被改過(指紋對不上),改完要重新 --record"])
+        return res
+    if rows is None:
+        rows, rows_err = _retro_canary_rows(env, loop_id)
+    probs, data = _cap_retro_check(root, loop_id, dec, rows, rows_err)
+    if probs:
+        res["state"], res["problems"] = "stale", ["回顧檔指紋相符但不再通過檢查:" + ";".join(probs[:3])]
+    else:
+        res["state"], res["data"] = "recorded", data
+    return res
+
+
+def _cap_retro_template_cmd(root, loop_id):
+    import shlex as _shlex
+    return (f"lumos loop retro {_shlex.quote(loop_id)} --template > "
+            f"{_shlex.quote(_retro_rel(root, _retro_path(root, loop_id)))}")
+
+
+def _cap_retro_scan(env, root):
+    """有人裁紀錄的迴圈逐個判(retro-stats 與 doctor 共用):治理帳與審查帳各讀一次;一個迴圈判壞了只標它,不中斷。
+    回 [(編號, 判定 dict)];判壞的那個 dict 只有 error 與 decision。"""
+    events = _retro_gov_events(root)
+    order, seen, per = [], set(), {}
+    for e in events:
+        lp = e.get("loop")
+        if not isinstance(lp, str):
+            continue
+        per.setdefault(lp, []).append(e)
+        if _retro_is_decision(e) and lp not in seen:
+            seen.add(lp)
+            order.append(lp)
+    cache = _retro_canary_load(env)
+    out = []
+    for lp in order:
+        try:
+            rows, err = _retro_canary_rows(env, lp, cache=cache)
+            out.append((lp, _cap_retro_status(env, lp, root, events=per[lp], rows=rows, rows_err=err)))
+        except Exception as e:   # 一個迴圈判壞了只標它(計劃 S9)
+            d = next((x for x in reversed(per[lp]) if _retro_is_decision(x)), {})
+            out.append((lp, {"error": f"{e.__class__.__name__}: {e}", "decision": d, "applies": True, "state": None, "problems": []}))
+    return out
+
+
+def _cap_retro_record_block(env, loop_id, round_id):
+    """canary record 的擋點(計劃〈三〉1):要記的列是新的一輪(輪次 id 不在帳上)而且這個迴圈要回顧時才讀治理帳。
+    回 None=放行;否則 (原因碼, 要印到 stderr 的幾行)。沒有人裁紀錄的迴圈一律放行(行為與現狀相同)。"""
+    import shlex as _shlex
+    root = _vault_repo_root(env)
+    rows, err = _retro_canary_rows(env, loop_id)
+    if err is None and round_id in _retro_ledger_rounds(rows):
+        return None          # 同一輪第二席以後:只讀審查帳就知道,不碰治理帳
+    st = _cap_retro_status(env, loop_id, root, rows=rows, rows_err=err)
+    if not st["applies"]:
+        return None
+    q = _shlex.quote(loop_id)
+    dec = st["decision"].get("decision")
+    skip_cmd = f"lumos loop retro {q} --skip --note \"<理由>\""
+    if err:
+        if dec == "extra-round" and st["state"] == "skipped":
+            return None
+        return ("cap-ledger-bad", [
+            f"擋下:{_esc_clean(loop_id, 60)} 有人裁紀錄,但{err}——判不了這一列是不是人裁之後的新一輪,所以先不記。",
+            "  帳壞在哪:上面那句;對照 git 上一版找出壞列(git diff HEAD -- docs/.canary-log.jsonl)。",
+            f"  出口:修好審查帳再記;或人裁決定不寫回顧:{skip_cmd}"])
+    if dec == "accept-risk":
+        return ("cap-accept-risk", [
+            f"擋下:{_esc_clean(loop_id, 60)} 到上限後人裁記的是接受風險(accept-risk),不是再開一輪。",
+            ("  要再開一輪,先改記人裁:"
+             f"lumos loop cap-decision {q} --decision extra-round --note \"<理由>\"(跳過回顧解不了這個擋下)")])
+    if st["state"] in ("recorded", "skipped"):
+        return None
+    lines = [(f"擋下:{_esc_clean(loop_id, 60)} 到上限後人裁記了破例再開一輪,但這筆人裁之後的跑滿回顧"
+              f"{_RETRO_STATE_LABEL.get(st['state'], '?')}——繼續之前要先留一份回顧。")]
+    lines.append("  為什麼:回顧把這幾輪的問題歸族、寫下下次怎麼少跑一輪;再開一輪之後就沒人回頭寫了。"
+                 + (f"過期原因:{';'.join(st['problems'][:3])}" if st["problems"] else ""))
+    lines.append(f"  怎麼做:{_cap_retro_template_cmd(root, loop_id)}(派沒參與這個迴圈的乾淨代理起草),"
+                 f"lumos loop retro {q} --check 過了再 --record;人裁決定不寫:{skip_cmd}")
+    return ("cap-retro-missing", lines)
+
+
+def _disposal_retro_step(rounds, loop_id, root, env, spec_sha_override=None, retro_skip=False, dir_exists=None):
+    """處置閘第八步「跑滿回顧」:回 "fail"/"ok"/"skip"(形狀照落點那一步)。
+    skip:凍結/回放任一趟(spec_sha_override 或凍結第一趟多帶的 retro_skip;不讀回顧檔)、沒有人裁紀錄、沒有卷證資料夾。
+    fail:要回顧的迴圈回顧沒有或過期。"""
+    import shlex as _shlex
+    if spec_sha_override is not None or retro_skip:
+        print("[disposal] 跑滿回顧: —(凍結/回放模式:以問閘當下的判定為準,不讀回顧檔)")
+        return "skip"
+    if root is None:
+        root = _vault_repo_root(env) if env is not None else None
+    if root is None:
+        print("[disposal] 跑滿回顧: —(找不到 repo 根,讀不到治理帳)")
+        return "skip"
+    try:
+        err = next((f"審查帳有一列輪次不是字串({_esc_clean(repr(r.get('round')), 40)})"
+                    for r in rounds if "round" in r and not isinstance(r.get("round"), str)), None)
+        st = _cap_retro_status(env, loop_id, root, rows=rounds, rows_err=err, dir_exists=dir_exists)
+    except Exception as e:   # 新步驟自己壞掉不放行,也不丟堆疊
+        print(f"[disposal] 跑滿回顧: ✗ — 判不了({e.__class__.__name__}: {e})")
+        return "fail"
+    if not st["applies"]:
+        why = "沒有人裁紀錄,不需要回顧" if st["reason"] == "no-decision" else "這個迴圈沒有卷證資料夾,不需要回顧"
+        print(f"[disposal] 跑滿回顧: —({why})")
+        return "skip"
+    dec = st["decision"].get("decision")
+    label = _RETRO_STATE_LABEL.get(st["state"], "?")
+    if st["state"] in ("recorded", "skipped"):
+        print(f"[disposal] 跑滿回顧: ✓ — {label}(綁最新一筆人裁紀錄 {dec})")
+        return "ok"
+    q = _shlex.quote(loop_id)
+    if st["state"] == "none":
+        print(f"[disposal] 跑滿回顧: ✗ — 人裁記了 {dec},這筆人裁之後的回顧沒有(人裁之後要繼續,先留跑滿回顧或記跳過)")
+    else:
