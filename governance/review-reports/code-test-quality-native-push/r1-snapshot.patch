+{
+  "code": "import unittest\nfrom subject import total\n\n\nclass TotalTests(unittest.TestCase):\n    # 判準來源：題述規格；(2,False)=40、(3,False)=70 為已確認例子\n\n    def test_confirmed_examples(self):\n        self.assertEqual(total(2, False), 40)\n        self.assertEqual(total(3, False), 70)\n\n    def test_tier_boundaries_not_remote(self):\n        # 抓邊界 off-by-one（<= 誤寫為 <）與固定回傳\n        cases = {0: 40, 2: 40, 3: 70, 5: 70, 6: 100, 50: 100}\n        for w, exp in cases.items():\n            with self.subTest(weight=w):\n                self.assertEqual(total(w, False), exp)\n\n    def test_remote_adds_20(self):\n        # 抓忽略 remote 或加錯金額\n        cases = {0: 60, 2: 60, 3: 90, 5: 90, 6: 120}\n        for w, exp in cases.items():\n            with self.subTest(weight=w):\n                self.assertEqual(total(w, True), exp)\n\n    def test_negative_weight_rejected(self):\n        # 抓缺少守衛或邊界寫成 <= 0 / < -1\n        for w in (-1, -100):\n            for r in (False, True):\n                with self.subTest(weight=w, remote=r):\n                    with self.assertRaisesRegex(ValueError, \"^invalid-weight$\"):\n                        total(w, r)\n\n    def test_zero_is_valid(self):\n        self.assertEqual(total(0, False), 40)\n",
+  "sha256": "661d64d6578d90f033e5362d45bae08a61672cfab998335f9698e8a860af9e23"
