+  "code": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格；預期值依規格人工推導後固定為字面值。\n\n    def test_confirmed_examples(self):\n        # 已確認例子：route(0,True)=weekday、route(5,True)=weekend\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_boundary_4(self):\n        # 規格：day 0..4 -> weekday；抓 >=4 誤判成 weekend 的邊界錯\n        self.assertEqual(route(4, True), \"weekday\")\n\n    def test_weekday_middle(self):\n        for d in (1, 2, 3):\n            self.assertEqual(route(d, True), \"weekday\")\n\n    def test_weekend_upper_6(self):\n        # 規格：day 5..6 -> weekend；抓上界 6 處理錯\n        self.assertEqual(route(6, True), \"weekend\")\n\n    def test_disabled_paused_all_valid_days(self):\n        # 規格：合法 day 且 enabled=False -> paused（平日、週末都要）\n        for d in (0, 4, 5, 6):\n            self.assertEqual(route(d, False), \"paused\")\n\n    def test_invalid_below_range(self):\n        # -1 為非法；抓下界守衛遺漏\n        with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n            route(-1, True)\n\n    def test_invalid_above_range(self):\n        # 7 為非法；抓上界守衛遺漏（否則會回 weekend）\n        with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n            route(7, True)\n\n    def test_invalid_string_day(self):\n        # 非整數拒絕；理由需為 invalid-day（非 TypeError 比較錯）\n        with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n            route(\"3\", True)\n\n    def test_day_validated_before_enabled(self):\n        # 規格：先驗 day；enabled=False 時非法 day 仍須拒絕，不可回 paused\n        for bad in (-1, 7, \"0\"):\n            with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                route(bad, False)\n",
+  "sha256": "cbb40157119accef4bd082e754a149b7d6f856b07f537cc372662c6ab3682d30"
+}
