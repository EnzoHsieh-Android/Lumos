+    manifest['handbook_sha256'] = {arm: sha(doc) for arm, doc in docs.items()}
+    (args.out/'manifest.json').write_text(json.dumps(manifest,ensure_ascii=False,indent=2)+'\n')
+    rows = []
+    jobs = [('trigger', q['id'], 0) for q in manifest['trigger_queries']]
