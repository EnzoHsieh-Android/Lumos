+{
+  "code": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格；expected 為依規格人工推導的字面值。\n\n    def test_confirmed_examples(self):\n        # 已確認例子\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_all_days_0_to_4(self):\n        # 規格：enabled=True 且 day 0..4 -> weekday；含邊界 4（抓 >=4 誤判）\n        for d in (0, 1, 2, 3, 4):\n            self.assertEqual(route(d, True), \"weekday\", d)\n\n    def test_weekend_days_5_and_6(self):\n        # 規格：day 5..6 -> weekend；含上界 6（抓 ==5 或 >=6 誤判）\n        self.assertEqual(route(5, True), \"weekend\")\n        self.assertEqual(route(6, True), \"weekend\")\n\n    def test_disabled_returns_paused_for_every_valid_day(self):\n        # 規格：合法 day 且 enabled=False -> paused（抓忽略 enabled 的退化）\n        for d in range(7):\n            self.assertEqual(route(d, False), \"paused\", d)\n\n    def test_invalid_day_out_of_range_rejected(self):\n        # 規格：day 不在 0..6 -> ValueError(\"invalid-day\")；邊界 -1、7\n        for d in (-1, 7, 100):\n            for en in (True, False):\n                with self.assertRaisesRegex(ValueError, r\"^invalid-day$\"):\n                    route(d, en)\n\n    def test_invalid_day_string_rejected_before_enabled(self):\n        # 規格：先驗 day；字串非整數 -> invalid-day，即使 enabled=False 也不得回 paused\n        for en in (True, False):\n            with self.assertRaisesRegex(ValueError, r\"^invalid-day$\"):\n                route(\"1\", en)\n",
+  "sha256": "6a428301a1f66e96bda1cf108edc3631c59b5a4297b7248b684ceaf578f267d4"
+}
