+{
+  "code": "import unittest\nfrom subject import route\n\n\nclass RouteTest(unittest.TestCase):\n    # 判準來源：題目規格與已確認例子 route(0,True)=weekday、route(5,True)=weekend\n\n    def test_confirmed_examples(self):\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_all_days_0_to_4(self):\n        # 可抓：weekday/weekend 邊界錯在 4 附近（如 day>=4）\n        for d in range(0, 5):\n            self.assertEqual(route(d, True), \"weekday\", d)\n\n    def test_weekend_days_5_and_6(self):\n        # 可抓：邊界錯成 day>=6 或 day==5\n        for d in (5, 6):\n            self.assertEqual(route(d, True), \"weekend\", d)\n\n    def test_disabled_returns_paused_for_every_valid_day(self):\n        # 可抓：略過 enabled 檢查、只在部分日子 paused\n        for d in range(0, 7):\n            self.assertEqual(route(d, False), \"paused\", d)\n\n    def test_invalid_day_out_of_range(self):\n        # 可抓：範圍邊界寫成 <=-1 漏掉、或 >7 漏掉 7\n        for d in (-1, 7, 100):\n            for en in (True, False):\n                with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                    route(d, en)\n\n    def test_invalid_day_non_int_string(self):\n        # 可抓：缺少型別檢查；且驗證 day 先於 enabled（enabled=False 仍要拒絕）\n        for d in (\"3\", \"abc\", \"\"):\n            for en in (True, False):\n                with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                    route(d, en)\n",
+  "sha256": "1f2a18589a6e864ef572a506d0004ec7acb9da685195cbee8972aaf717b135c9"
+}
