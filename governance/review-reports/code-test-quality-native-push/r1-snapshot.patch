@@ -0,0 +1,4 @@
+{
+  "code": "import unittest\nfrom subject import total\n\n# 判準來源：題述規格（<0 拋 ValueError(\"invalid-weight\")；0..2→40，3..5→70，>=6→100；remote 加 20）\n# 已確認例子：total(2,False)=40、total(3,False)=70。其餘 expected 依規格人工推導成字面值。\n\n\nclass TotalTests(unittest.TestCase):\n    # 已確認例子\n    def test_confirmed_examples(self):\n        self.assertEqual(total(2, False), 40)\n        self.assertEqual(total(3, False), 70)\n\n    # 各區間邊界（抓 <= / < 錯位、區間誤判）\n    def test_tier1_lower_bound_zero(self):\n        self.assertEqual(total(0, False), 40)  # 0 屬 0..2\n\n    def test_tier2_upper_bound_five(self):\n        self.assertEqual(total(5, False), 70)  # 5 屬 3..5\n\n    def test_tier3_lower_bound_six(self):\n        self.assertEqual(total(6, False), 100)  # >=6\n\n    def test_tier3_large_weight(self):\n        self.assertEqual(total(1000, False), 100)  # 無上限，仍 100\n\n    # remote 加價（抓忽略 remote 或加錯金額）\n    def test_remote_adds_20_each_tier(self):\n        self.assertEqual(total(0, True), 60)\n        self.assertEqual(total(2, True), 60)\n        self.assertEqual(total(3, True), 90)\n        self.assertEqual(total(5, True), 90)\n        self.assertEqual(total(6, True), 120)\n\n    # 負重守衛（抓缺守衛、邊界寫成 <=0、錯誤理由不符）\n    def test_negative_weight_raises(self):\n        with self.assertRaisesRegex(ValueError, r\"^invalid-weight$\"):\n            total(-1, False)\n        with self.assertRaisesRegex(ValueError, r\"^invalid-weight$\"):\n            total(-1, True)\n\n    def test_zero_weight_not_rejected(self):\n        self.assertEqual(total(0, True), 60)\n",
+  "sha256": "6839e3d3dc8679dd263e2f5efa2fa58962828d2f7808b4701e0e3ffe805830c0"
+}
