+import XCTest
+import QualityCore
+final class PricingTests: XCTestCase {
+    // Independent oracle: REQUIREMENTS R1.
+    func testAmount100() { XCTAssertEqual(Pricing.price(100), 90) }
+    func testAmount200() { XCTAssertEqual(Pricing.price(200), 180) }
+    func testZero() { XCTAssertEqual(Pricing.price(0), 0) }
+}
