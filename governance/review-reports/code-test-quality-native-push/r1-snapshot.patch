+            "content": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格與已確認例子 route(2,True)=A、route(3,True)=B\n\n    def test_even_user_routes_to_A(self):\n        # 已確認例子\n        self.assertEqual(route(2, True), \"A\")\n\n    def test_odd_user_routes_to_B(self):\n        # 已確認例子；抓「永遠回 A」\n        self.assertEqual(route(3, True), \"B\")\n\n    def test_zero_is_valid_even_user(self):\n        # 規格：非負整數合法，0 為偶數\n        self.assertEqual(route(0, True), \"A\")\n\n    def test_inactive_valid_user_rejected_with_inactive_reason(self):\n        # 抓「漏掉 inactive 拒絕」與「inactive 理由錯」；user_id 合法，確保不是 invalid-user 守衛代打\n        with self.assertRaisesRegex(ValueError, r\"^inactive$\"):\n            route(2, False)\n        with self.assertRaisesRegex(ValueError, r\"^inactive$\"):\n            route(3, False)\n\n    def test_negative_user_rejected(self):\n        with self.assertRaisesRegex(ValueError, r\"^invalid-user$\"):\n            route(-1, True)\n\n    def test_string_user_rejected(self):\n        with self.assertRaisesRegex(ValueError, r\"^invalid-user$\"):\n            route(\"2\", True)\n\n    def test_user_check_precedes_active_check(self):\n        # 規格順序：先驗 user_id\n        with self.assertRaisesRegex(ValueError, r\"^invalid-user$\"):\n            route(-1, False)\n"
