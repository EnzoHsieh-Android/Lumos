+  "code": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格；expected 為依規格人工推導的字面值。\n\n    def test_confirmed_examples(self):\n        # 已確認例子\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_days_0_to_4(self):\n        # 規格：enabled=True 且 day 0..4 -> weekday；含上界 4（抓 >=4 誤判）\n        self.assertEqual(route(1, True), \"weekday\")\n        self.assertEqual(route(2, True), \"weekday\")\n        self.assertEqual(route(3, True), \"weekday\")\n        self.assertEqual(route(4, True), \"weekday\")\n\n    def test_weekend_second_day_6(self):\n        # 規格：day 6 也是 weekend（抓只認 day==5 的錯誤）\n        self.assertEqual(route(6, True), \"weekend\")\n\n    def test_disabled_returns_paused(self):\n        # 規格：合法 day 且 enabled=False -> paused；涵蓋平日、週末、上下界\n        self.assertEqual(route(0, False), \"paused\")\n        self.assertEqual(route(3, False), \"paused\")\n        self.assertEqual(route(5, False), \"paused\")\n        self.assertEqual(route(6, False), \"paused\")\n\n    def test_out_of_range_day_rejected_with_reason(self):\n        # 規格：day 不在 0..6 -> ValueError(\"invalid-day\")；邊界 -1、7\n        with self.assertRaisesRegex(ValueError, r\"^invalid-day$\"):\n            route(-1, True)\n        with self.assertRaisesRegex(ValueError, r\"^invalid-day$\"):\n            route(7, True)\n        with self.assertRaisesRegex(ValueError, r\"^invalid-day$\"):\n            route(7, False)\n\n    def test_string_day_rejected_before_enabled_check(self):\n        # 規格：先驗 day；字串 -> invalid-day，enabled=False 也不得回 paused\n        with self.assertRaisesRegex(ValueError, r\"^invalid-day$\"):\n            route(\"1\", True)\n        with self.assertRaisesRegex(ValueError, r\"^invalid-day$\"):\n            route(\"1\", False)\n",
