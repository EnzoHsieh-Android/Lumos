+
+        def fallback_ready(self):
+            return not module._trusted_private_dir(self.home / '.cache/lumos/vault-lock', '.cache', 'lumos', 'vault-lock')
+
+        def held(self):
+            return any(self.vault.glob('*.lock')) or any((self.home / '.cache/lumos/vault-lock').glob('*.lock'))
