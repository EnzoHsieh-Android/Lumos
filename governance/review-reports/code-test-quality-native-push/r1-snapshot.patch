+  "code": "import unittest\nfrom subject import total\n\n\nclass TotalTests(unittest.TestCase):\n    # 判準來源：需求規格（0..2→40、3..5→70、>=6→100、remote +20、<0 拋 invalid-weight）\n    # expected 皆依規格人工推導為字面值，不重算被測公式。\n\n    def test_confirmed_examples(self):\n        # 已確認例子\n        self.assertEqual(total(2, False), 40)\n        self.assertEqual(total(3, False), 70)\n\n    def test_tier_boundaries_not_remote(self):\n        # 抓：邊界 off-by-one、級距錯值、固定回傳\n        self.assertEqual(total(0, False), 40)   # 下界\n        self.assertEqual(total(5, False), 70)   # 第二級上界\n        self.assertEqual(total(6, False), 100)  # 第三級下界\n        self.assertEqual(total(100, False), 100)  # 大值仍為 100\n\n    def test_remote_adds_20(self):\n        # 抓：remote 加價遺漏、加錯金額、加價條件反轉\n        self.assertEqual(total(0, True), 60)\n        self.assertEqual(total(2, True), 60)\n        self.assertEqual(total(3, True), 90)\n        self.assertEqual(total(5, True), 90)\n        self.assertEqual(total(6, True), 120)\n\n    def test_negative_weight_rejected(self):\n        # 抓：負重未拒絕、邊界寫成 <=0 或 <-1、錯誤理由不符\n        for remote in (False, True):\n            with self.assertRaisesRegex(ValueError, r\"^invalid-weight$\"):\n                total(-1, remote)\n        with self.assertRaisesRegex(ValueError, r\"^invalid-weight$\"):\n            total(-100, False)\n",
+  "sha256": "7a4a84665db19738219cd2b0e14a9d16c0dacd1e5ea1f2f68a5f4de437ec6f67"
+}
