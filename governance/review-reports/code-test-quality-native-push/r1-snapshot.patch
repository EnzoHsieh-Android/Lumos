+  "code": "import unittest\nfrom subject import total\n\n\nclass TotalTests(unittest.TestCase):\n    # 判準來源：題目規格；預期值皆為手寫常數，不重算被測邏輯。\n\n    def test_confirmed_examples(self):\n        # 已確認例子：total(2,False)=40、total(3,False)=70（抓 2/3 邊界錯位）\n        self.assertEqual(total(2, False), 40)\n        self.assertEqual(total(3, False), 70)\n\n    def test_tier_0_to_2_is_40(self):\n        # 下界 0 必須合法且為 40（抓 <=0 誤拒或 <1 起算）\n        self.assertEqual(total(0, False), 40)\n        self.assertEqual(total(1, False), 40)\n\n    def test_tier_3_to_5_is_70(self):\n        # 抓 5/6 邊界錯位\n        self.assertEqual(total(5, False), 70)\n\n    def test_tier_6_and_above_is_100(self):\n        self.assertEqual(total(6, False), 100)\n        self.assertEqual(total(1000, False), 100)\n\n    def test_remote_adds_20_in_every_tier(self):\n        # 抓 remote 被忽略、加錯金額或只在某級加價\n        self.assertEqual(total(0, True), 60)\n        self.assertEqual(total(2, True), 60)\n        self.assertEqual(total(3, True), 90)\n        self.assertEqual(total(5, True), 90)\n        self.assertEqual(total(6, True), 120)\n\n    def test_negative_weight_rejected_with_reason(self):\n        # 抓缺守衛或錯誤訊息；remote 兩值皆須拒絕\n        with self.assertRaisesRegex(ValueError, \"^invalid-weight$\"):\n            total(-1, False)\n        with self.assertRaisesRegex(ValueError, \"^invalid-weight$\"):\n            total(-1, True)\n",
+  "sha256": "1d59142d0eff59a51592fdb6bf19312da1facaa0f8035e0f272622fdf5899588"
+}
