+    for node in ast.walk(tree):
+        if type(node) not in allowed:
+            raise ValueError('unsupported-node:' + type(node).__name__)
+        if isinstance(node, ast.Import) and [(a.name, a.asname) for a in node.names] != [('unittest', None)]:
