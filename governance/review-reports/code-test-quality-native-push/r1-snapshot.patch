+  "code": "import unittest\nfrom subject import total\n\n# 判準來源：題述規格（0..2→40、3..5→70、>=6→100、remote +20、<0 拋 ValueError(\"invalid-weight\")）\n# 及已確認例子 total(2,False)=40、total(3,False)=70。expected 皆為規格字面值，不重算。\n\n\nclass TotalTests(unittest.TestCase):\n    def test_confirmed_examples(self):\n        # 已確認例子；抓 2/3 邊界錯位\n        self.assertEqual(total(2, False), 40)\n        self.assertEqual(total(3, False), 70)\n\n    def test_first_tier_bounds(self):\n        # 0 與 2 屬 40；抓下界誤判為無效或錯級\n        self.assertEqual(total(0, False), 40)\n        self.assertEqual(total(2, False), 40)\n\n    def test_second_tier_bounds(self):\n        # 5 仍為 70；抓 <=5 寫成 <5\n        self.assertEqual(total(5, False), 70)\n\n    def test_third_tier_bounds(self):\n        # 6 起為 100；抓 5/6 邊界錯位及上限退化\n        self.assertEqual(total(6, False), 100)\n        self.assertEqual(total(100, False), 100)\n\n    def test_tiers_differ(self):\n        # 抓固定回傳同一級\n        self.assertNotEqual(total(2, False), total(3, False))\n        self.assertNotEqual(total(5, False), total(6, False))\n\n    def test_remote_surcharge_each_tier(self):\n        # remote=True 加 20；抓漏加、加錯額、remote 被忽略\n        self.assertEqual(total(0, True), 60)\n        self.assertEqual(total(2, True), 60)\n        self.assertEqual(total(3, True), 90)\n        self.assertEqual(total(5, True), 90)\n        self.assertEqual(total(6, True), 120)\n\n    def test_negative_weight_rejected(self):\n        # 抓 <0 守衛缺失或寫成 <=0（0 已在上面確認合法）\n        with self.assertRaisesRegex(ValueError, r\"^invalid-weight$\"):\n            total(-1, False)\n        with self.assertRaisesRegex(ValueError, r\"^invalid-weight$\"):\n            total(-1, True)\n",
+  "sha256": "72e542fd5d28fe1199f2b81f47693a81913968c44a08cf951cfb18c591302e95"
+}
