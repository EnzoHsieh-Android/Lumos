+  "code": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格；已確認例子 route(0,True)=weekday、route(5,True)=weekend\n\n    def test_confirmed_examples(self):\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_boundaries_enabled(self):\n        # 規格：day 0..4 -> weekday；4 為上界，抓 >=4 或 >4 邊界錯\n        for d in (0, 1, 2, 3, 4):\n            self.assertEqual(route(d, True), \"weekday\", d)\n\n    def test_weekend_boundaries_enabled(self):\n        # 規格：day 5..6 -> weekend；抓只認 5 或邊界偏移\n        for d in (5, 6):\n            self.assertEqual(route(d, True), \"weekend\", d)\n\n    def test_disabled_returns_paused_for_all_valid_days(self):\n        # 規格：合法 day 且 enabled=False -> paused；抓忽略 enabled\n        for d in range(7):\n            self.assertEqual(route(d, False), \"paused\", d)\n\n    def test_invalid_day_out_of_range(self):\n        # 規格：day 須為 0..6；抓 -1、7 邊界放行\n        for d in (-1, 7, 100):\n            for en in (True, False):\n                with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                    route(d, en)\n\n    def test_invalid_day_string_rejected_even_when_disabled(self):\n        # 規格：先驗 day，再看 enabled；抓先回 paused 跳過驗證\n        for en in (True, False):\n            with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                route(\"3\", en)\n",
+  "sha256": "d29ce93c204065e808134b1ce9a318ca3e332d5780a44c5992e8cbc5601159f2"
+}
