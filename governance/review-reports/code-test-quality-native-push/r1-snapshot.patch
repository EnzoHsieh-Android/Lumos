+    allowed = {ast.Module, ast.Import, ast.ImportFrom, ast.alias, ast.ClassDef,
+               ast.FunctionDef, ast.arguments, ast.arg, ast.With, ast.withitem,
+               ast.Expr, ast.Call, ast.Attribute, ast.Name, ast.Load, ast.Store,
