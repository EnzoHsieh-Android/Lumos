+{
+  "code": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格；route(0,True)=weekday、route(5,True)=weekend 為已確認例子。\n\n    def test_confirmed_examples(self):\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_boundaries(self):\n        # day 0..4 -> weekday；抓 >=4 / >=6 之類邊界錯誤\n        for day in (0, 1, 2, 3, 4):\n            self.assertEqual(route(day, True), \"weekday\", day)\n\n    def test_weekend_boundaries(self):\n        for day in (5, 6):\n            self.assertEqual(route(day, True), \"weekend\", day)\n\n    def test_paused_when_disabled_for_every_valid_day(self):\n        # 抓忽略 enabled 的退化\n        for day in range(7):\n            self.assertEqual(route(day, False), \"paused\", day)\n\n    def test_out_of_range_rejected(self):\n        # -1 與 7 剛好在邊界外；enabled 兩種值都要先驗 day\n        for day in (-1, 7, 100):\n            for enabled in (True, False):\n                with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                    route(day, enabled)\n\n    def test_non_int_string_rejected(self):\n        for day in (\"0\", \"5\", \"abc\"):\n            for enabled in (True, False):\n                with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                    route(day, enabled)\n",
+  "sha256": "7eae71cebf128a094beac1317017abcf0f27ebd95aa2de94754ce78b0cc45814"
+}
