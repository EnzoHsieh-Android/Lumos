+            "content": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格與已確認例子 route(0,True)=weekday、route(5,True)=weekend\n\n    def test_confirmed_examples(self):\n        # 抓「固定回傳同一值」的錯誤\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_weekend_boundary(self):\n        # 規格：0..4 weekday、5..6 weekend；抓 4/5 分界錯位（如 >=4 或 >=6）\n        for d in (0, 1, 2, 3, 4):\n            self.assertEqual(route(d, True), \"weekday\", d)\n        for d in (5, 6):\n            self.assertEqual(route(d, True), \"weekend\", d)\n\n    def test_disabled_returns_paused_for_all_valid_days(self):\n        # 規格：合法 day 且 enabled=False -> paused；抓忽略 enabled 的錯誤\n        for d in range(7):\n            self.assertEqual(route(d, False), \"paused\", d)\n\n    def test_out_of_range_rejected_even_when_disabled(self):\n        # 規格：先驗 day；抓範圍邊界錯（-1、7）及先判 enabled 再驗 day 的順序錯\n        for d in (-1, 7):\n            for en in (True, False):\n                with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                    route(d, en)\n\n    def test_non_integer_rejected(self):\n        # 規格：day 必須為整數；字串拒絕案例\n        for d in (\"0\", \"5\"):\n            for en in (True, False):\n                with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                    route(d, en)\n"
