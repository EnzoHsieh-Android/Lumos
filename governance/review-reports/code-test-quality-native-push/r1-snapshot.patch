+{
+  "code": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格；expected 由規格人工推導後寫成字面值。\n\n    def test_confirmed_examples(self):\n        # 已確認例子：route(0,True)=weekday、route(5,True)=weekend\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_weekend_boundary(self):\n        # 規格：0..4 為 weekday、5..6 為 weekend；抓分界位移 (>=4 / >=6) 錯誤\n        self.assertEqual(route(4, True), \"weekday\")\n        self.assertEqual(route(6, True), \"weekend\")\n        self.assertEqual(route(1, True), \"weekday\")\n\n    def test_disabled_returns_paused_for_any_valid_day(self):\n        # 規格：合法 day 且 enabled=False 一律 paused；抓忽略 enabled 的錯誤\n        for day in (0, 4, 5, 6):\n            self.assertEqual(route(day, False), \"paused\")\n\n    def test_out_of_range_day_rejected(self):\n        # 規格：day 必須在 0..6；抓邊界 off-by-one（-1、7 被接受）\n        for day in (-1, 7):\n            with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                route(day, True)\n\n    def test_non_int_day_rejected(self):\n        # 規格：day 必須是整數；字串 \"1\" 應拒絕而非當成 1\n        with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n            route(\"1\", True)\n\n    def test_validation_precedes_paused(self):\n        # 規格：先驗 day；非法 day 即使 enabled=False 也要 ValueError 而非 paused\n        with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n            route(7, False)\n        with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n            route(\"x\", False)\n",
+  "sha256": "bd5f134252b19d7d859ee29407aca7285d7ca7e78d77540289f6aeb108a0c76f"
+}
