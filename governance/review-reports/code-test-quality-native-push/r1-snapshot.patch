+  "code": "import unittest\nfrom subject import total\n\n# 判準來源：需求規格（0..2→40, 3..5→70, >=6→100, remote +20, <0 → ValueError(\"invalid-weight\")）\n# 已確認例子：total(2,False)=40、total(3,False)=70。其餘 expected 依規格人工推導為字面值。\n\n\nclass TotalTests(unittest.TestCase):\n    # 已確認例子\n    def test_confirmed_examples(self):\n        self.assertEqual(total(2, False), 40)\n        self.assertEqual(total(3, False), 70)\n\n    # 邊界：0 屬第一級（規格 0..2）；抓「<=0 誤判為錯誤」或級距下界錯\n    def test_zero_weight_is_base_40(self):\n        self.assertEqual(total(0, False), 40)\n\n    # 5/6 邊界：5→70、6→100；抓 <=5 寫成 <5 或 <=6\n    def test_tier_boundary_5_and_6(self):\n        self.assertEqual(total(5, False), 70)\n        self.assertEqual(total(6, False), 100)\n\n    # >=6 無上限：大重量仍為 100\n    def test_large_weight_is_100(self):\n        self.assertEqual(total(1000, False), 100)\n\n    # remote 加 20：每一級皆驗，抓「忘加」「只對某級加」「加錯金額」\n    def test_remote_adds_20_each_tier(self):\n        self.assertEqual(total(0, True), 60)\n        self.assertEqual(total(2, True), 60)\n        self.assertEqual(total(3, True), 90)\n        self.assertEqual(total(5, True), 90)\n        self.assertEqual(total(6, True), 120)\n\n    # 負重量拒絕，核對理由字串；-1 為緊鄰邊界，抓 <0 寫成 <-1\n    def test_negative_weight_rejected(self):\n        with self.assertRaisesRegex(ValueError, \"^invalid-weight$\"):\n            total(-1, False)\n        with self.assertRaisesRegex(ValueError, \"^invalid-weight$\"):\n            total(-50, True)\n",
+  "sha256": "fb674e82d0193ccfa432cb4af65a676a045464c37bca92551052ffabebe885a6"
+}
