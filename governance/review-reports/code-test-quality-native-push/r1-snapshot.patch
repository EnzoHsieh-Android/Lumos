+            "content": "import unittest\nfrom subject import route\n\n\nclass RouteTests(unittest.TestCase):\n    # 判準來源：題目規格與已確認例子 route(0,True)=weekday、route(5,True)=weekend\n\n    def test_confirmed_examples(self):\n        self.assertEqual(route(0, True), \"weekday\")\n        self.assertEqual(route(5, True), \"weekend\")\n\n    def test_weekday_boundary_and_all_weekdays(self):\n        # 抓：邊界寫錯 (>=4 / >=6) 或固定回傳\n        for d in range(0, 5):\n            self.assertEqual(route(d, True), \"weekday\", d)\n\n    def test_weekend_all_days(self):\n        for d in (5, 6):\n            self.assertEqual(route(d, True), \"weekend\", d)\n\n    def test_disabled_returns_paused_for_every_valid_day(self):\n        # 抓：忽略 enabled\n        for d in range(0, 7):\n            self.assertEqual(route(d, False), \"paused\", d)\n\n    def test_out_of_range_rejected(self):\n        # 抓：範圍守衛缺失或 off-by-one（-1、7 是最近的非法值）\n        for d in (-1, 7, 100):\n            with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                route(d, True)\n\n    def test_invalid_day_checked_before_enabled(self):\n        # 規格「先驗 day」：enabled=False 也須拒絕，而非回 paused\n        for d in (-1, 7, \"3\"):\n            with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n                route(d, False)\n\n    def test_string_day_rejected(self):\n        # 抓：缺型別檢查（字串會在比較時拋 TypeError 而非 ValueError）\n        with self.assertRaisesRegex(ValueError, \"^invalid-day$\"):\n            route(\"0\", True)\n"
