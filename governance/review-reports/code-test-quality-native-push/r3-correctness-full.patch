+    sources = {}
+    for name, expected in _TEST_QUALITY_BUNDLE_DIGESTS.items():
+        with (folder / name).open("rb") as stream:
+            raw = stream.read(10 * 1024 * 1024 + 1)
+        if len(raw) > 10 * 1024 * 1024 or _vendored_digest(raw) != expected:
+            raise ValueError("配套版本不一致:" + name)
+        sources[name.removesuffix(".py")] = (folder / name, raw)
+    return sources
