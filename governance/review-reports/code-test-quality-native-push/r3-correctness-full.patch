+def _deinit_remove_bytecode(root: Path) -> list:
+    cache = root / "scripts/__pycache__"
+    if (cache.parent.is_symlink() or cache.is_symlink() or not cache.is_dir()
+            or cache.resolve() != root.resolve() / "scripts/__pycache__"):
+        return []
+    names = {Path(p).stem for p in _VENDORED_TOOLKIT if p.endswith(".py")}
+    removed = []
+    patterns = [re.escape(name) + r"[.]cpython-[0-9]+(?:[.]opt-[0-9]+)?[.]pyc" for name in names]
+    patterns.append(r"lumoscpython-[0-9]+(?:[.]opt-[0-9]+)?[.]pyc")
+    for path in cache.glob("*.pyc"):
+        if not any(re.fullmatch(pattern, path.name) for pattern in patterns):
+            continue
+        try:
+            path.unlink()
+            removed.append(str(path.relative_to(root)))
+        except OSError as exc:
+            print(f"  ⚠ 移除 {path} 失敗,跳過: {exc}", file=sys.stderr)
+    try:
+        cache.rmdir()
+    except OSError:
+        pass  # 使用者的 bytecode 仍在時保留目錄。
+    return removed
