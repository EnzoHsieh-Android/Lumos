+def _test_quality_load_bundle():
+    import importlib.util
+    missing = object()
+    previous = {}
+    try:
+        sources = _test_quality_bundle_sources()
+        previous = {name: sys.modules.get(name, missing) for name in sources}
+        for name, (path, raw) in sources.items():
+            spec = importlib.util.spec_from_file_location(name, path)
+            module = importlib.util.module_from_spec(spec)
+            sys.modules[name] = module
+            exec(compile(raw, str(path), "exec"), module.__dict__)
+    except (OSError, ValueError, ImportError, SyntaxError) as exc:
+        for name, module in previous.items():
+            if module is missing:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = module
