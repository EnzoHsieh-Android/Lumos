+def _test_quality_bundle_sources():
+    folder = Path(__file__).resolve().parent
+    required = {Path(p).name for p in _VENDORED_TOOLKIT if Path(p).name.startswith("test_quality")}
+    if required != set(_TEST_QUALITY_BUNDLE_DIGESTS):
