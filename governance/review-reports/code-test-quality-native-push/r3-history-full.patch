+{
+  "model": "claude-opus-5-5",
+  "repeats": 2,
+  "arms": {
+    "baseline": "專案知識圖譜(docs/{project}-knowledge/)的進場與讀寫——讀懂程式碼現況後,要補「為什麼這樣、邊界在哪、哪些不能改、會波及什麼」這類程式碼看不出的脈絡時用 lumos 查;改完 code 要寫回決策/驗證/合約;收工體檢。觸發:排查、理解既有系統、對外支援、查 DB、改名/刪除東西、開工掌握現況、收工寫回、問「圖譜有沒有記」。指令全集按情境分類在 commands/INDEX.md。",
+    "candidate": "專案知識圖譜(docs/{project}-knowledge/)的進場與讀寫——讀懂程式碼現況後,要補「為什麼這樣、邊界在哪、哪些不能改、會波及什麼」這類程式碼看不出的脈絡時用 lumos 查;改完 code 要寫回決策/驗證/合約;收工體檢。觸發:新增或修改測試、修 bug 的回歸測試、檢查測試品質、排查、理解既有系統、對外支援、查 DB、改名/刪除東西、開工掌握現況、收工寫回、問「圖譜有沒有記」。指令全集按情境分類在 commands/INDEX.md。"
+  },
+  "handbooks": {
+    "baseline": "handbook-candidate.md",
+    "candidate": "handbook-clarified.md"
+  },
+  "tasks": {
+    "shipping": {
+      "brief": "為 total(weight, remote) 補 unittest。weight 只傳非 bool 的整數，remote 只傳 bool。重量 <0 拋 ValueError(\"invalid-weight\")；重量0..2基本運費40，3..5為70，>=6為100；remote=True額外加20。已確認例子 total(2,False)=40、total(3,False)=70。請依完整規格補合理測試並交代判準與驗證。",
+      "source": "def total(weight, remote):\n    if weight < 0:\n        raise ValueError(\"invalid-weight\")\n    base = 40 if weight <= 2 else (70 if weight <= 5 else 100)\n    return base + (20 if remote else 0)\n",
+      "faults": [
+        [
+          "heavy-band",
+          "70 if weight <= 5 else 100",
+          "70"
+        ],
+        [
+          "remote",
+          "20 if remote else 0",
+          "0"
+        ],
+        [
+          "reason",
+          "\"invalid-weight\"",
+          "\"other\""
+        ]
+      ]
+    },
+    "calendar": {
+      "brief": "為 route(day, enabled) 補 unittest。本題 enabled 只傳 bool；day只傳非bool整數或拒絕案例字串。先驗day是0..6的整數，否則ValueError(\"invalid-day\")；合法day且enabled=False回\"paused\"；enabled=True時day0..4回\"weekday\"、day5..6回\"weekend\"。已確認例子 route(0,True)=weekday、route(5,True)=weekend。請依完整規格補合理測試並交代判準與驗證。",
+      "source": "def route(day, enabled):\n    if not isinstance(day, int) or day < 0 or day > 6:\n        raise ValueError(\"invalid-day\")\n    if not enabled:\n        return \"paused\"\n    return \"weekend\" if day >= 5 else \"weekday\"\n",
+      "faults": [
+        [
+          "second-weekend-day",
+          "day >= 5",
+          "day == 5"
+        ],
+        [
+          "pause",
+          "if not enabled:",
+          "if False:"
+        ],
+        [
+          "reason",
+          "\"invalid-day\"",
+          "\"other\""
+        ]
+      ]
+    }
+  },
+  "trigger_queries": [
+    {
+      "id": "add-tests",
+      "positive": true,
+      "query": "請替 subject.py 的運費功能補上單元測試，涵蓋需求中的邊界。"
+    },
+    {
+      "id": "regression",
+      "positive": true,
+      "query": "運費在重量6以上算錯了，請為 subject.py 補回歸測試。"
+    },
+    {
+      "id": "audit-tests",
+      "positive": true,
+      "query": "檢查 tests.py 的測試是不是只重抄 subject.py，有沒有抓錯能力。"
+    },
+    {
+      "id": "test-word-translation",
+      "positive": false,
+      "query": "把「測試品質」這四個字翻成英文，只回譯文。"
+    },
+    {
+      "id": "translate",
+      "positive": false,
+      "query": "將 Good morning 翻成繁體中文。"
+    },
+    {
+      "id": "arithmetic",
+      "positive": false,
+      "query": "17加25是多少？"
+    }
+  ],
+  "acceptance": {
+    "behavior": "Primary score: last complete tests.py Write before first verify.py feedback, using the same arm-blind scorer. Final post-feedback score reported separately. Two held-out business tasks, two repeats per arm; six pre-fixed faults. Baseline here is prior candidate; only manual-spec-derivation clarification differs. Descriptions identical in behavior lane. No feedback from holdout scores before freeze.",
+    "native_trigger": "Baseline vs expanded description; native Skill tool invocation and actual handbook Read recorded separately. One run per query per arm; raw user query, no explicit skill mention. Both arms use same minimal skill body and baseline handbook. Require advertised skills exactly lumos-project-notes and expected model, successful session without denied tools.",
+    "decision": "No push; adopt clarification only if improvement observed without known regression. Routing and behavior judged separately. Both-perfect or missing sessions are inconclusive.",
+    "scope": "Native Claude Code isolated project + synthetic Python; not other models/languages/project deployments."
+  },
+  "behavior_description_arm": "candidate"
+}
