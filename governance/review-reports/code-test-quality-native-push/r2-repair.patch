+def read_ready_output(selector, ready, buffers):
+    for key, _ in ready:
+        chunk = os.read(key.fd, 65536)
+        if not chunk:
+            selector.unregister(key.fileobj)
+            continue
+        buffers[key.data].extend(chunk)
+        if len(buffers[key.data]) > LIMIT:
