+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Test quality evidence report v1",
+  "type": "object",
+  "required": [
+    "schema_version",
+    "kind",
+    "tool",
+    "complete",
+    "verdict"
+  ],
+  "properties": {
+    "schema_version": {
+      "const": 1
+    },
+    "kind": {
+      "enum": [
+        "static",
+        "fault",
+        "corpus"
+      ]
+    },
+    "tool": {
+      "type": "object",
+      "required": [
+        "name",
+        "version",
+        "source_sha256"
+      ],
+      "properties": {
+        "name": {
+          "type": "string"
+        },
+        "version": {
+          "type": "string"
+        },
+        "source_sha256": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        }
+      }
+    },
+    "complete": {
+      "type": "boolean"
+    },
+    "verdict": {
+      "const": "not_assessed"
+    },
+    "inputs": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": [
+          "path",
+          "status"
+        ],
+        "properties": {
+          "status": {
+            "enum": [
+              "scanned",
+              "unsupported",
+              "error",
+              "no_tests",
+              "unavailable",
+              "timeout"
+            ]
+          }
+        }
+      }
+    },
+    "findings": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": [
+          "rule_id",
+          "status",
+          "path",
+          "line",
+          "test",
+          "reason",
+          "verification",
+          "oracle_source"
+        ],
+        "properties": {
+          "status": {
+            "const": "candidate"
+          },
+          "line": {
+            "type": "integer",
+            "minimum": 1
+          }
+        }
+      }
+    },
+    "checks": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": [
+          "case_id",
+          "status",
+          "baseline",
+          "mutant",
+          "restored"
+        ],
+        "properties": {
+          "status": {
+            "enum": [
+              "detected",
+              "survived",
+              "invalid-mutant",
+              "timeout",
+              "unavailable",
+              "unknown"
+            ]
+          }
+        }
+      }
+    }
+  },
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "kind": {
+            "const": "static"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "inputs",
+          "findings",
+          "implementations",
+          "limitations",
+          "summary",
+          "elapsed_seconds"
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "kind": {
+            "const": "fault"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "checks"
+        ]
+      }
+    },
+    {
+      "if": {
+        "properties": {
+          "kind": {
+            "const": "corpus"
+          }
+        }
+      },
+      "then": {
+        "required": [
+          "cases",
+          "corpus_sha256",
+          "supported_checks_match"
+        ]
+      }
+    }
+  ]
+}
