+    @staticmethod
+    def alive(pid):
+        run = subprocess.run(
+            ["ps", "-p", str(pid), "-o", "stat="], capture_output=True, text=True
+        )
+        return (
+            run.returncode == 0
+            and bool(run.stdout.strip())
+            and not run.stdout.strip().startswith("Z")
