 def _rg_partly_deleted(a, b, dels):
     """舊檔第 a 到 b 行的函式被刪到一部分(有刪除段跟它重疊,但沒有一段整個蓋住它)。整個刪掉的不算改到:
     函式不見了不用測,同名多載刪掉一個也不牽連留下的那個(代碼審 r3 正確性席)。"""
     return any(x <= b and a <= y for x, y in dels) and not any(x <= a and b <= y for x, y in dels)
 
 
