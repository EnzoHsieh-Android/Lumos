@@ -42212,22 +42212,22 @@ def _e2e_note_refs(root):
 
 def _e2e_note_gaps(root, feats):
     """情境與筆記對不上的兩種(單源 Projects/端到端情境對照筆記_計劃〈報告多列什麼〉)→ (沒有筆記提到的「功能.情境」,
     筆記綁了、沒有情境列到的 [{"note", "name"}], 說明清單);沒有知識圖譜時前兩項是 None。"""
     refs = _e2e_note_refs(root)
     if refs is None:
         return None, None, []
     binds, texts, names, info = refs
     case_flows = {f"{fn}.{cn}": [_e2e_norm(x) for x in c.get("flows") or []] for fn, v in feats.items() for cn, c in v["cases"].items()}
     bound = {n for _r, n in binds}
-    # 正文提到:前後要是邊界(別的路徑的尾巴、多一段副檔名都不算);前面可以多一個 ./;邊界只看英數與路徑符號,中文緊貼照算
-    pats = {f: re.compile(r"(?<![A-Za-z0-9_./-])(?:\./)?" + re.escape(f) + r"(?![A-Za-z0-9_-]|\.[A-Za-z0-9])")
+    # 正文提到:前後要是邊界(別的路徑的尾巴、多一段副檔名、後面再接一層斜線都不算);前面可以多一個 ./;邊界只看英數與路徑符號,中文緊貼照算
+    pats = {f: re.compile(r"(?<![A-Za-z0-9_./-])(?:\./)?" + re.escape(f) + r"(?![A-Za-z0-9_/-]|\.[A-Za-z0-9])")
             for fl in case_flows.values() for f in fl}
 
     def seen(flow):
         return bool(names.get(flow, set()) & bound) or any(pats[flow].search(t) for _r, t in texts)
     no_notes = sorted(k for k, fl in case_flows.items() if fl and not any(seen(f) for f in fl))
     in_cases = set().union(*(names.get(f, set()) for fl in case_flows.values() for f in fl))
     stray = [{"note": r, "name": n} for r, n in sorted(set(binds)) if n not in in_cases]
     return no_notes, stray, info
 
 
