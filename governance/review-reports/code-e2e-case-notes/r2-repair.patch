index e9da356221f4158e2a030b839f7c7b5f3e7b3398..e331e095f98604f712a502476dfbaf63bd062388 100755
--- a/scripts/lumos
+++ b/scripts/lumos
@@ -26374,20 +26374,36 @@ def _residual_scan(env, notes=None):
     cache, out = {}, []
     for rel, n in sorted(notes.items()):
         invs, _ = extract_contracts(n)
         for body in invs:
             for ref in invariant_residual_refs(body):
                 st = _pq_decision_state(env, rel, ref, cache=cache)
                 out.append((rel, body, ref, st, _residual_check(env, rel, body, ref, asks=asks, ask_err=ask_err, cache=cache)))
     return out
 
 
+def _platform_name_files(p):
+    """一個平台(load_platforms 的一格)的測試名 → 所在檔(絕對路徑集合)。走 _walk_test_files(同一份測試檔篩選)、
+    先剝註解(_strip_test_comments,跟 discover_test_methods 同一套)再比對 profile 的方法正規式;
+    殘留索引(_residual_test_files)與涵蓋報告的情境對照(_e2e_note_refs)共用這一支。"""
+    where = {}
+    strip = p["profile"].get("comment_strip", "c-style")
+    _titled = p["profile"].get("name_filter") in _TITLED_FILTERS
+    for fpath, txt in _walk_test_files(p["root"], p["profile"], with_path=True):
+        for m in p["profile"]["method_re"].finditer(_strip_test_comments(txt, strip)):
+            _nm = _test_name_of_match(m, unescape=_titled,   # 取名同 discover_test_methods
+                                      edge_strict=p["profile"].get("name_filter") == "regex_tail")
+            if _nm is not None:
+                where.setdefault(_nm, set()).add(fpath)
+    return where
+
+
 def _residual_test_files(repo_root, inv_bodies):
     """合約行綁的測試名 → {合約內文: 測試所在的檔(repo 相對路徑,排序去重)}。pitfalls 把這些檔整檔算命中(代碼審 r2 G1)。
     走 _walk_test_files(同一份測試檔篩選)、先剝註解(_strip_test_comments,跟 discover_test_methods 同一套)再比對 profile 的方法正規式;
     設定讀不到、測試根在 repo 外或找不到 → 那一支不列(索引只是讓分級多升 high,少列只少升,不會誤放行既有分級)。"""
     try:
         pdata = load_platforms(repo_root)
     except Exception:
         return {}
