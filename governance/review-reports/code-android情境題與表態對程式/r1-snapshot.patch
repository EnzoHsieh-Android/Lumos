+def _sit_s1_split_rules(cat):
+    filler = ["        val k%d = %d" % (i, i) for i in range(6)]
+    hit = "        coroutineScope { }"
+    # 跨 hunk:第 5 行與第 9 行命中(差 4),中間三行沒改 → 兩個 hunk → 兩段
