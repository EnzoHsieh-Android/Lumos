+    h = _sit_run(["pitfalls", "--diff", "HEAD~1..HEAD", "--repo", str(root)], cat)
+    check("S1 人讀輸出印情境段(身分、檔:行範圍、候選列)", segs and segs[0]["seg"] in h.stdout and "app/A.kt:3-8" in h.stdout and "D-1" in h.stdout, h.stdout[-600:])
