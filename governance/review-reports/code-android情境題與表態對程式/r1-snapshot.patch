+    check("S1 段範圍=增行前後各 3 行(第 3 到 9 行,截在檔尾第 8 行)", segs and (segs[0]["start"], segs[0]["end"]) == (3, 8), str(segs))
+    import re as _re
+    check("S1 段身分是 16 碼十六進位", segs and _re.fullmatch(r"[0-9a-f]{16}", segs[0]["seg"]) is not None, str(segs))
