+def _kt_catalog_path():
+    env = os.environ.get("LUMOS_KT_CATALOG")
+    return Path(env) if env else _KT_CATALOG_DEFAULT
+
+
+def _kt_dt_cells(line):
+    return [c.strip() for c in re.split(_KT_DT_CELL_RE, line)[1:-1]]
+
+
+def _kt_dt_norm(cell):
+    return cell.replace("\uff08", "(").replace("\uff09", ")").replace("\uff1a", ":")
+
+
+def _kt_dt_triggers(cell):
+    """觸發字格子 → (清單, 問題或 None);「(無)」= 刻意不設(同 check.py 的 dt_triggers)。"""
+    trig = [t.strip().strip("`") for t in re.split("[\u3001,\uff0c]", _kt_dt_norm(cell)) if t.strip()]
+    if "(無)" in trig:
+        return [], (None if len(trig) == 1 else "「(無)」不能跟其他觸發字並列")
+    return trig, (None if trig else "觸發字不准空(刻意不設寫「(無)」)")
+
+
+def _kt_dt_evidence(cell):
+    """證據樣式格子「主:… ;例外:…」→ ({"main": [正規式…] 或 None, "alt": …}, 問題或 None)。
+    每段是「(無)」或一到三條反引號包住的 Python 正規式;表格裡跳脫過的直線還原成 |;每條都要編譯得過。"""
+    norm = _kt_dt_norm(cell).strip()
+    if not norm.startswith("主:") or norm.count("例外:") != 1:
+        return None, "證據樣式要寫成「主:… ;例外:…」"
+    parts = norm[len("主:"):].split("例外:", 1)
+    out = {}
+    for key, part in (("main", re.sub("[;\uff1b]+$", "", parts[0].strip()).strip()), ("alt", parts[1].strip())):
+        if part == "(無)":
+            out[key] = None
+            continue
+        pats = [x.replace("\\|", "|") for x in re.findall(r"`([^`]+)`", part)]
+        if not 1 <= len(pats) <= 3 or re.sub(r"`[^`]+`", "", part).strip():
+            return None, f"{'主' if key == 'main' else '例外'}:要寫「(無)」或一到三條反引號包住的正規式"
+        for x in pats:
+            try:
