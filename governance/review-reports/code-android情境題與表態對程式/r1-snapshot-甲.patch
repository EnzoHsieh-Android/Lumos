+        print(f"提醒:情境段算不出來({e.__class__.__name__}),情境題照逐行觸發字判;推送前核對時會重算", file=sys.stderr)
+        return []
+    qs = [q for q in stack_app.get("kt", []) if q != row["question"]] + ([row["question"]] if segs else [])
+    row["applicable"] = bool(segs)
