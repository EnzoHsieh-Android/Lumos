+_KT_SIT_MAT_MAX = 120      # 段材料(包住它的函式或宣告)最多幾行,超過或找不到就用段前後各 _KT_SIT_MAT_PAD 行
+_KT_SIT_MAT_PAD = 20
+_KT_SIT_DECL_RE = (r"^\s*(?:@[\w.]+(?:\([^)]*\))?\s+)*(?:(?:public|private|protected|internal|override|open|abstract|final|suspend|inline"
+                   r"|data|sealed|enum|inner|operator|infix|tailrec|external|const|lateinit|companion|value|annotation|actual|expect)\s+)*"
+                   r"(?:fun|val|var|class|object|interface)\b")
+_KT_SIT_CLASS_HDR_RE = r"(?<!::)\b(?:class|object|interface)\b"   # 大括號前面是這些字 → 類別層(B::class.java 不算)
+
+
+def _kt_sit_levels(stripped):
+    """剝過的整支檔 → 每行開頭是不是在頂層或類別層(True/False)。大括號前面的那段宣告頭(上一個 { } ; 之後)有 class/object/interface
+    就把它當類別本體。"""
+    ok, stack, last = [], [], 0
+    pos = 0
+    for ln in stripped.split("\n"):
+        ok.append(not stack or stack[-1])
+        for k, ch in enumerate(ln):
+            if ch == "{":
+                hdr = stripped[max(last, pos + k - 300):pos + k]
+                stack.append(re.search(_KT_SIT_CLASS_HDR_RE, hdr) is not None)
+                last = pos + k + 1
+            elif ch == "}":
+                if stack:
+                    stack.pop()
+                last = pos + k + 1
+            elif ch == ";":
+                last = pos + k + 1
+        pos += len(ln) + 1
+    return ok
+
+
+def _kt_sit_decl_end(lines, start, levels):
+    """宣告從 start(1 起)開始 → 結尾行號;用剝過的文字配大括號:第一個開出來的 { 收回時結束;還沒開大括號就碰到下一個
+    同層宣告、或先收回外層的 } → 在前一行結束。超過 _KT_SIT_MAT_MAX 行回 None。"""
+    depth, opened = 0, False
+    for ln_no in range(start, min(len(lines), start + _KT_SIT_MAT_MAX) + 1):
+        ln = lines[ln_no - 1]
+        if ln_no > start and not opened and levels[ln_no - 1] and re.match(_KT_SIT_DECL_RE, ln):
+            return ln_no - 1
+        for ch in ln:
+            if ch == "{":
+                depth, opened = depth + 1, True
+            elif ch == "}":
+                depth -= 1
+                if depth < 0:
+                    return ln_no - 1 if ln_no > start else ln_no
+                if depth == 0 and opened:
+                    return ln_no
+    return None
+
+
+def _kt_sit_material(lines, levels, ln_no, cache):
+    """命中行 → 段材料 (起, 迄) 或 None(找不到或超過上限,呼叫端改用段前後各 20 行)。從命中行往上找最近一個頂層或類別層的宣告。"""
+    for k in range(ln_no, max(0, ln_no - _KT_SIT_MAT_MAX), -1):
+        if levels[k - 1] and re.match(_KT_SIT_DECL_RE, lines[k - 1]):
+            if k not in cache:
+                cache[k] = _kt_sit_decl_end(lines, k, levels)
+            end = cache[k]
+            return (k, end) if end is not None and end >= ln_no and end - k + 1 <= _KT_SIT_MAT_MAX else None
+    return None
+
+
+def _kt_sit_hunks(repo_root, diff_range):
+    """git diff -U0 <範圍> 的 .kt 改動 → {檔: [(增行 [(新行號, 文字)…], 刪行 [文字…])…]};整檔刪除不收;git 錯回 None。"""
+    import subprocess as _sp
+    r = _sp.run(["git", "-c", "core.quotePath=false", "diff", "--no-ext-diff", "--no-textconv", "-U0", diff_range, "--", "*.kt"],
+                capture_output=True, cwd=str(repo_root), timeout=_disp_git_timeout())
+    if r.returncode != 0:
+        return None
+    out, cur, hunk, new_ln, in_hdr = {}, None, None, 0, False
+    for line in _diff_text_lines(r.stdout):
+        if line.startswith("diff --git "):
+            cur, hunk, in_hdr = None, None, True      # 檔頭區:到第一個 @@ 為止(內容裡 +++ 開頭的增行不會被當成檔頭)
+        elif in_hdr and line.startswith("+++ "):
+            cur = _diff_header_path(line, "b")          # 整檔刪除是 +++ /dev/null → None,這支不收
+        elif line.startswith("@@ "):
+            in_hdr = False
+            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
+            new_ln = int(m.group(1)) if m else 0
+            hunk = ([], [])
+            if cur:
+                out.setdefault(cur, []).append(hunk)
+        elif hunk is not None and not in_hdr and line[:1] == "+":
+            hunk[0].append((new_ln, line[1:]))
+            new_ln += 1
+        elif hunk is not None and not in_hdr and line[:1] == "-":
+            hunk[1].append(line[1:])
+    return out
+
+
+def _kt_sit_read(repo_root, at_sha, rel):
+    """被推版本(at_sha;None=工作樹)的檔 → 文字(換行統一成 \n,只認 \r\n),讀不到回 None。"""
+    import subprocess as _sp
+    if at_sha:
+        r = _sp.run(["git", "show", f"{at_sha}:{rel}"], capture_output=True, cwd=str(repo_root), timeout=_disp_git_timeout())
+        if r.returncode != 0:
+            return None
+        raw = r.stdout
+    else:
+        try:
+            raw = (Path(repo_root) / rel).read_bytes()
+        except OSError:
+            return None
+    return raw.decode("utf-8", "replace").replace("\r\n", "\n")
+
+
+def _kt_sit_hits(hunk, stripped_lines, rows_rx):
+    """一個 hunk → [(行號, {列編號…})]:只看增行;import/package 行、只改空白的增行(去空白後跟同一 hunk 的刪行相同)不算。"""
+    from collections import Counter
+    dels = Counter(re.sub(r"\s", "", d) for d in hunk[1])
+    hits = []
+    for ln_no, txt in hunk[0]:
+        compact = re.sub(r"\s", "", txt)
+        if dels.get(compact):
+            dels[compact] -= 1
+            continue
+        if not 1 <= ln_no <= len(stripped_lines):
+            continue
+        code = stripped_lines[ln_no - 1]
+        if re.match(r"\s*(?:import|package)\s", code):
+            continue
+        got = {rid for rid, rx in rows_rx if rx.search(code)}
+        if got:
+            hits.append((ln_no, got))
+    return hits
+
+
+def _kt_sit_group(hits, mat_of):
+    """命中行 → 段([(行號, 列集合)…] 的清單):同一 hunk(呼叫端已分)、行號差 ≤ _KT_SIT_GAP、同一段材料才併;一段最多 _KT_SIT_SEG_MAX 行。"""
+    groups = []
+    for ln_no, got in hits:
+        g = groups[-1] if groups else None
+        if g and ln_no - g[-1][0] <= _KT_SIT_GAP and mat_of(ln_no) == mat_of(g[0][0]) and ln_no - g[0][0] < _KT_SIT_SEG_MAX:
+            g.append((ln_no, got))
+        else:
+            groups.append([(ln_no, got)])
+    return groups
+
+
+def _kt_sit_file_segments(rel, text, hunks, rows_rx):
+    """一支檔 → 這支檔的情境段清單(依行序,段身分含出現序號)。"""
+    import hashlib
+    lines = text.split("\n")
+    if text.endswith("\n"):
+        lines = lines[:-1]
+    stripped = _strip_c_comments("\n".join(lines), blank_strings=True, keep_length=True, kotlin=True).split("\n")
+    levels = _kt_sit_levels("\n".join(stripped))
+    cache, n = {}, len(lines)
+
+    def mat_of(ln_no):
+        return _kt_sit_material(stripped, levels, ln_no, cache)
+    segs, seen = [], {}
+    for hunk in hunks:
+        for g in _kt_sit_group(_kt_sit_hits(hunk, stripped, rows_rx), mat_of):
+            first, last = g[0][0], g[-1][0]
+            mat = mat_of(first) or (max(1, first - _KT_SIT_MAT_PAD), min(n, last + _KT_SIT_MAT_PAD))
+            rows = sorted({rid for _l, got in g for rid in got}, key=lambda x: int(x.split("-")[1]))
+            raw = "\n".join(lines[mat[0] - 1:mat[1]])
+            seen[raw] = seen.get(raw, 0) + 1
+            seg_id = hashlib.sha256("\0".join((rel, raw, ",".join(rows), str(seen[raw]))).encode("utf-8")).hexdigest()[:16]
+            start, end = max(1, first - _KT_SIT_CTX), min(n, last + _KT_SIT_CTX)
+            segs.append({"seg": seg_id, "file": rel, "start": start, "end": end, "lines": [x for x, _g in g], "rows": rows,
+                         "material": [mat[0], mat[1]], "_mat": "\n".join(stripped[mat[0] - 1:mat[1]]),
+                         "_code": {k: stripped[k - 1] for k in range(start, end + 1)}})
+    return segs
+
+
+def _kt_situation_segments(repo_root, diff_range, at_sha, table=None, skip=frozenset()):
+    """這次改動(diff_range)在被推版本(at_sha;None=工作樹)上的情境段清單;型錄讀不到或格式壞回 None,git 錯回 []。
+    只看非測試的 .kt(skip=消費專案裡原封不動的工具檔,同 _stack_changed_ok;pitfalls 收集時已算好就傳進來);比對前整支檔用 _strip_c_comments(kotlin=True) 剝掉註解與字串。段帶 _mat(剝過的段材料)與 _code
+    (段範圍每行剝過的文字)給表態對程式用,輸出前用 _kt_sit_public 拿掉。"""
+    rows = _KT_DT_ROWS if table is None else table
+    if table is None and _KT_DT_ERR:
+        return None
+    rows_rx = [(r["id"], re.compile("|".join(_kt_trigger_re(t) for t in r["triggers"])))
+               for r in rows if not r["retired"] and r["triggers"]]
+    if not rows_rx or not diff_range:
+        return []
+    hunks = _kt_sit_hunks(repo_root, diff_range) or {}
+    segs = []
+    for rel in sorted(hunks):
+        if _PITFALL_DIFF_TEST_PAT.search(rel) or not _stack_changed_ok(rel, skip):
+            continue
+        text = _kt_sit_read(repo_root, at_sha, rel)
+        if text is not None:
+            segs.extend(_kt_sit_file_segments(rel, text, hunks[rel], rows_rx))
+    return segs
+
+
+def _kt_sit_print_segments(segs):
+    """pitfalls --diff 人讀輸出:情境題的段(表態時每段每個候選列都要答);檔名被審分支可控,跳脫。"""
