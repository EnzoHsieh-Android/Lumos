+def _load_hook_file(path, mod_name, required=(), label="掛鉤檔"):
+    """importlib 匯入別人的掛鉤檔(它們有 __main__ 守衛,匯入不會執行)。回 (module|None, reason|None)。
+    handoff(收工 hook 的逐字稿解析器)與 spec-freeze(派工鏡頭掛鉤的 _trusted_lumos)共用這一支——同一支檔裡載入掛鉤檔只有一種做法
+    (代碼審 code-派工鏡頭可指定目標repo r1 架構1:spec-freeze 原本另組一套載入、沒關 bytecode,會在掛鉤目錄留 __pycache__)。
+    required:必備的函式名,缺一個就回 None 與原因(版本不認得);label:原因句裡怎麼稱呼這支檔。"""
+    import importlib.util as _ilu
+    p = Path(path)
+    if not p.is_file():
+        return None, f"找不到{label}({p})"
+    prev = sys.dont_write_bytecode
+    sys.dont_write_bytecode = True   # 唯讀指令不該在 repo 裡留 __pycache__(r2 折入時稽核鉤子抓到的是自己先前留的 .pyc)
+    try:
+        spec = _ilu.spec_from_file_location(mod_name, str(p))
+        mod = _ilu.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+    except Exception as e:   # 匯入是別人的檔,什麼都可能炸;這裡是查詢,炸了要變成一句原因不是 traceback
+        return None, f"{label}匯入失敗({p}:{e.__class__.__name__}:{e})"
+    finally:
+        sys.dont_write_bytecode = prev
+    for fn in required:
+        if not callable(getattr(mod, fn, None)):
+            return None, f"{label}版本不認得(缺 {fn}:{p})"
+    return mod, None
