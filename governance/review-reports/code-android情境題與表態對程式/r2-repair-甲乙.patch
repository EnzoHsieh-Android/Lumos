+    c = _sit_run(["code-loop", "check", "--diff", "HEAD~1..HEAD", "--at-sha", sha, "--branch", "feat/sit", "--repo", str(root)], cat)
+    check("D2 有段放行 → 那段整段不核、放行並印 ⚠", c.returncode == 0 and "段放行" in c.stdout + c.stderr, c.stdout[-500:] + c.stderr[-300:])
+    (root / ".lumos" / "lint-waivers.json").write_text("{壞掉", encoding="utf-8")
+    c = _sit_run(["code-loop", "check", "--diff", "HEAD~1..HEAD", "--at-sha", sha, "--branch", "feat/sit", "--repo", str(root)], cat)
+    check("D2 ★對照★ 放行檔讀不了 → 無法驗證、擋下(不當成沒有放行)", c.returncode == 1 and "無法驗證" in c.stdout + c.stderr, c.stdout[-500:] + c.stderr[-300:])
