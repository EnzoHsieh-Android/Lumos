+    改 stack_app / stack_meta 原地,回公開的段清單。"""
+    if _KT_DT_ERR and has_kt:
+        print(f"提醒:Kotlin 型錄的情境決策表{_KT_DT_ERR},這次不出情境題(工具鏈安裝不完整?)", file=sys.stderr)
+        return []
+    row = next((r for r in stack_meta.get("kt", []) if r["id"] == _KT_SIT_QID), None)
+    if row is None:
+        return []
+    try:
+        segs = _kt_situation_segments(repo_root, diff_range, _diff_range_ends(repo_root, diff_range)[1], skip=skip) or []
