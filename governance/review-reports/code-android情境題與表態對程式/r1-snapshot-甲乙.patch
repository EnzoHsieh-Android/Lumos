+def _sit_s2_try(root, cat, sha, tpl, sit):
+    """寫一份表態(kt-situation 換成 sit)再跑 code-loop check;回 (寫入結果, check rc, check 輸出)。"""
+    import json as _j
+    doc = dict(tpl)
