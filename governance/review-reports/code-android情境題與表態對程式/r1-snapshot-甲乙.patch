+    tpl = _j.loads(t.stdout) if t.stdout.strip().startswith("{") else {}
+    sha = subprocess.run(["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True).stdout.strip()
+    return root, _sit_fill_others(tpl), sha
