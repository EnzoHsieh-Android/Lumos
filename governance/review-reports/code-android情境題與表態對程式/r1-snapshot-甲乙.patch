+
+
+def _kt_sit_public(segs):
+    return [{k: v for k, v in sg.items() if not k.startswith("_")} for sg in segs or []]
+
+
+def _kt_situation_apply(repo_root, diff_range, stack_app, stack_meta, has_kt, skip=frozenset()):
+    """pitfalls --diff 收集時:型錄讀不到且有 kt 改動 → 印一行提醒;這題在題表裡(平台沒排除)就切段,出不出這題只看切不切得出段
