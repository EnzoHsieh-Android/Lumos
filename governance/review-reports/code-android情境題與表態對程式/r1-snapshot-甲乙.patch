+def _sit_ans(segs, d1=None, d3=None):
+    """依樣板的段清單填答案:第一段答 D-1、第二段答 D-3。"""
+    out = []
+    for s in segs:
+        rows = {}
+        for rid in s["rows"]:
+            rows[rid] = (d1 if rid == "D-1" else d3) or {"applies": False}
+        out.append({"seg": s["seg"], "rows": rows})
+    return {"status": "satisfied", "question": "x", "segments": out}
