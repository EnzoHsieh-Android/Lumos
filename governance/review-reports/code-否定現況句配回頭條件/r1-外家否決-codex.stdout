diff --git a/scripts/test_lumos.py b/scripts/test_lumos.py
index 9351ffc2..accfd1d6 100644
--- a/scripts/test_lumos.py
+++ b/scripts/test_lumos.py
@@ -57573,12 +57573,443 @@ def t_drift_m1_review_r3_ledger_miss_short_write():
         check("①前置:正常時寫得進去", m._drift_m1_ledger_miss(h, "a" * 40, "done") is True, "")
         orig = _o.write
         _o.write = lambda fd, data: orig(fd, data[: max(1, len(data) // 2)])
         try:
