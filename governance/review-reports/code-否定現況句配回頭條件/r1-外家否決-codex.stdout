    check("★get.ps1 不准直接叫 python(要用偵測到的那個)★", not bare, "還在寫死: %s" % bare[:3])
    print("  ✓ t_windows_interpreter_pick_matches_slim")


def t_version_single_source():
    """★版本號只有一個來源,CHANGELOG 要跟它一致★(2026-09-07 #7 對外發布線)。

    出身:`LUMOS_VERSION` 從誕生就是 v1.0,沒有 CHANGELOG、沒有 tag、沒有對外分支,
    所以「你在跑哪一版」這個問題結構上答不出來,而版本落後提醒也永遠不會響。
    這條守衛只保證一件小事但保證得死:**版本常數與變更紀錄的第一筆一致**。

    ★兩邊任一邊解析不到就算紅,不准跳過★(設計計劃 S1 明寫:守衛的尺自己也會漂)。
    格式刻意釘死,也刻意不留常駐的「未發布」區塊——那種區塊會永遠是最新一筆,
    害這條守衛每次日常推送都紅。
    """
    import re as _re
    _need_src("CHANGELOG.md", "RELEASING.md")
    root = Path(GRAPHCTL).resolve().parent.parent
    src = (root / "scripts" / "lumos").read_text(encoding="utf-8")
    m = _re.search(r'^LUMOS_VERSION = "(v\d+\.\d+)"', src, _re.M)
    check("版本常數解析得到(單一定義點)", bool(m), "找不到 LUMOS_VERSION 那一行")
    log = (root / "CHANGELOG.md").read_text(encoding="utf-8")
    m2 = _re.search(r"^## (v\d+\.\d+) — (\d{4}-\d{2}-\d{2})$", log, _re.M)
    check("變更紀錄的標題格式解析得到", bool(m2), log[:200])
    if m and m2:
        check("★版本常數與變更紀錄第一筆一致★", m.group(1) == m2.group(1),
              "常數 %s vs 變更紀錄 %s" % (m.group(1), m2.group(1)))
    check("發版 checklist 存在(只驗存在,不假裝驗內容)", (root / "RELEASING.md").exists(), "RELEASING.md")
    print("  ✓ t_version_single_source")


def _strip_comments(text, marker="#"):
    """把整行註解拿掉——守衛要看的是「程式碼真的這樣做」,不是「註解裡提過這個字」。

    (2026-09-07 代碼審 r1 外家席:第一版只數字串出現次數,於是把真正的備援邏輯整段
    刪掉、只在註解裡留兩次 `git clone` 字樣,守衛照樣綠。)
    """
    out = []
    for line in text.split("\n"):
        st = line.strip()
        if st.startswith(marker):
            continue
        out.append(line)
    return "\n".join(out)
def _lint_new_norm_snippet(lines):
    """指紋用的片段正規化:每行去行尾空白、內部連續空白壓成一個、丟空行,★前導空白原樣保留★。
    保留縮排是刻意的取捨——抹掉縮排的話,「同一段程式碼被搬進另一個會執行的區塊」會比不出來,
    那是行為改變卻無聲放行、沒有補救;保留縮排的代價只是「整批重新縮排」會產生一批假新增,那有放行管道可處理。"""
    out = []
    for ln in lines:
        m = re.match(r"^([ \t]*)(.*?)[ \t]*$", ln.rstrip("\n"))
        if m is None:
            continue
        lead, body = m.group(1), re.sub(r"\s+", " ", m.group(2))
        if body:
            out.append(lead + body)
    return "\n".join(out)


_LINT_NEW_SEP = "\x00"   # 指紋各段之間的分隔(程式碼裡不會出現,不怕跟內容撞)


def _lint_new_key(claim, text_by_file):
    """一條告警的身分。回 (key, 是不是弱比對)。
    ★不能用行號當身分★:行號會因為上下文位移而變。優先用「命中處的程式碼片段」;
    工具沒附片段就自己去讀那幾行補上(實測:主流 Python 檢查器完全不附,所以自己補是常態不是例外);
    行號缺失、小於一、或超出檔案長度=取不到片段,退到「規則+檔名+訊息」的弱比對並標明。"""
    rule = claim.get("rule") or ""
    f = claim.get("file") or ""
    line = claim.get("line") or 0
    end = claim.get("end_line") or line
    lines = text_by_file.get(f)
    if lines and isinstance(line, int) and 1 <= line <= len(lines):
        hi = end if isinstance(end, int) and line <= end <= len(lines) else line
        snippet = _lint_new_norm_snippet(lines[line - 1:hi])
        if snippet:
            return (_LINT_NEW_SEP.join([rule, f, snippet]), False)
    return (_LINT_NEW_SEP.join([rule, f, "~msg~" + str(claim.get("message", ""))]), True)


def _lint_new_read_lines(path):
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None


def _lint_new_diff_claims(base_claims, head_claims, base_files, head_files):
    """比差集:同一個指紋出現幾次。★算次數不算有無★——基準版一次、現在版三次就是新增兩條;
    用「有沒有出現過」會讓複製貼上多出來的問題被吃掉。
    回 (新增的告警清單, 有幾條是弱比對)。"""
    from collections import Counter
    import hashlib as _hl
    base_text = {f: (_lint_new_read_lines(p) or []) for f, p in base_files.items()}
    head_text = {f: (_lint_new_read_lines(p) or []) for f, p in head_files.items()}
    base_count = Counter()
    for c in base_claims:
        k, _weak = _lint_new_key(c, base_text)
        base_count[k] += 1
    new, weak = [], 0
    seen = Counter()
    for c in head_claims:
        k, is_weak = _lint_new_key(c, head_text)
        seen[k] += 1
        if seen[k] > base_count.get(k, 0):
            c = dict(c)
            c["key"] = _hl.sha256(k.encode("utf-8")).hexdigest()[:16]
            c["weak"] = is_weak
            new.append(c)
            if is_weak:
                weak += 1
    return (new, weak)


def _lint_waivers_path(repo_root):
    return Path(repo_root) / _LINT_NEW_WAIVERS_REL


def _lint_waivers_load(repo_root):
    """讀放行檔。回 ({指紋: 那筆紀錄}, 錯誤訊息 or None)。
    ★讀不了時不可以當成「沒有放行紀錄」★——那會讓所有既有放行瞬間復活、整批擋人;
    回錯誤訊息讓呼叫端歸進「環境不可用」。"""
    import json
    p = _lint_waivers_path(repo_root)
    if not p.is_file():
        return ({}, None)
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except Exception as e:
        return ({}, "放行檔讀不了(" + e.__class__.__name__ + "):" + _LINT_NEW_WAIVERS_REL)
    items = data.get("waivers") if isinstance(data, dict) else None
    if not isinstance(items, list):
        return ({}, "放行檔格式不對(要有 waivers 清單):" + _LINT_NEW_WAIVERS_REL)
    out = {}
    for it in items:
        if isinstance(it, dict) and isinstance(it.get("key"), str):
            out[it["key"]] = it
    return (out, None)


def _lint_waivers_add(repo_root, key, rule, file_rel, reason, who):
    """加一筆放行。★讀-改-寫要上鎖★:只做原子換名不夠——兩個工作階段同時放行不同指紋,
    後寫的會整份蓋掉先寫的,一條放行就這樣靜默消失(既有 _write_lf 的說明也講了讀改寫要呼叫端上鎖)。"""
    import json
    import time as _time
    p = _lint_waivers_path(repo_root)
    with _vault_write_lock(p):
        cur, err = _lint_waivers_load(repo_root)
        if err:
            return (False, err)
        if key in cur:
            return (False, "這個指紋已經放行過了(" + key + ")")
        items = list(cur.values())
        items.append({"key": key, "rule": rule, "file": file_rel, "reason": reason,
                      "by": who, "ts": _time.strftime("%Y-%m-%dT%H:%M:%S")})
        p.parent.mkdir(parents=True, exist_ok=True)
        _write_lf(p, json.dumps({"waivers": items}, ensure_ascii=False, indent=2) + "\n")
    return (True, None)


def _lint_new_clean_stale(repo_root):
    """開跑前清掉同前綴、超過一天的殘骸。★強殺(機器休眠判死)時收尾不會執行★,
    殘骸會留在專案底下那個被忽略的目錄裡;每次名字不同所以不會污染下一次比對,但要有人掃。"""
    import shutil
    import time as _time
    base = Path(repo_root) / ".lumos"
    if not base.is_dir():
        return
    now = _time.time()
    for d in base.glob("lintbase-*"):
        try:
            if d.is_dir() and now - d.stat().st_mtime > _LINT_NEW_STALE_SEC:
                shutil.rmtree(d, ignore_errors=True)
        except OSError:
            continue


def _lint_new_oversize(head_files, base_files, cfg):
    """挑出「太大所以不掃」的檔,並從兩邊的清單裡拿掉。回 [{file,lines,bytes,key,over}…]。
    ★大檔也要有指紋才放行得掉★:綁路徑不綁內容——那支檔會一直很大,綁內容的話每改一次就要重新登記。
    ★只看行數會被「整支檔只有一行」的壓縮檔騙過去★,所以兩個門檻都看。"""
    import hashlib as _hl
    out = []
    for f, path in list(head_files.items()):
        try:
    if err:
        out.update(status="env-unavailable", autopass=True, reason=err)
        return out
    # 兩路分開:程式碼檔走既有的「要不要掃」過濾;依賴宣告檔走自己的判斷
    # (那個過濾把 .json/.txt/.lock 整批當成非程式碼擋掉,依賴宣告檔大多是那幾種副檔名)
    code_pairs = [(a, b) for (a, b) in pairs_all if _stack_changed_ok(a)]
    dep_pairs = [(a, b) for (a, b) in pairs_all if _is_dep_manifest(a)]
    pairs = code_pairs + [x for x in dep_pairs if x not in code_pairs]
    if not pairs:
        out["status"], out["reason"] = "no-files", "這次改動沒有要掃的程式碼檔或依賴宣告檔"
        return out

    dep_cmds, dep_err = _lint_deps_load(repo_root)
    if dep_err:
        out.update(status="env-unavailable", autopass=True, reason=dep_err)
        return out
    cmd_targets = _lint_new_cmd_targets(code_pairs, dep_pairs, lint_cfg, dep_cmds,
                                        repo_root=repo_root, ref=head_ref)
    if not cmd_targets:
        out["status"], out["reason"] = "no-files", "這次改動的副檔名沒有對應的檢查工具宣告"
        return out

    waivers, werr = _lint_waivers_load(repo_root)
    if werr:
        out.update(status="env-unavailable", autopass=True, reason=werr)
        return out

    _lint_new_clean_stale(repo_root)
    root = Path(repo_root) / ".lumos"
    root.mkdir(parents=True, exist_ok=True)
    work = tempfile.mkdtemp(prefix="lintbase-", dir=str(root))
    try:
        base_dir, head_dir = Path(work) / "base", Path(work) / "head"
        base_dir.mkdir(parents=True, exist_ok=True)
        head_dir.mkdir(parents=True, exist_ok=True)
        base_files = _lint_new_extract(repo_root, base_ref, pairs, base_dir, "base")
        head_files = _lint_new_extract(repo_root, head_ref, pairs, head_dir, "head")
        # 兩邊都補上「跑得起來需要的東西」,而且設定檔一律取現在版(同一份規則比兩次)
        _lint_new_support(repo_root, head_ref, list(base_files), base_dir)
        _lint_new_support(repo_root, head_ref, list(head_files), head_dir)

        too_big = _lint_new_oversize(head_files, base_files, cfg)
        # 已經登記過的大檔不再擋(但照樣列出來,讓人知道那支檔沒被檢查)
        out["oversize"] = [t for t in too_big if t["key"] not in waivers]
        out["oversize_waived"] = [t for t in too_big if t["key"] in waivers]

        base_claims, head_claims = [], []
        budget_end = deadline if deadline else (_time.monotonic() + cfg["budget_sec"])
        for cmd, want_files in cmd_targets:
            if _LINT_NEW_FILES_TOKEN not in cmd:
                # 逐命令降級:只影響這一條命令,不讓整道閘降級(舊宣告不擋人,但不能拖累合格的新宣告)
                out["report_only"].append(cmd)
                continue
            left = budget_end - _time.monotonic()
            if left < cfg["per_cmd_floor_sec"]:
                # ★不要用一個必然逾時的值去跑它★:剩下的命令沒跑到,判定跟「檔太大」同類(擋),不歸自動放行
                out["undone"].append({"kind": "budget", "cmd": cmd[:80],
                                      "detail": "時間預算剩 %.0f 秒,不足單條保底 %d 秒" % (max(left, 0), cfg["per_cmd_floor_sec"])})
                continue
            ok_both = True
            for side, files, wdir in (("base", base_files, base_dir), ("head", head_files, head_dir)):
                targets = [files[f] for f in want_files if f in files]
                if not targets:
                    continue
                run_cmd = _lint_cmd_with_files(cmd, targets)
                prefix = os.path.relpath(str(wdir), str(repo_root))
                claims, ok = _lint_run_and_parse(run_cmd, repo_root, path_prefix=prefix,
                                                 timeout=max(1, int(budget_end - _time.monotonic())))
                if not ok:
                    ok_both = False
                    break
                (base_claims if side == "base" else head_claims).extend(claims)
            if ok_both:
                out["ran"].append(cmd)
            else:
                out["undone"].append({"kind": "env", "cmd": cmd[:80],
                                      "detail": "這條命令跑不出可解析的結果(工具沒裝/逾時/拉不到規則)"})

        new, weak = _lint_new_diff_claims(base_claims, head_claims, base_files, head_files)
        kept = [c for c in new if c.get("key") not in waivers]
        out["waived"] = len(new) - len(kept)
        out["new"], out["weak"] = kept, weak
    finally:
        shutil.rmtree(work, ignore_errors=True)

    _lint_new_classify(out, cfg)
    return out


def _lint_new_autopass_count(repo_root, days=30):
    """數最近 N 天新增告警閘自動放行了幾次(治理帳裡 gate=lint-new 的 fail-open 事件)。
