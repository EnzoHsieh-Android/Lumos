+def _ns_neg_segment(s, pos):
+    """pos 所在的那一小段 → (起, 迄)。"""
+    a = 0
+    for m in _NS_NEG_SEG_CUT_RE.finditer(s):
+        if m.end() <= pos:
+            a = m.end()
+        elif m.start() > pos:
+            return a, m.start()
+    return a, len(s)
