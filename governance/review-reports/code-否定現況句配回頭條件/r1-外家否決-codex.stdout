+    mode, warns = _note_shape_config(cfg_text)
     for w in warns:
         print(f"提醒:{w}", file=sys.stderr)
     if mode == "off":
         print("筆記形狀擋:這個專案把這道檢查關掉了(note_shape.gate=off),跳過", file=sys.stderr)
         return 0
-    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel)
+    # 否定現況句提醒(Projects/否定現況句配回頭條件_計劃〈做法〉3):只在提交前算;讀開關在 eval 之前,off 就不傳 hints。
+    # 讀設定、判定、組字樣、印出、記帳全包在 try 裡——提醒失敗只印一句,rc 照既有判定(掛鉤對 rc1 會擋提交)
+    hints, neg_mode, neg_warns, neg_fail = _ns_negation_prepare(cfg_text) if staged else (None, "warn", [], None)
+    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel, hints=hints)
     if res is None:
         print("筆記形狀擋:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
         return 0
     viol, errs = res
-    if not viol and not errs:
-        return 0
+    neg_items, neg_fail = _ns_negation_collected(hints, neg_warns, neg_fail)
+    rc = _note_shape_report(root, mode, mode_word, viol, errs) if (viol or errs) else 0
+    if neg_items or neg_fail:
+        _note_shape_negation_emit(root, neg_items, neg_mode, neg_fail)
+    return rc
+
+
+def _ns_negation_prepare(cfg_text):
+    """提交前讀 note_shape.negation → (hints 或 None, mode, 設定提醒, 失敗的例外類別名或 None);off 就不傳 hints。"""
+    try:
+        mode, warns = _note_shape_negation_config(cfg_text)
+    except Exception as e:
+        return None, "warn", [], e.__class__.__name__
+    return ({"items": [], "error": None, "seen": 0} if mode != "off" else None), mode, warns, None
+
+
+def _ns_negation_collected(hints, warns, fail):
+    """eval 之後 → (要印的提醒, 失敗的例外類別名或 None)。設定的提醒只在這次有要判的新筆記行時印,不是每次提交都印。"""
+    if hints is None:
+        return [], fail
+    fail = fail or hints.get("error")
+    if hints.get("seen"):
+        for w in warns:
+            print(f"提醒:{w}", file=sys.stderr)
+    return ([] if fail else hints["items"]), fail
+
+
+def _note_shape_negation_emit(root, items, mode, fail):
+    """印否定現況句提醒並記一筆 hinted 帳(只有幾行、幾篇兩個整數);任何一步出錯就丟掉這次全部提醒、只印一句。
+    ★不回傳、不改判定★:rc 由違規段決定。"""
+    msg = None
+    if not fail:
+        try:
+            msg = _ns_negation_format(items, mode)
+        except Exception as e:
+            fail = e.__class__.__name__
+    if fail:
+        print(f"提醒:否定現況句提醒這次沒跑完({fail}),不影響這道檢查的判定", file=sys.stderr)
+        return
+    try:
+        print(msg, file=sys.stderr)
+        n_lines, n_notes = len(items), len({x[0] for x in items})
+        _gate_event_or_warn(root, "note-shape", "hinted", f"這次提交:否定現況句提醒 {n_lines} 行、{n_notes} 篇",
+                            extra={"check": "negation", "lines": n_lines, "notes": n_notes})
+    except Exception as e:
+        print(f"提醒:否定現況句提醒這次沒跑完({e.__class__.__name__}),不影響這道檢查的判定", file=sys.stderr)
+
+
+def _note_shape_report(root, mode, mode_word, viol, errs):
+    """有違規時印違規段、記 blocked 或 warned 帳 → rc(block 1、warn 0)。從 cmd_note_shape 拆出來,讓否定現況句
+    提醒段接在它後面印(違規段 → 尾句與帳 → 提醒段 → hinted 帳)。"""
     head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
     print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
     for e in errs:
         print(f"  {e}", file=sys.stderr)
     for p, n, rule, frag, fix in viol:
         print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
     if mode == "block":
         print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
               "推得出來的一寫進去就會過期——見 Projects/筆記形狀擋_計劃。", file=sys.stderr)
         _gate_event_or_warn(root, "note-shape", "blocked", f"{mode_word}:新違規 {len(viol) + len(errs)} 條",
diff --git a/scripts/templates/graph-discipline.md b/scripts/templates/graph-discipline.md
index 582072c5..7b13b3bf 100644
--- a/scripts/templates/graph-discipline.md
+++ b/scripts/templates/graph-discipline.md
@@ -43,21 +43,21 @@
 | `PITFALL:` | 踩過的坑、事故根因 | 出處 + 防回歸測試或重現指令 |
 | `FACT:` `FLOW:` `DEP:` | 現況描述，**只准寫程式碼答不了的**（部署設定、資料庫實際值、生產觀測、外部、人工核可） | **程式碼查得到的一律不寫**；要寫就同一行帶 `[來源:部署]`／`[來源:資料庫]`／`[來源:生產]`／`[來源:外部]`／`[來源:人工]` 其一。只標「以程式碼為準」加查詢不再算數。沒帶來源的這三種行、新寫的程式行號引用，提交時會被擋（行號改寫成「哪支檔的哪個函式」、寫測試名，或釘版本 `路徑@<提交編號>:行號`；誤擋用 `LUMOS_SKIP_NOTE_SHAPE=1` 單次跳過、會留帳，但推上主線時 CI 照樣會擋，要改寫或把專案設成 warn） |
 
 `KEY:` 是未分類的過渡標記，舊筆記不用追改；新寫的請用上面四類。
 
 ### 鐵則
 
 1. **同一次工作內寫回**：改了會影響行為 / 決策 / 驗證的 code，當次就把脈絡寫回圖譜（pre-commit 擋「改 code 沒動圖譜」）。設計、spec、計劃一律寫成 `Projects/<主題>_計劃` 筆記。
 2. **開頭欄位用指令改**（`lumos set` / `append` / `decision-add`），別手改；多個連結一行一項；不確定是不是合約就不要標。重建筆記（regen）與決策四欄的寫法在 skill。
 3. **寫完一篇 `lumos lint <節點>`，收工 `lumos doctor`**；push 前 pre-push 會再擋一次。改完程式先跑跟改動相關的測試子集，全套留給推送前的閘（全套跑在對話裡會超時、也讓人等）；子集怎麼跑看專案自己的說明。
-4. **承認風險要附回頭看的條件**：寫「沒機械守衛 / 只提醒不擋 / 單次量測」這種話，旁邊必須有什麼時候重驗；寫不出來就是該處理不該承認。回頭條件要接電：帶日期的寫成獨立一行 `REVISIT:YYYY-MM-DD 一句要做什麼`（緊鄰原句；doctor 到期會唸）；綁事件的明寫事件入口在哪——純散文的回頭條件沒人會回頭。
+4. **承認風險要附回頭看的條件**：寫「沒機械守衛 / 只提醒不擋 / 單次量測 / 還沒有 X」這種會過期的話，把那一句本身搬成獨立一行回頭條件、原行刪掉那一句；寫不出來就是該處理不該承認。帶日期的寫 `REVISIT:YYYY-MM-DD 一句要做什麼`（doctor 到期會唸），綁事件的寫 `REVISIT:[when-file:路徑][by:YYYY-MM-DD] 一句要做什麼`（事件發生那次推送會被點名、預設擋下；寫法見 lumos-project-notes skill）——純散文的回頭條件沒人會回頭。
 5. **每支檔有家**（2026-09-11，提交前擋新違規）：每支程式檔要有一篇管它的 Systems 節點（about_code 列了它），新開用 `lumos new system <名> --code <檔> --responsibility "<負責什麼、不負責什麼>"`；節點只准用反引號寫自己家的檔，別人的檔寫成那支檔的家的 `[[連結]]`；改了程式要寫說明就寫進改到那支檔的家，而且改到的每支檔都得先有家；計劃寫 `lands_in`（現況落在哪幾篇或新開哪一篇）。舊帳看 `lumos doctor` 的 S8–S10。
 
 6. **記憶只回答「去哪裡查」，不回答「是什麼」**（兩層模式：圖譜是真相層，記憶是衍生層）：任何敘述式斷言**要嘛指到圖譜節點、要嘛帶一條宣告式檢查（`verify:`，開場唯讀重驗）；兩者都沒有就不得拿來做決定**。記憶留方法與經驗（怎麼做事、踩過什麼坑）；事實與狀態不准留在記憶裡——程式碼答得了的去查程式碼，答不了的（決策、限制、事故）才寫進圖譜——**記憶會自動塞進視野、圖譜要主動查，所以錯的那份先被讀到**（2026-09-14 實測 76 篇裡三篇在說謊）。經驗要升格成規則得進圖譜過閘，不准在記憶裡默默變成政策。
 
 ### 給人看的回報用白話
 先一句人話或比喻，再往下講；術語和 file:line 能不用就不用，非用不可就當場一句解釋。
 
 ### 設計與排查
 設計動筆前先問世界（最小解在哪一層、世界解過沒；預設借用既有設計，真沒輪子才自建，零依賴家規下幾乎不採用新依賴），一行 `PRIOR-ART:` 記進計劃筆記；同時寫一行 `RETIRE-IF:`——**看到什麼就該把這條機制／規則撤掉**（例：連續 N 週零觸發、誤報多過真報、維護成本大於省下的工時）。寫不出撤除條件，就是還沒想清楚該不該建。能寫成規則的走測試先行；探索性的先做最小實驗——講不出一道會對症狀翻紅的指令之前，不准開始建理論（見 `[[Systems/診斷迴圈先行]]`）。

