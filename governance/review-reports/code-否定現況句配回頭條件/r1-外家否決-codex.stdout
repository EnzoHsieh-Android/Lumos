# Task 2 ─────────────────────────────────────────────────────────────────────
# START 行(本 task 無版本戳;T5 會在此字串中插入版本號——形式保留易替換)


# 07-29 依官方 context engineering 指南瘦身後的紀律範本大小(a0c5100e 當時的 graph-discipline.md,5256 bytes);
# doctor Check D 拿它當基線,長回五成以上就提醒([[Projects/skills提示工程優化_計劃]] S4)。
_DISCIPLINE_SLIM_BASELINE_BYTES = 5256


def _expected_claude_body(root: Path, slug: str) -> "str | None":
    """讀 scripts/templates/graph-discipline.md,{{KG}} 替換後 strip 首尾空行 → 預期 body 字串。
    範本不存在 → None(呼叫端 skip Check D)。
    strip 用 `.strip("\\n")`(只去首尾空行、保留內縮排),與 _extract_claude_block_span 的 body
    取法一致——reinject 寫入、extract 讀回、Check D 比對三處同一算法,版本差不觸發(版本在 body 外)。"""
    tpl_path = root / "scripts" / "templates" / "graph-discipline.md"
    if not tpl_path.exists():
        return None
    return tpl_path.read_text(encoding="utf-8").replace("{{KG}}", f"docs/{slug}-knowledge/").strip("\n")



def _agents_target(root: Path) -> str:
    """Codex 讀的指示檔名:該層有 AGENTS.override.md 就只讀它(官方規則),否則 AGENTS.md(d1)。"""
    return "AGENTS.override.md" if (root / "AGENTS.override.md").exists() else "AGENTS.md"


def _reinject_targets(root: Path):
    """紀律區塊的目標清單:CLAUDE.md(Claude Code)+ Codex 的指示檔;注入/剝除/Check D 三端共用(r1 整合 F1/F2)。"""
    return ("CLAUDE.md", _agents_target(root))


def _reinject_all(root: Path, slug: str, quiet=False):
    """對所有目標各跑一次 _reinject_claude_block,印人話,回 {target: ReInjectResult}。
    既有 AGENTS 檔第一次被注入(appended)時印它前 8 行——語意衝突機器判不了(r2 整合 F12)。"""
    out = {}
    for t in _reinject_targets(root):
        ri = _reinject_claude_block(root, slug, target=t)
        out[t] = ri
        if quiet:
            continue
        if ri.status == "updated":
            print(f"  {t} 紀律區塊已更新")
            if ri.diff and t == "CLAUDE.md":
                for line in ri.diff.splitlines()[:20]:  # 最多印 20 行 diff 摘要
                    print(f"    {line}")
        elif ri.status in ("created", "appended"):
            print(f"  {t} 紀律區塊已注入({ri.status})")
            if ri.status == "appended" and t != "CLAUDE.md":
                head = (root / t).read_text(encoding="utf-8", errors="replace").splitlines()
                own = [l for l in head if "LUMOS:GRAPH-DISCIPLINE" not in l][:8]
                print(f"  ★{t} 原本就有內容,看一眼它跟紀律區塊有沒有互相打架(機器判不了語意):")
                for l in own:
                    print(f"    | {l[:100]}")
        elif ri.status == "sentinel_broken":
            print(f"  ⚠ {t} sentinel 半壞,未自動覆蓋,請檢查", file=sys.stderr)
        # unchanged / no_template → 靜默
    return out


def _reinject_claude_block(root: Path, slug: str, target: str = "CLAUDE.md") -> "ReInjectResult":
    """讀 vendored 範本 → {{KG}} 替換 → 組 sentinel block → 依三態更新 target(預設 CLAUDE.md;
    Codex 的 AGENTS.md / AGENTS.override.md 走同一段,d1)。

    status ∈ created|updated|unchanged|appended|sentinel_broken|no_template。
    diff:僅 updated 帶 difflib.unified_diff 字串,其餘 None。
    讀入時正規化 CRLF→LF 並去 BOM;寫入一律 _write_lf(強制 LF / 無 BOM)。
    """
    import difflib

    # 1. 範本 + body(共用 _expected_claude_body 確保 Check D 比對算法一致)
    body = _expected_claude_body(root, slug)
    if body is None:
        return ReInjectResult("no_template", None)

    # 3. 組 block(START 行帶當前版本戳,機械插值——版本在 body 外,不影響 Check D 比對)
    start_line = _START_TEMPLATE.format(version=LUMOS_VERSION)
    block = start_line + "\n" + body + "\n" + _CLAUDE_END

    # 4. 讀目標檔(去 BOM + CRLF 正規化;★整檔都會被正規化,不只區塊★)
    cm = root / target
    if cm.exists():
        raw = cm.read_bytes()
        # 去 UTF-8 BOM
        if raw.startswith(b"\xef\xbb\xbf"):
            raw = raw[3:]
        claude_text = raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    else:
        claude_text = None

    # 5. 三態分派
    if claude_text is None:
        # 目標不存在 → created(檔頭依目標名;r2 整合 F11:曾寫死 "# CLAUDE.md")
        _write_lf(cm, f"# {target}\n\n" + block + "\n")
        return ReInjectResult("created", None)

    state, span = _extract_claude_block_span(claude_text)

    if state == "broken":
        return ReInjectResult("sentinel_broken", None)

    if state == "absent":
        # 有檔但無 sentinel → appended。CLAUDE.md 沿舊行為接檔尾;
        # AGENTS 檔插檔首(第一個 # 標題行之後;沒有標題行→檔案最前)——Codex 把整鏈 AGENTS 檔串起來
        # 只吃 32 KiB、超過靜默截斷,靠前一點少被砍(d1;r2 邊界 N5 定 fallback)。
        if target == "CLAUDE.md":
            new_text = claude_text.rstrip() + "\n\n" + block + "\n"
        else:
            lines = claude_text.split("\n")
            idx = next((i for i, l in enumerate(lines) if l.startswith("#")), None)
            if idx is None:
                new_text = block + "\n\n" + claude_text.lstrip("\n")
            else:
                new_text = "\n".join(lines[:idx + 1]) + "\n\n" + block + "\n\n" + "\n".join(lines[idx + 1:]).lstrip("\n")
            new_text = new_text.rstrip() + "\n"
        _write_lf(cm, new_text)
        return ReInjectResult("appended", None)

    # state == "found": splice body + 同步刷新 START 行(版本戳落在存量戶的唯一路徑——
    # 只換 body 會讓 updated 路徑永遠拿不到版本戳,標籤機制對存量安裝戶形同虛設。
    # START 行在管理區塊「內」,★INVARIANT★ 只保護 sentinel 之外,刷新它不違約)。
    old_body = span.body
    new_body = body
    si = claude_text.find(_CLAUDE_START_PREFIX)
    sl_begin = claude_text.rfind("\n", 0, si) + 1
    sl_end = claude_text.find("\n", si)
    old_start_line = claude_text[sl_begin:sl_end] if sl_end != -1 else claude_text[sl_begin:]

    if old_body == new_body and old_start_line == start_line:
        return ReInjectResult("unchanged", None)

    # 有差 → 先換 body(高位移),再換 START 行(低位移,原始位移仍有效);兩 splice 之間
    # 的原始空白行區逐字保留。
    new_text = claude_text[:span.body_start] + new_body + claude_text[span.body_end:]
    if sl_end != -1 and old_start_line != start_line:
        new_text = new_text[:sl_begin] + start_line + new_text[sl_end:]
    _write_lf(cm, new_text)

    diff = "".join(difflib.unified_diff(
        (old_start_line + "\n" + old_body).splitlines(keepends=True),
        (start_line + "\n" + new_body).splitlines(keepends=True),
        fromfile="old block",
        tofile="new block",
    ))
    return ReInjectResult("updated", diff)


def _deinit_strip_claude(root: Path) -> bool:
    """剝 CLAUDE.md 與 Codex 指示檔(AGENTS.md / AGENTS.override.md)的 LUMOS:GRAPH-DISCIPLINE 區塊;
    其餘內容/整個檔都留。目標清單與注入端同一份(r1 整合 F1)。任一檔有剝到 → True;都無 → False。"""
    hit = False
    # ★掃三個候選檔,不只當前目標★:先注入 AGENTS.md、後來才加 override,目標會變,舊檔區塊要一起剝(r1 外家 #3)
    for t in ("CLAUDE.md", "AGENTS.md", "AGENTS.override.md"):
        cm = root / t
        if not cm.exists():
            continue
        text = cm.read_text(encoding="utf-8")
        start_marker = "<!-- LUMOS:GRAPH-DISCIPLINE:START"
        end_marker = "LUMOS:GRAPH-DISCIPLINE:END -->"
        si = text.find(start_marker)
        ei = text.find(end_marker)
        if si == -1 or ei == -1 or ei < si:
            continue
        ei += len(end_marker)
        new = (text[:si].rstrip() + "\n" + text[ei:].lstrip()).strip()
        _write_lf(cm, (new + "\n") if new else "")
        hit = True
    return hit


def _deinit_remove_vendored(root: Path, src=None) -> list:
    """白名單移除 vendored 工具組:① _VENDORED_TOOLKIT 固定 5 檔;
    ② scripts/hooks/、scripts/templates/ ★依 src 列舉逐檔刪★(對稱 _vendor_toolchain 的 rglob 安裝)。
    F9 修(2026-07-24,Issues/deinit整夾刪使用者檔):不再整夾 rmtree——只刪 src 有的 lumos 檔、
    保留使用者放這兩夾的自有檔,夾空了才移。fallback(a):src 缺(None 或來源夾不存在)→ 保守留夾
    +warn、不刪(never delete unknown)。scripts/ 底下使用者自有檔不碰;scripts/ 空了才 rmdir。
    回傳已移除相對路徑列表。"""
    removed = []
    for rel in _VENDORED_TOOLKIT:
        p = root / rel
        if p.exists():
            # ★刪不掉不該炸穿整個流程★(2026-08-01):這裡以前是裸 unlink()。
            # 走 teardown 時,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,
            claude_text = claude_text[3:]
        claude_text = claude_text.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
    except OSError:
        return None
    claude_ver = _parse_sentinel_version(claude_text)
    if claude_ver is None:
        return None

    # 2. 讀來源 clone 的 LUMOS_VERSION(文字 grep,不 import 避免副作用)
    src = _lumos_src()
    src_lumos = src / "scripts" / "lumos"
    if not src_lumos.exists():
        return None  # 來源不可達 → 靜默 skip
    try:
        _ver_pat = re.compile(r'^LUMOS_VERSION\s*=\s*"(v\d+\.\d+)"', re.MULTILINE)
        src_text = src_lumos.read_text(encoding="utf-8", errors="replace")
        m = _ver_pat.search(src_text)
        if not m:
            return None
        src_ver = m.group(1)
    except OSError:
        return None

    # 3. 比對:CLAUDE 版本 < 來源版本 → nudge(簡單字串不等判準;版本是 advisory)
    if claude_ver == src_ver:
        return None
    # 嘗試 tuple 比對(vMAJOR.MINOR → (MAJOR, MINOR));取不到就用字串不等
    def _ver_tuple(s):
        try:
            parts = s.lstrip("v").split(".")
            return tuple(int(x) for x in parts)
        except (ValueError, AttributeError):
            return None
    ct = _ver_tuple(claude_ver)
    st = _ver_tuple(src_ver)
    if ct is not None and st is not None and ct >= st:
        return None  # CLAUDE 版本 ≥ 來源,不 nudge
    # CLAUDE 落後(或無法比較)→ 提示
    return (
        f"本專案紀律區塊版本 {claude_ver} 落後來源 {src_ver},"
        f" 可跑 lumos update 刷新"
    )


# vendored 工具組白名單(固定 5 檔,scripts/ 前綴;hooks/templates 兩夾另走整夾刪)。
# _vendor_toolchain 安裝端與 cmd_deinit 移除端共用,避免漂移。
_VENDORED_TOOLKIT = ("scripts/lumos", "scripts/test_lumos.py",
                     "scripts/merge-claude-settings.py", "scripts/graph-rename.sh",
                     "scripts/fetch-notesmd.sh")
_VENDORED_TREE_DIRS = ("scripts/hooks", "scripts/templates")   # 安裝時整個目錄照來源複製過去的那兩個
# ★工具確實會安裝進消費專案的每一支檔(精確檔名)★——跳過判斷只認這張表,不認目錄前綴。
# 2026-09-10 代碼審 r1 四席獨立抓到:原本照目錄前綴跳過,消費專案自己放在 scripts/hooks、
# scripts/templates 的程式會被當成工具的檔,推送閘的風險分級被降、逃過代碼審。
# 表要跟工具鏈 repo 裡那兩個目錄底下受版控的檔一模一樣:有一支測試逐檔比對,少登記或多登記都會翻紅。
_VENDORED_TREE_FILES = (
    "scripts/hooks/claude/_hookevent.py",
    "scripts/hooks/claude/check-graph-sync.py",
    "scripts/hooks/claude/ci-status-hook.py",
    "scripts/hooks/claude/memory-sweep.py",
    "scripts/hooks/claude/dispatch-lens-hook.py",
    "scripts/hooks/claude/impact-hook.py",
    "scripts/hooks/claude/lumos-entry-hook.py",
    "scripts/hooks/post-commit",
    "scripts/hooks/pre-commit",
    "scripts/hooks/pre-push",
    "scripts/templates/graph-discipline.md",
    "scripts/templates/note-audit-judge.md",
)
_VENDORED_ALL = frozenset(_VENDORED_TOOLKIT + _VENDORED_TREE_FILES)


_VENDORED_MANIFEST = ".lumos/vendored.json"   # 安裝/更新時記下每支工具檔的內容指紋


def _vendored_digest(data):
    """工具檔的內容指紋:換行統一成 LF 再算 sha256(Windows 的換行轉換不該讓指紋對不上)。"""
    import hashlib
    return hashlib.sha256(bytes(data).replace(b"\r\n", b"\n")).hexdigest()


def _vendored_manifest_write(root):
    """把工作目錄裡「工具自裝檔」的內容指紋寫進 .lumos/vendored.json(安裝與更新時呼叫;回寫進去的 {路徑: 指紋})。"""
    files = {}
    for rel in sorted(_VENDORED_ALL):
        p = Path(root) / rel
        if p.is_file():
            files[rel] = _vendored_digest(p.read_bytes())
    mp = Path(root) / _VENDORED_MANIFEST
    mp.parent.mkdir(parents=True, exist_ok=True)
    # 格式跟錨點基準線同一種({"version": 1, <路徑: sha256>…};第四輪架構席)。不走錨點那種「人核可才改」的流程:
    # 這份是安裝時的事實紀錄,錯了的方向是「多掃」不是「少擋」。ensure_ascii:從某版本讀回來走的是文字模式的 git show
    _write_lf(mp, json.dumps({"version": 1,
                              "note": "lumos 安裝時記下的工具檔內容指紋;內容對得上的才不算專案自己的程式",
                              "files": files}, ensure_ascii=True, indent=1) + "\n")
    return files


def _vendored_state(root, ref=None):
    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。

    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
    present, data = set(), {}
    if ref is None:
        for p in sorted(_VENDORED_ALL):
            fp = Path(root) / p
            if fp.is_file():
                present.add(p)
                try:
                    data[p] = fp.read_bytes()
                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
                    data[p] = None
        try:
            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            man = None
    else:
        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
        for p in sorted(_VENDORED_ALL):
            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
                present.add(p)
                data[p] = None
            elif r.returncode == 0:
                present.add(p)
                data[p] = r.stdout
        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
    files = man.get("files") if isinstance(man, dict) else None
    if not isinstance(files, dict):
        return frozenset(), frozenset(present)
    return (frozenset(p for p in present if data.get(p) is not None and files.get(p) == _vendored_digest(data[p])),
            frozenset(present))


def _diff_range_ends(root, diff_range):
    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
    import subprocess
    r = str(diff_range).strip()
    if "..." in r:
        a, b = r.split("...", 1)
        a, b = a or "HEAD", b or "HEAD"
        try:
            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
                                cwd=str(root), timeout=_disp_git_timeout())
            return (mb.stdout.strip() or a), b
        except (OSError, subprocess.TimeoutExpired):
            return a, b
    if ".." in r:
        a, b = r.split("..", 1)
        return (a or "HEAD"), (b or "HEAD")
    return r, None


def _is_toolchain_repo(root):
    """這個 repo 是不是工具鏈本體(那裡 scripts/lumos 就是產品,不能當成外來的跳過)。

    ★判別鍵沿用既有慣例★(見 `_self_repo_origin`):skills/lumos-project-notes/SKILL.md
    是 user-scope skill 的唯一源,永遠不會被複製進消費專案。"""
    try:
        return (Path(root) / "skills" / "lumos-project-notes" / "SKILL.md").is_file()
    except Exception:
        return False


def _vendored_skip(root, diff_range):
    """消費專案裡這段範圍要跳過的工具檔(工具鏈本體回空集合)。推送前分級與代碼審角色鏡頭共用這一支,見 _vendored_state:
    終點上原封不動的工具檔;終點上已經刪掉、但起點時原封不動的(拆除工具鏈)也跳。"""
    if _is_toolchain_repo(root):
        return frozenset()
    _start, _end = _diff_range_ends(root, diff_range)
    _intact_end, _present_end = _vendored_state(root, _end)
    _intact_start = _vendored_state(root, _start)[0] if _start else frozenset()
    return _intact_end | (_intact_start - _present_end)


def _pull_source_or_abort(src, allow_stale=False):
    """更新來源 clone;拉不到就中止。回傳 0=可繼續、None=中止(呼叫端不得再寫任何檔)。

    ★為什麼 fail-closed★:原本 pull 失敗只印一行警告就繼續 vendor,來源落後或有本機
    分歧時會靜默拿舊版蓋掉專案裡較新的檔——消費端實戰咬過兩次,那行警告混在一堆輸出裡
    根本看不到。「拿不到最新」與「確定這是最新」是兩種狀態,不該用同一條路走完。

    ★但無 remote 不算失敗★:手動複製 / slim 安裝出來的來源本就沒有 remote,那是合法的
    離線情境,擋它等於把離線使用者鎖在門外。只有「有 remote 卻拉不到」才中止。
    _vendor_toolchain(專案層) 與 cmd_bootstrap(機器層) 共用本函式,避免兩處政策漂移。
    """
    import subprocess
    if not (src / ".git").is_dir():
        print("  (來源非 git repo,跳過 pull)")
        return 0
    has_remote = subprocess.run(["git", "-C", str(src), "remote"],
                                capture_output=True, text=True, errors="replace").stdout.strip()
    if not has_remote:
        print("  (來源無 remote:離線 clone,跳過 pull)")
        return 0
    print("  git pull 來源(取最新工具組)…")
    if subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode == 0:
        return 0
    # ★來源「只髒了工具自己寫的帳」不該擋人★(2026-09-06 全 repo 審視 #5)
    # 症狀:唯讀的 `lumos show`/`context` 就會 append docs/.usage-log.jsonl,而那本帳是版控的。
    # 只要有人在來源 clone 裡查過一次圖譜,之後這台機器所有專案的 update / bootstrap --pull
    # 全部被 fail-closed 擋住;逃生門寫在錯誤訊息最後一行,沒人會讀到那裡。
    #
    # ★做法是「聯集合併」,不是 stash/pop★:這幾本是 append-only 的 JSONL,兩邊各自加了行,
    # stash pop 會判成衝突並★在帳本裡留下衝突標記★——那比原本擋住更糟,帳本直接壞掉、
    # 之後每次讀都炸(第一版真的踩到,實測留下 <<<<<<< 標記)。正確解是把兩邊的行取聯集:
    # 先把本機那份讀進記憶體 → checkout 回 HEAD → pull → 把本機獨有的行補回去。
    # 非 JSONL 的簿記檔(anchor-baseline.json 是一份 JSON 物件)不能這樣併,照原路擋下。
    dirty = subprocess.run(["git", "-C", str(src), "status", "--porcelain=v1", "-z"],
                           capture_output=True, text=True, errors="replace").stdout
    # ★用 -z 逐筆解析,不要對人看的格式做字串切片★(2026-09-06 代碼審 r1 外家席):
    # porcelain 的 rename 是 `R  old\0new`、含特殊字元的路徑在非 -z 模式會被 C-style 跳脫並加引號,
    # 光 strip('"') 解不開。-z 模式路徑原樣不跳脫;rename/copy 會多吃一個 NUL 欄位,我們直接
    # ★保守拒絕★(狀態碼含 R/C 就不自動併),寧可照原路擋下也不要判錯。
    paths, bad_shape = [], False
    if dirty:
        parts = dirty.split("\0")
        i = 0
        while i < len(parts):
            ent = parts[i]
            if not ent:
                i += 1
                continue
            xy, path = ent[:2], ent[3:]
            if "R" in xy or "C" in xy:      # rename/copy:後面還跟一個來源路徑,保守不併
                bad_shape = True
                i += 2
                continue
            paths.append(path)
            i += 1
    mergeable = (not bad_shape) and paths and all(
        p in _BOOKKEEPING_FILES and p.endswith(".jsonl") for p in paths)
    if paths and not mergeable and all(p in _BOOKKEEPING_FILES for p in paths):
        print("  (來源只髒了簿記檔,但其中有不是 append-only JSONL 的、或有改名——不自動併,照原路擋下)",
              file=sys.stderr)
    if mergeable:
        print(f"  來源只髒了工具自己寫的帳({len(paths)} 本 append-only)——取聯集後續拉,不丟任何一行")
        # ★先把本機那份存到磁碟再動 git★(2026-09-06 代碼審 r1 外家席):原本只存在記憶體,
        # checkout 之後若被 SIGKILL / 斷電 / 寫回失敗,那些★從未進過 git 物件庫★的行就永久消失
        # ——而且第一版的錯誤訊息還叫人用 `git checkout HEAD@{1}` 救,那是假的。
        import tempfile as _tf, shutil as _sh
        bak = Path(_tf.mkdtemp(prefix="lumos-bookkeeping-backup-"))
        saved = {}
        try:
            for rel in paths:
                f = src / rel
                saved[rel] = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
                _sh.copy2(f, bak / rel.replace("/", "__")) if f.exists() else None
        except OSError as e:
            print(f"  ⚠ 備份簿記帳失敗,照原路擋下(沒有動任何檔):{e}", file=sys.stderr)
            saved = None
        if saved is not None:
            print(f"    (動手前已備份到 {bak};全部併回成功才會刪)")
            subprocess.run(["git", "-C", str(src), "checkout", "--"] + paths,
                           capture_output=True, text=True, errors="replace")
            # ★比較對象是「拉之前的已提交版」,不是拉下來的內容★(2026-09-06 代碼審 r1 折入後
            # 自己的測試抓到):checkout 完檔案就等於 base。要補回的是「本機在 base 之上加了什麼」
            # ——拿拉下來的內容比,會在遠端剛好也加了同一行時把本機那筆當成重複吃掉。
            base = {}
            for rel in paths:
                f = src / rel
                base[rel] = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
            rc2 = subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode
            all_ok = True
            for rel, old_lines in saved.items():
                f = src / rel
                try:
                    now = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
                    # ★用計數不用集合★(外家席):JSONL 是事件序列不是集合,同一行內容合法地出現
                    # 兩次是常態(同秒同節點的兩筆);set 判「有沒有」會把本機新增的那筆吃掉。
                    # 算的是「本機在 base 之上加了幾份」,加幾份就補幾份到拉下來的版本後面。
                    from collections import Counter as _C
                    need = _C(old_lines) - _C(base.get(rel, []))
                    extra = []
                    for l in old_lines:
                        if need[l] > 0:
                            extra.append(l)
                            need[l] -= 1
                    if extra:
                        raw = f.read_text(encoding="utf-8") if f.exists() else ""
                        sep = "" if (raw == "" or raw.endswith("\n")) else "\n"
                        with open(f, "a", encoding="utf-8") as fh:
                            fh.write(sep + "\n".join(extra) + "\n")
                        print(f"    {rel}:本機獨有的 {len(extra)} 行已補回")
                except OSError as e:
                    all_ok = False
                    print(f"  ⚠ {rel} 併回失敗——★那幾行還在備份裡★:{bak}/{rel.replace('/', '__')}\n"
                          f"    ({e})", file=sys.stderr)
            if all_ok:
                _sh.rmtree(bak, ignore_errors=True)
            if rc2 == 0:
                return 0
            print(f"  (pull 仍失敗;本機的帳已經併回,備份留在 {bak})", file=sys.stderr)
    if allow_stale:
        print("  ⚠ --allow-stale:pull 失敗,明示沿用現有來源繼續", file=sys.stderr)
        return 0
    print(f"擋下:工具鏈來源拉不到最新版(可能是網路不通、有本地改動擋住、或歷史分岔),先停。\n"
          f"  不會拿可能過期的來源蓋掉你的專案——默默裝到舊版這個坑踩過兩次。\n"
          f"  先去來源那邊處理:\n    cd {src} && git status && git pull --ff-only\n"
          f"  確定就要用現在這份來源:重跑並加 --allow-stale", file=sys.stderr)
    return None


_PY314_UPGRADE_NOTICE = (
    "\n升級注意:從這一版起 lumos 需要 Python 3.14(系統內建的 3.9 碰到深層巢狀的程式會整個崩潰)。\n"
    "  · 沒有 3.14 的機器,提交與推送前的檢查會擋下並說明怎麼裝(brew install python@3.14 / uv python install 3.14 /\n"
    "    winget install Python.Python.3.14)。\n"
    "  · 專案 CI 要用 3.14:actions/setup-python 的 python-version 設 \"3.14\",不然 lumos 在 CI 會回 2。\n"
    "  · 3.14 裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。\n"
    "  · 裝好之後跑一次 lumos install,讓 Claude/Codex 掛鉤也改用 3.14;Codex 的掛鉤命令列因此改變,\n"
    "    要再開一次互動 codex 審過(Hooks need review 畫面或 /hooks),不然 Codex 掛鉤不會跑、也不報錯。\n")

def _py314_upgrade_pending(root):
    """消費專案還沒升級到最低 Python 3.14 的版本(舊的 pre-commit 還沒用 python-path)→ True;複製完要印一次升級注意
    (Projects/最低Python版本改3.14_計劃 做法第 8 點;判斷不必另存狀態)。只有新版程式執行 update 時走得到這裡。"""
    old_pc = Path(root) / "scripts" / "hooks" / "pre-commit"
    try:
        return old_pc.is_file() and "python-path" not in old_pc.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def _vendor_toolchain(src, root, slug, no_pull=False, allow_stale=False):
    """從 Lumos 來源 src vendor 工具組到專案 root(python 單一源 scaffold + hooks + 結尾自癒)。
    回傳 0;來源無效回傳 None。圖譜資料受 _scaffold_project 的 skip 保護不被動。
    cmd_update / cmd_init(--with-hooks) 共用。"""
    import subprocess, shutil, filecmp
    installer = src / "scripts" / "install-graph-toolchain.sh"  # 仍作來源有效性探針(薄殼亦在)
    if not installer.exists():
        print(f"擋下:找不到 Lumos 工具鏈的來源({src} 底下沒有安裝腳本)。\n"
              f"  三種解法擇一:--source <路徑> 指定、設環境變數 $LUMOS_HOME、或 clone 到 ~/harness/lumos-toolchain",
              file=sys.stderr)
        return None
    if not no_pull:
        rc_p = _pull_source_or_abort(src, allow_stale)
        if rc_p is None:
            return None                      # fail-closed:一個檔都還沒動就退場
    # 安裝邏輯收進 python 單一源(scaffold + hooks);bash 安裝器僅留薄殼。
    _scaffold_project(root, slug)
    _init_additive_setup(root)     # 只加不覆寫;掛在這裡讓 `lumos update` 也能把設定骨架補給既有專案
    _set_hooks_path(root)          # 全域同步★不在這裡★——要等下面的 copy2 自癒把 vendored 檔換新
    rc = 0
    _py314_upgrade = _py314_upgrade_pending(root)
    # 結尾 diff 自癒:python 端逐檔比對 src↔target,差異即補(可安全覆寫)。
    # ★只複製精確清單上的檔★(第三輪外家否決席:原本整個目錄照來源 rglob,來源裡沒進版控的檔也被裝進去,
    # 可是跳過清單只列受版控的檔——裝進去的檔不在清單上,消費專案又把它當成自己的程式掃)。清單跟來源受版控的檔
    # 是否一致,由 t_vendored_file_list_matches_what_install_ships 守
    toolkit = list(_VENDORED_TOOLKIT) + list(_VENDORED_TREE_FILES)
    healed = []
    for rel in toolkit:
        s, t = src / rel, root / rel
        if not s.exists():
            continue
        if (not t.exists()) or not filecmp.cmp(s, t, shallow=False):
            t.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(s, t)
            if s.stat().st_mode & 0o111:
                t.chmod(t.stat().st_mode | 0o111)
            healed.append(rel)
    if healed:
        print(f"  結尾自癒:補齊 installer 漏的 {len(healed)} 檔 → {', '.join(healed)}")
    else:
        print("  ✓ 結尾自癒檢查:工具組完全對齊(無漏)")
    if _py314_upgrade and "scripts/hooks/pre-commit" in healed:
        print(_PY314_UPGRADE_NOTICE)
    # 記下工具檔的內容指紋:風險掃描與健檢只跳過「內容跟這裡一模一樣」的工具檔(r3 併發資源席)
    _vendored_manifest_write(root)
    # 範本已是最新(copy2 迴圈完成) → reinject 紀律區塊(CLAUDE.md + Codex 指示檔,d1)
    _reinject_all(root, slug)
    # ★全域同步放在這裡★(2026-09-06 全 repo 審視 #5):要等上面的 copy2 自癒把 vendored hook
    # 換成來源的新版之後才同步出去,否則 `lumos update` 會拿更新前的舊副本覆蓋全域 hooks。
    _sync_global_from_project(root)
    return rc


def cmd_update(source=None, no_pull=False, allow_stale=False):
    """從 Lumos 唯一源 repo 更新「本專案」vendored 的工具組。
    = (git pull Lumos) + install-graph-toolchain --target <本專案> --slug <自動偵測>。
    圖譜資料受 install-graph-toolchain 的 scaffold-skip 保護,不會被動。"""
    if _refuse_if_probe("update"):
        return 2
    src = _lumos_src(source)
    vault = find_vault(Path.cwd())
    if vault is None:
        # ★三條路同一套說法、同一個退出碼★(2026-09-07 全 repo 審視 #9)
        return _no_vault_msg()
    root = vault.parent.parent  # docs/<slug>-knowledge → docs → 專案 root
    slug = vault.name[:-len("-knowledge")] if vault.name.endswith("-knowledge") else vault.name
    if root.resolve() == src.resolve():
        # 來源 repo 自身:範本本地即最新,無 pull/vendor 之需——reinject-only
        # (2026-08-05 實戰缺口修:改完範本後來源 repo 自己的 CLAUDE.md 原本無路可刷)
        res = _reinject_all(root, slug, quiet=True)
        ri = res["CLAUDE.md"]
        print(f"lumos update — 來源 repo 自身:只刷新紀律區塊({', '.join(f'{k}:{v.status}' for k, v in res.items())})")
        return 0 if all(v.status in ("updated", "unchanged", "created", "appended") for v in res.values()) else 2
    print(f"lumos update — 來源 {src} → 本專案 {root}（slug={slug}）")
    rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
    return 2 if rc is None else rc


def _skills_list():
    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
    repo = Path(__file__).resolve().parent.parent
    d = repo / "skills"
    if not d.is_dir():
        return ()
    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))


_SKILLS = _skills_list()


