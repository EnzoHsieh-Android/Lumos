+def _lcp_pass(root, *args, sub="pass"):
+    import subprocess as _sp
+    return _sp.run([sys.executable, GRAPHCTL, "code-loop", sub, "--note", "n", "--repo", str(root), *args],
+                   capture_output=True, text=True, timeout=300)
