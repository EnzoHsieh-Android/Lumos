++def _api_shapes(name, vis, reverse=False):
++    """名稱的比對形狀:正向與停用字比簡名、可見寫法、簡名(;反向只比簡名與簡名((不然 object 名當觸發字會逼每個成員歸屬)。"""
++    return {name, name + "("} | (set() if reverse else set(vis))
