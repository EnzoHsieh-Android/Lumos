++        return [] if any(p.search(s) for p in ctx.rx[d] for s in shapes) else [f"{'撞名 ' if crash else ''}{d} 的觸發字搜不到這個名稱"]
++    if not ask:
++        return []
++    hit = ctx.mentioned_by(shapes)
++    if ask == "代碼審":
