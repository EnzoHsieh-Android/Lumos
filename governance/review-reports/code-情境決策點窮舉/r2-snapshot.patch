++def _snippets(cell):
++    """主表壞寫法欄 → 反引號片段清單(表格跳脫的 \\| 還原成 |;不做長度或字元過濾)。"""
++    return [s.replace("\\|", "|") for s in re.findall(r"`([^`]+)`", cell)]
