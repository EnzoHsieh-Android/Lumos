++_API_SKIP_NAMES = frozenset(("equals", "hashCode", "toString", "copy", "values", "valueOf", "entries"))
++_API_SIG_RE = re.compile(r"^([\w.]+)/([^|]+)\|(.*)$")
++_API_ITEM_RE = re.compile(r"^(?:(D-[1-9]\d*)|撞名 (D-[1-9]\d*)|決策不問 ((?:[A-Z]+-[1-9]\d*)|代碼審)|(無決策))$")
