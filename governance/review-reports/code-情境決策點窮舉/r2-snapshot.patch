++def _api_item_kind(x):
++    """歸屬項 → 統計用的種類:D-n、撞名、決策不問主表列、決策不問代碼審、無決策;認不得回空字串。"""
++    m = _API_ITEM_RE.match(x)
++    if not m:
++        return ""
++    if m.group(1):
++        return "D-n"
++    if m.group(2):
++        return "撞名"
++    if m.group(3):
++        return "決策不問代碼審" if m.group(3) == "代碼審" else "決策不問主表列"
++    return "無決策"
