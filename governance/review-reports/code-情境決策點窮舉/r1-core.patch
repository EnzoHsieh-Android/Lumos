+def _parts_in_order(lumos, snip, hay):
+    """片段以 … 或 ... 切段後,各段依序以整字出現在 hay 裡。"""
+    pos = 0
+    for part in [p.strip() for p in re.split(r"…|\.\.\.", _norm_code(snip)) if p.strip()]:
