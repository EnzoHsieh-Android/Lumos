+def _fence_body(templates_text, group, cid):
+    """範本檔某一組裡標題是「### 壞寫法:<cid>」的每個小節的圍欄內文(同編號多節取聯集),併成一份字串。
+    找組走 template_sections;圍欄判定走 _fence_regions,沒關時的寬嚴退讓照 _visible_lines 的同一套。"""
+    lines = templates_text.splitlines()
+    secs = template_sections(templates_text)
+    starts = [i for g, i in secs if g == group]
+    if not starts:
+        return ""
+    a = starts[0]
+    b = min([i for _g, i in secs if i > a] or [len(lines)])
+    regions, unterminated = _fence_regions(lines, True)
+    if unterminated:
+        regions, _ = _fence_regions(lines, False)
+    fenced = set()
+    for x, y in regions:
+        fenced.update(range(x + 1, (y if y is not None else len(lines))))
+    out, inside = [], False
+    for i in range(a, b):
+        ln = lines[i]
+        if i not in fenced and ln.startswith("#"):
+            m = BAD_HEADING_RE.match(_norm_colon(ln))
+            inside = bool(m and m.group(1) == cid)
+            continue
+        if inside and i in fenced:
+            out.append(ln)
+    return "\n".join(out)
