+    for i, ln in enumerate(lines):
+        if _re.match(r"^\|\s*" + _re.escape(did) + r"\s*\|", ln):
+            lines[i] = ln.replace("、" + old, "、" + new if new else "", 1) if ("、" + old) in ln else ln.replace(old, new, 1)
+    return "\n".join(lines)
