+def _bad_lines(samples_dir, rule_id):
+    """samples/bad/<id>/ 底下標了 // BAD 的行 → [(檔的絕對路徑, 行號, 比對用的那一行(去掉 // BAD 之後的註解))]。"""
+    out = []
+    for f in sorted((samples_dir / "bad" / rule_id).rglob("*.kt*")):
+        lines = f.read_text(encoding="utf-8").splitlines()
+        for no, ln in enumerate(lines, 1):
+            i = ln.find("// BAD")
+            if i < 0:
+                continue
+            code = _norm_code(ln[:i])
+            if code:
+                out.append((str(f.resolve()), no, code))
+                continue
+            # 只有註解的「// BAD:說明」行標的是下一個有程式的行(壞例樣本兩種標法都有)
+            nxt = next((k for k in range(no, len(lines)) if lines[k].strip() and not lines[k].lstrip().startswith("//")), None)
+            if nxt is not None:
+                out.append((str(f.resolve()), nxt + 1, _norm_code(lines[nxt].split("//")[0])))
+    return out
