+                snip_sub = "\0never"   # 只拿掉第一列
+                continue
+            out.append(ln)
+        return "\n".join(out)
+
+    def set_route(t, rid, cid, snip_sub, route, why="測試"):
+        out = []
+        for ln in t.split("\n"):
+            cells = ln.split("|")
+            if len(cells) > 6 and cells[1].strip() == rid and cells[2].strip() == cid and snip_sub in ln and "\0" not in snip_sub:
+                cells[4], cells[5] = f" {route} ", f" {why} "
+                ln = "|".join(cells)
+                snip_sub = "\0never"
+            out.append(ln)
+        return "\n".join(out)
