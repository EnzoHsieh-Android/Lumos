+def _py314_old_python():
+    """回一支版本低於 3.14 的 python 絕對路徑,找不到回 None:系統位置、GitHub 執行機預裝的舊版、macOS 的框架安裝,逐一問版本。"""
+    import glob as _gl, subprocess as _sp, os as _os
+    cands = ["/usr/bin/python3", "/bin/python3", "/usr/local/bin/python3"]
+    for pat in ("/opt/hostedtoolcache/Python/3.1[0-3].*/x64/bin/python3", "/usr/bin/python3.1[0-3]",
+                "/Library/Frameworks/Python.framework/Versions/3.1[0-3]/bin/python3"):
+        cands += sorted(_gl.glob(pat))
+    for c in cands:
+        if not (_os.path.isfile(c) and _os.access(c, _os.X_OK)):
+            continue
+        try:
+            r = _sp.run([c, "-c", "import sys; print(sys.version_info < (3, 14))"], capture_output=True, text=True, timeout=20)
+        except (OSError, _sp.TimeoutExpired):
+            continue
+        if r.returncode == 0 and r.stdout.strip().splitlines()[-1:] == ["True"]:
+            return c
+    return None
+
