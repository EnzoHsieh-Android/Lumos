+def _sort_pins(pins, home_on):
+    """固定席排序的★唯一實作★:事故最前 → 家 → 其餘;★同鍵一律以節點名斷開★。
+
+    為什麼末項一定要有節點名(2026-09-15 實測根因):原本寫成
+    `r["node"] if r.get("home") else ""`——只有「家」那一類才拿節點名斷同分,
+    ★不是家的全部拿到空字串、完全同鍵★,順序就整個交給上游。而上游那個順序
+    ★本身不穩定★:同一份語料連跑三次,同分的 7 筆跑出三種排法。
+    stable sort 只保證同鍵者維持輸入序,輸入序會變就等於沒保證。
+
+    往下游的殺傷力:名次會抖 → 截前 k 的視窗邊緣換人 → 「這題有沒有未標」跟著變,
+    而那餵的是★不可逆★的尺切換判定(見 [[Issues/未標候選順序每次跑都不一樣]])。
+
+    ★改這裡就是改所有固定席的呈現順序★,不要在別處再寫一份。
+    """
+    out = list(pins)
+    if home_on:
+        out.sort(key=lambda r: (r["kind"] != "incident", not r.get("home", False),
+                                -r["score"] if r.get("home") else 0.0, r["node"]))
+    else:
+        out.sort(key=lambda r: (r["kind"] != "incident", not r.get("about_hit", False), r["node"]))
+    return out
+
