+def _numstat_new_path(p):
+    """git diff --numstat 對改名印 `dir/{old => new}/f` 或 `old => new`;回改名後的路徑,沒改名原樣回。"""
+    m = re.match(r"^(.*)\{(.*) => (.*)\}(.*)$", p)
+    if m:
+        return m.group(1) + m.group(3) + m.group(4)
+    if " => " in p:
+        return p.split(" => ", 1)[1]
+    return p
