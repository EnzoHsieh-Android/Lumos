 def _package_json_candidates(file_rel):
     """從檔案所在目錄往上到 repo 根,每一層的 package.json 相對路徑(近的在前)。"""
     from pathlib import PurePosixPath
     parts = PurePosixPath(file_rel).parts[:-1]
     return ["/".join((*parts[:i], "package.json")) for i in range(len(parts), -1, -1)]
 
 
