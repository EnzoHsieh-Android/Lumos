+def _home_impact(root, rel, env_extra=None, ranked=True):
+    import json as _j, subprocess as _sp, os as _os
+    e = dict(_os.environ); e.update(env_extra or {})
+    args = [sys.executable, GRAPHCTL, "impact", "--file", rel, "--repo", str(root), "--json"]
+    if ranked:
+        args.append("--ranked")
+    r = _sp.run(args, capture_output=True, text=True, env=e)
+    out = r.stdout.strip().splitlines()
+    if not out:
+        raise AssertionError(f"impact 沒有輸出(rc={r.returncode}):{r.stderr[-400:]}")
+    return _j.loads(out[-1])
+
