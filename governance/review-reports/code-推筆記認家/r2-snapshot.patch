++      "head": "import SwiftUI\n\n/// 套餐選配單（借 mOrangePos 的兩層結構；沒有拷貝任何檔案）。\n///\n/// ★兩層★：外層選「這一份包含哪幾道菜」，選中的那道菜如果自己要調味\n/// （飲料的甜度冰塊），就在它底下展開。展開是刻意的——收在另一個畫面裡的話，\n/// 店員會漏掉甜度，而那杯飲料廚房就做不出來。\nstruct ComboSheet: View {\n    let item: MenuItem\n    /// 查子品項用（選配只給 itemId，名稱與加料組要去菜單查）。\n    let menu: [MenuItem]\n    let onConfirm: ([[String: Any]]) -> Void\n    let onClose: () -> Void\n\n    /// 每一組選了哪個品項\n    @State private var picked: [String: String] = [:]\n    /// 每一組選中那道菜的加料（組 → 選項代號）\n    @State private var subOptions: [String: Set<String>] = [:]\n\n    private func sub(_ itemId: String) -> MenuItem? { menu.first { $0.id == itemId } }\n\n    /// 全部選齊、而且每個子品項的必選加料也選齊，才算完成。\n    private var complete: Bool {\n        for g in item.comboGroups {\n            guard let chosen = picked[g.id], let s = sub(chosen) else { return false }\n            if s.soldOut { return false }\n            if !PosScreenState.optionsAreComplete(s, subOptions[g.id] ?? []) { return false }\n        }\n        return true\n    }\n\n    /// 預覽單價 = 底價 + 選配加價 + 子品項加料價差。★子品項原價不參與★。\n    private var unitPrice: Int {\n        var total = item.price\n        for g in item.comboGroups {\n            guard let chosen = picked[g.id] else { continue }\n            total += g.choices.first { $0.itemId == chosen }?.extra ?? 0\n            if let s = sub(chosen) {\n                let picks = subOptions[g.id] ?? []\n                total += s.optionGroups.flatMap(\\.options)\n",
