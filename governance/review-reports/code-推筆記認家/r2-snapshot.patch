++      "head": "import Foundation\n\n/// 一個可選的加料／調味。`price` 是**價差**（可以是 0）。\nstruct MenuOption: Codable, Identifiable, Equatable {\n    let id: String\n    let name: String\n    let price: Int\n}\n\n/// 選項組。`min`／`max` 是「最少選幾個／最多選幾個」。\n///\n/// ★不用「必選」「可複選」兩個布林★（照後端合約）：一組數字就表達得完，\n/// 兩個布林反而生得出「必選但不可選」這種矛盾組合。\nstruct OptionGroup: Codable, Identifiable, Equatable {\n    let id: String\n    let name: String\n    let min: Int\n    let max: Int\n    let options: [MenuOption]\n\n    /// 剛好要選一個（甜度、冰塊那種）。\n    var isSingleRequired: Bool { min == 1 && max == 1 }\n    /// 這一組非選不可。\n    var isRequired: Bool { min > 0 }\n}\n\n/// 套餐的一個選配。`itemId` 指向菜單上真的存在的品項；`extra` 是加價（可以是 0）。\nstruct ComboChoice: Codable, Identifiable, Equatable {\n    let itemId: String\n    let extra: Int\n    var id: String { itemId }\n}\n\n/// 套餐選配組。★剛好選一個★——跟加料組的「最少／最多」是不同的東西。\nstruct ComboGroup: Codable, Identifiable, Equatable {\n    let id: String\n    let name: String\n    let choices: [ComboChoice]\n}\n\n",
