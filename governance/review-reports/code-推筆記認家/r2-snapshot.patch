++      "head": "/**\n * 桌位（折扣與換桌計劃 [S7]）。\n *\n * ★固定清單，不能動態新增★：Demo 用固定編制，換一家店就要改這個檔。\n * 真的要上線得搬到設定檔——寫在計劃節點的「實務隱患」裡。\n */\n\nexport interface TableDef {\n  id: string;\n  /** 給前端分區顯示用；不影響任何規則。 */\n  zone: string;\n  /** 座位數。★不參與任何檢查★——不做「人數超過座位就擋」，那是店規不是系統規則。 */\n  seats: number;\n}\n\nexport const TABLES: readonly TableDef[] = Object.freeze([\n  { id: \"A1\", zone: \"A 區\", seats: 2 },\n  { id: \"A2\", zone: \"A 區\", seats: 2 },\n  { id: \"A3\", zone: \"A 區\", seats: 4 },\n  { id: \"A4\", zone: \"A 區\", seats: 4 },\n  { id: \"A5\", zone: \"A 區\", seats: 6 },\n  { id: \"A6\", zone: \"A 區\", seats: 6 },\n  { id: \"B1\", zone: \"B 區\", seats: 4 },\n  { id: \"B2\", zone: \"B 區\", seats: 4 },\n  { id: \"B3\", zone: \"B 區\", seats: 8 },\n  { id: \"B4\", zone: \"B 區\", seats: 8 },\n  { id: \"C1\", zone: \"吧台\", seats: 1 },\n  { id: \"C2\", zone: \"吧台\", seats: 1 },\n  { id: \"C3\", zone: \"吧台\", seats: 1 },\n]);\n\nexport function findTable(id: unknown): TableDef | undefined {\n  if (typeof id !== \"string\") return undefined;\n  return TABLES.find((t) => t.id === id);\n}\n",
