++      "head": "import SwiftUI\n\n/// 折扣選單。★常用的做成一按就好，少見的才要自己打數字★——\n/// 店裡最常用的是「九折」「八折」「折 50」這幾種，每次都要打字會拖慢結帳。\nstruct DiscountSheet: View {\n    let current: Discount?\n    let onPick: (String, Int) -> Void\n    let onClose: () -> Void\n\n    /// 常用折扣。★這裡是選項清單，不是計算★——折多少錢一律由後端算。\n    private static let percents = [5, 10, 15, 20]\n    private static let amounts = [20, 50, 100]\n\n    var body: some View {\n        VStack(alignment: .leading, spacing: 18) {\n            HStack {\n                Text(\"折扣\").font(.system(size: PosTheme.Size.paneTitle, weight: .bold))\n                    .foregroundStyle(PosTheme.deep)\n                Spacer()\n                Button(\"關閉\", action: onClose).font(.system(size: PosTheme.Size.button))\n            }\n\n            group(\"按百分比\") {\n                ForEach(Self.percents, id: \\.self) { p in\n                    chip(\"\\(p)%\", on: current?.kind == \"percent\" && current?.value == p) {\n                        onPick(\"percent\", p)\n                    }\n                }\n            }\n            group(\"按金額\") {\n                ForEach(Self.amounts, id: \\.self) { a in\n                    chip(\"$\\(a)\", on: current?.kind == \"amount\" && current?.value == a) {\n                        onPick(\"amount\", a)\n                    }\n                }\n            }\n\n            Button { onPick(\"none\", 0) } label: {\n                Text(\"清除折扣\")\n                    .font(.system(size: PosTheme.Size.button, weight: .semibold))\n",
