++      "head": "import Foundation\n\n/// 後端錯誤回應：`{\"error\":{\"code\":..,\"message\":..}}`\nstruct ApiErrorEnvelope: Decodable {\n    struct Payload: Decodable {\n        let code: String\n        let message: String\n    }\n    let error: Payload\n}\n\n/// 這台機器認得的失敗。\nenum PosError: Error, Equatable {\n    /// 後端回的業務錯誤（帶原因碼）\n    case api(code: String)\n    /// 網路層自己失敗：連不上、逾時、回的東西解不出來（★沒有原因碼★，計劃 [S9]）\n    case transport(String)\n}\n\nenum PosMessages {\n    /// 原因碼 → 一句人話。★一碼一句，不共用★（計劃 [S3]）。\n    ///\n    /// 這張表刻意不窮舉後端所有可能的碼：後端還會回 `NOT_FOUND`（路徑不存在）與\n    /// `INTERNAL`（未捕捉例外），那兩個走兜底。**兜底是必經路徑，不是裝飾**。\n    private static let table: [String: String] = [\n        // ★這個碼有兩個來源★:單號不存在、或那張單已經被淘汰(後端只留最近 50 張已結帳的)。\n        // 改這句話之前要知道這件事——它必須同時涵蓋兩者。\n        \"ORDER_NOT_FOUND\": \"找不到這張單，可能已經被清掉了。開一張新的吧。\",\n        \"MENU_ITEM_NOT_FOUND\": \"菜單上沒有這道菜，請重新整理菜單。\",\n        \"INVALID_QUANTITY\": \"數量要在 1 到 99 之間。\",\n        \"BAD_REQUEST\": \"這筆請求後端看不懂，請重試一次。\",\n        \"ORDER_NOT_OPEN\": \"這張單已經送出，不能再改了。\",\n        \"ORDER_EMPTY\": \"單子是空的，先點些東西再送出。\",\n        \"ORDER_ALREADY_PAID\": \"這張單已經結過帳了。\",\n        // ── 後端 2026-09-10 新增三個。★跨 repo 合約漂過三次,新增碼是最容易漏的一種★\n        \"ITEM_SOLD_OUT\": \"這道菜已經售完了。\",\n        \"ITEM_NOT_IN_ORDER\": \"這道菜不在單上，減不了。\",\n        \"TOO_MANY_OPEN_ORDERS\": \"同時開著的單太多了，先結掉幾張再開新的。\",\n        // ── 後端 2026-09-10 再新增四個（折扣與換桌）。★漏抄不會有任何東西翻紅★，\n        // 所以前端有一支測試專門盯這張表跟後端的碼有沒有對齊。\n",
