++      "head": "import Foundation\n\n/// 可注入的傳輸層。★測試靠它驗「組出來的請求對不對」★（計劃 [S6]／[S14]）——\n/// 直接用 `URLSession.shared` 的話那條條款就永遠驗不到。\nprotocol PosTransport {\n    func send(_ request: URLRequest) async throws -> (Data, HTTPURLResponse)\n}\n\nstruct UrlSessionTransport: PosTransport {\n    func send(_ request: URLRequest) async throws -> (Data, HTTPURLResponse) {\n        let (data, response) = try await URLSession.shared.data(for: request)\n        guard let http = response as? HTTPURLResponse else {\n            throw PosError.transport(\"回應不是 HTTP\")\n        }\n        return (data, http)\n    }\n}\n\n/// 打後端的九條路徑。★這個檔不做任何金額運算★（計劃 [S13]）。\nstruct PosApiClient {\n    let baseURL: URL\n    let transport: PosTransport\n\n    init(baseURL: URL, transport: PosTransport = UrlSessionTransport()) {\n        self.baseURL = baseURL\n        self.transport = transport\n    }\n\n    func menu() async throws -> [MenuItem] {\n        try await call(\"GET\", \"/menu\", body: nil, as: MenuResponse.self).items\n    }\n\n    func createOrder(serviceType: ServiceType = .dineIn, people: Int = 1,\n                     table: String? = nil) async throws -> Order {\n        // ★沒有桌號時不要送 table 欄位★：送 null 跟不送在後端是同一條路，\n        // 但少送一個欄位可以讓「外帶單誤帶桌號」這種錯在前端就不會發生。\n        var payload: [String: Any] = [\"serviceType\": serviceType.rawValue, \"people\": people]\n        if let table { payload[\"table\"] = table }\n        let body = try JSONSerialization.data(withJSONObject: payload)\n        return try await call(\"POST\", \"/orders\", body: body, as: Order.self)\n",
