++      "head": "/**\n * 手機上的購物車（桌邊送單前端計劃 [S9]）。\n *\n * ★純資料操作：沒有 Vue、沒有網路、沒有金額★——金額一律問後端（報價），\n * 這裡只管「放了什麼、各幾份」。每個操作都回一個新陣列，不改到原本那個：\n * 畫面靠「換了一個新陣列」才知道要重畫。\n */\n\n/** 每列上限。★跟後端同品項上限一致★，不然會做出「加得上去、結帳才被退」的購物車。 */\nexport const MAX_QTY = 99\n\nconst sorted = (ids) => [...(ids || [])].sort()\n\n/**\n * 兩列算不算同一列：同品項、同加料、同套餐選配——★順序不計★。\n * 跟後端的併列規則同一個意思，送過去之後才會一列對一列。\n */\nexport function lineKey(itemId, options, combo) {\n  const opt = sorted(options).join(',')\n  const picks = (combo || [])\n    .map((p) => `${p.groupId}:${p.itemId}(${sorted(p.options).join(',')})`)\n    .sort()\n    .join('|')\n  return `${itemId}#${opt}#${picks}`\n}\n\n/** 放一份進購物車；同一列就加一，不同就新開一列。 */\nexport function addToCart(cart, entry) {\n  const key = lineKey(entry.itemId, entry.options, entry.combo)\n  if (cart.some((l) => l.key === key)) {\n    return cart.map((l) => (l.key === key ? { ...l, quantity: Math.min(MAX_QTY, l.quantity + 1) } : l))\n  }\n  return [...cart, {\n    key,\n    itemId: entry.itemId,\n    name: entry.name,\n    detail: entry.detail || '',\n    options: [...(entry.options || [])],\n    combo: entry.combo ? entry.combo.map((p) => ({ ...p, options: [...(p.options || [])] })) : undefined,\n    quantity: 1,\n",
