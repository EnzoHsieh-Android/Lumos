++      "head": "import SwiftUI\n\n/// 桌位圖（借 mOrangePos 桌位頁的「一桌一張卡、有人的變色」編排；沒有拷貝任何檔案）。\n///\n/// ★點空桌 = 在那桌開一張新單；點有人的桌 = 切到那張單★。\n/// 這是店員最常看的一頁，所以資訊只放三樣：桌號、幾個人、目前多少錢。\nstruct TablePane: View {\n    let tables: [TableSlot]\n    /// 這一桌的單是不是客人自己在手機上點的（桌邊送單收單 [S6]）。吃完再結之後客人的單會佔著桌。\n    let isGuestOpened: (String) -> Bool\n    let currentTable: String?\n    let message: String?\n    let messageIsError: Bool\n    let onOpen: (String) -> Void\n    let onSelect: (String) -> Void\n\n    private let columns = [GridItem(.adaptive(minimum: 168), spacing: PosTheme.gap)]\n\n    /// 照後端給的順序分區，不重排——重排會讓桌號跟店裡的實際位置對不起來。\n    private var zones: [String] {\n        var seen: [String] = []\n        for t in tables where !seen.contains(t.zone) { seen.append(t.zone) }\n        return seen\n    }\n\n    var body: some View {\n        VStack(spacing: 0) {\n            HStack {\n                Text(\"桌位\").font(.system(size: PosTheme.Size.paneTitle, weight: .bold))\n                    .foregroundStyle(PosTheme.deep)\n                Spacer()\n                legend\n            }\n            .padding(.horizontal, 16).padding(.vertical, 12)\n            if let message {\n                Text(message).font(.system(size: PosTheme.Size.message))\n                    .foregroundStyle(messageIsError ? .red : PosTheme.accent)\n                    .frame(maxWidth: .infinity, alignment: .leading)\n                    .padding(.horizontal, 16).padding(.bottom, 8)\n                    .transition(.move(edge: .top).combined(with: .opacity))\n",
