++      "node": "Systems/訂單事件通道.md",
++      "key": "KEY:★INVARIANT★ 事件★只帶「哪張單、哪一桌、什麼變了」,不帶整張單的內容★:推的當下那張單可能又被改了,收到的人拿到過期快照卻以為是最新的。★事件是「去重讀」的信號,不是資料來源★ [test:sseEventCarriesRefNotPayload] [audit:opus/2026-09-10]",
++      "head": "/**\n * 訂單變動的事件通道（桌邊點單計劃 [S11]〜[S16]）。\n *\n * 用 SSE（伺服器送事件）：單向、`node:http` 原生就能寫、斷線客戶端自己重連。\n * ★不用 WebSocket★——POS 不需要往回推東西，而 Node 原生沒有 WebSocket 伺服器，\n * 要拉套件，跟這個專案的零依賴家規衝突。\n * ★不用 SignalR★——那是 .NET 生態的，接它得另起一個服務當中繼。\n */\n\nimport type { ServerResponse } from \"node:http\";\n\n/**\n * 一則事件。★只帶「哪張單、哪一桌、什麼變了」，不帶整張單的內容★（計劃 [S12]）。\n *\n * 為什麼不塞整張單：推的當下那張單可能又被改了，收到的人拿到的是過期快照\n * 卻以為是最新的。**事件是「去重讀」的信號，不是資料來源。**\n */\nexport interface OrderEvent {\n  /** 什麼變了：客人在手機上送了一輪單／店員動了什麼／單子沒了 */\n  kind: \"guest-sent\" | \"order-changed\" | \"order-gone\";\n  orderId: string;\n  table: string | null;\n  at: string;\n}\n\n/** 心跳間隔。中間的代理常在 30〜60 秒沒資料就切線,15 秒有餘裕。 */\nexport const HEARTBEAT_MS = 15_000;\n\nconst clients = new Set<ServerResponse>();\nlet heartbeat: NodeJS.Timeout | null = null;\n\n/** 目前有幾個連線（測試與健檢用）。 */\nexport function clientCount(): number {\n  return clients.size;\n}\n\nfunction startHeartbeat(): void {\n  if (heartbeat) return;\n  // ★心跳讓中間的代理不會把閒置連線切掉★（計劃 [S14]）。\n  // SSE 的註解行（冒號開頭）不會被當成事件,客戶端會忽略。\n",
