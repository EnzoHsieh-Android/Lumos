++      "head": "/**\n * 客人端的純決策層。★沒有 Vue、沒有 DOM★——判斷邏輯住在畫面裡的話只能靠慢又脆的\n * UI 測試去驗;獨立出來就能用一般單元測試把每一種狀態釘死。跟 POS 那邊同一個做法。\n */\n\n/** 桌號只從網址來（計劃 [S1]）。★不猜、不預設★——預設成 A1 的話，任何人打開首頁就在 A1 點菜。 */\nexport function tableFromLocation(search, pathname) {\n  const q = new URLSearchParams(search || '')\n  const fromQuery = q.get('t') || q.get('table')\n  if (fromQuery) return fromQuery.trim() || null\n  // 也接受 /A1 這種路徑形式（QR 碼比較短）\n  const seg = (pathname || '').split('/').filter(Boolean)\n  const last = seg[seg.length - 1]\n  if (last && /^[A-Za-z]\\d+$/.test(last)) return last\n  return null\n}\n\n/** 有加料選項的品項要不要先問（計劃 [S3]）。跟 POS 同一條規則。 */\nexport function needsOptions(item) {\n  if (!item) return false\n  if (item.comboGroups?.length) return true          // 套餐一定要問\n  return (item.optionGroups || []).some(\n    (g) => g.min > 0 || g.options.some((o) => o.price > 0))\n}\n\n/** 一組加料選擇合不合規（計劃 [S3]）。跟後端同一條規則，先在前端擋一次省一趟往返。 */\nexport function optionsAreComplete(item, picked) {\n  for (const g of item.optionGroups || []) {\n    const n = g.options.filter((o) => picked.has(o.id)).length\n    if (n < g.min || n > g.max) return false\n  }\n  return true\n}\n\n/** 套餐每一組都要選一個，而且選中那道菜自己的必選加料也要選完（計劃 [S4]）。 */\nexport function comboIsComplete(item, menu, picked, subOptions) {\n  for (const g of item.comboGroups || []) {\n    const chosen = picked[g.id]\n    if (!chosen) return false\n    const sub = menu.find((m) => m.id === chosen)\n",
