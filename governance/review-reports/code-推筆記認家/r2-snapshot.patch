++      "head": "<!--\n  購物車（桌邊送單前端計劃 [S9]）：看、加減、刪。\n  ★金額全部是後端報價回來的★（計劃 [S6]）——這裡沒有任何加總或乘除。\n-->\n<script setup>\nconst props = defineProps({\n  cart: { type: Array, required: true },\n  amounts: { type: Object, default: null },     // 後端報價;null = 還在算\n  quoteLines: { type: Array, default: null },   // 後端算好的每一列(順序跟購物車一樣時才顯示)\n})\nconst emit = defineEmits(['step', 'drop', 'close'])\n\n/** 這一列後端算的金額。★列數對不上就不顯示★,不自己湊。 */\nfunction lineMoney(i) {\n  if (!props.quoteLines || props.quoteLines.length !== props.cart.length) return null\n  return props.quoteLines[i]?.lineTotal ?? null\n}\n</script>\n\n<template>\n  <div class=\"sheet\" @click.self=\"emit('close')\">\n    <div class=\"panel cartpanel\">\n      <h2>購物車</h2>\n      <div v-for=\"(l, i) in cart\" :key=\"l.key\" class=\"cline\">\n        <div class=\"cinfo\">\n          <div class=\"cname\">{{ l.name }}</div>\n          <div v-if=\"l.detail\" class=\"cdetail\">{{ l.detail }}</div>\n        </div>\n        <div class=\"stepper\">\n          <button class=\"sbtn\" :data-test=\"`minus-${i}`\" @click=\"emit('step', l.key, -1)\">−</button>\n          <span class=\"qty\">{{ l.quantity }}</span>\n          <button class=\"sbtn\" :data-test=\"`plus-${i}`\" @click=\"emit('step', l.key, 1)\">＋</button>\n        </div>\n        <div class=\"cmoney\">\n          <span v-if=\"lineMoney(i) !== null\">${{ lineMoney(i) }}</span>\n          <button class=\"del\" :data-test=\"`drop-${i}`\" @click=\"emit('drop', l.key)\">刪除</button>\n        </div>\n      </div>\n      <div v-if=\"amounts\" class=\"sums\">\n        <div class=\"row\"><span>小計</span><span>${{ amounts.subtotal }}</span></div>\n",
