++      "head": "import SwiftUI\nimport UIKit\n\n/// 配色與尺寸的★單一來源★（計劃 [V6]）。\n///\n/// 色系取自 `~/mOrangePos`（同機的量產 Android POS）的 `colors.xml`——\n/// **只借配色方向，沒有拷貝任何檔案**。它的名字裡有 orange，實際是藍綠／石板色系。\nenum PosTheme {\n    // MARK: 顏色（對照 mOrangePos colors.xml）\n    /// colorPrimary #648593\n    static let primary = Color(red: 0x64 / 255, green: 0x85 / 255, blue: 0x93 / 255)\n    /// colorAccent #51827E\n    static let accent = Color(red: 0x51 / 255, green: 0x82 / 255, blue: 0x7E / 255)\n    /// colorDeepBlue #274F60\n    static let deep = Color(red: 0x27 / 255, green: 0x4F / 255, blue: 0x60 / 255)\n    /// colorLightYellow #C9DCDA（它的命名如此，實際是淺藍綠）\n    static let tint = Color(red: 0xC9 / 255, green: 0xDC / 255, blue: 0xDA / 255)\n    /// color_middle_light_blue #E1EEED\n    static let surface = Color(red: 0xE1 / 255, green: 0xEE / 255, blue: 0xED / 255)\n    static let card = Color.white\n    static let ink = Color(red: 0x2E / 255, green: 0x2E / 255, blue: 0x2E / 255)\n    static let muted = Color(red: 0x86 / 255, green: 0x86 / 255, blue: 0x86 / 255)\n\n    // MARK: 尺寸（起點對照 item_good.xml：圓角 18、間距 8、最小高 130；item_good_kind：最小高 56）\n    //\n    // ★2026-09-10 整體放大★（折扣換桌計劃 [S8]）：POS 是**站著、隔一個手臂距離**在操作的，\n    // 不是拿在手上的手機。原本沿用一般 app 的字級（側欄標籤 12 點、購物車單價 11 點），\n    // 在那個距離下看不清楚。放大之後 13 吋 iPad 橫向仍放得下三欄。\n    static let cardRadius: CGFloat = 18\n    static let gap: CGFloat = 10\n    static let tileMinHeight: CGFloat = 158\n    static let tileMinWidth: CGFloat = 196\n    static let categoryMinHeight: CGFloat = 68\n    static let sidebarWidth: CGFloat = 118\n    static let sidebarItemHeight: CGFloat = 86\n    static let categoryWidth: CGFloat = 176\n    static let cartWidth: CGFloat = 440   // 2026-09-10 字放大之後跟著加寬(13 吋橫向 1376 點寬,菜單格子還有 800 點以上)\n    static let buttonHeight: CGFloat = 56\n\n    // MARK: 字級（★唯一來源★，折扣換桌計劃 [S8]）\n",
