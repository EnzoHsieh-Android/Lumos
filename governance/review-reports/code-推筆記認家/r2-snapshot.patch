++      "head": "import SwiftUI\n\n/// 購物車欄（借 `item_cart.xml` 的數量增減器 `llCartStepper`）。\n/// ★三個金額一律讀後端算好的★——這個檔沒有任何算術。\nstruct CartPane: View {\n    let state: PosScreenState\n    let busy: Bool\n    /// (列號, 增減)——★用列號不用品項代號★：同品項加不同的料是不同列。\n    let onStep: (String, Int) -> Void\n    let onService: () -> Void\n    let onDismiss: () -> Void\n    let onDiscount: () -> Void\n    let onTable: () -> Void\n    let onSubmit: () -> Void\n    let onCheckout: () -> Void\n\n    var body: some View {\n        VStack(spacing: 0) {\n            header\n            Divider()\n            if state.order == nil {\n                Spacer()\n                VStack(spacing: 10) {\n                    Image(systemName: \"hand.tap\").font(.system(size: PosTheme.Size.emptyIcon)).foregroundStyle(PosTheme.muted)\n                    Text(\"點左邊的菜開始\")\n                        .font(.system(size: PosTheme.Size.itemPrice)).foregroundStyle(PosTheme.muted)\n                }\n                Spacer()\n            } else {\n                lines\n                Divider()\n                totals\n            }\n            if let message = state.message {\n                // ★完成通知不該是紅的★——紅色代表出事了\n                Text(message).font(.system(size: PosTheme.Size.message))\n                    .foregroundStyle(state.messageIsError ? .red : PosTheme.accent)\n                    .frame(maxWidth: .infinity, alignment: .leading).padding(.horizontal, 12)\n                    // 訊息從上面滑下來——冒出來的東西要看得出是新的\n                    .transition(.move(edge: .top).combined(with: .opacity))\n",
