++      "head": "<!--\n  加料／套餐的選擇面板。★套餐是兩層★（計劃 [S4]）:\n  外層選「這一份包含哪幾道菜」,選中的那道菜自己的調味展開在它底下——\n  收進另一個畫面的話客人會漏掉甜度,那杯飲料廚房就做不出來。\n-->\n<script setup>\nimport { computed, ref, watch } from 'vue'\nimport { optionsAreComplete, comboIsComplete, previewPrice } from '../core/state.js'\n\nconst props = defineProps({ item: Object, menu: Array })\nconst emit = defineEmits(['confirm', 'close'])\n\nconst picked = ref(new Set())        // 這道菜自己的加料\nconst comboPicked = ref({})          // 套餐:每組選了哪個品項\nconst subOptions = ref({})           // 套餐:選中那道菜的加料\n\nconst isCombo = computed(() => (props.item.comboGroups || []).length > 0)\nconst sub = (id) => props.menu.find((m) => m.id === id)\n\n/** 必選單選的組先給預設(甜度、冰塊),客人只改想改的。 */\nfunction defaultsFor(item) {\n  const out = new Set()\n  for (const g of item?.optionGroups || []) {\n    if (g.min === 1 && g.max === 1 && g.options[0]) out.add(g.options[0].id)\n  }\n  return out\n}\n\nwatch(() => props.item, (it) => {\n  picked.value = defaultsFor(it)\n  comboPicked.value = {}\n  subOptions.value = {}\n  for (const g of it?.comboGroups || []) {\n    const first = g.choices.find((c) => !sub(c.itemId)?.soldOut)\n    if (first) {\n      comboPicked.value[g.id] = first.itemId\n      subOptions.value[g.id] = defaultsFor(sub(first.itemId))\n    }\n  }\n}, { immediate: true })\n",
