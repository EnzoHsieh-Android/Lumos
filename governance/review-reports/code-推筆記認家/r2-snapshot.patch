++      "head": "import Foundation\nimport SwiftUI\n\n/// 把決策層接到畫面上。★這裡只做流程編排，不做判斷也不算錢★。\n@MainActor\nfinal class PosViewModel: ObservableObject {\n    @Published private(set) var state = PosScreenState()\n    @Published private(set) var busy = false\n\n    private let client: PosApiClient\n    private let events: PosEventStream?\n\n    init(client: PosApiClient, events: PosEventStream? = nil) {\n        self.client = client\n        self.events = events\n    }\n\n    /// 給截圖產生器用:直接餵一個狀態進來。★決策層與畫面完全不變★;\n    /// 傳入的 client 決定 `.task` 那次載入菜單會拿到什麼(截圖時餵一個假的傳輸層)。\n    init(preloaded: PosScreenState, client: PosApiClient) {\n        self.client = client\n        self.events = nil\n        self.state = preloaded\n    }\n\n    // MARK: - 即時收單（即時收單計劃）\n\n    /// 接上後端那條長連線。★App 一啟動就接★，之後由它自己維持。\n    func startListening() {\n        events?.start(\n            onEvent: { [weak self] ev in\n                guard let self else { return }\n                Task { await self.receive(ev) }\n            },\n            onReconnect: { [weak self] in\n                // ★每次(重)連上都整批重讀★（[S8]）：斷線那段時間推的事件不會補送。\n                await self?.refreshLists()\n            })\n    }\n\n",
