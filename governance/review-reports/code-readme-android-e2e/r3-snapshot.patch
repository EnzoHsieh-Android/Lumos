+    b+=text(380,626,"No anomaly at a layer → record it and stop there" if en else "哪一層沒有異常，就在查證紀錄記下並停在那一層",15 if en else 16,"muted","middle")
+    b+='<g data-kind="android-record">'+rect(38,642,684,82,"#14243a","#344967",14)
