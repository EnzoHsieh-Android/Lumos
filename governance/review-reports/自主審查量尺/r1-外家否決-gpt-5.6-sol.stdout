 28306	def _codeloop_gov_log(repo_root, branch, status, note, head_sha, ts):
 28307	    """把 code-loop 事件 append 到 docs/.governance-log.jsonl(同 bypass-log 哲學)。
 28308	    vault 找不到 / 非 git repo → 靜默跳過。"""
 28309	    import json
 28310	    import subprocess
 28311	    # 找 docs 目錄(repo root 下的 docs/)
 28312	    docs = Path(repo_root) / "docs"
 28313	    if not docs.is_dir():
 28314	        return
 28315	    if not head_sha:
 28316	        return
 28317	    path = docs / ".governance-log.jsonl"
 28318	    try:
 28319	        commit_short = head_sha[:7]
 28320	        event = {
 28321	            "ts": ts, "commit": commit_short,
 28322	            "gate": "code-loop", "kind": status,
 28323	            "hard": False, "nodes": [],
 28324	            "detail": note, "branch": branch, "head_sha": head_sha,
 28325	        }
 28326	        with open(path, "a", encoding="utf-8") as f:
 28327	            f.write(json.dumps(event, ensure_ascii=False) + "\n")
 28328	    except OSError:
 28329	        pass
