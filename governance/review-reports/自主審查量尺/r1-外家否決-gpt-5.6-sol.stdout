  9287	def _loop_id_for_plan(plan_rel):
  9288	    """計劃檔名 → 迴圈編號:去 _計劃(design-loop skill 的慣例)。"""
  9289	    stem = Path(plan_rel).stem
  9290	    return stem[:-len("_計劃")] if stem.endswith("_計劃") else stem
