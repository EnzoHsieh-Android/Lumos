  7397	def _escape_rows_for(env, loop_id=None):
  7398	    """讀逃逸帳(append-only,不進閘);loop_id 給了就只回那條迴圈的。壞行跳過。"""
  7399	    out = []
  7400	    try:
  7401	        log = env.vault.parent / ".escape-log.jsonl"
  7402	        if not log.exists():
  7403	            return out
  7404	        for ln in log.read_text(encoding="utf-8", errors="replace").splitlines():
  7405	            if not ln.strip():
  7406	                continue
  7407	            try:
  7408	                d = json.loads(ln)
  7409	            except ValueError:
  7410	                continue
  7411	            if loop_id is None or d.get("loop") == loop_id:
  7412	                out.append(d)
  7413	    except OSError:
  7414	        pass
  7415	    return out
