  5545	        g = subprocess.run(["git", "-C", str(rr), "grep", "-q", "-w", "-e", name, r.stdout.strip(), "--"], capture_output=True, text=True, errors="replace")
  5546	        return g.returncode == 0
  5547	    except OSError:
  5548	        return False
