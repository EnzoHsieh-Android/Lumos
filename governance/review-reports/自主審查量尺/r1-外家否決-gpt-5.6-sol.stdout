  9257	def _git_head(repo_root):
  9258	    try:
  9259	        r = subprocess.run(["git", "-C", str(repo_root), "rev-parse", "HEAD"], capture_output=True, text=True, errors="replace")
  9260	        return r.stdout.strip() if r.returncode == 0 else ""
  9261	    except OSError:
  9262	        return ""
  9263	
