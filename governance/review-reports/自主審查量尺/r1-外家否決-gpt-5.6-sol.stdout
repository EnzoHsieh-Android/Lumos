  9265	def _plans_in_range(repo_root, git_range, vault):
  9266	    """提交範圍碰到的計劃筆記(repo 相對路徑)。對回啟發式:碰到 Projects/*.md 就算。"""
  9267	    try:
  9268	        # ★中文檔名:git 預設把非 ASCII 路徑加引號並轉義,不關掉會一個計劃都對不上(taskbank 同型坑 2026-09-15)★
  9269	        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
  9270	                           capture_output=True, text=True, errors="replace")
  9271	    except OSError:
  9272	        return []
  9273	    if r.returncode != 0:
  9274	        return []
  9275	    try:
  9276	        vrel = str(Path(vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
  9277	    except ValueError:
  9278	        return []
  9279	    out = []
  9280	    for line in r.stdout.splitlines():
  9281	        line = line.strip()
  9282	        if line.startswith(vrel + "/Projects/") and line.endswith(".md"):
  9283	            out.append(line)
  9284	    return out
