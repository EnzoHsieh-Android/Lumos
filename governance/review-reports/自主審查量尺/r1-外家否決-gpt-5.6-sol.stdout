sed -n '6840,6975p' scripts/lumos" in /Users/enzo/harness/lumos-toolchain
 succeeded in 0ms:
    R = len(carrier["refuted_set"]) if carrier and carrier.get("refuted_set") is not None else None
    F = len(carrier.get("folded_set") or []) if carrier else None
    A = len(carrier.get("accepted_set") or []) if carrier else None
    N = None if n_missing or not seen else N
    S = None if (N is None or M is None or R is None) else max(0, M + R - N)
    return {"N": N, "M": M, "R": R, "F": F, "A": A, "S": S, "has_carrier": carrier is not None}


def _review_yield_line(y, escapes=None):
    """把 _review_yield_round 的 dict 印成一行(問閘尾與 gov --stats 同一種措辭)。"""
    q = lambda v: "?" if v is None else str(v)
    s_part = "算不了(缺欄位)" if y["S"] is None else f"存活多於席位報的 {y['S']} 條(編排者自找或漏併)"
    tail = f";這條迴圈累計逃逸 {escapes}" if escapes is not None else ""
    return (f"席位報 {q(y['N'])}(機器數)→ 存活 {q(y['M'])} / 編排者重現不到 {q(y['R'])}(人填,已對 intake)"
            f"→ 折 {q(y['F'])} / 放行 {q(y['A'])};{s_part}{tail}")


def _escape_rows_for(env, loop_id=None):
    """讀逃逸帳(append-only,不進閘);loop_id 給了就只回那條迴圈的。壞行跳過。"""
    out = []
    try:
        log = env.vault.parent / ".escape-log.jsonl"
        if not log.exists():
            return out
        for ln in log.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if loop_id is None or d.get("loop") == loop_id:
                out.append(d)
    except OSError:
        pass
    return out


def _severity_check_row(rec, root, trust_sha=False):
    """[嚴重度綁定機械掃 S2] 單帳列 severity 對帳核心(CLI 與 disposal 尾端共用,單一實作)。
    回 (status, 白話訊息):ok/over(高報,保守)/under(低報)/noparse(報告無宣告行)/
    nofile(報告檔佚失)/shafail(報告與帳面指紋不符)。trust_sha=True 時跳過重算
    (disposal ③ 已對判定輪全席逐檔驗過,不對同一檔重算兩遍雜湊;r1 arch-f4)。"""
    rp = rec.get("report_path")
    if not rp:
        return "nofile", "帳列沒有報告檔路徑(舊形狀,寫側 2026-08-26 起已拒)"
    fp = Path(rp)
    if not fp.is_absolute():
        fp = Path(root) / rp
    try:
        text = fp.read_text(encoding="utf-8", errors="replace")
    except OSError as e:
        return "nofile", f"報告檔讀不到({e}): {rp}"
    if not trust_sha:
        want = rec.get("report_sha256")
        if want and _sha256_file(fp) != want:
            return "shafail", f"報告檔與帳面指紋不符(檔案被動過?)——先跑 lumos quote-check 查: {rp}"
    decl = _report_severities(text)
    led = rec.get("severity")
    if not decl:
        return "noparse", "報告裡沒有任何「severity: <值>」獨立宣告行(格式無法機械驗)"
    rmax = max(decl, key=lambda v: _SEV_ORDER[v])
    if led is None:
        return "under", f"帳面沒記 severity,報告宣告最高是 {rmax}"
    if _SEV_ORDER.get(led, -1) < _SEV_ORDER[rmax]:
        return "under", f"低報——報告宣告最高 {rmax},帳面只記 {led}(major 逃必折就是走這條路)"
    if _SEV_ORDER.get(led, 99) > _SEV_ORDER[rmax]:
        return "over", f"高報——帳面 {led} 高於報告最高 {rmax}(保守方向,下游只會更嚴)"
    return "ok", f"帳面 {led} == 報告最高 {rmax}"


def cmd_severity_check(loop_id, round_id, auditor, repo="."):
    """[嚴重度綁定機械掃 S2] 第四道收貨:席報告 severity 宣告↔帳面 --severity 對帳(vault-free)。
    介面吃帳列座標(--loop/--round/--auditor)不吃檔案路徑——對帳對象是帳列不是檔案,
    resolver 與 loop status 同一套 loop/round 篩選(r1 arch-f1 的第二種做法在此交代)。
    定位=第二層縱深:生效日(2026-08-26)前的歷史帳=advisory;生效日後抓到低報=寫側 [S1]
    有 bug(本應拒帳),紅字+指路開 Issue,converged 不自動撤。advisory 恆 rc0;
    找不到帳列/帳檔=rc2;報告 sha 與帳面不符=rc2 拒掃指路 quote-check。"""
    import json
    root = Path(repo).resolve()
    ledger = root / "docs" / ".canary-log.jsonl"
    if not ledger.exists():
        print(f"擋下:找不到帳本 {ledger}(--repo 要指 repo 根)", file=sys.stderr)
        return 2
    hit = None
    for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
        if not line.strip():
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("loop") == loop_id and d.get("round") == round_id and d.get("auditor") == auditor:   # round_id=None 時比對無 round 鍵的列(d.get 回 None)
            hit = d   # append 序,後者勝(同座標重記時看最新)
    if hit is None:
        print(f"擋下:帳本裡找不到 loop={loop_id} round={round_id} auditor={auditor} 的帳列", file=sys.stderr)
        return 2
    st, msg = _severity_check_row(hit, root, trust_sha=False)
    era_new = str(hit.get("ts", "")) >= _SEV_WRITESIDE_CUTOFF
    if st == "shafail":
        print(f"擋下:{msg}", file=sys.stderr)
        return 2
    if st == "under":
        tag = "這筆是生效日後的新帳——寫側本應拒帳,代表 [S1] 有 bug,開 Issue 攤人" if era_new else "歷史帳(生效日前),寫側不溯及"
        print(f"⛔ 低報:{msg}" + "\n" + f"  {tag}(本指令 advisory,不動任何閘)")
    elif st == "noparse":
        tag = "生效日後的新帳不該掃不出宣告行(寫側本應拒帳)——查 [S1]" if era_new else "歷史帳相容:格式無法機械驗,僅提醒"
        print(f"提醒:{msg}——{tag}")
    elif st == "nofile":
        print(f"提醒:{msg}")
    elif st == "over":
        print(f"提醒:{msg}")
    else:
        print(f"✓ {msg}")
    return 0


def _sha256_file(path):
    """檔案 sha256(M1包 #3);OSError 交呼叫端兜(目錄/無權限/不存在統一 rc2,沿 G1 慣例)。"""
    import hashlib
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def _vault_repo_root(env):
    """disposal 留痕路徑的落帳/解析根(r2 終審修,寫讀兩側★必須同用這一份★):
    從 vault 向上找 .git(docs/<slug>-knowledge 布局下 vault.parent=docs/ 非 repo root);
    找不到退 vault.parent(測試假 vault 行為不變)。"""
    p = env.vault.resolve()
    for cand in (p, *p.parents):
        if (cand / ".git").exists():
            return cand
    return env.vault.parent.resolve()


def cmd_canary(env, kind, auditor=None, token=None, note=None, loop=None, severity=None, findings=None, round_id=None, capture_counts=None, clusters=None, spec=None, reviewed=None, tokens=None, wallclock_min=None, tier=None, scope_lines=None, report=None, snapshot=None, intake=None, findings_set=None, folded_set=None, accepted_set=None, accept_reasons=None, canary_type=None, probe=None, finding_kinds=None, refute_verdicts=None, outcome=None, usd=None, orchestrator=None, refuted_set=None, finding_severities=None):
    """記一筆審計輪留痕。kind=caught|missed 是 canary 植入判定(★協議 2026-08-14 停用,
    僅歷史帳;見 Systems/canary-audit d5★);kind=none = 無植入輪的純處置帳載體——
    停用後每輪照記(severity/findings/disposal 欄位是 loop status --disposal 的讀取源)。
    record-only、本機;漏抓(missed)= 該輪審計員放水的訊號,經 lumos gov 可查詢。
    --loop/--severity:把這輪歸進某設計 loop(供 lumos loop status 算收斂)。
    --clusters(M2):該輪 risk-cluster 三態帳(每輪至多一筆帶;讀側 loop status --panel 消費)。
    天花板:這只證明「審計員有沒有醒著讀」,不證明它抓到所有真問題(見設計 doc)。"""
    import json
    import datetime
    import secrets
    if not token:
        token = "CANARY-" + secrets.token_hex(4)   # 隨機,非時間戳(同秒不撞)
    rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
           "kind": kind, "auditor": auditor or "", "token": token, "note": note or ""}
    if loop:
        rec["loop"] = loop
    # D 前置(2026-08-05):植入型別/探針結果結構化——原散文 note 不可重算;
    # 不給不寫鍵(T1 相容慣例)。D 本體開工條件=帶型別記錄攢滿 15 筆(canary-stats 可數)。
    if canary_type:
        rec["canary_type"] = canary_type
    if probe:
        rec["probe"] = probe
    if round_id:
        if round_id.startswith("__"):
            # r3 終審修(3 席重疊):__ 為讀側內部鍵保留字首(round-less 逐筆 __seqN)——
            # 使用者 round-id 撞鍵可讓新輪併入舊輪、舊 carrier 冒充最新處置帳偽 PASS
            print(f"擋下:輪次編號不能用 __ 開頭(工具內部保留這個字首),換一個: {round_id!r}", file=sys.stderr)
            return 2
        rec["round"] = round_id   # panel 一輪 W 筆共享 round-id(loop status --panel 分組)
    if capture_counts:
        try:
            rec["capture_counts"] = [int(x) for x in str(capture_counts).split(",") if x.strip()]
        except ValueError:
            print(f"擋下:--capture-counts 要用逗號分隔的整數(像 2,1,1),你給的是 {capture_counts!r}", file=sys.stderr)
            return 2
    if severity:
        rec["severity"] = severity
    if findings is not None:
        rec["findings"] = findings
    if clusters is not None:   # 空字串也進解析器 → rc2(帶旗標即須有效內容,勿被 falsy 吞)
        parsed, err = _parse_clusters(clusters)
        if err:
            print(f"擋下:--clusters 分組設定寫錯了——{err}", file=sys.stderr)
            return 2
        rec["clusters"] = parsed   # dict{名:狀態},同 capture_counts 寫側轉型慣例
    # ── M1包 #3 雙 hash 鏈(loop機械脊椎M1包_計劃):--spec/--reviewed 必須同現 ──
    if (spec is None) != (reviewed is None):
        print("擋下:--spec(被審文件)和 --reviewed(它的內容指紋)要一起給、或都不給,你只給了一個;--reviewed 填派工當下那份文件的 sha256",
              file=sys.stderr)
        return 2
    if spec is not None:
        try:
            rec["result_sha256"] = _sha256_file(spec)   # record 於 fold 後執行=post-fold hash
        except OSError as e:
            print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
            return 2
        if not re.fullmatch(r"[0-9a-f]{64}", str(reviewed)):
            print(f"擋下:--reviewed 要填 64 碼的 sha256 指紋,你給的格式不對: {reviewed!r}", file=sys.stderr)
            return 2
        rec["reviewed_sha256"] = reviewed
        # 改制回測 [S2]①(2026-08-26):spec 路徑一併入帳——replay --freeze 補漏靠它反查
        # 該 loop 的被審文件(r2 delta d-f1:帳裡只存內容 sha 從沒存路徑,自動凍第一步就跑不動)。
        # 同 report/snapshot 落帳正規化:repo root 底下存相對路徑、之外存絕對。舊帳無此欄不溯及。
        _spr = Path(spec).resolve()
        try:
            rec["spec_path"] = str(_spr.relative_to(_vault_repo_root(env)))
        except ValueError:
            rec["spec_path"] = str(_spr)
    # ── M1包 #4 成本選配欄:非負整數,不給不寫鍵(同 --findings 慣例) ──
    # ★scope_lines(2026-08-02)★:這輪「被審材料有多少行」。
    # 為什麼要記——canary 抓到只證審查員醒著,但★東西越多越抓不到★是外部實測裡
    # 最主導的因素(arXiv 2606.15689:合成缺陷抓得到不可靠地預測真實缺陷抓得到,
    # 且 diff 大小是主導混淆變數)。本專案十輪 code-loop 的 diff 從 332 到 2770 行,
    # ★在帳上長得一模一樣★——等於無法回答「小 diff 上的 caught 是不是灌水」。
    # 這一欄不改任何判定、不進任何 gate,★純粹是把缺的變數記下來★,好讓
    # 「caught 率 vs 規模」這個問題日後答得出來(三種結果都有用:有關係→大 diff
    # 要切開或加席;沒關係→這個擔心在本情境不成立、寫下來別再擔心;反過來→查)。
    # ★不能回溯★:既有記錄沒有這個數字,時鐘從加上去那天才開始走。
    for _name, _val in (("tokens", tokens), ("wallclock_min", wallclock_min),
                        ("scope_lines", scope_lines)):
        if _val is not None:
            if _val < 0:
                print(f"擋下:--{_name.replace('_', '-')} 只能填 0 或正整數,你給的是 {_val}", file=sys.stderr)
                return 2
            rec[_name] = _val
    if scope_lines is not None and scope_lines > _CANARY_SCOPE_SOFT_CAP_LINES:
        rec["scope_oversize"] = True
        print(f"提醒:這輪要審的東西有 {scope_lines} 行,超過建議的軟上限 {_CANARY_SCOPE_SOFT_CAP_LINES} 行"
              f"(外部研究認為材料太多審查員容易看不完、漏審)。", file=sys.stderr)
        print("  不擋你記錄,但帳上已標成 scope_oversize,這一輪抓到的結果算弱證據——"
              "審查員可能是「看不完」而不是「沒問題」;收斂結論講保守一點,下一輪拆開審。", file=sys.stderr)
    # ── 自主迴圈結局帳(2026-08-26 auto-loop-repair-v2):outcome/usd 結構化欄 ──
    # 為什麼開新欄——[S4] 七天彙總要機器回讀「這輪怎麼收+花多少」;塞 note 散文是
    # 專案明文放棄的舊路(note 在讀側一律丟棄防散文注入)。不給不寫鍵,舊列=舊格式桶。
    if outcome is not None:
        # 封閉列舉(code-r1 s4-f1:細類值域也要鎖——只驗主類會讓未宣告的分類靜默進帳,
        # 讀側的彙總桶就對不上);新增細類=先改這裡+spec 分類節,逼兩邊同步。
        _OUTCOMES = ("converged", "skipped",
                     "unconverged:cap", "unconverged:disputed", "unconverged:degraded-high",
                     "tier-blocked:spec", "tier-blocked:gate", "tier-blocked:cross",
                     "pipeline_fail:api_error", "pipeline_fail:truncated",
                     "pipeline_fail:parse_fail", "pipeline_fail:anchor_fail",
                     "pipeline_fail:pending_write")
        if str(outcome) not in _OUTCOMES:
            print(f"擋下:--outcome 只收這 {len(_OUTCOMES)} 個值(結局分類是封閉列舉,新分類要先改"
                  f" spec 與這份白名單):{' / '.join(_OUTCOMES)};你給的是 {outcome!r}",
                  file=sys.stderr)
            return 2
        rec["outcome"] = str(outcome)
    if usd is not None:
        if usd < 0:
            print(f"擋下:--usd 只能填 0 或正數(這一輪實際花的美元),你給的是 {usd}", file=sys.stderr)
            return 2
        rec["usd"] = round(float(usd), 4)
    # ── M1包 #1 tier 定錨欄(選配;loop next/gate 讀首個帶 tier 記錄定錨) ──
    if tier is not None:
        if tier not in LOOP_TIERS:
            print(f"擋下:--tier 分級只能是 {'/'.join(LOOP_TIERS)} 之一,你給的是 {tier!r}", file=sys.stderr)
            return 2
        rec["tier"] = tier
    # ── d4 編排者定錨欄(選配;首個帶 orchestrator 的記錄定錨;帳面已定錨就不能中途換) ──
    if orchestrator is not None:
        if orchestrator not in LOOP_ORCHESTRATORS:
            print(f"擋下:--orchestrator 只能是 {'/'.join(LOOP_ORCHESTRATORS)} 之一,你給的是 {orchestrator!r}", file=sys.stderr)
            return 2
        if not loop:
            print("擋下:--orchestrator 是「誰在編排這個迴圈」,要跟 --loop 一起給;沒 --loop 的記錄定錨不到任何迴圈(孤兒欄)", file=sys.stderr)
            return 2
        if loop:
            _recs = _loop_records(env, loop)
            _prev = _loop_orchestrator(_recs)
            if _prev and _prev != orchestrator:
                print(f"擋下:這個審查編號第一筆就定成 {_prev} 編排,中途換成 {orchestrator} 帳就對不上——要換請開新編號", file=sys.stderr)
                return 2
            if _recs and _prev is None and orchestrator != "claude":   # 舊帳(沒欄)第一次帶旗標會回溯改分家(code-codex-s2 r1 單reviewer F1)
                print(f"擋下:這個審查編號已有 {len(_recs)} 筆沒記編排者的舊記錄,讀側一律視為 claude;現在補 {orchestrator} 會把前幾輪的外家判定全翻掉——要用 {orchestrator} 編排請開新編號", file=sys.stderr)
                return 2
        rec["orchestrator"] = orchestrator
    # ── T1 相容雙讀(design-loop重設計 實作計畫):處置帳六選配欄——★全部不給=行為與今日相同★ ──
    # 集合核對而非總數核對(r1 Codex:只核總數可被重複計數/虛構項配平);
    # 「不給不寫鍵」同 --findings 慣例;違反一律 rc2(寫側就擋,不留到 gate)。
    def _ids(raw):   # None=未給;""=明示空集合(兩者語意不同)
        return None if raw is None else [x.strip() for x in raw.split(",") if x.strip()]
    f_set, fo_set, ac_set = _ids(findings_set), _ids(folded_set), _ids(accepted_set)
    if any(x is not None for x in (fo_set, ac_set, accept_reasons, refute_verdicts, finding_kinds)) and f_set is None:
        print("擋下:--folded-set/--accepted-set/--accept-reason/--refute-verdict/--finding-kind 要跟 --findings-set 一起給(先列出發現了什麼,才能說各自怎麼處置)", file=sys.stderr)
        return 2
    if f_set is not None:
        if not f_set:
            print("擋下:--findings-set 不能是空的;這輪沒有任何發現的話,處置那幾個選項就別帶", file=sys.stderr)
            return 2
        if len(set(f_set)) != len(f_set):
            print(f"擋下:--findings-set 裡有重複 id: {f_set}", file=sys.stderr)
            return 2
        fo, ac = fo_set or [], ac_set or []
        F, FO, AC = set(f_set), set(fo), set(ac)
        if not FO <= F or not AC <= F:
            print("擋下:折掉(folded)或放行(accepted)的清單裡有 id 不在發現清單(findings-set)裡", file=sys.stderr)
            return 2
        if FO & AC:
            print(f"擋下:同一個發現不能既折掉又放行,這幾個兩邊都有: {sorted(FO & AC)}", file=sys.stderr)
            return 2
        if FO | AC != F:
            print(f"擋下:這幾個發現還沒處置: {sorted(F - FO - AC)}——每一條都要說清楚是折掉還是放行,"
                  "折掉加放行要剛好等於全部發現", file=sys.stderr)
            return 2
        reasons = {}
        for item in (accept_reasons or []):
            if "=" not in item:
                print(f"擋下:--accept-reason 要寫成 id=理由,你給的是 {item!r}", file=sys.stderr)
                return 2
            k, _, v = item.partition("=")
            reasons[k.strip()] = v.strip()
        if set(reasons) != AC or any(not v for v in reasons.values()):
            print(f"擋下:每個放行的發現都要附非空理由,不多不少(放行的有 {sorted(AC)},"
                  f" 附了理由的有 {sorted(reasons)})", file=sys.stderr)
            return 2
        if severity == "blocker" and AC:
            print("擋下:這輪有 blocker 等級的問題,blocker 只能折掉修正、不能放行,放行清單必須是空的", file=sys.stderr)
            return 2
        # ── 審查有沒有用記帳 S2(2026-09-08):載體必帶「編排者重現不到」清單,id 要對到 intake 的重現表列 ──
        if refuted_set is None:
            _gate_event_or_warn(_vault_repo_root(env), "canary", "blocked", f"refuted-set-missing loop={loop or ''} auditor={auditor or ''} id={uuid.uuid4().hex[:8]}", hard=True)
            print("擋下:帶 --findings-set 就要帶 --refuted-set(編排者機械重現不到、沒折也沒放行的發現;這輪一條都沒有就寫 --refuted-set none)"
                  "——選填的欄位沒人填(refute_verdicts 0/1216 是前科)", file=sys.stderr)
            return 2
        rreasons = {}
        if str(refuted_set).strip().lower() != "none":
            for item in str(refuted_set).split(","):
                item = item.strip()
                if not item:
                    print("擋下:--refuted-set 有空項(逗號之間沒東西)——這輪一條都沒有就明寫 none,別用空字串混過(空項會被當 none、跳過 intake 驗證;codex r1 f5)", file=sys.stderr)
                    return 2
                if "=" not in item:
                    print(f"擋下:--refuted-set 要寫成 id=理由(半形逗號分隔,所以理由裡別用半形逗號,改用全形「,」),你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("="); k, v = k.strip(), v.strip()
                if len(v) < _MANUAL_MIN_CHARS or not re.search(r"[^\W_]", v):
                    print(f"擋下:--refuted-set 的理由要 ≥{_MANUAL_MIN_CHARS} 字且有實字({k}={v!r})——「重現不到」得講怎麼試的", file=sys.stderr)
                    return 2
                if k in F:
                    print(f"擋下:--refuted-set 的 {k} 也在 --findings-set 裡——重現不到的發現不是存活的發現,二選一", file=sys.stderr)
                    return 2
                rreasons[k] = v
            if rreasons:
                if intake is None:
                    print("擋下:--refuted-set 非 none 時要帶 --intake:重現不到的 id 要對得上 intake 機械重現表那一列(含 HIT/MISS)", file=sys.stderr)
                    return 2
                try:
                    _itext = Path(intake).read_text(encoding="utf-8", errors="replace")
                except OSError as e:
                    print(f"擋下:--intake 指的檔案讀不到: {e}", file=sys.stderr)
                    return 2
                for k in rreasons:
                    _pat = re.compile(r"(?<!\w)" + re.escape(k) + r"(?!\w)")   # \w 邊界:a1 不因 a10 命中、甲 不因 甲乙 命中(r1 f4/codex f2:ASCII 邊界對 CJK id 形同虛設)
                    _kw = ("HIT", "MISS", "重現", "採信")
                    # 圍欄內不算(r1 f3):intake 裡示範格式的 ``` 範例列不能當真重現紀錄——可見性跟拒收偵測同一套 _visible_lines
                    if not any(_pat.search(ln) and any(w in ln for w in _kw) for _no, ln in _visible_lines(_itext.splitlines(), keep_fenced=False)):
                        print(f"擋下:--refuted-set 的 {k} 在 intake 裡找不到「同一列含整字 {k} 與 HIT/MISS/重現/採信」的重現表列——重現不到要有機械重現留痕(整字比對,{k}0 不算 {k})", file=sys.stderr)
                        return 2
        rec["findings_set"], rec["folded_set"], rec["accepted_set"] = f_set, fo, ac
        rec["refuted_set"] = sorted(rreasons)
        if rreasons:
            rec["refuted_reasons"] = rreasons
        if reasons:
            rec["accept_reasons"] = reasons
        # 流程自產工作量(Issues/流程自產工作量未量測 的入口,2026-08-22):每條發現標它在修什麼——
        # code(程式缺陷)/ spec(被審文件本身的缺陷)/ process(流程要求產出的規格文件、留痕格式、範本)。
        # 選填;給了就要全集對得上。幾個月後 gov --stats 算「findings 有幾成在修流程自己要求的東西」。
        if finding_kinds:
            kinds = {}
            for item in finding_kinds:
                if "=" not in item:
                    print(f"擋下:--finding-kind 要寫成 id=code|spec|process,你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("="); k, v = k.strip(), v.strip()
                if v not in ("code", "spec", "process"):
                    print(f"擋下:--finding-kind 的值只能是 code / spec / process,{k} 給的是 {v!r}", file=sys.stderr)
                    return 2
                kinds[k] = v
            if set(kinds) != F:
                print(f"擋下:--finding-kind 要每條發現各標一個(發現有 {sorted(F)},標了 {sorted(kinds)})", file=sys.stderr)
                return 2
            rec["finding_kinds"] = kinds
        # 逐條嚴重度(r2 回滾席,2026-09-17):輪級 severity 是整輪最高值,分不出「造成 major 的是哪一條」;
        # 逃逸自動記要判「code 型那條自己是不是 major 以上」就得逐條給。選填;給了鍵要 ⊆ 全集。
        if finding_severities:
            sevs = {}
            for item in finding_severities:
                if "=" not in item:
                    print(f"擋下:--finding-severity 要寫成 id=clean|minor|major|blocker,你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("=")
                k, v = k.strip(), v.strip()
                if v not in ("clean", "minor", "major", "blocker"):
                    print(f"擋下:--finding-severity 的值只能是 clean / minor / major / blocker,{k} 給的是 {v!r}", file=sys.stderr)
                    return 2
                sevs[k] = v
            if set(sevs) != F:
                # 跟 --finding-kind 一樣要全集(r4 邊界席:只標子集就能把真正 major 的那條漏掉,逃逸不記還標成逐條精度)
                print(f"擋下:--finding-severity 要每條發現各標一個(發現有 {sorted(F)},標了 {sorted(sevs)})", file=sys.stderr)
                return 2
            rec["finding_severities"] = sevs
        # 辯方明確表態(2026-08-27,Systems/finding-refute):辯方對它判過的每條發現表態三選一——
        # agree(同意是真的→維持折入)/ evidence(拿反證降級,須附 file:line→放行)/ concern(只存疑無反證→維持折入)。
        # ★純記帳,不改降級規則★:降級去向仍由 folded/accepted 決定,本欄只記辯方怎麼表態、不回頭改判閘。
        # 鍵是「辯方判過的」子集(⊆全集;辯方只開庭審低共識≥major,不是每條發現都判)。
        # 用途=補上 2026-08-22「辯方三分類先不做」裁定自己點名的缺口(帳裡無逐席對錯,故永遠偵測不到
        # 重啟條件);開始記,日後才能算「辯方標 evidence 降級的、後來證明是真的」有幾筆,用證據決定要不要翻案。
        if refute_verdicts:
            rv = {}
            for item in refute_verdicts:
                if "=" not in item:
                    print(f"擋下:--refute-verdict 要寫成 id=agree|evidence|concern,你給的是 {item!r}", file=sys.stderr)
                    return 2
                k, _, v = item.partition("="); k, v = k.strip(), v.strip()
                if v not in ("agree", "evidence", "concern"):
                    print(f"擋下:--refute-verdict 的值只能是 agree / evidence / concern,{k} 給的是 {v!r}", file=sys.stderr)
                    return 2
                rv[k] = v
            if not set(rv) <= F:
                print(f"擋下:--refute-verdict 的 id 要在發現清單裡(發現有 {sorted(F)},標了不存在的 {sorted(set(rv) - F)})", file=sys.stderr)
                return 2
            # 表態與去向的記帳一致性(寫側,如 accept-reason 鍵須==accepted-set;不碰 disposal 判閘/收斂):
            # evidence=辯方拿反證降級→該 id 的去向必是放行(accepted);agree/concern=辯方維持→必是折入(folded)。
            # 標了 evidence 卻沒放行 = 帳自打架,日後「抽驗降級樣本」會抽到沒降的,挖空本欄用途。
            # ★blocker 輪讓步(2026-08-29 修回歸)★:同輪 severity=blocker 時,上面那條舊規則
            # 強制放行清單必須是空的,而辯方反證推翻的發現照規矩「不折入」——兩條一夾,refuted
            # 發現無處可去,記帳整筆被擋。實害:自主迴圈 2026-08-29 那輪四次撞上,只能把辯方
            # 判決留空、反證寫進 note,結構帳因此少了四輪的辯方資料。
            # 本欄自稱「純記帳、不掛判閘」,所以讓步的是本欄不是判閘:blocker 輪允許 evidence
            # 落在折入,並提醒一句。★根因(blocker 輪該不該讓反證發現放行)是判閘語意問題,
            # 要動得走設計審,本次不碰★。
            _blocker_round = (severity == "blocker")
            for _k, _v in rv.items():
                if _v == "evidence" and _k not in AC:
                    if _blocker_round and _k in FO:
                        print(f"提醒:{_k} 標 evidence(辯方拿反證降級)但落在折入——這輪是 blocker 輪,"
                              "舊規則不准有放行,反證發現只能折;帳照記,反證 file:line 請寫進 --note",
                              file=sys.stderr)
                        continue
                    print(f"擋下:{_k} 標 evidence(辯方拿反證降級)但不在放行清單(--accepted-set)——降級的發現去向是放行,帳對不上", file=sys.stderr)
                    return 2
                if _v in ("agree", "concern") and _k not in FO:
                    print(f"擋下:{_k} 標 {_v}(辯方維持)但不在折入清單(--folded-set)——維持的發現去向是折入,帳對不上", file=sys.stderr)
                    return 2
            rec["refute_verdicts"] = rv
    # ── 嚴重度綁定機械掃 [S1] 寫側強制(2026-08-26)★行為改變★:審查席帳列
    # (--loop/--auditor 齊備即觸發,kind 不限——退役 caught/missed 也擋,換 kind 即繞過;
    # ★2026-08-26 cb3 折入時已放寬:不再要求 --round(漏打 --round 曾使整層蒸發);
    #   2026-08-29 前掃抓到本註解與下方訊息殘留舊字面「--round」,一併訂正★)
    # 一律必附 --report,且帳面 severity 不得低於報告宣告最高。實帳 681 筆審查席列有 286 筆
    # 無報告的舊形狀自此被拒,不設過渡:不附報告的審查帳事後無從重驗(disposal ③ 也 FAIL)。
    # 低報=拒(major 逃必折之路);高報=放行+提醒(保守方向,下游全閘「越高越嚴」r1-s1)。
    # cb3 r1 折入:原「三者齊備才觸發」= 漏打 --round 即整層繞過,而讀側照樣把 round-less
    # 列組成 __seqN 判定輪、severity 尾巴又跳過 __ 合成鍵——三層同時失靈(ext-f1+s1-f1 實測 PASS 到 converged)。
    # 關法:①處置帳(findings_set)必綁輪次與審查席 ②審查席(loop+auditor,結局帳除外)必帶輪次。
    # cb3 r2 extv:--outcome 豁免可被假冒(掛在處置帳上整層跳過)——結局帳與審查席欄位互斥:
    # 真實結局帳只帶 loop+auditor+outcome(+usd/note),帶任何審查欄位=不是結局帳,拒。
    if outcome is not None and kind != "none":
        print("擋下:--outcome 結局帳只能用 kind=none——kind=caught/missed 掛結局欄可湊 legacy 閘輪次(cb3 r2 delta 活體重現)", file=sys.stderr)
        return 2
    if outcome is not None and any(x is not None for x in (round_id, findings_set, severity, report, snapshot, intake, findings)):
        print("擋下:--outcome 是自主迴圈結局帳專用,不能跟審查席欄位(--round/--severity/--report/"
              "--snapshot/--intake/--findings*)混用——掛結局欄假冒豁免正是要關的繞道", file=sys.stderr)
        return 2
    if loop and findings_set is not None and not (round_id and auditor):
        print("擋下:處置帳(--findings-set)必須綁 --round 和 --auditor——無輪次的處置帳讀側已不受理,"
              "沒有席位的處置帳無從對帳", file=sys.stderr)
        return 2
    if loop and auditor and outcome is None:
        # 觸發=審查席帳列(loop+auditor;結局帳 --outcome 除外)。★不要求 round★——light/循序
        # 舊制形狀本來就無輪次且合法;繞道由「處置帳必綁輪次」+讀側 round-less 處置帳拒判關死。
        # (cb3 ext-f1/s1-f1:原「三者齊備」觸發=漏打 --round 即整層蒸發;spec S1 觸發條件據此放寬,已折回計劃)
        if not report:
            print("擋下:審查席記帳(帶 --loop/--auditor)一定要附 --report 審查報告檔——"
                  "不附報告的審查帳事後無從重驗;報告還沒落檔就先存檔再記(2026-08-26 起的新規矩)", file=sys.stderr)
            return 2
        try:
            _rtext = Path(report).read_text(encoding="utf-8", errors="replace")
        except OSError as e:
            print(f"擋下:--report 指的檔案讀不到: {e}", file=sys.stderr)
            return 2
        _decl = _report_severities(_rtext)
        if not _decl:
            print("擋下:報告裡找不到任何一行「severity: <clean|minor|major|blocker>」獨立宣告——"
                  "這行是機械對帳的宣告本體,乾淨輪也要寫一行 severity: clean;"
                  "表頭型(### id / 等級 / 標題)要先在收貨時正規化成獨立行再記", file=sys.stderr)
            return 2
        _rmax = max(_decl, key=lambda v: _SEV_ORDER[v])
        if severity is None:
            print(f"擋下:審查席記帳要帶 --severity(報告裡宣告的最高是 {_rmax}),忠實轉錄才有帳可對", file=sys.stderr)
            return 2
        if _SEV_ORDER[severity] < _SEV_ORDER[_rmax]:
            print(f"擋下:低報——報告宣告的最高嚴重度是 {_rmax},帳面卻只記 {severity};"
                  "帳面不能低於報告(major 靠低報逃過必折走的就是這條路),對正再記", file=sys.stderr)
            return 2
        if _SEV_ORDER[severity] > _SEV_ORDER[_rmax]:
            print(f"提醒:高報——帳面記 {severity} 高於報告宣告最高 {_rmax}(保守方向,放行;下游判定只會更嚴)", file=sys.stderr)
        # ── 審查有沒有用記帳 S1(2026-09-08):報告沒正規化就不收;「報了幾條」由機器數,沒有旗標可填 ──
        _issues = _report_normalize_issues(_rtext)
        if _issues:
            # 被擋也要留痕(r3 接手席 blocker:rc2 不落帳=永遠看不到「撞牆後沒記」有多少;kind=blocked 同 anchor/code-loop 用字);gov --stats「閘的動作」與審查段都印
            _gate_event_or_warn(_vault_repo_root(env), "canary", "blocked", f"report-not-normalized:{len(_issues)} loop={loop or ''} auditor={auditor or ''} id={uuid.uuid4().hex[:8]}", hard=True)   # id=事件隨機碼:同一秒連撞兩次不能在 gov 去重時折成一次(r1 f5/codex f3)
            print(f"擋下:席報告還沒正規化({len(_issues)} 處)——「報了幾條」要由機器從報告數,格式不對數出來就是假的;先改再記:", file=sys.stderr)
            for _no, _why, _ln in _issues[:8]:
                print(f"    第 {_no} 行:{_why}\n      {_ln[:90]}", file=sys.stderr)
            if len(_issues) > 8:
                print(f"    …還有 {len(_issues) - 8} 處", file=sys.stderr)
            print("  規則:檔首一行檔級 severity;每條 finding 恰一行獨立 severity: <值>;驗收輪留舊項不留 severity 字樣;引句行不算", file=sys.stderr)
            return 2
        rec["reported"] = _report_reported_count(_rtext)
        if findings is not None and findings > rec["reported"]:
            _gate_event_or_warn(_vault_repo_root(env), "canary", "blocked", f"findings-over-reported:{findings}>{rec['reported']} loop={loop or ''} auditor={auditor or ''} id={uuid.uuid4().hex[:8]}", hard=True)   # codex r1 f6:這種撞牆也算「寫側擋下」
            print(f"擋下:--findings(存活 {findings})不能多於報告裡報的條數({rec['reported']} 行獨立 severity 宣告,不含檔級與 clean)", file=sys.stderr)
            return 2
        # ★載體席必須全錨,記帳當下就驗★(2026-09-06 第三次踩:規矩寫「先跑引句檢查再選載體」,
        # 我三席都跑了、卻還是把有兩句錨不回快照的那席當載體)。處置閘本來就會驗,但那時帳已經
        # 寫進只進不出的帳本,撤不掉、只能換編號重記整輪——**把同一道檢查往前挪到寫帳之前,
        # 代價從「整輪重記」降成「換一席再敲一次」**。只驗載體席(帶處置清單那筆),
        # 其餘席的引句本來就允許錨不到(不採信而已,不擋)。
        if findings_set is not None and snapshot:
            _qrows = None
            try:
                _qrows = _quote_rows(_rtext, Path(snapshot).read_text(encoding="utf-8"))
            except OSError:
                _qrows = None   # 快照讀不到:下面的 --snapshot 存在性檢查會擋,這裡不重複報
            if _qrows:
                _qmiss = [r for r in _qrows if not r["ok"]]
                if _qmiss:
                    print(f"擋下:這一席要當全輪的帳本載體(帶了處置清單),但它的 {len(_qrows)} 句引言裡"
                          f"有 {len(_qmiss)} 句在凍結快照裡找不到原文。", file=sys.stderr)
                    print("  載體是整輪的記帳憑據,引句錨不回審材就等於憑據對不上;規矩是**挑每句都錨得到的那一席當載體**。", file=sys.stderr)
                    print("  帳本只進不出——真讓它寫進去,處置閘照樣會擋,那時就只能換迴圈編號把整輪重記一次。", file=sys.stderr)
                    print("  先看看哪幾句對不上:", file=sys.stderr)
                    print(f"      lumos quote-check {report} --spec {snapshot}", file=sys.stderr)
                    print("  常見情況:引的是既有程式碼(用來說明「專案本來就有這個做法」),它不在只含改動的快照裡", file=sys.stderr)
                    print("  ——這種引句不算編造,但那一席就不適合當載體;換一席全錨的來帶處置清單。", file=sys.stderr)
                    return 2
    # --intake 選配(intake守衛 T3,2026-08-30 d1):給了就走同款四行為,不給不擋。
    # 讀側重驗在處置閘③(★全輪掃——intake_path 掛 r1 帳列而判定輪多為 r2+,只掃判定輪=常態空轉,r3-F3★)。
    for _flag, _p in (("--report", report), ("--snapshot", snapshot), ("--intake", intake)):
        if _p is None:
            continue
        try:
            _h = _sha256_file(_p)
        except OSError as e:
            print(f"擋下:{_flag} 指的檔案讀不到: {e}", file=sys.stderr)
            return 2
        import os as _os
        if _os.path.getsize(_p) == 0:
            print(f"擋下:{_flag} 指的是空檔,留痕最少要有內容({_p})", file=sys.stderr)
            return 2
        _k = _flag.lstrip("-")
        # [r1 終審修+r2 修] 落帳路徑正規化:repo root 底下存相對路徑、之外存絕對——
        # 原樣存呼叫者字串=相對 cwd,換目錄跑 gate 留痕假失蹤(合法 loop 永久 FAIL)。
        # root 判定=_vault_repo_root(向上找 .git;r2 否決席:vault.parent 在 docs/ 兩層
        # 布局=docs/ 非 repo root,governance/ 留痕永遠落絕對路徑,可攜性假賣點)。
        _pr = Path(_p).resolve()
        try:
            _stored = str(_pr.relative_to(_vault_repo_root(env)))
        except ValueError:
            _stored = str(_pr)
        rec[_k + "_path"], rec[_k + "_sha256"] = _stored, _h
    path = env.vault.parent / ".canary-log.jsonl"
    # ── 代碼審從第一筆就要留痕(2026-09-22 rtb-production-agent-demo 回報)──
    # 下面那道「定錨後才強制」對代碼審太晚:代碼審的慣例是先記非載體席、再記載體席,
    # 第一席記帳時還沒有任何一筆帶發現清單(沒定錨),漏帶 --snapshot 會安靜通過,
    # 要到問處置閘才以「資安席留痕對不上」這種看不出原因的訊息爆出來——而帳本不能撤銷,只能整輪換編號重記。
    # 代碼審的手冊本來就要求每一席都帶這兩個,所以這裡寫側當場擋、直接講缺哪個。
    # ★設計審(散文)不動★:仍照原本的定錨規則,相容鐵則。判法走全檔唯一那支 _roster_kind(代碼審 r1 兩席 blocker:
    # 第一版自己寫 startswith("code"),把「code 開頭沒連字號」的也講成代碼審)。
    # ★「看不出是哪一種」照最嚴的處理★(代碼審 r2 架構席 blocker):同檔三處既有呼叫點對 None 都是從嚴,
    # 就是為了擋「取個 codeX 的編號就繞過」(r2 外家席實跑抓到過);第二版這裡從寬,codeXreview 就能漏帶快照。
    # 從嚴的代價:走新處置閘(--disposal)的設計審本來也要帶這兩個,所以對它們沒差;★舊的 panel 型設計審從沒要求過★
    # (代碼審 r3 通才席:codestage 那九筆就是),目前打不到只是因為更早那條「審查席一定要附 --report」先擋了——
    # 以後動那條規則或開「補記舊帳」的旁路時,這裡要重新想。訊息照既有那幾處的說法講,不硬說它是代碼審。
    # ★只記結局的帳排除★(r1 通才席):帶 --outcome 的那種結構上就不帶報告與快照(上面有互斥規則)。
    _rk = _roster_kind(str(loop)) if loop else "design"
    if loop and _rk != "design" and outcome is None and not (report and snapshot):
        _miss = [f for f, v in (("--report", report), ("--snapshot", snapshot)) if not v]
        _what = (f"代碼審({loop})" if _rk == "code"
                 else f"迴圈 {loop}(編號 code 開頭卻不是 code-,看不出是哪一種審查,照最嚴的當代碼審)")
        print(f"擋下:{_what}的每一筆記帳都要帶 {' 與 '.join(_miss)}——"
              "現在不擋的話,要到問處置閘才會發現,而那時帳本已經不能撤銷,只能整輪換編號重記", file=sys.stderr)
        print("  --report <這一席的報告>  --snapshot <這一輪凍結的 patch>", file=sys.stderr)
        return 2
    # ── T6 收緊(design-loop重設計 實作計畫):disposal 定錨後留痕轉強制 ──
    # 定錨=該 loop 帳面已有任一筆帶 findings_set(同 M2 cluster「首個有效輪定錨」前例)。
    # 定錨後每筆 record 必帶 report+snapshot;未定錨/舊 loop 完全不受影響(相容鐵則)。
    if loop and path.exists() and not (report and snapshot):
        _anchored = False
        try:
            import json as _json6
            # [r1 終審修] 逐行容錯:壞行只跳該行——原整包 try 被 any() 短路順序玩死
            # (壞行排在定錨行前→先炸→整包 fail-open,T6 強制被繞過;4 席重疊 finding)。
            # 殘餘天花板:定錨行★自己★損毀仍偵測不到(讀側 disposal 閘壞行 rc2 兜底)。
            for _l in path.read_text(encoding="utf-8").splitlines():
                if not _l.strip():
                    continue
                try:
                    _d6 = _json6.loads(_l)
                except ValueError:
                    continue
                if _d6.get("loop") == loop and "findings_set" in _d6:
                    _anchored = True
                    break
        except OSError:
            _anchored = False   # 整檔讀不到=環境層問題,寫側不因此誤擋
        if _anchored:
            print(f"擋下:{loop!r} 這個審查編號已經走「每個發現都要處置」的嚴格模式(之前的記錄帶了發現清單),"
                  "之後每筆記錄都要帶 --report(審查報告)和 --snapshot(凍結快照)留痕", file=sys.stderr)
            return 2
    rc = _jsonl_append_verified(path, rec, "token", token)
    if rc != 0:
        return rc
    print(f"✓ 這筆審查結果({kind})記下來了,憑證 {token}" + (f" (審查員 {auditor})" if auditor else "")
          + f"\n    寫入 {path.resolve()}")
    # 逃逸自動記(規格落成可驗收條件_計劃 第五節):代碼審(code-<主題>)記到 major 以上,
    # 對回 <主題> 那條設計迴圈/計劃就記一筆。永遠不影響審查帳本身(任何失敗只印一行)。
    _kinds = rec.get("finding_kinds") if isinstance(rec.get("finding_kinds"), dict) else None
    _sevs = rec.get("finding_severities") if isinstance(rec.get("finding_severities"), dict) else None
    if _sevs is not None:
        # 逐條判(r2 回滾席):code 型那條自己要是 major 以上;沒標型別的那條當分不出、保守算
        _hit = any(v in ("major", "blocker") and (_kinds is None or _kinds.get(k) == "code") for k, v in _sevs.items())
        _precision = "finding" if _kinds is not None else "round"   # 沒標型別=分不出是不是 code 型,不能謊報成逐條精度(r3 邊界席)
    else:
        _has_code = (_kinds is None) or any(str(v) == "code" for v in _kinds.values())   # 沒標型別=分不出,保守記;標了就只收 code 型
        _hit = severity in ("major", "blocker") and _has_code
        _precision = "round"   # 輪級判準:這輪最高 major 且任一條是 code 型——粗,帳上標出來讓讀側分得出
    if loop and str(loop).startswith("code-") and _hit:
        try:
            derived = str(loop)[len("code-"):]
            _auto_escape(env, "code-loop", severity,
                         f"代碼審記到 {severity}({auditor or '?'}{' ' + str(round_id) if round_id else ''})",
                         [(derived, _plan_for_loop(env, derived))],
                         _git_head(env.vault.parent.parent), source="code-loop", extra={"precision": _precision})
        except Exception as _ex:   # 掛勾不准弄壞記帳
            _escape_auto_failed(env, str(loop), "code-loop", str(_ex))
    return 0


def _jsonl_append_verified(path, rec, key_field, key_value):
    """[S1 oracle品質包] append 一行 JSONL + 讀回自驗(成功宣稱與證據綁死)。
    caller 給唯一鍵欄名與值——不寫死欄名(record 用 token、second 用自身 token)。
    寫入 OSError → rc2(既有訊息);寫成功但重開檔讀不回該鍵 → rc2「落盤自驗失敗」。
    出身:2026-07-28 record 回報成功未落盤事故([[Issues/canary-record未落盤事件]])。"""
    import json
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError as e:
        print(f"擋下:寫不進記錄檔({e}):\n    {path}", file=sys.stderr)
        return 2
    try:
        with open(path, encoding="utf-8", errors="replace") as f:   # 獨立重開檔(非同 fd)
            for line in f:
                if not line.strip():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if isinstance(d, dict) and d.get(key_field) == key_value:
                    return 0
    except (OSError, ValueError) as e:
        print(f"canary record: 落盤自驗失敗——寫完讀回來檢查時讀不到({e}),這筆不算記成功:\n    {path.resolve()}", file=sys.stderr)
        return 2
    print(f"canary record: 落盤自驗失敗——系統說寫成功了,但讀回來找不到這一筆,這筆不算記成功:\n    {path.resolve()}",
          file=sys.stderr)
    return 2


def cmd_canary_second(env, ref_id=None, verdict=None, auditor=None, note=None):
    """[S2 oracle品質包] canary 判定的第二判者留痕(抽樣分權,telemetry-only)。
    走 [S1] 同一自驗 helper(唯一鍵=自身新 token);loop status 天然忽略(second 行無 loop 欄)。
    天花板:第二判者仍是 LLM,只壓「植入者=唯一判定者」的單點,不證判定為真。"""
    import json
    import datetime
    import secrets
    if not ref_id or not verdict:
        print("擋下:覆核要帶 --id(要覆核哪一筆)和 --verdict(同意還是推翻)", file=sys.stderr)
        return 2
    if verdict not in ("agree", "overturn"):
        print(f"擋下:--verdict 只能是 agree(同意)或 overturn(推翻),你給的是 {verdict!r}", file=sys.stderr)
        return 2
    if not auditor:
        print("擋下:覆核要帶 --auditor 寫明是誰覆核的;分權的意義就在於記得清楚是不同的人", file=sys.stderr)
        return 2
    path = env.vault.parent / ".canary-log.jsonl"
    found = False
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)


def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None):
    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
    整套審查系統的 ground truth 側;與攔截帳(★圖譜攔截★記號)互為兩面。
    append-only、不進任何閘;歸因是人工判斷(GIGO 同 cluster 歸併,計劃天花板明載)。
    ★歸因守衛的職責範圍(r1 外家 ESC-01 裁明)★:只防「編號打錯」(實存性),不驗迴圈
    收斂/放行狀態——那是語意判斷,歸人;守衛驗語意=偷渡閘,計劃明文不做。"""
    log = env.vault.parent / ".escape-log.jsonl"
    _SEV_W = {"minor": 0, "major": 1, "blocker": 2}
    if auto:
        # 自動模式(規格落成可驗收條件_計劃 第五節):給提交範圍,碰到的計劃筆記各記一筆;對不回就不記。
        if loop_id or list_mode:
            print("擋下:--auto 不吃迴圈編號也不能跟 --list 混用;編號由提交範圍碰到的計劃筆記推出來", file=sys.stderr)
            return 2
        if severity not in _SEV_W or not (stage or "").strip() or not (desc or "").strip():
            print("擋下:--auto 一樣要帶 --stage、--severity(minor|major|blocker)、--desc", file=sys.stderr)
            return 2
        if not git_range:
            print("擋下:--auto 要帶 --range <a..b>(推送/CI 的提交範圍),沒有範圍就對不回計劃", file=sys.stderr)
            return 2
        repo_root = Path(repo) if repo else env.vault.parent.parent
        plans = _plans_in_range(repo_root, git_range, env.vault)
        if not plans:
            print(f"逃逸自動記:範圍 {git_range} 對不回任何計劃筆記,不記(這不是錯,只是這次推送沒碰到計劃)")
            return 0
        vrel = str(Path(env.vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
        loops = [(_loop_id_for_plan(p), p[len(vrel) + 1:]) for p in plans]
        _auto_escape(env, stage.strip(), severity, desc, loops, sha or _git_head(repo_root), source=stage.strip())
        return 0
    if list_mode:
        if loop_id or stage or severity or desc or defect_ref:
            print("擋下:--list 是唯讀,不能跟記帳參數混用——照原樣執行你會以為記了、其實一筆都沒寫。要記帳就拿掉 --list 重跑", file=sys.stderr)
            return 2
        if not log.exists():
            print("逃逸帳是空的:還沒有任何一筆「迴圈放行後下游抓到可歸因缺陷」的紀錄。空≠零逃逸——也可能是沒人記;要記:")
            print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <minor|major|blocker> --desc <一句描述>")
            return 0
        import json as _je
        rows, bad = [], []
        for no, ln in enumerate(log.read_text(encoding="utf-8").splitlines(), 1):
            if not ln.strip():
                continue
            try:
                d = _je.loads(ln)
            except ValueError:
                bad.append(no)
                continue
            if not isinstance(d, dict):
                bad.append(no)      # 合法 JSON 但非物件(null/陣列)——r1 外家 ESC-03:一筆就能弄壞整個 --list
                continue
            rows.append(d)
        if bad:
            print(f"提醒:逃逸帳有 {len(bad)} 行壞損被跳過(行 {', '.join(map(str, bad[:5]))}"
                  + ("…" if len(bad) > 5 else "") + f");帳檔:{log}", file=sys.stderr)
        by_loop = {}
        for r in rows:
            by_loop.setdefault(str(r.get("loop", "?")), []).append(r)
        print(f"逃逸帳:{len(rows)} 筆(迴圈收斂放行後、下游抓到的可歸因缺陷;歸因為人工判斷)")
        for lp, rs in sorted(by_loop.items()):
            worst_row = max(rs, key=lambda r: _SEV_W.get(r.get("severity"), -1))
            wsev = worst_row.get("severity")
            wlabel = wsev if wsev in _SEV_W else f"非標準值 {_esc_clean(wsev, 20)}(手改帳?)"
            print(f"  {_esc_clean(lp, 60)}:{len(rs)} 筆(最重 {wlabel})")
            for r in rs:
                sev = r.get("severity")
                sev_disp = sev if sev in _SEV_W else f"?{_esc_clean(sev, 12)}"
                print(f"    {str(r.get('ts') or '?')[:10]} [{sev_disp}@{_esc_clean(r.get('stage', '?'), 30)}] {_esc_clean(r.get('desc', ''))}"
                      + (f"(佐證:{_esc_clean(r['defect_ref'], 80)})" if r.get("defect_ref") else "")
                      # ★逐筆看得到有沒有標規則★(r1 通才席):只有彙總看得到的話,巡帳的人不知道哪一筆漏標
                      + (f"[本來該抓的規則:{_esc_clean(str(r['rule']), 40)}]" if r.get("rule") else "[沒標該抓的規則]"))
        return 0
    # ── 記帳模式:全部驗證在此(r1 架構席 R-2:dispatch 只路由,驗證不拆層) ──
    if not loop_id:
        print("擋下:要記逃逸就得說是哪個迴圈編號放行的。看帳:\n    lumos loop escape --list", file=sys.stderr)
        return 2
    if severity not in _SEV_W:
        print("擋下:--severity 必填且只能是 minor|major|blocker(同審查帳值域)", file=sys.stderr)
        return 2
    if not (stage or "").strip():
        print("擋下:--stage 必填(在哪一站發現:實作/code-loop/CI/prod/使用者回報…)——缺階段的逃逸帳之後做不了「在哪一站漏的」分層統計", file=sys.stderr)
        return 2
    if not (desc or "").strip():
        print("擋下:--desc 不能空——沒有描述的逃逸帳讀側無從歸因,等於沒記", file=sys.stderr)
        return 2
    ledger = env.vault.parent / ".canary-log.jsonl"
    known, led_bad = set(), 0
    if ledger.exists():
        import json as _je2
        for ln in ledger.read_text(encoding="utf-8").splitlines():
            if not ln.strip():
                continue
            try:
                v = _je2.loads(ln).get("loop")
            except ValueError:
                led_bad += 1
                continue
            if isinstance(v, str):
                known.add(nfc(v))     # r1 邊界席 B-3:NFC 正規化,NFD 貼上形不再肉眼無解
    if nfc(loop_id) not in known:
        msg = f"擋下:審查帳裡沒有叫「{loop_id}」的迴圈——逃逸要歸因到真實存在的迴圈,先確認編號:\n    lumos gov --stats"
        if led_bad:
            msg += f"\n  (審查帳另有 {led_bad} 行壞損被跳過——查不到也可能是編號在那幾行裡)"
        print(msg, file=sys.stderr)
        return 2
    import datetime as _dt_esc
    import secrets as _sec_esc
    rec = {"ts": _dt_esc.datetime.now().astimezone().isoformat(timespec="seconds"),
           "token": "ESC-" + _sec_esc.token_hex(4),       # 落盤自驗唯一鍵(canary auto-mint 慣例)
           "loop": loop_id, "stage": stage.strip(), "severity": severity, "desc": desc.strip()}
    if defect_ref:
        rec["defect_ref"] = defect_ref
    if rule:
        # ★閉環的那一格★:標「本來哪條規則該抓」,漏網才長得出新的守衛;
        # 不標的話這本帳只記得「漏掉了」,永遠不會變成下次擋得住的東西(看待辦:lumos rule-gap)
        rec["rule"] = rule.strip()
    if log.is_symlink():
        # r2 終態席實測:既存 symlink 會繞過建檔保護、共用寫入原語 open('a') 跟隨連結寫進外部檔——
        # 每次寫前先擋本體(殘餘=判斷與開檔間競態,best-effort 同 _ledger_append 家族誠實降級)
        print(f"擋下:逃逸帳檔是一個符號連結,不往裡寫(帳本必須是普通檔案):\n    {log}", file=sys.stderr)
        return 2
    if not log.exists():
        try:
            os.close(os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644))
        except FileExistsError:
            pass
        except OSError as e:
            print(f"擋下:建不了逃逸帳檔({e}):\n    {log}", file=sys.stderr)
            return 2
    rc_w = _jsonl_append_verified(log, rec, "token", rec["token"])   # 共用硬化原語(OSError 擋下+讀回自驗);已知天花板=撞鍵時讀回比對可能對到舊筆(canary 全家族同款,hex4 空間機率極低)
    if rc_w:
        return rc_w
    print(f"✓ 逃逸入帳:迴圈 {loop_id} 放行的東西在「{rec['stage']}」被抓到 {severity} 級缺陷。")
    print("  這筆是審查系統的漏網紀錄——量的是「閘沒接住的」,與攔截帳(★圖譜攔截★)互為兩面;看全帳:")
    print("    lumos loop escape --list")
    return 0


def cmd_loop_status(env, loop_id, need=None, gate=False, spec=None, repo=None, panel=False, light=False, min_seats=None, settle=None, disposal=False, roster=False):
    """算某設計 loop 的收斂(收斂留痕):連 K 輪『canary caught 且 severity∈{clean,minor}』。
    --gate:升級為證據閘(K-streak 為必要條件,合取 G1 refcheck 引用座標 + G2 發現枯竭);
    findings 數的源頭仍是 LLM 裁決——gate 機械化的是算術,不是數字的正確性(見設計 doc)。
    讀 .canary-log.jsonl 的 **append 序**(不 ts-sort:ts 只到秒、同秒會並列),篩 loop==id。
    tail-K 滑動窗:前面髒輪不影響、只看最後 K 筆;missed/缺 severity 視同未收斂。
    exit 0=CONVERGED / 1=未收斂(含無記錄=還沒開始)/ 2=真錯誤。
    天花板:收斂=連 K 輪醒著的審計員沒找到 blocker/major,非完整正確;severity 自報(見設計 doc)。"""
    import json
    if light and panel:
        print("擋下:--light 和 --panel 不能一起用(light 是單人審、panel 是多人審,兩條不同的路),擇一", file=sys.stderr)
        return 2
    explicit_need = need is not None
    if need is None:
        need = 2
    if disposal:
        # [T4 處置閘] 獨立路徑(design-loop重設計 d2/B5):與所有既有模式互斥,舊閘一行不動
        if panel or light or settle is not None or explicit_need or min_seats is not None:
            print("擋下:--disposal 是獨立的一套閘,不能跟 --panel/--light/--settle/--need/--min-seats 一起用",
                  file=sys.stderr)
            return 2
        if spec is None:
            print("擋下:--disposal 一定要帶 --spec 指定被審的文件,不然沒辦法比對文件有沒有被改、留痕對不對(寧可擋也不猜)", file=sys.stderr)
            return 2
            dirty.append(rel)
    if not dirty:
        return
    msg = "chore(lumos): 記錄代碼審通過" if status == "passed" else "chore(lumos): 記錄代碼審跳過"
    print(f"  這幾個簿記檔還沒提交({len(dirty)} 個)——留痕之後只准提交它們,漏掉哪個推送都會被擋:")
    quoted = " ".join(_sh_quote(d) for d in dirty)
    print(f"    git commit -m '{msg}' -- {quoted}")


def _sh_quote(s):
    """路徑含空白或中文時照樣貼得上去。"""
    import shlex
    return shlex.quote(s)


def _codeloop_write(repo_root, branch, status, note, head_sha, ts):
    """寫 governance/code-loop/<branch>.json。"""
    import json
    safe = _codeloop_branch_filename(branch)
    d = Path(repo_root) / "governance" / "code-loop"
    d.mkdir(parents=True, exist_ok=True)
    rec = {"head_sha": head_sha, "status": status, "note": note, "ts": ts}
    (d / f"{safe}.json").write_text(
        json.dumps(rec, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def _codeloop_gov_log(repo_root, branch, status, note, head_sha, ts):
    """把 code-loop 事件 append 到 docs/.governance-log.jsonl(同 bypass-log 哲學)。
    vault 找不到 / 非 git repo → 靜默跳過。"""
    import json
    import subprocess
    # 找 docs 目錄(repo root 下的 docs/)
    docs = Path(repo_root) / "docs"
    if not docs.is_dir():
        return
    if not head_sha:
        return
    path = docs / ".governance-log.jsonl"
    try:
        commit_short = head_sha[:7]
        event = {
            "ts": ts, "commit": commit_short,
            "gate": "code-loop", "kind": status,
            "hard": False, "nodes": [],
            "detail": note, "branch": branch, "head_sha": head_sha,
        }
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass



# ── 受波及合約測試真跑閘(Projects/受波及合約測試真跑閘_計劃;design-loop bound-tests-gate-c r1 PASS)────
# 改到相依功能時,impact 固定席上的合約綁了什麼測試,在 code-loop check(pre-push 每次都呼叫)就真跑一遍;
# 紅/懸空/方法名不合法 → BLOCKED。掛在「擋」的路徑(check)不掛「記錄」的路徑(pass)——r1 架構席抓的。
# 假綠三防:①測試名要在該平台真測試集合(同 Check T);②去重鍵=解析後完整指令(同 kill);③方法名重驗同 kill。
# fail-open 四情境(無 run_cmd / diff 算不出 / 無固定席 / 固定席沒綁)都寫 gate=bound-tests 帳,零觸發看得見。
_BOUND_TESTS_WHOLE_SUITE_TIMEOUT = 600.0   # 同 kill baseline 的下限


def _bound_tests_log(repo_root, kind, nodes, note, secs=None, calc_secs=None):
    """治理帳 gate=bound-tests(獨立 gate,kind 裸結果詞;fail-open,寫不進不影響判定)。

    ★secs / calc_secs 要當獨立欄位寫進帳★(2026-09-07 設計 [S6]):
    以前只塞在自由文字的 note 裡(「46 綠 41.8s」),回頭條件量不到——
    而這一案掛的兩條回頭條件都要問「近 30 天最大耗時多少」。
    ★第一版我只把它們放進回傳的 dict,帳上還是自由文字★——那等於沒做,
    因為回傳值不落盤,週跑回頭看的是帳。
    secs=跑測試那段;calc_secs=算波及那段。兩段成本的成因不同,不能加在一起。
    """
    try:
        vault = _vault_in(repo_root)
        if vault is not None:
            # ★hard 要跟著 kind 改名一起改★(代碼審 r1 外家否決席判 major,查證屬實):
            # kind 從 red 拆成 red-advisory / red-blocked 之後,這裡還在比對舊的 "red"
    stk, spec = _stack_spec_by_id(qid)
    if spec is None:
        print(f"擋下:{qid!r} 不是題目表裡的 id;全表看 lumos pitfalls --diff <範圍> --json 的 stack_questions_meta", file=sys.stderr)
        return 2
    if not (note or "").strip():
        print("擋下:--note 寫一句審查席抓到了什麼(進治理帳,之後拿來修那題的觸發)", file=sys.stderr)
        return 2
    import datetime as _dt
    _gate_event_or_warn(repo_root, "code-loop", "recall-miss", f"{qid}:{note}", hard=False,
                        head_sha=head_sha, ref=branch,
                        extra={"recall_miss": qid, "written_at": _dt.datetime.now().astimezone().isoformat(timespec="microseconds")})
    print(f"✅ 記下 recall-miss:{qid}(棧 {stk})——同題累積 3 次,gov --stats 會列成「觸發太窄候選」,到時修它的 when。")
    return 0


def cmd_code_loop(subcmd, note=None, repo=None, as_json=False, diff_range=None, at_sha=None, marker_branch=None, skip_bound=False, from_json=None, disp_file=None, qid=None, bound_advisory=False):
    """code-loop 留痕讀寫。
    pass  → status=passed(綁 HEAD sha);
    skip  → status=skipped(綁 HEAD sha,留逃生痕);
    dispositions <檔> → 棧別提問表態(表態閘 2026-09-09;派審查員之前寫,skip 也要先表態);
    recall-miss <id> → 審查席抓到未觸發題的問題時登記一筆;
    check → 跑判定式回報 verdict(blocked=合約測試紅 ∨ 有適用題表態不完整 ∨ tier=high∧無有效留痕);--json 輸出 verdict dict。
    rc: 0=OK / 1=check:blocked / 2=參數錯。
    """
    # resolve repo root
    if repo is not None:
        repo_root = Path(repo)
        if not repo_root.is_dir():
            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
            return 2
    else:
        repo_root = None
        for cand in (Path.cwd(), *Path.cwd().parents):
            if (cand / ".git").exists():
                repo_root = cand
                break
        if repo_root is None:
            print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
            return 2

    branch = _codeloop_git_branch(repo_root)
    head_sha = _codeloop_git_head(repo_root)
    if not head_sha:
        print("擋下:問不到目前的 git 版本號(git 指令失敗?)", file=sys.stderr)
        return 2
    ts = _codeloop_git_ts(repo_root)

    if subcmd == "dispositions":
        # --branch(r3 外家 F11):推 HEAD:別名 時 pre-push 按遠端目的分支查記錄,表態要寫在那個名字下
        if marker_branch is not None and not marker_branch.strip():
            print("擋下:--branch 給了空字串——要寫在哪個分支名下講清楚,不然會悄悄退回 checkout 分支(r1 邊界席 f3)", file=sys.stderr)
            return 2
        # --at-sha(r1 外家 finder f5/否決 f2):checkout 在 main、推的是別的分支時,check 按被推的 sha 查,表態得綁那個 sha 不是 HEAD
        if at_sha:
            import subprocess as _sp
            _rp = _sp.run(["git", "rev-parse", "--verify", f"{at_sha}^{{commit}}"], capture_output=True, text=True, errors="replace", cwd=str(repo_root))
            if _rp.returncode != 0:
                print(f"擋下:--at-sha {at_sha} 不是這個 repo 裡的 commit", file=sys.stderr)
                return 2
            head_sha = _rp.stdout.strip()
            ts = _codeloop_git_ts(repo_root, head_sha) or ts
        return _cmd_codeloop_dispositions(repo_root, marker_branch or branch, head_sha, ts, disp_file)
    if subcmd == "recall-miss":
        return _cmd_codeloop_recall_miss(repo_root, branch, head_sha, ts, qid, note or "")

    if subcmd in ("pass", "skip"):
        status = "passed" if subcmd == "pass" else "skipped"
        _codeloop_write(repo_root, branch, status, note or "", head_sha, ts)
        _codeloop_gov_log(repo_root, branch, status, note or "", head_sha, ts)
        label = "✅" if status == "passed" else "⏭"
        what = "審查通過,已留痕" if status == "passed" else "刻意跳過審查,已留痕"
        print(f"{label} code-loop {status}:{what}(分支 {branch},版本 {head_sha[:8]})" + (f"——{note}" if note else ""))
        print("  這筆紀錄只認目前這個版本:之後再改任何程式碼(工具自己的紀錄檔除外)它就失效,要重跑一次 pass 或 skip。")
        _codeloop_print_dirty_bookkeeping(repo_root, status)
        return 0

    if subcmd == "check":
        # Task 2: 完整判定式(tier-high∧無有效留痕 → blocked)
        import json as _cljson
        if skip_bound and not (note or "").strip():
            print("擋下:--skip-bound-tests 要帶 --note 寫為什麼不跑受波及合約的測試(會進治理帳被統計)", file=sys.stderr)
            return 2
        verdict = _codeloop_guard_verdict(repo_root, diff_range=diff_range,
                                          at_sha=at_sha, branch=marker_branch,
                                          skip_bound=skip_bound, skip_note=note or "",
                                          payload=_impact_payload_read(from_json) if from_json else None,
                                          bound_advisory=bound_advisory)
        bt = getattr(_codeloop_guard_verdict, "last_bound", None)
        if bt is not None and "bound_tests" not in verdict:
            verdict["bound_tests"] = bt
        dv = getattr(_codeloop_guard_verdict, "last_dispositions", None)
        if dv is not None and "dispositions" not in verdict:
            verdict["dispositions"] = dv
        blocked = verdict["blocked"]
        reason = verdict["reason"]
        tier = verdict["tier"]
            k = (r["gate"], nd)
            t = r["ts"]
            if k not in span:
                span[k] = [t, t, 1]
            else:
                span[k][0] = min(span[k][0], t); span[k][1] = max(span[k][1], t); span[k][2] += 1
    out = []
    for (g, nd), (ft, lt, c) in span.items():
        f, l = ft[:10], lt[:10]
        try:
            days = (_dt.date.fromisoformat(l) - _dt.date.fromisoformat(f)).days
        except ValueError:
            continue
        # 「還在喊」= 最後一次提醒不早於最近一次體檢(體檢會先寫提醒再寫 doctor-run,同秒內算還在喊)
        still = (last_run is None) or (lt[:19] >= last_run[:19])
        if days >= min_days and still:
            out.append((days, g, nd, f, l, c))
    if not out:
        print(f"沒有空轉的提醒:沒有任何閘對同一篇連續喊超過 {min_days} 天還沒人理。")
        return 0
    out.sort(reverse=True)
    print(f"提醒:下面這些是「同一道閘對同一篇連續喊了 ≥{min_days} 天、最近一次體檢({(last_run or '?')[:16]})還在喊」的空轉清單,共 {len(out)} 組。")
    print("機制有在跑,只是沒人去看——要嘛處理那篇,要嘛承認這道提醒對它無效、把它降成不提醒。")
    for days, g, nd, f, l, c in out[:30]:
        print(f"  {days:>4} 天  {g:10} {nd}  ({f} → {l},喊了 {c} 次)")
    if len(out) > 30:
        print(f"  … 還有 {len(out) - 30} 組")
    print("處理完一篇後它自然從清單消失;要看某篇被哪幾道閘喊:lumos gov <篇名>")
    return 1


def cmd_gov(env, node=None, since_days=90, full=False, stats=False, nags=0):
    """唯讀彙整六帳(bypass/governance/canary/kill/signoff/ci;rot-queue 2026-08-22 拆出)→ 治理事件時間軸。
    本機開發可見性工具(非合規物)。L2 無 node → 對 Systems 為部分視圖。
    去噪(2026-07-25,呈現層——帳本身不動):同日同類 advisory(軟/warned/無 detail,如 Check S
    每次 doctor 全名單重喊)跨 commit 折疊 ×N、同群 >6 節點收單行摘要;--full 回完整逐筆。"""
    import json
    import datetime
    docs = env.vault.parent
    cutoff = (datetime.date.today() - datetime.timedelta(days=since_days)).isoformat()

    def stem(s):
        return Path(str(s)).stem.lower()

    rows = []
    loaded = []          # --stats 要印「本次實際載入哪幾源」(ci 帳是條件載入,非固定六本)

    def load(name, mapper):
        p = docs / name
        if not p.exists():
            return
        loaded.append(name.lstrip(".").replace("-log.jsonl", "").replace(".jsonl", ""))
        for line in p.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(mapper(json.loads(line)))
            except (ValueError, KeyError):
                continue

    load(".bypass-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "L2", "kind": "bypassed", "hard": False, "nodes": [], "detail": d.get("subject", "")})
    # .rot-queue.jsonl(L3)2026-08-22 拆出:寫帳的 verification-rot-check 8/21 已撤,本機也沒有這個檔;留 loader 只是假名額。
    load(".governance-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": d.get("gate", "?"), "kind": d.get("kind", "?"), "hard": bool(d.get("hard")),
         "nodes": [stem(x) for x in d.get("nodes", [])], "detail": d.get("note", ""),
         # 審查有沒有用記帳(2026-09-09):記帳被寫側擋下(canary/blocked)每次各算一筆——同一個 commit 連撞三次
         # 本來會被 (commit,nodes,gate,kind) 折成一次,「擋下 N 次」就永遠是 1;拿 ts+note(note 含事件隨機碼)當第 5 鑑別子(同秒也分得開,r1 f5)
         # 表態閘(2026-09-09,r3 接手席 H1):同 sha 兩筆 dispositions / recall-miss 各算各的——鑑別子拿 written_at(事件時間,微秒),
         # 不拿 ts:ts 是 HEAD commit 時間,同一顆 sha 重表態兩筆一模一樣(r1 併發席 f3/合約測試席 f1 實測折成一筆)
         "token": ((d.get("ts", "") + d.get("note", "")) if (d.get("gate") == "canary" and d.get("kind") == "blocked")
                   else (d.get("written_at") or d.get("ts", "")) if (d.get("gate") == "code-loop" and d.get("kind") in ("dispositions", "recall-miss")) else ""),
         "dispositions": d.get("dispositions") if d.get("kind") == "dispositions" else None,
         "candidates": d.get("candidates") if d.get("kind") == "dispositions" else None,   # 候選張力題數(2026-09-09)
         "recall_miss": d.get("recall_miss") if d.get("kind") == "recall-miss" else None,
         # 每支檔有家(2026-09-11 [S27]):擋下事件的(檔,節點)配對——回頭條件要拿它列出「被逼出來的 about_code」
         "pairs": d.get("pairs") if d.get("gate") == "nodehome-check" else None})
    # 第 6 源:業務簽核留痕(validation:人對業務正確性點頭的日期/人/內容)。
    load(".signoff-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "signoff", "kind": "signed", "hard": False,
         "token": d.get("ts", ""), "nodes": [stem(d.get("node", ""))],
         "detail": (d.get("by", "") + " " + d.get("note", "")).strip()})
    # 第 5 源:kill 殺傷力驗證留痕(guard kill 的 verdict 史)。
    load(".kill-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "kill", "kind": d.get("verdict", "?"), "hard": False,
         "token": d.get("invariant", "") + d.get("ts", ""),   # 同節點多合約/多次不互吞(dedup 第5鑑別子)
         "nodes": [stem(d.get("node", ""))],
         "detail": f"{d.get('invariant','')[:28]} [{d.get('test','')}] {d.get('note','')}".strip()})
    # 第 4 源:canary 審計留痕(審計員可靠度史)。只此 mapper 輸出 token 鍵(供 dedup 鑑別)。
    load(".canary-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": "",
         "gate": "canary", "kind": d.get("kind", "?"), "hard": False, "nodes": [],
         "token": d.get("token", ""), "auditor": d.get("auditor") or "?",
         "findings": d.get("findings"), "severity": d.get("severity", ""),
         "finding_kinds": d.get("finding_kinds"),
         "refute_verdicts": d.get("refute_verdicts"),
         # 審查有沒有用記帳(2026-09-08):讀側算「報→存活→重現不到→折/放行」要的欄位,缺=舊帳=印 ?
         "loop": d.get("loop"), "round": d.get("round"), "reported": d.get("reported"),
         "findings_set": d.get("findings_set"), "refuted_set": d.get("refuted_set"),
         "folded_set": d.get("folded_set"), "accepted_set": d.get("accepted_set"),
         "report_sha256": d.get("report_sha256"),
         # [S2] second 行的 verdict/ref 併進 detail(否則分歧訊號在治理帳全程隱形)
         "detail": ((f"verdict={d.get('verdict','?')} ref={d.get('ref','')} · "
                     if d.get("kind") == "second" else "")
                    + (f"loop={d['loop']} sev={d.get('severity', '?')} · " if d.get("loop") else "")
                    + (d.get("auditor", "") + " " + d.get("note", "")).strip())})

    # 第 7 源:CI 回流帳(總開關——未宣告 ci 區塊即完全不 load,否則移除宣告後歷史事件仍顯示)
    _ci_root = _anchor_repo_root(None)
    if _ci_root and _ci_config(_ci_root)[0]:
        load(CI_LOG_NAME, lambda d: {"ts": d.get("ts", ""), "commit": d.get("sha", ""),
             "gate": "ci", "kind": d.get("conclusion", "?"), "hard": False, "nodes": [],
             "token": d.get("dedup_key", ""),
             "detail": f"{d.get('workflow', '')} {d.get('title', '')} {d.get('failed_step', '')}".strip()})

    rows = [r for r in rows if (r["ts"][:10] or "9999") >= cutoff]
    seen, ded = set(), []
    for r in sorted(rows, key=lambda r: r["ts"]):
        # canary 每筆 token 唯一 → 加 token 當第 5 鑑別子(舊三源無此鍵,.get 回 "");必須用 .get 不可 r["token"]
        k = (r["commit"], frozenset(r["nodes"]), r["gate"], r["kind"], r.get("token", ""))
        if k in seen:
            continue
        seen.add(k)
        ded.append(r)
    if node:
        q = stem(node)
        ded = [r for r in ded if q in r["nodes"]]
    if nags:
        return _render_gov_nags(rows, nags)   # 用去重前的原始列:去重鍵含 commit,兩次體檢間沒 commit 會折掉最後一次日期
    # ── 去噪(呈現層):advisory(軟/warned/無 token/無 detail)同(日,gate,kind,node)折 ×N;
    #    同(日,gate,kind)群 >6 節點再收單行摘要。canary/kill/signoff/L2 等有 detail/token 逐筆保留。
    def _is_advisory(r):
        if r.get("gate") == "delguard" and r["kind"] in ("ok", "degraded") and not r.get("token"):
            return True   # delguard 每 commit 一筆且帶 note(第三輪稽核:原條件要 detail 為空,永遠折不到)——同日折 ×N
        return (not r["hard"]) and r["kind"] == "warned" and not r.get("token") and not r["detail"]
    lines = []

