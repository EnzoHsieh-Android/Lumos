  5596	def _spec_gate_record(env, rel, judged, text, rows_b, clauses, names, keeps, counts):
  5597	    """規格閘留痕:走審查帳同一支寫入口(_jsonl_append_verified+vault 寫入鎖),kind=spec-gate(讀側的輪次判定要略過它——S16)。
