  9380	def _plan_file_exists(env, plan_rel):
  9381	    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
  9382	    if (env.vault / plan_rel).is_file():
  9383	        return True
  9384	    parent = (env.vault / plan_rel).parent
  9385	    if not parent.is_dir():
  9386	        return False
  9387	    want = nfc(Path(plan_rel).name)
  9388	    try:
  9389	        return any(nfc(q.name) == want for q in parent.iterdir())
  9390	    except OSError:
  9391	        return False
