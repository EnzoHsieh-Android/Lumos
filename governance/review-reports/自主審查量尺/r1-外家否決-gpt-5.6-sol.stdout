  5551	def _spec_gate_twoway_static(text, clauses, names, rr, plan_repo_rel):
  5552	    """風險低的靜態條件(跑測試之前):至少一條沒標 keeps;標 keeps 的測試在計劃建立前就存在(計劃沒進歷史=驗不了,擋)。回 (要印的行, 擋不擋)。"""
