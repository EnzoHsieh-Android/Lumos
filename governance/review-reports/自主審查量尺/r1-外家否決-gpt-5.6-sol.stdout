 28295	def _codeloop_write(repo_root, branch, status, note, head_sha, ts):
 28296	    """寫 governance/code-loop/<branch>.json。"""
 28297	    import json
 28298	    safe = _codeloop_branch_filename(branch)
 28299	    d = Path(repo_root) / "governance" / "code-loop"
 28300	    d.mkdir(parents=True, exist_ok=True)
