  9293	def _plan_for_loop(env, loop_id):
  9294	    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。"""
  9295	    for cand in (f"{loop_id}_計劃.md", f"{loop_id}.md"):
  9296	        if (env.vault / "Projects" / cand).is_file():
  9297	            return f"Projects/{cand}"
  9298	    return None
