 28333	# ── 受波及合約測試真跑閘(Projects/受波及合約測試真跑閘_計劃;design-loop bound-tests-gate-c r1 PASS)────
 28334	# 改到相依功能時,impact 固定席上的合約綁了什麼測試,在 code-loop check(pre-push 每次都呼叫)就真跑一遍;
 28335	# 紅/懸空/方法名不合法 → BLOCKED。掛在「擋」的路徑(check)不掛「記錄」的路徑(pass)——r1 架構席抓的。
 29790	    recall-miss <id> → 審查席抓到未觸發題的問題時登記一筆;
 29791	    check → 跑判定式回報 verdict(blocked=合約測試紅 ∨ 有適用題表態不完整 ∨ tier=high∧無有效留痕);--json 輸出 verdict dict。
 29792	    rc: 0=OK / 1=check:blocked / 2=參數錯。
 29793	    """
 29794	    # resolve repo root
 29795	    if repo is not None:
 29796	        repo_root = Path(repo)
 29797	        if not repo_root.is_dir():
 29798	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 29799	            return 2
 29800	    else:
 29801	        repo_root = None
 29802	        for cand in (Path.cwd(), *Path.cwd().parents):
 29803	            if (cand / ".git").exists():
 29804	                repo_root = cand
 29805	                break
 29806	        if repo_root is None:
 29807	            print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
 29808	            return 2
 29809	
 29810	    branch = _codeloop_git_branch(repo_root)
 29811	    head_sha = _codeloop_git_head(repo_root)
 29812	    if not head_sha:
 29813	        print("擋下:問不到目前的 git 版本號(git 指令失敗?)", file=sys.stderr)
 29814	        return 2
 29815	    ts = _codeloop_git_ts(repo_root)
 29816	
 29817	    if subcmd == "dispositions":
 29818	        # --branch(r3 外家 F11):推 HEAD:別名 時 pre-push 按遠端目的分支查記錄,表態要寫在那個名字下
 29819	        if marker_branch is not None and not marker_branch.strip():
 29820	            print("擋下:--branch 給了空字串——要寫在哪個分支名下講清楚,不然會悄悄退回 checkout 分支(r1 邊界席 f3)", file=sys.stderr)
 29821	            return 2
 29822	        # --at-sha(r1 外家 finder f5/否決 f2):checkout 在 main、推的是別的分支時,check 按被推的 sha 查,表態得綁那個 sha 不是 HEAD
 29823	        if at_sha:
 29824	            import subprocess as _sp
 29825	            _rp = _sp.run(["git", "rev-parse", "--verify", f"{at_sha}^{{commit}}"], capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 29826	            if _rp.returncode != 0:
