  9394	def _escape_auto_failed(env, loop_id, stage, why):
  9395	    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
  9396	    try:
  9397	        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
  9398	                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
  9399	    except Exception:
  9400	        pass
  9401	    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)
