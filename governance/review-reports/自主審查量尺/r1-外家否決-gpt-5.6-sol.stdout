    extra = live - frozen
    if missing:
        red.append(f"帳被動:凍結時的 {len(missing)} 列帳在現帳裡消失或被改(append-only 帳不該少東西)")
    if extra:
        print(f"  帳本長大:凍結後同 loop 合法多了 {len(extra)} 列(常態,不紅)")
    # ② 凍結卷證檔完整性(sha 先驗;壞了不硬算,不誤報成邏輯漂移——r2 ext-f4)
    file_bad = []
    for rp, meta in (g.get("files") or {}).items():
        fp = Path(root) / rp
        try:
            cur = _sha256_file(fp)
        except OSError:
            file_bad.append(f"{rp}(佚失)")
            continue
        if cur != meta.get("sha256"):
            file_bad.append(f"{rp}(內容被動;git blob {str(meta.get('git_blob'))[:10]} 可從版控史回復)")
    if file_bad:
        red.append("凍結檔被動/佚失:" + ";".join(file_bad))
    if _engine_stale:
        import shlex as _shlex   # 代碼審 r3 資安 G1:印給人照抄的指令,編號與帳上的路徑都加引號
        _gsp = g.get("spec_path")
        print(f"  golden 過期(制度已演進:{g.get('engine_rev')} → {_REPLAY_ENGINE_REV})——"
              f"重算跳過;完整性檢查照上;確認新制合理後重凍:"
              f"lumos loop replay {_shlex.quote(loop_id)} --freeze --spec {_shlex.quote(str(_gsp)) if _gsp else '<計劃>'} --note <理由>")
    # ③ 對凍結閉包重算(卷證檔壞了就不硬算;制度過期不硬算)
    if not file_bad and not _engine_stale:
        rows = []
        for line in g.get("rows", []):
            try:
                rows.append(json.loads(line))
            except ValueError:
                red.append("golden 檔內帳列解析失敗(golden 自身損壞)")
                rows = None
                break
        if rows is not None:
            out = {}
            rc = _loop_status_disposal(rows, loop_id, None, 0, root, env=env, repo=repo,
                                       readonly=True, spec_sha_override=g.get("spec_sha"),
                                       result_out=out)
            want = g.get("verdict") or {}
            if rc == 2:
                red.append("邏輯漂移:凍結輸入現在連判定都進不了(當時判得了)——讀側行為變了")
            elif rc != want.get("rc") or sorted(out.get("fails", [])) != sorted(want.get("fails", [])):
                red.append(f"邏輯漂移:同一份凍結輸入重算判定不同——當時 rc={want.get('rc')}"
                           f" fails={want.get('fails')},現在 rc={rc} fails={out.get('fails')}")
    if red:
        for r in red:
            print(f"⛔ {r}")
        return 1
    print(f"✓ 回放一致:{loop_id} 輪 {g.get('round')} 同輸入同判定,凍結帳與卷證完好")
    return 0


def cmd_loop_rewrite(env, loop_id, successor, note):
    """人裁「整份重寫」的收尾記帳(設計審收斂重定義 d3 帳面件的寫入端;2026-08-25 第一次真實
    rewrite 事件時補建)。寫 gate=design-loop kind=rewrite 事件到治理帳,note 機械帶血緣
    (prev=舊編號;successor=新編號)——「連續兩次判重寫→強制攤人,不得三開」靠沿 note 鏈查,
    本指令寫入前自動查一跳:若本編號自己就是某次 rewrite 的 successor,印強制攤人警告(advisory)。"""
    if not successor or successor.strip() == loop_id.strip():
        print("擋下:--successor 要給新開的迴圈編號,而且不能跟舊編號一樣——重寫=換新編號載新版,同號沒有「重寫」可言", file=sys.stderr)
        return 2
    # 血緣一跳查詢:這個編號是不是已經是上一次重寫的產物?
    chain_prev = None
    try:
        import json as _j
        import re as _re
        gl = env.vault.parent / ".governance-log.jsonl"
        # 邊界比對:successor=<id> 後面必須是分號或字串結尾——裸子字串會讓前綴編號互撞
        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
        if gl.exists():
            for line in gl.read_text(encoding="utf-8").splitlines():
                try:
                    o = _j.loads(line)
                except ValueError:
                    continue
                if not isinstance(o, dict):
                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
                        and _pat.search(str(o.get("note", ""))):
                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
    except OSError:
        pass
    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
    if chain_prev:
        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
    print("  之後查血緣:")
    print("    lumos gov --stats")
    return 0


def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
                ref=None, nodes=None, extra=None):
    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。

    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。

    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
    逐 ref 的事件另外帶那一行真正的 sha。

    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
    """
    import json as _json
    import datetime as _dt
    root = Path(repo_root)
    docs = root / "docs"
    if not docs.is_dir():
        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
        return None
    if not head_sha:
        try:
            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
        except Exception:
            head_sha = ""
    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
    if gate not in _KNOWN_GATES:
        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
              file=sys.stderr)
        return False
    ev = {
        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "commit": (head_sha or "")[:7],
        "gate": gate, "kind": kind, "hard": bool(hard),
        "nodes": list(nodes or []), "note": note,
        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
        "detail": note,
    }
    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
    if att:
        ev["attempt_id"] = att[:64]
    if ref:
        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
        # 「目前不算功能性錯誤——新事件本來就不該被當成 marker」。
        # ★那句話講的是一個保護,不是一個不一致★——我第一次折的時候把它當成欄名不一致、
        # 順手加了 branch 別名,結果 blocked 事件當場被 _codeloop_read_from_ledger
        # 當成留痕讀走,既有測試翻紅。欄名對齊只做 note/detail 那一半,分支識別不對齊。
        ev["ref"] = ref
    if head_sha:
        ev["head_sha"] = head_sha
    if extra:
        ev.update(extra)
    try:
        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
        return True
    except OSError:
        return False


def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
    ok = _gate_event(repo_root, gate, kind, note, **kw)
    if ok is None:
        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
    if not ok:
        print(f"  ⚠ telemetry-write-failed:{gate} 這一筆帳寫不進去(判定不受影響,照原樣執行)",
              file=sys.stderr)
    return ok


def _sp_run_text(cmd):
    import subprocess as _sp
    return _sp.run(cmd, capture_output=True, text=True, errors="replace").stdout.strip()


def _append_governance_log(vault, events):
    """寫者=doctor --ci + anchor approve:把 gate findings append 到 docs/.governance-log.jsonl。
    非 git / 取不到 HEAD → 跳過(不報錯)。dedup 留給讀時(lumos gov)。"""
    if not events:
        return
    import json
    import datetime
    import subprocess
    try:
        commit = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
                                capture_output=True, text=True, errors="replace", cwd=str(vault)).stdout.strip()
    except Exception:
        commit = ""
    if not commit:
        return
    ts = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    path = vault.parent / ".governance-log.jsonl"
    try:
        with open(path, "a", encoding="utf-8") as f:
            for e in events:
                f.write(json.dumps({"ts": ts, "commit": commit, **e}, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _read_touched_list(path):
    """讀「這次推送改到哪些檔」的清單(一行一個)。沒給=None(代表不收窄、照舊全擋)。

    ★讀不到也回 None,不是回空集合★:空集合的意思是「這次什麼都沒碰到」,會讓整段靜音;
    檔案打不開是我們自己的問題,不該因此少擋一條(必要合約清單_計劃〈擋的範圍〉)。
    """
    if not path:
        return None
    try:
        lines = Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    return {ln.strip() for ln in lines if ln.strip()}


def run_doctor(env: Env, strict: bool, color: bool, suggest=False, ci=False, verbose=False, touched=None):
    C = {k: (v if color else "") for k, v in
    early = _clause_structure_verdict(P, clauses, undef)
    if early:
        return early
    lines_all = text.splitlines()
    out = []
    if grammar:
        bad = _clauses_grammar_bad(clauses, lines_all)
        if bad:
            out.append(f"{P} ✗ — {len(bad)} 條格式看不懂(不算條款):" + "、".join(f"{b['id']}(第 {b['line']} 行:{why})" for b, why in bad))
            out.append("    一條文法:觸發子句?(當/在/若啟用/若 … ,)主體 應 回應;一條一個觸發;句首是停用詞(當然/在此…)就當無條件型")
            return "fail", out
    unt = [b for b in clauses if b["state"] == "untagged"]
    summ = _clause_summary(clauses)
    hang = sum(summ[_st] for _st in _CLAUSE_HANG_STATES) + summ["bad-name"]
    tail_u = f";另有 {len(undef)} 個 id 只在範例/引用裡出現,不算條款" if undef else ""
    if unt:
        out.append(f"{P} ✗ — {len(unt)}/{len(clauses)} 條驗收條款沒標:" + "、".join(f"{b['id']}(第 {b['line']} 行)" for b in unt) + tail_u)
        out.append("    每條要嘛在那一行綁 [test:測試名],要嘛寫 [manual:一句怎麼驗];沒有測試可掛也得講清楚靠人怎麼驗")
        fw = [b for b in unt if re.search(r"\[manual：", lines_all[b["line"] - 1] if 0 < b["line"] <= len(lines_all) else "")]
        if fw:
            out.append("    看到 `[manual：` 用了全形冒號(" + "、".join(b["id"] for b in fw) + "),改成半形 `[manual:` 才認得")
        return "fail", out
    if door == "low":
        tw = _clause_check_twoway(P, clauses)
        if tw:
            return "fail", out + tw
    if grammar and door != "low":
        rb_lines = _rollback_check_lines(text, P)
        if rb_lines:
            return "fail", out + rb_lines
    out.append(f"{P} ✓ — {len(clauses)} 條全標(綁了 {summ['bound']}/靠人 {summ['manual']}"
               + (f";懸空 {hang} 只提醒不擋,spec-trace 會唸" if hang else "") + (";句式與回退節已驗" if grammar else ";句式未驗(首筆帳早於句式閘上線,不回溯)") + tail_u + ")")
    return "ok", out

_SECURITY_SEAT_SINCE = "2026-09-12T00:00:00+08:00"   # 處置閘「資安席」一步只看首筆帳在這之後的迴圈——不回溯,理由同上一行(Projects/代碼審資安席_計劃 [S3])。
# 設隔日不設當日(同 _SEV_WRITESIDE_CUTOFF 的理由:合入當天白天用舊碼寫的帳,日粒度切不開先後);比對走 _loop_ts_key 換算 UTC(r1 單reviewer:字串比日期會依記帳機器時區判不同)。


def clause_bindings(text, split, default, methods_for, hay_for):
    """計劃正文的 [SN] 條款 × 同一行的 [test:]/[manual:](條款綁測試算進度 [S1];唯讀、純函式)。
    定義行=該 id 第一次出現在行首的那一行(去 - * # > 數字. | 粗體符號),從沒在行首出現過的 id=非定義(undefined,不算條款)——
    「見 [S2]」這種行內引用不算定義;★反引號/圍欄裡的內容不看,未閉合反引號之後不信;HTML 註解不特別處理(裡面的 [SN] 走認不得→擋)★(r2 單reviewer blocker:同一行「真條款 + `[S9] 範例`」曾讓閘 FAIL)。
    配對範圍=同一行、定義的 [SN] 之後到行尾(一行一條;後面再出現的 [SN] 是引用,不切段)
    (r1 通才席:SPEC_CLAUSE_RE/TEST_REF_RE 都是全文正則沒有行邊界,不同實作者會各自猜)。
    狀態七種(r1 接手席/通才席:四態不是三態、懸空要分「寫錯」與「設定認不到」,後者不進量測分母):
      untagged 未標 / manual 靠人 / bound 綁了(全部 ref 都是真測試)/ dangling 寫錯(方法集合與檔案都沒有)/
      unrecognized 設定認不到(檔裡有 `def 名(` 但 test.method_regex 不收,例:class 內的 test_…)/
      mentioned 只被提到(檔裡有這個字串但不是 def)/ bad-name 平台前綴未定義(resolve 拒絕,不猜)。
    分類沿用 _classify_one(不開第二套引擎;r1 簡化席開碼確認),只在它答 fake/dangling 時多做一步分辨。
    同一行同時有 [test:] 與 [manual:] → 以 [test:] 為準(靠人只在沒測試時成立)。回 list[dict] 依 id 排序。"""
    defined, fallback, dup, listlike_extra = {}, {}, {}, {}
    # ★哪些字看得見=沿用全檔唯一那兩份實作★:_visible_lines(行層級:fence、跨行註解)+ _strip_inline_markup(行內:註解、反引號 span、未閉合反引號之後不信)。
    for no, raw in _visible_lines(text.split("\n"), keep_fenced=False):
        line, truncated = _strip_inline_markup(raw)
        ms = list(SPEC_CLAUSE_RE.finditer(line))
        if truncated:
            # 未閉合反引號截掉的那一段裡若有 [SN] → 認不得就擋,不放行(-b r2/r3 兩席三次:`[S1]、`x [S2]、- [S1] 甲 `x [S2] 都曾讓條款消失)
            seen = {int(m.group(1)) for m in ms}
            for m in SPEC_CLAUSE_RE.finditer(raw):
                if int(m.group(1)) not in seen:
                    listlike_extra.setdefault(int(m.group(1)), []).append(no)
        if not ms:
            continue
        lead = _CLAUSE_LEAD_RE.match(line)
        if lead is not None:
            cid = int(lead.group(1))
            seg = line[ms[0].end():]          # 一行一條:這一行 [SN] 之後全部是它的(後面再出現的 [SN] 是引用,不切段)
            if cid in defined:
                dup.setdefault(cid, []).append(no)   # 同編號在兩行都寫成定義 → 重複(r3 外家席:第二筆沒標會漏過)
            else:
                defined[cid] = (no, seg)
            for m in ms[1:]:
                fallback.setdefault(int(m.group(1)), (no, "", False))          # 定義行後面的 [SN]=引用,絕不像清單
        else:
            for i, m in enumerate(ms):
                cid = int(m.group(1))
                # 「像清單項卻認不得的前綴」只看這一行★第一個★ [SN](後面的是引用);-b r1 自踩:曾拿整行去判,把「詳見 [S2]」判成像清單
                ll = i == 0 and bool(_CLAUSE_LISTLIKE_RE.match(line))
                if ll:
                    listlike_extra.setdefault(cid, []).append(no)   # 不管這個編號有沒有在別處合法定義,都要擋(-b r2 外家席:被既有定義遮掉而放行)
                fallback.setdefault(cid, (no, line[m.end():], ll))
    out = []
    for cid in sorted(set(defined) | set(fallback) | set(listlike_extra)):
        if cid not in defined:   # 只在範例/引用/行內出現過、從沒在行首定義 → 不是條款(r1 單reviewer blocker:純示範文字曾讓閘 FAIL)
            no, seg, listlike = fallback.get(cid) or (listlike_extra[cid][0], "", True)
            out.append({"id": f"S{cid}", "line": no, "refs": [], "manual": [], "defined": False, "state": "undefined",
                        "listlike": listlike or cid in listlike_extra, "listlike_lines": listlike_extra.get(cid, [])})
            continue
        if cid in listlike_extra:   # 合法定義過,卻又出現在像清單的認不得的行(或反引號前綴的行)→ 自己的狀態,擋(-b r3 架構席:別跟真重複共用一個名)
            out.append({"id": f"S{cid}", "line": defined[cid][0], "refs": [], "manual": [], "defined": True, "state": "shadowed",
                        "dup_lines": [defined[cid][0]] + listlike_extra[cid]})
            continue
        if cid in dup:
            out.append({"id": f"S{cid}", "line": defined[cid][0], "refs": [], "manual": [], "defined": True, "state": "duplicate",
                        "dup_lines": [defined[cid][0]] + dup[cid]})
            continue
        no, seg = defined[cid]
        refs = invariant_test_refs(seg)
        manual = [x.strip() for x in MANUAL_REF_RE.findall(seg)
                  if len(x.strip()) >= _MANUAL_MIN_CHARS and re.search(r"[^\W_]", x)]   # ≥4 字且至少一個實字(四個標點不算「講了怎麼驗」)
        row = {"id": f"S{cid}", "line": no, "refs": refs, "manual": manual, "defined": True}
        if not refs:
            row["state"] = "manual" if manual else "untagged"   # [manual: ] 空的或太短=沒講怎麼驗=未標(外家席 major 2)
            out.append(row)
            continue
        if _classify_one(seg, split, default, methods_for, hay_for) == "real":
            row["state"] = "bound"
            out.append(row)
            continue
        # 不是全真:逐 ref 分辨(只看不真的那幾個;取最壞:壞名 > 寫錯 > 設定認不到 > 只被提到)
        try:
            pairs = resolve_test_refs(seg, split, default)
        except ValueError:
            row["state"] = "bad-name"
            out.append(row)
            continue
        worst = 0
        for pl, n in pairs:
            if n in methods_for(pl):
                continue
            hay = hay_for(pl) or ""
            if re.search(r"^\s*def\s+" + re.escape(n) + r"\s*\(", hay, re.M):
                worst = max(worst, 1)          # unrecognized
            elif n in hay:
                pass                           # mentioned(最輕,worst 預設 0)
            else:
                worst = max(worst, 2)          # dangling
        row["state"] = {0: "mentioned", 1: "unrecognized", 2: "dangling"}[worst]
        out.append(row)
    return out


def _clause_bindings_for(env, text, root=None):
    """cmd_spec_trace / cmd_handoff / 處置閘共用:用 vault 反推的 repo 根建平台索引(★不用 cwd★,同 gov --stats 教訓),
    回 (rows, err)。索引建不起來(設定壞)回 ([], 一句原因),呼叫端印出來、不炸查詢。"""
    try:
        # 顯式 root(呼叫端已照 --repo 覆蓋規則算好)贏,env 反推只是預設——跟 _loop_status_disposal 其餘四步同一條優先序
        # (r1 架構席/單reviewer 都抓到我寫反了:git-less 部署副本裡 .git 不在,反推會落錯根)
        rr = Path(root) if root else _vault_repo_root(env)
        _, split, default, methods_for, hay_for, _loose = _platform_test_index(rr)
        return clause_bindings(text, split, default, methods_for, hay_for), None
    except (ValueError, OSError) as e:
        return [], f"{e.__class__.__name__}: {e}"


def _clause_summary(rows):
    c = {k: 0 for k in _CLAUSE_STATE_ZH}   # 含 undefined 桶;呼叫端多半先濾掉再算
    for r in rows:
        c[r["state"]] += 1
    return c


def _regress_sources(env, plan_rel):
    """相依回歸(規格落成可驗收條件_計劃 S15-S17;Enzo 2026-09-17 裁):計劃 lands_in 與 DEP/related 裡的 Systems 節點(一跳),
    抓它們合約行(★INVARIANT★/★CHECKPOINT★/★IRREVERSIBLE★)綁的 [test:] → 機器產的回歸條款,作者不能挑。
    回 (bound[(節點, 合約摘要, refs 文字)], unbound[(節點, 合約摘要)])。"""
    note = env.notes.get(plan_rel)
    if note is None:
        return [], []
    bound, unbound = [], []
    for lk in _plan_system_links(note):
        n = env.notes.get(lk + ".md") or env.notes.get(lk)
        sm = n.fields.get("summary") if n is not None else None
        if not isinstance(sm, str):
            continue
        for reftext in _contract_texts(sm):
            clean, refs = strip_test_refs(reftext)
            snippet = clean[:40] + ("…" if len(clean) > 40 else "")
            (bound if refs else unbound).append((lk, snippet, reftext) if refs else (lk, snippet))
    return bound, unbound


def _plan_system_links(note, text=None, systems_only=True):
    """計劃連到的節點(lands_in + related + DEP 行的 [[連結]];給了 text 再加正文全部 [[連結]]),去重、保序。
    ★全檔唯一的「計劃連到誰」★:相依回歸(預設:只 Systems、不掃正文)、門判定訊號 2 與推送前「誰的落點被碰到」
    (text 給正文、systems_only=False 收全部節點)都走這裡——代碼審 r1 架構席:別再開第二支平行函式,兩套算法會各自漂。"""
    # 字串/清單都收(代碼審 r1);[[…]]/別名/錨點/引號一律交給既有 link_target(代碼審 r2/r3:別自己再刻一份剝括號)
    links = [link_target(x) for x in as_list(note.fields.get("lands_in")) + as_list(note.fields.get("related"))] if note is not None else []
    summ = note.fields.get("summary") if note is not None else None
    if isinstance(summ, str):
        for ln in summ.split("\n"):
            if ln.strip().startswith("DEP:"):
                links += re.findall(r"\[\[([^\]|#]+)", ln)
    if text:   # 正文只看可見行、剝行內程式碼(代碼審 r2:圍欄裡示範語法的 [[連結]] 不是真連結,會把合格的風險低打成風險高)
        for _no, ln in _visible_lines(text.splitlines()):
            links += [link_target(m) for m in WIKILINK_RE.findall(_strip_inline_markup(ln)[0])]
    out, seen = [], set()
    for lk in links:
        lk = str(lk).strip()
        if lk and (lk.startswith("Systems/") or not systems_only) and lk not in seen:
            seen.add(lk)
            out.append(lk)
    return out


def _contract_texts(summary):
    """摘要區塊裡的合約行(★INVARIANT★/★CHECKPOINT★/★IRREVERSIBLE★)正文,含 [test:] 標記。"""
    return [m.group(1).strip() for _s, m in _contract_key_matches(summary)]


def _loop_first_ts_key(env, loop_id):
    """審查帳裡這條迴圈的首筆帳(UTC 可比的鍵);沒有帳回 None。"""
    ledger = env.vault.parent / ".canary-log.jsonl"
    best = None
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if not isinstance(d, dict) or nfc(str(d.get("loop", ""))) != nfc(loop_id) or not d.get("ts"):
                continue
            k = _loop_ts_key(str(d["ts"]))
            if k is not None and (best is None or k < best):
                best = k
    return best


def _spec_gate_clause_part(env, text, rel, rr, door=None):
    """①②:句式(按首筆帳決定驗不驗)+綁定+回退節(風險高);有結論回 (rc, rows),要繼續跑回 (None, rows)。door 傳給檢查器(風險低加嚴、零條款擋)。"""
    loop_id = _loop_id_for_plan(rel)
    first = _loop_first_ts_key(env, loop_id) if loop_id else None
    grammar = first is None or first >= _loop_ts_key(_SPEC_GATE_SINCE)
    if not grammar:
        print(f"[spec-gate] 句式: —(迴圈「{loop_id}」首筆帳早於 {_SPEC_GATE_SINCE[:10]},不回溯;綁定照驗)")
    if not SPEC_CLAUSE_RE.search(text):
        if door == "low":
            print("[spec-gate] 條款綁定: ✗ — 風險低零條款一律擋(空集合會放行一份什麼都沒驗的計劃);寫成 `- [S1] 當…,主體應… [test:測試名]`")
            return 1, []
        print("[spec-gate] 條款綁定: —(計劃無 [SN] 條款,沒有東西可驗;寫成 `- [S1] 當…,主體應… [test:測試名]` 才進閘)")
        return 0, []
    rows_b, err = _clause_bindings_for(env, text, root=rr)
    if err:
        print(f"[spec-gate] 條款綁定: ✗ — 測試索引建不起來({err}),驗不了≠通過")
        return 1, []
    status, lines = _clause_check(text, rows_b, grammar=grammar, tag="spec-gate", door=door)
    for ln in lines:
        print(ln)
    if status == "fail":
        return 1, rows_b
    if status == "skip":
        return 0, rows_b
    return None, rows_b


def _spec_gate_load(env, node):
    """找計劃檔、讀文字;回 (Path, text, vault 相對路徑) 或 (None, 錯誤訊息, None)。"""
    rel = env.find(node)   # 跟 spec-trace 與其他吃節點名的指令同一條路(代碼審 r1:短名叫不到、退回手拼漏了 Projects/)
    if not rel:
        _node_not_found(env, node)
        return None, "", None
    p = env.vault / rel
    try:
        text = p.read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as e:
        print(f"擋下:計劃讀不成文字({e.__class__.__name__}):\n    {p}", file=sys.stderr)
        return None, "", None
    return p, text, rel


def _spec_gate_declared(method, methods):
    """程式裡真的宣告了幾支「名字對得上這個篩選字串」的測試。算不出來回 None。

    ★餵進來的要是「刻意放寬」的那份宣告集★(代碼審 r1 blocker):正規那份錨在欄位 0,
    try:
        with open(log, "a", encoding="utf-8") as fh:
            _rec = {"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                    "node": rel, "by": by or "", "note": note, "commit": commit}
            # ★可選的 ref★(必要合約清單_計劃):讓閘能機械比對「這次簽的是哪一個東西」,
            # 不必去自由文字裡撈 id(撈文字最容易寫錯也最容易漏)。沒帶就不寫,既有紀錄與用法不受影響。
            if (ref or "").strip():
                _rec["ref"] = ref.strip()
            fh.write(json.dumps(_rec, ensure_ascii=False) + "\n")
    except OSError as ex:
        print(f"擋下:簽核記錄寫不進去: {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "signed_off", today)
    if rc != 0:
        print("⚠ ledger 已記但 frontmatter 戳記失敗(見上)", file=sys.stderr)
        return rc
    print(f"✓ signoff {rel} — {today}{('(' + by + ')') if by else ''}: {note[:60]}")
    return 0


# ★gov --stats 的 gate 全集★(2026-08-20,計劃:Projects/閘觸發帳統計_計劃)
# 為什麼要有這張表:統計若只「掃帳裡出現過的 gate」,零筆的 gate 永遠不會出現——而「哪幾道
# 閘從沒響過」正是這個功能的重點。漂移由 t_gov_stats_gate_drift 機械擋(掃全檔 gate 字面值)。
# L3(驗證腐化佇列)2026-08-22 拆出:寫帳的 hook 8/21 已撤,留在清單只是假名額(Issues/只退場不痛的機制)
_KNOWN_GATES = ("L2", "anchor-approve", "canary", "check-cascade", "check-revisit", "check-e1", "delguard", "check-e2", "check-e3", "check-lint-decl", "doctor-run",
                "check-j", "check-k", "check-r", "check-s", "check-s2", "check-s3", "check-s4",
                # 2026-09-10 節點範圍與索引守衛:條款測試名懸空 / 索引漏列 / 合約多到讀不完
                "check-s5", "check-s6", "check-s7", "ci", "code-loop", "design-loop", "kill", "signoff", "bound-tests",
                "daily-wrapper", "ledger-growth",
                # #19 S1:擋人/放行/被跳過的事件會用到這兩個閘名(code-loop 已在上面)
                "anchor", "pitfalls",
                # 2026-09-17 逃逸自動記 fail-open 失敗留痕(escape-auto-failed)與規格閘每次跑的觀測行(spec-gate-run)
                "escape-auto", "spec-gate",
                # 2026-09-11 每支檔有家:提交前/推送前的檢查、健檢三段(沒家的檔/寫了別人的檔名/管太多沒寫負責範圍)
                "nodehome-check", "check-s8", "check-s9", "check-s10",
                # 2026-09-13 新增告警閘:環境不可用自動放行、擋下新增告警,兩種事件都用這個閘名
                "lint-new",
                # 2026-09-12 推筆記認家:健檢新段(重建出來卻不管檔的節點 / 管了卻連檔名都沒提到的配對)
                "check-s11")

# 未出現清單旁的限制聲明。★單一常數★——測試比對此常數,不在測試裡複製字串
# (逐字重複的斷言等於沒斷言)。另有一條斷言釘它含哪幾個子句,防被掏空只留殼。
_STATS_ABSENT_DISCLAIMER = (
    "  未出現 ≠ 無用。本帳看不到硬擋事件(anchor verify 擋下 push 時不寫任何帳),也分不出四種\n"
    "  「沒出現」:跑了沒事／接了帳但沒被觸發／守的功能從沒被用過／本次執行根本沒載入該來源\n"
    "  (ci 帳是條件載入)。要拿這份清單談退場,先確認該閘在本帳的 gate 名單之內、且來源本次有載入。"
)


# 哪些 gate 的 nodes 欄語意不是「圖譜節點」。★為什麼要標★:anchor-approve 記的是錨點
# 檔案(ANCHOR_FILES:scripts/hooks/pre-push、scripts/test_lumos.py …),與其他 gate 的圖譜
# 節點名不同質,同欄並列會被誤讀成可互相比較。★不能用「值裡有沒有 /」偵測★——cmd_gov 的
# mapper 讀進來時已把路徑 stem 成 pre-push,偵測不到(2026-08-20 實作時測試翻紅抓到)。
_STATS_NODE_SEMANTICS = {"anchor-approve": "此來源記的是檔案路徑", "design-loop": "此來源記的是審查編號", "bound-tests": "no-config/no-pins 也記一筆,採用率看得見", "nodehome-check": "此來源記的是程式檔路徑(另有 pairs 欄記被擋的檔與節點配對)"}


def _render_gov_stats(rows, ded, loaded, since_days, cutoff, node, repo_root, escapes=None):
    """gov --stats:純數字報表 + 未出現清單。恆不影響 rc、不改既有輸出。
    repo_root=hook 事件檔所在的 repo 根,由呼叫端從 vault 反推(_vault_repo_root),必填、漏傳直接炸(r1 架構席:鄰居慣例不給預設);★不准用 cwd 的 git 根★——
    2026-09-08 實踩:測試用假 vault 時讀到真 repo 的事件檔,平行推送閘期間 hook 一直在追加,同一支測試兩次呼叫統計段就不同。
    ★三層數字不可互相冒充★:原始行(帳檔寫入)/去重列(本函式計數依據)/呈現行(預設畫面另折一層)。"""
    print()
    print("─" * 33)
    print(f"[stats] 載入源(這次實際讀了哪些帳): {', '.join(loaded) if loaded else '(無)'}")
    print(f"[stats] 窗口: 近 {since_days} 天(從 {cutoff} 起算)")
    if node:
        print(f"[stats] 提醒:已縮限到 {node} 這一篇,以下數字只看它,不是全庫")
    if not ded and not rows:
        print("  窗口內無資料")
        return
    agg = {}
    for src, bucket in ((rows, "raw"), (ded, "ded")):
        for r in src:
            a = agg.setdefault(r["gate"], {"raw": 0, "ded": 0, "nodes": set(),
                                           "commits": set(), "dates": set()})
            a[bucket] += 1
            if bucket == "ded":
                a["nodes"].update(n for n in r["nodes"] if n)
                if r["commit"]:
                    a["commits"].add(r["commit"])
                d = (r["ts"] or "")[:10]
                if len(d) == 10 and d[4] == "-":
                    a["dates"].add(d)
    print()
    print(f"  {'gate':16}{'去重後筆數':>10}{'原始行數':>10}{'不同 nodes 值數':>16}"
          f"{'不同 commit 數':>14}  {'首見日':10} {'末見日':10}")
    for g in sorted(agg):
        a = agg[g]
        nd = f"n/a" if not a["nodes"] else str(len(a["nodes"]))
        cm = "n/a" if not a["commits"] else str(len(a["commits"]))
        d1 = min(a["dates"]) if a["dates"] else "n/a"
        d2 = max(a["dates"]) if a["dates"] else "n/a"
        _sem = _STATS_NODE_SEMANTICS.get(g)
        tag = f"  ({_sem})" if (_sem and a["nodes"]) else ""
        print(f"  {g:16}{a['ded']:>10}{a['raw']:>10}{nd:>16}{cm:>14}  {d1:10} {d2:10}{tag}")
    absent = [g for g in _KNOWN_GATES if g not in agg]
    print()
    if node:
        print("  (只看單一節點時,有些帳本來就不記節點、一定是零,所以不列「哪些閘從沒出現」)")
    else:
        print(f"  這段時間完全沒觸發過的閘({len(absent)} 道):{', '.join(absent) if absent else '無'}")
        print(_STATS_ABSENT_DISCLAIMER)
    print()
    # 流程自產工作量(Issues/流程自產工作量未量測):處置帳裡標了 finding_kinds 的輪,算 code/spec/process 佔比
    fk = {"code": 0, "spec": 0, "process": 0}; fk_rounds = 0
    for r in rows:
        if r.get("gate") == "canary" and isinstance(r.get("finding_kinds"), dict):
            fk_rounds += 1
            for v in r["finding_kinds"].values():
                if v in fk: fk[v] += 1
    tot = sum(fk.values())
    if tot:
        print(f"  發現在修什麼(只算有標 --finding-kind 的 {fk_rounds} 輪,共 {tot} 條):程式缺陷 {fk['code']}({fk['code']/tot:.0%})、被審文件缺陷 {fk['spec']}({fk['spec']/tot:.0%})、流程自己要求的文件/留痕 {fk['process']}({fk['process']/tot:.0%})")
        print("  (process 佔比就是「流程自產工作量」;2026-08-22 起才有標,之前的輪沒資料)")
        print()
    # 辯方明確表態分布(2026-08-27,Systems/finding-refute):agree/evidence/concern 三態計數。
    # evidence(辯方降級的)是 2026-08-22「辯方三分類先不做」裁定重啟條件的候選池——
    # 抽驗這批有沒有「降錯、後來證明 finding 是真的」,有實例才用證據翻案。
    rv = {"agree": 0, "evidence": 0, "concern": 0}; rv_rounds = 0
    for r in rows:
        if r.get("gate") == "canary" and isinstance(r.get("refute_verdicts"), dict):
            rv_rounds += 1
            for v in r["refute_verdicts"].values():
                if v in rv: rv[v] += 1
    rvt = sum(rv.values())
    if rvt:
        print(f"  辯方怎麼表態(只算有標 --refute-verdict 的 {rv_rounds} 輪,共 {rvt} 條):同意是真的 {rv['agree']}、拿反證降級 {rv['evidence']}、只存疑無反證 {rv['concern']}")
        print("  (降級那批 evidence 是重啟條件的候選:回頭抽驗有沒有『降錯、後來證明是真的』;2026-08-27 起才有標)")
        print()
    # ── 表態閘副產品(Projects/棧別提問表態閘_計劃 S9,2026-09-09):按題目 id 彙總歷來四值;死題候選/觸發太窄候選 ──
    _dq, _rm = {}, {}
    for r in rows:
        if r.get("gate") != "code-loop":
            continue
        if r.get("kind") == "dispositions" and isinstance(r.get("dispositions"), dict):
            for _qid, _ent in r["dispositions"].items():
                if not isinstance(_ent, dict):
                    continue
                _b = _dq.setdefault(_qid, {"satisfied": 0, "na": 0, "todo": 0, "tension": 0, "auto-na": 0, "cand": 0, "cand-tension": 0})
                if _ent.get("auto"):
                    _b["auto-na"] += 1
                elif _ent.get("status") in ("satisfied", "na", "todo", "tension"):
                    _b[_ent["status"]] += 1
                # 候選張力(2026-09-09 兩席相反時端出張力):樣板帶的 hint 隨表態存進帳,這裡就是 REVISIT 的分母
                if _ent.get("hint") and not _ent.get("auto"):
                    _b["cand"] += 1
                    if _ent.get("status") == "tension":
                        _b["cand-tension"] += 1
        elif r.get("kind") == "recall-miss" and r.get("recall_miss"):
            _rm[r["recall_miss"]] = _rm.get(r["recall_miss"], 0) + 1
    if _dq or _rm:
        print("  棧別提問表態(表態閘,2026-09-09 起;每筆表態事件每題算一次,同 sha 重表態各算各的):")
        for _qid in sorted(_dq):
            _b = _dq[_qid]; _human = _b["satisfied"] + _b["na"] + _b["todo"] + _b["tension"]   # 分母含張力(r1 接手席 H4:8 na + 5 tension 不是死題)
            _tag = " ← 死題候選(人答 ≥10 次且全是不適用:題目不對或被敷衍,回頭裁刪題或加嚴)" if (_human >= 10 and _b["na"] == _human) else ""
            _cand = f"、候選題 {_b['cand']}(其中答 tension {_b['cand-tension']})" if _b["cand"] else ""
            print(f"    {_qid}:做到了 {_b['satisfied']}、不適用 {_b['na']}、待辦 {_b['todo']}、未觸發自動 {_b['auto-na']}、張力 {_b['tension']}{_cand}{_tag}")
        for _qid, _n in sorted(_rm.items()):
            print(f"    {_qid}:審查席抓到未觸發題的問題 {_n} 次" + (" ← 觸發太窄候選(修它的 when)" if _n >= 3 else "(累積 3 次列候選)"))
        print()
    # ── 審查有沒有用(審查有沒有用記帳 S3,2026-09-08):只算有 reported 欄的輪(2026-09-09 起才有) ──
    _by_round = {}
    for r in rows:
        if r.get("gate") == "canary" and r.get("loop") and r.get("round"):
            _by_round.setdefault((r["loop"], r["round"]), []).append(r)
    _ys = {k: _review_yield_round(v) for k, v in _by_round.items()}
    _ys = {k: y for k, y in _ys.items() if y["N"] is not None}
    _K = len(_ys)
    _rej = [r for r in ded if r.get("gate") == "canary" and r.get("kind") == "blocked"]   # kind=blocked 跟 anchor/code-loop「這次動作被擋」同字(r1 架構席 a3)
    if _K or escapes or _rej:   # 只有「被擋」沒有「記成」也要印(r1 f2):不然撞牆三次、一輪都沒補記=這段整個不見,正好是留 blocked 事件要防的盲點
        print("  審查有沒有用(只算有 reported 欄的 %d 輪,2026-09-09 起;人記的帳跟上面『閘的動作』那段可信度不同級,不要拿這裡的數字去算那裡的比率)" % _K)
        print("  (N 是機器從報告數的、R 是人填的;這段內部也不印比率、別自己算 Σ折/Σ報 當『審查有用率』)")
        if _K:
            _sum = lambda key: sum(y[key] for y in _ys.values() if y[key] is not None)
            _n_carrier = sum(1 for y in _ys.values() if y["has_carrier"])
            _n_r_known = sum(1 for y in _ys.values() if y["R"] is not None)
            _n_r_nonzero = sum(1 for y in _ys.values() if y["R"])
            _n_s_pos = sum(1 for y in _ys.values() if y["S"])
            print(f"    Σ席位報 {_sum('N')} → Σ存活 {_sum('M')} / Σ編排者重現不到 {_sum('R')} → Σ折 {_sum('F')} / Σ放行 {_sum('A')};存活多於席位報的輪 {_n_s_pos}(共 Σ{_sum('S')} 條)")
            print(f"    給回頭條件的兩個數:有載體的 {_n_carrier} 輪裡記了 refuted-set 的 {_n_r_known} 輪、其中非 0 的 {_n_r_nonzero} 輪;S>0 的輪 {_n_s_pos}")
            _recent = sum(1 for (lp, rd), v in _by_round.items() if (lp, rd) in _ys and any(str(x.get("ts", "")) >= cutoff for x in v))
            if _K < 5 or _recent < 3:
                print(f"    樣本太少,別下結論(K={_K},窗口內 {_recent} 輪;門檻 5/3 是暫用值)")
        if escapes is not None:
            _worst = max((e.get("severity", "minor") for e in escapes), key=lambda s: _SEV_ORDER.get(s, 0), default=None)
            print(f"    逃逸帳 {len(escapes)} 筆(審查放行後下游抓到的;最重 {_worst or '—'};歸因是人工判斷)")
        if _rej:
            _d = lambda r: str(r.get("detail", "") or r.get("note", ""))
            _rn = sum(1 for r in _rej if "report-not-normalized" in _d(r))
            _rf = sum(1 for r in _rej if "findings-over-reported" in _d(r))
            print(f"    記帳被寫側擋下 {len(_rej)} 次(報告沒正規化 {_rn} / 缺 refuted-set {len(_rej) - _rn - _rf} / findings 多於 reported {_rf});擋下後有沒有補記,對照上面 K 看")
        print()
    # 設計迴圈結案方式(工具鏈補強十件 #6):達上限卻從沒過關的審查編號 = 人裁放行。
    # 只看 gate=design-loop 的事件(2026-08-22 起才記;之前的迴圈沒帳,算不出來,這裡如實講)。
    dl = [r for r in ded if r.get("gate") == "design-loop"]
    if dl:
        by = {}
        for r in dl:
            for nd_ in (r.get("nodes") or []):
                by.setdefault(nd_, set()).add(r.get("kind"))
        conv = sum(1 for k in by.values() if "converged" in k)
        capped = sum(1 for k in by.values() if "cap-reached" in k and "converged" not in k and "rewrite" not in k)
        rewrote = sum(1 for k in by.values() if "rewrite" in k and "converged" not in k)
        print(f"  審查迴圈結案方式(只算有記帳的 {len(by)} 個編號):閘過了 {conv} 個、跑滿上限沒過關(人裁放行) {capped} 個、人裁判整份重寫收尾 {rewrote} 個"
              + (f"——人裁放行率 {capped / len(by):.0%}" if by else ""))
        print("  (2026-08-22 起 loop next / loop status 才會記這個帳;更早的迴圈沒資料,不在分母)")
        print()
    # ── 閘的硬擋 / 放行 / 被跳過(#19 S1-S3)────────────────────────────────
    # ★每一種新事件都要指名一個讀它的地方★——這裡就是那個地方。
    # 沒有消費者的帳只是更大的垃圾場;而這批新增的三種事件的消費者就是這一段。
    hard = [r for r in ded if r.get("kind") == "blocked"]
    skipped = [r for r in ded if str(r.get("kind", "")).startswith("skipped")]
    fo = [r for r in ded if r.get("kind") == "fail-open"]
    if hard or skipped or fo:
        print("  閘的動作(#19 起才有帳;更早的擋下與放行沒有紀錄,不在分母):")
        if hard:
            _by = {}
            for r in hard:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    硬擋 %d 次:%s" % (len(hard), "、".join(f"{k} {v}" for k, v in sorted(_by.items()))))
        if skipped:
            _by = {}
            for r in skipped:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    被跳過 %d 次:%s" % (len(skipped), "、".join(f"{k} {v}" for k, v in sorted(_by.items())))
                  + "  ← ★這一行是「哪一道最常被跳」的答案★")
        if fo:
            _by = {}
            for r in fo:
                _by[r.get("gate", "?")] = _by.get(r.get("gate", "?"), 0) + 1
            print("    檢查自己壞掉而放行(fail-open)%d 次:%s" % (len(fo), "、".join(f"{k} {v}" for k, v in sorted(_by.items()))))
            print("    (fail-open 是刻意設計——不為缺環境擋死推送;但每一次放行都要看得見,不然分不出哪一層沒生效)")
        print()

    # ── hook 最近有沒有真的跑過(#19 S4)────────────────────────────────────
    # ★次數放這裡,不放 enforcement 那張表★(r1 架構對齊席):那張是「當下狀態」,
    # 次數與時間序列是另一種性質的資料,這個 repo 已經有這一段在做聚合。
    # ★不印「注入 N 次」★——那是成效,派工鏡頭 d1 明令不量;這裡只講「活著沒」。
    _hp = Path(repo_root) / "governance" / "runtime" / "hook-events.jsonl"
    if _hp.exists():
        import json as _hj
        import datetime as _hd
        _cut = _hd.datetime.now().astimezone() - _hd.timedelta(days=since_days)
        _agg = {}
        for _ln in _hp.read_text(encoding="utf-8", errors="replace").splitlines():
            if not _ln.strip():
                continue
            try:
                _e = _hj.loads(_ln)
                _t = _hd.datetime.fromisoformat(str(_e.get("ts", "")))
            except ValueError:
                continue
            if _t.tzinfo is None or _t < _cut:
                continue
            _a = _agg.setdefault(_e.get("hook", "?"), {"ok": 0, "timeout": 0, "error": 0})
            if _e.get("kind") in _a:
                _a[_e["kind"]] += 1
        if _agg:
            print(f"  hook 近 {since_days} 天真的跑過幾次(成功 / 逾時 / 失敗):")
            for _k in sorted(_agg):
                _v = _agg[_k]
                print(f"    {_k}: 成功 {_v['ok']} / 逾時 {_v['timeout']} / 失敗 {_v['error']}")
            print("    (只有『成功跑完』算跑過;逾時與失敗分開列——在進入點記帳的做法會把它們算成生效)")
            print()
    print("  註:這張表是「去重後」的筆數,跟不加 --stats 的畫面行數不是同一套算法——預設畫面還會再折疊一次。")


def _render_gov_nags(ded, min_days):
    """機制空轉偵測(Issues/自足性審計提醒空轉四十六天 的出口,2026-08-22):
    同一道軟閘對同一篇筆記,從第一次提醒到最後一次提醒跨 ≥ min_days 天,而且最後一次提醒就在最近一次
    doctor 體檢那天(=還在喊、沒人理)。有就列出並回 rc1(給自主迴圈週報當訊號),沒有 rc0。
    只看 kind=warned 的軟閘;硬擋的本來就擋得住人,不會空轉。"""
    import datetime as _dt
    runs = [r["ts"] for r in ded if r.get("gate") == "doctor-run"]
    last_run = max(runs) if runs else None          # 完整時間戳:同一天處理完再體檢,要能當場消失
    span = {}   # (gate,node) -> [first_ts,last_ts,count]
    for r in ded:
        if r.get("kind") != "warned" or r.get("hard"):
            continue
        for nd in r.get("nodes") or []:
            k = (r["gate"], nd)
            t = r["ts"]
            if k not in span:
                span[k] = [t, t, 1]
            else:
                span[k][0] = min(span[k][0], t); span[k][1] = max(span[k][1], t); span[k][2] += 1
    - code-loop 那組:nodes 永遠空,只能從自由文字 detail 認編號——所以要先知道有哪些編號
      (known_loops,從審查帳來),再看 detail 裡有沒有出現。★啟發式,失效偏保守★。
    """
    import json, re as _re
    path = env.vault.parent / ".governance-log.jsonl"
    stamps, bad = {}, 0
    if not path.exists():
        return stamps, bad
    # 長的編號先比,免得 code-audit-batch4 吃掉 code-audit-batch4b 的 detail
    ordered = sorted((l for l in known_loops if l), key=len, reverse=True)
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            bad += 1
            continue
        # ★合法 JSON 但不是物件(例如一行 []、null、42)也要跳過★(2026-09-07 代碼審 r1 外家席):
        # 第一版只接 json.loads 的 ValueError,接著就 d.get(),這三種會拋 AttributeError 讓整支炸掉,
        # 違反自己承諾的「壞行跳過」。測試也只餵語法壞掉的行,沒餵這種。
        if not isinstance(d, dict):
            bad += 1
            continue
        gk = (d.get("gate"), d.get("kind"))
        ts = d.get("ts") or ""
        if gk in LOOP_CLOSE_EVENTS:
            for n in (d.get("nodes") or []):
                if isinstance(n, str) and _loop_ts_newer(ts, stamps.get(n, "")):
                    stamps[n] = ts
        elif gk in LOOP_CLOSE_EVENTS_BY_DETAIL and ordered:
            detail = d.get("detail") or ""
            for lid in ordered:
                if _re.search(r"(?<![\w-])" + _re.escape(lid) + r"(?![\w-])", detail):
                    if _loop_ts_newer(ts, stamps.get(lid, "")):
                        stamps[lid] = ts
                    break
    return stamps, bad


def cmd_loop_list(env, days=14, show_all=False, stale_only=False, as_json=False, now=None,
                  exclude=None):
    """帳面上還開著的審查迴圈。開著=沒有關門事件,或關門後又記了新的審查輪次。

    ★誠實界線★:設計審那組的關門事件慣例 %s 才開始,更早的迴圈天生沒有這筆
    (code-loop 那組早得多,最早 2026-07-05)——所以「沒關門」只等於「帳面沒看到關門事件」,
    不等於「沒做完」。code-loop 那組還多一層:它的編號只在自由文字裡,認法是啟發式,
    認不到就報成沒關門(偏保守)。唯讀恆 rc0(比照 canary-stats);
    壞行跳過但出聲(不靜默,也不 fail-closed——這是查詢不是閘)。""" % LOOP_CLOSE_SINCE
    import json, datetime
    path = env.vault.parent / ".canary-log.jsonl"
    per = {}
    bad = 0
    if path.exists():
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if not isinstance(d, dict):      # 合法 JSON 但不是物件(見 _loop_close_stamps 的說明)
                bad += 1
                continue
            lid = d.get("loop")
            if not isinstance(lid, str) or not lid:
                continue
            e = per.setdefault(lid, {"loop": lid, "last_ts": "", "rounds": set(), "records": 0,
                                     "last_severity": None, "tier": None, "orchestrator": None})
            e["records"] += 1
            ts = d.get("ts") or ""
            if not _loop_ts_newer(e["last_ts"], ts):   # ts >= last_ts(時區安全)
                e["last_ts"] = ts
                e["last_severity"] = d.get("severity")
            if d.get("round"):
                e["rounds"].add(d["round"])
            else:
                e["roundless"] = e.get("roundless", 0) + 1
            e["tier"] = e["tier"] or d.get("tier")
            e["orchestrator"] = e["orchestrator"] or d.get("orchestrator")
    closed, gbad = _loop_close_stamps(env, known_loops=per.keys())
    bad += gbad
    if now:
        try:
            today = datetime.date.fromisoformat(now)
        except ValueError:
            print("擋下:--now 要給 YYYY-MM-DD 這種格式的日期,你給的是 %r" % now, file=sys.stderr)
            print("  為什麼在意:這個值決定「幾天沒動」怎麼算,猜錯會把還在跑的迴圈報成空轉。", file=sys.stderr)
            print("  正確用法(不帶就是今天):", file=sys.stderr)
            print("      lumos loop list --now 2026-09-07", file=sys.stderr)
            return 2
    else:
        today = datetime.date.today()

    def _idle(ts):
        try:
            return (today - datetime.date.fromisoformat(ts[:10])).days
        except ValueError:
            return None

    rows = []
    for e in per.values():
        cts = closed.get(e["loop"], "")
        # ★輪數在「有的帶輪次、有的不帶」時不吐精確數字★(2026-09-07 代碼審 r1,兩席獨立指出):
        # 第一版是「有 round 就數相異值,全沒有才數筆數」,於是 3 筆裡只有 1 筆帶 r1 會顯示「1 輪」
        # ——比實際少、而且看起來像剛開始。同一份帳餵給 loop next / loop status 都是 rc2 擋下並說
        # 「分不出哪輪是判定輪」。這支是唯讀查詢不該擋,但也不該假裝算得準:混用就回 None。
        _mixed = bool(e["rounds"]) and e.get("roundless")
        rows.append({"loop": e["loop"], "last_ts": e["last_ts"], "idle_days": _idle(e["last_ts"]),
                     "rounds": None if _mixed else (len(e["rounds"]) or e["records"]),
                     "rounds_mixed": bool(_mixed), "last_severity": e["last_severity"],
                     "tier": e["tier"], "orchestrator": e["orchestrator"],
                     "closed_ts": cts or None,
                     "open": _loop_reopened(e["last_ts"], cts)})
    # 排除前綴:自主迴圈的每日場次(auto-YYYY-MM-DD)天生不會有關門事件、一天長一個,
    # 不排掉的話這份清單遲早被它們淹掉。★不寫死任何前綴★——要排什麼由呼叫端說。
    n_excluded = 0
    if exclude and any((x or "") == "" for x in exclude):
        # ★空前綴等於排除全部★(2026-09-07 代碼審 r1,兩席獨立指出):任何字串都以空字串開頭,
        # 於是 --exclude "" 會把清單清空,而人讀模式印出來的是「還沒關門的有 0 個」
        # ——跟「真的全部結案了」長得一模一樣。這支工具存在的理由就是不要讓人漏看還開著的迴圈,
        # 一個常見的手滑(組指令時某項是空的)會造成方向完全相反的靜默假全清。擋下,不猜。
        print("擋下:--exclude 不能給空字串——任何編號都以空字串開頭,那會把整份清單排空,",
              file=sys.stderr)
        print("      而印出來會跟「真的全部結案了」長得一樣。要排什麼就寫什麼,例如:", file=sys.stderr)
        print("      lumos loop list --exclude auto-", file=sys.stderr)
        return 2
    if exclude:
        keep = [r for r in rows if not any(r["loop"].startswith(x) for x in exclude)]
        n_excluded = len(rows) - len(keep)
        rows = keep
    rows.sort(key=lambda r: (_loop_ts_key(r["last_ts"]) or float("-inf"), r["last_ts"]), reverse=True)
    fresh = [r for r in rows if r["open"] and (r["idle_days"] is None or r["idle_days"] <= days)]
    stale = [r for r in rows if r["open"] and r["idle_days"] is not None and r["idle_days"] > days]
    done = [r for r in rows if not r["open"]]
    if bad:
        print("提醒:審查帳/治理帳有 %d 行讀不動,已跳過。" % bad, file=sys.stderr)
        print("  為什麼在意:讀不動的那幾行如果是關門事件,這份清單會把已經結案的迴圈報成還開著。", file=sys.stderr)
        print("  想知道是哪幾行:", file=sys.stderr)
        print("      git diff HEAD~1 -- docs/.canary-log.jsonl docs/.governance-log.jsonl", file=sys.stderr)
    if as_json:
        print(json.dumps({"now": today.isoformat(), "days": days, "open": fresh,
                          "stale": stale, "closed": done}, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("審查帳裡還沒有任何迴圈。開第一輪:")
        print("    lumos loop next <編號> --tier standard --orchestrator claude --spec <計劃.md>")
        return 0

    def _line(r):
        idle = "?" if r["idle_days"] is None else "%d 天前" % r["idle_days"]
        sev = r["last_severity"] or "—"
        rnd = "混用?" if r.get("rounds_mixed") else "%2d 輪" % r["rounds"]
        return "  %-8s %-5s  最後一筆 %-7s  %s" % (idle, rnd, sev, r["loop"])

    if stale_only:
        print("審查迴圈:超過 %d 天沒動、帳面又沒關門的有 %d 個(空轉候選)" % (days, len(stale)))
        for r in stale:
            print(_line(r))
    else:
        print("審查迴圈:帳面上還沒關門的有 %d 個(最近 %d 天有動)" % (len(fresh), days))
        for r in fresh:
            print(_line(r))
        if show_all:
            print()
            print("已關門的 %d 個:" % len(done))
            for r in done:
                print("  %s  關於 %s" % (r["loop"], (r["closed_ts"] or "")[:10]))
    print()
    print("沒關門「不等於」沒做完——關門事件(治理帳裡的放行紀錄)這個慣例 %s 才開始," % LOOP_CLOSE_SINCE)
    print("更早的迴圈天生沒有這一筆;這裡只說「帳面沒看到關門事件」。")
    if not stale_only and stale:
        print("另有 %d 個超過 %d 天沒動也沒關門(空轉候選),看它們:" % (len(stale), days))
        print("    lumos loop list --stale")
    if n_excluded:
        print("(依 --exclude 略過 %d 個編號)" % n_excluded)
    print()
    print("要接哪一個,先問它下一步:")
    print("    lumos loop next <編號> --spec <計劃.md>")
    return 0


def cmd_loop_canary_stats(env, loop_id=None):
    """[d4 承諾的讀取面,2026-08-05] 跨輪 canary 累積帳彙總——寫入面(record note/caught/missed)
    T1-T7 落地後一直只能人翻 JSONL,正是「機制蓋好在等一個記得用它的人」病(全流程體檢命名)。
    席位×caught/missed×尾端連續 missed streak;streak≥2 印升級提示(「連 2 missed 升 opus」
    規則的機械眼——原靠編排者記得)。純唯讀觀測恆 rc0;壞行跳過並註記(不進任何 gate)。"""
    import json
    from collections import OrderedDict
    path = env.vault.parent / ".canary-log.jsonl"
    if not path.exists():
        print("⏳ 無 canary 帳")
        return 0
    per_loop = OrderedDict()   # loop -> OrderedDict(auditor -> {"caught":n,"missed":n,"streak":n})
    none_per_loop = {}         # loop -> n(kind=none 輪;停用制計數,不入 caught/missed 統計)
    overlap = {}               # loop -> {"counts":[int...合併], "badtype":n}(S3 重疊分布;讀全部 kind 含 none)
    n_bad = 0

    def _harvest_overlap(lp, d):
        # S3(2026-08-14,收斂閘殘餘估計降級 S3):跨輪分布合併(各輪母體獨立,彙總為分布統計非去重)。
        # 型別防禦(r1 邊界席 P7 實跑實證):非 list(如字串 "3,2,1")靜默進 _estimate 會算出假 0.0,
        # 必須計壞型明示跳過,不得靜默算。
        cc = d.get("capture_counts")
        if cc is None or not lp:
            return
        o = overlap.setdefault(lp, {"counts": [], "badtype": 0})
        ccl = _cc_ints(cc)   # r1 s2 F1:bool 是 int 子類,守衛統一在 _cc_ints 排除
        if ccl is not None:
            o["counts"].extend(ccl)
        else:
            o["badtype"] += 1
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                n_bad += 1
                continue
            lp = d.get("loop")
            kind = d.get("kind")
            _harvest_overlap(lp, d)
            # 協議停用(2026-08-14 d5):kind=none 不入 caught/missed 統計(無植入無此語意),
            # 但要計數——否則停用制 loop 在這裡回報「無記錄」,誤讀成什麼都沒發生
            # (2026-08-14 終審 F1:本報表是文檔點名的「升級提示機械眼」,不可靜默瞎掉)。
            if kind == "none" and lp:
                none_per_loop[lp] = none_per_loop.get(lp, 0) + 1
                continue
            if not lp or kind not in ("caught", "missed"):
                continue
            aud = d.get("auditor") or "(無席名)"
            seats = per_loop.setdefault(lp, OrderedDict())
            st = seats.setdefault(aud, {"caught": 0, "missed": 0, "streak": 0})
            st[kind] += 1
            st["streak"] = st["streak"] + 1 if kind == "missed" else 0   # 尾端連續 missed(append 序)
    except OSError as e:
        print(f"擋下:審查記錄檔讀不到({e}),沒有它算不出下一步。先確認檔案在不在、有沒有讀取權限:\n    {path}", file=sys.stderr)
        return 2
    def _print_overlap(lp):
        # S3 席位重疊分布(跨輪分布合併;席名=auditor 欄原文、鏡頭層不在帳內——誠實界線)
        o = overlap.get(lp)
        bad = f";另有 {o['badtype']} 筆重疊數據格式不對(壞型,不是整數清單),已跳過不計" if o and o["badtype"] else ""
        if not o or not o["counts"]:
            reason = "數據全部格式不對(壞型),沒得算" if (o and o["badtype"]) else "這個審查編號的記錄沒帶重疊數據 capture_counts"
            print(f"  重疊分布: 無重疊數據({reason}){bad}")
            return
        cs = o["counts"]
        f1 = sum(1 for c in cs if c == 1)
        print(f"  重疊分布(跨輪分布合併,非同一母體去重): 相異缺陷 {len(cs)} | 僅單席抓到 "
              f"{f1}/{len(cs)}({round(100 * f1 / len(cs))}%){bad}")

    targets = [loop_id] if loop_id else list(per_loop)
    if loop_id and loop_id not in per_loop:
        if none_per_loop.get(loop_id):
            print(f"ℹ [{loop_id}] 停用制 loop:{none_per_loop[loop_id]} 輪 kind=none(無植入;"
                  "canary-stats 僅回放歷史 caught/missed 帳,升級訊號改看 quote-check——d5)")
            _print_overlap(loop_id)   # r1 整合席 P5:重疊段不得被 none-only 提前返回吃掉
        else:
            print(f"⏳ 無記錄({loop_id} 目前一筆記錄都還沒有)")
        return 0
    for lp in targets:
        seats = per_loop[lp]
        tc = sum(v["caught"] for v in seats.values())
        tm = sum(v["missed"] for v in seats.values())
        rate = f"{tc}/{tc+tm}" if (tc + tm) else "0/0"
        nn = none_per_loop.get(lp, 0)
        print(f"[{lp}] caught {rate}(missed {tm})"
              + (f"  +{nn} 輪 none(停用制,不入統計)" if nn else ""))
        if loop_id:
            for aud, v in seats.items():
                tail = f"  尾端連續missed={v['streak']}" if v["streak"] else ""
                esc = "  ⚠ 連 2 missed → 升級模型(升 opus)" if v["streak"] >= 2 else ""
                print(f"  {aud}\tcaught {v['caught']}\tmissed {v['missed']}{tail}{esc}")
            _print_overlap(lp)   # S3:指定 loop 查詢時附重疊分布
    # D 前置:型別×探針×caught 表(帶 canary_type 的記錄才入列;attr 攢滿 15 筆=D 本體開工條件)
    # S2 回溯層(2026-08-06,plan:驗證層自證三件):型別來源如實分層——attr(結構化欄位)/
    # note(散文 type=X regex fallback,慣例寫法覆蓋率有限)/unknown(無任何線索,不硬猜)。
    # 覆蓋率即時計算(該 plan r2 折入:寫死數字會被自己的新記錄打臉);D 案 15 筆條件只認 attr。
    import re as _re
    typed = {}
    n_attr = n_note = n_unknown = 0
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("kind") not in ("caught", "missed"):
                continue
            if loop_id and d.get("loop") != loop_id:
                continue
            ct = d.get("canary_type")
            if ct:
                n_attr += 1
                key = (ct, d.get("probe") or "-", "attr")
            else:
                m = _re.search(r"type=([a-d])\b", d.get("note") or "")
                if m:
                    n_note += 1
                    key = (m.group(1), "-", "note")
                else:
                    n_unknown += 1
                    continue
            t = typed.setdefault(key, {"caught": 0, "missed": 0})
            t[d["kind"]] += 1
    except OSError:
        pass
    if typed or n_unknown:
        total = n_attr + n_note + n_unknown
        print(f"  ── 型別×探針×caught(attr {n_attr} / note {n_note} / unknown {n_unknown} / 總 {total};"
              f"attr 攢滿 15 筆=D 案開工條件)──")
        for (ct, pb, src), v in sorted(typed.items()):
            print(f"  {ct}\tprobe={pb}\tsrc={src}\tcaught {v['caught']}\tmissed {v['missed']}")
        if n_unknown:
            print(f"  (unknown {n_unknown} 筆無型別線索,不併入任何型別——如實分層,不硬猜)")
    if n_bad:
        print(f"  (帳面 {n_bad} 行不可解析,已跳過——壞行只影響觀測完整性,不進 gate)")
    print("  ★觀測非閘:caught 只證席位醒著,不證審得夠廣(caught≠覆蓋);missed 席 findings 不作廢(d4)★")
    return 0


def cmd_loop_verify_progress(env, loop_id, settle=None, as_json=False):
    """[S3] 獨立進度驗證器(結清式收斂_計劃,2026-07-28):看不到被審材料的覆核原語——
    直讀 .canary-log.jsonl(+選配 settle 清單檔),**只吃結構欄位**(kind/severity/findings/
    auditor 存在性/hash 存在性),note/--clusters 理由字串一律丟棄(LoopTrap 散文注入面隔離)。
    fail-closed:壞行/kind 缺失=rc2。誠實天花板:結構欄位≠客觀真值(findings/severity 源頭仍是
    LLM 裁決、帳由被驗方寫)——隔離的是散文注入,不是帳本自報。輸出=結構 JSON/純事實行,
    供編排者對照自己的收斂認知,非 oracle。"""
    import json
    path = env.vault.parent / ".canary-log.jsonl"
    rounds = []
    try:
        if path.exists():
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    print("擋下:審查記錄檔有讀不懂的行,輪次順序不可信,整個檔先不信"
                          "(修好或搬走壞行再重跑)", file=sys.stderr)
                    return 2
                if d.get("loop") == loop_id and d.get("kind") != "spec-gate":   # 規格閘留痕不是審查輪(雙向門放行_計劃 S16):不計席、不判無效
                    rounds.append(d)
    except OSError as e:
        print(f"擋下:檔案讀不到({e}): {path}", file=sys.stderr)
        return 2
    for i, r in enumerate(rounds, 1):
        if not isinstance(r.get("kind"), str):
            print(f"擋下:審查記錄第 {i} 筆少了 kind 欄位(抓到/漏掉/無植入),缺欄位就不信整份", file=sys.stderr)
            return 2
    def caught_ok(r):
        # none=協議停用制無植入輪(2026-08-14 d5),與 caught 同計合格輪
        return r.get("kind") in ("caught", "none") and bool(r.get("auditor"))
    streak = 0
    for r in reversed(rounds):
        if caught_ok(r) and r.get("severity") in ("clean", "minor"):
            streak += 1
        else:
            break
    out = {
        "loop": loop_id,
        "rounds": len(rounds),
        "kinds": [r.get("kind") for r in rounds],
        "clean_streak": streak,
        "findings_trend": [r.get("findings") for r in rounds],
        "last": ({"kind": rounds[-1].get("kind"), "severity": rounds[-1].get("severity"),
                  "has_result_hash": "result_sha256" in rounds[-1]} if rounds else None),
    }
    if settle is not None:
        try:
            data = json.loads(Path(settle).read_text(encoding="utf-8-sig"))
            entries = data["entries"]
            assert isinstance(entries, list) and entries
        except (OSError, ValueError, KeyError, AssertionError) as e:
            print(f"擋下:結清清單檔讀不到或格式不對: {e}", file=sys.stderr)
            return 2
        def is_caught_round(n):
            return isinstance(n, int) and 1 <= n <= len(rounds) and caught_ok(rounds[n - 1])
        unsettled = 0
        for e in entries:
            status = e.get("status")
            if status == "llm-ok" and not is_caught_round(e.get("verified_in_round")):
                status = "unverified"
            if status == "unverified" or (e.get("kind") == "semantic" and status != "llm-ok"):
                unsettled += 1
        out["settle"] = {"total": len(entries), "unsettled": unsettled,
                         "settled": len(entries) - unsettled}
    if as_json:
        print(json.dumps(out, ensure_ascii=False, indent=1, sort_keys=True))
    else:
        print(f"[verify-progress] loop={loop_id} rounds={out['rounds']} clean_streak={out['clean_streak']}")
        print(f"  kinds={out['kinds']} findings={out['findings_trend']}")
        if out["last"]:
            print(f"  last={out['last']}")
        if "settle" in out:
            print(f"  settle={out['settle']}")
    return 0


def _loop_status_settle(rounds, n_badlines, loop_id, settle_path, spec, repo, env=None):
    """settle 收斂閘([S1] 結清式收斂_計劃,2026-07-28):清單全結清 ∧ G1 refcheck ∧ G3(末筆 result=現檔)。
    K-streak/G2 由「逐條存在證明」取代(G2 印 advisory 不進合取)。
    caught 輪定義收緊:kind=caught ∧ auditor 非空;否則視同 missed(貶值 llm-ok)。
    fail-closed 族:log 壞行=rc2(及於整個共用檔——壞行無法歸屬 loop);清單檔不可讀/格式非法/
    零條目/llm-ok 缺 verified_in_round=rc2;懸空輪/非 caught 輪的 llm-ok=貶值視同未結清。
    清單檔=JSON {"entries":[{id,kind:mech|semantic,claim,status,verified_in_round?,spec_sha}]}
    (零依賴家規:JSON 非 YAML——stdlib 可解)。"""
    import json
    if n_badlines:
        print(f"擋下:審查記錄檔有 {n_badlines} 行讀不懂;輪次是照行序算的,壞行會讓後面全部歪掉,"
              "所以整個檔先不信。修好或搬走壞的那幾行再重跑", file=sys.stderr)
        return 2
    try:
        data = json.loads(Path(settle_path).read_text(encoding="utf-8-sig"))
    except OSError as e:
        print(f"擋下:--settle 指的清單檔讀不到({e}):\n    {settle_path}", file=sys.stderr)
        return 2
    except ValueError as e:
        print(f"擋下:--settle 清單檔不是合法的 JSON: {e}", file=sys.stderr)
        return 2
    entries = data.get("entries") if isinstance(data, dict) else None
    if not isinstance(entries, list) or not entries:
        print("擋下:清單要長成 {\"entries\":[...]} 而且至少一條;零條目的「全部收尾」等於什麼都沒證明,不收",
              file=sys.stderr)
        return 2
    for i, e in enumerate(entries, 1):
        if not isinstance(e, dict) or not all(k in e for k in ("id", "kind", "status", "spec_sha")):
            print(f"擋下:清單第 {i} 條少了必填欄位(id/kind/status/spec_sha 都要有)", file=sys.stderr)
            return 2
        if e["kind"] not in ("mech", "semantic") or e["status"] not in ("unverified", "mech-ok", "llm-ok"):
            print(f"擋下:清單條目 {e.get('id')} 的 kind 或 status 填了不認得的值(kind 只能是 mech 或 semantic,"
                  "status 只能是 unverified / mech-ok / llm-ok)", file=sys.stderr)
            return 2
        if e["status"] == "llm-ok" and not isinstance(e.get("verified_in_round"), int):
            print(f"擋下:清單條目 {e.get('id')} 標了 llm-ok 卻沒寫是第幾輪驗的(verified_in_round),不寫就等於沒人背書",
                  file=sys.stderr)
            return 2
    repo_root = _anchor_repo_root(repo)
    if repo_root is None:
        return 2
    try:
        cur_sha = _sha256_file(spec)
        text = Path(spec).read_text(encoding="utf-8-sig")
    except OSError as e:
        print(f"擋下:--spec 指的文件讀不到({e}),確認路徑對不對:\n    {spec}", file=sys.stderr)
        return 2
    fails = []
    # caught 輪(收緊定義):kind=caught|none ∧ auditor 非空;輪鍵=append 序(1-based)
    # (none=協議停用制無植入輪,2026-08-14 d5)
    def is_caught_round(n):
        if not (1 <= n <= len(rounds)):
            return False   # 懸空輪 fail-closed
        r = rounds[n - 1]
        return r.get("kind") in ("caught", "none") and bool(r.get("auditor"))
    unsettled = []
    for e in entries:
        status = e["status"]
        why = None
        if status == "llm-ok" and not is_caught_round(e["verified_in_round"]):
            status, why = "unverified", f"貶值(第 {e['verified_in_round']} 輪非 caught/懸空/空席)"
        if e["spec_sha"] != cur_sha:
            why = "spec_sha 過期(spec 已改版,重拆或確認重蓋)"
        elif status == "unverified" or (e["kind"] == "semantic" and status != "llm-ok"):
            why = why or ("語意條停 " + status + "(須 llm-ok 才結清)" if status != "unverified" else "未查證")
        if why:
            unsettled.append((e["id"], why))
    if unsettled:
        print(f"[settle] 清單全結清: ✗ — {len(entries)} 條裡還有 {len(unsettled)} 條沒收尾")
        for eid, why in unsettled:
            print(f"    {eid}: {why}")
        fails.append("清單未結清")
    else:
        print(f"[settle] 清單全結清: ✓ — {len(entries)} 條全部收尾了")
    claims, n_missing, n_oor, _n_ok = _refcheck_scan(text, repo_root)
    bad = [c for c in claims if c["status"] in ("missing", "line_out_of_range")]
    if bad:
        print(f"[settle] G1 文件裡的檔案/行號引用對不對: ✗ — 有 {len(bad)} 條對不上真正的程式碼")
        fails.append("G1")
    else:
        print(f"[settle] G1 文件裡的檔案/行號引用對不對: ✓ — {len(claims)} 條全部對得上")
    last = rounds[-1] if rounds else None
    if last is None:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✗ — 一筆記錄都沒有")
        fails.append("G3")
    elif last.get("result_sha256") != cur_sha:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✗ — 對不上(文件在最後一輪審完之後又改過了,請重審一輪)")
        fails.append("G3")
    else:
        print("[settle] G3 最後一筆記錄的文件指紋對不對得上現在的文件: ✓")
    fs = [r.get("findings") for r in rounds[-3:]]
    print(f"[settle] G2(僅供參考,不影響過不過)各輪問題數: {fs}")
    for i, r in enumerate(rounds, 1):
        print(f"{i}\t{r.get('kind', '?')}\t{r.get('severity', '-')}\t{r.get('ts', '')}\t{r.get('note', '')}")
    if fails:
        print(f"⛔ SETTLE GATE FAIL({loop_id} 沒通過,卡在:{'/'.join(fails)})")
        return 1
    print(f"✅ SETTLE GATE PASS({loop_id} 通過:清單全收尾、引用對得上、文件沒被事後改過)")
    _loop_gov_mark(env, loop_id, "converged", "gate PASS")
    return 0


def _esc_clean(v, limit=200):
    """逃逸帳顯示消毒(code-escape r1 B-1/B-2):控制字元(含換行/ESC)換空格——
    --list 的「一行一筆」是攔截/逃逸週報 grep 的載重合約,使用者可控的 desc 不得打穿;
    ANSI 逃逸碼進終端=帳本可信度風險。截斷防超長刷版。"""
    out = "".join(ch if ch >= " " and ch != "\x7f" else " " for ch in str(v))
    return out if len(out) <= limit else out[:limit] + "…"



def _git_head(repo_root):
    try:
        r = subprocess.run(["git", "-C", str(repo_root), "rev-parse", "HEAD"], capture_output=True, text=True, errors="replace")
        return r.stdout.strip() if r.returncode == 0 else ""
    except OSError:
        return ""


def _plans_in_range(repo_root, git_range, vault):
    """提交範圍碰到的計劃筆記(repo 相對路徑)。對回啟發式:碰到 Projects/*.md 就算。"""
    try:
        # ★中文檔名:git 預設把非 ASCII 路徑加引號並轉義,不關掉會一個計劃都對不上(taskbank 同型坑 2026-09-15)★
        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return []
    if r.returncode != 0:
        return []
    try:
        vrel = str(Path(vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
    except ValueError:
        return []
    out = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith(vrel + "/Projects/") and line.endswith(".md"):
            out.append(line)
    return out


def _loop_id_for_plan(plan_rel):
    """計劃檔名 → 迴圈編號:去 _計劃(design-loop skill 的慣例)。"""
    stem = Path(plan_rel).stem
    return stem[:-len("_計劃")] if stem.endswith("_計劃") else stem


def _plan_for_loop(env, loop_id):
    """迴圈編號 → 計劃筆記(vault 相對);找不到回 None。"""
    for cand in (f"{loop_id}_計劃.md", f"{loop_id}.md"):
        if (env.vault / "Projects" / cand).is_file():
            return f"Projects/{cand}"
    return None


def _door_for_loop(env, loop_id):
    """規格閘留痕裡這條迴圈最後一次判的門;沒有就 unknown(規格閘上線前一律 unknown)。"""
    path = env.vault.parent / ".canary-log.jsonl"
    door = "unknown"
    if not path.exists():
        return door
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not ln.strip():
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("kind") == "spec-gate" and nfc(str(d.get("loop", ""))) == nfc(loop_id):
            door = _rec_plan_risk(d) if (d.get("plan_risk") or d.get("door")) else door
    return door


def _auto_escape(env, stage, severity, desc, loops, sha, source, extra=None):
    """逃逸自動記(規格落成可驗收條件_計劃 第五節):
    loops=[(迴圈編號, 計劃相對路徑或 None)]。歸因守衛放寬成「迴圈在審查帳 OR 計劃檔存在」——
    風險低不派審的計劃本來就不會出現在審查帳,只認審查帳會讓它們永遠記不到。
    去重鍵 (迴圈, 階段, sha)。回寫入筆數。不擋、不炸:任何一步失敗只印一行。"""
    log = env.vault.parent / ".escape-log.jsonl"
    ledger = env.vault.parent / ".canary-log.jsonl"
    known = set()
    if ledger.exists():
        for ln in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip():
                continue
            try:
                v = json.loads(ln).get("loop")
            except ValueError:
                continue
            if isinstance(v, str):
                known.add(nfc(v))
    import datetime as _dt
    import secrets as _sec
    written = 0
    # ★寫側上鎖(r1 回滾席):兩個 hook 同時寫,各自讀到「還沒包含對方那筆」的 existing,去重會被繞過;
    # 讀 existing→判→append 整段都要在同一把 vault 寫入鎖裡(跟 set/append 共用)。
    with _vault_write_lock(env.vault):
        existing = set()
        for r in _escape_rows_for(env):
            existing.add((nfc(str(r.get("loop", ""))), r.get("stage"), r.get("sha")))
        for loop_id, plan_rel in loops:
            plan_ok = bool(plan_rel) and _plan_file_exists(env, plan_rel)
            if nfc(loop_id) in known:
                attribution = "ledger"
            elif plan_ok:
                attribution = "plan-file"
            else:
                print(f"逃逸自動記:「{loop_id}」既不在審查帳、也沒有計劃檔,對不回,不記")
                continue
            door = _door_for_loop(env, loop_id)
            if stage == "push-gate-unreviewed" and door != "low":
                # 這一型的語意是「被判成風險低、跳過審查,結果推送閘擋下」;風險高計劃缺留痕是流程沒走完,不是逃逸
                print(f"逃逸自動記:「{loop_id}」沒有風險低留痕(計劃風險:{door}),缺審查留痕算流程沒走完,不記")
                continue
            if (nfc(loop_id), stage, sha) in existing:
                print(f"逃逸自動記:「{loop_id}」在 {stage} 同一個 sha 已經記過,不重複")
                continue
            rec = {"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "token": "ESC-" + _sec.token_hex(4),
                   "loop": loop_id, "stage": stage, "severity": severity, "desc": " ".join(desc.split()),
                   "auto": True, "source": source, "sha": sha, "attribution": attribution, "plan_risk": door}
            if plan_rel:
                rec["plan"] = plan_rel
            if extra:
                rec.update(extra)
            if _jsonl_append_verified(log, rec, "token", rec["token"]) == 0:
                written += 1
                existing.add((nfc(loop_id), stage, sha))
                print(f"✓ 逃逸自動入帳:「{loop_id}」在 {stage} 記到 {severity}(計劃風險:{rec['plan_risk']},歸因:{attribution})")
            else:
                _escape_auto_failed(env, loop_id, stage, "append 自驗失敗")
    return written


def _plan_file_exists(env, plan_rel):
    """計劃檔存在性,兩邊都做 NFC 再比(r1 邊界席:git 回的路徑與磁碟檔名的正規化形式可能不同)。"""
    if (env.vault / plan_rel).is_file():
        return True
    parent = (env.vault / plan_rel).parent
    if not parent.is_dir():
        return False
    want = nfc(Path(plan_rel).name)
    try:
        return any(nfc(q.name) == want for q in parent.iterdir())
    except OSError:
        return False


def _escape_auto_failed(env, loop_id, stage, why):
    """fail-open 的失敗要看得見(r1 回滾席):無人看顧時 stderr 等於消失,寫一筆進治理帳。"""
    try:
        _append_governance_log(env.vault, [{"gate": "escape-auto", "kind": "escape-auto-failed", "hard": False,
                                            "nodes": [str(loop_id)], "note": f"{stage}: {why}"}])
    except Exception:
        pass
    print(f"逃逸自動記失敗({stage}/{loop_id}): {why}", file=sys.stderr)


def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None):
    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
    整套審查系統的 ground truth 側;與攔截帳(★圖譜攔截★記號)互為兩面。
    append-only、不進任何閘;歸因是人工判斷(GIGO 同 cluster 歸併,計劃天花板明載)。
    ★歸因守衛的職責範圍(r1 外家 ESC-01 裁明)★:只防「編號打錯」(實存性),不驗迴圈
    收斂/放行狀態——那是語意判斷,歸人;守衛驗語意=偷渡閘,計劃明文不做。"""
    log = env.vault.parent / ".escape-log.jsonl"
    _SEV_W = {"minor": 0, "major": 1, "blocker": 2}
    if auto:
        # 自動模式(規格落成可驗收條件_計劃 第五節):給提交範圍,碰到的計劃筆記各記一筆;對不回就不記。
        if loop_id or list_mode:
            print("擋下:--auto 不吃迴圈編號也不能跟 --list 混用;編號由提交範圍碰到的計劃筆記推出來", file=sys.stderr)
            return 2
        if severity not in _SEV_W or not (stage or "").strip() or not (desc or "").strip():
            print("擋下:--auto 一樣要帶 --stage、--severity(minor|major|blocker)、--desc", file=sys.stderr)
            return 2
        if not git_range:
            print("擋下:--auto 要帶 --range <a..b>(推送/CI 的提交範圍),沒有範圍就對不回計劃", file=sys.stderr)
            return 2
        repo_root = Path(repo) if repo else env.vault.parent.parent
        plans = _plans_in_range(repo_root, git_range, env.vault)
        if not plans:
            print(f"逃逸自動記:範圍 {git_range} 對不回任何計劃筆記,不記(這不是錯,只是這次推送沒碰到計劃)")
            return 0
        vrel = str(Path(env.vault).resolve().relative_to(Path(repo_root).resolve())).replace(os.sep, "/")
        loops = [(_loop_id_for_plan(p), p[len(vrel) + 1:]) for p in plans]
        _auto_escape(env, stage.strip(), severity, desc, loops, sha or _git_head(repo_root), source=stage.strip())
        return 0
    if list_mode:
        if loop_id or stage or severity or desc or defect_ref:
            print("擋下:--list 是唯讀,不能跟記帳參數混用——照原樣執行你會以為記了、其實一筆都沒寫。要記帳就拿掉 --list 重跑", file=sys.stderr)
            return 2
        if not log.exists():
            print("逃逸帳是空的:還沒有任何一筆「迴圈放行後下游抓到可歸因缺陷」的紀錄。空≠零逃逸——也可能是沒人記;要記:")
            print("    lumos loop escape <迴圈編號> --stage <發現階段> --severity <minor|major|blocker> --desc <一句描述>")

