  5575	def _spec_gate_twoway_run_verdict(clauses, keeps, verdicts):
  5576	    """風險低的放行條件(跑完之後):沒標 keeps 的每一條各自紅(綠=沒做卻說做了、弱證據≠紅);標 keeps 的要綠。回沒過的清單。"""
  5577	    fails = []
  5578	    for b in clauses:
  5579	        if b["state"] == "manual":
  5580	            continue   # 靠人驗的沒有紅綠可判
  5581	        v = verdicts.get(b["id"])
  5582	        if v is None:
  5583	            fails.append(f"{b['id']}:沒跑到(綁的測試沒排進去)")
  5584	            continue
  5585	        verdict, why, method = v
  5586	        if b["id"] in keeps:
  5587	            if verdict != "green":
  5588	                fails.append(f"{b['id']} {method}:標了 keeps 卻不是綠的({'紅' if verdict == 'red' else why})——既有行為已經壞了,先修")
  5589	        elif verdict == "green":
  5590	            fails.append(f"{b['id']} {method}:綠——沒標 keeps 的是新行為,測試現在就該紅;真的是既有行為就標 [keeps]")
  5591	        elif verdict != "red":
  5592	            fails.append(f"{b['id']} {method}:{why}——弱證據不算紅")
  5593	    return fails
