  9404	def cmd_loop_escape(env, loop_id=None, stage=None, severity=None, desc=None,
  9405	                    defect_ref=None, list_mode=False, rule=None, auto=False, git_range=None, sha=None, repo=None):
  9406	    """逃逸帳原語(Projects/loop數據收集_計劃 M1②,2026-07-16 設計、2026-08-31 落地)。
  9407	    語意:某個審查迴圈收斂放行了,下游(實作/CI/prod/人)發現可歸因的缺陷→記一筆。
