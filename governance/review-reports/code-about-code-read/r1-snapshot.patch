+def note_body_hash(vault, rel):
+    """★正文雜湊:about_code 過期守衛的尺★(about-code-impl-std r2/r3,2026-08-24)。
+
+    回 frontmatter 之外正文(rstrip 後)的 sha256 前 12 碼;檔不存在/讀不到 → None。
+    為什麼是雜湊不是日期:三輪設計審實證「日期/commit 數」表達不了「標記在同日序列的哪一格」
+    (83 篇首日就誤判 2 篇),而守衛要答的只是「標記時看的正文跟現在一樣嗎」——直接比正文最老實。
+    ★必須 utf-8-sig★:BOM 檔否則 split_frontmatter 切不出 frontmatter、整檔算進雜湊,
+    「只改 frontmatter 不過期」就破(std-r3 arch+s1 兩席抓到)。無快取、無 git、無子行程。
+    """
+    import hashlib
+    try:
+        text = (Path(vault) / rel).read_text(encoding="utf-8-sig")
+    except Exception:
+        return None
+    _, body = split_frontmatter(text)
+    return hashlib.sha256(body.rstrip().encode("utf-8")).hexdigest()[:12]
+
+
+def _stamp_parts(stamp):
+    """about_code_stamp 三段 `<誰>/<日期>/<正文雜湊12碼>`;第三段非 12 碼 hex 視同沒有(舊格式)。"""
+    if not isinstance(stamp, str):
+        return None, None, None
+    parts = [x.strip() for x in stamp.split("/")]
+    who = parts[0] if len(parts) >= 1 else None
+    day = parts[1] if len(parts) >= 2 else None
+    h = parts[2] if len(parts) >= 3 else None
+    if h is not None and not (len(h) == 12 and all(c in "0123456789abcdef" for c in h)):
+        h = None
+    return who, day, h
+
+
+def about_code_expired(vault, rel, stamp):
+    """過期 = 現在正文雜湊 ≠ stamp 第三段(或沒有第三段/舊格式)。回 (expired: bool, now_hash, stamp_hash)。"""
+    _, _, sh = _stamp_parts(stamp)
+    nh = note_body_hash(vault, rel)
+    return (sh is None or nh is None or nh != sh), nh, sh
+
+
