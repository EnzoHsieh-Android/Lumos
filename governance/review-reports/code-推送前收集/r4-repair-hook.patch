diff --git a/scripts/hooks/pre-push b/scripts/hooks/pre-push
index 09e8de72..0ce67b78 100755
--- a/scripts/hooks/pre-push
+++ b/scripts/hooks/pre-push
@@ -293,21 +293,29 @@ impact_done() { [ -n "$_IMPACT_JSON" ] && rm -f "$_IMPACT_JSON"; _IMPACT_JSON=""
 # 本次推送所有暫存檔的家,離開時整個清(r1 併發席:逐檔 rm 在 exit 1 / Ctrl-C 那條路會漏)。
 # 建不出來就擋(r2 邊界席):空字串會讓後面每個 "$_PP_TMP/…" 變成根目錄路徑,測試 log 全寫不出來、擋下訊息一片空白。
 _PP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/lumos-prepush-XXXXXX" 2>/dev/null || true)"
 if [[ -z "$_PP_TMP" || ! -d "$_PP_TMP" ]]; then
   echo "擋下:推送前檢查需要一個暫存目錄,但 ${TMPDIR:-/tmp} 建不出來(不存在或不可寫);修好 TMPDIR 再推。" >&2
   exit 1
 fi
 # 陷阱拆開(計劃〈做法〉2):EXIT 收拾;INT/TERM 先收掉自己的背景工作再結束(結束時再走 EXIT 那支)。
 # 原本三個共用一支、裡面不結束:掛鉤自己被中斷時刪掉暫存目錄後照樣往下跑(/bin/bash 3.2.57 實測)。
 # bash 要等手上那支前景子程序結束才跑陷阱,所以「立刻」是指那支結束之後、不再開始下一道。
-_pp_kill_jobs() { local _j; _j="$(jobs -p 2>/dev/null)"; [[ -n "$_j" ]] && kill $_j 2>/dev/null; return 0; }
+# ★整組收★(代碼審 r3 併發席):全套測試的各片各自在一個行程群組裡(見下面 run_group),所以對每個工作先整組送 TERM
+# (連片自己起的子行程一起收);那個工作不是群組組長(跑測試的子殼、片剛起還沒換群組的那一瞬)就退回只送給它本人。
+# 群組號就是組長的 pid,組長活著時不會有別的群組用同一個號,所以整組送不會打到別人。
+_pp_kill_jobs() {
+  local _j _p
+  _j="$(jobs -p 2>/dev/null)"
+  for _p in $_j; do kill -TERM -- "-$_p" 2>/dev/null || kill -TERM "$_p" 2>/dev/null; done
+  return 0
+}
 trap 'impact_done; rm -rf "$_PP_TMP"' EXIT
 trap '_pp_kill_jobs; exit 130' INT
 trap '_pp_kill_jobs; exit 143' TERM
 # HUP 也接(代碼審 r2 併發席):ssh 或編輯器只對掛鉤送掛斷時,沒接的話掛鉤直接死、EXIT 照跑刪掉暫存目錄,
 # 跑測試的子殼與各片全部繼續跑(/bin/bash 3.2.57 實測 8 片全活著)。129 = 128 + SIGHUP。
 trap '_pp_kill_jobs; exit 129' HUP
 # (2026-09-11 起「該動哪篇」的點名改由每支檔有家照家算——下面 home check --diff 會印;原本這裡以反引號為種子的
 #  impact --sync-only 會把人推回寫了一堆別人檔名的大雜燴節點,拿掉。Projects/每支檔有家_計劃 [S15]。impact_once 留給合約測試閘用。)
 # ★合約測試閘:低風險也跑,紅了印出來記帳但不擋;高風險照舊擋★(人裁 2026-09-07)
 # 不選「低風險也擋」的理由:擋下去最可能的結果不是人去修測試,是人改走 --no-verify
@@ -796,37 +804,43 @@ if [[ -d "$REPO_ROOT/skills/lumos-project-notes" && -f "$REPO_ROOT/scripts/test_
   # light 的關鍵字子集跟文件子集一起分片、平行跑(r1 併發席:原本等分片收完才串行跑一趟);
   # 一支都沒對到(每片都 rc3)不擋,只把話講清楚:CI 會跑全套當後盾。有紅照擋。
   _keys_args=()
   if [[ "$_suite_mode" == "light" && -n "$_SUITE_KEYS" ]]; then
     _keys_args=(--suite keys --keys "$_SUITE_KEYS")
   elif [[ "$_suite_mode" == "light" ]]; then
     echo "  這次改動抽不出函式或檔名當關鍵字,推送前只跑文件子集;CI 會跑全套當後盾。" >&2
   fi
   _sdir="$_PP_TMP/shards"; mkdir -p "$_sdir"
   _rc=0; _krc_all3=1
+  # 換到自己的行程群組再 exec 成真正要跑的程式(argv[1:]);bash 3.2 沒有 setsid,macOS 也沒附 setsid 指令,這裡本來就有 Python
+  _PP_OWN_PGRP='import os, sys; os.setpgid(0, 0); os.execv(sys.argv[1], sys.argv[1:])'
   run_group() {   # $1=log 前綴,其餘=執行器參數;每片一個子行程,回傳 0=全綠、3=每片都選中 0 支、1=有紅
     local _pfx="$1"; shift
     local _pids=() _i _p _r _any3=0 _bad=0
     # ★各片是掛鉤的孫行程,要由這個子殼自己收★(代碼審 r1 併發席,/bin/bash 3.2.57 實測):掛鉤的 INT/TERM/HUP 陷阱只對 jobs -p 列出的
     # 直接子行程(這個子殼)送 TERM;而非互動 bash 用 & 起的背景命令忽略 SIGINT,Ctrl-C 對整個行程群組送的 INT 也殺不到各片。
     # 不收的話被砍或按 Ctrl-C 之後各片變孤兒繼續跑(最多八分鐘、佔 CPU、輸出寫進已刪的資料夾)。子殼收到 TERM 或 HUP 就把各片收掉再結束。
     # ★收片用同一支 _pp_kill_jobs(jobs -p),不要自己記 pid 收★(代碼審 r2 併發席、架構對齊席):子殼裡 jobs -p 列的就是它起的各片;
     # 自己記的話,「& 起片」與「記下 pid」是兩個敘述,訊號落在中間時剛起的那片不在清單上、漏收。下面的 _pids 只拿來 wait 收離開碼。
+    # ★每片各自一個行程群組(_PP_OWN_PGRP 先 setpgid 再 exec),收的時候整組收★(代碼審 r3 併發席,/bin/bash 3.2.57 實測):
+    # 只收片本人的話,片自己起的子行程(測試裡的 git、子行程)全變孤兒,而且訊號落在起片後幾毫秒內時連片本人都會漏。
+    # 不用子殼裡 set -m 讓 & 自成群組:同樣的模擬、啟動後 4–12 毫秒送 TERM,set -m 300 次有 47 次留下孤兒,這個做法 300 次 0–1 次。
+    # 陷阱在起第一片之前設好;子殼直接收到 HUP(終端機掛斷時整個前景群組都會收到)也是這支在收。
     trap '_pp_kill_jobs; exit 143' TERM
     trap '_pp_kill_jobs; exit 129' HUP
     for _i in $(seq 1 "$_shards"); do
       if [[ "$_shards" -le 1 ]]; then
-        "$PY" "$REPO_ROOT/scripts/test_lumos.py" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
+        "$PY" -c "$_PP_OWN_PGRP" "$PY" "$REPO_ROOT/scripts/test_lumos.py" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
       else
         # 這條路不帶 --json-summary:判紅靠子行程離開碼、列紅的靠 log,摘要檔寫了沒人讀
         # 就是白工(r1 通才席抓到)。那個旗標留著給要機讀的人用,不是給這裡用的。
-        "$PY" "$REPO_ROOT/scripts/test_lumos.py" --shard "$_i/$_shards" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
+        "$PY" -c "$_PP_OWN_PGRP" "$PY" "$REPO_ROOT/scripts/test_lumos.py" --shard "$_i/$_shards" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
       fi
       _pids+=($!)
     done
     # ★用每個子行程自己的離開碼判★,不是用有沒有寫出摘要檔判——摘要檔是給人看的加值,
     # 拿它當判準等於「runner 不支援新旗標就一律紅」。
     for _p in "${_pids[@]}"; do _r=0; wait "$_p" || _r=$?; [[ "$_r" -eq 3 ]] && _any3=1; [[ "$_r" -ne 0 && "$_r" -ne 3 ]] && _bad=1; done
     [[ "$_bad" -eq 1 ]] && return 1
     [[ "$_any3" -eq 1 ]] && return 3
     return 0
   }
