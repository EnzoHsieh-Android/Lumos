+def _ppc_env(root, env):
+    import os as _os
+    tmp = root.with_name(root.name + "-tmp")
+    tmp.mkdir(exist_ok=True)
+    e = {k: v for k, v in _os.environ.items() if not k.startswith("FAKE_") and k not in (
+        "LUMOS_SKIP_DRIFT_CHECK", "LUMOS_SKIP_REREAD_CHECK", "LUMOS_SKIP_CODE_LOOP", "LUMOS_PUSH_ATTEMPT", "GIT_DIR")}
+    e.update(GIT_DIR=str(root / ".git"), LUMOS_TEST_SHARDS="1", TMPDIR=str(tmp))
+    e.update(env)
+    return e
+
+
+def _ppc_run(root, stdin, hook=None, **env):
+    """用 /bin/bash(macOS 上是 3.2)真的跑推送前掛鉤 → (rc, 假 lumos 的呼叫紀錄, 輸出)。"""
+    import subprocess as sp
+    hook = hook or Path(GRAPHCTL).resolve().parent / "hooks" / "pre-push"
+    log = root / "argv.log"
+    log.unlink(missing_ok=True)
+    r = sp.run(["/bin/bash", str(hook)], cwd=str(root), input=stdin, capture_output=True, text=True,
+               env=_ppc_env(root, env), timeout=300)
+    lines = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
+    return r.returncode, lines, r.stdout + r.stderr
+
+
+def _ppc_rows(out):
+    """彙總段裡逐筆那幾行 → [(閘名, ref 或 ""), …];沒有彙總段回 None。"""
+    import re
+    i = out.rfind("這次推送共有")
+    if i < 0:
+        return None
+    rows = []
+    for ln in out[i:].splitlines()[1:]:
+        mm = re.match(r"^\s+\d+\. (\S+?)(?: \[([^\]]*)\])?:", ln)
+        if mm:
+            rows.append((mm.group(1), mm.group(2) or ""))
+    return rows
+
+
+def _ppc_header(out):
+    import re
+    mm = re.search(r"這次推送共有 (\d+) 筆擋下\((\d+) 道閘\)", out)
+    return (int(mm.group(1)), int(mm.group(2))) if mm else None
+
+
+def _ppc_cleanup(root):
+    import shutil
+    shutil.rmtree(root, ignore_errors=True)
+    shutil.rmtree(root.with_name(root.name + "-tmp"), ignore_errors=True)
