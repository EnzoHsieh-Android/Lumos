+    不再開始後面的閘(被殺掉的那支就是最後一次呼叫)、不跑全套;掛鉤自己收到 INT/TERM → 手上那支結束後就結束(130/143)、
+    不再開始下一道;等全套測試時收到 TERM → 收掉背景工作、立刻結束;裁判簽名與圖譜健檢回 2 照舊記成擋下。
+    清單與程式要對得上:非註解的 pp_stop_if_signaled 呼叫行數 = 清單筆數。(併入原 t_prepush_gates_stop_on_signal。)
+    對照組:把掛鉤裡的停下全拿掉,同一支被殺掉的呼叫就不會以那個回傳碼結束。
+    翻紅釘:拿掉任一支後面的 pp_stop_if_signaled → 那一支紅;門檻改成只認 130 → 全紅;陷阱裡不 exit(舊寫法)→ ⑤⑥⑦紅;
+    裁判簽名改成只有 rc1 才擋 → ⑧紅。"""
+    print("t_prepush_interrupt_stops_every_gate")
+    import re, subprocess as sp, time as _time
+    _need_src("scripts/hooks/pre-push")
+    hook = Path(GRAPHCTL).resolve().parent / "hooks" / "pre-push"
+    txt = hook.read_text(encoding="utf-8")
+    entries = re.findall(r"^# 中斷就停:([a-z-]+)\|([^|\n]+)\|(.+)$", txt, flags=re.M)
+    calls = [ln for ln in txt.splitlines() if re.match(r"^\s*pp_stop_if_signaled \"", ln)]
+    check("①清單在、而且跟程式裡的 pp_stop_if_signaled 呼叫行數一樣多", len(entries) >= 9 and len(entries) == len(calls),
+          f"清單 {len(entries)} 筆、呼叫 {len(calls)} 行")
+    check("①刻意不接的也列在同一個區塊、各附理由", len(re.findall(r"^# 中斷不停:[^|\n]+\|.{4,}$", txt, flags=re.M)) >= 4, "")
+    root, base, head = _ppc_repo()
+    old_hook = root.with_name(root.name + "-oldhook")
+    try:
+        z = "0" * 40
+        normal = f"refs/heads/main {head} refs/heads/main {base}\n"
+        newbr = f"refs/heads/main {head} refs/heads/feat {z}\n"
+        old_hook.write_text(re.sub(r"^[ \t]*pp_stop_if_signaled \".*\n", "", txt, flags=re.M), encoding="utf-8")
+        for cmd, name, _what in entries:
+            stdin = newbr if cmd == "push-range" else normal
+            rc, lines, out = _ppc_run(root, stdin, FAKE_NEW="1", FAKE_SIG_CMD=cmd)
+            last = lines[-1] if lines else ""
+            want = "code-loop check --help" if cmd == "code-loop-help" else cmd + " "
+            check(f"②{_what}被殺掉 → 以那個回傳碼結束、講明、被殺掉的是最後一次呼叫、全套沒跑",
+                  rc >= 128 and f"{name}被中斷(rc={rc})" in out and last.startswith(want) and "SUITE" not in lines,
+                  f"rc={rc} last={last!r} {out[-300:]}")
+            rc, lines, out = _ppc_run(root, stdin, hook=old_hook, FAKE_NEW="1", FAKE_SIG_CMD=cmd)
+            check(f"③對照:拿掉停下的掛鉤,{_what}被殺掉時不會以 128 以上結束", rc < 128, f"rc={rc}")
+        for sig, want in (("SIGTERM", 143), ("SIGINT", 130)):
+            rc, lines, out = _ppc_run(root, normal, FAKE_NEW="1", FAKE_HOOK_SIG_CMD="home", FAKE_HOOK_SIG=sig)
+            check(f"④掛鉤自己收到 {sig}(每支檔有家跑到一半)→ 那支結束後掛鉤以 {want} 結束、不再開始筆記形狀擋、全套沒跑",
