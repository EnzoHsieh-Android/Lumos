+                  f"rc={rc} {lines[-3:]} {out[-300:]}")
+        tmp = root.with_name(root.name + "-tmp")
+        outf = tmp / "bg.out"
+        with open(outf, "w") as fh:
+            t0 = _time.monotonic()
+            p = sp.Popen(["/bin/bash", str(hook)], cwd=str(root), stdin=sp.PIPE, stdout=fh, stderr=fh, text=True,
+                         env=_ppc_env(root, {"FAKE_NEW": "1", "FAKE_SUITE_SIG": "1"}))
+            p.communicate(normal, timeout=120)
+            took = _time.monotonic() - t0
+        bg = outf.read_text(encoding="utf-8", errors="replace")
+        check("⑤等全套測試時收到 TERM → 掛鉤立刻以 143 結束(不等背景那支跑完、不印測試結果)",
