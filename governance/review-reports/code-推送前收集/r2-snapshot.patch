+    entries = re.findall(r"^# 中斷就停:([a-z-]+)\|([^|\n]+)\|(.+)$", txt, flags=re.M)
+    calls = [ln for ln in txt.splitlines() if re.match(r"^\s*pp_stop_if_signaled \"", ln)]
+    check("①清單在、而且跟程式裡的 pp_stop_if_signaled 呼叫行數一樣多", len(entries) >= 9 and len(entries) == len(calls),
+          f"清單 {len(entries)} 筆、呼叫 {len(calls)} 行")
+    check("①刻意不接的也列在同一個區塊、各附理由", len(re.findall(r"^# 中斷不停:[^|\n]+\|.{4,}$", txt, flags=re.M)) >= 4, "")
+    root, base, head = _ppc_repo()
+    old_hook = root.with_name(root.name + "-oldhook")
+    try:
+        z = "0" * 40
+        normal = f"refs/heads/main {head} refs/heads/main {base}\n"
+        newbr = f"refs/heads/main {head} refs/heads/feat {z}\n"
+        old_hook.write_text(re.sub(r"^[ \t]*pp_stop_if_signaled \".*\n", "", txt, flags=re.M), encoding="utf-8")
+        for cmd, name, _what in entries:
+            stdin = newbr if cmd == "push-range" else normal
+            rc, lines, out = _ppc_run(root, stdin, FAKE_NEW="1", FAKE_SIG_CMD=cmd)
+            last = lines[-1] if lines else ""
