+                         preexec_fn=_ppc_sigint_default)
+            p.communicate(normal, timeout=120)
+            took = _time.monotonic() - t0
+        bg = outf.read_text(encoding="utf-8", errors="replace")
+        _time.sleep(max(0.0, 5.0 - (_time.monotonic() - t0)))
+        log_txt = (root / "argv.log").read_text(encoding="utf-8") if (root / "argv.log").exists() else ""
