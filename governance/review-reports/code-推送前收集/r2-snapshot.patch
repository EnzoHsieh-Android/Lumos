+        _time.sleep(max(0.0, 5.0 - (_time.monotonic() - t0)))
+        log_txt = (root / "argv.log").read_text(encoding="utf-8") if (root / "argv.log").exists() else ""
+        check("⑥被砍(TERM)之後,全套測試那一片也被收掉(沒有孤兒跑完記下 SUITE-END)、TMPDIR 底下沒留 lumos-prepush 開頭的東西",
+              "SUITE" in log_txt and "SUITE-END" not in log_txt and not list(tmp.glob("lumos-prepush*")),
+              f"{log_txt[-200:]!r} {sorted(x.name for x in tmp.glob('lumos-prepush*'))}")
+        (root / "argv.log").unlink(missing_ok=True)
+        with open(outf, "w") as fh:
+            t0 = _time.monotonic()
+            p = sp.Popen(["/bin/bash", str(hook)], cwd=str(root), stdin=sp.PIPE, stdout=fh, stderr=fh, text=True,
