+def _ppc_sigint_default():
+    """起掛鉤前把 SIGINT 裝回預設:掛鉤平常由前景的 git 叫起;測試若跑在背景(推送前閘的分片),繼承來的「忽略 SIGINT」
+    會讓 bash 的 INT 陷阱裝不上(進場就忽略的訊號不能再接),測 Ctrl-C 的斷言在分片裡假紅(2026-10-14 分片實測)。"""
+    import signal
+    signal.signal(signal.SIGINT, signal.SIG_DFL)
