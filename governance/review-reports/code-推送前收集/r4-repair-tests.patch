+def _ppc_loose_quiet_writes(text):
+    """bash 原始碼裡「寫進檔案(> 或 >>,目標不是 /dev/null)、同一個命令後面再 2>/dev/null」沒包組的地方 → 起始行號清單。
+    包成一組({ …; } 2>/dev/null)時 2>/dev/null 在 } 後面、屬於另一段,不算。先去註解、接續行(_ppc_bash_logical_lines)。"""
+    import re
+    bad = []
+    for start, line in _ppc_bash_logical_lines(text):
+        prev = None
+        while prev != line:   # ${…}、$(…) 先收成一個字,免得下面按 {}() 切段時把它們切開
+            prev, line = line, re.sub(r"\$\{[^{}]*\}|\$\([^()]*\)", "$x", line)
+        for seg in re.split(r"&&|\|\||(?<![>&0-9])&(?!>)|[;|(){}]", line):
+            for mm in re.finditer(r"(?<![0-9&<>])1?>{1,2}(?!&)[ \t]*([^ \t]+)", seg):
+                if mm.group(1) != "/dev/null" and re.search(r"(?<![0-9])2>[ \t]*/dev/null", seg[mm.end():]):
+                    bad.append(start)
+                    break
+            else:
+                continue
+            break
+    return bad
