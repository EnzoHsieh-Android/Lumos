+                i += 1
+            else:
+                buf.append(" " if c == "\n" else "x")
+            i += 1
+            continue
+        if c == "\\" and i + 1 < n:
+            if text[i + 1] == "\n":   # 續行:兩個字都吃掉,邏輯行繼續
+                ln += 1
+            else:
+                buf.append("xx")
+            i += 2
+            continue
+        if c in "'\"":
+            q = c
+            buf.append(c)
+        elif c == "#" and (not buf or buf[-1] in " \t;&|()<>"):
+            while i < n and text[i] != "\n":
+                i += 1
+            continue
+        elif c == "\n":
+            out.append((start, "".join(buf)))
+            buf, start = [], None
+        else:
+            buf.append(c)
+        i += 1
+    if buf:
+        out.append((start, "".join(buf)))
+    return out
