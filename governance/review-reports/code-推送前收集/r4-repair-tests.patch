+def _ppc_bash_logical_lines(text):
+    """bash 原始碼 → [(起始行號, 邏輯行)]:去掉註解(不在引號裡、出現在字首的 #)、接起 \\ 續行;
+    引號裡的內容換成 x(引號本身留著),免得引號裡的 #、>、; 被當成語法。不處理 here-doc 本文(掛鉤只用 <<< 單行)。"""
+    out, buf, start, ln, q, i, n = [], [], None, 1, None, 0, len(text)
+    while i < n:
