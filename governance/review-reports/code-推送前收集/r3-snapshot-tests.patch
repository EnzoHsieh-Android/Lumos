+def t_code_loop_keep_going_pass_sites_keep_blocks():
+    """[S13] code-loop check --keep-going 已記下一筆擋下之後,走到 8 個放行站點的每一個都仍回 1:pitfalls 失敗、pitfalls 沒有 JSON、
+    pitfalls 例外、tier 不是 high、留痕有效、留痕過時但屬簿記豁免、留痕要求被環境變數跳過、合併側放行;pitfalls 失敗(三種)時新增告警閘照跑。
+    每個站點先跑一次「沒有先前的擋下」當前置:同一個現場回 0,證明真的走到那個放行站點。
+    另掃判定函式原始碼:每個 return 要嘛是 _fin(...),要嘛是「緊接在 `if <變數>:` 底下、回傳由 kg.hit(...) 指派的那個變數」
+    (不帶旗標時 hit 回的就是 fin(v);帶旗標時回 None,所以回傳前一定要判非空)。
+    翻紅釘:任一站點直接 return 放行(不經 _fin)→ 那一站紅、原始碼守衛也紅;pitfalls 失敗時不跑新增告警閘 → ③紅;
+    把 `if _stop: return _stop` 改成無條件 return _stop → ⑤紅(代碼審 r2 合約席 2)。"""
+    print("t_code_loop_keep_going_pass_sites_keep_blocks")
+    import ast
+    # 原始碼守衛先跑:行為那段若因判定函式回 None 而例外,這一段照樣給得出結論
+    src = Path(GRAPHCTL).read_text(encoding="utf-8")
+    tree = ast.parse(src)
+    fn = next((n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "_codeloop_guard_verdict"), None)
+    bad = []
+    # 「這一道擋下」的結果(收集分流 kg.hit(...) 指派的變數)也算經過收尾:hit 不帶旗標時回的就是 fin(v),帶旗標時回 None 不回傳
+    via_hit = set()
+    if fn is not None:
+        for x in ast.walk(fn):
+            if isinstance(x, ast.Assign) and isinstance(x.value, ast.Call) and isinstance(x.value.func, ast.Attribute) \
+                    and x.value.func.attr == "hit":
+                via_hit.update(tg.id for tg in x.targets if isinstance(tg, ast.Name))
+    kg_src = ast.get_source_segment(src, next((n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "_CodeloopKg"),
+                                              ast.Pass())) or ""
+    check("⑤前置:收集分流 hit 不帶旗標時回的是 self.fin(v)", "return self.fin(v)" in kg_src, kg_src[:300])
+
+    # 回傳 hit 指派的變數時,緊鄰的外層要是 `if <那個變數>:`、而且 return 是那個 if 本體的第一句(帶旗標時 hit 回 None,
+    # 無條件 return 會讓整個判定函式回 None、下游 .get 崩;代碼審 r2 合約席 2)。guarded 記下這種 return 的行號。
+    guarded = set()
+
+    def walk(node):
+        for ch in ast.iter_child_nodes(node):
