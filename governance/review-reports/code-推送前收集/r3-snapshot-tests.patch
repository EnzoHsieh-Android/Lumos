+def _cl_reason_kind_sites(src):
+    """掃 scripts/lumos 原始碼裡所有「設定 reason_kind」的地方(dict 字面的鍵、reason_kind= 關鍵字參數、x["reason_kind"] = 指派)
+    → (字面種類的集合, 值不是字面字串的站點 [(所在函式, 行號)])。所在函式用「類別.方法」或函式名。"""
+    import ast
+    tree = ast.parse(src)
+    kinds, nonlit = set(), []
+
+    def val(owner, v):
+        if isinstance(v, ast.Constant) and isinstance(v.value, str):
+            kinds.add(v.value)
+        else:
+            nonlit.append((owner, v.lineno))
+
+    def visit(node, owner):
+        for ch in ast.iter_child_nodes(node):
+            if isinstance(ch, ast.ClassDef):
+                visit(ch, ch.name)
+                continue
+            if isinstance(ch, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                visit(ch, f"{owner}.{ch.name}" if owner and not owner.startswith("_fn:") else ch.name)
+                continue
+            if isinstance(ch, ast.Dict):
+                for k, v in zip(ch.keys, ch.values):
+                    if isinstance(k, ast.Constant) and k.value == "reason_kind":
+                        val(owner, v)
+            elif isinstance(ch, ast.keyword) and ch.arg == "reason_kind":
+                val(owner, ch.value)
+            elif isinstance(ch, ast.Assign):
+                for tg in ch.targets:
+                    if isinstance(tg, ast.Subscript) and isinstance(tg.slice, ast.Constant) and tg.slice.value == "reason_kind":
+                        val(owner, ch.value)
+            visit(ch, owner)
+    visit(tree, "")
+    return kinds, nonlit
+
