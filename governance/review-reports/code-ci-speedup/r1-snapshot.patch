+def _ci_step_fp(block):
+    """一個步驟 → run、if、continue-on-error 三種行的指紋(縮排照 ci.yml:步驟 6 格、鍵 8 格、run 內容 10 格)。"""
+    import re as _re
+    import hashlib as _h
+    keep, inrun = [], False
+    for ln in block.split("\n"):
+        if _re.match(r"^        (if|continue-on-error):", ln):
+            keep.append(ln)
+            inrun = False
+            continue
+        if _re.match(r"^        run:", ln):
+            keep.append(ln)
+            inrun = True
+            continue
+        if inrun and (ln.startswith("          ") or not ln.strip()):
+            keep.append(ln)
+            continue
+        if _re.match(r"^        \S", ln):
+            inrun = False
+    return _h.sha256("\n".join(keep).rstrip().encode()).hexdigest()[:16]
+
