+    lines = body.splitlines()
+    regions, _open = m._fence_regions(lines, True)
+    out = []
+    for a, b in regions:
+        if lines[a].lstrip(" ").lstrip("`~").startswith("kotlin"):
+            out.append("\n".join(lines[a + 1:b if b is not None else len(lines)]))
+    return out
+
