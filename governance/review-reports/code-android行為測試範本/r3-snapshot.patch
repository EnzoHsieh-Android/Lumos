+class ReportSender(private val pool: ConnectionPool) {
+    // 型錄 CO-14 的第二種標準寫法:取得與關閉都在逾時區塊裡,用 try/finally 收
+    suspend fun send(report: String): Boolean =
+        withTimeoutOrNull(1_000) {
+            val conn = pool.open()
+            try {
+                conn.write(report)
+                true
+            } finally {
+                conn.close()
+            }
+        } ?: false
