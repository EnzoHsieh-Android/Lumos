+def _kt_template_sections(text):
+    """範本檔 → {組代號: {小節標題: 小節內文}};只看 `## T<n> ` 與 `### ` 標題。"""
+    import re as _re
+    out = {}
+    for m in _re.finditer(r"^## (T\d+) .*$", text, _re.M):
+        nxt = _re.search(r"^## ", text[m.end():], _re.M)
+        body = text[m.end():m.end() + nxt.start()] if nxt else text[m.end():]
+        subs = {}
+        for s in _re.finditer(r"^### (.+)$", body, _re.M):
+            n2 = _re.search(r"^### ", body[s.end():], _re.M)
+            subs[s.group(1).strip()] = body[s.end():s.end() + n2.start()] if n2 else body[s.end():]
+        out[m.group(1)] = subs
+    return out
