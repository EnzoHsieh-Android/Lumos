+    try:
+        cur_fp = _h.sha256(Path(hook_path).read_bytes()).hexdigest()[:16] if hook_path else ""
+    except OSError:
+        cur_fp = ""
+    cutoff = _dt.datetime.now().astimezone() - _dt.timedelta(days=_HOOK_LIVENESS_WINDOW_DAYS)
+    root_s = str(Path(repo_root).resolve())
+    latest = None
+    try:
+        for ln in f.read_text(encoding="utf-8", errors="replace").splitlines():
+            if not ln.strip():
+                continue
+            try:
+                e = _j.loads(ln)
+            except ValueError:
+                continue
+            if e.get("hook") != hook_name or e.get("kind") != "ok":
