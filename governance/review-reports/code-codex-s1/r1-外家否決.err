    99	def _is_excluded_path(file_path: str) -> bool:
   100	    """判斷路徑是否在排除清單(EXCLUDE_PATH_CONTAINS + EXCLUDE_FILENAMES)。"""
   101	    norm = file_path.replace("\\", "/")
   102	    # 確保路徑段比對加 leading slash 一致性
   103	    if not norm.startswith("/"):
   104	        norm_check = "/" + norm
   105	    else:
   106	        norm_check = norm
   107	    for seg in EXCLUDE_PATH_CONTAINS:
   108	        if seg in norm_check:
   109	            return True
   110	    p = Path(file_path)
   111	    if p.name in EXCLUDE_FILENAMES:
   112	        return True
   113	    return False
   114	
   115	
   116	_SHEBANG_HINTS = (b"python", b"bash", b"/sh", b"env sh", b"zsh")
   117	
   118	
   119	def _shebang_is_code(abs_path: Path) -> bool:
   120	    """無副檔名檔靠首行 shebang 入樣(主session鏡頭利用率_計劃 前置修正①:scripts/lumos、git hooks 原本永不入樣)。
   121	    只讀前 128 bytes、包 try/except:二進位/不存在/讀不到 → False,現役 fail-open hook 不得因此炸。"""
   122	    try:
   123	        if not abs_path.is_file():
   124	            return False
   125	        with open(abs_path, "rb") as fh:
   126	            head = fh.read(128)
   127	    except OSError:
   128	        return False
   129	    if not head.startswith(b"#!"):
   130	        return False
   131	    first = head.split(b"\n", 1)[0]
   132	    return any(h in first for h in _SHEBANG_HINTS)
   133	
   134	
   135	def hook_decide(payload: dict, repo: str | None = None) -> str | None:
   136	    """過濾邏輯:決定是否對此 payload 觸發 lumos impact。
   137	
   138	    回傳:
   139	      None   → 放行(非 code / 排除路徑)
   140	      str    → 要送給 lumos impact 的 file_path(非空字串)
   141	
   142	    此函式設計為可獨立 import 測試(不依賴 stdin/subprocess)。
   143	    repo 給了才做無副檔名 shebang 判定(相對路徑相對 repo 解;沒 repo 維持只看副檔名)。
   144	    """
   145	    file_path = extract_path(payload)
   146	    return _decide_one(file_path, repo)
   147	
   148	
   149	def _decide_one(file_path: str | None, repo: str | None = None) -> str | None:
   150	    """單一路徑的過濾(hook_decide 的本體;多檔逐一套用)。"""
   151	    if not file_path:
   152	        return None
   153	    p = Path(file_path)
   154	    if p.suffix.lower() not in CODE_EXTS:
   155	        if not (p.suffix == "" and repo):
   156	            return None
   157	        abs_path = p if p.is_absolute() else Path(repo) / p
   158	        if not _shebang_is_code(abs_path):
   159	            return None
   160	    if _is_excluded_path(file_path):
   161	        return None
   162	    return file_path
   163	
   164	
   165	def hook_decide_paths(payload: dict, repo: str | None = None) -> tuple[list[str], list[str]]:
   166	    """多檔版:回 (要跑 impact 的路徑[最多 APPLY_PATCH_MAX_FILES], 超出只列名的路徑)。"""
   167	    kept = [fp for fp in extract_paths(payload) if _decide_one(fp, repo)]
   168	    return kept[:APPLY_PATCH_MAX_FILES], kept[APPLY_PATCH_MAX_FILES:]
   169	
   170	
   171	def _ttl_marker_path(session_id: str, file_abs: str) -> Path:
   172	    """標記檔路徑: <tmpdir>/lumos-impact-<session_id>/<sha1[:16]>。"""
   173	    h = hashlib.sha1(file_abs.encode()).hexdigest()[:16]
   174	    return Path(tempfile.gettempdir()) / f"lumos-impact-{session_id}" / h
   175	
   176	
   177	def _ttl_lazy_cleanup() -> None:
   178	    """惰性清理: 刪 lumos-impact-* 下 mtime > 24h 的 session 目錄 (best-effort)。"""
   179	    import shutil  # m-1: 提到函式頂,避免每次迭代 import
   180	    try:
   181	        tmp = Path(tempfile.gettempdir())
   182	        cutoff = time.time() - 24 * 3600
   183	        for d in tmp.iterdir():
   184	            if d.name.startswith("lumos-impact-") and d.is_dir():
   185	                try:
   186	                    if d.stat().st_mtime < cutoff:
   187	                        shutil.rmtree(str(d), ignore_errors=True)
   188	                except OSError:
   189	                    pass
   190	    except OSError:
   191	        pass
   192	
   193	
   194	def _ttl_unmark(session_id: str, file_abs: str, token: str | None = None) -> None:
   195	    """撤冷卻標記:判定當下已先寫(窗口不變寬,code-loop r1),最後沒注入就撤——零注入的 Edit 不開冷卻窗(前置修正②)。
   196	    ★只撤自己寫的★:標記內容為「<ts> <token>」,token 不符就不動(code-loop r2 併發席:無條件 unlink 會抹掉另一次判定剛建立的合法冷卻窗)。"""
   197	    if token is None:
   198	        return   # 自己沒寫成標記(mark 失敗)就沒有東西可撤;不得退回無條件刪(r3 併發席)
   199	    marker = _ttl_marker_path(session_id, file_abs)
   200	    try:
   201	        parts = marker.read_text(encoding="utf-8").split()
   202	        if len(parts) < 2 or parts[1] != token:
   203	            return
   204	        marker.unlink()
   205	    except (OSError, IndexError):
   206	        pass
   207	
   208	
   209	def _ttl_mark(session_id: str, file_abs: str) -> str | None:
   210	    """寫冷卻標記,回擁有權 token(pid+隨機);內容「<ts> <token>」,舊讀取端只取第一欄。失敗回 None(best-effort)。"""
   500	    output = {
   501	        "hookSpecificOutput": {
   502	            "hookEventName": "PreToolUse",
   503	            "additionalContext": ctx,
   504	        }
   505	    }
   506	    print(json.dumps(output, ensure_ascii=False))
