   555	def _impact_for_file(payload: dict, repo: str, file_path: str, session_id: str, lumos: str, timeout: float = 30.0) -> str | None:
   556	    """單檔:TTL 冷卻窗 → 叫 lumos impact → 回可注入的文字(None=不注入)。內容與舊 main 逐字等價,只是不直接 print。"""
   557	
   558	    # 絕對路徑:若 file_path 是相對路徑,補上 repo
   559	    if not Path(file_path).is_absolute():
   560	        file_path_abs = str(Path(repo) / file_path)
   561	    else:
   562	        file_path_abs = file_path
   563	
   564	    # TTL 冷卻窗:讀 .lumos/impact.json 的 ttl_min(預設 20min)
   565	    if session_id:
   566	        ttl_min = 20  # 預設
   567	        try:
   568	            impact_cfg_path = Path(repo) / ".lumos" / "impact.json"
   569	            if impact_cfg_path.is_file():
   570	                cfg = json.loads(impact_cfg_path.read_text(encoding="utf-8"))
   571	                ttl_raw = cfg.get("ttl_min", 20)
   572	                if isinstance(ttl_raw, (int, float)) and not isinstance(ttl_raw, bool):
   573	                    ttl_min = max(1, int(ttl_raw))  # m-4: 截斷兜底,防 0.5 → 0 → TTL 恆觸發
   574	        except (OSError, json.JSONDecodeError, ValueError):
   575	            pass
   576	
   577	        in_cooldown = not _ttl_should_inject(session_id, file_path_abs, ttl_sec=ttl_min * 60, mark=False)
   578	        ttl_token = _ttl_mark(session_id, file_path_abs) if not in_cooldown else None   # 判定後立刻寫(窗口同舊版);沒注入再用 token 撤
   579	    else:
   580	        in_cooldown = False
   581	        ttl_token = None
   582	
   583	    # v1.1(2026-07-11,goldset §6 全過後轉正):
   584	    # 窗外 → ranked 降噪版(固定席+top-8,delta 當查詢詞);
   585	    # 窗內 → --incidents-only 快速路(只跑事故比對——安全面每次都看,重型 BFS 降頻)。
   586	    delta_q = extract_delta_query(payload)
   587	    stdin_payload = json.dumps({"query": delta_q, "prospective": {}}, ensure_ascii=False)
   588	    cmd = [sys.executable, lumos, "impact", "--file", file_path_abs, "--repo", repo,
   589	           "--ranked", "--stdin-payload", "--json"]
   590	    if in_cooldown:
   591	        cmd.append("--incidents-only")
   592	    try:
   593	        result = subprocess.run(
   594	            cmd,
   595	            input=stdin_payload,
   596	            capture_output=True,
   597	            text=True,
   598	            timeout=timeout,
   599	        )
   600	    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
   601	        if session_id and not in_cooldown:
   602	            _ttl_unmark(session_id, file_path_abs, ttl_token)
   603	        return None  # fail-open
   604	
   605	    rc = result.returncode
   606	
   607	    if rc != 0 and session_id and not in_cooldown:
   608	        _ttl_unmark(session_id, file_path_abs, ttl_token)   # 沒注入不開冷卻窗
   609	    if rc == 3:
   610	        # vault 找不到 → 印一行 debug,不注入,放行
   611	        print(
   612	            f"[impact-hook] vault 未找到 (rc=3)。非圖譜專案或 --repo={repo} 路徑下無 docs/*-knowledge/。",
   613	            file=sys.stderr,
   614	        )
   615	        return None
   616	
   617	    if rc != 0:
   618	        # 其他非 0 → fail-open 純靜默
   619	        return None
   620	
   621	    # rc == 0: ranked schema {file, results, meta}
   622	    try:
   623	        impact_data = json.loads(result.stdout.strip().splitlines()[-1])
   624	    except (json.JSONDecodeError, ValueError, IndexError):
   625	        impact_data = None
   626	    if not impact_data:
   627	        if session_id and not in_cooldown:
   628	            _ttl_unmark(session_id, file_path_abs, ttl_token)
   629	        return None
   630	    # 判空與 inject_ranked_context 同一條:results/stack_questions/lane 皆空 → 不注入(lane-only 也注入)
   631	    has = impact_data.get("results") or impact_data.get("stack_questions") or impact_data.get("lane")
   632	    ctx = build_ranked_context(impact_data) if has else ""
   633	    if not ctx.strip():
   634	        if session_id and not in_cooldown:
   635	            _ttl_unmark(session_id, file_path_abs, ttl_token)   # 零注入不開冷卻窗(前置修正②);標記在判定當下已寫,這裡只撤
   636	        return None
   637	    return ctx
   638	
   639	
   640	if __name__ == "__main__":
   641	    sys.exit(main())
