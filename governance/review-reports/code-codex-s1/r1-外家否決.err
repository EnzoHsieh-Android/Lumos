    63	
    64	def extract_patch_paths(command: str) -> list[str]:
    65	    """從 Codex apply_patch 的 patch 全文抽檔案路徑:`*** Add File:` / `*** Update File:` / `*** Delete File:` /
    66	    `*** Move to:`(改名的新路徑,r1 邊界 F7)。去重、保序。不是 patch 文字 → []。"""
    67	    if not isinstance(command, str) or "*** Begin Patch" not in command:
    68	        return []
    69	    out: list[str] = []
    70	    for line in command.split("\n"):
    71	        m = _PATCH_HDR_RE.match(line.strip())
    72	        if m:
    73	            fp = m.group(1).strip()
    74	            if fp and fp not in out:
    75	                out.append(fp)
    76	    return out
    77	
