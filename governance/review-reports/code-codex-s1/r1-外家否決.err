   421	def build_ranked_context(data: dict) -> str:
   422	    """v1.1:把 ranked 輸出({results,meta})轉成降噪清單文字。固定席在前(合約/事故),
   423	    非固定帶分數;截斷數照 meta 標注。尾附棧別效能追問(若 lumos 輸出帶 stack_questions——
   424	    單源在 scripts/lumos 的 _STACK_PERF_QUESTIONS,本 hook 只格式化不持有內容)。"""
   425	    lines: list[str] = []
   426	    res = data.get("results", [])
   427	    meta = data.get("meta", {})
   428	    pins = [x for x in res if x.get("pinned")]
   429	    free = [x for x in res if not x.get("pinned") and not x.get("rescued")]
   430	    rescued = [x for x in res if x.get("rescued")]
   431	    if pins:
   432	        lines.append(f"必看——這 {len(pins)} 篇帶著不能破壞的合約或出過事故:")
   433	        for x in pins:
   434	            mk = {"incident": "⚠事故", "direct": "直接", "indirect": f"hop{x.get('hop','?')}"}.get(x.get("kind"), "")
   435	            ct = f" ★{x['contract']}★" if x.get("contract") else ""
   436	            mb = f"  (trigger: {x['matched_by']})" if x.get("matched_by") else ""
   437	            # about_code 語意欄位命中(工具清單 #9):讀 about_hit(只在 True 時存在),不碰既有 hit 來源標記
   438	            ab = "★關於★" if x.get("about_hit") else ""
   439	            lines.append(f"  {ab}{mk}{ct} {x.get('node','?')}{mb}")
   440	    if free:
   441	        lines.append(f"可能相關的 {len(free)} 篇(依關聯度排序):")
   442	        for x in free:
   443	            mk = {"direct": "直接", "indirect": f"hop{x.get('hop','?')}"}.get(x.get("kind"), "")
   444	            lines.append(f"  {x.get('score',0):.2f} {mk} {x.get('node','?')}")
   445	    if rescued:
   446	        # R1 直連保底(plan:hook必看召回修復):分數不過閾但為僅有的直連節點——信心層級不同於排序席
   447	        lines.append(f"另外 {len(rescued)} 篇分數不高但直接提到這個檔,一併列出:")
   448	        for x in rescued:
   449	            hit = f"/{x['hit']}" if x.get("hit") == "basename-match" else ""
   450	            lines.append(f"  {x.get('score',0):.2f} 直接{hit} {x.get('node','?')}")
   451	    if meta.get("truncated"):
   452	        lines.append(f"  (+{meta['truncated']} 條低分截斷,沒列出來)")
   453	    # pin-denoise-a-v4:參考道(JSON 獨立頂層鍵;.get 條件鍵慣例——knob=0 時鍵不存在)
   454	    lane = data.get("lane", [])
   455	    if lane:
   456	        lines.append(f"守衛面參考——這 {len(lane)} 篇是軟標記樞紐,跟每支檔都近,未被本次改動直接證實相關:")
   457	        for x in lane:
   458	            lines.append(f"  {x.get('score',0):.2f} hop{x.get('hop','?')} {x.get('node','?')}")
   459	        if meta.get("lane_truncated"):
   460	            lines.append(f"  (另有 {meta['lane_truncated']} 條守衛面參考未列出)")
   461	    for stk, qs in (data.get("stack_questions") or {}).items():
   462	        lines.append(f"[{stk} 效能檢核——動手時順答這幾個問題]")
   463	        for q in qs:
   464	            lines.append(f"  - {q}")
   465	    lines.append("")
   466	    # 收尾指令只在真的列了節點時附(單 reviewer 終審 minor:僅檢核問題時
   467	    # 「判上列節點」答非所問,會弱化對提問的聚焦——檢核段標題已自帶指令)
   468	    if res or lane:
   469	        lines.append(_INJECT_INSTRUCTION)
   470	    return "\n".join(lines)
   471	
   472	
   473	def inject_ranked_context(data: dict) -> bool:
   474	    """ranked 版注入:results/stack_questions/lane 皆空 → 不輸出(lane-only 的題也要注入,v4 Codex f2)。"""
   475	    if not data.get("results") and not data.get("stack_questions") and not data.get("lane"):
   476	        return False
   477	    print(json.dumps({"hookSpecificOutput": {
   478	        "hookEventName": "PreToolUse",
   479	        "additionalContext": build_ranked_context(data),
   480	    }}, ensure_ascii=False))
   481	    return True
   482	
   483	
   484	def inject_additional_context(impact_data: dict) -> None:
   485	    """非空影響集 → 印 hookSpecificOutput JSON 到 stdout;空集合 → 不輸出。
   486	
   487	    永不 block、永不改 permissionDecision。
   488	
   489	    注意 (r5-F2):此格式是 Claude Code 官方 PreToolUse additionalContext 能力。
   490	    上線後請用 `claude --debug` 實測注入時機(PreToolUse 的 additionalContext 注在
   491	    tool result 旁);若版本行為有變,可退回 stderr 備援(現有 hook 已證此路可行)。
   492	    """
   493	    direct = impact_data.get("direct", [])
   494	    indirect = impact_data.get("indirect", [])
   495	    incidents = impact_data.get("incidents", [])
   496	    if not direct and not indirect and not incidents:
   497	        return  # 空影響集(direct+indirect+incidents 皆空):不注入
   498	
   499	    ctx = build_additional_context(impact_data)
   500	    output = {
   501	        "hookSpecificOutput": {
   502	            "hookEventName": "PreToolUse",
   503	            "additionalContext": ctx,
   504	        }
   505	    }
   506	    print(json.dumps(output, ensure_ascii=False))
   507	
   508	
   509	def main() -> int:
   510	    try:
