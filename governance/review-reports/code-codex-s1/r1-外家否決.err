    56	EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "apply_patch"}   # apply_patch=Codex 改檔工具(Edit/Write 只是它的 matcher 別名)
    57	# Codex 多檔 patch:最多算前 N 檔、總時間預算(hook 外層 30 秒);既有碼沒有「處理檔數」上限(cap_* 限的是查詢字串長度)
    58	# ——Projects/Codex完全支援_計劃 S1(r2 通才 F2)
    59	APPLY_PATCH_MAX_FILES = 5
    60	APPLY_PATCH_BUDGET_SEC = 20.0
    61	_PATCH_HDR_RE = re.compile(r"^\*\*\* (?:Add File|Update File|Delete File|Move to): (.+?)\s*$")
