    43	# 同源:check-graph-sync.py EXCLUDE_PATH_CONTAINS / EXCLUDE_FILENAMES
    44	EXCLUDE_PATH_CONTAINS = (
    45	    "/docs/",            # 圖譜本身 + 一般文件
    46	    "/node_modules/",
    47	    "/bin/", "/obj/",
    48	    "/.git/",
