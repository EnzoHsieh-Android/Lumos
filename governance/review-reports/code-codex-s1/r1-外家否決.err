   109	CODEX_TRANSCRIPT_VERSIONS = {"0.144.1"}
   110	_CODEX_EXEC_CMD_RE = re.compile(r'"cmd"\s*:\s*"((?:[^"\\]|\\.)*)"')
   111	# patch 可能直接傳字串 tools.apply_patch("…"),也可能先存變數 const patch = "…" 再呼叫(S1 驗收實看):
   112	# 一律掃所有含 *** Begin Patch 的 JS 字串字面值
   113	_CODEX_APPLY_PATCH_RE = re.compile(r'"((?:[^"\\]|\\.)*\*\*\* Begin Patch(?:[^"\\]|\\.)*)"')
   114	_CODEX_PATCH_HDR_RE = re.compile(r"^\*\*\* (?:Add File|Update File|Delete File|Move to): (.+?)\s*$")
   115	
   116	
   117	def _js_unescape(s: str) -> str:
   118	    try:
   119	        return json.loads('"' + s + '"')
   120	    except ValueError:
   121	        return s.replace("\\n", "\n").replace('\\"', '"')
   122	
   123	
   124	def _is_codex_transcript(first_obj: dict) -> bool:
   125	    return isinstance(first_obj, dict) and first_obj.get("type") == "session_meta"
   126	
   127	
   128	def collect_codex_turn_actions(lines: list[str]):
   129	    """Codex rollout jsonl → (file_paths, bash_commands)。型別:第一行 session_meta(讀 cli_version);
   130	    真實 user 輸入=event_msg/user_message;工具呼叫=response_item/custom_tool_call name=exec,input 是一段 JS:
   131	    `tools.exec_command({"cmd":"…"})` 取 cmd、`tools.apply_patch("…patch…")` 解 patch 標頭取檔。
   132	    版本不在 CODEX_TRANSCRIPT_VERSIONS → stderr 一行、回 ([], [])(略過,不猜)。"""
   133	    objs = []
   134	    for line in lines:
   135	        if not line.strip():
   136	            continue
   137	        try:
   138	            objs.append(json.loads(line))
   139	        except json.JSONDecodeError:
   140	            continue
   141	    if not objs:
   142	        return [], []
   143	    ver = str(((objs[0].get("payload") or {}).get("cli_version")) or "")
   144	    # patch 標頭的路徑是相對 session cwd 的;is_code_file 要「在 project_root 之下」的絕對路徑(Claude 逐字稿本來就是絕對路徑)
   145	    sess_cwd = str(((objs[0].get("payload") or {}).get("cwd")) or "")
   146	    if ver not in CODEX_TRANSCRIPT_VERSIONS:
   147	        print(f"[check-graph-sync] Codex 逐字稿格式未知(cli_version={ver or '?'};認得的:{','.join(sorted(CODEX_TRANSCRIPT_VERSIONS))}),"
   148	              "收工同步這一輪略過——不猜格式;要接新版先補 fixture", file=sys.stderr)
   149	        return [], []
   150	    turn = []
   151	    for obj in reversed(objs):
   152	        p = obj.get("payload") or {}
   153	        if obj.get("type") == "event_msg" and p.get("type") == "user_message":
   154	            break
   155	        turn.append(obj)
   156	    turn.reverse()
   157	    file_paths: list[str] = []
   158	    bash_commands: list[str] = []
   159	    for obj in turn:
   160	        p = obj.get("payload") or {}
   161	        if obj.get("type") != "response_item" or p.get("type") != "custom_tool_call":
   162	            continue
   163	        inp = p.get("input")
   164	        if not isinstance(inp, str):
   165	            continue
   166	        for m in _CODEX_EXEC_CMD_RE.finditer(inp):
   167	            cmd = _js_unescape(m.group(1))
   168	            if cmd:
   169	                bash_commands.append(cmd)
   170	        for m in _CODEX_APPLY_PATCH_RE.finditer(inp):
   171	            patch = _js_unescape(m.group(1))
   172	            for ln in patch.split("\n"):
   173	                h = _CODEX_PATCH_HDR_RE.match(ln.strip())
   174	                if h:
   175	                    fp = h.group(1).strip()
   176	                    if sess_cwd and not Path(fp).is_absolute():
   177	                        fp = str(Path(sess_cwd) / fp)
   178	                    if fp not in file_paths:
   179	                        file_paths.append(fp)
   180	    return file_paths, bash_commands
   181	
   182	
   183	def collect_turn_actions(transcript_path: Path):
   184	    """從 transcript 尾部反向掃,到最近一個「真實 user 輸入」為止
   185	    (排除 tool_result 之類也被標 type=user 的雜訊)。
   186	    回傳 (file_paths, bash_commands)。Codex 逐字稿(第一行 session_meta)走 collect_codex_turn_actions。
   187	    """
   188	    if not transcript_path.is_file():
   189	        return [], []
   190	    lines = transcript_path.read_text(encoding="utf-8", errors="ignore").splitlines()
   191	    first = next((l for l in lines if l.strip()), "")
   192	    try:
   193	        first_obj = json.loads(first) if first else None
   194	    except json.JSONDecodeError:
   195	        first_obj = None
   196	    if _is_codex_transcript(first_obj):
   197	        return collect_codex_turn_actions(lines)
   198	    turn_lines = []
   199	    for line in reversed(lines):
   200	        if not line.strip():
   201	            continue
   202	        try:
   203	            obj = json.loads(line)
   204	        except json.JSONDecodeError:
   205	            continue
   206	        if _is_real_user_input(obj):
   207	            break
   208	        turn_lines.append(obj)
   209	    turn_lines.reverse()
   210	
   211	    file_paths: list[str] = []
   212	    bash_commands: list[str] = []
   213	    for obj in turn_lines:
   214	        if obj.get("type") != "assistant":
   215	            continue
   216	        for item in obj.get("message", {}).get("content", []) or []:
   217	            if not isinstance(item, dict) or item.get("type") != "tool_use":
   218	                continue
   219	            name = item.get("name", "")
   220	            inp = item.get("input", {}) or {}
   221	            if name in EDIT_TOOLS:
   222	                fp = inp.get("file_path", "")
   223	                if fp:
   224	                    file_paths.append(fp)
   225	            elif name == "Bash":
   226	                cmd = inp.get("command", "")
   227	                if cmd:
   228	                    bash_commands.append(cmd)
   229	    return file_paths, bash_commands
