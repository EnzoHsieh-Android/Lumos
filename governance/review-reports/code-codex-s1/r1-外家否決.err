   509	def main() -> int:
   510	    try:
   511	        payload = json.loads(sys.stdin.read())
   512	    except json.JSONDecodeError:
   513	        return 0  # fail-open
   514	
   515	    # 只處理 Edit/Write/MultiEdit
   516	    tool_name = payload.get("tool_name", "")
   517	    if tool_name not in EDIT_TOOLS:
   518	        return 0
   519	
   520	    # repo root: 優先 $CLAUDE_PROJECT_DIR,fallback payload cwd(同 check-graph-sync.py:348-355)
   521	    # ★先算 repo 再 hook_decide★:無副檔名檔的 shebang 判定要用 repo 解相對路徑(前置修正①)
   522	    repo = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd", "")
   523	    paths, overflow = hook_decide_paths(payload, repo=repo or None)
   524	    if not paths:
   525	        return 0  # 放行:非 code 或排除路徑
   526	    if not repo:
   527	        return 0  # fail-open
   528	    lumos = _find_lumos_script()
   529	    if lumos is None:
   530	        return 0  # lumos 不在 PATH/repo → fail-open
   531	    # 多檔(Codex apply_patch):逐檔算、合併輸出;總預算 APPLY_PATCH_BUDGET_SEC,超預算後面的只列名
   532	    session_id = payload.get("session_id", "")
   533	    t0 = time.monotonic()
   534	    chunks: list[str] = []
   535	    skipped: list[str] = list(overflow)
   536	    for i, fp in enumerate(paths):
   537	        left = APPLY_PATCH_BUDGET_SEC - (time.monotonic() - t0)
   538	        if i > 0 and left < 3:
   539	            skipped.extend(paths[i:])
   540	            break
   541	        ctx = _impact_for_file(payload, repo, fp, session_id, lumos, timeout=min(30.0, max(3.0, left)))
   542	        if ctx:
   543	            chunks.append(ctx)
   544	    if skipped:
   545	        chunks.append("(多檔 patch 只算了前 " + str(len(paths) - len([s for s in skipped if s in paths])) + " 檔,其餘只列名:" + ",".join(skipped[:10]) + ")")
   546	    if not chunks or all(c.startswith("(多檔") for c in chunks):
   547	        return 0
   548	    print(json.dumps({"hookSpecificOutput": {
   549	        "hookEventName": "PreToolUse",
   550	        "additionalContext": "\n\n".join(chunks),
   551	    }}, ensure_ascii=False))
   552	    return 0
   553	
