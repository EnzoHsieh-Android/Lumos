+    check("s1-impact: 不是 patch 文字 → []", m.extract_patch_paths("echo hi") == [] and m.extract_patch_paths(None) == [], "")
+    pl = {"tool_name": "apply_patch", "tool_input": {"command": patch_txt}, "cwd": "/tmp"}
