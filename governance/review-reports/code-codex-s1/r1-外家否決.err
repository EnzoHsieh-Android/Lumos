    79	def extract_paths(payload: dict) -> list[str]:
    80	    """payload → 這次改動碰到的檔案清單。Claude(Edit/Write/MultiEdit):tool_input.file_path 一個;
    81	    Codex(apply_patch):tool_input.command 是 patch 全文、沒有 file_path,解標頭(可多檔)。"""
    82	    ti = payload.get("tool_input") or {}
    83	    if payload.get("tool_name") == "apply_patch":
    84	        return extract_patch_paths(ti.get("command", ""))
    85	    fp = ti.get("file_path")
    86	    return [fp] if fp else []
    87	
