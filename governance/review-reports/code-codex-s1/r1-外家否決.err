+    many = "*** Begin Patch\n" + "".join(f"*** Update File: f{i}.py\n@@\n-1\n+2\n" for i in range(8)) + "*** End Patch"
+    kept, over = m.hook_decide_paths({"tool_name": "apply_patch", "tool_input": {"command": many}})
