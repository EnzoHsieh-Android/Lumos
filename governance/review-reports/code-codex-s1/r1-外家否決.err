    89	def extract_path(payload: dict) -> str | None:
    90	    """從 hook payload 取「第一個」路徑(相容既有呼叫/測試;多檔用 extract_paths)。
    91	
    92	    r8-F9 / r9-F8 說明:file_path 在 tool_input 巢狀 dict 內,非頂層。
    93	    MultiEdit 亦同。
    94	    """
    95	    ps = extract_paths(payload)
    96	    return ps[0] if ps else None
