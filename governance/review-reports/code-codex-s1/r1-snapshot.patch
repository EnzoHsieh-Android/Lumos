+# ── armed 檔(Codex 側派工鏡頭;Projects/Codex完全支援_計劃 d3,2026-09-04)──────────────────────
+# Codex 的 spawn_agent 訊息對 hook 是密文、改不了;子代理開場(SubagentStart)的 additionalContext 才到得了。
+# 所以範圍由編排者「派工前一刻」武裝:算好鏡頭文字落 ~/.cache/lumos/dispatch-lens/armed/<key>/,
+# N 個 token 檔=N 席;SubagentStart hook 叫 --claim:先驗 TTL(過期整夾刪、不回),再 os.rename 原子認領一個 token
+# (同時多個子代理不會重複扣/重複標號),認領不到不回;歸零即刪。
+# 承認界線:token 不分收件人,同 repo 同窗口的無關子代理會搶走席位——首行印 range/席次讓錯席可見,不宣稱消滅。
+_LENS_ARM_TTL_SEC = 600
+
+
+def _lens_armed_root():
+    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / "armed"
+
+
+def _lens_repo_key(root):
+    """寫讀兩端同一支:repo 根 realpath 的 sha256(r1 邊界 F4:symlink/尾斜線表示法不同會對不上)。"""
+    import hashlib
+    return hashlib.sha256(str(Path(os.path.realpath(str(root)))).encode("utf-8")).hexdigest()[:32]
+
+
+def _lens_repo_root(repo):
+    start = Path(repo) if repo else Path.cwd()
+    r = _lens_git(start, "rev-parse", "--show-toplevel")
+    if r is None or r.returncode != 0 or not r.stdout.strip():
+        return None
+    return Path(r.stdout.strip())
+
+
+def _lens_arm_dir_ok(d):
+    """armed 目錄安全檢查:是目錄、owner 是自己(posix)。"""
+    try:
+        st = d.stat()
+    except OSError:
+        return False
+    if not d.is_dir():
+        return False
+    if hasattr(os, "getuid") and st.st_uid != os.getuid():
+        return False
+    return True
