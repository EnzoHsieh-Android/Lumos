+def cmd_dispatch_lens_claim(repo=None, as_json=False):
+    """SubagentStart hook 叫:先驗 TTL,再原子認領一席。回 JSON {text|null, reason, seat, seats, range}。"""
+    import json as _json, shutil, time as _time
+    root = _lens_repo_root(repo)
+    out = {"text": None, "reason": "not-armed", "seat": None, "seats": None, "range": None}
+    def _emit(o):
+        if as_json:
+            print(_json.dumps(o, ensure_ascii=False))
+        elif o.get("text"):
+            print(o["text"])
+        else:
+            print(f"(沒領到席:{o.get('reason')})")
+        return 0
+    if root is None:
+        out["reason"] = "not-a-repo"
+        return _emit(out)
+    d = _lens_armed_root() / _lens_repo_key(root)
+    if not _lens_arm_dir_ok(d):
+        return _emit(out)
+    try:
+        meta = _json.loads((d / "meta.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        shutil.rmtree(d, ignore_errors=True)
+        out["reason"] = "broken"
+        return _emit(out)
+    out["range"], out["seats"] = meta.get("range"), meta.get("seats")
+    if _time.time() - float(meta.get("ts") or 0) > _LENS_ARM_TTL_SEC:   # ★TTL 先於認領★(r2 邊界 N7)
+        shutil.rmtree(d, ignore_errors=True)
+        out["reason"] = "expired"
+        return _emit(out)
+    toks = sorted(p for p in d.glob("tok-*") if p.suffix != ".claimed")
+    claimed = None
+    for t in toks:
+        try:
+            os.rename(t, t.with_suffix(".claimed"))   # 原子:兩個 hook 同時來只有一個成功(r2 外家 #22/邊界 N3)
+            claimed = t
+            break
+        except OSError:
+            continue
+    if claimed is None:
+        out["reason"] = "exhausted"
+        return _emit(out)
+    remaining = len([p for p in d.glob("tok-*") if p.suffix != ".claimed"])
+    seats = int(meta.get("seats") or 0)
+    seat = seats - remaining
+    head = f"LUMOS-LENS range={meta.get('range')} 第 {seat}/{seats} 席(lumos 自動附加:派工前武裝的圖譜鏡頭;領錯席時以這行對照)"
+    out.update({"text": head + "\n" + (meta.get("text") or ""), "reason": "ok", "seat": seat})
+    if remaining == 0:
+        shutil.rmtree(d, ignore_errors=True)      # 歸零即刪
+    return _emit(out)
+
