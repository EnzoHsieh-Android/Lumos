index 3d36faa1c..d62569000 100755
--- a/scripts/lumos
+++ b/scripts/lumos
@@ -80350,28 +80350,29 @@ def _choice_cov_test_srcset(parent, name, root):
     """src 底下的測試原始碼集資料夾(Gradle 原始碼集名的形狀):test、androidTest 本身或後面接大寫開頭的變體(testDebug、androidTestFree、testFixtures),
     或小寫開頭、Test 結尾(多平台 jvmTest、commonTest)。只在上一層叫 src 而且不是走訪的根本身時算:主程式裡叫 testapp、test 的套件資料夾不跳,
     傳統 Java 版面以 src 當根時根底下的頂層套件也不跳。"""
     return parent != root and os.path.basename(parent) == "src" and bool(_CHOICE_COV_TEST_SRCSET_RE.fullmatch(name))
 
 
 def _choice_cov_src_pkgs(root):
     """平台主程式的套件(〈用詞〉專案類別):root 底下 .kt、.java 檔的 package 宣告(斜線分隔;每支只讀開頭 _CHOICE_COV_SRC_HEAD;反引號與檔首 BOM 去掉)。
     任何深度跳 _CHOICE_COV_SRC_SKIP,共用 CODE_SKIP_DIRS 的其他名字只在還沒進到 src 時跳(_CHOICE_COV_SRC_SKIP_OUTSIDE),src 底下的測試原始碼集
     (_choice_cov_test_srcset;測試自己的類別不算專案類別)不收;區塊註解先蓋掉再找 package;不跟符號連結、只開一般檔。
-    看滿 _CHOICE_COV_SRC_MAX 支原始碼或 _CHOICE_COV_SRC_ENTRIES 個檔就停、印一行提醒(漏收的套件只會讓那幾支被判不明,方向是多跑)→ 套件集合。"""
+    資料夾與檔案照名字排序走。看滿 _CHOICE_COV_SRC_MAX 支原始碼或 _CHOICE_COV_SRC_ENTRIES 個檔就停、印一行提醒(漏收的套件只會讓那幾支被判不明,方向是多跑)→ 套件集合。"""
     out, seen, entries = set(), 0, 0
     root = os.path.normpath(str(root))
     for d, subs, files in os.walk(root, followlinks=False):
         in_src = "src" in Path(os.path.relpath(d, root)).parts
         subs[:] = [s for s in subs if s not in _CHOICE_COV_SRC_SKIP and (in_src or s not in _CHOICE_COV_SRC_SKIP_OUTSIDE)
                    and not _choice_cov_test_srcset(d, s, root)]
-        for f in files:
+        subs.sort()   # 照名字走:看滿上限時收到哪些套件每台機器都一樣(os.walk 的順序跟著檔案系統,Linux 與 macOS 不同)
+        for f in sorted(files):
             entries += 1
             if f.endswith((".kt", ".java")):
                 seen += 1
             if seen > _CHOICE_COV_SRC_MAX or entries > _CHOICE_COV_SRC_ENTRIES:
                 print(f"⚠ 掃主程式套件看滿上限({_CHOICE_COV_SRC_MAX} 支原始碼或 {_CHOICE_COV_SRC_ENTRIES} 個檔),後面的套件沒收;只碰那些套件的測試會判成不明、照跑",
                       file=sys.stderr)
                 return out
             if not f.endswith((".kt", ".java")):
                 continue
             fp = os.path.join(d, f)
