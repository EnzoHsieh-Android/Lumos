 29478	def _drift_m1_ledger(root, mode, base, tip, res, found, note):
 29479	    """記一筆治理帳(gate drift-check;欄位攤平在事件最外層,check=old-sentence)。found=(要處理, 只列出)(扣掉已表態)。"""
