  1179	def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
  1180	                ref=None, nodes=None, extra=None):
  1181	    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。
  1182	
  1183	    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
  1184	    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
  1185	    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
  1186	    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
  1187	    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。
  1188	
  1189	    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
  1190	    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
  1191	    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
  1192	    逐 ref 的事件另外帶那一行真正的 sha。
  1193	
  1194	    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
  1195	    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
  1196	    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
  1197	    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
  1198	    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
  1199	    """
  1200	    import json as _json
  1201	    root = Path(repo_root)
  1202	    docs = root / "docs"
  1203	    if not docs.is_dir():
  1204	        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
  1205	        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
  1206	        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
  1207	        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
  1208	        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
  1209	        return None
  1210	    if not head_sha:
  1211	        try:
  1212	            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
  1213	        except Exception:
  1214	            head_sha = ""
  1215	    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
  1216	    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
  1217	    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
  1218	    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
  1219	    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
  1220	    if gate not in _KNOWN_GATES:
  1221	        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
  1222	              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
  1223	              file=sys.stderr)
  1224	        return False
  1225	    ev = _gate_event_build(repo_root, gate, kind, note, hard=hard, head_sha=head_sha, ref=ref, nodes=nodes, extra=extra)
  1226	    try:
  1227	        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
  1228	            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
  1229	        return True
  1230	    except OSError:
  1231	        return False
