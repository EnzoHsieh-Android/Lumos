 29447	def _drift_m1_ledger_miss(root, tip, state):
 29448	    """治理帳寫不進去時的留痕:~/.cache/lumos/drift-m1/ledger-miss.jsonl 追加一行(REVISIT 讀它算樣本不足)。"""
 29449	    import json as _j, datetime as _dt
 29450	    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-m1"):
 29451	        return False
 29452	    d = Path.home() / ".cache" / "lumos" / "drift-m1"
 29453	    if not _trusted_private_dir(d, ".cache", "lumos", "drift-m1"):
 29454	        return False
 29455	    line = _j.dumps({"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
 29456	                     "repo": _drift_m1_show(os.path.realpath(str(root))), "head_sha": tip, "state": state},
 29457	                    ensure_ascii=False) + "\n"
 29458	    try:
 29459	        # O_NONBLOCK:有人在這裡放了同名 FIFO 時開檔不會卡住推送(沒有讀端就直接失敗);開了再確認是自己的一般檔
 29460	        # (代碼審 r2 邊界席)
 29461	        fd = os.open(str(d / "ledger-miss.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
 29462	                     | getattr(os, "O_NONBLOCK", 0), 0o600)
 29463	        try:
 29464	            import stat as _stat
 29465	            fst = os.fstat(fd)
 29466	            if not _stat.S_ISREG(fst.st_mode) or (hasattr(os, "getuid") and fst.st_uid != os.getuid()):
 29467	                return False
 29468	            data = line.encode("utf-8")
 29469	            if os.write(fd, data) != len(data):   # 比照 _ledger_append:短寫(磁碟滿)不算寫成
 29470	                return False
 29471	        finally:
 29472	            os.close(fd)
 29473	        return True
 29474	    except OSError:
 29475	        return False
