   169	      echo ""
   170	      echo "看完整改動:"
   171	      echo "   git diff --cached -- ${GRAPH_ROOT}"
   172	      echo "還原那個檔:"
   173	      echo "   git checkout -- <檔案>"
   174	      echo "真的是刻意要這樣(非常少見)→ git commit --no-verify"
   175	      echo ""
