  1234	def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
  1235	    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
  1236	    ok = _gate_event(repo_root, gate, kind, note, **kw)
  1237	    if ok is None:
  1238	        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
  1239	    if not ok:
