 29481	    st = res["state"]
 29482	    judged = st not in _DRIFT_M1_UNKNOWN
 29483	    busy = _drift_m1_busy(res, handle)
 29484	    # no-base 記 range-unavailable(既有結果詞,跟綁定測試閘算不出範圍同一個):原本記 skipped,gov --stats 會把它算進
