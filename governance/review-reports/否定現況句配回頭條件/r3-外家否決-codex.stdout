 29429	def _drift_m1_fit(root, kind, note, hard, tip, nodes, extra):
 29430	    """整行(照 _ledger_append 的量法,量 _gate_event_build 組出的完整事件)超過 4096 位元組:先從只列出、再從要處理尾端丟 rows;
 29431	    丟光還超過 → nodes 截到 20;再超過照寫。有截就記 rows_truncated。"""
 29432	    import json as _j
 29433	
 29434	    def size():
 29435	        ev = _gate_event_build(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra)
 29436	        return len((_j.dumps(ev, ensure_ascii=False) + "\n").encode("utf-8"))
 29437	    rows = extra.get("rows")
 29438	    while rows and size() > 4096:
