 27645	def _drift_ack_heading(lines, line):
 27646	    """那一行往上最近的標題文字(沒有回空字串)。"""
 27647	    for ln in reversed(lines[:line]):
 27648	        if ln.startswith("#"):
 27649	            return ln.lstrip("#").strip()
 27650	    return ""
