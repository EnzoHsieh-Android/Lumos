 27621	def _drift_ack_args_err(kind, reason, names=None):
 27622	    if kind not in _DRIFT_KINDS:
 27623	        return f"--kind 只能是 {'/'.join(_DRIFT_KINDS)}"
 27624	    nerr = _drift_ack_names_err(kind, names)
 27625	    if nerr:
 27626	        return nerr
 27627	    if len((reason or "").strip()) < 4 or not _drift_one_line(reason or ""):
 27628	        return "--reason 要寫為什麼照留,一行、至少 4 個字"
 27629	    return _drift_placeholder_err(reason, "--reason")
