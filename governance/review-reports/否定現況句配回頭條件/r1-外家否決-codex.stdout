   317	def _label_table(rows, labels):
   318	    byid = {r["id"]: r for r in rows}
   319	    for pool in ("narrow", "refined", "broadonly"):
   320	        ls = [v for k, v in labels.items() if v.get("pool") == pool]
   321	        if not ls:
   322	            continue
   323	        cnt = Counter(v["label"] for v in ls)
   324	        print(f"\n[人工判 {pool}] n={len(ls)} ", dict(cnt))
   325	        print("  真的那幾行該配哪種條件:", dict(Counter(v["key"] for v in ls if v["label"] == "T")))
   326	        if pool == "broadonly":
   327	            tok = Counter()
   328	            for k, v in labels.items():
   329	                if v.get("pool") == pool and v["label"] != "T" and k in byid:
   330	                    tok.update(byid[k]["broad"])
   331	            print("  寬表誤觸(非真列)各字眼出現次數:", dict(tok.most_common()))
   332	
