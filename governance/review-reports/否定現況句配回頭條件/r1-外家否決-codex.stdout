 26916	def _drift_m1_flags(tree):
 26917	    """任何 add_argument(...) 呼叫(p.add_argument 或裸的 add_argument)位置參數裡以 -- 開頭的字串常數。"""
 26918	    import ast as _ast
 26919	    out = set()
 26920	    for node in _ast.walk(tree):
 27230	    # 任一確定受影響就是候選;判不了的不提前停(代碼審 r3 外家席:原本前一個判不了就回判不了,後面確定受影響的
 27231	    # 那條本來可以列成可表態的發現)
 27232	    if any(hits):
 27233	        return True
 27234	    return None if any(h is None for h in hits) else False
