 25498	def _note_audit_config(text):
 25499	    """被檢查版本的 .lumos/config.json 內容(bytes 或 None)→ (gate, warnings)。照 _note_shape_config 的讀法。"""
 25500	    import json as _j
 25501	    if text is None:
 25502	        return "block", []
 25503	    try:
 25504	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 25505	    except (ValueError, UnicodeDecodeError):
 25506	        return "block", [".lumos/config.json 讀不成 JSON,筆記內容審照預設 block"]
 25507	    na = cfg.get("note_audit") if isinstance(cfg, dict) else None
 25508	    if na is not None and not isinstance(na, dict):
 25509	        return "block", ["設定檔的 note_audit 不是物件(要寫成 {\"note_audit\": {\"gate\": \"warn\"}}),筆記內容審照預設 block"]
 25510	    g = na.get("gate") if isinstance(na, dict) else None
 26640	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
 26641	    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
 26642	    if tenv is None:
 26643	        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
 26644	    if _left() <= 0:
 26645	        return [], [], [over]
 26646	    reader = _nodehome_reader(root, tip)
 26647	    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
 26648	    if ev is None:
 26649	        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
 26650	    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
 26651	               if _note_unreadable(n) and p in ev["touched"]]
 26652	    must, listed = [], []
 26653	    for f in _drift_state_findings(tenv):
 26654	        p, k = f["path"], f["kind"]
 26655	        if k == "c1":
 26656	            if p in ev["passed"]:
 26657	                must.append(f)
 26658	            continue
 26659	        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
 26660	        if hit:
 26661	            listed.append(f)
 26662	    if _left() <= 0:
 26663	        return must, listed, [*unknown, over]
 26664	    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
 26665	    return must + pm, listed + pl, unknown + pu
