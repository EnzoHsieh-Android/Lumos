 27839	def _drift_hint_key(f):
 27840	    """改法去重鍵:c1 一篇一條;m1 帶名稱集合(同一行不同名稱集合是兩條表態);其他一行一條。"""
 27841	    if f["kind"] == "c1":
 27842	        return f["kind"], f["path"]
 27843	    if f["kind"] == "m1":
 27844	        return f["kind"], f["path"], f["line"], tuple(sorted(f.get("names") or ()))
 27845	    return f["kind"], f["path"], f["line"]
