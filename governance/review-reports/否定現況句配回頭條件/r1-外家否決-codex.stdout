 27339	def _drift_row_unread(conds, envs, trees):
 27340	    """這一行的條件實際碰到、而且讀不出來的檔或筆記(r4 正確性席:原本點名整棵樹讀不出的全部檔,
 27341	    status 判不了的行反而點名一支無關的程式檔)。帶路徑的 symbol/test 看那一支;不帶路徑的看讀不出的程式檔;
 27342	    status 看指到的那篇筆記。"""
 27343	    out = set()
 27344	    for k, v in conds:
 27345	        if k == "status":
 27346	            for env in envs:
 27347	                rel, n, _want = _drift_status_target(env, v)
 27348	                if n is not None and _note_unreadable(n):
 27349	                    out.add(rel)
 27350	        elif k in ("symbol", "test"):
 27351	            for t in trees:
