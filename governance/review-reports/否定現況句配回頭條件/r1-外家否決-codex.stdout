 25379	def cmd_note_shape(repo=None, staged=False, diff_range=None):
 25380	    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
 25381	    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
 25382	    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
 25383	    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
 25384	    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
 25385	    root = Path(repo).resolve() if repo else None
 25386	    if root is None:
 25387	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 25388	        if r is None or r.returncode != 0:
 25389	            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 25390	            return 0
 25391	        root = Path(r.stdout.strip())
 25392	    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
 25393	    if r is None or r.returncode != 0:
 25394	        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 25395	        return 0
 25396	    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE") == "1":        # 只認 1,跟 LUMOS_SKIP_BOUND_TESTS 等鄰居一致(筆記內容審代碼審 r1 同族修)
 25397	        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
 25398	        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
 25399	        return 0
 25400	    if staged:
 25401	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 25402	        if mh is not None and mh.returncode == 0:
 25403	            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
 25404	            return 0
 25405	        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
 25406	    else:
 25407	        rg = _lens_range_ok(diff_range)
 25408	        if rg is None:
 25409	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 25410	            return 2
 25411	        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 25412	        if sh is not None and sh.stdout.strip() == "true":
 25413	            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
 25414	                  file=sys.stderr)
