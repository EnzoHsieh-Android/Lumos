 27574	def _drift_ack_seq(a):
 27575	    v = a.get("seq")
 27576	    return v if isinstance(v, int) and not isinstance(v, bool) else 0
 27577	
 27578	
 27579	def _drift_seq_ok(a):
 27580	    v = a.get("seq")
 27581	    return isinstance(v, int) and not isinstance(v, bool) and v > 0
 27582	
 27583	
 27584	def _drift_bound_latest(rows):
 27585	    """同一個鍵、記了 related 的表態裡 seq 最大的那幾筆(同號的全算;兩個工作樹各自追加後合併可能同號)。"""
 27586	    if not rows:
 27587	        return []
 27588	    top = max(_drift_ack_seq(a) for a in rows)
 27589	    return [a for a in rows if _drift_ack_seq(a) == top]
 27590	
 27591	
 27592	def _drift_related_ok(a):
 27593	    """related 要是字串清單;手改壞了當成沒涵蓋。"""
 27594	    r = a.get("related")
 27595	    return isinstance(r, list) and all(isinstance(x, str) for x in r)
 27596	
 27597	
 27598	def _drift_prev_ack_line(f):
 27599	    """c2/c3 以前表態過、現在清單多了新的 → 要印的一句;沒有回 None。"""
 27600	    pa = f.get("prev_ack")
 27601	    if not pa:
 27602	        return None
 27603	    old = [str(x) for x in pa["related"]] if isinstance(pa.get("related"), list) else []
 27604	    more = [x for x in f.get("related", []) if nfc(str(x)) not in {nfc(y) for y in old}]
 27605	    return (f"這篇以前表態過(最近一次當時連著 {'、'.join(x[:-3] for x in old) or '(清單壞了)'}),"
 27606	            f"現在多了 {'、'.join(str(x)[:-3] for x in more) or '(清單壞了,讀不出)'};最近一次理由:{str(pa.get('reason') or '')[:80]}")
 27607	
 27608	
 27609	def _drift_old_reason(f, acks, alive=None):
 27610	    """表態失效時(筆記改名),用「原文與種類相同」找舊理由供照抄。alive=現在還在的筆記路徑(repo 相對):
 27611	    表態原本那篇還在,就不是改名、是另一篇剛好一樣的樣板句——不借它的理由(代碼審 r1 正確性席:
 27612	    守衛紀錄的預告句是樣板,兩篇會一字不差,原本會把 A 的理由印給從沒表態過的 B)。"""
 27613	    for a in reversed(acks):
 27614	        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
 27615	            if alive is not None and nfc(str(a.get("path"))) in alive:
 27616	                continue
 27617	            return a.get("reason")
 27618	    return None
