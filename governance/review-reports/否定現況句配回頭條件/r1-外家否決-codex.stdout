 28626	# ── 舊句檢查 m1(Projects/舊句檢查_計劃;家 [[Systems/存量漂移守衛]])─────────────────────────────────
 28627	# 程式裡的名稱(函式、類別、指派、旗標、被刪的程式檔路徑)這次推送消失了,筆記還在講它的句子。判法逐字照參考實作
 28628	# governance/eval/drift-exam/old-sentence/old_sentence_exp.py 的 P4r3;跟它刻意不同的地方只有計劃〈與參考實作的刻意差異〉
 28629	# 那幾條(程式檔清單、剖不動與太大的檔用文字抽定義、去 BOM、讀不出的筆記、空樹起點、時間上限與快取、名稱太長不列)。
 28630	# 判定另開一支、不放進 _drift_check_core(那支也給考試與歷史重放用,放進去會改掉既有噪音基準)。
 28631	_DRIFT_M1_DEFS_SCHEMA = 1                       # 抽法(_drift_py_names m1、_drift_m1_text_defs)一改就加一:舊快取自然不命中
 28632	_DRIFT_M1_PARSE_MAX_BYTES = 4 * 1024 * 1024     # 大於它的 blob 不用 ast(尖峰記憶體約原始碼 100 到 280 倍),改文字抽定義
 28633	_DRIFT_M1_BUDGET_SEC = 30                       # m1 自己的截止時間,不吃 c1 到 c5 與 probe 剩下的
 28634	_DRIFT_M1_DEFS_TTL = 14 * 86400                 # 定義快取保鮮期(值同 bound-filter 的 _FILTER_PROBE_TTL)
 28635	_DRIFT_M1_PREFILTER_MIN = 200                   # 候選名稱超過這個數才先篩(先篩不改結果,只影響時間)
 28636	_DRIFT_M1_NAME_MAX = 200                        # 候選名稱與表態 --name 的長度上限
 28637	# 單行長度上限:比對一行的時間約「行長 × 這一行可能命中的名稱數」,中間沒辦法看截止時間;超過的行不掃、計數寫進結論行與帳。
 28638	# 值取兩份圖譜(工具鏈、rtb 全部筆記,2026-09-30 量)最長一行 10003 字的兩倍,一般筆記碰不到(代碼審 r1 資安席、邊界席)
 28639	_DRIFT_M1_LINE_MAX = 20000
 28640	# 句內歷史字眼 54 個:符號檢查否定詞 26 個(抄自 NEG_LEXICONS["zh"] 當時的內容,★不引用它★:那份為符號檢查自己的理由增減,
 28641	# m1 的準度是對這 54 個量的)+ 25 個 + 3 個詞組。ASCII 字眼整字比、大小寫敏感;中文照子字串比。
 28642	_DRIFT_M1_HIST_WORDS = (
 28643	    "零命中", "已移除", "不存在", "查無", "已刪", "從未", "已退役", "移除", "無此", "原記", "舊名", "改名", "已改", "棄用",
 28644	    "不使用", "廢棄", "停用", "未使用", "dead", "removed", "deleted", "no longer", "renamed", "deprecated", "unused",
 28645	    "obsolete",
 28646	    "撤除", "撤掉", "拿掉", "原寫", "原本", "原先", "不再", "舊版", "舊的", "刪除", "刪掉", "取代", "搬到", "搬去", "改為",
 28647	    "改叫", "改成", "曾", "前身", "撤", "刪", "拔掉", "去掉", "不帶", "沒有",
 28648	    "當時叫", "擴成", "改名為")
 28649	_DRIFT_M1_HIST_RX = re.compile("|".join(
 28650	    (r"(?<![A-Za-z0-9_])" + re.escape(w) + r"(?![A-Za-z0-9_])") if w.isascii() else re.escape(w)
 28651	    for w in sorted(set(_DRIFT_M1_HIST_WORDS), key=len, reverse=True)))
 28652	_DRIFT_M1_RETIRE_WORDS = ("撤除", "撤掉", "作廢", "已失效", "已過時", "不是現況", "被取代", "已凍結", "superseded",
 28653	                          "已結案", "歷史紀錄", "Superseded")
 28654	_DRIFT_M1_NOT_YET_RE = re.compile(r"(尚未|還沒|未)(撤除|撤掉|作廢|失效|取代|凍結|結案)")
 28655	_DRIFT_M1_SCOPE_WORDS = ("下面", "以下", "本節", "這一節", "整篇", "之後")
 28656	_DRIFT_M1_HEAD_RE = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
 28657	_DRIFT_M1_CUT_RE = re.compile(r"[。;；!?！？]")
 28658	# 文字抽定義:跟 _drift_py_def_re(name, test=False) 同一組形狀(任何縮排的 def/class/async def,不縮排的「名 =」
 28659	# 「名: 型別 = 值」),加 add_argument( 後面緊接的引號旗標;t_drift_m1_unparsable_files 釘兩者對同一批名稱判斷一致
 28660	_DRIFT_M1_TEXT_DEF_RE = re.compile(r"^[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+(\w+)|^(\w+)[ \t]*(?::[^=\n]*)?=(?!=)", re.M)
 29550	
 29551	def _drift_vault_of(env):
 29552	    root = _vault_repo_root(env)
 29553	    try:
 29554	        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 29555	    except ValueError:
 29556	        return root, env.vault.name
 29557	
 29558	
 29559	def cmd_drift_scan(env, at=None, as_json=False, budget=None):
 29560	    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
 29561	    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
 29562	    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
 29563	    import json as _j, math as _m, time as _t
 29564	    budget = _DRIFT_BUDGET_SEC if budget is None else budget
 29565	    if not _m.isfinite(budget) or not 0 < budget <= 86400:
 29566	        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
 29567	        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
 29568	        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
 29569	        return 2
 29570	    deadline = _t.monotonic() + budget
 29571	    root, vault_rel = _drift_vault_of(env)
 29572	    tenv, sha = env, None
 29573	    if at:
 29574	        sha = _lens_full_sha(root, at)
 29575	        if sha is None:
 29576	            print(f"擋下:找不到提交 {at}", file=sys.stderr)
 29577	            return 2
 29578	        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
 29579	        vault_rel = _drift_vault_rel(root, sha) or vault_rel
 29580	        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
 29581	        if tenv is None:
 29582	            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
 29583	            return 2
 29584	    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
 29585	    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
 29586	    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
 29587	    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
 29588	    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
 29589	    if as_json:
 29590	        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
 29591	                        "problems": [{"path": p, "line": n, "text": t, "why": w} for p, n, t, w in probs],
 29592	                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
 29593	                       ensure_ascii=False, indent=1))
 29594	        return 0
 29595	    _drift_scan_print(at, left, done, bad, probs)
 29596	    return 0
 29597	
 29598	
 29599	def _drift_scan_print(at, left, done, bad, probs=()):
 29600	    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)、回頭條件的問題。"""
 29601	    if bad:   # 路徑與原文都來自筆記,印之前換掉控制字元(代碼審 r5 資安席)
 29602	        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(_esc_clean(b) for b in bad[:10]))
 29603	    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_SCAN_KINDS}
 29604	    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_SCAN_KINDS if k != "probe")
 29605	          + (f";已表態 {len(done)}" if done else ""))
 29606	    for k in _DRIFT_SCAN_KINDS:
 29607	        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
 29608	        if rows:
 29609	            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
 29610	            for f, acked in rows:
 29611	                print(f"  {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 70)}" + ("  (已表態)" if acked else ""))
 29612	                if not acked:
 29613	                    print(f"      {_esc_clean(f['why'], 1000)}")
 29614	                    if _drift_prev_ack_line(f):
 29615	                        print(f"      ({_esc_clean(_drift_prev_ack_line(f), 400)})")
 29616	            _drift_print_hints([f for f, acked in rows if not acked], sys.stdout, "  改法:")
 29617	    if probs:
 29618	        print(f"[回頭條件的問題] {len(probs)} 處(寫錯、沒帶期限、指不到、寫在不評估的地方、判不了):")
 29619	        for p, n, t, w in probs:
 29620	            print(f"  {_esc_clean(p)}:{n}  {_esc_clean(t, 70)}")
 29621	            print(f"      {_esc_clean(w, 1000)}")
 29622	
 29623	
 29624	def _drift_doctor_lines(env):
 29625	    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
 29626	    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
 29627	    root, vault_rel = _drift_vault_of(env)
 29628	    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
 29629	    out = []
 29630	    # 乙:只讀筆記、不評估條件(要看哪些成立跑 drift scan)
 29631	    n_rows = n_noby = n_bad = n_dead = 0
 29632	    for p in env.notes:
 29633	        rows, dead = _probe_lines(env_text(env, p) or "")
 29634	        n_rows += len(rows)
 29635	        n_dead += len(dead)
 29636	        n_noby += sum(1 for _n, _t, pr in rows if pr["by"] is None)
 29637	        n_bad += sum(1 for _n, _t, pr in rows if pr["errs"])
 29638	    if n_rows or n_dead:
 29639	        out.append(f"條件式回頭條件 {n_rows} 條(由 lumos drift scan 評估)"
 29640	                   + (f";沒帶期限 {n_noby} 條" if n_noby else "") + (f";寫錯的 {n_bad} 條" if n_bad else "")
 29641	                   + (f";寫在不評估的地方 {n_dead} 處" if n_dead else ""))
 29642	    for k in ("c1", "c2", "c3", "c4", "c5"):
 29643	        rows = [f for f in left if f["kind"] == k]
 29644	        nd = sum(1 for f in done if f["kind"] == k)
 29645	        if rows:     # 只剩已表態的不開段(全靜默;代碼審 r2 正確性席:表態完那一段永遠不會安靜);全部清單看 drift scan
 29646	            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
 29647	            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else "")
 29648	                       + ";改法例:" + _drift_fix_hint(k, rows[0]["path"], rows[0]["line"])[0])
 29649	    return out
 29650	
