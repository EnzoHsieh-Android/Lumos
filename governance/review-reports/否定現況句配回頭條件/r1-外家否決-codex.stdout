 27297	def _drift_with_layout(ch, base, tip, tree_of):
 27298	    """兩端版面不一樣時把範圍改動標成形狀改變(所有不帶路徑的行都當候選);沒有起點(空樹)或已經是形狀改變就不看。"""
 27299	    if not base or ch["code_shape"] or not _drift_layout_changed(tree_of(base), tree_of(tip)):
 27300	        return ch
 27301	    return dict(ch, code_shape=True)
