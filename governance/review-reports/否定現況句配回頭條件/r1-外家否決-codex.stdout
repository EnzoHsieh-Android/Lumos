   198	def scan_note(text, new_nos):
   199	    """一篇筆記終點全文 + 新行號 → 命中列。"""
   200	    lines = text.split("\n")
   201	    regions = LM._notelines_regions(text)
   202	    vis = {no for no, _l in LM._visible_lines(lines)}
   203	    note_has_cond = any(LM._revisit_split(LM._strip_inline_markup(x)[0])[0] == "cond" for x in lines)
   204	    rows, stats = [], Counter()
   205	    for i in sorted(new_nos):
   206	        if i < 1 or i > len(lines) or regions[i - 1] == "other" or i not in vis:
   207	            continue
   208	        probe = LM._strip_inline_markup(lines[i - 1])[0]
   209	        if not probe.strip():
   210	            continue
   211	        if LM._revisit_split(probe)[0] is not None:
   212	            stats["revisit_lines"] += 1
   213	            continue
   214	        stats["lines"] += 1
   215	        c = classify_text(probe)
   216	        if c is None:
   217	            continue
   218	        c.update({"line": i, "region": regions[i - 1], "shape": _shape(probe), "text": lines[i - 1].strip()[:240],
   219	                  "paired": _revisit_near(lines, regions, i), "note_has_cond": note_has_cond})
   220	        rows.append(c)
   221	    return rows, stats
   222	
   223	
   224	def cmd_scan(a):
   225	    if a.commits:
   226	        commits = [x.strip() for x in Path(a.commits).read_text().split() if x.strip()]
   227	    else:
   228	        commits = git(a.repo, "log", "--no-merges", "--format=%H", f"-{a.n}", a.head).split()
   229	    tot, fh = Counter(), open(a.out, "w", encoding="utf-8")
   230	    for c in commits:
   231	        parents = git(a.repo, "log", "-1", "--format=%P", c).split()
   232	        if not parents:
   233	            continue
   234	        tot["commits"] += 1
   235	        per = added_lines(a.repo, parents[0], c, a.vault)
   236	        tot["commits_touching_notes"] += bool(per)
   237	        date = git(a.repo, "log", "-1", "--format=%ad", "--date=short", c).strip()
   238	        for p, nos in per.items():
   239	            text = git(a.repo, "show", f"{c}:{p}")
   240	            rows, st = scan_note(text, nos)
   241	            tot.update(st)
   242	            for r in rows:
   243	                r.update({"repo": a.tag, "commit": c[:8], "date": date, "note": p[len(a.vault) + 1:]})
   244	                r["id"] = f"{a.tag}:{c[:8]}:{r['note']}:{r['line']}"
   245	                fh.write(json.dumps(r, ensure_ascii=False) + "\n")
   246	    fh.write(json.dumps({"_meta": dict(tot), "tag": a.tag}, ensure_ascii=False) + "\n")
   247	    fh.close()
   248	    print(json.dumps(dict(tot), ensure_ascii=False))
   249	    return 0
