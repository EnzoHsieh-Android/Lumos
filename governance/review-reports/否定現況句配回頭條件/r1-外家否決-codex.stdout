 26846	def _drift_probe_code_path(p):
 26847	    """乙拿來判 symbol/test、算候選的檔:副檔名在清單裡或沒副檔名(要看 #!),不含 docs/、governance/。
 26848	    候選篩選(_drift_probe_changes)與語料(_DriftProbeTree.corpus)共用這一支(代碼審 r1 圖譜一致席:原本兩邊範圍不同;
 26849	    正確性席:工具鏈主程式 scripts/lumos 沒有副檔名,原本整支不在語料裡,上面的 symbol 條件全是死條件)。"""
 26850	    return _nodehome_code_kind(p) in ("ext", "shebang?") and not p.startswith(("docs/", "governance/"))
 26851	
 26852	
 26853	def _drift_probe_is_py(p, txt):
 26854	    """要不要當 Python 檔用 ast 判:.py,或沒副檔名、首行是 python 的 #!(跟 _shebang_python_blob 共用首行判定——代碼審 r2
 26855	    架構對齊席:原本另寫一份,少了 #! 門檻、多了轉小寫)。"""
 26856	    return p.endswith(".py") or (_nodehome_code_kind(p) == "shebang?" and _shebang_line_is_python(txt.split("\n", 1)[0]))
 26857	
 26858	
 26859	def _drift_py_names(txt, m1=False):
 26860	    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
 26861	    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
 26862	    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。
 26863	    m1=True(舊句檢查,Projects/舊句檢查_計劃〈做法〉1)→ (函式, 類別, 指派, 旗標) 四個集合,指派與旗標逐字照參考實作
 26864	    old_sentence_exp.py 的 _collect_assigns 與 _scan_add_argument;m1=False 時行為與回傳形狀都不變(probe 照舊)。
 26865	    ★抽法任何一次改動就把 _DRIFT_M1_DEFS_SCHEMA 加一★(定義快取以它為鍵;t_drift_m1_defs_cache 釘了輸出雜湊)。"""
 26866	    import ast as _ast
 26867	    try:
 26868	        tree = _ast.parse(txt)
 26869	    except (SyntaxError, ValueError, MemoryError, RecursionError):
 26870	        # 巢狀很深的合法檔,CPython 的解析器丟 MemoryError(「too complex to parse」)而不是 SyntaxError,
 26871	        # 原本沒接住,整支 scan 與推送檢查當掉(代碼審 r2 邊界席)。3.12 以前的解析器碰到極長運算式會直接 SIGSEGV、
 26872	        # 接不到;工具最低版本改成 3.14 之後,原本為它加的事先量測已刪([[Projects/最低Python版本改3.14_計劃]])
 26873	        return None
 26874	    funcs, classes, assigns = set(), set(), set()
 26875	    for node in _ast.walk(tree):
 26876	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
 26877	            funcs.add(node.name)
 26878	        elif isinstance(node, _ast.ClassDef):
 26879	            classes.add(node.name)
 26880	    if m1:
 26881	        return funcs, classes, _drift_m1_assigns(tree.body, True, set()), _drift_m1_flags(tree)
 26882	    for node in tree.body:
 26883	        if isinstance(node, _ast.Assign):
 26884	            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
 26885	        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
 26886	            assigns.add(node.target.id)
 26887	    return funcs, classes, assigns
 26888	
 26889	
 26890	def _drift_m1_targets(st):
 26891	    """一句指派的目標名(照參考實作 _assign_pairs + _target_names):Assign 每個目標、AnnAssign(有沒有值都算);
 26892	    tuple/list 拆包只收一層、只收直接是名稱的元素(*rest 與巢狀的不收)。"""
 26893	    import ast as _ast
 26894	    tgts = list(st.targets) if isinstance(st, _ast.Assign) else [st.target] if isinstance(st, _ast.AnnAssign) else []
 26895	    out = []
 26896	    for t in tgts:
 26897	        out += [t.id] if isinstance(t, _ast.Name) else [e.id for e in getattr(t, "elts", []) if isinstance(e, _ast.Name)]
 26898	    return out
 26899	
 26900	
 26901	def _drift_m1_assigns(body, module, out):
 26902	    """模組層與類別層(含巢狀類別)的指派名;模組層 if/try(含 else、except、finally)裡的遞迴收,
 26903	    except*、type X = …、X += 1、函式裡的區域指派不收(照參考實作 _collect_assigns)。"""
 26904	    import ast as _ast
 26905	    for st in body:
 26906	        out.update(_drift_m1_targets(st))
 26907	        if isinstance(st, _ast.ClassDef):
 26908	            _drift_m1_assigns(st.body, False, out)
 26909	        if module and isinstance(st, _ast.If):
 26910	            _drift_m1_assigns(st.body + st.orelse, True, out)
 26911	        elif module and isinstance(st, _ast.Try):
 26912	            _drift_m1_assigns(st.body + st.orelse + [x for h in st.handlers for x in h.body] + st.finalbody, True, out)
 26913	    return out
