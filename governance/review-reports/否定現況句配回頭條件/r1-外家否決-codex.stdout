   334	def cmd_summary(a):
   335	    rows, metas = load_hits(a.hits)
   336	    _per_repo(rows, metas)
   337	    for refined in (False, True):
   338	        f, _r = funnel(rows, refined=refined)
   339	        print(f"\n[合計] 漏斗({'細化' if refined else '第一版'}):", json.dumps(f, ensure_ascii=False))
   340	    if a.labels:
   341	        _label_table(rows, json.loads(Path(a.labels).read_text(encoding="utf-8")))
   342	    return 0
