   345	def cmd_sample(a):
   346	    """narrow=第一版會提醒的列;refined=細化後會提醒的列(--exclude 排掉已判過的,當留出樣本);broadonly=只中寬表、沒中窄表的列。"""
   347	    rows, _m = load_hits(a.hits)
   348	    if a.pool == "narrow":
   349	        pool = funnel(rows, refined=False)[1]
   350	    elif a.pool == "refined":
   351	        pool = funnel(rows)[1]
   352	    else:
   353	        pool = [r for r in rows if not r["narrow"] and r["broad"] and not r["paired"]]
   354	    if a.exclude:
   355	        seen = set(json.loads(Path(a.exclude).read_text(encoding="utf-8")))
   356	        pool = [r for r in pool if r["id"] not in seen]
   357	    rnd = random.Random(a.seed)
   358	    pick = rnd.sample(sorted(pool, key=lambda r: r["id"]), min(a.n, len(pool)))
   359	    print(f"# pool={a.pool} 母體 {len(pool)} 抽 {len(pick)} seed={a.seed}")
   360	    for r in pick:
   361	        print(json.dumps({"id": r["id"], "narrow": r["narrow"], "broad": r["broad"], "text": r["text"]}, ensure_ascii=False))
   362	    return 0
