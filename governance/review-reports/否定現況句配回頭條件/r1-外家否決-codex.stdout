 27848	def _drift_print_hints(rows, stream, head="改法:"):
 27849	    """一批發現的改法指令;c1 一篇一條(改一次整篇的預告句都改掉)。m1 那條不截在 300 字(上限 4000,_drift_fix_hint 管),
 27850	    超過 20 條那句不指到 drift scan(scan 不含舊句檢查)。"""
 28540	
 28541	def cmd_drift_check(repo=None, diff_range=None, push_remote=None, pushed_ref=None):
 28542	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 28543	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。
 28544	    帶 --push-remote 與 --pushed-ref(推送前掛鉤與 CI 用,要一起給,只給一個回 2):A 當成遠端舊值,起點由
 28545	    _push_range_start 算,git 查詢失敗算不出起點時照「判不了」處理;都沒帶照共用起點判法(_lens_push_base),行為不變。"""
 28546	    root = _note_audit_root(repo)
 28547	    if root is None:
 28548	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 28549	        return 0
 28550	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 28551	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 28552	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 28553	        return 0
 28554	    if (push_remote is None) != (pushed_ref is None):
 28555	        # 只給一個會算錯(r3 外家 finder:只給遠端名時不知道推的是哪條,推主線本身會被判成「頂端已在主線」整步跳過)
 28556	        print("擋下:--push-remote 與 --pushed-ref 要一起給(推送前掛鉤與 CI 用;手動跑兩個都不給)", file=sys.stderr)
 28557	        return 2
 28558	    push = None if push_remote is None else (push_remote, pushed_ref)
 28559	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 28560	                                               mark=_DRIFT_GOLIVE_MARK, push=push)
 28561	    if tip is None or isinstance(tip, int):
 28562	        return tip if isinstance(tip, int) else 0
 28563	    mode, warns, _explicit, os_mode = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 28564	    for w in warns:
 28565	        print(f"提醒:{w}", file=sys.stderr)
 28566	    # 兩個開關各管各的(Projects/舊句檢查_計劃〈做法〉3):c1 到 c5 與 probe 看 gate,舊句檢查 m1 看 old_sentence;回兩邊較大的
 28567	    rc_core = _drift_check_c(root, mode, os_mode, base, tip, vault_rel)
 28568	    if os_mode == "off":
 28569	        return rc_core
 28570	    return max(rc_core, _drift_m1_guarded(root, os_mode, base, tip, vault_rel))
