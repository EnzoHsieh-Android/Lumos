 27653	def cmd_drift_ack(env, node, line, kind, reason, dry_run=False, names=None):
 27654	    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。
 27655	    c2、c3 先確認那一行當下真的是這一種發現,記下當時連著的已收尾計劃(related);每筆都記遞增序號 seq(存量漂移改法 [S8])。
 27656	    m1 記名稱清單 names(排序去重);不驗那一行現在真的是 m1(判定要推送範圍,ack 只有一棵樹)。"""
 27657	    import datetime, secrets
 27658	    err = _drift_ack_args_err(kind, reason, names)
 27659	    if err:
 27660	        print(f"擋下:{err}", file=sys.stderr)
 27661	        return 2
 27662	    rel = env.find(node)
 27663	    if rel is None:
 27664	        return _node_not_found(env, node, write_side=True)
 27665	    text = env_text(env, rel)
 27666	    lines = (text or "").split("\n")
 27667	    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
 27668	        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
 27669	        return 2
 27670	    root, vault_rel = _drift_vault_of(env)
 27671	    head = _drift_ack_heading(lines, line)
 27672	    token = "DACK-" + secrets.token_hex(4)
 27673	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 27674	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
