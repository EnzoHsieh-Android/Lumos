_NOTE_SHAPE_GOLIVE_MARK = "note-shape --staged"     # 提交前掛鉤裡有這串=這道檢查上線了(上線點截斷用)
_NOTE_SHAPE_GATE_VALUES = ("block", "warn", "off")
_NS_DOCTOR_SCAN_CAP = 200                            # doctor 事後掃描最多看幾個提交(每個約 20 ms)
_NS_PIN_HEX_RE = re.compile(r"^[0-9a-fA-F]{12,40}$")
_NS_STRUCT_KEY_RE = re.compile(r"^\s*(?:-\s+)?(id|decided|valid|superseded_by|ended|decided_by|replaces)\s*:")


def _pin_commit(repo_root, pin):
    """釘版本 `@<提交>` 的提交字串 → 完整提交編號;不合法回 None(筆記形狀擋 [S2])。
    ★至少 12 位十六進位★(HEAD、分支名、標籤、main~1 這類會移動的名字不收);★解析結果要以它開頭★
    (剛好取名成十六進位的分支會被 git 當分支解析,指到的是會移動的分支頂端);★要在某個本機或遠端追蹤分支的歷史上★
    (用 git commit-tree 在本機捏造、從沒進過任何分支的提交物件,只查存在性會被放過——r3 正確性席實測)。"""
    if not pin or not _NS_PIN_HEX_RE.match(pin):
        return None
    full = _lens_full_sha(repo_root, pin)
    if not full or not full.lower().startswith(pin.lower()):
        return None
    r = _lens_git(repo_root, "for-each-ref", "--count=1", "--contains", full, "--format=%(refname)",
                  "refs/heads", "refs/remotes")
    if r is None or r.returncode != 0 or not r.stdout.strip():
        return None
    return full


def _note_shape_config(text):
    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
    if text is None:
        return "block", []
    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
    try:
        data = json.loads(raw)
    except Exception as e:
        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
    ns = data.get("note_shape") if isinstance(data, dict) else None
    if ns is None:
        return "block", []
    if not isinstance(ns, dict):
        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
    g = ns.get("gate", "block")
    if g not in _NOTE_SHAPE_GATE_VALUES:
        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
    return g, []


def _notelines_regions(text):
    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
    lines = text.split("\n")
    fm, _body = split_frontmatter(text)
    if fm is None:
        if text.startswith("---"):
            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
        return ["body"] * len(lines)
    out = ["body"] * len(lines)
    end = len(fm) + 1                            # 收尾 --- 那一行
    out[0] = out[end] = "other"
    cur = "other"
    for i in range(1, end):
        ln = lines[i]
        m = TOP_KEY_RE.match(ln)
        if m:
            k = m.group(1)
            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
            out[i] = "other"
            continue
        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
    return out


def _notelines_parse_added(raw):
    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
    out, path, n = {}, None, 0
    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
        if ln.startswith("+++ "):
            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
            path = nfc(p[2:]) if p.startswith("b/") else None
            continue
        if ln.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
            n = int(m.group(1)) if m else 0
            continue
        if path is None or ln.startswith("---"):
            continue
        if ln.startswith("+"):
            out.setdefault(path, []).append((n, ln[1:]))
            n += 1
    return out


def _ns_git(repo_root, *args):
    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
    r = _lens_git(repo_root, *args, quote=True, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _ns_diff(repo_root, *args):
    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
                   "--src-prefix=a/", "--dst-prefix=b/", *args)


def _ns_mainline_refs(repo_root):
    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
    ml = _mainline_ref(repo_root, remote_only=True)
    return [ml[1]] if ml else []


def _ns_exclusions(repo_root, tip):
    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
    out = []
    for ref in _ns_mainline_refs(repo_root):
        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
        if r is not None and r.returncode == 1:
            out.append(ref)
    return out


def _notelines_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, mark=None, max_count=None,
                           hook=_NOTELINES_PRECOMMIT):
    """推送前:範圍裡每個提交各自新增的筆記行 → ({NFC 路徑: 行文字集合}, [範圍淨改動的筆記路徑(git 原樣)],
    {NFC 路徑: 這道檢查還沒上線的提交寫的行})。git 失敗回 None。
    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
    改名照每個提交(合併提交是每個上一版)的改名偵測往後帶到終點路徑(r3 外家席)。
    ★鍵用 NFC、拿去 git 查的一律用原樣路徑★(驗收輪通才席:NFC 過的路徑對存 NFD 的樹 cat-file、路徑篩選都查不到)。
    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
    ★寫的時候這道檢查還沒上線的提交不查★(mark):看那個提交自己的提交前掛鉤有沒有上線標記——上線前開的分支上線後
    才合進來,那些行是舊帳(r3 通才席);原本用「是不是上線點的後代」代替,兩條分支各自裝過時另一條整批漏查(驗收輪通才席)。
    那些行另外收進第三個回傳值,喚醒那條路也跳過(驗收輪外家席)。max_count:只看最新那幾個提交(doctor 的上限)。"""
    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
    if exclude_remote:
        ml = _ns_exclusions(repo_root, tip)
        if ml:
            rl += ["--not", *ml]
    if max_count:
        rl.append(f"--max-count={int(max_count)}")
    raw = _nodehome_git(repo_root, *rl)
    if raw is None:
        return None
    commits = [ln.split() for ln in raw.decode("ascii", errors="replace").splitlines() if ln.split()]
    live = None
    if mark and commits:
        hb = _nodehome_cat_blobs(repo_root, [f"{c[0]}:{hook}" for c in commits])
        if hb is None:
            return None
        live = {c[0] for c, b in zip(commits, hb) if b is not None and mark.encode() in b}
    by_path, old_by = {}, {}

    def _renames(a, b):
        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
        return None if r is None else _nodehome_name_status(r, norm=False)[1]     # 原樣 新路徑 → 舊路徑

    def _carry(ren):
        for new_, old_ in (ren or {}).items():
            ko, kn = nfc(old_), nfc(new_)
            for d_ in (by_path, old_by):
                if ko in d_ and ko != kn:
                    d_.setdefault(kn, set()).update(d_.pop(ko))

    for shas in commits:
        sha, parents = shas[0], shas[1:]
        first = parents[0] if parents else _EMPTY_TREE_SHA
        ren = _renames(first, sha)
        if ren is None:
            return None
        _carry(ren)
        dest = by_path if (live is None or sha in live) else old_by
        if len(parents) <= 1:
            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
            if d is None:
                return None
            for p, rows in _notelines_parse_added(d).items():
                dest.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
            continue
        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
        if names is None:
            return None
        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
        pren = [_renames(pp, sha) or {} for pp in parents]
        for pr in pren[1:]:
            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
            _carry(pr)
        specs = []
        for p in paths:
            specs.append(f"{sha}:{p}")
            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
        k = 1 + len(parents)
        for i, p in enumerate(paths):
            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
            new = _merge_new_lines(merged, olds) if blobs is not None else None
            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
                d = _ns_diff(repo_root, first, sha, "--", p)
                if d is None:
                    return None
                for _p, rows in _notelines_parse_added(d).items():
                    dest.setdefault(nfc(p), set()).update(t_.strip() for _n, t_ in rows if t_.strip())
            else:
                dest.setdefault(nfc(p), set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
    if net is None:
        return None
    return by_path, [p for p in _nodehome_split_z(net) if p.endswith(".md")], old_by


def _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, *, reader, mark, hook=_NOTELINES_PRECOMMIT,
                   per_commit=True, exclude_remote=True, max_count=None, keep_other=False):
    """範圍裡新寫、而且終點版本還在的筆記行——筆記形狀擋與筆記內容審共用(Projects/筆記內容審_計劃 [S1][S2])。
    → (notes, errs, old_by) 或 None(git 失敗)。notes=[(路徑, 全文, [(行號, 行文字, 區塊)])],只收 body/summary/
    decisions 三塊的非空行;errs=讀不成 UTF-8 的筆記;old_by={NFC 路徑: 這道檢查還沒上線時寫的行}。
    ★per_commit★:True=逐提交看「那個提交自己的 hook 有沒有 mark」(提交前掛鉤在寫的那一刻跑,第一層);
    False=不逐提交判、只靠範圍截斷(推送時才跑的閘,跑的是當下工作目錄那份掛鉤,第二層)——★要明寫傳 False★,
    不傳會落到第一層的預設。找不到上線點時照既有語意不過濾。
    keep_other=True 時開頭欄位其他欄(區塊 other)的新行也收——只給筆記形狀擋查「條件標記寫在不評估的地方」用
    (存量漂移防線 [S10]),既有規則照舊只看 body/summary/decisions。"""
    if staged:
        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
        if d is None:
            return None
        added = {p: rows for p, rows in _notelines_parse_added(d).items() if p.endswith(".md")}
        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
        texts_by, old_by, net = None, {}, None
    else:
        live_mark = mark if (per_commit and _nodehome_golive(repo_root, tip_where, mark, hook)) else None
        rc = _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count,
                                   hook, keep_other)
        if rc is None:
            return None
        cand, texts_by, old_by, net = rc
    notes, errs = [], []
    for p, linenos in sorted(cand.items()):
        b = reader(p)
        if b is None:
            continue
        try:
            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
        except UnicodeDecodeError:
            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
            continue
        texts = None if texts_by is None else texts_by.get(nfc(p), ())
        netl = None if net is None else (lambda p=p: net.lines(nfc(p)))
        notes.append((p, text, _notelines_rows(text, linenos, texts, keep_other, netl)))
        if net is not None and net.failed:
            return None     # 當場停,不往下算(代碼審 r3 架構對齊席)
    return notes, errs, old_by


def _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count, hook,
                          keep_other):
    """推送範圍的候選 → (候選 {路徑: None}, 逐提交新增的文字, 還沒上線時寫的行, 範圍淨差異(_NotelinesNet)或 None);
    git 失敗回 None。開頭欄位其他欄的行要對「範圍淨差異」的行號:逐提交的文字集合分不出位置,舊欄位裡跟正文新行
    一字不差的那一行會被當成新寫(存量漂移防線乙代碼審 r1 外家席;staged 模式本來就對行號)。只在 keep_other 時才有。"""
    ra = _notelines_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
                                mark=live_mark, max_count=max_count, hook=hook)
    if ra is None:
        return None
    texts_by, paths, old_by = ra
    net = _NotelinesNet(repo_root, base_where, tip_where, vault_rel) if keep_other else None
    return {p: None for p in paths}, texts_by, old_by, net


class _NotelinesNet:
    """範圍淨差異的新增行號,★用到才算★:只有開頭欄位其他欄真的有一行跟逐提交新增的文字對上時才跑那一次 diff
    (代碼審 r2 併發席:原本筆記形狀擋每次推送都固定多跑一次整個圖譜範圍的 diff)。git 失敗記 failed,呼叫端當場整次回 None。
    ★為什麼用旗標不回 None★(代碼審 r3 架構對齊席問過):它是以無參數函式傳進 _notelines_rows 的,那一層只回行清單、
    沒有失敗出口;要回 None 得改 rows 的回傳形狀與三個呼叫端,旗標只多呼叫端一行檢查。"""

    def __init__(self, repo_root, base_where, tip_where, vault_rel):
        self.args, self._m, self.failed = (repo_root, base_where, tip_where, vault_rel), None, False

    def lines(self, p):
        if self._m is None and not self.failed:
            repo_root, base_where, tip_where, vault_rel = self.args
            dn = _ns_diff(repo_root, base_where or _EMPTY_TREE_SHA, tip_where, "--", vault_rel)
            self.failed = dn is None
            self._m = {} if dn is None else {nfc(q): {n for n, _t in rows} for q, rows in _notelines_parse_added(dn).items()}
        return self._m.get(p, ())


def _notelines_rows(text, linenos, texts, keep_other, net):
    """一篇筆記裡算新寫的行 → [(行號, 行文字, 區塊)]。linenos:staged 的新增行號;texts:推送範圍逐提交新增的文字;
    net:回推送範圍淨差異新增行號的函式(只拿來核對開頭欄位其他欄,用到才呼叫)。"""
    lines = text.split("\n")
    regs = _notelines_regions(text)
    rows = []
    for i, ln in enumerate(lines, 1):
        if linenos is not None and i not in linenos:
            continue
        if texts is not None and ln.strip() not in texts:
            continue
        if not ln.strip() or (regs[i - 1] == "other" and not keep_other):
            continue
        if regs[i - 1] == "other" and net is not None and i not in net():
            continue
        rows.append((i, ln, regs[i - 1]))
    return rows


_NOTELINES_HEADING_RE = re.compile(r"^#{1,6}\s+(.*?)\s*#*\s*$")
_NOTELINES_DECISION_KEY_RE = re.compile(r"^(\s*)(?:-\s+)?([A-Za-z_][\w-]*)\s*:")


def _notelines_decision_fields(text):
    """decisions 裡每一行屬於哪一條決策的哪一欄 → {行號(從1起): (決策編號, 欄名, valid)}(Projects/筆記內容審_計劃 [S3][S4])。
    既有 decisions_items 只給每條決策的起訖行;決策編號用 decision-supersede 同一種 `id:` 比對,欄名逐行歸屬:
    跟項目子鍵同縮排、`鍵:` 開頭的行是那一欄,後面縮排更深或沒有 `鍵:` 的續行跟著前一欄。沒有編號的決策用 `#<序號>`。"""
    fm, _b = split_frontmatter(text)
    out = {}
    if not fm:
        return out
    di = decisions_items(fm)
    if di is None:
        return out
    _s, _e, items, _item_indent, sub_indent = di
    for n, (st, en) in enumerate(items, 1):
        did, valid, cur = f"#{n}", True, None
        fields = []
        for k in range(st, en + 1):
            ln = fm[k]
            m = _NOTELINES_DECISION_KEY_RE.match(ln)
            ind = len(ln) - len(ln.lstrip(" "))
            is_key = m and (k == st or ind == sub_indent)
            if is_key:
                cur = m.group(2)
                val = ln.split(":", 1)[1].strip()
                if cur == "id":
                    mm = re.match(r"^(d\d+)$", val)
                    if mm:
                        did = mm.group(1)
                elif cur == "valid":
                    valid = val.strip("\"'").lower() != "false"
            fields.append((k, cur))
        for k, f in fields:
            out[k + 2] = (did, f or "", valid)       # fm[0] 是全文第 2 行
    return out


def _notelines_headings(text, regs):
    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
    lines = text.split("\n")
    vis = {i for i, _l in _visible_lines(lines)}
    dfields = _notelines_decision_fields(text)
    out, cur = [], ""
    for i, ln in enumerate(lines, 1):
        reg = regs[i - 1]
        if reg == "body" and i in vis:
            m = _NOTELINES_HEADING_RE.match(ln)
            if m:
                cur = m.group(1).strip()
        if reg == "summary":
            out.append("summary")
        elif reg == "decisions":
            did, f, _v = dfields.get(i, ("", "", True))
            out.append(f"decisions/{did}/{f}")
        elif reg == "body":
            out.append(cur)
        else:
            out.append("")
    return out


_NOTELINES_TABLE_SEP_RE = re.compile(r"^\s*[|:\-\s]*-[|:\-\s]*$")
_NOTELINES_RULE_RE = re.compile(r"^\s{0,3}(?:(?:-\s*){3,}|(?:\*\s*){3,}|(?:_\s*){3,})$")
_NOTELINES_BARE_LIST_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])(?:\s+\[[ xX]\])?\s*$")


def _notelines_structural_lines(text):
    """沒有主張、不審的行號集合(Projects/筆記內容審_計劃 [S4]):圍欄記號行(照 _visible_lines 認的)、表格分隔行、
    分隔線、只有清單記號的行。空白行本來就不收,不在這裡。"""
    lines = text.split("\n")
    kept = {i for i, _l in _visible_lines(lines, keep_fenced=True)}
    out = set()
    for i, ln in enumerate(lines, 1):
        if not ln.strip():
            continue
        if i not in kept or (_NOTELINES_TABLE_SEP_RE.match(ln) and "|" in ln) or _NOTELINES_RULE_RE.match(ln) \
                or _NOTELINES_BARE_LIST_RE.match(ln):
            out.add(i)
    return out


def _notelines_content_id(path, region, heading, line, done=False):
    """內容編號=(NFC 路徑、區塊、所屬小標題、去頭尾空白的行文字)的短雜湊;完成審多一個標記,不綁任何提交
    (Projects/筆記內容審_計劃 〈做法〉第 2 節)。"""
    import hashlib
    raw = "\0".join([nfc(path), region, heading, line.strip()] + (["完成審"] if done else []))
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]


def _ns_is_code(path, reader, files):
    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
    if path not in files:
        return False
    kind = _nodehome_code_kind(path)
    if kind == "ext":
        return True
    if kind != "shebang?":
        return False
    b = reader(path)
    return b is not None and _head_is_shebang(b[:200])


# 只放連結的指路行:連結裡不准有別名或段落(`[[目標|別名]]`、`[[目標#段落]]` 都能夾帶現況,代碼審 r2、r3 通才席);
# 分隔認中文常用的標點與連接詞(r3 外家席:原本把全形逗號打成半形,測試也用半形,假綠)
_NS_POINTER_ONLY_RE = re.compile(r"^(?:\s*(?:\[\[[^\]|#]+\]\]|見|→|,|\uff0c|、|\u3002|;|\uff1b|與|和|及|\||｜)\s*)*$")


def _ns_pin_ok(repo_root, p, lno, s):
    sha = _pin_commit(repo_root, s)
    return sha is not None and _validate_repo_ref(repo_root, p, lno, at_sha=sha)[0] == "ok"


def _ns_is_regen(text):
    """帶 regen 的重建筆記:照 Check J 看解析後的值(空字串不算;代碼審 r3 外家席:原本看原始文字,`regen: ""` 也算)。"""
    fm, _b = split_frontmatter(text)
    if not fm:
        return False
    v = parse_frontmatter(fm)[0].get("regen")
    return isinstance(v, str) and bool(v.strip())


def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name, regen=False):
    """一行新增內容 → [(規則, 片段, 改法)]。by_name(檔名)→ 同名的程式檔清單。"""
    out = []
    # [src:路徑:行號] 是從程式碼重建的筆記的出處標記,★只在帶 regen 的筆記的 summary 裡★歸重建守衛(Check J)驗;
    # 別的地方照一般行號引用判(代碼審 r2 通才席:原本對所有筆記豁免,一般筆記寫 [src:…] 就能夾帶行號)
    scan = SRC_REF_RE.sub(" ", text) if (regen and region == "summary") else text
    pins, singles = [], []
    full, _bare = _node_code_ref_tokens(scan, top_dirs, bare_text=True, anchors=True, keep_fences=True,
                                        pins=pins, singles=singles,
                                        exists=lambda x, _s=None: x in files or ("/" not in x and bool(by_name(x))))
    fix_pin = ("`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
               "HEAD、分支名、標籤會移動,不算釘住")

    for p, lno, s in pins:
        # 只管程式檔與測試檔——跟沒釘版本時一致(.md、不存在的路徑都不管;代碼審 r1 測試席、r2 外家席)
        if lno and _ns_is_code(p, reader, files) and not _ns_pin_ok(repo_root, p, lno, s):
            out.append(("釘版本不合法", f"`{p}@{s}:{lno}`", fix_pin))
    for p, lno in full:
        if lno and _ns_is_code(p, reader, files):
            out.append(("程式行號引用", f"`{p}:{lno}`",
                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{lno}`"))
    for name, lno, s in singles:
        cands = by_name(name)
        if len(cands) != 1:
            continue
        if s is None:
            out.append(("程式行號引用", f"`{name}:{lno}`(= {cands[0]})",
                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{lno}`"))
        elif not _ns_pin_ok(repo_root, cands[0], lno, s):
            out.append(("釘版本不合法", f"`{name}@{s}:{lno}`(= {cands[0]})", fix_pin))
    if region == "summary":
        m = SYMBOL_RE.match(text.strip())
        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
        if m and not skip:
            for _w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
                out.append(("現況描述沒寫來源", text.strip()[:60],
                            "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
    return out


def _ns_revisit_violations(ln, reg, visible):
    """新寫的一行回頭條件或條件標記合不合規矩(存量漂移防線 [S10])→ [(規則, 片段, 改法)]。
    用跟 E5、第二層同一支 _revisit_split;圍欄裡的、行內程式碼裡的是範例,不管。"""
    if not visible:
        return []
    probe = _strip_inline_markup(ln)[0]
    table = probe.lstrip().startswith("|")
    if reg in ("body", "summary") and not table:
        kind, rest = _revisit_split(probe)
        if kind == "bad":
            return [("回頭條件格式不合", ln.strip()[:60],
                     "REVISIT: 後面第一個位置要是日期 YYYY-MM-DD,或條件標記加期限:REVISIT:[when-file:路徑][by:YYYY-MM-DD] 待辦")]
        if kind == "cond":
            pr = _probe_parse(rest)
            errs = list(pr["errs"])
            if pr["conds"] and pr["by"] is None:
                errs.append("沒帶期限 [by:YYYY-MM-DD](條件寫錯就永遠不會成立,期限到了至少會被唸)")
            if errs:
                return [("條件寫錯", ln.strip()[:60], ";".join(errs) + "——文法見 Projects/存量漂移防線_計劃〈做法〉第 0 節")]
        return []
    if _PROBE_ANY_RE.search(probe):
        return [("條件寫在不評估的地方", ln.strip()[:60],
                 "條件標記只在正文與摘要的 REVISIT 行生效;寫在表格或開頭欄位其他欄裡不會被判,移到 REVISIT 行")]
    return []


def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
    ch = _nodehome_changes(repo_root, base_where, tip_where)
    if ch is None:
        return []
    lst_t = _nodehome_list(repo_root, tip_where)
    lst_b = _nodehome_list(repo_root, base_where)
    if lst_t is None or lst_b is None:
        return []
    reader_b = _nodehome_reader(repo_root, base_where)
    out = []
    for code, _old, new in ch:
        if not new or code == "D":
            continue
        if not _ns_is_code(new, reader_tip, lst_t[0]):
            continue
        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
            out.append(new)
    return out


def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
    reader = _nodehome_reader(repo_root, tip_where)
    lst = _nodehome_list(repo_root, tip_where)
    if lst is None:
        return None
    files = lst[0]
    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
    _names, _name_cache = {}, {}
    for p in files:
        if _nodehome_code_kind(p) is not None:
            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)

    def by_name(name):
        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
        if name not in _name_cache:
            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
        return _name_cache[name]
    viol = []
    # 1) 這次新增的行(跟筆記內容審共用同一支,Projects/筆記內容審_計劃 [S1])
    mk = mark or _NOTE_SHAPE_GOLIVE_MARK
    res = _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, reader=reader, mark=mk,
                         exclude_remote=exclude_remote, max_count=max_count, keep_other=True)
    if res is None:
        return None
    notes, errs, old_by = res
    for p, text, rows in notes:
        regen = _ns_is_regen(text)
        vis = {no for no, _l in _visible_lines(text.split("\n"))}
        for i, ln, reg in rows:
            if reg != "other":
                for rule, frag, fix in _ns_check_line(repo_root, ln, reg, files, reader, top_dirs, by_name, regen):
                    viol.append((p, i, rule, frag, fix))
            for rule, frag, fix in _ns_revisit_violations(ln, reg, i in vis):
                viol.append((p, i, rule, frag, fix))
    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
                             tip_where, reader)
    if became:
        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
        if gl is not None:
            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
            spec = "" if tip_where == "index" else tip_where
            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
            gl_reader = _nodehome_reader(repo_root, gl)
            seen = {(v[0], v[1]) for v in viol}
            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
            for p, blob in zip(notes_, blobs):
                if blob is None:
                    continue
                text = blob.decode("utf-8-sig", errors="replace")
                if not any(x in text for x in keys):
                    continue
                old, regs_, regen_ = None, _notelines_regions(text), _ns_is_regen(text)
                for n, ln in enumerate(text.split("\n"), 1):
                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
                        continue
                    if old is None:
                        ob = gl_reader(p)
                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
                    if ln.strip() in old or ln.strip() in old_by.get(nfc(p), ()):
                        continue
                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
                                                             for x in became):
                            continue
                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
    return viol, errs


def _note_shape_doctor_lines(repo_root, vault, ci=False):
    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:
        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, _w = _note_shape_config(txt)
    if mode != "block":
        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
                   "沒寫來源的現況描述不會被擋")
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    if ymls:
        # 跳過註解:整行被註解掉的那步不算有呼叫(第二層早就這樣判;代碼審 r3 通才席:兩句判法不一,中間漏唸)
        body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
        step = ("\n    - run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
                "python3 scripts/lumos note-shape --diff \"${{ github.event.before || '0000000000000000000000000000000000000000' }}..${{ github.sha }}\""
                "\n  (這步只在 push 事件跑(`if: github.event_name == 'push'`),pull_request 沒有前一版;checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了找得到主線:"
                "已在主線上的提交不重查,新分支首推(前一版是 40 個 0)或 force-push 後舊頂端找不到時,lumos 從跟主線的分岔點算)"
                + _CI_PY314_NOTE)
        if "note-shape --diff" not in body:
            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
        else:
            shallow = _ci_jobs_calling_without_full_history(ymls, "note-shape --diff")
            if shallow:
                out.append("專案 CI 呼叫了 note-shape,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
                           + _ci_jobs_list(shallow))
    if ci:
        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
        return out
    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
    if gl is None:
        return out
    ref = None
    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    if up is not None and up.returncode == 0 and up.stdout.strip():
        ref = up.stdout.strip()
    else:
        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
        ref = cands[0] if cands else None
    tip = _lens_full_sha(root, ref) if ref else None
    if tip is None:
        return out
    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
    if a is None or a.returncode != 0:
        return out
    try:
        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return out
    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
    # 上限用「最新 N 個提交」算,不用 tip~N:沿第一個上一版數的邊界在合併式歷史裡會退到上線點之前、或根本數不到 N 步
    # 而整個取消(代碼審 r2、r3 通才席);起點固定在上線點
    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False,
                           max_count=_NS_DOCTOR_SCAN_CAP if capped else None)
    if capped:
        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
    if res:
        viol, _errs = res
        if viol:
            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
    return out


def cmd_note_shape(repo=None, staged=False, diff_range=None):
    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
    root = Path(repo).resolve() if repo else None
    if root is None:
        r = _lens_git(".", "rev-parse", "--show-toplevel")
        if r is None or r.returncode != 0:
            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
            return 0
        root = Path(r.stdout.strip())
    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
    if r is None or r.returncode != 0:
        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE") == "1":        # 只認 1,跟 LUMOS_SKIP_BOUND_TESTS 等鄰居一致(筆記內容審代碼審 r1 同族修)
        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
        return 0
    if staged:
        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
        if mh is not None and mh.returncode == 0:
            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
            return 0
        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
    else:
        rg = _lens_range_ok(diff_range)
        if rg is None:
            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
            return 2
        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
        if sh is not None and sh.stdout.strip() == "true":
            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
                  file=sys.stderr)
            _gate_event_or_warn(root, "note-shape", "skipped-env", "shallow clone")
            return 0
        a, b = rg
        tip = _lens_full_sha(root, b)
        if tip is None:
            if _ZERO_SHA_RE.fullmatch(b):
                print("筆記形狀擋:範圍終點是全 0(刪除分支),沒有要查的東西", file=sys.stderr)
                return 0
            print(f"擋下:範圍 {diff_range} 的終點在本機找不到——範圍寫錯了?", file=sys.stderr)
            return 2
        base, why = _lens_push_base(root, a, tip)
        if why:
            print(f"筆記形狀擋:{why}", file=sys.stderr)
        if base is None:
            _gate_event_or_warn(root, "note-shape", "skipped", why)
            return 0
        base = _nodehome_clamp_base(root, base, tip, _NOTE_SHAPE_GOLIVE_MARK)
        base_where = None if base == _EMPTY_TREE_SHA else base
        tip_where, mode_word = tip, "這次推送"
    lst = _nodehome_list(root, tip_where)
    if lst is None:
        print("筆記形狀擋:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
        return 0
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        print("筆記形狀擋:這個專案沒有圖譜,跳過")
        return 0
    wv = _vault_in(root)
    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
    mode, warns = _note_shape_config(_nodehome_reader(root, tip_where)(".lumos/config.json"))
    for w in warns:
        print(f"提醒:{w}", file=sys.stderr)
    if mode == "off":
        print("筆記形狀擋:這個專案把這道檢查關掉了(note_shape.gate=off),跳過", file=sys.stderr)
        return 0
    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel)
    if res is None:
        print("筆記形狀擋:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
        return 0
    viol, errs = res
    if not viol and not errs:
        return 0
    head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
    for e in errs:
        print(f"  {e}", file=sys.stderr)
    for p, n, rule, frag, fix in viol:
        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
    if mode == "block":
        print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
              "推得出來的一寫進去就會過期——見 Projects/筆記形狀擋_計劃。", file=sys.stderr)
        _gate_event_or_warn(root, "note-shape", "blocked", f"{mode_word}:新違規 {len(viol) + len(errs)} 條",
                            hard=True, nodes=sorted({v[0] for v in viol} | {e.split(':', 1)[0] for e in errs})[:50])
        return 1
    # warn 模式有違規也記一筆(照鄰居的 warned;沒違規的放行才不寫——代碼審 r1 架構對齊席)
    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
                        nodes=sorted({v[0] for v in viol})[:50])
    return 0


# ── 筆記內容審(第二層,Projects/筆記內容審_計劃):推送前派判定者逐行判新寫的筆記是不是程式碼推得出來 ──
# 家:Systems/筆記內容審。只防疏忽、不防存心繞過(計劃〈做法〉第 0 節)。
_NOTE_AUDIT_GOLIVE_MARK = "note-audit check"          # 推送前掛鉤裡有這串=第二層上線了(範圍截斷用)
_NOTE_AUDIT_GATE_VALUES = ("block", "warn", "off")
_NOTE_AUDIT_VERDICT_DIR = "governance/note-verdicts"
_NOTE_AUDIT_WORK_DIR = ".lumos/note-audit"
_NOTE_AUDIT_TEMPLATE = "scripts/templates/note-audit-judge.md"
_NOTE_AUDIT_PROMPT_VERSION = 1                          # 範本檔改一個字就升版,並重跑 68 句小實驗(計劃 S14)
_NOTE_AUDIT_BATCH = 150
_NOTE_AUDIT_SEARCH_CAP = 20000
_NOTE_AUDIT_VERDICT_NAME_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{32}\.json$")
_NOTE_AUDIT_WEIGHT = {"CONTEXT": 0, "MIXED": 1, "CODE": 2}
_NOTE_AUDIT_CLASS_ALIASES = {"CODE": "CODE", "推得出": "CODE", "MIXED": "MIXED", "一半一半": "MIXED",
                             "CONTEXT": "CONTEXT", "脈絡": "CONTEXT"}
_NOTE_AUDIT_CLOSED = ("done", "superseded")


def _note_audit_judge_model(orchestrator):
    """判定者跟編排者同一家,模型寫死(計劃〈做法〉第 3 節第 2 點):claude → opus;codex → 既有 Codex 審查席常數。"""
    return {"claude": "opus", "codex": _CODEX_SEAT_MODEL}.get(orchestrator)


def _note_audit_config(text):
    """被檢查版本的 .lumos/config.json 內容(bytes 或 None)→ (gate, warnings)。照 _note_shape_config 的讀法。"""
    import json as _j
    if text is None:
        return "block", []
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        return "block", [".lumos/config.json 讀不成 JSON,筆記內容審照預設 block"]
    na = cfg.get("note_audit") if isinstance(cfg, dict) else None
    if na is not None and not isinstance(na, dict):
        return "block", ["設定檔的 note_audit 不是物件(要寫成 {\"note_audit\": {\"gate\": \"warn\"}}),筆記內容審照預設 block"]
    g = na.get("gate") if isinstance(na, dict) else None
    _gate_event_or_warn(root, "note-audit", "skipped", f"{name}:略過 {len(todo)} 行:{note.strip()[:80]}")
    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
    return 0


# ═══════════════════════════════════════════════════════════════════════════════════
# 存量漂移守衛(Projects/存量漂移防線_計劃;家 [[Systems/存量漂移守衛]])
# 已經寫進圖譜的句子,因為別處的狀態變了而過期——這裡是「甲」:狀態指令連帶處理(五種狀態一致檢查、
# 計劃收尾時列連帶待辦、推送時只擋「這次轉正、預告句還留著」)。「乙」(回頭條件改成機器能判的條件)接在後面。
# ═══════════════════════════════════════════════════════════════════════════════════
_DRIFT_CLOSED = ("done", "superseded")
_DRIFT_OPEN_ISSUE = ("open", "doing")
# c4 的關鍵詞。★清單裡刻意不放「工作樹」★:「釘在某提交的乾淨工作樹」是合法的可重現寫法,本來就不含這三個詞;
# 同一句裡同時有「未提交」與「工作樹」照樣成立(考卷 E3 就是這樣寫,設計審 r3 接手席)
_DRIFT_UNCOMMITTED_WORDS = ("未提交", "還沒提交", "uncommitted")
_DRIFT_KINDS = ("probe", "c1", "c2", "c3", "c4", "c5", "m1")
_DRIFT_KIND_NAMES = {"c1": "轉正了還寫預告", "c2": "計劃收尾了、連著的 Issue 還開著",
                     "c3": "計劃收尾了、驗證紀錄還待定", "c4": "前提寫「還沒提交」",
                     "c5": "轉正做了一半", "probe": "回頭條件成立了", "m1": "程式改了、筆記還在講舊東西"}
# drift scan 認得的種類:m1(舊句檢查)要一段推送範圍才判得了「消失」,只有一棵樹的 scan、doctor、考試都不跑(照 _DRIFT_FIX_KINDS 的先例)
_DRIFT_SCAN_KINDS = tuple(k for k in _DRIFT_KINDS if k != "m1")
_DRIFT_ACKS = "governance/drift-acks.jsonl"
# 修復帳(drift fix 每改一筆記一行稽核紀錄;存量漂移改法 第 7 節)。★稽核紀錄,不是還原工具★:要退回用 git;
# 帳也是乾淨檢查認得「工具自己的改動」的依據。進簿記檔名單 _BOOKKEEPING_FILES(那邊寫的是同一個字串)
_DRIFT_FIXES = "governance/drift-fixes.jsonl"
_DRIFT_FIX_KINDS = ("c1", "c2", "c3", "c4", "c5")
_DRIFT_BOUND_KINDS = ("c2", "c3")          # 表態要綁當時連著的已收尾計劃(related)與序號(seq)的種類
_DRIFT_GOLIVE_MARK = "drift check"
_DRIFT_GATE_VALUES = ("block", "warn", "off")
# ★沒寫設定時的預設★(計劃〈做法〉第 4 節第 4 點):三條門檻(考卷正例全對、歷史重放不亂擋、噪音 ≤5)考過,
# Enzo 2026-09-30 裁定改成 block(防線計劃的決策紀錄;乙的歷史重放那條仍是空測,已知並一起轉)。
# 專案要先只提醒或關掉,在 .lumos/config.json 寫 drift_check.gate=warn|off;設定寫壞也照這個預設。
_DRIFT_DEFAULT_GATE = "block"
_DRIFT_BUDGET_SEC = 60


def _drift_str(n, key):
    v = n.fields.get(key, "") if n is not None else ""
    return v.strip() if isinstance(v, str) else ""


def _drift_fm_end(lines):
    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
    if not lines or lines[0].strip() != "---":
        return 0
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return i
    return 0


def _drift_field_line(text, key, pred=None):
    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    for i in range(1, e):
        m = TOP_KEY_RE.match(lines[i])
        if not (m and m.group(1) == key):
            continue
        if pred is None:
            return i + 1
        for j in range(i, e):
            if j > i and TOP_KEY_RE.match(lines[j]):
                break
            if pred(lines[j]):
                return j + 1
        return i + 1
    return 1


def _drift_line_text(text, ln):
    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
    lines = text.split("\n")
    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""


def _drift_c3_hit(env, vrel, override=None, ti=None):
    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
    n = env.notes.get(vrel)
    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
        return None
    if GUARD_MARK_FIELD in n.fields:
        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
    if not refs:
        return None
    ti = ti if ti is not None else build_typed_index(env)
    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
    if any(not link_target(x) for x in refs) \
            or any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
        return None
    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
    if not plans:
        return None
    for prel in plans:
        pn = env.notes.get(prel)
        if pn is None or _drift_str(pn, "type") != "project":
            return None
        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
            return None
    return plans


def _drift_linked(env, rel):
    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
    out_e, in_e = env.edges
    got = {}
    for d in out_e.get(rel, []):
        got[d] = "out"
    for s in in_e.get(rel, []):
        got[s] = "both" if s in got else "in"
    return got


def _drift_state_findings(env, only=None):
    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
    only=要算的路徑集合(None=全部)。"""
    out = []
    ti = build_typed_index(env)
    for rel, n in sorted(env.notes.items()):
        if only is not None and rel not in only:
            continue
        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
            out += _drift_guard_findings(env, rel, n, st)
        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
            out += _drift_c2(env, rel)
        if ty == "verification":
            plans = _drift_c3_hit(env, rel, ti=ti)
            if plans:
                text = env_text(env, rel) or ""
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
        vu = n.fields.get("valid_under")
        vtxt = " ".join(as_list(vu)) if vu else ""
        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
            text = env_text(env, rel) or ""
            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
    return out


def _drift_c2(env, rel):
    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
             if _drift_str(env.notes.get(p), "type") == "project"
             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
    if not plans:
        return []
    text = env_text(env, rel) or ""
    ln = _drift_field_line(text, "status")
    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]


def _drift_guard_findings(env, rel, n, st):
    """守衛紀錄的 c1(轉正了還寫預告,一句一筆)與 c5(轉正做了一半)。"""
    text = env_text(env, rel)
    if text is None:
        return []
    out = []
    lines = text.split("\n")
    if st == "pass":
        regs = _notelines_regions(text)
        for i, ln in enumerate(lines):
            k = _guard_planned_prose(ln, regs[i])
            if k:
                out.append({"kind": "c1", "path": rel, "line": i + 1, "text": ln.strip(), "related": [],
                            "why": "已轉正(status: pass)但還留著預告句"})
    elif st == "pending":
        m = re.search(r"^預告的合約:(.+)$", text, re.M)
        home = env.resolve(link_target(_guard_home_of_fields(n.fields))) if _guard_home_of_fields(n.fields) else None
        htext = env_text(env, home) if home else None
        if m and htext is not None:
            hl = htext.split("\n")
            if _guard_formal_line(hl, _drift_fm_end(hl), m.group(1).strip(), None) is not None:
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c5", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [home],
                            "why": f"家筆記 {home[:-3]} 已經是正式合約行——重跑 lumos guard settle 補完"})
    return out


def _drift_plan_followups(env, rel, new_status):
    """lumos set <計劃> status done|superseded 要列的連帶待辦(計劃〈做法〉第 1 節第 3 點)→ [(種類, 路徑, 說明)]。
    只讀筆記、不跑 git、不寫;不是計劃或不是收尾狀態回 []。
    驗證紀錄走 build_typed_index 的反向索引(代碼審 r1 架構對齊席:不自己拿 env.resolve 猜同名第一篇);
    只寫檔名、同名猜不準的另列一項「猜不準」,讓人自己看。"""
    n = env.notes.get(rel)
    if n is None or _drift_str(n, "type") != "project" or new_status not in _DRIFT_CLOSED:
        return []
    out = []
    names = {"out": "計劃連到它", "in": "它連到計劃", "both": "互相連"}
    for p, d in sorted(_drift_linked(env, rel).items()):
        pn = env.notes.get(p)
        if _drift_str(pn, "type") == "issue" and _drift_str(pn, "status") in _DRIFT_OPEN_ISSUE:
            out.append(("Issue", p, f"{_drift_str(pn, 'status')},{names[d]}"))
    ti = build_typed_index(env)
    for p in sorted({s for s, et in ti["rev"].get(rel, []) if et == "plan_refs"}):
        if _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            out.append(("驗證紀錄", p, "pending,plan_refs 指的計劃都已收尾"))
    out += _drift_status_probe_followups(env, rel, new_status)
    for src, lit, et, cands in ti["ambiguous"]:
        sn = env.notes.get(src)
        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
    return out


def _drift_status_probe_followups(env, rel, new_status):
    """連帶待辦第③項(乙,[S15]):[when-status:<這份計劃>=…] 的 status 條件因這次收尾成立的回頭條件——只做文字比對,
    不跑 git;同一行還有別的條件時註明,不宣稱整行成立。env 是改之前的圖譜:舊狀態本來就在值裡的,條件早就成立,
    不是這次收尾造成的,不列(代碼審 r1 正確性席、外家席:doing→done 對 =doing|done 原本也說成因這次成立)。"""
    out = []
    old = _drift_str(env.notes.get(rel), "status")
    for p in sorted(env.notes):
        for no, _tx, pr in _probe_lines(env_text(env, p) or "")[0]:
            hit = [v for k, v in pr["conds"] if k == "status" and _probe_value_err(k, v) is None
                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
                   and new_status in (vals := {x.strip() for x in v.partition("=")[2].split("|")}) and old not in vals]
            if hit:
                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
    return out


def _drift_print_followups(env, rel, new_status):
    items = _drift_plan_followups(env, rel, new_status)
    if not items:
        return
    print(f"連帶待辦(這份計劃收尾了,下面 {len(items)} 篇連著它;只列出、不擋——連結有時只是參考,是不是該結案要人看):")
    ti = build_typed_index(env)
    for kind, p, why in items:
        print(f"  · {kind} {p[:-3]}({why})")
        print(f"      看:lumos context {_esc_clean(_drift_sh(p[:-3], node=True), 300)}")
        if kind == "驗證紀錄" and _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            # c3 那一項給改法指令(存量漂移改法 [S10];單一產生處 _drift_fix_hint)
            ln = _drift_field_line(env_text(env, p) or "", "status")
            print(f"      改:{_drift_fix_hint('c3', p, ln)[0]}")


# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────

def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    pre = vault_rel.rstrip("/") + "/"
    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
    import time as _t
    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
    blobs = _drift_cat(root, where, paths, left) if paths else []
    if blobs is None:
        return None
    texts, bad = {}, []
    for p, b in zip(paths, blobs):
        if b is None:
            # 樹上列得出、內容讀不出來:建成讀不出的筆記(代碼審 r2 外家席:原本跳過,等於當成不存在)
            bad.append(p[len(pre):])
            continue
        try:
            texts[p[len(pre):]] = b.decode("utf-8-sig")
        except UnicodeDecodeError:
            bad.append(p[len(pre):])
    texts.update(override or {})
    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])


def _drift_vault_rel(root, where):
    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        return None
    wv = _vault_in(Path(root))
    try:
        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
    except ValueError:
        wv_rel = None
    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]


def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
    import time as _t
    pre = vault_rel.rstrip("/") + "/"
    if deadline is not None and _t.monotonic() > deadline:
        return None
    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _drift_empty_tree(root), tip, "--", vault_rel)
    if raw is None:
        return None
    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
               if x.strip("\n").startswith(pre)}
    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
              and _drift_str(n, "status") in _DRIFT_CLOSED}
    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "verification" and st == "pass",
                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
    if passed is None:
        return None
    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
    if closed is None:
        return None
    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}


def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None, override_base=None):
    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
    import time as _t

    def _left():
        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
    if tenv is None:
        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
    if _left() <= 0:
        return [], [], [over]
    reader = _nodehome_reader(root, tip)
    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
    if ev is None:
        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
               if _note_unreadable(n) and p in ev["touched"]]
    must, listed = [], []
    for f in _drift_state_findings(tenv):
        p, k = f["path"], f["kind"]
        if k == "c1":
            if p in ev["passed"]:
                must.append(f)
            continue
        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
        if hit:
            listed.append(f)
    if _left() <= 0:
        return must, listed, [*unknown, over]
    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
    return must + pm, listed + pl, unknown + pu



# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
_PROBE_KEYS = ("file", "symbol", "test", "status")
_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")


def _revisit_split(line):
    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
    import datetime
    if line.lstrip().startswith("|"):
        return None, None
    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
    if not s.startswith("REVISIT:"):
        return None, None
    rest = s[len("REVISIT:"):]
    if rest.lstrip().startswith("[when-"):
        return "cond", rest
    try:
        datetime.date.fromisoformat(rest.partition(" ")[0])
        return "date", rest
    except ValueError:
        return "bad", rest


def _revisit_lines(text):
    """一篇筆記的每一條回頭條件 → [(行號, 種類, 日期或 None, 摘要, 原文)];種類 date/cond/bad(同 _revisit_split)。
    剝程式碼區(_search_visible_lines)、餵剝過行內程式碼的那一版給 _revisit_split。doctor E5 與 set 把 Issue 結案時的列出
    共用這一支(存量漂移改法 第 6 節);乙的 _probe_lines、第一層、第二層各自的逐行迴圈不在這裡。"""
    out = []
    for no, raw, _pr in _search_visible_lines(text.split("\n"), False):
        kind, rest = _revisit_split(_strip_inline_markup(raw)[0])
        if kind is None:
            continue
        date, summ = None, ""
        if kind == "cond":
            date, summ = _probe_parse(rest)["by"], _PROBE_LEAD_RE.sub("", rest)
        elif kind == "date":
            date, _sp, summ = rest.partition(" ")
        out.append((no, kind, date, summ.strip(), raw))
    return out


def _issue_close_revisits(env, rel, new_status):
    """lumos set <Issue> status <結案值>、drift fix --kind c2 --close 之後:列出這篇★全部★回頭條件(不只到期的),
    提示結案了要改成結案說明或刪掉。只印、不擋、不改;行號用寫完之後從磁碟重讀的內容算(存量漂移改法 [S7])。"""
    n = env.notes.get(rel)
    if _drift_str(n, "type") != "issue" or str(new_status).strip() not in _ISSUE_CLOSED_STATUSES:
        return
    try:
        text = _phys_path(env.vault, rel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        return
    rows = _revisit_lines(text)
    if not rows:
        return
    print(f"這篇 Issue 結案了,還留著 {len(rows)} 行回頭條件——要改成結案說明或刪掉(只列出、不擋):")
    for no, _k, _d, _s, raw in rows:
        print(f"  · {_esc_clean(rel, 200)}:{no}  {_esc_clean(raw.strip(), 100)}")


def _probe_value_err(k, v):
    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
    if k not in _PROBE_KEYS:
        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
    if not v:
        return f"when-{k} 的值是空的"

    if k == "file":
        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
    if k in ("symbol", "test"):
        return _probe_named_err(k, v)
    node, eq, vals = v.partition("=")
    if not eq or not node.strip() or not vals.strip():
        return "when-status 要寫成 <節點>=<值>"
    if any(not x.strip() for x in vals.split("|")):
        return "when-status 的值用 | 分開時每一段都不能空"
    return None


def _probe_norm_value(k, v):
    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
    if k == "file":
        return nfc(_posix_norm(v))
    if k in ("symbol", "test") and "::" in v:
        path, name = v.rsplit("::", 1)
        return nfc(_posix_norm(path)) + "::" + name.strip()
    return v


def _probe_bad_path(p):
    return (not p) or p == "." or p.startswith("/") or ".." in p.split("/")


def _probe_named_err(k, v):
    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
    if "::" not in v:
        return None
    path, name = v.rsplit("::", 1)
    if not name.strip():
        return f"when-{k} 的名稱是空的"
    if _probe_bad_path(path.strip()):
        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
    return None


def _probe_parse(rest):
    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
    import datetime
    conds, by, errs, pos, bad = [], None, [], 0, False
    while True:
        m = _PROBE_TOKEN_RE.match(rest, pos)
        if not m:
            break
        pos = m.end()
        key, val = m.group(1), m.group(2).strip()
        if key == "by":
            if by is not None:
                errs.append("期限寫了兩個")
                continue
            try:
                datetime.date.fromisoformat(val)
                by = val
            except ValueError:
                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
            continue
        k = key[len("when-"):]
        # 反斜線先轉斜線再驗(代碼審 r3 正確性席:`a\..\x.py` 原本收成 x.py 過關,字面相同的 `a/../x.py` 卻被擋)
        err = _probe_value_err(k, val.replace("\\", "/") if k in ("file", "symbol", "test") else val)
        nv = val if err else _probe_norm_value(k, val)
        # 正規化之後再驗一次(代碼審 r2 正確性席、邊界席:`..\x.py` 原文用 / 切不出 .. 段,轉成斜線才是 ../x.py,
        # 原本第一層放行、check 與 scan 又默默丟掉,變成沒人看得到的死條件)
        err = err or _probe_value_err(k, nv)
        if err:
            errs.append(err)
            bad = True
        conds.append((k, val if err else nv))
    if not conds:
        errs.append("沒有條件標記")
    # bad:有條件寫錯——check 與 scan 看這個旗標決定評不評估,不拿存下來的值重驗(代碼審 r3 正確性席:寫錯的條件存的是
    # 原文,原文重驗可能過關,寫錯的行照樣被評估);只缺期限不算 bad,照評估
    return {"conds": conds, "by": by, "errs": errs, "bad": bad}


def _probe_lines(text):
    """一篇筆記的條件式回頭條件 → (清單[(行號, 原文, 解析結果)], 寫在不評估的地方[(行號, 原文, 原因)])。
    只認正文與摘要的可見行:圍欄(_visible_lines)、行內程式碼(_strip_inline_markup)、表格行裡的都不算;
    開頭欄位裡 summary 以外的欄與表格行裡的條件標記列成「寫在不評估的地方」(計劃〈做法〉第 0 節)。"""
    lines = text.split("\n")
    regs = _notelines_regions(text)
    vis = {no for no, _ln in _visible_lines(lines)}
    out, dead = [], []
    for i, ln in enumerate(lines, 1):
        if i not in vis:
            continue
        probe = _strip_inline_markup(ln)[0]
        table = probe.lstrip().startswith("|")
        if regs[i - 1] in ("body", "summary") and not table:
            kind, rest = _revisit_split(probe)
            if kind == "cond":
                out.append((i, ln.strip(), _probe_parse(rest)))
            continue
        if _PROBE_ANY_RE.search(probe):
            dead.append((i, ln.strip(), "寫在表格行裡,不評估" if table else "寫在開頭欄位裡 summary 以外的欄,不評估"))
    return out, dead


def _drift_probe_code_path(p):
    """乙拿來判 symbol/test、算候選的檔:副檔名在清單裡或沒副檔名(要看 #!),不含 docs/、governance/。
    候選篩選(_drift_probe_changes)與語料(_DriftProbeTree.corpus)共用這一支(代碼審 r1 圖譜一致席:原本兩邊範圍不同;
    正確性席:工具鏈主程式 scripts/lumos 沒有副檔名,原本整支不在語料裡,上面的 symbol 條件全是死條件)。"""
    return _nodehome_code_kind(p) in ("ext", "shebang?") and not p.startswith(("docs/", "governance/"))

def _drift_probe_is_candidate(conds, ch, vault_pre, tenv, tip_text):
    """這一行的條件會不會被這次推送改變結果(計劃〈做法〉第 0 節,篩選單位是行)→ True / False / None(判不了)。
    不帶路徑的 symbol/test:名稱出現在這次改到的程式或測試檔的★終點全文★就是候選(tip_text() → 那幾支的全文或 None)。
    ★為什麼不只看新增行★(代碼審 r2 正確性席):判定改用 ast、沒副檔名的 #! 腳本也算程式檔之後,「定義在不在」
    可以在名稱那一行沒動的情況下翻轉——只刪掉包住 def 的三引號、只在第一行加 #!。要處理只看終點成立,
    所以只要終點全文;順便省掉原本算新增行的那次 diff(標了 -diff 屬性的檔看不見新增行的坑也一起沒了)。
    tip_text() → _DriftNames(終點全文的識別字集合,名稱是一般識別字時查集合,不再對幾 MB 的字串逐條跑正則——
    代碼審 r3 併發席實測 100 行條件 10 秒)或 None。"""
    hits = [_drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text) for k, v in conds]
    # 任一確定受影響就是候選;判不了的不提前停(代碼審 r3 外家席:原本前一個判不了就回判不了,後面確定受影響的
    # 那條本來可以列成可表態的發現)
    if any(hits):
        return True
    return None if any(h is None for h in hits) else False


def _drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text):
    """一個條件會不會被這次推送改變結果 → True / False / None(判不了)。"""
    if k == "file":
        return v in ch["touched"]
    if k == "status":
        rel = _drift_status_target(tenv, v)[0]
        return rel is None or (vault_pre + rel) in ch["touched"]
    path, name = _drift_cond_split(v)
    if path:
        return path in ch["touched"]
    if ch["code_shape"]:
        return True
    if not ch["code_touched"]:
        return False
    names = tip_text(k == "test")
    if names is None:
        return None
    return True if names.has(name) else (None if names.partial else False)


def _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=None, override_base=None):
    """乙的推送判定 → (要處理, 只列出, 判不了)。候選行(被這次推送影響、或這次新寫/改了條件標記的)在終點評估全部條件;
    終點成立,而起點沒有「同一條」(改名對回後,條件標記一模一樣)或同一條還不成立 → 要處理;起點早就成立 → 不列。
    每一步開始前與每條候選之前都看預算(代碼審 r1 併發席:原本列樹、改名對照都不看)。"""
    import time as _t
    pre = vault_rel.rstrip("/") + "/"
    lines = [(p, no, tx, pr) for p in sorted(tenv.notes) for no, tx, pr in _probe_lines(env_text(tenv, p) or "")[0]]
    # 條件本身寫錯的行不評估(第一層擋新寫的、scan 列成寫錯);只缺期限的照評估
    lines = [x for x in lines if x[3]["conds"] and not x[3]["bad"]]
    if not lines:
        return [], [], []
    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算(條件式回頭條件)"

    def _out():
        return deadline is not None and _t.monotonic() >= deadline
    ch, benv, err = _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base)
    if err:
        return [], [], [over if _out() else err]
    trees = {}

    def _tree(where):
        if where not in trees:
            trees[where] = _drift_probe_tree(root, where, deadline)
        return trees[where]
    ch = _drift_with_layout(ch, base, tip, _tree)
    todo, unknown = _drift_probe_candidates(lines, ch, pre, tenv, benv, _tree(tip) if ch["code_touched"] else None, _out)
    if todo and not _out():
        _drift_probe_prefetch([c for x in todo for c in x[3]["conds"]], [_tree(w) for w in ((tip, base) if base else (tip,))])
    must = []
    for p, no, tx, pr, old in todo:
        verdict = None if _out() else _drift_probe_judge(
            lambda c: _drift_probe_line(_tree(tip), tenv, c), lambda c: _drift_probe_line(_tree(base), benv, c), pr, old)
        if verdict is None:
            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if _out() else "git 讀不出程式檔或筆記"
                           + _drift_bad_note(_drift_row_unread(pr["conds"], (tenv, benv), (trees.get(tip), trees.get(base))))) + ")")
        elif verdict:
            must.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [], "why": verdict})
    return must, [], unknown


def _drift_with_layout(ch, base, tip, tree_of):
    """兩端版面不一樣時把範圍改動標成形狀改變(所有不帶路徑的行都當候選);沒有起點(空樹)或已經是形狀改變就不看。"""
    if not base or ch["code_shape"] or not _drift_layout_changed(tree_of(base), tree_of(tip)):
        return ch
    return dict(ch, code_shape=True)


def _drift_layout_changed(tb, tt):
    """兩端的測試資料夾版面不一樣 → True(代碼審 r3 正確性席:版面看整棵樹、副檔名轉小寫,刪一支不算程式檔的
    Foo/Main.SWIFT 就能讓 FooTests/ 裡的檔從測試檔變程式檔,不帶路徑的條件翻成立卻不是候選)。讀不到樹當成有變。"""
    return tb is None or tt is None or tb.layout != tt.layout


def _drift_probe_prefetch(conds, trees):
    """帶路徑的條件指到的檔,每一版一個行程讀完(代碼審 r2 併發席);列不出樹的那一版跳過,輪到時再判不了。"""
    for t in trees:
        if t is not None:
            t.prefetch(conds)


def _drift_probe_candidates(lines, ch, pre, tenv, benv, tip_tree, out):
    """候選行 → ([(路徑, 行號, 原文, 解析, 起點有沒有同一條)], 判不了[說明])。起點沒有同一條的(新寫或改了條件)一律是候選。
    tip_tree:終點的樹(不帶路徑的條件要看改到的程式檔全文時用,只建一次);out():預算用完了沒——每一行之前都看,
    用完了剩下的行記成超過預算(代碼審 r3 併發席:原本整段不看預算)。"""
    base_lines, todo, unknown = {}, [], []

    def _names(test):
        return None if tip_tree is None else tip_tree.names_in(ch["code_touched"], test)
    for p, no, tx, pr in lines:
        if out():
            unknown.append(f"{p}:{no} 的條件判不了(超過預算)")
            continue
        old = _drift_probe_old(p, pr, ch["renames"], benv, pre, base_lines)
        cand = _drift_probe_is_candidate(pr["conds"], ch, pre, tenv, _names) if old else True
        if cand is None:
            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if out() else
                           "git 讀不出這次改到的程式檔" + _drift_bad_note(_drift_row_unread(pr["conds"], (), (tip_tree,)))) + ")")
        elif cand:
            todo.append((p, no, tx, pr, old))
    return todo, unknown


def _drift_row_unread(conds, envs, trees):
    """這一行的條件實際碰到、而且讀不出來的檔或筆記(r4 正確性席:原本點名整棵樹讀不出的全部檔,
    status 判不了的行反而點名一支無關的程式檔)。帶路徑的 symbol/test 看那一支;不帶路徑的看讀不出的程式檔;
    status 看指到的那篇筆記。"""
    out = set()
    for k, v in conds:
        if k == "status":
            for env in envs:
                rel, n, _want = _drift_status_target(env, v)
                if n is not None and _note_unreadable(n):
                    out.add(rel)
        elif k in ("symbol", "test"):
            for t in trees:
                if t is not None:
                    out.update(t.unread_for(k, v))
    return sorted(out)


def _drift_bad_note(paths):
    """判不了時點名讀不出來的檔(代碼審 r3 正確性席:原本只說讀不出,推的人找不到是哪支)。
    路徑來自被推送的內容,印之前把控制字元換成空格(r4 資安席;借逃逸帳的 _esc_clean)。"""
    bad = [_esc_clean(q) for q in paths]
    return (":" + "、".join(bad[:5]) + (f" 等 {len(bad)} 支" if len(bad) > 5 else "")) if bad else ""


def _drift_probe_old(p, pr, renames, benv, pre, cache):
    """起點有沒有「同一條」:終點路徑照改名對回起點,再比條件標記 → True/False;沒有起點回 None。cache 存每篇起點的標記集合。"""
    if benv is None:
        return None
    bp = renames.get(pre + p, pre + p)
    bp = bp[len(pre):] if bp.startswith(pre) else p
    if bp not in cache:
        cache[bp] = {tuple(x[2]["conds"]) for x in _probe_lines(env_text(benv, bp) or "")[0]}
    return tuple(pr["conds"]) in cache[bp]


def _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base):
    """推送判定要的起點資料 → (範圍改動, 起點圖譜, 判不了的原因或 None)。起點的圖譜位置與樹清單都走 _drift_list 的記憶。"""
    import time as _t
    ch = _drift_probe_changes(root, base, tip, deadline)
    if ch is None:
        return None, None, "git 算不出這次推送改了哪些檔(條件式回頭條件)"
    if not base:
        return ch, None, None
    if deadline is not None and _t.monotonic() >= deadline:
        return None, None, "預算用完"
    benv = _drift_tree_env(root, base, _drift_vault_rel(root, base) or vault_rel, override_base, deadline=deadline)
    if benv is None:
        return None, None, "git 讀不出起點的筆記(條件式回頭條件)"
    return ch, benv, None


def _drift_probe_judge(now_of, was_of, pr, old):
    """一條候選 → 要處理的原因字串 / ""(不列) / None(判不了)。終點成立,而起點沒有同一條或同一條還不成立 → 要處理。
    now_of / was_of:條件 → 終點 / 起點的判定(起點只在有同一條時才問)。"""
    conds = tuple(pr["conds"])
    now = now_of(conds)
    if now is None:
        return None
    if not now:
        return ""
    if old:
        was = was_of(conds)
        if was is None:
            return None
        if was:
            return ""
    return (("這次推送讓條件成立了" if old else "這次新寫(或改了條件)的回頭條件,條件已經成立")
            + (f";期限 {pr['by']}" if pr["by"] else ""))


def _drift_probe_path_warn(k, v, tree):
    """symbol/test 的路徑那段在樹上找不到、而且不像檔案路徑(沒有 / 也沒有字母開頭的副檔名)→ 問題說明;否則 None。
    `[when-symbol:Config::load]` 照文法從最後一個 :: 切成「路徑 Config、名稱 load」,永遠不成立(代碼審 r1 正確性席)。
    還沒建的檔(src/new.py::main)是正常的等待狀態,不列。副檔名要字母開頭:v1.2 這種版本號不算(代碼審 r2 邊界席);
    Makefile 這種沒副檔名的根目錄檔分不出來,提示裡講明「還沒建的根目錄檔就不用管」。"""
    if k not in ("symbol", "test") or "::" not in v or tree is None:
        return None
    path = v.rsplit("::", 1)[0].strip()
    if path in tree.files or "/" in path or _drift_looks_like_ext(path.rpartition(".")[2] if "." in path else ""):
        return None
    return (f"when-{k} 的路徑 {path} 在樹上找不到、也不像檔案路徑(寫成 型別::方法 了?名稱只寫方法名,或寫完整路徑::名稱;"
            "如果是還沒建的根目錄檔,像 Makefile,建了就會判,不用管)")


def _drift_looks_like_ext(ext):
    """像不像副檔名:字母開頭、只有字母數字與 _ + -,而且全小寫或全大寫(.py、.c++、.R、.SWIFT)。
    大小寫混著的(app.Config 的 Config)是限定名、數字開頭的(v1.2 的 2)是版本號(代碼審 r2、r3 邊界席;
    r3 外家席:原本只收 ASCII 英數,.c++ 被誤列)。"""
    return bool(ext) and ext[0].isalpha() and all(ch.isalnum() or ch in "_+-" for ch in ext) \
        and (ext == ext.lower() or ext == ext.upper())


def _drift_probe_row_problems(pr, nenv, tree):
    """一行條件式的寫法問題 → [原因]:寫錯的條件、沒帶期限、指到的筆記找不到、file 指到資料夾、symbol/test 的路徑不像檔案路徑。"""
    bad = list(pr["errs"])
    if pr["by"] is None and "沒有條件標記" not in bad:
        bad.append("沒帶期限 [by:YYYY-MM-DD]")
    if pr["bad"]:
        return bad      # 條件本身寫錯:錯誤已在 errs 裡,不再拿寫錯的值算別的提示
    for k, v in pr["conds"]:
        if k == "status" and nenv.resolve(link_target(v.partition("=")[0].strip())) is None:
            bad.append(f"when-status 指的筆記 {v.partition('=')[0].strip()} 找不到(改名或刪了?)")
        if k == "file" and tree is not None and v not in tree.files \
                and any(f.startswith(v.rstrip("/") + "/") for f in tree.files):
            bad.append(f"when-file 指到資料夾 {v}(要指一支檔)")
        w = _drift_probe_path_warn(k, v, tree)
        if w:
            bad.append(w)
    return bad


def _drift_probe_scan(nenv, tree, deadline=None):
    """scan 的乙部分 → (成立的行[發現], 問題[(路徑, 行號, 原文, 原因)])。問題:寫錯的條件、沒帶期限、指到的筆記找不到、
    file 指到資料夾、symbol/test 的路徑不像檔案路徑、寫在不評估的地方、判不了(分 git 讀不出與超過預算)。"""
    import time as _t

    def _over():
        return deadline is not None and _t.monotonic() >= deadline
    found, probs, per = [], [], []
    for p in sorted(nenv.notes):
        rows, dead = _probe_lines(env_text(nenv, p) or "")
        probs += [(p, no, tx, why) for no, tx, why in dead]
        per.append((p, rows))
    if not _over():
        _drift_probe_prefetch([c for _p, rows in per for _n, _t, pr in rows for c in pr["conds"]], [tree])
    for p, rows in per:
        for no, tx, pr in rows:
            probs += [(p, no, tx, why) for why in _drift_probe_row_problems(pr, nenv, tree)]
            if not pr["conds"] or pr["bad"]:
                continue
            ok = None if _over() else _drift_probe_line(tree, nenv, tuple(pr["conds"]))
            if ok is None:
                probs.append((p, no, tx, "判不了(超過預算)" if _over() else
                              "判不了(git 讀不出程式檔或筆記" + _drift_bad_note(_drift_row_unread(pr["conds"], (nenv,), (tree,))) + ")"))
            elif ok:
                found.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [],
                              "why": "條件已經成立,該處理了" + (f"(期限 {pr['by']})" if pr["by"] else "")})
    return found, probs


# ── 表態 ─────────────────────────────────────────────────────────────────────────────

def _drift_jsonl_parse(raw):
    """帳檔的位元組 → [dict](不是 JSON 物件的行略過)。表態檔與修復帳共用。
    ★只在 \\n 切行★:str.splitlines() 還會在 U+2028、U+0085、換頁字元切開,而寫入端 json.dumps(ensure_ascii=False)
    不跳脫這些字元——工具自己寫進去的一筆會被劈成兩段壞行、讀不回來,乾淨檢查與序號都跟著錯(代碼審 r1 邊界、併發席)。"""
    import json as _j
    out = []
    for ln in (raw or b"").decode("utf-8", errors="replace").split("\n"):
        if not ln.strip():
            continue
        try:
            d = _j.loads(ln)
        except (ValueError, RecursionError):
            continue
        if isinstance(d, dict):
            out.append(d)
    return out


def _drift_load_acks(root, where=None):
    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
    raw = None
    if where is None:
        fp = Path(root) / _DRIFT_ACKS
        try:
            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
        except OSError:
            raw = None
    else:
        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
        raw = bl[0] if bl else None
    return [d for d in _drift_jsonl_parse(raw) if d.get("path") and d.get("kind") in _DRIFT_KINDS]


def _drift_ack_key(path, text, kind):
    return (nfc(str(path)), str(text).strip(), kind)


def _drift_split_acked(findings, acks, vault_rel):
    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。
    cx = None
    if err is None:
        cx, err = _drift_fix_load(env, rel, line, kind, o)
    res = None
    if err is None:
        res, err = _DRIFT_FIX_COMPUTE[kind](cx)
        if err is None and res is None:
            return 0                                                 # c4 只列證據與範本
    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
    if err is None and o.get("dry_run"):
        _drift_fix_preview(cx, res)
        return 0
    # 帳檔路徑在寫筆記之前先查(代碼審 r1 邊界席:原本寫完筆記才發現帳寫不進去,留下改了筆記、沒帳、又不讓重跑的狀態)
    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    if _drift_fix_record(env, cx, res) != 0:
        return 2
    print(f"✓ drift fix {kind}:{_esc_clean(rel, 200)} 第 {line} 行——{res['msg']}")
    if kind == "c2":
        _issue_close_revisits(env, rel, o["status"])
    print(f"修復帳要跟筆記一起提交:\n    {_drift_git_hint(cx, 'add ' + _DRIFT_FIXES)} && git commit")
    return 0


# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit, old_sentence)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。
    old_sentence(舊句檢查 m1 的開關,Projects/舊句檢查_計劃〈做法〉3)跟 gate 各自解析、互不牽連:沒寫、寫 null、
    設定檔壞掉 → warn;寫了 block/warn/off 以外的值 → warn 並多一句提醒。"""
    p = _drift_config_text_parts(text)
    return p["gate_mode"], p["gate_warns"] + p["os_warns"], p["explicit"], p["old_sentence"]


def _drift_config_parts(cfg, bad):
    """兩個開關各自的解析結果(doctor 要分開講,不靠提醒文字拆;代碼審 r2 架構對齊席)。"""
    gate, gw, explicit = _drift_gate_config(cfg, bad)
    osm, osw = _drift_old_sentence_config(cfg, bad)
    return {"gate_mode": gate, "gate_warns": gw, "explicit": explicit, "old_sentence": osm, "os_warns": osw}


def _drift_config_text_parts(text):
    """設定檔內容 → _drift_config_parts(解析寫法同 _drift_config)。"""
    import json as _j
    cfg, bad = None, False
    if text is not None:
        try:
            cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
        except (ValueError, UnicodeDecodeError):
            bad = True
    return _drift_config_parts(cfg, bad)


def _drift_old_sentence_config(cfg, bad=False):
    """→ (block|warn|off, [提醒])。預設 warn,跟 drift_check.gate 的預設(block)各管各的;設定檔讀不成 JSON 時也照 warn
    並另講一句(gate 那句只講 gate 的預設,不另講會讓人以為舊句檢查也跟著擋)。"""
    if bad:
        return "warn", [".lumos/config.json 讀不成 JSON,舊句檢查(drift_check.old_sentence)照預設 warn"]
    dc = cfg.get("drift_check") if isinstance(cfg, dict) else None
    if isinstance(cfg, dict) and "drift_check" in cfg and not isinstance(dc, dict):
        # 父層寫壞(字串、null、陣列):gate 那邊講 drift_check 不是物件;這邊也講舊句檢查照預設(代碼審 r3 外家 finder 席)
        return "warn", ["drift_check 不是物件,舊句檢查(drift_check.old_sentence)照預設 warn"]
    v = dc.get("old_sentence") if isinstance(dc, dict) else None
    if v is None:
        return "warn", []
    if v not in _DRIFT_GATE_VALUES:
        return "warn", [f"drift_check.old_sentence 只能是 block/warn/off,你寫的是 {v!r},照預設 warn"]
    return v, []


def _drift_gate_config(cfg, bad):
    """drift_check.gate → (gate, warnings, explicit)。bad=設定檔讀不成 JSON。"""
    if bad:
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


def _drift_print_findings(rows, stream, acks=None, alive=None):
    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
              file=stream)
        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
        prev = _drift_prev_ack_line(f)
        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
        if prev:
            print(f"      ({_esc_clean(prev, 400)})", file=stream)
        elif old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  其餘 {len(rows) - 20} 筆這裡沒印;改完這些再推會再列" if rows[0]["kind"] == "m1"
              else f"  …還有 {len(rows) - 20} 筆", file=stream)



