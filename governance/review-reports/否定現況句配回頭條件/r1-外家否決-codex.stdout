 26737	def _probe_value_err(k, v):
 26738	    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
 26739	    if k not in _PROBE_KEYS:
 26740	        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
 26741	    if not v:
 26742	        return f"when-{k} 的值是空的"
 26743	
 26744	    if k == "file":
 26745	        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
 26746	    if k in ("symbol", "test"):
 26747	        return _probe_named_err(k, v)
 26748	    node, eq, vals = v.partition("=")
 26749	    if not eq or not node.strip() or not vals.strip():
 26750	        return "when-status 要寫成 <節點>=<值>"
 26751	    if any(not x.strip() for x in vals.split("|")):
 26752	        return "when-status 的值用 | 分開時每一段都不能空"
 26753	    return None
 26754	
 26755	
 26756	def _probe_norm_value(k, v):
 26757	    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
 26758	    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
 26759	    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
 26760	    if k == "file":
 26761	        return nfc(_posix_norm(v))
 26762	    if k in ("symbol", "test") and "::" in v:
 26763	        path, name = v.rsplit("::", 1)
 26764	        return nfc(_posix_norm(path)) + "::" + name.strip()
 26765	    return v
 26766	
 26767	
 26768	def _probe_bad_path(p):
 26769	    return (not p) or p == "." or p.startswith("/") or ".." in p.split("/")
 26770	
 26771	
 26772	def _probe_named_err(k, v):
 26773	    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
 26774	    if "::" not in v:
 26775	        return None
 26776	    path, name = v.rsplit("::", 1)
 26777	    if not name.strip():
 26778	        return f"when-{k} 的名稱是空的"
 26779	    if _probe_bad_path(path.strip()):
 26780	        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
 26781	    return None
