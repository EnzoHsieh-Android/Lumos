   262	def load_hits(paths):
   263	    rows, metas = [], {}
   264	    for p in paths:
   265	        for ln in Path(p).read_text(encoding="utf-8").splitlines():
   266	            d = json.loads(ln)
   267	            if "_meta" in d:
   268	                metas[d["tag"]] = d["_meta"]
   269	            else:
   270	                rows.append(d)
   271	    return rows, metas
   272	
   273	
   274	def funnel(rows, refined=True):
   275	    """窄表命中 →(細化:扣工具預告句 → 扣引號/修飾語/條件子句)→ 扣歷史 → 扣規則句 → 扣已配 = 會被提醒。
   276	    refined=False 是第一版(只有窄表、歷史、規則、已配),留著對照。回 (各階段計數, 會被提醒的列)。"""
   277	    st = {"broad_or_narrow": len(rows)}
   278	    cur = [r for r in rows if r["narrow"]]
   279	    st["narrow"] = len(cur)
   280	    if refined:
   281	        cur = [r for r in cur if not r["template"]]
   282	        st["minus_template"] = len(cur)
   283	        cur = [r for r in cur if r["narrow_live"]]
   284	        st["minus_quote_modifier"] = len(cur)
   285	    cur = [r for r in cur if not r["hist"]]
   286	    st["minus_hist"] = len(cur)
   287	    cur = [r for r in cur if not r["rule"]]
   288	    st["minus_rule"] = len(cur)
   289	    st["paired_cond"] = sum(r["paired"] == "cond" for r in cur)
   290	    st["paired_date"] = sum(r["paired"] == "date" for r in cur)
   291	    if refined:    # 第一版沒認行內的 REVISIT(第一次抽樣就是從那個母體抽的,照留才能重現)
   292	        st["paired_inline"] = sum(bool(r["inline_revisit"]) and not r["paired"] for r in cur)
   293	        remind = [r for r in cur if not r["paired"] and not r["inline_revisit"]]
   294	    else:
   295	        remind = [r for r in cur if not r["paired"]]
   296	    st["remind"] = len(remind)
   297	    return st, remind
   298	
   299	
   300	def _per_repo(rows, metas):
   301	    for tag in sorted({r["repo"] for r in rows} | set(metas)):
   302	        rs = [r for r in rows if r["repo"] == tag]
   303	        f1, _r1 = funnel(rs, refined=False)
   304	        f, remind = funnel(rs)
   305	        by_commit = Counter(r["commit"] for r in remind)
   306	        print(f"\n[{tag}] meta={metas.get(tag)}")
   307	        print("  漏斗(第一版):", json.dumps(f1, ensure_ascii=False))
   308	        print("  漏斗(細化):", json.dumps(f, ensure_ascii=False))
   309	        print(f"  有提醒的提交 {len(by_commit)};每個有提醒的提交行數 中位 "
   310	              f"{sorted(by_commit.values())[len(by_commit) // 2] if by_commit else 0} 最多 {max(by_commit.values(), default=0)}")
   311	        print("  區塊:", dict(Counter(r["region"] for r in remind)), " 形狀:", dict(Counter(r["shape"] for r in remind).most_common(8)))
   312	        print("  窄表字眼(提醒列):", dict(Counter(w for r in remind for w in r["narrow"]).most_common(20)))
   313	        print("  寬表字眼(全部命中列):", dict(Counter(w for r in rs for w in r["broad"]).most_common(20)))
   314	        print("  固定組合被扣掉的行:", sum(1 for r in rs if r["notlack"]))
   315	
