    37	
    38	
    39	LM = _load_lumos()
    40	
    41	# ── 字眼表 ──
    42	# 窄表=計劃提議的規則要認的字眼:講「現在缺、之後會有」的時間性否定。寬表=窄表加上一般否定字(對照組,量誤觸)。
    43	NARROW_ZH = ("還沒", "尚未", "仍未", "尚無", "暫無", "待補", "目前沒有", "現在沒有", "目前無", "目前還不",
    44	             "現在還不", "未實作", "未上線", "未接", "未做", "未支援", "未完成", "未定義", "未補")
    45	NARROW_EN = ("not yet", "TODO", "TBD", "yet to")
    46	BROAD_ZH = ("沒有", "沒", "未", "不存在", "缺", "無", "不會")
    47	BROAD_EN = ("missing", "no", "lack", "lacks", "absent", "does not exist", "doesn't exist")
    48	# 否定字眼其實不是在講缺東西的固定組合(從窄寬兩表的比對裡先扣掉;量測也分開算它們誤觸幾次)
    49	NOT_LACK = ("未來", "有沒有", "未必", "無論", "無法", "並無", "沒問題", "沒有問題", "無誤", "無關", "無妨",
    50	            "毫無", "無效", "無窮", "未知", "未曾", "未經", "no-verify", "no longer")
    51	HIST_MARK = ("當時", "原本", "原先", "曾", "之前", "以前", "那時", "起初", "後來", "已補", "已修", "修掉",
    52	             "改成", "改為", "已經有", "現在有了", "已上線", "已做完")
    53	RULE_MARK = ("不准", "不要", "別", "禁止", "不得", "勿", "一律不", "不應")
    54	
    55	
    56	def _rx(words):
    57	    parts = []
    58	    for w in sorted(set(words), key=len, reverse=True):
    59	        e = re.escape(w)
    60	        parts.append(r"(?<![A-Za-z0-9_-])" + e + r"(?![A-Za-z0-9_-])" if w.isascii() else e)
    61	    return re.compile("|".join(parts), re.I)
    62	
    63	
    64	RX_NARROW = _rx(NARROW_ZH + NARROW_EN)
    65	RX_BROAD = _rx(BROAD_ZH + BROAD_EN)
    66	RX_NOTLACK = _rx(NOT_LACK)
    67	RX_HIST = _rx(HIST_MARK)
    68	RX_RULE = _rx(RULE_MARK)
    69	CLAUSE_CUT = re.compile(r"[。;；!?！？]")
    70	
    71	
    72	def _mask_notlack(s):
    73	    """把不是在講缺東西的固定組合遮掉,回 (遮後字串, 遮掉幾處)。"""
    74	    n = [0]
    75	
    76	    def rep(m):
    77	        n[0] += 1
    78	        return "\0" * len(m.group(0))
    79	    return RX_NOTLACK.sub(rep, s), n[0]
    80	
    81	
    82	def _clause_at(s, pos):
    83	    a = 0
    84	    for m in CLAUSE_CUT.finditer(s):
    85	        if m.end() <= pos:
    86	            a = m.end()
    87	        else:
    88	            return s[a:m.start()]
    89	    return s[a:]
    90	
    91	
    92	QUOTE_PAIRS = (("「", "」"), ("『", "』"), ("“", "”"), ("\"", "\""))
    93	# 「還沒 X 的 Y」「還沒 X 時/前 …」「還沒 X → …」:否定字眼在修飾語或條件子句裡,講的是程式怎麼處理「還沒 X」的資料,不是現況缺東西
    94	RX_MODIFIER = re.compile(r"^[^,，、。;；:：()（）「」]{0,8}?(的|時|前|→)")
    95	# 工具自己寫的預告句(guard plan 寫、guard settle 轉正時改寫;存量漂移甲 c1 已經管)
    96	TEMPLATE_MARKS = ("TEST:還沒有測試在守這條", "]預告這條合約但還沒做:")
    97	
    98	
    99	def _in_quote(s, pos):
   100	    for a, b in QUOTE_PAIRS:
   101	        depth = 0
   102	        for ch in s[:pos]:
   103	            if a == b and ch == a:
   104	                depth ^= 1
   105	            elif ch == a:
   106	                depth += 1
   107	            elif ch == b and depth:
   108	                depth -= 1
   109	        if depth:
   110	            return True
   111	    return False
   112	
   113	
   114	def _live(masked, m):
   115	    """這一處否定字眼算不算「在講現況缺東西」:不在引號裡(是在提這個字)、不在修飾語或條件子句裡。"""
   116	    if _in_quote(masked, m.start()):
   117	        return False
   118	    return not RX_MODIFIER.match(masked[m.end():])
   119	
   120	
   121	def classify_text(probe):
   122	    """一行看得見的字 → 比對結果 dict(沒有任何否定字眼回 None)。
   123	    narrow/broad 是字面命中;narrow_live 是扣掉引號內、修飾語與條件子句之後還在的窄表命中(細化規則用)。"""
   124	    masked, n_notlack = _mask_notlack(probe)
   125	    nar = list(RX_NARROW.finditer(masked))
   126	    bro = list(RX_BROAD.finditer(masked))
   127	    if not nar and not bro and not n_notlack:
   128	        return None
   129	    live = [m for m in nar if _live(masked, m)]
   130	    hits = live or nar or bro
   131	    clauses = [_clause_at(masked, m.start()) for m in hits]
   132	    return {
   133	        "narrow": sorted({m.group(0) for m in nar}),
   134	        "narrow_live": sorted({m.group(0) for m in live}),
   135	        "broad": sorted({m.group(0) for m in bro}),
   136	        "notlack": n_notlack,
   137	        "hist": any(RX_HIST.search(c) for c in clauses),
   138	        "rule": any(RX_RULE.search(c) for c in clauses),
   139	        "template": any(t in probe for t in TEMPLATE_MARKS),
   140	        "inline_revisit": "REVISIT:" in probe,
   141	    }
   142	
   143	
   144	# ── git ──
   145	
   146	
   147	def git(repo, *args):
   148	    r = subprocess.run(["git", "-C", repo, "-c", "core.quotePath=off", *args], capture_output=True)
   149	    if r.returncode != 0:
   150	        raise RuntimeError(f"git {args[:3]} rc={r.returncode}: {r.stderr[:300]!r}")
   151	    return r.stdout.decode("utf-8", "replace")
   152	
   153	
   154	HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
   155	
   156	
   157	def added_lines(repo, parent, commit, vault):
   158	    """這個提交在圖譜 .md 新增或改寫的行 → {路徑: {新行號}}(--no-renames:改名過來的整篇算新寫,跟 note-shape 看新行一致的保守口徑)。"""
   159	    out, cur, ln = {}, None, 0
   160	    diff = git(repo, "diff", "--unified=0", "--no-renames", "--no-color", "--no-ext-diff", parent, commit, "--", vault)
   161	    for line in diff.split("\n"):
   162	        if line.startswith("+++ "):
   163	            p = line[4:]
   164	            cur = p[2:] if p.startswith("b/") and p.endswith(".md") else None
   165	            continue
   166	        m = HUNK_RE.match(line)
   167	        if m:
   168	            ln = int(m.group(1))
   169	            continue
   170	        if cur and line.startswith("+"):
   171	            out.setdefault(cur, set()).add(ln)
   172	            ln += 1
   173	    return out
   174	
   175	
   176	def _revisit_near(lines, regions, i, span=3):
   177	    """第 i 行(從 1 起)前後 span 行、同一區塊裡有沒有 REVISIT:回 'cond'/'date'/None(有條件式優先)。"""
   178	    kinds = set()
   179	    for j in range(max(1, i - span), min(len(lines), i + span) + 1):
   180	        if j == i or regions[j - 1] != regions[i - 1]:
   181	            continue
   182	        k, _r = LM._revisit_split(LM._strip_inline_markup(lines[j - 1])[0])
   183	        if k in ("cond", "date"):
   184	            kinds.add(k)
   185	    return "cond" if "cond" in kinds else ("date" if "date" in kinds else None)
   186	
   187	
   188	def _shape(probe):
   189	    t = probe.lstrip()
   190	    if t.startswith("|"):
   191	        return "table"
   192	    if t.startswith("#"):
   193	        return "heading"
   194	    m = re.match(r"^(?:[-*+]\s+)?([A-Z][A-Z-]+):", t)
   195	    return m.group(1) if m else "prose"
   196	
