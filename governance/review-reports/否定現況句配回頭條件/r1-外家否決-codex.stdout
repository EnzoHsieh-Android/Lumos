 27696	    _gate_event_or_warn(root, "drift-check", "acked", f"{rel}:{line} {kind}:{reason.strip()[:80]}")
 27697	    print(f"✓ 表態記下了({token}):{_esc_clean(rel, 200)} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]})"
