    29	def _load_lumos():
    30	    p = str(TC_ROOT / "scripts" / "lumos")
    31	    loader = importlib.machinery.SourceFileLoader("lumos_mod", p)
    32	    spec = importlib.util.spec_from_loader("lumos_mod", loader)
    33	    m = importlib.util.module_from_spec(spec)
