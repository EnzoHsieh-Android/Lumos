 27317	def _drift_probe_candidates(lines, ch, pre, tenv, benv, tip_tree, out):
 27318	    """候選行 → ([(路徑, 行號, 原文, 解析, 起點有沒有同一條)], 判不了[說明])。起點沒有同一條的(新寫或改了條件)一律是候選。
 27319	    tip_tree:終點的樹(不帶路徑的條件要看改到的程式檔全文時用,只建一次);out():預算用完了沒——每一行之前都看,
 27320	    用完了剩下的行記成超過預算(代碼審 r3 併發席:原本整段不看預算)。"""
 27321	    base_lines, todo, unknown = {}, [], []
 27322	
 27323	    def _names(test):
 27324	        return None if tip_tree is None else tip_tree.names_in(ch["code_touched"], test)
 27325	    for p, no, tx, pr in lines:
 27326	        if out():
 27327	            unknown.append(f"{p}:{no} 的條件判不了(超過預算)")
 27328	            continue
 27329	        old = _drift_probe_old(p, pr, ch["renames"], benv, pre, base_lines)
 27330	        cand = _drift_probe_is_candidate(pr["conds"], ch, pre, tenv, _names) if old else True
 27331	        if cand is None:
 27332	            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if out() else
 27333	                           "git 讀不出這次改到的程式檔" + _drift_bad_note(_drift_row_unread(pr["conds"], (), (tip_tree,)))) + ")")
 27334	        elif cand:
 27335	            todo.append((p, no, tx, pr, old))
 27336	    return todo, unknown
