 27632	def _drift_ack_names_err(kind, names):
 27633	    """--name 只給 m1:m1 要至少一個,每個去頭尾空白後 1 到 200 字、一行;別的種類帶 --name 是錯(Projects/舊句檢查_計劃〈做法〉3)。"""
 27634	    if kind != "m1":
 27635	        return "--name 只給 --kind m1(舊句檢查)用,其他種類不收" if names else None
 27636	    if not names:
 27637	        return "--kind m1 要至少一個 --name=<名稱>(照 drift check 印的改法指令貼,一個名稱一個 --name=)"
 27638	    for n in names:
 27639	        if _drift_m1_name_canon(n) is None:     # 跟候選名稱同一套(列得出來的名稱一定收得下)
 27640	            return (f"--name 每個都要 1 到 {_DRIFT_M1_NAME_MAX} 字、一行、頭尾沒有空白、不帶控制字元"
 27641	                    f"(這個不行:{_drift_m1_show(n, 60)!r})")
 27642	    return None
