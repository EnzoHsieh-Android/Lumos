 27515	def _drift_ack_key(path, text, kind):
 27516	    return (nfc(str(path)), str(text).strip(), kind)
 27517	
 27518	
 27519	def _drift_split_acked(findings, acks, vault_rel):
 27520	    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。
 27521	    ★c2、c3 另外要綁當時的關係★(存量漂移改法 [S8]):只看記了 related 的表態,取 seq 最大的那幾筆(同號全算),
 27522	    全部都涵蓋現在的已收尾計劃清單才算已表態;沒記 related 的舊表態、seq 不是正整數的(手改壞了)都不算數
 27523	    (不然會永久豁免之後才收尾的計劃;壞序號原本被當成 0 號照樣生效,代碼審 r1 外家席)。
 27524	    沒涵蓋但以前表態過的,沒表態那一邊的發現多帶 prev_ack(最近一次當時連著哪幾篇、理由),印的時候講出來。
 27525	    ★m1 另一條分支★(_drift_m1_split_acked;m1 不放進 _DRIFT_BOUND_KINDS):同路徑同原文所有 m1 表態的名稱取聯集。"""
 27526	    if any(f["kind"] == "m1" for f in findings):
 27527	        l1, d1 = _drift_m1_split_acked([f for f in findings if f["kind"] == "m1"], acks, vault_rel)
 27528	        l2, d2 = _drift_split_acked([f for f in findings if f["kind"] != "m1"], acks, vault_rel)
 27529	        return l2 + l1, d2 + d1
 27530	    keys, bound = set(), {}
 27531	    for a in acks:
 27532	        k = _drift_ack_key(a["path"], a.get("text", ""), a["kind"])
 27533	        if a["kind"] in _DRIFT_BOUND_KINDS:
 27534	            if "related" in a and _drift_seq_ok(a):
 27535	                bound.setdefault(k, []).append(a)
 27536	        else:
 27537	            keys.add(k)
 27538	    pre = vault_rel.rstrip("/") + "/"
 27539	    left, done = [], []
 27540	    for f in findings:
 27541	        k = _drift_ack_key(pre + f["path"], f["text"], f["kind"])
 27542	        if f["kind"] not in _DRIFT_BOUND_KINDS:
 27543	            (done if k in keys else left).append(f)
 27544	            continue
 27545	        top = _drift_bound_latest(bound.get(k, []))
 27546	        cur = {nfc(str(x)) for x in f.get("related", [])}
 27547	        if top and all(_drift_related_ok(a) and cur <= {nfc(x) for x in a["related"]} for a in top):
 27548	            done.append(f)
 27549	        elif top:
 27550	            left.append(dict(f, prev_ack={"related": top[-1].get("related"), "reason": top[-1].get("reason")}))
 27551	        else:
 27552	            left.append(f)
 27553	    return left, done
 27554	
 27555	
 27556	def _drift_m1_split_acked(findings, acks, vault_rel):
 27557	    """m1 的表態比對:同路徑、同原文(去頭尾空白)、kind m1 的★所有★表態,names 取聯集;一筆發現的名稱集合是聯集的子集
 27558	    才算已表態。沒有 names 欄或空清單的不涵蓋任何名稱。取聯集、不照 c2/c3 只看最新:m1 的名稱一旦為這一句原文表態過就不會變,
 27559	    原文一改鍵就換了(Projects/舊句檢查_計劃〈做法〉3)。"""
 27560	    cover = {}
 27561	    for a in acks:
 27562	        if a["kind"] == "m1" and isinstance(a.get("names"), list):
 27563	            k = _drift_ack_key(a["path"], a.get("text", ""), "m1")
 27564	            cover.setdefault(k, set()).update(c for c in map(_drift_m1_name_canon, a["names"]) if c)
 27565	    pre = vault_rel.rstrip("/") + "/"
 27566	    left, done = [], []
 27567	    for f in findings:
 27568	        got = cover.get(_drift_ack_key(pre + f["path"], f["text"], "m1"), set())
 27569	        want = {_drift_m1_name_canon(n) for n in f["names"]}
 27570	        (done if f["names"] and None not in want and want <= got else left).append(f)
 27571	    return left, done
 27572	
