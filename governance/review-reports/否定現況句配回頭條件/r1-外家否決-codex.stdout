 28573	def _drift_check_c(root, mode, os_mode, base, tip, vault_rel):
 28574	    """drift check 的 c1 到 c5 與 probe 那段(原本 cmd_drift_check 的後半)→ rc_core。gate=off 時不跑、回 0。"""
 28575	    import time as _t
 28576	    if mode == "off":
 28577	        print("存量漂移檢查:c1\u2013c5 與回頭條件關掉了(drift_check.gate=off);舊句檢查另有開關 drift_check.old_sentence,"
 28578	              "有改到程式檔時照跑" if os_mode != "off" else
 28579	              "存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 28580	        return 0
 28581	    if isinstance(base, tuple):       # 推送起點算不出來:判不了,算要處理(block 擋、warn 印)
 28582	        must, listed, unknown = [], [], [f"推送範圍的起點算不出來({base[1]})"]
 28583	    else:
 28584	        must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 28585	                                                  deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 28586	    acks = _drift_load_acks(root, tip)
 28587	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 28588	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 28589	    lst = _nodehome_list(root, tip)
 28590	    alive = set(lst[1]) if lst else None
 28591	    if listed:
 28592	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 28593	        _drift_print_findings(listed, sys.stderr, acks, alive)
 28594	        _drift_print_hints(listed, sys.stderr)
 28595	    if not must and not unknown:
 28596	        return 0
 28597	    return _drift_report_must(root, mode, must, unknown, acks, alive)
