 27779	
 27780	_DRIFT_PLACEHOLDER_RE = re.compile(r"<(?:為什麼[^<>\n]{0,30}|sha|卷證)>")
 27781	
 27782	
 27783	def _drift_placeholder_err(text, what):
 27784	    """提示裡的佔位字(<為什麼算解決…>、<sha>)原樣照抄進來 → 錯誤(代碼審 r1 合約圖譜席:照貼提示就把一篇還沒解決的
 27785	    Issue 標成結案、理由是佔位字)。只認 _drift_fix_hint 與 c4 證據頁真的印過、而且會被貼進 --reason/--new 的那幾種
 27786	    (為什麼…、sha、卷證);`Map<K,V>`、`<src/lib>` 這種真理由照收(代碼審 r2 正確性席、r3 邊界席)。"""
 27787	    m = _DRIFT_PLACEHOLDER_RE.search(text or "")
 27788	    return f"{what} 裡還留著提示的佔位字「{m.group(0)}」——換成真的內容再跑" if m else None
 27789	
 27790	
 27791	def _drift_sh(v, node=False):
 27792	    """印給人照貼的指令裡的一個參數:只由文字、數字(含中日韓文字)、底線與 ./@%+=:,- 組成就原樣,其他一律 shlex.quote
 27793	    (代碼審 r1 資安席:檔名帶 $(…)、; 或反引號的筆記,照貼提示就會執行攻擊者的指令;正確性席:帶空白會被切成兩個參數)。
 27794	    不直接全部 _sh_quote:它把中文也當危險字元,圖譜裡幾乎每條提示都會被包上引號;其他字元一律交給 _sh_quote。
 27795	    node=True(drift fix 的節點參數):以 - 開頭會被當成選項,加引號也沒用(shell 會拿掉引號),補成 ./ 開頭——
 27796	    _drift_fix_target 認得這個寫法(代碼審 r2 資安席)。"""
 27797	    v = str(v)
 27798	    if node and v.startswith("-"):
 27799	        v = "./" + v
 27800	    return v if v and re.fullmatch(r"[\w./@%+=:,-]+", v) else _sh_quote(v)
 27801	
 27802	
 27803	def _drift_m1_special_chars(v):
 27804	    """字串帶 Unicode 類別 Cc(控制)、Cf(方向控制、零寬)、Zl、Zp(行段分隔)的字元,或不是 UTF-8(無損解碼留下的替身 Cs)。"""
 27805	    import unicodedata
 27806	    return any(unicodedata.category(c) in ("Cc", "Cf", "Zl", "Zp", "Cs") for c in str(v))
 27807	
 27808	
 27809	def _drift_fix_hint(kind, path, line, names=None):
 27810	    """一筆發現該印的改法指令 → [指令]。★提示的單一產生處★(存量漂移改法 [S10]):drift check 擋下與只列出、drift scan、
 27811	    doctor Z 段、計劃收尾的連帶待辦都從這裡拿,不再各自教人手改。
 27812	    m1(舊句檢查)帶名稱:每個名稱整段 --name=<名稱> 過 _drift_sh(旗標類名稱以 -- 開頭,--name --restore 會被 argparse
 27813	    當成少一個值);<為什麼照留> 是刻意的佔位字,原樣照貼會被 _drift_placeholder_err 擋成 rc 2。"""
 27814	    node = _drift_sh(path[:-3] if path.endswith(".md") else path, node=True)
 27815	    if kind == "m1" and any(_drift_m1_special_chars(x) for x in [path, *(names or [])]):
 27816	        # 路徑或名稱帶控制字元、方向控制與零寬、行段分隔字元或不是 UTF-8:印出來的樣子跟實際字串不同(印之前 _esc_clean 還會把
 27817	        # 控制字元換成空白),照貼會找不到那篇、甚至寫到另一篇,不印可照貼的指令(代碼審 r2 資安席、r3 外家否決席、正確性席、邊界席)
 27818	        return [f"改成歷史說法(例:「原本叫 <名稱>,已移除」)或刪掉這句;路徑含特殊字元({_esc_clean(_drift_c4_show_name(path), 300)}),"
 27819	                "這裡不印照貼的表態指令,請手動表態(或先把檔名改掉)"]
 27820	    if kind == "m1":
 27821	        cmd = (f"lumos drift ack {node} {line} --kind m1 " + " ".join(_drift_sh("--name=" + n) for n in (names or []))
 27822	               + ' --reason "<為什麼照留>"')
 27823	        s = "改成歷史說法(例:「原本叫 <名稱>,已移除」)或刪掉這句;確定照留就 " + cmd
 27824	        return [s if len(s) <= 4000 else f"名稱太多,先改寫這一行({node} 第 {line} 行)"]
 27825	    base = f"lumos drift fix {node} {line} --kind {kind}"
 27826	    if kind == "c2":
 27827	        return [base + ' --close --status done --reason "<為什麼算解決,附提交或測試>"',
 27828	                base + ' --keep --reason "<為什麼還沒解決>"']
 27829	    if kind == "c3":
 27830	        return [base + " --status <" + "/".join(sorted(_DRIFT_C3_STATUSES)) + '> [--reason "…"]']
 27831	    if kind == "c4":
 27832	        return [base + "   # 列證據、範本與預填好的 lumos set 整欄指令(c4 不自己寫檔)"]
 27833	    if kind == "probe":
 27834	        return [f"條件成立了:把待辦做掉後刪掉 {node} 第 {line} 行或改寫成歷史說法;照留就 "
 27835	                f'lumos drift ack {node} {line} --kind probe --reason "<為什麼照留>"']
 27836	    return [base]
