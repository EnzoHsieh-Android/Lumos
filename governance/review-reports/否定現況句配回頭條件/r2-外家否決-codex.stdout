 27257	def _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=None, override_base=None):
 27258	    """乙的推送判定 → (要處理, 只列出, 判不了)。候選行(被這次推送影響、或這次新寫/改了條件標記的)在終點評估全部條件;
 27259	    終點成立,而起點沒有「同一條」(改名對回後,條件標記一模一樣)或同一條還不成立 → 要處理;起點早就成立 → 不列。
 27260	    每一步開始前與每條候選之前都看預算(代碼審 r1 併發席:原本列樹、改名對照都不看)。"""
 27261	    import time as _t
 27262	    pre = vault_rel.rstrip("/") + "/"
 27263	    lines = [(p, no, tx, pr) for p in sorted(tenv.notes) for no, tx, pr in _probe_lines(env_text(tenv, p) or "")[0]]
 27264	    # 條件本身寫錯的行不評估(第一層擋新寫的、scan 列成寫錯);只缺期限的照評估
 27265	    lines = [x for x in lines if x[3]["conds"] and not x[3]["bad"]]
 27266	    if not lines:
 27267	        return [], [], []
 27268	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算(條件式回頭條件)"
 27269	
 27270	    def _out():
 27271	        return deadline is not None and _t.monotonic() >= deadline
 27272	    ch, benv, err = _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base)
 27273	    if err:
 27274	        return [], [], [over if _out() else err]
 27275	    trees = {}
 27276	
 27277	    def _tree(where):
 27278	        if where not in trees:
 27279	            trees[where] = _drift_probe_tree(root, where, deadline)
 27280	        return trees[where]
 27281	    ch = _drift_with_layout(ch, base, tip, _tree)
 27282	    todo, unknown = _drift_probe_candidates(lines, ch, pre, tenv, benv, _tree(tip) if ch["code_touched"] else None, _out)
 27283	    if todo and not _out():
 27284	        _drift_probe_prefetch([c for x in todo for c in x[3]["conds"]], [_tree(w) for w in ((tip, base) if base else (tip,))])
 27285	    must = []
 27286	    for p, no, tx, pr, old in todo:
 27287	        verdict = None if _out() else _drift_probe_judge(
 27288	            lambda c: _drift_probe_line(_tree(tip), tenv, c), lambda c: _drift_probe_line(_tree(base), benv, c), pr, old)
 27289	        if verdict is None:
 27290	            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if _out() else "git 讀不出程式檔或筆記"
 27291	                           + _drift_bad_note(_drift_row_unread(pr["conds"], (tenv, benv), (trees.get(tip), trees.get(base))))) + ")")
 27292	        elif verdict:
 27293	            must.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [], "why": verdict})
 27294	    return must, [], unknown
 27295	
