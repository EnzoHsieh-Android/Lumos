 24745	def _notelines_regions(text):
 24746	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 24747	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 24748	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 24749	    lines = text.split("\n")
 24750	    fm, _body = split_frontmatter(text)
 24751	    if fm is None:
 24752	        if text.startswith("---"):
 24753	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 24754	        return ["body"] * len(lines)
 24755	    out = ["body"] * len(lines)
 24756	    end = len(fm) + 1                            # 收尾 --- 那一行
 24757	    out[0] = out[end] = "other"
 24758	    cur = "other"
 24759	    for i in range(1, end):
 24760	        ln = lines[i]
 24761	        m = TOP_KEY_RE.match(ln)
 24762	        if m:
 24763	            k = m.group(1)
 24764	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 24765	            out[i] = "other"
 24766	            continue
 24767	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 24768	    return out
 24769	
 24770	
 24771	def _notelines_parse_added(raw):
 24772	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 24773	    out, path, n = {}, None, 0
 24774	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 24775	        if ln.startswith("+++ "):
 24776	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 24777	            path = nfc(p[2:]) if p.startswith("b/") else None
 24778	            continue
 24779	        if ln.startswith("@@"):
 24780	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 24781	            n = int(m.group(1)) if m else 0
 24782	            continue
 24783	        if path is None or ln.startswith("---"):
 24784	            continue
 24785	        if ln.startswith("+"):
 24786	            out.setdefault(path, []).append((n, ln[1:]))
 24787	            n += 1
 24788	    return out
 24789	
 24790	
 24791	def _ns_git(repo_root, *args):
 24792	    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
 24793	    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
 24794	    r = _lens_git(repo_root, *args, quote=True, binary=True)
 24795	    if r is None or r.returncode != 0:
 24796	        return None
 24797	    return r.stdout
 24798	
 24799	
 24800	def _ns_diff(repo_root, *args):
 24801	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 24802	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
 24803	
 24804	
 24805	def _ns_mainline_refs(repo_root):
 24806	    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
 24807	    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
 24808	    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
 24809	    ml = _mainline_ref(repo_root, remote_only=True)
 24810	    return [ml[1]] if ml else []
 24811	
 24812	
 24813	def _ns_exclusions(repo_root, tip):
 24814	    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
 24815	    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
 24816	    out = []
 24817	    for ref in _ns_mainline_refs(repo_root):
 24818	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
 24819	        if r is not None and r.returncode == 1:
 24820	            out.append(ref)
 24821	    return out
 24822	
