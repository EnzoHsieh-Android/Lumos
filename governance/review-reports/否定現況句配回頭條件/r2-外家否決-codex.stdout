 26719	def _issue_close_revisits(env, rel, new_status):
 26720	    """lumos set <Issue> status <結案值>、drift fix --kind c2 --close 之後:列出這篇★全部★回頭條件(不只到期的),
 26721	    提示結案了要改成結案說明或刪掉。只印、不擋、不改;行號用寫完之後從磁碟重讀的內容算(存量漂移改法 [S7])。"""
 26722	    n = env.notes.get(rel)
 26723	    if _drift_str(n, "type") != "issue" or str(new_status).strip() not in _ISSUE_CLOSED_STATUSES:
 26724	        return
 26725	    try:
 26726	        text = _phys_path(env.vault, rel).read_text(encoding="utf-8-sig")
 26727	    except (OSError, UnicodeDecodeError):
 26728	        return
 26729	    rows = _revisit_lines(text)
 26730	    if not rows:
 26731	        return
 26732	    print(f"這篇 Issue 結案了,還留著 {len(rows)} 行回頭條件——要改成結案說明或刪掉(只列出、不擋):")
 26733	    for no, _k, _d, _s, raw in rows:
 26734	        print(f"  · {_esc_clean(rel, 200)}:{no}  {_esc_clean(raw.strip(), 100)}")
 26735	
