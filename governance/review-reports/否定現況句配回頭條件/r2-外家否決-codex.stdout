 27391	def _drift_probe_judge(now_of, was_of, pr, old):
 27392	    """一條候選 → 要處理的原因字串 / ""(不列) / None(判不了)。終點成立,而起點沒有同一條或同一條還不成立 → 要處理。
 27393	    now_of / was_of:條件 → 終點 / 起點的判定(起點只在有同一條時才問)。"""
 27394	    conds = tuple(pr["conds"])
 27395	    now = now_of(conds)
 27396	    if now is None:
 27397	        return None
 27398	    if not now:
 27399	        return ""
 27400	    if old:
 27401	        was = was_of(conds)
 27402	        if was is None:
 27403	            return None
 27404	        if was:
 27405	            return ""
 27406	    return (("這次推送讓條件成立了" if old else "這次新寫(或改了條件)的回頭條件,條件已經成立")
 27407	            + (f";期限 {pr['by']}" if pr["by"] else ""))
 27408	
 27409	
 27410	def _drift_probe_path_warn(k, v, tree):
 27411	    """symbol/test 的路徑那段在樹上找不到、而且不像檔案路徑(沒有 / 也沒有字母開頭的副檔名)→ 問題說明;否則 None。
 27412	    `[when-symbol:Config::load]` 照文法從最後一個 :: 切成「路徑 Config、名稱 load」,永遠不成立(代碼審 r1 正確性席)。
 27413	    還沒建的檔(src/new.py::main)是正常的等待狀態,不列。副檔名要字母開頭:v1.2 這種版本號不算(代碼審 r2 邊界席);
 27414	    Makefile 這種沒副檔名的根目錄檔分不出來,提示裡講明「還沒建的根目錄檔就不用管」。"""
 27415	    if k not in ("symbol", "test") or "::" not in v or tree is None:
 27416	        return None
 27417	    path = v.rsplit("::", 1)[0].strip()
 27418	    if path in tree.files or "/" in path or _drift_looks_like_ext(path.rpartition(".")[2] if "." in path else ""):
 27419	        return None
 27420	    return (f"when-{k} 的路徑 {path} 在樹上找不到、也不像檔案路徑(寫成 型別::方法 了?名稱只寫方法名,或寫完整路徑::名稱;"
 27421	            "如果是還沒建的根目錄檔,像 Makefile,建了就會判,不用管)")
 27422	
 27423	
 27424	def _drift_looks_like_ext(ext):
 27425	    """像不像副檔名:字母開頭、只有字母數字與 _ + -,而且全小寫或全大寫(.py、.c++、.R、.SWIFT)。
 27426	    大小寫混著的(app.Config 的 Config)是限定名、數字開頭的(v1.2 的 2)是版本號(代碼審 r2、r3 邊界席;
 27427	    r3 外家席:原本只收 ASCII 英數,.c++ 被誤列)。"""
 27428	    return bool(ext) and ext[0].isalpha() and all(ch.isalnum() or ch in "_+-" for ch in ext) \
 27429	        and (ext == ext.lower() or ext == ext.upper())
 27430	
 27431	
 27432	def _drift_probe_row_problems(pr, nenv, tree):
 27433	    """一行條件式的寫法問題 → [原因]:寫錯的條件、沒帶期限、指到的筆記找不到、file 指到資料夾、symbol/test 的路徑不像檔案路徑。"""
 27434	    bad = list(pr["errs"])
 27435	    if pr["by"] is None and "沒有條件標記" not in bad:
 27436	        bad.append("沒帶期限 [by:YYYY-MM-DD]")
 27437	    if pr["bad"]:
 27438	        return bad      # 條件本身寫錯:錯誤已在 errs 裡,不再拿寫錯的值算別的提示
 27439	    for k, v in pr["conds"]:
 27440	        if k == "status" and nenv.resolve(link_target(v.partition("=")[0].strip())) is None:
 27441	            bad.append(f"when-status 指的筆記 {v.partition('=')[0].strip()} 找不到(改名或刪了?)")
 27442	        if k == "file" and tree is not None and v not in tree.files \
 27443	                and any(f.startswith(v.rstrip("/") + "/") for f in tree.files):
 27444	            bad.append(f"when-file 指到資料夾 {v}(要指一支檔)")
 27445	        w = _drift_probe_path_warn(k, v, tree)
 27446	        if w:
 27447	            bad.append(w)
 27448	    return bad
 27449	
 27450	
 27451	def _drift_probe_scan(nenv, tree, deadline=None):
 27452	    """scan 的乙部分 → (成立的行[發現], 問題[(路徑, 行號, 原文, 原因)])。問題:寫錯的條件、沒帶期限、指到的筆記找不到、
 27453	    file 指到資料夾、symbol/test 的路徑不像檔案路徑、寫在不評估的地方、判不了(分 git 讀不出與超過預算)。"""
 27454	    import time as _t
 27455	
 27456	    def _over():
 27457	        return deadline is not None and _t.monotonic() >= deadline
 27458	    found, probs, per = [], [], []
 27459	    for p in sorted(nenv.notes):
 27460	        rows, dead = _probe_lines(env_text(nenv, p) or "")
 27461	        probs += [(p, no, tx, why) for no, tx, why in dead]
 27462	        per.append((p, rows))
 27463	    if not _over():
 27464	        _drift_probe_prefetch([c for _p, rows in per for _n, _t, pr in rows for c in pr["conds"]], [tree])
 27465	    for p, rows in per:
 27466	        for no, tx, pr in rows:
 27467	            probs += [(p, no, tx, why) for why in _drift_probe_row_problems(pr, nenv, tree)]
 27468	            if not pr["conds"] or pr["bad"]:
 27469	                continue
 27470	            ok = None if _over() else _drift_probe_line(tree, nenv, tuple(pr["conds"]))
 27471	            if ok is None:
 27472	                probs.append((p, no, tx, "判不了(超過預算)" if _over() else
 27473	                              "判不了(git 讀不出程式檔或筆記" + _drift_bad_note(_drift_row_unread(pr["conds"], (nenv,), (tree,))) + ")"))
 27474	            elif ok:
 27475	                found.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [],
 27476	                              "why": "條件已經成立,該處理了" + (f"(期限 {pr['by']})" if pr["by"] else "")})
 27477	    return found, probs
 27478	
