 27375	def _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base):
 27376	    """推送判定要的起點資料 → (範圍改動, 起點圖譜, 判不了的原因或 None)。起點的圖譜位置與樹清單都走 _drift_list 的記憶。"""
 27377	    import time as _t
 27378	    ch = _drift_probe_changes(root, base, tip, deadline)
 27379	    if ch is None:
 27380	        return None, None, "git 算不出這次推送改了哪些檔(條件式回頭條件)"
 27381	    if not base:
 27382	        return ch, None, None
 27383	    if deadline is not None and _t.monotonic() >= deadline:
 27384	        return None, None, "預算用完"
 27385	    benv = _drift_tree_env(root, base, _drift_vault_rel(root, base) or vault_rel, override_base, deadline=deadline)
 27386	    if benv is None:
 27387	        return None, None, "git 讀不出起點的筆記(條件式回頭條件)"
 27388	    return ch, benv, None
 27389	
