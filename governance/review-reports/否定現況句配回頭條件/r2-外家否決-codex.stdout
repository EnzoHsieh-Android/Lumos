 25450	        return 0
 25451	    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel)
 25452	    if res is None:
 25453	        print("筆記形狀擋:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
 25454	        return 0
 25455	    viol, errs = res
 25456	    if not viol and not errs:
 25457	        return 0
 25458	    head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
 25459	    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
 25460	    for e in errs:
 25461	        print(f"  {e}", file=sys.stderr)
 25462	    for p, n, rule, frag, fix in viol:
 25463	        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
 25464	    if mode == "block":
 25465	        print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
 25466	              "推得出來的一寫進去就會過期——見 Projects/筆記形狀擋_計劃。", file=sys.stderr)
 25467	        _gate_event_or_warn(root, "note-shape", "blocked", f"{mode_word}:新違規 {len(viol) + len(errs)} 條",
 25468	                            hard=True, nodes=sorted({v[0] for v in viol} | {e.split(':', 1)[0] for e in errs})[:50])
 25469	        return 1
 25470	    # warn 模式有違規也記一筆(照鄰居的 warned;沒違規的放行才不寫——代碼審 r1 架構對齊席)
 25471	    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
 25472	                        nodes=sorted({v[0] for v in viol})[:50])
 25473	    return 0
