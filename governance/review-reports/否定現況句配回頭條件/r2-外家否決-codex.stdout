    56	def _rx(words):
    57	    parts = []
    58	    for w in sorted(set(words), key=len, reverse=True):
    59	        e = re.escape(w)
    60	        parts.append(r"(?<![A-Za-z0-9_-])" + e + r"(?![A-Za-z0-9_-])" if w.isascii() else e)
    61	    return re.compile("|".join(parts), re.I)
