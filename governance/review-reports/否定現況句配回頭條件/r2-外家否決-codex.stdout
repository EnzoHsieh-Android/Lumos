 26669	# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
 26670	# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
 26671	#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
 26672	# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
 26673	_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
 26674	_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
 26675	_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
 26676	_PROBE_KEYS = ("file", "symbol", "test", "status")
 26677	_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")
 26678	
 26679	
 26680	def _revisit_split(line):
 26681	    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
 26682	    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
 26683	    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
 26684	    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
 26685	    import datetime
 26686	    if line.lstrip().startswith("|"):
 26687	        return None, None
 26688	    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
 26689	    if not s.startswith("REVISIT:"):
 26690	        return None, None
 26691	    rest = s[len("REVISIT:"):]
 26692	    if rest.lstrip().startswith("[when-"):
 26693	        return "cond", rest
 26694	    try:
 26695	        datetime.date.fromisoformat(rest.partition(" ")[0])
 26696	        return "date", rest
 26697	    except ValueError:
 26698	        return "bad", rest
 26699	
 26700	
 26701	def _revisit_lines(text):
 26702	    """一篇筆記的每一條回頭條件 → [(行號, 種類, 日期或 None, 摘要, 原文)];種類 date/cond/bad(同 _revisit_split)。
 26703	    剝程式碼區(_search_visible_lines)、餵剝過行內程式碼的那一版給 _revisit_split。doctor E5 與 set 把 Issue 結案時的列出
 26704	    共用這一支(存量漂移改法 第 6 節);乙的 _probe_lines、第一層、第二層各自的逐行迴圈不在這裡。"""
 26705	    out = []
 26706	    for no, raw, _pr in _search_visible_lines(text.split("\n"), False):
 26707	        kind, rest = _revisit_split(_strip_inline_markup(raw)[0])
 26708	        if kind is None:
 26709	            continue
 26710	        date, summ = None, ""
 26711	        if kind == "cond":
 26712	            date, summ = _probe_parse(rest)["by"], _PROBE_LEAD_RE.sub("", rest)
 26713	        elif kind == "date":
 26714	            date, _sp, summ = rest.partition(" ")
 26715	        out.append((no, kind, date, summ.strip(), raw))
 26716	    return out
 26717	
