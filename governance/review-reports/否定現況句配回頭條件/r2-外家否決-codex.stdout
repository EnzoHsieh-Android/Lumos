 25172	def _ns_revisit_violations(ln, reg, visible):
 25173	    """新寫的一行回頭條件或條件標記合不合規矩(存量漂移防線 [S10])→ [(規則, 片段, 改法)]。
 25174	    用跟 E5、第二層同一支 _revisit_split;圍欄裡的、行內程式碼裡的是範例,不管。"""
 25175	    if not visible:
 25176	        return []
 25177	    probe = _strip_inline_markup(ln)[0]
 25178	    table = probe.lstrip().startswith("|")
 25179	    if reg in ("body", "summary") and not table:
 25180	        kind, rest = _revisit_split(probe)
 25181	        if kind == "bad":
 25182	            return [("回頭條件格式不合", ln.strip()[:60],
 25183	                     "REVISIT: 後面第一個位置要是日期 YYYY-MM-DD,或條件標記加期限:REVISIT:[when-file:路徑][by:YYYY-MM-DD] 待辦")]
 25184	        if kind == "cond":
 25185	            pr = _probe_parse(rest)
 25186	            errs = list(pr["errs"])
 25187	            if pr["conds"] and pr["by"] is None:
 25188	                errs.append("沒帶期限 [by:YYYY-MM-DD](條件寫錯就永遠不會成立,期限到了至少會被唸)")
 25189	            if errs:
 25190	                return [("條件寫錯", ln.strip()[:60], ";".join(errs) + "——文法見 Projects/存量漂移防線_計劃〈做法〉第 0 節")]
 25191	        return []
 25192	    if _PROBE_ANY_RE.search(probe):
 25193	        return [("條件寫在不評估的地方", ln.strip()[:60],
 25194	                 "條件標記只在正文與摘要的 REVISIT 行生效;寫在表格或開頭欄位其他欄裡不會被判,移到 REVISIT 行")]
 25195	    return []
 25196	
 25197	
 25198	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 25199	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 25200	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 25201	    if ch is None:
 25202	        return []
 25203	    lst_t = _nodehome_list(repo_root, tip_where)
 25204	    lst_b = _nodehome_list(repo_root, base_where)
 25205	    if lst_t is None or lst_b is None:
 25206	        return []
 25207	    reader_b = _nodehome_reader(repo_root, base_where)
 25208	    out = []
 25209	    for code, _old, new in ch:
 25210	        if not new or code == "D":
 25211	            continue
 25212	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 25213	            continue
 25214	        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
 25215	        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
 25216	            out.append(new)
 25217	    return out
 25218	
 25219	
 25220	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
 25221	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 25222	    reader = _nodehome_reader(repo_root, tip_where)
 25223	    lst = _nodehome_list(repo_root, tip_where)
 25224	    if lst is None:
 25225	        return None
 25226	    files = lst[0]
 25227	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 25228	    _names, _name_cache = {}, {}
 25229	    for p in files:
 25230	        if _nodehome_code_kind(p) is not None:
 25231	            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 25232	
 25233	    def by_name(name):
 25234	        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
 25235	        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
 25236	        if name not in _name_cache:
 25237	            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
 25238	        return _name_cache[name]
 25239	    viol = []
 25240	    # 1) 這次新增的行(跟筆記內容審共用同一支,Projects/筆記內容審_計劃 [S1])
 25241	    mk = mark or _NOTE_SHAPE_GOLIVE_MARK
 25242	    res = _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, reader=reader, mark=mk,
 25243	                         exclude_remote=exclude_remote, max_count=max_count, keep_other=True)
 25244	    if res is None:
 25245	        return None
 25246	    notes, errs, old_by = res
 25247	    for p, text, rows in notes:
 25248	        regen = _ns_is_regen(text)
 25249	        vis = {no for no, _l in _visible_lines(text.split("\n"))}
 25250	        for i, ln, reg in rows:
 25251	            if reg != "other":
 25252	                for rule, frag, fix in _ns_check_line(repo_root, ln, reg, files, reader, top_dirs, by_name, regen):
 25253	                    viol.append((p, i, rule, frag, fix))
 25254	            for rule, frag, fix in _ns_revisit_violations(ln, reg, i in vis):
 25255	                viol.append((p, i, rule, frag, fix))
 25256	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 25257	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 25258	                             tip_where, reader)
 25259	    if became:
 25260	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 25261	        if gl is not None:
 25262	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 25263	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 25264	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 25265	            spec = "" if tip_where == "index" else tip_where
 25266	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 25267	            gl_reader = _nodehome_reader(repo_root, gl)
 25268	            seen = {(v[0], v[1]) for v in viol}
 25269	            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
 25270	            for p, blob in zip(notes_, blobs):
 25271	                if blob is None:
 25272	                    continue
 25273	                text = blob.decode("utf-8-sig", errors="replace")
 25274	                if not any(x in text for x in keys):
 25275	                    continue
 25276	                old, regs_, regen_ = None, _notelines_regions(text), _ns_is_regen(text)
 25277	                for n, ln in enumerate(text.split("\n"), 1):
 25278	                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
 25279	                        continue
 25280	                    if old is None:
 25281	                        ob = gl_reader(p)
 25282	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 25283	                    if ln.strip() in old or ln.strip() in old_by.get(nfc(p), ()):
 25284	                        continue
 25285	                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
 25286	                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
 25287	                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
 25288	                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
 25289	                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
 25290	                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
 25291	                                                             for x in became):
 25292	                            continue
 25293	                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
 25294	                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
 25295	    return viol, errs
 25296	
