 26737	def _probe_value_err(k, v):
 26738	    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
 26739	    if k not in _PROBE_KEYS:
 26740	        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
 26741	    if not v:
 26742	        return f"when-{k} 的值是空的"
 26743	
 26744	    if k == "file":
 26745	        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
 26746	    if k in ("symbol", "test"):
 26747	        return _probe_named_err(k, v)
 26748	    node, eq, vals = v.partition("=")
 26749	    if not eq or not node.strip() or not vals.strip():
 26750	        return "when-status 要寫成 <節點>=<值>"
 26751	    if any(not x.strip() for x in vals.split("|")):
 26752	        return "when-status 的值用 | 分開時每一段都不能空"
 26753	    return None
 26754	
 26755	
 26756	def _probe_norm_value(k, v):
 26757	    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
 26758	    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
 26759	    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
 26760	    if k == "file":
 26761	        return nfc(_posix_norm(v))
 26762	    if k in ("symbol", "test") and "::" in v:
 26763	        path, name = v.rsplit("::", 1)
 26764	        return nfc(_posix_norm(path)) + "::" + name.strip()
 26765	    return v
 26766	
 26767	
 26768	def _probe_bad_path(p):
 26769	    return (not p) or p == "." or p.startswith("/") or ".." in p.split("/")
 26770	
 26771	
 26772	def _probe_named_err(k, v):
 26773	    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
 26774	    if "::" not in v:
 26775	        return None
 26776	    path, name = v.rsplit("::", 1)
 26777	    if not name.strip():
 26778	        return f"when-{k} 的名稱是空的"
 26779	    if _probe_bad_path(path.strip()):
 26780	        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
 26781	    return None
 26782	
 26783	
 26784	def _probe_parse(rest):
 26785	    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
 26786	    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
 26787	    import datetime
 26788	    conds, by, errs, pos, bad = [], None, [], 0, False
 26789	    while True:
 26790	        m = _PROBE_TOKEN_RE.match(rest, pos)
 26791	        if not m:
 26792	            break
 26793	        pos = m.end()
 26794	        key, val = m.group(1), m.group(2).strip()
 26795	        if key == "by":
 26796	            if by is not None:
 26797	                errs.append("期限寫了兩個")
 26798	                continue
 26799	            try:
 26800	                datetime.date.fromisoformat(val)
 26801	                by = val
 26802	            except ValueError:
 26803	                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
 26804	            continue
 26805	        k = key[len("when-"):]
 26806	        # 反斜線先轉斜線再驗(代碼審 r3 正確性席:`a\..\x.py` 原本收成 x.py 過關,字面相同的 `a/../x.py` 卻被擋)
 26807	        err = _probe_value_err(k, val.replace("\\", "/") if k in ("file", "symbol", "test") else val)
 26808	        nv = val if err else _probe_norm_value(k, val)
 26809	        # 正規化之後再驗一次(代碼審 r2 正確性席、邊界席:`..\x.py` 原文用 / 切不出 .. 段,轉成斜線才是 ../x.py,
 26810	        # 原本第一層放行、check 與 scan 又默默丟掉,變成沒人看得到的死條件)
 26811	        err = err or _probe_value_err(k, nv)
 26812	        if err:
 26813	            errs.append(err)
 26814	            bad = True
 26815	        conds.append((k, val if err else nv))
 26816	    if not conds:
 26817	        errs.append("沒有條件標記")
 26818	    # bad:有條件寫錯——check 與 scan 看這個旗標決定評不評估,不拿存下來的值重驗(代碼審 r3 正確性席:寫錯的條件存的是
 26819	    # 原文,原文重驗可能過關,寫錯的行照樣被評估);只缺期限不算 bad,照評估
 26820	    return {"conds": conds, "by": by, "errs": errs, "bad": bad}
 27160	            if path not in self.files:
 27161	                return False
 27162	            if not self._read([path]) or self._text[path] is None:
 27163	                return None
 27164	            return self._defines(path, name, test)
 27165	        items = self.corpus(test)
 27166	        if items is None:
 27167	            return None
 27168	        if any(self._defines(p, name, test) for p in items):
 27169	            return True
 27170	        return None if self._unread[test] else False
 27171	
