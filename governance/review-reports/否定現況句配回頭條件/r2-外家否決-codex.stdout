 27173	def _drift_probe_tree(root, where, deadline=None):
 27174	    """→ _DriftProbeTree 或 None(git 列不出路徑、不是 git 專案、或預算已用完)。where:完整提交編號或 'disk'。"""
 27175	    import time as _t
 27176	    if deadline is not None and _t.monotonic() >= deadline:
 27177	        return None
 27178	    lst = _drift_disk_list(root) if where == "disk" else _drift_list(root, where)
 27179	    if lst is None:
 27180	        return None
 27181	    return _DriftProbeTree(root, where, set(lst[0]), _nodehome_layout(lst[1]), deadline)
 27182	
 27183	
 27184	def _drift_probe_one(tree, env, k, v):
 27185	    """一個條件 → True / False / None(判不了)。status 只看筆記(env),不需要 git——不是 git 專案也判得了
 27186	    (代碼審 r1 正確性席);指到的筆記讀不出來算判不了(外家席:原本當成不成立,靜默放行)。"""
 27187	    if k == "status":
 27188	        _rel, n, want = _drift_status_target(env, v)
 27189	        if n is not None and _note_unreadable(n):
 27190	            return None
 27191	        return n is not None and _drift_str(n, "status") in want
 27192	    return None if tree is None else tree.one(k, v)
 27193	
 27194	
 27195	def _drift_probe_line(tree, env, conds):
 27196	    """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
 27197	    vals = [_drift_probe_one(tree, env, k, v) for k, v in conds]
 27198	    if any(x is False for x in vals):
 27199	        return False
 27200	    return None if any(x is None for x in vals) else True
 27201	
