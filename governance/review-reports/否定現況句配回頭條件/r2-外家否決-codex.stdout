 27339	def _drift_row_unread(conds, envs, trees):
 27340	    """這一行的條件實際碰到、而且讀不出來的檔或筆記(r4 正確性席:原本點名整棵樹讀不出的全部檔,
 27341	    status 判不了的行反而點名一支無關的程式檔)。帶路徑的 symbol/test 看那一支;不帶路徑的看讀不出的程式檔;
 27342	    status 看指到的那篇筆記。"""
 27343	    out = set()
 27344	    for k, v in conds:
 27345	        if k == "status":
 27346	            for env in envs:
 27347	                rel, n, _want = _drift_status_target(env, v)
 27348	                if n is not None and _note_unreadable(n):
 27349	                    out.add(rel)
 27350	        elif k in ("symbol", "test"):
 27351	            for t in trees:
 27352	                if t is not None:
 27353	                    out.update(t.unread_for(k, v))
 27354	    return sorted(out)
 27355	
 27356	
 27357	def _drift_bad_note(paths):
 27358	    """判不了時點名讀不出來的檔(代碼審 r3 正確性席:原本只說讀不出,推的人找不到是哪支)。
 27359	    路徑來自被推送的內容,印之前把控制字元換成空格(r4 資安席;借逃逸帳的 _esc_clean)。"""
 27360	    bad = [_esc_clean(q) for q in paths]
 27361	    return (":" + "、".join(bad[:5]) + (f" 等 {len(bad)} 支" if len(bad) > 5 else "")) if bad else ""
 27362	
 27363	
 27364	def _drift_probe_old(p, pr, renames, benv, pre, cache):
 27365	    """起點有沒有「同一條」:終點路徑照改名對回起點,再比條件標記 → True/False;沒有起點回 None。cache 存每篇起點的標記集合。"""
 27366	    if benv is None:
 27367	        return None
 27368	    bp = renames.get(pre + p, pre + p)
 27369	    bp = bp[len(pre):] if bp.startswith(pre) else p
 27370	    if bp not in cache:
 27371	        cache[bp] = {tuple(x[2]["conds"]) for x in _probe_lines(env_text(benv, bp) or "")[0]}
 27372	    return tuple(pr["conds"]) in cache[bp]
 27373	
