 27024	    if key not in _DRIFT_EMPTY_TREE:
 27025	        try:    # 明確餵空輸入:在推送掛鉤裡繼承標準輸入會去讀掛鉤自己的 ref 清單
 27026	            r = _sp.run(["git", "-C", key, "hash-object", "-t", "tree", "--stdin"], input=b"", capture_output=True, timeout=20)
 27027	            got = r.stdout.decode("ascii", "replace").strip() if r.returncode == 0 else ""
 27028	        except (OSError, _sp.TimeoutExpired):
 27029	            got = ""
 27030	        _DRIFT_EMPTY_TREE[key] = got if _LENS_SHA_RE.fullmatch(got) else _EMPTY_TREE_SHA
 27031	    return _DRIFT_EMPTY_TREE[key]
 27032	
 27033	
 27034	class _DriftNames:
 27035	    """幾支檔全文的識別字集合(用 \\w+ 切),名稱查集合;不是一般識別字的名稱才對原文跑正則。
 27036	    逐支檔建集合,不先把全文接成一大段(r4 併發席:接起來再整批切,尖峰記憶體是文字的 10 倍以上)。
 27037	    partial:有檔讀不出——這時「找到」照算,「找不到」要當判不了(r4 外家席:原本有一支讀不出就整份作廢,
 27038	    另一支已經確定命中的也被降成判不了)。"""
 27039	
 27040	    def __init__(self, texts, partial=False):
 27041	        self.texts, self.partial, self._set, self._text = texts, partial, set(), None
 27042	        for t in texts:
 27043	            self._set.update(re.findall(r"\w+", t))
 27044	
 27045	    def has(self, name):
 27046	        """名稱出不出現在全文(整字)。一般識別字查集合;帶標點的(foo-bar)先看它的每個字詞都在集合裡,
 27047	        都在才對全文跑一次正則,全文也只接一次(代碼審 r5 外家席:原本每條都接全文再掃,幾百條就耗光預算)。"""
 27048	        if re.fullmatch(r"\w+", name):
 27049	            return name in self._set
 27050	        parts = re.findall(r"\w+", name)
 27051	        if parts and any(x not in self._set for x in parts):
 27052	            return False
 27053	        if self._text is None:
 27054	            self._text = "\n".join(self.texts)
 27055	        return bool(re.search(rf"(?<![\w]){re.escape(name)}(?![\w])", self._text))
 27056	
 27057	
 27058	class _DriftProbeTree:
 27059	    """某一版(提交的樹,或工作目錄 'disk')上判 file/symbol/test 條件用的快照,只由 _drift_probe_tree 在列得出路徑時建
 27060	    (讀不到就不建,跟 _nodehome_side 同一種失敗編碼;代碼審 r1 架構對齊席)。檔案內容用到才讀、讀過記住;
 27061	    帶路徑的條件只讀那一支,而且一批先讀完(prefetch;代碼審 r1、r2 併發席:原本先是整批讀全庫,後來一支檔開一次 git)。
 27062	    樹上有、讀不出來的檔記成 None,碰到它的條件算判不了,不算不成立(代碼審 r2 外家席)。status 不在這裡判。"""
 27063	
 27064	    def __init__(self, root, where, files, layout, deadline=None):
 27065	        import time as _t
 27066	        self.root, self.where, self.files, self.layout, self.deadline, self._t = root, where, files, layout, deadline, _t
 27067	        self._text, self._corpus, self._py, self._unread, self._names = {}, {}, {}, {}, {}
 27068	
 27069	    def _over(self):
 27070	        return self.deadline is not None and self._t.monotonic() >= self.deadline
 27071	
 27072	    def _read(self, paths):
 27073	        """把還沒讀過的讀進來;讀不了(git 失敗、預算用完)回 False。讀出來是 None 的(樹上有、內容讀不出)記成 None。
 27074	        工作目錄模式也每支檔前看預算(代碼審 r2 併發席:原本只有讀 git 那條看,scan 預設走的這條不看)。"""
 27075	        todo = [p for p in paths if p not in self._text]
 27076	        if not todo:
 27077	            return True
 27078	        if self._over():
 27079	            return False
 27080	        if self.where == "disk":
 27081	            for p in todo:
 27082	                if self._over():
 27083	                    return False
 27084	                try:
 27085	                    self._text[p] = _drift_decode((Path(self.root) / p).read_bytes())
 27086	                except OSError:
 27087	                    self._text[p] = None
 27088	            return True
 27089	        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
 27090	        blobs = _drift_cat(self.root, self.where, todo, left)
 27091	        if blobs is None:
 27092	            return False
 27093	        for p, b in zip(todo, blobs):
 27094	            self._text[p] = None if b is None else _drift_decode(b)
 27095	        return True
 27096	
 27097	    def prefetch(self, conds):
 27098	        """帶路徑的 symbol/test 條件指到的檔,一個行程讀完;讀不了不管,輪到那條時再判。"""
 27099	        paths = {_drift_cond_split(v)[0] for k, v in conds if k in ("symbol", "test")} - {""}
 27100	        self._read(sorted(p for p in paths if p in self.files))
 27101	
 27102	    def names_in(self, paths, test):
 27103	        """樹上有的那幾支裡、屬於這一類(test=True 測試檔,False 一般程式檔)的全文 → _DriftNames;讀不了(預算、git)
 27104	        回 None;有幾支讀不出時用讀得出的建、標 partial。同一組只算一次。分兩類是因為 symbol 條件只看程式檔、test 只看
 27105	        測試檔(代碼審 r5 正確性席、外家席:原本混在一起,讀不出一支測試檔就讓 symbol 條件判不了)。"""
 27106	        key = tuple(sorted(p for p in paths if p in self.files and _nodehome_is_test(p, self.layout) == test))
 27107	        if key not in self._names:
 27108	            if not self._read(list(key)):
 27109	                return None
 27110	            texts = [self._text[p] for p in key if self._text[p] is not None]
 27111	            self._names[key] = _DriftNames(texts, partial=len(texts) < len(key))
 27112	        return self._names[key]
 27113	
 27114	    def bad_paths(self):
 27115	        """讀過、樹上有、內容讀不出的檔。"""
 27116	        return [p for p, t in self._text.items() if t is None]
 27117	
 27118	    def unread_for(self, k, v):
 27119	        """這一個 symbol/test 條件判定時依賴、而且讀不出來的檔:帶路徑的看那一支,不帶路徑的看同一類(程式或測試)語料。
 27120	        跟 one() 用同一支拆條件、同一個分類(代碼審 r5 架構對齊席、外家席:原本點名用整棵樹累積的讀不出清單,
 27121	        前一行讀過的測試檔會混進這一行的說明)。"""
 27122	        path, _name = _drift_cond_split(v)
 27123	        if path:
 27124	            return [path] if path in self._text and self._text[path] is None else []
 27125	        test = k == "test"
 27126	        return [p for p in self.bad_paths() if _drift_probe_code_path(p) and _nodehome_is_test(p, self.layout) == test]
 27127	
 27128	    def corpus(self, test):
 27129	        """程式檔(test=False)或測試檔的路徑清單;讀不了回 None。沒副檔名的要開頭是 #! 才算(跟每支檔有家共用
 27130	        _head_is_shebang;代碼審 r2 架構對齊席)。讀不出來的檔記在 _unread,沒找到定義時整條算判不了。"""
 27131	        if test not in self._corpus:
 27132	            paths = sorted(p for p in self.files if _drift_probe_code_path(p) and _nodehome_is_test(p, self.layout) == test)
 27133	            if not self._read(paths):
 27134	                return None
 27135	            self._corpus[test] = [p for p in paths if self._text[p] is not None and (
 27136	                _nodehome_code_kind(p) == "ext" or _head_is_shebang(self._text[p][:200].encode("utf-8")))]
 27137	            self._unread[test] = any(self._text[p] is None for p in paths)
 27138	        return self._corpus[test]
 27139	
 27140	    def _defines(self, p, name, test):
 27141	        txt = self._text.get(p)
 27142	        if txt is None or not re.search(rf"(?<![\w]){re.escape(name)}(?![\w])", txt):
 27143	            return False
 27144	        if not _drift_probe_is_py(p, txt):
 27145	            return True
 27146	        if p not in self._py:
 27147	            self._py[p] = _drift_py_names(txt)
 27148	        names = self._py[p]
 27149	        if names is None:
 27150	            return bool(_drift_py_def_re(name, test).search(txt))
 27151	        return name in names[0] or (not test and (name in names[1] or name in names[2]))
 27152	
 27153	    def one(self, k, v):
 27154	        """file/symbol/test 一個條件 → True / False / None(判不了)。"""
 27155	        if k == "file":
 27156	            return v in self.files
 27157	        test = k == "test"
 27158	        path, name = _drift_cond_split(v)
 27159	        if path:
 27160	            if path not in self.files:
 27161	                return False
 27162	            if not self._read([path]) or self._text[path] is None:
 27163	                return None
 27164	            return self._defines(path, name, test)
 27165	        items = self.corpus(test)
 27166	        if items is None:
 27167	            return None
 27168	        if any(self._defines(p, name, test) for p in items):
 27169	            return True
 27170	        return None if self._unread[test] else False
 27171	
 27172	
 27173	def _drift_probe_tree(root, where, deadline=None):
 27174	    """→ _DriftProbeTree 或 None(git 列不出路徑、不是 git 專案、或預算已用完)。where:完整提交編號或 'disk'。"""
 27175	    import time as _t
 27176	    if deadline is not None and _t.monotonic() >= deadline:
 27177	        return None
 27178	    lst = _drift_disk_list(root) if where == "disk" else _drift_list(root, where)
 27179	    if lst is None:
 27180	        return None
 27181	    return _DriftProbeTree(root, where, set(lst[0]), _nodehome_layout(lst[1]), deadline)
 27182	
 27183	
 27184	def _drift_probe_one(tree, env, k, v):
 27185	    """一個條件 → True / False / None(判不了)。status 只看筆記(env),不需要 git——不是 git 專案也判得了
 27186	    (代碼審 r1 正確性席);指到的筆記讀不出來算判不了(外家席:原本當成不成立,靜默放行)。"""
 27187	    if k == "status":
 27188	        _rel, n, want = _drift_status_target(env, v)
 27189	        if n is not None and _note_unreadable(n):
 27190	            return None
 27191	        return n is not None and _drift_str(n, "status") in want
 27192	    return None if tree is None else tree.one(k, v)
 27193	
 27194	
 27195	def _drift_probe_line(tree, env, conds):
 27196	    """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
 27197	    vals = [_drift_probe_one(tree, env, k, v) for k, v in conds]
 27198	    if any(x is False for x in vals):
 27199	        return False
 27200	    return None if any(x is None for x in vals) else True
 27201	
 27202	
 27203	def _drift_probe_changes(root, base, tip, deadline=None):
 27204	    """範圍裡的改動(只算一次 name-status)→ {touched: 改到的路徑(改名兩端都算), renames: 改名 新→舊,
 27205	    code_touched: 改到的程式與測試檔, code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗或預算用完回 None。
 27206	    解析用共用的 _nodehome_name_status(代碼審 r1 架構對齊席:原本手刻第二份);筆記改名也從這一次拿(圖譜一致席:
 27207	    原本另起一次 git)。不帶路徑的條件改看 code_touched 在終點的全文(_drift_probe_is_candidate),不再算新增行。"""
 27208	    import time as _t
 27209	    if deadline is not None and _t.monotonic() >= deadline:
 27210	        return None
 27211	    raw = _ns_git(root, "diff", "--name-status", "-z", "-M", base or _drift_empty_tree(root), tip)
 27212	    if raw is None:
 27213	        return None
 27214	    codes = {}
 27215	    touched, renames, _gone = _nodehome_name_status(raw, codes=codes)
 27216	    shape = any(c in ("A", "D", "R", "C") and _drift_probe_code_path(p) for p, c in codes.items())
 27217	    return {"touched": touched, "renames": renames, "code_shape": shape,
 27218	            "code_touched": sorted(p for p in touched if _drift_probe_code_path(p))}
 27219	
