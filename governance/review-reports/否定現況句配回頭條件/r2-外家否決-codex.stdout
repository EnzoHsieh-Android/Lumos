   367	    sys.path.insert(0, str(TC_ROOT / "governance" / "eval" / "drift-exam" / "old-sentence"))
   368	    import old_sentence_exp as exp    # 同一組提交:067f005 以前、非合併、動到 .py
   369	    ctx = exp.Ctx(a.rtb, exp.RTB_VAULT)
