   376	def load_hits(paths):
   377	    rows, metas = [], {}
   378	    for p in paths:
   379	        for ln in Path(p).read_text(encoding="utf-8").splitlines():
   380	            d = json.loads(ln)
   381	            if "_meta" in d:
   382	                metas[d["tag"]] = d["_meta"]
   383	            else:
   384	                rows.append(d)
   385	    return rows, metas
   386	
   387	
   388	def funnel(rows, refined=True):
   389	    """窄表命中 →(細化:扣工具預告句 → 扣引號/修飾語/條件子句)→ 扣歷史 → 扣規則句 → 扣已配 = 會被提醒。
   390	    refined=False 是第一版(只有窄表、歷史、規則、已配),留著對照。回 (各階段計數, 會被提醒的列)。"""
   391	    rows = [r for r in rows if r["narrow"] or r["broad"] or r["notlack"]]   # 只有第三版命中的列不進前兩版
   392	    st = {"broad_or_narrow": len(rows)}
   393	    cur = [r for r in rows if r["narrow"]]
   394	    st["narrow"] = len(cur)
   395	    if refined:
   396	        cur = [r for r in cur if not r["template"]]
   397	        st["minus_template"] = len(cur)
   398	        cur = [r for r in cur if r["narrow_live"]]
   399	        st["minus_quote_modifier"] = len(cur)
   400	    cur = [r for r in cur if not r["hist"]]
   401	    st["minus_hist"] = len(cur)
   402	    cur = [r for r in cur if not r["rule"]]
   403	    st["minus_rule"] = len(cur)
   404	    st["paired_cond"] = sum(r["paired"] == "cond" for r in cur)
   405	    st["paired_date"] = sum(r["paired"] == "date" for r in cur)
   406	    if refined:    # 第一版沒認行內的 REVISIT(第一次抽樣就是從那個母體抽的,照留才能重現)
   407	        st["paired_inline"] = sum(bool(r["inline_revisit"]) and not r["paired"] for r in cur)
   408	        remind = [r for r in cur if not r["paired"] and not r["inline_revisit"]]
   409	    else:
   410	        remind = [r for r in cur if not r["paired"]]
   411	    st["remind"] = len(remind)
   412	    return st, remind
   413	
   414	
   415	def funnel_v3(rows):
   416	    """第三版:窄表命中 → 扣不看的行(區塊、樣板、RETIRE-IF)→ 扣引號與修飾語 → 扣規則句與歷史句 = 會提醒。
   417	    「已配」只認那一行本身是條件式回頭條件,而 REVISIT 行本來就不看,所以沒有「扣已配」這一步。
   418	    回 (各階段計數, 會提醒的列, 修飾語或引號這步丟掉的列, 規則或歷史這步丟掉的列)。"""
   419	    cur = [r for r in rows if r.get("v3")]
   420	    st = {"narrow": len(cur)}
   421	    cur = [r for r in cur if not r.get("v3_excluded")]
   422	    st["minus_excluded"] = len(cur)
   423	    drop_mod = [r for r in cur if not r["v3"]["live"]]
   424	    cur = [r for r in cur if r["v3"]["live"]]
   425	    st["minus_quote_modifier"] = len(cur)
   426	    drop_hr = [r for r in cur if not r["v3"]["kept"]]
   427	    cur = [r for r in cur if r["v3"]["kept"]]
   428	    st["remind"] = len(cur)
   429	    return st, cur, drop_mod, drop_hr
   430	
   431	
   432	def _per_repo(rows, metas):
   433	    for tag in sorted({r["repo"] for r in rows} | set(metas)):
   434	        rs = [r for r in rows if r["repo"] == tag]
   435	        f1, _r1 = funnel(rs, refined=False)
   436	        f, remind = funnel(rs)
   437	        by_commit = Counter(r["commit"] for r in remind)
   438	        print(f"\n[{tag}] meta={metas.get(tag)}")
   439	        print("  漏斗(第一版):", json.dumps(f1, ensure_ascii=False))
   440	        print("  漏斗(細化):", json.dumps(f, ensure_ascii=False))
   441	        print(f"  有提醒的提交 {len(by_commit)};每個有提醒的提交行數 中位 "
   442	              f"{sorted(by_commit.values())[len(by_commit) // 2] if by_commit else 0} 最多 {max(by_commit.values(), default=0)}")
   443	        s3, rem3, _dm, _dh = funnel_v3(rs)
   444	        bc3 = Counter(r["commit"] for r in rem3)
   445	        v3c = sorted(bc3.values())
   480	        _label_table(rows, json.loads(Path(a.labels).read_text(encoding="utf-8")))
   481	    return 0
   482	
   483	
   484	def cmd_sample(a):
   485	    """narrow=第一版會提醒的列;refined=細化後會提醒的列(--exclude 排掉已判過的,當留出樣本);broadonly=只中寬表、沒中窄表的列。"""
   486	    rows, _m = load_hits(a.hits)
   487	    if a.pool == "narrow":
   488	        pool = funnel(rows, refined=False)[1]
   489	    elif a.pool == "refined":
   490	        pool = funnel(rows)[1]
   491	    elif a.pool == "v3":
   492	        pool = funnel_v3(rows)[1]
   493	    elif a.pool == "v3drop":
   494	        _s, _k, dm, dh = funnel_v3(rows)
   495	        pool = dm + dh
   496	    else:
   497	        pool = [r for r in rows if not r["narrow"] and r["broad"] and not r["paired"]]
   498	    if a.exclude:
   499	        seen = set(json.loads(Path(a.exclude).read_text(encoding="utf-8")))
   500	        pool = [r for r in pool if r["id"] not in seen]
   501	    rnd = random.Random(a.seed)
   502	    pick = rnd.sample(sorted(pool, key=lambda r: r["id"]), min(a.n, len(pool)))
   503	    print(f"# pool={a.pool} 母體 {len(pool)} 抽 {len(pick)} seed={a.seed}")
   504	    for r in pick:
   505	        print(json.dumps({"id": r["id"], "narrow": r["narrow"], "broad": r["broad"], "text": r["text"]}, ensure_ascii=False))
   506	    return 0
   507	
   508	
   509	def main():
   510	    ap = argparse.ArgumentParser()
   511	    sub = ap.add_subparsers(dest="cmd", required=True)
   512	    s = sub.add_parser("scan")
   513	    s.add_argument("--repo", required=True)
   514	    s.add_argument("--vault", required=True)
   515	    s.add_argument("--head", default="HEAD")
   516	    s.add_argument("--n", type=int, default=300)
   517	    s.add_argument("--commits")
   518	    s.add_argument("--tag", required=True)
   519	    s.add_argument("--out", required=True)
   520	    s.add_argument("--renames", action="store_true", help="用 -M 取新行(跟 note-shape 提交前一致;上線後重放用)")
   521	    r = sub.add_parser("rtb182")
   522	    r.add_argument("--rtb", required=True)
   523	    r.add_argument("--out", required=True)
   524	    m = sub.add_parser("summary")
   525	    m.add_argument("--hits", nargs="+", required=True)
   526	    m.add_argument("--labels")
   527	    p = sub.add_parser("sample")
   528	    p.add_argument("--hits", nargs="+", required=True)
   529	    p.add_argument("--pool", choices=("narrow", "refined", "broadonly", "v3", "v3drop"), required=True)
   530	    p.add_argument("--exclude", help="已判過的 id 清單(JSON 陣列檔)")
   531	    p.add_argument("--n", type=int, default=30)
   532	    p.add_argument("--seed", type=int, default=20260930)
   533	    a = ap.parse_args()
   534	    return {"scan": cmd_scan, "rtb182": cmd_rtb182, "summary": cmd_summary, "sample": cmd_sample}[a.cmd](a)
   535	
   536	
   537	if __name__ == "__main__":
   538	    sys.exit(main())

