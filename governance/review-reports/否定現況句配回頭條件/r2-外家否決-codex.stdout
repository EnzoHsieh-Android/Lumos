 27297	def _drift_with_layout(ch, base, tip, tree_of):
 27298	    """兩端版面不一樣時把範圍改動標成形狀改變(所有不帶路徑的行都當候選);沒有起點(空樹)或已經是形狀改變就不看。"""
 27299	    if not base or ch["code_shape"] or not _drift_layout_changed(tree_of(base), tree_of(tip)):
 27300	        return ch
 27301	    return dict(ch, code_shape=True)
 27302	
 27303	
 27304	def _drift_layout_changed(tb, tt):
 27305	    """兩端的測試資料夾版面不一樣 → True(代碼審 r3 正確性席:版面看整棵樹、副檔名轉小寫,刪一支不算程式檔的
 27306	    Foo/Main.SWIFT 就能讓 FooTests/ 裡的檔從測試檔變程式檔,不帶路徑的條件翻成立卻不是候選)。讀不到樹當成有變。"""
 27307	    return tb is None or tt is None or tb.layout != tt.layout
 27308	
 27309	
 27310	def _drift_probe_prefetch(conds, trees):
 27311	    """帶路徑的條件指到的檔,每一版一個行程讀完(代碼審 r2 併發席);列不出樹的那一版跳過,輪到時再判不了。"""
 27312	    for t in trees:
 27313	        if t is not None:
 27314	            t.prefetch(conds)
 27315	
