 24824	def _notelines_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, mark=None, max_count=None,
 24825	                           hook=_NOTELINES_PRECOMMIT):
 24826	    """推送前:範圍裡每個提交各自新增的筆記行 → ({NFC 路徑: 行文字集合}, [範圍淨改動的筆記路徑(git 原樣)],
 24827	    {NFC 路徑: 這道檢查還沒上線的提交寫的行})。git 失敗回 None。
 24828	    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
 24829	    改名照每個提交(合併提交是每個上一版)的改名偵測往後帶到終點路徑(r3 外家席)。
 24830	    ★鍵用 NFC、拿去 git 查的一律用原樣路徑★(驗收輪通才席:NFC 過的路徑對存 NFD 的樹 cat-file、路徑篩選都查不到)。
 24831	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
 24832	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
 24833	    ★寫的時候這道檢查還沒上線的提交不查★(mark):看那個提交自己的提交前掛鉤有沒有上線標記——上線前開的分支上線後
 24834	    才合進來,那些行是舊帳(r3 通才席);原本用「是不是上線點的後代」代替,兩條分支各自裝過時另一條整批漏查(驗收輪通才席)。
 24835	    那些行另外收進第三個回傳值,喚醒那條路也跳過(驗收輪外家席)。max_count:只看最新那幾個提交(doctor 的上限)。"""
 24836	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 24837	    if exclude_remote:
 24838	        ml = _ns_exclusions(repo_root, tip)
 24839	        if ml:
 24840	            rl += ["--not", *ml]
 24841	    if max_count:
 24842	        rl.append(f"--max-count={int(max_count)}")
 24843	    raw = _nodehome_git(repo_root, *rl)
 24844	    if raw is None:
 24845	        return None
 24846	    commits = [ln.split() for ln in raw.decode("ascii", errors="replace").splitlines() if ln.split()]
 24847	    live = None
 24848	    if mark and commits:
 24849	        hb = _nodehome_cat_blobs(repo_root, [f"{c[0]}:{hook}" for c in commits])
 24850	        if hb is None:
 24851	            return None
 24852	        live = {c[0] for c, b in zip(commits, hb) if b is not None and mark.encode() in b}
 24853	    by_path, old_by = {}, {}
 24854	
 24855	    def _renames(a, b):
 24856	        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
 24857	        return None if r is None else _nodehome_name_status(r, norm=False)[1]     # 原樣 新路徑 → 舊路徑
 24858	
 24859	    def _carry(ren):
 24860	        for new_, old_ in (ren or {}).items():
 24861	            ko, kn = nfc(old_), nfc(new_)
 24862	            for d_ in (by_path, old_by):
 24863	                if ko in d_ and ko != kn:
 24864	                    d_.setdefault(kn, set()).update(d_.pop(ko))
 24865	
 24866	    for shas in commits:
 24867	        sha, parents = shas[0], shas[1:]
 24868	        first = parents[0] if parents else _EMPTY_TREE_SHA
 24869	        ren = _renames(first, sha)
 24870	        if ren is None:
 24871	            return None
 24872	        _carry(ren)
 24873	        dest = by_path if (live is None or sha in live) else old_by
 24874	        if len(parents) <= 1:
 24875	            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
 24876	            if d is None:
 24877	                return None
 24878	            for p, rows in _notelines_parse_added(d).items():
 24879	                dest.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 24880	            continue
 24881	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 24882	        if names is None:
 24883	            return None
 24884	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 24885	        pren = [_renames(pp, sha) or {} for pp in parents]
 24886	        for pr in pren[1:]:
 24887	            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
 24888	            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
 24889	            _carry(pr)
 24890	        specs = []
 24891	        for p in paths:
 24892	            specs.append(f"{sha}:{p}")
 24893	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
 24894	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 24895	        k = 1 + len(parents)
 24896	        for i, p in enumerate(paths):
 24897	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 24898	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 24899	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 24900	                d = _ns_diff(repo_root, first, sha, "--", p)
 24901	                if d is None:
 24902	                    return None
 24903	                for _p, rows in _notelines_parse_added(d).items():
 24904	                    dest.setdefault(nfc(p), set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 24905	            else:
 24906	                dest.setdefault(nfc(p), set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
 24907	    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 24908	    if net is None:
 24909	        return None
 24910	    return by_path, [p for p in _nodehome_split_z(net) if p.endswith(".md")], old_by
 24911	
 24912	
 24913	def _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, *, reader, mark, hook=_NOTELINES_PRECOMMIT,
 24914	                   per_commit=True, exclude_remote=True, max_count=None, keep_other=False):
 24915	    """範圍裡新寫、而且終點版本還在的筆記行——筆記形狀擋與筆記內容審共用(Projects/筆記內容審_計劃 [S1][S2])。
 24916	    → (notes, errs, old_by) 或 None(git 失敗)。notes=[(路徑, 全文, [(行號, 行文字, 區塊)])],只收 body/summary/
 24917	    decisions 三塊的非空行;errs=讀不成 UTF-8 的筆記;old_by={NFC 路徑: 這道檢查還沒上線時寫的行}。
 24918	    ★per_commit★:True=逐提交看「那個提交自己的 hook 有沒有 mark」(提交前掛鉤在寫的那一刻跑,第一層);
 24919	    False=不逐提交判、只靠範圍截斷(推送時才跑的閘,跑的是當下工作目錄那份掛鉤,第二層)——★要明寫傳 False★,
 24920	    不傳會落到第一層的預設。找不到上線點時照既有語意不過濾。
 24921	    keep_other=True 時開頭欄位其他欄(區塊 other)的新行也收——只給筆記形狀擋查「條件標記寫在不評估的地方」用
 24922	    (存量漂移防線 [S10]),既有規則照舊只看 body/summary/decisions。"""
 24923	    if staged:
 24924	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 24925	        if d is None:
 24926	            return None
 24927	        added = {p: rows for p, rows in _notelines_parse_added(d).items() if p.endswith(".md")}
 24928	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 24929	        texts_by, old_by, net = None, {}, None
 24930	    else:
 24931	        live_mark = mark if (per_commit and _nodehome_golive(repo_root, tip_where, mark, hook)) else None
 24932	        rc = _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count,
 24933	                                   hook, keep_other)
 24934	        if rc is None:
 24935	            return None
 24936	        cand, texts_by, old_by, net = rc
 24937	    notes, errs = [], []
 24938	    for p, linenos in sorted(cand.items()):
 24939	        b = reader(p)
 24940	        if b is None:
 24941	            continue
 24942	        try:
 24943	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 24944	        except UnicodeDecodeError:
 24945	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 24946	            continue
 24947	        texts = None if texts_by is None else texts_by.get(nfc(p), ())
 24948	        netl = None if net is None else (lambda p=p: net.lines(nfc(p)))
 24949	        notes.append((p, text, _notelines_rows(text, linenos, texts, keep_other, netl)))
 24950	        if net is not None and net.failed:
 24951	            return None     # 當場停,不往下算(代碼審 r3 架構對齊席)
 24952	    return notes, errs, old_by
 24953	
 24954	
 24955	def _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count, hook,
 24956	                          keep_other):
 24957	    """推送範圍的候選 → (候選 {路徑: None}, 逐提交新增的文字, 還沒上線時寫的行, 範圍淨差異(_NotelinesNet)或 None);
 24958	    git 失敗回 None。開頭欄位其他欄的行要對「範圍淨差異」的行號:逐提交的文字集合分不出位置,舊欄位裡跟正文新行
 24959	    一字不差的那一行會被當成新寫(存量漂移防線乙代碼審 r1 外家席;staged 模式本來就對行號)。只在 keep_other 時才有。"""
 24960	    ra = _notelines_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
 24961	                                mark=live_mark, max_count=max_count, hook=hook)
 24962	    if ra is None:
 24963	        return None
 24964	    texts_by, paths, old_by = ra
 24965	    net = _NotelinesNet(repo_root, base_where, tip_where, vault_rel) if keep_other else None
 24966	    return {p: None for p in paths}, texts_by, old_by, net
 24967	
 24968	
 24969	class _NotelinesNet:
 24970	    """範圍淨差異的新增行號,★用到才算★:只有開頭欄位其他欄真的有一行跟逐提交新增的文字對上時才跑那一次 diff
 24971	    (代碼審 r2 併發席:原本筆記形狀擋每次推送都固定多跑一次整個圖譜範圍的 diff)。git 失敗記 failed,呼叫端當場整次回 None。
 24972	    ★為什麼用旗標不回 None★(代碼審 r3 架構對齊席問過):它是以無參數函式傳進 _notelines_rows 的,那一層只回行清單、
 24973	    沒有失敗出口;要回 None 得改 rows 的回傳形狀與三個呼叫端,旗標只多呼叫端一行檢查。"""
 24974	
 24975	    def __init__(self, repo_root, base_where, tip_where, vault_rel):
 24976	        self.args, self._m, self.failed = (repo_root, base_where, tip_where, vault_rel), None, False
 24977	
 24978	    def lines(self, p):
 24979	        if self._m is None and not self.failed:
 24980	            repo_root, base_where, tip_where, vault_rel = self.args
 24981	            dn = _ns_diff(repo_root, base_where or _EMPTY_TREE_SHA, tip_where, "--", vault_rel)
 24982	            self.failed = dn is None
 24983	            self._m = {} if dn is None else {nfc(q): {n for n, _t in rows} for q, rows in _notelines_parse_added(dn).items()}
 24984	        return self._m.get(p, ())
 24985	
 24986	
 24987	def _notelines_rows(text, linenos, texts, keep_other, net):
 24988	    """一篇筆記裡算新寫的行 → [(行號, 行文字, 區塊)]。linenos:staged 的新增行號;texts:推送範圍逐提交新增的文字;
 24989	    net:回推送範圍淨差異新增行號的函式(只拿來核對開頭欄位其他欄,用到才呼叫)。"""
 24990	    lines = text.split("\n")
 24991	    regs = _notelines_regions(text)
 24992	    rows = []
 24993	    for i, ln in enumerate(lines, 1):
 24994	        if linenos is not None and i not in linenos:
 24995	            continue
 24996	        if texts is not None and ln.strip() not in texts:
 24997	            continue
 24998	        if not ln.strip() or (regs[i - 1] == "other" and not keep_other):
 24999	            continue
 25000	        if regs[i - 1] == "other" and net is not None and i not in net():
 25001	            continue
 25002	        rows.append((i, ln, regs[i - 1]))
 25003	    return rows
 25004	
 25005	
 25006	_NOTELINES_HEADING_RE = re.compile(r"^#{1,6}\s+(.*?)\s*#*\s*$")
 25007	_NOTELINES_DECISION_KEY_RE = re.compile(r"^(\s*)(?:-\s+)?([A-Za-z_][\w-]*)\s*:")
 25008	
 25009	
 25010	def _notelines_decision_fields(text):
 25011	    """decisions 裡每一行屬於哪一條決策的哪一欄 → {行號(從1起): (決策編號, 欄名, valid)}(Projects/筆記內容審_計劃 [S3][S4])。
 25012	    既有 decisions_items 只給每條決策的起訖行;決策編號用 decision-supersede 同一種 `id:` 比對,欄名逐行歸屬:
 25013	    跟項目子鍵同縮排、`鍵:` 開頭的行是那一欄,後面縮排更深或沒有 `鍵:` 的續行跟著前一欄。沒有編號的決策用 `#<序號>`。"""
 25014	    fm, _b = split_frontmatter(text)
 25015	    out = {}
 25016	    if not fm:
 25017	        return out
 25018	    di = decisions_items(fm)
 25019	    if di is None:
 25020	        return out
 25021	    _s, _e, items, _item_indent, sub_indent = di
 25022	    for n, (st, en) in enumerate(items, 1):
 25023	        did, valid, cur = f"#{n}", True, None
 25024	        fields = []
 25025	        for k in range(st, en + 1):
 25026	            ln = fm[k]
 25027	            m = _NOTELINES_DECISION_KEY_RE.match(ln)
 25028	            ind = len(ln) - len(ln.lstrip(" "))
 25029	            is_key = m and (k == st or ind == sub_indent)
 25030	            if is_key:
 25031	                cur = m.group(2)
 25032	                val = ln.split(":", 1)[1].strip()
 25033	                if cur == "id":
 25034	                    mm = re.match(r"^(d\d+)$", val)
 25035	                    if mm:
 25036	                        did = mm.group(1)
 25037	                elif cur == "valid":
 25038	                    valid = val.strip("\"'").lower() != "false"
 25039	            fields.append((k, cur))
 25040	        for k, f in fields:
 25041	            out[k + 2] = (did, f or "", valid)       # fm[0] 是全文第 2 行
 25042	    return out
 25043	
 25044	
 25045	def _notelines_headings(text, regs):
 25046	    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
 25047	    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
 25048	    lines = text.split("\n")
 25049	    vis = {i for i, _l in _visible_lines(lines)}
 25050	    dfields = _notelines_decision_fields(text)
 25051	    out, cur = [], ""
 25052	    for i, ln in enumerate(lines, 1):
 25053	        reg = regs[i - 1]
 25054	        if reg == "body" and i in vis:
 25055	            m = _NOTELINES_HEADING_RE.match(ln)
 25056	            if m:
 25057	                cur = m.group(1).strip()
 25058	        if reg == "summary":
 25059	            out.append("summary")
 25060	        elif reg == "decisions":
 25061	            did, f, _v = dfields.get(i, ("", "", True))
 25062	            out.append(f"decisions/{did}/{f}")
 25063	        elif reg == "body":
 25064	            out.append(cur)
 25065	        else:
 25066	            out.append("")
 25067	    return out
