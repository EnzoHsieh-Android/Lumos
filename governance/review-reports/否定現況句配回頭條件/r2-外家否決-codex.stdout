 25098	def _ns_is_code(path, reader, files):
 25099	    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
 25100	    if path not in files:
 25101	        return False
 25102	    kind = _nodehome_code_kind(path)
 25103	    if kind == "ext":
 25104	        return True
 25105	    if kind != "shebang?":
 25106	        return False
 25107	    b = reader(path)
 25108	    return b is not None and _head_is_shebang(b[:200])
