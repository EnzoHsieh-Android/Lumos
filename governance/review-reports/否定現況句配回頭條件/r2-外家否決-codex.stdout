 25198	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 25199	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 25200	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 25201	    if ch is None:
 25202	        return []
 25203	    lst_t = _nodehome_list(repo_root, tip_where)
 25204	    lst_b = _nodehome_list(repo_root, base_where)
 25205	    if lst_t is None or lst_b is None:
 25206	        return []
 25207	    reader_b = _nodehome_reader(repo_root, base_where)
 25208	    out = []
 25209	    for code, _old, new in ch:
 25210	        if not new or code == "D":
 25211	            continue
 25212	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 25213	            continue
 25214	        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
 25215	        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
 25216	            out.append(new)
 25217	    return out
