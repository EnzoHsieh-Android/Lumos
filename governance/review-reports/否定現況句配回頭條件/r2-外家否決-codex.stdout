 25298	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 25299	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 25300	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 25301	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 25302	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 25303	    out = []
 25304	    root = Path(repo_root)
 25305	    cp = root / ".lumos" / "config.json"
 25306	    txt = None
 25307	    try:
 25308	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 25309	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 25310	            txt = cp.read_bytes()
 25311	    except OSError:
 25312	        txt = None
 25313	    mode, _w = _note_shape_config(txt)
 25314	    if mode != "block":
 25315	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 25316	                   "沒寫來源的現況描述不會被擋")
 25317	    wf = root / ".github" / "workflows"
 25318	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 25319	    if ymls:
 25320	        # 跳過註解:整行被註解掉的那步不算有呼叫(第二層早就這樣判;代碼審 r3 通才席:兩句判法不一,中間漏唸)
 25321	        body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
 25322	        step = ("\n    - run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 25323	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
 25324	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before || '0000000000000000000000000000000000000000' }}..${{ github.sha }}\""
 25325	                "\n  (這步只在 push 事件跑(`if: github.event_name == 'push'`),pull_request 沒有前一版;checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了找得到主線:"
 25326	                "已在主線上的提交不重查,新分支首推(前一版是 40 個 0)或 force-push 後舊頂端找不到時,lumos 從跟主線的分岔點算)"
 25327	                + _CI_PY314_NOTE)
 25328	        if "note-shape --diff" not in body:
 25329	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 25330	        else:
 25331	            shallow = _ci_jobs_calling_without_full_history(ymls, "note-shape --diff")
 25332	            if shallow:
 25333	                out.append("專案 CI 呼叫了 note-shape,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
 25334	                           + _ci_jobs_list(shallow))
 25335	    if ci:
 25336	        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
 25337	        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
 25338	        return out
 25339	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 25340	    if gl is None:
 25341	        return out
 25342	    ref = None
 25343	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 25344	    if up is not None and up.returncode == 0 and up.stdout.strip():
 25345	        ref = up.stdout.strip()
 25346	    else:
 25347	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 25348	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 25349	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 25350	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 25351	        ref = cands[0] if cands else None
 25352	    tip = _lens_full_sha(root, ref) if ref else None
 25353	    if tip is None:
 25354	        return out
 25355	    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
 25356	    if a is None or a.returncode != 0:
 25357	        return out
 25358	    try:
 25359	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 25360	    except ValueError:
 25361	        return out
