    98	
    99	def _in_quote(s, pos):
   100	    for a, b in QUOTE_PAIRS:
   101	        depth = 0
   102	        for ch in s[:pos]:
   103	            if a == b and ch == a:
   104	                depth ^= 1
   105	            elif ch == a:
   106	                depth += 1
   107	            elif ch == b and depth:
   108	                depth -= 1
   109	        if depth:
   110	            return True
   111	    return False
   112	
   113	
   114	def _live(masked, m):
   115	    """這一處否定字眼算不算「在講現況缺東西」:不在引號裡(是在提這個字)、不在修飾語或條件子句裡。"""
   116	    if _in_quote(masked, m.start()):
   117	        return False
   118	    return not RX_MODIFIER.match(masked[m.end():])
   119	
   120	
   121	def classify_text(probe):
   122	    """一行看得見的字 → 比對結果 dict(沒有任何否定字眼回 None)。
   123	    narrow/broad 是字面命中;narrow_live 是扣掉引號內、修飾語與條件子句之後還在的窄表命中(細化規則用)。"""
   124	    masked, n_notlack = _mask_notlack(probe)
   125	    nar = list(RX_NARROW.finditer(masked))
   126	    bro = list(RX_BROAD.finditer(masked))
   127	    if not nar and not bro and not n_notlack:
   128	        return None
   129	    live = [m for m in nar if _live(masked, m)]
   130	    hits = live or nar or bro
   131	    clauses = [_clause_at(masked, m.start()) for m in hits]
   132	    return {
   133	        "narrow": sorted({m.group(0) for m in nar}),
   134	        "narrow_live": sorted({m.group(0) for m in live}),
   135	        "broad": sorted({m.group(0) for m in bro}),
   136	        "notlack": n_notlack,
   137	        "hist": any(RX_HIST.search(c) for c in clauses),
   138	        "rule": any(RX_RULE.search(c) for c in clauses),
   139	        "template": any(t in probe for t in TEMPLATE_MARKS),
   140	        "inline_revisit": "REVISIT:" in probe,
   141	    }
   142	
   143	
   144	# ── 第三版判定(設計審 r1 折入後;計劃〈做法〉1 照這一版)──
   145	# 跟上面細化版的差別:①歷史/規則字眼只看否定字眼所在的那一小段(逗號、頓號、冒號、括號、破折號、英文句點也切),
   146	# 引號裡的字與 RULE 等行內欄位([since:…][retire:…]…)不算,歷史字眼要出現在否定字眼前面才算,規則字眼拿掉「別」;
   147	# ②修飾語按字眼種類與位置判:講「有沒有」的(目前沒有、還沒有、尚無…)後面接「的」不算修飾語,時/前要接斷句或虛詞才算;
   148	# ③英文 TODO/TBD/Todo 分大小寫,另認「not/no/n't … yet」;④不看 decisions 區塊、RETIRE-IF 行與「為什麼還不做:」樣板。
   149	NARROW_V3_EN_CS = ("TODO", "TBD", "Todo")
   150	NARROW_V3_EN_CI = ("not yet", "yet to")
   151	RULE_MARK_V3 = tuple(w for w in RULE_MARK if w != "別")
   152	EXIST_TOKENS = ("目前沒有", "現在沒有", "尚無", "暫無", "目前無")
   153	FIELD_RX = re.compile(r"\[(?:since|retire|until|confirmed|status|applies|test|audit|kill|rollback|guard|src|git|manual|by|"
   154	                      r"來源|when-[a-z]+):[^\]]*\]")
   155	SEG_CUT_V3 = re.compile(r"[。;；!?！？,，、:：()（）]|——|—|\.(?=\s|$)")
   156	RX_NARROW_V3 = re.compile("|".join(
   157	    [re.escape(w) for w in sorted(NARROW_ZH, key=len, reverse=True)]
   158	    + [r"(?<![A-Za-z0-9_-])" + re.escape(w) + r"(?![A-Za-z0-9_-])" for w in NARROW_V3_EN_CS]
   159	    + [r"(?i:(?<![A-Za-z0-9_-])" + re.escape(w) + r"(?![A-Za-z0-9_-]))" for w in NARROW_V3_EN_CI]
   160	    + [r"(?i:(?<![A-Za-z])(?:not|no|n't)(?![A-Za-z])[^.;,!?]{0,40}?(?<![A-Za-z])yet(?![A-Za-z]))"]))
   161	RX_HIST_V3 = re.compile("|".join(re.escape(w) for w in sorted(HIST_MARK, key=len, reverse=True)))
   162	RX_RULE_V3 = re.compile("|".join(re.escape(w) for w in sorted(RULE_MARK_V3, key=len, reverse=True)))
   163	MOD_BREAK = set(" \t,，、。;；:：!?！？()（）「」『』") | set("就才會要先再也都便即")
   164	MOD_STOP = set(",，、。;；:：()（）「」『』“”\"") | {" "}
   165	TEMPLATE_V3 = ("TEST:還沒有測試在守這條", "]預告這條合約但還沒做:")
   166	
   167	
   168	def _quote_spans(s):
   169	    spans = []
   170	    for a, b in QUOTE_PAIRS:
   171	        start = None
   172	        for i, ch in enumerate(s):
   173	            if start is None and ch == a:
   174	                start = i
   175	            elif start is not None and ch == b and i != start:
   176	                spans.append((start, i + 1))
   177	                start = None
   178	    return spans
   179	
   180	
   181	def _is_modifier_v3(masked, m):
   182	    """否定字眼後面(不跨標點與空白、最多 8 字)有沒有接修飾語或條件子句的記號。"""
   183	    tok = m.group(0)
   184	    exist = tok in EXIST_TOKENS or (tok == "還沒" and masked[m.end():m.end() + 1] == "有")
   185	    tail = masked[m.end():m.end() + 9]
   186	    for j, ch in enumerate(tail):
   187	        if ch in MOD_STOP:
   188	            return False
   189	        if ch == "→":
   190	            return True
   191	        if tail[j:j + 3] == "的時候":
   192	            return True
   193	        if ch == "的" and not exist:
   194	            return True
   195	        if ch in "時前":
   196	            nxt = tail[j + 1:j + 2]
   197	            if nxt == "" or nxt in MOD_BREAK:
   198	                return True
   199	    return False
   200	
   201	
   202	def _segment(s, pos):
   203	    a = 0
   204	    for m in SEG_CUT_V3.finditer(s):
   205	        if m.end() <= pos:
   206	            a = m.end()
   207	        elif m.start() > pos:
   208	            return a, m.start()
   209	    return a, len(s)
   210	
   211	
   212	def classify_v3(probe):
   213	    """第三版:一行看得見的字 → {narrow, live, kept}(沒有窄表字眼回 None)。
   214	    live=不在引號裡、不是修飾語的那幾處;kept=live 裡、所在那一小段沒有規則字眼、前面沒有歷史字眼的那幾處。"""
   215	    s = FIELD_RX.sub(lambda m: "\0" * len(m.group(0)), probe)
   216	    masked, _n = _mask_notlack(s)
   217	    nar = list(RX_NARROW_V3.finditer(masked))
   218	    if not nar:
   219	        return None
   220	    spans = _quote_spans(masked)
   221	    unq = list(masked)
   222	    for a, b in spans:
   223	        for k in range(a, b):
   224	            unq[k] = "\0"
   225	    unq = "".join(unq)
   226	    live = [m for m in nar if not any(a <= m.start() < b for a, b in spans) and not _is_modifier_v3(masked, m)]
   227	    kept = []
   228	    for m in live:
   229	        a, b = _segment(masked, m.start())
   230	        seg_before, seg = unq[a:m.start()], unq[a:b]
   231	        if RX_RULE_V3.search(seg) or RX_HIST_V3.search(seg_before):
   232	            continue
   233	        kept.append(m)
   234	    return {"narrow": sorted({m.group(0) for m in nar}), "live": sorted({m.group(0) for m in live}),
   235	            "kept": sorted({m.group(0) for m in kept})}
   236	
   237	
   238	def excluded_v3(probe, region):
   239	    """第三版不看的行 → 原因字串或 None。"""
   240	    t = probe.strip()
   241	    if region not in ("body", "summary"):
   242	        return "region"
   243	    if any(x in t for x in TEMPLATE_V3) or re.sub(r"^(?:[-*+]\s+)", "", t).startswith("為什麼還不做:"):
   244	        return "template"
   245	    if re.sub(r"^(?:[-*+]\s+)", "", t).startswith("RETIRE-IF:"):
   246	        return "retire"
   247	    return None
   248	
   249	
   250	# ── git ──
   251	
   252	
   253	def git(repo, *args):
   254	    r = subprocess.run(["git", "-C", repo, "-c", "core.quotePath=off", *args], capture_output=True)
   255	    if r.returncode != 0:
   256	        raise RuntimeError(f"git {args[:3]} rc={r.returncode}: {r.stderr[:300]!r}")
   257	    return r.stdout.decode("utf-8", "replace")
   258	
   259	
   260	HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
   261	
   262	
   263	def added_lines(repo, parent, commit, vault, renames=False):
   264	    """這個提交在圖譜 .md 新增或改寫的行 → {路徑: {新行號}}。預設 --no-renames(改名過來的整篇算新寫;第一、二版與
   265	    第三版的數字都是這個口徑);renames=True 用 -M,跟 note-shape 提交前的 `_ns_diff` 一致(上線後重放用)。"""
   285	    """第 i 行(從 1 起)前後 span 行、同一區塊裡有沒有 REVISIT:回 'cond'/'date'/None(有條件式優先)。"""
   286	    kinds = set()
   287	    for j in range(max(1, i - span), min(len(lines), i + span) + 1):
   288	        if j == i or regions[j - 1] != regions[i - 1]:
   289	            continue
   290	        k, _r = LM._revisit_split(LM._strip_inline_markup(lines[j - 1])[0])
   291	        if k in ("cond", "date"):
   292	            kinds.add(k)
   293	    return "cond" if "cond" in kinds else ("date" if "date" in kinds else None)
   294	
   295	
   296	def _shape(probe):
   297	    t = probe.lstrip()
   298	    if t.startswith("|"):
   299	        return "table"
   300	    if t.startswith("#"):
   301	        return "heading"
   302	    m = re.match(r"^(?:[-*+]\s+)?([A-Z][A-Z-]+):", t)
   303	    return m.group(1) if m else "prose"
   304	
   305	
   306	def scan_note(text, new_nos):
   307	    """一篇筆記終點全文 + 新行號 → 命中列。"""
   308	    lines = text.split("\n")
   309	    regions = LM._notelines_regions(text)
   310	    vis = {no for no, _l in LM._visible_lines(lines)}
   311	    note_has_cond = any(LM._revisit_split(LM._strip_inline_markup(x)[0])[0] == "cond" for x in lines)
   312	    rows, stats = [], Counter()
   313	    for i in sorted(new_nos):
   314	        if i < 1 or i > len(lines) or regions[i - 1] == "other" or i not in vis:
   315	            continue
   316	        probe = LM._strip_inline_markup(lines[i - 1])[0]
   317	        if not probe.strip():
   318	            continue
   319	        if LM._revisit_split(probe)[0] is not None:
   320	            stats["revisit_lines"] += 1
   321	            continue
   322	        stats["lines"] += 1
   323	        c = classify_text(probe)
   324	        c3 = classify_v3(probe)
   325	        if c is None and c3 is None:
   326	            continue
   327	        if c is None:
   328	            c = {"narrow": [], "narrow_live": [], "broad": [], "notlack": 0, "hist": False, "rule": False,
   329	                 "template": False, "inline_revisit": "REVISIT:" in probe}
   330	        c["v3"] = c3
   331	        c["v3_excluded"] = excluded_v3(probe, regions[i - 1])
   332	        c.update({"line": i, "region": regions[i - 1], "shape": _shape(probe), "text": lines[i - 1].strip()[:240],
   333	                  "paired": _revisit_near(lines, regions, i), "note_has_cond": note_has_cond})
   334	        rows.append(c)
   335	    return rows, stats
   336	
   337	
   338	def cmd_scan(a):
   339	    if a.commits:
   340	        commits = [x.strip() for x in Path(a.commits).read_text().split() if x.strip()]
   341	    else:
   342	        commits = git(a.repo, "log", "--no-merges", "--format=%H", f"-{a.n}", a.head).split()
   343	    tot, fh = Counter(), open(a.out, "w", encoding="utf-8")
   344	    for c in commits:
   345	        parents = git(a.repo, "log", "-1", "--format=%P", c).split()
   346	        if not parents:
   347	            continue
   348	        tot["commits"] += 1
   349	        per = added_lines(a.repo, parents[0], c, a.vault, renames=a.renames)
   350	        tot["commits_touching_notes"] += bool(per)
   351	        date = git(a.repo, "log", "-1", "--format=%ad", "--date=short", c).strip()
   352	        for p, nos in per.items():
   353	            text = git(a.repo, "show", f"{c}:{p}")
   354	            rows, st = scan_note(text, nos)
   355	            tot.update(st)
   356	            for r in rows:
   357	                r.update({"repo": a.tag, "commit": c[:8], "date": date, "note": p[len(a.vault) + 1:]})
   358	                r["id"] = f"{a.tag}:{c[:8]}:{r['note']}:{r['line']}"
   359	                fh.write(json.dumps(r, ensure_ascii=False) + "\n")
   360	    fh.write(json.dumps({"_meta": dict(tot), "tag": a.tag}, ensure_ascii=False) + "\n")
   361	    fh.close()
   362	    print(json.dumps(dict(tot), ensure_ascii=False))
   363	    return 0
   364	
