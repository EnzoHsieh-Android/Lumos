 27480	# ── 表態 ─────────────────────────────────────────────────────────────────────────────
 27481	
 27482	def _drift_jsonl_parse(raw):
 27483	    """帳檔的位元組 → [dict](不是 JSON 物件的行略過)。表態檔與修復帳共用。
 27484	    ★只在 \\n 切行★:str.splitlines() 還會在 U+2028、U+0085、換頁字元切開,而寫入端 json.dumps(ensure_ascii=False)
