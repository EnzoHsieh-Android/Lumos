 27221	def _drift_probe_is_candidate(conds, ch, vault_pre, tenv, tip_text):
 27222	    """這一行的條件會不會被這次推送改變結果(計劃〈做法〉第 0 節,篩選單位是行)→ True / False / None(判不了)。
 27223	    不帶路徑的 symbol/test:名稱出現在這次改到的程式或測試檔的★終點全文★就是候選(tip_text() → 那幾支的全文或 None)。
 27224	    ★為什麼不只看新增行★(代碼審 r2 正確性席):判定改用 ast、沒副檔名的 #! 腳本也算程式檔之後,「定義在不在」
 27225	    可以在名稱那一行沒動的情況下翻轉——只刪掉包住 def 的三引號、只在第一行加 #!。要處理只看終點成立,
 27226	    所以只要終點全文;順便省掉原本算新增行的那次 diff(標了 -diff 屬性的檔看不見新增行的坑也一起沒了)。
 27227	    tip_text() → _DriftNames(終點全文的識別字集合,名稱是一般識別字時查集合,不再對幾 MB 的字串逐條跑正則——
 27228	    代碼審 r3 併發席實測 100 行條件 10 秒)或 None。"""
 27229	    hits = [_drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text) for k, v in conds]
 27230	    # 任一確定受影響就是候選;判不了的不提前停(代碼審 r3 外家席:原本前一個判不了就回判不了,後面確定受影響的
 27231	    # 那條本來可以列成可表態的發現)
 27232	    if any(hits):
 27233	        return True
 27234	    return None if any(h is None for h in hits) else False
 27235	
 27236	
 27237	def _drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text):
 27238	    """一個條件會不會被這次推送改變結果 → True / False / None(判不了)。"""
 27239	    if k == "file":
 27240	        return v in ch["touched"]
 27241	    if k == "status":
 27242	        rel = _drift_status_target(tenv, v)[0]
 27243	        return rel is None or (vault_pre + rel) in ch["touched"]
 27244	    path, name = _drift_cond_split(v)
 27245	    if path:
 27246	        return path in ch["touched"]
 27247	    if ch["code_shape"]:
 27248	        return True
 27249	    if not ch["code_touched"]:
 27250	        return False
 27251	    names = tip_text(k == "test")
 27252	    if names is None:
 27253	        return None
 27254	    return True if names.has(name) else (None if names.partial else False)
 27255	
