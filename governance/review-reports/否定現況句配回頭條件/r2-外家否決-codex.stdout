 25121	def _ns_is_regen(text):
 25122	    """帶 regen 的重建筆記:照 Check J 看解析後的值(空字串不算;代碼審 r3 外家席:原本看原始文字,`regen: ""` 也算)。"""
 25123	    fm, _b = split_frontmatter(text)
 25124	    if not fm:
 25125	        return False
 25126	    v = parse_frontmatter(fm)[0].get("regen")
 25127	    return isinstance(v, str) and bool(v.strip())
