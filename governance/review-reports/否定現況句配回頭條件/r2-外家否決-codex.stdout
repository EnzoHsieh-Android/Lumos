 27203	def _drift_probe_changes(root, base, tip, deadline=None):
 27204	    """範圍裡的改動(只算一次 name-status)→ {touched: 改到的路徑(改名兩端都算), renames: 改名 新→舊,
 27205	    code_touched: 改到的程式與測試檔, code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗或預算用完回 None。
 27206	    解析用共用的 _nodehome_name_status(代碼審 r1 架構對齊席:原本手刻第二份);筆記改名也從這一次拿(圖譜一致席:
 27207	    原本另起一次 git)。不帶路徑的條件改看 code_touched 在終點的全文(_drift_probe_is_candidate),不再算新增行。"""
 27208	    import time as _t
 27209	    if deadline is not None and _t.monotonic() >= deadline:
 27210	        return None
 27211	    raw = _ns_git(root, "diff", "--name-status", "-z", "-M", base or _drift_empty_tree(root), tip)
 27212	    if raw is None:
 27213	        return None
 27214	    codes = {}
 27215	    touched, renames, _gone = _nodehome_name_status(raw, codes=codes)
 27216	    shape = any(c in ("A", "D", "R", "C") and _drift_probe_code_path(p) for p, c in codes.items())
 27217	    return {"touched": touched, "renames": renames, "code_shape": shape,
 27218	            "code_touched": sorted(p for p in touched if _drift_probe_code_path(p))}
 27219	
