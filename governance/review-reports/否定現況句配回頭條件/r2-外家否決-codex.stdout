 25070	_NOTELINES_TABLE_SEP_RE = re.compile(r"^\s*[|:\-\s]*-[|:\-\s]*$")
 25071	_NOTELINES_RULE_RE = re.compile(r"^\s{0,3}(?:(?:-\s*){3,}|(?:\*\s*){3,}|(?:_\s*){3,})$")
 25072	_NOTELINES_BARE_LIST_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])(?:\s+\[[ xX]\])?\s*$")
 25073	
 25074	
 25075	def _notelines_structural_lines(text):
 25076	    """沒有主張、不審的行號集合(Projects/筆記內容審_計劃 [S4]):圍欄記號行(照 _visible_lines 認的)、表格分隔行、
 25077	    分隔線、只有清單記號的行。空白行本來就不收,不在這裡。"""
 25078	    lines = text.split("\n")
 25079	    kept = {i for i, _l in _visible_lines(lines, keep_fenced=True)}
 25080	    out = set()
 25081	    for i, ln in enumerate(lines, 1):
 25082	        if not ln.strip():
 25083	            continue
 25084	        if i not in kept or (_NOTELINES_TABLE_SEP_RE.match(ln) and "|" in ln) or _NOTELINES_RULE_RE.match(ln) \
 25085	                or _NOTELINES_BARE_LIST_RE.match(ln):
 25086	            out.add(i)
 25087	    return out
 25088	
