+def _kt_bj_material(picked, texts):
+    """[(段, 要判的列)…] → 盲判材料的 segments(只含程式與型錄內容,不含任何表態或盲判內容)。"""
+    table = {r["id"]: r for r in _KT_DT_ROWS}
+    srcs = _kt_dt_sources()
+    out = []
+    for sg, rids in picked:
+        lines = texts[sg["file"]].split("\n")
+        a, b = sg["material"]
+        mat = "\n".join(f"{n:>5}| {lines[n - 1] if n <= len(lines) else ''}" for n in range(a, b + 1))
+        rows = []
+        for rid in rids:
+            r, src = table.get(rid) or {}, srcs.get(rid) or {}
+            rows.append({"id": rid, "situation": r.get("situation", ""), "standard": r.get("standard", ""), "when_not": r.get("alt", ""),
+                         "source": src.get("source", ""), "source_refs": src.get("refs") or [],
+                         "checks": [{"id": c.get("id"), "name": c.get("name"), "refs": c.get("refs") or []} for c in src.get("checks") or []]})
+        out.append({"seg": sg["seg"], "file": sg["file"], "range": [sg["start"], sg["end"]], "hit_lines": sg["lines"],
+                    "material_range": [a, b], "material": mat, "rows": rows})
+    return out
