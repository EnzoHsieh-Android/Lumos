+        author_rows = {a.get("seg"): a.get("rows") for a in sit.get("segments") or []
+                       if isinstance(a, dict) and isinstance(a.get("rows"), dict)}
+    picked = [(sg, rids) for sg in segs for rids in [_kt_bj_pick_rows(sg, mode, cells, author_rows)] if rids]
+    parts = max(1, -(-len(picked) // _KT_BJ_PART_MAX))
+    if not 1 <= part <= parts:
+        print(f"擋下:--part {part} 超出份數(這次共 {parts} 份)", file=sys.stderr)
+        return 2
+    chunk = picked[(part - 1) * _KT_BJ_PART_MAX:part * _KT_BJ_PART_MAX]
+    try:
+        texts = _kt_sit_read_many(repo_root, at_sha, sorted({sg["file"] for sg, _r in chunk}))
+    except (_KtSitUnverifiable, OSError, subprocess.TimeoutExpired) as e:
+        print(f"擋下:段材料讀不到({e if isinstance(e, _KtSitUnverifiable) else e.__class__.__name__})", file=sys.stderr)
+        return 2
+    doc = {"kind": "lumos-blind-judge-material", "role": "arbiter" if mode == "disagreements" else "first", "part": part, "parts": parts,
+           "instructions": _KT_BJ_INSTRUCTIONS, "answer_format": _kt_bj_answer_format(), "segments": _kt_bj_material(chunk, texts)}
+    if not _kt_dt_sources():
+        doc["note"] = "這次讀不到型錄的出處欄,材料沒附出處;照情境、標準寫法與不適用時判"
+    print(_json_text_escaped(doc, indent=2))
+    if parts > 1:
+        rest = " ".join(f"--part {k}" for k in range(1, parts + 1) if k != part)
+        print(f"盲判材料共 {parts} 份(每份最多 {_KT_BJ_PART_MAX} 段),這是第 {part} 份;其餘用 {rest} 各印一份、各派一個代理", file=sys.stderr)
+    if not picked:
+        print("這次沒有要盲判的段" + {"missing": "(每格都有第一盲判了)", "disagreements": "(沒有作者與第一盲判對不上又缺仲裁的格)"}.get(mode, ""),
+              file=sys.stderr)
+    return 0
