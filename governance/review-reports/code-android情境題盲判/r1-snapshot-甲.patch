+def _kt_bj_cells_add(cells, judgments, role):
+    """把一筆盲判事件的判決({段: {file, rows: {列: 票}}})併進 cells({段: {列: {first, arbiter}}});每格只認第一筆。
+    回已有值、這次沒寫進去的 [(段, 列)…]。"""
+    skipped = []
+    for seg, ent in (judgments or {}).items():
+        if not isinstance(ent, dict) or not isinstance(ent.get("rows"), dict):
+            continue
+        for rid, v in ent["rows"].items():
+            if not isinstance(v, dict) or not isinstance(v.get("applies"), bool):
+                continue
+            c = cells.setdefault(str(seg), {}).setdefault(str(rid), {})
+            if role in c:
+                skipped.append((seg, rid))
+                continue
+            c[role] = {k: v[k] for k in ("applies", "followed", "reason") if k in v}
+    return skipped
