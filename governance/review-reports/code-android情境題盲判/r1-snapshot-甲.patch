+    fn = getattr(mod, "dt_sources", None) if mod is not None else None
+    if fn is not None:
+        try:
+            got = fn(_kt_catalog_path()[0].read_text(encoding="utf-8"))
+            out = got if isinstance(got, dict) else {}
+        except Exception:   # 別支檔的程式,炸了就當沒有出處(同 _kt_decision_table 的處理)
+            out = {}
