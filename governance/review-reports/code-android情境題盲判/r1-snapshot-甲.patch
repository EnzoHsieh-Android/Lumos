+def dt_sources(text):
+    """型錄全文 → {決策表列編號: {"source": 那列「來源」格, "refs": [...], "checks": [{"id", "name", "source", "refs"}…]}}。
+    給盲判材料附出處用(Projects/Android寫法語意情境表態與盲判_計劃 範圍 4;使用者第 3 要點:來源與依據在語意盲判時輔助判別):
+    「對應檢查」每一條到型錄主表找名稱與來源欄,縮寫照〈來源縮寫〉表展開成網址。主表或縮寫表找不到時那幾格留空,不報錯
+    (讀得懂讀不懂由 dt_table 與 catalog_problems 管)。"""
+    abbrs = {}
+    i_src = text.find("\n## 來源縮寫")
+    if i_src >= 0:
+        j = text.find("\n## ", i_src + 5)
+        for ln in text[i_src:j if j >= 0 else len(text)].splitlines():
+            c = _cells(ln) if ln.startswith("|") else []
+            if len(c) >= 2 and re.fullmatch(r"[A-Z][A-Z0-9-]+", c[0]):
+                abbrs[c[0]] = c[1]
+    main = {}
+    for ln in text.splitlines():
+        m = _MAIN_ROW_RE.match(ln)
+        if m:
+            c = _cells(ln)
+            if len(c) >= 2:
+                main.setdefault(m.group(1), (c[1], c[-1]))
+    i = text.find("\n## 情境決策表")
+    if i < 0:
+        return {}
+    j = text.find("\n## ", i + 5)
+    dt = text[i:j if j >= 0 else len(text)]
+    hdr, herr = _dt_header(dt)
+    if herr:
+        return {}
+    out = {}
+    for ln in dt.splitlines():
+        if not re.match(r"^\|\s*D-\d+\s*\|", ln):
+            continue
+        c = _cells(ln)
+        if len(c) != len(hdr):
+            continue
+        src = c[hdr["來源"]]
+        checks = []
+        for cid in dict.fromkeys(re.findall(r"[A-Z]+-\d+", c[hdr["對應檢查"]])):
+            name, csrc = main.get(cid, ("", ""))
+            checks.append({"id": cid, "name": name, "source": csrc, "refs": _src_expand(csrc, abbrs)})
+        out[c[0]] = {"source": src, "refs": _src_expand(src, abbrs), "checks": checks}
+    return out
+
