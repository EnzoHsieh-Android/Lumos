+def _kappa2(pairs):
+    """二元 Cohen's kappa:pairs=[(甲判正, 乙判正)…] → kappa 或 None(沒有樣本、或任一方只有一種答案:偶然一致率會是 1 或 kappa 失去意義)。
+    kappa = (觀察一致率 − 偶然一致率)/(1 − 偶然一致率),偶然一致率 = 甲正比例×乙正比例 + 甲負比例×乙負比例
+    (https://en.wikipedia.org/wiki/Cohen%27s_kappa )。"""
+    n = len(pairs)
+    if not n or len({a for a, _b in pairs}) < 2 or len({b for _a, b in pairs}) < 2:
+        return None
+    po = sum(1 for a, b in pairs if a == b) / n
+    pa = sum(1 for a, _b in pairs if a) / n
+    pb = sum(1 for _a, b in pairs if b) / n
+    pe = pa * pb + (1 - pa) * (1 - pb)
+    return None if pe >= 1 else (po - pe) / (1 - pe)
+
