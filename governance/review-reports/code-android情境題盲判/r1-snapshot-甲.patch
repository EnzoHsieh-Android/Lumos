+def _kt_bj_check(segs, ent, cells, waived=frozenset(), branch=None):
+    """推送前的盲判核對 → ([擋下句…], 註記 {majority: [提醒…], arbiter_author: n, waived_majority: n})。
+    擋:候選列缺第一盲判、作者與第一盲判不一致又缺仲裁。不擋:仲裁同作者(記一次仲裁採作者);仲裁同第一盲判=多數判作者沒照做,
+    進 majority(呼叫端印、記提醒帳;有段放行的段只計數不提醒)。作者沒答或答案形狀不對的格不在這裡講(表態對程式那一步已擋)。"""
+    answers = {a.get("seg"): a for a in (ent or {}).get("segments") or [] if isinstance(a, dict)}
+    missing, disagree = {}, []     # missing:段 → (位置, [列…]),訊息一段一句(S8 實跑:同一段四列重複印四次位置太長)
+    notes = {"majority": [], "arbiter_author": 0, "waived_majority": 0, "followed": set()}   # followed:盲判終局判照做的(段,列)
+    for sg in segs:
+        a = answers.get(sg["seg"]) or {}
+        rows = a.get("rows") if isinstance(a.get("rows"), dict) else {}
+        where = f"{_kill_esc(sg['file'])}:{sg['start']}-{sg['end']}"
+        for rid in sg["rows"]:
+            cell = (cells.get(sg["seg"]) or {}).get(rid) or {}
+            first = cell.get("first")
+            if not isinstance(first, dict):
+                missing.setdefault(sg["seg"], (where, []))[1].append(rid)
+                continue
+            ans = rows.get(rid)
+            if not isinstance(ans, dict) or not isinstance(ans.get("applies"), bool):
+                continue
+            av, fv = _kt_bj_author_vote(ans), _kt_bj_blind_vote(first)
+            if av == fv:
+                if fv == ("applies", True):
+                    notes["followed"].add((sg["seg"], rid))
+                continue
+            arb = cell.get("arbiter")
+            if not isinstance(arb, dict):
+                disagree.append(f"段 {sg['seg']}({where})的 {rid}:作者 {_kt_bj_vote_text(av)}、第一盲判 {_kt_bj_vote_text(fv)}")
+                continue
+            if _kt_bj_blind_vote(arb) == av:
+                notes["arbiter_author"] += 1
+                if av == ("applies", True):
+                    notes["followed"].add((sg["seg"], rid))
+                continue
+            if sg["seg"] in waived:
+                notes["waived_majority"] += 1
+                continue
+            cmd = _lint_waive_cmd({"key": _KT_SIT_WAIVE_PREFIX + sg["seg"], "rule": _KT_SIT_QID, "file": _kill_esc(sg["file"])})
+            notes["majority"].append({
+                "seg": sg["seg"], "file": sg["file"], "row": rid, "variant": ans.get("variant"), "verdict": _KT_BJ_MAJORITY,
+                "text": (f"段 {sg['seg']}({where})的 {rid} 三方多數判作者沒照做:作者 {_kt_bj_vote_text(av)};"
+                         f"第一盲判 {_kt_bj_vote_text(fv)}({_kill_esc(str(first.get('reason') or ''))[:200]});"
+                         f"仲裁 {_kt_bj_vote_text(_kt_bj_blind_vote(arb))}({_kill_esc(str(arb.get('reason') or ''))[:200]})。"
+                         f"照型錄那列改碼後重表態、重判;確定這段寫對了、不想再提醒:`{cmd}`")})
+    probs = []
+    if missing:
+        n = sum(len(r) for _w, r in missing.values())
+        items = [f"段 {seg}({w})的 {'、'.join(r)}" for seg, (w, r) in missing.items()]
+        more = f";…另有 {len(items) - 6} 段" if len(items) > 6 else ""
+        probs.append(f"缺第一盲判 {n} 格({';'.join(items[:6])}{more})——{_kt_bj_howto(branch)}")
+    if disagree:
+        more = f";…另有 {len(disagree) - 6} 格" if len(disagree) > 6 else ""
+        br = f" --branch {branch}" if branch else ""
+        probs.append(f"作者與第一盲判對不上、缺仲裁 {len(disagree)} 格({';'.join(disagree[:6])}{more})——再派一個全新代理仲裁:"
+                     f"`lumos code-loop blind-judge --template --disagreements{br} > /tmp/bj-arb.json`,結果用 "
+                     f"`lumos code-loop blind-judge <結果.json> --arbiter{br}` 寫入")
+    return probs, notes
