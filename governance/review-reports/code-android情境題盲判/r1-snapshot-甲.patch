+def _kt_bj_validate(doc, segs, role, cells):
+    """盲判結果整份驗證 → ({段: {file, rows: {列: 票}}}, [錯誤句…])。有一筆不合就整份不寫(呼叫端看錯誤句)。"""
+    errs, entries = [], {}
+    if isinstance(doc, dict):
+        extra = set(doc) - {"segments"}
+        if extra:
+            errs.append(f"最外層只認 segments,多了 {sorted(extra)}")
+        lst = doc.get("segments")
+    else:
+        lst = doc
+    if not isinstance(lst, list) or not lst:
+        return {}, errs + ["要有 segments 清單(每段一筆 {seg, rows})"]
+    by = {s["seg"]: s for s in segs}
+    seen = set()
+    for i, e in enumerate(lst, 1):
+        if not isinstance(e, dict) or set(e) - {"seg", "rows"} or not isinstance(e.get("seg"), str) or not isinstance(e.get("rows"), dict) or not e["rows"]:
+            errs.append(f"segments 第 {i} 筆要是 {{seg: 段身分, rows: {{D-<n>: {{applies, followed, reason}}}}}},不准有別的欄位")
+            continue
+        sid = e["seg"]
+        if sid in seen:
+            errs.append(f"段 {_kill_esc(sid)} 在同一份檔裡出現兩次")
+            continue
+        seen.add(sid)
+        sg = by.get(sid)
+        if sg is None:
+            errs.append(f"段 {_kill_esc(sid)} 對不上被推版本的任何一段(段身分綁段材料內容,程式改過就要用新材料重判)")
+            continue
+        rows = {}
+        for rid, v in e["rows"].items():
+            tag = f"段 {sid} 的 {_kill_esc(str(rid))}"
+            if rid not in sg["rows"]:
+                errs.append(f"{tag}:不在這段的候選列({'、'.join(sg['rows'])})")
+                continue
+            if not isinstance(v, dict) or set(v) - _KT_BJ_ROW_KEYS:
+                errs.append(f"{tag}:答案要是 {{applies, followed, reason}},不准有別的欄位")
+                continue
+            if not isinstance(v.get("applies"), bool):
+                errs.append(f"{tag}:applies 要是 true 或 false")
+                continue
+            if v["applies"] and not isinstance(v.get("followed"), bool):
+                errs.append(f"{tag}:適用時 followed 要是 true 或 false")
+                continue
+            if not v["applies"] and v.get("followed") is not None:
+                errs.append(f"{tag}:不適用時不填 followed")
+                continue
+            rs = v.get("reason")
+            if not isinstance(rs, str) or not rs.strip() or len(rs) > _KT_BJ_REASON_MAX:
+                errs.append(f"{tag}:reason 要是一兩句話(不空、≤{_KT_BJ_REASON_MAX} 字)")
+                continue
+            if role == "arbiter" and not isinstance(((cells.get(sid) or {}).get(rid) or {}).get("first"), dict):
+                errs.append(f"{tag}:這一格還沒有第一盲判,仲裁沒有對象(先寫第一盲判,不帶 --arbiter)")
+                continue
+            rows[rid] = {"applies": v["applies"], **({"followed": v["followed"]} if v["applies"] else {}), "reason": rs.strip()}
+        entries[sid] = {"file": sg["file"], "rows": rows}
+    return entries, errs
