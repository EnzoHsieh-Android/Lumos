+def _kt_bj_range(repo_root, diff_range, at_sha, branch):
+    """盲判要用的改動範圍:給了就用;沒給照 code-loop check 算表態適用題的那個範圍——merge-base(主線, 版本)..版本,
+    推的就是主線或算不出來時退 _codeloop_default_base。段身分跟範圍切出的 hunk 有關,兩邊要算同一個範圍才對得上。"""
+    if diff_range:
+        return diff_range
+    import subprocess as _sp
+    ml = _mainline_ref(repo_root)
+    if ml and branch != ml[0].split("@")[0]:
+        r = _sp.run(["git", "merge-base", ml[1], at_sha], capture_output=True, text=True, errors="replace", cwd=str(repo_root))
+        mb = r.stdout.strip() if r.returncode == 0 else ""
+        if mb and mb != at_sha:
+            return f"{mb}..{at_sha}"
+    mb = _codeloop_default_base(repo_root)
+    return f"{mb}..{at_sha}" if mb and mb != at_sha else None
