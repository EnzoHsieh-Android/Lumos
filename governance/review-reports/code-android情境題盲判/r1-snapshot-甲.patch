+def _kt_bj_pick_rows(sg, mode, cells, author_rows):
+    """這一段在這個模式下要判哪幾列:None=全部候選列、"missing"=還沒有第一盲判的、"disagreements"=作者與第一盲判不一致又沒仲裁的。"""
+    rids = []
+    for rid in sg["rows"]:
+        cell = (cells.get(sg["seg"]) or {}).get(rid) or {}
+        first = cell.get("first")
+        if mode == "missing" and isinstance(first, dict):
+            continue
+        if mode == "disagreements":
+            ans = (author_rows.get(sg["seg"]) or {}).get(rid)
+            if (not isinstance(first, dict) or isinstance(cell.get("arbiter"), dict) or not isinstance(ans, dict)
+                    or not isinstance(ans.get("applies"), bool) or _kt_bj_author_vote(ans) == _kt_bj_blind_vote(first)):
+                continue
+        rids.append(rid)
+    return rids
