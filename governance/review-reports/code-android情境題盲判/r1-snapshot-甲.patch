+    except (_KtSitUnverifiable, OSError, subprocess.TimeoutExpired) as e:
+        print(f"擋下:情境段算不出來({e if isinstance(e, _KtSitUnverifiable) else e.__class__.__name__})", file=sys.stderr)
+        return 2
+    cells = _kt_bj_read(repo_root, branch)
+    if template:
