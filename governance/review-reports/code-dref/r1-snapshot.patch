+def cmd_dref_promote(env, rel_in, ref):
+    """[V6] _ai→decision_refs 抽查蓋章(升級可抑制 E2)。正規化全操作+dangling 拒+覆蓋提醒+雙欄原子。"""
+    rel = env.find(rel_in)
+    if rel is None:
+        print(f"擋下:圖譜裡找不到節點 {rel_in}", file=sys.stderr)
+        return 2
+    nn = _dref_norm(env, ref)
+    if not nn or not nn[1]:
+        print(f"擋下:ref 要寫成 <節點>#dN 且節點解得到: {ref!r}", file=sys.stderr)
+        return 2
+    tnode, did = nn
+    if not any(str(d.get("id", "")).strip() == did for d in _node_decisions(env, tnode)):
+        print(f"擋下:{tnode} 沒有決策 {did}(dangling,拒 promote——防失效 ref 蓋章洗白)", file=sys.stderr)
+        return 2
+    canon = f"{tnode}#{did}"
+    n = env.notes.get(rel)
+    in_main = [v for v in as_list(n.fields.get("decision_refs")) if _dref_same(env, v, ref)]
+    in_ai = [v for v in as_list(n.fields.get("decision_refs_ai")) if _dref_same(env, v, ref)]
+    # 冪等分支
+    if not in_ai and in_main:
+        print(f"✓ {canon} 已在正欄(冪等 no-op)")
+        return 0
+    if not in_ai and not in_main:
+        print(f"擋下:{canon} 兩欄都沒有,promote 沒對象——先 add-ai", file=sys.stderr)
+        return 2
+    # 覆蓋提醒(不擋,人裁;但不得靜默)
+    tidx = build_typed_index(env)
+    suppressed, no_id_dead = _dref_coverage_scan(env, rel, tidx)
+    other = [s for s in suppressed if not _dref_same(env, s.split("(")[0], ref)]
+    if not as_list(n.fields.get("decision_refs")) and (other or no_id_dead):
+        print("  ⚠ 覆蓋提醒:這一蓋讓正欄非空,E2 將只警告被 ref 命中的翻案決策——本節點以下翻案落後邊會被連帶靜默:")
+        for s in other:
+            print(f"      {s}(可補 ref 解)")
+        for s in no_id_dead:
+            print(f"      {s} ★連補都補不了:先 reindex 給 id、或明知會被無條件壓掉仍蓋章★")
+    # 雙欄原子:remove _ai 命中、add 正欄一份、一次寫
+    path = env.vault / rel
+    lines, s_fm, e_fm = load_raw_for_edit(path)
+    fm = lines[1:e_fm]
+    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
+    # 移 _ai 所有命中
+    if "decision_refs_ai" in struct:
+        s, e, _k = struct["decision_refs_ai"]
+        for j in range(e, s, -1):
+            if j < len(fm) and fm[j].lstrip().startswith("-") and _dref_same(env, strip_quotes(fm[j].lstrip()[1:].strip()), ref):
+                del fm[j]
+        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
+    # 加正欄(若正欄尚無命中)
+    if not in_main:
+        quoted = '"' + canon + '"'
+        if "decision_refs" in struct:
+            s, e, _k = struct["decision_refs"]
+            indent = "  "
+            for j in range(s + 1, e + 1):
+                if fm[j].lstrip().startswith("-"):
+                    indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
+                    break
+            last = e
+            while last > s and not fm[last].strip():
+                last -= 1
+            fm.insert(last + 1, f"{indent}- {quoted}")
+        else:
+            fm.append("decision_refs:")
+            fm.append(f"  - {quoted}")
+    new_lines = lines[:1] + fm + lines[e_fm:]
+
+    def _check(f):
+        main_hits = sum(1 for v in as_list(f.get("decision_refs")) if _dref_same(env, v, ref))
+        ai_hits = sum(1 for v in as_list(f.get("decision_refs_ai")) if _dref_same(env, v, ref))
+        return main_hits == 1 and ai_hits == 0
+    atomic_write_verify(path, new_lines, "decision_refs", _check)
+    print(f"✓ promote {rel}: {canon} 從 _ai 搬進正欄(升級可抑制 E2)")
+    return 0
