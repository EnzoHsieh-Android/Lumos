+def _dref_parse(ref):
+    """ref '<節點>#dN' → (節點字面, did) 或 None(格式不合)。"""
+    m = re.fullmatch(r"(.+?)#(d\d+)", str(ref).strip())
+    return (m.group(1), m.group(2)) if m else None
+
+
+def _dref_norm(env, ref):
+    """正規化 tuple (resolve(節點), did);節點解不到或格式不合→None。"""
+    pr = _dref_parse(ref)
+    if not pr:
+        return None
+    node = env.resolve(pr[0])
+    return (node, pr[1]) if node else None
+
+
+def _dref_same(env, a, b):
+    """兩 ref 是否同一決策:正規化 tuple 相等。★空-did 守衛★(r3 d-f5:did 任一空即不等,
+    照抄 E2 _hits 的 `did and` 防護——否則兩筆無 id 決策 ""=="" 誤併)。"""
+    na, nb = _dref_norm(env, a), _dref_norm(env, b)
+    if not na or not nb:
+        return False
+    return na[1] and nb[1] and na == nb
+
+
+def _node_decisions(env, rel):
+    """回某節點的 decisions list(parse_decisions on its fm)。讀不到→[]。"""
+    try:
+        path = env.vault / rel
+        lines, _s, e_fm = load_raw_for_edit(path)
+        return parse_decisions(lines[1:e_fm])
+    except (OSError, ValueError):
+        return []
+
+
+def _dref_filled(env, rel):
+    """已填集合=decision_refs ∪ decision_refs_ai 的正規化 tuple(略去解不到的)。"""
+    n = env.notes.get(rel)
+    if not n:
+        return set()
+    out = set()
+    for fld in ("decision_refs", "decision_refs_ai"):
+        for r in as_list(n.fields.get(fld)):
+            nn = _dref_norm(env, r)
+            if nn and nn[1]:
+                out.add(nn)
+    return out
+
+
+def _dref_candidates(env, rel, tidx):
+    """★共用候選產生函式★(backlog/candidates 同口徑,r1 ext-f2)。
+    回 (cands, skipped_no_id):cands=[(target_rel, did, content, valid)],三具名邊 fwd 解到的
+    節點的所有決策(含已翻案=E3 要抓),只列有 id;無 id 計數。正規化元素=(target_rel, did)。"""
+    cands, skipped = [], 0
+    fwd = tidx["fwd"].get(rel, {})
+    seen = set()
+    for etype in TYPED_EDGE_FIELDS:
+        for trel in fwd.get(etype, []):
+            for d in _node_decisions(env, trel):
+                did = str(d.get("id", "")).strip()
+                if not did:
+                    skipped += 1
+                    continue
+                key = (trel, did)
+                if key in seen:
+                    continue
+                seen.add(key)
+                cands.append((trel, did, first_line(str(d.get("content", "")), 60),
+                              d.get("valid", True)))
+    return cands, skipped
+
