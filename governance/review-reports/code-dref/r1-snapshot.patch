+def cmd_dref_add_ai(env, rel_in, ref):
+    """[V3] 寫 decision_refs_ai:存在性驗證+正規化冪等(已在正欄→no-op)。"""
+    rel = env.find(rel_in)
+    if rel is None:
+        print(f"擋下:圖譜裡找不到節點 {rel_in}", file=sys.stderr)
+        return 2
+    nn = _dref_norm(env, ref)
+    if not nn or not nn[1]:
+        print(f"擋下:ref 要寫成 <節點>#dN 且節點解得到: {ref!r}", file=sys.stderr)
+        return 2
+    tnode, did = nn
+    if not any(str(d.get("id", "")).strip() == did for d in _node_decisions(env, tnode)):
+        print(f"擋下:{tnode} 沒有決策 {did}(dangling ref,拒寫)", file=sys.stderr)
+        return 2
+    n = env.notes.get(rel)
+    # 已在正欄(正規化命中)→ no-op(不重複塞 ai 欄)
+    for r in as_list(n.fields.get("decision_refs")):
+        if _dref_same(env, r, ref):
+            print(f"✓ {ref} 已在 decision_refs 正欄(human 確認過),不重複塞 ai 欄")
+            return 0
+    for r in as_list(n.fields.get("decision_refs_ai")):
+        if _dref_same(env, r, ref):
+            print(f"✓ {ref} 已在 decision_refs_ai(冪等 no-op)")
+            return 0
+    canon = f"{tnode}#{did}"
+    _append_decision_ref(env, rel, "decision_refs_ai", canon)
+    print(f"✓ add-ai {rel}: decision_refs_ai += {canon}(標 by:ai;E3 firing 生效、抑制不了 E2)")
+    return 0
