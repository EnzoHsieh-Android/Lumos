+def _dref_coverage_scan(env, rel, tidx):
+    """[promote 覆蓋提醒] E2 對齊掃描:該節點指向的翻案決策中、正欄無 ref 命中的落後邊。
+    回 (suppressed_with_id, no_id_dead):有 id 的用 _dref_same 判正欄命中;無 id 的另列(連補都補不了)。"""
+    n = env.notes.get(rel)
+    正欄 = as_list(n.fields.get("decision_refs")) if n else []
+    suppressed, no_id_dead = [], []
+    fwd = tidx["fwd"].get(rel, {})
+    seen = set()
+    for etype in _DREF_E2_FIELDS:   # 排 related,對齊 E2 typed_in
+        for trel in fwd.get(etype, []):
+            for d in _node_decisions(env, trel):
+                if d.get("valid", True):   # 只看翻案(valid:false)決策
+                    continue
+                did = str(d.get("id", "")).strip()
+                content = first_line(str(d.get("content", "")), 50)
+                if not did:
+                    key = (trel, content)
+                    if key not in seen:
+                        seen.add(key)
+                        no_id_dead.append(f"{trel}(翻案「{content}」,無 id)")
+                    continue
+                ref = f"{trel}#{did}"
+                if (trel, did) in seen:
+                    continue
+                seen.add((trel, did))
+                if not any(_dref_same(env, r, ref) for r in 正欄):
+                    suppressed.append(f"{ref}(翻案「{content}」)")
+    return suppressed, no_id_dead
+
