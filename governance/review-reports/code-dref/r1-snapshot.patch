+def cmd_dref_candidates(env, rel_in, as_json=False):
+    """[V2] 列某節點候選決策(含翻案),讀側去重已填,附 skipped_no_id。"""
+    import json as _j
+    rel = env.find(rel_in)
+    if rel is None:
+        print(f"擋下:圖譜裡找不到節點 {rel_in}", file=sys.stderr)
+        return 2
+    tidx = build_typed_index(env)
+    cands, skipped = _dref_candidates(env, rel, tidx)
+    filled = _dref_filled(env, rel)
+    n = env.notes.get(rel)
+    summary = first_line(str((n.fields.get("summary") if n else "") or ""), 80)
+    out_rows = []
+    for trel, did, content, valid in cands:
+        already = (trel, did) in filled
+        out_rows.append({"ref": f"{trel}#{did}", "content": content,
+                         "valid": bool(valid), "already_filled": already})
+    if as_json:
+        print(_j.dumps({"node": rel, "summary": summary, "candidates": out_rows,
+                        "skipped_no_id": skipped}, ensure_ascii=False))
+    else:
+        print(f"節點 {rel}:{summary}")
+        for r in out_rows:
+            flag = " [已填]" if r["already_filled"] else ("" if r["valid"] else " [已翻案]")
+            print(f"  {r['ref']}{flag}  {r['content']}")
+        if skipped:
+            print(f"  (略過 {skipped} 條無 id 決策——先 reindex 才能被 ref)")
+        if not out_rows:
+            print("  (無結構可達候選決策)")
+    return 0
