+def cmd_dref_backlog(env, as_json=False):
+    """[V1] 列該跑 suggest 的節點:候選集 − 已填 ≠ 空(正規化 tuple 集合差)。"""
+    import json as _j
+    tidx = build_typed_index(env)
+    rows, omitted_all_no_id = [], 0
+    for rel in sorted(env.notes):
+        cands, skipped = _dref_candidates(env, rel, tidx)
+        if not cands:
+            if skipped:
+                omitted_all_no_id += 1
+            continue
+        cand_set = {(c[0], c[1]) for c in cands}
+        filled = _dref_filled(env, rel)
+        unfilled = cand_set - filled
+        if unfilled:
+            rows.append({"node": rel, "unfilled": len(unfilled), "candidates": len(cand_set)})
+    if as_json:
+        print(_j.dumps({"backlog": rows, "omitted_all_no_id": omitted_all_no_id}, ensure_ascii=False))
+    else:
+        if not rows:
+            print("backlog 空:結構可達的候選都已填(或無候選)")
+        for r in rows:
+            print(f"  {r['node']}  未填 {r['unfilled']}/{r['candidates']}")
+        if omitted_all_no_id:
+            print(f"  (另有 {omitted_all_no_id} 個節點候選決策全無 id、悄悄不列——是漏 reindex 還是真沒關聯?先 lumos decision-reindex --all)")
+    return 0
