+def cmd_dref_prune(env, rel_in, ref, by=None):
+    """[V5] 移除 ref(正規化定位)。--by 移該欄、無 --by 兩欄都移。區分真移除/本來不在。"""
+    rel = env.find(rel_in)
+    if rel is None:
+        print(f"擋下:圖譜裡找不到節點 {rel_in}", file=sys.stderr)
+        return 2
+    n = env.notes.get(rel)
+    flds = ["decision_refs"] if by == "human" else ["decision_refs_ai"] if by == "ai" \
+           else ["decision_refs", "decision_refs_ai"]
+    removed = []
+    for fld in flds:
+        for v in list(as_list(n.fields.get(fld))):
+            if _dref_same(env, v, ref):
+                if _dref_remove_ref(env, rel, fld, v):
+                    removed.append(f"{fld}:{v}")
+    if removed:
+        print(f"✓ prune {rel}: 已移除 {', '.join(removed)}")
+    else:
+        print(f"✓ prune {rel}: 這條 ref 本來就不在(是不是打錯正規形?用 decision-refs list 對一下)")
+    return 0
+
+
+def _dref_remove_ref(env, rel, field, exact_val):
+    """從 field 移除一筆逐字等於 exact_val 的 list 項(atomic_write_verify)。回 True=移除。"""
+    path = env.vault / rel
+    lines, s_fm, e_fm = load_raw_for_edit(path)
+    fm = lines[1:e_fm]
+    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
+    if field not in struct:
+        return False
+    s, e, kind = struct[field]
+    target_j = None
+    for j in range(s + 1, e + 1):
+        if fm[j].lstrip().startswith("-") and strip_quotes(fm[j].lstrip()[1:].strip()) == exact_val:
+            target_j = j
+            break
+    if target_j is None:
+        return False
+    del fm[target_j]
+    new_lines = lines[:1] + fm + lines[e_fm:]
+    atomic_write_verify(path, new_lines, field,
+                        lambda f: all(str(x).strip() != exact_val for x in as_list(f.get(field))))
+    return True
+
