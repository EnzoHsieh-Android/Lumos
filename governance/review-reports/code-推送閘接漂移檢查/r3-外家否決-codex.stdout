def _drift_cat(root, where, paths, timeout):
    """批次讀那個提交裡的這幾支檔,回同順序的 bytes|None;git 跑不起來回 None。★用列檔時記下的內容編號讀★,
    不用「版本:路徑」:樹清單把路徑轉成 NFC 了,git 裡存的可能是 NFD、兩種混用、或相容表意字(NFC 與 NFD 都會把它換掉),
    用路徑讀永遠讀不到;路徑含換行時批次讀也整批失敗(代碼審 r2 外家席、r3 正確性席、邊界席;r2 的 NFD 重讀補不到混用
    與相容表意字,還多開一次行程、沿用整段逾時——r3 併發席、外家席、架構對齊席)。查不到編號的才退回用路徑讀。"""
    oids = _drift_oids(root, where)
    return _nodehome_cat_blobs(root, [oids.get(p) or f"{where}:{p}" for p in paths], timeout=timeout)


def _drift_cond_split(v):
    """symbol/test 條件的值 → (路徑或空字串, 名稱)。判定、預讀、候選篩選、判不了的點名共用這一支
    (代碼審 r5 架構對齊席:原本四處各自 rsplit,點名的範圍跟判定的範圍連三輪對不上)。"""
    path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
    return path.strip(), name.strip()


def _drift_status_target(env, v):
    """status 條件 → (指到的筆記相對路徑或 None, 筆記或 None, 允許的狀態集合)。判定與點名共用。"""
    node, _eq, vals = v.partition("=")
    rel = env.resolve(link_target(node.strip())) if env is not None else None
    return rel, (env.notes.get(rel) if rel else None), {x.strip() for x in vals.split("|")}


_DRIFT_EMPTY_TREE = {}


def _drift_empty_tree(root):
    """這個 repo 的空樹編號:SHA-256 的 repo 跟 SHA-1 的不一樣(代碼審 r5 外家席、正確性席:寫死 SHA-1 的空樹,
    SHA-256 repo 首推時 git diff 認不得、一律判不了)。算不出來退回 SHA-1 那個。全工具其他閘的同一個問題另開 Issue。"""
    import subprocess as _sp
    key = str(root)
    if key not in _DRIFT_EMPTY_TREE:
        try:    # 明確餵空輸入:在推送掛鉤裡繼承標準輸入會去讀掛鉤自己的 ref 清單
            r = _sp.run(["git", "-C", key, "hash-object", "-t", "tree", "--stdin"], input=b"", capture_output=True, timeout=20)
            got = r.stdout.decode("ascii", "replace").strip() if r.returncode == 0 else ""
        except (OSError, _sp.TimeoutExpired):
            got = ""
        _DRIFT_EMPTY_TREE[key] = got if _LENS_SHA_RE.fullmatch(got) else _EMPTY_TREE_SHA
    return _DRIFT_EMPTY_TREE[key]


class _DriftNames:
    """幾支檔全文的識別字集合(用 \\w+ 切),名稱查集合;不是一般識別字的名稱才對原文跑正則。
    逐支檔建集合,不先把全文接成一大段(r4 併發席:接起來再整批切,尖峰記憶體是文字的 10 倍以上)。
    partial:有檔讀不出——這時「找到」照算,「找不到」要當判不了(r4 外家席:原本有一支讀不出就整份作廢,
    另一支已經確定命中的也被降成判不了)。"""

    def __init__(self, texts, partial=False):
        self.texts, self.partial, self._set, self._text = texts, partial, set(), None
        for t in texts:
            self._set.update(re.findall(r"\w+", t))

    def has(self, name):
        """名稱出不出現在全文(整字)。一般識別字查集合;帶標點的(foo-bar)先看它的每個字詞都在集合裡,
        都在才對全文跑一次正則,全文也只接一次(代碼審 r5 外家席:原本每條都接全文再掃,幾百條就耗光預算)。"""
        if re.fullmatch(r"\w+", name):
            return name in self._set
    if lst is None:
        return None
    return _DriftProbeTree(root, where, set(lst[0]), _nodehome_layout(lst[1]), deadline)


def _drift_probe_one(tree, env, k, v):
    """一個條件 → True / False / None(判不了)。status 只看筆記(env),不需要 git——不是 git 專案也判得了
    (代碼審 r1 正確性席);指到的筆記讀不出來算判不了(外家席:原本當成不成立,靜默放行)。"""
    if k == "status":
        _rel, n, want = _drift_status_target(env, v)
        if n is not None and _note_unreadable(n):
            return None
        return n is not None and _drift_str(n, "status") in want
    return None if tree is None else tree.one(k, v)


def _drift_probe_line(tree, env, conds):
    """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
    vals = [_drift_probe_one(tree, env, k, v) for k, v in conds]
    if any(x is False for x in vals):
        return False
    return None if any(x is None for x in vals) else True


def _drift_probe_changes(root, base, tip, deadline=None):
    """範圍裡的改動(只算一次 name-status)→ {touched: 改到的路徑(改名兩端都算), renames: 改名 新→舊,
    code_touched: 改到的程式與測試檔, code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗或預算用完回 None。
    解析用共用的 _nodehome_name_status(代碼審 r1 架構對齊席:原本手刻第二份);筆記改名也從這一次拿(圖譜一致席:
    原本另起一次 git)。不帶路徑的條件改看 code_touched 在終點的全文(_drift_probe_is_candidate),不再算新增行。"""
    import time as _t
    if deadline is not None and _t.monotonic() >= deadline:
        return None
    raw = _ns_git(root, "diff", "--name-status", "-z", "-M", base or _drift_empty_tree(root), tip)
    if raw is None:
        return None
    codes = {}
    touched, renames, _gone = _nodehome_name_status(raw, codes=codes)
    shape = any(c in ("A", "D", "R", "C") and _drift_probe_code_path(p) for p, c in codes.items())
    return {"touched": touched, "renames": renames, "code_shape": shape,
            "code_touched": sorted(p for p in touched if _drift_probe_code_path(p))}


def _drift_probe_is_candidate(conds, ch, vault_pre, tenv, tip_text):
    """這一行的條件會不會被這次推送改變結果(計劃〈做法〉第 0 節,篩選單位是行)→ True / False / None(判不了)。
    不帶路徑的 symbol/test:名稱出現在這次改到的程式或測試檔的★終點全文★就是候選(tip_text() → 那幾支的全文或 None)。
    ★為什麼不只看新增行★(代碼審 r2 正確性席):判定改用 ast、沒副檔名的 #! 腳本也算程式檔之後,「定義在不在」
    可以在名稱那一行沒動的情況下翻轉——只刪掉包住 def 的三引號、只在第一行加 #!。要處理只看終點成立,
    所以只要終點全文;順便省掉原本算新增行的那次 diff(標了 -diff 屬性的檔看不見新增行的坑也一起沒了)。
    tip_text() → _DriftNames(終點全文的識別字集合,名稱是一般識別字時查集合,不再對幾 MB 的字串逐條跑正則——
    代碼審 r3 併發席實測 100 行條件 10 秒)或 None。"""
    hits = [_drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text) for k, v in conds]
    # 任一確定受影響就是候選;判不了的不提前停(代碼審 r3 外家席:原本前一個判不了就回判不了,後面確定受影響的
    # 那條本來可以列成可表態的發現)
    if any(hits):
        return True
    return None if any(h is None for h in hits) else False
