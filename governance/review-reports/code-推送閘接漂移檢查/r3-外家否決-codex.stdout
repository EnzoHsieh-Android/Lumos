name: CI
# 獨立信任根(2026-07-29 Codex 外審 P0):本機 hooks 可繞(--no-verify;沒有 scripts/lumos 的 repo 降級放行),
# 這裡是 push 後必跑的後盾——pre-push 提示裡的「CI 仍會抓」由本 workflow 兌現。
on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 45   # 2026-09-12:全套單行程跑到 30 分被砍(前幾次 25–27 分,一路逼近上限);切片後約 10 分,上限留餘裕
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # code-loop gate 要算 before..sha 的 diff(體檢 #5)
      - uses: actions/setup-python@v5
        with:
          python-version: "3.14"   # 2026-09-29 工具最低版本改 3.14(Projects/最低Python版本改3.14_計劃)
      - name: Compile check
        run: python -m compileall -q scripts/lumos scripts/test_lumos.py
      # 2026-09-29 [S7]:scripts/lumos 等三類檔必須 3.9 還能解析,舊版啟動時才跑得到開頭的版本檢查
      # (Projects/最低Python版本改3.14_計劃 做法第 2、7 點)。這裡的 python 是 3.14,拿它編譯擋不到 3.12 才合法的
      # f-string 寫法,所以裝釘死版本的 ruff、以 py39 為目標只查語法錯誤——ruff 只在 CI 當工具裝,不是工具鏈的依賴。
      - name: 3.9 語法守衛
        run: |
          python -m pip install --quiet ruff==0.16.7
          ruff check --isolated --target-version py39 --select E9 scripts/lumos scripts/merge-claude-settings.py scripts/hooks/claude/*.py
      - name: SyntaxWarning 歸零閘
        run: python -W error::SyntaxWarning -c "compile(open('scripts/lumos').read(),'lumos','exec'); compile(open('scripts/test_lumos.py').read(),'t','exec')"
      # 2026-09-12:全套在 CI 單行程跑要 25–30 分鐘,已經撞到 job 上限被砍(8a45751b)。
      # 推送前掛鉤早就把它切成幾片同時跑,CI 照同一支旗標切——不改測試內容、只改跑法;
      # 任何一片紅就整步紅,而且把每一片的尾端印出來(不然只看得到「有片紅了」)。
      # 2026-09-18(Enzo 裁「像這種改動 CI 可以跳過吧,跟程式碼無關」):push 事件先問 lumos 這段推送改到什麼——
      # 只改到 README/docs/assets 這類文件(pitfalls --json 的 suite=docs)就只跑文件子集(原始碼提到那些路徑的測試);
      # 碰到程式、skills、workflow 任何一支都跑全套。判不出來(首推、force-push 對不到起點、lumos 出錯)一律全套——
      # 保守方向是多跑,不是少跑。pull_request 事件沒有 before,也是全套。
      - name: 這次推送要跑哪個測試範圍
        id: suite
        env:
          BEFORE: ${{ github.event.before }}
          SHA: ${{ github.sha }}
        run: |
          suite=full; why="不是 push 事件或起點對不到"
          if [ "${{ github.event_name }}" = push ] && [ -n "$BEFORE" ] && [ "$BEFORE" != "0000000000000000000000000000000000000000" ] \
             && git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
            out="$(python scripts/lumos pitfalls --diff "$BEFORE..$SHA" --no-lint --json --repo . 2>/dev/null || true)"
            s="$(printf '%s' "$out" | python -c 'import json,sys; d=json.load(sys.stdin); print(d.get("suite","full")); print(d.get("suite_reason","")); print("graph" if d.get("suite_graph") else "")' 2>/dev/null || printf 'full\nlumos 算不出來\n')"
            suite="$(printf '%s' "$s" | sed -n 1p)"; why="$(printf '%s' "$s" | sed -n 2p)"; graph="$(printf '%s' "$s" | sed -n 3p)"
            [ "$suite" = docs ] || suite=full
          fi
          echo "suite=$suite" >> "$GITHUB_OUTPUT"
          echo "graph=$graph" >> "$GITHUB_OUTPUT"
          echo "測試範圍:$suite($why)"
      - name: Full test suite (切 4 片同時跑;純文件推送只跑文件子集)
        env:
          SUITE: ${{ steps.suite.outputs.suite }}
          GRAPH: ${{ steps.suite.outputs.graph }}
        run: |
          set -u
          rc=0
          extra=""
          if [ "$SUITE" = docs ]; then extra="--suite docs"; echo "純文件推送:只跑文件子集(--suite docs),不跑全套"; fi
          if [ "$SUITE" = docs ] && [ "$GRAPH" = graph ]; then extra="$extra --graph"; echo "含圖譜筆記:加跑讀真圖譜的測試(--graph)"; fi
          for i in 1 2 3 4; do
            python scripts/test_lumos.py --shard "$i/4" $extra > "/tmp/shard-$i.log" 2>&1 &
          done
          for job in $(jobs -p); do wait "$job" || rc=1; done
          for i in 1 2 3 4; do
            echo "===== 第 $i 片 ====="
            # 紅的時候先把失敗那幾行撈出來——tail 只看得到尾巴,而紅的那支通常在中間,
            # 以前紅了要靠猜是哪一支(2026-09-15 實際踩到:CI 紅、本機全綠、查不出名字)
            if grep -qE "^  ✗|, [1-9][0-9]* failed" "/tmp/shard-$i.log"; then
              echo "--- 這一片紅了,以下是失敗的斷言與所在測試 ---"
              grep -nE "^  ✗|EXCEPTION" "/tmp/shard-$i.log" | tail -40 || true
              echo "--- 失敗處前後文 ---"
              # ★這裡的 || true 不是裝飾★(2026-09-15 審查席抓到):撈不到就回非零,
              # 目前這步的殼是 bash -e 沒有 pipefail、管線末端是 while 所以不會中止;
              # 但只要有人把這步改成 shell: bash(預設帶 pipefail),沒接住就會★整步當場死掉★,
              # 連還沒印的片都一起失聲,比改動前更糟。實測過兩種殼,差別就在這個旗標。
              # 另外要認得逾時/零斷言/跳過判紅——那三種紅不印 FAILED 也不印 EXCEPTION,
              # 而它們正是「CI 紅、本機綠」最常見的成因,漏掉等於在最該用的場合失效。
              grep -nE "^  ✗ (FAILED|TIMEOUT|判紅)|EXCEPTION|^  ✗ .*一條斷言都沒有" \
                "/tmp/shard-$i.log" | head -3 | cut -d: -f1 | while read ln; do
                sed -n "$((ln>12 ? ln-12 : 1)),$((ln+3))p" "/tmp/shard-$i.log"
