    「家」是標記不是種類:一篇本來就因為直接相依進來、又剛好是這支檔的家,它的 kind 還是 direct。
    對讀派工單的人來說「這篇管這支檔」比「這篇有提到這支檔」重要,所以家優先顯示。
    """
    # ★事故不能被蓋掉★:一篇既是家、又出過事故,讀派工單的人最需要知道的是「這裡出過事」
    # ——所以兩個都印(代碼審 r1 正確性席)。
    base = _LENS_KIND.get(v.get("kind"), None)
    if not v.get("home"):
        return base
    return f"{base}·{_LENS_KIND['home']}" if base and v.get("kind") == "incident" else _LENS_KIND["home"]


def _lens_range_ok(diff_range):
    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
        return None
    parts = diff_range.split("..")
    if len(parts) != 2 or not parts[0] or not parts[1]:
        return None
    if any(ch.isspace() for ch in diff_range):
        return None
    return parts[0], parts[1]


_ZERO_SHA_RE = re.compile(r"0{40}|0{64}")          # SHA-1 與 SHA-256 專案的全零(筆記內容審代碼審 r3 兩席)


def _lens_push_base(repo_root, a, tip):
    """推送範圍的起點 → (起點 sha 或 None, 說明)。None=這次沒有新東西、不用查。
    起點是 40 個 0(GitHub 對新分支首推給的 before)或本機找不到(force-push 後的舊頂端)時:頂端落後或等於主線(本地主分支
    的 upstream)頂端就沒有新東西;其他從跟主線的分岔點算;連主線都找不到才用空樹(筆記形狀擋與每支檔有家之後截到上線點;
    代碼審那道照它原本拿到空樹的做法)。
    ★頂端等於主線頂端也算沒有新東西★:代碼審 r2 曾改成「從上線點起全查」想擋 force-push 改寫主線,r3 查出它讓零提交的新分支
    被主線舊帳誤擋、代碼審那道整庫當新增、而且 force-push 後再推一次照樣漏——「繞過本機掛鉤又 force-push 改寫主線」是存心繞過,
    跟筆記內容審只防疏忽同一條線,不在這道後盾要防的範圍(呼叫端回 None 時記一筆 skipped 帳,事後看得到)。
    ★不能直接回「範圍找不到、放行」★:照 doctor 給的 CI 步驟貼的消費專案,新分支首推會整批放過(2026-09-28 漏網
    ESC-61fc2d87);★也不能一律當空樹★:新分支開在主線頂端時會把主線上線後的舊帳當新增誤擋(同一件事的代碼審)。
    明寫空樹的起點照原意(從空樹比)。筆記形狀擋與每支檔有家共用這支。"""
    if a == _EMPTY_TREE_SHA:
        return a, ""
    if not _ZERO_SHA_RE.fullmatch(a or ""):
        s = _lens_full_sha(repo_root, a)
        if s is not None:
            return s, ""
    why = "新分支首推" if _ZERO_SHA_RE.fullmatch(a or "") else "起點在本機找不到"
    ml = _mainline_ref(repo_root, remote_only=True)
    if ml:
        anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
        if anc is not None and anc.returncode == 0:
            return None, f"{why},而且頂端已在主線({ml[0]})上——沒有新東西"
        mb = _lens_git(repo_root, "merge-base", tip, ml[1])
        if mb is not None and mb.returncode == 0 and mb.stdout.strip():
            return mb.stdout.strip(), f"{why}:從跟主線({ml[0]})的分岔點算"
    return _EMPTY_TREE_SHA, f"{why}:找不到主線,從空樹算(截到上線點)"


def _push_mainline_branch(repo_root, cand, remote):
    """主線候選指到的分支短名(判「就是這次被推的那條」用);判不出回 None。
    遠端 HEAD 用 symbolic-ref 解出它指的分支;X@{upstream} 用 rev-parse --symbolic-full-name 解,再去掉那條本地分支設定的遠端名。"""
    if cand.startswith("refs/remotes/"):
        if cand.endswith("/HEAD"):
            r = _lens_git(repo_root, "symbolic-ref", "-q", cand)
            if r is None or r.returncode != 0:
                return None
            full = r.stdout.strip()
        else:
            full = cand
        pre = f"refs/remotes/{remote}/"
        return full[len(pre):] if remote and full.startswith(pre) else None
    local = cand.split("@{", 1)[0]
    r = _lens_git(repo_root, "rev-parse", "--symbolic-full-name", cand)
    if r is None or r.returncode != 0:
        return None
    full = r.stdout.strip()
    if full.startswith("refs/heads/"):          # upstream 設成本機另一條分支(branch.X.remote = .)
        return full[len("refs/heads/"):]
    rm = _lens_git(repo_root, "config", "--get", f"branch.{local}.remote")
    pre = f"refs/remotes/{rm.stdout.strip()}/" if (rm is not None and rm.returncode == 0 and rm.stdout.strip()) else None
    return full[len(pre):] if pre and full.startswith(pre) else None


def _push_mainline(repo_root, remote, pushed_ref):
    """推送的主線 → (候選名, sha) 或 None。依序:遠端宣告的預設分支(refs/remotes/<遠端>/HEAD)→ main@{upstream}
    → master@{upstream} → <遠端>/main → <遠端>/master;沒給遠端名就跳過帶遠端的候選。
    ★跳過「就是這次被推的那條分支」★:推主線本身時,掛鉤裡 main@{upstream} 還是舊值、CI 裡 origin/main 已經等於頂端,
    拿它當主線會在 CI 判成「頂端已在主線、沒有新東西」整步跳過——跳過後兩邊都走「沒有別的主線、用遠端舊值」。
    指到哪條分支判不出來(遠端 HEAD 不是捷徑、upstream 的遠端名讀不到)就不跳過。"""
    pushed = pushed_ref[len("refs/heads/"):] if (pushed_ref or "").startswith("refs/heads/") else None
    cands = ([f"refs/remotes/{remote}/HEAD"] if remote else []) + ["main@{upstream}", "master@{upstream}"] \
        + ([f"refs/remotes/{remote}/main", f"refs/remotes/{remote}/master"] if remote else [])
    for cand in cands:
        sha = _lens_full_sha(repo_root, cand)
        if not sha:
            continue
        if pushed is not None and _push_mainline_branch(repo_root, cand, remote) == pushed:
            continue
        return cand, sha
    return None


def _push_range_start(repo_root, old, tip, remote, pushed_ref):
    """推送前掛鉤與 CI 的範圍起點 → (起點 sha 或 None, 說明)。None=頂端已在主線上、沒有新東西。
    old 是遠端舊值(40/64 個 0=新分支首推;本機可能找不到=force push 蓋掉的舊頂端),remote 是推送的遠端名,
    pushed_ref 是遠端那一側的 ref(refs/heads/X、refs/tags/Y)。
    ★起點只在這裡算一處★(推送閘接漂移檢查代碼審 r2:掛鉤的 bash、CI 的 shell 補法、工具端各算一份,三份各有洞):
    - 主線照 _push_mainline 找;找不到:舊值找得到用舊值;舊值全 0 從空樹算;舊值找不到退到頂端的第一個父提交
      (沒有父提交從空樹),只查最後一個提交——說明照實講。
    - 找到主線:頂端是主線的祖先(或相等)→ None;`merge-base --all` 沒有 → 同找不到主線;
      舊值找得到而且**每一個**合併基底都是舊值的祖先 → 用舊值(一般增量推送);否則用第一個不是舊值祖先的合併基底
      (功能分支合過主線、重定基底、交叉合併:用舊值的話 `舊..新` 會把合進來的主線提交——別人的轉正——算成這次的;
      只看 git 挑的那一個基底,交叉合併時會挑到舊值那個而退回原樣範圍)。舊值不在時用第一個基底。"""
    if old == _EMPTY_TREE_SHA:
        return old, "起點是空樹,從空樹比"
    zero = bool(_ZERO_SHA_RE.fullmatch(old or ""))
    old_sha = None if zero else _lens_full_sha(repo_root, old)

    def _no_mainline(why):
        if old_sha:
            return old_sha, f"{why},用遠端舊值 {old_sha[:12]} 當起點"
        if zero:
            return _EMPTY_TREE_SHA, f"{why},新分支首推:從空樹算(截到上線點)"
        par = _lens_full_sha(repo_root, f"{tip}^1")
        if par:
            return par, f"{why},遠端舊值在本機找不到:從頂端的第一個父提交 {par[:12]} 算,只查最後一個提交"
        return _EMPTY_TREE_SHA, f"{why},遠端舊值在本機找不到、頂端沒有父提交:從空樹算"

    ml = _push_mainline(repo_root, remote, pushed_ref)
    if ml is None:
        return _no_mainline("找不到主線(遠端預設分支、main/master 的 upstream、遠端 main/master 都沒有,或就是這次推的分支)")
    anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
    if anc is not None and anc.returncode == 0:
        return None, f"頂端已在主線({ml[0]})上——沒有新東西"
    mb = _lens_git(repo_root, "merge-base", "--all", tip, ml[1])
    bases = [b for b in (mb.stdout.split() if (mb is not None and mb.returncode == 0) else []) if _LENS_SHA_RE.match(b)]
    if not bases:
        return _no_mainline(f"跟主線({ml[0]})沒有共同祖先")
    if old_sha:
        return _push_pick_base(repo_root, bases, old_sha, ml[0])
    what = "新分支首推" if zero else "遠端舊值在本機找不到"
    return bases[0], f"{what}:從跟主線({ml[0]})的分岔點 {bases[0][:12]} 算"


def _push_pick_base(repo_root, bases, old_sha, ml_name):
    """遠端舊值找得到時:每一個合併基底都是舊值的祖先(或相等)→ 用舊值;否則用第一個不是舊值祖先的基底。
    git 判不了(逾時)的基底當成不是祖先——寧可多查自己上次推過的,也不把舊值之後主線合進來的算成這次的。"""
    for b in bases:
        r = _lens_git(repo_root, "merge-base", "--is-ancestor", b, old_sha)
        if r is None or r.returncode != 0:
            return b, f"遠端舊值跟主線({ml_name})分岔(合過主線或重定基底):從分岔點 {b[:12]} 算"
    return old_sha, f"一般增量推送:從遠端舊值 {old_sha[:12]} 算"


def _lens_git(repo_root, *args, quote=False, binary=False):
    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
    import subprocess as _sp
    cmd = ["git", "-C", str(repo_root)]
    if quote:
        cmd += ["-c", "core.quotePath=false"]
    try:
        if binary:
            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
    except (OSError, _sp.TimeoutExpired):
        return None


def _lens_full_sha(repo_root, rev):
    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
    if r is None or r.returncode != 0:
        return None
    sha = r.stdout.strip()
    return sha if _LENS_SHA_RE.match(sha) else None


def _mainline_ref(repo_root, remote_only=False):
    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
    拿它當「已在主線上」會把整批都排除掉)。"""
    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
        sha = _lens_full_sha(repo_root, cand)
        if sha:
#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Enzo Hsieh
# SPDX-License-Identifier: MIT
# MIT licensed. Full text: scripts/lumos header, or LICENSE at
# https://github.com/EnzoHsieh-Android/Lumos
# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
#
# 為什麼需要:
#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
#
# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
#
# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# ── stdin 必須最先讀(prepush範圍修法 #1)──
# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
_PP_LINES=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
done

_ZERO="0000000000000000000000000000000000000000"
_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"

# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
pp_range_for() {
  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    printf '%s..%s' "$_EMPTY_TREE" "$2"
  else
    printf '%s..%s' "$1" "$2"
  fi
}

# 會擋的閘「rc1 擋、其他非零放行」,但回傳碼 128 以上是被訊號殺掉(多半是 Ctrl-C)——那不是工具錯誤,不能當成放行往下跑。
# 每支檔有家、筆記形狀擋、雙向門放行、code-loop check、存量漂移檢查都先過這一支(推送閘接漂移檢查代碼審 r2 架構對齊席:
# 原本只有漂移那道會停)。$1=回傳碼 $2=閘名。
pp_stop_if_signaled() {
  if [[ "$1" -ge 128 ]]; then
    echo "$2被中斷(rc=$1),推送停下,後面的檢查不跑。" >&2
    exit "$1"
  fi
}

# 推送的遠端名(git 傳給掛鉤的第一個參數;直接推網址時是網址、手動跑時是空的)——存量漂移檢查拿它找主線。
_PP_REMOTE="${1:-}"

# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
pp_touched_file() {
  local _f _r
  [[ -n "$_EMPTY_TREE" ]] || return 0
  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
  _f="$_PP_TMP/touched.txt"
  : > "$_f" 2>/dev/null || return 0
  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    read -r _ _lsha _ _rsha <<< "$_ppl"
    [[ "$_lsha" == "$_ZERO" ]] && continue
    _r="$(pp_range_for "$_rsha" "$_lsha")"
    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
  done
  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
}

# 沒有 scripts/lumos → 降級放行(不為缺環境 brick push,CI 兜底);有 lumos 卻找不到 Python 3.14 → 擋下
# (Projects/最低Python版本改3.14_計劃 做法第 3 點;PY 在下面讀完設定後才決定)
GRAPHCTL="$REPO_ROOT/scripts/lumos"
PY=""
# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
# LUMOS_PYTHON 有設就先試它:找不到時的說明叫人設它,第一步就不能不認。只收絕對路徑、而且真的是 python
# (post-commit 直接把程式交給它跑,不經 lumos 驗;設成 /usr/bin/true 會假成功、漏寫跳過帳);不合格就記下原因往下找,
# 版本夠不夠仍由 lumos 判。LUMOS_PYTHON 被略過、改用別支時當場印原因與後果:lumos 自己只認 LUMOS_PYTHON,
# 之後的檢查會因同一個值擋下(代碼審 r3、r4;印在這段裡,七個呼叫端不必各寫一份)。
_lumos_any_python() {
  if _lumos_any_python_find; then
    if [ -n "$_LUMOS_ANY_NOTE" ]; then
      printf '%s改用 %s;但 lumos 只認 LUMOS_PYTHON,之後提交與推送前的檢查會因這個值擋下——修正它或 unset LUMOS_PYTHON。\n' \
        "$_LUMOS_ANY_NOTE" "$_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG}" >&2
    fi
    return 0
  fi
  _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
  return 1
}
_lumos_any_python_find() {
  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""; _LUMOS_ANY_NOTE=""
  if [ -n "${LUMOS_PYTHON:-}" ]; then
    case "$LUMOS_PYTHON" in
      /*|[A-Za-z]:[\\/]*)
        if [ -x "$LUMOS_PYTHON" ] && [ "$("$LUMOS_PYTHON" -c 'print("LUMOS_PY_OK")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY_OK" ]; then
          _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0
        fi
        _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不存在、不能執行或不是 python,略過。
" ;;
      *) _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不是絕對路徑,略過(相對路徑會隨目前目錄解析到別的檔)。
" ;;
    esac
  fi
  for _c in python3.14 python3.15 python3.16; do
    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
  done
    echo "  2. 覺得是檢查工具本身判錯 → 本機重跑一次確認,真的是工具錯就開一張 Issue 記下來。"
    echo "  3. 真的要先推 → git push --no-verify(CI 還是會跑全套,紅了會看到)"
    echo ""
  } >&2
  exit 1
fi


# 代碼偏科 + code-loop 必用守衛(tier=high):push 前把 diff 的代碼形態風險攤在眼前。
# prepush範圍修法(2026-07-21):改讀 stdin 推送範圍逐 ref 判,取代 merge-base——分支與
# main-direct 同軌;無基準(新 ref/缺物件)倒向保守掃 empty-tree..local_sha(非 fail-open,
# 否則守衛升格成穩定繞法);留痕綁 remote_ref 目的地(非 checkout);逐 ref 獨立判,某 ref
# high 未過即擋。fail-open 僅剩:pitfalls 本身出錯 / empty-tree 都跑不動。
# 推送前要跑哪個測試範圍(2026-09-18 Enzo 裁:純文件改動、或判成 light 的小改動,不用等全套):
# 每個 ref 各判一次,任何一個 ref 要全套就全套。docs=只改到 README/docs/assets 這類文件(pitfalls --json 的 suite);
# light=改到程式檔但 spec-gate --push-check 判成 light(風險低計劃、全靠人驗、小改動閘過)。
_SUITE_SEEN=0; _SUITE_FULL=0; _SUITE_LIGHT=0; _SUITE_KEYS=""; _SUITE_GRAPH=0; _AUTOLOOP_FULL=0
for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
  read -r _lref _lsha _rref _rsha <<< "$_ppl"
  # 刪除遠端 ref(local_sha 全零)→ 無代碼推送,跳過
  [[ "$_lsha" == "$_ZERO" ]] && continue
  # 推導檢查範圍(同一套推導另一個使用者是上面的圖譜健康那一段,所以抽成函式——
  # 兩處各寫一份的話,哪天保守兜底改了只改一邊,擋的範圍就會兩邊不一致)
  _range="$(pp_range_for "$_rsha" "$_lsha")"
  [[ -z "$_EMPTY_TREE" ]] && continue   # 連空樹都算不出=git 環境壞,advisory 放行

  # 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S26]):把這次要推的範圍整段查一次,接住跳過提交前檢查的。
  # ★新分支不沿用上面的空樹兜底★(那會把整段歷史當新改動,本工具鏈有 1900 多個提交):起點改用
  # 「不在任何遠端分支上的提交」裡最早那一個的上一個提交;全部已在遠端就不查;最早那個沒有上一個提交(真的全新)才從空樹比。
  # 起點早於這道檢查上線的那個提交時,lumos 會自己改從上線點算(上線前進來的是舊帳)。rc1=擋;其他非零=放行。
  # ★跟上面 _range 是刻意不同的兩套★(代碼審 r1 架構席問過):_range 給波及計算與風險掃描用,只提醒、寧可掃多;
  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
  _hrange=""
  if [[ "$_rsha" != "$_ZERO" ]] && git cat-file -e "$_rsha" 2>/dev/null; then
    _hrange="$_rsha..$_lsha"
  else
    _hold="$(git rev-list --topo-order --reverse "$_lsha" --not --remotes 2>/dev/null | head -1)"
    if [[ -n "$_hold" ]]; then
      if git rev-parse -q --verify "$_hold^" >/dev/null 2>&1; then
        _hrange="$(git rev-parse "$_hold^")..$_lsha"
      else
        _hrange="$_EMPTY_TREE..$_lsha"
      fi
    fi
  fi
  if [[ -n "$_hrange" ]]; then
    nh_rc=0
    "$PY" "$GRAPHCTL" home check --diff "$_hrange" --repo "$REPO_ROOT" || nh_rc=$?
    pp_stop_if_signaled "$nh_rc" "每支檔有家檢查"
    if [[ "$nh_rc" -eq 1 ]]; then
      {
        echo ""
        echo "逃生:照上面的指令替檔安家、或把說明改寫進對的那篇,再推;整個專案先改成只提醒 → .lumos/config.json 的 node_home.gate 設成 warn;緊急硬推 git push --no-verify(本機不留痕)。"
        echo ""
      } >&2
      exit 1
    fi
    # 筆記形狀擋(Projects/筆記形狀擋_計劃):同一段範圍再查一次,接住 --no-verify 跳過提交前那道的;範圍算法同上(不用空樹兜底)
    ns_rc=0
    "$PY" "$GRAPHCTL" note-shape --diff "$_hrange" --repo "$REPO_ROOT" || ns_rc=$?
    pp_stop_if_signaled "$ns_rc" "筆記形狀擋"
    if [[ "$ns_rc" -eq 1 ]]; then
      {
        echo ""
        echo "逃生:照上面改寫(行號改成函式名或測試名、或釘版本 路徑@<提交編號>:行號;現況描述刪掉或帶 [來源:…]);誤擋就 LUMOS_SKIP_NOTE_SHAPE=1 單次跳過(會留帳);整個專案先只提醒 → .lumos/config.json 的 note_shape.gate 設成 warn。"
        echo ""
      } >&2
      exit 1
    fi
  fi

  impact_once "$_range"
  pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
  _tier_high=0
  printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
  _SUITE_SEEN=1
  _suite_this="full"
  printf '%s' "$pf_json" | grep -q '"suite": *"docs"' && _suite_this="docs"
  printf '%s' "$pf_json" | grep -q '"suite_graph": *true' && _SUITE_GRAPH=1
  if [[ "$_tier_high" -eq 1 ]]; then
    {
      echo ""
      echo "提醒:這次推送的程式碼裡有高風險寫法(像是沒包交易的寫入、沒關的檔案控制代碼、沒限流的外部呼叫),tier=high。"
      echo "命中的地方列在下面:"
      "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
      echo ""
    } >&2
  fi
  # 留痕座標綁 remote_ref 目的地:refs/heads/* → 分支:★無條件★叫 check(表態閘 2026-09-09,Projects/棧別提問表態閘_計劃 S7):
  # 合約測試紅 / 有適用題表態不完整 / tier=high 無留痕,三個獨立判定各自出各自的訊息、由 check 印
  # ——這裡不再自己寫死「跑一輪代碼審」文案、也不再把它的輸出丟 /dev/null(r3 正確性席 C3)。非 heads → advisory。
  # 雙向門放行(Projects/雙向門放行_計劃 S11–S14/S21):這次範圍碰到、仍 doing、有雙向門留痕的計劃,留痕裡的測試全綠才准推;
  # 留痕過期(條款或它連到的節點變了)也擋。風險低計劃不派設計審,這裡是它唯一的閘;lumos 算不出範圍/索引就 fail-open 放行(rc≠1;128 以上是被中斷,停下)。
  sg_rc=0
  _sg_out="$_PP_TMP/sg-$RANDOM.log"
  # tee:一邊即時印到 stderr(r1 併發席:先存檔跑完才印,人會以為卡住去 Ctrl-C)、一邊留一份給下面認 light 用;rc 取管線第一段
  "$PY" "$GRAPHCTL" spec-gate --push-check "$_range" --repo "$REPO_ROOT" 2>&1 | tee "$_sg_out" >&2
  sg_rc="${PIPESTATUS[0]}"
  pp_stop_if_signaled "$sg_rc" "雙向門放行檢查(spec-gate)"
  # push-check 判成 light(它才有圖譜、才知道計劃風險低與小改動閘過):改到程式檔也不跑全套,
  # 只跑文件子集 + 原始碼提到「改到的函式/子命令/檔名」的測試;CI 那邊照樣跑全套當後盾。
  # ★還要 pitfalls 說 light_ok★(r1 資安席):小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
  # 會從它眼皮下溜過——範圍裡只要有一支這種檔,就不准少跑全套。
  if [[ "$_suite_this" == "full" ]] && grep -q '改動風險分級:light' "$_sg_out" && printf '%s' "$pf_json" | grep -q '"light_ok": *true'; then
    _suite_this="light"
    _k="$(printf '%s' "$pf_json" | "$PY" -c 'import json,sys; print(",".join(json.load(sys.stdin).get("affected_keys", [])))' 2>/dev/null || true)"
    [[ -n "$_k" ]] && _SUITE_KEYS="${_SUITE_KEYS:+$_SUITE_KEYS,}$_k"
    printf '%s' "$pf_json" | grep -q '"autoloop_full": *true' && _AUTOLOOP_FULL=1
  fi
  case "$_suite_this" in full) _SUITE_FULL=1 ;; light) _SUITE_LIGHT=1 ;; esac
  if [[ "$sg_rc" -eq 1 ]]; then
    echo "" >&2
    echo "風險低計劃的條款測試沒全綠(或留痕過期),推送擋下:把測試做綠、或重跑 lumos spec-gate <計劃> 之後再推。" >&2
    exit 1
  fi
  if [[ "$_rref" == refs/heads/* ]]; then
    _rbranch="${_rref#refs/heads/}"
    cl_rc=0
    # ★高風險這條路也把算好的那份傳進去★:不傳的話它會自己再算一次波及。
    _fj=(); [ -n "$_IMPACT_JSON" ] && _fj=(--from-json "$_IMPACT_JSON")
    # 低風險推送的受波及合約測試維持「只提醒不擋」(2026-09-07 全 repo 審視 #17 人裁);高風險不帶旗標,照擋
    # pitfalls 沒吐 JSON(暫時失敗)就不帶 advisory:讓 check 自己算 tier 決定擋不擋(r1 外家 finder f4/否決 f3)
    _ba=(); [[ -n "$pf_json" && "$_tier_high" -eq 0 ]] && _ba=(--bound-tests-advisory)
    _cl_out="$("$PY" "$GRAPHCTL" code-loop check --diff "$_range" --at-sha "$_lsha" --branch "$_rbranch" \
      --repo "$REPO_ROOT" ${_fj+"${_fj[@]}"} ${_ba+"${_ba[@]}"} 2>&1)" || cl_rc=$?
    pp_stop_if_signaled "$cl_rc" "code-loop check"
    if [[ "$cl_rc" -eq 1 ]]; then
      # 逃逸自動記(規格落成可驗收條件_計劃 第五節):推送閘擋下=下游抓到了設計審/規格閘放行後的洞,
      # 碰到的計劃筆記各記一筆;對不回就不記。★永遠 fail-open★——記帳失敗不能變成擋推送的第二個理由。
      # ★只認「受波及合約的測試沒過」那型★:缺表態/高風險缺留痕是流程沒走完,不是下游抓到缺陷,不進逃逸帳(首輪前掃訂正)
      if printf '%s' "$_cl_out" | grep -q "受波及合約的測試沒過"; then
        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate --severity major \
          --desc "推送閘擋下:$(printf '%s' "$_cl_out" | grep -m1 '受波及合約的測試沒過')" --range "$_range" --repo "$REPO_ROOT" >&2 || true
      fi
      # 高風險缺審查留痕:只有「該計劃被判成風險低、跳過設計審」才算逃逸(lumos 那邊查有沒有風險低留痕,沒有就不記)
      # ★只認「tier=high 且…」開頭的缺留痕句★:測試紅的擋下句尾巴也帶 tier=high,認整個詞會兩筆都記(r2 回滾席)
      if printf '%s' "$_cl_out" | grep -q "tier=high 且"; then
        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate-unreviewed --severity major \
          --desc "推送閘擋下:高風險缺審查留痕" --range "$_range" --repo "$REPO_ROOT" >&2 || true
      fi
      {
        echo ""
        printf '%s\n' "$_cl_out"
        echo ""
        echo "逃生路依上面 check 講的原因走:缺表態 → 先表態(上面的 dispositions 指令);高風險缺審查留痕 → 審過 lumos code-loop pass --note、或刻意不審 lumos code-loop skip --note \"為什麼\";合約測試紅 → 修測試。緊急硬推 git push --no-verify(本機不留痕,CI 會把這次推送標紅)"
        echo ""
      } >&2
      exit 1
    fi
    # rc=0(已收斂/已表態/skip):check 的提醒行(低風險合約測試紅、設定檔警告、表態閘小結)原樣給人看;rc≠0/1(異常,128 以上除外):fail-open 放行
    [ -n "$_cl_out" ] && { printf '%s\n' "$_cl_out" | grep -E '提醒|受波及合約測試|表態閘' >&2 || true; }
  else
    # 非分支 remote_ref(tag/其他 namespace):無 branch marker 通道,一律 advisory(r2 外家 F7)
    [[ "$_tier_high" -eq 1 ]] && echo "提醒:這次推的是 tag 不是分支,高風險檢查只提醒不擋(advisory)。" >&2
    if printf '%s' "$pf_json" | grep -q '"stack_questions_applicable": *{"'; then
      {
        echo ""
        echo "提醒:這次改到的技術棧有幾題效能檢核被觸發(推的是 tag,只提醒不擋),列在下面:"
        "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
        echo ""
      } >&2 || true
    fi
    bound_tests_advisory "$_range"
  fi
  # 存量漂移檢查(Projects/存量漂移防線_計劃〈做法〉第 4 節第 4 點、[S1][S18]):已經寫進圖譜的句子因為這次推送改了狀態而過期
  # (轉正了還留著預告句、計劃收尾了連著的 Issue 還開著…)。排在 code-loop check 之後、全套測試之前:code-loop 約 0.6 秒、
  # 這道最壞 60 秒、全套 8 分鐘,便宜的先跑。分支與 tag 都查(不像 code-loop 要分支名)。
  # 上線標記:下一行那串是 lumos 找「這道檢查從哪個提交起上線」用的(範圍起點截到那裡,上線前的是舊帳),別改寫也別刪:
# lumos drift check
  # 範圍原樣交 遠端舊值..本地頂端,連同遠端名與遠端 ref 名:起點由 lumos 的 _push_range_start 算(跟主線的分岔點與遠端舊值
  # 取比較新的;CI 那步也交給同一支),掛鉤不自己算——原本掛鉤、CI、工具各算一份,三份各有洞(代碼審 r2)。不用上面的 _range。
  # 模式由 lumos 讀被推送頂端提交的 .lumos/config.json(drift_check.gate,沒寫=warn):block 有要處理 rc1 → 擋;warn 只印 rc0;
  # off 它自己跳過。LUMOS_SKIP_DRIFT_CHECK=1 單次略過、淺層 clone 跳過,都由 lumos 記帳。每一筆的 lumos drift fix 修法由它印。
  # 回傳碼:1 → 擋;128 以上(被訊號殺掉,多半是 Ctrl-C)→ 整支掛鉤停下、不放行、不往下跑全套;
  # 其他非零(工具錯誤、git 太慢逾時、舊版工具沒有 drift 子命令)→ 講一句「這次沒檢查」再放行,
  # 跟每支檔有家、筆記形狀擋的「只認 rc1 擋」同一種處理(代碼審 r1 併發回滾席)。
  dr_rc=0
  "$PY" "$GRAPHCTL" drift check --diff "$_rsha..$_lsha" --push-remote "$_PP_REMOTE" --pushed-ref "$_rref" \
    --repo "$REPO_ROOT" || dr_rc=$?
  pp_stop_if_signaled "$dr_rc" "存量漂移檢查"
  if [[ "$dr_rc" -eq 1 ]]; then
    {
      echo ""
      echo "逃生:照上面每一筆的 lumos drift fix 指令改掉、或 lumos drift ack 表態照留(兩種都要提交進去才算),再推;誤擋就 LUMOS_SKIP_DRIFT_CHECK=1 git push 單次略過(會留帳);整個專案先只提醒 → .lumos/config.json 的 drift_check.gate 設成 warn。"
      echo ""
    } >&2
    exit 1
  fi
  if [[ "$dr_rc" -ne 0 ]]; then
    echo "漂移檢查沒能跑完(工具錯誤或 git 太慢),這次沒檢查;CI 會再檢查一次。(上面如果印了「擋下:」,指的是這道檢查自己沒跑成,推送沒有被擋。)" >&2
  fi
  # ★合約測試閘:低風險這一路也要跑★(2026-09-07 全 repo 審視 #17,人裁)
  # 舊行為:這件事藏在 code-loop check 裡,而那支只在 tier=high 且推的是分支時才跑
  # ——所以「改到硬合約就跑那些合約綁的測試」這句話,在低風險推送上是假的,
  # 而改一行低風險的碼一樣可以打破合約。
  # 高風險那條路已經在上面的 code-loop check 裡跑過(它會擋),這裡只補低風險那半。
  # (表態閘 2026-09-09 起)分支 ref 的低風險推送:合約測試已在上面的 code-loop check 裡以 advisory 跑過一次,這裡不再跑第二次;
  # tag 走上面 else 分支的 bound_tests_advisory。
  # test-layers 軟提醒(advisory,恆不影響 rc;無 .lumos/test-layers.json 靜默)
  "$PY" "$GRAPHCTL" test-layers --diff "$_range" --repo "$REPO_ROOT" 2>/dev/null || true
  impact_done
    hm = sub.add_parser("home", help="每支檔有家:程式檔歸屬與寫回落點的檢查(提交前/推送前擋新違規);spec=Projects/每支檔有家_計劃")
    hmsub = hm.add_subparsers(dest="hmcmd", required=True)
    hmc = hmsub.add_parser("check", help="這次提交或這段推送有沒有新違規(有 rc1、沒有 rc0;沒圖譜/合併中/開關 off 跳過 rc0)")
    hmc.add_argument("--staged", action="store_true", dest="hm_staged", help="看這次要提交的內容(提交索引);不能跟 --diff 一起用")
    hmc.add_argument("--diff", dest="hm_diff", default=None, metavar="A..B", help="把範圍兩端當成一次改動比(推送前用);不能跟 --staged 一起用")
    hmc.add_argument("--repo", dest="hm_repo", default=None, help="repo root(預設 cwd 所在的 git 專案)")

    ns_p = sub.add_parser("note-shape", help="筆記形狀擋:新寫的程式行號引用、沒寫來源的 FACT/FLOW/DEP 擋下(有 rc1、沒有 rc0;跳過 rc0);spec=Projects/筆記形狀擋_計劃")
    ns_p.add_argument("--staged", action="store_true", dest="ns_staged", help="看這次要提交的內容(提交索引);不能跟 --diff 一起用")
    ns_p.add_argument("--diff", dest="ns_diff", default=None, metavar="A..B", help="推送範圍(推送前與 CI 用);不能跟 --staged 一起用")
    ns_p.add_argument("--repo", dest="ns_repo", default=None, help="repo root(預設 cwd 所在的 git 專案)")

    na_p = sub.add_parser("note-audit", help="筆記內容審:推送前派判定者逐行判新寫的筆記是不是程式碼推得出來;spec=Projects/筆記內容審_計劃")
    nasub = na_p.add_subparsers(dest="nacmd", required=True)
    nap = nasub.add_parser("prepare", help="算出待審的行、切成清單檔與派工詞(每份不超過 150 行)")
    nap.add_argument("--diff", dest="na_diff", required=True, metavar="A..B")
    nap.add_argument("--orchestrator", dest="na_orch", required=True, choices=("claude", "codex"),
                     help="這次是哪一家在編排(判定者跟它同一家)")
    nap.add_argument("--only", dest="na_only", nargs="+", default=None, metavar="編號", help="只列這幾個內容編號(申訴用)")
    nap.add_argument("--repo", dest="na_repo", default=None)
    nar = nasub.add_parser("record", help="把判定者的報告記成判定檔(照信任方向逐行收)")
    nar.add_argument("--diff", dest="na_diff", required=True, metavar="A..B")
    nar.add_argument("--prepared", dest="na_prepared", required=True, metavar="清單檔")
    nar.add_argument("--report", dest="na_reports", action="append", required=True, metavar="報告")
    nar.add_argument("--dispute", dest="na_dispute", action="store_true", help="這份是申訴")
    nar.add_argument("--disputes", dest="na_disputes", default=None, metavar="判定檔", help="被申訴的那份判定檔名")
    nar.add_argument("--repo", dest="na_repo", default=None)
    nac = nasub.add_parser("check", help="這段推送的新筆記行都被已提交的判定涵蓋了沒(沒有 rc1;warn 模式只印)")
    nac.add_argument("--diff", dest="na_diff", required=True, metavar="A..B")
    nac.add_argument("--repo", dest="na_repo", default=None)
    nas = nasub.add_parser("skip", help="把從來沒被判過的待審行記成略過(要理由,會留帳)")
    nas.add_argument("--diff", dest="na_diff", required=True, metavar="A..B")
    nas.add_argument("--note", dest="na_note", required=True)
    nas.add_argument("--repo", dest="na_repo", default=None)

    dr_p = sub.add_parser("drift", help="存量漂移守衛:已經寫進去的句子因為別處狀態變了而過期;spec=Projects/存量漂移防線_計劃")
    drsub = dr_p.add_subparsers(dest="drcmd", required=True)
    drc = drsub.add_parser("check", help="這段推送讓哪些筆記跟狀態對不上(要處理的 rc1;warn 模式只印)")
    drc.add_argument("--diff", dest="dr_diff", required=True, metavar="A..B")
    drc.add_argument("--repo", dest="dr_repo", default=None)
    drc.add_argument("--push-remote", dest="dr_push_remote", default=None, metavar="遠端名",
                     help="推送前掛鉤與 CI 用:--diff 的起點當成遠端舊值,改從跟主線(這個遠端的預設分支優先)的分岔點算")
    drc.add_argument("--pushed-ref", dest="dr_pushed_ref", default=None, metavar="ref",
                     help="這次推的遠端 ref(refs/heads/X);找主線時跳過就是這條的候選")
    drs = drsub.add_parser("scan", help="健檢整份圖譜跟狀態對不上的地方(不擋、不寫帳)")
    drs.add_argument("--at", dest="dr_at", default=None, metavar="提交", help="看某個提交的圖譜(預設工作目錄)")
    drs.add_argument("--json", dest="dr_json", action="store_true")
    drs.add_argument("--budget", dest="dr_budget", type=float, default=None, metavar="秒",
                     help=f"總預算(預設 {_DRIFT_BUDGET_SEC} 秒);用完的條件列成判不了")
    dra = drsub.add_parser("ack", help="表態某一行照留(要理由;提交進去才算)")
    dra.add_argument("dr_node", metavar="節點")
    dra.add_argument("dr_line", metavar="行號", type=int)
    dra.add_argument("--kind", dest="dr_kind", required=True, choices=_DRIFT_KINDS)
    dra.add_argument("--reason", dest="dr_reason", required=True)
    drf = drsub.add_parser("fix", help="用工具改掉一筆發現(c1 到 c5;要改之前那篇要在版控裡而且乾淨;每改一筆記修復帳)")
    drf.add_argument("dr_node", metavar="節點")
    drf.add_argument("dr_line", metavar="行號", type=int)
    drf.add_argument("--kind", dest="dr_kind", required=True, help="c1/c2/c3/c4/c5(照 drift scan 那一筆列的種類)")
    drf.add_argument("--dry-run", dest="dr_dry", action="store_true", help="只印改前改後,不寫筆記、不寫帳")
    drf.add_argument("--date", dest="dr_date", default=None, metavar="YYYY-MM-DD", help="c1:轉正日期(推不出來時要給)")
    drf.add_argument("--close", dest="dr_close", action="store_true", help="c2:Issue 解決了,結案")
    if args.cmd == "compose-metrics":
        return _compose_metrics_mode(args.compose_metrics_repo, args.as_json, args.update_baseline, args.audit)
    if args.cmd == "cochange":
        if args.cccmd == "rules":
            return cmd_cochange_rules(repo=args.coch_repo, show_all=args.coch_all,
                                      as_json=args.coch_json)
        return cmd_cochange_check(repo=args.coch_repo, staged=args.coch_staged,
                                  diff_range=args.coch_diff, as_json=args.coch_json)
    if args.cmd == "home":
        # 兩個同給=用法錯誤(rc2),不靜默選邊(第二輪外家席);寫法同 loop status 的 --light/--panel——
        # 不用 argparse 的互斥群組:整支工具只有這裡用它,而且它的錯誤訊息是英文(代碼審 r1 架構席)
        # 用 is None 分「沒給」與「給了空字串」:--diff "" 是範圍寫錯,要走下面範圍判法講對原因(代碼審 r2 邊界席)
        if args.hm_staged and args.hm_diff is not None:
            print("擋下:--staged 和 --diff 不能一起用(一個看這次要提交的內容、一個看一段推送範圍,兩條不同的路),擇一", file=sys.stderr)
            return 2
        if not args.hm_staged and args.hm_diff is None:
            print("擋下:lumos home check 要帶 --staged 或 --diff <起點>..<終點>", file=sys.stderr)
            return 2
        return cmd_home_check(repo=args.hm_repo, staged=args.hm_staged, diff_range=args.hm_diff)
    if args.cmd == "note-audit":
        if args.nacmd == "prepare":
            return cmd_note_audit_prepare(repo=args.na_repo, diff_range=args.na_diff, orchestrator=args.na_orch, only=args.na_only)
        if args.nacmd == "record":
            return cmd_note_audit_record(repo=args.na_repo, diff_range=args.na_diff, prepared=args.na_prepared,
                                         reports=args.na_reports, dispute=args.na_dispute, disputes=args.na_disputes)
        if args.nacmd == "check":
            return cmd_note_audit_check(repo=args.na_repo, diff_range=args.na_diff)
        return cmd_note_audit_skip(repo=args.na_repo, diff_range=args.na_diff, note=args.na_note)
    if args.cmd == "drift" and args.drcmd in ("check", "exam"):
        if args.drcmd == "check":
            return cmd_drift_check(repo=args.dr_repo, diff_range=args.dr_diff, push_remote=args.dr_push_remote,
                                   pushed_ref=args.dr_pushed_ref)
        if not args.dr_history and not args.dr_exam:
            print("擋下:lumos drift exam 要給考卷,或帶 --history N", file=sys.stderr)
            return 2
        return cmd_drift_exam(args.dr_exam, args.dr_repo, probes=args.dr_probes, at=args.dr_at,
                              history=args.dr_history, as_json=args.dr_json)
    if args.cmd == "note-shape":
        if args.ns_staged and args.ns_diff is not None:
            print("擋下:--staged 和 --diff 不能一起用,擇一", file=sys.stderr)
            return 2
        if not args.ns_staged and args.ns_diff is None:
            print("擋下:lumos note-shape 要帶 --staged 或 --diff <起點>..<終點>", file=sys.stderr)
            return 2
        return cmd_note_shape(repo=args.ns_repo, staged=args.ns_staged, diff_range=args.ns_diff)
    if args.cmd == "delguard":
        return cmd_delguard_check(repo=args.repo, as_json=args.json)
    if args.cmd == "bound-tests":
        if args.bt_skip and not (args.bt_note or "").strip():
            print("擋下:--skip 要附一句理由(--note),不然帳上看不出為什麼跳過", file=sys.stderr)
            return 2

