+def _push_mainline_branch(repo_root, cand, remote):
+    """主線候選指到的分支短名(判「就是這次被推的那條」用);判不出回 None。
+    遠端 HEAD 用 symbolic-ref 解出它指的分支;X@{upstream} 用 rev-parse --symbolic-full-name 解,再去掉那條本地分支設定的遠端名。"""
+    if cand.startswith("refs/remotes/"):
+        if cand.endswith("/HEAD"):
+            r = _lens_git(repo_root, "symbolic-ref", "-q", cand)
+            if r is None or r.returncode != 0:
+                return None
+            full = r.stdout.strip()
+        else:
+            full = cand
+        pre = f"refs/remotes/{remote}/"
+        return full[len(pre):] if remote and full.startswith(pre) else None
+    local = cand.split("@{", 1)[0]
+    r = _lens_git(repo_root, "rev-parse", "--symbolic-full-name", cand)
+    if r is None or r.returncode != 0:
+        return None
+    full = r.stdout.strip()
+    if full.startswith("refs/heads/"):          # upstream 設成本機另一條分支(branch.X.remote = .)
+        return full[len("refs/heads/"):]
+    rm = _lens_git(repo_root, "config", "--get", f"branch.{local}.remote")
+    pre = f"refs/remotes/{rm.stdout.strip()}/" if (rm is not None and rm.returncode == 0 and rm.stdout.strip()) else None
+    return full[len(pre):] if pre and full.startswith(pre) else None
+
+
+def _push_mainline(repo_root, remote, pushed_ref):
+    """推送的主線 → (候選名, sha) 或 None。依序:遠端宣告的預設分支(refs/remotes/<遠端>/HEAD)→ main@{upstream}
+    → master@{upstream} → <遠端>/main → <遠端>/master;沒給遠端名就跳過帶遠端的候選。
+    ★跳過「就是這次被推的那條分支」★:推主線本身時,掛鉤裡 main@{upstream} 還是舊值、CI 裡 origin/main 已經等於頂端,
+    拿它當主線會在 CI 判成「頂端已在主線、沒有新東西」整步跳過——跳過後兩邊都走「沒有別的主線、用遠端舊值」。
+    指到哪條分支判不出來(遠端 HEAD 不是捷徑、upstream 的遠端名讀不到)就不跳過。"""
+    pushed = pushed_ref[len("refs/heads/"):] if (pushed_ref or "").startswith("refs/heads/") else None
+    cands = ([f"refs/remotes/{remote}/HEAD"] if remote else []) + ["main@{upstream}", "master@{upstream}"] \
+        + ([f"refs/remotes/{remote}/main", f"refs/remotes/{remote}/master"] if remote else [])
+    for cand in cands:
+        sha = _lens_full_sha(repo_root, cand)
+        if not sha:
+            continue
+        if pushed is not None and _push_mainline_branch(repo_root, cand, remote) == pushed:
+            continue
+        return cand, sha
+    return None
+
+
+def _push_range_start(repo_root, old, tip, remote, pushed_ref):
+    """推送前掛鉤與 CI 的範圍起點 → (起點 sha 或 None, 說明)。None=頂端已在主線上、沒有新東西。
+    old 是遠端舊值(40/64 個 0=新分支首推;本機可能找不到=force push 蓋掉的舊頂端),remote 是推送的遠端名,
+    pushed_ref 是遠端那一側的 ref(refs/heads/X、refs/tags/Y)。
+    ★起點只在這裡算一處★(推送閘接漂移檢查代碼審 r2:掛鉤的 bash、CI 的 shell 補法、工具端各算一份,三份各有洞):
+    - 主線照 _push_mainline 找;找不到:舊值找得到用舊值;舊值全 0 從空樹算;舊值找不到退到頂端的第一個父提交
+      (沒有父提交從空樹),只查最後一個提交——說明照實講。
+    - 找到主線:頂端是主線的祖先(或相等)→ None;`merge-base --all` 沒有 → 同找不到主線;
+      舊值找得到而且**每一個**合併基底都是舊值的祖先 → 用舊值(一般增量推送);否則用第一個不是舊值祖先的合併基底
+      (功能分支合過主線、重定基底、交叉合併:用舊值的話 `舊..新` 會把合進來的主線提交——別人的轉正——算成這次的;
+      只看 git 挑的那一個基底,交叉合併時會挑到舊值那個而退回原樣範圍)。舊值不在時用第一個基底。"""
+    if old == _EMPTY_TREE_SHA:
+        return old, "起點是空樹,從空樹比"
+    zero = bool(_ZERO_SHA_RE.fullmatch(old or ""))
+    old_sha = None if zero else _lens_full_sha(repo_root, old)
+
+    def _no_mainline(why):
+        if old_sha:
+            return old_sha, f"{why},用遠端舊值 {old_sha[:12]} 當起點"
+        if zero:
+            return _EMPTY_TREE_SHA, f"{why},新分支首推:從空樹算(截到上線點)"
+        par = _lens_full_sha(repo_root, f"{tip}^1")
+        if par:
+            return par, f"{why},遠端舊值在本機找不到:從頂端的第一個父提交 {par[:12]} 算,只查最後一個提交"
+        return _EMPTY_TREE_SHA, f"{why},遠端舊值在本機找不到、頂端沒有父提交:從空樹算"
+
+    ml = _push_mainline(repo_root, remote, pushed_ref)
+    if ml is None:
+        return _no_mainline("找不到主線(遠端預設分支、main/master 的 upstream、遠端 main/master 都沒有,或就是這次推的分支)")
+    anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
+    if anc is not None and anc.returncode == 0:
+        return None, f"頂端已在主線({ml[0]})上——沒有新東西"
+    mb = _lens_git(repo_root, "merge-base", "--all", tip, ml[1])
+    bases = [b for b in (mb.stdout.split() if (mb is not None and mb.returncode == 0) else []) if _LENS_SHA_RE.match(b)]
+    if not bases:
+        return _no_mainline(f"跟主線({ml[0]})沒有共同祖先")
+    if old_sha:
+        return _push_pick_base(repo_root, bases, old_sha, ml[0])
+    what = "新分支首推" if zero else "遠端舊值在本機找不到"
+    return bases[0], f"{what}:從跟主線({ml[0]})的分岔點 {bases[0][:12]} 算"
+
+
+def _push_pick_base(repo_root, bases, old_sha, ml_name):
+    """遠端舊值找得到時:每一個合併基底都是舊值的祖先(或相等)→ 用舊值;否則用第一個不是舊值祖先的基底。
+    git 判不了(逾時)的基底當成不是祖先——寧可多查自己上次推過的,也不把舊值之後主線合進來的算成這次的。"""
+    for b in bases:
+        r = _lens_git(repo_root, "merge-base", "--is-ancestor", b, old_sha)
+        if r is None or r.returncode != 0:
+            return b, f"遠端舊值跟主線({ml_name})分岔(合過主線或重定基底):從分岔點 {b[:12]} 算"
+    return old_sha, f"一般增量推送:從遠端舊值 {old_sha[:12]} 算"
+
+
 def _lens_git(repo_root, *args, quote=False, binary=False):
     """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
     import subprocess as _sp
     cmd = ["git", "-C", str(repo_root)]
     if quote:
         cmd += ["-c", "core.quotePath=false"]
     try:
         if binary:
             return _sp.run(cmd + list(args), capture_output=True, timeout=20)
         return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
