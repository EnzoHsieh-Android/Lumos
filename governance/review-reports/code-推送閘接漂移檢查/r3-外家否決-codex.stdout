# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────

def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    pre = vault_rel.rstrip("/") + "/"
    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
    import time as _t
    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
    blobs = _drift_cat(root, where, paths, left) if paths else []
    if blobs is None:
        return None
    texts, bad = {}, []
    for p, b in zip(paths, blobs):
        if b is None:
            # 樹上列得出、內容讀不出來:建成讀不出的筆記(代碼審 r2 外家席:原本跳過,等於當成不存在)
            bad.append(p[len(pre):])
            continue
        try:
            texts[p[len(pre):]] = b.decode("utf-8-sig")
        except UnicodeDecodeError:
            bad.append(p[len(pre):])
    texts.update(override or {})
    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])


def _drift_vault_rel(root, where):
    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        return None
    wv = _vault_in(Path(root))
    try:
        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
    except ValueError:
        wv_rel = None
    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]


def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
    import time as _t
    pre = vault_rel.rstrip("/") + "/"
    if deadline is not None and _t.monotonic() > deadline:
        return None
    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _drift_empty_tree(root), tip, "--", vault_rel)
    if raw is None:
        return None
    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
               if x.strip("\n").startswith(pre)}
    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
              and _drift_str(n, "status") in _DRIFT_CLOSED}
    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "verification" and st == "pass",
                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
    if passed is None:
        return None
    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
    if closed is None:
        return None
    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}


def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None, override_base=None):
    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
    import time as _t

    def _left():
        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
    if tenv is None:
        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
    if _left() <= 0:
        return [], [], [over]
    reader = _nodehome_reader(root, tip)
    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
    if ev is None:
        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
               if _note_unreadable(n) and p in ev["touched"]]
    must, listed = [], []
    for f in _drift_state_findings(tenv):
        p, k = f["path"], f["kind"]
        if k == "c1":
            if p in ev["passed"]:
                must.append(f)
            continue
        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
        if hit:
            listed.append(f)
    if _left() <= 0:
        return must, listed, [*unknown, over]
    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
    return must + pm, listed + pl, unknown + pu



# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
_PROBE_KEYS = ("file", "symbol", "test", "status")
_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")


def _revisit_split(line):
    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
    import datetime
    if line.lstrip().startswith("|"):
        return None, None
    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
    if not s.startswith("REVISIT:"):
        return None, None
    rest = s[len("REVISIT:"):]
    if rest.lstrip().startswith("[when-"):
        return "cond", rest
    try:
        datetime.date.fromisoformat(rest.partition(" ")[0])
        return "date", rest
    except ValueError:
        return "bad", rest


def _revisit_lines(text):
    """一篇筆記的每一條回頭條件 → [(行號, 種類, 日期或 None, 摘要, 原文)];種類 date/cond/bad(同 _revisit_split)。
    剝程式碼區(_search_visible_lines)、餵剝過行內程式碼的那一版給 _revisit_split。doctor E5 與 set 把 Issue 結案時的列出
    共用這一支(存量漂移改法 第 6 節);乙的 _probe_lines、第一層、第二層各自的逐行迴圈不在這裡。"""
    out = []
    for no, raw, _pr in _search_visible_lines(text.split("\n"), False):
        kind, rest = _revisit_split(_strip_inline_markup(raw)[0])
        if kind is None:
            continue
        date, summ = None, ""
        if kind == "cond":
            date, summ = _probe_parse(rest)["by"], _PROBE_LEAD_RE.sub("", rest)
        elif kind == "date":
            date, _sp, summ = rest.partition(" ")
        out.append((no, kind, date, summ.strip(), raw))
    return out


def _issue_close_revisits(env, rel, new_status):
    """lumos set <Issue> status <結案值>、drift fix --kind c2 --close 之後:列出這篇★全部★回頭條件(不只到期的),
    提示結案了要改成結案說明或刪掉。只印、不擋、不改;行號用寫完之後從磁碟重讀的內容算(存量漂移改法 [S7])。"""
    n = env.notes.get(rel)
    if _drift_str(n, "type") != "issue" or str(new_status).strip() not in _ISSUE_CLOSED_STATUSES:
        return
    try:
        text = _phys_path(env.vault, rel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        return
    rows = _revisit_lines(text)
    if not rows:
        return
    print(f"這篇 Issue 結案了,還留著 {len(rows)} 行回頭條件——要改成結案說明或刪掉(只列出、不擋):")
    for no, _k, _d, _s, raw in rows:
        print(f"  · {_esc_clean(rel, 200)}:{no}  {_esc_clean(raw.strip(), 100)}")


def _probe_value_err(k, v):
    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
    if k not in _PROBE_KEYS:
        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
    if not v:
        return f"when-{k} 的值是空的"

    if k == "file":
        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
    if k in ("symbol", "test"):
        return _probe_named_err(k, v)
    node, eq, vals = v.partition("=")
    if not eq or not node.strip() or not vals.strip():
        return "when-status 要寫成 <節點>=<值>"
    if any(not x.strip() for x in vals.split("|")):
        return "when-status 的值用 | 分開時每一段都不能空"
    return None


def _probe_norm_value(k, v):
    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
    if k == "file":
        return nfc(_posix_norm(v))
    if k in ("symbol", "test") and "::" in v:
        path, name = v.rsplit("::", 1)
        return nfc(_posix_norm(path)) + "::" + name.strip()
    return v


def _probe_bad_path(p):
    return (not p) or p == "." or p.startswith("/") or ".." in p.split("/")


def _probe_named_err(k, v):
    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
    if "::" not in v:
        return None
    path, name = v.rsplit("::", 1)
    if not name.strip():
        return f"when-{k} 的名稱是空的"
    if _probe_bad_path(path.strip()):
        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
    return None


def _probe_parse(rest):
    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
    import datetime
    conds, by, errs, pos, bad = [], None, [], 0, False
    while True:
        m = _PROBE_TOKEN_RE.match(rest, pos)
        if not m:
            break
        pos = m.end()
    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。

    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
    new = _merge_new_lines(merged, olds)
    return True if new is None else bool(new)


def _merge_new_lines(merged, olds):
    """合併結果裡「每一個上一版都找不到」的那些行(去頭尾空白後的位元組集合);判不了回 None。
    從 _nodehome_merge_wrote_new_lines 拆出來(筆記形狀擋 [S5] 要的是哪幾行,不是有沒有);天花板見那支的說明。"""
    if merged is None or b"\0" in merged:
        return None
    seen = set()
    for blob in olds:
        if blob is not None:
            seen.update(ln.strip() for ln in blob.split(b"\n"))
    return {ln.strip() for ln in merged.split(b"\n") if ln.strip() and ln.strip() not in seen}


def _nodehome_commit_groups(repo_root, base, tip):
    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
    if raw is None:
        return None
    out = []
    for line in raw.decode("ascii", errors="replace").splitlines():
        shas = line.split()
        if not shas:
            continue
        sha, parents = shas[0], shas[1:]
        if len(parents) <= 1:
            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
            if r is None:
                return None
            paths, src, gone = _nodehome_name_status(r)
        else:
            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
            if rm is not None:
                paths, src, gone = rm
            else:
                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
                per = []
                for p in parents:
                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
                    if r is None:
                        return None
                    per.append(_nodehome_name_status(r))
                paths = set.intersection(*(x[0] for x in per))
                src = {k: v for k, v in per[0][1].items() if k in paths}
                gone = set.intersection(*(x[2] for x in per))
        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
    return out


def _nodehome_mark_note_content(repo_root, groups, vault_rel):
    """推送前逐提交看寫回:每個提交裡,哪幾篇 Systems 節點的內容(摘要、決策、正文)是在這個提交改的——只補驗證連結、
    計劃連結這類簿記欄位的不算——以及那篇在這個提交前後管哪些檔。在讀取這一層先算好放進分組的 content_notes
    {這個提交之後的路徑: {type, status, own}},判定那層只在同一個提交裡比「管的檔」跟「改的程式」,不必跨提交追名字
    (合併進來的平行分支、一次推送改名好幾次都不影響——代碼審 r2 單reviewer)。這個提交裡改名的,拿改名前的路徑去
    上一個提交讀;這個提交才新開的算有變;讀不到一律當有變,照原本那樣查。"""
    pre = vault_rel + "/Systems/"
    for g in groups or ():
        after = _nodehome_reader(repo_root, g["sha"])
        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
        notes = {}
        for p in g["paths"]:
            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
                continue
            new = after(p)
            n = _nodehome_parse_note(new) if new is not None else None
            olds = [b(g["src"].get(p, p)) for b in befores]
            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
            if n is not None and any(o["sig"] == n["sig"] for o in olds):
                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
            own, statuses = set(), set()
            for x in [n] + olds:
                if x is not None:
                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
                    statuses.add(x["status"])
            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
        g["content_notes"] = notes
    return groups


_NOTELINES_PRECOMMIT = "scripts/hooks/pre-commit"
_NOTELINES_PREPUSH = "scripts/hooks/pre-push"


def _nodehome_golive(repo_root, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。
    mark=要找的標記字串,預設是每支檔有家自己的;筆記形狀擋傳它自己的(Projects/筆記形狀擋_計劃 [S4])。"""
    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{mark or _NODEHOME_GOLIVE_MARK}",
                        tip or "HEAD", "--", hook)
    if not raw:
        return None
    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
    return first if _LENS_SHA_RE.match(first) else None


def _nodehome_clamp_base(repo_root, base, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。mark 見 _nodehome_golive。"""
    gl = _nodehome_golive(repo_root, tip, mark, hook)
    if gl is None:
        return base
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
    if r is None or r.returncode != 0:
        return base                                    # 上線點不在這條歷史上
    if base in (None, _EMPTY_TREE_SHA):
        return gl
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
    return gl if (r is not None and r.returncode == 0 and base != gl) else base


def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
    None=整批當成一個提交(提交前)。"""
    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
    homesN, ownN = _nodehome_homes(repo_root, N)
    homesB, ownB = _nodehome_homes(repo_root, B)
    blocks, reminders, pairs = [], [], []
    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
    for code, old, new in changes:
        if old is not None and (new is None or code == "R"):
            deleted.add(old)
        if new is None:
            continue
        changed_new.add(new)
        if code in ("A", "R", "C"):
            added.add(new)
        if code == "R" and old:
            renamed_from[new] = old
    code_changed = {p for p in changed_new if p in reqN}
    code_added = {p for p in added if p in reqN}
    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)

