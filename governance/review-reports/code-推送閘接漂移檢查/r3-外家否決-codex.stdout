 succeeded in 0ms:
    for n, b in zip(names, blobs or []):
        v = _note_audit_parse_verdict(b) if b is not None else None
        (docs.__setitem__(n, v) if v is not None else bad.append(n))
    return docs, bad


def _note_audit_fold(docs):
    """判定怎麼算(計劃〈做法〉第 2 節):對每個內容編號——①一般判定逐筆,被申訴過就換成所有指名它的申訴裡最重的結果;
    ②取最重(CODE > MIXED > CONTEXT);③沒有任何判定時,有略過就算略過。→ {id: 'CODE'|'MIXED'|'CONTEXT'|'SKIP'}。
    跟讀檔順序無關。"""
    disputes = {}
    for _name, d in docs.items():
        if d["kind"] == "申訴" and d.get("disputes"):
            for r in d["rows"]:
                if r["class"] in _NOTE_AUDIT_WEIGHT:
                    k = (d["disputes"], r["id"])
                    if k not in disputes or _NOTE_AUDIT_WEIGHT[r["class"]] > _NOTE_AUDIT_WEIGHT[disputes[k]]:
                        disputes[k] = r["class"]
    best, skipped = {}, set()
    for name, d in docs.items():
        if d["kind"] == "略過":
            skipped.update(r["id"] for r in d["rows"])
            continue
        if d["kind"] != "判定":
            continue
        for r in d["rows"]:
            c = r["class"]
            if c not in _NOTE_AUDIT_WEIGHT:
                continue
            c = disputes.get((name, r["id"]), c)
            if r["id"] not in best or _NOTE_AUDIT_WEIGHT[c] > _NOTE_AUDIT_WEIGHT[best[r["id"]]]:
                best[r["id"]] = c
    out = dict(best)
    for i in skipped:
        out.setdefault(i, "SKIP")
    return out


def _note_audit_covered(cls):
    return cls in ("CONTEXT", "SKIP")


def _note_audit_resolve(root, diff_range, gate_word, gate="note-audit", mark=None, push=None):
    """--diff 範圍 → (base_where, tip, vault_rel) 或 (None, rc, None)。起點照三道檢查共用的 _lens_push_base,
    再截到上線點(推送前掛鉤的標記;預設是第二層的,存量漂移檢查傳自己的)。
    push=(遠端名, 遠端 ref) 時範圍的起點當成遠端舊值,改由 _push_range_start 算(存量漂移檢查的 --push-remote/--pushed-ref),
    說明一定印一行。"""
    rg = _lens_range_ok(diff_range)
    if rg is None:
        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
        return None, 2, None
    sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
    if sh is not None and sh.stdout.strip() == "true":
        print(f"{gate_word}:淺層 clone 算不出範圍,這次不查——CI 請設 fetch-depth: 0", file=sys.stderr)
        _gate_event_or_warn(root, gate, "skipped-env", "shallow clone")
        return None, 0, None
    a, b = rg
    if _ZERO_SHA_RE.fullmatch(b):
        print(f"{gate_word}:範圍終點是全 0(刪除分支),沒有要審的東西", file=sys.stderr)
        return None, 0, None
    tip = _lens_full_sha(root, b)
    if tip is None:
        # 推送前的終點是本機要推的提交、CI 的是剛 checkout 的那個,都一定找得到;找不到就是範圍寫錯,
        # 放行等於整道檢查沒跑(代碼審 r1 外家席),所以當參數錯
        print(f"擋下:範圍 {diff_range} 的終點在本機找不到——範圍寫錯了?", file=sys.stderr)
        return None, 2, None
    if push is not None:
        base, why = _push_range_start(root, a, tip, push[0], push[1])
        why = f"起點——{why}"
    else:
        base, why = _lens_push_base(root, a, tip)
    if why:
        print(f"{gate_word}:{why}", file=sys.stderr)
    if base is None:
        _gate_event_or_warn(root, gate, "skipped", why)
        return None, 0, None
    base = _nodehome_clamp_base(root, base, tip, mark or _NOTE_AUDIT_GOLIVE_MARK, _NOTELINES_PREPUSH)
    lst = _nodehome_list(root, tip)
    if lst is None:
        return None, 0, None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        print(f"{gate_word}:這個專案沒有圖譜,跳過")
        return None, 0, None
    wv = _vault_in(root)
    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
    return (None if base == _EMPTY_TREE_SHA else base), tip, vault_rel


def _note_audit_root(repo):
    if repo:
        return Path(repo).resolve()
    r = _lens_git(".", "rev-parse", "--show-toplevel")
    return Path(r.stdout.strip()) if (r is not None and r.returncode == 0) else None


def _note_audit_prompt(root):
    """派工詞:範本檔三類定義與七句,專案路徑與技術棧換成被審 repo 的(計劃 S13)。"""
    here = Path(__file__).resolve().parent.parent
    tpl = None
    for cand in (Path(root) / _NOTE_AUDIT_TEMPLATE, here / _NOTE_AUDIT_TEMPLATE):
        if cand.is_file():
            tpl = cand.read_text(encoding="utf-8")
            break
    if tpl is None:
        return None
    # 檔頭授權標示與給維護者看的註解不進派工詞
    tpl = "".join(ln for ln in tpl.splitlines(keepends=True) if not ln.startswith("# SPDX-"))
    if tpl.lstrip().startswith("<!--") and "-->" in tpl:
        tpl = tpl.split("-->", 1)[1].lstrip("\n")
    try:
        cnt = sorted(_stack_ext_counts(Path(root)).items(), key=lambda kv: -kv[1])[:5]
        stacks = "主要程式檔副檔名:" + (", ".join(f"{e}×{n}" for e, n in cnt) if cnt else "未偵測到")
    except OSError:
        stacks = "主要程式檔副檔名:未偵測到"
    return (tpl.replace("{{REPO_PATH}}", str(Path(root).resolve())).replace("{{STACK}}", stacks)
               .replace("{{PROMPT_VERSION}}", str(_NOTE_AUDIT_PROMPT_VERSION)))


def _note_audit_batches(pending):
# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
    import json as _j
    if text is None:
        return _DRIFT_DEFAULT_GATE, [], False
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


def _drift_print_findings(rows, stream, acks=None, alive=None):
    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
              file=stream)
        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
        prev = _drift_prev_ack_line(f)
        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
        if prev:
            print(f"      ({_esc_clean(prev, 400)})", file=stream)
        elif old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  …還有 {len(rows) - 20} 筆", file=stream)


def cmd_drift_check(repo=None, diff_range=None, push_remote=None, pushed_ref=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。
    帶 --push-remote 或 --pushed-ref(推送前掛鉤與 CI 用):A 當成遠端舊值,起點由 _push_range_start 算;
    都沒帶照共用起點判法(_lens_push_base),行為不變。"""
    import time as _t
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
        return 0
    push = None if (push_remote is None and pushed_ref is None) else (push_remote or "", pushed_ref or "")
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
                                               mark=_DRIFT_GOLIVE_MARK, push=push)
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
    for w in warns:
        print(f"提醒:{w}", file=sys.stderr)
    if mode == "off":
        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
        return 0
    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
    acks = _drift_load_acks(root, tip)
    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
    lst = _nodehome_list(root, tip)
    alive = set(lst[1]) if lst else None
    if listed:
        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
        _drift_print_findings(listed, sys.stderr, acks, alive)
        _drift_print_hints(listed, sys.stderr)
    if not must and not unknown:
        return 0
    return _drift_report_must(root, mode, must, unknown, acks, alive)


def _drift_report_must(root, mode, must, unknown, acks, alive=None):
    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
    for u in unknown:
        print(f"  判不了:{_esc_clean(u, 1000)}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
    _drift_print_findings(must, sys.stderr, acks, alive)
    kinds = {f["kind"] for f in must}
    # 改法指令由 _drift_fix_hint 單一產生(存量漂移改法 [S10]):c1 到 c5 指到 lumos drift fix(c1 一篇一條),
    # 條件式回頭條件(probe)的修法不一樣,同一支給它自己的說法
    _drift_print_hints(must, sys.stderr, "改法(每一筆一條指令;c1 一篇一條):")
    if must:
        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
        for k in sorted(kinds):
            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
    if mode == "block":
        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
                            nodes=sorted({f["path"][:-3] for f in must})[:50])
        return 1
    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
    return 0


# ── 健檢與 doctor ────────────────────────────────────────────────────────────────────

def _drift_vault_of(env):
    root = _vault_repo_root(env)
    try:
        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        return root, env.vault.name


def cmd_drift_scan(env, at=None, as_json=False, budget=None):
    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
    import json as _j, math as _m, time as _t
    budget = _DRIFT_BUDGET_SEC if budget is None else budget
    if not _m.isfinite(budget) or not 0 < budget <= 86400:
        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:        # .lumos 資料夾本身是捷徑也不跟(照 _note_audit_doctor_lines;代碼審 r2 架構對齊席)
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, cfg_warns, explicit = _drift_config(txt)
    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
    # 開關不是 block 時講一聲——只在專案自己寫了開關、或已經接線時(代碼審 r1 外家席:關掉了要看得見);
    # 還沒接線又沒寫設定時預設本來就是 warn,每個專案每次 doctor 都多一行只是噪音(代碼審 r3:那一行也破壞既有測試
    # t_doctor_summary_admits_soft_reminders 的軟段計數)
    if mode != "block" and (wired or explicit):
        src = (f"({cfg_warns[0]})" if cfg_warns else "(.lumos/config.json 的 drift_check)" if explicit
               else "(沒寫設定,這是預設值)")
        out.append(f"這個專案的存量漂移檢查是 {mode}{src}——轉正後留著預告句的推送不會被擋")
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
    if wired and ymls and "drift check" not in body:
        out.append("專案 CI 沒呼叫 `lumos drift check`,`--no-verify` 推上去的沒人查——CI 在 note-audit 那步後面加:"
                   + _DRIFT_CI_STEP)
    return out


# doctor 給消費專案貼的 CI 步驟:before 原樣交(空的換成 40 個 0),帶 --push-remote origin --pushed-ref "$GITHUB_REF",
# 起點由 lumos 的 _push_range_start 算(推送閘接漂移檢查代碼審 r2:原本的 shell 補法在合過主線、新分支首推一次帶多個提交時算錯)。
# 呼叫那兩行跟工具鏈自己的 .github/workflows/ci.yml 那步逐字相同(t_doctor_drift_ci_template_start_fallback 比對並真的跑一次)。
# ★說明寫成 YAML 註解、縮排對齊步驟★(代碼審 r2 外家否決席):整段貼進 workflow 的 steps 底下要能被解析;
# Python 3.14 那句也寫成註解,不接共用的 _CI_PY314_NOTE(另兩處範本的同一個問題另開 Issue)。
_DRIFT_CI_STEP = """
    - name: drift check
      if: github.event_name == 'push'
      env:
        BEFORE: ${{ github.event.before }}
        SHA: ${{ github.sha }}
      run: |
        [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
        python3 scripts/lumos drift check --diff "$BEFORE..$SHA" --push-remote origin --pushed-ref "$GITHUB_REF" --repo .
    # checkout 要設 fetch-depth: 0。起點由 lumos 算:跟主線(origin 的預設分支優先)的分岔點與 before 取比較新的。
    # 回傳碼照原樣讓這步紅綠:0 是沒有要處理或 warn 模式只印;1 是 block 模式擋下;
    # 其他非零是工具出錯或參數錯,也會紅——工具出錯時寧可紅。
    # 這一步要在 Python 3.14 上跑:actions/setup-python 的 python-version 設 "3.14";lumos 的最低版本是 3.14,舊版會回 2 並說明。"""


# ── 考試 ─────────────────────────────────────────────────────────────────────────────

def _drift_set_status_text(text, status):
    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    if not e:
        return text
    fm = edit_fm_scalar(lines[1:e], "status", status)
    fm, _s = edit_fm_sync_status_tag(fm, status)
    return "\n".join(lines[:1] + fm + lines[e:])


def _drift_exam_probe(root, vault_rel, q, probes):
    """probe 題(乙):把那篇筆記的那一行在起點與終點兩版都換成改寫檔給的條件式,對 event_commit 跑 check,
    那一行在「要處理」算擋到。不改被考 repo(只在記憶體裡換)。"""
    pb = (probes or {}).get(q.get("id"))
    if not pb:
        return "略過:改寫檔沒有這一題", 0, 0, 0
    c = _lens_full_sha(root, pb.get("event_commit") or "")
    par = _lens_full_sha(root, f"{pb.get('event_commit')}^") if c else None
    if c is None or par is None:
        return "略過:找不到 event_commit 或它的上一版", 0, 0, 0
    vr = _drift_vault_rel(root, c) or vault_rel
    note = q.get("note_at_event") or q.get("note")
    orig, new = str(q.get("text", "")).strip(), str(pb.get("rewrite", "")).strip()

    def _swap(where, v):
        env = _drift_tree_env(root, where, v)
        t = env_text(env, note) if env is not None else None
        if t is None:
            return None, None
        lines = t.split("\n")
        hit = [i for i, ln in enumerate(lines) if ln.strip() == orig]
        for i in hit:
            ind = lines[i][:len(lines[i]) - len(lines[i].lstrip())]
            lines[i] = ind + new
        return {note: "\n".join(lines)}, (hit[0] + 1 if hit else None)
    ov_tip, line_tip = _swap(c, vr)
    ov_base, _lb = _swap(par, _drift_vault_rel(root, par) or vr)
    if ov_tip is None or line_tip is None:
        return "略過:終點那一版找不到那一行", 0, 0, 0
    must, listed, unknown = _drift_check_core(root, par, c, vr, override=ov_tip, override_base=ov_base)
    hit_kind = next((f["kind"] for f in must if f["path"] == note and f["line"] == line_tip), None)
    others_m = _drift_exam_others(must, note, line_tip, hit_kind)
    others_l = _drift_exam_others(listed, note, line_tip, hit_kind)
    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
    return ("擋到" if hit_kind else "漏"), len(others_m), len(others_l), noise


def _drift_exam_one(root, vault_rel, q, at_sha, probes=None):
    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
    ev = q.get("exam_event")
#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Enzo Hsieh
# SPDX-License-Identifier: MIT
# MIT licensed. Full text: scripts/lumos header, or LICENSE at
# https://github.com/EnzoHsieh-Android/Lumos
# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
#
# 為什麼需要:
#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
#
# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
#
# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# ── stdin 必須最先讀(prepush範圍修法 #1)──
# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
_PP_LINES=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
done

_ZERO="0000000000000000000000000000000000000000"
_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"

# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
pp_range_for() {
  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    printf '%s..%s' "$_EMPTY_TREE" "$2"
  else
    printf '%s..%s' "$1" "$2"
  fi
}

# 會擋的閘「rc1 擋、其他非零放行」,但回傳碼 128 以上是被訊號殺掉(多半是 Ctrl-C)——那不是工具錯誤,不能當成放行往下跑。
# 每支檔有家、筆記形狀擋、雙向門放行、code-loop check、存量漂移檢查都先過這一支(推送閘接漂移檢查代碼審 r2 架構對齊席:
# 原本只有漂移那道會停)。$1=回傳碼 $2=閘名。
pp_stop_if_signaled() {
  if [[ "$1" -ge 128 ]]; then
    echo "$2被中斷(rc=$1),推送停下,後面的檢查不跑。" >&2
    exit "$1"
  fi
}

# 推送的遠端名(git 傳給掛鉤的第一個參數;直接推網址時是網址、手動跑時是空的)——存量漂移檢查拿它找主線。
_PP_REMOTE="${1:-}"

# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
pp_touched_file() {
  local _f _r
  [[ -n "$_EMPTY_TREE" ]] || return 0
  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
  _f="$_PP_TMP/touched.txt"
  : > "$_f" 2>/dev/null || return 0
  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    read -r _ _lsha _ _rsha <<< "$_ppl"
    [[ "$_lsha" == "$_ZERO" ]] && continue
    _r="$(pp_range_for "$_rsha" "$_lsha")"
    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
  done
  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
}

# 沒有 scripts/lumos → 降級放行(不為缺環境 brick push,CI 兜底);有 lumos 卻找不到 Python 3.14 → 擋下
# (Projects/最低Python版本改3.14_計劃 做法第 3 點;PY 在下面讀完設定後才決定)
GRAPHCTL="$REPO_ROOT/scripts/lumos"
PY=""
# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
# LUMOS_PYTHON 有設就先試它:找不到時的說明叫人設它,第一步就不能不認。只收絕對路徑、而且真的是 python
# (post-commit 直接把程式交給它跑,不經 lumos 驗;設成 /usr/bin/true 會假成功、漏寫跳過帳);不合格就記下原因往下找,
# 版本夠不夠仍由 lumos 判。LUMOS_PYTHON 被略過、改用別支時當場印原因與後果:lumos 自己只認 LUMOS_PYTHON,
# 之後的檢查會因同一個值擋下(代碼審 r3、r4;印在這段裡,七個呼叫端不必各寫一份)。
_lumos_any_python() {
  if _lumos_any_python_find; then
    if [ -n "$_LUMOS_ANY_NOTE" ]; then
      printf '%s改用 %s;但 lumos 只認 LUMOS_PYTHON,之後提交與推送前的檢查會因這個值擋下——修正它或 unset LUMOS_PYTHON。\n' \
        "$_LUMOS_ANY_NOTE" "$_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG}" >&2
    fi
    return 0
  fi
  _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
  return 1
}
_lumos_any_python_find() {
  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""; _LUMOS_ANY_NOTE=""
  if [ -n "${LUMOS_PYTHON:-}" ]; then
    case "$LUMOS_PYTHON" in
      /*|[A-Za-z]:[\\/]*)
        if [ -x "$LUMOS_PYTHON" ] && [ "$("$LUMOS_PYTHON" -c 'print("LUMOS_PY_OK")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY_OK" ]; then
          _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0
        fi
        _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不存在、不能執行或不是 python,略過。
" ;;
      *) _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不是絕對路徑,略過(相對路徑會隨目前目錄解析到別的檔)。
" ;;
    esac
  fi
  for _c in python3.14 python3.15 python3.16; do
    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
  done
  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
  else
    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
  fi
  _ifs="$IFS"; IFS=":"
  for _d in $_dirs; do
    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
  done
  IFS="$_ifs"
  for _c in python3 python; do
    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
  done
  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
  return 1
}
_LUMOS_NO_PY_BASE="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
_LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
# ── python-launcher end ──
# ── python-314 begin(pre-commit 與 pre-push 內嵌同一段):用上面找到的 python 問 lumos 要一支 3.14 的絕對路徑,
# 之後這支掛鉤的呼叫都用它;找不到就讓會擋的閘擋下,★不退回舊版 Python 跑檢查★(Projects/最低Python版本改3.14_計劃 [S3])。
_lumos_py314() {
  LUMOS_PY=""; _LUMOS_PY_ERR=""
  if ! _lumos_any_python; then _LUMOS_PY_ERR="$_LUMOS_NO_PY_MSG"; return 1; fi
  _out=""
  if _out="$("$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$REPO_ROOT/scripts/lumos" python-path 2>&1)"; then
    LUMOS_PY="$(printf '%s\n' "$_out" | tail -n 1 | tr -d '\r')"
    # 拿到的路徑要是絕對路徑、而且真的是 3.14 以上的 python 才用:後面每一道閘都由它跑,
    # 叫 lumos 的那支是假的(PATH 上一支會印 /usr/bin/true 的 python3.14)時,閘會全部假放行(代碼審 r3 外家席)
    case "$LUMOS_PY" in
      /*|[A-Za-z]:[\\/]*)
        if [ "$("$LUMOS_PY" -c 'import sys; print("LUMOS_PY314_OK" if sys.version_info >= (3, 14) else "OLD")' 2>/dev/null | tail -n 1 | tr -d '\r')" = "LUMOS_PY314_OK" ]; then
          return 0
        fi ;;
    esac
    _out="$_out
(lumos python-path 回的 $LUMOS_PY 不是絕對路徑、或執行起來不是 3.14 以上的 python)"
    LUMOS_PY=""
  fi
  _LUMOS_PY_ERR="$_out
(叫 lumos 用的是 $_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG};它一執行就失敗的話,可能是 Windows 商店替身)"
  return 1
}
_lumos_block_no_py314() {
  { echo ""; echo "擋下:這一道檢查要用 Python 3.14 跑 lumos,但找不到。"
    printf '%s\n' "$_LUMOS_PY_ERR" | sed 's/^/   /'
    echo "出口:裝 3.14,或設 LUMOS_PYTHON=<3.14 的絕對路徑>;真的要先過只能加 --no-verify(提交會記進跳過帳),不會改用舊版 Python 跑檢查。"
    echo ""; } >&2
}
# ── python-314 end ──

# ── 波及計算(給合約測試閘用):這裡只呼叫、不碰內容。
# ★一次推送只算一次波及★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):以前同步點名與合約測試閘各自呼叫,
# 等於一次推送算兩次——這不是便宜的計算。算一次寫進暫存檔給消費者讀。
# (2026-09-11 起同步點名改由每支檔有家照家算,不再讀這一份;見下面 sync_nudge 原位置的說明。)
# ★失敗隔離★:算不出來 → 暫存檔不存在或是空的 → 合約測試閘記一筆帳放行,不拖垮別的檢查。
_IMPACT_JSON=""
impact_once() {   # $1=diff range;算一次,結果放進 $_IMPACT_JSON
  _IMPACT_JSON=""
  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
  # ★用同檔既有的樣板寫法與命名家族★(代碼審 r1 架構對齊席):
  # 同一支腳本下面幾行就有 lumos-prepush-autoloop-XXXXXX / lumos-prepush-tests-XXXXXX,
  # 而且旁邊的註解特別說明過「★XXXXXX 必須在結尾★」是踩過才定下來的。
  local _f; _f="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-impact-XXXXXX" 2>/dev/null || true)"
  [ -n "$_f" ] || return 0
  if "$PY" "$GRAPHCTL" impact --diff "$1" --sync-check --json --repo "$REPO_ROOT" > "$_f" 2>/dev/null \
     && [ -s "$_f" ]; then
    _IMPACT_JSON="$_f"
  else
    rm -f "$_f"
  fi
}
impact_done() { [ -n "$_IMPACT_JSON" ] && rm -f "$_IMPACT_JSON"; _IMPACT_JSON=""; }
# ★硬擋或收到訊號時也要清★(代碼審 r1 外家否決席判 minor,屬實):
# 上面那支只在 ref 迴圈正常跑到尾端時執行。高風險那條路 rc1 會直接 exit 1,
# 收到訊號也一樣——每被硬擋一次就留一個暫存檔在 $TMPDIR 裡慢慢累積。
# 本次推送所有暫存檔的家,離開時整個清(r1 併發席:逐檔 rm 在 exit 1 / Ctrl-C 那條路會漏)。
# 建不出來就擋(r2 邊界席):空字串會讓後面每個 "$_PP_TMP/…" 變成根目錄路徑,測試 log 全寫不出來、擋下訊息一片空白。
_PP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/lumos-prepush-XXXXXX" 2>/dev/null || true)"
if [[ -z "$_PP_TMP" || ! -d "$_PP_TMP" ]]; then
  echo "擋下:推送前檢查需要一個暫存目錄,但 ${TMPDIR:-/tmp} 建不出來(不存在或不可寫);修好 TMPDIR 再推。" >&2
  exit 1
fi
trap 'impact_done; rm -rf "$_PP_TMP"' EXIT INT TERM
# (2026-09-11 起「該動哪篇」的點名改由每支檔有家照家算——下面 home check --diff 會印;原本這裡以反引號為種子的
#  impact --sync-only 會把人推回寫了一堆別人檔名的大雜燴節點,拿掉。Projects/每支檔有家_計劃 [S15]。impact_once 留給合約測試閘用。)
# ★合約測試閘:低風險也跑,紅了印出來記帳但不擋;高風險照舊擋★(人裁 2026-09-07)
# 不選「低風險也擋」的理由:擋下去最可能的結果不是人去修測試,是人改走 --no-verify
# ——而這支腳本自己在別的地方就把那條當第三選項在教,那條零留痕。
bound_tests_advisory() {   # $1=diff range(暫存檔沒算出來時退回自己算)
  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
  if [ -n "$_IMPACT_JSON" ]; then
    "$PY" "$GRAPHCTL" bound-tests --from-json "$_IMPACT_JSON" --advisory --repo "$REPO_ROOT" || true
  else
    "$PY" "$GRAPHCTL" bound-tests --diff "$1" --advisory --repo "$REPO_ROOT" || true
  fi
}
if [[ ! -f "$GRAPHCTL" ]]; then
  echo "提醒:這個 repo 沒有 scripts/lumos,推送前的知識庫檢查這次沒跑;推上去之後 CI 會再跑一遍兜底。" >&2
  exit 0
fi
# 只推刪除也擋:下面的錨點檢查不看這次推了哪些 ref、每次都叫 lumos,所以「這次要叫 lumos」恆成立(代碼審 r1 核過)。
if _lumos_py314; then
  PY="$LUMOS_PY"
else
  _lumos_block_no_py314
  exit 1
fi

# ★同一次推送的事件要串得起來★(#19 S6):這支是逐 ref 迴圈,而錨點與健檢跑在迴圈外面
# ——「當下的 commit」對整支層級的閘沒有唯一答案(同次推多個 ref、推的不是目前 checkout 的 ref、
# detached HEAD 或推 tag,盲取 HEAD 都會歸錯)。所以整支層級的事件改用這個一次性識別碼,
# 逐 ref 的事件另外帶那一行真正的 sha。lumos 端讀這個環境變數,hook 只負責產生它。
export LUMOS_PUSH_ATTEMPT="$(date -u '+%Y%m%dT%H%M%SZ')-$$"

# 錨點完整性:驗證器(runner/hooks)沒被動過,後面的「doctor 過/測試綠」才可信(repo 層,vault 無關)
if ! "$PY" "$GRAPHCTL" anchor verify; then
  {
    echo ""
    echo "擋下:負責把關的檔案(測試程式、hook 腳本)跟登記過的版本不一樣。"
    echo "這些檔案是裁判,裁判被改過而沒人簽名,後面所有「測試綠、檢查過」都不可信,所以先擋。"
    echo ""
    echo "三條路選一條:"
    echo "  1. 不是故意改的 → 把那個檔還原再推:"
    echo "       git checkout -- <檔案>"
    echo "  2. 是故意改的 → 簽名登記新版本再推:"
    echo "       lumos anchor approve --note \"為什麼改\""
    echo "  3. 真的要先推 → git push --no-verify(CI 之後會發現少了簽名紀錄)"
    echo ""
  } >&2
  exit 1
fi

# ★簽名檔要跟著推★(2026-09-06 實際被 CI 咬到):上面那道拿的是「工作目錄現在的樣子」,
# 所以你剛簽完名它就是綠的;但 CI 拿的是「已經推上去的內容」。簽名檔沒 commit 就推,
# 這邊全綠、CI 必紅——而且錯誤訊息會叫你再簽一次名,再簽也沒用,因為問題是沒提交。
_BASELINE="governance/anchor-baseline.json"
if [[ -f "$REPO_ROOT/$_BASELINE" ]] && ! git -C "$REPO_ROOT" diff --quiet -- "$_BASELINE" 2>/dev/null; then
  {
    echo ""
    echo "擋下:簽名檔改過了但沒提交,這樣推上去 CI 一定紅。"
    echo "你剛才簽了名(或它被更新過),但那個改動還留在工作目錄裡沒進版控;"
    echo "推送前的檢查看的是工作目錄所以是綠的,CI 看的是推上去的內容,對不起來。"
    echo ""
    echo "把它一起提交再推:"
    echo "       git add $_BASELINE && git commit -m \"gov: 錨點簽名\""
    echo ""
  } >&2
  exit 1
fi

# ══ 閘的順序(2026-09-06 全 repo 審視 #12 重排)══
# 便宜的先跑、貴的最後。實測:除了全套測試以外,所有閘加起來約 13 秒
# (anchor 0.22s / 簽名檔 0.04s / doctor 1.1s / pitfalls 0.23s / code-loop 0.61s
#  / test-layers 0.21s / 自主迴圈那支 10.3s),而全套是 8 分鐘。
# ★原本全套排在第四位★,所以被那 13 秒裡任何一道擋下時,8 分鐘已經白燒完了。
# (2026-09-30 加了存量漂移檢查,排在 code-loop 之後:小專案每個 ref 約 1 秒;最壞每個 ref 判定本體 60 秒的預算,
#  預算之前算範圍的 git 呼叫另計(每次最多 20 秒逾時),一次推多個 ref 會相加——所以上面那個 13 秒不再是上限。)

# 圖譜健康(只在 vault 存在時跑)
# ★2026-09-06 重排:原本這段在最後面,而且「沒有 vault 就 exit 0」會直接結束整支 hook。
#   現在它排在全套測試之前,那個 exit 0 會把後面的測試閘一起跳掉——所以改成只跳過這一段。
have_vault=0
for d in docs/*-knowledge docs/knowledge; do
  [[ -d "$d" ]] && have_vault=1 && break
done
_TOUCHED_F="$(pp_touched_file)"
_DOCTOR_ARGS=(doctor --ci)
[[ -n "$_TOUCHED_F" ]] && _DOCTOR_ARGS+=(--touched-from "$_TOUCHED_F")
if [[ $have_vault -eq 1 ]] && ! "$PY" "$GRAPHCTL" "${_DOCTOR_ARGS[@]}"; then
  {
    echo ""
    echo "擋下:知識庫健康檢查發現問題(細節在上面)。"
    echo "有問題的筆記推上去,下一個讀它的人會拿到錯的合約或斷掉的連結。"
    echo ""
    echo "三條路選一條:"
    echo "  1. 照上面的提示把筆記修好再推。"
    echo "  2. 覺得是檢查工具本身判錯 → 本機重跑一次確認,真的是工具錯就開一張 Issue 記下來。"
    echo "  3. 真的要先推 → git push --no-verify(CI 還是會跑全套,紅了會看到)"
    echo ""
  } >&2
  exit 1
fi


# 代碼偏科 + code-loop 必用守衛(tier=high):push 前把 diff 的代碼形態風險攤在眼前。
# prepush範圍修法(2026-07-21):改讀 stdin 推送範圍逐 ref 判,取代 merge-base——分支與
# main-direct 同軌;無基準(新 ref/缺物件)倒向保守掃 empty-tree..local_sha(非 fail-open,
# 否則守衛升格成穩定繞法);留痕綁 remote_ref 目的地(非 checkout);逐 ref 獨立判,某 ref
# high 未過即擋。fail-open 僅剩:pitfalls 本身出錯 / empty-tree 都跑不動。
# 推送前要跑哪個測試範圍(2026-09-18 Enzo 裁:純文件改動、或判成 light 的小改動,不用等全套):
# 每個 ref 各判一次,任何一個 ref 要全套就全套。docs=只改到 README/docs/assets 這類文件(pitfalls --json 的 suite);
# light=改到程式檔但 spec-gate --push-check 判成 light(風險低計劃、全靠人驗、小改動閘過)。
_SUITE_SEEN=0; _SUITE_FULL=0; _SUITE_LIGHT=0; _SUITE_KEYS=""; _SUITE_GRAPH=0; _AUTOLOOP_FULL=0
for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
  read -r _lref _lsha _rref _rsha <<< "$_ppl"
  # 刪除遠端 ref(local_sha 全零)→ 無代碼推送,跳過
  [[ "$_lsha" == "$_ZERO" ]] && continue
  # 推導檢查範圍(同一套推導另一個使用者是上面的圖譜健康那一段,所以抽成函式——
  # 兩處各寫一份的話,哪天保守兜底改了只改一邊,擋的範圍就會兩邊不一致)
  _range="$(pp_range_for "$_rsha" "$_lsha")"
  [[ -z "$_EMPTY_TREE" ]] && continue   # 連空樹都算不出=git 環境壞,advisory 放行

  # 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S26]):把這次要推的範圍整段查一次,接住跳過提交前檢查的。
  # ★新分支不沿用上面的空樹兜底★(那會把整段歷史當新改動,本工具鏈有 1900 多個提交):起點改用
  # 「不在任何遠端分支上的提交」裡最早那一個的上一個提交;全部已在遠端就不查;最早那個沒有上一個提交(真的全新)才從空樹比。
  # 起點早於這道檢查上線的那個提交時,lumos 會自己改從上線點算(上線前進來的是舊帳)。rc1=擋;其他非零=放行。
  # ★跟上面 _range 是刻意不同的兩套★(代碼審 r1 架構席問過):_range 給波及計算與風險掃描用,只提醒、寧可掃多;
  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
  _hrange=""
  if [[ "$_rsha" != "$_ZERO" ]] && git cat-file -e "$_rsha" 2>/dev/null; then
    _hrange="$_rsha..$_lsha"
  else
    _hold="$(git rev-list --topo-order --reverse "$_lsha" --not --remotes 2>/dev/null | head -1)"
    if [[ -n "$_hold" ]]; then
      if git rev-parse -q --verify "$_hold^" >/dev/null 2>&1; then
        _hrange="$(git rev-parse "$_hold^")..$_lsha"
      else
        _hrange="$_EMPTY_TREE..$_lsha"
      fi
    fi
  fi
  if [[ -n "$_hrange" ]]; then
    nh_rc=0
    "$PY" "$GRAPHCTL" home check --diff "$_hrange" --repo "$REPO_ROOT" || nh_rc=$?
    pp_stop_if_signaled "$nh_rc" "每支檔有家檢查"
    if [[ "$nh_rc" -eq 1 ]]; then
      {
        echo ""
        echo "逃生:照上面的指令替檔安家、或把說明改寫進對的那篇,再推;整個專案先改成只提醒 → .lumos/config.json 的 node_home.gate 設成 warn;緊急硬推 git push --no-verify(本機不留痕)。"
        echo ""
      } >&2
      exit 1
    fi
    # 筆記形狀擋(Projects/筆記形狀擋_計劃):同一段範圍再查一次,接住 --no-verify 跳過提交前那道的;範圍算法同上(不用空樹兜底)
    ns_rc=0
    "$PY" "$GRAPHCTL" note-shape --diff "$_hrange" --repo "$REPO_ROOT" || ns_rc=$?
    pp_stop_if_signaled "$ns_rc" "筆記形狀擋"
    if [[ "$ns_rc" -eq 1 ]]; then
      {
        echo ""
        echo "逃生:照上面改寫(行號改成函式名或測試名、或釘版本 路徑@<提交編號>:行號;現況描述刪掉或帶 [來源:…]);誤擋就 LUMOS_SKIP_NOTE_SHAPE=1 單次跳過(會留帳);整個專案先只提醒 → .lumos/config.json 的 note_shape.gate 設成 warn。"
        echo ""
      } >&2
      exit 1
    fi
  fi

  impact_once "$_range"
  pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
  _tier_high=0
  printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
  _SUITE_SEEN=1
  _suite_this="full"
  printf '%s' "$pf_json" | grep -q '"suite": *"docs"' && _suite_this="docs"
  printf '%s' "$pf_json" | grep -q '"suite_graph": *true' && _SUITE_GRAPH=1
  if [[ "$_tier_high" -eq 1 ]]; then
    {
      echo ""
      echo "提醒:這次推送的程式碼裡有高風險寫法(像是沒包交易的寫入、沒關的檔案控制代碼、沒限流的外部呼叫),tier=high。"
      echo "命中的地方列在下面:"
      "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
      echo ""
    } >&2
  fi
  # 留痕座標綁 remote_ref 目的地:refs/heads/* → 分支:★無條件★叫 check(表態閘 2026-09-09,Projects/棧別提問表態閘_計劃 S7):
  # 合約測試紅 / 有適用題表態不完整 / tier=high 無留痕,三個獨立判定各自出各自的訊息、由 check 印
  # ——這裡不再自己寫死「跑一輪代碼審」文案、也不再把它的輸出丟 /dev/null(r3 正確性席 C3)。非 heads → advisory。
  # 雙向門放行(Projects/雙向門放行_計劃 S11–S14/S21):這次範圍碰到、仍 doing、有雙向門留痕的計劃,留痕裡的測試全綠才准推;
  # 留痕過期(條款或它連到的節點變了)也擋。風險低計劃不派設計審,這裡是它唯一的閘;lumos 算不出範圍/索引就 fail-open 放行(rc≠1;128 以上是被中斷,停下)。
  sg_rc=0
  _sg_out="$_PP_TMP/sg-$RANDOM.log"
  # tee:一邊即時印到 stderr(r1 併發席:先存檔跑完才印,人會以為卡住去 Ctrl-C)、一邊留一份給下面認 light 用;rc 取管線第一段
  "$PY" "$GRAPHCTL" spec-gate --push-check "$_range" --repo "$REPO_ROOT" 2>&1 | tee "$_sg_out" >&2
  sg_rc="${PIPESTATUS[0]}"
  pp_stop_if_signaled "$sg_rc" "雙向門放行檢查(spec-gate)"
  # push-check 判成 light(它才有圖譜、才知道計劃風險低與小改動閘過):改到程式檔也不跑全套,
  # 只跑文件子集 + 原始碼提到「改到的函式/子命令/檔名」的測試;CI 那邊照樣跑全套當後盾。
  # ★還要 pitfalls 說 light_ok★(r1 資安席):小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
  # 會從它眼皮下溜過——範圍裡只要有一支這種檔,就不准少跑全套。
  if [[ "$_suite_this" == "full" ]] && grep -q '改動風險分級:light' "$_sg_out" && printf '%s' "$pf_json" | grep -q '"light_ok": *true'; then
    _suite_this="light"
    _k="$(printf '%s' "$pf_json" | "$PY" -c 'import json,sys; print(",".join(json.load(sys.stdin).get("affected_keys", [])))' 2>/dev/null || true)"
    [[ -n "$_k" ]] && _SUITE_KEYS="${_SUITE_KEYS:+$_SUITE_KEYS,}$_k"
    printf '%s' "$pf_json" | grep -q '"autoloop_full": *true' && _AUTOLOOP_FULL=1
  fi
  case "$_suite_this" in full) _SUITE_FULL=1 ;; light) _SUITE_LIGHT=1 ;; esac
  if [[ "$sg_rc" -eq 1 ]]; then
    echo "" >&2
    echo "風險低計劃的條款測試沒全綠(或留痕過期),推送擋下:把測試做綠、或重跑 lumos spec-gate <計劃> 之後再推。" >&2
    exit 1
  fi
  if [[ "$_rref" == refs/heads/* ]]; then
    _rbranch="${_rref#refs/heads/}"
    cl_rc=0
    # ★高風險這條路也把算好的那份傳進去★:不傳的話它會自己再算一次波及。
    _fj=(); [ -n "$_IMPACT_JSON" ] && _fj=(--from-json "$_IMPACT_JSON")
    # 低風險推送的受波及合約測試維持「只提醒不擋」(2026-09-07 全 repo 審視 #17 人裁);高風險不帶旗標,照擋
    # pitfalls 沒吐 JSON(暫時失敗)就不帶 advisory:讓 check 自己算 tier 決定擋不擋(r1 外家 finder f4/否決 f3)
    _ba=(); [[ -n "$pf_json" && "$_tier_high" -eq 0 ]] && _ba=(--bound-tests-advisory)
    _cl_out="$("$PY" "$GRAPHCTL" code-loop check --diff "$_range" --at-sha "$_lsha" --branch "$_rbranch" \
      --repo "$REPO_ROOT" ${_fj+"${_fj[@]}"} ${_ba+"${_ba[@]}"} 2>&1)" || cl_rc=$?
    pp_stop_if_signaled "$cl_rc" "code-loop check"
    if [[ "$cl_rc" -eq 1 ]]; then
      # 逃逸自動記(規格落成可驗收條件_計劃 第五節):推送閘擋下=下游抓到了設計審/規格閘放行後的洞,
      # 碰到的計劃筆記各記一筆;對不回就不記。★永遠 fail-open★——記帳失敗不能變成擋推送的第二個理由。
      # ★只認「受波及合約的測試沒過」那型★:缺表態/高風險缺留痕是流程沒走完,不是下游抓到缺陷,不進逃逸帳(首輪前掃訂正)
      if printf '%s' "$_cl_out" | grep -q "受波及合約的測試沒過"; then
        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate --severity major \
          --desc "推送閘擋下:$(printf '%s' "$_cl_out" | grep -m1 '受波及合約的測試沒過')" --range "$_range" --repo "$REPO_ROOT" >&2 || true
      fi
      # 高風險缺審查留痕:只有「該計劃被判成風險低、跳過設計審」才算逃逸(lumos 那邊查有沒有風險低留痕,沒有就不記)
      # ★只認「tier=high 且…」開頭的缺留痕句★:測試紅的擋下句尾巴也帶 tier=high,認整個詞會兩筆都記(r2 回滾席)
      if printf '%s' "$_cl_out" | grep -q "tier=high 且"; then
        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate-unreviewed --severity major \
          --desc "推送閘擋下:高風險缺審查留痕" --range "$_range" --repo "$REPO_ROOT" >&2 || true
      fi
      {
        echo ""
        printf '%s\n' "$_cl_out"
        echo ""
        echo "逃生路依上面 check 講的原因走:缺表態 → 先表態(上面的 dispositions 指令);高風險缺審查留痕 → 審過 lumos code-loop pass --note、或刻意不審 lumos code-loop skip --note \"為什麼\";合約測試紅 → 修測試。緊急硬推 git push --no-verify(本機不留痕,CI 會把這次推送標紅)"
        echo ""
      } >&2
      exit 1
    fi
    # rc=0(已收斂/已表態/skip):check 的提醒行(低風險合約測試紅、設定檔警告、表態閘小結)原樣給人看;rc≠0/1(異常,128 以上除外):fail-open 放行
    [ -n "$_cl_out" ] && { printf '%s\n' "$_cl_out" | grep -E '提醒|受波及合約測試|表態閘' >&2 || true; }
  else
    # 非分支 remote_ref(tag/其他 namespace):無 branch marker 通道,一律 advisory(r2 外家 F7)
    [[ "$_tier_high" -eq 1 ]] && echo "提醒:這次推的是 tag 不是分支,高風險檢查只提醒不擋(advisory)。" >&2
    if printf '%s' "$pf_json" | grep -q '"stack_questions_applicable": *{"'; then
      {
        echo ""
        echo "提醒:這次改到的技術棧有幾題效能檢核被觸發(推的是 tag,只提醒不擋),列在下面:"
        "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
        echo ""
      } >&2 || true
    fi
    bound_tests_advisory "$_range"
  fi
  # 存量漂移檢查(Projects/存量漂移防線_計劃〈做法〉第 4 節第 4 點、[S1][S18]):已經寫進圖譜的句子因為這次推送改了狀態而過期
  # (轉正了還留著預告句、計劃收尾了連著的 Issue 還開著…)。排在 code-loop check 之後、全套測試之前:code-loop 約 0.6 秒、
  # 這道最壞 60 秒、全套 8 分鐘,便宜的先跑。分支與 tag 都查(不像 code-loop 要分支名)。
  # 上線標記:下一行那串是 lumos 找「這道檢查從哪個提交起上線」用的(範圍起點截到那裡,上線前的是舊帳),別改寫也別刪:
# lumos drift check
  # 範圍原樣交 遠端舊值..本地頂端,連同遠端名與遠端 ref 名:起點由 lumos 的 _push_range_start 算(跟主線的分岔點與遠端舊值
  # 取比較新的;CI 那步也交給同一支),掛鉤不自己算——原本掛鉤、CI、工具各算一份,三份各有洞(代碼審 r2)。不用上面的 _range。
  # 模式由 lumos 讀被推送頂端提交的 .lumos/config.json(drift_check.gate,沒寫=warn):block 有要處理 rc1 → 擋;warn 只印 rc0;
  # off 它自己跳過。LUMOS_SKIP_DRIFT_CHECK=1 單次略過、淺層 clone 跳過,都由 lumos 記帳。每一筆的 lumos drift fix 修法由它印。
  # 回傳碼:1 → 擋;128 以上(被訊號殺掉,多半是 Ctrl-C)→ 整支掛鉤停下、不放行、不往下跑全套;
  # 其他非零(工具錯誤、git 太慢逾時、舊版工具沒有 drift 子命令)→ 講一句「這次沒檢查」再放行,
  # 跟每支檔有家、筆記形狀擋的「只認 rc1 擋」同一種處理(代碼審 r1 併發回滾席)。
  dr_rc=0
  "$PY" "$GRAPHCTL" drift check --diff "$_rsha..$_lsha" --push-remote "$_PP_REMOTE" --pushed-ref "$_rref" \
    --repo "$REPO_ROOT" || dr_rc=$?
  pp_stop_if_signaled "$dr_rc" "存量漂移檢查"
  if [[ "$dr_rc" -eq 1 ]]; then
    {
      echo ""
      echo "逃生:照上面每一筆的 lumos drift fix 指令改掉、或 lumos drift ack 表態照留(兩種都要提交進去才算),再推;誤擋就 LUMOS_SKIP_DRIFT_CHECK=1 git push 單次略過(會留帳);整個專案先只提醒 → .lumos/config.json 的 drift_check.gate 設成 warn。"
      echo ""
    } >&2
    exit 1
  fi
  if [[ "$dr_rc" -ne 0 ]]; then
    echo "漂移檢查沒能跑完(工具錯誤或 git 太慢),這次沒檢查;CI 會再檢查一次。(上面如果印了「擋下:」,指的是這道檢查自己沒跑成,推送沒有被擋。)" >&2
  fi
  # ★合約測試閘:低風險這一路也要跑★(2026-09-07 全 repo 審視 #17,人裁)
  # 舊行為:這件事藏在 code-loop check 裡,而那支只在 tier=high 且推的是分支時才跑
  # ——所以「改到硬合約就跑那些合約綁的測試」這句話,在低風險推送上是假的,
  # 而改一行低風險的碼一樣可以打破合約。
  # 高風險那條路已經在上面的 code-loop check 裡跑過(它會擋),這裡只補低風險那半。
  # (表態閘 2026-09-09 起)分支 ref 的低風險推送:合約測試已在上面的 code-loop check 裡以 advisory 跑過一次,這裡不再跑第二次;
  # tag 走上面 else 分支的 bound_tests_advisory。
  # test-layers 軟提醒(advisory,恆不影響 rc;無 .lumos/test-layers.json 靜默)
  "$PY" "$GRAPHCTL" test-layers --diff "$_range" --repo "$REPO_ROOT" 2>/dev/null || true
  impact_done
done

# ★第二支測試檔也要跑★(2026-09-06 全 repo 審視:CI 因此紅過一次)
# 這支只跑 12 秒,但一直以來只有 CI 在跑它——結果是「改了預設行為、跑了關鍵字子集、
# 推上去才被 CI 打回來」。紅在別支檔而不是你改的那支,是最難查的那種。
# ★log 檔改隨機名★(2026-09-06 全 repo 審視 #6):原本寫死 /tmp/lumos-prepush-*.log。
# 理由不是假想的攻擊,是已經發生過的碰撞——hook 測試平行跑時三次覆寫同一路徑,害過一次誤診
# (看到的是別人那次的輸出)。加上現在分片會同時起好幾個行程,更該各用各的。
# ★XXXXXX 必須在結尾★:macOS 的 mktemp 不吃「樣板中間有 XXXXXX」,會直接報
# 「File exists」——第一版寫成 -XXXXXX.log,四支 pre-push 測試當場翻紅。
_AUTOLOOP_LOG="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-autoloop-XXXXXX" 2>/dev/null || true)"
_TESTS_LOG="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-tests-XXXXXX" 2>/dev/null || true)"
# ★mktemp 失敗要講實話★(2026-09-07 通才審查席):這支沒有 set -e,mktemp 失敗時變數會是
# 空字串,後面的重導向自己先失敗,於是被判成「測試有紅」——**訊息會叫人去查測試,
# 而測試根本沒被跑過**。擋下 push 沒錯(保守方向),但理由說謊就會讓人查錯方向。
if [[ -z "$_AUTOLOOP_LOG" || -z "$_TESTS_LOG" ]]; then
  {
    echo ""
    echo "擋下:建不出暫存檔,所以這次的測試沒辦法跑。"
    echo "★不是測試紅了,是暫存目錄有問題★——多半是空間滿了或沒有寫入權限。"
    echo ""
    echo "先看一眼暫存目錄:"
    echo "      df -h \"${TMPDIR:-/tmp}\" && ls -ld \"${TMPDIR:-/tmp}\""
    echo ""
  } >&2
  exit 1
fi

# 純文件推送(每個 ref 都判成 docs)自主迴圈那支只跑讀真 CLAUDE.md 的那一條(2026-09-18 實推量到整支 68 秒,
# 而它 144 支裡只有這一條讀 repo 的文件,其餘測的是自主迴圈的程式);light 或全套照舊整支跑。CI 同一條規則。
# light 也一樣(2026-09-18 實測 light 推送前 108 秒、其中 67 秒是這支):除非 pitfalls 說 autoloop_full——
# 改到的檔名或函式名整字出現在這支測試裡(它測自主迴圈模組、主程式常數、兩支探針腳本),或抽不出任何關鍵字(不知道改了什麼)。
# 判斷在 lumos 裡做(_autoloop_full_for,整字比對跟執行器同一支 _keys_mentioned),這裡只讀結果(r1 架構席:別在 bash 另刻一份)。
_AUTOLOOP_ARGS=()
if [[ "$_SUITE_SEEN" -eq 1 && "$_SUITE_FULL" -eq 0 ]]; then
  _AUTOLOOP_ARGS=(-k real_claude_md)
  [[ "$_SUITE_LIGHT" -eq 1 && "$_AUTOLOOP_FULL" -eq 1 ]] && _AUTOLOOP_ARGS=()
fi
if [[ -d "$REPO_ROOT/skills/lumos-project-notes" && -f "$REPO_ROOT/scripts/test_autonomous_loop.py" ]]; then
  # 支數從實際輸出讀,不寫死——寫死的會靜靜地漂(2026-09-08:實際 144,訊息還印著 132)
  _autoloop_count() { sed -n 's/^Ran \([0-9]*\) tests.*/\1/p' "$_AUTOLOOP_LOG" | tail -1; }
  if ! "$PY" "$REPO_ROOT/scripts/test_autonomous_loop.py" ${_AUTOLOOP_ARGS+"${_AUTOLOOP_ARGS[@]}"} >"$_AUTOLOOP_LOG" 2>&1; then
    _AUTOLOOP_N="$(_autoloop_count)"
    {
      echo ""
      echo "擋下:test_autonomous_loop.py 有紅(自主迴圈那${_AUTOLOOP_N:+ $_AUTOLOOP_N }支)。"
      echo "完整輸出在這裡:"
      echo "   $_AUTOLOOP_LOG"
      tail -15 "$_AUTOLOOP_LOG" | sed 's/^/    /'
      echo ""
      echo "兩條路選一條:"
      echo "  1. 修到全綠再推(正常做法)。"
      echo "  2. 確定是測試本身不穩或環境問題 → git push --no-verify(後果自負;CI 還是會再跑一次)"
      echo ""
    } >&2
    exit 1
  fi
  _AUTOLOOP_N="$(_autoloop_count)"
  echo "  ✓ 自主迴圈那${_AUTOLOOP_N:+ $_AUTOLOOP_N }支也綠" >&2
fi
            rc=$?
            if [ "$rc" -eq 1 ]; then
              echo "::error::code-loop check 擋下(原因在上面:合約測試紅 / 效能檢核題沒表態 / 高風險代碼無審查留痕)——本機 pre-push 被繞過(--no-verify)或留痕失效;照上面 check 印的指令補留痕(dispositions / pass|skip --note)後重推"
              exit 1
            fi
            exit "$rc"
          }
      - name: note-shape gate (筆記形狀擋;--no-verify 後盾)
        # 筆記新寫的程式行號引用、沒寫來源的 FACT/FLOW/DEP(Projects/筆記形狀擋_計劃)。note-shape 不重查「已經在主線上」
        # 的提交,主線=本地 main 的 upstream;推 main 時 origin/main 就是這次的頂端,lumos 看到頂端已在主線裡就不拿它排除。
        # 本 workflow 只在推 main 時跑這步;建本地 main 那行是給 PR / 其他分支觸發的專案照抄用的(doctor 給的也是這步)。
        # 前一版原樣交給 lumos:40 個 0(新分支首推)或本機找不到(force-push 後的舊頂端)時,它自己判——頂端落後或等於主線頂端就不查,
        # 其他從跟主線的分岔點算(2026-09-28 漏網 ESC-61fc2d87;繞過本機掛鉤又 force-push 改寫主線屬存心繞過,不在範圍)。
        if: github.event_name == 'push'
        env:
          BEFORE: ${{ github.event.before }}
          SHA: ${{ github.sha }}
        run: |
          git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*'
          git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true
          [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
          python scripts/lumos note-shape --diff "$BEFORE..$SHA" --repo . || {
            rc=$?
            if [ "$rc" -eq 1 ]; then
              echo "::error::note-shape 擋下(原因在上面):筆記新寫了程式行號引用或沒寫來源的現況描述——本機提交前/推送前被繞過(--no-verify)或用了 LUMOS_SKIP_NOTE_SHAPE 單次跳過;改寫那幾行後重推,或把專案的 note_shape.gate 設成 warn"
              exit 1
            fi
            exit "$rc"
          }
      - name: drift check (存量漂移檢查;--no-verify 後盾)
        # 已經寫進圖譜的句子因為這次推送改了狀態而過期(轉正了還留著預告句…;Projects/存量漂移防線_計劃 [S1][S18])。
        # 起點:before 原樣交(空的換成 40 個 0),帶 --push-remote origin --pushed-ref "$GITHUB_REF"(Actions 內建),由 lumos 算
        # ——跟主線(origin 的預設分支優先、跳過就是這次推的那條)的分岔點與 before 取比較新的;推 main 本身時主線候選都被跳過,
        # 用 before。原本在這裡用 shell 補(before 找不到就改用頂端的父提交),合過主線與新分支一次帶多個提交時算錯(代碼審 r2)。
        # 主線候選是 checkout(fetch-depth: 0)抓下來的 origin/*,這步不依賴前面 note-shape 那步的 fetch。
        # 模式照被推送頂端提交的 .lumos/config.json(drift_check.gate,沒寫=warn):warn 只印、回 0,CI 不紅;block 有要處理回 1,
        # 印擋下原因、CI 紅;其他非零(參數錯、工具出錯)照原碼讓 CI 紅——工具出錯時寧可紅,跟上面 code-loop gate、note-shape 兩步同一個慣例
        # (推送前掛鉤對其他非零是放行並講一句「這次沒檢查」,兩邊刻意不同:CI 是最後一道後盾)。
        # 排在 code-loop gate 之後;全套測試在這步前面(既有安排,沒搬),跟防線計劃 [S18] 字面不同,理由寫在 Systems/存量漂移守衛。
        if: github.event_name == 'push'
        env:
          BEFORE: ${{ github.event.before }}
          SHA: ${{ github.sha }}
        run: |
          [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
          python scripts/lumos drift check --diff "$BEFORE..$SHA" --push-remote origin --pushed-ref "$GITHUB_REF" --repo . || {
            rc=$?
            if [ "$rc" -eq 1 ]; then
              echo "::error::drift check 擋下(每一筆與 lumos drift fix 修法在上面):這次推送讓筆記跟狀態對不上——本機推送前被繞過(--no-verify)或用了 LUMOS_SKIP_DRIFT_CHECK 單次略過;照上面的指令改掉或 lumos drift ack 表態後重推,或把專案的 drift_check.gate 設成 warn"
              exit 1
            fi
            exit "$rc"
          }
      - name: Anchor verify (baseline 缺失必紅)
        run: |
          test -f governance/anchor-baseline.json || { echo "anchor baseline 缺失"; exit 1; }
          python scripts/lumos anchor verify

