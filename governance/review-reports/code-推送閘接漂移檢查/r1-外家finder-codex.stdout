   193	trap 'impact_done; rm -rf "$_PP_TMP"' EXIT INT TERM
   194	# (2026-09-11 起「該動哪篇」的點名改由每支檔有家照家算——下面 home check --diff 會印;原本這裡以反引號為種子的
   195	#  impact --sync-only 會把人推回寫了一堆別人檔名的大雜燴節點,拿掉。Projects/每支檔有家_計劃 [S15]。impact_once 留給合約測試閘用。)
   196	# ★合約測試閘:低風險也跑,紅了印出來記帳但不擋;高風險照舊擋★(人裁 2026-09-07)
   197	# 不選「低風險也擋」的理由:擋下去最可能的結果不是人去修測試,是人改走 --no-verify
   198	# ——而這支腳本自己在別的地方就把那條當第三選項在教,那條零留痕。
   199	bound_tests_advisory() {   # $1=diff range(暫存檔沒算出來時退回自己算)
   200	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
   201	  if [ -n "$_IMPACT_JSON" ]; then
   202	    "$PY" "$GRAPHCTL" bound-tests --from-json "$_IMPACT_JSON" --advisory --repo "$REPO_ROOT" || true
   203	  else
   204	    "$PY" "$GRAPHCTL" bound-tests --diff "$1" --advisory --repo "$REPO_ROOT" || true
   205	  fi
   206	}
   207	if [[ ! -f "$GRAPHCTL" ]]; then
   208	  echo "提醒:這個 repo 沒有 scripts/lumos,推送前的知識庫檢查這次沒跑;推上去之後 CI 會再跑一遍兜底。" >&2
   209	  exit 0
   210	fi
   211	# 只推刪除也擋:下面的錨點檢查不看這次推了哪些 ref、每次都叫 lumos,所以「這次要叫 lumos」恆成立(代碼審 r1 核過)。
   212	if _lumos_py314; then
   213	  PY="$LUMOS_PY"
   214	else
   215	  _lumos_block_no_py314
   216	  exit 1
   217	fi
   218	
   219	# ★同一次推送的事件要串得起來★(#19 S6):這支是逐 ref 迴圈,而錨點與健檢跑在迴圈外面
   220	# ——「當下的 commit」對整支層級的閘沒有唯一答案(同次推多個 ref、推的不是目前 checkout 的 ref、
   221	# detached HEAD 或推 tag,盲取 HEAD 都會歸錯)。所以整支層級的事件改用這個一次性識別碼,
   222	# 逐 ref 的事件另外帶那一行真正的 sha。lumos 端讀這個環境變數,hook 只負責產生它。
   223	export LUMOS_PUSH_ATTEMPT="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
   224	
   225	# 錨點完整性:驗證器(runner/hooks)沒被動過,後面的「doctor 過/測試綠」才可信(repo 層,vault 無關)
   226	if ! "$PY" "$GRAPHCTL" anchor verify; then
   227	  {
   228	    echo ""
   229	    echo "擋下:負責把關的檔案(測試程式、hook 腳本)跟登記過的版本不一樣。"
   230	    echo "這些檔案是裁判,裁判被改過而沒人簽名,後面所有「測試綠、檢查過」都不可信,所以先擋。"
   231	    echo ""
   232	    echo "三條路選一條:"
   233	    echo "  1. 不是故意改的 → 把那個檔還原再推:"
   234	    echo "       git checkout -- <檔案>"
   235	    echo "  2. 是故意改的 → 簽名登記新版本再推:"
   236	    echo "       lumos anchor approve --note \"為什麼改\""
   237	    echo "  3. 真的要先推 → git push --no-verify(CI 之後會發現少了簽名紀錄)"
   238	    echo ""
   239	  } >&2
   240	  exit 1
   241	fi
   242	
   243	# ★簽名檔要跟著推★(2026-09-06 實際被 CI 咬到):上面那道拿的是「工作目錄現在的樣子」,
   244	# 所以你剛簽完名它就是綠的;但 CI 拿的是「已經推上去的內容」。簽名檔沒 commit 就推,
   245	# 這邊全綠、CI 必紅——而且錯誤訊息會叫你再簽一次名,再簽也沒用,因為問題是沒提交。
   246	_BASELINE="governance/anchor-baseline.json"
   247	if [[ -f "$REPO_ROOT/$_BASELINE" ]] && ! git -C "$REPO_ROOT" diff --quiet -- "$_BASELINE" 2>/dev/null; then
   248	  {
   249	    echo ""
   250	    echo "擋下:簽名檔改過了但沒提交,這樣推上去 CI 一定紅。"
   251	    echo "你剛才簽了名(或它被更新過),但那個改動還留在工作目錄裡沒進版控;"
   252	    echo "推送前的檢查看的是工作目錄所以是綠的,CI 看的是推上去的內容,對不起來。"
   253	    echo ""
   254	    echo "把它一起提交再推:"
   255	    echo "       git add $_BASELINE && git commit -m \"gov: 錨點簽名\""
   256	    echo ""
   257	  } >&2
   258	  exit 1
   259	fi
   260	
   261	# ══ 閘的順序(2026-09-06 全 repo 審視 #12 重排)══
   262	# 便宜的先跑、貴的最後。實測:除了全套測試以外,所有閘加起來約 13 秒
   263	# (anchor 0.22s / 簽名檔 0.04s / doctor 1.1s / pitfalls 0.23s / code-loop 0.61s
   264	#  / test-layers 0.21s / 自主迴圈那支 10.3s),而全套是 8 分鐘。
   265	# ★原本全套排在第四位★,所以被那 13 秒裡任何一道擋下時,8 分鐘已經白燒完了。
   266	
   267	# 圖譜健康(只在 vault 存在時跑)
   268	# ★2026-09-06 重排:原本這段在最後面,而且「沒有 vault 就 exit 0」會直接結束整支 hook。
   269	#   現在它排在全套測試之前,那個 exit 0 會把後面的測試閘一起跳掉——所以改成只跳過這一段。
   270	have_vault=0
   271	for d in docs/*-knowledge docs/knowledge; do
   272	  [[ -d "$d" ]] && have_vault=1 && break
   273	done
   274	_TOUCHED_F="$(pp_touched_file)"
   275	_DOCTOR_ARGS=(doctor --ci)
   276	[[ -n "$_TOUCHED_F" ]] && _DOCTOR_ARGS+=(--touched-from "$_TOUCHED_F")
   277	if [[ $have_vault -eq 1 ]] && ! "$PY" "$GRAPHCTL" "${_DOCTOR_ARGS[@]}"; then
   278	  {
   279	    echo ""
   280	    echo "擋下:知識庫健康檢查發現問題(細節在上面)。"
   281	    echo "有問題的筆記推上去,下一個讀它的人會拿到錯的合約或斷掉的連結。"
   282	    echo ""
   283	    echo "三條路選一條:"
   284	    echo "  1. 照上面的提示把筆記修好再推。"
   285	    echo "  2. 覺得是檢查工具本身判錯 → 本機重跑一次確認,真的是工具錯就開一張 Issue 記下來。"
   286	    echo "  3. 真的要先推 → git push --no-verify(CI 還是會跑全套,紅了會看到)"
   287	    echo ""
   288	  } >&2
   289	  exit 1
   290	fi
   291	
   292	
   293	# 代碼偏科 + code-loop 必用守衛(tier=high):push 前把 diff 的代碼形態風險攤在眼前。
   294	# prepush範圍修法(2026-07-21):改讀 stdin 推送範圍逐 ref 判,取代 merge-base——分支與
   295	# main-direct 同軌;無基準(新 ref/缺物件)倒向保守掃 empty-tree..local_sha(非 fail-open,
   296	# 否則守衛升格成穩定繞法);留痕綁 remote_ref 目的地(非 checkout);逐 ref 獨立判,某 ref
   297	# high 未過即擋。fail-open 僅剩:pitfalls 本身出錯 / empty-tree 都跑不動。
   298	# 推送前要跑哪個測試範圍(2026-09-18 Enzo 裁:純文件改動、或判成 light 的小改動,不用等全套):
   299	# 每個 ref 各判一次,任何一個 ref 要全套就全套。docs=只改到 README/docs/assets 這類文件(pitfalls --json 的 suite);
   300	# light=改到程式檔但 spec-gate --push-check 判成 light(風險低計劃、全靠人驗、小改動閘過)。
   301	_SUITE_SEEN=0; _SUITE_FULL=0; _SUITE_LIGHT=0; _SUITE_KEYS=""; _SUITE_GRAPH=0; _AUTOLOOP_FULL=0
   302	for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
   303	  read -r _lref _lsha _rref _rsha <<< "$_ppl"
   304	  # 刪除遠端 ref(local_sha 全零)→ 無代碼推送,跳過
   305	  [[ "$_lsha" == "$_ZERO" ]] && continue
   306	  # 推導檢查範圍(同一套推導另一個使用者是上面的圖譜健康那一段,所以抽成函式——
   307	  # 兩處各寫一份的話,哪天保守兜底改了只改一邊,擋的範圍就會兩邊不一致)
   308	  _range="$(pp_range_for "$_rsha" "$_lsha")"
   309	  [[ -z "$_EMPTY_TREE" ]] && continue   # 連空樹都算不出=git 環境壞,advisory 放行
   310	
   311	  # 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S26]):把這次要推的範圍整段查一次,接住跳過提交前檢查的。
   312	  # ★新分支不沿用上面的空樹兜底★(那會把整段歷史當新改動,本工具鏈有 1900 多個提交):起點改用
   313	  # 「不在任何遠端分支上的提交」裡最早那一個的上一個提交;全部已在遠端就不查;最早那個沒有上一個提交(真的全新)才從空樹比。
   314	  # 起點早於這道檢查上線的那個提交時,lumos 會自己改從上線點算(上線前進來的是舊帳)。rc1=擋;其他非零=放行。
   315	  # ★跟上面 _range 是刻意不同的兩套★(代碼審 r1 架構席問過):_range 給波及計算與風險掃描用,只提醒、寧可掃多;
   316	  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
   317	  _hrange=""
   318	  if [[ "$_rsha" != "$_ZERO" ]] && git cat-file -e "$_rsha" 2>/dev/null; then
   319	    _hrange="$_rsha..$_lsha"
   320	  else
   321	    _hold="$(git rev-list --topo-order --reverse "$_lsha" --not --remotes 2>/dev/null | head -1)"
   322	    if [[ -n "$_hold" ]]; then
   323	      if git rev-parse -q --verify "$_hold^" >/dev/null 2>&1; then
   324	        _hrange="$(git rev-parse "$_hold^")..$_lsha"
   325	      else
   326	        _hrange="$_EMPTY_TREE..$_lsha"
   327	      fi
   328	    fi
   329	  fi
   330	  if [[ -n "$_hrange" ]]; then
   331	    nh_rc=0
   332	    "$PY" "$GRAPHCTL" home check --diff "$_hrange" --repo "$REPO_ROOT" || nh_rc=$?
   333	    if [[ "$nh_rc" -eq 1 ]]; then
   334	      {
   335	        echo ""
   336	        echo "逃生:照上面的指令替檔安家、或把說明改寫進對的那篇,再推;整個專案先改成只提醒 → .lumos/config.json 的 node_home.gate 設成 warn;緊急硬推 git push --no-verify(本機不留痕)。"
   337	        echo ""
   338	      } >&2
   339	      exit 1
   340	    fi
   341	    # 筆記形狀擋(Projects/筆記形狀擋_計劃):同一段範圍再查一次,接住 --no-verify 跳過提交前那道的;範圍算法同上(不用空樹兜底)
   342	    ns_rc=0
   343	    "$PY" "$GRAPHCTL" note-shape --diff "$_hrange" --repo "$REPO_ROOT" || ns_rc=$?
   344	    if [[ "$ns_rc" -eq 1 ]]; then
   345	      {
   346	        echo ""
   347	        echo "逃生:照上面改寫(行號改成函式名或測試名、或釘版本 路徑@<提交編號>:行號;現況描述刪掉或帶 [來源:…]);誤擋就 LUMOS_SKIP_NOTE_SHAPE=1 單次跳過(會留帳);整個專案先只提醒 → .lumos/config.json 的 note_shape.gate 設成 warn。"
   348	        echo ""
   349	      } >&2
   350	      exit 1
   351	    fi
   352	  fi
   353	
   354	  impact_once "$_range"
   355	  pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
   356	  _tier_high=0
   357	  printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
   358	  _SUITE_SEEN=1
   359	  _suite_this="full"
   360	  printf '%s' "$pf_json" | grep -q '"suite": *"docs"' && _suite_this="docs"
   361	  printf '%s' "$pf_json" | grep -q '"suite_graph": *true' && _SUITE_GRAPH=1
   362	  if [[ "$_tier_high" -eq 1 ]]; then
   363	    {
   364	      echo ""
   365	      echo "提醒:這次推送的程式碼裡有高風險寫法(像是沒包交易的寫入、沒關的檔案控制代碼、沒限流的外部呼叫),tier=high。"
   366	      echo "命中的地方列在下面:"
   367	      "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
   368	      echo ""
   369	    } >&2
   370	  fi
   371	  # 留痕座標綁 remote_ref 目的地:refs/heads/* → 分支:★無條件★叫 check(表態閘 2026-09-09,Projects/棧別提問表態閘_計劃 S7):
   372	  # 合約測試紅 / 有適用題表態不完整 / tier=high 無留痕,三個獨立判定各自出各自的訊息、由 check 印
   373	  # ——這裡不再自己寫死「跑一輪代碼審」文案、也不再把它的輸出丟 /dev/null(r3 正確性席 C3)。非 heads → advisory。
   374	  # 雙向門放行(Projects/雙向門放行_計劃 S11–S14/S21):這次範圍碰到、仍 doing、有雙向門留痕的計劃,留痕裡的測試全綠才准推;
   375	  # 留痕過期(條款或它連到的節點變了)也擋。風險低計劃不派設計審,這裡是它唯一的閘;lumos 算不出範圍/索引就 fail-open 放行(rc≠1)。
   376	  sg_rc=0
   377	  _sg_out="$_PP_TMP/sg-$RANDOM.log"
   378	  # tee:一邊即時印到 stderr(r1 併發席:先存檔跑完才印,人會以為卡住去 Ctrl-C)、一邊留一份給下面認 light 用;rc 取管線第一段
   379	  "$PY" "$GRAPHCTL" spec-gate --push-check "$_range" --repo "$REPO_ROOT" 2>&1 | tee "$_sg_out" >&2
   380	  sg_rc="${PIPESTATUS[0]}"
   381	  # push-check 判成 light(它才有圖譜、才知道計劃風險低與小改動閘過):改到程式檔也不跑全套,
   382	  # 只跑文件子集 + 原始碼提到「改到的函式/子命令/檔名」的測試;CI 那邊照樣跑全套當後盾。
   383	  # ★還要 pitfalls 說 light_ok★(r1 資安席):小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
   384	  # 會從它眼皮下溜過——範圍裡只要有一支這種檔,就不准少跑全套。
   385	  if [[ "$_suite_this" == "full" ]] && grep -q '改動風險分級:light' "$_sg_out" && printf '%s' "$pf_json" | grep -q '"light_ok": *true'; then
   386	    _suite_this="light"
   387	    _k="$(printf '%s' "$pf_json" | "$PY" -c 'import json,sys; print(",".join(json.load(sys.stdin).get("affected_keys", [])))' 2>/dev/null || true)"
   388	    [[ -n "$_k" ]] && _SUITE_KEYS="${_SUITE_KEYS:+$_SUITE_KEYS,}$_k"
   389	    printf '%s' "$pf_json" | grep -q '"autoloop_full": *true' && _AUTOLOOP_FULL=1
   390	  fi
   391	  case "$_suite_this" in full) _SUITE_FULL=1 ;; light) _SUITE_LIGHT=1 ;; esac
   392	  if [[ "$sg_rc" -eq 1 ]]; then
   393	    echo "" >&2
   394	    echo "風險低計劃的條款測試沒全綠(或留痕過期),推送擋下:把測試做綠、或重跑 lumos spec-gate <計劃> 之後再推。" >&2
   395	    exit 1
   396	  fi
   397	  if [[ "$_rref" == refs/heads/* ]]; then
   398	    _rbranch="${_rref#refs/heads/}"
   399	    cl_rc=0
   400	    # ★高風險這條路也把算好的那份傳進去★:不傳的話它會自己再算一次波及。
   401	    _fj=(); [ -n "$_IMPACT_JSON" ] && _fj=(--from-json "$_IMPACT_JSON")
   402	    # 低風險推送的受波及合約測試維持「只提醒不擋」(2026-09-07 全 repo 審視 #17 人裁);高風險不帶旗標,照擋
   403	    # pitfalls 沒吐 JSON(暫時失敗)就不帶 advisory:讓 check 自己算 tier 決定擋不擋(r1 外家 finder f4/否決 f3)
   404	    _ba=(); [[ -n "$pf_json" && "$_tier_high" -eq 0 ]] && _ba=(--bound-tests-advisory)
   405	    _cl_out="$("$PY" "$GRAPHCTL" code-loop check --diff "$_range" --at-sha "$_lsha" --branch "$_rbranch" \
   406	      --repo "$REPO_ROOT" ${_fj+"${_fj[@]}"} ${_ba+"${_ba[@]}"} 2>&1)" || cl_rc=$?
   407	    if [[ "$cl_rc" -eq 1 ]]; then
   408	      # 逃逸自動記(規格落成可驗收條件_計劃 第五節):推送閘擋下=下游抓到了設計審/規格閘放行後的洞,
   409	      # 碰到的計劃筆記各記一筆;對不回就不記。★永遠 fail-open★——記帳失敗不能變成擋推送的第二個理由。
   410	      # ★只認「受波及合約的測試沒過」那型★:缺表態/高風險缺留痕是流程沒走完,不是下游抓到缺陷,不進逃逸帳(首輪前掃訂正)
   411	      if printf '%s' "$_cl_out" | grep -q "受波及合約的測試沒過"; then
   412	        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate --severity major \
   413	          --desc "推送閘擋下:$(printf '%s' "$_cl_out" | grep -m1 '受波及合約的測試沒過')" --range "$_range" --repo "$REPO_ROOT" >&2 || true
   414	      fi
   415	      # 高風險缺審查留痕:只有「該計劃被判成風險低、跳過設計審」才算逃逸(lumos 那邊查有沒有風險低留痕,沒有就不記)
   416	      # ★只認「tier=high 且…」開頭的缺留痕句★:測試紅的擋下句尾巴也帶 tier=high,認整個詞會兩筆都記(r2 回滾席)
   417	      if printf '%s' "$_cl_out" | grep -q "tier=high 且"; then
   418	        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate-unreviewed --severity major \
   419	          --desc "推送閘擋下:高風險缺審查留痕" --range "$_range" --repo "$REPO_ROOT" >&2 || true
   420	      fi
   421	      {
   422	        echo ""
   423	        printf '%s\n' "$_cl_out"
   424	        echo ""
   425	        echo "逃生路依上面 check 講的原因走:缺表態 → 先表態(上面的 dispositions 指令);高風險缺審查留痕 → 審過 lumos code-loop pass --note、或刻意不審 lumos code-loop skip --note \"為什麼\";合約測試紅 → 修測試。緊急硬推 git push --no-verify(本機不留痕,CI 會把這次推送標紅)"
   426	        echo ""
   427	      } >&2
   428	      exit 1
   429	    fi
