 33090	def _mainline_ref(repo_root, remote_only=False):
 33091	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 33092	    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
 33093	    拿它當「已在主線上」會把整批都排除掉)。"""
 33094	    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
 33095	        sha = _lens_full_sha(repo_root, cand)
 33096	        if sha:
 33097	            return cand, sha
 33098	    return None
 33099	
