 33120	def _lens_cache_path(repo_root, base_sha, head_sha, extra=""):
 33121	    import hashlib
 33122	    # repo 部分用 realpath(跟 armed 檔的 _lens_repo_key 同一種算法;code-codex-s1 r1 架構席:兩套 key 並存)
 33123	    # extra=表態記錄的 sha256(表態閘 S8):重表態之後舊快取自然 miss
 33124	    key = hashlib.sha256(f"{os.path.realpath(str(repo_root))}|{base_sha}|{head_sha}|schema{_LENS_SCHEMA}|{extra}".encode("utf-8")).hexdigest()   # 帶 schema 版本:v1.1 舊快取自然 miss(v1.2 r2 外家)
 33125	    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / f"{key}.json"
 33126	
 33127	
 33128	def _lens_cache_read(path, ttl_sec=1200):
 33129	    """只信自己 uid 擁有、group/other 不可寫、TTL 內的檔(r3 載荷席:$TMPDIR 路徑可預測可偽造)。"""
 33130	    import json as _json, stat as _stat, time as _time
 33131	    try:
 33132	        st = path.stat()
 33133	        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):
 33134	            return None
 33135	        if _time.time() - st.st_mtime > ttl_sec:
 33136	            return None
 33137	        return _json.loads(path.read_text(encoding="utf-8"))
 33138	    except (OSError, ValueError):
 33139	        return None
 33140	
 33141	
 33142	def _lens_cache_write(path, data):
 33143	    """★寫入端也要驗目錄★(2026-09-06 全 repo 審視 #6):原本直接 mkdir + chmod(0700),
 33144	    目錄若被換成指向別處的 symlink,就會把**別人的目錄**權限改掉。讀取端一直都有檢查,
 33145	    寫入端沒有——現在兩邊都走同一支 _trusted_private_dir。不過關就靜默不寫(fail-open)。"""
