/bin/zsh -lc "sed -n '24100,24230p' scripts/lumos && sed -n '26230,26680p' scripts/lumos && sed -n '28180,28460p' scripts/lumos && sed -n '17680,18140p' scripts/lumos && sed -n '18810,18875p' scripts/lumos" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-hook
 succeeded in 0ms:
        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
        notes = {}
        for p in g["paths"]:
            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
                continue
            new = after(p)
            n = _nodehome_parse_note(new) if new is not None else None
            olds = [b(g["src"].get(p, p)) for b in befores]
            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
            if n is not None and any(o["sig"] == n["sig"] for o in olds):
                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
            own, statuses = set(), set()
            for x in [n] + olds:
                if x is not None:
                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
                    statuses.add(x["status"])
            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
        g["content_notes"] = notes
    return groups


_NOTELINES_PRECOMMIT = "scripts/hooks/pre-commit"
_NOTELINES_PREPUSH = "scripts/hooks/pre-push"


def _nodehome_golive(repo_root, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。
    mark=要找的標記字串,預設是每支檔有家自己的;筆記形狀擋傳它自己的(Projects/筆記形狀擋_計劃 [S4])。"""
    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{mark or _NODEHOME_GOLIVE_MARK}",
                        tip or "HEAD", "--", hook)
    if not raw:
        return None
    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
    return first if _LENS_SHA_RE.match(first) else None


def _nodehome_clamp_base(repo_root, base, tip, mark=None, hook=_NOTELINES_PRECOMMIT):
    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。mark 見 _nodehome_golive。"""
    gl = _nodehome_golive(repo_root, tip, mark, hook)
    if gl is None:
        return base
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
    if r is None or r.returncode != 0:
        return base                                    # 上線點不在這條歷史上
    if base in (None, _EMPTY_TREE_SHA):
        return gl
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
    return gl if (r is not None and r.returncode == 0 and base != gl) else base


def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
    None=整批當成一個提交(提交前)。"""
    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
    homesN, ownN = _nodehome_homes(repo_root, N)
    homesB, ownB = _nodehome_homes(repo_root, B)
    blocks, reminders, pairs = [], [], []
    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
    for code, old, new in changes:
        if old is not None and (new is None or code == "R"):
            deleted.add(old)
        if new is None:
            continue
        changed_new.add(new)
        if code in ("A", "R", "C"):
            added.add(new)
        if code == "R" and old:
            renamed_from[new] = old
    code_changed = {p for p in changed_new if p in reqN}
    code_added = {p for p in added if p in reqN}
    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
    code_touched = code_changed | code_deleted
    vpre = vault_rel + "/"
    refs_cache = {}

    def refs_now(rel):
        if rel not in refs_cache:
            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
        return refs_cache[rel]

    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]
    edited = set()
    for p in sorted(changed_new):
        if not (p.startswith(vpre + "Systems/") and p.endswith(".md")):
            continue
        rel = p[len(vpre):]
        if rel not in N.notes:
            continue
        n = N.notes[rel]
        src = renamed_from.get(p)
        src_rel = src[len(vpre):] if src and src.startswith(vpre) else rel
        b = B.notes.get(src_rel)
        if n["type"] != "system":
            continue
        edited.add(rel)
        route_src[rel] = src_rel
        if (b is None or b["sig"] != n["sig"]) and n["status"] in _NODEHOME_HOME_STATUSES:
            content_changed.append(rel)
        # [S9] 規則二:這篇之後比之前多出來的別人的檔(新節點=全部都算新)
        foreign_now = refs_now(rel) - ownN.get(rel, set())
        foreign_before = (_nodehome_refs(b["text"], B, reqB) - ownB.get(src_rel, set())) if b else set()
        for f in sorted(foreign_now - foreign_before):
            blocks.append(("foreign", (rel, f, homesN.get(f, []))))
            pairs.append((f, rel))
        # [S17] 新開的、或這次才成為現況(planned/deferred 之類升成 doing/done/stale)的沒寫負責範圍;
        # [S18] 舊篇管的檔變多、超過上限、沒寫(只數還存在的檔)
        cnt_now = len({k for k in ownN.get(rel, set()) if k in N.files})
        becomes_home = n["status"] in _NODEHOME_HOME_STATUSES and (b is None or b["status"] not in _NODEHOME_HOME_STATUSES)
        resp_missing = False
        if b is None or becomes_home:
            if not _nodehome_resp_ok(n["resp"]):
                blocks.append(("new-node-resp", (rel, cnt_now)))
                resp_missing = True
        else:
            cnt_before = len({k for k in ownB.get(src_rel, set()) if k in B.files})
            if cnt_now > cnt_before and cnt_now > cfg["max_files"] and not _nodehome_resp_ok(n["resp"]):
                blocks.append(("over-limit-resp", (rel, cnt_now)))
        # [S11] 這次新蓋「從程式重建」章、卻一支檔都不管的節點:還原節點是圖譜重生的起點,
        # 一開始就沒說自己管哪些檔,之後每一次寫回都不知道該落哪篇。
        # 放行的唯一寫法是「這次一起寫一句負責範圍,講明它為什麼不管檔」——沿用舊文字不算交代。
        if (n["status"] in _NODEHOME_HOME_STATUSES          # 不是家就不歸這條管(planned/deferred/已作廢的不擋)
        print("沒有可以略過的行")
        return 0
    name = _note_audit_write_verdict(root, {"version": 1, "kind": "略過", "note": note.strip(),
                                            "rows": [{"id": i, "class": "SKIP"} for i in todo]})
    _gate_event_or_warn(root, "note-audit", "skipped", f"{name}:略過 {len(todo)} 行:{note.strip()[:80]}")
    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
    return 0


# ═══════════════════════════════════════════════════════════════════════════════════
# 存量漂移守衛(Projects/存量漂移防線_計劃;家 [[Systems/存量漂移守衛]])
# 已經寫進圖譜的句子,因為別處的狀態變了而過期——這裡是「甲」:狀態指令連帶處理(五種狀態一致檢查、
# 計劃收尾時列連帶待辦、推送時只擋「這次轉正、預告句還留著」)。「乙」(回頭條件改成機器能判的條件)接在後面。
# ═══════════════════════════════════════════════════════════════════════════════════
_DRIFT_CLOSED = ("done", "superseded")
_DRIFT_OPEN_ISSUE = ("open", "doing")
# c4 的關鍵詞。★清單裡刻意不放「工作樹」★:「釘在某提交的乾淨工作樹」是合法的可重現寫法,本來就不含這三個詞;
# 同一句裡同時有「未提交」與「工作樹」照樣成立(考卷 E3 就是這樣寫,設計審 r3 接手席)
_DRIFT_UNCOMMITTED_WORDS = ("未提交", "還沒提交", "uncommitted")
_DRIFT_KINDS = ("probe", "c1", "c2", "c3", "c4", "c5")
_DRIFT_KIND_NAMES = {"c1": "轉正了還寫預告", "c2": "計劃收尾了、連著的 Issue 還開著",
                     "c3": "計劃收尾了、驗證紀錄還待定", "c4": "前提寫「還沒提交」",
                     "c5": "轉正做了一半", "probe": "回頭條件成立了"}
_DRIFT_ACKS = "governance/drift-acks.jsonl"
# 修復帳(drift fix 每改一筆記一行稽核紀錄;存量漂移改法 第 7 節)。★稽核紀錄,不是還原工具★:要退回用 git;
# 帳也是乾淨檢查認得「工具自己的改動」的依據。進簿記檔名單 _BOOKKEEPING_FILES(那邊寫的是同一個字串)
_DRIFT_FIXES = "governance/drift-fixes.jsonl"
_DRIFT_FIX_KINDS = ("c1", "c2", "c3", "c4", "c5")
_DRIFT_BOUND_KINDS = ("c2", "c3")          # 表態要綁當時連著的已收尾計劃(related)與序號(seq)的種類
_DRIFT_GOLIVE_MARK = "drift check"
_DRIFT_GATE_VALUES = ("block", "warn", "off")
# ★沒寫設定時的預設★(計劃〈做法〉第 4 節第 4 點):三條門檻(考卷正例全對、工具鏈歷史重放不亂擋、噪音 ≤5)
# 都過才改成 block;還沒考就是 warn。
_DRIFT_DEFAULT_GATE = "warn"
_DRIFT_BUDGET_SEC = 60


def _drift_str(n, key):
    v = n.fields.get(key, "") if n is not None else ""
    return v.strip() if isinstance(v, str) else ""


def _drift_fm_end(lines):
    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
    if not lines or lines[0].strip() != "---":
        return 0
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return i
    return 0


def _drift_field_line(text, key, pred=None):
    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    for i in range(1, e):
        m = TOP_KEY_RE.match(lines[i])
        if not (m and m.group(1) == key):
            continue
        if pred is None:
            return i + 1
        for j in range(i, e):
            if j > i and TOP_KEY_RE.match(lines[j]):
                break
            if pred(lines[j]):
                return j + 1
        return i + 1
    return 1


def _drift_line_text(text, ln):
    """第 ln 行(1 起算)實際的字(去頭尾空白)——欄位層級的發現也用實際那一行,表態才對得上
    (代碼審 r1 正確性席、外家席:原本組一句「status: open」,那一行寫成 status: "open" 就永遠表態不到)。"""
    lines = text.split("\n")
    return lines[ln - 1].strip() if 0 < ln <= len(lines) else ""


def _drift_c3_hit(env, vrel, override=None, ti=None):
    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
    n = env.notes.get(vrel)
    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
        return None
    if GUARD_MARK_FIELD in n.fields:
        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
    if not refs:
        return None
    ti = ti if ti is not None else build_typed_index(env)
    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
    if any(not link_target(x) for x in refs) \
            or any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
        return None
    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
    if not plans:
        return None
    for prel in plans:
        pn = env.notes.get(prel)
        if pn is None or _drift_str(pn, "type") != "project":
            return None
        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
            return None
    return plans


def _drift_linked(env, rel):
    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
    out_e, in_e = env.edges
    got = {}
    for d in out_e.get(rel, []):
        got[d] = "out"
    for s in in_e.get(rel, []):
        got[s] = "both" if s in got else "in"
    return got


def _drift_state_findings(env, only=None):
    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
    only=要算的路徑集合(None=全部)。"""
    out = []
    ti = build_typed_index(env)
    for rel, n in sorted(env.notes.items()):
        if only is not None and rel not in only:
            continue
        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
            out += _drift_guard_findings(env, rel, n, st)
        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
            out += _drift_c2(env, rel)
        if ty == "verification":
            plans = _drift_c3_hit(env, rel, ti=ti)
            if plans:
                text = env_text(env, rel) or ""
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
        vu = n.fields.get("valid_under")
        vtxt = " ".join(as_list(vu)) if vu else ""
        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
            text = env_text(env, rel) or ""
            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
    return out


def _drift_c2(env, rel):
    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
             if _drift_str(env.notes.get(p), "type") == "project"
             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
    if not plans:
        return []
    text = env_text(env, rel) or ""
    ln = _drift_field_line(text, "status")
    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]


def _drift_guard_findings(env, rel, n, st):
    """守衛紀錄的 c1(轉正了還寫預告,一句一筆)與 c5(轉正做了一半)。"""
    text = env_text(env, rel)
    if text is None:
        return []
    out = []
    lines = text.split("\n")
    if st == "pass":
        regs = _notelines_regions(text)
        for i, ln in enumerate(lines):
            k = _guard_planned_prose(ln, regs[i])
            if k:
                out.append({"kind": "c1", "path": rel, "line": i + 1, "text": ln.strip(), "related": [],
                            "why": "已轉正(status: pass)但還留著預告句"})
    elif st == "pending":
        m = re.search(r"^預告的合約:(.+)$", text, re.M)
        home = env.resolve(link_target(_guard_home_of_fields(n.fields))) if _guard_home_of_fields(n.fields) else None
        htext = env_text(env, home) if home else None
        if m and htext is not None:
            hl = htext.split("\n")
            if _guard_formal_line(hl, _drift_fm_end(hl), m.group(1).strip(), None) is not None:
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c5", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [home],
                            "why": f"家筆記 {home[:-3]} 已經是正式合約行——重跑 lumos guard settle 補完"})
    return out


def _drift_plan_followups(env, rel, new_status):
    """lumos set <計劃> status done|superseded 要列的連帶待辦(計劃〈做法〉第 1 節第 3 點)→ [(種類, 路徑, 說明)]。
    只讀筆記、不跑 git、不寫;不是計劃或不是收尾狀態回 []。
    驗證紀錄走 build_typed_index 的反向索引(代碼審 r1 架構對齊席:不自己拿 env.resolve 猜同名第一篇);
    只寫檔名、同名猜不準的另列一項「猜不準」,讓人自己看。"""
    n = env.notes.get(rel)
    if n is None or _drift_str(n, "type") != "project" or new_status not in _DRIFT_CLOSED:
        return []
    out = []
    names = {"out": "計劃連到它", "in": "它連到計劃", "both": "互相連"}
    for p, d in sorted(_drift_linked(env, rel).items()):
        pn = env.notes.get(p)
        if _drift_str(pn, "type") == "issue" and _drift_str(pn, "status") in _DRIFT_OPEN_ISSUE:
            out.append(("Issue", p, f"{_drift_str(pn, 'status')},{names[d]}"))
    ti = build_typed_index(env)
    for p in sorted({s for s, et in ti["rev"].get(rel, []) if et == "plan_refs"}):
        if _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            out.append(("驗證紀錄", p, "pending,plan_refs 指的計劃都已收尾"))
    out += _drift_status_probe_followups(env, rel, new_status)
    for src, lit, et, cands in ti["ambiguous"]:
        sn = env.notes.get(src)
        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
    return out


def _drift_status_probe_followups(env, rel, new_status):
    """連帶待辦第③項(乙,[S15]):[when-status:<這份計劃>=…] 的 status 條件因這次收尾成立的回頭條件——只做文字比對,
    不跑 git;同一行還有別的條件時註明,不宣稱整行成立。env 是改之前的圖譜:舊狀態本來就在值裡的,條件早就成立,
    不是這次收尾造成的,不列(代碼審 r1 正確性席、外家席:doing→done 對 =doing|done 原本也說成因這次成立)。"""
    out = []
    old = _drift_str(env.notes.get(rel), "status")
    for p in sorted(env.notes):
        for no, _tx, pr in _probe_lines(env_text(env, p) or "")[0]:
            hit = [v for k, v in pr["conds"] if k == "status" and _probe_value_err(k, v) is None
                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
                   and new_status in (vals := {x.strip() for x in v.partition("=")[2].split("|")}) and old not in vals]
            if hit:
                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
    return out


def _drift_print_followups(env, rel, new_status):
    items = _drift_plan_followups(env, rel, new_status)
    if not items:
        return
    print(f"連帶待辦(這份計劃收尾了,下面 {len(items)} 篇連著它;只列出、不擋——連結有時只是參考,是不是該結案要人看):")
    ti = build_typed_index(env)
    for kind, p, why in items:
        print(f"  · {kind} {p[:-3]}({why})")
        print(f"      看:lumos context {_esc_clean(_drift_sh(p[:-3], node=True), 300)}")
        if kind == "驗證紀錄" and _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            # c3 那一項給改法指令(存量漂移改法 [S10];單一產生處 _drift_fix_hint)
            ln = _drift_field_line(env_text(env, p) or "", "status")
            print(f"      改:{_drift_fix_hint('c3', p, ln)[0]}")


# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────

def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    pre = vault_rel.rstrip("/") + "/"
    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
    import time as _t
    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
    blobs = _drift_cat(root, where, paths, left) if paths else []
    if blobs is None:
        return None
    texts, bad = {}, []
    for p, b in zip(paths, blobs):
        if b is None:
            # 樹上列得出、內容讀不出來:建成讀不出的筆記(代碼審 r2 外家席:原本跳過,等於當成不存在)
            bad.append(p[len(pre):])
            continue
        try:
            texts[p[len(pre):]] = b.decode("utf-8-sig")
        except UnicodeDecodeError:
            bad.append(p[len(pre):])
    texts.update(override or {})
    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])


def _drift_vault_rel(root, where):
    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        return None
    wv = _vault_in(Path(root))
    try:
        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
    except ValueError:
        wv_rel = None
    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]


def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
    import time as _t
    pre = vault_rel.rstrip("/") + "/"
    if deadline is not None and _t.monotonic() > deadline:
        return None
    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _drift_empty_tree(root), tip, "--", vault_rel)
    if raw is None:
        return None
    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
               if x.strip("\n").startswith(pre)}
    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
              and _drift_str(n, "status") in _DRIFT_CLOSED}
    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "verification" and st == "pass",
                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
    if passed is None:
        return None
    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
    if closed is None:
        return None
    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}


def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None, override_base=None):
    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
    import time as _t

    def _left():
        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
    if tenv is None:
        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
    if _left() <= 0:
        return [], [], [over]
    reader = _nodehome_reader(root, tip)
    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
    if ev is None:
        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
               if _note_unreadable(n) and p in ev["touched"]]
    must, listed = [], []
    for f in _drift_state_findings(tenv):
        p, k = f["path"], f["kind"]
        if k == "c1":
            if p in ev["passed"]:
                must.append(f)
            continue
        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
        if hit:
            listed.append(f)
    if _left() <= 0:
        return must, listed, [*unknown, over]
    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
    return must + pm, listed + pl, unknown + pu



# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
_PROBE_KEYS = ("file", "symbol", "test", "status")
_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")


def _revisit_split(line):
    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
    import datetime
    if line.lstrip().startswith("|"):
        return None, None
    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
    if not s.startswith("REVISIT:"):
        return None, None
    rest = s[len("REVISIT:"):]
    if rest.lstrip().startswith("[when-"):
        return "cond", rest
    try:
        datetime.date.fromisoformat(rest.partition(" ")[0])
        return "date", rest
    except ValueError:
        return "bad", rest


def _revisit_lines(text):
    """一篇筆記的每一條回頭條件 → [(行號, 種類, 日期或 None, 摘要, 原文)];種類 date/cond/bad(同 _revisit_split)。
    剝程式碼區(_search_visible_lines)、餵剝過行內程式碼的那一版給 _revisit_split。doctor E5 與 set 把 Issue 結案時的列出
    共用這一支(存量漂移改法 第 6 節);乙的 _probe_lines、第一層、第二層各自的逐行迴圈不在這裡。"""
    out = []
    for no, raw, _pr in _search_visible_lines(text.split("\n"), False):
        kind, rest = _revisit_split(_strip_inline_markup(raw)[0])
        if kind is None:
            continue
        date, summ = None, ""
        if kind == "cond":
            date, summ = _probe_parse(rest)["by"], _PROBE_LEAD_RE.sub("", rest)
        elif kind == "date":
            date, _sp, summ = rest.partition(" ")
        out.append((no, kind, date, summ.strip(), raw))
    return out


def _issue_close_revisits(env, rel, new_status):
    """lumos set <Issue> status <結案值>、drift fix --kind c2 --close 之後:列出這篇★全部★回頭條件(不只到期的),
    提示結案了要改成結案說明或刪掉。只印、不擋、不改;行號用寫完之後從磁碟重讀的內容算(存量漂移改法 [S7])。"""
    n = env.notes.get(rel)
    if _drift_str(n, "type") != "issue" or str(new_status).strip() not in _ISSUE_CLOSED_STATUSES:
        return
    try:
        text = _phys_path(env.vault, rel).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        return
    rows = _revisit_lines(text)
    if not rows:
        return
    print(f"這篇 Issue 結案了,還留著 {len(rows)} 行回頭條件——要改成結案說明或刪掉(只列出、不擋):")
    for no, _k, _d, _s, raw in rows:
        print(f"  · {_esc_clean(rel, 200)}:{no}  {_esc_clean(raw.strip(), 100)}")


def _probe_value_err(k, v):
    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
    if k not in _PROBE_KEYS:
        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
    if not v:
        return f"when-{k} 的值是空的"

    if k == "file":
        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
    if k in ("symbol", "test"):
        return _probe_named_err(k, v)
    node, eq, vals = v.partition("=")
    if not eq or not node.strip() or not vals.strip():
    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    if _drift_fix_record(env, cx, res) != 0:
        return 2
    print(f"✓ drift fix {kind}:{_esc_clean(rel, 200)} 第 {line} 行——{res['msg']}")
    if kind == "c2":
        _issue_close_revisits(env, rel, o["status"])
    print(f"修復帳要跟筆記一起提交:\n    {_drift_git_hint(cx, 'add ' + _DRIFT_FIXES)} && git commit")
    return 0


# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
    import json as _j
    if text is None:
        return _DRIFT_DEFAULT_GATE, [], False
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


def _drift_print_findings(rows, stream, acks=None, alive=None):
    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
              file=stream)
        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
        prev = _drift_prev_ack_line(f)
        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
        if prev:
            print(f"      ({_esc_clean(prev, 400)})", file=stream)
        elif old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  …還有 {len(rows) - 20} 筆", file=stream)


def cmd_drift_check(repo=None, diff_range=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
    import time as _t
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
        return 0
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
                                               mark=_DRIFT_GOLIVE_MARK)
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
    for w in warns:
        print(f"提醒:{w}", file=sys.stderr)
    if mode == "off":
        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
        return 0
    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
    acks = _drift_load_acks(root, tip)
    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
    lst = _nodehome_list(root, tip)
    alive = set(lst[1]) if lst else None
    if listed:
        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
        _drift_print_findings(listed, sys.stderr, acks, alive)
        _drift_print_hints(listed, sys.stderr)
    if not must and not unknown:
        return 0
    return _drift_report_must(root, mode, must, unknown, acks, alive)


def _drift_report_must(root, mode, must, unknown, acks, alive=None):
    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
    for u in unknown:
        print(f"  判不了:{_esc_clean(u, 1000)}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
    _drift_print_findings(must, sys.stderr, acks, alive)
    kinds = {f["kind"] for f in must}
    # 改法指令由 _drift_fix_hint 單一產生(存量漂移改法 [S10]):c1 到 c5 指到 lumos drift fix(c1 一篇一條),
    # 條件式回頭條件(probe)的修法不一樣,同一支給它自己的說法
    _drift_print_hints(must, sys.stderr, "改法(每一筆一條指令;c1 一篇一條):")
    if must:
        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
        for k in sorted(kinds):
            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
    if mode == "block":
        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
                            nodes=sorted({f["path"][:-3] for f in must})[:50])
        return 1
    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
    return 0


# ── 健檢與 doctor ────────────────────────────────────────────────────────────────────

def _drift_vault_of(env):
    root = _vault_repo_root(env)
    try:
        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        return root, env.vault.name


def cmd_drift_scan(env, at=None, as_json=False, budget=None):
    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
    import json as _j, math as _m, time as _t
    budget = _DRIFT_BUDGET_SEC if budget is None else budget
    if not _m.isfinite(budget) or not 0 < budget <= 86400:
        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
        return 2
    deadline = _t.monotonic() + budget
    root, vault_rel = _drift_vault_of(env)
    tenv, sha = env, None
    if at:
        sha = _lens_full_sha(root, at)
        if sha is None:
            print(f"擋下:找不到提交 {at}", file=sys.stderr)
            return 2
        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
        vault_rel = _drift_vault_rel(root, sha) or vault_rel
        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
        if tenv is None:
            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
            return 2
    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
    if as_json:
        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
                        "problems": [{"path": p, "line": n, "text": t, "why": w} for p, n, t, w in probs],
                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
                       ensure_ascii=False, indent=1))
        return 0
    _drift_scan_print(at, left, done, bad, probs)
    return 0


def _drift_scan_print(at, left, done, bad, probs=()):
    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)、回頭條件的問題。"""
    if bad:   # 路徑與原文都來自筆記,印之前換掉控制字元(代碼審 r5 資安席)
        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(_esc_clean(b) for b in bad[:10]))
    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
          + (f";已表態 {len(done)}" if done else ""))
    for k in _DRIFT_KINDS:
        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
        if rows:
            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
            for f, acked in rows:
                print(f"  {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 70)}" + ("  (已表態)" if acked else ""))
                if not acked:
                    print(f"      {_esc_clean(f['why'], 1000)}")
                    if _drift_prev_ack_line(f):
                        print(f"      ({_esc_clean(_drift_prev_ack_line(f), 400)})")
            _drift_print_hints([f for f, acked in rows if not acked], sys.stdout, "  改法:")
    if probs:
        print(f"[回頭條件的問題] {len(probs)} 處(寫錯、沒帶期限、指不到、寫在不評估的地方、判不了):")
        for p, n, t, w in probs:
            print(f"  {_esc_clean(p)}:{n}  {_esc_clean(t, 70)}")
            print(f"      {_esc_clean(w, 1000)}")


def _drift_doctor_lines(env):
    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
    root, vault_rel = _drift_vault_of(env)
    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
    out = []
    # 乙:只讀筆記、不評估條件(要看哪些成立跑 drift scan)
    n_rows = n_noby = n_bad = n_dead = 0
    for p in env.notes:
        rows, dead = _probe_lines(env_text(env, p) or "")
        n_rows += len(rows)
        n_dead += len(dead)
        n_noby += sum(1 for _n, _t, pr in rows if pr["by"] is None)
        n_bad += sum(1 for _n, _t, pr in rows if pr["errs"])
    if n_rows or n_dead:
        out.append(f"條件式回頭條件 {n_rows} 條(由 lumos drift scan 評估)"
                   + (f";沒帶期限 {n_noby} 條" if n_noby else "") + (f";寫錯的 {n_bad} 條" if n_bad else "")
                   + (f";寫在不評估的地方 {n_dead} 處" if n_dead else ""))
    for k in ("c1", "c2", "c3", "c4", "c5"):
        rows = [f for f in left if f["kind"] == k]
        nd = sum(1 for f in done if f["kind"] == k)
        if rows:     # 只剩已表態的不開段(全靜默;代碼審 r2 正確性席:表態完那一段永遠不會安靜);全部清單看 drift scan
            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else "")
                       + ";改法例:" + _drift_fix_hint(k, rows[0]["path"], rows[0]["line"])[0])
    return out


def _drift_gate_doctor_lines(repo_root):
    """doctor 開頭的閘提醒(照筆記形狀擋與筆記內容審那兩支的位置與呈現):開關不是 block,而且專案自己寫了開關或已經接線時講
    (沒寫設定也沒接線時預設就是 warn,每次都唸只是噪音;計劃 [S14] 已跟著改);
    只收專案根:鄰居多收的圖譜位置與 ci 旗標是給它們的事後掃描用的,這支沒有事後掃描(代碼審 r3 架構對齊席:抄了參數不用是死參數)。
    接線後(推送前掛鉤出現標記)專案 CI 沒呼叫 drift check 就給要貼的步驟。唯一的 git 呼叫是讀一次推送前掛鉤。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:        # .lumos 資料夾本身是捷徑也不跟(照 _note_audit_doctor_lines;代碼審 r2 架構對齊席)
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, cfg_warns, explicit = _drift_config(txt)
    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
    # 開關不是 block 時講一聲——只在專案自己寫了開關、或已經接線時(代碼審 r1 外家席:關掉了要看得見);
    # 還沒接線又沒寫設定時預設本來就是 warn,每個專案每次 doctor 都多一行只是噪音(代碼審 r3:那一行也破壞既有測試
    # t_doctor_summary_admits_soft_reminders 的軟段計數)
    if mode != "block" and (wired or explicit):
        src = (f"({cfg_warns[0]})" if cfg_warns else "(.lumos/config.json 的 drift_check)" if explicit
               else "(沒寫設定,這是預設值)")
        out.append(f"這個專案的存量漂移檢查是 {mode}{src}——轉正後留著預告句的推送不會被擋")
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
    if wired and ymls and "drift check" not in body:
        out.append("專案 CI 沒呼叫 `lumos drift check`,`--no-verify` 推上去的沒人查——CI 在 note-audit 那步後面加:"
                   "\n    - run: python3 scripts/lumos drift check --diff \"${{ github.event.before || "
                   "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"" + _CI_PY314_NOTE)
    return out


# ── 考試 ─────────────────────────────────────────────────────────────────────────────

def _drift_set_status_text(text, status):
    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
    lines = text.split("\n")
    e = _drift_fm_end(lines)
    if not e:
        return text
    fm = edit_fm_scalar(lines[1:e], "status", status)
    fm, _s = edit_fm_sync_status_tag(fm, status)
    return "\n".join(lines[:1] + fm + lines[e:])


def _drift_exam_probe(root, vault_rel, q, probes):
    """probe 題(乙):把那篇筆記的那一行在起點與終點兩版都換成改寫檔給的條件式,對 event_commit 跑 check,
    那一行在「要處理」算擋到。不改被考 repo(只在記憶體裡換)。"""
    pb = (probes or {}).get(q.get("id"))
    if not pb:
        return "略過:改寫檔沒有這一題", 0, 0, 0
    c = _lens_full_sha(root, pb.get("event_commit") or "")
    par = _lens_full_sha(root, f"{pb.get('event_commit')}^") if c else None
        return None  # 來源不可達 → 靜默 skip
    try:
        _ver_pat = re.compile(r'^LUMOS_VERSION\s*=\s*"(v\d+\.\d+)"', re.MULTILINE)
        src_text = src_lumos.read_text(encoding="utf-8", errors="replace")
        m = _ver_pat.search(src_text)
        if not m:
            return None
        src_ver = m.group(1)
    except OSError:
        return None

    # 3. 比對:CLAUDE 版本 < 來源版本 → nudge(簡單字串不等判準;版本是 advisory)
    if claude_ver == src_ver:
        return None
    # 嘗試 tuple 比對(vMAJOR.MINOR → (MAJOR, MINOR));取不到就用字串不等
    def _ver_tuple(s):
        try:
            parts = s.lstrip("v").split(".")
            return tuple(int(x) for x in parts)
        except (ValueError, AttributeError):
            return None
    ct = _ver_tuple(claude_ver)
    st = _ver_tuple(src_ver)
    if ct is not None and st is not None and ct >= st:
        return None  # CLAUDE 版本 ≥ 來源,不 nudge
    # CLAUDE 落後(或無法比較)→ 提示
    return (
        f"本專案紀律區塊版本 {claude_ver} 落後來源 {src_ver},"
        f" 可跑 lumos update 刷新"
    )


# vendored 工具組白名單(固定 5 檔,scripts/ 前綴;hooks/templates 兩夾另走整夾刪)。
# _vendor_toolchain 安裝端與 cmd_deinit 移除端共用,避免漂移。
_VENDORED_TOOLKIT = ("scripts/lumos", "scripts/test_lumos.py",
                     "scripts/merge-claude-settings.py", "scripts/graph-rename.sh",
                     "scripts/fetch-notesmd.sh")
_VENDORED_TREE_DIRS = ("scripts/hooks", "scripts/templates")   # 安裝時整個目錄照來源複製過去的那兩個
# ★工具確實會安裝進消費專案的每一支檔(精確檔名)★——跳過判斷只認這張表,不認目錄前綴。
# 2026-09-10 代碼審 r1 四席獨立抓到:原本照目錄前綴跳過,消費專案自己放在 scripts/hooks、
# scripts/templates 的程式會被當成工具的檔,推送閘的風險分級被降、逃過代碼審。
# 表要跟工具鏈 repo 裡那兩個目錄底下受版控的檔一模一樣:有一支測試逐檔比對,少登記或多登記都會翻紅。
_VENDORED_TREE_FILES = (
    "scripts/hooks/claude/_hookevent.py",
    "scripts/hooks/claude/check-graph-sync.py",
    "scripts/hooks/claude/ci-status-hook.py",
    "scripts/hooks/claude/memory-sweep.py",
    "scripts/hooks/claude/dispatch-lens-hook.py",
    "scripts/hooks/claude/impact-hook.py",
    "scripts/hooks/claude/lumos-entry-hook.py",
    "scripts/hooks/post-commit",
    "scripts/hooks/pre-commit",
    "scripts/hooks/pre-push",
    "scripts/templates/graph-discipline.md",
    "scripts/templates/note-audit-judge.md",
)
_VENDORED_ALL = frozenset(_VENDORED_TOOLKIT + _VENDORED_TREE_FILES)


_VENDORED_MANIFEST = ".lumos/vendored.json"   # 安裝/更新時記下每支工具檔的內容指紋


def _vendored_digest(data):
    """工具檔的內容指紋:換行統一成 LF 再算 sha256(Windows 的換行轉換不該讓指紋對不上)。"""
    import hashlib
    return hashlib.sha256(bytes(data).replace(b"\r\n", b"\n")).hexdigest()


def _vendored_manifest_write(root):
    """把工作目錄裡「工具自裝檔」的內容指紋寫進 .lumos/vendored.json(安裝與更新時呼叫;回寫進去的 {路徑: 指紋})。"""
    files = {}
    for rel in sorted(_VENDORED_ALL):
        p = Path(root) / rel
        if p.is_file():
            files[rel] = _vendored_digest(p.read_bytes())
    mp = Path(root) / _VENDORED_MANIFEST
    mp.parent.mkdir(parents=True, exist_ok=True)
    # 格式跟錨點基準線同一種({"version": 1, <路徑: sha256>…};第四輪架構席)。不走錨點那種「人核可才改」的流程:
    # 這份是安裝時的事實紀錄,錯了的方向是「多掃」不是「少擋」。ensure_ascii:從某版本讀回來走的是文字模式的 git show
    _write_lf(mp, json.dumps({"version": 1,
                              "note": "lumos 安裝時記下的工具檔內容指紋;內容對得上的才不算專案自己的程式",
                              "files": files}, ensure_ascii=True, indent=1) + "\n")
    return files


def _vendored_state(root, ref=None):
    """回 (原封不動的工具檔, 存在的工具檔) 兩個集合;ref=None 看工作目錄,否則看那個版本。

    ★原封不動=檔名在精確清單上,而且內容跟安裝時記下的指紋一模一樣★(2026-09-10 代碼審 r3 併發資源席:
    只比檔名的話,專案自己改了工具裝進來的檔、或把自己的程式放成工具的檔名,風險掃描就完全看不到)。
    指紋清單不在或讀不懂 → 原封不動的=空集合:一支都不跳,寧可多掃(舊版安裝的專案更新後就有清單)。"""
    present, data = set(), {}
    if ref is None:
        for p in sorted(_VENDORED_ALL):
            fp = Path(root) / p
            if fp.is_file():
                present.add(p)
                try:
                    data[p] = fp.read_bytes()
                except OSError:   # 讀不到(權限、被鎖)=不算原封不動、照樣掃(第四輪邊界席:原本直接噴錯中斷)
                    data[p] = None
        try:
            man = json.loads((Path(root) / _VENDORED_MANIFEST).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            man = None
    else:
        # 讀那個版本的檔用專案既有的 git show 包裝(第四輪架構席:第三輪另寫了一套 cat-file --batch 解析)
        for p in sorted(_VENDORED_ALL):
            r = _lens_git(root, "show", f"{ref}:{p}", binary=True)
            if r is None:                 # git 跑不起來 → 不知道 → 當成在、而且沒對上(照樣掃)
                present.add(p)
                data[p] = None
            elif r.returncode == 0:
                present.add(p)
                data[p] = r.stdout
        man = _json_at_ref(root, ref, _VENDORED_MANIFEST)
    files = man.get("files") if isinstance(man, dict) else None
    if not isinstance(files, dict):
        return frozenset(), frozenset(present)
    return (frozenset(p for p in present if data.get(p) is not None and files.get(p) == _vendored_digest(data[p])),
            frozenset(present))


def _diff_range_ends(root, diff_range):
    """git diff 的範圍拆成 (起點, 終點);終點 None=工作目錄。A..B、A..、A...B(起點取共同祖先)、單一版本。"""
    import subprocess
    r = str(diff_range).strip()
    if "..." in r:
        a, b = r.split("...", 1)
        a, b = a or "HEAD", b or "HEAD"
        try:
            mb = subprocess.run(["git", "merge-base", a, b], capture_output=True, text=True, errors="replace",
                                cwd=str(root), timeout=_disp_git_timeout())
            return (mb.stdout.strip() or a), b
        except (OSError, subprocess.TimeoutExpired):
            return a, b
    if ".." in r:
        a, b = r.split("..", 1)
        return (a or "HEAD"), (b or "HEAD")
    return r, None


def _is_toolchain_repo(root):
    """這個 repo 是不是工具鏈本體(那裡 scripts/lumos 就是產品,不能當成外來的跳過)。

    ★判別鍵沿用既有慣例★(見 `_self_repo_origin`):skills/lumos-project-notes/SKILL.md
    是 user-scope skill 的唯一源,永遠不會被複製進消費專案。"""
    try:
        return (Path(root) / "skills" / "lumos-project-notes" / "SKILL.md").is_file()
    except Exception:
        return False


def _vendored_skip(root, diff_range):
    """消費專案裡這段範圍要跳過的工具檔(工具鏈本體回空集合)。推送前分級與代碼審角色鏡頭共用這一支,見 _vendored_state:
    終點上原封不動的工具檔;終點上已經刪掉、但起點時原封不動的(拆除工具鏈)也跳。"""
    if _is_toolchain_repo(root):
        return frozenset()
    _start, _end = _diff_range_ends(root, diff_range)
    _intact_end, _present_end = _vendored_state(root, _end)
    _intact_start = _vendored_state(root, _start)[0] if _start else frozenset()
    return _intact_end | (_intact_start - _present_end)


def _pull_source_or_abort(src, allow_stale=False):
    """更新來源 clone;拉不到就中止。回傳 0=可繼續、None=中止(呼叫端不得再寫任何檔)。

    ★為什麼 fail-closed★:原本 pull 失敗只印一行警告就繼續 vendor,來源落後或有本機
    分歧時會靜默拿舊版蓋掉專案裡較新的檔——消費端實戰咬過兩次,那行警告混在一堆輸出裡
    根本看不到。「拿不到最新」與「確定這是最新」是兩種狀態,不該用同一條路走完。

    ★但無 remote 不算失敗★:手動複製 / slim 安裝出來的來源本就沒有 remote,那是合法的
    離線情境,擋它等於把離線使用者鎖在門外。只有「有 remote 卻拉不到」才中止。
    _vendor_toolchain(專案層) 與 cmd_bootstrap(機器層) 共用本函式,避免兩處政策漂移。
    """
    import subprocess
    if not (src / ".git").is_dir():
        print("  (來源非 git repo,跳過 pull)")
        return 0
    has_remote = subprocess.run(["git", "-C", str(src), "remote"],
                                capture_output=True, text=True, errors="replace").stdout.strip()
    if not has_remote:
        print("  (來源無 remote:離線 clone,跳過 pull)")
        return 0
    print("  git pull 來源(取最新工具組)…")
    if subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode == 0:
        return 0
    # ★來源「只髒了工具自己寫的帳」不該擋人★(2026-09-06 全 repo 審視 #5)
    # 症狀:唯讀的 `lumos show`/`context` 就會 append docs/.usage-log.jsonl,而那本帳是版控的。
    # 只要有人在來源 clone 裡查過一次圖譜,之後這台機器所有專案的 update / bootstrap --pull
    # 全部被 fail-closed 擋住;逃生門寫在錯誤訊息最後一行,沒人會讀到那裡。
    #
    # ★做法是「聯集合併」,不是 stash/pop★:這幾本是 append-only 的 JSONL,兩邊各自加了行,
    # stash pop 會判成衝突並★在帳本裡留下衝突標記★——那比原本擋住更糟,帳本直接壞掉、
    # 之後每次讀都炸(第一版真的踩到,實測留下 <<<<<<< 標記)。正確解是把兩邊的行取聯集:
    # 先把本機那份讀進記憶體 → checkout 回 HEAD → pull → 把本機獨有的行補回去。
    # 非 JSONL 的簿記檔(anchor-baseline.json 是一份 JSON 物件)不能這樣併,照原路擋下。
    dirty = subprocess.run(["git", "-C", str(src), "status", "--porcelain=v1", "-z"],
                           capture_output=True, text=True, errors="replace").stdout
    # ★用 -z 逐筆解析,不要對人看的格式做字串切片★(2026-09-06 代碼審 r1 外家席):
    # porcelain 的 rename 是 `R  old\0new`、含特殊字元的路徑在非 -z 模式會被 C-style 跳脫並加引號,
    # 光 strip('"') 解不開。-z 模式路徑原樣不跳脫;rename/copy 會多吃一個 NUL 欄位,我們直接
    # ★保守拒絕★(狀態碼含 R/C 就不自動併),寧可照原路擋下也不要判錯。
    paths, bad_shape = [], False
    if dirty:
        parts = dirty.split("\0")
        i = 0
        while i < len(parts):
            ent = parts[i]
            if not ent:
                i += 1
                continue
            xy, path = ent[:2], ent[3:]
            if "R" in xy or "C" in xy:      # rename/copy:後面還跟一個來源路徑,保守不併
                bad_shape = True
                i += 2
                continue
            paths.append(path)
            i += 1
    mergeable = (not bad_shape) and paths and all(
        p in _BOOKKEEPING_FILES and p.endswith(".jsonl") for p in paths)
    if paths and not mergeable and all(p in _BOOKKEEPING_FILES for p in paths):
        print("  (來源只髒了簿記檔,但其中有不是 append-only JSONL 的、或有改名——不自動併,照原路擋下)",
              file=sys.stderr)
    if mergeable:
        print(f"  來源只髒了工具自己寫的帳({len(paths)} 本 append-only)——取聯集後續拉,不丟任何一行")
        # ★先把本機那份存到磁碟再動 git★(2026-09-06 代碼審 r1 外家席):原本只存在記憶體,
        # checkout 之後若被 SIGKILL / 斷電 / 寫回失敗,那些★從未進過 git 物件庫★的行就永久消失
        # ——而且第一版的錯誤訊息還叫人用 `git checkout HEAD@{1}` 救,那是假的。
        import tempfile as _tf, shutil as _sh
        bak = Path(_tf.mkdtemp(prefix="lumos-bookkeeping-backup-"))
        saved = {}
        try:
            for rel in paths:
                f = src / rel
                saved[rel] = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
                _sh.copy2(f, bak / rel.replace("/", "__")) if f.exists() else None
        except OSError as e:
            print(f"  ⚠ 備份簿記帳失敗,照原路擋下(沒有動任何檔):{e}", file=sys.stderr)
            saved = None
        if saved is not None:
            print(f"    (動手前已備份到 {bak};全部併回成功才會刪)")
            subprocess.run(["git", "-C", str(src), "checkout", "--"] + paths,
                           capture_output=True, text=True, errors="replace")
            # ★比較對象是「拉之前的已提交版」,不是拉下來的內容★(2026-09-06 代碼審 r1 折入後
            # 自己的測試抓到):checkout 完檔案就等於 base。要補回的是「本機在 base 之上加了什麼」
            # ——拿拉下來的內容比,會在遠端剛好也加了同一行時把本機那筆當成重複吃掉。
            base = {}
            for rel in paths:
                f = src / rel
                base[rel] = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
            rc2 = subprocess.run(["git", "-C", str(src), "pull", "--ff-only"]).returncode
            all_ok = True
            for rel, old_lines in saved.items():
                f = src / rel
                try:
                    now = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
                    # ★用計數不用集合★(外家席):JSONL 是事件序列不是集合,同一行內容合法地出現
                    # 兩次是常態(同秒同節點的兩筆);set 判「有沒有」會把本機新增的那筆吃掉。
                    # 算的是「本機在 base 之上加了幾份」,加幾份就補幾份到拉下來的版本後面。
                    from collections import Counter as _C
                    need = _C(old_lines) - _C(base.get(rel, []))
                    extra = []
                    for l in old_lines:
                        if need[l] > 0:
                            extra.append(l)
                            need[l] -= 1
                    if extra:
                        raw = f.read_text(encoding="utf-8") if f.exists() else ""
                        sep = "" if (raw == "" or raw.endswith("\n")) else "\n"
                        with open(f, "a", encoding="utf-8") as fh:
                            fh.write(sep + "\n".join(extra) + "\n")
                        print(f"    {rel}:本機獨有的 {len(extra)} 行已補回")
                except OSError as e:
                    all_ok = False
                    print(f"  ⚠ {rel} 併回失敗——★那幾行還在備份裡★:{bak}/{rel.replace('/', '__')}\n"
                          f"    ({e})", file=sys.stderr)
            if all_ok:
                _sh.rmtree(bak, ignore_errors=True)
            if rc2 == 0:
                return 0
            print(f"  (pull 仍失敗;本機的帳已經併回,備份留在 {bak})", file=sys.stderr)
    if allow_stale:
        print("  ⚠ --allow-stale:pull 失敗,明示沿用現有來源繼續", file=sys.stderr)
        return 0
    print(f"擋下:工具鏈來源拉不到最新版(可能是網路不通、有本地改動擋住、或歷史分岔),先停。\n"
          f"  不會拿可能過期的來源蓋掉你的專案——默默裝到舊版這個坑踩過兩次。\n"
          f"  先去來源那邊處理:\n    cd {src} && git status && git pull --ff-only\n"
          f"  確定就要用現在這份來源:重跑並加 --allow-stale", file=sys.stderr)
    return None


_PY314_UPGRADE_NOTICE = (
    "\n升級注意:從這一版起 lumos 需要 Python 3.14(系統內建的 3.9 碰到深層巢狀的程式會整個崩潰)。\n"
    "  · 沒有 3.14 的機器,提交與推送前的檢查會擋下並說明怎麼裝(brew install python@3.14 / uv python install 3.14 /\n"
    "    winget install Python.Python.3.14)。\n"
    "  · 專案 CI 要用 3.14:actions/setup-python 的 python-version 設 \"3.14\",不然 lumos 在 CI 會回 2。\n"
    "  · 3.14 裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。\n"
    "  · 裝好之後跑一次 lumos install,讓 Claude/Codex 掛鉤也改用 3.14;Codex 的掛鉤命令列因此改變,\n"
    "    要再開一次互動 codex 審過(Hooks need review 畫面或 /hooks),不然 Codex 掛鉤不會跑、也不報錯。\n")

def _py314_upgrade_pending(root):
    """消費專案還沒升級到最低 Python 3.14 的版本(舊的 pre-commit 還沒用 python-path)→ True;複製完要印一次升級注意
    (Projects/最低Python版本改3.14_計劃 做法第 8 點;判斷不必另存狀態)。只有新版程式執行 update 時走得到這裡。"""
    old_pc = Path(root) / "scripts" / "hooks" / "pre-commit"
    try:
        return old_pc.is_file() and "python-path" not in old_pc.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def _vendor_toolchain(src, root, slug, no_pull=False, allow_stale=False):
    """從 Lumos 來源 src vendor 工具組到專案 root(python 單一源 scaffold + hooks + 結尾自癒)。
    回傳 0;來源無效回傳 None。圖譜資料受 _scaffold_project 的 skip 保護不被動。
    cmd_update / cmd_init(--with-hooks) 共用。"""
    import subprocess, shutil, filecmp
    installer = src / "scripts" / "install-graph-toolchain.sh"  # 仍作來源有效性探針(薄殼亦在)
    if not installer.exists():
        print(f"擋下:找不到 Lumos 工具鏈的來源({src} 底下沒有安裝腳本)。\n"
              f"  三種解法擇一:--source <路徑> 指定、設環境變數 $LUMOS_HOME、或 clone 到 ~/harness/lumos-toolchain",
              file=sys.stderr)
        return None
    if not no_pull:
        rc_p = _pull_source_or_abort(src, allow_stale)
        if rc_p is None:
            return None                      # fail-closed:一個檔都還沒動就退場
    # 安裝邏輯收進 python 單一源(scaffold + hooks);bash 安裝器僅留薄殼。
    _scaffold_project(root, slug)
    _init_additive_setup(root)     # 只加不覆寫;掛在這裡讓 `lumos update` 也能把設定骨架補給既有專案
    _set_hooks_path(root)          # 全域同步★不在這裡★——要等下面的 copy2 自癒把 vendored 檔換新
    rc = 0
    _py314_upgrade = _py314_upgrade_pending(root)
    # 結尾 diff 自癒:python 端逐檔比對 src↔target,差異即補(可安全覆寫)。
    # ★只複製精確清單上的檔★(第三輪外家否決席:原本整個目錄照來源 rglob,來源裡沒進版控的檔也被裝進去,
    # 可是跳過清單只列受版控的檔——裝進去的檔不在清單上,消費專案又把它當成自己的程式掃)。清單跟來源受版控的檔
    # 是否一致,由 t_vendored_file_list_matches_what_install_ships 守
    toolkit = list(_VENDORED_TOOLKIT) + list(_VENDORED_TREE_FILES)
    healed = []
    for rel in toolkit:
        s, t = src / rel, root / rel
        if not s.exists():
            continue
        if (not t.exists()) or not filecmp.cmp(s, t, shallow=False):
            t.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(s, t)
            if s.stat().st_mode & 0o111:
                t.chmod(t.stat().st_mode | 0o111)
            healed.append(rel)
    if healed:
        print(f"  結尾自癒:補齊 installer 漏的 {len(healed)} 檔 → {', '.join(healed)}")
    else:
        print("  ✓ 結尾自癒檢查:工具組完全對齊(無漏)")
    if _py314_upgrade and "scripts/hooks/pre-commit" in healed:
        print(_PY314_UPGRADE_NOTICE)
    # 記下工具檔的內容指紋:風險掃描與健檢只跳過「內容跟這裡一模一樣」的工具檔(r3 併發資源席)
    _vendored_manifest_write(root)
    # 範本已是最新(copy2 迴圈完成) → reinject 紀律區塊(CLAUDE.md + Codex 指示檔,d1)
    _reinject_all(root, slug)
    # ★全域同步放在這裡★(2026-09-06 全 repo 審視 #5):要等上面的 copy2 自癒把 vendored hook
    # 換成來源的新版之後才同步出去,否則 `lumos update` 會拿更新前的舊副本覆蓋全域 hooks。
    _sync_global_from_project(root)
    return rc


def cmd_update(source=None, no_pull=False, allow_stale=False):
    """從 Lumos 唯一源 repo 更新「本專案」vendored 的工具組。
    = (git pull Lumos) + install-graph-toolchain --target <本專案> --slug <自動偵測>。
    圖譜資料受 install-graph-toolchain 的 scaffold-skip 保護,不會被動。"""
    if _refuse_if_probe("update"):
        return 2
    src = _lumos_src(source)
    vault = find_vault(Path.cwd())
    if vault is None:
        # ★三條路同一套說法、同一個退出碼★(2026-09-07 全 repo 審視 #9)
        return _no_vault_msg()
    root = vault.parent.parent  # docs/<slug>-knowledge → docs → 專案 root
    slug = vault.name[:-len("-knowledge")] if vault.name.endswith("-knowledge") else vault.name
    if root.resolve() == src.resolve():
        # 來源 repo 自身:範本本地即最新,無 pull/vendor 之需——reinject-only
        # (2026-08-05 實戰缺口修:改完範本後來源 repo 自己的 CLAUDE.md 原本無路可刷)
        res = _reinject_all(root, slug, quiet=True)
        ri = res["CLAUDE.md"]
        print(f"lumos update — 來源 repo 自身:只刷新紀律區塊({', '.join(f'{k}:{v.status}' for k, v in res.items())})")
        return 0 if all(v.status in ("updated", "unchanged", "created", "appended") for v in res.values()) else 2
    print(f"lumos update — 來源 {src} → 本專案 {root}（slug={slug}）")
    rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
    return 2 if rc is None else rc


def _skills_list():
    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
    repo = Path(__file__).resolve().parent.parent
    d = repo / "skills"
    if not d.is_dir():
        return ()
    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))


_SKILLS = _skills_list()


def _link_or_copy(src: Path, dst: Path):
    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
    import os, shutil, subprocess
    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
    if dst.is_symlink():
        dst.unlink()                                  # Unix symlink
    elif dst.is_dir():
        try:
            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
        except OSError:
            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
    elif dst.exists():
        dst.unlink()
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        if _IS_WIN:
            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
                               capture_output=True, text=True, encoding="utf-8", errors="replace")
            if r.returncode != 0:
                raise OSError(r.stderr)
        else:
            dst.symlink_to(src)
    except OSError:
        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8(專案宣告 ≥3.9)
        try:
            (dst / _SKILL_MARKER).write_text("lumos fallback copy;安裝器可整夾重建\n", encoding="utf-8")
        except OSError:
            pass
        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")


def _install_skills():
    # ★r1 正確性席:防線下移到真正動全域機器狀態的地方★——原本只擋四個指令入口,
    # 但 cmd_init → _vendor_toolchain → _install_hooks_py 這條路也會重連 ~/.claude/skills、繞過入口守衛。
    # 擋在這個變動原語,不論從哪個指令進來都擋得住。
    if _refuse_if_probe("install-skills"):
        return
    repo = Path(__file__).resolve().parent.parent
    dest = Path.home() / ".claude" / "skills"
    for s in _SKILLS:
        src = repo / "skills" / s
        if src.is_dir():
            _link_or_copy(src, dest / s)
            print(f"  ✓ skill {s}")
    # Codex 也讀同一個開放標準(agentskills.io):使用者層 ~/.agents/skills/(2026-09-04 隔離 HOME 實測會載入)。
    # ★開放共用目錄★:既有真目錄只有帶我方標記檔才重建,否則跳過+warn(別人的 skill 不能刪)。
    shared = Path.home() / ".agents" / "skills"
    for s in _SKILLS:
        src = repo / "skills" / s
        if src.is_dir():
            if _link_or_copy_shared(src, shared / s):
                print(f"  ✓ skill(codex) {s}")


def _link_or_copy_shared(src: Path, dst: Path) -> bool:
    if harness == "codex":                            # ④ 自家自訂審查席 TOML(d6;三席,照實列刪掉的那些)
        removed.extend(_remove_codex_agent())
    bak = settings.with_suffix(".json.bak")   # ⑤ 合併器每次改檔留的備份也收掉(r1 單reviewer F7:拆機要對稱)
    if bak.exists():
        try:
            bak.unlink(); removed.append(bak.name)
        except OSError:
            pass
    name = "Claude" if harness == "claude" else "Codex"
    print(f"  ✓ 全域 {name} hook 清理:移除 {len(removed)} 檔 + 剪懸空我方註冊" if removed
          else f"  ✓ 全域 {name} hook:無我方殘留")
    return True


def _set_hooks_path(root: Path):
    """① git config core.hooksPath(專案本地)。★跟全域同步拆開★——見 _sync_global_from_project。"""
    import subprocess
    subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", "scripts/hooks"])
    print("  ✓ hooks:core.hooksPath 已設")


def _sync_global_from_project(root: Path):
    """②③ 全域 hooks/settings 同步,來源=專案 vendored copy。

    ★呼叫時機很要緊:必須在 vendored 檔案已經被更新之後★(2026-09-06 全 repo 審視 #5)。
    原本這兩件跟 core.hooksPath 綁在同一支 _install_hooks_py,而它在 _vendor_toolchain 裡
    排在 filecmp 自癒迴圈★之前★——於是 `lumos update` 會拿「更新前」的舊副本去覆蓋全域
    ~/.claude/hooks,把整台機器最核心的收工 hook 靜默換成六月版(實測 30912B → 15303B),
    訊息還印綠燈;舊版的 settings merger 甚至會把已撤除的 hook 註冊加回去。
    """
    for _h in ("claude", "codex"):
        print(_sync_msg(_h, _sync_global_hooks(root, _h)))


def _install_hooks_py(root: Path):
    """相容外殼:兩件一起做。★新程式碼請分開呼叫★,尤其是「先更新 vendored 再同步全域」
    那條路(_vendor_toolchain);這支留給「來源就是最新」的呼叫點(cmd_init 的新建路徑)。"""
    _set_hooks_path(root)
    _sync_global_from_project(root)


def _confirm_tty(prompt):
    """三階互動確認(curl|bash 安全;設計:Projects/bootstrap一鍵對稱_計劃 std F1/F2/F3):
    回 True(答 y/yes)/False(其他答案=拒絕)/None(非互動或無人回答→呼叫端跳過)。
    ①stdin.isatty→input();EOFError 落入②非當 False(isatty 撒謊時別誤判拒絕)
    ②os.open(tty,O_RDWR) 低階 fd(★r+ 開法對 tty 會炸 not seekable★)+os.write prompt
      +select timeout(有控制終端≠有人回答,防 readline 永久掛)+os.read
    ③皆不可→None。嚴禁在非 isatty 時讀 sys.stdin(curl|bash 下那是腳本殘文管線)。
    測試接縫:LUMOS_TTY(預設 /dev/tty;單元測指 pty slave)/LUMOS_TTY_TIMEOUT(預設 30s)。"""
    import os, select
    def _norm(ans):
        return ans.strip().lower() in ("y", "yes")   # 嚴格答案+預設 N(F2-B 殘文緩解)
    if sys.stdin.isatty():
        try:
            return _norm(input(prompt))
        except EOFError:
            pass                                     # isatty 撒謊 → 試 ②(F2-A)
    tty_path = os.environ.get("LUMOS_TTY", "/dev/tty")
    try:
        timeout = float(os.environ.get("LUMOS_TTY_TIMEOUT", "30"))
    except ValueError:
        timeout = 30.0
    try:
        fd = os.open(tty_path, os.O_RDWR)
    except OSError:
        return None

