def _note_shape_doctor_lines(repo_root, vault, ci=False):
    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
    out = []
    root = Path(repo_root)
    cp = root / ".lumos" / "config.json"
    txt = None
    try:
        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
            txt = cp.read_bytes()
    except OSError:
        txt = None
    mode, _w = _note_shape_config(txt)
    if mode != "block":
        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
                   "沒寫來源的現況描述不會被擋")
    wf = root / ".github" / "workflows"
    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
    if ymls:
        # 跳過註解:整行被註解掉的那步不算有呼叫(第二層早就這樣判;代碼審 r3 通才席:兩句判法不一,中間漏唸)
        body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
        step = ("\n    - run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
                "python3 scripts/lumos note-shape --diff \"${{ github.event.before || '0000000000000000000000000000000000000000' }}..${{ github.sha }}\""
                "\n  (這步只在 push 事件跑(`if: github.event_name == 'push'`),pull_request 沒有前一版;checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了找得到主線:"
                "已在主線上的提交不重查,新分支首推(前一版是 40 個 0)或 force-push 後舊頂端找不到時,lumos 從跟主線的分岔點算)"
                + _CI_PY314_NOTE)
        if "note-shape --diff" not in body:
            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
        else:
            shallow = _ci_jobs_calling_without_full_history(ymls, "note-shape --diff")
            if shallow:
                out.append("專案 CI 呼叫了 note-shape,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
                           + _ci_jobs_list(shallow))
    if ci:
        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
        return out
    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
    if gl is None:
        return out
    ref = None
    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    if up is not None and up.returncode == 0 and up.stdout.strip():
        ref = up.stdout.strip()
    else:
        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
        ref = cands[0] if cands else None
    tip = _lens_full_sha(root, ref) if ref else None
    if tip is None:
        return out
    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
    if a is None or a.returncode != 0:
        return out
    try:
        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return out
    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
    # 上限用「最新 N 個提交」算,不用 tip~N:沿第一個上一版數的邊界在合併式歷史裡會退到上線點之前、或根本數不到 N 步
    # 而整個取消(代碼審 r2、r3 通才席);起點固定在上線點
    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False,
                           max_count=_NS_DOCTOR_SCAN_CAP if capped else None)
    if capped:
        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
    if res:
        viol, _errs = res
        if viol:
            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
    return out


def cmd_note_shape(repo=None, staged=False, diff_range=None):
    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
    root = Path(repo).resolve() if repo else None
    if root is None:
        r = _lens_git(".", "rev-parse", "--show-toplevel")
        if r is None or r.returncode != 0:
            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
            return 0
        root = Path(r.stdout.strip())
    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
    if r is None or r.returncode != 0:
        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE") == "1":        # 只認 1,跟 LUMOS_SKIP_BOUND_TESTS 等鄰居一致(筆記內容審代碼審 r1 同族修)
        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
        return 0
    if staged:
        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
        if mh is not None and mh.returncode == 0:
            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
            return 0
        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
    else:
        rg = _lens_range_ok(diff_range)
        if rg is None:
            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
            return 2
        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
        if sh is not None and sh.stdout.strip() == "true":
            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
                  file=sys.stderr)
            _gate_event_or_warn(root, "note-shape", "skipped-env", "shallow clone")
            return 0
