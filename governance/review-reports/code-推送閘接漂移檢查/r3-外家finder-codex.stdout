 51790	    ef.write_text(_j.dumps(exam + [{"id": "X", "exam_event": "亂寫", "note": "x", "line": 1}], ensure_ascii=False), encoding="utf-8")
 51791	    r2 = sp.run([sys.executable, GRAPHCTL, "drift", "exam", str(ef), "--repo", str(root)], capture_output=True, text=True)
