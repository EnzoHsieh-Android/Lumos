 51561	# 推送閘接漂移檢查代碼審 r2 以前,CI 與健檢範本在 shell 裡補起點的寫法(只留著給測試證明現場:同一個輸入舊寫法會算錯)
 51562	_DR_OLD_CI_FALLBACK = (
 51563	    'if [ -z "$BEFORE" ] || [ "$BEFORE" = 0000000000000000000000000000000000000000 ] || ! git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then\n'
 51564	    '  BEFORE="$(git rev-parse -q --verify "$SHA^1^{commit}" 2>/dev/null || git hash-object -t tree /dev/null)"\n'
 51565	    'fi\n'
 51566	    'python3 scripts/lumos drift check --diff "$BEFORE..$SHA" --repo .\n')
 51567	
 51568	
 51569	def _dr_ci_bodies():
 51570	    """工具鏈 ci.yml 的 drift check 那步、健檢給消費專案的範本,兩段 run 的內容 → [(名稱, shell)]。"""
 51571	    import re, textwrap as _tw
 51572	    out = []
 51573	    ci = Path(GRAPHCTL).resolve().parent.parent / ".github" / "workflows" / "ci.yml"
 51574	    if ci.is_file():
 51575	        step = next((x for x in re.split(r"\n(?=      - )", ci.read_text(encoding="utf-8")) if "drift check --diff" in x), "")
 51576	        mm = re.search(r"\n        run: \|\n((?:          .*\n?|\s*\n)+)", step)
 51577	        out.append(("ci.yml", _tw.dedent(mm.group(1)) if mm else ""))
 51578	    tpl, grab = [], False
 51579	    for ln in _load_lumos_inproc()._DRIFT_CI_STEP.split("\n"):
 51580	        if ln.strip() == "run: |":
 51581	            grab = True
 51582	            continue
 51583	        if grab:
 51584	            if not ln.startswith("        "):
 51585	                break
 51586	            tpl.append(ln)
 51587	    out.append(("範本", _tw.dedent("\n".join(tpl)) + "\n"))
 51588	    return out
 51589	
 51590	
 51591	def _dr_ci_run(root, body, before, sha, ref):
 51592	    """在 root 裡真的跑一段 CI shell:python/python3 換成轉給真 lumos 的殼 → (rc, 輸出)。"""
 51593	    import subprocess as sp, os as _os
 51594	    fb = Path(tempfile.mkdtemp(prefix="gctl-dr-ci-py-"))
 51595	    for nm in ("python", "python3"):
 51596	        (fb / nm).write_text(f"#!/bin/bash\nshift\nexec {sys.executable} {Path(GRAPHCTL).resolve()} \"$@\"\n", encoding="utf-8")
 51597	        _os.chmod(fb / nm, 0o755)
 51598	    e = dict(_os.environ, PATH=f"{fb}:{_os.environ.get('PATH', '')}", BEFORE=before, SHA=sha, GITHUB_REF=ref)
 51599	    for k in ("GIT_DIR", "LUMOS_SKIP_DRIFT_CHECK"):
 51600	        e.pop(k, None)
 51601	    r = sp.run(["bash", "-e", "-c", body], cwd=str(root), capture_output=True, text=True, env=e, timeout=180)
 51602	    return r.returncode, r.stdout + r.stderr
 51603	
 51604	
 51605	def t_ci_drift_start_shapes():
 51606	    """CI 那步與健檢範本(兩段 shell 真的跑、lumos 是真的)的起點(推送閘接漂移檢查代碼審 r2 正確性席 F1、外家否決席 F2、
 51607	    邊界席 F2、架構席 F2):before 原樣交、帶 --push-remote origin --pushed-ref $GITHUB_REF,由 lumos 算——
 51608	    ①功能分支合過主線再推,before 找得到 → 不把主線上別人的轉正算進來;②新分支首推、頂端是合主線的合併提交 → 不擋;
 51609	    ③新分支首推一次帶多個提交、轉正在第一個 → 擋;④推主線本身(origin/main 已等於頂端)→ 候選都是被推的那條、跳過,
 51610	    用 before,轉正照擋、不會變成「沒有新東西」;⑤before 找不到、主線也找不到 → 退到頂端的父提交(沒有父從空樹),說明照實講。
 51611	    ①②③各先證明舊的 shell 補法在同一個輸入會算錯。
 51612	
 51613	    翻紅釘:CI/範本改回 shell 補法 → ①②③紅;拿掉「跳過被推的那條」→ ④紅。
 51614	    """
 51615	    print("t_ci_drift_start_shapes")
 51616	    _need_src(".github/workflows/ci.yml")
 51617	    z = "0" * 40
 51618	    root, _bare, g = _dr_push_repo(guards=("G", "G2", "G3"))
 51619	    g("checkout", "-q", "-b", "feat")
 51620	    _nh_file(root, "notes/a.txt", "a\n")
 51621	    _nh_commit(root, "feat 無關")
 51622	    f1 = _na_head(root)
 51623	    g("push", "-q", "--no-verify", "origin", "feat")
 51624	    g("checkout", "-q", "main")
 51625	    _dr_settle(root, "G")
 51626	    _nh_commit(root, "M1 別人轉正")
 51627	    m1 = _na_head(root)
 51628	    g("push", "-q", "--no-verify", "origin", "main")
 51629	    g("checkout", "-q", "feat")
 51630	    g("merge", "-q", "--no-edit", "--no-verify", "main")
 51631	    f2 = _na_head(root)
 51632	    g("push", "-q", "--no-verify", "origin", "feat")
 51633	    g("checkout", "-q", "-b", "x", "main")
 51634	    _dr_settle(root, "G2")
 51635	    _nh_commit(root, "X1 自己轉正,預告句留著")
 51636	    _nh_file(root, "notes/x.txt", "x\n")
 51637	    _nh_commit(root, "X2 無關")
 51638	    x2 = _na_head(root)
 51639	    g("push", "-q", "--no-verify", "origin", "x")
 51640	    g("checkout", "-q", "main")
 51641	    bodies = _dr_ci_bodies()
 51642	    check("前置:ci.yml 與範本兩段都抽得出來,而且都帶推送參數", len(bodies) == 2 and all(
 51643	        '--push-remote origin --pushed-ref "$GITHUB_REF"' in b for _n, b in bodies), str(bodies))
 51644	    old = _dr_ci_run(root, _DR_OLD_CI_FALLBACK, f1, f2, "refs/heads/feat")[0]
 51645	    check("①前置:舊的 shell 補法在「合過主線、before 找得到」會擋", old == 1, f"rc={old}")
 51646	    old = _dr_ci_run(root, _DR_OLD_CI_FALLBACK, z, f2, "refs/heads/feat")[0]
 51647	    check("②前置:舊的 shell 補法在「新分支首推、頂端是合主線的合併提交」會擋", old == 1, f"rc={old}")
 51648	    old = _dr_ci_run(root, _DR_OLD_CI_FALLBACK, z, x2, "refs/heads/x")[0]
 51649	    check("③前置:舊的 shell 補法在「新分支首推多個提交、轉正在第一個」放行(只查最後一個提交)", old == 0, f"rc={old}")
 51650	    for name, body in bodies:
 51651	        rc, out = _dr_ci_run(root, body, f1, f2, "refs/heads/feat")
 51652	        check(f"①{name}:合過主線再推,從分岔點 M1 算,不擋", rc == 0 and m1[:12] in out, f"rc={rc} {out[-500:]}")
 51653	        rc, out = _dr_ci_run(root, body, z, f2, "refs/heads/feat")
 51654	        check(f"②{name}:新分支首推、頂端是合主線的合併提交,不擋", rc == 0 and m1[:12] in out, f"rc={rc} {out[-500:]}")
 51655	        rc, out = _dr_ci_run(root, body, "", x2, "refs/heads/x")
 51656	        check(f"③{name}:新分支首推(before 空的)一次帶多個提交、轉正在第一個 → 擋", rc == 1 and m1[:12] in out,
 51657	              f"rc={rc} {out[-500:]}")
 51658	    _dr_settle(root, "G3")
 51659	    _nh_commit(root, "M2 主線本身的轉正")
 51660	    m2 = _na_head(root)
 51661	    g("push", "-q", "--no-verify", "origin", "main")
 51662	    check("④前置:origin/main 已等於頂端,而且 M1..M2 有轉正(直接交給 lumos 會擋)",
 51663	          _nh_git(root, "rev-parse", "origin/main").stdout.strip() == m2 and _dr(root, "check", "--diff", f"{m1}..{m2}")[0] == 1, "")
 51664	    for name, body in bodies:
 51665	        rc, out = _dr_ci_run(root, body, m1, m2, "refs/heads/main")
 51666	        check(f"④{name}:推主線本身,用 before,轉正照擋(不會變成「沒有新東西」)", rc == 1 and "沒有新東西" not in out,
 51667	              f"rc={rc} {out[-500:]}")
 51668	    m = _load_lumos_inproc()
 51669	    empty = m._EMPTY_TREE_SHA
 51670	    first = _nh_git(root, "rev-list", "--max-parents=0", "HEAD").stdout.split()[0]
 51671	    s, why = m._push_range_start(root, "de" * 20, m2, "", "refs/heads/main")
 51672	    check("⑤before 找不到、主線也找不到 → 頂端的第一個父提交,說明寫「只查最後一個提交」", s == m1 and "只查最後一個提交" in why,
 51673	          f"{s} {why}")
 51674	    s, why = m._push_range_start(root, "de" * 20, first, "", "refs/heads/main")
 51675	    check("⑤頂端沒有父提交 → 空樹", s == empty and "空樹" in why, f"{s} {why}")
 51676	    s, why = m._push_range_start(root, z, first, "", "refs/heads/main")
