 33206	def _lens_full_sha(repo_root, rev):
 33207	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 33208	    if r is None or r.returncode != 0:
 33209	        return None
 33210	    sha = r.stdout.strip()
 33211	    return sha if _LENS_SHA_RE.match(sha) else None
 33212	
