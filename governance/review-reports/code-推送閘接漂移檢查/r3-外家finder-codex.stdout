  3496	    n_docs = len(docs)
  3497	    avgdl = sum(d for _, d in docs.values()) / max(n_docs, 1)
  3498	    df = {t: sum(1 for tfs, _ in docs.values() if t in tfs) for t in q_tokens}
  3499	    out = []
  3500	    for rel, (tfs, dl) in docs.items():
  3501	        score = 0.0
  3502	        hits = []
  3503	        for tok in q_tokens:
