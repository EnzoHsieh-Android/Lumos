exec
/bin/zsh -lc "sed -n '1,120p' .github/workflows/ci.yml; git show dca86f7d:scripts/lumos | sed -n '33050,33140p'; git show dca86f7d:scripts/hooks/pre-push | sed -n '35,115p'" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-hook
 succeeded in 0ms:
name: CI
# 獨立信任根(2026-07-29 Codex 外審 P0):本機 hooks 可繞(--no-verify;沒有 scripts/lumos 的 repo 降級放行),
# 這裡是 push 後必跑的後盾——pre-push 提示裡的「CI 仍會抓」由本 workflow 兌現。
on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 45   # 2026-09-12:全套單行程跑到 30 分被砍(前幾次 25–27 分,一路逼近上限);切片後約 10 分,上限留餘裕
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # code-loop gate 要算 before..sha 的 diff(體檢 #5)
      - uses: actions/setup-python@v5
        with:
          python-version: "3.14"   # 2026-09-29 工具最低版本改 3.14(Projects/最低Python版本改3.14_計劃)
      - name: Compile check
        run: python -m compileall -q scripts/lumos scripts/test_lumos.py
      # 2026-09-29 [S7]:scripts/lumos 等三類檔必須 3.9 還能解析,舊版啟動時才跑得到開頭的版本檢查
      # (Projects/最低Python版本改3.14_計劃 做法第 2、7 點)。這裡的 python 是 3.14,拿它編譯擋不到 3.12 才合法的
      # f-string 寫法,所以裝釘死版本的 ruff、以 py39 為目標只查語法錯誤——ruff 只在 CI 當工具裝,不是工具鏈的依賴。
      - name: 3.9 語法守衛
        run: |
          python -m pip install --quiet ruff==0.16.7
          ruff check --isolated --target-version py39 --select E9 scripts/lumos scripts/merge-claude-settings.py scripts/hooks/claude/*.py
      - name: SyntaxWarning 歸零閘
        run: python -W error::SyntaxWarning -c "compile(open('scripts/lumos').read(),'lumos','exec'); compile(open('scripts/test_lumos.py').read(),'t','exec')"
      # 2026-09-12:全套在 CI 單行程跑要 25–30 分鐘,已經撞到 job 上限被砍(8a45751b)。
      # 推送前掛鉤早就把它切成幾片同時跑,CI 照同一支旗標切——不改測試內容、只改跑法;
      # 任何一片紅就整步紅,而且把每一片的尾端印出來(不然只看得到「有片紅了」)。
      # 2026-09-18(Enzo 裁「像這種改動 CI 可以跳過吧,跟程式碼無關」):push 事件先問 lumos 這段推送改到什麼——
      # 只改到 README/docs/assets 這類文件(pitfalls --json 的 suite=docs)就只跑文件子集(原始碼提到那些路徑的測試);
      # 碰到程式、skills、workflow 任何一支都跑全套。判不出來(首推、force-push 對不到起點、lumos 出錯)一律全套——
      # 保守方向是多跑,不是少跑。pull_request 事件沒有 before,也是全套。
      - name: 這次推送要跑哪個測試範圍
        id: suite
        env:
          BEFORE: ${{ github.event.before }}
          SHA: ${{ github.sha }}
        run: |
          suite=full; why="不是 push 事件或起點對不到"
          if [ "${{ github.event_name }}" = push ] && [ -n "$BEFORE" ] && [ "$BEFORE" != "0000000000000000000000000000000000000000" ] \
             && git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
            out="$(python scripts/lumos pitfalls --diff "$BEFORE..$SHA" --no-lint --json --repo . 2>/dev/null || true)"
            s="$(printf '%s' "$out" | python -c 'import json,sys; d=json.load(sys.stdin); print(d.get("suite","full")); print(d.get("suite_reason","")); print("graph" if d.get("suite_graph") else "")' 2>/dev/null || printf 'full\nlumos 算不出來\n')"
            suite="$(printf '%s' "$s" | sed -n 1p)"; why="$(printf '%s' "$s" | sed -n 2p)"; graph="$(printf '%s' "$s" | sed -n 3p)"
            [ "$suite" = docs ] || suite=full
          fi
          echo "suite=$suite" >> "$GITHUB_OUTPUT"
          echo "graph=$graph" >> "$GITHUB_OUTPUT"
          echo "測試範圍:$suite($why)"
      - name: Full test suite (切 4 片同時跑;純文件推送只跑文件子集)
        env:
          SUITE: ${{ steps.suite.outputs.suite }}
          GRAPH: ${{ steps.suite.outputs.graph }}
        run: |
          set -u
          rc=0
          extra=""
          if [ "$SUITE" = docs ]; then extra="--suite docs"; echo "純文件推送:只跑文件子集(--suite docs),不跑全套"; fi
          if [ "$SUITE" = docs ] && [ "$GRAPH" = graph ]; then extra="$extra --graph"; echo "含圖譜筆記:加跑讀真圖譜的測試(--graph)"; fi
          for i in 1 2 3 4; do
            python scripts/test_lumos.py --shard "$i/4" $extra > "/tmp/shard-$i.log" 2>&1 &
          done
          for job in $(jobs -p); do wait "$job" || rc=1; done
          for i in 1 2 3 4; do
            echo "===== 第 $i 片 ====="
            # 紅的時候先把失敗那幾行撈出來——tail 只看得到尾巴,而紅的那支通常在中間,
            # 以前紅了要靠猜是哪一支(2026-09-15 實際踩到:CI 紅、本機全綠、查不出名字)
            if grep -qE "^  ✗|, [1-9][0-9]* failed" "/tmp/shard-$i.log"; then
              echo "--- 這一片紅了,以下是失敗的斷言與所在測試 ---"
              grep -nE "^  ✗|EXCEPTION" "/tmp/shard-$i.log" | tail -40 || true
              echo "--- 失敗處前後文 ---"
              # ★這裡的 || true 不是裝飾★(2026-09-15 審查席抓到):撈不到就回非零,
              # 目前這步的殼是 bash -e 沒有 pipefail、管線末端是 while 所以不會中止;
              # 但只要有人把這步改成 shell: bash(預設帶 pipefail),沒接住就會★整步當場死掉★,
              # 連還沒印的片都一起失聲,比改動前更糟。實測過兩種殼,差別就在這個旗標。
              # 另外要認得逾時/零斷言/跳過判紅——那三種紅不印 FAILED 也不印 EXCEPTION,
              # 而它們正是「CI 紅、本機綠」最常見的成因,漏掉等於在最該用的場合失效。
              grep -nE "^  ✗ (FAILED|TIMEOUT|判紅)|EXCEPTION|^  ✗ .*一條斷言都沒有" \
                "/tmp/shard-$i.log" | head -3 | cut -d: -f1 | while read ln; do
                sed -n "$((ln>12 ? ln-12 : 1)),$((ln+3))p" "/tmp/shard-$i.log"
              done || true
              echo "--- 以下是該片尾端 ---"
            fi
            tail -25 "/tmp/shard-$i.log"
          done
          exit $rc
      # 2026-08-29 接線:這支的 106 個測試先前沒有任何自動路徑在跑(CI 與 pre-push 都只跑
      # test_lumos.py),而它是 autonomous_loop 十個模組中九個的唯一覆蓋,且早已在 anchor
      # 基準線裡被防竄改守著——綠紅沒人看,卻有人守。
      - name: 自主迴圈測試
        # 純文件推送只跑讀真 CLAUDE.md 的那一條(144 支裡只有它讀 repo 的文件;整支 63 秒)——跟推送前掛鉤同一條規則
        env:
          SUITE: ${{ steps.suite.outputs.suite }}
        run: |
          extra=""
          if [ "$SUITE" = docs ]; then extra="-k real_claude_md"; fi
          python scripts/test_autonomous_loop.py $extra
      - name: Graph doctor (strict)
        run: python scripts/lumos doctor --ci
      - name: code-loop gate (push 後盾;體檢 #5)
        # `git push --no-verify` 會整個跳過 pre-push——測試/doctor/anchor 這裡都已重跑,唯獨 tier=high
        # 的對抗審查閘與表態閘(2026-09-09)沒人補查,繞過零留痕。本步在 push 事件重算 pitfalls tier/適用題並比對留痕:
        # rc1=高風險 diff 無 pass/skip 留痕 → CI 紅(可見的痕跡;ci-wait/ci-log 會收到)。
        if: github.event_name == 'push'
        env:
          LUMOS_SKIP_BOUND_TESTS: "1"   # 受波及合約測試在本機 pre-push 真跑;CI 已跑全套當後盾,不重跑
          BEFORE: ${{ github.event.before }}
          SHA: ${{ github.sha }}
          BRANCH: ${{ github.ref_name }}
        run: |
          # 前一版原樣交給 lumos(40 個 0 或本機找不到時它自己判起點,跟 note-shape 那步同一支判法;找不到主線時代碼審這道照舊用空樹、不截上線點)
          [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
          echo "range: $BEFORE..$SHA branch=$BRANCH"
          python scripts/lumos code-loop check --diff "$BEFORE..$SHA" --at-sha "$SHA" --branch "$BRANCH" --repo . || {
            rc=$?
git: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead
        return None
    if any(ch.isspace() for ch in diff_range):
        return None
    return parts[0], parts[1]


_ZERO_SHA_RE = re.compile(r"0{40}|0{64}")          # SHA-1 與 SHA-256 專案的全零(筆記內容審代碼審 r3 兩席)


def _lens_push_base(repo_root, a, tip):
    """推送範圍的起點 → (起點 sha 或 None, 說明)。None=這次沒有新東西、不用查。
    起點是 40 個 0(GitHub 對新分支首推給的 before)或本機找不到(force-push 後的舊頂端)時:頂端落後或等於主線(本地主分支
    的 upstream)頂端就沒有新東西;其他從跟主線的分岔點算;連主線都找不到才用空樹(筆記形狀擋與每支檔有家之後截到上線點;
    代碼審那道照它原本拿到空樹的做法)。
    ★頂端等於主線頂端也算沒有新東西★:代碼審 r2 曾改成「從上線點起全查」想擋 force-push 改寫主線,r3 查出它讓零提交的新分支
    被主線舊帳誤擋、代碼審那道整庫當新增、而且 force-push 後再推一次照樣漏——「繞過本機掛鉤又 force-push 改寫主線」是存心繞過,
    跟筆記內容審只防疏忽同一條線,不在這道後盾要防的範圍(呼叫端回 None 時記一筆 skipped 帳,事後看得到)。
    ★不能直接回「範圍找不到、放行」★:照 doctor 給的 CI 步驟貼的消費專案,新分支首推會整批放過(2026-09-28 漏網
    ESC-61fc2d87);★也不能一律當空樹★:新分支開在主線頂端時會把主線上線後的舊帳當新增誤擋(同一件事的代碼審)。
    明寫空樹的起點照原意(從空樹比)。筆記形狀擋與每支檔有家共用這支。"""
    if a == _EMPTY_TREE_SHA:
        return a, ""
    if not _ZERO_SHA_RE.fullmatch(a or ""):
        s = _lens_full_sha(repo_root, a)
        if s is not None:
            return s, ""
    why = "新分支首推" if _ZERO_SHA_RE.fullmatch(a or "") else "起點在本機找不到"
    ml = _mainline_ref(repo_root, remote_only=True)
    if ml:
        anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
        if anc is not None and anc.returncode == 0:
            return None, f"{why},而且頂端已在主線({ml[0]})上——沒有新東西"
        mb = _lens_git(repo_root, "merge-base", tip, ml[1])
        if mb is not None and mb.returncode == 0 and mb.stdout.strip():
            return mb.stdout.strip(), f"{why}:從跟主線({ml[0]})的分岔點算"
    return _EMPTY_TREE_SHA, f"{why}:找不到主線,從空樹算(截到上線點)"


def _lens_git(repo_root, *args, quote=False, binary=False):
    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
    import subprocess as _sp
    cmd = ["git", "-C", str(repo_root)]
    if quote:
        cmd += ["-c", "core.quotePath=false"]
    try:
        if binary:
            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
    except (OSError, _sp.TimeoutExpired):
        return None


def _lens_full_sha(repo_root, rev):
    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
    if r is None or r.returncode != 0:
        return None
    sha = r.stdout.strip()
    return sha if _LENS_SHA_RE.match(sha) else None


def _mainline_ref(repo_root, remote_only=False):
    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
    拿它當「已在主線上」會把整批都排除掉)。"""
    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
        sha = _lens_full_sha(repo_root, cand)
        if sha:
            return cand, sha
    return None


def _lens_dispositions_lines(lines, rec):
    """派工鏡頭附表態記錄(表態閘 S8):只列人答的題(未觸發自動 na 只給個數);工具驗過錨點存在、沒驗答案對不對——審查席反駁的就是這些答案。回人答題數。"""
    disp = rec.get("dispositions") or {}
    human = [(q, e) for q, e in disp.items() if isinstance(e, dict) and not e.get("auto")]
    n_auto = sum(1 for e in disp.values() if isinstance(e, dict) and e.get("auto"))
    lines.append(f"[表態記錄(棧別效能檢核;分支 {rec.get('branch')},版本 {str(rec.get('head_sha') or '')[:8]})——寫入時工具只驗了形狀,證據存不存在要到推送前 code-loop check 才驗,答案對不對沒人驗]")
    for q, e in human:
        st = e.get("status")
        tail = (str(e.get("evidence") or "") if st == "satisfied"
                else (str(e.get("issue") or "") + " " + str(e.get("reason") or "")) if st == "todo"
                # tension 四欄都給審查席看——反駁的就是這四欄(2026-09-09 兩席相反時端出張力;「｜」分隔是編排者裁的,四欄需要分隔)
                else (f"選 {e.get('chosen') or ''}｜既有 {', '.join(str(x) for x in (e.get('existing') or []))}｜隱患 {e.get('hazard') or ''}｜建議 {e.get('suggestion') or ''}") if st == "tension"
                else str(e.get("reason") or ""))   # 全部 str(… or ""):治理帳重建來的紀錄不重驗形狀,缺欄不能炸(r1 正確性席 f3)
        lines.append(f"  {q} {st} — {str(tail)[:200]}")
    if n_auto:
        lines.append(f"  (另有 {n_auto} 題未觸發、工具自動記不適用)")
    return len(human)


def _lens_cache_path(repo_root, base_sha, head_sha, extra=""):
git: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead

# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
pp_range_for() {
  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    printf '%s..%s' "$_EMPTY_TREE" "$2"
  else
    printf '%s..%s' "$1" "$2"
  fi
}

# 存量漂移檢查的範圍(代碼審 r1 正確性席 F1、F2;併發回滾席 F1)。$1=remote_sha $2=local_sha → 設 _DR_RANGE 與 _DR_NOTE。
# ★起點取「遠端舊值」與「本地新值跟主線的分岔點」裡比較新的★:
#   - 分岔點是遠端舊值的祖先(或同一個)→ 遠端舊值較新,用它(一般的增量推送,只看這次新加的);
#   - 遠端舊值是全 0(新分支)、本機找不到、或兩者分岔(功能分支合過主線、重定基底後 force push)→ 用分岔點。
#     分岔那種情況若用遠端舊值,`git log 舊..新` 會把合進來的主線提交(別人的轉正)算成這次帶進來的而誤報或誤擋;
#     用分岔點頂多把自己上次已推過的提交再看一次(那是自己的東西)。
# ★為什麼掛鉤自己算、不原樣交給 lumos★:lumos 的共用起點判法只在遠端舊值是全 0 或找不到時才算分岔點,
#   而且主線只認 main/master 的 upstream——沒設 upstream 就退回從空樹算、截到上線點,把上線後主線的舊帳全算進新分支。
# 主線依序找:main@{upstream} → master@{upstream} → 這次推送的遠端的預設分支(refs/remotes/<遠端>/HEAD)→ <遠端>/main
#   → <遠端>/master(遠端名是 git 傳給掛鉤的第一個參數);都找不到才原樣交給 lumos 自己判,並講一聲。
_PP_REMOTE="${1:-}"
pp_mainline() {   # 印主線頂端的提交編號;找不到什麼都不印
  local _c _cands=("main@{upstream}" "master@{upstream}")
  if [[ -n "$_PP_REMOTE" ]]; then
    _cands+=("refs/remotes/$_PP_REMOTE/HEAD" "refs/remotes/$_PP_REMOTE/main" "refs/remotes/$_PP_REMOTE/master")
  fi
  for _c in "${_cands[@]}"; do
    git rev-parse -q --verify "$_c^{commit}" 2>/dev/null && return 0
  done
  return 0
}
pp_drift_range() {
  local _ml _mb
  _DR_NOTE=""
  _DR_RANGE="$1..$2"
  _ml="$(pp_mainline)"
  if [[ -z "$_ml" ]]; then
    _DR_NOTE="找不到主線(main/master 沒設 upstream,遠端 ${_PP_REMOTE:-(不明)} 也沒有 HEAD/main/master),起點交給 lumos 自己判;新分支可能把主線上別人的改動算進來"
    return 0
  fi
  _mb="$(git merge-base "$2" "$_ml" 2>/dev/null | head -1)"
  if [[ -z "$_mb" ]]; then
    _DR_NOTE="要推的提交跟主線沒有共同祖先,起點交給 lumos 自己判"
    return 0
  fi
  if [[ "$1" != "$_ZERO" ]] && git cat-file -e "$1^{commit}" 2>/dev/null \
     && git merge-base --is-ancestor "$_mb" "$1" 2>/dev/null; then
    _DR_RANGE="$1..$2"
  else
    _DR_RANGE="$_mb..$2"
  fi
}

# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
pp_touched_file() {
  local _f _r
  [[ -n "$_EMPTY_TREE" ]] || return 0
  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
  _f="$_PP_TMP/touched.txt"
  : > "$_f" 2>/dev/null || return 0
  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    read -r _ _lsha _ _rsha <<< "$_ppl"
    [[ "$_lsha" == "$_ZERO" ]] && continue
    _r="$(pp_range_for "$_rsha" "$_lsha")"
    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
  done
  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
}

