 51446	    rc, dl, ex, out = hook(f"refs/heads/newb {nb} refs/heads/newb {z}\n")
 51447	    check("⑤新分支首推(全 0):從分岔點算,不擋", rc == 0 and "新分支首推" in ex and m1[:12] in ex, f"rc={rc} {ex} {out[-500:]}")
 51448	    rc, dl, ex, out = hook(f"refs/heads/own {own} refs/heads/own {z}\n")
 51449	    check("⑤反面:新分支自己帶進來的轉正照擋(不是一律放行)", rc == 1 and m1[:12] in ex, f"rc={rc} {ex} {out[-500:]}")
 51450	    rc, dl, ex, out = hook(f"refs/tags/v-own {own} refs/tags/v-own {z}\n")
 51451	    check("⑤tag 也查:tag 指到的提交帶進來的轉正照擋(tag 不跳過任何主線候選)",
 51452	          rc == 1 and "--pushed-ref refs/tags/v-own" in dl and m1[:12] in ex, f"rc={rc} {ex} {out[-500:]}")
 51453	    check("⑤b前置:主線本身這次要推的範圍有轉正(M1..M2 直接交給 lumos 會擋)", direct(f"{m1}..{m2}") == 1, "")
 51454	    rc, dl, ex, out = hook(f"refs/heads/main {m2} refs/heads/main {m1}\n")
