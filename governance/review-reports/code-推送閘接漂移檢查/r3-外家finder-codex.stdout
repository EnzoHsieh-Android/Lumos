 51461	    check("⑥沒設 upstream:用這次推送的遠端的預設分支(origin/HEAD),不擋", rc == 0 and "origin/HEAD" in ex and m1[:12] in ex,
 51462	          f"rc={rc} {ex} {out[-500:]}")
