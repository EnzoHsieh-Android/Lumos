 51466	          f"rc={rc} {ex} {out[-500:]}")
 51467	    rc, dl, ex, out = hook(f"refs/heads/newb {nb} refs/heads/newb {z}\n", args=())
 51468	    check("⑦主線都找不到(沒給遠端名、main 沒 upstream):印一行說明,從空樹算", "找不到主線" in ex and "空樹" in ex
