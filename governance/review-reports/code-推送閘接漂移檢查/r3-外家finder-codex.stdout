 28128	def _drift_fix_record(env, cx, res):
 28129	    """第 7 步:寫修復帳(稽核紀錄)、記治理事件。帳寫不進去回 2,不動筆記。"""
 28130	    import datetime, hashlib, secrets
 28131	    rec = {"id": "DFIX-" + secrets.token_hex(4), "date": datetime.date.today().isoformat(), "path": cx["repo_rel"],
 28132	           "line": cx["line"], "kind": cx["kind"], "changed": _drift_fix_changes(cx["lines"], res["new"]),
 28133	           "after_sha256": hashlib.sha256("\n".join(res["new"]).encode("utf-8")).hexdigest(), **res["extra"]}
 28134	    want = "\n".join(res["new"]).encode("utf-8")
 28135	    moved = False
 28136	    if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "ledger":
 28137	        rc = 2
 28138	    else:
 28139	        with _vault_write_lock(env.vault):
 28140	            # 驗證在鎖外,記帳前在鎖內再比一次:帳上的指紋要是記帳那一刻磁碟上的內容(代碼審 r1 外家席)
 28141	            try:
 28142	                if os.environ.get("LUMOS_DRIFT_FIX_FAULT") == "moved":   # 故障注入:模擬別人在驗證與記帳之間改了這一篇
 28143	                    cx["path"].write_bytes(want + b"\n")
 28144	                moved = cx["path"].read_bytes() != want
 28145	            except OSError:
 28146	                moved = True
 28147	            if moved:
 28148	                rc = 2
 28149	            else:
 28150	                rec["seq"] = _drift_next_seq(cx["root"], _DRIFT_FIXES)
 28151	                rc = _drift_ledger_append(cx["root"], _DRIFT_FIXES, rec)
 28152	    if rc != 0:
 28153	        why = ("寫好、驗過之後這一篇又被別人改了,修復帳沒記(帳上的指紋要是記帳那一刻的內容)" if moved
 28154	               else "筆記已改好,但修復帳沒記到")
 28155	        print(f"擋下:{why};{_esc_clean(cx['repo_rel'], 200)} 的改動用 git diff 看得到——確認沒問題就直接提交"
 28156	              "(修復帳只是稽核紀錄,少這一筆不影響之後的修;沒提交之前,同一篇的下一項 drift fix 會因為指紋對不上帳而擋下);"
 28157	              f"要退就 {_drift_git_hint(cx, 'checkout --')}", file=sys.stderr)
 28158	        return 2
 28159	    _gate_event_or_warn(cx["root"], "drift-check", "fix", f"{cx['rel']}:{cx['line']} {cx['kind']}({rec['id']})")
 28160	    return 0
