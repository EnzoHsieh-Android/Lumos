 33096	def _push_mainline_branch(repo_root, cand, remote):
 33097	    """主線候選指到的分支短名(判「就是這次被推的那條」用);判不出回 None。
 33098	    遠端 HEAD 用 symbolic-ref 解出它指的分支;X@{upstream} 用 rev-parse --symbolic-full-name 解,再去掉那條本地分支設定的遠端名。"""
 33099	    if cand.startswith("refs/remotes/"):
 33100	        if cand.endswith("/HEAD"):
 33101	            r = _lens_git(repo_root, "symbolic-ref", "-q", cand)
 33102	            if r is None or r.returncode != 0:
 33103	                return None
 33104	            full = r.stdout.strip()
 33105	        else:
 33106	            full = cand
 33107	        pre = f"refs/remotes/{remote}/"
 33108	        return full[len(pre):] if remote and full.startswith(pre) else None
 33109	    local = cand.split("@{", 1)[0]
 33110	    r = _lens_git(repo_root, "rev-parse", "--symbolic-full-name", cand)
 33111	    if r is None or r.returncode != 0:
 33112	        return None
 33113	    full = r.stdout.strip()
 33114	    if full.startswith("refs/heads/"):          # upstream 設成本機另一條分支(branch.X.remote = .)
 33115	        return full[len("refs/heads/"):]
 33116	    rm = _lens_git(repo_root, "config", "--get", f"branch.{local}.remote")
 33117	    pre = f"refs/remotes/{rm.stdout.strip()}/" if (rm is not None and rm.returncode == 0 and rm.stdout.strip()) else None
 33118	    return full[len(pre):] if pre and full.startswith(pre) else None
