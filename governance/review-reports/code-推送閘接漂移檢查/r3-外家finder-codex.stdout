 51235	def _dr_yaml_tail_ok(text):
 51236	    """健檢範本貼進 workflow 能不能被解析的替代斷言(標準庫沒有 YAML 解析器):`run: |` 那段 shell 之後的每一行
 51237	    都是空行或縮排後以 # 開頭(YAML 註解)。→ (是否合格, 第一個不合格的行)。"""
 51238	    ls = text.split("\n")
 51239	    i = next((k for k, x in enumerate(ls) if x.strip() == "run: |"), None)
 51240	    if i is None:
 51241	        return False, "(找不到 run: |)"
 51242	    k = i + 1
 51243	    while k < len(ls) and ls[k].startswith("        "):
 51244	        k += 1
 51245	    for x in ls[k:]:
 51246	        if x.strip() and not (x[:1] == " " and x.lstrip().startswith("#")):
 51247	            return False, x
 51248	    return True, ""
