 51431	          f"--diff {f1}..{f2} --push-remote origin --pushed-ref refs/heads/feat" in dl, dl)
 51432	    check("②合過主線再推:lumos 從分岔點(主線頂端)算,不擋", rc == 0 and m1[:12] in ex and "分岔" in ex,
 51433	          f"rc={rc} {ex} {out[-500:]}")
 51434	    check("③前置:重定基底,原樣範圍直接交給 lumos 會擋", direct(f"{f1}..{f1r}") == 1, "")
 51435	    rc, dl, ex, out = hook(f"refs/heads/feat {f1r} refs/heads/feat {f1}\n")
 51436	    check("③重定基底後 force push:從分岔點算,不擋", rc == 0 and m1[:12] in ex, f"rc={rc} {ex} {out[-500:]}")
 51437	    rc, dl, ex, out = hook(f"refs/heads/feat {f1} refs/heads/feat {m0}\n")
 51438	    check("④一般增量推送(每個合併基底都是遠端舊值的祖先):照用遠端舊值", rc == 0 and "一般增量" in ex and m0[:12] in ex,
 51439	          f"rc={rc} {ex}")
