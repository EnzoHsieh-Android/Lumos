hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/zsh -lc "nl -ba scripts/hooks/pre-push | sed -n '1,90p'; nl -ba scripts/lumos | sed -n '3490,3565p'; rg -n '_note_audit_resolve|def cmd_drift_check|push=' scripts/lumos | head -30; nl -ba scripts/lumos | sed -n '28120,28315p'" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-hook
