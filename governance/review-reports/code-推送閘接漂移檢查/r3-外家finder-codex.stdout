 33140	def _push_range_start(repo_root, old, tip, remote, pushed_ref):
 33141	    """推送前掛鉤與 CI 的範圍起點 → (起點 sha 或 None, 說明)。None=頂端已在主線上、沒有新東西。
 33142	    old 是遠端舊值(40/64 個 0=新分支首推;本機可能找不到=force push 蓋掉的舊頂端),remote 是推送的遠端名,
 33143	    pushed_ref 是遠端那一側的 ref(refs/heads/X、refs/tags/Y)。
 33144	    ★起點只在這裡算一處★(推送閘接漂移檢查代碼審 r2:掛鉤的 bash、CI 的 shell 補法、工具端各算一份,三份各有洞):
 33145	    - 主線照 _push_mainline 找;找不到:舊值找得到用舊值;舊值全 0 從空樹算;舊值找不到退到頂端的第一個父提交
 33146	      (沒有父提交從空樹),只查最後一個提交——說明照實講。
 33147	    - 找到主線:頂端是主線的祖先(或相等)→ None;`merge-base --all` 沒有 → 同找不到主線;
 33148	      舊值找得到而且**每一個**合併基底都是舊值的祖先 → 用舊值(一般增量推送);否則用第一個不是舊值祖先的合併基底
 33149	      (功能分支合過主線、重定基底、交叉合併:用舊值的話 `舊..新` 會把合進來的主線提交——別人的轉正——算成這次的;
 33150	      只看 git 挑的那一個基底,交叉合併時會挑到舊值那個而退回原樣範圍)。舊值不在時用第一個基底。"""
 33151	    if old == _EMPTY_TREE_SHA:
 33152	        return old, "起點是空樹,從空樹比"
 33153	    zero = bool(_ZERO_SHA_RE.fullmatch(old or ""))
 33154	    old_sha = None if zero else _lens_full_sha(repo_root, old)
 33155	
 33156	    def _no_mainline(why):
 33157	        if old_sha:
 33158	            return old_sha, f"{why},用遠端舊值 {old_sha[:12]} 當起點"
 33159	        if zero:
 33160	            return _EMPTY_TREE_SHA, f"{why},新分支首推:從空樹算(截到上線點)"
 33161	        par = _lens_full_sha(repo_root, f"{tip}^1")
 33162	        if par:
 33163	            return par, f"{why},遠端舊值在本機找不到:從頂端的第一個父提交 {par[:12]} 算,只查最後一個提交"
 33164	        return _EMPTY_TREE_SHA, f"{why},遠端舊值在本機找不到、頂端沒有父提交:從空樹算"
 33165	
 33166	    ml = _push_mainline(repo_root, remote, pushed_ref)
 33167	    if ml is None:
 33168	        return _no_mainline("找不到主線(遠端預設分支、main/master 的 upstream、遠端 main/master 都沒有,或就是這次推的分支)")
 33169	    anc = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ml[1])
 33170	    if anc is not None and anc.returncode == 0:
 33171	        return None, f"頂端已在主線({ml[0]})上——沒有新東西"
 33172	    mb = _lens_git(repo_root, "merge-base", "--all", tip, ml[1])
 33173	    bases = [b for b in (mb.stdout.split() if (mb is not None and mb.returncode == 0) else []) if _LENS_SHA_RE.match(b)]
 33174	    if not bases:
 33175	        return _no_mainline(f"跟主線({ml[0]})沒有共同祖先")
 33176	    if old_sha:
 33177	        return _push_pick_base(repo_root, bases, old_sha, ml[0])
 33178	    what = "新分支首推" if zero else "遠端舊值在本機找不到"
 33179	    return bases[0], f"{what}:從跟主線({ml[0]})的分岔點 {bases[0][:12]} 算"
 33180	
