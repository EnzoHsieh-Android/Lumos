     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
     7	#
     8	# 為什麼需要:
     9	#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
    10	#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
    11	#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
    12	#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
    13	#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
    14	#
    15	# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
    16	#
    17	# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效
    18	
    19	set -u
    20	
    21	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    22	cd "$REPO_ROOT" || exit 0
    23	
    24	# ── stdin 必須最先讀(prepush範圍修法 #1)──
    25	# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
    26	# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
    27	# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
    28	_PP_LINES=()
    29	while IFS= read -r _line; do
    30	  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
    31	done
    32	
    33	_ZERO="0000000000000000000000000000000000000000"
    34	_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"
    35	
    36	# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
    37	# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
    38	# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
    39	pp_range_for() {
    40	  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    41	    printf '%s..%s' "$_EMPTY_TREE" "$2"
    42	  else
    43	    printf '%s..%s' "$1" "$2"
    44	  fi
    45	}
    46	
    47	# 會擋的閘「rc1 擋、其他非零放行」,但回傳碼 128 以上是被訊號殺掉(多半是 Ctrl-C)——那不是工具錯誤,不能當成放行往下跑。
    48	# 每支檔有家、筆記形狀擋、雙向門放行、code-loop check、存量漂移檢查都先過這一支(推送閘接漂移檢查代碼審 r2 架構對齊席:
    49	# 原本只有漂移那道會停)。$1=回傳碼 $2=閘名。
    50	pp_stop_if_signaled() {
    51	  if [[ "$1" -ge 128 ]]; then
    52	    echo "$2被中斷(rc=$1),推送停下,後面的檢查不跑。" >&2
    53	    exit "$1"
    54	  fi
    55	}
    56	
    57	# 推送的遠端名(git 傳給掛鉤的第一個參數;直接推網址時是網址、手動跑時是空的)——存量漂移檢查拿它找主線。
    58	_PP_REMOTE="${1:-}"
    59	
    60	# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
    61	# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
    62	# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
    63	pp_touched_file() {
    64	  local _f _r
    65	  [[ -n "$_EMPTY_TREE" ]] || return 0
    66	  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
    67	  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
    68	  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
    69	  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
    70	  _f="$_PP_TMP/touched.txt"
    71	  : > "$_f" 2>/dev/null || return 0
    72	  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    73	    read -r _ _lsha _ _rsha <<< "$_ppl"
    74	    [[ "$_lsha" == "$_ZERO" ]] && continue
    75	    _r="$(pp_range_for "$_rsha" "$_lsha")"
    76	    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
    77	  done
    78	  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
    79	}
    80	
    81	# 沒有 scripts/lumos → 降級放行(不為缺環境 brick push,CI 兜底);有 lumos 卻找不到 Python 3.14 → 擋下
    82	# (Projects/最低Python版本改3.14_計劃 做法第 3 點;PY 在下面讀完設定後才決定)
    83	GRAPHCTL="$REPO_ROOT/scripts/lumos"
    84	PY=""
    85	# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
    86	# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
    87	# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
    88	# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
    89	# LUMOS_PYTHON 有設就先試它:找不到時的說明叫人設它,第一步就不能不認。只收絕對路徑、而且真的是 python
    90	# (post-commit 直接把程式交給它跑,不經 lumos 驗;設成 /usr/bin/true 會假成功、漏寫跳過帳);不合格就記下原因往下找,
    91	# 版本夠不夠仍由 lumos 判。LUMOS_PYTHON 被略過、改用別支時當場印原因與後果:lumos 自己只認 LUMOS_PYTHON,
    92	# 之後的檢查會因同一個值擋下(代碼審 r3、r4;印在這段裡,七個呼叫端不必各寫一份)。
    93	_lumos_any_python() {
    94	  if _lumos_any_python_find; then
    95	    if [ -n "$_LUMOS_ANY_NOTE" ]; then
    96	      printf '%s改用 %s;但 lumos 只認 LUMOS_PYTHON,之後提交與推送前的檢查會因這個值擋下——修正它或 unset LUMOS_PYTHON。\n' \
    97	        "$_LUMOS_ANY_NOTE" "$_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG}" >&2
    98	    fi
    99	    return 0
   100	  fi
   101	  _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
   102	  return 1
   103	}
   104	_lumos_any_python_find() {
   105	  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""; _LUMOS_ANY_NOTE=""
   106	  if [ -n "${LUMOS_PYTHON:-}" ]; then
   107	    case "$LUMOS_PYTHON" in
   108	      /*|[A-Za-z]:[\\/]*)
   109	        if [ -x "$LUMOS_PYTHON" ] && [ "$("$LUMOS_PYTHON" -c 'print("LUMOS_PY_OK")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY_OK" ]; then
   110	          _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0
   111	        fi
   112	        _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不存在、不能執行或不是 python,略過。
   113	" ;;
   114	      *) _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不是絕對路徑,略過(相對路徑會隨目前目錄解析到別的檔)。
   115	" ;;
   116	    esac
   117	  fi
   118	  for _c in python3.14 python3.15 python3.16; do
   119	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
   120	  done
   330	  # ★跟上面 _range 是刻意不同的兩套★(代碼審 r1 架構席問過):_range 給波及計算與風險掃描用,只提醒、寧可掃多;
   331	  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
   332	  _hrange=""
   333	  if [[ "$_rsha" != "$_ZERO" ]] && git cat-file -e "$_rsha" 2>/dev/null; then
   334	    _hrange="$_rsha..$_lsha"
   335	  else
   336	    _hold="$(git rev-list --topo-order --reverse "$_lsha" --not --remotes 2>/dev/null | head -1)"
   337	    if [[ -n "$_hold" ]]; then
   338	      if git rev-parse -q --verify "$_hold^" >/dev/null 2>&1; then
   339	        _hrange="$(git rev-parse "$_hold^")..$_lsha"
   340	      else
   341	        _hrange="$_EMPTY_TREE..$_lsha"
   342	      fi
   343	    fi
   344	  fi
   345	  if [[ -n "$_hrange" ]]; then
   346	    nh_rc=0
   347	    "$PY" "$GRAPHCTL" home check --diff "$_hrange" --repo "$REPO_ROOT" || nh_rc=$?
   348	    pp_stop_if_signaled "$nh_rc" "每支檔有家檢查"
   349	    if [[ "$nh_rc" -eq 1 ]]; then
   350	      {
   351	        echo ""
   352	        echo "逃生:照上面的指令替檔安家、或把說明改寫進對的那篇,再推;整個專案先改成只提醒 → .lumos/config.json 的 node_home.gate 設成 warn;緊急硬推 git push --no-verify(本機不留痕)。"
   353	        echo ""
   354	      } >&2
   355	      exit 1
   356	    fi
   357	    # 筆記形狀擋(Projects/筆記形狀擋_計劃):同一段範圍再查一次,接住 --no-verify 跳過提交前那道的;範圍算法同上(不用空樹兜底)
   358	    ns_rc=0
   359	    "$PY" "$GRAPHCTL" note-shape --diff "$_hrange" --repo "$REPO_ROOT" || ns_rc=$?
   360	    pp_stop_if_signaled "$ns_rc" "筆記形狀擋"
   361	    if [[ "$ns_rc" -eq 1 ]]; then
   362	      {
   363	        echo ""
   364	        echo "逃生:照上面改寫(行號改成函式名或測試名、或釘版本 路徑@<提交編號>:行號;現況描述刪掉或帶 [來源:…]);誤擋就 LUMOS_SKIP_NOTE_SHAPE=1 單次跳過(會留帳);整個專案先只提醒 → .lumos/config.json 的 note_shape.gate 設成 warn。"
   365	        echo ""
   366	      } >&2
   367	      exit 1
   368	    fi
   369	  fi
   370	
   371	  impact_once "$_range"
   372	  pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
   373	  _tier_high=0
   374	  printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
   375	  _SUITE_SEEN=1
   376	  _suite_this="full"
   377	  printf '%s' "$pf_json" | grep -q '"suite": *"docs"' && _suite_this="docs"
   378	  printf '%s' "$pf_json" | grep -q '"suite_graph": *true' && _SUITE_GRAPH=1
   379	  if [[ "$_tier_high" -eq 1 ]]; then
   380	    {
   381	      echo ""
   382	      echo "提醒:這次推送的程式碼裡有高風險寫法(像是沒包交易的寫入、沒關的檔案控制代碼、沒限流的外部呼叫),tier=high。"
   383	      echo "命中的地方列在下面:"
   384	      "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
   385	      echo ""
   386	    } >&2
   387	  fi
   388	  # 留痕座標綁 remote_ref 目的地:refs/heads/* → 分支:★無條件★叫 check(表態閘 2026-09-09,Projects/棧別提問表態閘_計劃 S7):
   389	  # 合約測試紅 / 有適用題表態不完整 / tier=high 無留痕,三個獨立判定各自出各自的訊息、由 check 印
   390	  # ——這裡不再自己寫死「跑一輪代碼審」文案、也不再把它的輸出丟 /dev/null(r3 正確性席 C3)。非 heads → advisory。
   391	  # 雙向門放行(Projects/雙向門放行_計劃 S11–S14/S21):這次範圍碰到、仍 doing、有雙向門留痕的計劃,留痕裡的測試全綠才准推;
   392	  # 留痕過期(條款或它連到的節點變了)也擋。風險低計劃不派設計審,這裡是它唯一的閘;lumos 算不出範圍/索引就 fail-open 放行(rc≠1;128 以上是被中斷,停下)。
   393	  sg_rc=0
   394	  _sg_out="$_PP_TMP/sg-$RANDOM.log"
   395	  # tee:一邊即時印到 stderr(r1 併發席:先存檔跑完才印,人會以為卡住去 Ctrl-C)、一邊留一份給下面認 light 用;rc 取管線第一段
   396	  "$PY" "$GRAPHCTL" spec-gate --push-check "$_range" --repo "$REPO_ROOT" 2>&1 | tee "$_sg_out" >&2
   397	  sg_rc="${PIPESTATUS[0]}"
   398	  pp_stop_if_signaled "$sg_rc" "雙向門放行檢查(spec-gate)"
   399	  # push-check 判成 light(它才有圖譜、才知道計劃風險低與小改動閘過):改到程式檔也不跑全套,
   400	  # 只跑文件子集 + 原始碼提到「改到的函式/子命令/檔名」的測試;CI 那邊照樣跑全套當後盾。
   401	  # ★還要 pitfalls 說 light_ok★(r1 資安席):小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
   402	  # 會從它眼皮下溜過——範圍裡只要有一支這種檔,就不准少跑全套。
   403	  if [[ "$_suite_this" == "full" ]] && grep -q '改動風險分級:light' "$_sg_out" && printf '%s' "$pf_json" | grep -q '"light_ok": *true'; then
   404	    _suite_this="light"
   405	    _k="$(printf '%s' "$pf_json" | "$PY" -c 'import json,sys; print(",".join(json.load(sys.stdin).get("affected_keys", [])))' 2>/dev/null || true)"
   406	    [[ -n "$_k" ]] && _SUITE_KEYS="${_SUITE_KEYS:+$_SUITE_KEYS,}$_k"
   407	    printf '%s' "$pf_json" | grep -q '"autoloop_full": *true' && _AUTOLOOP_FULL=1
   408	  fi
   409	  case "$_suite_this" in full) _SUITE_FULL=1 ;; light) _SUITE_LIGHT=1 ;; esac
   410	  if [[ "$sg_rc" -eq 1 ]]; then
   411	    echo "" >&2
   412	    echo "風險低計劃的條款測試沒全綠(或留痕過期),推送擋下:把測試做綠、或重跑 lumos spec-gate <計劃> 之後再推。" >&2
   413	    exit 1
   414	  fi
   415	  if [[ "$_rref" == refs/heads/* ]]; then
   416	    _rbranch="${_rref#refs/heads/}"
   417	    cl_rc=0
   418	    # ★高風險這條路也把算好的那份傳進去★:不傳的話它會自己再算一次波及。
   419	    _fj=(); [ -n "$_IMPACT_JSON" ] && _fj=(--from-json "$_IMPACT_JSON")
   420	    # 低風險推送的受波及合約測試維持「只提醒不擋」(2026-09-07 全 repo 審視 #17 人裁);高風險不帶旗標,照擋
   421	    # pitfalls 沒吐 JSON(暫時失敗)就不帶 advisory:讓 check 自己算 tier 決定擋不擋(r1 外家 finder f4/否決 f3)
   422	    _ba=(); [[ -n "$pf_json" && "$_tier_high" -eq 0 ]] && _ba=(--bound-tests-advisory)
   423	    _cl_out="$("$PY" "$GRAPHCTL" code-loop check --diff "$_range" --at-sha "$_lsha" --branch "$_rbranch" \
   424	      --repo "$REPO_ROOT" ${_fj+"${_fj[@]}"} ${_ba+"${_ba[@]}"} 2>&1)" || cl_rc=$?
   425	    pp_stop_if_signaled "$cl_rc" "code-loop check"
   426	    if [[ "$cl_rc" -eq 1 ]]; then
   427	      # 逃逸自動記(規格落成可驗收條件_計劃 第五節):推送閘擋下=下游抓到了設計審/規格閘放行後的洞,
   428	      # 碰到的計劃筆記各記一筆;對不回就不記。★永遠 fail-open★——記帳失敗不能變成擋推送的第二個理由。
   429	      # ★只認「受波及合約的測試沒過」那型★:缺表態/高風險缺留痕是流程沒走完,不是下游抓到缺陷,不進逃逸帳(首輪前掃訂正)
   430	      if printf '%s' "$_cl_out" | grep -q "受波及合約的測試沒過"; then
   431	        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate --severity major \
   432	          --desc "推送閘擋下:$(printf '%s' "$_cl_out" | grep -m1 '受波及合約的測試沒過')" --range "$_range" --repo "$REPO_ROOT" >&2 || true
   433	      fi
   434	      # 高風險缺審查留痕:只有「該計劃被判成風險低、跳過設計審」才算逃逸(lumos 那邊查有沒有風險低留痕,沒有就不記)
   435	      # ★只認「tier=high 且…」開頭的缺留痕句★:測試紅的擋下句尾巴也帶 tier=high,認整個詞會兩筆都記(r2 回滾席)
   436	      if printf '%s' "$_cl_out" | grep -q "tier=high 且"; then
   437	        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate-unreviewed --severity major \
   438	          --desc "推送閘擋下:高風險缺審查留痕" --range "$_range" --repo "$REPO_ROOT" >&2 || true
   439	      fi
   440	      {
   441	        echo ""
   442	        printf '%s\n' "$_cl_out"
   443	        echo ""
   444	        echo "逃生路依上面 check 講的原因走:缺表態 → 先表態(上面的 dispositions 指令);高風險缺審查留痕 → 審過 lumos code-loop pass --note、或刻意不審 lumos code-loop skip --note \"為什麼\";合約測試紅 → 修測試。緊急硬推 git push --no-verify(本機不留痕,CI 會把這次推送標紅)"
   445	        echo ""
   446	      } >&2
   447	      exit 1
   448	    fi
   449	    # rc=0(已收斂/已表態/skip):check 的提醒行(低風險合約測試紅、設定檔警告、表態閘小結)原樣給人看;rc≠0/1(異常,128 以上除外):fail-open 放行
   450	    [ -n "$_cl_out" ] && { printf '%s\n' "$_cl_out" | grep -E '提醒|受波及合約測試|表態閘' >&2 || true; }
   451	  else
   452	    # 非分支 remote_ref(tag/其他 namespace):無 branch marker 通道,一律 advisory(r2 外家 F7)
   453	    [[ "$_tier_high" -eq 1 ]] && echo "提醒:這次推的是 tag 不是分支,高風險檢查只提醒不擋(advisory)。" >&2
   454	    if printf '%s' "$pf_json" | grep -q '"stack_questions_applicable": *{"'; then
   455	      {
   456	        echo ""
