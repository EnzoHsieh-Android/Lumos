 28244	def cmd_drift_check(repo=None, diff_range=None, push_remote=None, pushed_ref=None):
 28245	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 28246	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。
 28247	    帶 --push-remote 或 --pushed-ref(推送前掛鉤與 CI 用):A 當成遠端舊值,起點由 _push_range_start 算;
 28248	    都沒帶照共用起點判法(_lens_push_base),行為不變。"""
 28249	    import time as _t
 28250	    root = _note_audit_root(repo)
 28251	    if root is None:
 28252	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 28253	        return 0
 28254	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 28255	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 28256	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 28257	        return 0
 28258	    push = None if (push_remote is None and pushed_ref is None) else (push_remote or "", pushed_ref or "")
 28259	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 28260	                                               mark=_DRIFT_GOLIVE_MARK, push=push)
 28261	    if tip is None or isinstance(tip, int):
 28262	        return tip if isinstance(tip, int) else 0
 28263	    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 28264	    for w in warns:
 28265	        print(f"提醒:{w}", file=sys.stderr)
 28266	    if mode == "off":
 28267	        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 28268	        return 0
 28269	    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 28270	                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 28271	    acks = _drift_load_acks(root, tip)
 28272	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 28273	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 28274	    lst = _nodehome_list(root, tip)
 28275	    alive = set(lst[1]) if lst else None
 28276	    if listed:
 28277	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 28278	        _drift_print_findings(listed, sys.stderr, acks, alive)
 28279	        _drift_print_hints(listed, sys.stderr)
 28280	    if not must and not unknown:
 28281	        return 0
 28282	    return _drift_report_must(root, mode, must, unknown, acks, alive)
 28283	
