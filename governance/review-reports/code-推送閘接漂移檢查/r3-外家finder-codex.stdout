 33121	def _push_mainline(repo_root, remote, pushed_ref):
 33122	    """推送的主線 → (候選名, sha) 或 None。依序:遠端宣告的預設分支(refs/remotes/<遠端>/HEAD)→ main@{upstream}
 33123	    → master@{upstream} → <遠端>/main → <遠端>/master;沒給遠端名就跳過帶遠端的候選。
 33124	    ★跳過「就是這次被推的那條分支」★:推主線本身時,掛鉤裡 main@{upstream} 還是舊值、CI 裡 origin/main 已經等於頂端,
 33125	    拿它當主線會在 CI 判成「頂端已在主線、沒有新東西」整步跳過——跳過後兩邊都走「沒有別的主線、用遠端舊值」。
 33126	    指到哪條分支判不出來(遠端 HEAD 不是捷徑、upstream 的遠端名讀不到)就不跳過。"""
 33127	    pushed = pushed_ref[len("refs/heads/"):] if (pushed_ref or "").startswith("refs/heads/") else None
 33128	    cands = ([f"refs/remotes/{remote}/HEAD"] if remote else []) + ["main@{upstream}", "master@{upstream}"] \
 33129	        + ([f"refs/remotes/{remote}/main", f"refs/remotes/{remote}/master"] if remote else [])
 33130	    for cand in cands:
 33131	        sha = _lens_full_sha(repo_root, cand)
 33132	        if not sha:
 33133	            continue
 33134	        if pushed is not None and _push_mainline_branch(repo_root, cand, remote) == pushed:
 33135	            continue
 33136	        return cand, sha
 33137	    return None
