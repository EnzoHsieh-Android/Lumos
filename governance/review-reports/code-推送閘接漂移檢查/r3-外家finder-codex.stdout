 33192	def _lens_git(repo_root, *args, quote=False, binary=False):
 33193	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 33194	    import subprocess as _sp
 33195	    cmd = ["git", "-C", str(repo_root)]
 33196	    if quote:
 33197	        cmd += ["-c", "core.quotePath=false"]
 33198	    try:
 33199	        if binary:
 33200	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 33201	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 33202	    except (OSError, _sp.TimeoutExpired):
 33203	        return None
