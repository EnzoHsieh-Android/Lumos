 51472	def t_prepush_drift_start_mainline_shapes():
 51473	    """推送起點找主線的三種形狀(推送閘接漂移檢查代碼審 r2 正確性席 F2、F3,邊界席 F1):
 51474	    ①git-flow:遠端 HEAD 指 develop、本地 main 的 upstream 過期,功能分支合過 develop 再推 → 用遠端 HEAD,不擋;
 51475	    ②主線叫 trunk、本地留著過期的 master upstream → 用遠端 HEAD,不擋;
 51476	    ③交叉合併(兩個合併基底)兩種提交先後都不擋——要每一個基底都是遠端舊值的祖先才用舊值。
 51477	    每一種先證明原樣範圍(或過期主線算出的範圍)直接交給 lumos 會擋。
 51478	
 51479	    翻紅釘:主線候選改回 upstream 優先(遠端 HEAD 排後面)→ ①②紅;合併基底只看 git 挑的第一個 → ③其中一種先後紅。
 51480	    """
 51481	    print("t_prepush_drift_start_mainline_shapes")
 51482	    _need_src("scripts/hooks/pre-push")
 51483	    z = "0" * 40
 51484	    # ① git-flow
 51485	    root, bare, g = _dr_push_repo()
 51486	    m0 = _na_head(root)
 51487	    g("checkout", "-q", "-b", "develop")
 51488	    g("push", "-q", "--no-verify", "-u", "origin", "develop")
 51489	    g("symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/develop")
 51490	    g("checkout", "-q", "-b", "feat")
 51491	    _nh_file(root, "notes/a.txt", "a\n")
 51492	    _nh_commit(root, "feat 無關")
 51493	    f1 = _na_head(root)
 51494	    g("push", "-q", "--no-verify", "origin", "feat")
 51495	    g("checkout", "-q", "develop")
 51496	    _dr_settle(root, "G")
 51497	    _nh_commit(root, "D1 別人在 develop 轉正")
 51498	    d1 = _na_head(root)
 51499	    g("push", "-q", "--no-verify", "origin", "develop")
 51500	    g("checkout", "-q", "feat")
 51501	    g("merge", "-q", "--no-edit", "--no-verify", "develop")
 51502	    f2 = _na_head(root)
 51503	    _dr_hook_fakes(root)
 51504	    stale = _nh_git(root, "rev-parse", "main@{upstream}").stdout.strip()
 51505	    check("①前置:本地 main 的 upstream 過期(停在 M0),原樣範圍 F1..F2 直接交給 lumos 會擋",
 51506	          stale == m0 and _dr(root, "check", "--diff", f"{f1}..{f2}")[0] == 1, stale)
 51507	    rc, _dl, ex, out = _dr_hook_start(root, f"refs/heads/feat {f2} refs/heads/feat {f1}\n", ("origin", str(bare)))
 51508	    check("①git-flow:用遠端宣告的預設分支(develop),從 D1 算,不擋", rc == 0 and "origin/HEAD" in ex and d1[:12] in ex,
 51509	          f"rc={rc} {ex} {out[-500:]}")
 51510	    # ② trunk + 過期的 master upstream(遠端叫 fork)
 51511	    root, bare, g = _dr_push_repo(branch="master", remote="fork")
 51512	    m0 = _na_head(root)
 51513	    g("checkout", "-q", "-b", "trunk")
 51514	    _dr_settle(root, "G")
 51515	    _nh_commit(root, "T1 別人在 trunk 轉正")
 51516	    t1 = _na_head(root)
 51517	    g("push", "-q", "--no-verify", "fork", "trunk")
 51518	    g("symbolic-ref", "refs/remotes/fork/HEAD", "refs/remotes/fork/trunk")
 51519	    g("checkout", "-q", "-b", "feat2")
 51520	    _nh_file(root, "notes/b.txt", "b\n")
 51521	    _nh_commit(root, "feat2 無關")
 51522	    n = _na_head(root)
 51523	    g("checkout", "-q", "master")
 51524	    _dr_hook_fakes(root)
 51525	    stale = _nh_git(root, "rev-parse", "master@{upstream}").stdout.strip()
 51526	    check("②前置:master 的 upstream 過期(停在 M0),從它算的範圍直接交給 lumos 會擋",
 51527	          stale == m0 and _dr(root, "check", "--diff", f"{m0}..{n}")[0] == 1, stale)
 51528	    rc, _dl, ex, out = _dr_hook_start(root, f"refs/heads/feat2 {n} refs/heads/feat2 {z}\n", ("fork", str(bare)))
 51529	    check("②主線叫 trunk:用遠端 HEAD(fork/trunk),從 T1 算,不擋", rc == 0 and "fork/HEAD" in ex and t1[:12] in ex,
 51530	          f"rc={rc} {ex} {out[-500:]}")
 51531	    # ③ 交叉合併
 51532	    for order in ("主線先合", "分支先合"):
 51533	        root, bare, g = _dr_push_repo()
 51534	        g("checkout", "-q", "-b", "feat")
 51535	        _nh_file(root, "notes/a.txt", "a\n")
 51536	        _nh_commit(root, "feat 無關")
 51537	        f1 = _na_head(root)
 51538	        g("push", "-q", "--no-verify", "origin", "feat")
 51539	        g("checkout", "-q", "main")
 51540	        _dr_settle(root, "G")
 51541	        _nh_commit(root, "M1 別人轉正")
 51542	        m1 = _na_head(root)
 51543	        # 主線把 feat(F1)合進去、feat 把 M1 合進來——兩邊互合,F1 與 M1 都是合併基底;先後兩種都跑
 51544	        merges = [("main", f1), ("feat", m1)] if order == "主線先合" else [("feat", m1), ("main", f1)]
 51545	        for br, other in merges:
 51546	            g("checkout", "-q", br)
 51547	            g("merge", "-q", "--no-ff", "--no-edit", "--no-verify", other)
 51548	        g("checkout", "-q", "main")
 51549	        g("push", "-q", "--no-verify", "origin", "main")
 51550	        g("checkout", "-q", "feat")
 51551	        f2 = _na_head(root)
 51552	        bases = _nh_git(root, "merge-base", "--all", f2, "origin/main").stdout.split()
 51553	        _dr_hook_fakes(root)
 51554	        check(f"③前置({order}):兩個合併基底(F1 與 M1),原樣範圍直接交給 lumos 會擋",
 51555	              sorted(bases) == sorted([f1, m1]) and _dr(root, "check", "--diff", f"{f1}..{f2}")[0] == 1, str(bases))
 51556	        rc, _dl, ex, out = _dr_hook_start(root, f"refs/heads/feat {f2} refs/heads/feat {f1}\n", ("origin", str(bare)))
 51557	        check(f"③交叉合併({order}):從不是遠端舊值祖先的那個基底(M1)算,不擋", rc == 0 and m1[:12] in ex,
 51558	              f"rc={rc} {ex} {out[-500:]}")
 51559	
