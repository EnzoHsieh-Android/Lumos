 33182	def _push_pick_base(repo_root, bases, old_sha, ml_name):
 33183	    """遠端舊值找得到時:每一個合併基底都是舊值的祖先(或相等)→ 用舊值;否則用第一個不是舊值祖先的基底。
 33184	    git 判不了(逾時)的基底當成不是祖先——寧可多查自己上次推過的,也不把舊值之後主線合進來的算成這次的。"""
 33185	    for b in bases:
 33186	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", b, old_sha)
 33187	        if r is None or r.returncode != 0:
 33188	            return b, f"遠端舊值跟主線({ml_name})分岔(合過主線或重定基底):從分岔點 {b[:12]} 算"
 33189	    return old_sha, f"一般增量推送:從遠端舊值 {old_sha[:12]} 算"
 33190	
