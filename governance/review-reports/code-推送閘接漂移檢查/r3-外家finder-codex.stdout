 26491	def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
 26492	    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
 26493	    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
 26494	    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
 26495	    lst = _drift_list(root, where)
 26496	    if lst is None:
 26497	        return None
 26498	    pre = vault_rel.rstrip("/") + "/"
 26499	    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
 26500	    import time as _t
 26501	    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
 26502	    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
 26503	    blobs = _drift_cat(root, where, paths, left) if paths else []
 26504	    if blobs is None:
 26505	        return None
 26506	    texts, bad = {}, []
 26507	    for p, b in zip(paths, blobs):
 26508	        if b is None:
 26509	            # 樹上列得出、內容讀不出來:建成讀不出的筆記(代碼審 r2 外家席:原本跳過,等於當成不存在)
 26510	            bad.append(p[len(pre):])
 26511	            continue
 26512	        try:
 26513	            texts[p[len(pre):]] = b.decode("utf-8-sig")
 26514	        except UnicodeDecodeError:
 26515	            bad.append(p[len(pre):])
 26516	    texts.update(override or {})
 26517	    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])
