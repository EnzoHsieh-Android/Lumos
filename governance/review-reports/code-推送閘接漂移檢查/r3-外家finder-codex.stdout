 28231	        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
 28232	              file=stream)
 28233	        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
 28234	        prev = _drift_prev_ack_line(f)
