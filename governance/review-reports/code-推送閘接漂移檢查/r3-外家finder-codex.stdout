 51441	    rc, dl, ex, out = hook(f"refs/heads/inc {i2} refs/heads/inc {i1}\n")
 51442	    check("④一般增量推送只看這次新加的:從遠端舊值算,不把上次已推的再算一次", rc == 0 and "一般增量" in ex and i1[:12] in ex,
 51443	          f"rc={rc} {ex} {out[-400:]}")
 51444	    rc, dl, ex, out = hook(f"refs/heads/own {own} refs/heads/own {m1}\n")
