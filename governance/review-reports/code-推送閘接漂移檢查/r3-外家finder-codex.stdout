 24153	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 24154	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 24155	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 24156	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 24157	    None=整批當成一個提交(提交前)。"""
 24158	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 24159	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 24160	    homesN, ownN = _nodehome_homes(repo_root, N)
 24161	    homesB, ownB = _nodehome_homes(repo_root, B)
 24162	    blocks, reminders, pairs = [], [], []
 24163	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 24164	    for code, old, new in changes:
 24165	        if old is not None and (new is None or code == "R"):
 24166	            deleted.add(old)
 24167	        if new is None:
 24168	            continue
 24169	        changed_new.add(new)
 24170	        if code in ("A", "R", "C"):
 24171	            added.add(new)
 24172	        if code == "R" and old:
 24173	            renamed_from[new] = old
 24174	    code_changed = {p for p in changed_new if p in reqN}
 24175	    code_added = {p for p in added if p in reqN}
 24176	    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
 24177	    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
 24178	    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
 24179	    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
 24180	    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
