 33280	def _lens_full_sha(repo_root, rev):
 33281	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 33282	    if r is None or r.returncode != 0:
 33283	        return None
 33284	    sha = r.stdout.strip()
 33285	    return sha if _LENS_SHA_RE.match(sha) else None
