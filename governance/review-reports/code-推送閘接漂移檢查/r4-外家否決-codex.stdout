 33266	def _lens_git(repo_root, *args, quote=False, binary=False):
 33267	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 33268	    import subprocess as _sp
 33269	    cmd = ["git", "-C", str(repo_root)]
 33270	    if quote:
 33271	        cmd += ["-c", "core.quotePath=false"]
 33272	    try:
 33273	        if binary:
 33274	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 33275	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 33276	    except (OSError, _sp.TimeoutExpired):
 33277	        return None
