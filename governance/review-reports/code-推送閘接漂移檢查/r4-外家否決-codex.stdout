   670	+def _dr_ci_call_lines(text):
   671	+    """CI 那段 shell 從補 before 那一行到 drift check 那一行(含中間補 origin/HEAD 那段),去掉 python 直譯器名與
   672	+    CI 那邊接的 `|| {`——ci.yml 與健檢範本比對逐字相同用。"""
   673	+    ls = [x.strip() for x in text.split("\n")]
   674	+    i = next((k for k, x in enumerate(ls) if x.startswith('[ -n "$BEFORE" ]')), None)
   675	+    j = next((k for k, x in enumerate(ls) if "scripts/lumos drift check" in x), None)
   676	+    if i is None or j is None or j < i:
   677	+        return ""
   678	+    dr = ls[j][ls[j].find("scripts/lumos"):].split(" || {")[0]
   679	+    return "\n".join([*ls[i:j], dr])
