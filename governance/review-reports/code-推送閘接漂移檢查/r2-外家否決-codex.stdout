 28891	def _ci_has_full_history(body):
 28892	    """工作項目裡有沒有 `fetch-depth: 0` 這個設定——只認設定行本身,多行腳本(`run: |`)裡剛好出現的字樣不算
 28893	    (驗收輪外家席:腳本裡 echo 那串字就被當成抓了完整歷史)。"""
 28894	    blk = None
 28895	    for ln in body:
 28896	        ind = len(ln) - len(ln.lstrip(" "))
 28897	        if blk is not None:
 28898	            if ind > blk:
 28899	                continue
 28900	            blk = None
 28901	        if re.search(r":\s*[|>][-+0-9]*\s*$", ln):
 28902	            blk = ind
 28903	            continue
 28904	        if re.match(r"^\s*(?:-\s+)?fetch-depth\s*:\s*[\"']?0[\"']?\s*$", ln):
 28905	            return True
 28906	    return False
