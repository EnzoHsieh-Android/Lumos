    90	# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
    91	# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
    92	# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
    93	pp_touched_file() {
    94	  local _f _r
    95	  [[ -n "$_EMPTY_TREE" ]] || return 0
    96	  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
    97	  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
    98	  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
    99	  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
   100	  _f="$_PP_TMP/touched.txt"
   101	  : > "$_f" 2>/dev/null || return 0
   102	  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
   103	    read -r _ _lsha _ _rsha <<< "$_ppl"
   104	    [[ "$_lsha" == "$_ZERO" ]] && continue
   105	    _r="$(pp_range_for "$_rsha" "$_lsha")"
   106	    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
   107	  done
   108	  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
   109	}
