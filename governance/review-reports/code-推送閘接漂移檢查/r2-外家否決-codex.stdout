 28462	def _drift_set_status_text(text, status):
 28463	    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
 28464	    lines = text.split("\n")
 28465	    e = _drift_fm_end(lines)
 28466	    if not e:
 28467	        return text
 28468	    fm = edit_fm_scalar(lines[1:e], "status", status)
 28469	    fm, _s = edit_fm_sync_status_tag(fm, status)
 28470	    return "\n".join(lines[:1] + fm + lines[e:])
 28471	
