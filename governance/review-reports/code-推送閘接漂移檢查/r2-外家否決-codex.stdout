    36	# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
    37	# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
    38	# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
    39	pp_range_for() {
    40	  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    41	    printf '%s..%s' "$_EMPTY_TREE" "$2"
    42	  else
    43	    printf '%s..%s' "$1" "$2"
    44	  fi
    45	}
    46	
    47	# 存量漂移檢查的範圍(代碼審 r1 正確性席 F1、F2;併發回滾席 F1)。$1=remote_sha $2=local_sha → 設 _DR_RANGE 與 _DR_NOTE。
    48	# ★起點取「遠端舊值」與「本地新值跟主線的分岔點」裡比較新的★:
    49	#   - 分岔點是遠端舊值的祖先(或同一個)→ 遠端舊值較新,用它(一般的增量推送,只看這次新加的);
    50	#   - 遠端舊值是全 0(新分支)、本機找不到、或兩者分岔(功能分支合過主線、重定基底後 force push)→ 用分岔點。
    51	#     分岔那種情況若用遠端舊值,`git log 舊..新` 會把合進來的主線提交(別人的轉正)算成這次帶進來的而誤報或誤擋;
    52	#     用分岔點頂多把自己上次已推過的提交再看一次(那是自己的東西)。
    53	# ★為什麼掛鉤自己算、不原樣交給 lumos★:lumos 的共用起點判法只在遠端舊值是全 0 或找不到時才算分岔點,
    54	#   而且主線只認 main/master 的 upstream——沒設 upstream 就退回從空樹算、截到上線點,把上線後主線的舊帳全算進新分支。
    55	# 主線依序找:main@{upstream} → master@{upstream} → 這次推送的遠端的預設分支(refs/remotes/<遠端>/HEAD)→ <遠端>/main
    56	#   → <遠端>/master(遠端名是 git 傳給掛鉤的第一個參數);都找不到才原樣交給 lumos 自己判,並講一聲。
    57	_PP_REMOTE="${1:-}"
    58	pp_mainline() {   # 印主線頂端的提交編號;找不到什麼都不印
    59	  local _c _cands=("main@{upstream}" "master@{upstream}")
    60	  if [[ -n "$_PP_REMOTE" ]]; then
    61	    _cands+=("refs/remotes/$_PP_REMOTE/HEAD" "refs/remotes/$_PP_REMOTE/main" "refs/remotes/$_PP_REMOTE/master")
    62	  fi
    63	  for _c in "${_cands[@]}"; do
    64	    git rev-parse -q --verify "$_c^{commit}" 2>/dev/null && return 0
    65	  done
    66	  return 0
    67	}
    68	pp_drift_range() {
    69	  local _ml _mb
    70	  _DR_NOTE=""
    71	  _DR_RANGE="$1..$2"
    72	  _ml="$(pp_mainline)"
    73	  if [[ -z "$_ml" ]]; then
    74	    _DR_NOTE="找不到主線(main/master 沒設 upstream,遠端 ${_PP_REMOTE:-(不明)} 也沒有 HEAD/main/master),起點交給 lumos 自己判;新分支可能把主線上別人的改動算進來"
    75	    return 0
    76	  fi
    77	  _mb="$(git merge-base "$2" "$_ml" 2>/dev/null | head -1)"
    78	  if [[ -z "$_mb" ]]; then
    79	    _DR_NOTE="要推的提交跟主線沒有共同祖先,起點交給 lumos 自己判"
    80	    return 0
    81	  fi
    82	  if [[ "$1" != "$_ZERO" ]] && git cat-file -e "$1^{commit}" 2>/dev/null \
    83	     && git merge-base --is-ancestor "$_mb" "$1" 2>/dev/null; then
    84	    _DR_RANGE="$1..$2"
    85	  else
    86	    _DR_RANGE="$_mb..$2"
    87	  fi
    88	}
