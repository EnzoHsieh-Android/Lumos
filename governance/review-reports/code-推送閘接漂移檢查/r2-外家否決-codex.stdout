 28443	_DRIFT_CI_STEP = """
 28444	    - name: drift check
 28445	      if: github.event_name == 'push'
 28446	      env:
 28447	        BEFORE: ${{ github.event.before }}
 28448	        SHA: ${{ github.sha }}
 28449	      run: |
 28450	        if [ -z "$BEFORE" ] || [ "$BEFORE" = 0000000000000000000000000000000000000000 ] || ! git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
 28451	          OLD="${BEFORE:-(空的)}"
 28452	          BEFORE="$(git rev-parse -q --verify "$SHA^1^{commit}" 2>/dev/null || git hash-object -t tree /dev/null)"
 28453	          echo "漂移檢查起點:before=$OLD 是新分支首推或本機找不到,改從 $BEFORE 算(至少查這次推送的最後一個提交)"
 28454	        fi
 28455	        python3 scripts/lumos drift check --diff "$BEFORE..$SHA" --repo .
 28456	  (checkout 要設 fetch-depth: 0。回傳碼照原樣讓這步紅綠:0 是沒有要處理或 warn 模式只印;1 是 block 模式擋下;
 28457	   其他非零是工具出錯或參數錯,也會紅——工具出錯時寧可紅)"""
