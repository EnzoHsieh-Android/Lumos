-                   "\n    - run: python3 scripts/lumos drift check --diff \"${{ github.event.before || "
-                   "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"" + _CI_PY314_NOTE)
+                   + _DRIFT_CI_STEP + _CI_PY314_NOTE)
     return out
 
 
+# doctor 給消費專案貼的 CI 步驟(推送閘接漂移檢查代碼審 r1 外家席 F2 的同一個洞):before 是空的、40 個 0、或本機找不到時,
+# ★不能原樣交給 lumos★——前面的步驟 fetch 過的話,main 的 upstream 就是這次頂端,共用起點判法會判「頂端已在主線、沒有新東西」
+# 整步跳過。改用頂端的第一個父提交(沒有父提交就從空樹),至少查這次推送的最後一個提交。起點補法那幾行跟工具鏈自己的
+# .github/workflows/ci.yml 那步逐字相同(t_doctor_drift_ci_template_start_fallback 比對並真的跑一次)。
+_DRIFT_CI_STEP = """
+    - name: drift check
+      if: github.event_name == 'push'
+      env:
+        BEFORE: ${{ github.event.before }}
+        SHA: ${{ github.sha }}
+      run: |
+        if [ -z "$BEFORE" ] || [ "$BEFORE" = 0000000000000000000000000000000000000000 ] || ! git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
+          OLD="${BEFORE:-(空的)}"
+          BEFORE="$(git rev-parse -q --verify "$SHA^1^{commit}" 2>/dev/null || git hash-object -t tree /dev/null)"
+          echo "漂移檢查起點:before=$OLD 是新分支首推或本機找不到,改從 $BEFORE 算(至少查這次推送的最後一個提交)"
+        fi
+        python3 scripts/lumos drift check --diff "$BEFORE..$SHA" --repo .
+  (checkout 要設 fetch-depth: 0。回傳碼照原樣讓這步紅綠:0 是沒有要處理或 warn 模式只印;1 是 block 模式擋下;
+   其他非零是工具出錯或參數錯,也會紅——工具出錯時寧可紅)"""
+
+
 # ── 考試 ─────────────────────────────────────────────────────────────────────────────
 
 def _drift_set_status_text(text, status):
     """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
     lines = text.split("\n")
     e = _drift_fm_end(lines)
     if not e:
         return text
     fm = edit_fm_scalar(lines[1:e], "status", status)
     fm, _s = edit_fm_sync_status_tag(fm, status)
