+def t_doctor_drift_ci_template_start_fallback():
+    """doctor 給消費專案貼的 CI 步驟(已接線、CI 沒呼叫 drift check 時唸):before 是空的、40 個 0、本機找不到時改從頂端的
+    第一個父提交算(沒有父提交從空樹),印一行說明;回傳碼照原樣(0 綠、1 紅、其他非零也紅)。起點補法那幾行跟工具鏈自己的
+    ci.yml 逐字相同,並在一個真的 git 專案裡跑一次。
+
+    翻紅釘:範本改回「before 空的補 40 個 0 原樣交給 lumos」→ ②③紅(那樣新分支首推會被判「頂端已在主線」整步跳過)。
+    """
+    print("t_doctor_drift_ci_template_start_fallback")
+    import subprocess as sp, os as _os, textwrap as _tw
+    m = _load_lumos_inproc()
+    root = _dr_repo()
+    _nh_file(root, ".github/workflows/ci.yml", "name: CI\non: push\njobs:\n  t:\n    runs-on: ubuntu-latest\n    steps:\n"
+             "      - run: echo hi\n")
+    lines = m._drift_gate_doctor_lines(root)
+    hint = next((l for l in lines if "沒呼叫 `lumos drift check`" in l), "")
+    check("①前置:已接線、CI 沒呼叫 drift check → doctor 唸並給要貼的步驟", bool(hint), str(lines))
+    body_lines, grab = [], False
+    for ln in hint.split("\n"):
+        if ln.strip() == "run: |":
+            grab = True
+            continue
+        if grab:
+            if not ln.startswith("        "):
+                break
+            body_lines.append(ln)
+    body = _tw.dedent("\n".join(body_lines)) + "\n"
+
+    def fallback(text):
+        ls = text.split("\n")
+        i = next((k for k, x in enumerate(ls) if x.startswith('if [ -z "$BEFORE" ]')), None)
+        j = next((k for k, x in enumerate(ls) if i is not None and k > i and x == "fi"), None)
+        return "\n".join(ls[i:j + 1]) if i is not None and j is not None else ""
+
+    ci = (Path(GRAPHCTL).resolve().parent.parent / ".github" / "workflows" / "ci.yml")
+    if ci.is_file():
+        import re as _re
+        step = next((x for x in _re.split(r"\n(?=      - )", ci.read_text(encoding="utf-8")) if "drift check --diff" in x), "")
+        mm = _re.search(r"\n        run: \|\n((?:          .*\n?|\s*\n)+)", step)
+        ci_body = _tw.dedent(mm.group(1)) if mm else ""
+        check("②範本的起點補法跟工具鏈 ci.yml 那步逐字相同", bool(fallback(body)) and fallback(body) == fallback(ci_body),
+              fallback(body) + "\n----\n" + fallback(ci_body))
+    cr = Path(tempfile.mkdtemp(prefix="gctl-drift-tpl-repo-"))
+    sp.run(["git", "init", "-q", str(cr)], capture_output=True)
+    shas = []
+    for i in range(2):
+        (cr / f"f{i}.txt").write_text(str(i), encoding="utf-8")
+        sp.run(["git", "-C", str(cr), "add", "-A"], capture_output=True)
+        sp.run(["git", "-C", str(cr), "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", f"c{i}", "--no-verify"],
+               capture_output=True)
+        shas.append(sp.run(["git", "-C", str(cr), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip())
+    fb = Path(tempfile.mkdtemp(prefix="gctl-drift-tpl-"))
+    (fb / "python3").write_text("#!/bin/bash\necho \"python3 $*\" > \"$FAKE_LOG\"\nexit \"$FAKE_RC\"\n", encoding="utf-8")
+    _os.chmod(fb / "python3", 0o755)
+
+    def run_step(before, sha, frc="0"):
+        (fb / "log").unlink(missing_ok=True)
+        e = dict(_os.environ, PATH=f"{fb}:{_os.environ.get('PATH', '')}", FAKE_RC=frc, FAKE_LOG=str(fb / "log"),
+                 BEFORE=before, SHA=sha)
+        e.pop("GIT_DIR", None)
+        r = sp.run(["bash", "-e", "-c", body], cwd=str(cr), capture_output=True, text=True, env=e, timeout=30)
+        called = (fb / "log").read_text(encoding="utf-8") if (fb / "log").exists() else ""
+        return r.returncode, called, r.stdout + r.stderr
+
+    empty = sp.run(["git", "hash-object", "-t", "tree", "/dev/null"], capture_output=True, text=True).stdout.strip()
+    ok = True
+    detail = []
+    for before, sha, want in (("", shas[1], shas[0]), ("0" * 40, shas[1], shas[0]), ("de" * 20, shas[1], shas[0]),
+                              ("0" * 40, shas[0], empty), (shas[0], shas[1], shas[0])):
+        _rc, called, out = run_step(before, sha)
+        good = f"drift check --diff {want}..{sha} --repo ." in called and (before == shas[0] or "漂移檢查起點" in out)
+        ok = ok and good
+        detail.append(f"{before[:6] or '空'}→{called.strip()[:90]} {good}")
+    check("③範本真的跑:before 空的/全 0/找不到 → 頂端的父提交;沒有父提交 → 空樹;找得到照用;補的時候印一行", ok,
+          "\n".join(detail))
+    got = {frc: run_step(shas[0], shas[1], frc)[0] for frc in ("0", "1", "2")}
+    check("④回傳碼照原樣:0 綠、1 紅、其他非零也紅,說明裡照實寫", got == {"0": 0, "1": 1, "2": 2}
+          and "1 是 block 模式擋下" in hint and "其他非零" in hint, str(got))
+
+
+def t_prepush_drift_range_ref_shapes():
+    """[S18] 推送前掛鉤替 drift check 算範圍起點:跟主線的分岔點與遠端舊值取比較新的(代碼審 r1 正確性席 F1、F2)。
+    功能分支合過主線再推、重定基底後 force push、新分支首推、主分支沒設 upstream,都不把主線上別人的轉正算成這次的;
+    自己分支(或 tag)裡的轉正照擋;主線找不到才原樣交給 lumos 並講一聲。
+
+    每一種先證明現場成立:同一段原樣範圍直接交給 lumos 會擋(rc1),才看掛鉤放行。
+
+    翻紅釘:分岔那種情況改用遠端舊值 → ②③紅;主線只找 upstream(拿掉遠端 HEAD/main/master)→ ⑥紅。
+    """
+    print("t_prepush_drift_range_ref_shapes")
+    _need_src("scripts/hooks/pre-push")
+    import subprocess as sp
+    z = "0" * 40
+    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
+    vault = root / _DR_VAULT
+    g = lambda *a: _nh_git(root, *a)
+    g("branch", "-M", "main")
+    bare = Path(tempfile.mkdtemp(prefix="gctl-dr-remote-")) / "r.git"
+    sp.run(["git", "init", "-q", "--bare", str(bare)], capture_output=True)
+    g("remote", "add", "origin", str(bare))
+    (vault / "Verification" / "G.md").write_text(_dr_guard_text("pending"), encoding="utf-8")
+    (vault / "Verification" / "G2.md").write_text(_dr_guard_text("pending", claim="小額退費自動核可"), encoding="utf-8")
+    _nh_commit(root, "M0")
+    m0 = _na_head(root)
+    g("push", "-q", "--no-verify", "-u", "origin", "main")
+    g("symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/main")
+    g("checkout", "-q", "-b", "feat")
+    _nh_file(root, "notes/a.txt", "a\n")
+    _nh_commit(root, "feat: 無關的改動")
+    f1 = _na_head(root)
+    g("push", "-q", "--no-verify", "origin", "feat")
+    g("checkout", "-q", "main")
+    _dr_settle(root, "G")
+    _nh_commit(root, "M1:別人在主線上舊版 settle,預告句留著")
+    m1 = _na_head(root)
+    g("push", "-q", "--no-verify", "origin", "main")
+    # 合過主線
+    g("checkout", "-q", "feat")
+    g("merge", "-q", "--no-edit", "--no-verify", "main")
+    f2 = _na_head(root)
+    # 重定基底(另一條分支,從 f1 起)
+    g("checkout", "-q", "-b", "feat_rb", f1)
+    g("rebase", "-q", "main")
+    f1r = _na_head(root)
+    # 新分支(從主線頂端,只帶無關改動)
+    g("checkout", "-q", "-b", "newb", "main")
+    _nh_file(root, "notes/b.txt", "b\n")
+    _nh_commit(root, "newb: 無關的改動")
+    nb = _na_head(root)
+    # 自己的分支裡自己轉正
+    g("checkout", "-q", "-b", "own", "main")
+    _dr_settle(root, "G2")
+    _nh_commit(root, "own: 自己轉正,預告句留著")
+    own = _na_head(root)
+    g("tag", "v-own", own)
+    g("checkout", "-q", "main")
+    _dr_hook_fakes(root)
+
+    def direct(rng):
+        return _dr(root, "check", "--diff", rng)[0]
+
+    def hook(stdin, args=("origin", str(bare))):
+        rc, lines, out = _dr_hook_run(root, stdin, args)
+        dl = next((l for l in lines if l.startswith("drift check")), "")
+        return rc, dl, out
+
+    check("①前置:主線上別人那次轉正是真的發現(M0..M1 直接交給 lumos 會擋)", direct(f"{m0}..{m1}") == 1, "")
+    check("②前置:合過主線,原樣的 遠端舊值..本地新值 直接交給 lumos 會擋", direct(f"{f1}..{f2}") == 1, "")
+    rc, dl, out = hook(f"refs/heads/feat {f2} refs/heads/feat {f1}\n")
+    check("②合過主線再推:起點用分岔點(主線頂端),不擋", rc == 0 and f"--diff {m1}..{f2}" in dl, f"rc={rc} {dl} {out[-500:]}")
+    check("③前置:重定基底,原樣範圍直接交給 lumos 會擋", direct(f"{f1}..{f1r}") == 1, "")
+    rc, dl, out = hook(f"refs/heads/feat {f1r} refs/heads/feat {f1}\n")
+    check("③重定基底後 force push:起點用分岔點,不擋", rc == 0 and f"--diff {m1}..{f1r}" in dl, f"rc={rc} {dl} {out[-500:]}")
+    rc, dl, out = hook(f"refs/heads/feat {f1} refs/heads/feat {m0}\n")
+    check("④一般增量推送(遠端舊值比分岔點新或相同):照用遠端舊值", rc == 0 and f"--diff {m0}..{f1}" in dl, f"rc={rc} {dl}")
+    rc, dl, out = hook(f"refs/heads/newb {nb} refs/heads/newb {z}\n")
+    check("⑤新分支首推(全 0):從分岔點算,不擋", rc == 0 and f"--diff {m1}..{nb}" in dl, f"rc={rc} {dl} {out[-500:]}")
+    rc, dl, out = hook(f"refs/heads/own {own} refs/heads/own {z}\n")
+    check("⑤反面:新分支自己帶進來的轉正照擋(不是一律放行)", rc == 1 and f"--diff {m1}..{own}" in dl, f"rc={rc} {dl} {out[-500:]}")
+    rc, dl, out = hook(f"refs/tags/v-own {own} refs/tags/v-own {z}\n")
+    check("⑤tag 也查:tag 指到的提交帶進來的轉正照擋", rc == 1 and f"--diff {m1}..{own}" in dl, f"rc={rc} {dl} {out[-500:]}")
+    # 主分支沒設 upstream
+    g("branch", "--unset-upstream", "main")
+    check("⑥前置:沒設 upstream 時,新分支的原樣範圍直接交給 lumos 會擋(它退回從空樹算)", direct(f"{z}..{nb}") == 1, "")
+    rc, dl, out = hook(f"refs/heads/newb {nb} refs/heads/newb {z}\n")
+    check("⑥沒設 upstream:改用這次推送的遠端的預設分支(origin/HEAD),不擋", rc == 0 and f"--diff {m1}..{nb}" in dl,
+          f"rc={rc} {dl} {out[-500:]}")
+    g("symbolic-ref", "-d", "refs/remotes/origin/HEAD")
+    rc, dl, out = hook(f"refs/heads/newb {nb} refs/heads/newb {z}\n")
+    check("⑥遠端也沒有 HEAD:改用 origin/main,不擋", rc == 0 and f"--diff {m1}..{nb}" in dl, f"rc={rc} {dl} {out[-500:]}")
+    rc, dl, out = hook(f"refs/heads/newb {nb} refs/heads/newb {z}\n", args=())
+    check("⑦主線都找不到(沒給遠端名):原樣交給 lumos 自己判,並印一行說明", f"--diff {z}..{nb}" in dl and "找不到主線" in out,
+          f"rc={rc} {dl} {out[-500:]}")
 
 
 def t_drift_unknown_blocks_check_not_scan():
     """[S2] check 判不了(git 算不出範圍事件)→ 算要處理、印原因(block 模式 rc1)。
 
     乙那一半:條件指到的程式檔讀不出來 → check 擋、scan 列判不了且不寫帳。
 
     翻紅釘:判不了改成放行 → ①②紅;scan 把判不了當不成立 → ③紅。
     """
     print("t_drift_unknown_blocks_check_not_scan")
diff --git a/skills/lumos-project-notes/commands/08-自動跑的.md b/skills/lumos-project-notes/commands/08-自動跑的.md
index 0f182172..a5d3f8c8 100644
--- a/skills/lumos-project-notes/commands/08-自動跑的.md
+++ b/skills/lumos-project-notes/commands/08-自動跑的.md
@@ -1,15 +1,15 @@
 # 08 自動跑的(hook 會替你呼叫,不用手敲;但要看得懂它印什麼)
 
 | 時機 | 自動跑什麼 | 擋不擋 |
 |---|---|---|
 | `git commit` 前(pre-commit) | 污染檢查、`lumos lint` 逐篇、`lumos home check --staged`(每支檔有家;「該動哪篇」的點名也在這裡照家算)、`lumos note-shape --staged`(筆記形狀擋)、「改 code 沒動圖譜」檢查、`lumos cochange check`、`lumos delguard` | 前四項擋;後兩項提醒 |
 | `git commit` 後(post-commit) | 記 bypass 帳(用 --no-verify 繞過也會留痕) | 不擋 |
-| `git push` 前(pre-push) | `lumos anchor verify`、全套測試、`lumos home check --diff`(每支檔有家,這次要推的範圍整段查一次)、`lumos note-shape --diff`(筆記形狀擋,同一段範圍)、`lumos code-loop check`(每個分支 ref 無條件叫;合約測試紅 / 效能檢核題沒表態 / 高風險沒審查留痕,三個判定各自擋)、`lumos doctor --ci` | 全擋 |
+| `git push` 前(pre-push) | `lumos anchor verify`、全套測試、`lumos home check --diff`(每支檔有家,這次要推的範圍整段查一次)、`lumos note-shape --diff`(筆記形狀擋,同一段範圍)、`lumos code-loop check`(每個分支 ref 無條件叫;合約測試紅 / 效能檢核題沒表態 / 高風險沒審查留痕,三個判定各自擋)、`lumos drift check --diff`(存量漂移檢查,分支與 tag 都查;起點是跟主線的分岔點與遠端舊值裡比較新的)、`lumos doctor --ci` | 全擋;★drift check 例外★:預設 warn 只印,`.lumos/config.json` 的 `drift_check.gate` 設 block 才擋,工具沒跑成(錯誤、git 太慢)講一句就放行 |
 | `git push` 前(pre-push,低風險那一路) | 同一次 `code-loop check` 帶 `--bound-tests-advisory`:這次改動碰到的硬合約綁的測試紅了只印 | ★合約測試只提醒不擋★(人裁 2026-09-07);表態閘照擋(不看 tier,2026-09-09) |
-| CI(push 後) | 同 pre-push + `lumos code-loop check`(補查 --no-verify 繞過的) | 紅燈 |
+| CI(push 後) | 同 pre-push + `lumos code-loop check`、`lumos drift check`(補查 --no-verify 繞過的;drift 的 before 是全 0 或找不到時從頂端的父提交算) | 紅燈(drift check 預設 warn 不紅;工具出錯照紅) |
 | Claude 要 Edit/Write 前(impact hook) | `lumos impact --file <檔>` 的結果注入 | 只提醒;邊界仍要自己查 |
 | 回合結束(check-graph-sync,Stop hook) | 提醒「改了 code 還沒動圖譜」 | 兩家同 session 擋一次續做(`LUMOS_STOP_BLOCK_OFF=1` 關;2026-09-05 起 Claude 也擋) |
 | 每天 09:30(autonomous-loop) | 自動選題 → 設計審查 → 備 pending 等人放行 | — |
 | 每天 09:30(launchd daily-governance) | 治理日報、lint-watch 版本掃、doctor --ci、testmap 重建、每週回放與探針抽查;★自主迭代 loop 的派工 2026-09-05 起暫停(LUMOS_AUTOLOOP_OFF 預設 1)★ | 全 fail-open;腳本已包成 main() 免邊跑邊改讀到半行 |
 
 看到「擋下:」就是上面某一道擋了,訊息第一句講發生什麼、最後一行給該敲的指令。
