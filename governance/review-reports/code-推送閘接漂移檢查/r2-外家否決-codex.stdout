 28473	def _drift_exam_probe(root, vault_rel, q, probes):
 28474	    """probe 題(乙):把那篇筆記的那一行在起點與終點兩版都換成改寫檔給的條件式,對 event_commit 跑 check,
 28475	    那一行在「要處理」算擋到。不改被考 repo(只在記憶體裡換)。"""
 28476	    pb = (probes or {}).get(q.get("id"))
 28477	    if not pb:
 28478	        return "略過:改寫檔沒有這一題", 0, 0, 0
 28479	    c = _lens_full_sha(root, pb.get("event_commit") or "")
 28480	    par = _lens_full_sha(root, f"{pb.get('event_commit')}^") if c else None
 28481	    if c is None or par is None:
 28482	        return "略過:找不到 event_commit 或它的上一版", 0, 0, 0
 28483	    vr = _drift_vault_rel(root, c) or vault_rel
 28484	    note = q.get("note_at_event") or q.get("note")
 28485	    orig, new = str(q.get("text", "")).strip(), str(pb.get("rewrite", "")).strip()

