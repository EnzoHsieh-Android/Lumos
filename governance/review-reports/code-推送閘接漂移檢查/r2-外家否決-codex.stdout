diff --git a/scripts/hooks/pre-push b/scripts/hooks/pre-push
index ddff1143..5de281e8 100755
--- a/scripts/hooks/pre-push
+++ b/scripts/hooks/pre-push
@@ -37,20 +37,63 @@ _EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"
 # 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
 # (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
 pp_range_for() {
   if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
     printf '%s..%s' "$_EMPTY_TREE" "$2"
   else
     printf '%s..%s' "$1" "$2"
   fi
 }
 
+# 存量漂移檢查的範圍(代碼審 r1 正確性席 F1、F2;併發回滾席 F1)。$1=remote_sha $2=local_sha → 設 _DR_RANGE 與 _DR_NOTE。
+# ★起點取「遠端舊值」與「本地新值跟主線的分岔點」裡比較新的★:
+#   - 分岔點是遠端舊值的祖先(或同一個)→ 遠端舊值較新,用它(一般的增量推送,只看這次新加的);
+#   - 遠端舊值是全 0(新分支)、本機找不到、或兩者分岔(功能分支合過主線、重定基底後 force push)→ 用分岔點。
+#     分岔那種情況若用遠端舊值,`git log 舊..新` 會把合進來的主線提交(別人的轉正)算成這次帶進來的而誤報或誤擋;
+#     用分岔點頂多把自己上次已推過的提交再看一次(那是自己的東西)。
+# ★為什麼掛鉤自己算、不原樣交給 lumos★:lumos 的共用起點判法只在遠端舊值是全 0 或找不到時才算分岔點,
+#   而且主線只認 main/master 的 upstream——沒設 upstream 就退回從空樹算、截到上線點,把上線後主線的舊帳全算進新分支。
+# 主線依序找:main@{upstream} → master@{upstream} → 這次推送的遠端的預設分支(refs/remotes/<遠端>/HEAD)→ <遠端>/main
+#   → <遠端>/master(遠端名是 git 傳給掛鉤的第一個參數);都找不到才原樣交給 lumos 自己判,並講一聲。
+_PP_REMOTE="${1:-}"
+pp_mainline() {   # 印主線頂端的提交編號;找不到什麼都不印
+  local _c _cands=("main@{upstream}" "master@{upstream}")
+  if [[ -n "$_PP_REMOTE" ]]; then
+    _cands+=("refs/remotes/$_PP_REMOTE/HEAD" "refs/remotes/$_PP_REMOTE/main" "refs/remotes/$_PP_REMOTE/master")
+  fi
+  for _c in "${_cands[@]}"; do
+    git rev-parse -q --verify "$_c^{commit}" 2>/dev/null && return 0
+  done
+  return 0
+}
+pp_drift_range() {
+  local _ml _mb
+  _DR_NOTE=""
+  _DR_RANGE="$1..$2"
+  _ml="$(pp_mainline)"
+  if [[ -z "$_ml" ]]; then
+    _DR_NOTE="找不到主線(main/master 沒設 upstream,遠端 ${_PP_REMOTE:-(不明)} 也沒有 HEAD/main/master),起點交給 lumos 自己判;新分支可能把主線上別人的改動算進來"
+    return 0
+  fi
+  _mb="$(git merge-base "$2" "$_ml" 2>/dev/null | head -1)"
+  if [[ -z "$_mb" ]]; then
+    _DR_NOTE="要推的提交跟主線沒有共同祖先,起點交給 lumos 自己判"
+    return 0
+  fi
+  if [[ "$1" != "$_ZERO" ]] && git cat-file -e "$1^{commit}" 2>/dev/null \
+     && git merge-base --is-ancestor "$_mb" "$1" 2>/dev/null; then
+    _DR_RANGE="$1..$2"
+  else
+    _DR_RANGE="$_mb..$2"
+  fi
+}
+
 # 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
 # ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
 # 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
 pp_touched_file() {
   local _f _r
   [[ -n "$_EMPTY_TREE" ]] || return 0
   # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
   # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
   # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
   [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
@@ -256,20 +299,22 @@ if [[ -f "$REPO_ROOT/$_BASELINE" ]] && ! git -C "$REPO_ROOT" diff --quiet -- "$_
     echo ""
   } >&2
   exit 1
 fi
 
 # ══ 閘的順序(2026-09-06 全 repo 審視 #12 重排)══
 # 便宜的先跑、貴的最後。實測:除了全套測試以外,所有閘加起來約 13 秒
 # (anchor 0.22s / 簽名檔 0.04s / doctor 1.1s / pitfalls 0.23s / code-loop 0.61s
 #  / test-layers 0.21s / 自主迴圈那支 10.3s),而全套是 8 分鐘。
 # ★原本全套排在第四位★,所以被那 13 秒裡任何一道擋下時,8 分鐘已經白燒完了。
+# (2026-09-30 加了存量漂移檢查,排在 code-loop 之後:小專案每個 ref 約 1 秒;最壞每個 ref 判定本體 60 秒的預算,
+#  預算之前算範圍的 git 呼叫另計(每次最多 20 秒逾時),一次推多個 ref 會相加——所以上面那個 13 秒不再是上限。)
 
 # 圖譜健康(只在 vault 存在時跑)
 # ★2026-09-06 重排:原本這段在最後面,而且「沒有 vault 就 exit 0」會直接結束整支 hook。
 #   現在它排在全套測試之前,那個 exit 0 會把後面的測試閘一起跳掉——所以改成只跳過這一段。
 have_vault=0
 for d in docs/*-knowledge docs/knowledge; do
   [[ -d "$d" ]] && have_vault=1 && break
 done
 _TOUCHED_F="$(pp_touched_file)"
 _DOCTOR_ARGS=(doctor --ci)
@@ -440,36 +485,45 @@ for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
         echo ""
       } >&2 || true
     fi
     bound_tests_advisory "$_range"
   fi
   # 存量漂移檢查(Projects/存量漂移防線_計劃〈做法〉第 4 節第 4 點、[S1][S18]):已經寫進圖譜的句子因為這次推送改了狀態而過期
   # (轉正了還留著預告句、計劃收尾了連著的 Issue 還開著…)。排在 code-loop check 之後、全套測試之前:code-loop 約 0.6 秒、
   # 這道最壞 60 秒、全套 8 分鐘,便宜的先跑。分支與 tag 都查(不像 code-loop 要分支名)。
   # 上線標記:下一行那串是 lumos 找「這道檢查從哪個提交起上線」用的(範圍起點截到那裡,上線前的是舊帳),別改寫也別刪:
 # lumos drift check
-  # ★範圍交原樣的 remote_sha..local_sha,不用上面的 _range★:新分支(40 個 0)或本機找不到起點時 _range 換成空樹,
-  # lumos 把明寫的空樹當「從空樹比、截到上線點」,新分支會把主線上線後別人的轉正算成這次帶進來的而誤擋;原樣交過去,
-  # lumos 用共用的推送起點判法(跟主線的分岔點;頂端已在主線就不查)——CI 那步也是原樣交。頂端就是要推的 local_sha。
+  # 範圍起點由 pp_drift_range 算(見那支函式):跟主線的分岔點與遠端舊值取比較新的;不用上面的 _range(空樹兜底)。
   # 模式由 lumos 讀被推送頂端提交的 .lumos/config.json(drift_check.gate,沒寫=warn):block 有要處理 rc1 → 擋;warn 只印 rc0;
   # off 它自己跳過。LUMOS_SKIP_DRIFT_CHECK=1 單次略過、淺層 clone 跳過,都由 lumos 記帳。每一筆的 lumos drift fix 修法由它印。
-  # rc 不是 0 也不是 1(參數錯)→ 放行,跟上面每支檔有家、筆記形狀擋同一種處理。
+  # 回傳碼:1 → 擋;128 以上(被訊號殺掉,多半是 Ctrl-C)→ 整支掛鉤停下、不放行、不往下跑全套;
+  # 其他非零(工具錯誤、git 太慢逾時、舊版工具沒有 drift 子命令)→ 講一句「這次沒檢查」再放行,
+  # 跟每支檔有家、筆記形狀擋的「只認 rc1 擋」同一種處理(代碼審 r1 併發回滾席)。
+  pp_drift_range "$_rsha" "$_lsha"
+  [[ -n "$_DR_NOTE" ]] && echo "提醒(存量漂移檢查):$_DR_NOTE" >&2
   dr_rc=0
-  "$PY" "$GRAPHCTL" drift check --diff "$_rsha..$_lsha" --repo "$REPO_ROOT" || dr_rc=$?
+  "$PY" "$GRAPHCTL" drift check --diff "$_DR_RANGE" --repo "$REPO_ROOT" || dr_rc=$?
+  if [[ "$dr_rc" -ge 128 ]]; then
+    echo "存量漂移檢查被中斷(rc=$dr_rc),推送停下,後面的檢查不跑。" >&2
+    exit "$dr_rc"
+  fi
   if [[ "$dr_rc" -eq 1 ]]; then
     {
       echo ""
       echo "逃生:照上面每一筆的 lumos drift fix 指令改掉、或 lumos drift ack 表態照留(兩種都要提交進去才算),再推;誤擋就 LUMOS_SKIP_DRIFT_CHECK=1 git push 單次略過(會留帳);整個專案先只提醒 → .lumos/config.json 的 drift_check.gate 設成 warn。"
       echo ""
     } >&2
     exit 1
   fi
+  if [[ "$dr_rc" -ne 0 ]]; then
+    echo "漂移檢查沒能跑完(工具錯誤或 git 太慢),這次沒檢查;CI 會再檢查一次。(上面如果印了「擋下:」,指的是這道檢查自己沒跑成,推送沒有被擋。)" >&2
+  fi
   # ★合約測試閘:低風險這一路也要跑★(2026-09-07 全 repo 審視 #17,人裁)
   # 舊行為:這件事藏在 code-loop check 裡,而那支只在 tier=high 且推的是分支時才跑
   # ——所以「改到硬合約就跑那些合約綁的測試」這句話,在低風險推送上是假的,
   # 而改一行低風險的碼一樣可以打破合約。
   # 高風險那條路已經在上面的 code-loop check 裡跑過(它會擋),這裡只補低風險那半。
   # (表態閘 2026-09-09 起)分支 ref 的低風險推送:合約測試已在上面的 code-loop check 裡以 advisory 跑過一次,這裡不再跑第二次;
   # tag 走上面 else 分支的 bound_tests_advisory。
   # test-layers 軟提醒(advisory,恆不影響 rc;無 .lumos/test-layers.json 靜默)
   "$PY" "$GRAPHCTL" test-layers --diff "$_range" --repo "$REPO_ROOT" 2>/dev/null || true
   impact_done
