-  if [[ -s "$_f" || ( "$_n" -gt 0 && "$_ok" -eq 1 ) ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
+  if [[ "$_ok" -eq 1 && ( -s "$_f" || "$_n" -gt 0 ) ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
 }
 
