+def t_prepush_docs_and_light_run_subset():
+    """推送前掛鉤真跑:純文件推送只叫執行器跑 --suite docs(分片照切);改到程式但 push-check 判 light 的,跑文件子集 + --suite keys;
+    keys 一支都沒對到(rc3)不擋、講明 CI 會跑全套;一般程式改動照跑全套(不帶 --suite)。執行器換成把參數記到檔裡的假貨。"""
+    import subprocess as _sp, os as _os
+    hook = str(Path(__file__).resolve().parent / "hooks" / "pre-push")
+    lumos_real = str(Path(__file__).resolve().parent / "lumos")
