+def t_generalist_lens_native_review_method():
+    """[原生代碼審當通才席 S1、S2]高風險代碼審的鏡頭5 通才照 Claude Code /code-review 的八角度審法:編制備註指到範本 §7.9,
+    範本那段八個角度都在、而且沿用 §3 的引句與嚴重度規則(不另立一套)。"""
+    m = _load_lumos_module()
