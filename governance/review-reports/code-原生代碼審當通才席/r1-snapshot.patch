+    check("鏡頭5 還在、算人數、同門", len(s5) == 1 and s5[0]["occupies_w"] is True and s5[0]["family"] == "claude", s5)
+    check("鏡頭5 備註指到八角度審法(範本 §7.9)", "/code-review 八角度" in s5[0].get("note", "") and "§7.9" in s5[0].get("note", ""), s5)
+    tpl = (Path(GRAPHCTL).resolve().parent.parent / "skills" / "lumos-design-loop" / "templates.md").read_text(encoding="utf-8")
+    sec = tpl.split("## 7.9 ", 1)[1].split("\n## ", 1)[0] if "## 7.9 " in tpl else ""
+    check("★前置★ 範本有 §7.9 那一節", bool(sec), "")
+    angles = ("逐行", "被刪掉的行為", "跨檔追蹤", "重用", "簡化", "效率", "修的深度", "慣例")
+    check("§7.9 八個角度都在", all(f"{i}. {a}" in sec for i, a in enumerate(angles, 1)), [a for i, a in enumerate(angles, 1) if f"{i}. {a}" not in sec])
+    check("§7.9 嚴重度與翻紅重現照 §3(不另立一套規則)", "照 §3" in sec and "blocker" not in sec.split("```", 2)[1] if sec.count("```") >= 2 else False, sec[:300])
+    check("範本目錄列了 §7.9", "§7.9 通才鏡頭" in tpl.split("---", 1)[0], "")
+    print("  ✓ t_generalist_lens_native_review_method")
