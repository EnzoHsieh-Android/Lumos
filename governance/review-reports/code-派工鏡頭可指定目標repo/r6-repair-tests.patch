+def _lr5_frames(t, m):
+    """t 裡每一個收了尾的注入框 (開頭位置, 結尾位置);沒收尾的不算框。"""
+    out, i = [], 0
+    while True:
+        a = t.find(m._FRAME_OPEN, i)
+        b = t.find(m._FRAME_CLOSE, a) if a >= 0 else -1
+        if a < 0 or b < 0:
+            return out
+        out.append((a, b))
+        i = b + 1
+
+
+def _lr5_sentinel_problems(t, tokens, m):
+    """每個哨兵都要出現;每一次出現都要在某個注入框裡、而且整個哨兵落在同一對單角引號之間(中間不換行、不跨別的標記)。回問題清單。"""
+    import re as _re
+    spans = [(x.start(), x.end()) for x in _re.finditer(r"\u2039[^\u2039\u203a\n]*\u203a", t)]
+    frames, probs = _lr5_frames(t, m), []
+    for tok in tokens:
+        hits = [x.start() for x in _re.finditer(_re.escape(tok), t)]
+        if not hits:
+            probs.append(f"{tok} 沒出現")
+        for h in hits:
+            ctx = t[max(0, h - 50):h + 70].replace("\n", "⏎")
+            if not any(a < h < b for a, b in frames):
+                probs.append(f"{tok} 在框外:{ctx}")
+            if not any(a < h and h + len(tok) < b for a, b in spans):
+                probs.append(f"{tok} 沒包在 \u2039 \u203a 裡:{ctx}")
+    return probs
+
