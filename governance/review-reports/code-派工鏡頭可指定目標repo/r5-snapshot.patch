+_LR2_FREEZE_KEY = "設計審派工前先 spec-freeze;席位材料、rN-snapshot、--reviewed 都用它產生的那份;派工單記 spec_commit"
+_LR2_FREEZE_OLD = ("指向工作副本", "sha256sum <計劃", "/tmp/<id>-rN.md", "/tmp/<編號>-rN.md", "refcheck <副本>")
