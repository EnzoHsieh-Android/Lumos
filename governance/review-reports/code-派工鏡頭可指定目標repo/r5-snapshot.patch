+def _lr2_design_loop_manual_problems(texts):
+    """五份手冊(檔名 → 內容)各自缺那句關鍵說法、還留著舊說法、或別的工作樹那一步帶了 --out 的,回問題清單。"""
+    probs = []
+    for name, t in texts.items():
+        if _LR2_FREEZE_KEY not in t:
+            probs.append(f"{name} 缺「{_LR2_FREEZE_KEY}」")
