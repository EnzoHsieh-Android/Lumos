+def _spec_commit_cands_norm(paths):
+    """_spec_commit_present 要問的候選:NFC、去重、照順序,含換行、NUL、. .. 空段或絕對路徑的不問;最多 _LENS_SPEC_COMMIT_CANDS_MAX 個。
+    回 (dict:候選 → False, 有沒有超過上限)。"""
+    import unicodedata as _ud
+    q, capped = {}, False
+    for x in paths:
+        k = _ud.normalize("NFC", str(x))
+        if k in q or not k or "\n" in k or "\0" in k or k.startswith("/") or any(sg in ("", ".", "..") for sg in k.split("/")):
             continue
+        if len(q) >= _LENS_SPEC_COMMIT_CANDS_MAX:
+            capped = True
+            break
+        q[k] = False
+    return q, capped
