+    def g(*a):
+        r = _lens_git(root, *_SPEC_FREEZE_GIT_C, *a, env=env, quote=True)
+        return r.stdout.strip() if r is not None and r.returncode == 0 else None
+    try:
+        if g("read-tree", "HEAD") is None:
+            return None
+        blob = g("hash-object", "-w", "--no-filters", "--", rel)
+        if not blob or g("update-index", "--add", "--cacheinfo", f"{mode},{blob},{rel}") is None:
+            return None
+        tree = g("write-tree")
