+def _spec_commit_present(root, commit, paths, deadline):
+    """提交寫法:候選路徑裡哪些在提交裡是一般檔(100644/100755 的 blob)。回 (結果, 有沒有超過候選上限)。
+    結果是 dict:問到的候選(NFC)→ 提交裡是不是一般檔;沒問到的(超過上限)不在裡面,呼叫端當「沒算到」、不當成找不到。
+    結果是 None:時間不到 1 秒、git 失敗或逾時(呼叫端當「算到一半」)。
+    只查候選、不列整棵樹(代碼審 code-派工鏡頭可指定目標repo r2 併發2:原本 `ls-tree -r` 列整個目錄,成本隨 repo 檔數長):
+    ①候選一律交給既有的批次查大小 _nodehome_cat_sizes(`<提交>:<路徑>` 一行一個;r3 架構1:原本另寫一套 cat-file 呼叫與解析),
+    有大小=提交裡有這個物件;②這些再用 `ls-tree`(只帶它們當路徑)看 mode——cat-file 分不出符號連結(120000 也是 blob)、目錄也有大小,
+    本機 git 2.39 也沒有 %(objectmode)。
+    每個候選的 NFC 與 NFD 兩種寫法都問(r3 正確性1:提交本身存 NFD 時只問 NFC 查不到),ls-tree 關掉 core.precomposeunicode
+    (macOS 會把路徑參數轉成 NFC);結果的鍵一律 NFC。候選上限 _LENS_SPEC_COMMIT_CANDS_MAX(r3 併發1:原本沒上限,10 萬個候選撞 20 秒逾時,
+    整段固定席資訊消失)。含換行、NUL、. .. 空段或絕對路徑的候選不問、當沒有。"""
+    import time as _time
+    import unicodedata as _ud
+    q, capped = _spec_commit_cands_norm(paths)
+    if not q:
+        return q, capped
+    rem = deadline - _time.monotonic()
+    if rem < 1:
+        return None, capped
+    asks = [f for k in q for f in dict.fromkeys((k, _ud.normalize("NFD", k)))]
+    sizes = _nodehome_cat_sizes(root, [f"{commit}:{f}" for f in asks], timeout=min(20.0, rem))
+    if sizes is None:
+        return None, capped
+    hits = [f for f, n in zip(asks, sizes) if n is not None]
+    for i in range(0, len(hits), 200):   # 一批最多 200 個路徑參數,不碰命令列長度上限
+        rem = deadline - _time.monotonic()
+        if rem < 1:
+            return None, capped
+        r2 = _lens_git(root, "-c", "core.precomposeunicode=false", "--literal-pathspecs", "ls-tree", "-z", "--full-tree", commit, "--",
+                       *hits[i:i + 200], quote=True, timeout=min(20.0, rem))
+        if r2 is None or r2.returncode != 0:
+            return None, capped
+        for rec in r2.stdout.split("\0"):
+            meta, tab, path = rec.partition("\t")
+            parts = meta.split()
+            k = _ud.normalize("NFC", path)
+            if tab and k in q and len(parts) == 3 and parts[1] == "blob" and parts[0] in ("100644", "100755"):
+                q[k] = True
+    return q, capped
