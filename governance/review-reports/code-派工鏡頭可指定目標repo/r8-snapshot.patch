+def _lens_spec_cap_lines(lines, cap=None):
+    """附加段總字數超過 _LENS_SPEC_TEXT_MAX 時在行界截斷(單行比上限長就截那一行),最後一行講明截了、原本多少字;沒超過原樣回。"""
+    cap = _LENS_SPEC_TEXT_MAX if cap is None else cap
+    total = len("\n".join(lines))
+    if total <= cap:
+        return lines
+    note = f"(已截:附加段超過 {cap} 字,原本 {total} 字,後面的沒附)"
+    room, out, used = cap - len(note) - 1, [], 0
+    for ln in lines:
+        add = len(ln) + (1 if out else 0)
+        if used + add > room:
+            if not out:
+                out.append(ln[:room])
+            break
+        out.append(ln)
+        used += add
+    return [*out, note]
