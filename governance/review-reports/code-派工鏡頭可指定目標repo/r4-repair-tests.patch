+# 舊的單步寫法:在計劃所在的工作樹一次帶 --out 寫快照(代碼審 r3 合約3:改回這種寫法時原本的守衛照綠)
+_LR3_FREEZE_OLD_STEP_PAT = r"spec-freeze <計劃[^>`]*> --out <(?:rN-snapshot\.md|快照)>"
