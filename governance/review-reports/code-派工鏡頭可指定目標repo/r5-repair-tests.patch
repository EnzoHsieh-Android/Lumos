+def _lr4_hook_what_ok(e, assigned):
+    """掛鉤說明行的 what= 合不合格:_spec_what/_range_what 的呼叫、兩者的條件式,或每次指定都是這兩種的變數。"""
+    import ast
+    if isinstance(e, ast.Call) and isinstance(e.func, ast.Name) and e.func.id in ("_spec_what", "_range_what"):
+        return True
+    if isinstance(e, ast.IfExp):
+        return _lr4_hook_what_ok(e.body, assigned) and _lr4_hook_what_ok(e.orelse, assigned)
+    return isinstance(e, ast.Name) and bool(assigned.get(e.id)) and all(_lr4_hook_what_ok(v, assigned) for v in assigned[e.id])
+
+
+def _lr4_hook_what_problems(src):
+    """掛鉤每個 `.format(..., what=…)` 都要過 _spec_what / _range_what;回問題清單。"""
+    import ast
+    out = []
+    for fn in [n for n in ast.walk(ast.parse(src)) if isinstance(n, ast.FunctionDef)]:
+        assigned = {}
+        for n in ast.walk(fn):
+            if isinstance(n, ast.Assign):
+                for tg in [x for x in n.targets if isinstance(x, ast.Name)]:
+                    assigned.setdefault(tg.id, []).append(n.value)
+        calls = [n for n in ast.walk(fn) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == "format"]
+        out += [f"{fn.name}:{c.lineno} what= 沒過 _spec_what/_range_what" for c in calls for k in c.keywords
+                if k.arg == "what" and not _lr4_hook_what_ok(k.value, assigned)]
+    return out
+
+
