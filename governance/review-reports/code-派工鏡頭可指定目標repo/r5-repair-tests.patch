+    for old, new in (("what=_spec_what(spec)", "what=_clean_field(spec)"),
+                     ("what = _range_what(rng) if rng else _spec_what(spec)", "what = rng or spec")):
+        check(f"前置:變異點在原始碼裡({old})", old in src, "")
+        check(f"守衛抓得到:{old} 改成 {new}", bool(_lr4_hook_what_problems(src.replace(old, new, 1))), "")
+
