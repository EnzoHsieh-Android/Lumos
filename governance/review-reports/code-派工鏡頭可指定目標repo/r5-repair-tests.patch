+_LR4_EXIT = ("_lens_author_name_show", "_lens_author_names_show", "_lens_spec_names_line")   # 後兩支是包裝,本體要呼叫前面的出口
+
+
+def _lr4_exit_call(e, extra):
+    import ast
+    return isinstance(e, ast.Call) and isinstance(e.func, ast.Name) and e.func.id in _LR4_EXIT + extra
+
+
+def _lr4_maps_exit(e, extra):
+    """e 是出口呼叫,或「每一項都是出口呼叫」的串列、產生器、字典生成式。"""
+    import ast
+    if isinstance(e, (ast.ListComp, ast.GeneratorExp)):
+        return _lr4_exit_call(e.elt, extra)
+    if isinstance(e, ast.DictComp):
+        return _lr4_maps_exit(e.value, extra)
+    return _lr4_exit_call(e, extra)
+
+
+def _lr4_clean_names(fn, extra):
+    """函式裡從出口指定來的變數名(含拆包)。"""
+    import ast
+    clean = set()
+    for n in ast.walk(fn):
+        if isinstance(n, ast.Assign) and _lr4_maps_exit(n.value, extra):
+            for tg in n.targets:
+                clean |= {x.id for x in ast.walk(tg) if isinstance(x, ast.Name)}
+    return clean
+
+
+def _lr4_join_ok(e, ctx):
+    """`"…".join(x)`:x 本身合格,或是每一項都過出口的生成式。"""
+    import ast
+    return (isinstance(e.func, ast.Attribute) and e.func.attr == "join" and isinstance(e.func.value, ast.Constant)
+            and len(e.args) == 1 and (_lr4_expr_ok(e.args[0], ctx) or _lr4_maps_exit(e.args[0], ctx[1])))
+
+
+def _lr4_expr_ok(e, ctx):
+    """插值或串接的一段合不合格:常數、_LR4_SAFE_EXPRS、出口呼叫、從出口來的變數,或由這些組成的條件式、f-string、串接、join。
+    ctx = (函式名, 出口外加的名字, 從出口來的變數)。"""
+    import ast
+    fname, extra, clean = ctx
+    if isinstance(e, ast.Constant) or (fname, ast.unparse(e)) in _LR4_SAFE_EXPRS or _lr4_exit_call(e, extra):
+        return True
+    if isinstance(e, ast.Name):
+        return e.id in clean
+    if isinstance(e, ast.IfExp):
+        return _lr4_expr_ok(e.body, ctx) and _lr4_expr_ok(e.orelse, ctx)
+    if isinstance(e, ast.JoinedStr):
+        return all(_lr4_expr_ok(v.value, ctx) for v in e.values if isinstance(v, ast.FormattedValue))
+    if isinstance(e, ast.BinOp) and isinstance(e.op, ast.Add):
+        return _lr4_expr_ok(e.left, ctx) and _lr4_expr_ok(e.right, ctx)
+    return isinstance(e, ast.Call) and _lr4_join_ok(e, ctx)
+
+
+def _lr4_strish(e):
+    import ast
+    return isinstance(e, ast.JoinedStr) or (isinstance(e, ast.Constant) and isinstance(e.value, str))
+
+
+def _lr4_out_bad(n, ctx):
+    """n 若是組字串的節點(f-string、跟字串的 + 或 %、字串的 .format),回沒走出口的那幾段;不是回 None。"""
+    import ast
+    if isinstance(n, ast.JoinedStr):
+        return [] if _lr4_expr_ok(n, ctx) else [ast.unparse(n)[:80]]
+    if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Add) and (_lr4_strish(n.left) or _lr4_strish(n.right)):
+        return [] if _lr4_expr_ok(n, ctx) else [ast.unparse(n)[:80]]
+    if isinstance(n, ast.BinOp) and isinstance(n.op, ast.Mod) and _lr4_strish(n.left):
+        return [] if _lr4_expr_ok(n.right, ctx) else [ast.unparse(n.right)]
+    if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == "format" and _lr4_strish(n.func.value):
+        return [ast.unparse(a) for a in [*n.args, *(k.value for k in n.keywords)] if not _lr4_expr_ok(a, ctx)]
+    return None
+
+
+def _lr4_call_site_problems(fn, clean):
+    """兩個共用渲染器的呼叫:_lens_render_listed 要帶 show=<出口>、_arch_target_text 的檔案清單要從出口對應出來。"""
+    import ast
+    probs = []
+    for c in ast.walk(fn):
+        if not (isinstance(c, ast.Call) and isinstance(c.func, ast.Name)):
+            continue
+        if c.func.id == "_lens_render_listed":
+            sh = {k.arg: k.value for k in c.keywords}.get("show")
+            if not (isinstance(sh, ast.Lambda) and _lr4_exit_call(sh.body, ())) and not (isinstance(sh, ast.Name) and sh.id in clean):
+                probs.append(f"{fn.name}:{c.lineno} 呼叫 _lens_render_listed 沒帶 show=<出口>")
+        if c.func.id == "_arch_target_text":
+            tg = c.args[3] if len(c.args) > 3 else None
+            if tg is None or not (_lr4_maps_exit(tg, ()) or (isinstance(tg, ast.Name) and tg.id in clean)):
+                probs.append(f"{fn.name}:{c.lineno} 交給 _arch_target_text 的檔名沒走出口")
+    return probs
+
+
+def _lr4_fn_problems(fn):
+    """一支函式裡沒走出口的輸出點(出口呼叫自己的參數、_LR4_NOT_OUTPUT 列的整句不算)。"""
+    import ast
+    extra = ("show",) if fn.name == "_lens_render_listed" else ()
+    probs = []
+    if fn.name in _LR4_EXIT[1:] and not any(_lr4_exit_call(c, ()) for c in ast.walk(fn)):
+        probs.append(f"{fn.name} 是出口的包裝,本體卻沒呼叫出口")
+    exit_args = {id(a) for c in ast.walk(fn) if _lr4_exit_call(c, extra) for a in ast.walk(c) if a is not c}
+    clean = _lr4_clean_names(fn, extra)
+    ctx = (fn.name, extra, clean)
+    for n in ast.walk(fn):
+        bad = None if id(n) in exit_args else _lr4_out_bad(n, ctx)
+        if bad and (fn.name, ast.unparse(n)) not in _LR4_NOT_OUTPUT:
+            probs += [f"{fn.name}:{n.lineno} 沒走出口:{b}" for b in bad]
+    return probs + _lr4_call_site_problems(fn, clean)
+
