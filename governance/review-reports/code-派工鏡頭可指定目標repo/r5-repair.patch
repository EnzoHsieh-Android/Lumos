+def _lr4_exit_bypass_problems(src):
+    """scripts/lumos 設計審段落(`_LENS_SPEC_HEADER =` 到 `# lumos spec-freeze(` 之間的函式,加共用的 _lens_render_listed)裡,
+    每個 f-string 的插值、每個字串串接與 .format/% 的參數,都要是出口(_LR4_EXIT,或從出口指定來的變數)、常數,
+    或 _LR4_SAFE_EXPRS 列的非名字值;_LR4_NOT_OUTPUT 列的整句豁免;另查兩個共用渲染器的呼叫。回問題清單
+    (預設不准:新加的輸出點沒走出口就紅)。"""
+    import ast
+    lines = src.splitlines()
+    start = next(i for i, ln in enumerate(lines, 1) if ln.startswith("_LENS_SPEC_HEADER = "))
+    end = next(i for i, ln in enumerate(lines, 1) if ln.startswith("# lumos spec-freeze("))
+    funcs = [n for n in ast.parse(src).body
+             if isinstance(n, ast.FunctionDef) and (start <= n.lineno < end or n.name == "_lens_render_listed")]
+    if len(funcs) <= 10 or not any(f.name == "_lens_render_listed" for f in funcs):
+        return ["找不到要掃的函式(段落標記改了?)"]
+    return [p for fn in funcs for p in _lr4_fn_problems(fn)]
+
