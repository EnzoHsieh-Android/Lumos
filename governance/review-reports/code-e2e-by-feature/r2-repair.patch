+    feats = {"login": {"paths": ["app/src/main/A.kt"], "cases": cases or {"ok": {"flows": [".maestro/login.yaml"], "stability": ["player"]}}}}
+    e2e = {"stability": True, "stability_checks": ["exits"], "features": feats}
