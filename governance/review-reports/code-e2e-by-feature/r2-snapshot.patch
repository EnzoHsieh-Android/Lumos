+def _e2e_history_append(root, steps, runs, mode, blocked=None, run_dir=None):
+    """本機總表 .lumos/artifacts/android/history.jsonl 加一行(單源計劃〈檢測紀錄〉):整套或按功能、過或沒過、
+    判定擋下(blocked 是原因;runs 是 None 時 result 也是 None)都記。追加走本機帳共用的 _local_ledger_append,
+    上一次寫一半(帳尾沒換行)先補一個換行。寫不進去只提醒、不改判定結果(總表是方便查歷史,不是推送前檢查的依據)。"""
+    import json
+    steps = steps if isinstance(steps, dict) else {}
+    items = []
+    blocks = (runs or {}).get("blocks") or {}
+    for x in blocks.get("ui") if isinstance(blocks.get("ui"), list) else []:
+        items.append({"kind": "ui", "name": x["flow"], "result": x["result"]})
+    for k, key in (("visual", "screen"), ("stability", "check")):
+        if isinstance(blocks.get(k), list):
+            items += [{"kind": k, "name": x[key], "result": x["result"]} for x in blocks[k]]
+    sel = steps.get("selection") if isinstance(steps.get("selection"), dict) else {}
+    rid = steps.get("run_id") or (Path(run_dir).name if run_dir else None)
+    line = {"ts": steps.get("ended") or _e2e_now(), "run_id": rid, "head": steps.get("start_head"),
+            "dirty": steps.get("dirty"), "mode": sel.get("mode", "full") if mode == "partial" else "full",
+            "cases": sel.get("cases", []), "result": (runs or {}).get("result"), "items": items,
+            "perf": blocks.get("macrobench"), "notices": (runs or {}).get("notices", []),
+            "evidence": str(Path(".lumos") / "artifacts" / "android" / str(rid))}
+    if blocked:
+        line["blocked"] = blocked
+    p = Path(root) / ".lumos" / "artifacts" / "android" / "history.jsonl"
+    text = json.dumps(line, ensure_ascii=False) + "\n"
+    try:
+        p.parent.mkdir(parents=True, exist_ok=True)
+        ok = _local_ledger_append(p, ("\n" if _ledger_tail_needs_newline(p) else "") + text)
+    except OSError:
+        ok = False
+    if not ok:
+        print(f"提醒:檢測總表 {p} 寫不進去,這次的結果只在 {line['evidence']}", file=sys.stderr)
