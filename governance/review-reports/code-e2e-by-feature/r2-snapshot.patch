+def _e2e_evaluate_selected(e2e, steps, run_dir, sel):
+    """按挑法判:UI 與截圖只判挑到的 flow 與畫面;記憶體每個情境各判一次(steps 的 name 是情境名);效能照舊只提醒。"""
+    notices = []
+    sub = dict(e2e, flows=sel["flows"], visual=sel["visual"] or None, macrobench=bool(sel["macrobench"]), stability=False)
+    blocks = {"ui": _e2e_judge_ui(sub, steps), "visual": _e2e_judge_visual(sub, steps, run_dir) if sel["visual"] else "這次沒跑",
+              "stability": [], "macrobench": _e2e_judge_macrobench(sub, steps, notices) if sel["macrobench"] else "這次沒跑"}
+    blocks["stability"] = _e2e_stab_by_name(e2e, steps, sel["stability"], notices)
+    if not sel["stability"]:
+        blocks["stability"] = "這次沒跑"
+    if not sel["flows"]:
+        blocks["ui"] = "這次沒跑"
+    probs = _e2e_tool_problems(steps)
+    rs = [x["result"] for k in ("ui", "visual", "stability") if isinstance(blocks[k], list) for x in blocks[k]]
+    result = "fail" if "fail" in rs else ("unjudged" if probs or "unjudged" in rs else "pass")
+    return {"result": result, "problems": probs, "blocks": blocks, "notices": notices}
