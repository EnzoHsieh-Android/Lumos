+def _android_e2e_dispatch(args):
+    """lumos android-e2e 的子指令分派(judge、select、history)。"""
+    def split(xs):
+        return [y.strip() for x in xs for y in x.split(",") if y.strip()]
+    if args.e2ecmd == "select":
+        return _e2e_select_cmd(args.e2e_repo, split(args.e2e_features), split(args.e2e_cases), args.e2e_changed,
+                               args.e2e_no_perf, args.e2e_no_memory)
+    if args.e2ecmd == "history":
+        return _e2e_history_cmd(args.e2e_repo, args.e2e_feature, args.e2e_case, args.e2e_last)
+    return _e2e_judge_cmd(args.e2e_repo, args.e2e_run_dir, precheck_only=args.e2e_precheck, no_record=args.e2e_no_record,
+                          history=args.e2e_history)
