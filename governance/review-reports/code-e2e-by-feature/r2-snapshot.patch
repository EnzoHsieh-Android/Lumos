+def _e2e_history_cmd(root, feature=None, case=None, last=20):
+    """lumos android-e2e history:列本機總表,照功能、情境篩,新的在下面。逐行讀(_canary_ledger_rows,壞行跳過)、
+    只留最後 last 筆;last 要是正整數。"""
+    import collections
+    if not isinstance(last, int) or last < 1:
+        print(f"擋下:--last 要是正整數(拿到 {last!r})", file=sys.stderr)
+        return 2
+    p = Path(root).resolve() / ".lumos" / "artifacts" / "android" / "history.jsonl"
+    if not p.is_file():
+        print("還沒有檢測紀錄(範本腳本跑過一次就會有)")
+        return 0
+    rows = collections.deque(maxlen=last)
+    try:
+        for r in _canary_ledger_rows(p, errors="replace"):
+            cs = r.get("cases") if isinstance(r.get("cases"), list) else []
+            if case and case not in cs:
+                continue
+            if feature and not any(str(c).startswith(feature + ".") for c in cs):
+                continue
+            rows.append(r)
+    except OSError as e:
+        print(f"擋下:檢測總表讀不了:{e}", file=sys.stderr)
+        return 2
+    word = {"pass": "通過", "fail": "沒過", "unjudged": "沒判完", None: "沒寫判定"}
+    for r in rows:
+        what = "整套" if r.get("mode") == "full" else "、".join(str(c) for c in r.get("cases") or [])
+        bad = [f"{i.get('kind')} {i.get('name')}" for i in r.get("items") or [] if isinstance(i, dict) and i.get("result") != "pass"]
+        res = r.get("result")
+        print(f"{r.get('ts')}  {word.get(res, res) if isinstance(res, (str, type(None))) else res}  {what}  {str(r.get('head'))[:8]}"
+              f"{' (有沒提交的改動)' if r.get('dirty') else ''}"
+              + (f"  沒過或沒判完:{'、'.join(bad)}" if bad else "") + (f"  擋下:{r['blocked']}" if r.get("blocked") else "")
+              + f"  證據 {r.get('evidence')}")
+    if not rows:
+        print("沒有符合條件的檢測紀錄")
+    return 0
