+def _e2e_stab_by_name(e2e, steps, names, notices):
+    """記憶體每個情境各判一次:steps 裡 stability 與 stability_judge 的 name 是情境名(None=stability 段本身,check 不加前綴;
+    有名字的 check 寫成「情境:check」)。按功能跑與整套跑共用。"""
+    out = []
+    for name in names:
+        part = {"steps": [x for x in steps.get("steps", []) if x.get("block") not in ("stability", "stability_judge") or x.get("name") == name]}
+        for r in _e2e_judge_stability(dict(e2e, stability=True), part, notices):
+            if name is not None:
+                r["check"] = f"{name}:{r['check']}"
+            out.append(r)
+    return out
+
