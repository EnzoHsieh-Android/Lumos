+def _e2e_feature_record(root, steps, e2e, cases, runs):
+    """按功能跑寫進正式查證紀錄的 feature_runs(單源計劃〈按功能與使用情境跑〉):開跑時工作目錄乾淨(steps 的 dirty)、
+    現在也乾淨、HEAD 跟開跑時一樣才寫,紀錄照樣綁這一版的指紋;不然只記總表並說原因(開跑時有改動,建出來的 App 就不是這一版,
+    跑到一半收掉改動也一樣)。同一版已有完整、判完的結果時,不拿這次不完整或沒判完的蓋掉。寫不進去只提醒,不改這次的回傳碼。"""
+    import shlex
+    head = (_nodehome_git(root, "rev-parse", "HEAD") or b"").decode("utf-8", "replace").strip()
+    why = ("開跑時工作目錄有沒提交的改動(建出來的 App 不是這一版)" if steps.get("dirty") is not False else None) \
+        or _e2e_precheck(root) or (None if head and steps.get("start_head") == head else "開跑後 HEAD 換了")
+    full = e2e_h = None
+    if why is None:
+        full, why = _e2e_config_at(root, head)
+        e2e_h = (full or {}).get("e2e")
+        if why is None and e2e_h != e2e:
+            why = "工作目錄的 e2e 段跟 HEAD 提交的不一樣"
+    fp = None
+    if why is None:
+        fp, why = _e2e_fingerprint(root, head, e2e_h)
+    if why:
+        print(f"這次只記進本機檢測總表,沒寫查證紀錄:{why}")
+        return
+    ended = steps.get("ended") or _e2e_now()
+    kept = []
+
+    def _put(rec):
+        fr = rec.setdefault("feature_runs", {})
+        kept.clear()
+        for fc, v in cases.items():
+            old = fr.get(fc) or {}
+            if (old.get("commit") == head and old.get("complete") and old.get("result") in ("pass", "fail")
+                    and (not v["complete"] or v["result"] == "unjudged")):
+                kept.append(fc)
+                continue
+            fr[fc] = dict(v, run_id=steps.get("run_id"), ended=ended, commit=head)
+        rec["history"].append({"kind": "feature", "cases": list(cases), "result": runs["result"],
+                               "run_id": steps.get("run_id"), "ended": ended})
+    p, werr = _e2e_record_update(root, fp, _put)
+    if werr:
+        print(f"提醒:{werr}", file=sys.stderr)
+        return
+    rel = os.path.relpath(p, root)
+    got = "、".join(f"{k} {v['result']}" for k, v in cases.items() if k not in kept)
+    if kept:
+        print(f"這一版已有完整的結果,這次不完整或沒判完的沒蓋掉它:{'、'.join(kept)}")
+    print(f"按功能的結果寫進查證紀錄 {rel}(指紋 {fp[:12]}{(',' + got) if got else ''});"
+          f"推送前要提交它:git add {shlex.quote(rel)} && git commit -m \"chore: 記錄 Android 端到端驗收\"")
