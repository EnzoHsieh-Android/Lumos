+def _e2e_case_results(e2e, sel, runs):
+    """按功能跑的結果拆回每個情境 → {功能.情境: {result, items, complete, skipped[, reason]}}。效能照舊只提醒、不影響 result;
+    情境本來有效能或記憶體、這次用 --no-perf/--no-memory 略過了,complete 是 False;一個會判的項目都沒有時 result 是 unjudged、
+    complete 是 False(推送前檢查要不要認由下一批定)。"""
+    blocks, probs = runs["blocks"], runs["problems"]
+    ui = {_e2e_norm(x["flow"]): x["result"] for x in blocks["ui"]} if isinstance(blocks["ui"], list) else {}
+    vis = {x["screen"]: x["result"] for x in blocks["visual"]} if isinstance(blocks["visual"], list) else {}
+    stab = {}
+    for x in blocks["stability"] if isinstance(blocks["stability"], list) else []:
+        stab.setdefault(x["check"].split(":", 1)[0], []).append(x["result"])
+    out = {}
+    for fc in sel["cases"]:
+        fn, _, cn = fc.partition(".")
+        c = e2e["features"][fn]["cases"][cn]
+        items = ([("ui", f, ui.get(_e2e_norm(f), "unjudged")) for f in c.get("flows", [])]
+                 + [("visual", v, vis.get(v, "unjudged")) for v in c.get("visual", [])]
+                 + [("stability", n, r) for n in c.get("stability", []) if n in sel["stability"] for r in stab.get(n, ["unjudged"])])
+        rs = [r for _k, _n, r in items]
+        result = "fail" if "fail" in rs else ("unjudged" if probs or "unjudged" in rs or not rs else "pass")
+        skipped = [k for k in ("macrobench", "stability") if c.get(k) and k in (sel.get("skipped") or [])]
+        out[fc] = {"result": result, "complete": not skipped and bool(rs), "skipped": skipped,
+                   "items": [{"kind": k, "name": n, "result": r} for k, n, r in items]}
+        if not rs:   # 只列效能(只提醒)或該跑的都略過了:沒有會判過不過的項目,不能記成通過
+            out[fc]["reason"] = "這個情境這次沒有會判過不過的項目(效能只提醒)"
+    return out
