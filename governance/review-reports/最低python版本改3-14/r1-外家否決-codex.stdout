   106	          SHA: ${{ github.sha }}
   107	          BRANCH: ${{ github.ref_name }}
   108	        run: |
   109	          # 前一版原樣交給 lumos(40 個 0 或本機找不到時它自己判起點,跟 note-shape 那步同一支判法;找不到主線時代碼審這道照舊用空樹、不截上線點)
   110	          [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
   111	          echo "range: $BEFORE..$SHA branch=$BRANCH"
   112	          python scripts/lumos code-loop check --diff "$BEFORE..$SHA" --at-sha "$SHA" --branch "$BRANCH" --repo . || {
   113	            rc=$?
   114	            if [ "$rc" -eq 1 ]; then
   115	              echo "::error::code-loop check 擋下(原因在上面:合約測試紅 / 效能檢核題沒表態 / 高風險代碼無審查留痕)——本機 pre-push 被繞過(--no-verify)或留痕失效;照上面 check 印的指令補留痕(dispositions / pass|skip --note)後重推"
   116	              exit 1
   117	            fi
   118	            exit "$rc"
   119	          }
   120	      - name: note-shape gate (筆記形狀擋;--no-verify 後盾)
   121	        # 筆記新寫的程式行號引用、沒寫來源的 FACT/FLOW/DEP(Projects/筆記形狀擋_計劃)。note-shape 不重查「已經在主線上」
   122	        # 的提交,主線=本地 main 的 upstream;推 main 時 origin/main 就是這次的頂端,lumos 看到頂端已在主線裡就不拿它排除。
   123	        # 本 workflow 只在推 main 時跑這步;建本地 main 那行是給 PR / 其他分支觸發的專案照抄用的(doctor 給的也是這步)。
   124	        # 前一版原樣交給 lumos:40 個 0(新分支首推)或本機找不到(force-push 後的舊頂端)時,它自己判——頂端落後或等於主線頂端就不查,
   125	        # 其他從跟主線的分岔點算(2026-09-28 漏網 ESC-61fc2d87;繞過本機掛鉤又 force-push 改寫主線屬存心繞過,不在範圍)。
   126	        if: github.event_name == 'push'
