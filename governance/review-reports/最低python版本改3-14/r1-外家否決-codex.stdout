 17498	
 17499	def _skills_list():
 17500	    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
 17501	    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
 17502	    repo = Path(__file__).resolve().parent.parent
 17503	    d = repo / "skills"
 17504	    if not d.is_dir():
 17505	        return ()
 17506	    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))
 17507	
 17508	
 17509	_SKILLS = _skills_list()
 17510	
 17511	
 17512	def _link_or_copy(src: Path, dst: Path):
 17513	    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
 17514	    import os, shutil, subprocess
 17515	    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
 17516	    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
 17517	    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
 17518	    if dst.is_symlink():
 17519	        dst.unlink()                                  # Unix symlink
 17520	    elif dst.is_dir():
 17521	        try:
 17522	            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
 17523	        except OSError:
 17524	            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
 17525	    elif dst.exists():
 17526	        dst.unlink()
 17527	    dst.parent.mkdir(parents=True, exist_ok=True)
 17528	    try:
 17529	        if _IS_WIN:
 17530	            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
 17531	            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
 17532	            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
 17533	                               capture_output=True, text=True, encoding="utf-8", errors="replace")
 17534	            if r.returncode != 0:
 17535	                raise OSError(r.stderr)
 17536	        else:
 17537	            dst.symlink_to(src)
 17538	    except OSError:
 17539	        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8(專案宣告 ≥3.9)
 17540	        try:
 17541	            (dst / _SKILL_MARKER).write_text("lumos fallback copy;安裝器可整夾重建\n", encoding="utf-8")
 17542	        except OSError:
 17543	            pass
 17544	        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")
 17545	
 17546	
 17547	def _install_skills():
 17548	    # ★r1 正確性席:防線下移到真正動全域機器狀態的地方★——原本只擋四個指令入口,
 17549	    # 但 cmd_init → _vendor_toolchain → _install_hooks_py 這條路也會重連 ~/.claude/skills、繞過入口守衛。
 17550	    # 擋在這個變動原語,不論從哪個指令進來都擋得住。
 17551	    if _refuse_if_probe("install-skills"):
 17552	        return
 17553	    repo = Path(__file__).resolve().parent.parent
 17554	    dest = Path.home() / ".claude" / "skills"
 17555	    for s in _SKILLS:
 17556	        src = repo / "skills" / s
 17557	        if src.is_dir():
 17558	            _link_or_copy(src, dest / s)
 17559	            print(f"  ✓ skill {s}")
 17560	    # Codex 也讀同一個開放標準(agentskills.io):使用者層 ~/.agents/skills/(2026-09-04 隔離 HOME 實測會載入)。
 17561	    # ★開放共用目錄★:既有真目錄只有帶我方標記檔才重建,否則跳過+warn(別人的 skill 不能刪)。
 17562	    shared = Path.home() / ".agents" / "skills"
 17563	    for s in _SKILLS:
 17564	        src = repo / "skills" / s
 17565	        if src.is_dir():
 17566	            if _link_or_copy_shared(src, shared / s):
 17567	                print(f"  ✓ skill(codex) {s}")
 17568	
 17569	
 17570	def _link_or_copy_shared(src: Path, dst: Path) -> bool:
 17571	    """開放共用目錄版 _link_or_copy:dst 是「非我方」真目錄(不是 symlink/junction、沒有標記檔)→
 17572	    跳過+印一行,回 False;其餘交給 _link_or_copy(它會把 symlink/空夾/帶標記的複製物重建)。"""
 17573	    import os
 17574	    try:   # 我方裝的(symlink 或 Windows junction,realpath 都會解到 repo 的 skills/<名>)→ 直接重建,別當外方(r1 單reviewer F5)
 17575	        if dst.exists() and Path(os.path.realpath(dst)) == src.resolve():
 17576	            _link_or_copy(src, dst)
 17577	            return True
 17578	    except OSError:
 17579	        pass
 17580	    if dst.is_symlink():
 18035	    return _sync_global_hooks(src_repo, "claude") == "ok"
 18036	
 18037	
 18038	def _sync_global_hooks(src_repo: Path, harness: str) -> str:
 18039	    """全域 hooks/註冊同步(不需專案;install 與 _install_hooks_py 共用)。harness=claude|codex:
 18040	    claude → ~/.claude/hooks + settings.json;codex → ~/.codex/hooks + hooks.json(合併器 --target codex)。
 18041	    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)④codex 專用:寫自訂審查席 TOML(d6)。
 18042	    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);HOME 隔離可測。
 18043	    回三態字串:ok / probe(探針擋下,沒動) / merge-failed(hooks 設定檔壞或合併器非 0,hook 檔已 copy 但註冊沒更新)
 18044	    / absent(codex 專用:本機無 codex,跳過)。★不共用一顆布林★——False 曾被呼叫端寫死解讀成 LUMOS_PROBE,
 18045	    設定檔壞掉會印出誤導訊息(Projects/Codex完全支援_計劃 r2 邊界 N2)。"""
 18046	    # ★r1 正確性席:同 _install_skills——cmd_init/_vendor_toolchain 這條路會經此覆寫真的 ~/.claude/hooks
 18047	    # 與動 settings.json,繞過四個指令入口的守衛。擋在變動原語。
 18048	    if _refuse_if_probe(f"sync-global-{harness}"):
 18049	        return "probe"
 18050	    if harness == "codex":
 18051	        _ch = _codex_home()
 18052	        if _ch.exists() and not _ch.is_dir():   # r1 單reviewer F1:~/.codex 是檔案,mkdir 會炸穿整支 install
 18053	            return "home-not-dir"
 18054	        if not _codex_present():
 18055	            return "absent"
 18056	    import subprocess, shutil
 18057	    hdir, _ = _HARNESS_HOME[harness]
 18058	    chooks = (_codex_home() if harness == "codex" else Path.home() / hdir) / "hooks"
 18059	    chooks.mkdir(parents=True, exist_ok=True)
 18060	    src_dir = src_repo / "scripts" / "hooks" / "claude"
 18061	    for f in _GLOBAL_HOOKS:                   # ① 現役 hooks copy(兩家同一批檔)
 18062	        s = src_dir / f
 18063	        if s.exists():
 18064	            shutil.copy2(s, chooks / f)
 18065	    for f in _RETIRED_STUB_CLAUDE_HOOKS:      # ②a 相容期:換 exit 0 空殼,★不刪檔★
 18066	        stub = chooks / f                     #     (刪了會炸掉還帶著舊註冊的 session)
 18067	        if stub.is_symlink():
 18068	            stub.unlink()                     #     symlink 先拆,免得寫穿到來源檔
 18069	        stub.write_text(_RETIRED_HOOK_STUB_BODY, encoding="utf-8")
 18070	        stub.chmod(0o755)
 18071	    for f in _RETIRED_CLAUDE_HOOKS:           # ②b 過了相容期:真刪殘留檔
 18072	        stale = chooks / f
 18073	        if stale.exists() or stale.is_symlink():
 18074	            stale.unlink()
 18075	    merge = src_repo / "scripts" / "merge-claude-settings.py"  # ③ merge+prune 懸空(含②剛變懸空的)
 18076	    if merge.exists():
 18077	        args = [sys.executable, str(merge)] + (["--target", "codex"] if harness == "codex" else [])
 18078	        r = subprocess.run(args)
 18079	        if r.returncode != 0:              # 合併器只在設定檔 JSON 壞時回 1:別當成功
 18080	            return "merge-failed"
 18081	    if harness == "codex":                 # ④ 自訂審查席 TOML(d6)——刻意放在合併器之後:設定檔壞掉(merge-failed)就整個 Codex 側不算裝好,
 18082	                                           #    TOML 不寫、下次 install --force 再補;hook 檔 copy 在前面已做(自癒無害)(code-codex-d6 r1 單reviewer F3)
 18083	        st = _install_codex_agent()
 18084	        if st == "created":
 18085	            print(f"  ✓ Codex 自訂審查席已寫三份:")

