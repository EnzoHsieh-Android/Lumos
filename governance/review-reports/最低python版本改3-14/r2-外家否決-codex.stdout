 32020	def _bound_tests_filter_probe(root, run_cmd, timeout=600):
 32021	    """★測試指令有沒有過濾能力★(消費專案接入靜默失效 [F]/[S7])——**備援用**。
 32022	
 32023	    主力是 _RAN_EVIDENCE(從輸出裡直接看「執行了幾支」)。這一支只在該 profile 沒有實測過的
 32024	    輸出樣式時才跑,因為它問的是比較弱的問題:「這個指令分不分得出測試不存在」。
 32025	
 32026	    為什麼還留著:沒有輸出樣式可比對時,退出碼是唯一剩下的訊號,而「過濾條件對不到任何測試」
 32027	    在有些建置工具上是★跑 0 支、印成功、退出碼 0★——calc-ios 實測:-only-testing 少寫類別段時
 32028	    xcodebuild 執行 0 支測試仍回 0,閘因此回報「4 支全綠」。那不是綠,是假綠。
 32029	
 32030	    做法借既有 lint-check --smoke 的形狀:拿一個故意不存在的測試名跑一次。
 32031	    回不為 0 → 這指令分得出「找不到測試」,可信;回 0 → 它對任何名字都說成功,不可信。
 32032	
 32033	    ★為什麼這裡不學 lint-check 把「真的跑」拆成要 --smoke 才觸發★(2026-09-09 代碼審 r2
 32034	    架構席 f4,兩輪都提;判準是編排者自己重想的,不是照席位的藥吃):lint-check 要拆,
 32035	    是因為它的靜態驗證★本來一個外部指令都不跑★,加一次真跑是新開一類副作用。
 32036	    合約測試閘不一樣——★跑使用者的測試指令就是它的本職★,這支只是多跑一次帶假名字的,
 32037	    不是新開副作用。改成顯式才跑的實際後果是:那四種沒有輸出樣式的技術棧預設完全不驗。
 32038	    ★但席位點到的真問題是「偷偷跑」★:所以真的要跑的時候(快取沒命中)會印一行說它在做什麼,
 32039	    不再是使用者不知道也看不到的隱形額外執行。
 32040	
 32041	    ★誠實邊界★(r1 單reviewer f7):它只證明「認得出完全不存在的名字」,證不了「精準只選中那一支」
 32042	    ——pytest -k test_pay 會用子字串比對連 test_pay_extra 一起跑。逐支精準度靠 _RAN_EVIDENCE 那條路,
 32043	    這條備援路上沒有解。
 32044	
 32045	    結果按 (root, run_cmd, 判定規則版本) 快取在 ~/.cache/lumos/bound-filter/,保鮮 14 天
 32046	    (r1 單reviewer f8:測試工具升級或設定檔加旗標都會讓判定翻面,而 run_cmd 文字不變)。
 32047	    快取目錄走跟鄰居同一支 _trusted_private_dir(r1 兩席同判:繞過去是同一種漂移第三次發生)。
 32048	    回 (可信 bool, 一句原因)。"""
 32049	    import hashlib, json as _j, os as _os, stat as _stat, time as _time
 32050	    if "{method}" not in run_cmd:
 32051	        return True, "整套跑,不靠過濾"
 32052	    key = hashlib.sha256(f"{_os.path.realpath(str(root))}|{run_cmd}|schema{_FILTER_PROBE_SCHEMA}".encode("utf-8")).hexdigest()
 32053	    cache = Path.home() / ".cache" / "lumos" / "bound-filter" / f"{key}.json"
 32054	    try:
 32055	        # ★讀寫兩端用同一套判準★(2026-09-09 代碼審 r2 f6):第一版只有寫入端走共用檢查,
 32056	        # 讀取端裸查檔案自己的 uid/權限——父目錄被換成指向別處的 symlink 時讀得到別人的判定,
 32057	        # 而這份判定直接決定合約測試閘報不報綠。那正是 r1 兩席都點名「別再各自漂」的同一種漂移。
 32058	        st = cache.stat()
 32059	        if (_trusted_private_dir(cache.parent, ".cache", "lumos", "bound-filter")
 32060	                and st.st_uid == _os.getuid() and not (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH))
 32061	                and _time.time() - st.st_mtime <= _FILTER_PROBE_TTL):
 32062	            d = _j.loads(cache.read_text(encoding="utf-8"))
 32063	            return bool(d["trustworthy"]), d.get("why", "")
 32064	    except (OSError, ValueError, KeyError):
 32065	        pass
 32066	    import shlex as _shlex
 32067	    probe_cmd = run_cmd.replace("{method}", _shlex.quote(_FILTER_PROBE_NAME))
 32068	    print("  (為了確認你的測試指令分不分得出「測試不存在」,現在多跑它一次、餵一個假的測試名;"
 32069	          "結果會快取,不是每次推送都跑)", file=sys.stderr)
 32070	    rc, tail, secs, to = _kill_run(probe_cmd, str(root), timeout)
 32071	    if to:
 32072	        ok, why = True, f"冒煙測試超時({int(secs)}s),不因此判它不可信"
 32073	    elif rc == 0:
 32074	        ok, why = False, ("這個測試指令對一個根本不存在的測試名也回成功——代表它的過濾條件沒有生效,"
 32075	                          "閘拿它的退出碼當「測試跑過」會是假綠")
 32076	    else:
 32077	        ok, why = True, f"冒煙測試回 rc={rc},指令分得出找不到測試"
 32078	    try:
 32079	        # ★逐層建、逐層檢查★(2026-09-16):同上,不要在不可信的路徑上留空資料夾
 32080	        if _mkdir_trusted_under_home(".cache", "lumos", "bound-filter") \
 32081	                and _trusted_private_dir(cache.parent, ".cache", "lumos", "bound-filter"):
 32082	            _write_lf(cache, _j.dumps({"trustworthy": ok, "why": why, "secs": secs}, ensure_ascii=False) + "\n")
 32083	    except OSError:
 32084	        pass
 32085	    return ok, why
