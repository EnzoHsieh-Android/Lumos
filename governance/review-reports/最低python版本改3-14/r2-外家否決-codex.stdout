 18611	def _quote_norm(s):
 18612	    """quote-check 的唯一正規化(T2 design-loop重設計):NFC → 剝 markdown 強調記號(*/`)
 18613	    → 空白(含全形\u3000/換行)摺疊單空格。★抽取與比對共用這一份——嚴禁第二份實作★
 18614	    (2026-08-02 教訓:預檢與主迴圈兩份實作當場漂移)。不做 lower(保留大小寫語意)。"""
 18615	    import re
 18616	    import unicodedata
 18617	    s = unicodedata.normalize("NFC", s)
 18618	    # Landmark 真場實測(2026-08-04):blockquote 折行的續行 > 記號會進 hay,引句永遠比不中
 18619	    s = re.sub(r"(?m)^\s*>\s?", "", s)
 18620	    s = s.replace("*", "").replace("`", "")

