   216	def _codex_entries(entries: dict) -> dict:
   217	    """Claude 註冊表 → Codex 註冊表(Projects/Codex完全支援_計劃 S0-2 對照表,2026-09-04 實測 0.144.1):
   218	    · SessionStart / Stop:同名同形。
   219	    · PreToolUse `Edit|Write|MultiEdit` → matcher `apply_patch`(Codex 改檔工具;Edit/Write 只是它的別名,
   220	      tool_name 仍回 apply_patch;tool_input 是 patch 全文沒有 file_path——S1 適配 impact-hook)。
   221	    · PreToolUse `Agent`(派工鏡頭)→ 改掛 `SubagentStart`(無 matcher):spawn_agent 的 message 對 hook
   222	      是密文改不了(實驗 A),子代理開場的 additionalContext 才到得了子代理(實驗 5)。
   223	    其餘事件原樣。"""
   224	    out = {}
   225	    for event, arr in entries.items():
   226	        for e in arr:
   227	            ne = dict(e)
   228	            ev = event
   229	            if event == "PreToolUse" and e.get("matcher") == "Edit|Write|MultiEdit":
   230	                ne["matcher"] = "apply_patch"
   231	            elif event == "PreToolUse" and e.get("matcher") == "Agent":
   232	                ev = "SubagentStart"
   233	                ne.pop("matcher", None)
   234	            out.setdefault(ev, []).append(ne)
   235	    return out
   236	
   237	
   238	if TARGET == "codex":
   239	    HOOK_ENTRIES = _codex_entries(HOOK_ENTRIES)
   240	
   241	
   242	def _prune_dangling(settings: dict) -> list:
   243	    """剪掉指向 ~/.claude/hooks/ 下「不存在檔案」的 hook 註冊(懸空只會每回合報錯)。
   244	    起因 2026-07-07 現場事故:code-loop-guard.py 被工具鏈更新刪除、settings 註冊沒清 →
   245	    每回合「檔案不存在」。只動 command 含 `.claude/hooks/` 的項;使用者自訂
   246	    (指向他處)的 command 一律不碰。回傳被剪的 (event, script) 列表。"""
   247	    pruned = []
   248	    for event, entries in list(settings.get("hooks", {}).items()):
   249	        if not isinstance(entries, list):      # schema 錯(值不是陣列)→ 當空,別炸(code-codex-s0 r1 F3)
   250	            settings["hooks"][event] = []
   251	            continue
   252	        kept_entries = []
   253	        for entry in entries:
   254	            if not isinstance(entry, dict):
   255	                continue
   256	            kept_hooks = []
   257	            for h in (entry.get("hooks") or []):
   258	                if not isinstance(h, dict):
   259	                    continue
   260	                cmd = h.get("command", "")
   261	                if _HOOKS_SUBDIR in cmd.replace("\\", "/"):
   262	                    script = _hook_script(cmd)
   263	                    if script.endswith(".py") and not (HOOKS_DIR / script).exists():
   264	                        pruned.append((event, script))
   265	                        continue
   266	                kept_hooks.append(h)
   267	            if kept_hooks or not entry.get("hooks"):
   268	                entry = dict(entry)
   269	                if "hooks" in entry:
   270	                    entry["hooks"] = kept_hooks
   271	                kept_entries.append(entry)
   272	            # else:整組 hooks 都懸空 → entry 一併剪
   273	        settings["hooks"][event] = kept_entries
   274	    return pruned
   275	
   276	
   277	def _hook_script(cmd: str):
   278	    m = re.search(r"([\w.-]+\.py)", cmd or "")
   279	    return m.group(1) if m else cmd
   280	
   281	
   282	def _equivalent(a: dict, b: dict) -> bool:
   283	    """同一個 hook entry 認定為已存在 (避免重複註冊)。
   284	    比對:matcher (PostToolUse 需要) + 內層 hook 腳本檔名
   285	    (認出舊裸路徑 == 新 `python …/xxx.py` 為同一 hook)。"""
   286	    if a.get("matcher") != b.get("matcher"):
   287	        return False
   288	    a_s = sorted(_hook_script(h.get("command", "")) for h in (a.get("hooks") or []) if isinstance(h, dict))
   289	    b_s = sorted(_hook_script(h.get("command", "")) for h in (b.get("hooks") or []) if isinstance(h, dict))
   290	    return a_s == b_s
   291	
   292	
   293	def main() -> int:
   294	    if SETTINGS.exists():
   295	        try:
   296	            settings = json.loads(SETTINGS.read_text(encoding="utf-8"))
   297	        except json.JSONDecodeError as e:
   298	            print(f"ERROR: {SETTINGS} JSON 損毀: {e}(hooks 設定檔壞掉,本次不動它;修好 JSON 再跑一次 lumos install)", file=sys.stderr)
   299	            return 1
   300	    else:
   301	        settings = {}
   302	
   303	    # schema 防護:語法合法但 hooks 不是物件(null / 陣列)→ 視為空物件重建,不炸(r1 單reviewer F3:
   304	    # 之前 hooks: null 會在 _prune_dangling 炸 AttributeError,teardown 因此漏剪懸空還印成功)
   305	    if not isinstance(settings.get("hooks"), dict):
   306	        if "hooks" in settings:
   307	            print(f"  ⚠ {SETTINGS} 的 hooks 欄位不是物件({type(settings.get('hooks')).__name__}),當空物件重建", file=sys.stderr)
   308	        settings["hooks"] = {}
   309	    changed = False
   310	
   311	    # 先清懸空(腳本已被刪、註冊還在 → 每回合報錯),再 merge
   312	    for event, script in _prune_dangling(settings):
   313	        print(f"  [prune] {event} hook → {script}(檔案不存在,懸空註冊已清)")
   314	        changed = True
   315	
   316	    # --prune-only:只剪懸空、★不 re-add★(teardown 用——刪掉我方 hook .py 後跑此模式,
   317	    # 剪掉變懸空的我方註冊而不把它加回去;預設 merge 模式會 re-add,反而抵銷 teardown)。
   318	    prune_only = "--prune-only" in sys.argv
   319	
   320	    for event, entries_to_add in ({} if prune_only else HOOK_ENTRIES).items():
   321	        existing = settings["hooks"].setdefault(event, [])
   322	        for new_entry in entries_to_add:
   323	            match_idx = next((i for i, e in enumerate(existing) if _equivalent(new_entry, e)), None)
   324	            if match_idx is not None:
   325	                if existing[match_idx] != new_entry:
   326	                    existing[match_idx] = new_entry  # 遷移:取代成 resolved-python 格式
   327	                    print(f"  [migrate] {event} hook → resolved-python")
   328	                    changed = True
   329	                else:
   330	                    print(f"  [skip] {event} hook already current")
   331	                continue
   332	            existing.append(new_entry)
   333	            print(f"  [add ] {event} hook")
   334	            changed = True
   335	
   336	    # ★自癒去重(2026-08-21 體檢 #1)★:舊版安裝器在 _equivalent 上線前已把同一 hook 註冊兩次
   337	    # (verification-rot-check / check-graph-sync 各兩份,每次事件跑兩遍、Sonnet 呼叫翻倍)。
   338	    # 合併後再掃一次,等價項只留第一份;與 --prune-only 一樣是修復動作,每次執行都跑。
   339	    for event, entries in settings["hooks"].items():
   340	        kept = []
   341	        for e in (entries if isinstance(entries, list) else []):
   342	            if not isinstance(e, dict):
   343	                continue
   344	            if any(_equivalent(e, k) for k in kept):
   345	                print(f"  [dedupe] {event} hook 重複註冊,移除一份")
   346	                changed = True
   347	                continue
   348	            kept.append(e)
   349	        settings["hooks"][event] = kept
   350	
   351	    if not changed:
   352	        print(f"{SETTINGS.name} 已經是最新狀態,無需修改")
   353	        return 0
   354	
   355	    # Backup before write
   356	    if SETTINGS.exists():
   357	        backup = SETTINGS.with_suffix(".json.bak")
   358	        backup.write_text(SETTINGS.read_text(encoding="utf-8"), encoding="utf-8")
   359	        print(f"  備份到: {backup}")
   360	
   361	    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
   362	    SETTINGS.write_text(
   363	        json.dumps(settings, indent=2, ensure_ascii=False) + "\n",
   364	        encoding="utf-8",
   365	    )
   366	    print(f"已更新: {SETTINGS}")
   367	    return 0
   368	
   369	
   370	if __name__ == "__main__":
   371	    sys.exit(main())
<<<get.ps1>>>
     1	# get.ps1 - one-line install for Windows / PowerShell.
     2	#   irm https://raw.githubusercontent.com/EnzoHsieh-Android/Lumos/release/get.ps1 | iex
     3	#   With flags:  $args = @('--pull'); irm <url> | iex
     4	#   Env vars: LUMOS_HOME, LUMOS_URL, LUMOS_BRANCH (default: release; the dev line is main)
     5	#
     6	# ASCII-ONLY, NO BOM. This is not a style preference:
     7	#   - No BOM + non-ASCII: when the file is run from disk, PowerShell 5.1 decodes it with the
     8	#     system ANSI codepage. On CJK systems a DBCS lead byte eats the next byte and breaks
     9	#     quote pairing -> parse error, nothing gets installed.
    10	#   - BOM: `irm | iex` receives a plain string and PowerShell does NOT strip the BOM, so
    11	#     U+FEFF becomes line 1 content and that comment line is executed as a command.
    12	#   Both were hit on a real Windows machine (2026-08-03). ASCII-only removes the whole class.
    13	#   Same rule as slim/*.ps1; the Chinese write-up lives in the graph note, not in this file.
    14	#
    15	# This delegates to `lumos bootstrap`, same as get.sh. It used to run `install --force` only,
    16	# which set up the machine layer but not the project layer - so Windows users finished the
    17	# documented "one command does it all" with nothing wired inside their project.
    18	
    19	function Invoke-LumosGet {
    20	  # NOTE: the parameter must NOT be named $Args. $Args is a PowerShell automatic variable
    21	  # (the function's own unbound arguments) and shadows anything passed in, so every flag
    22	  # would be silently dropped. Same trap as slim/get.ps1.
    23	  param([string[]]$ScriptArgs)
    24	
    25	  $ErrorActionPreference = "Stop"
    26	
    27	  if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    28	    Write-Error "ERROR: git not found. Install git first, then re-run: https://git-scm.com/download/win" -ErrorAction Continue
    29	    return 2
    30	  }
    31	
    32	  # Pick the interpreter at run time instead of hardcoding `python`. Machines that only have
    33	  # python3.exe (some official installers, Microsoft Store builds) would otherwise fail right
    34	  # here - before ever reaching the shim fix in `lumos install` that exists for exactly them.
    35	  $py = $null
    36	  foreach ($cand in @('python3', 'python')) {
    37	    if (Get-Command $cand -ErrorAction SilentlyContinue) { $py = $cand; break }
    38	  }
    39	  if (-not $py) {
    40	    Write-Error "ERROR: neither python3 nor python found on PATH. Install Python 3.9+ and re-run." -ErrorAction Continue
    41	    return 2
    42	  }
    43	
    44	  $homeDir = if ($env:LUMOS_HOME) { $env:LUMOS_HOME } else { "$HOME\harness\lumos-toolchain" }
    45	  $url = if ($env:LUMOS_URL) { $env:LUMOS_URL } else { "https://github.com/EnzoHsieh-Android/Lumos" }
    46	  $branch = if ($env:LUMOS_BRANCH) { $env:LUMOS_BRANCH } else { "release" }
    47	
    48	  $pass = @()
    49	  foreach ($f in $ScriptArgs) {
    50	    if ($f -eq '--pull' -or $f -eq '--init') { $pass += $f }
    51	    else { Write-Warning "unknown option $f - ignored (only --pull and --init are accepted)" }
    52	  }
    53	
    54	  if (-not (Test-Path "$homeDir\scripts\lumos")) {
    55	    New-Item -ItemType Directory -Force -Path (Split-Path $homeDir) | Out-Null
    56	    Write-Host "[clone] cloning Lumos ($branch, the public channel) -> $homeDir ..."
    57	    # Fall back to the default branch: the release branch may not exist yet and a cold
    58	    # start must not die because of that. Branch, not tag: a tag gives a detached HEAD and
    59	    # later `git pull` / `lumos update` then refuse to move (they fail closed and say so).
    60	    git clone --branch $branch $url $homeDir 2>$null
    61	    # $ErrorActionPreference = "Stop" does NOT cover native executables: git.exe returning
    62	    # non-zero does not terminate. Check $LASTEXITCODE explicitly. (Same note as slim/get.ps1.)
    63	    if ($LASTEXITCODE -ne 0) {
    64	      Write-Warning "cannot reach the '$branch' channel (branch missing or renamed); using the default branch - you are getting the development line."
    65	      git clone $url $homeDir
    66	      if ($LASTEXITCODE -ne 0) {
    67	        Write-Error "ERROR: clone of $url failed (check your network and access to that repo)." -ErrorAction Continue
    68	        return 2
    69	      }
    70	    }
    71	  } else {
    72	    Write-Host "[clone] Lumos source already at: $homeDir"
    73	  }
    74	
    75	  $env:LUMOS_HOME = $homeDir
    76	  # `| Out-Host` is required: a function's `return` also emits every unconsumed output,
    77	  # so without it the caller receives Object[] instead of Int32. (Same note as slim/get.ps1.)
    78	  & $py "$homeDir\scripts\lumos" bootstrap @pass | Out-Host
    79	  if ($LASTEXITCODE -ne 0) {
    80	    Write-Error "ERROR: bootstrap failed with exit code $LASTEXITCODE." -ErrorAction Continue
    81	    return $LASTEXITCODE
    82	  }
    83	
    84	  Write-Host ""
    85	  Write-Host "Done. Last step: restart your Claude Code session (hooks load at session start)."
    86	  return 0
    87	}
    88	
    89	$rc = Invoke-LumosGet -ScriptArgs $args
    90	$global:LASTEXITCODE = $rc
<<<ci>>>
     1	name: CI
     2	# 獨立信任根(2026-07-29 Codex 外審 P0):本機 hooks 可繞(--no-verify/缺環境降級放行),
     3	# 這裡是 push 後必跑的後盾——pre-push 提示裡的「CI 仍會抓」由本 workflow 兌現。
     4	on:
     5	  push:
     6	    branches: [main]
     7	  pull_request:
     8	
     9	jobs:
    10	  test:
    11	    runs-on: ubuntu-latest
    12	    timeout-minutes: 45   # 2026-09-12:全套單行程跑到 30 分被砍(前幾次 25–27 分,一路逼近上限);切片後約 10 分,上限留餘裕
    13	    steps:
    14	      - uses: actions/checkout@v4
    15	        with:
    16	          fetch-depth: 0   # code-loop gate 要算 before..sha 的 diff(體檢 #5)
    17	      - uses: actions/setup-python@v5
    18	        with:
    19	          python-version: "3.12"
    20	      - name: Compile check
    21	        run: python -m compileall -q scripts/lumos scripts/test_lumos.py
    22	      - name: SyntaxWarning 歸零閘
    23	        run: python -W error::SyntaxWarning -c "compile(open('scripts/lumos').read(),'lumos','exec'); compile(open('scripts/test_lumos.py').read(),'t','exec')"
    24	      # 2026-09-12:全套在 CI 單行程跑要 25–30 分鐘,已經撞到 job 上限被砍(8a45751b)。
    25	      # 推送前掛鉤早就把它切成幾片同時跑,CI 照同一支旗標切——不改測試內容、只改跑法;
    26	      # 任何一片紅就整步紅,而且把每一片的尾端印出來(不然只看得到「有片紅了」)。
    27	      # 2026-09-18(Enzo 裁「像這種改動 CI 可以跳過吧,跟程式碼無關」):push 事件先問 lumos 這段推送改到什麼——
    28	      # 只改到 README/docs/assets 這類文件(pitfalls --json 的 suite=docs)就只跑文件子集(原始碼提到那些路徑的測試);
    29	      # 碰到程式、skills、workflow 任何一支都跑全套。判不出來(首推、force-push 對不到起點、lumos 出錯)一律全套——
    30	      # 保守方向是多跑,不是少跑。pull_request 事件沒有 before,也是全套。
    31	      - name: 這次推送要跑哪個測試範圍
    32	        id: suite
    33	        env:
    34	          BEFORE: ${{ github.event.before }}
    35	          SHA: ${{ github.sha }}
    36	        run: |
    37	          suite=full; why="不是 push 事件或起點對不到"
    38	          if [ "${{ github.event_name }}" = push ] && [ -n "$BEFORE" ] && [ "$BEFORE" != "0000000000000000000000000000000000000000" ] \
    39	             && git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
    40	            out="$(python scripts/lumos pitfalls --diff "$BEFORE..$SHA" --no-lint --json --repo . 2>/dev/null || true)"
    41	            s="$(printf '%s' "$out" | python -c 'import json,sys; d=json.load(sys.stdin); print(d.get("suite","full")); print(d.get("suite_reason","")); print("graph" if d.get("suite_graph") else "")' 2>/dev/null || printf 'full\nlumos 算不出來\n')"
    42	            suite="$(printf '%s' "$s" | sed -n 1p)"; why="$(printf '%s' "$s" | sed -n 2p)"; graph="$(printf '%s' "$s" | sed -n 3p)"
    43	            [ "$suite" = docs ] || suite=full
    44	          fi
    45	          echo "suite=$suite" >> "$GITHUB_OUTPUT"
    46	          echo "graph=$graph" >> "$GITHUB_OUTPUT"
    47	          echo "測試範圍:$suite($why)"
    48	      - name: Full test suite (切 4 片同時跑;純文件推送只跑文件子集)
    49	        env:
    50	          SUITE: ${{ steps.suite.outputs.suite }}
    51	          GRAPH: ${{ steps.suite.outputs.graph }}
    52	        run: |
    53	          set -u
    54	          rc=0
    55	          extra=""
    56	          if [ "$SUITE" = docs ]; then extra="--suite docs"; echo "純文件推送:只跑文件子集(--suite docs),不跑全套"; fi
    57	          if [ "$SUITE" = docs ] && [ "$GRAPH" = graph ]; then extra="$extra --graph"; echo "含圖譜筆記:加跑讀真圖譜的測試(--graph)"; fi
    58	          for i in 1 2 3 4; do
    59	            python scripts/test_lumos.py --shard "$i/4" $extra > "/tmp/shard-$i.log" 2>&1 &
    60	          done
    61	          for job in $(jobs -p); do wait "$job" || rc=1; done
    62	          for i in 1 2 3 4; do
    63	            echo "===== 第 $i 片 ====="
    64	            # 紅的時候先把失敗那幾行撈出來——tail 只看得到尾巴,而紅的那支通常在中間,
    65	            # 以前紅了要靠猜是哪一支(2026-09-15 實際踩到:CI 紅、本機全綠、查不出名字)
    66	            if grep -qE "^  ✗|, [1-9][0-9]* failed" "/tmp/shard-$i.log"; then
    67	              echo "--- 這一片紅了,以下是失敗的斷言與所在測試 ---"
    68	              grep -nE "^  ✗|EXCEPTION" "/tmp/shard-$i.log" | tail -40 || true
    69	              echo "--- 失敗處前後文 ---"
    70	              # ★這裡的 || true 不是裝飾★(2026-09-15 審查席抓到):撈不到就回非零,
    71	              # 目前這步的殼是 bash -e 沒有 pipefail、管線末端是 while 所以不會中止;
    72	              # 但只要有人把這步改成 shell: bash(預設帶 pipefail),沒接住就會★整步當場死掉★,
    73	              # 連還沒印的片都一起失聲,比改動前更糟。實測過兩種殼,差別就在這個旗標。
    74	              # 另外要認得逾時/零斷言/跳過判紅——那三種紅不印 FAILED 也不印 EXCEPTION,
    75	              # 而它們正是「CI 紅、本機綠」最常見的成因,漏掉等於在最該用的場合失效。
    76	              grep -nE "^  ✗ (FAILED|TIMEOUT|判紅)|EXCEPTION|^  ✗ .*一條斷言都沒有" \
    77	                "/tmp/shard-$i.log" | head -3 | cut -d: -f1 | while read ln; do
    78	                sed -n "$((ln>12 ? ln-12 : 1)),$((ln+3))p" "/tmp/shard-$i.log"
    79	              done || true
    80	              echo "--- 以下是該片尾端 ---"
    81	            fi
    82	            tail -25 "/tmp/shard-$i.log"
    83	          done
    84	          exit $rc
    85	      # 2026-08-29 接線:這支的 106 個測試先前沒有任何自動路徑在跑(CI 與 pre-push 都只跑
    86	      # test_lumos.py),而它是 autonomous_loop 十個模組中九個的唯一覆蓋,且早已在 anchor
    87	      # 基準線裡被防竄改守著——綠紅沒人看,卻有人守。
    88	      - name: 自主迴圈測試
    89	        # 純文件推送只跑讀真 CLAUDE.md 的那一條(144 支裡只有它讀 repo 的文件;整支 63 秒)——跟推送前掛鉤同一條規則
    90	        env:
    91	          SUITE: ${{ steps.suite.outputs.suite }}
    92	        run: |
    93	          extra=""
    94	          if [ "$SUITE" = docs ]; then extra="-k real_claude_md"; fi
    95	          python scripts/test_autonomous_loop.py $extra
    96	      - name: Graph doctor (strict)
    97	        run: python scripts/lumos doctor --ci
    98	      - name: code-loop gate (push 後盾;體檢 #5)
    99	        # `git push --no-verify` 會整個跳過 pre-push——測試/doctor/anchor 這裡都已重跑,唯獨 tier=high
   100	        # 的對抗審查閘與表態閘(2026-09-09)沒人補查,繞過零留痕。本步在 push 事件重算 pitfalls tier/適用題並比對留痕:
   101	        # rc1=高風險 diff 無 pass/skip 留痕 → CI 紅(可見的痕跡;ci-wait/ci-log 會收到)。
   102	        if: github.event_name == 'push'
   103	        env:
   104	          LUMOS_SKIP_BOUND_TESTS: "1"   # 受波及合約測試在本機 pre-push 真跑;CI 已跑全套當後盾,不重跑
   105	          BEFORE: ${{ github.event.before }}
   106	          SHA: ${{ github.sha }}
   107	          BRANCH: ${{ github.ref_name }}
   108	        run: |
   109	          # 前一版原樣交給 lumos(40 個 0 或本機找不到時它自己判起點,跟 note-shape 那步同一支判法;找不到主線時代碼審這道照舊用空樹、不截上線點)
   110	          [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
   111	          echo "range: $BEFORE..$SHA branch=$BRANCH"
   112	          python scripts/lumos code-loop check --diff "$BEFORE..$SHA" --at-sha "$SHA" --branch "$BRANCH" --repo . || {
   113	            rc=$?
   114	            if [ "$rc" -eq 1 ]; then
   115	              echo "::error::code-loop check 擋下(原因在上面:合約測試紅 / 效能檢核題沒表態 / 高風險代碼無審查留痕)——本機 pre-push 被繞過(--no-verify)或留痕失效;照上面 check 印的指令補留痕(dispositions / pass|skip --note)後重推"
   116	              exit 1
   117	            fi
   118	            exit "$rc"
   119	          }
   120	      - name: note-shape gate (筆記形狀擋;--no-verify 後盾)
   121	        # 筆記新寫的程式行號引用、沒寫來源的 FACT/FLOW/DEP(Projects/筆記形狀擋_計劃)。note-shape 不重查「已經在主線上」
   122	        # 的提交,主線=本地 main 的 upstream;推 main 時 origin/main 就是這次的頂端,lumos 看到頂端已在主線裡就不拿它排除。
   123	        # 本 workflow 只在推 main 時跑這步;建本地 main 那行是給 PR / 其他分支觸發的專案照抄用的(doctor 給的也是這步)。
   124	        # 前一版原樣交給 lumos:40 個 0(新分支首推)或本機找不到(force-push 後的舊頂端)時,它自己判——頂端落後或等於主線頂端就不查,
   125	        # 其他從跟主線的分岔點算(2026-09-28 漏網 ESC-61fc2d87;繞過本機掛鉤又 force-push 改寫主線屬存心繞過,不在範圍)。
   126	        if: github.event_name == 'push'
   127	        env:
   128	          BEFORE: ${{ github.event.before }}
   129	          SHA: ${{ github.sha }}
   130	        run: |
   131	          git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*'
   132	          git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true
   133	          [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
   134	          python scripts/lumos note-shape --diff "$BEFORE..$SHA" --repo . || {
   135	            rc=$?
   136	            if [ "$rc" -eq 1 ]; then
   137	              echo "::error::note-shape 擋下(原因在上面):筆記新寫了程式行號引用或沒寫來源的現況描述——本機提交前/推送前被繞過(--no-verify)或用了 LUMOS_SKIP_NOTE_SHAPE 單次跳過;改寫那幾行後重推,或把專案的 note_shape.gate 設成 warn"
   138	              exit 1
   139	            fi
   140	            exit "$rc"
   141	          }
   142	      - name: Anchor verify (baseline 缺失必紅)
   143	        run: |
   144	          test -f governance/anchor-baseline.json || { echo "anchor baseline 缺失"; exit 1; }
   145	          python scripts/lumos anchor verify
