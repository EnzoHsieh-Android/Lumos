 17761	# 掃 repo 猜技術棧時一律略過的目錄(★兩支掃描共用同一份★——r1 單reviewer f4:
 17762	# 兩邊各有一份且內容不同時,init 猜出來的骨架跟健檢驗的東西會對不上,
 17763	# 「猜錯沒人知道」正好在自己身上重演一次)。
 17764	# ★只放「不是人寫的原始碼」的目錄★:相依套件、建置產物、工具自己的目錄。
 17765	# 合併時特意★把 scripts 從名單裡拿掉★:它原本只在健檢那份裡,而那是普通的原始碼目錄
 17766	# ——照舊略過的話,本 repo 自己的 Python 全在 scripts/ 底下,健檢就再也抓不到
 17767	# 「這個 repo 從沒設 symbol_profile、一直吃 C# 預設」那一條真的問題(實測會從 1 條變 0 條)。
 17768	# vault 用「目錄名結尾 -knowledge」認,不整個 docs/ 略過(專案可能在 docs/ 放範例程式)。
 17769	_STACK_SCAN_SKIP = {"node_modules", ".git", "build", "DerivedData", "dist", "vendor",
 17770	                    "Pods", ".venv", "venv", ".gradle", ".build", "target",
 17771	                    "governance", ".lumos"}
 17772	
 17773	
 17774	def _stack_scan_skip(name):
 17775	    return name in _STACK_SCAN_SKIP or name.endswith("-knowledge")
 17776	
 17777	
 17778	def _stack_ext_counts(root):
 17779	    """數 repo 裡各種程式碼副檔名各有幾個檔。回 {ext: n}。
 17780	
 17781	    ★用 os.walk 就地剪枝,不是 rglob 之後再過濾★(r1 單reviewer f5,實測):
 17782	    rglob 會先把 node_modules 底下 2000 個檔全部走過一遍才被丟掉——略過名單對它想排除的
 17783	    正是最大的那幾個目錄完全沒省到。健檢每次都跑這段,大型專案會隨依賴目錄大小線性變慢。"""
 17784	    import os as _os
 17785	    counts = {}
 17786	    known = _stack_guess()
 17787	    # ★lumos 自己安裝進來的檔不算這個專案的技術棧★(2026-09-10,一個小 Vue 專案上實撞):
 17788	    # init 會把 CLI、自己的測試檔和五支 hook 複製到消費專案的 scripts/ 底下,那是八個 .py。
 17789	    # 那個專案自己只有六個 .js,於是健檢反過來唸「你有 8 個 .py,測試設定卻只認 .js」——
 17790	    # 舉的證據全是 lumos 自己的檔,而且專案愈小愈容易被唸,正好唸在剛接入的人臉上。
 17791	    # ★只跳過工具確實安裝的那幾支檔(精確檔名,見 _VENDORED_ALL)★,同目錄底下專案自己的檔照樣算
 17792	    # ——第一版照目錄前綴跳過,代碼審 r1 抓到專案自己的 hook 程式也被一起跳過。
 17793	    _base = _os.path.abspath(str(root))
 17794	    # 工具鏈本體那裡 scripts/lumos 就是產品,一支都不跳;消費專案只跳「內容跟安裝時一模一樣」的工具檔
 17795	    _skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root)[0]
 17796	    for dirpath, dirnames, filenames in _os.walk(_base):
 17797	        dirnames[:] = [d for d in dirnames if not _stack_scan_skip(d)]
 17798	        rd = _os.path.relpath(dirpath, _base)
 17799	        for fn in filenames:
 17800	            ext = _os.path.splitext(fn)[1].lower()
 17801	            if ext not in known:
 17802	                continue
 17803	            if _skip and _posix_norm(fn if rd == "." else _os.path.join(rd, fn)) in _skip:
 17804	                continue
 17805	            counts[ext] = counts.get(ext, 0) + 1
 17806	    return counts
 17807	
