 17877	def _config_left_blank(root):
 17878	    """設定骨架產了但沒填(消費專案接入靜默失效 [B];r1 單reviewer f9)。
 17879	
 17880	    為什麼要另外驗:猜不到技術棧時骨架會把 test_profile / symbol_profile 寫成空字串,
 17881	    而讀設定那支對空字串一律靜默退回 csharp 預設——清單外的語言(Rust、Go…)因此
 17882	    第一天起兩個關鍵設定都錯,而且 S3 靠副檔名比對也抓不到(它只認得出正典表裡的副檔名)。
 17883	    這一條純粹看「骨架欄位還空著沒有」,跟語言無關。"""
 17884	    import json as _json
 17885	    if not root:
 17886	        return []
 17887	    cfg_path = Path(root) / ".lumos" / "config.json"
 17888	    if not cfg_path.exists():
 17889	        return []
 17890	    try:
 17891	        cfg = _json.loads(cfg_path.read_text(encoding="utf-8"))
 17892	    except Exception:
 17893	        return ["`.lumos/config.json` 解析失敗——整份設定會被當作不存在,測試 profile 與符號 profile 都退回 C# 預設"]
 17894	    if not isinstance(cfg, dict):
 17895	        return []
 17896	    out = []
 17897	    if not cfg.get("test_profile") and not cfg.get("platforms"):
 17898	        out.append("`.lumos/config.json` 的 test_profile 還是空的——掃不到你的測試,合約綁不上任何東西(閘會靜默放行)")
 17899	    if not cfg.get("symbol_profile"):
 17900	        out.append("`.lumos/config.json` 的 symbol_profile 還是空的——符號檢查會用 C# 的副檔名清單,對你的程式碼視而不見")
 17901	    return out
 17902	
