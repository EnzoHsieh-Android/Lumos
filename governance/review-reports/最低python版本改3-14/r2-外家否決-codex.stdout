 18211	def _teardown_global_hooks(src_repo: Path, harness: str):
 18212	    """_sync_global_hooks 的移除半邊(teardown 用):清全域 ~/.claude(或 ~/.codex)的我方 hook + 剪其懸空註冊。
 18213	    ①先驗 settings.json 可解析→壞則跳過+warn、★不刪 .py★(不製造懸空,std F6)②rm 我方現役+撤除 hook
 18214	    ③跑 merge --prune-only(★只剪懸空、不 re-add★——預設 merge 會把 hook 加回,抵銷 teardown)④收自家自訂審查席 TOML(codex)⑤收 .bak。
 18215	    須在 deinit 刪掉 vendored merge-claude-settings.py 之前跑(std F5,由 cmd_teardown 順序保證)。
 18216	    設計:Projects/teardown一鍵拆機_計劃。回 True=已處理 / False=因 settings 壞跳過。"""
 18217	    import subprocess, json
 18218	    hdir, sfile = _HARNESS_HOME[harness]
 18219	    chome = _codex_home() if harness == "codex" else Path.home() / hdir
 18220	    if harness == "codex" and not chome.is_dir():
 18221	        if chome.exists():
 18222	            print(f"  ⚠ Codex 家目錄 {chome} 不是目錄,略過 Codex 側清理", file=sys.stderr)
 18223	        return True                           # 沒裝過 Codex 側(或家目錄是檔案):無事可拆
 18224	    chooks, settings = chome / "hooks", chome / sfile
 18225	    if settings.exists():                     # ① 先驗可解析(壞 → 不半做)
 18226	        try:
 18227	            json.loads(settings.read_text(encoding="utf-8"))
 18228	        except Exception as e:
 18229	            print(f"  ⚠ ~/{hdir}/{sfile} 無法解析({e}),跳過全域 hook 清理"
 18230	                  "(避免刪了檔卻剪不掉註冊、留懸空)", file=sys.stderr)
 18231	            return False
 18232	    removed = []                              # ② rm 我方 hook 真檔
 18233	    for f in _GLOBAL_HOOKS + _RETIRED_CLAUDE_HOOKS + _RETIRED_STUB_CLAUDE_HOOKS:
 18234	        p = chooks / f            # ★含相容期空殼★:拆機後機器上不該留我方任何檔
 18235	        if p.exists() or p.is_symlink():
 18236	            p.unlink(); removed.append(f)
 18237	    merge = src_repo / "scripts" / "merge-claude-settings.py"   # ③ prune-only 剪懸空我方註冊
 18238	    if merge.exists() and settings.exists():
 18239	        subprocess.run([sys.executable, str(merge), "--prune-only"] + (["--target", "codex"] if harness == "codex" else []))
 18240	    if harness == "codex":                            # ④ 自家自訂審查席 TOML(d6;三席,照實列刪掉的那些)
 18241	        removed.extend(_remove_codex_agent())
 18242	    bak = settings.with_suffix(".json.bak")   # ⑤ 合併器每次改檔留的備份也收掉(r1 單reviewer F7:拆機要對稱)
 18243	    if bak.exists():
 18244	        try:
 18245	            bak.unlink(); removed.append(bak.name)
 18246	        except OSError:
 18247	            pass
 18248	    name = "Claude" if harness == "claude" else "Codex"
 18249	    print(f"  ✓ 全域 {name} hook 清理:移除 {len(removed)} 檔 + 剪懸空我方註冊" if removed
 18250	          else f"  ✓ 全域 {name} hook:無我方殘留")
 18251	    return True
