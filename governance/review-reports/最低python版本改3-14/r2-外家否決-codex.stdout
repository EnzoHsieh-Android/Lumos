 12467	def _kill_attribute(out, method):
 12468	    """[S3] 歸因:綁定測試名的任一出現處,其行起(含同行)5 行窗內有失敗標記,
 12469	    且標記命中位置不得落在測試名字串自身範圍內(防 test_fail_closed 這類名字偽造強殺)。
 12470	    回 (attributed: bool, excerpt: str)——excerpt 取跨距最短的命中處、名行到標記行整段、截 200 字。"""
 12471	    if not out or not method:
 12472	        return False, ""
 12473	    lines = out.splitlines()
 12474	    best = None
 12475	    for i, line in enumerate(lines):
 12476	        col = line.find(method)
 12477	        if col < 0:
 12478	            continue
 12479	        for j in range(i, min(i + 5, len(lines))):
 12480	            probe = lines[j]
 12481	            # 遮蔽測試名字串本身再找標記(名字自帶 FAIL/AssertionError 不算證據)
 12482	            masked = probe.replace(method, " " * len(method))
 12483	            if j > i and _KILL_OTHER_TEST_RE.search(masked):
 12484	                break   # 窗內出現另一個測試名 → 後續標記屬別支,停掃(防鄰近他測誤歸因)
 12485	            up = masked.upper()
 12486	            if any(m.upper() in up for m in _KILL_FAIL_MARKS):
 12487	                span = j - i
 12488	                if best is None or span < best[0]:
 12489	                    best = (span, i, j)
 12490	                break
 12491	    if best is None:
 12492	        return False, ""
 12493	    _, i, j = best
 12494	    return True, "\n".join(lines[i:j + 1])[:200]
