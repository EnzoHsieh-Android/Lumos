 32366	_BOUND_ZERO_REASONS = {
 32367	    # ★三種零覆蓋分開講★(消費專案接入靜默失效 r1 接手席 f4:原本 vault 找不到也回 no-pins,
 32368	    # 跑錯目錄的人會以為圖譜正常只是沒覆蓋到)。值是給人看的一句話,不是代號。
 32369	    "no-vault": "這個目錄裡找不到知識庫(是不是跑錯資料夾,或這個專案還沒 lumos init?)",
 32370	    "no-pins": "這次改到的檔沒有任何節點引用(圖譜對這批改動沒有覆蓋;波及計算認的是筆記正文裡用反引號寫的路徑)",
 32371	    "no-bound": "有節點引用這些檔,但那些節點的合約沒有綁測試(綁法看 lumos guard scaffold)",
 32372	    "diff-unavailable": "算不出這個範圍改了哪些檔(範圍寫錯,還是這個 repo 沒有那些 commit?)",
 32373	}
