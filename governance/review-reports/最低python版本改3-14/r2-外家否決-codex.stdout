 18354	def cmd_bootstrap(lumos_url=None, lumos_home=None, pull=False, init=False, allow_stale=False):
 18355	    """一鍵在專案內裝好一切:自動 clone Lumos(若缺)→ user-scope skills → 全域 lumos → 專案層自動接線。
 18356	    專案層四分流(設計:Projects/bootstrap一鍵對稱_計劃):有 vault+vendored→接 hooks｜有 vault 無
 18357	    vendored(中間態)→提示跑 init 補齊｜無 vault→_confirm_tty 確認(y 才 auto-init;--init 免確認)｜
 18358	    非 git→跳過只做機器層。--pull:既有 Lumos clone 也 git pull 拉最新。
 18359	    冪等:auto-init 只在無 vault 時觸發;cmd_init 一律 force=False+no_pull=True(pull 政策歸 step1)。
 18360	    失敗傳播(std F8):各步查 returncode,任一失敗最終 rc=1,不吞錯照印成功。"""
 18361	    import os, subprocess
 18362	    if _refuse_if_probe("bootstrap"):
 18363	        return 2
 18364	    home = Path(lumos_home or os.environ.get("LUMOS_HOME")
 18365	                or (Path.home() / "harness" / "lumos-toolchain")).expanduser()
 18366	    url = _bootstrap_url(lumos_url)   # 解析鏈:旗標>env>本 clone origin(鏡像自足+身分探針)>硬編碼
 18367	    # 1) 確保 Lumos 來源在(缺則自動 clone;--pull 則既有 clone 也拉最新)
 18368	    # 存在性判定=scripts/lumos(真正要執行的檔;code-loop r1 F3:與 get.sh 同判準,免部分 clone 下兩端不一致)
 18369	    if (home / "scripts" / "lumos").exists():
 18370	        if pull:
 18371	            print(f"[1/3] Lumos 來源已在,git pull 更新: {home}")
 18372	            # 與 _vendor_toolchain 共用政策:有 remote 卻拉不到就中止,不拿可能過期的
 18373	            # 來源往下走(step3 的 auto-init 會把它 vendor 進專案 → 同一個降版坑)。
 18374	            if _pull_source_or_abort(home, allow_stale) is None:
 18375	                return 2
 18376	        else:
 18377	            print(f"[1/3] Lumos 來源已在: {home}（--pull 可拉最新 skills）")
 18378	    else:
 18379	        branch = os.environ.get("LUMOS_BRANCH", LUMOS_RELEASE_BRANCH)
