   471	  run_group() {   # $1=log 前綴,其餘=執行器參數;每片一個子行程,回傳 0=全綠、3=每片都選中 0 支、1=有紅
   472	    local _pfx="$1"; shift
   473	    local _pids=() _i _p _r _any3=0 _bad=0
   474	    for _i in $(seq 1 "$_shards"); do
   475	      if [[ "$_shards" -le 1 ]]; then
   476	        "$PY" "$REPO_ROOT/scripts/test_lumos.py" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
   477	      else
   478	        # 這條路不帶 --json-summary:判紅靠子行程離開碼、列紅的靠 log,摘要檔寫了沒人讀
   479	        # 就是白工(r1 通才席抓到)。那個旗標留著給要機讀的人用,不是給這裡用的。
   480	        "$PY" "$REPO_ROOT/scripts/test_lumos.py" --shard "$_i/$_shards" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
   481	      fi
   482	      _pids+=($!)
   483	    done
   484	    # ★用每個子行程自己的離開碼判★,不是用有沒有寫出摘要檔判——摘要檔是給人看的加值,
   485	    # 拿它當判準等於「runner 不支援新旗標就一律紅」。
   486	    for _p in "${_pids[@]}"; do _r=0; wait "$_p" || _r=$?; [[ "$_r" -eq 3 ]] && _any3=1; [[ "$_r" -ne 0 && "$_r" -ne 3 ]] && _bad=1; done
   487	    [[ "$_bad" -eq 1 ]] && return 1
   488	    [[ "$_any3" -eq 1 ]] && return 3
   489	    return 0
   490	  }
   491	  if [[ "$_suite_mode" != "full" ]]; then
   492	    echo "推送前先跑$_suite_word(切成 $_shards 片同時跑;嫌久可 --no-verify,CI 會兜底)…" >&2
   493	  elif [[ "$_shards" -le 1 ]]; then
   494	    echo "推送前先跑全部測試(約 8 分鐘;嫌久可 --no-verify,CI 會兜底)…" >&2
   495	  else
   496	    echo "推送前先跑全部測試(切成 $_shards 片同時跑,約 4-5 分鐘;嫌久可 --no-verify,CI 會兜底)…" >&2
   497	  fi
   498	  # 兩組真的同時跑(2026-09-18 實測:原本 keys 那組等文件子集跑完才開始,註解卻寫「平行」)
   499	  _grc=0; _krc=0
   500	  ( run_group s ${_suite_args+"${_suite_args[@]}"} ) & _gpid=$!
   501	  if [[ ${#_keys_args[@]} -gt 0 ]]; then
   502	    ( run_group k "${_keys_args[@]}" ) & _kpid=$!
   503	    wait "$_kpid" || _krc=$?
   504	  fi
   505	  wait "$_gpid" || _grc=$?
   506	  [[ "$_grc" -ne 0 ]] && _rc=1      # 文件子集/全套選中 0 支也算紅(執行器那邊本來就這樣判)
   507	  if [[ ${#_keys_args[@]} -gt 0 ]]; then
   508	    if [[ "$_krc" -eq 3 ]]; then
   509	      echo "  沒有測試提到這次改到的函式或檔名($_SUITE_KEYS),推送前只跑了文件子集;CI 會跑全套當後盾。" >&2
   510	    elif [[ "$_krc" -ne 0 ]]; then
   511	      _rc=1
   512	    fi
   513	  fi
   514	  cat "$_sdir"/*.log > "$_TESTS_LOG" 2>/dev/null || true
   515	  if [[ $_rc -ne 0 ]]; then
   516	    {
   517	      echo ""
   518	      echo "擋下:test_lumos.py 有紅,有測試沒過。"
   519	      echo "紅的是這幾支:"
   520	      grep -h "✗ " "$_TESTS_LOG" | head -20 | sed 's/^/    /'
   521	      echo ""
   522	      echo "完整輸出(所有分片接在一起)在這裡:"
   523	      echo "   $_TESTS_LOG"
   524	      echo ""
   525	      echo "兩條路選一條:"
   526	      echo "  1. 修到全綠再推。只重跑紅的那幾支:"
   527	      echo "       python3 scripts/test_lumos.py --ff -x"
   528	      echo "  2. 確定是測試本身不穩或環境問題 → git push --no-verify(後果自負;CI 還是會再跑一次)"
   529	      echo ""
   530	    } >&2
   531	    exit 1
   532	  fi
   533	  # 各片印一行「N passed, M failed」,用 awk 加總成一行(維持薄殼:不在 hook 裡塞 python)
   534	  grep -h "passed," "$_TESTS_LOG" \
   535	    | awk -F'[ ,]+' '{p+=$1; f+=$3} END{if (NR) printf "  全部 %d 條斷言過、%d 條紅(%d 片加總)\n", p, f, NR}' >&2 || true
   536	fi
   537	
   538	exit 0
<<<scripts/hooks/post-commit>>>
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git post-commit hook — bypass 留痕 (L2 的觀測面)
     7	#
     8	# 設計理由 (2026-06-10, 治理調研 gap「逃生口與警告忽略皆無留痕」):
     9	#   L2 pre-commit 硬擋有合法後門 `--no-verify`,但走後門零痕跡——bypass 率
    10	#   是「不更新圖譜比更新圖譜更難」這個核心宣稱唯一沒被量測的數字。
    11	#   關鍵事實:--no-verify 只跳過 pre-commit / commit-msg,post-commit 永遠會跑,
    12	#   所以本 hook 是天然的偵測點:凡「有 code 異動但無圖譜 .md」的 commit 能落地,
    13	#   必然繞過了 L2 → append 結構化事件到 docs/.bypass-log.jsonl。
    14	#
    15	#   只記錄、不阻擋、不問理由——bypass 本來就是被認可的逃生口,這裡要的是
    16	#   「率」不是「罪」;weekly 由 `lumos gov --since 7` 顯示 bypass 率(原寫 rot-queue-digest.sh,從未存在,2026-08-21 更正)。
    17	#   (L1 警告被忽略的最終結果就是一筆 bypass commit,同一個訊號,不另外追蹤)
    18	#
    19	# 判定邏輯與 scripts/hooks/pre-commit 完全對齊 (CODE_EXTS_RE / 排除規則 /
    20	# GRAPH_ROOT 偵測),兩邊認定不一致會產生幽靈 bypass 或漏記。
    21	
    22	set -u
    23	
    24	# post-commit 絕不能影響 commit 結果:任何錯誤都靜默結束
    25	trap 'exit 0' ERR
    26	
    27	REPO_ROOT="$(git rev-parse --show-toplevel)"
    28	cd "$REPO_ROOT" || exit 0
    29	
    30	# 找圖譜目錄 (對齊 pre-commit)
    31	GRAPH_ROOT=""
    32	if [[ -d docs ]]; then
    33	  for d in docs/*-knowledge; do
    34	    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
    35	  done
    36	  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
    37	fi
    38	[[ -z "$GRAPH_ROOT" ]] && exit 0
    39	
    40	# merge commit 不適用 bypass 概念 (內容來自既有 commit) → 跳過
    41	if [[ "$(git rev-list --parents -n 1 HEAD | wc -w)" -gt 2 ]]; then
    42	  exit 0
    43	fi
    44	
    45	# 本次 commit 的檔案清單 (quotePath=off 對齊 pre-commit 的中文路徑處理)
    46	CHANGED="$(git -c core.quotePath=off diff-tree --no-commit-id --name-only -r HEAD)"
    47	[[ -z "$CHANGED" ]] && exit 0
    48	
    49	# code 副檔名與排除規則 (對齊 pre-commit / check-graph-sync.py CODE_EXTS)
    50	CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp|sh|ps1)$'  # sh/ps1 2026-08-21 補(體檢 #7);各份清單由 t_code_exts_lists_agree 釘
    51	
    52	is_shebang_code() {   # 沒副檔名的檔:看 剛 commit 的 內容首行是不是 #!(2026-09-05 README 審視 d1:scripts/lumos 這種主程式五月起 26 次漏過)
    53	  local path="$1" base
    54	  # git 對含 " \ 或控制字元的檔名會印成 C 式引號("a\"b");拿去 git show 會找不到 → 先解引號(r2 delta major)
    55	  if [[ "$path" == \"*\" && ${#path} -ge 2 ]]; then   # 長度守衛:單一個引號的假輸入不做子字串(r3 delta minor,set -u 下會吐錯)
    56	    path="${path:1:${#path}-2}"; path="${path//\\\"/\"}"; path="$(printf '%b' "$path")"   # \" 手解;\\ \t \ooo(控制字元)交給 printf %b(r3 外家:八進位沒解 → 找不到 → 放行)
    57	  fi
    58	  base="${path##*/}"; base="${base#"${base%%[!.]*}"}"; [[ "$base" == *.* ]] && return 1   # 去掉所有開頭的點再看有沒有副檔名(.pythonrc、..foo 也要看 shebang)
    59	  local first; first="$(git show "HEAD:$path" 2>/dev/null | head -c 200 | head -n 1)" || return 1
    60	  [[ "$first" == "#!"* ]]   # 任何 shebang 都算(不列直譯器清單:r1 外家 #!/bin/dash 漏判;各處同一條規則,由 t_code_exts_lists_agree 釘)
    61	}
    62	should_exclude() {
    63	  local path="$1"
    64	  case "$path" in
    65	    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
    66	    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
    67	    # vendored 工具白名單+源 repo 守門(與 pre-commit 完全對齊,2026-07-25):例行 lumos update
    68	    # 的 vendored .py 不該進 bypass 帳(pre-commit 已放行,這裡再記=假 bypass 灌水稀釋真訊號)。
    69	    scripts/lumos|scripts/test_lumos.py|scripts/merge-claude-settings.py|scripts/graph-rename.sh|scripts/fetch-notesmd.sh|scripts/hooks/*|scripts/templates/*)
    70	      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
    71	      return 0;;
    72	  esac
    73	  return 1
    74	}
    75	
    76	src_files=()
    77	while IFS= read -r f; do
    78	  [[ -z "$f" ]] && continue
    79	  if ! [[ "$f" =~ $CODE_EXTS_RE ]] && ! is_shebang_code "$f"; then continue; fi
    80	  if should_exclude "$f"; then continue; fi
    81	  src_files+=("$f")
    82	done <<< "$CHANGED"
    83	
    84	# 沒 code → 本來就會被 pre-commit 放行,不是 bypass
    85	[[ ${#src_files[@]} -eq 0 ]] && exit 0
    86	
    87	# 有圖譜 .md 一起 commit → 正常通過 L2,不是 bypass
    88	if echo "$CHANGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
    89	  exit 0
    90	fi
    91	
    92	# ── 走到這裡 = 這筆 commit 繞過了 L2 → 留痕 ──
    93	BYPASS_LOG="$REPO_ROOT/docs/.bypass-log.jsonl"
    94	
    95	PY="$(command -v python3 || command -v python)"
    96	COMMIT_HASH="$(git rev-parse --short HEAD)" \
    97	BRANCH="$(git branch --show-current)" \
    98	SUBJECT="$(git log -1 --format=%s)" \
    99	SRC_COUNT="${#src_files[@]}" \
   100	SRC_SAMPLE="$(printf '%s\n' "${src_files[@]:0:10}")" \
   101	"$PY" - "$BYPASS_LOG" <<'PYEOF'
   102	import json, os, sys
   103	from datetime import datetime, timezone
   104	
   105	entry = {
   106	    "ts": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
   107	    "commit": os.environ["COMMIT_HASH"],
   108	    "branch": os.environ["BRANCH"],
   109	    "subject": os.environ["SUBJECT"],
   110	    "code_file_count": int(os.environ["SRC_COUNT"]),
   111	    "code_files": os.environ["SRC_SAMPLE"].splitlines(),
   112	}
   113	with open(sys.argv[1], "a", encoding="utf-8") as f:
   114	    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
   115	PYEOF
   116	
   117	{
   118	  echo ""
   119	  echo "記下了:這次 commit 有 ${#src_files[@]} 個程式碼檔沒帶筆記改動,已寫進跳過紀錄(不擋,只留痕)。"
   120	  echo "如果這次其實該補筆記,趁記憶還新鮮補上;每週可以用這個看跳過率:"
   121	  echo "   lumos gov --since 7"
   122	  echo ""
   123	} >&2
   124	
   125	exit 0
<<<install.sh>>>
     1	#!/usr/bin/env bash
     2	# install.sh — 薄殼:安裝邏輯已收進 python 單一源(scripts/lumos)。保留檔名供舊文檔/離線使用(cmd_bootstrap 已改探測 scripts/lumos,2026-07-25 F3)。
     3	# 等價於 `lumos install --force`:裝全域 lumos + user-scope skills(symlink → ~/.claude/skills/* 與 Codex 讀的 ~/.agents/skills/*)
     4	# + 兩家 hook 註冊(~/.claude/settings.json、~/.codex/hooks.json;Codex 的 hook 要你開一次互動 codex 審過才會跑)。
     5	exec python3 "$(cd "$(dirname "$0")" && pwd)/scripts/lumos" install --force "$@"
<<<get.sh>>>
     1	#!/usr/bin/env bash
     2	# get.sh — 遠端一鍵裝:clone Lumos 後整段委派 bootstrap(機器層+專案層自動接線)。
     3	# 用法:  curl -fsSL https://raw.githubusercontent.com/EnzoHsieh-Android/Lumos/release/get.sh | bash
     4	#   旗標: --pull(既有 clone 也拉最新)/--init(無 vault 的 repo 免確認建圖譜)
     5	#         curl -fsSL <url> | bash -s -- --pull --init
     6	#   環境變數:LUMOS_HOME(預設 ~/harness/lumos-toolchain)、LUMOS_URL(預設 GitHub)、
     7	#            LUMOS_BRANCH(預設 release;開發線是 main)
     8	# 站在專案 repo 內跑 → bootstrap 會問「要建成 lumos 專案嗎?」(y 才建;非互動跳過)。
     9	#
    10	# ★為什麼整段包在 main() 裡★(2026-09-07 #7):這支是拿 curl 串流進 bash 執行的。
    11	# 網路在中途斷掉時,bash 會把「已經收到的那半段」照樣跑完——裝到一半、沒有任何錯誤訊息。
    12	# 包成函式再在最後一行呼叫,就要等整份收完才會開始跑;檔案沒收完,呼叫那一行根本不存在。
    13	# 最後一行的 `; exit` 是同一個理由的第二道:確保 bash 不會再往下讀到殘留的位元組。
    14	set -euo pipefail
    15	
    16	main() {
    17	  LUMOS_HOME="${LUMOS_HOME:-$HOME/harness/lumos-toolchain}"
    18	  LUMOS_URL="${LUMOS_URL:-https://github.com/EnzoHsieh-Android/Lumos}"
    19	  LUMOS_BRANCH="${LUMOS_BRANCH:-release}"
    20	
    21	  # 迴圈解析(舊碼單點比對 $1,並帶兩旗標會無聲吃掉第二個);未知旗標 warn 忽略
    22	  ARGS=()
    23	  for a in "$@"; do
    24	    case "$a" in
    25	      --pull|--init) ARGS+=("$a") ;;
    26	      *) echo "提醒:不認得 $a 這個選項,略過(只認 --pull 和 --init)" >&2 ;;
    27	    esac
    28	  done
    29	
    30	  if [[ -f "$LUMOS_HOME/scripts/lumos" ]]; then
    31	    echo "[clone] Lumos 源已在: $LUMOS_HOME"
    32	  else
    33	    echo "[clone] clone Lumos($LUMOS_BRANCH 對外線)→ $LUMOS_HOME …"
    34	    mkdir -p "$(dirname "$LUMOS_HOME")"
    35	    # 對外線抓不到就退回預設分支:release 分支可能還沒開,冷啟動不該因此炸掉。
    36	    # 用分支不用 tag,是因為 tag 會進 detached HEAD,之後 git pull / lumos update 全部靜默停住。
    37	    if ! git clone --branch "$LUMOS_BRANCH" "$LUMOS_URL" "$LUMOS_HOME" 2>/dev/null; then
    38	      echo "  提醒:抓不到 $LUMOS_BRANCH 這條對外線(分支還沒開、或名字改了),改用預設分支。" >&2
    39	      echo "  這代表你拿到的是開發線的內容,可能還沒發布過。" >&2
    40	      git clone "$LUMOS_URL" "$LUMOS_HOME"
    41	    fi
    42	  fi
    43	
    44	  # 其餘全交 bootstrap(機器層 install+skills、專案層四分流;set -e 保錯誤傳播)
    45	  LUMOS_HOME="$LUMOS_HOME" python3 "$LUMOS_HOME/scripts/lumos" bootstrap ${ARGS[@]+"${ARGS[@]}"}
    46	
    47	  echo
    48	  echo "✓ 完成。最後一步:**重啟 Claude Code session**(hooks 在 session start 載入)"
    49	}
    50	
    51	main "$@"; exit
<<<scripts/install-hooks.sh>>>
     1	#!/usr/bin/env bash
     2	# install-hooks.sh — 薄殼:hook 安裝邏輯已收進 python 單一源(scripts/lumos 的 _install_hooks_py)。
     3	# 保留檔名供舊文檔/離線。等價於在當前 repo 跑 `lumos init --force`(會 vendor + 裝 git/Claude hooks)。
     4	set -u
     5	HERE="$(cd "$(dirname "$0")" && pwd)"
     6	exec python3 "$HERE/lumos" init --force "$@"
<<<scripts/install-graph-toolchain.sh>>>
     1	#!/usr/bin/env bash
     2	# install-graph-toolchain.sh — 薄殼:vendor/scaffold 邏輯已收進 python 單一源(scripts/lumos)。
     3	# 保留檔名供舊文檔/離線。解析既有 --target/--slug,轉呼叫 `lumos init`(在目標 repo 建圖譜 + vendor + hooks)。
     4	set -u
     5	HERE="$(cd "$(dirname "$0")" && pwd)"
     6	TARGET=""; SLUG=""
     7	while [[ $# -gt 0 ]]; do
     8	  case "$1" in
     9	    --target) TARGET="${2:-}"; shift 2 ;;
    10	    --slug)   SLUG="${2:-}"; shift 2 ;;
    11	    --no-hooks|--no-scaffold|--dry-run) shift ;;
    12	    *) shift ;;
    13	  esac
    14	done
    15	cd "${TARGET:-.}"
    16	if [[ -n "$SLUG" ]]; then
    17	  exec python3 "$HERE/lumos" init --name "$SLUG" --force
    18	else
    19	  exec python3 "$HERE/lumos" init --force "$@"
    20	fi

