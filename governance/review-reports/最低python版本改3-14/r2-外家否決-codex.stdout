 12462	_KILL_FAIL_MARKS = ("FAIL", "FAILED", "✗", "AssertionError")
 12463	# 窗內另一個測試名(常見命名:test_x / TestX / xxxTest)——見到即停掃,防「隔壁測試失敗」被算到綁定測試頭上
 12464	_KILL_OTHER_TEST_RE = re.compile(r"\b([Tt]est[_A-Za-z0-9]\w*|\w+Tests?)\b")
 12465	
