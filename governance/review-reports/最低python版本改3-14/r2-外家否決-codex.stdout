 12433	_KILL_OUT_CAP = 256 * 1024
 12434	
 12435	
 12436	def _kill_cap(txt, keep_re=None):
 12437	    """[S3 oracle品質包] 保留完整輸出供歸因(上限 256KB;超限取頭尾各半、對齊換行邊界
 12438	    並插 marker——裸位元組砍半會把兩條真實行拼成假行汙染行窗掃描)。
 12439	
 12440	    keep_re:★被砍掉的中段裡,符合這個樣式的行要留下來★(2026-09-09 代碼審 r2 f1)。
 12441	    出身:合約測試閘現在靠「測試工具自己說執行了幾支」那一行當證據,而那一行如果落在
 12442	    被砍掉的中段,一支真的跑過的測試會被誤判成「證不出跑過」而擋下推送。
 12443	    ★審查席舉的 jest 例子實測不成立★(jest 29 把覆蓋率表印在摘要之前,摘要仍是最後一行),
 12444	    所以這是防禦性修法而不是修一個已發生的 bug——但沒有它,這道閘等於押注
 12445	    「所有測試工具都把摘要印在最後」,而那是沒人驗過的假設。最多留 20 行,免得反噬成新的爆量。"""
 12446	    if len(txt) <= _KILL_OUT_CAP:
 12447	        return txt
 12448	    half = _KILL_OUT_CAP // 2
 12449	    head, tail = txt[:half], txt[-half:]
 12450	    head = head[:head.rfind("\n") + 1] if "\n" in head else head
 12451	    tail = tail[tail.find("\n") + 1:] if "\n" in tail else tail
 12452	    kept = ""
 12453	    if keep_re is not None:
 12454	        middle = txt[len(head):len(txt) - len(tail)]
 12455	        hits = [l for l in middle.splitlines() if re.search(keep_re, l)][:20]
 12456	        if hits:
 12457	            kept = "...[kept from truncated middle]...\n" + "\n".join(hits) + "\n"
 12458	    dropped = len(txt) - len(head) - len(tail)
 12459	    return head + f"...[truncated {dropped} bytes]...\n" + kept + tail
