 18596	def _anchor_repo_root(repo):
 18597	    """--repo 顯式優先;省略時 cwd 逐層向上找 .git(同 refcheck 慣例)。失敗印錯回 None。"""
 18598	    if repo is not None:
 18599	        p = Path(repo)
 18600	        if not p.is_dir():
 18601	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 18602	            return None
 18603	        return p
 18604	    for cand in (Path.cwd(), *Path.cwd().parents):
 18605	        if (cand / ".git").exists():
 18606	            return cand
 18607	    print("擋下:從目前目錄往上找不到 git repo,用 --repo 指定專案根目錄", file=sys.stderr)
 18608	    return None
