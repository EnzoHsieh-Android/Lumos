 17737	_SKELETON_RUN_CMD = {
 17738	    # 骨架裡先給一個「形狀對」的指令當起點——★重點是形狀,不是它在你機器上跑得動★。
 17739	    # xcodebuild 那條刻意寫滿三段(target/類別/方法):少寫一段會讓過濾條件對不到任何測試,
 17740	    # 而那正是 2026-09-09 在第一個 iOS 專案上抓到的假綠來源。
 17741	    # ★也刻意不帶 -quiet★(2026-09-09 r1 折入,實測):-quiet 會把「Executed N tests」那行藏起來,
 17742	    # 而那行是這道閘唯一能證明「真的跑了東西」的證據——帶了 -quiet,跑 1 支跟跑 0 支的輸出一模一樣。
 17743	    "swift-xctest": "xcodebuild test -scheme <你的 scheme> -destination 'platform=iOS Simulator,name=<模擬器名>' -only-testing:<測試 target>/<測試類別>/{method}",
 17744	    "kotlin-junit": "./gradlew test --tests '*{method}'",
 17745	    # Java 專案分 Gradle 與 Maven 兩種建置,骨架先給 Gradle 形(跟 kotlin-junit 同一條,
 17746	    # 混編專案直接沿用);Maven 專案自己換成 `mvn -Dtest='<測試類別>#{method}' test`。
 17747	    # ★本機沒裝 gradle/mvn,這兩條指令沒有實跑核對過★,只保證形狀對(要能只跑一支測試)。
 17748	    "java-junit": "./gradlew test --tests '*{method}'",
 17749	    # ★尾巴那段 runsettings 不能省★(2026-09-09 r1 折入,dotnet 9.0.117 實測):
 17750	    # 沒有它,`dotnet test --filter` 對一個根本不存在的測試名照樣印「No test matches」然後回 0,
 17751	    # 閘拿退出碼當「測試跑過」就是假綠;加上去之後同一條指令回 1,對到真測試時仍回 0。
 17752	    "csharp-xunit": "dotnet test --filter FullyQualifiedName~{method} -- RunConfiguration.TreatNoTestsAsError=true",
 17753	    "python": "python3 -m pytest -k {method}",
 17754	    # jest 沒有對應的旗標(29.x 實測:-t 對不到任何測試仍回 0,--passWithNoTests=false 也一樣)——
