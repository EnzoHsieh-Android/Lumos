   374	if [[ -z "$_AUTOLOOP_LOG" || -z "$_TESTS_LOG" ]]; then
   375	  {
   376	    echo ""
   377	    echo "擋下:建不出暫存檔,所以這次的測試沒辦法跑。"
   378	    echo "★不是測試紅了,是暫存目錄有問題★——多半是空間滿了或沒有寫入權限。"
   379	    echo ""
   380	    echo "先看一眼暫存目錄:"
   381	    echo "      df -h \"${TMPDIR:-/tmp}\" && ls -ld \"${TMPDIR:-/tmp}\""
   382	    echo ""
   383	  } >&2
   384	  exit 1
   385	fi
