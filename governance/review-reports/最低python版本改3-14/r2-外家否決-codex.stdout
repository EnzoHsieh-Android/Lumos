 32376	def cmd_bound_tests(diff_range, repo=None, as_json=False, advisory=False, from_json=None,
 32377	                    skip=False, skip_note=""):
 32378	    """跑「這次改動波及到的硬合約」綁的那些測試。
 32379	
 32380	    ★為什麼要獨立一支指令★(2026-09-07 全 repo 審視 #17,設計 [S2],r1 外家席判 blocking):
 32381	    這件事本來藏在 code-loop check 裡,而合約測試紅了會讓那支回 rc1;推送關卡把所有 rc1
 32382	    一律解讀成「高風險改動還沒審查」,叫人去跑 code-loop pass。
 32383	    ★留下審查紀錄修不好一支紅掉的測試,下次照樣被擋。★ 訊息與處置必須分流。
 32384	
 32385	    ★扁平頂層指令,不包子動詞★:這個 repo 對單一動詞的工具一律扁平,
 32386	    群組式(loop / canary / guard 那種)是留給天生有兩個以上動詞的。
 32387	
 32388	    rc:0=green 或沒東西可跑 / 1=red 或 unfilterable(且不是 advisory) / 2=參數或環境問題。
 32389	    --advisory:紅了照樣印、照樣記帳,但回 0(低風險推送用;人裁 2026-09-07)。
 32390	    unfilterable(指令回成功但證不出跑過)比照紅辦理——假綠的殺傷力跟紅一樣。
 32391	    """
 32392	    import json as _json
 32393	    root = Path(repo or ".").resolve()
 32394	    payload = _impact_payload_read(from_json) if from_json else None
 32395	    if from_json and payload is None:
 32396	        # ★失敗隔離★:讀不到那份算好的結果,不是「沒事」也不是「炸掉」——記帳放行,
 32397	        # 並且讓人看得出是這一步壞了,不要跟「真的沒東西可跑」混在一起。
 32398	        _bound_tests_log(root, "range-unavailable", [], f"讀不到已算好的波及結果:{from_json}")
 32399	        if as_json:
 32400	            print(_json.dumps({"status": "range-unavailable", "advisory": advisory,
 32401	                               "reason": f"讀不到已算好的波及結果({from_json})"}, ensure_ascii=False))
 32402	        else:
 32403	            print(f"提醒:讀不到已經算好的波及結果({from_json}),這次沒跑合約測試。", file=sys.stderr)
 32404	        return 0
 32405	    v = _bound_tests_check(root, diff_range, skip=skip, skip_note=skip_note,
 32406	                           payload=payload, advisory=advisory)
 32407	    if as_json:
 32408	        print(_json.dumps(v, ensure_ascii=False))
 32409	        return 0 if (v["status"] not in ("red", "unfilterable") or advisory) else 1
 32410	    st = v["status"]

