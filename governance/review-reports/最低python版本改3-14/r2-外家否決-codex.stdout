 17809	def _profile_stack_mismatch(root):
 17810	    """設定的技術棧跟 repo 裡實際的程式碼對不對得上(消費專案接入靜默失效 [B]/S2)。
 17811	
 17812	    ★只看實際副檔名,不看值是預設還是設定檔寫的★——寫成「跟預設不符」的話,
 17813	    init 產出的骨架一寫進去值就不是預設了,猜錯也永遠不會出聲(r1 外家備援席 f2)。
 17814	    回一串人話;對得上回空 list。"""
 17815	    if not root:
 17816	        return []   # vault 不在 git repo 底下(測試 fixture、--vault 指到別處):沒有 repo 可比,靜默跳過
 17817	    root = Path(root)
 17818	    counts = _stack_ext_counts(root)
 17819	    if not counts:
 17820	        return []
 17821	    test_msgs, sym_msgs = [], []
 17822	    try:
 17823	        pdata = load_platforms(root)
 17824	    except Exception:
 17825	        pdata = {"multiplatform": False, "platforms": {}}
 17826	    if pdata.get("multiplatform"):
 17827	        covered = set()
 17828	        for pe in pdata["platforms"].values():
 17829	            # ★"profile" 存的是攤開後的 profile 物件,不是名字★(2026-09-10 修):
 17830	            # 拿它去 TEST_PROFILES 查表 = 用 dict 當 key,直接丟 TypeError 把整支 doctor
 17831	            # 中斷在這一段。名字要用的話在隔壁的 "profile_name"。
 17832	            _pe_prof = pe.get("profile")
 17833	            if not isinstance(_pe_prof, dict):
 17834	                _pe_prof = TEST_PROFILES.get(_pe_prof) or {}
 17835	            covered |= set(_pe_prof.get("exts") or [])
 17836	    else:
 17837	        covered = set(load_test_profile(root).get("exts") or [])
 17838	    # 只唸「數量夠多、卻沒有任何平台的測試 profile 認得」的副檔名(散落幾個檔不算)。
 17839	    # ★門檻不只看絕對數量,也看它佔不佔份量★:本 repo 實測——它是 Python 專案,
 17840	    # 但安裝腳本有 4 個 .ps1,只用「≥3 個」的話會唸一句「你的測試設定掃不到這些 .ps1」,
 17841	    # 而那裡面根本沒有測試。改成「還要不少於最大宗的四分之一」就只剩真的那幾條。
 17842	    _top = max(counts.values())
 17843	    _floor = max(3, _top / 4)
 17844	    for ext, n in sorted(counts.items(), key=lambda kv: -kv[1]):
 17845	        if n >= _floor and ext not in covered:
 17846	            test_msgs.append(f"專案裡有 {n} 個 {ext} 檔,但測試設定認的是 {sorted(covered) or '(預設 C#)'}——掃不到這些檔裡的測試")
 17847	    sym, _neg = load_symbol_profile(root)
 17848	    sym_ordered = list(sym.get("code_exts") or [])
 17849	    sym_exts = set(sym_ordered)
 17850	    # ★主要副檔名一個都沒有=這個設定八成不是為這個 repo 挑的★(r2 f4):
 17851	    # 每個符號 profile 的清單第一個副檔名是它的本命(csharp→.cs、swift→.swift…),
 17852	    # 後面那些是「這種店裡也會有的檔」(csharp 收了 .vue/.sql/.ps1)。所以一個 Vue 專案
 17853	    # 反查會得到 csharp——值合法、上面兩組都不唸,因為 .vue 確實在 csharp 清單裡。
 17854	    # 這一條專門補那個洞:本命副檔名掛零就出聲。
 17855	    if sym_ordered and counts.get(sym_ordered[0], 0) == 0:
 17856	        sym_msgs.append(f"符號設定認的本命副檔名是 {sym_ordered[0]},但這個專案一個 {sym_ordered[0]} 檔都沒有"
 17857	                        f"(它還認 {sorted(sym_exts - {sym_ordered[0]})},所以不會被上面那條唸到)"
 17858	                        "——這個設定八成不是為這個專案挑的")
 17859	    for ext, n in sorted(counts.items(), key=lambda kv: -kv[1]):
 17860	        if n >= _floor and ext not in sym_exts:
 17861	            sym_msgs.append(f"專案裡有 {n} 個 {ext} 檔,但 symbol_profile 認的是 {sorted(sym_exts)}——筆記提到的符號在這些檔裡查不到也不會報")
 17862	    # ★兩組各自留額度,截斷要說實話★(r1 單reviewer f3,實測):
 17863	    # 舊寫法是兩組接成一串再 out[:8],而測試那組永遠排在前面——symbol_profile 那整類
 17864	    # 在副檔名一多的專案會被整批吃掉,而且標頭照印「有 8 項」,看不出還有沒講的。
 17865	    # ★跟健檢的 _soft_list 是同一個 idiom,故意沒抽成共用函式★(r2 架構席 f3):
 17866	    # 那支定義在 run_doctor 內部、吃單一 list、直接印出去回 None,裝不下「兩組各留額度、
 17867	    # 回傳 list 給呼叫端」;為了這五行去改它會動到十個既有呼叫點。文案對齊成同一種說法
 17868	    # (「… 還有 N 條」),以後改動任一邊請回頭看另一邊——scripts/lumos 的 _soft_list。
 17869	    cap, out = 4, []
 17870	    for group in (test_msgs, sym_msgs):
 17871	        out.extend(group[:cap])
 17872	        if len(group) > cap:
 17873	            out.append(f"… 還有 {len(group) - cap} 條(同一類)")
 17874	    return out
 17875	
