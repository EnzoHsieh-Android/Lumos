 18038	def _sync_global_hooks(src_repo: Path, harness: str) -> str:
 18039	    """全域 hooks/註冊同步(不需專案;install 與 _install_hooks_py 共用)。harness=claude|codex:
 18040	    claude → ~/.claude/hooks + settings.json;codex → ~/.codex/hooks + hooks.json(合併器 --target codex)。
 18041	    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)④codex 專用:寫自訂審查席 TOML(d6)。
 18042	    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);HOME 隔離可測。
 18043	    回三態字串:ok / probe(探針擋下,沒動) / merge-failed(hooks 設定檔壞或合併器非 0,hook 檔已 copy 但註冊沒更新)
 18044	    / absent(codex 專用:本機無 codex,跳過)。★不共用一顆布林★——False 曾被呼叫端寫死解讀成 LUMOS_PROBE,
 18045	    設定檔壞掉會印出誤導訊息(Projects/Codex完全支援_計劃 r2 邊界 N2)。"""
 18046	    # ★r1 正確性席:同 _install_skills——cmd_init/_vendor_toolchain 這條路會經此覆寫真的 ~/.claude/hooks
 18047	    # 與動 settings.json,繞過四個指令入口的守衛。擋在變動原語。
 18048	    if _refuse_if_probe(f"sync-global-{harness}"):
 18049	        return "probe"
 18050	    if harness == "codex":
 18051	        _ch = _codex_home()
 18052	        if _ch.exists() and not _ch.is_dir():   # r1 單reviewer F1:~/.codex 是檔案,mkdir 會炸穿整支 install
 18053	            return "home-not-dir"
 18054	        if not _codex_present():
 18055	            return "absent"
 18056	    import subprocess, shutil
 18057	    hdir, _ = _HARNESS_HOME[harness]
 18058	    chooks = (_codex_home() if harness == "codex" else Path.home() / hdir) / "hooks"
 18059	    chooks.mkdir(parents=True, exist_ok=True)
 18060	    src_dir = src_repo / "scripts" / "hooks" / "claude"
 18061	    for f in _GLOBAL_HOOKS:                   # ① 現役 hooks copy(兩家同一批檔)
 18062	        s = src_dir / f
 18063	        if s.exists():
 18064	            shutil.copy2(s, chooks / f)
 18065	    for f in _RETIRED_STUB_CLAUDE_HOOKS:      # ②a 相容期:換 exit 0 空殼,★不刪檔★
 18066	        stub = chooks / f                     #     (刪了會炸掉還帶著舊註冊的 session)
 18067	        if stub.is_symlink():
 18068	            stub.unlink()                     #     symlink 先拆,免得寫穿到來源檔
 18069	        stub.write_text(_RETIRED_HOOK_STUB_BODY, encoding="utf-8")
 18070	        stub.chmod(0o755)
 18071	    for f in _RETIRED_CLAUDE_HOOKS:           # ②b 過了相容期:真刪殘留檔
 18072	        stale = chooks / f
 18073	        if stale.exists() or stale.is_symlink():
 18074	            stale.unlink()
 18075	    merge = src_repo / "scripts" / "merge-claude-settings.py"  # ③ merge+prune 懸空(含②剛變懸空的)
 18076	    if merge.exists():
 18077	        args = [sys.executable, str(merge)] + (["--target", "codex"] if harness == "codex" else [])
 18078	        r = subprocess.run(args)
 18079	        if r.returncode != 0:              # 合併器只在設定檔 JSON 壞時回 1:別當成功
 18080	            return "merge-failed"
 18081	    if harness == "codex":                 # ④ 自訂審查席 TOML(d6)——刻意放在合併器之後:設定檔壞掉(merge-failed)就整個 Codex 側不算裝好,
 18082	                                           #    TOML 不寫、下次 install --force 再補;hook 檔 copy 在前面已做(自癒無害)(code-codex-d6 r1 單reviewer F3)
 18083	        st = _install_codex_agent()
 18084	        if st == "created":
 18085	            print(f"  ✓ Codex 自訂審查席已寫三份:")
 18086	            print(f"      {_CODEX_AGENT_NAME:<22} 散文審(設計審),{_CODEX_SEAT_MODEL} + medium —— 也是預設")
 18087	            print(f"      {_CODEX_AGENT_CODE_NAME:<22} 程式碼審(一般風險),{_CODEX_SEAT_MODEL} + xhigh")
 18088	            print(f"      {_CODEX_AGENT_MAX_NAME:<22} 程式碼審(高風險),{_CODEX_SEAT_MODEL} + xhigh")
 18089	            print(f"    派工詞點名哪一個就用哪一個;0.153.2 實測選得中、0.144.1 忽略;唯讀仍靠父代理 --sandbox read-only")
 18090	    return "ok"
