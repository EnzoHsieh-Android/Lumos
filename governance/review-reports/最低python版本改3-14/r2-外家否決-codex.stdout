 32088	def _run_bound_tests(repo_root, items, tails=None):
 32089	    """逐 (platform, method) 真跑;去重鍵=解析後完整指令。回 results[(node, plat, method, verdict, detail, secs)]。
 32090	    tails 給一個 dict 就順便填 (node, plat, method) → 輸出尾巴(規格閘拿去讀「篩到幾支」;不給不填,回傳形狀不變)。
 32091	
 32092	    verdict ∈ green / red / unproven。unproven=「指令回成功,但它自己的輸出裡看不到有跑過任何測試」
 32093	    ——那不是紅(測試沒失敗),但也絕對不是綠。"""
 32094	    import shlex as _shlex, os as _os
 32095	    try:
 32096	        pdata = load_platforms(repo_root)
 32097	    except ValueError as e:
 32098	        return None, f"config platforms 壞: {e}"
 32099	    plats = pdata["platforms"]
 32100	    per_test = float(_os.environ.get("LUMOS_TEST_TIMEOUT", "180") or 0) or None   # 同 runner 變數;0=不限
 32101	    results, seen = [], {}
 32102	    for node, plat, method, status in items:
 32103	        if status != "real":
 32104	            results.append((node, plat, method, "red", {"dangling": "綁的測試在程式碼裡找不到(懸空)",
 32105	                                                       "fake": "綁的名字不是真的測試方法(偽證據)",
 32106	                                                       "bad-name": "測試名不合法或平台前綴未定義"}[status], 0.0))
 32107	            continue
 32108	        pentry = plats.get(plat) or {}
 32109	        run_cmd = pentry.get("run_cmd")
 32110	        if not run_cmd:
 32111	            # ★記成「沒跑」、繼續跑別的平台★(Issues/多平台設定下測試指令被默默略過,2026-09-11):
 32112	            # 原本碰到第一支沒指令的就整批 return no-config——其他平台有指令的也不跑,連前面已判的懸空紅也被吞掉。
 32113	            results.append((node, plat, method, "no-cmd", f"平台 {plat} 沒設測試指令", 0.0))
 32114	            continue
 32115	        whole = "{method}" not in run_cmd
 32116	        cmd = run_cmd if whole else run_cmd.replace("{method}", _shlex.quote(method))
 32117	        root = str(pentry.get("root") or repo_root)
 32118	        key = (root, cmd)
 32119	        if key in seen:
 32120	            rc, tail, secs, to = seen[key]
 32121	        else:
 32122	            timeout = max(_BOUND_TESTS_WHOLE_SUITE_TIMEOUT, per_test or 0) if whole else per_test
 32123	            rc, tail, secs, to = _kill_run(cmd, root, timeout if timeout else 10 ** 6,
 32124	                                           keep_re=_ran_evidence_re(pentry.get("profile_name")))
 32125	            seen[key] = (rc, tail, secs, to)
 32126	        if tails is not None:
 32127	            tails[(node, plat, method)] = tail
 32128	        if to:
 32129	            results.append((node, plat, method, "red", f"超時(>{int(timeout)}s)", secs))
 32130	        elif rc != 0:
 32131	            results.append((node, plat, method, "red", f"rc={rc} {tail[-120:].strip()}", secs))
 32132	        else:
 32133	            # ★回成功不等於跑過★(消費專案接入靜默失效 [F]/[S7],2026-09-09 r1 折入)。
 32134	            # ★整套跑也要驗★(r2 f5):第一版跳過整套跑那條路,理由是「沒有『只跑這一支』可言」。
 32135	            # 那個理由只擋得住「過濾條件對不到」這一種,擋不住「整套跑但一支都沒執行」
 32136	            # ——審查席用一支「印 SKIPPED 然後 exit 0」的假執行器實測到現制照樣報綠。
 32137	            # ★誠實邊界★:整套跑時這一層只證得出「有測試跑過」,證不出「你綁的那一支跑過」
 32138	            # (輸出裡的 N 支可能全是別的測試)。那是整套跑這種形態自帶的天花板,不是這裡的實作缺陷。
 32139	            ran, fix = _ran_evidence_check(pentry.get("profile_name"), tail)
 32140	            if ran is False:
 32290	    if red:
 32291	        # ★advisory 與擋要分帳★(設計 [S6]):兩者的後果完全不同,混成一個 kind
 32292	        # 就回答不了「只提醒到底夠不夠」——而那正是人裁時掛的回頭條件要問的事。
 32293	        kind = "red-advisory" if advisory else "red-blocked"
 32294	        _bound_tests_log(repo_root, kind, sorted({r[0] for r in red}),
 32295	                         f"{len(red)} 紅/{len(results)}", secs=secs, calc_secs=_calc)
 32296	        return {"status": "red", "ran": ran, "red": red, "secs": secs, "calc_secs": _calc,
 32297	                "advisory": advisory, "not_run": _not_run, "not_run_reason": _nr_reason,
 32298	                "reason": "受波及合約的測試沒過:" + ";".join(f"{n} [{m}] {d}" for n, p, m, d in red[:6]) + _nc_note}
 32299	    # ★報綠之前先確認那個綠是真的★(消費專案接入靜默失效 [F]/[S7])。
 32300	    # 兩層證據,先強後弱:
 32301	    #   ① 逐支看「跑過的證據」——_run_bound_tests 已經對有實測輸出樣式的 profile 驗過,
 32302	    #      驗不過的那幾支在上面被標成 unproven。這一層抓得到「合約 [test:] 名字打錯一個字」。
 32303	    #   ② 沒有輸出樣式可比對的 profile,退回過濾能力冒煙測試(拿不存在的測試名跑一次)。
 32304	    #      這層只答得出「這個指令認不認得出完全不存在的名字」,精準度證不了。
 32305	    _bad = ["這一支跑完回成功,但它自己的輸出裡看不到有跑過任何測試(%s [%s])。%s"
 32306	            % (n, m, d or "") for n, p, m, d in unproven[:3]]
 32307	    try:
 32308	        _pd = load_platforms(repo_root)
 32309	        _pairs = set()
 32310	        for _n, _plat, _m, _v, _d, _sc in results:
 32311	            if _v != "green":
 32312	                continue
 32313	            _pe = (_pd["platforms"].get(_plat) or {})
 32314	            if _RAN_EVIDENCE.get(_pe.get("profile_name") or ""):
 32315	                continue   # 這個 profile 走上面那層,不必再付一次冒煙測試的時間
 32316	            _rc_cmd = _pe.get("run_cmd")
 32317	            if _rc_cmd:
 32318	                _pairs.add((str(_pe.get("root") or repo_root), _rc_cmd))
 32319	        for _root, _cmd in sorted(_pairs):
 32320	            _ok, _why = _bound_tests_filter_probe(_root, _cmd)
 32321	            if not _ok:
 32322	                _bad.append(_why)
 32323	    except Exception as _e:   # 冒煙測試自己壞掉不能反過來擋人:記帳、照原判定走
 32324	        _gate_failopen(repo_root, "bound-tests", f"過濾能力冒煙測試例外:{str(_e)[:100]}")
 32325	    if _bad:
 32326	        _bound_tests_log(repo_root, "unfilterable", sorted({r[0] for r in results}),
 32327	                         "證不出測試真的跑過,綠不可信", secs=secs, calc_secs=_calc)
 32328	        return {"status": "unfilterable", "ran": 0, "red": [], "secs": secs, "calc_secs": _calc,
 32329	                "advisory": advisory, "not_run": _not_run, "not_run_reason": _nr_reason,
 32330	                "reason": "無法確認測試真的跑過:" + _bad[0] + _nc_note}
 32331	    # ★耗時存成獨立欄位★(設計 [S6]):以前塞在自由文字的備註裡(「46 綠 41.8s」),
 32332	    # 回頭條件量不到;而且那個秒數只算跑測試那段,不含前面算波及的時間。分開存。
 32333	    _bound_tests_log(repo_root, "green", sorted({r[0] for r in results}),
 32334	                     f"{ran} 綠", secs=secs, calc_secs=_calc)
 32335	    return {"status": "green", "ran": ran, "red": [], "secs": secs, "calc_secs": _calc,
 32336	            "advisory": advisory, "not_run": _not_run, "not_run_reason": _nr_reason,
 32337	            "reason": f"受波及合約測試 {ran} 支全綠(跑 {secs}s、算 {_calc}s)" + _nc_note}
