 17904	def _init_config_skeleton(root):
 17905	    """init 產出 .lumos/config.json 骨架(消費專案接入靜默失效 [A]/S1)。
 17906	
 17907	    為什麼要產:不產的話 test_profile 與 symbol_profile 各自退回 csharp 預設,
 17908	    非 C# 專案第一天起兩個關鍵設定都錯而且★沒有任何提示★——2026-09-09 第一個 iOS 專案實地踩到。
 17909	    既有設定一律不覆寫;猜到的棧一律標「推測」不當斷言;多語言走既有 platforms 多根多 profile 格式。"""
 17910	    import json as _j
 17911	    cfg_path = Path(root) / ".lumos" / "config.json"
 17912	    if cfg_path.exists():
 17913	        return   # 既有設定不碰
 17914	    guess = _stack_guess()
 17915	    counts = _stack_ext_counts(root)
 17916	    ranked = sorted(counts.items(), key=lambda kv: -kv[1])
 17917	    # ★不能寫 // 註解★:這是要被 json.loads 讀的檔,加註解會讓整份設定解析失敗、退回預設,
 17918	    # 反而製造出這批要解的那種靜默。說明一律走 JSON 欄位。
 17919	    note = ("這份是 lumos init 產出的骨架,裡面的技術棧是用副檔名推測的——請開檔確認。"
 17920	            "猜錯的話兩件事會靜默失效:掃不到你的測試(合約綁不上)、符號檢查對你的程式碼視而不見。"
 17921	            "確認完可以把這個 _請先確認 欄位刪掉。")
 17922	    blank = {"_說明": "偵測不到已知的技術棧。填 test_profile(可選:%s)與 symbol_profile(可選:%s),並把 run_cmd 改成你專案跑單一測試的指令(必須帶 {method} 佔位符,而且對不存在的測試名要回非零或在輸出裡數得出跑了幾支)" % ("/".join(sorted(TEST_PROFILES)), "/".join(sorted(SYMBOL_PROFILES))),
 17923	             "test_profile": "", "symbol_profile": "", "test": {"run_cmd": ""}}
 17924	    if not ranked:
 17925	        body = blank
 17926	    elif len(ranked) == 1 or ranked[0][1] > sum(c for _, c in ranked[1:]) * 3:
 17927	        ext = ranked[0][0]
 17928	        g = guess[ext]
 17929	        tp, sp, human = g["test"], g["symbol"], g["human"]
 17930	        body = {"_推測": f"看到 {counts[ext]} 個 {ext} 檔,猜這是 {human} 專案——不對就改",
 17931	                "test_profile": tp, "symbol_profile": sp,
 17932	                "test": {"run_cmd": _SKELETON_RUN_CMD.get(tp, "")}}
 17933	        if not tp or not sp:
 17934	            body["_請自己填"] = ("這個副檔名在正典表裡只被其中一種 profile 認領,另一個留空給你填:"
 17935	                                f"test_profile 可選 {'/'.join(sorted(TEST_PROFILES))};"
 17936	                                f"symbol_profile 可選 {'/'.join(sorted(SYMBOL_PROFILES))}")
 17937	        if g["symbol_weak"]:
 17938	            body["_這個猜得很弱"] = (f"symbol_profile 猜成 {sp},只是因為 {sp} 的副檔名清單裡碰巧收了 {ext}"
 17939	                                    f"——那不代表這是 {sp} 專案。符號檢查會用 {sp} 的清單去找筆記提到的符號,"
 17940	                                    "對不上就整批查不到也不會報。請自己確認,可選:"
 17941	                                    f"{'/'.join(sorted(SYMBOL_PROFILES))}")
 17942	    else:
 17943	        plats = {}
 17944	        # ★每一種偵測得到的語言都要列出來,不能只取前幾名★(2026-09-12 多語言驗證 repo 實撞):
 17945	        # 原本是 ranked[:3],一個九種語言的 repo 只會產出三個平台,其餘六種的測試從此掃不到——
 17946	        # 而掃不到的症狀不是報錯,是合約綁不上、閘靜默放行。多列一個平台的代價只是使用者刪一段設定,
 17947	        # 少列一個的代價是那個語言的守衛整批不存在,兩邊不對等。
 17948	        for ext, n in ranked:
 17949	            g = guess[ext]
 17950	            tp, sp, human = g["test"], g["symbol"], g["human"]
 17951	            if not tp:
 17952	                continue
 17953	            plats.setdefault(tp.split("-")[0], {"profile": tp, "root": ".", "run_cmd": _SKELETON_RUN_CMD.get(tp, ""),
 17954	                                                "_推測": f"看到 {n} 個 {ext} 檔({human})"})
 17955	        if not plats:
 17956	            body = blank
 17957	        else:
 17958	            body = {"_推測": "看到多種語言,用多平台格式(每個平台各自的 root/profile/run_cmd)——請確認並把 root 改成各平台真正的目錄;偵測得到的語言全部列出來了,不需要的平台整段刪掉就好",
 17959	                    "default_platform": next(iter(plats)), "platforms": plats,
 17960	                    "symbol_profile": guess[ranked[0][0]]["symbol"]}
 17961	    cfg_path.parent.mkdir(parents=True, exist_ok=True)
 17962	    body = {"_請先確認": note, **body}
 17963	    _write_lf(cfg_path, _j.dumps(body, ensure_ascii=False, indent=2) + "\n")
 17964	    print(f"  ✓ 設定骨架 {cfg_path}(★技術棧是推測的,請開檔確認★——猜錯會讓測試掃描與符號檢查靜默失效)")
