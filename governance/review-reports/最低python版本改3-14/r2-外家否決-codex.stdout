 12399	def _kill_run(cmd, cwd, timeout, keep_re=None):
 12400	    """跑 run_cmd(shell,killpg 沿 lint 先例)。回 (rc, tail200, elapsed, timed_out)。
 12401	
 12402	    keep_re 直接轉給 _kill_cap:輸出超過上限而要截斷時,符合這個樣式的行不得被砍掉
 12403	    (合約測試閘拿它保住「執行了 N 支」那一行;見 _kill_cap)。回傳形狀不變。"""
 12404	    import os
 12405	    import signal
 12406	    import subprocess
 12407	    import tempfile
 12408	    import time
 12409	    t0 = time.time()
 12410	    with tempfile.TemporaryFile(mode="w+", encoding="utf-8", errors="replace") as buf:
 12411	        proc = subprocess.Popen(cmd, shell=True, cwd=str(cwd), start_new_session=True,
 12412	                                stdout=buf, stderr=subprocess.STDOUT)
 12413	        try:
 12414	            proc.communicate(timeout=timeout)
 12415	        except subprocess.TimeoutExpired:
 12416	            try:
 12417	                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
 12418	            except (ProcessLookupError, OSError, AttributeError):
 12419	                # AttributeError=Windows 無 killpg/SIGKILL → 退回殺直接子程序
 12420	                try:
 12421	                    proc.kill()
 12422	                except OSError:
 12423	                    pass
 12424	            proc.wait()
 12425	            buf.seek(0)
 12426	            txt = buf.read()
 12427	            return (None, _kill_cap(txt, keep_re), time.time() - t0, True)
 12428	        buf.seek(0)
 12429	        txt = buf.read()
 12430	    return (proc.returncode, _kill_cap(txt, keep_re), time.time() - t0, False)
