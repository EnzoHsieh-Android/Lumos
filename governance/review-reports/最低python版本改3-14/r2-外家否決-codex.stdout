   395	  [[ "$_SUITE_LIGHT" -eq 1 && "$_AUTOLOOP_FULL" -eq 1 ]] && _AUTOLOOP_ARGS=()
   396	fi
   397	if [[ -d "$REPO_ROOT/skills/lumos-project-notes" && -f "$REPO_ROOT/scripts/test_autonomous_loop.py" ]]; then
   398	  # 支數從實際輸出讀,不寫死——寫死的會靜靜地漂(2026-09-08:實際 144,訊息還印著 132)
   399	  _autoloop_count() { sed -n 's/^Ran \([0-9]*\) tests.*/\1/p' "$_AUTOLOOP_LOG" | tail -1; }
   400	  if ! "$PY" "$REPO_ROOT/scripts/test_autonomous_loop.py" ${_AUTOLOOP_ARGS+"${_AUTOLOOP_ARGS[@]}"} >"$_AUTOLOOP_LOG" 2>&1; then
   401	    _AUTOLOOP_N="$(_autoloop_count)"
   402	    {
   403	      echo ""
   404	      echo "擋下:test_autonomous_loop.py 有紅(自主迴圈那${_AUTOLOOP_N:+ $_AUTOLOOP_N }支)。"
   405	      echo "完整輸出在這裡:"
   406	      echo "   $_AUTOLOOP_LOG"
   407	      tail -15 "$_AUTOLOOP_LOG" | sed 's/^/    /'
   408	      echo ""
   409	      echo "兩條路選一條:"
   410	      echo "  1. 修到全綠再推(正常做法)。"
   411	      echo "  2. 確定是測試本身不穩或環境問題 → git push --no-verify(後果自負;CI 還是會再跑一次)"
   412	      echo ""
   413	    } >&2
   414	    exit 1
   415	  fi
   416	  _AUTOLOOP_N="$(_autoloop_count)"
   417	  echo "  ✓ 自主迴圈那${_AUTOLOOP_N:+ $_AUTOLOOP_N }支也綠" >&2
   418	fi
   419	
   420	# 測試套件閘(僅 Lumos 源 repo;2026-07-07):紅測試兩度溜進 main(pre-push 原只跑 doctor 不跑測試)。
   421	# 事件點修法:push 前全量跑一次(2026-09-06 實測約 8 分鐘、3700+ 案例;「~32s」是 2026-07-07、183 支測試時代的舊數字)。消費專案不跑——skills/ 只存在於源 repo(不 vendor),
   422	# 消費端自己的測試歸自己的 CI/hooks 管,lumos 不越俎。逃生:git push --no-verify(自負)。
   423	if [[ -d "$REPO_ROOT/skills/lumos-project-notes" && -f "$REPO_ROOT/scripts/test_lumos.py" ]]; then
   424	  # ★分片並行★(2026-09-06 全 repo 審視 #12):全套串行約 8 分鐘,大部分時間在等子進程
   425	  # 而不是吃 CPU,所以切成幾片同時跑很划算。實測四片牆鐘 271 秒(對照串行 480 秒,省 43%
   426	  # ——不是四倍,因為瓶頸是 IO 不是 CPU)。片數可用 LUMOS_TEST_SHARDS 調;設 1 就是串行。
   427	  _shards="${LUMOS_TEST_SHARDS:-4}"
   428	  # 不是正整數就串行(r2 邊界席 blocker:給 abc 會讓 seq 一片都不起,零測試回綠)
   429	  [[ "$_shards" =~ ^[0-9]+$ && "$_shards" -ge 1 ]] || _shards=1
   430	  # ★先探這支 runner 支不支援分片★:新 hook 配到舊的(或別人自己寫的)runner 時,
   431	  # 硬塞它不認得的旗標會讓它整個報錯 → 人被莫名其妙擋下。探不到就乖乖退回串行,
   432	  # 行為跟以前一模一樣。(2026-09-06 實際踩到:假 runner 不認得新旗標,當場被判紅。)
   433	  #
   434	  # ★探測不能用「跑 --help 看輸出」★(r1 外家席抓到):舊版 runner 正是「不認得的參數
   435	  # 就靜默丟掉」,所以餵它 --help 等於什麼都沒帶——**它會直接跑滿八分鐘的全套**,
   436	  # 探測完再串行跑一次,一次推送變十六分鐘。改成直接讀檔找旗標字樣:不執行、瞬間完成,
   437	  # 而且對「會把 --help 當成沒帶參數」的舊 runner 一樣有效。
   438	  if ! grep -q -- '"--shard"' "$REPO_ROOT/scripts/test_lumos.py" 2>/dev/null; then
   439	    _shards=1
   440	  fi
   441	  # 純文件 / light 只跑子集(2026-09-18):runner 認得 --suite 才走;每個 ref 都不是全套才算。
   442	  # 探法同上:讀檔找旗標字樣,不執行。
   443	  _suite_mode="full"
   444	  if [[ "$_SUITE_SEEN" -eq 1 && "$_SUITE_FULL" -eq 0 ]] && grep -q -- '"--suite"' "$REPO_ROOT/scripts/test_lumos.py" 2>/dev/null; then
   445	    _suite_mode="docs"; [[ "$_SUITE_LIGHT" -eq 1 ]] && _suite_mode="light"
   446	  fi
   447	  _suite_args=(); _suite_word="全部測試"
   448	  if [[ "$_suite_mode" != "full" ]]; then
   449	    _suite_args=(--suite docs)
   450	    _suite_word="文件子集(這次沒改到程式、或改動判成 light,不跑全套)"
   451	    # 碰到圖譜筆記:加跑讀真圖譜的測試(檢索品質、評測)。執行器不認得 --graph(舊版)就退全套——跟上面探 --suite/--shard
   452	    # 同一個理由:硬塞不認得的旗標,執行器會整個報錯,被判成「測試有紅」(r2 通才席實測重現)
   453	    if [[ "$_SUITE_GRAPH" -eq 1 ]]; then
   454	      if grep -q -- '"--graph"' "$REPO_ROOT/scripts/test_lumos.py" 2>/dev/null; then
   455	        _suite_args+=(--graph)
   456	      else
   457	        _suite_mode="full"; _suite_args=(); _suite_word="全部測試"
   458	      fi
   459	    fi
   460	  fi
   461	  # light 的關鍵字子集跟文件子集一起分片、平行跑(r1 併發席:原本等分片收完才串行跑一趟);
   462	  # 一支都沒對到(每片都 rc3)不擋,只把話講清楚:CI 會跑全套當後盾。有紅照擋。
   463	  _keys_args=()
   464	  if [[ "$_suite_mode" == "light" && -n "$_SUITE_KEYS" ]]; then
   465	    _keys_args=(--suite keys --keys "$_SUITE_KEYS")
   466	  elif [[ "$_suite_mode" == "light" ]]; then
   467	    echo "  這次改動抽不出函式或檔名當關鍵字,推送前只跑文件子集;CI 會跑全套當後盾。" >&2
   468	  fi
   469	  _sdir="$_PP_TMP/shards"; mkdir -p "$_sdir"
   470	  _rc=0; _krc_all3=1
   471	  run_group() {   # $1=log 前綴,其餘=執行器參數;每片一個子行程,回傳 0=全綠、3=每片都選中 0 支、1=有紅
   472	    local _pfx="$1"; shift
   473	    local _pids=() _i _p _r _any3=0 _bad=0
   474	    for _i in $(seq 1 "$_shards"); do
   475	      if [[ "$_shards" -le 1 ]]; then
   476	        "$PY" "$REPO_ROOT/scripts/test_lumos.py" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
   477	      else
   478	        # 這條路不帶 --json-summary:判紅靠子行程離開碼、列紅的靠 log,摘要檔寫了沒人讀
   479	        # 就是白工(r1 通才席抓到)。那個旗標留著給要機讀的人用,不是給這裡用的。
   480	        "$PY" "$REPO_ROOT/scripts/test_lumos.py" --shard "$_i/$_shards" "$@" > "$_sdir/$_pfx$_i.log" 2>&1 &
   481	      fi
   482	      _pids+=($!)
   483	    done
   484	    # ★用每個子行程自己的離開碼判★,不是用有沒有寫出摘要檔判——摘要檔是給人看的加值,
   485	    # 拿它當判準等於「runner 不支援新旗標就一律紅」。
   486	    for _p in "${_pids[@]}"; do _r=0; wait "$_p" || _r=$?; [[ "$_r" -eq 3 ]] && _any3=1; [[ "$_r" -ne 0 && "$_r" -ne 3 ]] && _bad=1; done
   487	    [[ "$_bad" -eq 1 ]] && return 1
   488	    [[ "$_any3" -eq 1 ]] && return 3
   489	    return 0
   490	  }
   491	  if [[ "$_suite_mode" != "full" ]]; then
   492	    echo "推送前先跑$_suite_word(切成 $_shards 片同時跑;嫌久可 --no-verify,CI 會兜底)…" >&2
   493	  elif [[ "$_shards" -le 1 ]]; then
   494	    echo "推送前先跑全部測試(約 8 分鐘;嫌久可 --no-verify,CI 會兜底)…" >&2
   495	  else
   496	    echo "推送前先跑全部測試(切成 $_shards 片同時跑,約 4-5 分鐘;嫌久可 --no-verify,CI 會兜底)…" >&2
   497	  fi
   498	  # 兩組真的同時跑(2026-09-18 實測:原本 keys 那組等文件子集跑完才開始,註解卻寫「平行」)
   499	  _grc=0; _krc=0
   500	  ( run_group s ${_suite_args+"${_suite_args[@]}"} ) & _gpid=$!
   501	  if [[ ${#_keys_args[@]} -gt 0 ]]; then
   502	    ( run_group k "${_keys_args[@]}" ) & _kpid=$!
   503	    wait "$_kpid" || _krc=$?
   504	  fi
   505	  wait "$_gpid" || _grc=$?
   506	  [[ "$_grc" -ne 0 ]] && _rc=1      # 文件子集/全套選中 0 支也算紅(執行器那邊本來就這樣判)
   507	  if [[ ${#_keys_args[@]} -gt 0 ]]; then
   508	    if [[ "$_krc" -eq 3 ]]; then
   509	      echo "  沒有測試提到這次改到的函式或檔名($_SUITE_KEYS),推送前只跑了文件子集;CI 會跑全套當後盾。" >&2
   510	    elif [[ "$_krc" -ne 0 ]]; then
   511	      _rc=1
   512	    fi
   513	  fi
   514	  cat "$_sdir"/*.log > "$_TESTS_LOG" 2>/dev/null || true
   515	  if [[ $_rc -ne 0 ]]; then
   516	    {
   517	      echo ""
   518	      echo "擋下:test_lumos.py 有紅,有測試沒過。"
   519	      echo "紅的是這幾支:"
   520	      grep -h "✗ " "$_TESTS_LOG" | head -20 | sed 's/^/    /'
   521	      echo ""
   522	      echo "完整輸出(所有分片接在一起)在這裡:"
   523	      echo "   $_TESTS_LOG"
   524	      echo ""
   525	      echo "兩條路選一條:"
   526	      echo "  1. 修到全綠再推。只重跑紅的那幾支:"
   527	      echo "       python3 scripts/test_lumos.py --ff -x"
   528	      echo "  2. 確定是測試本身不穩或環境問題 → git push --no-verify(後果自負;CI 還是會再跑一次)"
   529	      echo ""
   530	    } >&2
   531	    exit 1
   532	  fi
   533	  # 各片印一行「N passed, M failed」,用 awk 加總成一行(維持薄殼:不在 hook 裡塞 python)
   534	  grep -h "passed," "$_TESTS_LOG" \
   535	    | awk -F'[ ,]+' '{p+=$1; f+=$3} END{if (NR) printf "  全部 %d 條斷言過、%d 條紅(%d 片加總)\n", p, f, NR}' >&2 || true
   536	fi
   537	
   538	exit 0

