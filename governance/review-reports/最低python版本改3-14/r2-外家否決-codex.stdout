   100	    if TARGET == "codex":
   101	        # 絕對路徑(不是 ${HOME}/.codex):CODEX_HOME 可以不在 HOME 底下
   102	        hooks_dir = str(HOOKS_DIR).replace("\\", "/")
   103	        py = _PY.replace("\\", "/") if sys.platform == "win32" else _PY
   104	        _b = HOOK_BUDGET.get(rel_path)
   105	        _bf = f' --budget {_b}' if _b else ''
   106	        _bf += (' ' + HOOK_ARGS[rel_path]) if rel_path in HOOK_ARGS else ''
   107	        return (f'{py} "{hooks_dir}/{rel_path}" --harness codex{_bf}' if sys.platform != "win32"
   108	                else f'"{py}" "{hooks_dir}/{rel_path}" --harness codex{_bf}')
   109	    if sys.platform == "win32":
   110	        py = _PY.replace("\\", "/")
   111	        _b = HOOK_BUDGET.get(rel_path)
   112	        _bf = f' --budget {_b}' if _b else ''
   113	        _bf += (' ' + HOOK_ARGS[rel_path]) if rel_path in HOOK_ARGS else ''
   114	        return f'"{py}" "{_HOME}/.claude/hooks/{rel_path}"{_bf}'
   115	    _b = HOOK_BUDGET.get(rel_path)
   116	    _bf = f' --budget {_b}' if _b else ''
   117	    _bf += (' ' + HOOK_ARGS[rel_path]) if rel_path in HOOK_ARGS else ''
   118	    return f'{_PY} "${{HOME}}/.claude/hooks/{rel_path}"{_bf}'
