    92	# ── 走到這裡 = 這筆 commit 繞過了 L2 → 留痕 ──
    93	BYPASS_LOG="$REPO_ROOT/docs/.bypass-log.jsonl"
    94	
    95	PY="$(command -v python3 || command -v python)"
    96	COMMIT_HASH="$(git rev-parse --short HEAD)" \
    97	BRANCH="$(git branch --show-current)" \
    98	SUBJECT="$(git log -1 --format=%s)" \
    99	SRC_COUNT="${#src_files[@]}" \
   100	SRC_SAMPLE="$(printf '%s\n' "${src_files[@]:0:10}")" \
   101	"$PY" - "$BYPASS_LOG" <<'PYEOF'
   102	import json, os, sys
   103	from datetime import datetime, timezone
   104	
   105	entry = {
   106	    "ts": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
   107	    "commit": os.environ["COMMIT_HASH"],
   108	    "branch": os.environ["BRANCH"],
   109	    "subject": os.environ["SUBJECT"],
   110	    "code_file_count": int(os.environ["SRC_COUNT"]),
   111	    "code_files": os.environ["SRC_SAMPLE"].splitlines(),
   112	}
   113	with open(sys.argv[1], "a", encoding="utf-8") as f:
   114	    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
   115	PYEOF
   116	
   117	{
   118	  echo ""
   119	  echo "記下了:這次 commit 有 ${#src_files[@]} 個程式碼檔沒帶筆記改動,已寫進跳過紀錄(不擋,只留痕)。"
   120	  echo "如果這次其實該補筆記,趁記憶還新鮮補上;每週可以用這個看跳過率:"
   121	  echo "   lumos gov --since 7"
   122	  echo ""
   123	} >&2
   124	
   125	exit 0

hook: PostToolUse
exec
/bin/zsh -lc "nl -ba scripts/hooks/pre-push | sed -n '1,360p'" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/82c93a23-33db-4a5a-af96-cd2d2b4af3c1/scratchpad/clone-314
 succeeded in 0ms:
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
     7	#
     8	# 為什麼需要:
     9	#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
    10	#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
    11	#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
    12	#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
    13	#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
    14	#
    15	# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
    16	#
    17	# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效
    18	
    19	set -u
    20	
    21	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    22	cd "$REPO_ROOT" || exit 0
    23	
    24	# ── stdin 必須最先讀(prepush範圍修法 #1)──
    25	# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
    26	# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
    27	# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
    28	_PP_LINES=()
    29	while IFS= read -r _line; do
    30	  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
    31	done
    32	
    33	_ZERO="0000000000000000000000000000000000000000"
    34	_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"
    35	
    36	# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
    37	# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
    38	# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
    39	pp_range_for() {
    40	  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    41	    printf '%s..%s' "$_EMPTY_TREE" "$2"
    42	  else
    43	    printf '%s..%s' "$1" "$2"
    44	  fi
    45	}
    46	
    47	# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
    48	# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
    49	# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
    50	pp_touched_file() {
    51	  local _f _r
    52	  [[ -n "$_EMPTY_TREE" ]] || return 0
    53	  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
    54	  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
    55	  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
    56	  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
    57	  _f="$_PP_TMP/touched.txt"
    58	  : > "$_f" 2>/dev/null || return 0
    59	  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    60	    read -r _ _lsha _ _rsha <<< "$_ppl"
    61	    [[ "$_lsha" == "$_ZERO" ]] && continue
    62	    _r="$(pp_range_for "$_rsha" "$_lsha")"
    63	    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
    64	  done
    65	  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
    66	}
    67	
    68	# 無 lumos / python3 → 降級放行(不為缺環境 brick push,CI 兜底)
    69	GRAPHCTL="$REPO_ROOT/scripts/lumos"
    70	PY="$(command -v python3 || command -v python || true)"
    71	
    72	# ── 波及計算(給合約測試閘用):這裡只呼叫、不碰內容。
    73	# ★一次推送只算一次波及★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):以前同步點名與合約測試閘各自呼叫,
    74	# 等於一次推送算兩次——這不是便宜的計算。算一次寫進暫存檔給消費者讀。
    75	# (2026-09-11 起同步點名改由每支檔有家照家算,不再讀這一份;見下面 sync_nudge 原位置的說明。)
    76	# ★失敗隔離★:算不出來 → 暫存檔不存在或是空的 → 合約測試閘記一筆帳放行,不拖垮別的檢查。
    77	_IMPACT_JSON=""
    78	impact_once() {   # $1=diff range;算一次,結果放進 $_IMPACT_JSON
    79	  _IMPACT_JSON=""
    80	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
    81	  # ★用同檔既有的樣板寫法與命名家族★(代碼審 r1 架構對齊席):
    82	  # 同一支腳本下面幾行就有 lumos-prepush-autoloop-XXXXXX / lumos-prepush-tests-XXXXXX,
    83	  # 而且旁邊的註解特別說明過「★XXXXXX 必須在結尾★」是踩過才定下來的。
    84	  local _f; _f="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-impact-XXXXXX" 2>/dev/null || true)"
    85	  [ -n "$_f" ] || return 0
    86	  if "$PY" "$GRAPHCTL" impact --diff "$1" --sync-check --json --repo "$REPO_ROOT" > "$_f" 2>/dev/null \
    87	     && [ -s "$_f" ]; then
    88	    _IMPACT_JSON="$_f"
    89	  else
    90	    rm -f "$_f"
    91	  fi
    92	}
    93	impact_done() { [ -n "$_IMPACT_JSON" ] && rm -f "$_IMPACT_JSON"; _IMPACT_JSON=""; }
    94	# ★硬擋或收到訊號時也要清★(代碼審 r1 外家否決席判 minor,屬實):
    95	# 上面那支只在 ref 迴圈正常跑到尾端時執行。高風險那條路 rc1 會直接 exit 1,
    96	# 收到訊號也一樣——每被硬擋一次就留一個暫存檔在 $TMPDIR 裡慢慢累積。
    97	# 本次推送所有暫存檔的家,離開時整個清(r1 併發席:逐檔 rm 在 exit 1 / Ctrl-C 那條路會漏)。
    98	# 建不出來就擋(r2 邊界席):空字串會讓後面每個 "$_PP_TMP/…" 變成根目錄路徑,測試 log 全寫不出來、擋下訊息一片空白。
    99	_PP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/lumos-prepush-XXXXXX" 2>/dev/null || true)"
   100	if [[ -z "$_PP_TMP" || ! -d "$_PP_TMP" ]]; then
   101	  echo "擋下:推送前檢查需要一個暫存目錄,但 ${TMPDIR:-/tmp} 建不出來(不存在或不可寫);修好 TMPDIR 再推。" >&2
   102	  exit 1
   103	fi
   104	trap 'impact_done; rm -rf "$_PP_TMP"' EXIT INT TERM
   105	# (2026-09-11 起「該動哪篇」的點名改由每支檔有家照家算——下面 home check --diff 會印;原本這裡以反引號為種子的
   106	#  impact --sync-only 會把人推回寫了一堆別人檔名的大雜燴節點,拿掉。Projects/每支檔有家_計劃 [S15]。impact_once 留給合約測試閘用。)
   107	# ★合約測試閘:低風險也跑,紅了印出來記帳但不擋;高風險照舊擋★(人裁 2026-09-07)
   108	# 不選「低風險也擋」的理由:擋下去最可能的結果不是人去修測試,是人改走 --no-verify
   109	# ——而這支腳本自己在別的地方就把那條當第三選項在教,那條零留痕。
   110	bound_tests_advisory() {   # $1=diff range(暫存檔沒算出來時退回自己算)
   111	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
   112	  if [ -n "$_IMPACT_JSON" ]; then
   113	    "$PY" "$GRAPHCTL" bound-tests --from-json "$_IMPACT_JSON" --advisory --repo "$REPO_ROOT" || true
   114	  else
   115	    "$PY" "$GRAPHCTL" bound-tests --diff "$1" --advisory --repo "$REPO_ROOT" || true
   116	  fi
   117	}
   118	if [[ -z "$PY" || ! -f "$GRAPHCTL" ]]; then
   119	  echo "提醒:這台機器找不到 python3 或 lumos,推送前的知識庫檢查這次沒跑;推上去之後 CI 會再跑一遍兜底。" >&2
   120	  exit 0
   121	fi
   122	
   123	# ★同一次推送的事件要串得起來★(#19 S6):這支是逐 ref 迴圈,而錨點與健檢跑在迴圈外面
   124	# ——「當下的 commit」對整支層級的閘沒有唯一答案(同次推多個 ref、推的不是目前 checkout 的 ref、
   125	# detached HEAD 或推 tag,盲取 HEAD 都會歸錯)。所以整支層級的事件改用這個一次性識別碼,
   126	# 逐 ref 的事件另外帶那一行真正的 sha。lumos 端讀這個環境變數,hook 只負責產生它。
   127	export LUMOS_PUSH_ATTEMPT="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
   128	
   129	# 錨點完整性:驗證器(runner/hooks)沒被動過,後面的「doctor 過/測試綠」才可信(repo 層,vault 無關)
   130	if ! "$PY" "$GRAPHCTL" anchor verify; then
   131	  {
   132	    echo ""
   133	    echo "擋下:負責把關的檔案(測試程式、hook 腳本)跟登記過的版本不一樣。"
   134	    echo "這些檔案是裁判,裁判被改過而沒人簽名,後面所有「測試綠、檢查過」都不可信,所以先擋。"
   135	    echo ""
   136	    echo "三條路選一條:"
   137	    echo "  1. 不是故意改的 → 把那個檔還原再推:"
   138	    echo "       git checkout -- <檔案>"
   139	    echo "  2. 是故意改的 → 簽名登記新版本再推:"
   140	    echo "       lumos anchor approve --note \"為什麼改\""
   141	    echo "  3. 真的要先推 → git push --no-verify(CI 之後會發現少了簽名紀錄)"
   142	    echo ""
   143	  } >&2
   144	  exit 1
   145	fi
   146	
   147	# ★簽名檔要跟著推★(2026-09-06 實際被 CI 咬到):上面那道拿的是「工作目錄現在的樣子」,
   148	# 所以你剛簽完名它就是綠的;但 CI 拿的是「已經推上去的內容」。簽名檔沒 commit 就推,
   149	# 這邊全綠、CI 必紅——而且錯誤訊息會叫你再簽一次名,再簽也沒用,因為問題是沒提交。
   150	_BASELINE="governance/anchor-baseline.json"
   151	if [[ -f "$REPO_ROOT/$_BASELINE" ]] && ! git -C "$REPO_ROOT" diff --quiet -- "$_BASELINE" 2>/dev/null; then
   152	  {
   153	    echo ""
   154	    echo "擋下:簽名檔改過了但沒提交,這樣推上去 CI 一定紅。"
   155	    echo "你剛才簽了名(或它被更新過),但那個改動還留在工作目錄裡沒進版控;"
   156	    echo "推送前的檢查看的是工作目錄所以是綠的,CI 看的是推上去的內容,對不起來。"
   157	    echo ""
   158	    echo "把它一起提交再推:"
   159	    echo "       git add $_BASELINE && git commit -m \"gov: 錨點簽名\""
   160	    echo ""
   161	  } >&2
   162	  exit 1
   163	fi
   164	
   165	# ══ 閘的順序(2026-09-06 全 repo 審視 #12 重排)══
   166	# 便宜的先跑、貴的最後。實測:除了全套測試以外,所有閘加起來約 13 秒
   167	# (anchor 0.22s / 簽名檔 0.04s / doctor 1.1s / pitfalls 0.23s / code-loop 0.61s
   168	#  / test-layers 0.21s / 自主迴圈那支 10.3s),而全套是 8 分鐘。
   169	# ★原本全套排在第四位★,所以被那 13 秒裡任何一道擋下時,8 分鐘已經白燒完了。
   170	
   171	# 圖譜健康(只在 vault 存在時跑)
   172	# ★2026-09-06 重排:原本這段在最後面,而且「沒有 vault 就 exit 0」會直接結束整支 hook。
   173	#   現在它排在全套測試之前,那個 exit 0 會把後面的測試閘一起跳掉——所以改成只跳過這一段。
   174	have_vault=0
   175	for d in docs/*-knowledge docs/knowledge; do
   176	  [[ -d "$d" ]] && have_vault=1 && break
   177	done
   178	_TOUCHED_F="$(pp_touched_file)"
   179	_DOCTOR_ARGS=(doctor --ci)
   180	[[ -n "$_TOUCHED_F" ]] && _DOCTOR_ARGS+=(--touched-from "$_TOUCHED_F")
   181	if [[ $have_vault -eq 1 ]] && ! "$PY" "$GRAPHCTL" "${_DOCTOR_ARGS[@]}"; then
   182	  {
   183	    echo ""
   184	    echo "擋下:知識庫健康檢查發現問題(細節在上面)。"
   185	    echo "有問題的筆記推上去,下一個讀它的人會拿到錯的合約或斷掉的連結。"
   186	    echo ""
   187	    echo "三條路選一條:"
   188	    echo "  1. 照上面的提示把筆記修好再推。"
   189	    echo "  2. 覺得是檢查工具本身判錯 → 本機重跑一次確認,真的是工具錯就開一張 Issue 記下來。"
   190	    echo "  3. 真的要先推 → git push --no-verify(CI 還是會跑全套,紅了會看到)"
   191	    echo ""
   192	  } >&2
   193	  exit 1
   194	fi
   195	
   196	
   197	# 代碼偏科 + code-loop 必用守衛(tier=high):push 前把 diff 的代碼形態風險攤在眼前。
   198	# prepush範圍修法(2026-07-21):改讀 stdin 推送範圍逐 ref 判,取代 merge-base——分支與
   199	# main-direct 同軌;無基準(新 ref/缺物件)倒向保守掃 empty-tree..local_sha(非 fail-open,
   200	# 否則守衛升格成穩定繞法);留痕綁 remote_ref 目的地(非 checkout);逐 ref 獨立判,某 ref
   201	# high 未過即擋。fail-open 僅剩:pitfalls 本身出錯 / empty-tree 都跑不動。
   202	# 推送前要跑哪個測試範圍(2026-09-18 Enzo 裁:純文件改動、或判成 light 的小改動,不用等全套):
   203	# 每個 ref 各判一次,任何一個 ref 要全套就全套。docs=只改到 README/docs/assets 這類文件(pitfalls --json 的 suite);
   204	# light=改到程式檔但 spec-gate --push-check 判成 light(風險低計劃、全靠人驗、小改動閘過)。
   205	_SUITE_SEEN=0; _SUITE_FULL=0; _SUITE_LIGHT=0; _SUITE_KEYS=""; _SUITE_GRAPH=0; _AUTOLOOP_FULL=0
   206	for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
   207	  read -r _lref _lsha _rref _rsha <<< "$_ppl"
   208	  # 刪除遠端 ref(local_sha 全零)→ 無代碼推送,跳過
   209	  [[ "$_lsha" == "$_ZERO" ]] && continue
   210	  # 推導檢查範圍(同一套推導另一個使用者是上面的圖譜健康那一段,所以抽成函式——
   211	  # 兩處各寫一份的話,哪天保守兜底改了只改一邊,擋的範圍就會兩邊不一致)
   212	  _range="$(pp_range_for "$_rsha" "$_lsha")"
   213	  [[ -z "$_EMPTY_TREE" ]] && continue   # 連空樹都算不出=git 環境壞,advisory 放行
   214	
   215	  # 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S26]):把這次要推的範圍整段查一次,接住跳過提交前檢查的。
   216	  # ★新分支不沿用上面的空樹兜底★(那會把整段歷史當新改動,本工具鏈有 1900 多個提交):起點改用
   217	  # 「不在任何遠端分支上的提交」裡最早那一個的上一個提交;全部已在遠端就不查;最早那個沒有上一個提交(真的全新)才從空樹比。
   218	  # 起點早於這道檢查上線的那個提交時,lumos 會自己改從上線點算(上線前進來的是舊帳)。rc1=擋;其他非零=放行。
   219	  # ★跟上面 _range 是刻意不同的兩套★(代碼審 r1 架構席問過):_range 給波及計算與風險掃描用,只提醒、寧可掃多;
   220	  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
   221	  _hrange=""
   222	  if [[ "$_rsha" != "$_ZERO" ]] && git cat-file -e "$_rsha" 2>/dev/null; then
   223	    _hrange="$_rsha..$_lsha"
   224	  else
   225	    _hold="$(git rev-list --topo-order --reverse "$_lsha" --not --remotes 2>/dev/null | head -1)"
   226	    if [[ -n "$_hold" ]]; then
   227	      if git rev-parse -q --verify "$_hold^" >/dev/null 2>&1; then
   228	        _hrange="$(git rev-parse "$_hold^")..$_lsha"
   229	      else
   230	        _hrange="$_EMPTY_TREE..$_lsha"
   231	      fi
   232	    fi
   233	  fi
   234	  if [[ -n "$_hrange" ]]; then
   235	    nh_rc=0
   236	    "$PY" "$GRAPHCTL" home check --diff "$_hrange" --repo "$REPO_ROOT" || nh_rc=$?
   237	    if [[ "$nh_rc" -eq 1 ]]; then
   238	      {
   239	        echo ""
   240	        echo "逃生:照上面的指令替檔安家、或把說明改寫進對的那篇,再推;整個專案先改成只提醒 → .lumos/config.json 的 node_home.gate 設成 warn;緊急硬推 git push --no-verify(本機不留痕)。"
   241	        echo ""
   242	      } >&2
   243	      exit 1
   244	    fi
   245	    # 筆記形狀擋(Projects/筆記形狀擋_計劃):同一段範圍再查一次,接住 --no-verify 跳過提交前那道的;範圍算法同上(不用空樹兜底)
   246	    ns_rc=0
   247	    "$PY" "$GRAPHCTL" note-shape --diff "$_hrange" --repo "$REPO_ROOT" || ns_rc=$?
   248	    if [[ "$ns_rc" -eq 1 ]]; then
   249	      {
   250	        echo ""
   251	        echo "逃生:照上面改寫(行號改成函式名或測試名、或釘版本 路徑@<提交編號>:行號;現況描述刪掉或帶 [來源:…]);誤擋就 LUMOS_SKIP_NOTE_SHAPE=1 單次跳過(會留帳);整個專案先只提醒 → .lumos/config.json 的 note_shape.gate 設成 warn。"
   252	        echo ""
   253	      } >&2
   254	      exit 1
   255	    fi
   256	  fi
   257	
   258	  impact_once "$_range"
   259	  pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
   260	  _tier_high=0
   261	  printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
   262	  _SUITE_SEEN=1
   263	  _suite_this="full"
   264	  printf '%s' "$pf_json" | grep -q '"suite": *"docs"' && _suite_this="docs"
   265	  printf '%s' "$pf_json" | grep -q '"suite_graph": *true' && _SUITE_GRAPH=1
   266	  if [[ "$_tier_high" -eq 1 ]]; then
   267	    {
   268	      echo ""
   269	      echo "提醒:這次推送的程式碼裡有高風險寫法(像是沒包交易的寫入、沒關的檔案控制代碼、沒限流的外部呼叫),tier=high。"
   270	      echo "命中的地方列在下面:"
   271	      "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
   272	      echo ""
   273	    } >&2
   274	  fi
   275	  # 留痕座標綁 remote_ref 目的地:refs/heads/* → 分支:★無條件★叫 check(表態閘 2026-09-09,Projects/棧別提問表態閘_計劃 S7):
   276	  # 合約測試紅 / 有適用題表態不完整 / tier=high 無留痕,三個獨立判定各自出各自的訊息、由 check 印
   277	  # ——這裡不再自己寫死「跑一輪代碼審」文案、也不再把它的輸出丟 /dev/null(r3 正確性席 C3)。非 heads → advisory。
   278	  # 雙向門放行(Projects/雙向門放行_計劃 S11–S14/S21):這次範圍碰到、仍 doing、有雙向門留痕的計劃,留痕裡的測試全綠才准推;
   279	  # 留痕過期(條款或它連到的節點變了)也擋。風險低計劃不派設計審,這裡是它唯一的閘;lumos 算不出範圍/索引就 fail-open 放行(rc≠1)。
   280	  sg_rc=0
   281	  _sg_out="$_PP_TMP/sg-$RANDOM.log"
   282	  # tee:一邊即時印到 stderr(r1 併發席:先存檔跑完才印,人會以為卡住去 Ctrl-C)、一邊留一份給下面認 light 用;rc 取管線第一段
   283	  "$PY" "$GRAPHCTL" spec-gate --push-check "$_range" --repo "$REPO_ROOT" 2>&1 | tee "$_sg_out" >&2
   284	  sg_rc="${PIPESTATUS[0]}"
   285	  # push-check 判成 light(它才有圖譜、才知道計劃風險低與小改動閘過):改到程式檔也不跑全套,
   286	  # 只跑文件子集 + 原始碼提到「改到的函式/子命令/檔名」的測試;CI 那邊照樣跑全套當後盾。
   287	  # ★還要 pitfalls 說 light_ok★(r1 資安席):小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
   288	  # 會從它眼皮下溜過——範圍裡只要有一支這種檔,就不准少跑全套。
   289	  if [[ "$_suite_this" == "full" ]] && grep -q '改動風險分級:light' "$_sg_out" && printf '%s' "$pf_json" | grep -q '"light_ok": *true'; then
   290	    _suite_this="light"
   291	    _k="$(printf '%s' "$pf_json" | "$PY" -c 'import json,sys; print(",".join(json.load(sys.stdin).get("affected_keys", [])))' 2>/dev/null || true)"
   292	    [[ -n "$_k" ]] && _SUITE_KEYS="${_SUITE_KEYS:+$_SUITE_KEYS,}$_k"
   293	    printf '%s' "$pf_json" | grep -q '"autoloop_full": *true' && _AUTOLOOP_FULL=1
   294	  fi
   295	  case "$_suite_this" in full) _SUITE_FULL=1 ;; light) _SUITE_LIGHT=1 ;; esac
   296	  if [[ "$sg_rc" -eq 1 ]]; then
   297	    echo "" >&2
   298	    echo "風險低計劃的條款測試沒全綠(或留痕過期),推送擋下:把測試做綠、或重跑 lumos spec-gate <計劃> 之後再推。" >&2
   299	    exit 1
   300	  fi
   301	  if [[ "$_rref" == refs/heads/* ]]; then
   302	    _rbranch="${_rref#refs/heads/}"
   303	    cl_rc=0
   304	    # ★高風險這條路也把算好的那份傳進去★:不傳的話它會自己再算一次波及。
   305	    _fj=(); [ -n "$_IMPACT_JSON" ] && _fj=(--from-json "$_IMPACT_JSON")
   306	    # 低風險推送的受波及合約測試維持「只提醒不擋」(2026-09-07 全 repo 審視 #17 人裁);高風險不帶旗標,照擋
   307	    # pitfalls 沒吐 JSON(暫時失敗)就不帶 advisory:讓 check 自己算 tier 決定擋不擋(r1 外家 finder f4/否決 f3)
   308	    _ba=(); [[ -n "$pf_json" && "$_tier_high" -eq 0 ]] && _ba=(--bound-tests-advisory)
   309	    _cl_out="$("$PY" "$GRAPHCTL" code-loop check --diff "$_range" --at-sha "$_lsha" --branch "$_rbranch" \
   310	      --repo "$REPO_ROOT" ${_fj+"${_fj[@]}"} ${_ba+"${_ba[@]}"} 2>&1)" || cl_rc=$?
   311	    if [[ "$cl_rc" -eq 1 ]]; then
   312	      # 逃逸自動記(規格落成可驗收條件_計劃 第五節):推送閘擋下=下游抓到了設計審/規格閘放行後的洞,
   313	      # 碰到的計劃筆記各記一筆;對不回就不記。★永遠 fail-open★——記帳失敗不能變成擋推送的第二個理由。
   314	      # ★只認「受波及合約的測試沒過」那型★:缺表態/高風險缺留痕是流程沒走完,不是下游抓到缺陷,不進逃逸帳(首輪前掃訂正)
   315	      if printf '%s' "$_cl_out" | grep -q "受波及合約的測試沒過"; then
   316	        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate --severity major \
   317	          --desc "推送閘擋下:$(printf '%s' "$_cl_out" | grep -m1 '受波及合約的測試沒過')" --range "$_range" --repo "$REPO_ROOT" >&2 || true
   318	      fi
   319	      # 高風險缺審查留痕:只有「該計劃被判成風險低、跳過設計審」才算逃逸(lumos 那邊查有沒有風險低留痕,沒有就不記)
   320	      # ★只認「tier=high 且…」開頭的缺留痕句★:測試紅的擋下句尾巴也帶 tier=high,認整個詞會兩筆都記(r2 回滾席)
   321	      if printf '%s' "$_cl_out" | grep -q "tier=high 且"; then
   322	        "$PY" "$GRAPHCTL" loop escape --auto --stage push-gate-unreviewed --severity major \
   323	          --desc "推送閘擋下:高風險缺審查留痕" --range "$_range" --repo "$REPO_ROOT" >&2 || true
   324	      fi
   325	      {
   326	        echo ""
   327	        printf '%s\n' "$_cl_out"
   328	        echo ""
   329	        echo "逃生路依上面 check 講的原因走:缺表態 → 先表態(上面的 dispositions 指令);高風險缺審查留痕 → 審過 lumos code-loop pass --note、或刻意不審 lumos code-loop skip --note \"為什麼\";合約測試紅 → 修測試。緊急硬推 git push --no-verify(本機不留痕,CI 會把這次推送標紅)"
   330	        echo ""
   331	      } >&2
   332	      exit 1
   333	    fi
   334	    # rc=0(已收斂/已表態/skip):check 的提醒行(低風險合約測試紅、設定檔警告、表態閘小結)原樣給人看;rc≠0/1(異常):fail-open 放行
   335	    [ -n "$_cl_out" ] && { printf '%s\n' "$_cl_out" | grep -E '提醒|受波及合約測試|表態閘' >&2 || true; }
   336	  else
   337	    # 非分支 remote_ref(tag/其他 namespace):無 branch marker 通道,一律 advisory(r2 外家 F7)
   338	    [[ "$_tier_high" -eq 1 ]] && echo "提醒:這次推的是 tag 不是分支,高風險檢查只提醒不擋(advisory)。" >&2
   339	    if printf '%s' "$pf_json" | grep -q '"stack_questions_applicable": *{"'; then
   340	      {
   341	        echo ""
   342	        echo "提醒:這次改到的技術棧有幾題效能檢核被觸發(推的是 tag,只提醒不擋),列在下面:"
   343	        "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
   344	        echo ""
   345	      } >&2 || true
   346	    fi
   347	    bound_tests_advisory "$_range"
   348	  fi
   349	  # ★合約測試閘:低風險這一路也要跑★(2026-09-07 全 repo 審視 #17,人裁)
   350	  # 舊行為:這件事藏在 code-loop check 裡,而那支只在 tier=high 且推的是分支時才跑
   351	  # ——所以「改到硬合約就跑那些合約綁的測試」這句話,在低風險推送上是假的,
   352	  # 而改一行低風險的碼一樣可以打破合約。
   353	  # 高風險那條路已經在上面的 code-loop check 裡跑過(它會擋),這裡只補低風險那半。
   354	  # (表態閘 2026-09-09 起)分支 ref 的低風險推送:合約測試已在上面的 code-loop check 裡以 advisory 跑過一次,這裡不再跑第二次;
   355	  # tag 走上面 else 分支的 bound_tests_advisory。
   356	  # test-layers 軟提醒(advisory,恆不影響 rc;無 .lumos/test-layers.json 靜默)
   357	  "$PY" "$GRAPHCTL" test-layers --diff "$_range" --repo "$REPO_ROOT" 2>/dev/null || true
   358	  impact_done
   359	done
   360	

hook: PostToolUse
hook: PostToolUse
exec
/bin/zsh -lc "nl -ba get.sh | sed -n '1,180p'; nl -ba install.sh; nl -ba scripts/install-hooks.sh; nl -ba scripts/install-graph-toolchain.sh; nl -ba get.ps1 | sed -n '1,180p'" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/82c93a23-33db-4a5a-af96-cd2d2b4af3c1/scratchpad/clone-314
 succeeded in 0ms:
     1	#!/usr/bin/env bash
     2	# get.sh — 遠端一鍵裝:clone Lumos 後整段委派 bootstrap(機器層+專案層自動接線)。
     3	# 用法:  curl -fsSL https://raw.githubusercontent.com/EnzoHsieh-Android/Lumos/release/get.sh | bash
     4	#   旗標: --pull(既有 clone 也拉最新)/--init(無 vault 的 repo 免確認建圖譜)
     5	#         curl -fsSL <url> | bash -s -- --pull --init
     6	#   環境變數:LUMOS_HOME(預設 ~/harness/lumos-toolchain)、LUMOS_URL(預設 GitHub)、
     7	#            LUMOS_BRANCH(預設 release;開發線是 main)
     8	# 站在專案 repo 內跑 → bootstrap 會問「要建成 lumos 專案嗎?」(y 才建;非互動跳過)。
     9	#
    10	# ★為什麼整段包在 main() 裡★(2026-09-07 #7):這支是拿 curl 串流進 bash 執行的。
    11	# 網路在中途斷掉時,bash 會把「已經收到的那半段」照樣跑完——裝到一半、沒有任何錯誤訊息。
    12	# 包成函式再在最後一行呼叫,就要等整份收完才會開始跑;檔案沒收完,呼叫那一行根本不存在。
    13	# 最後一行的 `; exit` 是同一個理由的第二道:確保 bash 不會再往下讀到殘留的位元組。
    14	set -euo pipefail
    15	
    16	main() {
    17	  LUMOS_HOME="${LUMOS_HOME:-$HOME/harness/lumos-toolchain}"
    18	  LUMOS_URL="${LUMOS_URL:-https://github.com/EnzoHsieh-Android/Lumos}"
    19	  LUMOS_BRANCH="${LUMOS_BRANCH:-release}"
    20	
    21	  # 迴圈解析(舊碼單點比對 $1,並帶兩旗標會無聲吃掉第二個);未知旗標 warn 忽略
    22	  ARGS=()
    23	  for a in "$@"; do
    24	    case "$a" in
    25	      --pull|--init) ARGS+=("$a") ;;
    26	      *) echo "提醒:不認得 $a 這個選項,略過(只認 --pull 和 --init)" >&2 ;;
    27	    esac
    28	  done
    29	
    30	  if [[ -f "$LUMOS_HOME/scripts/lumos" ]]; then
    31	    echo "[clone] Lumos 源已在: $LUMOS_HOME"
    32	  else
    33	    echo "[clone] clone Lumos($LUMOS_BRANCH 對外線)→ $LUMOS_HOME …"
    34	    mkdir -p "$(dirname "$LUMOS_HOME")"
    35	    # 對外線抓不到就退回預設分支:release 分支可能還沒開,冷啟動不該因此炸掉。
    36	    # 用分支不用 tag,是因為 tag 會進 detached HEAD,之後 git pull / lumos update 全部靜默停住。
    37	    if ! git clone --branch "$LUMOS_BRANCH" "$LUMOS_URL" "$LUMOS_HOME" 2>/dev/null; then
    38	      echo "  提醒:抓不到 $LUMOS_BRANCH 這條對外線(分支還沒開、或名字改了),改用預設分支。" >&2
    39	      echo "  這代表你拿到的是開發線的內容,可能還沒發布過。" >&2
    40	      git clone "$LUMOS_URL" "$LUMOS_HOME"
    41	    fi
    42	  fi
    43	
    44	  # 其餘全交 bootstrap(機器層 install+skills、專案層四分流;set -e 保錯誤傳播)
    45	  LUMOS_HOME="$LUMOS_HOME" python3 "$LUMOS_HOME/scripts/lumos" bootstrap ${ARGS[@]+"${ARGS[@]}"}
    46	
    47	  echo
    48	  echo "✓ 完成。最後一步:**重啟 Claude Code session**(hooks 在 session start 載入)"
    49	}
    50	
    51	main "$@"; exit
     1	#!/usr/bin/env bash
     2	# install.sh — 薄殼:安裝邏輯已收進 python 單一源(scripts/lumos)。保留檔名供舊文檔/離線使用(cmd_bootstrap 已改探測 scripts/lumos,2026-07-25 F3)。
     3	# 等價於 `lumos install --force`:裝全域 lumos + user-scope skills(symlink → ~/.claude/skills/* 與 Codex 讀的 ~/.agents/skills/*)
     4	# + 兩家 hook 註冊(~/.claude/settings.json、~/.codex/hooks.json;Codex 的 hook 要你開一次互動 codex 審過才會跑)。
     5	exec python3 "$(cd "$(dirname "$0")" && pwd)/scripts/lumos" install --force "$@"
     1	#!/usr/bin/env bash
     2	# install-hooks.sh — 薄殼:hook 安裝邏輯已收進 python 單一源(scripts/lumos 的 _install_hooks_py)。
     3	# 保留檔名供舊文檔/離線。等價於在當前 repo 跑 `lumos init --force`(會 vendor + 裝 git/Claude hooks)。
     4	set -u
     5	HERE="$(cd "$(dirname "$0")" && pwd)"
     6	exec python3 "$HERE/lumos" init --force "$@"
     1	#!/usr/bin/env bash
     2	# install-graph-toolchain.sh — 薄殼:vendor/scaffold 邏輯已收進 python 單一源(scripts/lumos)。
     3	# 保留檔名供舊文檔/離線。解析既有 --target/--slug,轉呼叫 `lumos init`(在目標 repo 建圖譜 + vendor + hooks)。
     4	set -u
     5	HERE="$(cd "$(dirname "$0")" && pwd)"
     6	TARGET=""; SLUG=""
     7	while [[ $# -gt 0 ]]; do
     8	  case "$1" in
     9	    --target) TARGET="${2:-}"; shift 2 ;;
    10	    --slug)   SLUG="${2:-}"; shift 2 ;;
    11	    --no-hooks|--no-scaffold|--dry-run) shift ;;
    12	    *) shift ;;
    13	  esac
    14	done
    15	cd "${TARGET:-.}"
    16	if [[ -n "$SLUG" ]]; then
    17	  exec python3 "$HERE/lumos" init --name "$SLUG" --force
    18	else
    19	  exec python3 "$HERE/lumos" init --force "$@"
    20	fi
     1	# get.ps1 - one-line install for Windows / PowerShell.
     2	#   irm https://raw.githubusercontent.com/EnzoHsieh-Android/Lumos/release/get.ps1 | iex
     3	#   With flags:  $args = @('--pull'); irm <url> | iex
     4	#   Env vars: LUMOS_HOME, LUMOS_URL, LUMOS_BRANCH (default: release; the dev line is main)
     5	#
     6	# ASCII-ONLY, NO BOM. This is not a style preference:
     7	#   - No BOM + non-ASCII: when the file is run from disk, PowerShell 5.1 decodes it with the
     8	#     system ANSI codepage. On CJK systems a DBCS lead byte eats the next byte and breaks
     9	#     quote pairing -> parse error, nothing gets installed.
    10	#   - BOM: `irm | iex` receives a plain string and PowerShell does NOT strip the BOM, so
    11	#     U+FEFF becomes line 1 content and that comment line is executed as a command.
    12	#   Both were hit on a real Windows machine (2026-08-03). ASCII-only removes the whole class.
    13	#   Same rule as slim/*.ps1; the Chinese write-up lives in the graph note, not in this file.
    14	#
    15	# This delegates to `lumos bootstrap`, same as get.sh. It used to run `install --force` only,
    16	# which set up the machine layer but not the project layer - so Windows users finished the
    17	# documented "one command does it all" with nothing wired inside their project.
    18	
    19	function Invoke-LumosGet {
    20	  # NOTE: the parameter must NOT be named $Args. $Args is a PowerShell automatic variable
    21	  # (the function's own unbound arguments) and shadows anything passed in, so every flag
    22	  # would be silently dropped. Same trap as slim/get.ps1.
    23	  param([string[]]$ScriptArgs)
    24	
    25	  $ErrorActionPreference = "Stop"
    26	
    27	  if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    28	    Write-Error "ERROR: git not found. Install git first, then re-run: https://git-scm.com/download/win" -ErrorAction Continue
    29	    return 2
    30	  }
    31	
    32	  # Pick the interpreter at run time instead of hardcoding `python`. Machines that only have
    33	  # python3.exe (some official installers, Microsoft Store builds) would otherwise fail right
    34	  # here - before ever reaching the shim fix in `lumos install` that exists for exactly them.
    35	  $py = $null
    36	  foreach ($cand in @('python3', 'python')) {
    37	    if (Get-Command $cand -ErrorAction SilentlyContinue) { $py = $cand; break }
    38	  }
    39	  if (-not $py) {
    40	    Write-Error "ERROR: neither python3 nor python found on PATH. Install Python 3.9+ and re-run." -ErrorAction Continue
    41	    return 2
    42	  }
    43	
    44	  $homeDir = if ($env:LUMOS_HOME) { $env:LUMOS_HOME } else { "$HOME\harness\lumos-toolchain" }
    45	  $url = if ($env:LUMOS_URL) { $env:LUMOS_URL } else { "https://github.com/EnzoHsieh-Android/Lumos" }
    46	  $branch = if ($env:LUMOS_BRANCH) { $env:LUMOS_BRANCH } else { "release" }
    47	
    48	  $pass = @()
    49	  foreach ($f in $ScriptArgs) {
    50	    if ($f -eq '--pull' -or $f -eq '--init') { $pass += $f }
    51	    else { Write-Warning "unknown option $f - ignored (only --pull and --init are accepted)" }
    52	  }
    53	
    54	  if (-not (Test-Path "$homeDir\scripts\lumos")) {
    55	    New-Item -ItemType Directory -Force -Path (Split-Path $homeDir) | Out-Null
    56	    Write-Host "[clone] cloning Lumos ($branch, the public channel) -> $homeDir ..."
    57	    # Fall back to the default branch: the release branch may not exist yet and a cold
    58	    # start must not die because of that. Branch, not tag: a tag gives a detached HEAD and
    59	    # later `git pull` / `lumos update` then refuse to move (they fail closed and say so).
    60	    git clone --branch $branch $url $homeDir 2>$null
    61	    # $ErrorActionPreference = "Stop" does NOT cover native executables: git.exe returning
    62	    # non-zero does not terminate. Check $LASTEXITCODE explicitly. (Same note as slim/get.ps1.)
    63	    if ($LASTEXITCODE -ne 0) {
    64	      Write-Warning "cannot reach the '$branch' channel (branch missing or renamed); using the default branch - you are getting the development line."
    65	      git clone $url $homeDir
    66	      if ($LASTEXITCODE -ne 0) {
    67	        Write-Error "ERROR: clone of $url failed (check your network and access to that repo)." -ErrorAction Continue
    68	        return 2
    69	      }
    70	    }
    71	  } else {
    72	    Write-Host "[clone] Lumos source already at: $homeDir"
    73	  }
    74	
    75	  $env:LUMOS_HOME = $homeDir
    76	  # `| Out-Host` is required: a function's `return` also emits every unconsumed output,
    77	  # so without it the caller receives Object[] instead of Int32. (Same note as slim/get.ps1.)
    78	  & $py "$homeDir\scripts\lumos" bootstrap @pass | Out-Host
    79	  if ($LASTEXITCODE -ne 0) {
    80	    Write-Error "ERROR: bootstrap failed with exit code $LASTEXITCODE." -ErrorAction Continue
    81	    return $LASTEXITCODE
    82	  }
    83	
    84	  Write-Host ""
    85	  Write-Host "Done. Last step: restart your Claude Code session (hooks load at session start)."
    86	  return 0
    87	}
