 23883	def _notelines_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, mark=None, max_count=None,
 23884	                           hook=_NOTELINES_PRECOMMIT):
 23885	    """推送前:範圍裡每個提交各自新增的筆記行 → ({NFC 路徑: 行文字集合}, [範圍淨改動的筆記路徑(git 原樣)],
 23886	    {NFC 路徑: 這道檢查還沒上線的提交寫的行})。git 失敗回 None。
 23887	    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
 23888	    改名照每個提交(合併提交是每個上一版)的改名偵測往後帶到終點路徑(r3 外家席)。
 23889	    ★鍵用 NFC、拿去 git 查的一律用原樣路徑★(驗收輪通才席:NFC 過的路徑對存 NFD 的樹 cat-file、路徑篩選都查不到)。
 23890	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
 23891	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
 23892	    ★寫的時候這道檢查還沒上線的提交不查★(mark):看那個提交自己的提交前掛鉤有沒有上線標記——上線前開的分支上線後
 23893	    才合進來,那些行是舊帳(r3 通才席);原本用「是不是上線點的後代」代替,兩條分支各自裝過時另一條整批漏查(驗收輪通才席)。
 23894	    那些行另外收進第三個回傳值,喚醒那條路也跳過(驗收輪外家席)。max_count:只看最新那幾個提交(doctor 的上限)。"""
 23895	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23896	    if exclude_remote:
 23897	        ml = _ns_exclusions(repo_root, tip)
 23898	        if ml:
 23899	            rl += ["--not", *ml]
 23900	    if max_count:
 23901	        rl.append(f"--max-count={int(max_count)}")
 23902	    raw = _nodehome_git(repo_root, *rl)
 23903	    if raw is None:
 23904	        return None
 23905	    commits = [ln.split() for ln in raw.decode("ascii", errors="replace").splitlines() if ln.split()]
 23906	    live = None
 23907	    if mark and commits:
 23908	        hb = _nodehome_cat_blobs(repo_root, [f"{c[0]}:{hook}" for c in commits])
 23909	        if hb is None:
 23910	            return None
 23911	        live = {c[0] for c, b in zip(commits, hb) if b is not None and mark.encode() in b}
 23912	    by_path, old_by = {}, {}
 23913	
 23914	    def _renames(a, b):
 23915	        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
 23916	        return None if r is None else _nodehome_name_status(r, norm=False)[1]     # 原樣 新路徑 → 舊路徑
 23917	
 23918	    def _carry(ren):
 23919	        for new_, old_ in (ren or {}).items():
 23920	            ko, kn = nfc(old_), nfc(new_)
 23921	            for d_ in (by_path, old_by):
 23922	                if ko in d_ and ko != kn:
 23923	                    d_.setdefault(kn, set()).update(d_.pop(ko))
 23924	
 23925	    for shas in commits:
 23926	        sha, parents = shas[0], shas[1:]
 23927	        first = parents[0] if parents else _EMPTY_TREE_SHA
 23928	        ren = _renames(first, sha)
 23929	        if ren is None:
 23930	            return None
 23931	        _carry(ren)
 23932	        dest = by_path if (live is None or sha in live) else old_by
 23933	        if len(parents) <= 1:
 23934	            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
 23935	            if d is None:
 23936	                return None
 23937	            for p, rows in _notelines_parse_added(d).items():
 23938	                dest.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23939	            continue
 23940	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 23941	        if names is None:
 23942	            return None
 23943	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23944	        pren = [_renames(pp, sha) or {} for pp in parents]
 23945	        for pr in pren[1:]:
 23946	            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
 23947	            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
 23948	            _carry(pr)
 23949	        specs = []
 23950	        for p in paths:
 23951	            specs.append(f"{sha}:{p}")
 23952	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
 23953	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23954	        k = 1 + len(parents)
 23955	        for i, p in enumerate(paths):
 23956	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23957	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23958	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23959	                d = _ns_diff(repo_root, first, sha, "--", p)
 23960	                if d is None:
