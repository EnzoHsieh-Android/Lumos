 26520	def _drift_set_status_text(text, status):
 26521	    """全文裡把 status 欄改掉(連同 status/* 標籤)——考試在記憶體裡重放 lumos set 用,不寫檔。"""
 26522	    lines = text.split("\n")
 26523	    e = _drift_fm_end(lines)
 26524	    if not e:
 26525	        return text
 26526	    fm = edit_fm_scalar(lines[1:e], "status", status)
 26527	    fm, _s = edit_fm_sync_status_tag(fm, status)
 26528	    return "\n".join(lines[:1] + fm + lines[e:])
 26529	
