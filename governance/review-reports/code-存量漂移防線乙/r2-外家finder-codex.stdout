 22551	def _nodehome_config(repo_root, text=None, from_snapshot=False):
 22552	    """讀 node_home 設定。回 {mode: on|warn|off, max_files: int, ignore: [str], warnings: [str]};壞值一律退回預設並留一句。
 22553	    from_snapshot=True:text 是被檢查那個版本裡 .lumos/config.json 的內容(None=那個版本沒有這支檔)——
 22554	    ★提交前讀提交索引、推送前讀終點那個提交★,不讀工作目錄(工作目錄裡沒暫存的「關掉」不得關掉提交索引的檢查)。
 22555	    from_snapshot=False:直讀工作目錄(健檢開頭那一行用;同 _stack_questions_config 慣例)。
 22556	    ★鍵叫 mode 不叫 gate★:治理閘名的漂移掃描會把 gate 鍵的字面值當閘名(同 _stack_questions_config)。"""
 22557	    cfg = {"mode": "on", "max_files": _NODEHOME_MAX_FILES_DEFAULT, "ignore": [], "warnings": []}
 22558	    if from_snapshot:
 22559	        if text is None:
 22560	            return cfg
 22561	        raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 22562	    else:
 22563	        p = Path(repo_root) / ".lumos" / "config.json"
 22564	        # 捷徑檔不跟過去讀:跟讀快照那條路一樣(git 裡的捷徑檔讀出來是目標路徑字串,解析失敗退預設)——
 22565	        # 不然設定檔被做成指到本機任意檔的捷徑,健檢每次都會去讀那支檔(代碼審 r1 資安席)。
 22566	        # ★整條路徑都要看★:只看 config.json 本身,.lumos 資料夾是捷徑時照樣讀到外面(代碼審 r2 資安席、邊界席)
 22567	        try:
 22568	            _via_link = p.is_symlink() or (p.exists() and p.resolve() != Path(repo_root).resolve() / ".lumos" / "config.json")
 22569	        except OSError:
 22570	            _via_link = True
 22571	        if _via_link:
 22572	            cfg["warnings"].append(".lumos/config.json(或 .lumos 資料夾)是捷徑檔,不跟過去讀,每支檔有家用預設(會擋、上限 "
 22573	                                   f"{_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)——要設定就放一支一般檔")
 22574	            return cfg
 22575	        if not p.is_file():
 22576	            return cfg
 22577	        try:
 22578	            raw = p.read_text(encoding="utf-8")
 22579	        except Exception as e:
 22580	            cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
 22581	            return cfg
 22582	    try:
 22583	        data = json.loads(raw)
 22584	    except Exception as e:
 22585	        cfg["warnings"].append(f".lumos/config.json 讀不了({e.__class__.__name__}),每支檔有家用預設(會擋、上限 {_NODEHOME_MAX_FILES_DEFAULT} 支、不額外排除)")
 22586	        return cfg
 22587	    nh = data.get("node_home") if isinstance(data, dict) else None
 22588	    if nh is None:
 22589	        return cfg
 22590	    if not isinstance(nh, dict):
 22591	        cfg["warnings"].append("設定檔的 node_home 不是物件,整段用預設")
 22592	        return cfg
 22593	    g = nh.get("gate", "on")
 22594	    if g not in _NODEHOME_GATE_VALUES:
 22595	        cfg["warnings"].append(f"設定檔的 node_home.gate={g!r} 看不懂(只認 {'/'.join(_NODEHOME_GATE_VALUES)}),已用 on")
 22596	    else:
 22597	        cfg["mode"] = g
 22598	    mf = nh.get("max_files", _NODEHOME_MAX_FILES_DEFAULT)
 22599	    # ★bool 要單獨擋★:Python 的 True 是 int 的子類,不擋的話上限悄悄變成 1(同合約條數門檻那支)
 22600	    if isinstance(mf, bool) or not isinstance(mf, int) or mf < 1:
 22601	        cfg["warnings"].append(f"設定檔的 node_home.max_files={mf!r} 不合法(要 1 以上的整數),已用 {_NODEHOME_MAX_FILES_DEFAULT}")
 22602	    else:
 22603	        cfg["max_files"] = mf
 22604	    ig = nh.get("ignore", [])
 22605	    if not isinstance(ig, list):
 22606	        cfg["warnings"].append("設定檔的 node_home.ignore 要是字串清單,整段略過")
 22607	    else:
 22608	        for i, item in enumerate(ig):
 22609	            if isinstance(item, str) and item.strip():
 22610	                cfg["ignore"].append(item.strip())
 22611	            else:
 22612	                cfg["warnings"].append(f"設定檔的 node_home.ignore 第 {i + 1} 項不是字串({item!r}),略過這一項")
 22613	    return cfg
