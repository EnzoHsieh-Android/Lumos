 26735	def _drift_exam_history(root, vault_rel, at_sha, n, as_json):
 26736	    """門檻②:被考 repo 最近 n 個主線提交各跑一次 check(父..提交),每筆要處理列出來給人逐筆判真假。"""
 26737	    import json as _j
 26738	    rl = _lens_git(root, "rev-list", "--first-parent", f"--max-count={int(n)}", at_sha)
 26739	    if rl is None or rl.returncode != 0:
 26740	        print("擋下:git 列不出提交", file=sys.stderr)
 26741	        return 2
 26742	    out = []
 26743	    for c in rl.stdout.split():
 26744	        par = _lens_full_sha(root, f"{c}^")
 26745	        if par is None:
 26746	            continue
 26747	        must, listed, unknown = _drift_check_core(root, par, c, _drift_vault_rel(root, c) or vault_rel)
 26748	        if must or unknown:
 26749	            out.append({"commit": c[:10], "must": [f"{f['kind']} {f['path']}:{f['line']} {f['text'][:50]}" for f in must],
 26750	                        "unknown": unknown, "listed": len(listed),
 26751	                        "noise": len({f['path'] for f in must if f['kind'] == 'c1'}) + sum(1 for f in must if f['kind'] != 'c1')})
 26752	    if as_json:
 26753	        print(_j.dumps({"commits": int(n), "with_must": out}, ensure_ascii=False, indent=1))
 26754	        return 0
 26755	    print(f"最近 {n} 個主線提交裡,有要處理的 {len(out)} 個(每筆要人判真假):")
 26756	    for r in out:
 26757	        print(f"  {r['commit']}  噪音 {r['noise']}" + (f"  判不了:{';'.join(r['unknown'])}" if r["unknown"] else ""))
 26758	        for m in r["must"]:
 26759	            print(f"      {m}")
 26760	    return 0
 26761	
 26762	
 26763	def cmd_decision_amend(env, rel, did, field, text):
 26764	    """lumos decision-amend <節點> <決策編號> --field <欄名> --text "<新文字>"(計劃〈做法〉第 3 節第 4 點):
 26765	    只改還沒推上去的決策的一個文字子欄。先 fetch 所有遠端,再對每個遠端追蹤參照用改名偵測找這篇的舊路徑:
 26766	    那個版本裡有這個決策編號就拒絕(已推或撞號,兩種都講)。"""
 26767	    if field in ("id", "decided", "valid", "superseded_by", "ended", "decided_by", "replaces"):
 26768	        raise ValueError(f"「{field}」是結構欄,不能用 decision-amend 改;要翻案用 decision-supersede")
 26769	    if not re.fullmatch(r"d\d+", did or ""):
 26770	        raise ValueError("決策編號要寫成 d1、d2 這種形狀")
 26771	    path = env.vault / rel
 26772	    top = _lens_git(env.vault, "rev-parse", "--show-toplevel")
 26773	    if top is None or top.returncode != 0 or not top.stdout.strip():
 26774	        raise ValueError("這篇筆記不在 git 專案裡")
 26775	    root = Path(top.stdout.strip())
 26776	    rels = path.resolve().relative_to(root.resolve()).as_posix()
 26777	    # 改名偵測的路徑篩選給整個圖譜夾:只給新路徑的話舊路徑不在篩選裡,git 認不出改名
 26778	    vrel = env.vault.resolve().relative_to(root.resolve()).as_posix()
 26779	    rm = _lens_git(root, "remote")
 26780	    remotes = [x for x in (rm.stdout.split() if rm is not None and rm.returncode == 0 else []) if x]
 26781	    if remotes:
 26782	        f = _lens_git(root, "fetch", "--all", "--quiet")
 26783	        if f is None or f.returncode != 0:
 26784	            raise ValueError("git fetch --all 失敗(沒網路或遠端要驗證),確認不了這條決策有沒有推上去,不改。"
 26785	                             + ((" " + f.stderr.strip()[:200]) if f is not None else ""))
 26786	
