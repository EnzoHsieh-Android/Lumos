 26321	def cmd_drift_check(repo=None, diff_range=None):
 26322	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 26323	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
 26324	    import time as _t
 26325	    root = _note_audit_root(repo)
 26326	    if root is None:
 26327	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 26328	        return 0
 26329	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 26330	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 26331	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 26332	        return 0
 26333	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 26334	                                               mark=_DRIFT_GOLIVE_MARK)
 26335	    if tip is None or isinstance(tip, int):
 26336	        return tip if isinstance(tip, int) else 0
 26337	    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 26338	    for w in warns:
 26339	        print(f"提醒:{w}", file=sys.stderr)
 26340	    if mode == "off":
 26341	        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 26342	        return 0
 26343	    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 26344	                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 26345	    acks = _drift_load_acks(root, tip)
 26346	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 26347	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 26348	    lst = _nodehome_list(root, tip)
 26349	    alive = set(lst[1]) if lst else None
 26350	    if listed:
 26351	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 26352	        _drift_print_findings(listed, sys.stderr, acks, alive)
 26353	    if not must and not unknown:
 26354	        return 0
 26355	    return _drift_report_must(root, mode, must, unknown, acks, alive)
 26356	
 26357	
 26358	def _drift_report_must(root, mode, must, unknown, acks, alive=None):
 26359	    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
 26360	    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
 26361	    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
 26362	    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
 26363	    for u in unknown:
 26364	        print(f"  判不了:{u}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
 26365	              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
 26366	    _drift_print_findings(must, sys.stderr, acks, alive)
 26367	    kinds = {f["kind"] for f in must}
 26368	    if kinds - {"probe"}:
 26369	        # ★不叫人重跑 guard settle★(代碼審 r1 正確性席):已經 pass 的紀錄 settle 直接回「已轉正」,不會改寫
 26370	        print("預告句那幾筆:把預告句手改成歷史說法(例:「為什麼還不做:」改成「預告當時為什麼還不做:」)。", file=sys.stderr)
 26371	    if "probe" in kinds:
 26372	        # 條件式的修法不一樣(乙代碼審 r1 正確性席:原本也印改預告句)
 26373	        print("回頭條件那幾筆:條件成立了——把待辦做掉,再刪掉這行或改寫成歷史說法。", file=sys.stderr)
 26374	    if must:
 26375	        print("不改就留著並表態:\n    lumos drift ack <節點> <行號> --kind "
 26376	              + ("|".join(sorted(kinds)) if len(kinds) > 1 else next(iter(kinds)))
 26377	              + " --reason \"<為什麼照留>\"", file=sys.stderr)
 26378	    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
 26379	    if mode == "block":
 26380	        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
 26381	                            nodes=sorted({f["path"][:-3] for f in must})[:50])
 26382	        return 1
 26383	    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
 26384	    return 0
 26385	
