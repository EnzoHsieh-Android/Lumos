 25399	def _drift_c3_hit(env, vrel, override=None, ti=None):
 25400	    """驗證紀錄 vrel 算不算「計劃收尾了、驗證紀錄還待定」(c3)→ 收尾的計劃清單,不算回 None。
 25401	    ★lumos set 的第②項與 c3 用同一支★(設計審 r3 正確性席:兩處原本講的不是同一個集合)。
 25402	    override={計劃路徑: 狀態}:set 要在寫之前就用「改好之後」的狀態算。
 25403	    ★plan_refs 照 build_typed_index 解★(代碼審 r1 架構對齊席):同名只寫檔名的連結算猜不準,不靜默取第一篇;
 25404	    有任一項解不出(找不到、猜不準、不是連結)就不算——講不準就不列。"""
 25405	    n = env.notes.get(vrel)
 25406	    if n is None or _drift_str(n, "type") != "verification" or _drift_str(n, "status") != "pending":
 25407	        return None
 25408	    if GUARD_MARK_FIELD in n.fields:
 25409	        return None                               # 守衛紀錄到期前本來就是 pending;欄位在就算(空的也算,外家席)
 25410	    refs = [x for x in as_list(n.fields.get("plan_refs")) if x.strip()]
 25411	    if not refs:
 25412	        return None
 25413	    ti = ti if ti is not None else build_typed_index(env)
 25414	    # 每一項都要有落點:只要有一項落在解不出(ghosts)、猜不準(ambiguous)或不是連結(scalars),就不算(代碼審 r2、r3
 25415	    # 正確性席:比「解出來幾項」跟「寫法幾種」兩個數字,.md 混寫會漏列、再加一條解不出的又會湊巧相等而誤列)
 25416	    if any(not link_target(x) for x in refs) \
 25417	            or any(g[0] == vrel and g[2] == "plan_refs" for g in ti["ghosts"] + ti["ambiguous"]) \
 25418	            or any(sc[0] == vrel and sc[1] == "plan_refs" for sc in ti["scalars"]):
 25419	        return None
 25420	    plans = sorted(set(ti["fwd"].get(vrel, {}).get("plan_refs", [])))
 25421	    if not plans:
 25422	        return None
 25423	    for prel in plans:
 25424	        pn = env.notes.get(prel)
 25425	        if pn is None or _drift_str(pn, "type") != "project":
 25426	            return None
 25427	        if (override or {}).get(prel, _drift_str(pn, "status")) not in _DRIFT_CLOSED:
 25428	            return None
 25429	    return plans
