 26389	def _drift_vault_of(env):
 26390	    root = _vault_repo_root(env)
 26391	    try:
 26392	        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 26393	    except ValueError:
 26394	        return root, env.vault.name
