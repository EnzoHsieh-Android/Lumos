 26082	def _drift_probe_old(p, pr, renames, benv, pre, cache):
 26083	    """起點有沒有「同一條」:終點路徑照改名對回起點,再比條件標記 → True/False;沒有起點回 None。cache 存每篇起點的標記集合。"""
 26084	    if benv is None:
 26085	        return None
 26086	    bp = renames.get(pre + p, pre + p)
 26087	    bp = bp[len(pre):] if bp.startswith(pre) else p
 26088	    if bp not in cache:
 26089	        cache[bp] = {tuple(x[2]["conds"]) for x in _probe_lines(env_text(benv, bp) or "")[0]}
 26090	    return tuple(pr["conds"]) in cache[bp]
 26091	
 26092	
 26093	def _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base):
 26094	    """推送判定要的起點資料 → (範圍改動, 起點圖譜, 判不了的原因或 None)。起點的圖譜位置與樹清單都走 _drift_list 的記憶。"""
 26095	    import time as _t
 26096	    ch = _drift_probe_changes(root, base, tip, deadline)
 26097	    if ch is None:
 26098	        return None, None, "git 算不出這次推送改了哪些檔(條件式回頭條件)"
 26099	    if not base:
 26100	        return ch, None, None
 26101	    if deadline is not None and _t.monotonic() >= deadline:
 26102	        return None, None, "預算用完"
 26103	    benv = _drift_tree_env(root, base, _drift_vault_rel(root, base) or vault_rel, override_base, deadline=deadline)
 26104	    if benv is None:
 26105	        return None, None, "git 讀不出起點的筆記(條件式回頭條件)"
 26106	    return ch, benv, None
 26107	
