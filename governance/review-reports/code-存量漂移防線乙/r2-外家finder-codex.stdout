 26636	def cmd_drift_exam(exam, repo, probes=None, at=None, history=None, as_json=False):
 26637	    """lumos drift exam <考卷.json> --repo <被考的 repo>:在被考 repo 的歷史上重放(計劃〈做法〉第 3 節)。
 26638	    不寫治理帳、不寫任何檔。--history N:改成對被考 repo 最近 N 個主線提交各跑一次 check,列出每筆要處理(門檻②)。"""
 26639	    root = Path(repo).resolve()
 26640	    at_sha = _lens_full_sha(root, at or "HEAD")
 26641	    if at_sha is None:
 26642	        print(f"擋下:{repo} 找不到 {at or 'HEAD'}", file=sys.stderr)
 26643	        return 2
 26644	    vault_rel = _drift_vault_rel(root, at_sha)
 26645	    if vault_rel is None:
 26646	        print(f"擋下:{repo} 沒有圖譜", file=sys.stderr)
 26647	        return 2
 26648	    if history:
 26649	        return _drift_exam_history(root, vault_rel, at_sha, history, as_json)
 26650	    qs = _drift_exam_load(exam)
 26651	    if qs is None:
 26652	        return 2
 26653	    probes_map = _drift_exam_load_probes(probes)
 26654	    if probes_map is None:
 26655	        return 2
 26656	    rows, skipped = [], 0
 26657	    for q in qs:
 26658	        if q.get("exam_event") == "mechanism1_experiment":
 26659	            skipped += 1
 26660	            continue
 26661	        res, om, ol, noise = _drift_exam_one(root, vault_rel, q, at_sha, probes_map)
 26662	        rows.append({"id": q.get("id"), "event": q.get("exam_event"), "result": res,
 26663	                     "other_must": om, "other_listed": ol, "noise": noise})
 26664	    return _drift_exam_report(rows, skipped, as_json)
 26665	
 26666	
 26667	def _drift_exam_report(rows, skipped, as_json):
 26668	    """考試結果 → 印表格或 JSON,回 0。"""
 26669	    import json as _j
 26670	    summ = {"擋到": 0, "點到": 0, "漏": 0, "誤列": 0, "沒誤列": 0, "略過": 0}
 26671	    for r in rows:
 26672	        summ["略過" if r["result"].startswith("略過") else r["result"]] += 1
 26673	    tot = {"skipped_mechanism1": skipped, "summary": summ,
 26674	           "誤報_要處理": sum(r["other_must"] for r in rows), "誤報_只列出": sum(r["other_listed"] for r in rows),
 26675	           "噪音最大": max([r["noise"] for r in rows] or [0]), "rows": rows}
 26676	    if as_json:
 26677	        print(_j.dumps(tot, ensure_ascii=False, indent=1))
 26678	        return 0
 26679	    print(f"略過 {skipped} 題(機制①,給實驗計劃)")
 26680	    print("題號  考法            結果        誤報(要處理/只列出)  噪音")
 26681	    for r in rows:
 26682	        print(f"{r['id']:<5} {r['event']:<15} {r['result']:<10}  {r['other_must']}/{r['other_listed']}"
 26683	              f"{'':<16}{r['noise']}")
 26684	    print("合計:" + "、".join(f"{k} {v}" for k, v in summ.items())
 26685	          + f";誤報 要處理 {tot['誤報_要處理']}、只列出 {tot['誤報_只列出']};單一提交噪音最大 {tot['噪音最大']}")
 26686	    return 0
 26687	
