 25568	# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────
 25569	
 25570	def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
 25571	    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
 25572	    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
 25573	    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
 25574	    lst = _drift_list(root, where)
 25575	    if lst is None:
 25576	        return None
 25577	    pre = vault_rel.rstrip("/") + "/"
 25578	    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
 25579	    import time as _t
 25580	    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
 25581	    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
 25582	    blobs = _nodehome_cat_blobs(root, [f"{where}:{p}" for p in paths], timeout=left) if paths else []
 25583	    if blobs is None:
 25584	        return None
 25585	    texts, bad = {}, []
 25586	    for p, b in zip(paths, blobs):
 25587	        if b is None:
 25588	            continue
 25589	        try:
 25590	            texts[p[len(pre):]] = b.decode("utf-8-sig")
 25591	        except UnicodeDecodeError:
 25592	            bad.append(p[len(pre):])
 25593	    texts.update(override or {})
 25594	    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])
 25595	
 25596	
 25597	def _drift_vault_rel(root, where):
 25598	    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
 25599	    lst = _drift_list(root, where)
 25600	    if lst is None:
 25601	        return None
 25602	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 25603	    if not vaults:
 25604	        return None
 25605	    wv = _vault_in(Path(root))
 25606	    try:
 25607	        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
 25608	    except ValueError:
 25609	        wv_rel = None
 25610	    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 25611	
 25612	
 25613	def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
 25614	    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
 25615	    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
 25616	    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
 25617	    import time as _t
 25618	    pre = vault_rel.rstrip("/") + "/"
 25619	    if deadline is not None and _t.monotonic() > deadline:
 25620	        return None
 25621	    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 25622	    if raw is None:
 25623	        return None
 25624	    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
 25625	               if x.strip("\n").startswith(pre)}
 25626	    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
 25627	              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
 25628	    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
 25629	              and _drift_str(n, "status") in _DRIFT_CLOSED}
 25630	    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25631	                                   lambda ty, st: ty == "verification" and st == "pass",
 25632	                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
 25633	    if passed is None:
 25634	        return None
 25635	    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25636	                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
 25637	                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
 25638	    if closed is None:
 25639	        return None
 25640	    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
 25641	            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}
 25642	
 25643	
 25644	def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None, override_base=None):
 25645	    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
 25646	    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
 25647	    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
 25648	    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
 25649	    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
 25650	    import time as _t
 25651	
 25652	    def _left():
 25653	        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
 25654	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
 25655	    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
 25656	    if tenv is None:
 25657	        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
 25658	    if _left() <= 0:
 25659	        return [], [], [over]
 25660	    reader = _nodehome_reader(root, tip)
 25661	    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
 25662	    if ev is None:
 25663	        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
 25664	    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
 25665	               if _note_unreadable(n) and p in ev["touched"]]
 25666	    must, listed = [], []
 25667	    for f in _drift_state_findings(tenv):
 25668	        p, k = f["path"], f["kind"]
 25669	        if k == "c1":
 25670	            if p in ev["passed"]:
 25671	                must.append(f)
 25672	            continue
 25673	        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
 25674	        if hit:
 25675	            listed.append(f)
 25676	    if _left() <= 0:
 25677	        return must, listed, [*unknown, over]
 25678	    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
 25679	    return must + pm, listed + pl, unknown + pu
 25680	
 25681	
 25682	
 25683	# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
 25684	# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
 25685	#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
 25686	# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
 25687	_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
 25688	_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
 25689	_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
 25690	_PROBE_KEYS = ("file", "symbol", "test", "status")
 25691	_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")
 25692	
 25693	
 25694	def _revisit_split(line):
 25695	    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
 25696	    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
 25697	    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
 25698	    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
 25699	    import datetime
 25700	    if line.lstrip().startswith("|"):
 25701	        return None, None
 25702	    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
 25703	    if not s.startswith("REVISIT:"):
 25704	        return None, None
 25705	    rest = s[len("REVISIT:"):]
 25706	    if rest.lstrip().startswith("[when-"):
 25707	        return "cond", rest
 25708	    try:
 25709	        datetime.date.fromisoformat(rest.partition(" ")[0])
 25710	        return "date", rest
 25711	    except ValueError:
 25712	        return "bad", rest
 25713	
 25714	
 25715	def _probe_value_err(k, v):
 25716	    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
 25717	    if k not in _PROBE_KEYS:
 25718	        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
 25719	    if not v:
 25720	        return f"when-{k} 的值是空的"
 25721	
 25722	    if k == "file":
 25723	        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
 25724	    if k in ("symbol", "test"):
 25725	        return _probe_named_err(k, v)
 25726	    node, eq, vals = v.partition("=")
 25727	    if not eq or not node.strip() or not vals.strip():
 25728	        return "when-status 要寫成 <節點>=<值>"
 25729	    if any(not x.strip() for x in vals.split("|")):
 25730	        return "when-status 的值用 | 分開時每一段都不能空"
 25731	    return None
 25732	
 25733	
 25734	def _probe_norm_value(k, v):
 25735	    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
 25736	    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
 25737	    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
 25738	    if k == "file":
 25739	        return nfc(_posix_norm(v))
 25740	    if k in ("symbol", "test") and "::" in v:
 25741	        path, name = v.rsplit("::", 1)
 25742	        return nfc(_posix_norm(path)) + "::" + name.strip()
 25743	    return v
 25744	
 25745	
 25746	def _probe_bad_path(p):
 25747	    return (not p) or p.startswith("/") or ".." in p.split("/")
 25748	
 25749	
 25750	def _probe_named_err(k, v):
 25751	    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
 25752	    if "::" not in v:
 25753	        return None
 25754	    path, name = v.rsplit("::", 1)
 25755	    if not name.strip():
 25756	        return f"when-{k} 的名稱是空的"
 25757	    if _probe_bad_path(path.strip()):
 25758	        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
 25759	    return None
 25760	
 25761	
 25762	def _probe_parse(rest):
 25763	    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
 25764	    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
 25765	    import datetime
 25766	    conds, by, errs, pos = [], None, [], 0
 25767	    while True:
 25768	        m = _PROBE_TOKEN_RE.match(rest, pos)
 25769	        if not m:
 25770	            break
 25771	        pos = m.end()
 25772	        key, val = m.group(1), m.group(2).strip()
 25773	        if key == "by":
 25774	            if by is not None:
 25775	                errs.append("期限寫了兩個")
 25776	                continue
 25777	            try:
 25778	                datetime.date.fromisoformat(val)
 25779	                by = val
 25780	            except ValueError:
 25781	                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
 25782	            continue
 25783	        k = key[len("when-"):]
 25784	        err = _probe_value_err(k, val)
 25785	        if err:
 25786	            errs.append(err)
 25787	        conds.append((k, val if err else _probe_norm_value(k, val)))
 25788	    if not conds:
 25789	        errs.append("沒有條件標記")
 25790	    return {"conds": conds, "by": by, "errs": errs}
 25791	
 25792	
 25793	def _probe_lines(text):
 25794	    """一篇筆記的條件式回頭條件 → (清單[(行號, 原文, 解析結果)], 寫在不評估的地方[(行號, 原文, 原因)])。
 25795	    只認正文與摘要的可見行:圍欄(_visible_lines)、行內程式碼(_strip_inline_markup)、表格行裡的都不算;
 25796	    開頭欄位裡 summary 以外的欄與表格行裡的條件標記列成「寫在不評估的地方」(計劃〈做法〉第 0 節)。"""
 25797	    lines = text.split("\n")
 25798	    regs = _notelines_regions(text)
 25799	    vis = {no for no, _ln in _visible_lines(lines)}
 25800	    out, dead = [], []
 25801	    for i, ln in enumerate(lines, 1):
 25802	        if i not in vis:
 25803	            continue
 25804	        probe = _strip_inline_markup(ln)[0]
 25805	        table = probe.lstrip().startswith("|")
 25806	        if regs[i - 1] in ("body", "summary") and not table:
 25807	            kind, rest = _revisit_split(probe)
 25808	            if kind == "cond":
 25809	                out.append((i, ln.strip(), _probe_parse(rest)))
 25810	            continue
 25811	        if _PROBE_ANY_RE.search(probe):
 25812	            dead.append((i, ln.strip(), "寫在表格行裡,不評估" if table else "寫在開頭欄位裡 summary 以外的欄,不評估"))
 25813	    return out, dead
 25814	
 25815	
 25816	def _drift_probe_code_path(p):
 25817	    """乙拿來判 symbol/test、算候選的檔:副檔名在清單裡或沒副檔名(要看 #!),不含 docs/、governance/。
 25818	    候選篩選(_drift_probe_changes)與語料(_DriftProbeTree.corpus)共用這一支(代碼審 r1 圖譜一致席:原本兩邊範圍不同;
 25819	    正確性席:工具鏈主程式 scripts/lumos 沒有副檔名,原本整支不在語料裡,上面的 symbol 條件全是死條件)。"""
 25820	    return _nodehome_code_kind(p) in ("ext", "shebang?") and not p.startswith(("docs/", "governance/"))
 25821	
 25822	
 25823	def _drift_probe_is_py(p, txt):
 25824	    return p.endswith(".py") or (_nodehome_code_kind(p) == "shebang?" and "python" in txt.split("\n", 1)[0].lower())
 25825	
 25826	
 25827	def _drift_py_names(txt):
 25828	    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
 25829	    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
 25830	    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。"""
 25831	    import ast as _ast
 25832	    try:
 25833	        tree = _ast.parse(txt)
 25834	    except (SyntaxError, ValueError):
 25835	        return None
 25836	    funcs, classes, assigns = set(), set(), set()
 25837	    for node in _ast.walk(tree):
 25838	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
 25839	            funcs.add(node.name)
 25840	        elif isinstance(node, _ast.ClassDef):
 25841	            classes.add(node.name)
 25842	    for node in tree.body:
 25843	        if isinstance(node, _ast.Assign):
 25844	            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
 25845	        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
 25846	            assigns.add(node.target.id)
 25847	    return funcs, classes, assigns
 25848	
 25849	
 25850	def _drift_py_def_re(name, test):
 25851	    """解析不了的 Python 檔退回逐行正則(寧可多認一次,也不讓一支語法壞掉的檔讓整批條件判不了)。"""
 25852	    n = re.escape(name)
 25853	    if test:
 25854	        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
 25855	    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)
 25856	
 25857	
 25858	def _drift_disk_list(root):
 25859	    """工作目錄裡的路徑 → (一般檔集合, 所有路徑) 或 None:index 加上沒追蹤(沒被忽略)的,扣掉磁碟上已經不在的
 25860	    (代碼審 r1 外家席:scan 預設看工作目錄,原本卻讀 index,沒追蹤的新檔判成不存在、刪了沒 stage 的判成還在)。"""
 25861	    lst = _nodehome_list(root, "index")
 25862	    raw = _nodehome_git(root, "ls-files", "--others", "--exclude-standard", "-z") if lst is not None else None
 25863	    if raw is None:
 25864	        return None
 25865	    base = Path(root)
 25866	    allp = sorted(set(lst[1]) | {nfc(os.fsdecode(p)) for p in raw.split(b"\0") if p})
 25867	    allp = [p for p in allp if os.path.lexists(base / p)]
 25868	    files = {p for p in allp if (base / p).is_file() and not (base / p).is_symlink()}
 25869	    return files, allp
 25870	
 25871	
 25872	_DRIFT_LS_CACHE = {}
 25873	
 25874	
 25875	def _drift_list(root, where):
 25876	    """_nodehome_list 加記憶:同一個提交的樹一次 check 裡只列一次(代碼審 r1 併發席:終點列 2 次、起點列 3 次)。
 25877	    只記完整提交編號(內容不會變);index 與其他寫法照舊每次列。"""
 25878	    if not (isinstance(where, str) and re.fullmatch(r"[0-9a-f]{40}", where)):
 25879	        return _nodehome_list(root, where)
 25880	    key = (str(root), where)
 25881	    if key not in _DRIFT_LS_CACHE:
 25882	        got = _nodehome_list(root, where)
 25883	        if got is None:
 25884	            return None
 25885	        if len(_DRIFT_LS_CACHE) >= 8:
 25886	            _DRIFT_LS_CACHE.clear()
 25887	        _DRIFT_LS_CACHE[key] = got
 25888	    return _DRIFT_LS_CACHE[key]
