 23049	def _nodehome_merge_own_changes(repo_root, sha, parents):
 23050	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 23051	
 23052	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 23053	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 23054	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 23055	    或順手多改的部分,正是這道檢查要看的。
 23056	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 23057	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 23058	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 23059	    """
 23060	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 23061	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 23062	        return None
 23063	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 23064	                      "--name-status", "-z", "-M", sha)
 23065	    if r is None:
 23066	        return None
 23067	    paths, src, gone = _nodehome_name_status(r)
 23068	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 23069	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 23070	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 23071	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 23072	    for p in parents:
 23073	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 23074	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 23075	    order = sorted(paths)
 23076	    specs = []
 23077	    for x in order:
 23078	        specs.append(f"{sha}:{x}")
 23079	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 23080	    blobs = _nodehome_cat_blobs(repo_root, specs)
 23081	    if blobs is None or any(ren is None for _, ren in pairs):
 23082	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 23083	        return paths, src, gone
 23084	    kept = set()
 23085	    for n, x in enumerate(order):
 23086	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 23087	        if _nodehome_merge_wrote_new_lines(merged, olds):
 23088	            kept.add(x)
 23089	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 23090	
 23091	
 23092	def _nodehome_cat_blobs(repo_root, specs, timeout=60):
 23093	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 23094	
 23095	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 23096	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 23097	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 23098	    import subprocess as _sp
 23099	    if not specs:
 23100	        return []
 23101	    if any("\n" in s_ for s_ in specs):
 23102	        return None
 23103	    try:
 23104	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 23105	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 23106	                    capture_output=True, timeout=timeout)
 23107	    except (OSError, _sp.TimeoutExpired):
 23108	        return None
 23109	    if r.returncode != 0:
 23110	        return None
 23111	    out, pos, res = r.stdout, 0, []
 23112	    for _ in specs:
 23113	        nl = out.find(b"\n", pos)
 23114	        if nl < 0:
 23115	            return None
 23116	        head = out[pos:nl].split(b" ")
 23117	        pos = nl + 1
 23118	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 23119	            size = int(head[2])
 23120	            res.append(out[pos:pos + size])
 23121	            pos += size + 1
 23122	        elif len(head) == 3 and head[2].isdigit():
 23123	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 23124	            res.append(None)
 23125	        else:
 23126	            res.append(None)            # missing / ambiguous
 23127	    return res
 23128	
 23129	
 23130	def _nodehome_merge_wrote_new_lines(merged, olds):
 23131	    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。
 23132	
 23133	    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
 23134	    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
 23135	    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
 23136	    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
 23137	    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
 23138	    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
 23139	    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
 23140	    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
 23141	    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
 23142	    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
 23143	    new = _merge_new_lines(merged, olds)
 23144	    return True if new is None else bool(new)
 23145	
 24020	        return None
 24021	    texts_by, paths, old_by = ra
 24022	    net = None
 24023	    if keep_other:
 24024	        dn = _ns_diff(repo_root, base_where or _EMPTY_TREE_SHA, tip_where, "--", vault_rel)
 24025	        if dn is None:
 24026	            return None
 24027	        net = {nfc(p): {n for n, _t in rows} for p, rows in _notelines_parse_added(dn).items()}
 24028	    return {p: None for p in paths}, texts_by, old_by, net
 24029	
