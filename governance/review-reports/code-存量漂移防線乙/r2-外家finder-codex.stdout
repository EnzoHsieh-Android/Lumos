 25362	def _drift_fm_end(lines):
 25363	    """開頭欄位收尾那一行的索引(沒有開頭欄位回 0)。"""
 25364	    if not lines or lines[0].strip() != "---":
 25365	        return 0
 25366	    for i in range(1, len(lines)):
 25367	        if lines[i].strip() == "---":
 25368	            return i
 25369	    return 0
 25370	
