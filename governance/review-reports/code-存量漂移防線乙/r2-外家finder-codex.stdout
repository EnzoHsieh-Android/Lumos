 26435	def _drift_scan_print(at, left, done, bad, probs=()):
 26436	    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)、回頭條件的問題。"""
 26437	    if bad:
 26438	        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(bad[:10]))
 26439	    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
 26440	    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
 26441	          + (f";已表態 {len(done)}" if done else ""))
 26442	    for k in _DRIFT_KINDS:
 26443	        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
 26444	        if rows:
 26445	            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
 26446	            for f, acked in rows:
 26447	                print(f"  {f['path']}:{f['line']}  {f['text'][:70]}" + ("  (已表態)" if acked else ""))
 26448	                if not acked:
 26449	                    print(f"      {f['why']}")
 26450	    if probs:
 26451	        print(f"[回頭條件的問題] {len(probs)} 處(寫錯、沒帶期限、指不到、寫在不評估的地方、判不了):")
 26452	        for p, n, t, w in probs:
 26453	            print(f"  {p}:{n}  {t[:70]}")
 26454	            print(f"      {w}")
