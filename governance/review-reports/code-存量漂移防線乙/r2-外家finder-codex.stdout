 24929	def _note_audit_batches(pending):
 24930	    """待審超過 150 行就切:先照筆記分組、同篇同份;單篇超過時在小標題邊界切;單一小標題下還超過就照行數硬切。"""
 24931	    groups = []
 24932	    for p in sorted({it["path"] for it in pending}):
 24933	        rows = [it for it in pending if it["path"] == p]
 24934	        if len(rows) <= _NOTE_AUDIT_BATCH:
 24935	            groups.append(rows)
 24936	            continue
 24937	        units, seen = [], {}
 24938	        for it in rows:                         # 同一編號的幾處(同篇、同小標題)當成一個單位,不拆到兩份清單
 24939	            if it["id"] in seen:
 24940	                seen[it["id"]].append(it)
 24941	            else:
 24942	                seen[it["id"]] = [it]
 24943	                units.append(seen[it["id"]])
 24944	        # 單一編號就超過一份的上限:只列前 150 處(上限不破);清單少了幾處,輕的判定就收不下——
 24945	        # 那麼多處一字不差的行本來就該改寫(代碼審 r2 外家席)
 24946	        units = [u[:_NOTE_AUDIT_BATCH] for u in units]
 24947	        cur, cur_head = [], None
 24948	        for u in units:
 24949	            it = u[0]
 24950	            new_head = cur and it["heading"] != cur_head
 24951	            if cur and (len(cur) + len(u) > _NOTE_AUDIT_BATCH or (new_head and _note_audit_head_split(rows, cur, it))):
 24952	                groups.append(cur)
 24953	                cur = []
 24954	            cur.extend(u)
 24955	            cur_head = it["heading"]
 24956	        if cur:
 24957	            groups.append(cur)
 24958	    batches, cur = [], []
 24959	    for g in groups:
 24960	        if cur and len(cur) + len(g) > _NOTE_AUDIT_BATCH:
 24961	            batches.append(cur)
 24962	            cur = []
 24963	        cur.extend(g)
 24964	    if cur:
 24965	        batches.append(cur)
 24966	    return batches
 24967	
