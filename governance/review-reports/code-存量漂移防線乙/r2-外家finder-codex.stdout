 25890	
 25891	class _DriftProbeTree:
 25892	    """某一版(提交的樹,或工作目錄 'disk')上判 file/symbol/test 條件用的快照,只由 _drift_probe_tree 在列得出路徑時建
 25893	    (讀不到就不建,跟 _nodehome_side 同一種失敗編碼;代碼審 r1 架構對齊席)。檔案內容用到才讀、讀過記住;
 25894	    帶路徑的條件只讀那一支(併發席:原本一律整批讀全庫)。status 不在這裡判——它只要筆記,不要 git。"""
 25895	
 25896	    def __init__(self, root, where, files, layout, deadline=None):
 25897	        import time as _t
 25898	        self.root, self.where, self.files, self.layout, self.deadline, self._t = root, where, files, layout, deadline, _t
 25899	        self._text, self._corpus, self._py = {}, {}, {}
 25900	
 25901	    def _read(self, paths):
 25902	        """把還沒讀過的讀進來;讀不了(git 失敗、預算用完)回 False。"""
 25903	        todo = [p for p in paths if p not in self._text]
 25904	        if not todo:
 25905	            return True
 25906	        if self.where == "disk":
 25907	            for p in todo:
 25908	                try:
 25909	                    self._text[p] = (Path(self.root) / p).read_bytes().decode("utf-8", errors="replace")
 25910	                except OSError:
 25911	                    self._text[p] = None
 25912	            return True
 25913	        if self.deadline is not None and self._t.monotonic() >= self.deadline:
 25914	            return False
 25915	        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
 25916	        blobs = _nodehome_cat_blobs(self.root, [f"{self.where}:{p}" for p in todo], timeout=left)
 25917	        if blobs is None:
 25918	            return False
 25919	        for p, b in zip(todo, blobs):
 25920	            self._text[p] = None if b is None else b.decode("utf-8", errors="replace")
 25921	        return True
 25922	
 25923	    def corpus(self, test):
 25924	        """程式檔(test=False)或測試檔的路徑清單;讀不了回 None。沒副檔名的要開頭是 #! 才算。"""
 25925	        if test not in self._corpus:
 25926	            paths = sorted(p for p in self.files if _drift_probe_code_path(p) and _nodehome_is_test(p, self.layout) == test)
 25927	            if not self._read(paths):
 25928	                return None
 25929	            self._corpus[test] = [p for p in paths if self._text.get(p) is not None and (
 25930	                _nodehome_code_kind(p) == "ext" or self._text[p].startswith("#!"))]
 25931	        return self._corpus[test]
 25932	
 25933	    def _defines(self, p, name, test):
 25934	        txt = self._text.get(p)
 25935	        if txt is None or not re.search(rf"(?<![\w]){re.escape(name)}(?![\w])", txt):
 25936	            return False
 25937	        if not _drift_probe_is_py(p, txt):
 25938	            return True
 25939	        if p not in self._py:
 25940	            self._py[p] = _drift_py_names(txt)
 25941	        names = self._py[p]
 25942	        if names is None:
 25943	            return bool(_drift_py_def_re(name, test).search(txt))
 25944	        return name in names[0] or (not test and (name in names[1] or name in names[2]))
 25945	
 25946	    def one(self, k, v):
 25947	        """file/symbol/test 一個條件 → True / False / None(判不了)。"""
 25948	        if k == "file":
 25949	            return v in self.files
 25950	        test = k == "test"
 25951	        path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
 25952	        path, name = path.strip(), name.strip()
 25953	        if path:
 25954	            if path not in self.files:
 25955	                return False
 25956	            if not self._read([path]):
 25957	                return None
 25958	            items = [path]
 25959	        else:
 25960	            items = self.corpus(test)
 25961	            if items is None:
 25962	                return None
 25963	        return any(self._defines(p, name, test) for p in items)
 25964	
 25965	
 25966	def _drift_probe_tree(root, where, deadline=None):
 25967	    """→ _DriftProbeTree 或 None(git 列不出路徑、不是 git 專案、或預算已用完)。where:完整提交編號或 'disk'。"""
 25968	    import time as _t
 25969	    if deadline is not None and _t.monotonic() >= deadline:
 25970	        return None
 25971	    lst = _drift_disk_list(root) if where == "disk" else _drift_list(root, where)
 25972	    if lst is None:
 25973	        return None
 25974	    return _DriftProbeTree(root, where, set(lst[0]), _nodehome_layout(lst[1]), deadline)
 25975	
 25976	
 25977	def _drift_probe_one(tree, env, k, v):
 25978	    """一個條件 → True / False / None(判不了)。status 只看筆記(env),不需要 git——不是 git 專案也判得了
 25979	    (代碼審 r1 正確性席);指到的筆記讀不出來算判不了(外家席:原本當成不成立,靜默放行)。"""
 25980	    if k == "status":
 25981	        node, _eq, vals = v.partition("=")
 25982	        rel = env.resolve(link_target(node.strip())) if env is not None else None
 25983	        n = env.notes.get(rel) if rel else None
 25984	        if n is not None and _note_unreadable(n):
 25985	            return None
 25986	        return n is not None and _drift_str(n, "status") in {x.strip() for x in vals.split("|")}
 25987	    return None if tree is None else tree.one(k, v)
 25988	
 25989	
 25990	def _drift_probe_line(tree, env, conds):
 25991	    """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
 25992	    vals = [_drift_probe_one(tree, env, k, v) for k, v in conds]
 25993	    if any(x is False for x in vals):
 25994	        return False
 25995	    return None if any(x is None for x in vals) else True
