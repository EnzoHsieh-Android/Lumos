 22914	def _nodehome_required(repo_root, side, cfg, vendored_skip):
 22915	    """[S1] 需要家的檔集合,另回檔名不是 UTF-8 的程式檔(永遠寫不進圖譜,只提醒改名或排除)。"""
 22916	    import fnmatch
 22917	    req, bad_names = set(), set()
 22918	    layout = _nodehome_layout(side.all_paths)   # 測試資料夾要旁邊的程式目標有同一種檔
 22919	    for p in side.files:
 22920	        kind = _nodehome_code_kind(p)
 22921	        if kind is None:
 22922	            continue
 22923	        if any(fnmatch.fnmatch(p, g) for g in _NODEHOME_EXCLUDE_GLOBS):
 22924	            continue
 22925	        if p in vendored_skip or _cochange_excluded(p, cfg["ignore"]) or _nodehome_is_test(p, layout):
 22926	            continue
 22927	        if kind == "shebang?":
 22928	            if p in side.shebang:
 22929	                ok = side.shebang[p]
 22930	            elif side.share is not None and p not in side.changed and p in side.share.shebang:
 22931	                ok = side.shebang[p] = side.share.shebang[p]
 22932	            else:
 22933	                head = side._reader(p)
 22934	                ok = side.shebang[p] = _head_is_shebang(head)
 22935	            if not ok:
 22936	                continue
 22937	        try:
 22938	            p.encode("utf-8")
 22939	        except UnicodeEncodeError:
 22940	            bad_names.add(p)
 22941	            continue
 22942	        req.add(p)
 22943	    return req, bad_names
