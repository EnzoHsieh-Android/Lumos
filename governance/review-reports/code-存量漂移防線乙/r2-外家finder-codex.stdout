 25816	def _drift_probe_code_path(p):
 25817	    """乙拿來判 symbol/test、算候選的檔:副檔名在清單裡或沒副檔名(要看 #!),不含 docs/、governance/。
 25818	    候選篩選(_drift_probe_changes)與語料(_DriftProbeTree.corpus)共用這一支(代碼審 r1 圖譜一致席:原本兩邊範圍不同;
 25819	    正確性席:工具鏈主程式 scripts/lumos 沒有副檔名,原本整支不在語料裡,上面的 symbol 條件全是死條件)。"""
 25820	    return _nodehome_code_kind(p) in ("ext", "shebang?") and not p.startswith(("docs/", "governance/"))
