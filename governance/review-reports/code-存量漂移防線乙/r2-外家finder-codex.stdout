 24089	def _notelines_headings(text, regs):
 24090	    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
 24091	    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
 24092	    lines = text.split("\n")
 24093	    vis = {i for i, _l in _visible_lines(lines)}
 24094	    dfields = _notelines_decision_fields(text)
 24095	    out, cur = [], ""
 24096	    for i, ln in enumerate(lines, 1):
 24097	        reg = regs[i - 1]
 24098	        if reg == "body" and i in vis:
 24099	            m = _NOTELINES_HEADING_RE.match(ln)
 24100	            if m:
 24101	                cur = m.group(1).strip()
 24102	        if reg == "summary":
 24103	            out.append("summary")
 24104	        elif reg == "decisions":
 24105	            did, f, _v = dfields.get(i, ("", "", True))
 24106	            out.append(f"decisions/{did}/{f}")
 24107	        elif reg == "body":
 24108	            out.append(cur)
 24109	        else:
 24110	            out.append("")
 24111	    return out
