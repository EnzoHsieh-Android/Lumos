 22992	def _nodehome_changes(repo_root, base, tip):
 22993	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22994	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22995	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22996	    if tip == "index":
 22997	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22998	        if base is None:
 22999	            args.append(_EMPTY_TREE_SHA)
 23000	    else:
 23001	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 23002	    raw = _nodehome_git(repo_root, *args)
 23003	    if raw is None:
 23004	        return None
 23005	    toks = _nodehome_split_z(raw)
 23006	    out, i = [], 0
 23007	    while i < len(toks):
 23008	        st = toks[i]
 23009	        code = st[:1]
 23010	        if code in ("R", "C") and i + 2 < len(toks):
 23011	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 23012	            i += 3
 23013	        elif i + 1 < len(toks):
 23014	            p = nfc(toks[i + 1])
 23015	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 23016	            i += 2
 23017	        else:
 23018	            break
 23019	    return out
 23020	
