 23972	def _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, *, reader, mark, hook=_NOTELINES_PRECOMMIT,
 23973	                   per_commit=True, exclude_remote=True, max_count=None, keep_other=False):
 23974	    """範圍裡新寫、而且終點版本還在的筆記行——筆記形狀擋與筆記內容審共用(Projects/筆記內容審_計劃 [S1][S2])。
 23975	    → (notes, errs, old_by) 或 None(git 失敗)。notes=[(路徑, 全文, [(行號, 行文字, 區塊)])],只收 body/summary/
 23976	    decisions 三塊的非空行;errs=讀不成 UTF-8 的筆記;old_by={NFC 路徑: 這道檢查還沒上線時寫的行}。
 23977	    ★per_commit★:True=逐提交看「那個提交自己的 hook 有沒有 mark」(提交前掛鉤在寫的那一刻跑,第一層);
 23978	    False=不逐提交判、只靠範圍截斷(推送時才跑的閘,跑的是當下工作目錄那份掛鉤,第二層)——★要明寫傳 False★,
 23979	    不傳會落到第一層的預設。找不到上線點時照既有語意不過濾。
 23980	    keep_other=True 時開頭欄位其他欄(區塊 other)的新行也收——只給筆記形狀擋查「條件標記寫在不評估的地方」用
 23981	    (存量漂移防線 [S10]),既有規則照舊只看 body/summary/decisions。"""
 23982	    if staged:
 23983	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23984	        if d is None:
 23985	            return None
 23986	        added = {p: rows for p, rows in _notelines_parse_added(d).items() if p.endswith(".md")}
 23987	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23988	        texts_by, old_by, net = None, {}, None
 23989	    else:
 23990	        live_mark = mark if (per_commit and _nodehome_golive(repo_root, tip_where, mark, hook)) else None
 23991	        rc = _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count,
 23992	                                   hook, keep_other)
 23993	        if rc is None:
 23994	            return None
 23995	        cand, texts_by, old_by, net = rc
 23996	    notes, errs = [], []
 23997	    for p, linenos in sorted(cand.items()):
 23998	        b = reader(p)
 23999	        if b is None:
 24000	            continue
 24001	        try:
 24002	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 24003	        except UnicodeDecodeError:
 24004	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 24005	            continue
 24006	        texts = None if texts_by is None else texts_by.get(nfc(p), ())
 24007	        netl = None if net is None else net.get(nfc(p), ())
 24008	        notes.append((p, text, _notelines_rows(text, linenos, texts, keep_other, netl)))
 24009	    return notes, errs, old_by
 24010	
 24011	
 24012	def _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count, hook,
 24013	                          keep_other):
 24014	    """推送範圍的候選 → (候選 {路徑: None}, 逐提交新增的文字, 還沒上線時寫的行, 範圍淨差異的新增行號或 None);git 失敗回 None。
 24015	    開頭欄位其他欄的行要對「範圍淨差異」的行號:逐提交的文字集合分不出位置,舊欄位裡跟正文新行一字不差的那一行
 24016	    會被當成新寫(存量漂移防線乙代碼審 r1 外家席;staged 模式本來就對行號)。只在 keep_other 時多一次 diff。"""
 24017	    ra = _notelines_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
 24018	                                mark=live_mark, max_count=max_count, hook=hook)
 24019	    if ra is None:
 24020	        return None
 24021	    texts_by, paths, old_by = ra
 24022	    net = None
 24023	    if keep_other:
 24024	        dn = _ns_diff(repo_root, base_where or _EMPTY_TREE_SHA, tip_where, "--", vault_rel)
 24025	        if dn is None:
 24026	            return None
 24027	        net = {nfc(p): {n for n, _t in rows} for p, rows in _notelines_parse_added(dn).items()}
 24028	    return {p: None for p in paths}, texts_by, old_by, net
