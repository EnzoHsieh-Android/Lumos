 24264	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
 24265	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 24266	    reader = _nodehome_reader(repo_root, tip_where)
 24267	    lst = _nodehome_list(repo_root, tip_where)
 24268	    if lst is None:
 24269	        return None
 24270	    files = lst[0]
 24271	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 24272	    _names, _name_cache = {}, {}
 24273	    for p in files:
 24274	        if _nodehome_code_kind(p) is not None:
 24275	            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 24276	
 24277	    def by_name(name):
 24278	        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
 24279	        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
 24280	        if name not in _name_cache:
 24281	            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
 24282	        return _name_cache[name]
 24283	    viol = []
 24284	    # 1) 這次新增的行(跟筆記內容審共用同一支,Projects/筆記內容審_計劃 [S1])
 24285	    mk = mark or _NOTE_SHAPE_GOLIVE_MARK
 24286	    res = _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, reader=reader, mark=mk,
 24287	                         exclude_remote=exclude_remote, max_count=max_count, keep_other=True)
 24288	    if res is None:
 24289	        return None
 24290	    notes, errs, old_by = res
 24291	    for p, text, rows in notes:
 24292	        regen = _ns_is_regen(text)
 24293	        vis = {no for no, _l in _visible_lines(text.split("\n"))}
 24294	        for i, ln, reg in rows:
 24295	            if reg != "other":
 24296	                for rule, frag, fix in _ns_check_line(repo_root, ln, reg, files, reader, top_dirs, by_name, regen):
 24297	                    viol.append((p, i, rule, frag, fix))
 24298	            for rule, frag, fix in _ns_revisit_violations(ln, reg, i in vis):
 24299	                viol.append((p, i, rule, frag, fix))
 24300	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 24301	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 24302	                             tip_where, reader)
 24303	    if became:
 24304	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 24305	        if gl is not None:
 24306	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 24307	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 24308	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 24309	            spec = "" if tip_where == "index" else tip_where
 24310	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 24311	            gl_reader = _nodehome_reader(repo_root, gl)
 24312	            seen = {(v[0], v[1]) for v in viol}
 24313	            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
 24314	            for p, blob in zip(notes_, blobs):
 24315	                if blob is None:
 24316	                    continue
 24317	                text = blob.decode("utf-8-sig", errors="replace")
 24318	                if not any(x in text for x in keys):
 24319	                    continue
 24320	                old, regs_, regen_ = None, _notelines_regions(text), _ns_is_regen(text)
 24321	                for n, ln in enumerate(text.split("\n"), 1):
 24322	                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
 24323	                        continue
 24324	                    if old is None:
 24325	                        ob = gl_reader(p)
 24326	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 24327	                    if ln.strip() in old or ln.strip() in old_by.get(nfc(p), ()):
 24328	                        continue
 24329	                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
 24330	                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
 24331	                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
 24332	                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
 24333	                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
 24334	                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
 24335	                                                             for x in became):
 24336	                            continue
 24337	                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
 24338	                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
 24339	    return viol, errs
