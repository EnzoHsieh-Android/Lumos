 24031	def _notelines_rows(text, linenos, texts, keep_other, net):
 24032	    """一篇筆記裡算新寫的行 → [(行號, 行文字, 區塊)]。linenos:staged 的新增行號;texts:推送範圍逐提交新增的文字;
 24033	    net:推送範圍淨差異的新增行號(只拿來核對開頭欄位其他欄)。"""
 24034	    lines = text.split("\n")
 24035	    regs = _notelines_regions(text)
 24036	    rows = []
 24037	    for i, ln in enumerate(lines, 1):
 24038	        if linenos is not None and i not in linenos:
 24039	            continue
 24040	        if texts is not None and ln.strip() not in texts:
 24041	            continue
 24042	        if not ln.strip() or (regs[i - 1] == "other" and not keep_other):
 24043	            continue
 24044	        if regs[i - 1] == "other" and net is not None and i not in net:
 24045	            continue
 24046	        rows.append((i, ln, regs[i - 1]))
 24047	    return rows
