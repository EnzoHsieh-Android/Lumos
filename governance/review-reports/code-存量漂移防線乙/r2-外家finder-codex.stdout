 25302	def cmd_note_audit_skip(repo=None, diff_range=None, note=None):
 25303	    """lumos note-audit skip --diff A..B --note "理由"(計劃〈做法〉第 3 節第 7 點):只略過從來沒被判過的行。"""
 25304	    root = _note_audit_root(repo)
 25305	    if root is None:
 25306	        return 2
 25307	    if not note or len(note.strip()) < 4:
 25308	        print("擋下:--note 要寫理由,至少 4 個字", file=sys.stderr)
 25309	        return 2
 25310	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "筆記內容審")
 25311	    if tip is None or isinstance(tip, int):
 25312	        return tip if isinstance(tip, int) else 0
 25313	    got = _note_audit_items(root, base, tip, vault_rel)
 25314	    if got is None:
 25315	        return 2
 25316	    items, _errs = got
 25317	    docs, _bad = _note_audit_load_verdicts(root, None)
 25318	    fold = _note_audit_fold(docs)
 25319	    judged = set(fold)
 25320	    todo = sorted({it["id"] for it in items if it["id"] not in judged})
 25321	    heavy = sorted({it["id"] for it in items if fold.get(it["id"]) in ("CODE", "MIXED")})
 25322	    if heavy:
 25323	        print(f"注意:{len(heavy)} 行已經判了推得出或一半一半,不能略過——要刪、改,或申訴", file=sys.stderr)
 25324	    if not todo:
 25325	        print("沒有可以略過的行")
 25326	        return 0
 25327	    name = _note_audit_write_verdict(root, {"version": 1, "kind": "略過", "note": note.strip(),
 25328	                                            "rows": [{"id": i, "class": "SKIP"} for i in todo]})
 25329	    _gate_event_or_warn(root, "note-audit", "skipped", f"{name}:略過 {len(todo)} 行:{note.strip()[:80]}")
 25330	    print(f"略過 {len(todo)} 行,寫進 {name};要提交才算數:\n    git add {_NOTE_AUDIT_VERDICT_DIR} && git commit")
 25331	    return 0
