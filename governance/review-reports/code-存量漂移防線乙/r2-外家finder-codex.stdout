+def _drift_py_names(txt):
+    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
+    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
+    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。"""
+    import ast as _ast
+    try:
+        tree = _ast.parse(txt)
+    except (SyntaxError, ValueError):
+        return None
+    funcs, classes, assigns = set(), set(), set()
+    for node in _ast.walk(tree):
+        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
+            funcs.add(node.name)
+        elif isinstance(node, _ast.ClassDef):
+            classes.add(node.name)
+    for node in tree.body:
+        if isinstance(node, _ast.Assign):
+            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
+        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
+            assigns.add(node.target.id)
+    return funcs, classes, assigns
+
+
+def _drift_py_def_re(name, test):
