 25858	def _drift_disk_list(root):
 25859	    """工作目錄裡的路徑 → (一般檔集合, 所有路徑) 或 None:index 加上沒追蹤(沒被忽略)的,扣掉磁碟上已經不在的
 25860	    (代碼審 r1 外家席:scan 預設看工作目錄,原本卻讀 index,沒追蹤的新檔判成不存在、刪了沒 stage 的判成還在)。"""
 25861	    lst = _nodehome_list(root, "index")
 25862	    raw = _nodehome_git(root, "ls-files", "--others", "--exclude-standard", "-z") if lst is not None else None
 25863	    if raw is None:
 25864	        return None
 25865	    base = Path(root)
 25866	    allp = sorted(set(lst[1]) | {nfc(os.fsdecode(p)) for p in raw.split(b"\0") if p})
 25867	    allp = [p for p in allp if os.path.lexists(base / p)]
 25868	    files = {p for p in allp if (base / p).is_file() and not (base / p).is_symlink()}
 25869	    return files, allp
