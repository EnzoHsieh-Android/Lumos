 24918	    if tpl.lstrip().startswith("<!--") and "-->" in tpl:
 24919	        tpl = tpl.split("-->", 1)[1].lstrip("\n")
 24920	    try:
 24921	        cnt = sorted(_stack_ext_counts(Path(root)).items(), key=lambda kv: -kv[1])[:5]
 24922	        stacks = "主要程式檔副檔名:" + (", ".join(f"{e}×{n}" for e, n in cnt) if cnt else "未偵測到")
 24923	    except OSError:
 24924	        stacks = "主要程式檔副檔名:未偵測到"
