 24405	    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
 24406	    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
 24407	    # 上限用「最新 N 個提交」算,不用 tip~N:沿第一個上一版數的邊界在合併式歷史裡會退到上線點之前、或根本數不到 N 步
 24408	    # 而整個取消(代碼審 r2、r3 通才席);起點固定在上線點
 24409	    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False,
 24410	                           max_count=_NS_DOCTOR_SCAN_CAP if capped else None)
 24411	    if capped:
 24412	        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
 24413	    if res:
 24414	        viol, _errs = res
