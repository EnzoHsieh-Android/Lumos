 26397	def cmd_drift_scan(env, at=None, as_json=False, budget=None):
 26398	    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
 26399	    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
 26400	    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
 26401	    import json as _j, time as _t
 26402	    budget = _DRIFT_BUDGET_SEC if budget is None else budget
 26403	    if budget <= 0:
 26404	        print("擋下:--budget 要大於 0 秒", file=sys.stderr)
 26405	        return 2
 26406	    deadline = _t.monotonic() + budget
 26407	    root, vault_rel = _drift_vault_of(env)
 26408	    tenv, sha = env, None
 26409	    if at:
 26410	        sha = _lens_full_sha(root, at)
 26411	        if sha is None:
 26412	            print(f"擋下:找不到提交 {at}", file=sys.stderr)
 26413	            return 2
 26414	        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
 26415	        vault_rel = _drift_vault_rel(root, sha) or vault_rel
 26416	        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
 26417	        if tenv is None:
 26418	            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
 26419	            return 2
 26420	    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
 26421	    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
 26422	    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
 26423	    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
 26424	    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
 26425	    if as_json:
 26426	        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
 26427	                        "problems": [{"path": p, "line": n, "text": t, "why": w} for p, n, t, w in probs],
 26428	                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
 26429	                       ensure_ascii=False, indent=1))
 26430	        return 0
 26431	    _drift_scan_print(at, left, done, bad, probs)
 26432	    return 0
 26433	
 26434	
 26435	def _drift_scan_print(at, left, done, bad, probs=()):
 26436	    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)、回頭條件的問題。"""
 26437	    if bad:
 26438	        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(bad[:10]))
 26439	    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
 26440	    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
 26441	          + (f";已表態 {len(done)}" if done else ""))
 26442	    for k in _DRIFT_KINDS:
 26443	        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
 26444	        if rows:
 26445	            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
 26446	            for f, acked in rows:
 26447	                print(f"  {f['path']}:{f['line']}  {f['text'][:70]}" + ("  (已表態)" if acked else ""))
 26448	                if not acked:
 26449	                    print(f"      {f['why']}")
 26450	    if probs:
 26451	        print(f"[回頭條件的問題] {len(probs)} 處(寫錯、沒帶期限、指不到、寫在不評估的地方、判不了):")
 26452	        for p, n, t, w in probs:
 26453	            print(f"  {p}:{n}  {t[:70]}")
 26454	            print(f"      {w}")
 26455	
 26456	
 26457	def _drift_doctor_lines(env):
 26458	    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
 26459	    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
 26460	    root, vault_rel = _drift_vault_of(env)
 26461	    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
 26462	    out = []
 26463	    # 乙:只讀筆記、不評估條件(要看哪些成立跑 drift scan)
 26464	    n_rows = n_noby = n_bad = n_dead = 0
 26465	    for p in env.notes:
 26466	        rows, dead = _probe_lines(env_text(env, p) or "")
 26467	        n_rows += len(rows)
 26468	        n_dead += len(dead)
 26469	        n_noby += sum(1 for _n, _t, pr in rows if pr["by"] is None)
 26470	        n_bad += sum(1 for _n, _t, pr in rows if pr["errs"])
 26471	    if n_rows or n_dead:
 26472	        out.append(f"條件式回頭條件 {n_rows} 條(由 lumos drift scan 評估)"
 26473	                   + (f";沒帶期限 {n_noby} 條" if n_noby else "") + (f";寫錯的 {n_bad} 條" if n_bad else "")
 26474	                   + (f";寫在不評估的地方 {n_dead} 處" if n_dead else ""))
 26475	    for k in ("c1", "c2", "c3", "c4", "c5"):
 26476	        rows = [f for f in left if f["kind"] == k]
 26477	        nd = sum(1 for f in done if f["kind"] == k)
 26478	        if rows:     # 只剩已表態的不開段(全靜默;代碼審 r2 正確性席:表態完那一段永遠不會安靜);全部清單看 drift scan
 26479	            ex = ";".join(f"{f['path'][:-3]}:{f['line']}" for f in rows[:3])
 26480	            out.append(f"[{k}] {_DRIFT_KIND_NAMES[k]} {len(rows)} 筆(例:{ex})" + (f";另 {nd} 筆已表態" if nd else ""))
 26481	    return out
 26482	
 26483	
 26484	def _drift_gate_doctor_lines(repo_root):
 26485	    """doctor 開頭的閘提醒(照筆記形狀擋與筆記內容審那兩支的位置與呈現):開關不是 block,而且專案自己寫了開關或已經接線時講
 26486	    (沒寫設定也沒接線時預設就是 warn,每次都唸只是噪音;計劃 [S14] 已跟著改);
 26487	    只收專案根:鄰居多收的圖譜位置與 ci 旗標是給它們的事後掃描用的,這支沒有事後掃描(代碼審 r3 架構對齊席:抄了參數不用是死參數)。
 26488	    接線後(推送前掛鉤出現標記)專案 CI 沒呼叫 drift check 就給要貼的步驟。唯一的 git 呼叫是讀一次推送前掛鉤。"""
 26489	    out = []
 26490	    root = Path(repo_root)
 26491	    cp = root / ".lumos" / "config.json"
 26492	    txt = None
 26493	    try:        # .lumos 資料夾本身是捷徑也不跟(照 _note_audit_doctor_lines;代碼審 r2 架構對齊席)
 26494	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 26495	            txt = cp.read_bytes()
 26496	    except OSError:
 26497	        txt = None
 26498	    mode, cfg_warns, explicit = _drift_config(txt)
 26499	    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
 26500	    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
 26501	    # 開關不是 block 時講一聲——只在專案自己寫了開關、或已經接線時(代碼審 r1 外家席:關掉了要看得見);
 26502	    # 還沒接線又沒寫設定時預設本來就是 warn,每個專案每次 doctor 都多一行只是噪音(代碼審 r3:那一行也破壞既有測試
 26503	    # t_doctor_summary_admits_soft_reminders 的軟段計數)
 26504	    if mode != "block" and (wired or explicit):
 26505	        src = (f"({cfg_warns[0]})" if cfg_warns else "(.lumos/config.json 的 drift_check)" if explicit
 26506	               else "(沒寫設定,這是預設值)")
 26507	        out.append(f"這個專案的存量漂移檢查是 {mode}{src}——轉正後留著預告句的推送不會被擋")
 26508	    wf = root / ".github" / "workflows"
 26509	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 26510	    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
 26511	    if wired and ymls and "drift check" not in body:
 26512	        out.append("專案 CI 沒呼叫 `lumos drift check`,`--no-verify` 推上去的沒人查——CI 在 note-audit 那步後面加:"
 26513	                   "\n    - run: python3 scripts/lumos drift check --diff \"${{ github.event.before || "
 26514	                   "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"")
 26515	    return out
 26516	
