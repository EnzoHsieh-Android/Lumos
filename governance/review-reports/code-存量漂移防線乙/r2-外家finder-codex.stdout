 25372	def _drift_field_line(text, key, pred=None):
 25373	    """開頭欄位裡某個頂層鍵所在的行號(1 起算);找不到回 1。欄位層級的發現回報這一行。
 25374	    pred 給了就在那個鍵的值範圍(鍵那一行到下一個頂層鍵之前)裡找第一個 pred 成立的行(清單或多行寫法時指到真正那一行)。"""
 25375	    lines = text.split("\n")
 25376	    e = _drift_fm_end(lines)
 25377	    for i in range(1, e):
 25378	        m = TOP_KEY_RE.match(lines[i])
 25379	        if not (m and m.group(1) == key):
 25380	            continue
 25381	        if pred is None:
 25382	            return i + 1
 25383	        for j in range(i, e):
 25384	            if j > i and TOP_KEY_RE.match(lines[j]):
 25385	                break
 25386	            if pred(lines[j]):
 25387	                return j + 1
 25388	        return i + 1
 25389	    return 1
 25390	
