 23872	def _ns_exclusions(repo_root, tip):
 23873	    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
 23874	    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
 23875	    out = []
 23876	    for ref in _ns_mainline_refs(repo_root):
 23877	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
 23878	        if r is not None and r.returncode == 1:
 23879	            out.append(ref)
 23880	    return out
