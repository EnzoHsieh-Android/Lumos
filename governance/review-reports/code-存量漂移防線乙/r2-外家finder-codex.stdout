 22860	def _nodehome_parse_note(raw):
 22861	    """節點原文 → {type, status, about[], resp, sig, text}。sig=(摘要, 解析後的決策, 正文)——[S12] 內容有變
 22862	    逐欄比對用;★不沿用只算正文的那支雜湊★:摘要與決策都在開頭欄位裡,節點長大主要就長在摘要。"""
 22863	    text = raw.decode("utf-8-sig", errors="replace") if isinstance(raw, (bytes, bytearray)) else str(raw)
 22864	    fm_lines, body = split_frontmatter(text)
 22865	    fields = {}
 22866	    dec = ""
 22867	    if fm_lines is not None:
 22868	        fields, _bk, _lint = parse_frontmatter(fm_lines)
 22869	        # 決策比「解析後的值」:只把 content: a 改成 content: "a" 這種等價寫法不算內容有變(第二輪外家席)
 22870	        try:
 22871	            dec = json.dumps(parse_decisions(fm_lines), ensure_ascii=False, sort_keys=True)
 22872	        except Exception:
 22873	            dec = "\n".join(l.rstrip() for l in fm_lines if l.startswith(("decisions:", "  ")))
 22874	    summ = fields.get("summary")
 22875	    summ = summ if isinstance(summ, str) else ""
 22876	    return {"type": str(fields.get("type", "")).strip(),
 22877	            "status": str(fields.get("status", "")).strip(),
 22878	            "about": [str(x) for x in as_list(fields.get("about_code")) if str(x).strip()],
 22879	            "resp": fields.get("responsibility") if isinstance(fields.get("responsibility"), str) else None,
 22880	            # [S11] 從程式重建的章:蓋了章就代表這篇是還原出來的,那它更要說清楚自己管哪些檔
 22881	            "regen": fields.get("regen").strip() if isinstance(fields.get("regen"), str) else "",
 22882	            "sig": ("\n".join(l.rstrip() for l in summ.splitlines()).strip(), dec,
 22883	                    "\n".join(l.rstrip() for l in body.splitlines()).strip()),
 22884	            "text": text}
