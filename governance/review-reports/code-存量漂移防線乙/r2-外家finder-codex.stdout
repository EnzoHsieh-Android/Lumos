 22616	# 斜線也算檔名字元:不然正文寫 lib/src/pay.py 會被判成「有提到 src/pay.py」(代碼審 r2 合約席)
 22617	_HOME_MENTION_BOUNDARY = re.compile(r"[A-Za-z0-9_.@+/\-]")
 22618	
 22619	
 22620	def _home_mentions(scan_text, rel_path):
 22621	    """這段文字有沒有提到這支檔(完整路徑或裸檔名,整詞比對)。
 22622	
 22623	    ★不要用 `base in scan` 這種子字串比對★:新掛 `a.py`、正文只寫了 `xa.py`,子字串會判成「有提到」,
 22624	    提醒就被吃掉——代碼審 r1 邊界席實測。所以命中位置的前後要是非檔名字元(或字串邊界)才算。
 22625	    """
 22626	    base = rel_path.rsplit("/", 1)[-1]
 22627	    for token in (rel_path, base):
 22628	        if not token:
 22629	            continue
 22630	        start = 0
 22631	        while True:
 22632	            i = scan_text.find(token, start)
 22633	            if i < 0:
 22634	                break
 22635	            before = scan_text[i - 1] if i > 0 else ""
 22636	            after = scan_text[i + len(token)] if i + len(token) < len(scan_text) else ""
 22637	            if not _HOME_MENTION_BOUNDARY.match(before or " ") and not _HOME_MENTION_BOUNDARY.match(after or " "):
 22638	                return True
 22639	            start = i + 1
 22640	    return False
 22641	
 22642	
 22643	def _nodehome_resp_ok(value):
 22644	    """[S16] 負責範圍:至少 10 個字、要有實字(全標點、空白視同沒寫)。實字判準同 [manual:] 那條。"""
 22645	    if not isinstance(value, str):
 22646	        return False
 22647	    v = value.strip()
 22648	    return len(v) >= _NODEHOME_RESP_MIN_CHARS and bool(re.search(r"[^\W_]", v))
