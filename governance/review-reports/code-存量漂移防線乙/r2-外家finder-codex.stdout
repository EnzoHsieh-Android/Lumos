 25514	def _drift_plan_followups(env, rel, new_status):
 25515	    """lumos set <計劃> status done|superseded 要列的連帶待辦(計劃〈做法〉第 1 節第 3 點)→ [(種類, 路徑, 說明)]。
 25516	    只讀筆記、不跑 git、不寫;不是計劃或不是收尾狀態回 []。
 25517	    驗證紀錄走 build_typed_index 的反向索引(代碼審 r1 架構對齊席:不自己拿 env.resolve 猜同名第一篇);
 25518	    只寫檔名、同名猜不準的另列一項「猜不準」,讓人自己看。"""
 25519	    n = env.notes.get(rel)
 25520	    if n is None or _drift_str(n, "type") != "project" or new_status not in _DRIFT_CLOSED:
 25521	        return []
 25522	    out = []
 25523	    names = {"out": "計劃連到它", "in": "它連到計劃", "both": "互相連"}
 25524	    for p, d in sorted(_drift_linked(env, rel).items()):
 25525	        pn = env.notes.get(p)
 25526	        if _drift_str(pn, "type") == "issue" and _drift_str(pn, "status") in _DRIFT_OPEN_ISSUE:
 25527	            out.append(("Issue", p, f"{_drift_str(pn, 'status')},{names[d]}"))
 25528	    ti = build_typed_index(env)
 25529	    for p in sorted({s for s, et in ti["rev"].get(rel, []) if et == "plan_refs"}):
 25530	        if _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
 25531	            out.append(("驗證紀錄", p, "pending,plan_refs 指的計劃都已收尾"))
 25532	    out += _drift_status_probe_followups(env, rel, new_status)
 25533	    for src, lit, et, cands in ti["ambiguous"]:
 25534	        sn = env.notes.get(src)
 25535	        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
 25536	                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
 25537	            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
 25538	    return out
