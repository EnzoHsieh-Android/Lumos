 22829	def _nodehome_reader(repo_root, where):
 22830	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 22831	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 22832	    if where is None:
 22833	        return lambda p: None
 22834	    disk_ok_all = False
 22835	    differ = None
 22836	    if where == "index":
 22837	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 22838	    else:
 22839	        head = _lens_full_sha(repo_root, "HEAD")
 22840	        if head and head == where:
 22841	            differ = _nodehome_changed_vs_disk(repo_root, where)
 22842	    root = Path(repo_root)
 22843	    spec = "" if where == "index" else where
 22844	
 22845	    def read(p):
 22846	        if differ is not None and p not in differ:
 22847	            fp = root / p
 22848	            try:
 22849	                if fp.is_file() and not fp.is_symlink():
 22850	                    return fp.read_bytes()
 22851	            except OSError:
 22852	                pass
 22853	        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
 22854	        if r is None or r.returncode != 0:
 22855	            return None
 22856	        return r.stdout
 22857	    return read
 22858	
