 25998	def _drift_probe_changes(root, base, tip, deadline=None):
 25999	    """範圍裡的改動(只算一次:一次 name-status、一次 -U0)→ {touched: 改到的路徑(改名兩端都算), renames: 改名 新→舊,
 26000	    added_text: 程式與測試檔新增行的文字, code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗或預算用完回 None。
 26001	    解析用共用的 _nodehome_name_status(代碼審 r1 架構對齊席:原本手刻第二份);筆記改名也從這一次拿(圖譜一致席:
 26002	    原本另起一次 git)。diff 帶 --text:標了 -diff 或 binary 屬性的程式檔,git 原本只印「Binary files differ」,
 26003	    新增行整批看不見(正確性席)。起點是空樹時 added_text 不算(每一行都當候選)。"""
 26004	    import time as _t
 26005	    if deadline is not None and _t.monotonic() >= deadline:
 26006	        return None
 26007	    raw = _ns_git(root, "diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip)
 26008	    if raw is None:
 26009	        return None
 26010	    codes = {}
 26011	    touched, renames, _gone = _nodehome_name_status(raw, codes=codes)
 26012	    shape = any(c in ("A", "D", "R", "C") and _drift_probe_code_path(p) for p, c in codes.items())
 26013	    added = ""
 26014	    if base:
 26015	        if deadline is not None and _t.monotonic() >= deadline:
 26016	            return None
 26017	        d = _ns_diff(root, "--text", base, tip)
 26018	        if d is None:
 26019	            return None
 26020	        added = "\n".join(t for p, rows in _notelines_parse_added(d).items() if _drift_probe_code_path(nfc(p))
 26021	                          for _n, t in rows)
 26022	    return {"touched": touched, "renames": renames, "added_text": added, "code_shape": shape}
 26023	
