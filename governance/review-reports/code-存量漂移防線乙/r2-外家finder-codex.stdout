 23830	def _notelines_parse_added(raw):
 23831	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23832	    out, path, n = {}, None, 0
 23833	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23834	        if ln.startswith("+++ "):
 23835	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23836	            path = nfc(p[2:]) if p.startswith("b/") else None
 23837	            continue
 23838	        if ln.startswith("@@"):
 23839	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23840	            n = int(m.group(1)) if m else 0
 23841	            continue
 23842	        if path is None or ln.startswith("---"):
 23843	            continue
 23844	        if ln.startswith("+"):
 23845	            out.setdefault(path, []).append((n, ln[1:]))
 23846	            n += 1
 23847	    return out
