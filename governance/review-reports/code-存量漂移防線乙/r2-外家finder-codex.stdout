 22699	def _nodehome_in_stack_test_dir(path, layout):
 22700	    """在各棧的測試資料夾裡——兩種都要「旁邊的程式目標有同一種檔」,只看資料夾名會把業務資料夾放掉
 22701	    (2026-09-12 代碼審兩輪各席造出的反例:A/B 測試功能模組 ABTests/、Python 專案的 LoadTests/、
 22702	    scriptsTests/ 裡的 .cs、src/androidTest 裡的 .py):
 22703	    ① 頂層資料夾 = <X> 加對照表的結尾樣式(PosTerminalTests/、PosTerminalUITests/、Foo.IntegrationTests/),
 22704	       副檔名屬於貢獻那個結尾的棧,而且頂層的 <X> 資料夾裡有同一種副檔名的檔(Xcode 的 App 配 AppTests、
 22705	       .NET 的 Foo 配 Foo.Tests);資料夾就叫結尾樣式本身(UITests/、IntegrationTests/)的直接認;
 22706	    ② 緊接在 src 下一層的對照表測試資料夾名(app/src/androidTest/…),副檔名屬於貢獻那個名字的棧(Kotlin),
 22707	       而且同一個模組的 src/main 有同一種副檔名的檔——只看 src/main 有沒有同副檔名的檔,混在 src/main 的建置腳本
 22708	       (.py、.sh)就能讓 androidTest 裡同副檔名的檔免家(代碼審第三輪四席各自造出反例)。
 22709	    別種語言的測試輔助檔(Xcode 測試資料夾裡的橋接標頭 .h、Java 寫的 androidTest 輔助檔——對照表沒有 Java 棧)照舊要家:
 22710	    寧可過嚴,逃生口是 node_home.ignore;要認就把那一棧補進測試棧對照表,這裡自動跟著認。
 22711	    layout=_nodehome_layout 的結果。對不上的照舊要家(過嚴、不漏)。"""
 22712	    sufs, under_src = _nodehome_stack_test_dirs()
 22713	    top_exts, main_exts = layout
 22714	    parts = path.split("/")
 22715	    e = _testmap_ext(path)
 22716	    if len(parts) < 2 or not e:
 22717	        return False
 22718	    ext, top = "." + e, parts[0]
 22719	    for suf, exts in sufs.items():
 22720	        if ext not in exts or not top.endswith(suf):
 22721	            continue
 22722	        base = top[:-len(suf)].rstrip(".")
 22723	        if not base or ext in top_exts.get(base, ()):
 22724	            return True
 22725	    for i in range(1, len(parts) - 1):
 22726	        if parts[i - 1] == "src" and ext in under_src.get(parts[i], ()) and ext in main_exts.get("/".join(parts[:i]), ()):
 22727	            return True
 22728	    return False
