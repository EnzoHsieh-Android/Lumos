 25432	def _drift_linked(env, rel):
 25433	    """跟 rel 有連結的筆記 → {路徑: 'out'|'in'|'both'}(out=rel 連過去、in=對方連過來;任一方向都算)。"""
 25434	    out_e, in_e = env.edges
 25435	    got = {}
 25436	    for d in out_e.get(rel, []):
 25437	        got[d] = "out"
 25438	    for s in in_e.get(rel, []):
 25439	        got[s] = "both" if s in got else "in"
 25440	    return got
