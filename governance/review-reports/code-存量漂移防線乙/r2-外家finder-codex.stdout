 23022	def _nodehome_name_status(raw, norm=True, codes=None):
 23023	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。
 23024	    norm=False 保留 git 原樣路徑(要拿去 git 查的呼叫端用;筆記形狀擋驗收輪:NFC 過的路徑對 NFD 樹查不到)。
 23025	    codes 給一個 dict 時另填 {路徑: 狀態字母}(改名、複製兩端都填;存量漂移的候選篩選要知道哪些檔是新增或刪除)。"""
 23026	    nfc = globals()["nfc"] if norm else (lambda x: x)
 23027	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 23028	    codes = {} if codes is None else codes
 23029	    while i < len(toks):
 23030	        code = toks[i][:1]
 23031	        if code in ("R", "C") and i + 2 < len(toks):
 23032	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 23033	            codes[nfc(toks[i + 1])] = codes[nfc(toks[i + 2])] = code
 23034	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 23035	            if code == "R":
 23036	                gone.add(nfc(toks[i + 1]))
 23037	            i += 3
 23038	        elif i + 1 < len(toks):
 23039	            paths.add(nfc(toks[i + 1]))
 23040	            codes[nfc(toks[i + 1])] = code
 23041	            if code == "D":
 23042	                gone.add(nfc(toks[i + 1]))
 23043	            i += 2
 23044	        else:
 23045	            break
 23046	    return paths, src, gone - set(src)
 23047	
