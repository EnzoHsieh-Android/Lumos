 24050	_NOTELINES_HEADING_RE = re.compile(r"^#{1,6}\s+(.*?)\s*#*\s*$")
 24051	_NOTELINES_DECISION_KEY_RE = re.compile(r"^(\s*)(?:-\s+)?([A-Za-z_][\w-]*)\s*:")
 24052	
 24053	
 24054	def _notelines_decision_fields(text):
 24055	    """decisions 裡每一行屬於哪一條決策的哪一欄 → {行號(從1起): (決策編號, 欄名, valid)}(Projects/筆記內容審_計劃 [S3][S4])。
 24056	    既有 decisions_items 只給每條決策的起訖行;決策編號用 decision-supersede 同一種 `id:` 比對,欄名逐行歸屬:
 24057	    跟項目子鍵同縮排、`鍵:` 開頭的行是那一欄,後面縮排更深或沒有 `鍵:` 的續行跟著前一欄。沒有編號的決策用 `#<序號>`。"""
 24058	    fm, _b = split_frontmatter(text)
 24059	    out = {}
 24060	    if not fm:
 24061	        return out
 24062	    di = decisions_items(fm)
 24063	    if di is None:
 24064	        return out
 24065	    _s, _e, items, _item_indent, sub_indent = di
 24066	    for n, (st, en) in enumerate(items, 1):
 24067	        did, valid, cur = f"#{n}", True, None
 24068	        fields = []
 24069	        for k in range(st, en + 1):
 24070	            ln = fm[k]
 24071	            m = _NOTELINES_DECISION_KEY_RE.match(ln)
 24072	            ind = len(ln) - len(ln.lstrip(" "))
 24073	            is_key = m and (k == st or ind == sub_indent)
 24074	            if is_key:
 24075	                cur = m.group(2)
 24076	                val = ln.split(":", 1)[1].strip()
 24077	                if cur == "id":
 24078	                    mm = re.match(r"^(d\d+)$", val)
 24079	                    if mm:
 24080	                        did = mm.group(1)
 24081	                elif cur == "valid":
 24082	                    valid = val.strip("\"'").lower() != "false"
 24083	            fields.append((k, cur))
 24084	        for k, f in fields:
 24085	            out[k + 2] = (did, f or "", valid)       # fm[0] 是全文第 2 行
 24086	    return out
 24087	
