 26235	def cmd_drift_ack(env, node, line, kind, reason):
 26236	    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。"""
 26237	    import datetime, secrets
 26238	    if kind not in _DRIFT_KINDS:
 26239	        print(f"擋下:--kind 只能是 {'/'.join(_DRIFT_KINDS)}", file=sys.stderr)
 26240	        return 2
 26241	    if len((reason or "").strip()) < 4:
 26242	        print("擋下:--reason 要寫為什麼照留,至少 4 個字", file=sys.stderr)
 26243	        return 2
 26244	    rel = env.find(node)
 26245	    if rel is None:
 26246	        return _node_not_found(env, node, write_side=True)
 26247	    text = env_text(env, rel)
 26248	    lines = (text or "").split("\n")
 26249	    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
 26250	        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
 26251	        return 2
 26252	    root = _vault_repo_root(env)
 26253	    try:
 26254	        vault_rel = env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 26255	    except ValueError:
 26256	        vault_rel = env.vault.name
 26257	    head = ""
 26258	    for ln in reversed(lines[:line]):
 26259	        if ln.startswith("#"):
 26260	            head = ln.lstrip("#").strip()
 26261	            break
 26262	    token = "DACK-" + secrets.token_hex(4)
 26263	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 26264	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
 26265	    fp = Path(root) / _DRIFT_ACKS
 26266	    try:
 26267	        fp.parent.mkdir(parents=True, exist_ok=True)
 26268	    except OSError as ex:
 26269	        print(f"擋下:建不了 {fp.parent}:{ex}", file=sys.stderr)
 26270	        return 2
 26271	    # 表態檔跟筆記庫其他寫入者排同一把鎖(代碼審 r1 併發席;跟治理帳其他寫入者沒共用鎖的整體問題在 Issue 那篇)
 26272	    with _vault_write_lock(env.vault):
 26273	        rc = _jsonl_append_verified(fp, rec, "id", token)
 26274	    if rc != 0:
 26275	        return rc
 26276	    _gate_event_or_warn(root, "drift-check", "acked", f"{rel}:{line} {kind}:{reason.strip()[:80]}")
 26277	    print(f"✓ 表態記下了({token}):{rel} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]})")
 26278	    print(f"推送前的檢查只認提交進去的表態檔:\n    git add {_DRIFT_ACKS} && git commit")
 26279	    return 0
 26280	
