 25816	def _drift_probe_code_path(p):
 25817	    """乙拿來判 symbol/test、算候選的檔:副檔名在清單裡或沒副檔名(要看 #!),不含 docs/、governance/。
 25818	    候選篩選(_drift_probe_changes)與語料(_DriftProbeTree.corpus)共用這一支(代碼審 r1 圖譜一致席:原本兩邊範圍不同;
 25819	    正確性席:工具鏈主程式 scripts/lumos 沒有副檔名,原本整支不在語料裡,上面的 symbol 條件全是死條件)。"""
 25820	    return _nodehome_code_kind(p) in ("ext", "shebang?") and not p.startswith(("docs/", "governance/"))
 25821	
 25822	
 25823	def _drift_probe_is_py(p, txt):
 25824	    return p.endswith(".py") or (_nodehome_code_kind(p) == "shebang?" and "python" in txt.split("\n", 1)[0].lower())
 25825	
 25826	
 25827	def _drift_py_names(txt):
 25828	    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
 25829	    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
 25830	    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。"""
 25831	    import ast as _ast
 25832	    try:
 25833	        tree = _ast.parse(txt)
 25834	    except (SyntaxError, ValueError):
 25835	        return None
 25836	    funcs, classes, assigns = set(), set(), set()
 25837	    for node in _ast.walk(tree):
 25838	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
 25839	            funcs.add(node.name)
 25840	        elif isinstance(node, _ast.ClassDef):
 25841	            classes.add(node.name)
 25842	    for node in tree.body:
 25843	        if isinstance(node, _ast.Assign):
 25844	            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
 25845	        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
 25846	            assigns.add(node.target.id)
 25847	    return funcs, classes, assigns
 25848	
 25849	
 25850	def _drift_py_def_re(name, test):
 25851	    """解析不了的 Python 檔退回逐行正則(寧可多認一次,也不讓一支語法壞掉的檔讓整批條件判不了)。"""
 25852	    n = re.escape(name)
 25853	    if test:
 25854	        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
 25855	    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)
 25856	
 25857	
 25858	def _drift_disk_list(root):
 25859	    """工作目錄裡的路徑 → (一般檔集合, 所有路徑) 或 None:index 加上沒追蹤(沒被忽略)的,扣掉磁碟上已經不在的
 25860	    (代碼審 r1 外家席:scan 預設看工作目錄,原本卻讀 index,沒追蹤的新檔判成不存在、刪了沒 stage 的判成還在)。"""
 25861	    lst = _nodehome_list(root, "index")
 25862	    raw = _nodehome_git(root, "ls-files", "--others", "--exclude-standard", "-z") if lst is not None else None
 25863	    if raw is None:
 25864	        return None
 25865	    base = Path(root)
 25866	    allp = sorted(set(lst[1]) | {nfc(os.fsdecode(p)) for p in raw.split(b"\0") if p})
 25867	    allp = [p for p in allp if os.path.lexists(base / p)]
 25868	    files = {p for p in allp if (base / p).is_file() and not (base / p).is_symlink()}
 25869	    return files, allp
 25870	
 25871	
 25872	_DRIFT_LS_CACHE = {}
 25873	
 25874	
 25875	def _drift_list(root, where):
 25876	    """_nodehome_list 加記憶:同一個提交的樹一次 check 裡只列一次(代碼審 r1 併發席:終點列 2 次、起點列 3 次)。
 25877	    只記完整提交編號(內容不會變);index 與其他寫法照舊每次列。"""
 25878	    if not (isinstance(where, str) and re.fullmatch(r"[0-9a-f]{40}", where)):
 25879	        return _nodehome_list(root, where)
 25880	    key = (str(root), where)
 25881	    if key not in _DRIFT_LS_CACHE:
 25882	        got = _nodehome_list(root, where)
 25883	        if got is None:
 25884	            return None
 25885	        if len(_DRIFT_LS_CACHE) >= 8:
 25886	            _DRIFT_LS_CACHE.clear()
 25887	        _DRIFT_LS_CACHE[key] = got
 25888	    return _DRIFT_LS_CACHE[key]
