 26531	def _drift_exam_probe(root, vault_rel, q, probes):
 26532	    """probe 題(乙):把那篇筆記的那一行在起點與終點兩版都換成改寫檔給的條件式,對 event_commit 跑 check,
 26533	    那一行在「要處理」算擋到。不改被考 repo(只在記憶體裡換)。"""
 26534	    pb = (probes or {}).get(q.get("id"))
 26535	    if not pb:
 26536	        return "略過:改寫檔沒有這一題", 0, 0, 0
 26537	    c = _lens_full_sha(root, pb.get("event_commit") or "")
 26538	    par = _lens_full_sha(root, f"{pb.get('event_commit')}^") if c else None
 26539	    if c is None or par is None:
 26540	        return "略過:找不到 event_commit 或它的上一版", 0, 0, 0
 26541	    vr = _drift_vault_rel(root, c) or vault_rel
 26542	    note = q.get("note_at_event") or q.get("note")
 26543	    orig, new = str(q.get("text", "")).strip(), str(pb.get("rewrite", "")).strip()
 26544	
 26545	    def _swap(where, v):
 26546	        env = _drift_tree_env(root, where, v)
 26547	        t = env_text(env, note) if env is not None else None
 26548	        if t is None:
 26549	            return None, None
 26550	        lines = t.split("\n")
 26551	        hit = [i for i, ln in enumerate(lines) if ln.strip() == orig]
 26552	        for i in hit:
 26553	            ind = lines[i][:len(lines[i]) - len(lines[i].lstrip())]
 26554	            lines[i] = ind + new
 26555	        return {note: "\n".join(lines)}, (hit[0] + 1 if hit else None)
 26556	    ov_tip, line_tip = _swap(c, vr)
 26557	    ov_base, _lb = _swap(par, _drift_vault_rel(root, par) or vr)
 26558	    if ov_tip is None or line_tip is None:
 26559	        return "略過:終點那一版找不到那一行", 0, 0, 0
 26560	    must, listed, unknown = _drift_check_core(root, par, c, vr, override=ov_tip, override_base=ov_base)
 26561	    hit_kind = next((f["kind"] for f in must if f["path"] == note and f["line"] == line_tip), None)
 26562	    others_m = _drift_exam_others(must, note, line_tip, hit_kind)
 26563	    others_l = _drift_exam_others(listed, note, line_tip, hit_kind)
 26564	    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
 26565	    return ("擋到" if hit_kind else "漏"), len(others_m), len(others_l), noise
 26566	
 26567	
 26568	def _drift_exam_one(root, vault_rel, q, at_sha, probes=None):
 26569	    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
 26570	    ev = q.get("exam_event")
 26571	    note = q.get("note_at_event") or q.get("note")
 26572	    line = q.get("line")
 26573	    if not q.get("note") or not isinstance(line, int):
 26574	        return "略過:題目缺 note 或 line", 0, 0, 0
 26575	    if ev == "current_state":
 26576	        tenv = _drift_tree_env(root, at_sha, vault_rel)
 26577	        if tenv is None:
 26578	            return "略過:git 讀不出樹", 0, 0, 0
 26579	        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
 26580	        return ("誤列" if hit else "沒誤列"), 0, 0, 0
 26581	    if ev == "probe":
 26582	        return _drift_exam_probe(root, vault_rel, q, probes)
 26583	    commits = q.get("invalidating_commits") or []
 26584	    if ev not in ("commit", "status_replay") or not commits:
 26585	        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
 26586	    c = _lens_full_sha(root, commits[0])
 26587	    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
 26588	    if c is None or par is None:
 26589	        return "略過:找不到失效提交或它的上一版", 0, 0, 0
 26590	    vault_rel = _drift_vault_rel(root, c) or vault_rel      # 那個提交自己的圖譜位置(代碼審 r1 外家席)
 26591	    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
 26592	    hit_kind = next((f["kind"] for f in must + listed
 26593	                     if f["path"] == note and (f["line"] == line or ev == "status_replay")), None)
 26594	    others_m = _drift_exam_others(must, note, line, hit_kind)
 26595	    others_l = _drift_exam_others(listed, note, line, hit_kind)
 26596	    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
 26597	    in_must = any(f["path"] == note and f["line"] == line for f in must)
 26598	    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
 26599	    if ev == "status_replay":
 26600	        fu = _drift_exam_replay(root, par, _drift_vault_rel(root, par) or vault_rel, q.get("status_targets") or [])
 26601	        if fu is None:
 26602	            return "略過:git 讀不出上一版", 0, 0, 0
 26603	        if fu == "unreadable":
 26604	            return "略過:要重放的計劃讀不出來(不是 UTF-8)", 0, 0, 0
 26605	        in_list = in_list or note in fu
 26606	    res = "擋到" if in_must else ("點到" if in_list else "漏")
 26607	    return res, len(others_m), len(others_l), noise
 26608	
 26609	
 26610	def _drift_exam_replay(root, par, vault_rel, targets):
 26611	    """status_replay:取上一版的樹,在記憶體裡把 targets 每一份計劃改成 done,回 lumos set 會列的連帶待辦路徑集合。"""
 26612	    tenv0 = _drift_tree_env(root, par, vault_rel)
 26613	    if tenv0 is None:
 26614	        return None
 26615	    texts = {}
 26616	    for t in targets:
 26617	        prel = tenv0.resolve(link_target(t))
 26618	        txt = env_text(tenv0, prel) if prel else None
 26619	        if txt is None and prel and _note_unreadable(tenv0.notes[prel]):
 26620	            return "unreadable"      # 讀不出來的計劃沒辦法在記憶體裡改狀態:這題略過,不算漏(代碼審 r4、r5 正確性席)
 26621	        if txt is not None:
 26622	            texts[prel] = _drift_set_status_text(txt, "done")
 26623	    tenv = _drift_tree_env(root, par, vault_rel, override=texts)
 26624	    fu = set()
 26625	    for prel in texts:
 26626	        fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
 26627	    return fu
 26628	
