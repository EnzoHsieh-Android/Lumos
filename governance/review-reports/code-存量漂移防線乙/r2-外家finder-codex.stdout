 25487	def _drift_guard_findings(env, rel, n, st):
 25488	    """守衛紀錄的 c1(轉正了還寫預告,一句一筆)與 c5(轉正做了一半)。"""
 25489	    text = env_text(env, rel)
 25490	    if text is None:
 25491	        return []
 25492	    out = []
 25493	    lines = text.split("\n")
 25494	    if st == "pass":
 25495	        regs = _notelines_regions(text)
 25496	        for i, ln in enumerate(lines):
 25497	            k = _guard_planned_prose(ln, regs[i])
 25498	            if k:
 25499	                out.append({"kind": "c1", "path": rel, "line": i + 1, "text": ln.strip(), "related": [],
 25500	                            "why": "已轉正(status: pass)但還留著預告句"})
 25501	    elif st == "pending":
 25502	        m = re.search(r"^預告的合約:(.+)$", text, re.M)
 25503	        home = env.resolve(link_target(_guard_home_of_fields(n.fields))) if _guard_home_of_fields(n.fields) else None
 25504	        htext = env_text(env, home) if home else None
 25505	        if m and htext is not None:
 25506	            hl = htext.split("\n")
 25507	            if _guard_formal_line(hl, _drift_fm_end(hl), m.group(1).strip(), None) is not None:
 25508	                ln = _drift_field_line(text, "status")
 25509	                out.append({"kind": "c5", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [home],
 25510	                            "why": f"家筆記 {home[:-3]} 已經是正式合約行——重跑 lumos guard settle 補完"})
 25511	    return out
