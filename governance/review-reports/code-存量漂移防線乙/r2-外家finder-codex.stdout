 26689	def _drift_exam_load_probes(probes):
 26690	    """乙的條件式改寫檔 → {題號: 改寫};沒給回 {},讀不了回 None(已印原因)。"""
 26691	    import json as _j
 26692	    if not probes:
 26693	        return {}
 26694	    try:
 26695	        got = {x["id"]: x for x in _j.loads(Path(probes).read_text(encoding="utf-8")) if isinstance(x, dict) and "id" in x}
 26696	    except (OSError, ValueError, TypeError) as ex:
 26697	        print(f"擋下:改寫檔讀不了:{ex}", file=sys.stderr)
 26698	        return None
 26699	    # 改寫要過跟第一層同一套文法(代碼審 r1 外家席、正確性席:原本沒帶期限的改寫也照考,考過的是真實系統會擋的寫法)
 26700	    bad = []
 26701	    for qid, x in got.items():
 26702	        kind, rest = _revisit_split(_strip_inline_markup(str(x.get("rewrite", "")))[0])
 26703	        pr = _probe_parse(rest) if kind == "cond" else {"errs": ["不是條件式回頭條件"], "by": None, "conds": []}
 26704	        errs = pr["errs"] + ([] if pr["by"] or not pr["conds"] else ["沒帶期限 [by:YYYY-MM-DD]"])
 26705	        if errs:
 26706	            bad.append(f"{qid}:{';'.join(errs)}")
 26707	    if bad:
 26708	        print("擋下:改寫檔有不合條件式文法的題目(第一層會擋這種寫法,考過也不算數):\n  " + "\n  ".join(bad), file=sys.stderr)
 26709	        return None
 26710	    return got
 26711	
 26712	
 26713	def _drift_exam_load(exam):
 26714	    """考卷 → 題目清單;讀不了或有不認得的考法回 None(已印原因)。"""
 26715	    import json as _j
 26716	    try:
 26717	        qs = _j.loads(Path(exam).read_text(encoding="utf-8"))
 26718	    except (OSError, ValueError) as ex:
 26719	        print(f"擋下:考卷讀不了:{ex}", file=sys.stderr)
 26720	        return None
 26721	    if isinstance(qs, dict):
 26722	        qs = qs.get("items") or []
 26723	    # ★形狀先驗★(代碼審 r1 邊界席:純量或字串清單原本直接丟 Python 例外)
 26724	    if not isinstance(qs, list) or not all(isinstance(q, dict) for q in qs):
 26725	        print("擋下:考卷要是一個題目清單(每題一個物件),或 {\"items\": [...]}", file=sys.stderr)
 26726	        return None
 26727	    known = ("commit", "status_replay", "probe", "current_state", "mechanism1_experiment")
 26728	    bad = sorted({str(q.get("exam_event")) for q in qs if q.get("exam_event") not in known})
 26729	    if bad:
 26730	        print(f"擋下:考卷裡有不認得的考法 {bad}", file=sys.stderr)
 26731	        return None
 26732	    return qs
 26733	
