 26310	def _drift_print_findings(rows, stream, acks=None, alive=None):
 26311	    for f in rows[:20]:
 26312	        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {f['path']}:{f['line']}  {f['text'][:60]}", file=stream)
 26313	        print(f"      {f['why']}", file=stream)
 26314	        old = _drift_old_reason(f, acks, alive) if acks else None
 26315	        if old:
 26316	            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
 26317	    if len(rows) > 20:
 26318	        print(f"  …還有 {len(rows) - 20} 筆", file=stream)
