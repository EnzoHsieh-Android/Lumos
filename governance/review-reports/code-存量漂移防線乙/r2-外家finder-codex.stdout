 22817	def _nodehome_changed_vs_disk(repo_root, where):
 22818	    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
 22819	    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
 22820	    if where == "index":
 22821	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
 22822	    else:
 22823	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
 22824	    if raw is None:
 22825	        return None
 22826	    return {nfc(x) for x in _nodehome_split_z(raw)}
 22827	
 22828	
 22829	def _nodehome_reader(repo_root, where):
 22830	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 22831	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 22832	    if where is None:
 22833	        return lambda p: None
 22834	    disk_ok_all = False
 22835	    differ = None
 22836	    if where == "index":
 22837	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 22838	    else:
 22839	        head = _lens_full_sha(repo_root, "HEAD")
 22840	        if head and head == where:
 22841	            differ = _nodehome_changed_vs_disk(repo_root, where)
 22842	    root = Path(repo_root)
 22843	    spec = "" if where == "index" else where
 22844	
 22845	    def read(p):
 22846	        if differ is not None and p not in differ:
 22847	            fp = root / p
 22848	            try:
 22849	                if fp.is_file() and not fp.is_symlink():
 22850	                    return fp.read_bytes()
 22851	            except OSError:
 22852	                pass
 22853	        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
 22854	        if r is None or r.returncode != 0:
 22855	            return None
 22856	        return r.stdout
 22857	    return read
 22858	
 22859	
 22860	def _nodehome_parse_note(raw):
 22861	    """節點原文 → {type, status, about[], resp, sig, text}。sig=(摘要, 解析後的決策, 正文)——[S12] 內容有變
 22862	    逐欄比對用;★不沿用只算正文的那支雜湊★:摘要與決策都在開頭欄位裡,節點長大主要就長在摘要。"""
 22863	    text = raw.decode("utf-8-sig", errors="replace") if isinstance(raw, (bytes, bytearray)) else str(raw)
 22864	    fm_lines, body = split_frontmatter(text)
 22865	    fields = {}
 22866	    dec = ""
 22867	    if fm_lines is not None:
 22868	        fields, _bk, _lint = parse_frontmatter(fm_lines)
 22869	        # 決策比「解析後的值」:只把 content: a 改成 content: "a" 這種等價寫法不算內容有變(第二輪外家席)
 22870	        try:
 22871	            dec = json.dumps(parse_decisions(fm_lines), ensure_ascii=False, sort_keys=True)
 22872	        except Exception:
 22873	            dec = "\n".join(l.rstrip() for l in fm_lines if l.startswith(("decisions:", "  ")))
 22874	    summ = fields.get("summary")
 22875	    summ = summ if isinstance(summ, str) else ""
 22876	    return {"type": str(fields.get("type", "")).strip(),
 22877	            "status": str(fields.get("status", "")).strip(),
 22878	            "about": [str(x) for x in as_list(fields.get("about_code")) if str(x).strip()],
 22879	            "resp": fields.get("responsibility") if isinstance(fields.get("responsibility"), str) else None,
 22880	            # [S11] 從程式重建的章:蓋了章就代表這篇是還原出來的,那它更要說清楚自己管哪些檔
 22881	            "regen": fields.get("regen").strip() if isinstance(fields.get("regen"), str) else "",
 22882	            "sig": ("\n".join(l.rstrip() for l in summ.splitlines()).strip(), dec,
 22883	                    "\n".join(l.rstrip() for l in body.splitlines()).strip()),
 22884	            "text": text}
 22885	
 22886	
 22887	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22888	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
 22889	    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
 22890	    lst = _nodehome_list(repo_root, where)
 22891	    if lst is None:
 22892	        return None
 22893	    s = _NodehomeSide()
 22894	    s.files, s.all_paths = lst
 22895	    s.where = where
 22896	    s._reader = _nodehome_reader(repo_root, where)
 22897	    s.shebang = {}
 22898	    s.share = share
 22899	    s.changed = set(changed or ())
 22900	    s.notes = {}
 22901	    pre = vault_rel + "/Systems/"
 22902	    for p in s.files:
 22903	        if p.startswith(pre) and p.endswith(".md"):
 22904	            rel = p[len(vault_rel) + 1:]
 22905	            if share is not None and p not in s.changed and rel in share.notes:
 22906	                s.notes[rel] = share.notes[rel]
 22907	                continue
 22908	            raw = s._reader(p)
 22909	            if raw is not None:
 22910	                s.notes[rel] = _nodehome_parse_note(raw)
 22911	    return s
 22912	
