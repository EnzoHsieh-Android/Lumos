 26128	def _drift_probe_path_warn(k, v, tree):
 26129	    """symbol/test 的路徑那段在樹上找不到、而且不像檔案路徑(沒有 / 也沒有副檔名)→ 問題說明;否則 None。
 26130	    `[when-symbol:Config::load]` 照文法從最後一個 :: 切成「路徑 Config、名稱 load」,永遠不成立(代碼審 r1 正確性席)。
 26131	    還沒建的檔(src/new.py::main)是正常的等待狀態,不列。"""
 26132	    if k not in ("symbol", "test") or "::" not in v or tree is None:
 26133	        return None
 26134	    path = v.rsplit("::", 1)[0].strip()
 26135	    if path in tree.files or "/" in path or "." in path:
 26136	        return None
 26137	    return f"when-{k} 的路徑 {path} 不像檔案路徑(寫成 型別::方法 了?名稱只寫方法名,或寫完整路徑::名稱)"
 26138	
 26139	
 26140	def _drift_probe_row_problems(pr, nenv, tree):
 26141	    """一行條件式的寫法問題 → [原因]:寫錯的條件、沒帶期限、指到的筆記找不到、file 指到資料夾、symbol/test 的路徑不像檔案路徑。"""
 26142	    bad = list(pr["errs"])
 26143	    if pr["by"] is None and "沒有條件標記" not in bad:
 26144	        bad.append("沒帶期限 [by:YYYY-MM-DD]")
 26145	    for k, v in pr["conds"]:
 26146	        if _probe_value_err(k, v) is not None:
 26147	            continue
 26148	        if k == "status" and nenv.resolve(link_target(v.partition("=")[0].strip())) is None:
 26149	            bad.append(f"when-status 指的筆記 {v.partition('=')[0].strip()} 找不到(改名或刪了?)")
 26150	        if k == "file" and tree is not None and v not in tree.files \
 26151	                and any(f.startswith(v.rstrip("/") + "/") for f in tree.files):
 26152	            bad.append(f"when-file 指到資料夾 {v}(要指一支檔)")
 26153	        w = _drift_probe_path_warn(k, v, tree)
 26154	        if w:
 26155	            bad.append(w)
 26156	    return bad
