 26397	def cmd_drift_scan(env, at=None, as_json=False, budget=None):
 26398	    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
 26399	    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
 26400	    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
 26401	    import json as _j, time as _t
 26402	    budget = _DRIFT_BUDGET_SEC if budget is None else budget
 26403	    if budget <= 0:
 26404	        print("擋下:--budget 要大於 0 秒", file=sys.stderr)
 26405	        return 2
 26406	    deadline = _t.monotonic() + budget
 26407	    root, vault_rel = _drift_vault_of(env)
 26408	    tenv, sha = env, None
 26409	    if at:
 26410	        sha = _lens_full_sha(root, at)
 26411	        if sha is None:
 26412	            print(f"擋下:找不到提交 {at}", file=sys.stderr)
 26413	            return 2
 26414	        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
 26415	        vault_rel = _drift_vault_rel(root, sha) or vault_rel
 26416	        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
 26417	        if tenv is None:
 26418	            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
 26419	            return 2
 26420	    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
 26421	    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
 26422	    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
 26423	    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
 26424	    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
 26425	    if as_json:
 26426	        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
 26427	                        "problems": [{"path": p, "line": n, "text": t, "why": w} for p, n, t, w in probs],
 26428	                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
 26429	                       ensure_ascii=False, indent=1))
 26430	        return 0
 26431	    _drift_scan_print(at, left, done, bad, probs)
 26432	    return 0
