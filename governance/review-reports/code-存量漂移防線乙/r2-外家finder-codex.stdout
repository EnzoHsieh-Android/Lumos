 26025	def _drift_probe_is_candidate(conds, ch, vault_pre, tenv):
 26026	    """這一行的條件會不會被這次推送改變結果(計劃〈做法〉第 0 節,篩選單位是行)。"""
 26027	    for k, v in conds:
 26028	        if k == "file" and v in ch["touched"]:
 26029	            return True
 26030	        if k in ("symbol", "test"):
 26031	            path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
 26032	            if path.strip():
 26033	                if path.strip() in ch["touched"]:
 26034	                    return True
 26035	            elif ch["code_shape"] or re.search(rf"(?<![\w]){re.escape(name.strip())}(?![\w])", ch["added_text"]):
 26036	                return True
 26037	        if k == "status":
 26038	            rel = tenv.resolve(link_target(v.partition("=")[0].strip()))
 26039	            if rel is None or (vault_pre + rel) in ch["touched"]:
 26040	                return True
 26041	    return False
