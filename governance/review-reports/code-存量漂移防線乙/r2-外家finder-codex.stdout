 25335	# 存量漂移守衛(Projects/存量漂移防線_計劃;家 [[Systems/存量漂移守衛]])
 25336	# 已經寫進圖譜的句子,因為別處的狀態變了而過期——這裡是「甲」:狀態指令連帶處理(五種狀態一致檢查、
 25337	# 計劃收尾時列連帶待辦、推送時只擋「這次轉正、預告句還留著」)。「乙」(回頭條件改成機器能判的條件)接在後面。
 25338	# ═══════════════════════════════════════════════════════════════════════════════════
 25339	_DRIFT_CLOSED = ("done", "superseded")
 25340	_DRIFT_OPEN_ISSUE = ("open", "doing")
 25341	# c4 的關鍵詞。★清單裡刻意不放「工作樹」★:「釘在某提交的乾淨工作樹」是合法的可重現寫法,本來就不含這三個詞;
 25342	# 同一句裡同時有「未提交」與「工作樹」照樣成立(考卷 E3 就是這樣寫,設計審 r3 接手席)
 25343	_DRIFT_UNCOMMITTED_WORDS = ("未提交", "還沒提交", "uncommitted")
 25344	_DRIFT_KINDS = ("probe", "c1", "c2", "c3", "c4", "c5")
 25345	_DRIFT_KIND_NAMES = {"c1": "轉正了還寫預告", "c2": "計劃收尾了、連著的 Issue 還開著",
 25346	                     "c3": "計劃收尾了、驗證紀錄還待定", "c4": "前提寫「還沒提交」",
 25347	                     "c5": "轉正做了一半", "probe": "回頭條件成立了"}
 25348	_DRIFT_ACKS = "governance/drift-acks.jsonl"
 25349	_DRIFT_GOLIVE_MARK = "drift check"
 25350	_DRIFT_GATE_VALUES = ("block", "warn", "off")
 25351	# ★沒寫設定時的預設★(計劃〈做法〉第 4 節第 4 點):三條門檻(考卷正例全對、工具鏈歷史重放不亂擋、噪音 ≤5)
 25352	# 都過才改成 block;還沒考就是 warn。
 25353	_DRIFT_DEFAULT_GATE = "warn"
