 25597	def _drift_vault_rel(root, where):
 25598	    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
 25599	    lst = _drift_list(root, where)
 25600	    if lst is None:
 25601	        return None
 25602	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 25603	    if not vaults:
 25604	        return None
 25605	    wv = _vault_in(Path(root))
 25606	    try:
 25607	        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
 25608	    except ValueError:
 25609	        wv_rel = None
 25610	    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
