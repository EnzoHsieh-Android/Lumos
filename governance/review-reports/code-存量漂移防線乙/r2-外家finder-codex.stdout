 23859	def _ns_diff(repo_root, *args):
 23860	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23861	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
