 22674	def _nodehome_top_dirs(all_paths):
 22675	    """repo 頂層的資料夾名;點開頭的不算(.git、.github 這類不是程式資料夾)。
 22676	    別人的檔的裸路徑判定([S8])與測試資料夾的同名資料夾錨共用這一支。"""
 22677	    return {p.split("/", 1)[0] for p in all_paths if "/" in p and not p.startswith(".")}
 22678	
 22679	
 22680	def _nodehome_layout(all_paths):
 22681	    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
 22682	    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
 22683	    tops = _nodehome_top_dirs(all_paths)
 22684	    top_exts, main_exts = {}, {}
 22685	    for p in all_paths:
 22686	        e = _testmap_ext(p)
 22687	        if not e:
 22688	            continue
 22689	        parts = p.split("/")
 22690	        if len(parts) > 1 and parts[0] in tops:
 22691	            top_exts.setdefault(parts[0], set()).add("." + e)
 22692	        for k in range(len(parts) - 2):
 22693	            if parts[k] == "src" and parts[k + 1] == "main":
 22694	                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
 22695	                break
 22696	    return top_exts, main_exts
