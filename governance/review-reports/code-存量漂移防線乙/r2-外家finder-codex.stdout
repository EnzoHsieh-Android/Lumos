 22787	def _nodehome_list(repo_root, where):
 22788	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 22789	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
 22790	    if where is None:
 22791	        return {}, []
 22792	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 22793	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 22794	    if raw is None:
 22795	        return None
 22796	    files, allp = {}, []
 22797	    for ent in raw.split(b"\0"):
 22798	        if not ent or b"\t" not in ent:
 22799	            continue
 22800	        meta, p = ent.split(b"\t", 1)
 22801	        parts = meta.split()
 22802	        if where == "index":
 22803	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 22804	                continue
 22805	            mode = parts[0]
 22806	        else:
 22807	            if len(parts) != 3:
 22808	                continue
 22809	            mode = parts[0]
 22810	        path = nfc(os.fsdecode(p))
 22811	        allp.append(path)
 22812	        if mode in (b"100644", b"100755"):
 22813	            files[path] = mode.decode()
 22814	    return files, allp
