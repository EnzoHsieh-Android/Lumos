  4315	def invariant_test_refs(inv_text):
  4316	    """從 ★INVARIANT★ 文字抽 [test:A,B] 綁定的可執行測試名(可多個,逗號分隔)。無綁定回 []。
  4317	    回**原始字串**(含任何 平台: 前綴)——供 tag 重建/顯示;平台解析走 resolve_test_refs。"""
  4318	    out = []
  4319	    for m in TEST_REF_RE.findall(inv_text):
  4320	        out.extend(t.strip() for t in m.split(",") if t.strip())
  4321	    return out
  4322	
  4323	
  4324	def resolve_test_refs(inv_text, platforms, default_platform):
  4325	    """把 [test:...] 解析為 [(platform, method_name)]。沿用 invariant_test_refs 的逗號切分。
  4326	    - platforms 非空(多平台):每段含 ':' → 前綴須為已定義 platform 鍵(C#/Kotlin 名不含冒號,
  4327	      故含冒號即視為 平台:名;前綴未定義 → raise ValueError,不誤當方法名);無 ':' → 歸 default_platform。
  4328	    - platforms 空(legacy,由呼叫端在 multiplatform=False 時傳 {}):**不切分**,整串(含任何冒號)
  4329	      配 default_platform → 後續走單一 method set 比對(含冒號的假想 ref 走 dangling 而非報錯)。"""
  4330	    out = []
  4331	    for seg in invariant_test_refs(inv_text):
  4332	        if platforms and ":" in seg:
  4333	            plat, name = seg.split(":", 1)
  4334	            plat, name = plat.strip(), name.strip()
  4335	            if plat not in platforms:
  4336	                raise ValueError(
  4337	                    f"[test:{seg}] 的平台前綴 '{plat}' 未定義於 platforms"
  4338	                    f"({', '.join(platforms)});不猜,免得綁錯平台")
  4339	            out.append((plat, name))
  4340	        else:
  4341	            out.append((default_platform, seg))
  4342	    return out
  4343	
