 22887	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22888	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
 22889	    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
 22890	    lst = _nodehome_list(repo_root, where)
 22891	    if lst is None:
 22892	        return None
 22893	    s = _NodehomeSide()
 22894	    s.files, s.all_paths = lst
 22895	    s.where = where
 22896	    s._reader = _nodehome_reader(repo_root, where)
 22897	    s.shebang = {}
 22898	    s.share = share
 22899	    s.changed = set(changed or ())
 22900	    s.notes = {}
 22901	    pre = vault_rel + "/Systems/"
 22902	    for p in s.files:
 22903	        if p.startswith(pre) and p.endswith(".md"):
 22904	            rel = p[len(vault_rel) + 1:]
 22905	            if share is not None and p not in s.changed and rel in share.notes:
 22906	                s.notes[rel] = share.notes[rel]
 22907	                continue
 22908	            raw = s._reader(p)
 22909	            if raw is not None:
 22910	                s.notes[rel] = _nodehome_parse_note(raw)
 22911	    return s
