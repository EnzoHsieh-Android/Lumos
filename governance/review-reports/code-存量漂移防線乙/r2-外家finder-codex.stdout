 25443	def _drift_state_findings(env, only=None):
 25444	    """甲的五種狀態一致檢查(計劃〈做法〉第 1 節第 4 點)→ [{kind, path, line, text, why}]。
 25445	    scan、check、doctor Z 共用這一支;env 可以是磁碟的或記憶體裡某個提交的樹(Env.from_texts)。
 25446	    only=要算的路徑集合(None=全部)。"""
 25447	    out = []
 25448	    ti = build_typed_index(env)
 25449	    for rel, n in sorted(env.notes.items()):
 25450	        if only is not None and rel not in only:
 25451	            continue
 25452	        ty, st = _drift_str(n, "type"), _drift_str(n, "status")
 25453	        if ty == "verification" and GUARD_MARK_FIELD in n.fields:
 25454	            out += _drift_guard_findings(env, rel, n, st)
 25455	        elif ty == "issue" and st in _DRIFT_OPEN_ISSUE:
 25456	            out += _drift_c2(env, rel)
 25457	        if ty == "verification":
 25458	            plans = _drift_c3_hit(env, rel, ti=ti)
 25459	            if plans:
 25460	                text = env_text(env, rel) or ""
 25461	                ln = _drift_field_line(text, "status")
 25462	                out.append({"kind": "c3", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": plans,
 25463	                            "why": "plan_refs 指的計劃都已收尾:" + "、".join(p[:-3] for p in plans[:3])})
 25464	        vu = n.fields.get("valid_under")
 25465	        vtxt = " ".join(as_list(vu)) if vu else ""
 25466	        if vtxt and any(w in vtxt for w in _DRIFT_UNCOMMITTED_WORDS):
 25467	            text = env_text(env, rel) or ""
 25468	            ln = _drift_field_line(text, "valid_under", lambda s: any(w in s for w in _DRIFT_UNCOMMITTED_WORDS))
 25469	            out.append({"kind": "c4", "path": rel, "line": ln, "related": [], "text": _drift_line_text(text, ln),
 25470	                        "why": "前提寫的是還沒提交的狀態,提交之後這句就不成立了"})
 25471	    return out
 25472	
