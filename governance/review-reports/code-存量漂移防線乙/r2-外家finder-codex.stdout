 23804	def _notelines_regions(text):
 23805	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23806	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23807	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23808	    lines = text.split("\n")
 23809	    fm, _body = split_frontmatter(text)
 23810	    if fm is None:
 23811	        if text.startswith("---"):
 23812	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23813	        return ["body"] * len(lines)
 23814	    out = ["body"] * len(lines)
 23815	    end = len(fm) + 1                            # 收尾 --- 那一行
 23816	    out[0] = out[end] = "other"
 23817	    cur = "other"
 23818	    for i in range(1, end):
 23819	        ln = lines[i]
 23820	        m = TOP_KEY_RE.match(ln)
 23821	        if m:
 23822	            k = m.group(1)
 23823	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23824	            out[i] = "other"
 23825	            continue
 23826	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23827	    return out
 23828	
