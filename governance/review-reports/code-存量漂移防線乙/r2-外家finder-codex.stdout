 24422	def cmd_note_shape(repo=None, staged=False, diff_range=None):
 24423	    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
 24424	    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
 24425	    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
 24426	    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
 24427	    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
 24428	    root = Path(repo).resolve() if repo else None
 24429	    if root is None:
 24430	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 24431	        if r is None or r.returncode != 0:
 24432	            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 24433	            return 0
 24434	        root = Path(r.stdout.strip())
 24435	    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
 24436	    if r is None or r.returncode != 0:
 24437	        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 24438	        return 0
 24439	    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE") == "1":        # 只認 1,跟 LUMOS_SKIP_BOUND_TESTS 等鄰居一致(筆記內容審代碼審 r1 同族修)
 24440	        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
 24441	        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
 24442	        return 0
 24443	    if staged:
 24444	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 24445	        if mh is not None and mh.returncode == 0:
 24446	            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
 24447	            return 0
 24448	        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
 24449	    else:
 24450	        rg = _lens_range_ok(diff_range)
