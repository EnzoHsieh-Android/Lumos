 25474	def _drift_c2(env, rel):
 25475	    plans = [(p, d) for p, d in sorted(_drift_linked(env, rel).items())
 25476	             if _drift_str(env.notes.get(p), "type") == "project"
 25477	             and _drift_str(env.notes.get(p), "status") in _DRIFT_CLOSED]
 25478	    if not plans:
 25479	        return []
 25480	    text = env_text(env, rel) or ""
 25481	    ln = _drift_field_line(text, "status")
 25482	    names = {"out": "Issue 連到計劃", "in": "計劃連到 Issue", "both": "互相連"}
 25483	    return [{"kind": "c2", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [p for p, _d in plans],
 25484	             "why": "連著已收尾的計劃:" + "、".join(f"{p[:-3]}({names[d]})" for p, d in plans[:3])}]
 25485	
