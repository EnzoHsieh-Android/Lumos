 25550	                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
 25551	                   and new_status in (vals := {x.strip() for x in v.partition("=")[2].split("|")}) and old not in vals]
 25552	            if hit:
 25553	                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
 25554	                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
