 22992	def _nodehome_changes(repo_root, base, tip):
 22993	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22994	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22995	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22996	    if tip == "index":
 22997	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22998	        if base is None:
 22999	            args.append(_EMPTY_TREE_SHA)
 23000	    else:
 23001	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 23002	    raw = _nodehome_git(repo_root, *args)
 23003	    if raw is None:
 23004	        return None
 23005	    toks = _nodehome_split_z(raw)
 23006	    out, i = [], 0
 23007	    while i < len(toks):
 23008	        st = toks[i]
 23009	        code = st[:1]
 23010	        if code in ("R", "C") and i + 2 < len(toks):
 23011	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 23012	            i += 3
 23013	        elif i + 1 < len(toks):
 23014	            p = nfc(toks[i + 1])
 23015	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 23016	            i += 2
 23017	        else:
 23018	            break
 23019	    return out
 23020	
 23021	
 23022	def _nodehome_name_status(raw, norm=True, codes=None):
 23023	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。
 23024	    norm=False 保留 git 原樣路徑(要拿去 git 查的呼叫端用;筆記形狀擋驗收輪:NFC 過的路徑對 NFD 樹查不到)。
 23025	    codes 給一個 dict 時另填 {路徑: 狀態字母}(改名、複製兩端都填;存量漂移的候選篩選要知道哪些檔是新增或刪除)。"""
 23026	    nfc = globals()["nfc"] if norm else (lambda x: x)
 23027	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 23028	    codes = {} if codes is None else codes
 23029	    while i < len(toks):
 23030	        code = toks[i][:1]
 23031	        if code in ("R", "C") and i + 2 < len(toks):
 23032	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 23033	            codes[nfc(toks[i + 1])] = codes[nfc(toks[i + 2])] = code
 23034	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 23035	            if code == "R":
 23036	                gone.add(nfc(toks[i + 1]))
 23037	            i += 3
 23038	        elif i + 1 < len(toks):
 23039	            paths.add(nfc(toks[i + 1]))
 23040	            codes[nfc(toks[i + 1])] = code
 23041	            if code == "D":
 23042	                gone.add(nfc(toks[i + 1]))
 23043	            i += 2
 23044	        else:
 23045	            break
 23046	    return paths, src, gone - set(src)
 23047	
 23048	
 23049	def _nodehome_merge_own_changes(repo_root, sha, parents):
 23050	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 23051	
 23052	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 23053	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 23054	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 23055	    或順手多改的部分,正是這道檢查要看的。
 23056	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 23057	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 23058	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 23059	    """
 23060	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 23061	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 23062	        return None
 23063	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 23064	                      "--name-status", "-z", "-M", sha)
 23065	    if r is None:
 23066	        return None
 23067	    paths, src, gone = _nodehome_name_status(r)
 23068	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 23069	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 23070	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 23071	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 23072	    for p in parents:
 23073	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 23074	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 23075	    order = sorted(paths)
 23076	    specs = []
 23077	    for x in order:
 23078	        specs.append(f"{sha}:{x}")
 23079	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 23080	    blobs = _nodehome_cat_blobs(repo_root, specs)
 23081	    if blobs is None or any(ren is None for _, ren in pairs):
 23082	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 23083	        return paths, src, gone
 23084	    kept = set()
 23085	    for n, x in enumerate(order):
 23086	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 23087	        if _nodehome_merge_wrote_new_lines(merged, olds):
 23088	            kept.add(x)
 23089	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 23090	
 23091	
 23092	def _nodehome_cat_blobs(repo_root, specs, timeout=60):
 23093	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 23094	
 23095	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 23096	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 23097	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 23098	    import subprocess as _sp
 23099	    if not specs:
 23100	        return []
 23101	    if any("\n" in s_ for s_ in specs):
 23102	        return None
 23103	    try:
 23104	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 23105	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 23106	                    capture_output=True, timeout=timeout)
 23107	    except (OSError, _sp.TimeoutExpired):
 23108	        return None
 23109	    if r.returncode != 0:
 23110	        return None
 23111	    out, pos, res = r.stdout, 0, []
 23112	    for _ in specs:
 23113	        nl = out.find(b"\n", pos)
 23114	        if nl < 0:
 23115	            return None
 23116	        head = out[pos:nl].split(b" ")
 23117	        pos = nl + 1
 23118	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 23119	            size = int(head[2])
 23120	            res.append(out[pos:pos + size])
 23121	            pos += size + 1
 23122	        elif len(head) == 3 and head[2].isdigit():
 23123	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 23124	            res.append(None)
 23125	        else:
 23126	            res.append(None)            # missing / ambiguous
 23127	    return res
 23128	
 23129	
 23130	def _nodehome_merge_wrote_new_lines(merged, olds):
 23131	    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。
 23132	
 23133	    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
 23134	    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
 23135	    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
 23136	    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
 23137	    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
 23138	    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
 23139	    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
 23140	    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
 23141	    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
 23142	    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
 23143	    new = _merge_new_lines(merged, olds)
 23144	    return True if new is None else bool(new)
 23145	
 23146	
 23147	def _merge_new_lines(merged, olds):
 23148	    """合併結果裡「每一個上一版都找不到」的那些行(去頭尾空白後的位元組集合);判不了回 None。
 23149	    從 _nodehome_merge_wrote_new_lines 拆出來(筆記形狀擋 [S5] 要的是哪幾行,不是有沒有);天花板見那支的說明。"""
 23150	    if merged is None or b"\0" in merged:
 23151	        return None
 23152	    seen = set()
 23153	    for blob in olds:
 23154	        if blob is not None:
 23155	            seen.update(ln.strip() for ln in blob.split(b"\n"))
 23156	    return {ln.strip() for ln in merged.split(b"\n") if ln.strip() and ln.strip() not in seen}
 23157	
 23158	
 23159	def _nodehome_commit_groups(repo_root, base, tip):
 23160	    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
 23161	    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
 23162	    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
 23163	    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
 23164	    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
 23165	    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
 23166	    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
 23167	    if raw is None:
 23168	        return None
 23169	    out = []
 23170	    for line in raw.decode("ascii", errors="replace").splitlines():
 23171	        shas = line.split()
 23172	        if not shas:
 23173	            continue
 23174	        sha, parents = shas[0], shas[1:]
 23175	        if len(parents) <= 1:
 23176	            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
 23177	            if r is None:
 23178	                return None
 23179	            paths, src, gone = _nodehome_name_status(r)
 23180	        else:
 23181	            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
 23182	            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
 23183	            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
 23184	            if rm is not None:
 23185	                paths, src, gone = rm
 23186	            else:
 23187	                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
 23188	                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
 23189	                per = []
 23190	                for p in parents:
 23191	                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 23192	                    if r is None:
 23193	                        return None
 23194	                    per.append(_nodehome_name_status(r))
 23195	                paths = set.intersection(*(x[0] for x in per))
 23196	                src = {k: v for k, v in per[0][1].items() if k in paths}
 23197	                gone = set.intersection(*(x[2] for x in per))
 23198	        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
 23199	    return out
 23200	
 23750	                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
 23751	                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
 23752	    return 1 if kind == "blocked" else 0
