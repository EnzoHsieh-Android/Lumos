 26044	def _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=None, override_base=None):
 26045	    """乙的推送判定 → (要處理, 只列出, 判不了)。候選行(被這次推送影響、或這次新寫/改了條件標記的)在終點評估全部條件;
 26046	    終點成立,而起點沒有「同一條」(改名對回後,條件標記一模一樣)或同一條還不成立 → 要處理;起點早就成立 → 不列。
 26047	    每一步開始前與每條候選之前都看預算(代碼審 r1 併發席:原本列樹、改名對照都不看)。"""
 26048	    import time as _t
 26049	    pre = vault_rel.rstrip("/") + "/"
 26050	    lines = [(p, no, tx, pr) for p in sorted(tenv.notes) for no, tx, pr in _probe_lines(env_text(tenv, p) or "")[0]]
 26051	    # 條件本身寫錯的行不評估(第一層擋新寫的、scan 列成寫錯);只缺期限的照評估
 26052	    lines = [x for x in lines if x[3]["conds"] and all(_probe_value_err(k, v) is None for k, v in x[3]["conds"])]
 26053	    if not lines:
 26054	        return [], [], []
 26055	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算(條件式回頭條件)"
 26056	
 26057	    def _out():
 26058	        return deadline is not None and _t.monotonic() >= deadline
 26059	    ch, benv, err = _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base)
 26060	    if err:
 26061	        return [], [], [over if _out() else err]
 26062	    trees = {}
 26063	
 26064	    def _tree(where):
 26065	        if where not in trees:
 26066	            trees[where] = _drift_probe_tree(root, where, deadline)
 26067	        return trees[where]
 26068	    must, unknown, base_lines = [], [], {}
 26069	    for p, no, tx, pr in lines:
 26070	        old = _drift_probe_old(p, pr, ch["renames"], benv, pre, base_lines)
 26071	        if old and not _drift_probe_is_candidate(pr["conds"], ch, pre, tenv):
 26072	            continue
 26073	        verdict = None if _out() else _drift_probe_judge(
 26074	            lambda c: _drift_probe_line(_tree(tip), tenv, c), lambda c: _drift_probe_line(_tree(base), benv, c), pr, old)
 26075	        if verdict is None:
 26076	            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if _out() else "git 讀不出程式檔或筆記") + ")")
 26077	        elif verdict:
 26078	            must.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [], "why": verdict})
 26079	    return must, [], unknown
 26080	
