 24821	def _note_audit_fold(docs):
 24822	    """判定怎麼算(計劃〈做法〉第 2 節):對每個內容編號——①一般判定逐筆,被申訴過就換成所有指名它的申訴裡最重的結果;
 24823	    ②取最重(CODE > MIXED > CONTEXT);③沒有任何判定時,有略過就算略過。→ {id: 'CODE'|'MIXED'|'CONTEXT'|'SKIP'}。
 24824	    跟讀檔順序無關。"""
 24825	    disputes = {}
 24826	    for _name, d in docs.items():
 24827	        if d["kind"] == "申訴" and d.get("disputes"):
 24828	            for r in d["rows"]:
 24829	                if r["class"] in _NOTE_AUDIT_WEIGHT:
 24830	                    k = (d["disputes"], r["id"])
 24831	                    if k not in disputes or _NOTE_AUDIT_WEIGHT[r["class"]] > _NOTE_AUDIT_WEIGHT[disputes[k]]:
 24832	                        disputes[k] = r["class"]
 24833	    best, skipped = {}, set()
 24834	    for name, d in docs.items():
 24835	        if d["kind"] == "略過":
 24836	            skipped.update(r["id"] for r in d["rows"])
 24837	            continue
 24838	        if d["kind"] != "判定":
 24839	            continue
 24840	        for r in d["rows"]:
 24841	            c = r["class"]
 24842	            if c not in _NOTE_AUDIT_WEIGHT:
 24843	                continue
 24844	            c = disputes.get((name, r["id"]), c)
 24845	            if r["id"] not in best or _NOTE_AUDIT_WEIGHT[c] > _NOTE_AUDIT_WEIGHT[best[r["id"]]]:
 24846	                best[r["id"]] = c
 24847	    out = dict(best)
 24848	    for i in skipped:
 24849	        out.setdefault(i, "SKIP")
 24850	    return out
 24851	
 24852	
 24853	def _note_audit_covered(cls):
 24854	    return cls in ("CONTEXT", "SKIP")
 24855	
 24856	
 24857	def _note_audit_resolve(root, diff_range, gate_word, gate="note-audit", mark=None):
 24858	    """--diff 範圍 → (base_where, tip, vault_rel) 或 (None, rc, None)。起點照三道檢查共用的 _lens_push_base,
