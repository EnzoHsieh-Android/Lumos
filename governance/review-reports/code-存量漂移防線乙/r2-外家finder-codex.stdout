 24342	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 24343	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 24344	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 24345	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 24346	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 24347	    out = []
 24348	    root = Path(repo_root)
 24349	    cp = root / ".lumos" / "config.json"
 24350	    txt = None
 24351	    try:
 24352	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 24353	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 24354	            txt = cp.read_bytes()
 24355	    except OSError:
 24356	        txt = None
 24357	    mode, _w = _note_shape_config(txt)
 24358	    if mode != "block":
 24359	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 24360	                   "沒寫來源的現況描述不會被擋")
 24361	    wf = root / ".github" / "workflows"
 24362	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 24363	    if ymls:
 24364	        # 跳過註解:整行被註解掉的那步不算有呼叫(第二層早就這樣判;代碼審 r3 通才席:兩句判法不一,中間漏唸)
 24365	        body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
 24366	        step = ("\n    - run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 24367	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
 24368	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before || '0000000000000000000000000000000000000000' }}..${{ github.sha }}\""
 24369	                "\n  (這步只在 push 事件跑(`if: github.event_name == 'push'`),pull_request 沒有前一版;checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了找得到主線:"
 24370	                "已在主線上的提交不重查,新分支首推(前一版是 40 個 0)或 force-push 後舊頂端找不到時,lumos 從跟主線的分岔點算)")
 24371	        if "note-shape --diff" not in body:
 24372	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 24373	        else:
 24374	            shallow = _ci_jobs_calling_without_full_history(ymls, "note-shape --diff")
 24375	            if shallow:
 24376	                out.append("專案 CI 呼叫了 note-shape,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
 24377	                           + _ci_jobs_list(shallow))
 24378	    if ci:
 24379	        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
 24380	        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
 24381	        return out
 24382	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 24383	    if gl is None:
 24384	        return out
 24385	    ref = None
 24386	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 24387	    if up is not None and up.returncode == 0 and up.stdout.strip():
 24388	        ref = up.stdout.strip()
 24389	    else:
 24390	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 24391	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 24392	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 24393	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 24394	        ref = cands[0] if cands else None
 24395	    tip = _lens_full_sha(root, ref) if ref else None
