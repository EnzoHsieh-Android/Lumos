 26183	# ── 表態 ─────────────────────────────────────────────────────────────────────────────
 26184	
 26185	def _drift_load_acks(root, where=None):
 26186	    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
 26187	    import json as _j
 26188	    raw = None
 26189	    if where is None:
 26190	        fp = Path(root) / _DRIFT_ACKS
 26191	        try:
 26192	            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
 26193	        except OSError:
 26194	            raw = None
 26195	    else:
 26196	        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
 26197	        raw = bl[0] if bl else None
 26198	    out = []
 26199	    for ln in (raw or b"").decode("utf-8", errors="replace").splitlines():
 26200	        try:
 26201	            d = _j.loads(ln)
 26202	        except ValueError:
 26203	            continue
 26204	        if isinstance(d, dict) and d.get("path") and d.get("kind") in _DRIFT_KINDS:
 26205	            out.append(d)
 26206	    return out
 26207	
 26208	
 26209	def _drift_ack_key(path, text, kind):
 26210	    return (nfc(str(path)), str(text).strip(), kind)
 26211	
 26212	
 26213	def _drift_split_acked(findings, acks, vault_rel):
 26214	    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。"""
 26215	    keys = {_drift_ack_key(a["path"], a.get("text", ""), a["kind"]) for a in acks}
 26216	    pre = vault_rel.rstrip("/") + "/"
 26217	    left, done = [], []
 26218	    for f in findings:
 26219	        (done if _drift_ack_key(pre + f["path"], f["text"], f["kind"]) in keys else left).append(f)
 26220	    return left, done
 26221	
 26222	
 26223	def _drift_old_reason(f, acks, alive=None):
 26224	    """表態失效時(筆記改名),用「原文與種類相同」找舊理由供照抄。alive=現在還在的筆記路徑(repo 相對):
 26225	    表態原本那篇還在,就不是改名、是另一篇剛好一樣的樣板句——不借它的理由(代碼審 r1 正確性席:
 26226	    守衛紀錄的預告句是樣板,兩篇會一字不差,原本會把 A 的理由印給從沒表態過的 B)。"""
 26227	    for a in reversed(acks):
 26228	        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
 26229	            if alive is not None and nfc(str(a.get("path"))) in alive:
 26230	                continue
 26231	            return a.get("reason")
 26232	    return None
