 25823	def _drift_probe_is_py(p, txt):
 25824	    return p.endswith(".py") or (_nodehome_code_kind(p) == "shebang?" and "python" in txt.split("\n", 1)[0].lower())
 25825	
 25826	
 25827	def _drift_py_names(txt):
 25828	    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
 25829	    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
 25830	    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。"""
 25831	    import ast as _ast
 25832	    try:
 25833	        tree = _ast.parse(txt)
 25834	    except (SyntaxError, ValueError):
 25835	        return None
 25836	    funcs, classes, assigns = set(), set(), set()
 25837	    for node in _ast.walk(tree):
 25838	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
 25839	            funcs.add(node.name)
 25840	        elif isinstance(node, _ast.ClassDef):
 25841	            classes.add(node.name)
 25842	    for node in tree.body:
 25843	        if isinstance(node, _ast.Assign):
 25844	            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
 25845	        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
 25846	            assigns.add(node.target.id)
 25847	    return funcs, classes, assigns
 25848	
 25849	
 25850	def _drift_py_def_re(name, test):
 25851	    """解析不了的 Python 檔退回逐行正則(寧可多認一次,也不讓一支語法壞掉的檔讓整批條件判不了)。"""
 25852	    n = re.escape(name)
 25853	    if test:
 25854	        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
 25855	    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)
 25856	
