 26109	def _drift_probe_judge(now_of, was_of, pr, old):
 26110	    """一條候選 → 要處理的原因字串 / ""(不列) / None(判不了)。終點成立,而起點沒有同一條或同一條還不成立 → 要處理。
 26111	    now_of / was_of:條件 → 終點 / 起點的判定(起點只在有同一條時才問)。"""
 26112	    conds = tuple(pr["conds"])
 26113	    now = now_of(conds)
 26114	    if now is None:
 26115	        return None
 26116	    if not now:
 26117	        return ""
 26118	    if old:
 26119	        was = was_of(conds)
 26120	        if was is None:
 26121	            return None
 26122	        if was:
 26123	            return ""
 26124	    return (("這次推送讓條件成立了" if old else "這次新寫(或改了條件)的回頭條件,條件已經成立")
 26125	            + (f";期限 {pr['by']}" if pr["by"] else ""))
 26126	
 26127	
 26128	def _drift_probe_path_warn(k, v, tree):
 26129	    """symbol/test 的路徑那段在樹上找不到、而且不像檔案路徑(沒有 / 也沒有副檔名)→ 問題說明;否則 None。
 26130	    `[when-symbol:Config::load]` 照文法從最後一個 :: 切成「路徑 Config、名稱 load」,永遠不成立(代碼審 r1 正確性席)。
 26131	    還沒建的檔(src/new.py::main)是正常的等待狀態,不列。"""
 26132	    if k not in ("symbol", "test") or "::" not in v or tree is None:
 26133	        return None
 26134	    path = v.rsplit("::", 1)[0].strip()
 26135	    if path in tree.files or "/" in path or "." in path:
 26136	        return None
 26137	    return f"when-{k} 的路徑 {path} 不像檔案路徑(寫成 型別::方法 了?名稱只寫方法名,或寫完整路徑::名稱)"
 26138	
 26139	
 26140	def _drift_probe_row_problems(pr, nenv, tree):
 26141	    """一行條件式的寫法問題 → [原因]:寫錯的條件、沒帶期限、指到的筆記找不到、file 指到資料夾、symbol/test 的路徑不像檔案路徑。"""
 26142	    bad = list(pr["errs"])
 26143	    if pr["by"] is None and "沒有條件標記" not in bad:
 26144	        bad.append("沒帶期限 [by:YYYY-MM-DD]")
 26145	    for k, v in pr["conds"]:
 26146	        if _probe_value_err(k, v) is not None:
 26147	            continue
 26148	        if k == "status" and nenv.resolve(link_target(v.partition("=")[0].strip())) is None:
 26149	            bad.append(f"when-status 指的筆記 {v.partition('=')[0].strip()} 找不到(改名或刪了?)")
 26150	        if k == "file" and tree is not None and v not in tree.files \
 26151	                and any(f.startswith(v.rstrip("/") + "/") for f in tree.files):
 26152	            bad.append(f"when-file 指到資料夾 {v}(要指一支檔)")
 26153	        w = _drift_probe_path_warn(k, v, tree)
 26154	        if w:
 26155	            bad.append(w)
 26156	    return bad
 26157	
 26158	
 26159	def _drift_probe_scan(nenv, tree, deadline=None):
 26160	    """scan 的乙部分 → (成立的行[發現], 問題[(路徑, 行號, 原文, 原因)])。問題:寫錯的條件、沒帶期限、指到的筆記找不到、
 26161	    file 指到資料夾、symbol/test 的路徑不像檔案路徑、寫在不評估的地方、判不了(分 git 讀不出與超過預算)。"""
 26162	    import time as _t
 26163	
 26164	    def _over():
 26165	        return deadline is not None and _t.monotonic() >= deadline
 26166	    found, probs = [], []
 26167	    for p in sorted(nenv.notes):
 26168	        rows, dead = _probe_lines(env_text(nenv, p) or "")
 26169	        probs += [(p, no, tx, why) for no, tx, why in dead]
 26170	        for no, tx, pr in rows:
 26171	            probs += [(p, no, tx, why) for why in _drift_probe_row_problems(pr, nenv, tree)]
 26172	            if not pr["conds"] or any(_probe_value_err(k, v) for k, v in pr["conds"]):
 26173	                continue
 26174	            ok = None if _over() else _drift_probe_line(tree, nenv, tuple(pr["conds"]))
 26175	            if ok is None:
 26176	                probs.append((p, no, tx, "判不了(超過預算)" if _over() else "判不了(git 讀不出程式檔或筆記)"))
 26177	            elif ok:
 26178	                found.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [],
 26179	                              "why": "條件已經成立,該處理了" + (f"(期限 {pr['by']})" if pr["by"] else "")})
 26180	    return found, probs
 26181	
