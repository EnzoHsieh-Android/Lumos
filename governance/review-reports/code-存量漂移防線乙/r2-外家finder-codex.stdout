  4297	def _safe_user_regex(pattern):
  4298	    """編譯使用者提供的 regex,並用【靜態】啟發式擋常見巢狀量詞 ReDoS。
  4299	    關鍵:**絕不執行**該 regex 來探測 — 在 CPython 裡 catastrophic regex 持有 GIL,
  4300	    用 thread/probe 探測反而會把整個 process 卡死(GIL 餓死主執行緒)。故只做模式檢查。
  4301	    非窮舉(擋不到 alternation 型),擋得到 (a+)+ / (a*)+ / (a+)* 這類經典款。
  4302	    回傳 (compiled, None) 或 (None, 原因)。"""
  4303	    if not isinstance(pattern, str):
  4304	        return None, "非字串"
  4305	    # 巢狀量詞:帶量詞的群組整體又被量詞修飾(經典 catastrophic backtracking)
  4306	    if re.search(r"\([^()]*[+*][^()]*\)\s*[+*?]", pattern) or \
  4307	       re.search(r"\([^()]*\)\s*[+*]\s*[+*]", pattern):
  4308	        return None, "疑似巢狀量詞 ReDoS(如 (a+)+);請改寫或用 profile 內建"
  4309	    try:
  4310	        return re.compile(pattern, re.S), None
  4311	    except re.error as e:
  4312	        return None, f"無效: {e}"
