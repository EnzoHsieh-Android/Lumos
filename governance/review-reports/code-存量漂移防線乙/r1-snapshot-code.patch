+
+    def _read_many(self, paths):
+        if self.where == "disk":
+            out = {}
+            for p in paths:
+                try:
+                    out[p] = (Path(self.root) / p).read_bytes()
+                except OSError:
+                    out[p] = None
+            return out
+        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
+        blobs = _nodehome_cat_blobs(self.root, [f"{self.where}:{p}" for p in paths], timeout=left) if paths else []
+        return None if blobs is None else dict(zip(paths, blobs))
+
+    def corpus(self, test):
+        """程式檔(test=False,不含 docs/、governance/ 與測試檔)或測試檔的 {路徑: 文字};讀不到回 None。"""
+        if test not in self._corpus:
+            paths = sorted(p for p in self.files if _nodehome_code_kind(p) == "ext"
+                           and not p.startswith(("docs/", "governance/"))
+                           and _nodehome_is_test(p, self.layout) == test)
+            got = self._read_many(paths)
+            self._corpus[test] = None if got is None else {
+                p: b.decode("utf-8", errors="replace") for p, b in got.items() if b is not None}
+        return self._corpus[test]
+
+    def one(self, k, v):
+        """一個條件 → True / False / None(判不了)。"""
+        if not self.ok:
+            return None
+        if k == "file":
+            return v in self.files
+        if k == "status":
+            node, _eq, vals = v.partition("=")
+            rel = self.env.resolve(link_target(node.strip())) if self.env is not None else None
+            n = self.env.notes.get(rel) if rel else None
+            return n is not None and _drift_str(n, "status") in {x.strip() for x in vals.split("|")}
+        test = k == "test"
+        path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
+        path, name = path.strip(), name.strip()
+        corpus = self.corpus(test)
+        if corpus is None:
+            return None
+        items = [(path, corpus.get(path))] if path else list(corpus.items())
+        word = re.compile(rf"(?<![\w]){re.escape(name)}(?![\w])")
+        pydef = _probe_py_def_re(name, test)
+        for p, txt in items:
+            if txt is None:
+                continue
+            if (pydef if p.endswith(".py") else word).search(txt):
+                return True
+        return False
+
+    def line(self, conds):
+        """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
+        vals = [self.one(k, v) for k, v in conds]
+        if any(x is False for x in vals):
+            return False
+        return None if any(x is None for x in vals) else True
