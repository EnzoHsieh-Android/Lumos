+class _ProbeTree:
+    """在某一版(提交的樹、工作目錄 'disk'、或空的 None)上判條件。程式檔與測試檔的內容用到才一次批次讀。
+    status 條件用 notes_env(那一版的圖譜)解連結。git 失敗時 ok=False,判定一律回 None(判不了)。"""
