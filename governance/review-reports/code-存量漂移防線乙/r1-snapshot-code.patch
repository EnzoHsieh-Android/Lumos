+def _probe_changes(root, base, tip, deadline=None):
+    """範圍裡的改動(只算一次)→ {touched: 改到的路徑(改名兩端都算), added_text: 新增行的文字(程式與測試檔),
+    code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗回 None。起點是空樹時 added_text 不算(每一行都當候選)。"""
