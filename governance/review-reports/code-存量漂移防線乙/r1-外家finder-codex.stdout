  4560	                txt = (Path(dp) / f).read_text(encoding="utf-8", errors="ignore")
  4561	            except Exception:
  4562	                continue
  4563	            # file_must_match:讀檔後、去註解前先過濾(如 .yaml 一堆,只認真 Maestro flow;
