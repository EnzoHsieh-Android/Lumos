 26033	def _drift_split_acked(findings, acks, vault_rel):
 26034	    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。"""
 26035	    keys = {_drift_ack_key(a["path"], a.get("text", ""), a["kind"]) for a in acks}
 26036	    pre = vault_rel.rstrip("/") + "/"
 26037	    left, done = [], []
 26038	    for f in findings:
 26039	        (done if _drift_ack_key(pre + f["path"], f["text"], f["kind"]) in keys else left).append(f)
 26040	    return left, done
 26041	
