 25578	def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
 25579	    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
 25580	    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
 25581	    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
 25582	    import time as _t
 25583	    pre = vault_rel.rstrip("/") + "/"
 25584	    if deadline is not None and _t.monotonic() > deadline:
 25585	        return None
 25586	    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 25587	    if raw is None:
 25588	        return None
 25589	    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
 25590	               if x.strip("\n").startswith(pre)}
 25591	    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
 25592	              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
 25593	    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
 25594	              and _drift_str(n, "status") in _DRIFT_CLOSED}
 25595	    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25596	                                   lambda ty, st: ty == "verification" and st == "pass",
 25597	                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
 25598	    if passed is None:
 25599	        return None
 25600	    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25601	                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
 25602	                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
 25603	    if closed is None:
 25604	        return None
 25605	    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
 25606	            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}
 25607	
