   707	+    base_ctx = _ProbeTree(root, base, benv, deadline) if base else None
   708	+    must, unknown = [], []
   709	+    base_lines = {}
   710	+    for p, no, tx, pr in lines:
   711	+        old = None
   712	+        if benv is not None:
   713	+            bp = ren.get(pre + p, pre + p)
   714	+            bp = bp[len(pre):] if bp.startswith(pre) else p
   715	+            if bp not in base_lines:
   716	+                base_lines[bp] = {tuple(x[2]["conds"]) for x in _probe_lines(env_text(benv, bp) or "")[0]}
   717	+            old = tuple(pr["conds"]) in base_lines[bp]
   718	+        if old and not _probe_is_candidate(pr["conds"], ch, pre, tenv):
