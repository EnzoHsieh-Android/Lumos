 22751	def _nodehome_code_kind(path):
 22752	    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
 22753	    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
 22754	    base = path.rsplit("/", 1)[-1]
 22755	    stripped = base.lstrip(".")
 22756	    if "." in stripped:
 22757	        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
 22758	    return "shebang?"
