   436	+# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
   437	+# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
   438	+#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
   439	+# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
   440	+_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
   441	+_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
   442	+_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
   443	+_PROBE_KEYS = ("file", "symbol", "test", "status")
   444	+_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")
   445	+
   446	+
   447	+def _revisit_split(line):
   448	+    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
   449	+    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
   450	+    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
   451	+    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
   452	+    import datetime
   453	+    if line.lstrip().startswith("|"):
   454	+        return None, None
   455	+    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
   456	+    if not s.startswith("REVISIT:"):
   457	+        return None, None
   458	+    rest = s[len("REVISIT:"):]
   459	+    if rest.lstrip().startswith("[when-"):
   460	+        return "cond", rest
   461	+    try:
   462	+        datetime.date.fromisoformat(rest.partition(" ")[0])
   463	+        return "date", rest
   464	+    except ValueError:
   465	+        return "bad", rest
   466	+
   467	+
   468	+def _probe_value_err(k, v):
   469	+    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
   470	+    if k not in _PROBE_KEYS:
   471	+        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
   472	+    if not v:
   473	+        return f"when-{k} 的值是空的"
   474	+
   475	+    if k == "file":
   476	+        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
   477	+    if k in ("symbol", "test"):
   478	+        return _probe_named_err(k, v)
   479	+    node, eq, vals = v.partition("=")
   480	+    if not eq or not node.strip() or not vals.strip():
   481	+        return "when-status 要寫成 <節點>=<值>"
   482	+    if any(not x.strip() for x in vals.split("|")):
   483	+        return "when-status 的值用 | 分開時每一段都不能空"
   484	+    return None
   485	+
   486	+
   487	+def _probe_bad_path(p):
   488	+    return (not p) or p.startswith("/") or ".." in p.split("/")
   489	+
   490	+
   491	+def _probe_named_err(k, v):
   492	+    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
   493	+    if "::" not in v:
   494	+        return None
   495	+    path, name = v.rsplit("::", 1)
   496	+    if not name.strip():
   497	+        return f"when-{k} 的名稱是空的"
   498	+    if _probe_bad_path(path.strip()):
   499	+        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
   500	+    return None
   501	+
   502	+
   503	+def _probe_parse(rest):
   504	+    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
   505	+    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
   506	+    import datetime
   507	+    conds, by, errs, pos = [], None, [], 0
   508	+    while True:
   509	+        m = _PROBE_TOKEN_RE.match(rest, pos)
   510	+        if not m:
   511	+            break
   512	+        pos = m.end()
   513	+        key, val = m.group(1), m.group(2).strip()
   514	+        if key == "by":
   515	+            if by is not None:
   516	+                errs.append("期限寫了兩個")
   517	+                continue
   518	+            try:
   519	+                datetime.date.fromisoformat(val)
   520	+                by = val
   521	+            except ValueError:
   522	+                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
   523	+            continue
   524	+        k = key[len("when-"):]
   525	+        err = _probe_value_err(k, val)
   526	+        if err:
   527	+            errs.append(err)
   528	+        conds.append((k, val))
   529	+    if not conds:
   530	+        errs.append("沒有條件標記")
   531	+    return {"conds": conds, "by": by, "errs": errs}
   532	+
   533	+
   534	+def _probe_lines(text):
   535	+    """一篇筆記的條件式回頭條件 → (清單[(行號, 原文, 解析結果)], 寫在不評估的地方[(行號, 原文, 原因)])。
   536	+    只認正文與摘要的可見行:圍欄(_visible_lines)、行內程式碼(_strip_inline_markup)、表格行裡的都不算;
   537	+    開頭欄位裡 summary 以外的欄與表格行裡的條件標記列成「寫在不評估的地方」(計劃〈做法〉第 0 節)。"""
   538	+    lines = text.split("\n")
   539	+    regs = _notelines_regions(text)
   540	+    vis = {no for no, _ln in _visible_lines(lines)}
   541	+    out, dead = [], []
   542	+    for i, ln in enumerate(lines, 1):
   543	+        if i not in vis:
   544	+            continue
   545	+        probe = _strip_inline_markup(ln)[0]
   546	+        table = probe.lstrip().startswith("|")
   547	+        if regs[i - 1] in ("body", "summary") and not table:
   548	+            kind, rest = _revisit_split(probe)
   549	+            if kind == "cond":
   550	+                out.append((i, ln.strip(), _probe_parse(rest)))
   551	+            continue
   552	+        if _PROBE_ANY_RE.search(probe):
   553	+            dead.append((i, ln.strip(), "寫在表格行裡,不評估" if table else "寫在開頭欄位裡 summary 以外的欄,不評估"))
   554	+    return out, dead
   555	+
   556	+
   557	+def _probe_py_def_re(name, test):
   558	+    n = re.escape(name)
   559	+    if test:
   560	+        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
   561	+    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)
