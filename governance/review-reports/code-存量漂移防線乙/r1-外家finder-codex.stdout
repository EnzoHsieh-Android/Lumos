 25887	def _probe_is_candidate(conds, ch, vault_pre, tenv):
 25888	    """這一行的條件會不會被這次推送改變結果(計劃〈做法〉第 0 節,篩選單位是行)。"""
 25889	    for k, v in conds:
 25890	        if k == "file" and v in ch["touched"]:
 25891	            return True
 25892	        if k in ("symbol", "test"):
 25893	            path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
 25894	            if path.strip():
 25895	                if path.strip() in ch["touched"]:
 25896	                    return True
 25897	            elif ch["code_shape"] or re.search(rf"(?<![\w]){re.escape(name.strip())}(?![\w])", ch["added_text"]):
 25898	                return True
 25899	        if k == "status":
 25900	            rel = tenv.resolve(link_target(v.partition("=")[0].strip()))
 25901	            if rel is None or (vault_pre + rel) in ch["touched"]:
 25902	                return True
 25903	    return False
