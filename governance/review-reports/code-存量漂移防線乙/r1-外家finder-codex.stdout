 23967	def _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, *, reader, mark, hook=_NOTELINES_PRECOMMIT,
 23968	                   per_commit=True, exclude_remote=True, max_count=None, keep_other=False):
 23969	    """範圍裡新寫、而且終點版本還在的筆記行——筆記形狀擋與筆記內容審共用(Projects/筆記內容審_計劃 [S1][S2])。
 23970	    → (notes, errs, old_by) 或 None(git 失敗)。notes=[(路徑, 全文, [(行號, 行文字, 區塊)])],只收 body/summary/
 23971	    decisions 三塊的非空行;errs=讀不成 UTF-8 的筆記;old_by={NFC 路徑: 這道檢查還沒上線時寫的行}。
 23972	    ★per_commit★:True=逐提交看「那個提交自己的 hook 有沒有 mark」(提交前掛鉤在寫的那一刻跑,第一層);
 23973	    False=不逐提交判、只靠範圍截斷(推送時才跑的閘,跑的是當下工作目錄那份掛鉤,第二層)——★要明寫傳 False★,
 23974	    不傳會落到第一層的預設。找不到上線點時照既有語意不過濾。
 23975	    keep_other=True 時開頭欄位其他欄(區塊 other)的新行也收——只給筆記形狀擋查「條件標記寫在不評估的地方」用
 23976	    (存量漂移防線 [S10]),既有規則照舊只看 body/summary/decisions。"""
 23977	    if staged:
 23978	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23979	        if d is None:
 23980	            return None
 23981	        added = {p: rows for p, rows in _notelines_parse_added(d).items() if p.endswith(".md")}
 23982	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23983	        texts_by, old_by = None, {}
 23984	    else:
 23985	        live_mark = mark if (per_commit and _nodehome_golive(repo_root, tip_where, mark, hook)) else None
 23986	        ra = _notelines_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
 23987	                                    mark=live_mark, max_count=max_count, hook=hook)
 23988	        if ra is None:
 23989	            return None
 23990	        texts_by, paths, old_by = ra
 23991	        cand = {p: None for p in paths}
 23992	    notes, errs = [], []
 23993	    for p, linenos in sorted(cand.items()):
 23994	        b = reader(p)
 23995	        if b is None:
 23996	            continue
 23997	        try:
 23998	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 23999	        except UnicodeDecodeError:
 24000	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 24001	            continue
 24002	        lines = text.split("\n")
 24003	        regs = _notelines_regions(text)
 24004	        rows = []
 24005	        for i, ln in enumerate(lines, 1):
 24006	            if linenos is not None and i not in linenos:
 24007	                continue
 24008	            if texts_by is not None and ln.strip() not in texts_by.get(nfc(p), ()):
 24009	                continue
 24010	            if not ln.strip() or (regs[i - 1] == "other" and not keep_other):
 24011	                continue
 24012	            rows.append((i, ln, regs[i - 1]))
 24013	        notes.append((p, text, rows))
 24014	    return notes, errs, old_by
