 26247	def _drift_scan_print(at, left, done, bad):
 26248	    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)。"""
 26249	    if bad:
 26250	        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(bad[:10]))
 26251	    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
 26252	    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
 26253	          + (f";已表態 {len(done)}" if done else ""))
 26254	    for k in _DRIFT_KINDS:
 26255	        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
 26256	        if rows:
 26257	            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
 26258	            for f, acked in rows:
 26259	                print(f"  {f['path']}:{f['line']}  {f['text'][:70]}" + ("  (已表態)" if acked else ""))
 26260	                if not acked:
 26261	                    print(f"      {f['why']}")
