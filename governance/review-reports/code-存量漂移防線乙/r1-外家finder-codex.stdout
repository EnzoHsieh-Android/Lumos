 26291	def _drift_gate_doctor_lines(repo_root):
 26292	    """doctor 開頭的閘提醒(照筆記形狀擋與筆記內容審那兩支的位置與呈現):開關不是 block,而且專案自己寫了開關或已經接線時講
 26293	    (沒寫設定也沒接線時預設就是 warn,每次都唸只是噪音;計劃 [S14] 已跟著改);
 26294	    只收專案根:鄰居多收的圖譜位置與 ci 旗標是給它們的事後掃描用的,這支沒有事後掃描(代碼審 r3 架構對齊席:抄了參數不用是死參數)。
 26295	    接線後(推送前掛鉤出現標記)專案 CI 沒呼叫 drift check 就給要貼的步驟。唯一的 git 呼叫是讀一次推送前掛鉤。"""
 26296	    out = []
 26297	    root = Path(repo_root)
 26298	    cp = root / ".lumos" / "config.json"
 26299	    txt = None
 26300	    try:        # .lumos 資料夾本身是捷徑也不跟(照 _note_audit_doctor_lines;代碼審 r2 架構對齊席)
 26301	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 26302	            txt = cp.read_bytes()
 26303	    except OSError:
 26304	        txt = None
 26305	    mode, cfg_warns, explicit = _drift_config(txt)
 26306	    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
 26307	    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
 26308	    # 開關不是 block 時講一聲——只在專案自己寫了開關、或已經接線時(代碼審 r1 外家席:關掉了要看得見);
 26309	    # 還沒接線又沒寫設定時預設本來就是 warn,每個專案每次 doctor 都多一行只是噪音(代碼審 r3:那一行也破壞既有測試
 26310	    # t_doctor_summary_admits_soft_reminders 的軟段計數)
 26311	    if mode != "block" and (wired or explicit):
 26312	        src = (f"({cfg_warns[0]})" if cfg_warns else "(.lumos/config.json 的 drift_check)" if explicit
 26313	               else "(沒寫設定,這是預設值)")
 26314	        out.append(f"這個專案的存量漂移檢查是 {mode}{src}——轉正後留著預告句的推送不會被擋")
 26315	    wf = root / ".github" / "workflows"
 26316	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 26317	    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
 26318	    if wired and ymls and "drift check" not in body:
 26319	        out.append("專案 CI 沒呼叫 `lumos drift check`,`--no-verify` 推上去的沒人查——CI 在 note-audit 那步後面加:"
 26320	                   "\n    - run: python3 scripts/lumos drift check --diff \"${{ github.event.before || "
 26321	                   "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"")
 26322	    return out
