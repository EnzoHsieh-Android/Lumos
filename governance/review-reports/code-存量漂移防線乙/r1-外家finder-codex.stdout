 26375	def _drift_exam_one(root, vault_rel, q, at_sha, probes=None):
 26376	    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
 26377	    ev = q.get("exam_event")
 26378	    note = q.get("note_at_event") or q.get("note")
 26379	    line = q.get("line")
 26380	    if not q.get("note") or not isinstance(line, int):
 26381	        return "略過:題目缺 note 或 line", 0, 0, 0
 26382	    if ev == "current_state":
 26383	        tenv = _drift_tree_env(root, at_sha, vault_rel)
 26384	        if tenv is None:
 26385	            return "略過:git 讀不出樹", 0, 0, 0
 26386	        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
 26387	        return ("誤列" if hit else "沒誤列"), 0, 0, 0
 26388	    if ev == "probe":
 26389	        return _drift_exam_probe(root, vault_rel, q, probes)
 26390	    commits = q.get("invalidating_commits") or []
 26391	    if ev not in ("commit", "status_replay") or not commits:
 26392	        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
 26393	    c = _lens_full_sha(root, commits[0])
 26394	    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
 26395	    if c is None or par is None:
 26396	        return "略過:找不到失效提交或它的上一版", 0, 0, 0
 26397	    vault_rel = _drift_vault_rel(root, c) or vault_rel      # 那個提交自己的圖譜位置(代碼審 r1 外家席)
 26398	    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
 26399	    hit_kind = next((f["kind"] for f in must + listed
 26400	                     if f["path"] == note and (f["line"] == line or ev == "status_replay")), None)
 26401	    others_m = _drift_exam_others(must, note, line, hit_kind)
 26402	    others_l = _drift_exam_others(listed, note, line, hit_kind)
 26403	    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
 26404	    in_must = any(f["path"] == note and f["line"] == line for f in must)
 26405	    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
 26406	    if ev == "status_replay":
 26407	        fu = _drift_exam_replay(root, par, _drift_vault_rel(root, par) or vault_rel, q.get("status_targets") or [])
 26408	        if fu is None:
 26409	            return "略過:git 讀不出上一版", 0, 0, 0
 26410	        if fu == "unreadable":
 26411	            return "略過:要重放的計劃讀不出來(不是 UTF-8)", 0, 0, 0
 26412	        in_list = in_list or note in fu
 26413	    res = "擋到" if in_must else ("點到" if in_list else "漏")
 26414	    return res, len(others_m), len(others_l), noise
