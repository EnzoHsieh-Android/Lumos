 26055	def cmd_drift_ack(env, node, line, kind, reason):
 26056	    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。"""
 26057	    import datetime, secrets
 26058	    if kind not in _DRIFT_KINDS:
 26059	        print(f"擋下:--kind 只能是 {'/'.join(_DRIFT_KINDS)}", file=sys.stderr)
 26060	        return 2
 26061	    if len((reason or "").strip()) < 4:
 26062	        print("擋下:--reason 要寫為什麼照留,至少 4 個字", file=sys.stderr)
 26063	        return 2
 26064	    rel = env.find(node)
 26065	    if rel is None:
 26066	        return _node_not_found(env, node, write_side=True)
 26067	    text = env_text(env, rel)
 26068	    lines = (text or "").split("\n")
 26069	    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
 26070	        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
 26071	        return 2
 26072	    root = _vault_repo_root(env)
 26073	    try:
 26074	        vault_rel = env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 26075	    except ValueError:
 26076	        vault_rel = env.vault.name
 26077	    head = ""
 26078	    for ln in reversed(lines[:line]):
 26079	        if ln.startswith("#"):
 26080	            head = ln.lstrip("#").strip()
 26081	            break
 26082	    token = "DACK-" + secrets.token_hex(4)
 26083	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 26084	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
 26085	    fp = Path(root) / _DRIFT_ACKS
 26086	    try:
 26087	        fp.parent.mkdir(parents=True, exist_ok=True)
 26088	    except OSError as ex:
 26089	        print(f"擋下:建不了 {fp.parent}:{ex}", file=sys.stderr)
 26090	        return 2
 26091	    # 表態檔跟筆記庫其他寫入者排同一把鎖(代碼審 r1 併發席;跟治理帳其他寫入者沒共用鎖的整體問題在 Issue 那篇)
 26092	    with _vault_write_lock(env.vault):
 26093	        rc = _jsonl_append_verified(fp, rec, "id", token)
 26094	    if rc != 0:
 26095	        return rc
 26096	    _gate_event_or_warn(root, "drift-check", "acked", f"{rel}:{line} {kind}:{reason.strip()[:80]}")
 26097	    print(f"✓ 表態記下了({token}):{rel} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]})")
 26098	    print(f"推送前的檢查只認提交進去的表態檔:\n    git add {_DRIFT_ACKS} && git commit")
 26099	    return 0
 26100	
