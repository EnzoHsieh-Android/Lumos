 23021	def _nodehome_name_status(raw, norm=True):
 23022	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。
 23023	    norm=False 保留 git 原樣路徑(要拿去 git 查的呼叫端用;筆記形狀擋驗收輪:NFC 過的路徑對 NFD 樹查不到)。"""
 23024	    nfc = globals()["nfc"] if norm else (lambda x: x)
 23025	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 23026	    while i < len(toks):
 23027	        code = toks[i][:1]
 23028	        if code in ("R", "C") and i + 2 < len(toks):
 23029	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 23030	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 23031	            if code == "R":
 23032	                gone.add(nfc(toks[i + 1]))
 23033	            i += 3
 23034	        elif i + 1 < len(toks):
 23035	            paths.add(nfc(toks[i + 1]))
 23036	            if code == "D":
 23037	                gone.add(nfc(toks[i + 1]))
 23038	            i += 2
 23039	        else:
 23040	            break
 23041	    return paths, src, gone - set(src)
