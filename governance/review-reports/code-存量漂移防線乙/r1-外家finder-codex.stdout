 22777	def _nodehome_show(path):
 22778	    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
 22779	    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)
 22780	
 23885	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
 23886	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
 23887	    ★寫的時候這道檢查還沒上線的提交不查★(mark):看那個提交自己的提交前掛鉤有沒有上線標記——上線前開的分支上線後
 23888	    才合進來,那些行是舊帳(r3 通才席);原本用「是不是上線點的後代」代替,兩條分支各自裝過時另一條整批漏查(驗收輪通才席)。
 23889	    那些行另外收進第三個回傳值,喚醒那條路也跳過(驗收輪外家席)。max_count:只看最新那幾個提交(doctor 的上限)。"""
 23890	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23891	    if exclude_remote:
 23892	        ml = _ns_exclusions(repo_root, tip)
 23893	        if ml:
 23894	            rl += ["--not", *ml]
 23895	    if max_count:
 23896	        rl.append(f"--max-count={int(max_count)}")
 23897	    raw = _nodehome_git(repo_root, *rl)
 23898	    if raw is None:
 23899	        return None
 23900	    commits = [ln.split() for ln in raw.decode("ascii", errors="replace").splitlines() if ln.split()]
 23901	    live = None
 23902	    if mark and commits:
 23903	        hb = _nodehome_cat_blobs(repo_root, [f"{c[0]}:{hook}" for c in commits])
 23904	        if hb is None:
 23905	            return None
 23906	        live = {c[0] for c, b in zip(commits, hb) if b is not None and mark.encode() in b}
 23907	    by_path, old_by = {}, {}
 23908	
 23909	    def _renames(a, b):
 23910	        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
 23911	        return None if r is None else _nodehome_name_status(r, norm=False)[1]     # 原樣 新路徑 → 舊路徑
 23912	
 23913	    def _carry(ren):
 23914	        for new_, old_ in (ren or {}).items():
 23915	            ko, kn = nfc(old_), nfc(new_)
 23916	            for d_ in (by_path, old_by):
 23917	                if ko in d_ and ko != kn:
 23918	                    d_.setdefault(kn, set()).update(d_.pop(ko))
 23919	
 23920	    for shas in commits:
 23921	        sha, parents = shas[0], shas[1:]
 23922	        first = parents[0] if parents else _EMPTY_TREE_SHA
 23923	        ren = _renames(first, sha)
 23924	        if ren is None:
 23925	            return None
 23926	        _carry(ren)
 23927	        dest = by_path if (live is None or sha in live) else old_by
 23928	        if len(parents) <= 1:
 23929	            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
 23930	            if d is None:
 23931	                return None
 23932	            for p, rows in _notelines_parse_added(d).items():
 23933	                dest.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23934	            continue
 23935	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 23936	        if names is None:
 23937	            return None
 23938	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23939	        pren = [_renames(pp, sha) or {} for pp in parents]
 23940	        for pr in pren[1:]:
 23941	            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
 23942	            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
 23943	            _carry(pr)
 23944	        specs = []
 23945	        for p in paths:
 23946	            specs.append(f"{sha}:{p}")
 23947	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
 23948	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23949	        k = 1 + len(parents)
 23950	        for i, p in enumerate(paths):
 23951	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23952	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23953	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23954	                d = _ns_diff(repo_root, first, sha, "--", p)
 23955	                if d is None:
 23956	                    return None
 23957	                for _p, rows in _notelines_parse_added(d).items():
 23958	                    dest.setdefault(nfc(p), set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23959	            else:
 23960	                dest.setdefault(nfc(p), set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
 23961	    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 23962	    if net is None:
 23963	        return None
 23964	    return by_path, [p for p in _nodehome_split_z(net) if p.endswith(".md")], old_by
