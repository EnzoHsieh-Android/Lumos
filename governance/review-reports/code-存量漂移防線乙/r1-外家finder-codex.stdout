  4489	def _py_declared_methods(repo_root, profile):
  4490	    """Python 那棧的宣告集:用標準函式庫的語法剖析,不管縮排、類別內外都算。剖不動任一檔就回 None。
  4491	
  4492	    ★不要用放寬的正則去掃★(代碼審 r2 通才席 blocker):Python 的掃描刻意不剝字串,
  4493	    而原本的行首錨同時兼任了「別把字串裡的東西當宣告」這個守門。把錨放寬之後,
  4494	    docstring 裡縮排的程式範例會被當成真宣告——實測本 repo 自己的測試檔就多算 148 個,
  4495	    那會把「同一支測試的多組輸入」誤判成撞名,原地重現這批本來要修的那個誤擋。
  4496	    語法剖析看的是真的語法樹,字串就是字串,不會有這個問題。
  4497	    """
  4498	    import ast
  4499	    mre = profile["method_re"]
  4500	    names = set()
  4501	    for txt in _walk_test_files(repo_root, profile):
  4502	        try:
  4503	            tree = ast.parse(txt)
  4504	        except (SyntaxError, ValueError, RecursionError):
  4505	            return None      # 有檔剖不動 → 這個 repo 我沒把握掃得全,回「不知道」
  4506	        for node in ast.walk(tree):
  4507	            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
  4508	                names.add(node.name)
  4509	    # 用這個 profile 自己的樣式篩出「長得像測試」的。★要試好幾種寫法★(代碼審 r3):
  4510	    # 只拿 "def x(" 一種去比對,遇到自訂成「只認類別裡的方法」(帶前導空白)或「async def」的樣式
  4511	    # 就會整批篩空——那會讓這批修好的東西對那些專案悄悄失效,而且沒有任何提示。
  4512	    probes = ("def {n}(", "    def {n}(", "async def {n}(", "    async def {n}(")
  4513	    keep = {n for n in names if any(mre.match(pb.format(n=n)) for pb in probes)}
  4514	    if names and not keep:
  4515	        return None   # 一個都篩不出來=這個樣式我認不得,回「不知道」而不是「沒有別的」
  4516	    return keep
  4517	
  4518	
  4519	def _loose_declared_methods(repo_root, profile=None):
  4520	    """回「不管縮排、類別內外都算」的宣告集;沒有精確的做法就回 None(=不知道,不豁免)。
  4521	
  4522	    回 None 的意思是「這個棧我沒把握掃得全」,呼叫端要當成「不知道」而不是「沒有別的」——
  4523	    少算一支就會把真撞名放行(代碼審 r1 blocker)。
  4524	    """
  4525	    profile = profile or load_test_profile(repo_root)
  4526	    mre = profile.get("method_re")
  4527	    src = getattr(mre, "pattern", "") or ""
  4528	    if not src:
  4529	        return None
  4530	    import re as _re
  4531	    body = _re.sub(r"^\(\?[aiLmsux]+\)", "", src)   # 先剝行內旗標,旗標順序不該影響判斷
  4532	    if not body.startswith("^"):
  4533	        # 這個棧的宣告樣式本來就不錨在行首,正規那支已經掃得到縮排與類別裡的
  4534	        return discover_test_methods(repo_root, profile)
  4535	    if ".py" in {str(x).lower() for x in (profile.get("exts") or ())}:
  4536	        return _py_declared_methods(repo_root, profile)
  4537	    # 錨在行首、又不是 Python:沒有精確的放寬做法(放寬正則會把字串內容也撈進來),不豁免
  4538	    return None
