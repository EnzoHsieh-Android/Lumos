   744	+def _probe_judge(tip_ctx, base_ctx, pr, old):
   745	+    """一條候選 → 要處理的原因字串 / ""(不列) / None(判不了)。終點成立,而起點沒有同一條或同一條還不成立 → 要處理。"""
