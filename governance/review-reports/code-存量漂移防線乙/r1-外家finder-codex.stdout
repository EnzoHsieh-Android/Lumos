 25974	def _drift_probe_scan(nenv, ctx):
 25975	    """scan 的乙部分 → (成立的行[發現], 問題[(路徑, 行號, 原文, 原因)])。問題:寫錯的條件、沒帶期限、指到的筆記找不到、
 25976	    file 指到資料夾、寫在不評估的地方、判不了。"""
 25977	    found, probs = [], []
 25978	    for p in sorted(nenv.notes):
 25979	        rows, dead = _probe_lines(env_text(nenv, p) or "")
 25980	        probs += [(p, no, tx, why) for no, tx, why in dead]
 25981	        for no, tx, pr in rows:
 25982	            bad = [e for e in pr["errs"]]
 25983	            if pr["by"] is None and "沒有條件標記" not in bad:
 25984	                bad.append("沒帶期限 [by:YYYY-MM-DD]")
 25985	            for k, v in pr["conds"]:
 25986	                if k == "status" and _probe_value_err(k, v) is None and nenv.resolve(link_target(v.partition("=")[0].strip())) is None:
 25987	                    bad.append(f"when-status 指的筆記 {v.partition('=')[0].strip()} 找不到(改名或刪了?)")
 25988	                if k == "file" and _probe_value_err(k, v) is None and v not in ctx.files \
 25989	                        and any(f.startswith(v.rstrip("/") + "/") for f in ctx.files):
 25990	                    bad.append(f"when-file 指到資料夾 {v}(要指一支檔)")
 25991	            probs += [(p, no, tx, why) for why in bad]
 25992	            if not pr["conds"] or any(_probe_value_err(k, v) for k, v in pr["conds"]):
 25993	                continue
 25994	            ok = ctx.line(tuple(pr["conds"]))
 25995	            if ok is None:
 25996	                probs.append((p, no, tx, "判不了(git 讀不出程式檔)"))
 25997	            elif ok:
 25998	                found.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [],
 25999	                              "why": "條件已經成立,該處理了" + (f"(期限 {pr['by']})" if pr["by"] else "")})
 26000	    return found, probs
