 26339	    """probe 題(乙):把那篇筆記的那一行在起點與終點兩版都換成改寫檔給的條件式,對 event_commit 跑 check,
 26340	    那一行在「要處理」算擋到。不改被考 repo(只在記憶體裡換)。"""
 26341	    pb = (probes or {}).get(q.get("id"))
 26342	    if not pb:
 26343	        return "略過:改寫檔沒有這一題", 0, 0, 0
 26344	    c = _lens_full_sha(root, pb.get("event_commit") or "")
 26345	    par = _lens_full_sha(root, f"{pb.get('event_commit')}^") if c else None
 26346	    if c is None or par is None:
 26347	        return "略過:找不到 event_commit 或它的上一版", 0, 0, 0
 26348	    vr = _drift_vault_rel(root, c) or vault_rel
 26349	    note = q.get("note_at_event") or q.get("note")
 26350	    orig, new = str(q.get("text", "")).strip(), str(pb.get("rewrite", "")).strip()
 26351	
 26352	    def _swap(where, v):
 26353	        env = _drift_tree_env(root, where, v)
 26354	        t = env_text(env, note) if env is not None else None
 26355	        if t is None:
 26356	            return None, None
 26357	        lines = t.split("\n")
 26358	        hit = [i for i, ln in enumerate(lines) if ln.strip() == orig]
 26359	        for i in hit:
 26360	            ind = lines[i][:len(lines[i]) - len(lines[i].lstrip())]
 26361	            lines[i] = ind + new
 26362	        return {note: "\n".join(lines)}, (hit[0] + 1 if hit else None)
 26363	    ov_tip, line_tip = _swap(c, vr)
 26364	    ov_base, _lb = _swap(par, _drift_vault_rel(root, par) or vr)
 26365	    if ov_tip is None or line_tip is None:
 26366	        return "略過:終點那一版找不到那一行", 0, 0, 0
 26367	    must, listed, unknown = _drift_check_core(root, par, c, vr, override=ov_tip, override_base=ov_base)
 26368	    hit_kind = next((f["kind"] for f in must if f["path"] == note and f["line"] == line_tip), None)
 26369	    others_m = _drift_exam_others(must, note, line_tip, hit_kind)
 26370	    others_l = _drift_exam_others(listed, note, line_tip, hit_kind)
 26371	    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
 26372	    return ("擋到" if hit_kind else "漏"), len(others_m), len(others_l), noise
