 23885	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名再讀。
 23935	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 23936	        if names is None:
 23937	            return None
 23938	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23939	        pren = [_renames(pp, sha) or {} for pp in parents]
 23940	        for pr in pren[1:]:
 23941	            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
 23942	            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
 23943	            _carry(pr)
 23944	        specs = []
 23945	        for p in paths:
 23946	            specs.append(f"{sha}:{p}")
 23947	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
 23948	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23949	        k = 1 + len(parents)
 23950	        for i, p in enumerate(paths):
 23951	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23952	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23953	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23954	                d = _ns_diff(repo_root, first, sha, "--", p)
 23955	                if d is None:
 23956	                    return None
 23957	                for _p, rows in _notelines_parse_added(d).items():
 23958	                    dest.setdefault(nfc(p), set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23959	            else:
