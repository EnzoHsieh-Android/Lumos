 26474	def _drift_exam_report(rows, skipped, as_json):
 26475	    """考試結果 → 印表格或 JSON,回 0。"""
 26476	    import json as _j
 26477	    summ = {"擋到": 0, "點到": 0, "漏": 0, "誤列": 0, "沒誤列": 0, "略過": 0}
 26478	    for r in rows:
 26479	        summ["略過" if r["result"].startswith("略過") else r["result"]] += 1
 26480	    tot = {"skipped_mechanism1": skipped, "summary": summ,
 26481	           "誤報_要處理": sum(r["other_must"] for r in rows), "誤報_只列出": sum(r["other_listed"] for r in rows),
 26482	           "噪音最大": max([r["noise"] for r in rows] or [0]), "rows": rows}
 26483	    if as_json:
 26484	        print(_j.dumps(tot, ensure_ascii=False, indent=1))
 26485	        return 0
 26486	    print(f"略過 {skipped} 題(機制①,給實驗計劃)")
 26487	    print("題號  考法            結果        誤報(要處理/只列出)  噪音")
 26488	    for r in rows:
 26489	        print(f"{r['id']:<5} {r['event']:<15} {r['result']:<10}  {r['other_must']}/{r['other_listed']}"
 26490	              f"{'':<16}{r['noise']}")
 26491	    print("合計:" + "、".join(f"{k} {v}" for k, v in summ.items())
 26492	          + f";誤報 要處理 {tot['誤報_要處理']}、只列出 {tot['誤報_只列出']};單一提交噪音最大 {tot['噪音最大']}")
 26493	    return 0
