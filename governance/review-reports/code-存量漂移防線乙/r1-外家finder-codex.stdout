 26530	def _drift_exam_history(root, vault_rel, at_sha, n, as_json):
 26531	    """門檻②:被考 repo 最近 n 個主線提交各跑一次 check(父..提交),每筆要處理列出來給人逐筆判真假。"""
 26532	    import json as _j
 26533	    rl = _lens_git(root, "rev-list", "--first-parent", f"--max-count={int(n)}", at_sha)
 26534	    if rl is None or rl.returncode != 0:
 26535	        print("擋下:git 列不出提交", file=sys.stderr)
 26536	        return 2
 26537	    out = []
 26538	    for c in rl.stdout.split():
 26539	        par = _lens_full_sha(root, f"{c}^")
 26540	        if par is None:
 26541	            continue
 26542	        must, listed, unknown = _drift_check_core(root, par, c, _drift_vault_rel(root, c) or vault_rel)
 26543	        if must or unknown:
 26544	            out.append({"commit": c[:10], "must": [f"{f['kind']} {f['path']}:{f['line']} {f['text'][:50]}" for f in must],
 26545	                        "unknown": unknown, "listed": len(listed),
 26546	                        "noise": len({f['path'] for f in must if f['kind'] == 'c1'}) + sum(1 for f in must if f['kind'] != 'c1')})
 26547	    if as_json:
 26548	        print(_j.dumps({"commits": int(n), "with_must": out}, ensure_ascii=False, indent=1))
 26549	        return 0
 26550	    print(f"最近 {n} 個主線提交裡,有要處理的 {len(out)} 個(每筆要人判真假):")
 26551	    for r in out:
 26552	        print(f"  {r['commit']}  噪音 {r['noise']}" + (f"  判不了:{';'.join(r['unknown'])}" if r["unknown"] else ""))
 26553	        for m in r["must"]:
 26554	            print(f"      {m}")
 26555	    return 0
