 24056	def _notelines_headings(text, regs):
 24057	    """每一行的「所屬小標題」→ 清單(跟行一一對應)。正文=往上最近一行 `#` 標題(跳過圍欄內的行,用全檔唯一的
 24058	    圍欄判定 _visible_lines);summary=`summary`;decisions=`decisions/<決策編號>/<欄名>`;其他=空字串。"""
 24059	    lines = text.split("\n")
 24060	    vis = {i for i, _l in _visible_lines(lines)}
 24061	    dfields = _notelines_decision_fields(text)
 24062	    out, cur = [], ""
 24063	    for i, ln in enumerate(lines, 1):
 24064	        reg = regs[i - 1]
 24065	        if reg == "body" and i in vis:
 25500	    for src, lit, et, cands in ti["ambiguous"]:
 25501	        sn = env.notes.get(src)
 25502	        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
 25503	                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
 25504	            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
 25505	    return out
