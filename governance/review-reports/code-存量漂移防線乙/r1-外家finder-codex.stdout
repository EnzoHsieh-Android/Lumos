 22679	def _nodehome_layout(all_paths):
 22680	    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
 22681	    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
 22682	    tops = _nodehome_top_dirs(all_paths)
 22683	    top_exts, main_exts = {}, {}
 22684	    for p in all_paths:
 22685	        e = _testmap_ext(p)
 22686	        if not e:
 22687	            continue
 22688	        parts = p.split("/")
 22689	        if len(parts) > 1 and parts[0] in tops:
 22690	            top_exts.setdefault(parts[0], set()).add("." + e)
 22691	        for k in range(len(parts) - 2):
 22692	            if parts[k] == "src" and parts[k + 1] == "main":
 22693	                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
 22694	                break
 22695	    return top_exts, main_exts
