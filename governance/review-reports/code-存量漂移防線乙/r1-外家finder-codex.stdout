 26141	def cmd_drift_check(repo=None, diff_range=None):
 26142	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 26143	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
 26144	    import time as _t
 26145	    root = _note_audit_root(repo)
 26146	    if root is None:
 26147	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 26148	        return 0
 26149	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 26150	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 26151	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 26152	        return 0
 26153	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 26154	                                               mark=_DRIFT_GOLIVE_MARK)
 26155	    if tip is None or isinstance(tip, int):
 26156	        return tip if isinstance(tip, int) else 0
 26157	    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 26158	    for w in warns:
 26159	        print(f"提醒:{w}", file=sys.stderr)
 26160	    if mode == "off":
 26161	        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 26162	        return 0
 26163	    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 26164	                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 26165	    acks = _drift_load_acks(root, tip)
 26166	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 26167	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 26168	    lst = _nodehome_list(root, tip)
 26169	    alive = set(lst[1]) if lst else None
 26170	    if listed:
 26171	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 26172	        _drift_print_findings(listed, sys.stderr, acks, alive)
 26173	    if not must and not unknown:
 26174	        return 0
 26175	    return _drift_report_must(root, mode, must, unknown, acks, alive)
 26176	
 26177	
 26178	def _drift_report_must(root, mode, must, unknown, acks, alive=None):
 26179	    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
 26180	    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
 26181	    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
 26182	    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
 26183	    for u in unknown:
 26184	        print(f"  判不了:{u}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
 26185	              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
 26186	    _drift_print_findings(must, sys.stderr, acks, alive)
 26187	    if must:
 26188	        # ★不叫人重跑 guard settle★(代碼審 r1 正確性席):已經 pass 的紀錄 settle 直接回「已轉正」,不會改寫
 26189	        print("每一筆:把預告句手改成歷史說法(例:「為什麼還不做:」改成「預告當時為什麼還不做:」),"
 26190	              "或留著並表態:\n    lumos drift ack <節點> <行號> --kind <種類> --reason \"<為什麼照留>\"", file=sys.stderr)
 26191	    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
 26192	    if mode == "block":
 26193	        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
 26194	                            nodes=sorted({f["path"][:-3] for f in must})[:50])
 26195	        return 1
 26196	    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
 26197	    return 0
