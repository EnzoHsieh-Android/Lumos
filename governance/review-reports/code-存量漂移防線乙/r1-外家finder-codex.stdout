 23854	def _ns_diff(repo_root, *args):
 23855	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23856	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
