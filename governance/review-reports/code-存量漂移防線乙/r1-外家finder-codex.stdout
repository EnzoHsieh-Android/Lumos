 25659	def _revisit_split(line):
 25660	    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
 25661	    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
 25662	    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
 25663	    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
 25664	    import datetime
 25665	    if line.lstrip().startswith("|"):
 26025	            out.append(d)
 26026	    return out
