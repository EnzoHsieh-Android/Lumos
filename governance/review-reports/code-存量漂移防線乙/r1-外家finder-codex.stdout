 25648	# ── 乙:條件式回頭條件(計劃〈做法〉第 0、2 節)────────────────────────────────────────
 25649	# 回頭條件原本只能寫日期,事件發生了日期還沒到就沒人看(rtb 根因機制②)。改成可以寫機器判得了的條件:
 25650	#   REVISIT:[when-file:src/x/runner.py][by:2026-12-31] 補啟動環境不含金鑰的測試
 25651	# 條件成立或到期,任一先到就該處理;推送讓條件從不成立變成立時擋。
 25652	_REVISIT_MARK_RE = re.compile(r"^(?:[-*+][ \t]+|\d+[.)][ \t]+|>[ \t]*)")
 25653	_PROBE_TOKEN_RE = re.compile(r"[ \t]*\[(when-[A-Za-z0-9_-]*|by):([^\]\n]*)\]")
 25654	_PROBE_ANY_RE = re.compile(r"\[when-[A-Za-z0-9_-]*:[^\]\n]*\]")
 25655	_PROBE_KEYS = ("file", "symbol", "test", "status")
 25656	_PROBE_LEAD_RE = re.compile(r"^(?:[ \t]*\[(?:when-[A-Za-z0-9_-]*|by):[^\]\n]*\])+")
 25657	
 25658	
 25659	def _revisit_split(line):
 25660	    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
 25661	    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
 25662	    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
 25663	    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
 25664	    import datetime
 25665	    if line.lstrip().startswith("|"):
 25666	        return None, None
 25667	    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
 25668	    if not s.startswith("REVISIT:"):
 25669	        return None, None
 25670	    rest = s[len("REVISIT:"):]
 25671	    if rest.lstrip().startswith("[when-"):
 25672	        return "cond", rest
 25673	    try:
 25674	        datetime.date.fromisoformat(rest.partition(" ")[0])
 25675	        return "date", rest
 25676	    except ValueError:
 25677	        return "bad", rest
 25678	
 25679	
 25680	def _probe_value_err(k, v):
 25681	    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
 25682	    if k not in _PROBE_KEYS:
 25683	        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
 25684	    if not v:
 25685	        return f"when-{k} 的值是空的"
 25686	
 25687	    if k == "file":
 25688	        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
 25689	    if k in ("symbol", "test"):
 25690	        return _probe_named_err(k, v)
 25691	    node, eq, vals = v.partition("=")
 25692	    if not eq or not node.strip() or not vals.strip():
 25693	        return "when-status 要寫成 <節點>=<值>"
 25694	    if any(not x.strip() for x in vals.split("|")):
 25695	        return "when-status 的值用 | 分開時每一段都不能空"
 25696	    return None
 25697	
 25698	
 25699	def _probe_bad_path(p):
 25700	    return (not p) or p.startswith("/") or ".." in p.split("/")
 25701	
 25702	
 25703	def _probe_named_err(k, v):
 25704	    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
 25705	    if "::" not in v:
 25706	        return None
 25707	    path, name = v.rsplit("::", 1)
 25708	    if not name.strip():
 25709	        return f"when-{k} 的名稱是空的"
 25710	    if _probe_bad_path(path.strip()):
 25711	        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
 25712	    return None
 25713	
 25714	
 25715	def _probe_parse(rest):
 25716	    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
 25717	    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
 25718	    import datetime
 25719	    conds, by, errs, pos = [], None, [], 0
 25720	    while True:
 25721	        m = _PROBE_TOKEN_RE.match(rest, pos)
 25722	        if not m:
 25723	            break
 25724	        pos = m.end()
 25725	        key, val = m.group(1), m.group(2).strip()
 25726	        if key == "by":
 25727	            if by is not None:
 25728	                errs.append("期限寫了兩個")
 25729	                continue
 25730	            try:
 25731	                datetime.date.fromisoformat(val)
 25732	                by = val
 25733	            except ValueError:
 25734	                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
 25735	            continue
 25736	        k = key[len("when-"):]
 25737	        err = _probe_value_err(k, val)
 25738	        if err:
 25739	            errs.append(err)
 25740	        conds.append((k, val))
 25741	    if not conds:
 25742	        errs.append("沒有條件標記")
 25743	    return {"conds": conds, "by": by, "errs": errs}
