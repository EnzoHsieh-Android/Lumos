 26508	def _drift_exam_load(exam):
 26509	    """考卷 → 題目清單;讀不了或有不認得的考法回 None(已印原因)。"""
 26510	    import json as _j
 26511	    try:
 26512	        qs = _j.loads(Path(exam).read_text(encoding="utf-8"))
 26513	    except (OSError, ValueError) as ex:
 26514	        print(f"擋下:考卷讀不了:{ex}", file=sys.stderr)
 26515	        return None
 26516	    if isinstance(qs, dict):
 26517	        qs = qs.get("items") or []
 26518	    # ★形狀先驗★(代碼審 r1 邊界席:純量或字串清單原本直接丟 Python 例外)
 26519	    if not isinstance(qs, list) or not all(isinstance(q, dict) for q in qs):
 26520	        print("擋下:考卷要是一個題目清單(每題一個物件),或 {\"items\": [...]}", file=sys.stderr)
 26521	        return None
 26522	    known = ("commit", "status_replay", "probe", "current_state", "mechanism1_experiment")
 26523	    bad = sorted({str(q.get("exam_event")) for q in qs if q.get("exam_event") not in known})
 26524	    if bad:
 26525	        print(f"擋下:考卷裡有不認得的考法 {bad}", file=sys.stderr)
 26526	        return None
 26527	    return qs
