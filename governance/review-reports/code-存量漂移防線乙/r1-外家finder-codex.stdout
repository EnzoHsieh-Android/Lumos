 26210	def cmd_drift_scan(env, at=None, as_json=False):
 26211	    """lumos drift scan [--at 提交] [--json]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查,列出全部發現,
 26212	    已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。"""
 26213	    import json as _j
 26214	    root, vault_rel = _drift_vault_of(env)
 26215	    tenv, sha = env, None
 26216	    if at:
 26217	        sha = _lens_full_sha(root, at)
 26218	        if sha is None:
 26219	            print(f"擋下:找不到提交 {at}", file=sys.stderr)
 26220	            return 2
 26221	        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
 26222	        vault_rel = _drift_vault_rel(root, sha) or vault_rel
 26223	        tenv = _drift_tree_env(root, sha, vault_rel)
 26224	        if tenv is None:
 26225	            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
 26226	            return 2
 26227	    pfound, probs = _drift_probe_scan(tenv, _ProbeTree(root, sha or "disk", tenv))
 26228	    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
 26229	    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
 26230	    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
 26231	    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
 26232	    if as_json:
 26233	        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
 26234	                        "problems": [{"path": p, "line": n, "text": t, "why": w} for p, n, t, w in probs],
 26235	                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
 26236	                       ensure_ascii=False, indent=1))
 26237	        return 0
 26238	    _drift_scan_print(at, left, done, bad)
 26239	    if probs:
 26240	        print(f"[回頭條件的問題] {len(probs)} 處(寫錯、沒帶期限、指不到、寫在不評估的地方、判不了):")
 26241	        for p, n, t, w in probs:
 26242	            print(f"  {p}:{n}  {t[:70]}")
 26243	            print(f"      {w}")
 26244	    return 0
