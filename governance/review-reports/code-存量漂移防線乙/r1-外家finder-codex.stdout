 22653	def _nodehome_stack_test_dirs():
 22654	    """從測試棧對照表 TEST_PROFILES 推各棧的測試資料夾,不另寫清單(對照表多一個,這裡跟著認;
 22655	    t_nodehome_stack_test_dirs_not_required 的漂移守衛釘住):頂層比對模式的棧(Swift、C#)取「頂層資料夾名稱結尾」,
 22656	    限 src/ 底下遞迴找的棧(Kotlin/Gradle)取「src/ 底下的資料夾名」,兩種都連同那一棧的副檔名。其餘遞迴模式的棧不推——
 22657	    Python 那份把 scripts 當測試資料夾、Playwright 的 tests/e2e 不限位置,錨定太鬆會把真程式檔放掉。"""
 22658	    global _NODEHOME_STACK_TEST_DIRS
 22659	    if _NODEHOME_STACK_TEST_DIRS is None:
 22660	        sufs, under_src = {}, {}
 22661	        for prof in TEST_PROFILES.values():
 22662	            names = {d for inc, _exc in prof.get("dirs", {}).values() for d in inc if d}
 22663	            if prof.get("dir_mode") == "suffix":
 22664	                for d in names:
 22665	                    sufs.setdefault(d, set()).update(prof.get("exts", ()))
 22666	            elif prof.get("rglob_under") == "src":
 22667	                for d in names:
 22668	                    under_src.setdefault(d, set()).update(prof.get("exts", ()))
 22669	        _NODEHOME_STACK_TEST_DIRS = ({k: frozenset(v) for k, v in sufs.items()}, {k: frozenset(v) for k, v in under_src.items()})
 22670	    return _NODEHOME_STACK_TEST_DIRS
