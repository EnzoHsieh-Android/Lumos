 22835	    if where == "index":
 22990	
 22991	def _nodehome_changes(repo_root, base, tip):
 22992	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22993	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22994	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22995	    if tip == "index":
 22996	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22997	        if base is None:
 22998	            args.append(_EMPTY_TREE_SHA)
 22999	    else:
 23000	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 23001	    raw = _nodehome_git(repo_root, *args)
 23002	    if raw is None:
 23003	        return None
 23004	    toks = _nodehome_split_z(raw)
 23005	    out, i = [], 0
 23006	    while i < len(toks):
 23007	        st = toks[i]
 23008	        code = st[:1]
 23009	        if code in ("R", "C") and i + 2 < len(toks):
 23010	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 23011	            i += 3
 23012	        elif i + 1 < len(toks):
 23013	            p = nfc(toks[i + 1])
 23014	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 23015	            i += 2
 23016	        else:
 23017	            break
 23018	    return out
