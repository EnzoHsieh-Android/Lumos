 25940	def _probe_prepare(root, base, tip, vault_rel, deadline, override_base):
 25941	    """推送判定要的起點資料 → (範圍改動, 起點圖譜, 筆記改名對照 新→舊, 判不了的原因或 None)。"""
 25942	    ch = _probe_changes(root, base, tip, deadline)
 25943	    if ch is None:
 25944	        return None, None, {}, "git 算不出這次推送改了哪些檔(條件式回頭條件)"
 25945	    if not base:
 25946	        return ch, None, {}, None
 25947	    benv = _drift_tree_env(root, base, _drift_vault_rel(root, base) or vault_rel, override_base, deadline=deadline)
 25948	    if benv is None:
 25949	        return None, None, {}, "git 讀不出起點的筆記(條件式回頭條件)"
 25950	    rn = _ns_git(root, "diff", "--name-status", "-z", "-M", base, tip, "--", vault_rel)
 25951	    if rn is None:
 25952	        return None, None, {}, "git 算不出筆記改名(條件式回頭條件)"
 25953	    return ch, benv, _nodehome_name_status(rn)[1], None
 25954	
