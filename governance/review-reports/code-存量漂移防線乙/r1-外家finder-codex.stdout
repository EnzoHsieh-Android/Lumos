 26104	def _drift_config(text):
 26105	    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
 26106	    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
 26107	    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
 26108	    import json as _j
 26109	    if text is None:
 26110	        return _DRIFT_DEFAULT_GATE, [], False
 26111	    try:
 26112	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 26113	    except (ValueError, UnicodeDecodeError):
 26114	        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
 26115	        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
 26116	    if not isinstance(cfg, dict) or "drift_check" not in cfg:
 26117	        return _DRIFT_DEFAULT_GATE, [], False
 26118	    dc = cfg["drift_check"]
 26119	    if not isinstance(dc, dict):
 26120	        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
 26121	                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
 26122	    g = dc.get("gate")
 26123	    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
 26124	        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
 26125	    if g not in _DRIFT_GATE_VALUES:
 26126	        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
 26127	    return g, [], True
