 26386	        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
 26387	        return ("誤列" if hit else "沒誤列"), 0, 0, 0
 26388	    if ev == "probe":
 26389	        return _drift_exam_probe(root, vault_rel, q, probes)
 26390	    commits = q.get("invalidating_commits") or []
 26391	    if ev not in ("commit", "status_replay") or not commits:
 26392	        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
 26393	    c = _lens_full_sha(root, commits[0])
 26394	    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
 26395	    if c is None or par is None:

