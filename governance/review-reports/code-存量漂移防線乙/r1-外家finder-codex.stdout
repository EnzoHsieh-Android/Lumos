 23825	def _notelines_parse_added(raw):
 23826	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23827	    out, path, n = {}, None, 0
 23828	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23829	        if ln.startswith("+++ "):
 23830	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23831	            path = nfc(p[2:]) if p.startswith("b/") else None
 23832	            continue
 23833	        if ln.startswith("@@"):
 23834	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23835	            n = int(m.group(1)) if m else 0
 23836	            continue
 23837	        if path is None or ln.startswith("---"):
 23838	            continue
 23839	        if ln.startswith("+"):
 23840	            out.setdefault(path, []).append((n, ln[1:]))
 23841	            n += 1
 23842	    return out
 23843	
