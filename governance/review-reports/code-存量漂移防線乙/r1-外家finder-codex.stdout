 26417	def _drift_exam_replay(root, par, vault_rel, targets):
 26418	    """status_replay:取上一版的樹,在記憶體裡把 targets 每一份計劃改成 done,回 lumos set 會列的連帶待辦路徑集合。"""
 26419	    tenv0 = _drift_tree_env(root, par, vault_rel)
 26420	    if tenv0 is None:
 26421	        return None
 26422	    texts = {}
 26423	    for t in targets:
 26424	        prel = tenv0.resolve(link_target(t))
 26425	        txt = env_text(tenv0, prel) if prel else None
 26426	        if txt is None and prel and _note_unreadable(tenv0.notes[prel]):
 26427	            return "unreadable"      # 讀不出來的計劃沒辦法在記憶體裡改狀態:這題略過,不算漏(代碼審 r4、r5 正確性席)
 26428	        if txt is not None:
 26429	            texts[prel] = _drift_set_status_text(txt, "done")
 26430	    tenv = _drift_tree_env(root, par, vault_rel, override=texts)
 26431	    fu = set()
 26432	    for prel in texts:
 26433	        fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
 26434	    return fu
