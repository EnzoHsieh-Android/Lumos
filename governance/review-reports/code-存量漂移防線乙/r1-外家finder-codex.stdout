 25746	def _probe_lines(text):
 25747	    """一篇筆記的條件式回頭條件 → (清單[(行號, 原文, 解析結果)], 寫在不評估的地方[(行號, 原文, 原因)])。
 25748	    只認正文與摘要的可見行:圍欄(_visible_lines)、行內程式碼(_strip_inline_markup)、表格行裡的都不算;
 25749	    開頭欄位裡 summary 以外的欄與表格行裡的條件標記列成「寫在不評估的地方」(計劃〈做法〉第 0 節)。"""
 25750	    lines = text.split("\n")
 25751	    regs = _notelines_regions(text)
 25752	    vis = {no for no, _ln in _visible_lines(lines)}
 25753	    out, dead = [], []
 25754	    for i, ln in enumerate(lines, 1):
 25755	        if i not in vis:
 25756	            continue
 25757	        probe = _strip_inline_markup(ln)[0]
 25758	        table = probe.lstrip().startswith("|")
 25759	        if regs[i - 1] in ("body", "summary") and not table:
 25760	            kind, rest = _revisit_split(probe)
 25761	            if kind == "cond":
 25762	                out.append((i, ln.strip(), _probe_parse(rest)))
 25763	            continue
 25764	        if _PROBE_ANY_RE.search(probe):
 25765	            dead.append((i, ln.strip(), "寫在表格行裡,不評估" if table else "寫在開頭欄位裡 summary 以外的欄,不評估"))
 25766	    return out, dead
 25767	
 25768	
 25769	def _probe_py_def_re(name, test):
 25770	    n = re.escape(name)
 25771	    if test:
 25772	        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
 25773	    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)
 25774	
 25775	
 25776	class _ProbeTree:
 25777	    """在某一版(提交的樹、工作目錄 'disk'、或空的 None)上判條件。程式檔與測試檔的內容用到才一次批次讀。
 25778	    status 條件用 notes_env(那一版的圖譜)解連結。git 失敗時 ok=False,判定一律回 None(判不了)。"""
 25779	
 25780	    def __init__(self, root, where, notes_env, deadline=None):
 25781	        import time as _t
 25782	        self.root, self.where, self.env, self.deadline, self._t = root, where, notes_env, deadline, _t
 25783	        self._corpus = {}
 25784	        if where is None:
 25785	            self.ok, self.files, self.layout = True, set(), ({}, {})
 25786	            return
 25787	        lst = _nodehome_list(root, "index" if where == "disk" else where)
 25788	        self.ok = lst is not None
 25789	        self.files = set(lst[0]) if lst else set()
 25790	        self.layout = _nodehome_layout(lst[1]) if lst else ({}, {})
 25791	
 25792	    def _read_many(self, paths):
 25793	        if self.where == "disk":
 25794	            out = {}
 25795	            for p in paths:
 25796	                try:
 25797	                    out[p] = (Path(self.root) / p).read_bytes()
 25798	                except OSError:
 25799	                    out[p] = None
 25800	            return out
 25801	        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
 25802	        blobs = _nodehome_cat_blobs(self.root, [f"{self.where}:{p}" for p in paths], timeout=left) if paths else []
 25803	        return None if blobs is None else dict(zip(paths, blobs))
 25804	
 25805	    def corpus(self, test):
 25806	        """程式檔(test=False,不含 docs/、governance/ 與測試檔)或測試檔的 {路徑: 文字};讀不到回 None。"""
 25807	        if test not in self._corpus:
 25808	            paths = sorted(p for p in self.files if _nodehome_code_kind(p) == "ext"
 25809	                           and not p.startswith(("docs/", "governance/"))
 25810	                           and _nodehome_is_test(p, self.layout) == test)
 25811	            got = self._read_many(paths)
 25812	            self._corpus[test] = None if got is None else {
 25813	                p: b.decode("utf-8", errors="replace") for p, b in got.items() if b is not None}
 25814	        return self._corpus[test]
 25815	
 25816	    def one(self, k, v):
 25817	        """一個條件 → True / False / None(判不了)。"""
 25818	        if not self.ok:
 25819	            return None
 25820	        if k == "file":
 25821	            return v in self.files
 25822	        if k == "status":
 25823	            node, _eq, vals = v.partition("=")
 25824	            rel = self.env.resolve(link_target(node.strip())) if self.env is not None else None
 25825	            n = self.env.notes.get(rel) if rel else None
 25826	            return n is not None and _drift_str(n, "status") in {x.strip() for x in vals.split("|")}
 25827	        test = k == "test"
 25828	        path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
 25829	        path, name = path.strip(), name.strip()
 25830	        corpus = self.corpus(test)
 25831	        if corpus is None:
 25832	            return None
 25833	        items = [(path, corpus.get(path))] if path else list(corpus.items())
 25834	        word = re.compile(rf"(?<![\w]){re.escape(name)}(?![\w])")
 25835	        pydef = _probe_py_def_re(name, test)
 25836	        for p, txt in items:
 25837	            if txt is None:
 25838	                continue
 25839	            if (pydef if p.endswith(".py") else word).search(txt):
 25840	                return True
 25841	        return False
 25842	
 25843	    def line(self, conds):
 25844	        """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
 25845	        vals = [self.one(k, v) for k, v in conds]
 25846	        if any(x is False for x in vals):
 25847	            return False
 25848	        return None if any(x is None for x in vals) else True
 25849	
 25850	
 25851	def _probe_changes(root, base, tip, deadline=None):
 25852	    """範圍裡的改動(只算一次)→ {touched: 改到的路徑(改名兩端都算), added_text: 新增行的文字(程式與測試檔),
 25853	    code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗回 None。起點是空樹時 added_text 不算(每一行都當候選)。"""
 25854	    import time as _t
 25855	    if deadline is not None and _t.monotonic() > deadline:
 25856	        return None
 25857	    raw = _ns_git(root, "diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip)
 25858	    if raw is None:
 25859	        return None
 25860	    toks = _nodehome_split_z(raw)
 25861	    touched, shape, i = set(), False, 0
 25862	    while i < len(toks):
 25863	        code = toks[i][:1]
 25864	        if code in ("R", "C") and i + 2 < len(toks):
 25865	            ps = [nfc(toks[i + 1]), nfc(toks[i + 2])]
 25866	            i += 3
 25867	        elif i + 1 < len(toks):
 25868	            ps = [nfc(toks[i + 1])]
 25869	            i += 2
 25870	        else:
 25871	            break
 25872	        touched.update(ps)
 25873	        if code in ("A", "D", "R", "C") and any(_nodehome_code_kind(x) == "ext" for x in ps):
 25874	            shape = True
 25875	    added = ""
 25876	    if base:
 25877	        if deadline is not None and _t.monotonic() > deadline:
 25878	            return None
 25879	        d = _ns_diff(root, base, tip)
 25880	        if d is None:
 25881	            return None
 25882	        added = "\n".join(t for p, rows in _notelines_parse_added(d).items() if _nodehome_code_kind(p) == "ext"
 25883	                          for _n, t in rows)
 25884	    return {"touched": touched, "added_text": added, "code_shape": shape}
 25885	
