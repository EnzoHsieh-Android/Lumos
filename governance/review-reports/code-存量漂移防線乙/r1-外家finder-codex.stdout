 25906	def _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=None, override_base=None):
 25907	    """乙的推送判定 → (要處理, 只列出, 判不了)。候選行(被這次推送影響、或這次新寫/改了條件標記的)在終點評估全部條件;
 25908	    終點成立,而起點沒有「同一條」(改名對回後,條件標記一模一樣)或同一條還不成立 → 要處理;起點早就成立 → 不列。"""
 25909	    pre = vault_rel.rstrip("/") + "/"
 25910	    lines = [(p, no, tx, pr) for p in sorted(tenv.notes) for no, tx, pr in _probe_lines(env_text(tenv, p) or "")[0]]
 25911	    # 條件本身寫錯的行不評估(第一層擋新寫的、scan 列成寫錯);只缺期限的照評估
 25912	    lines = [x for x in lines if x[3]["conds"] and all(_probe_value_err(k, v) is None for k, v in x[3]["conds"])]
 25913	    if not lines:
 25914	        return [], [], []
 25915	    ch, benv, ren, err = _probe_prepare(root, base, tip, vault_rel, deadline, override_base)
 25916	    if err:
 25917	        return [], [], [err]
 25918	    tip_ctx = _ProbeTree(root, tip, tenv, deadline)
 25919	    base_ctx = _ProbeTree(root, base, benv, deadline) if base else None
 25920	    must, unknown = [], []
 25921	    base_lines = {}
 25922	    for p, no, tx, pr in lines:
 25923	        old = None
 25924	        if benv is not None:
 25925	            bp = ren.get(pre + p, pre + p)
 25926	            bp = bp[len(pre):] if bp.startswith(pre) else p
 25927	            if bp not in base_lines:
 25928	                base_lines[bp] = {tuple(x[2]["conds"]) for x in _probe_lines(env_text(benv, bp) or "")[0]}
 25929	            old = tuple(pr["conds"]) in base_lines[bp]
 25930	        if old and not _probe_is_candidate(pr["conds"], ch, pre, tenv):
 25931	            continue
 25932	        verdict = _probe_judge(tip_ctx, base_ctx, pr, old)
 25933	        if verdict is None:
 25934	            unknown.append(f"{p}:{no} 的條件判不了(git 讀不出程式檔)")
 25935	        elif verdict:
 25936	            must.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [], "why": verdict})
 25937	    return must, [], unknown
 25938	
