 26375	def _drift_exam_one(root, vault_rel, q, at_sha, probes=None):
 26376	    """一題 → (結果, 誤報要處理, 誤報只列出, 噪音)。結果:擋到 / 點到 / 漏 / 誤列 / 沒誤列 / 略過:<原因>。"""
 26377	    ev = q.get("exam_event")
