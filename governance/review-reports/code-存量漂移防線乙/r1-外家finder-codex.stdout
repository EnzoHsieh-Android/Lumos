 25508	def _drift_status_probe_followups(env, rel, new_status):
 25509	    """連帶待辦第③項(乙,[S15]):[when-status:<這份計劃>=…] 的 status 條件因這次收尾成立的回頭條件——只做文字比對,
 25510	    不跑 git;同一行還有別的條件時註明,不宣稱整行成立。"""
 25511	    out = []
 25512	    for p in sorted(env.notes):
 25513	        for no, _tx, pr in _probe_lines(env_text(env, p) or "")[0]:
 25514	            hit = [v for k, v in pr["conds"] if k == "status" and _probe_value_err(k, v) is None
 25515	                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
 25516	                   and new_status in {x.strip() for x in v.partition("=")[2].split("|")}]
 25517	            if hit:
 25518	                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
 25519	                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
 25520	    return out
