 22698	def _nodehome_in_stack_test_dir(path, layout):
 22699	    """在各棧的測試資料夾裡——兩種都要「旁邊的程式目標有同一種檔」,只看資料夾名會把業務資料夾放掉
 22700	    (2026-09-12 代碼審兩輪各席造出的反例:A/B 測試功能模組 ABTests/、Python 專案的 LoadTests/、
 22701	    scriptsTests/ 裡的 .cs、src/androidTest 裡的 .py):
 22702	    ① 頂層資料夾 = <X> 加對照表的結尾樣式(PosTerminalTests/、PosTerminalUITests/、Foo.IntegrationTests/),
 22703	       副檔名屬於貢獻那個結尾的棧,而且頂層的 <X> 資料夾裡有同一種副檔名的檔(Xcode 的 App 配 AppTests、
 22704	       .NET 的 Foo 配 Foo.Tests);資料夾就叫結尾樣式本身(UITests/、IntegrationTests/)的直接認;
 22705	    ② 緊接在 src 下一層的對照表測試資料夾名(app/src/androidTest/…),副檔名屬於貢獻那個名字的棧(Kotlin),
 22706	       而且同一個模組的 src/main 有同一種副檔名的檔——只看 src/main 有沒有同副檔名的檔,混在 src/main 的建置腳本
 22707	       (.py、.sh)就能讓 androidTest 裡同副檔名的檔免家(代碼審第三輪四席各自造出反例)。
 22708	    別種語言的測試輔助檔(Xcode 測試資料夾裡的橋接標頭 .h、Java 寫的 androidTest 輔助檔——對照表沒有 Java 棧)照舊要家:
 22709	    寧可過嚴,逃生口是 node_home.ignore;要認就把那一棧補進測試棧對照表,這裡自動跟著認。
 22710	    layout=_nodehome_layout 的結果。對不上的照舊要家(過嚴、不漏)。"""
 22711	    sufs, under_src = _nodehome_stack_test_dirs()
 22712	    top_exts, main_exts = layout
 22713	    parts = path.split("/")
 22714	    e = _testmap_ext(path)
 22715	    if len(parts) < 2 or not e:
 22716	        return False
 22717	    ext, top = "." + e, parts[0]
 22718	    for suf, exts in sufs.items():
 22719	        if ext not in exts or not top.endswith(suf):
 22720	            continue
 22721	        base = top[:-len(suf)].rstrip(".")
 22722	        if not base or ext in top_exts.get(base, ()):
 22723	            return True
 22724	    for i in range(1, len(parts) - 1):
 22725	        if parts[i - 1] == "src" and ext in under_src.get(parts[i], ()) and ext in main_exts.get("/".join(parts[:i]), ()):
 22726	            return True
 22727	    return False
