 23044	def _nodehome_merge_own_changes(repo_root, sha, parents):
 23045	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 23046	
 23047	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 23048	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 23049	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 23050	    或順手多改的部分,正是這道檢查要看的。
 23051	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 23052	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 23053	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 23054	    """
 23055	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 23056	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 23057	        return None
 23058	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 23059	                      "--name-status", "-z", "-M", sha)
 23060	    if r is None:
 23061	        return None
 23062	    paths, src, gone = _nodehome_name_status(r)
 23063	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 23064	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 23065	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 23066	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 23067	    for p in parents:
 23068	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 23069	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 23070	    order = sorted(paths)
 23071	    specs = []
 23072	    for x in order:
 23073	        specs.append(f"{sha}:{x}")
 23074	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 23075	    blobs = _nodehome_cat_blobs(repo_root, specs)
 23076	    if blobs is None or any(ren is None for _, ren in pairs):
 23077	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 23078	        return paths, src, gone
 23079	    kept = set()
 23080	    for n, x in enumerate(order):
 23081	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 23082	        if _nodehome_merge_wrote_new_lines(merged, olds):
 23083	            kept.add(x)
 23084	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 23085	
 23086	
 23087	def _nodehome_cat_blobs(repo_root, specs, timeout=60):
 23088	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 23089	
 23090	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 23091	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 23092	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 23093	    import subprocess as _sp
 23094	    if not specs:
 23095	        return []
 23096	    if any("\n" in s_ for s_ in specs):
 23097	        return None
 23098	    try:
 23099	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 23100	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 23101	                    capture_output=True, timeout=timeout)
 23102	    except (OSError, _sp.TimeoutExpired):
 23103	        return None
 23104	    if r.returncode != 0:
 23105	        return None
 23106	    out, pos, res = r.stdout, 0, []
 23107	    for _ in specs:
 23108	        nl = out.find(b"\n", pos)
 23109	        if nl < 0:
 23110	            return None
 23111	        head = out[pos:nl].split(b" ")
 23112	        pos = nl + 1
 23113	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 23114	            size = int(head[2])
 23115	            res.append(out[pos:pos + size])
 23790	        return "block", []
 23791	    if not isinstance(ns, dict):
 23792	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23793	    g = ns.get("gate", "block")
 23794	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23795	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23796	    return g, []
 23797	
 23798	
 23799	def _notelines_regions(text):
 23800	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23801	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23802	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23803	    lines = text.split("\n")
 23804	    fm, _body = split_frontmatter(text)
 23805	    if fm is None:
 23806	        if text.startswith("---"):
 23807	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23808	        return ["body"] * len(lines)
 23809	    out = ["body"] * len(lines)
 23810	    end = len(fm) + 1                            # 收尾 --- 那一行
 23811	    out[0] = out[end] = "other"
 23812	    cur = "other"
 23813	    for i in range(1, end):
 23814	        ln = lines[i]
 23815	        m = TOP_KEY_RE.match(ln)
 23816	        if m:
 23817	            k = m.group(1)
 23818	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23819	            out[i] = "other"
 23820	            continue
 23821	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23822	    return out
 23823	
