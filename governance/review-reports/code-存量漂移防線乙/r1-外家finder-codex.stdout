 24021	def _notelines_decision_fields(text):
 24022	    """decisions 裡每一行屬於哪一條決策的哪一欄 → {行號(從1起): (決策編號, 欄名, valid)}(Projects/筆記內容審_計劃 [S3][S4])。
 24023	    既有 decisions_items 只給每條決策的起訖行;決策編號用 decision-supersede 同一種 `id:` 比對,欄名逐行歸屬:
 24024	    跟項目子鍵同縮排、`鍵:` 開頭的行是那一欄,後面縮排更深或沒有 `鍵:` 的續行跟著前一欄。沒有編號的決策用 `#<序號>`。"""
 24025	    fm, _b = split_frontmatter(text)
 24026	    out = {}
 24027	    if not fm:
 24028	        return out
 24029	    di = decisions_items(fm)
 24030	    if di is None:
 24031	        return out
 24032	    _s, _e, items, _item_indent, sub_indent = di
 24033	    for n, (st, en) in enumerate(items, 1):
 24034	        did, valid, cur = f"#{n}", True, None
 24035	        fields = []
 24036	        for k in range(st, en + 1):
 24037	            ln = fm[k]
 24038	            m = _NOTELINES_DECISION_KEY_RE.match(ln)
 24039	            ind = len(ln) - len(ln.lstrip(" "))
 24040	            is_key = m and (k == st or ind == sub_indent)
 24041	            if is_key:
 24042	                cur = m.group(2)
 24043	                val = ln.split(":", 1)[1].strip()
 24044	                if cur == "id":
 24045	                    mm = re.match(r"^(d\d+)$", val)
 25520	    return out
