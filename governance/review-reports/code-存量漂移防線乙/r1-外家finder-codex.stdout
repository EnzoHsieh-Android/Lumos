 26331	    if not e:
 26332	        return text
 26333	    fm = edit_fm_scalar(lines[1:e], "status", status)
 26334	    fm, _s = edit_fm_sync_status_tag(fm, status)
 26335	    return "\n".join(lines[:1] + fm + lines[e:])
