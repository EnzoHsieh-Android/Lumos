 26130	def _drift_print_findings(rows, stream, acks=None, alive=None):
 26131	    for f in rows[:20]:
 26132	        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {f['path']}:{f['line']}  {f['text'][:60]}", file=stream)
 26133	        print(f"      {f['why']}", file=stream)
 26134	        old = _drift_old_reason(f, acks, alive) if acks else None
 26135	        if old:
 26136	            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
 26137	    if len(rows) > 20:
 26138	        print(f"  …還有 {len(rows) - 20} 筆", file=stream)
