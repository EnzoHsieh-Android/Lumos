 25533	# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────
 25534	
 25535	def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
 25536	    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
 25537	    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
 25538	    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
 25539	    lst = _nodehome_list(root, where)
 25540	    if lst is None:
 25541	        return None
 25542	    pre = vault_rel.rstrip("/") + "/"
 25543	    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
 25544	    import time as _t
 25545	    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
 25546	    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
 25547	    blobs = _nodehome_cat_blobs(root, [f"{where}:{p}" for p in paths], timeout=left) if paths else []
 25548	    if blobs is None:
 25549	        return None
 25550	    texts, bad = {}, []
 25551	    for p, b in zip(paths, blobs):
 25552	        if b is None:
 25553	            continue
 25554	        try:
 25555	            texts[p[len(pre):]] = b.decode("utf-8-sig")
 25556	        except UnicodeDecodeError:
 25557	            bad.append(p[len(pre):])
 25558	    texts.update(override or {})
 25559	    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])
 25560	
 25561	
 25562	def _drift_vault_rel(root, where):
 25563	    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
 25564	    lst = _nodehome_list(root, where)
 25565	    if lst is None:
 25566	        return None
 25567	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 25568	    if not vaults:
 25569	        return None
 25570	    wv = _vault_in(Path(root))
 25571	    try:
 25572	        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
 25573	    except ValueError:
 25574	        wv_rel = None
 25575	    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 25576	
