 26202	def _drift_vault_of(env):
 26203	    root = _vault_repo_root(env)
 26204	    try:
 26205	        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 26206	    except ValueError:
 26207	        return root, env.vault.name
