   564	+class _ProbeTree:
   565	+    """在某一版(提交的樹、工作目錄 'disk'、或空的 None)上判條件。程式檔與測試檔的內容用到才一次批次讀。
   566	+    status 條件用 notes_env(那一版的圖譜)解連結。git 失敗時 ok=False,判定一律回 None(判不了)。"""
   567	+
   568	+    def __init__(self, root, where, notes_env, deadline=None):
   569	+        import time as _t
   570	+        self.root, self.where, self.env, self.deadline, self._t = root, where, notes_env, deadline, _t
   571	+        self._corpus = {}
   572	+        if where is None:
   573	+            self.ok, self.files, self.layout = True, set(), ({}, {})
