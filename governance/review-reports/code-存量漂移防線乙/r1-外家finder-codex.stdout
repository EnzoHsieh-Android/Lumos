 22786	def _nodehome_list(repo_root, where):
 22787	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 22788	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
 22789	    if where is None:
 22790	        return {}, []
 22791	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 22792	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 22793	    if raw is None:
 22794	        return None
 22795	    files, allp = {}, []
 22796	    for ent in raw.split(b"\0"):
 22797	        if not ent or b"\t" not in ent:
 22798	            continue
 22799	        meta, p = ent.split(b"\t", 1)
 22800	        parts = meta.split()
 22801	        if where == "index":
 22802	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 22803	                continue
 22804	            mode = parts[0]
 22805	        else:
 22806	            if len(parts) != 3:
 22807	                continue
 22808	            mode = parts[0]
 22809	        path = nfc(os.fsdecode(p))
 22810	        allp.append(path)
 22811	        if mode in (b"100644", b"100755"):
 22812	            files[path] = mode.decode()
 22813	    return files, allp
