 25578	def _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=None):
 25579	    """範圍裡的事件 → {touched, passed, closed}(都是圖譜內路徑),算不出回 None。
 25580	    touched=頭尾比有變動的筆記;passed=有提交把守衛紀錄從 pending 改成 pass;closed=有提交把計劃改成收尾。
 25581	    候選先從頂端的樹篩(tenv:終點是 pass 的守衛紀錄、終點已收尾的計劃),只對候選逐提交讀狀態。"""
 25582	    import time as _t
 25583	    pre = vault_rel.rstrip("/") + "/"
 25584	    if deadline is not None and _t.monotonic() > deadline:
 25585	        return None
 25586	    raw = _ns_git(root, "diff", "--name-only", "-z", "-M", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 25587	    if raw is None:
 25588	        return None
 25589	    touched = {nfc(x.strip("\n"))[len(pre):] for x in raw.decode("utf-8", errors="surrogateescape").split("\0")
 25590	               if x.strip("\n").startswith(pre)}
 25591	    g_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "verification"
 25592	              and _drift_str(n, "status") == "pass" and GUARD_MARK_FIELD in n.fields}
 25593	    p_only = {pre + r for r, n in tenv.notes.items() if _drift_str(n, "type") == "project"
 25594	              and _drift_str(n, "status") in _DRIFT_CLOSED}
 25595	    passed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25596	                                   lambda ty, st: ty == "verification" and st == "pass",
 25597	                                   lambda a, b: a == "pending" and b == "pass", only=g_only, deadline=deadline, strict=True)
 25598	    if passed is None:
 25599	        return None
 25600	    closed = _notes_status_flipped(root, base, tip, vault_rel, reader,
 25601	                                   lambda ty, st: ty == "project" and st in _DRIFT_CLOSED,
 25602	                                   lambda a, b: (a not in _DRIFT_CLOSED) and (b in _DRIFT_CLOSED), only=p_only, deadline=deadline, strict=True)
 25603	    if closed is None:
 25604	        return None
 25605	    return {"touched": touched, "passed": {nfc(p)[len(pre):] for p in passed if p.startswith(pre)},
 25606	            "closed": {nfc(p)[len(pre):] for p in closed if p.startswith(pre)}}
 25607	
 25608	
 25609	def _drift_check_core(root, base, tip, vault_rel, override=None, deadline=None, override_base=None):
 25610	    """drift check 的判定本體(計劃〈做法〉第 1 節第 5 點)→ (要處理, 只列出, 判不了的原因)。不印、不寫帳——
 25611	    推送閘與考試共用。要處理:範圍裡轉正的守衛紀錄還留著預告句(c1);只列出:c2 到 c5 在範圍裡有對應事件的。
 25612	    預算:先建頂端的樹(批次讀的逾時用剩下的預算)、再只對候選逐提交讀狀態;每一步開始前、每篇候選之前都看一次預算,
 25613	    超過就算判不了。已經開始的那一次 git 呼叫不會被打斷(單次最多 20 秒,批次讀以剩下的預算為上限),
 25614	    所以最壞會比預算多出一次呼叫的時間(代碼審 r2 併發席:第一版只在迴圈裡看,前面四次呼叫都不看預算)。"""
 25615	    import time as _t
 25616	
 25617	    def _left():
 25618	        return _DRIFT_BUDGET_SEC if deadline is None else deadline - _t.monotonic()
 25619	    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算"
 25620	    tenv = _drift_tree_env(root, tip, vault_rel, override, deadline=deadline)
 25621	    if tenv is None:
 25622	        return [], [], [over if _left() <= 0 else "git 讀不出被推送頂端的筆記"]
 25623	    if _left() <= 0:
 25624	        return [], [], [over]
 25625	    reader = _nodehome_reader(root, tip)
 25626	    ev = _drift_range_events(root, base, tip, vault_rel, reader, tenv, deadline=deadline)
 25627	    if ev is None:
 25628	        return [], [], [over if _left() <= 0 else "git 算不出這次推送改了哪些筆記"]
 25629	    unknown = [f"{p} 讀不出來(不是 UTF-8),狀態查不到" for p, n in sorted(tenv.notes.items())
 25630	               if _note_unreadable(n) and p in ev["touched"]]
 25631	    must, listed = [], []
 25632	    for f in _drift_state_findings(tenv):
 25633	        p, k = f["path"], f["kind"]
 25634	        if k == "c1":
 25635	            if p in ev["passed"]:
 25636	                must.append(f)
 25637	            continue
 25638	        hit = p in ev["touched"] or any(r in ev["closed"] or r in ev["touched"] for r in f.get("related", []))
 25639	        if hit:
 25640	            listed.append(f)
 25641	    if _left() <= 0:
 25642	        return must, listed, [*unknown, over]
 25643	    pm, pl, pu = _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=deadline, override_base=override_base)
 25644	    return must + pm, listed + pl, unknown + pu
