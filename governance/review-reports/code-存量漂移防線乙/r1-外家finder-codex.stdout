 25956	def _probe_judge(tip_ctx, base_ctx, pr, old):
 25957	    """一條候選 → 要處理的原因字串 / ""(不列) / None(判不了)。終點成立,而起點沒有同一條或同一條還不成立 → 要處理。"""
 25958	    conds = tuple(pr["conds"])
 25959	    now = tip_ctx.line(conds)
 25960	    if now is None:
 25961	        return None
 25962	    if not now:
 25963	        return ""
 25964	    if old:
 25965	        was = base_ctx.line(conds)
 25966	        if was is None:
 25967	            return None
 25968	        if was:
 25969	            return ""
 25970	    return (("這次推送讓條件成立了" if old else "這次新寫(或改了條件)的回頭條件,條件已經成立")
 25971	            + (f";期限 {pr['by']}" if pr["by"] else ""))
 25972	
