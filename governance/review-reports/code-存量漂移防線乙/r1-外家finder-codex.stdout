   575	+        lst = _nodehome_list(root, "index" if where == "disk" else where)
   576	+        self.ok = lst is not None
   577	+        self.files = set(lst[0]) if lst else set()
   578	+        self.layout = _nodehome_layout(lst[1]) if lst else ({}, {})
   579	+
   580	+    def _read_many(self, paths):
   581	+        if self.where == "disk":
   582	+            out = {}
   583	+            for p in paths:
   584	+                try:
   585	+                    out[p] = (Path(self.root) / p).read_bytes()
   586	+                except OSError:
   587	+                    out[p] = None
   588	+            return out
   589	+        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
   590	+        blobs = _nodehome_cat_blobs(self.root, [f"{self.where}:{p}" for p in paths], timeout=left) if paths else []
   591	+        return None if blobs is None else dict(zip(paths, blobs))
   592	+
   593	+    def corpus(self, test):
   594	+        """程式檔(test=False,不含 docs/、governance/ 與測試檔)或測試檔的 {路徑: 文字};讀不到回 None。"""
   595	+        if test not in self._corpus:
   596	+            paths = sorted(p for p in self.files if _nodehome_code_kind(p) == "ext"
   597	+                           and not p.startswith(("docs/", "governance/"))
   598	+                           and _nodehome_is_test(p, self.layout) == test)
   599	+            got = self._read_many(paths)
   600	+            self._corpus[test] = None if got is None else {
   601	+                p: b.decode("utf-8", errors="replace") for p, b in got.items() if b is not None}
   602	+        return self._corpus[test]
   603	+
   604	+    def one(self, k, v):
   605	+        """一個條件 → True / False / None(判不了)。"""
   606	+        if not self.ok:
   607	+            return None
   608	+        if k == "file":
   609	+            return v in self.files
   610	+        if k == "status":
   611	+            node, _eq, vals = v.partition("=")
   612	+            rel = self.env.resolve(link_target(node.strip())) if self.env is not None else None
   613	+            n = self.env.notes.get(rel) if rel else None
   614	+            return n is not None and _drift_str(n, "status") in {x.strip() for x in vals.split("|")}
   615	+        test = k == "test"
   616	+        path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
   617	+        path, name = path.strip(), name.strip()
   618	+        corpus = self.corpus(test)
   619	+        if corpus is None:
   620	+            return None
   621	+        items = [(path, corpus.get(path))] if path else list(corpus.items())
   622	+        word = re.compile(rf"(?<![\w]){re.escape(name)}(?![\w])")
   623	+        pydef = _probe_py_def_re(name, test)
   624	+        for p, txt in items:
   625	+            if txt is None:
   626	+                continue
   627	+            if (pydef if p.endswith(".py") else word).search(txt):
   628	+                return True
   629	+        return False
   630	+
   631	+    def line(self, conds):
   632	+        """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
   633	+        vals = [self.one(k, v) for k, v in conds]
   634	+        if any(x is False for x in vals):
   635	+            return False
   636	+        return None if any(x is None for x in vals) else True
