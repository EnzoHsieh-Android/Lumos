 26443	def cmd_drift_exam(exam, repo, probes=None, at=None, history=None, as_json=False):
 26444	    """lumos drift exam <考卷.json> --repo <被考的 repo>:在被考 repo 的歷史上重放(計劃〈做法〉第 3 節)。
 26445	    不寫治理帳、不寫任何檔。--history N:改成對被考 repo 最近 N 個主線提交各跑一次 check,列出每筆要處理(門檻②)。"""
 26446	    root = Path(repo).resolve()
 26447	    at_sha = _lens_full_sha(root, at or "HEAD")
 26448	    if at_sha is None:
 26449	        print(f"擋下:{repo} 找不到 {at or 'HEAD'}", file=sys.stderr)
 26450	        return 2
 26451	    vault_rel = _drift_vault_rel(root, at_sha)
 26452	    if vault_rel is None:
 26453	        print(f"擋下:{repo} 沒有圖譜", file=sys.stderr)
 26454	        return 2
 26455	    if history:
 26456	        return _drift_exam_history(root, vault_rel, at_sha, history, as_json)
 26457	    qs = _drift_exam_load(exam)
 26458	    if qs is None:
 26459	        return 2
 26460	    probes_map = _drift_exam_load_probes(probes)
 26461	    if probes_map is None:
 26462	        return 2
 26463	    rows, skipped = [], 0
 26464	    for q in qs:
 26465	        if q.get("exam_event") == "mechanism1_experiment":
 26466	            skipped += 1
 26467	            continue
 26468	        res, om, ol, noise = _drift_exam_one(root, vault_rel, q, at_sha, probes_map)
 26469	        rows.append({"id": q.get("id"), "event": q.get("exam_event"), "result": res,
 26470	                     "other_must": om, "other_listed": ol, "noise": noise})
 26471	    return _drift_exam_report(rows, skipped, as_json)
