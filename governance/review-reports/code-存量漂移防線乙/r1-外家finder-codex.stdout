 26043	def _drift_old_reason(f, acks, alive=None):
 26044	    """表態失效時(筆記改名),用「原文與種類相同」找舊理由供照抄。alive=現在還在的筆記路徑(repo 相對):
 26045	    表態原本那篇還在,就不是改名、是另一篇剛好一樣的樣板句——不借它的理由(代碼審 r1 正確性席:
 26046	    守衛紀錄的預告句是樣板,兩篇會一字不差,原本會把 A 的理由印給從沒表態過的 B)。"""
 26047	    for a in reversed(acks):
 26048	        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
 26049	            if alive is not None and nfc(str(a.get("path"))) in alive:
 26050	                continue
 26051	            return a.get("reason")
 26052	    return None
