 26392	def _drift_config(text):
 26393	    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
 26394	    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
 26395	    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
 26396	    import json as _j
 26397	    if text is None:
 26398	        return _DRIFT_DEFAULT_GATE, [], False
 26399	    try:
 26400	        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
 26401	    except (ValueError, UnicodeDecodeError):
 26402	        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
 26403	        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
 26404	    if not isinstance(cfg, dict) or "drift_check" not in cfg:
 26405	        return _DRIFT_DEFAULT_GATE, [], False
 26406	    dc = cfg["drift_check"]
 26407	    if not isinstance(dc, dict):
 26408	        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
 26409	                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
 26410	    g = dc.get("gate")
 26411	    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
 26412	        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
 26413	    if g not in _DRIFT_GATE_VALUES:
 26414	        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
 26415	    return g, [], True
