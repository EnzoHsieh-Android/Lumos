            return True
    return False


def _nodehome_is_test(path, layout=({}, {})):
    """測試檔判定:先問測試地圖那一支;再認各棧的測試資料夾(2026-09-12:平板 POS 測試資料夾裡的輔助檔、
    Android 儀器測試的 Kotlin 檔都被要求有家——測試地圖的規格刻意只認 test/tests 資料夾與檔名,不動它);
    副檔名不在測試地圖清單裡的(shell、Go、Rust、C…),套它同一組目錄與檔名規則。layout 見 _nodehome_in_stack_test_dir。"""
    global _TESTMAP_DIR_RE
    if _testmap_is_test(path):
        return True
    if _nodehome_in_stack_test_dir(path, layout):
        return True
    if _testmap_ext(path) in _TESTMAP_EXTS:
        return False                      # 測試地圖認得這種副檔名,它說不是就不是
    if _TESTMAP_DIR_RE is None:
        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
    if _TESTMAP_DIR_RE.search(path):
        return True
    name = path.rsplit("/", 1)[-1]
    stem = _testmap_stem(path)
    return (".spec." in name or ".test." in name or stem.startswith("test_")
            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)


def _nodehome_code_kind(path):
    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
    base = path.rsplit("/", 1)[-1]
    stripped = base.lstrip(".")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    for ent in raw.split(b"\0"):
        if not ent or b"\t" not in ent:
            continue
        meta, p = ent.split(b"\t", 1)
        parts = meta.split()
        if where == "index":
            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
                continue
            mode = parts[0]
        else:
            if len(parts) != 3:
                continue
            mode = parts[0]
        path = nfc(os.fsdecode(p))
        allp.append(path)
        if mode in (b"100644", b"100755"):
            files[path] = mode.decode()
    return files, allp


def _nodehome_changed_vs_disk(repo_root, where):
    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
    if where == "index":
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
    else:
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
    if raw is None:
        return None
    或順手多改的部分,正是這道檢查要看的。
    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
    """
    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
        return None
    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
                      "--name-status", "-z", "-M", sha)
    if r is None:
        return None
    paths, src, gone = _nodehome_name_status(r)
    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
    for p in parents:
        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
    order = sorted(paths)
    specs = []
    for x in order:
        specs.append(f"{sha}:{x}")
        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
    blobs = _nodehome_cat_blobs(repo_root, specs)
    if blobs is None or any(ren is None for _, ren in pairs):
        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
        return paths, src, gone
    kept = set()
    for n, x in enumerate(order):
        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
        if _nodehome_merge_wrote_new_lines(merged, olds):
            kept.add(x)
    return kept, {k: v for k, v in src.items() if k in kept}, gone


def _nodehome_cat_blobs(repo_root, specs, timeout=60):
    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。

    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
    import subprocess as _sp
    if not specs:
        return []
    if any("\n" in s_ for s_ in specs):
        return None
    try:
        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
                    capture_output=True, timeout=timeout)
    except (OSError, _sp.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    out, pos, res = r.stdout, 0, []
    for _ in specs:
        nl = out.find(b"\n", pos)
        if nl < 0:
            return None
        head = out[pos:nl].split(b" ")
        pos = nl + 1
        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
            size = int(head[2])
            res.append(out[pos:pos + size])
            pos += size + 1
        elif len(head) == 3 and head[2].isdigit():
            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
            res.append(None)
        else:
            res.append(None)            # missing / ambiguous
    return res


def _nodehome_merge_wrote_new_lines(merged, olds):
    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。

    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
    new = _merge_new_lines(merged, olds)
    return True if new is None else bool(new)

        for pr in pren[1:]:
            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
            _carry(pr)
        specs = []
        for p in paths:
            specs.append(f"{sha}:{p}")
            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
        k = 1 + len(parents)
        for i, p in enumerate(paths):
            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
            new = _merge_new_lines(merged, olds) if blobs is not None else None
            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
                d = _ns_diff(repo_root, first, sha, "--", p)
                if d is None:
