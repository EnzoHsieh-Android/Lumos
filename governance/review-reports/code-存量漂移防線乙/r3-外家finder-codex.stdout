 26429	def cmd_drift_check(repo=None, diff_range=None):
 26430	    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
 26431	    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
 26432	    import time as _t
 26433	    root = _note_audit_root(repo)
 26434	    if root is None:
 26435	        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
 26436	        return 0
 26437	    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
 26438	        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
 26439	        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
 26440	        return 0
 26441	    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
 26442	                                               mark=_DRIFT_GOLIVE_MARK)
 26443	    if tip is None or isinstance(tip, int):
 26444	        return tip if isinstance(tip, int) else 0
 26445	    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
 26446	    for w in warns:
 26447	        print(f"提醒:{w}", file=sys.stderr)
 26448	    if mode == "off":
 26449	        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 26450	        return 0
 26451	    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 26452	                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 26453	    acks = _drift_load_acks(root, tip)
 26454	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 26455	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 26456	    lst = _nodehome_list(root, tip)
 26457	    alive = set(lst[1]) if lst else None
 26458	    if listed:
 26459	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 26460	        _drift_print_findings(listed, sys.stderr, acks, alive)
 26461	    if not must and not unknown:
 26462	        return 0
 26463	    return _drift_report_must(root, mode, must, unknown, acks, alive)
 26464	
