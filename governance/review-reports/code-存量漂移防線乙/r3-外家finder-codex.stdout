 26466	def _drift_report_must(root, mode, must, unknown, acks, alive=None):
 26467	    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
 26468	    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
 26469	    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
 26470	    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
 26471	    for u in unknown:
 26472	        print(f"  判不了:{u}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
 26473	              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
 26474	    _drift_print_findings(must, sys.stderr, acks, alive)
 26475	    kinds = {f["kind"] for f in must}
 26476	    if kinds - {"probe"}:
 26477	        # ★不叫人重跑 guard settle★(代碼審 r1 正確性席):已經 pass 的紀錄 settle 直接回「已轉正」,不會改寫
 26478	        print("預告句那幾筆:把預告句手改成歷史說法(例:「為什麼還不做:」改成「預告當時為什麼還不做:」)。", file=sys.stderr)
 26479	    if "probe" in kinds:
 26480	        # 條件式的修法不一樣(乙代碼審 r1 正確性席:原本也印改預告句)
 26481	        print("回頭條件那幾筆:條件成立了——把待辦做掉,再刪掉這行或改寫成歷史說法。", file=sys.stderr)
 26482	    if must:
 26483	        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
 26484	        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
 26485	        for k in sorted(kinds):
 26486	            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
 26487	    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
 26488	    if mode == "block":
 26489	        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
 26490	                            nodes=sorted({f["path"][:-3] for f in must})[:50])
 26491	        return 1
 26492	    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
 26493	    return 0
