                for _p, rows in _notelines_parse_added(d).items():
                    dest.setdefault(nfc(p), set()).update(t_.strip() for _n, t_ in rows if t_.strip())
            else:
                dest.setdefault(nfc(p), set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
    if net is None:
        return None
    return by_path, [p for p in _nodehome_split_z(net) if p.endswith(".md")], old_by


def _notelines_new(repo_root, staged, base_where, tip_where, vault_rel, *, reader, mark, hook=_NOTELINES_PRECOMMIT,
                   per_commit=True, exclude_remote=True, max_count=None, keep_other=False):
    """範圍裡新寫、而且終點版本還在的筆記行——筆記形狀擋與筆記內容審共用(Projects/筆記內容審_計劃 [S1][S2])。
    → (notes, errs, old_by) 或 None(git 失敗)。notes=[(路徑, 全文, [(行號, 行文字, 區塊)])],只收 body/summary/
    decisions 三塊的非空行;errs=讀不成 UTF-8 的筆記;old_by={NFC 路徑: 這道檢查還沒上線時寫的行}。
    ★per_commit★:True=逐提交看「那個提交自己的 hook 有沒有 mark」(提交前掛鉤在寫的那一刻跑,第一層);
    False=不逐提交判、只靠範圍截斷(推送時才跑的閘,跑的是當下工作目錄那份掛鉤,第二層)——★要明寫傳 False★,
    不傳會落到第一層的預設。找不到上線點時照既有語意不過濾。
    keep_other=True 時開頭欄位其他欄(區塊 other)的新行也收——只給筆記形狀擋查「條件標記寫在不評估的地方」用
    (存量漂移防線 [S10]),既有規則照舊只看 body/summary/decisions。"""
    if staged:
        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
        if d is None:
            return None
        added = {p: rows for p, rows in _notelines_parse_added(d).items() if p.endswith(".md")}
        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
        texts_by, old_by, net = None, {}, None
    else:
        live_mark = mark if (per_commit and _nodehome_golive(repo_root, tip_where, mark, hook)) else None
        rc = _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count,
                                   hook, keep_other)
        if rc is None:
            return None
        cand, texts_by, old_by, net = rc
    notes, errs = [], []
    for p, linenos in sorted(cand.items()):
        b = reader(p)
        if b is None:
            continue
        try:
            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
        except UnicodeDecodeError:
            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
            continue
        texts = None if texts_by is None else texts_by.get(nfc(p), ())
        netl = None if net is None else (lambda p=p: net.lines(nfc(p)))
        notes.append((p, text, _notelines_rows(text, linenos, texts, keep_other, netl)))
    if net is not None and net.failed:
        return None
    return notes, errs, old_by


def _notelines_range_cand(repo_root, base_where, tip_where, vault_rel, exclude_remote, live_mark, max_count, hook,
                          keep_other):
    """推送範圍的候選 → (候選 {路徑: None}, 逐提交新增的文字, 還沒上線時寫的行, 範圍淨差異(_NotelinesNet)或 None);
    git 失敗回 None。開頭欄位其他欄的行要對「範圍淨差異」的行號:逐提交的文字集合分不出位置,舊欄位裡跟正文新行
    一字不差的那一行會被當成新寫(存量漂移防線乙代碼審 r1 外家席;staged 模式本來就對行號)。只在 keep_other 時才有。"""
    ra = _notelines_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
                                mark=live_mark, max_count=max_count, hook=hook)
    if ra is None:
        return None
    texts_by, paths, old_by = ra
    net = _NotelinesNet(repo_root, base_where, tip_where, vault_rel) if keep_other else None
    return {p: None for p in paths}, texts_by, old_by, net


class _NotelinesNet:
    """範圍淨差異的新增行號,★用到才算★:只有開頭欄位其他欄真的有一行跟逐提交新增的文字對上時才跑那一次 diff
    (代碼審 r2 併發席:原本筆記形狀擋每次推送都固定多跑一次整個圖譜範圍的 diff)。git 失敗記 failed,呼叫端整次回 None。"""

    def __init__(self, repo_root, base_where, tip_where, vault_rel):
        self.args, self._m, self.failed = (repo_root, base_where, tip_where, vault_rel), None, False

    def lines(self, p):
        if self._m is None and not self.failed:
            repo_root, base_where, tip_where, vault_rel = self.args
            dn = _ns_diff(repo_root, base_where or _EMPTY_TREE_SHA, tip_where, "--", vault_rel)
            self.failed = dn is None
            self._m = {} if dn is None else {nfc(q): {n for n, _t in rows} for q, rows in _notelines_parse_added(dn).items()}
        return self._m.get(p, ())


def _notelines_rows(text, linenos, texts, keep_other, net):
    """一篇筆記裡算新寫的行 → [(行號, 行文字, 區塊)]。linenos:staged 的新增行號;texts:推送範圍逐提交新增的文字;
    net:回推送範圍淨差異新增行號的函式(只拿來核對開頭欄位其他欄,用到才呼叫)。"""
    lines = text.split("\n")
    regs = _notelines_regions(text)
    rows = []
    for i, ln in enumerate(lines, 1):
        if linenos is not None and i not in linenos:
            continue
        if texts is not None and ln.strip() not in texts:
            continue
        if not ln.strip() or (regs[i - 1] == "other" and not keep_other):
            continue
        if regs[i - 1] == "other" and net is not None and i not in net():
            continue
        rows.append((i, ln, regs[i - 1]))
    return rows


_NOTELINES_HEADING_RE = re.compile(r"^#{1,6}\s+(.*?)\s*#*\s*$")
_NOTELINES_DECISION_KEY_RE = re.compile(r"^(\s*)(?:-\s+)?([A-Za-z_][\w-]*)\s*:")


def _notelines_decision_fields(text):
    """decisions 裡每一行屬於哪一條決策的哪一欄 → {行號(從1起): (決策編號, 欄名, valid)}(Projects/筆記內容審_計劃 [S3][S4])。
    既有 decisions_items 只給每條決策的起訖行;決策編號用 decision-supersede 同一種 `id:` 比對,欄名逐行歸屬:
    跟項目子鍵同縮排、`鍵:` 開頭的行是那一欄,後面縮排更深或沒有 `鍵:` 的續行跟著前一欄。沒有編號的決策用 `#<序號>`。"""
    fm, _b = split_frontmatter(text)
    out = {}
    if not fm:
        return out
    di = decisions_items(fm)
            if _guard_formal_line(hl, _drift_fm_end(hl), m.group(1).strip(), None) is not None:
                ln = _drift_field_line(text, "status")
                out.append({"kind": "c5", "path": rel, "line": ln, "text": _drift_line_text(text, ln), "related": [home],
                            "why": f"家筆記 {home[:-3]} 已經是正式合約行——重跑 lumos guard settle 補完"})
    return out


def _drift_plan_followups(env, rel, new_status):
    """lumos set <計劃> status done|superseded 要列的連帶待辦(計劃〈做法〉第 1 節第 3 點)→ [(種類, 路徑, 說明)]。
    只讀筆記、不跑 git、不寫;不是計劃或不是收尾狀態回 []。
    驗證紀錄走 build_typed_index 的反向索引(代碼審 r1 架構對齊席:不自己拿 env.resolve 猜同名第一篇);
    只寫檔名、同名猜不準的另列一項「猜不準」,讓人自己看。"""
    n = env.notes.get(rel)
    if n is None or _drift_str(n, "type") != "project" or new_status not in _DRIFT_CLOSED:
        return []
    out = []
    names = {"out": "計劃連到它", "in": "它連到計劃", "both": "互相連"}
    for p, d in sorted(_drift_linked(env, rel).items()):
        pn = env.notes.get(p)
        if _drift_str(pn, "type") == "issue" and _drift_str(pn, "status") in _DRIFT_OPEN_ISSUE:
            out.append(("Issue", p, f"{_drift_str(pn, 'status')},{names[d]}"))
    ti = build_typed_index(env)
    for p in sorted({s for s, et in ti["rev"].get(rel, []) if et == "plan_refs"}):
        if _drift_c3_hit(env, p, override={rel: new_status}, ti=ti):
            out.append(("驗證紀錄", p, "pending,plan_refs 指的計劃都已收尾"))
    out += _drift_status_probe_followups(env, rel, new_status)
    for src, lit, et, cands in ti["ambiguous"]:
        sn = env.notes.get(src)
        if et == "plan_refs" and rel in cands and _drift_str(sn, "type") == "verification" \
                and _drift_str(sn, "status") == "pending" and sn is not None and GUARD_MARK_FIELD not in sn.fields:
            out.append(("驗證紀錄", src, f"plan_refs 寫 [[{lit}]] 同名猜不準(可能指這份計劃),看一下"))
    return out


def _drift_status_probe_followups(env, rel, new_status):
    """連帶待辦第③項(乙,[S15]):[when-status:<這份計劃>=…] 的 status 條件因這次收尾成立的回頭條件——只做文字比對,
    不跑 git;同一行還有別的條件時註明,不宣稱整行成立。env 是改之前的圖譜:舊狀態本來就在值裡的,條件早就成立,
    不是這次收尾造成的,不列(代碼審 r1 正確性席、外家席:doing→done 對 =doing|done 原本也說成因這次成立)。"""
    out = []
    old = _drift_str(env.notes.get(rel), "status")
    for p in sorted(env.notes):
        for no, _tx, pr in _probe_lines(env_text(env, p) or "")[0]:
            hit = [v for k, v in pr["conds"] if k == "status" and _probe_value_err(k, v) is None
                   and env.resolve(link_target(v.partition("=")[0].strip())) == rel
                   and new_status in (vals := {x.strip() for x in v.partition("=")[2].split("|")}) and old not in vals]
            if hit:
                out.append(("回頭條件", p, f"第 {no} 行的 status 條件因這次收尾成立"
                            + (";另有條件,是否成立看 lumos drift scan" if len(pr["conds"]) > 1 else "")))
    return out


def _drift_print_followups(env, rel, new_status):
    items = _drift_plan_followups(env, rel, new_status)
    if not items:
        return
    print(f"連帶待辦(這份計劃收尾了,下面 {len(items)} 篇連著它;只列出、不擋——連結有時只是參考,是不是該結案要人看):")
    for kind, p, why in items:
        print(f"  · {kind} {p[:-3]}({why})")
        print(f"      看:lumos context {p[:-3]}")


# ── 在某個提交的樹上做檢查 ─────────────────────────────────────────────────────────

def _drift_tree_env(root, where, vault_rel, override=None, deadline=None):
    """某個提交(where)的圖譜 → 記憶體裡的 Env;override={圖譜內路徑: 全文} 蓋過樹上的。git 失敗回 None。
    解不開的筆記(不是 UTF-8)建成讀檔失敗的筆記(_note_unreadable)——check 碰到它們要算判不了,不能當不存在
    (代碼審 r1 外家席:原本整篇跳過,轉正事件與 c1 一起消失,block 模式照樣放行)。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    pre = vault_rel.rstrip("/") + "/"
    paths = [p for p in lst[0] if p.startswith(pre) and p.endswith(".md")]
    import time as _t
    # 逾時用「列完路徑之後」剩下的時間(代碼審 r4 併發席:原本用進來前算好的值,沒扣掉列路徑花的時間)
    left = 60 if deadline is None else max(1, deadline - _t.monotonic())
    blobs = _drift_cat_nfc(root, where, paths, left) if paths else []
    if blobs is None:
        return None
    texts, bad = {}, []
    for p, b in zip(paths, blobs):
        if b is None:
            # 樹上列得出、內容讀不出來:建成讀不出的筆記(代碼審 r2 外家席:原本跳過,等於當成不存在)
            bad.append(p[len(pre):])
            continue
        try:
            texts[p[len(pre):]] = b.decode("utf-8-sig")
        except UnicodeDecodeError:
            bad.append(p[len(pre):])
    texts.update(override or {})
    return Env.from_texts(Path(root) / vault_rel, texts, unreadable=[b for b in bad if b not in (override or {})])


def _drift_vault_rel(root, where):
    """那個提交的樹裡圖譜在哪(docs/<名>-knowledge);工作目錄的圖譜在裡面就用它。沒有回 None。"""
    lst = _drift_list(root, where)
    if lst is None:
        return None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        return None
    wv = _vault_in(Path(root))
    try:
        wv_rel = wv.resolve().relative_to(Path(root).resolve()).as_posix() if wv is not None else None
    except ValueError:
        wv_rel = None
    return wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
    """「這行是不是 REVISIT」——E5、第一層、第二層共用這一支 → (種類, REVISIT: 後面的字) 或 (None, None)。
    種類:'date'(日期式)/'cond'(條件式)/'bad'(兩者都不是,格式壞損)。line 要先剝掉行內程式碼,圍欄由呼叫端排除。
    去掉行首空白後再去掉一層列表或引用記號(- * + 1. 1) >);表格行不算。日期照 E5 原本的解析:取到第一個空白為止、
    date.fromisoformat(REVISIT: 後面直接接日期,中間有空白算壞損,跟 E5 一直以來一樣)。"""
    import datetime
    if line.lstrip().startswith("|"):
        return None, None
    s = _REVISIT_MARK_RE.sub("", line.strip(), count=1)
    if not s.startswith("REVISIT:"):
        return None, None
    rest = s[len("REVISIT:"):]
    if rest.lstrip().startswith("[when-"):
        return "cond", rest
    try:
        datetime.date.fromisoformat(rest.partition(" ")[0])
        return "date", rest
    except ValueError:
        return "bad", rest


def _probe_value_err(k, v):
    """一個條件標記的值合不合文法 → 錯誤說明或 None。"""
    if k not in _PROBE_KEYS:
        return f"不認得的條件鍵 when-{k}(只有 file、symbol、test、status)"
    if not v:
        return f"when-{k} 的值是空的"

    if k == "file":
        return f"when-file 的路徑 {v} 不合法(不准 / 開頭、不准 .. 段)" if _probe_bad_path(v) else None
    if k in ("symbol", "test"):
        return _probe_named_err(k, v)
    node, eq, vals = v.partition("=")
    if not eq or not node.strip() or not vals.strip():
        return "when-status 要寫成 <節點>=<值>"
    if any(not x.strip() for x in vals.split("|")):
        return "when-status 的值用 | 分開時每一段都不能空"
    return None


def _probe_norm_value(k, v):
    """合文法的 file/symbol/test 值,路徑那段正規化成樹上的寫法:共用的 _posix_norm(去 ./、反斜線轉斜線)加 NFC
    (代碼審 r1 外家席、邊界席、正確性席:`./src/a.py` 與 macOS 貼上的 NFD 路徑原本永遠對不上 git 列出的 NFC 路徑)。
    在解析時就做,所以判定、候選篩選、「同一條」都拿同一個值。"""
    if k == "file":
        return nfc(_posix_norm(v))
    if k in ("symbol", "test") and "::" in v:
        path, name = v.rsplit("::", 1)
        return nfc(_posix_norm(path)) + "::" + name.strip()
    return v


def _probe_bad_path(p):
    return (not p) or p == "." or p.startswith("/") or ".." in p.split("/")


def _probe_named_err(k, v):
    """symbol/test 的值:<名稱> 或 <路徑>::<名稱>(從最後一個 :: 切)。"""
    if "::" not in v:
        return None
    path, name = v.rsplit("::", 1)
    if not name.strip():
        return f"when-{k} 的名稱是空的"
    if _probe_bad_path(path.strip()):
        return f"when-{k} 的路徑 {path} 不合法(不能空、不准 / 開頭、不准 .. 段)"
    return None


def _probe_parse(rest):
    """REVISIT: 後面的字 → {conds: [(鍵, 值)], by: 日期字串或 None, errs: [原因]}。
    從開頭連續吃條件標記與一個 [by:];中間可有空白。"""
    import datetime
    conds, by, errs, pos = [], None, [], 0
    while True:
        m = _PROBE_TOKEN_RE.match(rest, pos)
        if not m:
            break
        pos = m.end()
        key, val = m.group(1), m.group(2).strip()
        if key == "by":
            if by is not None:
                errs.append("期限寫了兩個")
                continue
            try:
                datetime.date.fromisoformat(val)
                by = val
            except ValueError:
                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
            continue
        k = key[len("when-"):]
        err = _probe_value_err(k, val)
        nv = val if err else _probe_norm_value(k, val)
        # 正規化之後再驗一次(代碼審 r2 正確性席、邊界席:`..\x.py` 原文用 / 切不出 .. 段,轉成斜線才是 ../x.py,
        # 原本第一層放行、check 與 scan 又默默丟掉,變成沒人看得到的死條件)
        err = err or _probe_value_err(k, nv)
        if err:
            errs.append(err)
        conds.append((k, val if err else nv))
    if not conds:
        errs.append("沒有條件標記")
    return {"conds": conds, "by": by, "errs": errs}


def _probe_lines(text):
    """一篇筆記的條件式回頭條件 → (清單[(行號, 原文, 解析結果)], 寫在不評估的地方[(行號, 原文, 原因)])。
    只認正文與摘要的可見行:圍欄(_visible_lines)、行內程式碼(_strip_inline_markup)、表格行裡的都不算;
    開頭欄位裡 summary 以外的欄與表格行裡的條件標記列成「寫在不評估的地方」(計劃〈做法〉第 0 節)。"""
    lines = text.split("\n")
    regs = _notelines_regions(text)
    vis = {no for no, _ln in _visible_lines(lines)}
    out, dead = [], []
    for i, ln in enumerate(lines, 1):
        if i not in vis:
            continue
        probe = _strip_inline_markup(ln)[0]
        table = probe.lstrip().startswith("|")
        if regs[i - 1] in ("body", "summary") and not table:
            kind, rest = _revisit_split(probe)
            if kind == "cond":
                out.append((i, ln.strip(), _probe_parse(rest)))
            continue
        if _PROBE_ANY_RE.search(probe):

def _drift_disk_list(root):
    """工作目錄裡的路徑 → (一般檔集合, 所有路徑) 或 None:index 加上沒追蹤(沒被忽略)的,扣掉磁碟上已經不在的
    (代碼審 r1 外家席:scan 預設看工作目錄,原本卻讀 index,沒追蹤的新檔判成不存在、刪了沒 stage 的判成還在)。"""
    lst = _nodehome_list(root, "index")
    raw = _nodehome_git(root, "ls-files", "--others", "--exclude-standard", "-z") if lst is not None else None
    if raw is None:
        return None
    base = Path(root)
    allp = sorted(set(lst[1]) | {nfc(os.fsdecode(p)) for p in raw.split(b"\0") if p})
    allp = [p for p in allp if os.path.lexists(base / p)]
    files = {p for p in allp if (base / p).is_file() and not (base / p).is_symlink()}
    return files, allp


_DRIFT_LS_CACHE = {}


def _drift_list(root, where):
    """_nodehome_list 加記憶:同一個提交的樹一次 check 裡只列一次(代碼審 r1 併發席:終點列 2 次、起點列 3 次)。
    只記完整提交編號(內容不會變);index 與其他寫法照舊每次列。"""
    if not (isinstance(where, str) and re.fullmatch(r"[0-9a-f]{40}", where)):
        return _nodehome_list(root, where)
    key = (str(root), where)
    if key not in _DRIFT_LS_CACHE:
        got = _nodehome_list(root, where)
        if got is None:
            return None
        # ★有上限,跟本檔其他模組層快取不同★(代碼審 r2 架構對齊席問過):那幾支的鍵是 repo 或圖譜,一次呼叫裡天然有界;
        # 這支的鍵是提交編號,drift exam --history 一次走上百個提交,不設上限會跟著提交數長。一次 check 只用到起點與終點兩個。
        if len(_DRIFT_LS_CACHE) >= 8:
            _DRIFT_LS_CACHE.clear()
        _DRIFT_LS_CACHE[key] = got
    return _DRIFT_LS_CACHE[key]


def _drift_decode(b):
    """程式檔的 bytes → 文字:去 BOM(全庫讀取器都用 utf-8-sig;代碼審 r2 正確性席、邊界席:原本 BOM 留在開頭,
    python3.9 的 ast 解析失敗退回正則、docstring 範例又被當定義,沒副檔名的 #! 腳本整支不進語料),解不開的位元組換掉。"""
    return b.decode("utf-8-sig", errors="replace")


def _drift_cat_nfc(root, where, paths, timeout):
    """批次讀 <where>:<路徑>,回同順序的 bytes|None;git 跑不起來回 None。讀到 None 的路徑換成 NFD 再讀一次:
    樹清單把路徑轉成 NFC 了,git 裡可能存 NFD(代碼審 r2 外家席:原本那支檔永遠讀不到)。只多開一次行程。"""
    blobs = _nodehome_cat_blobs(root, [f"{where}:{p}" for p in paths], timeout=timeout)
    if blobs is None:
        return None
    retry = [i for i, b in enumerate(blobs) if b is None and unicodedata.normalize("NFD", paths[i]) != paths[i]]
    if retry:
        again = _nodehome_cat_blobs(root, [f"{where}:{unicodedata.normalize('NFD', paths[i])}" for i in retry],
                                    timeout=timeout)
        if again is None:
            return None
        for i, b in zip(retry, again):
            blobs[i] = b
    return blobs


class _DriftProbeTree:
    """某一版(提交的樹,或工作目錄 'disk')上判 file/symbol/test 條件用的快照,只由 _drift_probe_tree 在列得出路徑時建
    (讀不到就不建,跟 _nodehome_side 同一種失敗編碼;代碼審 r1 架構對齊席)。檔案內容用到才讀、讀過記住;
    帶路徑的條件只讀那一支,而且一批先讀完(prefetch;代碼審 r1、r2 併發席:原本先是整批讀全庫,後來一支檔開一次 git)。
    樹上有、讀不出來的檔記成 None,碰到它的條件算判不了,不算不成立(代碼審 r2 外家席)。status 不在這裡判。"""

    def __init__(self, root, where, files, layout, deadline=None):
        import time as _t
        self.root, self.where, self.files, self.layout, self.deadline, self._t = root, where, files, layout, deadline, _t
        self._text, self._corpus, self._py, self._unread = {}, {}, {}, {}

    def _over(self):
        return self.deadline is not None and self._t.monotonic() >= self.deadline

    def _read(self, paths):
        """把還沒讀過的讀進來;讀不了(git 失敗、預算用完)回 False。讀出來是 None 的(樹上有、內容讀不出)記成 None。
        工作目錄模式也每支檔前看預算(代碼審 r2 併發席:原本只有讀 git 那條看,scan 預設走的這條不看)。"""
        todo = [p for p in paths if p not in self._text]
        if not todo:
            return True
        if self._over():
            return False
        if self.where == "disk":
            for p in todo:
                if self._over():
                    return False
                try:
                    self._text[p] = _drift_decode((Path(self.root) / p).read_bytes())
                except OSError:
                    self._text[p] = None
            return True
        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
        blobs = _drift_cat_nfc(self.root, self.where, todo, left)
        if blobs is None:
            return False
        for p, b in zip(todo, blobs):
            self._text[p] = None if b is None else _drift_decode(b)
        return True

    def prefetch(self, conds):
        """帶路徑的 symbol/test 條件指到的檔,一個行程讀完;讀不了不管,輪到那條時再判。"""
        paths = {v.rsplit("::", 1)[0].strip() for k, v in conds if k in ("symbol", "test") and "::" in v}
        self._read(sorted(p for p in paths if p in self.files))

    def texts(self, paths):
        """樹上有的那幾支 → {路徑: 全文或 None(讀不出)};讀不了(預算、git)回 None。"""
        ps = sorted(p for p in paths if p in self.files)
        if not self._read(ps):
            return None
        return {p: self._text[p] for p in ps}

    def corpus(self, test):
        """程式檔(test=False)或測試檔的路徑清單;讀不了回 None。沒副檔名的要開頭是 #! 才算(跟每支檔有家共用
        _head_is_shebang;代碼審 r2 架構對齊席)。讀不出來的檔記在 _unread,沒找到定義時整條算判不了。"""
        if test not in self._corpus:
            paths = sorted(p for p in self.files if _drift_probe_code_path(p) and _nodehome_is_test(p, self.layout) == test)
            if not self._read(paths):
                return None
            self._corpus[test] = [p for p in paths if self._text[p] is not None and (
                _nodehome_code_kind(p) == "ext" or _head_is_shebang(self._text[p][:200].encode("utf-8")))]
            self._unread[test] = any(self._text[p] is None for p in paths)
        return self._corpus[test]

    def _defines(self, p, name, test):
        txt = self._text.get(p)
        if txt is None or not re.search(rf"(?<![\w]){re.escape(name)}(?![\w])", txt):
            return False
        if not _drift_probe_is_py(p, txt):
            return True
        if p not in self._py:
            self._py[p] = _drift_py_names(txt)
        names = self._py[p]
        if names is None:
            return bool(_drift_py_def_re(name, test).search(txt))
        return name in names[0] or (not test and (name in names[1] or name in names[2]))

    def one(self, k, v):
        """file/symbol/test 一個條件 → True / False / None(判不了)。"""
        if k == "file":
            return v in self.files
        test = k == "test"
        path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
        path, name = path.strip(), name.strip()
        if path:
            if path not in self.files:
                return False
            if not self._read([path]) or self._text[path] is None:
                return None
            return self._defines(path, name, test)
        items = self.corpus(test)
        if items is None:
            return None
        if any(self._defines(p, name, test) for p in items):
            return True
        return None if self._unread[test] else False


def _drift_probe_tree(root, where, deadline=None):
    """→ _DriftProbeTree 或 None(git 列不出路徑、不是 git 專案、或預算已用完)。where:完整提交編號或 'disk'。"""
    import time as _t
    if deadline is not None and _t.monotonic() >= deadline:
        return None
    lst = _drift_disk_list(root) if where == "disk" else _drift_list(root, where)
    if lst is None:
        return None
    return _DriftProbeTree(root, where, set(lst[0]), _nodehome_layout(lst[1]), deadline)


def _drift_probe_one(tree, env, k, v):
    """一個條件 → True / False / None(判不了)。status 只看筆記(env),不需要 git——不是 git 專案也判得了
    (代碼審 r1 正確性席);指到的筆記讀不出來算判不了(外家席:原本當成不成立,靜默放行)。"""
    if k == "status":
        node, _eq, vals = v.partition("=")
        rel = env.resolve(link_target(node.strip())) if env is not None else None
        n = env.notes.get(rel) if rel else None
        if n is not None and _note_unreadable(n):
            return None
        return n is not None and _drift_str(n, "status") in {x.strip() for x in vals.split("|")}
    return None if tree is None else tree.one(k, v)


def _drift_probe_line(tree, env, conds):
    """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
    vals = [_drift_probe_one(tree, env, k, v) for k, v in conds]
    if any(x is False for x in vals):
        return False
    return None if any(x is None for x in vals) else True


def _drift_probe_changes(root, base, tip, deadline=None):
    """範圍裡的改動(只算一次 name-status)→ {touched: 改到的路徑(改名兩端都算), renames: 改名 新→舊,
    code_touched: 改到的程式與測試檔, code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗或預算用完回 None。
    解析用共用的 _nodehome_name_status(代碼審 r1 架構對齊席:原本手刻第二份);筆記改名也從這一次拿(圖譜一致席:
    原本另起一次 git)。不帶路徑的條件改看 code_touched 在終點的全文(_drift_probe_is_candidate),不再算新增行。"""
    import time as _t
    if deadline is not None and _t.monotonic() >= deadline:
        return None
    raw = _ns_git(root, "diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip)
    if raw is None:
        return None
    codes = {}
    touched, renames, _gone = _nodehome_name_status(raw, codes=codes)
    shape = any(c in ("A", "D", "R", "C") and _drift_probe_code_path(p) for p, c in codes.items())
    return {"touched": touched, "renames": renames, "code_shape": shape,
            "code_touched": sorted(p for p in touched if _drift_probe_code_path(p))}


def _drift_probe_is_candidate(conds, ch, vault_pre, tenv, tip_text):
    """這一行的條件會不會被這次推送改變結果(計劃〈做法〉第 0 節,篩選單位是行)→ True / False / None(判不了)。
    不帶路徑的 symbol/test:名稱出現在這次改到的程式或測試檔的★終點全文★就是候選(tip_text() → 那幾支的全文或 None)。
    ★為什麼不只看新增行★(代碼審 r2 正確性席):判定改用 ast、沒副檔名的 #! 腳本也算程式檔之後,「定義在不在」
    可以在名稱那一行沒動的情況下翻轉——只刪掉包住 def 的三引號、只在第一行加 #!。要處理只看終點成立,
    所以只要終點全文;順便省掉原本算新增行的那次 diff(標了 -diff 屬性的檔看不見新增行的坑也一起沒了)。"""
    for k, v in conds:
        hit = _drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text)
        if hit is None or hit:
            return hit
    return False


def _drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text):
    """一個條件會不會被這次推送改變結果 → True / False / None(判不了)。"""
    if k == "file":
        return v in ch["touched"]
    if k == "status":
        rel = tenv.resolve(link_target(v.partition("=")[0].strip()))
        return rel is None or (vault_pre + rel) in ch["touched"]
    path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
    if path.strip():
        return path.strip() in ch["touched"]
    if ch["code_shape"]:
        return True
    if not ch["code_touched"]:
        return False
    txt = tip_text()
    if txt is None:
        return None
    return bool(re.search(rf"(?<![\w]){re.escape(name.strip())}(?![\w])", txt))


def _drift_probe_check(root, base, tip, vault_rel, tenv, deadline=None, override_base=None):
    """乙的推送判定 → (要處理, 只列出, 判不了)。候選行(被這次推送影響、或這次新寫/改了條件標記的)在終點評估全部條件;
    終點成立,而起點沒有「同一條」(改名對回後,條件標記一模一樣)或同一條還不成立 → 要處理;起點早就成立 → 不列。
    每一步開始前與每條候選之前都看預算(代碼審 r1 併發席:原本列樹、改名對照都不看)。"""
    import time as _t
    pre = vault_rel.rstrip("/") + "/"
    lines = [(p, no, tx, pr) for p in sorted(tenv.notes) for no, tx, pr in _probe_lines(env_text(tenv, p) or "")[0]]
    # 條件本身寫錯的行不評估(第一層擋新寫的、scan 列成寫錯);只缺期限的照評估
    lines = [x for x in lines if x[3]["conds"] and all(_probe_value_err(k, v) is None for k, v in x[3]["conds"])]
    if not lines:
        return [], [], []
    over = f"超過 {_DRIFT_BUDGET_SEC} 秒預算(條件式回頭條件)"

    def _out():
        return deadline is not None and _t.monotonic() >= deadline
    ch, benv, err = _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base)
    if err:
        return [], [], [over if _out() else err]
    trees = {}

    def _tree(where):
        if where not in trees:
            trees[where] = _drift_probe_tree(root, where, deadline)
        return trees[where]
    todo, unknown = _drift_probe_candidates(lines, ch, pre, tenv, benv, _tree(tip) if ch["code_touched"] else None, _out)
    if todo and not _out():
        _drift_probe_prefetch([c for x in todo for c in x[3]["conds"]], [_tree(w) for w in ((tip, base) if base else (tip,))])
    must = []
    for p, no, tx, pr, old in todo:
        verdict = None if _out() else _drift_probe_judge(
            lambda c: _drift_probe_line(_tree(tip), tenv, c), lambda c: _drift_probe_line(_tree(base), benv, c), pr, old)
        if verdict is None:
            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if _out() else "git 讀不出程式檔或筆記") + ")")
        elif verdict:
            must.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [], "why": verdict})
    return must, [], unknown


def _drift_probe_prefetch(conds, trees):
    """帶路徑的條件指到的檔,每一版一個行程讀完(代碼審 r2 併發席);列不出樹的那一版跳過,輪到時再判不了。"""
    for t in trees:
        if t is not None:
            t.prefetch(conds)


def _drift_probe_candidates(lines, ch, pre, tenv, benv, tip_tree, out):
    """候選行 → ([(路徑, 行號, 原文, 解析, 起點有沒有同一條)], 判不了[說明])。起點沒有同一條的(新寫或改了條件)一律是候選。
    tip_tree:終點的樹(不帶路徑的條件要讀改到的程式檔全文時用,只讀一次);out():預算用完了沒。"""
    memo, base_lines, todo, unknown = {}, {}, [], []

    def _tip_text():
        if "v" not in memo:
            got = None if tip_tree is None else tip_tree.texts(ch["code_touched"])
            memo["v"] = None if got is None or any(x is None for x in got.values()) else "\n".join(got.values())
        return memo["v"]
    for p, no, tx, pr in lines:
        old = _drift_probe_old(p, pr, ch["renames"], benv, pre, base_lines)
        cand = _drift_probe_is_candidate(pr["conds"], ch, pre, tenv, _tip_text) if old else True
        if cand is None:
            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if out() else "git 讀不出這次改到的程式檔") + ")")
        elif cand:
            todo.append((p, no, tx, pr, old))
    return todo, unknown


def _drift_probe_old(p, pr, renames, benv, pre, cache):
    """起點有沒有「同一條」:終點路徑照改名對回起點,再比條件標記 → True/False;沒有起點回 None。cache 存每篇起點的標記集合。"""
    if benv is None:
        return None
    bp = renames.get(pre + p, pre + p)
    bp = bp[len(pre):] if bp.startswith(pre) else p
    if bp not in cache:
        cache[bp] = {tuple(x[2]["conds"]) for x in _probe_lines(env_text(benv, bp) or "")[0]}
    return tuple(pr["conds"]) in cache[bp]


def _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base):
    """推送判定要的起點資料 → (範圍改動, 起點圖譜, 判不了的原因或 None)。起點的圖譜位置與樹清單都走 _drift_list 的記憶。"""
    import time as _t
    ch = _drift_probe_changes(root, base, tip, deadline)
    if ch is None:
        return None, None, "git 算不出這次推送改了哪些檔(條件式回頭條件)"
    if not base:
        return ch, None, None
    if deadline is not None and _t.monotonic() >= deadline:
        return None, None, "預算用完"
    benv = _drift_tree_env(root, base, _drift_vault_rel(root, base) or vault_rel, override_base, deadline=deadline)
    if benv is None:
        return None, None, "git 讀不出起點的筆記(條件式回頭條件)"
    return ch, benv, None


def _drift_probe_judge(now_of, was_of, pr, old):
    """一條候選 → 要處理的原因字串 / ""(不列) / None(判不了)。終點成立,而起點沒有同一條或同一條還不成立 → 要處理。
    now_of / was_of:條件 → 終點 / 起點的判定(起點只在有同一條時才問)。"""
    conds = tuple(pr["conds"])
    now = now_of(conds)
    if now is None:
        return None
    if not now:
        return ""
    if old:
        was = was_of(conds)
        if was is None:
            return None
        if was:
            return ""
    return (f"when-{k} 的路徑 {path} 在樹上找不到、也不像檔案路徑(寫成 型別::方法 了?名稱只寫方法名,或寫完整路徑::名稱;"
            "如果是還沒建的根目錄檔,像 Makefile,建了就會判,不用管)")


def _drift_probe_row_problems(pr, nenv, tree):
    """一行條件式的寫法問題 → [原因]:寫錯的條件、沒帶期限、指到的筆記找不到、file 指到資料夾、symbol/test 的路徑不像檔案路徑。"""
    bad = list(pr["errs"])
    if pr["by"] is None and "沒有條件標記" not in bad:
        bad.append("沒帶期限 [by:YYYY-MM-DD]")
    for k, v in pr["conds"]:
        if _probe_value_err(k, v) is not None:
            continue
        if k == "status" and nenv.resolve(link_target(v.partition("=")[0].strip())) is None:
            bad.append(f"when-status 指的筆記 {v.partition('=')[0].strip()} 找不到(改名或刪了?)")
        if k == "file" and tree is not None and v not in tree.files \
                and any(f.startswith(v.rstrip("/") + "/") for f in tree.files):
            bad.append(f"when-file 指到資料夾 {v}(要指一支檔)")
        w = _drift_probe_path_warn(k, v, tree)
        if w:
            bad.append(w)
    return bad


def _drift_probe_scan(nenv, tree, deadline=None):
    """scan 的乙部分 → (成立的行[發現], 問題[(路徑, 行號, 原文, 原因)])。問題:寫錯的條件、沒帶期限、指到的筆記找不到、
    file 指到資料夾、symbol/test 的路徑不像檔案路徑、寫在不評估的地方、判不了(分 git 讀不出與超過預算)。"""
    import time as _t

    def _over():
        return deadline is not None and _t.monotonic() >= deadline
    found, probs, per = [], [], []
    for p in sorted(nenv.notes):
        rows, dead = _probe_lines(env_text(nenv, p) or "")
        probs += [(p, no, tx, why) for no, tx, why in dead]
        per.append((p, rows))
    if tree is not None and not _over():
        tree.prefetch([c for _p, rows in per for _n, _t, pr in rows for c in pr["conds"]])
    for p, rows in per:
        for no, tx, pr in rows:
            probs += [(p, no, tx, why) for why in _drift_probe_row_problems(pr, nenv, tree)]
            if not pr["conds"] or any(_probe_value_err(k, v) for k, v in pr["conds"]):
                continue
            ok = None if _over() else _drift_probe_line(tree, nenv, tuple(pr["conds"]))
            if ok is None:
                probs.append((p, no, tx, "判不了(超過預算)" if _over() else "判不了(git 讀不出程式檔或筆記)"))
            elif ok:
                found.append({"kind": "probe", "path": p, "line": no, "text": tx, "related": [],
                              "why": "條件已經成立,該處理了" + (f"(期限 {pr['by']})" if pr["by"] else "")})
    return found, probs


# ── 表態 ─────────────────────────────────────────────────────────────────────────────

def _drift_load_acks(root, where=None):
    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
    import json as _j
    raw = None
    if where is None:
        fp = Path(root) / _DRIFT_ACKS
        try:
            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
        except OSError:
            raw = None
    else:
        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
        raw = bl[0] if bl else None
    out = []
    for ln in (raw or b"").decode("utf-8", errors="replace").splitlines():
        try:
            d = _j.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("path") and d.get("kind") in _DRIFT_KINDS:
            out.append(d)
    return out


def _drift_ack_key(path, text, kind):
    return (nfc(str(path)), str(text).strip(), kind)


def _drift_split_acked(findings, acks, vault_rel):
    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。"""
    keys = {_drift_ack_key(a["path"], a.get("text", ""), a["kind"]) for a in acks}
    pre = vault_rel.rstrip("/") + "/"
    left, done = [], []
    ev = q.get("exam_event")
    note = q.get("note_at_event") or q.get("note")
    line = q.get("line")
    if not q.get("note") or not isinstance(line, int):
        return "略過:題目缺 note 或 line", 0, 0, 0
    if ev == "current_state":
        tenv = _drift_tree_env(root, at_sha, vault_rel)
        if tenv is None:
            return "略過:git 讀不出樹", 0, 0, 0
        hit = any(f["path"] == q["note"] and f["line"] == line for f in _drift_state_findings(tenv))
        return ("誤列" if hit else "沒誤列"), 0, 0, 0
    if ev == "probe":
        return _drift_exam_probe(root, vault_rel, q, probes)
    commits = q.get("invalidating_commits") or []
    if ev not in ("commit", "status_replay") or not commits:
        return f"略過:考法 {ev} 還沒做或沒有失效提交", 0, 0, 0
    c = _lens_full_sha(root, commits[0])
    par = _lens_full_sha(root, f"{commits[0]}^") if c else None
    if c is None or par is None:
        return "略過:找不到失效提交或它的上一版", 0, 0, 0
    vault_rel = _drift_vault_rel(root, c) or vault_rel      # 那個提交自己的圖譜位置(代碼審 r1 外家席)
    must, listed, unknown = _drift_check_core(root, par, c, vault_rel)
    hit_kind = next((f["kind"] for f in must + listed
                     if f["path"] == note and (f["line"] == line or ev == "status_replay")), None)
    others_m = _drift_exam_others(must, note, line, hit_kind)
    others_l = _drift_exam_others(listed, note, line, hit_kind)
    noise = len({f["path"] for f in must if f["kind"] == "c1"}) + sum(1 for f in must if f["kind"] != "c1") + len(unknown)
    in_must = any(f["path"] == note and f["line"] == line for f in must)
    in_list = any(f["path"] == note and (f["line"] == line or ev == "status_replay") for f in listed)
    if ev == "status_replay":
        fu = _drift_exam_replay(root, par, _drift_vault_rel(root, par) or vault_rel, q.get("status_targets") or [])
        if fu is None:
            return "略過:git 讀不出上一版", 0, 0, 0
        if fu == "unreadable":
            return "略過:要重放的計劃讀不出來(不是 UTF-8)", 0, 0, 0
        in_list = in_list or note in fu
    res = "擋到" if in_must else ("點到" if in_list else "漏")
    return res, len(others_m), len(others_l), noise


def _drift_exam_replay(root, par, vault_rel, targets):
    """status_replay:取上一版的樹,在記憶體裡把 targets 每一份計劃改成 done,回 lumos set 會列的連帶待辦路徑集合。"""
    tenv0 = _drift_tree_env(root, par, vault_rel)
    if tenv0 is None:
        return None
    texts = {}
    for t in targets:
        prel = tenv0.resolve(link_target(t))
        txt = env_text(tenv0, prel) if prel else None
        if txt is None and prel and _note_unreadable(tenv0.notes[prel]):
            return "unreadable"      # 讀不出來的計劃沒辦法在記憶體裡改狀態:這題略過,不算漏(代碼審 r4、r5 正確性席)
        if txt is not None:
            texts[prel] = _drift_set_status_text(txt, "done")
    tenv = _drift_tree_env(root, par, vault_rel, override=texts)
    fu = set()
    for prel in texts:
        fu |= {p for _k, p, _w in _drift_plan_followups(tenv, prel, "done")}
        # 第③項要看改之前的狀態(lumos set 傳的就是改之前的圖譜);改完的圖譜裡舊狀態已經是 done,永遠列不出
        # (代碼審 r2 正確性席)
        fu |= {p for _k, p, _w in _drift_status_probe_followups(tenv0, prel, "done")}
    return fu


def _drift_exam_others(findings, note, line, kind):
    """考題那一行以外、算誤報的發現:排除題目那一行,以及同一篇同一種的兄弟句(c1 一句一筆,同一個轉正事件的
    另外幾句預告句是真發現,不是亂抓);同一篇別種的、別篇的都算(代碼審 r1 外家席:原本同一篇全部排除,誤報被低估)。"""
    return [f for f in findings if not (f["path"] == note and (f["line"] == line or (kind and f["kind"] == kind)))]


def cmd_drift_exam(exam, repo, probes=None, at=None, history=None, as_json=False):
    """lumos drift exam <考卷.json> --repo <被考的 repo>:在被考 repo 的歷史上重放(計劃〈做法〉第 3 節)。
    不寫治理帳、不寫任何檔。--history N:改成對被考 repo 最近 N 個主線提交各跑一次 check,列出每筆要處理(門檻②)。"""
    root = Path(repo).resolve()
    at_sha = _lens_full_sha(root, at or "HEAD")
    if at_sha is None:
        print(f"擋下:{repo} 找不到 {at or 'HEAD'}", file=sys.stderr)
        return 2
    vault_rel = _drift_vault_rel(root, at_sha)
    if vault_rel is None:
        print(f"擋下:{repo} 沒有圖譜", file=sys.stderr)
        return 2

