 26343	def cmd_drift_ack(env, node, line, kind, reason):
 26344	    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。"""
 26345	    import datetime, secrets
 26346	    if kind not in _DRIFT_KINDS:
 26347	        print(f"擋下:--kind 只能是 {'/'.join(_DRIFT_KINDS)}", file=sys.stderr)
 26348	        return 2
 26349	    if len((reason or "").strip()) < 4:
 26350	        print("擋下:--reason 要寫為什麼照留,至少 4 個字", file=sys.stderr)
 26351	        return 2
 26352	    rel = env.find(node)
 26353	    if rel is None:
 26354	        return _node_not_found(env, node, write_side=True)
 26355	    text = env_text(env, rel)
 26356	    lines = (text or "").split("\n")
 26357	    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
 26358	        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
 26359	        return 2
 26360	    root = _vault_repo_root(env)
 26361	    try:
 26362	        vault_rel = env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
 26363	    except ValueError:
 26364	        vault_rel = env.vault.name
 26365	    head = ""
 26366	    for ln in reversed(lines[:line]):
 26367	        if ln.startswith("#"):
 26368	            head = ln.lstrip("#").strip()
 26369	            break
 26370	    token = "DACK-" + secrets.token_hex(4)
 26371	    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
 26372	           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
 26373	    fp = Path(root) / _DRIFT_ACKS
 26374	    try:
 26375	        fp.parent.mkdir(parents=True, exist_ok=True)
 26376	    except OSError as ex:
 26377	        print(f"擋下:建不了 {fp.parent}:{ex}", file=sys.stderr)
 26378	        return 2
