def _nodehome_top_dirs(all_paths):
    """repo 頂層的資料夾名;點開頭的不算(.git、.github 這類不是程式資料夾)。
    別人的檔的裸路徑判定([S8])與測試資料夾的同名資料夾錨共用這一支。"""
    return {p.split("/", 1)[0] for p in all_paths if "/" in p and not p.startswith(".")}


def _nodehome_layout(all_paths):
    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
    tops = _nodehome_top_dirs(all_paths)
    top_exts, main_exts = {}, {}
    for p in all_paths:
        e = _testmap_ext(p)
        if not e:
            continue
        parts = p.split("/")
        if len(parts) > 1 and parts[0] in tops:
            top_exts.setdefault(parts[0], set()).add("." + e)
        for k in range(len(parts) - 2):
            if parts[k] == "src" and parts[k + 1] == "main":
                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
                break
    return top_exts, main_exts


def _nodehome_in_stack_test_dir(path, layout):
    """在各棧的測試資料夾裡——兩種都要「旁邊的程式目標有同一種檔」,只看資料夾名會把業務資料夾放掉
    (2026-09-12 代碼審兩輪各席造出的反例:A/B 測試功能模組 ABTests/、Python 專案的 LoadTests/、
    scriptsTests/ 裡的 .cs、src/androidTest 裡的 .py):
    ① 頂層資料夾 = <X> 加對照表的結尾樣式(PosTerminalTests/、PosTerminalUITests/、Foo.IntegrationTests/),
       副檔名屬於貢獻那個結尾的棧,而且頂層的 <X> 資料夾裡有同一種副檔名的檔(Xcode 的 App 配 AppTests、
       .NET 的 Foo 配 Foo.Tests);資料夾就叫結尾樣式本身(UITests/、IntegrationTests/)的直接認;
    ② 緊接在 src 下一層的對照表測試資料夾名(app/src/androidTest/…),副檔名屬於貢獻那個名字的棧(Kotlin),
       而且同一個模組的 src/main 有同一種副檔名的檔——只看 src/main 有沒有同副檔名的檔,混在 src/main 的建置腳本
       (.py、.sh)就能讓 androidTest 裡同副檔名的檔免家(代碼審第三輪四席各自造出反例)。
    別種語言的測試輔助檔(Xcode 測試資料夾裡的橋接標頭 .h、Java 寫的 androidTest 輔助檔——對照表沒有 Java 棧)照舊要家:
    寧可過嚴,逃生口是 node_home.ignore;要認就把那一棧補進測試棧對照表,這裡自動跟著認。
    layout=_nodehome_layout 的結果。對不上的照舊要家(過嚴、不漏)。"""
    sufs, under_src = _nodehome_stack_test_dirs()
    top_exts, main_exts = layout
    parts = path.split("/")
    e = _testmap_ext(path)
    if len(parts) < 2 or not e:
        return False
    ext, top = "." + e, parts[0]
    for suf, exts in sufs.items():
        if ext not in exts or not top.endswith(suf):
        if i not in vis:
            continue
        probe = _strip_inline_markup(ln)[0]
        table = probe.lstrip().startswith("|")
        if regs[i - 1] in ("body", "summary") and not table:
            kind, rest = _revisit_split(probe)
            if kind == "cond":
                out.append((i, ln.strip(), _probe_parse(rest)))
            continue
        if _PROBE_ANY_RE.search(probe):
            dead.append((i, ln.strip(), "寫在表格行裡,不評估" if table else "寫在開頭欄位裡 summary 以外的欄,不評估"))
    return out, dead


def _drift_probe_code_path(p):
    """乙拿來判 symbol/test、算候選的檔:副檔名在清單裡或沒副檔名(要看 #!),不含 docs/、governance/。
    候選篩選(_drift_probe_changes)與語料(_DriftProbeTree.corpus)共用這一支(代碼審 r1 圖譜一致席:原本兩邊範圍不同;
    正確性席:工具鏈主程式 scripts/lumos 沒有副檔名,原本整支不在語料裡,上面的 symbol 條件全是死條件)。"""
    return _nodehome_code_kind(p) in ("ext", "shebang?") and not p.startswith(("docs/", "governance/"))


def _drift_probe_is_py(p, txt):
    """要不要當 Python 檔用 ast 判:.py,或沒副檔名、首行是 python 的 #!(跟 _shebang_python_blob 共用首行判定——代碼審 r2
    架構對齊席:原本另寫一份,少了 #! 門檻、多了轉小寫)。"""
    return p.endswith(".py") or (_nodehome_code_kind(p) == "shebang?" and _shebang_line_is_python(txt.split("\n", 1)[0]))


def _drift_py_names(txt):
    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。"""
    import ast as _ast
    if _drift_py_too_deep(txt):
        return None
    try:
        tree = _ast.parse(txt)
    except (SyntaxError, ValueError, MemoryError, RecursionError):
        # 巢狀很深的合法檔,CPython 的解析器丟 MemoryError(「too complex to parse」)而不是 SyntaxError,
        # 原本沒接住,整支 scan 與推送檢查當掉(代碼審 r2 邊界席)
        return None
    funcs, classes, assigns = set(), set(), set()
    for node in _ast.walk(tree):
        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
            funcs.add(node.name)
        elif isinstance(node, _ast.ClassDef):
            classes.add(node.name)
    for node in tree.body:
        if isinstance(node, _ast.Assign):
            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
            assigns.add(node.target.id)
    return funcs, classes, assigns


_DRIFT_PY_MAX_LINE_TOKENS = 20000


def _drift_py_too_deep(txt):
    """3.12 以前的 ast.parse 碰到極長的單一運算式(一長串負號、not、加法、屬性鏈、lambda…)會讓整個程序崩潰(SIGSEGV),
    不是丟出接得住的例外(代碼審 r3 外家席;2026-09-29 用系統 python3.9 實測:最容易崩的一長串負號要單一邏輯行約
    21.6 萬字元,lambda 串 6.6 萬層;3.11、3.14 都改成丟 MemoryError / RecursionError)。所以 3.12 以前先用斷詞器
    (純 Python、不遞迴)量最長的邏輯行,超過 2 萬個詞就不解析、退回正則;不到 15 萬字元的檔湊不出會崩的行,不量。
    斷詞失敗也當成太深(退回正則)。整支大檔量一次約 0.5 秒。工具最低版本改成 3.14 時整支刪掉。"""
    import sys as _sys
    if _sys.version_info >= (3, 12) or len(txt) < 150000:
        return False
    import io as _io, tokenize as _tok
    run = 0
    try:
        for t in _tok.generate_tokens(_io.StringIO(txt).readline):
            run = 0 if t.type == _tok.NEWLINE else run + 1
            if run > _DRIFT_PY_MAX_LINE_TOKENS:
                return True
    except (_tok.TokenError, SyntaxError, ValueError):
        return True
    return False


def _drift_py_def_re(name, test):
    """解析不了的 Python 檔退回逐行正則(寧可多認一次,也不讓一支語法壞掉的檔讓整批條件判不了)。"""
    n = re.escape(name)
    if test:
        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)


def _drift_disk_list(root):
    """工作目錄裡的路徑 → (一般檔集合, 所有路徑) 或 None:index 加上沒追蹤(沒被忽略)的,扣掉磁碟上已經不在的
    (代碼審 r1 外家席:scan 預設看工作目錄,原本卻讀 index,沒追蹤的新檔判成不存在、刪了沒 stage 的判成還在)。"""
    lst = _nodehome_list(root, "index")
    raw = _nodehome_git(root, "ls-files", "--others", "--exclude-standard", "-z") if lst is not None else None
    if raw is None:
        return None
    base = Path(root)
    allp = sorted(set(lst[1]) | {nfc(os.fsdecode(p)) for p in raw.split(b"\0") if p})
    allp = [p for p in allp if os.path.lexists(base / p)]
    files = {p for p in allp if (base / p).is_file() and not (base / p).is_symlink()}
    return files, allp


_DRIFT_LS_CACHE = {}
_DRIFT_OID_CACHE = {}   # 跟 _DRIFT_LS_CACHE 同鍵同壽命:列檔那一次順便記的內容編號


def _drift_list(root, where):
    """_nodehome_list 加記憶:同一個提交的樹一次 check 裡只列一次(代碼審 r1 併發席:終點列 2 次、起點列 3 次)。
    只記完整提交編號(內容不會變);index 與其他寫法照舊每次列。"""
    if not (isinstance(where, str) and re.fullmatch(r"[0-9a-f]{40}", where)):
        return _nodehome_list(root, where)
    key = (str(root), where)
    if key not in _DRIFT_LS_CACHE:
        oids = {}
        got = _nodehome_list(root, where, oids=oids)
        if got is None:
            return None
        _DRIFT_OID_CACHE[key] = oids
        # ★有上限,跟本檔其他模組層快取不同★(代碼審 r2 架構對齊席問過):那幾支的鍵是 repo 或圖譜,一次呼叫裡天然有界;
        # 這支的鍵是提交編號,drift exam --history 一次走上百個提交,不設上限會跟著提交數長。一次 check 只用到起點與終點兩個。
        if len(_DRIFT_LS_CACHE) >= 8:
            _DRIFT_LS_CACHE.clear()
            _DRIFT_OID_CACHE.clear()
            _DRIFT_OID_CACHE[key] = oids
        _DRIFT_LS_CACHE[key] = got
    return _DRIFT_LS_CACHE[key]


def _drift_oids(root, where):
    """那個提交的 {NFC 路徑: 內容編號};列不出或不是完整提交編號回 {}(呼叫端退回用「版本:路徑」讀)。"""
    if _drift_list(root, where) is None:
        return {}
    return _DRIFT_OID_CACHE.get((str(root), where), {})


def _drift_decode(b):
    """程式檔的 bytes → 文字:去 BOM(全庫讀取器都用 utf-8-sig;代碼審 r2 正確性席、邊界席:原本 BOM 留在開頭,
    python3.9 的 ast 解析失敗退回正則、docstring 範例又被當定義,沒副檔名的 #! 腳本整支不進語料),解不開的位元組換掉。"""
    return b.decode("utf-8-sig", errors="replace")


def _drift_cat(root, where, paths, timeout):
    """批次讀那個提交裡的這幾支檔,回同順序的 bytes|None;git 跑不起來回 None。★用列檔時記下的內容編號讀★,
    不用「版本:路徑」:樹清單把路徑轉成 NFC 了,git 裡存的可能是 NFD、兩種混用、或相容表意字(NFC 與 NFD 都會把它換掉),
    用路徑讀永遠讀不到;路徑含換行時批次讀也整批失敗(代碼審 r2 外家席、r3 正確性席、邊界席;r2 的 NFD 重讀補不到混用
    與相容表意字,還多開一次行程、沿用整段逾時——r3 併發席、外家席、架構對齊席)。查不到編號的才退回用路徑讀。"""
    oids = _drift_oids(root, where)
    return _nodehome_cat_blobs(root, [oids.get(p) or f"{where}:{p}" for p in paths], timeout=timeout)


class _DriftNames:
    """一段文字的識別字集合(用 \\w+ 切),名稱查集合;不是一般識別字的名稱才對原文跑正則。"""

    def __init__(self, text):
        self.text, self._set = text, set(re.findall(r"\w+", text))

    def __contains__(self, name):
        return name in self._set


class _DriftProbeTree:
    """某一版(提交的樹,或工作目錄 'disk')上判 file/symbol/test 條件用的快照,只由 _drift_probe_tree 在列得出路徑時建
    (讀不到就不建,跟 _nodehome_side 同一種失敗編碼;代碼審 r1 架構對齊席)。檔案內容用到才讀、讀過記住;
    帶路徑的條件只讀那一支,而且一批先讀完(prefetch;代碼審 r1、r2 併發席:原本先是整批讀全庫,後來一支檔開一次 git)。
    樹上有、讀不出來的檔記成 None,碰到它的條件算判不了,不算不成立(代碼審 r2 外家席)。status 不在這裡判。"""

    def __init__(self, root, where, files, layout, deadline=None):
        import time as _t
        self.root, self.where, self.files, self.layout, self.deadline, self._t = root, where, files, layout, deadline, _t
        self._text, self._corpus, self._py, self._unread, self._names = {}, {}, {}, {}, {}

    def _over(self):
        return self.deadline is not None and self._t.monotonic() >= self.deadline

    def _read(self, paths):
        """把還沒讀過的讀進來;讀不了(git 失敗、預算用完)回 False。讀出來是 None 的(樹上有、內容讀不出)記成 None。
        工作目錄模式也每支檔前看預算(代碼審 r2 併發席:原本只有讀 git 那條看,scan 預設走的這條不看)。"""
        todo = [p for p in paths if p not in self._text]
        if not todo:
            return True
        if self._over():
            return False
        if self.where == "disk":
            for p in todo:
                if self._over():
                    return False
                try:
                    self._text[p] = _drift_decode((Path(self.root) / p).read_bytes())
                except OSError:
                    self._text[p] = None
            return True
        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
        blobs = _drift_cat(self.root, self.where, todo, left)
        if blobs is None:
            return False
        for p, b in zip(todo, blobs):
            self._text[p] = None if b is None else _drift_decode(b)
        return True

    def prefetch(self, conds):
        """帶路徑的 symbol/test 條件指到的檔,一個行程讀完;讀不了不管,輪到那條時再判。"""
        paths = {v.rsplit("::", 1)[0].strip() for k, v in conds if k in ("symbol", "test") and "::" in v}
        self._read(sorted(p for p in paths if p in self.files))

    def names_in(self, paths):
        """樹上有的那幾支的全文 → _DriftNames;讀不了(預算、git)或有一支讀不出回 None。同一組只算一次。"""
        key = tuple(sorted(p for p in paths if p in self.files))
        if key not in self._names:
            if not self._read(list(key)) or any(self._text[p] is None for p in key):
                return None
            self._names[key] = _DriftNames("\n".join(self._text[p] for p in key))
        return self._names[key]

    def bad_paths(self):
        """讀過、樹上有、內容讀不出的檔。"""
        return [p for p, t in self._text.items() if t is None]

    def corpus(self, test):
        """程式檔(test=False)或測試檔的路徑清單;讀不了回 None。沒副檔名的要開頭是 #! 才算(跟每支檔有家共用
        _head_is_shebang;代碼審 r2 架構對齊席)。讀不出來的檔記在 _unread,沒找到定義時整條算判不了。"""
        if test not in self._corpus:
            paths = sorted(p for p in self.files if _drift_probe_code_path(p) and _nodehome_is_test(p, self.layout) == test)
            if not self._read(paths):
                return None
            self._corpus[test] = [p for p in paths if self._text[p] is not None and (
                _nodehome_code_kind(p) == "ext" or _head_is_shebang(self._text[p][:200].encode("utf-8")))]
            self._unread[test] = any(self._text[p] is None for p in paths)
        return self._corpus[test]

    def _defines(self, p, name, test):
        txt = self._text.get(p)
        if txt is None or not re.search(rf"(?<![\w]){re.escape(name)}(?![\w])", txt):
            return False
        if not _drift_probe_is_py(p, txt):
            return True
        if p not in self._py:
            self._py[p] = _drift_py_names(txt)
        names = self._py[p]
        if names is None:
            return bool(_drift_py_def_re(name, test).search(txt))
        return name in names[0] or (not test and (name in names[1] or name in names[2]))

    def one(self, k, v):
        """file/symbol/test 一個條件 → True / False / None(判不了)。"""
        if k == "file":
            return v in self.files
        test = k == "test"
        path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
        path, name = path.strip(), name.strip()
        if path:
            if path not in self.files:
                return False
            if not self._read([path]) or self._text[path] is None:
                return None
            return self._defines(path, name, test)
        items = self.corpus(test)
        if items is None:
            return None
        if any(self._defines(p, name, test) for p in items):
            return True
        return None if self._unread[test] else False


def _drift_probe_tree(root, where, deadline=None):
    """→ _DriftProbeTree 或 None(git 列不出路徑、不是 git 專案、或預算已用完)。where:完整提交編號或 'disk'。"""
    import time as _t
    if deadline is not None and _t.monotonic() >= deadline:
        return None
    lst = _drift_disk_list(root) if where == "disk" else _drift_list(root, where)
    if lst is None:
        return None
    return _DriftProbeTree(root, where, set(lst[0]), _nodehome_layout(lst[1]), deadline)


def _drift_probe_one(tree, env, k, v):
    """一個條件 → True / False / None(判不了)。status 只看筆記(env),不需要 git——不是 git 專案也判得了
    (代碼審 r1 正確性席);指到的筆記讀不出來算判不了(外家席:原本當成不成立,靜默放行)。"""
    if k == "status":
        node, _eq, vals = v.partition("=")
        rel = env.resolve(link_target(node.strip())) if env is not None else None
        n = env.notes.get(rel) if rel else None
        if n is not None and _note_unreadable(n):
            return None
        return n is not None and _drift_str(n, "status") in {x.strip() for x in vals.split("|")}
    return None if tree is None else tree.one(k, v)


def _drift_probe_line(tree, env, conds):
    """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
    vals = [_drift_probe_one(tree, env, k, v) for k, v in conds]
    if any(x is False for x in vals):
        return False
    return None if any(x is None for x in vals) else True


def _drift_probe_changes(root, base, tip, deadline=None):
    """範圍裡的改動(只算一次 name-status)→ {touched: 改到的路徑(改名兩端都算), renames: 改名 新→舊,
    code_touched: 改到的程式與測試檔, code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗或預算用完回 None。
    解析用共用的 _nodehome_name_status(代碼審 r1 架構對齊席:原本手刻第二份);筆記改名也從這一次拿(圖譜一致席:
    原本另起一次 git)。不帶路徑的條件改看 code_touched 在終點的全文(_drift_probe_is_candidate),不再算新增行。"""
    import time as _t
    if deadline is not None and _t.monotonic() >= deadline:
        return None
        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
        raw = bl[0] if bl else None
    out = []
    for ln in (raw or b"").decode("utf-8", errors="replace").splitlines():
        try:
            d = _j.loads(ln)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("path") and d.get("kind") in _DRIFT_KINDS:
            out.append(d)
    return out


def _drift_ack_key(path, text, kind):
    return (nfc(str(path)), str(text).strip(), kind)


def _drift_split_acked(findings, acks, vault_rel):
    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。"""
    keys = {_drift_ack_key(a["path"], a.get("text", ""), a["kind"]) for a in acks}
    pre = vault_rel.rstrip("/") + "/"
    left, done = [], []
    for f in findings:
        (done if _drift_ack_key(pre + f["path"], f["text"], f["kind"]) in keys else left).append(f)
    return left, done


def _drift_old_reason(f, acks, alive=None):
    """表態失效時(筆記改名),用「原文與種類相同」找舊理由供照抄。alive=現在還在的筆記路徑(repo 相對):
    表態原本那篇還在,就不是改名、是另一篇剛好一樣的樣板句——不借它的理由(代碼審 r1 正確性席:
    守衛紀錄的預告句是樣板,兩篇會一字不差,原本會把 A 的理由印給從沒表態過的 B)。"""
    for a in reversed(acks):
        if str(a.get("text", "")).strip() == f["text"] and a.get("kind") == f["kind"]:
            if alive is not None and nfc(str(a.get("path"))) in alive:
                continue
            return a.get("reason")
    return None


def cmd_drift_ack(env, node, line, kind, reason):
    """lumos drift ack <節點> <行號> --kind … --reason "…":表態「這行照留」。"""
    import datetime, secrets
    if kind not in _DRIFT_KINDS:
        print(f"擋下:--kind 只能是 {'/'.join(_DRIFT_KINDS)}", file=sys.stderr)
        return 2
    if len((reason or "").strip()) < 4:
        print("擋下:--reason 要寫為什麼照留,至少 4 個字", file=sys.stderr)
        return 2
    rel = env.find(node)
    if rel is None:
        return _node_not_found(env, node, write_side=True)
    text = env_text(env, rel)
    lines = (text or "").split("\n")
    if not (1 <= line <= len(lines)) or not lines[line - 1].strip():
        print(f"擋下:{rel} 沒有第 {line} 行,或那一行是空的", file=sys.stderr)
        return 2
    root = _vault_repo_root(env)
    try:
        vault_rel = env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        vault_rel = env.vault.name
    head = ""
    for ln in reversed(lines[:line]):
        if ln.startswith("#"):
            head = ln.lstrip("#").strip()
            break
    token = "DACK-" + secrets.token_hex(4)
    rec = {"id": token, "path": f"{vault_rel}/{rel}", "text": lines[line - 1].strip(), "kind": kind,
           "reason": reason.strip(), "date": datetime.date.today().isoformat(), "heading": head, "line": line}
    fp = Path(root) / _DRIFT_ACKS
    try:
        fp.parent.mkdir(parents=True, exist_ok=True)
    except OSError as ex:
        print(f"擋下:建不了 {fp.parent}:{ex}", file=sys.stderr)
        return 2
    # 表態檔跟筆記庫其他寫入者排同一把鎖(代碼審 r1 併發席;跟治理帳其他寫入者沒共用鎖的整體問題在 Issue 那篇)
    with _vault_write_lock(env.vault):
        rc = _jsonl_append_verified(fp, rec, "id", token)
    if rc != 0:
        return rc
    _gate_event_or_warn(root, "drift-check", "acked", f"{rel}:{line} {kind}:{reason.strip()[:80]}")
    print(f"✓ 表態記下了({token}):{rel} 第 {line} 行照留({_DRIFT_KIND_NAMES[kind]})")
    print(f"推送前的檢查只認提交進去的表態檔:\n    git add {_DRIFT_ACKS} && git commit")
    return 0


# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。"""
    import json as _j
    if text is None:
        return _DRIFT_DEFAULT_GATE, [], False
    try:
        cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
    except (ValueError, UnicodeDecodeError):
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


def _drift_print_findings(rows, stream, acks=None, alive=None):
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {f['path']}:{f['line']}  {f['text'][:60]}", file=stream)
        print(f"      {f['why']}", file=stream)
        old = _drift_old_reason(f, acks, alive) if acks else None
        if old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  …還有 {len(rows) - 20} 筆", file=stream)


def cmd_drift_check(repo=None, diff_range=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。"""
    import time as _t
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
        return 0
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
                                               mark=_DRIFT_GOLIVE_MARK)
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    mode, warns, _explicit = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
    for w in warns:
        print(f"提醒:{w}", file=sys.stderr)
    if mode == "off":
        print("存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
        return 0
    must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
                                              deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
    acks = _drift_load_acks(root, tip)
    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
    lst = _nodehome_list(root, tip)
    alive = set(lst[1]) if lst else None
    if listed:
        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
        _drift_print_findings(listed, sys.stderr, acks, alive)
    if not must and not unknown:
        return 0
    return _drift_report_must(root, mode, must, unknown, acks, alive)


def _drift_report_must(root, mode, must, unknown, acks, alive=None):
    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
    for u in unknown:
        print(f"  判不了:{u}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
              "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push", file=sys.stderr)
    _drift_print_findings(must, sys.stderr, acks, alive)
    kinds = {f["kind"] for f in must}
    if kinds - {"probe"}:
        # ★不叫人重跑 guard settle★(代碼審 r1 正確性席):已經 pass 的紀錄 settle 直接回「已轉正」,不會改寫
        print("預告句那幾筆:把預告句手改成歷史說法(例:「為什麼還不做:」改成「預告當時為什麼還不做:」)。", file=sys.stderr)
    if "probe" in kinds:
        # 條件式的修法不一樣(乙代碼審 r1 正確性席:原本也印改預告句)
        print("回頭條件那幾筆:條件成立了——把待辦做掉,再刪掉這行或改寫成歷史說法。", file=sys.stderr)
    if must:
        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
        for k in sorted(kinds):
            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
    if mode == "block":
        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
                            nodes=sorted({f["path"][:-3] for f in must})[:50])
        return 1
    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
    return 0


# ── 健檢與 doctor ────────────────────────────────────────────────────────────────────

def _drift_vault_of(env):
    root = _vault_repo_root(env)
    try:
        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        return root, env.vault.name


def cmd_drift_scan(env, at=None, as_json=False, budget=None):
    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
    import json as _j, math as _m, time as _t
    budget = _DRIFT_BUDGET_SEC if budget is None else budget
    if not _m.isfinite(budget) or not 0 < budget <= 86400:
        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
        return 2
    deadline = _t.monotonic() + budget
    root, vault_rel = _drift_vault_of(env)
    tenv, sha = env, None
    if at:
        sha = _lens_full_sha(root, at)
        if sha is None:
            print(f"擋下:找不到提交 {at}", file=sys.stderr)
            return 2
        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
        vault_rel = _drift_vault_rel(root, sha) or vault_rel
        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
        if tenv is None:
            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
            return 2
    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))
    if as_json:
        print(_j.dumps({"at": at or "工作目錄", "vault": vault_rel, "unknown": bad,
                        "problems": [{"path": p, "line": n, "text": t, "why": w} for p, n, t, w in probs],
                        "findings": [dict(f, acked=False) for f in left] + [dict(f, acked=True) for f in done]},
                       ensure_ascii=False, indent=1))
        return 0
    _drift_scan_print(at, left, done, bad, probs)
    return 0


def _drift_scan_print(at, left, done, bad, probs=()):
    """scan 的文字輸出:判不了的、各種發現(已表態的照列、標已表態)、回頭條件的問題。"""
    if bad:
        print(f"判不了 {len(bad)} 篇(不是 UTF-8 或讀不了,狀態查不到):" + "、".join(bad[:10]))
    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_KINDS}
    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_KINDS if k != "probe")
          + (f";已表態 {len(done)}" if done else ""))
    for k in _DRIFT_KINDS:
        rows = [(f, False) for f in left if f["kind"] == k] + [(f, True) for f in done if f["kind"] == k]
        if rows:
            print(f"[{k}] {_DRIFT_KIND_NAMES[k]}:{len(rows)}")
            for f, acked in rows:
                print(f"  {f['path']}:{f['line']}  {f['text'][:70]}" + ("  (已表態)" if acked else ""))
                if not acked:
                    print(f"      {f['why']}")
    if probs:
        print(f"[回頭條件的問題] {len(probs)} 處(寫錯、沒帶期限、指不到、寫在不評估的地方、判不了):")
        for p, n, t, w in probs:
            print(f"  {p}:{n}  {t[:70]}")
            print(f"      {w}")


def _drift_doctor_lines(env):
    """doctor Z 段(計劃 [S14]):不評估條件、不跑 git,只讀筆記;每種一行筆數與前幾筆,已表態的另計;全部是 0 回 []。
    跟 E5 一樣是「筆記內容的發現」,用 section + warn_soft 呈現;閘的開關與 CI 提醒是另一回事,在 _drift_gate_doctor_lines。"""
    root, vault_rel = _drift_vault_of(env)
    left, done = _drift_split_acked(_drift_state_findings(env), _drift_load_acks(root), vault_rel)
    out = []
    # 乙:只讀筆記、不評估條件(要看哪些成立跑 drift scan)
    n_rows = n_noby = n_bad = n_dead = 0
    for p in env.notes:
        rows, dead = _probe_lines(env_text(env, p) or "")
        n_rows += len(rows)
        n_dead += len(dead)
        n_noby += sum(1 for _n, _t, pr in rows if pr["by"] is None)
        n_bad += sum(1 for _n, _t, pr in rows if pr["errs"])
    if n_rows or n_dead:
        out.append(f"條件式回頭條件 {n_rows} 條(由 lumos drift scan 評估)"
                   + (f";沒帶期限 {n_noby} 條" if n_noby else "") + (f";寫錯的 {n_bad} 條" if n_bad else "")

