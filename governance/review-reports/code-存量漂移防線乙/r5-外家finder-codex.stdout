 26830	def _drift_layout_changed(tb, tt):
 26831	    """兩端的測試資料夾版面不一樣 → True(代碼審 r3 正確性席:版面看整棵樹、副檔名轉小寫,刪一支不算程式檔的
 26832	    Foo/Main.SWIFT 就能讓 FooTests/ 裡的檔從測試檔變程式檔,不帶路徑的條件翻成立卻不是候選)。讀不到樹當成有變。"""
 26833	    return tb is None or tt is None or tb.layout != tt.layout
