 23681	                      input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 23682	                      capture_output=True, timeout=timeout)
 23683	    except (OSError, _sp.TimeoutExpired):
 23684	        return None
 23685	    if chk.returncode != 0:
 23686	        return None
 23687	    heads = chk.stdout.split(b"\n")
 23688	    out = []
 23689	    for i in range(len(specs)):
 23690	        parts = heads[i].split(b" ") if i < len(heads) else []
