 23364	def _nodehome_split_z(raw):
 23365	    return [os.fsdecode(x) for x in raw.split(b"\0") if x]
 23366	
 23367	
 23368	def _nodehome_list(repo_root, where, oids=None):
 23369	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 23370	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。
 23371	    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。"""
 23372	    if where is None:
 23373	        return {}, []
 23374	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 23375	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 23376	    if raw is None:
 23377	        return None
 23378	    files, allp = {}, []
 23379	    for ent in raw.split(b"\0"):
 23380	        if not ent or b"\t" not in ent:
 23381	            continue
 23382	        meta, p = ent.split(b"\t", 1)
 23383	        parts = meta.split()
 23384	        if where == "index":
 23385	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 23386	                continue
 23387	            mode = parts[0]
 23388	        else:
 23389	            if len(parts) != 3:
 23390	                continue
 23391	            mode = parts[0]
 23392	        path = nfc(os.fsdecode(p))
 23393	        allp.append(path)
 23394	        if mode in (b"100644", b"100755"):
 23395	            files[path] = mode.decode()
 23396	            if oids is not None:
 23397	                oids[path] = (parts[1] if where == "index" else parts[2]).decode()
 23398	    return files, allp
