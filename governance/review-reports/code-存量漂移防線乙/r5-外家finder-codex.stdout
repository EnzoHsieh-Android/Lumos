 23343	class _NodehomeSide:
 23344	    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
 23345	    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
 23346	    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
 23347	    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
 23348	    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")
