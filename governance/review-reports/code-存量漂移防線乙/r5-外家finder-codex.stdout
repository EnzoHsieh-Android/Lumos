 31977	    cmd = ["git", "-C", str(repo_root)]
 31978	    if quote:
 31979	        cmd += ["-c", "core.quotePath=false"]
 31980	    try:
 31981	        if binary:
 31982	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 31983	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 31984	    except (OSError, _sp.TimeoutExpired):
 31985	        return None

