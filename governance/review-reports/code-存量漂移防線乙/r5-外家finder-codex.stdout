 26590	class _DriftProbeTree:
 26591	    """某一版(提交的樹,或工作目錄 'disk')上判 file/symbol/test 條件用的快照,只由 _drift_probe_tree 在列得出路徑時建
 26592	    (讀不到就不建,跟 _nodehome_side 同一種失敗編碼;代碼審 r1 架構對齊席)。檔案內容用到才讀、讀過記住;
 26593	    帶路徑的條件只讀那一支,而且一批先讀完(prefetch;代碼審 r1、r2 併發席:原本先是整批讀全庫,後來一支檔開一次 git)。
 26594	    樹上有、讀不出來的檔記成 None,碰到它的條件算判不了,不算不成立(代碼審 r2 外家席)。status 不在這裡判。"""
 26595	
 26596	    def __init__(self, root, where, files, layout, deadline=None):
 26597	        import time as _t
 26598	        self.root, self.where, self.files, self.layout, self.deadline, self._t = root, where, files, layout, deadline, _t
 26599	        self._text, self._corpus, self._py, self._unread, self._names = {}, {}, {}, {}, {}
 26600	
 26601	    def _over(self):
 26602	        return self.deadline is not None and self._t.monotonic() >= self.deadline
 26603	
 26604	    def _read(self, paths):
 26605	        """把還沒讀過的讀進來;讀不了(git 失敗、預算用完)回 False。讀出來是 None 的(樹上有、內容讀不出)記成 None。
 26606	        工作目錄模式也每支檔前看預算(代碼審 r2 併發席:原本只有讀 git 那條看,scan 預設走的這條不看)。"""
 26607	        todo = [p for p in paths if p not in self._text]
 26608	        if not todo:
 26609	            return True
 26610	        if self._over():
 26611	            return False
 26612	        if self.where == "disk":
 26613	            for p in todo:
 26614	                if self._over():
 26615	                    return False
 26616	                try:
 26617	                    self._text[p] = _drift_decode((Path(self.root) / p).read_bytes())
 26618	                except OSError:
 26619	                    self._text[p] = None
 26620	            return True
 26621	        left = 60 if self.deadline is None else max(1, self.deadline - self._t.monotonic())
 26622	        blobs = _drift_cat(self.root, self.where, todo, left)
 26623	        if blobs is None:
 26624	            return False
 26625	        for p, b in zip(todo, blobs):
 26626	            self._text[p] = None if b is None else _drift_decode(b)
 26627	        return True
 26628	
 26629	    def prefetch(self, conds):
 26630	        """帶路徑的 symbol/test 條件指到的檔,一個行程讀完;讀不了不管,輪到那條時再判。"""
 26631	        paths = {v.rsplit("::", 1)[0].strip() for k, v in conds if k in ("symbol", "test") and "::" in v}
 26632	        self._read(sorted(p for p in paths if p in self.files))
 26633	
 26634	    def names_in(self, paths):
 26635	        """樹上有的那幾支的全文 → _DriftNames;讀不了(預算、git)回 None;有幾支讀不出時用讀得出的建、標 partial。
 26636	        同一組只算一次。"""
 26637	        key = tuple(sorted(p for p in paths if p in self.files))
 26638	        if key not in self._names:
 26639	            if not self._read(list(key)):
 26640	                return None
 26641	            texts = [self._text[p] for p in key if self._text[p] is not None]
 26642	            self._names[key] = _DriftNames(texts, partial=len(texts) < len(key))
 26643	        return self._names[key]
 26644	
 26645	    def bad_paths(self):
 26646	        """讀過、樹上有、內容讀不出的檔。"""
 26647	        return [p for p, t in self._text.items() if t is None]
 26648	
 26649	    def corpus(self, test):
 26650	        """程式檔(test=False)或測試檔的路徑清單;讀不了回 None。沒副檔名的要開頭是 #! 才算(跟每支檔有家共用
 26651	        _head_is_shebang;代碼審 r2 架構對齊席)。讀不出來的檔記在 _unread,沒找到定義時整條算判不了。"""
 26652	        if test not in self._corpus:
 26653	            paths = sorted(p for p in self.files if _drift_probe_code_path(p) and _nodehome_is_test(p, self.layout) == test)
 26654	            if not self._read(paths):
 26655	                return None
 26656	            self._corpus[test] = [p for p in paths if self._text[p] is not None and (
 26657	                _nodehome_code_kind(p) == "ext" or _head_is_shebang(self._text[p][:200].encode("utf-8")))]
 26658	            self._unread[test] = any(self._text[p] is None for p in paths)
 26659	        return self._corpus[test]
 26660	
 26661	    def _defines(self, p, name, test):
 26662	        txt = self._text.get(p)
 26663	        if txt is None or not re.search(rf"(?<![\w]){re.escape(name)}(?![\w])", txt):
 26664	            return False
 26665	        if not _drift_probe_is_py(p, txt):
 26666	            return True
 26667	        if p not in self._py:
 26668	            self._py[p] = _drift_py_names(txt)
 26669	        names = self._py[p]
 26670	        if names is None:
 26671	            return bool(_drift_py_def_re(name, test).search(txt))
 26672	        return name in names[0] or (not test and (name in names[1] or name in names[2]))
 26673	
 26674	    def one(self, k, v):
 26675	        """file/symbol/test 一個條件 → True / False / None(判不了)。"""
 26676	        if k == "file":
 26677	            return v in self.files
 26678	        test = k == "test"
 26679	        path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
 26680	        path, name = path.strip(), name.strip()
 26681	        if path:
 26682	            if path not in self.files:
 26683	                return False
 26684	            if not self._read([path]) or self._text[path] is None:
 26685	                return None
 26686	            return self._defines(path, name, test)
 26687	        items = self.corpus(test)
 26688	        if items is None:
 26689	            return None
 26690	        if any(self._defines(p, name, test) for p in items):
 26691	            return True
 26692	        return None if self._unread[test] else False
 26693	
