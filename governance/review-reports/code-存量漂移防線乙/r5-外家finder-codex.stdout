 23711	def _nodehome_cat_blobs(repo_root, specs, timeout=60):
 23712	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 23713	
 23714	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 23715	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 23716	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 23717	    import subprocess as _sp
 23718	    if not specs:
 23719	        return []
 23720	    if any("\n" in s_ for s_ in specs):
 23721	        return None
 23722	    try:
 23723	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 23724	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 23725	                    capture_output=True, timeout=timeout)
 23726	    except (OSError, _sp.TimeoutExpired):
 23727	        return None
 23728	    if r.returncode != 0:
 23729	        return None
 23730	    out, pos, res = r.stdout, 0, []
 23731	    for _ in specs:
 23732	        nl = out.find(b"\n", pos)
 23733	        if nl < 0:
 23734	            return None
 23735	        head = out[pos:nl].split(b" ")
 23736	        pos = nl + 1
 23737	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 23738	            size = int(head[2])
 23739	            res.append(out[pos:pos + size])
 23740	            pos += size + 1

