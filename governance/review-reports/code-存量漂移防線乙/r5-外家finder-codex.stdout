 11016	def _gist_cut(s):
 11017	    """L0 截斷(Projects/一句話層供糧_計劃 T1,r1 M-5/E-2 折入):≤80 直取;
 11018	    >80 先取首句(句末符 。!?;;為界,首句 ≤80 才用);仍超 → 硬截 80+…。
 11019	    先 _esc_clean 消毒(控制碼換空格,同逃逸帳載重合約),大 limit=只消毒不在這層截。"""
 11020	    s = _esc_clean(nfc(str(s)).strip(), 100000)
 11021	    if len(s) <= 80:
 11022	        return s
 11023	    m = _GIST_SENT_RE.match(s)
 11024	    if m:
 11025	        return m.group(0)
 11026	    return s[:80] + "…"
