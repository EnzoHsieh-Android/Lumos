 26745	def _drift_probe_is_candidate(conds, ch, vault_pre, tenv, tip_text):
 26746	    """這一行的條件會不會被這次推送改變結果(計劃〈做法〉第 0 節,篩選單位是行)→ True / False / None(判不了)。
 26747	    不帶路徑的 symbol/test:名稱出現在這次改到的程式或測試檔的★終點全文★就是候選(tip_text() → 那幾支的全文或 None)。
 26748	    ★為什麼不只看新增行★(代碼審 r2 正確性席):判定改用 ast、沒副檔名的 #! 腳本也算程式檔之後,「定義在不在」
 26749	    可以在名稱那一行沒動的情況下翻轉——只刪掉包住 def 的三引號、只在第一行加 #!。要處理只看終點成立,
 26750	    所以只要終點全文;順便省掉原本算新增行的那次 diff(標了 -diff 屬性的檔看不見新增行的坑也一起沒了)。
 26751	    tip_text() → _DriftNames(終點全文的識別字集合,名稱是一般識別字時查集合,不再對幾 MB 的字串逐條跑正則——
 26752	    代碼審 r3 併發席實測 100 行條件 10 秒)或 None。"""
 26753	    hits = [_drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text) for k, v in conds]
 26754	    # 任一確定受影響就是候選;判不了的不提前停(代碼審 r3 外家席:原本前一個判不了就回判不了,後面確定受影響的
 26755	    # 那條本來可以列成可表態的發現)
 26756	    if any(hits):
 26757	        return True
 26758	    return None if any(h is None for h in hits) else False
 26759	
 26760	
 26761	def _drift_probe_cond_candidate(k, v, ch, vault_pre, tenv, tip_text):
 26762	    """一個條件會不會被這次推送改變結果 → True / False / None(判不了)。"""
 26763	    if k == "file":
 26764	        return v in ch["touched"]
 26765	    if k == "status":
 26766	        rel = tenv.resolve(link_target(v.partition("=")[0].strip()))
 26767	        return rel is None or (vault_pre + rel) in ch["touched"]
 26768	    path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
 26769	    if path.strip():
 26770	        return path.strip() in ch["touched"]
 26771	    if ch["code_shape"]:
 26772	        return True
 26773	    if not ch["code_touched"]:
 26774	        return False
 26775	    names = tip_text()
 26776	    if names is None:
 26777	        return None
 26778	    name = name.strip()
 26779	    hit = name in names if re.fullmatch(r"\w+", name) else bool(re.search(rf"(?<![\w]){re.escape(name)}(?![\w])", names.text))
 26780	    return True if hit else (None if names.partial else False)
 26781	
