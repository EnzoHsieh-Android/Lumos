 27657	                    raise ValueError(f"遠端 {ref} 上的這篇已經有決策 {did}:可能①已經推上去了——請用 "
 27658	                                     f"lumos decision-supersede 翻案;或②兩條分支撞號——請先把你的決策改號")
 27659	            # git 配不成改名的搬檔(新檔沒進 git、或改寫太多相似度不夠):遠端上在工作目錄不見的筆記裡,
 27660	            # 有一條跟這條一模一樣的決策,就當它是這篇改名前的樣子(代碼審 r3 兩席、驗收輪兩席)
 27661	            for q, bq in zip(pure_del, blobs[1:]):
 27662	                if bq is not None and _same_decision(_dec_item(bq.decode("utf-8", errors="replace"))):
 27663	                    raise ValueError(f"遠端 {ref} 上的 {q} 在工作目錄不見了,而它有一條跟這條一模一樣的決策 {did}:多半是這篇"
 27664	                                     "改名前的樣子、已經推上去了——請用 lumos decision-supersede 翻案;如果不是,先 git add "
 27665	                                     "新舊兩邊(或用 git mv)讓 git 認出改名")
 27666	    lines, _s_fm, e_fm = load_raw_for_edit(path)
 27667	    fm = lines[1:e_fm]
 27668	    loc = decisions_items(fm)
 27669	    if loc is None or not loc[2]:
 27670	        raise ValueError("這篇筆記沒有讀得出的決策紀錄(decisions)")
 27671	    _s, _e, items, _ii, sub = loc
 27672	    pad = " " * sub
 27673	    hit = [(st, en) for st, en in items
 27674	           if any(re.match(rf"^\s*(?:-\s+)?id:\s*{re.escape(did)}\s*$", fm[i]) for i in range(st, en + 1))]
 27675	    if not hit:
 27676	        raise ValueError(f"找不到決策 {did}")
 27677	    st, en = hit[0]
 27678	    k0 = next((i for i in range(st, en + 1) if re.match(rf"^(?:{pad}|\s*-\s+){re.escape(field)}:", fm[i])), None)
 27679	    if k0 is None:
 27680	        raise ValueError(f"決策 {did} 沒有欄位 {field}")
 27681	    def _ind(s):
 27682	        return len(s) - len(s.lstrip(" "))
 27683	    k1 = k0
 27684	    j = k0 + 1
 27685	    while j <= en:
 27686	        if not fm[j].strip():
 27687	            # 空行:後面還有比欄位深的行就算同一欄(多行值中間的空段落;代碼審 r1 正確性席:原本停在空行,後半段留在檔裡)
 27688	            nxt = next((q for q in range(j + 1, en + 1) if fm[q].strip()), None)
 27689	            if nxt is None or _ind(fm[nxt]) <= sub:
 27690	                break
 27691	            j += 1
 27692	            continue
 27693	        if _ind(fm[j]) <= sub:
 27694	            break
 27695	        k1 = j
 27696	        j += 1
 27697	    head_val = fm[k0].split(":", 1)[1].strip()
 27698	    # 冒號後是空的=清單(或巢狀、空值;parse_decisions 也讀成清單),[ { 開頭=一行式清單或對照表(YAML 讀成清單或對照表);
 27699	    # 只有一般文字與 | > 多行文字能改(代碼審 r1、r2 外家席:原本會靜默把清單壓成一句)
 27700	    if not head_val or head_val.startswith(("[", "{")):
 27701	        raise ValueError(f"決策 {did} 的「{field}」是清單、巢狀或空的欄位,decision-amend 只改一段文字的欄位")
 27702	    lead = fm[k0][:fm[k0].index(field)]
 27703	    newtxt = text.replace("\n", " ").strip()
 27704	    new_fm = [*fm[:k0], f"{lead}{field}: {_fmt_decision_value(newtxt)}", *fm[k1 + 1:]]
 27705	    new_lines = lines[:1] + new_fm + lines[e_fm:]
 27706	
 27707	    def _check(_fields):
 27708	        for d in parse_decisions(_fm_of(new_lines)):
 27709	            if str(d.get("id", "")).strip() == did:
 27710	                return nfc(str(d.get(field, ""))).strip() == nfc(newtxt)
 27711	        return False
 27712	    atomic_write_verify(path, new_lines, "decisions", _check)
 27713	    print(f"✓ decision-amend {rel} {did}.{field} 改好了(這條決策還沒推上去)")
 27714	    return 0
