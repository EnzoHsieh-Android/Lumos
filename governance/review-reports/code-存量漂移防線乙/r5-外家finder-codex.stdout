 26892	def _drift_probe_old(p, pr, renames, benv, pre, cache):
 26893	    """起點有沒有「同一條」:終點路徑照改名對回起點,再比條件標記 → True/False;沒有起點回 None。cache 存每篇起點的標記集合。"""
 26894	    if benv is None:
 26895	        return None
 26896	    bp = renames.get(pre + p, pre + p)
 26897	    bp = bp[len(pre):] if bp.startswith(pre) else p
 26898	    if bp not in cache:
 26899	        cache[bp] = {tuple(x[2]["conds"]) for x in _probe_lines(env_text(benv, bp) or "")[0]}
 26900	    return tuple(pr["conds"]) in cache[bp]
 26901	
