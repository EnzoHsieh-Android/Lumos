 26706	def _drift_probe_one(tree, env, k, v):
 26707	    """一個條件 → True / False / None(判不了)。status 只看筆記(env),不需要 git——不是 git 專案也判得了
 26708	    (代碼審 r1 正確性席);指到的筆記讀不出來算判不了(外家席:原本當成不成立,靜默放行)。"""
 26709	    if k == "status":
 26710	        node, _eq, vals = v.partition("=")
 26711	        rel = env.resolve(link_target(node.strip())) if env is not None else None
 26712	        n = env.notes.get(rel) if rel else None
 26713	        if n is not None and _note_unreadable(n):
 26714	            return None
 26715	        return n is not None and _drift_str(n, "status") in {x.strip() for x in vals.split("|")}
 26716	    return None if tree is None else tree.one(k, v)
