 31930	def _lens_range_ok(diff_range):
 31931	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 31932	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
