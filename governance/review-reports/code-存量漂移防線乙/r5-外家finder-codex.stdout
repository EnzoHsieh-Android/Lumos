 27717	def _ci_strip_comment(line):
 27718	    """切掉不在引號裡的行尾註解(` #…`);引號裡的 # 保留(驗收輪通才席:註解裡有撇號時原本整段保留)。"""
 27719	    q = None
 27720	    for i, ch in enumerate(line):
 27721	        if q:
 27722	            if ch == q:
 27723	                q = None
 27724	        elif ch in ("'", '"'):
 27725	            q = ch
 27726	        elif ch == "#" and i > 0 and line[i - 1] in " \t":
 27727	            return line[:i].rstrip()
 27728	    return line
 27729	
