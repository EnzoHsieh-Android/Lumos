 23883	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 23884	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 23885	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 23886	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 23887	    None=整批當成一個提交(提交前)。"""
 23888	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 23889	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 23890	    homesN, ownN = _nodehome_homes(repo_root, N)
 23891	    homesB, ownB = _nodehome_homes(repo_root, B)
 23892	    blocks, reminders, pairs = [], [], []
 23893	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 23894	    for code, old, new in changes:
 23895	        if old is not None and (new is None or code == "R"):
 23896	            deleted.add(old)
 23897	        if new is None:
 23898	            continue
 23899	        changed_new.add(new)
 23900	        if code in ("A", "R", "C"):
 23901	            added.add(new)
 23902	        if code == "R" and old:
 23903	            renamed_from[new] = old
 23904	    code_changed = {p for p in changed_new if p in reqN}
 23905	    code_added = {p for p in added if p in reqN}
 23906	    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
 23907	    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
 23908	    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
 23909	    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
 23910	    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
 23911	    code_touched = code_changed | code_deleted
 23912	    vpre = vault_rel + "/"
 23913	    refs_cache = {}
 23914	
 23915	    def refs_now(rel):
 23916	        if rel not in refs_cache:
 23917	            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
 23918	        return refs_cache[rel]
 23919	
 23920	    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]

