 26727	def _drift_probe_changes(root, base, tip, deadline=None):
 26728	    """範圍裡的改動(只算一次 name-status)→ {touched: 改到的路徑(改名兩端都算), renames: 改名 新→舊,
 26729	    code_touched: 改到的程式與測試檔, code_shape: 有程式或測試檔被新增、刪除、改名};git 失敗或預算用完回 None。
 26730	    解析用共用的 _nodehome_name_status(代碼審 r1 架構對齊席:原本手刻第二份);筆記改名也從這一次拿(圖譜一致席:
 26731	    原本另起一次 git)。不帶路徑的條件改看 code_touched 在終點的全文(_drift_probe_is_candidate),不再算新增行。"""
 26732	    import time as _t
 26733	    if deadline is not None and _t.monotonic() >= deadline:
 26734	        return None
 26735	    raw = _ns_git(root, "diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip)
 26736	    if raw is None:
 26737	        return None
 26738	    codes = {}
 26739	    touched, renames, _gone = _nodehome_name_status(raw, codes=codes)
 26740	    shape = any(c in ("A", "D", "R", "C") and _drift_probe_code_path(p) for p, c in codes.items())
 26741	    return {"touched": touched, "renames": renames, "code_shape": shape,
 26742	            "code_touched": sorted(p for p in touched if _drift_probe_code_path(p))}
