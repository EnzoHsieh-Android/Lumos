 26865	def _drift_row_unread(conds, envs, trees):
 26866	    """這一行的條件實際碰到、而且讀不出來的檔或筆記(r4 正確性席:原本點名整棵樹讀不出的全部檔,
 26867	    status 判不了的行反而點名一支無關的程式檔)。帶路徑的 symbol/test 看那一支;不帶路徑的看讀不出的程式檔;
 26868	    status 看指到的那篇筆記。"""
 26869	    out = set()
 26870	    for k, v in conds:
 26871	        if k == "status":
 26872	            for env in envs:
 26873	                rel = env.resolve(link_target(v.partition("=")[0].strip())) if env is not None else None
 26874	                n = env.notes.get(rel) if rel else None
 26875	                if n is not None and _note_unreadable(n):
 26876	                    out.add(rel)
 26877	        elif k in ("symbol", "test"):
 26878	            path = v.rsplit("::", 1)[0].strip() if "::" in v else ""
 26879	            for t in trees:
 26880	                if t is not None:
 26881	                    out.update(q for q in t.bad_paths() if (q == path if path else _drift_probe_code_path(q)))
 26882	    return sorted(out)
