 26695	def _drift_probe_tree(root, where, deadline=None):
 26696	    """→ _DriftProbeTree 或 None(git 列不出路徑、不是 git 專案、或預算已用完)。where:完整提交編號或 'disk'。"""
 26697	    import time as _t
 26698	    if deadline is not None and _t.monotonic() >= deadline:
 26699	        return None
 26700	    lst = _drift_disk_list(root) if where == "disk" else _drift_list(root, where)
 26701	    if lst is None:
 26702	        return None
 26703	    return _DriftProbeTree(root, where, set(lst[0]), _nodehome_layout(lst[1]), deadline)
