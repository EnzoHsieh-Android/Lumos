 26903	def _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base):
 26904	    """推送判定要的起點資料 → (範圍改動, 起點圖譜, 判不了的原因或 None)。起點的圖譜位置與樹清單都走 _drift_list 的記憶。"""
 26905	    import time as _t
 26906	    ch = _drift_probe_changes(root, base, tip, deadline)
 26907	    if ch is None:
 26908	        return None, None, "git 算不出這次推送改了哪些檔(條件式回頭條件)"
 26909	    if not base:
 26910	        return ch, None, None
 52880	    check("G1 兩種發現都有:表態指令一種一行,不印成 c1|probe(正確性 F5、圖譜一致 F1、外家 F3)",
 52881	          "c1|probe" not in e and "--kind c1 " in e and "--kind probe " in e, e)
 52882	    root = _nh_repo()
 52883	    _nh_node(root, "P", typ="project", folder="Projects", resp=None, status="doing", summary="KEY:p")
 52884	    _nh_node(root, "N", typ="issue", folder="Issues", resp=None, status="open", summary="KEY:n",
 52885	             body=f"REVISIT:[when-status:Projects/P=done]{by} P 收尾了就結案")
 52886	    _nh_commit(root, "c")
 52887	    fu = m._drift_exam_replay(root, _na_head(root), V, ["Projects/P"])
 52888	    check("G2 考試重放跟 lumos set 一樣列第③項(正確性 F3)", isinstance(fu, set) and "Issues/N.md" in fu, str(fu))
 52889	    vault = root / V
 52890	    rcs = [run(vault, "drift", "scan", "--budget", b).returncode for b in ("inf", "nan")]
 52891	    check("G3 --budget 收到 inf、nan:擋下 rc2,不丟例外(外家 F2)", rcs == [2, 2], str(rcs))
 52892	    base = _na_head(root)
 52893	    _nh_node(root, "N", typ="issue", folder="Issues", resp=None, status="open", summary="KEY:n",
 52894	             body=f"REVISIT:[when-status:Projects/P=done]{by} P 收尾了就結案\n新的一句")
 52895	    _nh_commit(root, "只改正文")
 52896	    _nh_node(root, "N", typ="issue", folder="Issues", resp=None, status="open", summary="KEY:n",
 52897	             body=f"REVISIT:[when-status:Projects/P=done]{by} P 收尾了就結案\n新的一句\n再一句")
 52898	    _nh_commit(root, "再改正文")      # 兩個提交:逐提交那幾次 diff 的參數才不會跟淨差異撞在一起
