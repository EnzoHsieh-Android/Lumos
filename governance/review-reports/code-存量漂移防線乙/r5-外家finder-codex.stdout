 26719	def _drift_probe_line(tree, env, conds):
 26720	    """一行的全部條件(全部成立才算成立)→ True / False / None。有一個確定不成立就是 False。"""
 26721	    vals = [_drift_probe_one(tree, env, k, v) for k, v in conds]
 26722	    if any(x is False for x in vals):
 26723	        return False
 26724	    return None if any(x is None for x in vals) else True
