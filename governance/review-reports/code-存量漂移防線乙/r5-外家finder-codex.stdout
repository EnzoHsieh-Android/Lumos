 26885	def _drift_bad_note(paths):
 26886	    """判不了時點名讀不出來的檔(代碼審 r3 正確性席:原本只說讀不出,推的人找不到是哪支)。
 26887	    路徑來自被推送的內容,印之前把控制字元換成空格(r4 資安席;借逃逸帳的 _esc_clean)。"""
 26888	    bad = [_esc_clean(q) for q in paths]
 26889	    return (":" + "、".join(bad[:5]) + (f" 等 {len(bad)} 支" if len(bad) > 5 else "")) if bad else ""
 26890	
