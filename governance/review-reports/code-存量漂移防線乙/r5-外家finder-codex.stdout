 53046	def t_drift_code_review_yi_r4_regressions():
 53047	    """乙代碼審 r4(上限後的破例輪)查出的洞:SHA-256 repo 記不到內容編號、一支讀不出就把另一支的確定命中降成判不了、
 53048	    判不了時點名無關的檔、點名的檔名沒跳脫控制字元。3.9 崩潰那幾條隨最低版本改 3.14 整段拿掉(見 r3 回歸測試 C1)。
 53049	    翻紅釘:只認 40 碼 → A1 紅;有一支讀不出就回 None → B1 紅;點名整棵樹 → C1 紅;不跳脫 → D1 紅。"""
 53050	    print("t_drift_code_review_yi_r4_regressions")
 53051	    import subprocess as sp, tempfile as _tf, unicodedata as _ud
 53052	    m = _load_lumos_inproc()
 53053	    # ── A SHA-256 物件格式的 repo:用內容編號讀 NFD 檔名的程式檔 ──
 53054	    tmp = Path(_tf.mkdtemp(prefix="gctl-yi-r4-"))
 53055	    root = tmp / "r256"
 53056	    ok = sp.run(["git", "init", "-q", "--object-format=sha256", str(root)], capture_output=True).returncode == 0
 53057	    if ok:
 53058	        for kv in (("user.email", "t@t"), ("user.name", "t"), ("core.precomposeunicode", "false")):
 53059	            sp.run(["git", "-C", str(root), "config", *kv], capture_output=True)
 53060	        blob = sp.run(["git", "-C", str(root), "hash-object", "-w", "--stdin"], input=b"def cafe_fn():\n    pass\n",
 53061	                      capture_output=True).stdout.decode().strip()
 53062	        nfd = _ud.normalize("NFD", "src/café.py")
 53063	        sp.run(["git", "-C", str(root), "update-index", "--add", "--cacheinfo", f"100644,{blob},{nfd}"], capture_output=True)
 53064	        sp.run(["git", "-C", str(root), "commit", "-qm", "c"], capture_output=True)
 53065	        head = sp.run(["git", "-C", str(root), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
 53066	        m._DRIFT_LS_CACHE.clear()
 53067	        m._DRIFT_OID_CACHE.clear()
 53068	        t = m._drift_probe_tree(str(root), head, None)
 53069	        got = (t.one("symbol", "cafe_fn"), t.one("symbol", "src/café.py::cafe_fn")) if t else None
 53070	        check("A1 SHA-256 repo(64 碼提交編號)、git 裡存 NFD 檔名:帶路徑與不帶路徑的條件都判得出成立",
 53071	              len(head) == 64 and got == (True, True), f"{len(head)} {got}")
 53072	    else:
 53073	        print("  (沒驗到 A1:這台機器的 git 不支援 --object-format=sha256)")
 53074	    # ── B 一支讀不出、另一支確定命中 ──
 53075	    t = m._DriftProbeTree(".", "tip", {"good.py", "bad.py"}, ({}, {}))
 53076	    t._text = {"good.py": "def target():\n    pass\n", "bad.py": None}
