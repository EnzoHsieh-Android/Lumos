 26903	def _drift_probe_prepare(root, base, tip, vault_rel, deadline, override_base):
 26904	    """推送判定要的起點資料 → (範圍改動, 起點圖譜, 判不了的原因或 None)。起點的圖譜位置與樹清單都走 _drift_list 的記憶。"""
 26905	    import time as _t
 26906	    ch = _drift_probe_changes(root, base, tip, deadline)
 26907	    if ch is None:
 26908	        return None, None, "git 算不出這次推送改了哪些檔(條件式回頭條件)"
 26909	    if not base:
 26910	        return ch, None, None
 26911	    if deadline is not None and _t.monotonic() >= deadline:
 26912	        return None, None, "預算用完"
 26913	    benv = _drift_tree_env(root, base, _drift_vault_rel(root, base) or vault_rel, override_base, deadline=deadline)
 26914	    if benv is None:
 26915	        return None, None, "git 讀不出起點的筆記(條件式回頭條件)"
 26916	    return ch, benv, None
