 23676	def _nodehome_cat_sizes(repo_root, specs, timeout=60):
 23677	    """同 _nodehome_cat_blobs 的批次讀取,只問大小(cat-file --batch-check):回同順序的 int|None(沒有這個物件=None);git 跑不起來回 None。"""
