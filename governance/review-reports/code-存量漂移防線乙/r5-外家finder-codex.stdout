 23413	def _nodehome_reader(repo_root, where):
 23414	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 23415	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 23416	    if where is None:
 23417	        return lambda p: None
 23418	    disk_ok_all = False
 23419	    differ = None
 23420	    if where == "index":
 23421	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 23422	    else:
 23423	        head = _lens_full_sha(repo_root, "HEAD")
 23424	        if head and head == where:
 23425	            differ = _nodehome_changed_vs_disk(repo_root, where)
 23426	    root = Path(repo_root)
 23427	    spec = "" if where == "index" else where
 23428	
 23429	    def read(p):
 23430	        if differ is not None and p not in differ:
 23431	            fp = root / p
 23432	            try:
 23433	                if fp.is_file() and not fp.is_symlink():
 23434	                    return fp.read_bytes()
 23435	            except OSError:
 23436	                pass
