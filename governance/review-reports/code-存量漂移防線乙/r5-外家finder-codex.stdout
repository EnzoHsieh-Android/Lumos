 26571	class _DriftNames:
 26572	    """幾支檔全文的識別字集合(用 \\w+ 切),名稱查集合;不是一般識別字的名稱才對原文跑正則。
 26573	    逐支檔建集合,不先把全文接成一大段(r4 併發席:接起來再整批切,尖峰記憶體是文字的 10 倍以上)。
 26574	    partial:有檔讀不出——這時「找到」照算,「找不到」要當判不了(r4 外家席:原本有一支讀不出就整份作廢,
 26575	    另一支已經確定命中的也被降成判不了)。"""
 26576	
 26577	    def __init__(self, texts, partial=False):
 26578	        self.texts, self.partial, self._set = texts, partial, set()
 26579	        for t in texts:
 26580	            self._set.update(re.findall(r"\w+", t))
 26581	
 26582	    @property
 26583	    def text(self):
 26584	        return "\n".join(self.texts)
 26585	
 26586	    def __contains__(self, name):
 26587	        return name in self._set
 26588	
