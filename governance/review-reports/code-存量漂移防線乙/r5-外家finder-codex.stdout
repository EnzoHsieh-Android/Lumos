 52902	    try:
 52903	        m._notelines_new(root, False, base, tip, V, reader=m._nodehome_reader(root, tip), mark="x", keep_other=True)
 52904	    finally:
 52905	        m._ns_diff = orig_diff
 52906	    check("G4 開頭欄位其他欄沒有新行時,不多算一次淨差異(併發 F3)", net_calls == [], str(net_calls))
 52907	    fake = type("T", (), {"files": set()})()
 52908	    got = (m._drift_probe_path_warn("symbol", "v1.2::x", fake), m._drift_probe_path_warn("symbol", "src/new.py::main", fake),
 52909	           m._drift_probe_path_warn("symbol", "Makefile::build", fake) or "")
