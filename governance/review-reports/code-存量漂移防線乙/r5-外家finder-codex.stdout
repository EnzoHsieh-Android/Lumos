 33778	def _bound_tests_range(repo_root, diff_range):
 33779	    """新分支首推時把「空樹起點」換成主線 tip。回 (可用的範圍, 說明) 或 (None, 為什麼算不出)。
 33780	
 33781	    ★為什麼不是拿掉特例、讓它跑滿全部★(2026-09-07 設計 [S3],r2 圖譜席算過):
 33782	    首推時空樹當起點等於整個 repo 都是 diff,固定席近乎全中——每個新分支的第一次推送
 33783	    都會跑滿全部合約測試。那不是「更嚴」,是把這道閘變成每次開分支都要等的稅。
 33784	    ★也不是維持原狀★:原本這種情況直接記帳放行,所以「每次推送都跑」在首推時是假的。
 33785	
 33786	    ★改在 Python 這一側,不動推送關卡的 bash★(設計 [S3] 明寫,r3 通才席判 blocking:
 33787	    上一版兩種讀法都通)。主線判準沿用既有的 _mainline_ref(已推上去的 main/master 優先,
 33788	    再退本地),那支是純函式、沒有副作用,直接共用即可。
 33789	    """
 33790	    r = str(diff_range or "")
 33791	    if not r.startswith(_EMPTY_TREE_SHA):
 33792	        return r, None
 33793	    head = r.split("..", 1)[1] if ".." in r else ""
 33794	    ml = _mainline_ref(repo_root)
 33795	    if not ml or not head:
 33796	        return None, "新分支首推,而且問不到主線 tip(全新的 repo?)——受波及範圍算不出來"
 33797	    # ★要用 merge-base,不是主線 tip 本身★(2026-09-07 代碼審 r1 外家否決席判 blocker,實測屬實):
 33798	    # `主線..HEAD` 是兩棵樹的端點比對——★主線獨有的改動會被反向算進這次推送★。
 33799	    # 實測:主線有 m.txt、feature 有 f.txt,`主線..feature` 動到 f.txt 與 m.txt 兩個;
 33800	    # `merge-base..feature` 只動到 f.txt。誤點到的那些合約如果有紅的測試,
 33801	    # 高風險那條路會擋掉一次本來該過的推送——★方向錯得最難看的那種★。
 33802	    import subprocess as _sp
 33803	    mb = _sp.run(["git", "merge-base", ml[1], head], capture_output=True, text=True, errors="replace",
 33804	                 cwd=str(repo_root))
 33805	    if mb.returncode != 0 or not mb.stdout.strip():
 33806	        # 沒有共同祖先(孤兒分支 / 剛 init 的 repo)→ 誠實說算不出來,不要拿一個錯的範圍硬算
 33807	        return None, f"新分支首推,而且跟主線 {ml[0]} 沒有共同祖先——受波及範圍算不出來"
 33808	    return f"{mb.stdout.strip()}..{head}", f"新分支首推:起點改用跟主線 {ml[0]} 的共同祖先"
 33809	
