 26510	    (代碼審 r1 外家席:scan 預設看工作目錄,原本卻讀 index,沒追蹤的新檔判成不存在、刪了沒 stage 的判成還在)。"""
 26511	    lst = _nodehome_list(root, "index")
 26512	    raw = _nodehome_git(root, "ls-files", "--others", "--exclude-standard", "-z") if lst is not None else None
 26513	    if raw is None:
 26514	        return None
 26515	    base = Path(root)
 26516	    allp = sorted(set(lst[1]) | {nfc(os.fsdecode(p)) for p in raw.split(b"\0") if p})
 26517	    allp = [p for p in allp if os.path.lexists(base / p)]
 26518	    files = {p for p in allp if (base / p).is_file() and not (base / p).is_symlink()}
 26519	    return files, allp
