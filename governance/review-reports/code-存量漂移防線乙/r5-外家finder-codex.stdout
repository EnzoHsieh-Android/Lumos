 26438	def _probe_lines(text):
 26439	    """一篇筆記的條件式回頭條件 → (清單[(行號, 原文, 解析結果)], 寫在不評估的地方[(行號, 原文, 原因)])。
 26440	    只認正文與摘要的可見行:圍欄(_visible_lines)、行內程式碼(_strip_inline_markup)、表格行裡的都不算;
 26441	    開頭欄位裡 summary 以外的欄與表格行裡的條件標記列成「寫在不評估的地方」(計劃〈做法〉第 0 節)。"""
 26442	    lines = text.split("\n")
 26443	    regs = _notelines_regions(text)
 26444	    vis = {no for no, _ln in _visible_lines(lines)}
 26445	    out, dead = [], []
 26446	    for i, ln in enumerate(lines, 1):
 26447	        if i not in vis:
 26448	            continue
 26449	        probe = _strip_inline_markup(ln)[0]
 26450	        table = probe.lstrip().startswith("|")
 26451	        if regs[i - 1] in ("body", "summary") and not table:
 26452	            kind, rest = _revisit_split(probe)
 26453	            if kind == "cond":
 26454	                out.append((i, ln.strip(), _probe_parse(rest)))
 26455	            continue
 26456	        if _PROBE_ANY_RE.search(probe):
 26457	            dead.append((i, ln.strip(), "寫在表格行裡,不評估" if table else "寫在開頭欄位裡 summary 以外的欄,不評估"))
 26458	    return out, dead
