 26683	                return False
 26684	            if not self._read([path]) or self._text[path] is None:
 26685	                return None
 26686	            return self._defines(path, name, test)
 26687	        items = self.corpus(test)
 26688	        if items is None:
 26689	            return None
 26690	        if any(self._defines(p, name, test) for p in items):
 26691	            return True
 26692	        return None if self._unread[test] else False
