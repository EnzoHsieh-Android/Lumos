 26836	def _drift_probe_prefetch(conds, trees):
 26837	    """帶路徑的條件指到的檔,每一版一個行程讀完(代碼審 r2 併發席);列不出樹的那一版跳過,輪到時再判不了。"""
 26838	    for t in trees:
 26839	        if t is not None:
 26840	            t.prefetch(conds)
