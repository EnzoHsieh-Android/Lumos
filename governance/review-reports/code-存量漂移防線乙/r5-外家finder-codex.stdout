 26952	def _drift_looks_like_ext(ext):
 26953	    """像不像副檔名:字母開頭、只有字母數字與 _ + -,而且全小寫或全大寫(.py、.c++、.R、.SWIFT)。
 26954	    大小寫混著的(app.Config 的 Config)是限定名、數字開頭的(v1.2 的 2)是版本號(代碼審 r2、r3 邊界席;
 26955	    r3 外家席:原本只收 ASCII 英數,.c++ 被誤列)。"""
 26956	    return bool(ext) and ext[0].isalpha() and all(ch.isalnum() or ch in "_+-" for ch in ext) \
 26957	        and (ext == ext.lower() or ext == ext.upper())
