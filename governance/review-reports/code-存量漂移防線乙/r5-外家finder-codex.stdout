 23351	def _nodehome_git(repo_root, *args):
 23352	    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
 23353	    r = _lens_git(repo_root, *args, binary=True)
 23354	    if r is None or r.returncode != 0:
 23355	        return None
 23356	    return r.stdout
