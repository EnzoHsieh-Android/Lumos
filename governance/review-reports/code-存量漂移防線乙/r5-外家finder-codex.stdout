 23699	    if sizes is None:
 23700	        return None
 23701	    ok = [i for i, n in enumerate(sizes) if n is not None and n <= max_bytes]
 23702	    got = _nodehome_cat_blobs(repo_root, [specs[i] for i in ok], timeout=timeout) if ok else []
 23703	    if got is None:
 23704	        return None
 23705	    res = [None] * len(specs)
 23706	    for i, v in zip(ok, got):
 23707	        res[i] = v
 23708	    return res
