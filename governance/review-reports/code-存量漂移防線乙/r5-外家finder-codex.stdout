  1071	def cmd_loop_rewrite(env, loop_id, successor, note):
  1072	    """人裁「整份重寫」的收尾記帳(設計審收斂重定義 d3 帳面件的寫入端;2026-08-25 第一次真實
  1073	    rewrite 事件時補建)。寫 gate=design-loop kind=rewrite 事件到治理帳,note 機械帶血緣
  1074	    (prev=舊編號;successor=新編號)——「連續兩次判重寫→強制攤人,不得三開」靠沿 note 鏈查,
  1075	    本指令寫入前自動查一跳:若本編號自己就是某次 rewrite 的 successor,印強制攤人警告(advisory)。"""
  1076	    if not successor or successor.strip() == loop_id.strip():
  1077	        print("擋下:--successor 要給新開的迴圈編號,而且不能跟舊編號一樣——重寫=換新編號載新版,同號沒有「重寫」可言", file=sys.stderr)
  1078	        return 2
  1079	    # 血緣一跳查詢:這個編號是不是已經是上一次重寫的產物?
  1080	    chain_prev = None
  1081	    try:
  1082	        import json as _j
  1083	        import re as _re
  1084	        gl = env.vault.parent / ".governance-log.jsonl"
  1085	        # 邊界比對:successor=<id> 後面必須是分號或字串結尾——裸子字串會讓前綴編號互撞
  1086	        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
  1087	        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
  1088	        if gl.exists():
  1089	            for line in gl.read_text(encoding="utf-8").splitlines():
  1090	                try:
  1091	                    o = _j.loads(line)
  1092	                except ValueError:
  1093	                    continue
  1094	                if not isinstance(o, dict):
  1095	                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
  1096	                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
  1097	                        and _pat.search(str(o.get("note", ""))):
  1098	                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
  1099	    except OSError:
  1100	        pass
  1101	    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
  1102	    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
  1103	    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
  1104	    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
  1105	    if chain_prev:
  1106	        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
  1107	    print("  之後查血緣:")
  1108	    print("    lumos gov --stats")
  1109	    return 0
