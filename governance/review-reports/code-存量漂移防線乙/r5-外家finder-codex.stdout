 26843	def _drift_probe_candidates(lines, ch, pre, tenv, benv, tip_tree, out):
 26844	    """候選行 → ([(路徑, 行號, 原文, 解析, 起點有沒有同一條)], 判不了[說明])。起點沒有同一條的(新寫或改了條件)一律是候選。
 26845	    tip_tree:終點的樹(不帶路徑的條件要看改到的程式檔全文時用,只建一次);out():預算用完了沒——每一行之前都看,
 26846	    用完了剩下的行記成超過預算(代碼審 r3 併發席:原本整段不看預算)。"""
 26847	    base_lines, todo, unknown = {}, [], []
 26848	
 26849	    def _names():
 26850	        return None if tip_tree is None else tip_tree.names_in(ch["code_touched"])
 26851	    for p, no, tx, pr in lines:
 26852	        if out():
 26853	            unknown.append(f"{p}:{no} 的條件判不了(超過預算)")
 26854	            continue
 26855	        old = _drift_probe_old(p, pr, ch["renames"], benv, pre, base_lines)
 26856	        cand = _drift_probe_is_candidate(pr["conds"], ch, pre, tenv, _names) if old else True
 26857	        if cand is None:
 26858	            unknown.append(f"{p}:{no} 的條件判不了(" + ("超過預算" if out() else
 26859	                           "git 讀不出這次改到的程式檔" + _drift_bad_note(_drift_row_unread(pr["conds"], (), (tip_tree,)))) + ")")
 26860	        elif cand:
 26861	            todo.append((p, no, tx, pr, old))
 26862	    return todo, unknown
 26863	
