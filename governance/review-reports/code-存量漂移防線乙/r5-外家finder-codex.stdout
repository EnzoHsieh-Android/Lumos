 52914	def t_drift_code_review_yi_r3_regressions():
 52915	    """乙代碼審 r3 折入的回歸釘(存量漂移防線,條件式回頭條件第二次修正差異)。每條 check 名後面括號是對應的發現。
 52916	
 52917	    翻紅釘:讀檔改回「版本:路徑」→ A1、A2、A3 紅;判不了不點名檔 → A4 紅;候選迴圈不看預算 → B1 紅;
 52918	    名稱改回對全文跑正則 → B2 紅;候選遇到判不了就停 → B3 紅;3.12 以前不先量最長邏輯行 → C1 紅;
 52919	    版面改變不算形狀改變 → D1 紅;反斜線不先轉斜線 → D2 紅;check 拿存下的值重驗 → D3 紅;--budget 不設上限 → E1 紅;
 52920	    副檔名規則改回字母數字 → E2 紅;候選判不了不記 → F1 紅;語料有讀不出的檔當成不成立 → F2 紅。
 52921	    """
 52922	    print("t_drift_code_review_yi_r3_regressions")
 52923	    import subprocess as sp, time as _time
 52924	    m = _load_lumos_inproc()
 52925	    V = "docs/kg-knowledge"
 52926	    by = "[by:2099-12-31]"
 52927	
 52928	    def _add_raw(root, raw_path, content):
 52929	        """用 git 原樣路徑存一支檔(不經檔案系統,檔名寫法不被改)。"""
 52930	        blob = sp.run(["git", "-C", str(root), "hash-object", "-w", "--stdin"], input=content,
 52931	                      capture_output=True, text=True).stdout.strip()
 52932	        sp.run(["git", "-C", str(root), "-c", "core.precomposeunicode=false", "update-index", "--add", "--cacheinfo",
 52933	                f"100644,{blob},{raw_path}"], capture_output=True)
 52934	
 52935	    # ── A 用內容編號讀:檔名寫法怪的照讀得到 ──
 52936	    root = _dr_repo(cfg={"drift_check": {"gate": "block"}})
 52937	    compat = "src/豈文.py"                                   # 相容表意字,NFC 與 NFD 都會把它換掉
 52938	    mixed = "café/café.py"                             # 資料夾組合字、檔名分解字
 52939	    _add_raw(root, compat, "def compat_fn():\n    pass\n")
 52940	    _add_raw(root, mixed, "def mixed_fn():\n    pass\n")
