 27799	def _note_audit_doctor_lines(repo_root, vault, ci=False):
 27800	    """doctor 的筆記內容審提醒(計劃 S16):開關不是 block、專案 CI 沒呼叫 note-audit check(跳過註解行)、
 27801	    事後掃描遠端頂端沒被涵蓋的新增筆記行、主線歷史裡判定檔被刪過幾次。"""
 27802	    out = []
 27803	    root = Path(repo_root)
 27804	    cp = root / ".lumos" / "config.json"
 27805	    txt = None
 27806	    try:
 27807	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 27808	            txt = cp.read_bytes()
 27809	    except OSError:
 27810	        txt = None
 27811	    mode, _w = _note_audit_config(txt)
 27812	    if mode != "block":
 27813	        out.append(f"這個專案把「筆記內容審」設成 {mode}(.lumos/config.json 的 note_audit.gate)——新寫的筆記不會被判定者審")
 27814	    wf = root / ".github" / "workflows"
 27815	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 27816	    hk = _lens_git(root, "show", f"HEAD:{_NOTELINES_PREPUSH}")
 27817	    wired = hk is not None and hk.returncode == 0 and _NOTE_AUDIT_GOLIVE_MARK in hk.stdout
 27818	    body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
 27819	    shallow = _ci_jobs_calling_without_full_history(ymls, "note-audit check")
 27820	    if shallow:
 27821	        out.append("專案 CI 呼叫了 note-audit check,但那個工作項目沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過——"
 27822	                   + _ci_jobs_list(shallow))
 27823	    if ymls and wired:          # 還沒接線(推送前掛鉤裡沒有這道)就不唸 CI 沒呼叫——接線前這道本來就不擋
 27824	        if "note-audit check" not in body:
 27825	            out.append("專案 CI 沒呼叫 `lumos note-audit check`,`--no-verify` 推上去的筆記沒人審——CI 在 note-shape 那步後面加:"
 27826	                       "\n    - run: python3 scripts/lumos note-audit check --diff \"${{ github.event.before || "
 27827	                       "'0000000000000000000000000000000000000000' }}..${{ github.sha }}\"" + _CI_PY314_NOTE)
 27828	    if ci:
 27829	        return out
 27830	    ml = _mainline_ref(root, remote_only=True)
 27831	    # 刪除次數從遠端頂端讀(計劃〈做法〉第 3 節第 9 點;代碼審 r1 正確性席:讀本機 HEAD 會把還沒推的實驗算進去)
 27832	    dl = _lens_git(root, "log", "--diff-filter=D", "--format=%H", "--name-only", ml[1], "--", _NOTE_AUDIT_VERDICT_DIR) if ml else None
 27833	    if dl is not None and dl.returncode == 0:
 27834	        n = sum(1 for x in dl.stdout.splitlines() if x.startswith(_NOTE_AUDIT_VERDICT_DIR + "/"))
 27835	        if n:
 27836	            out.append(f"主線歷史裡判定檔被刪過 {n} 次(筆記內容審只防疏忽,刪判定檔屬存心繞過;這個數給 RETIRE-IF 看)")
 27837	    gl = _nodehome_golive(root, ml[1], _NOTE_AUDIT_GOLIVE_MARK, _NOTELINES_PREPUSH) if ml else None
 27838	    if not ml or gl is None:
 27839	        return out
 27840	    try:
 27841	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 27842	    except ValueError:
 27843	        return out
 27844	    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{ml[1]}")
 27845	    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
 27846	    base = gl
 27847	    if capped:
 27848	        rl = _lens_git(root, "rev-list", f"--max-count={_NS_DOCTOR_SCAN_CAP}", f"{gl}..{ml[1]}")
 27849	        tail = rl.stdout.split()[-1] if rl is not None and rl.returncode == 0 and rl.stdout.split() else None
 27850	        if tail:
 27851	            b2 = _lens_full_sha(root, f"{tail}~1")
 27852	            base = b2 or gl
 27853	        out.append(f"(筆記內容審的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交)")
 27854	    got = _note_audit_items(root, base, ml[1], vault_rel)
 27855	    if got is None:
 27856	        return out
 27857	    items, _e = got
 27858	    docs, _b = _note_audit_load_verdicts(root, ml[1])
 27859	    fold = _note_audit_fold(docs)
 27860	    left = [it for it in items if not _note_audit_covered(fold.get(it["id"]))]
 27861	    if left:
 27862	        shown = "; ".join(f"{it['path']}:{it['line']}" for it in left[:10])
 27863	        out.append(f"已推上遠端({ml[0]})卻沒被筆記內容審涵蓋的新增筆記行 {len(left)} 行(多半是 --no-verify 或 warn 期間):{shown}")
 27864	    return out
