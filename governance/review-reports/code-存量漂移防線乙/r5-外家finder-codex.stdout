 27731	def _ci_workflow_texts(ymls):
 27732	    """CI 設定檔 → [(路徑, 去掉註解後的行)]:整行註解拿掉、行尾註解(後面沒有引號的 ` #…`)切掉;讀不了的檔跳過。
 27733	    兩層 doctor 都經這裡讀,容錯跟「哪些算註解」只有一份(筆記內容審代碼審 r3 架構對齊席、通才席)。"""
 27734	    out = []
 27735	    for p in ymls:
 27736	        try:
 27737	            raw = p.read_text(encoding="utf-8", errors="replace")
 27738	        except OSError:
 27739	            continue
 27740	        out.append((p, [_ci_strip_comment(ln) for ln in raw.split("\n") if not ln.lstrip().startswith("#")]))
 27741	    return out
 27742	
 27743	
 27744	def _ci_jobs_calling_without_full_history(ymls, needle):
 27745	    """GitHub Actions 設定裡,呼叫 needle 的工作項目中,沒設 fetch-depth: 0 的那些 → [(檔名, 工作項目名)]。
 27746	    照工作項目切,不看整份:別的工作項目設了完整歷史,不代表呼叫這道檢查的那個有(筆記內容審代碼審 r2 外家席)。
 27747	    工作項目=jobs: 底下第一層縮排的每一個鍵(名字可加引號、行尾可帶註解;代碼審 r3 兩席:原本只認不帶引號、
 27748	    冒號後什麼都沒有的鍵,合法寫法就會漏)。"""
 27749	    out = []
 27750	    for p, lines in _ci_workflow_texts(ymls):
 27751	        jobs, cur, jind, in_jobs = {}, None, None, False
 27752	        for ln in lines:
 27753	            if not ln.strip():
 27754	                continue
 27755	            ind = len(ln) - len(ln.lstrip(" "))
 27756	            if ind == 0:
 27757	                in_jobs = bool(re.match(r"^jobs\s*:\s*$", ln))
 27758	                jind, cur = None, None
 27759	                continue
 27760	            if not in_jobs:
 27761	                continue
 27762	            if jind is None:
 27763	                jind = ind
 27764	            if ind == jind:
 27765	                m = re.match(r"^\s+([\"']?)(.+?)\1\s*:", ln)
 27766	                cur = m.group(2) if m else ln.strip()
 27767	                jobs.setdefault(cur, [])
 27768	                continue
 27769	            if cur is not None:
 27770	                jobs[cur].append(ln)
 27771	        for name, body in jobs.items():
 27772	            if needle in "\n".join(body) and not _ci_has_full_history(body):
 27773	                out.append((p.name, name))
 27774	    return out
 27775	
 27776	
 27777	def _ci_has_full_history(body):
 27778	    """工作項目裡有沒有 `fetch-depth: 0` 這個設定——只認設定行本身,多行腳本(`run: |`)裡剛好出現的字樣不算
 27779	    (驗收輪外家席:腳本裡 echo 那串字就被當成抓了完整歷史)。"""
 27780	    blk = None
 27781	    for ln in body:
 27782	        ind = len(ln) - len(ln.lstrip(" "))
 27783	        if blk is not None:
 27784	            if ind > blk:
 27785	                continue
 27786	            blk = None
 27787	        if re.search(r":\s*[|>][-+0-9]*\s*$", ln):
 27788	            blk = ind
 27789	            continue
 27790	        if re.match(r"^\s*(?:-\s+)?fetch-depth\s*:\s*[\"']?0[\"']?\s*$", ln):
 27791	            return True
 27792	    return False
 27793	
