   411	_SINGLE_WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")   # 整個值恰好是一個連結(fullmatch 用;讀側索引與寫側判斷共用)
   412	
   413	
   414	def _multi_link_value(s):
   415	    """清單欄位的一個值裡有兩個以上連結開頭——一項只能是一個連結或一個值。
   416	    讀的一側(parse_frontmatter 的 lint)與寫的一側(_list_scalar_value)共用這一個判斷(2026-09-10 代碼審 r3 架構席:
   417	    原本讀側只認 `]], [[` 與 `]],[[`,寫側看兩個以上 [[,`[[A]],  [[B]]` 讀側不吭聲、寫側卻擋)。
   418	    只用在清單欄位:散文欄位(例如 valid_under)講到兩個連結是正常的。"""
   419	    return str(s).count("[[") > 1
   420	
   421	
   422	def link_target(s):
   423	    """從 wikilink 字串/list 項抽**完整 target**(去 [[]]、alias、heading、引號;**保留路徑**)。
   424	    `[[Verification/X|y]]` → `Verification/X`。寫側 dedup 用它做精確比對:
   425	    既修子字串誤判(A vs A_v2 不同),又不像 basename-only 把跨資料夾 Systems/X vs
   426	    Verification/X 誤判相同(2026-06-13 第二輪審計 NEW-A)。"""
   427	    t = strip_quotes(str(s).strip())
   428	    t = t.replace("[[", "").replace("]]", "")
   429	    t = t.split("|")[0].split("#")[0].strip()
   430	    if t.lower().endswith(".md"):
   431	        t = t[:-3]
   432	    return nfc(t)
   433	
   434	
   435	def split_frontmatter(text):
   436	    """回傳 (fm_lines or None, body)"""
   437	    if not text.startswith("---"):
   438	        return None, text
   439	    lines = text.split("\n")
   440	    for i in range(1, len(lines)):
   441	        if lines[i].strip() == "---":
   442	            return lines[1:i], "\n".join(lines[i + 1:])
   443	    return None, text
   444	
   445	
   446	def parse_frontmatter(fm_lines):
   447	    """極簡 parser(本 vault 慣例範圍): top-level 純量 + 字串 list + block scalar 內文。
   448	    回傳 (fields, block_keys, lint)
   449	      fields: dict[key] = str | list[str];block scalar 的 key 也存內文(供 context 用)
   450	      block_keys: block scalar 的 key 集合(其值內的 [[..]] 不得索引,鐵則 2)
   451	      lint: 鐵則指紋發現
   452	    """
   453	    fields, block_keys, lint = {}, set(), []
   454	    seen = set()
   455	    i, n = 0, len(fm_lines)
   456	    while i < n:
   457	        line = fm_lines[i]
   458	        m = TOP_KEY_RE.match(line)
   459	        if not m:
   460	            i += 1
   461	            continue
   462	        key, val = m.group(1), m.group(2).strip()
   463	        if key in seen:
   464	            lint.append(f"同一層欄位名重複,工具不知道該信哪個: {key}")
   465	        seen.add(key)
   466	        if val in ("|", "|-", ">", ">-"):
   467	            block = []
   468	            i += 1
   469	            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
   470	                if fm_lines[i].strip():
   471	                    block.append(fm_lines[i].strip())
   472	                i += 1
   473	            fields[key] = "\n".join(block)
   474	            block_keys.add(key)
   475	            continue
   476	        if val == "":
   477	            items = []
   478	            i += 1
   479	            while i < n:
   480	                l2 = fm_lines[i]
   481	                if not l2.strip():
   482	                    i += 1
   483	                    continue
   484	                if not l2.startswith(" "):
   485	                    break
   486	                ms = LIST_ITEM_RE.match(l2)
   487	                if ms:
   488	                    item = strip_quotes(ms.group(1).strip())
   489	                    items.append(item)
   490	                    if "]], [[" in item or "]],[[" in item or (key in LIST_KEYS and _multi_link_value(item)):
   491	                        lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key} 項")
   492	                if RULE3_RE.match(l2):
   493	                    lint.append(f"欄位值裡有「冒號+空白」又沒加引號,讀出來會被切斷,整個值請用引號包起來: {l2.strip()[:60]}")
   494	                i += 1
   495	            fields[key] = items
   496	            continue
   497	        sval = strip_quotes(val)
   498	        if sval == "[]":  # 行內空列表(YAML flow style)
   499	            fields[key] = []
   500	            i += 1
   501	            continue
   502	        fields[key] = sval
   503	        if "]], [[" in sval or "]],[[" in sval or (key in LIST_KEYS and _multi_link_value(sval)):
   504	            lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key}")
   505	        i += 1
   506	    for line in fm_lines:
   507	        if QUOTED_DATE_RE.match(line):
   508	            lint.append(f"日期加了引號會被當成文字、排序比較都失效,引號拿掉: {line.strip()}")
   509	    return fields, block_keys, lint
   510	
   511	
   512	def extract_targets(text):
   513	    out = []
   514	    for raw in WIKILINK_RE.findall(text):
   515	        t = raw.split("|")[0].split("#")[0].strip()
   516	        if t:
   517	            out.append(nfc(t))
   518	    return out
   519	
   520	
   521	class Note:
   522	    __slots__ = ("rel", "stem", "fields", "block_keys", "fm_lines",
   523	                 "targets", "lint", "mtime")
   524	
   525	
   526	def load_vault(vault: Path):
   527	    notes = {}
   528	    for p in sorted(vault.rglob("*.md")):
   529	        rel = nfc(p.relative_to(vault).as_posix())
   530	        try:
   531	            mtime = p.stat().st_mtime
   532	            text = p.read_text(encoding="utf-8-sig")  # -sig: BOM 檔也偵測得到 frontmatter
   533	        except Exception as e:
   534	            n = Note()
   535	            n.rel, n.stem = rel, nfc(p.stem)
   536	            n.fields, n.block_keys, n.fm_lines = {}, set(), []
   537	            n.targets, n.lint, n.mtime = [], [f"{_READ_FAIL}: {e}"], 0
   538	            notes[rel] = n
   539	            continue
   540	        notes[rel] = _note_from_text(rel, text, mtime)
   541	    return notes
   542	
   543	
   544	_READ_FAIL = "讀檔失敗"      # 讀不進來的筆記在 Note.lint 的前綴:磁碟(load_vault)與提交的樹(Env.from_texts)共用這一個管道
   545	
   546	
   547	def _note_unreadable(n):
   548	    return any(str(x).startswith(_READ_FAIL) for x in (n.lint or []))
   549	
   550	
   551	def _note_from_text(rel, text, mtime=0):
   552	    """一篇筆記的文字 → Note。load_vault 與「某個提交的樹」共用(存量漂移防線_計劃:狀態一致檢查要能跑在
   553	    任一提交上,不另寫第二套解析)。"""
   554	    n = Note()
   555	    n.rel = rel
   556	    n.stem = nfc(rel.rsplit("/", 1)[-1][:-3] if rel.endswith(".md") else rel.rsplit("/", 1)[-1])
   557	    n.mtime = mtime
   558	    fm_lines, body = split_frontmatter(text)
   559	    if fm_lines is not None:
   560	        fields, block_keys, lint = parse_frontmatter(fm_lines)
   561	    else:
   562	        fm_lines, fields, block_keys, lint = [], {}, set(), []
   563	    body_clean = _strip_code_text(body)   # ★不可換回 FENCE_RE:看不見未閉合圍欄→幽靈邊★
   564	    # frontmatter 連結規則(對齊 Obsidian): 整個值恰為一個 wikilink 才索引,
   565	    # 夾在散文中間的 [[..]] 不算;block scalar 整段排除(鐵則 2)
   566	    fm_targets = []
   567	    for key, v in fields.items():
   568	        if key in block_keys:
   569	            continue
   570	        for item in (v if isinstance(v, list) else [v]):
   571	            s = str(item).strip()
   572	            fm = _SINGLE_WIKILINK_RE.fullmatch(s)
   573	            if fm:
   574	                t = fm.group(1).split("|")[0].split("#")[0].strip()
   575	                if t:
   576	                    fm_targets.append(nfc(t))
   577	    n.fields = fields
   578	    n.block_keys = block_keys
   579	    n.fm_lines = fm_lines
   580	    n.targets = extract_targets(body_clean) + fm_targets
   581	    n.lint = lint
   582	    return n
   583	
   584	
   585	def build_index(notes):
   586	    by_stem = defaultdict(list)
   587	    for rel, n in notes.items():
   588	        by_stem[n.stem.lower()].append(rel)
   589	    return by_stem
   590	
   591	
   592	def make_resolver(notes, by_stem):
   593	    rels = set(notes)
   594	
   595	    def resolve(target):
   596	        t = target
   597	        if t.lower().endswith(".md"):
   598	            t = t[:-3]
   599	        if "/" in t:
   600	            cand = t + ".md"
   601	            if cand in rels:
   602	                return cand
   603	            t = t.rsplit("/", 1)[1]
   604	        hits = by_stem.get(t.lower())
   605	        if hits:
   606	            return hits[0]
   607	        return None
   608	
   609	    return resolve
   610	
   611	
   612	def as_list(v):
   613	    if v is None:
   614	        return []
   615	    if isinstance(v, list):
   616	        return [str(x) for x in v]
   617	    return [str(v)]
   618	
   619	
   620	class Env:
   621	    def __init__(self, vault):
   622	        self.vault = vault
   623	        self.notes = load_vault(vault)
   624	        self.by_stem = build_index(self.notes)
   625	        self.resolve = make_resolver(self.notes, self.by_stem)
   626	        self._edges = None
   627	        self._texts = None
   628	
   629	    @classmethod
   630	    def from_texts(cls, vault, texts, unreadable=()):
   631	        """{圖譜內相對路徑: 全文} → 只在記憶體裡的 Env(某個提交的樹、或考試時改過狀態的樹)。
   632	        讀全文用 env_text,不要自己開檔——這種 Env 的檔不在磁碟上。unreadable=解不開的路徑:照 load_vault 讀檔失敗的
   633	        做法建成 lint 帶「讀檔失敗」的空筆記(代碼審 r3 架構對齊席:同一件事不另開第二個管道)。"""
   634	        self = cls.__new__(cls)
   635	        self.vault = vault
   636	        self._texts = {nfc(r): t for r, t in texts.items()}
   637	        # 照路徑逐層排序,跟 load_vault 的 Path 排序一致(代碼審 r1 正確性席:整串字串排序時 Projects-old/X
   638	        # 會排在 Projects/X 前面,同名筆記在磁碟與樹上解到不同篇)
   639	        notes = {r: _note_from_text(r, t) for r, t in self._texts.items()}
   640	        for r in unreadable:
   641	            n = Note()
   642	            n.rel, n.stem, n.mtime = nfc(r), nfc(r.rsplit("/", 1)[-1][:-3]), 0
   643	            n.fields, n.block_keys, n.fm_lines, n.targets, n.lint = {}, set(), [], [], [f"{_READ_FAIL}: 不是 UTF-8"]
   644	            notes[n.rel] = n
   645	        self.notes = dict(sorted(notes.items(), key=lambda kv: kv[0].split("/")))
   646	        self.by_stem = build_index(self.notes)
   647	        self.resolve = make_resolver(self.notes, self.by_stem)
   648	        self._edges = None
   649	        return self
   650	
   651	    @property
   652	    def edges(self):
   653	        if self._edges is None:
   654	            out_e, in_e = defaultdict(list), defaultdict(list)
   655	            for rel, n in self.notes.items():
   656	                seen = set()
   657	                for t in n.targets:
   658	                    d = self.resolve(t)
   659	                    if d and d != rel and d not in seen:
   660	                        seen.add(d)
   661	                        out_e[rel].append(d)
   662	                        in_e[d].append(rel)
   663	            self._edges = (out_e, in_e)
   664	        return self._edges
   665	
   666	    def find(self, arg):
   667	        """以 stem 或相對路徑找筆記,回傳 rel 或 None"""
   668	        a = nfc(arg.strip())
   669	        if a.lower().endswith(".md"):
   670	            a = a[:-3]
   671	        if "/" in a and (a + ".md") in self.notes:
   672	            return a + ".md"
   673	        hits = self.by_stem.get(a.rsplit("/", 1)[-1].lower())
   674	        if hits:
   675	            if len(hits) > 1:
   676	                print(f"⚠ 同名筆記 {len(hits)} 個,取第一個: {hits[0]}", file=sys.stderr)
   677	            return hits[0]
   678	        return None
   679	
   680	
   681	def env_text(env, rel):
   682	    """一篇筆記的全文:記憶體裡的 Env 從記憶體拿,一般的從磁碟讀。讀不到回 None。"""
   683	    t = getattr(env, "_texts", None)
   684	    if t is not None:
   685	        return t.get(rel)
   686	    try:
   687	        return (env.vault / rel).read_text(encoding="utf-8-sig")
   688	    except (OSError, UnicodeDecodeError):
   689	        return None
   690	
   691	
   692	def first_line(s, width=72):
   693	    s = (s or "").strip().split("\n")[0]
   694	    return s if len(s) <= width else s[:width] + "…"
   695	
   696	
   697	def status_of(env, rel):
   698	    v = env.notes[rel].fields.get("status", "")
   699	    return v if isinstance(v, str) else ""
   700	
   701	
   702	TYPED_EDGE_FIELDS = ("verified_by", "plan_refs", "related")
   703	
   704	
   705	def build_typed_index(env):
   706	    """[M2/P0] typed-edge 反向索引——從 frontmatter 具名欄位(verified_by/plan_refs/related)建
   707	    「每節點 ← 誰、以哪種邊型指向我」。補 Env.edges 無型別的洞(建圖層以 target 去重丟來源欄位)。
   708	    每次呼叫現建現用(天生新鮮、無持久化=無腐爛)。合約(關係層主網 M2):
   709	    - 只索引「整個值恰為一個 wikilink」(沿 load_vault fm_targets 規則);殘留 scalar → scalars
   710	      warnings、不進索引(不靜默納入)。block scalar 欄位整段排除(鐵則 2)。

