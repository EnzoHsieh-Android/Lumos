 26919	def _drift_probe_judge(now_of, was_of, pr, old):
 26920	    """一條候選 → 要處理的原因字串 / ""(不列) / None(判不了)。終點成立,而起點沒有同一條或同一條還不成立 → 要處理。
 26921	    now_of / was_of:條件 → 終點 / 起點的判定(起點只在有同一條時才問)。"""
 26922	    conds = tuple(pr["conds"])
