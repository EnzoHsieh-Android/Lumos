+def _ngl_last_reason(r, plan="甲_計劃"):
+    """推送前擋下時,點名這份計劃的那一行(給斷言看擋下的理由,不讓別的計劃或別道檢查代打)。"""
+    return next((x for x in r.stdout.splitlines() if plan in x and "輕量設計審" in x), "")
