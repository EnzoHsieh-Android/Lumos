+def t_door_rule_fingerprint_covers_nogo():
+    """[規格閘不做節 S6] 同一個程序裡把 _NOGO_H2_RE / _NOGO_ITEM_RE 換掉、或把 _nogo_skip_lines 換成另一個函式 → 門判定規則輸入指紋跟著變。"""
+    import re as _re
+    m = _load_lumos_module()
+    base = m._door_rule_fingerprint()
+    for name in ("_NOGO_H2_RE", "_NOGO_ITEM_RE"):
+        old = getattr(m, name, None)
+        setattr(m, name, _re.compile(r"^換掉了$"))
+        try:
+            check(f"① 換掉 {name}:真的換到了、指紋變了", getattr(m, name).pattern == r"^換掉了$" and m._door_rule_fingerprint() != base, name)
+        finally:
+            setattr(m, name, old)
+        check(f"② 換回 {name} → 指紋回原值", m._door_rule_fingerprint() == base, name)
+    old = getattr(m, "_nogo_skip_lines", None)
+
+    def _other_skip(text):
+        return set()
+    m._nogo_skip_lines = _other_skip
+    try:
+        check("③ 換掉 _nogo_skip_lines:真的換到了、指紋變了", m._nogo_skip_lines is _other_skip and m._door_rule_fingerprint() != base, "")
+    finally:
+        m._nogo_skip_lines = old
+    check("④ 換回 → 指紋回原值", m._door_rule_fingerprint() == base, "")
