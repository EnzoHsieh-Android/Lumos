+    check("⓪ 前置:乾淨環境下 GIT_DIFF_OPTS=-u0 真的蓋掉 -U3(前後文行不見)", "第 9 行" in raw({}) and "第 9 行" not in raw({"GIT_DIFF_OPTS": "-u0"}),
