+        run(kg, "spec-gate", f"Projects/{nm}_計劃", expect_rc=0)
+    _sg_commit(d, "plans")
+    (d / "tests" / "flip.ok").write_text("")
+    for nm, p in plans.items():
+        snap = _ngl_freeze(p, "same")
