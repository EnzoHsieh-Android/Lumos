+                         "a=argparse.ArgumentParser(add_help=False);a.add_argument('--out');v,_=a.parse_known_args()\n"
+                         f"Path({str(started)!r}).write_text(str(os.getpid()))\n"
+                         "time.sleep(0.5)\n"
+                         "Path(v.out).write_text(json.dumps({'arm':'with','results':[{'id':'a','passed':True}],"
