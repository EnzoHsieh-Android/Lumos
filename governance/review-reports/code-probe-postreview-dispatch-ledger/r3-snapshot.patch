+        parent_code = ("import importlib.util\nfrom pathlib import Path\n"
+                       f"s=importlib.util.spec_from_file_location('ablation_kill',{str(runner)!r})\n"
+                       "m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\n"
