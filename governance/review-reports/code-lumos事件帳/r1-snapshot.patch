+# ── Lumos 事件帳(Projects/Lumos事件帳_計劃):讀取端 ──────────────────────
+# 寫入端是 Claude Code 的 mod(mods/claude/lumos-ledger),每個會談一個資料夾、每次寫一個新塊檔;
+# 這裡只讀。事件帳跟 hook-events.jsonl 是兩本帳:那本記「lumos 的 hook 自己有沒有跑」,這本記「AI 做了什麼」。
+_EVENTS_REL = Path("governance") / "runtime" / "events"
+
+
+def _events_root(root):
+    """事件帳一律寫在主 checkout:在 worktree 裡跑也要讀主 checkout 那份。
+    git-common-dir 是名叫 .git 的資料夾時取上一層;git 失敗、逾時、找不到都退回 root。"""
+    root = Path(root)
+    try:
+        r = _testmap_git(root, ["rev-parse", "--path-format=absolute", "--git-common-dir"], timeout=3)
+        if r.returncode == 0:
+            common = Path(r.stdout.strip())
+            if common.name == ".git" and common.parent.is_dir():
+                return common.parent
+    except (subprocess.TimeoutExpired, OSError):
+        pass
+    return root
+
+
+def _events_read(root, session):
+    """讀一個會談的事件:塊檔依檔名排序、塊內照行序;壞行與版本不是 1 的行各自計數後略過。"""
+    import json as _j
+    d = _events_root(root) / _EVENTS_REL / session
+    out = {"events": [], "bad": 0, "unknown_version": 0}
+    if not d.is_dir() or d.is_symlink():
+        return out
+    for f in sorted(p for p in d.glob("*.jsonl") if p.is_file()):
+        for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
+            if not line.strip():
+                continue
+            try:
+                ev = _j.loads(line)
+            except ValueError:
+                out["bad"] += 1
+                continue
+            if not isinstance(ev, dict):
+                out["bad"] += 1
+            elif ev.get("v") != 1:
+                out["unknown_version"] += 1
+            else:
+                out["events"].append(ev)
+    return out
+
+
+def _events_sessions(root, limit=10):
+    """最近的會談:只看會談資料夾的修改時間排序,只讀前 limit 個的塊檔。"""
+    base = _events_root(root) / _EVENTS_REL
+    if not base.is_dir():
+        return []
+    dirs = [p for p in base.iterdir() if p.is_dir() and not p.is_symlink()]
+    dirs.sort(key=lambda p: p.stat().st_mtime, reverse=True)
+    rows = []
+    for p in dirs[:limit]:
+        r = _events_read(root, p.name)
+        evs = r["events"]
+        rows.append({"session": p.name,
+                     "last": evs[-1].get("ts") if evs else None,
+                     "turns": sum(1 for e in evs if e.get("ev") == "turn_end"),
+                     "tools": sum(1 for e in evs if e.get("ev") == "tool"),
+                     "failed": sum(1 for e in evs if e.get("ev") == "tool" and e.get("ok") is False)})
+    return rows
+
+
+def _events_repo_root(repo):
+    base = Path(repo) if repo else Path.cwd()
+    try:
+        r = _testmap_git(base, ["rev-parse", "--show-toplevel"], timeout=3)
+        if r.returncode == 0 and r.stdout.strip():
+            return Path(r.stdout.strip())
+    except (subprocess.TimeoutExpired, OSError):
+        pass
+    return base
+
+
+def _events_prune(base, days):
+    """刪掉早於 days 天的會談資料夾(看資料夾與裡面塊檔最新的修改時間)。呼叫端保證 days >= 1,
+    所以最近 24 小時內動過的會談(正在寫的)天然落在保留範圍,不另設一道判斷;
+    符號連結不跟也不刪;只動 base 的直接子資料夾。回刪掉的會談編號。
+    為什麼不像 _note_audit_work_dir 在寫入端自動清:寫入端是 mod,mod 的檔案介面沒有刪除功能。"""
+    import shutil
+    import time as _t
+    now = _t.time()
+    cutoff = now - days * 86400
+    removed = []
+    if not base.is_dir() or base.is_symlink():
+        return removed
+    for d in sorted(base.iterdir()):
+        if d.is_symlink() or not d.is_dir():
+            continue
+        newest = max([d.stat().st_mtime] + [f.stat().st_mtime for f in d.iterdir() if not f.is_symlink()])
+        if newest >= cutoff:
+            continue
+        shutil.rmtree(d)
+        removed.append(d.name)
+    return removed
+
