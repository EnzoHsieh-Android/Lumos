+def _claude_json(claude, args):
+    import json as _j
+    r = subprocess.run([claude] + args, capture_output=True, check=False, text=True, timeout=30)
+    if r.returncode != 0:
+        raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[0] if (r.stderr or r.stdout).strip() else f"rc={r.returncode}")
+    return _j.loads(r.stdout or "[]")
