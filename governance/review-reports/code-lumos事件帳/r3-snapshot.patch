+def _with_env(env, fn, drop=("LUMOS_SKIP_CLAUDE_PLUGIN",)):
+    """跟本檔其他測試同一種換環境變數寫法(unittest.mock.patch.dict,離開時整份還原)。"""
+    import os
+    from unittest import mock
+    with mock.patch.dict(os.environ, env):
+        for k in drop:
+            os.environ.pop(k, None)
+        return fn()
