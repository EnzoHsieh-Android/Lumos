+    再把 _PATH_SPECIAL_CATS 那幾類(控制、格式含雙向覆寫與零寬、行與段分隔、孤立代理)換空格——
+    事件帳內容可能被人強制提交進 repo;孤立代理字元印到 UTF-8 終端還會直接丟編碼錯誤(代碼審 r2)。"""
+    return "".join(" " if unicodedata.category(ch) in _PATH_SPECIAL_CATS else ch for ch in _esc_clean(text, 2000))
+
+
+def _events_read(root, session, base=None):
+    """讀一個會談的事件:塊檔依檔名排序、塊內照行序;壞行與版本不是 1 的行各自計數後略過。
+    只認 \n 斷行:JSON 字串裡可能有 U+2028 / U+0085,splitlines() 會在那裡切斷、把一筆事件變兩行壞行。"""
+    import json as _j
+    d = (base if base is not None else _events_root(root) / _EVENTS_REL) / session
+    out = {"events": [], "bad": 0, "unknown_version": 0}
+    if not d.is_dir() or d.is_symlink():
+        return out
+    for f in sorted(p for p in d.glob("*.jsonl") if p.is_file() and not p.is_symlink()):   # 不跟連結(與 prune 一致)
+        try:
+            text = f.read_text(encoding="utf-8", errors="replace")
+        except OSError:                     # 讀的同時被 prune 刪掉
+            continue
+        for line in text.split("\n"):
+            if not line.strip():
+                continue
+            try:
+                ev = _j.loads(line)
+            except (ValueError, RecursionError):   # 極深巢狀的一行會把解析器的遞迴吃光
+                out["bad"] += 1
+                continue
+            if not isinstance(ev, dict):
+                out["bad"] += 1
+            elif type(ev.get("v")) is not int or ev.get("v") != 1:   # true 與 1.0 在 Python 都等於 1
+                out["unknown_version"] += 1
+            else:
+                out["events"].append(ev)
+    return out
+
+
+def _events_sessions(root, limit=10):
+    """最近的會談:只看會談資料夾的修改時間排序,只讀前 limit 個的塊檔。"""
+    base = _events_root(root) / _EVENTS_REL
+    if not base.is_dir():
+        return []
+    def mtime(p):
+        try:
+            return p.stat().st_mtime
+        except OSError:
+            return 0
+    dirs = [p for p in base.iterdir() if p.is_dir() and not p.is_symlink()]
+    dirs.sort(key=mtime, reverse=True)
+    rows = []
+    for p in dirs[:limit]:
+        r = _events_read(root, p.name, base=base)
+        evs = r["events"]
+        rows.append({"session": p.name,
+                     "last": evs[-1].get("ts") if evs else None,
+                     "turns": sum(1 for e in evs if e.get("ev") == "turn_end"),
+                     "tools": sum(1 for e in evs if e.get("ev") == "tool"),
+                     "failed": sum(1 for e in evs if e.get("ev") == "tool" and e.get("ok") is False)})
+    return rows
+
+
+def _events_prune(base, days):
+    """刪掉早於 days 天的會談資料夾(看資料夾與裡面塊檔最新的修改時間)。呼叫端保證 days >= 1,
+    所以最近 24 小時內動過的會談(正在寫的)天然落在保留範圍,不另設一道判斷;
+    符號連結不跟也不刪;只動 base 的直接子資料夾。回刪掉的會談編號。
+    為什麼不像 _note_audit_work_dir 在寫入端自動清:寫入端是 mod,mod 的檔案介面沒有刪除功能。"""
+    import shutil
+    import time as _t
+    now = _t.time()
+    cutoff = now - days * 86400
+    removed, failed = [], []
+    if not base.is_dir() or base.is_symlink():
+        return removed, failed
+    for d in sorted(base.iterdir()):
+        if d.is_symlink() or not d.is_dir():
+            continue
+        try:                                # 寫入端同時在寫:檔案可能剛出現或剛被改名
+            newest = max([d.stat().st_mtime] + [f.stat().st_mtime for f in d.iterdir() if not f.is_symlink()])
+            if newest >= cutoff:
+                continue
+            shutil.rmtree(d)
+            removed.append(d.name)
+        except OSError:
+            failed.append((d.name, d.exists() and any(True for _ in _safe_iterdir(d))))
+    return removed, failed
+
+
+def _safe_iterdir(d):
+    try:
+        yield from d.iterdir()
+    except OSError:
+        return
+
+
+def _events_main_trusted(root, main_root):
+    """root 是主 checkout 本身,或主 checkout 真的登記過的 worktree(它的 .git/worktrees/*/gitdir 指回 root/.git)
+    才算可信——.git 檔可以被人改成指到別的 repo,不驗就會把清理導到別人的事件帳(代碼審 r2 資安席)。"""
+    root, main_root = Path(root).resolve(), Path(main_root).resolve()
+    if root == main_root:
+        return True
+    try:
+        for g in (main_root / ".git" / "worktrees").glob("*/gitdir"):
+            if Path(g.read_text(encoding="utf-8").strip()).resolve() == root / ".git":
+                return True
+    except OSError:
+        return False
+    return False
+
+
+def _events_path_safe(root, base):
+    """事件帳路徑從 repo 根往下每一層都不能是符號連結:陌生 repo 可以把 governance 或 runtime 做成連結,
+    把清理導到 repo 外的資料夾。"""
+    p = Path(root)
+    for part in _EVENTS_REL.parts:
+        p = p / part
+        if p.is_symlink():
+            return False
+    return Path(base).resolve().is_relative_to(Path(root).resolve())
+
+
