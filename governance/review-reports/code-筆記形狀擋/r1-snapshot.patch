+_NS_STRUCT_KEY_RE = re.compile(r"^\s*(?:-\s+)?(id|decided|valid|superseded_by|ended|decided_by|replaces)\s*:")
+_NS_TOPKEY_RE = re.compile(r"^([A-Za-z_][\w-]*)\s*:")
+
+
+def _pin_commit(repo_root, pin):
+    """釘版本 `@<提交>` 的提交字串 → 完整提交編號;不合法回 None(筆記形狀擋 [S2])。
+    ★至少 12 位十六進位★(HEAD、分支名、標籤、main~1 這類會移動的名字不收);★解析結果要以它開頭★
+    (剛好取名成十六進位的分支會被 git 當分支解析,指到的是會移動的分支頂端);★要在某個本機或遠端追蹤分支的歷史上★
+    (用 git commit-tree 在本機捏造、從沒進過任何分支的提交物件,只查存在性會被放過——r3 正確性席實測)。"""
+    if not pin or not _NS_PIN_HEX_RE.match(pin):
+        return None
+    full = _lens_full_sha(repo_root, pin)
+    if not full or not full.lower().startswith(pin.lower()):
+        return None
+    r = _lens_git(repo_root, "for-each-ref", "--count=1", "--contains", full, "--format=%(refname)",
+                  "refs/heads", "refs/remotes")
+    if r is None or r.returncode != 0 or not r.stdout.strip():
+        return None
+    return full
+
+
+def _note_shape_config(text):
+    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
+    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
+    if text is None:
+        return "block", []
+    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
+    try:
+        data = json.loads(raw)
+    except Exception as e:
+        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
+    ns = data.get("note_shape") if isinstance(data, dict) else None
+    if ns is None:
+        return "block", []
+    if not isinstance(ns, dict):
+        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
+    g = ns.get("gate", "block")
+    if g not in _NOTE_SHAPE_GATE_VALUES:
+        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
+    return g, []
+
+
+def _ns_regions(text):
+    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
+    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。用行範圍判,不靠解析欄位——縮排怎麼寫都認得到。"""
+    lines = text.split("\n")
+    out = ["body"] * len(lines)
+    if not lines or lines[0].strip() != "---":
+        return out
+    out[0] = "other"
+    cur = "other"
+    for i in range(1, len(lines)):
+        ln = lines[i]
+        if ln.strip() == "---":
+            out[i] = "other"
+            return out
+        m = _NS_TOPKEY_RE.match(ln)
+        if m:
+            k = m.group(1)
+            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
+            out[i] = "other"
+            continue
+        if cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln):
+            out[i] = "other"
+        else:
+            out[i] = cur
+    return ["other"] * len(lines)        # frontmatter 沒關:整篇不判(lint 會擋)
+
+
+def _ns_parse_added(raw):
+    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
+    out, path, n = {}, None, 0
+    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
+        if ln.startswith("+++ "):
+            p = ln[4:]
+            path = nfc(p[2:]) if p.startswith("b/") else None
+            continue
+        if ln.startswith("@@"):
+            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
+            n = int(m.group(1)) if m else 0
+            continue
+        if path is None or ln.startswith("---"):
+            continue
+        if ln.startswith("+"):
+            out.setdefault(path, []).append((n, ln[1:]))
+            n += 1
+    return out
+
+
+def _ns_diff(repo_root, *args):
+    return _nodehome_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
+                         "--src-prefix=a/", "--dst-prefix=b/", *args)
+
+
+def _ns_range_added(repo_root, base, tip, vault_rel, exclude_remote=True):
+    """推送前:範圍裡每個提交各自新增的筆記行文字 → (集合, 範圍淨改動的筆記路徑)。git 失敗回 None。
+    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);
+    ★已在遠端追蹤分支上的提交不重查★(exclude_remote)——那些推上去的時候已經查過,或是別人的分支。"""
+    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
+    if exclude_remote:
+        rl += ["--not", "--remotes"]
+    raw = _nodehome_git(repo_root, *rl)
+    if raw is None:
+        return None
+    texts = set()
+    for line in raw.decode("ascii", errors="replace").splitlines():
+        shas = line.split()
+        if not shas:
+            continue
+        sha, parents = shas[0], shas[1:]
+        if len(parents) <= 1:
+            d = _ns_diff(repo_root, parents[0] if parents else _EMPTY_TREE_SHA, sha, "--", vault_rel)
+            if d is None:
+                return None
+            for _p, rows in _ns_parse_added(d).items():
+                texts.update(t_.strip() for _n, t_ in rows if t_.strip())
+            continue
+        names = _nodehome_git(repo_root, "diff", "--name-only", "-z", "-M", parents[0], sha, "--", vault_rel)
+        if names is None:
+            return None
+        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
+        specs = []
+        for p in paths:
+            specs.append(f"{sha}:{p}")
+            specs += [f"{pp}:{p}" for pp in parents]
+        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
+        k = 1 + len(parents)
+        for i, p in enumerate(paths):
+            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
+            new = _merge_new_lines(merged, olds) if blobs is not None else None
+            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
+                d = _ns_diff(repo_root, parents[0], sha, "--", p)
+                if d is None:
+                    return None
+                for _p, rows in _ns_parse_added(d).items():
+                    texts.update(t_.strip() for _n, t_ in rows if t_.strip())
+            else:
+                texts.update(x.decode("utf-8", errors="surrogateescape") for x in new)
+    net = _nodehome_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
+    if net is None:
+        return None
+    return texts, [p for p in _nodehome_split_z(net) if p.endswith(".md")]
+
+
+def _ns_is_code(path, reader, files):
+    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
+    if path not in files:
+        return False
+    kind = _nodehome_code_kind(path)
+    if kind == "ext":
+        return True
+    if kind != "shebang?":
+        return False
+    b = reader(path)
+    return b is not None and _head_is_shebang(b[:200])
+
+
+def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name):
+    """一行新增內容 → [(規則, 片段, 改法)]。"""
+    out = []
+    pins, singles = [], []
+    full, _bare = _node_code_ref_tokens(text, top_dirs, bare_text=True, anchors=True, keep_fences=True,
+                                        pins=pins, singles=singles)
+    pinned = {(p, l) for p, l, _s in pins}
+    for p, l, s in pins:
+        if not l:
+            continue
+        sha = _pin_commit(repo_root, s)
+        ok = sha is not None and _validate_repo_ref(repo_root, p, l, at_sha=sha)[0] == "ok"
+        if not ok and (p in files or _ns_is_code(p, reader, files) or sha is None):
+            out.append(("釘版本不合法", f"`{p}@{s}:{l}`",
+                        "`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
+                        "HEAD、分支名、標籤會移動,不算釘住"))
+    for p, l in full:
+        if not l or (p, l) in pinned:
+            continue
+        if _ns_is_code(p, reader, files):
+            out.append(("程式行號引用", f"`{p}:{l}`",
+                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{l}`"))
+    for name, l, s in singles:
+        cands = by_name.get(name, [])
+        if len(cands) == 1 and s is None and _ns_is_code(cands[0], reader, files):
+            out.append(("程式行號引用", f"`{name}:{l}`(= {cands[0]})",
+                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{l}`"))
+    if region == "summary":
+        for w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
+            out.append(("現況描述沒寫來源", text.strip()[:60],
+                        "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
+    return out
+
+
+def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
+    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
+    ch = _nodehome_changes(repo_root, base_where, tip_where)
+    if ch is None:
+        return []
+    lst_t = _nodehome_list(repo_root, tip_where)
+    lst_b = _nodehome_list(repo_root, base_where)
+    if lst_t is None or lst_b is None:
+        return []
+    reader_b = _nodehome_reader(repo_root, base_where)
+    out = []
+    for code, old, new in ch:
+        if not new or code == "D":
+            continue
+        if not _ns_is_code(new, reader_tip, lst_t[0]):
+            continue
+        prev = old or new
+        if prev not in lst_b[0] or not _ns_is_code(prev, reader_b, lst_b[0]):
+            out.append(new)
+    return out
+
+
+def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None):
+    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
+    reader = _nodehome_reader(repo_root, tip_where)
+    lst = _nodehome_list(repo_root, tip_where)
+    if lst is None:
+        return None
+    files = lst[0]
+    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
+    by_name = {}
+    for p in files:
+        if _nodehome_code_kind(p) is not None:
+            by_name.setdefault(p.rsplit("/", 1)[-1], []).append(p)
+    viol, errs = [], []
+    # 1) 這次新增的行
+    if staged:
+        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
+        if d is None:
+            return None
+        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
+        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
+        texts = None
+    else:
+        ra = _ns_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote)
+        if ra is None:
+            return None
+        texts, paths = ra
+        cand = {p: None for p in paths}
+    for p, linenos in sorted(cand.items()):
+        b = reader(p)
+        if b is None:
+            continue
+        try:
+            text = b.decode("utf-8")
+        except UnicodeDecodeError:
+            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
+            continue
+        lines = text.split("\n")
+        regs = _ns_regions(text)
+        for i, ln in enumerate(lines, 1):
+            if linenos is not None and i not in linenos:
+                continue
+            if texts is not None and ln.strip() not in texts:
+                continue
+            if not ln.strip() or regs[i - 1] == "other":
+                continue
+            for rule, frag, fix in _ns_check_line(repo_root, ln, regs[i - 1], files, reader, top_dirs, by_name):
+                viol.append((p, i, rule, frag, fix))
+    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
+    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
+                             tip_where, reader)
+    if became:
+        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
+        if gl is not None:
+            gl_reader = _nodehome_reader(repo_root, gl)
+            args = ["grep", "-n", "-I", "--full-name", "-F"]
+            for x in became:
+                args += ["-e", x]
+            args += (["--cached"] if tip_where == "index" else [tip_where]) + ["--", vault_rel]
+            g = _nodehome_git(repo_root, *args)
+            seen = {(v[0], v[1]) for v in viol}
+            for row in (g or b"").decode("utf-8", errors="replace").splitlines():
+                parts = row.split(":", 3) if tip_where != "index" else [""] + row.split(":", 2)
+                if len(parts) < 4:
+                    continue
+                _rev, p, n, ln = parts
+                if not p.endswith(".md") or not n.isdigit() or (p, int(n)) in seen:
+                    continue
+                old = gl_reader(p)
+                if old is not None and ln.strip() in {x.strip() for x in old.decode("utf-8", errors="replace").split("\n")}:
+                    continue
+                full, _b = _node_code_ref_tokens(ln, top_dirs, bare_text=True, anchors=True, keep_fences=True, pins=[])
+                for tok, l in full:
+                    if tok in became and l and f"{tok}@" not in ln:
+                        viol.append((p, int(n), "程式行號引用(新程式檔喚醒)", f"`{tok}:{l}`",
+                                     f"這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:改寫或釘版本 `{tok}@<提交編號>:{l}`"))
+    return viol, errs
+
+
+def _note_shape_doctor_lines(repo_root, vault):
+    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
+    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
+    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
+    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
+    out = []
+    root = Path(repo_root)
+    cp = root / ".lumos" / "config.json"
+    txt = None
+    try:
+        if cp.is_file() and not cp.is_symlink():
+            txt = cp.read_bytes()
+    except OSError:
+        txt = None
+    mode, _w = _note_shape_config(txt)
+    if mode != "block":
+        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
+                   "沒寫來源的現況描述不會被擋")
+    wf = root / ".github" / "workflows"
+    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
+    if ymls:
+        body = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in ymls)
+        step = ("- run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
+                "python3 scripts/lumos note-shape --diff \"${{ github.event.before }}..${{ github.sha }}\" "
+                "(checkout 要設 fetch-depth: 0;新分支首推前一版全零時改從空樹給,lumos 會自己截到上線點)")
+        if "note-shape --diff" not in body:
+            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
+        elif "fetch-depth: 0" not in body:
+            out.append("專案 CI 呼叫了 note-shape,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
+    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
+    if gl is None:
+        return out
+    ref = None
+    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
+    if up is not None and up.returncode == 0 and up.stdout.strip():
+        ref = up.stdout.strip()
+    else:
+        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
+        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
+        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
+        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
+        ref = cands[0] if cands else None
+    tip = _lens_full_sha(root, ref) if ref else None
+    if tip is None:
+        return out
+    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
+    if a is None or a.returncode != 0:
+        return out
+    try:
+        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
+    except ValueError:
+        return out
+    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False)
+    if res:
+        viol, errs = res
+        if viol:
+            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
+            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
+            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
+    return out
+
+
+def cmd_note_shape(repo=None, staged=False, diff_range=None):
+    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
+    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
+    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
+    只有擋下與跳過寫治理帳,放行不寫——刻意跟每支檔有家每次都寫 passed 不同:每次提交一筆沒資訊的行正是
+    rtb 回饋抱怨的帳本雜訊。"""
+    root = Path(repo).resolve() if repo else None
+    if root is None:
+        r = _lens_git(".", "rev-parse", "--show-toplevel")
+        if r is None or r.returncode != 0:
+            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
+            return 0
+        root = Path(r.stdout.strip())
+    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
+    if r is None or r.returncode != 0:
+        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
+        return 0
+    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE"):
+        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
+        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
+        return 0
+    if staged:
+        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
+        if mh is not None and mh.returncode == 0:
+            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
+            return 0
+        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
+    else:
