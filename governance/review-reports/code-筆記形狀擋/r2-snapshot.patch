+def _ns_mainline_refs(repo_root):
+    """各遠端的預設分支參照(refs/remotes/<遠端>/HEAD 指到的那條,沒有就 main、master)。
+    推送範圍只排除「已經在主線上」的提交——★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
+    那些提交從沒被查過(代碼審 r1 單reviewer 與外家席各自實測繞過)。"""
+    rr = _lens_git(repo_root, "remote")
+    remotes = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
+    out = []
+    for rm in remotes:
+        s = _lens_git(repo_root, "symbolic-ref", "-q", f"refs/remotes/{rm}/HEAD")
+        cands = [s.stdout.strip()] if s is not None and s.returncode == 0 and s.stdout.strip() else []
+        cands += [f"refs/remotes/{rm}/main", f"refs/remotes/{rm}/master"]
+        for c in cands:
+            if _lens_full_sha(repo_root, c):
+                out.append(c)
+                break
+    return out
