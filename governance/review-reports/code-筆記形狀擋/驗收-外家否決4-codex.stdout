 23738	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 23739	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 23740	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 23741	    if ch is None:
 23742	        return []
 23743	    lst_t = _nodehome_list(repo_root, tip_where)
 23744	    lst_b = _nodehome_list(repo_root, base_where)
 23745	    if lst_t is None or lst_b is None:
 23746	        return []
 23747	    reader_b = _nodehome_reader(repo_root, base_where)
 23748	    out = []
 23749	    for code, old, new in ch:
 23750	        if not new or code == "D":
 23751	            continue
 23752	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 23753	            continue
 23754	        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
