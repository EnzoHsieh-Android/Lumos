 23760	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None, max_count=None):
 23761	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 23762	    reader = _nodehome_reader(repo_root, tip_where)
 23763	    lst = _nodehome_list(repo_root, tip_where)
 23764	    if lst is None:
 23765	        return None
 23766	    files = lst[0]
 23767	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 23768	    _names, _name_cache = {}, {}
 23769	    for p in files:
 23770	        if _nodehome_code_kind(p) is not None:
 23771	            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23772	
 23773	    def by_name(name):
 23774	        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
 23775	        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
 23776	        if name not in _name_cache:
 23777	            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
 23778	        return _name_cache[name]
 23779	    viol, errs = [], []
 23780	    # 1) 這次新增的行
 23781	    if staged:
 23782	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23783	        if d is None:
 23784	            return None
 23785	        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
 23786	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23787	        texts_by = None
 23788	    else:
 23789	        ra = _ns_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote,
 23790	                             golive=_nodehome_golive(repo_root, tip_where, mark or _NOTE_SHAPE_GOLIVE_MARK), max_count=max_count)
 23791	        if ra is None:
 23792	            return None
 23793	        texts_by, paths = ra
 23794	        cand = {p: None for p in paths}
 23795	    for p, linenos in sorted(cand.items()):
 23796	        b = reader(p)
 23797	        if b is None:
 23798	            continue
 23799	        try:
 23800	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 23801	        except UnicodeDecodeError:
 23802	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 23803	            continue
 23804	        lines = text.split("\n")
 23805	        regs = _ns_regions(text)
 23806	        regen = _ns_is_regen(text)
 23807	        for i, ln in enumerate(lines, 1):
 23808	            if linenos is not None and i not in linenos:
 23809	                continue
 23810	            if texts_by is not None and ln.strip() not in texts_by.get(p, ()):
 23811	                continue
 23812	            if not ln.strip() or regs[i - 1] == "other":
 23813	                continue
 23814	            for rule, frag, fix in _ns_check_line(repo_root, ln, regs[i - 1], files, reader, top_dirs, by_name, regen):
 23815	                viol.append((p, i, rule, frag, fix))
 23816	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 23817	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 23818	                             tip_where, reader)
 23819	    if became:
 23820	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 23821	        if gl is not None:
 23822	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 23823	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 23824	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 23825	            spec = "" if tip_where == "index" else tip_where
 23826	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 23827	            gl_reader = _nodehome_reader(repo_root, gl)
 23828	            seen = {(v[0], v[1]) for v in viol}
 23829	            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
 23830	            for p, blob in zip(notes_, blobs):
 23831	                if blob is None:
 23832	                    continue
 23833	                text = blob.decode("utf-8-sig", errors="replace")
 23834	                if not any(x in text for x in keys):
 23835	                    continue
 23836	                old, regs_, regen_ = None, _ns_regions(text), _ns_is_regen(text)
 23837	                for n, ln in enumerate(text.split("\n"), 1):
 23838	                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
 23839	                        continue
 23840	                    if old is None:
 23841	                        ob = gl_reader(p)
 23842	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 23843	                    if ln.strip() in old:
 23844	                        continue
 23845	                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
 23846	                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
 23847	                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
 23848	                        if rule == "現況描述沒寫來源" or not any(f"`{x}" in frag or f"= {x})" in frag for x in became):
 23849	                            continue
 23850	                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
 23851	                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
 23852	    return viol, errs
 23853	
