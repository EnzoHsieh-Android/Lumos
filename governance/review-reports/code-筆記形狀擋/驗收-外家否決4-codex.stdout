 23543	def _ns_git(repo_root, *args):
 23544	    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
 23545	    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
 23546	    r = _lens_git(repo_root, *args, quote=True, binary=True)
 23547	    if r is None or r.returncode != 0:
 23548	        return None
 23549	    return r.stdout
 23550	
 23551	
 23552	def _ns_diff(repo_root, *args):
 23553	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23554	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
 23555	
 23556	
 23557	def _ns_mainline_refs(repo_root):
 23558	    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
 23559	    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
 23560	    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
 23561	    ml = _mainline_ref(repo_root, remote_only=True)
 23562	    return [ml[1]] if ml else []
 23563	
 23564	
 23565	def _ns_exclusions(repo_root, tip):
 23566	    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
 23567	    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
 23568	    out = []
 23569	    for ref in _ns_mainline_refs(repo_root):
 23570	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
 23571	        if r is not None and r.returncode == 1:
 23572	            out.append(ref)
 23573	    return out
 23574	
 23575	
 23576	def _ns_range_added(repo_root, base, tip, vault_rel, exclude_remote=True, golive=None, max_count=None):
 23577	    """推送前:範圍裡每個提交各自新增的筆記行 → ({終點路徑: 行文字集合}, 範圍淨改動的筆記路徑)。git 失敗回 None。
 23578	    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
 23579	    改名照每個提交的改名偵測往後帶到終點路徑。
 23580	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名
 23581	    再讀(代碼審 r2 外家席:合併時改名,原本拿新檔名去讀上一版讀不到,把上一版帶進來的行當成新寫)。
 23582	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。
 23583	    ★上線點不是祖先的提交不查★(golive):上線前開的分支上線後才合進來,那些提交寫的時候還沒有這道檢查,是舊帳
 23584	    (代碼審 r3 通才席);合併提交本身照樣只算它自己寫的行。max_count:只看最新那幾個提交(doctor 的上限)。"""
 23585	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23586	    if exclude_remote:
 23587	        ml = _ns_exclusions(repo_root, tip)
 23588	        if ml:
 23589	            rl += ["--not", *ml]
 23590	    if max_count:
 23591	        rl.append(f"--max-count={int(max_count)}")
 23592	    raw = _nodehome_git(repo_root, *rl)
 23593	    if raw is None:
 23594	        return None
 23595	    live = None
 23596	    if golive:
 23597	        ap = _nodehome_git(repo_root, "rev-list", "--ancestry-path", f"{golive}..{tip}")
 23598	        if ap is None:
 23599	            return None
 23600	        live = set(ap.decode("ascii", errors="replace").split()) | {golive}
 23601	    by_path = {}
 23602	
 23603	    def _renames(a, b):
 23604	        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
 23605	        return None if r is None else _nodehome_name_status(r)[1]        # 新路徑 → 舊路徑
 23606	
 23607	    def _carry(ren):
 23608	        for new_, old_ in (ren or {}).items():
 23609	            if old_ in by_path and old_ != new_:
 23610	                by_path.setdefault(new_, set()).update(by_path.pop(old_))
 23611	
 23612	    for line in raw.decode("ascii", errors="replace").splitlines():
 23613	        shas = line.split()
 23614	        if not shas:
 23615	            continue
 23616	        sha, parents = shas[0], shas[1:]
 23617	        first = parents[0] if parents else _EMPTY_TREE_SHA
 23618	        ren = _renames(first, sha)
 23619	        if ren is None:
 23620	            return None
 23621	        _carry(ren)
 23622	        if live is not None and sha not in live:
 23623	            continue
 23624	        if len(parents) <= 1:
 23625	            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
 23626	            if d is None:
 23627	                return None
 23628	            for p, rows in _ns_parse_added(d).items():
 23629	                by_path.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23630	            continue
 23631	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 23632	        if names is None:
 23633	            return None
 23634	        paths = [nfc(p) for p in _nodehome_split_z(names) if p.endswith(".md")]
 23635	        pren = [_renames(pp, sha) or {} for pp in parents]
 23636	        for pr in pren[1:]:
 23637	            # 另一邊在舊檔名寫的行也搬到合併結果的檔名(代碼審 r3 外家席:原本只搬第一個上一版的改名,
 23638	            # 主線改名、側分支在舊檔名新寫,處理順序對了就整批漏查)
 23639	            _carry(pr)
 23640	        specs = []
 23641	        for p in paths:
 23642	            specs.append(f"{sha}:{p}")
 23643	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
 23644	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23645	        k = 1 + len(parents)
 23646	        for i, p in enumerate(paths):
 23647	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23648	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23649	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23650	                d = _ns_diff(repo_root, first, sha, "--", p)
 23651	                if d is None:
 23652	                    return None
 23653	                for _p, rows in _ns_parse_added(d).items():
 23654	                    by_path.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23655	            else:
 23656	                by_path.setdefault(p, set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
 23657	    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 23658	    if net is None:
 23659	        return None
 23660	    # 路徑一律 NFC,跟 _ns_parse_added、_nodehome_name_status 的鍵一致(代碼審 r3 通才席:git 裡存 NFD 的檔名整篇查不到)
 23661	    return by_path, [nfc(p) for p in _nodehome_split_z(net) if p.endswith(".md")]
 23662	
 23663	
 23664	def _ns_is_code(path, reader, files):
 23665	    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
 23666	    if path not in files:
 23667	        return False
 23668	    kind = _nodehome_code_kind(path)
 23669	    if kind == "ext":
 23670	        return True
 23671	    if kind != "shebang?":
 23672	        return False
 23673	    b = reader(path)
 23674	    return b is not None and _head_is_shebang(b[:200])
 23675	
 23676	
 23677	# 只放連結的指路行:連結裡不准有別名或段落(`[[目標|別名]]`、`[[目標#段落]]` 都能夾帶現況,代碼審 r2、r3 通才席);
 23678	# 分隔認中文常用的標點與連接詞(r3 外家席:原本把全形逗號打成半形,測試也用半形,假綠)
 23679	_NS_POINTER_ONLY_RE = re.compile(r"^(?:\s*(?:\[\[[^\]|#]+\]\]|見|→|,|\uff0c|、|\u3002|;|\uff1b|與|和|及|\||｜)\s*)*$")
 23680	
 23681	
 23682	def _ns_pin_ok(repo_root, p, l, s):
 23683	    sha = _pin_commit(repo_root, s)
 23684	    return sha is not None and _validate_repo_ref(repo_root, p, l, at_sha=sha)[0] == "ok"
 23685	
