 22599	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22600	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
 22601	    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
 22602	    lst = _nodehome_list(repo_root, where)
 22603	    if lst is None:
 22604	        return None
 22605	    s = _NodehomeSide()
 22606	    s.files, s.all_paths = lst
 22607	    s.where = where
 22608	    s._reader = _nodehome_reader(repo_root, where)
 22609	    s.shebang = {}
 22610	    s.share = share
 22611	    s.changed = set(changed or ())
 22612	    s.notes = {}
 22613	    pre = vault_rel + "/Systems/"
 22614	    for p in s.files:
 22615	        if p.startswith(pre) and p.endswith(".md"):
 22616	            rel = p[len(vault_rel) + 1:]
 22617	            if share is not None and p not in s.changed and rel in share.notes:
 22618	                s.notes[rel] = share.notes[rel]
 22619	                continue
 22620	            raw = s._reader(p)
 22700	                refs.add(where[b])
 22701	    return refs
