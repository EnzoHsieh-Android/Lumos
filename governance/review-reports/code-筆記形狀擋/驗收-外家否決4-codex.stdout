 22499	def _nodehome_list(repo_root, where):
 22500	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 22501	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
 22502	    if where is None:
 22503	        return {}, []
 22504	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 22505	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 22506	    if raw is None:
 22507	        return None
 22508	    files, allp = {}, []
 22509	    for ent in raw.split(b"\0"):
 22510	        if not ent or b"\t" not in ent:
 22511	            continue
 22512	        meta, p = ent.split(b"\t", 1)
 22513	        parts = meta.split()
 22514	        if where == "index":
 22515	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 22516	                continue
 22517	            mode = parts[0]
 22518	        else:
 22519	            if len(parts) != 3:
 22520	                continue
 22521	            mode = parts[0]
 22522	        path = nfc(os.fsdecode(p))
 22523	        allp.append(path)
 22524	        if mode in (b"100644", b"100755"):
 22525	            files[path] = mode.decode()
 22526	    return files, allp
