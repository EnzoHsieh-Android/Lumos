 22665	def _home_map_from_notes(items):
 22666	    """★家對照表的唯一算法★(推筆記認家 [S1]):輸入 (節點名, type, status, about_code 清單) 的序列,
 22667	    回 ({檔: [家那幾篇]}, {節點名: 自己管的檔集合})。只看 about_code 欄位值、不看預標指紋有沒有過期
 22668	    (指紋在每次寫回都會過期)。每支檔有家從提交快照餵、改檔前推筆記從已載入的圖譜餵,★兩邊共用這一支★——
 22669	    兩套算法一定分岔,而分岔時沒有東西會翻紅。"""
 22670	    homes, own = {}, {}
 22671	    for rel, typ, status, about in items:
 22672	        keys = {k for k in (_nodehome_key(v) for v in about) if k}
 22673	        own[rel] = keys
 22674	        if typ != "system" or status not in _NODEHOME_HOME_STATUSES:
 22675	            continue
 22676	        for k in keys:
 22677	            homes.setdefault(k, []).append(rel)
 22678	    return homes, own
 22679	
 22680	
 22681	def _nodehome_homes(repo_root, side):
 22682	    """[S2] {檔: [家那幾篇]}——每支檔有家這邊:拿提交快照的解析結果餵 _home_map_from_notes。"""
 22683	    return _home_map_from_notes((rel, n["type"], n["status"], n["about"]) for rel, n in side.notes.items())
 22684	
