 28080	def _lens_git(repo_root, *args, quote=False, binary=False):
 28081	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 28082	    import subprocess as _sp
 28083	    cmd = ["git", "-C", str(repo_root)]
 28084	    if quote:
 28085	        cmd += ["-c", "core.quotePath=false"]
 28086	    try:
 28087	        if binary:
 28088	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 28089	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 28090	    except (OSError, _sp.TimeoutExpired):
 28091	        return None
 28092	
