 28113	def _lens_dispositions_lines(lines, rec):
 28114	    """派工鏡頭附表態記錄(表態閘 S8):只列人答的題(未觸發自動 na 只給個數);工具驗過錨點存在、沒驗答案對不對——審查席反駁的就是這些答案。回人答題數。"""
 28115	    disp = rec.get("dispositions") or {}
 28116	    human = [(q, e) for q, e in disp.items() if isinstance(e, dict) and not e.get("auto")]
 28117	    n_auto = sum(1 for e in disp.values() if isinstance(e, dict) and e.get("auto"))
 28118	    lines.append(f"[表態記錄(棧別效能檢核;分支 {rec.get('branch')},版本 {str(rec.get('head_sha') or '')[:8]})——寫入時工具只驗了形狀,證據存不存在要到推送前 code-loop check 才驗,答案對不對沒人驗]")
 28119	    for q, e in human:
 28120	        st = e.get("status")
 28121	        tail = (str(e.get("evidence") or "") if st == "satisfied"
 28122	                else (str(e.get("issue") or "") + " " + str(e.get("reason") or "")) if st == "todo"
 28123	                # tension 四欄都給審查席看——反駁的就是這四欄(2026-09-09 兩席相反時端出張力;「｜」分隔是編排者裁的,四欄需要分隔)
 28124	                else (f"選 {e.get('chosen') or ''}｜既有 {', '.join(str(x) for x in (e.get('existing') or []))}｜隱患 {e.get('hazard') or ''}｜建議 {e.get('suggestion') or ''}") if st == "tension"
 28125	                else str(e.get("reason") or ""))   # 全部 str(… or ""):治理帳重建來的紀錄不重驗形狀,缺欄不能炸(r1 正確性席 f3)
 28126	        lines.append(f"  {q} {st} — {str(tail)[:200]}")
 28127	    if n_auto:
 28128	        lines.append(f"  (另有 {n_auto} 題未觸發、工具自動記不適用)")
 28129	    return len(human)
