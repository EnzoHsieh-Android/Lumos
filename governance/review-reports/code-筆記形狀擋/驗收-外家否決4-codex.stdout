 47910	    r = run_r("--suite", "keys", "--keys", nope)
 47911	    check("keys 0 支:rc3(不是 1,讓呼叫端分得出「沒對到」跟「有紅」)", r.returncode == 3 and "選中 0 個" in r.stderr, f"rc={r.returncode} {r.stderr[:200]}")
 47912	    r = run_r("--list", "--suite", "keys", "--keys", nope)
 47913	    check("--list 0 支是查詢,rc0", r.returncode == 0 and "沒有對到" in r.stderr, f"rc={r.returncode}")
 47914	    r = run_r("--suite", "keys"); check("--suite keys 沒給 --keys 擋 rc2", r.returncode == 2, f"rc={r.returncode}")
 47915	    r = run_r("--keys", "x"); check("--keys 沒配 --suite keys 擋 rc2", r.returncode == 2, f"rc={r.returncode}")
 47916	    r = run_r("--suite", "nope"); check("--suite 不認得的值 argparse 擋 rc2", r.returncode == 2, f"rc={r.returncode}")
