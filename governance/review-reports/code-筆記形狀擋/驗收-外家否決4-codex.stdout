 23448	# ── 筆記形狀擋(Projects/筆記形狀擋_計劃,2026-09-27;Issue 筆記把程式現況寫進脈絡而漂移_rtb實測回饋 d1–d6、d8)──
 23449	# 筆記不留存程式碼推得出來的東西。這一層只擋形狀固定、機械判得準的兩種(看意思的交給第二層審查員):
 23450	# ①新寫的程式行號引用(行號一改碼就錯位) ②新寫的 FACT/FLOW/DEP 摘要行沒寫出程式碼答不了的來源。
 23451	# 只看這次新增或改動的行(d2:舊筆記不回頭清);範圍、上線點、合併照每支檔有家的算法。
 23452	_NOTE_SHAPE_GOLIVE_MARK = "note-shape --staged"     # 提交前掛鉤裡有這串=這道檢查上線了(上線點截斷用)
 23453	_NOTE_SHAPE_GATE_VALUES = ("block", "warn", "off")
 23454	_NS_DOCTOR_SCAN_CAP = 200                            # doctor 事後掃描最多看幾個提交(每個約 20 ms)
 23455	_NS_PIN_HEX_RE = re.compile(r"^[0-9a-fA-F]{12,40}$")
 23456	_NS_STRUCT_KEY_RE = re.compile(r"^\s*(?:-\s+)?(id|decided|valid|superseded_by|ended|decided_by|replaces)\s*:")
 23457	
 23458	
 23459	def _pin_commit(repo_root, pin):
 23460	    """釘版本 `@<提交>` 的提交字串 → 完整提交編號;不合法回 None(筆記形狀擋 [S2])。
 23461	    ★至少 12 位十六進位★(HEAD、分支名、標籤、main~1 這類會移動的名字不收);★解析結果要以它開頭★
 23462	    (剛好取名成十六進位的分支會被 git 當分支解析,指到的是會移動的分支頂端);★要在某個本機或遠端追蹤分支的歷史上★
 23463	    (用 git commit-tree 在本機捏造、從沒進過任何分支的提交物件,只查存在性會被放過——r3 正確性席實測)。"""
 23464	    if not pin or not _NS_PIN_HEX_RE.match(pin):
 23465	        return None
 23466	    full = _lens_full_sha(repo_root, pin)
 23467	    if not full or not full.lower().startswith(pin.lower()):
 23468	        return None
 23469	    r = _lens_git(repo_root, "for-each-ref", "--count=1", "--contains", full, "--format=%(refname)",
 23470	                  "refs/heads", "refs/remotes")
 23471	    if r is None or r.returncode != 0 or not r.stdout.strip():
 23472	        return None
 23473	    return full
 23474	
 23475	
 23476	def _note_shape_config(text):
 23477	    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
 23478	    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
 23479	    if text is None:
 23480	        return "block", []
 23481	    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 23482	    try:
 23483	        data = json.loads(raw)
 23484	    except Exception as e:
 23485	        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
 23486	    ns = data.get("note_shape") if isinstance(data, dict) else None
 23487	    if ns is None:
 23488	        return "block", []
 23489	    if not isinstance(ns, dict):
 23490	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23491	    g = ns.get("gate", "block")
 23492	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23493	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23494	    return g, []
 23495	
 23496	
 23497	def _ns_regions(text):
 23498	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23499	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23500	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23501	    lines = text.split("\n")
 23502	    fm, _body = split_frontmatter(text)
 23503	    if fm is None:
 23504	        if text.startswith("---"):
 23505	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23506	        return ["body"] * len(lines)
 23507	    out = ["body"] * len(lines)
 23508	    end = len(fm) + 1                            # 收尾 --- 那一行
 23509	    out[0] = out[end] = "other"
 23510	    cur = "other"
 23511	    for i in range(1, end):
 23512	        ln = lines[i]
 23513	        m = TOP_KEY_RE.match(ln)
 23514	        if m:
 23515	            k = m.group(1)
 23516	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23517	            out[i] = "other"
 23518	            continue
 23519	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23520	    return out
 23521	
 23522	
 23523	def _ns_parse_added(raw):
 23524	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23525	    out, path, n = {}, None, 0
 23526	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23527	        if ln.startswith("+++ "):
 23528	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23529	            path = nfc(p[2:]) if p.startswith("b/") else None
 23530	            continue
 23531	        if ln.startswith("@@"):
 23532	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23533	            n = int(m.group(1)) if m else 0
 23534	            continue
 23535	        if path is None or ln.startswith("---"):
 23536	            continue
 23537	        if ln.startswith("+"):
 23538	            out.setdefault(path, []).append((n, ln[1:]))
 23539	            n += 1
 23540	    return out
 23541	
