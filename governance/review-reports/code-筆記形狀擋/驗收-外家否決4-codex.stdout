 22490	def _nodehome_show(path):
 22491	    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
 22492	    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)
