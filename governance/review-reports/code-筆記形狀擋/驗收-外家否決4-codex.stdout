 22908	def _nodehome_mark_note_content(repo_root, groups, vault_rel):
 22909	    """推送前逐提交看寫回:每個提交裡,哪幾篇 Systems 節點的內容(摘要、決策、正文)是在這個提交改的——只補驗證連結、
 22910	    計劃連結這類簿記欄位的不算——以及那篇在這個提交前後管哪些檔。在讀取這一層先算好放進分組的 content_notes
 22911	    {這個提交之後的路徑: {type, status, own}},判定那層只在同一個提交裡比「管的檔」跟「改的程式」,不必跨提交追名字
 22912	    (合併進來的平行分支、一次推送改名好幾次都不影響——代碼審 r2 單reviewer)。這個提交裡改名的,拿改名前的路徑去
 22913	    上一個提交讀;這個提交才新開的算有變;讀不到一律當有變,照原本那樣查。"""
 22914	    pre = vault_rel + "/Systems/"
 22915	    for g in groups or ():
 22916	        after = _nodehome_reader(repo_root, g["sha"])
 22917	        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
 22918	        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
 22919	        notes = {}
 22920	        for p in g["paths"]:
 22921	            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
 22922	                continue
 22923	            new = after(p)
 22924	            n = _nodehome_parse_note(new) if new is not None else None
 22925	            olds = [b(g["src"].get(p, p)) for b in befores]
 22926	            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
 22927	            if n is not None and any(o["sig"] == n["sig"] for o in olds):
 22928	                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
 22929	            own, statuses = set(), set()
 22930	            for x in [n] + olds:
 22931	                if x is not None:
 22932	                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
 22933	                    statuses.add(x["status"])
 22934	            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
 22935	            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
 22936	        g["content_notes"] = notes
 22937	    return groups
