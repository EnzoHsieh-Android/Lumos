 23855	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 23856	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 23857	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 23858	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 23859	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 23860	    out = []
 23861	    root = Path(repo_root)
 23862	    cp = root / ".lumos" / "config.json"
 23863	    txt = None
 23864	    try:
 23865	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 23866	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 23867	            txt = cp.read_bytes()
 23868	    except OSError:
 23869	        txt = None
 23870	    mode, _w = _note_shape_config(txt)
 23871	    if mode != "block":
 23872	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 23873	                   "沒寫來源的現況描述不會被擋")
 23874	    wf = root / ".github" / "workflows"
 23875	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 23876	    if ymls:
 23877	        body = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in ymls)
 23878	        step = ("- run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 23879	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
 23880	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before }}..${{ github.sha }}\" "
 23881	                "(checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了讓已在主線上的提交不重查;"
 23882	                "新分支首推前一版全零時改從空樹給,lumos 會自己截到上線點)")
 23883	        if "note-shape --diff" not in body:
 23884	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 23885	        elif "fetch-depth: 0" not in body:
 23886	            out.append("專案 CI 呼叫了 note-shape,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
 23887	    if ci:
 23888	        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
 23889	        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
 23890	        return out
 23891	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 23892	    if gl is None:
 23893	        return out
 23894	    ref = None
 23895	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 23896	    if up is not None and up.returncode == 0 and up.stdout.strip():
 23897	        ref = up.stdout.strip()
 23898	    else:
 23899	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 23900	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 23901	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 23902	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 23903	        ref = cands[0] if cands else None
 23904	    tip = _lens_full_sha(root, ref) if ref else None
 23905	    if tip is None:
 23906	        return out
 23907	    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
 23908	    if a is None or a.returncode != 0:
 23909	        return out
 23910	    try:
 23911	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 23912	    except ValueError:
 23913	        return out
 23914	    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
 23915	    capped = cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP
 23916	    # 上限用「最新 N 個提交」算,不用 tip~N:沿第一個上一版數的邊界在合併式歷史裡會退到上線點之前、或根本數不到 N 步
 23917	    # 而整個取消(代碼審 r2、r3 通才席);起點固定在上線點
 23918	    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False,
 23919	                           max_count=_NS_DOCTOR_SCAN_CAP if capped else None)
 23920	    if capped:
 23921	        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
 23922	    if res:
 23923	        viol, errs = res
 23924	        if viol:
 23925	            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
 23926	            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
 23927	            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
 23928	    return out
