 47966	    check("純文件:訊息講明只跑文件子集、不再接「全套約 N 分鐘」", "文件子集" in r.stderr and "全套約" not in r.stderr.split("推送前先跑文件子集")[-1][:80], r.stderr[-400:])
 47967	    # light:風險低計劃(全靠人驗)落點內的小改動 → push-check 印 light、pitfalls light_ok → 文件子集 + keys 各兩片
 47968	    (d / "app").mkdir(); mp = d / "app" / "main.py"; mp.write_text("x = 1\n")
 47969	    hm = kg / "Systems" / "Home.md"; hm.write_text(hm.read_text(encoding="utf-8").replace("  - tests/test_x.py\n", "  - tests/test_x.py\n  - app/main.py\n"), encoding="utf-8")
 47970	    _sg_commit(d, "add code"); base = g("rev-parse", "HEAD")
 47971	    mp.write_text("x = 1\ny = 2\n"); _sg_commit(d, "small code")
 47972	    r, calls = push(base, g("rev-parse", "HEAD"))
