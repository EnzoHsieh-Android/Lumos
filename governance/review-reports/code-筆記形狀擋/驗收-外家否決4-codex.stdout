 19953	def _refcheck_scan(text, repo_root):
 19954	    """refcheck 抽取+核對核心(不列印):回 (claims, n_missing, n_oor, n_ok)。
 19955	    cmd_refcheck 與 loop status --gate(G1 錨)共用;抽取規則見 cmd_refcheck docstring。
 19956	    核對段走 _validate_repo_ref(與 Check J 共用);抽取段(inline-code+top_dirs 過濾)維持原規則。"""
 19957	    top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
 19958	    pins = []
 19959	    full, _bare = _node_code_ref_tokens(text, top_dirs, pins=pins,
 19960	                                        exists=lambda p_, s_=None: (repo_root / p_).exists() or _path_at_pin(repo_root, p_, s_))
 19961	    claims = []
 19962	    # 釘版本 `路徑@<提交>:行號` 對那個提交驗(筆記形狀擋 [S2]):不這樣做,它會被當成一支叫「路徑@提交」、
 19963	    # 或行號對不上目前版本的檔,設計審放行前的引用檢查就把合法寫法判成幻覺證據
 19964	    for token, line, pin in pins:
 19965	        sha = _pin_commit(repo_root, pin)
 19966	        status, excerpt = _validate_repo_ref(repo_root, token, line, at_sha=sha) if sha else ("missing", "")
 19967	        claims.append({"token": f"{token}@{pin}", "line": line, "status": status, "excerpt": excerpt})
 19968	    for token, line in full:
 19969	        status, excerpt = _validate_repo_ref(repo_root, token, line)
 19970	        claim = {"token": token, "line": line, "status": status, "excerpt": excerpt}
 19971	        if status == "ok" and (repo_root / token).is_dir():
 19972	            claim["dir"] = True
 19973	        claims.append(claim)
 19974	
 19975	    n_missing = sum(1 for c in claims if c["status"] == "missing")
 19976	    n_oor = sum(1 for c in claims if c["status"] == "line_out_of_range")
 19977	    n_ok = sum(1 for c in claims if c["status"] == "ok")
 19978	    return claims, n_missing, n_oor, n_ok
