 22704	def _nodehome_changes(repo_root, base, tip):
 22705	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22706	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22707	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22708	    if tip == "index":
 22709	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22710	        if base is None:
 22711	            args.append(_EMPTY_TREE_SHA)
 22712	    else:
 22713	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 22714	    raw = _nodehome_git(repo_root, *args)
 22715	    if raw is None:
 22716	        return None
 22717	    toks = _nodehome_split_z(raw)
 22718	    out, i = [], 0
 22719	    while i < len(toks):
 22720	        st = toks[i]
 22721	        code = st[:1]
 22722	        if code in ("R", "C") and i + 2 < len(toks):
 22723	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 22724	            i += 3
 22725	        elif i + 1 < len(toks):
 22726	            p = nfc(toks[i + 1])
 22727	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 22728	            i += 2
 22729	        else:
 22730	            break
 22731	    return out
 22732	
 22733	
 22734	def _nodehome_name_status(raw):
 22735	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
 22736	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 22737	    while i < len(toks):
 22738	        code = toks[i][:1]
 22739	        if code in ("R", "C") and i + 2 < len(toks):
 22740	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 22741	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 22742	            if code == "R":
 22743	                gone.add(nfc(toks[i + 1]))
 22744	            i += 3
 22745	        elif i + 1 < len(toks):
 22746	            paths.add(nfc(toks[i + 1]))
 22747	            if code == "D":
 22748	                gone.add(nfc(toks[i + 1]))
 22749	            i += 2
 22750	        else:
 22751	            break
 22752	    return paths, src, gone - set(src)
 22753	
 22754	
 22755	def _nodehome_merge_own_changes(repo_root, sha, parents):
 22756	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 22757	
 22758	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 22759	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 22760	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 22761	    或順手多改的部分,正是這道檢查要看的。
 22762	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 22763	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 22764	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 22765	    """
 22766	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 22767	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22768	        return None
 22769	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 22770	                      "--name-status", "-z", "-M", sha)
 22771	    if r is None:
 22772	        return None
 22773	    paths, src, gone = _nodehome_name_status(r)
 22774	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 22775	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 22776	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 22777	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 22778	    for p in parents:
 22779	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22780	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22781	    order = sorted(paths)
 22782	    specs = []
 22783	    for x in order:
 22784	        specs.append(f"{sha}:{x}")
 22785	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 22786	    blobs = _nodehome_cat_blobs(repo_root, specs)
 22787	    if blobs is None or any(ren is None for _, ren in pairs):
 22788	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 22789	        return paths, src, gone
 22790	    kept = set()
 22791	    for n, x in enumerate(order):
 22792	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 22793	        if _nodehome_merge_wrote_new_lines(merged, olds):
 22794	            kept.add(x)
 22795	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 22796	
 22797	
 22798	def _nodehome_cat_blobs(repo_root, specs):
 22799	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22800	
 22801	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22802	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22803	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 22804	    import subprocess as _sp
 22805	    if not specs:
 22806	        return []
 22807	    if any("\n" in s_ for s_ in specs):
 22808	        return None
 22809	    try:
 22810	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22811	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22812	                    capture_output=True, timeout=60)
 22813	    except (OSError, _sp.TimeoutExpired):
 22814	        return None
 22815	    if r.returncode != 0:
 22816	        return None
 22817	    out, pos, res = r.stdout, 0, []
 22818	    for _ in specs:
 22819	        nl = out.find(b"\n", pos)
 22820	        if nl < 0:
 22821	            return None
 22822	        head = out[pos:nl].split(b" ")
 22823	        pos = nl + 1
 22824	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22825	            size = int(head[2])
 22826	            res.append(out[pos:pos + size])
 22827	            pos += size + 1
 22828	        elif len(head) == 3 and head[2].isdigit():
 22829	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22830	            res.append(None)
 22831	        else:
 22832	            res.append(None)            # missing / ambiguous
 22833	    return res
 22834	
 22835	
 22836	def _nodehome_merge_wrote_new_lines(merged, olds):
 22837	    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。
 22838	
 22839	    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
 22840	    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
 22841	    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
 22842	    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
 22843	    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
 22844	    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
 22845	    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
 22846	    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
 22847	    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
 22848	    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
 22849	    new = _merge_new_lines(merged, olds)
 22850	    return True if new is None else bool(new)
 22851	
 22852	
 22853	def _merge_new_lines(merged, olds):
 22854	    """合併結果裡「每一個上一版都找不到」的那些行(去頭尾空白後的位元組集合);判不了回 None。
 22855	    從 _nodehome_merge_wrote_new_lines 拆出來(筆記形狀擋 [S5] 要的是哪幾行,不是有沒有);天花板見那支的說明。"""
 22856	    if merged is None or b"\0" in merged:
 22857	        return None
 22858	    seen = set()
 22859	    for blob in olds:
 22860	        if blob is not None:
 22861	            seen.update(ln.strip() for ln in blob.split(b"\n"))
 22862	    return {ln.strip() for ln in merged.split(b"\n") if ln.strip() and ln.strip() not in seen}
 22863	
 22864	
 22865	def _nodehome_commit_groups(repo_root, base, tip):
 22866	    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
 22867	    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
 22868	    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
 22869	    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
 22870	    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
 23420	        lines = [l.replace("擋下:", "提醒(node_home.gate=warn,不擋):", 1) for l in lines]
 23421	    for l in lines:
 23422	        print(l, file=sys.stderr)
 23423	    # 治理帳:nodes 只放程式檔路徑(統計語意表這麼宣告);沒有程式檔的違規(負責範圍)把節點另放 notes
 23424	    files, notes_ = set(), set()
 23425	    for kind, it in res["blocks"]:
 23426	        if kind in ("new-homeless", "write-back-homeless"):
 23427	            files.add(it)
 23428	        elif kind == "home-removed":
 23429	            files.add(it[0])
 23430	        elif kind in ("foreign", "foreign-awakened"):
 23431	            files.add(it[1]); notes_.add(it[0])
 23432	        elif kind == "route":
 23433	            files.update(it[1]); notes_.add(it[0])
 23434	        else:
 23435	            notes_.add(it[0])
 23436	    kind = "blocked" if blocked and cfg["mode"] == "on" else ("warned" if blocked else "passed")
 23437	    extra = {}
 23438	    if res["pairs"]:
 23439	        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
 23440	    if notes_:
 23441	        extra["notes"] = sorted(notes_)[:50]
 23442	    _gate_event_or_warn(root, "nodehome-check", kind,
 23443	                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
 23444	                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
 23445	    return 1 if kind == "blocked" else 0
