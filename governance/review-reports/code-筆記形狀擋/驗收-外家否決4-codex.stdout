 22572	def _nodehome_parse_note(raw):
 22573	    """節點原文 → {type, status, about[], resp, sig, text}。sig=(摘要, 解析後的決策, 正文)——[S12] 內容有變
 22574	    逐欄比對用;★不沿用只算正文的那支雜湊★:摘要與決策都在開頭欄位裡,節點長大主要就長在摘要。"""
 22575	    text = raw.decode("utf-8-sig", errors="replace") if isinstance(raw, (bytes, bytearray)) else str(raw)
 22576	    fm_lines, body = split_frontmatter(text)
 22577	    fields = {}
 22578	    dec = ""
 22579	    if fm_lines is not None:
 22580	        fields, _bk, _lint = parse_frontmatter(fm_lines)
 22581	        # 決策比「解析後的值」:只把 content: a 改成 content: "a" 這種等價寫法不算內容有變(第二輪外家席)
 22582	        try:
 22583	            dec = json.dumps(parse_decisions(fm_lines), ensure_ascii=False, sort_keys=True)
 22584	        except Exception:
 22585	            dec = "\n".join(l.rstrip() for l in fm_lines if l.startswith(("decisions:", "  ")))
 22586	    summ = fields.get("summary")
 22587	    summ = summ if isinstance(summ, str) else ""
 22588	    return {"type": str(fields.get("type", "")).strip(),
 22589	            "status": str(fields.get("status", "")).strip(),
 22590	            "about": [str(x) for x in as_list(fields.get("about_code")) if str(x).strip()],
 22591	            "resp": fields.get("responsibility") if isinstance(fields.get("responsibility"), str) else None,
 22592	            # [S11] 從程式重建的章:蓋了章就代表這篇是還原出來的,那它更要說清楚自己管哪些檔
 22593	            "regen": fields.get("regen").strip() if isinstance(fields.get("regen"), str) else "",
 22594	            "sig": ("\n".join(l.rstrip() for l in summ.splitlines()).strip(), dec,
 22595	                    "\n".join(l.rstrip() for l in body.splitlines()).strip()),
 22596	            "text": text}
