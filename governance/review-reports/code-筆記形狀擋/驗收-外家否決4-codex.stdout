 47975	    check("light:keys 沒對到(rc3)不擋,講明 CI 會跑全套", "CI 會跑全套當後盾" in r.stderr, r.stderr[-400:])
 47976	    check("light:改到的東西自主迴圈測試沒提到 → 它只跑讀真 CLAUDE.md 那條(2026-09-18 實測 light 108 秒裡 67 秒是它)", alog.read_text().strip() == "-k real_claude_md", alog.read_text())
 47977	    af = d / "scripts" / "test_autonomous_loop.py"; _af0 = af.read_text()
 47978	    af.write_text(_af0.replace("other_mod", "other_mod 與 main"))
 47979	    r2, _c2 = push(base, g("rev-parse", "HEAD"))
 47980	    af.write_text(_af0)
