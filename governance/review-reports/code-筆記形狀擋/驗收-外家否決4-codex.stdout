 22626	def _nodehome_required(repo_root, side, cfg, vendored_skip):
 22627	    """[S1] 需要家的檔集合,另回檔名不是 UTF-8 的程式檔(永遠寫不進圖譜,只提醒改名或排除)。"""
 22628	    import fnmatch
 22629	    req, bad_names = set(), set()
 22630	    layout = _nodehome_layout(side.all_paths)   # 測試資料夾要旁邊的程式目標有同一種檔
 22631	    for p in side.files:
 22632	        kind = _nodehome_code_kind(p)
 22633	        if kind is None:
 22634	            continue
 22635	        if any(fnmatch.fnmatch(p, g) for g in _NODEHOME_EXCLUDE_GLOBS):
 22636	            continue
 22637	        if p in vendored_skip or _cochange_excluded(p, cfg["ignore"]) or _nodehome_is_test(p, layout):
 22638	            continue
 22639	        if kind == "shebang?":
 22640	            if p in side.shebang:
 22641	                ok = side.shebang[p]
 22642	            elif side.share is not None and p not in side.changed and p in side.share.shebang:
 22643	                ok = side.shebang[p] = side.share.shebang[p]
 22644	            else:
 22645	                head = side._reader(p)
 22646	                ok = side.shebang[p] = _head_is_shebang(head)
 22647	            if not ok:
 22648	                continue
 22649	        try:
 22650	            p.encode("utf-8")
 22651	        except UnicodeEncodeError:
 22652	            bad_names.add(p)
 22653	            continue
 22654	        req.add(p)
 22655	    return req, bad_names
 22656	
