 28102	def _mainline_ref(repo_root, remote_only=False):
 28103	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 28104	    回 (ref 名, sha) 或 None。remote_only=True 只認 upstream(筆記形狀擋:推主線時本地 main 就是要推的頂端,
 28105	    拿它當「已在主線上」會把整批都排除掉)。"""
 28106	    for cand in (("main@{upstream}", "master@{upstream}") if remote_only else ("main@{upstream}", "master@{upstream}", "main", "master")):
 28107	        sha = _lens_full_sha(repo_root, cand)
 28108	        if sha:
 28109	            return cand, sha
 28110	    return None
