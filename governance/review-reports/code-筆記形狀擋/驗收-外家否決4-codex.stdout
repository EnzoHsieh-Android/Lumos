 28094	def _lens_full_sha(repo_root, rev):
 28095	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 28096	    if r is None or r.returncode != 0:
 28097	        return None
 28098	    sha = r.stdout.strip()
 28099	    return sha if _LENS_SHA_RE.match(sha) else None
 28100	
