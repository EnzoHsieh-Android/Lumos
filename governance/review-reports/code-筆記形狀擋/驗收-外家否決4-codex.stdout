 47957	    rg_, calls_g = push(base_g, g("rev-parse", "HEAD"))
 47958	    check("只改圖譜筆記:兩片都帶 --suite docs --graph", rg_.returncode == 0 and len(calls_g) == 2 and all("--suite docs --graph" in c for c in calls_g), f"rc={rg_.returncode}\n{calls_g}\n{rg_.stderr[-400:]}")
 47959	    # r2 通才席:執行器是舊版(認得 --suite、不認得 --graph)→ 退全套,不是硬塞旗標讓它報錯被判紅
