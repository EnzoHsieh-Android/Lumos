 23687	def _ns_is_regen(text):
 23688	    """帶 regen 的重建筆記:照 Check J 看解析後的值(空字串不算;代碼審 r3 外家席:原本看原始文字,`regen: ""` 也算)。"""
 23689	    fm, _b = split_frontmatter(text)
 23690	    if not fm:
 23691	        return False
 23692	    v = parse_frontmatter(fm)[0].get("regen")
 23693	    return isinstance(v, str) and bool(v.strip())
 23694	
 23695	
 23696	def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name, regen=False):
 23697	    """一行新增內容 → [(規則, 片段, 改法)]。by_name(檔名)→ 同名的程式檔清單。"""
 23698	    out = []
 23699	    # [src:路徑:行號] 是從程式碼重建的筆記的出處標記,★只在帶 regen 的筆記的 summary 裡★歸重建守衛(Check J)驗;
 23700	    # 別的地方照一般行號引用判(代碼審 r2 通才席:原本對所有筆記豁免,一般筆記寫 [src:…] 就能夾帶行號)
 23701	    scan = SRC_REF_RE.sub(" ", text) if (regen and region == "summary") else text
 23702	    pins, singles = [], []
 23703	    full, _bare = _node_code_ref_tokens(scan, top_dirs, bare_text=True, anchors=True, keep_fences=True,
 23704	                                        pins=pins, singles=singles,
 23705	                                        exists=lambda x, _s=None: x in files or ("/" not in x and bool(by_name(x))))
 23706	    fix_pin = ("`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
 23707	               "HEAD、分支名、標籤會移動,不算釘住")
 23708	
 23709	    for p, l, s in pins:
 23710	        # 只管程式檔與測試檔——跟沒釘版本時一致(.md、不存在的路徑都不管;代碼審 r1 測試席、r2 外家席)
 23711	        if l and _ns_is_code(p, reader, files) and not _ns_pin_ok(repo_root, p, l, s):
 23712	            out.append(("釘版本不合法", f"`{p}@{s}:{l}`", fix_pin))
 23713	    for p, l in full:
 23714	        if l and _ns_is_code(p, reader, files):
 23715	            out.append(("程式行號引用", f"`{p}:{l}`",
 23716	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{l}`"))
 23717	    for name, l, s in singles:
 23718	        cands = by_name(name)
 23719	        if len(cands) != 1:
 23720	            continue
 23721	        if s is None:
 23722	            out.append(("程式行號引用", f"`{name}:{l}`(= {cands[0]})",
 23723	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{l}`"))
 23724	        elif not _ns_pin_ok(repo_root, cands[0], l, s):
 23725	            out.append(("釘版本不合法", f"`{name}@{s}:{l}`(= {cands[0]})", fix_pin))
 23726	    if region == "summary":
 23727	        m = SYMBOL_RE.match(text.strip())
 23728	        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
 23729	        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
 23730	        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
 23731	        if m and not skip:
 23732	            for _w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
 23733	                out.append(("現況描述沒寫來源", text.strip()[:60],
 23734	                            "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
 23735	    return out
