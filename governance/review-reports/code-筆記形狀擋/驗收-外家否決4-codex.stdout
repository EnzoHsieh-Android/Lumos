 47919	def t_prepush_docs_and_light_run_subset():
 47920	    """推送前掛鉤真跑:純文件推送只叫執行器跑 --suite docs(分片照切);改到程式但 push-check 判 light 且 pitfalls 說 light_ok 的,
 47921	    文件子集與 --suite keys 各自分片平行跑;keys 每片 rc3(沒對到)不擋、講明 CI 會跑全套;keys 有紅(rc1)擋(r1 合約席:這條路原本沒測試走到);
 47922	    範圍裡夾了測試檔(既非文件也非程式)→ light_ok 假 → 全套(r1 資安席);一般程式改動照跑全套。執行器換成把參數記到檔裡的假貨。"""
 47923	    import subprocess as _sp, os as _os
 47924	    hook = str(Path(__file__).resolve().parent / "hooks" / "pre-push")
 47925	    lumos_real = str(Path(__file__).resolve().parent / "lumos")
 47926	    d, kg, p = _sc_setup("prepush-suite")
 47927	    (d / "skills" / "lumos-project-notes").mkdir(parents=True)
 47928	    (d / "scripts").mkdir(exist_ok=True)
 47929	    (d / "scripts" / "lumos").symlink_to(lumos_real)
 47930	    argl = d.parent / "runner-args.log"   # ★放 repo 外★:放裡面會被 fixture 的 git add -A 帶進提交,推送範圍多一支非文件檔、判定就變了
 47931	    (d / "scripts" / "test_lumos.py").write_text(
 47932	        '# 假執行器:認得 "--shard"、"--suite" 與 "--graph"(掛鉤是讀檔找這些字樣);把每次的參數記一行;keys 那趟的離開碼由 FAKE_KEYS_RC 決定(預設 3=沒對到)\n'
 47933	        "import sys, os\n"
 47934	        f"open({str(argl)!r}, 'a').write(' '.join(sys.argv[1:]) + '\\n')\n"
 47935	        "sys.exit(int(os.environ.get('FAKE_KEYS_RC', '3')) if 'keys' in sys.argv else 0)\n")
 47936	    # 假的自主迴圈測試:只記參數到另一個檔(不混進上面的執行器紀錄);原始碼提到 other_mod 這個名字
 47937	    alog = d.parent / "autoloop-args.log"
 47938	    (d / "scripts" / "test_autonomous_loop.py").write_text(
 47939	        "import sys\n# 這支假測試測的是 other_mod\n"
 47940	        f"open({str(alog)!r}, 'a').write(' '.join(sys.argv[1:]) + '\\n')\n")
 47941	    _sg_commit(d, "harness")
 47942	    def g(*a):
 47943	        return _sp.run(["git", "-C", str(d), *a], capture_output=True, text=True).stdout.strip()
 47944	    def push(base, head, **env_extra):
 47945	        env = dict(_os.environ); env["GIT_DIR"] = str(d / ".git"); env["LUMOS_TEST_SHARDS"] = "2"; env.update(env_extra)
 47946	        argl.write_text(""); alog.write_text("")
 47947	        r = _sp.run(["bash", hook], cwd=str(d), input=f"refs/heads/main {head} refs/heads/main {base}\n", capture_output=True, text=True, env=env)
 47948	        return r, argl.read_text().splitlines()
 47949	    base = g("rev-parse", "HEAD")
 47950	    (d / "README.md").write_text("# hi\n"); _sg_commit(d, "docs only")
