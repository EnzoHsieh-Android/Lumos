 22798	def _nodehome_cat_blobs(repo_root, specs):
 22799	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22800	
 22801	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22802	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22803	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 22804	    import subprocess as _sp
 22805	    if not specs:
 22806	        return []
 22807	    if any("\n" in s_ for s_ in specs):
 22808	        return None
 22809	    try:
 22810	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22811	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22812	                    capture_output=True, timeout=60)
 22813	    except (OSError, _sp.TimeoutExpired):
 22814	        return None
 22815	    if r.returncode != 0:
 22816	        return None
 22817	    out, pos, res = r.stdout, 0, []
 22818	    for _ in specs:
 22819	        nl = out.find(b"\n", pos)
 22820	        if nl < 0:
 22821	            return None
 22822	        head = out[pos:nl].split(b" ")
 22823	        pos = nl + 1
 22824	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22825	            size = int(head[2])
 22826	            res.append(out[pos:pos + size])
 22827	            pos += size + 1
 22828	        elif len(head) == 3 and head[2].isdigit():
 22829	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22830	            res.append(None)
 22831	        else:
 22832	            res.append(None)            # missing / ambiguous
 22833	    return res
 22834	
