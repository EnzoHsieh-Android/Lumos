 22966	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 22967	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 22968	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 22969	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 22970	    None=整批當成一個提交(提交前)。"""
 22971	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 22972	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 22973	    homesN, ownN = _nodehome_homes(repo_root, N)
 22974	    homesB, ownB = _nodehome_homes(repo_root, B)
 22975	    blocks, reminders, pairs = [], [], []
 22976	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 22977	    for code, old, new in changes:
 22978	        if old is not None and (new is None or code == "R"):
 22979	            deleted.add(old)
 22980	        if new is None:
 22981	            continue
 22982	        changed_new.add(new)
 22983	        if code in ("A", "R", "C"):
 22984	            added.add(new)
 22985	        if code == "R" and old:
 22986	            renamed_from[new] = old
 22987	    code_changed = {p for p in changed_new if p in reqN}
 22988	    code_added = {p for p in added if p in reqN}
 22989	    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
 22990	    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
 22991	    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
 22992	    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
 22993	    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
 22994	    code_touched = code_changed | code_deleted
 22995	    vpre = vault_rel + "/"
 22996	    refs_cache = {}
 22997	
 22998	    def refs_now(rel):
 22999	        if rel not in refs_cache:
 23000	            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
 23001	        return refs_cache[rel]
 23002	
 23003	    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]
 23004	    edited = set()
 23005	    for p in sorted(changed_new):
 23006	        if not (p.startswith(vpre + "Systems/") and p.endswith(".md")):
 23007	            continue
 23008	        rel = p[len(vpre):]
 23009	        if rel not in N.notes:
 23010	            continue
 23011	        n = N.notes[rel]
 23012	        src = renamed_from.get(p)
 23013	        src_rel = src[len(vpre):] if src and src.startswith(vpre) else rel
 23014	        b = B.notes.get(src_rel)
 23015	        if n["type"] != "system":
 23016	            continue
 23017	        edited.add(rel)
 23018	        route_src[rel] = src_rel
 23019	        if (b is None or b["sig"] != n["sig"]) and n["status"] in _NODEHOME_HOME_STATUSES:
 23020	            content_changed.append(rel)

