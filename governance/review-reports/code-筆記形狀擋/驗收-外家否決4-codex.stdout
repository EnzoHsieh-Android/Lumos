 22464	def _nodehome_code_kind(path):
 22465	    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
 22466	    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
 22467	    base = path.rsplit("/", 1)[-1]
 22468	    stripped = base.lstrip(".")
 22469	    if "." in stripped:
 22470	        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
 22471	    return "shebang?"
