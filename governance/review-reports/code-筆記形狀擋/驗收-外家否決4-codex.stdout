 23931	def cmd_note_shape(repo=None, staged=False, diff_range=None):
 23932	    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
 23933	    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
 23934	    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
 23935	    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
 23936	    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
 23937	    root = Path(repo).resolve() if repo else None
 23938	    if root is None:
 23939	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 23940	        if r is None or r.returncode != 0:
 23941	            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23942	            return 0
 23943	        root = Path(r.stdout.strip())
 23944	    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
 23945	    if r is None or r.returncode != 0:
 23946	        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23947	        return 0
 23948	    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE"):
 23949	        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
 23950	        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
 23951	        return 0
 23952	    if staged:
 23953	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 23954	        if mh is not None and mh.returncode == 0:
 23955	            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
 23956	            return 0
 23957	        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
 23958	    else:
 23959	        rg = _lens_range_ok(diff_range)
 23960	        if rg is None:
 23961	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 23962	            return 2
 23963	        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 23964	        if sh is not None and sh.stdout.strip() == "true":
 23965	            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
 23966	                  file=sys.stderr)
 23967	            _gate_event_or_warn(root, "note-shape", "skipped-env", "shallow clone")
 23968	            return 0
 23969	        a, b = rg
 23970	        tip = _lens_full_sha(root, b)
 23971	        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
 23972	        if tip is None or base is None:
 23973	            print(f"筆記形狀擋:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
 23974	            return 0
 23975	        base = _nodehome_clamp_base(root, base, tip, _NOTE_SHAPE_GOLIVE_MARK)
 23976	        base_where = None if base == _EMPTY_TREE_SHA else base
 23977	        tip_where, mode_word = tip, "這次推送"
 23978	    lst = _nodehome_list(root, tip_where)
 23979	    if lst is None:
 23980	        print("筆記形狀擋:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23981	        return 0
 23982	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 23983	    if not vaults:
 23984	        print("筆記形狀擋:這個專案沒有圖譜,跳過")
 23985	        return 0
 23986	    wv = _vault_in(root)
 23987	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23988	    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 23989	    mode, warns = _note_shape_config(_nodehome_reader(root, tip_where)(".lumos/config.json"))
 23990	    for w in warns:
 23991	        print(f"提醒:{w}", file=sys.stderr)
 23992	    if mode == "off":
 23993	        print("筆記形狀擋:這個專案把這道檢查關掉了(note_shape.gate=off),跳過", file=sys.stderr)
 23994	        return 0
 23995	    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel)
 23996	    if res is None:
 23997	        print("筆記形狀擋:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
 23998	        return 0
 23999	    viol, errs = res
 24000	    if not viol and not errs:
 24001	        return 0
 24002	    head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
 24003	    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
 24004	    for e in errs:
 24005	        print(f"  {e}", file=sys.stderr)
 24006	    for p, n, rule, frag, fix in viol:
 24007	        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
 24008	    if mode == "block":
 24009	        print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
 24010	              "推得出來的一寫進去就會過期——見 Projects/筆記形狀擋_計劃。", file=sys.stderr)
 24011	        _gate_event_or_warn(root, "note-shape", "blocked", f"{mode_word}:新違規 {len(viol) + len(errs)} 條",
 24012	                            hard=True, nodes=sorted({v[0] for v in viol} | {e.split(':', 1)[0] for e in errs})[:50])
 24013	        return 1
 24014	    # warn 模式有違規也記一筆(照鄰居的 warned;沒違規的放行才不寫——代碼審 r1 架構對齊席)
 24015	    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
 24016	                        nodes=sorted({v[0] for v in viol})[:50])
 24017	    return 0
