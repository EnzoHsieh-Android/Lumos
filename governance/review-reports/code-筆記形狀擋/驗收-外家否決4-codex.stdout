 19944	def _path_at_pin(repo_root, path, pin):
 19945	    """釘的提交(合法釘版本才算)裡有沒有這支檔。pin 為 None 或不合法 → False。"""
 19946	    sha = _pin_commit(repo_root, pin) if pin else None
 19947	    if not sha:
 19948	        return False
 19949	    r = _lens_git(repo_root, "cat-file", "-e", f"{sha}:{path}")
 19950	    return r is not None and r.returncode == 0
