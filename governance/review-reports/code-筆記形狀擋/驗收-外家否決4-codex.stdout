 22529	def _nodehome_changed_vs_disk(repo_root, where):
 22530	    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
 22531	    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
 22532	    if where == "index":
 22533	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
 22534	    else:
 22535	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
 22536	    if raw is None:
 22537	        return None
 22538	    return {nfc(x) for x in _nodehome_split_z(raw)}
 22539	
 22540	
 22541	def _nodehome_reader(repo_root, where):
 22542	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 22543	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 22544	    if where is None:
 22545	        return lambda p: None
 22546	    disk_ok_all = False
 22547	    differ = None
 22548	    if where == "index":
 22549	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 22550	    else:
 22551	        head = _lens_full_sha(repo_root, "HEAD")
 22552	        if head and head == where:
 22553	            differ = _nodehome_changed_vs_disk(repo_root, where)
 22554	    root = Path(repo_root)
 22555	    spec = "" if where == "index" else where
 22556	
 22557	    def read(p):
 22558	        if differ is not None and p not in differ:
 22559	            fp = root / p
 22560	            try:
 22561	                if fp.is_file() and not fp.is_symlink():
 22562	                    return fp.read_bytes()
 22563	            except OSError:
 22564	                pass
 22565	        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
 22566	        if r is None or r.returncode != 0:
 22567	            return None
 22568	        return r.stdout
 22569	    return read
 22570	
