 22704	def _nodehome_changes(repo_root, base, tip):
 22705	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22706	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22707	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22708	    if tip == "index":
 22709	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22710	        if base is None:
 22711	            args.append(_EMPTY_TREE_SHA)
 22712	    else:
 22713	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 22714	    raw = _nodehome_git(repo_root, *args)
 22715	    if raw is None:
 22716	        return None
 22717	    toks = _nodehome_split_z(raw)
 22718	    out, i = [], 0
 22719	    while i < len(toks):
 22720	        st = toks[i]
 22721	        code = st[:1]
 22722	        if code in ("R", "C") and i + 2 < len(toks):
 22723	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 22724	            i += 3
 22725	        elif i + 1 < len(toks):
 22726	            p = nfc(toks[i + 1])
 22727	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 22728	            i += 2
 22729	        else:
 22730	            break
 22731	    return out
 22732	
 22733	
 22734	def _nodehome_name_status(raw):
 22735	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
 22736	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 22737	    while i < len(toks):
 22738	        code = toks[i][:1]
 22739	        if code in ("R", "C") and i + 2 < len(toks):
 22740	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 22741	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 22742	            if code == "R":
 22743	                gone.add(nfc(toks[i + 1]))
 22744	            i += 3
 22745	        elif i + 1 < len(toks):
 22746	            paths.add(nfc(toks[i + 1]))
 22747	            if code == "D":
 22748	                gone.add(nfc(toks[i + 1]))
 22749	            i += 2
 22750	        else:
 22751	            break
 22752	    return paths, src, gone - set(src)
 22753	
 22754	
 22755	def _nodehome_merge_own_changes(repo_root, sha, parents):
 22756	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 22757	
 22758	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 22759	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 22760	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 22761	    或順手多改的部分,正是這道檢查要看的。
 22762	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 22763	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 22764	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 22765	    """
 22766	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 22767	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22768	        return None
 22769	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 22770	                      "--name-status", "-z", "-M", sha)
 22771	    if r is None:
 22772	        return None
 22773	    paths, src, gone = _nodehome_name_status(r)
 22774	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 22775	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 22776	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 22777	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 22778	    for p in parents:
 22779	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22780	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22781	    order = sorted(paths)
 22782	    specs = []
 22783	    for x in order:
 22784	        specs.append(f"{sha}:{x}")
 22785	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 22786	    blobs = _nodehome_cat_blobs(repo_root, specs)
 22787	    if blobs is None or any(ren is None for _, ren in pairs):
 22788	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 22789	        return paths, src, gone
 22790	    kept = set()
 22791	    for n, x in enumerate(order):
 22792	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 22793	        if _nodehome_merge_wrote_new_lines(merged, olds):
 22794	            kept.add(x)
 22795	    return kept, {k: v for k, v in src.items() if k in kept}, gone
