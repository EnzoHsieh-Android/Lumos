 24693	# 純文件推送只跑文件子集(2026-09-18 Enzo 裁「像這種改動 CI 可以跳過吧,跟程式碼無關」):
 24694	# 兩層白名單都要過才算純文件:★路徑★在 _DOCS_ONLY_PATHS 裡(不在的——scripts/、skills/、.github/、slim/…——一律跑全套;
 24695	# skills/ 的 markdown 是 lumos 自己讀進去用的、被幾十支測試驗,不算文件),而且★副檔名★在 _DOCS_ONLY_EXTS 裡(比對不分大小寫)。
 24696	# 第一版是「路徑在白名單、且副檔名不在程式清單」——代碼審 r1 邊界席(blocker)與正確性席各繞過一次:governance/ 底下放 .rb/.dart(清單沒收的語言)
 24697	# 或 .PY(大小寫)就被當文件。反過來列「什麼才算文件」才擋得住不認得的東西;沒副檔名的(Makefile、無名腳本)一律不算文件。
 24698	# 執行器那邊 `--suite docs` 直接讀這兩個常數挑「原始碼提到這些路徑」的測試(架構席 r1:別抄第二份)。
 24699	_DOCS_ONLY_PATHS = ("README.md", "README.en.md", "CLAUDE.md", "AGENTS.md", "CHANGELOG.md", "ARCHITECTURE.md",
 24700	                    "ONBOARDING.md", "RELEASING.md", "SDD-vs-Lumos.md", "SDD-vs-Lumos.en.md", "LICENSE",
 24701	                    "docs/", "assets/", "diagrams/", "governance/")
 24702	_DOCS_ONLY_EXTS = (".md", ".svg", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".txt", ".json", ".jsonl", ".csv")
 24703	# 在白名單目錄裡但★不是文件、是守衛本身★的:hook 防竄改基準線(改它等於改守衛,而驗它的測試只在全套裡)、代碼審留痕(pass 綁版本)。
 24704	# 碰到任一支就全套(代碼審 r3 資安席:只推基準線會被當純文件,連 t_anchor 都跳過——兩段式竄改的第一步)。
 24705	_DOCS_ONLY_NEVER = ("governance/anchor-baseline.json", "governance/code-loop/")
 24706	
