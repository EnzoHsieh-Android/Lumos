 48282	def t_note_shape_block_message_and_fail_open():
 48283	    """[S7] 擋下印檔、行、規則、改法與「內容還在工作目錄」;不改筆記與暫存區;只有擋下寫事件、放行不寫;
 48284	    不是 git 時放行並說一句。"""
 48285	    print("t_note_shape_block_message_and_fail_open")
 48286	    root = _ns_repo()
 48287	    _ns_note(root, body="新寫 `src/a.py:5`")
 48288	    _ns_stage(root)
 48289	    before = _nh_git(root, "diff", "--cached").stdout + _nh_git(root, "diff", "--", "docs/kg-knowledge").stdout
 48290	    rc, out = _ns(root)
 48291	    after = _nh_git(root, "diff", "--cached").stdout + _nh_git(root, "diff", "--", "docs/kg-knowledge").stdout
 48292	    check("①擋下訊息有檔、行號、規則、改法、內容還在", rc == 1 and all(x in out for x in ("A.md", "行號引用", "@", "內容還在工作目錄")), out[-600:])
 48293	    check("②不改筆記與暫存區", before == after, "")
 48294	    ev = [e for e in _ns_gov(root) if e.get("gate") == "note-shape"]
 48295	    check("③擋下寫一筆 blocked", any(e.get("kind") == "blocked" for e in ev), str(ev)[-300:])
 48296	    _ns_reset(root)
 48297	    n0 = len([e for e in _ns_gov(root) if e.get("gate") == "note-shape"])
 48298	    _ns_note(root, body="乾淨的一行")
 48299	    _ns_stage(root)
 48300	    rc, out = _ns(root)
 48301	    check("④放行 rc0 且不寫事件", rc == 0 and len([e for e in _ns_gov(root) if e.get("gate") == "note-shape"]) == n0, out[-300:])
 48302	    nogit = Path(tempfile.mkdtemp(prefix="gctl-ns-nogit-"))
 48303	    rc, out = _ns(nogit)
 48304	    check("⑤不是 git:放行並說一句", rc == 0 and out.strip(), out[-300:])
 48305	
