 23706	        if _nodehome_code_kind(p) is not None and _ns_is_code(p, reader, files):
 23707	            by_name.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23708	    viol, errs = [], []
 23709	    # 1) 這次新增的行
 23710	    if staged:
 23711	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23712	        if d is None:
 23713	            return None
 23714	        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
 23715	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23716	        texts = None
 23717	    else:
 23718	        ra = _ns_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote)
 23719	        if ra is None:
 23720	            return None
 23721	        texts, paths = ra
 23722	        cand = {p: None for p in paths}
 23723	    for p, linenos in sorted(cand.items()):
 23724	        b = reader(p)
 23725	        if b is None:
 23726	            continue
 23727	        try:
 23728	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 23729	        except UnicodeDecodeError:
 23730	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 23731	            continue
 23732	        lines = text.split("\n")
 23733	        regs = _ns_regions(text)
 23734	        for i, ln in enumerate(lines, 1):
 23735	            if linenos is not None and i not in linenos:
 23736	                continue
 23737	            if texts is not None and ln.strip() not in texts:
 23738	                continue
 23739	            if not ln.strip() or regs[i - 1] == "other":
 23740	                continue
 23741	            for rule, frag, fix in _ns_check_line(repo_root, ln, regs[i - 1], files, reader, top_dirs, by_name):
 23742	                viol.append((p, i, rule, frag, fix))
 23743	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 23744	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 23745	                             tip_where, reader)
 23746	    if became:
 23747	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 23748	        if gl is not None:
 23749	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 23750	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 23751	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 23752	            spec = "" if tip_where == "index" else tip_where
 23753	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 23754	            gl_reader = _nodehome_reader(repo_root, gl)
 23755	            seen = {(v[0], v[1]) for v in viol}
 23756	            for p, blob in zip(notes_, blobs):
 23757	                if blob is None:
 23758	                    continue
 23759	                text = blob.decode("utf-8-sig", errors="replace")
 23760	                if not any(x in text for x in became):
 23761	                    continue
 23762	                old = None
 23763	                for n, ln in enumerate(text.split("\n"), 1):
 23764	                    if (p, n) in seen or not any(x in ln for x in became):
