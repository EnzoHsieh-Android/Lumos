 def cmd_note_shape(repo=None, staged=False, diff_range=None):
     """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
     不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
     ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
-    只有擋下與跳過寫治理帳,放行不寫——刻意跟每支檔有家每次都寫 passed 不同:每次提交一筆沒資訊的行正是
-    rtb 回饋抱怨的帳本雜訊。"""
+    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
+    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
     root = Path(repo).resolve() if repo else None
     if root is None:
         r = _lens_git(".", "rev-parse", "--show-toplevel")
         if r is None or r.returncode != 0:
             print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
             return 0
         root = Path(r.stdout.strip())
     r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
     if r is None or r.returncode != 0:
         print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
