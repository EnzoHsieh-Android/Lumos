 48072	def t_note_shape_line_refs_existing_code_new_only():
 48073	    """[S1] 新增行裡指向真的存在的程式檔或測試檔的行號引用要擋(反引號、裸寫、#L、圍欄內、無副檔名 #! 主程式、
 48074	    唯一的單一檔名);指向不存在路徑或 .md 的不擋;沒改動的舊行不擋。"""
 48075	    print("t_note_shape_line_refs_existing_code_new_only")
 48076	    root = _ns_repo()
 48077	    _nh_file(root, "src/run", "#!/usr/bin/env python3\nprint(1)\nprint(2)\n")
 48078	    _ns_note(root, body="舊的引用 `src/a.py:3` 上線前就在。")
 48079	    _nh_commit(root, "old ref")
 48080	    cases = [
 48081	        ("反引號", "新寫 `src/a.py:5` 那一行", True),
 48082	        ("裸寫", "新寫 src/a.py:6 那一行", True),
 48083	        ("#L", "新寫 `src/a.py#L7` 那一行", True),
 48084	        ("無副檔名主程式", "新寫 `src/run:2`", True),
 48085	        ("唯一單一檔名", "新寫 a.py:4 這裡", True),
 48086	        ("圍欄內", "```\nTraceback src/a.py:8\n```", True),
 48087	        ("不存在的路徑", "舉例 `src/nope.py:4`", False),
 48088	        (".md 文件", "見 `README.md:1`", False),
 48089	    ]
 48090	    for label, add, want_block in cases:
 48091	        _ns_note(root, body="舊的引用 `src/a.py:3` 上線前就在。\n" + add)
 48092	        _ns_stage(root)
 48093	        rc, out = _ns(root)
 48094	        check(f"①{label}:{'擋' if want_block else '不擋'}", (rc == 1) == want_block, out[-500:])
 48095	        if want_block:
 48096	            check(f"②{label}:舊行 src/a.py:3 不列", "a.py:3" not in out.replace("a.py:3 ", "a.py:3 ") or out.count("`src/a.py:3`") == 0, out[-500:])
 48097	        _ns_reset(root)
 48098	
