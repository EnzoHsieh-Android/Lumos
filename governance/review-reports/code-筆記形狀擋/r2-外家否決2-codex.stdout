   176	# Gate 2: 沒 code → 放行
   177	[[ ${#src_files[@]} -eq 0 ]] && exit 0
   178	
   179	# Gate 3: 有圖譜 .md staged → 放行(「該動卻沒動」的點名已由上面的 Gate H 照家算好印出,2026-09-11)
   180	if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
   181	  exit 0
   182	fi
