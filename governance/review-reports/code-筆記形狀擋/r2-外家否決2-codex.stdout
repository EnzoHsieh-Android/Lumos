 23543	def _ns_mainline_refs(repo_root):
 23544	    """各遠端的預設分支參照(refs/remotes/<遠端>/HEAD 指到的那條,沒有就 main、master)。
 23545	    推送範圍只排除「已經在主線上」的提交——★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
 23546	    那些提交從沒被查過(代碼審 r1 單reviewer 與外家席各自實測繞過)。"""
 23547	    rr = _lens_git(repo_root, "remote")
 23548	    remotes = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 23549	    out = []
