 48210	def t_note_lines_merge_commit_new_lines_only():
 48211	    """[S5] 提交前正在合併要跳過;推送前合併提交只查合併結果裡每個上一版都沒有的行;已在遠端追蹤分支上的提交不重查。"""
 48212	    print("t_note_lines_merge_commit_new_lines_only")
 48213	    root = _ns_repo()
 48214	    m0 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48215	    _nh_git(root, "checkout", "-qb", "side")
 48216	    _ns_note(root, body="side 帶進來的 `src/a.py:4`")
 48217	    _nh_commit(root, "side")
 48218	    s1 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48219	    _nh_git(root, "checkout", "-q", "master") if _nh_git(root, "rev-parse", "-q", "--verify", "master").returncode == 0 else _nh_git(root, "checkout", "-q", "main")
 48220	    _nh_file(root, "src/other.py", "y = 1\n")
 48221	    _nh_commit(root, "main side work")
 48222	    _nh_git(root, "merge", "-q", "--no-edit", "--no-ff", "side")
 48223	    m2 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48224	    rc, out = _ns(root, "--diff", f"{s1}..{m2}")
 48225	    check("①合併只把上一版帶進來的行接起來:不擋", rc == 0, out[-500:])
 48226	    note = root / "docs" / "kg-knowledge" / "Systems" / "A.md"
 48227	    note.write_text(note.read_text(encoding="utf-8") + "合併時新寫 `src/a.py:7`\n", encoding="utf-8")
 48228	    _nh_git(root, "add", "-A")
 48229	    _nh_git(root, "commit", "-q", "--amend", "--no-edit", "--no-verify")
 48230	    m2b = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48231	    rc, out = _ns(root, "--diff", f"{s1}..{m2b}")
 48232	    check("②合併時新寫的行照擋", rc == 1 and "a.py:7" in out and "a.py:4" not in out, out[-500:])
 48233	    import subprocess as sp
 48234	    bare = Path(tempfile.mkdtemp(prefix="gctl-ns-remote-")) / "r.git"
 48235	    sp.run(["git", "init", "-q", "--bare", str(bare)], capture_output=True)
 48236	    _nh_git(root, "remote", "add", "origin", str(bare))
 48237	    # ③只排除「已經在主線上」的提交(遠端預設分支):side 的內容推進遠端 main 之後,再推含它的合併就不重查
 48238	    #   (只在別的遠端分支上、還沒進主線的照查,見 t_note_shape_code_review_r1_regressions ③)
 48239	    _nh_git(root, "push", "-q", "--no-verify", "origin", "side:main")
 48240	    _nh_git(root, "fetch", "-q", "origin")
 48241	    rc, out = _ns(root, "--diff", f"{m0}..{m2}")
 48242	    check("③已在遠端主線上的提交(side)不重查", rc == 0, out[-500:])
 48243	    _nh_git(root, "checkout", "-q", "side")
 48244	    _nh_git(root, "checkout", "-q", "-b", "tmp", m0)
 48245	    _nh_git(root, "merge", "-q", "--no-commit", "--no-ff", "side")
 48246	    rc, out = _ns(root)
 48247	    check("④提交前正在合併:跳過並說一句", rc == 0 and "合併" in out, out[-300:])
 48248	
