 48375	def t_doctor_note_shape_ci_and_bypass_scan():
 48376	    """[S11] doctor:CI 沒呼叫 note-shape --diff 或沒抓完整歷史時印一行;列出上線點之後已推上遠端卻違反規則的新增行。"""
