 48250	def t_note_lines_scope_rename_and_non_utf8():
 48251	    """[S6] 行的範圍:正文、summary、decisions(含巢狀清單)算;其他開頭欄位與 decisions 結構鍵不算;
 48252	    改名認成同一篇(舊行不重查);讀不成 UTF-8 的筆記 rc1 並指名。"""
 48253	    print("t_note_lines_scope_rename_and_non_utf8")
 48254	    root = _ns_repo()
 48255	    cases = [
 48256	        ("summary", dict(summary="KEY:x\nWHY:[2026-09-27] 見 `src/a.py:3`"), True),
 48257	        ("decisions 巢狀", dict(extra="decisions:\n  - id: d1\n    content: 選 A\n    alternatives_considered:\n      - 見 `src/a.py:3` 那段"), True),
 48258	        ("aliases", dict(extra="links:\n  - \"src/a.py:3\""), False),
 48259	    ]
 48260	    for label, kw, want_block in cases:
 48261	        _ns_note(root, **kw)
 48262	        _ns_stage(root)
 48263	        rc, out = _ns(root)
 48264	        check(f"①{label}:{'算' if want_block else '不算'}", (rc == 1) == want_block, out[-500:])
 48265	        _ns_reset(root)
 48266	    _ns_note(root, body="舊的 `src/a.py:3`")
 48267	    _nh_commit(root, "old")
 48268	    _nh_git(root, "config", "diff.renames", "false")      # 關掉 git 預設的改名偵測:只有程式自己帶 -M 才認得出改名(代碼審 r1 測試席)
 48269	    _nh_git(root, "mv", "docs/kg-knowledge/Systems/A.md", "docs/kg-knowledge/Systems/A2.md")
 48270	    p = root / "docs" / "kg-knowledge" / "Systems" / "A2.md"
 48271	    p.write_text(p.read_text(encoding="utf-8") + "新增一行乾淨的\n", encoding="utf-8")
 48272	    _ns_stage(root)
 48273	    rc, out = _ns(root)
 48274	    check("②改名認成同一篇:舊行不重查", rc == 0, out[-500:])
 48275	    _ns_reset(root)
 48276	    (root / "docs" / "kg-knowledge" / "Systems" / "Bad.md").write_bytes(b"---\ntype: system\n---\n\xff\xfe bad\n")
 48277	    _ns_stage(root)
 48278	    rc, out = _ns(root)
 48279	    check("③讀不成 UTF-8:rc1 並指名那支檔", rc == 1 and "Bad.md" in out, out[-400:])
 48280	
