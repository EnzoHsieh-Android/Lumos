 48410	    _nh_file(root, "src/new.py", "a = 1\nb = 2\nc = 3\n")
 48411	    _nh_file(root, "src/old.py", "a = 1\nb = 2\n")
 48412	    _nh_commit(root, "files later")
 48413	    tip = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
