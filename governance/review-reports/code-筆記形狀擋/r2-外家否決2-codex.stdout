 48402	    _ns_note(root, body="上線前寫的 `src/old.py:2`")
 48403	    _nh_commit(root, "old ref before golive")
 48404	    _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n# " + _NS_HOOK_LINE + "\n")
 48405	    _nh_commit(root, "golive")
