BlockSpan = namedtuple("BlockSpan", "body body_start body_end")
# Task 2: ReInjectResult ─ status ∈ created|updated|unchanged|appended|sentinel_broken|no_template
ReInjectResult = namedtuple("ReInjectResult", "status diff")

# ★FENCE_RE 已於 2026-08-03 移除,不要再加回來★——它有兩個致命假設:
#   ①圍欄成對(未閉合就看不見) ②標記在第 0 欄(收尾縮排會與下一個區塊錯配、
#   把中間的真散文整段吞掉)。這兩個假設在 code-loop r2/r4 各造成實測的靜默錯答:
#   幽靈圖譜邊、假合約佐證、G1 硬閘對壞引用放行、impact hook 漏掉合約節點。
# ★一律改用 `_visible_lines`(全檔唯一的 fence 判定)★:
#   要「剝圍欄 + 剝 inline code」→ `_strip_code_text`
#   要「只剝圍欄、★保留 inline code★」→ `_strip_fences_text`(refcheck 家族要這個)
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
_DOUBLE_BACKTICK_RE = re.compile(r"``.+?``")


def _strip_inline_markup(line):
    """行內層級的「哪些字看得見」——跟 `_visible_lines`(行層級)配成一對,★全檔唯一★,別在別處自寫第二份
    (條款綁定 -b r2 架構席:三條規則散在 clause_bindings 裡就是第二份)。
    剝:雙反引號 span、單反引號 span(INLINE_CODE_RE);★未閉合的反引號之後一律不信★(程式碼範例裡的 [test:]/[manual:] 不能當證據,寧可少認)。
    ★不碰 HTML 註解★:-b r3 兩席證明「偵測註解」本身就是洞(先關再開、註解正則不認反引號邊界),註解裡的 [SN] 一律走「認不得→擋」。
    回 (看得見的文字, 有沒有因未閉合反引號截掉東西)。search 的 probe 刻意只用 INLINE_CODE_RE 不走這裡:搜尋寧可多看見,截掉=靜默看不見(2026-08-03 那個坑)。"""
    s = INLINE_CODE_RE.sub("", _DOUBLE_BACKTICK_RE.sub("", line))
    if "`" in s:
        return s.split("`", 1)[0], True
    return s, False
WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")
DATE_PREFIX_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})")
TOP_KEY_RE = re.compile(r"^([A-Za-z_][\w-]*):\s*(.*)$")
LIST_ITEM_RE = re.compile(r"^\s+-\s+(.*)$")
QUOTED_DATE_RE = re.compile(
    r'^\s*(?:-\s+)?(?:date|created|updated|decided|ended):\s*"\d{4}-\d{2}-\d{2}"')
RULE3_RE = re.compile(r"^\s+-\s+\w+: [^\"'|>\s][^\"']*: \S")  # 未引號值含 ": "


def nfc(s):
    return unicodedata.normalize("NFC", s)


def strip_quotes(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    return s


def _posix_norm(s):
    """路徑比對鍵的共用正規化:反斜線轉斜線、去 ./ 與 a/../b(純字面,不查檔案);空的回空字串。
    工具自裝檔判別、about_code 的比對、排序加分讀 about_code 共用這一個(2026-09-10 代碼審 r3 架構席/整合席:
    原本三處各寫一份,排序那側只剝開頭的 ./,不解 ..)。"""
    import posixpath
    v = str(s).strip().replace("\\", "/")
    return posixpath.normpath(v) if v else ""


_SINGLE_WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")   # 整個值恰好是一個連結(fullmatch 用;讀側索引與寫側判斷共用)


def _multi_link_value(s):
    """清單欄位的一個值裡有兩個以上連結開頭——一項只能是一個連結或一個值。
    讀的一側(parse_frontmatter 的 lint)與寫的一側(_list_scalar_value)共用這一個判斷(2026-09-10 代碼審 r3 架構席:
    原本讀側只認 `]], [[` 與 `]],[[`,寫側看兩個以上 [[,`[[A]],  [[B]]` 讀側不吭聲、寫側卻擋)。
    只用在清單欄位:散文欄位(例如 valid_under)講到兩個連結是正常的。"""
    return str(s).count("[[") > 1


def link_target(s):
    """從 wikilink 字串/list 項抽**完整 target**(去 [[]]、alias、heading、引號;**保留路徑**)。
    `[[Verification/X|y]]` → `Verification/X`。寫側 dedup 用它做精確比對:
    既修子字串誤判(A vs A_v2 不同),又不像 basename-only 把跨資料夾 Systems/X vs
    Verification/X 誤判相同(2026-06-13 第二輪審計 NEW-A)。"""
    t = strip_quotes(str(s).strip())
    t = t.replace("[[", "").replace("]]", "")
    t = t.split("|")[0].split("#")[0].strip()
    if t.lower().endswith(".md"):
        t = t[:-3]
    return nfc(t)


def split_frontmatter(text):
    """回傳 (fm_lines or None, body)"""
    if not text.startswith("---"):
        return None, text
    lines = text.split("\n")
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1:])
    return None, text


def parse_frontmatter(fm_lines):
    """極簡 parser(本 vault 慣例範圍): top-level 純量 + 字串 list + block scalar 內文。
    回傳 (fields, block_keys, lint)
      fields: dict[key] = str | list[str];block scalar 的 key 也存內文(供 context 用)
      block_keys: block scalar 的 key 集合(其值內的 [[..]] 不得索引,鐵則 2)
      lint: 鐵則指紋發現
    """
    fields, block_keys, lint = {}, set(), []
    seen = set()
    i, n = 0, len(fm_lines)
    while i < n:
        line = fm_lines[i]
        m = TOP_KEY_RE.match(line)
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        if key in seen:
            lint.append(f"同一層欄位名重複,工具不知道該信哪個: {key}")
        seen.add(key)
        if val in ("|", "|-", ">", ">-"):
            block = []
            i += 1
            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
                if fm_lines[i].strip():
                    block.append(fm_lines[i].strip())
                i += 1
            fields[key] = "\n".join(block)
            block_keys.add(key)
            continue
        if val == "":
            items = []
            i += 1
            while i < n:
                l2 = fm_lines[i]
                if not l2.strip():
                    i += 1
                    continue
                if not l2.startswith(" "):
                    break
                ms = LIST_ITEM_RE.match(l2)
    print(f"{C['Y']}{C['B']}⚠ 發現 {issues} 個 issue{C['X']} ({len(notes)} 篇){_soft_tail()}")
    return 1 if strict else 0


# ═══════════════════════ 階段二: 讀側 ═══════════════════════

# ★摘要符號詞彙表的單一來源★(2026-09-15,plan:[[Projects/標籤系統精簡_計劃]] S10):
# 原本這裡與 SYMBOLISH_RE 那邊各寫死一份九值,只改一份會讓「已收編」只有一半是真的
# ——搜尋會把命中行標成錯的符號區域,而單篇快檢卻說沒問題。
# PRIOR-ART / REVISIT 兩個是紀律文件明文要求寫的(CLAUDE.md 設計段與鐵則四),
# 之前不在表內:前者含連字號、連抓錯字的正則都比對不到(加白名單是無效動作),
# 後者會被當成打錯字唸——兩種相反的壞法。
# 2026-09-21 補四個:紀律範本改成「程式碼為主」之後,寫筆記要先分「程式碼推不推得出來」,
# 分類前綴是 WHY(當初為什麼這樣決定)/RULE(程式看不到的限制)/PITFALL(踩過的坑)/
# FACT(現況描述,要標以程式碼為準並附查詢指令)。範本叫人寫、工具卻不認的話,
# 那幾行會被 lint 唸成打錯字,也不會被當成摘要行——規範直接空轉。
SYMBOL_NAMES = {"KEY", "FLOW", "DEP", "TEST", "AUTH", "FLAG", "DECISION", "VERIFY", "CORE",
                "PRIOR-ART", "REVISIT",
                "WHY", "RULE", "PITFALL", "FACT"}
SYMBOL_RE = re.compile(r"^(" + "|".join(sorted(SYMBOL_NAMES, key=len, reverse=True)) + r"):")

# ★脈絡標記的「同一行還要有什麼」★(2026-09-21 第三階段;單源=紀律範本〈寫筆記時〉那一節)
# 只唸警告不擋:規則是寫給人判斷的,機械只能看形狀,判錯就擋會逼人繞過去。
# ★只套四個新前綴★:FLOW:/DEP: 在本 repo 就有 277 行舊的,一開就是幾百條警告——
# 「誤報多過真報」的機制活不過一週,舊帳不追改,新寫的現況描述請改用 FACT:。
# RETIRE-IF:連續兩個月零觸發(大家本來就寫對了),或誤報多過真報 → 撤掉這一段。
# REVISIT:2026-11-21 看觸發統計,順便決定要不要延伸到 FLOW:/DEP:。
_CTX_REGRESS_RE = re.compile(r"\[test:|重現|repro", re.I)
_CTX_QUERY_RE = re.compile(r"`[^`]{6,}`")          # 一條可重跑的查詢指令(反引號包起來)
# 出處 = 日期 / 決策編號 / [[節點]] / 既有的 [src:] 標記 / 真的像 sha 的字串
# (★不收純數字★:2026-09-21 通才席 F5——原本 [0-9a-f]{7,40} 讓任意 7 位數字都算出處)
_CTX_SRC_RE = re.compile(r"20\d\d-\d\d-\d\d|#d\d+|\[\[|\[src:|\bd\d+\b"
                         r"|\b(?=[0-9a-f]{7,40}\b)[0-9a-f]*[a-f][0-9a-f]*\b")

# 前綴 → (判定函式, 缺什麼的白話, 怎麼補)
_CONTEXT_MARKER_RULES = {
    "WHY": (lambda s: bool(_CTX_SRC_RE.search(s)),
            "出處",
            "行內補一個日期、決策編號(#d3)、提交 sha 或 [[節點]],不然下一個人沒辦法查證這句話"),
    "PITFALL": (lambda s: bool(_CTX_REGRESS_RE.search(s)),
                "防回歸",
                "補 [test:測試名],或寫一條會重現的指令;兩個都沒有,這條只是感想"),
    "FACT": (lambda s: bool(_CTX_SOURCE_RE.search(s)),
             "程式碼答不了的來源",
             "只准寫程式碼答不了的現況,同一行帶 [來源:部署]、[來源:資料庫]、[來源:生產]、[來源:外部]、[來源:人工] 其中之一;"
             "程式碼查得到的一律刪掉(2026-09-27 起「以程式碼為準」加查詢不再算數,Projects/筆記形狀擋_計劃)"),
}

# 現況描述的來源類別(Projects/筆記形狀擋_計劃 [S3],Issue d3):★不用 [src:]★——那是「從程式碼重建的筆記」
# 指向程式位置的出處標記,帶 regen 的筆記會把 [src:部署] 當成一支叫「部署」的檔去驗。
_CTX_SOURCE_RE = re.compile(r"\[來源:\s*(部署|資料庫|生產|外部|人工)\s*\]")
# note-shape 對新增的摘要行套的是 FACT/FLOW/DEP 三條;lint 整篇照舊只套上面那幾條——
# FLOW/DEP 接進 lint 會對 277 行舊帳一次噴警告(見上面 2026-09-21 那段與它的 REVISIT)
_NOTE_SHAPE_PREFIX_RULES = {k: _CONTEXT_MARKER_RULES["FACT"] for k in ("FACT", "FLOW", "DEP")}

# ★RULE: 的生命週期欄位★(2026-09-21 外家審計 F4 折入)
# 原本只驗「行內有日期字樣 + 有退場字樣」,`RULE:2030-99-99 退場:永不撤` 這種假規則零警告,
# 而且「這條過期了沒」沒人判得出來——散文寫的有效期不等於可執行的有效期。
# 欄位沿用本 repo 既有的 [test:]/[audit:] 行內寫法,不新發明語法:
#   [since:YYYY-MM-DD] 什麼時候立的(必填)   [retire:<條件>] 看到什麼就該撤掉(必填)
#   [until:YYYY-MM-DD] 硬到期日(選填)       [confirmed:YYYY-MM-DD] 最後一次確認(選填)
#   [status:active|superseded] 預設 active  [applies:<版本或範圍>](選填)
# 只有 since 與 retire 都寫齊、且不是 superseded 的 RULE 行,才有挑戰程式碼的效力(見紀律範本第 3 條)。
# 一欄位一個正則,形狀跟鄰居 TEST_REF_RE / AUDIT_REF_RE / ROLLBACK_REF_RE 一致
# (2026-09-21 架構對齊席:原本寫成一條合併正則+dict,是這支檔裡的第二種做法)
SINCE_REF_RE = re.compile(r"\[since:\s*([^\]]*)\]")
UNTIL_REF_RE = re.compile(r"\[until:\s*([^\]]*)\]")
CONFIRMED_REF_RE = re.compile(r"\[confirmed:\s*([^\]]*)\]")
STATUS_REF_RE = re.compile(r"\[status:\s*([^\]]*)\]")
RETIRE_REF_RE = re.compile(r"\[retire:\s*([^\]]*)\]")
APPLIES_REF_RE = re.compile(r"\[applies:\s*([^\]]*)\]")
_RULE_FIELD_RES = {"since": SINCE_REF_RE, "until": UNTIL_REF_RE, "confirmed": CONFIRMED_REF_RE,
                   "status": STATUS_REF_RE, "retire": RETIRE_REF_RE, "applies": APPLIES_REF_RE}
_RULE_CONFIRM_STALE_DAYS = 180


def parse_rule_fields(rest):
    """把 RULE: 行裡的 [key:value] 抓成 dict(重複出現取最後一個,跟鄰居一樣)。"""
    out = {}
    for k, rx in _RULE_FIELD_RES.items():
        ms = list(rx.finditer(rest))
        if ms:
            out[k] = ms[-1].group(1).strip()
    return out


def rule_field_truncated(rest):
    """值裡含右中括號(典型:退場條件引用 [[節點]])會被截斷,截掉的部分沒人看得到。

    既有的 [test:]/[audit:] 家族也是同一種截斷,差別在那些欄位的值本來就是識別字;
    [retire:] 是散文,踩到的機會高很多,所以這裡主動唸出來而不是默默截掉。
    """
    bad = []
    for k, rx in _RULE_FIELD_RES.items():
        for m in rx.finditer(rest):
            if rest[m.end():m.end() + 1] == "]":
                bad.append(k)
    return sorted(set(bad))


def _rule_date(v):
    import datetime as _dt
    try:
        return _dt.date.fromisoformat(v)
    except Exception:
        return None


def rule_lifecycle_warnings(rest, today=None):
    """一條 RULE: 行的生命週期檢查,回傳警告清單(不擋)。"""
    f = parse_rule_fields(rest)
    out = []
    # 同一行塞兩條 RULE:,後面那條沒填欄位也會借用前面的(2026-09-21 通才席 F4)
    if rest.count("RULE:") >= 1:
        out.append("一行只放一條 RULE:——同一行寫兩條時欄位會混在一起算,"
                   f"沒填欄位的那條會借用旁邊的而被判過關:{rest.strip()[:40]}")
    trunc = rule_field_truncated(rest)
    if trunc:
        out.append("這幾個欄位的值裡有右中括號,會被截斷(常見於退場條件引用 [[節點]]):"
                   + "、".join(f"[{k}:…]" for k in trunc)
                   + "——改寫成不帶中括號的一句話,或把節點名寫在欄位外面"
                   + f":{rest.strip()[:40]}")
    missing = [k for k in ("since", "retire") if not f.get(k)]
    if missing:
        out.append("脈絡標記『RULE:』缺 " + "、".join(f"[{k}:…]" for k in missing)
                   + "——規則要機械讀得到「什麼時候立的」和「看到什麼就該撤掉」,"
                     "散文寫的有效期沒人判得出來;寫不出退場條件,就是還沒想清楚這條該不該立"
                   + f":{rest.strip()[:40]}")
    st = (f.get("status") or "active").lower()
    if st == "superseded":
        out.append("這條 RULE 標了 [status:superseded],已經沒有挑戰程式碼的效力,"
                   "只能當歷史線索;確定撤掉就把整行刪掉,別留著讓人誤讀"
                   f":{rest.strip()[:40]}")
    elif st != "active":
        out.append(f"[status:{st}] 不是認得的值(只收 active / superseded):{rest.strip()[:40]}")
    import datetime as _dt
    today = today or _dt.date.today()
    for key, label in (("since", "立的日期"), ("until", "到期日"), ("confirmed", "最後確認")):
        v = f.get(key)
        if v and _rule_date(v) is None:
            out.append(f"[{key}:{v}] 不是合法日期({label}要寫成 YYYY-MM-DD):{rest.strip()[:40]}")
    until = _rule_date(f.get("until") or "")
    if until and until < today and st == "active":
        out.append(f"這條 RULE 的 [until:{f['until']}] 已經過期({today} 了)還標著 active——"
                   "確認還要不要留:要留就往後延並補 [confirmed:],不留就刪掉或標 superseded"
                   f":{rest.strip()[:40]}")
    conf = _rule_date(f.get("confirmed") or "")
    if conf and (today - conf).days > _RULE_CONFIRM_STALE_DAYS and st == "active":
        out.append(f"這條 RULE 超過 {_RULE_CONFIRM_STALE_DAYS} 天沒人確認過"
                   f"(最後一次是 {f['confirmed']})——還成立就更新 [confirmed:],不成立就撤掉"
                   f":{rest.strip()[:40]}")
    return out


def context_marker_warnings(summary_text, rules=None):
    """檢查摘要裡四個脈絡前綴的形狀,回傳警告字串清單(不產生 error)。
    rules=別的規則表(筆記形狀擋傳 _NOTE_SHAPE_PREFIX_RULES,只看 FACT/FLOW/DEP;RULE 行的生命週期檢查只在預設時跑)。"""
    out = []
    for raw in (summary_text or "").split("\n"):
        line = raw.strip()
        if not line:
            continue
        m = SYMBOL_RE.match(line)
        if not m:
            continue
        if m.group(1) == "RULE" and rules is None:
            out.extend(rule_lifecycle_warnings(line[len("RULE:"):]))
            continue
        rule = (rules if rules is not None else _CONTEXT_MARKER_RULES).get(m.group(1))
        if not rule:
            continue
        ok, missing, how = rule
        rest = line[len(m.group(1)) + 1:]
        if not ok(rest):
            out.append(f"脈絡標記『{m.group(1)}:』缺{missing}——{how}:{rest.strip()[:40]}")
    return out

FM_KEY_RE = re.compile(r"^\s*([A-Za-z_][\w-]*):")


def _search_region(lineno, line, fm_end):
    """標記命中行所在的結構區域 — 讓「合約行 vs 散文」一眼可辨(尊重標籤哲學)。"""
    s = line.strip()
    if "★INVARIANT★" in s:
        return "★INVARIANT★"
    if "★DEBT★" in s:
    """驗一條 repo 內檔案指涉:回 (status, excerpt)。status ∈ missing/line_out_of_range/ok。
    _refcheck_scan 與 check_regen_provenance(Check J 的 [src:] 驗證)共用——
    J-c 不得走 _refcheck_scan 抽取入口(inline-code 抽取 + top_dirs 靜默過濾會把假目錄放行,
    正是 J-c 要擋的幻覺;此 helper 直收已解析 path/line,無靜默過濾)。
    token 消毒(code-review blocker 修):空/絕對路徑/含 .. 一律 missing——top_dirs 過濾
    被拆掉時它隱含的安全性(空值/絕對/traversal 天然進不了 top_dirs)必須在此顯式補回,
    否則 [src: ]/[src:/etc/passwd]/[src:../..] 會 resolve 到 repo 外真實存在的路徑而判 ok。"""
    token = token.strip()
    from pathlib import PurePosixPath, PureWindowsPath
    if (not token
            or PurePosixPath(token).is_absolute() or PureWindowsPath(token).is_absolute()
            or ".." in PurePosixPath(token).parts):
        return "missing", ""
    # at_sha 給了就對那個 commit 的 git 樹驗,不看工作樹(表態閘 2026-09-09,r3 架構對齊席 A3:同一件事同一個入口,
    # 別在 code-loop 那邊另造一套);三態語意(missing/line_out_of_range/ok)兩條路一致。
    if at_sha:
        if not _git_tree_has(repo_root, at_sha, token):
            return "missing", ""
        if not line:
            return "ok", ""
        txt = _git_tree_text(repo_root, at_sha, token)
        file_lines = txt.splitlines() if txt is not None else None
        if "-" in line:
            lo, hi = (int(x) for x in line.split("-", 1))
        else:
            lo = hi = int(line)
        if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
            return "line_out_of_range", ""   # r1 邊界席 f1:10-5 / 5-0 這種範圍以前會 IndexError 或負索引繞回
        return "ok", (file_lines[lo - 1] if lo == hi else file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1])
    target = repo_root / token
    if not target.exists():
        return "missing", ""
    if target.is_dir() or not line:
        return "ok", ""
    if "-" in line:
        lo, hi = (int(x) for x in line.split("-", 1))
    else:
        lo = hi = int(line)
    try:
        file_lines = target.read_text(encoding="utf-8-sig", errors="replace").splitlines()
    except OSError:
        file_lines = None
    if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
        return "line_out_of_range", ""
    if lo == hi:
        return "ok", file_lines[lo - 1]
    return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]


def _node_code_ref_tokens(text, top_dirs, *, bare_text=False, anchors=False, keep_fences=False, pins=None, singles=None):
    """節點文字裡用反引號寫的程式路徑引用,回 (full, bare):
    full=含 / 且頂層目錄存在的 (token, 行號) 清單(依出現順序、去重,帶 :行號 的剝成第二欄);bare=不含 / 的裸 token 集合。
    ★refcheck、改檔前推筆記、每支檔有家三處共用這一支★——推筆記認得的,跟每支檔有家認得的,一定一樣
    (兩套算法一定分岔,而分岔時沒有東西會翻紅;Projects/每支檔有家_計劃 [S7])。

    筆記形狀擋(Projects/筆記形狀擋_計劃 [S9])加的選項,★預設全關,既有使用者行為不變★:
    bare_text=也認沒包反引號的 `路徑:行號`;anchors=也認 `路徑#L行號`;keep_fences=圍欄裡的內容也看
    (預設一開頭就把圍欄整段刪掉,那是 refcheck 家族要的)。
    ★釘版本寫法 `路徑@<提交>:行號` 預設就解析★:full 裡給的仍是兩欄、路徑去掉 `@<提交>`——每支檔有家那三處用
    `for t, _l in full` 兩欄拆,多一欄就當場出錯(筆記形狀擋 r3 邊界席);要知道釘了哪個提交的呼叫端傳 pins=[],
    會另外收到 (路徑, 行號, 提交字串)——提交字串照原樣給(HEAD、分支名也收),合不合法由呼叫端判。
    singles=[]:另外收沒有 / 的 `檔名:行號`(裸 token 原本只回集合、不帶行號)。"""
    _suffix_re = re.compile(r":([^/]+)$")
    # ★不可換回 FENCE_RE★(見 _visible_lines):此處餵 G1 硬閘與 impact hook
    src = "\n".join(ln for _no, ln in _visible_lines(text.split("\n"), keep_fenced=True)) if keep_fences \
        else _strip_fences_text(text)
    spans = [s.strip("`") for s in INLINE_CODE_RE.findall(src)]
    raws = list(spans)
    if bare_text:
        rest = INLINE_CODE_RE.sub(" ", src)
        raws += [m.group(0) for m in _NODE_BARE_REF_RE.finditer(rest)]
    seen = set()
    full = []
    for raw in raws:
        if "://" in raw or any(c in raw for c in "*<>?"):
            continue
        m = _suffix_re.search(raw)
        line = ""
        if m:
            token, sfx = raw[:m.start()], m.group(1)
            line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
        else:
            token = raw
        if anchors and not line:
            ma = re.search(r"#L(\d+)(?:-L?\d+)?$", token)
            if ma:
                token, line = token[:ma.start()], ma.group(1)
        pin = None
        last = token.rsplit("/", 1)[-1]
        # 只有 @ 後面不含「.」才當釘版本:`icon@2x.png`、`run@v2.sh` 這種檔名本來就有 @(代碼審 r1 單reviewer:
        # 原本一律切開,refcheck 與設計審的 G1 把真檔判成不存在)
        if "@" in last and "." not in last.rsplit("@", 1)[1]:
            token, pin = token.rsplit("@", 1)
        if "/" not in token:
            if singles is not None and line and token and (token, line, pin) not in seen:
                seen.add((token, line, pin))
                singles.append((token, line, pin))
            continue
        if token.split("/")[0] not in top_dirs:
            continue
        if pin is not None and pins is not None:
            # 要知道釘了哪個提交的呼叫端:釘版本只進 pins、不進 full——不然同一行「合法釘版本 + 未釘的同一個引用」
            # 會被 (路徑, 行號) 去重吃掉後面那個(代碼審 r1 外家席)
            if (token, line, pin) not in pins:
                pins.append((token, line, pin))
            continue
        if (token, line) in seen:
            continue
        seen.add((token, line))
        full.append((token, line))
    return full, {s for s in spans if "/" not in s}


# 裸寫的 `路徑:行號` / `路徑#L行號` / `路徑@提交:行號`(筆記形狀擋 [S1]):前面不能緊貼路徑字元,
# 路徑至少要有 / 或副檔名的點(擋掉 d12:3 這類決策編號、12:30 這類時間)
_NODE_BARE_REF_RE = re.compile(
    r"(?<![A-Za-z0-9_./@\-])(?:[A-Za-z0-9_.\-]+/)*[A-Za-z0-9_\-]*[./][A-Za-z0-9_.\-]*"
    r"(?:@[A-Za-z0-9_.\-~^]+)?(?::\d+(?:-\d+)?|#L\d+)(?![\w/])")


def _refcheck_scan(text, repo_root):
    """refcheck 抽取+核對核心(不列印):回 (claims, n_missing, n_oor, n_ok)。
    cmd_refcheck 與 loop status --gate(G1 錨)共用;抽取規則見 cmd_refcheck docstring。
    核對段走 _validate_repo_ref(與 Check J 共用);抽取段(inline-code+top_dirs 過濾)維持原規則。"""
    top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
    pins = []
    full, _bare = _node_code_ref_tokens(text, top_dirs, pins=pins)
    claims = []
    # 釘版本 `路徑@<提交>:行號` 對那個提交驗(筆記形狀擋 [S2]):不這樣做,它會被當成一支叫「路徑@提交」、
    # 或行號對不上目前版本的檔,設計審放行前的引用檢查就把合法寫法判成幻覺證據
    for token, line, pin in pins:
        sha = _pin_commit(repo_root, pin)
        status, excerpt = _validate_repo_ref(repo_root, token, line, at_sha=sha) if sha else ("missing", "")
        claims.append({"token": f"{token}@{pin}", "line": line, "status": status, "excerpt": excerpt})
    for token, line in full:
        status, excerpt = _validate_repo_ref(repo_root, token, line)
        claim = {"token": token, "line": line, "status": status, "excerpt": excerpt}
        if status == "ok" and (repo_root / token).is_dir():
            claim["dir"] = True
        claims.append(claim)

    n_missing = sum(1 for c in claims if c["status"] == "missing")
    n_oor = sum(1 for c in claims if c["status"] == "line_out_of_range")
    n_ok = sum(1 for c in claims if c["status"] == "ok")
    return claims, n_missing, n_oor, n_ok


PITFALL_CLASSES = {
    "payment": [r"金流", r"payment", r"stripe", r"billing", r"退款", r"refund", r"扣款"],
    "external-send": [r"寄送", r"送出", r"\bsend\b", r"webhook", r"notify", r"LINE 推送", r"\bmail\b", r"簡訊", r"對外"],
    "prod-irreversible": [r"\bprod\b", r"production", r"遷移", r"migration", r"不可逆", r"DROP TABLE", r"DELETE FROM", r"上架"],
    "self-governance": [r"錨點", r"anchor verify", r"收斂判準", r"canary", r"審計閘", r"pre-push hook"],
}
_PITFALL_COMPILED = {c: [re.compile(p, re.I) for p in pats] for c, pats in PITFALL_CLASSES.items()}
_PITFALL_GENERAL = [
    "併發——同資源兩請求同時進來會怎樣?",
    "效能——這段會進熱路徑/大資料量嗎?",
    "資源——連線/檔案/鎖有沒有確定釋放?",
    # 風險類廣度反問(已知坑機械前置 S0,2026-08-08):寫死 4 類太少,改反問在場 LLM
    # 自我分類——分類是語意判斷,不該 regex 猜。★三處同步:此處+templates.md:31+design-loop skill★
    "列出此功能碰到的風險類(不限既有金流/寄送/不可逆/守衛面:認證/並發/快取/遷移/PII/限流/狀態同步…),逐類答隱患;無則寫『無+為什麼』。",
]
_PITFALL_QUESTIONS = {
    "payment": "冪等鍵怎麼設計?重複扣款如何防?部分失敗怎麼補償/對帳?",
    "external-send": "重試會不會風暴?收端如何去重?超時與速率上限?",
    "prod-irreversible": "回滾路徑?遷移順序與鎖表窗口?",
    "self-governance": "誤擋的逃生口?繞過有沒有留痕?",
}
_PITFALL_BLACKLIST = ("方案評比", "canary 相容性", "誠實天花板", "審計修正紀錄")
# 棧別效能追問(pitfalls棧別效能追問_計劃 T1):diff 命中該棧檔案時附進 manifest。
# 內容源=圖譜 Systems/效能檢核目錄「人判提問」欄,每棧取最載重 3-5 問(kt=6 cs=4 vue=4 sql=3;idioms ⚠不可機檢條目優先入問+2026-07-20 洩漏/裝箱補(R1 並行/R3 競態等);2026-07-19 使用者補全)——
    if _TESTMAP_DIR_RE is None:
        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
    if _TESTMAP_DIR_RE.search(path):
        return True
    name = path.rsplit("/", 1)[-1]
    stem = _testmap_stem(path)
    return (".spec." in name or ".test." in name or stem.startswith("test_")
            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)


def _nodehome_code_kind(path):
    """回 'ext'(副檔名在清單裡)/'shebang?'(沒副檔名,要看首行)/None(不是程式檔)。
    副檔名判法照提交前掛鉤那條正則:大小寫敏感、看最後一個點之後;沒副檔名=去掉開頭所有點之後沒有點。"""
    base = path.rsplit("/", 1)[-1]
    stripped = base.lstrip(".")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    for ent in raw.split(b"\0"):
        if not ent or b"\t" not in ent:
            continue
        meta, p = ent.split(b"\t", 1)
        parts = meta.split()
        if where == "index":
            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
                continue
            mode = parts[0]
        else:
            if len(parts) != 3:
                continue
            mode = parts[0]
        path = nfc(os.fsdecode(p))
        allp.append(path)
        if mode in (b"100644", b"100755"):
            files[path] = mode.decode()
    return files, allp


def _nodehome_changed_vs_disk(repo_root, where):
    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
    if where == "index":
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
    else:
        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
    if raw is None:
        return None
    return {nfc(x) for x in _nodehome_split_z(raw)}


def _nodehome_reader(repo_root, where):
    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
    if where is None:
        return lambda p: None
    disk_ok_all = False
    differ = None
    if where == "index":
        differ = _nodehome_changed_vs_disk(repo_root, "index")
    else:
        head = _lens_full_sha(repo_root, "HEAD")
        if head and head == where:
            differ = _nodehome_changed_vs_disk(repo_root, where)
    root = Path(repo_root)
    spec = "" if where == "index" else where

    def read(p):
        if differ is not None and p not in differ:
            fp = root / p
            try:
                if fp.is_file() and not fp.is_symlink():
                    return fp.read_bytes()
            except OSError:
                pass
        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
        if r is None or r.returncode != 0:
            return None
        return r.stdout
    return read


def _nodehome_parse_note(raw):
    """節點原文 → {type, status, about[], resp, sig, text}。sig=(摘要, 解析後的決策, 正文)——[S12] 內容有變
    逐欄比對用;★不沿用只算正文的那支雜湊★:摘要與決策都在開頭欄位裡,節點長大主要就長在摘要。"""
    text = raw.decode("utf-8-sig", errors="replace") if isinstance(raw, (bytes, bytearray)) else str(raw)
    fm_lines, body = split_frontmatter(text)
    fields = {}
    dec = ""
    if fm_lines is not None:
        fields, _bk, _lint = parse_frontmatter(fm_lines)
        # 決策比「解析後的值」:只把 content: a 改成 content: "a" 這種等價寫法不算內容有變(第二輪外家席)
        try:
            dec = json.dumps(parse_decisions(fm_lines), ensure_ascii=False, sort_keys=True)
        except Exception:
            dec = "\n".join(l.rstrip() for l in fm_lines if l.startswith(("decisions:", "  ")))
    summ = fields.get("summary")
    summ = summ if isinstance(summ, str) else ""
    return {"type": str(fields.get("type", "")).strip(),
            "status": str(fields.get("status", "")).strip(),
            "about": [str(x) for x in as_list(fields.get("about_code")) if str(x).strip()],
            "resp": fields.get("responsibility") if isinstance(fields.get("responsibility"), str) else None,
            # [S11] 從程式重建的章:蓋了章就代表這篇是還原出來的,那它更要說清楚自己管哪些檔
            "regen": fields.get("regen").strip() if isinstance(fields.get("regen"), str) else "",
            "sig": ("\n".join(l.rstrip() for l in summ.splitlines()).strip(), dec,
                    "\n".join(l.rstrip() for l in body.splitlines()).strip()),
            "text": text}


def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
    lst = _nodehome_list(repo_root, where)
    if lst is None:
        return None
    s = _NodehomeSide()
    s.files, s.all_paths = lst
    s.where = where
    s._reader = _nodehome_reader(repo_root, where)
    s.shebang = {}
    s.share = share
    s.changed = set(changed or ())
    s.notes = {}
    pre = vault_rel + "/Systems/"
    for p in s.files:
        if p.startswith(pre) and p.endswith(".md"):
            rel = p[len(vault_rel) + 1:]
            if share is not None and p not in s.changed and rel in share.notes:
                s.notes[rel] = share.notes[rel]
                continue
            raw = s._reader(p)
            if raw is not None:
                s.notes[rel] = _nodehome_parse_note(raw)
    return s


def _nodehome_required(repo_root, side, cfg, vendored_skip):
    """[S1] 需要家的檔集合,另回檔名不是 UTF-8 的程式檔(永遠寫不進圖譜,只提醒改名或排除)。"""
    import fnmatch
    req, bad_names = set(), set()
    layout = _nodehome_layout(side.all_paths)   # 測試資料夾要旁邊的程式目標有同一種檔
    for p in side.files:
        kind = _nodehome_code_kind(p)
        if kind is None:
            continue
        if any(fnmatch.fnmatch(p, g) for g in _NODEHOME_EXCLUDE_GLOBS):
            continue
        if p in vendored_skip or _cochange_excluded(p, cfg["ignore"]) or _nodehome_is_test(p, layout):
            continue
        if kind == "shebang?":
            if p in side.shebang:
                ok = side.shebang[p]
            elif side.share is not None and p not in side.changed and p in side.share.shebang:
                ok = side.shebang[p] = side.share.shebang[p]
            else:
                head = side._reader(p)
                ok = side.shebang[p] = _head_is_shebang(head)
            if not ok:
                continue
        try:
            p.encode("utf-8")
        except UnicodeEncodeError:
            bad_names.add(p)
            continue
        req.add(p)
    return req, bad_names


def _nodehome_key(value):
    """about_code 一項的比對鍵(字面):路徑正規化+NFC。★不讀磁碟★——比對的是被檢查那個版本裡的樣子,
    推送一個不是目前 checkout 的分支時,磁碟上的拼法跟那個提交對不上(第二輪邊界席實跑重現的誤擋)。
    about_code 寫入時已經照磁碟校正過(解連結、大小寫、Unicode 寫法;_about_code_path),所以字面比就夠。"""
    return nfc(_posix_norm(strip_quotes(str(value).strip())))


def _home_map_from_notes(items):
    """★家對照表的唯一算法★(推筆記認家 [S1]):輸入 (節點名, type, status, about_code 清單) 的序列,
    回 ({檔: [家那幾篇]}, {節點名: 自己管的檔集合})。只看 about_code 欄位值、不看預標指紋有沒有過期
    (指紋在每次寫回都會過期)。每支檔有家從提交快照餵、改檔前推筆記從已載入的圖譜餵,★兩邊共用這一支★——
    兩套算法一定分岔,而分岔時沒有東西會翻紅。"""
    homes, own = {}, {}
    for rel, typ, status, about in items:
        keys = {k for k in (_nodehome_key(v) for v in about) if k}
        own[rel] = keys
        if typ != "system" or status not in _NODEHOME_HOME_STATUSES:
            continue
        for k in keys:
            homes.setdefault(k, []).append(rel)
    return homes, own


def _nodehome_homes(repo_root, side):
    """[S2] {檔: [家那幾篇]}——每支檔有家這邊:拿提交快照的解析結果餵 _home_map_from_notes。"""
    return _home_map_from_notes((rel, n["type"], n["status"], n["about"]) for rel, n in side.notes.items())


def _nodehome_refs(text, side, req):
    """[S7][S8] 這篇用反引號寫到哪幾支需要家的檔:抽取跟改檔前推筆記同一支(完整路徑+在受版控檔裡唯一的裸檔名)。
    裸檔名不唯一時推筆記那支不認它,這裡也不認——不構成「別人檔的入口」,就不算認領。"""
    top_dirs = _nodehome_top_dirs(side.all_paths)
    full, bare = _node_code_ref_tokens(text, top_dirs)
    refs = {nfc(t) for t, _l in full if nfc(t) in req}
    if int(_impact_knob("LUMOS_IMPACT_BASENAME_MATCH", 1)):
        counts, where = {}, {}
        for p in side.all_paths:
            b = p.rsplit("/", 1)[-1]
            counts[b] = counts.get(b, 0) + 1
            where[b] = p
        for b in bare:
            if counts.get(b) == 1 and where[b] in req:
                refs.add(where[b])
    return refs


def _nodehome_changes(repo_root, base, tip):
    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
    if tip == "index":
        args = ["diff", "--cached", "--name-status", "-z", "-M"]
        if base is None:
            args.append(_EMPTY_TREE_SHA)
    else:
        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
    raw = _nodehome_git(repo_root, *args)
    if raw is None:
        return None
    toks = _nodehome_split_z(raw)
    out, i = [], 0
    while i < len(toks):
        st = toks[i]
        code = st[:1]
        if code in ("R", "C") and i + 2 < len(toks):
            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
            i += 3
        elif i + 1 < len(toks):
            p = nfc(toks[i + 1])
            out.append((code, p if code != "A" else None, p if code != "D" else None))
            i += 2
        else:
            break
    return out


def _nodehome_name_status(raw):
    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
    while i < len(toks):
        code = toks[i][:1]
        if code in ("R", "C") and i + 2 < len(toks):
            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
            if code == "R":
                gone.add(nfc(toks[i + 1]))
            i += 3
        elif i + 1 < len(toks):
            paths.add(nfc(toks[i + 1]))
            if code == "D":
                gone.add(nfc(toks[i + 1]))
            i += 2
        else:
            break
    return paths, src, gone - set(src)


def _nodehome_merge_own_changes(repo_root, sha, parents):
    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。

    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
    或順手多改的部分,正是這道檢查要看的。
    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
    """
    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
        return None
    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
                      "--name-status", "-z", "-M", sha)
    if r is None:
        return None
    paths, src, gone = _nodehome_name_status(r)
    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
    for p in parents:
        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
    order = sorted(paths)
    specs = []
    for x in order:
        specs.append(f"{sha}:{x}")
        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
    blobs = _nodehome_cat_blobs(repo_root, specs)
    if blobs is None or any(ren is None for _, ren in pairs):
        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
        return paths, src, gone
    kept = set()
    for n, x in enumerate(order):
        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
        if _nodehome_merge_wrote_new_lines(merged, olds):
            kept.add(x)
    return kept, {k: v for k, v in src.items() if k in kept}, gone


def _nodehome_cat_blobs(repo_root, specs):
    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。

    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
    import subprocess as _sp
    if not specs:
        return []
    if any("\n" in s_ for s_ in specs):
        return None
    try:
        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
                    capture_output=True, timeout=60)
    except (OSError, _sp.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    out, pos, res = r.stdout, 0, []
    for _ in specs:
        nl = out.find(b"\n", pos)
        if nl < 0:
            return None
        head = out[pos:nl].split(b" ")
        pos = nl + 1
        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
            size = int(head[2])
            res.append(out[pos:pos + size])
            pos += size + 1
        elif len(head) == 3 and head[2].isdigit():
            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
            res.append(None)
        else:
            res.append(None)            # missing / ambiguous
    return res


def _nodehome_merge_wrote_new_lines(merged, olds):
    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。

    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
    new = _merge_new_lines(merged, olds)
    return True if new is None else bool(new)


def _merge_new_lines(merged, olds):
    """合併結果裡「每一個上一版都找不到」的那些行(去頭尾空白後的位元組集合);判不了回 None。
    從 _nodehome_merge_wrote_new_lines 拆出來(筆記形狀擋 [S5] 要的是哪幾行,不是有沒有);天花板見那支的說明。"""
    if merged is None or b"\0" in merged:
        return None
    seen = set()
    for blob in olds:
        if blob is not None:
            seen.update(ln.strip() for ln in blob.split(b"\n"))
    return {ln.strip() for ln in merged.split(b"\n") if ln.strip() and ln.strip() not in seen}


def _nodehome_commit_groups(repo_root, base, tip):
    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
    if raw is None:
        return None
    out = []
    for line in raw.decode("ascii", errors="replace").splitlines():
        shas = line.split()
        if not shas:
            continue
        sha, parents = shas[0], shas[1:]
        if len(parents) <= 1:
            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
            if r is None:
                return None
            paths, src, gone = _nodehome_name_status(r)
        else:
            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
            if rm is not None:
                paths, src, gone = rm
            else:
                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
                per = []
                for p in parents:
                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
                    if r is None:
                        return None
                    per.append(_nodehome_name_status(r))
                paths = set.intersection(*(x[0] for x in per))
                src = {k: v for k, v in per[0][1].items() if k in paths}
                gone = set.intersection(*(x[2] for x in per))
        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
    return out


def _nodehome_mark_note_content(repo_root, groups, vault_rel):
    """推送前逐提交看寫回:每個提交裡,哪幾篇 Systems 節點的內容(摘要、決策、正文)是在這個提交改的——只補驗證連結、
    計劃連結這類簿記欄位的不算——以及那篇在這個提交前後管哪些檔。在讀取這一層先算好放進分組的 content_notes
    {這個提交之後的路徑: {type, status, own}},判定那層只在同一個提交裡比「管的檔」跟「改的程式」,不必跨提交追名字
    (合併進來的平行分支、一次推送改名好幾次都不影響——代碼審 r2 單reviewer)。這個提交裡改名的,拿改名前的路徑去
    上一個提交讀;這個提交才新開的算有變;讀不到一律當有變,照原本那樣查。"""
    pre = vault_rel + "/Systems/"
    for g in groups or ():
        after = _nodehome_reader(repo_root, g["sha"])
        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
        notes = {}
        for p in g["paths"]:
            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
                continue
            new = after(p)
            n = _nodehome_parse_note(new) if new is not None else None
            olds = [b(g["src"].get(p, p)) for b in befores]
            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
            if n is not None and any(o["sig"] == n["sig"] for o in olds):
                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
            own, statuses = set(), set()
            for x in [n] + olds:
                if x is not None:
                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
                    statuses.add(x["status"])
            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
        g["content_notes"] = notes
    return groups


def _nodehome_golive(repo_root, tip, mark=None):
    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。
    mark=要找的標記字串,預設是每支檔有家自己的;筆記形狀擋傳它自己的(Projects/筆記形狀擋_計劃 [S4])。"""
    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{mark or _NODEHOME_GOLIVE_MARK}",
                        tip or "HEAD", "--", "scripts/hooks/pre-commit")
    if not raw:
        return None
    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
    return first if _LENS_SHA_RE.match(first) else None


def _nodehome_clamp_base(repo_root, base, tip, mark=None):
    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。mark 見 _nodehome_golive。"""
    gl = _nodehome_golive(repo_root, tip, mark)
    if gl is None:
        return base
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
    if r is None or r.returncode != 0:
        return base                                    # 上線點不在這條歷史上
    if base in (None, _EMPTY_TREE_SHA):
        return gl
    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
    return gl if (r is not None and r.returncode == 0 and base != gl) else base


def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
    None=整批當成一個提交(提交前)。"""
    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
    homesN, ownN = _nodehome_homes(repo_root, N)
    homesB, ownB = _nodehome_homes(repo_root, B)
    blocks, reminders, pairs = [], [], []
    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
    for code, old, new in changes:
        if old is not None and (new is None or code == "R"):
            deleted.add(old)
        if new is None:
            continue
        changed_new.add(new)
        if code in ("A", "R", "C"):
            added.add(new)
        if code == "R" and old:
            renamed_from[new] = old
    code_changed = {p for p in changed_new if p in reqN}
    code_added = {p for p in added if p in reqN}
    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
    code_touched = code_changed | code_deleted
    vpre = vault_rel + "/"
    refs_cache = {}

    def refs_now(rel):
        if rel not in refs_cache:
            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
        return refs_cache[rel]

    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]
    edited = set()
    for p in sorted(changed_new):
        if not (p.startswith(vpre + "Systems/") and p.endswith(".md")):
            continue
        rel = p[len(vpre):]
        if rel not in N.notes:
            continue
        n = N.notes[rel]
        src = renamed_from.get(p)
        src_rel = src[len(vpre):] if src and src.startswith(vpre) else rel
        b = B.notes.get(src_rel)
        if n["type"] != "system":
            continue
        edited.add(rel)
        route_src[rel] = src_rel
        if (b is None or b["sig"] != n["sig"]) and n["status"] in _NODEHOME_HOME_STATUSES:
            content_changed.append(rel)
        # [S9] 規則二:這篇之後比之前多出來的別人的檔(新節點=全部都算新)
        foreign_now = refs_now(rel) - ownN.get(rel, set())
        foreign_before = (_nodehome_refs(b["text"], B, reqB) - ownB.get(src_rel, set())) if b else set()
        for f in sorted(foreign_now - foreign_before):
            blocks.append(("foreign", (rel, f, homesN.get(f, []))))
            pairs.append((f, rel))
        # [S17] 新開的、或這次才成為現況(planned/deferred 之類升成 doing/done/stale)的沒寫負責範圍;
        # [S18] 舊篇管的檔變多、超過上限、沒寫(只數還存在的檔)
        cnt_now = len({k for k in ownN.get(rel, set()) if k in N.files})
        becomes_home = n["status"] in _NODEHOME_HOME_STATUSES and (b is None or b["status"] not in _NODEHOME_HOME_STATUSES)
        resp_missing = False
        if b is None or becomes_home:
            if not _nodehome_resp_ok(n["resp"]):
                blocks.append(("new-node-resp", (rel, cnt_now)))

exec
/bin/zsh -lc "sed -n '19845,19975p' scripts/lumos && sed -n '22470,22570p' scripts/lumos && sed -n '22670,22970p' scripts/lumos && sed -n '27970,28045p' scripts/lumos" in /private/tmp/claude-501/-Users-enzo-harness-lumos-toolchain/6fa73df4-aa29-4f7d-a16b-40734a79807b/scratchpad/clone-ns
 succeeded in 0ms:
            lo = hi = int(line)
        if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
            return "line_out_of_range", ""   # r1 邊界席 f1:10-5 / 5-0 這種範圍以前會 IndexError 或負索引繞回
        return "ok", (file_lines[lo - 1] if lo == hi else file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1])
    target = repo_root / token
    if not target.exists():
        return "missing", ""
    if target.is_dir() or not line:
        return "ok", ""
    if "-" in line:
        lo, hi = (int(x) for x in line.split("-", 1))
    else:
        lo = hi = int(line)
    try:
