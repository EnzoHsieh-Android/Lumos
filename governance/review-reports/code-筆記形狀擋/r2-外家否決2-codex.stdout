     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git pre-commit hook — 圖譜同步硬擋 (L2)
     7	#
     8	# 設計理由 (2026-05-25 從 PreToolUse 搬家):
     9	#   舊版 L2 在 Claude Code PreToolUse 攔 `git commit`,但 staged 區在 -a/-am
    10	#   flag 跟 `git commit <path>` 場景下 hook 看到的是空的 (因 -a 在 git 程序內
    11	#   部才 stage), 造成 silent 漏網。教 PreToolUse 解 git command 是追 git 尾巴
    12	#   永遠補不完,根因是「攔截點不對」。改放到 git pre-commit hook,git 內部
    13	#   已決定最終 staged 內容,所有 commit 形態(-a/-am/<path>/--amend)都涵蓋。
    14	#
    15	# Bypass: 用業界標準 `git commit --no-verify` (有儀式感、code review 看得到、
    16	#         比自製 `[no-graph]` marker 難被無意識濫用)
    17	#
    18	# 安裝:
    19	#   git config core.hooksPath scripts/hooks
    20	#   (一次設定,之後 git 自動跑此 hook)
    21	
    22	set -u
    23	
    24	# 找專案 root (避免在 submodule / worktree 出錯)
    25	REPO_ROOT="$(git rev-parse --show-toplevel)"
    26	cd "$REPO_ROOT" || exit 0
    27	
    28	# 找圖譜目錄 (docs/{slug}-knowledge/)
    29	GRAPH_ROOT=""
    30	if [[ -d docs ]]; then
    31	  for d in docs/*-knowledge; do
    32	    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
    33	  done
    34	  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
    35	fi
    36	
    37	# Gate 0: 圖譜不存在 → 放行
    38	[[ -z "$GRAPH_ROOT" ]] && exit 0
    39	
    40	# 拿最終 staged (git 在 pre-commit 時 staged 已確定,-a/-am/path 都涵蓋)
    41	# core.quotePath=off: 避免 git 對中文/non-ASCII 路徑加雙引號 ("docs/.../節點.md"),
    42	# 否則 L65 grep "^${GRAPH_ROOT}/..." 比對不到 → 圖譜檔已 staged 仍誤判為未同步擋下
    43	STAGED="$(git -c core.quotePath=off diff --cached --name-only)"
    44	[[ -z "$STAGED" ]] && exit 0  # 空 commit 不擋
    45	
    46	# Gate CC (advisory): co-change 漏改警告 —— 恆不影響 rc(|| true 隔離)。
    47	# 必須在 Gate 1 之前:後面每條路徑都顯式 exit,「末段」是不可達死碼;
    48	# docs-only commit 在 Gate 2 就 exit 0,唯有這裡能覆蓋主場景(改文件漏同步夥伴)。
    49	# 警告走 stdout(2>/dev/null 只吞診斷,含版本偏斜時舊 vendored lumos 的 argparse 錯)。
    50	CC_PY="$(command -v python3 || command -v python || true)"
    51	if [ -n "$CC_PY" ] && [ -f "$REPO_ROOT/scripts/lumos" ]; then
    52	  "$CC_PY" "$REPO_ROOT/scripts/lumos" cochange check --staged 2>/dev/null || true
    53	else
    54	  echo "提醒:這台機器找不到 python3 或 scripts/lumos,所以「漏改夥伴檔」的提醒這次沒跑。" >&2
    55	fi
    56	
    57	# Gate DG: code 側刪除傳播守衛 (advisory;spec=Projects/code側刪除傳播守衛_計劃)
    58	# 警告走 stdout(2>/dev/null 只吞診斷);|| true 只兜 crash,hang 由 lumos 內部 deadline 兜(fail-open)
    59	# -f 必檢:沒有 scripts/lumos 的 repo(未 vendored)只有 CC_PY 也會跑,python 報「can't open file」
    60	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
    61	  "$CC_PY" "$REPO_ROOT/scripts/lumos" delguard --staged 2>/dev/null || true
    62	fi
    63	
    64	# Gate 1: 圖譜污染指紋 (2026-06-13 對抗審計 P0)
    65	# 攔 notesmd-cli `frontmatter --edit` 的副作用: 日期欄位加引號 (Obsidian property
    66	# 型別 date→text 靜默損傷,且通常伴隨整篇 frontmatter 鍵序重排)。
    67	# 必須放在 Gate 2 之前 — 污染 commit 是 docs-only,Gate 2 的 code 判定對它直接放行。
    68	if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
    69	  polluted="$(git -c core.quotePath=off diff --cached -- "$GRAPH_ROOT" \
    70	    | grep -E '^\+[[:space:]]*(date|created|updated|decided|ended):[[:space:]]*"[0-9]{4}-[0-9]{2}-[0-9]{2}"' || true)"
    71	  if [[ -n "$polluted" ]]; then
    72	    {
    73	      echo ""
    74	      echo "擋下:有筆記的日期欄位被加上了引號(例如 created: \"2026-08-21\")。"
    75	      echo "這幾乎都是某個編輯工具順手改的,不是人打的;它會讓日期欄位變成純文字,而且通常整篇欄位順序都被重排——這種 diff 沒辦法審。"
    76	      echo ""
    77	      echo "被改到的行:"
    78	      echo "$polluted" | head -5 | sed 's/^/   /'
    79	      echo ""
    80	      echo "看完整改動:"
    81	      echo "   git diff --cached -- ${GRAPH_ROOT}"
    82	      echo "還原那個檔:"
    83	      echo "   git checkout -- <檔案>"
    84	      echo "真的是刻意要這樣(非常少見)→ git commit --no-verify"
    85	      echo ""
    86	    } >&2
    87	    exit 1
    88	  fi
    89	fi
    90	
    91	# Gate L: staged 圖譜 .md 逐檔 lumos lint (2026-08-21 體檢 #6)
    92	# 為什麼:lint 自 2026-06 起沒有任何 hook/CI 呼叫,它的每條鐵則(YAML list/白名單/枚舉/frontmatter
    93	# 閉合)全靠人記得跑——「有機制,沒接線」。硬擋:lint rc≠0 即擋,訊息原樣轉出。
    94	# 只跑 staged 的圖譜檔(每檔 <1s),不跑全 vault。找不到 python/lumos → 跳過(與 Gate CC 同語意)。
    95	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
    96	  lint_fail=0
    97	  while IFS= read -r f; do
    98	    [[ -z "$f" ]] && continue
    99	    [[ -f "$f" ]] || continue          # 刪除的檔不 lint
   100	    # ★傳 vault 相對路徑、去 .md★——lumos lint 的精確比對鍵是 vault 相對的「Systems/foo」;
   101	    # 丟 repo 相對路徑會落到 stem 查找,同檔名不同資料夾時 lint 到別的節點、壞的放行(code-loop r1 s1)。
   102	    rel="${f#$GRAPH_ROOT/}"; rel="${rel%.md}"
   103	    if ! out="$("$CC_PY" "$REPO_ROOT/scripts/lumos" lint "$rel" 2>&1)"; then
   104	      lint_fail=1
   105	      { echo ""; echo "擋下:這篇筆記的格式檢查沒過——$f"; echo "$out" | sed 's/^/   /'; } >&2
   106	    fi
   107	  done < <(echo "$STAGED" | grep -E "^${GRAPH_ROOT}/.*\.md$" || true)
   108	  if [[ "$lint_fail" == 1 ]]; then
   109	    { echo ""; echo "格式錯的筆記進了版控,之後的工具會讀錯(合約標記消失、連結變鬼節點)。照上面的提示修好再 commit。"; echo "真的要先進去 → git commit --no-verify,並在訊息裡留一句為什麼。"; echo ""; } >&2
   110	    exit 1
   111	  fi
   112	fi
   113	
   114	
   115	# Gate H: 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S25]):每支程式檔要有一篇管它的節點、
   116	# 節點只准寫自己家的檔、寫回要落在改動檔的家——新違規擋,舊帳交給健檢提醒。判定全在 lumos 裡,這裡只呼叫。
   117	# ★要放在「改程式沒動圖譜」那道之前★:那道只要有圖譜筆記加進索引就提早放行離開,放後面等於只在最不需要的時候才跑。
   118	# 合併提交由 lumos 自己判斷跳過(推送前會把合併的結果整段查一次)。
   119	# 「該動哪篇」的點名(原本在這裡呼叫 impact --sync-only,以反引號為種子)也改由它照家算——
   120	# 反引號那一套會把人推回寫了一堆別人檔名的大雜燴節點(計劃「為什麼」第 3 條)。
   121	# rc1=新違規擋;其他非零(lumos 自己出錯)=放行,這道不因為環境壞了擋人。
   122	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
   123	  nh_rc=0
   124	  "$CC_PY" "$REPO_ROOT/scripts/lumos" home check --staged --repo "$REPO_ROOT" || nh_rc=$?
   125	  [[ "$nh_rc" -eq 1 ]] && exit 1
   126	fi
   127	
   128	# Gate NS: 筆記形狀擋(2026-09-27,Projects/筆記形狀擋_計劃):筆記新寫的程式行號引用、沒寫來源的 FACT/FLOW/DEP 擋下。
   129	# 判定全在 lumos 裡,這裡只呼叫;rc1=擋,其他非零放行(環境壞了不擋人)。
   130	# ★下一行的「note-shape --staged」字樣是上線點標記★:lumos 用 git log -S 找這串第一次出現的提交,那之前的筆記算舊帳。
   131	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
   132	  ns_rc=0
   133	  "$CC_PY" "$REPO_ROOT/scripts/lumos" note-shape --staged --repo "$REPO_ROOT" || ns_rc=$?
   134	  [[ "$ns_rc" -eq 1 ]] && exit 1
   135	fi
   136	
   137	# Gate 2: code 副檔名 (對齊 check-graph-sync.py CODE_EXTS)
   138	CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp|sh|ps1)$'  # sh/ps1 2026-08-21 補(體檢 #7);各份清單由 t_code_exts_lists_agree 釘
   139	
   140	# 排除路徑
   141	is_shebang_code() {   # 沒副檔名的檔:看 staged 內容首行是不是 #!(2026-09-05 README 審視 d1:scripts/lumos 這種主程式五月起 26 次漏過)
   142	  local path="$1" base
   143	  # git 對含 " \ 或控制字元的檔名會印成 C 式引號("a\"b");拿去 git show 會找不到 → 先解引號(r2 delta major)
   144	  if [[ "$path" == \"*\" && ${#path} -ge 2 ]]; then   # 長度守衛:單一個引號的假輸入不做子字串(r3 delta minor,set -u 下會吐錯)
   145	    path="${path:1:${#path}-2}"; path="${path//\\\"/\"}"; path="$(printf '%b' "$path")"   # \" 手解;\\ \t \ooo(控制字元)交給 printf %b(r3 外家:八進位沒解 → 找不到 → 放行)
   146	  fi
   147	  base="${path##*/}"; base="${base#"${base%%[!.]*}"}"; [[ "$base" == *.* ]] && return 1   # 去掉所有開頭的點再看有沒有副檔名(.pythonrc、..foo 也要看 shebang)
   148	  local first; first="$(git show ":$path" 2>/dev/null | head -c 200 | head -n 1)" || return 1
   149	  [[ "$first" == "#!"* ]]   # 任何 shebang 都算(不列直譯器清單:r1 外家 #!/bin/dash 漏判;各處同一條規則,由 t_code_exts_lists_agree 釘)
   150	}
   151	should_exclude() {
   152	  local path="$1"
   153	  case "$path" in
   154	    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
   155	    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
   156	    # vendored 工具白名單(lumos 自有物,例行 lumos update 不該撞圖譜閘;2026-07-25)。
   157	    # ★精確白名單,非 scripts/* 整夾★——專案自有 scripts/foo.py 仍照擋。
   158	    # ★源 repo 守門★:在 Lumos 來源 repo 本身(有 skills/lumos-project-notes),這些檔=產品碼,
   159	    # 豁免不適用(否則源 repo 自家改 scripts/lumos 不帶圖譜會靜默放行=弄弱自家閘)。
   160	    # 與 scripts/lumos 的 _VENDORED_TOOLKIT 常數同源;漂移守衛 t_precommit_whitelist_drift_guard。
   161	    scripts/lumos|scripts/test_lumos.py|scripts/merge-claude-settings.py|scripts/graph-rename.sh|scripts/fetch-notesmd.sh|scripts/hooks/*|scripts/templates/*)
   162	      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
   163	      return 0;;
   164	  esac
   165	  return 1
   166	}
   167	
   168	src_files=()
   169	while IFS= read -r f; do
   170	  [[ -z "$f" ]] && continue
   171	  if ! [[ "$f" =~ $CODE_EXTS_RE ]] && ! is_shebang_code "$f"; then continue; fi
   172	  if should_exclude "$f"; then continue; fi
   173	  src_files+=("$f")
   174	done <<< "$STAGED"
   175	
   176	# Gate 2: 沒 code → 放行
   177	[[ ${#src_files[@]} -eq 0 ]] && exit 0
   178	
   179	# Gate 3: 有圖譜 .md staged → 放行(「該動卻沒動」的點名已由上面的 Gate H 照家算好印出,2026-09-11)
   180	if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
   181	  exit 0
   182	fi
   183	
   184	# ── 印警告並擋 ──
   185	{
   186	  echo ""
   187	  echo "擋下:這次 commit 改了程式碼,但知識筆記一個字都沒動。"
   188	  echo "程式碼記的是「現在長怎樣」,筆記記的是「為什麼這樣做」——只改其中一邊,下一個人(或下一個 session 的 Claude)就會拿舊的理由去理解新的程式碼。"
   189	  echo ""
   190	  echo "這次改到的程式碼(${#src_files[@]} 個):"
   191	  for f in "${src_files[@]:0:10}"; do echo "   • $f"; done
   192	  if [[ ${#src_files[@]} -gt 10 ]]; then
   193	    echo "   … 還有 $(( ${#src_files[@]} - 10 )) 個"
   194	  fi
   195	  echo ""
   196	  echo "筆記放在這個資料夾,這次沒有任何一篇被加進 commit:"
   197	  echo "   ${GRAPH_ROOT}/"
   198	  echo ""
   199	  echo "通常要跟著改的是:受影響功能的說明(Systems)、這次驗證了什麼(Verification)、相關問題單的狀態(Issues)。"
   200	  echo ""
   201	  echo "兩條路選一條:"
   202	  echo "   1. 把該改的筆記改一改,加進 commit,再提交一次。"
   203	  echo "   2. 這次真的不需要動筆記(改錯字、排版、註解、還在進行中的半成品)→ 跳過這道檢查:"
   204	  echo "        git commit --no-verify -m '<訊息>'"
   205	  echo "      跳過會留下紀錄,不是偷偷放行。"
   206	  echo ""
   207	} >&2
   208	
   209	exit 1
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
     7	#
     8	# 為什麼需要:
     9	#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
    10	#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
    11	#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
    12	#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
    13	#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
    14	#
    15	# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
    16	#
    17	# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效
    18	
    19	set -u
    20	
    21	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    22	cd "$REPO_ROOT" || exit 0
    23	
    24	# ── stdin 必須最先讀(prepush範圍修法 #1)──
    25	# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
    26	# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
    27	# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
    28	_PP_LINES=()
    29	while IFS= read -r _line; do
    30	  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
    31	done
    32	
    33	_ZERO="0000000000000000000000000000000000000000"
    34	_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"
    35	
    36	# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
    37	# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
    38	# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
    39	pp_range_for() {
    40	  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    41	    printf '%s..%s' "$_EMPTY_TREE" "$2"
    42	  else
    43	    printf '%s..%s' "$1" "$2"
    44	  fi
    45	}
    46	
    47	# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
    48	# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
    49	# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
    50	pp_touched_file() {
    51	  local _f _r
    52	  [[ -n "$_EMPTY_TREE" ]] || return 0
    53	  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
    54	  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
    55	  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
    56	  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
    57	  _f="$_PP_TMP/touched.txt"
    58	  : > "$_f" 2>/dev/null || return 0
    59	  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    60	    read -r _ _lsha _ _rsha <<< "$_ppl"
    61	    [[ "$_lsha" == "$_ZERO" ]] && continue
    62	    _r="$(pp_range_for "$_rsha" "$_lsha")"
    63	    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
    64	  done
    65	  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
    66	}
    67	
    68	# 無 lumos / python3 → 降級放行(不為缺環境 brick push,CI 兜底)
    69	GRAPHCTL="$REPO_ROOT/scripts/lumos"
    70	PY="$(command -v python3 || command -v python || true)"
    71	
    72	# ── 波及計算(給合約測試閘用):這裡只呼叫、不碰內容。
    73	# ★一次推送只算一次波及★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):以前同步點名與合約測試閘各自呼叫,
    74	# 等於一次推送算兩次——這不是便宜的計算。算一次寫進暫存檔給消費者讀。
    75	# (2026-09-11 起同步點名改由每支檔有家照家算,不再讀這一份;見下面 sync_nudge 原位置的說明。)
    76	# ★失敗隔離★:算不出來 → 暫存檔不存在或是空的 → 合約測試閘記一筆帳放行,不拖垮別的檢查。
    77	_IMPACT_JSON=""
    78	impact_once() {   # $1=diff range;算一次,結果放進 $_IMPACT_JSON
    79	  _IMPACT_JSON=""
    80	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
    81	  # ★用同檔既有的樣板寫法與命名家族★(代碼審 r1 架構對齊席):
    82	  # 同一支腳本下面幾行就有 lumos-prepush-autoloop-XXXXXX / lumos-prepush-tests-XXXXXX,
    83	  # 而且旁邊的註解特別說明過「★XXXXXX 必須在結尾★」是踩過才定下來的。
    84	  local _f; _f="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-impact-XXXXXX" 2>/dev/null || true)"
    85	  [ -n "$_f" ] || return 0
    86	  if "$PY" "$GRAPHCTL" impact --diff "$1" --sync-check --json --repo "$REPO_ROOT" > "$_f" 2>/dev/null \
    87	     && [ -s "$_f" ]; then
    88	    _IMPACT_JSON="$_f"
    89	  else
    90	    rm -f "$_f"
    91	  fi
    92	}
    93	impact_done() { [ -n "$_IMPACT_JSON" ] && rm -f "$_IMPACT_JSON"; _IMPACT_JSON=""; }
    94	# ★硬擋或收到訊號時也要清★(代碼審 r1 外家否決席判 minor,屬實):
    95	# 上面那支只在 ref 迴圈正常跑到尾端時執行。高風險那條路 rc1 會直接 exit 1,
    96	# 收到訊號也一樣——每被硬擋一次就留一個暫存檔在 $TMPDIR 裡慢慢累積。
    97	# 本次推送所有暫存檔的家,離開時整個清(r1 併發席:逐檔 rm 在 exit 1 / Ctrl-C 那條路會漏)。
    98	# 建不出來就擋(r2 邊界席):空字串會讓後面每個 "$_PP_TMP/…" 變成根目錄路徑,測試 log 全寫不出來、擋下訊息一片空白。
    99	_PP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/lumos-prepush-XXXXXX" 2>/dev/null || true)"
   100	if [[ -z "$_PP_TMP" || ! -d "$_PP_TMP" ]]; then
   101	  echo "擋下:推送前檢查需要一個暫存目錄,但 ${TMPDIR:-/tmp} 建不出來(不存在或不可寫);修好 TMPDIR 再推。" >&2
   102	  exit 1
   103	fi
   104	trap 'impact_done; rm -rf "$_PP_TMP"' EXIT INT TERM
   105	# (2026-09-11 起「該動哪篇」的點名改由每支檔有家照家算——下面 home check --diff 會印;原本這裡以反引號為種子的
   106	#  impact --sync-only 會把人推回寫了一堆別人檔名的大雜燴節點,拿掉。Projects/每支檔有家_計劃 [S15]。impact_once 留給合約測試閘用。)
   107	# ★合約測試閘:低風險也跑,紅了印出來記帳但不擋;高風險照舊擋★(人裁 2026-09-07)
   108	# 不選「低風險也擋」的理由:擋下去最可能的結果不是人去修測試,是人改走 --no-verify
   109	# ——而這支腳本自己在別的地方就把那條當第三選項在教,那條零留痕。
   110	bound_tests_advisory() {   # $1=diff range(暫存檔沒算出來時退回自己算)
   111	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
   112	  if [ -n "$_IMPACT_JSON" ]; then
   113	    "$PY" "$GRAPHCTL" bound-tests --from-json "$_IMPACT_JSON" --advisory --repo "$REPO_ROOT" || true
   114	  else
   115	    "$PY" "$GRAPHCTL" bound-tests --diff "$1" --advisory --repo "$REPO_ROOT" || true
   116	  fi
   117	}
   118	if [[ -z "$PY" || ! -f "$GRAPHCTL" ]]; then
   119	  echo "提醒:這台機器找不到 python3 或 lumos,推送前的知識庫檢查這次沒跑;推上去之後 CI 會再跑一遍兜底。" >&2
   120	  exit 0
   121	fi
   122	
   123	# ★同一次推送的事件要串得起來★(#19 S6):這支是逐 ref 迴圈,而錨點與健檢跑在迴圈外面
   124	# ——「當下的 commit」對整支層級的閘沒有唯一答案(同次推多個 ref、推的不是目前 checkout 的 ref、
   125	# detached HEAD 或推 tag,盲取 HEAD 都會歸錯)。所以整支層級的事件改用這個一次性識別碼,
   126	# 逐 ref 的事件另外帶那一行真正的 sha。lumos 端讀這個環境變數,hook 只負責產生它。
   127	export LUMOS_PUSH_ATTEMPT="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
   128	
   129	# 錨點完整性:驗證器(runner/hooks)沒被動過,後面的「doctor 過/測試綠」才可信(repo 層,vault 無關)
   130	if ! "$PY" "$GRAPHCTL" anchor verify; then
   131	  {
   132	    echo ""
   133	    echo "擋下:負責把關的檔案(測試程式、hook 腳本)跟登記過的版本不一樣。"
   134	    echo "這些檔案是裁判,裁判被改過而沒人簽名,後面所有「測試綠、檢查過」都不可信,所以先擋。"
   135	    echo ""
   136	    echo "三條路選一條:"
   137	    echo "  1. 不是故意改的 → 把那個檔還原再推:"
   138	    echo "       git checkout -- <檔案>"
   139	    echo "  2. 是故意改的 → 簽名登記新版本再推:"
   140	    echo "       lumos anchor approve --note \"為什麼改\""
   141	    echo "  3. 真的要先推 → git push --no-verify(CI 之後會發現少了簽名紀錄)"
   142	    echo ""
   143	  } >&2
   144	  exit 1
   145	fi
   146	
   147	# ★簽名檔要跟著推★(2026-09-06 實際被 CI 咬到):上面那道拿的是「工作目錄現在的樣子」,
   148	# 所以你剛簽完名它就是綠的;但 CI 拿的是「已經推上去的內容」。簽名檔沒 commit 就推,
   149	# 這邊全綠、CI 必紅——而且錯誤訊息會叫你再簽一次名,再簽也沒用,因為問題是沒提交。
   150	_BASELINE="governance/anchor-baseline.json"
   151	if [[ -f "$REPO_ROOT/$_BASELINE" ]] && ! git -C "$REPO_ROOT" diff --quiet -- "$_BASELINE" 2>/dev/null; then
   152	  {
   153	    echo ""
   154	    echo "擋下:簽名檔改過了但沒提交,這樣推上去 CI 一定紅。"
   155	    echo "你剛才簽了名(或它被更新過),但那個改動還留在工作目錄裡沒進版控;"
   156	    echo "推送前的檢查看的是工作目錄所以是綠的,CI 看的是推上去的內容,對不起來。"
   157	    echo ""
   158	    echo "把它一起提交再推:"
   159	    echo "       git add $_BASELINE && git commit -m \"gov: 錨點簽名\""
   160	    echo ""
   161	  } >&2
   162	  exit 1
   163	fi
   164	
   165	# ══ 閘的順序(2026-09-06 全 repo 審視 #12 重排)══
   166	# 便宜的先跑、貴的最後。實測:除了全套測試以外,所有閘加起來約 13 秒
   167	# (anchor 0.22s / 簽名檔 0.04s / doctor 1.1s / pitfalls 0.23s / code-loop 0.61s
   168	#  / test-layers 0.21s / 自主迴圈那支 10.3s),而全套是 8 分鐘。
   169	# ★原本全套排在第四位★,所以被那 13 秒裡任何一道擋下時,8 分鐘已經白燒完了。
   170	
   171	# 圖譜健康(只在 vault 存在時跑)
   172	# ★2026-09-06 重排:原本這段在最後面,而且「沒有 vault 就 exit 0」會直接結束整支 hook。
   173	#   現在它排在全套測試之前,那個 exit 0 會把後面的測試閘一起跳掉——所以改成只跳過這一段。
   174	have_vault=0
   175	for d in docs/*-knowledge docs/knowledge; do
   176	  [[ -d "$d" ]] && have_vault=1 && break
   177	done
   178	_TOUCHED_F="$(pp_touched_file)"
   179	_DOCTOR_ARGS=(doctor --ci)
   180	[[ -n "$_TOUCHED_F" ]] && _DOCTOR_ARGS+=(--touched-from "$_TOUCHED_F")
   181	if [[ $have_vault -eq 1 ]] && ! "$PY" "$GRAPHCTL" "${_DOCTOR_ARGS[@]}"; then
   182	  {
   183	    echo ""
   184	    echo "擋下:知識庫健康檢查發現問題(細節在上面)。"
   185	    echo "有問題的筆記推上去,下一個讀它的人會拿到錯的合約或斷掉的連結。"
   186	    echo ""
   187	    echo "三條路選一條:"
   188	    echo "  1. 照上面的提示把筆記修好再推。"
   189	    echo "  2. 覺得是檢查工具本身判錯 → 本機重跑一次確認,真的是工具錯就開一張 Issue 記下來。"
   190	    echo "  3. 真的要先推 → git push --no-verify(CI 還是會跑全套,紅了會看到)"
   191	    echo ""
   192	  } >&2
   193	  exit 1
   194	fi
