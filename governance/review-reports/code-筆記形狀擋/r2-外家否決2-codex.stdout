 23509	def _ns_parse_added(raw):
 23510	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23511	    out, path, n = {}, None, 0
 23512	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23513	        if ln.startswith("+++ "):
 23514	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23515	            path = nfc(p[2:]) if p.startswith("b/") else None
 23516	            continue
 23517	        if ln.startswith("@@"):
 23518	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23519	            n = int(m.group(1)) if m else 0
 23520	            continue
 23521	        if path is None or ln.startswith("---"):
 23522	            continue
 23523	        if ln.startswith("+"):
 23524	            out.setdefault(path, []).append((n, ln[1:]))
 23525	            n += 1
 23526	    return out
