 48142	def t_note_shape_current_state_prefix_requires_source():
 48143	    """[S3] summary 新增的 FACT/FLOW/DEP 要帶五種 [來源:…] 之一;只寫以程式碼為準加查詢也擋;正文的同形狀行不歸這條;
 48144	    FACT 行 lint 給同樣判定、FLOW/DEP lint 維持現行;帶 regen 的筆記寫 [來源:部署] 不被重建守衛當成路徑。"""
 48145	    print("t_note_shape_current_state_prefix_requires_source")
 48146	    root = _ns_repo()
 48147	    cases = [
 48148	        ("FACT 沒來源", "KEY:x\nFACT:門檻 180 秒", True),
 48149	        ("FLOW 沒來源", "KEY:x\nFLOW:a 到 b", True),
 48150	        ("DEP 沒來源", "KEY:x\nDEP:要先有 X", True),
 48151	        ("只寫以程式碼為準", "KEY:x\nFACT:[以程式碼為準]門檻 180 秒;查:`grep -n X y`", True),
 48152	        ("帶來源", "KEY:x\nFACT:東京機房 [來源:部署]", False),
 48153	        ("人工來源", "KEY:x\nDEP:要法務點頭 [來源:人工]", False),
 48154	    ]
 48155	    for label, summ, want_block in cases:
 48156	        _ns_note(root, summary=summ)
 48157	        _ns_stage(root)
 48158	        rc, out = _ns(root)
 48159	        check(f"①{label}:{'擋' if want_block else '放行'}", (rc == 1) == want_block, out[-500:])
 48160	        _ns_reset(root)
 48161	    _ns_note(root, body="FACT:正文裡長得像摘要行")
 48162	    _ns_stage(root)
 48163	    rc, out = _ns(root)
 48164	    check("②正文裡的同形狀行不歸這條", rc == 0, out[-500:])
 48165	    _ns_reset(root)
 48166	    v = mkvault()
 48167	    write(v, "Systems/F.md", "type: system\nstatus: doing\nsummary: |-\n  FACT:門檻 180 秒\n  FLOW:a→b\n", body="# F\n")
 48168	    r = run(v, "lint", "Systems/F")
 48169	    check("③lint:FACT 沒來源要唸來源", "FACT:" in r.stdout and "來源" in r.stdout, r.stdout)
 48170	    check("④lint:FLOW 維持現行(不新增警告)", "FLOW:" not in r.stdout.split("脈絡標記")[-1] if "脈絡標記" in r.stdout else True, r.stdout)
 48171	    write(v, "Systems/G.md", "type: system\nstatus: doing\nsummary: |-\n  FACT:東京機房 [來源:部署]\n", body="# G\n")
 48172	    r = run(v, "lint", "Systems/G")
 48173	    check("⑤lint:FACT 帶來源不唸", "脈絡標記" not in r.stdout, r.stdout)
 48174	    write(v, "Systems/R.md", "type: system\nstatus: doing\nregen: from-scratch/2026-09-27\nsummary: |-\n  FACT:東京機房 [來源:部署]\n", body="# R\n")
 48175	    r = run(v, "lint", "Systems/R")
 48176	    check("⑥帶 regen 的筆記寫 [來源:部署] 不被當成檔案路徑", "部署" not in r.stdout or "幻覺" not in r.stdout, r.stdout)
 48177	
