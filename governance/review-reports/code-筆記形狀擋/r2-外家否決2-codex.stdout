 48100	def t_note_shape_pinned_ref_requires_real_sha_and_line():
 48101	    """[S2] 釘版本只有「至少 12 位、解析結果以它開頭、在分支歷史上、那個提交有該路徑、行號在檔長內」才放行;
 48102	    HEAD、分支名(含全十六進位命名的分支)、找不到的編號、捏造的不可達提交、行號超長都擋;refcheck 對合法釘版本判對得上。"""
 48103	    print("t_note_shape_pinned_ref_requires_real_sha_and_line")
 48104	    root = _ns_repo()
 48105	    sha = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48106	    _nh_git(root, "branch", "deadbeefcafe")
 48107	    import subprocess as sp
 48108	    # 用 HEAD 的樹捏一個從沒進過任何分支的提交:裡面有 src/a.py,只查「物件存在」會放過它(r3 正確性席實測的繞法)
 48109	    fake = sp.run(["git", "-C", str(root), "commit-tree", "HEAD^{tree}", "-m", "fake"], capture_output=True, text=True).stdout.strip()
 48110	    cases = [
 48111	        ("合法釘版本", f"`src/a.py@{sha[:12]}:5`", False),
 48112	        ("完整編號", f"`src/a.py@{sha}:5`", False),
 48113	        ("HEAD", "`src/a.py@HEAD:5`", True),
 48114	        ("分支名", "`src/a.py@main:5`", True),
 48115	        ("全十六進位分支名", "`src/a.py@deadbeefcafe:5`", True),
 48116	        ("太短", f"`src/a.py@{sha[:8]}:5`", True),
 48117	        ("找不到的編號", "`src/a.py@0123456789abcdef:5`", True),
 48118	        ("捏造的不可達提交", f"`src/a.py@{fake}:5`", True),
 48119	        ("行號超長", f"`src/a.py@{sha[:12]}:999`", True),
 48120	    ]
 48121	    for label, add, want_block in cases:
 48122	        _ns_note(root, body=add)
 48123	        _ns_stage(root)
 48124	        rc, out = _ns(root)
 48125	        check(f"①{label}:{'擋' if want_block else '放行'}", (rc == 1) == want_block, out[-500:])
 48126	        _ns_reset(root)
 48127	    # ②refcheck 要真的對「釘住的那個提交」驗:現在版本把 src/a.py 砍到 3 行,釘在舊提交的第 18 行只有舊版有
 48128	    _nh_file(root, "src/a.py", "x = 1\ny = 2\nz = 3\n")
 48129	    _nh_commit(root, "shrink a.py")
 48130	    note = root / "docs" / "kg-knowledge" / "Systems" / "P.md"
 48131	    note.write_text(f"---\ntype: system\n---\n# P\n見 `src/a.py@{sha[:12]}:18`\n", encoding="utf-8")
 48132	    import json as _j
 48133	    r = sp.run([sys.executable, GRAPHCTL, "refcheck", str(note), "--repo", str(root), "--json"], capture_output=True, text=True)
 48134	    try:
 48135	        d = _j.loads(r.stdout)
 48136	    except Exception:
 48137	        d = {}
 48138	    check("②refcheck 對釘住的舊提交驗:舊版有第 18 行 → 對得上(照現在版本驗會超出檔長)",
 48139	          d.get("missing") == 0 and d.get("out_of_range") == 0 and d.get("ok") == 1, r.stdout[-400:])
 48140	
