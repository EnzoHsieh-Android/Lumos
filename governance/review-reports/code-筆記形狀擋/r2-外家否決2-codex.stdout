 23434	# ── 筆記形狀擋(Projects/筆記形狀擋_計劃,2026-09-27;Issue 筆記把程式現況寫進脈絡而漂移_rtb實測回饋 d1–d6、d8)──
 23435	# 筆記不留存程式碼推得出來的東西。這一層只擋形狀固定、機械判得準的兩種(看意思的交給第二層審查員):
 24660	def _pitfall_tier(claims, files, repo_root, diff_range):
 24661	    """改動風險分級(單一算法;★vault-free★,pitfalls 在 pre-push 熱路徑上不載圖譜——代碼審 r1 架構席):
 24662	    命中風險型樣或新告警 → high;改動裡沒有任何「需要有家的程式檔」(_is_code_file,每支檔有家同一套定義)→ light;其餘 standard。
 24663	    「計劃風險低且小改動閘過 → light」那一層要讀圖譜,由 spec-gate --push-check(本來就有圖譜、本來就在 pre-push 跑)印;這裡只用審查帳字串便宜提示一句。回 (tier, 一句為什麼)。"""
 24664	    if claims:
 24665	        return "high", "命中風險型樣或新告警"
 24666	    base = _range_base(repo_root, diff_range)
 24667	    code = [f for f in files if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS)) and _is_code_file(repo_root, f, base)]
 24668	    if not code:
 24669	        return "light", "改動裡沒有程式檔(只有文件/資料/圖譜)"
 24670	    return "standard", "有程式檔改動、沒命中風險型樣" + (";審查帳有全靠人驗的風險低留痕,跑 lumos spec-gate --push-check <範圍> 看是不是 light" if _ledger_has_manual_only(repo_root) else "")
 24671	
 24672	
 24673	def _ledger_has_manual_only(repo_root):
 24674	    """便宜前置(不載圖譜):審查帳裡有沒有全靠人驗的風險低留痕。找不到 vault 或讀不動=沒有。"""
 24675	    try:
 24676	        vault = find_vault(Path(repo_root))
 24677	        ledger = vault.parent / ".canary-log.jsonl" if vault else None
 24678	        return bool(ledger and ledger.exists() and '"manual_only": true' in ledger.read_text(encoding="utf-8", errors="replace"))
 24679	    except OSError:
 24680	        return False
 24681	
 24682	
 24683	def _vault_slug_of(path):
 24684	    """git 路徑字串(不是檔案系統路徑)落在 docs/<名>-knowledge/ 底下就回 <名>-knowledge,否則 None。
 24685	    三個讀者共用(推送前家的檢查、刪除守衛、推送測試範圍);2026-09-18 代碼審 code-文件子集收緊 r2 架構席:原本兩處各寫一次、第三處又換正則。"""
 24686	    if path.startswith("docs/") and path.count("/") >= 2:
 24687	        slug = path.split("/", 2)[1]
 24688	        if slug.endswith("-knowledge"):
 24689	            return slug
 24690	    return None
 24691	
