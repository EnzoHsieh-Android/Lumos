+        (kb / f"{name}.md").write_text("---\ntype: system\nstatus: doing\nsummary: |-\n  FACT:門檻 30 秒\n---\n# x\n見 `src/a.py:4`\n", encoding="utf-8")
+        _ns_stage(root)
