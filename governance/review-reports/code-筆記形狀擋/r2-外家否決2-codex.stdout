 48179	def t_note_lines_range_base_and_own_golive_clamp():
 48180	    """[S4] --diff 範圍起點早於 note-shape 自己的上線點時從上線點算(不是每支檔有家的);上線前的舊違規不擋;
 48181	    淺層 clone 不算範圍、放行並寫一筆 skipped-env。"""
 48182	    print("t_note_lines_range_base_and_own_golive_clamp")
 48183	    root = _ns_repo(golive=False)
 48184	    _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n# home check --staged\n")
 48185	    _ns_note(root, body="上線前的舊違規 `src/a.py:2`")
 48186	    _nh_commit(root, "old violation, before note-shape golive")
 48187	    _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n# home check --staged\n# " + _NS_HOOK_LINE + "\n")
 48188	    _nh_commit(root, "golive")
 48189	    _ns_note(root, body="上線前的舊違規 `src/a.py:2`\n乾淨的一行")
 48190	    _nh_commit(root, "clean")
 48191	    tip = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48192	    empty = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
 48193	    rc, out = _ns(root, "--diff", f"{empty}..{tip}")
 48194	    check("①從空樹起算會被截到 note-shape 上線點:舊違規不擋", rc == 0, out[-500:])
 48195	    _ns_note(root, body="上線前的舊違規 `src/a.py:2`\n乾淨的一行\n新違規 `src/a.py:9`")
 48196	    _nh_commit(root, "new violation")
 48197	    tip2 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48198	    rc, out = _ns(root, "--diff", f"{empty}..{tip2}")
 48199	    check("②上線後的新違規照擋、只列新的", rc == 1 and "a.py:9" in out and "a.py:2" not in out, out[-500:])
 48200	    import subprocess as sp
 48201	    sh = Path(tempfile.mkdtemp(prefix="gctl-ns-shallow-")) / "c"
 48202	    sp.run(["git", "clone", "-q", "--depth", "1", f"file://{root}", str(sh)], capture_output=True)
 48203	    for k, v in (("user.email", "t@t.t"), ("user.name", "t")):
 48204	        sp.run(["git", "-C", str(sh), "config", k, v], capture_output=True)
 48205	    rc, out = _ns(sh, "--diff", f"{empty}..HEAD")
 48206	    check("③淺層 clone:不算範圍、放行、講原因", rc == 0 and "淺層" in out, out[-500:])
 48207	    check("④淺層 clone 寫一筆 skipped-env", any(e.get("gate") == "note-shape" and e.get("kind") == "skipped-env" for e in _ns_gov(sh)), str(_ns_gov(sh))[-300:])
 48208	
