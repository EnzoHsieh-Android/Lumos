 48337	def t_node_code_ref_tokens_defaults_unchanged_and_pin_parsed():
 48338	    """[S9] 抽取器三個新選項預設關閉,既有使用者結果不變;釘版本寫法對既有使用者給去掉 @提交 的兩欄、不出錯;
 48339	    多傳參數的呼叫端另外拿到路徑、行號與提交。"""
 48340	    print("t_node_code_ref_tokens_defaults_unchanged_and_pin_parsed")
 48341	    m = _load_lumos_inproc()
 48342	    text = "見 `src/a.py:3` 與 `src/b.py` 還有裸寫 src/c.py:4 和\n```\n`src/d.py:5`\n```\n"
 48343	    full, bare = m._node_code_ref_tokens(text, {"src"})
 48344	    check("①預設:只認反引號、不看圍欄、不認裸寫", full == [("src/a.py", "3"), ("src/b.py", "")], str(full))
 48345	    full2, _ = m._node_code_ref_tokens("釘 `src/a.py@0123456789ab:7`", {"src"})
 48346	    check("②釘版本對既有使用者是兩欄、路徑去掉 @提交", full2 == [("src/a.py", "7")], str(full2))
 48347	    pins = []
 48348	    m._node_code_ref_tokens("釘 `src/a.py@0123456789ab:7`", {"src"}, pins=pins)
 48349	    check("③多傳參數拿到路徑、行號、提交", pins == [("src/a.py", "7", "0123456789ab")], str(pins))
 48350	    full3, _ = m._node_code_ref_tokens(text, {"src"}, bare_text=True, anchors=True, keep_fences=True)
 48351	    toks = {t for t, _l in full3}
 48352	    check("④三個選項打開:認到裸寫與圍欄內", {"src/c.py", "src/d.py"} <= toks, str(full3))
 48353	    full4, _ = m._node_code_ref_tokens("錨點 `src/a.py#L9`", {"src"}, anchors=True)
 48354	    check("⑤#L 錨點拆成行號", full4 == [("src/a.py", "9")], str(full4))
 48355	
