 48307	def t_note_shape_config_from_snapshot_and_visible():
 48308	    """[S8] note_shape.gate 從被檢查的版本讀;工作樹未暫存的 off 關不掉;off/warn 時 doctor 印一行;
 48309	    LUMOS_SKIP_NOTE_SHAPE=1 放行並寫 skipped-env。"""
 48310	    print("t_note_shape_config_from_snapshot_and_visible")
 48311	    import json as _j
 48312	    root = _ns_repo(cfg={"note_shape": {"gate": "block"}})
 48313	    _ns_note(root, body="新寫 `src/a.py:5`")
 48314	    _nh_git(root, "add", "docs")
 48315	    (root / ".lumos" / "config.json").write_text(_j.dumps({"note_shape": {"gate": "off"}}), encoding="utf-8")
 48316	    rc, out = _ns(root)
 48317	    check("①工作樹未暫存的 off 關不掉", rc == 1, out[-400:])
 48318	    _nh_git(root, "add", ".lumos/config.json")
 48319	    rc, out = _ns(root)
 48320	    check("②暫存的 off:放行並說一句", rc == 0 and "note_shape" in out, out[-400:])
 48321	    (root / ".lumos" / "config.json").write_text(_j.dumps({"note_shape": {"gate": "warn"}}), encoding="utf-8")
 48322	    _nh_git(root, "add", ".lumos/config.json")
 48323	    rc, out = _ns(root)
 48324	    check("③warn:只印不擋", rc == 0 and "a.py:5" in out, out[-400:])
 48325	    _nh_commit(root, "warn mode")
 48326	    import subprocess as sp
 48327	    d = sp.run([sys.executable, GRAPHCTL, "doctor"], cwd=str(root), capture_output=True, text=True)
 48328	    check("④doctor:不是 block 時印一行", "note_shape" in (d.stdout + d.stderr), (d.stdout + d.stderr)[-600:])
 48329	    (root / ".lumos" / "config.json").write_text(_j.dumps({"note_shape": {"gate": "block"}}), encoding="utf-8")
 48330	    _ns_note(root, body="再寫 `src/a.py:6`")
 48331	    _ns_stage(root)
 48332	    rc, out = _ns(root, env={"LUMOS_SKIP_NOTE_SHAPE": "1"})
 48333	    check("⑤環境變數跳過:放行", rc == 0, out[-300:])
 48334	    check("⑥環境變數跳過寫 skipped-env", any(e.get("gate") == "note-shape" and e.get("kind") == "skipped-env" for e in _ns_gov(root)), "")
 48335	
