 23348	        base_where, tip_where, mode_word = head, "index", "這次提交"
 23349	        changes = _nodehome_changes(root, head, "index")
 23350	    else:
 23351	        # 寫法用派工鏡頭那支判法:恰好兩個點、兩端都有、不收三個點——原本只切第一個「..」,
 23352	        # 三個點的寫法變成「起點 到 .終點」、找不到就放行,同一條違規完全沒擋(代碼審 r1 邊界席)
 23353	        rg = _lens_range_ok(diff_range)
 23354	        if rg is None:
 23355	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有(三個點的寫法這裡不收:"
 23356	                  "先用 git merge-base 算出起點再給)", file=sys.stderr)
 23357	            return 2
 23358	        a, b = rg
 23359	        tip = _lens_full_sha(root, b)
 23360	        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
 23361	        if tip is None or base is None:
 23362	            print(f"每支檔有家:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
 23363	            return 0
 23364	        base = _nodehome_clamp_base(root, base, tip)
 23365	        base_where = None if base == _EMPTY_TREE_SHA else base
 23366	        tip_where, mode_word = tip, "這次推送"
 23367	        changes = _nodehome_changes(root, base_where, tip)
 23368	    if changes is None:
 23369	        print("每支檔有家:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
 23370	        return 0
 23371	    lst = _nodehome_list(root, tip_where)
 23372	    if lst is None:
 23373	        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23374	        return 0
 23375	    # 圖譜位置:被檢查的那個版本裡的 docs/*-knowledge(推送一個不是目前 checkout 的分支,工作目錄那份可能不一樣)
 23376	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 23377	    wv = _vault_in(root)
 23378	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23379	    if wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults:
 23380	        vault_rel = wv_rel
 23381	    elif vaults:
 23382	        vault_rel = "docs/" + vaults[0]
 23383	    else:
 23384	        print("每支檔有家:這個專案沒有圖譜,跳過")
 23385	        return 0
 23386	    reader = _nodehome_reader(root, tip_where)
 23387	    cfg = _nodehome_config(root, reader(".lumos/config.json"), from_snapshot=True)
 23388	    for w in cfg["warnings"]:
 23389	        print(f"提醒:{w}", file=sys.stderr)
 23390	    if cfg["mode"] == "off":
 23391	        print("每支檔有家:這個專案把這道檢查關掉了(node_home.gate=off),跳過", file=sys.stderr)
 23392	        return 0
 23393	    N = _nodehome_side(root, tip_where, vault_rel)
 23394	    changed_paths = {p for _c, o, n in changes for p in (o, n) if p}
 23395	    B = _nodehome_side(root, base_where, vault_rel, share=N, changed=changed_paths)
 23396	    if B is None or N is None:
 23397	        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23398	        return 0
 23399	    skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root, "" if staged else tip_where)[0]
 23400	    groups = None if staged else _nodehome_mark_note_content(root, _nodehome_commit_groups(root, base_where, tip_where), vault_rel)
 23401	    res = _nodehome_evaluate(root, B, N, changes, cfg, skip, vault_rel, groups=groups)
 23402	    homesN, _own = _nodehome_homes(root, N)
 23403	    lines = _nodehome_render(res, homesN, N, cfg, mode_word)
 23404	    blocked = bool(res["blocks"])
 23405	    if blocked and cfg["mode"] == "warn":
 23406	        lines = [l.replace("擋下:", "提醒(node_home.gate=warn,不擋):", 1) for l in lines]
 23407	    for l in lines:
 23408	        print(l, file=sys.stderr)
 23409	    # 治理帳:nodes 只放程式檔路徑(統計語意表這麼宣告);沒有程式檔的違規(負責範圍)把節點另放 notes
 23410	    files, notes_ = set(), set()
 23411	    for kind, it in res["blocks"]:
 23412	        if kind in ("new-homeless", "write-back-homeless"):
 23413	            files.add(it)
 23414	        elif kind == "home-removed":
 23415	            files.add(it[0])
 23416	        elif kind in ("foreign", "foreign-awakened"):
 23417	            files.add(it[1]); notes_.add(it[0])
 23418	        elif kind == "route":
 23419	            files.update(it[1]); notes_.add(it[0])
 23420	        else:
 23421	            notes_.add(it[0])
 23422	    kind = "blocked" if blocked and cfg["mode"] == "on" else ("warned" if blocked else "passed")
 23423	    extra = {}
 23424	    if res["pairs"]:
 23425	        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
 23426	    if notes_:
 23427	        extra["notes"] = sorted(notes_)[:50]
 23428	    _gate_event_or_warn(root, "nodehome-check", kind,
 23429	                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
 23430	                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
 23431	    return 1 if kind == "blocked" else 0
