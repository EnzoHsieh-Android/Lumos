 23944	# ── cochange:co-change 漏改守衛(vault-free;borrow-design ROSE error-prevention) ──
 23945	# 規則:conf(A⇒B)=shared/freq(A)(非對稱條件機率,ROSE TSE 2005 §5);support=絕對共改次數。
 23946	# 設計 spec:docs/lumos-toolchain-knowledge/Projects/cochange守衛_計劃.md
 23947	
 23948	_COCHANGE_DEFAULTS = {"min_support": 3, "min_confidence": 0.8, "max_changeset": 20}
 23949	_COCHANGE_DEFAULT_EXCLUDE = [
 23950	    "docs/.governance-log.jsonl", "docs/.bypass-log.jsonl", "docs/.ci-log.jsonl",
 23951	    "docs/.canary-log.jsonl", "docs/.rot-queue.jsonl", "docs/.kill-log.jsonl",
 23952	    "docs/.signoff-log.jsonl", "docs/.usage-log.jsonl",
 23953	    "**/*-lock.json", "**/*.lock", "**/node_modules/**", "**/dist/**",
 23954	    "**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs",
 23955	]
 32360	                     help="解除 confidence 門檻(support 硬底線 2 仍全域生效)")
 32361	    ccr.add_argument("--repo", dest="coch_repo", default=None, help="repo root(預設 cwd 逐層向上找 .git)")
 32362	    ccr.add_argument("--json", action="store_true", dest="coch_json", help="輸出 JSON manifest")
 32363	    ccc = ccsub.add_parser("check", help="對變更集比對規則列漏改警告(advisory rc0;git 失敗 rc2)")
 32364	    ccc.add_argument("--staged", action="store_true", dest="coch_staged", help="變更集=git staged")
 32365	    ccc.add_argument("--diff", dest="coch_diff", default=None, metavar="A..B",
 32366	                     help="變更集=diff range(pre-resolved 兩點如 main..HEAD;與 --staged 同給時 --diff 優先)")
 32367	    ccc.add_argument("--repo", dest="coch_repo", default=None, help="repo root(預設 cwd 逐層向上找 .git)")
 32368	    ccc.add_argument("--json", action="store_true", dest="coch_json", help="輸出 JSON manifest")
 32369	
 32370	    hm = sub.add_parser("home", help="每支檔有家:程式檔歸屬與寫回落點的檢查(提交前/推送前擋新違規);spec=Projects/每支檔有家_計劃")
 32371	    hmsub = hm.add_subparsers(dest="hmcmd", required=True)
 32372	    hmc = hmsub.add_parser("check", help="這次提交或這段推送有沒有新違規(有 rc1、沒有 rc0;沒圖譜/合併中/開關 off 跳過 rc0)")
 32373	    hmc.add_argument("--staged", action="store_true", dest="hm_staged", help="看這次要提交的內容(提交索引);不能跟 --diff 一起用")
 32374	    hmc.add_argument("--diff", dest="hm_diff", default=None, metavar="A..B", help="把範圍兩端當成一次改動比(推送前用);不能跟 --staged 一起用")
 32375	    hmc.add_argument("--repo", dest="hm_repo", default=None, help="repo root(預設 cwd 所在的 git 專案)")
 32376	
 32377	    ns_p = sub.add_parser("note-shape", help="筆記形狀擋:新寫的程式行號引用、沒寫來源的 FACT/FLOW/DEP 擋下(有 rc1、沒有 rc0;跳過 rc0);spec=Projects/筆記形狀擋_計劃")
 32378	    ns_p.add_argument("--staged", action="store_true", dest="ns_staged", help="看這次要提交的內容(提交索引);不能跟 --diff 一起用")
 32379	    ns_p.add_argument("--diff", dest="ns_diff", default=None, metavar="A..B", help="推送範圍(推送前與 CI 用);不能跟 --staged 一起用")
 32380	    ns_p.add_argument("--repo", dest="ns_repo", default=None, help="repo root(預設 cwd 所在的 git 專案)")
 32381	
 32382	    dg = sub.add_parser("delguard", help="code 側刪除傳播守衛(advisory):staged 被刪符號→grep vault 指名過期原句;spec=Projects/code側刪除傳播守衛_計劃")
 32383	    dg.add_argument("--staged", action="store_true", help="掃 staged diff(目前唯一模式,旗標留語意)")
 32384	    dg.add_argument("--json", action="store_true")
 32385	    dg.add_argument("--repo")
