 23780	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 23781	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 23782	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 23783	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 23784	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 23785	    out = []
 23786	    root = Path(repo_root)
 23787	    cp = root / ".lumos" / "config.json"
 23788	    txt = None
 23789	    try:
 23790	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 23791	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 23792	            txt = cp.read_bytes()
 23793	    except OSError:
 23794	        txt = None
 23795	    mode, _w = _note_shape_config(txt)
 23796	    if mode != "block":
 23797	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 23798	                   "沒寫來源的現況描述不會被擋")
 23799	    wf = root / ".github" / "workflows"
 23800	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 23801	    if ymls:
 23802	        body = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in ymls)
 23803	        step = ("- run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 23804	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before }}..${{ github.sha }}\" "
 23805	                "(checkout 要設 fetch-depth: 0;新分支首推前一版全零時改從空樹給,lumos 會自己截到上線點)")
 23806	        if "note-shape --diff" not in body:
 23807	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 23808	        elif "fetch-depth: 0" not in body:
 23809	            out.append("專案 CI 呼叫了 note-shape,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
 23810	    if ci:
 23811	        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
 23812	        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
 23813	        return out
 23814	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 23815	    if gl is None:
 23816	        return out
 23817	    ref = None
 23818	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 23819	    if up is not None and up.returncode == 0 and up.stdout.strip():
 23820	        ref = up.stdout.strip()
 23821	    else:
 23822	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 23823	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 23824	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 23825	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 23826	        ref = cands[0] if cands else None
 23827	    tip = _lens_full_sha(root, ref) if ref else None
 23828	    if tip is None:
 23829	        return out
 23830	    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
 23831	    if a is None or a.returncode != 0:
 23832	        return out
 23833	    try:
 23834	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 23835	    except ValueError:
 23836	        return out
 23837	    base, capped = gl, False
 23838	    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
 23839	    if cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP:
 23840	        b2 = _lens_full_sha(root, f"{tip}~{_NS_DOCTOR_SCAN_CAP}")
 23841	        if b2:
 23842	            base, capped = b2, True
 23843	    res = _note_shape_eval(root, False, base, tip, vault_rel, exclude_remote=False)
 23844	    if capped:
 23845	        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
 23846	    if res:
 23847	        viol, errs = res
 23848	        if viol:
 23849	            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
 23850	            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
 23851	            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
 23852	    return out
