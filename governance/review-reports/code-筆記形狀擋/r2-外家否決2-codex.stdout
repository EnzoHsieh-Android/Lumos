 23855	def cmd_note_shape(repo=None, staged=False, diff_range=None):
 23856	    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
 23857	    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
 23858	    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
 23859	    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
 23860	    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
 23861	    root = Path(repo).resolve() if repo else None
 23862	    if root is None:
 23863	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 23864	        if r is None or r.returncode != 0:
 23865	            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23866	            return 0
 23867	        root = Path(r.stdout.strip())
 23868	    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
 23869	    if r is None or r.returncode != 0:
 23870	        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23871	        return 0
 23872	    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE"):
 23873	        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
 23874	        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
 23875	        return 0
 23876	    if staged:
 23877	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 23878	        if mh is not None and mh.returncode == 0:
 23879	            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
 23880	            return 0
 23881	        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
 23882	    else:
 23883	        rg = _lens_range_ok(diff_range)
 23884	        if rg is None:
 23885	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 23886	            return 2
 23887	        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 23888	        if sh is not None and sh.stdout.strip() == "true":
 23889	            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
 23890	                  file=sys.stderr)
 23891	            _gate_event_or_warn(root, "note-shape", "skipped-env", "shallow clone")
 23892	            return 0
 23893	        a, b = rg
 23894	        tip = _lens_full_sha(root, b)
 23895	        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
 23896	        if tip is None or base is None:
 23897	            print(f"筆記形狀擋:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
 23898	            return 0
 23899	        base = _nodehome_clamp_base(root, base, tip, _NOTE_SHAPE_GOLIVE_MARK)
 23900	        base_where = None if base == _EMPTY_TREE_SHA else base
 23901	        tip_where, mode_word = tip, "這次推送"
 23902	    lst = _nodehome_list(root, tip_where)
 23903	    if lst is None:
 23904	        print("筆記形狀擋:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23905	        return 0
 23906	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 23907	    if not vaults:
 23908	        print("筆記形狀擋:這個專案沒有圖譜,跳過")
 23909	        return 0
 23910	    wv = _vault_in(root)
 23911	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23912	    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 23913	    mode, warns = _note_shape_config(_nodehome_reader(root, tip_where)(".lumos/config.json"))
 23914	    for w in warns:
 23915	        print(f"提醒:{w}", file=sys.stderr)
 23916	    if mode == "off":
 23917	        print("筆記形狀擋:這個專案把這道檢查關掉了(note_shape.gate=off),跳過", file=sys.stderr)
 23918	        return 0
 23919	    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel)
 23920	    if res is None:
 23921	        print("筆記形狀擋:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
 23922	        return 0
 23923	    viol, errs = res
 23924	    if not viol and not errs:
 23925	        return 0
 23926	    head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
 23927	    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
 23928	    for e in errs:
 23929	        print(f"  {e}", file=sys.stderr)
 23930	    for p, n, rule, frag, fix in viol:
 23931	        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
 23932	    if mode == "block":
 23933	        print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
 23934	              "推得出來的一寫進去就會過期——見 Projects/筆記形狀擋_計劃。", file=sys.stderr)
 23935	        _gate_event_or_warn(root, "note-shape", "blocked", f"{mode_word}:新違規 {len(viol) + len(errs)} 條",
 23936	                            hard=True, nodes=sorted({v[0] for v in viol} | {e.split(':', 1)[0] for e in errs})[:50])
 23937	        return 1
 23938	    # warn 模式有違規也記一筆(照鄰居的 warned;沒違規的放行才不寫——代碼審 r1 架構對齊席)
 23939	    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
 23940	                        nodes=sorted({v[0] for v in viol})[:50])
 23941	    return 0
