 24708	def _docs_only_file(path):
 24709	    """這支檔算不算「純文件」:路徑在白名單(根目錄那幾個檔要全名相等;目錄要前綴相等)且副檔名在文件清單(不分大小寫)。
 24710	    只看路徑與副檔名、不讀內容:讀內容的那條路(首行 #!)第一版有,但它只認「已知的程式」,不認得的照放——反過來列文件才安全。"""
 48000	    check("暫存目錄建不出來 → 擋、講明(r2 邊界席:不擋會變根目錄路徑、log 全空)", r.returncode == 1 and "暫存目錄" in r.stderr and not calls, f"rc={r.returncode}\n{r.stderr[-300:]}")
 48001	
