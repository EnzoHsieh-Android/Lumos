 22842	def _merge_new_lines(merged, olds):
 22843	    """合併結果裡「每一個上一版都找不到」的那些行(去頭尾空白後的位元組集合);判不了回 None。
 22844	    從 _nodehome_merge_wrote_new_lines 拆出來(筆記形狀擋 [S5] 要的是哪幾行,不是有沒有);天花板見那支的說明。"""
 22845	    if merged is None or b"\0" in merged:
 22846	        return None
 22847	    seen = set()
 22848	    for blob in olds:
 22849	        if blob is not None:
 22850	            seen.update(ln.strip() for ln in blob.split(b"\n"))
 22851	    return {ln.strip() for ln in merged.split(b"\n") if ln.strip() and ln.strip() not in seen}
 22852	
 22853	
 22854	def _nodehome_commit_groups(repo_root, base, tip):
 22855	    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
 22856	    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
 22857	    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
 22858	    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
 22859	    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
 22860	    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
 22861	    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
 22862	    if raw is None:
 22863	        return None
 22864	    out = []
 22865	    for line in raw.decode("ascii", errors="replace").splitlines():
 22866	        shas = line.split()
 22867	        if not shas:
 22868	            continue
 22869	        sha, parents = shas[0], shas[1:]
 22870	        if len(parents) <= 1:
 22871	            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
 22872	            if r is None:
 22873	                return None
 22874	            paths, src, gone = _nodehome_name_status(r)
 22875	        else:
 22876	            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
 22877	            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
 22878	            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
 22879	            if rm is not None:
 22880	                paths, src, gone = rm
 22881	            else:
 22882	                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
 22883	                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
 22884	                per = []
 22885	                for p in parents:
 22886	                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22887	                    if r is None:
 22888	                        return None
 22889	                    per.append(_nodehome_name_status(r))
 22890	                paths = set.intersection(*(x[0] for x in per))
 22891	                src = {k: v for k, v in per[0][1].items() if k in paths}
 22892	                gone = set.intersection(*(x[2] for x in per))
 22893	        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
 22894	    return out
 22895	
 22896	
 22897	def _nodehome_mark_note_content(repo_root, groups, vault_rel):
 22898	    """推送前逐提交看寫回:每個提交裡,哪幾篇 Systems 節點的內容(摘要、決策、正文)是在這個提交改的——只補驗證連結、
 22899	    計劃連結這類簿記欄位的不算——以及那篇在這個提交前後管哪些檔。在讀取這一層先算好放進分組的 content_notes
 22900	    {這個提交之後的路徑: {type, status, own}},判定那層只在同一個提交裡比「管的檔」跟「改的程式」,不必跨提交追名字
 22901	    (合併進來的平行分支、一次推送改名好幾次都不影響——代碼審 r2 單reviewer)。這個提交裡改名的,拿改名前的路徑去
 22902	    上一個提交讀;這個提交才新開的算有變;讀不到一律當有變,照原本那樣查。"""
 22903	    pre = vault_rel + "/Systems/"
 22904	    for g in groups or ():
 22905	        after = _nodehome_reader(repo_root, g["sha"])
 22906	        # 上一版用「這個提交的第幾個上一版」讀(sha^1、sha^2):跟起點那一側的讀取分開算,不跟它搶共用
 22907	        befores = [_nodehome_reader(repo_root, f"{g['sha']}^{i + 1}") for i in range(len(g["parents"]))]
 22908	        notes = {}
 22909	        for p in g["paths"]:
 22910	            if not (p.startswith(pre) and p.endswith(".md")) or p in g["gone"]:
 22911	                continue
 22912	            new = after(p)
 22913	            n = _nodehome_parse_note(new) if new is not None else None
 22914	            olds = [b(g["src"].get(p, p)) for b in befores]
 22915	            olds = [_nodehome_parse_note(o) for o in olds if o is not None]
 22916	            if n is not None and any(o["sig"] == n["sig"] for o in olds):
 22917	                continue                                    # 跟上一版一樣(只補簿記;合併時照搬某一邊也算):不算這個提交寫回
 22918	            own, statuses = set(), set()
 22919	            for x in [n] + olds:
 22920	                if x is not None:
 22921	                    own |= {k for k in (_nodehome_key(v) for v in x["about"]) if k}
 22922	                    statuses.add(x["status"])
 22923	            # 狀態看這個提交前後兩版(代碼審 r3 單reviewer:只看之後的,「這個提交降成 planned 順便寫、下一個再升回來」就繞過了)
 22924	            notes[p] = {"type": n["type"] if n else "system", "statuses": statuses or {"doing"}, "own": own}
 22925	        g["content_notes"] = notes
 22926	    return groups
 22927	
 22928	
 22929	def _nodehome_golive(repo_root, tip, mark=None):
 22930	    """[S39] 這個 repo 裡「提交前掛鉤第一次包含這道檢查」的那個提交(tip 的歷史裡最早那一個);沒有回 None。
 22931	    mark=要找的標記字串,預設是每支檔有家自己的;筆記形狀擋傳它自己的(Projects/筆記形狀擋_計劃 [S4])。"""
 22932	    raw = _nodehome_git(repo_root, "log", "--reverse", "--format=%H", f"-S{mark or _NODEHOME_GOLIVE_MARK}",
 22933	                        tip or "HEAD", "--", "scripts/hooks/pre-commit")
 22934	    if not raw:
 22935	        return None
 22936	    first = raw.split(b"\n", 1)[0].strip().decode("ascii", errors="replace")
 22937	    return first if _LENS_SHA_RE.match(first) else None
 22938	
 22939	
 22940	def _nodehome_clamp_base(repo_root, base, tip, mark=None):
 22941	    """推送前的範圍起點若早於上線點,改從上線點算:上線前進來的東西是舊帳,不是這次推送的新違規
 22942	    (新接上的遠端、或整段歷史被當成新改動時,不會把舊帳誤擋成新違規)。mark 見 _nodehome_golive。"""
 22943	    gl = _nodehome_golive(repo_root, tip, mark)
 22944	    if gl is None:
 22945	        return base
 22946	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", gl, tip)
 22947	    if r is None or r.returncode != 0:
 22948	        return base                                    # 上線點不在這條歷史上
 22949	    if base in (None, _EMPTY_TREE_SHA):
 22950	        return gl
 22951	    r = _lens_git(repo_root, "merge-base", "--is-ancestor", base, gl)
 22952	    return gl if (r is not None and r.returncode == 0 and base != gl) else base
 22953	
 22954	
 22955	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 22956	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 22957	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 22958	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 22959	    None=整批當成一個提交(提交前)。"""
 22960	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 22961	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 22962	    homesN, ownN = _nodehome_homes(repo_root, N)
 22963	    homesB, ownB = _nodehome_homes(repo_root, B)
 22964	    blocks, reminders, pairs = [], [], []
 22965	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 22966	    for code, old, new in changes:
 22967	        if old is not None and (new is None or code == "R"):
 22968	            deleted.add(old)
 22969	        if new is None:
 22970	            continue
 22971	        changed_new.add(new)
 22972	        if code in ("A", "R", "C"):
 22973	            added.add(new)
 22974	        if code == "R" and old:
 22975	            renamed_from[new] = old
 22976	    code_changed = {p for p in changed_new if p in reqN}
 22977	    code_added = {p for p in added if p in reqN}
 22978	    # 這次才變成需要家的檔也算新增:同一個路徑以前不需要家(捷徑檔、子模組、沒副檔名也沒 #! 的檔),這次變成程式檔——
 22979	    # git 標的是 T 或 M 不是 A,只看 A 的話「新增沒家要擋」會降成「舊檔只提醒」(代碼審 r1 正確性席)。
 22980	    # 兩邊用同一份設定與同一份工具自裝檔清單算,所以改設定不會讓一大批沒動的檔突然算新增。
 22981	    code_added |= {p for p in changed_new - added if p in reqN and p not in reqB}
 22982	    code_deleted = {p for p in deleted if p in reqB}       # 刪掉(含改名的舊路徑)的需要家的檔也算改動(第二輪外家席)
 22983	    code_touched = code_changed | code_deleted
 22984	    vpre = vault_rel + "/"
 22985	    refs_cache = {}
 22986	
 22987	    def refs_now(rel):
 22988	        if rel not in refs_cache:
 22989	            refs_cache[rel] = _nodehome_refs(N.notes[rel]["text"], N, reqN)
 22990	        return refs_cache[rel]
 22991	
 22992	    content_changed, route_src = [], {}      # 內容有變、而且能當家的 Systems 節點 [S12][S13]
 22993	    edited = set()
 22994	    for p in sorted(changed_new):
 22995	        if not (p.startswith(vpre + "Systems/") and p.endswith(".md")):
 22996	            continue
 22997	        rel = p[len(vpre):]
 22998	        if rel not in N.notes:
 22999	            continue
 23000	        n = N.notes[rel]
 23001	        src = renamed_from.get(p)
 23002	        src_rel = src[len(vpre):] if src and src.startswith(vpre) else rel
 23003	        b = B.notes.get(src_rel)
 23004	        if n["type"] != "system":
 23005	            continue
 23006	        edited.add(rel)
 23007	        route_src[rel] = src_rel
 23008	        if (b is None or b["sig"] != n["sig"]) and n["status"] in _NODEHOME_HOME_STATUSES:
 23009	            content_changed.append(rel)
 23010	        # [S9] 規則二:這篇之後比之前多出來的別人的檔(新節點=全部都算新)
 23011	        foreign_now = refs_now(rel) - ownN.get(rel, set())
 23012	        foreign_before = (_nodehome_refs(b["text"], B, reqB) - ownB.get(src_rel, set())) if b else set()
 23013	        for f in sorted(foreign_now - foreign_before):
 23014	            blocks.append(("foreign", (rel, f, homesN.get(f, []))))
 23015	            pairs.append((f, rel))
 23016	        # [S17] 新開的、或這次才成為現況(planned/deferred 之類升成 doing/done/stale)的沒寫負責範圍;
 23017	        # [S18] 舊篇管的檔變多、超過上限、沒寫(只數還存在的檔)
 23018	        cnt_now = len({k for k in ownN.get(rel, set()) if k in N.files})
 23019	        becomes_home = n["status"] in _NODEHOME_HOME_STATUSES and (b is None or b["status"] not in _NODEHOME_HOME_STATUSES)
 23020	        resp_missing = False
 23021	        if b is None or becomes_home:
 23022	            if not _nodehome_resp_ok(n["resp"]):
 23023	                blocks.append(("new-node-resp", (rel, cnt_now)))
 23024	                resp_missing = True
 23025	        else:
 23026	            cnt_before = len({k for k in ownB.get(src_rel, set()) if k in B.files})
 23027	            if cnt_now > cnt_before and cnt_now > cfg["max_files"] and not _nodehome_resp_ok(n["resp"]):
 23028	                blocks.append(("over-limit-resp", (rel, cnt_now)))
 23029	        # [S11] 這次新蓋「從程式重建」章、卻一支檔都不管的節點:還原節點是圖譜重生的起點,
 23030	        # 一開始就沒說自己管哪些檔,之後每一次寫回都不知道該落哪篇。
 23031	        # 放行的唯一寫法是「這次一起寫一句負責範圍,講明它為什麼不管檔」——沿用舊文字不算交代。
 23032	        if (n["status"] in _NODEHOME_HOME_STATUSES          # 不是家就不歸這條管(planned/deferred/已作廢的不擋)
 23033	                and n["regen"] and not (b and b.get("regen")) and cnt_now == 0 and not resp_missing):
 23034	            _resp_rewritten = b is None or (n["resp"] or "") != (b["resp"] or "")
 23035	            if not (_nodehome_resp_ok(n["resp"]) and _resp_rewritten):
 23036	                blocks.append(("regen-no-home", rel))
 23037	    # [S9] 新增的檔喚醒了沒改的節點裡原本就寫著的檔名:那篇沒改,但它從這次起就是別人檔的入口(第二輪外家席)
 23038	    if code_added:
 23039	        for rel in sorted(N.notes):
 23040	            if rel in edited or N.notes[rel]["type"] != "system":
 23041	                continue
 23042	            for f in sorted((refs_now(rel) & code_added) - ownN.get(rel, set())):
 23043	                blocks.append(("foreign-awakened", (rel, f, homesN.get(f, []))))
 23044	                pairs.append((f, rel))
 23045	    # [S3][S34] 新增的程式檔之後沒有家
 23046	    for f in sorted(code_added):
 23047	        if not homesN.get(f):
 23048	            blocks.append(("new-homeless", f))
 23049	    # [S4] 原本有家的檔這次變沒家(stale 照樣是家,所以例行標過期不會觸發)
 23050	    for f in sorted(reqN & reqB):
 23051	        if homesB.get(f) and not homesN.get(f):
 23052	            blocks.append(("home-removed", (f, homesB[f])))
 23053	    if code_touched:
 23054	        cc = set(content_changed)
 23055	        if groups is None:                                  # 提交前:整批就是一個提交(內容有沒有變已經是這個提交的)
 23056	            groups = [{"sha": None, "paths": {p for _c, o, n in changes for p in (o, n) if p}, "src": {}}]
 23057	        routed, wb_files, wb_notes = {}, set(), set()
 23058	        per_commit = {}                                     # 推送前:{那個提交裡的節點名: 寫回卻不是家的那幾支改動檔}
 23059	        for g in groups:
 23060	            g_paths = g["paths"]
 23061	            g_code = {p for p in g_paths if p in reqN or p in reqB}
 23062	            if not g_code:
 23063	                continue                                    # 純整理節點的提交:規則三不管 [S11]
 23064	            if g["sha"] and "content_notes" in g:
 23065	                # ★推送前:判定在那個提交自己裡面做★——那篇的內容是不是在這個提交改的(只補簿記不算)、它在這個提交前後管的檔
 23066	                # 跟這個提交改的程式對不對得上;不跨提交追名字(2026-09-11 平板 POS 第一次真推送踩到的誤擋、代碼審兩輪抓到的改名與合併)
 23067	                for p, info in g["content_notes"].items():
 23068	                    rel = p[len(vpre):]
 23069	                    # 能當家:這個提交前後任一版是,或推送終點那一版是(擋「先降格、在規劃中時寫、再升回來」三步走)
 23070	                    tip_home = rel in N.notes and N.notes[rel]["status"] in _NODEHOME_HOME_STATUSES
 23071	                    if info["type"] != "system" or not (info["statuses"] & set(_NODEHOME_HOME_STATUSES) or tip_home):
 23072	                        continue
 23073	                    wb_files |= g_code
 23074	                    wb_notes.add(rel)
 23075	                    if not (info["own"] & g_code):
 23076	                        per_commit.setdefault(rel, set()).update(g_code)
 23077	                continue
 23078	            # 提交前(整批就是一個提交)或讀取層沒算到:碰到就算,家看起點與終點兩版
 23079	            g_notes = {rel for rel in content_changed
 23080	                       if (vpre + rel) in g_paths or (vpre + route_src.get(rel, rel)) in g_paths}
 23081	            for rel in g_notes:
 23082	                routed.setdefault(rel, set()).update(g_code)
 23083	            if g_notes:
 23084	                wb_files |= g_code
 23085	                wb_notes |= g_notes
 23086	        # [S13] 寫進去的節點要是同一個提交裡某支改動(含刪掉)的檔的家——刪掉的檔看它刪之前的家
 23087	        for rel in content_changed:
 23088	            if rel not in routed:
 23089	                continue
 23090	            mine = ownN.get(rel, set()) | ownB.get(route_src.get(rel, rel), set())
 23091	            if not (mine & routed[rel]):
 23092	                blocks.append(("route", (rel, sorted(routed[rel]))))
 23093	                pairs.extend((f, rel) for f in sorted(routed[rel]))
 23094	        for rel, files in sorted(per_commit.items()):
 23095	            blocks.append(("route", (rel, sorted(files))))
 23096	            pairs.extend((f, rel) for f in sorted(files))
 23097	        legacy = sorted(f for f in code_changed - code_added if not homesN.get(f))
 23098	        for f in legacy:
 23099	            if f in wb_files:
 23100	                # [S13b] 有寫回的提交裡,每支改動檔都要有家(新增的那幾支已由 [S3] 報)——提交層級:跟那篇講什麼無關
 23101	                blocks.append(("write-back-homeless", f))
 23102	                pairs.extend((f, rel) for rel in sorted(wb_notes))
 23103	            else:
 23104	                reminders.append(("legacy-homeless", f))    # [S5] 沒寫回:只提醒
 23105	        # [S15] 「該動哪篇」照家算
 23106	        many = _impact_about_max()
 23107	        for f in sorted(code_changed):
 23108	            hs = homesN.get(f) or []
 23109	            if not hs or any(h in cc for h in hs):
 23110	                continue
 23111	            reminders.append(("nudge-many" if len(hs) > many else "nudge", (f, hs)))
 23112	    # [S15] 這次新掛進某篇 about_code 的檔,那篇的摘要與正文卻連檔名都沒提到 → 提醒(不擋)。
 23113	    # 家從此一定推(推筆記認家),隨手塞一支檔進去就等於把無關的篇推到別人眼前;寫入當下講一句最便宜。
 23114	    # 只看得出「連檔名都沒寫」這一型;「順帶提到、其實不是在講它」要靠抽查([S14])。
 23115	    for rel in sorted(ownN):
 23116	        if (vpre + rel) not in changed_new:
 23117	            continue
 23118	        note = N.notes.get(rel)
 23119	        # 只對「能當家」的節點唸:計劃筆記、還在規劃中的節點本來就不會被推出來,對它講「會被推到眼前」是假的
 23120	        if note is None or note["type"] != "system" or note["status"] not in _NODEHOME_HOME_STATUSES:
 23121	            continue
 23122	        gained = ownN[rel] - ownB.get(route_src.get(rel, rel), set())
 23123	        if not gained:
 23124	            continue
 23125	        scan = _home_scan_text(note["text"])      # 摘要+正文;about_code 欄位不能當自己的證據
 23126	        for f in sorted(gained):
 23127	            if not _home_mentions(scan, f):
 23128	                reminders.append(("home-unmentioned", (rel, f)))
 23129	    for f in sorted(bad_names & changed_new):
 23130	        reminders.append(("bad-name", f))
 23131	    return {"blocks": blocks, "reminders": reminders, "pairs": pairs}
