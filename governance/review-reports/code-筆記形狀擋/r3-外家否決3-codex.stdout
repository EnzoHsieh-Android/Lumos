 22615	def _nodehome_required(repo_root, side, cfg, vendored_skip):
 22616	    """[S1] 需要家的檔集合,另回檔名不是 UTF-8 的程式檔(永遠寫不進圖譜,只提醒改名或排除)。"""
 22617	    import fnmatch
 22618	    req, bad_names = set(), set()
 22619	    layout = _nodehome_layout(side.all_paths)   # 測試資料夾要旁邊的程式目標有同一種檔
 22620	    for p in side.files:
 22621	        kind = _nodehome_code_kind(p)
 22622	        if kind is None:
 22623	            continue
 22624	        if any(fnmatch.fnmatch(p, g) for g in _NODEHOME_EXCLUDE_GLOBS):
 22625	            continue
 22626	        if p in vendored_skip or _cochange_excluded(p, cfg["ignore"]) or _nodehome_is_test(p, layout):
 22627	            continue
 22628	        if kind == "shebang?":
 22629	            if p in side.shebang:
 22630	                ok = side.shebang[p]
 22631	            elif side.share is not None and p not in side.changed and p in side.share.shebang:
 22632	                ok = side.shebang[p] = side.share.shebang[p]
 22633	            else:
 22634	                head = side._reader(p)
 22635	                ok = side.shebang[p] = _head_is_shebang(head)
 22636	            if not ok:
 22637	                continue
 22638	        try:
 22639	            p.encode("utf-8")
 22640	        except UnicodeEncodeError:
 22641	            bad_names.add(p)
 22642	            continue
 22643	        req.add(p)
 22644	    return req, bad_names
