 22787	def _nodehome_cat_blobs(repo_root, specs):
 22788	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22789	
 22790	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22791	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22792	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 22793	    import subprocess as _sp
 22794	    if not specs:
 22795	        return []
 22796	    if any("\n" in s_ for s_ in specs):
 22797	        return None
 22798	    try:
 22799	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22800	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22801	                    capture_output=True, timeout=60)
 22802	    except (OSError, _sp.TimeoutExpired):
 22803	        return None
 22804	    if r.returncode != 0:
 22805	        return None
 22806	    out, pos, res = r.stdout, 0, []
 22807	    for _ in specs:
 22808	        nl = out.find(b"\n", pos)
 22809	        if nl < 0:
 22810	            return None
 22811	        head = out[pos:nl].split(b" ")
 22812	        pos = nl + 1
 22813	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22814	            size = int(head[2])
 22815	            res.append(out[pos:pos + size])
 22816	            pos += size + 1
 22817	        elif len(head) == 3 and head[2].isdigit():
 22818	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22819	            res.append(None)
 22820	        else:
 22821	            res.append(None)            # missing / ambiguous
 22822	    return res
