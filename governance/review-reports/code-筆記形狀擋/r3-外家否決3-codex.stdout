 23532	def _ns_git(repo_root, *args):
 23533	    """跑 git、位元組照回;★路徑不加引號★(core.quotePath=false)——預設設定下中文與特殊字元檔名會被印成
 23534	    帶引號的跳脫字串,解析不到路徑、整篇漏查(代碼審 r1 單reviewer 與外家席各自實測:本 repo 大半筆記是中文檔名)。"""
 23535	    r = _lens_git(repo_root, *args, quote=True, binary=True)
 23536	    if r is None or r.returncode != 0:
 23537	        return None
 23538	    return r.stdout
 23539	
 23540	
 23541	def _ns_diff(repo_root, *args):
 23542	    return _ns_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23543	                   "--src-prefix=a/", "--dst-prefix=b/", *args)
 23544	
 23545	
 23546	def _ns_mainline_refs(repo_root):
 23547	    """推送範圍要排除的「已經在主線上」參照:沿用既有主線判定 _mainline_ref,只認已推上去的 upstream
 23548	    (代碼審 r2 架構對齊席:原本另寫一套找主線)。★不排除所有遠端分支★:先用 --no-verify 推到別的分支、再推主線,
 23549	    那些提交原本永遠沒人查(代碼審 r1 兩席實測)。找不到主線就不排除任何提交——只會查得更多。"""
 23550	    ml = _mainline_ref(repo_root, remote_only=True)
 23551	    return [ml[1]] if ml else []
 23552	
 23553	
 23554	def _ns_exclusions(repo_root, tip):
 23555	    """_ns_mainline_refs 裡「沒有已經包含 tip」的那些。CI 上本地 main 追蹤的 origin/main 就是這次推上來的頂端,
 23556	    拿它排除等於整批不查(r2 編排者自查;工具鏈自己的 CI 先刪掉那個參照才沒中,消費專案照 doctor 給的那步貼會中)。"""
 23557	    out = []
 23558	    for ref in _ns_mainline_refs(repo_root):
 23559	        r = _lens_git(repo_root, "merge-base", "--is-ancestor", tip, ref)
 23560	        if r is not None and r.returncode == 1:
 23561	            out.append(ref)
 23562	    return out
 23563	
 23564	
 23565	def _ns_range_added(repo_root, base, tip, vault_rel, exclude_remote=True):
 23566	    """推送前:範圍裡每個提交各自新增的筆記行 → ({終點路徑: 行文字集合}, 範圍淨改動的筆記路徑)。git 失敗回 None。
 23567	    ★照檔案記,不跨篇用文字比★(代碼審 r2 外家席:別篇加了又刪的同一句,會把另一篇原本就有的舊行誤擋);
 23568	    改名照每個提交的改名偵測往後帶到終點路徑。
 23569	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);每個上一版各自偵測改名
 23570	    再讀(代碼審 r2 外家席:合併時改名,原本拿新檔名去讀上一版讀不到,把上一版帶進來的行當成新寫)。
 23571	    ★已經在主線上的提交不重查★(exclude_remote,見 _ns_mainline_refs)。"""
 23572	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23573	    if exclude_remote:
 23574	        ml = _ns_exclusions(repo_root, tip)
 23575	        if ml:
 23576	            rl += ["--not", *ml]
 23577	    raw = _nodehome_git(repo_root, *rl)
 23578	    if raw is None:
 23579	        return None
 23580	    by_path = {}
 23581	
 23582	    def _renames(a, b):
 23583	        r = _ns_git(repo_root, "diff", "--name-status", "-z", "-M", a, b, "--", vault_rel)
 23584	        return None if r is None else _nodehome_name_status(r)[1]        # 新路徑 → 舊路徑
 23585	
 23586	    def _carry(ren):
 23587	        for new_, old_ in (ren or {}).items():
 23588	            if old_ in by_path and old_ != new_:
 23589	                by_path.setdefault(new_, set()).update(by_path.pop(old_))
 23590	
 23591	    for line in raw.decode("ascii", errors="replace").splitlines():
 23592	        shas = line.split()
 23593	        if not shas:
 23594	            continue
 23595	        sha, parents = shas[0], shas[1:]
 23596	        first = parents[0] if parents else _EMPTY_TREE_SHA
 23597	        ren = _renames(first, sha)
 23598	        if ren is None:
 23599	            return None
 23600	        _carry(ren)
 23601	        if len(parents) <= 1:
 23602	            d = _ns_diff(repo_root, first, sha, "--", vault_rel)
 23603	            if d is None:
 23604	                return None
 23605	            for p, rows in _ns_parse_added(d).items():
 23606	                by_path.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23607	            continue
 23608	        names = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", first, sha, "--", vault_rel)
 23609	        if names is None:
 23610	            return None
 23611	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23612	        pren = [_renames(pp, sha) or {} for pp in parents]
 23613	        specs = []
 23614	        for p in paths:
 23615	            specs.append(f"{sha}:{p}")
 23616	            specs += [f"{pp}:{pr.get(p, p)}" for pp, pr in zip(parents, pren)]
 23617	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23618	        k = 1 + len(parents)
 23619	        for i, p in enumerate(paths):
 23620	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23621	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23622	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23623	                d = _ns_diff(repo_root, first, sha, "--", p)
 23624	                if d is None:
 23625	                    return None
 23626	                for _p, rows in _ns_parse_added(d).items():
 23627	                    by_path.setdefault(p, set()).update(t_.strip() for _n, t_ in rows if t_.strip())
 23628	            else:
 23629	                by_path.setdefault(p, set()).update(x.decode("utf-8", errors="surrogateescape") for x in new)
 23630	    net = _ns_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 23631	    if net is None:
 23632	        return None
 23633	    return by_path, [p for p in _nodehome_split_z(net) if p.endswith(".md")]
 23634	
