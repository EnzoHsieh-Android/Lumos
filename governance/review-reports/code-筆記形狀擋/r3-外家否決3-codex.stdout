 24002	def _cochange_repo_root(repo):
 24003	    """repo root:--repo 指定則驗證之,否則 cwd 逐層向上找 .git。找不到回 None。"""
 24004	    if repo:
 24005	        p = Path(repo).resolve()
 24006	        return p if (p / ".git").exists() else None
 24007	    p = Path.cwd()
 24008	    for cand in (p, *p.parents):
 24009	        if (cand / ".git").exists():
 24010	            return cand
 24011	    return None
