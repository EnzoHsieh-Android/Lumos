 22654	def _home_map_from_notes(items):
 22655	    """★家對照表的唯一算法★(推筆記認家 [S1]):輸入 (節點名, type, status, about_code 清單) 的序列,
 22656	    回 ({檔: [家那幾篇]}, {節點名: 自己管的檔集合})。只看 about_code 欄位值、不看預標指紋有沒有過期
 22657	    (指紋在每次寫回都會過期)。每支檔有家從提交快照餵、改檔前推筆記從已載入的圖譜餵,★兩邊共用這一支★——
 22658	    兩套算法一定分岔,而分岔時沒有東西會翻紅。"""
 22659	    homes, own = {}, {}
 22660	    for rel, typ, status, about in items:
 22661	        keys = {k for k in (_nodehome_key(v) for v in about) if k}
 22662	        own[rel] = keys
 22663	        if typ != "system" or status not in _NODEHOME_HOME_STATUSES:
 22664	            continue
 22665	        for k in keys:
 22666	            homes.setdefault(k, []).append(rel)
 22667	    return homes, own
