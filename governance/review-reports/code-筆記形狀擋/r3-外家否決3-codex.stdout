 22588	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22589	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
 22590	    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
 22591	    lst = _nodehome_list(repo_root, where)
 22592	    if lst is None:
 22593	        return None
 22594	    s = _NodehomeSide()
 22595	    s.files, s.all_paths = lst
 22596	    s.where = where
 22597	    s._reader = _nodehome_reader(repo_root, where)
 22598	    s.shebang = {}
 22599	    s.share = share
 22600	    s.changed = set(changed or ())
 22601	    s.notes = {}
 22602	    pre = vault_rel + "/Systems/"
 22603	    for p in s.files:
 22604	        if p.startswith(pre) and p.endswith(".md"):
 22605	            rel = p[len(vault_rel) + 1:]
 22606	            if share is not None and p not in s.changed and rel in share.notes:
 22607	                s.notes[rel] = share.notes[rel]
 22608	                continue
 22609	            raw = s._reader(p)
 22610	            if raw is not None:
 22611	                s.notes[rel] = _nodehome_parse_note(raw)
 22612	    return s
