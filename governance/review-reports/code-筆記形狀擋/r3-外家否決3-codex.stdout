     except OSError:
         file_lines = None
     if file_lines is None or lo < 1 or hi < lo or lo > len(file_lines) or hi > len(file_lines):
         return "line_out_of_range", ""
     if lo == hi:
         return "ok", file_lines[lo - 1]
     return "ok", file_lines[lo - 1] + "\n…\n" + file_lines[hi - 1]
 
 
