 23486	def _ns_regions(text):
 23487	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23488	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。開頭欄位的邊界與頂層鍵沿用全庫共用的
 23489	    split_frontmatter / TOP_KEY_RE(代碼審 r1 架構對齊席:原本自己又刻一套);用行範圍判,不靠解析欄位值——縮排怎麼寫都認得到。"""
 23490	    lines = text.split("\n")
 23491	    fm, _body = split_frontmatter(text)
 23492	    if fm is None:
 23493	        if text.startswith("---"):
 23494	            return ["other"] * len(lines)        # 開頭欄位沒關:整篇不判(lint 會擋)
 23495	        return ["body"] * len(lines)
 23496	    out = ["body"] * len(lines)
 23497	    end = len(fm) + 1                            # 收尾 --- 那一行
 23498	    out[0] = out[end] = "other"
 23499	    cur = "other"
 23500	    for i in range(1, end):
 23501	        ln = lines[i]
 23502	        m = TOP_KEY_RE.match(ln)
 23503	        if m:
 23504	            k = m.group(1)
 23505	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23506	            out[i] = "other"
 23507	            continue
 23508	        out[i] = "other" if (cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln)) else cur
 23509	    return out
 23510	
 23511	
 23512	def _ns_parse_added(raw):
 23513	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23514	    out, path, n = {}, None, 0
 23515	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23516	        if ln.startswith("+++ "):
 23517	            p = ln[4:].rstrip("\t")                # 含空白的檔名 git 會在檔頭尾端補一個 TAB
 23518	            path = nfc(p[2:]) if p.startswith("b/") else None
 23519	            continue
 23520	        if ln.startswith("@@"):
 23521	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23522	            n = int(m.group(1)) if m else 0
 23523	            continue
 23524	        if path is None or ln.startswith("---"):
 23525	            continue
 23526	        if ln.startswith("+"):
 23527	            out.setdefault(path, []).append((n, ln[1:]))
 23528	            n += 1
 23529	    return out
 23530	
