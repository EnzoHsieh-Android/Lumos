 23148	def _nodehome_render(res, homes, side, cfg, mode_word):
 23149	    """把判定結果印成白話(發生什麼→為何在意→指令獨立一行)。回印出的行(list)。"""
 23150	    L = []
 23151	    B = res["blocks"]
 23152	    cap = _NODEHOME_MSG_CAP
 23153	
 23154	    def stem(rel):
 23155	        return rel[:-3] if rel.endswith(".md") else rel
 23156	
 23157	    by = {}
 23158	    for kind, item in B:
 23159	        by.setdefault(kind, []).append(item)
 23160	    if B:
 23161	        L.append(f"擋下:{mode_word}有 {len(B)} 條「每支檔有家」的新違規。")
 23162	        L.append("每支程式檔要有一篇管它的節點(about_code 列了它);沒有家的檔,改它時工具推不出該看的筆記,寫回也不知道該落哪——兩個專案就是這樣長出一篇包全部的節點。")
 23163	    homeless = sorted(set(by.get("new-homeless", []) + by.get("write-back-homeless", [])))
 23164	    if homeless:
 23165	        L.append("")
 23166	        L.append(f"■ 這幾支程式檔沒有家({len(homeless)} 支)——新增的檔、或這次要寫說明卻還沒家的檔:")
 23167	        groups = {}
 23168	        for f in homeless:
 23169	            groups.setdefault(f.rsplit("/", 1)[0] if "/" in f else "(根目錄)", []).append(f)
 23170	        shown = 0
 23171	        for d, fs in sorted(groups.items()):
 23172	            if shown >= cap:
 23173	                break
 23174	            take = fs[:cap - shown]
 23175	            shown += len(take)
 23176	            cand = _nodehome_candidates(take[0], homes, side)
 23177	            L.append(f"  {d}/:" + "、".join(x.rsplit("/", 1)[-1] for x in take)
 23178	                     + (f"(候選家:{'、'.join(stem(c) for c in cand)})" if cand else ""))
 23179	            L.append("    新開一篇:")
 23180	            L.append("      lumos new system <名> " + " ".join(f"--code {x}" for x in take) + " --responsibility \"<負責什麼、不負責什麼>\"")
 23380	    wv = _vault_in(root)
 23381	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23382	    if wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults:
 23383	        vault_rel = wv_rel
 23384	    elif vaults:
 23385	        vault_rel = "docs/" + vaults[0]
 23386	    else:
 23387	        print("每支檔有家:這個專案沒有圖譜,跳過")
 23388	        return 0
 23389	    reader = _nodehome_reader(root, tip_where)
 23390	    cfg = _nodehome_config(root, reader(".lumos/config.json"), from_snapshot=True)
 23391	    for w in cfg["warnings"]:
 23392	        print(f"提醒:{w}", file=sys.stderr)
 23393	    if cfg["mode"] == "off":
 23394	        print("每支檔有家:這個專案把這道檢查關掉了(node_home.gate=off),跳過", file=sys.stderr)
 23395	        return 0
 23396	    N = _nodehome_side(root, tip_where, vault_rel)
 23397	    changed_paths = {p for _c, o, n in changes for p in (o, n) if p}
 23398	    B = _nodehome_side(root, base_where, vault_rel, share=N, changed=changed_paths)
 23399	    if B is None or N is None:
 23400	        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23401	        return 0
 23402	    skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root, "" if staged else tip_where)[0]
 23403	    groups = None if staged else _nodehome_mark_note_content(root, _nodehome_commit_groups(root, base_where, tip_where), vault_rel)
 23404	    res = _nodehome_evaluate(root, B, N, changes, cfg, skip, vault_rel, groups=groups)
 23405	    homesN, _own = _nodehome_homes(root, N)
 23406	    lines = _nodehome_render(res, homesN, N, cfg, mode_word)
 23407	    blocked = bool(res["blocks"])
 23408	    if blocked and cfg["mode"] == "warn":
 23409	        lines = [l.replace("擋下:", "提醒(node_home.gate=warn,不擋):", 1) for l in lines]
 23410	    for l in lines:
 23411	        print(l, file=sys.stderr)
 23412	    # 治理帳:nodes 只放程式檔路徑(統計語意表這麼宣告);沒有程式檔的違規(負責範圍)把節點另放 notes
 23413	    files, notes_ = set(), set()
 23414	    for kind, it in res["blocks"]:
 23415	        if kind in ("new-homeless", "write-back-homeless"):
 23416	            files.add(it)
 23417	        elif kind == "home-removed":
 23418	            files.add(it[0])
 23419	        elif kind in ("foreign", "foreign-awakened"):
 23420	            files.add(it[1]); notes_.add(it[0])
 23421	        elif kind == "route":
 23422	            files.update(it[1]); notes_.add(it[0])
 23423	        else:
 23424	            notes_.add(it[0])
 23425	    kind = "blocked" if blocked and cfg["mode"] == "on" else ("warned" if blocked else "passed")
 23426	    extra = {}
 23427	    if res["pairs"]:
 23428	        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
 23429	    if notes_:
 23430	        extra["notes"] = sorted(notes_)[:50]
 23431	    _gate_event_or_warn(root, "nodehome-check", kind,
 23432	                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
 23433	                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
 23434	    return 1 if kind == "blocked" else 0
