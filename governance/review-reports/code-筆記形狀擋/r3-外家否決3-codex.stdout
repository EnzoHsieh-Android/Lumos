 22693	def _nodehome_changes(repo_root, base, tip):
 22694	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22695	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22696	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22697	    if tip == "index":
 22698	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22699	        if base is None:
 22700	            args.append(_EMPTY_TREE_SHA)
 22701	    else:
 22702	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 22703	    raw = _nodehome_git(repo_root, *args)
 22704	    if raw is None:
 22705	        return None
 22706	    toks = _nodehome_split_z(raw)
 22707	    out, i = [], 0
 22708	    while i < len(toks):
 22709	        st = toks[i]
