 23636	def _ns_is_code(path, reader, files):
 23637	    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
 23638	    if path not in files:
 23639	        return False
 23640	    kind = _nodehome_code_kind(path)
 23641	    if kind == "ext":
 23642	        return True
 23643	    if kind != "shebang?":
 23644	        return False
 23645	    b = reader(path)
 23646	    return b is not None and _head_is_shebang(b[:200])
 23647	
 23648	
 23649	# 只放連結的指路行:連結裡不准有別名(`[[目標|別名]]` 的別名可以夾帶現況,代碼審 r2 通才席);分隔含全形逗號
 23650	_NS_POINTER_ONLY_RE = re.compile(r"^(?:\s*(?:\[\[[^\]|]+\]\]|見|→|,|,|、|\||｜)\s*)*$")
 23651	
 23652	
 23653	def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name, regen=False):
 23654	    """一行新增內容 → [(規則, 片段, 改法)]。by_name(檔名)→ 同名的程式檔清單。"""
 23655	    out = []
 23656	    # [src:路徑:行號] 是從程式碼重建的筆記的出處標記,★只在帶 regen 的筆記的 summary 裡★歸重建守衛(Check J)驗;
 23657	    # 別的地方照一般行號引用判(代碼審 r2 通才席:原本對所有筆記豁免,一般筆記寫 [src:…] 就能夾帶行號)
 23658	    scan = SRC_REF_RE.sub(" ", text) if (regen and region == "summary") else text
 23659	    pins, singles = [], []
 23660	    full, _bare = _node_code_ref_tokens(scan, top_dirs, bare_text=True, anchors=True, keep_fences=True,
 23661	                                        pins=pins, singles=singles,
 23662	                                        exists=lambda x: x in files or ("/" not in x and bool(by_name(x))))
 23663	    fix_pin = ("`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
 23664	               "HEAD、分支名、標籤會移動,不算釘住")
 23665	
 23666	    def _pin_ok(p, l, s):
 23667	        sha = _pin_commit(repo_root, s)
 23668	        return sha is not None and _validate_repo_ref(repo_root, p, l, at_sha=sha)[0] == "ok"
 23669	
 23670	    for p, l, s in pins:
 23671	        # 只管程式檔與測試檔——跟沒釘版本時一致(.md、不存在的路徑都不管;代碼審 r1 測試席、r2 外家席)
 23672	        if l and _ns_is_code(p, reader, files) and not _pin_ok(p, l, s):
 23673	            out.append(("釘版本不合法", f"`{p}@{s}:{l}`", fix_pin))
 23674	    for p, l in full:
 23675	        if l and _ns_is_code(p, reader, files):
 23676	            out.append(("程式行號引用", f"`{p}:{l}`",
 23677	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{l}`"))
 23678	    for name, l, s in singles:
 23679	        cands = by_name(name)
 23680	        if len(cands) != 1:
 23681	            continue
 23682	        if s is None:
 23683	            out.append(("程式行號引用", f"`{name}:{l}`(= {cands[0]})",
 23684	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{l}`"))
 23685	        elif not _pin_ok(cands[0], l, s):
 23686	            out.append(("釘版本不合法", f"`{name}@{s}:{l}`(= {cands[0]})", fix_pin))
 23687	    if region == "summary":
 23688	        m = SYMBOL_RE.match(text.strip())
 23689	        body = text.strip()[len(m.group(1)) + 1:].strip() if m else ""
 23690	        # 骨架留的空前綴(lumos new 產的 FLOW:/DEP:)不是現況描述;只放連結的指路行只給 FLOW/DEP(代碼審 r1、r2)
 23691	        skip = (not body) or (m and m.group(1) in ("FLOW", "DEP") and _NS_POINTER_ONLY_RE.match(body))
 23692	        if m and not skip:
 23693	            for _w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
 23694	                out.append(("現況描述沒寫來源", text.strip()[:60],
 23695	                            "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
 23696	    return out
 23697	
 23698	
 23699	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 23700	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 23701	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 23702	    if ch is None:
 23703	        return []
 23704	    lst_t = _nodehome_list(repo_root, tip_where)
 23705	    lst_b = _nodehome_list(repo_root, base_where)
 23706	    if lst_t is None or lst_b is None:
 23707	        return []
 23708	    reader_b = _nodehome_reader(repo_root, base_where)
 23709	    out = []
 23710	    for code, old, new in ch:
 23711	        if not new or code == "D":
 23712	            continue
 23713	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 23714	            continue
 23715	        # 看「新路徑」在起點是不是已經是程式檔:改名過來的路徑對舊引用來說是新出現的(代碼審 r2 外家席)
 23716	        if new not in lst_b[0] or not _ns_is_code(new, reader_b, lst_b[0]):
 23717	            out.append(new)
 23718	    return out
 23719	
 23720	
 23721	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None):
 23722	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 23723	    reader = _nodehome_reader(repo_root, tip_where)
 23724	    lst = _nodehome_list(repo_root, tip_where)
 23725	    if lst is None:
 23726	        return None
 23727	    files = lst[0]
 23728	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 23729	    _names, _name_cache = {}, {}
 23730	    for p in files:
 23731	        if _nodehome_code_kind(p) is not None:
 23732	            _names.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23733	
 23734	    def by_name(name):
 23735	        # 用到才算、只讀同名那幾支(代碼審 r2 通才席:原本一開頭就把每支沒副檔名的檔讀一遍);
 23736	        # 只算真的程式檔:沒副檔名的要看得到 #! 才算(r1 外家席:同名純文字檔讓唯一程式檔漏抓)
 23737	        if name not in _name_cache:
 23738	            _name_cache[name] = [p for p in _names.get(name, []) if _ns_is_code(p, reader, files)]
 23739	        return _name_cache[name]
 23740	    viol, errs = [], []
 23741	    # 1) 這次新增的行
 23742	    if staged:
 23743	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23744	        if d is None:
 23745	            return None
 23746	        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
 23747	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23748	        texts_by = None
 23749	    else:
 23750	        ra = _ns_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote)
 23751	        if ra is None:
 23752	            return None
 23753	        texts_by, paths = ra
 23754	        cand = {p: None for p in paths}
 23755	    for p, linenos in sorted(cand.items()):
 23756	        b = reader(p)
 23757	        if b is None:
 23758	            continue
 23759	        try:
 23760	            text = b.decode("utf-8-sig")        # 帶 BOM 的筆記照認(全庫讀取器都用 utf-8-sig;代碼審 r1 兩席)
 23761	        except UnicodeDecodeError:
 23762	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 23763	            continue
 23764	        lines = text.split("\n")
 23765	        regs = _ns_regions(text)
 23766	        _fm, _b = split_frontmatter(text)
 23767	        regen = bool(_fm) and any(re.match(r"^regen:\s*\S", x) for x in _fm)
 23768	        for i, ln in enumerate(lines, 1):
 23769	            if linenos is not None and i not in linenos:
 23770	                continue
 23771	            if texts_by is not None and ln.strip() not in texts_by.get(p, ()):
 23772	                continue
 23773	            if not ln.strip() or regs[i - 1] == "other":
 23774	                continue
 23775	            for rule, frag, fix in _ns_check_line(repo_root, ln, regs[i - 1], files, reader, top_dirs, by_name, regen):
 23776	                viol.append((p, i, rule, frag, fix))
 23777	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 23778	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 23779	                             tip_where, reader)
 23780	    if became:
 23781	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 23782	        if gl is not None:
 23783	            # 被檢查版本裡所有筆記一次批次讀進來比對(照每支檔有家「新增的檔喚醒沒改的節點」在記憶體比對的做法;
 23784	            # 代碼審 r1 架構對齊席:原本另開 git grep 再手拆輸出,是第二種做法)
 23785	            notes_ = [x for x in files if x.startswith(vault_rel + "/") and x.endswith(".md")]
 23786	            spec = "" if tip_where == "index" else tip_where
 23787	            blobs = _nodehome_cat_blobs(repo_root, [f"{spec}:{x}" for x in notes_]) or []
 23788	            gl_reader = _nodehome_reader(repo_root, gl)
 23789	            seen = {(v[0], v[1]) for v in viol}
 23790	            keys = set(became) | {x.rsplit("/", 1)[-1] for x in became}
 23791	            for p, blob in zip(notes_, blobs):
 23792	                if blob is None:
 23793	                    continue
 23794	                text = blob.decode("utf-8-sig", errors="replace")
 23795	                if not any(x in text for x in keys):
 23796	                    continue
 23797	                old = None
 23798	                for n, ln in enumerate(text.split("\n"), 1):
 23799	                    if (p, n) in seen or not any(x in ln for x in keys):
 23800	                        continue
 23801	                    if old is None:
 23802	                        ob = gl_reader(p)
 23803	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 23804	                    if ln.strip() in old:
 23805	                        continue
 23806	                    sg = []
 23807	                    fl, _b = _node_code_ref_tokens(ln, top_dirs, bare_text=True, anchors=True, keep_fences=True,
 23808	                                                   pins=[], singles=sg,
 23809	                                                   exists=lambda x: x in files or ("/" not in x and bool(by_name(x))))
 23810	                    hits = [(tok, l) for tok, l in fl if tok in became and l]
 23811	                    # 單一檔名也喚醒(代碼審 r2 外家席):唯一同名程式檔就是這次變成程式檔的那支
 23812	                    hits += [(c[0], l) for nm, l, s in sg if s is None for c in [by_name(nm)]
 23813	                             if len(c) == 1 and c[0] in became]
 23814	                    for tok, l in hits:
 23815	                        viol.append((p, n, "程式行號引用(新程式檔喚醒)", f"`{tok}:{l}`",
 23816	                                     f"這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:改寫或釘版本 `{tok}@<提交編號>:{l}`"))
 23817	    return viol, errs
 23818	
 23819	
 23820	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 23821	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 23822	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 23823	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 23824	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 23825	    out = []
 23826	    root = Path(repo_root)
 23827	    cp = root / ".lumos" / "config.json"
 23828	    txt = None
 23829	    try:
 23830	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 23831	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 23832	            txt = cp.read_bytes()
 23833	    except OSError:
 23834	        txt = None
 23835	    mode, _w = _note_shape_config(txt)
 23836	    if mode != "block":
 23837	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 23838	                   "沒寫來源的現況描述不會被擋")
 23839	    wf = root / ".github" / "workflows"
 23840	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 23841	    if ymls:
 23842	        body = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in ymls)
 23843	        step = ("- run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 23844	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main) && "
 23845	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before }}..${{ github.sha }}\" "
 23846	                "(checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了讓已在主線上的提交不重查;"
 23847	                "新分支首推前一版全零時改從空樹給,lumos 會自己截到上線點)")
 23848	        if "note-shape --diff" not in body:
 23849	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 23850	        elif "fetch-depth: 0" not in body:
 23851	            out.append("專案 CI 呼叫了 note-shape,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
 23852	    if ci:
 23853	        # 推送前與 CI 已經用 note-shape --diff 查這次的範圍;事後掃描逐提交重算、會隨歷史線性變慢(代碼審 r1 單reviewer
 23854	        # 量到 500 個提交 9 秒),不放在每次推送都跑的 --ci 路徑上
 23855	        return out
 23856	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 23857	    if gl is None:
 23858	        return out
 23859	    ref = None
 23860	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 23861	    if up is not None and up.returncode == 0 and up.stdout.strip():
 23862	        ref = up.stdout.strip()
 23863	    else:
 23864	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 23865	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 23866	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 23867	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 23868	        ref = cands[0] if cands else None
 23869	    tip = _lens_full_sha(root, ref) if ref else None
 23870	    if tip is None:
 23871	        return out
 23872	    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
 23873	    if a is None or a.returncode != 0:
 23874	        return out
 23875	    try:
 23876	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 23877	    except ValueError:
 23878	        return out
 23879	    base, capped = gl, False
 23880	    cnt = _lens_git(root, "rev-list", "--count", f"{gl}..{tip}")
 23881	    if cnt is not None and cnt.returncode == 0 and cnt.stdout.strip().isdigit() and int(cnt.stdout.strip()) > _NS_DOCTOR_SCAN_CAP:
 23882	        b2 = _lens_full_sha(root, f"{tip}~{_NS_DOCTOR_SCAN_CAP}")
 23883	        # 沿第一個上一版數的邊界可能落在上線點之前(合併式歷史),那樣會把上線前的舊帳報成繞過(代碼審 r2 通才席)
 23884	        anc = _lens_git(root, "merge-base", "--is-ancestor", gl, b2) if b2 else None
 23885	        if b2 and anc is not None and anc.returncode == 0:
 23886	            base, capped = b2, True
 23887	    res = _note_shape_eval(root, False, base, tip, vault_rel, exclude_remote=False)
 23888	    if capped:
 23889	        out.append(f"(筆記形狀擋的事後掃描只看遠端最近 {_NS_DOCTOR_SCAN_CAP} 個提交,更早的沒掃)")
 23890	    if res:
 23891	        viol, errs = res
 23892	        if viol:
 23893	            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
 23894	            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
 23895	            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
 23896	    return out
 23897	
 23898	
 23899	def cmd_note_shape(repo=None, staged=False, diff_range=None):
 23900	    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
 23901	    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
 23902	    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
 23903	    有違規(擋下,或 warn 模式的提醒)與跳過才寫治理帳,沒違規的放行不寫——刻意跟每支檔有家每次都寫 passed 不同:
 23904	    每次提交一筆沒資訊的行正是 rtb 回饋抱怨的帳本雜訊。"""
 23905	    root = Path(repo).resolve() if repo else None
 23906	    if root is None:
 23907	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 23908	        if r is None or r.returncode != 0:
 23909	            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23910	            return 0
 23911	        root = Path(r.stdout.strip())
 23912	    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
 23913	    if r is None or r.returncode != 0:
 23914	        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23915	        return 0
 23916	    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE"):
 23917	        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
 23918	        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
 23919	        return 0
 23920	    if staged:
 23921	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 23922	        if mh is not None and mh.returncode == 0:
 23923	            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
 23924	            return 0
 23925	        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
 23926	    else:
 23927	        rg = _lens_range_ok(diff_range)
 23928	        if rg is None:
 23929	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 23930	            return 2
 23931	        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 23932	        if sh is not None and sh.stdout.strip() == "true":
 23933	            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
 23934	                  file=sys.stderr)
 23935	            _gate_event_or_warn(root, "note-shape", "skipped-env", "shallow clone")
 23936	            return 0
 23937	        a, b = rg
 23938	        tip = _lens_full_sha(root, b)
 23939	        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
 23940	        if tip is None or base is None:
 23941	            print(f"筆記形狀擋:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
 23942	            return 0
 23943	        base = _nodehome_clamp_base(root, base, tip, _NOTE_SHAPE_GOLIVE_MARK)
 23944	        base_where = None if base == _EMPTY_TREE_SHA else base
 23945	        tip_where, mode_word = tip, "這次推送"
 23946	    lst = _nodehome_list(root, tip_where)
 23947	    if lst is None:
 23948	        print("筆記形狀擋:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23949	        return 0
 23950	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 23951	    if not vaults:
 23952	        print("筆記形狀擋:這個專案沒有圖譜,跳過")
 23953	        return 0
 23954	    wv = _vault_in(root)
 23955	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23956	    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
