 13739	def _html_model(env):
 13740	    """蒐集語意模型給 HTML 視圖:nodes(含 type/status/合約/stale/raw)+ typed edges。"""
 13741	    out_e, in_e = env.edges
 13742	    nodes, edges, seen = [], [], set()
 13743	    for rel, n in env.notes.items():
 13744	        inv, debt = extract_contracts(n)
 13745	        summ = n.fields.get("summary")
 13746	        summ = summ if isinstance(summ, str) else ""
