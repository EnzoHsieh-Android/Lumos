 22756	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22757	        return None
 22758	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 22759	                      "--name-status", "-z", "-M", sha)
 22760	    if r is None:
 22761	        return None
