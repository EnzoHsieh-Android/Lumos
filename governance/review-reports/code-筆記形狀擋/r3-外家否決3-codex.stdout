 19869	def _node_code_ref_tokens(text, top_dirs, *, bare_text=False, anchors=False, keep_fences=False, pins=None, singles=None,
 19870	                           exists=None):
 19871	    """節點文字裡用反引號寫的程式路徑引用,回 (full, bare):
 19872	    full=含 / 且頂層目錄存在的 (token, 行號) 清單(依出現順序、去重,帶 :行號 的剝成第二欄);bare=不含 / 的裸 token 集合。
