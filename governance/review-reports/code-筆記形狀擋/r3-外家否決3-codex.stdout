 23465	def _note_shape_config(text):
 23466	    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
 23467	    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
 23468	    if text is None:
 23469	        return "block", []
 23470	    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 23471	    try:
 23472	        data = json.loads(raw)
 23473	    except Exception as e:
 23474	        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
 23475	    ns = data.get("note_shape") if isinstance(data, dict) else None
 23476	    if ns is None:
 23477	        return "block", []
 23478	    if not isinstance(ns, dict):
 23479	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23480	    g = ns.get("gate", "block")
 23481	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23482	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23483	    return g, []
