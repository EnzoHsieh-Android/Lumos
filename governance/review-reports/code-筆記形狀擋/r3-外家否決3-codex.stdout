 23134	def _nodehome_candidates(f, homes, side):
 23135	    """[S6] 候選家:同資料夾其他檔的家、正文用反引號提到它的節點。"""
 23136	    d = f.rsplit("/", 1)[0] if "/" in f else ""
 23137	    cand = []
 23138	    for g, hs in sorted(homes.items()):
 23139	        if g != f and (g.rsplit("/", 1)[0] if "/" in g else "") == d:
 23140	            cand.extend(h for h in hs if h not in cand)
 23141	    base = f.rsplit("/", 1)[-1]
 23142	    for rel, n in sorted(side.notes.items()):
 23143	        if rel not in cand and (f in n["text"] or f"`{base}`" in n["text"]):
 23144	            cand.append(rel)
 23145	    return cand[:3]
