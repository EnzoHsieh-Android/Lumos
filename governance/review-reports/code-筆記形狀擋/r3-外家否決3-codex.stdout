 22723	def _nodehome_name_status(raw):
 22724	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
 22725	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 22726	    while i < len(toks):
 22727	        code = toks[i][:1]
 22728	        if code in ("R", "C") and i + 2 < len(toks):
 22729	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 22730	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 22731	            if code == "R":
 22732	                gone.add(nfc(toks[i + 1]))
 22733	            i += 3
 22734	        elif i + 1 < len(toks):
 22735	            paths.add(nfc(toks[i + 1]))
 22736	            if code == "D":
 22737	                gone.add(nfc(toks[i + 1]))
 22738	            i += 2
 22739	        else:
 22740	            break
 22741	    return paths, src, gone - set(src)
