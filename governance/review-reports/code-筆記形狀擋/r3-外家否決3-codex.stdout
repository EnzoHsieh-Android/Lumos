 23444	_NS_PIN_HEX_RE = re.compile(r"^[0-9a-fA-F]{12,40}$")
 23445	_NS_STRUCT_KEY_RE = re.compile(r"^\s*(?:-\s+)?(id|decided|valid|superseded_by|ended|decided_by|replaces)\s*:")
