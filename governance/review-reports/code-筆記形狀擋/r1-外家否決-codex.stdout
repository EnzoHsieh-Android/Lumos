 19869	def _node_code_ref_tokens(text, top_dirs, *, bare_text=False, anchors=False, keep_fences=False, pins=None, singles=None):
 19870	    """節點文字裡用反引號寫的程式路徑引用,回 (full, bare):
 19871	    full=含 / 且頂層目錄存在的 (token, 行號) 清單(依出現順序、去重,帶 :行號 的剝成第二欄);bare=不含 / 的裸 token 集合。
 19872	    ★refcheck、改檔前推筆記、每支檔有家三處共用這一支★——推筆記認得的,跟每支檔有家認得的,一定一樣
 19873	    (兩套算法一定分岔,而分岔時沒有東西會翻紅;Projects/每支檔有家_計劃 [S7])。
 19874	
 19875	    筆記形狀擋(Projects/筆記形狀擋_計劃 [S9])加的選項,★預設全關,既有使用者行為不變★:
 19876	    bare_text=也認沒包反引號的 `路徑:行號`;anchors=也認 `路徑#L行號`;keep_fences=圍欄裡的內容也看
 19877	    (預設一開頭就把圍欄整段刪掉,那是 refcheck 家族要的)。
 19878	    ★釘版本寫法 `路徑@<提交>:行號` 預設就解析★:full 裡給的仍是兩欄、路徑去掉 `@<提交>`——每支檔有家那三處用
 19879	    `for t, _l in full` 兩欄拆,多一欄就當場出錯(筆記形狀擋 r3 邊界席);要知道釘了哪個提交的呼叫端傳 pins=[],
 19880	    會另外收到 (路徑, 行號, 提交字串)——提交字串照原樣給(HEAD、分支名也收),合不合法由呼叫端判。
 19881	    singles=[]:另外收沒有 / 的 `檔名:行號`(裸 token 原本只回集合、不帶行號)。"""
 19882	    _suffix_re = re.compile(r":([^/]+)$")
 19883	    # ★不可換回 FENCE_RE★(見 _visible_lines):此處餵 G1 硬閘與 impact hook
 19884	    src = "\n".join(ln for _no, ln in _visible_lines(text.split("\n"), keep_fenced=True)) if keep_fences \
 19885	        else _strip_fences_text(text)
 19886	    spans = [s.strip("`") for s in INLINE_CODE_RE.findall(src)]
 19887	    raws = list(spans)
 19888	    if bare_text:
 19889	        rest = INLINE_CODE_RE.sub(" ", src)
 19890	        raws += [m.group(0) for m in _NODE_BARE_REF_RE.finditer(rest)]
 19891	    seen = set()
 19892	    full = []
 19893	    for raw in raws:
 19894	        if "://" in raw or any(c in raw for c in "*<>?"):
 19895	            continue
 19896	        m = _suffix_re.search(raw)
 19897	        line = ""
 19898	        if m:
 19899	            token, sfx = raw[:m.start()], m.group(1)
 19900	            line = sfx if re.fullmatch(r"\d+(?:-\d+)?", sfx) else ""
 19901	        else:
 19902	            token = raw
 19903	        if anchors and not line:
 19904	            ma = re.search(r"#L(\d+)(?:-L?\d+)?$", token)
 19905	            if ma:
 19906	                token, line = token[:ma.start()], ma.group(1)
 19907	        pin = None
 19908	        if "@" in token.rsplit("/", 1)[-1]:
 19909	            token, pin = token.rsplit("@", 1)
 19910	        if "/" not in token:
 19911	            if singles is not None and line and token and (token, line, pin) not in seen:
 19912	                seen.add((token, line, pin))
 19913	                singles.append((token, line, pin))
 19914	            continue
 19915	        if token.split("/")[0] not in top_dirs:
 19916	            continue
 19917	        if pin is not None and pins is not None and (token, line, pin) not in pins:
 19918	            pins.append((token, line, pin))
 19919	        if (token, line) in seen:
 19920	            continue
 19921	        seen.add((token, line))
 19922	        full.append((token, line))
 19923	    return full, {s for s in spans if "/" not in s}
 19924	
