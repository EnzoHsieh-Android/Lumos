 27936	def _lens_git(repo_root, *args, quote=False, binary=False):
 27937	    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
 27938	    import subprocess as _sp
 27939	    cmd = ["git", "-C", str(repo_root)]
 27940	    if quote:
 27941	        cmd += ["-c", "core.quotePath=false"]
 27942	    try:
 27943	        if binary:
 27944	            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
 27945	        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
 27946	    except (OSError, _sp.TimeoutExpired):
 27947	        return None
