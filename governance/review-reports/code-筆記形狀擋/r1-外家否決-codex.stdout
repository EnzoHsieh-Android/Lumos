 22686	def _nodehome_changes(repo_root, base, tip):
 22687	    """[(狀態字母, 舊路徑, 新路徑)];改名的新路徑算新增 [S31]。base=None 且 tip='index' → 看暫存區。
 22688	    ★只帶 -M、沒帶 -C★:複製出來的檔 git 標成 A,照樣算新增(使用者設了 diff.renames=copies 也一樣,-M 蓋過它);
 22689	    下面認 C 那半只是防呆,這條呼叫實際收不到 C(代碼審 r1 正確性席)。"""
 22690	    if tip == "index":
 22691	        args = ["diff", "--cached", "--name-status", "-z", "-M"]
 22692	        if base is None:
 22693	            args.append(_EMPTY_TREE_SHA)
 22694	    else:
 22695	        args = ["diff", "--name-status", "-z", "-M", base or _EMPTY_TREE_SHA, tip]
 22696	    raw = _nodehome_git(repo_root, *args)
 22697	    if raw is None:
 22698	        return None
 22699	    toks = _nodehome_split_z(raw)
 22700	    out, i = [], 0
 22701	    while i < len(toks):
 22702	        st = toks[i]
 22703	        code = st[:1]
 22704	        if code in ("R", "C") and i + 2 < len(toks):
 22705	            out.append((code, nfc(toks[i + 1]), nfc(toks[i + 2])))
 22706	            i += 3
 22707	        elif i + 1 < len(toks):
 22708	            p = nfc(toks[i + 1])
 22709	            out.append((code, p if code != "A" else None, p if code != "D" else None))
 22710	            i += 2
 22711	        else:
 22712	            break
 22713	    return out
