 48239	def t_note_lines_scope_rename_and_non_utf8():
 48240	    """[S6] 行的範圍:正文、summary、decisions(含巢狀清單)算;其他開頭欄位與 decisions 結構鍵不算;
 48241	    改名認成同一篇(舊行不重查);讀不成 UTF-8 的筆記 rc1 並指名。"""
 48242	    print("t_note_lines_scope_rename_and_non_utf8")
 48243	    root = _ns_repo()
 48244	    cases = [
 48245	        ("summary", dict(summary="KEY:x\nWHY:[2026-09-27] 見 `src/a.py:3`"), True),
 48246	        ("decisions 巢狀", dict(extra="decisions:\n  - id: d1\n    content: 選 A\n    alternatives_considered:\n      - 見 `src/a.py:3` 那段"), True),
 48247	        ("aliases", dict(extra="links:\n  - \"src/a.py:3\""), False),
 48248	    ]
 48249	    for label, kw, want_block in cases:
 48250	        _ns_note(root, **kw)
 48251	        _ns_stage(root)
 48252	        rc, out = _ns(root)
 48253	        check(f"①{label}:{'算' if want_block else '不算'}", (rc == 1) == want_block, out[-500:])
 48254	        _ns_reset(root)
 48255	    _ns_note(root, body="舊的 `src/a.py:3`")
 48256	    _nh_commit(root, "old")
 48257	    _nh_git(root, "mv", "docs/kg-knowledge/Systems/A.md", "docs/kg-knowledge/Systems/A2.md")
 48258	    p = root / "docs" / "kg-knowledge" / "Systems" / "A2.md"
 48259	    p.write_text(p.read_text(encoding="utf-8") + "新增一行乾淨的\n", encoding="utf-8")
 48260	    _ns_stage(root)
 48261	    rc, out = _ns(root)
 48262	    check("②改名認成同一篇:舊行不重查", rc == 0, out[-500:])
 48263	    _ns_reset(root)
 48264	    (root / "docs" / "kg-knowledge" / "Systems" / "Bad.md").write_bytes(b"---\ntype: system\n---\n\xff\xfe bad\n")
 48265	    _ns_stage(root)
 48266	    rc, out = _ns(root)
 48267	    check("③讀不成 UTF-8:rc1 並指名那支檔", rc == 1 and "Bad.md" in out, out[-400:])
 48268	
