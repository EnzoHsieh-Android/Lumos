 48170	def t_note_lines_range_base_and_own_golive_clamp():
 48171	    """[S4] --diff 範圍起點早於 note-shape 自己的上線點時從上線點算(不是每支檔有家的);上線前的舊違規不擋;
 48172	    淺層 clone 不算範圍、放行並寫一筆 skipped-env。"""
 48173	    print("t_note_lines_range_base_and_own_golive_clamp")
 48174	    root = _ns_repo(golive=False)
 48175	    _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n# home check --staged\n")
 48176	    _ns_note(root, body="上線前的舊違規 `src/a.py:2`")
 48177	    _nh_commit(root, "old violation, before note-shape golive")
 48178	    _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n# home check --staged\n# " + _NS_HOOK_LINE + "\n")
 48179	    _nh_commit(root, "golive")
 48180	    _ns_note(root, body="上線前的舊違規 `src/a.py:2`\n乾淨的一行")
 48181	    _nh_commit(root, "clean")
 48182	    tip = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48183	    empty = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
 48184	    rc, out = _ns(root, "--diff", f"{empty}..{tip}")
 48185	    check("①從空樹起算會被截到 note-shape 上線點:舊違規不擋", rc == 0, out[-500:])
 48186	    _ns_note(root, body="上線前的舊違規 `src/a.py:2`\n乾淨的一行\n新違規 `src/a.py:9`")
 48187	    _nh_commit(root, "new violation")
 48188	    tip2 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48189	    rc, out = _ns(root, "--diff", f"{empty}..{tip2}")
 48190	    check("②上線後的新違規照擋、只列新的", rc == 1 and "a.py:9" in out and "a.py:2" not in out, out[-500:])
 48191	    import subprocess as sp
 48192	    sh = Path(tempfile.mkdtemp(prefix="gctl-ns-shallow-")) / "c"
 48193	    sp.run(["git", "clone", "-q", "--depth", "1", f"file://{root}", str(sh)], capture_output=True)
 48194	    for k, v in (("user.email", "t@t.t"), ("user.name", "t")):
 48195	        sp.run(["git", "-C", str(sh), "config", k, v], capture_output=True)
 48196	    rc, out = _ns(sh, "--diff", f"{empty}..HEAD")
 48197	    check("③淺層 clone:不算範圍、放行、講原因", rc == 0 and "淺層" in out, out[-500:])
 48198	    check("④淺層 clone 寫一筆 skipped-env", any(e.get("gate") == "note-shape" and e.get("kind") == "skipped-env" for e in _ns_gov(sh)), str(_ns_gov(sh))[-300:])
 48199	
