 22716	def _nodehome_name_status(raw):
 22717	    """git diff-tree --name-status -z 的輸出 → (改到的路徑, 改名新路徑→舊路徑, 刪掉或改名掉的舊路徑)。"""
 22718	    toks, paths, src, gone, i = _nodehome_split_z(raw), set(), {}, set(), 0
 22719	    while i < len(toks):
 22720	        code = toks[i][:1]
 22721	        if code in ("R", "C") and i + 2 < len(toks):
 22722	            paths.update((nfc(toks[i + 1]), nfc(toks[i + 2])))
 22723	            src[nfc(toks[i + 2])] = nfc(toks[i + 1])
 22724	            if code == "R":
 22725	                gone.add(nfc(toks[i + 1]))
 22726	            i += 3
 22727	        elif i + 1 < len(toks):
 22728	            paths.add(nfc(toks[i + 1]))
 22729	            if code == "D":
 22730	                gone.add(nfc(toks[i + 1]))
 22731	            i += 2
 22732	        else:
 22733	            break
 22734	    return paths, src, gone - set(src)
