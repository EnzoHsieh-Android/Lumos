 23531	def _ns_range_added(repo_root, base, tip, vault_rel, exclude_remote=True):
 23532	    """推送前:範圍裡每個提交各自新增的筆記行文字 → (集合, 範圍淨改動的筆記路徑)。git 失敗回 None。
 23533	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);
 23534	    ★已在遠端追蹤分支上的提交不重查★(exclude_remote)——那些推上去的時候已經查過,或是別人的分支。"""
 23535	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23536	    if exclude_remote:
 23537	        rl += ["--not", "--remotes"]
 23538	    raw = _nodehome_git(repo_root, *rl)
 23539	    if raw is None:
 23540	        return None
 23541	    texts = set()
 23542	    for line in raw.decode("ascii", errors="replace").splitlines():
 23543	        shas = line.split()
 23544	        if not shas:
 23545	            continue
 23546	        sha, parents = shas[0], shas[1:]
 23547	        if len(parents) <= 1:
 23548	            d = _ns_diff(repo_root, parents[0] if parents else _EMPTY_TREE_SHA, sha, "--", vault_rel)
 23549	            if d is None:
 23550	                return None
 23551	            for _p, rows in _ns_parse_added(d).items():
 23552	                texts.update(t_.strip() for _n, t_ in rows if t_.strip())
 23553	            continue
 23554	        names = _nodehome_git(repo_root, "diff", "--name-only", "-z", "-M", parents[0], sha, "--", vault_rel)
 23555	        if names is None:
 23556	            return None
 23557	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23558	        specs = []
 23559	        for p in paths:
 23560	            specs.append(f"{sha}:{p}")
 23561	            specs += [f"{pp}:{p}" for pp in parents]
 23562	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23563	        k = 1 + len(parents)
 23564	        for i, p in enumerate(paths):
 23565	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23566	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23567	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23568	                d = _ns_diff(repo_root, parents[0], sha, "--", p)
 23569	                if d is None:
 23570	                    return None
 23571	                for _p, rows in _ns_parse_added(d).items():
 23572	                    texts.update(t_.strip() for _n, t_ in rows if t_.strip())
 23573	            else:
 23574	                texts.update(x.decode("utf-8", errors="surrogateescape") for x in new)
 23575	    net = _nodehome_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 23576	    if net is None:
 23577	        return None
 23578	    return texts, [p for p in _nodehome_split_z(net) if p.endswith(".md")]
 23579	
