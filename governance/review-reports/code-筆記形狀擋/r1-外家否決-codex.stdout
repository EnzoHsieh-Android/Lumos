 47919	def t_prepush_docs_and_light_run_subset():
 47920	    """推送前掛鉤真跑:純文件推送只叫執行器跑 --suite docs(分片照切);改到程式但 push-check 判 light 且 pitfalls 說 light_ok 的,
 47921	    文件子集與 --suite keys 各自分片平行跑;keys 每片 rc3(沒對到)不擋、講明 CI 會跑全套;keys 有紅(rc1)擋(r1 合約席:這條路原本沒測試走到);
 47922	    範圍裡夾了測試檔(既非文件也非程式)→ light_ok 假 → 全套(r1 資安席);一般程式改動照跑全套。執行器換成把參數記到檔裡的假貨。"""
 47923	    import subprocess as _sp, os as _os
 47924	    hook = str(Path(__file__).resolve().parent / "hooks" / "pre-push")
