 22668	def _nodehome_refs(text, side, req):
 22669	    """[S7][S8] 這篇用反引號寫到哪幾支需要家的檔:抽取跟改檔前推筆記同一支(完整路徑+在受版控檔裡唯一的裸檔名)。
 22670	    裸檔名不唯一時推筆記那支不認它,這裡也不認——不構成「別人檔的入口」,就不算認領。"""
 22671	    top_dirs = _nodehome_top_dirs(side.all_paths)
 22672	    full, bare = _node_code_ref_tokens(text, top_dirs)
 22673	    refs = {nfc(t) for t, _l in full if nfc(t) in req}
 22674	    if int(_impact_knob("LUMOS_IMPACT_BASENAME_MATCH", 1)):
 22675	        counts, where = {}, {}
 22676	        for p in side.all_paths:
 22677	            b = p.rsplit("/", 1)[-1]
 22678	            counts[b] = counts.get(b, 0) + 1
 22679	            where[b] = p
 22680	        for b in bare:
 22681	            if counts.get(b) == 1 and where[b] in req:
 22682	                refs.add(where[b])
 22683	    return refs
