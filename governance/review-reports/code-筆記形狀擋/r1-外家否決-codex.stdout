 23594	def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name):
 23595	    """一行新增內容 → [(規則, 片段, 改法)]。"""
 23596	    out = []
 23597	    pins, singles = [], []
 23598	    full, _bare = _node_code_ref_tokens(text, top_dirs, bare_text=True, anchors=True, keep_fences=True,
 23599	                                        pins=pins, singles=singles)
 23600	    pinned = {(p, l) for p, l, _s in pins}
 23601	    for p, l, s in pins:
 23602	        if not l:
 23603	            continue
 23604	        sha = _pin_commit(repo_root, s)
 23605	        ok = sha is not None and _validate_repo_ref(repo_root, p, l, at_sha=sha)[0] == "ok"
 23606	        if not ok and (p in files or _ns_is_code(p, reader, files) or sha is None):
 23607	            out.append(("釘版本不合法", f"`{p}@{s}:{l}`",
 23608	                        "`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
 23609	                        "HEAD、分支名、標籤會移動,不算釘住"))
 23610	    for p, l in full:
 23611	        if not l or (p, l) in pinned:
 23612	            continue
 23613	        if _ns_is_code(p, reader, files):
 23614	            out.append(("程式行號引用", f"`{p}:{l}`",
 23615	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{l}`"))
 23616	    for name, l, s in singles:
 23617	        cands = by_name.get(name, [])
 23618	        if len(cands) == 1 and s is None and _ns_is_code(cands[0], reader, files):
 23619	            out.append(("程式行號引用", f"`{name}:{l}`(= {cands[0]})",
 23620	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{l}`"))
 23621	    if region == "summary":
 23622	        for w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
 23623	            out.append(("現況描述沒寫來源", text.strip()[:60],
 23624	                        "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
 23625	    return out
 23626	
