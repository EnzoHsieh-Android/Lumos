 22310	# 斜線也算檔名字元:不然正文寫 lib/src/pay.py 會被判成「有提到 src/pay.py」(代碼審 r2 合約席)
 22311	_HOME_MENTION_BOUNDARY = re.compile(r"[A-Za-z0-9_.@+/\-]")
 22312	
 22313	
 22314	def _home_mentions(scan_text, rel_path):
 22315	    """這段文字有沒有提到這支檔(完整路徑或裸檔名,整詞比對)。
 22316	
 22317	    ★不要用 `base in scan` 這種子字串比對★:新掛 `a.py`、正文只寫了 `xa.py`,子字串會判成「有提到」,
 22318	    提醒就被吃掉——代碼審 r1 邊界席實測。所以命中位置的前後要是非檔名字元(或字串邊界)才算。
 22319	    """
 22320	    base = rel_path.rsplit("/", 1)[-1]
 22321	    for token in (rel_path, base):
 22322	        if not token:
 22323	            continue
 22324	        start = 0
 22325	        while True:
 22326	            i = scan_text.find(token, start)
 22327	            if i < 0:
 22328	                break
 22329	            before = scan_text[i - 1] if i > 0 else ""
 22330	            after = scan_text[i + len(token)] if i + len(token) < len(scan_text) else ""
 22331	            if not _HOME_MENTION_BOUNDARY.match(before or " ") and not _HOME_MENTION_BOUNDARY.match(after or " "):
 22332	                return True
 22333	            start = i + 1
 22334	    return False
