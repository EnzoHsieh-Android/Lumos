 26931	def _node_code_ref_tokens_all(text, top_dirs):
 26932	    """[S2] 同一支抽取的「掃全文」模式:反引號那組照 _node_code_ref_tokens 抽(共用同一套 token 規則與
 26933	    頂層目錄判定),另外在全文找「頂層資料夾開頭的完整路徑」。★裸 token 只從反引號那組來★——沒有副檔名的
 26934	    程式檔,檔名就是普通詞(本工具鏈 65 篇 Systems 有 62 篇正文出現裸字 lumos),全文放寬會讓分兩級失效。
 26935	    回傳形狀同 _node_code_ref_tokens(full 是兩者聯集)。"""
 26936	    full, bare = _node_code_ref_tokens(text, top_dirs)
 26937	    seen = {t for t, _l in full}
 26938	    for mt in _PATH_IN_TEXT_RE.finditer(_strip_fences_text(text)):
 26939	        tok = mt.group(0).rstrip(".,;:)]}」』、。")
 26940	        if "/" in tok and tok.split("/")[0] in top_dirs and tok not in seen:
 26941	            seen.add(tok)
 26942	            full.append((tok, ""))
 26943	    return full, bare
