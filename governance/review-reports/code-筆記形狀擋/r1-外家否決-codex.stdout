 22948	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 22949	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 22950	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 22951	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 22952	    None=整批當成一個提交(提交前)。"""
 22953	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 22954	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 22955	    homesN, ownN = _nodehome_homes(repo_root, N)
 22956	    homesB, ownB = _nodehome_homes(repo_root, B)
 22957	    blocks, reminders, pairs = [], [], []
 22958	    added, changed_new, renamed_from, deleted = set(), set(), {}, set()
 22959	    for code, old, new in changes:
 22960	        if old is not None and (new is None or code == "R"):
 22961	            deleted.add(old)
 22962	        if new is None:
 22963	            continue
 22964	        changed_new.add(new)
 22965	        if code in ("A", "R", "C"):
 22966	            added.add(new)
 22967	        if code == "R" and old:
 22968	            renamed_from[new] = old
 22969	    code_changed = {p for p in changed_new if p in reqN}
 22970	    code_added = {p for p in added if p in reqN}
 23420	    if res["pairs"]:
 23421	        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
 23422	    if notes_:
 23423	        extra["notes"] = sorted(notes_)[:50]
 23424	    _gate_event_or_warn(root, "nodehome-check", kind,
 23425	                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
 23426	                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
 23427	    return 1 if kind == "blocked" else 0
