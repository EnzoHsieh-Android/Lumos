 23530	
 23531	def _ns_range_added(repo_root, base, tip, vault_rel, exclude_remote=True):
 23532	    """推送前:範圍裡每個提交各自新增的筆記行文字 → (集合, 範圍淨改動的筆記路徑)。git 失敗回 None。
 23533	    ★合併提交只算它自己寫的★:合併結果裡每一個上一版都找不到的行(_merge_new_lines);
 23534	    ★已在遠端追蹤分支上的提交不重查★(exclude_remote)——那些推上去的時候已經查過,或是別人的分支。"""
 23535	    rl = ["rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip]
 23536	    if exclude_remote:
 23537	        rl += ["--not", "--remotes"]
 23538	    raw = _nodehome_git(repo_root, *rl)
 23539	    if raw is None:
 23540	        return None
 23541	    texts = set()
 23542	    for line in raw.decode("ascii", errors="replace").splitlines():
 23543	        shas = line.split()
 23544	        if not shas:
 23545	            continue
 23546	        sha, parents = shas[0], shas[1:]
 23547	        if len(parents) <= 1:
 23548	            d = _ns_diff(repo_root, parents[0] if parents else _EMPTY_TREE_SHA, sha, "--", vault_rel)
 23549	            if d is None:
 23550	                return None
 23551	            for _p, rows in _ns_parse_added(d).items():
 23552	                texts.update(t_.strip() for _n, t_ in rows if t_.strip())
 23553	            continue
 23554	        names = _nodehome_git(repo_root, "diff", "--name-only", "-z", "-M", parents[0], sha, "--", vault_rel)
 23555	        if names is None:
 23556	            return None
 23557	        paths = [p for p in _nodehome_split_z(names) if p.endswith(".md")]
 23558	        specs = []
 23559	        for p in paths:
 23560	            specs.append(f"{sha}:{p}")
 23561	            specs += [f"{pp}:{p}" for pp in parents]
 23562	        blobs = _nodehome_cat_blobs(repo_root, specs) if specs else []
 23563	        k = 1 + len(parents)
 23564	        for i, p in enumerate(paths):
 23565	            merged, *olds = (blobs[i * k:(i + 1) * k] if blobs is not None else [None] * k)
 23566	            new = _merge_new_lines(merged, olds) if blobs is not None else None
 23567	            if new is None:                       # 判不了:照一般提交跟第一個上一版比(多查不漏查)
 23568	                d = _ns_diff(repo_root, parents[0], sha, "--", p)
 23569	                if d is None:
 23570	                    return None
 23571	                for _p, rows in _ns_parse_added(d).items():
 23572	                    texts.update(t_.strip() for _n, t_ in rows if t_.strip())
 23573	            else:
 23574	                texts.update(x.decode("utf-8", errors="surrogateescape") for x in new)
 23575	    net = _nodehome_git(repo_root, "diff", "--name-only", "-z", "-M", "--diff-filter=AMR", base or _EMPTY_TREE_SHA, tip, "--", vault_rel)
 23576	    if net is None:
 23577	        return None
 23578	    return texts, [p for p in _nodehome_split_z(net) if p.endswith(".md")]
 23579	
 23580	
 23581	def _ns_is_code(path, reader, files):
 23582	    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
 23583	    if path not in files:
 23584	        return False
 23585	    kind = _nodehome_code_kind(path)
 23586	    if kind == "ext":
 23587	        return True
 23588	    if kind != "shebang?":
 23589	        return False
 23590	    b = reader(path)
 23591	    return b is not None and _head_is_shebang(b[:200])
 23592	
 23593	
 23594	def _ns_check_line(repo_root, text, region, files, reader, top_dirs, by_name):
 23595	    """一行新增內容 → [(規則, 片段, 改法)]。"""
 23596	    out = []
 23597	    pins, singles = [], []
 23598	    full, _bare = _node_code_ref_tokens(text, top_dirs, bare_text=True, anchors=True, keep_fences=True,
 23599	                                        pins=pins, singles=singles)
 23600	    pinned = {(p, l) for p, l, _s in pins}
 23601	    for p, l, s in pins:
 23602	        if not l:
 23603	            continue
 23604	        sha = _pin_commit(repo_root, s)
 23605	        ok = sha is not None and _validate_repo_ref(repo_root, p, l, at_sha=sha)[0] == "ok"
 23606	        if not ok and (p in files or _ns_is_code(p, reader, files) or sha is None):
 23607	            out.append(("釘版本不合法", f"`{p}@{s}:{l}`",
 23608	                        "`@` 後面要是至少 12 位、在某個分支歷史上的提交編號,而且那個提交裡這支檔有這一行;"
 23609	                        "HEAD、分支名、標籤會移動,不算釘住"))
 23610	    for p, l in full:
 23611	        if not l or (p, l) in pinned:
 23612	            continue
 23613	        if _ns_is_code(p, reader, files):
 23614	            out.append(("程式行號引用", f"`{p}:{l}`",
 23615	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」、要指測試就寫測試名,或釘版本 `{p}@<至少12位提交編號>:{l}`"))
 23616	    for name, l, s in singles:
 23617	        cands = by_name.get(name, [])
 23618	        if len(cands) == 1 and s is None and _ns_is_code(cands[0], reader, files):
 23619	            out.append(("程式行號引用", f"`{name}:{l}`(= {cands[0]})",
 23620	                        f"行號一改碼就錯位:改寫成「哪支檔的哪個函式」,或釘版本 `{cands[0]}@<至少12位提交編號>:{l}`"))
 23621	    if region == "summary":
 23622	        for w in context_marker_warnings(text, rules=_NOTE_SHAPE_PREFIX_RULES):
 23623	            out.append(("現況描述沒寫來源", text.strip()[:60],
 23624	                        "只准寫程式碼答不了的現況並帶 [來源:部署|資料庫|生產|外部|人工];程式碼查得到的就刪掉"))
 23625	    return out
 23626	
 23627	
 23628	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 23629	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 23630	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 23631	    if ch is None:
 23632	        return []
 23633	    lst_t = _nodehome_list(repo_root, tip_where)
 23634	    lst_b = _nodehome_list(repo_root, base_where)
 23635	    if lst_t is None or lst_b is None:
 23636	        return []
 23637	    reader_b = _nodehome_reader(repo_root, base_where)
 23638	    out = []
 23639	    for code, old, new in ch:
 23640	        if not new or code == "D":
 23641	            continue
 23642	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 23643	            continue
 23644	        prev = old or new
 23645	        if prev not in lst_b[0] or not _ns_is_code(prev, reader_b, lst_b[0]):
 23646	            out.append(new)
 23647	    return out
 23648	
 23649	
 23650	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None):
 23651	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 23652	    reader = _nodehome_reader(repo_root, tip_where)
 23653	    lst = _nodehome_list(repo_root, tip_where)
 23654	    if lst is None:
 23655	        return None
 23656	    files = lst[0]
 23657	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 23658	    by_name = {}
 23659	    for p in files:
 23660	        if _nodehome_code_kind(p) is not None:
 23661	            by_name.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23662	    viol, errs = [], []
 23663	    # 1) 這次新增的行
 23664	    if staged:
 23665	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23666	        if d is None:
 23667	            return None
 23668	        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
 23669	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
 23670	        texts = None
 23671	    else:
 23672	        ra = _ns_range_added(repo_root, base_where, tip_where, vault_rel, exclude_remote)
 23673	        if ra is None:
 23674	            return None
 23675	        texts, paths = ra
 23676	        cand = {p: None for p in paths}
 23677	    for p, linenos in sorted(cand.items()):
 23678	        b = reader(p)
 23679	        if b is None:
 23680	            continue
 23681	        try:
 23682	            text = b.decode("utf-8")
 23683	        except UnicodeDecodeError:
 23684	            errs.append(f"{p}:這篇筆記不是 UTF-8 文字,檢查不了——轉成 UTF-8 再提交")
 23685	            continue
 23686	        lines = text.split("\n")
 23687	        regs = _ns_regions(text)
 23688	        for i, ln in enumerate(lines, 1):
 23689	            if linenos is not None and i not in linenos:
 23690	                continue
 23691	            if texts is not None and ln.strip() not in texts:
 23692	                continue
 23693	            if not ln.strip() or regs[i - 1] == "other":
 23694	                continue
 23695	            for rule, frag, fix in _ns_check_line(repo_root, ln, regs[i - 1], files, reader, top_dirs, by_name):
 23696	                viol.append((p, i, rule, frag, fix))
 23697	    # 2) 新程式檔喚醒舊引用(筆記這次沒改也查;上線點版本裡就有的那行是舊帳,不算)
 23698	    became = _ns_became_code(repo_root, base_where if not staged else _lens_full_sha(repo_root, "HEAD"),
 23699	                             tip_where, reader)
 23700	    if became:
 23701	        gl = _nodehome_golive(repo_root, tip_where if tip_where != "index" else "HEAD", mark or _NOTE_SHAPE_GOLIVE_MARK)
 23702	        if gl is not None:
 23703	            gl_reader = _nodehome_reader(repo_root, gl)
 23704	            args = ["grep", "-n", "-I", "--full-name", "-F"]
 23705	            for x in became:
 23706	                args += ["-e", x]
 23707	            args += (["--cached"] if tip_where == "index" else [tip_where]) + ["--", vault_rel]
 23708	            g = _nodehome_git(repo_root, *args)
 23709	            seen = {(v[0], v[1]) for v in viol}
 23710	            for row in (g or b"").decode("utf-8", errors="replace").splitlines():
 23711	                parts = row.split(":", 3) if tip_where != "index" else [""] + row.split(":", 2)
 23712	                if len(parts) < 4:
 23713	                    continue
 23714	                _rev, p, n, ln = parts
 23715	                if not p.endswith(".md") or not n.isdigit() or (p, int(n)) in seen:
 23716	                    continue
 23717	                old = gl_reader(p)
 23718	                if old is not None and ln.strip() in {x.strip() for x in old.decode("utf-8", errors="replace").split("\n")}:
 23719	                    continue
 23720	                full, _b = _node_code_ref_tokens(ln, top_dirs, bare_text=True, anchors=True, keep_fences=True, pins=[])
 23721	                for tok, l in full:
 23722	                    if tok in became and l and f"{tok}@" not in ln:
 23723	                        viol.append((p, int(n), "程式行號引用(新程式檔喚醒)", f"`{tok}:{l}`",
 23724	                                     f"這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:改寫或釘版本 `{tok}@<提交編號>:{l}`"))
 23725	    return viol, errs
 23726	
 23727	
 23728	def _note_shape_doctor_lines(repo_root, vault):
 23729	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 23730	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 23731	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 23732	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 23733	    out = []
 23734	    root = Path(repo_root)
 23735	    cp = root / ".lumos" / "config.json"
 23736	    txt = None
 23737	    try:
 23738	        if cp.is_file() and not cp.is_symlink():
 23739	            txt = cp.read_bytes()
 23740	    except OSError:
 23741	        txt = None
 23742	    mode, _w = _note_shape_config(txt)
 23743	    if mode != "block":
 23744	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 23745	                   "沒寫來源的現況描述不會被擋")
 23746	    wf = root / ".github" / "workflows"
 23747	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 23748	    if ymls:
 23749	        body = "\n".join(p.read_text(encoding="utf-8", errors="replace") for p in ymls)
 23750	        step = ("- run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 23751	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before }}..${{ github.sha }}\" "
 23752	                "(checkout 要設 fetch-depth: 0;新分支首推前一版全零時改從空樹給,lumos 會自己截到上線點)")
 23753	        if "note-shape --diff" not in body:
 23754	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 23755	        elif "fetch-depth: 0" not in body:
 23756	            out.append("專案 CI 呼叫了 note-shape,但沒抓完整歷史(fetch-depth: 0):淺層 clone 算不出範圍,每次都會跳過")
 23757	    gl = _nodehome_golive(root, "HEAD", _NOTE_SHAPE_GOLIVE_MARK)
 23758	    if gl is None:
 23759	        return out
 23760	    ref = None
 23761	    up = _lens_git(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
 23762	    if up is not None and up.returncode == 0 and up.stdout.strip():
 23763	        ref = up.stdout.strip()
 23764	    else:
 23765	        br = _lens_git(root, "rev-parse", "--abbrev-ref", "HEAD")
 23766	        name = br.stdout.strip() if br is not None and br.returncode == 0 else ""
 23767	        rr = _lens_git(root, "for-each-ref", "--format=%(refname)", f"refs/remotes/*/{name}") if name else None
 23768	        cands = rr.stdout.split() if rr is not None and rr.returncode == 0 else []
 23769	        ref = cands[0] if cands else None
 23770	    tip = _lens_full_sha(root, ref) if ref else None
 23771	    if tip is None:
 23772	        return out
 23773	    a = _lens_git(root, "merge-base", "--is-ancestor", gl, tip)
 23774	    if a is None or a.returncode != 0:
 23775	        return out
 23776	    try:
 23777	        vault_rel = Path(vault).resolve().relative_to(root.resolve()).as_posix()
 23778	    except ValueError:
 23779	        return out
 23780	    res = _note_shape_eval(root, False, gl, tip, vault_rel, exclude_remote=False)
 23781	    if res:
 23782	        viol, errs = res
 23783	        if viol:
 23784	            shown = "; ".join(f"{p}:{n} {rule} {frag}" for p, n, rule, frag, _f in viol[:10])
 23785	            more = f"(另有 {len(viol) - 10} 處)" if len(viol) > 10 else ""
 23786	            out.append(f"已推上遠端({ref})卻違反筆記形狀擋的新增行 {len(viol)} 處(多半是 --no-verify 繞過):{shown}{more}")
 23787	    return out
 23788	
 23789	
 23790	def cmd_note_shape(repo=None, staged=False, diff_range=None):
 23791	    """lumos note-shape --staged | --diff A..B(Projects/筆記形狀擋_計劃):有新違規 rc1,沒有 rc0;參數錯 rc2。
 23792	    不是 git、git 算不出來、淺層 clone、合併中、開關 off → 說一句、rc0(fail-open;推送前與 CI 會再跑)。
 23793	    ★設定與內容都從被檢查的版本讀★(提交前=提交索引、推送前=終點提交),工作目錄沒暫存的東西不算。
 23794	    只有擋下與跳過寫治理帳,放行不寫——刻意跟每支檔有家每次都寫 passed 不同:每次提交一筆沒資訊的行正是
 23795	    rtb 回饋抱怨的帳本雜訊。"""
 23796	    root = Path(repo).resolve() if repo else None
 23797	    if root is None:
 23798	        r = _lens_git(".", "rev-parse", "--show-toplevel")
 23799	        if r is None or r.returncode != 0:
 23800	            print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23801	            return 0
 23802	        root = Path(r.stdout.strip())
 23803	    r = _lens_git(root, "rev-parse", "--is-inside-work-tree")
 23804	    if r is None or r.returncode != 0:
 23805	        print("筆記形狀擋:這裡不是 git 專案,跳過", file=sys.stderr)
 23806	        return 0
 23807	    if os.environ.get("LUMOS_SKIP_NOTE_SHAPE"):
 23808	        print("筆記形狀擋:LUMOS_SKIP_NOTE_SHAPE 設了,這次跳過(已記進治理帳)", file=sys.stderr)
 23809	        _gate_event_or_warn(root, "note-shape", "skipped-env", "LUMOS_SKIP_NOTE_SHAPE")
 23810	        return 0
 23811	    if staged:
 23812	        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
 23813	        if mh is not None and mh.returncode == 0:
 23814	            print("筆記形狀擋:合併提交跳過(推送前只查合併自己多寫的行)", file=sys.stderr)
 23815	            return 0
 23816	        base_where, tip_where, mode_word = _lens_full_sha(root, "HEAD"), "index", "這次提交"
 23817	    else:
 23818	        rg = _lens_range_ok(diff_range)
 23819	        if rg is None:
 23820	            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
 23821	            return 2
 23822	        sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
 23823	        if sh is not None and sh.stdout.strip() == "true":
 23824	            print("筆記形狀擋:淺層 clone 算不出範圍(找不到上線點與上一個提交),這次不查——CI 請設 fetch-depth: 0",
 23825	                  file=sys.stderr)
 23826	            _gate_event_or_warn(root, "note-shape", "skipped-env", "shallow clone")
 23827	            return 0
 23828	        a, b = rg
 23829	        tip = _lens_full_sha(root, b)
 23830	        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
 23831	        if tip is None or base is None:
 23832	            print(f"筆記形狀擋:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
 23833	            return 0
 23834	        base = _nodehome_clamp_base(root, base, tip, _NOTE_SHAPE_GOLIVE_MARK)
 23835	        base_where = None if base == _EMPTY_TREE_SHA else base
 23836	        tip_where, mode_word = tip, "這次推送"
 23837	    lst = _nodehome_list(root, tip_where)
 23838	    if lst is None:
 23839	        print("筆記形狀擋:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
 23840	        return 0
 23841	    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
 23842	    if not vaults:
 23843	        print("筆記形狀擋:這個專案沒有圖譜,跳過")
 23844	        return 0
 23845	    wv = _vault_in(root)
 23846	    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
 23847	    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
 23848	    mode, warns = _note_shape_config(_nodehome_reader(root, tip_where)(".lumos/config.json"))
 23849	    for w in warns:
 23850	        print(f"提醒:{w}", file=sys.stderr)
 23851	    if mode == "off":
 23852	        print("筆記形狀擋:這個專案把這道檢查關掉了(note_shape.gate=off),跳過", file=sys.stderr)
 23853	        return 0
 23854	    res = _note_shape_eval(root, staged, base_where, tip_where, vault_rel)
 23855	    if res is None:
 23856	        print("筆記形狀擋:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
 23857	        return 0
 23858	    viol, errs = res
 23859	    if not viol and not errs:
 23860	        return 0
 23861	    head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
 23862	    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
 23863	    for e in errs:
 23864	        print(f"  {e}", file=sys.stderr)
 23865	    for p, n, rule, frag, fix in viol:
 23866	        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
 23867	    if mode == "block":
 23868	        print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
