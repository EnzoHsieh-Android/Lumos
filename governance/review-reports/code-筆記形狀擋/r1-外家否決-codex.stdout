 27958	def _mainline_ref(repo_root):
 27959	    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
 27960	    回 (ref 名, sha) 或 None。"""
 27961	    for cand in ("main@{upstream}", "master@{upstream}", "main", "master"):
 27962	        sha = _lens_full_sha(repo_root, cand)
 27963	        if sha:
 27964	            return cand, sha
 27965	    return None
