 22425	def _nodehome_is_test(path, layout=({}, {})):
 22426	    """測試檔判定:先問測試地圖那一支;再認各棧的測試資料夾(2026-09-12:平板 POS 測試資料夾裡的輔助檔、
 22427	    Android 儀器測試的 Kotlin 檔都被要求有家——測試地圖的規格刻意只認 test/tests 資料夾與檔名,不動它);
 22428	    副檔名不在測試地圖清單裡的(shell、Go、Rust、C…),套它同一組目錄與檔名規則。layout 見 _nodehome_in_stack_test_dir。"""
 22429	    global _TESTMAP_DIR_RE
 22430	    if _testmap_is_test(path):
 22431	        return True
 22432	    if _nodehome_in_stack_test_dir(path, layout):
 22433	        return True
 22434	    if _testmap_ext(path) in _TESTMAP_EXTS:
 22435	        return False                      # 測試地圖認得這種副檔名,它說不是就不是
 22436	    if _TESTMAP_DIR_RE is None:
 22437	        _TESTMAP_DIR_RE = re.compile(r"(^|/)(tests?|__tests__|specs?)/", re.IGNORECASE)
 22438	    if _TESTMAP_DIR_RE.search(path):
 22439	        return True
 22440	    name = path.rsplit("/", 1)[-1]
 22441	    stem = _testmap_stem(path)
 22442	    return (".spec." in name or ".test." in name or stem.startswith("test_")
 22443	            or stem.lower().endswith(("_tests", "_specs", "_test", "_spec")))   # 底線變體同測試地圖(Go 的 foo_test.go)
 22444	
