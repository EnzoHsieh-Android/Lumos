 22481	def _nodehome_list(repo_root, where):
 22482	    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
 22483	    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。"""
 22484	    if where is None:
 22485	        return {}, []
 22486	    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
 22487	        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
 22488	    if raw is None:
 22489	        return None
 22490	    files, allp = {}, []
 22491	    for ent in raw.split(b"\0"):
 22492	        if not ent or b"\t" not in ent:
 22493	            continue
 22494	        meta, p = ent.split(b"\t", 1)
 22495	        parts = meta.split()
 22496	        if where == "index":
 22497	            if len(parts) != 3 or parts[2] != b"0":      # 合併中的衝突階段不算
 22498	                continue
 22499	            mode = parts[0]
 22500	        else:
 22501	            if len(parts) != 3:
 22502	                continue
 22503	            mode = parts[0]
 22504	        path = nfc(os.fsdecode(p))
 22505	        allp.append(path)
 22506	        if mode in (b"100644", b"100755"):
 22507	            files[path] = mode.decode()
 22508	    return files, allp
 22509	
