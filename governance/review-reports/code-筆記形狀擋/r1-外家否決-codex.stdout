 22581	def _nodehome_side(repo_root, where, vault_rel, share=None, changed=None):
 22582	    """[S38] 建一邊的快照。share=另一邊已建好的快照、changed=兩邊之間有變動的路徑:沒變動的節點直接用 share 的解析結果
 22583	    (推送前的起點那一側只讀這段範圍裡有變動的節點——不然每一篇都要 git show 一次,65 篇就要 2 秒以上)。"""
 22584	    lst = _nodehome_list(repo_root, where)
 22585	    if lst is None:
 22586	        return None
 22587	    s = _NodehomeSide()
 22588	    s.files, s.all_paths = lst
 22589	    s.where = where
 22590	    s._reader = _nodehome_reader(repo_root, where)
 22591	    s.shebang = {}
 22592	    s.share = share
 22593	    s.changed = set(changed or ())
 22594	    s.notes = {}
 22595	    pre = vault_rel + "/Systems/"
 22596	    for p in s.files:
 22597	        if p.startswith(pre) and p.endswith(".md"):
 22598	            rel = p[len(vault_rel) + 1:]
 22599	            if share is not None and p not in s.changed and rel in share.notes:
 22600	                s.notes[rel] = share.notes[rel]
 22601	                continue
 22602	            raw = s._reader(p)
 22603	            if raw is not None:
 22604	                s.notes[rel] = _nodehome_parse_note(raw)
 22605	    return s
 22606	
