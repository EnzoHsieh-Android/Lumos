  2936	def parse_rule_fields(rest):
  2937	    """把 RULE: 行裡的 [key:value] 抓成 dict(重複出現取最後一個,跟鄰居一樣)。"""
  2938	    out = {}
  2939	    for k, rx in _RULE_FIELD_RES.items():
  2940	        ms = list(rx.finditer(rest))
  2941	        if ms:
  2942	            out[k] = ms[-1].group(1).strip()
  2943	    return out
  2944	
  2945	
  2946	def rule_field_truncated(rest):
  2947	    """值裡含右中括號(典型:退場條件引用 [[節點]])會被截斷,截掉的部分沒人看得到。
  2948	
  2949	    既有的 [test:]/[audit:] 家族也是同一種截斷,差別在那些欄位的值本來就是識別字;
  2950	    [retire:] 是散文,踩到的機會高很多,所以這裡主動唸出來而不是默默截掉。
  2951	    """
  2952	    bad = []
  2953	    for k, rx in _RULE_FIELD_RES.items():
  2954	        for m in rx.finditer(rest):
  2955	            if rest[m.end():m.end() + 1] == "]":
  2956	                bad.append(k)
  2957	    return sorted(set(bad))
  2958	
