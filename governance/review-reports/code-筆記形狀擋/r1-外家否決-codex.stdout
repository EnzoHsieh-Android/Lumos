 22523	def _nodehome_reader(repo_root, where):
 22524	    """回 read(path)->bytes|None。讀的是 where 那個版本:跟磁碟一樣的直接讀磁碟,不一樣的用 git show 讀
 22525	    ([S38]:提交前只讀提交索引——同一個工作目錄另一個會談寫到一半、還沒加進索引的東西讀不到)。"""
 22526	    if where is None:
 22527	        return lambda p: None
 22528	    disk_ok_all = False
 22529	    differ = None
 22530	    if where == "index":
 22531	        differ = _nodehome_changed_vs_disk(repo_root, "index")
 22532	    else:
 22533	        head = _lens_full_sha(repo_root, "HEAD")
 22534	        if head and head == where:
 22535	            differ = _nodehome_changed_vs_disk(repo_root, where)
 22536	    root = Path(repo_root)
 22537	    spec = "" if where == "index" else where
 22538	
 22539	    def read(p):
 22540	        if differ is not None and p not in differ:
 22541	            fp = root / p
 22542	            try:
 22543	                if fp.is_file() and not fp.is_symlink():
 22544	                    return fp.read_bytes()
 22545	            except OSError:
 22546	                pass
 22547	        r = _lens_git(repo_root, "show", f"{spec}:{p}", binary=True)
 22548	        if r is None or r.returncode != 0:
 22549	            return None
 22550	        return r.stdout
 22551	    return read
 22552	
