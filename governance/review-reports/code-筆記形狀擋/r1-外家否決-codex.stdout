 22737	def _nodehome_merge_own_changes(repo_root, sha, parents):
 22738	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 22739	
 22740	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 22741	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 22742	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 22743	    或順手多改的部分,正是這道檢查要看的。
 22744	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 22745	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 22746	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 22747	    """
 22748	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 22749	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22750	        return None
 22751	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 22752	                      "--name-status", "-z", "-M", sha)
 22753	    if r is None:
 22754	        return None
 22755	    paths, src, gone = _nodehome_name_status(r)
 22756	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 22757	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 22758	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 22759	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 22760	    for p in parents:
 22761	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22762	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22763	    order = sorted(paths)
 22764	    specs = []
 22765	    for x in order:
 22766	        specs.append(f"{sha}:{x}")
 22767	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 22768	    blobs = _nodehome_cat_blobs(repo_root, specs)
 22769	    if blobs is None or any(ren is None for _, ren in pairs):
 22770	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 22771	        return paths, src, gone
 22772	    kept = set()
 22773	    for n, x in enumerate(order):
 22774	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 22775	        if _nodehome_merge_wrote_new_lines(merged, olds):
 22776	            kept.add(x)
 22777	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 22778	
 22779	
 22780	def _nodehome_cat_blobs(repo_root, specs):
 22781	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 22782	
 22783	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 22784	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 22785	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 22786	    import subprocess as _sp
 22787	    if not specs:
 22788	        return []
 22789	    if any("\n" in s_ for s_ in specs):
 22790	        return None
 22791	    try:
 22792	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 22793	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 22794	                    capture_output=True, timeout=60)
 22795	    except (OSError, _sp.TimeoutExpired):
 22796	        return None
 22797	    if r.returncode != 0:
 22798	        return None
 22799	    out, pos, res = r.stdout, 0, []
 22800	    for _ in specs:
 22801	        nl = out.find(b"\n", pos)
 22802	        if nl < 0:
 22803	            return None
 22804	        head = out[pos:nl].split(b" ")
 22805	        pos = nl + 1
 22806	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 22807	            size = int(head[2])
 22808	            res.append(out[pos:pos + size])
 22809	            pos += size + 1
 22810	        elif len(head) == 3 and head[2].isdigit():
 22811	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 22812	            res.append(None)
 22813	        else:
 22814	            res.append(None)            # missing / ambiguous
 22815	    return res
 22816	
 22817	
 22818	def _nodehome_merge_wrote_new_lines(merged, olds):
 22819	    """合併提交裡,這支檔有沒有「兩個上一版都沒有的新行」。判不了一律當有(照舊查)。
 22820	
 22821	    ★為什麼 remerge-diff 列出來還不夠★(2026-09-25 rtb-production-agent-demo 回報,remerge-diff 修法之後又一次):
 22822	    只要有衝突,git 重做的自動合併裡就留著衝突標記,所以每一支解過衝突的檔都會被列成合併改的——
 22823	    就算解法只是把兩邊段落都留下。那時筆記被當成合併新寫的說明,跟同一個合併裡別的程式湊成一對誤擋。
 22824	    實際核對那三個合併:被判寫錯家的三篇筆記與一支程式,解衝突後多出的每一行都在某個上一版找得到。
 22825	    ★直接拿合併結果比兩個上一版,不再逐檔重做合併★(代碼審 r1 通才席量代價):git 自動合併只會產出
 22826	    來自兩邊的行(外加衝突標記),所以「解衝突時新寫的行」就是「合併結果裡兩個上一版都沒有的行」。
 22827	    逐檔重做合併的版本,200 支衝突檔多花 8.7 秒;內容一次批次讀完,見 _nodehome_cat_blobs。
 22828	    ★天花板★:比的是「整行有沒有出現在上一版的任何地方」,解衝突時只刪不加(挑一邊、刪一段)不算寫;
 22829	    新寫的行剛好跟上一版別處某一行一字不差也會漏算——這兩種偏向少擋。改名要靠 git 認得出來(每個上一版
 22830	    各自對合併結果偵測);內容改太多、git 認不出是改名時,那一邊的內容讀不到,會偏向多擋(照舊查)。"""
 22831	    new = _merge_new_lines(merged, olds)
 22832	    return True if new is None else bool(new)
 22833	
 22834	
 22835	def _merge_new_lines(merged, olds):
 22836	    """合併結果裡「每一個上一版都找不到」的那些行(去頭尾空白後的位元組集合);判不了回 None。
 22837	    從 _nodehome_merge_wrote_new_lines 拆出來(筆記形狀擋 [S5] 要的是哪幾行,不是有沒有);天花板見那支的說明。"""
 22838	    if merged is None or b"\0" in merged:
 22839	        return None
 22840	    seen = set()
 22841	    for blob in olds:
 22842	        if blob is not None:
 22843	            seen.update(ln.strip() for ln in blob.split(b"\n"))
 22844	    return {ln.strip() for ln in merged.split(b"\n") if ln.strip() and ln.strip() not in seen}
 22845	
 22846	
 22847	def _nodehome_commit_groups(repo_root, base, tip):
 22848	    """推送前:範圍裡每個提交各自改了哪些路徑(改名兩邊都算)。git 失敗回 None(退回整批一個提交)。
 22849	    每個提交回 {sha, parents, paths, src, gone}:src=這個提交裡改名的新路徑→舊路徑、gone=刪掉或改名掉的舊路徑。
 22850	    ★合併提交也要查★(代碼審 r3 單reviewer:原本整個排除,解衝突時在合併提交裡順手寫的說明、改的程式都沒人看):
 22851	    只算它自己多改的:兩邊合併用 git 的 remerge-diff(跟 git 自動合併會產生的結果比,兩邊都改過、git 自動合起來的
 22852	    不算);拿不到精確答案時(舊 git、專案設了自訂合併驅動器、三條以上的章魚合併)退回「跟每一個上一版都不一樣的
 22853	    路徑」——這個退路會把自動合起來的檔也算進來、可能誤擋。照搬某一邊進來的,那一邊的提交已經各自查過。"""
 22854	    raw = _nodehome_git(repo_root, "rev-list", "--reverse", "--parents", f"{base}..{tip}" if base else tip)
 22855	    if raw is None:
 22856	        return None
 22857	    out = []
 22858	    for line in raw.decode("ascii", errors="replace").splitlines():
 22859	        shas = line.split()
 22860	        if not shas:
 22861	            continue
 22862	        sha, parents = shas[0], shas[1:]
 22863	        if len(parents) <= 1:
 22864	            r = _nodehome_git(repo_root, "diff-tree", "--root", "--no-commit-id", "--name-status", "-z", "-M", "-r", sha)
 22865	            if r is None:
 22866	                return None
 22867	            paths, src, gone = _nodehome_name_status(r)
 22868	        else:
 22869	            # 章魚合併(三個以上上一版)git 不做 remerge-diff:只印一行警告、退出碼照樣 0,會被讀成「什麼都沒改」
 22870	            # 而放行夾帶的違規(代碼審 r1 通才席)——只有一般的兩邊合併走精確判法
 22871	            rm = _nodehome_merge_own_changes(repo_root, sha, parents) if len(parents) == 2 else None
 22872	            if rm is not None:
 22873	                paths, src, gone = rm
 22874	            else:
 22875	                # 退路(舊 git 沒有 remerge-diff、或專案設了自訂合併驅動器):跟每一個上一版都不一樣的路徑。
 22876	                # ★這個退路會把「兩邊都改過、git 自動合起來」的檔也算成合併自己改的★,可能誤擋——只在拿不到精確答案時用
 22877	                per = []
 22878	                for p in parents:
 22879	                    r = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22880	                    if r is None:
 22881	                        return None
 22882	                    per.append(_nodehome_name_status(r))
 22883	                paths = set.intersection(*(x[0] for x in per))
 22884	                src = {k: v for k, v in per[0][1].items() if k in paths}
 22885	                gone = set.intersection(*(x[2] for x in per))
 22886	        out.append({"sha": sha, "parents": parents, "paths": paths, "src": src, "gone": gone})
 22887	    return out
 22888	
