  2895	_CONTEXT_MARKER_RULES = {
  2896	    "WHY": (lambda s: bool(_CTX_SRC_RE.search(s)),
  2897	            "出處",
  2898	            "行內補一個日期、決策編號(#d3)、提交 sha 或 [[節點]],不然下一個人沒辦法查證這句話"),
  2899	    "PITFALL": (lambda s: bool(_CTX_REGRESS_RE.search(s)),
  2900	                "防回歸",
