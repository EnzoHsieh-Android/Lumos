 22374	def _nodehome_layout(all_paths):
 22375	    """測試資料夾錨定要看的版面:(頂層資料夾 → 裡面有哪些副檔名, 模組的 src → src/main 底下有哪些副檔名)。
 22376	    副檔名照測試地圖那一支取(小寫),這裡補上點號跟對照表的寫法對齊。"""
 22377	    tops = _nodehome_top_dirs(all_paths)
 22378	    top_exts, main_exts = {}, {}
 22379	    for p in all_paths:
 22380	        e = _testmap_ext(p)
 22381	        if not e:
 22382	            continue
 22383	        parts = p.split("/")
 22384	        if len(parts) > 1 and parts[0] in tops:
 22385	            top_exts.setdefault(parts[0], set()).add("." + e)
 22386	        for k in range(len(parts) - 2):
 22387	            if parts[k] == "src" and parts[k + 1] == "main":
 22388	                main_exts.setdefault("/".join(parts[:k + 1]), set()).add("." + e)
 22389	                break
 22390	    return top_exts, main_exts
