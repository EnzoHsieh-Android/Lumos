 48384	def t_note_shape_new_code_file_wakes_old_refs():
 48385	    """[S12] 範圍內有路徑變成程式檔(新增、加 #!),筆記裡指向它、沒釘版本、上線點版本還沒有的引用要擋;
 48386	    上線點版本就有的舊引用不擋。"""
 48387	    print("t_note_shape_new_code_file_wakes_old_refs")
 48388	    root = _ns_repo(golive=False)
 48389	    _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n")
 48390	    _ns_note(root, body="上線前寫的 `src/old.py:2`")
 48391	    _nh_commit(root, "old ref before golive")
 48392	    _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n# " + _NS_HOOK_LINE + "\n")
 48393	    _nh_commit(root, "golive")
 48394	    _ns_note(root, body="上線前寫的 `src/old.py:2`\n上線後先寫 `src/new.py:3`\n還有 `src/tool:2`")
 48395	    _nh_file(root, "src/tool", "echo not a script\n")
 48396	    _nh_commit(root, "ref first")
 48397	    base = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48398	    _nh_file(root, "src/new.py", "a = 1\nb = 2\nc = 3\n")
 48399	    _nh_file(root, "src/old.py", "a = 1\nb = 2\n")
 48400	    _nh_commit(root, "files later")
 48401	    tip = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48402	    rc, out = _ns(root, "--diff", f"{base}..{tip}")
 48403	    check("①新程式檔喚醒上線後寫的舊引用:擋", rc == 1 and "new.py:3" in out, out[-500:])
 48404	    check("②上線點版本就有的引用不擋", "old.py:2" not in out, out[-500:])
 48405	    _nh_file(root, "src/tool", "#!/bin/bash\necho 1\n")
 48406	    _nh_commit(root, "tool becomes script")
