 27950	def _lens_full_sha(repo_root, rev):
 27951	    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
 27952	    if r is None or r.returncode != 0:
 27953	        return None
 27954	    sha = r.stdout.strip()
 27955	    return sha if _LENS_SHA_RE.match(sha) else None
