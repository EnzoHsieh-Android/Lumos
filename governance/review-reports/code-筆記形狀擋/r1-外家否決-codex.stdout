 48345	def t_discipline_current_state_row_narrowed():
 48346	    """[S10] 紀律範本與 skill 不再教「以程式碼為準加查詢就能寫」,改成 d3 收窄說法與 [來源:…] 五類。"""
 48347	    print("t_discipline_current_state_row_narrowed")
 48348	    base = Path(GRAPHCTL).resolve().parent.parent
 48349	    tpl = (base / "scripts" / "templates" / "graph-discipline.md").read_text(encoding="utf-8")
 48350	    row = [l for l in tpl.splitlines() if l.startswith("| `FACT:`")]
 48351	    check("①範本 FACT/FLOW/DEP 那列有 [來源:", row and "[來源:" in row[0], str(row))
 48352	    check("②範本那列不再教標以程式碼為準加查詢", row and "附一條可重跑的查詢指令" not in row[0], str(row))
 48353	    for rel in ("skills/lumos-project-notes/reference.md", "skills/lumos-project-notes/commands/INDEX.md"):
 48354	        txt = (base / rel).read_text(encoding="utf-8")
 48355	        check(f"③{rel} 不再教「標以程式碼為準」寫現況", "要寫就標「以程式碼為準」加一條查詢指令" not in txt and "`[以程式碼為準] 門檻 180 秒" not in txt and "現況描述照〈寫筆記時〉標「以程式碼為準」" not in txt, rel)
 48356	        check(f"④{rel} 提到 [來源:", "[來源:" in txt, rel)
 48357	    for rel in ("CLAUDE.md", "AGENTS.md"):
 48358	        p = base / rel
 48359	        if p.is_file():
 48360	            check(f"⑤{rel} 注入的紀律區塊同步了", "[來源:" in p.read_text(encoding="utf-8"), rel)
