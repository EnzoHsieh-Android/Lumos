 23458	def _note_shape_config(text):
 23459	    """note_shape 設定(從被檢查的版本讀,照 _nodehome_config 的快照讀法):回 (mode, warnings)。
 23460	    mode ∈ block/warn/off;沒設或壞值=block。★鍵叫 mode 不叫 gate★ 的理由同 _nodehome_config。"""
 23461	    if text is None:
 23462	        return "block", []
 23463	    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
 23464	    try:
 23465	        data = json.loads(raw)
 23466	    except Exception as e:
 23467	        return "block", [f".lumos/config.json 讀不了({e.__class__.__name__}),筆記形狀擋照預設擋"]
 23468	    ns = data.get("note_shape") if isinstance(data, dict) else None
 23469	    if ns is None:
 23470	        return "block", []
 23471	    if not isinstance(ns, dict):
 23472	        return "block", ["設定檔的 note_shape 不是物件,筆記形狀擋照預設擋"]
 23473	    g = ns.get("gate", "block")
 23474	    if g not in _NOTE_SHAPE_GATE_VALUES:
 23475	        return "block", [f"設定檔的 note_shape.gate={g!r} 看不懂(只認 {'/'.join(_NOTE_SHAPE_GATE_VALUES)}),照預設擋"]
 23476	    return g, []
