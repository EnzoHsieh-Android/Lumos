   fi
 
   impact_once "$_range"
   pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
   _tier_high=0
   printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
   _SUITE_SEEN=1
   _suite_this="full"
   printf '%s' "$pf_json" | grep -q '"suite": *"docs"' && _suite_this="docs"
   printf '%s' "$pf_json" | grep -q '"suite_graph": *true' && _SUITE_GRAPH=1
