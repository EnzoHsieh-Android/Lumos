 47872	def t_runner_suite_flags():
 47873	    """執行器 --suite docs / --suite keys --keys:子集在分片之前挑(每片才不會空)、0 支 rc3(呼叫端決定退不退全套)、--list 0 支 rc0、旗標配對要對。"""
 47874	    import subprocess as _sp
 47875	    runner = str(Path(__file__).resolve())
 47876	    def run_r(*a):
 47877	        return _sp.run([sys.executable, runner, *a], capture_output=True, text=True)
 47878	    r = run_r("--list", "--suite", "docs")
