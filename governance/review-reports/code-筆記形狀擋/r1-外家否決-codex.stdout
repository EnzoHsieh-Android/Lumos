 23479	def _ns_regions(text):
 23480	    """筆記每一行落在哪一塊 → 清單(跟行一一對應):body / summary / decisions / other。
 23481	    decisions 裡鍵名是結構鍵(id、decided、valid…)的行算 other。用行範圍判,不靠解析欄位——縮排怎麼寫都認得到。"""
 23482	    lines = text.split("\n")
 23483	    out = ["body"] * len(lines)
 23484	    if not lines or lines[0].strip() != "---":
 23485	        return out
 23486	    out[0] = "other"
 23487	    cur = "other"
 23488	    for i in range(1, len(lines)):
 23489	        ln = lines[i]
 23490	        if ln.strip() == "---":
 23491	            out[i] = "other"
 23492	            return out
 23493	        m = _NS_TOPKEY_RE.match(ln)
 23494	        if m:
 23495	            k = m.group(1)
 23496	            cur = "summary" if k == "summary" else ("decisions" if k == "decisions" else "other")
 23497	            out[i] = "other"
 23498	            continue
 23499	        if cur == "decisions" and _NS_STRUCT_KEY_RE.match(ln):
 23500	            out[i] = "other"
 23501	        else:
 23502	            out[i] = cur
 23503	    return ["other"] * len(lines)        # frontmatter 沒關:整篇不判(lint 會擋)
 23504	
 23505	
 23506	def _ns_parse_added(raw):
 23507	    """git diff -U0 輸出 → {新路徑: [(新行號, 行文字)]}。"""
 23508	    out, path, n = {}, None, 0
 23509	    for ln in raw.decode("utf-8", errors="surrogateescape").split("\n"):
 23510	        if ln.startswith("+++ "):
 23511	            p = ln[4:]
 23512	            path = nfc(p[2:]) if p.startswith("b/") else None
 23513	            continue
 23514	        if ln.startswith("@@"):
 23515	            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", ln)
 23516	            n = int(m.group(1)) if m else 0
 23517	            continue
 23518	        if path is None or ln.startswith("---"):
 23519	            continue
 23520	        if ln.startswith("+"):
 23521	            out.setdefault(path, []).append((n, ln[1:]))
 23522	            n += 1
 23523	    return out
 23524	
 23525	
 23526	def _ns_diff(repo_root, *args):
 23527	    return _nodehome_git(repo_root, "diff", "-U0", "-M", "--no-color", "--no-ext-diff", "--no-textconv",
 23528	                         "--src-prefix=a/", "--dst-prefix=b/", *args)
