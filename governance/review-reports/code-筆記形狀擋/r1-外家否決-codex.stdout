 48023	# ── 筆記形狀擋(Projects/筆記形狀擋_計劃,2026-09-27)──────────────────────────────────────────
 48024	_NS_HOOK_LINE = 'lumos" note-shape --staged'
 48025	
 48026	
 48027	def _ns_repo(cfg=None, golive=True):
 48028	    """筆記形狀擋的測試專案:每支檔有家那個骨架 + 一支含上線標記的提交前掛鉤(當上線點)+ 一支程式檔。"""
 48029	    root = _nh_repo(cfg)
 48030	    _nh_file(root, "src/a.py", "\n".join(f"x{i} = {i}" for i in range(1, 21)) + "\n")
 48031	    _nh_file(root, "README.md", "# r\n")
 48032	    if golive:
 48033	        _nh_file(root, "scripts/hooks/pre-commit", "#!/bin/bash\n# " + _NS_HOOK_LINE + "\n")
 48034	    _nh_node(root, "A", about=["src/a.py"], body="實作在 `src/a.py`。")
 48035	    _nh_commit(root, "init")
 48036	    return root
 48037	
 48038	
 48039	def _ns(root, *args, env=None):
 48040	    import subprocess as sp, os as _os
 48041	    e = dict(_os.environ)
 48042	    e.pop("LUMOS_SKIP_NOTE_SHAPE", None)
 48043	    if env:
 48044	        e.update(env)
 48045	    r = sp.run([sys.executable, GRAPHCTL, "note-shape", *(args or ("--staged",)), "--repo", str(root)],
 48046	               capture_output=True, text=True, env=e)
 48047	    return r.returncode, r.stdout + r.stderr
 48048	
 48049	
 48050	def _ns_note(root, body="", summary="KEY:x", name="A", extra=""):
 48051	    return _nh_node(root, name, about=["src/a.py"] if name == "A" else (), body="實作在 `src/a.py`。\n" + body,
 48052	                    summary=summary, extra=extra)
 48053	
 48054	
 48055	def _ns_stage(root):
 48056	    _nh_git(root, "add", "-A")
 48057	
 48058	
 48059	def _ns_reset(root):
 48060	    _nh_git(root, "reset", "-q", "--hard", "HEAD")
 48061	    _nh_git(root, "clean", "-qfd")
 48062	
 48063	
 48064	def _ns_gov(root):
 48065	    import json as _j
 48066	    p = root / "docs" / ".governance-log.jsonl"
 48067	    if not p.is_file():
 48068	        return []
 48069	    return [_j.loads(l) for l in p.read_text(encoding="utf-8").splitlines() if l.strip()]
 48070	
 48071	
 48072	def t_note_shape_line_refs_existing_code_new_only():
 48073	    """[S1] 新增行裡指向真的存在的程式檔或測試檔的行號引用要擋(反引號、裸寫、#L、圍欄內、無副檔名 #! 主程式、
 48074	    唯一的單一檔名);指向不存在路徑或 .md 的不擋;沒改動的舊行不擋。"""
 48075	    print("t_note_shape_line_refs_existing_code_new_only")
 48076	    root = _ns_repo()
 48077	    _nh_file(root, "src/run", "#!/usr/bin/env python3\nprint(1)\nprint(2)\n")
 48078	    _ns_note(root, body="舊的引用 `src/a.py:3` 上線前就在。")
 48079	    _nh_commit(root, "old ref")
 48080	    cases = [
 48081	        ("反引號", "新寫 `src/a.py:5` 那一行", True),
 48082	        ("裸寫", "新寫 src/a.py:6 那一行", True),
 48083	        ("#L", "新寫 `src/a.py#L7` 那一行", True),
 48084	        ("無副檔名主程式", "新寫 `src/run:2`", True),
 48085	        ("唯一單一檔名", "新寫 a.py:4 這裡", True),
 48086	        ("圍欄內", "```\nTraceback src/a.py:8\n```", True),
 48087	        ("不存在的路徑", "舉例 `src/nope.py:4`", False),
 48088	        (".md 文件", "見 `README.md:1`", False),
 48089	    ]
 48090	    for label, add, want_block in cases:
 48091	        _ns_note(root, body="舊的引用 `src/a.py:3` 上線前就在。\n" + add)
 48092	        _ns_stage(root)
 48093	        rc, out = _ns(root)
 48094	        check(f"①{label}:{'擋' if want_block else '不擋'}", (rc == 1) == want_block, out[-500:])
 48095	        if want_block:
 48096	            check(f"②{label}:舊行 src/a.py:3 不列", "a.py:3" not in out.replace("a.py:3 ", "a.py:3 ") or out.count("`src/a.py:3`") == 0, out[-500:])
 48097	        _ns_reset(root)
 48098	
