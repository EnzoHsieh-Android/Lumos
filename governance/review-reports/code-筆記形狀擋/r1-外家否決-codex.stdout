 22608	def _nodehome_required(repo_root, side, cfg, vendored_skip):
 22609	    """[S1] 需要家的檔集合,另回檔名不是 UTF-8 的程式檔(永遠寫不進圖譜,只提醒改名或排除)。"""
 22610	    import fnmatch
 22611	    req, bad_names = set(), set()
 22612	    layout = _nodehome_layout(side.all_paths)   # 測試資料夾要旁邊的程式目標有同一種檔
 22613	    for p in side.files:
 22614	        kind = _nodehome_code_kind(p)
 22615	        if kind is None:
 22616	            continue
 22617	        if any(fnmatch.fnmatch(p, g) for g in _NODEHOME_EXCLUDE_GLOBS):
 22618	            continue
 22619	        if p in vendored_skip or _cochange_excluded(p, cfg["ignore"]) or _nodehome_is_test(p, layout):
 22620	            continue
 22621	        if kind == "shebang?":
 22622	            if p in side.shebang:
 22623	                ok = side.shebang[p]
 22624	            elif side.share is not None and p not in side.changed and p in side.share.shebang:
 22625	                ok = side.shebang[p] = side.share.shebang[p]
 22626	            else:
 22627	                head = side._reader(p)
 22628	                ok = side.shebang[p] = _head_is_shebang(head)
 22629	            if not ok:
 22630	                continue
 22730	                gone.add(nfc(toks[i + 1]))
 22731	            i += 2
 22732	        else:
 22733	            break
 22734	    return paths, src, gone - set(src)
