 48270	def t_note_shape_block_message_and_fail_open():
 48271	    """[S7] 擋下印檔、行、規則、改法與「內容還在工作目錄」;不改筆記與暫存區;只有擋下寫事件、放行不寫;
 48272	    不是 git 時放行並說一句。"""
 48273	    print("t_note_shape_block_message_and_fail_open")
 48274	    root = _ns_repo()
 48275	    _ns_note(root, body="新寫 `src/a.py:5`")
 48276	    _ns_stage(root)
 48277	    before = _nh_git(root, "diff", "--cached").stdout + _nh_git(root, "diff", "--", "docs/kg-knowledge").stdout
 48278	    rc, out = _ns(root)
 48279	    after = _nh_git(root, "diff", "--cached").stdout + _nh_git(root, "diff", "--", "docs/kg-knowledge").stdout
 48280	    check("①擋下訊息有檔、行號、規則、改法、內容還在", rc == 1 and all(x in out for x in ("A.md", "行號引用", "@", "內容還在工作目錄")), out[-600:])
 48281	    check("②不改筆記與暫存區", before == after, "")
 48282	    ev = [e for e in _ns_gov(root) if e.get("gate") == "note-shape"]
 48283	    check("③擋下寫一筆 blocked", any(e.get("kind") == "blocked" for e in ev), str(ev)[-300:])
 48284	    _ns_reset(root)
 48285	    n0 = len([e for e in _ns_gov(root) if e.get("gate") == "note-shape"])
 48286	    _ns_note(root, body="乾淨的一行")
 48287	    _ns_stage(root)
 48288	    rc, out = _ns(root)
 48289	    check("④放行 rc0 且不寫事件", rc == 0 and len([e for e in _ns_gov(root) if e.get("gate") == "note-shape"]) == n0, out[-300:])
 48290	    nogit = Path(tempfile.mkdtemp(prefix="gctl-ns-nogit-"))
 48291	    rc, out = _ns(nogit)
 48292	    check("⑤不是 git:放行並說一句", rc == 0 and out.strip(), out[-300:])
 48293	
