 27924	def _lens_range_ok(diff_range):
 27925	    """恰好一個 `..`、兩端非空、不含 `...`、不以 - 開頭(r3 極端輸入席收緊)。"""
 27926	    if not isinstance(diff_range, str) or diff_range.startswith("-") or "..." in diff_range:
 27927	        return None
 27928	    parts = diff_range.split("..")
 27929	    if len(parts) != 2 or not parts[0] or not parts[1]:
 27930	        return None
 27931	    if any(ch.isspace() for ch in diff_range):
 27932	        return None
 27933	    return parts[0], parts[1]
