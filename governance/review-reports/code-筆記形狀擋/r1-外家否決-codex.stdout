 47745	def t_lumos_content_diffs_all_disable_external_drivers():
 47746	    """[代碼審 r3 資安終審] 每一處「取差異內容」的版本控制呼叫都要關掉外部驅動器。
 47747	
 47748	    出身:被打開的資料夾可以放一份★未提交、未追蹤★的屬性檔,把某支檔指到一個
 47749	    ★攻擊者自己命名★的差異驅動器,再用那個名字設定要執行的指令。
 47750	    ★鍵名是他取的,所以列舉清單原理上擋不住★——這條打破的不是某個實作細節,
 47751	    是「列舉危險設定」這個形狀本身。三輪三種修法都被打穿:
 47752	      逐點加參數 → 漏呼叫點;注入環境變數 → 漏設定項;列舉清單 → 鍵名由攻擊者決定。
 47753	
 47754	    正解是關掉整類機制:那兩個旗標不管設定裡寫什麼名字都生效(實測驗過)。
 47755	
 47756	    ★範圍靠實測畫的★:只取檔名/統計/狀態的呼叫不觸發(實測),所以不強制它們帶旗標;
 47757	    取內容的才要。這支測試釘的是★性質★不是行號——新增一處取內容卻沒帶旗標的,它會自己翻紅。
 47758	
 47759	    翻紅釘:任一處取內容的呼叫拿掉旗標 → 這條翻紅。"""
 47760	    import re as _re
 47761	    src = Path(GRAPHCTL).read_text(encoding="utf-8")
 47762	    lines = src.split("\n")
 47763	    safe_shape = ("--name-only", "--numstat", "--name-status", "--shortstat", "--stat")
 47764	    guard = "--no-ext-diff"
 47765	    bad = []
 47766	    for i, l in enumerate(lines):
 47767	        if '"diff"' not in l and "diff --" not in l:
 47768	            continue
