 48100	def t_note_shape_pinned_ref_requires_real_sha_and_line():
 48101	    """[S2] 釘版本只有「至少 12 位、解析結果以它開頭、在分支歷史上、那個提交有該路徑、行號在檔長內」才放行;
 48102	    HEAD、分支名(含全十六進位命名的分支)、找不到的編號、捏造的不可達提交、行號超長都擋;refcheck 對合法釘版本判對得上。"""
 48103	    print("t_note_shape_pinned_ref_requires_real_sha_and_line")
 48104	    root = _ns_repo()
 48105	    sha = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48106	    _nh_git(root, "branch", "deadbeefcafe")
 48107	    import subprocess as sp
 48108	    # 用 HEAD 的樹捏一個從沒進過任何分支的提交:裡面有 src/a.py,只查「物件存在」會放過它(r3 正確性席實測的繞法)
 48109	    fake = sp.run(["git", "-C", str(root), "commit-tree", "HEAD^{tree}", "-m", "fake"], capture_output=True, text=True).stdout.strip()
 48110	    cases = [
 48111	        ("合法釘版本", f"`src/a.py@{sha[:12]}:5`", False),
 48112	        ("完整編號", f"`src/a.py@{sha}:5`", False),
 48113	        ("HEAD", "`src/a.py@HEAD:5`", True),
 48114	        ("分支名", "`src/a.py@main:5`", True),
 48115	        ("全十六進位分支名", "`src/a.py@deadbeefcafe:5`", True),
 48116	        ("太短", f"`src/a.py@{sha[:8]}:5`", True),
 48117	        ("找不到的編號", "`src/a.py@0123456789abcdef:5`", True),
 48118	        ("捏造的不可達提交", f"`src/a.py@{fake}:5`", True),
 48119	        ("行號超長", f"`src/a.py@{sha[:12]}:999`", True),
 48120	    ]
 48121	    for label, add, want_block in cases:
 48122	        _ns_note(root, body=add)
 48123	        _ns_stage(root)
 48124	        rc, out = _ns(root)
 48125	        check(f"①{label}:{'擋' if want_block else '放行'}", (rc == 1) == want_block, out[-500:])
 48126	        _ns_reset(root)
 48127	    note = root / "docs" / "kg-knowledge" / "Systems" / "P.md"
 48128	    note.write_text(f"---\ntype: system\n---\n# P\n見 `src/a.py@{sha[:12]}:5`\n", encoding="utf-8")
 48129	    r = sp.run([sys.executable, GRAPHCTL, "refcheck", str(note), "--repo", str(root), "--json"], capture_output=True, text=True)
 48130	    check("②refcheck 對合法釘版本判對得上(不再當成一支叫 path@sha 的檔)", '"missing": 0' in r.stdout.replace(" ", " ") or '"missing":0' in r.stdout.replace(" ", ""), r.stdout[-400:])
 48131	
 48132	
 48133	def t_note_shape_current_state_prefix_requires_source():
 48134	    """[S3] summary 新增的 FACT/FLOW/DEP 要帶五種 [來源:…] 之一;只寫以程式碼為準加查詢也擋;正文的同形狀行不歸這條;
 48135	    FACT 行 lint 給同樣判定、FLOW/DEP lint 維持現行;帶 regen 的筆記寫 [來源:部署] 不被重建守衛當成路徑。"""
 48136	    print("t_note_shape_current_state_prefix_requires_source")
 48137	    root = _ns_repo()
 48138	    cases = [
 48139	        ("FACT 沒來源", "KEY:x\nFACT:門檻 180 秒", True),
 48140	        ("FLOW 沒來源", "KEY:x\nFLOW:a 到 b", True),
 48141	        ("DEP 沒來源", "KEY:x\nDEP:要先有 X", True),
 48142	        ("只寫以程式碼為準", "KEY:x\nFACT:[以程式碼為準]門檻 180 秒;查:`grep -n X y`", True),
 48143	        ("帶來源", "KEY:x\nFACT:東京機房 [來源:部署]", False),
 48144	        ("人工來源", "KEY:x\nDEP:要法務點頭 [來源:人工]", False),
 48145	    ]
 48146	    for label, summ, want_block in cases:
 48147	        _ns_note(root, summary=summ)
 48148	        _ns_stage(root)
 48149	        rc, out = _ns(root)
 48150	        check(f"①{label}:{'擋' if want_block else '放行'}", (rc == 1) == want_block, out[-500:])
 48151	        _ns_reset(root)
 48152	    _ns_note(root, body="FACT:正文裡長得像摘要行")
 48153	    _ns_stage(root)
 48154	    rc, out = _ns(root)
 48155	    check("②正文裡的同形狀行不歸這條", rc == 0, out[-500:])
 48156	    _ns_reset(root)
 48157	    v = mkvault()
 48158	    write(v, "Systems/F.md", "type: system\nstatus: doing\nsummary: |-\n  FACT:門檻 180 秒\n  FLOW:a→b\n", body="# F\n")
 48159	    r = run(v, "lint", "Systems/F")
 48160	    check("③lint:FACT 沒來源要唸來源", "FACT:" in r.stdout and "來源" in r.stdout, r.stdout)
 48161	    check("④lint:FLOW 維持現行(不新增警告)", "FLOW:" not in r.stdout.split("脈絡標記")[-1] if "脈絡標記" in r.stdout else True, r.stdout)
 48162	    write(v, "Systems/G.md", "type: system\nstatus: doing\nsummary: |-\n  FACT:東京機房 [來源:部署]\n", body="# G\n")
 48163	    r = run(v, "lint", "Systems/G")
 48164	    check("⑤lint:FACT 帶來源不唸", "脈絡標記" not in r.stdout, r.stdout)
 48165	    write(v, "Systems/R.md", "type: system\nstatus: doing\nregen: from-scratch/2026-09-27\nsummary: |-\n  FACT:東京機房 [來源:部署]\n", body="# R\n")
 48166	    r = run(v, "lint", "Systems/R")
 48167	    check("⑥帶 regen 的筆記寫 [來源:部署] 不被當成檔案路徑", "部署" not in r.stdout or "幻覺" not in r.stdout, r.stdout)
