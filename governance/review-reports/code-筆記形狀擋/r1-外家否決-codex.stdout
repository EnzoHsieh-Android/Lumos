 22737	def _nodehome_merge_own_changes(repo_root, sha, parents):
 22738	    """合併提交「自己」真正多改的路徑:跟 git 自動合併會產生的結果比(remerge-diff),不是跟兩邊各比。拿不到回 None。
 22739	
 22740	    ★為什麼不能用「跟每一個上一版都不一樣」★(2026-09-24 rtb-production-agent-demo 回報,第三次發生):
 22741	    兩條分支都改過、git 自動合起來的檔,合併後也跟兩邊都不一樣,會被當成合併自己寫的——另一邊配好家的筆記
 22742	    就被拿去跟這邊的程式湊成一對,判成「寫了說明卻不是改動檔的家」。remerge-diff 只列出合併時手動解衝突
 22743	    或順手多改的部分,正是這道檢查要看的。
 22744	    ★先確認沒有自訂合併驅動器★:remerge-diff 會在記憶體裡重做一次合併,專案的 git 設定若註冊了自訂合併驅動器,
 22745	    就會執行那個指令——跟本檔對差異驅動器的防範同一類(被打開的資料夾可以自帶設定)。有就不用、退回舊判法。
 22746	    git 2.36 以前沒有 remerge-diff,也回 None 退回舊判法。
 22747	    """
 22748	    drv = _lens_git(repo_root, "config", "--get-regexp", r"^merge\..*\.driver$", binary=True)
 22749	    if drv is None or drv.returncode != 1:     # 0=有自訂驅動器;其他=判不了。兩種都不冒險
 22750	        return None
 22751	    r = _nodehome_git(repo_root, "show", "--remerge-diff", "--no-ext-diff", "--no-textconv", "--format=",
 22752	                      "--name-status", "-z", "-M", sha)
 22753	    if r is None:
 22754	        return None
 22755	    paths, src, gone = _nodehome_name_status(r)
 22756	    # ★每個上一版各自偵測改名★(代碼審 r1 通才席、架構對齊席各自實測):一邊改名、一邊改內容的合併,
 22757	    # remerge-diff 只給新檔名、不標改名;共用一個舊路徑的話,沒改名那一邊用新檔名找不到,它的內容整個漏掉,
 22758	    # 從那一邊搬來的行就被判成合併新寫的。讀不到改名對照就當判不了(照舊查)。
 22759	    pairs = []      # (上一版, 它對合併結果的改名對照 新→舊);讀不到對照是 None
 22760	    for p in parents:
 22761	        rr = _nodehome_git(repo_root, "diff-tree", "--no-commit-id", "--name-status", "-z", "-M", "-r", p, sha)
 22762	        pairs.append((p, None if rr is None else _nodehome_name_status(rr)[1]))
 22763	    order = sorted(paths)
 22764	    specs = []
 22765	    for x in order:
 22766	        specs.append(f"{sha}:{x}")
 22767	        specs += [f"{p}:{x if ren is None else ren.get(x, x)}" for p, ren in pairs]
 22768	    blobs = _nodehome_cat_blobs(repo_root, specs)
 22769	    if blobs is None or any(ren is None for _, ren in pairs):
 22770	        # 任一個上一版的改名對照讀不到、或批次讀取失敗:整個合併照舊查(不是逐檔判)
 22771	        return paths, src, gone
 22772	    kept = set()
 22773	    for n, x in enumerate(order):
 22774	        merged, *olds = blobs[n * (1 + len(parents)):(n + 1) * (1 + len(parents))]
 22775	        if _nodehome_merge_wrote_new_lines(merged, olds):
 22776	            kept.add(x)
 22777	    return kept, {k: v for k, v in src.items() if k in kept}, gone
 22778	
