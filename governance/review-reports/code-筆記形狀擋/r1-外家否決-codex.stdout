 48201	def t_note_lines_merge_commit_new_lines_only():
 48202	    """[S5] 提交前正在合併要跳過;推送前合併提交只查合併結果裡每個上一版都沒有的行;已在遠端追蹤分支上的提交不重查。"""
 48203	    print("t_note_lines_merge_commit_new_lines_only")
 48204	    root = _ns_repo()
 48205	    m0 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48206	    _nh_git(root, "checkout", "-qb", "side")
 48207	    _ns_note(root, body="side 帶進來的 `src/a.py:4`")
 48208	    _nh_commit(root, "side")
 48209	    s1 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48210	    _nh_git(root, "checkout", "-q", "master") if _nh_git(root, "rev-parse", "-q", "--verify", "master").returncode == 0 else _nh_git(root, "checkout", "-q", "main")
 48211	    _nh_file(root, "src/other.py", "y = 1\n")
 48212	    _nh_commit(root, "main side work")
 48213	    _nh_git(root, "merge", "-q", "--no-edit", "--no-ff", "side")
 48214	    m2 = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48215	    rc, out = _ns(root, "--diff", f"{s1}..{m2}")
 48216	    check("①合併只把上一版帶進來的行接起來:不擋", rc == 0, out[-500:])
 48217	    note = root / "docs" / "kg-knowledge" / "Systems" / "A.md"
 48218	    note.write_text(note.read_text(encoding="utf-8") + "合併時新寫 `src/a.py:7`\n", encoding="utf-8")
 48219	    _nh_git(root, "add", "-A")
 48220	    _nh_git(root, "commit", "-q", "--amend", "--no-edit", "--no-verify")
 48221	    m2b = _nh_git(root, "rev-parse", "HEAD").stdout.strip()
 48222	    rc, out = _ns(root, "--diff", f"{s1}..{m2b}")
 48223	    check("②合併時新寫的行照擋", rc == 1 and "a.py:7" in out and "a.py:4" not in out, out[-500:])
 48224	    import subprocess as sp
 48225	    bare = Path(tempfile.mkdtemp(prefix="gctl-ns-remote-")) / "r.git"
 48226	    sp.run(["git", "init", "-q", "--bare", str(bare)], capture_output=True)
 48227	    _nh_git(root, "remote", "add", "origin", str(bare))
 48228	    _nh_git(root, "push", "-q", "--no-verify", "origin", "side")
 48229	    _nh_git(root, "fetch", "-q", "origin")
 48230	    rc, out = _ns(root, "--diff", f"{m0}..{m2}")
 48231	    check("③已在遠端追蹤分支上的提交(side)不重查", rc == 0, out[-500:])
 48232	    _nh_git(root, "checkout", "-q", "side")
 48233	    _nh_git(root, "checkout", "-q", "-b", "tmp", m0)
 48234	    _nh_git(root, "merge", "-q", "--no-commit", "--no-ff", "side")
 48235	    rc, out = _ns(root)
 48236	    check("④提交前正在合併:跳過並說一句", rc == 0 and "合併" in out, out[-300:])
 48237	
