             continue
-        if m.group(1) == "RULE":
+        if m.group(1) == "RULE" and rules is None:
             out.extend(rule_lifecycle_warnings(line[len("RULE:"):]))
             continue
-        rule = _CONTEXT_MARKER_RULES.get(m.group(1))
+        rule = (rules if rules is not None else _CONTEXT_MARKER_RULES).get(m.group(1))
         if not rule:
