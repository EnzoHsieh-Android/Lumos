 19933	def _refcheck_scan(text, repo_root):
 19934	    """refcheck 抽取+核對核心(不列印):回 (claims, n_missing, n_oor, n_ok)。
 19935	    cmd_refcheck 與 loop status --gate(G1 錨)共用;抽取規則見 cmd_refcheck docstring。
 19936	    核對段走 _validate_repo_ref(與 Check J 共用);抽取段(inline-code+top_dirs 過濾)維持原規則。"""
 19937	    top_dirs = {p.name for p in repo_root.iterdir() if p.is_dir() and not p.name.startswith(".")}
 19938	    pins = []
 19939	    full, _bare = _node_code_ref_tokens(text, top_dirs, pins=pins)
 19940	    claims = []
 19941	    # 釘版本 `路徑@<提交>:行號` 對那個提交驗(筆記形狀擋 [S2]):不這樣做,它會被當成一支叫「路徑@提交」、
 19942	    # 或行號對不上目前版本的檔,設計審放行前的引用檢查就把合法寫法判成幻覺證據
 19943	    pinned = {(p_, l_) for p_, l_, _s in pins}
 19944	    for token, line, pin in pins:
 19945	        sha = _pin_commit(repo_root, pin)
 19946	        status, excerpt = _validate_repo_ref(repo_root, token, line, at_sha=sha) if sha else ("missing", "")
 19947	        claims.append({"token": f"{token}@{pin}", "line": line, "status": status, "excerpt": excerpt})
 19948	    for token, line in full:
 19949	        if (token, line) in pinned:
 19950	            continue
 19951	        status, excerpt = _validate_repo_ref(repo_root, token, line)
 19952	        claim = {"token": token, "line": line, "status": status, "excerpt": excerpt}
 19953	        if status == "ok" and (repo_root / token).is_dir():
 19954	            claim["dir"] = True
 19955	        claims.append(claim)
 19956	
 19957	    n_missing = sum(1 for c in claims if c["status"] == "missing")
 19958	    n_oor = sum(1 for c in claims if c["status"] == "line_out_of_range")
 19959	    n_ok = sum(1 for c in claims if c["status"] == "ok")
 19960	    return claims, n_missing, n_oor, n_ok
 19961	
