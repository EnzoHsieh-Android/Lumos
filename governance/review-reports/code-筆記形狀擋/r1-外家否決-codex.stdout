 23581	def _ns_is_code(path, reader, files):
 23582	    """這個路徑在被檢查的版本裡是不是程式檔或測試檔(副檔名清單或開頭 #!;測試也算;只收一般檔)。"""
 23583	    if path not in files:
 23584	        return False
 23585	    kind = _nodehome_code_kind(path)
 23586	    if kind == "ext":
 23587	        return True
 23588	    if kind != "shebang?":
 23589	        return False
 23590	    b = reader(path)
 23591	    return b is not None and _head_is_shebang(b[:200])
 23592	
