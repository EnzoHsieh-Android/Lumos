 22464	def _nodehome_git(repo_root, *args):
 22465	    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
 22466	    r = _lens_git(repo_root, *args, binary=True)
 22467	    if r is None or r.returncode != 0:
 22468	        return None
 22469	    return r.stdout
 22470	
