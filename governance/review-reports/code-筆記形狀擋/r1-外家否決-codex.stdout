  2921	#   [status:active|superseded] 預設 active  [applies:<版本或範圍>](選填)
  2922	# 只有 since 與 retire 都寫齊、且不是 superseded 的 RULE 行,才有挑戰程式碼的效力(見紀律範本第 3 條)。
  2923	# 一欄位一個正則,形狀跟鄰居 TEST_REF_RE / AUDIT_REF_RE / ROLLBACK_REF_RE 一致
  2924	# (2026-09-21 架構對齊席:原本寫成一條合併正則+dict,是這支檔裡的第二種做法)
  2925	SINCE_REF_RE = re.compile(r"\[since:\s*([^\]]*)\]")
  2926	UNTIL_REF_RE = re.compile(r"\[until:\s*([^\]]*)\]")
  2927	CONFIRMED_REF_RE = re.compile(r"\[confirmed:\s*([^\]]*)\]")
  2928	STATUS_REF_RE = re.compile(r"\[status:\s*([^\]]*)\]")
  2929	RETIRE_REF_RE = re.compile(r"\[retire:\s*([^\]]*)\]")
  2930	APPLIES_REF_RE = re.compile(r"\[applies:\s*([^\]]*)\]")
  2931	_RULE_FIELD_RES = {"since": SINCE_REF_RE, "until": UNTIL_REF_RE, "confirmed": CONFIRMED_REF_RE,
  2932	                   "status": STATUS_REF_RE, "retire": RETIRE_REF_RE, "applies": APPLIES_REF_RE}
  2933	_RULE_CONFIRM_STALE_DAYS = 180
