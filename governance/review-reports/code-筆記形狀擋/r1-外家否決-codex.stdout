 23650	def _note_shape_eval(repo_root, staged, base_where, tip_where, vault_rel, exclude_remote=True, mark=None):
 23651	    """算這次的違規 → (violations[(筆記路徑, 行號, 規則, 片段, 改法)], errors[訊息])。"""
 23652	    reader = _nodehome_reader(repo_root, tip_where)
 23653	    lst = _nodehome_list(repo_root, tip_where)
 23654	    if lst is None:
 23655	        return None
 23656	    files = lst[0]
 23657	    top_dirs = {p.split("/", 1)[0] for p in files if "/" in p}
 23658	    by_name = {}
 23659	    for p in files:
 23660	        if _nodehome_code_kind(p) is not None:
 23661	            by_name.setdefault(p.rsplit("/", 1)[-1], []).append(p)
 23662	    viol, errs = [], []
 23663	    # 1) 這次新增的行
 23664	    if staged:
 23665	        d = _ns_diff(repo_root, "--cached", "--", vault_rel)
 23666	        if d is None:
 23667	            return None
 23668	        added = {p: rows for p, rows in _ns_parse_added(d).items() if p.endswith(".md")}
 23669	        cand = {p: {n for n, _t in rows} for p, rows in added.items()}
