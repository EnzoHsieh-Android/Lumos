 48363	def t_doctor_note_shape_ci_and_bypass_scan():
 48364	    """[S11] doctor:CI 沒呼叫 note-shape --diff 或沒抓完整歷史時印一行;列出上線點之後已推上遠端卻違反規則的新增行。"""
 48365	    print("t_doctor_note_shape_ci_and_bypass_scan")
 48366	    import subprocess as sp
 48367	    root = _ns_repo()
 48368	    (root / ".github" / "workflows").mkdir(parents=True)
 48369	    (root / ".github" / "workflows" / "ci.yml").write_text("jobs:\n  t:\n    steps:\n      - uses: actions/checkout@v4\n", encoding="utf-8")
 48370	    _ns_note(root, body="繞過推上去的 `src/a.py:5`")
 48371	    _nh_commit(root, "bypass")
 48372	    bare = Path(tempfile.mkdtemp(prefix="gctl-ns-doc-")) / "r.git"
 48373	    sp.run(["git", "init", "-q", "--bare", str(bare)], capture_output=True)
 48374	    _nh_git(root, "remote", "add", "origin", str(bare))
 48375	    br = _nh_git(root, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
 48376	    _nh_git(root, "push", "-q", "--no-verify", "origin", br)
 48377	    _nh_git(root, "fetch", "-q", "origin")
 48378	    d = sp.run([sys.executable, GRAPHCTL, "doctor"], cwd=str(root), capture_output=True, text=True)
 48379	    out = d.stdout + d.stderr
 48380	    check("①CI 沒呼叫 note-shape:印一行", "note-shape --diff" in out, out[-800:])
 48381	    check("②列出上線點之後已推上遠端的違規行", "a.py:5" in out, out[-800:])
