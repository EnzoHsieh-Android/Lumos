  2887	_CTX_REGRESS_RE = re.compile(r"\[test:|重現|repro", re.I)
  2888	_CTX_QUERY_RE = re.compile(r"`[^`]{6,}`")          # 一條可重跑的查詢指令(反引號包起來)
  2889	# 出處 = 日期 / 決策編號 / [[節點]] / 既有的 [src:] 標記 / 真的像 sha 的字串
  2890	# (★不收純數字★:2026-09-21 通才席 F5——原本 [0-9a-f]{7,40} 讓任意 7 位數字都算出處)
  2891	_CTX_SRC_RE = re.compile(r"20\d\d-\d\d-\d\d|#d\d+|\[\[|\[src:|\bd\d+\b"
  2892	                         r"|\b(?=[0-9a-f]{7,40}\b)[0-9a-f]*[a-f][0-9a-f]*\b")
