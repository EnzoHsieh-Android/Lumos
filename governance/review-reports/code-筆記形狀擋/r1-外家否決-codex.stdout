 22948	def _nodehome_evaluate(repo_root, B, N, changes, cfg, vendored_skip, vault_rel, groups=None):
 22949	    """規則一到四的判定。回 dict:blocks=[(類別, 項目)]、reminders=[(類別, 項目)]、pairs=[(檔, 節點)]。
 22950	    B=之前、N=之後;changes=_nodehome_changes 的結果。groups=範圍裡每個提交各自改了哪些路徑(推送前用;
 22951	    規則三只看「同一個提交裡也改了程式」的節點——純整理節點的提交跟改程式的提交一起推,不會被混在一起誤擋)。
 22952	    None=整批當成一個提交(提交前)。"""
 22953	    reqN, bad_names = _nodehome_required(repo_root, N, cfg, vendored_skip)
 22954	    reqB, _ = _nodehome_required(repo_root, B, cfg, vendored_skip)
 22955	    homesN, ownN = _nodehome_homes(repo_root, N)
