   180	LIST_ITEM_RE = re.compile(r"^\s+-\s+(.*)$")
   181	QUOTED_DATE_RE = re.compile(
   182	    r'^\s*(?:-\s+)?(?:date|created|updated|decided|ended):\s*"\d{4}-\d{2}-\d{2}"')
   183	RULE3_RE = re.compile(r"^\s+-\s+\w+: [^\"'|>\s][^\"']*: \S")  # 未引號值含 ": "
   184	
   185	
   186	def nfc(s):
   187	    return unicodedata.normalize("NFC", s)
   188	
   189	
   190	def strip_quotes(s):
   191	    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
   192	        return s[1:-1]
   193	    return s
   194	
   195	
   196	def _posix_norm(s):
   197	    """路徑比對鍵的共用正規化:反斜線轉斜線、去 ./ 與 a/../b(純字面,不查檔案);空的回空字串。
   198	    工具自裝檔判別、about_code 的比對、排序加分讀 about_code 共用這一個(2026-09-10 代碼審 r3 架構席/整合席:
   199	    原本三處各寫一份,排序那側只剝開頭的 ./,不解 ..)。"""
   200	    import posixpath
   201	    v = str(s).strip().replace("\\", "/")
   202	    return posixpath.normpath(v) if v else ""
   203	
   204	
   205	_SINGLE_WIKILINK_RE = re.compile(r"\[\[([^\[\]]+?)\]\]")   # 整個值恰好是一個連結(fullmatch 用;讀側索引與寫側判斷共用)
   206	
   207	
   208	def _multi_link_value(s):
   209	    """清單欄位的一個值裡有兩個以上連結開頭——一項只能是一個連結或一個值。
   210	    讀的一側(parse_frontmatter 的 lint)與寫的一側(_list_scalar_value)共用這一個判斷(2026-09-10 代碼審 r3 架構席:
   211	    原本讀側只認 `]], [[` 與 `]],[[`,寫側看兩個以上 [[,`[[A]],  [[B]]` 讀側不吭聲、寫側卻擋)。
   212	    只用在清單欄位:散文欄位(例如 valid_under)講到兩個連結是正常的。"""
   213	    return str(s).count("[[") > 1
   214	
   215	
   216	def link_target(s):
   217	    """從 wikilink 字串/list 項抽**完整 target**(去 [[]]、alias、heading、引號;**保留路徑**)。
   218	    `[[Verification/X|y]]` → `Verification/X`。寫側 dedup 用它做精確比對:
   219	    既修子字串誤判(A vs A_v2 不同),又不像 basename-only 把跨資料夾 Systems/X vs
   220	    Verification/X 誤判相同(2026-06-13 第二輪審計 NEW-A)。"""
   221	    t = strip_quotes(str(s).strip())
   222	    t = t.replace("[[", "").replace("]]", "")
   223	    t = t.split("|")[0].split("#")[0].strip()
   224	    if t.lower().endswith(".md"):
   225	        t = t[:-3]
   226	    return nfc(t)
   227	
   228	
   229	def split_frontmatter(text):
   230	    """回傳 (fm_lines or None, body)"""
   231	    if not text.startswith("---"):
   232	        return None, text
   233	    lines = text.split("\n")
   234	    for i in range(1, len(lines)):
   235	        if lines[i].strip() == "---":
   236	            return lines[1:i], "\n".join(lines[i + 1:])
   237	    return None, text
   238	
   239	
   240	def parse_frontmatter(fm_lines):
   241	    """極簡 parser(本 vault 慣例範圍): top-level 純量 + 字串 list + block scalar 內文。
   242	    回傳 (fields, block_keys, lint)
   243	      fields: dict[key] = str | list[str];block scalar 的 key 也存內文(供 context 用)
   244	      block_keys: block scalar 的 key 集合(其值內的 [[..]] 不得索引,鐵則 2)
   245	      lint: 鐵則指紋發現
   246	    """
   247	    fields, block_keys, lint = {}, set(), []
   248	    seen = set()
   249	    i, n = 0, len(fm_lines)
   250	    while i < n:
   251	        line = fm_lines[i]
   252	        m = TOP_KEY_RE.match(line)
   253	        if not m:
   254	            i += 1
   255	            continue
   256	        key, val = m.group(1), m.group(2).strip()
   257	        if key in seen:
   258	            lint.append(f"同一層欄位名重複,工具不知道該信哪個: {key}")
   259	        seen.add(key)
   260	        if val in ("|", "|-", ">", ">-"):
   261	            block = []
   262	            i += 1
   263	            while i < n and (fm_lines[i].startswith("  ") or not fm_lines[i].strip()):
   264	                if fm_lines[i].strip():
   265	                    block.append(fm_lines[i].strip())
   266	                i += 1
   267	            fields[key] = "\n".join(block)
   268	            block_keys.add(key)
   269	            continue
   270	        if val == "":
   271	            items = []
   272	            i += 1
   273	            while i < n:
   274	                l2 = fm_lines[i]
   275	                if not l2.strip():
   276	                    i += 1
   277	                    continue
   278	                if not l2.startswith(" "):
   279	                    break
   280	                ms = LIST_ITEM_RE.match(l2)
   281	                if ms:
   282	                    item = strip_quotes(ms.group(1).strip())
   283	                    items.append(item)
   284	                    if "]], [[" in item or "]],[[" in item or (key in LIST_KEYS and _multi_link_value(item)):
   285	                        lint.append(f"一個欄位塞了多個連結卻寫成一串字,會被當成一個不存在的 ghost 筆記,要拆成一行一項: {key} 項")
   286	                if RULE3_RE.match(l2):
   287	                    lint.append(f"欄位值裡有「冒號+空白」又沒加引號,讀出來會被切斷,整個值請用引號包起來: {l2.strip()[:60]}")
   288	                i += 1
   289	            fields[key] = items
   290	            continue
