  3040	def _search_region(lineno, line, fm_end):
 47700	
 47701	    出身:同一類問題冒出三次——
 47702	      r1 資安席報第一項 → 修法只補了自己新增的兩個呼叫點
 47703	      r2 驗收席抓到漏補第三處(會去呼叫主程式那條)→ 改成注入環境變數
 47704	      r2 資安複審又找到第二項設定 → ★而當時的註解已經寫了「涵蓋得到(實測驗過)」★
 47705	    那句話只對當時驗過的那一項成立。所以這支測試★逐項★跑,清單加一項就自動多驗一項,
 47706	    不會再出現「宣稱涵蓋、實際只驗了一項」。
 47707	
 47708	    ★這支測試證明的是「清單上的擋得住」,不是「所有設定都擋得住」★——
 47709	    清單是列舉法,測試也只能釘住列舉到的部分。
 47710	
 47711	    翻紅釘:清單裡拿掉任何一項 → 那一項的斷言翻紅。"""
 47712	    import json as _j, os as _os, subprocess as _sp
 47713	    _cgs()
 47714	    m = _load_hook_mod("cgs_unsafe", "check-graph-sync.py")
 47715	    keys = list(getattr(m, "_GIT_UNSAFE_CONFIG", ()))
 47716	    check("★前置★ 清單不是空的(空的話下面一條都不會跑,等於假綠)", len(keys) >= 2, str(keys))
 47717	    hook = Path(GRAPHCTL).resolve().parent / "hooks" / "claude" / "check-graph-sync.py"
 47718	    for key in keys:
 47719	        root = _mk_repo_with_graph()
 47720	        proof = Path(tempfile.mkdtemp(prefix="gctl-unsafe-")) / "PWNED"
 47721	        _sp.run(["git", "-C", str(root), "config", key,
 47722	                 "bash -c 'echo x > %s' #" % proof], capture_output=True)
 47723	        # 兩種未提交的檔都要有,才會走到會呼叫主程式那條分支
 47724	        (root / "scripts" / "keep.py").write_text("x = 12\n", encoding="utf-8")
 47725	        (root / "docs" / "t-knowledge" / "Systems" / "s.md").write_text(
 47726	            "---\ntype: system\nstatus: doing\ncreated: 2026-09-18\n---\n# s\n\n改過\n", encoding="utf-8")
 47727	        home = Path(tempfile.mkdtemp(prefix="gctl-unsafe-h-"))
 47728	        tp = Path(tempfile.mkdtemp(prefix="gctl-unsafe-t-")) / "t.jsonl"
 47729	        rows = _turn(("Bash", {"command": "echo x=12 > scripts/keep.py"}))
 47730	        tp.write_text("\n".join(_j.dumps(r, ensure_ascii=False) for r in rows), encoding="utf-8")
 47731	        env = {**_os.environ, "HOME": str(home), "LUMOS_STOP_BLOCK_OFF": "1"}
 47732	        env.pop("GIT_CONFIG_PARAMETERS", None)
 47733	        payload = {"session_id": "unsafe-" + key.replace(".", "-"),
 47734	                   "transcript_path": str(tp), "cwd": str(root), "hook_event_name": "Stop"}
 47735	        r = _sp.run([sys.executable, str(hook), "--budget", "40"], input=_j.dumps(payload),
 47736	                    capture_output=True, text=True, cwd=str(root), env=env)
 47737	        check("清單項「%s」:hook 不能當掉" % key,
 47738	              "Traceback" not in (r.stdout + r.stderr), (r.stderr or "")[-200:])
 47739	        check("清單項「%s」:★攻擊者的指令不准執行★" % key, not proof.exists(),
 47740	              "證據檔被建出來了:%s" % proof)
 47741	    print("  ✓ t_sync_nudge_blocks_every_listed_unsafe_git_config")
