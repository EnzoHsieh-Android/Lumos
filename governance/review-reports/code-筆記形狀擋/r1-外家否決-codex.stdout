 22511	def _nodehome_changed_vs_disk(repo_root, where):
 22512	    """跟磁碟不一樣的路徑集合(那些要從 git 讀,其餘直接讀磁碟——既有的 git show 包裝一支一支讀,只讀這些)。
 22513	    where='index':工作目錄 vs 索引;where=HEAD 的 sha:工作目錄 vs HEAD;其他提交=None(全部從 git 讀)。"""
 22514	    if where == "index":
 22515	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames")
 22516	    else:
 22517	        raw = _nodehome_git(repo_root, "diff", "--name-only", "-z", "--no-renames", where)
 22518	    if raw is None:
 22519	        return None
 22520	    return {nfc(x) for x in _nodehome_split_z(raw)}
 22521	
