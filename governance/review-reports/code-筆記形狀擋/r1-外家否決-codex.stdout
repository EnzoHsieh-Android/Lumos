 26946	def _home_scan_text(text):
 26947	    """[S2] 判「確認」只看摘要與正文——about_code 欄位宣告的就是這支檔,拿它當證據等於自己證明自己。"""
 26948	    fm, body = split_frontmatter(text)
 26949	    summ = ""
 26950	    if fm is not None:
 26951	        try:
 26952	            fields, _bk, _lint = parse_frontmatter(fm)
 26953	            v = fields.get("summary")
 26954	            summ = v if isinstance(v, str) else ""
 26955	        except Exception:
 26956	            summ = ""
 26957	    return summ + "\n" + body
