 23628	def _ns_became_code(repo_root, base_where, tip_where, reader_tip):
 23629	    """範圍內「起點不是程式檔、終點是」的路徑(新增、改名過來、加 #!、類型改變都算)。"""
 23630	    ch = _nodehome_changes(repo_root, base_where, tip_where)
 23631	    if ch is None:
 23632	        return []
 23633	    lst_t = _nodehome_list(repo_root, tip_where)
 23634	    lst_b = _nodehome_list(repo_root, base_where)
 23635	    if lst_t is None or lst_b is None:
 23636	        return []
 23637	    reader_b = _nodehome_reader(repo_root, base_where)
 23638	    out = []
 23639	    for code, old, new in ch:
 23640	        if not new or code == "D":
 23641	            continue
 23642	        if not _ns_is_code(new, reader_tip, lst_t[0]):
 23643	            continue
 23644	        prev = old or new
 23645	        if prev not in lst_b[0] or not _ns_is_code(prev, reader_b, lst_b[0]):
 23646	            out.append(new)
 23647	    return out
 23648	
