+                    summary=summary, extra=extra)
+
+
+def _ns_stage(root):
+    _nh_git(root, "add", "-A")
+
+
+def _ns_reset(root):
+    _nh_git(root, "reset", "-q", "--hard", "HEAD")
+    _nh_git(root, "clean", "-qfd")
+
