"""
import argparse
import os
import re
import uuid
import sys
import time
import unicodedata
from collections import defaultdict, deque, namedtuple
from pathlib import Path

_IS_WIN = os.name == "nt"

# ── python-floor begin(最低 Python 3.14;精簡版生成器只剝下面呼叫檢查的那三行,函式留著——見 Systems/python直譯器選擇)──
# ★這一段與它之前的程式必須能被 Python 3.9 解析、執行★:Python 要先解析完整支檔才跑第一行,
# 舊版啟動時要能跑到這裡才講得出「需要 3.14」(Projects/最低Python版本改3.14_計劃 做法第 2 點)。
_PY_FLOOR = (3, 14)
_PY_PROBE_TIMEOUT = 5          # 單一候選
_PY_TOTAL_TIMEOUT = 15         # 整份清單
_PY_PROBE = ("import sys\n"
             "if sys.version_info >= (3, 14):\n    print('OK ' + sys.executable)\n"
             "else:\n    print('OLD %d.%d.%d' % sys.version_info[:3]); sys.exit(1)")
_PY_INSTALL_HINT = (
    "安裝 3.14:\n"
    "  macOS:  brew install python@3.14   或   uv python install 3.14\n"
    "  Linux:  發行版的 python3.14 套件   或   uv python install 3.14\n"
    "  Windows:python.org 的安裝器   或   winget install Python.Python.3.14\n"
    "裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。\n"
    "只有 python3.14、沒有 python3 這個名字的機器,全域 lumos 指令要 `uv python install 3.14 --default`\n"
    "或自己加一個 python3 別名(它用 #!/usr/bin/env python3 啟動)。\n")


def _py_fixed_candidates():
    """固定位置候選 → [路徑]。LUMOS_PYTHON_SEARCH_DIRS 有設就只看那幾個目錄(測試接縫,也給特殊環境用),
    否則是 Homebrew、/usr/local、~/.local/bin、uv 與 pyenv 自己的安裝目錄(路徑很短的環境靠這一段)。"""
    import glob
    over = os.environ.get("LUMOS_PYTHON_SEARCH_DIRS")
    names = ("python.exe",) if os.name == "nt" else ("python3.14", "python3.15", "python3.16", "python3")
    if over is not None:
        return [os.path.join(d, n) for d in over.split(os.pathsep) if d for n in names]
    home = os.path.expanduser("~")
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA", "")
        return sorted(glob.glob(os.path.join(base, "Programs", "Python", "Python31[4-9]", "python.exe"))) if base else []
    out = ["/opt/homebrew/bin/python3.14", "/usr/local/bin/python3.14", os.path.join(home, ".local", "bin", "python3.14")]
    out += sorted(glob.glob(os.path.join(home, ".local", "share", "uv", "python", "cpython-3.1[4-9]*", "bin", "python3")))
    out += sorted(glob.glob(os.path.join(home, ".pyenv", "versions", "3.1[4-9]*", "bin", "python3")))
    return out


def _py_candidates():
    """找 3.14 的候選順序 → [(說明, argv 前綴或 None=問 uv)](計劃做法第 1 點;python3、python 放最後)。"""
    out = [(n, [n]) for n in ("python3.14", "python3.15", "python3.16")]
    out += [(p, [p]) for p in _py_fixed_candidates()]
    if os.name == "nt":
        out.append(("py -3.14", ["py", "-3.14"]))
    out.append(("uv python find", None))
    out += [(n, [n]) for n in ("python3", "python")]
    return out


def _py_which(name):
    """指令名 → 絕對路徑或 None,之後一律用絕對路徑執行。兩種找到了也不收(代碼審 r1 資安席、r2 正確性席):
    ①PATH 裡的相對路徑項(例如 `.`、`bin`)找到的——那是隨目前目錄變的,git 掛鉤的目前目錄是 repo 根;
    ②★Windows 會先在目前目錄本身找★:找到的檔就在目前目錄裡(陌生 repo 放一支 python3.14.exe)。
    只擋目前目錄本身、不擋整棵子樹:目前目錄是家目錄或磁碟根時,正常裝在底下的直譯器不能因此消失。"""
    import shutil
    found = shutil.which(name)
    if found is None or not os.path.isabs(found):
        return None
    if os.name == "nt":
        here = os.path.normcase(os.path.realpath(os.getcwd()))
        if os.path.normcase(os.path.dirname(os.path.realpath(found))) == here:
            return None
    return os.path.abspath(found)


def _py_probe(argv, deadline):
    """用這個候選跑一次版本檢查 → (≥3.14 的絕對路徑或 None, 結果說明)。標準輸入接空、有逾時。"""
    import subprocess
    exe = argv[0]
    if os.path.dirname(exe):
        if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
            return None, "不存在"
    else:
        full = _py_which(exe)
        if full is None:
            return None, "沒有這個指令"
        argv = [full, *argv[1:]]
    left = deadline - time.monotonic()
    if left <= 0:
        return None, "整份清單超過 %d 秒,沒試" % _PY_TOTAL_TIMEOUT
    try:
        r = subprocess.run([*argv, "-c", _PY_PROBE], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, errors="replace", timeout=min(_PY_PROBE_TIMEOUT, left))
    except subprocess.TimeoutExpired:
        return None, "逾時(%s 秒沒回)" % _PY_PROBE_TIMEOUT
    except OSError as e:
        return None, "執行失敗(%s)" % e
    out = (r.stdout or "").strip().splitlines()
    last = out[-1] if out else ""
    if r.returncode == 0 and last.startswith("OK ") and os.path.isabs(last[3:].strip()):
        return last[3:].strip(), "合格"
    if last.startswith("OLD "):
        return None, "版本 %s,低於 3.14" % last[4:].strip()
    return None, "執行失敗(回傳碼 %s,可能是 Windows 商店替身)" % r.returncode


def _py_uv_find(deadline):
    """問 uv 要一支 ≥3.14(不找虛擬環境、不准觸發下載)→ (它印的路徑或 None, 結果說明)。
    執行失敗、逾時跟「uv 正常回答但沒有 3.14」分開講(代碼審 r2 外家席)。"""
    import subprocess
    uv = _py_which("uv")
    if uv is None:
        return None, "沒有這個指令"
    left = deadline - time.monotonic()
    if left <= 0:
        return None, "整份清單超過 %d 秒,沒試" % _PY_TOTAL_TIMEOUT
    try:
        r = subprocess.run([uv, "python", "find", "--system", "--no-python-downloads", ">=3.14"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                           timeout=min(_PY_PROBE_TIMEOUT, left))
    except subprocess.TimeoutExpired:
        return None, "逾時(%s 秒沒回)" % _PY_PROBE_TIMEOUT
    except OSError as e:
        return None, "執行失敗(%s)" % e
    path = (r.stdout or "").strip().splitlines()[-1:] if r.returncode == 0 else []
    if path and os.path.isabs(path[0]):
        return path[0], "合格"
    return None, "uv 找不到 3.14"


def _py_resolve():
    """找一支 ≥3.14 的直譯器 → (絕對路徑或 None, [(候選, 結果)])。LUMOS_PYTHON 有設就只認它:
    必須是絕對路徑、而且合格,否則停下,不往下找(明寫了要用哪一支的人,不該被默默換成別支)。找到一個就停。"""
    deadline = time.monotonic() + _PY_TOTAL_TIMEOUT
    pinned = os.environ.get("LUMOS_PYTHON", "")
    if pinned:
        if not os.path.isabs(pinned):
            return None, [("LUMOS_PYTHON=" + pinned, "不是絕對路徑(掛鉤與手打時會解析到不同的檔,不收)")]
        path, why = _py_probe([pinned], deadline)
        return path, [("LUMOS_PYTHON=" + pinned, why)]
    tried = []
    for desc, argv in _py_candidates():
        if argv is None:
            found, why = _py_uv_find(deadline)
            if found is None:
                tried.append((desc, why))
                continue
            desc, argv = desc + " → " + found, [found]
        path, why = _py_probe(argv, deadline)
        tried.append((desc, why))
        if path:
            return path, tried
    return None, tried


def _py_floor_message(tried, head="需要 Python 3.14 以上"):
    lines = ["擋下:%s,現在是 %d.%d.%d(%s)。" % (head, *sys.version_info[:3], sys.executable)]
    # 每個候選都列結果(條款 [S2]);不存在的很多,併成一行,免得真正的線索被淹掉(代碼審 r1)
    missing = [d for d, w in tried if w in ("不存在", "沒有這個指令")]
    lines.append("找過的候選:")
    lines += ["  %s:%s" % (d, w) for d, w in tried if w not in ("不存在", "沒有這個指令")]
    if missing:
        lines.append("  不存在或沒有這個指令:" + "、".join(missing))
    if os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"):
    if as_json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print(f"seat-check {Path(report).name}: 派工要查但報告沒碰 unreported {len(out['unreported'])}"
              f" / 引句超出派工範圍 out_of_scope {len(out['out_of_scope'])}(派工材料 {len(materials)} 份;只觀測不擋)")
        for mp in out["unreported"]:
            print(f"  ⚠ unreported: {mp}(派工單說要查這份,報告裡一個字都沒提到)")
        for q in out["out_of_scope"]:
            print(f"  ⚠ out_of_scope: 「{q[:50]}」(這句引言不在派工的任何一份材料裡{';已記進出界帳' if ledger else ''})")
        print("  (這項只觀測不擋:看的是報告有沒有照派工單走,不評審查角度;引 file:line 當證據一律算合法)")
    return 0


def _own_hook_scripts():
    """lumos 自己註冊進 Claude/Codex 的掛鉤檔名(不含共用模組)。enforcement 各列找的檔名必須在這裡面,
    由 t_doctor_flags_stale_hook_python 守(代碼審 r2 架構對齊席:認自家掛鉤有幾處各自寫,至少名單只有一份)。"""
    return {n for n in _GLOBAL_CLAUDE_HOOKS if n.endswith(".py") and not n.startswith("_")}


def _hook_python_problems(home=None):
    """Claude/Codex 設定裡註冊的直譯器 → (看過的 [(家, 路徑, 結果)], 有問題的 [說明])。每支實際執行一次看版本(5 秒逾時)。
    sys.executable 可能落在 uv、pyenv、venv、Homebrew 某個版本目錄底下,會隨它們更新或刪除而消失,原本沒有任何東西會發現
    (Projects/最低Python版本改3.14_計劃 做法第 9 點)。讀不到設定檔 = 沒有註冊,不算問題。
    ★只看 lumos 自己註冊的那幾條★(第二段是 lumos 自家掛鉤檔、第一段看起來是 python):設定檔裡也有別的工具的掛鉤,
    拿它們的第一個字去跑 `-c <探針>` 會真的執行別人的腳本,而且重跑 lumos install 修不掉那種誤報(代碼審 r1)。"""
    import json as _json
    import shlex as _shlex
    home = Path(home) if home else Path.home()
    ours = _own_hook_scripts()
    codex_dir = str(_codex_home(home) / "hooks").replace("\\", "/").rstrip("/")
    seen, probs = [], []
    for fam, f in (("claude", home / ".claude" / "settings.json"), ("codex", _codex_home(home) / "hooks.json")):
        try:
            d = _json.loads(f.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        exes = set()
        for arr in (d.get("hooks") or {}).values():
            for grp in arr if isinstance(arr, list) else []:
                for hk in (grp.get("hooks") or []) if isinstance(grp, dict) else []:
                    cmd = str((hk or {}).get("command") or "")
                    try:
                        parts = _shlex.split(cmd)
                    except ValueError:
                        continue
                    if len(parts) < 2:
                        continue
                    script = parts[1].replace("\\", "/")
                    d, _, base = script.rpartition("/")
                    # 自家掛鉤 = 檔名是 lumos 的、而且放在 lumos 裝的那兩個目錄(r2 外家席:只比檔名,別家同名檔也會被認);
                    # 第一段像 python,含 free-threaded 的 python3.14t(r2 正確性席)
                    if (base in ours and (d.endswith("/.claude/hooks") or d == codex_dir)
                            and re.match(r"(?i)py(thon[0-9.]*t?)?(\.exe)?$", parts[0].replace("\\", "/").rsplit("/", 1)[-1])):
                        exes.add(parts[0])
        for exe in sorted(exes):
            path, why = _py_probe([exe], time.monotonic() + _PY_PROBE_TIMEOUT)
            seen.append((fam, exe, why))
            if not path:
                probs.append("%s 的掛鉤註冊的是 %s:%s" % (fam, exe, why))
    return seen, probs


def enforcement_status(root=None, home=None):
    """回各層防護「現在有沒有生效」的清單 [{layer, status, detail}](Projects/enforcement儀表板_計劃)。
    純唯讀、每層各自 try 包住(一層測不出來不拖垮整份;fail-open 本身要能被觀測)。
    status: active | inactive | degraded | unknown | registered-trust-unknown(只有 Codex hook 列會出:
    已註冊、檔在,但要人在互動 codex 審過才跑、本機讀不到——不進 summary 分母)。root=repo 根、home=~/(測試可注入)。"""
    import json as _json
    if root:
        root = Path(root)
    else:
        for cand in (Path.cwd(), *Path.cwd().parents):   # cwd 逐層向上找 .git(同 _anchor_repo_root 慣例)
            if (cand / ".git").exists():
                root = cand
                break
        else:
            root = Path.cwd()
    home = Path(home) if home else Path.home()
    rows = []

    def add(layer, status, detail=""):
        rows.append({"layer": layer, "status": status, "detail": detail})

    # ①②③ 全域 Claude hooks 註冊(讀 ~/.claude/settings.json)
    reg = {}
    try:
        sp = home / ".claude" / "settings.json"
        if sp.exists():
            d = _json.loads(sp.read_text(encoding="utf-8"))
            for ev, arr in (d.get("hooks") or {}).items():
                for grp in arr:
                    for hk in (grp.get("hooks") or []):
                        reg[str(hk.get("command", ""))] = True
    except Exception as e:
        reg = None  # 讀不到 settings → 三 hook 皆 unknown
    # ★r1 審:註冊了不等於生效★——還要目標 .py 真的在 ~/.claude/hooks/(懸空註冊是 _prune_dangling 存在的原因,
    # 2026-07-07 事故)。★r1 審:_GLOBAL_CLAUDE_HOOKS 有 4 支,原本漏檢 ci-status(CI 紅燈後備網)★。
    hookdir = home / ".claude" / "hooks"
    for layer, needle in (("session-entry-hook", "lumos-entry-hook.py"),
                          ("pretooluse-impact-hook", "impact-hook.py"),
                          ("stop-graph-sync-hook", "check-graph-sync.py"),
                          ("sessionstart-ci-status-hook", "ci-status-hook.py"),
                          ("pretooluse-dispatch-lens-hook", "dispatch-lens-hook.py"),
                          # ★這份清單是寫死列舉的,加 hook 一定要回來加一行★
                          # (2026-09-14 代碼審 r1 架構對齊席 major:記憶清掃那支漏登記,
                          #  於是它逾時、出錯、靜默失效,整個工具鏈都不會有任何感知)
                          ("sessionstart-memory-sweep", "memory-sweep.py")):
        if reg is None:
            add(layer, "unknown", "~/.claude/settings.json 讀不到")
            continue
        registered = any(needle in cmd for cmd in reg)
        file_ok = (hookdir / needle).exists()
        if registered and file_ok:
            # ★生效 ≠ 有註冊★(#19 S4):還要「現在的這個版本最近真的成功跑完過」。
            # 沒有近期成功不標 inactive——那可能只是七天內沒被觸發。
            _lv, _why = _hook_recent_ok(root, layer, hookdir / needle)
            if _lv == "ok":
                add(layer, "active", f"{needle};{_why}")
            else:
                add(layer, "stale" if _lv == "stale" else "unknown", f"{needle};{_why}")
        elif registered and not file_ok:
            add(layer, "degraded", f"{needle} 已註冊但檔案不在 ~/.claude/hooks/(懸空)")
        else:
            add(layer, "inactive", needle)

    # ③b Codex 側(Projects/Codex完全支援_計劃 S0-4):每支 hook 一列,值域
    # registered-trust-unknown | degraded | inactive | unknown——★不出 active★:Codex 的 hook 要人在互動畫面
    # 審過才跑,信任狀態本機讀不到(信任存放處沒查出來),所以最多只能說「已註冊、檔在」。
    # 判準單源=_codex_present(只看家目錄,不看 PATH):結果跟 HOME 隔離的測試一致。
    _ch = _codex_home(home)
    codex_ok = _codex_present(home)          # 與 install/teardown 同一判準
    creg = {}
    try:
        cp = _ch / "hooks.json"
        if cp.exists():
            d = _json.loads(cp.read_text(encoding="utf-8"))
            for ev, arr in (d.get("hooks") or {}).items():
                for grp in arr:
                    for hk in (grp.get("hooks") or []):
                        creg[str(hk.get("command", ""))] = True
    except Exception:
        creg = None
    chookdir = _ch / "hooks"
    for layer, needle in (("codex-session-entry-hook", "lumos-entry-hook.py"),
                          ("codex-pretooluse-impact-hook", "impact-hook.py"),
                          ("codex-stop-graph-sync-hook", "check-graph-sync.py"),
                          ("codex-sessionstart-ci-status-hook", "ci-status-hook.py"),
                          ("codex-subagentstart-dispatch-lens-hook", "dispatch-lens-hook.py")):
        if not codex_ok:
            # 不適用而非壞掉:標 unknown 才不會讓每 session 的入口 hook 對沒裝 Codex 的機器一直唸
            add(layer, "unknown", "本機無 codex,不適用(裝了再跑 lumos install --force)")
            continue
        if creg is None:
            add(layer, "unknown", f"{_ch / 'hooks.json'} 讀不到")
            continue
        registered = any(needle in cmd for cmd in creg)
        file_ok = (chookdir / needle).exists()
        if registered and file_ok:
            add(layer, "registered-trust-unknown", f"{needle} 已註冊、檔在;要不要跑由你在互動 codex 審過 hook 才算數,本機讀不到")
        elif registered and not file_ok:
            add(layer, "degraded", f"{needle} 已註冊但檔案不在 {chookdir}/(懸空)")
        else:
            add(layer, "inactive", needle)
    try:
        ver = ""
        if codex_ok:
            r = subprocess.run(["codex", "--version"], capture_output=True, text=True, timeout=10)
            ver = (r.stdout or r.stderr).strip().split("\n")[0]
        add("codex-cli", "active" if ver else "unknown",
            (ver + ";地基事實在 codex-cli 0.144.1 與 0.153.2 上實測(信任閘/密文兩版相同;自訂 agent 0.153.2 起選得中),其他版本要重驗 hook 行為") if ver else "本機無 codex,不適用")
    except Exception as e:
        add("codex-cli", "unknown", str(e))

    # ③b' Codex 自訂審查席 TOML(d6;每樣裝的東西都有一列——code-codex-d6 r1 架構席)
    try:
        if not codex_ok:
            add("codex-agent", "unknown", "本機無 codex,不適用")
        else:
            miss, foreign, ok = [], [], []
            for nm, _ in _CODEX_SEATS:
                af = _ch / "agents" / f"{nm}.toml"
                if not af.exists():
                    miss.append(nm)
                elif _CODEX_AGENT_MARK in af.read_text(encoding="utf-8", errors="replace"):
                    ok.append(nm)
                else:
                    foreign.append(nm)
            if foreign:
                add("codex-agent", "degraded", f"agents/{'、'.join(foreign)}.toml 是別人的檔(無 lumos 標記),lumos 不覆蓋")
            elif miss:
                add("codex-agent", "inactive", f"少了審查席 {'、'.join(miss)}(lumos install --force 會寫)")
            else:
                add("codex-agent", "active", f"三席都在:{_CODEX_AGENT_NAME}(散文審 {_CODEX_SEAT_MODEL}+medium)、{_CODEX_AGENT_CODE_NAME}(程式碼審 {_CODEX_SEAT_MODEL}+xhigh)、{_CODEX_AGENT_MAX_NAME}(高風險 {_CODEX_SEAT_MODEL}+xhigh);0.153.2 實測選得中、0.144.1 忽略;唯讀仍靠父代理沙盒")
    except Exception as e:
        add("codex-agent", "unknown", str(e))

    # ③c skills 兩層(對稱;r1 整合 F6):使用者層目錄裡有沒有 lumos-* 連結/目錄
    for layer, sk in (("claude-skills", home / ".claude" / "skills"), ("codex-skills", home / ".agents" / "skills")):
        try:
            if layer == "codex-skills" and not codex_ok:
                add(layer, "unknown", "本機無 codex,不適用")
                continue
            have = [p.name for p in sk.iterdir() if p.name.startswith("lumos-")] if sk.is_dir() else []
            add(layer, "active" if have else "inactive", f"{len(have)} 支 lumos-* 在 {sk}" if have else f"{sk} 無 lumos-* skill")
        except Exception as e:
            add(layer, "unknown", str(e))

    # ③d Codex 指示檔(AGENTS.md / AGENTS.override.md):區塊在、版本戳與 CLAUDE.md 一致
    try:
        aname = _agents_target(root)
        ap = root / aname
        cmp_ = root / "CLAUDE.md"
        if not ap.exists():
            add("agents-md", "unknown" if not codex_ok else "inactive", f"無 {aname}(lumos init/update 會注入)" + ("" if codex_ok else ";本機無 codex,不適用"))
        else:
            def _ver_of(path):
                b = path.read_bytes()
                if b.startswith(b"\xef\xbb\xbf"):
                    b = b[3:]
                return _parse_sentinel_version(b.decode("utf-8", "replace").replace("\r\n", "\n"))
            av = _ver_of(ap)
            cv = _ver_of(cmp_) if cmp_.exists() else None
            if av is None:
                add("agents-md", "inactive", f"{aname} 無紀律區塊(lumos update 注入)")
            elif cv is not None and av != cv:
                add("agents-md", "degraded", f"{aname} 版本戳 {av} ≠ CLAUDE.md {cv}(lumos update 刷新)")
            else:
                add("agents-md", "active", f"{aname} 版本戳 {av}" + ("(override 檔:同層 AGENTS.md 會被 Codex 忽略)" if aname.endswith("override.md") else ""))
    except Exception as e:
        add("agents-md", "unknown", str(e))

    # ④⑤ git pre-commit / pre-push:core.hooksPath 指向 scripts/hooks 且檔存在可執行
    try:
        hp = subprocess.run(["git", "-C", str(root), "config", "core.hooksPath"],
                            capture_output=True, text=True, errors="replace", timeout=10).stdout.strip()
    except Exception:
        hp = ""
    for layer, fn in (("git-pre-commit", "pre-commit"), ("git-pre-push", "pre-push")):
        try:
            f = root / "scripts" / "hooks" / fn
            ok = _hooks_path_is_ours(root, hp) and f.is_file() and os.access(str(f), os.X_OK)
            add(layer, "active" if ok else "inactive",
                f"core.hooksPath={hp or '(未設)'};{fn} {'在' if f.is_file() else '缺'}")
        except Exception as e:
            add(layer, "unknown", str(e))

    # ⑥ python:跑 lumos 的這支,加上 Claude/Codex 設定裡註冊的直譯器(Projects/最低Python版本改3.14_計劃 [S10])
    try:
        _seen, _probs = _hook_python_problems(home)
        _reg = ";".join("%s 掛鉤 %s(%s)" % (f, e, w) for f, e, w in _seen)
        add("python", "active",   # 狀態不因註冊的直譯器改變(不動既有的分母);有問題寫進說明,提醒交給 doctor Q 段
            sys.version.split()[0] + (";" + _reg if _reg else "") + (";重跑 lumos install 修正" if _probs else ""))
    except Exception as e:
        add("python", "unknown", str(e))

    # ⑦ vendored 版本——★r1 審:_version_nudge 回 None 有四種(無 CLAUDE.md/無版本戳/來源不可達/真最新),
    # 原本全當 active 會讓「沒裝 lumos 的專案」假綠。改成先自查前提,分不清就 unknown,不假綠。★
    try:
        cm = root / "CLAUDE.md"
        if not cm.exists():
            add("vendored-cli", "unknown", "無 CLAUDE.md,無法判版本(非 lumos 專案?)")
        else:
            txt = cm.read_bytes()
            if txt.startswith(b"\xef\xbb\xbf"):
                txt = txt[3:]
            ver = _parse_sentinel_version(txt.decode("utf-8", "replace").replace("\r\n", "\n"))
            if ver is None:
                add("vendored-cli", "unknown", "CLAUDE.md 無版本戳(未接圖譜紀律區塊?)")
            else:
                # ★r2 審:_version_nudge 回 None 有兩種——「來源 clone 不可達」與「真的最新」,不能都當 active★。
                # 先自查來源可達性(同 _version_nudge 內部條件):不可達 → unknown(乾淨機器/CI 沒 clone 時別假綠)。
                src_lumos = _lumos_src() / "scripts" / "lumos"
                if not src_lumos.exists():
                    add("vendored-cli", "unknown", f"版本戳 {ver},但來源 clone 不可達,無法比對是否落後")
                else:
                    lag = _version_nudge(root)
                    add("vendored-cli", "degraded" if lag else "active", lag or f"版本戳 {ver},與來源比對未落後")
    except Exception as e:
        add("vendored-cli", "unknown", str(e))

    # ⑧ CI workflow

