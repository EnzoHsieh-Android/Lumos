def _codex_home(home=None) -> Path:
    """Codex 的家目錄:$CODEX_HOME 優先(Codex 自己就這樣找 config/hooks;r1 外家 #1),否則 ~/.codex。"""
    import os
    env = os.environ.get("CODEX_HOME")
    if env:
        return Path(env).expanduser()
    return (Path(home) if home else Path.home()) / ".codex"


def _codex_present(home=None) -> bool:
    """本機有沒有 Codex:★單一判準=Codex 家目錄(~/.codex 或 $CODEX_HOME)在不在★,不看 PATH——
    install/teardown/enforcement 三處共用同一個答案(code-codex-s0 r1 架構席:曾兩套判準分岔);
    codex 第一次跑就會建家目錄,「有 binary 沒目錄」=還沒用過,等用過再 lumos install --force 即可。"""
    return _codex_home(home).is_dir()


def _sync_global_claude(src_repo: Path):
    """相容包裝:Claude 側同步,回 True=ok(既有呼叫/測試用)。三態版見 _sync_global_hooks。"""
    return _sync_global_hooks(src_repo, "claude") == "ok"


def _sync_global_hooks(src_repo: Path, harness: str) -> str:
    """全域 hooks/註冊同步(不需專案;install 與 _install_hooks_py 共用)。harness=claude|codex:
    claude → ~/.claude/hooks + settings.json;codex → ~/.codex/hooks + hooks.json(合併器 --target codex)。
    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)④codex 專用:寫自訂審查席 TOML(d6)。
    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);HOME 隔離可測。
    回三態字串:ok / probe(探針擋下,沒動) / merge-failed(hooks 設定檔壞或合併器非 0,hook 檔已 copy 但註冊沒更新)
    / absent(codex 專用:本機無 codex,跳過)。★不共用一顆布林★——False 曾被呼叫端寫死解讀成 LUMOS_PROBE,
    設定檔壞掉會印出誤導訊息(Projects/Codex完全支援_計劃 r2 邊界 N2)。"""
    # ★r1 正確性席:同 _install_skills——cmd_init/_vendor_toolchain 這條路會經此覆寫真的 ~/.claude/hooks
    # 與動 settings.json,繞過四個指令入口的守衛。擋在變動原語。
    if _refuse_if_probe(f"sync-global-{harness}"):
        return "probe"
