   249	    os.environ["LUMOS_REEXEC_PYTHON"] = path
   250	    argv = [path, os.path.abspath(__file__), *sys.argv[1:]]
   251	    sys.stdout.flush()
   252	    sys.stderr.flush()
   253	    if os.name == "nt":
   254	        import subprocess
