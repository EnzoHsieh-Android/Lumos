 51343	def t_hooks_block_without_python314():
 51344	    """[S3] pre-commit/pre-push 確定要叫 lumos、卻找不到 3.14(只找得到舊版或完全沒 python)→ 擋下印說明,不退回舊版;
 51345	    沒有 scripts/lumos、staged 為空照舊放行;post-commit 在只有 python3.14 的機器照樣寫跳過帳;
 51346	    內嵌段在 set -euo pipefail 下不中途結束(Projects/最低Python版本改3.14_計劃 做法第 3 點)。
 51347	
 51348	    翻紅釘:Gate PY 拿掉 → ①紅(會退回舊版跑或整段跳過);pre-push 改回沒 3.14 放行 → ③紅;
 51349	    post-commit 清單少 python3.14 → ⑤紅;launcher 在 set -e 下直接失敗 → ⑥紅;launcher 不認 LUMOS_PYTHON → ⑦紅;
 51350	    只看能不能執行、不驗絕對路徑與是不是 python → ⑦b紅;不驗 python-path 回的路徑 → ①b紅。
 51351	    """
 51352	    print("t_hooks_block_without_python314")
 51353	    import os as _os, tempfile as _tf, subprocess as _sp
 51354	    if not hasattr(_os, "setsid"):
 51355	        raise _SrcOnly("非 POSIX,這段沒驗到")
 51356	    hooks = Path(GRAPHCTL).resolve().parent / "hooks"
 51357	    tmp = Path(_tf.mkdtemp(prefix="gctl-py314h-"))
 51358	    nopy = _py314_sysbin(tmp)
 51359	    withpy = _py314_sysbin(tmp, keep_python=True)
 51360	    good = tmp / "goodbin"
 51361	    good.mkdir()
 51362	    _os.symlink(sys.executable, good / "python3.14")
 51363	    base = {k: v for k, v in _os.environ.items() if k not in ("LUMOS_PYTHON", "LUMOS_REEXEC_PYTHON", "GIT_DIR")}
 51364	    base.update(HOME=str(tmp), LUMOS_PYTHON_SEARCH_DIRS=str(tmp / "nowhere"))
 51365	
 51366	    def hook(name, root, path, stdin=""):
 51367	        return _sp.run(["/bin/bash", str(hooks / name)], cwd=str(root), capture_output=True, text=True, input=stdin,
 51368	                       env=dict(base, PATH=path), timeout=300)
 51369	    old_py = any(n.startswith("python3") for n in _os.listdir(withpy))
 51370	    root = _py314_hook_repo(tmp / "a")
 51371	    if old_py:
 51372	        r = hook("pre-commit", root, str(withpy))
 51373	        check("①pre-commit 只找得到舊版 python:擋下印說明,不退回舊版", r.returncode == 1 and "要用 Python 3.14" in r.stderr
 51374	              and "Traceback" not in r.stderr, r.stdout[-200:] + r.stderr[-500:])
 51375	    else:
 51376	        print("  (沒驗到①:這台機器 /usr/bin 沒有 python3)")
 51377	    r = hook("pre-commit", root, str(nopy))
 51378	    check("①pre-commit 完全沒有 python:擋下並印安裝指令", r.returncode == 1 and "找不到任何 python" in r.stderr
 51379	          and "brew install python@3.14" in r.stderr, r.stderr[-400:])
 51380	    fake = tmp / "fakebin"
 51381	    fake.mkdir()
 51382	    (fake / "python3.14").write_text("#!/bin/sh\necho /usr/bin/true\n", encoding="utf-8")
 51383	    (fake / "python3.14").chmod(0o755)
 51384	    r = hook("pre-commit", root, str(fake) + _os.pathsep + str(nopy))
 51385	    check("①b PATH 上的 python3.14 是假的、回一支 /usr/bin/true:不拿它跑閘,擋下並講明", r.returncode == 1
 51386	          and "不是 3.14 以上的 python" in r.stderr, r.stderr[-400:])
 51387	    r = hook("pre-commit", root, str(good) + _os.pathsep + str(nopy))
 51388	    check("②pre-commit 有 3.14:不因版本擋下", r.returncode == 0 and "要用 Python 3.14" not in r.stderr, r.stderr[-400:])
 51389	    r = hook("pre-push", root, str(nopy))
 51390	    check("③pre-push 有 lumos 卻找不到 3.14:擋下", r.returncode == 1 and "要用 Python 3.14" in r.stderr, r.stderr[-400:])
 51391	    bare = _py314_hook_repo(tmp / "b", with_lumos=False)
 51392	    r = hook("pre-commit", bare, str(nopy))
 51393	    check("④沒有 scripts/lumos:pre-commit 照舊放行", r.returncode == 0, r.stderr[-300:])
 51394	    r = hook("pre-push", bare, str(nopy))
 51395	    check("④沒有 scripts/lumos:pre-push 照舊放行", r.returncode == 0 and "沒有 scripts/lumos" in r.stderr, r.stderr[-300:])
 51396	    _sp.run(["git", "-C", str(bare), "reset", "-q"], capture_output=True)
 51397	    r = hook("pre-commit", bare, str(nopy))
 51398	    check("④staged 為空:照舊放行", r.returncode == 0, r.stderr[-300:])
 51399	    pc = _py314_hook_repo(tmp / "c", with_lumos=False)
 51400	    (pc / "app.py").write_text("x = 1\n", encoding="utf-8")
 51401	    _sp.run(["git", "-C", str(pc), "add", "app.py"], capture_output=True)
 51402	    _sp.run(["git", "-C", str(pc), "commit", "-qm", "code only", "--no-verify"], capture_output=True)
 51403	    r = hook("post-commit", pc, str(good) + _os.pathsep + str(nopy))
 51404	    log = pc / "docs" / ".bypass-log.jsonl"
 51405	    check("⑤post-commit 只有 python3.14 的機器:跳過帳照樣寫入", log.exists() and "code only" in log.read_text(encoding="utf-8"),
 51406	          r.stderr[-300:])
 51407	    src = (hooks / "pre-commit").read_text(encoding="utf-8")
 51408	    blk = src[src.index("# ── python-launcher begin"):src.index("# ── python-launcher end ──")]
 51409	    r = _sp.run(["/bin/bash", "-c", "set -euo pipefail\n" + blk + "\n_lumos_any_python || echo NONE\necho AFTER"],
 51410	                capture_output=True, text=True, env=dict(base, PATH=str(nopy)))
 51411	    check("⑥內嵌段在 set -euo pipefail、沒有 python 時不中途結束", "NONE" in r.stdout and "AFTER" in r.stdout,
 51412	          r.stdout + r.stderr[-200:])
 51413	    r = _sp.run(["/bin/bash", "-c", "set -euo pipefail\n" + blk + '\n_lumos_any_python && echo "EXE=$_LUMOS_ANY_EXE"'],
 51414	                capture_output=True, text=True, env=dict(base, PATH=str(nopy), LUMOS_PYTHON=sys.executable))
 51415	    check("⑦PATH 上沒有任何 python、只設了 LUMOS_PYTHON:第一步就用它(找不到時的說明叫人設它,不能不認)",
 51416	          f"EXE={sys.executable}" in r.stdout, r.stdout + r.stderr[-200:])
 51417	    for bad, why in (("/usr/bin/true", "不是 python"), ("scripts/lumos", "不是絕對路徑")):
 51418	        r = _sp.run(["/bin/bash", "-c", "set -euo pipefail\n" + blk
 51419	                     + '\nif _lumos_any_python; then echo "EXE=$_LUMOS_ANY_EXE"; else printf "%s\\n" "$_LUMOS_NO_PY_MSG"; fi'],
 51420	                    capture_output=True, text=True, env=dict(base, PATH=str(nopy), LUMOS_PYTHON=bad))
 51421	        check(f"⑦b LUMOS_PYTHON={bad}({why}):不收,找不到時的說明講出它被略過的原因",
 51422	              "EXE=" not in r.stdout and f"LUMOS_PYTHON={bad}" in r.stdout and "找不到任何 python" in r.stdout,
 51423	              r.stdout + r.stderr[-200:])
