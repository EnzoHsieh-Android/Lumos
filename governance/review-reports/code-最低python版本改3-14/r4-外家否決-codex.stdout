 51307	def _py314_sysbin(tmp, keep_python=False):
 51308	    """把 /usr/bin 與 /bin 的工具逐一連結進 tmp/sysbin,略過名字是 python 開頭的(keep_python=True 就不略過)。
 51309	    掛鉤要用的 git、sed、tail… 都在,python 卻看不到——造「這台機器沒有 python」。"""
 51310	    import os as _os
 51311	    d = tmp / ("sysbin-py" if keep_python else "sysbin")
 51312	    d.mkdir(parents=True, exist_ok=True)
 51313	    for base in ("/usr/bin", "/bin"):
 51314	        if not _os.path.isdir(base):
 51315	            continue
 51316	        for name in _os.listdir(base):
 51317	            if (not keep_python and name.startswith("py")) or (d / name).exists():
 51318	                continue
 51319	            src = _os.path.join(base, name)
 51320	            if _os.path.isfile(src) and _os.access(src, _os.X_OK):
 51321	                _os.symlink(src, d / name)
 51322	    return d
 51323	
