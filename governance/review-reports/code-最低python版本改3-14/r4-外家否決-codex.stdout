 51581	    翻紅釘:某處改回自己 replace → ①紅;引號拿掉 → ②紅;config 改回 python3 → ③紅。"""
 51582	    print("t_test_run_cmd_uses_running_python")
 51583	    import os as _os, json as _j, tempfile as _tf, subprocess as _sp
 51584	    repo = Path(GRAPHCTL).resolve().parent.parent
 51585	    src = Path(GRAPHCTL).read_text(encoding="utf-8")
 51586	    body = src[src.index("def _run_cmd_expand"):]
 51587	    body = body[:body.index("\ndef ", 10)]
 51588	    outside = src.replace(body, "")
 51589	    check("①只有代入函式自己代換 {method};三處都呼叫它", '.replace("{method}"' not in outside
 51590	          and outside.count("_run_cmd_expand(run_cmd") == 3, str(outside.count("_run_cmd_expand(run_cmd")))
 51591	    m = _load_lumos_inproc()
 51592	    tmp = Path(_tf.mkdtemp(prefix="gctl-s8-"))
 51593	    venv = tmp / "my py" / "venv"
 51594	    _sp.run([sys.executable, "-m", "venv", "--without-pip", str(venv)], capture_output=True, check=True)
 51595	    saved = m.sys.executable
 51596	    try:
 51597	        m.sys.executable = str(venv / "bin" / "python3")
 51598	        cmd = m._run_cmd_expand("{python} -c 'import sys; print(sys.argv[1])' {method}", "t_x")
 51599	    finally:
 51600	        m.sys.executable = saved
 51601	    r = _sp.run(cmd, shell=True, capture_output=True, text=True)
 51602	    check("②直譯器路徑含空白:展開後照樣可執行,測試名照樣帶到", r.returncode == 0 and r.stdout.strip() == "t_x", cmd + r.stderr[-200:])
 51603	    cfg = _j.loads((repo / ".lumos" / "config.json").read_text(encoding="utf-8"))
 51604	    check("③本 repo 的測試指令用 {python},不吃 PATH 上的 python3",
 51605	          str((cfg.get("test") or {}).get("run_cmd", "")).startswith("{python} "), str(cfg.get("test")))
