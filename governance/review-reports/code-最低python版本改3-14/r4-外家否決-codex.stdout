 51088	def _py314_fake_env(tmp, entries, extra=None):
 51089	    """造一個只看得到 tmp/bin 的環境:entries={名字: "good"|"old"|"sleep"|"fail"}。
 51090	    good = 指到跑這支測試的 3.14 直譯器;old = 印舊版號回 1 的假直譯器;sleep = 卡住;fail = 一執行就失敗。"""
 51091	    import os as _os
 51092	    b = tmp / "bin"
 51093	    b.mkdir(parents=True, exist_ok=True)
 51094	    for name, kind in entries.items():
 51095	        p = b / name
 51096	        if kind == "good":
 51097	            _os.symlink(sys.executable, p)
 51098	            continue
 51099	        body = {"old": "echo 'OLD 3.9.6'\nexit 1\n", "sleep": "exec /bin/sleep 30\n", "fail": "exit 9\n"}[kind]
 51100	        p.write_text("#!/bin/sh\n" + body, encoding="utf-8")
 51101	        p.chmod(0o755)
 51102	    env = {"PATH": str(b) + _os.pathsep + "/bin" + _os.pathsep + "/usr/bin" if extra == "sys" else str(b),
 51103	           "HOME": str(tmp), "LUMOS_PYTHON_SEARCH_DIRS": str(tmp / "nowhere")}
 51104	    return env
 51105	
 51106	
 51107	def t_python_resolver_order_and_floor():
 51108	    """[S1] 找 3.14:固定順序、找到就停、只收實際印出 ≥3.14 的、改用它印的絕對路徑;LUMOS_PYTHON 有設就只認它
 51109	    (不是絕對路徑或不合格都停下報錯);uv 帶 --no-python-downloads;LUMOS_PYTHON_SEARCH_DIRS 換掉固定位置;
 51110	    驗法隔開標準輸入、單一候選有逾時(Projects/最低Python版本改3.14_計劃 做法第 1 點)。
 51111	
 51112	    翻紅釘:順序改掉 → ①紅;找到不停 → ②紅;LUMOS_PYTHON 不合格往下找 → ③④紅;uv 沒帶旗標 → ⑤紅;
 51113	    逾時拿掉 → ⑥卡住;python-path 不經 LUMOS_PYTHON → ⑦紅;說明丟掉不存在的候選 → ⑤紅;Windows 收目前目錄的檔 → ⑤b紅;
 51114	    擋整棵子樹或收相對路徑項 → ⑤c紅;uv 逾時說成找不到 → ⑤d紅;uv 出錯說成找不到 → ⑤e紅;
 51115	    位置用解析後的路徑比 → ⑤f紅。
 51116	    """
 51117	    print("t_python_resolver_order_and_floor")
 51118	    import os as _os, tempfile as _tf, time as _time, subprocess as _sp
 51119	    m = _load_lumos_inproc()
 51120	    saved = dict(_os.environ)
 51121	    tmp = Path(_tf.mkdtemp(prefix="gctl-py314-"))
 51122	    try:
 51123	        for k in ("LUMOS_PYTHON", "LUMOS_REEXEC_PYTHON"):
 51124	            _os.environ.pop(k, None)
 51125	        _os.environ["LUMOS_PYTHON_SEARCH_DIRS"] = str(tmp / "fixed")
 51126	        (tmp / "fixed").mkdir()
 51127	        names = [d for d, _a in m._py_candidates()]
 51128	        want = ["python3.14", "python3.15", "python3.16", str(tmp / "fixed" / "python3.14"), str(tmp / "fixed" / "python3.15"),
 51129	                str(tmp / "fixed" / "python3.16"), str(tmp / "fixed" / "python3")]
 51130	        check("①候選順序:版本號名稱 → 固定位置(可換) → uv → python3、python 最後",
 51131	              names[:7] == want and names[-3:] == ["uv python find", "python3", "python"], str(names))
 51132	        env = _py314_fake_env(tmp / "a", {"python3.14": "old", "python3.15": "good", "python3": "good"})
 51133	        _os.environ.update(env)
 51134	        path, tried = m._py_resolve()
 51135	        check("②找到第一個合格的就停,回它印出的絕對路徑", path == _os.path.realpath(sys.executable) or path == sys.executable,
 51136	              f"{path} {tried}")
 51137	        check("②跳過的舊版有寫出版本、合格之後的不再試", tried[0][0] == "python3.14" and "3.9.6" in tried[0][1]
 51138	              and not any(d == "python3" for d, _w in tried), str(tried))
 51139	        _os.environ["LUMOS_PYTHON"] = "bin/python3.15"
 51140	        path, tried = m._py_resolve()
 51141	        check("③LUMOS_PYTHON 不是絕對路徑:停下報錯,不往下找", path is None and len(tried) == 1 and "絕對路徑" in tried[0][1], str(tried))
 51142	        _os.environ["LUMOS_PYTHON"] = str(tmp / "a" / "bin" / "python3.14")
 51143	        path, tried = m._py_resolve()
 51144	        check("④LUMOS_PYTHON 指到舊版:停下報錯,不往下找", path is None and len(tried) == 1, str(tried))
 51145	        _os.environ.pop("LUMOS_PYTHON")
 51146	        env = _py314_fake_env(tmp / "b", {"python3": "old"})
 51147	        uvlog = tmp / "b" / "uv-args"
 51148	        (tmp / "b" / "bin" / "uv").write_text("#!/bin/sh\necho \"$@\" > %s\n"
 51149	                                              "echo 'error: No interpreter found for Python >=3.14 in managed installations or search path' >&2\n"
 51150	                                              "exit 2\n" % uvlog, encoding="utf-8")
