 51481	def t_hook_cmd_uses_running_python():
 51482	    """[S5] 註冊 Claude/Codex 掛鉤時寫入正在執行的那支直譯器、POSIX 加引號(路徑含空白照樣可執行);
 51483	    merge-claude-settings.py 被 3.14 以前的 Python 執行時改用 3.14 重跑自己,找不到報錯回 2、不寫設定
 51484	    (Projects/最低Python版本改3.14_計劃 做法第 4 點)。
 51485	    翻紅釘:改回 which("python3") → ①紅;引號拿掉 → ②紅;開頭檢查拿掉 → ③④紅。"""
 51486	    print("t_hook_cmd_uses_running_python")
 51487	    import os as _os, json as _j, shlex as _sx, tempfile as _tf, subprocess as _sp
 51488	    merge = Path(GRAPHCTL).resolve().parent / "merge-claude-settings.py"
 51489	    base = {k: v for k, v in _os.environ.items() if k not in ("LUMOS_PYTHON", "LUMOS_REEXEC_PYTHON")}
 51490	
 51491	    def cmds(home):
 51492	        f = Path(home) / ".claude" / "settings.json"
 51493	        if not f.exists():
 51494	            return []
 51495	        d = _j.loads(f.read_text(encoding="utf-8"))
 51496	        return [h["command"] for evs in d.get("hooks", {}).values() for e in evs for h in e.get("hooks", [])]
 51497	    h1 = Path(_tf.mkdtemp(prefix="gctl-s5a-"))
 51498	    r = _sp.run([sys.executable, str(merge)], capture_output=True, text=True, env=dict(base, HOME=str(h1)))
 51499	    c = cmds(h1)
 51500	    check("①寫入的是正在執行的那支直譯器", r.returncode == 0 and c and all(_sx.split(x)[0] == sys.executable for x in c),
 51501	          (c[:1] if c else []) + [r.stderr[-200:]])
 51502	    h2 = Path(_tf.mkdtemp(prefix="gctl-s5b-"))
 51503	    # 符號連結會被 Homebrew 的 Python 解析成真實路徑;venv 會保留自己的路徑,拿它造「sys.executable 含空白」
 51504	    venv = h2 / "my py" / "venv"
 51505	    _sp.run([sys.executable, "-m", "venv", "--without-pip", str(venv)], capture_output=True, check=True)
 51506	    spaced = venv / "bin" / "python3"
 51507	    r = _sp.run([str(spaced), str(merge)], capture_output=True, text=True, env=dict(base, HOME=str(h2)))
 51508	    c = cmds(h2)
 51509	    exe = _sx.split(c[0])[0] if c else ""
 51510	    run = _sp.run(["/bin/sh", "-c", c[0].split(" \"")[0] + " -c 'print(456)'"], capture_output=True, text=True) if c else None
 51511	    check("②路徑含空白:註冊的命令照樣可執行", " " in exe and run is not None and "456" in run.stdout,
 51512	          (c[:1] if c else []) + [r.stderr[-200:]])
 51513	    old = _py314_old_interpreter()
 51514	    if old is None:
 51515	        print("  (沒驗到③④:這台機器找不到 3.14 以前的直譯器)")
 51516	        return
 51517	    tmp = Path(_tf.mkdtemp(prefix="gctl-s5c-"))
 51518	    good = _py314_fake_env(tmp / "g", {"python3.14": "good"})
 51519	    h3 = tmp / "home3"
 51520	    h3.mkdir()
 51521	    r = _sp.run([old, str(merge)], capture_output=True, text=True, env=dict(dict(base, **good), HOME=str(h3)), timeout=180)
 51522	    c = cmds(h3)
 51523	    check("③舊版執行、找得到 3.14:改用 3.14 重跑,註冊寫成 3.14", r.returncode == 0 and c
 51524	          and all(_os.path.realpath(_sx.split(x)[0]) == _os.path.realpath(sys.executable) for x in c), r.stderr[-300:])
 51525	    none = _py314_fake_env(tmp / "n", {"python3": "old"})
 51526	    h4 = tmp / "home4"
 51527	    h4.mkdir()
 51528	    r = _sp.run([old, str(merge)], capture_output=True, text=True, env=dict(dict(base, **none), HOME=str(h4)), timeout=180)
 51529	    check("④舊版執行、找不到 3.14:回 2、不寫設定", r.returncode == 2 and not cmds(h4) and "沒寫任何設定" in r.stderr,
 51530	          r.stderr[-300:])
