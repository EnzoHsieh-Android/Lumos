    43	  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
    44	  _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
    45	  return 1
    46	}
    47	_LUMOS_NO_PY_BASE="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
    48	安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
    49	Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
    50	_LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
    51	# ── python-launcher end ──
    52	_lumos_any_python || { printf '%s\n' "$_LUMOS_NO_PY_MSG" >&2; exit 2; }
    53	# LUMOS_PYTHON 設了卻被略過、改用別支時現在就講:之後掛鉤問 lumos 會因同一個值擋下(代碼審 r3)
    54	if [ -n "$_LUMOS_ANY_NOTE" ]; then printf '%s' "$_LUMOS_ANY_NOTE" >&2; fi
    55	exec "$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$HERE/lumos" init --force "$@"
FILE scripts/hooks/pre-commit
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git pre-commit hook — 圖譜同步硬擋 (L2)
     7	#
     8	# 設計理由 (2026-05-25 從 PreToolUse 搬家):
     9	#   舊版 L2 在 Claude Code PreToolUse 攔 `git commit`,但 staged 區在 -a/-am
    10	#   flag 跟 `git commit <path>` 場景下 hook 看到的是空的 (因 -a 在 git 程序內
    11	#   部才 stage), 造成 silent 漏網。教 PreToolUse 解 git command 是追 git 尾巴
    12	#   永遠補不完,根因是「攔截點不對」。改放到 git pre-commit hook,git 內部
    13	#   已決定最終 staged 內容,所有 commit 形態(-a/-am/<path>/--amend)都涵蓋。
    14	#
    15	# Bypass: 用業界標準 `git commit --no-verify` (有儀式感、code review 看得到、
    16	#         比自製 `[no-graph]` marker 難被無意識濫用)
    17	#
    18	# 安裝:
    19	#   git config core.hooksPath scripts/hooks
    20	#   (一次設定,之後 git 自動跑此 hook)
    21	
    22	set -u
    23	
    24	# 找專案 root (避免在 submodule / worktree 出錯)
    25	REPO_ROOT="$(git rev-parse --show-toplevel)"
    26	cd "$REPO_ROOT" || exit 0
    27	
    28	# 找圖譜目錄 (docs/{slug}-knowledge/)
    29	GRAPH_ROOT=""
    30	if [[ -d docs ]]; then
    31	  for d in docs/*-knowledge; do
    32	    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
    33	  done
    34	  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
    35	fi
    36	
    37	# Gate 0: 圖譜不存在 → 放行
    38	[[ -z "$GRAPH_ROOT" ]] && exit 0
    39	
    40	# 拿最終 staged (git 在 pre-commit 時 staged 已確定,-a/-am/path 都涵蓋)
    41	# core.quotePath=off: 避免 git 對中文/non-ASCII 路徑加雙引號 ("docs/.../節點.md"),
    42	# 否則 L65 grep "^${GRAPH_ROOT}/..." 比對不到 → 圖譜檔已 staged 仍誤判為未同步擋下
    43	STAGED="$(git -c core.quotePath=off diff --cached --name-only)"
    44	[[ -z "$STAGED" ]] && exit 0  # 空 commit 不擋
    45	
    46	# Gate CC (advisory): co-change 漏改警告 —— 恆不影響 rc(|| true 隔離)。
    47	# 必須在 Gate 1 之前:後面每條路徑都顯式 exit,「末段」是不可達死碼;
    48	# docs-only commit 在 Gate 2 就 exit 0,唯有這裡能覆蓋主場景(改文件漏同步夥伴)。
    49	# 警告走 stdout(2>/dev/null 只吞診斷,含版本偏斜時舊 vendored lumos 的 argparse 錯)。
    50	# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
    51	# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
    52	# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
    53	# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
    54	# LUMOS_PYTHON 有設就先試它:找不到時的說明叫人設它,第一步就不能不認。只收絕對路徑、而且真的是 python
    55	# (post-commit 直接把程式交給它跑,不經 lumos 驗;設成 /usr/bin/true 會假成功、漏寫跳過帳);不合格就記下原因往下找,
    56	# 版本夠不夠仍由 lumos 判。
    57	_lumos_any_python() {
    58	  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""; _LUMOS_ANY_NOTE=""
    59	  if [ -n "${LUMOS_PYTHON:-}" ]; then
    60	    case "$LUMOS_PYTHON" in
    61	      /*|[A-Za-z]:[\\/]*)
    62	        if [ -x "$LUMOS_PYTHON" ] && [ "$("$LUMOS_PYTHON" -c 'print("LUMOS_PY_OK")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY_OK" ]; then
    63	          _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0
    64	        fi
    65	        _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不存在、不能執行或不是 python,略過。
    66	" ;;
    67	      *) _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不是絕對路徑,略過(相對路徑會隨目前目錄解析到別的檔)。
    68	" ;;
    69	    esac
    70	  fi
    71	  for _c in python3.14 python3.15 python3.16; do
    72	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
    73	  done
    74	  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
    75	    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
    76	  else
    77	    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
    78	  fi
    79	  _ifs="$IFS"; IFS=":"
    80	  for _d in $_dirs; do
    81	    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
    82	  done
    83	  IFS="$_ifs"
    84	  for _c in python3 python; do
    85	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
    86	  done
    87	  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
    88	  _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
    89	  return 1
    90	}
    91	_LUMOS_NO_PY_BASE="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
    92	安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
    93	Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
    94	_LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
    95	# ── python-launcher end ──
    96	# ── python-314 begin(pre-commit 與 pre-push 內嵌同一段):用上面找到的 python 問 lumos 要一支 3.14 的絕對路徑,
    97	# 之後這支掛鉤的呼叫都用它;找不到就讓會擋的閘擋下,★不退回舊版 Python 跑檢查★(Projects/最低Python版本改3.14_計劃 [S3])。
    98	_lumos_py314() {
    99	  LUMOS_PY=""; _LUMOS_PY_ERR=""
   100	  if ! _lumos_any_python; then _LUMOS_PY_ERR="$_LUMOS_NO_PY_MSG"; return 1; fi
   101	  _out=""
   102	  if _out="$("$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$REPO_ROOT/scripts/lumos" python-path 2>&1)"; then
   103	    LUMOS_PY="$(printf '%s\n' "$_out" | tail -n 1 | tr -d '\r')"
   104	    # 拿到的路徑要是絕對路徑、而且真的是 3.14 以上的 python 才用:後面每一道閘都由它跑,
   105	    # 叫 lumos 的那支是假的(PATH 上一支會印 /usr/bin/true 的 python3.14)時,閘會全部假放行(代碼審 r3 外家席)
   106	    case "$LUMOS_PY" in
   107	      /*|[A-Za-z]:[\\/]*)
   108	        if [ "$("$LUMOS_PY" -c 'import sys; print("LUMOS_PY314_OK" if sys.version_info >= (3, 14) else "OLD")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY314_OK" ]; then
   109	          return 0
   110	        fi ;;
   111	    esac
   112	    _out="$_out
   113	(lumos python-path 回的 $LUMOS_PY 不是絕對路徑、或執行起來不是 3.14 以上的 python)"
   114	    LUMOS_PY=""
   115	  fi
   116	  _LUMOS_PY_ERR="$_out
   117	(叫 lumos 用的是 $_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG};它一執行就失敗的話,可能是 Windows 商店替身)"
   118	  return 1
   119	}
   120	_lumos_block_no_py314() {
   121	  { echo ""; echo "擋下:這一道檢查要用 Python 3.14 跑 lumos,但找不到。"
   122	    printf '%s\n' "$_LUMOS_PY_ERR" | sed 's/^/   /'
   123	    echo "出口:裝 3.14,或設 LUMOS_PYTHON=<3.14 的絕對路徑>;真的要先過只能加 --no-verify(提交會記進跳過帳),不會改用舊版 Python 跑檢查。"
   124	    echo ""; } >&2
   125	}
   126	# ── python-314 end ──
   127	# CC_PY = 一支 3.14 的絕對路徑;有 scripts/lumos 卻找不到 3.14 時留空,只提醒的閘跳過、會擋的閘在 Gate PY 擋下
   128	CC_PY=""
   129	if [ -f "$REPO_ROOT/scripts/lumos" ] && _lumos_py314; then CC_PY="$LUMOS_PY"; fi
   130	if [ -n "$CC_PY" ]; then
   131	  "$CC_PY" "$REPO_ROOT/scripts/lumos" cochange check --staged 2>/dev/null || true
   132	else
   133	  echo "提醒:這台機器找不到 Python 3.14 或 scripts/lumos,所以「漏改夥伴檔」的提醒這次沒跑。" >&2
   134	fi
   135	
   136	# Gate DG: code 側刪除傳播守衛 (advisory;spec=Projects/code側刪除傳播守衛_計劃)
   137	# 警告走 stdout(2>/dev/null 只吞診斷);|| true 只兜 crash,hang 由 lumos 內部 deadline 兜(fail-open)
   138	# -f 必檢:沒有 scripts/lumos 的 repo(未 vendored)只有 CC_PY 也會跑,python 報「can't open file」
   139	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
   140	  "$CC_PY" "$REPO_ROOT/scripts/lumos" delguard --staged 2>/dev/null || true
   141	fi
   142	
   143	# Gate 1: 圖譜污染指紋 (2026-06-13 對抗審計 P0)
   144	# 攔 notesmd-cli `frontmatter --edit` 的副作用: 日期欄位加引號 (Obsidian property
   145	# 型別 date→text 靜默損傷,且通常伴隨整篇 frontmatter 鍵序重排)。
   146	# 必須放在 Gate 2 之前 — 污染 commit 是 docs-only,Gate 2 的 code 判定對它直接放行。
   147	if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
   148	  polluted="$(git -c core.quotePath=off diff --cached -- "$GRAPH_ROOT" \
   149	    | grep -E '^\+[[:space:]]*(date|created|updated|decided|ended):[[:space:]]*"[0-9]{4}-[0-9]{2}-[0-9]{2}"' || true)"
   150	  if [[ -n "$polluted" ]]; then
   151	    {
   152	      echo ""
   153	      echo "擋下:有筆記的日期欄位被加上了引號(例如 created: \"2026-08-21\")。"
   154	      echo "這幾乎都是某個編輯工具順手改的,不是人打的;它會讓日期欄位變成純文字,而且通常整篇欄位順序都被重排——這種 diff 沒辦法審。"
   155	      echo ""
   156	      echo "被改到的行:"
   157	      echo "$polluted" | head -5 | sed 's/^/   /'
   158	      echo ""
   159	      echo "看完整改動:"
   160	      echo "   git diff --cached -- ${GRAPH_ROOT}"
   161	      echo "還原那個檔:"
   162	      echo "   git checkout -- <檔案>"
   163	      echo "真的是刻意要這樣(非常少見)→ git commit --no-verify"
   164	      echo ""
   165	    } >&2
   166	    exit 1
   167	  fi
   168	fi
   169	
   170	# Gate PY: 下面 L/H/NS 三道會擋的檢查要用 3.14 跑 lumos;有 scripts/lumos 卻找不到 3.14 就在這裡擋下,
   171	# 不退回舊版 Python、也不像以前那樣整段跳過(Projects/最低Python版本改3.14_計劃 做法第 3 點)。
   172	if [[ -f "$REPO_ROOT/scripts/lumos" && -z "$CC_PY" ]]; then
   173	  _lumos_block_no_py314
   174	  exit 1
   175	fi
   176	
   177	# Gate L: staged 圖譜 .md 逐檔 lumos lint (2026-08-21 體檢 #6)
   178	# 為什麼:lint 自 2026-06 起沒有任何 hook/CI 呼叫,它的每條鐵則(YAML list/白名單/枚舉/frontmatter
   179	# 閉合)全靠人記得跑——「有機制,沒接線」。硬擋:lint rc≠0 即擋,訊息原樣轉出。
   180	# 只跑 staged 的圖譜檔(每檔 <1s),不跑全 vault。找不到 python/lumos → 跳過(與 Gate CC 同語意)。
FILE scripts/hooks/pre-push
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
     7	#
     8	# 為什麼需要:
     9	#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
    10	#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
    11	#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
    12	#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
    13	#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
    14	#
    15	# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
    16	#
    17	# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效
    18	
    19	set -u
    20	
    21	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
    22	cd "$REPO_ROOT" || exit 0
    23	
    24	# ── stdin 必須最先讀(prepush範圍修法 #1)──
    25	# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
    26	# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
    27	# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
    28	_PP_LINES=()
    29	while IFS= read -r _line; do
    30	  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
    31	done
    32	
    33	_ZERO="0000000000000000000000000000000000000000"
    34	_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"
    35	
    36	# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
    37	# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
    38	# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
    39	pp_range_for() {
    40	  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    41	    printf '%s..%s' "$_EMPTY_TREE" "$2"
    42	  else
    43	    printf '%s..%s' "$1" "$2"
    44	  fi
    45	}
    46	
    47	# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
    48	# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
    49	# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
    50	pp_touched_file() {
    51	  local _f _r
    52	  [[ -n "$_EMPTY_TREE" ]] || return 0
    53	  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
    54	  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
    55	  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
    56	  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
    57	  _f="$_PP_TMP/touched.txt"
    58	  : > "$_f" 2>/dev/null || return 0
    59	  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    60	    read -r _ _lsha _ _rsha <<< "$_ppl"
    61	    [[ "$_lsha" == "$_ZERO" ]] && continue
    62	    _r="$(pp_range_for "$_rsha" "$_lsha")"
    63	    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
    64	  done
    65	  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
    66	}
    67	
    68	# 沒有 scripts/lumos → 降級放行(不為缺環境 brick push,CI 兜底);有 lumos 卻找不到 Python 3.14 → 擋下
    69	# (Projects/最低Python版本改3.14_計劃 做法第 3 點;PY 在下面讀完設定後才決定)
    70	GRAPHCTL="$REPO_ROOT/scripts/lumos"
    71	PY=""
    72	# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
    73	# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
    74	# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
    75	# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
    76	# LUMOS_PYTHON 有設就先試它:找不到時的說明叫人設它,第一步就不能不認。只收絕對路徑、而且真的是 python
    77	# (post-commit 直接把程式交給它跑,不經 lumos 驗;設成 /usr/bin/true 會假成功、漏寫跳過帳);不合格就記下原因往下找,
    78	# 版本夠不夠仍由 lumos 判。
    79	_lumos_any_python() {
    80	  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""; _LUMOS_ANY_NOTE=""
    81	  if [ -n "${LUMOS_PYTHON:-}" ]; then
    82	    case "$LUMOS_PYTHON" in
    83	      /*|[A-Za-z]:[\\/]*)
    84	        if [ -x "$LUMOS_PYTHON" ] && [ "$("$LUMOS_PYTHON" -c 'print("LUMOS_PY_OK")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY_OK" ]; then
    85	          _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0
    86	        fi
    87	        _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不存在、不能執行或不是 python,略過。
    88	" ;;
    89	      *) _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不是絕對路徑,略過(相對路徑會隨目前目錄解析到別的檔)。
    90	" ;;
    91	    esac
    92	  fi
    93	  for _c in python3.14 python3.15 python3.16; do
    94	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
    95	  done
    96	  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
    97	    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
    98	  else
    99	    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
   100	  fi
   101	  _ifs="$IFS"; IFS=":"
   102	  for _d in $_dirs; do
   103	    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
   104	  done
   105	  IFS="$_ifs"
   106	  for _c in python3 python; do
   107	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
   108	  done
   109	  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
   110	  _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
   111	  return 1
   112	}
   113	_LUMOS_NO_PY_BASE="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
   114	安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
   115	Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
   116	_LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
   117	# ── python-launcher end ──
   118	# ── python-314 begin(pre-commit 與 pre-push 內嵌同一段):用上面找到的 python 問 lumos 要一支 3.14 的絕對路徑,
   119	# 之後這支掛鉤的呼叫都用它;找不到就讓會擋的閘擋下,★不退回舊版 Python 跑檢查★(Projects/最低Python版本改3.14_計劃 [S3])。
   120	_lumos_py314() {
   121	  LUMOS_PY=""; _LUMOS_PY_ERR=""
   122	  if ! _lumos_any_python; then _LUMOS_PY_ERR="$_LUMOS_NO_PY_MSG"; return 1; fi
   123	  _out=""
   124	  if _out="$("$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$REPO_ROOT/scripts/lumos" python-path 2>&1)"; then
   125	    LUMOS_PY="$(printf '%s\n' "$_out" | tail -n 1 | tr -d '\r')"
   126	    # 拿到的路徑要是絕對路徑、而且真的是 3.14 以上的 python 才用:後面每一道閘都由它跑,
   127	    # 叫 lumos 的那支是假的(PATH 上一支會印 /usr/bin/true 的 python3.14)時,閘會全部假放行(代碼審 r3 外家席)
   128	    case "$LUMOS_PY" in
   129	      /*|[A-Za-z]:[\\/]*)
   130	        if [ "$("$LUMOS_PY" -c 'import sys; print("LUMOS_PY314_OK" if sys.version_info >= (3, 14) else "OLD")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY314_OK" ]; then
   131	          return 0
   132	        fi ;;
   133	    esac
   134	    _out="$_out
   135	(lumos python-path 回的 $LUMOS_PY 不是絕對路徑、或執行起來不是 3.14 以上的 python)"
   136	    LUMOS_PY=""
   137	  fi
   138	  _LUMOS_PY_ERR="$_out
   139	(叫 lumos 用的是 $_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG};它一執行就失敗的話,可能是 Windows 商店替身)"
   140	  return 1
   141	}
   142	_lumos_block_no_py314() {
   143	  { echo ""; echo "擋下:這一道檢查要用 Python 3.14 跑 lumos,但找不到。"
   144	    printf '%s\n' "$_LUMOS_PY_ERR" | sed 's/^/   /'
   145	    echo "出口:裝 3.14,或設 LUMOS_PYTHON=<3.14 的絕對路徑>;真的要先過只能加 --no-verify(提交會記進跳過帳),不會改用舊版 Python 跑檢查。"
   146	    echo ""; } >&2
   147	}
   148	# ── python-314 end ──
   149	
   150	# ── 波及計算(給合約測試閘用):這裡只呼叫、不碰內容。
   151	# ★一次推送只算一次波及★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):以前同步點名與合約測試閘各自呼叫,
   152	# 等於一次推送算兩次——這不是便宜的計算。算一次寫進暫存檔給消費者讀。
   153	# (2026-09-11 起同步點名改由每支檔有家照家算,不再讀這一份;見下面 sync_nudge 原位置的說明。)
   154	# ★失敗隔離★:算不出來 → 暫存檔不存在或是空的 → 合約測試閘記一筆帳放行,不拖垮別的檢查。
   155	_IMPACT_JSON=""
   156	impact_once() {   # $1=diff range;算一次,結果放進 $_IMPACT_JSON
   157	  _IMPACT_JSON=""
   158	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
   159	  # ★用同檔既有的樣板寫法與命名家族★(代碼審 r1 架構對齊席):
   160	  # 同一支腳本下面幾行就有 lumos-prepush-autoloop-XXXXXX / lumos-prepush-tests-XXXXXX,
   161	  # 而且旁邊的註解特別說明過「★XXXXXX 必須在結尾★」是踩過才定下來的。
   162	  local _f; _f="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-impact-XXXXXX" 2>/dev/null || true)"
   163	  [ -n "$_f" ] || return 0
   164	  if "$PY" "$GRAPHCTL" impact --diff "$1" --sync-check --json --repo "$REPO_ROOT" > "$_f" 2>/dev/null \
   165	     && [ -s "$_f" ]; then
   166	    _IMPACT_JSON="$_f"
   167	  else
   168	    rm -f "$_f"
   169	  fi
   170	}
   171	impact_done() { [ -n "$_IMPACT_JSON" ] && rm -f "$_IMPACT_JSON"; _IMPACT_JSON=""; }
   172	# ★硬擋或收到訊號時也要清★(代碼審 r1 外家否決席判 minor,屬實):
   173	# 上面那支只在 ref 迴圈正常跑到尾端時執行。高風險那條路 rc1 會直接 exit 1,
   174	# 收到訊號也一樣——每被硬擋一次就留一個暫存檔在 $TMPDIR 裡慢慢累積。
   175	# 本次推送所有暫存檔的家,離開時整個清(r1 併發席:逐檔 rm 在 exit 1 / Ctrl-C 那條路會漏)。
   176	# 建不出來就擋(r2 邊界席):空字串會讓後面每個 "$_PP_TMP/…" 變成根目錄路徑,測試 log 全寫不出來、擋下訊息一片空白。
   177	_PP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/lumos-prepush-XXXXXX" 2>/dev/null || true)"
   178	if [[ -z "$_PP_TMP" || ! -d "$_PP_TMP" ]]; then
   179	  echo "擋下:推送前檢查需要一個暫存目錄,但 ${TMPDIR:-/tmp} 建不出來(不存在或不可寫);修好 TMPDIR 再推。" >&2
   180	  exit 1
FILE scripts/hooks/post-commit
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git post-commit hook — bypass 留痕 (L2 的觀測面)
     7	#
     8	# 設計理由 (2026-06-10, 治理調研 gap「逃生口與警告忽略皆無留痕」):
     9	#   L2 pre-commit 硬擋有合法後門 `--no-verify`,但走後門零痕跡——bypass 率
    10	#   是「不更新圖譜比更新圖譜更難」這個核心宣稱唯一沒被量測的數字。
    11	#   關鍵事實:--no-verify 只跳過 pre-commit / commit-msg,post-commit 永遠會跑,
    12	#   所以本 hook 是天然的偵測點:凡「有 code 異動但無圖譜 .md」的 commit 能落地,
    13	#   必然繞過了 L2 → append 結構化事件到 docs/.bypass-log.jsonl。
    14	#
    15	#   只記錄、不阻擋、不問理由——bypass 本來就是被認可的逃生口,這裡要的是
    16	#   「率」不是「罪」;weekly 由 `lumos gov --since 7` 顯示 bypass 率(原寫 rot-queue-digest.sh,從未存在,2026-08-21 更正)。
    17	#   (L1 警告被忽略的最終結果就是一筆 bypass commit,同一個訊號,不另外追蹤)
    18	#
    19	# 判定邏輯與 scripts/hooks/pre-commit 完全對齊 (CODE_EXTS_RE / 排除規則 /
    20	# GRAPH_ROOT 偵測),兩邊認定不一致會產生幽靈 bypass 或漏記。
    21	
    22	set -u
    23	
    24	# post-commit 絕不能影響 commit 結果:任何錯誤都靜默結束
    25	trap 'exit 0' ERR
    26	
    27	REPO_ROOT="$(git rev-parse --show-toplevel)"
    28	cd "$REPO_ROOT" || exit 0
    29	
    30	# 找圖譜目錄 (對齊 pre-commit)
    31	GRAPH_ROOT=""
    32	if [[ -d docs ]]; then
    33	  for d in docs/*-knowledge; do
    34	    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
    35	  done
    36	  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
    37	fi
    38	[[ -z "$GRAPH_ROOT" ]] && exit 0
    39	
    40	# merge commit 不適用 bypass 概念 (內容來自既有 commit) → 跳過
    41	if [[ "$(git rev-list --parents -n 1 HEAD | wc -w)" -gt 2 ]]; then
    42	  exit 0
    43	fi
    44	
    45	# 本次 commit 的檔案清單 (quotePath=off 對齊 pre-commit 的中文路徑處理)
    46	CHANGED="$(git -c core.quotePath=off diff-tree --no-commit-id --name-only -r HEAD)"
    47	[[ -z "$CHANGED" ]] && exit 0
    48	
    49	# code 副檔名與排除規則 (對齊 pre-commit / check-graph-sync.py CODE_EXTS)
    50	CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp|sh|ps1)$'  # sh/ps1 2026-08-21 補(體檢 #7);各份清單由 t_code_exts_lists_agree 釘
    51	
    52	is_shebang_code() {   # 沒副檔名的檔:看 剛 commit 的 內容首行是不是 #!(2026-09-05 README 審視 d1:scripts/lumos 這種主程式五月起 26 次漏過)
    53	  local path="$1" base
    54	  # git 對含 " \ 或控制字元的檔名會印成 C 式引號("a\"b");拿去 git show 會找不到 → 先解引號(r2 delta major)
    55	  if [[ "$path" == \"*\" && ${#path} -ge 2 ]]; then   # 長度守衛:單一個引號的假輸入不做子字串(r3 delta minor,set -u 下會吐錯)
    56	    path="${path:1:${#path}-2}"; path="${path//\\\"/\"}"; path="$(printf '%b' "$path")"   # \" 手解;\\ \t \ooo(控制字元)交給 printf %b(r3 外家:八進位沒解 → 找不到 → 放行)
    57	  fi
    58	  base="${path##*/}"; base="${base#"${base%%[!.]*}"}"; [[ "$base" == *.* ]] && return 1   # 去掉所有開頭的點再看有沒有副檔名(.pythonrc、..foo 也要看 shebang)
    59	  local first; first="$(git show "HEAD:$path" 2>/dev/null | head -c 200 | head -n 1)" || return 1
    60	  [[ "$first" == "#!"* ]]   # 任何 shebang 都算(不列直譯器清單:r1 外家 #!/bin/dash 漏判;各處同一條規則,由 t_code_exts_lists_agree 釘)
    61	}
    62	should_exclude() {
    63	  local path="$1"
    64	  case "$path" in
    65	    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
    66	    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
    67	    # vendored 工具白名單+源 repo 守門(與 pre-commit 完全對齊,2026-07-25):例行 lumos update
    68	    # 的 vendored .py 不該進 bypass 帳(pre-commit 已放行,這裡再記=假 bypass 灌水稀釋真訊號)。
    69	    scripts/lumos|scripts/test_lumos.py|scripts/merge-claude-settings.py|scripts/graph-rename.sh|scripts/fetch-notesmd.sh|scripts/hooks/*|scripts/templates/*)
    70	      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
    71	      return 0;;
    72	  esac
    73	  return 1
    74	}
    75	
    76	src_files=()
    77	while IFS= read -r f; do
    78	  [[ -z "$f" ]] && continue
    79	  if ! [[ "$f" =~ $CODE_EXTS_RE ]] && ! is_shebang_code "$f"; then continue; fi
    80	  if should_exclude "$f"; then continue; fi
    81	  src_files+=("$f")
    82	done <<< "$CHANGED"
    83	
    84	# 沒 code → 本來就會被 pre-commit 放行,不是 bypass
    85	[[ ${#src_files[@]} -eq 0 ]] && exit 0
    86	
    87	# 有圖譜 .md 一起 commit → 正常通過 L2,不是 bypass
    88	if echo "$CHANGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
    89	  exit 0
    90	fi
    91	
    92	# ── 走到這裡 = 這筆 commit 繞過了 L2 → 留痕 ──
    93	BYPASS_LOG="$REPO_ROOT/docs/.bypass-log.jsonl"
    94	
    95	# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
    96	# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
    97	# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
    98	# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
    99	# LUMOS_PYTHON 有設就先試它:找不到時的說明叫人設它,第一步就不能不認。只收絕對路徑、而且真的是 python
   100	# (post-commit 直接把程式交給它跑,不經 lumos 驗;設成 /usr/bin/true 會假成功、漏寫跳過帳);不合格就記下原因往下找,
   101	# 版本夠不夠仍由 lumos 判。
   102	_lumos_any_python() {
   103	  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""; _LUMOS_ANY_NOTE=""
   104	  if [ -n "${LUMOS_PYTHON:-}" ]; then
   105	    case "$LUMOS_PYTHON" in
   106	      /*|[A-Za-z]:[\\/]*)
   107	        if [ -x "$LUMOS_PYTHON" ] && [ "$("$LUMOS_PYTHON" -c 'print("LUMOS_PY_OK")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY_OK" ]; then
   108	          _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0
   109	        fi
   110	        _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不存在、不能執行或不是 python,略過。
   111	" ;;
   112	      *) _LUMOS_ANY_NOTE="LUMOS_PYTHON=$LUMOS_PYTHON 不是絕對路徑,略過(相對路徑會隨目前目錄解析到別的檔)。
   113	" ;;
   114	    esac
   115	  fi
   116	  for _c in python3.14 python3.15 python3.16; do
   117	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
   118	  done
   119	  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
   120	    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
   121	  else
   122	    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
   123	  fi
   124	  _ifs="$IFS"; IFS=":"
   125	  for _d in $_dirs; do
   126	    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
   127	  done
   128	  IFS="$_ifs"
   129	  for _c in python3 python; do
   130	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
   131	  done
   132	  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
   133	  _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
   134	  return 1
   135	}
   136	_LUMOS_NO_PY_BASE="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
   137	安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
   138	Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
   139	_LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
   140	# ── python-launcher end ──
   141	# 寫跳過帳★不設版本下限★:沒有 3.14 的機器正是最常用 --no-verify 的機器,這筆帳不能因為下限寫不進去
   142	_lumos_any_python || exit 0
   143	COMMIT_HASH="$(git rev-parse --short HEAD)" \
   144	BRANCH="$(git branch --show-current)" \
   145	SUBJECT="$(git log -1 --format=%s)" \
   146	SRC_COUNT="${#src_files[@]}" \
   147	SRC_SAMPLE="$(printf '%s\n' "${src_files[@]:0:10}")" \
   148	"$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} - "$BYPASS_LOG" <<'PYEOF'
   149	import json, os, sys
   150	from datetime import datetime, timezone
   151	
   152	entry = {
   153	    "ts": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
   154	    "commit": os.environ["COMMIT_HASH"],
   155	    "branch": os.environ["BRANCH"],
   156	    "subject": os.environ["SUBJECT"],
   157	    "code_file_count": int(os.environ["SRC_COUNT"]),
   158	    "code_files": os.environ["SRC_SAMPLE"].splitlines(),
   159	}
   160	with open(sys.argv[1], "a", encoding="utf-8") as f:
   161	    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
   162	PYEOF
   163	
   164	{
