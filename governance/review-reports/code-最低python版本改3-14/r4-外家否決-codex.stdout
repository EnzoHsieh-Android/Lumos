 51325	def _py314_hook_repo(tmp, with_lumos=True):
 51326	    import subprocess as _sp, shutil as _sh
 51327	    root = tmp / "repo"
 51328	    _sp.run(["git", "init", "-q", str(root)], check=True, capture_output=True)
 51329	    _sp.run(["git", "-C", str(root), "config", "user.email", "t@t"], capture_output=True)
 51330	    _sp.run(["git", "-C", str(root), "config", "user.name", "t"], capture_output=True)
 51331	    (root / "docs" / "x-knowledge").mkdir(parents=True)
 51332	    (root / "docs" / "x-knowledge" / "notes.txt").write_text("x\n", encoding="utf-8")
 51333	    if with_lumos:
 51334	        (root / "scripts").mkdir()
 51335	        _sh.copy2(GRAPHCTL, root / "scripts" / "lumos")
 51336	    _sp.run(["git", "-C", str(root), "add", "-A"], capture_output=True)
 51337	    _sp.run(["git", "-C", str(root), "commit", "-qm", "base", "--no-verify"], capture_output=True)   # 先有一版:掛鉤只看這次改的
 51338	    (root / "docs" / "x-knowledge" / "staged.txt").write_text("y\n", encoding="utf-8")
 51339	    _sp.run(["git", "-C", str(root), "add", "-A"], capture_output=True)
 51340	    return root
