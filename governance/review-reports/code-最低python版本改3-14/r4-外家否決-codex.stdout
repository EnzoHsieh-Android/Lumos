 # python直譯器選擇
 
diff --git a/get.sh b/get.sh
index fdd0afd8..b8bbf4fb 100755
--- a/get.sh
+++ b/get.sh
@@ -83,17 +83,19 @@ main() {
     # 用分支不用 tag,是因為 tag 會進 detached HEAD,之後 git pull / lumos update 全部靜默停住。
     if ! git clone --branch "$LUMOS_BRANCH" "$LUMOS_URL" "$LUMOS_HOME" 2>/dev/null; then
       echo "  提醒:抓不到 $LUMOS_BRANCH 這條對外線(分支還沒開、或名字改了),改用預設分支。" >&2
       echo "  這代表你拿到的是開發線的內容,可能還沒發布過。" >&2
       git clone "$LUMOS_URL" "$LUMOS_HOME"
     fi
   fi
 
   # 其餘全交 bootstrap(機器層 install+skills、專案層四分流;set -e 保錯誤傳播)
   _lumos_any_python || { printf '%s\n' "$_LUMOS_NO_PY_MSG" >&2; exit 2; }
+  # LUMOS_PYTHON 設了卻被略過、改用別支時現在就講:之後掛鉤問 lumos 會因同一個值擋下(代碼審 r3)
+  if [ -n "$_LUMOS_ANY_NOTE" ]; then printf '%s' "$_LUMOS_ANY_NOTE" >&2; fi
   LUMOS_HOME="$LUMOS_HOME" "$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$LUMOS_HOME/scripts/lumos" bootstrap ${ARGS[@]+"${ARGS[@]}"}
 
   echo
   echo "✓ 完成。最後一步:**重啟 Claude Code session**(hooks 在 session start 載入)"
 }
 
 main "$@"; exit
diff --git a/install.sh b/install.sh
index 08cf9deb..d766b292 100755
--- a/install.sh
+++ b/install.sh
@@ -42,11 +42,13 @@ _lumos_any_python() {
   if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
   _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
   return 1
 }
 _LUMOS_NO_PY_BASE="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
 安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
 Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
 _LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
 # ── python-launcher end ──
 _lumos_any_python || { printf '%s\n' "$_LUMOS_NO_PY_MSG" >&2; exit 2; }
+# LUMOS_PYTHON 設了卻被略過、改用別支時現在就講:之後掛鉤問 lumos 會因同一個值擋下(代碼審 r3)
+if [ -n "$_LUMOS_ANY_NOTE" ]; then printf '%s' "$_LUMOS_ANY_NOTE" >&2; fi
 exec "$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$(cd "$(dirname "$0")" && pwd)/scripts/lumos" install --force "$@"
diff --git a/scripts/hooks/pre-commit b/scripts/hooks/pre-commit
index 20ac13a5..5775d81e 100755
--- a/scripts/hooks/pre-commit
+++ b/scripts/hooks/pre-commit
@@ -94,21 +94,31 @@ Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝
 _LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
 # ── python-launcher end ──
 # ── python-314 begin(pre-commit 與 pre-push 內嵌同一段):用上面找到的 python 問 lumos 要一支 3.14 的絕對路徑,
 # 之後這支掛鉤的呼叫都用它;找不到就讓會擋的閘擋下,★不退回舊版 Python 跑檢查★(Projects/最低Python版本改3.14_計劃 [S3])。
 _lumos_py314() {
   LUMOS_PY=""; _LUMOS_PY_ERR=""
   if ! _lumos_any_python; then _LUMOS_PY_ERR="$_LUMOS_NO_PY_MSG"; return 1; fi
   _out=""
   if _out="$("$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$REPO_ROOT/scripts/lumos" python-path 2>&1)"; then
     LUMOS_PY="$(printf '%s\n' "$_out" | tail -n 1 | tr -d '\r')"
-    if [ -n "$LUMOS_PY" ]; then return 0; fi
+    # 拿到的路徑要是絕對路徑、而且真的是 3.14 以上的 python 才用:後面每一道閘都由它跑,
+    # 叫 lumos 的那支是假的(PATH 上一支會印 /usr/bin/true 的 python3.14)時,閘會全部假放行(代碼審 r3 外家席)
+    case "$LUMOS_PY" in
+      /*|[A-Za-z]:[\\/]*)
+        if [ "$("$LUMOS_PY" -c 'import sys; print("LUMOS_PY314_OK" if sys.version_info >= (3, 14) else "OLD")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY314_OK" ]; then
+          return 0
+        fi ;;
+    esac
+    _out="$_out
+(lumos python-path 回的 $LUMOS_PY 不是絕對路徑、或執行起來不是 3.14 以上的 python)"
+    LUMOS_PY=""
   fi
   _LUMOS_PY_ERR="$_out
 (叫 lumos 用的是 $_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG};它一執行就失敗的話,可能是 Windows 商店替身)"
   return 1
 }
 _lumos_block_no_py314() {
   { echo ""; echo "擋下:這一道檢查要用 Python 3.14 跑 lumos,但找不到。"
     printf '%s\n' "$_LUMOS_PY_ERR" | sed 's/^/   /'
     echo "出口:裝 3.14,或設 LUMOS_PYTHON=<3.14 的絕對路徑>;真的要先過只能加 --no-verify(提交會記進跳過帳),不會改用舊版 Python 跑檢查。"
     echo ""; } >&2
