 19983	            if (cand / ".git").exists():
 19984	                root = cand
 19985	                break
 19986	        else:
 19987	            root = Path.cwd()
 19988	    home = Path(home) if home else Path.home()
 19989	    rows = []
 19990	
 19991	    def add(layer, status, detail=""):
 19992	        rows.append({"layer": layer, "status": status, "detail": detail})
 19993	
 19994	    # ①②③ 全域 Claude hooks 註冊(讀 ~/.claude/settings.json)
 19995	    reg = {}
 19996	    try:
 19997	        sp = home / ".claude" / "settings.json"
 19998	        if sp.exists():
 19999	            d = _json.loads(sp.read_text(encoding="utf-8"))
 20000	            for ev, arr in (d.get("hooks") or {}).items():
 20001	                for grp in arr:
 20002	                    for hk in (grp.get("hooks") or []):
 20003	                        reg[str(hk.get("command", ""))] = True
 20004	    except Exception as e:
 20005	        reg = None  # 讀不到 settings → 三 hook 皆 unknown
 20006	    # ★r1 審:註冊了不等於生效★——還要目標 .py 真的在 ~/.claude/hooks/(懸空註冊是 _prune_dangling 存在的原因,
 20007	    # 2026-07-07 事故)。★r1 審:_GLOBAL_CLAUDE_HOOKS 有 4 支,原本漏檢 ci-status(CI 紅燈後備網)★。
 20008	    hookdir = home / ".claude" / "hooks"
 20009	    for layer, needle in (("session-entry-hook", "lumos-entry-hook.py"),
 20010	                          ("pretooluse-impact-hook", "impact-hook.py"),
 20011	                          ("stop-graph-sync-hook", "check-graph-sync.py"),
 20012	                          ("sessionstart-ci-status-hook", "ci-status-hook.py"),
 20013	                          ("pretooluse-dispatch-lens-hook", "dispatch-lens-hook.py"),
 20014	                          # ★這份清單是寫死列舉的,加 hook 一定要回來加一行★
 20015	                          # (2026-09-14 代碼審 r1 架構對齊席 major:記憶清掃那支漏登記,
 20016	                          #  於是它逾時、出錯、靜默失效,整個工具鏈都不會有任何感知)
 20017	                          ("sessionstart-memory-sweep", "memory-sweep.py")):
 20018	        if reg is None:
 20019	            add(layer, "unknown", "~/.claude/settings.json 讀不到")
 20020	            continue
 20021	        registered = any(needle in cmd for cmd in reg)
 20022	        file_ok = (hookdir / needle).exists()
 20023	        if registered and file_ok:
 20024	            # ★生效 ≠ 有註冊★(#19 S4):還要「現在的這個版本最近真的成功跑完過」。
 20025	            # 沒有近期成功不標 inactive——那可能只是七天內沒被觸發。
 20026	            _lv, _why = _hook_recent_ok(root, layer, hookdir / needle)
 20027	            if _lv == "ok":
 20028	                add(layer, "active", f"{needle};{_why}")
 20029	            else:
