    54	if [ -n "$_LUMOS_ANY_NOTE" ]; then printf '%s' "$_LUMOS_ANY_NOTE" >&2; fi
    55	TARGET=""; SLUG=""
    56	while [[ $# -gt 0 ]]; do
    57	  case "$1" in
    58	    --target) TARGET="${2:-}"; shift 2 ;;
    59	    --slug)   SLUG="${2:-}"; shift 2 ;;
    60	    --no-hooks|--no-scaffold|--dry-run) shift ;;
    61	    *) shift ;;
    62	  esac
    63	done
    64	cd "${TARGET:-.}"
