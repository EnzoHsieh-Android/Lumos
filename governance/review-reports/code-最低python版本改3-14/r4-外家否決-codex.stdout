   239	        return
   240	    prev = os.environ.get("LUMOS_REEXEC_PYTHON")
   241	    if prev and os.path.realpath(prev) == os.path.realpath(sys.executable):
   242	        sys.stderr.write("擋下:已經用 %s 重跑過,它回報的版本仍是 %d.%d——那支不是真的 3.14(包裝腳本?)。\n"
   243	                         % (prev, *sys.version_info[:2]) + _PY_INSTALL_HINT)
   244	        sys.exit(2)
   245	    path, tried = _py_resolve()
