 51623	def t_lumos_parses_under_old_grammar():
 51624	    """[S7] scripts/lumos、merge-claude-settings.py、scripts/hooks/claude/*.py 仍要能被 3.9 語法解析:ruff(py39)查語法錯誤、
 51625	    先用一行 3.12 才合法的樣本證明 ruff 真的會報;找得到真的舊版直譯器就實際編譯;兩者都沒有就明說沒驗到。
 51626	    另外守版本檢查之前的 import 只用 3.9 就有的模組(翻紅釘:檔頭加 import tomllib → 最後一格紅)。"""
 51627	    print("t_lumos_parses_under_old_grammar")
 51628	    import shutil as _sh, subprocess as _sp, tempfile as _tf, glob as _g
 51629	    repo = Path(GRAPHCTL).resolve().parent.parent
 51630	    files = [str(repo / "scripts" / "lumos"), str(repo / "scripts" / "merge-claude-settings.py")] + \
 51631	        sorted(_g.glob(str(repo / "scripts" / "hooks" / "claude" / "*.py")))
 51632	    verified = False
 51633	    ruff = _sh.which("ruff")
 51634	    if ruff:
 51635	        tmp = Path(_tf.mkdtemp(prefix="gctl-s7-"))
 51636	        sample = tmp / "pep701.py"
 51637	        sample.write_text('d = {"a": 1}\nx = f"{d["a"]}"\n', encoding="utf-8")
 51638	        r0 = _sp.run([ruff, "check", "--isolated", "--target-version", "py39", "--select", "E9", str(sample)],
 51639	                     capture_output=True, text=True)
 51640	        check("ruff 對 3.12 才合法的 f-string 樣本真的會報(守衛不是空的)", r0.returncode != 0, r0.stdout[-200:])
 51641	        r = _sp.run([ruff, "check", "--isolated", "--target-version", "py39", "--select", "E9", *files],
 51642	                    capture_output=True, text=True)
 51643	        check("ruff(py39):三類檔沒有 3.9 解析不了的語法", r.returncode == 0, r.stdout[-400:])
 51644	        verified = True
 51645	    old = _py314_old_interpreter()
 51646	    if old:
 51647	        ver = _sp.run([old, "-c", "import sys;print(sys.version_info[:2] < (3, 12))"], capture_output=True, text=True).stdout.strip()
 51648	        r = _sp.run([old, "-c", "import sys\nfor f in sys.argv[1:]:\n    compile(open(f, encoding='utf-8').read(), f, 'exec')\nprint('OK')",
 51649	                     *files], capture_output=True, text=True)
