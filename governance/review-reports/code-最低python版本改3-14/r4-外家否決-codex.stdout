diff --git a/scripts/install-graph-toolchain.sh b/scripts/install-graph-toolchain.sh
index 99634276..4d3d03a3 100755
--- a/scripts/install-graph-toolchain.sh
+++ b/scripts/install-graph-toolchain.sh
@@ -43,20 +43,22 @@ _lumos_any_python() {
   if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
   _LUMOS_NO_PY_MSG="$_LUMOS_ANY_NOTE$_LUMOS_NO_PY_BASE"
   return 1
 }
 _LUMOS_NO_PY_BASE="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
 安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
 Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
 _LUMOS_NO_PY_MSG="$_LUMOS_NO_PY_BASE"
 # ── python-launcher end ──
 _lumos_any_python || { printf '%s\n' "$_LUMOS_NO_PY_MSG" >&2; exit 2; }
+# LUMOS_PYTHON 設了卻被略過、改用別支時現在就講:之後掛鉤問 lumos 會因同一個值擋下(代碼審 r3)
+if [ -n "$_LUMOS_ANY_NOTE" ]; then printf '%s' "$_LUMOS_ANY_NOTE" >&2; fi
 TARGET=""; SLUG=""
 while [[ $# -gt 0 ]]; do
   case "$1" in
     --target) TARGET="${2:-}"; shift 2 ;;
     --slug)   SLUG="${2:-}"; shift 2 ;;
     --no-hooks|--no-scaffold|--dry-run) shift ;;
     *) shift ;;
   esac
 done
 cd "${TARGET:-.}"
diff --git a/scripts/install-hooks.sh b/scripts/install-hooks.sh
