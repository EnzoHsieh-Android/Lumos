     LUMOS_PY="$(printf '%s\n' "$_out" | tail -n 1 | tr -d '\r')"
-    if [ -n "$LUMOS_PY" ]; then return 0; fi
+    # 拿到的路徑要是絕對路徑、而且真的是 3.14 以上的 python 才用:後面每一道閘都由它跑,
+    # 叫 lumos 的那支是假的(PATH 上一支會印 /usr/bin/true 的 python3.14)時,閘會全部假放行(代碼審 r3 外家席)
+    case "$LUMOS_PY" in
+      /*|[A-Za-z]:[\\/]*)
+        if [ "$("$LUMOS_PY" -c 'import sys; print("LUMOS_PY314_OK" if sys.version_info >= (3, 14) else "OLD")' 2>/dev/null | tr -d '\r')" = "LUMOS_PY314_OK" ]; then
+          return 0
+        fi ;;
+    esac
+    _out="$_out
+(lumos python-path 回的 $LUMOS_PY 不是絕對路徑、或執行起來不是 3.14 以上的 python)"
+    LUMOS_PY=""
   fi
   _LUMOS_PY_ERR="$_out
 (叫 lumos 用的是 $_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG};它一執行就失敗的話,可能是 Windows 商店替身)"
   return 1
 }
 _lumos_block_no_py314() {
   { echo ""; echo "擋下:這一道檢查要用 Python 3.14 跑 lumos,但找不到。"
     printf '%s\n' "$_LUMOS_PY_ERR" | sed 's/^/   /'
     echo "出口:裝 3.14,或設 LUMOS_PYTHON=<3.14 的絕對路徑>;真的要先過只能加 --no-verify(提交會記進跳過帳),不會改用舊版 Python 跑檢查。"
