 51426	def t_python_launcher_blocks_agree():
 51427	    """三支 git 掛鉤與四支安裝腳本內嵌的「找任何 python」段逐字一致;pre-commit 與 pre-push 的「問 lumos 要 3.14」段一致;
 51428	    shell 那份的版本號名稱、預設固定目錄、最後兩個名字,跟 lumos 內部清單(_py_candidates、_py_fixed_candidates)逐項相同
 51429	    (Projects/最低Python版本改3.14_計劃 做法第 1、3、5 點)。
 51430	    翻紅釘:改 lumos 的版本號名稱順序或固定目錄 → ⑧紅(代碼審 r1:第一版只互比 shell 七份,沒讀 lumos 那份)。"""
 51431	    print("t_python_launcher_blocks_agree")
 51432	    repo = Path(GRAPHCTL).resolve().parent.parent
 51433	    files = ["scripts/hooks/pre-commit", "scripts/hooks/pre-push", "scripts/hooks/post-commit", "install.sh", "get.sh",
 51434	             "scripts/install-hooks.sh", "scripts/install-graph-toolchain.sh"]
 51435	
 51436	    def block(rel, begin, end):
 51437	        s = (repo / rel).read_text(encoding="utf-8")
 51438	        return s[s.index(begin):s.index(end)] if begin in s and end in s else None
 51439	    blks = {f: block(f, "# ── python-launcher begin", "# ── python-launcher end ──") for f in files}
 51440	    check("七支腳本都有內嵌段", all(v is not None for v in blks.values()), str([f for f, v in blks.items() if v is None]))
 51441	    ref = blks["scripts/hooks/pre-commit"]
 51442	    check("七份內嵌段逐字一致", all(v == ref for v in blks.values() if v is not None),
 51443	          str([f for f, v in blks.items() if v is not None and v != ref]))
 51444	    r1 = block("scripts/hooks/pre-commit", "# ── python-314 begin", "# ── python-314 end ──")
 51445	    r2 = block("scripts/hooks/pre-push", "# ── python-314 begin", "# ── python-314 end ──")
 51446	    check("pre-commit 與 pre-push 的「問 lumos 要 3.14」段一致", r1 is not None and r1 == r2, "")
 51447	    ref = ref or ""
 51448	    order = [ref.find(t) for t in ("python3.14 python3.15 python3.16", "/opt/homebrew/bin", "python3 python", "command -v py ")]
 51449	    check("內嵌段的順序:版本號名稱 → 固定位置 → python3、python → py", all(x >= 0 for x in order) and order == sorted(order),
 51450	          str(order))
 51451	    import os as _os, re as _re
 51452	    m = _load_lumos_inproc()
 51453	    saved = {k: _os.environ.get(k) for k in ("LUMOS_PYTHON_SEARCH_DIRS", "HOME")}
 51454	    try:
 51455	        _os.environ.pop("LUMOS_PYTHON_SEARCH_DIRS", None)
 51456	        _os.environ["HOME"] = "/lumos-home"
 51457	        cands = [d for d, _a in m._py_candidates()]
 51458	        fixed = m._py_fixed_candidates()
 51459	    finally:
 51460	        for k, v in saved.items():
 51461	            if v is None:
 51462	                _os.environ.pop(k, None)
 51463	            else:
 51464	                _os.environ[k] = v
 51465	    loops = _re.findall(r"for _c in ([^;]+); do", ref)
 51466	    dflt = _re.search(r'_dirs="([^"]+)"\n  fi', ref)
 51467	    sh_dirs = dflt.group(1).replace("${HOME:-/nonexistent}", "/lumos-home").split(":") if dflt else []
 51468	    lm_names = cands[:3]
 51469	    lm_dirs = [p.rsplit("/", 1)[0] for p in fixed[:3]]
 51470	    lm_tail = [c for c in cands if "/" not in c and c not in lm_names and c != "uv python find"]
 51471	    check("⑧shell 那份跟 lumos 內部清單逐項相同(版本號名稱、預設固定目錄、最後兩個名字)",
 51472	          len(loops) >= 2 and loops[0].split() == lm_names and sh_dirs == lm_dirs
 51473	          and loops[1].split() == lm_tail and all(p.endswith("/python3.14") for p in fixed[:3]),
 51474	          f"sh={loops} {sh_dirs} lumos={lm_names} {lm_dirs} {lm_tail}")
 51475	    for f in files:
 51476	        s = (repo / f).read_text(encoding="utf-8")
 51477	        check(f"{f} 不再寫死 python3 叫 lumos", "exec python3 " not in s and 'python3 "$LUMOS_HOME' not in s
 51478	              and 'command -v python3 || command -v python' not in s, "")
