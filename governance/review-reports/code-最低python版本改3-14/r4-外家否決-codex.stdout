 51533	def t_installers_require_python314():
 51534	    """[S4] 安裝入口在只有 python3.14、沒有任何 python 的機器;Windows 包裝挑「實際執行成功」的啟動指令
 51535	    (Projects/最低Python版本改3.14_計劃 做法第 5 點)。
 51536	    翻紅釘:安裝腳本改回寫死 python3 → ①紅;沒 python 時不印安裝指令 → ②紅;包裝改回只看名字 → ③紅。"""
 51537	    print("t_installers_require_python314")
 51538	    import os as _os, tempfile as _tf, subprocess as _sp
 51539	    if not hasattr(_os, "setsid"):
 51540	        raise _SrcOnly("非 POSIX,這段沒驗到")
 51541	    repo = Path(GRAPHCTL).resolve().parent.parent
 51542	    tmp = Path(_tf.mkdtemp(prefix="gctl-s4-"))
 51543	    nopy = _py314_sysbin(tmp)
 51544	    good = tmp / "goodbin"
 51545	    good.mkdir()
 51546	    _os.symlink(sys.executable, good / "python3.14")
 51547	    base = {k: v for k, v in _os.environ.items() if k not in ("LUMOS_PYTHON", "LUMOS_REEXEC_PYTHON")}
 51548	    base.update(HOME=str(tmp), LUMOS_PYTHON_SEARCH_DIRS=str(tmp / "nowhere"))
 51549	    r = _sp.run(["/bin/bash", str(repo / "scripts" / "install-hooks.sh"), "--help"], capture_output=True, text=True,
 51550	                env=dict(base, PATH=str(good) + _os.pathsep + str(nopy)), cwd=str(tmp), timeout=120)
 51551	    check("①只有 python3.14 的機器:安裝入口照樣把 lumos 叫起來", r.returncode == 0 and "usage" in r.stdout.lower(),
 51552	          r.stdout[-200:] + r.stderr[-300:])
 51553	    for script in ("install.sh", "scripts/install-hooks.sh", "scripts/install-graph-toolchain.sh"):
 51554	        r = _sp.run(["/bin/bash", str(repo / script)], capture_output=True, text=True, env=dict(base, PATH=str(nopy)),
 51555	                    cwd=str(tmp), timeout=60)
 51556	        check(f"②沒有任何 python:{script} 印安裝指令回 2、不替人裝", r.returncode == 2 and "brew install python@3.14" in r.stderr
 51557	              and "winget install Python.Python.3.14" in r.stderr, r.stderr[-300:])
 51558	    m = _load_lumos_inproc()
 51559	    fb = tmp / "winbin"
 51560	    fb.mkdir()
 51561	    (fb / "py").write_text("#!/bin/sh\nexit 9\n", encoding="utf-8")          # 啟動器壞掉
 51562	    (fb / "python").write_text("#!/bin/sh\nexit 9009\n", encoding="utf-8")   # 商店替身:找得到、執行失敗
 51563	    for f in ("py", "python"):
 51564	        (fb / f).chmod(0o755)
 51565	    _os.symlink(sys.executable, fb / "python3")
 51566	    saved = _os.environ.get("PATH", "")
 51567	    try:
 51568	        _os.environ["PATH"] = str(fb)
 51569	        got = m._pick_windows_launcher()
 51570	        (fb / "python3").unlink()
 51571	        got2 = m._pick_windows_launcher()
 51572	    finally:
 51573	        _os.environ["PATH"] = saved
 51574	    check("③Windows 包裝:跳過跑不起來的 py 與商店替身,挑實際執行成功的", got == "python3", got)
 51575	    check("③都跑不起來時退回 python", got2 == "python", got2)
 51576	
