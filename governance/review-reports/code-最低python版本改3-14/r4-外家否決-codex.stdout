 19927	def _hook_python_problems(home=None):
 19928	    """Claude/Codex 設定裡註冊的直譯器 → (看過的 [(家, 路徑, 結果)], 有問題的 [說明])。每支實際執行一次看版本(5 秒逾時)。
 19929	    sys.executable 可能落在 uv、pyenv、venv、Homebrew 某個版本目錄底下,會隨它們更新或刪除而消失,原本沒有任何東西會發現
 19930	    (Projects/最低Python版本改3.14_計劃 做法第 9 點)。讀不到設定檔 = 沒有註冊,不算問題。
 19931	    ★只看 lumos 自己註冊的那幾條★(第二段是 lumos 自家掛鉤檔、第一段看起來是 python):設定檔裡也有別的工具的掛鉤,
 19932	    拿它們的第一個字去跑 `-c <探針>` 會真的執行別人的腳本,而且重跑 lumos install 修不掉那種誤報(代碼審 r1)。"""
 19933	    import json as _json
 19934	    import shlex as _shlex
 19935	    home = Path(home) if home else Path.home()
 19936	    ours = _own_hook_scripts()
 19937	    # 自家掛鉤放的目錄,照 merge-claude-settings.py 的 _hook_cmd 實際寫出的形狀(兩家分開,不用後綴比對:
 19938	    # 別人家目錄底下的 .claude/hooks 也會對上;代碼審 r3 外家席)。t_doctor_flags_stale_hook_python ⑩ 拿合併程式真的寫出的設定餵
 19939	    dirs = {"claude": {"${HOME}/.claude/hooks", "$HOME/.claude/hooks",
 19940	                       str(home / ".claude" / "hooks").replace("\\", "/")},
 19941	            "codex": {str(_codex_home(home) / "hooks").replace("\\", "/").rstrip("/")}}
 19942	    seen, probs = [], []
 19943	    for fam, f in (("claude", home / ".claude" / "settings.json"), ("codex", _codex_home(home) / "hooks.json")):
 19944	        try:
 19945	            d = _json.loads(f.read_text(encoding="utf-8"))
 19946	        except (OSError, ValueError):
 19947	            continue
 19948	        exes = set()
 19949	        for arr in (d.get("hooks") or {}).values():
 19950	            for grp in arr if isinstance(arr, list) else []:
 19951	                for hk in (grp.get("hooks") or []) if isinstance(grp, dict) else []:
 19952	                    cmd = str((hk or {}).get("command") or "")
 19953	                    try:
 19954	                        parts = _shlex.split(cmd)
 19955	                    except ValueError:
 19956	                        continue
 19957	                    if len(parts) < 2:
 19958	                        continue
 19959	                    hook_dir, _, base = parts[1].replace("\\", "/").rpartition("/")
 19960	                    # 自家掛鉤 = 檔名是 lumos 的、而且放在這一家 lumos 裝的那個目錄(r2 外家席:只比檔名,別家同名檔也會被認);
 19961	                    # 第一段像 python,含 free-threaded 的 python3.14t(r2 正確性席)
 19962	                    if (base in ours and hook_dir in dirs[fam]
 19963	                            and re.match(r"(?i)py(thon[0-9.]*t?)?(\.exe)?$", parts[0].replace("\\", "/").rsplit("/", 1)[-1])):
 19964	                        exes.add(parts[0])
 19965	        for exe in sorted(exes):
 19966	            path, why = _py_probe([exe], time.monotonic() + _PY_PROBE_TIMEOUT)
 19967	            seen.append((fam, exe, why))
 19968	            if not path:
 19969	                probs.append("%s 的掛鉤註冊的是 %s:%s" % (fam, exe, why))
 19970	    return seen, probs
