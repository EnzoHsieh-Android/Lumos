 51155	        check("⑤uv 探測帶 --system --no-python-downloads,找不到算這格不合格", path is None and "--no-python-downloads" in args
 51156	              and "--system" in args, args + str(tried))
 51157	        msg = m._py_floor_message(tried)
 51158	        check("⑤找不到時說明列出每個候選的結果:存在但不合格的逐條、不存在的併成一行、uv 在但找不到另列",
 51159	              "python3:版本 3.9.6" in msg and "uv python find:uv 找不到 3.14" in msg
