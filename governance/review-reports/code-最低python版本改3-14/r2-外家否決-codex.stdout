 14723	def _vault_lock_say(lock, why):
 14724	    """鎖的位置不對勁時講一次(呼叫端負責「同一個程序只講一次」)。"""
 14725	    # ★只剩一種原因★(2026-09-16 代碼審 資安席):改用逐層建之後,「決定位置」那支
 14726	    # 不再區分「建不起來」與「不可信」——兩種都退到同一條退路,所以原本那個分支是死碼,
 14727	    # 而且把兩種原因混成同一句話會讓人去檢查一條其實沒有連結問題的路徑。
 14728	    print(f"提醒:放寫入鎖的資料夾用不了({why[1]})——它自己或上層被換成了"
 14729	          "指向別處的連結、或別人也寫得進去。", file=sys.stderr)
 14730	    print("  為什麼在意:鎖是用來擋「兩個程序同時改同一個筆記庫、後寫的蓋掉先寫的」;"
 14731	          f"這次改把鎖放在筆記庫自己裡面({lock.name}),功能不變,只是位置換了。",
 14732	          file=sys.stderr)
 14733	    print("  要回到原本的位置,先看那條路徑是誰建的:", file=sys.stderr)
 14734	    print(f"    ls -ld {why[1]} {Path(why[1]).parent}", file=sys.stderr)
 14735	
 14736	
 14737	def _vault_write_lock(vault):
 14738	    """同一個筆記庫的 set/append/remove 一次只讓一個程序做「讀—改—寫」(2026-09-10 代碼審 r3 併發資源席:
 14739	    沒有鎖時,回報成功的項目會被同時跑的另一個程序蓋掉)。
 14740	
 14741	    ★用專案既有的鎖檔做法★(_excl_lock_try:獨佔建鎖檔、寫程序編號、過期用換名原子接手;第四輪架構席:
 14742	    第三輪另開了一套 flock,是專案裡第二種鎖),搶不到就每 0.05 秒再試、最多 60 秒(RuntimeError)。
 14743	    鎖檔放 ~/.cache/lumos/vault-lock/(照 dispatch-lens 快取的先例:不放共用暫存目錄——路徑可預測、會被別的使用者先佔)。
 14744	    同一個程序巢狀拿同一把鎖直接過(第四輪:原本自己卡自己 60 秒,訊息還說「別的程序在寫」);
 14745	    鎖的資料夾建不起來就照寫,但會講一聲(第四輪:原本默默不上鎖)。"""
 14746	    import contextlib, time as _t
 14747	
 14748	    @contextlib.contextmanager
 14749	    def _cm():
 14750	        # ★「鎖放哪」必須在「這把鎖是不是自己已經拿著」之前決定★(2026-09-16 代碼審 r2):
 14751	        # 排在後面的話,巢狀呼叫會拿舊路徑的鍵去查、查不到,內層卡滿 60 秒再拋
 14752	        # 「別的程序正在寫」這句假訊息——那正是本函式說明裡「第四輪已修過」的舊坑
 14753	        # 從退路分支重新長出來。現在決定位置是獨立一支,結構上不可能再排錯順序。
 14754	        lock, why = _vault_lock_where(vault)
 14755	        k = str(lock)
 14756	
 14757	        if _VAULT_LOCK_HELD.get(k):          # 自己已經拿著這把鎖:巢狀直接過
 14758	            _VAULT_LOCK_HELD[k] += 1
 14759	            try:
 14760	                yield
 14761	            finally:
 14762	                _VAULT_LOCK_HELD[k] -= 1
 14763	            return
 14764	
 14765	        if why and not _VAULT_LOCK_WARNED.get(k):
 14766	            _VAULT_LOCK_WARNED[k] = True
 14767	            _vault_lock_say(lock, why)
 14768	        deadline = _t.monotonic() + 60
 14769	        while not _excl_lock_try(lock, _VAULT_LOCK_STALE_SEC):
 14770	            if _t.monotonic() > deadline:
 14771	                raise RuntimeError("等了 60 秒還輪不到寫入(同一個筆記庫有別的程序正在寫,或上一個寫入的程序卡住了),檔案沒動")
 14772	            _t.sleep(0.05)
 14773	        _VAULT_LOCK_HELD[k] = 1
 14774	        try:
 14775	            yield
 14776	        finally:
 14777	            _VAULT_LOCK_HELD.pop(k, None)
 14778	            try:   # 只刪自己的鎖(過期被接手時,鎖檔已經是別人的)
 14779	                if lock.read_text(encoding="utf-8").split("\n", 1)[0] == str(os.getpid()):
 14780	                    lock.unlink()
 14781	            except OSError:
 14782	                pass
 14783	    return _cm()
 14784	
 14785	
 14786	def cmd_set(env, rel, key, value):
 14787	    with _vault_write_lock(env.vault):
 14788	        return _cmd_set_locked(env, rel, key, value)
 14789	
 14790	
 14791	def _cmd_set_locked(env, rel, key, value):
 14792	    if key in COND_KEYS:
 14793	        return _set_conditions_locked(env, rel, key, value if isinstance(value, list) else [value])
 14794	    if isinstance(value, list):
 14795	        if len(value) != 1:
 14796	            print(f"擋下:{key} 只收一個值,你給了 {len(value)} 個,檔案沒動(給多個值只有 {'、'.join(COND_KEYS)} 收)",
 14797	                  file=sys.stderr)
 14798	            return 2
 14799	        value = value[0]
 14800	    if key not in SCALAR_KEYS:
 14801	        print(f"擋下:{key} 不能用 set 改,檔案沒動。set 只能改這些純量欄位:{sorted(SCALAR_KEYS)},"
 14802	              f"以及整欄換掉的 {'、'.join(COND_KEYS)}"
 14803	              f"(清單欄位用 lumos append;決策新增/翻案用 lumos decision-add / decision-supersede)", file=sys.stderr)
 14804	        return 2
 14805	    # ★負責範圍跟新開節點用同一支判斷、同樣擋★(筆記欄位關卡補齊_計劃 S11;不看開關——r3 架構席:
 14806	    # 同一個欄位的兩個寫入口擋法要一樣;原本只有 new 擋,set 可以寫進一個字)
 14807	    if key == "responsibility" and not _nodehome_resp_ok(value):
 14808	        print(f"擋下:負責範圍至少 {_NODEHOME_RESP_MIN_CHARS} 個字、要有實字(一句話講這篇負責什麼、不負責什麼),檔案沒動",
 14809	              file=sys.stderr)
 14810	        return 2
 14811	    path = env.vault / rel
 14812	    lines, s, e = load_raw_for_edit(path)
 14813	    new_fm = edit_fm_scalar(lines[1:e], key, value)
 14814	    exp = fmt_scalar(key, value)
 14815	    exp_val = strip_quotes(exp)
 14816	    tag_synced = False
 14817	    if key == "status":
 14818	        new_fm, tag_synced = edit_fm_sync_status_tag(new_fm, exp_val)
 14819	    new_lines = lines[:1] + new_fm + lines[e:]
 14820	
 14821	    def _check(f):
 14822	        if str(f.get(key, "")) != exp_val:
 14823	            return False
 14824	        if tag_synced:
 14825	            want = f"status/{exp_val}"
 14826	            tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
 14827	            return want in tags and all(t == want for t in tags if t.startswith("status/"))
 14828	        return True
 14829	
 14830	    atomic_write_verify(path, new_lines, key, _check)
 14831	    print(f"✓ set {rel}: {key} 已改成 {exp}" + ("(狀態標籤 status/* 也同步改了)" if tag_synced else ""))
 14832	    return 0
