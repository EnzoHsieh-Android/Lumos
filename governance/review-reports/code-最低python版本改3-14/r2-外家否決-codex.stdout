    16	# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
    17	# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
    18	# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
    19	# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
    20	# LUMOS_PYTHON 有設而且能執行就先用它:找不到時的說明叫人設它,第一步就不能不認(合不合格仍由 lumos 判)。
    21	_lumos_any_python() {
    22	  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""
    23	  if [ -n "${LUMOS_PYTHON:-}" ] && [ -x "$LUMOS_PYTHON" ]; then _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0; fi
    24	  for _c in python3.14 python3.15 python3.16; do
    25	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
    26	  done
    27	  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
    28	    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
    29	  else
    30	    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
    31	  fi
    32	  _ifs="$IFS"; IFS=":"
    33	  for _d in $_dirs; do
    34	    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
    35	  done
    36	  IFS="$_ifs"
    37	  for _c in python3 python; do
    38	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
    39	  done
    40	  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
    41	  return 1
    42	}
    43	_LUMOS_NO_PY_MSG="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
    44	安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
    45	Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
    46	# ── python-launcher end ──
    47	
    48	main() {
    49	  LUMOS_HOME="${LUMOS_HOME:-$HOME/harness/lumos-toolchain}"
    50	  LUMOS_URL="${LUMOS_URL:-https://github.com/EnzoHsieh-Android/Lumos}"
    51	  LUMOS_BRANCH="${LUMOS_BRANCH:-release}"
    52	
    53	  # 迴圈解析(舊碼單點比對 $1,並帶兩旗標會無聲吃掉第二個);未知旗標 warn 忽略
    54	  ARGS=()
    55	  for a in "$@"; do
    56	    case "$a" in
    57	      --pull|--init) ARGS+=("$a") ;;
    58	      *) echo "提醒:不認得 $a 這個選項,略過(只認 --pull 和 --init)" >&2 ;;
    59	    esac
    60	  done
    61	
    62	  if [[ -f "$LUMOS_HOME/scripts/lumos" ]]; then
    63	    echo "[clone] Lumos 源已在: $LUMOS_HOME"
    64	  else
    65	    echo "[clone] clone Lumos($LUMOS_BRANCH 對外線)→ $LUMOS_HOME …"
    66	    mkdir -p "$(dirname "$LUMOS_HOME")"
    67	    # 對外線抓不到就退回預設分支:release 分支可能還沒開,冷啟動不該因此炸掉。
    68	    # 用分支不用 tag,是因為 tag 會進 detached HEAD,之後 git pull / lumos update 全部靜默停住。
    69	    if ! git clone --branch "$LUMOS_BRANCH" "$LUMOS_URL" "$LUMOS_HOME" 2>/dev/null; then
    70	      echo "  提醒:抓不到 $LUMOS_BRANCH 這條對外線(分支還沒開、或名字改了),改用預設分支。" >&2
    71	      echo "  這代表你拿到的是開發線的內容,可能還沒發布過。" >&2
    72	      git clone "$LUMOS_URL" "$LUMOS_HOME"
    73	    fi
    74	  fi
    75	
    76	  # 其餘全交 bootstrap(機器層 install+skills、專案層四分流;set -e 保錯誤傳播)
    77	  _lumos_any_python || { printf '%s\n' "$_LUMOS_NO_PY_MSG" >&2; exit 2; }
    78	  LUMOS_HOME="$LUMOS_HOME" "$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$LUMOS_HOME/scripts/lumos" bootstrap ${ARGS[@]+"${ARGS[@]}"}
    79	
    80	  echo
    81	  echo "✓ 完成。最後一步:**重啟 Claude Code session**(hooks 在 session start 載入)"
    82	}
    83	
    84	main "$@"; exit
    60	    read -r _ _lsha _ _rsha <<< "$_ppl"
    61	    [[ "$_lsha" == "$_ZERO" ]] && continue
    62	    _r="$(pp_range_for "$_rsha" "$_lsha")"
    63	    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
    64	  done
    65	  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
    66	}
