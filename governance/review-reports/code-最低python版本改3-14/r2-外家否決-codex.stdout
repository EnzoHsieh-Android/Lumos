 14581	def decisions_items(fm_lines):
 14582	    """surgical 定位 decisions[] 的每個項目行範圍(不重序列化,延伸 T1 到巢狀)。
 14583	    回傳 (block_start, block_end, [(item_start, item_end)], item_indent, sub_indent)
 14584	    或 None(無 decisions)。item_end 含,已去尾部空行。處理項目內含 nested 子清單。"""
 14585	    block = None
 14586	    for k, s, e, kind in fm_structure(fm_lines):
 14587	        if k == "decisions" and kind == "list":
 14588	            block = (s, e)
 14589	            break
 14590	    if block is None:
 14591	        return None
 14592	    s, e = block
 14593	    item_indent = None
 14594	    starts = []
 14595	    for i in range(s + 1, e + 1):
 14596	        ln = fm_lines[i]
 14597	        if not ln.strip():
 14598	            continue
 14599	        m = re.match(r"^(\s*)-\s", ln)
 14600	        if m:
 14601	            ind = len(m.group(1))
 14602	            if item_indent is None:
 14603	                item_indent = ind
 14604	            if ind == item_indent:  # 只認最淺層 dash(子清單的 dash 更深,不算項目)
 14605	                starts.append(i)
 14606	    items = []
 14607	    for idx, st in enumerate(starts):
 14608	        en = (starts[idx + 1] - 1) if idx + 1 < len(starts) else e
 14609	        while en > st and not fm_lines[en].strip():
 14610	            en -= 1
 14611	        items.append((st, en))
 14612	    sub_indent = (item_indent + 2) if item_indent is not None else 4
 14613	    return s, e, items, (item_indent or 2), sub_indent
 14614	
