 14616	def load_raw_for_edit(path: Path):
 14617	    """讀 raw,拒 BOM/CRLF(本 vault 慣例 LF/no-BOM,異常不靜默正規化)。
 14618	    回傳 (all_lines, fm_start, fm_end_exclusive)。fm = all_lines[1:fm_end]。"""
 14619	    raw = path.read_bytes()
 14620	    if raw.startswith(b"\xef\xbb\xbf"):
 14621	        raise ValueError("這個檔開頭帶 BOM 標記,工具不寫這種檔;先把檔案存成不帶 BOM 的 UTF-8")
 14622	    if b"\r\n" in raw:
 14623	        raise ValueError("這個檔的換行是 Windows 式(CRLF),工具只寫 Unix 式(LF)。Windows 上常是 git autocrlf 造成的;"
 14624	                         "修法:確認 .gitattributes 有套用(圖譜目錄標 eol=lf)再跑 git add --renormalize .,"
 14625	                         "或單檔跑 dos2unix。工具不會偷偷幫你改行尾。")
 14626	    lines = raw.decode("utf-8").split("\n")
 14627	    if not lines or lines[0].strip() != "---":
 14628	        raise ValueError("這篇筆記開頭沒有欄位區塊(---),沒辦法改欄位")
 14629	    fm_end = None
 14630	    for i in range(1, len(lines)):
 14631	        if lines[i].strip() == "---":
 14632	            fm_end = i
 14633	            break
 14634	    if fm_end is None:
 14635	        raise ValueError("開頭欄位區塊沒收尾(有起頭的 --- 沒有結尾的 ---),先補上")
 14636	    return lines, 1, fm_end
 14637	
 14638	
 14639	def _write_lf(path: Path, text: str):
 14640	    """寫 UTF-8 / LF / no-BOM,平台無關(不靠 text mode)。vault 唯一寫入原語。
 14641	    用 write_bytes:write_text(newline=) 要 Python 3.10,違反本專案 ≥3.9。
 14642	    [2026-08-05 單席快審 F2] tmp→os.replace 原子替換:防半寫毀檔(CLAUDE.md reinject 等
 14643	    整檔覆寫消費者)。read-modify-write 的併發:set/append/remove 由呼叫端上鎖(_vault_write_lock),
 14644	    其他寫入指令仍是 last-write-wins(單機 CLI,accepted)。
 14645	    ★暫存檔名每次都不一樣★(2026-09-10 代碼審 r3 併發資源席:原本同一篇筆記大家用同一個固定暫存檔名,
 14646	    兩個程序同時寫就互搶,實測六個同時跑六個都噴 FileNotFoundError)——跟 mkstemp 同一種做法(獨佔建一個唯一名),
 14647	    但權限給 0o666、讓它跟一般建檔一樣受 umask 管;原檔在就照原檔的權限(例如 +x)。
 14648	    ★不用 mkstemp 再改權限★(第四輪併發資源席):mkstemp 建成 0600,要調回一般樣子只能先讀整個程序的 umask
 14649	    (設成 0 再設回來),那一瞬間別的執行緒建的檔會拿到錯的權限。"""
 14650	    import os as _os, shutil as _sh, uuid as _uuid
 14651	    tmp = str(path.with_name(f"{path.name}.{_os.getpid()}-{_uuid.uuid4().hex[:8]}.tmp-wlf"))
 14652	    fd = _os.open(tmp, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o666)   # 權限照一般建檔
 14653	    try:
 14654	        with _os.fdopen(fd, "wb") as fh:
 14655	            fh.write(text.encode("utf-8"))
 14656	        if path.exists():
 14657	            _sh.copymode(path, tmp)
 14658	        _os.replace(tmp, path)
 14659	    except BaseException:
 14660	        try:
 14661	            _os.unlink(tmp)
 14662	        except OSError:
 14663	            pass
 14664	        raise
 14665	
 14666	
 14667	def atomic_write_verify(path: Path, new_lines, key, expected_check):
 14668	    """寫 tmp → re-parse 自驗 + lint 無新指紋 → atomic rename。任一步敗:tmp 丟棄,原檔不動。"""
 14669	    orig_fm = load_raw_for_edit(path)
 14670	    orig_lint = set(parse_frontmatter(orig_fm[0][1:orig_fm[2]])[2])
 14671	    text = "\n".join(new_lines)
 14672	    new_fm_lines = new_lines[1:]
 14673	    for i in range(1, len(new_lines)):
 14674	        if new_lines[i].strip() == "---":
 14675	            new_fm_lines = new_lines[1:i]
 14676	            break
 14677	    fields, _, new_lint = parse_frontmatter(new_fm_lines)
 14678	    if not expected_check(fields):
 14679	        raise RuntimeError(f"寫完讀回來檢查,{key} 的值跟要寫的不一樣,這次寫入不算成功")
 14680	    introduced = set(new_lint) - orig_lint
 14681	    if introduced:
 14682	        raise RuntimeError("寫完讀回來檢查,發現欄位區塊多了會讀錯的寫法,這次寫入不算成功:" + "; ".join(sorted(introduced)))
 14683	    _write_lf(path, text)   # 本身就是「寫暫存檔→原子換名」;原本外面再包一層固定檔名的暫存檔,兩層固定名互搶(r3)
 14684	
 14685	
 14686	_VAULT_LOCK_STALE_SEC = 30   # 一次筆記寫入不到一秒;鎖檔 30 秒還沒放掉,當成拿鎖的程序死了、原子接手
 14687	_VAULT_LOCK_HELD = {}         # 這個程序已經拿著的寫入鎖 → 巢狀呼叫直接過(可重入),不自己卡自己
 14688	
 14689	
 14690	_VAULT_LOCK_WARNED = {}        # 鎖的位置換過一次就別再唸(同一個程序內)
 14691	
 14692	
 14693	def _vault_lock_where(vault):
 14694	    """這個筆記庫的寫入鎖該放哪、位置有沒有不對勁。回 (鎖檔路徑, 不對勁的原因|None)。
 14695	
 14696	    ★獨立一支,不是巢狀函式★(2026-09-16 推送前的新增告警閘擋下:算進外層之後超過複雜度
 14697	    上限)。分開之後還多買到一件事:「決定位置」與「拿鎖」各自看得完,代碼審 r2 抓到的那個坑
 14698	    (位置算在可重入判斷後面、巢狀呼叫卡死自己)變成結構上不可能再犯。
 14699	
 14700	    ★鎖檔的資料夾要過信任檢查★(同族掃描):放的位置是照派工鏡頭快取的先例抄的,但
 14701	    ★只抄了放哪裡、沒抄那道檢查★。★不可信就換個地方鎖,不是乾脆不鎖★(代碼審 r1 外家席):
 14702	    不鎖等於把一個安全問題換成一個正確性問題——原本鎖檔雖然落在不可信的地方、鎖本身仍然有效;
 14703	    不鎖之後兩個程序就能同時做讀—改—寫,而且觸發條件不需要攻擊者,把快取目錄搬到別的磁碟
 14704	    就會踩到。退路選筆記庫自己:要寫的就是它、使用者一定擁有它,兩個程序算出來的路徑一樣,
 14705	    互斥照樣成立。
 14706	
 14707	    ★沒擋到的殘留(照實寫,別當成全防住了)★:檢查排在建資料夾之後,連結指到的地方仍會多出
 14708	    一個空資料夾——鄰居那幾處同樣順序,是共用寫法本來就有的缺口,不是這處特有;真正危險的
 14709	    動作(寫鎖檔、改權限、刪目錄)都在檢查之後。
 14710	    """
 14711	    import hashlib
 14712	    key = hashlib.sha256(os.path.realpath(str(vault)).encode("utf-8")).hexdigest()[:32]
 14713	    primary = Path.home() / ".cache" / "lumos" / "vault-lock" / f"{key}.lock"
 14714	    # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
 14715	    # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
 14716	    if not _mkdir_trusted_under_home(".cache", "lumos", "vault-lock"):
 14717	        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
 14718	    if not _trusted_private_dir(primary.parent, ".cache", "lumos", "vault-lock"):
 14719	        return Path(vault) / f".lumos-vault-{key}.lock", ("unusable", str(primary.parent))
 14720	    return primary, None
 14721	
