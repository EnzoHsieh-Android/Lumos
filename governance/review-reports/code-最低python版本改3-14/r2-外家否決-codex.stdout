 18331	        stale = chooks / f
 18332	        if stale.exists() or stale.is_symlink():
 18333	            stale.unlink()
 18334	    merge = src_repo / "scripts" / "merge-claude-settings.py"  # ③ merge+prune 懸空(含②剛變懸空的)
 18335	    if merge.exists():
 18336	        args = [sys.executable, str(merge)] + (["--target", "codex"] if harness == "codex" else [])
