     6	"""Merge graph hook entries into ~/.claude/settings.json — idempotent.
     7	
     8	跟 scripts/install-hooks.sh 配合用。已存在的 hook entry 不重複加。
     9	不會清掉使用者既有的其他 settings (mcpServers/permissions/...)。
    10	"""
    11	from __future__ import annotations
    12	import json
    13	import os
    14	import re
    15	import shlex
    16	import shutil
    17	import subprocess
    18	import sys
    19	from pathlib import Path
