   111	# Gate DG: code 側刪除傳播守衛 (advisory;spec=Projects/code側刪除傳播守衛_計劃)
   112	# 警告走 stdout(2>/dev/null 只吞診斷);|| true 只兜 crash,hang 由 lumos 內部 deadline 兜(fail-open)
   113	# -f 必檢:沒有 scripts/lumos 的 repo(未 vendored)只有 CC_PY 也會跑,python 報「can't open file」
   114	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
   115	  "$CC_PY" "$REPO_ROOT/scripts/lumos" delguard --staged 2>/dev/null || true
   116	fi
   117	
   118	# Gate 1: 圖譜污染指紋 (2026-06-13 對抗審計 P0)
   119	# 攔 notesmd-cli `frontmatter --edit` 的副作用: 日期欄位加引號 (Obsidian property
   120	# 型別 date→text 靜默損傷,且通常伴隨整篇 frontmatter 鍵序重排)。
   121	# 必須放在 Gate 2 之前 — 污染 commit 是 docs-only,Gate 2 的 code 判定對它直接放行。
   122	if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
   123	  polluted="$(git -c core.quotePath=off diff --cached -- "$GRAPH_ROOT" \
   124	    | grep -E '^\+[[:space:]]*(date|created|updated|decided|ended):[[:space:]]*"[0-9]{4}-[0-9]{2}-[0-9]{2}"' || true)"
   125	  if [[ -n "$polluted" ]]; then
   126	    {
   127	      echo ""
   128	      echo "擋下:有筆記的日期欄位被加上了引號(例如 created: \"2026-08-21\")。"
   129	      echo "這幾乎都是某個編輯工具順手改的,不是人打的;它會讓日期欄位變成純文字,而且通常整篇欄位順序都被重排——這種 diff 沒辦法審。"
   130	      echo ""
   131	      echo "被改到的行:"
   132	      echo "$polluted" | head -5 | sed 's/^/   /'
   133	      echo ""
   134	      echo "看完整改動:"
   135	      echo "   git diff --cached -- ${GRAPH_ROOT}"
   136	      echo "還原那個檔:"
   137	      echo "   git checkout -- <檔案>"
   138	      echo "真的是刻意要這樣(非常少見)→ git commit --no-verify"
   139	      echo ""
   140	    } >&2
   141	    exit 1
   142	  fi
   143	fi
   144	
   145	# Gate PY: 下面 L/H/NS 三道會擋的檢查要用 3.14 跑 lumos;有 scripts/lumos 卻找不到 3.14 就在這裡擋下,
   146	# 不退回舊版 Python、也不像以前那樣整段跳過(Projects/最低Python版本改3.14_計劃 做法第 3 點)。
   147	if [[ -f "$REPO_ROOT/scripts/lumos" && -z "$CC_PY" ]]; then
   148	  _lumos_block_no_py314
   149	  exit 1
   150	fi
   151	
   152	# Gate L: staged 圖譜 .md 逐檔 lumos lint (2026-08-21 體檢 #6)
   153	# 為什麼:lint 自 2026-06 起沒有任何 hook/CI 呼叫,它的每條鐵則(YAML list/白名單/枚舉/frontmatter
   154	# 閉合)全靠人記得跑——「有機制,沒接線」。硬擋:lint rc≠0 即擋,訊息原樣轉出。
   155	# 只跑 staged 的圖譜檔(每檔 <1s),不跑全 vault。找不到 python/lumos → 跳過(與 Gate CC 同語意)。
    85	[[ ${#src_files[@]} -eq 0 ]] && exit 0
    86	
    87	# 有圖譜 .md 一起 commit → 正常通過 L2,不是 bypass
    88	if echo "$CHANGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
    89	  exit 0
    90	fi
    91	
    92	# ── 走到這裡 = 這筆 commit 繞過了 L2 → 留痕 ──
    93	BYPASS_LOG="$REPO_ROOT/docs/.bypass-log.jsonl"
    94	
    95	# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
    96	# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
    97	# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
    98	# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
    99	# LUMOS_PYTHON 有設而且能執行就先用它:找不到時的說明叫人設它,第一步就不能不認(合不合格仍由 lumos 判)。
   100	_lumos_any_python() {
   101	  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""
   102	  if [ -n "${LUMOS_PYTHON:-}" ] && [ -x "$LUMOS_PYTHON" ]; then _LUMOS_ANY_EXE="$LUMOS_PYTHON"; return 0; fi
   103	  for _c in python3.14 python3.15 python3.16; do
   104	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
   105	  done
   106	  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
   107	    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
   108	  else
   109	    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
   110	  fi
   111	  _ifs="$IFS"; IFS=":"
   112	  for _d in $_dirs; do
   113	    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
   114	  done
   115	  IFS="$_ifs"
   116	  for _c in python3 python; do
   117	    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
   118	  done
   119	  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
   120	  return 1
   121	}
   122	_LUMOS_NO_PY_MSG="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
   123	安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
   124	Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
   125	# ── python-launcher end ──
   126	# 寫跳過帳★不設版本下限★:沒有 3.14 的機器正是最常用 --no-verify 的機器,這筆帳不能因為下限寫不進去
   127	_lumos_any_python || exit 0
   128	COMMIT_HASH="$(git rev-parse --short HEAD)" \
   129	BRANCH="$(git branch --show-current)" \
   130	SUBJECT="$(git log -1 --format=%s)" \
   131	SRC_COUNT="${#src_files[@]}" \
   132	SRC_SAMPLE="$(printf '%s\n' "${src_files[@]:0:10}")" \
   133	"$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} - "$BYPASS_LOG" <<'PYEOF'
   134	import json, os, sys
   135	from datetime import datetime, timezone
   136	
   137	entry = {
   138	    "ts": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
   139	    "commit": os.environ["COMMIT_HASH"],
   140	    "branch": os.environ["BRANCH"],
   141	    "subject": os.environ["SUBJECT"],
   142	    "code_file_count": int(os.environ["SRC_COUNT"]),
   143	    "code_files": os.environ["SRC_SAMPLE"].splitlines(),
   144	}
   145	with open(sys.argv[1], "a", encoding="utf-8") as f:
   146	    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
   147	PYEOF
   148	
   149	{
   150	  echo ""
   151	  echo "記下了:這次 commit 有 ${#src_files[@]} 個程式碼檔沒帶筆記改動,已寫進跳過紀錄(不擋,只留痕)。"
   152	  echo "如果這次其實該補筆記,趁記憶還新鮮補上;每週可以用這個看跳過率:"
   153	  echo "   lumos gov --since 7"
   154	  echo ""
   155	} >&2
   156	
   157	exit 0

