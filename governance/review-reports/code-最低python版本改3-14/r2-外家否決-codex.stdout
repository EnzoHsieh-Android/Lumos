 19911	def _hook_python_problems(home=None):
 19912	    """Claude/Codex 設定裡註冊的直譯器 → (看過的 [(家, 路徑, 結果)], 有問題的 [說明])。每支實際執行一次看版本(5 秒逾時)。
 19913	    sys.executable 可能落在 uv、pyenv、venv、Homebrew 某個版本目錄底下,會隨它們更新或刪除而消失,原本沒有任何東西會發現
 19914	    (Projects/最低Python版本改3.14_計劃 做法第 9 點)。讀不到設定檔 = 沒有註冊,不算問題。
 19915	    ★只看 lumos 自己註冊的那幾條★(第二段是 lumos 自家掛鉤檔、第一段看起來是 python):設定檔裡也有別的工具的掛鉤,
 19916	    拿它們的第一個字去跑 `-c <探針>` 會真的執行別人的腳本,而且重跑 lumos install 修不掉那種誤報(代碼審 r1)。"""
 19917	    import json as _json
 19918	    import shlex as _shlex
 19919	    home = Path(home) if home else Path.home()
 19920	    ours = {n for n in _GLOBAL_CLAUDE_HOOKS if n.endswith(".py") and not n.startswith("_")}
 19921	    seen, probs = [], []
 19922	    for fam, f in (("claude", home / ".claude" / "settings.json"), ("codex", _codex_home(home) / "hooks.json")):
 19923	        try:
 19924	            d = _json.loads(f.read_text(encoding="utf-8"))
 19925	        except (OSError, ValueError):
 19926	            continue
 19927	        exes = set()
 19928	        for arr in (d.get("hooks") or {}).values():
 19929	            for grp in arr if isinstance(arr, list) else []:
 19930	                for hk in (grp.get("hooks") or []) if isinstance(grp, dict) else []:
 19931	                    cmd = str((hk or {}).get("command") or "")
 19932	                    try:
 19933	                        parts = _shlex.split(cmd)
 19934	                    except ValueError:
 19935	                        continue
 19936	                    if (len(parts) >= 2 and parts[1].replace("\\", "/").rsplit("/", 1)[-1] in ours
 19937	                            and re.match(r"(?i)py(thon[0-9.]*)?(\.exe)?$", parts[0].replace("\\", "/").rsplit("/", 1)[-1])):
 19938	                        exes.add(parts[0])
 19939	        for exe in sorted(exes):
 19940	            path, why = _py_probe([exe], time.monotonic() + _PY_PROBE_TIMEOUT)
 19941	            seen.append((fam, exe, why))
 19942	            if not path:
 19943	                probs.append("%s 的掛鉤註冊的是 %s:%s" % (fam, exe, why))
 19944	    return seen, probs
