 14866	def cmd_self_audit(env, rel, model="sonnet", date=None):
 14867	    """L4 自足性審計留痕:寫 self_audit: <model>/<date> 到節點 frontmatter。
 14868	    語意:這整篇節點的「自足性」(無主對話脈絡的乾淨 agent 只讀圖譜能不能還原
 14869	    專案現況)已由一個獨立 agent 審過並通過。對應 guard audit 的角色(乾淨 agent
 14870	    審後蓋戳),但程式路徑獨立——這是節點級戳記,guard audit 是行級 [audit:]。
 14871	    工具只記留痕,不證明審計真乾淨——派 agent 的乾淨脈絡/中立 prompt 靠主對話誠實。"""
 14872	    import datetime
 14873	    if date is None:
 14874	        date = datetime.date.today().isoformat()
 14875	    else:
 14876	        try:
 14877	            datetime.date.fromisoformat(date)
 14878	        except ValueError:
 14879	            print(f"擋下:--date 要寫成 年-月-日(例如 2026-08-22),你給的是 {date!r}", file=sys.stderr)
 14880	            return 2
