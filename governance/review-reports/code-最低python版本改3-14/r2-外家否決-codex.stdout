    68	# ── python-floor begin(最低 Python 3.14;精簡版生成器只剝下面呼叫檢查的那三行,函式留著——見 Systems/python直譯器選擇)──
    69	# ★這一段與它之前的程式必須能被 Python 3.9 解析、執行★:Python 要先解析完整支檔才跑第一行,
    70	# 舊版啟動時要能跑到這裡才講得出「需要 3.14」(Projects/最低Python版本改3.14_計劃 做法第 2 點)。
    71	_PY_FLOOR = (3, 14)
    72	_PY_PROBE_TIMEOUT = 5          # 單一候選
    73	_PY_TOTAL_TIMEOUT = 15         # 整份清單
    74	_PY_PROBE = ("import sys\n"
    75	             "if sys.version_info >= (3, 14):\n    print('OK ' + sys.executable)\n"
    76	             "else:\n    print('OLD %d.%d.%d' % sys.version_info[:3]); sys.exit(1)")
    77	_PY_INSTALL_HINT = (
    78	    "安裝 3.14:\n"
    79	    "  macOS:  brew install python@3.14   或   uv python install 3.14\n"
    80	    "  Linux:  發行版的 python3.14 套件   或   uv python install 3.14\n"
    81	    "  Windows:python.org 的安裝器   或   winget install Python.Python.3.14\n"
    82	    "裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。\n"
    83	    "只有 python3.14、沒有 python3 這個名字的機器,全域 lumos 指令要 `uv python install 3.14 --default`\n"
    84	    "或自己加一個 python3 別名(它用 #!/usr/bin/env python3 啟動)。\n")
