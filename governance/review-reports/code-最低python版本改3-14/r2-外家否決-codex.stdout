   125	# ── 波及計算(給合約測試閘用):這裡只呼叫、不碰內容。
   126	# ★一次推送只算一次波及★(2026-09-07 全 repo 審視 #17,設計 [S1] 第 3 步):以前同步點名與合約測試閘各自呼叫,
   127	# 等於一次推送算兩次——這不是便宜的計算。算一次寫進暫存檔給消費者讀。
   128	# (2026-09-11 起同步點名改由每支檔有家照家算,不再讀這一份;見下面 sync_nudge 原位置的說明。)
   129	# ★失敗隔離★:算不出來 → 暫存檔不存在或是空的 → 合約測試閘記一筆帳放行,不拖垮別的檢查。
   130	_IMPACT_JSON=""
   131	impact_once() {   # $1=diff range;算一次,結果放進 $_IMPACT_JSON
   132	  _IMPACT_JSON=""
   133	  [ -n "$PY" ] && [ -f "$GRAPHCTL" ] || return 0
   134	  # ★用同檔既有的樣板寫法與命名家族★(代碼審 r1 架構對齊席):
   135	  # 同一支腳本下面幾行就有 lumos-prepush-autoloop-XXXXXX / lumos-prepush-tests-XXXXXX,
   136	  # 而且旁邊的註解特別說明過「★XXXXXX 必須在結尾★」是踩過才定下來的。
   137	  local _f; _f="$(mktemp "${TMPDIR:-/tmp}/lumos-prepush-impact-XXXXXX" 2>/dev/null || true)"
   138	  [ -n "$_f" ] || return 0
   139	  if "$PY" "$GRAPHCTL" impact --diff "$1" --sync-check --json --repo "$REPO_ROOT" > "$_f" 2>/dev/null \
   140	     && [ -s "$_f" ]; then
   141	    _IMPACT_JSON="$_f"
   142	  else
   143	    rm -f "$_f"
   144	  fi
   145	}
   146	impact_done() { [ -n "$_IMPACT_JSON" ] && rm -f "$_IMPACT_JSON"; _IMPACT_JSON=""; }
   147	# ★硬擋或收到訊號時也要清★(代碼審 r1 外家否決席判 minor,屬實):
