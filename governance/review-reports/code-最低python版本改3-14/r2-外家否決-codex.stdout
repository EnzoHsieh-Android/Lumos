 18310	        _ch = _codex_home()
 18311	        if _ch.exists() and not _ch.is_dir():   # r1 單reviewer F1:~/.codex 是檔案,mkdir 會炸穿整支 install
 18312	            return "home-not-dir"
 18313	        if not _codex_present():
 18314	            return "absent"
 18315	    import subprocess, shutil
 18316	    hdir, _ = _HARNESS_HOME[harness]
