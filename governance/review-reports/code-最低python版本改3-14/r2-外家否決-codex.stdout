 18320	    for f in _GLOBAL_HOOKS:                   # ① 現役 hooks copy(兩家同一批檔)
 18321	        s = src_dir / f
 18322	        if s.exists():
 18323	            shutil.copy2(s, chooks / f)
 18324	    for f in _RETIRED_STUB_CLAUDE_HOOKS:      # ②a 相容期:換 exit 0 空殼,★不刪檔★
 18325	        stub = chooks / f                     #     (刪了會炸掉還帶著舊註冊的 session)
 18326	        if stub.is_symlink():
