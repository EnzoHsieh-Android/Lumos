   224	def _py_floor_gate():
   225	    """lumos 以主程式身分被 3.14 以前的 Python 啟動 → 找 3.14 用它重跑同一組參數;找不到印說明回 2(做法第 2 點)。
   226	    版本夠就只清掉防重跑變數;LUMOS_PYTHON 不會讓一支已經是 3.14 的 lumos 重跑(指到包裝腳本時會無限重跑)。"""
   227	    if sys.version_info >= _PY_FLOOR:
   228	        os.environ.pop("LUMOS_REEXEC_PYTHON", None)   # 子孫行程不繼承
   229	        return
   230	    prev = os.environ.get("LUMOS_REEXEC_PYTHON")
   231	    if prev and os.path.realpath(prev) == os.path.realpath(sys.executable):
   232	        sys.stderr.write("擋下:已經用 %s 重跑過,它回報的版本仍是 %d.%d——那支不是真的 3.14(包裝腳本?)。\n"
   233	                         % (prev, *sys.version_info[:2]) + _PY_INSTALL_HINT)
   234	        sys.exit(2)
   235	    path, tried = _py_resolve()
   236	    if not path:
   237	        sys.stderr.write(_py_floor_message(tried))
   238	        sys.exit(2)
   239	    os.environ["LUMOS_REEXEC_PYTHON"] = path
   240	    argv = [path, os.path.abspath(__file__), *sys.argv[1:]]
   241	    sys.stdout.flush()
   242	    sys.stderr.flush()
   243	    if os.name == "nt":
   244	        import subprocess
   245	        sys.exit(subprocess.call(argv))           # Windows 的 execv 不真的取代行程,呼叫端拿不到回傳碼
   246	    os.execv(path, argv)
   247	
   248	
