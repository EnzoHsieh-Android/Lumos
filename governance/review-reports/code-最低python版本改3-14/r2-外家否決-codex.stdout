 19929	            for grp in arr if isinstance(arr, list) else []:
 19930	                for hk in (grp.get("hooks") or []) if isinstance(grp, dict) else []:
 19931	                    cmd = str((hk or {}).get("command") or "")
 19932	                    try:
 19933	                        parts = _shlex.split(cmd)
 19934	                    except ValueError:
