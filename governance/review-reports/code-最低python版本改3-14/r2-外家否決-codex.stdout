 19788	                cands[rel] = {"node": rel, "signal": "plain-text",
 19789	                              "evidence": ev[:3], "via": []}
 19790	        # D2
 19791	        for d in direct:
 19792	            d_stem = _lc_strip_stem(d)
 19793	            for nbr, types in adj.get(d, {}).items():
 19794	                if nbr in direct:
 19795	                    continue
