   210	def _py_floor_message(tried, head="需要 Python 3.14 以上"):
   211	    lines = ["擋下:%s,現在是 %d.%d.%d(%s)。" % (head, *sys.version_info[:3], sys.executable)]
   212	    # 每個候選都列結果(條款 [S2]);不存在的很多,併成一行,免得真正的線索被淹掉(代碼審 r1)
   213	    missing = [d for d, w in tried if w in ("不存在", "沒有這個指令")]
   214	    lines.append("找過的候選:")
   215	    lines += ["  %s:%s" % (d, w) for d, w in tried if w not in ("不存在", "沒有這個指令")]
   216	    if missing:
   217	        lines.append("  不存在或沒有這個指令:" + "、".join(missing))
   218	    if os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"):
   219	        # CI 回 2 就在這裡講清楚怎麼修:舊版 lumos update 在拉新之前就載進記憶體,印不出新版的升級注意(代碼審 r1)
   220	        lines.append("在 CI 裡:actions/setup-python 的 python-version 設 \"3.14\"(或其他方式裝 3.14 並放進 PATH)。")
   221	    return "\n".join(lines) + "\n" + _PY_INSTALL_HINT
