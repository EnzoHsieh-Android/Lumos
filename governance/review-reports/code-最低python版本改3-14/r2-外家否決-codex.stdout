    22	def _py_floor_gate():
    23	    """被 3.14 以前的 Python 以主程式身分執行 → 問同目錄的 lumos 要一支 3.14、用它重跑自己;問不到就報錯回 2、不寫設定
    24	    (Projects/最低Python版本改3.14_計劃 做法第 4 點:舊版的更新程式用舊直譯器叫新版的這支,註冊照樣要寫成 3.14)。
    25	    ★這一段與它之前的程式必須能被 Python 3.9 解析、執行★。"""
    26	    if sys.version_info >= (3, 14):
    27	        os.environ.pop("LUMOS_REEXEC_PYTHON", None)
    28	        return
    29	    prev = os.environ.get("LUMOS_REEXEC_PYTHON")
    30	    if prev and os.path.realpath(prev) == os.path.realpath(sys.executable):
    31	        sys.stderr.write("擋下:已經用 %s 重跑過,它回報的版本仍是 %d.%d;沒寫任何設定。\n" % (prev, *sys.version_info[:2]))
    32	        sys.exit(2)
    33	    lumos = Path(__file__).resolve().parent / "lumos"
    34	    r = None
    35	    if lumos.is_file():
    36	        try:
    37	            r = subprocess.run([sys.executable, str(lumos), "python-path"], stdin=subprocess.DEVNULL,
    38	                               capture_output=True, text=True, timeout=60)
    39	        except (OSError, subprocess.TimeoutExpired):
    40	            r = None
    41	    out = (r.stdout.strip().splitlines() if r is not None and r.returncode == 0 else [])
    42	    if not out or not os.path.isabs(out[-1]):
    43	        sys.stderr.write((r.stderr if r is not None else "找不到同目錄的 lumos,問不到 3.14 在哪。\n")
    44	                         + "擋下:註冊掛鉤需要 Python 3.14;沒寫任何設定。\n")
    45	        sys.exit(2)
    46	    os.environ["LUMOS_REEXEC_PYTHON"] = out[-1]
    47	    argv = [out[-1], os.path.abspath(__file__), *sys.argv[1:]]
    48	    sys.stdout.flush()
    49	    sys.stderr.flush()
    50	    if os.name == "nt":
    51	        sys.exit(subprocess.call(argv))
    52	    os.execv(out[-1], argv)
    53	
    54	
    55	if __name__ == "__main__":
    56	    _py_floor_gate()
    57	
    58	# ── 兩家目標(Projects/Codex完全支援_計劃 d2,2026-09-04)──
    59	# Claude Code:~/.claude/settings.json 的 hooks 段;Codex CLI:~/.codex/hooks.json 頂層 hooks 段。
    60	# 兩者外層 JSON 同形(事件→[{matcher?,hooks:[{type,command,timeout}]}]),內層語意不同:
    61	# matcher 名、payload 形狀、輸出欄位各自查(r1 外家 F2)。★不碰 ~/.codex/config.toml★(stdlib 無 TOML 寫入器)。
    62	def _parse_target(argv):
    63	    """--target claude|codex(預設 claude);值拼錯或缺值 → 擋下(r1 外家 #6:靜默退回 claude 會改錯檔)。"""
    64	    import os
    65	    val = None
    66	    for i, a in enumerate(argv):
    67	        if a.startswith("--target="):
    68	            val = a.split("=", 1)[1]
    69	        elif a == "--target":
    70	            val = argv[i + 1] if i + 1 < len(argv) else ""
    71	    if val is None:
    72	        return "claude"
    73	    if val not in ("claude", "codex"):
    74	        print(f"擋下:--target 只能是 claude 或 codex,給的是 {val!r};沒動任何檔", file=sys.stderr)
    75	        sys.exit(2)
    76	    return val
    77	
    78	
    79	TARGET = _parse_target(sys.argv[1:])
    80	# Codex 的家目錄尊重 CODEX_HOME(Codex 自己就是這樣找 config/hooks 的;r1 外家 #1)
    81	_CODEX_HOME = Path(__import__("os").environ.get("CODEX_HOME") or (Path.home() / ".codex")).expanduser()
    82	if TARGET == "codex":
    83	    SETTINGS = _CODEX_HOME / "hooks.json"
    84	    HOOKS_DIR = _CODEX_HOME / "hooks"
    85	    _HOOKS_SUBDIR = str(HOOKS_DIR).replace("\\", "/") + "/"
    86	else:
    87	    SETTINGS = Path.home() / ".claude" / "settings.json"
    88	    HOOKS_DIR = Path.home() / ".claude" / "hooks"
    89	    _HOOKS_SUBDIR = ".claude/hooks/"
    90	
    91	# 寫進設定的直譯器 = 正在跑這支的那一支(經上面的檢查一定是 ≥3.14);不再用 which("python3")——
    92	# 那常是系統內建的 3.9(Projects/最低Python版本改3.14_計劃 做法第 4 點)
    93	_PY = sys.executable or shutil.which("python3") or shutil.which("python") or "python3"
    94	# W3:${HOME} 只有 POSIX shell 展開;native Windows(Claude Code 經 cmd/PowerShell 跑 hook)
    95	# 不展開 → hook 路徑變字面 ${HOME} → L1/L3 靜默不觸發。Windows 用解析後的絕對 home。
    96	_HOME = str(Path.home()).replace("\\", "/")
    97	
    98	
    99	# ★逾時預算的單一來源★(2026-09-07 全 repo 審視 #14)
   100	#
   101	# 出身:外層天花板寫在這張註冊表、內層逾時寫在各支 hook 裡,兩邊各自演化。量出來的結果:
   102	# 五支裡三支違反自家「外要明顯大於內」的規則,其中一支內層是外層的 2.5 倍。
   103	#
   104	# ★內層 ≥ 外層代表什麼★:內層那條「逾時就 fail-open」的分支**結構上永遠跑不到**——
   105	# 外面會先把整支 hook 砍掉(SIGKILL,繞過 try/except)。影響鏡頭那支的 fail-open 分支裡
   106	# 有「把冷卻窗記號清掉」,跑不到就表示:超時之後那個檔被鎖住 20 分鐘完全不注入,沒人知道。
   107	# **一個為了 fail-open 而寫的分支,自己被 fail-closed 掉了。**
   108	#
   109	# 現在天花板只寫在這裡,並且用 --budget 傳給 hook;hook 自己算內層(見各 hook 的 _inner_budget)。
   110	HOOK_BUDGET = {
   111	    "lumos-entry-hook.py": 10,
   112	    "ci-status-hook.py": 15,
   113	    "impact-hook.py": 30,
   114	    "dispatch-lens-hook.py": 60,
   115	    # ★從 10 提到 40★(2026-09-07;r1 通才席指出提到 30 還是不夠):
   116	    # 它內層要跑圖譜同步檢查,實測需要 25 秒。內層公式是「外層×0.7」,
   117	    # 所以外層 30 只給到 21 秒——★還是撐不完那 25 秒,天花板提了等於沒提★,
   118	    # 使用者只是多等 20 秒拿到同一個「查不到」。40×0.7=28 才真的夠。
   119	    # 代價誠實講:這支掛在收工事件,使用者最壞情況要多等到 28 秒。
   120	    # REVISIT:2026-12-07 量一次這段實際耗時分布;若多數遠低於 25 秒,把天花板調回去
   121	    "check-graph-sync.py": 40,
   122	    # 記憶過期清掃:多數檢查是本機指令(毫秒),慢的是要連遠端問「推了沒」那幾條。
   123	    # 預算用完會明說「還有幾條沒驗到」,不會假裝驗過。
   124	    "memory-sweep.py": 12,
   125	}
   126	
   127	# 有些 hook 除了 --budget 還要別的旗標。★寫在這裡而不是散在下面的註冊表裡★,
   128	# 理由同 HOOK_BUDGET:天花板與旗標都只能有一個來源,否則改一個地方會漏另一個。
   129	HOOK_ARGS = {
   130	    # --quiet 讓它沒事完全不出聲、有話說時走 JSON 通道加安全框。
   131	    # ★不帶 --write★:2026-09-14 代碼審三輪之後改成唯讀——三輪 blocker 全在寫檔上。
   132	    "memory-sweep.py": "--quiet",
   133	}
