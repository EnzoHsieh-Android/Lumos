   136	def _hook_cmd(rel_path):  # rel_path = "verification-rot-check.py"
   137	    # W6:Claude Code 在 Windows 用 Git Bash 跑 hook command → 反斜線會被 shell 吃掉
   138	    # (C:\Users → C:Users → python 找不到 → hook 靜默失敗)。故 Windows 下 python 路徑與
   139	    # home 都用正斜線 + 引號。Unix 保留 ${HOME}(可攜、Mac 已驗)。
   140	    # Codex 目標:命令列帶明確 --harness codex(d2:hook 靠旗標分支,不由 payload 欄位猜家族;
   141	    # 現役五支 hook 都不讀 argv,多帶旗標無害,S1 再各自認旗標)。
   142	    if TARGET == "codex":
   143	        # 絕對路徑(不是 ${HOME}/.codex):CODEX_HOME 可以不在 HOME 底下
   144	        hooks_dir = str(HOOKS_DIR).replace("\\", "/")
   145	        py = _PY.replace("\\", "/") if sys.platform == "win32" else _PY
   146	        _b = HOOK_BUDGET.get(rel_path)
   147	        _bf = f' --budget {_b}' if _b else ''
   148	        _bf += (' ' + HOOK_ARGS[rel_path]) if rel_path in HOOK_ARGS else ''
   149	        return (f'{shlex.quote(py)} "{hooks_dir}/{rel_path}" --harness codex{_bf}' if sys.platform != "win32"
   150	                else f'"{py}" "{hooks_dir}/{rel_path}" --harness codex{_bf}')
   151	    if sys.platform == "win32":
   152	        py = _PY.replace("\\", "/")
   153	        _b = HOOK_BUDGET.get(rel_path)
   154	        _bf = f' --budget {_b}' if _b else ''
   155	        _bf += (' ' + HOOK_ARGS[rel_path]) if rel_path in HOOK_ARGS else ''
   156	        return f'"{py}" "{_HOME}/.claude/hooks/{rel_path}"{_bf}'
   157	    _b = HOOK_BUDGET.get(rel_path)
   158	    _bf = f' --budget {_b}' if _b else ''
   159	    _bf += (' ' + HOOK_ARGS[rel_path]) if rel_path in HOOK_ARGS else ''
   160	    return f'{shlex.quote(_PY)} "${{HOME}}/.claude/hooks/{rel_path}"{_bf}'   # 路徑含空白也要能執行(POSIX 原本沒加引號)
