 14502	def edit_fm_append(fm_lines, key, value):
 14503	    fm = list(fm_lines)
 14504	    item = fmt_list_item(value)
 14505	    tgt = link_target(value)
 14506	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14507	    if key in struct and struct[key][2] == "scalar" and key in LIST_KEYS:
 14508	        cur = _list_scalar_value(fm, key, struct[key][0])
 14509	        if cur and link_target(cur) == tgt:
 14510	            return fm  # 已經有了:原樣回傳,不改寫成清單格式(r2)
 14511	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14512	        struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14513	    if key in struct:
 14514	        s, e, kind = struct[key]
 14515	        if kind != "list":
 14516	            raise ValueError(f"{key} 是{kind}型欄位,append 只能加進清單型欄位")
 14517	        # `key: []` 空清單 → 改寫成多行格式的開頭 `key:`,後面照常插第一項
 14518	        if s == e and TOP_KEY_RE.match(fm[s]) and TOP_KEY_RE.match(fm[s]).group(2).strip() == "[]":
 14519	            fm[s] = f"{key}:"
 14520	        # dedup: 精確 full-target 比對(保留路徑;非子字串、非 basename-only)
 14521	        for j in range(s + 1, e + 1):
 14522	            existing = fm[j].strip()
 14523	            if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14524	                return fm  # 已存在,no-op
 14525	        # 偵測現有項縮排,否則預設 2 空格
 14526	        indent = "  "
 14527	        for j in range(s + 1, e + 1):
 14528	            if fm[j].lstrip().startswith("-"):
 14529	                indent = fm[j][:len(fm[j]) - len(fm[j].lstrip())]
 14530	                break
 14531	        # 插在最後一個非空行之後(避開區塊尾部空行,免在 list 中插出空行)
 14532	        last = e
 14533	        while last > s and not fm[last].strip():
 14534	            last -= 1
 14535	        fm.insert(last + 1, f"{indent}- {item}")
 14536	    else:
 14537	        ins = len(fm)
 14538	        fm.insert(ins, key + ":")
 14539	        fm.insert(ins + 1, f"  - {item}")
 14540	    return fm
 14541	
 14542	
 14543	def edit_fm_remove(fm_lines, key, value):
 14544	    """T1 list 項移除(append 的逆操作,同一套 link_target 精確比對)。
 14545	
 14546	    回傳 (new_fm, removed_count)。removed_count==0 代表沒命中(呼叫端該報錯,
 14547	    不可靜默 no-op——打錯字卻回成功是本函式最該防的失敗)。
 14548	    命中多筆(歷史重複項)一次清乾淨。清完若 list 空了,連 key 行一起移除
 14549	    (留 `key:` 裸鍵會被 YAML 解成 null,doctor/lint 對「有鍵無值」的判讀比沒鍵更糟)。
 14550	    比對用 link_target():`[[A]]` / `[[Folder/A|alias]]` / 純路徑 `x/y.md` 一致處理,
 14551	    保留路徑不做 basename-only(同 append dedup,避免 Systems/X 誤刪 Verification/X)。"""
 14552	    fm = list(fm_lines)
 14553	    tgt = link_target(value)
 14554	    struct = {k: (s, e, kind) for k, s, e, kind in fm_structure(fm)}
 14555	    if key not in struct:
 14556	        raise ValueError(f"這篇筆記沒有 {key} 這個欄位")
 14557	    if struct[key][2] == "scalar" and key in LIST_KEYS:
 14558	        fm = _list_key_scalar_to_list(fm, key, struct[key][0])
 14559	        struct = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14560	    s, e, kind = struct[key]
 14561	    if kind != "list":
 14562	        raise ValueError(f"{key} 是{kind}型欄位,remove 只能從清單型欄位拿掉項目")
 14563	    hits = []
 14564	    for j in range(s + 1, e + 1):
 14565	        existing = fm[j].strip()
 14566	        if existing.startswith("-") and link_target(existing[1:]) == tgt:
 14567	            hits.append(j)
 14568	    if not hits:
 14569	        return fm, 0
 14570	    for j in reversed(hits):
 14571	        del fm[j]
 14572	    # 清完是否還有存活項?沒有就把 key 行也拿掉(空 list 不留裸鍵)
 14573	    struct2 = {k: (a, b, c) for k, a, b, c in fm_structure(fm)}
 14574	    if key in struct2:
 14575	        s2, e2, _ = struct2[key]
 14576	        if not any(fm[j].strip().startswith("-") for j in range(s2 + 1, e2 + 1)):
 14577	            del fm[s2:e2 + 1]
 14578	    return fm, len(hits)
 14579	
