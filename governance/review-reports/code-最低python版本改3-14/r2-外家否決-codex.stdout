    87	def _py_fixed_candidates():
    88	    """固定位置候選 → [路徑]。LUMOS_PYTHON_SEARCH_DIRS 有設就只看那幾個目錄(測試接縫,也給特殊環境用),
    89	    否則是 Homebrew、/usr/local、~/.local/bin、uv 與 pyenv 自己的安裝目錄(路徑很短的環境靠這一段)。"""
    90	    import glob
    91	    over = os.environ.get("LUMOS_PYTHON_SEARCH_DIRS")
    92	    names = ("python.exe",) if os.name == "nt" else ("python3.14", "python3.15", "python3.16", "python3")
    93	    if over is not None:
    94	        return [os.path.join(d, n) for d in over.split(os.pathsep) if d for n in names]
    95	    home = os.path.expanduser("~")
    96	    if os.name == "nt":
    97	        base = os.environ.get("LOCALAPPDATA", "")
    98	        return sorted(glob.glob(os.path.join(base, "Programs", "Python", "Python31[4-9]", "python.exe"))) if base else []
    99	    out = ["/opt/homebrew/bin/python3.14", "/usr/local/bin/python3.14", os.path.join(home, ".local", "bin", "python3.14")]
   100	    out += sorted(glob.glob(os.path.join(home, ".local", "share", "uv", "python", "cpython-3.1[4-9]*", "bin", "python3")))
   101	    out += sorted(glob.glob(os.path.join(home, ".pyenv", "versions", "3.1[4-9]*", "bin", "python3")))
   102	    return out
   103	
   104	
   105	def _py_candidates():
   106	    """找 3.14 的候選順序 → [(說明, argv 前綴或 None=問 uv)](計劃做法第 1 點;python3、python 放最後)。"""
   107	    out = [(n, [n]) for n in ("python3.14", "python3.15", "python3.16")]
   108	    out += [(p, [p]) for p in _py_fixed_candidates()]
   109	    if os.name == "nt":
   110	        out.append(("py -3.14", ["py", "-3.14"]))
   111	    out.append(("uv python find", None))
   112	    out += [(n, [n]) for n in ("python3", "python")]
   113	    return out
   114	
   115	
   116	def _py_which(name):
   117	    """指令名 → 絕對路徑或 None。★Windows 會先在目前目錄找★:git 掛鉤的目前目錄是 repo 根,陌生 repo 放一支
   118	    python3.14.exe 就會被當成候選執行——落在目前目錄底下的一律不收,並改用絕對路徑執行(代碼審 r1 資安席)。"""
   119	    import shutil
   120	    full = shutil.which(name)
   121	    if full is None:
   122	        return None
   123	    full = os.path.abspath(full)
   124	    if os.name == "nt":
   125	        here = os.path.normcase(os.path.realpath(os.getcwd()))
   126	        there = os.path.normcase(os.path.realpath(full))
   127	        if there == here or there.startswith(here.rstrip("\\/") + os.sep):
   128	            return None
   129	    return full
   130	
   131	
   132	def _py_probe(argv, deadline):
   133	    """用這個候選跑一次版本檢查 → (≥3.14 的絕對路徑或 None, 結果說明)。標準輸入接空、有逾時。"""
   134	    import subprocess
   135	    exe = argv[0]
   136	    if os.path.dirname(exe):
   137	        if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
   138	            return None, "不存在"
   139	    else:
   140	        full = _py_which(exe)
   141	        if full is None:
   142	            return None, "沒有這個指令"
   143	        argv = [full, *argv[1:]]
   144	    left = deadline - time.monotonic()
   145	    if left <= 0:
   146	        return None, "整份清單超過 %d 秒,沒試" % _PY_TOTAL_TIMEOUT
   147	    try:
   148	        r = subprocess.run([*argv, "-c", _PY_PROBE], stdin=subprocess.DEVNULL, capture_output=True,
   149	                           text=True, errors="replace", timeout=min(_PY_PROBE_TIMEOUT, left))
   150	    except subprocess.TimeoutExpired:
   151	        return None, "逾時(%s 秒沒回)" % _PY_PROBE_TIMEOUT
   152	    except OSError as e:
   153	        return None, "執行失敗(%s)" % e
   154	    out = (r.stdout or "").strip().splitlines()
   155	    last = out[-1] if out else ""
   156	    if r.returncode == 0 and last.startswith("OK ") and os.path.isabs(last[3:].strip()):
   157	        return last[3:].strip(), "合格"
   158	    if last.startswith("OLD "):
   159	        return None, "版本 %s,低於 3.14" % last[4:].strip()
   160	    return None, "執行失敗(回傳碼 %s,可能是 Windows 商店替身)" % r.returncode
   161	
   162	
   163	def _py_uv_find(deadline):
   164	    """問 uv 要一支 ≥3.14(不找虛擬環境、不准觸發下載)→ 它印的路徑或 None。"""
   165	    import subprocess
   166	    uv = _py_which("uv")
   167	    if uv is None:
   168	        return None
   169	    left = deadline - time.monotonic()
   170	    if left <= 0:
   171	        return None
   172	    try:
   173	        r = subprocess.run([uv, "python", "find", "--system", "--no-python-downloads", ">=3.14"],
   174	                           stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
   175	                           timeout=min(_PY_PROBE_TIMEOUT, left))
   176	    except (subprocess.TimeoutExpired, OSError):
   177	        return None
   178	    path = (r.stdout or "").strip().splitlines()[-1:] if r.returncode == 0 else []
   179	    return path[0] if path and os.path.isabs(path[0]) else None
   180	
   181	
   182	def _py_resolve():
   183	    """找一支 ≥3.14 的直譯器 → (絕對路徑或 None, [(候選, 結果)])。LUMOS_PYTHON 有設就只認它:
   184	    必須是絕對路徑、而且合格,否則停下,不往下找(明寫了要用哪一支的人,不該被默默換成別支)。找到一個就停。"""
   185	    deadline = time.monotonic() + _PY_TOTAL_TIMEOUT
   186	    pinned = os.environ.get("LUMOS_PYTHON", "")
   187	    if pinned:
   188	        if not os.path.isabs(pinned):
   189	            return None, [("LUMOS_PYTHON=" + pinned, "不是絕對路徑(掛鉤與手打時會解析到不同的檔,不收)")]
   190	        path, why = _py_probe([pinned], deadline)
   191	        return path, [("LUMOS_PYTHON=" + pinned, why)]
   192	    tried = []
   193	    for desc, argv in _py_candidates():
   194	        if argv is None:
   195	            if _py_which("uv") is None:
   196	                tried.append((desc, "沒有這個指令"))
   197	                continue
   198	            found = _py_uv_find(deadline)
   199	            if found is None:
   200	                tried.append((desc, "uv 找不到 3.14"))
   201	                continue
   202	            desc, argv = desc + " → " + found, [found]
   203	        path, why = _py_probe(argv, deadline)
   204	        tried.append((desc, why))
   205	        if path:
   206	            return path, tried
   207	    return None, tried
