 14835	def _set_conditions_locked(env, rel, key, values):
 14836	    """驗收紀錄的前提/回頭條件整欄換掉(Projects/驗收前提欄位可改_計劃)。
 14837	
 14838	    ★為什麼整欄換、不走 append/remove★:這兩欄是散文、常提到連結;append/remove 判斷「同一項」看連結目標,
 14839	    兩條提到同一篇的不同條件會被當成重複。原本四種寫法(單行、清單、空的、多行區塊)並存,一律整段拿掉重寫。"""
 14840	    vals = [str(v).strip() for v in values]
 14841	    if not vals or any(not v for v in vals):
 14842	        print(f"擋下:{key} 的每一條都不能是空的,檔案沒動(前提寫這個結論在什麼情況下才算數,回頭條件寫改到什麼該重驗)",
 14843	              file=sys.stderr)
 14844	        return 2
 14845	    if any("\n" in v or "\r" in v for v in vals):
 14846	        print(f"擋下:{key} 一條條件只能一行,檔案沒動(要寫多條就給多個值:lumos set <筆記> {key} \"條件一\" \"條件二\")",
 14847	              file=sys.stderr)
 14848	        return 2
 14849	    path = env.vault / rel
 14850	    lines, _s, e = load_raw_for_edit(path)
 14851	    fm = list(lines[1:e])
 14852	    new = ([f"{key}: {fmt_scalar(key, vals[0])}"] if len(vals) == 1
 14853	           else [f"{key}:"] + [f"  - {fmt_scalar(key, v)}" for v in vals])
 14854	    struct = {k: (a, b) for k, a, b, _kind in fm_structure(fm)}
 14855	    if key in struct:
 14856	        a, b = struct[key]
 14857	        fm[a:b + 1] = new
 14858	    else:   # 插的位置照 edit_fm_scalar:第一個清單或多行區塊欄位之前,都沒有就放最後
 14859	        at = next((a for _k, a, _b, kind in fm_structure(fm) if kind in ("list", "block")), len(fm))
 14860	        fm[at:at] = new
 14861	    atomic_write_verify(path, lines[:1] + fm + lines[e:], key, lambda f: _conds(f.get(key)) == vals)
 14862	    print(f"✓ set {rel}: {key} 整欄換成 {len(vals)} 條" + ("" if len(vals) == 1 else "(一行一項的清單)"))
 14863	    return 0
