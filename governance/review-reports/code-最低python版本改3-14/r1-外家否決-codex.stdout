   173	        return path, [("LUMOS_PYTHON=" + pinned, why)]
   174	    tried = []
   175	    for desc, argv in _py_candidates():
   176	        if argv is None:
   177	            found = _py_uv_find(deadline)
   178	            if found is None:
   179	                tried.append((desc, "沒有 uv,或 uv 找不到 3.14"))
   180	                continue
   181	            desc, argv = desc + " → " + found, [found]
   182	        path, why = _py_probe(argv, deadline)
   183	        if why not in ("不存在", "沒有這個指令"):
