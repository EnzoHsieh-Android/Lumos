+            r = _sp.run([*cand, "-c", "pass"], stdin=_sp.DEVNULL, capture_output=True, timeout=10)
+        except (OSError, _sp.TimeoutExpired):
+            continue
+        if r.returncode == 0:
+            return " ".join(cand)
+    return "python"
