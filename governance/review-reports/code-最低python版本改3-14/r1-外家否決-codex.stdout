def _sync_global_claude(src_repo: Path):
    """相容包裝:Claude 側同步,回 True=ok(既有呼叫/測試用)。三態版見 _sync_global_hooks。"""
    return _sync_global_hooks(src_repo, "claude") == "ok"


def _sync_global_hooks(src_repo: Path, harness: str) -> str:
    """全域 hooks/註冊同步(不需專案;install 與 _install_hooks_py 共用)。harness=claude|codex:
    claude → ~/.claude/hooks + settings.json;codex → ~/.codex/hooks + hooks.json(合併器 --target codex)。
    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)④codex 專用:寫自訂審查席 TOML(d6)。
    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);HOME 隔離可測。
    回三態字串:ok / probe(探針擋下,沒動) / merge-failed(hooks 設定檔壞或合併器非 0,hook 檔已 copy 但註冊沒更新)
    / absent(codex 專用:本機無 codex,跳過)。★不共用一顆布林★——False 曾被呼叫端寫死解讀成 LUMOS_PROBE,
    設定檔壞掉會印出誤導訊息(Projects/Codex完全支援_計劃 r2 邊界 N2)。"""
    # ★r1 正確性席:同 _install_skills——cmd_init/_vendor_toolchain 這條路會經此覆寫真的 ~/.claude/hooks
    # 與動 settings.json,繞過四個指令入口的守衛。擋在變動原語。
    if _refuse_if_probe(f"sync-global-{harness}"):
        return "probe"
    if harness == "codex":
        _ch = _codex_home()
        if _ch.exists() and not _ch.is_dir():   # r1 單reviewer F1:~/.codex 是檔案,mkdir 會炸穿整支 install
            return "home-not-dir"
        if not _codex_present():
            return "absent"
    import subprocess, shutil
    hdir, _ = _HARNESS_HOME[harness]
    chooks = (_codex_home() if harness == "codex" else Path.home() / hdir) / "hooks"
    chooks.mkdir(parents=True, exist_ok=True)
    src_dir = src_repo / "scripts" / "hooks" / "claude"
    for f in _GLOBAL_HOOKS:                   # ① 現役 hooks copy(兩家同一批檔)
        s = src_dir / f
        if s.exists():
            shutil.copy2(s, chooks / f)
    for f in _RETIRED_STUB_CLAUDE_HOOKS:      # ②a 相容期:換 exit 0 空殼,★不刪檔★
        stub = chooks / f                     #     (刪了會炸掉還帶著舊註冊的 session)
        if stub.is_symlink():
            stub.unlink()                     #     symlink 先拆,免得寫穿到來源檔
        stub.write_text(_RETIRED_HOOK_STUB_BODY, encoding="utf-8")
        stub.chmod(0o755)
    for f in _RETIRED_CLAUDE_HOOKS:           # ②b 過了相容期:真刪殘留檔
        stale = chooks / f
        if stale.exists() or stale.is_symlink():
            stale.unlink()
    merge = src_repo / "scripts" / "merge-claude-settings.py"  # ③ merge+prune 懸空(含②剛變懸空的)
    if merge.exists():
        args = [sys.executable, str(merge)] + (["--target", "codex"] if harness == "codex" else [])
        r = subprocess.run(args)
        if r.returncode != 0:              # 合併器只在設定檔 JSON 壞時回 1:別當成功
            return "merge-failed"
    if harness == "codex":                 # ④ 自訂審查席 TOML(d6)——刻意放在合併器之後:設定檔壞掉(merge-failed)就整個 Codex 側不算裝好,
                                           #    TOML 不寫、下次 install --force 再補;hook 檔 copy 在前面已做(自癒無害)(code-codex-d6 r1 單reviewer F3)
        st = _install_codex_agent()
        if st == "created":
            print(f"  ✓ Codex 自訂審查席已寫三份:")
            print(f"      {_CODEX_AGENT_NAME:<22} 散文審(設計審),{_CODEX_SEAT_MODEL} + medium —— 也是預設")
            print(f"      {_CODEX_AGENT_CODE_NAME:<22} 程式碼審(一般風險),{_CODEX_SEAT_MODEL} + xhigh")
            print(f"      {_CODEX_AGENT_MAX_NAME:<22} 程式碼審(高風險),{_CODEX_SEAT_MODEL} + xhigh")
            print(f"    派工詞點名哪一個就用哪一個;0.153.2 實測選得中、0.144.1 忽略;唯讀仍靠父代理 --sandbox read-only")
    return "ok"


_CODEX_AGENT_NAME = "lumos_reviewer"   # 底線:模型 spawn 時會把連字號正規化成底線(2026-09-04 實看)
# 第三種「我方」標記(sentinel HTML 註解給 markdown、.lumos-managed 檔給目錄):TOML 檔只能用行註解當標記,不是另立做法
_CODEX_AGENT_MARK = "# lumos-managed: 由 lumos install 寫入,teardown 收走;改範本請改 scripts/lumos"
_CODEX_AGENT_CODE_NAME = "lumos_reviewer_code"  # 程式碼審(一般風險)
_CODEX_AGENT_MAX_NAME = "lumos_reviewer_max"   # 程式碼審(高風險);09-11 起與一般程式碼審同設定,見下方註解
_CODEX_AGENT_INSTRUCTIONS = """你是 lumos 的外部審查席(乾淨脈絡,不帶編排者的結論)。只讀不寫、不改任何檔。
每條 finding 一行獨立 severity: clean|minor|major|blocker、一行 blocking: 是|否、一行 引句:「逐字出自審材」、引程式碼寫 file: `路徑:行號`。
blocker/major 要附能翻紅的最小重現,附不出標「未能重現」。沒問題的節寫「已讀,無 finding」。最後一行總結最嚴重 severity 與 blocking 條數。"""

# ★三席分流(2026-09-07 立兩席,09-08 Enzo 再裁拆成三席;2026-09-11 Enzo 裁三席一律降到 Sol)★
#
#   散文審(設計審)  lumos_reviewer       sol + medium   ← 也是預設
#   程式碼審(一般)  lumos_reviewer_code  sol + xhigh
#   程式碼審(高風險) lumos_reviewer_max   sol + xhigh
#
# ★2026-09-11 為什麼全部降到 Sol★:外家席額度常撞上限——當天代碼審第二輪,Codex 席跑到一半
#   「You've hit your usage limit」,換 Sol 也一樣被擋到額度重置(額度是整個帳號共用)。
    print(f"  ✓ 全域 {name} hook 清理:移除 {len(removed)} 檔 + 剪懸空我方註冊" if removed
          else f"  ✓ 全域 {name} hook:無我方殘留")
    return True


def _set_hooks_path(root: Path):
    """① git config core.hooksPath(專案本地)。★跟全域同步拆開★——見 _sync_global_from_project。"""
    import subprocess
    subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", "scripts/hooks"])
    print("  ✓ hooks:core.hooksPath 已設")


def _sync_global_from_project(root: Path):
    """②③ 全域 hooks/settings 同步,來源=專案 vendored copy。

    ★呼叫時機很要緊:必須在 vendored 檔案已經被更新之後★(2026-09-06 全 repo 審視 #5)。
    原本這兩件跟 core.hooksPath 綁在同一支 _install_hooks_py,而它在 _vendor_toolchain 裡
    排在 filecmp 自癒迴圈★之前★——於是 `lumos update` 會拿「更新前」的舊副本去覆蓋全域
    ~/.claude/hooks,把整台機器最核心的收工 hook 靜默換成六月版(實測 30912B → 15303B),
    訊息還印綠燈;舊版的 settings merger 甚至會把已撤除的 hook 註冊加回去。
    """
    for _h in ("claude", "codex"):
        print(_sync_msg(_h, _sync_global_hooks(root, _h)))


def _install_hooks_py(root: Path):
    """相容外殼:兩件一起做。★新程式碼請分開呼叫★,尤其是「先更新 vendored 再同步全域」
    那條路(_vendor_toolchain);這支留給「來源就是最新」的呼叫點(cmd_init 的新建路徑)。"""
    _set_hooks_path(root)
    _sync_global_from_project(root)


def _confirm_tty(prompt):
    """三階互動確認(curl|bash 安全;設計:Projects/bootstrap一鍵對稱_計劃 std F1/F2/F3):
    回 True(答 y/yes)/False(其他答案=拒絕)/None(非互動或無人回答→呼叫端跳過)。
    ①stdin.isatty→input();EOFError 落入②非當 False(isatty 撒謊時別誤判拒絕)
    ②os.open(tty,O_RDWR) 低階 fd(★r+ 開法對 tty 會炸 not seekable★)+os.write prompt
      +select timeout(有控制終端≠有人回答,防 readline 永久掛)+os.read
    ③皆不可→None。嚴禁在非 isatty 時讀 sys.stdin(curl|bash 下那是腳本殘文管線)。
    測試接縫:LUMOS_TTY(預設 /dev/tty;單元測指 pty slave)/LUMOS_TTY_TIMEOUT(預設 30s)。"""
    import os, select

