   190	def _py_floor_message(tried, head="需要 Python 3.14 以上"):
   191	    lines = ["擋下:%s,現在是 %d.%d.%d(%s)。" % (head, *sys.version_info[:3], sys.executable)]
   192	    lines.append("找過的候選:" + ("" if tried else "沒有任何一個存在"))
   193	    lines += ["  %s:%s" % (d, w) for d, w in tried]
   194	    return "\n".join(lines) + "\n" + _PY_INSTALL_HINT
   195	
   196	
   197	def _py_floor_gate():
   198	    """lumos 以主程式身分被 3.14 以前的 Python 啟動 → 找 3.14 用它重跑同一組參數;找不到印說明回 2(做法第 2 點)。
   199	    版本夠就只清掉防重跑變數;LUMOS_PYTHON 不會讓一支已經是 3.14 的 lumos 重跑(指到包裝腳本時會無限重跑)。"""
   200	    if sys.version_info >= _PY_FLOOR:
