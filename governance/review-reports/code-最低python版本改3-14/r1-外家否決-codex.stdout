+def _pick_windows_launcher():
+    """Windows 的 lumos.cmd 要寫哪個啟動指令 → 字串。依序試 py -3、python3、python,★實際執行成功才算★
+    (Windows 的商店替身 python.exe 找得到、執行卻失敗);都不行退回 python。仍然只寫指令名、不寫絕對路徑
+    (版本管理工具換 exe 是常態);版本交給 lumos 開頭的檢查(Projects/最低Python版本改3.14_計劃 做法第 5 點)。
+    精簡版只試 python3、python 而且只看名字在不在——完整版刻意多一個 py、而且要真的跑得起來,分岔是刻意的。"""
+    import shutil as _shutil
+    import subprocess as _sp
+    for cand in _WIN_LAUNCHERS:
+        if _shutil.which(cand[0]) is None:
+            continue
+        try:
+            r = _sp.run([*cand, "-c", "pass"], stdin=_sp.DEVNULL, capture_output=True, timeout=10)
+        except (OSError, _sp.TimeoutExpired):
+            continue
+        if r.returncode == 0:
+            return " ".join(cand)
+    return "python"
+
