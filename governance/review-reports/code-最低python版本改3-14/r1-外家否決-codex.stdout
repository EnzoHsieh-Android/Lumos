#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Enzo Hsieh
# SPDX-License-Identifier: MIT
# MIT licensed. Full text: scripts/lumos header, or LICENSE at
# https://github.com/EnzoHsieh-Android/Lumos
# Git pre-push hook — 圖譜健康同步把關(push 前最後一道,同步可見)
#
# 為什麼需要:
#   L2 pre-commit 只擋「污染指紋 + code 無圖譜」,不跑完整 doctor。
#   壞圖譜狀態(斷連結 / orphan / verified_by 漏寫 / plan_refs 斷鏈)能 commit 過。
#   CI push 觸發雖會抓,但**非同步、終端看不到、擋不了**(push 已發生)。
#   pre-push 在 push 前**同步**跑 lumos doctor:Claude Code / 終端當場看到輸出,
#   有問題擋下 push,壞圖譜出不了本機。self-contained(lumos 零 Obsidian 依賴)。
#
# Bypass: git push --no-verify(業界標準;GitHub Actions CI(.github/workflows/ci.yml)在 push 後仍會跑全套+doctor --ci+anchor verify)
#
# 安裝: scripts/install-hooks.sh 已設 core.hooksPath=scripts/hooks,此檔放進去即生效

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# ── stdin 必須最先讀(prepush範圍修法 #1)──
# githooks(5):每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"。
# 先整批讀進陣列——後段的 anchor verify/測試/doctor 都是 subprocess,會繼承並吃掉 fd0,
# 若不先讀,推送範圍就丟了。無 stdin 行(如手動測試)=空陣列,代碼風險段自然跳過。
_PP_LINES=()
while IFS= read -r _line; do
  [[ -n "$_line" ]] && _PP_LINES+=("$_line")
done

_ZERO="0000000000000000000000000000000000000000"
_EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"

# 一個 ref 的檢查範圍:$1=remote_sha $2=local_sha。
# 新 ref、或本地沒有那個 remote 物件(shallow / force-push 分岔沒 fetch)→ 保守掃全部引入內容
# (不是 fail-open:放行會讓「推個新分支」變成穩定繞法)。其餘走增量。
pp_range_for() {
  if [[ "$1" == "$_ZERO" ]] || ! git cat-file -e "$1" 2>/dev/null; then
    printf '%s..%s' "$_EMPTY_TREE" "$2"
  else
    printf '%s..%s' "$1" "$2"
  fi
}

# 這次推送總共改到哪些檔(所有 ref 的聯集,一行一個)。寫進暫存檔,回印路徑;算不出來回空字串。
# ★給圖譜健康那一段用★:逾期的預告合約,本機這一層只擋「這次碰到的」那幾條,
# 別人的逾期不該擋掉你的推送(被擋的人解不開別人的合約)。CI 不給這份清單,那邊照舊擋全部。
pp_touched_file() {
  local _f _r
  [[ -n "$_EMPTY_TREE" ]] || return 0
  # ★放進 $_PP_TMP,不要自己另外 mktemp 一個檔★(代碼審 r1 架構席):那個目錄有 trap 在收,
  # 正常結束、exit 1、Ctrl-C、被砍都會清掉。自己逐處 rm 會在「還沒回傳路徑就被打斷」時漏掉
  # ——這支腳本前面那段註解就是為了同一種漏而寫的,不要再走一次同一條路。
  [[ -n "$_PP_TMP" && -d "$_PP_TMP" ]] || return 0
  _f="$_PP_TMP/touched.txt"
  : > "$_f" 2>/dev/null || return 0
  for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
    read -r _ _lsha _ _rsha <<< "$_ppl"
    [[ "$_lsha" == "$_ZERO" ]] && continue
    _r="$(pp_range_for "$_rsha" "$_lsha")"
    git diff --no-ext-diff --no-textconv --name-only "$_r" >> "$_f" 2>/dev/null || true
  done
  if [[ -s "$_f" ]]; then printf '%s' "$_f"; else rm -f "$_f"; fi
}

# 沒有 scripts/lumos → 降級放行(不為缺環境 brick push,CI 兜底);有 lumos 卻找不到 Python 3.14 → 擋下
# (Projects/最低Python版本改3.14_計劃 做法第 3 點;PY 在下面讀完設定後才決定)
GRAPHCTL="$REPO_ROOT/scripts/lumos"
PY=""
# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
_lumos_any_python() {
  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""
  for _c in python3.14 python3.15 python3.16; do
    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
  done
  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
  else
    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
  fi
  _ifs="$IFS"; IFS=":"
  for _d in $_dirs; do
    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
  done
  IFS="$_ifs"
  for _c in python3 python; do
    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
  done
  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
  return 1
}
_LUMOS_NO_PY_MSG="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
# ── python-launcher end ──
# ── python-314 begin(pre-commit 與 pre-push 內嵌同一段):用上面找到的 python 問 lumos 要一支 3.14 的絕對路徑,
# 之後這支掛鉤的呼叫都用它;找不到就讓會擋的閘擋下,★不退回舊版 Python 跑檢查★(Projects/最低Python版本改3.14_計劃 [S3])。
_lumos_py314() {
  LUMOS_PY=""; _LUMOS_PY_ERR=""
  if ! _lumos_any_python; then _LUMOS_PY_ERR="$_LUMOS_NO_PY_MSG"; return 1; fi
  _out=""
  if _out="$("$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$REPO_ROOT/scripts/lumos" python-path 2>&1)"; then
    LUMOS_PY="$(printf '%s\n' "$_out" | tail -n 1 | tr -d '\r')"
    if [ -n "$LUMOS_PY" ]; then return 0; fi
  fi
#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Enzo Hsieh
# SPDX-License-Identifier: MIT
# MIT licensed. Full text: scripts/lumos header, or LICENSE at
# https://github.com/EnzoHsieh-Android/Lumos
# Git pre-commit hook — 圖譜同步硬擋 (L2)
#
# 設計理由 (2026-05-25 從 PreToolUse 搬家):
#   舊版 L2 在 Claude Code PreToolUse 攔 `git commit`,但 staged 區在 -a/-am
#   flag 跟 `git commit <path>` 場景下 hook 看到的是空的 (因 -a 在 git 程序內
#   部才 stage), 造成 silent 漏網。教 PreToolUse 解 git command 是追 git 尾巴
#   永遠補不完,根因是「攔截點不對」。改放到 git pre-commit hook,git 內部
#   已決定最終 staged 內容,所有 commit 形態(-a/-am/<path>/--amend)都涵蓋。
#
# Bypass: 用業界標準 `git commit --no-verify` (有儀式感、code review 看得到、
#         比自製 `[no-graph]` marker 難被無意識濫用)
#
# 安裝:
#   git config core.hooksPath scripts/hooks
#   (一次設定,之後 git 自動跑此 hook)

set -u

# 找專案 root (避免在 submodule / worktree 出錯)
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 0

# 找圖譜目錄 (docs/{slug}-knowledge/)
GRAPH_ROOT=""
if [[ -d docs ]]; then
  for d in docs/*-knowledge; do
    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
  done
  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
fi

# Gate 0: 圖譜不存在 → 放行
[[ -z "$GRAPH_ROOT" ]] && exit 0

# 拿最終 staged (git 在 pre-commit 時 staged 已確定,-a/-am/path 都涵蓋)
# core.quotePath=off: 避免 git 對中文/non-ASCII 路徑加雙引號 ("docs/.../節點.md"),
# 否則 L65 grep "^${GRAPH_ROOT}/..." 比對不到 → 圖譜檔已 staged 仍誤判為未同步擋下
STAGED="$(git -c core.quotePath=off diff --cached --name-only)"
[[ -z "$STAGED" ]] && exit 0  # 空 commit 不擋

# Gate CC (advisory): co-change 漏改警告 —— 恆不影響 rc(|| true 隔離)。
# 必須在 Gate 1 之前:後面每條路徑都顯式 exit,「末段」是不可達死碼;
# docs-only commit 在 Gate 2 就 exit 0,唯有這裡能覆蓋主場景(改文件漏同步夥伴)。
# 警告走 stdout(2>/dev/null 只吞診斷,含版本偏斜時舊 vendored lumos 的 argparse 錯)。
# ── python-launcher begin(三支 git 掛鉤與四支安裝腳本內嵌同一段,t_python_launcher_blocks_agree 逐字守一致)──
# 只負責找一支任何版本的 python 把 lumos 叫起來;版本判斷全交給 lumos(Systems/python直譯器選擇)。
# 固定位置排在 python3 前面:圖形用戶端的 PATH 很短,先執行 /usr/bin/python3 會在沒裝開發工具的 Mac 跳安裝對話框。
# LUMOS_PYTHON_SEARCH_DIRS(冒號分隔)有設就換掉固定位置——測試接縫,跟 lumos 內部那份同一個。
_lumos_any_python() {
  _LUMOS_ANY_EXE=""; _LUMOS_ANY_ARG=""
  for _c in python3.14 python3.15 python3.16; do
    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
  done
  if [ -n "${LUMOS_PYTHON_SEARCH_DIRS+x}" ]; then
    _dirs="$LUMOS_PYTHON_SEARCH_DIRS"
  else
    _dirs="/opt/homebrew/bin:/usr/local/bin:${HOME:-/nonexistent}/.local/bin"
  fi
  _ifs="$IFS"; IFS=":"
  for _d in $_dirs; do
    if [ -n "$_d" ] && [ -x "$_d/python3.14" ]; then IFS="$_ifs"; _LUMOS_ANY_EXE="$_d/python3.14"; return 0; fi
  done
  IFS="$_ifs"
  for _c in python3 python; do
    if command -v "$_c" >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v "$_c")"; return 0; fi
  done
  if command -v py >/dev/null 2>&1; then _LUMOS_ANY_EXE="$(command -v py)"; _LUMOS_ANY_ARG="-3"; return 0; fi
  return 1
}
_LUMOS_NO_PY_MSG="找不到任何 python(試過 python3.14、python3.15、python3.16、固定位置、python3、python、py)。
安裝 3.14:macOS 用 brew install python@3.14 或 uv python install 3.14;Linux 用發行版的 python3.14 套件或 uv;
Windows 用 python.org 的安裝器或 winget install Python.Python.3.14。裝在別處就設 LUMOS_PYTHON=<那支 3.14 的絕對路徑>。"
# ── python-launcher end ──
# ── python-314 begin(pre-commit 與 pre-push 內嵌同一段):用上面找到的 python 問 lumos 要一支 3.14 的絕對路徑,
# 之後這支掛鉤的呼叫都用它;找不到就讓會擋的閘擋下,★不退回舊版 Python 跑檢查★(Projects/最低Python版本改3.14_計劃 [S3])。
_lumos_py314() {
  LUMOS_PY=""; _LUMOS_PY_ERR=""
  if ! _lumos_any_python; then _LUMOS_PY_ERR="$_LUMOS_NO_PY_MSG"; return 1; fi
  _out=""
  if _out="$("$_LUMOS_ANY_EXE" ${_LUMOS_ANY_ARG:+"$_LUMOS_ANY_ARG"} "$REPO_ROOT/scripts/lumos" python-path 2>&1)"; then
    LUMOS_PY="$(printf '%s\n' "$_out" | tail -n 1 | tr -d '\r')"
    if [ -n "$LUMOS_PY" ]; then return 0; fi
  fi
  _LUMOS_PY_ERR="$_out
(叫 lumos 用的是 $_LUMOS_ANY_EXE${_LUMOS_ANY_ARG:+ $_LUMOS_ANY_ARG};它一執行就失敗的話,可能是 Windows 商店替身)"
  return 1
}
_lumos_block_no_py314() {
  { echo ""; echo "擋下:這一道檢查要用 Python 3.14 跑 lumos,但找不到。"
    printf '%s\n' "$_LUMOS_PY_ERR" | sed 's/^/   /'
    echo "出口:裝 3.14,或設 LUMOS_PYTHON=<3.14 的絕對路徑>;真的要先過只能加 --no-verify(提交會記進跳過帳),不會改用舊版 Python 跑檢查。"
    echo ""; } >&2
}
# ── python-314 end ──
# CC_PY = 一支 3.14 的絕對路徑;有 scripts/lumos 卻找不到 3.14 時留空,只提醒的閘跳過、會擋的閘在 Gate PY 擋下
CC_PY=""
if [ -f "$REPO_ROOT/scripts/lumos" ] && _lumos_py314; then CC_PY="$LUMOS_PY"; fi
if [ -n "$CC_PY" ]; then
  "$CC_PY" "$REPO_ROOT/scripts/lumos" cochange check --staged 2>/dev/null || true
else
  echo "提醒:這台機器找不到 Python 3.14 或 scripts/lumos,所以「漏改夥伴檔」的提醒這次沒跑。" >&2
fi

# Gate DG: code 側刪除傳播守衛 (advisory;spec=Projects/code側刪除傳播守衛_計劃)
# 警告走 stdout(2>/dev/null 只吞診斷);|| true 只兜 crash,hang 由 lumos 內部 deadline 兜(fail-open)
# -f 必檢:沒有 scripts/lumos 的 repo(未 vendored)只有 CC_PY 也會跑,python 報「can't open file」
if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
  "$CC_PY" "$REPO_ROOT/scripts/lumos" delguard --staged 2>/dev/null || true
fi

# Gate 1: 圖譜污染指紋 (2026-06-13 對抗審計 P0)
# 攔 notesmd-cli `frontmatter --edit` 的副作用: 日期欄位加引號 (Obsidian property
# 型別 date→text 靜默損傷,且通常伴隨整篇 frontmatter 鍵序重排)。
# 必須放在 Gate 2 之前 — 污染 commit 是 docs-only,Gate 2 的 code 判定對它直接放行。
if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
  polluted="$(git -c core.quotePath=off diff --cached -- "$GRAPH_ROOT" \
    | grep -E '^\+[[:space:]]*(date|created|updated|decided|ended):[[:space:]]*"[0-9]{4}-[0-9]{2}-[0-9]{2}"' || true)"
  if [[ -n "$polluted" ]]; then
    {
      echo ""
      echo "擋下:有筆記的日期欄位被加上了引號(例如 created: \"2026-08-21\")。"
      echo "這幾乎都是某個編輯工具順手改的,不是人打的;它會讓日期欄位變成純文字,而且通常整篇欄位順序都被重排——這種 diff 沒辦法審。"
      echo ""
      echo "被改到的行:"
      echo "$polluted" | head -5 | sed 's/^/   /'
      echo ""
      echo "看完整改動:"
      echo "   git diff --cached -- ${GRAPH_ROOT}"
      echo "還原那個檔:"
      echo "   git checkout -- <檔案>"
      echo "真的是刻意要這樣(非常少見)→ git commit --no-verify"
      echo ""
    } >&2
    exit 1
  fi
fi

# Gate PY: 下面 L/H/NS 三道會擋的檢查要用 3.14 跑 lumos;有 scripts/lumos 卻找不到 3.14 就在這裡擋下,
# 不退回舊版 Python、也不像以前那樣整段跳過(Projects/最低Python版本改3.14_計劃 做法第 3 點)。
if [[ -f "$REPO_ROOT/scripts/lumos" && -z "$CC_PY" ]]; then
  _lumos_block_no_py314
  exit 1
fi

# Gate L: staged 圖譜 .md 逐檔 lumos lint (2026-08-21 體檢 #6)
# 為什麼:lint 自 2026-06 起沒有任何 hook/CI 呼叫,它的每條鐵則(YAML list/白名單/枚舉/frontmatter
# 閉合)全靠人記得跑——「有機制,沒接線」。硬擋:lint rc≠0 即擋,訊息原樣轉出。
# 只跑 staged 的圖譜檔(每檔 <1s),不跑全 vault。找不到 python/lumos → 跳過(與 Gate CC 同語意)。
if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
  lint_fail=0
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    [[ -f "$f" ]] || continue          # 刪除的檔不 lint
    # ★傳 vault 相對路徑、去 .md★——lumos lint 的精確比對鍵是 vault 相對的「Systems/foo」;
    # 丟 repo 相對路徑會落到 stem 查找,同檔名不同資料夾時 lint 到別的節點、壞的放行(code-loop r1 s1)。
    rel="${f#$GRAPH_ROOT/}"; rel="${rel%.md}"
    if ! out="$("$CC_PY" "$REPO_ROOT/scripts/lumos" lint "$rel" 2>&1)"; then
      lint_fail=1
      { echo ""; echo "擋下:這篇筆記的格式檢查沒過——$f"; echo "$out" | sed 's/^/   /'; } >&2
    fi
  done < <(echo "$STAGED" | grep -E "^${GRAPH_ROOT}/.*\.md$" || true)
  if [[ "$lint_fail" == 1 ]]; then
    { echo ""; echo "格式錯的筆記進了版控,之後的工具會讀錯(合約標記消失、連結變鬼節點)。照上面的提示修好再 commit。"; echo "真的要先進去 → git commit --no-verify,並在訊息裡留一句為什麼。"; echo ""; } >&2
    exit 1
  fi
fi


# Gate H: 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S25]):每支程式檔要有一篇管它的節點、
# 節點只准寫自己家的檔、寫回要落在改動檔的家——新違規擋,舊帳交給健檢提醒。判定全在 lumos 裡,這裡只呼叫。
# ★要放在「改程式沒動圖譜」那道之前★:那道只要有圖譜筆記加進索引就提早放行離開,放後面等於只在最不需要的時候才跑。
# 合併提交由 lumos 自己判斷跳過(推送前會把合併的結果整段查一次)。
# 「該動哪篇」的點名(原本在這裡呼叫 impact --sync-only,以反引號為種子)也改由它照家算——
