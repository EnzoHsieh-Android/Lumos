     def _ids(x):
         return set(x) if isinstance(x, (list, dict)) else set()
     cnt = {}
     for r in carriers:
         fo, bad = _ids(r.get("folded_set")), _ids(r.get("accepted_set")) | _ids(r.get("refuted_set"))
         for i, names in r["finding_seats"].items():
