 _SEAT_NOISE_DAYS = 56
 _SEAT_NOISE_FEW = 10
-_SEAT_ROUND_MARK_RE = re.compile(r"(?:-?r\d+|\d+)(?=-[A-Za-z][\w.]*$)")
+_SEAT_SPLIT_RE = re.compile(r"^(.*?)-(?=[A-Za-z])(.*)$")
+
+
+def _seat_noise_name(name):
+    """逐席段的席名:只去夾在角色與模型尾碼之間的輪次記號,模型名裡的數字不動(代碼審 r1:gemini-2/3、gpt-5.6 原本被切壞)。
+    角色=第一個後面接英文字母的連字號之前;角色尾巴的數字(緊跟中文字的 r2 也算)只在角色含非 ASCII 字(中文席名)時才去;尾碼開頭的 r2- 才去。"""
+    m = _SEAT_SPLIT_RE.match(name)
+    if not m:
+        return name
+    role, rest = m.groups()
+    rest = re.sub(r"^r\d+-(?=[A-Za-z])", "", rest)
+    bare = re.sub(r"(?:(?<=[^\x00-\x7f])r)?\d+$", "", role)   # r 只在緊跟中文字時算輪次記號(finder2 不能切成 finde)
+    if bare != role and re.search(r"[^\x00-\x7f]", bare):
+        role = bare
+    return f"{role}-{rest}"
 
 
 def _seat_noise_window_start(cutoff):
     """逐席段的起算點(UTC 秒):gov 已算好的起算日(本地午夜)與「現在往前 56 天」取較晚的。"""
     import datetime as _dtm
     floor = _dtm.datetime.now().astimezone().timestamp() - _SEAT_NOISE_DAYS * 86400
     try:
         return max(_dtm.datetime.fromisoformat(str(cutoff)).astimezone().timestamp(), floor)
     except ValueError:
         return floor
 
 
