+# [[Projects/Android形狀列補規則_計劃]] 範圍 1、4:會擋(樣本外 294 處抽 40 處誤報 3)。awaitAll KDoc 與 IntelliJ 檢查
+# MapAwaitOnCollectionOfDeferred 都只講 map,不收 forEach;接收者以 .asFlow() 結尾的不報(Flow 一筆一筆來,沒有集合可 awaitAll)
+id: kt-map-await-deferred
+language: kotlin
+severity: error
+message: '[API-2]對 Deferred 清單用 map 逐一 await,要等到失敗的那個才會失敗;改用 awaitAll(),任一個失敗就立刻失敗'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**', '**/src/testFixtures/**', '**/src/*Test/**', '**/src/sharedTest/**', '**/*-test/src/**', '**/*testing/src/**', '**/src/debug*/**']
+rule:
+  any:
+    - pattern: $L.map { it.await() }
+    - pattern: $L.map { $X -> $X.await() }
+constraints:
+  L:
+    not:
+      regex: '\.asFlow\(\)$'
