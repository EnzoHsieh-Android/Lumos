index 000000000..b59247c61
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/rules-unwired/compose.yml
@@ -0,0 +1,26 @@
+# [[Projects/Android形狀列補規則_計劃]] 範圍 1、4:不接閘(樣本外 311 處抽 40 處誤報 6,區塊裡其實有該清理的東西但名字不在註冊字表)。
+# 沒有註冊任何東西卻寫空的 onDispose;有註冊的那半歸會擋的 UI-32(rules/compose.yml),
+# 兩條用同一份 utils/has-registration-call 判斷,同一段 DisposableEffect 只會被其中一條報
+id: kt-compose-dispose-not-needed
+language: kotlin
+severity: hint
+message: '[UI-33]DisposableEffect 沒有要清理的東西卻寫空的 onDispose,官方說這不是好做法;改用 LaunchedEffect(key) 或 SideEffect'
+ignores: ['**/src/test*/**', '**/src/androidTest*/**', '**/src/testFixtures/**', '**/src/*Test/**', '**/src/sharedTest/**', '**/*-test/src/**', '**/*testing/src/**', '**/src/debug*/**']
+rule:
+  any:
+    - pattern: DisposableEffect($$$) { $$$ }
+    - pattern: DisposableEffect { $$$ }
+  has:
+    pattern: onDispose { }
+    stopBy: end
+  all:
+    - not:
+        matches: has-registration-call
+    # 別的分支有真正清理時,提早結束那支只能寫空 onDispose(API 規定每條分支都要回傳),不報;全部的 onDispose 都空才報
+    - not:
+        has:
+          stopBy: end
+          all:
+            - pattern: onDispose { $$$ }
+            - not:
+                pattern: onDispose { }
