+# 「區塊裡有註冊監聽的呼叫」共用判斷([[Projects/Android形狀列補規則_計劃]] 範圍 1,從 UI-32 規則 kt-compose-dispose-empty-cleanup 抽出):
+# 命中=節點底下(往下找到底)有一個呼叫,名字是 add…Listener/Observer/Callback、register…、subscribe、setOn…Listener、listen,
+# 不論前面有沒有接收者。UI-32(有註冊卻留空 onDispose,會擋)與 UI-33(沒註冊卻寫空 onDispose,只登記)用同一份,分界不會漂。
+id: has-registration-call
+language: kotlin
+utils:
+  registration-name:
+    kind: simple_identifier
+    regex: ^(add\w*(Listener|Observer|Callback)|register\w*|subscribe|setOn\w+Listener|listen)$
+rule:
+  has:
+    stopBy: end
+    kind: call_expression
+    any:
+      - has:
+          matches: registration-name
+      - has:
+          kind: navigation_expression
+          has:
+            kind: navigation_suffix
+            has:
+              matches: registration-name
