++def _rg_balanced(s, i):
++    """s[i] 是左括號 → 對應右括號的位置(找不到回 len(s))。字串與註解要先剝掉。"""
++    depth = 0
++    for j in range(i, len(s)):
++        c = s[j]
++        if c in "([{":
++            depth += 1
++        elif c in ")]}":
++            depth -= 1
++            if depth == 0:
++                return j
++    return len(s)
++
