++    database.identityHash 的 JSON 才算;讀不懂而看得出是 Room 結構檔的(含 formatVersion 或 identityHash 字樣)記成 None,
++    problems 不是 None 時順便記一條擋下([S38])。where 是空樹或 None → {}。"""
++    if where is None or where == _EMPTY_TREE_SHA:
++        return {}
++    lst = _nodehome_list(root, where)
++    if lst is None:
++        return None
++    read = _nodehome_reader(root, where)
++    out = {}
++    for p in lst[0]:
++        m = _RG_SCHEMA_PATH_RE.search(p)
++        if not m:
++            continue
++        t = _rg_text(read, p) or ""
++        try:
++            d = json.loads(t)
++            h = d["database"]["identityHash"] if isinstance(d, dict) and "formatVersion" in d else None
++            if not isinstance(h, str):
++                continue
++        except Exception:
++            if "identityHash" not in t and "formatVersion" not in t:
++                continue
++            h = None
++            if problems is not None:
++                problems.append(("schema", f"結構檔讀不懂:{p}(合併衝突沒解乾淨、截斷或不是 UTF-8)——改好或重新編譯產生再提交"))
++        out.setdefault(m.group(1), {})[int(m.group(2))] = h
++    return out
++
++
++def _rg_mig_state(root, where):
++    """某個提交非測試路徑的升級邊與判不出的寫法數、含 fallbackToDestructiveMigration 與否 → (邊, 判不出數, 有清空寫法) 或 None。"""
++    paths = _rg_grep(root, where, "Migration")
++    if paths is None:
++        return None
++    read = _nodehome_reader(root, where) if paths else None
++    edges, unres, destructive = [], 0, False
++    for p in paths:
++        if _rg_is_test_path(p):
++            continue
++        t = _rg_strip(_rg_text(read, p) or "")
++        e, u = _rg_edges(t)
++        edges += e
++        unres += u
++        destructive = destructive or "fallbackToDestructiveMigration" in t
++    return edges, unres, destructive
++
