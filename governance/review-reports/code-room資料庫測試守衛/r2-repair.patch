++def _rg_dao_need_tests(root, tip, read, need, out):
++    """改到的 DAO 方法:全庫要有真 Room 測試([S25]),每個方法要有沒 mock 這個 DAO 的測試呼叫它([S22][S24])。"""
++    real = [p for p in _rg_tests_calling(root, tip, read, "atabaseBuilder", _RG_BUILDER_RE)
++            if not _RG_ROOM_MOCKED_RE.search(_rg_strip(_rg_text(read, p) or ""))]
++    if not real:
++        out["dao"].append("改到的 DAO 方法沒有任何用真 Room 的測試(測試路徑裡找不到 inMemoryDatabaseBuilder 或 databaseBuilder):"
++                          + "、".join(f"{d}.{m}" for d, m in need)
++                          + "——mock DAO 證不了 SQL、資料限制與交易;用記憶體資料庫寫一支測試")
++        return
++    for dao, name in need:
++        hits = _rg_tests_calling(root, tip, read, name, re.compile(rf"\.{re.escape(name)}\s*\("))
++        mock_re = re.compile(rf"mockk\s*<\s*{dao}\s*>|mockk\s*\(\s*{dao}\b|mock\s*\(\s*{dao}\s*(?:::|\.)class"
++                             rf"|@MockK?\b[^\n]*\n?\s*(?:\w+\s+)*\w+\s*:\s*{dao}\b|@Mock\b\s+(?:\w+\s+)*{dao}\s+\w+")
++        if any(not mock_re.search(_rg_strip(_rg_text(read, p) or "")) for p in hits):
++            continue
++        why = f"只有把 {dao} 做成 mock 的測試呼叫它,mock 的測試不算" if hits else f"沒有測試以 .{name}( 呼叫它"
++        out["dao"].append(f"{dao}.{name} 這次改了,{why}——補一支用真的 Room(記憶體資料庫)驗結果的測試")
++
++
++def _rg_dao_half(root, start, tip, out):
++    """DAO 與型別轉換那半([S22] 到 [S29]):problems/warns 寫進 out["dao"]/out["warns"];回判了幾個方法。"""
++    hk = _rg_hunks(root, start, tip)
++    if hk is None:
++        out["warns"].append("git 算不出這次的差異,DAO 那半這次沒檢查")
++        return 0
++    need, convs = _rg_dao_changes(root, tip, *hk)
++    read = _nodehome_reader(root, tip)
++    for name in convs:
++        if not _rg_tests_calling(root, tip, read, name, re.compile(rf"\b{re.escape(name)}\b")):
++            out["warns"].append(f"型別轉換 {name} 沒有測試提到它(經 DAO 存取一圈測也可以,這條只提醒)")
++    if need:
++        _rg_dao_need_tests(root, tip, read, need, out)
++    return len(need)
