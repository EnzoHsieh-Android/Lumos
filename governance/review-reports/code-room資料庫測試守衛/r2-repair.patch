++def _rg_check_sources(db_src, tip_s, changed, allow, out):
++    """原始碼那邊的兩條:這一版的結構檔沒提交([S5])、沒匯出結構檔只提醒([S17])。"""
++    for fq, d in db_src.items():
++        tq = fq if fq in tip_s else next((k for k in tip_s if k.endswith("." + d["name"])), None)
++        if d["export_false"]:
++            if d["path"] in changed:
++                out["warns"].append(f"{fq} 寫了 exportSchema = false,沒匯出結構檔,這道判不了它的升級")
++            continue
++        top = max(tip_s.get(tq, {}) or [0])
++        if d["version"] is not None and d["version"] > top and fq not in allow:
++            out["problems"].append(("schema", f"{fq} 的 @Database 寫 version = {d['version']},結構檔最大只到 {top}:這一版的結構檔沒提交"
++                                              f"(多半沒重新編譯或沒加進提交)——編譯一次,把 {fq}/{d['version']}.json 加進提交"))
++
++
++def _rg_check_rewrites(fq, tq, fvs, ctx, out):
++    """主線分岔點上已有的結構檔:被刪([S15])或 identityHash 被改([S8])。"""
++    tvs, owner = ctx["tip_s"][tq], ctx["hash_owner"]
++    for v, h in fvs.items():
++        if v not in tvs and h not in owner:
++            out["problems"].append(("schema", f"主線上已有的結構檔被刪掉:{fq}/{v}.json"))
++        elif v in tvs and h and tvs[v] and tvs[v] != h:
++            msg = (f"主線上已有的結構檔被改寫:{tq}/{v}.json 的 identityHash 變了——多半是結構改了忘記升版號;"
++                   f"結構改了要把版本號加一並寫升級路徑。確定這個版本還沒發布給使用者,可以單次跳過:LUMOS_SKIP_ROOM_GUARD=1 git push")
++            if ctx["fork_found"]:
++                out["problems"].append(("schema", msg))
++            else:
++                out["warns"].append(msg + "(找不到主線,只提醒)")
++
++
++def _rg_check_path(tq, a, b, fvs, ctx, out):
++    """升級路徑不倒退([S1][S4][S14]):分岔點時能升到 a 的每個版本,終點上都要走得到 b;判不出的寫法降成提醒([S13])。"""
++    fe, te, tip_m = ctx["fe"], ctx["te"], ctx["tip_m"]
++    srcs = sorted({v for v in set(fvs) | {x for x, _y in fe} if _rg_reach(fe, v, a)[0]} | {a})
++    gaps = []
++    for v in srcs:
++        ok, top_r = _rg_reach(te, v, b)
++        step = f"{top_r}→{b}"
++        if not ok and step not in gaps:
++            gaps.append(step)
++    if not gaps:
++        return
++    msg = f"{tq} 缺升級路徑:{'、'.join(gaps)}(找不到 Migration 或 AutoMigration)——使用者手機上的資料庫升級時會閃退"
++    if tip_m[2]:
++        msg += ";現在的寫法(fallbackToDestructiveMigration)會在使用者手機上清空這個資料庫"
++    if tip_m[1]:
++        out["warns"].append(msg + f"。另有 {tip_m[1]} 處升級路徑寫法判不出(參數不是整數字面),只提醒")
++    else:
++        out["problems"].append(("migration", msg))
++
++
++def _rg_check_dir(fq, fvs, ctx, out):
++    """分岔點上的一個結構檔目錄(一個資料庫)→ 判過回 1、整個目錄不見回 0。"""
++    tip_s, owner = ctx["tip_s"], ctx["hash_owner"]
++    tq = fq if fq in tip_s else next((owner[h] for h in fvs.values() if h in owner), None)
++    if tq is None:
++        out["problems"].append(("schema", f"主線上已有的結構檔被刪掉:{fq}/ 整個目錄({len(fvs)} 個版本)——主線上的版本可能已經發給使用者,"
++                                          "要保留;資料庫搬家時連結構檔一起搬"))
++        return 0
++    _rg_check_rewrites(fq, tq, fvs, ctx, out)
++    if tq in ctx["allow"] or fq in ctx["allow"]:
++        return 1
++    a, b = max(fvs), max(tip_s[tq])
++    if b < a:
++        out["problems"].append(("migration", f"{tq} 降版:主線上是 {a},這次是 {b}——Room 預設不支援降版,使用者手機上會閃退"))
++        return 1
++    _rg_check_path(tq, a, b, fvs, ctx, out)
++    simple = tq.rsplit(".", 1)[-1]
++    if b > a and not _rg_has_mig_test(ctx["root"], ctx["tip"], simple, b):
++        out["problems"].append(("migration", f"{tq} 升到 {b} 缺升級測試:測試路徑裡要有一支提到 MigrationTestHelper 與 {simple}、"
++                                             f"在 runMigrationsAndValidate( 或 createDatabase( 帶 {b},或用 addMigrations(* 跑完全部升級"))
++    return 1
++
++
++def _rg_migration_half(root, fork, tip, fork_found, changed, cfg, out):
++    """升級那半([S1] 到 [S21]):problems/warns 寫進 out;回這次判了幾個資料庫。"""
++    allow = cfg[2]
++    tip_s = _rg_schemas(root, tip, out["problems"])
++    fork_s = _rg_schemas(root, fork, None)
++    tip_m, fork_m = _rg_mig_state(root, tip), _rg_mig_state(root, fork)
++    if tip_s is None or fork_s is None or tip_m is None or fork_m is None:
++        out["warns"].append("git 讀不到結構檔或升級物件,升級那半這次沒檢查")
++        return 0
++    _rg_check_sources(_rg_db_sources(root, tip), tip_s, changed, allow, out)
++    ctx = {"root": root, "tip": tip, "tip_s": tip_s, "fork_found": fork_found, "allow": allow, "tip_m": tip_m,
++           "hash_owner": {h: fq for fq, vs in tip_s.items() for h in vs.values() if h},
++           "fe": [(x, y) for x, y, _k in fork_m[0]], "te": [(x, y) for x, y, _k in tip_m[0]]}
++    return sum(_rg_check_dir(fq, fvs, ctx, out) for fq, fvs in fork_s.items())
++
++
++def _rg_has_mig_test(root, tip, simple, b):
++    paths = _rg_grep(root, tip, "MigrationTestHelper") or []
++    read = _nodehome_reader(root, tip) if paths else None
++    for p in paths:
++        if not _rg_is_test_path(p):
++            continue
++        t = _rg_strip(_rg_text(read, p) or "")
++        if not re.search(rf"\b{re.escape(simple)}\b", t):
++            continue
++        if re.search(r"\baddMigrations\s*\(\s*\*", t):
++            return True
++        for m in re.finditer(r"\b(?:runMigrationsAndValidate|createDatabase)\s*\(", t):
++            i = m.end() - 1
++            if re.search(rf"(?<![\w.]){b}(?![\w.])", t[i:_rg_balanced(t, i)]):
++                return True
++    return False
++
++
++def _rg_method_end(text, j):
++    """方法參數右括號之後的位置 j → 宣告結束的位置:有本體到對應的右大括號,`=` 單行運算式或 `;` 到那一行行尾,
++    沒有本體時下一行是空白行、註記、右大括號或下一個 fun 就結束在這一行。"""
++    end = j
++    while end < len(text):
++        c = text[end]
++        if c == "{":
++            return _rg_balanced(text, end)
++        if c == ";" or (c == "=" and text[end + 1:end + 2] != "="):
++            nl = text.find("\n", end)
++            return len(text) if nl < 0 else nl - 1
++        if c == "\n":
++            nl = text.find("\n", end + 1)
++            nxt = text[end + 1:len(text) if nl < 0 else nl].strip()
++            if not nxt or nxt[0] in "@}" or re.match(r"(?:\w+\s+)*fun\b", nxt):
++                return end - 1
++        end += 1
++    return end
++
++
++def _rg_annotations(text, k):
++    """位置 k 起連續的註記(可跨行,括號平衡)→ (註記短名集合, 註記之後的位置)。"""
++    anns = set()
++    while True:
++        m = re.match(r"\s*@([\w.]+)\s*", text[k:])
++        if not m:
++            return anns, k
++        anns.add(m.group(1).rsplit(".", 1)[-1])
++        k += m.end()
++        if text[k:k + 1] == "(":
++            k = _rg_balanced(text, k) + 1
++
++
++def _rg_methods(text, java):
++    """剝過的 DAO 原始碼 → [(名稱, 起行, 迄行, 是交易方法)](行號從 1 起)。方法 = 宣告正上方連續註記裡有 Room 的方法註記。"""
++    lines = text.split("\n")
++    offs, o = [], 0
++    for ln in lines:
++        offs.append(o)
++        o += len(ln) + 1
++    out, i = [], 0
++    while i < len(lines):
++        if not lines[i].lstrip().startswith("@"):
++            i += 1
++            continue
++        anns, k = _rg_annotations(text, offs[i])
++        dm = re.match(r"[^(@{};]*?\b(\w+)\s*(?:<[^>]*>)?\s*\(", text[k:], re.S)
++        if not dm or not (anns & _RG_METHOD_ANNS) or (not java and "fun " not in text[k:k + dm.end()]):
++            i = text.count("\n", 0, k) + 1
++            continue
++        j = _rg_balanced(text, k + dm.end() - 1) + 1
++        last = text.count("\n", 0, max(_rg_method_end(text, j), j - 1)) + 1
++        out.append((dm.group(1), i + 1, last, "Transaction" in anns))
++        i = last
++    return out
++
++
++def _rg_hunks(root, start, tip):
++    """起點..終點的 .kt/.java 差異(帶改名偵測)→ ({終點路徑: 改動行集合}, {終點路徑: 起點路徑或 None(新檔)}) 或 None。
++    改動行 = 新增的行;純刪除的那段算刪除點前後兩行([S26])。"""
++    r = _lens_git(root, "diff", "-M", "-U0", "--no-color", "--no-ext-diff", start, tip, "--", "*.kt", "*.java",
++                  quote=True, binary=True)
++    if r is None or r.returncode != 0:
++        return None
++    touched, origin, st, newfile = {}, {}, {"cur": "", "old": ""}, False
++    for ln in _diff_text_lines(r.stdout):
++        if ln.startswith("diff --git "):
++            newfile = False
++        if ln.startswith("new file mode"):
++            newfile = True
++        m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", ln)     # 先認區段行:_lens_diff_header 也把 @@ 當檔頭
++        if not m:
++            if _lens_diff_header(ln, st) and ln.startswith("+++ ") and st["cur"]:
++                origin[st["cur"]] = None if newfile else (st["old"] or st["cur"])
++            continue
++        if st["cur"]:
++            c, cnt = int(m.group(1)), int(m.group(2) if m.group(2) is not None else 1)
++            s = touched.setdefault(st["cur"], set())
++            s.update(range(c, c + cnt) if cnt else (c, c + 1))
++    return touched, origin
++
++
++def _rg_dao_changes(root, tip, touched, origin):
++    """這次改到的 DAO 方法與型別轉換函式 → ([(DAO 名, 方法名)], [型別轉換函式名])。"""
++    read = _nodehome_reader(root, tip)
++    need, convs = [], []
++    for p in sorted(touched):
++        if _rg_is_test_path(p) or not p.endswith(_RG_SRC_EXTS):
++            continue
++        t = _rg_strip(_rg_text(read, p) or "")
++        is_new = origin.get(p) is None and p in origin
++        cm = re.search(r"@(?:androidx\.room3?\.)?Dao\b[^{]*?\b(?:interface|class)\s+(\w+)", t, re.S)
++        if cm or re.search(r"@(?:androidx\.room3?\.)?Dao\b", t):
++            dao = cm.group(1) if cm else Path(p).stem
++            need += [(dao, name) for name, s, e, _tx in _rg_methods(t, p.endswith(".java"))
++                     if is_new or any(s <= x <= e for x in touched[p])]
++        for m in re.finditer(r"@(?:androidx\.room3?\.)?TypeConverter\b[\s\S]*?\bfun\s+(\w+)|@TypeConverter\b[^;{]*?\b(\w+)\s*\(", t):
++            s, e = t.count("\n", 0, m.start()) + 1, t.count("\n", 0, m.end()) + 1
++            if is_new or any(s <= x <= e for x in touched[p]):
++                convs.append(m.group(1) or m.group(2))
++    return need, convs
++
++
++def _rg_tests_calling(root, tip, read, name, pat):
++    """終點測試路徑裡、剝過註解後符合 pat 的檔(先用固定字串 name 粗篩)。"""
++    return [p for p in (_rg_grep(root, tip, name) or [])
++            if _rg_is_test_path(p) and pat.search(_rg_strip(_rg_text(read, p) or ""))]
++
