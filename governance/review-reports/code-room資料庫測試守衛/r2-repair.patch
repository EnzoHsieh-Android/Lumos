++def _rg_triggered(root, start, tip):
++    """[S31] 這次推送碰到 Room 了嗎 → (True/False, 改到的路徑集合) 或 None(git 失敗)。"""
++    r = _lens_git(root, "diff", "--name-only", "-M", "-z", start, tip, quote=True)
++    if r is None or r.returncode != 0:
++        return None
++    paths = [p for p in r.stdout.split("\0") if p]
++    hit = False
++    rs, rt = _nodehome_reader(root, start), _nodehome_reader(root, tip)
++    for p in paths:
++        if _RG_SCHEMA_PATH_RE.search(p):
++            hit = True
++            break
++        if p.endswith(_RG_SRC_EXTS) and not _rg_is_test_path(p) and any(
++                _RG_TRIGGER_RE.search(_rg_text(rd, p) or "") for rd in (rs, rt)):
++            hit = True
++            break
++    if not hit and start != _EMPTY_TREE_SHA:      # 改名的舊路徑
++        r2 = _lens_git(root, "diff", "--name-only", "--no-renames", "-z", start, tip, quote=True)
++        for p in (r2.stdout.split("\0") if (r2 is not None and r2.returncode == 0) else []):
++            if p.endswith(_RG_SRC_EXTS) and not _rg_is_test_path(p) and _RG_TRIGGER_RE.search(_rg_text(rs, p) or ""):
++                hit = True
++                break
++    return hit, set(paths)
++
