++def _rg_split_args(s):
++    """括號內的參數字串 → 頂層逗號切開的清單(去頭尾空白)。"""
++    out, depth, cur = [], 0, []
++    for c in s:
++        if c in "([{<":
++            depth += 1
++        elif c in ")]}>":
++            depth -= 1
++        if c == "," and depth == 0:
++            out.append("".join(cur).strip())
++            cur = []
++        else:
++            cur.append(c)
++    if "".join(cur).strip():
++        out.append("".join(cur).strip())
++    return out
