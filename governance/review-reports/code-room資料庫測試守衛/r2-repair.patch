++def _rg_edges(text):
++    """剝過的原始碼 → ([(起, 迄, 'auto'|'manual')], 判不出的寫法數)。"""
++    edges, unresolved = [], 0
++    for m in re.finditer(r"(?<![\w.])(Auto)?Migration\s*\(", text):
++        i = m.end() - 1
++        e = _rg_edge_args(_rg_split_args(text[i + 1:_rg_balanced(text, i)]), bool(m.group(1)))
++        if e is None:
++            unresolved += 1
++        else:
++            edges.append((e[0], e[1], "auto" if m.group(1) else "manual"))
++    return edges, unresolved
