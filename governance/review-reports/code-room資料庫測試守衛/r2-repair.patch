++def _rg_databases(text):
++    """剝過的原始碼 → [{name, version(整數或 None), export_false}]。類別名:平衡括號跳過 @Database(...),
++    取其後第一個 class 名稱([S18]:@TypeConverters(Converters::class) 不會被當成類別名)。"""
++    out = []
++    for m in re.finditer(r"@(?:androidx\.room3?\.)?Database\s*\(", text):
++        i = m.end() - 1
++        j = _rg_balanced(text, i)
++        args = text[i + 1:j]
++        # 其後的註記(@TypeConverters(Converters::class) 這類)不用另外跳:`X::class`、`X.class` 都不是「class 名稱」的形狀
++        cm = re.search(r"\bclass\s+(\w+)", text[j + 1:])
++        if not cm:
++            continue
++        vm = re.search(r"\bversion\s*=\s*([^,)\]]+)", args)
++        ver = int(vm.group(1).strip()) if vm and re.fullmatch(r"\d{1,9}", vm.group(1).strip()) else None
++        out.append({"name": cm.group(1), "version": ver,
++                    "export_false": bool(re.search(r"\bexportSchema\s*=\s*false\b", args))})
++    return out
++
++
++def _rg_package(text):
++    m = re.search(r"^\s*package\s+([\w.]+)", text, re.M)
++    return m.group(1) if m else ""
++
++
++def _rg_reach(edges, src, dst):
++    """有向圖走訪:src 走得到 dst 嗎?回 (走得到, 走得到的最大版本 ≤ dst)。"""
++    seen, stack = {src}, [src]
++    while stack:
++        v = stack.pop()
++        for a, b in edges:
++            if a == v and b not in seen:
++                seen.add(b)
++                stack.append(b)
++    return dst in seen, max([v for v in seen if v <= dst] or [src])
++
++
++def _rg_config(text):
++    """room_guard 設定(從被推的終點讀,形狀照 _note_shape_config):回 (gate, dao, allow_destructive 集合, 提醒清單);壞值回預設。"""
++    if text is None:
++        return "block", "block", set(), []
++    raw = text.decode("utf-8-sig", errors="replace") if isinstance(text, (bytes, bytearray)) else str(text)
++    try:
++        data = json.loads(raw)
++    except Exception as e:
++        return "block", "block", set(), [f".lumos/config.json 讀不了({e.__class__.__name__}),Room 守衛照預設擋"]
++    rg = data.get("room_guard") if isinstance(data, dict) else None
++    if rg is None:
++        return "block", "block", set(), []
++    if not isinstance(rg, dict):
++        return "block", "block", set(), ["設定檔的 room_guard 不是物件,Room 守衛照預設擋"]
++    warns, vals = [], []
++    for key in ("gate", "dao"):
++        v = rg.get(key, "block")
++        if v not in _RG_GATE_VALUES:
++            warns.append(f"設定檔的 room_guard.{key}={v!r} 看不懂(只認 {'/'.join(_RG_GATE_VALUES)}),照預設擋")
++            v = "block"
++        vals.append(v)
++    ad = rg.get("allow_destructive", [])
++    if not isinstance(ad, list):
++        warns.append("設定檔的 room_guard.allow_destructive 不是清單,當成沒有")
++        ad = []
++    return vals[0], vals[1], {str(x) for x in ad}, warns
++
++
++def _rg_grep(root, where, *fixed):
++    """某個提交裡含任一固定字串的 .kt/.java → 路徑清單(粗篩,精確比對在 Python 做:git grep 的正規式方言各平台不同);
++    where 是空樹或 None 回 []。git 失敗回 None。"""
++    if where is None or where == _EMPTY_TREE_SHA:
++        return []
++    pats = [x for f in fixed for x in ("-e", f)]
++    r = _lens_git(root, "grep", "-l", "-I", "-F", *pats, where, "--", "*.kt", "*.java", quote=True)
++    if r is None or r.returncode not in (0, 1):
++        return None
++    return [ln.split(":", 1)[1] for ln in r.stdout.splitlines() if ":" in ln]
++
++
++def _rg_text(read, p):
++    b = read(p)
++    return None if b is None else b.decode("utf-8", errors="replace")
++
++
++def _rg_schemas(root, where, problems):
++    """某個提交的 Room 結構檔 → {目錄名: {版本: identityHash 或 None(讀不懂)}}。只看形狀對的路徑,內容是帶 formatVersion 與
++    database.identityHash 的 JSON 才算;讀不懂而看得出是 Room 結構檔的(含 formatVersion 或 identityHash 字樣)記成 None,
++    problems 不是 None 時順便記一條擋下([S38])。where 是空樹或 None → {}。"""
++    if where is None or where == _EMPTY_TREE_SHA:
++        return {}
++    lst = _nodehome_list(root, where)
++    if lst is None:
++        return None
++    read = _nodehome_reader(root, where)
++    out = {}
++    for p in lst[0]:
++        m = _RG_SCHEMA_PATH_RE.search(p)
++        if not m:
++            continue
++        t = _rg_text(read, p) or ""
++        try:
++            d = json.loads(t)
++            h = d["database"]["identityHash"] if isinstance(d, dict) and "formatVersion" in d else None
++            if not isinstance(h, str):
++                continue
++        except Exception:
++            if "identityHash" not in t and "formatVersion" not in t:
++                continue
++            h = None
++            if problems is not None:
++                problems.append(("schema", f"結構檔讀不懂:{p}(合併衝突沒解乾淨、截斷或不是 UTF-8)——改好或重新編譯產生再提交"))
++        out.setdefault(m.group(1), {})[int(m.group(2))] = h
++    return out
++
++
++def _rg_mig_state(root, where):
++    """某個提交非測試路徑的升級邊與判不出的寫法數、含 fallbackToDestructiveMigration 與否 → (邊, 判不出數, 有清空寫法) 或 None。"""
++    paths = _rg_grep(root, where, "Migration")
++    if paths is None:
++        return None
++    read = _nodehome_reader(root, where) if paths else None
++    edges, unres, destructive = [], 0, False
++    for p in paths:
++        if _rg_is_test_path(p):
++            continue
++        t = _rg_strip(_rg_text(read, p) or "")
++        e, u = _rg_edges(t)
++        edges += e
++        unres += u
++        destructive = destructive or "fallbackToDestructiveMigration" in t
++    return edges, unres, destructive
++
++
++def _rg_fork_point(root, tip, push):
++    """終點跟主線的分岔點 → sha 或 None(找不到主線)。掛鉤帶了遠端與 ref 就照推送閘的主線候選(_push_mainlines),
++    手動跑照 _lens_default_base(含本機 main/master)。"""
++    if not push:
++        return _lens_default_base(root, tip=tip, include_local=True)
++    mls, err = _push_mainlines(root, push[0], push[1])
++    if err or not mls:
++        return None
++    r = _lens_git(root, "merge-base", "--all", tip, *[sha for _n, sha in mls])
++    bases = r.stdout.split() if (r is not None and r.returncode == 0) else []
++    if not bases:
++        return None
++    start, _why = _push_pick_base(root, bases, None, [], "主線")
++    return start if start and start != _PUSH_START_UNKNOWN else None
++
++
++def _rg_db_sources(root, tip):
++    """終點非測試路徑裡的 @Database → {類別完整名稱: {name, version, export_false, path}}。"""
++    read = _nodehome_reader(root, tip)
++    db_src = {}
++    for p in _rg_grep(root, tip, "Database") or []:
++        if _rg_is_test_path(p):
++            continue
++        t = _rg_strip(_rg_text(read, p) or "")
++        pkg = _rg_package(t)
++        for d in _rg_databases(t):
++            db_src[(pkg + "." if pkg else "") + d["name"]] = dict(d, path=p)
++    return db_src
++
