++def _rg_root(repo):
++    """--repo 或目前所在的 git 專案根 → Path 或 None(不是 git 專案,已講一句)。"""
++    root = Path(repo).resolve() if repo else None
++    if root is None:
++        r = _lens_git(".", "rev-parse", "--show-toplevel")
++        root = Path(r.stdout.strip()) if (r is not None and r.returncode == 0) else None
++    if root is None or not _is_git_worktree(root):
++        print("Room 守衛:這裡不是 git 專案,跳過", file=sys.stderr)
++        return None
++    return root
