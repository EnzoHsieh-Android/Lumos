++def _rg_strip(txt):
++    """剝程式註解並清空字串內容,★保留換行★(行號要對得上差異);掃描式重用 _C_STRIP_PAT,不另寫一套。"""
++    def _one(mo):
++        tok = mo.group(0)
++        nl = "\n" * tok.count("\n")
++        if tok[:2] in ("//", "/*"):
++            return nl
++        for q in ('"""', "'''"):
++            if tok.startswith(q):
++                return q + nl + q
++        return tok[0] + nl + tok[0]
++    return _lazy_re(_C_STRIP_PAT, re.S).sub(_one, txt)
