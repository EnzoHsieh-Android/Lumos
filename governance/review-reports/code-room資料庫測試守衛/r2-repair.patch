++    i_dr, i_rg, i_rr = txt.find('"$GRAPHCTL" drift check'), txt.find('"$GRAPHCTL" room-guard'), txt.find("note-audit reread-check")
++    check("①排在存量漂移之後、回頭重讀之前", 0 < i_dr < i_rg < i_rr, f"{i_dr} {i_rg} {i_rr}")
