+def _rg_fork_point(root, tip, push):
+    """終點跟主線的分岔點 → sha 或 None(找不到主線)。掛鉤帶了遠端與 ref 就照推送閘的主線候選(_push_mainlines),
+    手動跑照 _lens_default_base(含本機 main/master)。"""
+    if not push:
+        return _lens_default_base(root, tip=tip, include_local=True)
+    mls, err = _push_mainlines(root, push[0], push[1])
+    if err or not mls:
+        return None
+    r = _lens_git(root, "merge-base", "--all", tip, *[sha for _n, sha in mls])
+    bases = r.stdout.split() if (r is not None and r.returncode == 0) else []
+    if not bases:
+        return None
+    start, _why = _push_pick_base(root, bases, None, [], "主線")
+    return start if start and start != _PUSH_START_UNKNOWN else None
