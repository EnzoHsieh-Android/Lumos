+            h = d["database"]["identityHash"] if isinstance(d, dict) and "formatVersion" in d else None
+            if not isinstance(h, str):
+                continue
+        except Exception:
+            if "identityHash" not in t and "formatVersion" not in t:
+                continue
+            h = None
+            if problems is not None:
+                problems.append(("schema", f"結構檔讀不懂:{p}(合併衝突沒解乾淨、截斷或不是 UTF-8)——改好或重新編譯產生再提交"))
+        out.setdefault(m.group(1), {})[int(m.group(2))] = h
+    return out
+
+
+def _rg_mig_state(root, where):
+    """某個提交非測試路徑的升級邊與判不出的寫法數、含 fallbackToDestructiveMigration 與否 → (邊, 判不出數, 有清空寫法) 或 None。"""
+    paths = _rg_grep(root, where, "Migration")
+    if paths is None:
+        return None
+    read = _nodehome_reader(root, where) if paths else None
+    edges, unres, destructive = [], 0, False
+    for p in paths:
+        if _rg_is_test_path(p):
+            continue
+        t = _rg_strip(_rg_text(read, p) or "")
+        e, u = _rg_edges(t)
+        edges += e
+        unres += u
+        destructive = destructive or "fallbackToDestructiveMigration" in t
+    return edges, unres, destructive
+
+
+def _rg_fork_point(root, tip, push):
+    """終點跟主線的分岔點 → sha 或 None(找不到主線)。掛鉤帶了遠端與 ref 就照推送閘的主線候選(_push_mainlines),
+    手動跑照 _lens_default_base(含本機 main/master)。"""
+    if not push:
+        return _lens_default_base(root, tip=tip, include_local=True)
+    mls, err = _push_mainlines(root, push[0], push[1])
+    if err or not mls:
+        return None
+    r = _lens_git(root, "merge-base", "--all", tip, *[sha for _n, sha in mls])
+    bases = r.stdout.split() if (r is not None and r.returncode == 0) else []
+    if not bases:
+        return None
+    start, _why = _push_pick_base(root, bases, None, [], "主線")
+    return start if start and start != _PUSH_START_UNKNOWN else None
+
+
+def _rg_db_sources(root, tip):
+    """終點非測試路徑裡的 @Database → {類別完整名稱: {name, version, export_false, path}}。"""
+    read = _nodehome_reader(root, tip)
+    db_src = {}
+    for p in _rg_grep(root, tip, "Database") or []:
+        if _rg_is_test_path(p):
+            continue
+        t = _rg_strip(_rg_text(read, p) or "")
+        pkg = _rg_package(t)
+        for d in _rg_databases(t):
+            db_src[(pkg + "." if pkg else "") + d["name"]] = dict(d, path=p)
+    return db_src
