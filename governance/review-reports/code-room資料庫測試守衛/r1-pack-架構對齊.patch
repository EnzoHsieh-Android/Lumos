+def _rg_precheck(root, diff_range, push_remote, pushed_ref):
+    """參數、單次跳過、淺層 clone → 要直接回的回傳碼,或 None(往下判)。"""
+    if (push_remote is None) != (pushed_ref is None):
+        print("擋下:--push-remote 與 --pushed-ref 要一起給(掛鉤會兩個都帶;手動跑兩個都不給)", file=sys.stderr)
+        return 2
+    if _lens_range_ok(diff_range) is None:
+        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
+        return 2
+    if os.environ.get("LUMOS_SKIP_ROOM_GUARD") == "1":
+        print("Room 守衛:LUMOS_SKIP_ROOM_GUARD 設了,這次跳過(已記進治理帳)", file=sys.stderr)
+        _gate_event_or_warn(root, "room-guard", "skipped-env", "LUMOS_SKIP_ROOM_GUARD")
+        return 0
+    sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
+    if sh is not None and sh.stdout.strip() == "true":
+        print("Room 守衛:淺層 clone 算不出範圍,這次不查——CI 請設 fetch-depth: 0", file=sys.stderr)
