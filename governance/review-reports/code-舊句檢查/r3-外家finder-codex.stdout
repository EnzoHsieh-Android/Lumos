 57297	def t_drift_m1_review_r2_budget_in_loops():
 57298	    """代碼審 r2 外家否決-F1:大量名稱共用第一段(src/…)時,逐行比對的桶裡與建名稱索引的迴圈都看截止時間,時間到走既有
 57299	    timeout 路徑,不會一整桶跑完才停。最壞輸入:幾千個被刪的 src/… 路徑、一行快 2 萬字帶 src。
 57300	
 57301	    翻紅釘:桶裡不看時間 → ①紅;建索引不看時間 → ②紅。
 57302	    """
 57303	    print("t_drift_m1_review_r2_budget_in_loops")
 57304	    m = _load_lumos_inproc()
 57305	    root, base, tip = _m1_bulk_paths_repo(3000)
 57306	    orig = m._drift_m1_line_names
 57307	    state = {"in": False, "raised_inside": False, "calls": 0}
 57308	
 57309	    def wrapped(idx, ln, tick=None):
 57310	        state["in"] = True
 57311	        try:
 57312	            return orig(idx, ln, tick)
 57313	        except m._DriftM1Stop:
 57314	            state["raised_inside"] = True
 57315	            raise
 57316	        finally:
 57317	            state["in"] = False
 57318	
 57319	    def now():
 57320	        if state["in"]:
 57321	            state["calls"] += 1
 57322	        return 10 ** 9 if state["calls"] > 3 else 0
 57323	    m._drift_m1_line_names = wrapped
 57324	    try:
 57325	        r = _m1_check(root, base, tip, now=now, deadline=100)
 57326	    finally:
 57327	        m._drift_m1_line_names = orig
 57328	    check("①前置:候選是幾千個共用 src 第一段的路徑", r["candidates"] and r["candidates"] >= 3000, str(r["candidates"]))
 57329	    check("①同一桶裡跑到一半時間到 → timeout,從逐行比對裡面停下", r["state"] == "timeout" and state["raised_inside"],
 57330	          f"{r['state']} {state}")
 57331	    ticks = [0]
 57332	    m._drift_m1_name_index([f"src/p{i}/f.py" for i in range(3000)], tick=lambda: ticks.__setitem__(0, ticks[0] + 1))
 57333	    check("②建名稱索引的迴圈也看時間(3000 個名稱至少看 10 次)", ticks[0] >= 10, str(ticks[0]))
