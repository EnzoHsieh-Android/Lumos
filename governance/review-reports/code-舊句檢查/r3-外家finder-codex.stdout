 29650	# doctor 給消費專案貼的 CI 步驟:before 原樣交(空的換成 40 個 0),帶 --push-remote origin --pushed-ref "$GITHUB_REF",
 29651	# 起點由 lumos 的 _push_range_start 算(推送閘接漂移檢查代碼審 r2:原本的 shell 補法在合過主線、新分支首推一次帶多個提交時算錯)。
 29652	# 補 before、補 origin/HEAD、呼叫 drift check 那幾行跟工具鏈自己的 .github/workflows/ci.yml 那步逐字相同——只差直譯器名
 29653	# (ci.yml 用 python、這裡用 python3)與 ci.yml 接在後面的回傳碼處理(t_doctor_drift_ci_template_start_fallback 比對並真的跑一次)。
 29654	# ★說明寫成 YAML 註解、縮排對齊步驟★(代碼審 r2 外家否決席):整段貼進 workflow 的 steps 底下要能被解析;
 29655	# Python 3.14 那句也寫成註解,不接共用的 _CI_PY314_NOTE(另兩處範本的同一個問題另開 Issue)。
 29656	_DRIFT_CI_STEP = """
 29657	    - name: drift check
 29658	      if: github.event_name == 'push'
 29659	      env:
 29660	        BEFORE: ${{ github.event.before }}
 29661	        SHA: ${{ github.sha }}
 29662	        DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
 29663	      run: |
 29664	        [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
 29665	        if [ -n "$DEFAULT_BRANCH" ] && ! git rev-parse -q --verify refs/remotes/origin/HEAD >/dev/null && git rev-parse -q --verify "refs/remotes/origin/$DEFAULT_BRANCH" >/dev/null; then
 34915	    if not d.is_dir():
 34916	        return False
 34917	    if hasattr(os, "getuid"):
 34918	        if st.st_uid != os.getuid():
 34919	            return False
 34920	        if st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH):
 34921	            return False
 34922	    return True
 34923	
