 57280	def _m1_bulk_paths_repo(n):
 57281	    """起點樹有 n 支 src/pkg_<i>/file.py(同一個內容,用 git 底層指令放進去,不寫磁碟)、終點全刪;
 57282	    Systems/Z.md 的開頭欄位藏著全部路徑(名稱先篩不剔除),Systems/A.md 有一行快 2 萬字、帶 src。"""
 57283	    root = _nh_repo()
 57284	    paths = [f"src/pkg_{i}/file.py" for i in range(n)]
 57285	    _m1_note(root, "Systems/A.md", "# A\n" + ("用 src 裡的東西 " * 2400)[:19000])
 57286	    _m1_note(root, "Systems/Z.md", "", raw="---\ntype: system\nhidden_list: " + " ".join(paths) + "\n---\n# Z\n")
 57287	    _nh_git(root, "add", "-A")
 57288	    oid = _m1_git_b(root, "hash-object", "-w", "--stdin", stdin=b"x = 1\n").stdout.decode().strip()
 57289	    _m1_git_b(root, "update-index", "--index-info", stdin="".join(f"100644 {oid}\t{p}\n" for p in paths).encode())
 57290	    _nh_git(root, "commit", "-qm", "base", "--no-verify")
 57291	    base = _na_head(root)
 57292	    _nh_git(root, "rm", "-r", "--cached", "-q", "src")
 57293	    _nh_git(root, "commit", "-qm", "del", "--no-verify")
 57294	    return root, base, _na_head(root)
