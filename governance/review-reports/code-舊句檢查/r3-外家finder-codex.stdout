 34972	                return False
 34973	            st = cur.stat()
 34974	        except OSError:
 34975	            return False
 34976	        if hasattr(os, "getuid"):
 34977	            if st.st_uid != os.getuid():
 34978	                return False
 34979	            if st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH):
 34980	                return False
