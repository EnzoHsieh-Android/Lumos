 57353	    blk = lines({"drift_check": {"old_sentence": "block"}})
 57354	    wrn = lines({"drift_check": {"old_sentence": "warn"}})
 57355	    check("①只寫 old_sentence=off:doctor 自己一行講關掉了", len(off) == 1 and "關掉了(drift_check.old_sentence=off)" in off[0], str(off))
 57356	    check("①寫錯值:講沒讀懂、照預設 warn", len(bad) == 1 and "舊句檢查的設定沒讀懂" in bad[0] and "'Block'" in bad[0], str(bad))
 57357	    check("①寫 block:講會被擋;寫 warn(預設):不唸", len(blk) == 1 and "舊句檢查是 block" in blk[0] and wrn == [], str((blk, wrn)))
 57358	    g = lines({"drift_check": {"gate": "old_sentence"}})
 57359	    check("②gate 寫成 \"old_sentence\":gate 那句照講、不被誤吞", any("存量漂移檢查的設定沒讀懂" in x and "'old_sentence'" in x for x in g),
 57360	          str(g))
 57361	    both = lines({"drift_check": {"gate": "warn", "old_sentence": "off"}})
 57362	    check("③gate 與 old_sentence 各自一行", len(both) == 2 and "存量漂移檢查是 warn" in both[0] and "舊句檢查關掉了" in both[1],
 57363	          str(both))
 57364	
 57365	
 57366	def t_drift_m1_review_r2_strict_home_dirs():
 57367	    """代碼審 r2 架構對齊-F1、資安-F2、邊界-F1:家目錄私有目錄只有一套判準(group 可寫不信);新建的層一律明給 0700,umask 002
 57368	    也建得起,m1 以外的鄰居(bound-filter、dispatch-lens、vault-lock)一樣;留痕檔是 FIFO 時不卡住、拒絕寫。
 57369	
 57370	    翻紅釘:新建層只給 m1 明給 0700 → ②紅;留痕開檔不帶 O_NONBLOCK → ③紅(卡住,alarm 殺掉);group 可寫又放行 → ①紅。
 57371	    """
 57372	    print("t_drift_m1_review_r2_strict_home_dirs")
 57373	    import inspect, os as _o, signal, stat as _st
 57374	    m = _load_lumos_inproc()
 57375	    check("①_trusted_private_dir 只有一套判準(沒有放寬的參數)", "group_ok" not in inspect.signature(m._trusted_private_dir).parameters
 57376	          and "group_ok" not in inspect.signature(m._mkdir_trusted_under_home).parameters, "")
 57377	    h = Path(tempfile.mkdtemp())
 57378	    (h / ".cache" / "lumos" / "drift-defs").mkdir(parents=True)
 57379	    for x in ("", "lumos", "lumos/drift-defs"):
 57380	        _o.chmod(h / ".cache" / x, 0o700)
 57381	    _o.chmod(h / ".cache" / "lumos" / "drift-defs", 0o770)
 57382	    with _M1Home(h):
 57383	        check("①group 可寫的快取目錄不信(同群組的人能改名換掉快取檔)", m._drift_m1_cache_dir() is None, "")
 57384	    old = _o.umask(0o002)
 57385	    try:
 57386	        h2 = Path(tempfile.mkdtemp())
 57387	        with _M1Home(h2):
 57388	            got = {sub: m._mkdir_trusted_under_home(".cache", "lumos", sub) for sub in ("bound-filter", "dispatch-lens", "vault-lock")}
 57389	    finally:
 57390	        _o.umask(old)
 57391	    modes = [(h2 / ".cache" / x).stat().st_mode & 0o777 for x in ("", "lumos", "lumos/bound-filter")]
 57392	    check("②umask 002:鄰居的目錄也建得起、新建的層都是 0700", all(got.values()) and all(x == 0o700 for x in modes),
 57393	          f"{got} {[oct(x) for x in modes]}")
 57394	    h3 = Path(tempfile.mkdtemp())
 57395	    with _M1Home(h3):
 57396	        m._mkdir_trusted_under_home(".cache", "lumos", "drift-m1")
 57397	        _o.mkfifo(h3 / ".cache" / "lumos" / "drift-m1" / "ledger-miss.jsonl")
 57398	
 57399	        class _Hung(Exception):     # 不能用 TimeoutError:它是 OSError,會被留痕那支的 except OSError 吃掉、看不出卡住
 57400	            pass
 57401	
 57402	        def boom(*_a):
 57403	            raise _Hung("卡住了")
 57404	        prev = signal.signal(signal.SIGALRM, boom)
 57405	        signal.alarm(5)
 57406	        try:
 57407	            ok = m._drift_m1_ledger_miss(h3, "a" * 40, "done")
 57408	            hung = False
 57409	        except _Hung:
 57410	            ok, hung = None, True
 57411	        finally:
 57412	            signal.alarm(0)
 57413	            signal.signal(signal.SIGALRM, prev)
 57414	    check("③留痕檔是 FIFO:不卡住、拒絕寫", not hung and ok is False,
 57415	          f"hung={hung} ok={ok} fifo={_st.S_ISFIFO((h3 / '.cache' / 'lumos' / 'drift-m1' / 'ledger-miss.jsonl').stat().st_mode)}")
 57416	
 57417	
 57418	if __name__ == "__main__":
 57419	    sys.exit(main())

