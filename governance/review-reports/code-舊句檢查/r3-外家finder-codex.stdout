 28172	def _drift_c4_evidence(cx):
 28173	    """c4 的證據與範本:那篇第一次被提交的提交、卷證目錄(同提交與計劃名比對兩種來源都列、標來源)、範本句。
 28174	    ★範本句的卷證一律是佔位字 <卷證>★(漂移修法補強 第 1 節;設計審 r2 後拿掉自動填):由人從清單挑,
 28175	    整句照貼進 lumos set 會被第 2 節擋下。"""
 28176	    root = cx["root"]
 28177	    shallow = _git_is_shallow(root)
 28178	    sha = None if shallow else _plan_first_commit(root, cx["repo_rel"], timeout=20)
 28179	    first = "shallow,查不到最早提交" if shallow else (sha or "查不到")
 28180	    rows, same = _drift_c4_dirs(cx, sha)
 28181	    tpl = f"提交 {sha[:12] if sha else _SET_COND_SLOTS[2]};代碼審見 {_SET_COND_SLOTS[1]}"
 28182	    return {"first": first, "reports": rows, "same": same, "template": tpl}
