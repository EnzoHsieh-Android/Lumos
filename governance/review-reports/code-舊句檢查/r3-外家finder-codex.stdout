 29641	    if parts["os_warns"]:
 29642	        return [f"舊句檢查的設定沒讀懂({parts['os_warns'][0]})——程式刪掉或改名後筆記還在講舊名稱的句子,推送時只提醒"]
 29643	    if parts["old_sentence"] == "off":
