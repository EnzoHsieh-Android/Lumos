 34984	def _chmod_no_follow(d, mode):
 34985	    """改一個★目錄★的權限,而且不准跟著符號連結走。成功回 True。
 34986	
 34987	    ★為什麼不直接 os.chmod★(2026-09-16 代碼審 資安席):`os.chmod` 會跟著連結走。
 34988	    武裝目錄那處父層已經逐層驗過了,★但葉節點那一層還是「先建、先改權限、才驗」★——
 34989	    葉節點在檢查之後被換成指向別人目錄的連結時,權限就改到別人的目錄上;
 34990	    最後那道驗證雖然擋得下寫入,但權限已經動過、回不去了。
 34991	
 34992	    做法是用 O_NOFOLLOW|O_DIRECTORY 開它再 fchmod:不是目錄、或是連結,開的時候就失敗。
 34993	    ★這是這份工具裡第一處真的用 dirfd 關掉競速窗口的地方★——其餘幾處仍是路徑層檢查,
 34994	    仍然擋不住同帳號搶跑(那條誠實邊界照舊成立,不要因為這裡做了就以為全都做了)。
 34995	    """
 34996	    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_DIRECTORY", 0)
 34997	    try:
 34998	        fd = os.open(str(d), flags)
 34999	    except OSError:
 35000	        return False
 35001	    try:
 35002	        os.fchmod(fd, mode)
 35003	        return True
 35004	    except OSError:
 35005	        return False
 35006	    finally:
 35007	        os.close(fd)
 35008	
