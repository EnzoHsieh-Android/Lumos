def _drift_c4_dirs(cx, sha):
    """卷證目錄兩種來源都列 → ([(目錄原名, 來源)] 排好序, 同提交清單或 None)。
    排序:兩者 → code- 開頭(不分來源)→ 其他,同級照字母。兩種來源都是現存目錄名,一個目錄一行(見 _drift_c4_same_commit)。"""
    rr = Path(cx["root"]) / "governance" / "review-reports"
    existing = _drift_c4_existing(rr)
    same = _drift_c4_same_commit(cx["root"], sha, existing)
    n = cx["env2"].notes.get(cx["rel"])
    keys = {_drift_c4_key(link_target(x).rsplit("/", 1)[-1]) for x in as_list(n.fields.get("plan_refs") if n else None)
            if link_target(x)}
    by_name = {d for d in existing if any(k and k in _drift_c4_key(d) for k in keys)}
    src = {d: "兩者" if d in by_name else "同提交" for d in same or ()}
    src.update({d: "計劃名" for d in by_name - set(src)})
    rows = sorted(src.items(), key=lambda kv: (0 if kv[1] == "兩者" else 1 if kv[0].startswith("code-") else 2, kv[0]))
    return rows, same


def _drift_c4_evidence(cx):
    """c4 的證據與範本:那篇第一次被提交的提交、卷證目錄(同提交與計劃名比對兩種來源都列、標來源)、範本句。
    ★範本句的卷證一律是佔位字 <卷證>★(漂移修法補強 第 1 節;設計審 r2 後拿掉自動填):由人從清單挑,
    整句照貼進 lumos set 會被第 2 節擋下。"""
    root = cx["root"]
    shallow = _git_is_shallow(root)
    sha = None if shallow else _plan_first_commit(root, cx["repo_rel"], timeout=20)
    first = "shallow,查不到最早提交" if shallow else (sha or "查不到")
    rows, same = _drift_c4_dirs(cx, sha)
    tpl = f"提交 {sha[:12] if sha else _SET_COND_SLOTS[2]};代碼審見 {_SET_COND_SLOTS[1]}"
    return {"first": first, "reports": rows, "same": same, "template": tpl}


def _drift_c4_show_name(d):
    """卷證目錄名拿來印:非 UTF-8 位元組換替代字元(_nodehome_show),Unicode 格式字元(類別 Cf:方向控制、零寬)換成看得見的
    \\uXXXX——整批匯入的目錄名帶 RLO 會讓終端上看到的順序跟實際字串不同(代碼審第二輪資安席)。只在這一處,不改共用的 _esc_clean。"""
    import unicodedata
    return "".join((f"\\u{ord(c):04x}" if ord(c) <= 0xFFFF else f"\\U{ord(c):08x}") if unicodedata.category(c) == "Cf" else c
                   for c in _nodehome_show(d))


def _drift_c4_print_dirs(ev):
    print("  ②卷證目錄(從這裡挑一個填進範本的 <卷證>;兩者=同提交也對得上計劃名,同提交=這篇第一次提交時一起加進來的,"
          "計劃名=用計劃名比對猜的,可能漏或多):")
    if ev["same"] is None:
        print("    同提交:查不到(git 失敗或沒有)")
    elif len(ev["same"]) > 3:
        print("    可能含別的計劃的卷證(整批匯入或壓成一個的提交)")
    # 全部列出、不設上限(代碼審第三輪撤回第一輪加的 20 個上限與補充指令:三輪長出四個新缺陷;長清單罕見,
    # 證據頁是人主動叫出來看的,多幾行不礙事)
    for d, src in ev["reports"]:
        print("    " + _esc_clean(f"governance/review-reports/{_drift_c4_show_name(d)}({src})", 300))
    if not ev["reports"]:
        print("    查不到")


def _drift_c4_print(cx, ev):
    print(f"{_esc_clean(cx['rel'], 200)} 第 {cx['line']} 行(c4 前提寫「還沒提交」)的證據——只列出、不寫檔:")
    print(f"  ①這篇第一次被提交:{ev['first']}")
            return 0                                                 # c4 只列證據與範本
    err = err or _drift_fix_shape_err(cx["root"], res["texts"])
    if err is None and o.get("dry_run"):
        _drift_fix_preview(cx, res)
        return 0
    # 帳檔路徑在寫筆記之前先查(代碼審 r1 邊界席:原本寫完筆記才發現帳寫不進去,留下改了筆記、沒帳、又不讓重跑的狀態)
    err = err or _drift_ledger_path_err(cx["root"], _DRIFT_FIXES)
    err = err or _drift_fix_write(env, cx, res) or _drift_fix_verify(env, cx, res)
    if err:
        print(f"擋下:{err}", file=sys.stderr)
        return 2
    if _drift_fix_record(env, cx, res) != 0:
        return 2
    print(f"✓ drift fix {kind}:{_esc_clean(rel, 200)} 第 {line} 行——{res['msg']}")
    if kind == "c2":
        _issue_close_revisits(env, rel, o["status"])
    print(f"修復帳要跟筆記一起提交:\n    {_drift_git_hint(cx, 'add ' + _DRIFT_FIXES)} && git commit")
    return 0


# ── 推送閘 ───────────────────────────────────────────────────────────────────────────

def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit, old_sentence)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。
    old_sentence(舊句檢查 m1 的開關,Projects/舊句檢查_計劃〈做法〉3)跟 gate 各自解析、互不牽連:沒寫、寫 null、
    設定檔壞掉 → warn;寫了 block/warn/off 以外的值 → warn 並多一句提醒。"""
    p = _drift_config_text_parts(text)
    return p["gate_mode"], p["gate_warns"] + p["os_warns"], p["explicit"], p["old_sentence"]


def _drift_config_parts(cfg, bad):
    """兩個開關各自的解析結果(doctor 要分開講,不靠提醒文字拆;代碼審 r2 架構對齊席)。"""
    gate, gw, explicit = _drift_gate_config(cfg, bad)
    osm, osw = _drift_old_sentence_config(cfg, bad)
    return {"gate_mode": gate, "gate_warns": gw, "explicit": explicit, "old_sentence": osm, "os_warns": osw}


def _drift_config_text_parts(text):
    """設定檔內容 → _drift_config_parts(解析寫法同 _drift_config)。"""
    import json as _j
    cfg, bad = None, False
    if text is not None:
        try:
            cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
        except (ValueError, UnicodeDecodeError):
            bad = True
    return _drift_config_parts(cfg, bad)


def _drift_old_sentence_config(cfg, bad=False):
    """→ (block|warn|off, [提醒])。預設 warn,跟 drift_check.gate 的預設(block)各管各的;設定檔讀不成 JSON 時也照 warn
    並另講一句(gate 那句只講 gate 的預設,不另講會讓人以為舊句檢查也跟著擋)。"""
    if bad:
        return "warn", [".lumos/config.json 讀不成 JSON,舊句檢查(drift_check.old_sentence)照預設 warn"]
    dc = cfg.get("drift_check") if isinstance(cfg, dict) else None
    v = dc.get("old_sentence") if isinstance(dc, dict) else None
    if v is None:
        return "warn", []
    if v not in _DRIFT_GATE_VALUES:
        return "warn", [f"drift_check.old_sentence 只能是 block/warn/off,你寫的是 {v!r},照預設 warn"]
    return v, []


def _drift_gate_config(cfg, bad):
    """drift_check.gate → (gate, warnings, explicit)。bad=設定檔讀不成 JSON。"""
    if bad:
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


def _drift_print_findings(rows, stream, acks=None, alive=None):
    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
              file=stream)
        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
        prev = _drift_prev_ack_line(f)
        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
        if prev:
            print(f"      ({_esc_clean(prev, 400)})", file=stream)
        elif old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  其餘 {len(rows) - 20} 筆這裡沒印;改完這些再推會再列" if rows[0]["kind"] == "m1"
              else f"  …還有 {len(rows) - 20} 筆", file=stream)


def cmd_drift_check(repo=None, diff_range=None, push_remote=None, pushed_ref=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。
    帶 --push-remote 與 --pushed-ref(推送前掛鉤與 CI 用,要一起給,只給一個回 2):A 當成遠端舊值,起點由
    _push_range_start 算,git 查詢失敗算不出起點時照「判不了」處理;都沒帶照共用起點判法(_lens_push_base),行為不變。"""
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
        return 0
    if (push_remote is None) != (pushed_ref is None):
        # 只給一個會算錯(r3 外家 finder:只給遠端名時不知道推的是哪條,推主線本身會被判成「頂端已在主線」整步跳過)
        print("擋下:--push-remote 與 --pushed-ref 要一起給(推送前掛鉤與 CI 用;手動跑兩個都不給)", file=sys.stderr)
        return 2
    push = None if push_remote is None else (push_remote, pushed_ref)
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
                                               mark=_DRIFT_GOLIVE_MARK, push=push)
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    mode, warns, _explicit, os_mode = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
    for w in warns:
        print(f"提醒:{w}", file=sys.stderr)
    # 兩個開關各管各的(Projects/舊句檢查_計劃〈做法〉3):c1 到 c5 與 probe 看 gate,舊句檢查 m1 看 old_sentence;回兩邊較大的
    rc_core = _drift_check_c(root, mode, os_mode, base, tip, vault_rel)
    if os_mode == "off":
        return rc_core
    return max(rc_core, _drift_m1_guarded(root, os_mode, base, tip, vault_rel))


def _drift_check_c(root, mode, os_mode, base, tip, vault_rel):
    """drift check 的 c1 到 c5 與 probe 那段(原本 cmd_drift_check 的後半)→ rc_core。gate=off 時不跑、回 0。"""
    import time as _t
    if mode == "off":
        print("存量漂移檢查:c1\u2013c5 與回頭條件關掉了(drift_check.gate=off);舊句檢查另有開關 drift_check.old_sentence,"
              "有改到程式檔時照跑" if os_mode != "off" else
              "存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
        return 0
    if isinstance(base, tuple):       # 推送起點算不出來:判不了,算要處理(block 擋、warn 印)
        must, listed, unknown = [], [], [f"推送範圍的起點算不出來({base[1]})"]
    else:
        must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
                                                  deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
    acks = _drift_load_acks(root, tip)
    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
    lst = _nodehome_list(root, tip)
    alive = set(lst[1]) if lst else None
    if listed:
        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
        _drift_print_findings(listed, sys.stderr, acks, alive)
        _drift_print_hints(listed, sys.stderr)
    if not must and not unknown:
        return 0
    return _drift_report_must(root, mode, must, unknown, acks, alive)


def _drift_report_must(root, mode, must, unknown, acks, alive=None):
            run.res["long_lines"] += 1
            continue
        toks = _drift_m1_line_hits(idx, ln, run.check_time)
        if not toks:
            continue
        layer = "handle" if (regs[i] == "summary" or rel in homes) else "list"
        why = "消失的名稱:" + "、".join(f"`{t}`(原本在 {'、'.join(sorted(gone[t]))})" for t in toks)
        run.res[layer if layer == "handle" else "listed"].append(
            {"kind": "m1", "path": rel, "line": i + 1, "text": ln.strip(), "why": why, "names": toks, "layer": layer})


def _drift_m1_judge(run, coded):
    """有起點時的判定:粗候選 → (有定義名粗候選才)終點語料 → 候選名稱 → 讀筆記 → 掃。"""
    tf, tall, tl = run.listing(run.tip)
    _bf, _ball, bl = run.listing(run.base)
    defs, paths = _drift_m1_rough(run, coded, tl, bl, tall)
    alive = _drift_m1_corpus(run, tf, tl) if defs else set()
    gone = {n: set(o) for n, o in defs.items() if n not in alive}
    for n, o in paths.items():
        gone.setdefault(n, set()).update(o)
    run.res["candidates"] = len(gone)
    run.res["gone"] = {n: sorted(o) for n, o in gone.items()}
    names = {n: o for n, o in gone.items() if _drift_m1_name_canon(n) is not None}
    run.res["too_long"] = len(gone) - len(names)
    if not names:
        return
    pre = run.vault_rel.rstrip("/") + "/"
    envs = _drift_m1_envs(run, {p[len(pre):] for _st, p in run.changes if p.startswith(pre)})
    homes = _drift_m1_homes(run, envs, coded)
    texts = {r: env_text(envs[0], r) for r, n in envs[0].notes.items() if not _note_unreadable(n)}
    idx = _drift_m1_name_index(_drift_m1_prefilter(names, [t for t in texts.values() if t], run.check_time), run.check_time)
    for rel in sorted(texts):
        run.check_time()
        if texts[rel]:
            _drift_m1_scan_note(run, rel, texts[rel], idx, names, homes)
    if run.res["bad_touched"]:
        run.res["state"] = "unreadable"


def _drift_old_sentence_check(root, base, tip, vault_rel, deadline, now=time.monotonic):
    """舊句檢查的判定本體(Projects/舊句檢查_計劃〈做法〉1 到 3)→ dict:handle、listed(發現)、state(done / timeout /
    git-failed / unreadable / no-base;範圍裡沒有改到程式檔是 None = 不印不記)、unparsable、text_defs(路徑)、
    bad_notes、bad_touched、code_files、other_files、candidates(還沒算出來是 None)、too_long、parsed、cache_hits、
    gone({候選名稱: 起點路徑清單},含太長沒列的)。
    不印、不寫帳。base 是 None = 空樹起點;是 tuple = 推送起點算不出來(列不出改到哪些檔,記 git-failed)。
    now 預設 time.monotonic(測試換掉它來造「掃到一半時間到」);截止時間 deadline 用同一個時鐘。"""
    run = _DriftM1Run(root, base, tip, vault_rel, deadline, now)
    try:
        if isinstance(base, tuple):
            raise _DriftM1Stop("git-failed")
        run.cache = _drift_m1_cache_dir()
        run.res["cache_hits"] = None if run.cache is None else 0
        _drift_m1_cache_evict(run.cache)
        coded = _drift_m1_classify(run, _drift_m1_changes(run))
        if not coded:
            return run.res
        run.res["code_files"] = len(coded)
        run.res["other_files"] = sum(1 for c in coded if c[2] == "other")
        if base is None:
            run.res["state"] = "no-base"
            return run.res
        run.res["state"] = "done"
        _drift_m1_judge(run, coded)
    except _DriftM1Stop as ex:
        run.res["state"] = ex.state
    return run.res


# ── m1 的印出與記帳 ──

def _drift_unknown_hint(u):
    """判不了那一句(_drift_report_must 與 m1 共用)。"""
    return (f"  判不了:{_esc_clean(u, 1000)}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
            "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push")


def _drift_m1_long_note(res):
    """有超長行沒看時接在結論行後面的那一段;沒有回空字串。"""
    ll = res.get("long_lines") or 0
    return f";有 {ll} 行太長沒看(超過 {_DRIFT_M1_LINE_MAX} 字)" if ll else ""


def _drift_m1_busy(res, handle):
    """「有東西」:要處理有筆數、判不了,或有超長行沒看(沒看完的地方可能藏著舊句,照判不了算;代碼審 r2 資安席)。"""
    return bool(handle) or res["state"] in _DRIFT_M1_UNKNOWN or bool(res.get("long_lines"))


def _drift_m1_conclusion(res, a, b):
    """結論行(沒有開頭詞)。a、b = 要處理、只列出筆數(扣掉已表態的)。有超長行沒看時不說「沒有還在講的」。"""
    st, n = res["state"], res["candidates"]
    if st == "done" and not n:
        return f"舊句檢查:這次改到 {res['code_files']} 支程式檔,沒有名稱消失"
    if st == "done" and not (a or b) and res.get("long_lines"):
        return f"舊句檢查:這次消失 {n} 個名稱" + _drift_m1_long_note(res) + ",看得到的行沒有提到"
    if st == "done" and not (a or b):
        return f"舊句檢查:這次消失 {n} 個名稱,筆記裡沒有還在講的"
    if st == "done":
        return f"舊句檢查:這次推送消失了 {n} 個名稱,筆記裡還在講的——要處理 {a} 筆、只列出 {b} 筆" + _drift_m1_long_note(res)
    return {"timeout": f"舊句檢查:這次沒跑完(時間到,{_DRIFT_M1_BUDGET_SEC} 秒)",
            "git-failed": "舊句檢查:git 讀不出這次推送的範圍或內容,這次沒判",
            "unreadable": f"舊句檢查:這次改到的筆記有 {res['bad_touched']} 篇讀不出,這次沒判完",
            "error": f"舊句檢查:工具內部出錯({_drift_m1_show(res.get('error') or '?', 120)}),這次沒判",
            "no-base": "舊句檢查:這次沒有起點版可比,不判"}[st]


def _drift_m1_print_extra(res):
    u, t = res["unparsable"], res["text_defs"]
    if u or t:
        print(f"  {len(u)} 支剖不動、{len(t)} 支用文字比對:" + "、".join(_drift_m1_show(x, 200) for x in (u + t)[:3]),
              file=sys.stderr)
    if res["too_long"]:
        print(f"  {res['too_long']} 個名稱太長或帶控制字元、頭尾空白,沒列(沒辦法表態)", file=sys.stderr)
    if res["bad_notes"]:
        print(f"  {res['bad_notes']} 篇筆記讀不出沒掃", file=sys.stderr)
    if res["other_files"]:
        print(f"  這次有 {res['other_files']} 支非 Python 程式檔改動(只看路徑)", file=sys.stderr)


def _drift_m1_show_row(f):
    """印到終端用的一筆:路徑、原文、說明裡的方向控制與零寬字元、非 UTF-8 位元組照 c4 證據頁那支(_drift_c4_show_name)
    換成看得見的寫法(代碼審 r2 資安席);表態比對與改法仍用原本的字串。"""
    return dict(f, path=_drift_c4_show_name(f["path"]), text=_drift_c4_show_name(f["text"]), why=_drift_c4_show_name(f["why"]))


def _drift_m1_print_rows(res, handle, listed):
    if res["state"] == "timeout" and (handle or listed):
        print("  以下只是已找到的部分", file=sys.stderr)
    for head, rows in (("要處理(舊句檢查):", handle), ("只列出(舊句檢查,不擋):", listed)):
        if rows:
            print(head, file=sys.stderr)
            _drift_print_findings([_drift_m1_show_row(f) for f in rows], sys.stderr)
            _drift_print_hints(rows, sys.stderr)


def _drift_m1_rows(rows, n):
    """帳的 rows:路徑、名稱、原文都來自被推送的筆記與程式,寫帳前過 _esc_clean(原文取前 80 字)。"""
    return [{"path": _drift_m1_show(f["path"]), "line": f["line"], "layer": f["layer"],
             "names": sorted(_drift_m1_show(x) for x in f["names"]),
             "text": _drift_m1_show(f["text"])[:80]} for f in rows[:n]]


def _drift_m1_fit(root, kind, note, hard, tip, nodes, extra):
    """整行(照 _ledger_append 的量法,量 _gate_event_build 組出的完整事件)超過 4096 位元組:先從只列出、再從要處理尾端丟 rows;
    丟光還超過 → nodes 截到 20;再超過照寫。有截就記 rows_truncated。"""
    import json as _j

    def size():
        ev = _gate_event_build(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra)
        return len((_j.dumps(ev, ensure_ascii=False) + "\n").encode("utf-8"))
    rows = extra.get("rows")
    while rows and size() > 4096:
        rows.pop()           # rows 是要處理在前、只列出在後,從尾端丟就是先丟只列出
        extra["rows_truncated"] = True
    if len(nodes) > 20 and size() > 4096:
        nodes = nodes[:20]
        extra["rows_truncated"] = True
    return nodes


def _drift_m1_ledger_miss(root, tip, state):
    """治理帳寫不進去時的留痕:~/.cache/lumos/drift-m1/ledger-miss.jsonl 追加一行(REVISIT 讀它算樣本不足)。"""
    import json as _j, datetime as _dt
    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-m1"):
        return False
    d = Path.home() / ".cache" / "lumos" / "drift-m1"
    if not _trusted_private_dir(d, ".cache", "lumos", "drift-m1"):
        return False
    line = _j.dumps({"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                     "repo": _drift_m1_show(os.path.realpath(str(root))), "head_sha": tip, "state": state},
                    ensure_ascii=False) + "\n"
    try:
        # O_NONBLOCK:有人在這裡放了同名 FIFO 時開檔不會卡住推送(沒有讀端就直接失敗);開了再確認是自己的一般檔
        # (代碼審 r2 邊界席)
        fd = os.open(str(d / "ledger-miss.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
                     | getattr(os, "O_NONBLOCK", 0), 0o600)
        try:
            import stat as _stat
            fst = os.fstat(fd)
            if not _stat.S_ISREG(fst.st_mode) or (hasattr(os, "getuid") and fst.st_uid != os.getuid()):
                return False
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)
        return True
    except OSError:
        return False


def _drift_m1_ledger(root, mode, base, tip, res, found, note):
    """記一筆治理帳(gate drift-check;欄位攤平在事件最外層,check=old-sentence)。found=(要處理, 只列出)(扣掉已表態)。"""
    handle, listed = found
    st = res["state"]
    judged = st not in _DRIFT_M1_UNKNOWN
    busy = _drift_m1_busy(res, handle)
    # no-base 記 range-unavailable(既有結果詞,跟綁定測試閘算不出範圍同一個):原本記 skipped,gov --stats 會把它算進
    # 「被跳過」——那一行講的是有人略過閘,這裡是沒起點可比(代碼審 r1 併發回滾席)
    kind = "range-unavailable" if st == "no-base" else ("passed" if not busy else ("blocked" if mode == "block" else "warned"))
    hard = kind == "blocked"
    extra = {"check": "old-sentence", "state": st, "base_sha": base if isinstance(base, str) else "",
             "code_files": res["code_files"], "candidates": res["candidates"],
             "handle": len(handle) if judged else None, "listed": len(listed) if judged else None,
             "unparsable": len(res["unparsable"]), "text_defs": len(res["text_defs"]),
             "text_defs_paths": [_drift_m1_show(x) for x in res["text_defs"][:3]], "too_long": res["too_long"],
             "long_lines": res["long_lines"], "parsed": res["parsed"], "cache_hits": res["cache_hits"], "rows_truncated": False}
    if res.get("error"):
        extra["error"] = _drift_m1_show(res["error"], 200)
    if st == "done":
        extra["rows"] = _drift_m1_rows(handle, 10) + _drift_m1_rows(listed, 3)
    nodes = sorted({_drift_m1_show(f["path"][:-3]) for f in handle})[:50] if judged else []
    nodes = _drift_m1_fit(root, kind, note, hard, tip, nodes, extra)
    if _gate_event_or_warn(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra) is False:
        _drift_m1_ledger_miss(root, tip, st)


def _drift_m1_guarded(root, mode, base, tip, vault_rel):
    """跑 m1 並印出、記帳 → rc_m1。m1 裡任何沒預料到的例外都兜底成「判不了」(state error):warn 印一行、回 0,
    block 照判不了的規矩擋——原本例外一路丟到最外層,warn 模式也整支回 1(代碼審 r1 正確性席)。"""
    try:
        res = _drift_old_sentence_check(root, base, tip, vault_rel, time.monotonic() + _DRIFT_M1_BUDGET_SEC)
        return _drift_m1_report(root, mode, base, tip, vault_rel, res)
    except Exception as ex:
        err = f"{type(ex).__name__}: {ex}"
    try:
        return _drift_m1_report(root, mode, base, tip, vault_rel, _drift_m1_new_res("error", err))
    except Exception:
        print(f"舊句檢查:工具內部出錯({_drift_m1_show(err, 120)}),這次沒判,帳也沒記", file=sys.stderr)
        return 1 if mode == "block" else 0


def _drift_m1_report(root, mode, base, tip, vault_rel, res):
    """m1 的結論行、發現、改法(全部 stderr)與治理帳 → rc_m1(block 而且要處理有筆數或判不了時 1,其他 0)。
    state 是 None(範圍裡沒有改到程式檔)不印不記。"""
    st = res["state"]
    if st is None:
        return 0
    handle, listed = res["handle"], res["listed"]
    if handle or listed:
        acks = _drift_load_acks(root, tip)
        handle, _h = _drift_split_acked(handle, acks, vault_rel)
        listed, _l = _drift_split_acked(listed, acks, vault_rel)
    busy = _drift_m1_busy(res, handle)
    line = _drift_m1_conclusion(res, len(handle), len(listed))
    if busy:
        line = "擋下:" + line if mode == "block" else "提醒:" + line + "(drift_check.old_sentence=warn,不擋)"
    print(line, file=sys.stderr)
    if mode == "block" and st in _DRIFT_M1_UNKNOWN:
        print(_drift_unknown_hint("舊句檢查沒判完"), file=sys.stderr)
    elif mode == "block" and res.get("long_lines"):
        print(_drift_unknown_hint(f"舊句檢查有 {res['long_lines']} 行超過 {_DRIFT_M1_LINE_MAX} 字沒看(把那幾行拆短就能判)"),
              file=sys.stderr)
    if mode == "block" and busy:     # 代碼審 r2 正確性席:m1 擋下時,改的是 old_sentence,不是 gate
        print("  舊句檢查擋下的:要整個專案先只提醒,是把 .lumos/config.json 的 drift_check.old_sentence 設成 warn"
              "(改 drift_check.gate 不影響這一項)", file=sys.stderr)
    _drift_m1_print_extra(res)
    _drift_m1_print_rows(res, handle, listed)
    _drift_m1_ledger(root, mode, base, tip, res, (handle, listed), line)
    return 1 if (busy and mode == "block") else 0


# ── 健檢與 doctor ────────────────────────────────────────────────────────────────────

def _drift_vault_of(env):
    root = _vault_repo_root(env)
    try:
        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        return root, env.vault.name


def cmd_drift_scan(env, at=None, as_json=False, budget=None):
    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
    import json as _j, math as _m, time as _t
    budget = _DRIFT_BUDGET_SEC if budget is None else budget
    if not _m.isfinite(budget) or not 0 < budget <= 86400:
        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
        return 2
    deadline = _t.monotonic() + budget
    """把來自圖譜/紀錄檔的值變成單行、去掉框線與控制字元的安全字串。
    ★節點名這種「看起來無害」的欄位也要過這一關★:檔名可以有換行、可以就叫
    「參考資料結束」(外家審查席 r1)。"""
    if raw is None:
        return "?"
    s = str(raw).replace("\r", " ").replace("\n", " ").replace("─", "-")
    s = "".join(ch for ch in s if ch == "\t" or ord(ch) >= 32)
    s = s.strip()
    return (s[:cap] + "…") if len(s) > cap else (s or "?")
# ── ★注入框結束★ ──────────────────────────────────────────────────

def _lens_armed_root():
    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / "armed"


def _lens_repo_key(root):
    """寫讀兩端同一支:repo 根 realpath 的 sha256(r1 邊界 F4:symlink/尾斜線表示法不同會對不上)。"""
    import hashlib
    return hashlib.sha256(str(Path(os.path.realpath(str(root)))).encode("utf-8")).hexdigest()[:32]


def _lens_repo_root(repo):
    start = Path(repo) if repo else Path.cwd()
    r = _lens_git(start, "rev-parse", "--show-toplevel")
    if r is None or r.returncode != 0 or not r.stdout.strip():
        return None
    return Path(r.stdout.strip())


def _trusted_private_dir(d, *rel_segments):
    """★私有目錄信任檢查(單一來源)★——這套工具在家目錄底下寫的暫存/標記目錄都走這支。

    檢查四件事,少一件都不算過:
      ① 它自己不是 symlink;
      ② **整條路徑都沒有經過 symlink**——拿「解析過的預期路徑」對照,所以父層(例如 ~/.cache
         或 ~/.cache/lumos)被換成指向別處的 symlink 也擋得下來;家目錄本身可以是 symlink
         (macOS 的 /var → /private/var 就是),所以預期路徑也先解析再比;
      ③ 是目錄、而且 owner 是自己;
      ④ group / other 不可寫。

    ★出身(2026-09-06 全 repo 審視 #6)★:收工擋停那道檢查在 r2/r3 各補過一刀(拒 symlink、
    解析後路徑必須相等),但派工鏡頭那道**沒跟上**。實測同一個「指向別處的 symlink」:
    收工擋停那道拒絕、鏡頭那道照信——而鏡頭那邊真的會對那個目錄做 rmtree 與 chmod。
    現在兩邊共用這一支,不會再各自漂。

    ★★第一版我把這支做得比抄來的那道還弱,外家審查席抓到(2026-09-07)★★:
    我原本收的參數是一個「預期路徑」,而且**把它整條 resolve 之後才比對**。兩邊一起跟著
    symlink 走,結果就是自己比自己——中間層被換成指向別處的 symlink 時完全擋不住。
    實測:把中間一層做成指向另一棵樹的 symlink,舊寫法照樣通過。
    ★正解是「預期路徑只解析家目錄那一段,後面用字面段」★(抄來的那道本來就是這樣做的):
    家目錄本身可以是 symlink(macOS 的 /var → /private/var 就是),但家目錄以下每一層
    都必須是真目錄。所以這支改成收「相對家目錄的字面段」,呼叫端沒辦法再傳一個
    會自我抵銷的預期路徑。

    不過關一律「不信、不碰」(不擋、不寫、不刪),寧可少一層功能,不在別人的目錄上動手。

    ★誠實邊界:這是路徑層檢查,擋不住同一個帳號底下的搶跑(TOCTOU)★——
    檢查完到真正動手之間有時間差,同 UID 的程序可以在那個縫裡把目錄換掉。要真正關掉
    得改用 dirfd / O_NOFOLLOW 那一套。沒做的理由:能在你的帳號下跑程式的人本來就能
    做任何事,這條的邊際價值低。**但不得宣稱「換掉也擋得住」**——那是假的。
    REVISIT:2026-12-07 若出現「非同帳號但能寫家目錄」的實際情境(共用機器、容器掛載),
    這條的成本效益要重算,那時就該做 dirfd 版
    """
    import stat as _stat
    try:
        if d.is_symlink():
            return False
        # ★只解析家目錄那一段,後面字面接★——整條 resolve 會讓兩邊一起跟著 symlink 走,
        # 檢查就變成自我抵銷(第一版的錯法,見上面)。
        expected = Path.home().resolve().joinpath(*rel_segments)
        if Path(d).resolve() != expected:
            return False
        st = d.stat()
    except OSError:
        return False
    if not d.is_dir():
        return False
    if hasattr(os, "getuid"):
        if st.st_uid != os.getuid():
            return False
        if st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH):
            return False
    return True


def _mkdir_private_layer(cur):
    """建一層(不帶 parents:一層一層來,才檢查得到每一層);已經在了回 True,交給呼叫端的檢查判。
    ★新建的層一律明給 0700,建完再用不跟連結的 chmod 收一次★:umask 002 的機器上原本建出 0775,馬上被自己的檢查判不可信,
    家目錄底下的快取、鎖、標記整個用不了(舊句檢查代碼審 r1 併發回滾席;r2 裁定修在這裡、所有走這支的鄰居一起受惠,判準不放寬)。"""
    try:
        cur.mkdir(mode=0o700)
    except FileExistsError:
        return True                       # 已經在了(可能是連結),交給下面的檢查判
    except OSError:
        return False
    return _chmod_no_follow(cur, 0o700)


def _mkdir_trusted_under_home(*rel_segments):
    """從家目錄往下逐層建、逐層檢查,全過才回 True。

    ★為什麼要有這一支★(2026-09-16):家目錄底下那幾個寫入點原本都是「先 mkdir 出整條路徑,
    再檢查這條路徑可不可信」。★順序反了★——檢查不過的時候,連結指到的地方(可能是別人的
    目錄)已經被建出一層空資料夾了。真正危險的動作(寫檔、改權限、刪目錄)確實都排在檢查
    之後,所以以前只當成殘留寫在註解裡;但「在別人的目錄裡留東西」本來就不該做,而且這是
    那幾處★共用的★缺口,不是誰特有。

    逐層的意思:每建一層就確認它是真目錄、是自己的、別人不可寫(跟 `_trusted_private_dir`
    同一套判準,而且同樣是「家目錄本身可以是連結、家目錄以下每一層都必須是真目錄」)。
    ★任何一層不過就停手,已經建好的不回頭刪★——刪反而是在動別人的東西,跟「不信、不碰」
    的家規相反。

    ★誠實邊界★:跟 `_trusted_private_dir` 一樣,這是路徑層檢查,擋不住同一個帳號底下的搶跑
    (檢查完到下一層動作之間有時間差,同 UID 的程序可以在那個縫裡把目錄換掉)。要真正關掉
    得改用 dirfd / O_NOFOLLOW 那一套。沒做的理由:能在你的帳號下跑程式的人本來就能做任何事。
    **不得宣稱「換掉也擋得住」**。
    """
    import stat as _stat
    cur = Path.home()
    for seg in rel_segments:
        # ★每一段都必須是一個單純的名字★(2026-09-16 外家備援席):Python 的路徑接合遇到
        # 絕對路徑會★整個重置★,`..` 也照走——實測絕對路徑段直接在別的地方建出資料夾、
        # 而且回報成功,這支函式的名字就叫「留在家目錄底下」,那樣等於沒做到。
        # 呼叫端目前全是寫死的字面段,所以這是守衛完整性,不是現行可被利用的洞。
        if (not isinstance(seg, str) or not seg or seg in (".", "..")
                or "/" in seg or "\\" in seg or Path(seg).is_absolute()):
            return False
        cur = cur / seg
        if not _mkdir_private_layer(cur):
            return False
        try:
            if cur.is_symlink() or not cur.is_dir():
                return False
            st = cur.stat()
        except OSError:
            return False
        if hasattr(os, "getuid"):
            if st.st_uid != os.getuid():
                return False
            if st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH):
                return False
    return True


def _chmod_no_follow(d, mode):
    """改一個★目錄★的權限,而且不准跟著符號連結走。成功回 True。

    ★為什麼不直接 os.chmod★(2026-09-16 代碼審 資安席):`os.chmod` 會跟著連結走。
    武裝目錄那處父層已經逐層驗過了,★但葉節點那一層還是「先建、先改權限、才驗」★——
    葉節點在檢查之後被換成指向別人目錄的連結時,權限就改到別人的目錄上;
    最後那道驗證雖然擋得下寫入,但權限已經動過、回不去了。

    做法是用 O_NOFOLLOW|O_DIRECTORY 開它再 fchmod:不是目錄、或是連結,開的時候就失敗。
    ★這是這份工具裡第一處真的用 dirfd 關掉競速窗口的地方★——其餘幾處仍是路徑層檢查,
    仍然擋不住同帳號搶跑(那條誠實邊界照舊成立,不要因為這裡做了就以為全都做了)。
    """
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_DIRECTORY", 0)
    try:
        fd = os.open(str(d), flags)
    except OSError:
        return False
    try:
        os.fchmod(fd, mode)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def _lens_arm_dir_ok(d):
    """armed 目錄安全檢查——走共用的 _trusted_private_dir。

    ★預期路徑怎麼算★:armed 目錄底下多一層 repo 指紋。這裡把「家目錄以下的每一層」用字面段
    交出去(不是交一個組好的路徑),所以前綴那幾層被換成 symlink 一樣擋得下來——
    交組好的路徑會讓兩邊一起解析而自我抵銷,那是第一版的錯法。
    指紋那層是我們自己算出來的、不是外來輸入,所以直接用 d 的名字。"""
    return _trusted_private_dir(d, ".cache", "lumos", "dispatch-lens", "armed", Path(d).name)


def cmd_dispatch_lens_arm(diff_range, repo=None, seats=1, no_cache=False):
    """算好鏡頭文字,武裝 N 席。"""
    import json as _json, io, contextlib, shutil, time as _time
    root = _lens_repo_root(repo)
    if root is None:
        print(f"擋下:{repo or Path.cwd()} 不在 git 專案裡", file=sys.stderr)
        return 2
    try:
        seats = int(seats)
    except (TypeError, ValueError):
        seats = 0

