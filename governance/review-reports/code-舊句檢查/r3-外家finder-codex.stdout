def _drift_hint_key(f):
    """改法去重鍵:c1 一篇一條;m1 帶名稱集合(同一行不同名稱集合是兩條表態);其他一行一條。"""
    if f["kind"] == "c1":
        return f["kind"], f["path"]
    if f["kind"] == "m1":
        return f["kind"], f["path"], f["line"], tuple(sorted(f.get("names") or ()))
    return f["kind"], f["path"], f["line"]


def _drift_print_hints(rows, stream, head="改法:"):
    """一批發現的改法指令;c1 一篇一條(改一次整篇的預告句都改掉)。m1 那條不截在 300 字(上限 4000,_drift_fix_hint 管),
    超過 20 條那句不指到 drift scan(scan 不含舊句檢查)。"""
    seen, out = set(), []
    for f in rows:
        k = _drift_hint_key(f)
        if k in seen:
            continue
        seen.add(k)
        out += _drift_fix_hint(f["kind"], f["path"], f["line"], f.get("names"))
    if out:
        m1 = rows[0]["kind"] == "m1"
        print(head, file=stream)
        for x in out[:20]:
            print(f"    {_esc_clean(x, 4000 if m1 else 300)}", file=stream)
        if len(out) > 20:
            print(f"    其餘 {len(out) - 20} 筆這裡沒印;改完這些再推會再列" if m1
                  else f"    …還有 {len(out) - 20} 條(lumos drift scan 看全部)", file=stream)


_DRIFT_C3_STATUSES = frozenset(_STATUS_ENUM["verification"] - {"pending"})
_DRIFT_FIX_OPTS = ("date", "close", "keep", "status", "reason", "by")
_DRIFT_FIX_ALLOWED = {"c1": {"date"}, "c2": {"close", "keep", "status", "reason"}, "c3": {"status", "by", "reason"},
                      "c4": set(), "c5": set()}


def _drift_one_line(t):
    """沒有任何分行字元:不只 \\n \\r,還有 str.splitlines() 會切開的 U+2028、U+0085、換頁字元——寫進筆記或帳檔後,
    用 splitlines 讀的人會看成兩行(代碼審 r1 邊界、資安席)。"""
    return len(("x" + t + "x").splitlines()) == 1

def _drift_m1_name_rx(names):
    """整字比對的一條正則(逐字照參考實作 _mk_rx):一般識別字前後不能緊接 ASCII 英數底線;旗標、路徑、帶 . 的前面不能緊接
    ASCII 英數、底線、/ . -,後面不能緊接 ASCII 英數、底線、-。一般識別字那組在前、組內長的在前。"""
    ids = sorted((n for n in names if not n.startswith("--") and "/" not in n and "." not in n), key=len, reverse=True)
    idset = set(ids)
    others = sorted((n for n in names if n not in idset), key=len, reverse=True)
    parts = []
    if ids:
        parts.append(r"(?<![A-Za-z0-9_])(?:" + "|".join(map(re.escape, ids)) + r")(?![A-Za-z0-9_])")
    if others:
        parts.append(r"(?<![A-Za-z0-9_/.-])(?:" + "|".join(map(re.escape, others)) + r")(?![A-Za-z0-9_-])")
    return re.compile("|".join(parts)) if parts else None


_DRIFT_M1_TICK_EVERY = 256     # 名稱索引與逐行比對的大迴圈每這麼多個名稱看一次截止時間(代碼審 r2 外家否決席)


def _drift_m1_ticker(tick):
    """每呼叫 _DRIFT_M1_TICK_EVERY 次才真的看一次時間的包裝(tick 是 None 就不看)。"""
    n = [0]

    def f():
        n[0] += 1
        if tick is not None and n[0] % _DRIFT_M1_TICK_EVERY == 0:
            tick()
    return f


def _drift_m1_name_index(names, tick=None):
    """一行可能提到哪些名稱的索引 → ({第一段 ASCII 詞: [(名稱, 各段)]}, 沒有 ASCII 段的名稱)。tick:看截止時間(時間到丟出)。"""
    by, bare, t = {}, [], _drift_m1_ticker(tick)
    for n in names:
        t()
        segs = _DRIFT_M1_ASCII_WORD_RE.findall(n)
        if segs:
            by.setdefault(segs[0], []).append((n, segs))
        else:
            bare.append(n)
    return by, bare


def _drift_m1_line_names(idx, ln, tick=None):
    """這一行可能命中的名稱:每一段 ASCII 詞都是這一行的完整 ASCII 詞、而且整個名稱是這一行的子字串(跟名稱先篩同一個
    道理,整字正則命中的地方一定符合)。拿掉不可能命中的名稱不改正則在任何位置的結果,一行的比對只跑這幾個名稱
    (代碼審 r1 資安席:原本幾萬個名稱編成一條正則對每一行跑,時間沒有上限)。"""
    words, out, t = set(_DRIFT_M1_ASCII_WORD_RE.findall(ln)), [], _drift_m1_ticker(tick)
    for w in words:                       # 大量名稱共用第一段(src/…)時同一桶很大:桶裡每一批也看時間
        for n, segs in idx[0].get(w, ()):
            t()
            if n in ln and all(x in words for x in segs):
                out.append(n)
    for n in idx[1]:
        t()
        if n in ln:
            out.append(n)
    return out


def _drift_m1_prefilter(names, texts, tick=None):
    """名稱先篩(候選超過 _DRIFT_M1_PREFILTER_MIN 個才做):名稱每一段 ASCII 詞都在圖譜全文的 ASCII 詞集合裡才留下,
    沒有 ASCII 段的一律留下。整字正則命中處的每一段一定是完整的 ASCII 詞,所以篩掉的一定不會命中、不改結果。"""
    if len(names) <= _DRIFT_M1_PREFILTER_MIN:
        return names
    words = set()
    for t in texts:
        if tick is not None:
            tick()
        words.update(re.findall(r"[A-Za-z0-9_]+", t))
    t2, out = _drift_m1_ticker(tick), {}
    for n, o in names.items():
        t2()
        if all(w in words for w in re.findall(r"[A-Za-z0-9_]+", n)):
            out[n] = o
    return out


def _drift_m1_about(text):
    """about_code 只認區塊清單「- 路徑」(照參考實作 Note._about;單行寫法 about_code: x 不認)。"""
    fm, _body = split_frontmatter(text)
    out, cur = [], False
    for ln in fm or []:
        m = TOP_KEY_RE.match(ln)
        if m:
            cur = m.group(1) == "about_code"
            continue
        s = ln.strip()
        if cur and s.startswith("- "):
            out.append(s[2:].strip().strip('"').strip("'").strip("`"))
    return out


def _drift_m1_cache_dir():
    """定義快取目錄 ~/.cache/lumos/drift-defs/ → Path 或 None(建不了、不可信:當沒快取,也不寫不刪)。"""
    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-defs"):
        return None
    if d is None:
        return
    try:
        ents = list(d.iterdir())
    except OSError:
        return
    for f in ents:
        try:
            if f.is_file() and not f.is_symlink() and time.time() - f.stat().st_mtime > _DRIFT_M1_DEFS_TTL:
                f.unlink()
        except OSError:
            pass


def _drift_m1_new_res(state=None, error=None):
    """判定結果的空白樣子(_drift_old_sentence_check 與出例外時的兜底共用)。"""
    return {"state": state, "handle": [], "listed": [], "unparsable": [], "text_defs": [], "bad_notes": 0,
            "bad_touched": 0, "code_files": None, "other_files": 0, "candidates": None, "too_long": 0, "long_lines": 0,
            "parsed": 0, "cache_hits": None, "gone": {}, "error": error}


class _DriftM1Stop(Exception):
    """判不了、停下:state 是 timeout 或 git-failed。"""

    def __init__(self, state):
        super().__init__(state)
        self.state = state


_DRIFT_M1_EMPTY_INFO = ("ast", (frozenset(),) * 4, frozenset(), frozenset())


class _DriftM1Run:
    """一次舊句檢查的狀態(〈做法〉1 到 3):範圍、快取、計數、已讀的內容與剖過的結果。由 _drift_old_sentence_check 建。"""

    def __init__(self, root, base, tip, vault_rel, deadline, now):
        self.root, self.base, self.tip, self.vault_rel = root, base, tip, vault_rel
        self.deadline, self.now = deadline, now
        self.raw, self.info = {}, {}
        self.cache, self.changes = None, []
        self.res = _drift_m1_new_res()

    def check_time(self):
        if self.now() > self.deadline:
            raise _DriftM1Stop("timeout")

    def fail(self):
        raise _DriftM1Stop("timeout" if self.now() > self.deadline else "git-failed")

    def left(self):
        return max(1.0, self.deadline - self.now())

    def listing(self, where):
        """(一般檔 {路徑: 模式}, 所有路徑, {路徑: 內容編號});where 是 None(空樹)回空的。"""
        if where is None:
            return {}, [], {}
        self.check_time()
        lst = _drift_list(self.root, where)
        if lst is None:
            self.fail()
        return lst[0], lst[1], _drift_oids(self.root, where)

    def spec(self, where, oids, p):
        return oids.get(p) or f"{where}:{p}"

    def read(self, specs):
        """批次讀(以剩下的時間為上限);已讀過的不重讀。回 None 時已過截止時間記 timeout,否則 git-failed。"""
        need = sorted({s for s in specs if s and s not in self.raw})
        if not need:
            return
        self.check_time()
        got = _drift_m1_cat(self.root, need, self.left())
        if got is None:
            self.fail()
        self.raw.update(zip(need, got))

    def head(self, spec):
        return _drift_decode(self.raw.get(spec) or b"").split("\n", 1)[0]

    def cached(self, spec):
        """快取命中就記進 info、回 True(.py 命中不讀內容)。"""
        if spec in self.info:
            return True
        got = _drift_m1_cache_get(self.cache, spec)
        if got is None:
            return False
        self.info[spec] = ("ast", got[:4], got[4], None)
        if self.res["cache_hits"] is not None:
            self.res["cache_hits"] += 1
        return True

    def blob_info(self, spec):
        """(種類 ast|big|bad, 四個集合或 None, 文字抽定義, 引號旗標或 None)。剖完寫快取(剖不動與太大的不寫)。"""
        if spec in self.info or self.cached(spec):
            return self.info[spec]
        raw = self.raw.get(spec)
        txt = _drift_decode(raw or b"")
        if raw is None:         # 讀不到內容(不是一般檔、批次讀回 None):當剖不動,不寫快取
            got = ("bad", None, set(), set())
        elif len(raw) > _DRIFT_M1_PARSE_MAX_BYTES:
            got = ("big", None, _drift_m1_text_defs(txt), _drift_m1_text_defs(txt, loose=True))
        else:
            self.check_time()
            self.res["parsed"] += 1
            sets = _drift_py_names(txt, m1=True)
            tdefs = _drift_m1_text_defs(txt)
            got = ("bad", None, tdefs, _drift_m1_text_defs(txt, loose=True)) if sets is None else ("ast", sets, tdefs, None)
            if sets is not None and self.cache is not None and _LENS_SHA_RE.fullmatch(spec):
                _home_cache_write("drift-defs", _drift_m1_cache_path(self.cache, spec),
                                  {k: sorted(v) for k, v in zip("fcagt", (*sets, tdefs))})
        self.info[spec] = got
        return got


def _drift_m1_cat(root, specs, timeout):
    """m1 讀程式檔內容的唯一出口(一次批次讀;測試數它被呼叫幾次)。"""
    return _nodehome_cat_blobs(root, specs, timeout=timeout)


def _drift_m1_changes(run):
    """範圍裡改到的檔 [(狀態, 路徑)](--no-renames:改名看成一刪一加)。列不出 → 停下。"""
    run.check_time()
    raw = _ns_git(run.root, "diff", "--name-status", "-z", "--no-renames", "--no-ext-diff",
                  run.base or _drift_empty_tree(run.root), run.tip)
    if raw is None:
        run.fail()
    codes = {}
    _nodehome_name_status(raw, codes=codes)      # 解析用共用那支(代碼審 r1 架構對齊席:原本手刻第二份)
    run.changes = sorted(((c, p) for p, c in codes.items()), key=lambda x: x[1])
    return run.changes


def _drift_m1_classify(run, changes):
    """改到的檔 → [(狀態, 路徑, py|other)] 只收程式檔。沒副檔名的要讀首行;有起點時順便把改到的 .py 快取沒命中的兩版一起讀
    (粗候選要的改到的檔,一次批次讀)。一支可能是程式檔的都沒有就不列檔、不讀(純文件推送不印不記)。"""
    maybe = [(st, p) for st, p in changes if _drift_m1_code_path(p) and _nodehome_code_kind(p) in ("ext", "shebang?")]
    if not maybe:
        return []
    tl, bl = run.listing(run.tip)[2], run.listing(run.base)[2]
    need = []
    for st, p in maybe:
        vers = ([run.spec(run.tip, tl, p)] if st != "D" else []) + \
               ([run.spec(run.base, bl, p)] if (run.base and st != "A") else [])
        if _nodehome_code_kind(p) == "shebang?":
            need += vers
        elif p.endswith(".py") and run.base:
            need += [s for s in vers if not run.cached(s)]
    run.read(need)
    return [c for c in (_drift_m1_kinds(run, st, p, tl, bl) for st, p in maybe) if c]


def _drift_m1_kinds(run, st, p, tl, bl):
    """一支改到的檔 → (狀態, 路徑, py|other, 起點版是 Python, 終點版是 Python) 或 None。起點版與終點版各自判,
    任一邊是 Python 就算 Python 檔(代碼審 r1 外家席:沒副檔名的 Python 腳本拿掉 #! 或改成 shell,原本只看終點、
    起點的定義整批漏掉)。"""
    kt = _drift_m1_code_kind(p, run.head(run.spec(run.tip, tl, p))) if st != "D" else None
    kb = _drift_m1_code_kind(p, run.head(run.spec(run.base, bl, p))) if (st != "A" and run.base) else None
    k = "py" if "py" in (kt, kb) else ("other" if "other" in (kt, kb) else None)
    return (st, p, k, kb == "py", kt == "py") if k else None


def _drift_m1_pair_defs(run, c, tl, bl):
    """改到的一支 Python 檔 → (起點版名稱, 終點版名稱) 或 None(任一版剖不動;記進 unparsable)。任一版太大 → 兩版都用文字抽。
    不是 Python 的那一版(沒副檔名的檔改成別的格式)當沒有定義。"""
    st, p, _k, bpy, tpy = c
    bi = run.blob_info(run.spec(run.base, bl, p)) if bpy else _DRIFT_M1_EMPTY_INFO
    ti = run.blob_info(run.spec(run.tip, tl, p)) if (tpy and st != "D") else _DRIFT_M1_EMPTY_INFO
    if "bad" in (bi[0], ti[0]):
        run.res["unparsable"].append(p)
        return None
    if "big" in (bi[0], ti[0]):
        run.res["text_defs"].append(p)
        return set(bi[2]), set(ti[2])
    return set().union(*bi[1]), set().union(*ti[1])


def _drift_m1_rough(run, coded, tl, bl, tip_all):
    """粗候選(過形狀過濾):定義名與旗標 = 起點那版有、終點那版沒有;路徑 = 被刪的程式檔舊路徑,檔名在終點任何位置都沒有
    同名檔才算。回 ({定義名: 起點路徑集合}, {路徑名: 起點路徑集合})。"""
    defs, paths = {}, {}
    for c in coded:
        if c[2] == "py" and c[0] != "A":
            got = _drift_m1_pair_defs(run, c, tl, bl)
            p = c[1]
            for n in (got[0] - got[1]) if got else ():
                defs.setdefault(n, set()).add(p)
    bases = {x.rsplit("/", 1)[-1] for x in tip_all}
    for st, p, *_x in coded:
        if st == "D":
            paths.setdefault(p, set()).add(p)
            if p.rsplit("/", 1)[-1] not in bases:
                paths.setdefault(p.rsplit("/", 1)[-1], set()).add(p)
    keep = _drift_m1_shape_ok
    return {n: o for n, o in defs.items() if keep(n)}, {n: o for n, o in paths.items() if keep(n)}


def _drift_m1_corpus(run, tf, tl):
    """終點語料(照範圍判定的所有 Python 檔,含測試檔)的定義與旗標聯集。.py 快取命中不讀;沒命中的與沒副檔名的一次批次讀。
    剖不動或太大的檔用文字抽定義(含引號裡的 --旗標)補進聯集(刻意差異第 2、3 條)。"""
    cand = [p for p in sorted(tf) if _drift_m1_code_path(p) and (p.endswith(".py") or _nodehome_code_kind(p) == "shebang?")]
    run.read([run.spec(run.tip, tl, p) for p in cand if not (p.endswith(".py") and run.cached(run.spec(run.tip, tl, p)))])
    alive = set()
    for p in cand:
        s = run.spec(run.tip, tl, p)
        if not p.endswith(".py") and _drift_m1_code_kind(p, run.head(s)) != "py":
            continue
        kind, sets, _tdefs, loose = run.blob_info(s)
        if kind == "ast":
            alive.update(*sets)
        else:
            alive.update(loose)
            if p not in run.res["text_defs"]:
                run.res["text_defs"].append(p)
    return alive


def _drift_m1_homes(run, envs, coded):
    """家(照參考實作 homes_any):起點樹或終點樹任一邊的 about_code 列了這次改到的任何一支程式檔的筆記。"""
    paths = {c[1] for c in coded}
    out = set()
    for env in envs:
        for rel, n in env.notes.items():
            t = None if _note_unreadable(n) else env_text(env, rel)
            if t and paths & set(_drift_m1_about(t)):
                out.add(rel)
    return out


def _drift_m1_envs(run, touched):
    """終點與起點的圖譜(各讀一次)。範圍改到的筆記讀不出記 bad_touched,沒改到的記 bad_notes。"""
    import time as _t
    real = _t.monotonic() + max(0.0, run.deadline - run.now())
    envs = []
    for where in (run.tip, run.base):
        run.check_time()
        env = _drift_tree_env(run.root, where, run.vault_rel, deadline=real)
        if env is None:
            run.fail()
        envs.append(env)
    bad = [r for r, n in envs[0].notes.items() if _note_unreadable(n)]
    run.res["bad_touched"] = sum(1 for r in bad if r in touched)
    run.res["bad_notes"] = len(bad) - run.res["bad_touched"]
    return envs


def _drift_m1_line_hits(idx, ln, tick=None):
    """一行提到的消失名稱(排序;名稱所在那一句有歷史字眼的不算)。"""
    cands = _drift_m1_line_names(idx, ln, tick)
    rx = _drift_m1_name_rx(cands) if cands else None
    if rx is None:
        return []
    cl = _DriftM1Clauses(ln)
    return sorted({m.group(0) for m in rx.finditer(ln) if not cl.hist(m.start())})


def _drift_m1_scan_note(run, rel, text, idx, gone, homes):
    """掃一篇筆記:正文、摘要、決策欄的可見行,撤除節不看,名稱所在那一句有歷史字眼的不算提到;一行一筆。
    每一行之前看截止時間;超過 _DRIFT_M1_LINE_MAX 字的行不掃、記 long_lines。"""
    lines = text.split("\n")
    try:
        regs = _notelines_regions(text)
    except Exception:     # 照參考實作:區塊判不出就整篇當正文
        regs = ["body"] * len(lines)
    vis = {i for i, _ln in _visible_lines(lines)}
    ret = _drift_m1_retired(lines, regs, vis)
    for i, ln in enumerate(lines):
        run.check_time()
        if regs[i] not in _DRIFT_M1_NOTE_REGIONS or (i + 1) not in vis or ret[i + 1]:
            continue
        if len(ln) > _DRIFT_M1_LINE_MAX:
            run.res["long_lines"] += 1
            continue
        toks = _drift_m1_line_hits(idx, ln, run.check_time)
        if not toks:
            continue
        layer = "handle" if (regs[i] == "summary" or rel in homes) else "list"
        why = "消失的名稱:" + "、".join(f"`{t}`(原本在 {'、'.join(sorted(gone[t]))})" for t in toks)
        run.res[layer if layer == "handle" else "listed"].append(
            {"kind": "m1", "path": rel, "line": i + 1, "text": ln.strip(), "why": why, "names": toks, "layer": layer})


def _drift_m1_judge(run, coded):
    """有起點時的判定:粗候選 → (有定義名粗候選才)終點語料 → 候選名稱 → 讀筆記 → 掃。"""
    tf, tall, tl = run.listing(run.tip)
    _bf, _ball, bl = run.listing(run.base)
    defs, paths = _drift_m1_rough(run, coded, tl, bl, tall)
    alive = _drift_m1_corpus(run, tf, tl) if defs else set()
    gone = {n: set(o) for n, o in defs.items() if n not in alive}
    for n, o in paths.items():
        gone.setdefault(n, set()).update(o)
    run.res["candidates"] = len(gone)
    run.res["gone"] = {n: sorted(o) for n, o in gone.items()}
    names = {n: o for n, o in gone.items() if _drift_m1_name_canon(n) is not None}
    run.res["too_long"] = len(gone) - len(names)
    if not names:
        return
    pre = run.vault_rel.rstrip("/") + "/"
    envs = _drift_m1_envs(run, {p[len(pre):] for _st, p in run.changes if p.startswith(pre)})
    homes = _drift_m1_homes(run, envs, coded)
    texts = {r: env_text(envs[0], r) for r, n in envs[0].notes.items() if not _note_unreadable(n)}
    idx = _drift_m1_name_index(_drift_m1_prefilter(names, [t for t in texts.values() if t], run.check_time), run.check_time)
    for rel in sorted(texts):
        run.check_time()
        if texts[rel]:
            _drift_m1_scan_note(run, rel, texts[rel], idx, names, homes)
    if run.res["bad_touched"]:
        run.res["state"] = "unreadable"


def _drift_old_sentence_check(root, base, tip, vault_rel, deadline, now=time.monotonic):
    """舊句檢查的判定本體(Projects/舊句檢查_計劃〈做法〉1 到 3)→ dict:handle、listed(發現)、state(done / timeout /
    git-failed / unreadable / no-base;範圍裡沒有改到程式檔是 None = 不印不記)、unparsable、text_defs(路徑)、
    bad_notes、bad_touched、code_files、other_files、candidates(還沒算出來是 None)、too_long、parsed、cache_hits、
    gone({候選名稱: 起點路徑清單},含太長沒列的)。
    不印、不寫帳。base 是 None = 空樹起點;是 tuple = 推送起點算不出來(列不出改到哪些檔,記 git-failed)。
    now 預設 time.monotonic(測試換掉它來造「掃到一半時間到」);截止時間 deadline 用同一個時鐘。"""
    run = _DriftM1Run(root, base, tip, vault_rel, deadline, now)
    try:
        if isinstance(base, tuple):
            raise _DriftM1Stop("git-failed")
        run.cache = _drift_m1_cache_dir()

