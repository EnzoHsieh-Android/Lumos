def _drift_c4_evidence(cx):
    """c4 的證據與範本:那篇第一次被提交的提交、卷證目錄(同提交與計劃名比對兩種來源都列、標來源)、範本句。
    ★範本句的卷證一律是佔位字 <卷證>★(漂移修法補強 第 1 節;設計審 r2 後拿掉自動填):由人從清單挑,
    整句照貼進 lumos set 會被第 2 節擋下。"""
    root = cx["root"]
    shallow = _git_is_shallow(root)
    sha = None if shallow else _plan_first_commit(root, cx["repo_rel"], timeout=20)
    first = "shallow,查不到最早提交" if shallow else (sha or "查不到")
    rows, same = _drift_c4_dirs(cx, sha)
    tpl = f"提交 {sha[:12] if sha else _SET_COND_SLOTS[2]};代碼審見 {_SET_COND_SLOTS[1]}"
    return {"first": first, "reports": rows, "same": same, "template": tpl}


def _drift_c4_show_name(d):
    """卷證目錄名拿來印:非 UTF-8 位元組換替代字元(_nodehome_show),Unicode 格式字元(類別 Cf:方向控制、零寬)換成看得見的
    \\uXXXX——整批匯入的目錄名帶 RLO 會讓終端上看到的順序跟實際字串不同(代碼審第二輪資安席)。只在這一處,不改共用的 _esc_clean。"""
    import unicodedata
    return "".join((f"\\u{ord(c):04x}" if ord(c) <= 0xFFFF else f"\\U{ord(c):08x}") if unicodedata.category(c) == "Cf" else c
                   for c in _nodehome_show(d))


def _drift_c4_print_dirs(ev):
    print("  ②卷證目錄(從這裡挑一個填進範本的 <卷證>;兩者=同提交也對得上計劃名,同提交=這篇第一次提交時一起加進來的,"
          "計劃名=用計劃名比對猜的,可能漏或多):")
    if ev["same"] is None:
        print("    同提交:查不到(git 失敗或沒有)")
    elif len(ev["same"]) > 3:
        print("    可能含別的計劃的卷證(整批匯入或壓成一個的提交)")
    # 全部列出、不設上限(代碼審第三輪撤回第一輪加的 20 個上限與補充指令:三輪長出四個新缺陷;長清單罕見,
    # 證據頁是人主動叫出來看的,多幾行不礙事)
    for d, src in ev["reports"]:
        print("    " + _esc_clean(f"governance/review-reports/{_drift_c4_show_name(d)}({src})", 300))
    if not ev["reports"]:
        print("    查不到")


def _drift_c4_print(cx, ev):
    print(f"{_esc_clean(cx['rel'], 200)} 第 {cx['line']} 行(c4 前提寫「還沒提交」)的證據——只列出、不寫檔:")
    print(f"  ①這篇第一次被提交:{ev['first']}")
    if "." in stripped:
        return "ext" if ("." + stripped.rsplit(".", 1)[1]) in _NODEHOME_CODE_EXTS else None
    return "shebang?"


class _NodehomeSide:
    """一邊的快照(提交索引、某個提交、或空的)。files={路徑: 模式} 只收一般檔;all_paths=所有受版控路徑(數裸檔名用);
    notes={圖譜相對路徑: 解析結果} 只收 Systems/*.md;shebang={路徑: 首行是不是 #!}(需要時才讀、兩邊共用);
    share/changed:另一邊的快照與兩邊之間有變動的路徑——沒變動的節點與首行直接用另一邊讀好的,不再讀一次。
    路徑用無損解碼([S31]:跟磁碟枚舉一樣,git 那邊才對得上)。"""
    __slots__ = ("files", "all_paths", "notes", "where", "_reader", "shebang", "share", "changed")


def _nodehome_git(repo_root, *args):
    """跑 git、輸出照位元組回(路徑要無損解碼,不能先被文字模式換成替代字元);跑不起來回 None。"""
    r = _lens_git(repo_root, *args, binary=True)
    if r is None or r.returncode != 0:
        return None
    return r.stdout


def _nodehome_show(path):
    """路徑拿來印的時候用:非 UTF-8 的位元組(無損解碼留下的替身字元)換成替代字元——直接 print 會在嚴格編碼的輸出上當掉。"""
    return os.fsencode(path).decode("utf-8", errors="replace") if isinstance(path, str) else str(path)


def _nodehome_split_z(raw):
    return [os.fsdecode(x) for x in raw.split(b"\0") if x]


def _nodehome_list(repo_root, where, oids=None):
    """where='index' / 提交 sha / None(空)。回 (一般檔 {路徑: 模式}, 所有路徑) 或 None(git 失敗)。
    模式從索引或提交樹讀——連結檔(120000)與子模組(160000)不算一般檔 [S40]。
    oids 給一個 dict 時順便填 {NFC 路徑: 內容編號}(一般檔才填):要讀內容的呼叫端拿編號讀,不必管 git 裡存的檔名寫法。"""
    if where is None:
        return {}, []
    raw = _nodehome_git(repo_root, "ls-files", "-s", "-z") if where == "index" else \
        _nodehome_git(repo_root, "ls-tree", "-r", "-z", "--full-tree", where)
    if raw is None:
        return None
    files, allp = {}, []
    rows = [d for d in _drift_jsonl_rows(Path(root) / _DRIFT_FIXES) if nfc(str(d.get("path", ""))) == nfc(repo_rel)]
    if not rows:
        return None
    return _drift_bound_latest(rows)[-1].get("after_sha256")


def _drift_fix_clean_err(root, repo_rel, raw):
    """乾淨檢查 → 錯誤或 None:那一篇要在 git 裡有追蹤,而且跟 HEAD 沒差,或現在的指紋等於修復帳裡這一篇最後一筆的
    after_sha256(改動全是工具自己留下的,同一篇可以一項一項修、修完一起提交)。"""
    import hashlib
    ps = _git_paths_nfc(root, repo_rel)
    if not ps:
        return f"{repo_rel} 沒被 git 追蹤(或 git 查不到)——不在版控裡,改壞了退不回來;先提交"
    if len(ps) > 1:
        return f"{repo_rel} 這個名字在 git 裡有 {len(ps)} 種 Unicode 拼法的檔並存,工具分不出要改哪一篇;先手動整理成一篇"
    gp = ps[0]
    r = _lens_git(root, "--literal-pathspecs", "diff", "--no-ext-diff", "--no-textconv", "--quiet", "HEAD", "--", gp)   # 檔名裡的 * 不當萬用字元(r4 邊界、外家)
    if r is None or r.returncode not in (0, 1):
        return "git 查詢失敗或逾時(git diff HEAD),查不出這一篇乾不乾淨"
    if r.returncode == 0 or _drift_fix_last_sha(root, repo_rel) == hashlib.sha256(raw).hexdigest():
        return None
    return f"{repo_rel} 有未提交的改動(不是 drift fix 自己留下的)——先提交或還原再修"


def _drift_fix_load(env, rel, line, kind, o):
    """第 1、2 步:乾淨檢查(--dry-run 不做)、讀那一篇(BOM、CRLF 拒絕)、鎖外新建圖譜物件確認那一行現在是這一種發現。"""
    root, vault_rel = _drift_vault_of(env)
    path = _phys_path(env.vault, rel)
    try:
        if path.is_symlink() or path.stat().st_nlink != 1:
            return None, (f"{rel} 是符號連結或還有別的硬連結——工具用換檔的方式寫入,會把連結換成一般檔、或讓兩邊內容分岔"
                          "(代碼審 r1 邊界席);手動改")
        lines, _s, fe = load_raw_for_edit(path)
    except (ValueError, OSError, UnicodeDecodeError) as ex:
        return None, f"{rel} 打不開:{ex}"
    cx = {"root": root, "rel": rel, "repo_rel": f"{vault_rel}/{rel}", "path": path, "lines": lines, "fe": fe,
          "raw": "\n".join(lines).encode("utf-8"), "kind": kind, "line": line, "o": o}
    if not o.get("dry_run") and kind != "c4":    # 只看、不寫的兩條路不做乾淨檢查(c4 只列證據)
        err = _drift_fix_clean_err(root, cx["repo_rel"], cx["raw"])
        if err:
            return None, err
    cx["env2"] = Env(env.vault)
    cx["f"], err = _drift_current_finding(cx["env2"], rel, line, kind)
    return (None, err) if err else (cx, None)


def _drift_fm_status(lines, fe, status):
    """開頭欄位的 status 改掉、同步 status/* 標籤(同 cmd_set)→ (新的開頭欄位行, 寫後自驗)。"""
    fm = edit_fm_scalar(lines[1:fe], "status", status)
    fm, synced = edit_fm_sync_status_tag(fm, status)
    want = strip_quotes(fmt_scalar("status", status))

    def _ok(f):
        if str(f.get("status", "")) != want:
            return False
        tags = [t for t in as_list(f.get("tags")) if isinstance(t, str)]
        return (not synced) or (f"status/{want}" in tags and all(t == f"status/{want}" for t in tags if t.startswith("status/")))
    return fm, _ok


def _drift_deps(cx, rels):
    """判定依賴的其他筆記(c1、c5 的家節點)此刻的位元組 → [(路徑, 位元組)];寫入時在鎖內再比一次,判定之後被改過就不寫
    (代碼審 r1 併發席:鎖內原本只比守衛紀錄那一篇)。建圖譜物件到這裡的時間差不處理(〈誠實界線〉)。"""
    out = []
    for r in rels:
        if not r:
            continue
        p = _phys_path(cx["env2"].vault, r)
        try:
            out.append((p, p.read_bytes()))
        except OSError:
            out.append((p, None))
    return out


def _drift_no_kind(*kinds):
    return lambda fs, _txt: not any(x["kind"] in kinds for x in fs)


def _drift_fix_c1(cx):
    """c1:已 pass 的守衛紀錄補改預告句(改句、前提、日期都在 guard 區段,這裡往下呼叫)。"""

