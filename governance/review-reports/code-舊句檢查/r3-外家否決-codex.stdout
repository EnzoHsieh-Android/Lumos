def _drift_m1_fit(root, kind, note, hard, tip, nodes, extra):
    """整行(照 _ledger_append 的量法,量 _gate_event_build 組出的完整事件)超過 4096 位元組:先從只列出、再從要處理尾端丟 rows;
    丟光還超過 → nodes 截到 20;再超過照寫。有截就記 rows_truncated。"""
    import json as _j

    def size():
        ev = _gate_event_build(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra)
        return len((_j.dumps(ev, ensure_ascii=False) + "\n").encode("utf-8"))
    rows = extra.get("rows")
    while rows and size() > 4096:
        rows.pop()           # rows 是要處理在前、只列出在後,從尾端丟就是先丟只列出
        extra["rows_truncated"] = True
    if len(nodes) > 20 and size() > 4096:
        nodes = nodes[:20]
        extra["rows_truncated"] = True
    return nodes


def _drift_m1_ledger_miss(root, tip, state):
    """治理帳寫不進去時的留痕:~/.cache/lumos/drift-m1/ledger-miss.jsonl 追加一行(REVISIT 讀它算樣本不足)。"""
    import json as _j, datetime as _dt
    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-m1"):
        return False
    d = Path.home() / ".cache" / "lumos" / "drift-m1"
    if not _trusted_private_dir(d, ".cache", "lumos", "drift-m1"):
        return False
    line = _j.dumps({"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                     "repo": _drift_m1_show(os.path.realpath(str(root))), "head_sha": tip, "state": state},
                    ensure_ascii=False) + "\n"
    try:
        # O_NONBLOCK:有人在這裡放了同名 FIFO 時開檔不會卡住推送(沒有讀端就直接失敗);開了再確認是自己的一般檔
        # (代碼審 r2 邊界席)
        fd = os.open(str(d / "ledger-miss.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
                     | getattr(os, "O_NONBLOCK", 0), 0o600)
        try:
            import stat as _stat
            fst = os.fstat(fd)
            if not _stat.S_ISREG(fst.st_mode) or (hasattr(os, "getuid") and fst.st_uid != os.getuid()):
                return False
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)
        return True
    except OSError:
        return False


def _drift_m1_ledger(root, mode, base, tip, res, found, note):
    """記一筆治理帳(gate drift-check;欄位攤平在事件最外層,check=old-sentence)。found=(要處理, 只列出)(扣掉已表態)。"""
    handle, listed = found
    st = res["state"]
    judged = st not in _DRIFT_M1_UNKNOWN
    busy = _drift_m1_busy(res, handle)
    # no-base 記 range-unavailable(既有結果詞,跟綁定測試閘算不出範圍同一個):原本記 skipped,gov --stats 會把它算進
    # 「被跳過」——那一行講的是有人略過閘,這裡是沒起點可比(代碼審 r1 併發回滾席)
    kind = "range-unavailable" if st == "no-base" else ("passed" if not busy else ("blocked" if mode == "block" else "warned"))
    hard = kind == "blocked"
    extra = {"check": "old-sentence", "state": st, "base_sha": base if isinstance(base, str) else "",
             "code_files": res["code_files"], "candidates": res["candidates"],
             "handle": len(handle) if judged else None, "listed": len(listed) if judged else None,
             "unparsable": len(res["unparsable"]), "text_defs": len(res["text_defs"]),
             "text_defs_paths": [_drift_m1_show(x) for x in res["text_defs"][:3]], "too_long": res["too_long"],
             "long_lines": res["long_lines"], "parsed": res["parsed"], "cache_hits": res["cache_hits"], "rows_truncated": False}
    if res.get("error"):
        extra["error"] = _drift_m1_show(res["error"], 200)
    if st == "done":
        extra["rows"] = _drift_m1_rows(handle, 10) + _drift_m1_rows(listed, 3)
    nodes = sorted({_drift_m1_show(f["path"][:-3]) for f in handle})[:50] if judged else []
    nodes = _drift_m1_fit(root, kind, note, hard, tip, nodes, extra)
    if _gate_event_or_warn(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra) is False:
        _drift_m1_ledger_miss(root, tip, st)


def _drift_m1_guarded(root, mode, base, tip, vault_rel):
    """跑 m1 並印出、記帳 → rc_m1。m1 裡任何沒預料到的例外都兜底成「判不了」(state error):warn 印一行、回 0,
    block 照判不了的規矩擋——原本例外一路丟到最外層,warn 模式也整支回 1(代碼審 r1 正確性席)。"""
    try:
        res = _drift_old_sentence_check(root, base, tip, vault_rel, time.monotonic() + _DRIFT_M1_BUDGET_SEC)
        return _drift_m1_report(root, mode, base, tip, vault_rel, res)
    except Exception as ex:
        err = f"{type(ex).__name__}: {ex}"
    try:
        return _drift_m1_report(root, mode, base, tip, vault_rel, _drift_m1_new_res("error", err))
    except Exception:
        print(f"舊句檢查:工具內部出錯({_drift_m1_show(err, 120)}),這次沒判,帳也沒記", file=sys.stderr)
        return 1 if mode == "block" else 0


def _drift_m1_report(root, mode, base, tip, vault_rel, res):
    """m1 的結論行、發現、改法(全部 stderr)與治理帳 → rc_m1(block 而且要處理有筆數或判不了時 1,其他 0)。
    state 是 None(範圍裡沒有改到程式檔)不印不記。"""
    st = res["state"]
    if st is None:
        return 0
    handle, listed = res["handle"], res["listed"]
                return False
    return True


def _chmod_no_follow(d, mode):
    """改一個★目錄★的權限,而且不准跟著符號連結走。成功回 True。

    ★為什麼不直接 os.chmod★(2026-09-16 代碼審 資安席):`os.chmod` 會跟著連結走。
    武裝目錄那處父層已經逐層驗過了,★但葉節點那一層還是「先建、先改權限、才驗」★——
    葉節點在檢查之後被換成指向別人目錄的連結時,權限就改到別人的目錄上;
    最後那道驗證雖然擋得下寫入,但權限已經動過、回不去了。

    做法是用 O_NOFOLLOW|O_DIRECTORY 開它再 fchmod:不是目錄、或是連結,開的時候就失敗。
    ★這是這份工具裡第一處真的用 dirfd 關掉競速窗口的地方★——其餘幾處仍是路徑層檢查,
    仍然擋不住同帳號搶跑(那條誠實邊界照舊成立,不要因為這裡做了就以為全都做了)。
    """
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_DIRECTORY", 0)
    try:
        fd = os.open(str(d), flags)
    except OSError:
        return False
    try:
        os.fchmod(fd, mode)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def _lens_arm_dir_ok(d):
    """armed 目錄安全檢查——走共用的 _trusted_private_dir。

    ★預期路徑怎麼算★:armed 目錄底下多一層 repo 指紋。這裡把「家目錄以下的每一層」用字面段
    交出去(不是交一個組好的路徑),所以前綴那幾層被換成 symlink 一樣擋得下來——
    交組好的路徑會讓兩邊一起解析而自我抵銷,那是第一版的錯法。
    指紋那層是我們自己算出來的、不是外來輸入,所以直接用 d 的名字。"""
    return _trusted_private_dir(d, ".cache", "lumos", "dispatch-lens", "armed", Path(d).name)


def cmd_dispatch_lens_arm(diff_range, repo=None, seats=1, no_cache=False):
    """算好鏡頭文字,武裝 N 席。"""
    import json as _json, io, contextlib, shutil, time as _time
    root = _lens_repo_root(repo)
    if root is None:
        print(f"擋下:{repo or Path.cwd()} 不在 git 專案裡", file=sys.stderr)
        return 2
    try:
        seats = int(seats)
    except (TypeError, ValueError):
        seats = 0
    if seats < 1 or seats > 50:
        print("擋下:--seats 要 1–50(一次代碼審派幾席就給幾;多給的當緩衝)", file=sys.stderr)
        return 2
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        rc = cmd_dispatch_lens(diff_range, repo=str(root), as_json=True, no_cache=no_cache)
    if rc != 0:
        return rc
    try:
        data = _json.loads(buf.getvalue().strip().splitlines()[-1])
    except (ValueError, IndexError):
        print("擋下:鏡頭回傳讀不懂", file=sys.stderr)
        return 2
    text = data.get("text") or ""
    d = _lens_armed_root() / _lens_repo_key(root)
    # ★寫入端也要先驗,而且要在 rmtree 之前★(2026-09-06 全 repo 審視 #6):
    # 原本是「存在就 rmtree、然後 mkdir、然後 chmod」,中間一次檢查都沒有——目錄被換成
    # 指向別處的 symlink 時,這三步會照著**刪掉別人的東西**再把權限改掉。
    # 讀取端早就有檢查了,寫入端沒有,這是最危險的那一半。
    if d.exists() or d.is_symlink():
        if not _lens_arm_dir_ok(d):
            print(f"擋下:武裝目錄 {d} 不是自己的、或路徑上有 symlink 指到別處——不碰它。"
                  f"\n  這是安全檢查:那個位置本來該是這套工具自己建的私有目錄。"
                  f"\n  真的是你自己的東西壞掉了,手動刪掉它再跑一次:"
                  f"\n      rm -rf {d}", file=sys.stderr)
            return 2
        shutil.rmtree(d, ignore_errors=True)
    # ★逐層建、逐層檢查★(2026-09-16):目錄不存在時原本一次 mkdir 出整條路徑,
    # 上層被換成指向別處的連結時,別人的目錄裡就會多出一層空資料夾。
    if not _mkdir_trusted_under_home(".cache", "lumos", "dispatch-lens", "armed"):
        print(f"擋下:放武裝目錄的那條路徑不可信({d.parent})——它自己或上層被換成了"
              "指向別處的連結、或別人也寫得進去,不在那裡建東西。", file=sys.stderr)
        print("  檢查一下那條路徑是誰建的:", file=sys.stderr)
        print(f"    ls -ld {d.parent} {d.parent.parent}", file=sys.stderr)
        return 2
    d.mkdir(parents=True, exist_ok=True)
    if not _chmod_no_follow(d, 0o700):
        print(f"擋下:武裝目錄 {d} 不是一個真的目錄(可能被換成指向別處的連結)——不碰它。",
              file=sys.stderr)
        print("  為什麼在意:改權限會跟著連結走,那等於去動別人的目錄。", file=sys.stderr)
        print("  確定是你自己的東西壞掉了,手動刪掉再跑一次:", file=sys.stderr)
        print(f"    rm -rf {d}", file=sys.stderr)
        return 2
    # 建完再驗一次。★不宣稱「換掉也擋得住」★(外家席 r1 抓到那句是假的):
    # 這是路徑層檢查,同帳號的搶跑擋不住;再驗一次只是把窗口縮小,不是關掉。
    if not _lens_arm_dir_ok(d):
        print(f"擋下:武裝目錄 {d} 建完之後檢查沒過,不寫", file=sys.stderr)
        return 2
    meta = {"range": diff_range, "base": data.get("base"), "head": data.get("head"), "repo": str(root),
            "ts": _time.time(), "seats": seats, "text": text, "pinned": data.get("pinned"), "listed": data.get("listed"),
            "fallback_status": data.get("fallback_status")}
    (d / "meta.json").write_text(_json.dumps(meta, ensure_ascii=False), encoding="utf-8")
    for i in range(1, seats + 1):
        (d / f"tok-{i:02d}").write_text("", encoding="utf-8")
    print(f"✓ 已武裝派工鏡頭:{diff_range} 共 {seats} 席,{_LENS_ARM_TTL_SEC // 60} 分內 Codex 子代理開場各領一席"
          f"(固定席 {data.get('pinned')} 篇、列出 {data.get('listed')} 篇;0 篇時附既有相依備援段)")
    print("  派完(或不派了)收掉:\n    lumos dispatch-lens --disarm")
    return 0


def cmd_dispatch_lens_claim(repo=None, as_json=False):
    """SubagentStart hook 叫:先驗 TTL,再原子認領一席。回 JSON {text|null, reason, seat, seats, range}。"""
    import json as _json, shutil, time as _time
    root = _lens_repo_root(repo)
    out = {"text": None, "reason": "not-armed", "seat": None, "seats": None, "range": None}
