def _esc_clean(v, limit=200):
    """逃逸帳顯示消毒(code-escape r1 B-1/B-2):控制字元(含換行/ESC)換空格——
    --list 的「一行一筆」是攔截/逃逸週報 grep 的載重合約,使用者可控的 desc 不得打穿;
    ANSI 逃逸碼進終端=帳本可信度風險。截斷防超長刷版。"""
    out = "".join(ch if ch >= " " and not ("\x7f" <= ch <= "\x9f") else " " for ch in str(v))   # 含 8 位元 C1 控制碼(r2 資安席)
    return out if len(out) <= limit else out[:limit] + "…"



def _git_head(repo_root):
    try:
        r = subprocess.run(["git", "-C", str(repo_root), "rev-parse", "HEAD"], capture_output=True, text=True, errors="replace")
        return r.stdout.strip() if r.returncode == 0 else ""
    except OSError:
        return ""


def _plans_in_range(repo_root, git_range, vault):
    """提交範圍碰到的計劃筆記(repo 相對路徑)。對回啟發式:碰到 Projects/*.md 就算。"""
    try:
        # ★中文檔名:git 預設把非 ASCII 路徑加引號並轉義,不關掉會一個計劃都對不上(taskbank 同型坑 2026-09-15)★
        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return []
    if r.returncode != 0:
        return []
    try:
    if rg is None:
        print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有", file=sys.stderr)
        return None, 2, None
    sh = _lens_git(root, "rev-parse", "--is-shallow-repository")
    if sh is not None and sh.stdout.strip() == "true":
        print(f"{gate_word}:淺層 clone 算不出範圍,這次不查——CI 請設 fetch-depth: 0", file=sys.stderr)
        _gate_event_or_warn(root, gate, "skipped-env", "shallow clone")
        return None, 0, None
    a, b = rg
    if _ZERO_SHA_RE.fullmatch(b):
        print(f"{gate_word}:範圍終點是全 0(刪除分支),沒有要審的東西", file=sys.stderr)
        return None, 0, None
    tip = _lens_full_sha(root, b)
    if tip is None:
        # 推送前的終點是本機要推的提交、CI 的是剛 checkout 的那個,都一定找得到;找不到就是範圍寫錯,
        # 放行等於整道檢查沒跑(代碼審 r1 外家席),所以當參數錯
        print(f"擋下:範圍 {diff_range} 的終點在本機找不到——範圍寫錯了?", file=sys.stderr)
        return None, 2, None
    base, why = _note_audit_start(root, a, tip, push)
    if why:
        print(f"{gate_word}:{why}", file=sys.stderr)
    if base is None:
        _gate_event_or_warn(root, gate, "skipped", why)
        return None, 0, None
    if base == _PUSH_START_UNKNOWN:
        # 起點算不出來(git 查詢失敗):不截上線點、不查;回 (判不了, 說明) 給呼叫端照「判不了」處理(推送閘接漂移檢查代碼審 r3)
        base = (_PUSH_START_UNKNOWN, why)
    else:
        base = _nodehome_clamp_base(root, base, tip, mark or _NOTE_AUDIT_GOLIVE_MARK, _NOTELINES_PREPUSH)
    lst = _nodehome_list(root, tip)
    if lst is None:
        return None, 0, None
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    if not vaults:
        print(f"{gate_word}:這個專案沒有圖譜,跳過")
        return None, 0, None
    wv = _vault_in(root)
    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
    vault_rel = wv_rel if (wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults) else "docs/" + vaults[0]
    return (None if base == _EMPTY_TREE_SHA else base), tip, vault_rel


def _note_audit_start(root, a, tip, push):
    """起點:push=(遠端名, 遠端 ref) 走 _push_range_start(說明前面加「起點——」),沒有走共用的 _lens_push_base。"""
    if push is None:
        return _lens_push_base(root, a, tip)
    base, why = _push_range_start(root, a, tip, push[0], push[1])
    return base, f"起點——{why}"


def _note_audit_root(repo):
    if repo:
        return Path(repo).resolve()
    r = _lens_git(".", "rev-parse", "--show-toplevel")
    return Path(r.stdout.strip()) if (r is not None and r.returncode == 0) else None


def _note_audit_prompt(root):
    """派工詞:範本檔三類定義與七句,專案路徑與技術棧換成被審 repo 的(計劃 S13)。"""
    here = Path(__file__).resolve().parent.parent
    tpl = None
    for cand in (Path(root) / _NOTE_AUDIT_TEMPLATE, here / _NOTE_AUDIT_TEMPLATE):
        if cand.is_file():
            tpl = cand.read_text(encoding="utf-8")
            break
    if tpl is None:
        return None
    # 檔頭授權標示與給維護者看的註解不進派工詞
    tpl = "".join(ln for ln in tpl.splitlines(keepends=True) if not ln.startswith("# SPDX-"))
    if tpl.lstrip().startswith("<!--") and "-->" in tpl:
        tpl = tpl.split("-->", 1)[1].lstrip("\n")
    try:
        cnt = sorted(_stack_ext_counts(Path(root)).items(), key=lambda kv: -kv[1])[:5]
        stacks = "主要程式檔副檔名:" + (", ".join(f"{e}×{n}" for e, n in cnt) if cnt else "未偵測到")
    except OSError:
        stacks = "主要程式檔副檔名:未偵測到"
    return (tpl.replace("{{REPO_PATH}}", str(Path(root).resolve())).replace("{{STACK}}", stacks)
               .replace("{{PROMPT_VERSION}}", str(_NOTE_AUDIT_PROMPT_VERSION)))


def _note_audit_batches(pending):
    """待審超過 150 行就切:先照筆記分組、同篇同份;單篇超過時在小標題邊界切;單一小標題下還超過就照行數硬切。"""
    groups = []
    for p in sorted({it["path"] for it in pending}):
        rows = [it for it in pending if it["path"] == p]
        if len(rows) <= _NOTE_AUDIT_BATCH:
            groups.append(rows)
            continue
        units, seen = [], {}
        for it in rows:                         # 同一編號的幾處(同篇、同小標題)當成一個單位,不拆到兩份清單
            if it["id"] in seen:
                seen[it["id"]].append(it)
            else:
                seen[it["id"]] = [it]
                units.append(seen[it["id"]])
        # 單一編號就超過一份的上限:只列前 150 處(上限不破);清單少了幾處,輕的判定就收不下——
        # 那麼多處一字不差的行本來就該改寫(代碼審 r2 外家席)
        units = [u[:_NOTE_AUDIT_BATCH] for u in units]
        cur, cur_head = [], None
        for u in units:
            it = u[0]

