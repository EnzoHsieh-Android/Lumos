 29228	def _drift_m1_ledger(root, mode, base, tip, res, found, note):
 29229	    """記一筆治理帳(gate drift-check;欄位攤平在事件最外層,check=old-sentence)。found=(要處理, 只列出)(扣掉已表態)。"""
 29230	    handle, listed = found
 29231	    st = res["state"]
 29232	    judged = st not in _DRIFT_M1_UNKNOWN
 29233	    busy = bool(handle) or not judged
 29234	    kind = "skipped" if st == "no-base" else ("passed" if not busy else ("blocked" if mode == "block" else "warned"))
 29235	    hard = kind == "blocked"
 29236	    extra = {"check": "old-sentence", "state": st, "base_sha": base if isinstance(base, str) else "",
 29237	             "code_files": res["code_files"], "candidates": res["candidates"],
 29238	             "handle": len(handle) if judged else None, "listed": len(listed) if judged else None,
 29239	             "unparsable": len(res["unparsable"]), "text_defs": len(res["text_defs"]),
 29240	             "text_defs_paths": res["text_defs"][:3], "too_long": res["too_long"], "parsed": res["parsed"],
 29241	             "cache_hits": res["cache_hits"], "rows_truncated": False}
 29242	    if st == "done":
 29243	        extra["rows"] = _drift_m1_rows(handle, 10) + _drift_m1_rows(listed, 3)
 29244	    nodes = sorted({_esc_clean(f["path"][:-3], 10 ** 6) for f in handle})[:50] if judged else []
 29245	    nodes = _drift_m1_fit(root, kind, note, hard, tip, nodes, extra)
 29246	    if _gate_event_or_warn(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra) is False:
 29247	        _drift_m1_ledger_miss(root, tip, st)
