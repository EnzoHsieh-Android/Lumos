  1147	def _gate_event_build(repo_root, gate, kind, note, *, hard=False, head_sha=None,
  1148	                      ref=None, nodes=None, extra=None):
  1149	    """_gate_event 要寫的那一筆事件(不寫檔)。舊句檢查先用它組好、照 _ledger_append 的量法量長度再交給 _gate_event 寫
  1150	    (Projects/舊句檢查_計劃〈做法〉3);欄位與 _gate_event 自己組的逐字相同。"""
  1151	    import datetime as _dt
  1152	    ev = {
  1153	        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
  1154	        "commit": (head_sha or "")[:7],
  1155	        "gate": gate, "kind": kind, "hard": bool(hard),
  1156	        "nodes": list(nodes or []), "note": note,
  1157	        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
  1158	        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
  1159	        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
  1160	        "detail": note,
  1161	    }
  1162	    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
  1163	    if att:
  1164	        ev["attempt_id"] = att[:64]
  1165	    if ref:
  1166	        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
