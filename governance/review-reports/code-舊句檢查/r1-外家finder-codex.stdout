 25268	            for p, blob in zip(notes_, blobs):
 25269	                if blob is None:
 25270	                    continue
 25271	                text = blob.decode("utf-8-sig", errors="replace")
 25272	                if not any(x in text for x in keys):
 25273	                    continue
 25274	                old, regs_, regen_ = None, _notelines_regions(text), _ns_is_regen(text)
 25275	                for n, ln in enumerate(text.split("\n"), 1):
 25276	                    if (p, n) in seen or regs_[n - 1] == "other" or not any(x in ln for x in keys):
 25277	                        continue
 25278	                    if old is None:
 25279	                        ob = gl_reader(p)
 25280	                        old = {x.strip() for x in ob.decode("utf-8-sig", errors="replace").split("\n")} if ob is not None else set()
 25281	                    if ln.strip() in old or ln.strip() in old_by.get(nfc(p), ()):
 25282	                        continue
 25283	                    # 跟新增行走同一支逐行檢查(區塊、regen 的 [src:] 豁免、釘版本、單一檔名都一致;代碼審 r3 兩席:
 25284	                    # 原本另抽一次,漏了 [src:] 豁免、也把釘版本整批丟掉),只留指向這次變成程式檔的那幾條
 25285	                    for rule, frag, fix in _ns_check_line(repo_root, ln, regs_[n - 1], files, reader, top_dirs, by_name, regen_):
 25286	                        # 只認指向新程式檔本身的片段:`路徑:`、`路徑@`、單一檔名的 (= 路徑)——不吃前綴(驗收輪通才席:
 25287	                        # 新增 scripts/run 會把指向 scripts/run.py 的舊行當成喚醒)
 25288	                        if rule == "現況描述沒寫來源" or not any(frag.startswith((f"`{x}:", f"`{x}@")) or f"(= {x})" in frag
 25289	                                                             for x in became):
 25290	                            continue
 25291	                        viol.append((p, n, rule + "(新程式檔喚醒)", frag,
 25292	                                     "這支檔這次才變成程式檔,舊筆記裡指向它的行號也會錯位:" + fix))
 25293	    return viol, errs
