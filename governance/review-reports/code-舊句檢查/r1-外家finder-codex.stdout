 26999	def _drift_cond_split(v):
 27000	    """symbol/test 條件的值 → (路徑或空字串, 名稱)。判定、預讀、候選篩選、判不了的點名共用這一支
 27001	    (代碼審 r5 架構對齊席:原本四處各自 rsplit,點名的範圍跟判定的範圍連三輪對不上)。"""
 27002	    path, name = (v.rsplit("::", 1) if "::" in v else ("", v))
 27003	    return path.strip(), name.strip()
