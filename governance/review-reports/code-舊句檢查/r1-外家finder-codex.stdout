+
+def _drift_m1_pyver():
+    """定義快取鍵裡的 Python 主次版本(測試換掉它來造「版本不同」)。"""
+    return tuple(sys.version_info[:2])
+
+
+def _drift_m1_code_path(p):
+    """True = 不在排除清單內、可能是程式檔(對不是 .md 的路徑,等於參考實作的 not _excluded(p);t_drift_m1_code_path_scope 逐一釘)。
+    排除:docs/、governance/ 開頭;開頭或任何 / 之後的建置目錄;lock 檔;.md。"""
+    return not (p.startswith(_DELGUARD_PROSE_DIRS) or p.endswith(".md") or p.endswith(_DELGUARD_EXCLUDE_LOCKFILES)
+                or any(p.startswith(s) or ("/" + s) in p for s in _DELGUARD_EXCLUDE_DIRS))
+
+
+def _drift_m1_code_kind(p, first_line):
+    """'py' | 'other' | None。Python = _drift_probe_is_py;其他程式檔 = 副檔名在 _NODEHOME_CODE_EXTS(大小寫敏感)或
+    沒副檔名、首行是 #!(刻意差異第 1 條:不另抄參考實作的 TEXT_EXTS)。"""
+    if not _drift_m1_code_path(p):
+        return None
+    if _drift_probe_is_py(p, first_line or ""):
+        return "py"
+    ck = _nodehome_code_kind(p)
+    return "other" if ck == "ext" or (ck == "shebang?" and (first_line or "").startswith("#!")) else None
+
+
+def _drift_m1_text_defs(txt, loose=False):
+    """剖不動或太大的檔:一條正則掃一次抽定義名與 add_argument 的引號旗標。loose=True(終點語料用)另收引號裡的 --旗標 字樣。
+    認不到拆包、縮排的類別層指派、沒給值的型別標註;三引號字串裡行首的 def 會被當定義(〈誠實界線〉)。"""
+    out = {m.group(1) or m.group(2) for m in _DRIFT_M1_TEXT_DEF_RE.finditer(txt)}
+    out.update(m.group(2) for m in _DRIFT_M1_TEXT_FLAG_RE.finditer(txt))
+    if loose:
+        out.update(m.group(2) for m in _DRIFT_M1_QUOTED_FLAG_RE.finditer(txt))
+    return out
+
+
+def _drift_m1_shape_ok(name):
+    """形狀過濾(逐字照參考實作 _shape_ok):旗標、路徑、.py 直接過;其他要 4 字以上,含底線或同時有大寫與小寫。"""
+    if name.startswith("--") or "/" in name or name.endswith(".py"):
+        return True
+    return len(name) >= 4 and ("_" in name or (any(c.isupper() for c in name) and any(c.islower() for c in name)))
+
+
+def _drift_m1_name_ok(name):
+    """名稱去頭尾空白後 1 到 200 字、不帶控制字元才列(表態 --name 收得下;刻意差異第 10 條)。"""
+    s = name.strip()
+    return 1 <= len(s) <= _DRIFT_M1_NAME_MAX and _esc_clean(name, 10 ** 6) == name
+
+
+def _drift_m1_banner(line):
+    """撤除行:去掉開頭空白後第一個字是 > ( (,含撤除字樣、不命中「尚未/還沒/未 + 撤除字樣」(照參考實作 _is_banner)。"""
+    s = line.strip()
+    if not s or s[0] not in ">(（" or _DRIFT_M1_NOT_YET_RE.search(s):
+        return False
+    return any(w in s for w in _DRIFT_M1_RETIRE_WORDS)
+
+
+def _drift_m1_retire_heads(lines, regs, vis):
+    """撤除節①:任何層級小標題後第一個非空行是撤除行 → 整節連同子節不看(照參考實作 Note.ret_full)。"""
+    n = len(lines)
+    full, stack = [False] * (n + 1), []
+    for i, ln in enumerate(lines):
+        m = _DRIFT_M1_HEAD_RE.match(ln) if regs[i] == "body" and (i + 1) in vis else None
+        if m:
+            lvl = len(m.group(1))
+            while stack and stack[-1][0] >= lvl:
+                stack.pop()
+            j = i + 1
+            while j < n and not lines[j].strip():
+                j += 1
+            stack.append((lvl, _drift_m1_banner(lines[j] if j < n else "")))
+        if regs[i] == "body":
+            full[i + 1] = any(s[1] for s in stack)
+    return full
+
+
+def _drift_m1_retired(lines, regs, vis):
+    """每一行(行號 1 起)在不在撤除節裡:①節開頭撤除行;②節內 > 開頭、同一行含撤除字樣與範圍宣告字的撤除行,
+    從那一行到節尾(下一個同層或更高層標題之前,含子節)。照參考實作 P4r3 的 ret_full3。"""
+    out = _drift_m1_retire_heads(lines, regs, vis)
+    lvl_now, marks = 0, []
+    for i, ln in enumerate(lines):
+        if regs[i] != "body" or (i + 1) not in vis:
+            continue
+        m = _DRIFT_M1_HEAD_RE.match(ln)
+        if m:
+            lvl_now = len(m.group(1))
+            marks = [(a, lv) for a, lv in marks if lv < lvl_now]
+            continue
+        if ln.lstrip().startswith(">") and _drift_m1_banner(ln) and any(w in ln for w in _DRIFT_M1_SCOPE_WORDS):
+            marks.append((i + 1, lvl_now))
+        if marks:
+            out[i + 1] = True
+    return out
+
+
+def _drift_m1_paren_span(line, pos):
+    """包住 pos 的最內層那對括號 (起, 迄);沒有括號包住、但最後一個沒關上的 ( 在 pos 前面 → (那個位置, 行尾);否則 None。"""
+    opened, span = [], None
+    for i, ch in enumerate(line):
+        if ch in "(（":
+            opened.append(i)
+        elif ch in ")）" and opened:
+            a = opened.pop()
+            if a < pos < i and (span is None or a > span[0]):
+                span = (a, i)
+    if span is None and opened and opened[-1] < pos:
+        span = (opened[-1], len(line))
+    return span
+
+
+def _drift_m1_clause_hist(line, pos):
+    """名稱所在那一句有沒有歷史字眼(逐字照參考實作 _clause_has_hist):括號內只看括號內;括號外先把「裡面沒有括號的
+    括號對」整對遮掉;再用 。;;!?!? 切,取名稱所在那一小段(英文句點不切)。"""
+    span = _drift_m1_paren_span(line, pos)
+    if span is not None:
+        seg, rel = line[span[0] + 1:span[1]], pos - span[0] - 1
+    else:
+        seg, rel = re.sub(r"[(（][^()（）]*[)）]", lambda m: "\0" * len(m.group(0)), line), pos
+    cuts = [m.end() for m in _DRIFT_M1_CUT_RE.finditer(seg) if m.end() <= rel]
+    m2 = _DRIFT_M1_CUT_RE.search(seg[rel:])
+    clause = seg[(cuts[-1] if cuts else 0):(rel + m2.start() if m2 else len(seg))]
+    return bool(_DRIFT_M1_HIST_RX.search(clause))
+
+
+def _drift_m1_name_rx(names):
+    """整字比對的一條正則(逐字照參考實作 _mk_rx):一般識別字前後不能緊接 ASCII 英數底線;旗標、路徑、帶 . 的前面不能緊接
+    ASCII 英數、底線、/ . -,後面不能緊接 ASCII 英數、底線、-。一般識別字那組在前、組內長的在前。"""
+    ids = sorted((n for n in names if not n.startswith("--") and "/" not in n and "." not in n), key=len, reverse=True)
+    idset = set(ids)
+    others = sorted((n for n in names if n not in idset), key=len, reverse=True)
+    parts = []
+    if ids:
+        parts.append(r"(?<![A-Za-z0-9_])(?:" + "|".join(map(re.escape, ids)) + r")(?![A-Za-z0-9_])")
+    if others:
+        parts.append(r"(?<![A-Za-z0-9_/.-])(?:" + "|".join(map(re.escape, others)) + r")(?![A-Za-z0-9_-])")
+    return re.compile("|".join(parts)) if parts else None
+
+
+def _drift_m1_prefilter(names, texts):
+    """名稱先篩(候選超過 _DRIFT_M1_PREFILTER_MIN 個才做):名稱每一段 ASCII 詞都在圖譜全文的 ASCII 詞集合裡才留下,
+    沒有 ASCII 段的一律留下。整字正則命中處的每一段一定是完整的 ASCII 詞,所以篩掉的一定不會命中、不改結果。"""
+    if len(names) <= _DRIFT_M1_PREFILTER_MIN:
+        return names
+    words = set()
+    for t in texts:
+        words.update(re.findall(r"[A-Za-z0-9_]+", t))
+    return {n: o for n, o in names.items() if all(w in words for w in re.findall(r"[A-Za-z0-9_]+", n))}
+
+
+def _drift_m1_about(text):
+    """about_code 只認區塊清單「- 路徑」(照參考實作 Note._about;單行寫法 about_code: x 不認)。"""
+    fm, _body = split_frontmatter(text)
+    out, cur = [], False
+    for ln in fm or []:
+        m = TOP_KEY_RE.match(ln)
+        if m:
+            cur = m.group(1) == "about_code"
+            continue
+        s = ln.strip()
+        if cur and s.startswith("- "):
+            out.append(s[2:].strip().strip('"').strip("'").strip("`"))
+    return out
+
+
+def _drift_m1_cache_dir():
+    """定義快取目錄 ~/.cache/lumos/drift-defs/ → Path 或 None(建不了、不可信:當沒快取,也不寫不刪)。"""
+    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-defs"):
+        return None
+    d = Path.home() / ".cache" / "lumos" / "drift-defs"
+    return d if _trusted_private_dir(d, ".cache", "lumos", "drift-defs") else None
+
+
+def _drift_m1_cache_path(d, oid):
+    import hashlib
+    maj, mnr = _drift_m1_pyver()
+    return d / (hashlib.sha256(f"{oid}|schema{_DRIFT_M1_DEFS_SCHEMA}|py{maj}.{mnr}".encode()).hexdigest() + ".json")
+
+
+def _drift_m1_cache_get(d, oid):
+    """→ (函式, 類別, 指派, 旗標, 文字抽定義) 五個集合或 None。檔要是自己的、group/other 不可寫、保鮮期內(_lens_cache_read)。"""
+    if d is None or not _LENS_SHA_RE.fullmatch(oid or ""):
+        return None
+    got = _lens_cache_read(_drift_m1_cache_path(d, oid), ttl_sec=_DRIFT_M1_DEFS_TTL)
+    if not isinstance(got, dict) or not all(isinstance(got.get(k), list) for k in "fcagt"):
+        return None
+    if not all(isinstance(x, str) for k in "fcagt" for x in got[k]):
+        return None
+    return tuple(set(got[k]) for k in "fcagt")
+
+
+def _drift_m1_cache_evict(d):
+    """開跑前刪掉 mtime 超過保鮮期的檔(讀不更新 mtime);目錄不可信(d 是 None)一支都不碰。"""
+    if d is None:
+        return
+    try:
+        ents = list(d.iterdir())
+    except OSError:
+        return
+    for f in ents:
+        try:
+            if f.is_file() and not f.is_symlink() and time.time() - f.stat().st_mtime > _DRIFT_M1_DEFS_TTL:
+                f.unlink()
+        except OSError:
+            pass
+
+
+class _DriftM1Stop(Exception):
+    """判不了、停下:state 是 timeout 或 git-failed。"""
+
+    def __init__(self, state):
+        super().__init__(state)
+        self.state = state
+
+
+_DRIFT_M1_EMPTY_INFO = ("ast", (frozenset(),) * 4, frozenset(), frozenset())
+
+
+class _DriftM1Run:
+    """一次舊句檢查的狀態(〈做法〉1 到 3):範圍、快取、計數、已讀的內容與剖過的結果。由 _drift_old_sentence_check 建。"""
+
+    def __init__(self, root, base, tip, vault_rel, deadline, now):
+        self.root, self.base, self.tip, self.vault_rel = root, base, tip, vault_rel
+        self.deadline, self.now = deadline, now
+        self.raw, self.info = {}, {}
+        self.cache, self.changes = None, []
+        self.res = {"state": None, "handle": [], "listed": [], "unparsable": [], "text_defs": [], "bad_notes": 0,
+                    "bad_touched": 0, "code_files": None, "other_files": 0, "candidates": None, "too_long": 0,
+                    "parsed": 0, "cache_hits": None, "gone": {}}
+
+    def check_time(self):
+        if self.now() > self.deadline:
+            raise _DriftM1Stop("timeout")
+
+    def fail(self):
+        raise _DriftM1Stop("timeout" if self.now() > self.deadline else "git-failed")
+
+    def left(self):
+        return max(1.0, self.deadline - self.now())
+
+    def listing(self, where):
+        """(一般檔 {路徑: 模式}, 所有路徑, {路徑: 內容編號});where 是 None(空樹)回空的。"""
+        if where is None:
+            return {}, [], {}
+        self.check_time()
+        lst = _drift_list(self.root, where)
+        if lst is None:
+            self.fail()
+        return lst[0], lst[1], _drift_oids(self.root, where)
+
+    def spec(self, where, oids, p):
+        return oids.get(p) or f"{where}:{p}"
+
+    def read(self, specs):
+        """批次讀(以剩下的時間為上限);已讀過的不重讀。回 None 時已過截止時間記 timeout,否則 git-failed。"""
+        need = sorted({s for s in specs if s and s not in self.raw})
+        if not need:
+            return
+        self.check_time()
+        got = _drift_m1_cat(self.root, need, self.left())
+        if got is None:
+            self.fail()
+        self.raw.update(zip(need, got))
+
+    def head(self, spec):
+        return _drift_decode(self.raw.get(spec) or b"").split("\n", 1)[0]
+
+    def cached(self, spec):
+        """快取命中就記進 info、回 True(.py 命中不讀內容)。"""
+        if spec in self.info:
+            return True
+        got = _drift_m1_cache_get(self.cache, spec)
+        if got is None:
+            return False
+        self.info[spec] = ("ast", got[:4], got[4], None)
+        if self.res["cache_hits"] is not None:
+            self.res["cache_hits"] += 1
+        return True
+
+    def blob_info(self, spec):
+        """(種類 ast|big|bad, 四個集合或 None, 文字抽定義, 引號旗標或 None)。剖完寫快取(剖不動與太大的不寫)。"""
+        if spec in self.info or self.cached(spec):
+            return self.info[spec]

