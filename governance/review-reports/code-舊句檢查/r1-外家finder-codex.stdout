 28726	def _drift_m1_paren_span(line, pos):
 28727	    """包住 pos 的最內層那對括號 (起, 迄);沒有括號包住、但最後一個沒關上的 ( 在 pos 前面 → (那個位置, 行尾);否則 None。"""
 28728	    opened, span = [], None
 28729	    for i, ch in enumerate(line):
 28730	        if ch in "(（":
 28731	            opened.append(i)
 28732	        elif ch in ")）" and opened:
 28733	            a = opened.pop()
 28734	            if a < pos < i and (span is None or a > span[0]):
 28735	                span = (a, i)
 28736	    if span is None and opened and opened[-1] < pos:
 28737	        span = (opened[-1], len(line))
 28738	    return span
 28739	
 28740	
 28741	def _drift_m1_clause_hist(line, pos):
 28742	    """名稱所在那一句有沒有歷史字眼(逐字照參考實作 _clause_has_hist):括號內只看括號內;括號外先把「裡面沒有括號的
 28743	    括號對」整對遮掉;再用 。;;!?!? 切,取名稱所在那一小段(英文句點不切)。"""
 28744	    span = _drift_m1_paren_span(line, pos)
 28745	    if span is not None:
 28746	        seg, rel = line[span[0] + 1:span[1]], pos - span[0] - 1
 28747	    else:
 28748	        seg, rel = re.sub(r"[(（][^()（）]*[)）]", lambda m: "\0" * len(m.group(0)), line), pos
 28749	    cuts = [m.end() for m in _DRIFT_M1_CUT_RE.finditer(seg) if m.end() <= rel]
 28750	    m2 = _DRIFT_M1_CUT_RE.search(seg[rel:])
 28751	    clause = seg[(cuts[-1] if cuts else 0):(rel + m2.start() if m2 else len(seg))]
 28752	    return bool(_DRIFT_M1_HIST_RX.search(clause))
 28753	
 28754	
 28755	def _drift_m1_name_rx(names):
 28756	    """整字比對的一條正則(逐字照參考實作 _mk_rx):一般識別字前後不能緊接 ASCII 英數底線;旗標、路徑、帶 . 的前面不能緊接
 28757	    ASCII 英數、底線、/ . -,後面不能緊接 ASCII 英數、底線、-。一般識別字那組在前、組內長的在前。"""
 28758	    ids = sorted((n for n in names if not n.startswith("--") and "/" not in n and "." not in n), key=len, reverse=True)
 28759	    idset = set(ids)
 28760	    others = sorted((n for n in names if n not in idset), key=len, reverse=True)
 28761	    parts = []
 28762	    if ids:
 28763	        parts.append(r"(?<![A-Za-z0-9_])(?:" + "|".join(map(re.escape, ids)) + r")(?![A-Za-z0-9_])")
 28764	    if others:
 28765	        parts.append(r"(?<![A-Za-z0-9_/.-])(?:" + "|".join(map(re.escape, others)) + r")(?![A-Za-z0-9_-])")
 28766	    return re.compile("|".join(parts)) if parts else None
 28767	
 28768	
 28769	def _drift_m1_prefilter(names, texts):
 28770	    """名稱先篩(候選超過 _DRIFT_M1_PREFILTER_MIN 個才做):名稱每一段 ASCII 詞都在圖譜全文的 ASCII 詞集合裡才留下,
 28771	    沒有 ASCII 段的一律留下。整字正則命中處的每一段一定是完整的 ASCII 詞,所以篩掉的一定不會命中、不改結果。"""
 28772	    if len(names) <= _DRIFT_M1_PREFILTER_MIN:
 28773	        return names
 28774	    words = set()
 28775	    for t in texts:
 28776	        words.update(re.findall(r"[A-Za-z0-9_]+", t))
 28777	    return {n: o for n, o in names.items() if all(w in words for w in re.findall(r"[A-Za-z0-9_]+", n))}
 28778	
 28779	
 28780	def _drift_m1_about(text):
 28781	    """about_code 只認區塊清單「- 路徑」(照參考實作 Note._about;單行寫法 about_code: x 不認)。"""
 28782	    fm, _body = split_frontmatter(text)
 28783	    out, cur = [], False
 28784	    for ln in fm or []:
 28785	        m = TOP_KEY_RE.match(ln)
 28786	        if m:
 28787	            cur = m.group(1) == "about_code"
 28788	            continue
 28789	        s = ln.strip()
 28790	        if cur and s.startswith("- "):
 28791	            out.append(s[2:].strip().strip('"').strip("'").strip("`"))
 28792	    return out
