 29207	def _drift_m1_ledger_miss(root, tip, state):
 29208	    """治理帳寫不進去時的留痕:~/.cache/lumos/drift-m1/ledger-miss.jsonl 追加一行(REVISIT 讀它算樣本不足)。"""
 29209	    import json as _j, datetime as _dt
 29210	    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-m1"):
 29211	        return False
 29212	    d = Path.home() / ".cache" / "lumos" / "drift-m1"
 29213	    if not _trusted_private_dir(d, ".cache", "lumos", "drift-m1"):
 29214	        return False
 29215	    line = _j.dumps({"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
 29216	                     "repo": os.path.realpath(str(root)), "head_sha": tip, "state": state}, ensure_ascii=False) + "\n"
 29217	    try:
 29218	        fd = os.open(str(d / "ledger-miss.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
 29219	        try:
 29220	            os.write(fd, line.encode("utf-8"))
 29221	        finally:
 29222	            os.close(fd)
 29223	        return True
 29224	    except OSError:
 29225	        return False
