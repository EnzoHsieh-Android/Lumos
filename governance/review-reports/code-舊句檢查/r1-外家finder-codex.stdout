 26856	def _drift_py_names(txt, m1=False):
 26857	    """Python 原文 → (函式名, 類別名, 模組層指定名) 三個集合;解析失敗回 None。用 ast,字串與 docstring 裡的範例不算
 26858	    (代碼審 r1 外家席、架構對齊席:原本逐行正則,三引號字串裡的 def 被當成定義——_py_declared_methods 早就為同一個坑
 26859	    改用 ast)。函式與類別任何層都算(方法也算,計劃〈做法〉第 2 節);指定只算模組層,帶型別的要有值。
 26860	    m1=True(舊句檢查,Projects/舊句檢查_計劃〈做法〉1)→ (函式, 類別, 指派, 旗標) 四個集合,指派與旗標逐字照參考實作
 26861	    old_sentence_exp.py 的 _collect_assigns 與 _scan_add_argument;m1=False 時行為與回傳形狀都不變(probe 照舊)。
 26862	    ★抽法任何一次改動就把 _DRIFT_M1_DEFS_SCHEMA 加一★(定義快取以它為鍵;t_drift_m1_defs_cache 釘了輸出雜湊)。"""
 26863	    import ast as _ast
 26864	    try:
 26865	        tree = _ast.parse(txt)
 26866	    except (SyntaxError, ValueError, MemoryError, RecursionError):
 26867	        # 巢狀很深的合法檔,CPython 的解析器丟 MemoryError(「too complex to parse」)而不是 SyntaxError,
 26868	        # 原本沒接住,整支 scan 與推送檢查當掉(代碼審 r2 邊界席)。3.12 以前的解析器碰到極長運算式會直接 SIGSEGV、
 26869	        # 接不到;工具最低版本改成 3.14 之後,原本為它加的事先量測已刪([[Projects/最低Python版本改3.14_計劃]])
 26870	        return None
 26871	    funcs, classes, assigns = set(), set(), set()
 26872	    for node in _ast.walk(tree):
 26873	        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
 26874	            funcs.add(node.name)
 26875	        elif isinstance(node, _ast.ClassDef):
 26876	            classes.add(node.name)
 26877	    if m1:
 26878	        return funcs, classes, _drift_m1_assigns(tree.body, True, set()), _drift_m1_flags(tree)
 26879	    for node in tree.body:
 26880	        if isinstance(node, _ast.Assign):
 26881	            assigns.update(t.id for t in node.targets if isinstance(t, _ast.Name))
 26882	        elif isinstance(node, _ast.AnnAssign) and node.value is not None and isinstance(node.target, _ast.Name):
 26883	            assigns.add(node.target.id)
 26884	    return funcs, classes, assigns
 26885	
 26886	
 26887	def _drift_m1_targets(st):
 26888	    """一句指派的目標名(照參考實作 _assign_pairs + _target_names):Assign 每個目標、AnnAssign(有沒有值都算);
 26889	    tuple/list 拆包只收一層、只收直接是名稱的元素(*rest 與巢狀的不收)。"""
 26890	    import ast as _ast
 26891	    tgts = list(st.targets) if isinstance(st, _ast.Assign) else [st.target] if isinstance(st, _ast.AnnAssign) else []
 26892	    out = []
 26893	    for t in tgts:
 26894	        out += [t.id] if isinstance(t, _ast.Name) else [e.id for e in getattr(t, "elts", []) if isinstance(e, _ast.Name)]
 26895	    return out
 26896	
 26897	
 26898	def _drift_m1_assigns(body, module, out):
 26899	    """模組層與類別層(含巢狀類別)的指派名;模組層 if/try(含 else、except、finally)裡的遞迴收,
 26900	    except*、type X = …、X += 1、函式裡的區域指派不收(照參考實作 _collect_assigns)。"""
 26901	    import ast as _ast
 26902	    for st in body:
 26903	        out.update(_drift_m1_targets(st))
 26904	        if isinstance(st, _ast.ClassDef):
 26905	            _drift_m1_assigns(st.body, False, out)
 26906	        if module and isinstance(st, _ast.If):
 26907	            _drift_m1_assigns(st.body + st.orelse, True, out)
 26908	        elif module and isinstance(st, _ast.Try):
 26909	            _drift_m1_assigns(st.body + st.orelse + [x for h in st.handlers for x in h.body] + st.finalbody, True, out)
 26910	    return out
 26911	
 26912	
 26913	def _drift_m1_flags(tree):
 26914	    """任何 add_argument(...) 呼叫(p.add_argument 或裸的 add_argument)位置參數裡以 -- 開頭的字串常數。"""
 26915	    import ast as _ast
 26916	    out = set()
 26917	    for node in _ast.walk(tree):
 26918	        if not isinstance(node, _ast.Call):
 26919	            continue
 26920	        f = node.func
 26921	        name = f.attr if isinstance(f, _ast.Attribute) else (f.id if isinstance(f, _ast.Name) else "")
 26922	        if name == "add_argument":
 26923	            out.update(a.value for a in node.args
 26924	                       if isinstance(a, _ast.Constant) and isinstance(a.value, str) and a.value.startswith("--"))
 26925	    return out
