 28803	def _drift_m1_cache_path(d, oid):
 28804	    import hashlib
 28805	    maj, mnr = _drift_m1_pyver()
 28806	    return d / (hashlib.sha256(f"{oid}|schema{_DRIFT_M1_DEFS_SCHEMA}|py{maj}.{mnr}".encode()).hexdigest() + ".json")
 28807	
 28808	
 28809	def _drift_m1_cache_get(d, oid):
 28810	    """→ (函式, 類別, 指派, 旗標, 文字抽定義) 五個集合或 None。檔要是自己的、group/other 不可寫、保鮮期內(_lens_cache_read)。"""
 28811	    if d is None or not _LENS_SHA_RE.fullmatch(oid or ""):
 28812	        return None
 28813	    got = _lens_cache_read(_drift_m1_cache_path(d, oid), ttl_sec=_DRIFT_M1_DEFS_TTL)
 28814	    if not isinstance(got, dict) or not all(isinstance(got.get(k), list) for k in "fcagt"):
 28815	        return None
 28816	    if not all(isinstance(x, str) for k in "fcagt" for x in got[k]):
 28817	        return None
 28818	    return tuple(set(got[k]) for k in "fcagt")
 28819	
 28820	
 28821	def _drift_m1_cache_evict(d):
 28822	    """開跑前刪掉 mtime 超過保鮮期的檔(讀不更新 mtime);目錄不可信(d 是 None)一支都不碰。"""
 28823	    if d is None:
 28824	        return
 28825	    try:
 28826	        ents = list(d.iterdir())
 28827	    except OSError:
 28828	        return
 28829	    for f in ents:
 28830	        try:
 28831	            if f.is_file() and not f.is_symlink() and time.time() - f.stat().st_mtime > _DRIFT_M1_DEFS_TTL:
 28832	                f.unlink()
 28833	        except OSError:
 28834	            pass
 28835	
 28836	
 28837	class _DriftM1Stop(Exception):
 28838	    """判不了、停下:state 是 timeout 或 git-failed。"""
 28839	
 28840	    def __init__(self, state):
 28841	        super().__init__(state)
 28842	        self.state = state
 28843	
 28844	
 28845	_DRIFT_M1_EMPTY_INFO = ("ast", (frozenset(),) * 4, frozenset(), frozenset())
 28846	
 28847	
 28848	class _DriftM1Run:
 28849	    """一次舊句檢查的狀態(〈做法〉1 到 3):範圍、快取、計數、已讀的內容與剖過的結果。由 _drift_old_sentence_check 建。"""
 28850	
 28851	    def __init__(self, root, base, tip, vault_rel, deadline, now):
 28852	        self.root, self.base, self.tip, self.vault_rel = root, base, tip, vault_rel
 28853	        self.deadline, self.now = deadline, now
 28854	        self.raw, self.info = {}, {}
 28855	        self.cache, self.changes = None, []
 28856	        self.res = {"state": None, "handle": [], "listed": [], "unparsable": [], "text_defs": [], "bad_notes": 0,
 28857	                    "bad_touched": 0, "code_files": None, "other_files": 0, "candidates": None, "too_long": 0,
 28858	                    "parsed": 0, "cache_hits": None, "gone": {}}
 28859	
 28860	    def check_time(self):
 28861	        if self.now() > self.deadline:
 28862	            raise _DriftM1Stop("timeout")
 28863	
 28864	    def fail(self):
 28865	        raise _DriftM1Stop("timeout" if self.now() > self.deadline else "git-failed")
 28866	
 28867	    def left(self):
 28868	        return max(1.0, self.deadline - self.now())
 28869	
 28870	    def listing(self, where):
 28871	        """(一般檔 {路徑: 模式}, 所有路徑, {路徑: 內容編號});where 是 None(空樹)回空的。"""
 28872	        if where is None:
 28873	            return {}, [], {}
 28874	        self.check_time()
 28875	        lst = _drift_list(self.root, where)
 28876	        if lst is None:
 28877	            self.fail()
 28878	        return lst[0], lst[1], _drift_oids(self.root, where)
 28879	
 28880	    def spec(self, where, oids, p):
 28881	        return oids.get(p) or f"{where}:{p}"
 28882	
 28883	    def read(self, specs):
 28884	        """批次讀(以剩下的時間為上限);已讀過的不重讀。回 None 時已過截止時間記 timeout,否則 git-failed。"""
 28885	        need = sorted({s for s in specs if s and s not in self.raw})
 28886	        if not need:
 28887	            return
 28888	        self.check_time()
 28889	        got = _drift_m1_cat(self.root, need, self.left())
 28890	        if got is None:
 28891	            self.fail()
 28892	        self.raw.update(zip(need, got))
 28893	
 28894	    def head(self, spec):
 28895	        return _drift_decode(self.raw.get(spec) or b"").split("\n", 1)[0]
 28896	
 28897	    def cached(self, spec):
 28898	        """快取命中就記進 info、回 True(.py 命中不讀內容)。"""
 28899	        if spec in self.info:
 28900	            return True
 28901	        got = _drift_m1_cache_get(self.cache, spec)
 28902	        if got is None:
 28903	            return False
 28904	        self.info[spec] = ("ast", got[:4], got[4], None)
 28905	        if self.res["cache_hits"] is not None:
 28906	            self.res["cache_hits"] += 1
 28907	        return True
 28908	
 28909	    def blob_info(self, spec):
 28910	        """(種類 ast|big|bad, 四個集合或 None, 文字抽定義, 引號旗標或 None)。剖完寫快取(剖不動與太大的不寫)。"""
 28911	        if spec in self.info or self.cached(spec):
 28912	            return self.info[spec]
 28913	        raw = self.raw.get(spec)
 28914	        txt = _drift_decode(raw or b"")
 28915	        if raw is None:         # 讀不到內容(不是一般檔、批次讀回 None):當剖不動,不寫快取
 28916	            got = ("bad", None, set(), set())
 28917	        elif len(raw) > _DRIFT_M1_PARSE_MAX_BYTES:
 28918	            got = ("big", None, _drift_m1_text_defs(txt), _drift_m1_text_defs(txt, loose=True))
 28919	        else:
 28920	            self.check_time()
 28921	            self.res["parsed"] += 1
 28922	            sets = _drift_py_names(txt, m1=True)
 28923	            tdefs = _drift_m1_text_defs(txt)
 28924	            got = ("bad", None, tdefs, _drift_m1_text_defs(txt, loose=True)) if sets is None else ("ast", sets, tdefs, None)
 28925	            if sets is not None and self.cache is not None and _LENS_SHA_RE.fullmatch(spec):
 28926	                _home_cache_write("drift-defs", _drift_m1_cache_path(self.cache, spec),
 28927	                                  {k: sorted(v) for k, v in zip("fcagt", (*sets, tdefs))})
 28928	        self.info[spec] = got
 28929	        return got
 28930	
 28931	
 28932	def _drift_m1_cat(root, specs, timeout):
 28933	    """m1 讀程式檔內容的唯一出口(一次批次讀;測試數它被呼叫幾次)。"""
 28934	    return _nodehome_cat_blobs(root, specs, timeout=timeout)
 28935	
 28936	
 28937	def _drift_m1_changes(run):
 28938	    """範圍裡改到的檔 [(狀態, 路徑)](--no-renames:改名看成一刪一加)。列不出 → 停下。"""
 28939	    run.check_time()
 28940	    raw = _ns_git(run.root, "diff", "--name-status", "-z", "--no-renames", "--no-ext-diff",
 28941	                  run.base or _drift_empty_tree(run.root), run.tip)
 28942	    if raw is None:
 28943	        run.fail()
 28944	    toks, out = raw.split(b"\0"), []
 28945	    for i in range(0, len(toks) - 1, 2):
 28946	        if toks[i]:
 28947	            out.append((toks[i][:1].decode("ascii", "replace"), nfc(os.fsdecode(toks[i + 1]))))
 28948	    run.changes = out
 28949	    return out
 28950	
 28951	
 28952	def _drift_m1_classify(run, changes):
 28953	    """改到的檔 → [(狀態, 路徑, py|other)] 只收程式檔。沒副檔名的要讀首行;有起點時順便把改到的 .py 快取沒命中的兩版一起讀
 28954	    (粗候選要的改到的檔,一次批次讀)。一支可能是程式檔的都沒有就不列檔、不讀(純文件推送不印不記)。"""
 28955	    maybe = [(st, p) for st, p in changes if _drift_m1_code_path(p) and _nodehome_code_kind(p) in ("ext", "shebang?")]
 28956	    if not maybe:
 28957	        return []
 28958	    tl, bl = run.listing(run.tip)[2], run.listing(run.base)[2]
 28959	    need = []
 28960	    for st, p in maybe:
 28961	        vers = ([run.spec(run.tip, tl, p)] if st != "D" else []) + \
 28962	               ([run.spec(run.base, bl, p)] if (run.base and st != "A") else [])
 28963	        if _nodehome_code_kind(p) == "shebang?":
 28964	            need += vers
 28965	        elif p.endswith(".py") and run.base:
 28966	            need += [s for s in vers if not run.cached(s)]
 28967	    run.read(need)
 28968	    out = []
 28969	    for st, p in maybe:
 28970	        k = _drift_m1_code_kind(p, run.head(run.spec(run.tip, tl, p) if st != "D" else run.spec(run.base, bl, p)))
 28971	        if k:
 28972	            out.append((st, p, k))
 28973	    return out
 28974	
 28975	
 28976	def _drift_m1_pair_defs(run, st, p, tl, bl):
 28977	    """改到的一支 Python 檔 → (起點版名稱, 終點版名稱) 或 None(任一版剖不動;記進 unparsable)。任一版太大 → 兩版都用文字抽。"""
 28978	    bi = run.blob_info(run.spec(run.base, bl, p))
 28979	    ti = run.blob_info(run.spec(run.tip, tl, p)) if st != "D" else _DRIFT_M1_EMPTY_INFO
 28980	    if "bad" in (bi[0], ti[0]):
 28981	        run.res["unparsable"].append(p)
 28982	        return None
 28983	    if "big" in (bi[0], ti[0]):
 28984	        run.res["text_defs"].append(p)
 28985	        return set(bi[2]), set(ti[2])
 28986	    return set().union(*bi[1]), set().union(*ti[1])
 28987	
 28988	
 28989	def _drift_m1_rough(run, coded, tl, bl, tip_all):
 28990	    """粗候選(過形狀過濾):定義名與旗標 = 起點那版有、終點那版沒有;路徑 = 被刪的程式檔舊路徑,檔名在終點任何位置都沒有
 28991	    同名檔才算。回 ({定義名: 起點路徑集合}, {路徑名: 起點路徑集合})。"""
 28992	    defs, paths = {}, {}
 28993	    for st, p, k in coded:
 28994	        if k == "py" and st != "A":
 28995	            got = _drift_m1_pair_defs(run, st, p, tl, bl)
 28996	            for n in (got[0] - got[1]) if got else ():
 28997	                defs.setdefault(n, set()).add(p)
 28998	    bases = {x.rsplit("/", 1)[-1] for x in tip_all}
 28999	    for st, p, _k in coded:
 29000	        if st == "D":
 29001	            paths.setdefault(p, set()).add(p)
 29002	            if p.rsplit("/", 1)[-1] not in bases:
 29003	                paths.setdefault(p.rsplit("/", 1)[-1], set()).add(p)
 29004	    keep = _drift_m1_shape_ok
 29005	    return {n: o for n, o in defs.items() if keep(n)}, {n: o for n, o in paths.items() if keep(n)}
 29006	
 29007	
 29008	def _drift_m1_corpus(run, tf, tl):
 29009	    """終點語料(照範圍判定的所有 Python 檔,含測試檔)的定義與旗標聯集。.py 快取命中不讀;沒命中的與沒副檔名的一次批次讀。
 29010	    剖不動或太大的檔用文字抽定義(含引號裡的 --旗標)補進聯集(刻意差異第 2、3 條)。"""
 29011	    cand = [p for p in sorted(tf) if _drift_m1_code_path(p) and (p.endswith(".py") or _nodehome_code_kind(p) == "shebang?")]
 29012	    run.read([run.spec(run.tip, tl, p) for p in cand if not (p.endswith(".py") and run.cached(run.spec(run.tip, tl, p)))])
 29013	    alive = set()
 29014	    for p in cand:
 29015	        s = run.spec(run.tip, tl, p)
 29016	        if not p.endswith(".py") and _drift_m1_code_kind(p, run.head(s)) != "py":
 29017	            continue
 29018	        kind, sets, _tdefs, loose = run.blob_info(s)
 29019	        if kind == "ast":
 29020	            alive.update(*sets)
 29021	        else:
 29022	            alive.update(loose)
 29023	            if p not in run.res["text_defs"]:
 29024	                run.res["text_defs"].append(p)
 29025	    return alive
 29026	
 29027	
 29028	def _drift_m1_homes(run, envs, coded):
 29029	    """家(照參考實作 homes_any):起點樹或終點樹任一邊的 about_code 列了這次改到的任何一支程式檔的筆記。"""
 29030	    paths = {p for _st, p, _k in coded}
 29031	    out = set()
 29032	    for env in envs:
 29033	        for rel, n in env.notes.items():
 29034	            t = None if _note_unreadable(n) else env_text(env, rel)
 29035	            if t and paths & set(_drift_m1_about(t)):
 29036	                out.add(rel)
 29037	    return out
 29038	
 29039	
 29040	def _drift_m1_envs(run, touched):
 29041	    """終點與起點的圖譜(各讀一次)。範圍改到的筆記讀不出記 bad_touched,沒改到的記 bad_notes。"""
 29042	    import time as _t
 29043	    real = _t.monotonic() + max(0.0, run.deadline - run.now())
 29044	    envs = []
 29045	    for where in (run.tip, run.base):
 29046	        run.check_time()
 29047	        env = _drift_tree_env(run.root, where, run.vault_rel, deadline=real)
 29048	        if env is None:
 29049	            run.fail()
 29050	        envs.append(env)
 29051	    bad = [r for r, n in envs[0].notes.items() if _note_unreadable(n)]
 29052	    run.res["bad_touched"] = sum(1 for r in bad if r in touched)
 29053	    run.res["bad_notes"] = len(bad) - run.res["bad_touched"]
 29054	    return envs
 29055	
 29056	
 29057	def _drift_m1_scan_note(run, rel, text, rx, gone, homes):
 29058	    """掃一篇筆記:正文、摘要、決策欄的可見行,撤除節不看,名稱所在那一句有歷史字眼的不算提到;一行一筆。"""
 29059	    lines = text.split("\n")
 29060	    try:
 29061	        regs = _notelines_regions(text)
 29062	    except Exception:     # 照參考實作:區塊判不出就整篇當正文
 29063	        regs = ["body"] * len(lines)
 29064	    vis = {i for i, _ln in _visible_lines(lines)}
 29065	    ret = _drift_m1_retired(lines, regs, vis)
 29066	    for i, ln in enumerate(lines):
 29067	        if i % 200 == 0:
 29068	            run.check_time()
 29069	        if regs[i] not in _DRIFT_M1_NOTE_REGIONS or (i + 1) not in vis or ret[i + 1]:
 29070	            continue
 29071	        toks = sorted({m.group(0) for m in rx.finditer(ln) if not _drift_m1_clause_hist(ln, m.start())})
 29072	        if not toks:
 29073	            continue
 29074	        layer = "handle" if (regs[i] == "summary" or rel in homes) else "list"
 29075	        why = "消失的名稱:" + "、".join(f"`{t}`(原本在 {'、'.join(sorted(gone[t]))})" for t in toks)
 29076	        run.res[layer if layer == "handle" else "listed"].append(
 29077	            {"kind": "m1", "path": rel, "line": i + 1, "text": ln.strip(), "why": why, "names": toks, "layer": layer})
 29078	
 29079	
 29080	def _drift_m1_judge(run, coded):
 29081	    """有起點時的判定:粗候選 → (有定義名粗候選才)終點語料 → 候選名稱 → 讀筆記 → 掃。"""
 29082	    tf, tall, tl = run.listing(run.tip)
 29083	    _bf, _ball, bl = run.listing(run.base)
 29084	    defs, paths = _drift_m1_rough(run, coded, tl, bl, tall)
 29085	    alive = _drift_m1_corpus(run, tf, tl) if defs else set()
 29086	    gone = {n: set(o) for n, o in defs.items() if n not in alive}
 29087	    for n, o in paths.items():
 29088	        gone.setdefault(n, set()).update(o)
 29089	    run.res["candidates"] = len(gone)
 29090	    run.res["gone"] = {n: sorted(o) for n, o in gone.items()}
 29091	    names = {n: o for n, o in gone.items() if _drift_m1_name_ok(n)}
 29092	    run.res["too_long"] = len(gone) - len(names)
 29093	    if not names:
 29094	        return
 29095	    pre = run.vault_rel.rstrip("/") + "/"
 29096	    envs = _drift_m1_envs(run, {p[len(pre):] for _st, p in run.changes if p.startswith(pre)})
 29097	    homes = _drift_m1_homes(run, envs, coded)
 29098	    texts = {r: env_text(envs[0], r) for r, n in envs[0].notes.items() if not _note_unreadable(n)}
 29099	    rx = _drift_m1_name_rx(_drift_m1_prefilter(names, [t for t in texts.values() if t]))
 29100	    for rel in sorted(texts):
 29101	        run.check_time()
 29102	        if rx is not None and texts[rel]:
 29103	            _drift_m1_scan_note(run, rel, texts[rel], rx, names, homes)
 29104	    if run.res["bad_touched"]:
 29105	        run.res["state"] = "unreadable"
 29106	
 29107	
 29108	def _drift_old_sentence_check(root, base, tip, vault_rel, deadline, now=time.monotonic):
 29109	    """舊句檢查的判定本體(Projects/舊句檢查_計劃〈做法〉1 到 3)→ dict:handle、listed(發現)、state(done / timeout /
 29110	    git-failed / unreadable / no-base;範圍裡沒有改到程式檔是 None = 不印不記)、unparsable、text_defs(路徑)、
 29111	    bad_notes、bad_touched、code_files、other_files、candidates(還沒算出來是 None)、too_long、parsed、cache_hits、
 29112	    gone({候選名稱: 起點路徑清單},含太長沒列的)。
 29113	    不印、不寫帳。base 是 None = 空樹起點;是 tuple = 推送起點算不出來(列不出改到哪些檔,記 git-failed)。
 29114	    now 預設 time.monotonic(測試換掉它來造「掃到一半時間到」);截止時間 deadline 用同一個時鐘。"""
 29115	    run = _DriftM1Run(root, base, tip, vault_rel, deadline, now)
 29116	    try:
 29117	        if isinstance(base, tuple):
 29118	            raise _DriftM1Stop("git-failed")
 29119	        run.cache = _drift_m1_cache_dir()
 29120	        run.res["cache_hits"] = None if run.cache is None else 0
 29121	        _drift_m1_cache_evict(run.cache)
 29122	        coded = _drift_m1_classify(run, _drift_m1_changes(run))
 29123	        if not coded:
 29124	            return run.res
 29125	        run.res["code_files"] = len(coded)
 29126	        run.res["other_files"] = sum(1 for c in coded if c[2] == "other")
 29127	        if base is None:
 29128	            run.res["state"] = "no-base"
 29129	            return run.res
 29130	        run.res["state"] = "done"
 29131	        _drift_m1_judge(run, coded)
 29132	    except _DriftM1Stop as ex:
 29133	        run.res["state"] = ex.state
 29134	    return run.res
 29135	
 29136	
 29137	# ── m1 的印出與記帳 ──
