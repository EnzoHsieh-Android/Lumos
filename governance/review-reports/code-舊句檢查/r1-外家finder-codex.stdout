+def _drift_m1_targets(st):
+    """一句指派的目標名(照參考實作 _assign_pairs + _target_names):Assign 每個目標、AnnAssign(有沒有值都算);
+    tuple/list 拆包只收一層、只收直接是名稱的元素(*rest 與巢狀的不收)。"""
+    import ast as _ast
+    tgts = list(st.targets) if isinstance(st, _ast.Assign) else [st.target] if isinstance(st, _ast.AnnAssign) else []
+    out = []
+    for t in tgts:
+        out += [t.id] if isinstance(t, _ast.Name) else [e.id for e in getattr(t, "elts", []) if isinstance(e, _ast.Name)]
+    return out
+
+
+def _drift_m1_assigns(body, module, out):
+    """模組層與類別層(含巢狀類別)的指派名;模組層 if/try(含 else、except、finally)裡的遞迴收,
+    except*、type X = …、X += 1、函式裡的區域指派不收(照參考實作 _collect_assigns)。"""
+    import ast as _ast
+    for st in body:
+        out.update(_drift_m1_targets(st))
+        if isinstance(st, _ast.ClassDef):
+            _drift_m1_assigns(st.body, False, out)
+        if module and isinstance(st, _ast.If):
+            _drift_m1_assigns(st.body + st.orelse, True, out)
+        elif module and isinstance(st, _ast.Try):
+            _drift_m1_assigns(st.body + st.orelse + [x for h in st.handlers for x in h.body] + st.finalbody, True, out)
+    return out
+
+
+def _drift_m1_flags(tree):
+    """任何 add_argument(...) 呼叫(p.add_argument 或裸的 add_argument)位置參數裡以 -- 開頭的字串常數。"""
+    import ast as _ast
+    out = set()
+    for node in _ast.walk(tree):
+        if not isinstance(node, _ast.Call):
+            continue
+        f = node.func
+        name = f.attr if isinstance(f, _ast.Attribute) else (f.id if isinstance(f, _ast.Name) else "")
+        if name == "add_argument":
+            out.update(a.value for a in node.args
+                       if isinstance(a, _ast.Constant) and isinstance(a.value, str) and a.value.startswith("--"))
+    return out
+
