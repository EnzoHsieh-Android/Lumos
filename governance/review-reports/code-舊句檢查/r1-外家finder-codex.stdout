 29172	def _drift_m1_print_rows(res, handle, listed):
 29173	    if res["state"] == "timeout" and (handle or listed):
 29174	        print("  以下只是已找到的部分", file=sys.stderr)
 29175	    for head, rows in (("要處理(舊句檢查):", handle), ("只列出(舊句檢查,不擋):", listed)):
 29176	        if rows:
 29177	            print(head, file=sys.stderr)
 29178	            _drift_print_findings(rows, sys.stderr)
 29179	            _drift_print_hints(rows, sys.stderr)
