 29260	        listed, _l = _drift_split_acked(listed, acks, vault_rel)
 29261	    busy = bool(handle) or st in _DRIFT_M1_UNKNOWN
 29262	    line = _drift_m1_conclusion(res, len(handle), len(listed))
