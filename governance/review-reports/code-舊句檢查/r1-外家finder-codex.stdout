 34277	def _lens_cache_read(path, ttl_sec=1200):
 34278	    """只信自己 uid 擁有、group/other 不可寫、TTL 內的檔(r3 載荷席:$TMPDIR 路徑可預測可偽造)。"""
 34279	    import json as _json, stat as _stat, time as _time
 34280	    try:
 34281	        st = path.stat()
 34282	        if st.st_uid != os.getuid() or (st.st_mode & (_stat.S_IWGRP | _stat.S_IWOTH)):
 34283	            return None
 34284	        if _time.time() - st.st_mtime > ttl_sec:
 34285	            return None
 34286	        return _json.loads(path.read_text(encoding="utf-8"))
 34287	    except (OSError, ValueError):
 34288	        return None
