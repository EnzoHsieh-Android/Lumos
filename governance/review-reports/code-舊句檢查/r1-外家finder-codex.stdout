                if k or (not _excluded(p) and os.path.splitext(p)[1].lower() in TEXT_EXTS):
                    a, b = self.ctx.code.raw_tokens(sha)
                    ids |= a
                    flags |= b
            return ids, flags, paths, bases
        return self.memo("hay", f)

    def _added_elsewhere(self, py_chg):
        out = set()
