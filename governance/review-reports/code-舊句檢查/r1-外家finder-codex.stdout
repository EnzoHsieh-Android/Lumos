 29139	def _drift_unknown_hint(u):
 29140	    """判不了那一句(_drift_report_must 與 m1 共用)。"""
 29141	    return (f"  判不了:{_esc_clean(u, 1000)}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
 29142	            "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push")
 29143	
 29144	
 29145	def _drift_m1_conclusion(res, a, b):
 29146	    """結論行(沒有開頭詞)。a、b = 要處理、只列出筆數(扣掉已表態的)。"""
 29147	    st, n = res["state"], res["candidates"]
 29148	    if st == "done" and not n:
 29149	        return f"舊句檢查:這次改到 {res['code_files']} 支程式檔,沒有名稱消失"
 29150	    if st == "done" and not (a or b):
 29151	        return f"舊句檢查:這次消失 {n} 個名稱,筆記裡沒有還在講的"
 29152	    if st == "done":
 29153	        return f"舊句檢查:這次推送消失了 {n} 個名稱,筆記裡還在講的——要處理 {a} 筆、只列出 {b} 筆"
 29154	    return {"timeout": f"舊句檢查:這次沒跑完(時間到,{_DRIFT_M1_BUDGET_SEC} 秒)",
 29155	            "git-failed": "舊句檢查:git 讀不出這次推送的範圍或內容,這次沒判",
 29156	            "unreadable": f"舊句檢查:這次改到的筆記有 {res['bad_touched']} 篇讀不出,這次沒判完",
 29157	            "no-base": "舊句檢查:這次沒有起點版可比,不判"}[st]
 29158	
 29159	
 29160	def _drift_m1_print_extra(res):
 29161	    u, t = res["unparsable"], res["text_defs"]
 29162	    if u or t:
 29163	        print(f"  {len(u)} 支剖不動、{len(t)} 支用文字比對:" + "、".join(_esc_clean(x) for x in (u + t)[:3]), file=sys.stderr)
 29164	    if res["too_long"]:
 29165	        print(f"  {res['too_long']} 個名稱太長沒列", file=sys.stderr)
 29166	    if res["bad_notes"]:
 29167	        print(f"  {res['bad_notes']} 篇筆記讀不出沒掃", file=sys.stderr)
 29168	    if res["other_files"]:
 29169	        print(f"  這次有 {res['other_files']} 支非 Python 程式檔改動(只看路徑)", file=sys.stderr)
 29170	
