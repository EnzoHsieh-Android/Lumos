 29189	def _drift_m1_fit(root, kind, note, hard, tip, nodes, extra):
 29190	    """整行(照 _ledger_append 的量法,量 _gate_event_build 組出的完整事件)超過 4096 位元組:先從只列出、再從要處理尾端丟 rows;
 29191	    丟光還超過 → nodes 截到 20;再超過照寫。有截就記 rows_truncated。"""
 29192	    import json as _j
 29193	
 29194	    def size():
 29195	        ev = _gate_event_build(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra)
 29196	        return len((_j.dumps(ev, ensure_ascii=False) + "\n").encode("utf-8"))
 29197	    rows = extra.get("rows")
 29198	    while rows and size() > 4096:
 29199	        rows.pop()           # rows 是要處理在前、只列出在後,從尾端丟就是先丟只列出
 29200	        extra["rows_truncated"] = True
 29201	    if len(nodes) > 20 and size() > 4096:
 29202	        nodes = nodes[:20]
 29203	        extra["rows_truncated"] = True
 29204	    return nodes
