    e = _m1_events(root)[-1]
    check("④只刪了全小寫的 resolve(過不了形狀)→ done、candidates 0、passed、有帳", rc == 0 and e["state"] == "done"
          and e["candidates"] == 0 and e["kind"] == "passed" and e["head_sha"] == tip2, str(e))
