 28645	def _drift_m1_code_kind(p, first_line):
 28646	    """'py' | 'other' | None。Python = _drift_probe_is_py;其他程式檔 = 副檔名在 _NODEHOME_CODE_EXTS(大小寫敏感)或
 28647	    沒副檔名、首行是 #!(刻意差異第 1 條:不另抄參考實作的 TEXT_EXTS)。"""
 28648	    if not _drift_m1_code_path(p):
 28649	        return None
 28650	    if _drift_probe_is_py(p, first_line or ""):
 28651	        return "py"
 28652	    ck = _nodehome_code_kind(p)
