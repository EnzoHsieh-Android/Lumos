 29412	# doctor 給消費專案貼的 CI 步驟:before 原樣交(空的換成 40 個 0),帶 --push-remote origin --pushed-ref "$GITHUB_REF",
 29413	# 起點由 lumos 的 _push_range_start 算(推送閘接漂移檢查代碼審 r2:原本的 shell 補法在合過主線、新分支首推一次帶多個提交時算錯)。
 29414	# 補 before、補 origin/HEAD、呼叫 drift check 那幾行跟工具鏈自己的 .github/workflows/ci.yml 那步逐字相同——只差直譯器名
 29415	# (ci.yml 用 python、這裡用 python3)與 ci.yml 接在後面的回傳碼處理(t_doctor_drift_ci_template_start_fallback 比對並真的跑一次)。
 29416	# ★說明寫成 YAML 註解、縮排對齊步驟★(代碼審 r2 外家否決席):整段貼進 workflow 的 steps 底下要能被解析;
 29417	# Python 3.14 那句也寫成註解,不接共用的 _CI_PY314_NOTE(另兩處範本的同一個問題另開 Issue)。
 29418	_DRIFT_CI_STEP = """
 29419	    - name: drift check
 29420	      if: github.event_name == 'push'
 29421	      env:
 29422	        BEFORE: ${{ github.event.before }}
 29423	        SHA: ${{ github.sha }}
 29424	        DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
 29425	      run: |
 29426	        [ -n "$BEFORE" ] || BEFORE=0000000000000000000000000000000000000000
 29427	        if [ -n "$DEFAULT_BRANCH" ] && ! git rev-parse -q --verify refs/remotes/origin/HEAD >/dev/null && git rev-parse -q --verify "refs/remotes/origin/$DEFAULT_BRANCH" >/dev/null; then
 29428	          git symbolic-ref refs/remotes/origin/HEAD "refs/remotes/origin/$DEFAULT_BRANCH"
 29429	        fi
 29430	        python3 scripts/lumos drift check --diff "$BEFORE..$SHA" --push-remote origin --pushed-ref "$GITHUB_REF" --repo .
 29431	    # checkout 要設 fetch-depth: 0。起點由 lumos 算:跟主線最近的分岔點與 before 取比較新的;
 29432	    # checkout 不建 origin/HEAD,上面照 GitHub 給的預設分支補上,預設分支不叫 main/master 也找得到主線。
 29433	    # 回傳碼照原樣讓這步紅綠:0 是沒有要處理或 warn 模式只印;1 是 block 模式擋下;
 29434	    # 其他非零是工具出錯或參數錯,也會紅——工具出錯時寧可紅。
 29435	    # 這一步要在 Python 3.14 上跑:actions/setup-python 的 python-version 設 "3.14";lumos 的最低版本是 3.14,舊版會回 2 並說明。"""
 34270	    import hashlib
 34271	    # repo 部分用 realpath(跟 armed 檔的 _lens_repo_key 同一種算法;code-codex-s1 r1 架構席:兩套 key 並存)
 34272	    # extra=表態記錄的 sha256(表態閘 S8):重表態之後舊快取自然 miss
 34273	    key = hashlib.sha256(f"{os.path.realpath(str(repo_root))}|{base_sha}|{head_sha}|schema{_LENS_SCHEMA}|{extra}".encode("utf-8")).hexdigest()   # 帶 schema 版本:v1.1 舊快取自然 miss(v1.2 r2 外家)
 34274	    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / f"{key}.json"
