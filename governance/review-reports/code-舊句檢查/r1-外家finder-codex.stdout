    n0 = len(_m1_events(root))
    rc, out = _m1_run(root, f"{tip2}..{tip3}")
    check("④純文件推送:不印不記", rc == 0 and "舊句檢查" not in out and len(_m1_events(root)) == n0, out[-400:])
    # ②時間到(冷快取剖終點語料到一半;候選還沒算出來)
    orig_names = m._drift_py_names
