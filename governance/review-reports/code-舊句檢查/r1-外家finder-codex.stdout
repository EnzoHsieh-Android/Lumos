+    def cached(self, spec):
+        """快取命中就記進 info、回 True(.py 命中不讀內容)。"""
+        if spec in self.info:
+            return True
+        got = _drift_m1_cache_get(self.cache, spec)
+        if got is None:
+            return False
+        self.info[spec] = ("ast", got[:4], got[4], None)
+        if self.res["cache_hits"] is not None:
+            self.res["cache_hits"] += 1
+        return True
+
+    def blob_info(self, spec):
+        """(種類 ast|big|bad, 四個集合或 None, 文字抽定義, 引號旗標或 None)。剖完寫快取(剖不動與太大的不寫)。"""
+        if spec in self.info or self.cached(spec):
+            return self.info[spec]
+        raw = self.raw.get(spec)
+        txt = _drift_decode(raw or b"")
+        if raw is None:         # 讀不到內容(不是一般檔、批次讀回 None):當剖不動,不寫快取
+            got = ("bad", None, set(), set())
+        elif len(raw) > _DRIFT_M1_PARSE_MAX_BYTES:
+            got = ("big", None, _drift_m1_text_defs(txt), _drift_m1_text_defs(txt, loose=True))
+        else:
+            self.check_time()
+            self.res["parsed"] += 1
+            sets = _drift_py_names(txt, m1=True)
+            tdefs = _drift_m1_text_defs(txt)
+            got = ("bad", None, tdefs, _drift_m1_text_defs(txt, loose=True)) if sets is None else ("ast", sets, tdefs, None)
+            if sets is not None and self.cache is not None and _LENS_SHA_RE.fullmatch(spec):
+                _home_cache_write("drift-defs", _drift_m1_cache_path(self.cache, spec),
+                                  {k: sorted(v) for k, v in zip("fcagt", (*sets, tdefs))})
+        self.info[spec] = got
+        return got
+
+
+def _drift_m1_cat(root, specs, timeout):
+    """m1 讀程式檔內容的唯一出口(一次批次讀;測試數它被呼叫幾次)。"""
+    return _nodehome_cat_blobs(root, specs, timeout=timeout)
+
+
+def _drift_m1_changes(run):
+    """範圍裡改到的檔 [(狀態, 路徑)](--no-renames:改名看成一刪一加)。列不出 → 停下。"""
+    run.check_time()
+    raw = _ns_git(run.root, "diff", "--name-status", "-z", "--no-renames", "--no-ext-diff",
+                  run.base or _drift_empty_tree(run.root), run.tip)
+    if raw is None:
+        run.fail()
+    toks, out = raw.split(b"\0"), []
+    for i in range(0, len(toks) - 1, 2):
+        if toks[i]:
+            out.append((toks[i][:1].decode("ascii", "replace"), nfc(os.fsdecode(toks[i + 1]))))
+    run.changes = out
+    return out
+
+
+def _drift_m1_classify(run, changes):
+    """改到的檔 → [(狀態, 路徑, py|other)] 只收程式檔。沒副檔名的要讀首行;有起點時順便把改到的 .py 快取沒命中的兩版一起讀
+    (粗候選要的改到的檔,一次批次讀)。一支可能是程式檔的都沒有就不列檔、不讀(純文件推送不印不記)。"""
+    maybe = [(st, p) for st, p in changes if _drift_m1_code_path(p) and _nodehome_code_kind(p) in ("ext", "shebang?")]
+    if not maybe:
+        return []
+    tl, bl = run.listing(run.tip)[2], run.listing(run.base)[2]
+    need = []
+    for st, p in maybe:
+        vers = ([run.spec(run.tip, tl, p)] if st != "D" else []) + \
+               ([run.spec(run.base, bl, p)] if (run.base and st != "A") else [])
+        if _nodehome_code_kind(p) == "shebang?":
+            need += vers
+        elif p.endswith(".py") and run.base:
+            need += [s for s in vers if not run.cached(s)]
+    run.read(need)
+    out = []
+    for st, p in maybe:
+        k = _drift_m1_code_kind(p, run.head(run.spec(run.tip, tl, p) if st != "D" else run.spec(run.base, bl, p)))
+        if k:
+            out.append((st, p, k))
+    return out
+
+
+def _drift_m1_pair_defs(run, st, p, tl, bl):
+    """改到的一支 Python 檔 → (起點版名稱, 終點版名稱) 或 None(任一版剖不動;記進 unparsable)。任一版太大 → 兩版都用文字抽。"""
+    bi = run.blob_info(run.spec(run.base, bl, p))
+    ti = run.blob_info(run.spec(run.tip, tl, p)) if st != "D" else _DRIFT_M1_EMPTY_INFO
+    if "bad" in (bi[0], ti[0]):
+        run.res["unparsable"].append(p)
+        return None
+    if "big" in (bi[0], ti[0]):
+        run.res["text_defs"].append(p)
+        return set(bi[2]), set(ti[2])
+    return set().union(*bi[1]), set().union(*ti[1])
+
+
+def _drift_m1_rough(run, coded, tl, bl, tip_all):
+    """粗候選(過形狀過濾):定義名與旗標 = 起點那版有、終點那版沒有;路徑 = 被刪的程式檔舊路徑,檔名在終點任何位置都沒有
+    同名檔才算。回 ({定義名: 起點路徑集合}, {路徑名: 起點路徑集合})。"""
+    defs, paths = {}, {}
+    for st, p, k in coded:
+        if k == "py" and st != "A":
+            got = _drift_m1_pair_defs(run, st, p, tl, bl)
+            for n in (got[0] - got[1]) if got else ():
+                defs.setdefault(n, set()).add(p)
+    bases = {x.rsplit("/", 1)[-1] for x in tip_all}
+    for st, p, _k in coded:
+        if st == "D":
+            paths.setdefault(p, set()).add(p)
+            if p.rsplit("/", 1)[-1] not in bases:
+                paths.setdefault(p.rsplit("/", 1)[-1], set()).add(p)
+    keep = _drift_m1_shape_ok
+    return {n: o for n, o in defs.items() if keep(n)}, {n: o for n, o in paths.items() if keep(n)}
+
+
+def _drift_m1_corpus(run, tf, tl):
+    """終點語料(照範圍判定的所有 Python 檔,含測試檔)的定義與旗標聯集。.py 快取命中不讀;沒命中的與沒副檔名的一次批次讀。
+    剖不動或太大的檔用文字抽定義(含引號裡的 --旗標)補進聯集(刻意差異第 2、3 條)。"""
+    cand = [p for p in sorted(tf) if _drift_m1_code_path(p) and (p.endswith(".py") or _nodehome_code_kind(p) == "shebang?")]
+    run.read([run.spec(run.tip, tl, p) for p in cand if not (p.endswith(".py") and run.cached(run.spec(run.tip, tl, p)))])
+    alive = set()
+    for p in cand:
+        s = run.spec(run.tip, tl, p)
+        if not p.endswith(".py") and _drift_m1_code_kind(p, run.head(s)) != "py":
+            continue
+        kind, sets, _tdefs, loose = run.blob_info(s)
+        if kind == "ast":
+            alive.update(*sets)
+        else:
+            alive.update(loose)
+            if p not in run.res["text_defs"]:
+                run.res["text_defs"].append(p)
+    return alive
+
+
+def _drift_m1_homes(run, envs, coded):
+    """家(照參考實作 homes_any):起點樹或終點樹任一邊的 about_code 列了這次改到的任何一支程式檔的筆記。"""
+    paths = {p for _st, p, _k in coded}
+    out = set()
+    for env in envs:
+        for rel, n in env.notes.items():
+            t = None if _note_unreadable(n) else env_text(env, rel)
+            if t and paths & set(_drift_m1_about(t)):
+                out.add(rel)
+    return out
+
+
+def _drift_m1_envs(run, touched):
+    """終點與起點的圖譜(各讀一次)。範圍改到的筆記讀不出記 bad_touched,沒改到的記 bad_notes。"""
+    import time as _t
+    real = _t.monotonic() + max(0.0, run.deadline - run.now())
+    envs = []
+    for where in (run.tip, run.base):
+        run.check_time()
+        env = _drift_tree_env(run.root, where, run.vault_rel, deadline=real)
+        if env is None:
+            run.fail()
+        envs.append(env)
+    bad = [r for r, n in envs[0].notes.items() if _note_unreadable(n)]
+    run.res["bad_touched"] = sum(1 for r in bad if r in touched)
+    run.res["bad_notes"] = len(bad) - run.res["bad_touched"]
+    return envs
+
+
+def _drift_m1_scan_note(run, rel, text, rx, gone, homes):
+    """掃一篇筆記:正文、摘要、決策欄的可見行,撤除節不看,名稱所在那一句有歷史字眼的不算提到;一行一筆。"""
+    lines = text.split("\n")
+    try:
+        regs = _notelines_regions(text)
+    except Exception:     # 照參考實作:區塊判不出就整篇當正文
+        regs = ["body"] * len(lines)
+    vis = {i for i, _ln in _visible_lines(lines)}
+    ret = _drift_m1_retired(lines, regs, vis)
+    for i, ln in enumerate(lines):
+        if i % 200 == 0:
+            run.check_time()
+        if regs[i] not in _DRIFT_M1_NOTE_REGIONS or (i + 1) not in vis or ret[i + 1]:
+            continue
+        toks = sorted({m.group(0) for m in rx.finditer(ln) if not _drift_m1_clause_hist(ln, m.start())})
+        if not toks:
+            continue
+        layer = "handle" if (regs[i] == "summary" or rel in homes) else "list"
+        why = "消失的名稱:" + "、".join(f"`{t}`(原本在 {'、'.join(sorted(gone[t]))})" for t in toks)
+        run.res[layer if layer == "handle" else "listed"].append(
+            {"kind": "m1", "path": rel, "line": i + 1, "text": ln.strip(), "why": why, "names": toks, "layer": layer})
+
+
+def _drift_m1_judge(run, coded):
+    """有起點時的判定:粗候選 → (有定義名粗候選才)終點語料 → 候選名稱 → 讀筆記 → 掃。"""
+    tf, tall, tl = run.listing(run.tip)
+    _bf, _ball, bl = run.listing(run.base)
+    defs, paths = _drift_m1_rough(run, coded, tl, bl, tall)
+    alive = _drift_m1_corpus(run, tf, tl) if defs else set()
+    gone = {n: set(o) for n, o in defs.items() if n not in alive}
+    for n, o in paths.items():
+        gone.setdefault(n, set()).update(o)
+    run.res["candidates"] = len(gone)
+    run.res["gone"] = {n: sorted(o) for n, o in gone.items()}
+    names = {n: o for n, o in gone.items() if _drift_m1_name_ok(n)}
+    run.res["too_long"] = len(gone) - len(names)
+    if not names:
+        return
+    pre = run.vault_rel.rstrip("/") + "/"
+    envs = _drift_m1_envs(run, {p[len(pre):] for _st, p in run.changes if p.startswith(pre)})
+    homes = _drift_m1_homes(run, envs, coded)
+    texts = {r: env_text(envs[0], r) for r, n in envs[0].notes.items() if not _note_unreadable(n)}
+    rx = _drift_m1_name_rx(_drift_m1_prefilter(names, [t for t in texts.values() if t]))
+    for rel in sorted(texts):
+        run.check_time()
+        if rx is not None and texts[rel]:
+            _drift_m1_scan_note(run, rel, texts[rel], rx, names, homes)
+    if run.res["bad_touched"]:
+        run.res["state"] = "unreadable"
+
+
+def _drift_old_sentence_check(root, base, tip, vault_rel, deadline, now=time.monotonic):
+    """舊句檢查的判定本體(Projects/舊句檢查_計劃〈做法〉1 到 3)→ dict:handle、listed(發現)、state(done / timeout /
+    git-failed / unreadable / no-base;範圍裡沒有改到程式檔是 None = 不印不記)、unparsable、text_defs(路徑)、
+    bad_notes、bad_touched、code_files、other_files、candidates(還沒算出來是 None)、too_long、parsed、cache_hits、
+    gone({候選名稱: 起點路徑清單},含太長沒列的)。
+    不印、不寫帳。base 是 None = 空樹起點;是 tuple = 推送起點算不出來(列不出改到哪些檔,記 git-failed)。
+    now 預設 time.monotonic(測試換掉它來造「掃到一半時間到」);截止時間 deadline 用同一個時鐘。"""
+    run = _DriftM1Run(root, base, tip, vault_rel, deadline, now)
+    try:
+        if isinstance(base, tuple):
+            raise _DriftM1Stop("git-failed")
+        run.cache = _drift_m1_cache_dir()
+        run.res["cache_hits"] = None if run.cache is None else 0
+        _drift_m1_cache_evict(run.cache)
+        coded = _drift_m1_classify(run, _drift_m1_changes(run))
+        if not coded:
+            return run.res
+        run.res["code_files"] = len(coded)
+        run.res["other_files"] = sum(1 for c in coded if c[2] == "other")
+        if base is None:
+            run.res["state"] = "no-base"
+            return run.res
+        run.res["state"] = "done"
+        _drift_m1_judge(run, coded)
+    except _DriftM1Stop as ex:
+        run.res["state"] = ex.state
+    return run.res
+
+
+# ── m1 的印出與記帳 ──
+
+def _drift_unknown_hint(u):
+    """判不了那一句(_drift_report_must 與 m1 共用)。"""
+    return (f"  判不了:{_esc_clean(u, 1000)}——判不了就放行等於一條繞過的路,所以算要處理;真的要推就單次略過(會留帳):"
+            "\n    LUMOS_SKIP_DRIFT_CHECK=1 git push")
+
+
+def _drift_m1_conclusion(res, a, b):
+    """結論行(沒有開頭詞)。a、b = 要處理、只列出筆數(扣掉已表態的)。"""
+    st, n = res["state"], res["candidates"]
+    if st == "done" and not n:
+        return f"舊句檢查:這次改到 {res['code_files']} 支程式檔,沒有名稱消失"
+    if st == "done" and not (a or b):
+        return f"舊句檢查:這次消失 {n} 個名稱,筆記裡沒有還在講的"
+    if st == "done":
+        return f"舊句檢查:這次推送消失了 {n} 個名稱,筆記裡還在講的——要處理 {a} 筆、只列出 {b} 筆"
+    return {"timeout": f"舊句檢查:這次沒跑完(時間到,{_DRIFT_M1_BUDGET_SEC} 秒)",
+            "git-failed": "舊句檢查:git 讀不出這次推送的範圍或內容,這次沒判",
+            "unreadable": f"舊句檢查:這次改到的筆記有 {res['bad_touched']} 篇讀不出,這次沒判完",
+            "no-base": "舊句檢查:這次沒有起點版可比,不判"}[st]
+
+
+def _drift_m1_print_extra(res):
+    u, t = res["unparsable"], res["text_defs"]
+    if u or t:
+        print(f"  {len(u)} 支剖不動、{len(t)} 支用文字比對:" + "、".join(_esc_clean(x) for x in (u + t)[:3]), file=sys.stderr)
+    if res["too_long"]:
+        print(f"  {res['too_long']} 個名稱太長沒列", file=sys.stderr)
+    if res["bad_notes"]:
+        print(f"  {res['bad_notes']} 篇筆記讀不出沒掃", file=sys.stderr)
+    if res["other_files"]:
+        print(f"  這次有 {res['other_files']} 支非 Python 程式檔改動(只看路徑)", file=sys.stderr)
+
+
+def _drift_m1_print_rows(res, handle, listed):
+    if res["state"] == "timeout" and (handle or listed):
+        print("  以下只是已找到的部分", file=sys.stderr)
+    for head, rows in (("要處理(舊句檢查):", handle), ("只列出(舊句檢查,不擋):", listed)):
+        if rows:
+            print(head, file=sys.stderr)
+            _drift_print_findings(rows, sys.stderr)
+            _drift_print_hints(rows, sys.stderr)
+
+
+def _drift_m1_rows(rows, n):
+    """帳的 rows:路徑、名稱、原文都來自被推送的筆記與程式,寫帳前過 _esc_clean(原文取前 80 字)。"""
+    return [{"path": _esc_clean(f["path"], 10 ** 6), "line": f["line"], "layer": f["layer"],
+             "names": sorted(_esc_clean(x, 10 ** 6) for x in f["names"]),
+             "text": _esc_clean(f["text"], 10 ** 6)[:80]} for f in rows[:n]]
+
+
+def _drift_m1_fit(root, kind, note, hard, tip, nodes, extra):
+    """整行(照 _ledger_append 的量法,量 _gate_event_build 組出的完整事件)超過 4096 位元組:先從只列出、再從要處理尾端丟 rows;
+    丟光還超過 → nodes 截到 20;再超過照寫。有截就記 rows_truncated。"""
+    import json as _j
+
+    def size():
+        ev = _gate_event_build(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra)
+        return len((_j.dumps(ev, ensure_ascii=False) + "\n").encode("utf-8"))
+    rows = extra.get("rows")
+    while rows and size() > 4096:
+        rows.pop()           # rows 是要處理在前、只列出在後,從尾端丟就是先丟只列出
+        extra["rows_truncated"] = True
+    if len(nodes) > 20 and size() > 4096:
+        nodes = nodes[:20]
+        extra["rows_truncated"] = True
+    return nodes
+
+
+def _drift_m1_ledger_miss(root, tip, state):
+    """治理帳寫不進去時的留痕:~/.cache/lumos/drift-m1/ledger-miss.jsonl 追加一行(REVISIT 讀它算樣本不足)。"""
+    import json as _j, datetime as _dt
+    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-m1"):
+        return False
+    d = Path.home() / ".cache" / "lumos" / "drift-m1"
+    if not _trusted_private_dir(d, ".cache", "lumos", "drift-m1"):
+        return False
+    line = _j.dumps({"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
+                     "repo": os.path.realpath(str(root)), "head_sha": tip, "state": state}, ensure_ascii=False) + "\n"
+    try:
+        fd = os.open(str(d / "ledger-miss.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
+        try:
+            os.write(fd, line.encode("utf-8"))
+        finally:
+            os.close(fd)
+        return True
+    except OSError:
+        return False
+
+
+def _drift_m1_ledger(root, mode, base, tip, res, found, note):
+    """記一筆治理帳(gate drift-check;欄位攤平在事件最外層,check=old-sentence)。found=(要處理, 只列出)(扣掉已表態)。"""
+    handle, listed = found
+    st = res["state"]
+    judged = st not in _DRIFT_M1_UNKNOWN
+    busy = bool(handle) or not judged
+    kind = "skipped" if st == "no-base" else ("passed" if not busy else ("blocked" if mode == "block" else "warned"))
+    hard = kind == "blocked"
+    extra = {"check": "old-sentence", "state": st, "base_sha": base if isinstance(base, str) else "",
+             "code_files": res["code_files"], "candidates": res["candidates"],
+             "handle": len(handle) if judged else None, "listed": len(listed) if judged else None,
+             "unparsable": len(res["unparsable"]), "text_defs": len(res["text_defs"]),
+             "text_defs_paths": res["text_defs"][:3], "too_long": res["too_long"], "parsed": res["parsed"],
+             "cache_hits": res["cache_hits"], "rows_truncated": False}
+    if st == "done":
+        extra["rows"] = _drift_m1_rows(handle, 10) + _drift_m1_rows(listed, 3)
+    nodes = sorted({_esc_clean(f["path"][:-3], 10 ** 6) for f in handle})[:50] if judged else []
+    nodes = _drift_m1_fit(root, kind, note, hard, tip, nodes, extra)
+    if _gate_event_or_warn(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra) is False:
+        _drift_m1_ledger_miss(root, tip, st)
+
+
+def _drift_m1_report(root, mode, base, tip, vault_rel, res):
+    """m1 的結論行、發現、改法(全部 stderr)與治理帳 → rc_m1(block 而且要處理有筆數或判不了時 1,其他 0)。
+    state 是 None(範圍裡沒有改到程式檔)不印不記。"""
+    st = res["state"]
+    if st is None:
+        return 0
+    handle, listed = res["handle"], res["listed"]
+    if handle or listed:
+        acks = _drift_load_acks(root, tip)
+        handle, _h = _drift_split_acked(handle, acks, vault_rel)
+        listed, _l = _drift_split_acked(listed, acks, vault_rel)
+    busy = bool(handle) or st in _DRIFT_M1_UNKNOWN
+    line = _drift_m1_conclusion(res, len(handle), len(listed))
+    if busy:
+        line = "擋下:" + line if mode == "block" else "提醒:" + line + "(drift_check.old_sentence=warn,不擋)"
+    print(line, file=sys.stderr)
+    if mode == "block" and st in _DRIFT_M1_UNKNOWN:
+        print(_drift_unknown_hint("舊句檢查沒判完"), file=sys.stderr)
+    _drift_m1_print_extra(res)
+    _drift_m1_print_rows(res, handle, listed)
+    _drift_m1_ledger(root, mode, base, tip, res, (handle, listed), line)
+    return 1 if (busy and mode == "block") else 0
+
+
