 28666	def _drift_m1_shape_ok(name):
 28667	    """形狀過濾(逐字照參考實作 _shape_ok):旗標、路徑、.py 直接過;其他要 4 字以上,含底線或同時有大寫與小寫。"""
 28668	    if name.startswith("--") or "/" in name or name.endswith(".py"):
 28669	        return True
 28670	    return len(name) >= 4 and ("_" in name or (any(c.isupper() for c in name) and any(c.islower() for c in name)))
