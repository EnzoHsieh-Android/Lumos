 29394	    wired = hk is not None and hk.returncode == 0 and _DRIFT_GOLIVE_MARK in hk.stdout
 29395	    # 開關不是 block 時講一聲——只在專案自己寫了開關、或已經接線時(代碼審 r1 外家席:關掉了要看得見);
 29396	    # 還沒接線又沒寫設定時預設本來就是 warn,每個專案每次 doctor 都多一行只是噪音(代碼審 r3:那一行也破壞既有測試
 29397	    # t_doctor_summary_admits_soft_reminders 的軟段計數)
 29398	    if mode != "block" and (wired or explicit):
 29399	        src = (f"({cfg_warns[0]})" if cfg_warns else "(.lumos/config.json 的 drift_check)" if explicit
 29400	               else "(沒寫設定,這是預設值)")
 29401	        out.append(f"這個專案的存量漂移檢查是 {mode}{src}——轉正後留著預告句的推送不會被擋;"
 29402	                   f"舊句檢查(drift_check.old_sentence)是 {os_mode}")
 29403	    wf = root / ".github" / "workflows"
