 29328	    counts = {k: sum(1 for f in left if f["kind"] == k) for k in _DRIFT_SCAN_KINDS}
 29329	    print(f"存量漂移健檢({at or '工作目錄'}):" + "、".join(f"{k} {counts[k]}" for k in _DRIFT_SCAN_KINDS if k != "probe")
 29330	          + (f";已表態 {len(done)}" if done else ""))
