 24031	def _nodehome_cat_blobs(repo_root, specs, timeout=60):
 24032	    """一次讀很多個「版本:路徑」的內容,回同順序的 bytes|None(那個版本沒有這支檔就是 None);git 跑不起來回 None。
 24033	
 24034	    ★為什麼不照鄰居逐支 git show★(代碼審 r1 通才席量代價):成本在開 git 行程本身——200 支衝突檔的合併,
 24035	    每支三次讀取就是 600 個行程,實測 13.5 秒;用 git 內建的批次讀取(cat-file --batch)一個行程讀完。
 24036	    原始內容照讀、不經任何轉換程式。路徑裡有換行時批次讀取表達不了,整批當判不了。"""
 24037	    import subprocess as _sp
 24038	    if not specs:
 24039	        return []
 24040	    if any("\n" in s_ for s_ in specs):
 24041	        return None
 24042	    try:
 24043	        r = _sp.run(["git", "-C", str(repo_root), "cat-file", "--batch"],
 24044	                    input=("\n".join(specs) + "\n").encode("utf-8", "surrogateescape"),
 24045	                    capture_output=True, timeout=timeout)
 24046	    except (OSError, _sp.TimeoutExpired):
 24047	        return None
 24048	    if r.returncode != 0:
 24049	        return None
 24050	    out, pos, res = r.stdout, 0, []
 24051	    for _ in specs:
 24052	        nl = out.find(b"\n", pos)
 24053	        if nl < 0:
 24054	            return None
 24055	        head = out[pos:nl].split(b" ")
 24056	        pos = nl + 1
 24057	        if len(head) == 3 and head[1] == b"blob" and head[2].isdigit():
 24058	            size = int(head[2])
 24059	            res.append(out[pos:pos + size])
 24060	            pos += size + 1
 24061	        elif len(head) == 3 and head[2].isdigit():
 24062	            pos += int(head[2]) + 1     # 不是檔案(例如子模組、目錄)——內容跳過,當讀不到
 24063	            res.append(None)
 24064	        else:
 24065	            res.append(None)            # missing / ambiguous
 24066	    return res
