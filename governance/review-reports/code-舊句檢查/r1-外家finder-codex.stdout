 28673	def _drift_m1_name_ok(name):
 28674	    """名稱去頭尾空白後 1 到 200 字、不帶控制字元才列(表態 --name 收得下;刻意差異第 10 條)。"""
 28675	    s = name.strip()
 28676	    return 1 <= len(s) <= _DRIFT_M1_NAME_MAX and _esc_clean(name, 10 ** 6) == name
