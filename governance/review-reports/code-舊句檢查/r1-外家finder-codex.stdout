 34269	def _lens_cache_path(repo_root, base_sha, head_sha, extra=""):
 34270	    import hashlib
 34271	    # repo 部分用 realpath(跟 armed 檔的 _lens_repo_key 同一種算法;code-codex-s1 r1 架構席:兩套 key 並存)
 34272	    # extra=表態記錄的 sha256(表態閘 S8):重表態之後舊快取自然 miss
 34273	    key = hashlib.sha256(f"{os.path.realpath(str(repo_root))}|{base_sha}|{head_sha}|schema{_LENS_SCHEMA}|{extra}".encode("utf-8")).hexdigest()   # 帶 schema 版本:v1.1 舊快取自然 miss(v1.2 r2 外家)
 34274	    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / f"{key}.json"
 34275	
