 28726	def _drift_m1_paren_span(line, pos):
 28727	    """包住 pos 的最內層那對括號 (起, 迄);沒有括號包住、但最後一個沒關上的 ( 在 pos 前面 → (那個位置, 行尾);否則 None。"""
 28728	    opened, span = [], None
 28729	    for i, ch in enumerate(line):
 28730	        if ch in "(（":
 28731	            opened.append(i)
 28732	        elif ch in ")）" and opened:
 28733	            a = opened.pop()
 28734	            if a < pos < i and (span is None or a > span[0]):
 28735	                span = (a, i)
 28736	    if span is None and opened and opened[-1] < pos:
 28737	        span = (opened[-1], len(line))
 28738	    return span
