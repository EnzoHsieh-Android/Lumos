 28795	def _drift_m1_cache_dir():
 28796	    """定義快取目錄 ~/.cache/lumos/drift-defs/ → Path 或 None(建不了、不可信:當沒快取,也不寫不刪)。"""
 28797	    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-defs"):
 28798	        return None
 28799	    d = Path.home() / ".cache" / "lumos" / "drift-defs"
 28800	    return d if _trusted_private_dir(d, ".cache", "lumos", "drift-defs") else None
