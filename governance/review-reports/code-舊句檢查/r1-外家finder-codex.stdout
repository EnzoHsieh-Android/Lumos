+def _drift_m1_split_acked(findings, acks, vault_rel):
+    """m1 的表態比對:同路徑、同原文(去頭尾空白)、kind m1 的★所有★表態,names 取聯集;一筆發現的名稱集合是聯集的子集
+    才算已表態。沒有 names 欄或空清單的不涵蓋任何名稱。取聯集、不照 c2/c3 只看最新:m1 的名稱一旦為這一句原文表態過就不會變,
+    原文一改鍵就換了(Projects/舊句檢查_計劃〈做法〉3)。"""
+    cover = {}
+    for a in acks:
+        if a["kind"] == "m1" and isinstance(a.get("names"), list):
+            k = _drift_ack_key(a["path"], a.get("text", ""), "m1")
+            cover.setdefault(k, set()).update(str(x) for x in a["names"])
+    pre = vault_rel.rstrip("/") + "/"
+    left, done = [], []
+    for f in findings:
+        got = cover.get(_drift_ack_key(pre + f["path"], f["text"], "m1"), set())
+        (done if f["names"] and set(f["names"]) <= got else left).append(f)
+    return left, done
