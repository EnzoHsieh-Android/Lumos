 25296	def _note_shape_doctor_lines(repo_root, vault, ci=False):
 25297	    """lumos doctor 開頭的筆記形狀擋提醒(Projects/筆記形狀擋_計劃 [S8][S11]):
 25298	    ①開關不是 block 就講(照 node_home.gate 先例:關掉要看得見);②專案 CI 沒呼叫 note-shape --diff、
 25299	    或沒抓完整歷史(淺層 clone 算不出範圍)就給要貼的那一步——lumos update 不會動各專案的 CI 設定;
 25300	    ③上線點之後、已推上遠端卻違反兩條規則的新增行(抓 --no-verify 繞過)。"""
 25301	    out = []
 25302	    root = Path(repo_root)
 25303	    cp = root / ".lumos" / "config.json"
 25304	    txt = None
 25305	    try:
 25306	        # 整條路徑都要看:.lumos 資料夾本身是捷徑也不跟過去讀(同 _nodehome_config;代碼審 r1 架構對齊席)
 25307	        if cp.is_file() and not cp.is_symlink() and cp.resolve() == root.resolve() / ".lumos" / "config.json":
 25308	            txt = cp.read_bytes()
 25309	    except OSError:
 25310	        txt = None
 25311	    mode, _w = _note_shape_config(txt)
 25312	    if mode != "block":
 25313	        out.append(f"這個專案把「筆記形狀擋」設成 {mode}(.lumos/config.json 的 note_shape.gate)——新寫的程式行號引用、"
 25314	                   "沒寫來源的現況描述不會被擋")
 25315	    wf = root / ".github" / "workflows"
 25316	    ymls = sorted(list(wf.glob("*.yml")) + list(wf.glob("*.yaml"))) if wf.is_dir() else []
 25317	    if ymls:
 25318	        # 跳過註解:整行被註解掉的那步不算有呼叫(第二層早就這樣判;代碼審 r3 通才席:兩句判法不一,中間漏唸)
 25319	        body = "\n".join(ln for _p, ls in _ci_workflow_texts(ymls) for ln in ls)
 25320	        step = ("\n    - run: git fetch --no-tags origin '+refs/heads/*:refs/remotes/origin/*' && "
 25321	                "(git show-ref -q --verify refs/heads/main || git branch --track main origin/main || true) && "
 25322	                "python3 scripts/lumos note-shape --diff \"${{ github.event.before || '0000000000000000000000000000000000000000' }}..${{ github.sha }}\""
 25323	                "\n  (這步只在 push 事件跑(`if: github.event_name == 'push'`),pull_request 沒有前一版;checkout 要設 fetch-depth: 0;主分支叫 master 就把 main 換掉;建本地 main 是為了找得到主線:"
 25324	                "已在主線上的提交不重查,新分支首推(前一版是 40 個 0)或 force-push 後舊頂端找不到時,lumos 從跟主線的分岔點算)"
 25325	                + _CI_PY314_NOTE)
 25326	        if "note-shape --diff" not in body:
 25327	            out.append("專案 CI 沒呼叫 `lumos note-shape --diff`,`--no-verify` 推上去的筆記沒人擋——CI 貼這一步:" + step)
 25328	        else:
 25329	            shallow = _ci_jobs_calling_without_full_history(ymls, "note-shape --diff")
 25330	            if shallow:
 26790	        pos = m.end()
 26791	        key, val = m.group(1), m.group(2).strip()
 26792	        if key == "by":
 26793	            if by is not None:
 26794	                errs.append("期限寫了兩個")
 26795	                continue
 26796	            try:
 26797	                datetime.date.fromisoformat(val)
 26798	                by = val
 26799	            except ValueError:
 26800	                errs.append(f"期限 [by:{val}] 不是 YYYY-MM-DD")
 26801	            continue
 26802	        k = key[len("when-"):]
 26803	        # 反斜線先轉斜線再驗(代碼審 r3 正確性席:`a\..\x.py` 原本收成 x.py 過關,字面相同的 `a/../x.py` 卻被擋)
 26804	        err = _probe_value_err(k, val.replace("\\", "/") if k in ("file", "symbol", "test") else val)
 26805	        nv = val if err else _probe_norm_value(k, val)
 26806	        # 正規化之後再驗一次(代碼審 r2 正確性席、邊界席:`..\x.py` 原文用 / 切不出 .. 段,轉成斜線才是 ../x.py,
 26807	        # 原本第一層放行、check 與 scan 又默默丟掉,變成沒人看得到的死條件)
 26808	        err = err or _probe_value_err(k, nv)
 26809	        if err:
 26810	            errs.append(err)
 26811	            bad = True
 26812	        conds.append((k, val if err else nv))
 26813	    if not conds:
 26814	        errs.append("沒有條件標記")
 26815	    # bad:有條件寫錯——check 與 scan 看這個旗標決定評不評估,不拿存下來的值重驗(代碼審 r3 正確性席:寫錯的條件存的是
 26816	    # 原文,原文重驗可能過關,寫錯的行照樣被評估);只缺期限不算 bad,照評估
 26817	    return {"conds": conds, "by": by, "errs": errs, "bad": bad}
