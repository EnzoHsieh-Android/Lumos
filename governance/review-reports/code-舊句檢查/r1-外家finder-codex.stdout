 28569	def _drift_report_must(root, mode, must, unknown, acks, alive=None):
 28570	    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
 28571	    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
 28572	    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
 28573	    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
 28574	    for u in unknown:
 28575	        print(_drift_unknown_hint(u), file=sys.stderr)
 28576	    _drift_print_findings(must, sys.stderr, acks, alive)
 28577	    kinds = {f["kind"] for f in must}
 28578	    # 改法指令由 _drift_fix_hint 單一產生(存量漂移改法 [S10]):c1 到 c5 指到 lumos drift fix(c1 一篇一條),
 28579	    # 條件式回頭條件(probe)的修法不一樣,同一支給它自己的說法
 28580	    _drift_print_hints(must, sys.stderr, "改法(每一筆一條指令;c1 一篇一條):")
 28581	    if must:
 28582	        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
 28583	        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
 28584	        for k in sorted(kinds):
 28585	            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
 28586	    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
 28587	    if mode == "block":
 28588	        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
 28589	                            nodes=sorted({f["path"][:-3] for f in must})[:50])
 28590	        return 1
 28591	    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
 28592	    return 0
