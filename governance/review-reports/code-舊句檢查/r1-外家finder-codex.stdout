 34296	def _home_cache_write(subdir, path, data):
 34297	    """~/.cache/lumos/<subdir>/ 底下的快取原子寫入(同目錄 mkstemp 唯一暫存名、chmod 0600、os.replace);回有沒有寫進去。
 34298	    ★寫入端也要驗目錄★(2026-09-06 全 repo 審視 #6):原本直接 mkdir + chmod(0700),
 34299	    目錄若被換成指向別處的 symlink,就會把**別人的目錄**權限改掉。讀取端一直都有檢查,
 34300	    寫入端沒有——現在兩邊都走同一支 _trusted_private_dir。不過關就靜默不寫(fail-open)。"""
 34301	    import json as _json, tempfile as _tf
 34302	    try:
 34303	        # ★逐層建、逐層檢查★(2026-09-16):原本一次 mkdir 出整條路徑再檢查,
 34304	        # 檢查不過時連結指到的地方已經被建出一層空資料夾了。
 34305	        if not _mkdir_trusted_under_home(".cache", "lumos", subdir):
 34306	            return False
 34307	        if not _trusted_private_dir(path.parent, ".cache", "lumos", subdir):
 34308	            return False
 34309	        os.chmod(path.parent, 0o700)
 34310	        fd, tmp = _tf.mkstemp(dir=str(path.parent), suffix=".tmp")
 34311	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
 34312	            fh.write(_json.dumps(data, ensure_ascii=False))
 34313	        os.chmod(tmp, 0o600)
 34314	        os.replace(tmp, path)
 34315	        return True
 34316	    except OSError:
 34317	        return False
