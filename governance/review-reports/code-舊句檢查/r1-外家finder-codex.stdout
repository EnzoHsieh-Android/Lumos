 26928	def _drift_py_def_re(name, test):
 26929	    """解析不了的 Python 檔退回逐行正則(寧可多認一次,也不讓一支語法壞掉的檔讓整批條件判不了)。"""
 26930	    n = re.escape(name)
 26931	    if test:
 26932	        return re.compile(rf"^[ \t]*(?:async[ \t]+)?def[ \t]+{n}\b", re.M)
 26933	    return re.compile(rf"^(?:[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+{n}\b|{n}[ \t]*(?::[^=\n]*)?=(?!=))", re.M)
 26934	
