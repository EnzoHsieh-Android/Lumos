 28679	def _drift_m1_banner(line):
 28680	    """撤除行:去掉開頭空白後第一個字是 > ( (,含撤除字樣、不命中「尚未/還沒/未 + 撤除字樣」(照參考實作 _is_banner)。"""
 28681	    s = line.strip()
 28682	    if not s or s[0] not in ">(（" or _DRIFT_M1_NOT_YET_RE.search(s):
 28683	        return False
 28684	    return any(w in s for w in _DRIFT_M1_RETIRE_WORDS)
 28685	
 28686	
 28687	def _drift_m1_retire_heads(lines, regs, vis):
 28688	    """撤除節①:任何層級小標題後第一個非空行是撤除行 → 整節連同子節不看(照參考實作 Note.ret_full)。"""
 28689	    n = len(lines)
 28690	    full, stack = [False] * (n + 1), []
 28691	    for i, ln in enumerate(lines):
 28692	        m = _DRIFT_M1_HEAD_RE.match(ln) if regs[i] == "body" and (i + 1) in vis else None
 28693	        if m:
 28694	            lvl = len(m.group(1))
 28695	            while stack and stack[-1][0] >= lvl:
 28696	                stack.pop()
 28697	            j = i + 1
 28698	            while j < n and not lines[j].strip():
 28699	                j += 1
 28700	            stack.append((lvl, _drift_m1_banner(lines[j] if j < n else "")))
 28701	        if regs[i] == "body":
 28702	            full[i + 1] = any(s[1] for s in stack)
 28703	    return full
 28704	
 28705	
 28706	def _drift_m1_retired(lines, regs, vis):
 28707	    """每一行(行號 1 起)在不在撤除節裡:①節開頭撤除行;②節內 > 開頭、同一行含撤除字樣與範圍宣告字的撤除行,
 28708	    從那一行到節尾(下一個同層或更高層標題之前,含子節)。照參考實作 P4r3 的 ret_full3。"""
 28709	    out = _drift_m1_retire_heads(lines, regs, vis)
 28710	    lvl_now, marks = 0, []
 28711	    for i, ln in enumerate(lines):
 28712	        if regs[i] != "body" or (i + 1) not in vis:
 28713	            continue
 28714	        m = _DRIFT_M1_HEAD_RE.match(ln)
 28715	        if m:
 28716	            lvl_now = len(m.group(1))
 28717	            marks = [(a, lv) for a, lv in marks if lv < lvl_now]
 28718	            continue
 28719	        if ln.lstrip().startswith(">") and _drift_m1_banner(ln) and any(w in ln for w in _DRIFT_M1_SCOPE_WORDS):
 28720	            marks.append((i + 1, lvl_now))
 28721	        if marks:
 28722	            out[i + 1] = True
 28723	    return out
 28724	
