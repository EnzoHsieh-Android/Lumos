 28638	def _drift_m1_code_path(p):
 28639	    """True = 不在排除清單內、可能是程式檔(對不是 .md 的路徑,等於參考實作的 not _excluded(p);t_drift_m1_code_path_scope 逐一釘)。
 28640	    排除:docs/、governance/ 開頭;開頭或任何 / 之後的建置目錄;lock 檔;.md。"""
 28641	    return not (p.startswith(_DELGUARD_PROSE_DIRS) or p.endswith(".md") or p.endswith(_DELGUARD_EXCLUDE_LOCKFILES)
 28642	                or any(p.startswith(s) or ("/" + s) in p for s in _DELGUARD_EXCLUDE_DIRS))
 28643	
