 28821	def _drift_m1_cache_evict(d):
 28822	    """開跑前刪掉 mtime 超過保鮮期的檔(讀不更新 mtime);目錄不可信(d 是 None)一支都不碰。"""
 28823	    if d is None:
 28824	        return
 28825	    try:
 28826	        ents = list(d.iterdir())
 28827	    except OSError:
 28828	        return
 28829	    for f in ents:
 28830	        try:
 28831	            if f.is_file() and not f.is_symlink() and time.time() - f.stat().st_mtime > _DRIFT_M1_DEFS_TTL:
 28832	                f.unlink()
 28833	        except OSError:
 28834	            pass
