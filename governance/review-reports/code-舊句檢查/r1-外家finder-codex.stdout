 28656	def _drift_m1_text_defs(txt, loose=False):
 28657	    """剖不動或太大的檔:一條正則掃一次抽定義名與 add_argument 的引號旗標。loose=True(終點語料用)另收引號裡的 --旗標 字樣。
 28658	    認不到拆包、縮排的類別層指派、沒給值的型別標註;三引號字串裡行首的 def 會被當定義(〈誠實界線〉)。"""
 28659	    out = {m.group(1) or m.group(2) for m in _DRIFT_M1_TEXT_DEF_RE.finditer(txt)}
 28660	    out.update(m.group(2) for m in _DRIFT_M1_TEXT_FLAG_RE.finditer(txt))
 28661	    if loose:
 28662	        out.update(m.group(2) for m in _DRIFT_M1_QUOTED_FLAG_RE.finditer(txt))
 28663	    return out
