 28546	        print("存量漂移檢查:c1\u2013c5 與回頭條件關掉了(drift_check.gate=off);舊句檢查另有開關 drift_check.old_sentence,"
 28547	              "有改到程式檔時照跑" if os_mode != "off" else
 28548	              "存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
 28549	        return 0
 28550	    if isinstance(base, tuple):       # 推送起點算不出來:判不了,算要處理(block 擋、warn 印)
 28551	        must, listed, unknown = [], [], [f"推送範圍的起點算不出來({base[1]})"]
 28552	    else:
 28553	        must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
 28554	                                                  deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
 28555	    acks = _drift_load_acks(root, tip)
 28556	    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
 28557	    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
 28558	    lst = _nodehome_list(root, tip)
 28559	    alive = set(lst[1]) if lst else None
 28560	    if listed:
 28561	        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
 28562	        _drift_print_findings(listed, sys.stderr, acks, alive)
 28563	        _drift_print_hints(listed, sys.stderr)
 28564	    if not must and not unknown:
 28565	        return 0
 28566	    return _drift_report_must(root, mode, must, unknown, acks, alive)
