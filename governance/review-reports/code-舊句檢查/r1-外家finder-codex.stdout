 28741	def _drift_m1_clause_hist(line, pos):
 28742	    """名稱所在那一句有沒有歷史字眼(逐字照參考實作 _clause_has_hist):括號內只看括號內;括號外先把「裡面沒有括號的
 28743	    括號對」整對遮掉;再用 。;;!?!? 切,取名稱所在那一小段(英文句點不切)。"""
 28744	    span = _drift_m1_paren_span(line, pos)
 28745	    if span is not None:
 28746	        seg, rel = line[span[0] + 1:span[1]], pos - span[0] - 1
 28747	    else:
 28748	        seg, rel = re.sub(r"[(（][^()（）]*[)）]", lambda m: "\0" * len(m.group(0)), line), pos
 28749	    cuts = [m.end() for m in _DRIFT_M1_CUT_RE.finditer(seg) if m.end() <= rel]
 28750	    m2 = _DRIFT_M1_CUT_RE.search(seg[rel:])
 28751	    clause = seg[(cuts[-1] if cuts else 0):(rel + m2.start() if m2 else len(seg))]
 28752	    return bool(_DRIFT_M1_HIST_RX.search(clause))
 28753	
