 28595	# ── 舊句檢查 m1(Projects/舊句檢查_計劃;家 [[Systems/存量漂移守衛]])─────────────────────────────────
 28596	# 程式裡的名稱(函式、類別、指派、旗標、被刪的程式檔路徑)這次推送消失了,筆記還在講它的句子。判法逐字照參考實作
 28597	# governance/eval/drift-exam/old-sentence/old_sentence_exp.py 的 P4r3;跟它刻意不同的地方只有計劃〈與參考實作的刻意差異〉
 28598	# 那幾條(程式檔清單、剖不動與太大的檔用文字抽定義、去 BOM、讀不出的筆記、空樹起點、時間上限與快取、名稱太長不列)。
 28599	# 判定另開一支、不放進 _drift_check_core(那支也給考試與歷史重放用,放進去會改掉既有噪音基準)。
 28600	_DRIFT_M1_DEFS_SCHEMA = 1                       # 抽法(_drift_py_names m1、_drift_m1_text_defs)一改就加一:舊快取自然不命中
 28601	_DRIFT_M1_PARSE_MAX_BYTES = 4 * 1024 * 1024     # 大於它的 blob 不用 ast(尖峰記憶體約原始碼 100 到 280 倍),改文字抽定義
 28602	_DRIFT_M1_BUDGET_SEC = 30                       # m1 自己的截止時間,不吃 c1 到 c5 與 probe 剩下的
 28603	_DRIFT_M1_DEFS_TTL = 14 * 86400                 # 定義快取保鮮期(值同 bound-filter 的 _FILTER_PROBE_TTL)
 28604	_DRIFT_M1_PREFILTER_MIN = 200                   # 候選名稱超過這個數才先篩(先篩不改結果,只影響時間)
 28605	_DRIFT_M1_NAME_MAX = 200                        # 候選名稱與表態 --name 的長度上限
 28606	# 句內歷史字眼 54 個:符號檢查否定詞 26 個(抄自 NEG_LEXICONS["zh"] 當時的內容,★不引用它★:那份為符號檢查自己的理由增減,
 28607	# m1 的準度是對這 54 個量的)+ 25 個 + 3 個詞組。ASCII 字眼整字比、大小寫敏感;中文照子字串比。
 28608	_DRIFT_M1_HIST_WORDS = (
 28609	    "零命中", "已移除", "不存在", "查無", "已刪", "從未", "已退役", "移除", "無此", "原記", "舊名", "改名", "已改", "棄用",
 28610	    "不使用", "廢棄", "停用", "未使用", "dead", "removed", "deleted", "no longer", "renamed", "deprecated", "unused",
 28611	    "obsolete",
 28612	    "撤除", "撤掉", "拿掉", "原寫", "原本", "原先", "不再", "舊版", "舊的", "刪除", "刪掉", "取代", "搬到", "搬去", "改為",
 28613	    "改叫", "改成", "曾", "前身", "撤", "刪", "拔掉", "去掉", "不帶", "沒有",
 28614	    "當時叫", "擴成", "改名為")
 28615	_DRIFT_M1_HIST_RX = re.compile("|".join(
 28616	    (r"(?<![A-Za-z0-9_])" + re.escape(w) + r"(?![A-Za-z0-9_])") if w.isascii() else re.escape(w)
 28617	    for w in sorted(set(_DRIFT_M1_HIST_WORDS), key=len, reverse=True)))
 28618	_DRIFT_M1_RETIRE_WORDS = ("撤除", "撤掉", "作廢", "已失效", "已過時", "不是現況", "被取代", "已凍結", "superseded",
 28619	                          "已結案", "歷史紀錄", "Superseded")
 28620	_DRIFT_M1_NOT_YET_RE = re.compile(r"(尚未|還沒|未)(撤除|撤掉|作廢|失效|取代|凍結|結案)")
 28621	_DRIFT_M1_SCOPE_WORDS = ("下面", "以下", "本節", "這一節", "整篇", "之後")
 28622	_DRIFT_M1_HEAD_RE = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
 28623	_DRIFT_M1_CUT_RE = re.compile(r"[。;；!?！？]")
 28624	# 文字抽定義:跟 _drift_py_def_re(name, test=False) 同一組形狀(任何縮排的 def/class/async def,不縮排的「名 =」
 28625	# 「名: 型別 = 值」),加 add_argument( 後面緊接的引號旗標;t_drift_m1_unparsable_files 釘兩者對同一批名稱判斷一致
 28626	_DRIFT_M1_TEXT_DEF_RE = re.compile(r"^[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+(\w+)|^(\w+)[ \t]*(?::[^=\n]*)?=(?!=)", re.M)
 28627	_DRIFT_M1_TEXT_FLAG_RE = re.compile(r"add_argument\(\s*(['\"])(--[^'\"\n]*)\1")
 28628	_DRIFT_M1_QUOTED_FLAG_RE = re.compile(r"(['\"])(--[A-Za-z0-9][\w-]*)\1")
 28629	_DRIFT_M1_UNKNOWN = ("timeout", "git-failed", "unreadable")
 28630	_DRIFT_M1_NOTE_REGIONS = ("body", "summary", "decisions")
