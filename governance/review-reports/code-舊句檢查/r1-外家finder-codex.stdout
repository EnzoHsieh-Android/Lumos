 26954	def _drift_list(root, where):
 26955	    """_nodehome_list 加記憶:同一個提交的樹一次 check 裡只列一次(代碼審 r1 併發席:終點列 2 次、起點列 3 次)。
 26956	    只記完整提交編號(內容不會變;SHA-1 的 40 碼與 SHA-256 的 64 碼都算——r4 外家席:原本只認 40 碼,SHA-256 的 repo
 26957	    記不到內容編號、退回用路徑讀,怪檔名又讀不到);index 與其他寫法照舊每次列。"""
 26958	    if not (isinstance(where, str) and _LENS_SHA_RE.fullmatch(where)):
 26959	        return _nodehome_list(root, where)
 26960	    key = (str(root), where)
 34250	def _lens_dispositions_lines(lines, rec):
 34251	    """派工鏡頭附表態記錄(表態閘 S8):只列人答的題(未觸發自動 na 只給個數);工具驗過錨點存在、沒驗答案對不對——審查席反駁的就是這些答案。回人答題數。"""
 34252	    disp = rec.get("dispositions") or {}
 34253	    human = [(q, e) for q, e in disp.items() if isinstance(e, dict) and not e.get("auto")]
 34254	    n_auto = sum(1 for e in disp.values() if isinstance(e, dict) and e.get("auto"))
 34255	    lines.append(f"[表態記錄(棧別效能檢核;分支 {rec.get('branch')},版本 {str(rec.get('head_sha') or '')[:8]})——寫入時工具只驗了形狀,證據存不存在要到推送前 code-loop check 才驗,答案對不對沒人驗]")
 34256	    for q, e in human:
 34257	        st = e.get("status")
 34258	        tail = (str(e.get("evidence") or "") if st == "satisfied"
 34259	                else (str(e.get("issue") or "") + " " + str(e.get("reason") or "")) if st == "todo"
 34260	                # tension 四欄都給審查席看——反駁的就是這四欄(2026-09-09 兩席相反時端出張力;「｜」分隔是編排者裁的,四欄需要分隔)
 34261	                else (f"選 {e.get('chosen') or ''}｜既有 {', '.join(str(x) for x in (e.get('existing') or []))}｜隱患 {e.get('hazard') or ''}｜建議 {e.get('suggestion') or ''}") if st == "tension"
 34262	                else str(e.get("reason") or ""))   # 全部 str(… or ""):治理帳重建來的紀錄不重驗形狀,缺欄不能炸(r1 正確性席 f3)
 34263	        lines.append(f"  {q} {st} — {str(tail)[:200]}")
 34264	    if n_auto:
 34265	        lines.append(f"  (另有 {n_auto} 題未觸發、工具自動記不適用)")
 34266	    return len(human)
