        extra["rows_truncated"] = True
    if len(nodes) > 20 and size() > 4096:
        nodes = nodes[:20]
        extra["rows_truncated"] = True
    return nodes


def _drift_m1_ledger_miss(root, tip, state):
    """治理帳寫不進去時的留痕:~/.cache/lumos/drift-m1/ledger-miss.jsonl 追加一行(REVISIT 讀它算樣本不足)。"""
    import json as _j, datetime as _dt
    if not _mkdir_trusted_under_home(".cache", "lumos", "drift-m1"):
        return False
    d = Path.home() / ".cache" / "lumos" / "drift-m1"
    if not _trusted_private_dir(d, ".cache", "lumos", "drift-m1"):
        return False
    line = _j.dumps({"ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                     "repo": _drift_m1_show(os.path.realpath(str(root))), "head_sha": tip, "state": state},
                    ensure_ascii=False) + "\n"
    try:
        # O_NONBLOCK:有人在這裡放了同名 FIFO 時開檔不會卡住推送(沒有讀端就直接失敗);開了再確認是自己的一般檔
        # (代碼審 r2 邊界席)
        fd = os.open(str(d / "ledger-miss.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
                     | getattr(os, "O_NONBLOCK", 0), 0o600)
        try:
            import stat as _stat
            fst = os.fstat(fd)
            if not _stat.S_ISREG(fst.st_mode) or (hasattr(os, "getuid") and fst.st_uid != os.getuid()):
                return False
            data = line.encode("utf-8")
            if os.write(fd, data) != len(data):   # 比照 _ledger_append:短寫(磁碟滿)不算寫成
                return False
        finally:
            os.close(fd)
        return True
    except OSError:
        return False
                                 "names": ["old_name_x"], "text": "呼叫 old_name_x。"}], str(e))
    _nh_file(root, "src/a.py", "x = 1\n")
    tip2 = _m1_commit(root, "del resolve")
    rc, out = _m1_run(root, f"{tip}..{tip2}")
    e = _m1_events(root)[-1]
