 57563	def t_drift_m1_review_r3_ledger_miss_short_write():
 57564	    """代碼審 r3 架構對齊-F1:留痕檔追加比照 _ledger_append 驗整行寫完,短寫(磁碟滿)回 False、不當成寫成。
 57565	
 57566	    翻紅釘:不驗 os.write 的回傳長度 → ①紅。
 57567	    """
 57568	    print("t_drift_m1_review_r3_ledger_miss_short_write")
 57569	    import os as _o
 57570	    m = _load_lumos_inproc()
 57571	    h = Path(tempfile.mkdtemp())
