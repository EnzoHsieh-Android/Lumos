def _drift_m1_clause_hist(line, pos):
    """名稱所在那一句有沒有歷史字眼(逐字照參考實作 _clause_has_hist):括號內只看括號內;括號外先把「裡面沒有括號的
    括號對」整對遮掉;再用 。;;!?!? 切,取名稱所在那一小段(英文句點不切)。"""
    span = _drift_m1_paren_span(line, pos)
    if span is not None:
        seg, rel = line[span[0] + 1:span[1]], pos - span[0] - 1
    else:
        seg, rel = re.sub(r"[(（][^()（）]*[)）]", lambda m: "\0" * len(m.group(0)), line), pos
    cuts = [m.end() for m in _DRIFT_M1_CUT_RE.finditer(seg) if m.end() <= rel]
    m2 = _DRIFT_M1_CUT_RE.search(seg[rel:])
    clause = seg[(cuts[-1] if cuts else 0):(rel + m2.start() if m2 else len(seg))]
    return bool(_DRIFT_M1_HIST_RX.search(clause))


def _drift_m1_name_rx(names):
    """整字比對的一條正則(逐字照參考實作 _mk_rx):一般識別字前後不能緊接 ASCII 英數底線;旗標、路徑、帶 . 的前面不能緊接
    ASCII 英數、底線、/ . -,後面不能緊接 ASCII 英數、底線、-。一般識別字那組在前、組內長的在前。"""
    ids = sorted((n for n in names if not n.startswith("--") and "/" not in n and "." not in n), key=len, reverse=True)
    idset = set(ids)
    others = sorted((n for n in names if n not in idset), key=len, reverse=True)
    parts = []
    if ids:
        parts.append(r"(?<![A-Za-z0-9_])(?:" + "|".join(map(re.escape, ids)) + r")(?![A-Za-z0-9_])")
    if others:

