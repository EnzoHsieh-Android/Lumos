        if isinstance(d, dict):
            out.append(d)
    return out


def _drift_load_acks(root, where=None):
    """表態檔 → [dict]。where=None 讀工作目錄;給提交讀那個提交的樹(check 只認這個,照第二層「判定檔要提交才算」)。"""
    raw = None
    if where is None:
        fp = Path(root) / _DRIFT_ACKS
        try:
            raw = fp.read_bytes() if fp.is_file() and not fp.is_symlink() else None
        except OSError:
            raw = None
    else:
        bl = _nodehome_cat_blobs(root, [f"{where}:{_DRIFT_ACKS}"])
        raw = bl[0] if bl else None
    return [d for d in _drift_jsonl_parse(raw) if d.get("path") and d.get("kind") in _DRIFT_KINDS]


def _drift_ack_key(path, text, kind):
    return (nfc(str(path)), str(text).strip(), kind)


def _drift_split_acked(findings, acks, vault_rel):
    """→ (沒表態的, 已表態的)。對得上=同一路徑、一字不差的原文、同一種類(改小標題不失效)。
    ★c2、c3 另外要綁當時的關係★(存量漂移改法 [S8]):只看記了 related 的表態,取 seq 最大的那幾筆(同號全算),
    全部都涵蓋現在的已收尾計劃清單才算已表態;沒記 related 的舊表態、seq 不是正整數的(手改壞了)都不算數
    (不然會永久豁免之後才收尾的計劃;壞序號原本被當成 0 號照樣生效,代碼審 r1 外家席)。
    沒涵蓋但以前表態過的,沒表態那一邊的發現多帶 prev_ack(最近一次當時連著哪幾篇、理由),印的時候講出來。
    ★m1 另一條分支★(_drift_m1_split_acked;m1 不放進 _DRIFT_BOUND_KINDS):同路徑同原文所有 m1 表態的名稱取聯集。"""
    if any(f["kind"] == "m1" for f in findings):
        l1, d1 = _drift_m1_split_acked([f for f in findings if f["kind"] == "m1"], acks, vault_rel)
        l2, d2 = _drift_split_acked([f for f in findings if f["kind"] != "m1"], acks, vault_rel)
    每次 doctor 全名單重喊)跨 commit 折疊 ×N、同群 >6 節點收單行摘要;--full 回完整逐筆。"""
    import json
    import datetime
    docs = env.vault.parent
    cutoff = (datetime.date.today() - datetime.timedelta(days=since_days)).isoformat()

    def stem(s):
        return Path(str(s)).stem.lower()

    rows = []
    loaded = []          # --stats 要印「本次實際載入哪幾源」(ci 帳是條件載入,非固定六本)

    def load(name, mapper):
        p = docs / name
        if not p.exists():
            return
        loaded.append(name.lstrip(".").replace("-log.jsonl", "").replace(".jsonl", ""))
        for line in p.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(mapper(json.loads(line)))
            except (ValueError, KeyError):
                continue

    load(".bypass-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": "L2", "kind": "bypassed", "hard": False, "nodes": [], "detail": d.get("subject", "")})
    # .rot-queue.jsonl(L3)2026-08-22 拆出:寫帳的 verification-rot-check 8/21 已撤,本機也沒有這個檔;留 loader 只是假名額。
    load(".governance-log.jsonl", lambda d: {"ts": d.get("ts", ""), "commit": d.get("commit", ""),
         "gate": d.get("gate", "?"), "kind": d.get("kind", "?"), "hard": bool(d.get("hard")),
         "nodes": [stem(x) for x in d.get("nodes", [])], "detail": d.get("note", ""),
         # 審查有沒有用記帳(2026-09-09):記帳被寫側擋下(canary/blocked)每次各算一筆——同一個 commit 連撞三次
         # 本來會被 (commit,nodes,gate,kind) 折成一次,「擋下 N 次」就永遠是 1;拿 ts+note(note 含事件隨機碼)當第 5 鑑別子(同秒也分得開,r1 f5)
         # 表態閘(2026-09-09,r3 接手席 H1):同 sha 兩筆 dispositions / recall-miss 各算各的——鑑別子拿 written_at(事件時間,微秒),
