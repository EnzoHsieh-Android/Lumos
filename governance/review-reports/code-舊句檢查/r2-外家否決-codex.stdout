def cmd_drift_check(repo=None, diff_range=None, push_remote=None, pushed_ref=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。
    帶 --push-remote 與 --pushed-ref(推送前掛鉤與 CI 用,要一起給,只給一個回 2):A 當成遠端舊值,起點由
    _push_range_start 算,git 查詢失敗算不出起點時照「判不了」處理;都沒帶照共用起點判法(_lens_push_base),行為不變。"""
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1
        print("存量漂移檢查:LUMOS_SKIP_DRIFT_CHECK 設了,這次跳過(已記進治理帳;CI 照查)", file=sys.stderr)
        _gate_event_or_warn(root, "drift-check", "skipped-env", "LUMOS_SKIP_DRIFT_CHECK")
        return 0
    if (push_remote is None) != (pushed_ref is None):
        # 只給一個會算錯(r3 外家 finder:只給遠端名時不知道推的是哪條,推主線本身會被判成「頂端已在主線」整步跳過)
        print("擋下:--push-remote 與 --pushed-ref 要一起給(推送前掛鉤與 CI 用;手動跑兩個都不給)", file=sys.stderr)
        return 2
    push = None if push_remote is None else (push_remote, pushed_ref)
    base, tip, vault_rel = _note_audit_resolve(root, diff_range, "存量漂移檢查", gate="drift-check",
                                               mark=_DRIFT_GOLIVE_MARK, push=push)
    if tip is None or isinstance(tip, int):
        return tip if isinstance(tip, int) else 0
    mode, warns, _explicit, os_mode = _drift_config(_nodehome_reader(root, tip)(".lumos/config.json"))
    for w in warns:
        print(f"提醒:{w}", file=sys.stderr)
    # 兩個開關各管各的(Projects/舊句檢查_計劃〈做法〉3):c1 到 c5 與 probe 看 gate,舊句檢查 m1 看 old_sentence;回兩邊較大的
    rc_core = _drift_check_c(root, mode, os_mode, base, tip, vault_rel)
    if os_mode == "off":
        return rc_core
    return max(rc_core, _drift_m1_guarded(root, os_mode, base, tip, vault_rel))


def _drift_check_c(root, mode, os_mode, base, tip, vault_rel):
    """drift check 的 c1 到 c5 與 probe 那段(原本 cmd_drift_check 的後半)→ rc_core。gate=off 時不跑、回 0。"""
    import time as _t
    if mode == "off":
        print("存量漂移檢查:c1\u2013c5 與回頭條件關掉了(drift_check.gate=off);舊句檢查另有開關 drift_check.old_sentence,"
              "有改到程式檔時照跑" if os_mode != "off" else
              "存量漂移檢查:這個專案把這道檢查關掉了(drift_check.gate=off),跳過", file=sys.stderr)
        return 0
    if isinstance(base, tuple):       # 推送起點算不出來:判不了,算要處理(block 擋、warn 印)
        must, listed, unknown = [], [], [f"推送範圍的起點算不出來({base[1]})"]
    else:
        must, listed, unknown = _drift_check_core(root, base, tip, vault_rel,
                                                  deadline=_t.monotonic() + _DRIFT_BUDGET_SEC)
    acks = _drift_load_acks(root, tip)
    must, _acked_m = _drift_split_acked(must, acks, vault_rel)
    listed, _acked_l = _drift_split_acked(listed, acks, vault_rel)
    lst = _nodehome_list(root, tip)
    alive = set(lst[1]) if lst else None
    if listed:
        print(f"存量漂移檢查:這次推送碰到 {len(listed)} 處跟狀態對不上的筆記(只列出,不擋):", file=sys.stderr)
        _drift_print_findings(listed, sys.stderr, acks, alive)
        _drift_print_hints(listed, sys.stderr)
    if not must and not unknown:
        return 0
    return _drift_report_must(root, mode, must, unknown, acks, alive)


def _drift_report_must(root, mode, must, unknown, acks, alive=None):
    """drift check 有要處理(或判不了)時:印、記帳、回 rc(block 1、warn 0)。"""
    head = "擋下" if mode == "block" else "提醒(drift_check.gate=warn,不擋)"
    what = "、".join(x for x in ((f"{len(must)} 處要處理" if must else ""), (f"{len(unknown)} 項判不了" if unknown else "")) if x)
    print(f"{head}:這次推送有 {what}(存量漂移檢查)——", file=sys.stderr)
    for u in unknown:
        print(_drift_unknown_hint(u), file=sys.stderr)
    _drift_print_findings(must, sys.stderr, acks, alive)
    kinds = {f["kind"] for f in must}
    # 改法指令由 _drift_fix_hint 單一產生(存量漂移改法 [S10]):c1 到 c5 指到 lumos drift fix(c1 一篇一條),
    # 條件式回頭條件(probe)的修法不一樣,同一支給它自己的說法
    _drift_print_hints(must, sys.stderr, "改法(每一筆一條指令;c1 一篇一條):")
    if must:
        # 一種一行(代碼審 r2 正確性席、圖譜一致席、外家席:原本兩種都有時印成 --kind c1|probe,照貼 shell 會當成管線)
        print("不改就留著並表態(--kind 照那一筆列的種類):", file=sys.stderr)
        for k in sorted(kinds):
            print(f"    lumos drift ack <節點> <行號> --kind {k} --reason \"<為什麼照留>\"", file=sys.stderr)
    note = f"要處理 {len(must)} 筆" + (f",判不了:{';'.join(unknown)}" if unknown else "")
    if mode == "block":
        _gate_event_or_warn(root, "drift-check", "blocked", note, hard=True,
                            nodes=sorted({f["path"][:-3] for f in must})[:50])
        return 1
    _gate_event_or_warn(root, "drift-check", "warned", note + "(warn 模式不擋)")
    return 0


# ── 舊句檢查 m1(Projects/舊句檢查_計劃;家 [[Systems/存量漂移守衛]])─────────────────────────────────
# 程式裡的名稱(函式、類別、指派、旗標、被刪的程式檔路徑)這次推送消失了,筆記還在講它的句子。判法逐字照參考實作
# governance/eval/drift-exam/old-sentence/old_sentence_exp.py 的 P4r3;跟它刻意不同的地方只有計劃〈與參考實作的刻意差異〉
# 那幾條(程式檔清單、剖不動與太大的檔用文字抽定義、去 BOM、讀不出的筆記、空樹起點、時間上限與快取、名稱太長不列)。
# 判定另開一支、不放進 _drift_check_core(那支也給考試與歷史重放用,放進去會改掉既有噪音基準)。
_DRIFT_M1_DEFS_SCHEMA = 1                       # 抽法(_drift_py_names m1、_drift_m1_text_defs)一改就加一:舊快取自然不命中
_DRIFT_M1_PARSE_MAX_BYTES = 4 * 1024 * 1024     # 大於它的 blob 不用 ast(尖峰記憶體約原始碼 100 到 280 倍),改文字抽定義
_DRIFT_M1_BUDGET_SEC = 30                       # m1 自己的截止時間,不吃 c1 到 c5 與 probe 剩下的
_DRIFT_M1_DEFS_TTL = 14 * 86400                 # 定義快取保鮮期(值同 bound-filter 的 _FILTER_PROBE_TTL)
_DRIFT_M1_PREFILTER_MIN = 200                   # 候選名稱超過這個數才先篩(先篩不改結果,只影響時間)
_DRIFT_M1_NAME_MAX = 200                        # 候選名稱與表態 --name 的長度上限
# 單行長度上限:比對一行的時間約「行長 × 這一行可能命中的名稱數」,中間沒辦法看截止時間;超過的行不掃、計數寫進結論行與帳。
# 值取兩份圖譜(工具鏈、rtb 全部筆記,2026-09-30 量)最長一行 10003 字的兩倍,一般筆記碰不到(代碼審 r1 資安席、邊界席)
_DRIFT_M1_LINE_MAX = 20000
# 句內歷史字眼 54 個:符號檢查否定詞 26 個(抄自 NEG_LEXICONS["zh"] 當時的內容,★不引用它★:那份為符號檢查自己的理由增減,
# m1 的準度是對這 54 個量的)+ 25 個 + 3 個詞組。ASCII 字眼整字比、大小寫敏感;中文照子字串比。
_DRIFT_M1_HIST_WORDS = (
    "零命中", "已移除", "不存在", "查無", "已刪", "從未", "已退役", "移除", "無此", "原記", "舊名", "改名", "已改", "棄用",
    "不使用", "廢棄", "停用", "未使用", "dead", "removed", "deleted", "no longer", "renamed", "deprecated", "unused",
    "obsolete",
    "撤除", "撤掉", "拿掉", "原寫", "原本", "原先", "不再", "舊版", "舊的", "刪除", "刪掉", "取代", "搬到", "搬去", "改為",
    "改叫", "改成", "曾", "前身", "撤", "刪", "拔掉", "去掉", "不帶", "沒有",
    "當時叫", "擴成", "改名為")
_DRIFT_M1_HIST_RX = re.compile("|".join(
    (r"(?<![A-Za-z0-9_])" + re.escape(w) + r"(?![A-Za-z0-9_])") if w.isascii() else re.escape(w)
    for w in sorted(set(_DRIFT_M1_HIST_WORDS), key=len, reverse=True)))
_DRIFT_M1_RETIRE_WORDS = ("撤除", "撤掉", "作廢", "已失效", "已過時", "不是現況", "被取代", "已凍結", "superseded",
                          "已結案", "歷史紀錄", "Superseded")
_DRIFT_M1_NOT_YET_RE = re.compile(r"(尚未|還沒|未)(撤除|撤掉|作廢|失效|取代|凍結|結案)")
_DRIFT_M1_SCOPE_WORDS = ("下面", "以下", "本節", "這一節", "整篇", "之後")
_DRIFT_M1_HEAD_RE = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
_DRIFT_M1_CUT_RE = re.compile(r"[。;；!?！？]")
# 文字抽定義:跟 _drift_py_def_re(name, test=False) 同一組形狀(任何縮排的 def/class/async def,不縮排的「名 =」
# 「名: 型別 = 值」),加 add_argument( 後面緊接的引號旗標;t_drift_m1_unparsable_files 釘兩者對同一批名稱判斷一致
_DRIFT_M1_TEXT_DEF_RE = re.compile(r"^[ \t]*(?:async[ \t]+)?(?:def|class)[ \t]+(\w+)|^(\w+)[ \t]*(?::[^=\n]*)?=(?!=)", re.M)
_DRIFT_M1_TEXT_FLAG_RE = re.compile(r"add_argument\(\s*(['\"])(--[^'\"\n]*)\1")
_DRIFT_M1_QUOTED_FLAG_RE = re.compile(r"(['\"])(--[A-Za-z0-9][\w-]*)\1")
# 判不了的狀態;error = m1 自己出了沒預料到的例外(兜底,warn 照樣回 0,代碼審 r1 正確性席)
_DRIFT_M1_UNKNOWN = ("timeout", "git-failed", "unreadable", "error")
_DRIFT_M1_ASCII_WORD_RE = re.compile(r"[A-Za-z0-9_]+")

def _drift_m1_ledger(root, mode, base, tip, res, found, note):
    """記一筆治理帳(gate drift-check;欄位攤平在事件最外層,check=old-sentence)。found=(要處理, 只列出)(扣掉已表態)。"""
    handle, listed = found
    st = res["state"]
    judged = st not in _DRIFT_M1_UNKNOWN
    busy = bool(handle) or not judged
    # no-base 記 range-unavailable(既有結果詞,跟綁定測試閘算不出範圍同一個):原本記 skipped,gov --stats 會把它算進
    # 「被跳過」——那一行講的是有人略過閘,這裡是沒起點可比(代碼審 r1 併發回滾席)
    kind = "range-unavailable" if st == "no-base" else ("passed" if not busy else ("blocked" if mode == "block" else "warned"))
    hard = kind == "blocked"
    extra = {"check": "old-sentence", "state": st, "base_sha": base if isinstance(base, str) else "",
             "code_files": res["code_files"], "candidates": res["candidates"],
             "handle": len(handle) if judged else None, "listed": len(listed) if judged else None,
             "unparsable": len(res["unparsable"]), "text_defs": len(res["text_defs"]),
             "text_defs_paths": [_drift_m1_show(x) for x in res["text_defs"][:3]], "too_long": res["too_long"],
             "long_lines": res["long_lines"], "parsed": res["parsed"], "cache_hits": res["cache_hits"], "rows_truncated": False}
    if res.get("error"):
        extra["error"] = _drift_m1_show(res["error"], 200)
    if st == "done":
        extra["rows"] = _drift_m1_rows(handle, 10) + _drift_m1_rows(listed, 3)
    nodes = sorted({_drift_m1_show(f["path"][:-3]) for f in handle})[:50] if judged else []
    nodes = _drift_m1_fit(root, kind, note, hard, tip, nodes, extra)
    if _gate_event_or_warn(root, "drift-check", kind, note, hard=hard, head_sha=tip, nodes=nodes, extra=extra) is False:
        _drift_m1_ledger_miss(root, tip, st)


def _drift_m1_guarded(root, mode, base, tip, vault_rel):
    """跑 m1 並印出、記帳 → rc_m1。m1 裡任何沒預料到的例外都兜底成「判不了」(state error):warn 印一行、回 0,
    block 照判不了的規矩擋——原本例外一路丟到最外層,warn 模式也整支回 1(代碼審 r1 正確性席)。"""
    try:
        res = _drift_old_sentence_check(root, base, tip, vault_rel, time.monotonic() + _DRIFT_M1_BUDGET_SEC)
        return _drift_m1_report(root, mode, base, tip, vault_rel, res)
    except Exception as ex:
        err = f"{type(ex).__name__}: {ex}"
    try:
        return _drift_m1_report(root, mode, base, tip, vault_rel, _drift_m1_new_res("error", err))
    except Exception:
        print(f"舊句檢查:工具內部出錯({_drift_m1_show(err, 120)}),這次沒判,帳也沒記", file=sys.stderr)
        return 1 if mode == "block" else 0


def _drift_m1_report(root, mode, base, tip, vault_rel, res):
    """m1 的結論行、發現、改法(全部 stderr)與治理帳 → rc_m1(block 而且要處理有筆數或判不了時 1,其他 0)。
    state 是 None(範圍裡沒有改到程式檔)不印不記。"""
    st = res["state"]
    if st is None:
        return 0
    handle, listed = res["handle"], res["listed"]
    if handle or listed:
        acks = _drift_load_acks(root, tip)
        handle, _h = _drift_split_acked(handle, acks, vault_rel)
        listed, _l = _drift_split_acked(listed, acks, vault_rel)
    busy = bool(handle) or st in _DRIFT_M1_UNKNOWN
    line = _drift_m1_conclusion(res, len(handle), len(listed))
    if busy:
        line = "擋下:" + line if mode == "block" else "提醒:" + line + "(drift_check.old_sentence=warn,不擋)"
    print(line, file=sys.stderr)
    if mode == "block" and st in _DRIFT_M1_UNKNOWN:
        print(_drift_unknown_hint("舊句檢查沒判完"), file=sys.stderr)
    _drift_m1_print_extra(res)
    _drift_m1_print_rows(res, handle, listed)
    _drift_m1_ledger(root, mode, base, tip, res, (handle, listed), line)
    return 1 if (busy and mode == "block") else 0


# ── 健檢與 doctor ────────────────────────────────────────────────────────────────────

def _drift_vault_of(env):
    root = _vault_repo_root(env)
    try:
        return root, env.vault.resolve().relative_to(Path(root).resolve()).as_posix()
    except ValueError:
        return root, env.vault.name


def cmd_drift_scan(env, at=None, as_json=False, budget=None):
    """lumos drift scan [--at 提交] [--json] [--budget 秒]:對整份圖譜(含 superseded 的筆記)跑甲的五種一致檢查與乙的
    全部條件評估,列出全部發現,已表態的照列並標「已表態」。不擋、不寫帳;修復階段產清單、回退時清點用。
    總預算預設 60 秒(計劃〈做法〉第 0 節;代碼審 r1 外家席:原本沒實作),用完的條件列成判不了。"""
    import json as _j, math as _m, time as _t
    budget = _DRIFT_BUDGET_SEC if budget is None else budget
    if not _m.isfinite(budget) or not 0 < budget <= 86400:
        # inf 傳給 subprocess 的逾時會丟 OverflowError、nan 讓每次比較都是假(代碼審 r2 外家席);很大的有限數
        # (1e10)一樣讓逾時換算溢位(r3 邊界席),上限一天
        print("擋下:--budget 要是 0 到 86400 之間的秒數", file=sys.stderr)
        return 2
    deadline = _t.monotonic() + budget
    root, vault_rel = _drift_vault_of(env)
    tenv, sha = env, None
    if at:
        sha = _lens_full_sha(root, at)
        if sha is None:
            print(f"擋下:找不到提交 {at}", file=sys.stderr)
            return 2
        # ★用那個提交自己的圖譜位置★(代碼審 r1 外家席:圖譜資料夾改過名時,拿現在的位置讀舊提交會讀到空樹)
        vault_rel = _drift_vault_rel(root, sha) or vault_rel
        tenv = _drift_tree_env(root, sha, vault_rel, deadline=deadline)
        if tenv is None:
            print(f"擋下:git 讀不出 {at} 的圖譜", file=sys.stderr)
            return 2
    pfound, probs = _drift_probe_scan(tenv, _drift_probe_tree(root, sha or "disk", deadline), deadline)
    left, done = _drift_split_acked(_drift_state_findings(tenv) + pfound, _drift_load_acks(root, sha), vault_rel)
    # 解不開的筆記列成「判不了」(代碼審 r2 外家席:原本修復清單會靜默漏掉它們)。★不寫治理帳★(代碼審 r3 併發席、
    # 正確性席:讀指令不寫帳是既有決定 Systems/lumos-cli-read d1,計劃 [S2] 原本要記 degraded,改跟決定一致)
    bad = sorted(r for r, n in tenv.notes.items() if _note_unreadable(n))

