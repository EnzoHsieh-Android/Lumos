def _esc_clean(v, limit=200):
    """逃逸帳顯示消毒(code-escape r1 B-1/B-2):控制字元(含換行/ESC)換空格——
    --list 的「一行一筆」是攔截/逃逸週報 grep 的載重合約,使用者可控的 desc 不得打穿;
    ANSI 逃逸碼進終端=帳本可信度風險。截斷防超長刷版。"""
    out = "".join(ch if ch >= " " and not ("\x7f" <= ch <= "\x9f") else " " for ch in str(v))   # 含 8 位元 C1 控制碼(r2 資安席)
    return out if len(out) <= limit else out[:limit] + "…"



def _git_head(repo_root):
    try:
        r = subprocess.run(["git", "-C", str(repo_root), "rev-parse", "HEAD"], capture_output=True, text=True, errors="replace")
        return r.stdout.strip() if r.returncode == 0 else ""
    except OSError:
        return ""


def _plans_in_range(repo_root, git_range, vault):
    """提交範圍碰到的計劃筆記(repo 相對路徑)。對回啟發式:碰到 Projects/*.md 就算。"""
    try:
        # ★中文檔名:git 預設把非 ASCII 路徑加引號並轉義,不關掉會一個計劃都對不上(taskbank 同型坑 2026-09-15)★
        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", git_range, "--"],
                           capture_output=True, text=True, errors="replace")
def _drift_m1_scan_note(run, rel, text, idx, gone, homes):
    """掃一篇筆記:正文、摘要、決策欄的可見行,撤除節不看,名稱所在那一句有歷史字眼的不算提到;一行一筆。
    每一行之前看截止時間;超過 _DRIFT_M1_LINE_MAX 字的行不掃、記 long_lines。"""
    lines = text.split("\n")
    try:
        regs = _notelines_regions(text)
    except Exception:     # 照參考實作:區塊判不出就整篇當正文
        regs = ["body"] * len(lines)
    vis = {i for i, _ln in _visible_lines(lines)}
    ret = _drift_m1_retired(lines, regs, vis)
    for i, ln in enumerate(lines):
        run.check_time()
        if regs[i] not in _DRIFT_M1_NOTE_REGIONS or (i + 1) not in vis or ret[i + 1]:
            continue
        if len(ln) > _DRIFT_M1_LINE_MAX:
            run.res["long_lines"] += 1
            continue
        toks = _drift_m1_line_hits(idx, ln)
        if not toks:
            continue
        layer = "handle" if (regs[i] == "summary" or rel in homes) else "list"
        why = "消失的名稱:" + "、".join(f"`{t}`(原本在 {'、'.join(sorted(gone[t]))})" for t in toks)
        run.res[layer if layer == "handle" else "listed"].append(
            {"kind": "m1", "path": rel, "line": i + 1, "text": ln.strip(), "why": why, "names": toks, "layer": layer})


def _drift_m1_judge(run, coded):
    """有起點時的判定:粗候選 → (有定義名粗候選才)終點語料 → 候選名稱 → 讀筆記 → 掃。"""
    tf, tall, tl = run.listing(run.tip)
    _bf, _ball, bl = run.listing(run.base)
    defs, paths = _drift_m1_rough(run, coded, tl, bl, tall)
    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
              file=stream)
        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
        prev = _drift_prev_ack_line(f)
        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
        if prev:
            print(f"      ({_esc_clean(prev, 400)})", file=stream)
        elif old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
    if len(rows) > 20:
        print(f"  其餘 {len(rows) - 20} 筆這裡沒印;改完這些再推會再列" if rows[0]["kind"] == "m1"
              else f"  …還有 {len(rows) - 20} 筆", file=stream)


def cmd_drift_check(repo=None, diff_range=None, push_remote=None, pushed_ref=None):
    """lumos drift check --diff A..B:推送前與 CI 的閘(閘名 drift-check)。有「要處理」的 rc1(warn 只印 rc0);
    只有「只列出」的 rc0;參數錯 rc2;判不了的(git 失敗、逾時、預算用完)算要處理——放行等於一條繞過的路。
    帶 --push-remote 與 --pushed-ref(推送前掛鉤與 CI 用,要一起給,只給一個回 2):A 當成遠端舊值,起點由
    _push_range_start 算,git 查詢失敗算不出起點時照「判不了」處理;都沒帶照共用起點判法(_lens_push_base),行為不變。"""
    root = _note_audit_root(repo)
    if root is None:
        print("存量漂移檢查:這裡不是 git 專案,跳過", file=sys.stderr)
        return 0
    if os.environ.get("LUMOS_SKIP_DRIFT_CHECK") == "1":        # 只認 1

