def _drift_config(text):
    """被檢查版本的 .lumos/config.json 內容 → (gate, warnings, explicit, old_sentence)。照 _note_audit_config 的讀法(每道閘各自一支,
    既有慣例);多回一個 explicit=專案有沒有自己寫 drift_check(寫壞了也算寫了)——doctor 的開關提醒要用,
    從同一次解析來,不另開第二支讀同一個鍵(代碼審 r4 架構對齊席)。
    old_sentence(舊句檢查 m1 的開關,Projects/舊句檢查_計劃〈做法〉3)跟 gate 各自解析、互不牽連:沒寫、寫 null、
    設定檔壞掉 → warn;寫了 block/warn/off 以外的值 → warn 並多一句提醒。"""
    import json as _j
    cfg, bad = None, False
    if text is not None:
        try:
            cfg = _j.loads(text.decode("utf-8") if isinstance(text, bytes) else text)
        except (ValueError, UnicodeDecodeError):
            bad = True
    gate, warns, explicit = _drift_gate_config(cfg, bad)
    osm, osw = _drift_old_sentence_config(cfg, bad)
    return gate, warns + osw, explicit, osm


def _drift_old_sentence_config(cfg, bad=False):
    """→ (block|warn|off, [提醒])。預設 warn,跟 drift_check.gate 的預設(block)各管各的;設定檔讀不成 JSON 時也照 warn
    並另講一句(gate 那句只講 gate 的預設,不另講會讓人以為舊句檢查也跟著擋)。"""
    if bad:
        return "warn", ["舊句檢查(drift_check.old_sentence)照預設 warn"]
    dc = cfg.get("drift_check") if isinstance(cfg, dict) else None
    v = dc.get("old_sentence") if isinstance(dc, dict) else None
    if v is None:
        return "warn", []
    if v not in _DRIFT_GATE_VALUES:
        return "warn", [f"drift_check.old_sentence 只能是 block/warn/off,你寫的是 {v!r},照預設 warn"]
    return v, []


def _drift_gate_config(cfg, bad):
    """drift_check.gate → (gate, warnings, explicit)。bad=設定檔讀不成 JSON。"""
    if bad:
        # 設定檔寫壞了也算「自己寫了」(代碼審 r5 正確性席:原本 doctor 說「沒寫設定」,人明明寫了 block)
        return _DRIFT_DEFAULT_GATE, [f".lumos/config.json 讀不成 JSON,存量漂移檢查照預設 {_DRIFT_DEFAULT_GATE}"], True
    if not isinstance(cfg, dict) or "drift_check" not in cfg:
        return _DRIFT_DEFAULT_GATE, [], False
    dc = cfg["drift_check"]
    if not isinstance(dc, dict):
        return _DRIFT_DEFAULT_GATE, ["設定檔的 drift_check 不是物件(要寫成 {\"drift_check\": {\"gate\": \"warn\"}}),"
                                     f"照預設 {_DRIFT_DEFAULT_GATE}"], True
    g = dc.get("gate")
    if g is None:          # 寫了 drift_check 但沒寫 gate(或寫 null):算自己寫了(代碼審 r5 正確性席、外家席)
        return _DRIFT_DEFAULT_GATE, ([] if "gate" not in dc else [f"drift_check.gate 是 null,照預設 {_DRIFT_DEFAULT_GATE}"]), True
    if g not in _DRIFT_GATE_VALUES:
        return _DRIFT_DEFAULT_GATE, [f"drift_check.gate 只能是 block/warn/off,你寫的是 {g!r},照預設 {_DRIFT_DEFAULT_GATE}"], True
    return g, [], True


def _drift_print_findings(rows, stream, acks=None, alive=None):
    """路徑、原文、說明都來自被推送的筆記,印到終端前把控制字元換成空格(代碼審 r5 資安席;同 _drift_bad_note)。"""
    for f in rows[:20]:
        print(f"  [{f['kind']} {_DRIFT_KIND_NAMES[f['kind']]}] {_esc_clean(f['path'])}:{f['line']}  {_esc_clean(f['text'], 60)}",
              file=stream)
        print(f"      {_esc_clean(f['why'], 1000)}", file=stream)
        prev = _drift_prev_ack_line(f)
        old = None if prev else (_drift_old_reason(f, acks, alive) if acks else None)
        if prev:
            print(f"      ({_esc_clean(prev, 400)})", file=stream)
        elif old:
            print(f"      (這一行以前表態過、後來改了或搬了,舊理由:{old[:80]})", file=stream)
        if k is not None and k >= 0:
            return self.pairs[k]
        return (self.unclosed, len(self.line)) if self.unclosed is not None and self.unclosed < pos else None

    def hist(self, pos):
        sp = self.span(pos)
        seg_text, lo, hi, cuts = ((self.line, sp[0] + 1, sp[1], self.cuts) if sp else (self.masked, 0, len(self.line), self.mcuts))
        j = self._bisect.bisect_right(cuts, pos) - 1
        a = cuts[j] if j >= 0 and cuts[j] - 1 >= lo else lo
        j2 = self._bisect.bisect_left(cuts, pos + 1)
        b = cuts[j2] - 1 if j2 < len(cuts) and cuts[j2] - 1 < hi else hi
        key = (sp is not None, a, b)
        if key not in self.memo:
            self.memo[key] = bool(_DRIFT_M1_HIST_RX.search(seg_text[a:b]))
        return self.memo[key]


def _drift_m1_paren_span(line, pos):
    """包住 pos 的最內層那對括號 (起, 迄);沒有括號包住、但最後一個沒關上的 ( 在 pos 前面 → (那個位置, 行尾);否則 None。"""
    opened, span = [], None
    for i, ch in enumerate(line):
        if ch in "(（":
            opened.append(i)
        elif ch in ")）" and opened:
            a = opened.pop()
            if a < pos < i and (span is None or a > span[0]):
                span = (a, i)
    if span is None and opened and opened[-1] < pos:
        span = (opened[-1], len(line))
    return span


def _drift_m1_clause_hist(line, pos):
    """名稱所在那一句有沒有歷史字眼(逐字照參考實作 _clause_has_hist):括號內只看括號內;括號外先把「裡面沒有括號的
    括號對」整對遮掉;再用 。;;!?!? 切,取名稱所在那一小段(英文句點不切)。"""
    span = _drift_m1_paren_span(line, pos)
    if span is not None:
        seg, rel = line[span[0] + 1:span[1]], pos - span[0] - 1
    else:
        seg, rel = re.sub(r"[(（][^()（）]*[)）]", lambda m: "\0" * len(m.group(0)), line), pos
    cuts = [m.end() for m in _DRIFT_M1_CUT_RE.finditer(seg) if m.end() <= rel]
    m2 = _DRIFT_M1_CUT_RE.search(seg[rel:])
    clause = seg[(cuts[-1] if cuts else 0):(rel + m2.start() if m2 else len(seg))]
    return bool(_DRIFT_M1_HIST_RX.search(clause))


def _drift_m1_name_rx(names):
    """整字比對的一條正則(逐字照參考實作 _mk_rx):一般識別字前後不能緊接 ASCII 英數底線;旗標、路徑、帶 . 的前面不能緊接
    ASCII 英數、底線、/ . -,後面不能緊接 ASCII 英數、底線、-。一般識別字那組在前、組內長的在前。"""
    ids = sorted((n for n in names if not n.startswith("--") and "/" not in n and "." not in n), key=len, reverse=True)
    idset = set(ids)
    others = sorted((n for n in names if n not in idset), key=len, reverse=True)
    parts = []
    if ids:
        parts.append(r"(?<![A-Za-z0-9_])(?:" + "|".join(map(re.escape, ids)) + r")(?![A-Za-z0-9_])")
    if others:
        parts.append(r"(?<![A-Za-z0-9_/.-])(?:" + "|".join(map(re.escape, others)) + r")(?![A-Za-z0-9_-])")
    return re.compile("|".join(parts)) if parts else None


