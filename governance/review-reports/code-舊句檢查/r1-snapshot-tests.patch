+             ("③done 候選 3、要處理 0、只列出 2", _m1_res(cand=3, listed=lst2),
+              "舊句檢查:這次推送消失了 3 個名稱,筆記裡還在講的——要處理 0 筆、只列出 2 筆"),
+             ("⑤no-base", _m1_res(state="no-base", cand=None), "舊句檢查:這次沒有起點版可比,不判")]
+    for label, res, want in cases:
