+    print("t_drift_m1_conclusion_lines")
+    lst2 = [_m1_f("Systems/B.md", 9, ["baz_qux"], layer="list"), _m1_f("Systems/C.md", 9, ["baz_qux"], layer="list")]
+    cases = [("①done 候選 0", _m1_res(cand=0), "舊句檢查:這次改到 2 支程式檔,沒有名稱消失"),
