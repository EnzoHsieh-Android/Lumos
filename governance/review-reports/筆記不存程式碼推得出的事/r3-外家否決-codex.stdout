 21424	def _lint_waivers_load(repo_root):
 21425	    """讀放行檔。回 ({指紋: 那筆紀錄}, 錯誤訊息 or None)。
 21426	    ★讀不了時不可以當成「沒有放行紀錄」★——那會讓所有既有放行瞬間復活、整批擋人;
 21427	    回錯誤訊息讓呼叫端歸進「環境不可用」。"""
 21428	    import json
 21429	    p = _lint_waivers_path(repo_root)
 21430	    if not p.is_file():
 21431	        return ({}, None)
 21432	    try:
 21433	        data = json.loads(p.read_text(encoding="utf-8"))
 21434	    except Exception as e:
 21435	        return ({}, "放行檔讀不了(" + e.__class__.__name__ + "):" + _LINT_NEW_WAIVERS_REL)
 21436	    items = data.get("waivers") if isinstance(data, dict) else None
 21437	    if not isinstance(items, list):
 21438	        return ({}, "放行檔格式不對(要有 waivers 清單):" + _LINT_NEW_WAIVERS_REL)
 21439	    out = {}
