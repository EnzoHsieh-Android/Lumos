 21350	def _lint_new_norm_snippet(lines):
 21351	    """指紋用的片段正規化:每行去行尾空白、內部連續空白壓成一個、丟空行,★前導空白原樣保留★。
 21352	    保留縮排是刻意的取捨——抹掉縮排的話,「同一段程式碼被搬進另一個會執行的區塊」會比不出來,
 21353	    那是行為改變卻無聲放行、沒有補救;保留縮排的代價只是「整批重新縮排」會產生一批假新增,那有放行管道可處理。"""
 21354	    out = []
 21355	    for ln in lines:
 21356	        m = re.match(r"^([ \t]*)(.*?)[ \t]*$", ln.rstrip("\n"))
 21357	        if m is None:
 21358	            continue
 21359	        lead, body = m.group(1), re.sub(r"\s+", " ", m.group(2))
 21360	        if body:
 21361	            out.append(lead + body)
 21362	    return "\n".join(out)
