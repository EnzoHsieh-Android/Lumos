 24005	        return 0
 24006	    viol, errs = res
 24007	    if not viol and not errs:
 24008	        return 0
 24009	    head = "擋下" if mode == "block" else "提醒(note_shape.gate=warn,不擋)"
 24010	    print(f"{head}:{mode_word}的筆記有新寫的、程式碼推得出來的形狀(筆記形狀擋)——", file=sys.stderr)
 24011	    for e in errs:
 24012	        print(f"  {e}", file=sys.stderr)
 24013	    for p, n, rule, frag, fix in viol:
 24014	        print(f"  {p}:{n}  {rule} {frag}:{fix}", file=sys.stderr)
 24015	    if mode == "block":
 24016	        print("內容還在工作目錄,改完再提交(這道檢查不動筆記、不動暫存區)。為什麼擋:筆記只留程式碼推不出來的東西,"
 24017	              "推得出來的一寫進去就會過期——見 Projects/筆記形狀擋_計劃。", file=sys.stderr)
 24018	        _gate_event_or_warn(root, "note-shape", "blocked", f"{mode_word}:新違規 {len(viol) + len(errs)} 條",
 24019	                            hard=True, nodes=sorted({v[0] for v in viol} | {e.split(':', 1)[0] for e in errs})[:50])
 24020	        return 1
