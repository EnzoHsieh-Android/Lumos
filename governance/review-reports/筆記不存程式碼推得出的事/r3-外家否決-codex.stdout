 20572	def cmd_lint_waive(key=None, note=None, repo=None, as_json=False, show=False):
 20573	    """把某一條告警的指紋標成已放行(新增告警閘的逃生門)。
 20574	    ★誤報一定會發生★——首次真跑社群規則庫,唯一命中就是誤報(對刻意設 0700 的目錄建議改成 0644)。
 20575	    沒有正式出口的話,結局是有人繞過整道檢查、零留痕;所以這條路第一天就要開好,而且會被數。
 20576	    放行綁指紋不綁版本:綁版本的話每次提交都要重新放行,吵到沒人會用。"""
 20577	    import json
 20578	    import os
 20579	    repo_root = _anchor_repo_root(repo)
 20580	    if repo_root is None:
 20581	        print("✗ lint-waive: 從目前目錄往上找不到 git repo——帶 --repo <根> 指定,或到 repo 內執行", file=sys.stderr)
 20582	        return 2
 20583	    if show:
 20584	        cur, err = _lint_waivers_load(repo_root)
 20585	        if err:
 20586	            print(f"✗ lint-waive: {err}", file=sys.stderr)
 20587	            return 2
 20588	        if as_json:
 20589	            print(json.dumps({"waivers": list(cur.values())}, ensure_ascii=False))
 20590	            return 0
 20591	        if not cur:
 20592	            print("這個專案還沒有放行過任何告警")
 20593	            return 0
 20594	        print(f"這個專案放行了 {len(cur)} 條告警(放行是合法的,但會被統計):")
 20595	        for k, it in cur.items():
 20596	            print(f"  {k}  {it.get('file', '')} [{it.get('rule', '')}] — {it.get('reason', '')}")
 20597	        return 0
 20598	    if not key:
 20599	        print("擋下:要放行哪一條?把擋下訊息裡那串指紋帶進來", file=sys.stderr)
 20600	        print("    lumos lint-waive <指紋> --note \"<為什麼放行>\"", file=sys.stderr)
 20601	        return 2
 20602	    if not (note or "").strip():
 20603	        print("擋下:放行要寫理由(--note)——不寫理由的放行,三個月後沒人知道當初為什麼", file=sys.stderr)
 20604	        return 2
 20605	    who = os.environ.get("USER") or os.environ.get("USERNAME") or "unknown"
 20606	    ok, err = _lint_waivers_add(repo_root, key, "", "", note.strip(), who)
 20607	    if not ok:
 20608	        print(f"✗ lint-waive: {err}", file=sys.stderr)
 20609	        return 1
 20610	    _gate_event_or_warn(repo_root, _LINT_NEW_GATE_NAME, "waived", note.strip()[:120], hard=False)
 20611	    print(f"✓ lint-waive: 指紋 {key} 已放行,理由記下來了——{note.strip()}")
 20612	    print(f"  紀錄寫進 {_LINT_NEW_WAIVERS_REL}(這個檔要一起提交,只留在本機的話換台機器會整批復活擋人)")
 20613	    print("  放行是合法的,但健檢會數這個專案放行了幾條。")
 20614	    return 0
