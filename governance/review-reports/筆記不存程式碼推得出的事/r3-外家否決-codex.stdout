 21368	def _lint_new_key(claim, text_by_file):
 21369	    """一條告警的身分。回 (key, 是不是弱比對)。
 21370	    ★不能用行號當身分★:行號會因為上下文位移而變。優先用「命中處的程式碼片段」;
 21371	    工具沒附片段就自己去讀那幾行補上(實測:主流 Python 檢查器完全不附,所以自己補是常態不是例外);
 21372	    行號缺失、小於一、或超出檔案長度=取不到片段,退到「規則+檔名+訊息」的弱比對並標明。"""
 21373	    rule = claim.get("rule") or ""
 21374	    f = claim.get("file") or ""
 21375	    line = claim.get("line") or 0
 21376	    end = claim.get("end_line") or line
 21377	    lines = text_by_file.get(f)
 21378	    if lines and isinstance(line, int) and 1 <= line <= len(lines):
 21379	        hi = end if isinstance(end, int) and line <= end <= len(lines) else line
 21380	        snippet = _lint_new_norm_snippet(lines[line - 1:hi])
 21381	        if snippet:
 21382	            return (_LINT_NEW_SEP.join([rule, f, snippet]), False)
 21383	    return (_LINT_NEW_SEP.join([rule, f, "~msg~" + str(claim.get("message", ""))]), True)
