 17878	        return "skipped-not-dir"
 17879	    states = []
 17880	    for nm, toml in _CODEX_SEATS:
 17881	        f = d / f"{nm}.toml"
 17882	        if f.exists():
 17883	            cur = f.read_text(encoding="utf-8", errors="replace")
 17884	            if _CODEX_AGENT_MARK not in cur:
 17885	                print(f"  ⚠ {f} 已存在且不是 lumos 寫的,保留不動(要用 lumos 版請先自己移走)", file=sys.stderr)
 17886	                states.append("skipped-foreign"); continue
 17887	            if cur == toml:
 17888	                states.append("unchanged"); continue
 17889	        f.write_text(toml, encoding="utf-8")
 17890	        states.append("created")
 17891	    for pref in ("skipped-foreign", "created"):   # 優先序:別人的檔優先講,其次「寫了」,全同才算 unchanged
 17892	        if pref in states:
 17893	            return pref
 17894	    return "unchanged"
