 21466	def _lint_new_clean_stale(repo_root):
 21467	    """開跑前清掉同前綴、超過一天的殘骸。★強殺(機器休眠判死)時收尾不會執行★,
 21468	    殘骸會留在專案底下那個被忽略的目錄裡;每次名字不同所以不會污染下一次比對,但要有人掃。"""
 21469	    import shutil
 21470	    import time as _time
 21471	    base = Path(repo_root) / ".lumos"
 21472	    if not base.is_dir():
 21473	        return
 21474	    now = _time.time()
 21475	    for d in base.glob("lintbase-*"):
 21476	        try:
 21477	            if d.is_dir() and now - d.stat().st_mtime > _LINT_NEW_STALE_SEC:
 21478	                shutil.rmtree(d, ignore_errors=True)
 21479	        except OSError:
 21480	            continue

