 19819	def _validate_repo_ref(repo_root, token, line, at_sha=None):
 19820	    """驗一條 repo 內檔案指涉:回 (status, excerpt)。status ∈ missing/line_out_of_range/ok。
 19821	    _refcheck_scan 與 check_regen_provenance(Check J 的 [src:] 驗證)共用——
 19822	    J-c 不得走 _refcheck_scan 抽取入口(inline-code 抽取 + top_dirs 靜默過濾會把假目錄放行,
 19823	    正是 J-c 要擋的幻覺;此 helper 直收已解析 path/line,無靜默過濾)。
 19824	    token 消毒(code-review blocker 修):空/絕對路徑/含 .. 一律 missing——top_dirs 過濾
 19825	    被拆掉時它隱含的安全性(空值/絕對/traversal 天然進不了 top_dirs)必須在此顯式補回,
 19826	    否則 [src: ]/[src:/etc/passwd]/[src:../..] 會 resolve 到 repo 外真實存在的路徑而判 ok。"""
 19827	    token = token.strip()
 19828	    from pathlib import PurePosixPath, PureWindowsPath
 19829	    if (not token
 19830	            or PurePosixPath(token).is_absolute() or PureWindowsPath(token).is_absolute()
 19831	            or ".." in PurePosixPath(token).parts):
 19832	        return "missing", ""
 19833	    # at_sha 給了就對那個 commit 的 git 樹驗,不看工作樹(表態閘 2026-09-09,r3 架構對齊席 A3:同一件事同一個入口,
 19834	    # 別在 code-loop 那邊另造一套);三態語意(missing/line_out_of_range/ok)兩條路一致。
 19835	    if at_sha:
 19836	        if not _git_tree_has(repo_root, at_sha, token):
 19837	            return "missing", ""
 19838	        if not line:
 19839	            return "ok", ""
 19840	        txt = _git_tree_text(repo_root, at_sha, token)
 19841	        file_lines = txt.splitlines() if txt is not None else None
 19842	        if "-" in line:
 19843	            lo, hi = (int(x) for x in line.split("-", 1))
