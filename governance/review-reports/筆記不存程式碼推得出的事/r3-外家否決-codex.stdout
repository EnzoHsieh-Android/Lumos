 17897	def _remove_codex_agent(home=None) -> list:
 17898	    """teardown 對稱:每一席都收,只刪帶標記的那份;★回真正刪掉的檔名清單★(空清單=什麼都沒刪,falsy)。
 17899	    回清單不回 bool 的理由:多席之後「刪了幾個」跟「刪了哪些」不一樣,teardown 的移除清單要照實列,
 17900	    不能因為函式回 True 就把每一席都當成刪過(那會 report 一個沒發生的動作)。"""
 17901	    d = _codex_home(home) / "agents"
 17902	    gone = []
 17903	    for nm, _ in _CODEX_SEATS:
 17904	        f = d / f"{nm}.toml"
 17905	        try:
 17906	            if f.exists() and _CODEX_AGENT_MARK in f.read_text(encoding="utf-8", errors="replace"):
 17907	                f.unlink(); gone.append(f"agents/{nm}.toml")
 17908	        except OSError:
 17909	            pass
 17910	    return gone
