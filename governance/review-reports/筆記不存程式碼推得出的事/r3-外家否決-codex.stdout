 24022	    _gate_event_or_warn(root, "note-shape", "warned", f"{mode_word}:新違規 {len(viol) + len(errs)} 條(warn 模式不擋)",
 24023	                        nodes=sorted({v[0] for v in viol})[:50])
 24024	    return 0
