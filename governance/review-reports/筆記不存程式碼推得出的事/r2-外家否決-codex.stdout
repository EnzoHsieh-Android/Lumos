 21288	def _lint_new_key(claim, text_by_file):
 21289	    """一條告警的身分。回 (key, 是不是弱比對)。
 21290	    ★不能用行號當身分★:行號會因為上下文位移而變。優先用「命中處的程式碼片段」;
 21291	    工具沒附片段就自己去讀那幾行補上(實測:主流 Python 檢查器完全不附,所以自己補是常態不是例外);
 21292	    行號缺失、小於一、或超出檔案長度=取不到片段,退到「規則+檔名+訊息」的弱比對並標明。"""
 21293	    rule = claim.get("rule") or ""
 21294	    f = claim.get("file") or ""
 21295	    line = claim.get("line") or 0
 21296	    end = claim.get("end_line") or line
 21297	    lines = text_by_file.get(f)
 21298	    if lines and isinstance(line, int) and 1 <= line <= len(lines):
 21299	        hi = end if isinstance(end, int) and line <= end <= len(lines) else line
 21300	        snippet = _lint_new_norm_snippet(lines[line - 1:hi])
 21301	        if snippet:
 21302	            return (_LINT_NEW_SEP.join([rule, f, snippet]), False)
 21303	    return (_LINT_NEW_SEP.join([rule, f, "~msg~" + str(claim.get("message", ""))]), True)
