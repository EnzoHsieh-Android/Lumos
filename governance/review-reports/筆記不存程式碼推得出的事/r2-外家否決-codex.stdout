/bin/zsh -lc "sed -n '820,940p' scripts/lumos; sed -n '3190,3265p' scripts/lumos; sed -n '6160,6225p' scripts/lumos; sed -n '6560,6615p' scripts/lumos; sed -n '8120,8235p' scripts/lumos" in /Users/enzo/harness/lumos-toolchain
 succeeded in 0ms:
    if not successor or successor.strip() == loop_id.strip():
        print("擋下:--successor 要給新開的迴圈編號,而且不能跟舊編號一樣——重寫=換新編號載新版,同號沒有「重寫」可言", file=sys.stderr)
        return 2
    # 血緣一跳查詢:這個編號是不是已經是上一次重寫的產物?
    chain_prev = None
    try:
        import json as _j
        import re as _re
        gl = env.vault.parent / ".governance-log.jsonl"
        # 邊界比對:successor=<id> 後面必須是分號或字串結尾——裸子字串會讓前綴編號互撞
        # (successor=lf-a 誤中 successor=lf-a2;clf r1 主審 F1 實驗重現),偽造連續重寫警告。
        _pat = _re.compile(r"successor=" + _re.escape(loop_id.strip()) + r"(;|$)")
        if gl.exists():
            for line in gl.read_text(encoding="utf-8").splitlines():
                try:
                    o = _j.loads(line)
                except ValueError:
                    continue
                if not isinstance(o, dict):
                    continue          # 非物件 JSON 行(壞帳)跳過,不炸整個指令
                if o.get("gate") == "design-loop" and o.get("kind") == "rewrite" \
                        and _pat.search(str(o.get("note", ""))):
                    chain_prev = (o.get("nodes") or [None])[0]   # 多筆時取最後一筆(帳序=時序,最近的血緣)
    except OSError:
        pass
    lineage = f"prev={loop_id.strip()};successor={successor.strip()};{note or ''}".rstrip(";")
    _loop_gov_mark(env, loop_id.strip(), "rewrite", lineage)
    print(f"✓ 迴圈 {loop_id} 以「人裁整份重寫」收尾,入治理帳;新版由 {successor} 接手審。")
    print("  在意的原因:重寫不重置攤人義務——這筆帳讓「gov --stats」的放行率統計不失真,也讓血緣可查。")
    if chain_prev:
        print(f"  ★這已是連續第二次判重寫(上一段血緣:{chain_prev} → {loop_id})——強制攤人,不得三開★")
    print("  之後查血緣:")
    print("    lumos gov --stats")
    return 0


def _gate_event(repo_root, gate, kind, note, *, hard=False, head_sha=None,
                ref=None, nodes=None, extra=None):
    """擋人(或放行/被跳過)的那一刻,由★做判定的那一方★落一筆治理帳(#19 S1)。

    ★為什麼不是 hook 來記★:這個 repo 既有的寫入模式是「做事的那支子命令,
    順便把自己的判定落帳」(_append_governance_log 的寫者是 doctor --ci 與 anchor approve;
    _codeloop_gov_log 的寫者是 code-loop 自己)。沒有任何先例是「hook 呼叫一個
    專門用來記帳的端點」——而且 2026-09-07 真的有人寫過一個不存在的 `lumos gov-event`,
    當時的結論就是「工具沒有給外部腳本寫治理帳的入口」。r1 架構對齊席把這條翻出來。

    ★attempt_id 是拿來把同一次推送的事件串起來的★(#19 S6):pre-push 是逐 ref 迴圈,
    而錨點與健檢跑在迴圈外面——「當下的 commit」對整支層級的閘沒有唯一答案。
    整支層級的事件用 attempt_id(由 hook 產生、經環境變數傳進來),
    逐 ref 的事件另外帶那一行真正的 sha。

    ★回傳值要被看★(#19 S7):True=寫進去了,False=沒寫進去。
    既有的寫入器是 `except OSError: pass`,錯誤靜靜吞掉——如果新的照抄,
    「擋人時一定有帳」這個承諾在磁碟滿/權限錯/帳檔壞掉時就是空的。
    ★但是:寫不進去不得改寫閘的判定★——該擋還是擋(反過來要求「寫成功才擋」
    會讓觀測系統故障變成放行,那正是這批要修的病的鏡像)。呼叫端負責在 stderr 講一句。
    """
    import json as _json
    import datetime as _dt
    root = Path(repo_root)
    docs = root / "docs"
    if not docs.is_dir():
        # ★「這個 repo 根本沒有這本帳」不是「寫不進去」★(2026-09-08 r1 通才席 major):
        # 沒跑過 lumos init 的 repo 本來就沒有 docs/,這是結構性、每次都會發生、
        # 永遠不會自己好。用「寫不進去」那句話講它,會讓人以為工具壞了去瞎排查,
        # 久了養成忽略這類警告的習慣——恰好抵銷這批想建立的信任。
        # 既有的姐妹寫入器面對同一情境是靜靜略過,這裡對齊它:回 None 表示「不適用」。
        return None
    if not head_sha:
        try:
            head_sha = _sp_run_text(["git", "-C", str(root), "rev-parse", "HEAD"])
        except Exception:
            head_sha = ""
    # ★動態閘名要自己對名單★(既有漂移釘 t_gov_stats_gate_drift 抓到的):
    # 那條釘子掃全檔「"gate": 後面不是字串字面值」的位置,防的是
    # 「用變數當閘名 → 逃過字面值掃描 → gov 的名單漏掉它」。這支是通用寫入器,
    # 閘名本來就是參數,所以改成★在這裡對名單★——不在名單上就不寫,並且喊出來。
    # 這樣既保住那條釘子的用意,又不必為了通過它把通用寫入器拆成六份。
    if gate not in _KNOWN_GATES:
        print(f"  ⚠ 想記一筆 gate={gate},但它不在 _KNOWN_GATES 名單上——"
              f"沒有寫(否則 gov 的統計會漏掉它)。要新增閘名請同時更新 _KNOWN_GATES。",
              file=sys.stderr)
        return False
    ev = {
        "ts": _dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "commit": (head_sha or "")[:7],
        "gate": gate, "kind": kind, "hard": bool(hard),
        "nodes": list(nodes or []), "note": note,
        # ★同一個 gate 的欄位名要對得起來★(2026-09-08 r1 架構席 major):
        # 既有的 _codeloop_gov_log 把備註寫成 detail、分支寫成 branch,而這支寫 note / ref
        # ——同一個 gate="code-loop" 的歷史紀錄要認兩套欄名才查得全。兩邊都寫。
        "detail": note,
    }
    att = os.environ.get("LUMOS_PUSH_ATTEMPT", "").strip()
    if att:
        ev["attempt_id"] = att[:64]
    if ref:
        # ★這裡刻意不寫 branch★:架構對齊席指出「新事件讀不到」時說了一句
        # 「目前不算功能性錯誤——新事件本來就不該被當成 marker」。
        # ★那句話講的是一個保護,不是一個不一致★——我第一次折的時候把它當成欄名不一致、
        # 順手加了 branch 別名,結果 blocked 事件當場被 _codeloop_read_from_ledger
        # 當成留痕讀走,既有測試翻紅。欄名對齊只做 note/detail 那一半,分支識別不對齊。
        ev["ref"] = ref
    if head_sha:
        ev["head_sha"] = head_sha
    if extra:
        ev.update(extra)
    try:
        with open(docs / ".governance-log.jsonl", "a", encoding="utf-8") as f:
            f.write(_json.dumps(ev, ensure_ascii=False) + "\n")
        return True
    except OSError:
        return False


def _gate_event_or_warn(repo_root, gate, kind, note, **kw):
    """落帳,寫不進去就在 stderr 講一句。★永遠不改變呼叫端的判定★(#19 S7)。"""
    ok = _gate_event(repo_root, gate, kind, note, **kw)
    if ok is None:
        return None          # 這個 repo 沒有治理帳(沒跑過 lumos init)——不適用,不是故障
    if not ok:
      ① `load_vault()`:未閉合圍欄裡的 `[[wikilink]]` ★被當成真的圖譜邊索引進去★
         → 幽靈連結進入持久化的圖結構(backlinks 實測會多報一條)。
      ② `cmd_guard_trace()`:未閉合圍欄裡的測試名 ★被當成合約的真實佐證★
         → 污染 ★INVARIANT★→[test:]→Verification 證據鏈,正好打臉該指令自己的保證。
    逐行 toggle 的語意才是對的:未閉合圍欄之後一律視為 code(隱形),與主搜尋一致。
    ★爆炸半徑(2026-08-03 r3 由 Codex 覆核後修正,原宣稱過強)★:
      ・全庫 220 篇★無任何未閉合圍欄★(兩方各自掃過,一致)
      ・wikilink 邊集合 ★新舊完全相同(差集為空)★
        ★這裡刻意★不寫具體數字★,只寫不變量★——2026-08-03 r4 三位審查員各自
        獨立量,得到 436/382/728、976/728/240 等多組互不相同的值,沒有一個等於
        我原本抄來的「354」(那是 `lumos export --format dot` 的邊數口徑)。
        ★「邊數是多少」取決於你怎麼數(出現次數/去重/含不含 frontmatter/解析前後),
        但「新舊相同」與口徑無關——★該記的是不變量,不是那個數★。
        要自己驗:任選一種口徑,對 `body_clean` 用舊寫法與 `_strip_code_text`
        各算一次邊集合,比差集。
        ★過程檢討:我當初把 r3 審查員報告裡的數字直接抄進 docstring、沒有自己量,
         正是本專案同日剛在圖譜更正過的「數字被沿用進句子」——只是碰巧站得住★
      ・`guard trace` 全 vault 輸出 ★逐字元相同★(67 行,實測 diff)
      ・★但「清洗後文字一個字都不變」這個更強的說法不成立★:33-36 篇不同
        (兩位審查員各自量到 33 與 36,計數口徑略異;方向一致)——新法(逐行
        `lstrip().startswith("```")`)接受★縮排的圍欄★,舊 `FENCE_RE` 只認第 1 欄。
        ★這是與不閉合圍欄★正交★的另一類變化,原本的「爆炸半徑=0」理由沒涵蓋它★;
        方向上新法與主搜尋一致(search 一直都是逐行 lstrip)、也與 CommonMark 一致,
        故判定為修正而非回歸——但★這是事後補的論證,不是原本就驗過的★。
    """
    return "\n".join(pr for _no, _raw, pr in _search_visible_lines(text.split("\n"), include_code))


def _visible_lines(lines, keep_fenced=False):
    """★全檔唯一的 fenced-code 判定實作★:逐行 toggle,回 (行號從1起, 原始行)。

    `keep_fenced=True` 時保留圍欄★內★的文字(但仍跳過 ``` 標記行本身)。

    ★為什麼所有人都必須走這裡(2026-08-03 code-loop r2/r4)★:原本各處自己用
    `FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)`,那個正則有兩個致命假設——
      ① 假設圍欄★成對★:未閉合的圍欄看不見(r2 抓到:幽靈圖譜邊、假合約佐證)
      ② 假設圍欄標記★在第 0 欄★:收尾圍欄一縮排就跟下一個區塊的開頭錯配,
         ★把中間的真散文整段當程式碼吞掉★(r4 抓到,實測某條路徑宣稱直接消失)
    ②的消費端是治理機制本身(refcheck → design-loop 的 G1 硬閘、Edit/Write 前
    自動注入必看合約的 impact hook)——★一個縮排的 ``` 就能把某節點的鐵則警告
    靜默關掉★。逐行 toggle 對兩個假設都免疫。
    
    ★兩段式讀法(2026-09-16 代碼審 r2)★:先照 CommonMark 讀——收尾圍欄後面只能有空白,
    帶語言標記的那行不算收尾(不然巢狀範例裡的樣板會被當成真的)。但這條規則比題目寬:
    收尾★打錯一個字、多敲一鍵★也會變成「關不掉」,後面到檔尾所有內容(含合約行)
    無聲隱形——正是下面警告過的最危險模式換個門長出來。所以規格讀法如果讀完還有圍欄沒關,
    就整份退回寬鬆讀法(同字元、長度夠就算關)。取捨:同一份文件裡同時有巢狀範例★和★
    沒關到的圍欄時,會退回寬鬆、巢狀那題就擋不住——那等於回到 2026-09-16 之前的行為,
    不算退步,而且真的有沒關到的圍欄本來就該先修那個。
    """
    def _scan(strict):
        """回 (看得見的行, 收尾時還有沒有圍欄開著)。strict=照 CommonMark(收尾不得帶東西)。"""
        fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
        # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
        out = []
        for i, ln in enumerate(lines):
            indent = len(ln) - len(ln.lstrip(" "))
            s = ln.lstrip(" ")
            # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
            is_marker = indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))
            if is_marker:
                ch = s[0]
                run = len(s) - len(s.lstrip(ch))
                if fence is None:
                    fence = (ch, run)
                    continue
                if ch == fence[0] and run >= fence[1] and (not strict or s[run:].strip() == ""):
                    fence = None
                    continue
            if fence is not None and not keep_fenced:
                continue
            out.append((i + 1, ln))
        return out, fence is not None

    out, unterminated = _scan(True)
    if unterminated:                      # 規格讀法讀不完 → 退回寬鬆(見說明的取捨)
        for f in code:
            for srel in homes.get(_nodehome_key(f), []):
                systems.add(srel[:-3] if srel.endswith(".md") else srel)
    if systems:   # 落點被碰到:lands_in/related/正文連結任一指向被改的 Systems 節點(跟門判定訊號 2 同一份連結來源)
        for prel, n in env.notes.items():
            if not prel.startswith("Projects/") or str(n.fields.get("status")) != "doing":
                continue
            try:
                ptxt = (env.vault / prel).read_text(encoding="utf-8-sig")
            except (OSError, UnicodeDecodeError):
                ptxt = ""
            if set(_plan_system_links(n, text=ptxt, systems_only=False)) & systems:
                plans.add(prel)
    return plans


def _head_is_shebang(head):
    """檔案開頭那段 bytes 的第一行是不是 #!(每支檔有家與 _is_code_file 共用這一支——代碼審 r2 架構席:別各寫一份)。"""
    return bool(head) and head[:200].split(b"\n", 1)[0].startswith(b"#!")


def _is_code_file(rr, path, base=None):
    """「需要有家的程式檔」判定(每支檔有家同一套):副檔名在清單裡=是;沒副檔名要看首行是不是 #!(.gitignore/Makefile 這種不是)。
    磁碟上沒有(這次被刪)就從範圍起點 base 讀;兩邊都讀不到★保守當程式檔★(代碼審 r2 通才席 blocker:刪掉 hook 本身被判成沒程式檔 → light 漏派審)。
    豁免層也同一套(代碼審 r3 通才席):排除 glob(docs/*、node_modules、bin…)、測試檔、.lumos/config 的 ignore——這些每支檔有家不要求有家,這裡也不算程式檔。"""
    import fnmatch as _fn
    if any(_fn.fnmatch(path, g) for g in _NODEHOME_EXCLUDE_GLOBS) or _nodehome_is_test(path):
        return False
    try:
        if _cochange_excluded(path, _nodehome_config(rr)["ignore"]):
            return False
    except Exception:
        pass
    kind = _nodehome_code_kind(path)
    if kind == "ext":
        return True
    if kind != "shebang?":
        return False
    try:
        with open(Path(rr) / path, "rb") as f:
            return _head_is_shebang(f.read(200))
    except OSError:
        pass
    if base:
        try:
            g = subprocess.run(["git", "-C", str(rr), "show", f"{base}:{path}"], capture_output=True, errors=None)
            if g.returncode == 0:
                return _head_is_shebang(g.stdout[:200])
        except OSError:
            pass
    return True


def _sc_changed_files(rr, git_range, vrel):
    """小改動閘的改動清單 [(新路徑, 新增, 刪除, 二進位, 舊路徑)];算不出回 (None, 原因)。
    用 -z:改名印成 la\tld\t\0舊\0新\0 各自完整欄位(r3 架構席:repo 慣例是 -z + 欄位,不自刻正則解 {a => b};r2 通才席:純改名的大檔不算重寫)。
    帳本/卷證/筆記不算程式改動;★從程式目錄搬進卷證目錄的不豁免★(r3 通才席:路徑前綴是內容無關的過濾器,搬進去就能躲掉四維度)。"""
    try:
        r = subprocess.run(["git", "-C", str(rr), "-c", "core.quotePath=false", "diff", "--numstat", "-z", git_range, "--"], capture_output=True, text=True, errors="replace")
    except OSError as e:
        return None, f"算不出改動量({e})"
    if r.returncode != 0:
        return None, f"範圍 {git_range} 算不出來"
    def _bk(x):
        return x in _BOOKKEEPING_FILES or x.startswith(_BOOKKEEPING_DIRS) or (vrel and x.startswith(vrel + "/"))
    files, toks, i = [], r.stdout.split("\0"), 0
        pass
    log = env.vault.parent / ".signoff-log.jsonl"
    try:
        with open(log, "a", encoding="utf-8") as fh:
            _rec = {"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                    "node": rel, "by": by or "", "note": note, "commit": commit}
            # ★可選的 ref★(必要合約清單_計劃):讓閘能機械比對「這次簽的是哪一個東西」,
            # 不必去自由文字裡撈 id(撈文字最容易寫錯也最容易漏)。沒帶就不寫,既有紀錄與用法不受影響。
            if (ref or "").strip():
                _rec["ref"] = ref.strip()
            fh.write(json.dumps(_rec, ensure_ascii=False) + "\n")
    except OSError as ex:
        print(f"擋下:簽核記錄寫不進去: {ex}", file=sys.stderr)
        return 2
    rc = cmd_set(env, rel, "signed_off", today)
    if rc != 0:
        print("⚠ ledger 已記但 frontmatter 戳記失敗(見上)", file=sys.stderr)
        return rc
    print(f"✓ signoff {rel} — {today}{('(' + by + ')') if by else ''}: {note[:60]}")
    return 0


