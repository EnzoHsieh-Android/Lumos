 21313	def _lint_new_diff_claims(base_claims, head_claims, base_files, head_files):
 21314	    """比差集:同一個指紋出現幾次。★算次數不算有無★——基準版一次、現在版三次就是新增兩條;
 21315	    用「有沒有出現過」會讓複製貼上多出來的問題被吃掉。
 21316	    回 (新增的告警清單, 有幾條是弱比對)。"""
 21317	    from collections import Counter
 21318	    import hashlib as _hl
 21319	    base_text = {f: (_lint_new_read_lines(p) or []) for f, p in base_files.items()}
 21320	    head_text = {f: (_lint_new_read_lines(p) or []) for f, p in head_files.items()}
 21321	    base_count = Counter()
 21322	    for c in base_claims:
 21323	        k, _weak = _lint_new_key(c, base_text)
 21324	        base_count[k] += 1
 21325	    new, weak = [], 0
 21326	    seen = Counter()
 21327	    for c in head_claims:
 21328	        k, is_weak = _lint_new_key(c, head_text)
 21329	        seen[k] += 1
 21330	        if seen[k] > base_count.get(k, 0):
 21331	            c = dict(c)
 21332	            c["key"] = _hl.sha256(k.encode("utf-8")).hexdigest()[:16]
 21333	            c["weak"] = is_weak
 21334	            new.append(c)
 21335	            if is_weak:
 21336	                weak += 1
 21337	    return (new, weak)
