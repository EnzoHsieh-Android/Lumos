   154	    echo "擋下:簽名檔改過了但沒提交,這樣推上去 CI 一定紅。"
   155	    echo "你剛才簽了名(或它被更新過),但那個改動還留在工作目錄裡沒進版控;"
   156	    echo "推送前的檢查看的是工作目錄所以是綠的,CI 看的是推上去的內容,對不起來。"
   157	    echo ""
   158	    echo "把它一起提交再推:"
   159	    echo "       git add $_BASELINE && git commit -m \"gov: 錨點簽名\""
   160	    echo ""
   161	  } >&2
   162	  exit 1
   163	fi
   164	
   165	# ══ 閘的順序(2026-09-06 全 repo 審視 #12 重排)══
   166	# 便宜的先跑、貴的最後。實測:除了全套測試以外,所有閘加起來約 13 秒
   167	# (anchor 0.22s / 簽名檔 0.04s / doctor 1.1s / pitfalls 0.23s / code-loop 0.61s
   168	#  / test-layers 0.21s / 自主迴圈那支 10.3s),而全套是 8 分鐘。
   169	# ★原本全套排在第四位★,所以被那 13 秒裡任何一道擋下時,8 分鐘已經白燒完了。
   170	
   171	# 圖譜健康(只在 vault 存在時跑)
   172	# ★2026-09-06 重排:原本這段在最後面,而且「沒有 vault 就 exit 0」會直接結束整支 hook。
   173	#   現在它排在全套測試之前,那個 exit 0 會把後面的測試閘一起跳掉——所以改成只跳過這一段。
   174	have_vault=0
   175	for d in docs/*-knowledge docs/knowledge; do
   176	  [[ -d "$d" ]] && have_vault=1 && break
   177	done
   178	_TOUCHED_F="$(pp_touched_file)"
   179	_DOCTOR_ARGS=(doctor --ci)
   180	[[ -n "$_TOUCHED_F" ]] && _DOCTOR_ARGS+=(--touched-from "$_TOUCHED_F")
   181	if [[ $have_vault -eq 1 ]] && ! "$PY" "$GRAPHCTL" "${_DOCTOR_ARGS[@]}"; then
   182	  {
   183	    echo ""
   184	    echo "擋下:知識庫健康檢查發現問題(細節在上面)。"
   185	    echo "有問題的筆記推上去,下一個讀它的人會拿到錯的合約或斷掉的連結。"
   186	    echo ""
   187	    echo "三條路選一條:"
   188	    echo "  1. 照上面的提示把筆記修好再推。"
   189	    echo "  2. 覺得是檢查工具本身判錯 → 本機重跑一次確認,真的是工具錯就開一張 Issue 記下來。"
   190	    echo "  3. 真的要先推 → git push --no-verify(CI 還是會跑全套,紅了會看到)"
   191	    echo ""
   192	  } >&2
   193	  exit 1
   194	fi
   195	
   196	
   197	# 代碼偏科 + code-loop 必用守衛(tier=high):push 前把 diff 的代碼形態風險攤在眼前。
   198	# prepush範圍修法(2026-07-21):改讀 stdin 推送範圍逐 ref 判,取代 merge-base——分支與
   199	# main-direct 同軌;無基準(新 ref/缺物件)倒向保守掃 empty-tree..local_sha(非 fail-open,
   200	# 否則守衛升格成穩定繞法);留痕綁 remote_ref 目的地(非 checkout);逐 ref 獨立判,某 ref
   201	# high 未過即擋。fail-open 僅剩:pitfalls 本身出錯 / empty-tree 都跑不動。
   202	# 推送前要跑哪個測試範圍(2026-09-18 Enzo 裁:純文件改動、或判成 light 的小改動,不用等全套):
   203	# 每個 ref 各判一次,任何一個 ref 要全套就全套。docs=只改到 README/docs/assets 這類文件(pitfalls --json 的 suite);
   204	# light=改到程式檔但 spec-gate --push-check 判成 light(風險低計劃、全靠人驗、小改動閘過)。
   205	_SUITE_SEEN=0; _SUITE_FULL=0; _SUITE_LIGHT=0; _SUITE_KEYS=""; _SUITE_GRAPH=0; _AUTOLOOP_FULL=0
   206	for _ppl in ${_PP_LINES+"${_PP_LINES[@]}"}; do
   207	  read -r _lref _lsha _rref _rsha <<< "$_ppl"
   208	  # 刪除遠端 ref(local_sha 全零)→ 無代碼推送,跳過
   209	  [[ "$_lsha" == "$_ZERO" ]] && continue
   210	  # 推導檢查範圍(同一套推導另一個使用者是上面的圖譜健康那一段,所以抽成函式——
   211	  # 兩處各寫一份的話,哪天保守兜底改了只改一邊,擋的範圍就會兩邊不一致)
   212	  _range="$(pp_range_for "$_rsha" "$_lsha")"
   213	  [[ -z "$_EMPTY_TREE" ]] && continue   # 連空樹都算不出=git 環境壞,advisory 放行
   214	
   215	  # 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S26]):把這次要推的範圍整段查一次,接住跳過提交前檢查的。
   216	  # ★新分支不沿用上面的空樹兜底★(那會把整段歷史當新改動,本工具鏈有 1900 多個提交):起點改用
   217	  # 「不在任何遠端分支上的提交」裡最早那一個的上一個提交;全部已在遠端就不查;最早那個沒有上一個提交(真的全新)才從空樹比。
   218	  # 起點早於這道檢查上線的那個提交時,lumos 會自己改從上線點算(上線前進來的是舊帳)。rc1=擋;其他非零=放行。
   219	  # ★跟上面 _range 是刻意不同的兩套★(代碼審 r1 架構席問過):_range 給波及計算與風險掃描用,只提醒、寧可掃多;
   220	  # 這道會擋,把整段歷史當新改動就是誤擋。別把兩套合併成一套。
   221	  _hrange=""
   222	  if [[ "$_rsha" != "$_ZERO" ]] && git cat-file -e "$_rsha" 2>/dev/null; then
   223	    _hrange="$_rsha..$_lsha"
   224	  else
   225	    _hold="$(git rev-list --topo-order --reverse "$_lsha" --not --remotes 2>/dev/null | head -1)"
   226	    if [[ -n "$_hold" ]]; then
   227	      if git rev-parse -q --verify "$_hold^" >/dev/null 2>&1; then
   228	        _hrange="$(git rev-parse "$_hold^")..$_lsha"
   229	      else
   230	        _hrange="$_EMPTY_TREE..$_lsha"
   231	      fi
   232	    fi
   233	  fi
   234	  if [[ -n "$_hrange" ]]; then
   235	    nh_rc=0
   236	    "$PY" "$GRAPHCTL" home check --diff "$_hrange" --repo "$REPO_ROOT" || nh_rc=$?
   237	    if [[ "$nh_rc" -eq 1 ]]; then
   238	      {
   239	        echo ""
   240	        echo "逃生:照上面的指令替檔安家、或把說明改寫進對的那篇,再推;整個專案先改成只提醒 → .lumos/config.json 的 node_home.gate 設成 warn;緊急硬推 git push --no-verify(本機不留痕)。"
   241	        echo ""
   242	      } >&2
   243	      exit 1
   244	    fi
   245	  fi
   246	
   247	  impact_once "$_range"
   248	  pf_json="$("$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --json --repo "$REPO_ROOT" 2>/dev/null || true)"
   249	  _tier_high=0
   250	  printf '%s' "$pf_json" | grep -q '"tier": *"high"' && _tier_high=1
   251	  _SUITE_SEEN=1
   252	  _suite_this="full"
   253	  printf '%s' "$pf_json" | grep -q '"suite": *"docs"' && _suite_this="docs"
   254	  printf '%s' "$pf_json" | grep -q '"suite_graph": *true' && _SUITE_GRAPH=1
   255	  if [[ "$_tier_high" -eq 1 ]]; then
   256	    {
   257	      echo ""
   258	      echo "提醒:這次推送的程式碼裡有高風險寫法(像是沒包交易的寫入、沒關的檔案控制代碼、沒限流的外部呼叫),tier=high。"
   259	      echo "命中的地方列在下面:"
   260	      "$PY" "$GRAPHCTL" pitfalls --diff "$_range" --no-lint --repo "$REPO_ROOT" 2>/dev/null | sed 's/^/    /'
   261	      echo ""
   262	    } >&2
   263	  fi
   264	  # 留痕座標綁 remote_ref 目的地:refs/heads/* → 分支:★無條件★叫 check(表態閘 2026-09-09,Projects/棧別提問表態閘_計劃 S7):
   265	  # 合約測試紅 / 有適用題表態不完整 / tier=high 無留痕,三個獨立判定各自出各自的訊息、由 check 印
   266	  # ——這裡不再自己寫死「跑一輪代碼審」文案、也不再把它的輸出丟 /dev/null(r3 正確性席 C3)。非 heads → advisory。
   267	  # 雙向門放行(Projects/雙向門放行_計劃 S11–S14/S21):這次範圍碰到、仍 doing、有雙向門留痕的計劃,留痕裡的測試全綠才准推;
   268	  # 留痕過期(條款或它連到的節點變了)也擋。風險低計劃不派設計審,這裡是它唯一的閘;lumos 算不出範圍/索引就 fail-open 放行(rc≠1)。
   269	  sg_rc=0
   270	  _sg_out="$_PP_TMP/sg-$RANDOM.log"
   271	  # tee:一邊即時印到 stderr(r1 併發席:先存檔跑完才印,人會以為卡住去 Ctrl-C)、一邊留一份給下面認 light 用;rc 取管線第一段
   272	  "$PY" "$GRAPHCTL" spec-gate --push-check "$_range" --repo "$REPO_ROOT" 2>&1 | tee "$_sg_out" >&2
   273	  sg_rc="${PIPESTATUS[0]}"
   274	  # push-check 判成 light(它才有圖譜、才知道計劃風險低與小改動閘過):改到程式檔也不跑全套,
   275	  # 只跑文件子集 + 原始碼提到「改到的函式/子命令/檔名」的測試;CI 那邊照樣跑全套當後盾。
   276	  # ★還要 pitfalls 說 light_ok★(r1 資安席):小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
   277	  # 會從它眼皮下溜過——範圍裡只要有一支這種檔,就不准少跑全套。
   278	  if [[ "$_suite_this" == "full" ]] && grep -q '改動風險分級:light' "$_sg_out" && printf '%s' "$pf_json" | grep -q '"light_ok": *true'; then
   279	    _suite_this="light"
   280	    _k="$(printf '%s' "$pf_json" | "$PY" -c 'import json,sys; print(",".join(json.load(sys.stdin).get("affected_keys", [])))' 2>/dev/null || true)"
     1	#!/usr/bin/env bash
     2	# SPDX-FileCopyrightText: 2026 Enzo Hsieh
     3	# SPDX-License-Identifier: MIT
     4	# MIT licensed. Full text: scripts/lumos header, or LICENSE at
     5	# https://github.com/EnzoHsieh-Android/Lumos
     6	# Git pre-commit hook — 圖譜同步硬擋 (L2)
     7	#
     8	# 設計理由 (2026-05-25 從 PreToolUse 搬家):
     9	#   舊版 L2 在 Claude Code PreToolUse 攔 `git commit`,但 staged 區在 -a/-am
    10	#   flag 跟 `git commit <path>` 場景下 hook 看到的是空的 (因 -a 在 git 程序內
    11	#   部才 stage), 造成 silent 漏網。教 PreToolUse 解 git command 是追 git 尾巴
    12	#   永遠補不完,根因是「攔截點不對」。改放到 git pre-commit hook,git 內部
    13	#   已決定最終 staged 內容,所有 commit 形態(-a/-am/<path>/--amend)都涵蓋。
    14	#
    15	# Bypass: 用業界標準 `git commit --no-verify` (有儀式感、code review 看得到、
    16	#         比自製 `[no-graph]` marker 難被無意識濫用)
    17	#
    18	# 安裝:
    19	#   git config core.hooksPath scripts/hooks
    20	#   (一次設定,之後 git 自動跑此 hook)
    21	
    22	set -u
    23	
    24	# 找專案 root (避免在 submodule / worktree 出錯)
    25	REPO_ROOT="$(git rev-parse --show-toplevel)"
    26	cd "$REPO_ROOT" || exit 0
    27	
    28	# 找圖譜目錄 (docs/{slug}-knowledge/)
    29	GRAPH_ROOT=""
    30	if [[ -d docs ]]; then
    31	  for d in docs/*-knowledge; do
    32	    [[ -d "$d" ]] && GRAPH_ROOT="$d" && break
    33	  done
    34	  [[ -z "$GRAPH_ROOT" && -d docs/knowledge ]] && GRAPH_ROOT="docs/knowledge"
    35	fi
    36	
    37	# Gate 0: 圖譜不存在 → 放行
    38	[[ -z "$GRAPH_ROOT" ]] && exit 0
    39	
    40	# 拿最終 staged (git 在 pre-commit 時 staged 已確定,-a/-am/path 都涵蓋)
    41	# core.quotePath=off: 避免 git 對中文/non-ASCII 路徑加雙引號 ("docs/.../節點.md"),
    42	# 否則 L65 grep "^${GRAPH_ROOT}/..." 比對不到 → 圖譜檔已 staged 仍誤判為未同步擋下
    43	STAGED="$(git -c core.quotePath=off diff --cached --name-only)"
    44	[[ -z "$STAGED" ]] && exit 0  # 空 commit 不擋
    45	
    46	# Gate CC (advisory): co-change 漏改警告 —— 恆不影響 rc(|| true 隔離)。
    47	# 必須在 Gate 1 之前:後面每條路徑都顯式 exit,「末段」是不可達死碼;
    48	# docs-only commit 在 Gate 2 就 exit 0,唯有這裡能覆蓋主場景(改文件漏同步夥伴)。
    49	# 警告走 stdout(2>/dev/null 只吞診斷,含版本偏斜時舊 vendored lumos 的 argparse 錯)。
    50	CC_PY="$(command -v python3 || command -v python || true)"
    51	if [ -n "$CC_PY" ] && [ -f "$REPO_ROOT/scripts/lumos" ]; then
    52	  "$CC_PY" "$REPO_ROOT/scripts/lumos" cochange check --staged 2>/dev/null || true
    53	else
    54	  echo "提醒:這台機器找不到 python3 或 scripts/lumos,所以「漏改夥伴檔」的提醒這次沒跑。" >&2
    55	fi
    56	
    57	# Gate DG: code 側刪除傳播守衛 (advisory;spec=Projects/code側刪除傳播守衛_計劃)
    58	# 警告走 stdout(2>/dev/null 只吞診斷);|| true 只兜 crash,hang 由 lumos 內部 deadline 兜(fail-open)
    59	# -f 必檢:沒有 scripts/lumos 的 repo(未 vendored)只有 CC_PY 也會跑,python 報「can't open file」
    60	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
    61	  "$CC_PY" "$REPO_ROOT/scripts/lumos" delguard --staged 2>/dev/null || true
    62	fi
    63	
    64	# Gate 1: 圖譜污染指紋 (2026-06-13 對抗審計 P0)
    65	# 攔 notesmd-cli `frontmatter --edit` 的副作用: 日期欄位加引號 (Obsidian property
    66	# 型別 date→text 靜默損傷,且通常伴隨整篇 frontmatter 鍵序重排)。
    67	# 必須放在 Gate 2 之前 — 污染 commit 是 docs-only,Gate 2 的 code 判定對它直接放行。
    68	if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
    69	  polluted="$(git -c core.quotePath=off diff --cached -- "$GRAPH_ROOT" \
    70	    | grep -E '^\+[[:space:]]*(date|created|updated|decided|ended):[[:space:]]*"[0-9]{4}-[0-9]{2}-[0-9]{2}"' || true)"
    71	  if [[ -n "$polluted" ]]; then
    72	    {
    73	      echo ""
    74	      echo "擋下:有筆記的日期欄位被加上了引號(例如 created: \"2026-08-21\")。"
    75	      echo "這幾乎都是某個編輯工具順手改的,不是人打的;它會讓日期欄位變成純文字,而且通常整篇欄位順序都被重排——這種 diff 沒辦法審。"
    76	      echo ""
    77	      echo "被改到的行:"
    78	      echo "$polluted" | head -5 | sed 's/^/   /'
    79	      echo ""
    80	      echo "看完整改動:"
    81	      echo "   git diff --cached -- ${GRAPH_ROOT}"
    82	      echo "還原那個檔:"
    83	      echo "   git checkout -- <檔案>"
    84	      echo "真的是刻意要這樣(非常少見)→ git commit --no-verify"
    85	      echo ""
    86	    } >&2
    87	    exit 1
    88	  fi
    89	fi
    90	
    91	# Gate L: staged 圖譜 .md 逐檔 lumos lint (2026-08-21 體檢 #6)
    92	# 為什麼:lint 自 2026-06 起沒有任何 hook/CI 呼叫,它的每條鐵則(YAML list/白名單/枚舉/frontmatter
    93	# 閉合)全靠人記得跑——「有機制,沒接線」。硬擋:lint rc≠0 即擋,訊息原樣轉出。
    94	# 只跑 staged 的圖譜檔(每檔 <1s),不跑全 vault。找不到 python/lumos → 跳過(與 Gate CC 同語意)。
    95	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
    96	  lint_fail=0
    97	  while IFS= read -r f; do
    98	    [[ -z "$f" ]] && continue
    99	    [[ -f "$f" ]] || continue          # 刪除的檔不 lint
   100	    # ★傳 vault 相對路徑、去 .md★——lumos lint 的精確比對鍵是 vault 相對的「Systems/foo」;
   101	    # 丟 repo 相對路徑會落到 stem 查找,同檔名不同資料夾時 lint 到別的節點、壞的放行(code-loop r1 s1)。
   102	    rel="${f#$GRAPH_ROOT/}"; rel="${rel%.md}"
   103	    if ! out="$("$CC_PY" "$REPO_ROOT/scripts/lumos" lint "$rel" 2>&1)"; then
   104	      lint_fail=1
   105	      { echo ""; echo "擋下:這篇筆記的格式檢查沒過——$f"; echo "$out" | sed 's/^/   /'; } >&2
   106	    fi
   107	  done < <(echo "$STAGED" | grep -E "^${GRAPH_ROOT}/.*\.md$" || true)
   108	  if [[ "$lint_fail" == 1 ]]; then
   109	    { echo ""; echo "格式錯的筆記進了版控,之後的工具會讀錯(合約標記消失、連結變鬼節點)。照上面的提示修好再 commit。"; echo "真的要先進去 → git commit --no-verify,並在訊息裡留一句為什麼。"; echo ""; } >&2
   110	    exit 1
   111	  fi
   112	fi
   113	
   114	
   115	# Gate H: 每支檔有家(2026-09-11,Projects/每支檔有家_計劃 [S25]):每支程式檔要有一篇管它的節點、
   116	# 節點只准寫自己家的檔、寫回要落在改動檔的家——新違規擋,舊帳交給健檢提醒。判定全在 lumos 裡,這裡只呼叫。
   117	# ★要放在「改程式沒動圖譜」那道之前★:那道只要有圖譜筆記加進索引就提早放行離開,放後面等於只在最不需要的時候才跑。
   118	# 合併提交由 lumos 自己判斷跳過(推送前會把合併的結果整段查一次)。
   119	# 「該動哪篇」的點名(原本在這裡呼叫 impact --sync-only,以反引號為種子)也改由它照家算——
   120	# 反引號那一套會把人推回寫了一堆別人檔名的大雜燴節點(計劃「為什麼」第 3 條)。
   121	# rc1=新違規擋;其他非零(lumos 自己出錯)=放行,這道不因為環境壞了擋人。
   122	if [[ -n "${CC_PY:-}" && -f "$REPO_ROOT/scripts/lumos" ]]; then
   123	  nh_rc=0
   124	  "$CC_PY" "$REPO_ROOT/scripts/lumos" home check --staged --repo "$REPO_ROOT" || nh_rc=$?
   125	  [[ "$nh_rc" -eq 1 ]] && exit 1
   126	fi
   127	
   128	# Gate 2: code 副檔名 (對齊 check-graph-sync.py CODE_EXTS)
   129	CODE_EXTS_RE='\.(cs|vue|js|ts|tsx|jsx|mjs|sql|py|kt|kts|java|swift|go|rs|c|cc|cpp|h|hpp|sh|ps1)$'  # sh/ps1 2026-08-21 補(體檢 #7);各份清單由 t_code_exts_lists_agree 釘
   130	
   131	# 排除路徑
   132	is_shebang_code() {   # 沒副檔名的檔:看 staged 內容首行是不是 #!(2026-09-05 README 審視 d1:scripts/lumos 這種主程式五月起 26 次漏過)
   133	  local path="$1" base
   134	  # git 對含 " \ 或控制字元的檔名會印成 C 式引號("a\"b");拿去 git show 會找不到 → 先解引號(r2 delta major)
   135	  if [[ "$path" == \"*\" && ${#path} -ge 2 ]]; then   # 長度守衛:單一個引號的假輸入不做子字串(r3 delta minor,set -u 下會吐錯)
   136	    path="${path:1:${#path}-2}"; path="${path//\\\"/\"}"; path="$(printf '%b' "$path")"   # \" 手解;\\ \t \ooo(控制字元)交給 printf %b(r3 外家:八進位沒解 → 找不到 → 放行)
   137	  fi
   138	  base="${path##*/}"; base="${base#"${base%%[!.]*}"}"; [[ "$base" == *.* ]] && return 1   # 去掉所有開頭的點再看有沒有副檔名(.pythonrc、..foo 也要看 shebang)
   139	  local first; first="$(git show ":$path" 2>/dev/null | head -c 200 | head -n 1)" || return 1
   140	  [[ "$first" == "#!"* ]]   # 任何 shebang 都算(不列直譯器清單:r1 外家 #!/bin/dash 漏判;各處同一條規則,由 t_code_exts_lists_agree 釘)
   141	}
   142	should_exclude() {
   143	  local path="$1"
   144	  case "$path" in
   145	    docs/*|*/node_modules/*|*/bin/*|*/obj/*|*/.git/*|*/dist/*|*/build/*|*/__pycache__/*) return 0;;
   146	    *package-lock.json|*yarn.lock|*pnpm-lock.yaml) return 0;;
   147	    # vendored 工具白名單(lumos 自有物,例行 lumos update 不該撞圖譜閘;2026-07-25)。
   148	    # ★精確白名單,非 scripts/* 整夾★——專案自有 scripts/foo.py 仍照擋。
   149	    # ★源 repo 守門★:在 Lumos 來源 repo 本身(有 skills/lumos-project-notes),這些檔=產品碼,
   150	    # 豁免不適用(否則源 repo 自家改 scripts/lumos 不帶圖譜會靜默放行=弄弱自家閘)。
   151	    # 與 scripts/lumos 的 _VENDORED_TOOLKIT 常數同源;漂移守衛 t_precommit_whitelist_drift_guard。
   152	    scripts/lumos|scripts/test_lumos.py|scripts/merge-claude-settings.py|scripts/graph-rename.sh|scripts/fetch-notesmd.sh|scripts/hooks/*|scripts/templates/*)
   153	      [[ -d "skills/lumos-project-notes" ]] && return 1   # 源 repo:不豁免
   154	      return 0;;
   155	  esac
   156	  return 1
   157	}
   158	
   159	src_files=()
   160	while IFS= read -r f; do
   161	  [[ -z "$f" ]] && continue
   162	  if ! [[ "$f" =~ $CODE_EXTS_RE ]] && ! is_shebang_code "$f"; then continue; fi
   163	  if should_exclude "$f"; then continue; fi
   164	  src_files+=("$f")
   165	done <<< "$STAGED"
   166	
   167	# Gate 2: 沒 code → 放行
   168	[[ ${#src_files[@]} -eq 0 ]] && exit 0
   169	
   170	# Gate 3: 有圖譜 .md staged → 放行(「該動卻沒動」的點名已由上面的 Gate H 照家算好印出,2026-09-11)
   171	if echo "$STAGED" | grep -qE "^${GRAPH_ROOT}/.*\.md$"; then
   172	  exit 0
   173	fi
   174	
   175	# ── 印警告並擋 ──
   176	{
   177	  echo ""
   178	  echo "擋下:這次 commit 改了程式碼,但知識筆記一個字都沒動。"
   179	  echo "程式碼記的是「現在長怎樣」,筆記記的是「為什麼這樣做」——只改其中一邊,下一個人(或下一個 session 的 Claude)就會拿舊的理由去理解新的程式碼。"
   180	  echo ""
   181	  echo "這次改到的程式碼(${#src_files[@]} 個):"
   182	  for f in "${src_files[@]:0:10}"; do echo "   • $f"; done
   183	  if [[ ${#src_files[@]} -gt 10 ]]; then
   184	    echo "   … 還有 $(( ${#src_files[@]} - 10 )) 個"
   185	  fi
   186	  echo ""
   187	  echo "筆記放在這個資料夾,這次沒有任何一篇被加進 commit:"
   188	  echo "   ${GRAPH_ROOT}/"
   189	  echo ""
   190	  echo "通常要跟著改的是:受影響功能的說明(Systems)、這次驗證了什麼(Verification)、相關問題單的狀態(Issues)。"
     1	name: CI
     2	# 獨立信任根(2026-07-29 Codex 外審 P0):本機 hooks 可繞(--no-verify/缺環境降級放行),
     3	# 這裡是 push 後必跑的後盾——pre-push 提示裡的「CI 仍會抓」由本 workflow 兌現。
     4	on:
     5	  push:
     6	    branches: [main]
     7	  pull_request:
     8	
     9	jobs:
    10	  test:
    11	    runs-on: ubuntu-latest
    12	    timeout-minutes: 45   # 2026-09-12:全套單行程跑到 30 分被砍(前幾次 25–27 分,一路逼近上限);切片後約 10 分,上限留餘裕
    13	    steps:
    14	      - uses: actions/checkout@v4
    15	        with:
    16	          fetch-depth: 0   # code-loop gate 要算 before..sha 的 diff(體檢 #5)
    17	      - uses: actions/setup-python@v5
    18	        with:
    19	          python-version: "3.12"
    20	      - name: Compile check
    21	        run: python -m compileall -q scripts/lumos scripts/test_lumos.py
    22	      - name: SyntaxWarning 歸零閘
    23	        run: python -W error::SyntaxWarning -c "compile(open('scripts/lumos').read(),'lumos','exec'); compile(open('scripts/test_lumos.py').read(),'t','exec')"
    24	      # 2026-09-12:全套在 CI 單行程跑要 25–30 分鐘,已經撞到 job 上限被砍(8a45751b)。
    25	      # 推送前掛鉤早就把它切成幾片同時跑,CI 照同一支旗標切——不改測試內容、只改跑法;
    26	      # 任何一片紅就整步紅,而且把每一片的尾端印出來(不然只看得到「有片紅了」)。
    27	      # 2026-09-18(Enzo 裁「像這種改動 CI 可以跳過吧,跟程式碼無關」):push 事件先問 lumos 這段推送改到什麼——
    28	      # 只改到 README/docs/assets 這類文件(pitfalls --json 的 suite=docs)就只跑文件子集(原始碼提到那些路徑的測試);
    29	      # 碰到程式、skills、workflow 任何一支都跑全套。判不出來(首推、force-push 對不到起點、lumos 出錯)一律全套——
    30	      # 保守方向是多跑,不是少跑。pull_request 事件沒有 before,也是全套。
    31	      - name: 這次推送要跑哪個測試範圍
    32	        id: suite
    33	        env:
    34	          BEFORE: ${{ github.event.before }}
    35	          SHA: ${{ github.sha }}
    36	        run: |
    37	          suite=full; why="不是 push 事件或起點對不到"
    38	          if [ "${{ github.event_name }}" = push ] && [ -n "$BEFORE" ] && [ "$BEFORE" != "0000000000000000000000000000000000000000" ] \
    39	             && git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
    40	            out="$(python scripts/lumos pitfalls --diff "$BEFORE..$SHA" --no-lint --json --repo . 2>/dev/null || true)"
    41	            s="$(printf '%s' "$out" | python -c 'import json,sys; d=json.load(sys.stdin); print(d.get("suite","full")); print(d.get("suite_reason","")); print("graph" if d.get("suite_graph") else "")' 2>/dev/null || printf 'full\nlumos 算不出來\n')"
    42	            suite="$(printf '%s' "$s" | sed -n 1p)"; why="$(printf '%s' "$s" | sed -n 2p)"; graph="$(printf '%s' "$s" | sed -n 3p)"
    43	            [ "$suite" = docs ] || suite=full
    44	          fi
    45	          echo "suite=$suite" >> "$GITHUB_OUTPUT"
    46	          echo "graph=$graph" >> "$GITHUB_OUTPUT"
    47	          echo "測試範圍:$suite($why)"
    48	      - name: Full test suite (切 4 片同時跑;純文件推送只跑文件子集)
    49	        env:
    50	          SUITE: ${{ steps.suite.outputs.suite }}
    51	          GRAPH: ${{ steps.suite.outputs.graph }}
    52	        run: |
    53	          set -u
    54	          rc=0
    55	          extra=""
    56	          if [ "$SUITE" = docs ]; then extra="--suite docs"; echo "純文件推送:只跑文件子集(--suite docs),不跑全套"; fi
    57	          if [ "$SUITE" = docs ] && [ "$GRAPH" = graph ]; then extra="$extra --graph"; echo "含圖譜筆記:加跑讀真圖譜的測試(--graph)"; fi
    58	          for i in 1 2 3 4; do
    59	            python scripts/test_lumos.py --shard "$i/4" $extra > "/tmp/shard-$i.log" 2>&1 &
    60	          done
    61	          for job in $(jobs -p); do wait "$job" || rc=1; done
    62	          for i in 1 2 3 4; do
    63	            echo "===== 第 $i 片 ====="
    64	            # 紅的時候先把失敗那幾行撈出來——tail 只看得到尾巴,而紅的那支通常在中間,
    65	            # 以前紅了要靠猜是哪一支(2026-09-15 實際踩到:CI 紅、本機全綠、查不出名字)
    66	            if grep -qE "^  ✗|, [1-9][0-9]* failed" "/tmp/shard-$i.log"; then
    67	              echo "--- 這一片紅了,以下是失敗的斷言與所在測試 ---"
    68	              grep -nE "^  ✗|EXCEPTION" "/tmp/shard-$i.log" | tail -40 || true
    69	              echo "--- 失敗處前後文 ---"
    70	              # ★這裡的 || true 不是裝飾★(2026-09-15 審查席抓到):撈不到就回非零,
    71	              # 目前這步的殼是 bash -e 沒有 pipefail、管線末端是 while 所以不會中止;
    72	              # 但只要有人把這步改成 shell: bash(預設帶 pipefail),沒接住就會★整步當場死掉★,
    73	              # 連還沒印的片都一起失聲,比改動前更糟。實測過兩種殼,差別就在這個旗標。
    74	              # 另外要認得逾時/零斷言/跳過判紅——那三種紅不印 FAILED 也不印 EXCEPTION,
    75	              # 而它們正是「CI 紅、本機綠」最常見的成因,漏掉等於在最該用的場合失效。
    76	              grep -nE "^  ✗ (FAILED|TIMEOUT|判紅)|EXCEPTION|^  ✗ .*一條斷言都沒有" \
    77	                "/tmp/shard-$i.log" | head -3 | cut -d: -f1 | while read ln; do
    78	                sed -n "$((ln>12 ? ln-12 : 1)),$((ln+3))p" "/tmp/shard-$i.log"
    79	              done || true
    80	              echo "--- 以下是該片尾端 ---"
    81	            fi
    82	            tail -25 "/tmp/shard-$i.log"
    83	          done
    84	          exit $rc
    85	      # 2026-08-29 接線:這支的 106 個測試先前沒有任何自動路徑在跑(CI 與 pre-push 都只跑
    86	      # test_lumos.py),而它是 autonomous_loop 十個模組中九個的唯一覆蓋,且早已在 anchor
    87	      # 基準線裡被防竄改守著——綠紅沒人看,卻有人守。
    88	      - name: 自主迴圈測試
    89	        # 純文件推送只跑讀真 CLAUDE.md 的那一條(144 支裡只有它讀 repo 的文件;整支 63 秒)——跟推送前掛鉤同一條規則
    90	        env:
    91	          SUITE: ${{ steps.suite.outputs.suite }}
    92	        run: |
    93	          extra=""
    94	          if [ "$SUITE" = docs ]; then extra="-k real_claude_md"; fi
    95	          python scripts/test_autonomous_loop.py $extra
    96	      - name: Graph doctor (strict)
    97	        run: python scripts/lumos doctor --ci
    98	      - name: code-loop gate (push 後盾;體檢 #5)
    99	        # `git push --no-verify` 會整個跳過 pre-push——測試/doctor/anchor 這裡都已重跑,唯獨 tier=high
   100	        # 的對抗審查閘與表態閘(2026-09-09)沒人補查,繞過零留痕。本步在 push 事件重算 pitfalls tier/適用題並比對留痕:
   101	        # rc1=高風險 diff 無 pass/skip 留痕 → CI 紅(可見的痕跡;ci-wait/ci-log 會收到)。
   102	        if: github.event_name == 'push'
   103	        env:
   104	          LUMOS_SKIP_BOUND_TESTS: "1"   # 受波及合約測試在本機 pre-push 真跑;CI 已跑全套當後盾,不重跑
   105	          BEFORE: ${{ github.event.before }}
   106	          SHA: ${{ github.sha }}
   107	          BRANCH: ${{ github.ref_name }}
   108	        run: |
   109	          EMPTY=4b825dc642cb6eb9a060e54bf8d69288fbee4904
   110	          case "$BEFORE" in 0000000000000000000000000000000000000000|"") BEFORE="$EMPTY";; esac
   111	          git cat-file -e "$BEFORE^{commit}" 2>/dev/null || BEFORE="$EMPTY"
   112	          echo "range: $BEFORE..$SHA branch=$BRANCH"
   113	          python scripts/lumos code-loop check --diff "$BEFORE..$SHA" --at-sha "$SHA" --branch "$BRANCH" --repo . || {
   114	            rc=$?
   115	            if [ "$rc" -eq 1 ]; then
   116	              echo "::error::code-loop check 擋下(原因在上面:合約測試紅 / 效能檢核題沒表態 / 高風險代碼無審查留痕)——本機 pre-push 被繞過(--no-verify)或留痕失效;照上面 check 印的指令補留痕(dispositions / pass|skip --note)後重推"
   117	              exit 1
   118	            fi
   119	            exit "$rc"
   120	          }
   121	      - name: Anchor verify (baseline 缺失必紅)
   122	        run: |
   123	          test -f governance/anchor-baseline.json || { echo "anchor baseline 缺失"; exit 1; }
   124	          python scripts/lumos anchor verify

