_INIT_SUBDIRS_FULL = ("Systems", "Verification", "Projects", "Issues", "Sessions", "MOC")


def _scaffold_project(root: Path, slug: str):
    kg = root / "docs" / f"{slug}-knowledge"
    if kg.exists():
        print(f"  ✓ vault 已存在,跳過 scaffold(保護資料): {kg}")
        return
    for d in _INIT_SUBDIRS_FULL:
        (kg / d).mkdir(parents=True, exist_ok=True)
    _write_lf(kg / "MOC" / "index.md",
              f"---\ntype: moc\nstatus: doing\n---\n# {slug} 知識圖譜總索引\n")
    # ★帳檔落在 docs/(vault.parent,見 _append_governance_log 等),.gitignore 必須寫在同一層★——
    # 2026-06-26 起一直寫在 vault 內,對上一層的帳檔一個都沒忽略到(L4 清帳 2026-08-21 抓到:
    # 本 repo 帳檔因此全被追蹤,筆記「皆 gitignore」長期為假)。改寫到 docs/.gitignore;
    # 既有 repo 已追蹤的帳檔不受影響(gitignore 不 untrack),要不要 untrack 是另一個決定。
    # ★治理帳不在忽略清單裡★(消費專案接入靜默失效 [D]/[S6],2026-09-09):
    # 它是 CI 唯一讀得到表態與留痕的地方(_codeloop_read_from_ledger 的 docstring、
    # Systems/棧別提問表態閘 都這樣寫),忽略掉等於新專案接 CI 時那條路直接斷。
    # 其餘帳檔仍是本機流水,照舊忽略。
    _write_lf(kg.parent / ".gitignore",
              "# 本機流水帳(不進版控);★治理帳 .governance-log.jsonl 刻意不在這裡★——\n"
              "# CI 靠它讀代碼審留痕與棧別提問表態,忽略掉那條路就斷了。\n"
              ".bypass-log.jsonl\n.rot-queue.jsonl\n.canary-log.jsonl\n"
              ".kill-log.jsonl\n.signoff-log.jsonl\n.usage-log.jsonl\n.ci-log.jsonl\n")
    print(f"  ✓ scaffold {kg}(帳檔 .gitignore → {kg.parent / '.gitignore'})")


def _init_additive_setup(root: Path):
    """init 每一條路都要跑的「只加不覆寫」設定(★既有專案也拿得到★)。

    ★為什麼要從 scaffold 裡搬出來★(2026-09-09 r1 架構對齊席 f2):
    這兩樣本來寫在 _scaffold_project 裡,而那支開頭就是「vault 已存在 → 直接 return」,
    外面的 cmd_init 又對「已有 vault 且沒帶 --force」更早 return。兩層 guard 的用意都是
    ★保護既有 vault 的內容不被覆寫★——但新的產出借用同一把鎖等於被連坐:
    所有本來就有 vault 的既有消費專案(這批修的正是這種專案的接入靜默)不論怎麼跑 init
    都拿不到設定骨架與本機留痕的忽略設定。
    這兩件事本身都是「檔案不存在才寫」,不會覆寫任何東西,所以不需要那把鎖。"""
    # ★本機執行期狀態要忽略★:留痕/表態的 marker 綁著當下的版本號,
    # 提交出去等於把「某台機器某個時刻的狀態」散播給所有人,而且一提交版本就移動、自己作廢。
    gov_ignore = root / "governance" / ".gitignore"
    if not gov_ignore.exists():
        gov_ignore.parent.mkdir(parents=True, exist_ok=True)
        _write_lf(gov_ignore,
                  "# 這底下是 per-machine 的執行期狀態,不版控、不跨機當權威\n"
                  "# (CI 讀的是 docs/.governance-log.jsonl,那份刻意沒被忽略)。\n"
                  "# code-loop:代碼審留痕與棧別提問表態的本機標記,綁 HEAD 版本號——一提交版本就移動、自己作廢。\n"
                  "# runtime:hook 事件流水,每台機器各自的事實。★2026-09-09 補★:第一版漏了它,\n"
                  "# 而第一個接入的真專案(calc-ios)因此把 hook-events.jsonl 提交進版控。\n"
                  "code-loop/\n"
                  "runtime/\n")
        print(f"  ✓ 本機留痕的忽略設定 {gov_ignore}")
    _init_config_skeleton(root)


