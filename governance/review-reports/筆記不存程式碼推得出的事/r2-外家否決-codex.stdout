def _lens_git(repo_root, *args, quote=False, binary=False):
    """binary=True:輸出照位元組回(不解碼)——讀檔案內容算指紋用,非 UTF-8 的內容也不會在解碼時噴錯。"""
    import subprocess as _sp
    cmd = ["git", "-C", str(repo_root)]
    if quote:
        cmd += ["-c", "core.quotePath=false"]
    try:
        if binary:
            return _sp.run(cmd + list(args), capture_output=True, timeout=20)
        return _sp.run(cmd + list(args), capture_output=True, text=True, errors="replace", timeout=20)
    except (OSError, _sp.TimeoutExpired):
        return None


def _lens_full_sha(repo_root, rev):
    r = _lens_git(repo_root, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
    if r is None or r.returncode != 0:
        return None
    sha = r.stdout.strip()
    return sha if _LENS_SHA_RE.match(sha) else None


def _mainline_ref(repo_root):
    """主線 tip:本地 main/master 的 upstream 優先(r3:remote 未必叫 origin),沒設 upstream 才用本地分支。
    回 (ref 名, sha) 或 None。"""
    for cand in ("main@{upstream}", "master@{upstream}", "main", "master"):
        sha = _lens_full_sha(repo_root, cand)
        if sha:
            return cand, sha
    return None


def _lens_dispositions_lines(lines, rec):
    """派工鏡頭附表態記錄(表態閘 S8):只列人答的題(未觸發自動 na 只給個數);工具驗過錨點存在、沒驗答案對不對——審查席反駁的就是這些答案。回人答題數。"""
    disp = rec.get("dispositions") or {}
    human = [(q, e) for q, e in disp.items() if isinstance(e, dict) and not e.get("auto")]
    n_auto = sum(1 for e in disp.values() if isinstance(e, dict) and e.get("auto"))
    lines.append(f"[表態記錄(棧別效能檢核;分支 {rec.get('branch')},版本 {str(rec.get('head_sha') or '')[:8]})——寫入時工具只驗了形狀,證據存不存在要到推送前 code-loop check 才驗,答案對不對沒人驗]")
    for q, e in human:
        st = e.get("status")
        tail = (str(e.get("evidence") or "") if st == "satisfied"
                else (str(e.get("issue") or "") + " " + str(e.get("reason") or "")) if st == "todo"
                # tension 四欄都給審查席看——反駁的就是這四欄(2026-09-09 兩席相反時端出張力;「｜」分隔是編排者裁的,四欄需要分隔)
                else (f"選 {e.get('chosen') or ''}｜既有 {', '.join(str(x) for x in (e.get('existing') or []))}｜隱患 {e.get('hazard') or ''}｜建議 {e.get('suggestion') or ''}") if st == "tension"
                else str(e.get("reason") or ""))   # 全部 str(… or ""):治理帳重建來的紀錄不重驗形狀,缺欄不能炸(r1 正確性席 f3)
        lines.append(f"  {q} {st} — {str(tail)[:200]}")
    if n_auto:
        lines.append(f"  (另有 {n_auto} 題未觸發、工具自動記不適用)")
    return len(human)


def _lens_cache_path(repo_root, base_sha, head_sha, extra=""):
    import hashlib
    # repo 部分用 realpath(跟 armed 檔的 _lens_repo_key 同一種算法;code-codex-s1 r1 架構席:兩套 key 並存)
    # extra=表態記錄的 sha256(表態閘 S8):重表態之後舊快取自然 miss
    key = hashlib.sha256(f"{os.path.realpath(str(repo_root))}|{base_sha}|{head_sha}|schema{_LENS_SCHEMA}|{extra}".encode("utf-8")).hexdigest()   # 帶 schema 版本:v1.1 舊快取自然 miss(v1.2 r2 外家)
    return Path.home() / ".cache" / "lumos" / "dispatch-lens" / f"{key}.json"


def _lens_cache_read(path, ttl_sec=1200):
                break
        if bad is not None:
            print(f"  ⚠ {rel} 拿 {bad} 失敗:這篇 stamp 保留、不算撤成功,其餘繼續", file=sys.stderr)
            failed += 1
            continue
        if cmd_remove(env, rel, "about_code_stamp", None) == 0:   # 走有上鎖的入口(第四輪併發資源席:原本直接呼叫底層函式、繞過寫入鎖)
            done += 1
        else:
            failed += 1
    tail = f",{failed} 篇失敗(stamp 還在,修好再跑一次)" if failed else ""
    print(f"✓ about-code revert:撤了 {done} 篇(批次 {want}){tail}")
    return 0 if failed == 0 and done == len(targets) else 1


def _fm_of(all_lines):
    """從完整檔行抽 frontmatter 行(供 decision 自驗用 parse_decisions 重解)。"""
    for i in range(1, len(all_lines)):
        if all_lines[i].strip() == "---":
            return all_lines[1:i]
    return all_lines[1:]


def _fmt_decision_value(v):
    """decision 子欄位值格式化:跟 fmt_scalar 共用同一套白名單與加引號規則(2026-09-26 代碼審 r2 架構席:
    原本是第三套手刻判準,結尾裸冒號讓標準 YAML 報錯、含「: 」又有雙引號的寫不進去)。"""
    v = v.strip()
    return v if _yaml_plain_ok(v) else _yaml_quote(v, "決策內容")


def cmd_decision_supersede(env, rel, match, by, ended=None):
    """T3 巢狀手術:把 decisions[] 中 content 含 match 的決策標 valid:false + 補
    superseded_by/ended。surgical line-based(不重序列化,最小 diff;優於 ruamel reflow)。
    [P1]:ended 缺則自動補今日 + 同步 bump 頂層 updated(單次 atomic,供 E2 時序法)。"""
    import datetime
    if ended and not DATE_RE.match(ended):
        raise ValueError(f"--ended 要寫成 年-月-日(例如 2026-08-22),你給的是 {ended}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    if loc is None:
        raise ValueError("這篇筆記還沒有任何決策紀錄(decisions)")
    if not loc[2]:  # block 存在但解析不到項目(Bug2:0-indent / 非標準縮排)
        raise ValueError("決策區塊(decisions)讀不出任何一條,通常是縮排不對:工具只認兩個空白的縮排,不認 tab 或不縮排")
    _, _, items, _, sub = loc
    pad = " " * sub
    needle = nfc(match)
    id_mode = re.fullmatch(r"#d\d+", match.strip())
    if id_mode:
        # [M1/R12] #dN 精確定址:比對項內 id 行
        want = match.strip()[1:]
        hits = [(st, en) for (st, en) in items
                if any(re.match(rf"^{pad}id:\s*{re.escape(want)}\s*$", fm[i])
                       for i in range(st, en + 1))]
        if not hits:
            raise ValueError(f"找不到編號 {match} 的決策,可能這篇的決策還沒編號;先跑:\n    lumos decision-reindex {rel}")
    else:
        hits = [(st, en) for (st, en) in items
                if needle in nfc("\n".join(fm[st:en + 1]))]
        if not hits:
            raise ValueError(f"找不到內容含「{match}」的決策")
        if len(hits) > 1:
            # [M1/R12] 選擇端唯一命中:first-match 會「先改錯項、再用錯項 id 精確驗證它改成功」
            cands = "; ".join(first_line(fm[st].split("content:", 1)[-1].strip(), 40)
                              for (st, _) in hits[:5])
            raise ValueError(f"「{match}」命中 {len(hits)} 條決策,分不清要改哪條,不敢亂猜。"
                             f"候選: {cands} …改用更長的片段,或用 --match \"#dN\" 指定編號")
    st, en = hits[0]
    valid_line = None
    for i in range(st, en + 1):
        if re.match(rf"^{pad}valid:\s", fm[i]):   # 只認精確 sub_indent(Bug5:移除過寬 fallback,免誤命中子清單)
            valid_line = i
            break
    if valid_line is None:
        raise ValueError("這條決策沒有 valid 欄位(或縮排不是兩個空白),工具不敢自動翻案,請手動處理或先修結構")
    # Bug3: 已 superseded 不重插(免重複鍵)。同 sub_indent 已有 superseded_by → 拒
    for i in range(st, en + 1):
        if re.match(rf"^{pad}superseded_by:\s", fm[i]):
            raise ValueError("這條決策已經被翻案過了(有 superseded_by),不重複翻;要改成被誰取代請手動編輯")
    fm[valid_line] = f"{pad}valid: false"
    # [P1] ended 選填 → 缺則自動補今日(E2 時序法要 ended 才判得了「鄰居晚於翻案沒?」)
    if not ended:
        ended = datetime.date.today().isoformat()
    ins = [f"{pad}superseded_by: {_fmt_decision_value(by)}", f"{pad}ended: {ended}"]
    fm[valid_line + 1:valid_line + 1] = ins
    # [P1] supersede = 對本節點的實質編輯 → 同步 bump 頂層 updated(單次 atomic,同一份 fm;
    #   不串第二個寫命令避免半完成)。有則就地換、無則插在 decisions: 前(不動決策區索引)。
    today = datetime.date.today().isoformat()
    upd_i = next((k for k, ln in enumerate(fm) if re.match(r"^updated:\s", ln)), None)
    if upd_i is not None:
        fm[upd_i] = f"updated: {today}"
    else:
        dec_i = next((k for k, ln in enumerate(fm) if re.match(r"^decisions:\s*$", ln)), len(fm))
        fm[dec_i:dec_i] = [f"updated: {today}"]
    new_lines = lines[:1] + fm + lines[e_fm:]
    # [M1/P2] 讀 target 的 id → 組全域格式 <rel>#d<N> 回傳(下游 header/CASCADE/--from 同格式,無裸碼流出)
    did = None
    for i in range(st, en + 1):
        m = re.match(rf"^{pad}id:\s*(d\d+)\s*$", fm[i])
        if m:
            did = m.group(1)
            break
    gid = f"{rel}#{did}" if did else None

    def _check(_fields):
        for d in parse_decisions(_fm_of(new_lines)):
            # [M1] 有 id → ID 精確驗證(content 子字串重疊會驗錯項);無 id(未 reindex 舊節點)→ 退回 content 驗證
            hit = (str(d.get("id", "")).strip() == did) if did \
                else (needle in nfc(str(d.get("content", ""))))
            if hit:
                return str(d.get("valid", "")).lower() == "false" and "superseded_by" in d
        return False
    atomic_write_verify(path, new_lines, "decisions", _check)
    _tag = f" [{gid}]" if gid else ""
    print(f"✓ supersede {rel}: 決策「{match[:30]}」→ valid:false + superseded_by + ended={ended} (updated bump {today}){_tag}")
    return 0, gid


def _max_decision_id(fm_lines):
    """[M1/P2] 掃 decisions[] 既有 id: d<N>,回最大 N(無則 0)。新號=max+1(不重排既有、
    不回收缺號——ID 穩定性合約:翻案後永不重用)。"""
    mx = 0
    for d in parse_decisions(fm_lines):
        m = re.fullmatch(r"d(\d+)", str(d.get("id", "")).strip())
        if m:
            mx = max(mx, int(m.group(1)))
    return mx


def cmd_decision_add(env, rel, content, decided, context=None, why=None):
    """T3 巢狀手術:append 一條新 ADR 決策到 decisions[](無則建)。surgical line-based。
    [M1/P2]:指派穩定 id d<max+1> 並回傳 (rc, 全域決策id <rel>#d<N>);dispatcher 解包後
    CLI 對外仍只回整數 rc。"""
    if not DATE_RE.match(decided):
        raise ValueError(f"擋下:--decided 要寫成 年-月-日(例如 2026-08-22),你給的是 {decided}")
    path = env.vault / rel
    lines, s_fm, e_fm = load_raw_for_edit(path)
    fm = lines[1:e_fm]
    loc = decisions_items(fm)
    new_id = f"d{_max_decision_id(fm) + 1}"
    if loc is None:
        # 無 decisions key → 在 fm 末尾建
        item_indent, sub = 2, 4
        block = [f'{" "*item_indent}- content: {_fmt_decision_value(content)}',
                 f"{' '*sub}id: {new_id}"]
        if context:
            block.append(f'{" "*sub}context: {_fmt_decision_value(context)}')
        if why:
            block.append(f'{" "*sub}why_chosen: {_fmt_decision_value(why)}')
        block += [f"{' '*sub}decided: {decided}", f"{' '*sub}valid: true"]
        fm = fm + ["decisions:"] + block
    else:
        _, e_block, items, item_indent, sub = loc
        ip, sp = " " * item_indent, " " * sub
        block = [f"{ip}- content: {_fmt_decision_value(content)}", f"{sp}id: {new_id}"]
        if context:
            block.append(f"{sp}context: {_fmt_decision_value(context)}")
        if why:
            block.append(f"{sp}why_chosen: {_fmt_decision_value(why)}")
        block += [f"{sp}decided: {decided}", f"{sp}valid: true"]
        last = items[-1][1] if items else e_block
        fm[last + 1:last + 1] = block
    new_lines = lines[:1] + fm + lines[e_fm:]
    needle = nfc(content)

    def _check(_fields):
        # [M1] ID 精確驗證:新 id 那條存在且 content 相符(取代純 content 子字串——重疊時驗錯項)
        return any(str(d.get("id", "")).strip() == new_id
                   and needle in nfc(str(d.get("content", "")))
                   for d in parse_decisions(_fm_of(new_lines)))
    atomic_write_verify(path, new_lines, "decisions", _check)
    print(f"✓ decision-add {rel}: 記下一條決策「{content[:30]}」(編號 {new_id},目前有效)")
    return 0, f"{rel}#{new_id}"


def cmd_decision_reindex(env, rel=None, all_mode=False):
    """[M1/P2] 回填遷移:對既有無 id 決策依文件順序、從既有最大 id+1 接續編號(不重排既有、
    不回收缺號——混合狀態絕不撞既有 id);冪等(已有 id 跳過)。單節點一次一篇;--all 批次套用
    到所有有 decisions 的節點(decision_refs 自動養成前置 P;顯式指令、非隱式改)。
    解析不到的決策項明確拒絕(同 supersede 0-indent/tab 語意),不靜默跳過造成缺洞。"""
    if all_mode:
        targets = sorted(r for r, n in env.notes.items() if decisions_items(n.fm_lines) is not None)
        done = errs = 0
        for r in targets:
            try:
                cmd_decision_reindex(env, r)
    sa.add_argument("--date", default=None, help="YYYY-MM-DD(預設今日)")
    p = sub.add_parser("new", help="依模板建檔")
    p.add_argument("type", choices=("system", "verification", "issue", "project"))
    p.add_argument("name")
    p.add_argument("--plan", help="verification 專用:plan_refs 回指的計劃節點(逗號分隔)")
    p.add_argument("--systems", help="verification 專用:同步 append verified_by 的 Systems(逗號分隔)")
    p.add_argument("--code", action="append", default=None, metavar="檔",
                   help="system/issue:這篇管哪幾支程式檔(repo 相對路徑,可重複;寫進 about_code)")
    p.add_argument("--responsibility", default=None,
                   help="system 專用:一句話講這篇負責什麼、不負責什麼(至少 10 個字;新開的 Systems 節點提交時必須有)")

    p = sub.add_parser("decision-supersede", help="T3 巢狀:翻盤一條決策(valid:false+superseded_by)")
    p.add_argument("note")
    p.add_argument("match", help="決策 content 子字串(多重命中 rc=2 列候選,防改錯項)或 \"#dN\" 精確定址(節點未 reindex 查無→rc=2)")
    p.add_argument("--by", required=True, help="被誰取代(superseded_by 值)")
    p.add_argument("--ended", help="失效日期 YYYY-MM-DD(選填)")

    p = sub.add_parser("decision-reindex", help="[M1/P2] 回填遷移:對無 id 決策從既有最大 id+1 接續編號(冪等);--all 批次套用全部決策節點(decision_refs 養成前置)")
    p.add_argument("note", nargs="?", help="單節點;省略需 --all")
    p.add_argument("--all", action="store_true", dest="reindex_all", help="批次套用到所有有 decisions 的節點(顯式指令)")

    p = sub.add_parser("rel-cascade", help="[M3/S5b] 連鎖判定帳本:confirm/prune 寫回、list 活動齡、resume 續展差集")
