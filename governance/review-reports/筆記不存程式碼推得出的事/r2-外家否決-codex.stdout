def _visible_lines(lines, keep_fenced=False):
    """★全檔唯一的 fenced-code 判定實作★:逐行 toggle,回 (行號從1起, 原始行)。

    `keep_fenced=True` 時保留圍欄★內★的文字(但仍跳過 ``` 標記行本身)。

    ★為什麼所有人都必須走這裡(2026-08-03 code-loop r2/r4)★:原本各處自己用
    `FENCE_RE = re.compile(r"^```.*?^```", re.S | re.M)`,那個正則有兩個致命假設——
      ① 假設圍欄★成對★:未閉合的圍欄看不見(r2 抓到:幽靈圖譜邊、假合約佐證)
      ② 假設圍欄標記★在第 0 欄★:收尾圍欄一縮排就跟下一個區塊的開頭錯配,
         ★把中間的真散文整段當程式碼吞掉★(r4 抓到,實測某條路徑宣稱直接消失)
    ②的消費端是治理機制本身(refcheck → design-loop 的 G1 硬閘、Edit/Write 前
    自動注入必看合約的 impact hook)——★一個縮排的 ``` 就能把某節點的鐵則警告
    靜默關掉★。逐行 toggle 對兩個假設都免疫。
    
    ★兩段式讀法(2026-09-16 代碼審 r2)★:先照 CommonMark 讀——收尾圍欄後面只能有空白,
    帶語言標記的那行不算收尾(不然巢狀範例裡的樣板會被當成真的)。但這條規則比題目寬:
    收尾★打錯一個字、多敲一鍵★也會變成「關不掉」,後面到檔尾所有內容(含合約行)
    無聲隱形——正是下面警告過的最危險模式換個門長出來。所以規格讀法如果讀完還有圍欄沒關,
    就整份退回寬鬆讀法(同字元、長度夠就算關)。取捨:同一份文件裡同時有巢狀範例★和★
    沒關到的圍欄時,會退回寬鬆、巢狀那題就擋不住——那等於回到 2026-09-16 之前的行為,
    不算退步,而且真的有沒關到的圍欄本來就該先修那個。
    """
    def _scan(strict):
        """回 (看得見的行, 收尾時還有沒有圍欄開著)。strict=照 CommonMark(收尾不得帶東西)。"""
        fence = None      # 開著的圍欄:(字元, 長度)。同字元且至少一樣長才能關
        # ★不偵測 HTML 註解★(-b r3 單reviewer 兩條 blocker:`-->  <!--` 先關再開會把後面整份藏掉)
        out = []
        for i, ln in enumerate(lines):
            indent = len(ln) - len(ln.lstrip(" "))
            s = ln.lstrip(" ")
            # 縮排 ≤3 格才是圍欄標記;4 格以上(或 tab)是縮排程式碼區塊的內容,不是邊界
            is_marker = indent <= 3 and not ln.startswith("\t") and s.startswith(("```", "~~~"))
            if is_marker:
                ch = s[0]
                run = len(s) - len(s.lstrip(ch))
                if fence is None:
                    fence = (ch, run)
                    continue
                if ch == fence[0] and run >= fence[1] and (not strict or s[run:].strip() == ""):
                    fence = None
                    continue
            if fence is not None and not keep_fenced:
                continue
            out.append((i + 1, ln))
        return out, fence is not None

    out, unterminated = _scan(True)
    if unterminated:                      # 規格讀法讀不完 → 退回寬鬆(見說明的取捨)
        out, _ = _scan(False)
    yield from out


def _strip_fences_text(text):
    """只剝 fenced code block,★保留 inline code★——給 refcheck 家族用。

    ★為什麼不能用 `_strip_code_text`★:那支連 inline code 一起剝,而 refcheck
    要抽的路徑宣稱★正是寫在 inline code 裡★(`` `scripts/foo.py:12` ``)。
    用錯會讓所有宣稱憑空消失、G1 對著空清單宣告通過。
    """
    return "\n".join(ln for _no, ln in _visible_lines(text.split("\n")))


def _search_visible_lines(lines, include_code):
    """產生 (行號從1起, 原始行, 比對用 probe)——★search 的「哪些字看得見」唯一實作★。

    ★為什麼要抽出來(2026-08-03 code-loop r1,slot3 附實測)★:多詞回退的預檢原本自己
    寫了一份「整段 regex 剝 fence」,與主迴圈的「逐行 in_fence toggle」是★兩份實作★,
    遇到★未閉合的 ``` 圍欄★就分岔:主迴圈把圍欄後全部視為 code(隱形),預檢的成對
    regex 剝不掉懸空那半段(仍可見)。後果不是「回退多觸發一次」這種小事——是
    ★逐詞覆蓋虛報非零★:實測單獨搜某詞 0 篇,覆蓋卻印該詞 1 篇,直接打臉 M1.5
    「告訴你哪個詞 0 命中」的存在理由。
    ★我原本在註解裡把這個邊界寫成「方向保守、無害」——那個評估只涵蓋了「回退觸發
    與否」,沒涵蓋「覆蓋數字本身」。同一個坑今天第六次:用一個後果描述邊界,另一個
    後果就不在視野裡。★ 修法不是補正則,是讓兩邊共用這一份。
    """
    for _no, ln in _visible_lines(lines, keep_fenced=include_code):
        yield _no, ln, (ln if include_code else INLINE_CODE_RE.sub("", ln))


# ★字對回退的觸發下限(暫用值,還沒校準)★:只有「連續漢字段長度 ≥ 這個數」才拿它切字對。
# 4 個字 = 3 個字對,跟既有那句提示的觸發條件同一個數,不是另外拍的。
# ★這個數還沒有實測依據★——計劃 [S2] 明寫門檻要在對照組裡定,而對照組要等這支能跑才組得出
# 候選池(這就是為什麼實作排在量測前面)。目前預設關,所以拍錯也不影響任何人。
# REVISIT:2026-10-14 用 [S2] 那套獨立評測校準這個數,連同查詢長度一起看(短查詢與長問句
# 的風險不同,實測四個漢字三題有兩題仍正確回 0,真正的風險在長問句)。
_CJK_LOOSE_MIN_RUN = 4
# ★字對數上限★(2026-09-07 代碼審 r1 通才席判 major,兩邊各自量過):
# 這條回退的成本是 O(字對數 × 篇數 × 篇幅)——預檢對每個字對、每篇筆記做一次子字串比對,
    reqG = _nodehome_required(root, G, cfg, skip)[0] if G is not None else set()
    ownG = _nodehome_homes(root, G)[1] if G is not None else {}
    foreign, foreign_new, over, over_new = {}, {}, [], []
    regen_no_home, unmentioned = [], []      # [S11] 蓋了重建章卻不管檔的舊帳;[S15] 管了某支檔卻連檔名都沒提
    for rel, n in sorted(side.notes.items()):
        if n["type"] != "system":
            continue
        if n["status"] in _NODEHOME_HOME_STATUSES:
            _mine = sorted(k for k in own.get(rel, set()) if k in side.files)
            if n["regen"] and not _mine and not _nodehome_resp_ok(n["resp"]):
                regen_no_home.append(rel)
            _scan = _home_scan_text(n["text"])
            for _f in _mine:
                if not _home_mentions(_scan, _f):
                    unmentioned.append((rel, _f))
        f = sorted(_nodehome_refs(n["text"], side, req) - own.get(rel, set()))
        if f:
            then = set()
            if G is not None and rel in G.notes:
                then = _nodehome_refs(G.notes[rel]["text"], G, reqG) - ownG.get(rel, set())
            newer = [x for x in f if G is not None and x not in then]
            if newer:
                foreign_new[rel] = newer
            older = [x for x in f if x not in newer]
            if older:
                foreign[rel] = older
        cnt = len({k for k in own.get(rel, set()) if k in side.files})
        if n["status"] in _NODEHOME_HOME_STATUSES and cnt > cfg["max_files"] and not _nodehome_resp_ok(n["resp"]):
            g = G.notes.get(rel) if G is not None else None
            was_over = g is not None and g["status"] in _NODEHOME_HOME_STATUSES and not _nodehome_resp_ok(g["resp"]) \
                and len({k for k in ownG.get(rel, set()) if k in G.files}) > cfg["max_files"]
            (over if (G is None or was_over) else over_new).append((rel, cnt))
    return {"cfg": cfg, "bypassed": [f for f in homeless if f in after], "legacy": [f for f in homeless if f not in after],
            "foreign": foreign, "foreign_new": foreign_new, "over": over, "over_new": over_new,
            "regen_no_home": regen_no_home, "unmentioned": unmentioned,
            "bad_names": sorted(_nodehome_show(x) for x in bad), "golive": gl}


def cmd_home_check(repo=None, staged=False, diff_range=None):
    """lumos home check --staged | --diff A..B [S24]:有新違規 rc1,沒有 rc0;沒有圖譜/合併中/開關 off 說一句跳過、rc0。
    git 跑不起來=fail-open(說一句、rc0):這道閘只擋「確定是新違規」的,不因為環境壞了擋人。
    ★設定、工具自裝檔、圖譜位置都從被檢查的那個版本讀★(提交前=提交索引、推送前=終點那個提交),不讀工作目錄。"""
    root = Path(repo).resolve() if repo else None
    if root is None:
        r = _lens_git(".", "rev-parse", "--show-toplevel")
        if r is None or r.returncode != 0:
            print("擋下:這裡不是 git 專案,用 --repo 指定", file=sys.stderr)
            return 2
        root = Path(r.stdout.strip())
    if staged:
        mh = _lens_git(root, "rev-parse", "-q", "--verify", "MERGE_HEAD")
        if mh is not None and mh.returncode == 0:
            print("每支檔有家:合併提交跳過(推送前會把合併的結果整段查一次)", file=sys.stderr)
            return 0
        head = _lens_full_sha(root, "HEAD")
        base_where, tip_where, mode_word = head, "index", "這次提交"
        changes = _nodehome_changes(root, head, "index")
    else:
        # 寫法用派工鏡頭那支判法:恰好兩個點、兩端都有、不收三個點——原本只切第一個「..」,
        # 三個點的寫法變成「起點 到 .終點」、找不到就放行,同一條違規完全沒擋(代碼審 r1 邊界席)
        rg = _lens_range_ok(diff_range)
        if rg is None:
            print("擋下:--diff 要給 <起點>..<終點>——恰好兩個點、兩端都要有(三個點的寫法這裡不收:"
                  "先用 git merge-base 算出起點再給)", file=sys.stderr)
            return 2
        a, b = rg
        tip = _lens_full_sha(root, b)
        base = a if a == _EMPTY_TREE_SHA else _lens_full_sha(root, a)
        if tip is None or base is None:
            print(f"每支檔有家:範圍 {diff_range} 在本機找不到,跳過(fail-open)", file=sys.stderr)
            return 0
        base = _nodehome_clamp_base(root, base, tip)
        base_where = None if base == _EMPTY_TREE_SHA else base
        tip_where, mode_word = tip, "這次推送"
        changes = _nodehome_changes(root, base_where, tip)
    if changes is None:
        print("每支檔有家:git 算不出這次的改動,跳過(fail-open)", file=sys.stderr)
        return 0
    lst = _nodehome_list(root, tip_where)
    if lst is None:
        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
        return 0
    # 圖譜位置:被檢查的那個版本裡的 docs/*-knowledge(推送一個不是目前 checkout 的分支,工作目錄那份可能不一樣)
    vaults = sorted({_vault_slug_of(p) for p in lst[1]} - {None})
    wv = _vault_in(root)
    wv_rel = wv.resolve().relative_to(root.resolve()).as_posix() if wv is not None else None
    if wv_rel and wv_rel.startswith("docs/") and wv_rel.split("/", 1)[1] in vaults:
        vault_rel = wv_rel
    elif vaults:
        vault_rel = "docs/" + vaults[0]
    else:
        print("每支檔有家:這個專案沒有圖譜,跳過")
        return 0
    reader = _nodehome_reader(root, tip_where)
    cfg = _nodehome_config(root, reader(".lumos/config.json"), from_snapshot=True)
    for w in cfg["warnings"]:
        print(f"提醒:{w}", file=sys.stderr)
    if cfg["mode"] == "off":
        print("每支檔有家:這個專案把這道檢查關掉了(node_home.gate=off),跳過", file=sys.stderr)
        return 0
    N = _nodehome_side(root, tip_where, vault_rel)
    changed_paths = {p for _c, o, n in changes for p in (o, n) if p}
    B = _nodehome_side(root, base_where, vault_rel, share=N, changed=changed_paths)
    if B is None or N is None:
        print("每支檔有家:git 讀不到檔案清單,跳過(fail-open)", file=sys.stderr)
        return 0
    skip = frozenset() if _is_toolchain_repo(root) else _vendored_state(root, "" if staged else tip_where)[0]
    groups = None if staged else _nodehome_mark_note_content(root, _nodehome_commit_groups(root, base_where, tip_where), vault_rel)
    res = _nodehome_evaluate(root, B, N, changes, cfg, skip, vault_rel, groups=groups)
    homesN, _own = _nodehome_homes(root, N)
    lines = _nodehome_render(res, homesN, N, cfg, mode_word)
    blocked = bool(res["blocks"])
    if blocked and cfg["mode"] == "warn":
        lines = [l.replace("擋下:", "提醒(node_home.gate=warn,不擋):", 1) for l in lines]
    for l in lines:
        print(l, file=sys.stderr)
    # 治理帳:nodes 只放程式檔路徑(統計語意表這麼宣告);沒有程式檔的違規(負責範圍)把節點另放 notes
    files, notes_ = set(), set()
    for kind, it in res["blocks"]:
        if kind in ("new-homeless", "write-back-homeless"):
            files.add(it)
        elif kind == "home-removed":
            files.add(it[0])
        elif kind in ("foreign", "foreign-awakened"):
            files.add(it[1]); notes_.add(it[0])
        elif kind == "route":
            files.update(it[1]); notes_.add(it[0])
        else:
            notes_.add(it[0])
    kind = "blocked" if blocked and cfg["mode"] == "on" else ("warned" if blocked else "passed")
    extra = {}
    if res["pairs"]:
        extra["pairs"] = [list(x) for x in res["pairs"][:100]]
    if notes_:
        extra["notes"] = sorted(notes_)[:50]
    _gate_event_or_warn(root, "nodehome-check", kind,
                        f"{mode_word}:新違規 {len(res['blocks'])} 條" + ("(warn 模式不擋)" if blocked and cfg["mode"] == "warn" else ""),
                        hard=(kind == "blocked"), nodes=sorted(files)[:50], extra=extra or None)
    return 1 if kind == "blocked" else 0


# ── cochange:co-change 漏改守衛(vault-free;borrow-design ROSE error-prevention) ──
# 規則:conf(A⇒B)=shared/freq(A)(非對稱條件機率,ROSE TSE 2005 §5);support=絕對共改次數。
# 設計 spec:docs/lumos-toolchain-knowledge/Projects/cochange守衛_計劃.md

_COCHANGE_DEFAULTS = {"min_support": 3, "min_confidence": 0.8, "max_changeset": 20}
_COCHANGE_DEFAULT_EXCLUDE = [
    "docs/.governance-log.jsonl", "docs/.bypass-log.jsonl", "docs/.ci-log.jsonl",
    "docs/.canary-log.jsonl", "docs/.rot-queue.jsonl", "docs/.kill-log.jsonl",
    "docs/.signoff-log.jsonl", "docs/.usage-log.jsonl",
    "**/*-lock.json", "**/*.lock", "**/node_modules/**", "**/dist/**",
    "**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs",
]


def _cochange_repo_root(repo):
# 在白名單目錄裡但★不是文件、是守衛本身★的:hook 防竄改基準線(改它等於改守衛,而驗它的測試只在全套裡)、代碼審留痕(pass 綁版本)。
# 碰到任一支就全套(代碼審 r3 資安席:只推基準線會被當純文件,連 t_anchor 都跳過——兩段式竄改的第一步)。
_DOCS_ONLY_NEVER = ("governance/anchor-baseline.json", "governance/code-loop/")


def _docs_only_file(path):
    """這支檔算不算「純文件」:路徑在白名單(根目錄那幾個檔要全名相等;目錄要前綴相等)且副檔名在文件清單(不分大小寫)。
    只看路徑與副檔名、不讀內容:讀內容的那條路(首行 #!)第一版有,但它只認「已知的程式」,不認得的照放——反過來列文件才安全。"""
    if not any(path == w or (w.endswith("/") and path.startswith(w)) for w in _DOCS_ONLY_PATHS):
        return False
    if path in _DOCS_ONLY_PATHS:          # 根目錄的全名白名單(LICENSE 沒副檔名)
        return True
    base = path.rsplit("/", 1)[-1]
    return "." in base.lstrip(".") and ("." + base.rsplit(".", 1)[1].lower()) in _DOCS_ONLY_EXTS


def _range_base(rr, diff_range):
    """範圍起點:a..b 是 a;a...b 是 merge-base(a,b)(代碼審 r1 正確性席:三點範圍拿左端點當起點,刪掉的檔會從錯的版本讀);其他回 None。"""
    if not diff_range:
        return None
    if "..." in diff_range:
        a, b = diff_range.split("...", 1)
        try:
            r = subprocess.run(["git", "-C", str(rr), "merge-base", a or "HEAD", b or "HEAD"], capture_output=True, text=True, errors="replace")
            return r.stdout.strip() or None if r.returncode == 0 else None
        except OSError:
            return None
    if ".." in diff_range:
        return diff_range.split("..", 1)[0] or None
    return None


def _test_suite_for_range(repo_root, diff_range):
    """這段範圍推送前/CI 該跑哪個測試範圍。回 dict:suite(docs|full)、reason、code(非文件且是程式檔的清單)、
    light_ok(非文件檔★全部★是「需要有家的程式檔」——小改動閘的擴散只查程式檔,測試檔/skills/workflow 這種既不是文件也不是程式的
    會從它眼皮下溜過,所以 light 不准帶著這種檔一起少跑全套;代碼審 r1 資安席)。
    自己用 git 算檔清單(不用 pitfalls 的 files:那份已經把 .json/.jsonl 按副檔名擋掉);--no-renames:從 scripts/ 搬進 docs/ 的檔會拆成
    「刪程式檔+加文件」,刪的那支讓它跑全套。簿記帳與卷證不算;算不出範圍 → full(fail-safe 是多跑,不是少跑)。"""
    base = _range_base(repo_root, diff_range)
    full = {"suite": "full", "code": [], "light_ok": False, "graph": False}
    try:
        r = subprocess.run(["git", "-C", str(repo_root), "-c", "core.quotePath=false", "diff", "--name-only", "-z",
                            "--no-renames", diff_range, "--"], capture_output=True, text=True, errors="replace")
    except OSError:
        return dict(full, reason="算不出改動清單")
    if r.returncode != 0:
        return dict(full, reason=f"範圍 {diff_range} 算不出來")
    raw = [f for f in r.stdout.split("\0") if f.strip()]
    guard = [f for f in raw if f in _DOCS_ONLY_NEVER or f.startswith(tuple(w for w in _DOCS_ONLY_NEVER if w.endswith("/")))]
    if guard:
        return dict(full, reason="改到 " + "、".join(guard[:3]) + " 這種守衛本身的檔(基準線/留痕),要全套")
    files = [f for f in raw if not (f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS))]
    non_docs = [f for f in files if not _docs_only_file(f)]
    if not non_docs:
        # 碰到圖譜筆記(docs/<名>-knowledge/)要多跑「讀真圖譜」的測試(檢索品質、評測、goldset):圖譜健檢只驗結構,
        # 驗不到「搜尋還找不找得到」(2026-09-18 代碼審 code-文件子集收緊 r1 通才席)
        graph = any(_vault_slug_of(f) for f in files)
        return {"suite": "docs", "reason": "改到的只有 README、docs、assets 這類文件(沒碰程式與 skills)" + (";含圖譜筆記,加跑讀真圖譜的測試" if graph else ""),
                "code": [], "light_ok": False, "graph": graph}
    code = [f for f in non_docs if _is_code_file(repo_root, f, base)]
    return {"suite": "full", "reason": "改到 " + "、".join(non_docs[:3]) + ("…" if len(non_docs) > 3 else "") + " 這種不是純文件的檔",
            "code": code, "light_ok": len(code) == len(non_docs), "graph": False}


def _keys_mentioned(text, keys):
    """回 text 裡★整字★出現過的 keys(前後都不是英數字底線;key 照字面比,句點不當萬用字元)。
    整字比對的唯一定義:測試執行器的 --suite keys 與推送前「自主迴圈要不要整支跑」都用它
    (2026-09-18 代碼審 code-light自主迴圈 r1 架構席:掛鉤原本自己用 grep -w,句點被當萬用字元,跟執行器判得不一樣)。"""
    return [k for k in keys if k and re.search(r"(?<![A-Za-z0-9_])" + re.escape(k) + r"(?![A-Za-z0-9_])", text)]


def _autoloop_full_for(repo_root, keys):
    """light 推送時,自主迴圈測試要不要整支跑:抽不出關鍵字就整支跑(不知道改了什麼,不能賭——r1 通才席);
    有關鍵字就看它們有沒有整字出現在那支測試的原始碼裡。讀不到那支檔(消費專案沒有)回 False。"""
    f = Path(repo_root) / "scripts" / "test_autonomous_loop.py"
    try:
        text = f.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    return (not keys) or bool(_keys_mentioned(text, keys))


_KEY_OK_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]{2,}")   # 不准 - 開頭:進了執行器的 --keys 會被 argparse 當旗標(r2 資安席/邊界席)


