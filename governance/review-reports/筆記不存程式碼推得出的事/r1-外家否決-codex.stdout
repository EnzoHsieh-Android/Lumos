 28692	    """marker 檔不在時(governance/code-loop/ 被 gitignore,CI 的乾淨 checkout 一定沒有)
 28693	    退而讀 tracked 的 docs/.governance-log.jsonl:取該分支最後一筆 gate=code-loop 事件,
 28694	    還原成 marker 同形 dict(status/head_sha/note)。沒有就回 None。
 28695	    2026-08-22 實紅:CI 後盾 #5 上線後第一筆 tier=high 推送因 marker 不在 checkout 而假紅。"""
 28696	    import json
 28697	    path = Path(repo_root) / "docs" / ".governance-log.jsonl"
 28698	    if not path.exists():
 28699	        return None
 28700	    last = None
 28701	    try:
 28702	        for line in path.read_text(encoding="utf-8").splitlines():
 28703	            line = line.strip()
 28704	            if not line or '"code-loop"' not in line:
 28705	                continue
 28706	            # ★只有 pass/skip 才是留痕★(2026-09-08 #19 代碼審 r1 之後補的防禦):
 28707	            # 同一個 gate 底下現在還有 blocked / skipped-env / fail-open 這些事件,
 28708	            # 它們絕不能被當成「審過了」的憑證。上面撤掉 branch 別名已經擋住一次,
 28709	            # 這裡是第二道——★別讓「哪些 kind 算留痕」這件事只靠欄位有沒有寫★。
 28710	            if ('"passed"' not in line) and ('"skipped"' not in line):
 28711	                continue
 28712	            try:
 28713	                ev = json.loads(line)
 28714	            except Exception:
 28715	                continue
 28716	            # ★kind 也要對★(表態閘 2026-09-09):dispositions 事件的內容可能含 "passed" 字樣,子字串預篩擋不住;
 28717	            # 兩種 kind 各自重建(_codeloop_read_dispositions 讀另一種),互不擠掉。
 28718	            if ev.get("kind") not in ("passed", "skipped"):
 28719	                continue
 28720	            if ev.get("gate") == "code-loop" and ev.get("branch") == branch and ev.get("head_sha"):
 28721	                last = ev
 28722	    except OSError:
 28723	        return None
 28724	    if last is None:
 28725	        return None
 28726	    return {"status": last.get("kind"), "head_sha": last.get("head_sha"),
 28727	            "note": last.get("detail"), "ts": last.get("ts"), "_source": "ledger"}
 28728	
