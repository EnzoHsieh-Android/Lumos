 30275	def cmd_code_loop(subcmd, note=None, repo=None, as_json=False, diff_range=None, at_sha=None, marker_branch=None, skip_bound=False, from_json=None, disp_file=None, qid=None, bound_advisory=False):
 30276	    """code-loop 留痕讀寫。
 30277	    pass  → status=passed(綁 HEAD sha);
 30278	    skip  → status=skipped(綁 HEAD sha,留逃生痕);
 30279	    dispositions <檔> → 棧別提問表態(表態閘 2026-09-09;派審查員之前寫,skip 也要先表態);
 30280	    recall-miss <id> → 審查席抓到未觸發題的問題時登記一筆;
 30281	    check → 跑判定式回報 verdict(blocked=合約測試紅 ∨ 有適用題表態不完整 ∨ tier=high∧無有效留痕);--json 輸出 verdict dict。
 30282	    rc: 0=OK / 1=check:blocked / 2=參數錯。
 30283	    """
 30284	    # resolve repo root
 30285	    if repo is not None:
 30286	        repo_root = Path(repo)
 30287	        if not repo_root.is_dir():
 30288	            print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 30289	            return 2
 30290	    else:
 30291	        repo_root = None
 30292	        for cand in (Path.cwd(), *Path.cwd().parents):
 30293	            if (cand / ".git").exists():
 30294	                repo_root = cand
 30295	                break
 30296	        if repo_root is None:
 30297	            print("擋下:找不到 git 專案根目錄,用 --repo 指定", file=sys.stderr)
 30298	            return 2
 30299	
 30300	    branch = _codeloop_git_branch(repo_root)
 30301	    head_sha = _codeloop_git_head(repo_root)
 30302	    if not head_sha:
 30303	        print("擋下:問不到目前的 git 版本號(git 指令失敗?)", file=sys.stderr)
 30304	        return 2
 30305	    ts = _codeloop_git_ts(repo_root)
 30306	
 30307	    if subcmd == "dispositions":
 30308	        # --branch(r3 外家 F11):推 HEAD:別名 時 pre-push 按遠端目的分支查記錄,表態要寫在那個名字下
 30309	        if marker_branch is not None and not marker_branch.strip():
 30310	            print("擋下:--branch 給了空字串——要寫在哪個分支名下講清楚,不然會悄悄退回 checkout 分支(r1 邊界席 f3)", file=sys.stderr)
 30311	            return 2
 30312	        # --at-sha(r1 外家 finder f5/否決 f2):checkout 在 main、推的是別的分支時,check 按被推的 sha 查,表態得綁那個 sha 不是 HEAD
 30313	        if at_sha:
 30314	            import subprocess as _sp
 30315	            _rp = _sp.run(["git", "rev-parse", "--verify", f"{at_sha}^{{commit}}"], capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 30316	            if _rp.returncode != 0:
 30317	                print(f"擋下:--at-sha {at_sha} 不是這個 repo 裡的 commit", file=sys.stderr)
 30318	                return 2
 30319	            head_sha = _rp.stdout.strip()
 30320	            ts = _codeloop_git_ts(repo_root, head_sha) or ts
 30321	        return _cmd_codeloop_dispositions(repo_root, marker_branch or branch, head_sha, ts, disp_file)
 30322	    if subcmd == "recall-miss":
 30323	        return _cmd_codeloop_recall_miss(repo_root, branch, head_sha, ts, qid, note or "")
 30324	
 30325	    if subcmd in ("pass", "skip"):
 30326	        status = "passed" if subcmd == "pass" else "skipped"
 30327	        _codeloop_write(repo_root, branch, status, note or "", head_sha, ts)
 30328	        _codeloop_gov_log(repo_root, branch, status, note or "", head_sha, ts)
 30329	        label = "✅" if status == "passed" else "⏭"
 30330	        what = "審查通過,已留痕" if status == "passed" else "刻意跳過審查,已留痕"
 30331	        print(f"{label} code-loop {status}:{what}(分支 {branch},版本 {head_sha[:8]})" + (f"——{note}" if note else ""))
 30332	        print("  這筆紀錄只認目前這個版本:之後再改任何程式碼(工具自己的紀錄檔除外)它就失效,要重跑一次 pass 或 skip。")
 30333	        _codeloop_print_dirty_bookkeeping(repo_root, status)
 30334	        return 0
 30335	
 30336	    if subcmd == "check":
 30337	        # Task 2: 完整判定式(tier-high∧無有效留痕 → blocked)
 30338	        import json as _cljson
 30339	        if skip_bound and not (note or "").strip():
 30340	            print("擋下:--skip-bound-tests 要帶 --note 寫為什麼不跑受波及合約的測試(會進治理帳被統計)", file=sys.stderr)
 30341	            return 2
 30342	        verdict = _codeloop_guard_verdict(repo_root, diff_range=diff_range,
 30343	                                          at_sha=at_sha, branch=marker_branch,
 30344	                                          skip_bound=skip_bound, skip_note=note or "",
 30345	                                          payload=_impact_payload_read(from_json) if from_json else None,
 30346	                                          bound_advisory=bound_advisory)
 30347	        bt = getattr(_codeloop_guard_verdict, "last_bound", None)
 30348	        if bt is not None and "bound_tests" not in verdict:
 30349	            verdict["bound_tests"] = bt
 30350	        dv = getattr(_codeloop_guard_verdict, "last_dispositions", None)
 30351	        if dv is not None and "dispositions" not in verdict:
 30352	            verdict["dispositions"] = dv
 30353	        blocked = verdict["blocked"]
 30354	        reason = verdict["reason"]
 30355	        tier = verdict["tier"]
 30356	        if as_json:
 30357	            print(_cljson.dumps(verdict, ensure_ascii=False))
 30358	        else:
 30359	            if blocked and verdict.get("reason_kind") == "dispositions":
 30360	                # 三段式:發生什麼 → 為何在意 → 指令獨立一行;最多列 10 問,其餘一句(r2 邊界席 B12)
 30361	                _pr = (dv or {}).get("problems") or []
 30362	                print(f"擋下:這次改動有 {(dv or {}).get('applicable', 0)} 題效能檢核適用,但表態不完整({len(_pr)} 處)——分支 {branch},版本 {head_sha[:8]}。", file=sys.stderr)
 30363	                for _x in _pr[:10]:
 30364	                    print(f"  - {_x}", file=sys.stderr)
 30365	                _rng = (dv or {}).get("range") or diff_range or "<範圍>"
 30366	                if len(_pr) > 10:
 30367	                    print(f"  …另有 {len(_pr) - 10} 問,全量看:", file=sys.stderr)
 30368	                    print(f"    lumos code-loop check --diff {diff_range or '<範圍>'} --json", file=sys.stderr)
 30369	                print("在意的原因:題目推到眼前不等於有人回答;推送前每一題要有機器讀得懂的交代(做到了附證據/不適用附理由/待辦連 Issue),這不是審查,跟 tier 無關。", file=sys.stderr)
 30370	                print(f"接下來(適用題算在 {_rng},樣板用同一個範圍):", file=sys.stderr)
 30371	                print(f"    lumos pitfalls --diff {_rng} --dispositions-template --carry > /tmp/disp.json   # 填完:", file=sys.stderr)
 30372	                _bflag = f" --branch {marker_branch}" if marker_branch and marker_branch != branch else ""
 30373	                if at_sha and at_sha != head_sha:
