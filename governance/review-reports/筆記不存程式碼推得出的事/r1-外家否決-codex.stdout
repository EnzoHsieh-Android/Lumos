 28860	def _bound_tests_for_diff(repo_root, diff_range, payload=None):
 28861	    """impact 固定席 → 各節點 ★INVARIANT★ 的 [test:] → (node, platform, method, status)。
 28862	    status ∈ real / dangling / fake / bad-name。回 (items, reason_if_none)。
 28863	
 28864	    payload 給了就直接用那份已經算好的結果(推送關卡一次推送只算一次,見 _impact_payload_read)。
 28865	    """
 28866	    import io as _io, contextlib as _ctx, json as _json
 28867	    # ★先看有沒有知識庫★:沒有的話下面的波及計算會先失敗成 diff-unavailable,
 28868	    # 而那個字對「跑錯目錄/這個專案還沒 init」的人沒有任何幫助(r1 接手席 f4)。
 28869	    if _vault_in(repo_root) is None:
 28870	        return [], "no-vault"
 29640	    p = d / f"{_codeloop_branch_filename(branch)}.dispositions.json"
 29641	    # 暫存名帶 pid+隨機(r1 併發席 f1):_write_lf 的固定 .tmp-wlf 名兩個行程同時寫會互搶,一方 os.replace 找不到檔
 29642	    import tempfile as _tf
 29643	    fd, tmp = _tf.mkstemp(prefix=p.name + ".", suffix=".tmp", dir=str(d))
 29644	    try:
 29645	        with os.fdopen(fd, "wb") as f:
 29646	            f.write((json.dumps({"head_sha": head_sha, "branch": branch, "ts": ts, "dispositions": dispositions},
 29647	                                ensure_ascii=False, indent=2) + "\n").encode("utf-8"))
 29648	        os.replace(tmp, p)
 29649	    finally:
 29650	        try:
 29651	            os.unlink(tmp)
 29652	        except OSError:
 29653	            pass
 29654	    return p
