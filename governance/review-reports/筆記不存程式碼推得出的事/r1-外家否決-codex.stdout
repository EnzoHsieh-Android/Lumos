 29795	def _dispositions_check_issue(repo_root, at_sha, issue):
 29796	    """todo 的 Issue:先解析 docs/*-knowledge 的實際 slug(git cat-file 不展開 glob,r2 正確性席 C4),再驗存在且 status open/doing。"""
 29797	    import subprocess as _sp
 29798	    name = str(issue)[len("Issues/"):]
 29799	    if name.endswith(".md"):
 29800	        name = name[:-3]
 29801	    if at_sha:
 29802	        ls = _sp.run(["git", "ls-tree", "--name-only", at_sha, "docs/"], capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 29803	        slugs = [x.strip() for x in ls.stdout.splitlines() if x.strip().endswith("-knowledge")]
 29804	        for s in slugs:
 29805	            p = f"{s}/Issues/{name}.md"
 29806	            if _git_tree_has(repo_root, at_sha, p):
 29807	                txt = _git_tree_text(repo_root, at_sha, p) or ""
 29808	                m = re.search(r"(?m)^status:\s*(\S+)", txt)
 29809	                st = m.group(1) if m else ""
 29810	                return (st in ("open", "doing")), ("" if st in ("open", "doing") else f"{p} 的 status 是 {st or '空'},todo 只准連 open/doing")
 29811	        return False, f"推送版本 {at_sha[:8]} 的樹裡找不到 docs/*-knowledge/Issues/{name}.md"
 29812	    hits = list(Path(repo_root).glob(f"docs/*-knowledge/Issues/{name}.md"))
 29813	    if not hits:
 29814	        return False, f"工作樹找不到 docs/*-knowledge/Issues/{name}.md"
 29815	    m = re.search(r"(?m)^status:\s*(\S+)", hits[0].read_text(encoding="utf-8", errors="ignore"))
 29816	    st = m.group(1) if m else ""
 29817	    return (st in ("open", "doing")), ("" if st in ("open", "doing") else f"{hits[0].name} 的 status 是 {st or '空'},todo 只准連 open/doing")
 29818	
