 29657	def _codeloop_read_dispositions(repo_root, branch, marker_only=False):
 29658	    """本機 marker 優先;沒有(或壞掉,r1 併發席 f4)就退治理帳「該分支最後一筆 kind=dispositions」(檔案行序的最後一筆,不是 ts;r2 外家 F8)。
 29659	    ★跟 pass/skip 分開重建★(r2 外家 F1/邊界席 B9):兩種 kind 互不擠掉。
 29660	    marker_only:只讀本機 marker 不掃治理帳——派工鏡頭用(r1 併發席 f6:每次派工掃 4.6 MB 帳只為算快取 key,不值)。"""
 29661	    import json
 29662	    p = Path(repo_root) / "governance" / "code-loop" / f"{_codeloop_branch_filename(branch)}.dispositions.json"
 29663	    if p.exists():
 29664	        try:
 29665	            return json.loads(p.read_text(encoding="utf-8"))
 29666	        except Exception:
 29667	            pass   # 壞掉的 marker 跟「從沒表態」不同:退治理帳找
 29668	    if marker_only:
 29669	        return None
 29670	    path = Path(repo_root) / "docs" / ".governance-log.jsonl"
 29671	    if not path.exists():
 29672	        return None
 29673	    last = None
 29674	    try:
 29675	        for line in path.read_text(encoding="utf-8").splitlines():
 29676	            if '"dispositions"' not in line:
 29677	                continue
 29678	            try:
 29679	                ev = json.loads(line)
 29680	            except Exception:
 29681	                continue
 29682	            if ev.get("gate") == "code-loop" and ev.get("kind") == "dispositions" and ev.get("branch") == branch and ev.get("head_sha"):
 29683	                last = ev
 29684	    except OSError:
 29685	        return None
 29686	    if last is None:
 29687	        return None
 29688	    return {"head_sha": last["head_sha"], "branch": branch, "ts": last.get("ts"),
 29689	            "dispositions": last.get("dispositions") or {}, "_source": "ledger"}
