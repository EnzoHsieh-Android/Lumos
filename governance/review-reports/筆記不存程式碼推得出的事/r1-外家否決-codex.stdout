 29969	def _codeloop_guard_verdict(repo_root, diff_range=None, at_sha=None, branch=None, skip_bound=False, skip_note="", payload=None, bound_advisory=False):
 29970	    """判定式:tier=high(pitfalls --diff <range> --no-lint --json)
 29971	    AND 無有效 pass/skip 留痕 → blocked=True。
 29972	    留痕座標(prepush範圍修法 #2):at_sha/branch 給了則綁該座標(hook 傳被推送 ref 的
 29973	    local_sha 與 remote_ref 分支),否則讀當前 checkout HEAD/branch(向後相容)。
 29974	    diff_range 給了則跳 merge-base 推導直接算 tier;否則沿 merge-base..HEAD 現行為。
 29975	    fail-open:pitfalls 出錯 / 非 git / 無 merge-base → tier 視作非 high(不 blocked)。
 29976	    回傳 dict{blocked:bool, reason:str, tier:str}。
 29977	    """
 29978	    import json as _json
 29979	    import subprocess as _sp
 29980	
 29981	    # 留痕比對座標:優先用傳入的(hook 綁被推送 ref),否則讀 checkout
 29982	    _codeloop_guard_verdict.last_bound = None   # 每次呼叫先清,提早 fail-open 的分支不會拿到上一輪的殘留
 29983	    _codeloop_guard_verdict.last_dispositions = None
 29984	    _codeloop_guard_verdict.last_lint_new = None
 29985	    marker_sha = at_sha or _codeloop_git_head(repo_root)
 29986	    marker_branch = branch or _codeloop_git_branch(repo_root)
 29987	    if not marker_sha:
 29988	        _gate_failopen(repo_root, "code-loop", "無法取得 HEAD sha")
 29989	        return {"blocked": False, "reason": "無法取得 HEAD sha(fail-open)", "tier": "unknown"}
 29990	
 29991	    if diff_range is None:
 29992	        # 現行為:merge-base..HEAD 推導(向後相容)
 29993	        head_sha = _codeloop_git_head(repo_root)
 29994	        mb = None
 29995	        for base_branch in ("main", "master"):
 29996	            r = _sp.run(["git", "merge-base", "HEAD", base_branch],
 29997	                        capture_output=True, text=True, errors="replace", cwd=str(repo_root))
 29998	            if r.returncode == 0 and r.stdout.strip():
 29999	                mb = r.stdout.strip()
 30000	                if mb == head_sha:
 30001	                    return {"blocked": False, "reason": "merge-base == HEAD(無 branch diff)", "tier": "standard"}
 30002	                break
 30003	        if not mb:
 30004	            _gate_failopen(repo_root, "code-loop", "算不出 merge-base")
 30005	            return {"blocked": False, "reason": "無 merge-base(fail-open)", "tier": "unknown"}
 30006	        diff_range = f"{mb}..HEAD"
 30007	
 30008	    # 2.5 受波及合約測試真跑(不分 tier;紅就擋)
 30009	    # ★高風險這條路也要吃那份算好的★(2026-09-07 代碼審 r1 通才席的附註,查證屬實):
 30010	    # 第一版只接了低風險那條,於是高風險推送仍然算兩次(一次給同步點名、一次在這裡)
 30011	    # ——而我在 pre-push 的註解裡寫的是「★一次推送只算一次波及★」。
 30012	    # ★那句話當時只在低風險成立,是我自己寫太大的宣稱。★ 接上之後才是真的。
 30013	    bt = _bound_tests_check(repo_root, diff_range, skip=skip_bound, skip_note=skip_note,
 30014	                            payload=payload, advisory=bound_advisory)   # advisory 也要傳進去(r1 外家否決 f3:不傳會對低風險跑整套 600 秒)
 30015	    _codeloop_guard_verdict.last_bound = bt
 30016	    # ★「證不出跑過」跟紅一樣擋★(2026-09-09 r1 單reviewer f2,blocker):
 30017	    # 第一版只把狀態從 green 換成 unfilterable、印一行到 stderr 就結束,決定擋不擋的這裡
 30018	    # 只認 red——也就是說「假綠改成擋」這句話當時是假的,實際上只是換了一行字。
 30019	    # 假綠的殺傷力跟紅一樣(你以為合約被測試守著,其實沒有),所以走同一條路:
 30020	    # 高風險擋、低風險比照紅只提醒(那是 2026-09-07 的人裁,理由是擋下去人會改走 --no-verify)。
 30021	    # 真的修不動的話逃生門跟紅共用:--skip-bound-tests --note "<理由>",會留痕。
 30022	    if bt["status"] in ("red", "unfilterable") and not bound_advisory:
 30023	        return {"blocked": True, "reason": bt["reason"], "tier": "unknown", "bound_tests": bt}
 30024	    # bound_advisory(表態閘 S7 之後 pre-push 對每個分支 ref 都叫 check):低風險推送的合約測試維持 2026-09-07 人裁的
 30025	    # 「只提醒不擋」——紅了照樣印(呼叫端讀 last_bound),但不在這裡擋;高風險那條 pre-push 不帶這旗標,照舊擋。
 30026	
 30027	    # 3. 跑 pitfalls --diff <range> --no-lint --json 取 tier
 30028	    try:
 30029	        import sys as _sys
 30030	        graphctl = Path(__file__).resolve()
 30031	        r = _sp.run([_sys.executable, str(graphctl), "pitfalls",
 30032	                     "--diff", diff_range, "--no-lint", "--json",
 30033	                     "--repo", str(repo_root)],
 30034	                    capture_output=True, text=True, cwd=str(repo_root))
 30035	        if r.returncode != 0:
 30036	            _gate_failopen(repo_root, "pitfalls", f"pitfalls 回非零:{r.stderr.strip()[:120]}")
 30037	            return {"blocked": False, "reason": f"pitfalls 失敗(fail-open): {r.stderr.strip()[:120]}", "tier": "unknown"}
 30038	        lines = [l for l in r.stdout.splitlines() if l.strip().startswith("{")]
 30039	        if not lines:
 30040	            _gate_failopen(repo_root, "pitfalls", "pitfalls 沒有 JSON 輸出")
 30041	            return {"blocked": False, "reason": "pitfalls 無 JSON 輸出(fail-open)", "tier": "unknown"}
 30042	        data = _json.loads(lines[0])
 30043	        tier = data.get("tier", "standard")
 30044	    except Exception as e:
 30045	        _gate_failopen(repo_root, "pitfalls", f"pitfalls 例外:{str(e)[:120]}")
 30046	        return {"blocked": False, "reason": f"pitfalls 例外(fail-open): {e}", "tier": "unknown"}
 30047	
 30048	    # advisory 只准用在低風險(r1 外家 finder f4/否決 f3):pre-push 那邊 pitfalls 暫時失敗會空著 tier 而帶旗標,
 30049	    # 這裡自己算出 high 就不認旗標——紅測試重跑一次硬的,紅了照擋。
 30050	    if bound_advisory and tier == "high":
 30051	        bt = _bound_tests_check(repo_root, diff_range, skip=skip_bound, skip_note=skip_note, payload=payload, advisory=False)
 30052	        _codeloop_guard_verdict.last_bound = bt
 30053	        if bt["status"] in ("red", "unfilterable"):
 30054	            return {"blocked": True, "reason": bt["reason"] + "(tier=high,--bound-tests-advisory 不適用)", "tier": tier, "bound_tests": bt}
 30055	
 30056	    # 3.5 表態閘(Projects/棧別提問表態閘_計劃,2026-09-09):有適用題就核對,不看 tier(gate 設定 all/high-only/off)。
 30057	    # 判定順序=合約測試(2.5)→表態(3.5)→審查留痕(4/5):序列早退,先中的先報、修完再跑(r3 架構對齊席 A1 要求講明)。
 30058	    dv = {"blocked": False, "gate_mode": "?", "applicable": 0, "checked": 0, "problems": []}
 30059	    # 適用範圍(r3 邊界席 B1):算「哪些題適用」用 merge-base(主線, at_sha)..at_sha——把主線合進分支再推分支,
 30060	    # 推送範圍(remote..local)會把主線帶進來的碼算成本次要表態;推主線本身、或算不出主線/merge-base 才用推送範圍。tier 照舊用推送範圍。
