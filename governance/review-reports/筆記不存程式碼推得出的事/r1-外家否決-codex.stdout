 29742	    r = _sp.run(["git", "show", f"{at_sha}:{path}"], capture_output=True, text=True, cwd=str(repo_root), errors="ignore", timeout=_disp_git_timeout())
 29743	    return r.stdout if r.returncode == 0 else None
