 29760	def _dispositions_check_test(repo_root, at_sha, ev, pidx):
 29761	    """satisfied 的 test: 錨點兩道都要過(r2 三席一致,不要求工作樹乾淨):①工作樹 discovery(profile 語意、多平台)名字在集合裡
 29762	    ②有 at_sha 時 `git grep -F` 在被推送的樹的該平台 root 命中(未追蹤/未提交的測試自然不在樹)。root 在 repo 外(跨 repo)只做①。"""
 29763	    import subprocess as _sp
 29764	    pdata, split, default, methods_for, _hay, _loose = pidx   # ★六個值★:整包存起來、在這裡才解構,加欄位時最容易漏掉這一種
 29765	    plat, name = _dispositions_split_test(ev, split, default)
 29766	    if plat is None:
 29767	        return False, name
 29768	    if name not in methods_for(plat):
 29769	        return False, f"測試 {name!r} 在平台 {plat!r} 的工作樹掃不到(profile 認不得,或名字打錯)"
 29770	    if not at_sha:
 29771	        return True, ""
 29772	    root = Path(pdata["platforms"][plat]["root"]).resolve()
 29773	    rr = Path(repo_root).resolve()
 29774	    try:
 29775	        rel = root.relative_to(rr)
 29776	    except ValueError:
 29777	        return True, ""   # 跨 repo 的平台 root:at_sha 不屬於那個 repo,只做工作樹那一道
 29778	    # -w 整字比對(r3 邊界席 B2:-F 子字串會讓 testFoo 撞到 testFooBar);rc 128(pathspec 在 repo 外等)當「驗不了」明講
 29779	    # 只掃該 profile 的測試副檔名、排除 docs/ 與 governance/(r1 外家 finder f3:治理帳本身寫著 evidence 的 "test:<名>",
 29780	    # 表態後把帳 commit 進去,樹裡就找得到那個名字——未提交的測試靠這條就能冒充已提交)
 29781	    _prof = (pdata["platforms"].get(plat) or {}).get("profile")   # load_platforms 給的可能是 profile 名或已展開的 dict
 29782	    _exts = sorted((_prof.get("exts") if isinstance(_prof, dict) else TEST_PROFILES.get(_prof, {}).get("exts")) or [])
 29783	    _base = "" if str(rel) == "." else str(rel).rstrip("/") + "/"
 29784	    _spec = [f":(glob){_base}**/*{e}" for e in _exts] if _exts else [str(rel) if str(rel) != "." else "."]
 29785	    _spec += [":(exclude)docs/**", ":(exclude)governance/**"]
 29786	    r = _sp.run(["git", "grep", "-w", "-F", "-q", "-e", name, at_sha, "--", *_spec],
 29787	                capture_output=True, text=True, errors="replace", cwd=str(repo_root), timeout=_disp_git_timeout())
 29788	    if r.returncode == 1:
 29789	        return False, f"測試 {name!r} 在推送版本 {at_sha[:8]} 的樹裡整字 grep 不到(未追蹤/未提交的測試不算證據)"
 29790	    if r.returncode != 0:
 29791	        return False, f"測試 {name!r} 無法對推送版本的樹驗證(git grep rc={r.returncode}:{r.stderr.strip()[:80]})"
 29792	    return True, ""
