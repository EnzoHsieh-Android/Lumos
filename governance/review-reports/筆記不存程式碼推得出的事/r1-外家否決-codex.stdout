 29820	def _dispositions_verdict(repo_root, pf_data, marker_sha, marker_branch, at_sha, tier, deadline=None):
 29821	    """表態閘判定(S5):有適用題就核對,不看 tier(gate 設定 all/high-only/off)。回 dict{blocked, gate, applicable, checked, problems[]}。
 29822	    超過 deadline 時停下來、回 blocked=False 並標 over_budget(呼叫端走 fail-open 進治理帳)。"""
 29823	    import time as _time
 29824	    cfg = _stack_questions_config(repo_root)
 29825	    app = pf_data.get("stack_questions_applicable") or {}
 29826	    meta = pf_data.get("stack_questions_meta") or {}
 29827	    out = {"blocked": False, "gate_mode": cfg["mode"], "applicable": sum(len(v) for v in app.values()),
 29828	           "checked": 0, "problems": [], "warnings": list(cfg["warnings"]), "tensions": []}
 29829	    if not app or cfg["mode"] == "off" or (cfg["mode"] == "high-only" and tier != "high"):
 29830	        return out
 29831	    rec = _codeloop_read_dispositions(repo_root, marker_branch)
 29832	    if rec is None:
 29833	        out["problems"].append(f"分支 {marker_branch!r} 還沒有表態記錄(推 HEAD:別名 時表態要帶 --branch {marker_branch},查的是遠端目的分支;checkout 不在被推的版本時再帶 --at-sha {marker_sha[:12]})")
 29834	        out["blocked"] = True
 29835	        return out
 29836	    ok, why = _codeloop_record_valid(repo_root, str(rec.get("head_sha") or ""), marker_sha)
 29837	    if not ok:
 29838	        out["problems"].append(f"表態記錄過期:{why}——改了碼要重表態(樣板加 --carry 帶舊答案)")
 29839	        out["blocked"] = True
 29840	        return out
 29841	    disp = rec.get("dispositions") or {}
 29842	    cfg_path = Path(repo_root) / ".lumos" / "config.json"
 29843	    cfg_broken = False
 29844	    if cfg_path.is_file():
 29845	        try:
 29846	            import json as _j
 29847	            _j.loads(cfg_path.read_text(encoding="utf-8"))
 29848	        except Exception:
 29849	            cfg_broken = True
 29850	    pidx = None
 29851	
 29852	    def _one(qid, ent):
 29853	        """核對一題,回 None(過)或一句問題。★任何例外都由呼叫端接成「無法驗證」而不是整份 fail-open★
 29854	        (r1 正確性席 f1/邊界席 f1:壞 platforms 設定或 10-5 這種行號曾讓整份表態核對被吞成放行)。"""
 29855	        nonlocal pidx
 29856	        if ent is None:
 29857	            return f"{qid} 缺表態"
 29858	        if ent.get("auto"):
 29859	            return f"{qid} 工具判它適用,但表態是自動填的 na——要人答"
 29860	        st = ent.get("status")
 29861	
 29862	        def _ev(ev):
 29863	            """satisfied 與 tension(chosen=suggested)的 evidence 同一條驗法:test: 走測試索引+樹 grep,其餘 path:line 對樹驗存在。"""
 29864	            nonlocal pidx
 29865	            if ev.startswith("test:"):
 29866	                if cfg_broken:
 29867	                    return False, "無法驗證 test: 證據:.lumos/config.json 解析失敗(先修設定檔)"
 29868	                if pidx is None:
 29869	                    try:
 29870	                        pidx = _platform_test_index(Path(repo_root))
 29871	                    except Exception as e:
 29872	                        return False, f"無法驗證 test: 證據:.lumos/config.json 的 platforms 不合法({str(e)[:80]})——先修設定檔"
 29873	                return _dispositions_check_test(repo_root, at_sha, ev, pidx)
 29874	            return _dispositions_check_path_line(repo_root, at_sha, ev)
 29875	
 29876	        def _ev_msg(prefix, why2):
 29877	            """設定檔壞掉那幾條 why 本身就是「無法驗證…」,不再外包「對不上」(code-loop r1 單reviewer R1:包了會變雙重否定)。"""
 29878	            return f"{qid} {why2}" if why2.startswith("無法驗證") else f"{qid} {prefix}:{why2}"
 29879	
 29880	        if st == "satisfied":
 29881	            ok2, why2 = _ev(str(ent.get("evidence") or ""))
 29882	            return None if ok2 else _ev_msg("證據對不上", why2)
 29883	        if st == "tension":
 29884	            # 形狀再驗一次(治理帳重建來的紀錄不信形狀;缺欄 → 該題無法驗證,不炸整份),再對樹驗每個 existing
 29885	            shape = _dispositions_tension_shape(ent, check_evidence=False)
 29886	            if shape:
 29887	                return f"{qid} tension 形狀不對:{shape[0]}"
 29888	            paths = []
 29889	            for item in ent["existing"]:
 29890	                s = str(item)
 29891	                ok2, why2 = _dispositions_check_path_line(repo_root, at_sha, s)
 29892	                if not ok2:
 29893	                    return f"{qid} tension 的 existing 對不上:{why2}"
 29894	                paths.append(_dispositions_split_path_line(s)[0])   # 路徑用既有切分函式拿,不手刻(code-loop r1 架構對齊席 A2)
 29895	            if ent.get("chosen") == "suggested":
 29896	                ok2, why2 = _ev(str(ent.get("evidence") or ""))
 29897	                if not ok2:
 29898	                    return _ev_msg("tension 的 evidence 對不上", why2)
 29899	            out["tensions"].append({"id": qid, "chosen": ent.get("chosen"), "existing": [str(x) for x in ent["existing"]],
 29900	                                    "files": len(set(paths)), "hazard": str(ent.get("hazard") or ""), "suggestion": str(ent.get("suggestion") or "")})
 29901	            return None
 29902	        if st == "todo":
 29903	            ok2, why2 = _dispositions_check_issue(repo_root, at_sha, str(ent.get("issue") or ""))
 29904	            return None if ok2 else f"{qid} 待辦對不上:{why2}"
 29905	        if st == "na":
 29906	            return None if _dispositions_reason_ok(ent.get("reason")) else f"{qid} na 的理由太短"
 29907	        return f"{qid} status {st!r} 不合法"
 29908	
 29909	    for _stk, rows in meta.items():
 29910	        for row in rows:
 29911	            if not row.get("applicable"):
 29912	                continue
 29913	            if deadline is not None and _time.monotonic() > deadline:
 29914	                # 半途超時(r3 邊界席 B4):已經查出的違規不能丟——有問題就照擋、註明沒查完;一題都還沒查出問題才 fail-open
 29915	                out["over_budget"] = True
 29916	                if out["problems"]:
 29917	                    out["problems"].append("(表態核對超過時間預算,後面的題沒查完;上面已查出的照擋)")
 29918	                    out["blocked"] = True
 29919	                else:
 29920	                    out["blocked"] = False
 29921	                return out
 29922	            qid = row["id"]
 29923	            try:
 29924	                pr = _one(qid, disp.get(qid))
 29925	            except Exception as e:
 29926	                pr = f"{qid} 無法驗證(內部錯誤 {e.__class__.__name__}:{str(e)[:80]})——擋下不放行,修好再跑"
 29927	            if pr:
 29928	                out["problems"].append(pr)
 29929	            else:
 29930	                out["checked"] += 1
 29931	    out["blocked"] = bool(out["problems"])
 29932	    return out
 29933	
