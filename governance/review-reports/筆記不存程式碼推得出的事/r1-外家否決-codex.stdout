 28730	def _porcelain_z_paths(out):
 28731	    """把 `git status --porcelain -z` 的輸出切成路徑清單。
 28732	
 28733	    ★改名/複製會吐兩個片段★(2026-09-21 審查席):第一個是「兩碼狀態+空白+新路徑」,
 28734	    第二個是**裸的舊路徑,沒有前綴**。一律切 [3:] 會把舊路徑砍掉三個字元變成垃圾字串。
 28735	    目前帳本白名單全是固定字面路徑所以打不到,但前提本身是錯的,白名單一擴充就會漏列。
 28736	    """
 28737	    parts = [x for x in out.split("\0") if x]
 28738	    paths, i = [], 0
 28739	    while i < len(parts):
 28740	        ent = parts[i]
 28741	        if len(ent) < 4:
 28742	            i += 1
 28743	            continue
 28744	        paths.append(ent[3:])
 28745	        i += 2 if (ent[0] in ("R", "C") or ent[1] in ("R", "C")) else 1
 28746	    return paths
 28747	
 28748	
 28749	def _codeloop_print_dirty_bookkeeping(repo_root, status):
 28750	    """留痕之後,把「還沒提交的簿記檔」列成一行可直接貼的提交指令。
 28751	
 28752	    ★不是新的閘,是把手打路徑清單換成工具列出來★(2026-09-21 同一天犯兩次):
 28753	    留痕前通常剛跑過 anchor approve,簽名檔因此變髒;人手打清單時漏掉它,
 28754	    推送會被「簽名檔改過了但沒提交」擋下——重複犯的是打字,不是判斷。
 28755	    清單沿用 _BOOKKEEPING_FILES / _BOOKKEEPING_DIRS,不自開第二份判準。
 28756	    """
 28757	    import subprocess as _sp
 28758	    # -uall:未追蹤的目錄預設會被摺成一行(例如只印 governance/),逐檔列才對得上白名單
 28759	    r = _sp.run(["git", "status", "--porcelain", "-z", "-uall"], cwd=str(repo_root),
 28760	                capture_output=True, text=True, errors="replace")
 28761	    if r.returncode != 0:
 28762	        return
 28763	    dirty = []
 28764	    for rel in _porcelain_z_paths(r.stdout):
 28765	        # ★只列帳本檔本身,不列卷證目錄★(2026-09-21 自己試跑時踩到):
 28766	        # 把 _BOOKKEEPING_DIRS 一起算進來會列出 126 個檔,裡面全是別的 session 的
 28767	        # 審查卷證與舊的未提交證據——照貼會把別人的檔一起提交(同工作區夾帶風險)。
 28768	        # 卷證屬於功能提交,帳本檔才是留痕之後該單獨提交的東西。
 28769	        if rel in _BOOKKEEPING_FILES and rel not in dirty:
 28770	            dirty.append(rel)
 28771	    if not dirty:
 28772	        return
 28773	    msg = "chore(lumos): 記錄代碼審通過" if status == "passed" else "chore(lumos): 記錄代碼審跳過"
 28774	    print(f"  這幾個簿記檔還沒提交({len(dirty)} 個)——留痕之後只准提交它們,漏掉哪個推送都會被擋:")
 28775	    quoted = " ".join(_sh_quote(d) for d in dirty)
 28776	    print(f"    git commit -m '{msg}' -- {quoted}")
 28777	
 28778	
 28779	def _sh_quote(s):
 28780	    """路徑含空白或中文時照樣貼得上去。"""
 28781	    import shlex
 28782	    return shlex.quote(s)
