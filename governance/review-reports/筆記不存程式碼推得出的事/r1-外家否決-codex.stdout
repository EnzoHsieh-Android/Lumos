 29692	def _codeloop_record_valid(repo_root, rec_sha, marker_sha):
 29693	    """留痕座標有效性(pass/skip 與表態共用同一套):同 sha;或 rec_sha 是 marker_sha 的祖先且中間只動簿記檔
 29694	    ([[Issues/code-loop-pass自失效追尾]] 的豁免)。回 (ok, 一句為什麼)。"""
 29695	    import subprocess as _sp
 29696	    if not rec_sha:
 29697	        return False, "記錄沒有 sha"
 29698	    if rec_sha == marker_sha:
 29699	        return True, f"同版本 {marker_sha[:8]}"
 29700	    try:
 29701	        anc = _sp.run(["git", "merge-base", "--is-ancestor", rec_sha, marker_sha],
 29702	                      capture_output=True, text=True, errors="replace", cwd=str(repo_root), timeout=_disp_git_timeout())
 29703	        if anc.returncode not in (0, 1):
 29704	            # ★git 回 1 才是「不是祖先」;其他非零是那個提交在這份 repo 裡根本找不到★(代碼審 r1 通才席):
 29705	            # 寫錯的 sha、淺 clone、或物件被清掉。第一版把這種也講成「多半是壓過提交」,給了文不對題的重來指令。
 29706	            return False, (f"記錄 sha {rec_sha[:8]} 在這份 repo 裡找不到(寫錯、淺 clone、或已被清掉),"
 29707	                           "判不了是不是祖先——先確認那個提交還在,不在就照重來的步驟重記")
 29708	        if anc.returncode != 0:
 29709	            # ★講出最常見的原因與怎麼重來★(2026-09-22 rtb-production-agent-demo 回報):
 29710	            # 把本機提交壓成一個、或 rebase 之後,內容可以一模一樣,原本記的那個提交卻不再是祖先。
 29711	            # 只丟兩個 sha 的話,人看不出是自己剛做的壓提交造成的,也不知道要重跑哪兩個指令。
 29712	            return False, (f"記錄 sha {rec_sha[:8]} 不是目標 {marker_sha[:8]} 的祖先——多半是壓過提交或 rebase 改寫過歷史"
 29713	                           "(內容沒變也一樣失效)。重來:表態 `lumos pitfalls --diff <範圍> --dispositions-template --carry`"
 29714	                           " 再 `lumos code-loop dispositions <檔>`;審查留痕重跑 `lumos code-loop pass --note \"…\"`")
 29715	        df = _sp.run(["git", "diff", "--name-only", rec_sha, marker_sha],
 29716	                     capture_output=True, text=True, errors="replace", cwd=str(repo_root), timeout=_disp_git_timeout())
 29717	    except _sp.TimeoutExpired:
 29718	        return False, f"git 超過 {_disp_git_timeout():.0f} 秒沒回(merge-base/diff),判不了有效性"
 29719	    files = [f.strip() for f in df.stdout.splitlines() if f.strip()]
 29720	    if df.returncode == 0 and all(f in _BOOKKEEPING_FILES or f.startswith(_BOOKKEEPING_DIRS) for f in files):
 29721	        return True, f"祖先 {rec_sha[:8]}+簿記豁免(其後 {len(files)} 檔皆簿記)"
 29722	    return False, f"記錄 sha {rec_sha[:8]} 之後動了代碼(非純簿記增量)"
 29723	
 29724	
 29725	def _disp_git_timeout():
 29726	    """單次 git 子程序上限(秒;r1 併發席 f2:20 秒預算只在每題迴圈頂端查,單次 git 卡住預算攔不住)。
 29727	    超時往上拋 subprocess.TimeoutExpired,由每題的例外接手判「無法驗證」(擋,不放行)。"""
 29728	    try:
 29729	        return max(0.1, float(os.environ.get("LUMOS_DISP_GIT_TIMEOUT", "8")))
 29730	    except ValueError:
 29731	        return 8.0
 29732	
