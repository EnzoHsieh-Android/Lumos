 30480	# ── 接手視圖(Projects/接手視圖_計劃,2026-09-07)──────────────────────────────────────────
 30481	# 白話:四版「幫 agent 造一本進度帳」都被實測打穿(進度從提交推導_計劃 v1–v4)。這支不造帳,只把三個一直都在、
 30482	# 能可靠讀的來源讀成一張接手用的表——計劃點名的檔現在什麼 git 狀態、最後一輪在動什麼、使用者最後說了什麼。
 30483	# 讀不到就說讀不到(fail-open、恆 rc0:這是查詢不是閘)。★不印進度、不判做到哪、不猜★:線索不是狀態。
 30484	_HANDOFF_USER_MAX = 200   # 使用者最後一句只印前 200 字
 30485	# r1 外家 #4:派工鏡頭的正則只吃 ASCII 無空白;筆記慣例把路徑包在反引號裡,反引號內的路徑不限字元(空白、中文都收)。
 30486	# 前綴表要跟 _LENS_SPEC_CODE_RE 同一份(t_handoff_view 有漂移守衛:這裡每個前綴 lens 正則都得認得)
 30487	_HANDOFF_TICK_PREFIXES = ("scripts", "governance", "skills", "src", "app", "lib")
 30488	_HANDOFF_TICK_RE = re.compile(r"`((?:%s)/[^`\n]+)`" % "|".join(_HANDOFF_TICK_PREFIXES))
 30489	_HANDOFF_HOOK_REL = "hooks/claude/check-graph-sync.py"   # 相對 scripts/(lumos 所在目錄);重用它的逐字稿解析器,不重寫
