 29935	def _dispositions_template(pf_data, repo_root, branch=None, carry=False):
 29936	    """S1:適用題 status 留空、未觸發題自動 na(auto:true+觸發清單);--carry 從該分支最後一筆表態帶「id 相同且仍適用」的舊答案。"""
 29937	    meta = pf_data.get("stack_questions_meta") or {}
 29938	    tpl = {}
 29939	    old = {}
 29940	    if carry and branch:
 29941	        rec = _codeloop_read_dispositions(repo_root, branch)
 29942	        old = (rec or {}).get("dispositions") or {}
 29943	    # 可能撞的候選(pitfalls 算的,按題目 id 收):有候選的適用題帶一句 hint,提醒人這題可以用 tension 表態
 29944	    cands = {}
 29945	    for c in ((pf_data.get("arch_alignment") or {}).get("tension_candidates") or []):
 29946	        cands.setdefault(c.get("question"), []).append(c)
 29947	    for _stk, rows in meta.items():
 29948	        for row in rows:
 29949	            qid = row["id"]
 29950	            if row.get("applicable"):
 29951	                prev = old.get(qid)
 29952	                if carry and isinstance(prev, dict) and not prev.get("auto") and prev.get("status") in _DISP_STATUSES:
 29953	                    ent = dict(prev); ent["question"] = row["question"]; ent["carried"] = True
 29954	                    ent.pop("hint", None)   # 舊 hint 是上一輪的候選,不跟著答案走(r1 通才 G6:dict(prev) 整包淺拷貝會帶過來)
 29955	                else:
 29956	                    ent = {"status": "", "question": row["question"], "evidence": "", "reason": "", "issue": ""}
 29957	                    if qid in cands:
 29958	                        c = cands[qid][0]
 29959	                        more = f"(另有 {len(cands[qid]) - 1} 個改動檔也命中這題)" if len(cands[qid]) > 1 else ""
 29960	                        ent["hint"] = (f"候選張力:{c.get('file')} 新增 {'/'.join(c.get('patterns') or [])},對照檔 {', '.join(c.get('siblings') or [])} 都沒有"
 29961	                                       f"——刻意沿用既有寫法或刻意改用新做法,status 填 tension{more}")
 29962	            else:
 29963	                ent = {"status": "na", "question": row["question"], "auto": True,
 29964	                       "reason": "未觸發:" + ", ".join(spec_w for spec_w in (s["when"] for s in _STACK_QUESTION_SPECS[_stk] if s["id"] == qid) for spec_w in spec_w)}
 29965	            tpl[qid] = ent
 29966	    return tpl
 29967	
