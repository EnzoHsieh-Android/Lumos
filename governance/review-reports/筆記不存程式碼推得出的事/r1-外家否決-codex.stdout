 29746	def _dispositions_check_path_line(repo_root, at_sha, ev):
 29747	    """satisfied 的 path:line 錨點:走 refcheck 同一個入口 _validate_repo_ref(有 at_sha 對被推送的樹、沒有對工作樹;
 29748	    三態 missing/line_out_of_range/ok 同義;r3 架構對齊席 A3)。只驗存在不驗內容。"""
 29749	    p, line = _dispositions_split_path_line(ev)
 29750	    if p is None:
 29751	        return False, line
 29752	    st, _ = _validate_repo_ref(Path(repo_root), p, line, at_sha=at_sha)
 29753	    if st == "ok":
 29754	        return True, ""
 29755	    where = f"推送版本 {at_sha[:8]} 的樹" if at_sha else "工作樹"
 29756	    why = "不存在(未追蹤/未提交?)" if st == "missing" else "行號超出檔案長度"
 29757	    return False, f"{p}:{line} 在{where}{why}"
