 28831	def _bound_tests_log(repo_root, kind, nodes, note, secs=None, calc_secs=None):
 28832	    """治理帳 gate=bound-tests(獨立 gate,kind 裸結果詞;fail-open,寫不進不影響判定)。
 28833	
 28834	    ★secs / calc_secs 要當獨立欄位寫進帳★(2026-09-07 設計 [S6]):
 28835	    以前只塞在自由文字的 note 裡(「46 綠 41.8s」),回頭條件量不到——
 28836	    而這一案掛的兩條回頭條件都要問「近 30 天最大耗時多少」。
 28837	    ★第一版我只把它們放進回傳的 dict,帳上還是自由文字★——那等於沒做,
 28838	    因為回傳值不落盤,週跑回頭看的是帳。
 28839	    secs=跑測試那段;calc_secs=算波及那段。兩段成本的成因不同,不能加在一起。
 28840	    """
 28841	    try:
 28842	        vault = _vault_in(repo_root)
 28843	        if vault is not None:
 28844	            # ★hard 要跟著 kind 改名一起改★(代碼審 r1 外家否決席判 major,查證屬實):
 28845	            # kind 從 red 拆成 red-advisory / red-blocked 之後,這裡還在比對舊的 "red"
 28846	            # ——於是★高風險真的擋下去的那一筆會被記成 hard:false★,
 28847	            # 舊的呈現端依 hard 分「硬擋/軟」,會把真硬擋報成軟事件。
 28848	            _rec = {"gate": "bound-tests", "kind": kind,
 28849	                    "hard": kind == "red-blocked",
 28850	                    "nodes": list(nodes), "note": note}
 28851	            if secs is not None:
 28852	                _rec["secs"] = secs
 28853	            if calc_secs is not None:
 28854	                _rec["calc_secs"] = calc_secs
 28855	            _append_governance_log(vault, [_rec])
 28856	    except Exception:
