++++ # P18
++++ id: kt-lifecycle-collect-without-repeat
++++ language: kotlin
++++ severity: warning
++++ message: '[STATE-5]lifecycleScope.launch 直接 collect,到背景仍在收;改用 repeatOnLifecycle(STARTED),Compose 用 collectAsStateWithLifecycle()'
++++ ignores: ['**/src/test*/**', '**/src/androidTest*/**']
+++++# Service 不是畫面:官方說 repeatOnLifecycle 是為了「只在 UI 顯示在畫面上時處理」,
+++++# 所以外圍任一層類別自己的繼承清單有 LifecycleService、MediaSessionService、MediaLibraryService 建構子呼叫時不報。
+++++# 寫法照 architecture.yml 的 kt-register-without-unregister 排除 Application 那段(has 只看類別自己的繼承清單)。
++++ rule:
+++++  not:
+++++    inside:
+++++      kind: class_declaration
+++++      has:
+++++        kind: delegation_specifier
+++++        regex: '^(androidx\.lifecycle\.|androidx\.media3\.session\.)?(LifecycleService|MediaSessionService|MediaLibraryService)\s*\('
+++++      stopBy: end
++++   any:
++++     - all:
++++         - any:
++++             - pattern: $F.collect { $$$ }
++++             - pattern: $F.collect($$$)
++++             - pattern: $F.collectLatest { $$$ }
++++             - pattern: $F.collectLatest($$$)
++++         - inside:
++++             any:
++++               - pattern: lifecycleScope.launch { $$$ }
