+def _stack_guess():
+    """副檔名 → (test_profile 或 "", symbol_profile 或 "", 人話)。反查自兩張正典表,結果 cache。
+
+    ★對不到就留空字串,不硬湊★:例如 `.dart` 沒有任何 symbol profile 認領、`.vue` 沒有任何
+    test profile 認領。留空的後果是 init 產出的骨架該欄是空的,而健檢 S3 會唸「你的程式碼是
+    這種副檔名、但設定認的是別的」——比硬填一個不存在的值好,因為那個值只會換來每次讀設定
+    都印一行警告、而且永遠沒人知道為什麼。"""
+    cached = getattr(_stack_guess, "_cache", None)
+    if cached is not None:
+        return cached
+    tp_by_ext, sp_by_ext = {}, {}
+    for name, prof in TEST_PROFILES.items():
+        for ext in (prof.get("exts") or ()):
+            if ext in _STACK_GUESS_SKIP_EXTS:
+                continue
+            cur = tp_by_ext.get(ext)
+            if cur is None or _STACK_PREFER_TEST.get(name, 0) > _STACK_PREFER_TEST.get(cur, 0):
+                tp_by_ext[ext] = name
+    for name, prof in SYMBOL_PROFILES.items():
+        for ext in (prof.get("code_exts") or ()):
+            sp_by_ext.setdefault(ext, [])
+            sp_by_ext[ext].append(name)
+    # 一個副檔名被多個 symbol profile 認領時,★挑跟測試 profile 同一種語言的那個★——
+    # 判準也是反查出來的,不再多開一張表:哪個 symbol profile 的副檔名跟這支測試 profile
+    # 重疊最多,就當它們是同一種語言。實例:`.js` 同時被 csharp(它的清單裡混了 .vue/.js/.sql)
+    # 與 typescript 認領,而 .js 的測試 profile 是 node-jest,跟 typescript 重疊 6 個、
+    # 跟 csharp 只重疊 1 個 → 挑 typescript。沒挑到就退回「有認領的隨便一個」。
+    partner = {}
+    for tname, tprof in TEST_PROFILES.items():
+        texts = set(tprof.get("exts") or ())
+        best, best_n = "", 0
+        for sname, sprof in SYMBOL_PROFILES.items():
+            n = len(texts & set(sprof.get("code_exts") or ()))
+            if n > best_n:
+                best, best_n = sname, n
+        partner[tname] = best
+    out = {}
+    for ext in set(tp_by_ext) | set(sp_by_ext):
+        if ext in _STACK_GUESS_SKIP_EXTS:
+            continue
+        owners = sp_by_ext.get(ext) or []
+        pick = partner.get(tp_by_ext.get(ext, ""), "")
+        sp = pick if pick in owners else (owners[0] if owners else "")
+        out[ext] = (tp_by_ext.get(ext, ""), sp, _STACK_HUMAN.get(ext, ext))
+    _stack_guess._cache = out
+    return out
