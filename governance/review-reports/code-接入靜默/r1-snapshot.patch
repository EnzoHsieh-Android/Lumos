+    ★跑 0 支、印成功、退出碼 0★——calc-ios 實測:-only-testing 少寫類別段時
+    xcodebuild 執行 0 支測試仍回 0,閘因此回報「4 支全綠」。那不是綠,是假綠。
+
+    做法借既有 lint-check --smoke 的形狀:拿一個故意不存在的測試名跑一次。
+    回不為 0 → 這指令分得出「找不到測試」,可信;回 0 → 它對任何名字都說成功,不可信。
+
+    結果按 (root, run_cmd) 快取在 ~/.cache/lumos/bound-filter/(指令一改 key 就變,不必 TTL)。
+    回 (可信 bool, 一句原因)。"""
+    import hashlib, json as _j, os as _os
+    if "{method}" not in run_cmd:
+        return True, "整套跑,不靠過濾"
+    key = hashlib.sha256(f"{_os.path.realpath(str(root))}|{run_cmd}".encode("utf-8")).hexdigest()
+    cache = Path.home() / ".cache" / "lumos" / "bound-filter" / f"{key}.json"
+    if cache.exists():
+        try:
+            d = _j.loads(cache.read_text(encoding="utf-8"))
+            return bool(d["trustworthy"]), d.get("why", "")
+        except Exception:
+            pass
+    import shlex as _shlex
+    probe_cmd = run_cmd.replace("{method}", _shlex.quote(_FILTER_PROBE_NAME))
+    rc, tail, secs, to = _kill_run(probe_cmd, str(root), timeout)
+    if to:
+        ok, why = True, f"冒煙測試超時({int(secs)}s),不因此判它不可信"
+    elif rc == 0:
+        ok, why = False, ("這個測試指令對一個根本不存在的測試名也回成功——代表它的過濾條件沒有生效,"
+                          "閘拿它的退出碼當「測試跑過」會是假綠")
+    else:
+        ok, why = True, f"冒煙測試回 rc={rc},指令分得出找不到測試"
+    try:
+        cache.parent.mkdir(parents=True, exist_ok=True)
+        _write_lf(cache, _j.dumps({"trustworthy": ok, "why": why, "secs": secs}, ensure_ascii=False) + "\n")
+    except OSError:
+        pass
+    return ok, why
