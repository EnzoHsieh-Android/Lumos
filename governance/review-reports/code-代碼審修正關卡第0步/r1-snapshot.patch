+def _fix_check_events(rr, loop_id, round_id):
+    """治理帳裡這個迴圈這一輪的 fix-check 事件(照帳上順序)。位元組逐行預篩再整批交給 _drift_jsonl_parse(帳約 16MB)。"""
+    p = Path(rr) / "docs" / ".governance-log.jsonl"
+    try:
+        raw = p.read_bytes()
+    except OSError:
+        return []
+    keep = b"\n".join(ln for ln in raw.split(b"\n") if b'"fix-check"' in ln)
+    return [d for d in _drift_jsonl_parse(keep)
+            if d.get("gate") == "fix-check" and d.get("loop") == loop_id and d.get("round") == round_id]
