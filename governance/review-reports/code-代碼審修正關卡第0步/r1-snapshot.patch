+    groups = [{"id": f"G{i}", "category": "", "findings": [f],
+               "paths": [{"at": "<檔案:函式>", "status": "fixed", "tests": ["<測試名>"]}]}
+              for i, f in enumerate(need, 1)]
+    print(json.dumps({"base": base, "groups": groups}, ensure_ascii=False, indent=2))
+    print(f"[fix-check] 寫到 {_fix_record_path(rr, loop_id, round_id)};category 從 {', '.join(_FIX_CHECK_CATEGORIES)} 挑", file=sys.stderr)
