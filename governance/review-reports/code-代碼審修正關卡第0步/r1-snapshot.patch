+def _fix_check_status(env, repo, loop_id, rows):
+    """loop next 用:最新一輪有要修正紀錄的折入時,回 {status: needed|passed|skipped, round, cmd};不用管就回 None。
+    最後一筆同輪事件是 passed、record_sha256 等於現檔、head_sha 是 40 碼且 _codeloop_record_valid_ex 判有效(之後只動簿記檔)
+    → passed;是 skipped-env 且 head_sha 有效 → skipped;其餘(含 warned、紀錄改過、之後又改了程式)→ needed。"""
+    import hashlib
+    import shlex
+    rr = Path(repo).resolve() if repo else _vault_repo_root(env)
+    groups, _msg = _disposal_round_groups(rows) if rows else (None, None)
+    if not groups:
+        return None
+    last = list(groups.keys())[-1]
+    if str(last).startswith("__seq") or _FIX_ID_BAD_RE.search(str(last)):
+        return None
+    car = _fix_carrier(rows, last)
+    if car is None or not _fix_needed(car)[0]:
+        return None
+    rpath = _fix_record_path(rr, loop_id, last)
+    base_cmd = f"lumos loop fix-check {shlex.quote(loop_id)} --round {shlex.quote(last)}"
+    if not rpath.is_file():
+        return {"status": "needed", "round": last,
+                "cmd": f"{base_cmd} --record-template > {shlex.quote(str(rpath.relative_to(rr)) if rpath.is_relative_to(rr) else str(rpath))}"}
+    evs = _fix_check_events(rr, loop_id, last)
+    if evs:
+        e = evs[-1]
+        hs = e.get("head_sha")
+        head = _git_head(rr)
+        valid = False
+        if isinstance(hs, str) and re.fullmatch(r"[0-9a-f]{40}", hs) and head:
+            ok, _why, unsure = _codeloop_record_valid_ex(rr, hs, head)
+            valid = bool(ok) and not unsure
+        if valid and e.get("kind") == "skipped-env":
+            return {"status": "skipped", "round": last, "cmd": base_cmd}
+        if valid and e.get("kind") == "passed":
+            try:
+                rsha = hashlib.sha256(rpath.read_bytes()).hexdigest()
+            except OSError:
+                rsha = ""
+            if e.get("record_sha256") == rsha:
+                return {"status": "passed", "round": last, "cmd": base_cmd}
+    return {"status": "needed", "round": last, "cmd": base_cmd}
+
