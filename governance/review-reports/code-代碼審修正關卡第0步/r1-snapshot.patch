+def _fix_item_repeat(env, rr, rows, groups, round_id, rec, carrier):
+    """第 2 項 同類連兩輪:前一輪紀錄有同類別(other 不算)、這組有 ≥major 的發現 → 要寫 prior。"""
+    if not groups:
+        return []
+    keys = list(groups.keys())
+    if round_id not in keys or keys.index(round_id) == 0:
+        return []
+    prev = keys[keys.index(round_id) - 1]
+    if _FIX_ID_BAD_RE.search(prev):
+        return []
+    prev_rec, err = _fix_load_record(_fix_record_path(rr, rows[0].get("loop"), prev))
+    if prev_rec is None:
+        return []
+    prev_cats = {g.get("category") for g in prev_rec["groups"]} - {"other", None}
+    sev = carrier.get("finding_severities") if isinstance(carrier.get("finding_severities"), dict) else {}
+    round_max = max((_FIX_SEV_RANK.get(str(r.get("severity") or ""), 0) for r in groups[round_id]), default=0)
+    probs = []
+    for g in rec["groups"]:
+        if g.get("category") not in prev_cats:
+            continue
+        fs = [str(x) for x in (g.get("findings") or [])] if isinstance(g.get("findings"), list) else []
+        hi = max((_FIX_SEV_RANK.get(str(sev[f]), 0) if f in sev else round_max for f in fs), default=0)
+        if hi < _FIX_SEV_RANK["major"]:
+            continue
+        pr = g.get("prior") if isinstance(g.get("prior"), dict) else {}
+        if not all(isinstance(pr.get(k), str) and len(pr[k].strip()) >= 10 for k in ("why_failed", "new_approach")):
+            probs.append(f"組 {g.get('id', '?')}:{g.get('category')} 類上一輪({prev})也修過、這輪又有 major 以上——"
+                         "要寫 prior.why_failed(上次為什麼沒守住)與 prior.new_approach(這次換什麼做法),各至少十個字")
+    return probs
+
