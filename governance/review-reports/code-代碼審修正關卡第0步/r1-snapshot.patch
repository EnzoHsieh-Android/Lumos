+    gl.unlink(); gl.mkdir()
+    _fc_record(root, base, [_fc_group()])
+    r = _fc_check(root, v)
+    check("⑧寫不進帳時印「這次結果沒記到帳」", "這次結果沒記到帳" in r.stdout, r.stdout[-400:])
