+def _isolated_worktree_sweep(repo, prefix):
+    """清系統暫存資料夾裡同前綴、修改時間超過 _LINT_NEW_STALE_SEC 的殘骸(被強殺時收尾不會執行;規則借 _lint_new_clean_stale)。
+    底下是工作樹的先 `worktree remove --force`;remove 失敗(多半是別的 repo 留下的)就直接刪資料夾,那個 repo 下次 prune 會清掉登記。"""
+    import shutil
+    import subprocess
+    import tempfile
+    base = Path(os.path.realpath(tempfile.gettempdir()))
+    now = time.time()
+    hit = False
+    for d in base.glob(prefix + "*"):
+        try:
+            if not d.is_dir() or now - d.stat().st_mtime <= _LINT_NEW_STALE_SEC:
+                continue
+        except OSError:
+            continue
+        wt = d / "wt"
+        if wt.exists():
