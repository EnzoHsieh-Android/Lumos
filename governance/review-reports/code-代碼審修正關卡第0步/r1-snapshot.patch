+def _classify_test_refs(text, node, split, default, methods_for, hay_for):
+    """一段含 `[test:…]` 的文字 → [(node, 平台, 方法, real|fake|dangling|bad-name)]。推送前合約測試閘與修正關卡第 3 項共用
