+def _fix_test_name_bad(name):
+    """解析前的格式檢查:不能是空的、不能含 ] 或 ,(包成 [test:名] 時會被截斷或拆開);其他字元留給拆出平台後的方法名白名單。"""
+    if not isinstance(name, str) or not name.strip():
+        return "測試名是空的"
+    if "]" in name or "," in name:
+        return f"測試名 {name!r} 含 ] 或 ,(包成 [test:名] 解析時會被截斷或拆開)"
+    return ""
