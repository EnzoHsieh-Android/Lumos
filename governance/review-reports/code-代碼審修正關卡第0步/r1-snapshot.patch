+            return None, f"修正紀錄超過 {_FIX_CHECK_MAX_BYTES // 1024}KB"
+        rec = json.loads(path.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return None, f"找不到修正紀錄 {path}(用 --record-template 產骨架)"
+    except (OSError, ValueError, RecursionError) as e:
+        return None, f"修正紀錄讀不懂({type(e).__name__}: {str(e)[:80]})"
+    if not isinstance(rec, dict) or not isinstance(rec.get("groups"), list) or not isinstance(rec.get("base", ""), str):
+        return None, "修正紀錄的形狀不對:頂層要是物件,有 base(字串)與 groups(陣列)"
+    if len(rec["groups"]) > _FIX_CHECK_MAX_GROUPS or any(not isinstance(g, dict) for g in rec["groups"]):
+        return None, f"groups 要是物件陣列、最多 {_FIX_CHECK_MAX_GROUPS} 組"
+    n_tests = 0
+    for g in rec["groups"]:
+        if not isinstance(g.get("paths", []), list) or any(not isinstance(x, dict) for x in g.get("paths", [])):
+            return None, f"組 {g.get('id', '?')} 的 paths 要是物件陣列"
+        for x in g.get("paths", []):
+            if not isinstance(x.get("tests", []), list):
+                return None, f"組 {g.get('id', '?')} 有條路徑的 tests 不是陣列"
+            n_tests += len(x.get("tests", []))
+    if n_tests > _FIX_CHECK_MAX_TESTS:
+        return None, f"測試名一共 {n_tests} 支,超過上限 {_FIX_CHECK_MAX_TESTS}"
+    return rec, ""
