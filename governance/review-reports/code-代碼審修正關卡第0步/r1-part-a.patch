+def _fix_item_record(rec, need, round_findings, changed, head, tree):
+    """第 1 項 紀錄完整。回問題清單。"""
+    probs = []
+    placed = set()
+    for g in rec["groups"]:
+        gid = str(g.get("id") or "?")
+        cat = g.get("category")
+        if cat not in _FIX_CHECK_CATEGORIES:
+            probs.append(f"組 {gid}:category {cat!r} 不在固定清單({', '.join(_FIX_CHECK_CATEGORIES)})")
+        elif cat == "other" and not _escape_reason_ok(g.get("note")):
+            probs.append(f"組 {gid}:category 是 other 要寫 note")
+        fs = [str(x) for x in (g.get("findings") or [])] if isinstance(g.get("findings"), list) else []
+        for f in fs:
+            if f not in round_findings:
+                probs.append(f"組 {gid}:發現 {f} 不在這一輪的發現清單裡")
+        placed |= set(fs)
+        paths = g.get("paths") or []
+        if not any(x.get("status") == "fixed" for x in paths):
+            probs.append(f"組 {gid}:至少要有一條 status=fixed 的路徑")
+        for i, x in enumerate(paths, 1):
+            where = f"組 {gid} 第 {i} 條路徑"
+            st = x.get("status")
+            at = x.get("at") if isinstance(x.get("at"), str) else ""
+            fpath, _, func = at.partition(":")
+            if st not in ("fixed", "unaffected"):
+                probs.append(f"{where}:status 要是 fixed 或 unaffected")
+                continue
+            if not fpath or not func.strip():
+                probs.append(f"{where}:at 要寫「檔案:函式」,兩段都不能是空的({at!r})")
+                continue
+            if not re.search(r"\w", func):
+                probs.append(f"{where}:函式段 {func!r} 要含字母、數字、底線或中日韓文字")
+                continue
+            if fpath.startswith("/") or ".." in fpath.split("/"):
+                probs.append(f"{where}:檔案 {fpath!r} 不能是絕對路徑、不能含 ..")
+                continue
+            kind = _fix_ls_tree(tree, head, fpath)
+            deleted = kind is None and fpath in changed
+            if st == "fixed":
+                tests = x.get("tests") or []
+                if not tests:
+                    probs.append(f"{where}:fixed 至少要列一支測試")
+                for t in tests:
+                    bad = _fix_test_name_bad(t)
+                    if bad:
+                        probs.append(f"{where}:{bad}")
+                if fpath not in changed:
