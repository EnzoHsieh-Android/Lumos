+def _fix_git_z(repo_root, *args):
+    import subprocess
+    r = subprocess.run(["git", "-C", str(repo_root), *args], capture_output=True)
+    if r.returncode != 0:
+        return None
+    return [x.decode("utf-8", "surrogateescape") for x in r.stdout.split(b"\0") if x]
