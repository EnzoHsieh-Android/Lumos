+def _fix_ls_tree(repo_root, rev, path):
+    """提交裡那條路徑的類型:'blob100644'/'blob100755'/'tree'/'commit'/'link'/None(不在)。"""
+    import subprocess
+    r = subprocess.run(["git", "-C", str(repo_root), "ls-tree", "-z", "--full-tree", rev, "--", path], capture_output=True)
+    ent = [x for x in r.stdout.split(b"\0") if x]
+    if r.returncode != 0 or not ent:
+        return None
+    meta = ent[0].split(b"\t", 1)[0].split()
+    mode, typ = meta[0].decode(), meta[1].decode()
+    if typ == "blob":
+        return "link" if mode == "120000" else "blob" + mode
+    return typ
+
