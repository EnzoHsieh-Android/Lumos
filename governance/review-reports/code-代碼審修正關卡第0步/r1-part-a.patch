+def _fix_rev(repo_root, rev):
+    """修正紀錄的 base → 40 碼;以 - 開頭的輸入不會被當旗標(--end-of-options)。轉不成回 ""。"""
+    import subprocess
+    if not isinstance(rev, str) or not rev.strip():
+        return ""
+    r = subprocess.run(["git", "-C", str(repo_root), "rev-parse", "--verify", "--quiet", "--end-of-options", rev.strip() + "^{commit}"],
+                       capture_output=True, text=True, errors="replace")
+    out = r.stdout.strip()
+    return out if r.returncode == 0 and re.fullmatch(r"[0-9a-f]{40}", out) else ""
+
