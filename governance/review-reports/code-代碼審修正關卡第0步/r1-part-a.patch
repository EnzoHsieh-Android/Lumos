+class _IsolatedWorktree:
+    """共用的隔離工作樹(with 區塊):暫存資料夾 + `git -C <where> worktree add --detach <樹> [<commit>]`,離開時收掉
+    (`worktree remove --force` → 刪暫存資料夾 → `worktree prune`)。guard kill 與修正關卡共用(Projects/代碼審修正關卡第0步_計劃)。
+    建樹失敗不丟例外:`ok` 為 False、`err` 是 git 標準錯誤去頭尾空白的前 120 字(guard kill 原本的截法),呼叫端自己決定怎麼記。
+    keep=True 時兩層都留,「現場保留」由呼叫端的 on_keep(樹的路徑) 印——共用函式自己不印(guard kill --json 時要印到標準錯誤)。
+    sweep_repo 給了就在建樹前清同前綴、超過 _LINT_NEW_STALE_SEC 的殘骸(只有修正關卡打開;guard kill 不清,行為不變)。"""
+
+    def __init__(self, where, commit="", prefix="lumos-wt-", keep=False, on_keep=None, sweep_repo=None):
+        self.where, self.commit, self.prefix = where, commit, prefix
+        self.keep, self.on_keep, self.sweep_repo = keep, on_keep, sweep_repo
+        self.parent = self.path = None
+        self.ok, self.err = False, ""
+
+    def __enter__(self):
+        import os
+        import shutil
+        import subprocess
+        import tempfile
+        if self.sweep_repo is not None:
+            _isolated_worktree_sweep(self.sweep_repo, self.prefix)
+        self.parent = tempfile.mkdtemp(prefix=self.prefix)
+        self.path = os.path.join(self.parent, "wt")
+        try:
+            r = subprocess.run(["git", "-C", str(self.where), "worktree", "add", "--detach", self.path]
+                               + ([self.commit] if self.commit else []),
+                               capture_output=True, text=True, errors="replace")
+        except BaseException:
+            shutil.rmtree(self.parent, ignore_errors=True)
+            raise
+        self.ok = r.returncode == 0
+        self.err = "" if self.ok else r.stderr.strip()[:120]
+        return self
+
+    def __exit__(self, *exc):
+        import shutil
+        import subprocess
+        if self.keep:
+            if self.on_keep is not None:
+                self.on_keep(self.path)
+            return False
+        if self.ok:
+            subprocess.run(["git", "-C", str(self.where), "worktree", "remove", "--force", self.path], capture_output=True)
+        shutil.rmtree(self.parent, ignore_errors=True)   # 建樹失敗也清
+        if self.ok:
+            subprocess.run(["git", "-C", str(self.where), "worktree", "prune"], capture_output=True)   # 資料夾沒了才修登記
+        return False
