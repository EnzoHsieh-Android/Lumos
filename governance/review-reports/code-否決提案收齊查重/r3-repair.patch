+        by = ",".join(str(x) for x in by) if isinstance(by, list) else str(by or "").strip()
         items.append({"node": rel, "kind": "superseded-decision",
-                      "content": first_line(str(d.get("content", "")), 160), "context": d.get("superseded_by")})
+                      "content": first_line(str(d.get("content", "")), 160), "context": by or None})
     seen, uniq = set(), []
     for x in items:
         key = (x["node"], x["kind"], x["content"], x["context"])
         if key not in seen:
             seen.add(key)
             uniq.append(x)
     order = {k: i for i, (k, _t) in enumerate(_REJ_KIND_TITLE)}
     uniq.sort(key=lambda x: (order[x["kind"]], x["node"]))
     return uniq
 
 
