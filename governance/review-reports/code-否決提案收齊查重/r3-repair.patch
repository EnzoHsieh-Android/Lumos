 def _rejections_collect(env):
     """全庫舊否決 → [{"node": 路徑(帶 .md,同其他指令的 JSON), "kind", "content", "context"}],照種類、來源篇排序。
+    每欄都是字串(翻案沒寫推翻者時 context 是 None):決策欄位可能被寫成區塊清單,要先正規化才能當去重鍵(代碼審 r2)。
     同一篇裡內容與脈絡都一樣的只留一筆(摘要和正文常寫同一行 WHY)。"""
     items = [x for rel, _no, _pf, _rest, sp in _slot_summary_entries(env, ("WHY",)) for x in _rejections_why_alts(rel, sp)]
     for rel in sorted(env.notes):
         items += _rejections_of_note(env, rel)
     for rel, d in _superseded_decisions(env):
