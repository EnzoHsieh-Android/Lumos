+ E2E_RECORDS_DIR = ".lumos/e2e-records"
+ E2E_MATERIAL_DIRS = (".maestro",)   # 驗收素材目錄:驗收 flow、共用 flow、config.yaml、toolkit 腳本與基準圖
+ E2E_THRESHOLDS = ".lumos/macrobench-thresholds.json"
+ E2E_STAB_CHECKS = ("native_unreachable", "java_growth", "instances", "peak_vitals", "exits", "strictmode")   # 預設要求的記憶體 check
+ E2E_RESULTS = ("pass", "fail", "unjudged")
+ 
+ 
+ def _e2e_relpath_err(p, what):
+     """相對專案根的路徑:非空字串、不是絕對路徑、不含 ..、不是 . 本身、寫法正規(沒有 //、/./)、不含萬用字元。回錯誤訊息或 None。
+     app_dirs、exclude、flows、apk 與功能對照表的 paths 共用這一支:比對一律是字串前綴(_e2e_under),
+@@ -40613,20 +40616,69 @@ def _e2e_case_err(where, cn, c, e2e, scen, flows, screens):
