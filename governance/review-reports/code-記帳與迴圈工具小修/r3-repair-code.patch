+        check("S42 長編號:指令裡是完整編號、沒有截斷符號", r.returncode == 2 and f"--loop {_shq.quote(long_id)} " in r.stderr and "長…" not in r.stderr, r.stderr[-400:])
+        for label, extra in (("第一筆沒帶輪次", ["--tier", "standard"]), ("代碼審第一筆沒帶 --tier", [])):
