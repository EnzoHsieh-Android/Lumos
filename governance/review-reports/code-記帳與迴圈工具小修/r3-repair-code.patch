+        r = _rf_rec(v, "code-x'; touch /tmp/p #", rpt, snap, "--tier", "standard")
+        check("S42 編號帶引號與分號:指令照 shell 規則 quote", "--loop 'code-x'\"'\"'; touch /tmp/p #'" in r.stderr, r.stderr[-300:])
