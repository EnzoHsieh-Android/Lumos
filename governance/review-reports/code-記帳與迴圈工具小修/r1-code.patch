+def _loop_round_format(rows):
+    """一個迴圈的帳列輪次格式:empty(零筆)/ all(每筆帶 round)/ none(都不帶)/ mixed(有的帶有的不帶)。
+    數法就是 "round" in r——loop next 開頭那道混用守衛與 canary record 寫側共用這一支(記帳與迴圈工具小修_計劃 d1);
+    結局帳列(--outcome,結構上不帶 round)照算,跟讀側判混用同一個數法,寫側才不會放行讀側判不了的帳。"""
+    if not rows:
+        return "empty"
+    n = sum(1 for r in rows if "round" in r)
+    return "all" if n == len(rows) else "none" if n == 0 else "mixed"
+
+
