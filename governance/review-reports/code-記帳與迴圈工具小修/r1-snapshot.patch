+    base = {"ts": "2026-10-01T12:00:00+08:00", "kind": "none", "auditor": "舊席-sonnet", "token": "T-" + _j.dumps(row)[:12], "note": ""}
+    base.update(row)
+    with open(root / "docs" / ".canary-log.jsonl", "a", encoding="utf-8") as f:
+        f.write(_j.dumps(base, ensure_ascii=False) + "\n")
+
