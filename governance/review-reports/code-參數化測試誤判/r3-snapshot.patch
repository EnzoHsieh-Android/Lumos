+def _py_declared_methods(repo_root, profile):
+    """Python 那棧的宣告集:用標準函式庫的語法剖析,不管縮排、類別內外都算。剖不動任一檔就回 None。
+
+    ★不要用放寬的正則去掃★(代碼審 r2 通才席 blocker):Python 的掃描刻意不剝字串,
+    而原本的行首錨同時兼任了「別把字串裡的東西當宣告」這個守門。把錨放寬之後,
+    docstring 裡縮排的程式範例會被當成真宣告——實測本 repo 自己的測試檔就多算 148 個,
+    那會把「同一支測試的多組輸入」誤判成撞名,原地重現這批本來要修的那個誤擋。
+    語法剖析看的是真的語法樹,字串就是字串,不會有這個問題。
+    """
+    import ast
+    mre = profile["method_re"]
+    names = set()
+    for txt in _walk_test_files(repo_root, profile):
+        try:
+            tree = ast.parse(txt)
+        except (SyntaxError, ValueError, RecursionError):
+            return None      # 有檔剖不動 → 這個 repo 我沒把握掃得全,回「不知道」
+        for node in ast.walk(tree):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                names.add(node.name)
+    # 用這個 profile 自己的樣式篩出「長得像測試」的:篩不到就是 0,呼叫端當成「不只一支」不豁免(安全邊)
+    return {n for n in names if mre.match(f"def {n}(")}
+
+
+def _loose_declared_methods(repo_root, profile=None):
+    """回「不管縮排、類別內外都算」的宣告集;沒有精確的做法就回 None(=不知道,不豁免)。
+
+    回 None 的意思是「這個棧我沒把握掃得全」,呼叫端要當成「不知道」而不是「沒有別的」——
+    少算一支就會把真撞名放行(代碼審 r1 blocker)。
+    """
+    profile = profile or load_test_profile(repo_root)
+    mre = profile.get("method_re")
+    src = getattr(mre, "pattern", "") or ""
+    if not src:
+        return None
+    import re as _re
+    body = _re.sub(r"^\(\?[aiLmsux]+\)", "", src)   # 先剝行內旗標,旗標順序不該影響判斷
+    if not body.startswith("^"):
+        # 這個棧的宣告樣式本來就不錨在行首,正規那支已經掃得到縮排與類別裡的
+        return discover_test_methods(repo_root, profile)
+    if ".py" in {str(x).lower() for x in (profile.get("exts") or ())}:
+        return _py_declared_methods(repo_root, profile)
+    # 錨在行首、又不是 Python:沒有精確的放寬做法(放寬正則會把字串內容也撈進來),不豁免
+    return None
+
