 10613	def _reinject_all(root: Path, slug: str, quiet=False):
 10614	    """對所有目標各跑一次 _reinject_claude_block,印人話,回 {target: ReInjectResult}。
 10615	    既有 AGENTS 檔第一次被注入(appended)時印它前 8 行——語意衝突機器判不了(r2 整合 F12)。"""
 10616	    out = {}
 10617	    for t in _reinject_targets(root):
 10618	        ri = _reinject_claude_block(root, slug, target=t)
 10619	        out[t] = ri
 10620	        if quiet:
 10621	            continue
 10622	        if ri.status == "updated":
 10623	            print(f"  {t} 紀律區塊已更新")
 10624	            if ri.diff and t == "CLAUDE.md":
 10625	                for line in ri.diff.splitlines()[:20]:  # 最多印 20 行 diff 摘要
 10626	                    print(f"    {line}")
 10627	        elif ri.status in ("created", "appended"):
 10628	            print(f"  {t} 紀律區塊已注入({ri.status})")
 10629	            if ri.status == "appended" and t != "CLAUDE.md":
 10630	                head = (root / t).read_text(encoding="utf-8", errors="replace").splitlines()
 10631	                own = [l for l in head if "LUMOS:GRAPH-DISCIPLINE" not in l][:8]
 10632	                print(f"  ★{t} 原本就有內容,看一眼它跟紀律區塊有沒有互相打架(機器判不了語意):")
 10633	                for l in own:
 10634	                    print(f"    | {l[:100]}")
 10635	        elif ri.status == "sentinel_broken":
 10636	            print(f"  ⚠ {t} sentinel 半壞,未自動覆蓋,請檢查", file=sys.stderr)
 10637	        # unchanged / no_template → 靜默
 10638	    return out
 10639	
 10640	
 10641	def _reinject_claude_block(root: Path, slug: str, target: str = "CLAUDE.md") -> "ReInjectResult":
 10642	    """讀 vendored 範本 → {{KG}} 替換 → 組 sentinel block → 依三態更新 target(預設 CLAUDE.md;
 10643	    Codex 的 AGENTS.md / AGENTS.override.md 走同一段,d1)。
 10644	
 10645	    status ∈ created|updated|unchanged|appended|sentinel_broken|no_template。
 10646	    diff:僅 updated 帶 difflib.unified_diff 字串,其餘 None。
 10647	    讀入時正規化 CRLF→LF 並去 BOM;寫入一律 _write_lf(強制 LF / 無 BOM)。
 10648	    """
 10649	    import difflib
 10650	
 10651	    # 1. 範本 + body(共用 _expected_claude_body 確保 Check D 比對算法一致)
 10652	    body = _expected_claude_body(root, slug)
 10653	    if body is None:
 10654	        return ReInjectResult("no_template", None)
 10655	
 10656	    # 3. 組 block(START 行帶當前版本戳,機械插值——版本在 body 外,不影響 Check D 比對)
 10657	    start_line = _START_TEMPLATE.format(version=LUMOS_VERSION)
 10658	    block = start_line + "\n" + body + "\n" + _CLAUDE_END
 10659	
 10660	    # 4. 讀目標檔(去 BOM + CRLF 正規化;★整檔都會被正規化,不只區塊★)
 10661	    cm = root / target
 10662	    if cm.exists():
 10663	        raw = cm.read_bytes()
 10664	        # 去 UTF-8 BOM
 10665	        if raw.startswith(b"\xef\xbb\xbf"):
 10666	            raw = raw[3:]
 10667	        claude_text = raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
 10668	    else:
 10669	        claude_text = None
 10670	
 10671	    # 5. 三態分派
 10672	    if claude_text is None:
 10673	        # 目標不存在 → created(檔頭依目標名;r2 整合 F11:曾寫死 "# CLAUDE.md")
 10674	        _write_lf(cm, f"# {target}\n\n" + block + "\n")
 10675	        return ReInjectResult("created", None)
 10676	
 10677	    state, span = _extract_claude_block_span(claude_text)
 10678	
 10679	    if state == "broken":
 10680	        return ReInjectResult("sentinel_broken", None)
 10681	
 10682	    if state == "absent":
 10683	        # 有檔但無 sentinel → appended。CLAUDE.md 沿舊行為接檔尾;
 10684	        # AGENTS 檔插檔首(第一個 # 標題行之後;沒有標題行→檔案最前)——Codex 把整鏈 AGENTS 檔串起來
 10685	        # 只吃 32 KiB、超過靜默截斷,靠前一點少被砍(d1;r2 邊界 N5 定 fallback)。
 10686	        if target == "CLAUDE.md":
 10687	            new_text = claude_text.rstrip() + "\n\n" + block + "\n"
 10688	        else:
 10689	            lines = claude_text.split("\n")
 10690	            idx = next((i for i, l in enumerate(lines) if l.startswith("#")), None)
 10691	            if idx is None:
 10692	                new_text = block + "\n\n" + claude_text.lstrip("\n")
 10693	            else:
 10694	                new_text = "\n".join(lines[:idx + 1]) + "\n\n" + block + "\n\n" + "\n".join(lines[idx + 1:]).lstrip("\n")
 10695	            new_text = new_text.rstrip() + "\n"
 10696	        _write_lf(cm, new_text)
 10697	        return ReInjectResult("appended", None)
 10698	
 10699	    # state == "found": splice body + 同步刷新 START 行(版本戳落在存量戶的唯一路徑——
 10700	    # 只換 body 會讓 updated 路徑永遠拿不到版本戳,標籤機制對存量安裝戶形同虛設。
 10701	    # START 行在管理區塊「內」,★INVARIANT★ 只保護 sentinel 之外,刷新它不違約)。
 10702	    old_body = span.body
 10703	    new_body = body
 10704	    si = claude_text.find(_CLAUDE_START_PREFIX)
 10705	    sl_begin = claude_text.rfind("\n", 0, si) + 1
 10706	    sl_end = claude_text.find("\n", si)
 10707	    old_start_line = claude_text[sl_begin:sl_end] if sl_end != -1 else claude_text[sl_begin:]
 10708	
 10709	    if old_body == new_body and old_start_line == start_line:
 10710	        return ReInjectResult("unchanged", None)
 10711	
 10712	    # 有差 → 先換 body(高位移),再換 START 行(低位移,原始位移仍有效);兩 splice 之間
 10713	    # 的原始空白行區逐字保留。
 10714	    new_text = claude_text[:span.body_start] + new_body + claude_text[span.body_end:]
 10715	    if sl_end != -1 and old_start_line != start_line:
 10716	        new_text = new_text[:sl_begin] + start_line + new_text[sl_end:]
 10717	    _write_lf(cm, new_text)
 10718	
 10719	    diff = "".join(difflib.unified_diff(
 10720	        (old_start_line + "\n" + old_body).splitlines(keepends=True),
 10721	        (start_line + "\n" + new_body).splitlines(keepends=True),
 10722	        fromfile="old block",
 10723	        tofile="new block",
 10724	    ))
 10725	    return ReInjectResult("updated", diff)
 10726	
 10727	
 10728	def _deinit_strip_claude(root: Path) -> bool:
 10729	    """剝 CLAUDE.md 與 Codex 指示檔(AGENTS.md / AGENTS.override.md)的 LUMOS:GRAPH-DISCIPLINE 區塊;
 10730	    其餘內容/整個檔都留。目標清單與注入端同一份(r1 整合 F1)。任一檔有剝到 → True;都無 → False。"""
 10731	    hit = False
 10732	    for t in _reinject_targets(root):
 10733	        cm = root / t
 10734	        if not cm.exists():
 10735	            continue
 10736	        text = cm.read_text(encoding="utf-8")
 10737	        start_marker = "<!-- LUMOS:GRAPH-DISCIPLINE:START"
 10738	        end_marker = "LUMOS:GRAPH-DISCIPLINE:END -->"
 10739	        si = text.find(start_marker)
 10740	        ei = text.find(end_marker)
 10741	        if si == -1 or ei == -1 or ei < si:
 10742	            continue
 10743	        ei += len(end_marker)
 10744	        new = (text[:si].rstrip() + "\n" + text[ei:].lstrip()).strip()
 10745	        _write_lf(cm, (new + "\n") if new else "")
 10746	        hit = True
 10747	    return hit
 10748	
 10749	
 10750	def _deinit_remove_vendored(root: Path, src=None) -> list:
 10751	    """白名單移除 vendored 工具組:① _VENDORED_TOOLKIT 固定 5 檔;
 10752	    ② scripts/hooks/、scripts/templates/ ★依 src 列舉逐檔刪★(對稱 _vendor_toolchain 的 rglob 安裝)。
 10753	    F9 修(2026-07-24,Issues/deinit整夾刪使用者檔):不再整夾 rmtree——只刪 src 有的 lumos 檔、
 10754	    保留使用者放這兩夾的自有檔,夾空了才移。fallback(a):src 缺(None 或來源夾不存在)→ 保守留夾
 10755	    +warn、不刪(never delete unknown)。scripts/ 底下使用者自有檔不碰;scripts/ 空了才 rmdir。
 10756	    回傳已移除相對路徑列表。"""
 10757	    removed = []
 10758	    for rel in _VENDORED_TOOLKIT:
 10759	        p = root / rel
 10760	        if p.exists():
 10761	            # ★刪不掉不該炸穿整個流程★(2026-08-01):這裡以前是裸 unlink()。
 10762	            # 走 teardown 時,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,
 10763	            # 若在這裡拋 PermissionError(Windows 刪執行中的檔、防毒鎖檔),
 10764	            # ③uninstall 根本沒機會跑 → 使用者拿到拆一半又只看到 traceback 的
 10765	            # 狀態。改成印清楚哪一個檔沒刪掉、繼續往下走完;★不靜默★——沒刪掉
 10766	            # 的檔不會被記進 removed,呼叫端印出來的清單仍然誠實。
 10767	            # (Windows 自刪這條主要路徑另有 _selfdelete_risk 在 mutation 前擋。)
 10768	            try:
 10769	                p.unlink(); removed.append(rel)
 10770	            except OSError as e:
 10771	                print(f"  ⚠ 移除 {p} 失敗,跳過(其餘步驟照跑): {e}", file=sys.stderr)
 10772	    for d in ("scripts/hooks", "scripts/templates"):
 10773	        tgt = root / d
 10774	        if not tgt.is_dir():
 10775	            continue
 10776	        src_d = (src / d) if src is not None else None
 10777	        if src_d is None or not src_d.is_dir():   # fallback(a):列舉不出 → 保守留夾
 10778	            print(f"  ⚠ 無法從來源列舉 {d} 的 lumos 檔清單,保留整夾避免誤刪你的檔"
 10779	                  "(手動清理,或 deinit/teardown 加 --source 指向 Lumos 來源)", file=sys.stderr)
 10780	            continue
 10950	        return None
 10951	    if not no_pull:
 10952	        rc_p = _pull_source_or_abort(src, allow_stale)
 10953	        if rc_p is None:
 10954	            return None                      # fail-closed:一個檔都還沒動就退場
 10955	    # 安裝邏輯收進 python 單一源(scaffold + hooks);bash 安裝器僅留薄殼。
 10956	    _scaffold_project(root, slug)
 10957	    _install_hooks_py(root)
 10958	    rc = 0
 10959	    # 結尾 diff 自癒:python 端逐檔比對 src↔target,差異即補(可安全覆寫)。
 10960	    toolkit = list(_VENDORED_TOOLKIT)
 10961	    for sub in ("scripts/hooks", "scripts/templates"):
 10962	        base = src / sub
 10963	        if base.is_dir():
 10964	            toolkit += [str(p.relative_to(src)) for p in base.rglob("*") if p.is_file()]
 10965	    healed = []
 10966	    for rel in toolkit:
 10967	        s, t = src / rel, root / rel
 10968	        if not s.exists():
 10969	            continue
 10970	        if (not t.exists()) or not filecmp.cmp(s, t, shallow=False):
 10971	            t.parent.mkdir(parents=True, exist_ok=True)
 10972	            shutil.copy2(s, t)
 10973	            if s.stat().st_mode & 0o111:
 10974	                t.chmod(t.stat().st_mode | 0o111)
 10975	            healed.append(rel)
 10976	    if healed:
 10977	        print(f"  結尾自癒:補齊 installer 漏的 {len(healed)} 檔 → {', '.join(healed)}")
 10978	    else:
 10979	        print("  ✓ 結尾自癒檢查:工具組完全對齊(無漏)")
 10980	    # 範本已是最新(copy2 迴圈完成) → reinject 紀律區塊(CLAUDE.md + Codex 指示檔,d1)
 10981	    _reinject_all(root, slug)
 10982	    return rc
 10983	
