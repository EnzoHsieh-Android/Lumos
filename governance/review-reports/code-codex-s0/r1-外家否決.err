 24945	def t_codex_reinject_agents_targets():
 24946	    """紀律區塊多一個 Codex 指示檔目標:created 檔頭依目標名;既有檔插第一個標題後;沒標題插檔首;
 24947	    有 AGENTS.override.md 就寫它;_reinject_all 兩檔都刷;_deinit_strip_claude 兩檔都剝;Check D 目標清單化沿用同一函式。"""
 24948	    import tempfile as _tf
 24949	    TPL = "知識圖譜:{{KG}}"
 24950	    with _tf.TemporaryDirectory() as td:
 24951	        root, mod = _make_reinject_root(td, tpl_content=TPL, claude_content="# CLAUDE.md\n\n自有\n")
 24952	        check("codex-reinject: 預設目標=AGENTS.md", mod._reinject_targets(root) == ("CLAUDE.md", "AGENTS.md"), str(mod._reinject_targets(root)))
 24953	        r = mod._reinject_claude_block(root, "proj", target="AGENTS.md")
 24954	        txt = (root / "AGENTS.md").read_text(encoding="utf-8")
 24955	        check("codex-reinject: AGENTS.md created 且檔頭是 # AGENTS.md(不是 # CLAUDE.md)", r.status == "created" and txt.startswith("# AGENTS.md\n") and "# CLAUDE.md" not in txt, txt[:60])
 24956	        # 既有檔有標題 → 插在第一個標題行之後、原內容保留在後面
 24957	        (root / "AGENTS.md").write_text("# 專案指示\n\n第一條規矩\n\n## 第二節\n內容\n", encoding="utf-8")
 24958	        r = mod._reinject_claude_block(root, "proj", target="AGENTS.md")
 24959	        txt = (root / "AGENTS.md").read_text(encoding="utf-8")
 24960	        block = _make_block(mod, "proj", TPL)
 24961	        check("codex-reinject: 有標題 → appended 且區塊在第一個標題之後、第一條規矩之前", r.status == "appended" and txt.index("# 專案指示") < txt.index(block) < txt.index("第一條規矩") < txt.index("## 第二節"), txt[:200])
 24962	        # 沒有任何標題 → 插檔首
 24963	        (root / "AGENTS.md").write_text("純散文起頭,沒有標題。\n- 條列一\n", encoding="utf-8")
 24964	        r = mod._reinject_claude_block(root, "proj", target="AGENTS.md")
 24965	        txt = (root / "AGENTS.md").read_text(encoding="utf-8")
 24966	        check("codex-reinject: 無標題 → 區塊在檔案最前、原文在後", r.status == "appended" and txt.startswith(block) and "純散文起頭" in txt and "條列一" in txt, txt[:120])
 24967	        # 冪等
 24968	        r2 = mod._reinject_claude_block(root, "proj", target="AGENTS.md")
 24969	        check("codex-reinject: 再跑一次 unchanged", r2.status == "unchanged", r2.status)
 24970	        # override 存在 → 目標換成 override
 24971	        (root / "AGENTS.override.md").write_text("# override\n", encoding="utf-8")
 24972	        check("codex-reinject: 有 override → 目標=AGENTS.override.md", mod._agents_target(root) == "AGENTS.override.md", mod._agents_target(root))
 24973	        res = mod._reinject_all(root, "proj", quiet=True)
 24974	        check("codex-reinject: _reinject_all 兩檔都刷(CLAUDE.md appended、override appended)", res["CLAUDE.md"].status == "appended" and res["AGENTS.override.md"].status == "appended", str({k: v.status for k, v in res.items()}))
 24975	        # 剝除:兩檔都剝、原文留
 24976	        stripped = mod._deinit_strip_claude(root)
 24977	        c = (root / "CLAUDE.md").read_text(encoding="utf-8"); o = (root / "AGENTS.override.md").read_text(encoding="utf-8")
 24978	        check("codex-reinject: strip 兩檔都剝、自有內容留", stripped and "GRAPH-DISCIPLINE" not in c and "GRAPH-DISCIPLINE" not in o and "自有" in c and "# override" in o, c[:80] + o[:80])
