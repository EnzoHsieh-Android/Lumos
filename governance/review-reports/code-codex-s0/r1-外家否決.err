 10273	            # 只有 symlink 才是我方 install 產物。避免 uninstall/teardown 誤刪非我方檔。
 10274	            print(f"  ⚠ {g} 是一般檔(非 symlink),保留不動——非 lumos 安裝物", file=sys.stderr)
 10275	    sk = Path.home() / ".claude" / "skills"      # 對稱 _install_skills:junction/symlink/複製夾都清
 10276	    for s in _SKILLS:
 10277	        d = sk / s
 10278	        if d.is_symlink():
 10279	            d.unlink(); removed.append(str(d))
 10280	        elif d.is_dir():
 10281	            try:
 10282	                os.rmdir(d)                       # junction/空夾:只移連結本身,不跟進 target(同 W4)
 10283	            except OSError:
 10284	                shutil.rmtree(d, ignore_errors=True)
 10285	            removed.append(str(d))
 10286	    shared = Path.home() / ".agents" / "skills"   # Codex 側(開放共用目錄):只收 symlink 與帶標記的複製物
 10287	    for s in _SKILLS:
 10288	        d = shared / s
 10289	        if d.is_symlink():
 10290	            d.unlink(); removed.append(str(d))
 10291	        elif d.is_dir():
 10292	            if (d / _SKILL_MARKER).exists():
 10293	                shutil.rmtree(d, ignore_errors=True); removed.append(str(d))
 10294	            else:
 10295	                try:
 10296	                    os.rmdir(d); removed.append(str(d))     # 空夾/junction
 10297	                except OSError:
 10298	                    print(f"  ⚠ {d} 不是 lumos 裝的(無標記檔),保留不動", file=sys.stderr)
 10299	    if removed:
 10300	        print("✓ 移除:\n  " + "\n  ".join(removed))
 10301	    else:
 10302	        print("✓ 未安裝(無全域 lumos / skills)")
 10303	    return 0
