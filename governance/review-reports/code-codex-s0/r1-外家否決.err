 10398	def cmd_deinit(keep_graph=False, dry_run=False, yes=False, source=None):
 10399	    """專案層反安裝(對稱 cmd_init):拆本 repo 的 pre-commit 閘 / vendored 工具組 /
 10400	    CLAUDE.md 注入區塊 /(預設)圖譜 vault。不碰機器共用項(~/.claude)。不自動 commit。"""
 10401	    import subprocess
 10402	    # root 走 git toplevel;非 git 目錄中止(不 fallback cwd——deinit 會刪檔)
 10403	    try:
 10404	        root = Path(subprocess.check_output(
 10405	            ["git", "rev-parse", "--show-toplevel"], text=True,
 10406	            stderr=subprocess.DEVNULL).strip())
 10407	    except Exception:
 10408	        print("擋下:這裡不是 git 專案,移除需要確定的專案根目錄,不會拿目前目錄猜", file=sys.stderr)
 10409	        return 2
 10410	    # pre-flight 守衛①:來源 repo 自我保護(對齊 cmd_update 的 root==src → return 2)
 10411	    src = _lumos_src(source)
 10412	    if root.resolve() == src.resolve():
 10413	        print("擋下:你現在就在 Lumos 工具鏈的來源 repo 裡,不能在這裡移除它自己", file=sys.stderr)
 10414	        return 2
 10415	    # ★dry-run 例外(2026-08-02 代碼審 r2)★:純預覽、零 mutation,不會走到刪自己那一步,
 10416	    # 擋它只是誤傷合法的唯讀操作(而且使用者正想用它看看會動到什麼)。
 10417	    if not dry_run and _selfdelete_risk(root):   # Windows 自刪——mutation 之前擋
 10418	        print("擋下:Windows 上不能用專案自帶的那份 lumos 拆它自己"
 10419	              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
 10420	              "留下拆一半的狀態。", file=sys.stderr)
 10570	    # strip 首尾空白行(只去掉 \n,保留內部縮排)
 10571	    stripped = raw_body.strip("\n")
 10572	
 10573	    if stripped:
 10574	        # 在 raw_body 中找 stripped 的真實位移
 10575	        inner_start = raw_body.find(stripped)
 10576	        body_start = body_raw_start + inner_start
 10577	        body_end = body_start + len(stripped)
 10578	    else:
 10579	        # body 全是空白行:body 設為空字串,位移指向 body_raw_start
 10580	        body_start = body_raw_start
 10581	        body_end = body_raw_start
 10582	        stripped = ""
 10583	
 10584	    return ("found", BlockSpan(body=stripped, body_start=body_start, body_end=body_end))
 10585	
 10586	
 10587	# Task 2 ─────────────────────────────────────────────────────────────────────
 10588	# START 行(本 task 無版本戳;T5 會在此字串中插入版本號——形式保留易替換)
