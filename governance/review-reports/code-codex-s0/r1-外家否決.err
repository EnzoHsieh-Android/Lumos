 10306	def _selfdelete_risk(root: Path) -> bool:
 10307	    """Windows 專屬:正在跑的這份 lumos 就是 root 底下那份 vendored copy 嗎?
 10308	
 10309	    `_deinit_remove_vendored` 最後會刪 `scripts/lumos`——POSIX 上刪掉執行中的檔案
 10310	    無妨(所以刻意排最後),★但 Windows 不准刪執行中的檔案★,會拋 PermissionError,
 10311	    而那句 `p.unlink()` 沒有 try/except。後果不是「少刪一個檔」而是★半做★:走
 10312	    teardown 的話,①全域 hook 已清、②CLAUDE.md 已剝、閘已拆,才在這裡炸 traceback,
 10313	    ③uninstall 根本沒機會跑。使用者拿到一個拆一半又看不懂的狀態。
 10314	
 10315	    這條路很容易走到:Windows 裝完要重開 session 才吃得到 PATH,拿不到 `lumos`
 10316	    這個指令的人自然會打 `python scripts\\lumos teardown`。
 10317	
 10318	    ★只在 Windows 回 True★——POSIX 上這條路是合法且刻意支援的,不能一起擋掉。
 10319	    `LUMOS_SIMULATE_WINDOWS` 只是測試接縫(本機沒有 Windows 可驗)。
 10320	    """
 10321	    if not (_IS_WIN or os.environ.get("LUMOS_SIMULATE_WINDOWS") == "1"):
 10322	        return False
 10323	    try:
 10324	        me, r = Path(__file__).resolve().parts, root.resolve().parts
 10325	    except OSError:
 10326	        return False       # 路徑解不開(權限/壞連結)就不擋(never block on unknown)
 10327	    # ★不用 `Path.is_relative_to()`★——那是 Python 3.9+,本專案宣告 ≥3.8
 10328	    # (同檔 `_write_lf` 為了同一個理由避開 3.10 才有的 write_text(newline=))。
 10329	    # ★也不要把 except 放寬成 `except Exception`★:這道守衛的失敗模式是「回 False」,
 10330	    # 一旦把自己的程式錯誤(如 AttributeError)也吞掉,守衛就★靜默地等於不存在★
 10331	    # ——2026-08-02 代碼審 r2 抓到的正是這個組合。
 10332	    return len(me) > len(r) and me[:len(r)] == r
 10333	
 10334	
 10335	def cmd_teardown(yes=False, source=None):
 10336	    """一鍵拆機:當前 repo 專案層 + 機器全域(CLI/skills/hooks),★永遠保留圖譜文件★。
 10337	    範圍(std F11)=當前 repo + 機器全域,非全機所有 repo(別 repo 的注入/hooks、來源 clone 都留)。
 10338	    三步順序(std F5,全域先——趁 deinit 還沒刪掉 vendored merge):
 10339	      ①_teardown_global_claude ②cmd_deinit(keep_graph=True) ③cmd_uninstall。
 10340	    設計/審計:Projects/teardown一鍵拆機_計劃。"""
 10341	    import subprocess
 10342	    try:                                       # repo root(對稱 deinit,非 git 中止)
 10343	        root = Path(subprocess.check_output(
 10344	            ["git", "rev-parse", "--show-toplevel"], text=True,
 10345	            stderr=subprocess.DEVNULL).strip())
 10346	    except Exception:
 10347	        print("擋下:這裡不是 git 專案,拆除需要確定的專案根目錄,不會拿目前目錄猜", file=sys.stderr)
 10348	        return 2
 10349	    src = _lumos_src(source)
 10350	    if root.resolve() == src.resolve():
 10351	        print("擋下:你現在就在 Lumos 工具鏈的來源 repo 裡,不能在這裡拆它自己", file=sys.stderr)
 10352	        return 2
 10353	    if _selfdelete_risk(root):   # Windows 自刪(見 _selfdelete_risk)——在任何 mutation 之前擋
 10354	        print("擋下:Windows 上不能用專案自帶的那份 lumos 拆它自己"
 10355	              f"({Path(__file__).resolve()})——最後刪 vendored 時會刪到執行中的檔案,"
 10356	              "留下拆一半的狀態。", file=sys.stderr)
 10357	        print("  改用全域指令重跑:  lumos teardown", file=sys.stderr)
 10358	        print("  (若 PATH 還沒吃到,先重開一個終端;或直接用來源那份:"
 10359	              f"  python {src / 'scripts' / 'lumos'} teardown)", file=sys.stderr)
 10360	        return 2
 10361	    # 確認——★拒絕/取消前零 mutation★(std F13)
 10362	    if not yes:
 10363	        if not sys.stdin.isatty():
 10364	            print("擋下:這不是互動式終端、沒辦法問你確認,又沒加 --yes,不拆。確定要拆就加 --yes", file=sys.stderr)
 10365	            return 2
 10366	        print("teardown 將拆【當前 repo 專案層】(pre-commit/pre-push 閘、CLAUDE.md 注入、vendored 工具)")
 10367	        print("  +【機器全域】(~/.local/bin/lumos、user-scope skills、~/.claude 全域 hooks)。")
 10368	        print("  圖譜文件保留;scripts/hooks|templates 只刪 lumos 檔、你的自有檔保留(F9)。")
 10369	        print("  ⚠ 仍在的破壞性:剝 CLAUDE.md 注入會正規化 sentinel 外空白/換行;移除全部 lumos 家族")
 10370	        print("     skills(含 csharp/kotlin/vue-idioms,你名字不同的 skill 不碰)。")
 10371	        print("  (只拆當前 repo——別的 repo 與 bootstrap 來源 clone 不動。)")
 10372	        try:
 10373	            ans = input("確定? [y/N] ").strip().lower()
 10374	        except EOFError:
 10375	            # isatty() 在某些終端/Windows 回 True 但 stdin 其實 EOF → 讀不到確認。
 10376	            # 對齊 cmd_deinit 與 _confirm_tty 的既有硬化(同一現場,Windows 真機踩過):
 10377	            # 破壞性操作安全預設=拒絕(rc2,同上面非互動分支),不是往下做。
 10378	            # ★不要拿 --yes 當解法★——那等於跳過確認直接執行破壞性操作。
 10379	            print("擋下:等不到你的確認輸入,不拆。"
 10380	                  "確定要拆再加 --yes", file=sys.stderr)
 10381	            return 2
 10382	        if ans not in ("y", "yes"):
 10383	            print("已取消(未改動)。")
 10384	            return 0
 10385	    # 三步(全域先)
 10386	    print("① 全域 hook 清理…")
 10387	    _teardown_global_hooks(Path(__file__).resolve().parent.parent, "claude")
 10388	    _teardown_global_hooks(Path(__file__).resolve().parent.parent, "codex")
 10389	    print("② 拆專案層(deinit,保留圖譜)…")
 10390	    rc_deinit = cmd_deinit(keep_graph=True, yes=True, source=source)
 10391	    print("③ 拆機器 CLI/skills(uninstall)…")
 10392	    rc_uninstall = cmd_uninstall()
 10393	    print(f"✓ teardown 完成(deinit rc={rc_deinit} / uninstall rc={rc_uninstall};圖譜保留)。"
 10394	          "  重裝:bootstrap 或 install + init。")
 10395	    return 0
 10396	
