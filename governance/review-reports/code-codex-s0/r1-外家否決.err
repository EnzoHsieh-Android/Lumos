 11157	def _codex_present(home=None) -> bool:
 11158	    """本機有沒有 Codex 可裝:~/.codex 目錄在、或 codex 可執行檔在 PATH(測試用隔離 HOME 建 ~/.codex 即視為在)。"""
 11159	    import shutil
 11160	    home = Path(home) if home else Path.home()
 11161	    return (home / ".codex").is_dir() or bool(shutil.which("codex"))
