 11023	def _link_or_copy(src: Path, dst: Path):
 11024	    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
 11025	    import os, shutil, subprocess
 11026	    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
 11027	    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
 11028	    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
 11029	    if dst.is_symlink():
 11030	        dst.unlink()                                  # Unix symlink
 11031	    elif dst.is_dir():
 11032	        try:
 11033	            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
 11034	        except OSError:
 11035	            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
 11036	    elif dst.exists():
 11037	        dst.unlink()
 11038	    dst.parent.mkdir(parents=True, exist_ok=True)
 11039	    try:
 11040	        if _IS_WIN:
 11041	            # W2:mklink 輸出走 OEM 碼頁(繁中=cp950),text=True 預設 UTF-8 解碼會在
 11042	            # reader thread 炸 UnicodeDecodeError。errors="replace" 防炸,returncode 仍可靠。
 11043	            r = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)],
 11044	                               capture_output=True, text=True, encoding="utf-8", errors="replace")
 11045	            if r.returncode != 0:
 11046	                raise OSError(r.stderr)
 11047	        else:
 11048	            dst.symlink_to(src)
 11049	    except OSError:
 11050	        shutil.copytree(src, dst, dirs_exist_ok=True)  # Python ≥ 3.8
 11051	        try:
 11052	            (dst / _SKILL_MARKER).write_text("lumos fallback copy;安裝器可整夾重建\n", encoding="utf-8")
 11053	        except OSError:
 11054	            pass
 11055	        print(f"  ⚠ 連結失敗,改複製(失去 git pull 即更新): {dst}")
 11056	
 11057	
 11058	def _install_skills():
 11059	    # ★r1 正確性席:防線下移到真正動全域機器狀態的地方★——原本只擋四個指令入口,
 11060	    # 但 cmd_init → _vendor_toolchain → _install_hooks_py 這條路也會重連 ~/.claude/skills、繞過入口守衛。
 11061	    # 擋在這個變動原語,不論從哪個指令進來都擋得住。
 11062	    if _refuse_if_probe("install-skills"):
 11063	        return
 11064	    repo = Path(__file__).resolve().parent.parent
 11065	    dest = Path.home() / ".claude" / "skills"
 11066	    for s in _SKILLS:
 11067	        src = repo / "skills" / s
 11068	        if src.is_dir():
 11069	            _link_or_copy(src, dest / s)
 11070	            print(f"  ✓ skill {s}")
 11071	    # Codex 也讀同一個開放標準(agentskills.io):使用者層 ~/.agents/skills/(2026-09-04 隔離 HOME 實測會載入)。
 11072	    # ★開放共用目錄★:既有真目錄只有帶我方標記檔才重建,否則跳過+warn(別人的 skill 不能刪)。
 11073	    shared = Path.home() / ".agents" / "skills"
 11074	    for s in _SKILLS:
 11075	        src = repo / "skills" / s
 11076	        if src.is_dir():
 11077	            if _link_or_copy_shared(src, shared / s):
 11078	                print(f"  ✓ skill(codex) {s}")
 11079	
 11080	
 11081	def _link_or_copy_shared(src: Path, dst: Path) -> bool:
 11082	    """開放共用目錄版 _link_or_copy:dst 是「非我方」真目錄(不是 symlink/junction、沒有標記檔)→
 11083	    跳過+印一行,回 False;其餘交給 _link_or_copy(它會把 symlink/空夾/帶標記的複製物重建)。"""
 11084	    import os
 11085	    if dst.is_dir() and not dst.is_symlink():
 11086	        try:
 11087	            empty = not any(os.scandir(dst))
 11088	        except OSError:
 11089	            empty = False
 11090	        if not empty and not (dst / _SKILL_MARKER).exists():
 11091	            print(f"  ⚠ 跳過 {dst}:已有不是 lumos 裝的同名目錄,不覆蓋(要換成 lumos 版請先自己搬走它)", file=sys.stderr)
 11092	            return False
 11093	    _link_or_copy(src, dst)
 11094	    return True
