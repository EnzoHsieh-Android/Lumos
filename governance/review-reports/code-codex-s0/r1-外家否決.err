 12430	def enforcement_summary(rows):
 12431	    """回 (active 數, 非 unknown 總數, unknown 數)。分母排除 unknown;
 12432	    ★也排除 registered-trust-unknown★(Codex hook 已註冊但要人審過才跑、本機讀不到——既不算生效也不算壞,
 12433	    算進分母會讓摘要永遠紅;它在列表裡用 🔒 單獨可見)。"""
 12434	    unknown = sum(1 for r in rows if r["status"] in ("unknown", "registered-trust-unknown"))
 12435	    total = len(rows) - unknown
 12436	    active = sum(1 for r in rows if r["status"] == "active")
 12437	    return active, total, unknown
 12438	
 12439	
 12440	def cmd_enforcement(repo=None, as_json=False):
 12441	    """印各層防護現在有沒有生效。純唯讀。rc0 恆(唯讀查詢不判成敗;要判用各層自己的閘)。"""
 12442	    import json as _json
 12443	    if repo is not None and not Path(repo).is_dir():   # r1 審:typo'd --repo 別靜默印全 inactive
 12444	        print(f"擋下:--repo 指的不是目錄: {repo}", file=sys.stderr)
 12445	        return 2
 12446	    rows = enforcement_status(root=repo)
 12447	    if as_json:
 12448	        active, total, unknown = enforcement_summary(rows)
 12449	        print(_json.dumps({"rows": rows, "active": active, "total": total, "unknown": unknown}, ensure_ascii=False))
 12450	        return 0
 12451	    mark = {"active": "✅", "inactive": "❌", "degraded": "⚠️", "unknown": "❔", "registered-trust-unknown": "🔒"}
 12452	    print("Lumos 防護生效狀態(這查的是「有沒有裝上/接上」,不是「判得對不對」)\n")
 12453	    for r in rows:
 12454	        print(f"  {mark.get(r['status'], '?')} {r['layer']:26s} {r['status']:24s} {r['detail']}")
 12455	    active, total, unknown = enforcement_summary(rows)
 12456	    trust = sum(1 for r in rows if r["status"] == "registered-trust-unknown")
