 11119	_GLOBAL_CLAUDE_HOOKS = ("check-graph-sync.py", "impact-hook.py", "ci-status-hook.py", "lumos-entry-hook.py", "dispatch-lens-hook.py")
 11120	_GLOBAL_HOOKS = _GLOBAL_CLAUDE_HOOKS   # 兩家共用同一批檔(Claude→~/.claude/hooks、Codex→~/.codex/hooks;Projects/Codex完全支援_計劃 d2);舊名留給既有呼叫/測試
 11121	_SKILL_MARKER = ".lumos-managed"       # fallback 複製出的 skill 目錄帶此標記檔;開放共用目錄只重建帶標記的(r2 邊界 N1)
 11122	_HARNESS_HOME = {"claude": (".claude", "settings.json"), "codex": (".codex", "hooks.json")}
 11123	# ★撤除 hook 要分兩階段,不能一刀刪檔★(2026-08-22 立;症狀真實發生過)
 11124	#
 11125	# 症狀:`lumos install` 把已撤除 hook 的真檔刪掉,但★正在跑的 session★在啟動當下讀進的
 11126	# settings 快照裡還註冊著那支——檔案不在了,那些 session 每次觸發都報錯。2026-08-22 有人
 11127	# 為此手寫空殼補回去兩次(每跑一次 install 就被刪一次)。
 11128	#
 11129	# 兩階段:
 11130	#   階段一 STUB   —— 這一版換成 exit 0 空殼。舊 session 照樣觸發、什麼都不做、不報錯;
 11131	#                     新 session 讀到的 settings 已剪乾淨,根本不會叫它。
 11132	#   階段二 DELETE —— 確認沒有 session 還帶著舊註冊(隔一版/隔一天)才真刪檔。
