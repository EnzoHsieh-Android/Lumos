   128	
   129	def _codex_entries(entries: dict) -> dict:
   130	    """Claude 註冊表 → Codex 註冊表(Projects/Codex完全支援_計劃 S0-2 對照表,2026-09-04 實測 0.144.1):
   131	    · SessionStart / Stop:同名同形。
   132	    · PreToolUse `Edit|Write|MultiEdit` → matcher `apply_patch`(Codex 改檔工具;Edit/Write 只是它的別名,
   133	      tool_name 仍回 apply_patch;tool_input 是 patch 全文沒有 file_path——S1 適配 impact-hook)。
   134	    · PreToolUse `Agent`(派工鏡頭)→ 改掛 `SubagentStart`(無 matcher):spawn_agent 的 message 對 hook
   135	      是密文改不了(實驗 A),子代理開場的 additionalContext 才到得了子代理(實驗 5)。
   136	    其餘事件原樣。"""
   137	    out = {}
   138	    for event, arr in entries.items():
   139	        for e in arr:
   140	            ne = dict(e)
   141	            ev = event
   142	            if event == "PreToolUse" and e.get("matcher") == "Edit|Write|MultiEdit":
   143	                ne["matcher"] = "apply_patch"
   144	            elif event == "PreToolUse" and e.get("matcher") == "Agent":
   145	                ev = "SubagentStart"
   146	                ne.pop("matcher", None)
   147	            out.setdefault(ev, []).append(ne)
   148	    return out
   149	
   150	
   151	if TARGET == "codex":
   152	    HOOK_ENTRIES = _codex_entries(HOOK_ENTRIES)
   153	
   154	
   155	def _prune_dangling(settings: dict) -> list:
   156	    """剪掉指向 ~/.claude/hooks/ 下「不存在檔案」的 hook 註冊(懸空只會每回合報錯)。
   157	    起因 2026-07-07 現場事故:code-loop-guard.py 被工具鏈更新刪除、settings 註冊沒清 →
   158	    每回合「檔案不存在」。只動 command 含 `.claude/hooks/` 的項;使用者自訂
   159	    (指向他處)的 command 一律不碰。回傳被剪的 (event, script) 列表。"""
   160	    pruned = []
   161	    for event, entries in list(settings.get("hooks", {}).items()):
   162	        kept_entries = []
   163	        for entry in entries:
   164	            kept_hooks = []
   165	            for h in entry.get("hooks", []):
   166	                cmd = h.get("command", "")
   167	                if _HOOKS_SUBDIR in cmd.replace("\\", "/"):
   168	                    script = _hook_script(cmd)
   169	                    if script.endswith(".py") and not (HOOKS_DIR / script).exists():
   170	                        pruned.append((event, script))
   171	                        continue
   172	                kept_hooks.append(h)
   173	            if kept_hooks or not entry.get("hooks"):
   174	                entry = dict(entry)
   175	                if "hooks" in entry:
   176	                    entry["hooks"] = kept_hooks
   177	                kept_entries.append(entry)
   178	            # else:整組 hooks 都懸空 → entry 一併剪
   179	        settings["hooks"][event] = kept_entries
   180	    return pruned
   181	
   182	
   183	def _hook_script(cmd: str):
   184	    m = re.search(r"([\w.-]+\.py)", cmd or "")
   185	    return m.group(1) if m else cmd
   186	
   187	
   188	def _equivalent(a: dict, b: dict) -> bool:
   189	    """同一個 hook entry 認定為已存在 (避免重複註冊)。
   190	    比對:matcher (PostToolUse 需要) + 內層 hook 腳本檔名
   191	    (認出舊裸路徑 == 新 `python …/xxx.py` 為同一 hook)。"""
   192	    if a.get("matcher") != b.get("matcher"):
   193	        return False
   194	    a_s = sorted(_hook_script(h.get("command", "")) for h in a.get("hooks", []))
   195	    b_s = sorted(_hook_script(h.get("command", "")) for h in b.get("hooks", []))
   196	    return a_s == b_s
   197	
   198	
   199	def main() -> int:
   200	    if SETTINGS.exists():
   201	        try:
   202	            settings = json.loads(SETTINGS.read_text(encoding="utf-8"))
   203	        except json.JSONDecodeError as e:
   204	            print(f"ERROR: {SETTINGS} JSON 損毀: {e}(hooks 設定檔壞掉,本次不動它;修好 JSON 再跑一次 lumos install)", file=sys.stderr)
   205	            return 1
   206	    else:
   207	        settings = {}
   208	
   209	    settings.setdefault("hooks", {})
   210	    changed = False
   211	
   212	    # 先清懸空(腳本已被刪、註冊還在 → 每回合報錯),再 merge
   213	    for event, script in _prune_dangling(settings):
   214	        print(f"  [prune] {event} hook → {script}(檔案不存在,懸空註冊已清)")
   215	        changed = True
   216	
   217	    # --prune-only:只剪懸空、★不 re-add★(teardown 用——刪掉我方 hook .py 後跑此模式,
   218	    # 剪掉變懸空的我方註冊而不把它加回去;預設 merge 模式會 re-add,反而抵銷 teardown)。
   219	    prune_only = "--prune-only" in sys.argv
   220	
   221	    for event, entries_to_add in ({} if prune_only else HOOK_ENTRIES).items():
   222	        existing = settings["hooks"].setdefault(event, [])
   223	        for new_entry in entries_to_add:
   224	            match_idx = next((i for i, e in enumerate(existing) if _equivalent(new_entry, e)), None)
   225	            if match_idx is not None:
   226	                if existing[match_idx] != new_entry:
   227	                    existing[match_idx] = new_entry  # 遷移:取代成 resolved-python 格式
   228	                    print(f"  [migrate] {event} hook → resolved-python")
   229	                    changed = True
   230	                else:
   231	                    print(f"  [skip] {event} hook already current")
   232	                continue
   233	            existing.append(new_entry)
   234	            print(f"  [add ] {event} hook")
   235	            changed = True
   236	
   237	    # ★自癒去重(2026-08-21 體檢 #1)★:舊版安裝器在 _equivalent 上線前已把同一 hook 註冊兩次
   238	    # (verification-rot-check / check-graph-sync 各兩份,每次事件跑兩遍、Sonnet 呼叫翻倍)。
   239	    # 合併後再掃一次,等價項只留第一份;與 --prune-only 一樣是修復動作,每次執行都跑。
   240	    for event, entries in settings["hooks"].items():
   241	        kept = []
   242	        for e in entries:
   243	            if any(_equivalent(e, k) for k in kept):
   244	                print(f"  [dedupe] {event} hook 重複註冊,移除一份")
   245	                changed = True
   246	                continue
   247	            kept.append(e)
   248	        settings["hooks"][event] = kept
   249	
   250	    if not changed:
   251	        print(f"{SETTINGS.name} 已經是最新狀態,無需修改")
   252	        return 0
   253	
   254	    # Backup before write
   255	    if SETTINGS.exists():
   256	        backup = SETTINGS.with_suffix(".json.bak")
   257	        backup.write_text(SETTINGS.read_text(encoding="utf-8"), encoding="utf-8")
   258	        print(f"  備份到: {backup}")
   259	
   260	    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
   261	    SETTINGS.write_text(
   262	        json.dumps(settings, indent=2, ensure_ascii=False) + "\n",
   263	        encoding="utf-8",
   264	    )
   265	    print(f"已更新: {SETTINGS}")
   266	    return 0
   267	
   268	
   269	if __name__ == "__main__":
   270	    sys.exit(main())

