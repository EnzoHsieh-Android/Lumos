 10608	def _reinject_targets(root: Path):
 10609	    """紀律區塊的目標清單:CLAUDE.md(Claude Code)+ Codex 的指示檔;注入/剝除/Check D 三端共用(r1 整合 F1/F2)。"""
 10610	    return ("CLAUDE.md", _agents_target(root))
