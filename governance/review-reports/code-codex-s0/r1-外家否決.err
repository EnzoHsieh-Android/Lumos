 24890	    check("codex-sync: hooks.json 壞 → merge-failed(不是 ok)", r.stdout.strip().endswith("merge-failed"), r.stdout[-200:])
 24891	    check("codex-sync: merge-failed 訊息講設定檔損毀、不提探針", "損毀" in m_msg(home, "merge-failed") and "PROBE" not in m_msg(home, "merge-failed"), m_msg(home, "merge-failed"))
