 11023	def _link_or_copy(src: Path, dst: Path):
 11024	    """src→dst:Unix symlink、Win 目錄 junction、失敗 fallback 複製。src 須為目錄。"""
 11025	    import os, shutil, subprocess
 11026	    # W4:Windows junction 不被 is_symlink() 認出。舊碼 rmtree(dst) 會「跟進」junction 刪掉
 11027	    # 來源 target;且重跑時 junction 殘留 → mklink 報已存在 → 不冪等。改:junction/空夾用
 11028	    # os.rmdir(只移連結本身、不碰 target),真實非空夾才 rmtree。
 11029	    if dst.is_symlink():
 11030	        dst.unlink()                                  # Unix symlink
 11031	    elif dst.is_dir():
 11032	        try:
 11033	            os.rmdir(dst)                             # junction 或空夾:只移連結/夾,不跟進 target
 11034	        except OSError:
 11035	            shutil.rmtree(dst, ignore_errors=True)    # 真實非空夾(上次 fallback 複製過)
 11036	    elif dst.exists():
 11037	        dst.unlink()
 11038	    dst.parent.mkdir(parents=True, exist_ok=True)
 11039	    try:
 11040	        if _IS_WIN:
