    11	import sys
    12	from pathlib import Path
    13	
    14	# ── 兩家目標(Projects/Codex完全支援_計劃 d2,2026-09-04)──
    15	# Claude Code:~/.claude/settings.json 的 hooks 段;Codex CLI:~/.codex/hooks.json 頂層 hooks 段。
    16	# 兩者外層 JSON 同形(事件→[{matcher?,hooks:[{type,command,timeout}]}]),內層語意不同:
    17	# matcher 名、payload 形狀、輸出欄位各自查(r1 外家 F2)。★不碰 ~/.codex/config.toml★(stdlib 無 TOML 寫入器)。
    18	TARGET = "codex" if "--target=codex" in sys.argv or ("--target" in sys.argv and
    19	         sys.argv[sys.argv.index("--target") + 1:][:1] == ["codex"]) else "claude"
    20	if TARGET == "codex":
    21	    SETTINGS = Path.home() / ".codex" / "hooks.json"
    22	    HOOKS_DIR = Path.home() / ".codex" / "hooks"
    23	    _HOOKS_SUBDIR = ".codex/hooks/"
    24	else:
    25	    SETTINGS = Path.home() / ".claude" / "settings.json"
    26	    HOOKS_DIR = Path.home() / ".claude" / "hooks"
    27	    _HOOKS_SUBDIR = ".claude/hooks/"
    28	
    29	_PY = shutil.which("python3") or shutil.which("python") or "python3"
    30	# W3:${HOME} 只有 POSIX shell 展開;native Windows(Claude Code 經 cmd/PowerShell 跑 hook)
    31	# 不展開 → hook 路徑變字面 ${HOME} → L1/L3 靜默不觸發。Windows 用解析後的絕對 home。
    32	_HOME = str(Path.home()).replace("\\", "/")
    33	
    34	
    35	def _hook_cmd(rel_path):  # rel_path = "verification-rot-check.py"
    36	    # W6:Claude Code 在 Windows 用 Git Bash 跑 hook command → 反斜線會被 shell 吃掉
    37	    # (C:\Users → C:Users → python 找不到 → hook 靜默失敗)。故 Windows 下 python 路徑與
    38	    # home 都用正斜線 + 引號。Unix 保留 ${HOME}(可攜、Mac 已驗)。
    39	    # Codex 目標:命令列帶明確 --harness codex(d2:hook 靠旗標分支,不由 payload 欄位猜家族;
    40	    # 現役五支 hook 都不讀 argv,多帶旗標無害,S1 再各自認旗標)。
    41	    suffix = " --harness codex" if TARGET == "codex" else ""
    42	    if sys.platform == "win32":
    43	        py = _PY.replace("\\", "/")
    44	        return f'"{py}" "{_HOME}/{_HOOKS_SUBDIR}{rel_path}"{suffix}'
    45	    return f'{_PY} "${{HOME}}/{_HOOKS_SUBDIR}{rel_path}"{suffix}'
    46	
    47	
    48	HOOK_ENTRIES = {
    49	    "SessionStart": [
    50	        {
    51	            # 開場一行:第一步敲 lumos + 指令索引在哪(Projects/指令索引與情境測試_計劃 2026-08-22)。
    52	            # 沒有 docs/*-knowledge 的專案靜默。
