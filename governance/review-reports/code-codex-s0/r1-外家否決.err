 10603	def _agents_target(root: Path) -> str:
 10604	    """Codex 讀的指示檔名:該層有 AGENTS.override.md 就只讀它(官方規則),否則 AGENTS.md(d1)。"""
 10605	    return "AGENTS.override.md" if (root / "AGENTS.override.md").exists() else "AGENTS.md"
