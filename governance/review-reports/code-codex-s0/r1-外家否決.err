 10985	def cmd_update(source=None, no_pull=False, allow_stale=False):
 10986	    """從 Lumos 唯一源 repo 更新「本專案」vendored 的工具組。
 10987	    = (git pull Lumos) + install-graph-toolchain --target <本專案> --slug <自動偵測>。
 10988	    圖譜資料受 install-graph-toolchain 的 scaffold-skip 保護,不會被動。"""
 10989	    if _refuse_if_probe("update"):
 10990	        return 2
 10991	    src = _lumos_src(source)
 10992	    vault = find_vault(Path.cwd())
 10993	    if vault is None:
 10994	        print("擋下:目前目錄底下找不到知識圖譜(docs/*-knowledge)", file=sys.stderr)
 10995	        return 2
 10996	    root = vault.parent.parent  # docs/<slug>-knowledge → docs → 專案 root
 10997	    slug = vault.name[:-len("-knowledge")] if vault.name.endswith("-knowledge") else vault.name
 10998	    if root.resolve() == src.resolve():
 10999	        # 來源 repo 自身:範本本地即最新,無 pull/vendor 之需——reinject-only
 11000	        # (2026-08-05 實戰缺口修:改完範本後來源 repo 自己的 CLAUDE.md 原本無路可刷)
 11001	        res = _reinject_all(root, slug, quiet=True)
 11002	        ri = res["CLAUDE.md"]
 11003	        print(f"lumos update — 來源 repo 自身:只刷新紀律區塊({', '.join(f'{k}:{v.status}' for k, v in res.items())})")
 11004	        return 0 if all(v.status in ("updated", "unchanged", "created", "appended") for v in res.values()) else 2
 11005	    print(f"lumos update — 來源 {src} → 本專案 {root}（slug={slug}）")
 11006	    rc = _vendor_toolchain(src, root, slug, no_pull=no_pull, allow_stale=allow_stale)
 11007	    return 2 if rc is None else rc
