 11265	def _install_hooks_py(root: Path):
 11266	    import subprocess
 11267	    # ① git config core.hooksPath(專案本地)
 11268	    subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", "scripts/hooks"])
 11269	    # ②③ 全域 hooks/settings 同步(委派共用函式,消雙寫;來源=專案 vendored copy)
 11270	    print("  ✓ hooks:core.hooksPath 已設")
 11271	    for _h in ("claude", "codex"):
 11272	        print(_sync_msg(_h, _sync_global_hooks(root, _h)))
