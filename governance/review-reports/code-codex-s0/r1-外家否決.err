 24833	# ── Codex完全支援 S0(2026-09-04,Projects/Codex完全支援_計劃 d1–d2)──────────────────────────
 24834	def _codex_run(home, code):
 24835	    """假 HOME 隔離載入 lumos 模組跑一段碼(印結果到 stdout)。"""
 24836	    import os, subprocess as _sp
 24837	    repo = Path(GRAPHCTL).resolve().parent.parent
 24838	    pre = ("import sys,json;from pathlib import Path;"
 24839	           "import importlib.util;from importlib.machinery import SourceFileLoader;"
 24840	           "spec=importlib.util.spec_from_file_location('m',sys.argv[1],loader=SourceFileLoader('m',sys.argv[1]));"
 24841	           "m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);repo=Path(sys.argv[2]);")
 24842	    return _sp.run([sys.executable, "-c", pre + code, GRAPHCTL, str(repo)],
 24843	                   env=dict(os.environ, HOME=str(home), USERPROFILE=str(home)),
 24844	                   capture_output=True, text=True)
 24845	
 24846	
 24847	def t_codex_merge_target():
 24848	    """合併器 --target codex:寫 ~/.codex/hooks.json、五支註冊、matcher 對照(apply_patch / SubagentStart)、
 24849	    命令列帶 --harness codex;--prune-only 只剪懸空;壞 JSON 回 1 不動檔。"""
 24850	    import json as _j, os, subprocess as _sp
 24851	    repo = Path(GRAPHCTL).resolve().parent.parent
 24852	    merge = repo / "scripts" / "merge-claude-settings.py"
 24853	    home = Path(tempfile.mkdtemp(prefix="gctl-cdx-merge-"))
 24854	    env = dict(os.environ, HOME=str(home), USERPROFILE=str(home))
 24855	    r = _sp.run([sys.executable, str(merge), "--target", "codex"], env=env, capture_output=True, text=True)
 24856	    hj = home / ".codex" / "hooks.json"
 24857	    check("codex-merge: 寫 ~/.codex/hooks.json", r.returncode == 0 and hj.exists(), r.stderr[-200:])
 24858	    d = _j.loads(hj.read_text(encoding="utf-8"))
 24859	    cmds = [h["command"] for arr in d["hooks"].values() for e in arr for h in e["hooks"]]
 24860	    check("codex-merge: 五支都註冊", sorted(_ for _ in ("lumos-entry-hook.py", "ci-status-hook.py", "impact-hook.py", "dispatch-lens-hook.py", "check-graph-sync.py") if any(_ in c for c in cmds)) == sorted(["lumos-entry-hook.py", "ci-status-hook.py", "impact-hook.py", "dispatch-lens-hook.py", "check-graph-sync.py"]), str(cmds))
 24861	    check("codex-merge: 命令列全帶 --harness codex 且指 ~/.codex/hooks/", all(c.endswith("--harness codex") and ".codex/hooks/" in c for c in cmds), str(cmds))
 24862	    pre = d["hooks"].get("PreToolUse", [])
 24863	    check("codex-merge: 影響幅度 hook matcher=apply_patch", any(e.get("matcher") == "apply_patch" for e in pre), str(pre))
 24864	    check("codex-merge: 沒有 Agent matcher(派工鏡頭改掛 SubagentStart)", not any(e.get("matcher") == "Agent" for e in pre) and any("dispatch-lens-hook.py" in h["command"] for e in d["hooks"].get("SubagentStart", []) for h in e["hooks"]), str(d["hooks"].keys()))
 24865	    check("codex-merge: 不碰 ~/.claude", not (home / ".claude").exists(), "")
 24866	    # prune-only:檔不在 → 剪;使用者自己的 hook 留
 24867	    d["hooks"]["Stop"].append({"hooks": [{"type": "command", "command": "python3 /home/me/mine.py"}]})
 24868	    hj.write_text(_j.dumps(d), encoding="utf-8")
 24869	    _sp.run([sys.executable, str(merge), "--target", "codex", "--prune-only"], env=env, capture_output=True, text=True)
 24870	    d2 = _j.loads(hj.read_text(encoding="utf-8")); dump = _j.dumps(d2)
 24871	    check("codex-merge: prune-only 剪懸空我方註冊(hook 檔沒 copy 進來)", "check-graph-sync.py" not in dump, dump[:200])
 24872	    check("codex-merge: prune-only 留使用者 hook", "mine.py" in dump, dump[:200])
 24873	    # 壞 JSON → rc 1、檔不動
 24874	    hj.write_text("{ broken", encoding="utf-8")
 24875	    r = _sp.run([sys.executable, str(merge), "--target", "codex"], env=env, capture_output=True, text=True)
 24876	    check("codex-merge: 壞 JSON 回 1 且不動檔", r.returncode == 1 and hj.read_text(encoding="utf-8") == "{ broken", f"rc={r.returncode}")
 24877	
