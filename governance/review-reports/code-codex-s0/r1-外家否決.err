 11081	def _link_or_copy_shared(src: Path, dst: Path) -> bool:
 11082	    """開放共用目錄版 _link_or_copy:dst 是「非我方」真目錄(不是 symlink/junction、沒有標記檔)→
 11083	    跳過+印一行,回 False;其餘交給 _link_or_copy(它會把 symlink/空夾/帶標記的複製物重建)。"""
 11084	    import os
 11085	    if dst.is_dir() and not dst.is_symlink():
 11086	        try:
 11087	            empty = not any(os.scandir(dst))
 11088	        except OSError:
 11089	            empty = False
 11090	        if not empty and not (dst / _SKILL_MARKER).exists():
 11091	            print(f"  ⚠ 跳過 {dst}:已有不是 lumos 裝的同名目錄,不覆蓋(要換成 lumos 版請先自己搬走它)", file=sys.stderr)
 11092	            return False
 11093	    _link_or_copy(src, dst)
 11094	    return True
