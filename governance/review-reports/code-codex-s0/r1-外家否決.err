 11211	def _sync_msg(harness: str, state: str) -> str:
 11212	    """三態→給人看的一行(成功講改了什麼;失敗講原因與下一步)。"""
 11213	    hdir, sfile = _HARNESS_HOME[harness]
 11214	    name = "Claude" if harness == "claude" else "Codex"
 11215	    if state == "ok":
 11216	        tail = ";★Codex 的 hook 要你開一次互動 codex 審過(Hooks need review 畫面或 /hooks)才會跑,hook 檔更新後要再審;exec 不會問★" if harness == "codex" else "(含清撤除的舊註冊)"
 11217	        return f"  ✓ 全域 {name} hooks/{sfile} 已同步{tail}"
 11218	    if state == "probe":
 11219	        return f"  ⚠ 全域 {name} hooks 同步被擋(LUMOS_PROBE)——未動 ~/{hdir}"
 11220	    if state == "merge-failed":
 11221	        return f"  ⚠ 全域 {name} hooks:檔已 copy 但 ~/{hdir}/{sfile} 損毀、註冊沒更新——修好 JSON 再跑 lumos install --force"
 11222	    if state == "absent":
 11223	        return "  (本機無 codex:略過 Codex hooks;裝了之後再跑一次 lumos install --force)"
 11224	    return f"  ? 全域 {name} hooks 同步狀態 {state}"
 11225	
