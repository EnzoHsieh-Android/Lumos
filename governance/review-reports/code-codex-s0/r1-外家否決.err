 11275	def _confirm_tty(prompt):
 11276	    """三階互動確認(curl|bash 安全;設計:Projects/bootstrap一鍵對稱_計劃 std F1/F2/F3):
 11277	    回 True(答 y/yes)/False(其他答案=拒絕)/None(非互動或無人回答→呼叫端跳過)。
 11278	    ①stdin.isatty→input();EOFError 落入②非當 False(isatty 撒謊時別誤判拒絕)
 11279	    ②os.open(tty,O_RDWR) 低階 fd(★r+ 開法對 tty 會炸 not seekable★)+os.write prompt
 11280	      +select timeout(有控制終端≠有人回答,防 readline 永久掛)+os.read
 11281	    ③皆不可→None。嚴禁在非 isatty 時讀 sys.stdin(curl|bash 下那是腳本殘文管線)。
 11282	    測試接縫:LUMOS_TTY(預設 /dev/tty;單元測指 pty slave)/LUMOS_TTY_TIMEOUT(預設 30s)。"""
 11283	    import os, select
 11284	    def _norm(ans):
 11285	        return ans.strip().lower() in ("y", "yes")   # 嚴格答案+預設 N(F2-B 殘文緩解)
 11286	    if sys.stdin.isatty():
 11287	        try:
 11288	            return _norm(input(prompt))
 11289	        except EOFError:
 11290	            pass                                     # isatty 撒謊 → 試 ②(F2-A)
 11291	    tty_path = os.environ.get("LUMOS_TTY", "/dev/tty")
 11292	    try:
 11293	        timeout = float(os.environ.get("LUMOS_TTY_TIMEOUT", "30"))
 11294	    except ValueError:
 11295	        timeout = 30.0
 11296	    try:
 11297	        fd = os.open(tty_path, os.O_RDWR)
 11298	    except OSError:
 11299	        return None
 11300	    try:
 11301	        os.write(fd, prompt.encode("utf-8"))
 11302	        readable, _, _ = select.select([fd], [], [], timeout)
 11303	        if not readable:
 11304	            os.write(fd, "\n(無回應,視為略過)\n".encode("utf-8"))
 11305	            return None
 11306	        data = os.read(fd, 256)
 11307	        if not data:
 11308	            return None
 11309	        return _norm(data.decode("utf-8", errors="replace"))
 11310	    except OSError:
 24810	    check("fallback: 只新增檔→attached-empty、新增檔行、三格皆空行", data.get("fallback_status") == "attached-empty" and "新增檔 1 個" in text and "三格皆空" in text, f"{data.get('fallback_status')}\n{text[:600]}")
 24811	
 24812	
 24813	def t_lens_loaders_cfg_param_and_budget():
 24814	    """三支載入函式 cfg=None 舊行為不變;給 cfg 就不讀磁碟。快取鍵含 schema。預算不足→skipped-timeout。"""
 24815	    import json as _json, tempfile as _tf, time as _time
 24816	    m = _load_lumos_inproc()
 24817	    d = Path(_tf.mkdtemp(prefix="lenscfg-")); (d / ".lumos").mkdir()
 24818	    (d / ".lumos" / "config.json").write_text(_json.dumps({"test_profile": "python"}), encoding="utf-8")
 24819	    p_disk = m.load_test_profile(d); p_cfg = m.load_test_profile(d, cfg={"test_profile": "csharp-xunit"})
 24820	    check("loader: load_test_profile 無 cfg 讀磁碟(python)、有 cfg 不讀磁碟(csharp)", p_disk["scaffold_ext"] == ".py" and p_cfg["scaffold_ext"] == ".cs", f"{p_disk['scaffold_ext']} {p_cfg['scaffold_ext']}")
 24821	    (d / ".lumos" / "cochange.json").write_text(_json.dumps({"min_support": 5}), encoding="utf-8")
 24822	    c_disk, _ = m._cochange_load_config(d); c_cfg, _ = m._cochange_load_config(d, cfg={"min_support": 1})
 24823	    check("loader: _cochange_load_config 無 cfg 讀磁碟(5)、有 cfg 不讀磁碟且硬底線 2 照走", c_disk["min_support"] == 5 and c_cfg["min_support"] == 2, f"{c_disk['min_support']} {c_cfg['min_support']}")
 24824	    pl = m.load_platforms(d, cfg={"test_profile": "python"}); check("loader: load_platforms 吃 cfg", pl["default_platform"] and not pl["multiplatform"], str(pl)[:120])
 24825	    k1 = m._lens_cache_path(d, "a" * 40, "b" * 40); check("cache: 鍵含 schema 版本(常數存在且進鍵)", getattr(m, "_LENS_SCHEMA", None) == 2 and "dispatch-lens" in str(k1), str(k1))
 24826	    lines, status, meta = m._lens_fallback(d, "a" * 40, "b" * 40, [], set(), {}, _time.monotonic() - 1)
 24827	    check("budget: deadline 已過→skipped-timeout、印固定字串", status == "skipped-timeout" and any("預算不足" in l for l in lines), f"{status} {lines}")
 24828	    import inspect
 24829	    check("cochange: _cochange_transactions 有 timeout 參數", "timeout" in inspect.signature(m._cochange_transactions).parameters)
