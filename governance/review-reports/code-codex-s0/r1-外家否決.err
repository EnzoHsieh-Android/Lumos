 11010	def _skills_list():
 11011	    """user-scope skills=repo skills/ 下所有含 SKILL.md 的目錄(掃目錄防清單漂移——
 11012	    舊硬編碼 tuple 曾漏 code-loop 等;同步修 install.sh 同款漂移)。"""
 11013	    repo = Path(__file__).resolve().parent.parent
 11014	    d = repo / "skills"
 11015	    if not d.is_dir():
 11016	        return ()
 11017	    return tuple(sorted(p.name for p in d.iterdir() if (p / "SKILL.md").is_file()))
