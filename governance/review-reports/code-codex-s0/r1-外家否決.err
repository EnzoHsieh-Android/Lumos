 24905	def t_codex_teardown_global():
 24906	    """_teardown_global_hooks(repo,'codex'):清 ~/.codex/hooks 我方檔+剪註冊、留使用者 hook;沒 ~/.codex 無事可拆回 True。"""
 24907	    import json as _j
 24908	    home = Path(tempfile.mkdtemp(prefix="gctl-cdx-td-")); (home / ".codex").mkdir()
 24909	    _codex_run(home, "m._sync_global_hooks(repo,'codex')")
 24910	    hj = home / ".codex" / "hooks.json"
 24911	    d = _j.loads(hj.read_text(encoding="utf-8"))
