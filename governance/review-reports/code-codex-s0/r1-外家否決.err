 10591	def _expected_claude_body(root: Path, slug: str) -> "str | None":
 10592	    """讀 scripts/templates/graph-discipline.md,{{KG}} 替換後 strip 首尾空行 → 預期 body 字串。
 10593	    範本不存在 → None(呼叫端 skip Check D)。
 10594	    strip 用 `.strip("\\n")`(只去首尾空行、保留內縮排),與 _extract_claude_block_span 的 body
 10595	    取法一致——reinject 寫入、extract 讀回、Check D 比對三處同一算法,版本差不觸發(版本在 body 外)。"""
 10596	    tpl_path = root / "scripts" / "templates" / "graph-discipline.md"
 10597	    if not tpl_path.exists():
 10598	        return None
 10599	    return tpl_path.read_text(encoding="utf-8").replace("{{KG}}", f"docs/{slug}-knowledge/").strip("\n")
 10600	
