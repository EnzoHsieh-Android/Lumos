 24895	    check("codex-sync: absent 不建 ~/.codex", not (home2 / ".codex").exists(), "")
 24896	    r = _codex_run(home2, "print(m._sync_global_claude(repo))")
 24897	    check("codex-sync: Claude 包裝仍回 True", r.stdout.strip().endswith("True"), r.stdout[-100:])
