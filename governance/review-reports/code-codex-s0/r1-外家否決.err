 11164	def _sync_global_claude(src_repo: Path):
 11165	    """相容包裝:Claude 側同步,回 True=ok(既有呼叫/測試用)。三態版見 _sync_global_hooks。"""
 11166	    return _sync_global_hooks(src_repo, "claude") == "ok"
 11167	
 11168	
 11169	def _sync_global_hooks(src_repo: Path, harness: str) -> str:
 11170	    """全域 hooks/註冊同步(不需專案;install 與 _install_hooks_py 共用)。harness=claude|codex:
 11171	    claude → ~/.claude/hooks + settings.json;codex → ~/.codex/hooks + hooks.json(合併器 --target codex)。
 11172	    ①copy 現役 hooks ②刪已撤除 hook 殘留真檔 ③跑 merge-claude-settings(_prune_dangling 剪懸空註冊)。
 11173	    來源=src_repo(install 用來源 repo 自身、update 用專案 vendored copy);HOME 隔離可測。
 11174	    回三態字串:ok / probe(探針擋下,沒動) / merge-failed(hooks 設定檔壞或合併器非 0,hook 檔已 copy 但註冊沒更新)
 11175	    / absent(codex 專用:本機無 codex,跳過)。★不共用一顆布林★——False 曾被呼叫端寫死解讀成 LUMOS_PROBE,
 11176	    設定檔壞掉會印出誤導訊息(Projects/Codex完全支援_計劃 r2 邊界 N2)。"""
 11177	    # ★r1 正確性席:同 _install_skills——cmd_init/_vendor_toolchain 這條路會經此覆寫真的 ~/.claude/hooks
 11178	    # 與動 settings.json,繞過四個指令入口的守衛。擋在變動原語。
 11179	    if _refuse_if_probe(f"sync-global-{harness}"):
 11180	        return "probe"
 11181	    if harness == "codex" and not _codex_present():
 11182	        return "absent"
 11183	    import subprocess, shutil
 11184	    hdir, _ = _HARNESS_HOME[harness]
 11185	    chooks = Path.home() / hdir / "hooks"
 11186	    chooks.mkdir(parents=True, exist_ok=True)
 11187	    src_dir = src_repo / "scripts" / "hooks" / "claude"
 11188	    for f in _GLOBAL_CLAUDE_HOOKS:            # ① 現役 hooks copy
 11189	        s = src_dir / f
 11190	        if s.exists():
 11191	            shutil.copy2(s, chooks / f)
 11192	    for f in _RETIRED_STUB_CLAUDE_HOOKS:      # ②a 相容期:換 exit 0 空殼,★不刪檔★
 11193	        stub = chooks / f                     #     (刪了會炸掉還帶著舊註冊的 session)
 11194	        if stub.is_symlink():
 11195	            stub.unlink()                     #     symlink 先拆,免得寫穿到來源檔
 11196	        stub.write_text(_RETIRED_HOOK_STUB_BODY, encoding="utf-8")
 11197	        stub.chmod(0o755)
 11198	    for f in _RETIRED_CLAUDE_HOOKS:           # ②b 過了相容期:真刪殘留檔
 11199	        stale = chooks / f
 11200	        if stale.exists() or stale.is_symlink():
 11201	            stale.unlink()
 11202	    merge = src_repo / "scripts" / "merge-claude-settings.py"  # ③ merge+prune 懸空(含②剛變懸空的)
 11203	    if merge.exists():
 11204	        args = [sys.executable, str(merge)] + (["--target", "codex"] if harness == "codex" else [])
 11205	        r = subprocess.run(args)
 11206	        if r.returncode != 0:              # 合併器只在設定檔 JSON 壞時回 1:別當成功
 11207	            return "merge-failed"
 11208	    return "ok"
 11209	
