 11231	
 11232	def _teardown_global_hooks(src_repo: Path, harness: str):
 11233	    """_sync_global_hooks 的移除半邊(teardown 用):清全域 ~/.claude(或 ~/.codex)的我方 hook + 剪其懸空註冊。
 11234	    ①先驗 settings.json 可解析→壞則跳過+warn、★不刪 .py★(不製造懸空,std F6)②rm 我方現役+撤除 hook
 11235	    ③跑 merge --prune-only(★只剪懸空、不 re-add★——預設 merge 會把 hook 加回,抵銷 teardown)。
 11236	    須在 deinit 刪掉 vendored merge-claude-settings.py 之前跑(std F5,由 cmd_teardown 順序保證)。
 11237	    設計:Projects/teardown一鍵拆機_計劃。回 True=已處理 / False=因 settings 壞跳過。"""
 11238	    import subprocess, json
 11239	    hdir, sfile = _HARNESS_HOME[harness]
 11240	    chome = Path.home() / hdir
 11241	    if harness == "codex" and not chome.is_dir():
 11242	        return True                           # 沒裝過 Codex 側:無事可拆
 11243	    chooks, settings = chome / "hooks", chome / sfile
 11244	    if settings.exists():                     # ① 先驗可解析(壞 → 不半做)
 11245	        try:
 11246	            json.loads(settings.read_text(encoding="utf-8"))
 11247	        except Exception as e:
 11248	            print(f"  ⚠ ~/{hdir}/{sfile} 無法解析({e}),跳過全域 hook 清理"
 11249	                  "(避免刪了檔卻剪不掉註冊、留懸空)", file=sys.stderr)
 11250	            return False
 11251	    removed = []                              # ② rm 我方 hook 真檔
 11252	    for f in _GLOBAL_CLAUDE_HOOKS + _RETIRED_CLAUDE_HOOKS + _RETIRED_STUB_CLAUDE_HOOKS:
 11253	        p = chooks / f            # ★含相容期空殼★:拆機後機器上不該留我方任何檔
 11254	        if p.exists() or p.is_symlink():
 11255	            p.unlink(); removed.append(f)
 11256	    merge = src_repo / "scripts" / "merge-claude-settings.py"   # ③ prune-only 剪懸空我方註冊
 11257	    if merge.exists() and settings.exists():
 11258	        subprocess.run([sys.executable, str(merge), "--prune-only"] + (["--target", "codex"] if harness == "codex" else []))
 11259	    name = "Claude" if harness == "claude" else "Codex"
 11260	    print(f"  ✓ 全域 {name} hook 清理:移除 {len(removed)} 檔 + 剪懸空我方註冊" if removed
 11261	          else f"  ✓ 全域 {name} hook:無我方殘留")
 11262	    return True
 11263	
