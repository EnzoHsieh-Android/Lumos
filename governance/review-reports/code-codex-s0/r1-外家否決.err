 11136	# verification-rot-check.py:2026-08-21 體檢 #8 撤除(核心從未觸發、每次 Bash 付啟動成本;
 11137	#   見 Verification/2026-08-21_工具鏈體檢修復批)——相容期中,留空殼。
 11138	_RETIRED_STUB_CLAUDE_HOOKS = ("verification-rot-check.py",)
 11139	_RETIRED_CLAUDE_HOOKS = ("code-loop-guard.py",)
