 11100	def _scaffold_project(root: Path, slug: str):
 11101	    kg = root / "docs" / f"{slug}-knowledge"
 11102	    if kg.exists():
 11103	        print(f"  ✓ vault 已存在,跳過 scaffold(保護資料): {kg}")
 11104	        return
 11105	    for d in _INIT_SUBDIRS_FULL:
 11106	        (kg / d).mkdir(parents=True, exist_ok=True)
 11107	    _write_lf(kg / "MOC" / "index.md",
 11108	              f"---\ntype: moc\nstatus: doing\n---\n# {slug} 知識圖譜總索引\n")
 11109	    # ★帳檔落在 docs/(vault.parent,見 _append_governance_log 等),.gitignore 必須寫在同一層★——
 11110	    # 2026-06-26 起一直寫在 vault 內,對上一層的帳檔一個都沒忽略到(L4 清帳 2026-08-21 抓到:
 11111	    # 本 repo 帳檔因此全被追蹤,筆記「皆 gitignore」長期為假)。改寫到 docs/.gitignore;
 11112	    # 既有 repo 已追蹤的帳檔不受影響(gitignore 不 untrack),要不要 untrack 是另一個決定。
 11113	    _write_lf(kg.parent / ".gitignore",
 11114	              ".bypass-log.jsonl\n.rot-queue.jsonl\n.governance-log.jsonl\n.canary-log.jsonl\n"
 11115	              ".kill-log.jsonl\n.signoff-log.jsonl\n.usage-log.jsonl\n.ci-log.jsonl\n")
 11116	    print(f"  ✓ scaffold {kg}(帳檔 .gitignore → {kg.parent / '.gitignore'})")
