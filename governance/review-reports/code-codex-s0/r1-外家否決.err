 25010	    by3 = {r["layer"]: r["status"] for r in m.enforcement_status(root=root, home=home)}
 25011	    check("codex-enf: agents-md 版本戳同 CLAUDE.md → active", by3.get("agents-md") == "active", str(by3.get("agents-md")))
