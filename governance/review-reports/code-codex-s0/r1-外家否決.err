 11062	    if _refuse_if_probe("install-skills"):
 11063	        return
 11064	    repo = Path(__file__).resolve().parent.parent
 11065	    dest = Path.home() / ".claude" / "skills"
 11066	    for s in _SKILLS:
 11067	        src = repo / "skills" / s
 11068	        if src.is_dir():
