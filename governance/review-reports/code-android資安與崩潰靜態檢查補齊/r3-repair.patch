diff --git a/configs/ast-grep/kotlin-android/utils/debug-only.yml b/configs/ast-grep/kotlin-android/utils/debug-only.yml
new file mode 100644
index 0000000000000000000000000000000000000000..99b01ec703cfb1d127702c1e980c0ebc31a29c1f
--- /dev/null
+++ b/configs/ast-grep/kotlin-android/utils/debug-only.yml
@@ -0,0 +1,24 @@
+# 「只在除錯版才會走到」的共用判斷(代碼審 code-android資安與崩潰靜態檢查補齊 r2:原本 API-19、DATA-16 一套、兩條資安規則另抄一套)。
+# 命中=節點寫在條件是 BuildConfig.DEBUG(或只用「且」接別的條件)的 if 成立那一支,或條件恰好是 BuildConfig.DEBUG 的 when 分支裡;
+# 否定、else 分支、「或」連別的條件都不算。規則用 `not: matches: kt-in-debug-only-branch` 引用,四份 sgconfig 都掛 utilDirs。
+id: kt-in-debug-only-branch
+language: kotlin
+rule:
+  inside:
+    stopBy: end
+    kind: control_structure_body
+    any:
+      - all:
+          - not:
+              follows:
+                regex: ^else$
+          - inside:
+              kind: if_expression
+              has:
+                field: condition
+                regex: ^(BuildConfig\.DEBUG|BuildConfig\.DEBUG\s*&&[^|]*|[^|!]*&&\s*BuildConfig\.DEBUG)$
+      - inside:
+          kind: when_entry
+          has:
+            kind: when_condition
+            regex: ^BuildConfig\.DEBUG$
