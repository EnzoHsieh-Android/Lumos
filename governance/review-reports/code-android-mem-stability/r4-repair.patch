+++        local = os.path.join(run_dir, "cycle.pftrace")
+++        rc = adb("pull", remote_trace, local)[0]
+++        return (local, None) if rc == 0 and os.path.isfile(local) else (None, "拉不回追蹤檔")
+++    finally:
+++        shell(f"rm -f {remote_cfg} {remote_trace}")
