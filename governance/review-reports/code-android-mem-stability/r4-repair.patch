++def stop_logcat(lc):
++    """收掉日誌串流;回它是不是早就自己斷了。"""
++    if lc is None:
++        return False
++    time.sleep(SETTLE)   # 讓日誌串流跟上量測結束前的最後幾行;等完再看它是不是早就自己斷了
++    died = lc.poll() is not None
++    lc.terminate()
++    try:
++        lc.wait(timeout=10)
++    except subprocess.TimeoutExpired:
++        lc.kill()
++    return died
