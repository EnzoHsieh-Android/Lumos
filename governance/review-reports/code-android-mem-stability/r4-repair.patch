++def read_exits(pkg):
++    rc, out, err = shell(f"dumpsys activity exit-info {pkg}")
++    if rc != 0:
++        return "failed", f"dumpsys activity exit-info 失敗:{err.strip() or rc}"
++    return parse_exit_info(out, pkg)
