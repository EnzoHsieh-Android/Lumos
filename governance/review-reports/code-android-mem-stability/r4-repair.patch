++++def driver(cmd, n, serial):
++++    env = dict(os.environ, CYCLES=str(n))
++++    if serial:
++++        env["ANDROID_SERIAL"] = serial
++++    rc, out, err = run(["sh", "-c", cmd.replace("{{CYCLES}}", str(n))], timeout=T_LONG, env=env)
++++    text = out + err
++++    if rc != 0:
++++        return {"rc": rc, "ok": False, "why": f"驅動回 {rc}:{text.strip()[-200:]}"}
++++    if "INSTRUMENTATION_CODE" in text and ("INSTRUMENTATION_CODE: -1" not in text or "FAILURES!!!" in text):
++++        return {"rc": rc, "ok": False, "why": "UI Automator 驅動沒有成功結束(沒有 INSTRUMENTATION_CODE: -1 或有 FAILURES!!!)"}
