+++# lumos 記憶體與穩定性收集:在主機端排順序、用 adb 收記憶體與穩定性資料,寫成 .lumos/artifacts/android/<run-id>/stability.json;
+++# 不判過不過(判定在 lumos macrobench --stability)。單一來源在工具鏈 scripts/templates/,消費專案照抄;規則單源 Projects/Android記憶體與穩定性驗收_計劃。
+++# 用法:在專案根目錄跑 sh scripts/templates/android-stability-collect.sh [run-id]
+++# 外部工具:ADB(預設 adb)、TP(trace_processor)、JAVA_HEAP_DUMP(skill 的 java_heap_dump,宣告了測試資料才用)
+++# 回傳碼:結果檔寫出來回 0(哪一段沒收到寫在那個來源的 status);設定讀不了、必要工具找不到回 2 並印「擋下:」
+++set -eu
+++HERE=$(cd "$(dirname "$0")" && pwd)
+++# -P:不把目前目錄放進模組搜尋路徑(在放了外來 .py 的目錄執行也不會載入它);不用 -I,-I 會連 PYTHONUTF8 一起忽略(代碼審 r1 架構對齊席)
+++exec env PYTHONUTF8=1 PYTHONIOENCODING=utf-8 python3 -P - "$HERE" "$(pwd)" "${1:-}" <<'PY'
+++import json, os, re, shutil, signal, subprocess, sys, tempfile, time
+++here, root, run_id = sys.argv[1], sys.argv[2], sys.argv[3] or time.strftime("stability-%Y%m%d-%H%M%S")
+++ADB, TP, JHD = os.environ.get("ADB", "adb"), os.environ.get("TP", "trace_processor"), os.environ.get("JAVA_HEAP_DUMP", "java_heap_dump")
+++T_SHORT = 120   # 秒:一般 adb 呼叫
+++T_LONG = float(os.environ.get("LUMOS_STABILITY_LONG_S", "1800"))   # 秒:驅動、原生掃描與快照查詢的上限(測試縮短用)
+++SETTLE = float(os.environ.get("LUMOS_STABILITY_SETTLE_S", "2"))   # 等 App 起來、等日誌串流跟上的秒數(測試縮短用)
+++STOP_WAIT = float(os.environ.get("LUMOS_STABILITY_STOP_WAIT_S", "30"))   # 送 TERM 後等錄製結束的秒數,等完還在就補 KILL
+++GROUPS = []   # 正在跑、有自己程序群組的子程序(驅動):被中斷時整組收掉
+++EXIT_TYPES = {3: "low_memory", 4: "crash", 5: "native_crash", 6: "anr"}
+++
+++
+++def die(msg):
+++    print(f"擋下:{msg}", file=sys.stderr)
+++    sys.exit(2)
+++
+++
+++class Terminated(Exception):
+++    """收到 SIGTERM:轉成例外,讓 finally 收掉裝置上的錄製與主機上的子程序(Python 預設收到 SIGTERM 直接結束、finally 不會跑)。"""
+++
+++
+++def on_term(signum, frame):
+++    raise Terminated()
+++
+++
+++def kill_group(p):
+++    try:
+++        os.killpg(p.pid, signal.SIGKILL)
+++    except OSError:
+++        pass
+++
+++
+++def run(cmd, timeout=T_SHORT, group=False, **kw):
+++    """回 (回傳碼, 標準輸出, 標準錯誤);逾時或執行不了回 (None, '', 原因)。group=True 時子程序自成一個程序群組,
+++    逾時或被中斷時整組殺掉(驅動是 sh -c,底下的 adb 或 maestro 不能變成孤兒)。"""
+++    try:
+++        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="replace",
+++                             start_new_session=group, **kw)
+++    except OSError as e:
+++        return None, "", f"執行不了({e.strerror})"
+++    if group:
+++        GROUPS.append(p)
+++    try:
+++        out, err = p.communicate(timeout=timeout)
+++        return p.returncode, out, err
+++    except subprocess.TimeoutExpired:
+++        kill_group(p) if group else p.kill()
+++        p.communicate()
+++        return None, "", f"逾時({timeout} 秒)"
+++    except BaseException:   # SIGTERM 或 Ctrl-C 打斷等待:先收掉子程序(整組)再往上丟,不然下面的 finally 會先把它從待收清單拿掉
+++        kill_group(p) if group else p.kill()
+++        raise
+++    finally:
+++        if group:
+++            GROUPS.remove(p)
+++
+++
+++def adb(*args, timeout=T_SHORT):
+++    return run([ADB, *args], timeout=timeout)
+++
+++
+++def shell(cmd, timeout=T_SHORT):
+++    return adb("shell", cmd, timeout=timeout)
