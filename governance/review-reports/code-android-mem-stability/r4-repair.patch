++        if len(cells) >= 2 and cells[-1].isdigit():
++            name = deobfuscate(",".join(cells[:-1]), mapping)
++            counts[name] = counts.get(name, 0) + int(cells[-1])
++    if not counts:   # 回傳碼 0 但一列都沒有:快照是空的、或套件名對不上快照裡的行程(代碼審 r1 邊界、正確性席)
