++++    lc = subprocess.Popen([ADB, "logcat", f"--pid={pids[-1]}", "-T", t0, "-v", "brief"], stdout=logf, stderr=subprocess.STDOUT) if pids[-1] else None
++++    finished = False
++++    try:
++++        d_cyc = driver(st["driver"], n, serial)
++++        finished = True
++++    finally:
++++        lc_died = lc is not None and lc.poll() is not None
++++        if lc is not None and not lc_died:
