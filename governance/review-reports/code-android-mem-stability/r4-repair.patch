++    rc, _, err = run([JHD, "-n", pkg, "-o", path], timeout=T_LONG)
++    if rc != 0 or not os.path.isfile(path):
++        return None, f"java_heap_dump 錄不到快照:{err.strip()[-200:] or rc}"
++    return heap_counts(path, pkg, mapping)
