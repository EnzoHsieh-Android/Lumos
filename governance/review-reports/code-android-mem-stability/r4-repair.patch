++            p.send_signal(signal.SIGTERM)
++            p.wait(timeout=60)
++            time.sleep(0.5)
++            log = (fake / "adb.log").read_text()
++            left = sp.run(["pgrep", "-f", f"{fake}/adb logcat"], capture_output=True, text=True).stdout.split()
++            check(f"中斷落在{window}:日誌串流沒有變成孤兒", not left, str(left))
++            check(f"中斷落在{window}:裝置上的錄製有送 kill -TERM", "kill -TERM 4321" in log, log[-400:])
++            check(f"中斷落在{window}:原始日誌 logcat.raw 刪掉", not (root / ".lumos" / "artifacts" / "android" / "run5" / "logcat.raw").exists())
++            for pid in left:
++                sp.run(["kill", pid], capture_output=True)
