+++def preflight(st):
+++    """動裝置之前的檢查:run-id、工具、產物目錄有沒有被 git 忽略。回 (是否錄快照, run 目錄)。"""
+++    if not re.fullmatch(r"[A-Za-z0-9._-]+", run_id) or set(run_id) <= {"."}:
+++        die(f"run-id 只收英數字、點、底線與連字號,也不能只有點(它會用在裝置上的路徑):{run_id!r}")
+++    for tool in (ADB, TP):
+++        if not shutil.which(tool):
+++            die(f"找不到 {tool};用環境變數 ADB=、TP= 指定")
+++    test_data = bool((st.get("test_data") or {}).get("value"))
+++    if test_data and not shutil.which(JHD):
+++        die(f"宣告了測試資料要錄快照,但找不到 {JHD};用 JAVA_HEAP_DUMP= 指定")
+++    rel = os.path.join(".lumos", "artifacts", "android", run_id, "stability.json")
+++    in_git = run(["git", "-C", root, "rev-parse", "--is-inside-work-tree"])[0] == 0
+++    if in_git and run(["git", "-C", root, "check-ignore", "-q", rel])[0] != 0:   # 快照、日誌與結果檔不准進版控(代碼審 r1 資安席)
+++        die(".lumos/artifacts/ 沒被 git 忽略;先在 .gitignore 加一行 .lumos/artifacts/ 再跑(快照與日誌可能含使用者資料)")
+++    return test_data, os.path.join(root, ".lumos", "artifacts", "android", run_id)
