+++        while perfetto_alive(pid) and time.time() < deadline:
+++            time.sleep(1)
+++        if perfetto_alive(pid):   # 等完還在:補 KILL,這份追蹤檔沒寫完,不能拿來算
+++            shell(f"kill -KILL {pid}")
