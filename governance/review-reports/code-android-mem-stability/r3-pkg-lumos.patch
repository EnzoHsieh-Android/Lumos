+def _macrobench_judge_stability(thresholds, stab):
+    """寫了 check 的門檻條目對 stability.json 判:沒過 / 通過 / 跳過(附原因)。只提醒,不擋。"""
+    out = {"threshold_failures": [], "threshold_passed": [], "threshold_skipped": []}
+    for t in thresholds:
+        if "check" not in t:
+            continue
+        rec = {k: t[k] for k in ("scenario", "check", "contract")}
+        why = _macrobench_stab_skip_reason(t, stab)
+        failed = None
+        if why is None:
+            failed, why = MACROBENCH_CHECK_JUDGES[t["check"]](t, stab, rec)
+        if why is not None:
+            out["threshold_skipped"].append(dict(rec, reason=why))
+        else:
+            out["threshold_failures" if failed else "threshold_passed"].append(rec)
+    return out
+
+
+def _macrobench_stab_fmt(v):
+    """整數照原樣印(位元組數不要變科學記號),其他用 :g。"""
+    return str(int(v)) if float(v).is_integer() else f"{v:g}"
+
+
+def _macrobench_stab_detail(r):
+    """check 條目的一行明細(文字輸出用)。"""
+    c = r["check"]
+    if c == "native_unreachable":
+        return (f"沒人指著的原生記憶體多了 {_macrobench_stab_fmt(r['delta_bytes'])} 位元組、{_macrobench_stab_fmt(r['delta_allocations'])} 塊"
+                f"(門檻 {_macrobench_stab_fmt(r['max_bytes'])})")
+    if c == "java_growth":
+        note = "(類別名未還原:沒給 R8 mapping,排除清單擋不到被改名的函式庫類別)" if r.get("class_names") == "raw" else ""
+        return ("、".join(f"{g['class']} 多 {_macrobench_stab_fmt(g['delta'])} 個" for g in r.get("grown", [])) or "沒有類別增長") + note
+    if c == "instances":
+        return f"{r['class']} 有 {_macrobench_stab_fmt(r['count'])} 個(上限 {_macrobench_stab_fmt(r['max'])})"
+    if c == "peak_vitals":
+        return f"峰值 {r['peak_kb'] / 1024:.0f} MB(官方上限 {r['limit_gb']:g} GB,裝置 {r['total_mem_mb']:g} MB)"
+    if c == "exits":
+        bits = [*r.get("bad_types", []), *(["pid 變了"] if r.get("pid_changed") else [])]
+        return "、".join(bits) or f"只有 {r.get('other', 0)} 筆其他原因的結束紀錄"
+    if c == "strictmode":
+        return "、".join(r.get("violations", [])) or "沒有違規"
+    if c == "frozen":
+        return f"凍結幀 {_macrobench_stab_fmt(r['frozen_frames'])} 幀、主執行緒最長阻塞 {r.get('max_main_block_ms')} ms"
+    return ""
