+def _ms_wait_for(cond, tries=300, step=0.1):
+    """等條件成立(最多 tries × step 秒);回最後一次的結果。"""
+    import time
+    for _ in range(tries):
+        if cond():
+            return True
+        time.sleep(step)
+    return cond()
