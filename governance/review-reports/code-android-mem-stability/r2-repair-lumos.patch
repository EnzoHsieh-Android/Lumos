 def _macrobench_print_thresholds(res):
     """門檻判定的文字輸出;沒有門檻檔時不印。"""
     n = sum(len(res[k]) for k in ("threshold_failures", "threshold_passed", "threshold_skipped"))
     if not n:
         return
     fails = res["threshold_failures"]
     print(f"驗收門檻:{len(fails)} 條沒達、{len(res['threshold_passed'])} 條達標、"
           f"{len(res['threshold_skipped'])} 條沒判(只提醒,不擋推送)。")
     for r in fails:
         if "check" in r:
-            print(f"  [沒達驗收門檻] {r['scenario']} {r['check']}:{_ms_detail(r)}")
+            print(f"  [沒達驗收門檻] {r['scenario']} {r['check']}:{_macrobench_stab_detail(r)}")
         else:
             op, lim = ("≤", r["max"]) if "max" in r else ("≥", r["min"])
             print(f"  [沒達驗收門檻] {r['scenario']} {r['metric']} {r['stat']}:{r['current']:.1f}(門檻 {op} {lim:g})")
         print(f"      合約:{r['contract']}")
     for r in res["threshold_passed"]:
         if r.get("check") in ("frozen", "exits"):   # 通過也回報:最長阻塞、其他原因的結束紀錄
-            print(f"  [達標] {r['scenario']} {r['check']}:{_ms_detail(r)}")
+            print(f"  [達標] {r['scenario']} {r['check']}:{_macrobench_stab_detail(r)}")
     for r in res["threshold_skipped"]:
         what = r["check"] if "check" in r else f"{r['metric']} {r['stat']}"
         print(f"  [沒判] {r['scenario']} {what}:{r['reason']}")
 
 
