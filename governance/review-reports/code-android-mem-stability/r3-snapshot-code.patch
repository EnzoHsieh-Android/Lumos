+        return None, "exits 的 new 有不是 {type: 字串} 的紀錄"
+    new = s["new"]
+    bad = [e.get("type") for e in new if e.get("type") in MACROBENCH_EXIT_FAIL_TYPES]
+    pids = _macrobench_stab_pids(stab)
+    rec.update(bad_types=bad, other=len(new) - len(bad), pid_changed=pids is not None and len(set(pids)) > 1)
+    if bad:   # 崩潰類紀錄不靠 pid:崩潰後 App 沒被重啟時第三次讀不到 pid,這正是最該抓的情境(代碼審 r1)
+        return True, None
+    if pids is None:
+        return None, "pid 有讀不到的(判不出量測期間行程有沒有換過)"
+    return rec["pid_changed"], None
+
+
+def _macrobench_stab_strictmode(t, stab, rec):
+    s, why = _macrobench_stab_src(stab, "strictmode")
+    if why:
+        return None, why
+    if not isinstance(s.get("violations"), list):
+        return None, "strictmode 缺 violations 清單"
+    if not all(isinstance(x, dict) and isinstance(x.get("type"), str) for x in s["violations"]):
+        return None, "strictmode 的 violations 有不是 {type: 字串} 的紀錄"
+    v = [x["type"] for x in s["violations"]]
+    rec.update(violations=v)
+    return bool(v), None
+
+
+def _macrobench_stab_frozen(t, stab, rec):
+    s, why = _macrobench_stab_src(stab, "cycle_trace")
+    if why:
+        return None, why
+    frames, frozen = _macrobench_stab_val(s.get("frames")), _macrobench_stab_val(s.get("frozen_frames"))
+    block = _macrobench_stab_val(s.get("max_main_block_ms"))
+    if frames is None or frozen is None:
+        return None, "幀數或凍結幀數缺了、不是有限數或是 -1"
+    if frames == 0:
+        return None, "追蹤檔裡一幀都沒有(沒錄到畫面)"
+    if "max_block_ms" in t and block is None:
+        return None, "設了 max_block_ms,但主執行緒阻塞量不到(-1 或缺)"
+    rec.update(frozen_frames=frozen, max_main_block_ms=block, frames=frames)
+    over = "max_block_ms" in t and block > t["max_block_ms"]
+    if over:
+        rec["max_block_ms"] = t["max_block_ms"]
+    return frozen > 0 or over, None
+
+
+MACROBENCH_CHECK_JUDGES = {"native_unreachable": _macrobench_stab_native_unreachable, "java_growth": _macrobench_stab_java_growth,
+                           "instances": _macrobench_stab_instances, "peak_vitals": _macrobench_stab_peak_vitals, "exits": _macrobench_stab_exits,
+                           "strictmode": _macrobench_stab_strictmode, "frozen": _macrobench_stab_frozen}
+
+
+def _macrobench_stab_skip_reason(t, stab):
+    """這條在判之前就該跳過的原因;不用跳過回 None。"""
+    if stab is None:
+        return "沒給 --stability 結果檔"
+    if stab.get("scenario") != t["scenario"]:
+        return f"結果檔是情境 {stab.get('scenario')},不是這條的 {t['scenario']}"
+    if "device_model" in t and stab.get("device_model") != t["device_model"]:
+        return f"換了裝置:門檻指定 {t['device_model']},這次是 {stab.get('device_model')}"
+    if t["check"] in MACROBENCH_NEEDS_FULL_CYCLES:
+        _, why = _macrobench_stab_src(stab, "driver")
+        if why:
+            return f"驅動沒跑完 N 輪,{why}"
+        pids = _macrobench_stab_pids(stab)
+        if pids is None:
+            return "pid 有讀不到的,前後量的可能不是同一個行程"
+        if len(set(pids)) > 1:   # 中途崩潰後 App 被重啟:前後兩次量的是不同行程,比了也沒意義(2026-10-24 實驗室)
+            return "量測期間行程換過(pid 變了),前後量的不是同一個行程"
+    return None
+
+
+def _macrobench_judge_stability(thresholds, stab):
+    """寫了 check 的門檻條目對 stability.json 判:沒過 / 通過 / 跳過(附原因)。只提醒,不擋。"""
+    out = {"threshold_failures": [], "threshold_passed": [], "threshold_skipped": []}
+    for t in thresholds:
+        if "check" not in t:
+            continue
+        rec = {k: t[k] for k in ("scenario", "check", "contract")}
+        why = _macrobench_stab_skip_reason(t, stab)
+        failed = None
+        if why is None:
+            failed, why = MACROBENCH_CHECK_JUDGES[t["check"]](t, stab, rec)
+        if why is not None:
+            out["threshold_skipped"].append(dict(rec, reason=why))
+        else:
+            out["threshold_failures" if failed else "threshold_passed"].append(rec)
+    return out
+
+
+def _macrobench_stab_fmt(v):
+    """整數照原樣印(位元組數不要變科學記號),其他用 :g。"""
+    return str(int(v)) if float(v).is_integer() else f"{v:g}"
+
+
+def _macrobench_stab_detail(r):
+    """check 條目的一行明細(文字輸出用)。"""
+    c = r["check"]
+    if c == "native_unreachable":
+        return (f"沒人指著的原生記憶體多了 {_macrobench_stab_fmt(r['delta_bytes'])} 位元組、{_macrobench_stab_fmt(r['delta_allocations'])} 塊"
+                f"(門檻 {_macrobench_stab_fmt(r['max_bytes'])})")
+    if c == "java_growth":
+        note = "(類別名未還原:沒給 R8 mapping,排除清單擋不到被改名的函式庫類別)" if r.get("class_names") == "raw" else ""
+        return ("、".join(f"{g['class']} 多 {_macrobench_stab_fmt(g['delta'])} 個" for g in r.get("grown", [])) or "沒有類別增長") + note
+    if c == "instances":
+        return f"{r['class']} 有 {_macrobench_stab_fmt(r['count'])} 個(上限 {_macrobench_stab_fmt(r['max'])})"
+    if c == "peak_vitals":
+        return f"峰值 {r['peak_kb'] / 1024:.0f} MB(官方上限 {r['limit_gb']:g} GB,裝置 {r['total_mem_mb']:g} MB)"
+    if c == "exits":
+        bits = [*r.get("bad_types", []), *(["pid 變了"] if r.get("pid_changed") else [])]
+        return "、".join(bits) or f"只有 {r.get('other', 0)} 筆其他原因的結束紀錄"
+    if c == "strictmode":
+        return "、".join(r.get("violations", [])) or "沒有違規"
+    if c == "frozen":
+        return f"凍結幀 {_macrobench_stab_fmt(r['frozen_frames'])} 幀、主執行緒最長阻塞 {r.get('max_main_block_ms')} ms"
+    return ""
+
