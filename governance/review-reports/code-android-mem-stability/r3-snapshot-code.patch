+def start_logcat(st, pid, t0, run_dir):
+    """只在宣告了 strictmode 時開日誌串流,只收這個 pid、量測開始之後的。回 (Popen 或 None, 暫存檔路徑)。"""
+    if not st.get("strictmode") or not pid:
+        return None, None
+    raw = os.path.join(run_dir, "logcat.raw")
+    with open(raw, "w", encoding="utf-8") as logf:
+        lc = subprocess.Popen([ADB, "logcat", f"--pid={pid}", "-T", t0, "-v", "brief"], stdout=logf, stderr=subprocess.STDOUT)
+    return lc, raw
+
+
+def stop_logcat(lc):
+    """收掉日誌串流;回它是不是早就自己斷了。"""
+    if lc is None:
+        return False
+    time.sleep(SETTLE)   # 讓日誌串流跟上量測結束前的最後幾行;等完再看它是不是早就自己斷了
+    died = lc.poll() is not None
+    lc.terminate()
+    try:
+        lc.wait(timeout=10)
+    except subprocess.TimeoutExpired:
+        lc.kill()
+    return died
+
+
+def drop_raw(raw):
+    """刪掉原始日誌串流(日誌常含帳號、權杖、網址):每條路都要刪,包括串流斷了與被中斷(代碼審 r2 五席)。"""
+    if raw and os.path.lexists(raw):
+        os.unlink(raw)
+
+
+def strictmode_result(st, started, died, raw, run_dir):
+    """只留違規那幾行落地,原始串流不管成不成都刪掉。"""
+    try:
+        if not st.get("strictmode"):
+            return {"status": "unsupported", "reason": "設定沒宣告 strictmode"}
+        if not started or died:
+            return {"status": "failed", "reason": "日誌串流沒開成或中途斷了"}
+        lines = [x for x in open(raw, encoding="utf-8", errors="replace") if "StrictMode policy violation" in x]
+    finally:
+        drop_raw(raw)
+    with open(os.path.join(run_dir, "logcat.txt"), "w", encoding="utf-8") as f:
+        f.writelines(lines)
+    return {"status": "ok", "violations": [
+        {"type": (re.search(r"strictmode\.(\w+Violation)", x) or re.search(r"(\w+Violation)", x) or [None, "unknown"])[1]} for x in lines]}
+
+
+def heap_result(test_data, before, after, why, mapping):
+    if before is None or after is None:
+        return src({}, why, "unsupported" if not test_data else "failed")
+    declared = declared_classes()
+    declared |= {f"java.lang.Class<{c}>" for c in declared}   # 宣告類別沒有實例時,靠它的類別物件證明載入過
+    keep = {c for c in set(before) | set(after) if before.get(c) != after.get(c) or c in declared}
+    return {"status": "ok", "before": {c: before[c] for c in keep if c in before}, "after": {c: after[c] for c in keep if c in after},
+            "classes_seen": {"before": len(before), "after": len(after)}, "class_names": "mapping" if mapping else "raw"}
+
+
+def measure(st, test_data, run_dir, mapping, state):
+    """裝置上的整段流程;state 收著被中斷時要收掉的錄製與日誌串流。"""
+    pkg, n, w, serial = st["package"], st["cycles"], st["warmup"], st.get("adb_serial")
+    res = device_info(st)
+    shell(f"am force-stop {pkg}")   # 從乾淨的行程開始:不停的話上一次留下的物件會算進這一次(2026-10-24 實驗室連跑兩次時抓到)
+    ex_status, ex_before = read_exits(pkg)   # 停完才讀,停 App 自己產生的那筆結束紀錄不會被當成測試期間的
+    shell(f"monkey -p {pkg} -c android.intent.category.LAUNCHER 1")
+    time.sleep(SETTLE)
+    pids = [pidof(pkg)]
+    d_warm = driver(st["driver"], w, serial)
+    pids.append(pidof(pkg))
+    u_before, u_why = unreachable(pids[-1]) if pids[-1] else (None, "App 沒在跑")   # 先掃再錄快照:錄快照時的配置不算進掃描
+    nh_before = native_heap_kb(pkg)
+    h_before, h_why = snapshot(pkg, run_dir, "before", mapping) if test_data else (None, "沒宣告測試資料(stability.test_data),不錄快照")
+    t0 = shell("date '+%m-%d %H:%M:%S.000'")[1].strip()
+    state["rec"] = start_record(pkg, run_dir, st.get("max_record_s", 600))
+    state["lc"], state["raw"] = start_logcat(st, pids[-1], t0, run_dir)
+    raw = state["raw"]
+    d_cyc = driver(st["driver"], n, serial)
+    # 停完才從 state 拿掉:等日誌跟上、等錄製停下的那幾秒被中斷時,cleanup 還找得到它們(代碼審 r2 正確性席、資源席)
+    died = stop_logcat(state["lc"])
+    del state["lc"]
+    rec = state["rec"]
+    trace, t_why = stop_record(rec, run_dir) if rec[0] else (None, rec[1])
+    del state["rec"]
+    pids.append(pidof(pkg))
+    u_after, u_why2 = unreachable(pids[-1]) if pids[-1] else (None, "App 沒在跑")
+    nh_after = native_heap_kb(pkg)
+    h_after, h_why2 = snapshot(pkg, run_dir, "after", mapping) if test_data else (None, h_why)
+    ex_status2, ex_after = read_exits(pkg)
+    drv_ok = d_warm["ok"] and d_cyc["ok"]
+    res["driver"] = {"status": "ok" if drv_ok else "failed", "warmup": d_warm, "cycles": d_cyc,
+                     **({} if drv_ok else {"reason": d_warm.get("why") or d_cyc.get("why")})}
+    res["pids"] = src({"values": pids}, None if all(pids) else "有一次讀不到 pid(App 不在了)")
+    res["unreachable"] = src({"before": u_before, "after": u_after}, u_why or u_why2)
+    res["native_heap_kb"] = src({"before": nh_before, "after": nh_after}, None if nh_before is not None and nh_after is not None else "讀不到 Native Heap")
+    res["heap"] = heap_result(test_data, h_before, h_after, h_why or h_why2, mapping)
+    nums, c_why = cycle_numbers(trace, pkg) if trace else (None, t_why)
+    res["cycle_trace"] = src(nums or {}, c_why)
+    if ex_status == "ok" and ex_status2 == "ok":
+        res["exits"] = {"status": "ok", "new": exit_diff(ex_before, ex_after)}
+    else:
+        res["exits"] = {"status": "failed", "reason": ex_before if ex_status != "ok" else ex_after}
+    res["strictmode"] = strictmode_result(st, raw is not None, died, raw, run_dir)
+    return res
+
+
+def cleanup(state):
+    """被 SIGTERM、Ctrl-C 或例外中斷時:收掉驅動整組子程序、日誌串流,停掉裝置上的錄製並刪暫存。"""
+    for p in list(GROUPS):
+        kill_group(p)
+    lc = state.get("lc")
+    if lc is not None:
+        lc.kill()
+    rec = state.get("rec")
+    if rec:
+        abort_record(rec)
+    drop_raw(state.get("raw"))
+
+
+def main():
+    signal.signal(signal.SIGTERM, on_term)
+    st = load_config()
+    if st.get("adb_serial"):
+        os.environ["ANDROID_SERIAL"] = st["adb_serial"]
+    test_data, run_dir = preflight(st)
+    os.makedirs(run_dir, exist_ok=True)
+    prune_old_snapshots()
+    mapping = load_mapping(st.get("mapping"))
+    state = {}
+    try:
+        res = measure(st, test_data, run_dir, mapping, state)
+    except (Terminated, KeyboardInterrupt):
+        cleanup(state)
+        print("擋下:收集被中斷,裝置上的錄製與暫存已收掉,沒寫結果檔", file=sys.stderr)
+        sys.exit(2)
+    except BaseException:
+        cleanup(state)
+        raise
+    out = os.path.join(run_dir, "stability.json")
+    with open(out, "w", encoding="utf-8") as f:
+        json.dump(res, f, ensure_ascii=False, indent=1)
+    print(out)
+
+main()
+PY
diff --git a/scripts/templates/android-stability-cycle.sql b/scripts/templates/android-stability-cycle.sql
new file mode 100644
index 00000000..a0cb02b8
--- /dev/null
+++ b/scripts/templates/android-stability-cycle.sql
@@ -0,0 +1,50 @@
+-- SPDX-FileCopyrightText: 2026 Enzo Hsieh
+-- SPDX-License-Identifier: MIT
+--
+-- 記憶體與穩定性收集:N 輪量測期間那一份追蹤檔算一列數字,給收集腳本(android-stability-collect.sh)寫進 stability.json 的 cycle_trace
+--   peak_anon_swap_kb  App 的匿名常駐記憶體加 swap 的最大值(KB);swap 取樣比較稀,每個 mem.rss.anon 取樣點配它之前最近一次的 swap
+--                      (swap 先排成「這一筆到下一筆」的區間再配,不對每個取樣點各跑一次子查詢:真實追蹤檔從 73.8 秒降到 0.26 秒,代碼審 r1 資源席,
+--                      區間配對仍隨取樣數平方成長,只是常數小很多,預設 600 秒錄製約 2400 個取樣點影響不到,代碼審 r2 資源席)
+--   frozen_frames      超過 700ms 的幀數:有幀時間線(Android 12 以上)用 actual_frame_timeline_slice,沒有時用主執行緒名稱以 Choreographer#doFrame 開頭的區段
+--   max_main_block_ms  主執行緒最上層區段裡最長的那個(毫秒),只回報
+--   frames             算凍結幀時用的那一種來源一共幾幀;是 0 表示沒錄到畫面,判定會列成跳過
+-- 量不到的欄位輸出 -1(重跑腳本比對 expect 時寫得出來,trace_processor 的空值會印成 [NULL])
+-- 用法:把 __PROCESS__ 換成 App 的行程名(套件名,只收英數字、底線與點),交給 trace_processor 跑,
+--   複製進收據的 queries.sql 時上面加一行 -- [Qn] session=<名> trace=<artifact id> requires=- expect=cycle:frozen_frames=<值>
+--   第一欄是字串 cycle:重跑腳本拿第一欄當鍵
+-- 只用標準 SQLite 語法與 process、thread、thread_track、slice、process_counter_track、counter、actual_frame_timeline_slice 七張表
+--   (測試用 Python 內建的 sqlite3 照 Perfetto 文件建同名的表跑同一支檔)
+-- 規則單源 Projects/Android記憶體與穩定性驗收_計劃
+-- 註解一律不以分號結尾:收據的重跑腳本拿第一個以分號結尾的行當查詢結尾
+WITH
+app AS (SELECT upid, pid FROM process WHERE name = '__PROCESS__'),
+anon AS (
+  SELECT c.ts, c.value FROM counter c JOIN process_counter_track t ON c.track_id = t.id
+  WHERE t.name = 'mem.rss.anon' AND t.upid IN (SELECT upid FROM app)
+),
+swp AS (
+  SELECT c.ts, c.value FROM counter c JOIN process_counter_track t ON c.track_id = t.id
+  WHERE t.name = 'mem.swap' AND t.upid IN (SELECT upid FROM app)
+),
+swp_span AS (SELECT ts, LEAD(ts) OVER (ORDER BY ts) AS next_ts, value FROM swp),
+peak AS (
+  SELECT MAX(a.value + COALESCE(s.value, 0)) AS v FROM anon a
+  LEFT JOIN swp_span s ON a.ts >= s.ts AND (s.next_ts IS NULL OR a.ts < s.next_ts)
+),
+main_track AS (
+  SELECT tt.id AS track_id FROM thread_track tt JOIN thread th ON tt.utid = th.utid JOIN app ON th.upid = app.upid
+  WHERE th.tid = app.pid
+),
+timeline AS (SELECT dur FROM actual_frame_timeline_slice WHERE upid IN (SELECT upid FROM app)),
+doframe AS (SELECT dur FROM slice WHERE track_id IN (SELECT track_id FROM main_track) AND name LIKE 'Choreographer#doFrame%'),
+frames AS (
+  SELECT dur FROM timeline
+  UNION ALL
+  SELECT dur FROM doframe WHERE NOT EXISTS (SELECT 1 FROM timeline)
+)
+SELECT
+  'cycle' AS key,
+  COALESCE((SELECT CAST(v / 1024 AS INT) FROM peak), -1) AS peak_anon_swap_kb,
+  (SELECT COUNT(*) FROM frames WHERE dur > 700000000) AS frozen_frames,
+  COALESCE((SELECT MAX(dur) / 1000000 FROM slice WHERE track_id IN (SELECT track_id FROM main_track) AND depth = 0), -1) AS max_main_block_ms,
+  (SELECT COUNT(*) FROM frames) AS frames;
diff --git a/scripts/templates/android-stability-record.pbtxt b/scripts/templates/android-stability-record.pbtxt
new file mode 100644
index 00000000..2200b71b
--- /dev/null
+++ b/scripts/templates/android-stability-record.pbtxt
@@ -0,0 +1,29 @@
+# SPDX-FileCopyrightText: 2026 Enzo Hsieh
+# SPDX-License-Identifier: MIT
+#
+# 記憶體與穩定性收集:N 輪量測期間那一份 Perfetto 追蹤檔的錄製設定(android-stability-collect.sh 換掉佔位後推到裝置)
+#   __PROCESS__      App 的行程名(套件名)
+#   __DURATION_MS__  錄製上限(.lumos/macrobench.json 的 stability.max_record_s 換成毫秒,預設 600 秒)
+# 錄的東西:App 的行程記憶體計數(每 250ms 一次)、幀時間線、App 的區段;單源 Projects/Android記憶體與穩定性驗收_計劃
+buffers { size_kb: 65536 fill_policy: RING_BUFFER }
+buffers { size_kb: 8192 fill_policy: RING_BUFFER }
+data_sources {
+  config {
+    name: "linux.process_stats"
+    target_buffer: 1
+    process_stats_config { proc_stats_poll_ms: 250 scan_all_processes_on_start: true }
+  }
+}
+data_sources { config { name: "android.surfaceflinger.frametimeline" } }
+data_sources {
+  config {
+    name: "linux.ftrace"
+    ftrace_config {
+      ftrace_events: "sched/sched_switch"
+      atrace_categories: "view"
+      atrace_categories: "gfx"
+      atrace_apps: "__PROCESS__"
+    }
+  }
+}
+duration_ms: __DURATION_MS__
