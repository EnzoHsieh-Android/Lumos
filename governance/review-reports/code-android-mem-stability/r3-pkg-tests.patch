+def t_android_memstab_vitals_every_tier():
+    """S4:官方表每一級都對一次「剛好等於 → 通過、多 1 KB → 沒過」,含每個分級的上界(上界不含)。
+    40 個案例直接呼叫判定函式(每案經命令列要起兩次 lumos,40 案約 50 秒);命令列那條路徑由 t_android_memstab_peak_vitals_floor 走。"""
+    m = _load_lumos_module()
+    GB = 1024 * 1024
+    app = ((3200, 2.00), (4800, 2.25), (6800, 2.25), (9216, 3.25), (14336, 4.25))
+    game = ((3200, 2.25), (4800, 2.75), (6800, 3.50), (9216, 4.00), (14336, 5.00))
+    for cat, table in (("app", app), ("game", game)):
+        for i, (lo, gb) in enumerate(table):
+            hi = table[i + 1][0] if i + 1 < len(table) else 18432
+            for mem in (lo, hi - 1):
+                for peak, want in ((gb * GB, "threshold_passed"), (gb * GB + 1, "threshold_failures")):
+                    res = _ms_result(total_mem_mb=mem, category=cat, cycle_trace=dict(_ms_result()["cycle_trace"], peak_anon_swap_kb=peak))
+                    v = _ms_verdict(m._macrobench_judge_stability([_ms_thr("peak_vitals")], res))
+                    check(f"{cat} {mem} MB 峰值 {peak / GB:.6f} GB → {want}", [x[0] for x in v] == [want], str(v))
