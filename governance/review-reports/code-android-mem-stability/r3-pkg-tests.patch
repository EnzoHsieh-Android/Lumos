+def _ms_root(td, thresholds, result, config=None, text=True):
+    """暫存專案:門檻檔 + 一份 stability.json;config 給了才寫 .lumos/macrobench.json。
+    回 (root, --json 那次, 解析後的 dict, 文字輸出那次)。"""
+    import json
+    root = Path(td)
+    (root / ".lumos").mkdir(exist_ok=True)
+    if config is not None:
+        (root / ".lumos" / "macrobench.json").write_text(json.dumps(config), encoding="utf-8")
+    (root / ".lumos" / "macrobench-thresholds.json").write_text(
+        json.dumps({"version": 1, "thresholds": thresholds}, ensure_ascii=False), encoding="utf-8")
+    sp = root / "stability.json"
+    sp.write_text(result if isinstance(result, str) else json.dumps(result, ensure_ascii=False), encoding="utf-8")
+    r = _mb_run(root, "--stability", str(sp), "--json")
+    d = json.loads(r.stdout) if r.stdout.strip().startswith("{") else {}
+    return root, r, d, (_mb_run(root, "--stability", str(sp)) if text else r)
+
+
+def _ms_verdict(d):
+    """--json 結果裡寫了 check 的那幾筆 → [(清單名, check, 那筆)]。"""
+    return [(k, x.get("check"), x) for k in ("threshold_failures", "threshold_passed", "threshold_skipped")
+            for x in d.get(k, []) if x.get("check")]
+
