+def t_android_memstab_collect_cleanup():
+    """收集腳本收到 SIGTERM(外層逾時、kill 的預設訊號)時,停掉裝置上的錄製、刪裝置暫存、收掉日誌串流與驅動整組子程序;
+    錄製收到 TERM 不停時,等完就補 KILL 並記成 failed;驅動逾時時也整組殺掉。"""
+    import json, signal, subprocess as sp, tempfile, time
+    with tempfile.TemporaryDirectory(prefix="gctl-ms-") as td:
+        root, fake, script = _ms_prepare(td, exit_before=_MS_EXIT_HEAD, exit_after=_MS_EXIT_HEAD, pids=("100", "100", "100"),
+                                         unreachable=("0 bytes in 0 unreachable allocations",) * 2, driver_out="INSTRUMENTATION_CODE: -1",
+                                         driver_rc=0, stability={"strictmode": True}, heap=({}, {}), logcat="", thresholds=None)
+        (fake / "driver_sleeps").write_text("1", encoding="utf-8")
+        p = sp.Popen(["sh", str(script), "run2"], cwd=root, stdout=sp.PIPE, stderr=sp.PIPE, text=True, env=_ms_collect_env(fake))
+        for _ in range(300):   # 等到量測輪的驅動開始(驅動被呼叫第二次)
+            if (fake / "driver.log").exists() and (fake / "driver.log").read_text().count("\n") >= 2:
+                break
+            time.sleep(0.1)
+        time.sleep(0.5)
+        p.send_signal(signal.SIGTERM)
+        p.wait(timeout=60)
+        log = (fake / "adb.log").read_text()
+        check("SIGTERM 時停掉裝置上的錄製", "kill -TERM 4321" in log, log[-500:])
+        check("SIGTERM 時刪掉裝置上的錄製設定與追蹤檔", "rm -f /data/misc/perfetto-configs/lumos-stability-run2.pbtxt" in log, log[-500:])
+        time.sleep(0.5)
+        left = sp.run(["pgrep", "-f", f"{fake}/adb logcat"], capture_output=True, text=True).stdout.split()
+        check("SIGTERM 時日誌串流沒有變成孤兒", not left, str(left))
+        left = sp.run(["pgrep", "-f", f"{fake}/(driver|sleeper)"], capture_output=True, text=True).stdout.split()
+        check("SIGTERM 時驅動(連同它底下的 sleep)沒有變成孤兒", not left, str(left))
+        check("SIGTERM 時原始日誌 logcat.raw 也刪掉", not (root / ".lumos" / "artifacts" / "android" / "run2" / "logcat.raw").exists())
+        for pid in left:   # 測試自己收尾:紅的時候不留孤兒給別支測試
+            sp.run(["kill", pid], capture_output=True)
+    with tempfile.TemporaryDirectory(prefix="gctl-ms-") as td:
+        fake = Path(td) / "fake"
+        fake.mkdir()
+        (fake / "ignores_term").write_text("1", encoding="utf-8")
+        _r, d, fake = _ms_collect(td, exit_before=_MS_EXIT_HEAD, exit_after=_MS_EXIT_HEAD)
