+             f" (300, 2, {40 * MB}), (400, 1, {120 * MB}), (500, 3, {999 * MB});"   # 別的行程那筆 999 MB 不能算進來
+             f"insert into actual_frame_timeline_slice(ts, dur, upid) values (0, {16 * ms}, 1), (100, {701 * ms}, 1), (200, {700 * ms}, 1),"
+             f" (300, {900 * ms}, 2);"   # 別的行程的凍結幀不算;剛好 700ms 不算凍結
+             f"insert into slice(ts, dur, track_id, name, depth) values (0, {650 * ms}, 1, 'activityStart', 0), (0, {600 * ms}, 1, 'inflate', 1),"
