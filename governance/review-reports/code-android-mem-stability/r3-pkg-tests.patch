+def t_android_memstab_native_unreachable():
+    """S1:兩次掃描的沒人指著原生記憶體差值大於門檻 → 沒過並印差值;等於門檻 → 通過;只比差值不比絕對值。"""
+    import tempfile
+    cases = [((0, 0), (10485760, 5), None, "threshold_failures"),   # 實驗室實測:沒呼叫 release 5 輪漏 10 MB 5 塊
+             ((4096, 1), (4096, 1), None, "threshold_passed"),       # 暖機後就有 4 KB 基線、量測後沒變 → 差值 0
+             ((0, 0), (1024, 1), 1024, "threshold_passed"),          # 差值剛好等於門檻
+             ((0, 0), (1025, 1), 1024, "threshold_failures")]
+    for (b, ba), (a, aa), lim, want in cases:
+        with tempfile.TemporaryDirectory(prefix="gctl-ms-") as td:
+            res = _ms_result(unreachable={"status": "ok", "before": {"bytes": b, "allocations": ba},
+                                          "after": {"bytes": a, "allocations": aa}})
+            _, r, d, rt = _ms_root(td, [_ms_thr("native_unreachable", max_bytes=lim)], res)
+            v = _ms_verdict(d)
+            check(f"前 {b} 後 {a} 門檻 {lim} → {want}", [x[0] for x in v] == [want], r.stdout + r.stderr)
+            if want == "threshold_failures":
+                rec = v[0][2]
+                check("沒過那筆附差值位元組與塊數", rec.get("delta_bytes") == a - b and rec.get("delta_allocations") == aa - ba, str(rec))
+                check("文字輸出印出差值", str(a - b) in rt.stdout and "native_unreachable" in rt.stdout, rt.stdout)
+            check("只提醒、回 0", r.returncode == 0 and rt.returncode == 0, r.stderr + rt.stderr)
