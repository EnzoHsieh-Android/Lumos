+         "category": "app", "warmup": 2, "cycles": 5,
+         "driver": {"status": "ok", "warmup": {"rc": 0}, "cycles": {"rc": 0}},
+         "pids": {"status": "ok", "values": [100, 100, 100]},
+         "unreachable": {"status": "ok", "before": {"bytes": 0, "allocations": 0}, "after": {"bytes": 0, "allocations": 0}},
+         "heap": {"status": "ok", "before": {"com.sdk.Player": 1}, "after": {"com.sdk.Player": 1}, "classes_seen": {"before": 9000, "after": 9000}},
+         "native_heap_kb": {"status": "ok", "before": 7000, "after": 7100},
+         "cycle_trace": {"status": "ok", "peak_anon_swap_kb": 200000, "frozen_frames": 0, "max_main_block_ms": 40, "frames": 600},
+         "exits": {"status": "ok", "new": []},
+         "strictmode": {"status": "ok", "violations": []}}
