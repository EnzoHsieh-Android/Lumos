+def _ms_sql(name, setup):
+    """拿 Python 內建 sqlite3 照 Perfetto 文件建同名的表,跑工具鏈範本裡的查詢;範本不在回 None。"""
+    import sqlite3
+    tpl = Path(GRAPHCTL).resolve().parent / "templates" / name
+    if not tpl.is_file():
+        return None
+    db = sqlite3.connect(":memory:")
+    db.executescript("create table process(upid integer primary key, pid int, name text);"
+                     "create table thread(utid integer primary key, tid int, name text, upid int);"
+                     "create table thread_track(id integer primary key, utid int);"
+                     "create table slice(id integer primary key, ts int, dur int, track_id int, name text, depth int, parent_id int);"
+                     "create table process_counter_track(id integer primary key, upid int, name text);"
+                     "create table counter(id integer primary key, ts int, track_id int, value real);"
+                     "create table actual_frame_timeline_slice(id integer primary key, ts int, dur int, upid int);"
+                     "create table heap_graph_class(id integer primary key, name text);"
+                     "create table heap_graph_object(id integer primary key, upid int, type_id int, reachable int);"
+                     "insert into process values (1, 100, 'com.lab'), (2, 200, 'com.other');"
+                     "insert into thread values (1, 100, 'com.lab', 1), (2, 101, 'RenderThread', 1), (3, 200, 'com.other', 2);"
+                     "insert into thread_track values (1, 1), (2, 2), (3, 3);"
+                     "insert into process_counter_track values (1, 1, 'mem.rss.anon'), (2, 1, 'mem.swap'), (3, 2, 'mem.rss.anon');")
+    db.executescript(setup)
+    sql = tpl.read_text(encoding="utf-8").replace("__PROCESS__", "com.lab")
+    return db.execute(sql).fetchall()
+
