+def _ms_thr(check, **over):
+    t = {"scenario": "pkg.Leak#cycle", "check": check, "contract": "Systems/播放器 ★INVARIANT★ 關畫面釋放播放器",
+         "decided_by": "Enzo", "decided_at": "2026-10-24"}
+    t.update(over)
+    return {k: v for k, v in t.items() if v is not None}
+
