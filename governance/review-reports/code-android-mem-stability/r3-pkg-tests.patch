+    check("恰好一列、第一欄是字串 cycle", len(rows) == 1 and rows[0][0] == "cycle", str(rows))
+    _key, peak, frozen, block, frames = rows[0]
+    # 峰值:200 那點 anon 150 MB 配之前最近的 swap 10 MB = 160 MB;400 那點 120 + 40 = 160 MB;取最大 160 MB
+    check("峰值 = anon 加之前最近一次 swap 的最大值,只算這個 App", peak == 160 * 1024, str(rows))
+    check("凍結幀只算超過 700ms、只算這個 App", frozen == 1, str(rows))
+    check("主執行緒最長最上層區段 650ms(RenderThread 與別的行程不算、子區段不算)", block == 650, str(rows))
+    check("幀數 = 這個 App 的幀時間線筆數", frames == 3, str(rows))
+    rows = _ms_sql("android-stability-cycle.sql",
