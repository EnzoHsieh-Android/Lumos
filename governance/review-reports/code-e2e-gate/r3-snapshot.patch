+E2E_RECORD_SCAN_MAX = 500                  # doctor、waive --list/--ack 與開場掛鉤最多讀幾份紀錄(照修改時間由新到舊)
+E2E_RECORD_FILE_MAX = 2 * 1024 * 1024      # 單份紀錄的大小上限;開場掛鉤 lumos-entry-hook.py 的 _e2e_ai_line 是同一組數字的複本(有測試盯兩邊算出一樣)
+E2E_RECORD_SCAN_SEC = 3.0                  # 開場掛鉤與 doctor 數 AI 放行待看的總時間上限(掛鉤外層只給 10 秒;500 份各 2MB 的大清單要讀幾十秒,
