+def _e2e_gate_fps(root, base, sha, pushed, ml, base_full, deadline):
+    """兩端指紋(同一份設定:被推送提交的 e2e 段,沒有就用主線版的)→ (選檔設定, 整份設定, 被推送提交的指紋)。
+    pushed、ml 各是 (整份, e2e 段)。兩端指紋相同、而且分岔點的設定也一樣 → 不要求;被推送提交沒有 e2e 段 → 擋
+    (分岔點有這一段:這次拿掉了;沒有:舊分支,叫人先合主線)。
+    ★只改設定也要驗★:兩端用同一份設定算指紋,只改 .lumos/macrobench.json(拿掉 flow、關掉記憶體、整段刪掉)時兩端指紋一樣,
+    所以另外比分岔點的 e2e 段與記憶體設定(代碼審 code-e2e-gate r1 資安、正確性席)。"""
+    if pushed[1]:
+        err = _e2e_cfg_err(pushed[1], pushed[0].get("stability"), bool(pushed[0].get("results_dirs")),
+                           scen=pushed[0].get("stability_scenarios"))
+        if err:
+            _e2e_gate_block(f"被推送提交的 e2e 段不合格:{err}")
+    sel_full, sel = pushed if pushed[1] else ml
+    fp_base, ferr = _e2e_fingerprint(root, base, sel, sel_full, allow_missing=True, deadline=deadline)
+    fp, ferr2 = (None, None) if ferr else _e2e_fingerprint(root, sha, sel, sel_full, deadline=deadline)
+    if ferr or ferr2:
+        _e2e_gate_block(ferr or ferr2)
+    base_e2e = (base_full or {}).get("e2e")
+    # 跟被推送提交自己的設定比(不是跟算指紋用的那份:被推送提交沒有 e2e 段時那份是主線版的,比了永遠一樣)。
+    # 兩端都沒有 e2e 段(主線採用 E2E 之前分出去的舊分支)也算一樣:只改文件的舊分支不要求(代碼審 code-e2e-gate r2 正確性、通才席)
+    same_e2e = ((base_e2e is None and not pushed[1])
+                or (isinstance(base_e2e, dict) and isinstance(pushed[1], dict) and _e2e_canon(base_e2e) == _e2e_canon(pushed[1])))
+    same_cfg = same_e2e and (not (pushed[1] or sel).get("stability") or _e2e_mem_canon(base_full) == _e2e_mem_canon(pushed[0]))
+    if fp == fp_base and same_cfg:
+        _e2e_gate_done("not-required", "App 程式、驗收素材與驗收設定都跟分岔點一樣", fp=fp)
+    if not pushed[1] and base_e2e:
+        # 不叫人合主線:三方合併保留分支這邊的刪除,合了也補不回(代碼審 r2 正確性、合約席)
+        _e2e_gate_block("這個提交拿掉了 e2e 段(分岔點還有):刻意關掉驗收的那一次推送用 LUMOS_SKIP_ANDROID_E2E=1 關掉,合進主線後判定就不跑",
+                        commit=sha, removed=True)
+    if not pushed[1]:
+        _e2e_gate_block("這個提交沒有 e2e 段,App 程式卻跟分岔點不一樣:先把主線合進來再驗收;刻意刪掉的那一次用 LUMOS_SKIP_ANDROID_E2E=1 關掉",
+                        commit=sha, merge_main=True)
+    return sel, sel_full, fp
