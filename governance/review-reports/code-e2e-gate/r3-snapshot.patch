+def _e2e_gate_body(root, sha, pushed_branch, range_start, deadline):
+    """推送前判定的本體(單源計劃〈資料怎麼流〉第 4 步與〈推送前怎麼按功能判〉):照順序走各階段,
+    每個階段要提早結束(擋下、不跑、不要求、放行)就丟 _E2eGateStop。"""
+    sha = _e2e_gate_resolve(root, sha, deadline)
+    pushed = _e2e_gate_uses(root, sha, pushed_branch, deadline)
+    esc = _e2e_gate_escape()
+    if esc:
+        return esc
+    ml_full, ml_e2e, base = _e2e_gate_mainline(root, sha, pushed_branch, range_start, deadline)
+    base_full, berr = _e2e_tree_json(root, base, ".lumos/macrobench.json", deadline)
+    if berr:
+        _e2e_gate_block(f"分岔點的 macrobench.json {berr}")
+    sel, sel_full, fp = _e2e_gate_fps(root, base, sha, pushed, (ml_full, ml_e2e), base_full, deadline)
+    need = _e2e_gate_need(root, base, sha, sel, base_full, sel_full, deadline)
+    if need[0] == "cases" and not need[1]:
+        # 改到的功能情境都只列了效能(只提醒):沒有要驗的情境,不要求紀錄(計劃〈推送前怎麼按功能判〉第 4 步;代碼審 r1 邊界、正確性席)
+        return _e2e_gate_out("pass-by-feature", "這次改到的功能情境都只列了效能(只提醒),沒有要驗的情境", fp=fp, commit=sha,
+                             need="cases", cases=[], perf_only=need[2], full_why=[])
+    rec, info = _e2e_gate_load(root, sha, fp, need, deadline)
+    if any(_e2e_waiver_ok(w) for w in rec.get("waivers") or []):
+        return _e2e_gate_out("waived", "這一版有放行", **info)
+    note = _e2e_gate_full_note(root, sha, rec, info, (ml_full, ml_e2e), sel_full, deadline)
+    tail = f";{note}" if note else ""
+    if need[0] == "full":
+        _e2e_gate_block("這次改動要整套驗收:" + "、".join(need[1][:8]) + tail, runs_note=note, **info)
+    bad = _e2e_gate_by_feature(rec, sel, need[1])
+    if bad:
+        _e2e_gate_block("按功能驗收還不夠:" + "、".join(f"{k}({w})" for k, w in bad[:8]) + tail, bad_cases=bad, runs_note=note, **info)
+    return _e2e_gate_out("pass-by-feature", "按功能放行", **info)
+
