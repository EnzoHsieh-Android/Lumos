+    沒有就是不用 E2E 的專案,一字不印;有才擋。"""
+    full_sha, failed = _push_rev(root, sha, deadline=deadline)
+    if full_sha:
+        return full_sha
+    cfg = root / ".lumos" / "macrobench.json"
+    wt, werr = _e2e_load_json(cfg, scrub=False) if cfg.exists() else (None, None)
+    if werr is None and not (isinstance(wt, dict) and wt.get("e2e")):
+        _e2e_gate_done("none")
+    _e2e_gate_block(f"讀不到要推的提交 {str(sha)[:40]}" + ("(git 失敗或逾時)" if failed else ""))
+
+
+def _e2e_gate_uses(root, sha, pushed_branch, deadline):
+    """被推送提交的設定 → (整份, e2e 段);被推送提交與主線候選都沒有 e2e 段 → 這個專案不用 E2E(輸出一字不變)。"""
+    pushed_full, perr = _e2e_tree_json(root, sha, ".lumos/macrobench.json", deadline)
+    if perr:
+        _e2e_gate_block(f"被推送提交的 macrobench.json {perr}")
+    pushed_e2e = (pushed_full or {}).get("e2e")
+    if pushed_e2e:
+        return pushed_full, pushed_e2e
+    cands, cerr = _secev_mainline_cands(root, pushed_branch, deadline)
+    found = False
+    for _n, s in cands:
+        mf, merr = _e2e_tree_json(root, s, ".lumos/macrobench.json", deadline)
+        if merr:
+            _e2e_gate_block(f"主線候選的 macrobench.json {merr}")
+        found = found or bool((mf or {}).get("e2e"))
+    if not found and not (cerr and pushed_full is not None):
+        _e2e_gate_done("none")
+    return pushed_full, pushed_e2e
+
+
+def _e2e_gate_mainline(root, sha, pushed_branch, range_start, deadline):
+    """主線與分岔點 → (主線版整份設定, 主線版 e2e 段, 分岔點);主線版沒有 e2e 段 → 不要求;找不到、不合格、算不出 → 擋。"""
+    ml, why, code = _secev_mainline(root, sha, pushed_branch, range_start, deadline)
+    if code:
+        _e2e_gate_block(f"找不到主線:{why}")
+    if ml is None:
+        _e2e_gate_done("not-required", f"{why};主線版沒有 e2e 段")
+    ml_full, merr = _e2e_tree_json(root, ml, ".lumos/macrobench.json", deadline)
+    if merr:
+        _e2e_gate_block(f"主線版的 macrobench.json {merr}")
+    ml_e2e = (ml_full or {}).get("e2e")
+    if not ml_e2e:
+        _e2e_gate_done("not-required", "主線版沒有 e2e 段")
+    err = _e2e_cfg_err(ml_e2e, ml_full.get("stability"), bool(ml_full.get("results_dirs")), scen=ml_full.get("stability_scenarios"))
+    if err:
+        _e2e_gate_block(f"主線版的 e2e 段不合格:{err}")
+    mb = _secev_git(root, "merge-base", ml, sha, deadline=deadline)
+    base = mb.stdout.strip() if mb is not None and mb.returncode == 0 else ""
+    if not _LENS_SHA_RE.match(base):
+        _e2e_gate_block("算不出被推送提交跟主線的分岔點(沒有共同祖先,或淺層 clone 截斷了歷史)")
+    return ml_full, ml_e2e, base
