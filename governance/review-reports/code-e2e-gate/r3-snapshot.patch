+def _e2e_gate_full_note(root, sha, rec, info, ml, sel_full, deadline):
+    """整套那條路(判定順序第 2 步):整套 pass 且涵蓋、沒有較新的 fail → 放行(丟 _E2eGateStop);
+    其他回一句說明整套結果為什麼不能用(給擋下訊息)。ml 是 (主線版整份, 主線版 e2e 段)。"""
+    runs = rec.get("runs")
+    if not isinstance(runs, dict):
+        return ""
+    if runs.get("result") != "pass":
+        return f"整套結果是{ {'fail': '沒過', 'unjudged': '沒判完'}.get(runs.get('result'), '?') }"
+    miss = _e2e_runs_missing(root, sha, runs, ml[1], ml[0], sel_full, deadline)
+    if miss:
+        return f"整套結果沒涵蓋主線版要求的:{'、'.join(miss[:8])}"
+    rt = _e2e_ts(runs["ended"])
+    newer = sorted(k for k, v in (rec.get("feature_runs") or {}).items() if v.get("result") == "fail" and _e2e_ts(v["ended"]) >= rt)
+    if newer:
+        _e2e_gate_block(f"整套跑過了,但之後按功能跑 {'、'.join(newer)} 沒過(最新的結果說沒過)", bad_cases=[(k, "沒過") for k in newer], **info)
+    _e2e_gate_done("pass", "整套跑過且通過", **info)
+    return ""
