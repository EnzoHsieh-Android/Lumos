+def _e2e_gate_load(root, sha, fp, need, deadline):
+    """從被推送提交的樹讀這一版的紀錄 → (紀錄, 結果裡共用的欄位);沒提交、沒有、讀不懂 → 擋。"""
+    rel = f"{E2E_RECORDS_DIR}/{fp}.json"
+    info = {"fp": fp, "commit": sha, "record": rel, "need": need[0], "full_why": need[1] if need[0] == "full" else [],
+            "cases": need[1] if need[0] == "cases" else [], "perf_only": need[2] if need[0] == "cases" else []}
+    rec, rerr = _e2e_tree_json(root, sha, rel, deadline)
+    if rerr:
+        _e2e_gate_block(f"查證紀錄 {rerr}", bad_record=True, **info)
+    if rec is None:
+        if (Path(root) / rel).exists():
+            _e2e_gate_block(f"這一版的查證紀錄還沒提交:{rel}", uncommitted=True, **info)
+        want = ("要整套跑:" + "、".join(info["full_why"][:5])) if need[0] == "full" else ("按功能跑這幾個情境就夠:" + "、".join(info["cases"]))
+        _e2e_gate_block(f"這一版沒有查證紀錄(沒驗收過、或驗收時的版本不是這一版);{want}", **info)
+    rerr = _e2e_record_err(rec, fp) or _e2e_gate_times_err(rec)
+    if rerr:
+        # bad_record:放行與重跑都不覆蓋讀不懂的紀錄(_e2e_record_update),擋下訊息改叫人修好或刪掉(代碼審 r2 正確性席)
+        _e2e_gate_block(f"查證紀錄讀不懂:{rerr}", bad_record=True, **info)
+    info["pending_ai"] = _e2e_ai_pending(rec)
+    return rec, info
