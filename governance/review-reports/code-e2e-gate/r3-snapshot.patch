+def _e2e_gate_escape():
+    """這一道的兩個出口:在 CI 裡(第一版只在本機推送時判)、LUMOS_SKIP_ANDROID_E2E=1(這一次整道不跑、記帳)→ 結果或 None。"""
+    if _in_ci():
+        return _e2e_gate_out("ci", "第一版只在本機推送時判")
+    if os.environ.get("LUMOS_SKIP_ANDROID_E2E") == "1":
+        return _e2e_gate_out("skipped-env", "LUMOS_SKIP_ANDROID_E2E=1:這一次整道不跑")
+    return None
