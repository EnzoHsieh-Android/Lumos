+    out = []
+    for fp, path in _e2e_record_files(root)[0]:
+        rec, err = _e2e_load_json(path, scrub=False) if path is not None else (None, "太大")
+        out.append((fp, None if err or _e2e_record_err(rec, fp) else rec))
