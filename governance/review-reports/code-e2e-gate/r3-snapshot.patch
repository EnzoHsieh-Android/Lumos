+def _e2e_record_files(root):
+    """工作目錄 .lumos/e2e-records/ 裡要讀的紀錄檔 → [(指紋, 路徑或 None)]:檔名是 64 碼指紋;只讀一般檔(lstat,不跟著捷徑走:
+    捷徑指到 /dev/zero 這類裝置會讀不完);超過單份上限的給 None(照樣佔一個名額,開場掛鉤同一套算法);照修改時間由新到舊取前
+    E2E_RECORD_SCAN_MAX 份(代碼審 code-e2e-gate r1 邊界、資源席)→ (那幾份, 超過上限沒取的份數)。"""
+    import stat as _st
+    d = Path(root) / E2E_RECORDS_DIR
+    rows = []
+    for p in d.iterdir() if d.is_dir() and not d.is_symlink() else []:
+        if p.suffix != ".json" or not E2E_FP_RE.fullmatch(p.stem):
+            continue
+        try:
+            st = p.lstat()
+        except OSError:
+            continue
+        if not _st.S_ISREG(st.st_mode):
+            continue
+        rows.append((st.st_mtime, p.stem, p if st.st_size <= E2E_RECORD_FILE_MAX else None))
+    rows.sort(key=lambda r: (-r[0], r[1]))
+    return [(fp, path) for _m, fp, path in rows[:E2E_RECORD_SCAN_MAX]], max(0, len(rows) - E2E_RECORD_SCAN_MAX)
+
