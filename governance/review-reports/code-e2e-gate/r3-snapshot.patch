+                 ("runs.result 不認得", json.dumps(dict(good, runs=dict(_e2eg_runs(), result="weird")))),
+                 ("runs 的結束時間讀不懂", json.dumps(dict(good, runs=dict(_e2eg_runs(), ended="garbage")))),
