+def _e2e_gate_evaluate(root, sha, pushed_branch=None, range_start=None, budget=None):
+    """code-loop check 的 Android E2E 判定(單源 Projects/Android端到端驗收_計劃〈資料怎麼流〉第 4 步):判不清就擋,不走 fail-open。
+    整道 60 秒預算(照安全證據閘);用完、或內部出錯都擋並說原因。"""
+    import time
+    b = E2E_GATE_BUDGET_SEC if budget is None else budget   # 呼叫時才讀常數:測試在行程內改得到(照安全證據閘的 _SECEV_BUDGET_SEC)
+    deadline = time.monotonic() + b
+    timeout = _e2e_gate_out("blocked", f"判定超過 {b:g} 秒還沒算完(git 太慢或檔案樹太大);這一次先關掉:LUMOS_SKIP_ANDROID_E2E=1 git push",
+                            gate_code="evaluation_timeout")
+    try:
+        out = _e2e_gate_body(Path(root), sha, pushed_branch, range_start, deadline)
+    except _E2eGateStop as e:
+        # 預算用完時 git 呼叫回「失敗」(沒時間就不跑):那時擋下的原因一律講成逾時,不讓人以為是提交或紀錄壞了
+        out = timeout if e.out["status"] == "blocked" and time.monotonic() >= deadline else e.out
+    except _SecevTimeout:
+        out = timeout
+    except Exception as e:   # 判不清就擋:工具自己的毛病也擋(不走 fail-open),出口是環境變數
+        out = _e2e_gate_out("blocked", f"判定內部出錯({type(e).__name__}: {str(e)[:120]});這一次先關掉:LUMOS_SKIP_ANDROID_E2E=1 git push",
+                            gate_code="evaluation_error")
+    # 前段(讀要推的提交、讀設定)就擋下或逾時時,CI 與環境變數的出口照樣有效:擋下訊息叫人設的變數要真的關得掉
+    # (代碼審 code-e2e-gate r1 通才、邊界、正確性、合約席;本體讀完設定之後也先看這兩個出口)
+    return (_e2e_gate_escape() or out) if out["status"] == "blocked" else out
+
