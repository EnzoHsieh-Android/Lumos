+def _e2e_history_rows(p, feature, case, last, flaky):
+    """逐行讀總表(_canary_ledger_rows,壞行跳過),照 --case、--feature 篩,留最後 last 筆;cases 不是清單當空的。
+    flaky 時改回 OrderedDict:--last 數的是不同執行(重判多寫的行不佔名額),每次執行留它的全部行給 _e2e_flaky_tally 判。
+    讀不了照樣丟 OSError,由呼叫端擋下。"""
+    import collections
+    rows = collections.deque(maxlen=last)
+    runs = collections.OrderedDict()
+    for n, r in enumerate(_canary_ledger_rows(p, errors="replace")):
+        cs = r.get("cases") if isinstance(r.get("cases"), list) else []
+        if case and case not in cs:
+            continue
+        if feature and not any(str(c).startswith(feature + ".") for c in cs):
+            continue
+        if not flaky:
+            rows.append(r)
+            continue
+        runs.setdefault(_e2e_run_key(r, n), []).append(r)
+        if len(runs) > last:
+            runs.popitem(last=False)
+    return runs if flaky else rows
+
