<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.enzo.lumos.wrapper-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/enzo/harness/lumos-toolchain/governance/wrapper-watchdog.sh</string>
    </array>

    <!-- 每小時一次。★它跟被監看的那支是兩個不同的失敗域★——被監看的那支死了、
         或它自己的排程被停掉,另一邊都還在。這是本案的核心,不是效能考量。 -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>WorkingDirectory</key>
    <string>/Users/enzo/harness/lumos-toolchain/governance</string>

    <key>StandardOutPath</key>
    <string>/Users/enzo/harness/lumos-toolchain/governance/logs/wrapper-watchdog.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/enzo/harness/lumos-toolchain/governance/logs/wrapper-watchdog.err</string>
</dict>
</plist>
