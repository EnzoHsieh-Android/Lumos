#
# 記憶體與穩定性收集:原生配置排行那一段(設定替這個情境打開 stability.native_retained 才錄)的 heapprofd 錄製設定
# (android-stability-collect.sh 換掉佔位後推到裝置)
#   __PROCESS__      App 的行程名(套件名;只量主行程)
#   __DURATION_MS__  錄製上限(stability.max_record_s 換成毫秒,預設 600 秒)
# 只接已經在跑的行程(no_startup,Android 11 以上);不設 continuous_dump_config:排行只用停錄時那一次傾印的最後累計
# 停錄時等最後一次傾印的上限是 data_source_stop_timeout_ms 的預設 5000 毫秒;單源 Projects/原生記憶體增長提示_計劃
buffers { size_kb: 65536 fill_policy: DISCARD }
data_sources {
  config {
    name: "android.heapprofd"
    heapprofd_config {
      process_cmdline: "__PROCESS__"
      sampling_interval_bytes: 4096
      shmem_size_bytes: 8388608
      no_startup: true
    }
  }
}
duration_ms: __DURATION_MS__
